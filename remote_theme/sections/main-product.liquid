{%- comment -%}
  Section: main-product
  Universal Premium Product Page with Sticky Info Column and 28+ Dynamic Blocks
{%- endcomment -%}

{{ 'pdp-universal.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
  assign save_pct = 0
  if on_sale
    assign diff = current_variant.compare_at_price | minus: current_variant.price
    assign save_pct = diff | times: 100 | divided_by: current_variant.compare_at_price
  endif
-%}

<div class="sf-pdp sf-pdp-{{ section.id }} sf-reveal" id="sf-pdp-{{ section.id }}" data-product-handle="{{ product.handle }}" data-section-id="{{ section.id }}">
  
  {%- if product == empty -%}
    <div class="sf-pdp-placeholder"><p>Assign to a product template.</p></div>
  {%- else -%}

  <div class="sf-pdp-top">
    
    {%- comment -%} GALLERY COLUMN {%- endcomment -%}
    <div class="sf-pdp-gallery">
      <div class="sf-pdp-gallery-main gallery-main sf-hover-zoom">
        {%- if on_sale -%}<div class="sf-pdp-badge" id="sf-pdp-badge-{{ section.id }}">-{{ save_pct }}% OFF</div>{%- endif -%}
        <div class="sf-pdp-gallery-viewport" id="sf-gallery-viewport-{{ section.id }}">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <div class="sf-pdp-gallery-slide {% if forloop.first %}is-active{% endif %}" data-media-id="{{ media.id }}">
                <img id="sf-pdp-main-img-{{ section.id }}-{{ forloop.index }}" src="{{ media | image_url: width: 1200 }}" alt="{{ media.alt | escape }}" width="1200" height="1200" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
              </div>
            {%- endfor -%}
          {%- elsif product.featured_media != blank -%}
            <div class="sf-pdp-gallery-slide is-active" data-media-id="{{ product.featured_media.id }}">
              <img id="sf-pdp-main-img-{{ section.id }}-1" src="{{ product.featured_media | image_url: width: 1200 }}" alt="{{ product.featured_media.alt | escape }}" width="1200" height="1200" fetchpriority="high">
            </div>
          {%- elsif product.featured_image != blank -%}
            <div class="sf-pdp-gallery-slide is-active">
              <img id="sf-pdp-main-img-{{ section.id }}-1" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" width="1200" height="1200" fetchpriority="high">
            </div>
          {%- else -%}
            <div class="sf-pdp-gallery-slide is-active">
              {{ 'product-1' | placeholder_svg_tag: 'sf-placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
      </div>
      
      {%- if product.media.size > 1 -%}
        <div class="sf-pdp-thumbnails" id="sf-pdp-thumbs-{{ section.id }}">
          {%- for media in product.media -%}
            <button type="button" class="sf-pdp-thumb {% if forloop.first %}is-active{% endif %}" data-media-id="{{ media.id }}" data-src="{{ media | image_url: width: 1200 }}" data-index="{{ forloop.index0 }}" aria-label="Load image {{ forloop.index }}">
              <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | escape }}" loading="lazy" width="100" height="100">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} INFO COLUMN (STICKY) {%- endcomment -%}
    <div class="sf-pdp-info sf-stagger-parent">
      <div class="sf-pdp-info-inner">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            
            {%- when 'breadcrumbs' -%}
              <nav class="sf-pdp-breadcrumbs sf-stagger-item" {{ block.shopify_attributes }} aria-label="Breadcrumb">
                <a href="{{ routes.root_url }}">Home</a> &nbsp;/&nbsp;
                {%- if product.collections.size > 0 -%}<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>&nbsp;/&nbsp;{%- endif -%}
                <span aria-current="page">{{ product.title }}</span>
              </nav>

            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}
                <div class="sf-pdp-vendor sf-stagger-item" {{ block.shopify_attributes }}>
                  {{ product.vendor }}
                </div>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 class="sf-pdp-title sf-stagger-item" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'rating' -%}
              <div class="sf-pdp-rating sf-stagger-item" {{ block.shopify_attributes }}>
                <a href="#sf-pdp-reviews-{{ section.id }}" class="sf-pdp-rating-link">
                  <span class="sf-pdp-stars">★★★★★</span>
                  <span class="sf-pdp-review-count">(128 Reviews)</span>
                </a>
              </div>

            {%- when 'price' -%}
              <div class="sf-pdp-price-row sf-stagger-item" {{ block.shopify_attributes }}>
                <span class="sf-pdp-price" id="sf-pdp-price-{{ section.id }}">{{ current_variant.price | money }}</span>
                {%- if on_sale -%}
                  <s class="sf-pdp-compare-price" id="sf-pdp-compare-price-{{ section.id }}">{{ current_variant.compare_at_price | money }}</s>
                  <span class="sf-pdp-save-badge" id="sf-pdp-save-badge-{{ section.id }}">Save {{ save_pct }}%</span>
                {%- endif -%}
                <p class="sf-pdp-tax-note">Inclusive of all taxes & Free Insured Shipping</p>
              </div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="sf-pdp-variants sf-stagger-item" {{ block.shopify_attributes }}>
                  <sf-variant-picker data-section="{{ section.id }}" data-url="{{ product.url }}">
                    {%- for option in product.options_with_values -%}
                      <div class="sf-pdp-option">
                        <label class="sf-pdp-option-name">{{ option.name }}: <span class="sf-pdp-option-value" id="sf-opt-val-{{ section.id }}-{{ option.position }}">{{ option.selected_value }}</span></label>
                        <div class="sf-pdp-option-values {% if block.settings.picker_type == 'swatch' or option.name == 'Color' or option.name == 'Colour' %}sf-pdp-swatches{% endif %}">
                          {%- if block.settings.picker_type == 'dropdown' -%}
                            <select class="sf-pdp-select" name="{{ option.name }}" id="Option-{{ section.id }}-{{ forloop.index0 }}" form="sf-pdp-form-{{ section.id }}">
                              {%- for value in option.values -%}
                                <option value="{{ value | escape }}" {% if option.selected_value == value %}selected="selected"{% endif %}>{{ value }}</option>
                              {%- endfor -%}
                            </select>
                          {%- elsif block.settings.picker_type == 'swatch' or option.name == 'Color' or option.name == 'Colour' -%}
                            {%- for value in option.values -%}
                              <input type="radio" id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                    name="{{ option.name }}" value="{{ value | escape }}" form="sf-pdp-form-{{ section.id }}"
                                    {% if option.selected_value == value %}checked{% endif %} class="sf-visually-hidden">
                              <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" class="sf-pdp-swatch {% if option.selected_value == value %}is-active{% endif %}" title="{{ value }}">
                                <span class="sf-pdp-swatch-inner" style="background-color: {{ value | downcase | replace: ' ', '' }};"></span>
                              </label>
                            {%- endfor -%}
                          {%- else -%}
                            {%- for value in option.values -%}
                              <input type="radio" id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                    name="{{ option.name }}" value="{{ value | escape }}" form="sf-pdp-form-{{ section.id }}"
                                    {% if option.selected_value == value %}checked{% endif %} class="sf-visually-hidden">
                              <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" class="sf-pdp-opt-label">
                                {{ value }}
                              </label>
                            {%- endfor -%}
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endfor -%}
                    <script type="application/json">
                      {{ product.variants | json }}
                    </script>
                  </sf-variant-picker>
                </div>
              {%- endunless -%}

            {%- when 'quantity_selector' -%}
              <div class="sf-pdp-qty sf-stagger-item" {{ block.shopify_attributes }}>
                <label for="sf-qty-{{ section.id }}">Quantity</label>
                <div class="sf-qty-widget">
                  <button type="button" class="sf-qty-btn sf-qty-minus" aria-label="Decrease quantity">&minus;</button>
                  <input type="number" id="sf-qty-{{ section.id }}" name="quantity" value="1" min="1" form="sf-pdp-form-{{ section.id }}" class="sf-qty-input">
                  <button type="button" class="sf-qty-btn sf-qty-plus" aria-label="Increase quantity">&plus;</button>
                </div>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="sf-pdp-buy-buttons sf-stagger-item" {{ block.shopify_attributes }}>
                {%- assign form_id = 'sf-pdp-form-' | append: section.id -%}
                {%- form 'product', product, id: form_id, class: 'sf-pdp-form' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" id="sf-pdp-vid-{{ section.id }}">
                  <div class="sf-pdp-buy-actions">
                    <button type="submit" name="add" class="sf-btn-add sf-hover-lift" id="sf-add-btn-{{ section.id }}" {% unless current_variant.available %}disabled{% endunless %}>
                      <span>{% if current_variant.available %}Add to Bag{% else %}Sold Out{% endif %}</span>
                    </button>
                    {%- if block.settings.show_dynamic_checkout -%}
                      {{ form | payment_button }}
                    {%- endif -%}
                  </div>
                {%- endform -%}
              </div>

            {%- when 'urgency_bar' -%}
              {%- if block.settings.text != blank -%}
                <div class="sf-pdp-urgency sf-stagger-item" {{ block.shopify_attributes }}>
                  <div class="sf-urgency-icon">⚡</div>
                  <div class="sf-urgency-text">{{ block.settings.text }}</div>
                  <div class="sf-urgency-progress"><div class="sf-urgency-fill" style="width: 75%;"></div></div>
                </div>
              {%- endif -%}
              
            {%- when 'delivery_estimate' -%}
              <div class="sf-pdp-delivery sf-stagger-item" {{ block.shopify_attributes }}>
                <div class="sf-del-header">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  <span>Check Delivery Estimate</span>
                </div>
                <div class="sf-del-input-row">
                  <input type="text" placeholder="Enter Pincode" class="sf-del-input">
                  <button type="button" class="sf-del-btn">Check</button>
                </div>
              </div>

            {%- when 'trust_triad' or 'trust_badges' -%}
              <div class="sf-pdp-trust-triad sf-stagger-item" {{ block.shopify_attributes }}>
                <div class="sf-trust-item"><span class="sf-trust-icon">💳</span> <span>COD Available</span></div>
                <div class="sf-trust-item"><span class="sf-trust-icon">🔄</span> <span>Easy Exchange</span></div>
                <div class="sf-trust-item"><span class="sf-trust-icon">🚚</span> <span>Free Shipping</span></div>
              </div>

            {%- when 'offers_strip' -%}
              {%- if block.settings.text != blank -%}
                <div class="sf-pdp-offers sf-stagger-item" {{ block.shopify_attributes }}>
                  <div class="sf-offer-tag">OFFER</div>
                  <div class="sf-offer-text">{{ block.settings.text }}</div>
                </div>
              {%- endif -%}

            {%- when 'accordion' -%}
              <div class="sf-pdp-accordion sf-stagger-item" {{ block.shopify_attributes }}>
                <details class="sf-accordion-details">
                  <summary class="sf-accordion-summary">
                    <span class="sf-accordion-title">{{ block.settings.heading }}</span>
                    <span class="sf-accordion-icon"></span>
                  </summary>
                  <div class="sf-accordion-content-wrapper">
                    <div class="sf-accordion-content">
                      {% if block.settings.content != blank %}
                        {{ block.settings.content }}
                      {% else %}
                        {% if block.settings.heading == 'Product Details' or block.settings.heading == 'Details' %}
                          <div class="sf-accordion-meta">
                            <p><strong>Country of Origin:</strong> {{ block.settings.country_of_origin | default: 'India' }}</p>
                            <p><strong>Manufacturer:</strong> {{ block.settings.manufacturer | default: 'Aurelle Luxe Pvt Ltd, Mumbai, India' }}</p>
                            <div style="margin-top: var(--space-12);">{{ product.description }}</div>
                          </div>
                        {% elsif block.settings.heading == 'Shipping' or block.settings.heading == 'Shipping & Returns' %}
                          <div class="sf-accordion-meta">
                            <p>{{ block.settings.shipping_policy | default: 'Free Insured Shipping across India via Express Courier (3-5 working days). Easy 7-day exchange available.' }}</p>
                          </div>
                        {% else %}
                          {{ product.description }}
                        {% endif %}
                      {% endif %}
                    </div>
                  </div>
                </details>
              </div>

            {%- when 'description' -%}
              <div class="sf-pdp-description sf-stagger-item" {{ block.shopify_attributes }}>
                {% if block.settings.text != blank %}
                  {{ block.settings.text }}
                {% else %}
                  {{ product.description }}
                {% endif %}
              </div>

            {%- when 'payment_icons' -%}
              <div class="sf-pdp-payments sf-stagger-item" {{ block.shopify_attributes }}>
                <span class="sf-visually-hidden">Supported payment methods</span>
                <ul class="sf-payment-list">
                  {%- for type in shop.enabled_payment_types -%}
                    <li class="sf-payment-icon">{{ type | payment_type_svg_tag: class: 'icon' }}</li>
                  {%- endfor -%}
                </ul>
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} BELOW THE FOLD BLOCKS {%- endcomment -%}
  <div class="sf-pdp-bottom">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        
        {%- when 'reviews' -%}
          <div class="sf-pdp-reviews-section sf-reveal" id="sf-pdp-reviews-{{ section.id }}" {{ block.shopify_attributes }}>
            <h2 class="sf-pdp-section-title">{{ block.settings.heading | default: 'Customer Reviews' }}</h2>
            <div class="sf-reviews-grid">
              <div class="sf-reviews-summary">
                <div class="sf-rating-big">4.8</div>
                <div class="sf-stars-big">★★★★★</div>
                <p>Based on 128 reviews</p>
                
                <div class="sf-rating-bars">
                  <div class="sf-rating-bar-row"><span>5★</span><div class="sf-bar-track"><div class="sf-bar-fill" style="width: 58%"></div></div><span>58%</span></div>
                  <div class="sf-rating-bar-row"><span>4★</span><div class="sf-bar-track"><div class="sf-bar-fill" style="width: 26%"></div></div><span>26%</span></div>
                  <div class="sf-rating-bar-row"><span>3★</span><div class="sf-bar-track"><div class="sf-bar-fill" style="width: 10%"></div></div><span>10%</span></div>
                  <div class="sf-rating-bar-row"><span>2★</span><div class="sf-bar-track"><div class="sf-bar-fill" style="width: 4%"></div></div><span>4%</span></div>
                  <div class="sf-rating-bar-row"><span>1★</span><div class="sf-bar-track"><div class="sf-bar-fill" style="width: 2%"></div></div><span>2%</span></div>
                </div>
                <button class="sf-btn-outline">Write a Review</button>
              </div>
              <div class="sf-reviews-list">
                <div class="sf-review-card">
                  <div class="sf-review-stars">★★★★★</div>
                  <h4 class="sf-review-title">Absolutely luxurious</h4>
                  <p class="sf-review-text">The texture is incredible. It feels like silk on the skin.</p>
                  <div class="sf-review-author">Aanya Sharma (Mumbai)</div>
                </div>
                <div class="sf-review-card">
                  <div class="sf-review-stars">★★★★★</div>
                  <h4 class="sf-review-title">My holy grail</h4>
                  <p class="sf-review-text">Cannot live without this. Real results in 2 weeks.</p>
                  <div class="sf-review-author">Devika Kapoor (Delhi)</div>
                </div>
              </div>
            </div>
          </div>

        {%- when 'related_products' -%}
          <div class="sf-pdp-related sf-reveal" {{ block.shopify_attributes }}>
            <h2 class="sf-pdp-section-title">{{ block.settings.heading | default: 'You May Also Like' }}</h2>
            
            {%- assign has_related = false -%}
            {%- if recommendations.performed and recommendations.products_count > 0 -%}
              {%- assign related_products_list = recommendations.products -%}
              {%- assign has_related = true -%}
            {%- else -%}
              {%- assign related_collection = product.collections.first -%}
              {%- if related_collection == blank or related_collection.products_count <= 1 -%}
                {%- assign related_collection = collections.all -%}
              {%- endif -%}
              {%- if related_collection != blank and related_collection.products_count > 0 -%}
                {%- assign related_products_list = related_collection.products -%}
                {%- assign has_related = true -%}
              {%- endif -%}
            {%- endif -%}

            <div class="grid grid-cols-2 grid-cols-md-4" style="--grid-spacing: 20px; margin-top: 30px;">
              {%- if has_related -%}
                {%- assign count = 0 -%}
                {%- for rel_product in related_products_list -%}
                  {%- if rel_product.id == product.id -%}{%- continue -%}{%- endif -%}
                  {%- render 'product-card', product: rel_product -%}
                  {%- assign count = count | plus: 1 -%}
                  {%- if count >= 4 -%}{%- break -%}{%- endif -%}
                {%- endfor -%}
                {%- if count == 0 -%}
                  {%- assign has_related = false -%}
                {%- endif -%}
              {%- endif -%}

              {%- unless has_related -%}
                {%- for i in (1..4) -%}
                  <div class="product-card" style="border: 1px solid var(--color-border); border-radius: var(--card-radius); overflow: hidden; background: var(--color-surface);">
                    <div style="aspect-ratio: 3/4; display: flex; align-items: center; justify-content: center; background: #f4f4f4;">
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                    <div style="padding: 16px;">
                      <h3 style="font-family: var(--font-heading-family); font-size: 14px; margin: 0 0 8px; color: var(--color-text);">Curated Luxury Product</h3>
                      <p style="font-weight: bold; font-size: 14px; margin: 0; color: var(--color-text);">{{ 14500 | money }}</p>
                    </div>
                  </div>
                {%- endfor -%}
              {%- endunless -%}
            </div>
          </div>

        {%- when 'recently_viewed' -%}
          <div class="sf-pdp-recent sf-reveal" {{ block.shopify_attributes }}>
            <h2 class="sf-pdp-section-title">{{ block.settings.heading | default: 'Recently Viewed' }}</h2>
            <div class="sf-recent-grid" id="sf-recent-grid-{{ section.id }}">
              <!-- Populated by JS -->
            </div>
          </div>

        {%- when 'cross_sell' -%}
          <div class="sf-pdp-cross sf-reveal" {{ block.shopify_attributes }}>
            <h2 class="sf-pdp-section-title">{{ block.settings.heading | default: 'Complete The Look' }}</h2>
            <div class="sf-cross-bundle">
              <!-- Cross sell mockup -->
              <div class="sf-cross-item">Main Product</div>
              <div class="sf-cross-plus">+</div>
              <div class="sf-cross-item">Companion Product</div>
              <button class="sf-btn-accent sf-hover-lift">Add Bundle - Save 15%</button>
            </div>
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- comment -%} MOBILE STICKY ATC BAR {%- endcomment -%}
  <div class="sf-pdp-sticky-bar" id="sf-sticky-bar-{{ section.id }}" aria-hidden="true">
    <div class="sf-sticky-img">
      {%- if product.featured_media != blank -%}
        <img src="{{ product.featured_media | image_url: width: 100 }}" alt="" width="50" height="50">
      {%- elsif product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 100 }}" alt="" width="50" height="50">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'sf-placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="sf-sticky-info">
      <div class="sf-sticky-title">{{ product.title }}</div>
      <div class="sf-sticky-price" id="sf-sticky-price-{{ section.id }}">{{ current_variant.price | money }}</div>
    </div>
    <button type="button" class="sf-btn-add sf-sticky-add" onclick="document.getElementById('sf-add-btn-{{ section.id }}').click()">
      Add to Bag
    </button>
  </div>

  {%- endif -%}
</div>

<div class="sf-del-result" id="sf-del-res-{{ section.id }}" style="margin-top: var(--space-8); font-size: var(--font-xs); display: none;"></div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Sticky ATC Intersection Observer
    const observer = new IntersectionObserver((entries) => {
      const stickyBar = document.getElementById('sf-sticky-bar-{{ section.id }}');
      if (stickyBar) {
        if (entries[0].isIntersecting) {
          stickyBar.setAttribute('aria-hidden', 'true');
          stickyBar.classList.remove('is-visible');
        } else {
          stickyBar.setAttribute('aria-hidden', 'false');
          stickyBar.classList.add('is-visible');
        }
      }
    });
    const buyBtn = document.getElementById('sf-add-btn-{{ section.id }}');
    if (buyBtn) observer.observe(buyBtn);

    // 2. Gallery Thumbs & Mobile Swipe
    const thumbs = document.querySelectorAll('#sf-pdp-thumbs-{{ section.id }} .sf-pdp-thumb');
    const slides = document.querySelectorAll('#sf-gallery-viewport-{{ section.id }} .sf-pdp-gallery-slide');
    const viewport = document.getElementById('sf-gallery-viewport-{{ section.id }}');

    function setActiveSlide(index) {
      thumbs.forEach((t, i) => t.classList.toggle('is-active', i === index));
      slides.forEach((s, i) => s.classList.toggle('is-active', i === index));
      if (viewport && slides[index]) {
        viewport.scrollTo({ left: slides[index].offsetLeft, behavior: 'smooth' });
      }
    }

    thumbs.forEach((thumb, idx) => {
      thumb.addEventListener('click', () => setActiveSlide(idx));
    });

    if (viewport && thumbs.length > 1) {
      let isScrolling;
      viewport.addEventListener('scroll', () => {
        window.clearTimeout(isScrolling);
        isScrolling = setTimeout(() => {
          const slideWidth = viewport.clientWidth;
          if (slideWidth > 0) {
            const currentIdx = Math.round(viewport.scrollLeft / slideWidth);
            thumbs.forEach((t, i) => t.classList.toggle('is-active', i === currentIdx));
            slides.forEach((s, i) => s.classList.toggle('is-active', i === currentIdx));
          }
        }, 66);
      }, { passive: true });
    }

    if (window.PubSub) {
      window.PubSub.subscribe('variant:media-change', (data) => {
        if (data && data.mediaId) {
          const targetThumb = document.querySelector(`#sf-pdp-thumbs-{{ section.id }} .sf-pdp-thumb[data-media-id="${data.mediaId}"]`);
          if (targetThumb) targetThumb.click();
        }
      });
    }

    // 3. Delivery Estimate Checker (India-First)
    const delBtn = document.querySelector('.sf-pdp-delivery button.sf-del-btn');
    const delInput = document.querySelector('.sf-pdp-delivery input.sf-del-input');
    const delRes = document.getElementById('sf-del-res-{{ section.id }}');
    if (delBtn && delInput && delRes) {
      delBtn.addEventListener('click', () => {
        const pin = delInput.value.trim();
        if (/^\d{6}$/.test(pin)) {
          delRes.style.display = 'block';
          delRes.style.color = 'var(--color-text)';
          delRes.innerHTML = `⚡ Estimated Delivery: <strong>3-5 working days</strong> to ${pin} via Express Shipping | COD Available`;
        } else {
          delRes.style.display = 'block';
          delRes.style.color = 'var(--color-accent)';
          delRes.innerHTML = 'Please enter a valid 6-digit Indian pincode.';
        }
      });
    }

    // 4. Quantity Selector Buttons
    const qtyInput = document.getElementById('sf-qty-{{ section.id }}');
    const qtyMinus = document.querySelector('.sf-qty-minus');
    const qtyPlus = document.querySelector('.sf-qty-plus');
    if (qtyInput && qtyMinus && qtyPlus) {
      qtyMinus.addEventListener('click', () => {
        const currentVal = parseInt(qtyInput.value || '1', 10);
        if (currentVal > 1) qtyInput.value = currentVal - 1;
      });
      qtyPlus.addEventListener('click', () => {
        const currentVal = parseInt(qtyInput.value || '1', 10);
        qtyInput.value = currentVal + 1;
      });
    }

    // 5. Recently Viewed Products (localStorage Tracker & Populator)
    const recentGrid = document.getElementById('sf-recent-grid-{{ section.id }}');
    if (recentGrid && window.localStorage) {
      try {
        const STORAGE_KEY = 'sf_recently_viewed';
        let recent = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        
        const toDisplay = recent.filter(p => p.handle !== '{{ product.handle }}').slice(0, 4);
        if (toDisplay.length > 0) {
          recentGrid.innerHTML = toDisplay.map(p => `
            <div class="sf-product-card">
              <a href="${p.url}">
                <img src="${p.image}" width="400" height="500" alt="${p.title}" loading="lazy">
                <h3>${p.title}</h3>
                <p>${p.price}</p>
              </a>
            </div>
          `).join('');
        } else {
          recentGrid.innerHTML = '<p style="grid-column: 1/-1; color: var(--color-text-muted);">No recently viewed items yet.</p>';
        }

        {%- if product != empty -%}
        const curProd = {
          handle: '{{ product.handle }}',
          title: {{ product.title | json }},
          url: '{{ product.url }}',
          price: '{{ current_variant.price | money }}',
          image: '{{ product.featured_image | image_url: width: 400 }}'
        };
        recent = [curProd, ...recent.filter(p => p.handle !== curProd.handle)].slice(0, 10);
        localStorage.setItem(STORAGE_KEY, JSON.stringify(recent));
        {%- endif -%}
      } catch (e) {
        console.warn('Recently viewed tracking error:', e);
      }
    }
  });
</script>

