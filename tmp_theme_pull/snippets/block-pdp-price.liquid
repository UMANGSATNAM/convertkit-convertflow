<div class="sf-pdp-price-row sf-stagger-item" {{ block.shopify_attributes }}>
                  <span class="sf-pdp-price" id="sf-pdp-price-{{ section.id }}">₹{{ current_variant.price | money_without_currency | remove: '.00' }}</span>
                  {%- if on_sale -%}
                    <s class="sf-pdp-compare-price" id="sf-pdp-compare-price-{{ section.id }}">₹{{ current_variant.compare_at_price | money_without_currency | remove: '.00' }}</s>
                    <span class="sf-pdp-save-badge" id="sf-pdp-save-badge-{{ section.id }}">Save ₹{{ diff | money_without_currency | remove: '.00' }}</span>
                  {%- endif -%}
                  <p class="sf-pdp-tax-note">Inclusive of all taxes & Free Insured Shipping</p>
                </div>
