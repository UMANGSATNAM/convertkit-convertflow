<div class="sf-pdp-tabs-section sf-stagger-item" {{ block.shopify_attributes }}>
                  <div class="sf-tabs-header">
                    <button class="sf-tab-btn is-active" data-tab="desc">Description</button>
                    <button class="sf-tab-btn" data-tab="faq">FAQ</button>
                  </div>
                  <div class="sf-tabs-content">
                    <div class="sf-tab-pane is-active" id="sf-tab-desc">
                      {{ product.description }}
                    </div>
                    <div class="sf-tab-pane" id="sf-tab-faq">
                      {{ block.settings.faq_content | default: '<p>Free returns within 7 days. COD available.</p>' }}
                    </div>
                  </div>
                </div>
