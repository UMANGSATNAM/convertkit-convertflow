{%- if block.settings.review_1_text != blank -%}
          <div class="sf-pdp-reviews-section sf-reveal" id="sf-pdp-reviews-{{ section.id }}" {{ block.shopify_attributes }}>
            <h2 class="sf-pdp-section-title">{{ block.settings.heading | default: 'Customer Reviews' }}</h2>
            <div class="sf-reviews-grid">
              <div class="sf-reviews-list">
                {%- if block.settings.review_1_text != blank -%}
                <div class="sf-review-card">
                  <div class="sf-review-stars">★★★★★</div>
                  <h4 class="sf-review-title">{{ block.settings.review_1_title }}</h4>
                  <p class="sf-review-text">{{ block.settings.review_1_text }}</p>
                  <div class="sf-review-author">{{ block.settings.review_1_author }}</div>
                </div>
                {%- endif -%}
                {%- if block.settings.review_2_text != blank -%}
                <div class="sf-review-card">
                  <div class="sf-review-stars">★★★★★</div>
                  <h4 class="sf-review-title">{{ block.settings.review_2_title }}</h4>
                  <p class="sf-review-text">{{ block.settings.review_2_text }}</p>
                  <div class="sf-review-author">{{ block.settings.review_2_author }}</div>
                </div>
                {%- endif -%}
              </div>
            </div>
          </div>
          {%- endif -%}
