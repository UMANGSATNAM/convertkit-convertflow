  Food & Beverage intelligence block. Added conditionally by the Engine.
{%- endcomment -%}
<div class="sf-product-block sf-food-block py-6 border-t border-[var(--color-border)]" style="content-visibility: auto;">
  <h4 class="text-sm uppercase tracking-widest text-[var(--color-text-secondary)] mb-4">Taste & Sourcing</h4>
  <div class="flex flex-wrap gap-2">
    <span class="px-3 py-1 bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text)] text-sm font-medium rounded-full">Organic</span>
    <span class="px-3 py-1 bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text)] text-sm font-medium rounded-full">Non-GMO</span>
    <span class="px-3 py-1 bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text)] text-sm font-medium rounded-full">Ethically Sourced</span>
  </div>
  <div class="mt-4 p-4 bg-[var(--color-surface)] rounded-[var(--radius-card)]">
    <p class="text-sm text-[var(--color-text-secondary)]">
      <strong class="text-[var(--color-text)]">Freshness Guarantee:</strong> Sourced in small batches and shipped directly to ensure maximum freshness and flavor profile upon arrival.
    </p>
  </div>
</div>
