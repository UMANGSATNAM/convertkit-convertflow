<div class="sf-timeline sf-tl-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-tl-header">
    <h2 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
    <p style="color: {{ section.settings.text_color }};">{{ section.settings.subtitle }}</p>
  </div>
  
  <div class="sf-tl-wrapper">
    <div class="sf-tl-line"></div>
    {% for block in section.blocks %}
      <div class="sf-tl-item {% cycle 'sf-tl-left', 'sf-tl-right' %}">
        <div class="sf-tl-dot"></div>
        <div class="sf-tl-content">
          <span class="sf-tl-year" style="color: {{ section.settings.text_color }};">{{ block.settings.year }}</span>
          <h3 style="color: {{ section.settings.text_color }};">{{ block.settings.title }}</h3>
          <p style="color: {{ section.settings.text_color }};">{{ block.settings.text }}</p>
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title }}" loading="lazy">
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .sf-tl-{{ section.id }} { padding: 5rem 1rem; overflow: hidden; }
  .sf-tl-header { text-align: center; margin-bottom: 4rem; }
  .sf-tl-header h2 { font-size: 2.5rem; margin-bottom: 1rem; }
  .sf-tl-wrapper { position: relative; max-width: 1000px; margin: 0 auto; }
  .sf-tl-line { position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; background: var(--color-border); transform: translateX(-50%); }
  .sf-tl-item { position: relative; width: 50%; padding: 2rem 3rem; box-sizing: border-box; }
  .sf-tl-left { left: 0; text-align: right; }
  .sf-tl-right { left: 50%; text-align: left; }
  .sf-tl-dot { position: absolute; top: 2.5rem; width: 20px; height: 20px; background: var(--color-text); border-radius: 50%; border: 4px solid var(--color-background); z-index: 2; }
  .sf-tl-left .sf-tl-dot { right: -10px; }
  .sf-tl-right .sf-tl-dot { left: -10px; }
  .sf-tl-content { background: var(--color-surface); padding: 2rem; border-radius: 8px; box-shadow: 0 4px 15px color-mix(in srgb, var(--color-text) 5%, transparent); }
  .sf-tl-year { font-size: 1.5rem; font-weight: bold; opacity: 0.5; display: block; margin-bottom: 0.5rem; }
  .sf-tl-content h3 { font-size: 1.5rem; margin-top: 0; margin-bottom: 1rem; }
  .sf-tl-content p { opacity: 0.8; line-height: 1.6; }
  .sf-tl-content img { width: 100%; border-radius: 4px; margin-top: 1rem; }
  
  @media (max-width: 767px) {
    .sf-tl-line { left: 30px; }
    .sf-tl-item { width: 100%; left: 0; text-align: left; padding: 2rem 0 2rem 60px; }
    .sf-tl-left .sf-tl-dot, .sf-tl-right .sf-tl-dot { left: 20px; right: auto; }
  }
</style>

{% schema %}
{
  "name": "Vertical Timeline",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111111" },
    { "type": "text", "id": "title", "label": "Title", "default": "Our Journey" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "How we started and where we are." }
  ],
  "blocks": [
    {
      "type": "milestone", "name": "Milestone",
      "settings": [
        { "type": "text", "id": "year", "label": "Year", "default": "2020" },
        { "type": "text", "id": "title", "label": "Title", "default": "The Beginning" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "We started with a simple idea." },
        { "type": "image_picker", "id": "image", "label": "Image (Optional)" }
      ]
    }
  ],
  "presets": [ { "name": "Vertical Timeline", "category": "Story" } ]
}
{% endschema %}
