<header class="sf-header" style="padding: 1rem; text-align: center; border-bottom: 1px solid #000;">
  <h1>{{ shop.name }}</h1>
  <nav>
    {% for link in linklists.main-menu.links %}
      <a href="{{ link.url }}" style="margin: 0 0.5rem;">{{ link.title }}</a>
    {% endfor %}
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
