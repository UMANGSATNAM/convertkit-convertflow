<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <link rel="canonical" href="{{ canonical_url }}">
    
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }} &ndash; {{ 'general.password.title' | t }}</title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;700&family=Inter:wght@400;500;600&display=swap">
    {{ 'base-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'responsive.css' | asset_url | stylesheet_tag }}
    {{ 'animations.css' | asset_url | stylesheet_tag }}
    {{ 'niche-tokens.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="password-layout-body">
    <header class="password-header">
      <h1 class="password-logo-text">{{ shop.name }}</h1>
    </header>

    <main id="MainContent" class="password-main" role="main">
      {{ content_for_layout }}
    </main>

    <footer class="password-footer">
      <div class="password-footer-text">
        {{ 'general.password.powered_by_shopify' | t }}
      </div>
    </footer>
  </body>
</html>
