{% comment %}
  ConvertFlow - Luxury Beauty & Skincare Bento Grid Showcase
  Editorial high-converting bento layout for D2C Beauty Brands.
  Features: Product Hero Spotlight, Clinical Trial Matrix, Botanical Ingredients,
  Interactive Before/After Slider, Editorial Press Proof, and real AJAX Cart.
{% endcomment %}

{%- assign target_product = all_products[section.settings.featured_product] | default: product -%}
{%- assign current_variant = target_product.selected_or_first_available_variant -%}

<div class="cf-beauty-bento-wrap" id="cf-bento-{{ section.id }}" data-section-id="{{ section.id }}">
  <style>
    #cf-bento-{{ section.id }} {
      --cf-bg: {{ section.settings.bg_color | default: "#0a0b0e" }};
      --cf-tile-bg: {{ section.settings.tile_bg | default: "#12141a" }};
      --cf-border: {{ section.settings.border_color | default: "#232834" }};
      --cf-text-main: {{ section.settings.text_color | default: "#f8fafc" }};
      --cf-text-muted: {{ section.settings.muted_color | default: "#94a3b8" }};
      --cf-gold: {{ section.settings.accent_gold | default: "#e2b887" }};
      --cf-sage: {{ section.settings.accent_sage | default: "#10b981" }};
      --cf-btn-bg: {{ section.settings.btn_bg | default: "#ffffff" }};
      --cf-btn-text: {{ section.settings.btn_text | default: "#0a0b0e" }};

      background: var(--cf-bg);
      color: var(--cf-text-main);
      padding: {{ section.settings.padding_y | default: 80 }}px 20px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    #cf-bento-{{ section.id }} * {
      box-sizing: border-box;
    }

    #cf-bento-{{ section.id }} .cf-bento-container {
      max-width: 1200px;
      margin: 0 auto;
    }

    /* Editorial Section Header */
    #cf-bento-{{ section.id }} .cf-bento-header {
      text-align: center;
      max-width: 680px;
      margin: 0 auto 48px auto;
    }

    #cf-bento-{{ section.id }} .cf-editorial-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 14px;
      border-radius: 20px;
      background: rgba(226, 184, 135, 0.1);
      border: 1px solid rgba(226, 184, 135, 0.3);
      color: var(--cf-gold);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 14px;
    }

    #cf-bento-{{ section.id }} .cf-main-headline {
      font-size: clamp(32px, 4.5vw, 48px);
      font-weight: 800;
      line-height: 1.1;
      margin: 0 0 14px 0;
      color: #ffffff;
      letter-spacing: -0.03em;
    }

    #cf-bento-{{ section.id }} .cf-sub-headline {
      font-size: 16px;
      color: var(--cf-text-muted);
      line-height: 1.6;
      margin: 0;
    }

    /* Bento Grid System */
    #cf-bento-{{ section.id }} .cf-bento-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      grid-template-rows: auto auto;
      gap: 20px;
    }

    #cf-bento-{{ section.id }} .cf-tile {
      background: var(--cf-tile-bg);
      border: 1px solid var(--cf-border);
      border-radius: 12px;
      padding: 28px;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: border-color 0.25s ease, transform 0.25s ease;
    }

    #cf-bento-{{ section.id }} .cf-tile:hover {
      border-color: rgba(226, 184, 135, 0.4);
    }

    /* TILE 1: Crown Hero Product Spotlight (Spans 2 Rows) */
    #cf-bento-{{ section.id }} .cf-tile-hero {
      grid-column: 1 / 2;
      grid-row: 1 / 3;
      padding: 36px 32px;
      background: linear-gradient(180deg, #161922 0%, #101218 100%);
    }

    #cf-bento-{{ section.id }} .cf-hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(16, 185, 129, 0.12);
      color: var(--cf-sage);
      border: 1px solid rgba(16, 185, 129, 0.3);
      padding: 4px 10px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 16px;
    }

    #cf-bento-{{ section.id }} .cf-product-name {
      font-size: 30px;
      font-weight: 900;
      line-height: 1.15;
      margin: 0 0 10px 0;
      color: #ffffff;
      letter-spacing: -0.02em;
    }

    #cf-bento-{{ section.id }} .cf-product-desc {
      font-size: 14px;
      line-height: 1.6;
      color: var(--cf-text-muted);
      margin: 0 0 20px 0;
    }

    #cf-bento-{{ section.id }} .cf-product-img-box {
      width: 100%;
      height: 260px;
      border-radius: 8px;
      background: radial-gradient(circle at center, #262c3b 0%, #131720 70%);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    #cf-bento-{{ section.id }} .cf-product-img-box img {
      max-width: 85%;
      max-height: 85%;
      object-fit: contain;
      filter: drop-shadow(0 15px 25px rgba(0, 0, 0, 0.6));
      transition: transform 0.3s ease;
    }

    #cf-bento-{{ section.id }} .cf-tile-hero:hover .cf-product-img-box img {
      transform: scale(1.04);
    }

    #cf-bento-{{ section.id }} .cf-hero-pricing {
      display: flex;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 18px;
    }

    #cf-bento-{{ section.id }} .cf-price-now {
      font-size: 28px;
      font-weight: 900;
      color: #ffffff;
    }

    #cf-bento-{{ section.id }} .cf-price-was {
      font-size: 17px;
      color: var(--cf-text-muted);
      text-decoration: line-through;
    }

    #cf-bento-{{ section.id }} .cf-hero-atc-btn {
      width: 100%;
      background: var(--cf-btn-bg);
      color: var(--cf-btn-text);
      font-size: 14px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border: none;
      padding: 16px 24px;
      border-radius: 6px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
      box-shadow: 0 4px 18px rgba(255, 255, 255, 0.15);
    }

    #cf-bento-{{ section.id }} .cf-hero-atc-btn:hover {
      background: #e2e8f0;
      transform: translateY(-2px);
    }

    /* TILE 2: Clinical Trial Data Matrix */
    #cf-bento-{{ section.id }} .cf-tile-clinical {
      grid-column: 2 / 3;
      grid-row: 1 / 2;
      background: #11141c;
    }

    #cf-bento-{{ section.id }} .cf-stat-card {
      margin-bottom: 14px;
    }

    #cf-bento-{{ section.id }} .cf-stat-number {
      font-size: 38px;
      font-weight: 900;
      color: var(--cf-gold);
      line-height: 1;
      margin-bottom: 4px;
      letter-spacing: -0.02em;
    }

    #cf-bento-{{ section.id }} .cf-stat-label {
      font-size: 13px;
      color: #cbd5e1;
      font-weight: 600;
      line-height: 1.4;
    }

    #cf-bento-{{ section.id }} .cf-clinical-footnote {
      font-size: 11px;
      color: var(--cf-text-muted);
      margin-top: 10px;
      border-top: 1px solid var(--cf-border);
      padding-top: 10px;
    }

    /* TILE 3: Botanical Ingredient Architecture */
    #cf-bento-{{ section.id }} .cf-tile-ingredients {
      grid-column: 3 / 4;
      grid-row: 1 / 2;
      background: #11141c;
    }

    #cf-bento-{{ section.id }} .cf-ingredient-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 16px;
    }

    #cf-bento-{{ section.id }} .cf-ing-icon {
      width: 32px;
      height: 32px;
      border-radius: 6px;
      background: rgba(16, 185, 129, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    #cf-bento-{{ section.id }} .cf-ing-icon svg {
      width: 16px;
      height: 16px;
      stroke: var(--cf-sage);
    }

    #cf-bento-{{ section.id }} .cf-ing-title {
      font-size: 13px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 2px;
    }

    #cf-bento-{{ section.id }} .cf-ing-role {
      font-size: 11px;
      color: var(--cf-text-muted);
    }

    /* TILE 4: Interactive Before & After Visual Slider */
    #cf-bento-{{ section.id }} .cf-tile-before-after {
      grid-column: 2 / 3;
      grid-row: 2 / 3;
      background: #0f121a;
      padding: 22px;
    }

    #cf-bento-{{ section.id }} .cf-ba-container {
      position: relative;
      width: 100%;
      height: 170px;
      border-radius: 8px;
      overflow: hidden;
      margin-top: 12px;
      user-select: none;
      border: 1px solid var(--cf-border);
    }

    #cf-bento-{{ section.id }} .cf-ba-before,
    #cf-bento-{{ section.id }} .cf-ba-after {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #cf-bento-{{ section.id }} .cf-ba-before {
      background: #1a1e28;
      color: #94a3b8;
    }

    #cf-bento-{{ section.id }} .cf-ba-after {
      background: linear-gradient(135deg, #1b2824 0%, #0d1a15 100%);
      color: #34d399;
      clip-path: inset(0 0 0 50%);
      transition: clip-path 0.05s ease;
    }

    #cf-bento-{{ section.id }} .cf-ba-slider {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: ew-resize;
      z-index: 5;
    }

    #cf-bento-{{ section.id }} .cf-ba-handle-line {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 2px;
      background: #ffffff;
      pointer-events: none;
      z-index: 4;
      transform: translateX(-50%);
    }

    /* TILE 5: Press Praise & Community Reviews */
    #cf-bento-{{ section.id }} .cf-tile-reviews {
      grid-column: 3 / 4;
      grid-row: 2 / 3;
      background: #11141c;
    }

    #cf-bento-{{ section.id }} .cf-star-row {
      display: flex;
      gap: 3px;
      margin-bottom: 10px;
    }

    #cf-bento-{{ section.id }} .cf-star-icon {
      width: 15px;
      height: 15px;
      fill: var(--cf-gold);
    }

    #cf-bento-{{ section.id }} .cf-quote-text {
      font-size: 14px;
      line-height: 1.5;
      font-style: italic;
      color: #f1f5f9;
      margin: 0 0 14px 0;
    }

    #cf-bento-{{ section.id }} .cf-reviewer-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    #cf-bento-{{ section.id }} .cf-reviewer-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #1e2532;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 800;
      color: var(--cf-gold);
    }

    #cf-bento-{{ section.id }} .cf-reviewer-name {
      font-size: 12px;
      font-weight: 700;
      color: #ffffff;
    }

    #cf-bento-{{ section.id }} .cf-reviewer-tag {
      font-size: 10px;
      color: var(--cf-sage);
    }

    /* Responsive Breakpoints */
    @media (max-width: 960px) {
      #cf-bento-{{ section.id }} .cf-bento-grid {
        grid-template-columns: 1fr 1fr;
      }
      #cf-bento-{{ section.id }} .cf-tile-hero {
        grid-column: 1 / 3;
        grid-row: auto;
      }
      #cf-bento-{{ section.id }} .cf-tile-clinical { grid-column: 1 / 2; grid-row: auto; }
      #cf-bento-{{ section.id }} .cf-tile-ingredients { grid-column: 2 / 3; grid-row: auto; }
      #cf-bento-{{ section.id }} .cf-tile-before-after { grid-column: 1 / 2; grid-row: auto; }
      #cf-bento-{{ section.id }} .cf-tile-reviews { grid-column: 2 / 3; grid-row: auto; }
    }

    @media (max-width: 640px) {
      #cf-bento-{{ section.id }} .cf-bento-grid {
        grid-template-columns: 1fr;
      }
      #cf-bento-{{ section.id }} .cf-tile-hero,
      #cf-bento-{{ section.id }} .cf-tile-clinical,
      #cf-bento-{{ section.id }} .cf-tile-ingredients,
      #cf-bento-{{ section.id }} .cf-tile-before-after,
      #cf-bento-{{ section.id }} .cf-tile-reviews {
        grid-column: 1 / 2;
      }
    }
  </style>

  <div class="cf-bento-container">
    <!-- Header -->
    <div class="cf-bento-header">
      <div class="cf-editorial-pill">
        <span>✨ {{ section.settings.pill_text | default: "The Cellular Barrier Ritual" }}</span>
      </div>
      <h2 class="cf-main-headline">
        {{ section.settings.headline | default: "CLINICALLY PROVEN TO RESTORE CELLULAR RADIANCE." }}
      </h2>
      <p class="cf-sub-headline">
        {{ section.settings.subheadline | default: "Engineered with bio-fermented peptides and pure botanical squalane. Zero synthetic fillers, 100% active results." }}
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="cf-bento-grid">
      <!-- TILE 1: Hero Product Spotlight -->
      <div class="cf-tile cf-tile-hero">
        <div>
          <div class="cf-hero-badge">
            <span>● {{ section.settings.hero_badge | default: "Award Winner 2026" }}</span>
          </div>
          <h3 class="cf-product-name">
            {{ target_product.title | default: section.settings.hero_product_title | default: "Bio-Peptide Glass Skin Elixir" }}
          </h3>
          <p class="cf-product-desc">
            {{ section.settings.hero_desc | default: "Ultra-concentrated restorative serum that repairs skin barrier in 7 days with zero irritation." }}
          </p>

          <div class="cf-product-img-box">
            {% if section.settings.hero_image != blank %}
              <img src="{{ section.settings.hero_image | image_url: width: 800 }}" alt="{{ target_product.title }}" loading="lazy" />
            {% else %}
              <div style="text-align: center; color: #64748b;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                <div style="font-size: 12px; margin-top: 8px;">Upload Bottle / Dropper Image in Theme Editor</div>
              </div>
            {% endif %}
          </div>
        </div>

        <div>
          <div class="cf-hero-pricing">
            <span class="cf-price-now">
              {{ current_variant.price | default: 8400 | money }}
            </span>
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="cf-price-was">{{ current_variant.compare_at_price | money }}</span>
            {% endif %}
          </div>

          {% form 'product', target_product, id: 'cf-bento-form-{{ section.id }}' %}
            <input type="hidden" name="id" value="{{ current_variant.id }}" id="cf-bento-variant-{{ section.id }}">
            <button type="submit" class="cf-hero-atc-btn" id="cf-bento-btn-{{ section.id }}">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              <span>{{ section.settings.cta_text | default: "Add To Bag — Complimentary Sample" }}</span>
            </button>
          {% endform %}
        </div>
      </div>

      <!-- TILE 2: Clinical Trial Matrix -->
      <div class="cf-tile cf-tile-clinical">
        <div>
          <span style="font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 16px;">
            Clinical Study (28 Days)
          </span>

          <div class="cf-stat-card">
            <div class="cf-stat-number">{{ section.settings.stat_1_num | default: "94%" }}</div>
            <div class="cf-stat-label">{{ section.settings.stat_1_txt | default: "Reported immediate deep hydration & skin barrier plumping" }}</div>
          </div>

          <div class="cf-stat-card">
            <div class="cf-stat-number">{{ section.settings.stat_2_num | default: "89%" }}</div>
            <div class="cf-stat-label">{{ section.settings.stat_2_txt | default: "Reduction in redness & transepidermal water loss" }}</div>
          </div>
        </div>

        <div class="cf-clinical-footnote">
          Based on independent consumer perception study of 120 participants across diverse skin types.
        </div>
      </div>

      <!-- TILE 3: Botanical Ingredient Architecture -->
      <div class="cf-tile cf-tile-ingredients">
        <div>
          <span style="font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 16px;">
            Pure Ingredient Matrix
          </span>

          <div class="cf-ingredient-item">
            <div class="cf-ing-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
            </div>
            <div>
              <div class="cf-ing-title">Bio-Fermented Squalane</div>
              <div class="cf-ing-role">Sugar-cane derived weightless lipid barrier lock</div>
            </div>
          </div>

          <div class="cf-ingredient-item">
            <div class="cf-ing-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            </div>
            <div>
              <div class="cf-ing-title">5% Pure Niacinamide</div>
              <div class="cf-ing-role">Calms redness & refines pores without drying</div>
            </div>
          </div>

          <div class="cf-ingredient-item">
            <div class="cf-ing-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <div class="cf-ing-title">Centella Asiatica</div>
              <div class="cf-ing-role">Soothes inflammation & accelerates recovery</div>
            </div>
          </div>
        </div>

        <div style="font-size: 11px; color: #10b981; font-weight: 700;">
          ✓ 100% Vegan • Cruelty-Free • Fragrance-Free
        </div>
      </div>

      <!-- TILE 4: Interactive Before & After Visual Slider -->
      <div class="cf-tile cf-tile-before-after">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <span style="font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.08em;">
              Visual Proof
            </span>
            <span style="font-size: 10px; color: #10b981; font-weight: 700;">Slide to compare</span>
          </div>

          <div class="cf-ba-container" id="cf-ba-box-{{ section.id }}">
            <div class="cf-ba-before">
              <span>Day 1 • Dehydrated & Dull</span>
            </div>
            <div class="cf-ba-after" id="cf-ba-after-{{ section.id }}">
              <span>Day 28 • Glass Skin Glow</span>
            </div>
            <div class="cf-ba-handle-line" id="cf-ba-line-{{ section.id }}"></div>
            <input type="range" min="0" max="100" value="50" class="cf-ba-slider" id="cf-ba-range-{{ section.id }}">
          </div>
        </div>

        <div style="font-size: 11px; color: #94a3b8; margin-top: 10px;">
          Unretouched patient documentation after 4 weeks of twice-daily use.
        </div>
      </div>

      <!-- TILE 5: Press Praise & Community Reviews -->
      <div class="cf-tile cf-tile-reviews">
        <div>
          <div class="cf-star-row">
            <svg class="cf-star-icon" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg class="cf-star-icon" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg class="cf-star-icon" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg class="cf-star-icon" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg class="cf-star-icon" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>

          <p class="cf-quote-text">
            &ldquo;{{ section.settings.quote | default: "The only formula that repaired my compromised barrier overnight. Absolute perfection." }}&rdquo;
          </p>
        </div>

        <div class="cf-reviewer-info">
          <div class="cf-reviewer-avatar">ES</div>
          <div>
            <div class="cf-reviewer-name">{{ section.settings.reviewer_name | default: "Elena S., Verified Patron" }}</div>
            <div class="cf-reviewer-tag">Vogue Beauty Contributor</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive JavaScript Engine (Before/After Slider & AJAX Add to Bag) -->
  <script>
    (function() {
      const sectionId = "{{ section.id }}";
      const wrap = document.getElementById("cf-bento-" + sectionId);
      if (!wrap) return;

      // Before/After Slider Interaction
      const range = document.getElementById("cf-ba-range-" + sectionId);
      const afterBox = document.getElementById("cf-ba-after-" + sectionId);
      const line = document.getElementById("cf-ba-line-" + sectionId);

      if (range && afterBox && line) {
        range.addEventListener("input", function(e) {
          const val = e.target.value;
          afterBox.style.clipPath = "inset(0 0 0 " + val + "%)";
          line.style.left = val + "%";
        });
      }

      // AJAX Add-to-Bag
      const form = document.getElementById("cf-bento-form-" + sectionId);
      const btn = document.getElementById("cf-bento-btn-" + sectionId);
      if (form && btn) {
        form.addEventListener("submit", function(e) {
          e.preventDefault();
          const variantId = document.getElementById("cf-bento-variant-" + sectionId).value;
          btn.disabled = true;
          const origText = btn.innerHTML;
          btn.innerHTML = "<span>Adding to Bag...</span>";

          fetch("/cart/add.js", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json"
            },
            body: JSON.stringify({ id: variantId, quantity: 1 })
          })
          .then(res => res.json())
          .then(item => {
            btn.innerHTML = "<span>✓ Added to Bag!</span>";
            document.dispatchEvent(new CustomEvent("cart:update"));
            document.dispatchEvent(new CustomEvent("ajaxProduct:added", { detail: item }));
            setTimeout(() => {
              btn.disabled = false;
              btn.innerHTML = origText;
            }, 2500);
          })
          .catch(err => {
            btn.disabled = false;
            btn.innerHTML = origText;
          });
        });
      }
    })();
  </script>
</div>

