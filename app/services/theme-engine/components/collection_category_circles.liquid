{%- comment -%}
  collection_category_circles.liquid — Ultra-Comprehensive Category Circles & Navigation
  
  DESIGN PHILOSOPHY:
  An architectural visual navigation showcase engineered to guide users effortlessly through
  distinct product disciplines and collections. Features touch-drag horizontal scrolling,
  gradient ring hover animation, item count badges, and an accessible Collection Quick-Preview
  Modal Dialog for previewing collection highlights without triggering a full page navigation.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --ccc-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --ccc-card-bg: {{ section.settings.card_bg_color | default: '#f8fafc' }};
    --ccc-text: {{ section.settings.text_color | default: '#0f172a' }};
    --ccc-muted: color-mix(in srgb, var(--ccc-text) 60%, transparent);
    --ccc-border: color-mix(in srgb, var(--ccc-text) 12%, transparent);
    --ccc-accent: {{ section.settings.accent_color | default: '#0f172a' }};
    --ccc-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --ccc-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --ccc-padding-top: clamp(3.5rem, 8vw, 6rem);
    --ccc-padding-bottom: clamp(3.5rem, 8vw, 6rem);
    --ccc-circle-size: {{ section.settings.circle_size | default: '140px' }};
  }

  .ccc-section {
    background-color: var(--ccc-bg);
    color: var(--ccc-text);
    font-family: var(--ccc-font-body);
    padding: var(--ccc-padding-top) clamp(1.25rem, 4vw, 4rem) var(--ccc-padding-bottom);
    border-bottom: 1px solid var(--ccc-border);
    position: relative;
    overflow: hidden;
  }

  .ccc-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  /* Section Header */
  .ccc-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: {{ section.settings.text_alignment | default: 'center' }};
    align-items: {% if section.settings.text_alignment == 'left' %}flex-start{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}center{% endif %};
    max-width: 760px;
    margin: 0 auto;
  }
  .ccc-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--ccc-accent);
    background: color-mix(in srgb, var(--ccc-accent) 8%, transparent);
    padding: 0.4rem 1rem;
    border-radius: 100px;
  }
  .ccc-title {
    font-family: var(--ccc-font-head);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }
  .ccc-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--ccc-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Scroll Carousel Controls */
  .ccc-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .ccc-hint {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ccc-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .ccc-arrows {
    display: flex;
    gap: 0.5rem;
  }
  .ccc-arrow {
    background: var(--ccc-card-bg);
    border: 1px solid var(--ccc-border);
    color: var(--ccc-text);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .ccc-arrow:hover {
    background: var(--ccc-accent);
    color: #ffffff;
    border-color: var(--ccc-accent);
  }
  .ccc-arrow svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 2.2;
    fill: none;
  }

  /* Circles Scroll Strip */
  .ccc-strip {
    display: flex;
    gap: clamp(1.5rem, 3.5vw, 3rem);
    overflow-x: auto;
    padding: 0.5rem 0.5rem 1.5rem;
    scrollbar-width: thin;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }
  .ccc-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    flex-shrink: 0;
    width: var(--ccc-circle-size);
    text-decoration: none;
    color: inherit;
    group: true;
  }

  /* Circle Ring Avatar Box */
  .ccc-avatar-wrap {
    width: var(--ccc-circle-size);
    height: var(--ccc-circle-size);
    border-radius: 50%;
    padding: 4px;
    background: transparent;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }
  .ccc-item:hover .ccc-avatar-wrap {
    background: linear-gradient(135deg, var(--ccc-accent), color-mix(in srgb, var(--ccc-accent) 20%, transparent));
    transform: translateY(-6px) scale(1.04);
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.15);
  }
  .ccc-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: var(--ccc-card-bg);
    border: 2px solid var(--ccc-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .ccc-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ccc-item:hover .ccc-avatar img {
    transform: scale(1.12);
  }

  /* Count Badge */
  .ccc-badge {
    position: absolute;
    bottom: 4px;
    right: 4px;
    background: var(--ccc-accent);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
    border: 2px solid var(--ccc-bg);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
  }

  /* Text Info */
  .ccc-name {
    font-family: var(--ccc-font-head);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ccc-text);
    transition: color 0.2s ease;
    margin: 0;
  }
  .ccc-item:hover .ccc-name {
    color: var(--ccc-accent);
  }
  .ccc-meta {
    font-size: 0.78rem;
    color: var(--ccc-muted);
    margin-top: -0.5rem;
  }

  /* Preview Button Trigger */
  .ccc-preview-btn {
    background: transparent;
    border: none;
    color: var(--ccc-muted);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .ccc-preview-btn:hover {
    color: var(--ccc-accent);
  }

  /* Collection Quick-Preview Modal Dialog */
  .ccc-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .ccc-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .ccc-modal {
    background: var(--ccc-card-bg);
    color: var(--ccc-text);
    border: 1px solid var(--ccc-border);
    border-radius: 28px;
    max-width: 560px;
    width: 100%;
    padding: clamp(2rem, 5vw, 3rem);
    position: relative;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.8);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ccc-modal-overlay[data-open="true"] .ccc-modal {
    transform: scale(1);
  }
  .ccc-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: color-mix(in srgb, var(--ccc-text) 10%, transparent);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ccc-text);
    cursor: pointer;
  }
</style>

<section class="ccc-section" id="ccc-section-{{ section.id }}" aria-labelledby="ccc-title-{{ section.id }}">
  <div class="ccc-container">
    
    <!-- Section Header -->
    <div class="ccc-header">
      {%- if section.settings.eyebrow != blank -%}
        <div class="ccc-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 id="ccc-title-{{ section.id }}" class="ccc-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="ccc-desc">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <!-- Scroll Controls Bar -->
    <div class="ccc-nav-bar">
      <div class="ccc-hint">
        <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;"><path d="M18 8L22 12L18 16"></path><path d="M6 8L2 12L6 16"></path><line x1="2" y1="12" x2="22" y2="12"></line></svg>
        <span>Swipe or click arrows to explore all disciplines</span>
      </div>
      <div class="ccc-arrows">
        <button type="button" class="ccc-arrow" id="ccc-prev-{{ section.id }}" aria-label="Scroll category strip left">
          <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button type="button" class="ccc-arrow" id="ccc-next-{{ section.id }}" aria-label="Scroll category strip right">
          <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>

    <!-- Category Circles Strip -->
    <div class="ccc-strip" id="ccc-strip-{{ section.id }}" role="list">
      {%- for block in section.blocks -%}
        <div class="ccc-item" role="listitem" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.collection_url | default: '/collections/all' }}" style="text-decoration:none;color:inherit;display:flex;flex-direction:column;align-items:center;gap:0.85rem;">
            <div class="ccc-avatar-wrap">
              <div class="ccc-avatar">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.title }}
                {%- else -%}
                  <div style="width:100%;height:100%;background:#333;display:flex;align-items:center;justify-content:center;color:#aaa;font-size:0.8rem;font-weight:700;">Cat {{ forloop.index }}</div>
                {%- endif -%}
              </div>
              <span class="ccc-badge">{{ block.settings.count | default: '12' }}</span>
            </div>

            <h3 class="ccc-name">{{ block.settings.title }}</h3>
            <span class="ccc-meta">{{ block.settings.subtitle | default: 'Bespoke Series' }}</span>
          </a>

          <button type="button" class="ccc-preview-btn" data-title="{{ block.settings.title }}" data-desc="{{ block.settings.preview_desc | default: 'An exceptional selection of high-precision instruments engineered with custom acoustics and CNC titanium housing.' }}" aria-label="Preview {{ block.settings.title }} collection highlights">Quick Preview</button>
        </div>
      {%- endfor -%}
    </div>

  </div>

  <!-- Collection Quick-Preview Modal -->
  <div class="ccc-modal-overlay" id="ccc-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="ccc-modal">
      <button type="button" class="ccc-modal-close" id="ccc-modal-close-{{ section.id }}" aria-label="Close preview modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div style="display:flex;align-items:center;gap:0.75rem;">
        <span style="width:12px;height:12px;border-radius:50%;background:var(--ccc-accent);"></span>
        <span style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:var(--ccc-muted);">Discipline Specification Preview</span>
      </div>

      <h3 id="ccc-modal-title" style="font-family:var(--ccc-font-head);font-size:1.85rem;margin:0;">Collection Discipline</h3>
      <p id="ccc-modal-desc" style="font-size:1rem;line-height:1.65;color:var(--ccc-muted);margin:0;">Collection description preview will appear here.</p>

      <div style="margin-top:1rem;padding-top:1.5rem;border-top:1px solid var(--ccc-border);display:flex;justify-content:space-between;align-items:center;">
        <span style="font-size:0.85rem;font-weight:700;color:var(--ccc-text);">Ready to explore full collection?</span>
        <a href="/collections/all" id="ccc-modal-link" style="background:var(--ccc-text);color:var(--ccc-bg);font-weight:700;font-size:0.88rem;text-decoration:none;padding:0.75rem 1.5rem;border-radius:100px;">Enter Discipline →</a>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('ccc-section-' + sid);
    if (!sectionEl) return;

    // 1. Horizontal Scroll Arrows
    var strip = document.getElementById('ccc-strip-' + sid);
    var prevBtn = document.getElementById('ccc-prev-' + sid);
    var nextBtn = document.getElementById('ccc-next-' + sid);
    if (strip && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', function() {
        strip.scrollBy({ left: -350, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', function() {
        strip.scrollBy({ left: 350, behavior: 'smooth' });
      });
    }

    // 2. Collection Preview Modal Controller
    var modalOverlay = document.getElementById('ccc-modal-' + sid);
    var modalClose = document.getElementById('ccc-modal-close-' + sid);
    if (modalOverlay && modalClose) {
      var titleEl = document.getElementById('ccc-modal-title');
      var descEl = document.getElementById('ccc-modal-desc');
      var linkEl = document.getElementById('ccc-modal-link');

      var btns = sectionEl.querySelectorAll('.ccc-preview-btn');
      btns.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          if (titleEl) titleEl.innerText = btn.getAttribute('data-title') || 'Collection Discipline';
          if (descEl) descEl.innerText = btn.getAttribute('data-desc') || '';

          modalOverlay.setAttribute('data-open', 'true');
          modalOverlay.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
