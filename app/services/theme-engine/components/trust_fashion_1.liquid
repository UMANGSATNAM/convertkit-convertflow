{%- comment -%}
  trust_fashion_1.liquid — Fashion Editorial Trust Pillars
  
  DESIGN PHILOSOPHY:
  Runway-inspired, magazine editorial aesthetic.
  Numbered pillars (01, 02, 03) in elegant typography,
  clean horizontal layout, zero icon clutter.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --fht-bg: var(--color-background, #fff);
    --fht-text: var(--color-text, #111);
    --fht-muted: color-mix(in srgb, var(--fht-text) 45%, transparent);
    --fht-border: color-mix(in srgb, var(--fht-text) 12%, transparent);
    --fht-font: var(--font-body, 'Inter', -apple-system, sans-serif);
    --fht-font-serif: var(--font-heading, 'Cormorant Garamond', Georgia, serif);
  }

  .fht-section {
    background: var(--fht-bg);
    padding: clamp(3.5rem, 8vw, 6rem) clamp(1.25rem, 4vw, 4rem);
    border-top: 1px solid var(--fht-border);
  }

  .fht-inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  .fht-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 768px) {
    .fht-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3.5rem;
    }
  }

  .fht-item {
    display: flex;
    flex-direction: column;
  }

  .fht-num {
    font-family: var(--fht-font-serif);
    font-size: 2.25rem;
    font-weight: 300;
    font-style: italic;
    color: var(--fht-muted);
    line-height: 1;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--fht-border);
  }

  .fht-title {
    font-family: var(--fht-font);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fht-text);
    margin: 0 0 0.6rem 0;
  }

  .fht-desc {
    font-family: var(--fht-font);
    font-size: 0.85rem;
    color: var(--fht-muted);
    line-height: 1.65;
    margin: 0;
  }
</style>

<section class="fht-section" aria-label="Editorial Pillars">
  <div class="fht-inner">
    <div class="fht-grid">
      {%- for block in section.blocks -%}
        <div class="fht-item" {{ block.shopify_attributes }}>
          <div class="fht-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
          <h3 class="fht-title">{{ block.settings.title }}</h3>
          <p class="fht-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fashion Trust Pillars",
  "tag": "section",
  "class": "section-trust-fashion",
  "settings": [],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Sustainable Fabrics"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "We exclusively weave with organic cottons, deadstock silks, and recycled wools."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fashion Trust Pillars",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Sustainable Fabrics", "description": "We exclusively weave with organic cottons, deadstock silks, and recycled wools." } },
        { "type": "pillar", "settings": { "title": "Limited Editions", "description": "Produced in small batches to eliminate waste and guarantee exclusivity." } },
        { "type": "pillar", "settings": { "title": "Global Express Delivery", "description": "Complimentary express courier shipping with carbon-neutral packaging." } }
      ]
    }
  ]
}
{% endschema %}
