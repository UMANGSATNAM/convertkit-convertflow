        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "60-Day Money Back"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Try our products in the comfort of your home for 60 days. If you're not entirely satisfied, receive a full refund with zero return fees."
        },
        {
          "type": "textarea",
