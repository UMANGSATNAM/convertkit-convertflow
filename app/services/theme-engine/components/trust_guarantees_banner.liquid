  ],
  "presets": [
    {
      "name": "Trust Guarantees Banner",
      "blocks": [
        { "type": "guarantee", "settings": { "icon": "money", "title": "60-Day Risk-Free Trial", "text": "Experience our craftsmanship in your home for 60 days. Full refund guaranteed if you aren't completely thrilled." } },
        { "type": "guarantee", "settings": { "icon": "warranty", "title": "10-Year Global Warranty", "text": "Every unit is backed by our comprehensive hardware replacement warranty covering accidental wear and internal defects." } },
        { "type": "guarantee", "settings": { "icon": "shipping", "title": "Carbon-Neutral Delivery", "text": "We cover all shipping and import duties worldwide with real-time GPS courier tracking straight to your door." } }
