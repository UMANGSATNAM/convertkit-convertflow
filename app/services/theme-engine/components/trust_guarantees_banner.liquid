{%- comment -%}
  trust_guarantees_banner.liquid — Ultra-Comprehensive Guarantee & Risk-Free Promise Banner
  
  DESIGN PHILOSOPHY:
  A high-impact conversion booster designed to overcome customer purchase hesitation.
  Features a live daily dispatch countdown timer, interactive guarantee feature blocks
  with SVG icons, glowing trust badge accents, and an accessible warranty explanation
  modal popup to build absolute consumer confidence. Engineered for 60fps performance.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --tgb-bg: {{ section.settings.bg_color | default: '#0f172a' }};
    --tgb-card-bg: {{ section.settings.card_bg_color | default: '#1e293b' }};
    --tgb-text: {{ section.settings.text_color | default: '#f8fafc' }};
    --tgb-muted: color-mix(in srgb, var(--tgb-text) 65%, transparent);
    --tgb-border: color-mix(in srgb, var(--tgb-text) 14%, transparent);
    --tgb-accent: {{ section.settings.accent_color | default: '#38bdf8' }};
    --tgb-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --tgb-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --tgb-padding-top: clamp(3rem, 7vw, 6rem);
    --tgb-padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .tgb-section {
    background-color: var(--tgb-bg);
    color: var(--tgb-text);
    font-family: var(--tgb-font-body);
    padding: var(--tgb-padding-top) clamp(1.25rem, 4vw, 4rem) var(--tgb-padding-bottom);
    border-top: 1px solid var(--tgb-border);
    border-bottom: 1px solid var(--tgb-border);
    position: relative;
    overflow: hidden;
  }

  .tgb-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Countdown & Alert Bar */
  .tgb-timer-bar {
    background: color-mix(in srgb, var(--tgb-accent) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--tgb-accent) 35%, transparent);
    border-radius: 100px;
    padding: 0.75rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    max-width: 860px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
    text-align: center;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .tgb-timer-icon {
    width: 18px;
    height: 18px;
    color: var(--tgb-accent);
    animation: tgbPulse 2s infinite;
  }
  @keyframes tgbPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.15); opacity: 0.8; }
  }
  .tgb-countdown-digits {
    font-family: var(--tgb-font-head);
    background: var(--tgb-accent);
    color: #000000;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-left: 0.25rem;
  }

  /* Section Header */
  .tgb-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(2.5rem, 6vw, 4.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .tgb-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--tgb-accent);
  }
  .tgb-title {
    font-family: var(--tgb-font-head);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 700;
    color: var(--tgb-text);
    line-height: 1.15;
    margin: 0;
  }
  .tgb-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--tgb-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Guarantees Grid */
  .tgb-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .tgb-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .tgb-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    }
  }

  /* Guarantee Card Layout */
  .tgb-card {
    background-color: var(--tgb-card-bg);
    border: 1px solid var(--tgb-border);
    border-radius: 20px;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    position: relative;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .tgb-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -15px rgba(0,0,0,0.4);
    border-color: var(--tgb-accent);
  }

  /* Icon Wrap */
  .tgb-icon-wrap {
    width: 60px;
    height: 60px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--tgb-accent) 15%, transparent);
    color: var(--tgb-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.3s ease;
  }
  .tgb-card:hover .tgb-icon-wrap {
    transform: scale(1.1) rotate(-5deg);
    background: var(--tgb-accent);
    color: #000000;
  }
  .tgb-icon-wrap svg {
    width: 30px;
    height: 30px;
    stroke-width: 2;
    stroke: currentColor;
    fill: none;
  }

  /* Card Typography */
  .tgb-card-title {
    font-family: var(--tgb-font-head);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--tgb-text);
    margin: 0;
    line-height: 1.3;
  }
  .tgb-card-desc {
    font-size: 0.95rem;
    color: var(--tgb-muted);
    line-height: 1.65;
    margin: 0;
  }
  .tgb-claim-btn {
    margin-top: auto;
    background: transparent;
    color: var(--tgb-accent);
    border: none;
    padding: 0;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .tgb-claim-btn:hover {
    opacity: 0.85;
    transform: translateX(4px);
  }
  .tgb-claim-btn svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 2.5;
  }

  /* Modal Dialog */
  .tgb-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .tgb-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .tgb-modal {
    background: var(--tgb-card-bg);
    color: var(--tgb-text);
    border: 1px solid var(--tgb-border);
    border-radius: 24px;
    max-width: 560px;
    width: 100%;
    padding: clamp(2rem, 5vw, 3rem);
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tgb-modal-overlay[data-open="true"] .tgb-modal {
    transform: scale(1);
  }
  .tgb-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: color-mix(in srgb, var(--tgb-text) 10%, transparent);
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--tgb-text);
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .tgb-modal-close:hover {
    background: color-mix(in srgb, var(--tgb-text) 20%, transparent);
  }
  .tgb-modal-title {
    font-family: var(--tgb-font-head);
    font-size: 1.65rem;
    font-weight: 700;
    margin: 0;
  }
  .tgb-modal-desc {
    font-size: 0.95rem;
    color: var(--tgb-muted);
    line-height: 1.65;
    margin: 0;
  }
  .tgb-modal-list {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .tgb-modal-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--tgb-text);
  }
  .tgb-modal-list svg {
    width: 18px;
    height: 18px;
    color: var(--tgb-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .tgb-modal-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--tgb-accent);
    color: #000000;
    font-weight: 700;
    text-decoration: none;
    padding: 1rem 2rem;
    border-radius: 100px;
    margin-top: 1rem;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .tgb-modal-cta:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }
</style>

<section class="tgb-section" id="tgb-section-{{ section.id }}" aria-labelledby="tgb-title-{{ section.id }}">
  <div class="tgb-container">
    
    <!-- Optional Countdown Timer Bar -->
    {%- if section.settings.enable_timer -%}
      <div class="tgb-timer-bar" id="tgb-timer-{{ section.id }}" data-hours="{{ section.settings.cutoff_hours | default: 4 }}">
        <svg class="tgb-timer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        <span>{{ section.settings.timer_text | default: 'Order within' }} <strong class="tgb-countdown-digits" id="tgb-timer-val-{{ section.id }}">03:59:59</strong> {{ section.settings.timer_suffix | default: 'for guaranteed same-day priority dispatch & lifetime warranty activation!' }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.title != blank or section.settings.eyebrow != blank -%}
      <div class="tgb-header">
        {%- if section.settings.eyebrow != blank -%}
          <div class="tgb-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="tgb-title-{{ section.id }}" class="tgb-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="tgb-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Guarantees Grid -->
    <div class="tgb-grid">
      {%- for block in section.blocks -%}
        <div class="tgb-card" {{ block.shopify_attributes }}>
          
          <div class="tgb-icon-wrap">
            {%- case block.settings.icon -%}
              {%- when 'money' -%}
                <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"></path></svg>
              {%- when 'warranty' -%}
                <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
              {%- when 'shipping' -%}
                <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
              {%- when 'support' -%}
                <svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"></path></svg>
              {%- when 'risk' -%}
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              {%- when 'exchange' -%}
                <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"></path></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            {%- endcase -%}
          </div>

          <h3 class="tgb-card-title">{{ block.settings.title }}</h3>
          <p class="tgb-card-desc">{{ block.settings.text }}</p>

          <button 
            type="button" 
            class="tgb-claim-btn" 
            data-title="{{ block.settings.title | escape }}"
            data-desc="{{ block.settings.modal_desc | default: block.settings.text | escape }}"
            aria-label="Learn more about {{ block.settings.title }}"
          >
            <span>{{ block.settings.btn_label | default: 'Guarantee Terms & Claim' }}</span>
            <svg viewBox="0 0 24 24" fill="none"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>

        </div>
      {%- endfor -%}
    </div>

  </div>

  <!-- Guarantee Explanation Modal -->
  <div class="tgb-modal-overlay" id="tgb-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="tgb-modal-title-val">
    <div class="tgb-modal">
      <button type="button" class="tgb-modal-close" id="tgb-modal-close-{{ section.id }}" aria-label="Close modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <h3 class="tgb-modal-title" id="tgb-modal-title-val">Our Guarantee Promise</h3>
      <p class="tgb-modal-desc" id="tgb-modal-desc-val">We stand firmly behind the quality and reliability of everything we craft.</p>

      <ul class="tgb-modal-list">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span><strong>Zero Hassle Process:</strong> No complicated paperwork or return shipping fees. We handle everything for you.</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span><strong>Instant Replacement:</strong> If a defect or issue occurs, we immediately dispatch a brand new replacement.</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span><strong>Dedicated Concierge Support:</strong> Direct access to our priority customer care team 7 days a week.</span>
        </li>
      </ul>

      <a href="/pages/contact" class="tgb-modal-cta">Contact Priority Support →</a>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('tgb-section-' + sid);
    if (!sectionEl) return;

    // 1. Live Countdown Timer Controller
    var timerVal = document.getElementById('tgb-timer-val-' + sid);
    var timerWrap = document.getElementById('tgb-timer-' + sid);
    if (timerVal && timerWrap) {
      var hoursVal = parseInt(timerWrap.getAttribute('data-hours'), 10) || 4;
      var totalSeconds = hoursVal * 3600;

      function updateTimer() {
        if (totalSeconds <= 0) totalSeconds = hoursVal * 3600;
        var h = Math.floor(totalSeconds / 3600);
        var m = Math.floor((totalSeconds % 3600) / 60);
        var s = totalSeconds % 60;
        timerVal.innerText = (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
        totalSeconds--;
      }
      updateTimer();
      setInterval(updateTimer, 1000);
    }

    // 2. Modal Dialog Controller
    var modalOverlay = document.getElementById('tgb-modal-' + sid);
    var modalClose = document.getElementById('tgb-modal-close-' + sid);
    if (modalOverlay && modalClose) {
      var titleEl = document.getElementById('tgb-modal-title-val');
      var descEl = document.getElementById('tgb-modal-desc-val');

      var claimBtns = sectionEl.querySelectorAll('.tgb-claim-btn');
      claimBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (titleEl) titleEl.innerText = btn.getAttribute('data-title') || 'Guarantee Promise';
          if (descEl) descEl.innerText = btn.getAttribute('data-desc') || 'We stand behind our quality.';
          
          modalOverlay.setAttribute('data-open', 'true');
          modalOverlay.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Trust Guarantees Banner",
  "tag": "section",
  "class": "section-trust-guarantees",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#1e293b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#38bdf8"
    },
    {
      "type": "header",
      "content": "Countdown Banner"
    },
    {
      "type": "checkbox",
      "id": "enable_timer",
