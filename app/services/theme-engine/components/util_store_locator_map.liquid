{%- comment -%}
  util_store_locator_map.liquid — Ultra-Comprehensive Global Showroom & Dealer Locator
  
  DESIGN PHILOSOPHY:
  An architectural global showroom locator engineered for luxury hardware experience centers.
  Features region filtering tabs, interactive showroom inspection cards, live operating status badges,
  and an accessible Private Showroom Appointment Booking Lightbox Modal Dialog allowing clients
  to reserve dedicated 1-on-1 acoustic workstation testing sessions.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --usl-bg: {{ section.settings.bg_color | default: '#0a0a0a' }};
    --usl-card-bg: {{ section.settings.card_bg_color | default: '#171717' }};
    --usl-text: {{ section.settings.text_color | default: '#f5f5f5' }};
    --usl-muted: color-mix(in srgb, var(--usl-text) 60%, transparent);
    --usl-border: color-mix(in srgb, var(--usl-text) 15%, transparent);
    --usl-accent: {{ section.settings.accent_color | default: '#38bdf8' }};
    --usl-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --usl-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --usl-padding-top: clamp(4rem, 8vw, 7rem);
    --usl-padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .usl-section {
    background-color: var(--usl-bg);
    color: var(--usl-text);
    font-family: var(--usl-font-body);
    padding: var(--usl-padding-top) clamp(1.25rem, 4vw, 4rem) var(--usl-padding-bottom);
    border-bottom: 1px solid var(--usl-border);
    position: relative;
  }

  .usl-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* Section Header */
  .usl-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--usl-border);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .usl-head-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 680px;
  }
  .usl-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--usl-accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .usl-eyebrow::before {
    content: "";
    width: 20px;
    height: 2px;
    background: var(--usl-accent);
  }
  .usl-title {
    font-family: var(--usl-font-head);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }
  .usl-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--usl-muted);
    line-height: 1.6;
    margin: 0;
  }
  .usl-reserve-btn {
    background: var(--usl-text);
    color: var(--usl-bg);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.9rem 1.85rem;
    border-radius: 100px;
    border: none;
    cursor: pointer;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .usl-reserve-btn:hover {
    background: var(--usl-accent);
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* Region Filter Tabs */
  .usl-filter-bar {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scrollbar-width: none;
  }
  .usl-filter-bar::-webkit-scrollbar { display: none; }
  .usl-tab-btn {
    background: var(--usl-card-bg);
    color: var(--usl-muted);
    border: 1px solid var(--usl-border);
    font-family: var(--usl-font-head);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.75rem 1.5rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .usl-tab-btn[aria-selected="true"] {
    background: var(--usl-text);
    color: var(--usl-bg);
    border-color: var(--usl-text);
  }
  .usl-tab-btn:hover:not([aria-selected="true"]) {
    color: var(--usl-text);
    border-color: color-mix(in srgb, var(--usl-text) 35%, transparent);
  }

  /* Main Split Content Area */
  .usl-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  @media (min-width: 1024px) {
    .usl-grid {
      grid-template-columns: 1fr 1.1fr;
    }
  }

  /* Showroom Cards List */
  .usl-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-height: 640px;
    overflow-y: auto;
    padding-right: 0.5rem;
  }
  .usl-card {
    background: var(--usl-card-bg);
    border: 1px solid var(--usl-border);
    border-radius: 28px;
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .usl-card:hover {
    border-color: color-mix(in srgb, var(--usl-text) 45%, transparent);
    transform: translateX(6px);
  }
  .usl-card[data-hidden="true"] { display: none; }

  .usl-card-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .usl-store-name { font-family: var(--usl-font-head); font-size: 1.35rem; font-weight: 700; margin: 0; color: #ffffff; }
  .usl-store-city { font-size: 0.82rem; color: var(--usl-muted); text-transform: uppercase; letter-spacing: 0.1em; }

  .usl-status-badge {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(52, 211, 153, 0.3);
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .usl-status-badge::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #34d399;
  }

  .usl-card-body {
    font-size: 0.95rem;
    color: var(--usl-muted);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .usl-card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--usl-text) 8%, transparent);
  }
  .usl-book-btn {
    background: transparent;
    color: var(--usl-text);
    border: 1px solid var(--usl-border);
    font-weight: 700;
    font-size: 0.82rem;
    padding: 0.6rem 1.2rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .usl-book-btn:hover {
    background: var(--usl-text);
    color: var(--usl-bg);
  }

  /* Map Visualizer Area */
  .usl-map-box {
    background: #121212;
    border: 1px solid var(--usl-border);
    border-radius: 36px;
    overflow: hidden;
    min-height: 500px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 25px 50px -15px rgba(0, 0, 0, 0.7);
  }
  .usl-map-img { width: 100%; height: 100%; object-fit: cover; opacity: 0.75; }
  .usl-map-pin {
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--usl-accent);
    border: 3px solid #ffffff;
    box-shadow: 0 0 20px var(--usl-accent);
    animation: usl-pulse 2s infinite;
  }
  @keyframes usl-pulse {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.7; }
    100% { transform: scale(1); opacity: 1; }
  }

  /* Appointment Booking Lightbox Modal */
  .usl-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .usl-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .usl-modal {
    background: var(--usl-card-bg);
    color: var(--usl-text);
    border: 1px solid var(--usl-border);
    border-radius: 36px;
    max-width: 600px;
    width: 100%;
    padding: clamp(2.5rem, 6vw, 3.5rem);
    position: relative;
    box-shadow: 0 40px 80px -15px rgba(0, 0, 0, 0.9);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transform: scale(0.95);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .usl-modal-overlay[data-open="true"] .usl-modal {
    transform: scale(1);
  }
  .usl-modal-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: color-mix(in srgb, var(--usl-text) 10%, transparent);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--usl-text);
    cursor: pointer;
  }
  .usl-input {
    width: 100%;
    background: color-mix(in srgb, var(--usl-text) 4%, transparent);
    border: 1px solid var(--usl-border);
    color: var(--usl-text);
    padding: 1rem 1.25rem;
    border-radius: 16px;
    font-size: 0.95rem;
    outline: none;
    font-family: var(--usl-font-body);
  }
  .usl-input:focus { border-color: var(--usl-accent); }
</style>

<section class="usl-section" id="usl-section-{{ section.id }}" aria-labelledby="usl-title-{{ section.id }}">
  <div class="usl-container">
    
    <!-- Section Header -->
    <div class="usl-header">
      <div class="usl-head-text">
        {%- if section.settings.eyebrow != blank -%}
          <div class="usl-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="usl-title-{{ section.id }}" class="usl-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="usl-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      <button type="button" class="usl-reserve-btn" id="usl-reserve-btn-{{ section.id }}" data-location="Global Concierge">
        <span>Book Private Testing Session</span>
        <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.5;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
      </button>
    </div>

    <!-- Region Filter Bar -->
    <div class="usl-filter-bar" role="tablist" aria-label="Showroom regions">
      <button type="button" class="usl-tab-btn" role="tab" aria-selected="true" data-reg="all">All Showrooms</button>
      <button type="button" class="usl-tab-btn" role="tab" aria-selected="false" data-reg="europe">Europe (Zürich / London)</button>
      <button type="button" class="usl-tab-btn" role="tab" aria-selected="false" data-reg="asia">Asia (Tokyo / Seoul)</button>
      <button type="button" class="usl-tab-btn" role="tab" aria-selected="false" data-reg="americas">Americas (New York / SF)</button>
    </div>

    <!-- Split Content -->
    <div class="usl-grid">
      
      <!-- Showroom List -->
      <div class="usl-list" role="list">
        {%- for block in section.blocks -%}
          <div class="usl-card" role="listitem" data-reg="{{ block.settings.region | default: 'europe' }}" data-store="{{ block.settings.store_name | default: 'Zürich Flagship Atelier' }}" {{ block.shopify_attributes }}>
            
            <div class="usl-card-head">
              <div>
                <span class="usl-store-city">{{ block.settings.city | default: 'Zürich, Switzerland' }}</span>
                <h3 class="usl-store-name">{{ block.settings.store_name | default: 'Zürich Flagship Atelier' }}</h3>
              </div>
              <span class="usl-status-badge">{{ block.settings.status | default: 'OPEN • UNTIL 19:00' }}</span>
            </div>

            <div class="usl-card-body">
              <span>📍 {{ block.settings.address | default: 'Bahnhofstrasse 42, 8001 Zürich' }}</span>
              <span>📞 {{ block.settings.phone | default: '+41 44 211 00 00' }}</span>
              <span style="font-size:0.85rem;color:rgba(255,255,255,0.5);">Acoustic testing booths equipped with full Series 04 lineup.</span>
            </div>

            <div class="usl-card-foot">
              <span style="font-size:0.8rem;color:var(--usl-accent);font-weight:700;">1-on-1 Sessions Available</span>
              <button type="button" class="usl-book-btn" data-loc="{{ block.settings.store_name | default: 'Zürich Flagship Atelier' }}">Reserve Session →</button>
            </div>

          </div>
        {%- endfor -%}
      </div>

      <!-- Map Visualizer Box -->
      <div class="usl-map-box" aria-label="Global Showroom Map">
        {%- if section.settings.map_image != blank -%}
          {{ section.settings.map_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'usl-map-img', alt: 'Showroom map' }}
        {%- else -%}
          <div style="width:100%;height:100%;background:radial-gradient(circle at 50% 50%, #1e293b 0%, #0a0a0a 100%);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#64748b;gap:1rem;">
            <svg viewBox="0 0 24 24" style="width:48px;height:48px;stroke:currentColor;fill:none;stroke-width:1.5;"><circle cx="12" cy="10" r="3"></circle><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path></svg>
            <span style="font-weight:700;font-size:1.1rem;letter-spacing:0.1em;text-transform:uppercase;">Global Atelier Telemetry Map</span>
          </div>
        {%- endif -%}

        <!-- Interactive Map Pins -->
        <div class="usl-map-pin" style="top:38%;left:49%;" title="Zürich Flagship Atelier"></div>
        <div class="usl-map-pin" style="top:42%;left:82%;" title="Tokyo Ginza Showroom"></div>
        <div class="usl-map-pin" style="top:40%;left:26%;" title="New York SoHo Gallery"></div>
      </div>

    </div>

  </div>

  <!-- Appointment Booking Lightbox Modal -->
  <div class="usl-modal-overlay" id="usl-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="usl-modal">
      <button type="button" class="usl-modal-close" id="usl-modal-close-{{ section.id }}" aria-label="Close showroom appointment modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div style="display:flex;align-items:center;gap:0.6rem;">
        <span style="width:10px;height:10px;border-radius:50%;background:var(--usl-accent);"></span>
        <span style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.18em;color:var(--usl-accent);">Private Acoustic Session</span>
      </div>

      <h3 style="font-family:var(--usl-font-head);font-size:1.85rem;margin:0;line-height:1.2;">Showroom Reservation</h3>
      
      <p style="font-size:0.95rem;color:var(--usl-muted);line-height:1.6;margin:0;">Experience our full unibody aluminum lineup in a dedicated acoustic isolation chamber. Complimentary ergonomic analysis included.</p>

      <form onsubmit="event.preventDefault(); alert('Session reserved at ' + document.getElementById('usl-modal-loc').value + '. Confirmation itinerary dispatched via email.'); document.getElementById('usl-modal-close-{{ section.id }}').click();" style="display:flex;flex-direction:column;gap:1rem;">
        <div>
          <label style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--usl-text);display:block;margin-bottom:0.4rem;">Selected Showroom Location</label>
          <input type="text" id="usl-modal-loc" class="usl-input" value="Zürich Flagship Atelier" readonly style="font-weight:700;color:var(--usl-accent);">
        </div>
        <div>
          <label style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--usl-text);display:block;margin-bottom:0.4rem;">Preferred Date & Time</label>
          <input type="date" class="usl-input" required>
        </div>
        <div>
          <label style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--usl-text);display:block;margin-bottom:0.4rem;">Client Professional Email</label>
          <input type="email" class="usl-input" placeholder="client@studio.com" required>
        </div>
        
        <button type="submit" style="background:var(--usl-text);color:var(--usl-bg);font-weight:700;font-size:0.95rem;padding:1.1rem;border-radius:100px;border:none;cursor:pointer;margin-top:0.5rem;transition:all 0.2s ease;">Confirm Private Reservation →</button>
      </form>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('usl-section-' + sid);
    if (!sectionEl) return;

    // Region Filter Controller
    var tabBtns = sectionEl.querySelectorAll('.usl-tab-btn');
    var cards = sectionEl.querySelectorAll('.usl-card');

    tabBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        tabBtns.forEach(function(b) { b.setAttribute('aria-selected', 'false'); });
        btn.setAttribute('aria-selected', 'true');

        var reg = btn.getAttribute('data-reg');
        cards.forEach(function(card) {
          var cardReg = card.getAttribute('data-reg');
          if (reg === 'all' || cardReg === reg) {
            card.setAttribute('data-hidden', 'false');
          } else {
            card.setAttribute('data-hidden', 'true');
          }
        });
      });
    });

    // Appointment Booking Modal Controller
    var modalOverlay = document.getElementById('usl-modal-' + sid);
    var modalClose = document.getElementById('usl-modal-close-' + sid);
    var locInput = document.getElementById('usl-modal-loc');

    if (modalOverlay && modalClose) {
      var bookBtns = sectionEl.querySelectorAll('.usl-book-btn, .usl-reserve-btn');
      bookBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var loc = btn.getAttribute('data-loc') || btn.getAttribute('data-location') || 'Zürich Flagship Atelier';
          if (locInput) locInput.value = loc;

          modalOverlay.setAttribute('data-open', 'true');
          modalOverlay.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Showroom Dealer Locator",
  "tag": "section",
  "class": "section-util-store-locator-map",
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#38bdf8"
    },
    {
      "type": "header",
      "content": "Section Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Global Flagship Showrooms"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Experience Centers & Ateliers"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Test our complete unibody aluminum workstation lineup in private sound-isolated acoustic chambers across major global design capitals."
    },
    {
      "type": "image_picker",
      "id": "map_image",
      "label": "Custom Map Graphic"
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Showroom Location",
      "settings": [
        {
          "type": "select",
          "id": "region",
          "label": "Region",
          "options": [
            { "value": "europe", "label": "Europe" },
            { "value": "asia", "label": "Asia" },
            { "value": "americas", "label": "Americas" }
          ],
          "default": "europe"
        },
        {
          "type": "text",
          "id": "city",
          "label": "City & Country",
          "default": "Zürich, Switzerland"
        },
        {
          "type": "text",
          "id": "store_name",
          "label": "Showroom Name",
          "default": "Zürich Flagship Atelier"
        },
        {
          "type": "text",
          "id": "status",
          "label": "Operating Status",
          "default": "OPEN • UNTIL 19:00"
        },
        {
          "type": "text",
          "id": "address",
          "label": "Street Address",
          "default": "Bahnhofstrasse 42, 8001 Zürich"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Direct Phone",
          "default": "+41 44 211 00 00"
        }
