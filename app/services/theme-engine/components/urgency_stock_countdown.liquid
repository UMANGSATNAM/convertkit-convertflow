{%- comment -%}
  urgency_stock_countdown.liquid — Stock Scarcity & Countdown Bar
  
  DESIGN PHILOSOPHY:
  High-conversion stock inventory counter with visual progress bar.
  Creates FOMO without feeling spammy. Dynamic color shifting
  when stock falls below critical thresholds.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --usc-bg: var(--color-surface, #fef2f2);
    --usc-text: var(--color-text, #991b1b);
    --usc-accent: var(--color-accent, #ef4444);
    --usc-bar-bg: color-mix(in srgb, var(--usc-accent) 20%, transparent);
    --usc-font: var(--font-body, 'Inter', -apple-system, sans-serif);
  }

  .usc-box {
    background: var(--usc-bg);
    border: 1px solid color-mix(in srgb, var(--usc-accent) 30%, transparent);
    border-radius: var(--radius-card, 8px);
    padding: 0.85rem 1rem;
    margin: 1rem 0;
    font-family: var(--usc-font);
  }

  .usc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--usc-text);
  }

  .usc-fire {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .usc-fire svg {
    width: 16px;
    height: 16px;
    fill: var(--usc-accent);
    animation: usc-pulse 1.5s ease-in-out infinite alternate;
  }

  @keyframes usc-pulse {
    0% { transform: scale(1); opacity: 0.85; }
    100% { transform: scale(1.15); opacity: 1; }
  }

  .usc-count {
    color: var(--usc-accent);
    font-weight: 700;
  }

  .usc-progress-wrap {
    width: 100%;
    height: 6px;
    background: var(--usc-bar-bg);
    border-radius: 100px;
    overflow: hidden;
  }
  .usc-progress-bar {
    height: 100%;
    background: var(--usc-accent);
    border-radius: 100px;
    transition: width 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

<div class="usc-box" role="status" aria-live="polite">
  {%- assign stock_left = section.settings.stock_number | default: 7 -%}
  {%- assign total_stock = section.settings.total_stock | default: 50 -%}
  {%- assign percent = stock_left | times: 100 | divided_by: total_stock -%}
  
  <div class="usc-header">
    <span class="usc-fire">
      <svg viewBox="0 0 24 24"><path d="M12 23a7.5 7.5 0 0 1-5.138-12.963C8.204 8.774 11.5 6.5 11 1.5c6 4 9 8 3 14 1 0 2.5-2 2.5-2A7.5 7.5 0 0 1 12 23z"/></svg>
      {{ section.settings.text_before | default: 'Hurry! Only' }}
      <span class="usc-count">{{ stock_left }}</span>
      {{ section.settings.text_after | default: 'left in stock.' }}
    </span>
    {%- if section.settings.show_status -%}
      <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.8;">Selling Fast</span>
    {%- endif -%}
  </div>
  <div class="usc-progress-wrap" aria-hidden="true">
    <div class="usc-progress-bar" style="width: {{ percent }}%;"></div>
  </div>
</div>

{% schema %}
{
  "name": "Stock Countdown Bar",
  "tag": "section",
  "class": "section-urgency-stock",
  "settings": [
    {
      "type": "number",
      "id": "stock_number",
      "label": "Current Stock Level",
      "default": 7
    },
    {
      "type": "number",
      "id": "total_stock",
      "label": "Total Capacity (for progress bar)",
      "default": 50
    },
    {
      "type": "text",
      "id": "text_before",
      "label": "Text Before Number",
      "default": "Hurry! Only"
    },
    {
      "type": "text",
      "id": "text_after",
      "label": "Text After Number",
      "default": "left in stock."
    },
    {
      "type": "checkbox",
      "id": "show_status",
      "label": "Show 'Selling Fast' Badge",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Stock Countdown Bar"
    }
  ]
}
{% endschema %}
