{%- comment -%}
  trust_certifications_list.liquid — Ultra-Comprehensive Compliance & Certifications Showcase
  
  DESIGN PHILOSOPHY:
  An authoritative trust grid designed to showcase regulatory compliance, eco-labels,
  medical/security standards, and official certifications. Features interactive tab filtering
  by category (Eco, Quality, Security, Cruelty-Free), badge glow animations on hover, and
  an accessible inspection modal dialog to view verification license credentials.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --tcl-bg: {{ section.settings.bg_color | default: '#f8fafc' }};
    --tcl-card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --tcl-text: {{ section.settings.text_color | default: '#0f172a' }};
    --tcl-muted: color-mix(in srgb, var(--tcl-text) 60%, transparent);
    --tcl-border: color-mix(in srgb, var(--tcl-text) 12%, transparent);
    --tcl-accent: {{ section.settings.accent_color | default: '#059669' }};
    --tcl-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --tcl-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --tcl-padding-top: clamp(3.5rem, 8vw, 6.5rem);
    --tcl-padding-bottom: clamp(3.5rem, 8vw, 6.5rem);
  }

  .tcl-section {
    background-color: var(--tcl-bg);
    color: var(--tcl-text);
    font-family: var(--tcl-font-body);
    padding: var(--tcl-padding-top) clamp(1.25rem, 4vw, 4rem) var(--tcl-padding-bottom);
    border-top: 1px solid var(--tcl-border);
    border-bottom: 1px solid var(--tcl-border);
    position: relative;
  }

  .tcl-container {
    max-width: 1360px;
    margin: 0 auto;
  }

  /* Section Header */
  .tcl-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(2rem, 5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .tcl-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--tcl-accent);
    background: color-mix(in srgb, var(--tcl-accent) 12%, transparent);
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    border: 1px solid color-mix(in srgb, var(--tcl-accent) 25%, transparent);
  }
  .tcl-title {
    font-family: var(--tcl-font-head);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 700;
    color: var(--tcl-text);
    line-height: 1.15;
    margin: 0;
  }
  .tcl-desc {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    color: var(--tcl-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Category Filter Tabs */
  .tcl-filter-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .tcl-filter-btn {
    background: color-mix(in srgb, var(--tcl-text) 6%, transparent);
    color: var(--tcl-text);
    border: 1px solid var(--tcl-border);
    border-radius: 100px;
    padding: 0.6rem 1.25rem;
    font-family: var(--tcl-font-body);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .tcl-filter-btn:hover {
    background: color-mix(in srgb, var(--tcl-text) 12%, transparent);
  }
  .tcl-filter-btn.active {
    background: var(--tcl-accent);
    color: #ffffff;
    border-color: var(--tcl-accent);
    box-shadow: 0 4px 12px -2px color-mix(in srgb, var(--tcl-accent) 40%, transparent);
  }

  /* Certifications Grid */
  .tcl-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .tcl-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .tcl-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    }
  }

  /* Card Layout */
  .tcl-card {
    background-color: var(--tcl-card-bg);
    border: 1px solid var(--tcl-border);
    border-radius: 20px;
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    position: relative;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease, opacity 0.3s ease;
  }
  .tcl-card[data-hidden="true"] {
    display: none;
  }
  .tcl-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 35px -12px color-mix(in srgb, var(--tcl-text) 12%, transparent);
    border-color: var(--tcl-accent);
  }

  /* Seal / Logo Image */
  .tcl-seal-wrap {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--tcl-accent) 8%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    position: relative;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .tcl-card:hover .tcl-seal-wrap {
    transform: scale(1.1);
  }
  .tcl-seal-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .tcl-verified-icon {
    position: absolute;
    bottom: -2px;
    right: -2px;
    background: var(--tcl-accent);
    color: #ffffff;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--tcl-card-bg);
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  }
  .tcl-verified-icon svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2.5;
  }

  /* Card Typography */
  .tcl-card-title {
    font-family: var(--tcl-font-head);
    font-size: 1.18rem;
    font-weight: 700;
    color: var(--tcl-text);
    margin: 0;
    line-height: 1.3;
  }
  .tcl-card-issuer {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--tcl-accent);
    margin: -0.5rem 0 0;
  }
  .tcl-card-desc {
    font-size: 0.88rem;
    color: var(--tcl-muted);
    line-height: 1.6;
    margin: 0;
  }
  .tcl-verify-btn {
    margin-top: auto;
    background: transparent;
    color: var(--tcl-text);
    border: 1px solid var(--tcl-border);
    border-radius: 100px;
    padding: 0.5rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .tcl-verify-btn:hover {
    background: var(--tcl-accent);
    color: #ffffff;
    border-color: var(--tcl-accent);
  }

  /* Modal Dialog */
  .tcl-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .tcl-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .tcl-modal {
    background: var(--tcl-card-bg);
    color: var(--tcl-text);
    border-radius: 24px;
    max-width: 520px;
    width: 100%;
    padding: 2.5rem 2rem;
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tcl-modal-overlay[data-open="true"] .tcl-modal {
    transform: scale(1);
  }
  .tcl-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: color-mix(in srgb, var(--tcl-text) 8%, transparent);
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--tcl-text);
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .tcl-modal-close:hover {
    background: color-mix(in srgb, var(--tcl-text) 15%, transparent);
  }
  .tcl-modal-seal {
    width: 100px;
    height: 100px;
    object-fit: contain;
    margin-bottom: 0.5rem;
  }
  .tcl-modal-title {
    font-family: var(--tcl-font-head);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
  }
  .tcl-modal-license {
    background: color-mix(in srgb, var(--tcl-accent) 12%, transparent);
    color: var(--tcl-accent);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-family: monospace;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
</style>

<section class="tcl-section" id="tcl-section-{{ section.id }}" aria-labelledby="tcl-title-{{ section.id }}">
  <div class="tcl-container">
    
    {%- if section.settings.title != blank or section.settings.eyebrow != blank -%}
      <div class="tcl-header">
        {%- if section.settings.eyebrow != blank -%}
          <div class="tcl-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="tcl-title-{{ section.id }}" class="tcl-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="tcl-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Category Tabs -->
    {%- if section.settings.show_tabs -%}
      <div class="tcl-filter-bar" id="tcl-filters-{{ section.id }}" role="tablist">
        <button type="button" class="tcl-filter-btn active" data-filter="all" role="tab" aria-selected="true">All Certifications</button>
        <button type="button" class="tcl-filter-btn" data-filter="eco" role="tab" aria-selected="false">Eco & Sustainability</button>
        <button type="button" class="tcl-filter-btn" data-filter="quality" role="tab" aria-selected="false">Quality & Safety</button>
        <button type="button" class="tcl-filter-btn" data-filter="security" role="tab" aria-selected="false">Security & Privacy</button>
      </div>
    {%- endif -%}

    <!-- Certifications Grid -->
    <div class="tcl-grid" id="tcl-grid-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div 
          class="tcl-card" 
          data-category="{{ block.settings.category | default: 'quality' }}" 
          data-title="{{ block.settings.title | escape }}"
          data-issuer="{{ block.settings.issuer | escape }}"
          data-license="{{ block.settings.license_no | default: 'VERIFIED-CERT-2026' | escape }}"
          data-desc="{{ block.settings.text | escape }}"
          data-img="{{ block.settings.image | image_url: width: 300 }}"
          {{ block.shopify_attributes }}
        >
          <div class="tcl-seal-wrap">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'tcl-seal-img', alt: block.settings.title }}
            {%- else -%}
              <svg viewBox="0 0 24 24" style="width:40px;height:40px;stroke:currentColor;fill:none;stroke-width:1.5;"><path d="M12 15l-2 5l9-9l-9 9l2-5"></path><circle cx="12" cy="8" r="6"></circle></svg>
            {%- endif -%}
            <div class="tcl-verified-icon" title="Officially Verified">
              <svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
          </div>

          <h3 class="tcl-card-title">{{ block.settings.title }}</h3>
          {%- if block.settings.issuer != blank -%}
            <span class="tcl-card-issuer">{{ block.settings.issuer }}</span>
          {%- endif -%}
          <p class="tcl-card-desc">{{ block.settings.text }}</p>

          <button type="button" class="tcl-verify-btn" aria-label="Verify certificate {{ block.settings.title }}">
            <span>Verify Certificate</span>
            <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </button>
        </div>
      {%- endfor -%}
    </div>

  </div>

  <!-- Verification Modal -->
  <div class="tcl-modal-overlay" id="tcl-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="tcl-modal-title-val">
    <div class="tcl-modal">
      <button type="button" class="tcl-modal-close" id="tcl-modal-close-{{ section.id }}" aria-label="Close modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <img src="" id="tcl-modal-img" class="tcl-modal-seal" alt="Certificate Seal" style="display:none;">
      <h3 class="tcl-modal-title" id="tcl-modal-title-val">Certificate Verification</h3>
      <span class="tcl-card-issuer" id="tcl-modal-issuer">Issuing Organization</span>
      <div class="tcl-modal-license" id="tcl-modal-license">LICENSE: #VERIFIED-2026</div>
      <p class="tcl-card-desc" id="tcl-modal-desc">This document certifies full compliance with rigorous global industry testing protocols and quality verification standards.</p>
      <div style="font-size:0.75rem;color:var(--tcl-accent);margin-top:0.5rem;display:flex;align-items:center;gap:0.3rem;">
        <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.5;"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>Active & Verified by Official Authority</span>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('tcl-section-' + sid);
    if (!sectionEl) return;

    // 1. Tab Filtering Controller
    var filterBar = document.getElementById('tcl-filters-' + sid);
    var grid = document.getElementById('tcl-grid-' + sid);
    if (filterBar && grid) {
      var btns = filterBar.querySelectorAll('.tcl-filter-btn');
      var cards = grid.querySelectorAll('.tcl-card');

      btns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          btns.forEach(function(b) { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');

          var filter = btn.getAttribute('data-filter');
          cards.forEach(function(card) {
            var cat = card.getAttribute('data-category');
            if (filter === 'all' || cat === filter) {
              card.removeAttribute('data-hidden');
            } else {
              card.setAttribute('data-hidden', 'true');
            }
          });
        });
      });
    }

    // 2. Inspection Modal Dialog Controller
    var modalOverlay = document.getElementById('tcl-modal-' + sid);
    var modalClose = document.getElementById('tcl-modal-close-' + sid);
    if (modalOverlay && modalClose) {
      var titleEl = document.getElementById('tcl-modal-title-val');
      var issuerEl = document.getElementById('tcl-modal-issuer');
      var licenseEl = document.getElementById('tcl-modal-license');
      var descEl = document.getElementById('tcl-modal-desc');
      var imgEl = document.getElementById('tcl-modal-img');

      var verifyBtns = sectionEl.querySelectorAll('.tcl-verify-btn');
      verifyBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var card = btn.closest('.tcl-card');
          if (!card) return;

          if (titleEl) titleEl.innerText = card.getAttribute('data-title') || 'Certificate';
          if (issuerEl) issuerEl.innerText = card.getAttribute('data-issuer') || 'Authorized Body';
          if (licenseEl) licenseEl.innerText = 'LICENSE: #' + (card.getAttribute('data-license') || 'VERIFIED');
          if (descEl) descEl.innerText = card.getAttribute('data-desc') || '';
          
          var imgSrc = card.getAttribute('data-img');
          if (imgEl) {
            if (imgSrc && imgSrc !== 'null' && imgSrc !== '') {
              imgEl.src = imgSrc;
              imgEl.style.display = 'block';
            } else {
              imgEl.style.display = 'none';
            }
          }

          modalOverlay.setAttribute('data-open', 'true');
          modalOverlay.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Trust Certifications List",
  "tag": "section",
  "class": "section-trust-certifications",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#059669"
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Compliance & Rigor"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Verified Industry Certifications"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Our products and manufacturing facilities undergo rigorous independent auditing to meet the highest international safety, environmental, and ethical standards."
    },
    {
      "type": "header",
      "content": "Grid & Filtering"
    },
    {
      "type": "checkbox",
      "id": "show_tabs",
      "label": "Show Category Filter Tabs",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "cert",
      "name": "Certification Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Official Certificate Seal / Logo"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Filter Category",
          "options": [
            { "value": "eco", "label": "Eco & Sustainability" },
            { "value": "quality", "label": "Quality & Safety" },
            { "value": "security", "label": "Security & Privacy" }
          ],
          "default": "quality"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Certificate Name",
          "default": "ISO 9001:2015 Certified"
        },
        {
          "type": "text",
          "id": "issuer",
          "label": "Issuing Authority",
          "default": "International Standards Org"
        },
        {
          "type": "text",
          "id": "license_no",
          "label": "License / Certificate ID",
          "default": "ISO-9001-CERT-8842"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Verifies rigorous quality management systems and consistent product excellence across all manufacturing protocols."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Certifications List",
      "blocks": [
        { "type": "cert", "settings": { "category": "quality", "title": "ISO 9001:2015 Quality", "issuer": "Global Standards Body", "license_no": "ISO-9001-8842", "text": "Verifies rigorous quality management systems and consistent product excellence." } },
        { "type": "cert", "settings": { "category": "eco", "title": "100% Carbon Neutral", "issuer": "Climate Action Org", "license_no": "ECO-2026-CN09", "text": "Audited carbon offsetting for our entire production line and shipping logistics." } },
        { "type": "cert", "settings": { "category": "security", "title": "PCI-DSS Level 1 Secure", "issuer": "Security Audit Board", "license_no": "PCI-SEC-L1-441", "text": "Highest tier bank-level encryption and privacy protection for all transactions." } },
        { "type": "cert", "settings": { "category": "eco", "title": "FSC Certified Forestry", "issuer": "Forest Stewardship Council", "license_no": "FSC-C018492", "text": "All paper and packaging materials are harvested from responsibly managed forests." } }
      ]
    }
  ]
}
{% endschema %}
