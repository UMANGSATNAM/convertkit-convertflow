{%- comment -%}
  hero_minimal_1.liquid — Ultra-Comprehensive Swiss Minimalist Architectural Hero
  
  DESIGN PHILOSOPHY:
  An architectural minimalist flagship hero engineered for luxury hardware and design-centric
  brands. Features generous whitespace, refined typography, interactive specification tabs,
  subtle glassmorphism cards, and an accessible Minimalist Design Lightbox Modal Dialog
  outlining materials science and unibody craftsmanship.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --hm-bg: {{ section.settings.bg_color | default: '#fafaf9' }};
    --hm-card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --hm-text: {{ section.settings.text_color | default: '#1c1917' }};
    --hm-muted: color-mix(in srgb, var(--hm-text) 55%, transparent);
    --hm-border: color-mix(in srgb, var(--hm-text) 12%, transparent);
    --hm-accent: {{ section.settings.accent_color | default: '#1c1917' }};
    --hm-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --hm-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --hm-min-height: clamp(640px, 85vh, 920px);
  }

  .hm-section {
    background-color: var(--hm-bg);
    color: var(--hm-text);
    font-family: var(--hm-font-body);
    min-height: var(--hm-min-height);
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--hm-border);
    padding: clamp(4rem, 10vw, 7rem) clamp(1.5rem, 5vw, 5rem);
  }

  .hm-container {
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(3rem, 6vw, 5rem);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hm-container {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  /* Left Copy Area */
  .hm-left {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .hm-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--hm-muted);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .hm-eyebrow::before {
    content: "";
    width: 16px;
    height: 1px;
    background: var(--hm-text);
  }
  .hm-title {
    font-family: var(--hm-font-head);
    font-size: clamp(2.75rem, 6vw, 5rem);
    font-weight: 600;
    line-height: 1.08;
    margin: 0;
    letter-spacing: -0.03em;
    color: var(--hm-text);
  }
  .hm-desc {
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    color: var(--hm-muted);
    line-height: 1.65;
    max-width: 600px;
    margin: 0;
    font-weight: 400;
  }

  /* Buttons */
  .hm-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .hm-btn-primary {
    background: var(--hm-text);
    color: var(--hm-bg);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    padding: 1.1rem 2.4rem;
    border-radius: 100px;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 10px 25px -5px color-mix(in srgb, var(--hm-text) 25%, transparent);
  }
  .hm-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px -5px color-mix(in srgb, var(--hm-text) 35%, transparent);
    opacity: 0.92;
  }
  .hm-btn-sec {
    background: transparent;
    color: var(--hm-text);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 1.1rem 2rem;
    border-radius: 100px;
    border: 1px solid var(--hm-border);
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
  }
  .hm-btn-sec:hover {
    background: var(--hm-card-bg);
    border-color: var(--hm-text);
  }

  /* Right Interactive Specification Tabs Box */
  .hm-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .hm-tabs-card {
    background: var(--hm-card-bg);
    border: 1px solid var(--hm-border);
    border-radius: 32px;
    padding: clamp(2rem, 4vw, 3rem);
    box-shadow: 0 25px 50px -15px color-mix(in srgb, var(--hm-text) 8%, transparent);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Tab Header Buttons */
  .hm-tab-nav {
    display: flex;
    gap: 0.5rem;
    border-bottom: 1px solid var(--hm-border);
    padding-bottom: 1rem;
    overflow-x: auto;
  }
  .hm-tab-btn {
    background: transparent;
    border: none;
    color: var(--hm-muted);
    font-family: var(--hm-font-head);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .hm-tab-btn[aria-selected="true"] {
    background: var(--hm-text);
    color: var(--hm-bg);
  }
  .hm-tab-btn:hover:not([aria-selected="true"]) {
    color: var(--hm-text);
    background: color-mix(in srgb, var(--hm-text) 5%, transparent);
  }

  /* Tab Panel Content */
  .hm-tab-panel {
    display: none;
    flex-direction: column;
    gap: 1.25rem;
    animation: hm-fade 0.3s ease;
  }
  .hm-tab-panel[data-active="true"] {
    display: flex;
  }
  @keyframes hm-fade {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hm-panel-title { font-family: var(--hm-font-head); font-size: 1.5rem; font-weight: 600; margin: 0; color: var(--hm-text); }
  .hm-panel-desc { font-size: 0.95rem; color: var(--hm-muted); line-height: 1.6; margin: 0; }
  
  .hm-stat-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hm-border);
  }
  .hm-stat-item { display: flex; flex-direction: column; gap: 0.2rem; }
  .hm-stat-val { font-family: var(--hm-font-head); font-size: 1.35rem; font-weight: 600; color: var(--hm-text); }
  .hm-stat-lbl { font-size: 0.75rem; color: var(--hm-muted); text-transform: uppercase; letter-spacing: 0.08em; }

  /* Minimalist Design Lightbox Modal */
  .hm-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(28, 25, 23, 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .hm-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .hm-modal {
    background: var(--hm-card-bg);
    color: var(--hm-text);
    border: 1px solid var(--hm-border);
    border-radius: 36px;
    max-width: 680px;
    width: 100%;
    padding: clamp(2.5rem, 6vw, 4rem);
    position: relative;
    box-shadow: 0 40px 80px -15px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transform: scale(0.95);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hm-modal-overlay[data-open="true"] .hm-modal {
    transform: scale(1);
  }
  .hm-modal-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: color-mix(in srgb, var(--hm-text) 8%, transparent);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--hm-text);
    cursor: pointer;
  }
</style>

<section class="hm-section" id="hm-section-{{ section.id }}" aria-labelledby="hm-title-{{ section.id }}">
  <div class="hm-container">
    
    <!-- Left Copy -->
    <div class="hm-left">
      {%- if section.settings.eyebrow != blank -%}
        <div class="hm-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h1 id="hm-title-{{ section.id }}" class="hm-title">{{ section.settings.title }}</h1>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="hm-desc">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      <div class="hm-actions">
        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_link | default: '/collections/all' }}" class="hm-btn-primary">
            <span>{{ section.settings.btn_label }}</span>
            <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.5;"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        {%- endif -%}

        <button type="button" class="hm-btn-sec" id="hm-design-btn-{{ section.id }}">Architectural Audit</button>
      </div>
    </div>

    <!-- Right Interactive Specification Tabs -->
    <div class="hm-right">
      <div class="hm-tabs-card">
        
        <!-- Tab Navigation -->
        <div class="hm-tab-nav" role="tablist" aria-label="Specification categories">
          <button type="button" class="hm-tab-btn" role="tab" aria-selected="true" aria-controls="hm-panel-1-{{ section.id }}" id="hm-tab-1-{{ section.id }}">01. Acoustics</button>
          <button type="button" class="hm-tab-btn" role="tab" aria-selected="false" aria-controls="hm-panel-2-{{ section.id }}" id="hm-tab-2-{{ section.id }}">02. Materials</button>
          <button type="button" class="hm-tab-btn" role="tab" aria-selected="false" aria-controls="hm-panel-3-{{ section.id }}" id="hm-tab-3-{{ section.id }}">03. Geometry</button>
        </div>

        <!-- Tab Panel 1: Acoustics -->
        <div class="hm-tab-panel" id="hm-panel-1-{{ section.id }}" role="tabpanel" aria-labelledby="hm-tab-1-{{ section.id }}" data-active="true">
          <h3 class="hm-panel-title">{{ section.settings.tab_1_title | default: 'Acoustic Dampening Architecture' }}</h3>
          <p class="hm-panel-desc">{{ section.settings.tab_1_desc | default: 'Milled with internal acoustic chambers that isolate high-frequency resonance while preserving deep, tactile tactile feedback.' }}</p>
          
          <div class="hm-stat-row">
            <div class="hm-stat-item">
              <span class="hm-stat-val">&lt; 0.2 ms</span>
              <span class="hm-stat-lbl">Resonance Decay</span>
            </div>
            <div class="hm-stat-item">
              <span class="hm-stat-val">-42 dB</span>
              <span class="hm-stat-lbl">Ambient Isolation</span>
            </div>
          </div>
        </div>

        <!-- Tab Panel 2: Materials -->
        <div class="hm-tab-panel" id="hm-panel-2-{{ section.id }}" role="tabpanel" aria-labelledby="hm-tab-2-{{ section.id }}" data-active="false">
          <h3 class="hm-panel-title">{{ section.settings.tab_2_title | default: 'Aerospace 6063 Aluminum' }}</h3>
          <p class="hm-panel-desc">{{ section.settings.tab_2_desc | default: 'Each unibody chassis requires 4.5 hours of continuous 5-axis CNC machining, followed by bead blasting and sulfuric anodization.' }}</p>
          
          <div class="hm-stat-row">
            <div class="hm-stat-item">
              <span class="hm-stat-val">2,150 g</span>
              <span class="hm-stat-lbl">Chassis Mass</span>
            </div>
            <div class="hm-stat-item">
              <span class="hm-stat-val">15 µm</span>
              <span class="hm-stat-lbl">Anodic Coating</span>
            </div>
          </div>
        </div>

        <!-- Tab Panel 3: Geometry -->
        <div class="hm-tab-panel" id="hm-panel-3-{{ section.id }}" role="tabpanel" aria-labelledby="hm-tab-3-{{ section.id }}" data-active="false">
          <h3 class="hm-panel-title">{{ section.settings.tab_3_title | default: 'Ergonomic 6.5° Incline' }}</h3>
          <p class="hm-panel-desc">{{ section.settings.tab_3_desc | default: 'Fixed angle geometry designed in collaboration with Swiss orthopedic ergonomics researchers to eliminate wrist extension stress.' }}</p>
          
          <div class="hm-stat-row">
            <div class="hm-stat-item">
              <span class="hm-stat-val">6.5° Fixed</span>
              <span class="hm-stat-lbl">Optimal Incline</span>
            </div>
            <div class="hm-stat-item">
              <span class="hm-stat-val">18 mm</span>
              <span class="hm-stat-lbl">Front Lip Height</span>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- Minimalist Design Lightbox Modal -->
  <div class="hm-modal-overlay" id="hm-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="hm-modal">
      <button type="button" class="hm-modal-close" id="hm-modal-close-{{ section.id }}" aria-label="Close design audit modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div style="display:flex;align-items:center;gap:0.75rem;">
        <span style="width:8px;height:8px;border-radius:50%;background:var(--hm-text);"></span>
        <span style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.2em;color:var(--hm-muted);">Architectural Audit Report</span>
      </div>

      <h3 style="font-family:var(--hm-font-head);font-size:2rem;margin:0;line-height:1.15;">The Philosophy of Less</h3>
      
      <p style="font-size:1rem;line-height:1.65;color:var(--hm-muted);margin:0;">True design perfection is achieved not when there is nothing left to add, but when there is nothing left to take away. We eliminate external screws, branding badges, and plastic seams.</p>

      <div style="background:color-mix(in srgb,var(--hm-text) 4%,transparent);border:1px solid var(--hm-border);border-radius:20px;padding:1.5rem;display:flex;flex-direction:column;gap:0.75rem;">
        <strong style="font-size:1rem;color:var(--hm-text);font-family:var(--hm-font-head);">Zürich Atelier Quality Standards:</strong>
        <span style="font-size:0.88rem;color:var(--hm-muted);">• Zero visible exterior screws or fasteners</span>
        <span style="font-size:0.88rem;color:var(--hm-muted);">• Sub-micron color matching across all aluminum parts</span>
        <span style="font-size:0.88rem;color:var(--hm-muted);">• Individual serial engraving recorded in Swiss archives</span>
      </div>

      <button type="button" class="hm-btn-primary" style="justify-content:center;width:100%;cursor:pointer;border:none;margin-top:0.5rem;" onclick="document.getElementById('hm-modal-close-{{ section.id }}').click();">Return to Collection</button>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('hm-section-' + sid);
    if (!sectionEl) return;

    // Interactive Tab Controller
    var tabBtns = sectionEl.querySelectorAll('.hm-tab-btn');
    var tabPanels = sectionEl.querySelectorAll('.hm-tab-panel');

    tabBtns.forEach(function(btn, idx) {
      btn.addEventListener('click', function() {
        tabBtns.forEach(function(b) { b.setAttribute('aria-selected', 'false'); });
        tabPanels.forEach(function(p) { p.setAttribute('data-active', 'false'); });

        btn.setAttribute('aria-selected', 'true');
        var targetPanel = sectionEl.querySelector('#hm-panel-' + (idx + 1) + '-' + sid);
        if (targetPanel) targetPanel.setAttribute('data-active', 'true');
      });
    });

    // Design Audit Modal Controller
    var modalOverlay = document.getElementById('hm-modal-' + sid);
    var modalClose = document.getElementById('hm-modal-close-' + sid);
    var designBtn = document.getElementById('hm-design-btn-' + sid);

    if (modalOverlay && modalClose && designBtn) {
      designBtn.addEventListener('click', function() {
        modalOverlay.setAttribute('data-open', 'true');
        modalOverlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

