{%- comment -%}
  hero_bold_1.liquid — Ultra-Comprehensive Bold Industrial Brutalist Hero
  
  DESIGN PHILOSOPHY:
  An architectural high-contrast flagship hero engineered to make an immediate, authoritative
  visual statement. Features massive brutalist typography, continuous bottom ticker marquee strips,
  floating technical specification badges, and an accessible Engineering Manifesto Lightbox
  Modal Dialog outlining unibody aluminum design principles.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --hb-bg: {{ section.settings.bg_color | default: '#000000' }};
    --hb-text: {{ section.settings.text_color | default: '#ffffff' }};
    --hb-muted: color-mix(in srgb, var(--hb-text) 65%, transparent);
    --hb-border: color-mix(in srgb, var(--hb-text) 22%, transparent);
    --hb-accent: {{ section.settings.accent_color | default: '#e11d48' }};
    --hb-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --hb-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --hb-min-height: clamp(680px, 88vh, 980px);
  }

  .hb-section {
    background-color: var(--hb-bg);
    color: var(--hb-text);
    font-family: var(--hb-font-body);
    min-height: var(--hb-min-height);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    border-bottom: 2px solid var(--hb-border);
  }

  /* Background Grid Pattern */
  .hb-grid-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-size: 60px 60px;
    background-image: 
      linear-gradient(to right, color-mix(in srgb, var(--hb-text) 8%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--hb-text) 8%, transparent) 1px, transparent 1px);
    pointer-events: none;
  }

  /* Main Content Area */
  .hb-container {
    max-width: 1400px;
    width: 100%;
    margin: auto 0;
    padding: clamp(4rem, 10vw, 7rem) clamp(1.5rem, 4vw, 4rem);
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hb-container {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  /* Left Brutalist Copy */
  .hb-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .hb-eyebrow {
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--hb-accent);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .hb-eyebrow::before {
    content: "";
    width: 24px;
    height: 3px;
    background: var(--hb-accent);
  }
  .hb-title {
    font-family: var(--hb-font-head);
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 800;
    line-height: 0.98;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.03em;
  }
  .hb-desc {
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    color: var(--hb-muted);
    line-height: 1.6;
    max-width: 640px;
    margin: 0;
  }

  /* Action Buttons */
  .hb-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }
  .hb-btn-primary {
    background: var(--hb-accent);
    color: #ffffff;
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 1.25rem 2.75rem;
    border-radius: 4px;
    transition: all 0.25s ease;
    box-shadow: 0 20px 40px -10px color-mix(in srgb, var(--hb-accent) 50%, transparent);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .hb-btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 25px 50px -5px color-mix(in srgb, var(--hb-accent) 70%, transparent);
    background: #f43f5e;
  }
  .hb-btn-manifesto {
    background: transparent;
    color: var(--hb-text);
    font-weight: 700;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 1.25rem 2.25rem;
    border-radius: 4px;
    border: 2px solid var(--hb-border);
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
  }
  .hb-btn-manifesto:hover {
    background: var(--hb-text);
    color: var(--hb-bg);
    border-color: var(--hb-text);
  }

  /* Right Floating Specification Box */
  .hb-right {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .hb-spec-card {
    background: #121212;
    border: 2px solid var(--hb-border);
    border-radius: 20px;
    padding: clamp(2rem, 4vw, 3rem);
    width: 100%;
    max-width: 440px;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.9);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
  }
  .hb-spec-card::before {
    content: "SERIES 04 SPECS";
    position: absolute;
    top: -12px;
    left: 2rem;
    background: var(--hb-bg);
    color: var(--hb-accent);
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0 0.75rem;
    letter-spacing: 0.2em;
  }
  .hb-spec-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed var(--hb-border);
    padding-bottom: 1rem;
  }
  .hb-spec-row:last-child { border-bottom: none; padding-bottom: 0; }
  .hb-spec-lbl { font-size: 0.82rem; color: var(--hb-muted); text-transform: uppercase; letter-spacing: 0.1em; }
  .hb-spec-val { font-family: var(--hb-font-head); font-size: 1.15rem; font-weight: 800; color: var(--hb-text); }

  /* Bottom Continuous Marquee Ticker */
  .hb-marquee {
    position: relative;
    z-index: 10;
    background: var(--hb-accent);
    color: #ffffff;
    font-family: var(--hb-font-head);
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    padding: 1rem 0;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
  }
  .hb-track {
    display: flex;
    animation: hb-scroll 25s linear infinite;
  }
  @keyframes hb-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .hb-item {
    padding: 0 2rem;
    display: inline-flex;
    align-items: center;
    gap: 2rem;
  }
  .hb-item::after {
    content: "///";
    opacity: 0.5;
  }

  /* Engineering Manifesto Lightbox Modal */
  .hb-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .hb-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .hb-modal {
    background: #0a0a0a;
    color: #ffffff;
    border: 2px solid var(--hb-accent);
    border-radius: 12px;
    max-width: 680px;
    width: 100%;
    padding: clamp(2.5rem, 6vw, 4rem);
    position: relative;
    box-shadow: 0 40px 80px -15px rgba(0, 0, 0, 0.9);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transform: scale(0.95);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hb-modal-overlay[data-open="true"] .hb-modal {
    transform: scale(1);
  }
  .hb-modal-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
  }
</style>

<section class="hb-section" id="hb-section-{{ section.id }}" aria-labelledby="hb-title-{{ section.id }}">
  <div class="hb-grid-bg"></div>

  <div class="hb-container">
    
    <!-- Left Copy -->
    <div class="hb-left">
      {%- if section.settings.eyebrow != blank -%}
        <div class="hb-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h1 id="hb-title-{{ section.id }}" class="hb-title">{{ section.settings.title }}</h1>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="hb-desc">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      <div class="hb-actions">
        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_link | default: '/collections/all' }}" class="hb-btn-primary">
            <span>{{ section.settings.btn_label }}</span>
            <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2.5;"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        {%- endif -%}

        <button type="button" class="hb-btn-manifesto" id="hb-manifesto-btn-{{ section.id }}">Read Manifesto</button>
      </div>
    </div>

    <!-- Right Floating Specs Card -->
    <div class="hb-right">
      <div class="hb-spec-card">
        <div class="hb-spec-row">
          <span class="hb-spec-lbl">Chassis Mass</span>
          <span class="hb-spec-val">{{ section.settings.spec_1 | default: '2,150 g' }}</span>
        </div>
        <div class="hb-spec-row">
          <span class="hb-spec-lbl">Typing Angle</span>
          <span class="hb-spec-val">{{ section.settings.spec_2 | default: '6.5° Fixed' }}</span>
        </div>
        <div class="hb-spec-row">
          <span class="hb-spec-lbl">Mounting System</span>
          <span class="hb-spec-val">{{ section.settings.spec_3 | default: 'Silicone Gasket' }}</span>
        </div>
        <div class="hb-spec-row">
          <span class="hb-spec-lbl">Acoustic Resonance</span>
          <span class="hb-spec-val" style="color:var(--hb-accent);">Zero / Sub-0.2ms</span>
        </div>
      </div>
    </div>

  </div>

  <!-- Bottom Marquee Ticker -->
  <div class="hb-marquee" role="marquee">
    <div class="hb-track">
      <span class="hb-item">{{ section.settings.marquee_text | default: 'UNCOMPROMISING SWISS PRECISION /// ZERO ACOUSTIC RATTLE /// AEROSPACE ALUMINUM CHASSIS /// 6.5° ERGONOMIC INCLINE /// LIFETIME ARCHIVE REGISTRY' }}</span>
      <span class="hb-item">{{ section.settings.marquee_text | default: 'UNCOMPROMISING SWISS PRECISION /// ZERO ACOUSTIC RATTLE /// AEROSPACE ALUMINUM CHASSIS /// 6.5° ERGONOMIC INCLINE /// LIFETIME ARCHIVE REGISTRY' }}</span>
    </div>
  </div>

  <!-- Engineering Manifesto Lightbox Modal -->
  <div class="hb-modal-overlay" id="hb-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="hb-modal">
      <button type="button" class="hb-modal-close" id="hb-modal-close-{{ section.id }}" aria-label="Close engineering manifesto modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div style="display:flex;align-items:center;gap:0.75rem;">
        <span style="width:10px;height:10px;background:var(--hb-accent);"></span>
        <span style="font-size:0.75rem;font-weight:800;text-transform:uppercase;letter-spacing:0.2em;color:rgba(255,255,255,0.7);">The Obsidian Manifesto</span>
      </div>

      <h3 style="font-family:var(--hb-font-head);font-size:2.25rem;margin:0;text-transform:uppercase;line-height:1.05;">Why Plastic Instruments Fail</h3>
      
      <p style="font-size:1rem;line-height:1.65;color:rgba(255,255,255,0.8);margin:0;">The modern workspace has been compromised by lightweight, hollow plastic input devices that flex, vibrate, and induce auditory fatigue. We reject disposable manufacturing.</p>

      <div style="border-left:4px solid var(--hb-accent);padding-left:1.5rem;display:flex;flex-direction:column;gap:0.5rem;">
        <strong style="font-size:1.1rem;color:#ffffff;text-transform:uppercase;font-family:var(--hb-font-head);">The 3 Unbreakable Axioms:</strong>
        <span style="font-size:0.9rem;color:rgba(255,255,255,0.7);">1. Mass eliminates vibration. Unibody aluminum is the only acceptable chassis material.</span>
        <span style="font-size:0.9rem;color:rgba(255,255,255,0.7);">2. Angles must be permanent. Fold-out plastic feet introduce structural weakness and instability.</span>
        <span style="font-size:0.9rem;color:rgba(255,255,255,0.7);">3. Every instrument must be serialized and supported for life by the Zürich Atelier.</span>
      </div>

      <button type="button" class="hb-btn-primary" style="justify-content:center;width:100%;cursor:pointer;border:none;margin-top:0.5rem;" onclick="document.getElementById('hb-modal-close-{{ section.id }}').click();">I Accept The Manifesto →</button>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('hb-section-' + sid);
    if (!sectionEl) return;

    // Manifesto Modal Controller
    var modalOverlay = document.getElementById('hb-modal-' + sid);
    var modalClose = document.getElementById('hb-modal-close-' + sid);
    var manifestoBtn = document.getElementById('hb-manifesto-btn-' + sid);

    if (modalOverlay && modalClose && manifestoBtn) {
      manifestoBtn.addEventListener('click', function() {
        modalOverlay.setAttribute('data-open', 'true');
        modalOverlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Bold Brutalist Hero",
  "tag": "section",
  "class": "section-hero-bold-1",
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Brutalist Accent (Crimson)",
      "default": "#e11d48"
    },
    {
      "type": "header",
      "content": "Hero Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Industrial Brutalist Architecture"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Heading",
      "default": "Uncompromised Mechanical Precision"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "CNC milled from 2,150g of aerospace aluminum in Zürich. Zero plastic. Zero acoustic rattle. Built to outlast your professional career."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Primary CTA Label",
      "default": "Acquire Series 04"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Primary CTA Link"
    },
    {
      "type": "header",
      "content": "Specification Box & Marquee"
    },
    {
      "type": "text",
      "id": "spec_1",
      "label": "Chassis Mass Spec",
      "default": "2,150 g"
    },
    {
      "type": "text",
      "id": "spec_2",
      "label": "Typing Angle Spec",
      "default": "6.5° Fixed"
    },
    {
      "type": "text",
      "id": "spec_3",
      "label": "Mounting Spec",
      "default": "Silicone Gasket"
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Bottom Marquee Strip Text",
      "default": "UNCOMPROMISING SWISS PRECISION /// ZERO ACOUSTIC RATTLE /// AEROSPACE ALUMINUM CHASSIS /// 6.5° ERGONOMIC INCLINE /// LIFETIME ARCHIVE REGISTRY"
    }
  ],
  "presets": [
    {
      "name": "Bold Brutalist Hero"
    }
  ]
}
{% endschema %}
