{%- comment -%}
  story_timeline_vertical.liquid — Ultra-Comprehensive Chronological Heritage Timeline
  
  DESIGN PHILOSOPHY:
  An architectural brand evolution showcase engineered for deep storytelling prestige.
  Features an alternating vertical history spine with scroll-animated milestone node activation,
  interactive achievement stat callouts, and an accessible Milestone Inspection Modal Dialog
  to explore archival photography and technical patents. Engineered for 60fps responsiveness.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --stv-bg: {{ section.settings.bg_color | default: '#0f172a' }};
    --stv-card-bg: {{ section.settings.card_bg_color | default: '#1e293b' }};
    --stv-text: {{ section.settings.text_color | default: '#f8fafc' }};
    --stv-muted: color-mix(in srgb, var(--stv-text) 65%, transparent);
    --stv-border: color-mix(in srgb, var(--stv-text) 14%, transparent);
    --stv-accent: {{ section.settings.accent_color | default: '#38bdf8' }};
    --stv-line: {{ section.settings.line_color | default: '#334155' }};
    --stv-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --stv-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --stv-padding-top: clamp(4rem, 8vw, 7rem);
    --stv-padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .stv-section {
    background-color: var(--stv-bg);
    color: var(--stv-text);
    font-family: var(--stv-font-body);
    padding: var(--stv-padding-top) clamp(1.25rem, 4vw, 4rem) var(--stv-padding-bottom);
    border-top: 1px solid var(--stv-border);
    border-bottom: 1px solid var(--stv-border);
    position: relative;
    overflow: hidden;
  }

  .stv-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Section Header */
  .stv-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto clamp(3rem, 6vw, 5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .stv-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--stv-accent);
    background: color-mix(in srgb, var(--stv-accent) 12%, transparent);
    padding: 0.4rem 1rem;
    border-radius: 100px;
    border: 1px solid color-mix(in srgb, var(--stv-accent) 30%, transparent);
  }
  .stv-title {
    font-family: var(--stv-font-head);
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 700;
    color: var(--stv-text);
    line-height: 1.15;
    margin: 0;
  }
  .stv-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--stv-muted);
    line-height: 1.65;
    margin: 0;
  }

  /* Timeline Spine Layout */
  .stv-timeline {
    position: relative;
    padding: 2rem 0;
  }
  /* Central Vertical Line */
  .stv-timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 20px;
    width: 3px;
    background: var(--stv-line);
    border-radius: 3px;
  }
  @media (min-width: 768px) {
    .stv-timeline::before {
      left: 50%;
      transform: translateX(-50%);
    }
  }

  /* Milestone Row */
  .stv-item {
    position: relative;
    margin-bottom: clamp(3rem, 6vw, 5rem);
    display: flex;
    flex-direction: column;
    padding-left: 54px;
  }
  @media (min-width: 768px) {
    .stv-item {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-left: 0;
    }
    .stv-item:nth-child(even) {
      flex-direction: row-reverse;
    }
  }
  .stv-item:last-child {
    margin-bottom: 0;
  }

  /* Node Marker Dot */
  .stv-node {
    position: absolute;
    top: 1.5rem;
    left: 8px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--stv-bg);
    border: 4px solid var(--stv-accent);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--stv-accent) 25%, transparent);
    z-index: 5;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.3s ease;
  }
  @media (min-width: 768px) {
    .stv-node {
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
    }
  }
  .stv-item:hover .stv-node,
  .stv-item[data-active="true"] .stv-node {
    background: var(--stv-accent);
    transform: scale(1.3) translate(0, 0);
  }
  @media (min-width: 768px) {
    .stv-item:hover .stv-node,
    .stv-item[data-active="true"] .stv-node {
      transform: translate(-50%, -50%) scale(1.3);
    }
  }

  /* Milestone Content Card */
  .stv-card {
    background: var(--stv-card-bg);
    border: 1px solid var(--stv-border);
    border-radius: 28px;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    position: relative;
    box-shadow: 0 25px 50px -15px rgba(0, 0, 0, 0.4);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }
  @media (min-width: 768px) {
    .stv-card {
      width: calc(50% - 45px);
    }
  }
  .stv-card:hover {
    transform: translateY(-8px);
    border-color: var(--stv-accent);
    box-shadow: 0 35px 65px -15px rgba(0, 0, 0, 0.6);
  }

  .stv-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .stv-year {
    font-family: var(--stv-font-head);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--stv-accent);
    line-height: 1;
  }
  .stv-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--stv-text);
    background: color-mix(in srgb, var(--stv-text) 10%, transparent);
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
  }

  .stv-card-title {
    font-family: var(--stv-font-head);
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 700;
    margin: 0;
    line-height: 1.25;
    color: var(--stv-text);
  }
  .stv-card-desc {
    font-size: 0.98rem;
    color: var(--stv-muted);
    line-height: 1.65;
    margin: 0;
  }

  /* Optional Archival Photo */
  .stv-media {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    background: #0f172a;
    position: relative;
    border: 1px solid var(--stv-border);
  }
  .stv-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .stv-card:hover .stv-media img {
    transform: scale(1.06);
  }

  /* Stats Counter Bar */
  .stv-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--stv-border);
  }
  .stv-stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .stv-stat-val {
    font-family: var(--stv-font-head);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--stv-text);
  }
  .stv-stat-lbl {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--stv-muted);
  }

  /* Inspection Modal Dialog */
  .stv-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .stv-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .stv-modal {
    background: var(--stv-card-bg);
    color: var(--stv-text);
    border: 1px solid var(--stv-border);
    border-radius: 28px;
    max-width: 760px;
    width: 100%;
    overflow: hidden;
    position: relative;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.7);
    display: grid;
    grid-template-columns: 1fr;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (min-width: 768px) {
    .stv-modal {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .stv-modal-overlay[data-open="true"] .stv-modal {
    transform: scale(1);
  }
  .stv-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(0, 0, 0, 0.5);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
    z-index: 10;
  }
  .stv-modal-media {
    width: 100%;
    height: 100%;
    min-height: 280px;
    background: #0f172a;
    position: relative;
  }
  .stv-modal-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .stv-modal-info {
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .stv-modal-year {
    font-family: var(--stv-font-head);
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--stv-accent);
    line-height: 1;
    margin: 0;
  }
  .stv-modal-title {
    font-family: var(--stv-font-head);
    font-size: 1.65rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.25;
  }
  .stv-modal-desc {
    font-size: 0.95rem;
    color: var(--stv-muted);
    line-height: 1.65;
    margin: 0;
  }
</style>

<section class="stv-section" id="stv-section-{{ section.id }}" aria-labelledby="stv-title-{{ section.id }}">
  <div class="stv-container">
    
    {%- if section.settings.title != blank or section.settings.eyebrow != blank -%}
      <div class="stv-header">
        {%- if section.settings.eyebrow != blank -%}
          <div class="stv-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="stv-title-{{ section.id }}" class="stv-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="stv-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Timeline Spine -->
    <div class="stv-timeline" id="stv-timeline-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="stv-item" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="stv-node" aria-hidden="true"></div>

          <div 
            class="stv-card" 
            data-year="{{ block.settings.year | default: '2020' | escape }}"
            data-tag="{{ block.settings.tag | default: 'Milestone' | escape }}"
            data-title="{{ block.settings.title | escape }}"
            data-desc="{{ block.settings.text | escape }}"
            data-stat1="{{ block.settings.stat1_val | default: '14 Patents' | escape }}"
            data-stat2="{{ block.settings.stat2_val | default: 'Zürich Laboratory' | escape }}"
            data-img="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 }}{% endif %}"
          >
            <div class="stv-card-header">
              <span class="stv-year">{{ block.settings.year | default: '2020' }}</span>
              <span class="stv-tag">{{ block.settings.tag | default: 'Chapter I' }}</span>
            </div>

            <h3 class="stv-card-title">{{ block.settings.title }}</h3>
            <p class="stv-card-desc">{{ block.settings.text }}</p>

            {%- if block.settings.image != blank -%}
              <div class="stv-media">
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}
              </div>
            {%- endif -%}

            {%- if block.settings.show_stats -%}
              <div class="stv-stats">
                <div class="stv-stat-item">
                  <span class="stv-stat-val">{{ block.settings.stat1_val | default: '14 Patents' }}</span>
                  <span class="stv-stat-lbl">{{ block.settings.stat1_lbl | default: 'Technical IP' }}</span>
                </div>
                <div class="stv-stat-item">
                  <span class="stv-stat-val">{{ block.settings.stat2_val | default: 'Zürich Laboratory' }}</span>
                  <span class="stv-stat-lbl">{{ block.settings.stat2_lbl | default: 'Global Facility' }}</span>
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>

  <!-- Milestone Inspection Modal -->
  <div class="stv-modal-overlay" id="stv-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="stv-modal">
      <button type="button" class="stv-modal-close" id="stv-modal-close-{{ section.id }}" aria-label="Close modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div class="stv-modal-media">
        <img src="" id="stv-modal-img" alt="Archival Preview" style="display:none;">
      </div>

      <div class="stv-modal-info">
        <span class="stv-modal-year" id="stv-modal-year">2020</span>
        <span class="stv-tag" id="stv-modal-tag" style="width:fit-content;background:color-mix(in srgb,var(--stv-accent) 20%,transparent);color:var(--stv-accent);">Milestone</span>
        <h3 class="stv-modal-title" id="stv-modal-title">Milestone Achievement</h3>
        <p class="stv-modal-desc" id="stv-modal-desc">Detailed exploration of our historical development and engineering breakthroughs.</p>
        <div style="margin-top:auto;padding-top:1rem;border-top:1px solid var(--stv-border);font-size:0.85rem;font-weight:700;color:var(--stv-text);">
          <span>✦ Verified Historical Archives | Swiss Registry</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('stv-section-' + sid);
    if (!sectionEl) return;

    // 1. Scroll Active Node Controller
    if ('IntersectionObserver' in window) {
      var items = sectionEl.querySelectorAll('.stv-item');
      var obs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.setAttribute('data-active', 'true');
          } else {
            entry.target.removeAttribute('data-active');
          }
        });
      }, { threshold: 0.4 });
      items.forEach(function(item) { obs.observe(item); });
    }

    // 2. Inspection Modal Controller
    var modalOverlay = document.getElementById('stv-modal-' + sid);
    var modalClose = document.getElementById('stv-modal-close-' + sid);
    if (modalOverlay && modalClose) {
      var yearEl = document.getElementById('stv-modal-year');
      var tagEl = document.getElementById('stv-modal-tag');
      var titleEl = document.getElementById('stv-modal-title');
      var descEl = document.getElementById('stv-modal-desc');
      var imgEl = document.getElementById('stv-modal-img');

      var cards = sectionEl.querySelectorAll('.stv-card');
      cards.forEach(function(card) {
        card.addEventListener('click', function() {
          if (yearEl) yearEl.innerText = card.getAttribute('data-year') || '2020';
          if (tagEl) tagEl.innerText = card.getAttribute('data-tag') || 'Milestone';
          if (titleEl) titleEl.innerText = card.getAttribute('data-title') || 'Historical Breakthrough';
          if (descEl) descEl.innerText = card.getAttribute('data-desc') || '';

          var imgSrc = card.getAttribute('data-img');
          if (imgEl) {
            if (imgSrc && imgSrc !== 'null' && imgSrc !== '') {
              imgEl.src = imgSrc;
              imgEl.style.display = 'block';
            } else {
              imgEl.style.display = 'none';
            }
          }

          modalOverlay.setAttribute('data-open', 'true');
          modalOverlay.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Chronological Heritage",
  "tag": "section",
  "class": "section-story-timeline",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#1e293b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#38bdf8"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Vertical Spine Line Color",
      "default": "#334155"
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Our Evolution"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "A Legacy Of Acoustic Precision"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Trace the chronological milestones that defined our engineering atelier—from our founding in Zürich to our global expansion across three continents."
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "History Milestone",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "Era Year Display",
          "default": "2018"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Milestone Tag",
          "default": "Chapter I"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Milestone Title",
          "default": "The Zürich Atelier Founding"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Narrative Description",
          "default": "Established by two Swiss acoustic engineers with a singular mission: to eliminate acoustic distortion in high-fidelity residential listening environments."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Archival Photography"
        },
        {
          "type": "checkbox",
          "id": "show_stats",
          "label": "Show Achievement Stats",
          "default": true
        },
        {
          "type": "text",
          "id": "stat1_val",
          "label": "Stat 1 Value",
          "default": "3 Original Patents"
        },
        {
          "type": "text",
          "id": "stat1_lbl",
          "label": "Stat 1 Label",
          "default": "Acoustic Damping"
        },
        {
          "type": "text",
          "id": "stat2_val",
          "label": "Stat 2 Value",
          "default": "Zürich, CH"
        },
        {
          "type": "text",
          "id": "stat2_lbl",
          "label": "Stat 2 Label",
          "default": "Atelier Origin"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chronological Heritage",
      "blocks": [
        { "type": "milestone", "settings": { "year": "2018", "tag": "Chapter I", "title": "The Zürich Atelier Founding", "text": "Established by two Swiss acoustic engineers with a singular mission: to eliminate acoustic distortion in high-fidelity residential listening environments." } },
        { "type": "milestone", "settings": { "year": "2021", "tag": "Chapter II", "title": "The Monolith Silhouette Release", "text": "Our flagship workstation debuted to international design acclaim, winning the German Design Award for mechanical ergonomics." } },
        { "type": "milestone", "settings": { "year": "2025", "tag": "Chapter III", "title": "100% Recycled Titanium Sourcing", "text": "Transitioned our entire raw material supply chain to post-consumer aerospace alloy without compromising mechanical tensile strength." } }
