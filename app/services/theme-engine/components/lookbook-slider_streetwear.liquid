<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var slides = section.querySelectorAll('.lb__slide');
    var counterDisp = section.querySelector('[data-lb-counter]');
    var prevBtn = section.querySelector('[data-lb-prev]');
    var nextBtn = section.querySelector('[data-lb-next]');
    var idx = 0;

    function showSlide(n) {
      slides.forEach(function(s) { s.classList.remove('is-active'); });
      idx = (n + slides.length) % slides.length;
      slides[idx].classList.add('is-active');
      if (counterDisp) {
        var num = idx + 1;
        counterDisp.textContent = '[ 0' + num + ' // 0' + slides.length + ' ]';
      }
    }

    if (prevBtn && nextBtn) {
      prevBtn.addEventListener('click', function() { showSlide(idx - 1); });
      nextBtn.addEventListener('click', function() { showSlide(idx + 1); });
    }

    // Hotspot Pin Hover/Click Highlighting
    var pins = section.querySelectorAll('.lb__pin');
    pins.forEach(function(pin) {
      pin.addEventListener('mouseenter', function() {
        var pinId = this.getAttribute('data-pin');
        var targetRow = section.querySelector('[data-row="' + pinId + '"]');
        if (targetRow) {
          targetRow.classList.add('is-highlighted');
          targetRow.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
      pin.addEventListener('mouseleave', function() {
        var pinId = this.getAttribute('data-pin');
        var targetRow = section.querySelector('[data-row="' + pinId + '"]');
        if (targetRow) targetRow.classList.remove('is-highlighted');
      });
      pin.addEventListener('click', function() {
        var title = this.getAttribute('title');
        alert('[ GARMENT FOCUS: ' + title.toUpperCase() + ' ]\n\nHighlighted in the right-hand outfitting panel. Select your size to lock into bundle.');
      });
    });

    // Bundle Buttons
    var addBtns = section.querySelectorAll('[data-add-look]');
    addBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var origText = this.textContent;
        this.textContent = '[ RESERVING OUTFIT ALLOCATION... ]';
        var self = this;
        setTimeout(function() {
          self.textContent = '[ ENTIRE SILHOUETTE ADDED TO BAG V ]';
          alert('[ SYSTEM NOTE ] All garments in this editorial silhouette have been added to your cart with the 15% outfitting bundle discount.');
          setTimeout(function() { self.textContent = origText; }, 3000);
        }, 600);
      });
    });
  });
</script>

