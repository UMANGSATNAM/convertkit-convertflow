{%- comment -%}
  banner_promo_grid.liquid — Promotional Bento / Grid Banner
  
  DESIGN PHILOSOPHY:
  High-impact promotional grid (bento style) for showcasing current offers,
  seasonal sales, or value propositions. Features optional image backgrounds,
  gradient overlays, pill badges, and bold call-to-action buttons.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --bpg-bg: var(--color-background, #ffffff);
    --bpg-text: var(--color-text, #0f172a);
    --bpg-muted: color-mix(in srgb, var(--bpg-text) 60%, transparent);
    --bpg-border: color-mix(in srgb, var(--bpg-text) 10%, transparent);
    --bpg-accent: var(--color-accent, #2563eb);
    --bpg-font: var(--font-body, 'Inter', -apple-system, sans-serif);
    --bpg-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
  }

  .bpg-section {
    background: var(--bpg-bg);
    padding: clamp(3rem, 7vw, 6rem) clamp(1.25rem, 4vw, 3.5rem);
  }

  .bpg-inner {
    max-width: 1360px;
    margin: 0 auto;
  }

  .bpg-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .bpg-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .bpg-grid[data-cols="3"] {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bpg-card {
    position: relative;
    border-radius: var(--radius-card, 20px);
    overflow: hidden;
    min-height: clamp(280px, 35vw, 380px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    text-decoration: none;
    color: #ffffff;
    background: #1e293b;
    border: 1px solid var(--bpg-border);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }
  .bpg-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.25);
  }

  .bpg-bg-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bpg-card:hover .bpg-bg-img {
    transform: scale(1.06);
  }

  .bpg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.75) 100%);
    z-index: 2;
  }

  .bpg-content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .bpg-badge {
    background: var(--bpg-accent);
    color: #ffffff;
    font-family: var(--bpg-font);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.35rem 0.8rem;
    border-radius: 100px;
    line-height: 1;
  }

  .bpg-title {
    font-family: var(--bpg-font-head);
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    font-weight: 700;
    margin: 0;
    line-height: 1.15;
    color: #ffffff;
  }

  .bpg-desc {
    font-family: var(--bpg-font);
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 0.5rem 0;
    line-height: 1.5;
    max-width: 400px;
  }

  .bpg-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--bpg-font);
    font-size: 0.85rem;
    font-weight: 600;
    color: #000000;
    background: #ffffff;
    padding: 0.65rem 1.4rem;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  .bpg-card:hover .bpg-btn {
    background: var(--bpg-accent);
    color: #ffffff;
  }
</style>

<section class="bpg-section" aria-label="Promotional Offers">
  <div class="bpg-inner">
    <div class="bpg-grid" data-cols="{{ section.settings.columns | default: '3' }}">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.url | default: '/collections/all' }}" class="bpg-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.title, class: 'bpg-bg-img' }}
          {%- else -%}
            <div class="bpg-bg-img" style="background: linear-gradient(135deg, #1e293b, #0f172a); width: 100%; height: 100%;"></div>
          {%- endif -%}
          <div class="bpg-overlay"></div>
          <div class="bpg-content">
            {%- if block.settings.badge != blank -%}
              <span class="bpg-badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            <h3 class="bpg-title">{{ block.settings.title }}</h3>
            {%- if block.settings.description != blank -%}
              <p class="bpg-desc">{{ block.settings.description }}</p>
            {%- endif -%}
            {%- if block.settings.button_text != blank -%}
              <span class="bpg-btn">{{ block.settings.button_text }} →</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo Bento Grid",
  "tag": "section",
  "class": "section-banner-promo-grid",
  "settings": [
    {
      "type": "select",
      "id": "columns",
      "label": "Desktop Columns",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" }
      ],
      "default": "3"
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background Image" },
        { "type": "text", "id": "badge", "label": "Pill Badge", "default": "Limited Time" },
        { "type": "text", "id": "title", "label": "Title", "default": "Midsummer Sale" },
        { "type": "text", "id": "description", "label": "Description", "default": "Take an extra 30% off all sale styles with code SUMMER30 at checkout." },
        { "type": "text", "id": "button_text", "label": "Button Text", "default": "Shop Sale" },
        { "type": "url", "id": "url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo Bento Grid",
      "blocks": [
        { "type": "promo", "settings": { "badge": "Special Offer", "title": "Free Express Delivery", "description": "Complimentary worldwide courier shipping on all orders over $150.", "button_text": "Learn More" } },
        { "type": "promo", "settings": { "badge": "New Season", "title": "Autumn Essentials", "description": "Discover lightweight layering pieces crafted from organic merino wool.", "button_text": "Explore Edit" } },
        { "type": "promo", "settings": { "badge": "VIP Perks", "title": "Join The Club", "description": "Earn 5 points for every dollar spent and unlock early drop access.", "button_text": "Sign Up Free" } }
      ]
    }
  ]
}
{% endschema %}
