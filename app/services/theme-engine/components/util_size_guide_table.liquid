{%- comment -%}
  util_size_guide_table.liquid — Ultra-Comprehensive Dimensional Size & Fitting Guide
  
  DESIGN PHILOSOPHY:
  An architectural specification engine engineered to provide absolute dimensional clarity
  for serialized workstation chassis and desk accessories. Features instant Metric (mm/cm/g) vs
  Imperial (in/lbs) real-time conversion toggles, form factor tabs, and an accessible
  Measurement Diagram Lightbox Modal Dialog explaining typing angles and front height ergonomics.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --usg-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --usg-card-bg: {{ section.settings.card_bg_color | default: '#f8fafc' }};
    --usg-text: {{ section.settings.text_color | default: '#0f172a' }};
    --usg-muted: color-mix(in srgb, var(--usg-text) 60%, transparent);
    --usg-border: color-mix(in srgb, var(--usg-text) 14%, transparent);
    --usg-accent: {{ section.settings.accent_color | default: '#0f172a' }};
    --usg-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --usg-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --usg-padding-top: clamp(3.5rem, 8vw, 6rem);
    --usg-padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .usg-section {
    background-color: var(--usg-bg);
    color: var(--usg-text);
    font-family: var(--usg-font-body);
    padding: var(--usg-padding-top) clamp(1.25rem, 4vw, 4rem) var(--usg-padding-bottom);
    border-bottom: 1px solid var(--usg-border);
    position: relative;
  }

  .usg-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  /* Section Header */
  .usg-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--usg-border);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .usg-head-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 640px;
  }
  .usg-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--usg-accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .usg-eyebrow::before {
    content: "";
    width: 20px;
    height: 2px;
    background: var(--usg-accent);
  }
  .usg-title {
    font-family: var(--usg-font-head);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }
  .usg-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--usg-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Unit Toggle Bar */
  .usg-unit-toggle {
    display: flex;
    background: var(--usg-card-bg);
    border: 1px solid var(--usg-border);
    border-radius: 100px;
    padding: 0.35rem;
    gap: 0.25rem;
  }
  .usg-unit-btn {
    background: transparent;
    border: none;
    color: var(--usg-muted);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.55rem 1.25rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .usg-unit-btn[data-active="true"] {
    background: var(--usg-text);
    color: var(--usg-bg);
  }

  /* Form Factor Tabs */
  .usg-tabs {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: thin;
  }
  .usg-tab {
    background: var(--usg-card-bg);
    color: var(--usg-muted);
    border: 1px solid var(--usg-border);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.65rem 1.35rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .usg-tab[data-active="true"],
  .usg-tab:hover {
    background: var(--usg-text);
    color: var(--usg-bg);
    border-color: var(--usg-text);
  }

  /* Specification Table Card */
  .usg-table-wrap {
    width: 100%;
    overflow-x: auto;
    border-radius: 28px;
    background: var(--usg-card-bg);
    border: 1px solid var(--usg-border);
    box-shadow: 0 25px 50px -15px rgba(0, 0, 0, 0.05);
    scrollbar-width: thin;
  }
  .usg-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 680px;
    text-align: left;
  }
  .usg-table th,
  .usg-table td {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--usg-border);
    font-size: 0.95rem;
  }
  .usg-table th {
    font-family: var(--usg-font-head);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--usg-text);
    background: color-mix(in srgb, var(--usg-text) 3%, transparent);
  }
  .usg-table tr:last-child td {
    border-bottom: none;
  }
  .usg-val {
    font-family: var(--usg-font-head);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--usg-accent);
  }

  /* Help Trigger Bar */
  .usg-footer-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: color-mix(in srgb, var(--usg-text) 4%, transparent);
    border: 1px dashed var(--usg-border);
    border-radius: 24px;
    padding: 1.5rem 2rem;
  }
  .usg-help-btn {
    background: var(--usg-text);
    color: var(--usg-bg);
    font-weight: 700;
    font-size: 0.88rem;
    border: none;
    padding: 0.85rem 1.75rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .usg-help-btn:hover {
    background: var(--usg-accent);
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* Measurement Diagram Lightbox Modal */
  .usg-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .usg-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .usg-modal {
    background: var(--usg-card-bg);
    color: var(--usg-text);
    border: 1px solid var(--usg-border);
    border-radius: 32px;
    max-width: 680px;
    width: 100%;
    padding: clamp(2rem, 5vw, 3.5rem);
    position: relative;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.8);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .usg-modal-overlay[data-open="true"] .usg-modal {
    transform: scale(1);
  }
  .usg-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: color-mix(in srgb, var(--usg-text) 10%, transparent);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--usg-text);
    cursor: pointer;
  }
</style>

<section class="usg-section" id="usg-section-{{ section.id }}" aria-labelledby="usg-title-{{ section.id }}">
  <div class="usg-container">
    
    <!-- Section Header & Unit Switcher -->
    <div class="usg-header">
      <div class="usg-head-text">
        {%- if section.settings.eyebrow != blank -%}
          <div class="usg-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="usg-title-{{ section.id }}" class="usg-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="usg-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      <div class="usg-unit-toggle" id="usg-toggle-{{ section.id }}" role="tablist">
        <button type="button" class="usg-unit-btn" data-unit="metric" data-active="true" role="tab" aria-selected="true">Metric (mm / g)</button>
        <button type="button" class="usg-unit-btn" data-unit="imperial" role="tab" aria-selected="false">Imperial (in / lbs)</button>
      </div>
    </div>

    <!-- Layout Form Factor Tabs -->
    <div class="usg-tabs" role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" class="usg-tab {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}" {% if forloop.first %}data-active="true"{% endif %} role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
          {{ block.settings.title | default: '65% Monolith Pro' }}
        </button>
      {%- endfor -%}
    </div>

    <!-- Specification Dimensions Table -->
    <div class="usg-table-wrap">
      <table class="usg-table" id="usg-table-{{ section.id }}">
        <thead>
          <tr>
            <th>Dimensional Metric</th>
            <th>Specification Value</th>
            <th>Ergonomic Reference Note</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Chassis Width (Horizontal Length)</td>
            <td class="usg-val" data-metric="324.5 mm" data-imperial="12.78 in">324.5 mm</td>
            <td>Optimized to maintain a neutral shoulder stance during intensive editing.</td>
          </tr>
          <tr>
            <td>Chassis Depth (Front to Back)</td>
            <td class="usg-val" data-metric="118.2 mm" data-imperial="4.65 in">118.2 mm</td>
            <td>Compact footprint preserves critical desk real estate for graphic tablets.</td>
          </tr>
          <tr>
            <td>Front Lip Height (Palm Rest Interface)</td>
            <td class="usg-val" data-metric="18.5 mm" data-imperial="0.73 in">18.5 mm</td>
            <td>Ultra-low front height eliminates wrist dorsiflexion without a wrist rest.</td>
          </tr>
          <tr>
            <td>Rear Chassis Elevation</td>
            <td class="usg-val" data-metric="34.0 mm" data-imperial="1.34 in">34.0 mm</td>
            <td>Provides natural keycap step visibility across all 5 functional rows.</td>
          </tr>
          <tr>
            <td>Fixed Ergonomic Typing Angle</td>
            <td class="usg-val" style="color:var(--usg-text);">6.5° Fixed Geometry</td>
            <td>Clinically tested slope preventing carpal tunnel strain over 12+ hour sessions.</td>
          </tr>
          <tr>
            <td>Fully Assembled Unibody Weight</td>
            <td class="usg-val" data-metric="2,150 g" data-imperial="4.74 lbs">2,150 g</td>
            <td>High density prevents micro-shifting on desk mats during competitive gaming.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Help Trigger Bar -->
    <div class="usg-footer-bar">
      <div>
        <h3 style="font-family:var(--usg-font-head);font-size:1.25rem;margin:0 0 0.25rem;">Need assistance measuring your workspace?</h3>
        <p style="font-size:0.9rem;color:var(--usg-muted);margin:0;">Inspect our architectural measurement diagram to understand typing angles and acoustic clearance.</p>
      </div>
      <button type="button" class="usg-help-btn" id="usg-guide-btn-{{ section.id }}">
        <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.5;"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        <span>View Measurement Diagram</span>
      </button>
    </div>

  </div>

  <!-- Measurement Diagram Lightbox Modal -->
  <div class="usg-modal-overlay" id="usg-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="usg-modal">
      <button type="button" class="usg-modal-close" id="usg-modal-close-{{ section.id }}" aria-label="Close measurement diagram modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div style="display:flex;align-items:center;gap:0.75rem;">
        <span style="width:12px;height:12px;border-radius:50%;background:var(--usg-accent);"></span>
        <span style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:var(--usg-muted);">Architectural Ergonomic Diagram</span>
      </div>

      <h3 style="font-family:var(--usg-font-head);font-size:1.85rem;margin:0;">The 6.5° Ergonomic Geometry</h3>
      <p style="font-size:0.98rem;line-height:1.65;color:var(--usg-muted);margin:0;">Our unibody chassis is precision CNC milled with a permanent 6.5-degree incline and an 18.5mm front lip. This specific proportion aligns keycap rows with natural finger trajectories.</p>

      <div style="background:color-mix(in srgb,var(--usg-text) 5%,transparent);border:1px dashed var(--usg-border);border-radius:20px;padding:2rem;text-align:center;">
        <svg viewBox="0 0 400 160" style="max-width:100%;height:auto;stroke:var(--usg-text);fill:none;stroke-width:2;">
          <polygon points="40,120 360,120 360,60 40,95" fill="color-mix(in srgb, var(--usg-text) 10%, transparent)"></polygon>
          <line x1="40" y1="120" x2="360" y2="120" stroke-width="3"></line>
          <line x1="40" y1="95" x2="360" y2="60" stroke-dasharray="6,4" stroke="var(--usg-accent)"></line>
          <text x="200" y="80" fill="var(--usg-accent)" font-size="14" font-weight="bold" font-family="sans-serif">6.5° Typing Slope</text>
          <text x="50" y="115" fill="var(--usg-text)" font-size="12" font-family="sans-serif">18.5mm Front</text>
          <text x="300" y="55" fill="var(--usg-text)" font-size="12" font-family="sans-serif">34.0mm Rear</text>
        </svg>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('usg-section-' + sid);
    if (!sectionEl) return;

    // 1. Metric vs Imperial Switcher
    var toggleBtns = sectionEl.querySelectorAll('.usg-unit-btn');
    var valCells = sectionEl.querySelectorAll('.usg-val[data-metric]');

    toggleBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var unit = btn.getAttribute('data-unit');

        toggleBtns.forEach(function(b) {
          b.removeAttribute('data-active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.setAttribute('data-active', 'true');
        btn.setAttribute('aria-selected', 'true');

        valCells.forEach(function(cell) {
          if (unit === 'imperial') {
            cell.innerText = cell.getAttribute('data-imperial');
          } else {
            cell.innerText = cell.getAttribute('data-metric');
          }
        });
      });
    });

    // 2. Form Factor Tab Switcher
    var tabs = sectionEl.querySelectorAll('.usg-tab');
    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) {
          t.removeAttribute('data-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.setAttribute('data-active', 'true');
        tab.setAttribute('aria-selected', 'true');
      });
    });

    // 3. Measurement Guide Modal Controller
    var modalOverlay = document.getElementById('usg-modal-' + sid);
    var modalClose = document.getElementById('usg-modal-close-' + sid);
    var guideBtn = document.getElementById('usg-guide-btn-' + sid);

    if (modalOverlay && modalClose && guideBtn) {
      guideBtn.addEventListener('click', function() {
        modalOverlay.setAttribute('data-open', 'true');
        modalOverlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Dimensional Size Guide",
  "tag": "section",
  "class": "section-util-size-guide-table",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Table Background",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0f172a"
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Dimensional Architecture"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Workstation Specification Matrix"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Verify chassis width, ergonomic front lip height, and unibody mass across our serialized form factor layouts."
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Form Factor Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Layout Name",
          "default": "65% Monolith Pro"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dimensional Size Guide",
      "blocks": [
        { "type": "tab", "settings": { "title": "65% Monolith Pro" } },
        { "type": "tab", "settings": { "title": "75% Studio Workstation" } },
        { "type": "tab", "settings": { "title": "60% Ultra-Compact" } },
        { "type": "tab", "settings": { "title": "Full-Size 100% Flagship" } }
      ]
    }
  ]
}
{% endschema %}
