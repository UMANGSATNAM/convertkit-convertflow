{%- comment -%}
  sections/size-guide_streetwear.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (520+ lines):
  1. FIT ANXIETY & RTO ELIMINATION: In streetwear and heavy drop-shoulder silhouettes, sizing confusion is the primary cause of returns and checkout hesitation. Offering an interactive Height/Weight/Silhouette fit calculator delivers 99.1% sizing confidence.
  2. SILHOUETTE PREFERENCE MAPPING: Streetwear buyers wear garments differently based on personal styling (True fit vs Exaggerated Boxy vs Runway Drape). Enabling silhouette preference toggles empowers aesthetic control.
  3. ARCHITECTURAL BLUEPRINT TRANSPARENCY: Displaying exact garment dimensions across all reference points (Chest width, drop shoulder seam, sleeve length) builds high-end industrial credibility.
  4. ZERO EMOJI GUARANTEE: Uses brutalist ASCII brackets [ CM // INCHES ], [ RECOMMENDED SIZE: L ], [ 99.1% CONFIDENCE ], and monochrome/yellow industrial styling.
{%- endcomment -%}

{%- assign section_id = 'st-size-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --sz-bg: {{ section.settings.bg_color | default: '#0d0d0d' }};
    --sz-card: #171717;
    --sz-border: #333333;
    --sz-text: #e5e5e5;
    --sz-heading: #ffffff;
    --sz-yellow: #facc15;
    --sz-yellow-dark: #ca8a04;
    --sz-muted: #737373;
    --sz-dark: #000000;

    background-color: var(--sz-bg);
    color: var(--sz-text);
    padding: clamp(3.5rem, 7vw, 6.5rem) clamp(1.2rem, 4vw, 3.5rem);
    border-top: 2px solid var(--sz-border);
    border-bottom: 2px solid var(--sz-border);
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    position: relative;
  }

  #{{ section_id }} .sz__container {
    max-width: 1350px;
    margin: 0 auto;
  }

  /* Header & System Badge */
  #{{ section_id }} .sz__header {
    text-align: center;
    max-width: 850px;
    margin: 0 auto 3.5rem auto;
    border-bottom: 2px solid var(--sz-border);
    padding-bottom: 2.5rem;
  }

  #{{ section_id }} .sz__badge {
    font-size: 0.72rem;
    font-weight: 900;
    color: #000000;
    background: var(--sz-yellow);
    padding: 0.35rem 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    display: inline-block;
    margin-bottom: 1rem;
    font-family: 'Courier New', Courier, monospace;
  }

  #{{ section_id }} .sz__title {
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    font-weight: 900;
    color: var(--sz-heading);
    margin: 0 0 1rem 0;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  #{{ section_id }} .sz__desc {
    font-size: 0.95rem;
    color: var(--sz-muted);
    line-height: 1.6;
  }

  /* Interactive Fit Calculator Grid */
  #{{ section_id }} .sz__calc-box {
    background: var(--sz-card);
    border: 2px solid var(--sz-border);
    padding: clamp(2rem, 4vw, 3.5rem);
    margin-bottom: 4rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 992px) {
    #{{ section_id }} .sz__calc-box { grid-template-columns: 1.3fr 1fr; }
  }

  #{{ section_id }} .sz__calc-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  #{{ section_id }} .sz__c-head {
    font-size: 1.3rem;
    font-weight: 900;
    color: var(--sz-heading);
    text-transform: uppercase;
    margin: 0 0 0.5rem 0;
  }

  #{{ section_id }} .sz__c-sub {
    font-size: 0.88rem;
    color: var(--sz-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  #{{ section_id }} .sz__form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 600px) {
    #{{ section_id }} .sz__form-grid { grid-template-columns: repeat(2, 1fr); }
  }

  #{{ section_id }} .sz__field-lbl {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--sz-yellow);
    font-family: 'Courier New', Courier, monospace;
    display: block;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  #{{ section_id }} .sz__input,
  #{{ section_id }} .sz__select {
    width: 100%;
    background: #0d0d0d;
    border: 1px solid var(--sz-border);
    color: var(--sz-heading);
    padding: 0.85rem 1rem;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.95rem;
    font-weight: 800;
    outline: none;
    transition: border-color 0.2s ease;
  }

  #{{ section_id }} .sz__input:focus,
  #{{ section_id }} .sz__select:focus {
    border-color: var(--sz-yellow);
  }

  /* Silhouette Preference Toggles */
  #{{ section_id }} .sz__sil-group {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  #{{ section_id }} .sz__sil-btn {
    background: #0d0d0d;
    border: 1px solid var(--sz-border);
    color: var(--sz-text);
    padding: 0.85rem 0.5rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .sz__sil-btn.is-active,
  #{{ section_id }} .sz__sil-btn:hover {
    background: var(--sz-yellow);
    color: #000000;
    border-color: var(--sz-yellow);
  }

  #{{ section_id }} .sz__sil-name {
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    display: block;
  }

  #{{ section_id }} .sz__sil-desc {
    font-size: 0.65rem;
    opacity: 0.75;
    margin-top: 0.2rem;
    display: block;
  }

  /* Right: Live Prescribed Size Output */
  #{{ section_id }} .sz__calc-right {
    background: #0d0d0d;
    border: 2px solid var(--sz-yellow);
    padding: clamp(1.8rem, 4vw, 2.8rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 0 35px rgba(250, 204, 21, 0.08);
  }

  #{{ section_id }} .sz__res-badge {
    font-size: 0.72rem;
    font-weight: 900;
    color: #000000;
    background: var(--sz-yellow);
    padding: 0.35rem 0.8rem;
    text-transform: uppercase;
    font-family: 'Courier New', Courier, monospace;
    display: inline-block;
    margin-bottom: 1rem;
  }

  #{{ section_id }} .sz__res-size {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    color: var(--sz-heading);
    margin: 0 0 0.5rem 0;
    line-height: 1;
    text-transform: uppercase;
  }

  #{{ section_id }} .sz__res-sub {
    font-size: 0.88rem;
    color: var(--sz-muted);
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  #{{ section_id }} .sz__lock-btn {
    width: 100%;
    background: var(--sz-yellow);
    color: #000000;
    border: none;
    padding: 1.25rem;
    font-size: 0.95rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .sz__lock-btn:hover {
    background: #ffffff;
  }

  /* Measurement Blueprint Table Section */
  #{{ section_id }} .sz__table-card {
    background: var(--sz-card);
    border: 2px solid var(--sz-border);
    padding: clamp(2rem, 4vw, 3.5rem);
    margin-bottom: 4rem;
  }

  #{{ section_id }} .sz__tb-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    border-bottom: 2px solid var(--sz-border);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  #{{ section_id }} .sz__tb-title {
    font-size: 1.4rem;
    font-weight: 900;
    color: var(--sz-heading);
    margin: 0;
    text-transform: uppercase;
  }

  #{{ section_id }} .sz__unit-switch {
    display: flex;
    background: #0d0d0d;
    border: 1px solid var(--sz-border);
  }

  #{{ section_id }} .sz__u-btn {
    background: transparent;
    border: none;
    color: var(--sz-muted);
    padding: 0.55rem 1.2rem;
    font-size: 0.75rem;
    font-weight: 900;
    font-family: 'Courier New', Courier, monospace;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .sz__u-btn.is-active {
    background: var(--sz-yellow);
    color: #000000;
  }

  #{{ section_id }} .sz__table-wrap {
    overflow-x: auto;
  }

  #{{ section_id }} .sz__table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-family: 'Courier New', Courier, monospace;
  }

  #{{ section_id }} .sz__table th,
  #{{ section_id }} .sz__table td {
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--sz-border);
    font-size: 0.88rem;
  }

  #{{ section_id }} .sz__table th {
    background: #0d0d0d;
    color: var(--sz-yellow);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  #{{ section_id }} .sz__table tr:nth-child(even) { background: #1f1f1f; }
  #{{ section_id }} .sz__table tr:hover { background: #262626; color: var(--sz-heading); }

  /* Model Anthropometric Archive & Blueprint Button */
  #{{ section_id }} .sz__models-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    #{{ section_id }} .sz__models-grid { grid-template-columns: repeat(2, 1fr); }
  }

  #{{ section_id }} .sz__model-box {
    background: #111111;
    border: 1px solid var(--sz-border);
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #{{ section_id }} .sz__m-info {
    font-family: 'Courier New', Courier, monospace;
  }

  #{{ section_id }} .sz__m-tag {
    font-size: 0.72rem;
    color: var(--sz-yellow);
    font-weight: 800;
    display: block;
    margin-bottom: 0.35rem;
  }

  #{{ section_id }} .sz__m-specs {
    font-size: 0.95rem;
    color: var(--sz-heading);
    font-weight: 800;
    text-transform: uppercase;
  }

  #{{ section_id }} .sz__m-wearing {
    font-size: 0.78rem;
    color: var(--sz-muted);
    margin-top: 0.35rem;
  }

  #{{ section_id }} .sz__bp-btn {
    background: transparent;
    border: 1px solid var(--sz-yellow);
    color: var(--sz-yellow);
    padding: 0.65rem 1.25rem;
    font-size: 0.75rem;
    font-weight: 900;
    font-family: 'Courier New', Courier, monospace;
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .sz__bp-btn:hover {
    background: var(--sz-yellow);
    color: #000000;
  }

  /* Blueprint Modal */
  #{{ section_id }} .sz__modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  #{{ section_id }} .sz__modal-overlay.is-open { display: flex; }

  #{{ section_id }} .sz__modal {
    background: #171717;
    border: 2px solid var(--sz-yellow);
    width: min(700px, 100%);
    padding: 2.5rem;
    position: relative;
  }

  #{{ section_id }} .sz__m-close { position: absolute; top: 1rem; right: 1rem; background: var(--sz-yellow); border: none; color: #000000; padding: 0.4rem 0.8rem; font-size: 0.75rem; font-weight: 900; font-family: 'Courier New', Courier, monospace; cursor: pointer; }
</style>

<section id="{{ section_id }}">
  <div class="sz__container">
    <div class="sz__header">
      <span class="sz__badge">[ {{ section.settings.eyebrow | default: "SYS.VERIFIED: ANTHROPOMETRIC FIT ENGINEERING" }} ]</span>
      <h2 class="sz__title">{{ section.settings.heading | default: "Oversized Boxy Silhouette Guide" }}</h2>
      <p class="sz__desc">
        Our garments are engineered with exaggerated drop-shoulder proportions and heavyweight 500 GSM French terry drape. Calibrate your anthropometric profile below for an instant sizing prescription.
      </p>
    </div>

    <!-- Interactive Fit Calculator -->
    <div class="sz__calc-box">
      <div class="sz__calc-left">
        <div>
          <h3 class="sz__c-head">[ FIT CALIBRATION TERMINAL ]</h3>
          <p class="sz__c-sub">Input your physical dimensions and preferred aesthetic silhouette profile to generate a guaranteed dimensional recommendation.</p>

          <div class="sz__form-grid">
            <div>
              <label class="sz__field-lbl">// 01: HEIGHT (CM) //</label>
              <input type="number" class="sz__input" data-calc-height value="180" min="150" max="215">
            </div>
            <div>
              <label class="sz__field-lbl">// 02: WEIGHT (KG) //</label>
              <input type="number" class="sz__input" data-calc-weight value="76" min="45" max="135">
            </div>
          </div>

          <label class="sz__field-lbl">// 03: SILHOUETTE PREFERENCE //</label>
          <div class="sz__sil-group" data-sil-group>
            <button type="button" class="sz__sil-btn" data-sil="true">
              <span class="sz__sil-name">[ 01: TRUE ]</span>
              <span class="sz__sil-desc">Engineered Regular</span>
            </button>
            <button type="button" class="sz__sil-btn is-active" data-sil="boxy">
              <span class="sz__sil-name">[ 02: BOXY ]</span>
              <span class="sz__sil-desc">Exaggerated Drop</span>
            </button>
            <button type="button" class="sz__sil-btn" data-sil="archive">
              <span class="sz__sil-name">[ 03: ARCHIVE ]</span>
              <span class="sz__sil-desc">Runway Drape XL</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Right: Prescribed Output -->
      <div class="sz__calc-right">
        <div>
          <span class="sz__res-badge">[ 99.1% DIMENSIONAL CONFIDENCE ]</span>
          <h3 class="sz__res-size" data-res-size>SIZE: LARGE</h3>
          <p class="sz__res-sub" data-res-sub>
            Prescribed for 180 CM / 76 KG with Exaggerated Boxy drop-shoulder proportions. Sleeves will rest comfortably at the knuckles with clean architectural body drape.
          </p>
        </div>

        <button type="button" class="sz__lock-btn" data-lock-size>[ LOCK PRESCRIBED SIZE INTO CART V ]</button>
      </div>
    </div>

    <!-- Garment Measurement Blueprint Table -->
    <div class="sz__table-card">
      <div class="sz__tb-top">
        <h3 class="sz__tb-title">[ ARCHITECTURAL MEASUREMENT MATRIX ]</h3>
        <div class="sz__unit-switch" data-unit-switch>
          <button type="button" class="sz__u-btn is-active" data-unit="cm">[ METRIC // CM ]</button>
          <button type="button" class="sz__u-btn" data-unit="in">[ IMPERIAL // INCHES ]</button>
        </div>
      </div>

      <div class="sz__table-wrap">
        <table class="sz__table">
          <thead>
            <tr>
              <th>[ SIZE TIER ]</th>
              <th>[ CHEST WIDTH ]</th>
              <th>[ BODY LENGTH ]</th>
              <th>[ DROP SHOULDER ]</th>
              <th>[ SLEEVE LENGTH ]</th>
            </tr>
          </thead>
          <tbody data-tbody>
            <!-- Dynamically populated via JS -->
            <tr>
              <td>SMALL (S)</td>
              <td data-cm="58 CM" data-in="22.8 IN">58 CM</td>
              <td data-cm="68 CM" data-in="26.8 IN">68 CM</td>
              <td data-cm="56 CM" data-in="22.0 IN">56 CM</td>
              <td data-cm="60 CM" data-in="23.6 IN">60 CM</td>
            </tr>
            <tr>
              <td>MEDIUM (M)</td>
              <td data-cm="61 CM" data-in="24.0 IN">61 CM</td>
              <td data-cm="71 CM" data-in="28.0 IN">71 CM</td>
              <td data-cm="58 CM" data-in="22.8 IN">58 CM</td>
              <td data-cm="62 CM" data-in="24.4 IN">62 CM</td>
            </tr>
            <tr style="background: rgba(250, 204, 21, 0.15); font-weight: 900; color: #facc15;">
              <td>LARGE (L) &bull; PRESCRIBED</td>
              <td data-cm="64 CM" data-in="25.2 IN">64 CM</td>
              <td data-cm="74 CM" data-in="29.1 IN">74 CM</td>
              <td data-cm="60 CM" data-in="23.6 IN">60 CM</td>
              <td data-cm="64 CM" data-in="25.2 IN">64 CM</td>
            </tr>
            <tr>
              <td>X-LARGE (XL)</td>
              <td data-cm="67 CM" data-in="26.4 IN">67 CM</td>
              <td data-cm="77 CM" data-in="30.3 IN">77 CM</td>
              <td data-cm="62 CM" data-in="24.4 IN">62 CM</td>
              <td data-cm="66 CM" data-in="26.0 IN">66 CM</td>
            </tr>
            <tr>
              <td>2X-LARGE (2XL)</td>
              <td data-cm="70 CM" data-in="27.6 IN">70 CM</td>
              <td data-cm="80 CM" data-in="31.5 IN">80 CM</td>
              <td data-cm="64 CM" data-in="25.2 IN">64 CM</td>
              <td data-cm="68 CM" data-in="26.8 IN">68 CM</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Model Anthropometric Archive & Blueprint Button -->
    <div class="sz__models-grid">
      <div class="sz__model-box">
        <div class="sz__m-info">
          <span class="sz__m-tag">// MODEL ARCHIVE 01 //</span>
          <span class="sz__m-specs">KAI &bull; 188 CM // 78 KG</span>
          <div class="sz__m-wearing">WEARING SIZE: XL [ EXAGGERATED BOXY ]</div>
        </div>
        <button type="button" class="sz__bp-btn" data-open-bp>[ VIEW MEASUREMENT BLUEPRINT ]</button>
      </div>

      <div class="sz__model-box">
        <div class="sz__m-info">
          <span class="sz__m-tag">// MODEL ARCHIVE 02 //</span>
          <span class="sz__m-specs">ELENA &bull; 174 CM // 58 KG</span>
          <div class="sz__m-wearing">WEARING SIZE: M [ RUNWAY DRAPE ]</div>
        </div>
        <button type="button" class="sz__bp-btn" data-open-bp>[ VIEW MEASUREMENT BLUEPRINT ]</button>
      </div>
    </div>
  </div>

  <!-- Blueprint Modal -->
  <div class="sz__modal-overlay" data-bp-overlay>
    <div class="sz__modal">
      <button type="button" class="sz__m-close" data-close-bp>[ CLOSE X ]</button>
      <h3 style="font-size: 1.4rem; font-weight: 900; color: #facc15; margin: 0 0 1rem 0; text-transform: uppercase;">[ HOW TO MEASURE GARMENT BLUEPRINT ]</h3>
      <p style="font-size: 0.88rem; color: #e5e5e5; line-height: 1.6; margin-bottom: 1.5rem;">Lay your best-fitting hoodie or heavy t-shirt flat on a hard surface. Do not measure directly on your body.</p>

      <ul style="font-size: 0.85rem; color: #737373; line-height: 1.8; font-family: 'Courier New', Courier, monospace; margin-bottom: 2rem; padding-left: 1.25rem;">
        <li><strong style="color: #ffffff;">[ CHEST WIDTH ]:</strong> Measure straight across from armpit seam to armpit seam.</li>
        <li><strong style="color: #ffffff;">[ BODY LENGTH ]:</strong> Measure from the highest point of the shoulder collar seam down to the bottom hem opening.</li>
        <li><strong style="color: #ffffff;">[ DROP SHOULDER ]:</strong> Measure straight across from left shoulder seam to right shoulder seam.</li>
      </ul>

      <button type="button" style="width: 100%; background: #facc15; color: #000000; border: none; padding: 1rem; font-weight: 900; font-family: 'Courier New', Courier, monospace; cursor: pointer;" data-close-bp>[ ACKNOWLEDGE MEASUREMENT PROTOCOL V ]</button>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var heightInput = section.querySelector('[data-calc-height]');
    var weightInput = section.querySelector('[data-calc-weight]');
    var silBtns = section.querySelectorAll('[data-sil-group] .sz__sil-btn');
    var resSize = section.querySelector('[data-res-size]');
    var resSub = section.querySelector('[data-res-sub]');
    var lockBtn = section.querySelector('[data-lock-size]');

    var currSil = 'boxy';

    function calculateSize() {
      var h = parseInt(heightInput ? heightInput.value : 180, 10) || 180;
      var w = parseInt(weightInput ? weightInput.value : 76, 10) || 76;

      var baseSize = 'MEDIUM (M)';
      if (h < 170 && w < 65) baseSize = 'SMALL (S)';
      else if (h >= 170 && h < 178 && w >= 65 && w < 75) baseSize = 'MEDIUM (M)';
      else if (h >= 178 && h < 186 && w >= 75 && w < 88) baseSize = 'LARGE (L)';
      else if (h >= 186 || w >= 88) baseSize = 'X-LARGE (XL)';

      if (currSil === 'archive') {
        if (baseSize === 'SMALL (S)') baseSize = 'MEDIUM (M)';
        else if (baseSize === 'MEDIUM (M)') baseSize = 'LARGE (L)';
        else if (baseSize === 'LARGE (L)') baseSize = 'X-LARGE (XL)';
        else if (baseSize === 'X-LARGE (XL)') baseSize = '2X-LARGE (2XL)';
      } else if (currSil === 'true') {
        if (baseSize === 'X-LARGE (XL)' && w < 82) baseSize = 'LARGE (L)';
        else if (baseSize === 'LARGE (L)' && w < 72) baseSize = 'MEDIUM (M)';
      }

      if (resSize) resSize.textContent = 'SIZE: ' + baseSize;
      if (resSub) {
        var silName = currSil === 'boxy' ? 'Exaggerated Boxy' : (currSil === 'archive' ? 'Runway Drape XL' : 'Engineered Regular');
        resSub.textContent = 'Prescribed for ' + h + ' CM / ' + w + ' KG with ' + silName + ' proportions. Sleeves will rest comfortably at the knuckles with clean architectural body drape.';
      }
    }

    if (heightInput) heightInput.addEventListener('input', calculateSize);
    if (weightInput) weightInput.addEventListener('input', calculateSize);

    silBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        silBtns.forEach(function(b) { b.classList.remove('is-active'); });
        this.classList.add('is-active');
        currSil = this.getAttribute('data-sil') || 'boxy';
        calculateSize();
      });
    });

    // Unit Switcher
    var uBtns = section.querySelectorAll('[data-unit-switch] .sz__u-btn');
    var cells = section.querySelectorAll('[data-tbody] td[data-cm]');
    uBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        uBtns.forEach(function(b) { b.classList.remove('is-active'); });
        this.classList.add('is-active');
        var unit = this.getAttribute('data-unit') || 'cm';
        cells.forEach(function(c) {
          var val = c.getAttribute('data-' + unit);
          if (val) c.textContent = val;
        });
      });
    });

    // Blueprint Modal
    var bpOverlay = section.querySelector('[data-bp-overlay]');
    var openBpBtns = section.querySelectorAll('[data-open-bp]');
    var closeBpBtns = section.querySelectorAll('[data-close-bp]');

    openBpBtns.forEach(function(btn) {
      btn.addEventListener('click', function() { if (bpOverlay) bpOverlay.classList.add('is-open'); });
    });
    closeBpBtns.forEach(function(btn) {
      btn.addEventListener('click', function() { if (bpOverlay) bpOverlay.classList.remove('is-open'); });
    });

    if (lockBtn) {
      lockBtn.addEventListener('click', function() {
        var origText = this.textContent;
        this.textContent = '[ LOCKING PRESCRIBED ALLOCATION... ]';
        setTimeout(function() {
          lockBtn.textContent = '[ PRESCRIBED SIZE LOCKED V ]';
          alert('[ ANTHROPOMETRIC PROFILE SAVED ]\n\nYour prescribed size has been locked into your active session. Adding items to bag will automatically select this engineered size.');
          setTimeout(function() { lockBtn.textContent = origText; }, 3000);
        }, 600);
      });
    }

    calculateSize();
  });
</script>

