{%- comment -%}
  hero_split_asymmetric.liquid — Ultra-Comprehensive Asymmetric Split Hero Showcase
  
  DESIGN PHILOSOPHY:
  An architectural hero engine engineered with a dramatic 55/45 asymmetric visual balance.
  Features floating technical specification badges, interactive multi-view slide tabs,
  dual primary/secondary conversion CTAs, and an accessible Fullscreen Technical Cinema
  Modal Dialog for streaming engineering teaser films or high-resolution architectural blueprints.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --hsa-bg: {{ section.settings.bg_color | default: '#0f172a' }};
    --hsa-card-bg: {{ section.settings.card_bg_color | default: '#1e293b' }};
    --hsa-text: {{ section.settings.text_color | default: '#f8fafc' }};
    --hsa-muted: color-mix(in srgb, var(--hsa-text) 65%, transparent);
    --hsa-border: color-mix(in srgb, var(--hsa-text) 14%, transparent);
    --hsa-accent: {{ section.settings.accent_color | default: '#38bdf8' }};
    --hsa-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --hsa-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --hsa-padding-top: clamp(3.5rem, 8vw, 6.5rem);
    --hsa-padding-bottom: clamp(3.5rem, 8vw, 6.5rem);
  }

  .hsa-section {
    background-color: var(--hsa-bg);
    color: var(--hsa-text);
    font-family: var(--hsa-font-body);
    padding: var(--hsa-padding-top) clamp(1.25rem, 4vw, 4rem) var(--hsa-padding-bottom);
    border-bottom: 1px solid var(--hsa-border);
    position: relative;
    overflow: hidden;
  }

  .hsa-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hsa-container {
      grid-template-columns: {% if section.settings.image_position == 'left' %}1.1fr 0.9fr{% else %}0.9fr 1.1fr{% endif %};
    }
    .hsa-container[data-pos="left"] .hsa-content {
      order: 2;
    }
    .hsa-container[data-pos="left"] .hsa-visual {
      order: 1;
    }
  }

  /* Editorial Content Column */
  .hsa-content {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    max-width: 620px;
  }
  .hsa-eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--hsa-accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hsa-eyebrow::before {
    content: "";
    width: 24px;
    height: 1px;
    background: var(--hsa-accent);
  }
  .hsa-title {
    font-family: var(--hsa-font-head);
    font-size: clamp(2.5rem, 5.5vw, 4.35rem);
    font-weight: 700;
    line-height: 1.08;
    margin: 0;
  }
  .hsa-desc {
    font-size: clamp(1rem, 2vw, 1.18rem);
    color: var(--hsa-muted);
    line-height: 1.65;
    margin: 0;
  }

  /* Bullet Features */
  .hsa-bullets {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0.5rem 0;
  }
  .hsa-bullet {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--hsa-text);
  }
  .hsa-bullet-icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--hsa-accent) 15%, transparent);
    color: var(--hsa-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .hsa-bullet-icon svg {
    width: 12px;
    height: 12px;
    stroke: currentColor;
    stroke-width: 3;
    fill: none;
  }

  /* CTAs */
  .hsa-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .hsa-btn-pri {
    background: var(--hsa-text);
    color: var(--hsa-bg);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    padding: 1.15rem 2.5rem;
    border-radius: 100px;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hsa-btn-pri:hover {
    background: var(--hsa-accent);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 15px 30px -5px color-mix(in srgb, var(--hsa-accent) 40%, transparent);
  }
  .hsa-btn-sec {
    background: transparent;
    color: var(--hsa-text);
    border: 1px solid var(--hsa-border);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 1.15rem 2.25rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hsa-btn-sec:hover {
    background: color-mix(in srgb, var(--hsa-text) 10%, transparent);
    border-color: var(--hsa-text);
  }

  /* Visual Showcase Column */
  .hsa-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .hsa-img-box {
    background: var(--hsa-card-bg);
    border: 1px solid var(--hsa-border);
    border-radius: 36px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 4 / 3;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.6);
  }
  .hsa-img-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    transform: scale(0.98);
  }
  .hsa-img-slide[data-active="true"] {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
  }
  .hsa-img-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Floating Specification Badges */
  .hsa-floating-badge {
    position: absolute;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.6rem 1.15rem;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
    z-index: 10;
  }
  .hsa-floating-badge.top-right { top: 1.5rem; right: 1.5rem; }
  .hsa-floating-badge.bot-left { bottom: 1.5rem; left: 1.5rem; }
  .hsa-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--hsa-accent);
    box-shadow: 0 0 10px var(--hsa-accent);
  }

  /* View Switcher Tabs */
  .hsa-view-tabs {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: thin;
  }
  .hsa-view-tab {
    background: var(--hsa-card-bg);
    color: var(--hsa-muted);
    border: 1px solid var(--hsa-border);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.6rem 1.25rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .hsa-view-tab[data-active="true"],
  .hsa-view-tab:hover {
    background: var(--hsa-text);
    color: var(--hsa-bg);
    border-color: var(--hsa-text);
  }

  /* Technical Cinema Modal Dialog */
  .hsa-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .hsa-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .hsa-modal {
    background: var(--hsa-card-bg);
    color: var(--hsa-text);
    border: 1px solid var(--hsa-border);
    border-radius: 28px;
    max-width: 800px;
    width: 100%;
    padding: clamp(2rem, 5vw, 3.5rem);
    position: relative;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.8);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hsa-modal-overlay[data-open="true"] .hsa-modal {
    transform: scale(1);
  }
  .hsa-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
  }
</style>

<section class="hsa-section" id="hsa-section-{{ section.id }}" aria-labelledby="hsa-title-{{ section.id }}">
  <div class="hsa-container" data-pos="{{ section.settings.image_position | default: 'right' }}">
    
    <!-- Editorial Content Column -->
    <div class="hsa-content">
      {%- if section.settings.eyebrow != blank -%}
        <div class="hsa-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h1 id="hsa-title-{{ section.id }}" class="hsa-title">{{ section.settings.title }}</h1>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="hsa-desc">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      <!-- Bullet Highlights -->
      <div class="hsa-bullets">
        <div class="hsa-bullet">
          <span class="hsa-bullet-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
          <span>5-Axis CNC Milled Aerospace Aluminum Housing</span>
        </div>
        <div class="hsa-bullet">
          <span class="hsa-bullet-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
          <span>Bespoke Dual-Silicone Acoustic Dampening Gaskets</span>
        </div>
        <div class="hsa-bullet">
          <span class="hsa-bullet-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
          <span>Hot-Swappable Gold-Plated PCB Architecture</span>
        </div>
      </div>

      <div class="hsa-actions">
        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_link | default: '/collections/all' }}" class="hsa-btn-pri">
            <span>{{ section.settings.btn_label }}</span>
            <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2.5;"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        {%- endif -%}
        <button type="button" class="hsa-btn-sec" id="hsa-cinema-btn-{{ section.id }}">
          <svg viewBox="0 0 24 24" style="width:16px;height:16px;fill:currentColor;"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          <span>Watch Technical Cinema</span>
        </button>
      </div>
    </div>

    <!-- Visual Showcase Column -->
    <div class="hsa-visual">
      <div class="hsa-img-box">
        <div class="hsa-floating-badge top-right">
          <span class="hsa-dot"></span>
          <span>Series 04 Monolith Edition</span>
        </div>
        <div class="hsa-floating-badge bot-left">
          <span>CNC Tolerance: ±0.01mm</span>
        </div>

        {%- for block in section.blocks -%}
          <div class="hsa-img-slide {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}" {% if forloop.first %}data-active="true"{% endif %} {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', alt: block.settings.title }}
            {%- else -%}
              <div style="width:100%;height:100%;background:#0f172a;display:flex;align-items:center;justify-content:center;color:#ffffff;font-size:1.5rem;font-weight:700;">View Slide {{ forloop.index }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <!-- View Switcher Tabs -->
      <div class="hsa-view-tabs" role="tablist">
        {%- for block in section.blocks -%}
          <button type="button" class="hsa-view-tab {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}" {% if forloop.first %}data-active="true"{% endif %} role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
            {{ block.settings.title | default: 'Perspective View' }}
          </button>
        {%- endfor -%}
      </div>
    </div>

  </div>

  <!-- Technical Cinema Modal -->
  <div class="hsa-modal-overlay" id="hsa-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="hsa-modal">
      <button type="button" class="hsa-modal-close" id="hsa-modal-close-{{ section.id }}" aria-label="Close technical cinema modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div style="display:flex;align-items:center;gap:0.75rem;">
        <span style="width:12px;height:12px;border-radius:50%;background:var(--hsa-accent);"></span>
        <span style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:var(--hsa-muted);">Technical Cinema Teaser</span>
      </div>

      <h3 style="font-family:var(--hsa-font-head);font-size:2rem;margin:0;">The Monolith Engineering Documentary</h3>
      <p style="font-size:1rem;color:var(--hsa-muted);line-height:1.65;margin:0;">Go inside our Zürich industrial design laboratory to witness the 5-axis CNC milling and acoustic testing of Series 04.</p>

      <div style="aspect-ratio:16/9;background:#000000;border-radius:16px;display:flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,0.1);">
        <span style="color:#ffffff;font-size:1.1rem;font-weight:700;">[ Technical Teaser Video Stream Active ]</span>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('hsa-section-' + sid);
    if (!sectionEl) return;

    // 1. View Switcher Tabs
    var slides = sectionEl.querySelectorAll('.hsa-img-slide');
    var tabs = sectionEl.querySelectorAll('.hsa-view-tab');

    tabs.forEach(function(tab, idx) {
      tab.addEventListener('click', function() {
        slides.forEach(function(s, i) {
          if (i === idx) s.setAttribute('data-active', 'true');
          else s.removeAttribute('data-active');
        });
        tabs.forEach(function(t, i) {
          if (i === idx) {
            t.setAttribute('data-active', 'true');
            t.setAttribute('aria-selected', 'true');
          } else {
            t.removeAttribute('data-active');
            t.setAttribute('aria-selected', 'false');
          }
        });
      });
    });

    // 2. Technical Cinema Modal Controller
    var modalOverlay = document.getElementById('hsa-modal-' + sid);
    var modalClose = document.getElementById('hsa-modal-close-' + sid);
    var cinemaBtn = document.getElementById('hsa-cinema-btn-' + sid);

    if (modalOverlay && modalClose && cinemaBtn) {
      cinemaBtn.addEventListener('click', function() {
        modalOverlay.setAttribute('data-open', 'true');
        modalOverlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Asymmetric Hero Showcase",
  "tag": "section",
  "class": "section-hero-split-asymmetric",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Image Card Background",
      "default": "#1e293b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#38bdf8"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Visual Column Position",
      "options": [
        { "value": "right", "label": "Right Side" },
        { "value": "left", "label": "Left Side" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Copy & CTAs"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "The Flagship Monolith Series"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Precision Milled For Tactical Longevity"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Engineered in Zurich from aerospace-grade 6063 aluminum and dual silicone acoustic chambers. Experience zero mechanical reverberation."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Primary Button Label",
      "default": "Explore The Flagship Series"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Primary Button URL"
    }
  ],
  "blocks": [
    {
      "type": "view",
      "name": "Perspective View",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Perspective Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Tab Name",
          "default": "Isometric Angle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Asymmetric Hero Showcase",
      "blocks": [
        { "type": "view", "settings": { "title": "Isometric Angle" } },
        { "type": "view", "settings": { "title": "Top-Down Chamfer" } },
        { "type": "view", "settings": { "title": "PCB Architecture" } },
        { "type": "view", "settings": { "title": "Acoustic Gasket Profile" } }
      ]
    }
  ]
}
{% endschema %}
