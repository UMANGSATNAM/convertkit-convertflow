{%- comment -%}
  footer_fashion_1.liquid — Fashion / Editorial Footer
  
  DESIGN PHILOSOPHY:
  Magazine-style footer. Elegant serif for the brand,
  clean sans-serif for links. Two-tone with subtle divider.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --fsft-bg: var(--color-background, #fefefe);
    --fsft-text: var(--color-text, #1a1a1a);
    --fsft-muted: color-mix(in srgb, var(--fsft-text) 40%, transparent);
    --fsft-border: color-mix(in srgb, var(--fsft-text) 8%, transparent);
    --fsft-font: var(--font-body, 'Inter', sans-serif);
    --fsft-font-brand: var(--font-heading, 'Cormorant Garamond', serif);
  }

  .fsh-footer {
    background: var(--fsft-bg);
    padding: clamp(3rem, 7vw, 5rem) clamp(1.25rem, 4vw, 3rem) 2rem;
    border-top: 1px solid var(--fsft-border);
  }

  .fsh-footer__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Top grid: Logo + Columns */
  .fsh-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--fsft-border);
    margin-bottom: 2rem;
  }
  @media (min-width: 768px) {
    .fsh-footer__top {
      grid-template-columns: 1.5fr repeat(3, 1fr);
    }
  }

  .fsh-footer__brand {
    font-family: var(--fsft-font-brand);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fsft-text);
    margin-bottom: 0.75rem;
  }
  .fsh-footer__brand-sub {
    font-family: var(--fsft-font);
    font-size: 0.8rem;
    color: var(--fsft-muted);
    line-height: 1.6;
    max-width: 300px;
  }

  .fsh-footer__col-title {
    font-family: var(--fsft-font);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fsft-muted);
    margin-bottom: 1rem;
  }
  .fsh-footer__col-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .fsh-footer__col-links a {
    font-family: var(--fsft-font);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--fsft-text);
    text-decoration: none;
    transition: color 0.2s;
  }
  .fsh-footer__col-links a:hover {
    color: var(--fsft-muted);
  }

  /* Newsletter inline */
  .fsh-footer__newsletter-form {
    display: flex;
    gap: 0;
    margin-top: 0.5rem;
  }
  .fsh-footer__newsletter-input {
    flex: 1;
    padding: 0.7rem 0.75rem;
    background: transparent;
    border: 1px solid var(--fsft-border);
    border-right: none;
    color: var(--fsft-text);
    font-family: var(--fsft-font);
    font-size: 0.8rem;
    outline: none;
  }
  .fsh-footer__newsletter-input::placeholder {
    color: var(--fsft-muted);
  }
  .fsh-footer__newsletter-btn {
    padding: 0.7rem 1.25rem;
    background: var(--fsft-text);
    color: var(--fsft-bg);
    border: 1px solid var(--fsft-text);
    font-family: var(--fsft-font);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .fsh-footer__newsletter-btn:hover {
    opacity: 0.8;
  }

  /* Bottom */
  .fsh-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .fsh-footer__copyright {
    font-family: var(--fsft-font);
    font-size: 0.68rem;
    color: var(--fsft-muted);
  }
  .fsh-footer__social {
    display: flex;
    gap: 1.5rem;
  }
  .fsh-footer__social a {
    font-family: var(--fsft-font);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fsft-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .fsh-footer__social a:hover {
    color: var(--fsft-text);
  }
</style>

<footer class="fsh-footer">
  <div class="fsh-footer__inner">

    <div class="fsh-footer__top">
      <div>
        <div class="fsh-footer__brand">{{ shop.name }}</div>
        {%- if section.settings.tagline != blank -%}
          <p class="fsh-footer__brand-sub">{{ section.settings.tagline }}</p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          <div>
            <div class="fsh-footer__col-title">{{ block.settings.title }}</div>
            <ul class="fsh-footer__col-links">
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        {%- if block.type == 'newsletter' -%}
          <div>
            <div class="fsh-footer__col-title">{{ block.settings.heading | default: 'Newsletter' }}</div>
            <form class="fsh-footer__newsletter-form" action="/contact#contact_form" method="post">
              <input type="hidden" name="form_type" value="customer">
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input type="email" name="contact[email]" class="fsh-footer__newsletter-input" placeholder="Email" required autocomplete="email" aria-label="Email">
              <button type="submit" class="fsh-footer__newsletter-btn">Join</button>
            </form>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="fsh-footer__bottom">
      <div class="fsh-footer__copyright">&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}</div>
      <div class="fsh-footer__social">
        {%- if section.settings.social_instagram != blank -%}
          <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>
        {%- endif -%}
        {%- if section.settings.social_tiktok != blank -%}
          <a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>
        {%- endif -%}
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Fashion Footer",
  "tag": "section",
  "class": "section-footer-fashion",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand Tagline",
      "default": "Curated fashion for the modern wardrobe."
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link Column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Newsletter" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fashion Footer",
      "blocks": [
        { "type": "column", "settings": { "title": "Collections", "menu": "footer" } },
        { "type": "column", "settings": { "title": "Company", "menu": "footer" } },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
