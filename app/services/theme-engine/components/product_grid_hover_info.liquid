{%- comment -%}
  product_grid_hover_info.liquid — Ultra-Comprehensive Hover Specification Product Grid
  
  DESIGN PHILOSOPHY:
  An architectural product grid engineered for technical hardware and serialized instruments.
  Features secondary image hover transitions, slide-up specification inspection trays,
  real-time stock allocation badges, and an accessible Quick-View Lightbox Modal Dialog
  for rapid specification audit and add-to-cart acquisition.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --pgh-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --pgh-card-bg: {{ section.settings.card_bg_color | default: '#f8fafc' }};
    --pgh-text: {{ section.settings.text_color | default: '#0f172a' }};
    --pgh-muted: color-mix(in srgb, var(--pgh-text) 60%, transparent);
    --pgh-border: color-mix(in srgb, var(--pgh-text) 14%, transparent);
    --pgh-accent: {{ section.settings.accent_color | default: '#0f172a' }};
    --pgh-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --pgh-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --pgh-padding-top: clamp(3.5rem, 8vw, 6.5rem);
    --pgh-padding-bottom: clamp(3.5rem, 8vw, 6.5rem);
  }

  .pgh-section {
    background-color: var(--pgh-bg);
    color: var(--pgh-text);
    font-family: var(--pgh-font-body);
    padding: var(--pgh-padding-top) clamp(1.25rem, 4vw, 4rem) var(--pgh-padding-bottom);
    border-bottom: 1px solid var(--pgh-border);
    position: relative;
  }

  .pgh-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* Section Header */
  .pgh-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--pgh-border);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .pgh-head-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 680px;
  }
  .pgh-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--pgh-accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pgh-eyebrow::before {
    content: "";
    width: 20px;
    height: 2px;
    background: var(--pgh-accent);
  }
  .pgh-title {
    font-family: var(--pgh-font-head);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }
  .pgh-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--pgh-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Grid Layout */
  .pgh-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
  }
  @media (min-width: 640px) {
    .pgh-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .pgh-grid {
      grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr);
    }
  }

  /* Product Card */
  .pgh-card {
    background: var(--pgh-card-bg);
    border: 1px solid var(--pgh-border);
    border-radius: 32px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
    position: relative;
    group: true;
  }
  .pgh-card:hover {
    transform: translateY(-8px);
    border-color: color-mix(in srgb, var(--pgh-text) 45%, transparent);
    box-shadow: 0 25px 50px -15px rgba(0, 0, 0, 0.1);
  }

  /* Media Box with Hover Swap & Spec Drawer */
  .pgh-media-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: color-mix(in srgb, var(--pgh-text) 4%, transparent);
    overflow: hidden;
  }
  .pgh-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }
  .pgh-img-sec {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .pgh-card:hover .pgh-img-pri { opacity: 0; transform: scale(1.06); }
  .pgh-card:hover .pgh-img-sec { opacity: 1; transform: scale(1.06); }

  /* Stock Allocation Badge */
  .pgh-badge {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    z-index: 10;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    background: var(--pgh-text);
    color: var(--pgh-bg);
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
  }

  /* Slide-up Specification Tray */
  .pgh-spec-tray {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #ffffff;
    padding: 1.25rem 1.5rem;
    z-index: 15;
    transform: translateY(101%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }
  .pgh-card:hover .pgh-spec-tray {
    transform: translateY(0);
  }
  .pgh-spec-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .pgh-spec-lbl { font-size: 0.65rem; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 0.1em; }
  .pgh-spec-val { font-size: 0.82rem; font-weight: 700; color: #ffffff; font-family: var(--pgh-font-head); }

  /* Card Content */
  .pgh-content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    flex: 1;
  }
  .pgh-prod-title {
    font-family: var(--pgh-font-head);
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: var(--pgh-text);
  }
  .pgh-prod-price {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--pgh-accent);
  }
  .pgh-quick-btn {
    background: var(--pgh-text);
    color: var(--pgh-bg);
    font-weight: 700;
    font-size: 0.88rem;
    border: none;
    padding: 0.9rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .pgh-quick-btn:hover {
    background: var(--pgh-accent);
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* Quick-View Lightbox Modal */
  .pgh-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .pgh-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .pgh-modal {
    background: var(--pgh-card-bg);
    color: var(--pgh-text);
    border: 1px solid var(--pgh-border);
    border-radius: 36px;
    max-width: 880px;
    width: 100%;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    box-shadow: 0 40px 80px -15px rgba(0, 0, 0, 0.8);
    position: relative;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (min-width: 768px) {
    .pgh-modal {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .pgh-modal-overlay[data-open="true"] .pgh-modal {
    transform: scale(1);
  }
  .pgh-modal-img-col {
    background: color-mix(in srgb, var(--pgh-text) 5%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 380px;
  }
  .pgh-modal-img-col img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pgh-modal-info-col {
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .pgh-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: color-mix(in srgb, var(--pgh-text) 10%, transparent);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pgh-text);
    cursor: pointer;
    z-index: 20;
  }
</style>

<section class="pgh-section" id="pgh-section-{{ section.id }}" aria-labelledby="pgh-title-{{ section.id }}">
  <div class="pgh-container">
    
    <!-- Section Header -->
    <div class="pgh-header">
      <div class="pgh-head-text">
        {%- if section.settings.eyebrow != blank -%}
          <div class="pgh-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="pgh-title-{{ section.id }}" class="pgh-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="pgh-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    </div>

    <!-- Product Grid -->
    <div class="pgh-grid" role="list">
      {%- for block in section.blocks -%}
        <div class="pgh-card" role="listitem" data-src="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 }}{% endif %}" data-title="{{ block.settings.title | default: 'Monolith Series 04' }}" data-price="{{ block.settings.price | default: '$380.00' }}" data-w="{{ block.settings.spec_w | default: '2,150 g' }}" data-a="{{ block.settings.spec_a | default: '6.5°' }}" data-m="{{ block.settings.spec_m | default: 'Gasket' }}" {{ block.shopify_attributes }}>
          
          <div class="pgh-media-box">
            <span class="pgh-badge">{{ block.settings.badge | default: 'ALLOCATION OPEN' }}</span>
            
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'pgh-img pgh-img-pri', alt: block.settings.title }}
              {%- if block.settings.image_secondary != blank -%}
                {{ block.settings.image_secondary | image_url: width: 800 | image_tag: loading: 'lazy', class: 'pgh-img pgh-img-sec', alt: block.settings.title }}
              {%- else -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'pgh-img pgh-img-sec', alt: block.settings.title }}
              {%- endif -%}
            {%- else -%}
              <div style="width:100%;height:100%;background:#333;display:flex;align-items:center;justify-content:center;color:#888;font-weight:700;">Product {{ forloop.index }}</div>
            {%- endif -%}

            <!-- Slide-up Spec Tray -->
            <div class="pgh-spec-tray">
              <div class="pgh-spec-item">
                <span class="pgh-spec-lbl">Chassis Mass</span>
                <span class="pgh-spec-val">{{ block.settings.spec_w | default: '2,150 g' }}</span>
              </div>
              <div class="pgh-spec-item">
                <span class="pgh-spec-lbl">Typing Angle</span>
                <span class="pgh-spec-val">{{ block.settings.spec_a | default: '6.5°' }}</span>
              </div>
              <div class="pgh-spec-item">
                <span class="pgh-spec-lbl">Mount Type</span>
                <span class="pgh-spec-val">{{ block.settings.spec_m | default: 'Silicone Gasket' }}</span>
              </div>
            </div>
          </div>

          <div class="pgh-content">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;">
              <div>
                <h3 class="pgh-prod-title">{{ block.settings.title | default: 'Monolith Series 04' }}</h3>
                <span style="font-size:0.82rem;color:var(--pgh-muted);">Zürich Edition • CNC Aluminum</span>
              </div>
              <span class="pgh-prod-price">{{ block.settings.price | default: '$380.00' }}</span>
            </div>

            <button type="button" class="pgh-quick-btn">
              <span>Inspect & Acquire</span>
              <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.5;"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>

  <!-- Quick-View Lightbox Modal -->
  <div class="pgh-modal-overlay" id="pgh-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="pgh-modal">
      <button type="button" class="pgh-modal-close" id="pgh-modal-close-{{ section.id }}" aria-label="Close product quick view modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div class="pgh-modal-img-col">
        <img src="" id="pgh-modal-img" alt="Product quick view image">
      </div>

      <div class="pgh-modal-info-col">
        <div style="display:flex;flex-direction:column;gap:1rem;">
          <div style="display:flex;align-items:center;gap:0.6rem;">
            <span style="width:10px;height:10px;border-radius:50%;background:#10b981;"></span>
            <span style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.18em;color:var(--pgh-accent);">In Stock • Zero Delay</span>
          </div>

          <h3 id="pgh-modal-title" style="font-family:var(--pgh-font-head);font-size:2rem;margin:0;">Monolith Series 04</h3>
          <span id="pgh-modal-price" style="font-size:1.35rem;font-weight:700;color:var(--pgh-accent);">$380.00</span>
          
          <p style="font-size:0.95rem;color:var(--pgh-muted);line-height:1.6;margin:0;">Precision milled from aerospace aluminum in Zürich. Includes lifetime registration in the Swiss Atelier archive.</p>

          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem;background:color-mix(in srgb,var(--pgh-text) 5%,transparent);border:1px solid var(--pgh-border);border-radius:18px;padding:1rem;text-align:center;">
            <div>
              <span style="font-size:0.65rem;color:var(--pgh-muted);text-transform:uppercase;display:block;">Mass</span>
              <strong id="pgh-modal-w" style="font-size:0.9rem;color:var(--pgh-text);">2,150 g</strong>
            </div>
            <div>
              <span style="font-size:0.65rem;color:var(--pgh-muted);text-transform:uppercase;display:block;">Angle</span>
              <strong id="pgh-modal-a" style="font-size:0.9rem;color:var(--pgh-text);">6.5°</strong>
            </div>
            <div>
              <span style="font-size:0.65rem;color:var(--pgh-muted);text-transform:uppercase;display:block;">Mount</span>
              <strong id="pgh-modal-m" style="font-size:0.9rem;color:var(--pgh-text);">Gasket</strong>
            </div>
          </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:0.75rem;">
          <button type="button" class="pgh-quick-btn" style="padding:1.15rem;font-size:1rem;" onclick="alert('Item allocated and added to your shopping cart.');">
            <span>Acquire To Cart →</span>
          </button>
          <span style="font-size:0.75rem;color:var(--pgh-muted);text-align:center;">Complimentary DHL Express Air Global Delivery Included.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('pgh-section-' + sid);
    if (!sectionEl) return;

    // Quick View Lightbox Modal Controller
    var modalOverlay = document.getElementById('pgh-modal-' + sid);
    var modalClose = document.getElementById('pgh-modal-close-' + sid);
    if (modalOverlay && modalClose) {
      var imgEl = document.getElementById('pgh-modal-img');
      var titleEl = document.getElementById('pgh-modal-title');
      var priceEl = document.getElementById('pgh-modal-price');
      var wEl = document.getElementById('pgh-modal-w');
      var aEl = document.getElementById('pgh-modal-a');
      var mEl = document.getElementById('pgh-modal-m');

      var cards = sectionEl.querySelectorAll('.pgh-card');
      cards.forEach(function(card) {
        var btn = card.querySelector('.pgh-quick-btn');
        if (btn) {
          btn.addEventListener('click', function(e) {
            e.stopPropagation();
            var src = card.getAttribute('data-src');
            if (imgEl && src && src !== 'null' && src !== '') imgEl.src = src;
            else if (imgEl) imgEl.src = '';

            if (titleEl) titleEl.innerText = card.getAttribute('data-title') || 'Monolith Series 04';
            if (priceEl) priceEl.innerText = card.getAttribute('data-price') || '$380.00';
            if (wEl) wEl.innerText = card.getAttribute('data-w') || '2,150 g';
            if (aEl) aEl.innerText = card.getAttribute('data-a') || '6.5°';
            if (mEl) mEl.innerText = card.getAttribute('data-m') || 'Gasket';

            modalOverlay.setAttribute('data-open', 'true');
            modalOverlay.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
          });
        }
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Hover Specs Product Grid",
  "tag": "section",
  "class": "section-product-grid-hover-info",
  "max_blocks": 9,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0f172a"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Section Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Technical Specifications Grid"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Serialized Workstation Chassis"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Hover over any item to inspect its unibody CNC mass and typing angle, or launch quick-view for immediate acquisition."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Primary Photo"
        },
        {
          "type": "image_picker",
          "id": "image_secondary",
          "label": "Hover Swap Photo"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Stock Badge",
          "default": "ALLOCATION OPEN"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "Monolith Series 04"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price Display",
          "default": "$380.00"
        },
        {
          "type": "header",
          "content": "Hover Tray Specifications"
        },
        {
          "type": "text",
          "id": "spec_w",
          "label": "Chassis Mass (Weight)",
          "default": "2,150 g"
        },
        {
          "type": "text",
          "id": "spec_a",
          "label": "Typing Angle",
          "default": "6.5°"
        },
        {
          "type": "text",
          "id": "spec_m",
          "label": "Mount Type",
          "default": "Silicone Gasket"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hover Specs Product Grid",
      "blocks": [
        { "type": "product", "settings": { "title": "Monolith Series 04", "price": "$380.00" } },
        { "type": "product", "settings": { "title": "Titanium Desk Mat", "price": "$120.00" } },
        { "type": "product", "settings": { "title": "Acoustic Switch Pack", "price": "$65.00" } }
      ]
    }
  ]
}
{% endschema %}
