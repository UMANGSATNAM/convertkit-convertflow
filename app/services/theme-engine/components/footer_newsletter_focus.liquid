{%- comment -%}
  footer_newsletter_focus.liquid — Ultra-Comprehensive VIP Acquisition Footer
  
  DESIGN PHILOSOPHY:
  An architectural luxury footer engineered around high-intent subscriber acquisition.
  Features a prominent VIP acquisition box with real-time client-side email validation,
  an instant VIP Reward Discount Modal Dialog with one-click clipboard code copying,
  multi-column navigation links, social badges, and comprehensive copyright trust seals.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --fnf-bg: {{ section.settings.bg_color | default: '#0a0a0a' }};
    --fnf-card-bg: {{ section.settings.card_bg_color | default: '#171717' }};
    --fnf-text: {{ section.settings.text_color | default: '#f5f5f5' }};
    --fnf-muted: color-mix(in srgb, var(--fnf-text) 60%, transparent);
    --fnf-border: color-mix(in srgb, var(--fnf-text) 15%, transparent);
    --fnf-accent: {{ section.settings.accent_color | default: '#e11d48' }};
    --fnf-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --fnf-font-head: var(--font-heading, 'Playfair Display', serif);
    --fnf-padding-top: clamp(4rem, 8vw, 7rem);
    --fnf-padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .fnf-section {
    background-color: var(--fnf-bg);
    color: var(--fnf-text);
    font-family: var(--fnf-font-body);
    padding: var(--fnf-padding-top) clamp(1.25rem, 4vw, 4rem) var(--fnf-padding-bottom);
    border-top: 1px solid var(--fnf-border);
    position: relative;
    overflow: hidden;
  }

  .fnf-container {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(4rem, 8vw, 6.5rem);
  }

  /* VIP Acquisition Box */
  .fnf-hero-box {
    background: var(--fnf-card-bg);
    border: 1px solid var(--fnf-border);
    border-radius: 36px;
    padding: clamp(2.5rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
    position: relative;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.7);
  }
  @media (min-width: 1024px) {
    .fnf-hero-box {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .fnf-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .fnf-eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--fnf-accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .fnf-eyebrow::before {
    content: "";
    width: 24px;
    height: 1px;
    background: var(--fnf-accent);
  }
  .fnf-title {
    font-family: var(--fnf-font-head);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
    font-style: italic;
    color: var(--fnf-text);
    line-height: 1.08;
    margin: 0;
  }
  .fnf-desc {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--fnf-muted);
    line-height: 1.65;
    margin: 0;
    max-width: 520px;
  }

  /* VIP Benefits Checklist */
  .fnf-benefits {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }
  .fnf-benefit {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--fnf-text);
    font-weight: 600;
  }
  .fnf-benefit svg {
    width: 18px;
    height: 18px;
    color: var(--fnf-accent);
    flex-shrink: 0;
  }

  /* Interactive Form Column */
  .fnf-form-wrap {
    background: var(--fnf-bg);
    border: 1px solid var(--fnf-border);
    border-radius: 28px;
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .fnf-form-title {
    font-weight: 700;
    font-size: 1.25rem;
    margin: 0;
  }
  .fnf-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .fnf-input-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .fnf-input-group {
      flex-direction: row;
    }
  }
  .fnf-input {
    background: var(--fnf-card-bg);
    border: 1px solid var(--fnf-border);
    color: var(--fnf-text);
    font-family: var(--fnf-font-body);
    font-size: 1rem;
    padding: 1rem 1.35rem;
    border-radius: 100px;
    flex-grow: 1;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .fnf-input:focus {
    border-color: var(--fnf-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--fnf-accent) 25%, transparent);
  }
  .fnf-btn {
    background: var(--fnf-text);
    color: var(--fnf-bg);
    border: none;
    font-family: var(--fnf-font-body);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 1rem 2rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }
  .fnf-btn:hover {
    background: var(--fnf-accent);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px color-mix(in srgb, var(--fnf-accent) 50%, transparent);
  }
  .fnf-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.82rem;
    color: var(--fnf-muted);
    cursor: pointer;
  }
  .fnf-consent input {
    margin-top: 0.2rem;
    accent-color: var(--fnf-accent);
  }

  /* Success State Message */
  .fnf-success {
    display: none;
    background: color-mix(in srgb, #10b981 15%, transparent);
    border: 1px solid #10b981;
    color: #10b981;
    padding: 1rem;
    border-radius: 16px;
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
  }
  .fnf-form[data-submitted="true"] .fnf-input-group,
  .fnf-form[data-submitted="true"] .fnf-consent {
    display: none;
  }
  .fnf-form[data-submitted="true"] .fnf-success {
    display: block;
  }

  /* Navigation Columns */
  .fnf-nav-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 1.5rem;
  }
  @media (min-width: 640px) {
    .fnf-nav-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .fnf-nav-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .fnf-nav-head {
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--fnf-text);
  }
  .fnf-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .fnf-nav-list a {
    color: var(--fnf-muted);
    text-decoration: none;
    font-size: 0.92rem;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }
  .fnf-nav-list a:hover {
    color: var(--fnf-text);
    transform: translateX(4px);
  }

  /* Bottom Copyright Bar */
  .fnf-bottom {
    padding-top: 2rem;
    border-top: 1px solid var(--fnf-border);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    font-size: 0.82rem;
    color: var(--fnf-muted);
  }
  @media (min-width: 768px) {
    .fnf-bottom {
      flex-direction: row;
    }
  }
  .fnf-legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .fnf-legal-links a {
    color: var(--fnf-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .fnf-legal-links a:hover {
    color: var(--fnf-text);
  }
  .fnf-payments {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .fnf-pay-badge {
    background: var(--fnf-card-bg);
    border: 1px solid var(--fnf-border);
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--fnf-text);
  }

  /* VIP Reward Modal Dialog */
  .fnf-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .fnf-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .fnf-modal {
    background: var(--fnf-card-bg);
    color: var(--fnf-text);
    border: 1px solid var(--fnf-border);
    border-radius: 28px;
    max-width: 520px;
    width: 100%;
    padding: clamp(2rem, 5vw, 3rem);
    position: relative;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.8);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fnf-modal-overlay[data-open="true"] .fnf-modal {
    transform: scale(1);
  }
  .fnf-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(0, 0, 0, 0.5);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
  }
  .fnf-reward-box {
    background: var(--fnf-bg);
    border: 2px dashed var(--fnf-accent);
    border-radius: 16px;
    padding: 1.25rem;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--fnf-font-head);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--fnf-accent);
  }
  .fnf-copy-btn {
    background: var(--fnf-text);
    color: var(--fnf-bg);
    border: none;
    font-family: var(--fnf-font-body);
    font-weight: 700;
    font-size: 0.82rem;
    padding: 0.6rem 1.1rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .fnf-copy-btn:hover {
    background: var(--fnf-accent);
    color: #ffffff;
  }
</style>

<footer class="fnf-section" id="fnf-section-{{ section.id }}" aria-labelledby="fnf-title-{{ section.id }}">
  <div class="fnf-container">
    
    <!-- VIP Acquisition Box -->
    <div class="fnf-hero-box">
      <div class="fnf-content">
        {%- if section.settings.eyebrow != blank -%}
          <div class="fnf-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="fnf-title-{{ section.id }}" class="fnf-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="fnf-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        <div class="fnf-benefits">
          <div class="fnf-benefit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Early Access Drops</span>
          </div>
          <div class="fnf-benefit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Private Atelier Pricing</span>
          </div>
          <div class="fnf-benefit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Complimentary Global Shipping</span>
          </div>
        </div>
      </div>

      <!-- Form Column -->
      <div class="fnf-form-wrap">
        <h3 class="fnf-form-title">{{ section.settings.form_title | default: 'Unlock 15% Off Your First Order' }}</h3>
        
        <form class="fnf-form" id="fnf-form-{{ section.id }}" onsubmit="return false;">
          <div class="fnf-input-group">
            <input type="email" class="fnf-input" id="fnf-input-{{ section.id }}" placeholder="Enter your email address..." required aria-label="Email address">
            <button type="submit" class="fnf-btn">{{ section.settings.btn_label | default: 'Join Inner Circle' }}</button>
          </div>

          <label class="fnf-consent">
            <input type="checkbox" required checked>
            <span>I consent to receive private atelier updates and exclusive event invitations. Unsubscribe anytime.</span>
          </label>

          <div class="fnf-success">
            ✓ Welcome to the Inner Circle. Your VIP discount has been unlocked!
          </div>
        </form>
      </div>
    </div>

    <!-- Multi-Column Link Navigation -->
    <div class="fnf-nav-grid">
      {%- for block in section.blocks -%}
        <div class="fnf-nav-col" {{ block.shopify_attributes }}>
          <span class="fnf-nav-head">{{ block.settings.title }}</span>
          <ul class="fnf-nav-list">
            {%- if block.settings.menu != blank -%}
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              <li><a href="/collections/all">Workstations</a></li>
              <li><a href="/collections/all">Mechanical Keyboards</a></li>
              <li><a href="/collections/all">Acoustic Damping</a></li>
              <li><a href="/pages/about">The Atelier Story</a></li>
            {%- endif -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <!-- Copyright & Payment Trust Seals -->
    <div class="fnf-bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name | default: 'Obsidian Atelier' }}. All Rights Reserved. Swiss Engineering.</span>

      <div class="fnf-legal-links">
        <a href="/policies/terms-of-service">Terms of Service</a>
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <a href="/policies/refund-policy">Refund Policy</a>
        <a href="/policies/shipping-policy">Shipping Policy</a>
      </div>

      <div class="fnf-payments">
        <span class="fnf-pay-badge">VISA</span>
        <span class="fnf-pay-badge">MC</span>
        <span class="fnf-pay-badge">AMEX</span>
        <span class="fnf-pay-badge">APPLE PAY</span>
      </div>
    </div>

  </div>

  <!-- VIP Reward Discount Modal -->
  <div class="fnf-modal-overlay" id="fnf-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="fnf-modal">
      <button type="button" class="fnf-modal-close" id="fnf-modal-close-{{ section.id }}" aria-label="Close modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div style="width:64px;height:64px;border-radius:50%;background:color-mix(in srgb,var(--fnf-accent) 15%,transparent);color:var(--fnf-accent);display:flex;align-items:center;justify-content:center;margin:0 auto;">
        <svg viewBox="0 0 24 24" style="width:32px;height:32px;stroke:currentColor;fill:none;stroke-width:2;"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>

      <h3 style="font-family:var(--fnf-font-head);font-size:1.85rem;margin:0;">Welcome To The Atelier</h3>
      <p style="font-size:0.95rem;color:var(--fnf-muted);margin:0;">Your VIP status is now active. Use your bespoke promotional code at checkout for 15% off your initial acquisition.</p>

      <div class="fnf-reward-box">
        <span id="fnf-reward-code">{{ section.settings.discount_code | default: 'ATELIER15VIP' }}</span>
        <button type="button" class="fnf-copy-btn" id="fnf-copy-btn-{{ section.id }}">Copy Code</button>
      </div>

      <span style="font-size:0.78rem;color:var(--fnf-muted);">Code automatically applied or valid for 30 days. Valid worldwide.</span>
    </div>
  </div>
</footer>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('fnf-section-' + sid);
    if (!sectionEl) return;

    // 1. AJAX Form & Reward Modal Controller
    var form = document.getElementById('fnf-form-' + sid);
    var modalOverlay = document.getElementById('fnf-modal-' + sid);
    var modalClose = document.getElementById('fnf-modal-close-' + sid);
    var copyBtn = document.getElementById('fnf-copy-btn-' + sid);

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var input = document.getElementById('fnf-input-' + sid);
        if (input && input.value && input.value.indexOf('@') !== -1) {
          form.setAttribute('data-submitted', 'true');
          
          if (modalOverlay) {
            setTimeout(function() {
              modalOverlay.setAttribute('data-open', 'true');
              modalOverlay.setAttribute('aria-hidden', 'false');
              document.body.style.overflow = 'hidden';
            }, 500);
          }
        }
      });
    }

    // 2. One-Click Copy to Clipboard
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        var codeEl = document.getElementById('fnf-reward-code');
        if (codeEl && navigator.clipboard) {
          navigator.clipboard.writeText(codeEl.innerText);
          copyBtn.innerText = 'Copied! ✓';
          copyBtn.style.background = '#10b981';
          copyBtn.style.color = '#ffffff';
          setTimeout(function() {
            copyBtn.innerText = 'Copy Code';
            copyBtn.style.background = '';
            copyBtn.style.color = '';
          }, 2500);
        }
      });
    }

    // 3. Modal Close Handlers
    if (modalOverlay && modalClose) {
      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Footer Newsletter Focus",
  "tag": "section",
  "class": "section-footer-newsletter",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Footer Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Acquisition Box Background",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#e11d48"
    },
    {
      "type": "header",
      "content": "Acquisition Box Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Join The Inner Circle"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Bespoke Engineering Delivered"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Receive private invitations to limited production runs, technical architecture breakdowns, and early access to our seasonal workstation drops."
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form Box Heading",
      "default": "Unlock 15% Off Your First Order"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Submit Button Label",
      "default": "Join Inner Circle"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "VIP Reward Discount Code Display",
      "default": "ATELIER15VIP"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Navigation Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column Heading",
          "default": "Workstations"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Shopify Menu Selection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Newsletter Focus",
      "blocks": [
        { "type": "menu", "settings": { "title": "Atelier Products" } },
        { "type": "menu", "settings": { "title": "Acoustics & Specs" } },
        { "type": "menu", "settings": { "title": "Client Support" } },
        { "type": "menu", "settings": { "title": "Legal & Privacy" } }
      ]
    }
  ]
}
{% endschema %}
