{%- comment -%}
  content_features_grid.liquid — Ultra-Comprehensive Architectural Features Grid
  
  DESIGN PHILOSOPHY:
  An architectural feature grid engineered to showcase core hardware innovations.
  Features custom iconography, interactive hover elevation physics, technical specification badges,
  and an accessible Technical Deep-Dive Lightbox Modal Dialog allowing clients to review
  unibody CNC tolerances and acoustic dampening schematics.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --cfg-bg: {{ section.settings.bg_color | default: '#0a0a0a' }};
    --cfg-card-bg: {{ section.settings.card_bg_color | default: '#171717' }};
    --cfg-text: {{ section.settings.text_color | default: '#f5f5f5' }};
    --cfg-muted: color-mix(in srgb, var(--cfg-text) 60%, transparent);
    --cfg-border: color-mix(in srgb, var(--cfg-text) 14%, transparent);
    --cfg-accent: {{ section.settings.accent_color | default: '#38bdf8' }};
    --cfg-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --cfg-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --cfg-padding-top: clamp(4rem, 8vw, 7rem);
    --cfg-padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .cfg-section {
    background-color: var(--cfg-bg);
    color: var(--cfg-text);
    font-family: var(--cfg-font-body);
    padding: var(--cfg-padding-top) clamp(1.25rem, 4vw, 4rem) var(--cfg-padding-bottom);
    border-bottom: 1px solid var(--cfg-border);
    position: relative;
  }

  .cfg-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* Section Header */
  .cfg-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--cfg-border);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .cfg-head-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 680px;
  }
  .cfg-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--cfg-accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cfg-eyebrow::before {
    content: "";
    width: 20px;
    height: 2px;
    background: var(--cfg-accent);
  }
  .cfg-title {
    font-family: var(--cfg-font-head);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }
  .cfg-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--cfg-muted);
    line-height: 1.6;
    margin: 0;
  }
  .cfg-spec-btn {
    background: var(--cfg-text);
    color: var(--cfg-bg);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.9rem 1.85rem;
    border-radius: 100px;
    border: none;
    cursor: pointer;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cfg-spec-btn:hover {
    background: var(--cfg-accent);
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* Features Grid */
  .cfg-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
  }
  @media (min-width: 640px) {
    .cfg-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .cfg-grid {
      grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr);
    }
  }

  /* Feature Card */
  .cfg-card {
    background: var(--cfg-card-bg);
    border: 1px solid var(--cfg-border);
    border-radius: 32px;
    padding: clamp(2rem, 4vw, 2.75rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
    position: relative;
  }
  .cfg-card:hover {
    transform: translateY(-8px);
    border-color: color-mix(in srgb, var(--cfg-text) 45%, transparent);
    box-shadow: 0 25px 50px -15px rgba(0, 0, 0, 0.7);
  }

  .cfg-card-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .cfg-icon-box {
    width: 60px;
    height: 60px;
    border-radius: 18px;
    background: color-mix(in srgb, var(--cfg-text) 6%, transparent);
    border: 1px solid var(--cfg-border);
    color: var(--cfg-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease;
  }
  .cfg-card:hover .cfg-icon-box {
    transform: scale(1.1) rotate(6deg);
    background: var(--cfg-accent);
    color: #ffffff;
  }
  .cfg-icon-box svg { width: 28px; height: 28px; stroke: currentColor; stroke-width: 2; fill: none; }

  .cfg-badge {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    background: color-mix(in srgb, var(--cfg-text) 8%, transparent);
    color: var(--cfg-muted);
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
  }

  .cfg-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cfg-feat-title { font-family: var(--cfg-font-head); font-size: 1.4rem; font-weight: 700; margin: 0; color: #ffffff; }
  .cfg-feat-desc { font-size: 0.95rem; color: var(--cfg-muted); line-height: 1.65; margin: 0; }

  .cfg-card-foot {
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--cfg-text) 8%, transparent);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .cfg-more-btn {
    background: transparent;
    border: none;
    color: var(--cfg-accent);
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0;
    transition: gap 0.2s ease;
  }
  .cfg-more-btn:hover { gap: 0.6rem; }

  /* Technical Deep-Dive Lightbox Modal */
  .cfg-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .cfg-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .cfg-modal {
    background: var(--cfg-card-bg);
    color: var(--cfg-text);
    border: 1px solid var(--cfg-border);
    border-radius: 36px;
    max-width: 680px;
    width: 100%;
    padding: clamp(2.5rem, 6vw, 3.5rem);
    position: relative;
    box-shadow: 0 40px 80px -15px rgba(0, 0, 0, 0.9);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transform: scale(0.95);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cfg-modal-overlay[data-open="true"] .cfg-modal {
    transform: scale(1);
  }
  .cfg-modal-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: color-mix(in srgb, var(--cfg-text) 10%, transparent);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cfg-text);
    cursor: pointer;
  }
</style>

<section class="cfg-section" id="cfg-section-{{ section.id }}" aria-labelledby="cfg-title-{{ section.id }}">
  <div class="cfg-container">
    
    <!-- Section Header -->
    <div class="cfg-header">
      <div class="cfg-head-text">
        {%- if section.settings.eyebrow != blank -%}
          <div class="cfg-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="cfg-title-{{ section.id }}" class="cfg-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="cfg-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      <button type="button" class="cfg-spec-btn" id="cfg-audit-btn-{{ section.id }}">
        <span>Audit Engineering Standards</span>
        <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.5;"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </button>
    </div>

    <!-- Features Grid -->
    <div class="cfg-grid" role="list">
      {%- for block in section.blocks -%}
        <div class="cfg-card" role="listitem" data-title="{{ block.settings.title | default: 'Unibody CNC Aluminum' }}" data-desc="{{ block.settings.desc | default: 'Milled from a single block of 6063 aerospace aluminum with 0.01mm tolerance.' }}" data-badge="{{ block.settings.badge | default: 'CNC VERIFIED' }}" {{ block.shopify_attributes }}>
          
          <div class="cfg-card-head">
            <div class="cfg-icon-box">
              <svg viewBox="0 0 24 24"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
            </div>
            <span class="cfg-badge">{{ block.settings.badge | default: 'CNC VERIFIED • 0.01mm' }}</span>
          </div>

          <div class="cfg-card-body">
            <h3 class="cfg-feat-title">{{ block.settings.title | default: 'Unibody CNC Aluminum' }}</h3>
            <p class="cfg-feat-desc">{{ block.settings.desc | default: 'Milled from a single block of 6063 aerospace aluminum. Eliminates structural flex and auditory resonance.' }}</p>
          </div>

          <div class="cfg-card-foot">
            <span style="font-size:0.78rem;color:var(--cfg-muted);text-transform:uppercase;letter-spacing:0.1em;">Specification 0{{ forloop.index }}</span>
            <button type="button" class="cfg-more-btn">
              <span>Inspect Spec</span>
              <span>→</span>
            </button>
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>

  <!-- Technical Deep-Dive Lightbox Modal -->
  <div class="cfg-modal-overlay" id="cfg-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="cfg-modal">
      <button type="button" class="cfg-modal-close" id="cfg-modal-close-{{ section.id }}" aria-label="Close feature specification modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div style="display:flex;align-items:center;gap:0.6rem;">
        <span style="width:10px;height:10px;border-radius:50%;background:var(--cfg-accent);"></span>
        <span id="cfg-modal-badge" style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.18em;color:var(--cfg-accent);">CNC Verified • 0.01mm Tolerance</span>
      </div>

      <h3 id="cfg-modal-title" style="font-family:var(--cfg-font-head);font-size:2rem;margin:0;color:#ffffff;">Unibody CNC Aluminum</h3>
      
      <p id="cfg-modal-desc" style="font-size:1rem;color:var(--cfg-muted);line-height:1.65;margin:0;">Milled from a single block of 6063 aerospace aluminum. Eliminates structural flex and auditory resonance while providing a heavy, stable foundation.</p>

      <div style="background:color-mix(in srgb,var(--cfg-text) 5%,transparent);border:1px solid var(--cfg-border);border-radius:24px;padding:1.5rem;display:flex;flex-direction:column;gap:0.75rem;">
        <strong style="font-size:1rem;color:#ffffff;font-family:var(--cfg-font-head);">Zürich Engineering Assurance:</strong>
        <span style="font-size:0.88rem;color:var(--cfg-muted);">• 100% inspected via coordinate measuring machines (CMM)</span>
        <span style="font-size:0.88rem;color:var(--cfg-muted);">• Sub-0.2ms high-frequency acoustic decay rate</span>
        <span style="font-size:0.88rem;color:var(--cfg-muted);">• Covered under the Swiss Lifetime Archive Warranty</span>
      </div>

      <button type="button" class="cfg-spec-btn" style="justify-content:center;width:100%;margin-top:0.5rem;" onclick="document.getElementById('cfg-modal-close-{{ section.id }}').click();">Return To Features Grid</button>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('cfg-section-' + sid);
    if (!sectionEl) return;

    // Lightbox Modal Controller
    var modalOverlay = document.getElementById('cfg-modal-' + sid);
    var modalClose = document.getElementById('cfg-modal-close-' + sid);
    var auditBtn = document.getElementById('cfg-audit-btn-' + sid);

    if (modalOverlay && modalClose) {
      var titleEl = document.getElementById('cfg-modal-title');
      var descEl = document.getElementById('cfg-modal-desc');
      var badgeEl = document.getElementById('cfg-modal-badge');

      var cards = sectionEl.querySelectorAll('.cfg-card');
      cards.forEach(function(card) {
        var btn = card.querySelector('.cfg-more-btn');
        if (btn) {
          btn.addEventListener('click', function(e) {
            e.stopPropagation();
            if (titleEl) titleEl.innerText = card.getAttribute('data-title') || 'Unibody CNC Aluminum';
            if (descEl) descEl.innerText = card.getAttribute('data-desc') || 'Milled from aerospace aluminum.';
            if (badgeEl) badgeEl.innerText = card.getAttribute('data-badge') || 'CNC Verified';

            modalOverlay.setAttribute('data-open', 'true');
            modalOverlay.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
          });
        }
      });

      if (auditBtn) {
        auditBtn.addEventListener('click', function() {
          if (titleEl) titleEl.innerText = 'Zürich Architectural Standards';
          if (descEl) descEl.innerText = 'All instruments are built under strict ISO 9001 and Swiss watchmaking quality control tolerances. We reject lightweight plastic manufacturing.';
          if (badgeEl) badgeEl.innerText = '100% Swiss Quality Audited';

          modalOverlay.setAttribute('data-open', 'true');
          modalOverlay.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      }

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Features Grid",
  "tag": "section",
  "class": "section-content-features-grid",
  "max_blocks": 9,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#38bdf8"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Section Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Engineering Architecture"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Core Hardware Innovations"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Every component is engineered from first principles in Zürich to eliminate auditory fatigue and mechanical wear."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Text",
          "default": "CNC VERIFIED • 0.01mm"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Heading",
          "default": "Unibody CNC Aluminum"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Feature Description",
          "default": "Milled from a single block of 6063 aerospace aluminum. Eliminates structural flex and auditory resonance."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features Grid",
      "blocks": [
        { "type": "feature", "settings": { "title": "Unibody CNC Aluminum", "badge": "CNC VERIFIED • 0.01mm" } },
        { "type": "feature", "settings": { "title": "Silicone Gasket Mount", "badge": "ACOUSTIC ISOLATION" } },
        { "type": "feature", "settings": { "title": "6.5° Fixed Geometry", "badge": "SWISS ORTHOPEDIC" } }
      ]
    }
  ]
}
{% endschema %}
