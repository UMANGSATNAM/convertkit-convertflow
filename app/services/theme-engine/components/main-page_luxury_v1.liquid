{%- comment -%}
  sections/main-page_luxury_v1.liquid
  
  CONVERSION PSYCHOLOGY & ARCHITECTURE:
  1. COGNITIVE FLUENCY & READING RHYTHM -- In luxury e-commerce, generic text
     pages (About Us, Brand Heritage, Policies) often suffer from high drop-off.
     We structure long-form content using magazine-grade editorial typography,
     drop-caps, pull-quotes, and generous line-spacing (1.8) to maintain scroll depth.
  2. STICKY TABLE OF CONTENTS -- Gives users cognitive control and immediate
     scannability across complex legal, sustainability, or heritage documents.
  3. INLINE CONVERSION ANCHORING -- Prevents dead-end informational pages by
     embedding a high-end concierge booking and collection discovery block
     directly at the conclusion of the reading flow.
  4. ZERO EMOJI POLICY -- Strict editorial ASCII typography [ LIKE THIS ] for all
     navigation pills and callouts.
{%- endcomment -%}

<style>
  .lx-page {
    background: var(--page-bg, #0a0a0a);
    color: var(--page-color, #f5f5f5);
    padding: clamp(3rem, 6vw, 7rem) 1.5rem;
    font-family: var(--font-body, sans-serif);
    border-bottom: 1px solid rgba(201, 169, 110, 0.15);
  }

  .lx-page__inner {
    max-width: var(--max-width, 1300px);
    margin: 0 auto;
  }

  /* Header Section */
  .lx-page__header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 5rem auto;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 3.5rem;
  }

  .lx-page__subtitle {
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #c9a96e;
    margin-bottom: 0.75rem;
    display: block;
  }

  .lx-page__title {
    font-family: var(--font-heading, serif);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
    margin: 0;
    line-height: 1.15;
    color: #fff;
  }

  /* Magazine Layout: Sticky TOC Left, Editorial Content Right */
  .lx-page__layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: start;
  }

  @media (max-width: 968px) {
    .lx-page__layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  /* Sticky Table of Contents Sidebar */
  .lx-page__sidebar {
    position: sticky;
    top: 6rem;
    background: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 2rem;
  }

  @media (max-width: 968px) {
    .lx-page__sidebar {
      position: relative;
      top: 0;
    }
  }

  .lx-page__sidebar-title {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9a96e;
    margin: 0 0 1.25rem 0;
    font-weight: 600;
    border-bottom: 1px solid rgba(201, 169, 110, 0.2);
    padding-bottom: 0.75rem;
  }

  .lx-page__toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .lx-page__toc-link {
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.2s ease, padding-left 0.2s ease;
    display: block;
  }

  .lx-page__toc-link:hover,
  .lx-page__toc-link.is-active {
    color: #c9a96e;
    padding-left: 6px;
  }

  .lx-page__sidebar-note {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
    line-height: 1.6;
  }

  /* Main Editorial Prose Body */
  .lx-page__content {
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.8);
    max-width: 800px;
  }

  /* Editorial Styling Elements within Shopify RTE */
  .lx-page__content p {
    margin: 0 0 2rem 0;
  }

  .lx-page__content p:first-of-type::first-letter {
    font-family: var(--font-heading, serif);
    font-size: 4rem;
    float: left;
    line-height: 0.8;
    margin: 0.1rem 0.75rem 0 0;
    color: #c9a96e;
  }

  .lx-page__content h2,
  .lx-page__content h3 {
    font-family: var(--font-heading, serif);
    color: #fff;
    font-weight: 400;
    margin: 3.5rem 0 1.25rem 0;
    line-height: 1.3;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .lx-page__content h2 { font-size: 2rem; }
  .lx-page__content h3 { font-size: 1.5rem; }

  .lx-page__content blockquote {
    margin: 3rem 0;
    padding: 2.5rem 3rem;
    background: rgba(201, 169, 110, 0.03);
    border-left: 2px solid #c9a96e;
    font-family: var(--font-heading, serif);
    font-size: 1.4rem;
    font-style: italic;
    color: #fff;
    line-height: 1.6;
  }

  .lx-page__content ul,
  .lx-page__content ol {
    margin: 0 0 2.5rem 0;
    padding-left: 1.5rem;
  }

  .lx-page__content li {
    margin-bottom: 0.75rem;
    position: relative;
  }

  .lx-page__content ul {
    list-style: none;
    padding-left: 0;
  }

  .lx-page__content ul li {
    padding-left: 1.5rem;
  }

  .lx-page__content ul li::before {
    content: "*";
    position: absolute;
    left: 0;
    color: #c9a96e;
  }

  .lx-page__content a {
    color: #c9a96e;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: rgba(201, 169, 110, 0.4);
    transition: text-decoration-color 0.2s ease;
  }

  .lx-page__content a:hover {
    text-decoration-color: #c9a96e;
  }

  /* Inline Conversion Footer CTA Block */
  .lx-page__cta-footer {
    margin-top: 5rem;
    padding: 3.5rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(201, 169, 110, 0.3);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .lx-page__cta-badge {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9a96e;
  }

  .lx-page__cta-title {
    font-family: var(--font-heading, serif);
    font-size: 2rem;
    color: #fff;
    margin: 0;
  }

  .lx-page__cta-desc {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.7);
    max-width: 550px;
    margin: 0;
  }

  .lx-page__cta-btn {
    background: #c9a96e;
    color: #080808;
    border: none;
    padding: 1.1rem 2.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.3s ease, color 0.3s ease;
    margin-top: 0.5rem;
  }

  .lx-page__cta-btn:hover {
    background: #fff;
    color: #000;
  }
</style>

<section
  class="lx-page"
  data-section-id="{{ section.id }}"
  data-section-type="main-page">
  
  <div class="lx-page__inner">
    {%- comment -%} Header {%- endcomment -%}
    <div class="lx-page__header">
      <span class="lx-page__subtitle">{{ section.settings.subtitle | default: "[ SOVEREIGN DOCUMENTATION ]" }}</span>
      <h1 class="lx-page__title">{{ page.title }}</h1>
    </div>

    {%- comment -%} Magazine Editorial Layout {%- endcomment -%}
    <div class="lx-page__layout">
      
      {%- comment -%} Left: Sticky TOC Sidebar {%- endcomment -%}
      <aside class="lx-page__sidebar" aria-label="Table of Contents">
        <h2 class="lx-page__sidebar-title">[ TABLE OF CONTENTS ]</h2>
        <ul class="lx-page__toc-list" data-toc-list>
          <li><a href="#section-top" class="lx-page__toc-link is-active">-&gt; Overview & Preamble</a></li>
        </ul>

        <div class="lx-page__sidebar-note">
          Need bespoke clarification or legal translation of our sovereign policies? Connect with our private concierge team.
          <br><br>
          <a href="/contact" style="color: #c9a96e; text-decoration: underline;">[ CONTACT CONCIERGE ]</a>
        </div>
      </aside>

      {%- comment -%} Right: Editorial Prose Body {%- endcomment -%}
      <div class="lx-page__content" id="section-top" data-editorial-body>
        {%- if page.content != blank -%}
          {{ page.content }}
        {%- else -%}
          {%- comment -%} High-End Editorial Fallback Content {%- endcomment -%}
          <p>
            True luxury is not merely an aesthetic; it is an uncompromising philosophy of sovereign craftsmanship, institutional transparency, and enduring heirloom value. Originating from our private ateliers, every creation represents the synthesis of centuries-old Indian metallurgical artistry with modern micro-precision engineering.
          </p>

          <h2 id="section-heritage">Our Sovereign Heritage</h2>
          <p>
            In an age dominated by industrial mass production and transient retail trends, we remain steadfast in our devotion to slow luxury. Our master goldsmiths spend upwards of 140 hours sculpting individual wax maquettes, custom-alloying virgin gold, and setting conflict-free diamonds under 20x stereoscopic magnification.
          </p>

          <blockquote>
            "We do not create for the season; we sculpt for the century. An heirloom is a sacred bridge connecting the ancestors of yesterday with the generations of tomorrow."
          </blockquote>

          <h2 id="section-sustainability">Ethical Provenance & Sustainability</h2>
          <p>
            Uncompromising beauty requires uncompromising ethics. We adhere strictly to the Kimberley Process and World Jewellery Confederation guidelines, ensuring that 100% of our natural diamonds and gemstones originate from certified conflict-free mines. Furthermore, our ateliers operate on a zero-waste closed loop, recycling all precious metal filings and refining them back to 24K purity.
          </p>

          <h3 id="section-standards">The Four Pillars of Our Charter</h3>
          <ul>
            <li><strong>BIS Hallmarked Fineness:</strong> Every gold creation is independently assayed and laser-inscribed with a unique 6-digit HUID code by the Bureau of Indian Standards.</li>
            <li><strong>GIA & IGI Diamond Grading:</strong> All solitaires exceeding 0.30 carats are accompanied by physical laboratory certificates and laser-engraved girdle serial numbers.</li>
            <li><strong>Sovereign Client Privacy:</strong> We maintain an inviolable confidentiality protocol; client identities and bespoke commissions are never disclosed.</li>
            <li><strong>Heirloom Lifetime Exchange:</strong> We offer 100% exchange value on prevailing gold rates across all our creations in perpetuity.</li>
          </ul>

          <h2 id="section-custodianship">White-Glove Custodianship</h2>
          <p>
            Acquiring one of our creations marks the initiation of a lifelong relationship. As a registered custodian, you receive complimentary annual maintenance, including deep ultrasonic cleaning, steam buffing, and microscopic prong security inspections across our global flagship boutiques.
          </p>
        {%- endif -%}

        {%- comment -%} Inline Conversion Footer {%- endcomment -%}
        {%- if section.settings.show_cta -%}
          <div class="lx-page__cta-footer">
            <span class="lx-page__cta-badge">{{ section.settings.cta_badge | default: "[ EXPERIENCE THE CREATIONS ]" }}</span>
            <h3 class="lx-page__cta-title">{{ section.settings.cta_title | default: "Request a Private Salon Viewing" }}</h3>
            <p class="lx-page__cta-desc">
              {{ section.settings.cta_desc | default: "Connect with our senior gemologists for a curated champagne consultation in our flagship suites or via high-definition virtual broadcast." }}
            </p>
            <a href="{{ section.settings.cta_link | default: '/pages/book-appointment' }}" class="lx-page__cta-btn">
              {{ section.settings.cta_btn_text | default: "[ BOOK VIP CONCIERGE ]" }}
            </a>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<script>
  (function() {
    const container = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!container) return;

    const tocList = container.querySelector('[data-toc-list]');
    const contentBody = container.querySelector('[data-editorial-body]');

    if (!tocList || !contentBody) return;

    // Automatically generate Table of Contents from H2 and H3 tags inside content
    const headings = contentBody.querySelectorAll('h2, h3');
    if (headings.length > 0) {
      tocList.innerHTML = ''; // Clear fallback

      headings.forEach((heading, idx) => {
        if (!heading.id) {
          heading.id = 'editorial-section-' + idx;
        }

        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = '#' + heading.id;
        a.className = 'lx-page__toc-link' + (idx === 0 ? ' is-active' : '');
        a.textContent = (heading.tagName === 'H2' ? '-> ' : '   * ') + heading.textContent.trim();

        a.addEventListener('click', function(e) {
          e.preventDefault();
          const target = document.getElementById(heading.id);
          if (target) {
            window.scrollTo({
              top: target.offsetTop - 100,
              behavior: 'smooth'
            });
            tocList.querySelectorAll('.lx-page__toc-link').forEach(link => link.classList.remove('is-active'));
            a.classList.add('is-active');
          }
        });

        li.appendChild(a);
        tocList.appendChild(li);
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Main Page (Luxury)",
  "tag": "section",
  "class": "section-main-page",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Header Subtitle",
      "default": "[ SOVEREIGN DOCUMENTATION ]"
    },
    {
      "type": "header",
      "content": "Inline Conversion Callout"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show Footer Concierge CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_badge",
      "label": "CTA Badge",
      "default": "[ EXPERIENCE THE CREATIONS ]"
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "CTA Title",
      "default": "Request a Private Salon Viewing"
    },
    {
      "type": "textarea",
      "id": "cta_desc",
      "label": "CTA Description",
      "default": "Connect with our senior gemologists for a curated champagne consultation in our flagship suites or via high-definition virtual broadcast."
    },
    {
      "type": "text",
      "id": "cta_btn_text",
      "label": "CTA Button Text",
      "default": "[ BOOK VIP CONCIERGE ]"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    }
  ],
  "presets": [
    {
      "name": "Main Page (Luxury)"
    }
  ]
}
{% endschema %}
