            <span class="su__b-info">01. 5% Ceramide Barrier Repair Booster Vial</span>
            <button type="button" class="su__b-add" data-boost="600" data-name="Ceramide Booster">[+ ADD &bull; RS. 600 ]</button>
          </div>
          <div class="su__booster-row">
            <span class="su__b-info">02. Micro-Molecular Hyaluronic Hydrating Shield</span>
            <button type="button" class="su__b-add" data-boost="800" data-name="Hyaluronic Shield">[+ ADD &bull; RS. 800 ]</button>
          </div>
        </div>
      </div>

      <!-- Right: Financial Comparison & Summary -->
      <div class="su__summary-card">
        <div>
          <h3 class="su__sum-head">[ REPLENISHMENT BENEFIT ANALYSIS ]</h3>

          <table class="su__compare-table">
            <thead>
              <tr>
                <th>[ FEATURE ]</th>
                <th>[ ONE-TIME ]</th>
                <th>[ AUTO-REPLENISH ]</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Bottle Investment</td>
                <td>RS. 2,400</td>
                <td>RS. 1,920 (20% Off)</td>
              </tr>
              <tr>
                <td>Shipping Protocol</td>
                <td>RS. 150 Standard</td>
                <td>FREE Express</td>
              </tr>
              <tr>
                <td>Stock Allocation</td>
                <td>Subject to Waitlist</td>
                <td>Guaranteed Reserved</td>
              </tr>
              <tr>
                <td>Luxury Samples</td>
                <td>None Included</td>
                <td>3 Vials Per Refill</td>
              </tr>
              <tr>
                <td>Commitment</td>
                <td>Single Order</td>
                <td>Skip / Cancel 1-Click</td>
              </tr>
            </tbody>
