</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var optionRows = section.querySelectorAll('.su__option-row');
    var cadBtns = section.querySelectorAll('[data-cad-grid] .su__cad-btn');
    var cadNote = section.querySelector('[data-cad-note]');
    var boostBtns = section.querySelectorAll('.su__b-add');
    var saveVal = section.querySelector('[data-save-val]');
    var mainBtn = section.querySelector('[data-add-sub]');

    var isSub = true;
    var basePrice = 1920;
    var boostTotal = 0;
    var currCad = '45';

    function updateTerminal() {
      var finalPrice = basePrice + boostTotal;
      if (mainBtn) {
        if (isSub) {
          mainBtn.textContent = '[ ENROLL IN CLINICAL REPLENISHMENT &bull; RS. ' + finalPrice.toLocaleString('en-IN') + ' ]';
        } else {
          mainBtn.textContent = '[ ACQUIRE SINGLE BOTTLE &bull; RS. ' + finalPrice.toLocaleString('en-IN') + ' ]';
        }
      }

      if (saveVal) {
        if (isSub) {
          var annualSave = (2400 - 1920) * (365 / parseInt(currCad, 10)) + 900; // include shipping savings
          saveVal.textContent = 'RS. ' + Math.round(annualSave).toLocaleString('en-IN') + ' + FREE GIFT';
        } else {
          saveVal.textContent = 'RS. 0 (ZERO VIP BENEFITS)';
        }
      }
    }

    optionRows.forEach(function(row) {
      row.addEventListener('click', function(e) {
        if (e.target.tagName === 'BUTTON') return;
        optionRows.forEach(function(r) { r.classList.remove('is-selected'); });
        this.classList.add('is-selected');
        var radio = this.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;

        var opt = this.getAttribute('data-option') || 'sub';
        if (opt === 'sub') {
          isSub = true;
          basePrice = 1920;
        } else {
          isSub = false;
          basePrice = 2400;
        }
        updateTerminal();
      });
    });

    cadBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        cadBtns.forEach(function(b) { b.classList.remove('is-active'); });
        this.classList.add('is-active');
        currCad = this.getAttribute('data-cad') || '45';
        if (cadNote) {
          cadNote.textContent = '// PREDICTED DEPLETION: ' + currCad + ' DAYS &bull; SCHEDULED AUTO-DISPATCH LOCKED //';
        }
        updateTerminal();
      });
    });

    boostBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        this.classList.toggle('is-added');
        var boostVal = parseInt(this.getAttribute('data-boost'), 10) || 0;
        var bName = this.getAttribute('data-name') || 'Booster';
        if (this.classList.contains('is-added')) {
          this.textContent = '[V ADDED &bull; +RS. ' + boostVal + ' ]';
          boostTotal += boostVal;
          alert('[ REGIMEN BOOSTER ADDED ]\n\n' + bName + ' has been added to your delivery protocol.');
        } else {
          this.textContent = '[+ ADD &bull; RS. ' + boostVal + ' ]';
          boostTotal -= boostVal;
        }
        updateTerminal();
      });
    });

    if (mainBtn) {
      mainBtn.addEventListener('click', function() {
        var origText = this.textContent;
        this.textContent = '[ ENCRYPTING SUBSCRIPTION PROTOCOL... ]';
        setTimeout(function() {
          mainBtn.textContent = '[ CLINICAL REPLENISHMENT LOCKED V ]';
          alert('[ REPLENISHMENT ENROLLMENT CONFIRMED ]\n\nYou are locked into the 20% discount tier with express shipping and priority batch reservation. You can modify or pause your delivery anytime online.');
          setTimeout(function() { mainBtn.textContent = origText; }, 3000);
        }, 600);
      });
    }

    updateTerminal();
  });
</script>

