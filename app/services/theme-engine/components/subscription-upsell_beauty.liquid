          </div>

          <!-- Frequency Cadence Selector -->
          <div class="su__cadence-box">
            <span class="su__cad-lbl">// SELECT YOUR REPLENISHMENT CADENCE //</span>
            <div class="su__cad-grid" data-cad-grid>
              <button type="button" class="su__cad-btn" data-cad="30">[ 30 DAYS ]<br><span style="font-size:0.65rem;font-weight:normal;">Intensive Use</span></button>
              <button type="button" class="su__cad-btn is-active" data-cad="45">[ 45 DAYS ]<br><span style="font-size:0.65rem;font-weight:normal;">Recommended</span></button>
              <button type="button" class="su__cad-btn" data-cad="60">[ 60 DAYS ]<br><span style="font-size:0.65rem;font-weight:normal;">Gentle Protocol</span></button>
            </div>
