{%- comment -%}
  sections/main-404_luxury_v1.liquid
  PSYCHOLOGY & CONVERSION ARCHITECTURE (340+ lines):
  1. COGNITIVE RECOVERY & RISK REVERSAL: A 404 error creates frustration and high bounce rates (67% exit immediately). We reframe this as an exclusive discovery moment ("Fleeting Archival Piece") and provide immediate recovery pathways.
  2. HICK'S LAW REDUCTION: Curated popular search pills reduce cognitive load by offering instant 1-click navigation to high-intent categories.
  3. RECIPROCITY & VIP CONCIERGE: Offers immediate human assistance via WhatsApp or VIP desk to salvage high-ticket jewelry/watch leads who may have clicked a broken or expired campaign link.
  4. MERE-EXPOSURE & CROSS-SELL: Integrated bestsellers grid directly below the recovery box to reignite buying momentum.
  5. ZERO EMOJI GUARANTEE: Pure ASCII editorial brackets [ VIP CONCIERGE ], [ ARCHIVAL TIMEPIECES ] and SVG typography.
{%- endcomment -%}

{%- assign section_id = 'lx-404-' | append: section.id -%}
{%- assign bestsellers_collection = collections[section.settings.recovery_collection] | default: collections['all'] -%}

<style>
  #{{ section_id }} {
    --lx-bg: {{ section.settings.bg_color | default: '#faf9f5' }};
    --lx-text: {{ section.settings.text_color | default: '#1a1a1a' }};
    --lx-gold: {{ section.settings.gold_accent | default: '#c9a96e' }};
    --lx-border: rgba(26, 26, 26, 0.08);
    --lx-card-bg: #ffffff;
    
    background-color: var(--lx-bg);
    color: var(--lx-text);
    padding: clamp(5rem, 12vw, 10rem) 1.5rem clamp(4rem, 8vw, 8rem);
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    position: relative;
  }

  /* Archival Background Watermark */
  #{{ section_id }} .lx-404__watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: clamp(15rem, 35vw, 32rem);
    font-weight: 300;
    color: rgba(201, 169, 110, 0.04);
    pointer-events: none;
    user-select: none;
    z-index: 1;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  #{{ section_id }} .lx-404__container {
    position: relative;
    z-index: 2;
    max-width: 840px;
    width: 100%;
    margin: 0 auto;
    text-align: center;
  }

  /* Editorial Header Badge */
  #{{ section_id }} .lx-404__badge {
    display: inline-block;
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--lx-gold);
    margin-bottom: 1.5rem;
    padding: 0.4rem 1.2rem;
    border: 1px solid rgba(201, 169, 110, 0.3);
    background: rgba(201, 169, 110, 0.03);
  }

  #{{ section_id }} .lx-404__title {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 300;
    line-height: 1.15;
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.02em;
  }

  #{{ section_id }} .lx-404__subtitle {
    font-family: var(--font-body, sans-serif);
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: rgba(26, 26, 26, 0.7);
    max-width: 580px;
    margin: 0 auto 2.5rem auto;
    line-height: 1.7;
    font-weight: 300;
  }

  /* Search Bar Architecture */
  #{{ section_id }} .lx-404__search-wrapper {
    max-width: 540px;
    margin: 0 auto 2rem auto;
  }

  #{{ section_id }} .lx-404__search-form {
    display: flex;
    position: relative;
    border: 1px solid var(--lx-text);
    background: var(--lx-card-bg);
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }

  #{{ section_id }} .lx-404__search-form:focus-within {
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    border-color: var(--lx-gold);
  }

  #{{ section_id }} .lx-404__search-input {
    flex: 1;
    padding: 1.1rem 1.5rem;
    border: none;
    background: transparent;
    font-family: var(--font-body, sans-serif);
    font-size: 0.95rem;
    color: var(--lx-text);
    outline: none;
  }

  #{{ section_id }} .lx-404__search-input::placeholder {
    color: rgba(26, 26, 26, 0.4);
    font-style: italic;
  }

  #{{ section_id }} .lx-404__search-submit {
    padding: 1.1rem 2rem;
    background: var(--lx-text);
    color: #ffffff;
    border: none;
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease;
  }

  #{{ section_id }} .lx-404__search-submit:hover {
    background: var(--lx-gold);
    color: #000000;
  }

  /* Popular Searches Pills */
  #{{ section_id }} .lx-404__pills-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 3.5rem;
  }

  #{{ section_id }} .lx-404__pills-label {
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(26, 26, 26, 0.5);
    margin-right: 0.5rem;
  }

  #{{ section_id }} .lx-404__pill {
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--lx-text);
    text-decoration: none;
    padding: 0.45rem 1rem;
    background: #ffffff;
    border: 1px solid var(--lx-border);
    transition: all 0.25s ease;
  }

  #{{ section_id }} .lx-404__pill:hover {
    border-color: var(--lx-gold);
    background: var(--lx-gold);
    color: #000000;
    transform: translateY(-2px);
  }

  /* VIP Concierge Assistance Box */
  #{{ section_id }} .lx-404__concierge {
    max-width: 620px;
    margin: 0 auto 4.5rem auto;
    padding: 2rem;
    background: #ffffff;
    border: 1px solid rgba(201, 169, 110, 0.25);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
    align-items: center;
    text-align: left;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.02);
  }

  @media (max-width: 640px) {
    #{{ section_id }} .lx-404__concierge {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 1.5rem;
    }
  }

  #{{ section_id }} .lx-404__concierge-title {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: 1.25rem;
    margin: 0 0 0.4rem 0;
    font-weight: 400;
  }

  #{{ section_id }} .lx-404__concierge-text {
    font-family: var(--font-body, sans-serif);
    font-size: 0.85rem;
    color: rgba(26, 26, 26, 0.65);
    margin: 0;
    line-height: 1.5;
  }

  #{{ section_id }} .lx-404__concierge-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    background: #1a1a1a;
    color: #ffffff;
    text-decoration: none;
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    white-space: nowrap;
    transition: background 0.25s ease;
  }

  #{{ section_id }} .lx-404__concierge-btn:hover {
    background: var(--lx-gold);
    color: #000000;
  }

  /* Bestsellers Recovery Grid */
  #{{ section_id }} .lx-404__recovery-section {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid var(--lx-border);
    padding-top: 4rem;
  }

  #{{ section_id }} .lx-404__recovery-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 640px) {
    #{{ section_id }} .lx-404__recovery-header {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }
  }

  #{{ section_id }} .lx-404__recovery-title {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: 1.85rem;
    font-weight: 300;
    margin: 0;
  }

  #{{ section_id }} .lx-404__recovery-link {
    font-family: var(--font-body, sans-serif);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--lx-text);
    text-decoration: none;
    border-bottom: 1px solid var(--lx-gold);
    padding-bottom: 0.2rem;
  }

  #{{ section_id }} .lx-404__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  @media (max-width: 1024px) {
    #{{ section_id }} .lx-404__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    #{{ section_id }} .lx-404__grid {
      grid-template-columns: 1fr;
    }
  }

  #{{ section_id }} .lx-404__card {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.04);
    text-align: left;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #{{ section_id }} .lx-404__card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.05);
  }

  #{{ section_id }} .lx-404__card-img-wrapper {
    position: relative;
    aspect-ratio: 4 / 5;
    background: #f4f3f0;
    overflow: hidden;
  }

  #{{ section_id }} .lx-404__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #{{ section_id }} .lx-404__card:hover .lx-404__card-img {
    transform: scale(1.06);
  }

  #{{ section_id }} .lx-404__card-info {
    padding: 1.25rem 1rem;
  }

  #{{ section_id }} .lx-404__card-vendor {
    font-family: var(--font-body, sans-serif);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--lx-gold);
    margin-bottom: 0.3rem;
  }

  #{{ section_id }} .lx-404__card-title {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: 1.1rem;
    font-weight: 400;
    margin: 0 0 0.5rem 0;
    color: var(--lx-text);
    text-decoration: none;
    display: block;
  }

  #{{ section_id }} .lx-404__card-price {
    font-family: var(--font-body, sans-serif);
    font-size: 0.9rem;
    color: rgba(26, 26, 26, 0.8);
  }
</style>

<div id="{{ section_id }}">
  <div class="lx-404__watermark" aria-hidden="true">404</div>

  <div class="lx-404__container">
    <div class="lx-404__badge">[ ARCHIVAL RECORD MISSING ]</div>
    <h1 class="lx-404__title">{{ section.settings.title | default: "This Creation Has Moved On" }}</h1>
    <p class="lx-404__subtitle">{{ section.settings.subtitle | default: "Like all exquisite pieces, certain pages are fleeting or have been archived into our private collector vaults. Let us assist you in locating your desired creation." }}</p>

    <div class="lx-404__search-wrapper">
      <form class="lx-404__search-form" action="{{ routes.search_url }}" method="get" role="search">
        <input 
          class="lx-404__search-input" 
          type="search" 
          name="q" 
          placeholder="{{ section.settings.search_placeholder | default: 'Search by gemstone, collection, or reference number...' }}" 
          aria-label="Search store collection"
          required
        >
        <button class="lx-404__search-submit" type="submit">[ SEARCH ]</button>
      </form>
    </div>

    {%- if section.settings.show_pills -%}
      <div class="lx-404__pills-container">
        <span class="lx-404__pills-label">[ POPULAR DISCOVERIES ] :</span>
        {%- assign pills = section.settings.pill_tags | default: "Bespoke Rings,Archival Timepieces,Diamond Necklaces,New Arrivals,High Jewelry" | split: "," -%}
        {%- for pill in pills -%}
          {%- assign clean_pill = pill | strip -%}
          <a href="{{ routes.search_url }}?q={{ clean_pill | url_encode }}" class="lx-404__pill">{{ clean_pill }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_concierge -%}
      <div class="lx-404__concierge">
        <div>
          <h3 class="lx-404__concierge-title">{{ section.settings.concierge_title | default: "Require Personal Guidance?" }}</h3>
          <p class="lx-404__concierge-text">{{ section.settings.concierge_text | default: "Our Private Salon Concierge is available to verify stock availability, arrange private viewings, or trace archived creations." }}</p>
        </div>
        <div>
          {%- assign whatsapp_num = section.settings.whatsapp_number | default: "+919876543210" -%}
          <a href="https://wa.me/{{ whatsapp_num | remove: '+' | remove: ' ' | remove: '-' }}?text=Hello%20Concierge,%20I%20am%20looking%20for%20an%20archived%20creation%20on%20your%20store." target="_blank" rel="noopener" class="lx-404__concierge-btn">
            [ VIP CONCIERGE ]
          </a>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_recovery_grid and bestsellers_collection.products.size > 0 -%}
    <div class="lx-404__recovery-section">
      <div class="lx-404__recovery-header">
        <h2 class="lx-404__recovery-title">{{ section.settings.recovery_title | default: "Curated Archival Favorites" }}</h2>
        <a href="{{ bestsellers_collection.url | default: routes.all_products_collection_url }}" class="lx-404__recovery-link">[ VIEW COMPLETE VAULT ]</a>
      </div>

      <div class="lx-404__grid">
        {%- for product in bestsellers_collection.products limit: 4 -%}
          <div class="lx-404__card">
            <a href="{{ product.url }}" class="lx-404__card-img-wrapper" aria-label="View {{ product.title }}">
              {%- if product.featured_image -%}
                <img 
                  class="lx-404__card-img" 
                  src="{{ product.featured_image | img_url: '600x750', crop: 'center' }}" 
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                  width="600"
                  height="750"
                >
              {%- else -%}
                <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#999; font-size:0.8rem;">[ NO IMAGE ]</div>
              {%- endif -%}
            </a>
            <div class="lx-404__card-info">
              {%- if product.vendor != blank -%}
                <div class="lx-404__card-vendor">{{ product.vendor }}</div>
              {%- endif -%}
              <a href="{{ product.url }}" class="lx-404__card-title">{{ product.title }}</a>
              <div class="lx-404__card-price">
                {%- if product.compare_at_price > product.price -%}
                  <span style="text-decoration: line-through; opacity: 0.5; margin-right: 0.4rem;">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
                <span>{{ product.price | money }}</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var searchInput = document.querySelector('#{{ section_id }} .lx-404__search-input');
    if (searchInput && window.location.search.indexOf('q=') === -1) {
      setTimeout(function() {
        searchInput.focus();
      }, 600);
    }
  });
</script>

{% schema %}
{
  "name": "Luxury 404 Recovery Suite",
  "tag": "section",
  "class": "section-404-luxury",
  "settings": [
    {
      "type": "header",
      "content": "Editorial Messaging"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "This Creation Has Moved On"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Like all exquisite pieces, certain pages are fleeting or have been archived into our private collector vaults. Let us assist you in locating your desired creation."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder",
      "default": "Search by gemstone, collection, or reference number..."
    },
    {
      "type": "header",
      "content": "Popular Search Pills"
    },
    {
      "type": "checkbox",
      "id": "show_pills",
      "label": "Show Popular Search Pills",
      "default": true
    },
    {
      "type": "text",
      "id": "pill_tags",
      "label": "Pill Tags (Comma Separated)",
      "default": "Bespoke Rings,Archival Timepieces,Diamond Necklaces,New Arrivals,High Jewelry"
    },
    {
      "type": "header",
      "content": "VIP Concierge Assistance"
    },
    {
      "type": "checkbox",
      "id": "show_concierge",
      "label": "Show Concierge Box",
      "default": true
    },
    {
      "type": "text",
      "id": "concierge_title",
      "label": "Concierge Title",
      "default": "Require Personal Guidance?"
    },
    {
      "type": "textarea",
      "id": "concierge_text",
      "label": "Concierge Text",
      "default": "Our Private Salon Concierge is available to verify stock availability, arrange private viewings, or trace archived creations."
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Number (with country code)",
      "default": "+919876543210"
    },
    {
      "type": "header",
      "content": "Bestsellers Recovery Grid"
    },
    {
      "type": "checkbox",
      "id": "show_recovery_grid",
      "label": "Show Recovery Products Grid",
      "default": true
    },
    {
      "type": "text",
      "id": "recovery_title",
      "label": "Recovery Grid Title",
      "default": "Curated Archival Favorites"
    },
    {
      "type": "collection",
      "id": "recovery_collection",
      "label": "Select Recovery Collection"
    },
    {
      "type": "header",
      "content": "Color Tokens"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf9f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "gold_accent",
      "label": "Gold Accent Color",
      "default": "#c9a96e"
    }
  ],
  "presets": [
    {
      "name": "Luxury 404 Recovery Suite"
    }
  ]
}
{% endschema %}
