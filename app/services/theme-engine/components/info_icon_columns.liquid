{%- comment -%}
  info_icon_columns.liquid — Ultra-Comprehensive Feature & Icon Columns Showcase
  
  DESIGN PHILOSOPHY:
  A high-converting feature grid designed to showcase core brand value propositions,
  product benefits, or technical specifications. Features a built-in SVG icon library,
  3D card tilt micro-interactions on hover, animated viewport number counters, and a
  smooth horizontal touch slider for mobile devices. Engineered for 60fps performance.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --iic-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --iic-card-bg: {{ section.settings.card_bg_color | default: '#f8fafc' }};
    --iic-text: {{ section.settings.text_color | default: '#0f172a' }};
    --iic-muted: color-mix(in srgb, var(--iic-text) 62%, transparent);
    --iic-border: color-mix(in srgb, var(--iic-text) 10%, transparent);
    --iic-accent: {{ section.settings.accent_color | default: '#6366f1' }};
    --iic-icon-bg: color-mix(in srgb, var(--iic-accent) 12%, transparent);
    --iic-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --iic-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --iic-padding-top: clamp(3.5rem, 8vw, 7rem);
    --iic-padding-bottom: clamp(3.5rem, 8vw, 7rem);
    --iic-radius: {{ section.settings.card_radius | default: 20 }}px;
  }

  .iic-section {
    background-color: var(--iic-bg);
    color: var(--iic-text);
    font-family: var(--iic-font-body);
    padding: var(--iic-padding-top) clamp(1.25rem, 4vw, 4rem) var(--iic-padding-bottom);
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--iic-border);
    border-bottom: 1px solid var(--iic-border);
  }

  .iic-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Section Header */
  .iic-header {
    text-align: {{ section.settings.text_alignment | default: 'center' }};
    max-width: 760px;
    margin: 0 {{ section.settings.text_alignment == 'left' ? '0' : 'auto' }} clamp(2.5rem, 6vw, 4.5rem);
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.text_alignment == 'left' ? 'flex-start' : 'center' }};
    gap: 1rem;
  }
  .iic-eyebrow {
    font-family: var(--iic-font-body);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--iic-accent);
    background: color-mix(in srgb, var(--iic-accent) 10%, transparent);
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    border: 1px solid color-mix(in srgb, var(--iic-accent) 25%, transparent);
  }
  .iic-title {
    font-family: var(--iic-font-head);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 700;
    color: var(--iic-text);
    line-height: 1.15;
    margin: 0;
  }
  .iic-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--iic-muted);
    line-height: 1.65;
    margin: 0;
  }

  /* Cards Grid / Mobile Slider */
  .iic-grid-wrap {
    position: relative;
  }
  .iic-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 3vw, 2.25rem);
  }
  @media (min-width: 640px) {
    .iic-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .iic-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    }
  }

  /* Mobile Horizontal Scroll Override */
  @media (max-width: 767px) {
    .iic-grid[data-mobile-slider="true"] {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      gap: 1rem;
      padding-bottom: 1.5rem;
      margin-left: -1.25rem;
      margin-right: -1.25rem;
      padding-left: 1.25rem;
      padding-right: 1.25rem;
      -webkit-overflow-scrolling: touch;
    }
    .iic-grid[data-mobile-slider="true"]::-webkit-scrollbar {
      display: none;
    }
    .iic-grid[data-mobile-slider="true"] .iic-card {
      min-width: 82vw;
      scroll-snap-align: center;
      flex-shrink: 0;
    }
  }

  /* Card Style Variations */
  .iic-card {
    background-color: var(--iic-card-bg);
    border: 1px solid var(--iic-border);
    border-radius: var(--iic-radius);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.card_alignment | default: 'flex-start' }};
    text-align: {{ section.settings.card_alignment | default: 'left' }};
    gap: 1.25rem;
    position: relative;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
    will-change: transform;
  }
  .iic-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -15px color-mix(in srgb, var(--iic-text) 12%, transparent);
    border-color: var(--iic-accent);
  }

  /* Glassmorphism Card Style */
  .iic-card[data-style="glass"] {
    background: color-mix(in srgb, var(--iic-card-bg) 65%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid color-mix(in srgb, var(--iic-text) 18%, transparent);
  }

  /* Elevated Card Style */
  .iic-card[data-style="elevated"] {
    background: var(--iic-card-bg);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.08);
    border: none;
  }
  .iic-card[data-style="elevated"]:hover {
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
  }

  /* Icon / Media Container */
  .iic-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: var(--iic-icon-bg);
    color: var(--iic-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.3s ease;
  }
  .iic-card:hover .iic-icon-wrap {
    transform: scale(1.12) rotate(4deg);
    background: var(--iic-accent);
    color: #ffffff;
  }
  .iic-icon-wrap svg {
    width: 32px;
    height: 32px;
    stroke-width: 1.8;
    stroke: currentColor;
    fill: none;
    transition: stroke 0.3s ease;
  }
  .iic-icon-wrap img {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }

  /* Counter Number Badge */
  .iic-counter-wrap {
    font-family: var(--iic-font-head);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--iic-text);
    line-height: 1;
    margin-bottom: -0.5rem;
    display: flex;
    align-items: baseline;
    gap: 0.15rem;
  }
  .iic-counter-prefix, .iic-counter-suffix {
    font-size: 1.5rem;
    color: var(--iic-accent);
  }

  /* Card Typography */
  .iic-card-title {
    font-family: var(--iic-font-head);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--iic-text);
    margin: 0;
    line-height: 1.3;
  }
  .iic-card-desc {
    font-family: var(--iic-font-body);
    font-size: 0.95rem;
    color: var(--iic-muted);
    line-height: 1.65;
    margin: 0;
  }
  .iic-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--iic-font-body);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--iic-accent);
    text-decoration: none;
    margin-top: 0.5rem;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .iic-card:hover .iic-card-link {
    transform: translateX(4px);
  }
  .iic-card-link svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 2.5;
  }

  /* Mobile Dots Indicator */
  .iic-dots {
    display: none;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 767px) {
    .iic-dots[data-show="true"] {
      display: flex;
    }
  }
  .iic-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--iic-border);
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease;
  }
  .iic-dot.active {
    width: 24px;
    border-radius: 100px;
    background: var(--iic-accent);
  }
</style>

<section class="iic-section" id="iic-section-{{ section.id }}" aria-labelledby="iic-title-{{ section.id }}">
  <div class="iic-container">
    
    {%- if section.settings.title != blank or section.settings.eyebrow != blank -%}
      <div class="iic-header">
        {%- if section.settings.eyebrow != blank -%}
          <div class="iic-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="iic-title-{{ section.id }}" class="iic-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="iic-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="iic-grid-wrap">
      <div class="iic-grid" id="iic-grid-{{ section.id }}" data-mobile-slider="{{ section.settings.enable_mobile_slider | default: true }}">
        {%- for block in section.blocks -%}
          <div class="iic-card" data-style="{{ section.settings.card_style | default: 'bordered' }}" {{ block.shopify_attributes }}>
            
            <!-- Icon or Image Display -->
            <div class="iic-icon-wrap">
              {%- if block.settings.custom_image != blank -%}
                {{ block.settings.custom_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {%- else -%}
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                  {%- when 'sparkles' -%}
                    <svg viewBox="0 0 24 24"><path d="M12 3l1.912 5.813a2 2 0 001.272 1.272L21 12l-5.813 1.912a2 2 0 00-1.272 1.272L12 21l-1.912-5.813a2 2 0 00-1.272-1.272L3 12l5.813-1.912a2 2 0 001.272-1.272L12 3z"></path></svg>
                  {%- when 'award' -%}
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
                  {%- when 'support' -%}
                    <svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"></path></svg>
                  {%- when 'refresh' -%}
                    <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"></path></svg>
                  {%- when 'lock' -%}
                    <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
                  {%- when 'globe' -%}
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path></svg>
                  {%- when 'eco' -%}
                    <svg viewBox="0 0 24 24"><path d="M11 20A7 7 0 019.8 6.1C15.5 5 17 4.4 19 2c1 2 2 4.1 2 8 0 5.5-4.5 10-10 10z"></path><path d="M2 21c0-3 1.8-5.3 5-6"></path></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                {%- endcase -%}
              {%- endif -%}
            </div>

            <!-- Optional Counter Badge -->
            {%- if block.settings.show_counter and block.settings.counter_target > 0 -%}
              <div class="iic-counter-wrap">
                {%- if block.settings.counter_prefix != blank -%}
                  <span class="iic-counter-prefix">{{ block.settings.counter_prefix }}</span>
                {%- endif -%}
                <span class="iic-counter-val" data-target="{{ block.settings.counter_target }}">0</span>
                {%- if block.settings.counter_suffix != blank -%}
                  <span class="iic-counter-suffix">{{ block.settings.counter_suffix }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            <h3 class="iic-card-title">{{ block.settings.title }}</h3>
            <p class="iic-card-desc">{{ block.settings.text }}</p>

            {%- if block.settings.btn_label != blank -%}
              <a href="{{ block.settings.btn_link | default: '#' }}" class="iic-card-link">
                <span>{{ block.settings.btn_label }}</span>
                <svg viewBox="0 0 24 24" fill="none"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
            {%- endif -%}

          </div>
        {%- endfor -%}
      </div>

      <!-- Mobile Dots -->
      {%- if section.settings.enable_mobile_slider and section.blocks.size > 1 -%}
        <div class="iic-dots" id="iic-dots-{{ section.id }}" data-show="true" aria-hidden="true">
          {%- for block in section.blocks -%}
            <span class="iic-dot {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var sectionEl = document.getElementById('iic-section-' + sectionId);
    if (!sectionEl) return;

    // 1. Viewport Number Counters Animation
    var counters = sectionEl.querySelectorAll('.iic-counter-val');
    if (counters.length > 0 && 'IntersectionObserver' in window) {
      var counterObserver = new IntersectionObserver(function(entries, observer) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var el = entry.target;
            var target = parseInt(el.getAttribute('data-target'), 10) || 100;
            var duration = 1500;
            var start = 0;
            var stepTime = Math.max(Math.floor(duration / target), 15);
            var increment = Math.ceil(target / (duration / stepTime));

            var timer = setInterval(function() {
              start += increment;
              if (start >= target) {
                el.innerText = target.toLocaleString();
                clearInterval(timer);
              } else {
                el.innerText = start.toLocaleString();
              }
            }, stepTime);

            observer.unobserve(el);
          }
        });
      }, { threshold: 0.4 });

      counters.forEach(function(c) { counterObserver.observe(c); });
    }

    // 2. Mobile Touch Slider Dots Controller
    var gridEl = document.getElementById('iic-grid-' + sectionId);
    var dotsEl = document.getElementById('iic-dots-' + sectionId);
    if (gridEl && dotsEl && window.innerWidth <= 767) {
      var dots = dotsEl.querySelectorAll('.iic-dot');
      var cards = gridEl.querySelectorAll('.iic-card');

      gridEl.addEventListener('scroll', function() {
        var scrollLeft = gridEl.scrollLeft;
        var cardWidth = cards[0].offsetWidth + 16;
        var activeIdx = Math.round(scrollLeft / cardWidth);

        dots.forEach(function(dot, idx) {
          if (idx === activeIdx) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }, { passive: true });
    }

    // 3. Desktop 3D Card Tilt Micro-Interaction
    if (window.innerWidth >= 1024) {
      var allCards = sectionEl.querySelectorAll('.iic-card');
      allCards.forEach(function(card) {
        card.addEventListener('mousemove', function(e) {
          var rect = card.getBoundingClientRect();
          var x = e.clientX - rect.left;
          var y = e.clientY - rect.top;
          var centerX = rect.width / 2;
          var centerY = rect.height / 2;
          var rotateX = ((y - centerY) / centerY) * -5;
          var rotateY = ((x - centerX) / centerX) * 5;

          requestAnimationFrame(function() {
            card.style.transform = 'translateY(-6px) perspective(1000px) rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg)';
          });
        });

        card.addEventListener('mouseleave', function() {
          requestAnimationFrame(function() {
            card.style.transform = '';
          });
        });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Feature Icon Columns",
  "tag": "section",
  "class": "section-info-icon-columns",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
