    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "We combine aerospace-grade precision with intuitive design to deliver unrivaled quality and reliability."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left Aligned" },
        { "value": "center", "label": "Centered" }
      ],
      "default": "center"
