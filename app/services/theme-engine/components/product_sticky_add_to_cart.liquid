{%- comment -%}
  product_sticky_add_to_cart.liquid — Ultra-Comprehensive Sticky Add-to-Cart & Variant Drawer
  
  DESIGN PHILOSOPHY:
  An architectural floating sticky checkout bar engineered to maximize acquisition conversion.
  Features scroll-triggered entrance animations, real-time variant selectors, quantity steppers,
  live stock allocation counters, and an accessible Configuration Lightbox Modal Dialog
  for seamless single-click customization without losing scroll context.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --pst-bg: {{ section.settings.bg_color | default: '#0f172a' }};
    --pst-text: {{ section.settings.text_color | default: '#f8fafc' }};
    --pst-muted: color-mix(in srgb, var(--pst-text) 65%, transparent);
    --pst-border: color-mix(in srgb, var(--pst-text) 16%, transparent);
    --pst-accent: {{ section.settings.accent_color | default: '#38bdf8' }};
    --pst-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --pst-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
  }

  /* Floating Bottom Sticky Bar */
  .pst-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(15, 23, 42, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    color: var(--pst-text);
    font-family: var(--pst-font-body);
    border-top: 1px solid var(--pst-border);
    padding: clamp(0.85rem, 2vw, 1.25rem) clamp(1.25rem, 4vw, 4rem);
    box-shadow: 0 -20px 40px -10px rgba(0, 0, 0, 0.7);
    z-index: 99980;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    transform: translateY(105%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pst-bar[data-visible="true"] {
    transform: translateY(0);
  }

  /* Left Product Summary */
  .pst-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .pst-thumb {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: #1e293b;
    border: 1px solid var(--pst-border);
    object-fit: cover;
    display: none;
  }
  @media (min-width: 640px) {
    .pst-thumb { display: block; }
  }
  .pst-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .pst-title {
    font-family: var(--pst-font-head);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
    color: #ffffff;
  }
  .pst-variant {
    font-size: 0.8rem;
    color: var(--pst-muted);
  }

  /* Center Price & Stock */
  .pst-center {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
  }
  @media (min-width: 768px) {
    .pst-center { display: flex; }
  }
  .pst-price { font-family: var(--pst-font-head); font-size: 1.25rem; font-weight: 700; color: var(--pst-accent); }
  .pst-stock { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: #34d399; }

  /* Right Controls Area */
  .pst-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  /* Quantity Stepper */
  .pst-qty-box {
    display: flex;
    align-items: center;
    background: #1e293b;
    border: 1px solid var(--pst-border);
    border-radius: 100px;
    padding: 0.25rem;
  }
  .pst-qty-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }
  .pst-qty-btn:hover { background: rgba(255, 255, 255, 0.1); }
  .pst-qty-val {
    width: 36px;
    text-align: center;
    font-weight: 700;
    font-size: 0.9rem;
    color: #ffffff;
    background: transparent;
    border: none;
    outline: none;
  }

  /* Add to Cart CTA */
  .pst-btn-add {
    background: var(--pst-text);
    color: var(--pst-bg);
    font-weight: 700;
    font-size: 0.9rem;
    border: none;
    padding: 0.85rem 1.75rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }
  .pst-btn-add:hover {
    background: var(--pst-accent);
    color: #ffffff;
    transform: translateY(-2px);
  }
  .pst-btn-config {
    background: transparent;
    color: var(--pst-muted);
    border: 1px solid var(--pst-border);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.85rem 1.25rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: none;
  }
  @media (min-width: 1024px) {
    .pst-btn-config { display: inline-flex; }
  }
  .pst-btn-config:hover {
    color: #ffffff;
    border-color: #ffffff;
  }

  /* Configuration Lightbox Modal */
  .pst-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .pst-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .pst-modal {
    background: #0f172a;
    color: var(--pst-text);
    border: 1px solid var(--pst-border);
    border-radius: 36px;
    max-width: 600px;
    width: 100%;
    padding: clamp(2.5rem, 6vw, 3.5rem);
    position: relative;
    box-shadow: 0 40px 80px -15px rgba(0, 0, 0, 0.95);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pst-modal-overlay[data-open="true"] .pst-modal {
    transform: scale(1);
  }
  .pst-modal-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
  }
  .pst-opt-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  .pst-opt-card {
    background: #1e293b;
    border: 1px solid var(--pst-border);
    border-radius: 16px;
    padding: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .pst-opt-card[data-selected="true"] {
    border-color: var(--pst-accent);
    background: rgba(56, 189, 248, 0.1);
  }
</style>

<!-- Floating Sticky Add to Cart Bar -->
<div class="pst-bar" id="pst-bar-{{ section.id }}" data-visible="false" role="region" aria-label="Quick acquisition bar">
  
  <div class="pst-left">
    {%- if product.featured_image != blank -%}
      {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'pst-thumb', alt: product.title }}
    {%- else -%}
      <div class="pst-thumb" style="display:flex;align-items:center;justify-content:center;font-size:0.7rem;font-weight:700;color:#64748b;">SERIES 04</div>
    {%- endif -%}

    <div class="pst-info">
      <h3 class="pst-title">{{ product.title | default: 'Monolith Series 04 Workstation' }}</h3>
      <span class="pst-variant" id="pst-variant-label-{{ section.id }}">{{ product.selected_or_first_available_variant.title | default: 'Zürich Aluminum Edition • Gasket Mount' }}</span>
    </div>
  </div>

  <div class="pst-center">
    <span class="pst-price">{{ product.price | default: '$420.00' }}</span>
    <span class="pst-stock">Allocation Available • Zero Delay</span>
  </div>

  <div class="pst-right">
    <!-- Quantity Control -->
    <div class="pst-qty-box" aria-label="Quantity selector">
      <button type="button" class="pst-qty-btn" id="pst-qty-minus-{{ section.id }}" aria-label="Decrease quantity">-</button>
      <input type="text" class="pst-qty-val" id="pst-qty-val-{{ section.id }}" value="1" readonly>
      <button type="button" class="pst-qty-btn" id="pst-qty-plus-{{ section.id }}" aria-label="Increase quantity">+</button>
    </div>

    <button type="button" class="pst-btn-config" id="pst-config-btn-{{ section.id }}">Configure Options</button>
    
    <button type="button" class="pst-btn-add" onclick="alert('Allocated 1 instrument to your cart.');">
      <span>Acquire To Cart</span>
      <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.5;"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
    </button>
  </div>

</div>

<!-- Configuration Lightbox Modal -->
<div class="pst-modal-overlay" id="pst-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="pst-modal">
    <button type="button" class="pst-modal-close" id="pst-modal-close-{{ section.id }}" aria-label="Close configuration modal">
      <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <div style="display:flex;align-items:center;gap:0.6rem;">
      <span style="width:10px;height:10px;border-radius:50%;background:var(--pst-accent);"></span>
      <span style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.18em;color:var(--pst-accent);">Atelier Customization</span>
    </div>

    <h3 style="font-family:var(--pst-font-head);font-size:1.85rem;margin:0;line-height:1.2;">Select Chassis Finish</h3>
    
    <p style="font-size:0.95rem;color:var(--pst-muted);line-height:1.6;margin:0;">Choose from our anodized Swiss aluminum options. Each finish is bead-blasted to 150 grit for an ultra-smooth, fingerprint-resistant surface.</p>

    <div class="pst-opt-grid">
      <div class="pst-opt-card" data-selected="true" data-name="Zürich Aluminum Edition">
        <strong style="font-size:1rem;color:#ffffff;font-family:var(--pst-font-head);">Zürich Anodized Silver</strong>
        <span style="font-size:0.8rem;color:var(--pst-muted);">Standard Atelier Edition</span>
      </div>
      <div class="pst-opt-card" data-selected="false" data-name="Obsidian Black Edition">
        <strong style="font-size:1rem;color:#ffffff;font-family:var(--pst-font-head);">Obsidian Matte Black</strong>
        <span style="font-size:0.8rem;color:var(--pst-muted);">Deep Sulfuric Anodization</span>
      </div>
      <div class="pst-opt-card" data-selected="false" data-name="Raw Machined Brass Edition">
        <strong style="font-size:1rem;color:#ffffff;font-family:var(--pst-font-head);">Raw Machined Brass</strong>
        <span style="font-size:0.8rem;color:var(--pst-muted);">Heavyweight Acoustic Profile</span>
      </div>
      <div class="pst-opt-card" data-selected="false" data-name="Alpine Snow White Edition">
        <strong style="font-size:1rem;color:#ffffff;font-family:var(--pst-font-head);">Alpine Snow White</strong>
        <span style="font-size:0.8rem;color:var(--pst-muted);">Electrophoretic Coating</span>
      </div>
    </div>

    <button type="button" class="pst-btn-add" style="justify-content:center;width:100%;margin-top:0.5rem;" id="pst-apply-config-{{ section.id }}">Apply Selection & Acquire →</button>
  </div>
</div>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var bar = document.getElementById('pst-bar-' + sid);
    if (!bar) return;

    // Scroll trigger (appear after scrolling 400px down)
    var scrollThreshold = {{ section.settings.scroll_threshold | default: 400 }};
    function checkScroll() {
      if (window.scrollY > scrollThreshold) {
        bar.setAttribute('data-visible', 'true');
      } else {
        bar.setAttribute('data-visible', 'false');
      }
    }
    window.addEventListener('scroll', checkScroll, { passive: true });
    checkScroll();

    // Quantity Stepper Controller
    var minusBtn = document.getElementById('pst-qty-minus-' + sid);
    var plusBtn = document.getElementById('pst-qty-plus-' + sid);
    var qtyInput = document.getElementById('pst-qty-val-' + sid);
    if (minusBtn && plusBtn && qtyInput) {
      minusBtn.addEventListener('click', function() {
        var val = parseInt(qtyInput.value, 10) || 1;
        if (val > 1) qtyInput.value = val - 1;
      });
      plusBtn.addEventListener('click', function() {
        var val = parseInt(qtyInput.value, 10) || 1;
        if (val < 99) qtyInput.value = val + 1;
      });
    }

    // Configuration Modal Controller
    var modalOverlay = document.getElementById('pst-modal-' + sid);
    var modalClose = document.getElementById('pst-modal-close-' + sid);
    var configBtn = document.getElementById('pst-config-btn-' + sid);
    var applyBtn = document.getElementById('pst-apply-config-' + sid);
    var variantLabel = document.getElementById('pst-variant-label-' + sid);

    if (modalOverlay && modalClose && configBtn) {
      configBtn.addEventListener('click', function() {
        modalOverlay.setAttribute('data-open', 'true');
        modalOverlay.setAttribute('aria-hidden', 'false');
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });

      // Option card selection
      var optCards = modalOverlay.querySelectorAll('.pst-opt-card');
      optCards.forEach(function(card) {
        card.addEventListener('click', function() {
          optCards.forEach(function(c) { c.setAttribute('data-selected', 'false'); });
          card.setAttribute('data-selected', 'true');
          if (variantLabel) {
            variantLabel.innerText = card.getAttribute('data-name') || 'Custom Edition';
          }
        });
      });

      if (applyBtn) {
        applyBtn.addEventListener('click', function() {
          closeModal();
          alert('Configuration applied. Ready for acquisition.');
        });
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Sticky Add To Cart Bar",
  "tag": "section",
  "class": "section-product-sticky-add-to-cart",
  "settings": [
    {
      "type": "header",
      "content": "Bar Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Bar Background",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#38bdf8"
    },
    {
      "type": "range",
      "id": "scroll_threshold",
      "label": "Scroll Depth Trigger (px)",
      "min": 100,
      "max": 1000,
      "step": 50,
      "default": 400
    }
  ],
  "presets": [
    {
      "name": "Sticky Add To Cart Bar"
    }
  ]
}
{% endschema %}
