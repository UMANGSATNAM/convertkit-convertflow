{%- comment -%}
  story_materials_showcase.liquid — Ultra-Comprehensive Materials & Sustainability Explorer
  
  DESIGN PHILOSOPHY:
  An interactive material engineering and sustainability showcase designed to highlight
  premium craftsmanship and ethical sourcing. Features interactive material swatch selectors,
  live environmental impact scorebars, macro photography crossfade transitions, and an
  accessible laboratory inspection modal dialog to view durability test certificates.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --sms-bg: {{ section.settings.bg_color | default: '#0f172a' }};
    --sms-card-bg: {{ section.settings.card_bg_color | default: '#1e293b' }};
    --sms-text: {{ section.settings.text_color | default: '#f8fafc' }};
    --sms-muted: color-mix(in srgb, var(--sms-text) 65%, transparent);
    --sms-border: color-mix(in srgb, var(--sms-text) 14%, transparent);
    --sms-accent: {{ section.settings.accent_color | default: '#34d399' }};
    --sms-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --sms-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --sms-padding-top: clamp(4rem, 8vw, 7rem);
    --sms-padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .sms-section {
    background-color: var(--sms-bg);
    color: var(--sms-text);
    font-family: var(--sms-font-body);
    padding: var(--sms-padding-top) clamp(1.25rem, 4vw, 4rem) var(--sms-padding-bottom);
    border-top: 1px solid var(--sms-border);
    border-bottom: 1px solid var(--sms-border);
    position: relative;
    overflow: hidden;
  }

  .sms-container {
    max-width: 1360px;
    margin: 0 auto;
  }

  /* Section Header */
  .sms-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto clamp(2.5rem, 5vw, 4.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .sms-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--sms-accent);
    background: color-mix(in srgb, var(--sms-accent) 12%, transparent);
    padding: 0.4rem 1rem;
    border-radius: 100px;
    border: 1px solid color-mix(in srgb, var(--sms-accent) 30%, transparent);
  }
  .sms-title {
    font-family: var(--sms-font-head);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 700;
    color: var(--sms-text);
    line-height: 1.15;
    margin: 0;
  }
  .sms-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--sms-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Material Swatch Selector Bar */
  .sms-swatch-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .sms-swatch-btn {
    background: color-mix(in srgb, var(--sms-text) 6%, transparent);
    color: var(--sms-text);
    border: 1px solid var(--sms-border);
    border-radius: 100px;
    padding: 0.65rem 1.4rem;
    font-family: var(--sms-font-body);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .sms-swatch-btn:hover {
    background: color-mix(in srgb, var(--sms-text) 12%, transparent);
    transform: translateY(-2px);
  }
  .sms-swatch-btn.active {
    background: var(--sms-accent);
    color: #000000;
    border-color: var(--sms-accent);
    box-shadow: 0 8px 20px -4px color-mix(in srgb, var(--sms-accent) 50%, transparent);
  }
  .sms-swatch-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: currentColor;
    border: 2px solid rgba(255, 255, 255, 0.3);
  }

  /* Main Showcase Panel */
  .sms-showcase {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    background: var(--sms-card-bg);
    border: 1px solid var(--sms-border);
    border-radius: 32px;
    padding: clamp(2rem, 5vw, 4rem);
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.4);
    align-items: center;
    transition: opacity 0.3s ease;
  }
  @media (min-width: 992px) {
    .sms-showcase {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .sms-showcase[data-transitioning="true"] {
    opacity: 0.3;
  }

  /* Macro Image Media */
  .sms-media-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 24px;
    overflow: hidden;
    position: relative;
    background: #0f172a;
    border: 1px solid var(--sms-border);
  }
  .sms-media-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .sms-showcase:hover .sms-media-wrap img {
    transform: scale(1.06);
  }
  .sms-media-badge {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--sms-accent);
    padding: 0.4rem 0.9rem;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border: 1px solid color-mix(in srgb, var(--sms-accent) 35%, transparent);
    z-index: 2;
  }

  /* Info Column */
  .sms-info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sms-mat-title {
    font-family: var(--sms-font-head);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }
  .sms-mat-origin {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--sms-accent);
    margin-top: -0.75rem;
  }
  .sms-mat-desc {
    font-size: 1rem;
    color: var(--sms-muted);
    line-height: 1.65;
    margin: 0;
  }

  /* Eco & Durability Metrics Bars */
  .sms-metrics {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .sms-metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .sms-metric-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .sms-metric-bar {
    width: 100%;
    height: 8px;
    background: color-mix(in srgb, var(--sms-text) 10%, transparent);
    border-radius: 100px;
    overflow: hidden;
  }
  .sms-metric-fill {
    height: 100%;
    background: var(--sms-accent);
    border-radius: 100px;
    transition: width 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Action Trigger */
  .sms-inspect-btn {
    margin-top: 0.5rem;
    background: transparent;
    color: var(--sms-text);
    border: 1px solid var(--sms-border);
    border-radius: 100px;
    padding: 0.85rem 1.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: fit-content;
    transition: all 0.2s ease;
  }
  .sms-inspect-btn:hover {
    background: var(--sms-accent);
    color: #000000;
    border-color: var(--sms-accent);
    transform: translateY(-2px);
  }
  .sms-inspect-btn svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 2.5;
  }

  /* Modal Dialog */
  .sms-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .sms-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .sms-modal {
    background: var(--sms-card-bg);
    color: var(--sms-text);
    border: 1px solid var(--sms-border);
    border-radius: 24px;
    max-width: 580px;
    width: 100%;
    padding: clamp(2rem, 5vw, 3rem);
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .sms-modal-overlay[data-open="true"] .sms-modal {
    transform: scale(1);
  }
  .sms-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: color-mix(in srgb, var(--sms-text) 10%, transparent);
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sms-text);
    cursor: pointer;
  }
</style>

<section class="sms-section" id="sms-section-{{ section.id }}" aria-labelledby="sms-title-{{ section.id }}">
  <div class="sms-container">
    
    {%- if section.settings.title != blank or section.settings.eyebrow != blank -%}
      <div class="sms-header">
        {%- if section.settings.eyebrow != blank -%}
          <div class="sms-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="sms-title-{{ section.id }}" class="sms-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="sms-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Swatch Selector Bar -->
    {%- if section.blocks.size > 0 -%}
      <div class="sms-swatch-bar" id="sms-swatches-{{ section.id }}" role="tablist">
        {%- for block in section.blocks -%}
          <button 
            type="button" 
            class="sms-swatch-btn {% if forloop.first %}active{% endif %}" 
            role="tab" 
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-title="{{ block.settings.title | escape }}"
            data-origin="{{ block.settings.origin | escape }}"
            data-desc="{{ block.settings.text | escape }}"
            data-recycled="{{ block.settings.recycled_percent | default: 95 }}"
            data-durability="{{ block.settings.durability_percent | default: 98 }}"
            data-img="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 }}{% endif %}"
            data-cert="{{ block.settings.certification | default: 'ISO-14001 Eco Certified' | escape }}"
            {{ block.shopify_attributes }}
          >
            <span class="sms-swatch-dot" style="background:{{ block.settings.swatch_color | default: '#34d399' }};"></span>
            <span>{{ block.settings.title }}</span>
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Main Showcase Panel -->
    {%- assign first_mat = section.blocks.first -%}
    <div class="sms-showcase" id="sms-showcase-{{ section.id }}">
      <div class="sms-media-wrap">
        <span class="sms-media-badge" id="sms-main-cert-{{ section.id }}">{{ first_mat.settings.certification | default: 'ISO-14001 Eco Certified' }}</span>
        {%- if first_mat.settings.image != blank -%}
          {{ first_mat.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', id: 'sms-main-img-' | append: section.id, alt: first_mat.settings.title }}
        {%- else -%}
          <div id="sms-main-img-{{ section.id }}" style="width:100%;height:100%;background:linear-gradient(135deg,#1e293b,#0f172a,#064e3b);display:flex;align-items:center;justify-content:center;color:#ffffff;font-weight:700;font-size:1.2rem;">Macro Texture Preview</div>
        {%- endif -%}
      </div>

      <div class="sms-info">
        <h3 class="sms-mat-title" id="sms-main-title-{{ section.id }}">{{ first_mat.settings.title | default: 'Aerospace Aluminum Alloy' }}</h3>
        <span class="sms-mat-origin" id="sms-main-origin-{{ section.id }}">{{ first_mat.settings.origin | default: 'Sourced from Sustainable Nordic Smelters' }}</span>
        <p class="sms-mat-desc" id="sms-main-desc-{{ section.id }}">{{ first_mat.settings.text | default: 'Our custom alloy utilizes 95% post-consumer recycled aluminum, achieving an exceptional strength-to-weight ratio while dramatically lowering our carbon footprint.' }}</p>

        <!-- Metrics Bars -->
        <div class="sms-metrics">
          <div class="sms-metric-item">
            <div class="sms-metric-header">
              <span>Recycled Content & Sustainability</span>
              <span id="sms-val-recycled-{{ section.id }}">{{ first_mat.settings.recycled_percent | default: 95 }}%</span>
            </div>
            <div class="sms-metric-bar">
              <div class="sms-metric-fill" id="sms-bar-recycled-{{ section.id }}" style="width: {{ first_mat.settings.recycled_percent | default: 95 }}%;"></div>
            </div>
          </div>

          <div class="sms-metric-item">
            <div class="sms-metric-header">
              <span>Laboratory Durability Rating</span>
              <span id="sms-val-durability-{{ section.id }}">{{ first_mat.settings.durability_percent | default: 98 }}%</span>
            </div>
            <div class="sms-metric-bar">
              <div class="sms-metric-fill" id="sms-bar-durability-{{ section.id }}" style="width: {{ first_mat.settings.durability_percent | default: 98 }}%;"></div>
            </div>
          </div>
        </div>

        <button type="button" class="sms-inspect-btn" id="sms-inspect-btn-{{ section.id }}" aria-label="Inspect material certifications">
          <span>Inspect Lab Certifications</span>
          <svg viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        </button>
      </div>
    </div>

  </div>

  <!-- Lab Inspection Modal -->
  <div class="sms-modal-overlay" id="sms-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="sms-modal">
      <button type="button" class="sms-modal-close" id="sms-modal-close-{{ section.id }}" aria-label="Close modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <h3 style="font-family:var(--sms-font-head);font-size:1.5rem;margin:0;">Laboratory Test Protocol</h3>
      <span class="sms-mat-origin" id="sms-modal-cert" style="margin-top:-0.5rem;">ISO-14001 Eco Certified</span>
      <p style="font-size:0.95rem;color:var(--sms-muted);line-height:1.6;margin:0;">Every material batch undergoes rigorous independent mechanical stress analysis, thermal cycling, and chemical purity verification before being cleared for assembly.</p>
      <div style="background:color-mix(in srgb,var(--sms-accent) 15%,transparent);color:var(--sms-accent);padding:0.85rem 1rem;border-radius:12px;font-weight:700;font-size:0.88rem;display:flex;align-items:center;gap:0.5rem;">
        <span>✓ Zero Hazardous Chemicals | RoHS & REACH Compliant</span>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('sms-section-' + sid);
    if (!sectionEl) return;

    // 1. Material Swatch Switcher Controller
    var swatchesWrap = document.getElementById('sms-swatches-' + sid);
    var showcase = document.getElementById('sms-showcase-' + sid);
    if (swatchesWrap && showcase) {
      var btns = swatchesWrap.querySelectorAll('.sms-swatch-btn');
      var titleEl = document.getElementById('sms-main-title-' + sid);
      var originEl = document.getElementById('sms-main-origin-' + sid);
      var descEl = document.getElementById('sms-main-desc-' + sid);
      var certEl = document.getElementById('sms-main-cert-' + sid);
      var imgEl = document.getElementById('sms-main-img-' + sid);

      var valRecycled = document.getElementById('sms-val-recycled-' + sid);
      var barRecycled = document.getElementById('sms-bar-recycled-' + sid);
      var valDurability = document.getElementById('sms-val-durability-' + sid);
      var barDurability = document.getElementById('sms-bar-durability-' + sid);

      btns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          btns.forEach(function(b) { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');

          showcase.setAttribute('data-transitioning', 'true');

          setTimeout(function() {
            if (titleEl) titleEl.innerText = btn.getAttribute('data-title') || '';
            if (originEl) originEl.innerText = btn.getAttribute('data-origin') || '';
            if (descEl) descEl.innerText = btn.getAttribute('data-desc') || '';
            if (certEl) certEl.innerText = btn.getAttribute('data-cert') || '';

            var rec = btn.getAttribute('data-recycled') || 90;
            var dur = btn.getAttribute('data-durability') || 95;
            if (valRecycled) valRecycled.innerText = rec + '%';
            if (barRecycled) barRecycled.style.width = rec + '%';
            if (valDurability) valDurability.innerText = dur + '%';
            if (barDurability) barDurability.style.width = dur + '%';

            var imgSrc = btn.getAttribute('data-img');
            if (imgEl && imgSrc && imgSrc !== 'null' && imgSrc !== '') {
              if (imgEl.tagName === 'IMG') imgEl.src = imgSrc;
              else imgEl.innerHTML = '<img src="' + imgSrc + '" style="width:100%;height:100%;object-fit:cover;">';
            }

            showcase.removeAttribute('data-transitioning');
          }, 200);
        });
      });
    }

    // 2. Inspection Modal Controller
    var modalOverlay = document.getElementById('sms-modal-' + sid);
    var modalClose = document.getElementById('sms-modal-close-' + sid);
    var inspectBtn = document.getElementById('sms-inspect-btn-' + sid);
    if (modalOverlay && modalClose && inspectBtn) {
      var modalCert = document.getElementById('sms-modal-cert');
      inspectBtn.addEventListener('click', function() {
        var activeBtn = swatchesWrap ? swatchesWrap.querySelector('.sms-swatch-btn.active') : null;
        if (modalCert && activeBtn) {
          modalCert.innerText = activeBtn.getAttribute('data-cert') || 'ISO-14001 Eco Certified';
        }
        modalOverlay.setAttribute('data-open', 'true');
        modalOverlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Materials & Eco Showcase",
  "tag": "section",
  "class": "section-materials-showcase",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#1e293b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#34d399"
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Sustainable Engineering"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Architectural Material Integrity"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "We believe true luxury is inseparable from sustainability. Explore our curated material palette, engineered for decades of heavy daily use."
    }
  ],
  "blocks": [
    {
      "type": "material",
      "name": "Material Swatch",
      "settings": [
        {
          "type": "color",
          "id": "swatch_color",
          "label": "Swatch Indicator Dot Color",
          "default": "#34d399"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Material Name",
          "default": "Aerospace Aluminum Alloy"
        },
        {
          "type": "text",
          "id": "origin",
          "label": "Sourcing Origin / Location",
          "default": "Sourced from Sustainable Nordic Smelters"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Our custom alloy utilizes 95% post-consumer recycled aluminum, achieving an exceptional strength-to-weight ratio while dramatically lowering our carbon footprint."
        },
        {
          "type": "range",
          "id": "recycled_percent",
          "label": "Recycled Content / Eco Score (%)",
          "min": 50,
          "max": 100,
          "step": 1,
          "default": 95
        },
        {
          "type": "range",
          "id": "durability_percent",
          "label": "Laboratory Durability Rating (%)",
          "min": 70,
          "max": 100,
          "step": 1,
          "default": 98
        },
        {
          "type": "text",
          "id": "certification",
          "label": "Laboratory Certification Tag",
          "default": "ISO-14001 Eco Certified"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Macro Texture Photography"
        }
      ]
    }
  ],
  "presets": [
