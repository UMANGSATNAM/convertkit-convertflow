{%- comment -%}
  utility_cookie_consent.liquid — Ultra-Comprehensive Privacy & Granular Cookie Consent
  
  DESIGN PHILOSOPHY:
  An architectural data privacy protocol engineered to respect client autonomy.
  Features a sleek floating glassmorphism banner, instant opt-in/opt-out buttons, and a comprehensive
  Granular Preference Center Modal Dialog allowing users to independently control Essential,
  Functional, Analytics, and Advertising telemetry tracking.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --ucc-bg: {{ section.settings.bg_color | default: '#0f172a' }};
    --ucc-text: {{ section.settings.text_color | default: '#f8fafc' }};
    --ucc-muted: color-mix(in srgb, var(--ucc-text) 65%, transparent);
    --ucc-border: color-mix(in srgb, var(--ucc-text) 16%, transparent);
    --ucc-accent: {{ section.settings.accent_color | default: '#38bdf8' }};
    --ucc-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --ucc-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
  }

  /* Floating Bottom Banner */
  .ucc-banner {
    position: fixed;
    bottom: clamp(1rem, 3vw, 2.5rem);
    left: clamp(1rem, 3vw, 2.5rem);
    right: clamp(1rem, 3vw, 2.5rem);
    max-width: 960px;
    margin: 0 auto;
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    color: var(--ucc-text);
    font-family: var(--ucc-font-body);
    border: 1px solid var(--ucc-border);
    border-radius: 28px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.85);
    z-index: 99990;
    display: none;
    flex-direction: column;
    gap: 1.5rem;
    animation: ucc-slide-up 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ucc-banner[data-visible="true"] {
    display: flex;
  }
  @keyframes ucc-slide-up {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .ucc-top-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }
  .ucc-title-box {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 600px;
  }
  .ucc-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--ucc-accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ucc-eyebrow::before {
    content: "";
    width: 14px;
    height: 2px;
    background: var(--ucc-accent);
  }
  .ucc-title {
    font-family: var(--ucc-font-head);
    font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    font-weight: 700;
    margin: 0;
    line-height: 1.25;
  }
  .ucc-desc {
    font-size: 0.92rem;
    color: var(--ucc-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Action Buttons */
  .ucc-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .ucc-btn-accept {
    background: var(--ucc-text);
    color: var(--ucc-bg);
    font-weight: 700;
    font-size: 0.88rem;
    border: none;
    padding: 0.85rem 1.6rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .ucc-btn-accept:hover {
    background: var(--ucc-accent);
    color: #ffffff;
    transform: translateY(-2px);
  }
  .ucc-btn-reject {
    background: transparent;
    color: var(--ucc-text);
    font-weight: 700;
    font-size: 0.88rem;
    border: 1px solid var(--ucc-border);
    padding: 0.85rem 1.5rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .ucc-btn-reject:hover {
    background: color-mix(in srgb, var(--ucc-text) 10%, transparent);
    border-color: var(--ucc-text);
  }
  .ucc-btn-custom {
    background: transparent;
    color: var(--ucc-muted);
    font-weight: 700;
    font-size: 0.82rem;
    border: none;
    padding: 0.85rem 1rem;
    cursor: pointer;
    text-decoration: underline;
    transition: color 0.2s ease;
  }
  .ucc-btn-custom:hover { color: var(--ucc-text); }

  /* Granular Preference Center Lightbox Modal */
  .ucc-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .ucc-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .ucc-modal {
    background: #0f172a;
    color: var(--ucc-text);
    border: 1px solid var(--ucc-border);
    border-radius: 36px;
    max-width: 680px;
    width: 100%;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 40px 80px -15px rgba(0, 0, 0, 0.95);
    position: relative;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ucc-modal-overlay[data-open="true"] .ucc-modal {
    transform: scale(1);
  }
  .ucc-modal-head {
    padding: 2rem 2.5rem 1.5rem;
    border-bottom: 1px solid var(--ucc-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .ucc-modal-body {
    padding: 2rem 2.5rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .ucc-modal-foot {
    padding: 1.5rem 2.5rem;
    border-top: 1px solid var(--ucc-border);
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    background: color-mix(in srgb, var(--ucc-text) 3%, transparent);
  }
  .ucc-modal-close {
    background: color-mix(in srgb, var(--ucc-text) 10%, transparent);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ucc-text);
    cursor: pointer;
  }

  /* Toggle Switch Item */
  .ucc-toggle-row {
    background: color-mix(in srgb, var(--ucc-text) 4%, transparent);
    border: 1px solid var(--ucc-border);
    border-radius: 20px;
    padding: 1.25rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .ucc-toggle-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .ucc-toggle-title { font-family: var(--ucc-font-head); font-size: 1.05rem; font-weight: 700; margin: 0; color: var(--ucc-text); }
  .ucc-toggle-desc { font-size: 0.85rem; color: var(--ucc-muted); line-height: 1.5; margin: 0; }

  .ucc-switch {
    position: relative;
    display: inline-block;
    width: 50px;
    height: 28px;
    flex-shrink: 0;
  }
  .ucc-switch input { opacity: 0; width: 0; height: 0; }
  .ucc-slider {
    position: absolute;
    cursor: pointer;
    inset: 0;
    background: #334155;
    border-radius: 34px;
    transition: 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ucc-slider:before {
    position: absolute;
    content: "";
    height: 20px;
    width: 20px;
    left: 4px;
    bottom: 4px;
    background: #ffffff;
    border-radius: 50%;
    transition: 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  input:checked + .ucc-slider { background: var(--ucc-accent); }
  input:checked + .ucc-slider:before { transform: translateX(22px); }
  input:disabled + .ucc-slider { opacity: 0.5; cursor: not-allowed; }
</style>

<!-- Floating Consent Banner -->
<div class="ucc-banner" id="ucc-banner-{{ section.id }}" data-visible="false" role="region" aria-label="Privacy & Cookie Consent">
  <div class="ucc-top-row">
    <div class="ucc-title-box">
      <div class="ucc-eyebrow">{{ section.settings.eyebrow | default: 'Data Privacy Protocol' }}</div>
      <h3 class="ucc-title">{{ section.settings.title | default: 'Zürich Telemetry Transparency' }}</h3>
      <p class="ucc-desc">{{ section.settings.desc | default: 'We utilize encrypted telemetry cookies to optimize your workstation browsing experience, analyze studio traffic, and personalize audio-visual hardware recommendations. We never sell personal identifying information.' }}</p>
    </div>
  </div>

  <div class="ucc-actions">
    <button type="button" class="ucc-btn-accept" id="ucc-accept-all-{{ section.id }}">Accept All Telemetry</button>
    <button type="button" class="ucc-btn-reject" id="ucc-reject-all-{{ section.id }}">Essential Only</button>
    <button type="button" class="ucc-btn-custom" id="ucc-custom-btn-{{ section.id }}">Manage Granular Preferences →</button>
  </div>
</div>

<!-- Granular Preference Center Modal -->
<div class="ucc-modal-overlay" id="ucc-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="ucc-modal">
    <div class="ucc-modal-head">
      <div>
        <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.18em;color:var(--ucc-accent);margin-bottom:0.25rem;">Preference Architecture</div>
        <h3 style="font-family:var(--ucc-font-head);font-size:1.5rem;margin:0;">Granular Consent Manager</h3>
      </div>
      <button type="button" class="ucc-modal-close" id="ucc-modal-close-{{ section.id }}" aria-label="Close preference center">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <div class="ucc-modal-body">
      <p style="font-size:0.92rem;color:var(--ucc-muted);line-height:1.6;margin:0;">Control how our Swiss servers interact with your local device. Essential cookies are strictly required for security, session verification, and checkout continuity.</p>

      <!-- Essential Cookies (Locked) -->
      <div class="ucc-toggle-row">
        <div class="ucc-toggle-info">
          <h4 class="ucc-toggle-title">1. Essential Security & Cart Operations</h4>
          <p class="ucc-toggle-desc">Strictly required for shopping bag persistence, SSL encryption verification, and anti-fraud bot mitigation. Cannot be disabled.</p>
        </div>
        <label class="ucc-switch">
          <input type="checkbox" checked disabled>
          <span class="ucc-slider"></span>
        </label>
      </div>

      <!-- Functional Cookies -->
      <div class="ucc-toggle-row">
        <div class="ucc-toggle-info">
          <h4 class="ucc-toggle-title">2. Functional Studio Preferences</h4>
          <p class="ucc-toggle-desc">Remembers your localized currency, selected acoustic sound test previews, and wishlist item allocations across sessions.</p>
        </div>
        <label class="ucc-switch">
          <input type="checkbox" id="ucc-check-func-{{ section.id }}" checked>
          <span class="ucc-slider"></span>
        </label>
      </div>

      <!-- Analytics Cookies -->
      <div class="ucc-toggle-row">
        <div class="ucc-toggle-info">
          <h4 class="ucc-toggle-title">3. Telemetry & Performance Analytics</h4>
          <p class="ucc-toggle-desc">Anonymously monitors page render latency, 3D model frame rates, and navigation paths to help our engineers optimize our digital architecture.</p>
        </div>
        <label class="ucc-switch">
          <input type="checkbox" id="ucc-check-stat-{{ section.id }}" checked>
          <span class="ucc-slider"></span>
        </label>
      </div>

      <!-- Advertising Cookies -->
      <div class="ucc-toggle-row">
        <div class="ucc-toggle-info">
          <h4 class="ucc-toggle-title">4. Targeted Hardware Communications</h4>
          <p class="ucc-toggle-desc">Allows us and our verified publication partners to inform you when new limited-run Series workstation allocations become available in your region.</p>
        </div>
        <label class="ucc-switch">
          <input type="checkbox" id="ucc-check-mkt-{{ section.id }}">
          <span class="ucc-slider"></span>
        </label>
      </div>
    </div>

    <div class="ucc-modal-foot">
      <button type="button" class="ucc-btn-reject" id="ucc-save-custom-{{ section.id }}" style="background:var(--ucc-text);color:var(--ucc-bg);border:none;">Save Granular Preferences</button>
    </div>
  </div>
</div>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var banner = document.getElementById('ucc-banner-' + sid);
    if (!banner) return;

    var storageKey = 'atelier_telemetry_consent_v1';
    var hasConsent = localStorage.getItem(storageKey);

    // Show banner after 1.5s if no preference saved
    if (!hasConsent) {
      setTimeout(function() {
        banner.setAttribute('data-visible', 'true');
      }, 1500);
    }

    function saveConsent(func, stat, mkt) {
      var prefs = { essential: true, functional: func, analytics: stat, marketing: mkt, timestamp: new Date().toISOString() };
      localStorage.setItem(storageKey, JSON.stringify(prefs));
      banner.setAttribute('data-visible', 'false');
      if (typeof window.onAtelierConsentUpdated === 'function') {
        window.onAtelierConsentUpdated(prefs);
      }
    }

    var acceptAll = document.getElementById('ucc-accept-all-' + sid);
    var rejectAll = document.getElementById('ucc-reject-all-' + sid);
    if (acceptAll) acceptAll.addEventListener('click', function() { saveConsent(true, true, true); });
    if (rejectAll) rejectAll.addEventListener('click', function() { saveConsent(false, false, false); });

    // Modal Controller
    var modalOverlay = document.getElementById('ucc-modal-' + sid);
    var modalClose = document.getElementById('ucc-modal-close-' + sid);
    var customBtn = document.getElementById('ucc-custom-btn-' + sid);
    var saveCustom = document.getElementById('ucc-save-custom-' + sid);

    if (modalOverlay && modalClose && customBtn && saveCustom) {
      customBtn.addEventListener('click', function() {
        modalOverlay.setAttribute('data-open', 'true');
        modalOverlay.setAttribute('aria-hidden', 'false');
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });

      saveCustom.addEventListener('click', function() {
        var funcVal = document.getElementById('ucc-check-func-' + sid).checked;
        var statVal = document.getElementById('ucc-check-stat-' + sid).checked;
        var mktVal = document.getElementById('ucc-check-mkt-' + sid).checked;
        saveConsent(funcVal, statVal, mktVal);
        closeModal();
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Privacy Cookie Consent",
  "tag": "section",
  "class": "section-utility-cookie-consent",
  "settings": [
    {
      "type": "header",
      "content": "Banner Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Banner Background",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#38bdf8"
    },
    {
      "type": "header",
      "content": "Banner Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Data Privacy Protocol"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Zürich Telemetry Transparency"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Description",
      "default": "We utilize encrypted telemetry cookies to optimize your workstation browsing experience, analyze studio traffic, and personalize audio-visual hardware recommendations. We never sell personal identifying information."
    }
  ],
  "presets": [
    {
      "name": "Privacy Cookie Consent"
    }
  ]
}
{% endschema %}
