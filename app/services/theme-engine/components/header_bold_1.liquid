{%- comment -%}
  header_bold_1.liquid — Bold / Streetwear Header
  
  DESIGN PHILOSOPHY:
  Loud, graphic, unapologetic. Thick borders, uppercase everything,
  monospace type. Inspired by brutalist/streetwear aesthetics.
  
  FEATURES:
  • High-contrast accent background
  • Heavy border-bottom (4px)
  • Cart count in bracket notation [CART: 3]
  • Mobile slide-out drawer with bold nav
  • Announcement ticker integration
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --bhdr-bg: var(--color-accent, #ff3c00);
    --bhdr-text: var(--color-text, #000);
    --bhdr-font: var(--font-body, 'Roboto Mono', monospace);
    --bhdr-font-logo: var(--font-heading, 'Anton', sans-serif);
    --bhdr-height: 68px;
    --bhdr-border: 4px;
  }

  .bd-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bhdr-bg);
    border-bottom: var(--bhdr-border) solid var(--bhdr-text);
  }

  .bd-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--bhdr-height);
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2.5rem);
  }

  /* ── LEFT NAV ──────────────────── */
  .bd-header__nav {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1.75rem;
  }
  @media (min-width: 800px) {
    .bd-header__nav { display: flex; }
  }
  .bd-header__nav-link {
    font-family: var(--bhdr-font);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--bhdr-text);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease;
  }
  .bd-header__nav-link:hover,
  .bd-header__nav-link[aria-current="page"] {
    border-color: var(--bhdr-text);
  }

  /* ── CENTER LOGO ───────────────── */
  .bd-header__logo {
    font-family: var(--bhdr-font-logo);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--bhdr-text);
    text-decoration: none;
    text-transform: uppercase;
  }
  .bd-header__logo-img {
    max-height: 44px;
    width: auto;
  }

  /* ── RIGHT ACTIONS ─────────────── */
  .bd-header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .bd-header__action {
    font-family: var(--bhdr-font);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--bhdr-text);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .bd-header__action:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── MOBILE BURGER ─────────────── */
  .bd-header__burger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px 0;
    width: 26px;
  }
  .bd-header__burger span {
    display: block;
    height: 3px;
    background: var(--bhdr-text);
  }
  @media (min-width: 800px) {
    .bd-header__burger { display: none; }
  }

  /* ── MOBILE DRAWER ─────────────── */
  .bd-drawer-bg {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .bd-drawer-bg[data-open="true"] {
    opacity: 1;
    visibility: visible;
  }

  .bd-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: min(90vw, 380px);
    height: 100%;
    background: var(--bhdr-bg);
    border-left: var(--bhdr-border) solid var(--bhdr-text);
    z-index: 201;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .bd-drawer[data-open="true"] {
    transform: translateX(0);
  }

  .bd-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: var(--bhdr-border) solid var(--bhdr-text);
  }
  .bd-drawer__close {
    font-family: var(--bhdr-font);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    background: none;
    border: 2px solid var(--bhdr-text);
    color: var(--bhdr-text);
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .bd-drawer__close:hover {
    background: var(--bhdr-text);
    color: var(--bhdr-bg);
  }

  .bd-drawer__nav {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bd-drawer__nav-link {
    display: block;
    font-family: var(--bhdr-font-logo);
    font-size: 2rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--bhdr-text);
    text-decoration: none;
    padding: 1rem 1.5rem;
    border-bottom: 2px solid color-mix(in srgb, var(--bhdr-text) 20%, transparent);
    transition: padding-left 0.2s ease;
  }
  .bd-drawer__nav-link:hover {
    padding-left: 2.5rem;
  }

  .bd-drawer__footer {
    margin-top: auto;
    padding: 1.5rem;
    border-top: var(--bhdr-border) solid var(--bhdr-text);
    font-family: var(--bhdr-font);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    display: flex;
    gap: 1.5rem;
  }
  .bd-drawer__footer a {
    color: var(--bhdr-text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .bd-drawer__footer a:hover {
    border-color: var(--bhdr-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .bd-drawer, .bd-drawer-bg { transition: none; }
  }
</style>

{%- comment -%} ══ MOBILE DRAWER ══ {%- endcomment -%}
<div class="bd-drawer-bg" data-open="false" id="bd-bg-{{ section.id }}"
  onclick="this.dataset.open='false'; document.getElementById('bd-drawer-{{ section.id }}').dataset.open='false'"></div>
<nav class="bd-drawer" data-open="false" id="bd-drawer-{{ section.id }}" aria-label="Mobile navigation">
  <div class="bd-drawer__header">
    <a href="{{ routes.root_url }}" class="bd-header__logo" style="font-size: 1.5rem;">{{ shop.name }}</a>
    <button class="bd-drawer__close"
      onclick="document.getElementById('bd-drawer-{{ section.id }}').dataset.open='false'; document.getElementById('bd-bg-{{ section.id }}').dataset.open='false'"
      aria-label="Close menu">[ CLOSE ]</button>
  </div>
  <ul class="bd-drawer__nav">
    {%- for link in linklists[section.settings.menu].links -%}
      <li>
        <a href="{{ link.url }}" class="bd-drawer__nav-link">{{ link.title }}</a>
      </li>
    {%- endfor -%}
  </ul>
  <div class="bd-drawer__footer">
    <a href="{{ routes.search_url }}">Search</a>
    <a href="{{ routes.account_url }}">Account</a>
  </div>
</nav>

{%- comment -%} ══ MAIN HEADER ══ {%- endcomment -%}
<header class="bd-header">
  <div class="bd-header__inner">

    {%- comment -%} Mobile burger {%- endcomment -%}
    <button class="bd-header__burger" aria-label="Open menu"
      onclick="document.getElementById('bd-drawer-{{ section.id }}').dataset.open='true'; document.getElementById('bd-bg-{{ section.id }}').dataset.open='true'">
      <span></span>
      <span></span>
      <span></span>
    </button>

    {%- comment -%} Desktop nav {%- endcomment -%}
    <ul class="bd-header__nav" role="navigation" aria-label="Main navigation">
      {%- for link in linklists[section.settings.menu].links -%}
        <li>
          <a href="{{ link.url }}" class="bd-header__nav-link"
            {% if link.current %} aria-current="page"{% endif %}>
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- comment -%} Center logo {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="bd-header__logo">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 300 | image_tag: class: 'bd-header__logo-img', alt: shop.name }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    {%- comment -%} Right actions {%- endcomment -%}
    <div class="bd-header__actions">
      <a href="{{ routes.search_url }}" class="bd-header__action" aria-label="Search">[ SEARCH ]</a>
      <a href="{{ routes.cart_url }}" class="bd-header__action">[ CART: {{ cart.item_count }} ]</a>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Bold Header",
  "tag": "section",
  "class": "section-header-bold",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image",
      "info": "Recommended: bold, high-contrast PNG."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Sticky Header",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_override",
      "label": "Header Background Override",
      "info": "Overrides the theme accent color for this header."
    }
  ],
  "presets": [
    {
      "name": "Bold Header"
    }
  ]
}
{% endschema %}
