{%- comment -%}
  trust_instagram_mentions.liquid — Ultra-Comprehensive Shoppable Instagram & UGC Feed
  
  DESIGN PHILOSOPHY:
  An authentic social proof commerce engine that converts lifestyle UGC into direct sales.
  Features shoppable product tags on user photos, simulated interactive like heart animation
  with localStorage persistence, verified handle badges, and an accessible Social Post
  Inspection Modal Dialog to view full captions and instant product buy links.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --tim-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --tim-card-bg: {{ section.settings.card_bg_color | default: '#f8fafc' }};
    --tim-text: {{ section.settings.text_color | default: '#0f172a' }};
    --tim-muted: color-mix(in srgb, var(--tim-text) 60%, transparent);
    --tim-border: color-mix(in srgb, var(--tim-text) 12%, transparent);
    --tim-accent: {{ section.settings.accent_color | default: '#e11d48' }};
    --tim-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --tim-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --tim-padding-top: clamp(3.5rem, 8vw, 6.5rem);
    --tim-padding-bottom: clamp(3.5rem, 8vw, 6.5rem);
    --tim-gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .tim-section {
    background-color: var(--tim-bg);
    color: var(--tim-text);
    font-family: var(--tim-font-body);
    padding: var(--tim-padding-top) clamp(1.25rem, 4vw, 4rem) var(--tim-padding-bottom);
    border-bottom: 1px solid var(--tim-border);
    position: relative;
  }

  .tim-container {
    max-width: 1440px;
    margin: 0 auto;
  }

  /* Section Header */
  .tim-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    text-align: center;
    max-width: 800px;
    margin: 0 auto clamp(2.5rem, 6vw, 4.5rem);
  }
  @media (min-width: 1024px) {
    .tim-header {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
      max-width: none;
    }
  }
  .tim-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .tim-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--tim-accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tim-eyebrow::before {
    content: "";
    width: 20px;
    height: 2px;
    background: var(--tim-accent);
  }
  .tim-title {
    font-family: var(--tim-font-head);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }
  .tim-desc {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    color: var(--tim-muted);
    line-height: 1.6;
    margin: 0;
    max-width: 520px;
  }

  /* Follow CTA Button */
  .tim-follow-btn {
    background: var(--tim-text);
    color: var(--tim-bg);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    padding: 1rem 2.25rem;
    border-radius: 100px;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    white-space: nowrap;
    box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.15);
  }
  .tim-follow-btn:hover {
    background: var(--tim-accent);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 15px 30px -5px color-mix(in srgb, var(--tim-accent) 45%, transparent);
  }
  .tim-follow-btn svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  /* Shoppable Social Grid */
  .tim-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--tim-gap);
  }
  @media (min-width: 640px) {
    .tim-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .tim-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    }
  }

  /* Social Card */
  .tim-card {
    background: var(--tim-card-bg);
    border: 1px solid var(--tim-border);
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    cursor: pointer;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, border-color 0.2s ease;
  }
  .tim-card:hover {
    transform: translateY(-8px);
    border-color: var(--tim-text);
    box-shadow: 0 25px 50px -15px rgba(0, 0, 0, 0.12);
  }

  /* Photo Box */
  .tim-media {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #0f172a;
    position: relative;
    overflow: hidden;
  }
  .tim-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tim-card:hover .tim-media img {
    transform: scale(1.08);
  }

  /* Floating Shoppable Tag */
  .tim-shop-tag {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.45rem 0.85rem;
    border-radius: 100px;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.2s ease;
    z-index: 5;
  }
  .tim-card:hover .tim-shop-tag {
    background: #ffffff;
    color: #000000;
  }
  .tim-shop-tag svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  /* Card Content */
  .tim-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex-grow: 1;
  }
  .tim-user-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .tim-username {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--tim-text);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .tim-verified {
    color: #38bdf8;
    display: inline-flex;
  }
  .tim-verified svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  /* Likes / Comments simulation */
  .tim-engagement {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.82rem;
    color: var(--tim-muted);
    font-weight: 600;
  }
  .tim-like-btn {
    background: transparent;
    border: none;
    color: var(--tim-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.2s ease;
  }
  .tim-like-btn:hover,
  .tim-like-btn.liked {
    color: #e11d48;
    transform: scale(1.15);
  }
  .tim-like-btn svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .tim-caption {
    font-size: 0.88rem;
    color: var(--tim-muted);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Social Inspection Modal Dialog */
  .tim-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .tim-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .tim-modal {
    background: var(--tim-bg);
    color: var(--tim-text);
    border: 1px solid var(--tim-border);
    border-radius: 28px;
    max-width: 860px;
    width: 100%;
    overflow: hidden;
    position: relative;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.7);
    display: grid;
    grid-template-columns: 1fr;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (min-width: 768px) {
    .tim-modal {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .tim-modal-overlay[data-open="true"] .tim-modal {
    transform: scale(1);
  }
  .tim-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(0, 0, 0, 0.5);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
    z-index: 10;
  }
  .tim-modal-media {
    width: 100%;
    height: 100%;
    min-height: 320px;
    background: #000000;
  }
  .tim-modal-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tim-modal-info {
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .tim-modal-user {
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .tim-modal-caption {
    font-size: 0.95rem;
    color: var(--tim-muted);
    line-height: 1.65;
    margin: 0;
  }
  .tim-modal-product-box {
    margin-top: auto;
    background: var(--tim-card-bg);
    border: 1px solid var(--tim-border);
    border-radius: 16px;
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .tim-modal-cta {
    background: var(--tim-text);
    color: var(--tim-bg);
    font-weight: 700;
    text-decoration: none;
    padding: 0.75rem 1.35rem;
    border-radius: 100px;
    font-size: 0.85rem;
    transition: background 0.2s ease;
  }
  .tim-modal-cta:hover {
    background: var(--tim-accent);
    color: #ffffff;
  }
</style>

<section class="tim-section" id="tim-section-{{ section.id }}" aria-labelledby="tim-title-{{ section.id }}">
  <div class="tim-container">
    
    <!-- Section Header -->
    <div class="tim-header">
      <div class="tim-title-wrap">
        {%- if section.settings.eyebrow != blank -%}
          <div class="tim-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="tim-title-{{ section.id }}" class="tim-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="tim-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.follow_url != blank -%}
        <a href="{{ section.settings.follow_url }}" target="_blank" rel="noopener noreferrer" class="tim-follow-btn">
          <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path></svg>
          <span>{{ section.settings.follow_label | default: 'Follow Us @obsidian.atelier' }}</span>
        </a>
      {%- endif -%}
    </div>

    <!-- Shoppable Social Grid -->
    <div class="tim-grid" id="tim-grid-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div 
          class="tim-card" 
          data-user="{{ block.settings.username | default: '@obsidian_user' | escape }}"
          data-caption="{{ block.settings.caption | escape }}"
          data-product="{{ block.settings.product_name | default: 'Obsidian Workstation' | escape }}"
          data-price="{{ block.settings.product_price | default: '$450.00' | escape }}"
          data-link="{{ block.settings.product_url | default: '/products/sample' }}"
          data-img="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 }}{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="tim-media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.username }}
            {%- else -%}
              <div style="width:100%;height:100%;background:#333;display:flex;align-items:center;justify-content:center;color:#666;">UGC #{{ forloop.index }}</div>
            {%- endif -%}

            {%- if block.settings.show_tag -%}
              <div class="tim-shop-tag">
                <svg viewBox="0 0 24 24"><path d="M16 6V4a4 4 0 00-8 0v2H3v14a2 2 0 002 2h14a2 2 0 002-2V6h-5zM10 4a2 2 0 014 0v2h-4V4zm8 16H6V8h2v2c0 .55.45 1 1 1s1-.45 1-1V8h4v2c0 .55.45 1 1 1s1-.45 1-1V8h2v12z"></path></svg>
                <span>Shop Look: {{ block.settings.product_price | default: '$450' }}</span>
              </div>
            {%- endif -%}
          </div>

          <div class="tim-info">
            <div class="tim-user-row">
              <span class="tim-username">
                <span>{{ block.settings.username | default: '@obsidian_user' }}</span>
                <span class="tim-verified"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"></path></svg></span>
              </span>

              <div class="tim-engagement">
                <button type="button" class="tim-like-btn" data-id="tim-like-{{ section.id }}-{{ forloop.index }}" aria-label="Like post">
                  <svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path></svg>
                  <span class="tim-like-cnt">{{ block.settings.likes_count | default: 342 }}</span>
                </button>
              </div>
            </div>

            <p class="tim-caption">{{ block.settings.caption }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>

  <!-- Social Inspection Modal -->
  <div class="tim-modal-overlay" id="tim-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="tim-modal">
      <button type="button" class="tim-modal-close" id="tim-modal-close-{{ section.id }}" aria-label="Close modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div class="tim-modal-media">
        <img src="" id="tim-modal-img" alt="Enlarged UGC" style="display:none;">
      </div>

      <div class="tim-modal-info">
        <span class="tim-modal-user">
          <span id="tim-modal-user">@username</span>
          <span class="tim-verified"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"></path></svg></span>
        </span>

        <p class="tim-modal-caption" id="tim-modal-caption">Full social caption will display here with hashtags and user tagging.</p>

        <div class="tim-modal-product-box">
          <div>
            <span style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--tim-muted);">Featured in Post</span>
            <h4 id="tim-modal-product" style="margin:0;font-size:1rem;">Obsidian Workstation</h4>
            <span id="tim-modal-price" style="font-size:0.9rem;font-weight:700;color:var(--tim-accent);">$450.00</span>
          </div>
          <a href="/products/sample" class="tim-modal-cta" id="tim-modal-cta">Shop This Look →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('tim-section-' + sid);
    if (!sectionEl) return;

    // 1. Like Heart Counter with localStorage
    var likeBtns = sectionEl.querySelectorAll('.tim-like-btn');
    likeBtns.forEach(function(lbtn) {
      lbtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var lid = lbtn.getAttribute('data-id');
        var cntSpan = lbtn.querySelector('.tim-like-cnt');
        if (!cntSpan || !lid) return;

        if (localStorage.getItem(lid)) {
          lbtn.classList.remove('liked');
          cntSpan.innerText = parseInt(cntSpan.innerText, 10) - 1;
          localStorage.removeItem(lid);
        } else {
          lbtn.classList.add('liked');
          cntSpan.innerText = parseInt(cntSpan.innerText, 10) + 1;
          localStorage.setItem(lid, 'true');
        }
      });
    });

    // 2. Inspection Modal Controller
    var modalOverlay = document.getElementById('tim-modal-' + sid);
    var modalClose = document.getElementById('tim-modal-close-' + sid);
    if (modalOverlay && modalClose) {
      var userEl = document.getElementById('tim-modal-user');
      var capEl = document.getElementById('tim-modal-caption');
      var prodEl = document.getElementById('tim-modal-product');
      var priceEl = document.getElementById('tim-modal-price');
      var ctaEl = document.getElementById('tim-modal-cta');
      var imgEl = document.getElementById('tim-modal-img');

      var cards = sectionEl.querySelectorAll('.tim-card');
      cards.forEach(function(card) {
        card.addEventListener('click', function() {
          if (userEl) userEl.innerText = card.getAttribute('data-user') || '@obsidian_user';
          if (capEl) capEl.innerText = card.getAttribute('data-caption') || '';
          if (prodEl) prodEl.innerText = card.getAttribute('data-product') || 'Obsidian Workstation';
          if (priceEl) priceEl.innerText = card.getAttribute('data-price') || '$450.00';
          if (ctaEl) ctaEl.href = card.getAttribute('data-link') || '/products/sample';

          var imgSrc = card.getAttribute('data-img');
          if (imgEl) {
            if (imgSrc && imgSrc !== 'null' && imgSrc !== '') {
              imgEl.src = imgSrc;
              imgEl.style.display = 'block';
            } else {
              imgEl.style.display = 'none';
            }
          }

          modalOverlay.setAttribute('data-open', 'true');
          modalOverlay.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Instagram Mentions Feed",
  "tag": "section",
  "class": "section-trust-instagram",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#e11d48"
    },
    {
      "type": "header",
      "content": "Social Grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop Feed Columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Section Header & Follow Link"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "#ObsidianInTheWild"
    },
    {
      "type": "text",
