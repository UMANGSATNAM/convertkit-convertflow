{%- comment -%}
  util_mobile_bottom_nav.liquid — Mobile Sticky Bottom Navigation
  
  DESIGN PHILOSOPHY:
  App-like experience for mobile shoppers. Fixed bottom bar with
  glassmorphic backdrop blur, interactive icons (Home, Search, Shop, Cart),
  dynamic cart badge count, and customizable navigation links.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --mbn-bg: color-mix(in srgb, var(--color-background, #ffffff) 85%, transparent);
    --mbn-text: var(--color-text, #18181b);
    --mbn-muted: color-mix(in srgb, var(--mbn-text) 50%, transparent);
    --mbn-border: color-mix(in srgb, var(--mbn-text) 12%, transparent);
    --mbn-accent: var(--color-accent, #2563eb);
    --mbn-font: var(--font-body, 'Inter', -apple-system, sans-serif);
  }

  .mbn-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: var(--mbn-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--mbn-border);
    padding: 0.5rem 1rem clamp(0.5rem, env(safe-area-inset-bottom), 1.25rem);
    display: flex;
    justify-content: space-around;
    align-items: center;
    z-index: 980;
    box-shadow: 0 -4px 16px -4px rgba(0, 0, 0, 0.08);
  }
  @media (min-width: 768px) {
    .mbn-bar {
      display: none;
    }
  }

  .mbn-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    text-decoration: none;
    color: var(--mbn-muted);
    font-family: var(--mbn-font);
    font-size: 0.68rem;
    font-weight: 500;
    transition: color 0.2s ease, transform 0.15s ease;
    position: relative;
    flex: 1;
  }
  .mbn-item:hover, .mbn-item.is-active {
    color: var(--mbn-accent);
  }
  .mbn-item:active {
    transform: scale(0.92);
  }

  .mbn-icon {
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mbn-icon svg {
    width: 20px;
    height: 20px;
    stroke-width: 1.8;
    stroke: currentColor;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mbn-badge {
    position: absolute;
    top: -2px;
    right: calc(50% - 16px);
    background: var(--mbn-accent);
    color: #ffffff;
    font-size: 0.6rem;
    font-weight: 700;
    padding: 0.1rem 0.35rem;
    border-radius: 100px;
    min-width: 16px;
    text-align: center;
    line-height: 1;
  }
</style>

<nav class="mbn-bar" aria-label="Mobile Bottom Navigation">
  {%- for block in section.blocks -%}
    <a
      href="{{ block.settings.url | default: '/' }}"
      class="mbn-item {% if request.path == block.settings.url %}is-active{% endif %}"
      {{ block.shopify_attributes }}
    >
      <span class="mbn-icon">
        {%- case block.settings.icon -%}
          {%- when 'home' -%}
            <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          {%- when 'search' -%}
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          {%- when 'shop' -%}
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          {%- when 'cart' -%}
            <svg viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            <span class="mbn-badge" id="mbn-cart-count-{{ section.id }}" style="display: {% if cart.item_count > 0 %}block{% else %}none{% endif %}">{{ cart.item_count | default: 0 }}</span>
          {%- when 'account' -%}
            <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          {%- else -%}
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
        {%- endcase -%}
      </span>
      <span>{{ block.settings.title }}</span>
    </a>
  {%- endfor -%}
</nav>

{% schema %}
{
  "name": "Mobile Bottom Nav",
  "tag": "section",
  "class": "section-util-mobile-nav",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Nav Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "home", "label": "Home" },
            { "value": "search", "label": "Search" },
            { "value": "shop", "label": "Shop / Grid" },
            { "value": "cart", "label": "Cart" },
            { "value": "account", "label": "Account" }
          ],
          "default": "home"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label Text",
          "default": "Home"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mobile Bottom Nav",
      "blocks": [
        { "type": "item", "settings": { "icon": "home", "title": "Home", "url": "/" } },
        { "type": "item", "settings": { "icon": "shop", "title": "Shop", "url": "/collections/all" } },
        { "type": "item", "settings": { "icon": "search", "title": "Search", "url": "/search" } },
        { "type": "item", "settings": { "icon": "cart", "title": "Cart", "url": "/cart" } },
        { "type": "item", "settings": { "icon": "account", "title": "Account", "url": "/account" } }
      ]
    }
  ]
}
{% endschema %}
