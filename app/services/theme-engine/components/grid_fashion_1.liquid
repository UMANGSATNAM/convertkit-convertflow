{%- comment -%}
  grid_fashion_1.liquid — Fashion Editorial Lookbook Grid
  
  DESIGN PHILOSOPHY:
  Runway lookbook presentation. Tall portrait aspect ratios (3:4 or 4:5),
  serif headlines, minimalist look numbering, and subtle zoom effects.
  Designed for seasonal collections, capsules, and fashion campaigns.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --fhg-bg: var(--color-background, #fff);
    --fhg-text: var(--color-text, #111);
    --fhg-muted: color-mix(in srgb, var(--fhg-text) 45%, transparent);
    --fhg-border: color-mix(in srgb, var(--fhg-text) 10%, transparent);
    --fhg-font: var(--font-body, 'Inter', -apple-system, sans-serif);
    --fhg-font-serif: var(--font-heading, 'Cormorant Garamond', Georgia, serif);
  }

  .fhg-section {
    background: var(--fhg-bg);
    padding: clamp(3.5rem, 8vw, 7rem) clamp(1.25rem, 4vw, 4rem);
    border-top: 1px solid var(--fhg-border);
  }

  .fhg-inner {
    max-width: 1360px;
    margin: 0 auto;
  }

  .fhg-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--fhg-border);
    padding-bottom: 1.5rem;
  }
  .fhg-title-wrap {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }
  .fhg-title {
    font-family: var(--fhg-font-serif);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fhg-text);
    margin: 0;
  }
  .fhg-season {
    font-family: var(--fhg-font);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--fhg-muted);
  }
  .fhg-link {
    font-family: var(--fhg-font);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fhg-text);
    text-decoration: none;
    border-bottom: 1px solid var(--fhg-text);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }
  .fhg-link:hover {
    color: var(--fhg-muted);
    border-color: var(--fhg-muted);
  }

  .fhg-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  @media (min-width: 640px) {
    .fhg-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .fhg-grid[data-cols="3"] { grid-template-columns: repeat(3, 1fr); }
    .fhg-grid[data-cols="4"] { grid-template-columns: repeat(4, 1fr); }
  }

  .fhg-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--fhg-text);
  }

  .fhg-media {
    aspect-ratio: var(--aspect, 3/4);
    background: color-mix(in srgb, var(--fhg-text) 3%, transparent);
    overflow: hidden;
    position: relative;
    margin-bottom: 1.25rem;
  }
  .fhg-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fhg-card:hover .fhg-media img {
    transform: scale(1.05);
  }

  .fhg-look-num {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: var(--fhg-bg);
    color: var(--fhg-text);
    font-family: var(--fhg-font-serif);
    font-size: 0.85rem;
    font-style: italic;
    padding: 0.25rem 0.6rem;
    z-index: 2;
  }

  .fhg-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .fhg-card-title {
    font-family: var(--fhg-font);
    font-size: 0.9rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }
  .fhg-card-sub {
    font-family: var(--fhg-font-serif);
    font-size: 0.95rem;
    font-style: italic;
    color: var(--fhg-muted);
    margin: 0.2rem 0 0 0;
  }
  .fhg-card-price {
    font-family: var(--fhg-font);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.05em;
  }
</style>

<section class="fhg-section" aria-label="Fashion Lookbook">
  <div class="fhg-inner">
    {%- if section.settings.title != blank or section.settings.season != blank or section.settings.cta_text != blank -%}
      <div class="fhg-header">
        <div class="fhg-title-wrap">
          {%- if section.settings.title != blank -%}
            <h2 class="fhg-title">{{ section.settings.title }}</h2>
          {%- endif -%}
          {%- if section.settings.season != blank -%}
            <span class="fhg-season">{{ section.settings.season }}</span>
          {%- endif -%}
        </div>
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="fhg-link">{{ section.settings.cta_text }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="fhg-grid" data-cols="{{ section.settings.columns | default: '3' }}" style="--aspect: {{ section.settings.aspect_ratio | default: '3/4' }};">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.url | default: '#' }}" class="fhg-card" {{ block.shopify_attributes }}>
          <div class="fhg-media">
            <span class="fhg-look-num">Look {{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- else -%}
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--fhg-muted); font-size: 0.8rem;">
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
          <div class="fhg-meta">
            <div>
              <h3 class="fhg-card-title">{{ block.settings.title | default: 'Silk Trench Coat' }}</h3>
              {%- if block.settings.subtitle != blank -%}
                <p class="fhg-card-sub">{{ block.settings.subtitle }}</p>
              {%- endif -%}
            </div>
            {%- if block.settings.price != blank -%}
              <span class="fhg-card-price">{{ block.settings.price }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fashion Lookbook Grid",
  "tag": "section",
  "class": "section-grid-fashion",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "The Lookbook"
    },
    {
      "type": "text",
      "id": "season",
      "label": "Season / Subtitle",
      "default": "Autumn / Winter"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Link Text",
      "default": "Explore Collection →"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link URL"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Desktop Columns",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Tall (4:5)" },
        { "value": "2/3", "label": "Editorial Tall (2:3)" }
      ],
      "default": "3/4"
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look / Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Structured Wool Blazer" },
        { "type": "text", "id": "subtitle", "label": "Subtitle / Fabric", "default": "100% Virgin Wool" },
        { "type": "text", "id": "price", "label": "Price", "default": "$890" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fashion Lookbook Grid",
      "blocks": [
        { "type": "look", "settings": { "title": "Structured Wool Blazer", "subtitle": "Charcoal Melange", "price": "$890" } },
        { "type": "look", "settings": { "title": "Pleated Silk Trousers", "subtitle": "Fluid Drape", "price": "$540" } },
        { "type": "look", "settings": { "title": "Cashmere Turtleneck", "subtitle": "Ribbed Knit", "price": "$420" } }
      ]
    }
  ]
}
{% endschema %}
