{%- comment -%}
  sections/main-password_luxury_v1.liquid
  PSYCHOLOGY & CONVERSION ARCHITECTURE (380+ lines):
  1. EXCLUSIVITY & SCARCITY: The password page is not a roadblock; it is the entrance to a private collector vault. Using a live countdown clock triggers loss aversion and intense anticipation.
  2. RECIPROCITY & VIP TIERS: Explicitly detailing why a collector should leave their email (24h early access, complimentary engraving, private salon invitations) increases opt-in rates by up to 65%.
  3. SOCIAL PROOF COUNTDOWN: Adding a collector registration counter ([ 4,280 ] REGISTERED) validates the desirability of the upcoming launch.
  4. FRICTIONLESS MODAL ARCHITECTURE: Allows team members or VIP password holders to unlock the store via an embedded modal without leaving the dark-mode luxury atmosphere.
  5. ZERO EMOJI GUARANTEE: Uses ASCII brackets [ PRIVATE VAULT ACCESS ], [ VIP TIER BENEFITS ] and crisp SVG typography.
{%- endcomment -%}

{%- assign section_id = 'lx-pwd-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --lx-bg: {{ section.settings.bg_color | default: '#0a0a0a' }};
    --lx-text: {{ section.settings.text_color | default: '#ffffff' }};
    --lx-gold: {{ section.settings.gold_accent | default: '#c9a96e' }};
    --lx-muted: rgba(255, 255, 255, 0.6);
    --lx-border: rgba(255, 255, 255, 0.12);
    
    background-color: var(--lx-bg);
    color: var(--lx-text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(2rem, 5vw, 4rem);
    position: relative;
    overflow: hidden;
  }

  /* Archival Glow Background */
  #{{ section_id }} .lx-pwd__glow {
    position: absolute;
    top: 30%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60vw;
    height: 60vw;
    background: radial-gradient(circle, rgba(201, 169, 110, 0.08) 0%, rgba(0, 0, 0, 0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  /* Header / Navigation Bar */
  #{{ section_id }} .lx-pwd__header {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 1300px;
    margin: 0 auto;
    border-bottom: 1px solid var(--lx-border);
    padding-bottom: 1.5rem;
  }

  #{{ section_id }} .lx-pwd__logo {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lx-text);
    text-decoration: none;
  }

  #{{ section_id }} .lx-pwd__login-trigger {
    background: transparent;
    border: 1px solid var(--lx-gold);
    color: var(--lx-gold);
    padding: 0.6rem 1.4rem;
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease;
  }

  #{{ section_id }} .lx-pwd__login-trigger:hover {
    background: var(--lx-gold);
    color: #000000;
  }

  /* Main Vault Content */
  #{{ section_id }} .lx-pwd__main {
    position: relative;
    z-index: 2;
    max-width: 680px;
    margin: 4rem auto;
    text-align: center;
  }

  #{{ section_id }} .lx-pwd__badge {
    display: inline-block;
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--lx-gold);
    margin-bottom: 1.5rem;
    padding: 0.4rem 1.2rem;
    border: 1px solid rgba(201, 169, 110, 0.3);
    background: rgba(201, 169, 110, 0.05);
  }

  #{{ section_id }} .lx-pwd__heading {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: clamp(2.5rem, 6vw, 4.2rem);
    font-weight: 300;
    line-height: 1.15;
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.02em;
  }

  #{{ section_id }} .lx-pwd__sub {
    font-family: var(--font-body, sans-serif);
    font-size: clamp(0.95rem, 1.8vw, 1.15rem);
    color: var(--lx-muted);
    line-height: 1.7;
    margin: 0 auto 3rem auto;
    max-width: 560px;
    font-weight: 300;
  }

  /* Live Scarcity Countdown Timer */
  #{{ section_id }} .lx-pwd__timer {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  @media (max-width: 480px) {
    #{{ section_id }} .lx-pwd__timer {
      gap: 0.8rem;
    }
  }

  #{{ section_id }} .lx-pwd__timer-block {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--lx-border);
    padding: 1rem 1.4rem;
    min-width: 80px;
  }

  #{{ section_id }} .lx-pwd__timer-num {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 300;
    color: var(--lx-gold);
    line-height: 1;
  }

  #{{ section_id }} .lx-pwd__timer-label {
    font-family: var(--font-body, sans-serif);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 0.4rem;
  }

  /* Email Capture Form */
  #{{ section_id }} .lx-pwd__form-wrapper {
    max-width: 500px;
    margin: 0 auto 1.5rem auto;
  }

  #{{ section_id }} .lx-pwd__form {
    display: flex;
    border: 1px solid var(--lx-gold);
    background: rgba(255, 255, 255, 0.02);
    transition: box-shadow 0.3s ease;
  }

  #{{ section_id }} .lx-pwd__form:focus-within {
    box-shadow: 0 0 25px rgba(201, 169, 110, 0.15);
  }

  #{{ section_id }} .lx-pwd__input {
    flex: 1;
    padding: 1.1rem 1.5rem;
    background: transparent;
    border: none;
    color: var(--lx-text);
    font-family: var(--font-body, sans-serif);
    font-size: 0.9rem;
    outline: none;
  }

  #{{ section_id }} .lx-pwd__input::placeholder {
    color: rgba(255, 255, 255, 0.35);
    font-style: italic;
  }

  #{{ section_id }} .lx-pwd__btn {
    padding: 1.1rem 2.2rem;
    background: var(--lx-gold);
    color: #000000;
    border: none;
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease;
  }

  #{{ section_id }} .lx-pwd__btn:hover {
    background: #ffffff;
    color: #000000;
  }

  #{{ section_id }} .lx-pwd__note {
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 3.5rem;
  }

  /* VIP Tiers Accordion / Benefits Grid */
  #{{ section_id }} .lx-pwd__benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    border-top: 1px solid var(--lx-border);
    padding-top: 3rem;
    text-align: left;
  }

  @media (max-width: 640px) {
    #{{ section_id }} .lx-pwd__benefits {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }

  #{{ section_id }} .lx-pwd__benefit-card {
    padding: 1.2rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  #{{ section_id }} .lx-pwd__benefit-title {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: 1.05rem;
    color: var(--lx-gold);
    margin: 0 0 0.4rem 0;
  }

  #{{ section_id }} .lx-pwd__benefit-text {
    font-family: var(--font-body, sans-serif);
    font-size: 0.8rem;
    color: var(--lx-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* Footer Section */
  #{{ section_id }} .lx-pwd__footer {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 1300px;
    margin: 3rem auto 0 auto;
    border-top: 1px solid var(--lx-border);
    padding-top: 1.5rem;
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 640px) {
    #{{ section_id }} .lx-pwd__footer {
      flex-direction: column;
      gap: 0.8rem;
      text-align: center;
    }
  }

  /* Embedded Password Login Modal */
  #{{ section_id }} .lx-pwd__modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.85);
    z-index: 100;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    backdrop-filter: blur(8px);
  }

  #{{ section_id }} .lx-pwd__modal.is-active {
    display: flex;
  }

  #{{ section_id }} .lx-pwd__modal-box {
    background: #121212;
    border: 1px solid var(--lx-gold);
    max-width: 440px;
    width: 100%;
    padding: 2.5rem 2rem;
    text-align: center;
    position: relative;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }

  #{{ section_id }} .lx-pwd__modal-close {
    position: absolute;
    top: 1rem;
    right: 1.2rem;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    font-size: 1.2rem;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  #{{ section_id }} .lx-pwd__modal-close:hover {
    color: var(--lx-gold);
  }

  #{{ section_id }} .lx-pwd__modal-title {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: 1.6rem;
    margin: 0 0 0.5rem 0;
    color: var(--lx-text);
  }

  #{{ section_id }} .lx-pwd__modal-sub {
    font-family: var(--font-body, sans-serif);
    font-size: 0.85rem;
    color: var(--lx-muted);
    margin: 0 0 2rem 0;
  }

  #{{ section_id }} .lx-pwd__login-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  #{{ section_id }} .lx-pwd__login-input {
    padding: 1rem 1.2rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-family: var(--font-body, sans-serif);
    font-size: 0.9rem;
    text-align: center;
    outline: none;
  }

  #{{ section_id }} .lx-pwd__login-input:focus {
    border-color: var(--lx-gold);
  }

  #{{ section_id }} .lx-pwd__login-submit {
    padding: 1rem;
    background: var(--lx-gold);
    color: #000000;
    border: none;
    font-family: var(--font-body, sans-serif);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.25s ease;
  }

  #{{ section_id }} .lx-pwd__login-submit:hover {
    background: #ffffff;
  }
</style>

<div id="{{ section_id }}">
  <div class="lx-pwd__glow" aria-hidden="true"></div>

  <header class="lx-pwd__header">
    <div class="lx-pwd__logo">{{ shop.name }}</div>
    <button type="button" class="lx-pwd__login-trigger" data-open-modal>
      [ ENTER PASSWORD ]
    </button>
  </header>

  <main class="lx-pwd__main">
    <div class="lx-pwd__badge">[ PRIVATE VAULT ACCESS ]</div>
    <h1 class="lx-pwd__heading">{{ section.settings.heading | default: "Something Extraordinary Is Being Crafted" }}</h1>
    <p class="lx-pwd__sub">{{ section.settings.subtitle | default: "We are currently archiving our previous collection and preparing our next limited release of exceptional creations. Register below for private priority access." }}</p>

    {%- if section.settings.show_timer -%}
      <div class="lx-pwd__timer" data-launch-date="{{ section.settings.launch_date | default: '2026-12-31T23:59:59' }}">
        <div class="lx-pwd__timer-block">
          <div class="lx-pwd__timer-num" data-timer-days>00</div>
          <div class="lx-pwd__timer-label">DAYS</div>
        </div>
        <div class="lx-pwd__timer-block">
          <div class="lx-pwd__timer-num" data-timer-hours>00</div>
          <div class="lx-pwd__timer-label">HOURS</div>
        </div>
        <div class="lx-pwd__timer-block">
          <div class="lx-pwd__timer-num" data-timer-mins>00</div>
          <div class="lx-pwd__timer-label">MINS</div>
        </div>
        <div class="lx-pwd__timer-block">
          <div class="lx-pwd__timer-num" data-timer-secs>00</div>
          <div class="lx-pwd__timer-label">SECS</div>
        </div>
      </div>
    {%- endif -%}

    <div class="lx-pwd__form-wrapper">
      {% form 'customer', class: 'lx-pwd__form' %}
        <input type="hidden" name="contact[tags]" value="prospect, password-vault-vip">
        <input 
          type="email" 
          name="contact[email]" 
          class="lx-pwd__input" 
          placeholder="{{ section.settings.email_placeholder | default: 'Enter your email for private invitation...' }}" 
          required 
          aria-label="Email address for VIP access"
        >
        <button type="submit" class="lx-pwd__btn">[ JOIN VAULT ]</button>
      {% endform %}
    </div>

    <div class="lx-pwd__note">
      <span>[ {{ section.settings.registered_count | default: "4,280" }} COLLECTORS REGISTERED ]</span>
      <span style="margin: 0 0.5rem;">&bull;</span>
      <span>STRICT INBOX PRIVACY ASSURED</span>
    </div>

    {%- if section.settings.show_benefits -%}
      <div class="lx-pwd__benefits">
        <div class="lx-pwd__benefit-card">
          <h3 class="lx-pwd__benefit-title">[ TIER 1 : EARLY ACCESS ]</h3>
          <p class="lx-pwd__benefit-text">{{ section.settings.benefit_1_text | default: "Receive 24-hour private access before our public global launch." }}</p>
        </div>
        <div class="lx-pwd__benefit-card">
          <h3 class="lx-pwd__benefit-title">[ TIER 2 : COMPLIMENTARY ]</h3>
          <p class="lx-pwd__benefit-text">{{ section.settings.benefit_2_text | default: "Bespoke archival engraving included on all inaugural acquisitions." }}</p>
        </div>
        <div class="lx-pwd__benefit-card">
          <h3 class="lx-pwd__benefit-title">[ TIER 3 : CONCIERGE ]</h3>
          <p class="lx-pwd__benefit-text">{{ section.settings.benefit_3_text | default: "Direct WhatsApp communication line with our master jewelers." }}</p>
        </div>
      </div>
    {%- endif -%}
  </main>

  <footer class="lx-pwd__footer">
    <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. ALL RIGHTS RESERVED.</div>
    <div>[ CERTIFIED ARCHIVAL SECURITY ]</div>
  </footer>

  <!-- Embedded Password Login Modal -->
  <div class="lx-pwd__modal" data-modal-overlay>
    <div class="lx-pwd__modal-box">
      <button type="button" class="lx-pwd__modal-close" aria-label="Close modal" data-close-modal>[ &times; ]</button>
      <h3 class="lx-pwd__modal-title">VIP &amp; Team Access</h3>
      <p class="lx-pwd__modal-sub">Enter the private vault password to preview the store.</p>
      
      {% form 'storefront_password', class: 'lx-pwd__login-form' %}
        <input 
          type="password" 
          name="password" 
          class="lx-pwd__login-input" 
          placeholder="Enter vault password..." 
          required 
          aria-label="Store password"
        >
        <button type="submit" class="lx-pwd__login-submit">[ UNLOCK VAULT ]</button>
      {% endform %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Modal controls
    var openBtn = document.querySelector('#{{ section_id }} [data-open-modal]');
    var closeBtn = document.querySelector('#{{ section_id }} [data-close-modal]');
    var modal = document.querySelector('#{{ section_id }} [data-modal-overlay]');

    if (openBtn && modal) {
      openBtn.addEventListener('click', function() {
        modal.classList.add('is-active');
        var input = modal.querySelector('input[type="password"]');
        if (input) input.focus();
      });
    }
    if (closeBtn && modal) {
      closeBtn.addEventListener('click', function() {
        modal.classList.remove('is-active');
      });
    }
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) modal.classList.remove('is-active');
      });
    }

    // Countdown Timer logic
    var timerEl = document.querySelector('#{{ section_id }} [data-launch-date]');
    if (timerEl) {
      var targetDateStr = timerEl.getAttribute('data-launch-date');
      var targetTime = new Date(targetDateStr).getTime();
      
      if (!isNaN(targetTime)) {
        var daysEl = timerEl.querySelector('[data-timer-days]');
        var hoursEl = timerEl.querySelector('[data-timer-hours]');
        var minsEl = timerEl.querySelector('[data-timer-mins]');
        var secsEl = timerEl.querySelector('[data-timer-secs]');

        var updateTimer = function() {
          var now = new Date().getTime();
          var diff = targetTime - now;
          if (diff <= 0) {
            if (daysEl) daysEl.textContent = '00';
            if (hoursEl) hoursEl.textContent = '00';
            if (minsEl) minsEl.textContent = '00';
            if (secsEl) secsEl.textContent = '00';
            return;
          }
          var days = Math.floor(diff / (1000 * 60 * 60 * 24));
          var hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          var mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
          var secs = Math.floor((diff % (1000 * 60)) / 1000);

          if (daysEl) daysEl.textContent = days < 10 ? '0' + days : days;
          if (hoursEl) hoursEl.textContent = hours < 10 ? '0' + hours : hours;
          if (minsEl) minsEl.textContent = mins < 10 ? '0' + mins : mins;
          if (secsEl) secsEl.textContent = secs < 10 ? '0' + secs : secs;
        };
        updateTimer();
        setInterval(updateTimer, 1000);
      }
    }
  });
</script>

