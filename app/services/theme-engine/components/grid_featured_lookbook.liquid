{%- comment -%}
  grid_featured_lookbook.liquid — Ultra-Comprehensive Shoppable Lookbook & Hotspot Grid
  
  DESIGN PHILOSOPHY:
  An architectural editorial lookbook engineered to showcase complete workstation ecosystems.
  Features interactive pulsing hotspot pins placed at exact X/Y coordinates, hover quick-look
  product cards, and an accessible Editorial Lightbox Modal Dialog allowing clients to explore
  and acquire every component featured within the scene.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --gfl-bg: {{ section.settings.bg_color | default: '#0a0a0a' }};
    --gfl-card-bg: {{ section.settings.card_bg_color | default: '#171717' }};
    --gfl-text: {{ section.settings.text_color | default: '#f5f5f5' }};
    --gfl-muted: color-mix(in srgb, var(--gfl-text) 65%, transparent);
    --gfl-border: color-mix(in srgb, var(--gfl-text) 15%, transparent);
    --gfl-accent: {{ section.settings.accent_color | default: '#38bdf8' }};
    --gfl-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --gfl-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --gfl-padding-top: clamp(4rem, 8vw, 7rem);
    --gfl-padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .gfl-section {
    background-color: var(--gfl-bg);
    color: var(--gfl-text);
    font-family: var(--gfl-font-body);
    padding: var(--gfl-padding-top) clamp(1.25rem, 4vw, 4rem) var(--gfl-padding-bottom);
    border-bottom: 1px solid var(--gfl-border);
    position: relative;
  }

  .gfl-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* Section Header */
  .gfl-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--gfl-border);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .gfl-head-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 680px;
  }
  .gfl-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--gfl-accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .gfl-eyebrow::before {
    content: "";
    width: 20px;
    height: 2px;
    background: var(--gfl-accent);
  }
  .gfl-title {
    font-family: var(--gfl-font-head);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }
  .gfl-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--gfl-muted);
    line-height: 1.6;
    margin: 0;
  }
  .gfl-explore-btn {
    background: var(--gfl-text);
    color: var(--gfl-bg);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    padding: 0.9rem 1.85rem;
    border-radius: 100px;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .gfl-explore-btn:hover {
    background: var(--gfl-accent);
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* Lookbook Grid */
  .gfl-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
  }
  @media (min-width: 768px) {
    .gfl-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Lookbook Card */
  .gfl-card {
    background: var(--gfl-card-bg);
    border: 1px solid var(--gfl-border);
    border-radius: 36px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 4 / 3;
    box-shadow: 0 25px 50px -15px rgba(0, 0, 0, 0.7);
  }
  .gfl-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gfl-card:hover .gfl-img {
    transform: scale(1.05);
  }

  /* Pulsing Hotspot Pin */
  .gfl-pin {
    position: absolute;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #ffffff;
    border: 2px solid #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition: all 0.3s ease;
    z-index: 10;
  }
  .gfl-pin::before {
    content: "";
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1px solid #ffffff;
    opacity: 0.6;
    animation: gfl-pulse 2s infinite;
  }
  @keyframes gfl-pulse {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(1.6); opacity: 0; }
  }
  .gfl-pin:hover {
    background: var(--gfl-accent);
    border-color: var(--gfl-accent);
    transform: translate(-50%, -50%) scale(1.15);
  }
  .gfl-pin svg { width: 16px; height: 16px; stroke: currentColor; stroke-width: 2.5; fill: none; }

  /* Hotspot Preview Tooltip */
  .gfl-tooltip {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: #1e293b;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    padding: 0.85rem 1.15rem;
    width: max-content;
    max-width: 240px;
    box-shadow: 0 15px 30px -5px rgba(0, 0, 0, 0.8);
    opacity: 0;
    pointer-events: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .gfl-pin:hover .gfl-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .gfl-tool-title { font-family: var(--gfl-font-head); font-size: 0.9rem; font-weight: 700; margin: 0; color: #ffffff; }
  .gfl-tool-price { font-size: 0.82rem; font-weight: 700; color: var(--gfl-accent); }

  /* Bottom Card Label */
  .gfl-card-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2.5rem 2rem 1.75rem;
    background: linear-gradient(0deg, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.7) 60%, transparent 100%);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    z-index: 5;
  }
  .gfl-scene-title { font-family: var(--gfl-font-head); font-size: 1.35rem; font-weight: 700; margin: 0; color: #ffffff; }
  .gfl-scene-sub { font-size: 0.85rem; color: var(--gfl-muted); }

  /* Lookbook Lightbox Modal */
  .gfl-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .gfl-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .gfl-modal {
    background: #171717;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 36px;
    max-width: 960px;
    width: 100%;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    box-shadow: 0 40px 80px -15px rgba(0, 0, 0, 0.9);
    position: relative;
    transform: scale(0.95);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (min-width: 768px) {
    .gfl-modal {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  .gfl-modal-overlay[data-open="true"] .gfl-modal {
    transform: scale(1);
  }
  .gfl-modal-img-col {
    background: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
  }
  .gfl-modal-img-col img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gfl-modal-info-col {
    padding: clamp(2rem, 4vw, 3.5rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .gfl-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(255, 255, 255, 0.15);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
    z-index: 20;
  }
</style>

<section class="gfl-section" id="gfl-section-{{ section.id }}" aria-labelledby="gfl-title-{{ section.id }}">
  <div class="gfl-container">
    
    <!-- Section Header -->
    <div class="gfl-header">
      <div class="gfl-head-text">
        {%- if section.settings.eyebrow != blank -%}
          <div class="gfl-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="gfl-title-{{ section.id }}" class="gfl-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="gfl-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      <a href="{{ section.settings.btn_link | default: '/collections/all' }}" class="gfl-explore-btn">
        <span>Explore Complete Catalogue</span>
        <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.5;"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
    </div>

    <!-- Lookbook Grid -->
    <div class="gfl-grid" role="list">
      {%- for block in section.blocks -%}
        <div class="gfl-card" role="listitem" data-src="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1400 }}{% endif %}" data-scene="{{ block.settings.scene_title | default: 'Zürich Laboratory Setup' }}" data-sub="{{ block.settings.scene_sub | default: 'Series 04 Acoustic Ecosystem' }}" data-prod="{{ block.settings.product_title | default: 'Monolith Pro Workstation' }}" data-price="{{ block.settings.product_price | default: '$420.00' }}" {{ block.shopify_attributes }}>
          
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'gfl-img', alt: block.settings.scene_title }}
          {%- else -%}
            <div style="width:100%;height:100%;background:#1e293b;display:flex;align-items:center;justify-content:center;color:#64748b;font-weight:700;font-size:1.25rem;">Editorial Scene {{ forloop.index }}</div>
          {%- endif -%}

          <!-- Hotspot Pin -->
          <div class="gfl-pin" style="left: {{ block.settings.pin_x | default: 50 }}%; top: {{ block.settings.pin_y | default: 50 }}%;" aria-label="Inspect Tagged Product">
            <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            
            <div class="gfl-tooltip">
              <span class="gfl-tool-title">{{ block.settings.product_title | default: 'Monolith Pro Workstation' }}</span>
              <span class="gfl-tool-price">{{ block.settings.product_price | default: '$420.00' }}</span>
            </div>
          </div>

          <!-- Bottom Scene Info -->
          <div class="gfl-card-bar">
            <div>
              <h3 class="gfl-scene-title">{{ block.settings.scene_title | default: 'Zürich Laboratory Setup' }}</h3>
              <span class="gfl-scene-sub">{{ block.settings.scene_sub | default: 'Series 04 Acoustic Ecosystem' }}</span>
            </div>
            <span style="font-size:0.8rem;font-weight:700;color:var(--gfl-accent);text-transform:uppercase;letter-spacing:0.1em;">Inspect Setup →</span>
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>

  <!-- Editorial Lookbook Modal -->
  <div class="gfl-modal-overlay" id="gfl-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="gfl-modal">
      <button type="button" class="gfl-modal-close" id="gfl-modal-close-{{ section.id }}" aria-label="Close lookbook scene modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div class="gfl-modal-img-col">
        <img src="" id="gfl-modal-img" alt="Enlarged editorial setup scene">
      </div>

      <div class="gfl-modal-info-col">
        <div style="display:flex;flex-direction:column;gap:1rem;">
          <div style="display:flex;align-items:center;gap:0.75rem;">
            <span style="width:10px;height:10px;border-radius:50%;background:var(--gfl-accent);"></span>
            <span style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.18em;color:rgba(255,255,255,0.6);">Atelier Ecosystem Specification</span>
          </div>

          <h3 id="gfl-modal-scene" style="font-family:var(--gfl-font-head);font-size:2rem;margin:0;color:#ffffff;">Zürich Laboratory Setup</h3>
          <p id="gfl-modal-sub" style="font-size:0.95rem;color:rgba(255,255,255,0.7);margin:0;line-height:1.6;">A complete acoustic and ergonomic workspace configuration designed for continuous 12+ hour editing sessions without tactile fatigue.</p>
        </div>

        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:24px;padding:1.5rem;display:flex;flex-direction:column;gap:1.25rem;">
          <span style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:var(--gfl-accent);">Featured Primary Component</span>
          
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <div>
              <h4 id="gfl-modal-prod" style="font-family:var(--gfl-font-head);font-size:1.35rem;margin:0;color:#ffffff;">Monolith Pro Workstation</h4>
              <span id="gfl-modal-price" style="font-size:1.05rem;font-weight:700;color:var(--gfl-accent);">$420.00</span>
            </div>
          </div>

          <a href="/collections/all" style="background:#ffffff;color:#000000;font-weight:700;font-size:0.95rem;text-align:center;text-decoration:none;padding:1.1rem;border-radius:100px;transition:all 0.2s ease;display:block;">Acquire Component Specification →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('gfl-section-' + sid);
    if (!sectionEl) return;

    // Editorial Modal Controller
    var modalOverlay = document.getElementById('gfl-modal-' + sid);
    var modalClose = document.getElementById('gfl-modal-close-' + sid);
    if (modalOverlay && modalClose) {
      var imgEl = document.getElementById('gfl-modal-img');
      var sceneEl = document.getElementById('gfl-modal-scene');
      var subEl = document.getElementById('gfl-modal-sub');
      var prodEl = document.getElementById('gfl-modal-prod');
      var priceEl = document.getElementById('gfl-modal-price');

      var cards = sectionEl.querySelectorAll('.gfl-card');
      cards.forEach(function(card) {
        card.addEventListener('click', function() {
          var src = card.getAttribute('data-src');
          if (imgEl && src && src !== 'null' && src !== '') imgEl.src = src;
          else if (imgEl) imgEl.src = '';

          if (sceneEl) sceneEl.innerText = card.getAttribute('data-scene') || 'Setup Scene';
          if (subEl) subEl.innerText = card.getAttribute('data-sub') || 'Acoustic Ecosystem';
          if (prodEl) prodEl.innerText = card.getAttribute('data-prod') || 'Monolith Pro';
          if (priceEl) priceEl.innerText = card.getAttribute('data-price') || '$420.00';

          modalOverlay.setAttribute('data-open', 'true');
          modalOverlay.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Shoppable Editorial Grid",
  "tag": "section",
  "class": "section-grid-featured-lookbook",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#38bdf8"
    },
    {
      "type": "header",
      "content": "Section Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Editorial Architecture"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Workstation Ecosystems"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Explore curated Swiss workstation setups. Interact with hotspot pins to inspect and acquire serialized components directly from the scene."
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Explore Catalogue Link"
    }
  ],
  "blocks": [
    {
      "type": "scene",
      "name": "Editorial Scene",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Scene High-Res Photo"
        },
        {
          "type": "text",
          "id": "scene_title",
          "label": "Scene Title",
          "default": "Zürich Acoustic Workstation"
        },
        {
          "type": "text",
          "id": "scene_sub",
          "label": "Scene Subtitle",
          "default": "Series 04 Monolith Edition"
        },
        {
          "type": "header",
          "content": "Hotspot Pin Coordinates"
        },
        {
          "type": "range",
          "id": "pin_x",
          "label": "Pin Horizontal X Position (%)",
          "min": 10,
          "max": 90,
          "step": 1,
          "default": 48
        },
        {
          "type": "range",
          "id": "pin_y",
          "label": "Pin Vertical Y Position (%)",
          "min": 10,
          "max": 90,
          "step": 1,
          "default": 62
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Tagged Product Name",
          "default": "Monolith Series 04"
        },
        {
          "type": "text",
          "id": "product_price",
          "label": "Tagged Product Price",
          "default": "$420.00"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable Editorial Grid",
      "blocks": [
        { "type": "scene", "settings": { "scene_title": "Zürich Laboratory", "pin_x": 48, "pin_y": 62, "product_title": "Monolith Series 04" } },
        { "type": "scene", "settings": { "scene_title": "Minimal Executive Setup", "pin_x": 65, "pin_y": 45, "product_title": "Titanium Desk Mat" } }
      ]
    }
  ]
}
{% endschema %}
