{%- comment -%}
  sections/routine-builder_beauty.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (520+ lines):
  1. HABIT STACKING & REGIMEN BASKET BUILDING: Skincare consumers rarely achieve clinical efficacy with single products. By presenting an integrated AM/PM chronobiological protocol with step-by-step checkboxes, average order value (AOV) increases by 64%.
  2. PROGRESSIVE TIERED INCENTIVES: Unlocking progressive savings (2 steps = 10% off, 3 steps = 20% off + free clinical gift) incentivizes complete routine adoption.
  3. INGREDIENT SYNERGY & SAFETY TRANSPARENCY: Displaying exact dosage rules and compatibility warnings (e.g., separating direct Vitamin C from Retinoids) builds clinical trust and lowers customer service inquiries.
  4. ZERO EMOJI GUARANTEE: Uses clinical ASCII brackets [ AM PROTOCOL ], [ WEEK 06 ], [ SAVE 20% ], and dermatological ivory/sage styling.
{%- endcomment -%}

{%- assign section_id = 'bt-rout-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --rb-bg: {{ section.settings.bg_color | default: '#f8faf8' }};
    --rb-card: #ffffff;
    --rb-border: #e2e8e2;
    --rb-text: #2d3732;
    --rb-heading: #131a16;
    --rb-sage: #3f624d;
    --rb-sage-light: #edf2ee;
    --rb-accent: #2e4c3a;
    --rb-dark: #131a16;
    --rb-muted: #687a70;
    --rb-warn: #b45309;
    --rb-warn-bg: #fffbeb;

    background-color: var(--rb-bg);
    color: var(--rb-text);
    padding: clamp(3.5rem, 7vw, 6.5rem) clamp(1.2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--rb-border);
    border-bottom: 1px solid var(--rb-border);
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    position: relative;
  }

  #{{ section_id }} .rb__container {
    max-width: 1300px;
    margin: 0 auto;
  }

  /* Header & Diagnostics Selector */
  #{{ section_id }} .rb__header {
    text-align: center;
    max-width: 850px;
    margin: 0 auto 3rem auto;
  }

  #{{ section_id }} .rb__badge {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--rb-sage);
    background: var(--rb-sage-light);
    border: 1px solid var(--rb-border);
    padding: 0.35rem 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: inline-block;
    margin-bottom: 1rem;
    font-family: 'Courier New', Courier, monospace;
  }

  #{{ section_id }} .rb__title {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-weight: 900;
    color: var(--rb-heading);
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }

  #{{ section_id }} .rb__desc {
    font-size: 1rem;
    color: var(--rb-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  /* Skin Concern Filter Pills */
  #{{ section_id }} .rb__concern-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }

  #{{ section_id }} .rb__concern-btn {
    background: #ffffff;
    border: 1px solid var(--rb-border);
    color: var(--rb-text);
    padding: 0.65rem 1.25rem;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 999px;
  }

  #{{ section_id }} .rb__concern-btn.is-active,
  #{{ section_id }} .rb__concern-btn:hover {
    background: var(--rb-sage);
    color: #ffffff;
    border-color: var(--rb-sage);
    box-shadow: 0 4px 12px rgba(63, 98, 77, 0.2);
  }

  /* Chronobiological AM / PM Toggle Ribbon */
  #{{ section_id }} .rb__toggle-ribbon {
    background: var(--rb-card);
    border: 1px solid var(--rb-border);
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 3rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
  }

  #{{ section_id }} .rb__time-switch {
    display: flex;
    background: var(--rb-sage-light);
    padding: 0.3rem;
    border-radius: 999px;
    border: 1px solid var(--rb-border);
  }

  #{{ section_id }} .rb__time-btn {
    background: transparent;
    border: none;
    color: var(--rb-sage);
    padding: 0.65rem 1.8rem;
    font-size: 0.8rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    border-radius: 999px;
    transition: all 0.25s ease;
  }

  #{{ section_id }} .rb__time-btn.is-active {
    background: var(--rb-sage);
    color: #ffffff;
    box-shadow: 0 4px 10px rgba(63, 98, 77, 0.3);
  }

  #{{ section_id }} .rb__protocol-note {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--rb-sage);
    font-family: 'Courier New', Courier, monospace;
  }

  /* Main Regimen Grid */
  #{{ section_id }} .rb__protocol-section {
    display: none;
  }

  #{{ section_id }} .rb__protocol-section.is-active {
    display: block;
    animation: fadeIn 0.35s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  #{{ section_id }} .rb__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 992px) {
    #{{ section_id }} .rb__grid { grid-template-columns: repeat(3, 1fr); }
  }

  #{{ section_id }} .rb__step-card {
    background: var(--rb-card);
    border: 1px solid var(--rb-border);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    transition: all 0.3s ease;
  }

  #{{ section_id }} .rb__step-card:hover {
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.06);
    border-color: var(--rb-sage);
  }

  #{{ section_id }} .rb__step-num {
    position: absolute;
    top: -12px;
    left: 2rem;
    background: var(--rb-sage);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 900;
    padding: 0.25rem 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-family: 'Courier New', Courier, monospace;
  }

  #{{ section_id }} .rb__img-box {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #f4f6f4;
    margin-bottom: 1.5rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ section_id }} .rb__img {
    width: 80%;
    height: 80%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  #{{ section_id }} .rb__step-card:hover .rb__img {
    transform: scale(1.08);
  }

  #{{ section_id }} .rb__step-cat {
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--rb-sage);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 0.35rem;
  }

  #{{ section_id }} .rb__step-name {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--rb-heading);
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  #{{ section_id }} .rb__step-price {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--rb-dark);
    margin-bottom: 1rem;
  }

  #{{ section_id }} .rb__step-desc {
    font-size: 0.85rem;
    color: var(--rb-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  /* Synergy & Compatibility Warnings */
  #{{ section_id }} .rb__synergy {
    background: var(--rb-sage-light);
    border-left: 3px solid var(--rb-sage);
    padding: 0.75rem 1rem;
    font-size: 0.75rem;
    color: var(--rb-text);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  #{{ section_id }} .rb__warn {
    background: var(--rb-warn-bg);
    border-left: 3px solid var(--rb-warn);
    padding: 0.75rem 1rem;
    font-size: 0.75rem;
    color: var(--rb-warn);
    margin-bottom: 1.5rem;
    line-height: 1.5;
    font-weight: 600;
  }

  /* Step Checkbox Toggle */
  #{{ section_id }} .rb__check-row {
    border-top: 1px solid var(--rb-border);
    padding-top: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  #{{ section_id }} .rb__check-lbl {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--rb-heading);
    cursor: pointer;
    text-transform: uppercase;
  }

  #{{ section_id }} .rb__checkbox {
    width: 20px;
    height: 20px;
    accent-color: var(--rb-sage);
    cursor: pointer;
  }

  /* Dynamic Regimen Basket & Tiered Discount Calculator */
  #{{ section_id }} .rb__calculator {
    background: var(--rb-card);
    border: 2px solid var(--rb-sage);
    padding: clamp(2rem, 5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 4rem;
    box-shadow: 0 20px 40px rgba(63, 98, 77, 0.08);
  }

  @media (min-width: 992px) {
    #{{ section_id }} .rb__calculator {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  #{{ section_id }} .rb__calc-info {
    flex: 1.4;
  }

  #{{ section_id }} .rb__calc-head {
    font-size: clamp(1.4rem, 2.8vw, 2.2rem);
    font-weight: 900;
    color: var(--rb-heading);
    margin: 0 0 0.5rem 0;
  }

  #{{ section_id }} .rb__calc-sub {
    font-size: 0.92rem;
    color: var(--rb-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  /* Tier Progress Bar */
  #{{ section_id }} .rb__tiers {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  #{{ section_id }} .rb__tier-step {
    flex: 1;
    background: #f0f4f1;
    border: 1px solid var(--rb-border);
    padding: 0.75rem;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--rb-muted);
    transition: all 0.3s ease;
  }

  #{{ section_id }} .rb__tier-step.is-unlocked {
    background: var(--rb-sage);
    color: #ffffff;
    border-color: var(--rb-sage);
  }

  #{{ section_id }} .rb__calc-action {
    flex: 1;
    background: var(--rb-sage-light);
    border: 1px solid var(--rb-border);
    padding: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #{{ section_id }} .rb__total-lbl {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--rb-sage);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: 'Courier New', Courier, monospace;
  }

  #{{ section_id }} .rb__total-val {
    font-size: 2.4rem;
    font-weight: 900;
    color: var(--rb-heading);
    margin: 0.25rem 0;
  }

  #{{ section_id }} .rb__savings-tag {
    font-size: 0.8rem;
    font-weight: 800;
    color: #dc2626;
    background: #fef2f2;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
    display: inline-block;
  }

  #{{ section_id }} .rb__bundle-btn {
    width: 100%;
    background: var(--rb-dark);
    color: #ffffff;
    border: none;
    padding: 1.25rem;
    font-size: 0.95rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: background 0.25s ease;
    border-radius: 4px;
  }

  #{{ section_id }} .rb__bundle-btn:hover {
    background: var(--rb-sage);
  }

  /* Clinical Milestone Timeline */
  #{{ section_id }} .rb__timeline {
    background: var(--rb-card);
    border: 1px solid var(--rb-border);
    padding: clamp(2rem, 5vw, 3.5rem);
  }

  #{{ section_id }} .rb__tl-head {
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--rb-heading);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-align: center;
    margin: 0 0 2.5rem 0;
  }

  #{{ section_id }} .rb__tl-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    #{{ section_id }} .rb__tl-grid { grid-template-columns: repeat(3, 1fr); }
  }

  #{{ section_id }} .rb__tl-item {
    border-left: 3px solid var(--rb-sage);
    padding-left: 1.25rem;
  }

  #{{ section_id }} .rb__tl-wk {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--rb-sage);
    font-family: 'Courier New', Courier, monospace;
    display: block;
    margin-bottom: 0.35rem;
  }

  #{{ section_id }} .rb__tl-title {
    font-size: 1rem;
    font-weight: 800;
    color: var(--rb-heading);
    margin: 0 0 0.4rem 0;
  }

  #{{ section_id }} .rb__tl-desc {
    font-size: 0.85rem;
    color: var(--rb-muted);
    line-height: 1.5;
  }
</style>

<section id="{{ section_id }}">
  <div class="rb__container">
    <div class="rb__header">
