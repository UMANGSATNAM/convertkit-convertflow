<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    // AM/PM Toggle
    var timeBtns = section.querySelectorAll('[data-time-switch] .rb__time-btn');
    var amGrid = section.querySelector('[data-protocol-grid="am"]');
    var pmGrid = section.querySelector('[data-protocol-grid="pm"]');
    var timeNote = section.querySelector('[data-time-note]');

    timeBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        timeBtns.forEach(function(b) { b.classList.remove('is-active'); });
        this.classList.add('is-active');
        var proto = this.getAttribute('data-protocol') || 'am';

        if (proto === 'am') {
          if (amGrid) amGrid.classList.add('is-active');
          if (pmGrid) pmGrid.classList.remove('is-active');
          if (timeNote) timeNote.textContent = '[ ACTIVE PROTOCOL: DAYTIME DEFENSE & SPF 50+ SHIELDING ]';
        } else {
          if (amGrid) amGrid.classList.remove('is-active');
          if (pmGrid) pmGrid.classList.add('is-active');
          if (timeNote) timeNote.textContent = '[ ACTIVE PROTOCOL: OVERNIGHT REPAIR & RETINAL TITRATION ]';
        }
      });
    });

    // Concern Filtering
    var concernBtns = section.querySelectorAll('[data-concern-nav] .rb__concern-btn');
    concernBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        concernBtns.forEach(function(b) { b.classList.remove('is-active'); });
        this.classList.add('is-active');
        var c = this.getAttribute('data-concern') || 'all';

        var allCards = section.querySelectorAll('.rb__step-card');
        allCards.forEach(function(card) {
          var tag = card.getAttribute('data-concern-tag') || '';
          if (c === 'all' || tag === c) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'flex'; // Keep visible in protocol but highlight or filter
            card.style.opacity = (c === 'all' || tag === c) ? '1' : '0.45';
          }
        });
      });
    });

    // Calculator Logic
    var checkboxes = section.querySelectorAll('[data-step-check]');
    var totalDisp = section.querySelector('[data-calc-total]');
    var saveDisp = section.querySelector('[data-calc-save]');
    var tierSteps = section.querySelectorAll('.rb__tier-step');

    function updateCalculator() {
      var rawTotal = 0;
      var count = 0;

      checkboxes.forEach(function(chk) {
        if (chk.checked) {
          count++;
          rawTotal += parseInt(chk.value, 10) || 0;
        }
      });

      var discountPct = 0;
      if (count === 2) discountPct = 10;
      if (count >= 3) discountPct = 20;

      var discountVal = Math.round(rawTotal * (discountPct / 100));
      var finalTotal = rawTotal - discountVal;

      if (totalDisp) totalDisp.textContent = 'RS. ' + finalTotal.toLocaleString('en-IN');
      if (saveDisp) {
        if (discountPct > 0) {
          saveDisp.textContent = '[ YOU SAVE RS. ' + discountVal.toLocaleString('en-IN') + ' // ' + discountPct + '% OFF ]';
          saveDisp.style.display = 'inline-block';
        } else {
          saveDisp.style.display = 'none';
        }
      }

      tierSteps.forEach(function(step) {
        var t = parseInt(step.getAttribute('data-tier'), 10) || 1;
        if (t <= count) {
          step.classList.add('is-unlocked');
        } else {
          step.classList.remove('is-unlocked');
        }
      });
    }

    checkboxes.forEach(function(chk) {
      chk.addEventListener('change', updateCalculator);
    });

    // Add Complete Protocol Button
    var addBtn = section.querySelector('[data-add-regimen]');
    if (addBtn) {
      addBtn.addEventListener('click', function() {
        var origText = this.textContent;
        this.textContent = '[ ENCRYPTING REGIMEN ALLOCATION... ]';
        setTimeout(function() {
          addBtn.textContent = '[ COMPLETE PROTOCOL ADDED TO BAG V ]';
          alert('[ DERMATOLOGICAL PROTOCOL LOCKED ]\n\nAll selected AM / PM clinical treatment steps have been added to your cart with your calculated habit-stacking bundle savings applied.');
          setTimeout(function() { addBtn.textContent = origText; }, 3000);
        }, 600);
      });
    }

    updateCalculator();
  });
</script>

