{%- comment -%}
  info_accordion_tabs.liquid — Ultra-Comprehensive Technical Knowledge Base & Accordion Tabs
  
  DESIGN PHILOSOPHY:
  An architectural knowledge base engineered to answer deep technical and operational inquiries.
  Features interactive category filtering tabs, exclusive smooth-sliding accordion items,
  animated indicator icons, and an accessible Technical Concierge Lightbox Modal Dialog
  for direct engineering support requests.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --iat-bg: {{ section.settings.bg_color | default: '#0a0a0a' }};
    --iat-card-bg: {{ section.settings.card_bg_color | default: '#171717' }};
    --iat-text: {{ section.settings.text_color | default: '#f5f5f5' }};
    --iat-muted: color-mix(in srgb, var(--iat-text) 60%, transparent);
    --iat-border: color-mix(in srgb, var(--iat-text) 14%, transparent);
    --iat-accent: {{ section.settings.accent_color | default: '#38bdf8' }};
    --iat-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --iat-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --iat-padding-top: clamp(4rem, 8vw, 7rem);
    --iat-padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .iat-section {
    background-color: var(--iat-bg);
    color: var(--iat-text);
    font-family: var(--iat-font-body);
    padding: var(--iat-padding-top) clamp(1.25rem, 4vw, 4rem) var(--iat-padding-bottom);
    border-bottom: 1px solid var(--iat-border);
    position: relative;
  }

  .iat-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* Section Header */
  .iat-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--iat-border);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .iat-head-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 680px;
  }
  .iat-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--iat-accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .iat-eyebrow::before {
    content: "";
    width: 20px;
    height: 2px;
    background: var(--iat-accent);
  }
  .iat-title {
    font-family: var(--iat-font-head);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }
  .iat-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--iat-muted);
    line-height: 1.6;
    margin: 0;
  }
  .iat-support-btn {
    background: var(--iat-card-bg);
    color: var(--iat-text);
    border: 1px solid var(--iat-border);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.9rem 1.75rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .iat-support-btn:hover {
    background: var(--iat-text);
    color: var(--iat-bg);
    border-color: var(--iat-text);
  }

  /* Category Filter Tabs */
  .iat-filter-bar {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scrollbar-width: none;
  }
  .iat-filter-bar::-webkit-scrollbar { display: none; }
  .iat-tab-btn {
    background: var(--iat-card-bg);
    color: var(--iat-muted);
    border: 1px solid var(--iat-border);
    font-family: var(--iat-font-head);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.75rem 1.5rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .iat-tab-btn[aria-selected="true"] {
    background: var(--iat-text);
    color: var(--iat-bg);
    border-color: var(--iat-text);
  }
  .iat-tab-btn:hover:not([aria-selected="true"]) {
    color: var(--iat-text);
    border-color: color-mix(in srgb, var(--iat-text) 35%, transparent);
  }

  /* Accordion List */
  .iat-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .iat-item {
    background: var(--iat-card-bg);
    border: 1px solid var(--iat-border);
    border-radius: 24px;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .iat-item:hover {
    border-color: color-mix(in srgb, var(--iat-text) 35%, transparent);
  }
  .iat-item[data-hidden="true"] {
    display: none;
  }

  /* Accordion Trigger Header */
  .iat-trigger {
    width: 100%;
    background: transparent;
    border: none;
    color: var(--iat-text);
    padding: 1.5rem 1.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    text-align: left;
    cursor: pointer;
  }
  .iat-q-title {
    font-family: var(--iat-font-head);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    font-weight: 700;
    margin: 0;
    line-height: 1.4;
  }
  .iat-icon-box {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--iat-text) 6%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s ease;
  }
  .iat-item[data-open="true"] .iat-icon-box {
    transform: rotate(180deg);
    background: var(--iat-accent);
    color: #ffffff;
  }
  .iat-icon-box svg { width: 18px; height: 18px; stroke: currentColor; stroke-width: 2.5; fill: none; }

  /* Accordion Expandable Content */
  .iat-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .iat-content-inner {
    padding: 0 1.75rem 1.75rem;
    color: var(--iat-muted);
    font-size: 0.98rem;
    line-height: 1.7;
    border-top: 1px solid color-mix(in srgb, var(--iat-text) 8%, transparent);
    padding-top: 1.25rem;
  }

  /* Concierge Support Modal */
  .iat-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .iat-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .iat-modal {
    background: var(--iat-card-bg);
    color: var(--iat-text);
    border: 1px solid var(--iat-border);
    border-radius: 36px;
    max-width: 620px;
    width: 100%;
    padding: clamp(2.5rem, 6vw, 3.5rem);
    position: relative;
    box-shadow: 0 40px 80px -15px rgba(0, 0, 0, 0.9);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transform: scale(0.95);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .iat-modal-overlay[data-open="true"] .iat-modal {
    transform: scale(1);
  }
  .iat-modal-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: color-mix(in srgb, var(--iat-text) 10%, transparent);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--iat-text);
    cursor: pointer;
  }
  .iat-input {
    width: 100%;
    background: color-mix(in srgb, var(--iat-text) 4%, transparent);
    border: 1px solid var(--iat-border);
    color: var(--iat-text);
    padding: 1rem 1.25rem;
    border-radius: 16px;
    font-size: 0.95rem;
    outline: none;
    font-family: var(--iat-font-body);
  }
  .iat-input:focus { border-color: var(--iat-accent); }
</style>

<section class="iat-section" id="iat-section-{{ section.id }}" aria-labelledby="iat-title-{{ section.id }}">
  <div class="iat-container">
    
    <!-- Section Header -->
    <div class="iat-header">
      <div class="iat-head-text">
        {%- if section.settings.eyebrow != blank -%}
          <div class="iat-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="iat-title-{{ section.id }}" class="iat-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="iat-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      <button type="button" class="iat-support-btn" id="iat-concierge-btn-{{ section.id }}">
        <span>Technical Concierge</span>
        <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
      </button>
    </div>

    <!-- Category Filter Bar -->
    <div class="iat-filter-bar" role="tablist" aria-label="Knowledge base categories">
      <button type="button" class="iat-tab-btn" role="tab" aria-selected="true" data-cat="all">All Specifications</button>
      <button type="button" class="iat-tab-btn" role="tab" aria-selected="false" data-cat="materials">Materials & CNC</button>
      <button type="button" class="iat-tab-btn" role="tab" aria-selected="false" data-cat="acoustics">Acoustic Engineering</button>
      <button type="button" class="iat-tab-btn" role="tab" aria-selected="false" data-cat="warranty">Swiss Warranty & Care</button>
    </div>

    <!-- Accordion Items -->
    <div class="iat-list" role="region" aria-label="Accordion questions">
      {%- for block in section.blocks -%}
        <div class="iat-item" role="article" data-cat="{{ block.settings.category | default: 'materials' }}" data-open="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
          
          <button type="button" class="iat-trigger" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
            <h3 class="iat-q-title">{{ block.settings.title | default: 'What is the acoustic dampening coefficient of the silicone gasket?' }}</h3>
            <div class="iat-icon-box">
              <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
          </button>

          <div class="iat-content" style="{% if forloop.first %}max-height: 600px;{% endif %}">
            <div class="iat-content-inner">
              {{ block.settings.answer | default: 'We utilize custom 50A durometer precision molded silicone gaskets that decouple the internal brass weight from the aerospace aluminum chassis. This isolates vibrations above 400Hz, resulting in a clean, thocky acoustic signature without metallic ping.' }}
            </div>
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>

  <!-- Technical Concierge Lightbox Modal -->
  <div class="iat-modal-overlay" id="iat-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="iat-modal">
      <button type="button" class="iat-modal-close" id="iat-modal-close-{{ section.id }}" aria-label="Close technical concierge modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div style="display:flex;align-items:center;gap:0.6rem;">
        <span style="width:10px;height:10px;border-radius:50%;background:var(--iat-accent);"></span>
        <span style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.18em;color:var(--iat-accent);">Zürich Engineering Support</span>
      </div>

      <h3 style="font-family:var(--iat-font-head);font-size:1.85rem;margin:0;line-height:1.2;">Direct Concierge Inquiry</h3>
      
      <p style="font-size:0.95rem;color:var(--iat-muted);line-height:1.6;margin:0;">Have a customized modification request or bulk studio deployment inquiry? Speak directly with our lead acoustic engineers.</p>

      <form onsubmit="event.preventDefault(); alert('Inquiry dispatched to Zürich Atelier. Expected response time: < 4 hours.'); document.getElementById('iat-modal-close-{{ section.id }}').click();" style="display:flex;flex-direction:column;gap:1rem;">
        <div>
          <label style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--iat-text);display:block;margin-bottom:0.4rem;">Workstation Serial or Topic</label>
          <input type="text" class="iat-input" placeholder="e.g. Series 04 Acoustic Customization" required>
        </div>
        <div>
          <label style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--iat-text);display:block;margin-bottom:0.4rem;">Professional Email</label>
          <input type="email" class="iat-input" placeholder="engineering@studio.com" required>
        </div>
        <div>
          <label style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--iat-text);display:block;margin-bottom:0.4rem;">Inquiry Details</label>
          <textarea class="iat-input" rows="4" placeholder="Detail your studio acoustic requirements..." required></textarea>
        </div>
        
        <button type="submit" style="background:var(--iat-text);color:var(--iat-bg);font-weight:700;font-size:0.95rem;padding:1.1rem;border-radius:100px;border:none;cursor:pointer;margin-top:0.5rem;transition:all 0.2s ease;">Dispatch Inquiry To Zürich →</button>
      </form>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('iat-section-' + sid);
    if (!sectionEl) return;

    // Accordion Exclusive Toggle Controller
    var items = sectionEl.querySelectorAll('.iat-item');
    items.forEach(function(item) {
      var trigger = item.querySelector('.iat-trigger');
      var content = item.querySelector('.iat-content');
      if (trigger && content) {
        trigger.addEventListener('click', function() {
          var isOpen = item.getAttribute('data-open') === 'true';

          // Close all
          items.forEach(function(other) {
            other.setAttribute('data-open', 'false');
            var otherBtn = other.querySelector('.iat-trigger');
            var otherCnt = other.querySelector('.iat-content');
            if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
            if (otherCnt) otherCnt.style.maxHeight = null;
          });

          if (!isOpen) {
            item.setAttribute('data-open', 'true');
            trigger.setAttribute('aria-expanded', 'true');
            content.style.maxHeight = content.scrollHeight + 'px';
          }
        });
      }
    });

    // Category Filter Controller
    var tabBtns = sectionEl.querySelectorAll('.iat-tab-btn');
    tabBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        tabBtns.forEach(function(b) { b.setAttribute('aria-selected', 'false'); });
        btn.setAttribute('aria-selected', 'true');

        var cat = btn.getAttribute('data-cat');
        items.forEach(function(item) {
          var itemCat = item.getAttribute('data-cat');
          if (cat === 'all' || itemCat === cat) {
            item.setAttribute('data-hidden', 'false');
          } else {
            item.setAttribute('data-hidden', 'true');
          }
        });
      });
    });

    // Concierge Support Modal Controller
    var modalOverlay = document.getElementById('iat-modal-' + sid);
    var modalClose = document.getElementById('iat-modal-close-' + sid);
    var conciergeBtn = document.getElementById('iat-concierge-btn-' + sid);

    if (modalOverlay && modalClose && conciergeBtn) {
      conciergeBtn.addEventListener('click', function() {
        modalOverlay.setAttribute('data-open', 'true');
        modalOverlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Technical Knowledge Base",
  "tag": "section",
  "class": "section-info-accordion-tabs",
  "max_blocks": 15,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#38bdf8"
    },
    {
      "type": "header",
      "content": "Section Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Technical Knowledge Base"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Engineering & Operational FAQ"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Review comprehensive technical documentation regarding unibody CNC milling, internal acoustic gaskets, and lifetime archive registration."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Accordion Item",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Filter Category",
          "options": [
            { "value": "materials", "label": "Materials & CNC" },
            { "value": "acoustics", "label": "Acoustic Engineering" },
            { "value": "warranty", "label": "Swiss Warranty & Care" }
          ],
          "default": "materials"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "What is the acoustic dampening coefficient of the silicone gasket?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Detailed Technical Answer",
          "default": "We utilize custom 50A durometer precision molded silicone gaskets that decouple the internal brass weight from the aerospace aluminum chassis. This isolates vibrations above 400Hz, resulting in a clean, thocky acoustic signature without metallic ping."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Technical Knowledge Base",
      "blocks": [
        { "type": "faq", "settings": { "category": "materials", "title": "What aluminum alloy is utilized for the unibody chassis?", "answer": "We exclusively mill from 6063 aerospace-grade aluminum due to its superior grain density and thermal dissipation properties compared to standard 6061." } },
        { "type": "faq", "settings": { "category": "acoustics", "title": "How does the gasket mount eliminate auditory fatigue?", "answer": "By suspending the PCB assembly between upper and lower silicone compression strips, all hard contact points are eliminated. This dampens high-frequency bottom-out shock by over 42 dB." } },
        { "type": "faq", "settings": { "category": "warranty", "title": "What is covered under the Swiss Lifetime Archive Warranty?", "answer": "Every Series 04 instrument is registered in our permanent Zürich archive. Any structural chassis defect or anodization failure is covered with immediate replacement for life." } }
      ]
    }
  ]
}
{% endschema %}
