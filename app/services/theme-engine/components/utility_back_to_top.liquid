{%- comment -%}
  utility_back_to_top.liquid — Floating Back-to-Top Button
  
  DESIGN PHILOSOPHY:
  Non-intrusive floating button that appears after user scrolls down 300px.
  Smooth scroll-to-top behavior with progress border animation or clean
  hover elevation. Fully accessible with proper keyboard focus styling.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --ubt-bg: var(--color-surface, #18181b);
    --ubt-text: var(--color-text, #ffffff);
    --ubt-accent: var(--color-accent, #6366f1);
  }

  .ubt-btn {
    position: fixed;
    bottom: clamp(1.5rem, 4vw, 2.5rem);
    right: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--ubt-bg);
    color: var(--ubt-text);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--ubt-text) 15%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
    z-index: 990;
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px);
    transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s ease;
  }

  .ubt-btn.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .ubt-btn:hover {
    background: var(--ubt-accent);
    color: #ffffff;
    transform: translateY(-4px);
    border-color: transparent;
  }

  .ubt-btn svg {
    width: 20px;
    height: 20px;
    stroke-width: 2.2;
    stroke: currentColor;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

<button
  type="button"
  id="ubt-btn-{{ section.id }}"
  class="ubt-btn"
  aria-label="Scroll to top of page"
  title="Back to top"
>
  <svg viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg>
</button>

<script>
  (function() {
    var btn = document.getElementById('ubt-btn-{{ section.id }}');
    if (!btn) return;

    var threshold = {{ section.settings.scroll_threshold | default: 300 }};
    var isVisible = false;

    function checkScroll() {
      var scrollY = window.pageYOffset || document.documentElement.scrollTop;
      if (scrollY > threshold && !isVisible) {
        isVisible = true;
        btn.classList.add('is-visible');
      } else if (scrollY <= threshold && isVisible) {
        isVisible = false;
        btn.classList.remove('is-visible');
      }
    }

    window.addEventListener('scroll', function() {
      requestAnimationFrame(checkScroll);
    }, { passive: true });

    btn.addEventListener('click', function() {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Back to Top Button",
  "tag": "section",
  "class": "section-utility-back-to-top",
  "settings": [
    {
      "type": "number",
      "id": "scroll_threshold",
      "label": "Scroll distance to show (in pixels)",
      "default": 300
    }
  ],
  "presets": [
    {
      "name": "Back to Top Button"
    }
  ]
}
{% endschema %}
