{%- comment -%}
  sections/logo-list_luxury_v1.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (360+ lines):
  1. AUTHORITY TRANSFER & HALO EFFECT: Featuring global publications (Vogue, Elle, Harper's Bazaar) transfers third-party prestige directly onto the brand (Cialdini, 1984; Thorndike, 1920).
  2. INTERACTIVE EDITORIAL QUOTES: Clicking or hovering any press publication dynamically reveals its editorial review snippet, transforming static logos into active social proof testimony.
  3. DUAL-MODE LAYOUT ARCHITECTURE: Allows merchants to toggle between a hypnotic infinite CSS ticker marquee (for high-energy modern luxury) and a classical centered salon grid.
  4. GRAYSCALE HARMONY: Logos remain subtly muted until hovered, preventing visual clutter while maintaining an ultra-premium editorial tone.
  5. ZERO EMOJI GUARANTEE: Uses ASCII brackets [ ACCLAIMED BY THE WORLD'S FINEST ], [ READ FULL REVIEW ] and crisp typography.
{%- endcomment -%}

{%- assign section_id = 'lx-ll-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --lx-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --lx-text: {{ section.settings.text_color | default: '#1a1a1a' }};
    --lx-gold: {{ section.settings.gold_accent | default: '#c9a96e' }};
    --lx-muted: rgba(26, 26, 26, 0.45);
    --lx-border: rgba(26, 26, 26, 0.08);
    --lx-quote-bg: #fdfcfa;
    
    background-color: var(--lx-bg);
    color: var(--lx-text);
    padding: clamp(3.5rem, 7vw, 6rem) 0;
    border-top: 1px solid var(--lx-border);
    border-bottom: 1px solid var(--lx-border);
    position: relative;
    overflow: hidden;
  }

  #{{ section_id }} .lx-ll__header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 2.5rem auto;
    padding: 0 1.5rem;
  }

  #{{ section_id }} .lx-ll__eyebrow {
    font-family: var(--font-body, sans-serif);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--lx-gold);
    margin-bottom: 0.5rem;
    display: block;
  }

  #{{ section_id }} .lx-ll__title {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 300;
    margin: 0;
    line-height: 1.2;
    color: var(--lx-text);
  }

  /* Interactive Quote Display Drawer */
  #{{ section_id }} .lx-ll__quote-box {
    max-width: 760px;
    margin: 0 auto 3rem auto;
    background: var(--lx-quote-bg);
    border: 1px solid var(--lx-gold);
    padding: 2.2rem 2.5rem;
    text-align: center;
    position: relative;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  @media (max-width: 640px) {
    #{{ section_id }} .lx-ll__quote-box {
      margin: 0 1.5rem 2.5rem 1.5rem;
      padding: 1.5rem 1.2rem;
    }
  }

  #{{ section_id }} .lx-ll__quote-text {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-style: italic;
    line-height: 1.6;
    color: var(--lx-text);
    margin: 0 0 1rem 0;
  }

  #{{ section_id }} .lx-ll__quote-source {
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--lx-gold);
    font-weight: 600;
  }

  /* Grid Layout Mode */
  #{{ section_id }} .lx-ll__grid {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(2rem, 6vw, 5.5rem);
    flex-wrap: wrap;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Infinite Marquee Layout Mode */
  #{{ section_id }} .lx-ll__marquee {
    display: flex;
    width: 100%;
    overflow: hidden;
    user-select: none;
    position: relative;
  }

  #{{ section_id }} .lx-ll__marquee-track {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-around;
    gap: clamp(3rem, 7vw, 6rem);
    min-width: 100%;
    animation: lxMarqueeScroll 35s linear infinite;
    padding: 0 2rem;
  }

  #{{ section_id }} .lx-ll__marquee:hover .lx-ll__marquee-track {
    animation-play-state: paused;
  }

  @keyframes lxMarqueeScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-100%); }
  }

  /* Individual Logo Item Architecture */
  #{{ section_id }} .lx-ll__item {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: clamp(1.2rem, 2.2vw, 1.8rem);
    color: var(--lx-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0.5rem 1rem;
    border-bottom: 2px solid transparent;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ section_id }} .lx-ll__item.is-active,
  #{{ section_id }} .lx-ll__item:hover {
    color: var(--lx-text);
    border-bottom-color: var(--lx-gold);
  }

  #{{ section_id }} .lx-ll__item img {
    max-height: 32px;
    width: auto;
    opacity: 0.4;
    filter: grayscale(100%);
    transition: opacity 0.3s ease, filter 0.3s ease, transform 0.3s ease;
  }

  #{{ section_id }} .lx-ll__item.is-active img,
  #{{ section_id }} .lx-ll__item:hover img {
    opacity: 0.95;
    filter: grayscale(0%);
    transform: scale(1.05);
  }

  #{{ section_id }} .lx-ll__instruction {
    text-align: center;
    font-family: var(--font-body, sans-serif);
    font-size: 0.68rem;
    color: var(--lx-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-top: 2.5rem;
  }
</style>

<section id="{{ section_id }}">
  <div class="lx-ll__header">
    <span class="lx-ll__eyebrow">[ {{ section.settings.eyebrow | default: "GLOBAL PRESS RECOGNITION" }} ]</span>
    <h2 class="lx-ll__title">{{ section.settings.heading | default: "Acclaimed By The World's Finest" }}</h2>
  </div>

  <div class="lx-ll__quote-box" data-quote-box>
    {%- assign first_block = section.blocks.first -%}
    <p class="lx-ll__quote-text" data-quote-text>
      "{{ first_block.settings.quote | default: 'An absolute masterpiece of contemporary Indian craftsmanship and uncompromising luxury.' }}"
    </p>
    <div class="lx-ll__quote-source" data-quote-source>
      [ {{ first_block.settings.name | default: 'VOGUE INDIA' }} ]
    </div>
  </div>

  {%- if section.settings.layout_mode == 'marquee' -%}
    <div class="lx-ll__marquee">
      <div class="lx-ll__marquee-track">
        {%- for block in section.blocks -%}
          <div 
            class="lx-ll__item {% if forloop.first %}is-active{% endif %}" 
            data-logo-item 
            data-quote="{{ block.settings.quote | escape }}" 
            data-source="[ {{ block.settings.name | default: 'PRESS' | escape }} ]"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.logo != blank -%}
              {{ block.settings.logo | image_url: height: 64 | image_tag: loading: 'lazy' }}
            {%- else -%}
              {{ block.settings.name | default: "VOGUE" }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      <!-- Duplicate track for seamless infinite scroll -->
      <div class="lx-ll__marquee-track" aria-hidden="true">
        {%- for block in section.blocks -%}
          <div 
            class="lx-ll__item" 
            data-logo-item 
            data-quote="{{ block.settings.quote | escape }}" 
            data-source="[ {{ block.settings.name | default: 'PRESS' | escape }} ]"
          >
            {%- if block.settings.logo != blank -%}
              {{ block.settings.logo | image_url: height: 64 | image_tag: loading: 'lazy' }}
            {%- else -%}
              {{ block.settings.name | default: "VOGUE" }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <div class="lx-ll__grid">
      {%- for block in section.blocks -%}
        <div 
          class="lx-ll__item {% if forloop.first %}is-active{% endif %}" 
          data-logo-item 
          data-quote="{{ block.settings.quote | escape }}" 
          data-source="[ {{ block.settings.name | default: 'PRESS' | escape }} ]"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.logo != blank -%}
            {{ block.settings.logo | image_url: height: 64 | image_tag: loading: 'lazy' }}
          {%- else -%}
            {{ block.settings.name | default: "VOGUE" }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="lx-ll__instruction">[ CLICK ANY PUBLICATION TO EXPLORE EDITORIAL ARCHIVES ]</div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var quoteText = section.querySelector('[data-quote-text]');
    var quoteSource = section.querySelector('[data-quote-source]');
    var items = section.querySelectorAll('[data-logo-item]');

    items.forEach(function(item) {
      item.addEventListener('click', function() {
        items.forEach(function(i) { i.classList.remove('is-active'); });
        this.classList.add('is-active');

        var quote = this.getAttribute('data-quote');
        var source = this.getAttribute('data-source');

        if (quoteText && quote) quoteText.textContent = '"' + quote + '"';
        if (quoteSource && source) quoteSource.textContent = source;
      });

      // Optional hover activation for immediate feedback
      item.addEventListener('mouseenter', function() {
        var quote = this.getAttribute('data-quote');
        var source = this.getAttribute('data-source');
        if (quoteText && quote) quoteText.textContent = '"' + quote + '"';
        if (quoteSource && source) quoteSource.textContent = source;
      });
    });
  });
</script>

{% schema %}
{
  "name": "Luxury Press Recognition",
  "tag": "section",
  "class": "section-logo-list-luxury",
  "settings": [
    {
      "type": "header",
      "content": "Editorial Messaging"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Badge",
      "default": "GLOBAL PRESS RECOGNITION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Acclaimed By The World's Finest"
    },
    {
      "type": "header",
      "content": "Layout Mode"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Display Architecture",
      "options": [
        { "value": "grid", "label": "Centered Salon Grid" },
        { "value": "marquee", "label": "Infinite Hypnotic Ticker" }
      ],
      "default": "grid"
    },
    {
      "type": "header",
      "content": "Color Tokens"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "gold_accent",
      "label": "Gold Accent Color",
      "default": "#c9a96e"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Publication Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Publication Name",
          "default": "VOGUE"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Editorial Quote",
          "default": "An absolute masterpiece of contemporary Indian craftsmanship and uncompromising luxury."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Press Recognition",
      "blocks": [
        {
          "type": "logo",
          "settings": {
            "name": "VOGUE INDIA",
            "quote": "An absolute masterpiece of contemporary Indian craftsmanship and uncompromising luxury."
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "HARPER'S BAZAAR",
            "quote": "Redefining the boundaries of elegance with rare materials and timeless silhouette design."
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "ELLE",
            "quote": "The most coveted collector piece of the season, crafted for discerning connoisseurs."
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "GRAZIA",
            "quote": "Where traditional heritage meets avant-garde modern sensibility."
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "GQ INDIA",
            "quote": "A masterclass in restraint, precision engineering, and sophisticated style."
          }
        }
      ]
    }
  ]
}
{% endschema %}
