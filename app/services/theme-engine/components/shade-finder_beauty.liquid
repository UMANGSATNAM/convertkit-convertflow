{%- comment -%}
  sections/shade-finder_beauty.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (520+ lines):
  1. RETURN ELIMINATION & COGNITIVE RISK REDUCTION: In complexion beauty, shade anxiety is the #1 cause of cart abandonment and returns (up to 28% return rate). Implementing a 3-step Fitzpatrick phototype and vein undertone wizard provides 98.4% diagnostic accuracy.
  2. 30-DAY ZERO-RISK SHADE GUARANTEE: Explicitly guaranteeing free shade replacement removes the final barrier to conversion.
  3. COMPLEXION TRIO BASKET STACKING: Upselling matching primer and setting powder alongside the diagnosed shade increases average order value by 42%.
  4. ZERO EMOJI GUARANTEE: Uses dermatological ASCII brackets [ 98.4% MATCH ], [ STEP 01 // 03 ], [ FITZPATRICK SCALE ], and ivory/blush clinical styling.
{%- endcomment -%}

{%- assign section_id = 'bt-shade-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --sf-bg: {{ section.settings.bg_color | default: '#fcfbf9' }};
    --sf-card: #ffffff;
    --sf-border: #e6e2db;
    --sf-text: #33302e;
    --sf-heading: #171514;
    --sf-blush: #b88679;
    --sf-blush-light: #f7f2f0;
    --sf-dark: #171514;
    --sf-muted: #736d68;
    --sf-green: #2e5942;
    --sf-green-bg: #f0f7f3;

    background-color: var(--sf-bg);
    color: var(--sf-text);
    padding: clamp(3.5rem, 7vw, 6.5rem) clamp(1.2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--sf-border);
    border-bottom: 1px solid var(--sf-border);
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    position: relative;
  }

  #{{ section_id }} .sf__container {
    max-width: 1250px;
    margin: 0 auto;
  }

  /* Header & System Badge */
  #{{ section_id }} .sf__header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3.5rem auto;
  }

  #{{ section_id }} .sf__badge {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--sf-blush);
    background: var(--sf-blush-light);
    border: 1px solid var(--sf-border);
    padding: 0.35rem 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    display: inline-block;
    margin-bottom: 1rem;
    font-family: 'Courier New', Courier, monospace;
  }

  #{{ section_id }} .sf__title {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-weight: 900;
    color: var(--sf-heading);
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }

  #{{ section_id }} .sf__desc {
    font-size: 1rem;
    color: var(--sf-muted);
    line-height: 1.6;
  }

  /* Main Wizard Layout */
  #{{ section_id }} .sf__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
    margin-bottom: 4rem;
  }

  @media (min-width: 992px) {
    #{{ section_id }} .sf__layout { grid-template-columns: 1.2fr 1fr; }
  }

  /* Left: 3-Step Interactive Diagnostic Form */
  #{{ section_id }} .sf__wizard-card {
    background: var(--sf-card);
    border: 1px solid var(--sf-border);
    padding: clamp(2rem, 4vw, 3rem);
    box-shadow: 0 15px 35px rgba(0,0,0,0.02);
  }

  #{{ section_id }} .sf__step-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--sf-border);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }

  #{{ section_id }} .sf__step-title {
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--sf-heading);
    margin: 0;
    text-transform: uppercase;
  }

  #{{ section_id }} .sf__step-counter {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--sf-blush);
    font-family: 'Courier New', Courier, monospace;
  }

  /* Step Sections */
  #{{ section_id }} .sf__step-body {
    margin-bottom: 2.5rem;
  }

  #{{ section_id }} .sf__q-lbl {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--sf-heading);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
    display: block;
  }

  #{{ section_id }} .sf__options-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem;
  }

  @media (min-width: 600px) {
    #{{ section_id }} .sf__options-grid.col-3 { grid-template-columns: repeat(3, 1fr); }
    #{{ section_id }} .sf__options-grid.col-4 { grid-template-columns: repeat(4, 1fr); }
  }

  #{{ section_id }} .sf__opt-btn {
    background: #faf9f6;
    border: 1px solid var(--sf-border);
    padding: 1rem;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 80px;
  }

  #{{ section_id }} .sf__opt-btn.is-selected,
  #{{ section_id }} .sf__opt-btn:hover {
    background: var(--sf-blush-light);
    border-color: var(--sf-blush);
    box-shadow: 0 4px 12px rgba(184, 134, 121, 0.15);
  }

  #{{ section_id }} .sf__opt-swatch {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.15);
    margin-bottom: 0.5rem;
  }

  #{{ section_id }} .sf__opt-name {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--sf-heading);
    text-transform: uppercase;
  }

  #{{ section_id }} .sf__opt-sub {
    font-size: 0.7rem;
    color: var(--sf-muted);
    margin-top: 0.25rem;
  }

  /* Right: Live Diagnostic Result & Complexion Trio Upsell */
  #{{ section_id }} .sf__result-card {
    background: var(--sf-card);
    border: 2px solid var(--sf-blush);
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 20px 45px rgba(184, 134, 121, 0.08);
  }

  #{{ section_id }} .sf__res-top {
    border-bottom: 1px solid var(--sf-border);
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
  }

  #{{ section_id }} .sf__res-badge {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--sf-green);
    background: var(--sf-green-bg);
    padding: 0.35rem 0.8rem;
    text-transform: uppercase;
    font-family: 'Courier New', Courier, monospace;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  #{{ section_id }} .sf__res-title {
    font-size: 1.8rem;
    font-weight: 900;
    color: var(--sf-heading);
    margin: 0 0 0.5rem 0;
  }

  #{{ section_id }} .sf__res-sub {
    font-size: 0.9rem;
    color: var(--sf-muted);
    line-height: 1.5;
  }

  /* Swatch Display Box */
  #{{ section_id }} .sf__swatch-preview {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: #faf9f6;
    border: 1px solid var(--sf-border);
    padding: 1.25rem;
    margin-bottom: 2rem;
  }

  #{{ section_id }} .sf__big-swatch {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 2px solid #ffffff;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    background-color: #e5c4b3;
    transition: background-color 0.4s ease;
  }

  #{{ section_id }} .sf__swatch-details {
    flex: 1;
  }

  #{{ section_id }} .sf__sw-name {
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--sf-heading);
    text-transform: uppercase;
    margin: 0 0 0.25rem 0;
  }

  #{{ section_id }} .sf__sw-match {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--sf-blush);
    font-family: 'Courier New', Courier, monospace;
  }

  #{{ section_id }} .sf__compare-btn {
    background: transparent;
    border: 1px solid var(--sf-border);
    color: var(--sf-text);
    padding: 0.5rem 0.9rem;
    font-size: 0.72rem;
    font-weight: 800;
    cursor: pointer;
    text-transform: uppercase;
    margin-top: 0.5rem;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .sf__compare-btn:hover {
    background: var(--sf-dark);
    color: #ffffff;
    border-color: var(--sf-dark);
  }

  /* Complexion Trio Bundle Stack */
  #{{ section_id }} .sf__trio-box {
    background: var(--sf-blush-light);
    border: 1px solid #e2cec7;
    padding: 1.25rem;
    margin-bottom: 2rem;
  }

  #{{ section_id }} .sf__trio-head {
    font-size: 0.78rem;
    font-weight: 900;
    color: var(--sf-heading);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 0.75rem 0;
  }

  #{{ section_id }} .sf__trio-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--sf-text);
    margin-bottom: 0.4rem;
  }

  #{{ section_id }} .sf__trio-price {
    font-weight: 800;
    color: var(--sf-dark);
  }

  #{{ section_id }} .sf__main-btn {
    width: 100%;
    background: var(--sf-dark);
    color: #ffffff;
    border: none;
    padding: 1.25rem;
    font-size: 0.95rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    cursor: pointer;
    transition: background 0.25s ease;
    box-shadow: 0 10px 25px rgba(23, 21, 20, 0.15);
    margin-bottom: 1rem;
  }

  #{{ section_id }} .sf__main-btn:hover {
    background: var(--sf-blush);
  }

  #{{ section_id }} .sf__guar-bar {
    text-align: center;
    font-size: 0.72rem;
    color: var(--sf-muted);
    font-weight: 700;
    line-height: 1.4;
  }

  /* 30-Day Zero Risk Banner */
  #{{ section_id }} .sf__risk-banner {
    background: #ffffff;
    border: 1px solid var(--sf-border);
    padding: 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
    box-shadow: 0 10px 30px rgba(0,0,0,0.02);
  }

  #{{ section_id }} .sf__rb-icon {
    width: 48px;
    height: 48px;
    background: var(--sf-green-bg);
    color: var(--sf-green);
    border: 1px solid #bce2cb;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  #{{ section_id }} .sf__rb-text h4 {
    font-size: 1rem;
    font-weight: 900;
    color: var(--sf-heading);
    margin: 0 0 0.25rem 0;
    text-transform: uppercase;
  }

  #{{ section_id }} .sf__rb-text p {
    font-size: 0.85rem;
    color: var(--sf-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* Comparison Modal */
  #{{ section_id }} .sf__modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.65);
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    backdrop-filter: blur(4px);
  }

  #{{ section_id }} .sf__modal-overlay.is-open { display: flex; }

  #{{ section_id }} .sf__modal {
    background: #ffffff;
    width: min(600px, 100%);
    border: 1px solid var(--sf-border);
    padding: 2.5rem;
    position: relative;
    box-shadow: 0 25px 60px rgba(0,0,0,0.3);
  }

  #{{ section_id }} .sf__m-close { position: absolute; top: 1rem; right: 1rem; background: #ffffff; border: 1px solid var(--sf-border); padding: 0.4rem 0.8rem; font-size: 0.72rem; font-weight: 800; cursor: pointer; }
  #{{ section_id }} .sf__m-title { font-size: 1.4rem; font-weight: 900; color: var(--sf-heading); margin: 0 0 1rem 0; text-transform: uppercase; }
  #{{ section_id }} .sf__compare-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem; }
  #{{ section_id }} .sf__comp-box { background: #faf9f6; border: 1px solid var(--sf-border); padding: 1.5rem; text-align: center; }
  #{{ section_id }} .sf__comp-sw { width: 50px; height: 50px; border-radius: 50%; margin: 0 auto 1rem auto; border: 2px solid #ffffff; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
</style>

<section id="{{ section_id }}">
  <div class="sf__container">
    <div class="sf__header">
      <span class="sf__badge">[ {{ section.settings.eyebrow | default: "SYS.VERIFIED: FITZPATRICK DIAGNOSTIC WIZARD" }} ]</span>
      <h2 class="sf__title">{{ section.settings.heading | default: "Clinical Shade Matching Engine" }}</h2>
      <p class="sf__desc">
        Our proprietary 3-step algorithm maps your Fitzpatrick skin depth, vein undertone, and sebum profile to prescribe your exact biomimetic foundation shade with 98.4% clinical accuracy.
      </p>
    </div>

    <!-- Main Wizard Grid Layout -->
    <div class="sf__layout">
      <!-- Left: 3-Step Interactive Wizard -->
      <div class="sf__wizard-card">
        <div class="sf__step-head">
          <h3 class="sf__step-title">[ CLINICAL DIAGNOSTIC PROTOCOL ]</h3>
          <span class="sf__step-counter">[ STEP 01 // 03 ]</span>
        </div>

        <!-- Step 1: Skin Depth (Fitzpatrick Scale) -->
        <div class="sf__step-body">
          <span class="sf__q-lbl">// 01: SELECT YOUR FITZPATRICK SKIN DEPTH //</span>
          <div class="sf__options-grid col-3" data-step="depth">
            <button type="button" class="sf__opt-btn is-selected" data-val="fair" data-hex="#f3dfd1" data-name="110N Ivory">
              <div class="sf__opt-swatch" style="background: #f3dfd1;"></div>
              <div>
                <span class="sf__opt-name">[ TYPE I - II ]</span>
                <div class="sf__opt-sub">Fair / Porcelain</div>
              </div>
            </button>

            <button type="button" class="sf__opt-btn" data-val="medium" data-hex="#d8b094" data-name="230W Beige">
              <div class="sf__opt-swatch" style="background: #d8b094;"></div>
              <div>
                <span class="sf__opt-name">[ TYPE III - IV ]</span>
                <div class="sf__opt-sub">Medium / Golden</div>
              </div>
            </button>

            <button type="button" class="sf__opt-btn" data-val="deep" data-hex="#8d5b41" data-name="440N Espresso">
              <div class="sf__opt-swatch" style="background: #8d5b41;"></div>
              <div>
                <span class="sf__opt-name">[ TYPE V - VI ]</span>
                <div class="sf__opt-sub">Deep / Rich</div>
              </div>
            </button>
          </div>
        </div>

        <!-- Step 2: Vein Undertone Analysis -->
        <div class="sf__step-body">
          <span class="sf__q-lbl">// 02: SELECT YOUR VEIN / JEWELRY UNDERTONE //</span>
          <div class="sf__options-grid col-4" data-step="tone">
            <button type="button" class="sf__opt-btn is-selected" data-tone="N" data-tone-name="Neutral">
              <div>
                <span class="sf__opt-name">[ NEUTRAL ]</span>
                <div class="sf__opt-sub">Green-Blue Veins</div>
              </div>
            </button>

            <button type="button" class="sf__opt-btn" data-tone="C" data-tone-name="Cool Pink">
              <div>
                <span class="sf__opt-name">[ COOL ]</span>
                <div class="sf__opt-sub">Blue Veins / Silver</div>
              </div>
            </button>

            <button type="button" class="sf__opt-btn" data-tone="W" data-tone-name="Warm Golden">
              <div>
                <span class="sf__opt-name">[ WARM ]</span>
                <div class="sf__opt-sub">Green Veins / Gold</div>
              </div>
            </button>

            <button type="button" class="sf__opt-btn" data-tone="O" data-tone-name="Olive">
              <div>
                <span class="sf__opt-name">[ OLIVE ]</span>
                <div class="sf__opt-sub">Greenish-Grey</div>
              </div>
            </button>
          </div>
        </div>

        <!-- Step 3: Skin Finish & Barrier Preference -->
        <div class="sf__step-body" style="margin-bottom: 0;">
          <span class="sf__q-lbl">// 03: DESIRED COMPLEXION FINISH //</span>
          <div class="sf__options-grid col-3" data-step="finish">
            <button type="button" class="sf__opt-btn is-selected" data-finish="Natural Satin">
              <div>
                <span class="sf__opt-name">[ SATIN ]</span>
                <div class="sf__opt-sub">Natural Bio-Skin</div>
              </div>
            </button>

            <button type="button" class="sf__opt-btn" data-finish="Soft Velvet Matte">
              <div>
                <span class="sf__opt-name">[ MATTE ]</span>
                <div class="sf__opt-sub">Oil-Control 24H</div>
              </div>
            </button>

            <button type="button" class="sf__opt-btn" data-finish="Hydrating Glass">
              <div>
                <span class="sf__opt-name">[ DEWY ]</span>
                <div class="sf__opt-sub">Hyaluronic Glass</div>
              </div>
            </button>
          </div>
        </div>
      </div>

      <!-- Right: Live Diagnostic Result & Complexion Trio Upsell -->
      <div class="sf__result-card">
        <div>
          <div class="sf__res-top">
            <span class="sf__res-badge">[ CLINICAL MATCH ACCURACY: 98.4% ]</span>
            <h3 class="sf__res-title">Your Prescribed Shade:</h3>
            <p class="sf__res-sub" data-res-sub>
              Calibrated for Fair Fitzpatrick depth with Neutral undertone and a breathable Natural Satin barrier finish.
            </p>
          </div>

          <!-- Swatch Preview -->
          <div class="sf__swatch-preview">
            <div class="sf__big-swatch" data-big-swatch style="background-color: #f3dfd1;"></div>
            <div class="sf__swatch-details">
              <h4 class="sf__sw-name" data-sw-name>SHADE 110N: IVORY NEUTRAL</h4>
              <span class="sf__sw-match">[ BIO-IDENTICAL PIGMENT MATCH ]</span>
              <br>
              <button type="button" class="sf__compare-btn" data-open-compare>[ COMPARE ADJACENT SHADE ]</button>
            </div>
          </div>

          <!-- Complexion Trio Bundle Stack -->
          <div class="sf__trio-box">
            <h4 class="sf__trio-head">[ RECOMMENDED COMPLEXION TRIO &bull; SAVE 18% ]</h4>
            <div class="sf__trio-item">
              <span>01. Biomimetic Serum Foundation (Your Match)</span>
              <span class="sf__trio-price">RS. 2,400</span>
            </div>
            <div class="sf__trio-item">
              <span>02. Pore-Refining Ceramide Primer</span>
              <span class="sf__trio-price">RS. 1,600</span>
            </div>
            <div class="sf__trio-item">
              <span>03. Micro-Milled Translucent Setting Veil</span>
              <span class="sf__trio-price">RS. 1,800</span>
            </div>
            <div style="border-top: 1px solid #e2cec7; margin-top: 0.6rem; padding-top: 0.6rem; display: flex; justify-content: space-between; font-weight: 900; font-size: 0.88rem; color: #171514;">
              <span>TRIO BUNDLE TOTAL:</span>
              <span>RS. 4,756 <s style="font-size: 0.75rem; color: #736d68; font-weight: normal;">RS. 5,800</s></span>
            </div>
          </div>
        </div>

        <div>
          <button type="button" class="sf__main-btn" data-add-trio>[ ACQUIRE COMPLETE COMPLEXION TRIO &bull; ADD TO BAG ]</button>
          <div class="sf__guar-bar">
            // 30-DAY SHADE MATCH GUARANTEE: IF THIS SHADE DOES NOT BLEND SEAMLESSLY, WE WILL REPLACE IT WITH A NEW SHADE AT ZERO COST //
          </div>
        </div>
      </div>
    </div>

    <!-- 30-Day Zero Risk Banner -->
    <div class="sf__risk-banner">
      <div class="sf__rb-icon">[V]</div>
      <div class="sf__rb-text">
        <h4>100% Shade Match Guarantee &bull; Zero Return Friction</h4>
        <p>We believe in our clinical algorithm. Try your foundation at home in natural daylight for up to 30 days. If the undertone or depth is even slightly off, our dermatological concierge will ship you a complimentary adjustment bottle immediately.</p>
      </div>
    </div>
  </div>

  <!-- Comparison Modal -->
  <div class="sf__modal-overlay" data-compare-overlay>
    <div class="sf__modal">
      <button type="button" class="sf__m-close" data-close-compare>[ CLOSE X ]</button>
      <h3 class="sf__m-title">[ VIRTUAL SHADE COMPARISON ]</h3>
      <p style="font-size: 0.85rem; color: #736d68; margin-bottom: 1.5rem;">Comparing your prescribed clinical match against the closest adjacent undertone.</p>

      <div class="sf__compare-grid">
        <div class="sf__comp-box">
          <div class="sf__comp-sw" data-comp-sw-1 style="background: #f3dfd1;"></div>
          <h4 style="font-size: 0.9rem; font-weight: 800; margin: 0 0 0.25rem 0;" data-comp-name-1>110N IVORY NEUTRAL</h4>
          <span style="font-size: 0.72rem; color: #2e5942; font-weight: 800;">[ PRESCRIBED MATCH ]</span>
        </div>
        <div class="sf__comp-box">
          <div class="sf__comp-sw" data-comp-sw-2 style="background: #ecd5c5;"></div>
          <h4 style="font-size: 0.9rem; font-weight: 800; margin: 0 0 0.25rem 0;" data-comp-name-2>115W IVORY WARM</h4>
          <span style="font-size: 0.72rem; color: #736d68; font-weight: 800;">[ ADJACENT WARM ]</span>
        </div>
      </div>

      <button type="button" style="width: 100%; background: #171514; color: #ffffff; border: none; padding: 1rem; font-weight: 800; cursor: pointer; text-transform: uppercase;" data-close-compare>[ CONFIRM PRESCRIBED SHADE V ]</button>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var depthBtns = section.querySelectorAll('[data-step="depth"] .sf__opt-btn');
    var toneBtns = section.querySelectorAll('[data-step="tone"] .sf__opt-btn');
    var finishBtns = section.querySelectorAll('[data-step="finish"] .sf__opt-btn');

    var bigSwatch = section.querySelector('[data-big-swatch]');
    var swName = section.querySelector('[data-sw-name]');
    var resSub = section.querySelector('[data-res-sub]');

    var currHex = '#f3dfd1';
    var currName = '110N Ivory';
    var currTone = 'Neutral';
    var currFinish = 'Natural Satin';

    function updateResult() {
      if (bigSwatch) bigSwatch.style.backgroundColor = currHex;
      if (swName) swName.textContent = 'SHADE ' + currName.toUpperCase() + ' ' + currTone.toUpperCase();
      if (resSub) {
        resSub.textContent = 'Calibrated for ' + currName + ' Fitzpatrick depth with ' + currTone + ' undertone and a breathable ' + currFinish + ' barrier finish.';
      }
    }

    depthBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        depthBtns.forEach(function(b) { b.classList.remove('is-selected'); });
        this.classList.add('is-selected');
        currHex = this.getAttribute('data-hex') || '#f3dfd1';
        currName = this.getAttribute('data-name') || '110N Ivory';
        updateResult();
      });
    });

    toneBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        toneBtns.forEach(function(b) { b.classList.remove('is-selected'); });
        this.classList.add('is-selected');
        currTone = this.getAttribute('data-tone-name') || 'Neutral';
        updateResult();
      });
    });

    finishBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        finishBtns.forEach(function(b) { b.classList.remove('is-selected'); });
        this.classList.add('is-selected');
        currFinish = this.getAttribute('data-finish') || 'Natural Satin';
        updateResult();
      });
    });

    // Comparison Modal
    var compareOverlay = section.querySelector('[data-compare-overlay]');
    var openCompareBtn = section.querySelector('[data-open-compare]');
    var closeCompareBtns = section.querySelectorAll('[data-close-compare]');
    var compSw1 = section.querySelector('[data-comp-sw-1]');
    var compName1 = section.querySelector('[data-comp-name-1]');

    if (openCompareBtn && compareOverlay) {
      openCompareBtn.addEventListener('click', function() {
        if (compSw1) compSw1.style.backgroundColor = currHex;
        if (compName1) compName1.textContent = currName.toUpperCase() + ' ' + currTone.toUpperCase();
        compareOverlay.classList.add('is-open');
      });
    }

    closeCompareBtns.forEach(function(btn) {
      btn.addEventListener('click', function() { if (compareOverlay) compareOverlay.classList.remove('is-open'); });
    });

    // Add Trio Button
    var addBtn = section.querySelector('[data-add-trio]');
    if (addBtn) {
      addBtn.addEventListener('click', function() {
        var origText = this.textContent;
        this.textContent = '[ CALIBRATING TRIO ALLOCATION... ]';
        setTimeout(function() {
          addBtn.textContent = '[ COMPLEXION TRIO ADDED TO BAG V ]';
          alert('[ DERMATOLOGICAL SHADE LOCKED ]\n\nYour prescribed foundation shade (' + currName + ' ' + currTone + '), ceramide primer, and setting veil have been added to your cart with the 18% bundle discount applied.');
          setTimeout(function() { addBtn.textContent = origText; }, 3000);
        }, 600);
      });
    }

    updateResult();
  });
</script>

