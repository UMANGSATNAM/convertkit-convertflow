{%- comment -%}
  header_fashion_1.liquid — Fashion / Editorial Header
  
  DESIGN PHILOSOPHY:
  Magazine-inspired editorial header. Clean sans-serif,
  prominent logo, balanced navigation. Runway aesthetic.
  
  FEATURES:
  • Dynamic menu from Shopify link list
  • Centered logo with editorial spacing
  • Mobile slide-left drawer
  • Cart count + search icon
  • Announcement bar hook
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --fhdr-bg: var(--color-background, #fefefe);
    --fhdr-text: var(--color-text, #1a1a1a);
    --fhdr-muted: color-mix(in srgb, var(--fhdr-text) 45%, transparent);
    --fhdr-border: color-mix(in srgb, var(--fhdr-text) 8%, transparent);
    --fhdr-height: 64px;
    --fhdr-font: var(--font-body, 'Inter', sans-serif);
    --fhdr-font-logo: var(--font-heading, 'Cormorant Garamond', serif);
  }

  .fsh-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--fhdr-bg);
    border-bottom: 1px solid var(--fhdr-border);
  }

  .fsh-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--fhdr-height);
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 3rem);
  }

  /* ── LEFT NAV ─────────────────── */
  .fsh-header__nav {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1.75rem;
    flex: 1;
  }
  @media (min-width: 820px) {
    .fsh-header__nav { display: flex; }
  }
  .fsh-header__nav-link {
    font-family: var(--fhdr-font);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fhdr-text);
    text-decoration: none;
    position: relative;
    transition: color 0.2s ease;
  }
  .fsh-header__nav-link:hover {
    color: var(--fhdr-muted);
  }
  .fsh-header__nav-link[aria-current="page"] {
    border-bottom: 1px solid var(--fhdr-text);
    padding-bottom: 2px;
  }

  /* ── CENTER LOGO ──────────────── */
  .fsh-header__logo {
    font-family: var(--fhdr-font-logo);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fhdr-text);
    text-decoration: none;
    text-align: center;
    padding: 0 2rem;
  }
  .fsh-header__logo-img {
    max-height: 38px;
    width: auto;
  }

  /* ── RIGHT ACTIONS ────────────── */
  .fsh-header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
    flex: 1;
  }
  .fsh-header__action {
    font-family: var(--fhdr-font);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fhdr-text);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s ease;
  }
  .fsh-header__action:hover {
    color: var(--fhdr-muted);
  }
  .fsh-header__cart-badge {
    font-size: 0.65rem;
    vertical-align: super;
  }

  /* ── MOBILE BURGER ────────────── */
  .fsh-header__burger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px 0;
    width: 22px;
  }
  .fsh-header__burger span {
    display: block;
    height: 1px;
    background: var(--fhdr-text);
  }
  @media (min-width: 820px) {
    .fsh-header__burger { display: none; }
  }

  /* ── MOBILE DRAWER ────────────── */
  .fsh-drawer-bg {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.35);
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .fsh-drawer-bg[data-open="true"] {
    opacity: 1;
    visibility: visible;
  }

  .fsh-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: min(85vw, 340px);
    height: 100%;
    background: var(--fhdr-bg);
    z-index: 201;
    transform: translateX(-100%);
    transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .fsh-drawer[data-open="true"] {
    transform: translateX(0);
  }

  .fsh-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--fhdr-border);
  }
  .fsh-drawer__close {
    background: none;
    border: none;
    color: var(--fhdr-text);
    font-size: 1.25rem;
    cursor: pointer;
    line-height: 1;
  }

  .fsh-drawer__nav {
    list-style: none;
    margin: 0;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .fsh-drawer__nav-link {
    display: block;
    font-family: var(--fhdr-font);
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fhdr-text);
    text-decoration: none;
    padding: 1rem 0;
    border-bottom: 1px solid var(--fhdr-border);
    transition: padding-left 0.2s ease, color 0.2s ease;
  }
  .fsh-drawer__nav-link:hover {
    padding-left: 0.5rem;
    color: var(--fhdr-muted);
  }

  .fsh-drawer__footer {
    margin-top: auto;
    padding: 1.5rem;
    border-top: 1px solid var(--fhdr-border);
    display: flex;
    gap: 1.5rem;
    font-family: var(--fhdr-font);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .fsh-drawer__footer a {
    color: var(--fhdr-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .fsh-drawer__footer a:hover {
    color: var(--fhdr-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .fsh-drawer, .fsh-drawer-bg { transition: none; }
  }
</style>

{%- comment -%} ══ MOBILE DRAWER ══ {%- endcomment -%}
<div class="fsh-drawer-bg" data-open="false" id="fsh-bg-{{ section.id }}"
  onclick="this.dataset.open='false'; document.getElementById('fsh-drawer-{{ section.id }}').dataset.open='false'"></div>
<nav class="fsh-drawer" data-open="false" id="fsh-drawer-{{ section.id }}" aria-label="Mobile navigation">
  <div class="fsh-drawer__header">
    <a href="{{ routes.root_url }}" class="fsh-header__logo" style="font-size: 1.25rem;">{{ shop.name }}</a>
    <button class="fsh-drawer__close"
      onclick="document.getElementById('fsh-drawer-{{ section.id }}').dataset.open='false'; document.getElementById('fsh-bg-{{ section.id }}').dataset.open='false'"
      aria-label="Close menu">✕</button>
  </div>
  <ul class="fsh-drawer__nav">
    {%- for link in linklists[section.settings.menu].links -%}
      <li>
        <a href="{{ link.url }}" class="fsh-drawer__nav-link">{{ link.title }}</a>
      </li>
    {%- endfor -%}
  </ul>
  <div class="fsh-drawer__footer">
    <a href="{{ routes.search_url }}">Search</a>
    <a href="{{ routes.account_url }}">Account</a>
  </div>
</nav>

{%- comment -%} ══ MAIN HEADER ══ {%- endcomment -%}
<header class="fsh-header">
  <div class="fsh-header__inner">

    {%- comment -%} Mobile burger {%- endcomment -%}
    <button class="fsh-header__burger" aria-label="Open menu"
      onclick="document.getElementById('fsh-drawer-{{ section.id }}').dataset.open='true'; document.getElementById('fsh-bg-{{ section.id }}').dataset.open='true'">
      <span></span>
      <span></span>
    </button>

    {%- comment -%} Desktop nav {%- endcomment -%}
    <ul class="fsh-header__nav" role="navigation" aria-label="Main navigation">
      {%- for link in linklists[section.settings.menu].links -%}
        <li>
          <a href="{{ link.url }}" class="fsh-header__nav-link"
            {% if link.current %} aria-current="page"{% endif %}>
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- comment -%} Logo {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="fsh-header__logo">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 280 | image_tag: class: 'fsh-header__logo-img', alt: shop.name }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    {%- comment -%} Actions {%- endcomment -%}
    <div class="fsh-header__actions">
      <a href="{{ routes.search_url }}" class="fsh-header__action" aria-label="Search">Search</a>
      <a href="{{ routes.cart_url }}" class="fsh-header__action">
        Bag
        {%- if cart.item_count > 0 -%}
          <span class="fsh-header__cart-badge">({{ cart.item_count }})</span>
        {%- endif -%}
      </a>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Fashion Header",
  "tag": "section",
  "class": "section-header-fashion",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image",
      "info": "Recommended: transparent PNG, max 280px wide."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Sticky Header",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Fashion Header"
    }
  ]
}
{% endschema %}
