{%- comment -%}
  footer_minimal_1.liquid — Minimal Footer
  
  DESIGN PHILOSOPHY:
  Barely there. Maximum white space, thin type, single row.
  Let the content above do the talking.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --mnft-bg: var(--color-background, #fff);
    --mnft-text: var(--color-text, #333);
    --mnft-muted: color-mix(in srgb, var(--mnft-text) 40%, transparent);
    --mnft-border: color-mix(in srgb, var(--mnft-text) 6%, transparent);
    --mnft-font: var(--font-body, 'Helvetica Neue', sans-serif);
  }

  .mn-footer {
    background: var(--mnft-bg);
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 4vw, 3rem) 2rem;
    border-top: 1px solid var(--mnft-border);
  }

  .mn-footer__inner {
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
  }

  /* Logo */
  .mn-footer__logo {
    font-family: var(--font-heading, 'Helvetica Neue', sans-serif);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--mnft-text);
    margin-bottom: 2rem;
  }

  /* Navigation */
  .mn-footer__nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    list-style: none;
    padding: 0;
    margin-left: 0;
  }
  .mn-footer__nav a {
    font-family: var(--mnft-font);
    font-size: 0.8rem;
    font-weight: 300;
    color: var(--mnft-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .mn-footer__nav a:hover {
    color: var(--mnft-text);
  }

  /* Newsletter */
  .mn-footer__newsletter {
    max-width: 380px;
    margin: 0 auto 2.5rem;
  }
  .mn-footer__newsletter-label {
    font-family: var(--mnft-font);
    font-size: 0.75rem;
    font-weight: 300;
    color: var(--mnft-muted);
    margin-bottom: 0.75rem;
  }
  .mn-footer__newsletter-form {
    display: flex;
    gap: 0;
  }
  .mn-footer__newsletter-input {
    flex: 1;
    padding: 0.7rem 1rem;
    background: transparent;
    border: 1px solid var(--mnft-border);
    border-right: none;
    color: var(--mnft-text);
    font-family: var(--mnft-font);
    font-size: 0.8rem;
    font-weight: 300;
    outline: none;
    transition: border-color 0.2s;
  }
  .mn-footer__newsletter-input:focus {
    border-color: var(--mnft-text);
  }
  .mn-footer__newsletter-input::placeholder {
    color: var(--mnft-muted);
  }
  .mn-footer__newsletter-btn {
    padding: 0.7rem 1.25rem;
    background: var(--mnft-text);
    color: var(--mnft-bg);
    border: 1px solid var(--mnft-text);
    font-family: var(--mnft-font);
    font-size: 0.7rem;
    font-weight: 300;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .mn-footer__newsletter-btn:hover {
    opacity: 0.8;
  }

  /* Social */
  .mn-footer__social {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 2rem;
  }
  .mn-footer__social a {
    font-family: var(--mnft-font);
    font-size: 0.7rem;
    font-weight: 300;
    color: var(--mnft-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .mn-footer__social a:hover {
    color: var(--mnft-text);
  }

  /* Copyright + legal */
  .mn-footer__legal {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: var(--mnft-font);
    font-size: 0.65rem;
    font-weight: 300;
    color: var(--mnft-muted);
  }
  .mn-footer__legal a {
    color: var(--mnft-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .mn-footer__legal a:hover {
    color: var(--mnft-text);
  }
</style>

<footer class="mn-footer">
  <div class="mn-footer__inner">

    <div class="mn-footer__logo">{{ shop.name }}</div>

    {%- if section.settings.menu != blank -%}
      <ul class="mn-footer__nav">
        {%- for link in linklists[section.settings.menu].links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      <div class="mn-footer__newsletter">
        <div class="mn-footer__newsletter-label">{{ section.settings.newsletter_text | default: 'Updates, delivered.' }}</div>
        <form class="mn-footer__newsletter-form" action="/contact#contact_form" method="post">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" class="mn-footer__newsletter-input" placeholder="Email" required autocomplete="email" aria-label="Email for newsletter">
          <button type="submit" class="mn-footer__newsletter-btn">→</button>
        </form>
      </div>
    {%- endif -%}

    <div class="mn-footer__social">
      {%- if section.settings.social_instagram != blank -%}
        <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>
      {%- endif -%}
      {%- if section.settings.social_pinterest != blank -%}
        <a href="{{ section.settings.social_pinterest }}" target="_blank" rel="noopener">Pinterest</a>
      {%- endif -%}
    </div>

    <div class="mn-footer__legal">
      <span>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}</span>
      <a href="/policies/privacy-policy">Privacy</a>
      <a href="/policies/terms-of-service">Terms</a>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Minimal Footer",
  "tag": "section",
  "class": "section-footer-minimal",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer Menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter Label",
      "default": "Updates, delivered."
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest URL"
    }
  ],
  "presets": [
    {
      "name": "Minimal Footer"
    }
  ]
}
{% endschema %}
