{%- comment -%}
  grid_instagram_shop.liquid — Ultra-Comprehensive Shoppable Social Media Grid
  
  DESIGN PHILOSOPHY:
  An architectural community and social commerce engine designed to bridge organic user
  content with direct ecommerce acquisition. Features interactive hover overlays with engagement
  metrics, shoppable product pin badges, and an accessible Shoppable Post Lightbox Modal Dialog
  allowing users to inspect tagged products and add them directly to cart.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --gis-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --gis-card-bg: {{ section.settings.card_bg_color | default: '#f8fafc' }};
    --gis-text: {{ section.settings.text_color | default: '#0f172a' }};
    --gis-muted: color-mix(in srgb, var(--gis-text) 60%, transparent);
    --gis-border: color-mix(in srgb, var(--gis-text) 12%, transparent);
    --gis-accent: {{ section.settings.accent_color | default: '#0f172a' }};
    --gis-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --gis-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --gis-padding-top: clamp(3.5rem, 8vw, 6.5rem);
    --gis-padding-bottom: clamp(3.5rem, 8vw, 6.5rem);
  }

  .gis-section {
    background-color: var(--gis-bg);
    color: var(--gis-text);
    font-family: var(--gis-font-body);
    padding: var(--gis-padding-top) clamp(1.25rem, 4vw, 4rem) var(--gis-padding-bottom);
    border-bottom: 1px solid var(--gis-border);
    position: relative;
  }

  .gis-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* Section Header */
  .gis-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--gis-border);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .gis-head-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 680px;
  }
  .gis-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--gis-accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .gis-eyebrow::before {
    content: "";
    width: 20px;
    height: 2px;
    background: var(--gis-accent);
  }
  .gis-title {
    font-family: var(--gis-font-head);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }
  .gis-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--gis-muted);
    line-height: 1.6;
    margin: 0;
  }
  .gis-follow-btn {
    background: var(--gis-text);
    color: var(--gis-bg);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    padding: 0.9rem 1.85rem;
    border-radius: 100px;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .gis-follow-btn:hover {
    background: var(--gis-accent);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 15px 30px -5px rgba(0, 0, 0, 0.15);
  }

  /* Social Grid */
  .gis-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: clamp(1rem, 2vw, 1.75rem);
  }
  @media (min-width: 640px) {
    .gis-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .gis-grid {
      grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr);
    }
  }

  /* Social Post Card */
  .gis-card {
    background: var(--gis-card-bg);
    border: 1px solid var(--gis-border);
    border-radius: 28px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 1 / 1;
    cursor: pointer;
    group: true;
  }
  .gis-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gis-card:hover .gis-img {
    transform: scale(1.08);
  }

  /* Hover Glass Overlay */
  .gis-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .gis-card:hover .gis-overlay {
    opacity: 1;
  }

  /* Handle & Shop Pin Badge */
  .gis-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .gis-handle {
    font-size: 0.8rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.15);
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .gis-shop-pin {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #ffffff;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
  }
  .gis-shop-pin svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* Engagement Metrics */
  .gis-bot-bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.88rem;
    font-weight: 700;
  }
  .gis-stat {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .gis-stat svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  /* Shoppable Post Lightbox Modal */
  .gis-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .gis-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .gis-modal {
    background: var(--gis-card-bg);
    color: var(--gis-text);
    border: 1px solid var(--gis-border);
    border-radius: 32px;
    max-width: 900px;
    width: 100%;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.8);
    position: relative;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (min-width: 768px) {
    .gis-modal {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  .gis-modal-overlay[data-open="true"] .gis-modal {
    transform: scale(1);
  }
  .gis-modal-img-col {
    background: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 350px;
  }
  .gis-modal-img-col img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
  }
  .gis-modal-info-col {
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .gis-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: color-mix(in srgb, var(--gis-text) 10%, transparent);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gis-text);
    cursor: pointer;
    z-index: 20;
  }
</style>

<section class="gis-section" id="gis-section-{{ section.id }}" aria-labelledby="gis-title-{{ section.id }}">
  <div class="gis-container">
    
    <!-- Section Header -->
    <div class="gis-header">
      <div class="gis-head-text">
        {%- if section.settings.eyebrow != blank -%}
          <div class="gis-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="gis-title-{{ section.id }}" class="gis-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="gis-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.btn_label != blank -%}
        <a href="{{ section.settings.btn_link | default: 'https://instagram.com' }}" target="_blank" rel="noopener noreferrer" class="gis-follow-btn">
          <span>{{ section.settings.btn_label }}</span>
          <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.5;"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
        </a>
      {%- endif -%}
    </div>

    <!-- Social Grid -->
    <div class="gis-grid" role="list">
      {%- for block in section.blocks -%}
        <div class="gis-card" role="listitem" data-src="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 }}{% endif %}" data-handle="{{ block.settings.handle | default: '@obsidian.atelier' }}" data-likes="{{ block.settings.likes | default: '1,420' }}" data-comments="{{ block.settings.comments | default: '84' }}" data-product="{{ block.settings.product_title | default: 'Obsidian Pro Workstation' }}" data-price="{{ block.settings.product_price | default: '$380.00' }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'gis-img', alt: block.settings.product_title }}
          {%- else -%}
            <div style="width:100%;height:100%;background:#333;display:flex;align-items:center;justify-content:center;color:#aaa;font-size:0.9rem;font-weight:700;">Social Post {{ forloop.index }}</div>
          {%- endif -%}

          <div class="gis-overlay">
            <div class="gis-top-bar">
              <span class="gis-handle">{{ block.settings.handle | default: '@obsidian.atelier' }}</span>
              <span class="gis-shop-pin" aria-label="Shoppable Product Tag">
                <svg viewBox="0 0 24 24"><path d="M19 6h-2c0-2.76-2.24-5-5-5S7 3.24 7 6H5c-1.1 0-1.99.9-1.99 2L3 20c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-7-3c1.66 0 3 1.34 3 3H9c0-1.66 1.34-3 3-3zm0 10c-2.76 0-5-2.24-5-5h2c0 1.66 1.34 3 3 3s3-1.34 3-3h2c0 2.76-2.24 5-5 5z"></path></svg>
              </span>
            </div>

            <div class="gis-bot-bar">
              <span class="gis-stat">
                <svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path></svg>
                <span>{{ block.settings.likes | default: '1.4k' }}</span>
              </span>
              <span class="gis-stat">
                <svg viewBox="0 0 24 24"><path d="M21.99 4c0-1.1-.89-2-1.99-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4-.01-18z"></path></svg>
                <span>{{ block.settings.comments | default: '84' }}</span>
              </span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>

  <!-- Shoppable Post Modal Dialog -->
  <div class="gis-modal-overlay" id="gis-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="gis-modal">
      <button type="button" class="gis-modal-close" id="gis-modal-close-{{ section.id }}" aria-label="Close shoppable post modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div class="gis-modal-img-col">
        <img src="" id="gis-modal-img" alt="Enlarged social media post">
      </div>

      <div class="gis-modal-info-col">
        <div style="display:flex;flex-direction:column;gap:1rem;">
          <div style="display:flex;align-items:center;gap:0.75rem;">
            <div style="width:36px;height:36px;border-radius:50%;background:var(--gis-text);color:var(--gis-bg);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.75rem;">OA</div>
            <div>
              <span id="gis-modal-handle" style="font-weight:700;font-size:0.95rem;display:block;">@obsidian.atelier</span>
              <span style="font-size:0.75rem;color:var(--gis-muted);">Original Community Feature</span>
            </div>
          </div>

          <div style="display:flex;gap:1.5rem;font-size:0.85rem;color:var(--gis-muted);border-top:1px solid var(--gis-border);border-bottom:1px solid var(--gis-border);padding:0.75rem 0;">
            <span><strong id="gis-modal-likes" style="color:var(--gis-text);">1,420</strong> Likes</span>
            <span><strong id="gis-modal-comments" style="color:var(--gis-text);">84</strong> Comments</span>
          </div>
        </div>

        <div style="background:color-mix(in srgb,var(--gis-text) 4%,transparent);border:1px solid var(--gis-border);border-radius:24px;padding:1.5rem;display:flex;flex-direction:column;gap:1rem;">
          <span style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:var(--gis-accent);">Featured In This Photo</span>
          
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <div>
              <h3 id="gis-modal-prod" style="font-family:var(--gis-font-head);font-size:1.35rem;margin:0;">Obsidian Pro Workstation</h3>
              <span id="gis-modal-price" style="font-size:1rem;font-weight:700;color:var(--gis-text);">$380.00</span>
            </div>
          </div>

          <a href="/collections/all" style="background:var(--gis-text);color:var(--gis-bg);font-weight:700;font-size:0.92rem;text-align:center;text-decoration:none;padding:1rem;border-radius:100px;transition:all 0.2s ease;display:block;">Acquire This Piece →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('gis-section-' + sid);
    if (!sectionEl) return;

    // Shoppable Lightbox Modal Controller
    var modalOverlay = document.getElementById('gis-modal-' + sid);
    var modalClose = document.getElementById('gis-modal-close-' + sid);
    if (modalOverlay && modalClose) {
      var imgEl = document.getElementById('gis-modal-img');
      var handleEl = document.getElementById('gis-modal-handle');
      var likesEl = document.getElementById('gis-modal-likes');
      var commsEl = document.getElementById('gis-modal-comments');
      var prodEl = document.getElementById('gis-modal-prod');
      var priceEl = document.getElementById('gis-modal-price');

      var cards = sectionEl.querySelectorAll('.gis-card');
      cards.forEach(function(card) {
        card.addEventListener('click', function() {
          var src = card.getAttribute('data-src');
          if (imgEl && src && src !== 'null' && src !== '') imgEl.src = src;
          else if (imgEl) imgEl.src = '';

          if (handleEl) handleEl.innerText = card.getAttribute('data-handle') || '@obsidian.atelier';
          if (likesEl) likesEl.innerText = card.getAttribute('data-likes') || '1,420';
          if (commsEl) commsEl.innerText = card.getAttribute('data-comments') || '84';
          if (prodEl) prodEl.innerText = card.getAttribute('data-product') || 'Obsidian Pro Workstation';
          if (priceEl) priceEl.innerText = card.getAttribute('data-price') || '$380.00';

          modalOverlay.setAttribute('data-open', 'true');
          modalOverlay.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Shoppable Instagram Shop",
  "tag": "section",
  "class": "section-grid-instagram-shop",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0f172a"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Community Showcase"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Spotted In Wild Workstations"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Tag your setup with #ObsidianAtelier for a chance to be featured across our curated community registry."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Follow CTA Label",
      "default": "Follow @obsidian.atelier"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Instagram Profile URL"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Social Media Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post Photo"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Creator Handle",
          "default": "@marcus_vance_studio"
        },
        {
          "type": "text",
          "id": "likes",
          "label": "Like Count Display",
          "default": "2,410"
        },
        {
          "type": "text",
          "id": "comments",
          "label": "Comment Count Display",
          "default": "142"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Tagged Product Name",
          "default": "Monolith Series 04 Workstation"
        },
        {
          "type": "text",
          "id": "product_price",
          "label": "Tagged Product Price",
          "default": "$420.00"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable Instagram Shop",
      "blocks": [
        { "type": "post", "settings": { "handle": "@marcus_vance", "product_title": "Monolith Series 04" } },
        { "type": "post", "settings": { "handle": "@studio_zurich", "product_title": "Acoustic Switch Pack" } },
        { "type": "post", "settings": { "handle": "@minimal_desk", "product_title": "Titanium Desk Mat" } },
        { "type": "post", "settings": { "handle": "@arch_review", "product_title": "Avionics Coiled Cable" } }
      ]
    }
  ]
}
{% endschema %}
