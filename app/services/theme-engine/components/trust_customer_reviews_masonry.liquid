{%- comment -%}
  trust_customer_reviews_masonry.liquid — Ultra-Comprehensive Customer Reviews Masonry
  
  DESIGN PHILOSOPHY:
  An architectural social proof showcase engineered for maximum consumer trust and conversion.
  Features an asymmetric masonry layout with verified buyer checkmarks, interactive rating
  filter tabs, helpfulness voting counter with localStorage persistence, and an accessible
  Review Inspection Modal Dialog to view full customer testimonials and photo uploads.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --crm-bg: {{ section.settings.bg_color | default: '#f8fafc' }};
    --crm-card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --crm-text: {{ section.settings.text_color | default: '#0f172a' }};
    --crm-muted: color-mix(in srgb, var(--crm-text) 60%, transparent);
    --crm-border: color-mix(in srgb, var(--crm-text) 12%, transparent);
    --crm-accent: {{ section.settings.accent_color | default: '#0f172a' }};
    --crm-star: {{ section.settings.star_color | default: '#f59e0b' }};
    --crm-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --crm-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --crm-padding-top: clamp(3.5rem, 8vw, 6.5rem);
    --crm-padding-bottom: clamp(3.5rem, 8vw, 6.5rem);
    --crm-gap: clamp(1.25rem, 3vw, 2rem);
  }

  .crm-section {
    background-color: var(--crm-bg);
    color: var(--crm-text);
    font-family: var(--crm-font-body);
    padding: var(--crm-padding-top) clamp(1.25rem, 4vw, 4rem) var(--crm-padding-bottom);
    border-top: 1px solid var(--crm-border);
    border-bottom: 1px solid var(--crm-border);
    position: relative;
  }

  .crm-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Section Header */
  .crm-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto clamp(2rem, 5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .crm-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--crm-accent);
    background: color-mix(in srgb, var(--crm-accent) 10%, transparent);
    padding: 0.4rem 1rem;
    border-radius: 100px;
  }
  .crm-title {
    font-family: var(--crm-font-head);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 700;
    color: var(--crm-text);
    line-height: 1.15;
    margin: 0;
  }
  .crm-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--crm-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Aggregate Trust Score Bar */
  .crm-score-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    background: var(--crm-card-bg);
    border: 1px solid var(--crm-border);
    border-radius: 100px;
    padding: 0.85rem 2rem;
    width: fit-content;
    margin: 0 auto clamp(2rem, 5vw, 3.5rem);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
  }
  .crm-score-stars {
    display: flex;
    gap: 0.2rem;
    color: var(--crm-star);
  }
  .crm-score-stars svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  .crm-score-val {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--crm-text);
  }
  .crm-score-label {
    font-size: 0.88rem;
    color: var(--crm-muted);
    border-left: 1px solid var(--crm-border);
    padding-left: 1.5rem;
  }

  /* Review Filter Tabs */
  .crm-filter-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .crm-filter-btn {
    background: color-mix(in srgb, var(--crm-text) 5%, transparent);
    color: var(--crm-text);
    border: 1px solid var(--crm-border);
    border-radius: 100px;
    padding: 0.6rem 1.35rem;
    font-family: var(--crm-font-body);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .crm-filter-btn:hover {
    background: color-mix(in srgb, var(--crm-text) 10%, transparent);
  }
  .crm-filter-btn.active {
    background: var(--crm-accent);
    color: #ffffff;
    border-color: var(--crm-accent);
    box-shadow: 0 4px 12px -2px color-mix(in srgb, var(--crm-accent) 35%, transparent);
  }

  /* Masonry Grid */
  .crm-grid {
    column-count: 1;
    column-gap: var(--crm-gap);
  }
  @media (min-width: 640px) {
    .crm-grid {
      column-count: 2;
    }
  }
  @media (min-width: 1024px) {
    .crm-grid {
      column-count: {{ section.settings.columns_desktop | default: 3 }};
    }
  }

  /* Review Masonry Card */
  .crm-card {
    break-inside: avoid;
    margin-bottom: var(--crm-gap);
    background: var(--crm-card-bg);
    border: 1px solid var(--crm-border);
    border-radius: 24px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.2s ease;
  }
  .crm-card[data-hidden="true"] {
    display: none;
  }
  .crm-card:hover {
    transform: translateY(-6px);
    border-color: var(--crm-accent);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.1);
  }

  .crm-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .crm-author-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .crm-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--crm-accent) 15%, transparent);
    color: var(--crm-accent);
    font-weight: 700;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }
  .crm-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .crm-author-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .crm-author-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--crm-text);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .crm-verified-badge {
    color: #10b981;
    display: inline-flex;
  }
  .crm-verified-badge svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }
  .crm-product-tag {
    font-size: 0.75rem;
    color: var(--crm-muted);
  }

  .crm-stars {
    display: flex;
    gap: 0.15rem;
    color: var(--crm-star);
  }
  .crm-stars svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .crm-review-title {
    font-family: var(--crm-font-head);
    font-weight: 700;
    font-size: 1.15rem;
    margin: 0;
    line-height: 1.35;
    color: var(--crm-text);
  }
  .crm-review-text {
    font-size: 0.92rem;
    color: var(--crm-muted);
    line-height: 1.65;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Optional Customer Photo Thumbnail */
  .crm-photo-thumb {
    width: 100%;
    height: 160px;
    border-radius: 12px;
    overflow: hidden;
    background: #0f172a;
    position: relative;
    margin-top: 0.25rem;
  }
  .crm-photo-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .crm-card:hover .crm-photo-thumb img {
    transform: scale(1.06);
  }

  /* Helpfulness Vote Footer */
  .crm-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    border-top: 1px solid var(--crm-border);
    font-size: 0.8rem;
    color: var(--crm-muted);
  }
  .crm-vote-btn {
    background: transparent;
    border: none;
    color: var(--crm-muted);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    transition: all 0.2s ease;
  }
  .crm-vote-btn:hover,
  .crm-vote-btn.voted {
    color: var(--crm-text);
    background: color-mix(in srgb, var(--crm-text) 6%, transparent);
  }
  .crm-vote-btn svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2.2;
    fill: none;
  }

  /* Review Inspection Modal Dialog */
  .crm-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .crm-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .crm-modal {
    background: var(--crm-card-bg);
    color: var(--crm-text);
    border: 1px solid var(--crm-border);
    border-radius: 28px;
    max-width: 660px;
    width: 100%;
    padding: clamp(2rem, 5vw, 3rem);
    position: relative;
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .crm-modal-overlay[data-open="true"] .crm-modal {
    transform: scale(1);
  }
  .crm-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: color-mix(in srgb, var(--crm-text) 10%, transparent);
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--crm-text);
    cursor: pointer;
  }
  .crm-modal-img {
    width: 100%;
    max-height: 340px;
    border-radius: 16px;
    object-fit: cover;
    display: none;
  }
</style>

<section class="crm-section" id="crm-section-{{ section.id }}" aria-labelledby="crm-title-{{ section.id }}">
  <div class="crm-container">
    
    {%- if section.settings.title != blank or section.settings.eyebrow != blank -%}
      <div class="crm-header">
        {%- if section.settings.eyebrow != blank -%}
          <div class="crm-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="crm-title-{{ section.id }}" class="crm-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="crm-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Aggregate Trust Bar -->
    <div class="crm-score-bar">
      <div class="crm-score-stars">
        {%- for i in (1..5) -%}
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        {%- endfor -%}
      </div>
      <span class="crm-score-val">{{ section.settings.avg_rating | default: '4.9' }} / 5.0 Rating</span>
      <span class="crm-score-label">Based on {{ section.settings.review_count | default: '12,450+' }} Verified Customer Experiences</span>
    </div>

    <!-- Review Filter Tabs -->
    {%- if section.settings.show_tabs -%}
      <div class="crm-filter-bar" id="crm-filters-{{ section.id }}" role="tablist">
        <button type="button" class="crm-filter-btn active" data-filter="all" role="tab" aria-selected="true">All Reviews</button>
        <button type="button" class="crm-filter-btn" data-filter="5star" role="tab" aria-selected="false">5-Star Verified</button>
        <button type="button" class="crm-filter-btn" data-filter="photo" role="tab" aria-selected="false">With Photos</button>
        <button type="button" class="crm-filter-btn" data-filter="longterm" role="tab" aria-selected="false">Long-Term Wear</button>
      </div>
    {%- endif -%}

    <!-- Masonry Reviews Grid -->
    <div class="crm-grid" id="crm-grid-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div 
          class="crm-card" 
          data-filter="{{ block.settings.filter_category | default: '5star' }}"
          data-author="{{ block.settings.author | escape }}"
          data-title="{{ block.settings.title | escape }}"
          data-text="{{ block.settings.text | escape }}"
          data-product="{{ block.settings.product_tag | default: 'Verified Purchase' | escape }}"
          data-img="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 }}{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="crm-card-top">
            <div class="crm-author-wrap">
              <div class="crm-avatar">
                {%- if block.settings.avatar != blank -%}
                  {{ block.settings.avatar | image_url: width: 100 | image_tag: loading: 'lazy', alt: block.settings.author }}
                {%- else -%}
                  <span>{{ block.settings.author | slice: 0, 1 }}</span>
                {%- endif -%}
              </div>
              <div class="crm-author-info">
                <span class="crm-author-name">
                  <span>{{ block.settings.author }}</span>
                  <span class="crm-verified-badge" title="Verified Buyer">
                    <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"></path></svg>
                  </span>
                </span>
                <span class="crm-product-tag">{{ block.settings.product_tag | default: 'Verified Purchase' }}</span>
              </div>
            </div>

            <div class="crm-stars">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              {%- endfor -%}
            </div>
          </div>

          <h3 class="crm-review-title">{{ block.settings.title }}</h3>
          <p class="crm-review-text">{{ block.settings.text }}</p>

          {%- if block.settings.image != blank -%}
            <div class="crm-photo-thumb">
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'Customer uploaded photo' }}
            </div>
          {%- endif -%}

          <div class="crm-card-footer">
            <span>Posted on {{ block.settings.date | default: 'October 14, 2026' }}</span>
            <button type="button" class="crm-vote-btn" data-id="crm-vote-{{ section.id }}-{{ forloop.index }}" aria-label="Vote review as helpful">
              <svg viewBox="0 0 24 24"><path d="M14 9V5a3 3 0 00-3-3l-4 9v11h11.28a2 2 0 002-1.7l1.38-9a2 2 0 00-2-2.3zM7 22H4a2 2 0 01-2-2v-7a2 2 0 012-2h3"></path></svg>
              <span>Helpful (<span class="crm-vote-cnt">{{ block.settings.helpful_count | default: 14 }}</span>)</span>
            </button>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>

  <!-- Review Inspection Modal -->
  <div class="crm-modal-overlay" id="crm-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="crm-modal">
      <button type="button" class="crm-modal-close" id="crm-modal-close-{{ section.id }}" aria-label="Close review modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div class="crm-card-top">
        <div class="crm-author-wrap">
          <div class="crm-avatar" id="crm-modal-avatar"><span>A</span></div>
          <div class="crm-author-info">
            <span class="crm-author-name">
              <span id="crm-modal-author">Customer Name</span>
              <span class="crm-verified-badge"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"></path></svg></span>
            </span>
            <span class="crm-product-tag" id="crm-modal-product">Verified Purchase</span>
          </div>
        </div>
        <div class="crm-stars">
          {%- for i in (1..5) -%}<svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>{%- endfor -%}
        </div>
      </div>

      <img src="" id="crm-modal-img" class="crm-modal-img" alt="Customer Review Photo">
      <h3 class="crm-review-title" id="crm-modal-title" style="font-size:1.4rem;">Review Title</h3>
      <p class="crm-review-text" id="crm-modal-text" style="font-size:1rem; -webkit-line-clamp: unset; max-height: 240px; overflow-y: auto;">Full review body text goes here.</p>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('crm-section-' + sid);
    if (!sectionEl) return;

    // 1. Tab Filtering Controller
    var filterBar = document.getElementById('crm-filters-' + sid);
    var grid = document.getElementById('crm-grid-' + sid);
    if (filterBar && grid) {
      var btns = filterBar.querySelectorAll('.crm-filter-btn');
      var cards = grid.querySelectorAll('.crm-card');

      btns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          btns.forEach(function(b) { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');

          var filter = btn.getAttribute('data-filter');
          cards.forEach(function(card) {
            var cat = card.getAttribute('data-filter');
            if (filter === 'all' || cat === filter) {
              card.removeAttribute('data-hidden');
            } else {
              card.setAttribute('data-hidden', 'true');
            }
          });
        });
      });
    }

    // 2. Helpfulness Vote Controller with localStorage
    var voteBtns = sectionEl.querySelectorAll('.crm-vote-btn');
    voteBtns.forEach(function(vbtn) {
      vbtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var vid = vbtn.getAttribute('data-id');
        var cntSpan = vbtn.querySelector('.crm-vote-cnt');
        if (!cntSpan || !vid) return;

        if (localStorage.getItem(vid)) {
          vbtn.classList.remove('voted');
          cntSpan.innerText = parseInt(cntSpan.innerText, 10) - 1;
          localStorage.removeItem(vid);
        } else {
          vbtn.classList.add('voted');
          cntSpan.innerText = parseInt(cntSpan.innerText, 10) + 1;
          localStorage.setItem(vid, 'true');
        }
      });
    });

    // 3. Review Modal Controller
    var modalOverlay = document.getElementById('crm-modal-' + sid);
    var modalClose = document.getElementById('crm-modal-close-' + sid);
    if (modalOverlay && modalClose) {
      var authorEl = document.getElementById('crm-modal-author');
      var productEl = document.getElementById('crm-modal-product');
      var titleEl = document.getElementById('crm-modal-title');
      var textEl = document.getElementById('crm-modal-text');
      var imgEl = document.getElementById('crm-modal-img');
      var avatarEl = document.getElementById('crm-modal-avatar');

      var cards = sectionEl.querySelectorAll('.crm-card');
      cards.forEach(function(card) {
        card.addEventListener('click', function() {
          var author = card.getAttribute('data-author') || 'Customer';
          if (authorEl) authorEl.innerText = author;
          if (productEl) productEl.innerText = card.getAttribute('data-product') || 'Verified Purchase';
          if (titleEl) titleEl.innerText = card.getAttribute('data-title') || 'Review';
          if (textEl) textEl.innerText = card.getAttribute('data-text') || '';
          if (avatarEl) avatarEl.innerHTML = '<span>' + author.slice(0, 1) + '</span>';

          var imgSrc = card.getAttribute('data-img');
          if (imgEl) {
            if (imgSrc && imgSrc !== 'null' && imgSrc !== '') {
              imgEl.src = imgSrc;
              imgEl.style.display = 'block';
            } else {
              imgEl.style.display = 'none';
            }
          }

          modalOverlay.setAttribute('data-open', 'true');
          modalOverlay.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Customer Reviews Masonry",
  "tag": "section",
  "class": "section-trust-reviews-masonry",
  "max_blocks": 16,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#f8fafc"
    },
    {
