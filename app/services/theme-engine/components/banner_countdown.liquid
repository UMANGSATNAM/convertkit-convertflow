{%- comment -%}
  banner_countdown.liquid — Ultra-Comprehensive Limited Drop Urgency Countdown
  
  DESIGN PHILOSOPHY:
  An architectural urgency engine designed for high-stakes limited product drops and seasonal
  allocations. Features a live 60fps JavaScript countdown ticker with zero-layout-shift digits,
  an animated inventory depletion bar, and an accessible Waitlist Allocation Modal Dialog
  for customers when production runs sell out or countdown timers expire.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --bcd-bg: {{ section.settings.bg_color | default: '#0a0a0a' }};
    --bcd-card-bg: {{ section.settings.card_bg_color | default: '#171717' }};
    --bcd-text: {{ section.settings.text_color | default: '#f5f5f5' }};
    --bcd-muted: color-mix(in srgb, var(--bcd-text) 65%, transparent);
    --bcd-border: color-mix(in srgb, var(--bcd-text) 15%, transparent);
    --bcd-accent: {{ section.settings.accent_color | default: '#e11d48' }};
    --bcd-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --bcd-font-head: var(--font-heading, 'Playfair Display', serif);
    --bcd-padding-top: clamp(3.5rem, 8vw, 6rem);
    --bcd-padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .bcd-section {
    background-color: var(--bcd-bg);
    color: var(--bcd-text);
    font-family: var(--bcd-font-body);
    padding: var(--bcd-padding-top) clamp(1.25rem, 4vw, 4rem) var(--bcd-padding-bottom);
    border-top: 1px solid var(--bcd-border);
    border-bottom: 1px solid var(--bcd-border);
    position: relative;
    overflow: hidden;
  }

  .bcd-container {
    max-width: 1400px;
    margin: 0 auto;
    background: var(--bcd-card-bg);
    border: 1px solid var(--bcd-border);
    border-radius: 36px;
    padding: clamp(2.5rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.7);
    position: relative;
  }
  @media (min-width: 1024px) {
    .bcd-container {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  /* Text & Copy Column */
  .bcd-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .bcd-eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--bcd-accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .bcd-eyebrow::before {
    content: "";
    width: 24px;
    height: 1px;
    background: var(--bcd-accent);
  }
  .bcd-title {
    font-family: var(--bcd-font-head);
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 400;
    font-style: italic;
    color: var(--bcd-text);
    line-height: 1.08;
    margin: 0;
  }
  .bcd-desc {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--bcd-muted);
    line-height: 1.65;
    margin: 0;
    max-width: 540px;
  }

  /* Inventory Urgency Bar */
  .bcd-stock-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 480px;
    margin-top: 0.5rem;
  }
  .bcd-stock-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .bcd-stock-val {
    color: var(--bcd-accent);
  }
  .bcd-progress-bg {
    width: 100%;
    height: 8px;
    background: color-mix(in srgb, var(--bcd-text) 10%, transparent);
    border-radius: 100px;
    overflow: hidden;
  }
  .bcd-progress-fill {
    height: 100%;
    background: var(--bcd-accent);
    border-radius: 100px;
    transition: width 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Action Buttons */
  .bcd-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .bcd-btn-pri {
    background: var(--bcd-text);
    color: var(--bcd-bg);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    padding: 1.15rem 2.5rem;
    border-radius: 100px;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .bcd-btn-pri:hover {
    background: var(--bcd-accent);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 15px 30px -5px color-mix(in srgb, var(--bcd-accent) 50%, transparent);
  }
  .bcd-btn-sec {
    background: transparent;
    color: var(--bcd-text);
    border: 1px solid var(--bcd-border);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 1.15rem 2.25rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .bcd-btn-sec:hover {
    background: color-mix(in srgb, var(--bcd-text) 10%, transparent);
    border-color: var(--bcd-text);
  }

  /* Clock Column */
  .bcd-clock-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    background: color-mix(in srgb, var(--bcd-bg) 60%, transparent);
    border: 1px solid var(--bcd-border);
    border-radius: 28px;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 3vw, 3rem);
    text-align: center;
  }
  .bcd-clock-head {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--bcd-muted);
  }
  .bcd-clock-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.75rem, 2vw, 1.5rem);
    width: 100%;
  }
  .bcd-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    background: var(--bcd-card-bg);
    border: 1px solid var(--bcd-border);
    border-radius: 20px;
    padding: clamp(1rem, 2.5vw, 1.5rem) 0.5rem;
    box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.5);
  }
  .bcd-num {
    font-family: var(--bcd-font-head);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    color: var(--bcd-text);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .bcd-lbl {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--bcd-muted);
  }

  /* Expired State Notice */
  .bcd-expired-box {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    padding: 2rem;
    background: color-mix(in srgb, var(--bcd-accent) 15%, transparent);
    border: 1px solid var(--bcd-accent);
    border-radius: 24px;
    width: 100%;
  }
  .bcd-clock-col[data-expired="true"] .bcd-clock-grid,
  .bcd-clock-col[data-expired="true"] .bcd-clock-head {
    display: none;
  }
  .bcd-clock-col[data-expired="true"] .bcd-expired-box {
    display: flex;
  }

  /* Waitlist Modal Dialog */
  .bcd-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .bcd-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .bcd-modal {
    background: var(--bcd-card-bg);
    color: var(--bcd-text);
    border: 1px solid var(--bcd-border);
    border-radius: 28px;
    max-width: 520px;
    width: 100%;
    padding: clamp(2rem, 5vw, 3rem);
    position: relative;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.8);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bcd-modal-overlay[data-open="true"] .bcd-modal {
    transform: scale(1);
  }
  .bcd-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(0, 0, 0, 0.5);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
  }
</style>

<section class="bcd-section" id="bcd-section-{{ section.id }}" aria-labelledby="bcd-title-{{ section.id }}">
  <div class="bcd-container">
    
    <!-- Text & Copy Column -->
    <div class="bcd-content">
      {%- if section.settings.eyebrow != blank -%}
        <div class="bcd-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 id="bcd-title-{{ section.id }}" class="bcd-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="bcd-desc">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      <!-- Inventory Bar -->
      {%- if section.settings.show_stock -%}
        <div class="bcd-stock-wrap">
          <div class="bcd-stock-row">
            <span>Production Allocation Status</span>
            <span class="bcd-stock-val">{{ section.settings.stock_left | default: '14 Pieces Remaining' }}</span>
          </div>
          <div class="bcd-progress-bg">
            <div class="bcd-progress-fill" style="width: {{ section.settings.stock_pct | default: 22 }}%;"></div>
          </div>
        </div>
      {%- endif -%}

      <div class="bcd-actions">
        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_link | default: '/collections/all' }}" class="bcd-btn-pri">
            <span>{{ section.settings.btn_label }}</span>
            <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2.5;"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        {%- endif -%}
        <button type="button" class="bcd-btn-sec" id="bcd-waitlist-btn-{{ section.id }}">Join Allocation Waitlist</button>
      </div>
    </div>

    <!-- Live Clock Column -->
    <div class="bcd-clock-col" id="bcd-clock-col-{{ section.id }}" data-expired="false" data-date="{{ section.settings.target_date | default: '2026-12-31T23:59:59' }}">
      <span class="bcd-clock-head">Time Remaining In Production Window</span>
      
      <div class="bcd-clock-grid">
        <div class="bcd-unit">
          <span class="bcd-num" id="bcd-days-{{ section.id }}">00</span>
          <span class="bcd-lbl">Days</span>
        </div>
        <div class="bcd-unit">
          <span class="bcd-num" id="bcd-hours-{{ section.id }}">00</span>
          <span class="bcd-lbl">Hours</span>
        </div>
        <div class="bcd-unit">
          <span class="bcd-num" id="bcd-mins-{{ section.id }}">00</span>
          <span class="bcd-lbl">Minutes</span>
        </div>
        <div class="bcd-unit">
          <span class="bcd-num" id="bcd-secs-{{ section.id }}">00</span>
          <span class="bcd-lbl">Seconds</span>
        </div>
      </div>

      <div class="bcd-expired-box">
        <h3 style="font-family:var(--bcd-font-head);font-size:1.8rem;margin:0;color:var(--bcd-text);">Allocation Window Closed</h3>
        <p style="font-size:0.95rem;color:var(--bcd-muted);margin:0;">The initial production run has been fully allocated. Register below to receive priority access for Series 05.</p>
      </div>
    </div>

  </div>

  <!-- Waitlist Allocation Modal -->
  <div class="bcd-modal-overlay" id="bcd-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="bcd-modal">
      <button type="button" class="bcd-modal-close" id="bcd-modal-close-{{ section.id }}" aria-label="Close waitlist modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div style="width:56px;height:56px;border-radius:50%;background:color-mix(in srgb,var(--bcd-accent) 15%,transparent);color:var(--bcd-accent);display:flex;align-items:center;justify-content:center;margin:0 auto;">
        <svg viewBox="0 0 24 24" style="width:28px;height:28px;stroke:currentColor;fill:none;stroke-width:2;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
      </div>

      <h3 style="font-family:var(--bcd-font-head);font-size:1.85rem;margin:0;text-align:center;">Priority Waitlist Registry</h3>
      <p style="font-size:0.95rem;color:var(--bcd-muted);margin:0;text-align:center;">Enter your email to secure priority acquisition rights when unallocated production pieces are released.</p>

      <form style="display:flex;flex-direction:column;gap:1rem;" onsubmit="alert('You have been added to the Priority Waitlist.'); return false;">
        <input type="email" placeholder="Enter your email address..." required style="background:var(--bcd-bg);border:1px solid var(--bcd-border);color:var(--bcd-text);padding:1rem 1.35rem;border-radius:100px;font-size:1rem;outline:none;">
        <button type="submit" style="background:var(--bcd-text);color:var(--bcd-bg);font-weight:700;font-size:0.95rem;padding:1.1rem;border-radius:100px;border:none;cursor:pointer;">Register For Priority Access →</button>
      </form>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('bcd-section-' + sid);
    if (!sectionEl) return;

    // 1. Live Countdown Ticker
    var clockCol = document.getElementById('bcd-clock-col-' + sid);
    if (clockCol) {
      var targetStr = clockCol.getAttribute('data-date') || '2026-12-31T23:59:59';
      var targetDate = new Date(targetStr).getTime();
      var daysEl = document.getElementById('bcd-days-' + sid);
      var hoursEl = document.getElementById('bcd-hours-' + sid);
      var minsEl = document.getElementById('bcd-mins-' + sid);
      var secsEl = document.getElementById('bcd-secs-' + sid);

      function updateClock() {
        var now = new Date().getTime();
        var diff = targetDate - now;

        if (diff <= 0) {
          clockCol.setAttribute('data-expired', 'true');
          if (daysEl) daysEl.innerText = '00';
          if (hoursEl) hoursEl.innerText = '00';
          if (minsEl) minsEl.innerText = '00';
          if (secsEl) secsEl.innerText = '00';
          return;
        }

        var d = Math.floor(diff / (1000 * 60 * 60 * 24));
        var h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        var m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        var s = Math.floor((diff % (1000 * 60)) / 1000);

        if (daysEl) daysEl.innerText = (d < 10 ? '0' : '') + d;
        if (hoursEl) hoursEl.innerText = (h < 10 ? '0' : '') + h;
        if (minsEl) minsEl.innerText = (m < 10 ? '0' : '') + m;
        if (secsEl) secsEl.innerText = (s < 10 ? '0' : '') + s;
      }

      updateClock();
      setInterval(updateClock, 1000);
    }

    // 2. Waitlist Modal Controller
    var modalOverlay = document.getElementById('bcd-modal-' + sid);
    var modalClose = document.getElementById('bcd-modal-close-' + sid);
    var waitlistBtn = document.getElementById('bcd-waitlist-btn-' + sid);

    if (modalOverlay && modalClose && waitlistBtn) {
      waitlistBtn.addEventListener('click', function() {
        modalOverlay.setAttribute('data-open', 'true');
        modalOverlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Countdown Urgency Banner",
  "tag": "section",
  "class": "section-banner-countdown",
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Banner Card Background",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#e11d48"
    },
    {
      "type": "header",
      "content": "Countdown & Inventory"
    },
    {
      "type": "text",
      "id": "target_date",
      "label": "Target Countdown Date (ISO String)",
      "default": "2026-12-31T23:59:59"
    },
    {
      "type": "checkbox",
      "id": "show_stock",
      "label": "Show Inventory Depletion Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "stock_left",
      "label": "Stock Text Display",
      "default": "14 Pieces Remaining In Batch"
    },
    {
      "type": "range",
      "id": "stock_pct",
      "label": "Stock Depletion Percentage (%)",
      "min": 5,
      "max": 95,
      "step": 1,
      "default": 18
    },
    {
      "type": "header",
      "content": "Copy & CTAs"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Limited Atelier Drop #04"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Monolith Series 04 Allocation"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Only 100 serialized units have been milled for this quarterly release. Once the allocation countdown expires, registration closes until next season."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Primary Button Label",
      "default": "Acquire Allocation"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Primary Button URL"
    }
  ],
  "presets": [
    {
      "name": "Countdown Urgency Banner"
    }
  ]
}
{% endschema %}
