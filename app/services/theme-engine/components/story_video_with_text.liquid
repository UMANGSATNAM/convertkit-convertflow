{%- comment -%}
  story_video_with_text.liquid — Ultra-Comprehensive Cinematic Video Storytelling Section
  
  DESIGN PHILOSOPHY:
  An immersive documentary-style storytelling feature designed for brand prestige.
  Features custom HTML5/Embed video controls with mute and playback overlays, interactive
  chapter timestamp jumping, full-screen cinema modal dialog, and reversible split layouts.
  Engineered for 60fps responsiveness and zero layout shift.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --svt-bg: {{ section.settings.bg_color | default: '#0f172a' }};
    --svt-card-bg: {{ section.settings.card_bg_color | default: '#1e293b' }};
    --svt-text: {{ section.settings.text_color | default: '#f8fafc' }};
    --svt-muted: color-mix(in srgb, var(--svt-text) 65%, transparent);
    --svt-border: color-mix(in srgb, var(--svt-text) 14%, transparent);
    --svt-accent: {{ section.settings.accent_color | default: '#38bdf8' }};
    --svt-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --svt-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --svt-padding-top: clamp(4rem, 8vw, 7rem);
    --svt-padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .svt-section {
    background-color: var(--svt-bg);
    color: var(--svt-text);
    font-family: var(--svt-font-body);
    padding: var(--svt-padding-top) clamp(1.25rem, 4vw, 4rem) var(--svt-padding-bottom);
    border-top: 1px solid var(--svt-border);
    border-bottom: 1px solid var(--svt-border);
    position: relative;
    overflow: hidden;
  }

  .svt-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .svt-container {
      grid-template-columns: {{ section.settings.layout_ratio | default: '1.1fr 1fr' }};
    }
    .svt-container[data-reverse="true"] {
      grid-template-columns: {{ section.settings.layout_ratio_rev | default: '1fr 1.1fr' }};
    }
    .svt-container[data-reverse="true"] .svt-media-wrap {
      order: 2;
    }
    .svt-container[data-reverse="true"] .svt-content {
      order: 1;
    }
  }

  /* Video Media Container */
  .svt-media-wrap {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    background: #000000;
    border: 1px solid var(--svt-border);
    aspect-ratio: {{ section.settings.aspect_ratio | default: '16/9' }};
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.5);
    group: svt-media;
  }
  .svt-video-el,
  .svt-iframe-el {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: none;
    display: block;
  }

  /* Custom Video Overlay Controls */
  .svt-controls-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    transition: opacity 0.3s ease, background 0.3s ease;
    z-index: 5;
  }
  .svt-media-wrap[data-playing="true"] .svt-controls-overlay {
    opacity: 0;
    pointer-events: none;
  }
  .svt-media-wrap:hover .svt-controls-overlay {
    opacity: 1;
    pointer-events: auto;
    background: rgba(0, 0, 0, 0.5);
  }

  .svt-play-btn {
    width: clamp(64px, 10vw, 88px);
    height: clamp(64px, 10vw, 88px);
    border-radius: 50%;
    background: var(--svt-accent);
    color: #000000;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s ease;
  }
  .svt-play-btn:hover {
    transform: scale(1.12);
    background: #ffffff;
  }
  .svt-play-btn svg {
    width: clamp(24px, 4vw, 36px);
    height: clamp(24px, 4vw, 36px);
    fill: currentColor;
    margin-left: 4px;
  }

  .svt-sound-btn,
  .svt-cinema-btn {
    position: absolute;
    bottom: 1.25rem;
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 100px;
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
    z-index: 6;
  }
  .svt-sound-btn:hover,
  .svt-cinema-btn:hover {
    background: #ffffff;
    color: #000000;
  }
  .svt-sound-btn { left: 1.25rem; }
  .svt-cinema-btn { right: 1.25rem; }
  .svt-sound-btn svg,
  .svt-cinema-btn svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 2.2;
    fill: none;
  }

  /* Story Content Column */
  .svt-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .svt-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--svt-accent);
    background: color-mix(in srgb, var(--svt-accent) 12%, transparent);
    padding: 0.45rem 1.15rem;
    border-radius: 100px;
    border: 1px solid color-mix(in srgb, var(--svt-accent) 30%, transparent);
    width: fit-content;
  }
  .svt-title {
    font-family: var(--svt-font-head);
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 700;
    color: var(--svt-text);
    line-height: 1.15;
    margin: 0;
  }
  .svt-desc {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--svt-muted);
    line-height: 1.65;
    margin: 0;
  }

  /* Interactive Chapter Timestamp Navigation */
  .svt-chapters {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .svt-chapter-btn {
    background: color-mix(in srgb, var(--svt-text) 5%, transparent);
    border: 1px solid var(--svt-border);
    border-radius: 16px;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: left;
    color: var(--svt-text);
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .svt-chapter-btn:hover {
    background: color-mix(in srgb, var(--svt-text) 10%, transparent);
    border-color: var(--svt-accent);
    transform: translateX(6px);
  }
  .svt-chapter-btn.active {
    background: color-mix(in srgb, var(--svt-accent) 15%, transparent);
    border-color: var(--svt-accent);
  }
  .svt-chapter-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .svt-chapter-title {
    font-family: var(--svt-font-head);
    font-size: 1.05rem;
    font-weight: 700;
  }
  .svt-chapter-sub {
    font-size: 0.82rem;
    color: var(--svt-muted);
  }
  .svt-time-badge {
    background: color-mix(in srgb, var(--svt-accent) 20%, transparent);
    color: var(--svt-accent);
    font-family: monospace;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
  }

  /* Action CTA */
  .svt-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--svt-font-body);
    font-size: 0.95rem;
    font-weight: 700;
    color: #000000;
    background: var(--svt-accent);
    padding: 1.15rem 2.5rem;
    border-radius: 100px;
    text-decoration: none;
    width: fit-content;
    margin-top: 0.5rem;
    transition: transform 0.2s ease, opacity 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 10px 25px -5px color-mix(in srgb, var(--svt-accent) 40%, transparent);
  }
  .svt-cta:hover {
    opacity: 0.92;
    transform: translateY(-2px);
    box-shadow: 0 15px 30px -5px color-mix(in srgb, var(--svt-accent) 55%, transparent);
  }
  .svt-cta svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 2.5;
  }

  /* Cinema Full-Screen Modal */
  .svt-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .svt-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .svt-modal {
    background: #000000;
    border-radius: 24px;
    max-width: 1100px;
    width: 100%;
    aspect-ratio: 16 / 9;
    position: relative;
    overflow: hidden;
    box-shadow: 0 35px 70px rgba(0, 0, 0, 0.8);
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .svt-modal-overlay[data-open="true"] .svt-modal {
    transform: scale(1);
  }
  .svt-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(255, 255, 255, 0.2);
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
    z-index: 10;
    transition: background 0.2s ease;
  }
  .svt-modal-close:hover {
    background: rgba(255, 255, 255, 0.4);
  }
</style>

<section class="svt-section" id="svt-section-{{ section.id }}" aria-label="Brand Video Storytelling">
  <div class="svt-container" data-reverse="{{ section.settings.reverse_layout | default: false }}">
    
    <!-- Video Media Column -->
    <div class="svt-media-wrap" id="svt-media-{{ section.id }}" data-playing="false">
      {%- if section.settings.video_type == 'html5' and section.settings.video_mp4 != blank -%}
        <video 
          id="svt-video-{{ section.id }}" 
          class="svt-video-el" 
          src="{{ section.settings.video_mp4 }}" 
          poster="{{ section.settings.poster_image | image_url: width: 1200 }}" 
          playsinline 
          loop 
          muted
        ></video>
      {%- elsif section.settings.video_embed_url != blank -%}
        <iframe 
          id="svt-iframe-{{ section.id }}" 
          class="svt-iframe-el" 
          src="{{ section.settings.video_embed_url }}?enablejsapi=1&mute=1&loop=1" 
          allow="autoplay; fullscreen; encrypted-media" 
          allowfullscreen
        ></iframe>
      {%- else -%}
        <div style="width:100%;height:100%;background:linear-gradient(135deg,#1e293b,#0f172a,#0284c7);display:flex;align-items:center;justify-content:center;color:#ffffff;font-size:1.2rem;font-weight:700;">Brand Documentary Preview</div>
      {%- endif -%}

      <!-- Play Overlay Controls -->
      <div class="svt-controls-overlay" id="svt-overlay-{{ section.id }}">
        <button type="button" class="svt-play-btn" id="svt-play-{{ section.id }}" aria-label="Play video film">
          <svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
        </button>
      </div>

      <!-- Bottom Audio / Cinema Utilities -->
      {%- if section.settings.video_type == 'html5' -%}
        <button type="button" class="svt-sound-btn" id="svt-sound-{{ section.id }}" aria-label="Toggle mute sound">
          <svg class="svt-icon-muted" viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
          <span id="svt-sound-text">Muted</span>
        </button>
      {%- endif -%}

      <button type="button" class="svt-cinema-btn" id="svt-cinema-{{ section.id }}" aria-label="Open full-screen cinema mode">
        <span>Cinema Mode</span>
        <svg viewBox="0 0 24 24"><path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"></path></svg>
      </button>
    </div>

    <!-- Story Text & Chapter Navigation Column -->
    <div class="svt-content">
      {%- if section.settings.eyebrow != blank -%}
        <div class="svt-eyebrow">
          <span>▶</span>
          <span>{{ section.settings.eyebrow }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="svt-title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="svt-desc">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      <!-- Interactive Chapter Timestamps -->
      {%- if section.blocks.size > 0 -%}
        <div class="svt-chapters" id="svt-chapters-{{ section.id }}">
          {%- for block in section.blocks -%}
            <button 
              type="button" 
              class="svt-chapter-btn {% if forloop.first %}active{% endif %}" 
              data-time="{{ block.settings.timestamp_seconds | default: 0 }}" 
              {{ block.shopify_attributes }}
            >
              <div class="svt-chapter-info">
                <span class="svt-chapter-title">{{ block.settings.title }}</span>
                <span class="svt-chapter-sub">{{ block.settings.subtitle }}</span>
              </div>
              <span class="svt-time-badge">{{ block.settings.timestamp_label | default: '00:00' }}</span>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.btn_label != blank -%}
        <a href="{{ section.settings.btn_link | default: '/pages/about' }}" class="svt-cta">
          <span>{{ section.settings.btn_label }}</span>
          <svg viewBox="0 0 24 24" fill="none"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      {%- endif -%}
    </div>

  </div>

  <!-- Full Screen Cinema Modal -->
  <div class="svt-modal-overlay" id="svt-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="svt-modal">
      <button type="button" class="svt-modal-close" id="svt-modal-close-{{ section.id }}" aria-label="Close cinema modal">
        <svg viewBox="0 0 24 24" style="width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <div id="svt-modal-body-{{ section.id }}" style="width:100%;height:100%;"></div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('svt-section-' + sid);
    if (!sectionEl) return;

    var mediaWrap = document.getElementById('svt-media-' + sid);
    var videoEl = document.getElementById('svt-video-' + sid);
    var playBtn = document.getElementById('svt-play-' + sid);
    var soundBtn = document.getElementById('svt-sound-' + sid);
    var soundText = document.getElementById('svt-sound-text');

    // 1. Play / Pause Controller
    if (mediaWrap && videoEl && playBtn) {
      playBtn.addEventListener('click', function() {
        if (videoEl.paused) {
          videoEl.play();
          mediaWrap.setAttribute('data-playing', 'true');
        } else {
          videoEl.pause();
          mediaWrap.setAttribute('data-playing', 'false');
        }
      });

      videoEl.addEventListener('click', function() {
        if (!videoEl.paused) {
          videoEl.pause();
          mediaWrap.setAttribute('data-playing', 'false');
        }
      });
    }

    // 2. Sound Mute Toggle
    if (videoEl && soundBtn && soundText) {
      soundBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        videoEl.muted = !videoEl.muted;
        soundText.innerText = videoEl.muted ? 'Muted' : 'Sound On';
      });
    }

    // 3. Chapter Timestamp Navigation
    var chaptersWrap = document.getElementById('svt-chapters-' + sid);
    if (chaptersWrap && videoEl) {
      var cbtns = chaptersWrap.querySelectorAll('.svt-chapter-btn');
      cbtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          cbtns.forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');

          var sec = parseInt(btn.getAttribute('data-time'), 10) || 0;
          videoEl.currentTime = sec;
          if (videoEl.paused) {
            videoEl.play();
            mediaWrap.setAttribute('data-playing', 'true');
          }
        });
      });
    }

    // 4. Cinema Full-Screen Modal Controller
    var modalOverlay = document.getElementById('svt-modal-' + sid);
    var modalClose = document.getElementById('svt-modal-close-' + sid);
    var cinemaBtn = document.getElementById('svt-cinema-' + sid);
    var modalBody = document.getElementById('svt-modal-body-' + sid);

    if (modalOverlay && modalClose && cinemaBtn && modalBody) {
      cinemaBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var mp4 = '{{ section.settings.video_mp4 }}';
        var embed = '{{ section.settings.video_embed_url }}';

        if (mp4 && mp4 !== '') {
          modalBody.innerHTML = '<video src="' + mp4 + '" style="width:100%;height:100%;object-fit:cover;" autoplay controls></video>';
        } else if (embed && embed !== '') {
          modalBody.innerHTML = '<iframe src="' + embed + '?autoplay=1" style="width:100%;height:100%;border:none;" allow="autoplay; fullscreen" allowfullscreen></iframe>';
        }

        modalOverlay.setAttribute('data-open', 'true');
        modalOverlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        modalBody.innerHTML = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Story Video With Text",
  "tag": "section",
  "class": "section-story-video-text",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#1e293b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#38bdf8"
    },
    {
      "type": "header",
      "content": "Layout Direction"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse Layout (Video on Right)",
      "default": false
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Video Aspect Ratio",
      "options": [
        { "value": "16/9", "label": "Landscape (16:9)" },
        { "value": "4/3", "label": "Standard (4:3)" },
        { "value": "1/1", "label": "Square (1:1)" }
      ],
      "default": "16/9"
    },
    {
      "type": "header",
      "content": "Video Media Settings"
    },
    {
      "type": "select",
      "id": "video_type",
      "label": "Video Source Type",
      "options": [
        { "value": "html5", "label": "HTML5 MP4 Video" },
        { "value": "embed", "label": "YouTube / Vimeo Embed URL" }
      ],
      "default": "html5"
    },
    {
      "type": "text",
      "id": "video_mp4",
      "label": "HTML5 Video URL (.mp4)",
      "default": "https://cdn.shopify.com/videos/c/o/v/sample.mp4"
    },
    {
      "type": "text",
      "id": "video_embed_url",
      "label": "YouTube / Vimeo Embed URL (if Embed selected)",
      "default": "https://www.youtube.com/embed/dQw4w9WgXcQ"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Video Poster Cover Image"
    },
    {
      "type": "header",
      "content": "Story Text & Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "The Heritage Film"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Crafted Without Compromise"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Step inside our Swiss engineering atelier and witness the meticulous 48-hour assembly process behind every serialized collector unit we produce."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Action Button Label",
      "default": "Read Our Full Origin Story"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Action Button URL"
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Video Chapter Timestamp",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Chapter Title",
          "default": "01. Sustainable Raw Materials"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Chapter Description",
          "default": "Sourcing 100% recycled aerospace titanium"
        },
        {
          "type": "text",
          "id": "timestamp_label",
          "label": "Timestamp Badge Display",
          "default": "00:15"
        },
        {
          "type": "number",
          "id": "timestamp_seconds",
          "label": "Video Jump Second (HTML5 only)",
          "default": 15
        }
      ]
    }
  ],
  "presets": [
    {
