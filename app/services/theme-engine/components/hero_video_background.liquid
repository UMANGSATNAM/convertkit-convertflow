<div class="sf-hero-video sf-hero-{{ section.id }}">
  <div class="sf-video-wrapper">
    {% if section.settings.video_url != blank %}
      <video autoplay muted loop playsinline class="sf-video-bg">
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {% else %}
      <div class="sf-video-placeholder" style="background-color: #333;"></div>
    {% endif %}
    <div class="sf-video-overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  </div>
  
  <div class="sf-hero-video__content">
    <h2 class="sf-hero-video__title">{{ section.settings.title }}</h2>
    <p class="sf-hero-video__subtitle">{{ section.settings.subtitle }}</p>
    {% if section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}" class="sf-btn-video">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>

<style>
  .sf-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    height: 80vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .sf-video-wrapper {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 1;
  }
  .sf-video-bg, .sf-video-placeholder {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .sf-video-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-color: #000;
  }
  .sf-hero-video__content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: {{ section.settings.text_color }};
    padding: 0 20px;
    max-width: 800px;
  }
  .sf-hero-video__title {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    text-transform: uppercase;
    color: inherit;
  }
  .sf-hero-video__subtitle {
    font-size: 1.2rem;
    margin-bottom: 2.5rem;
    opacity: 0.9;
  }
  .sf-btn-video {
    display: inline-block;
    padding: 15px 35px;
    background: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    text-decoration: none;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: transform 0.3s ease;
  }
  .sf-btn-video:hover {
    transform: scale(1.05);
  }
  @media (max-width: 767px) {
    .sf-hero-video__title { font-size: 2.2rem; }
    .sf-hero-{{ section.id }} { height: 60vh; }
  }
</style>

{% schema %}
{
  "name": "Video Background Hero",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "MP4 Video URL",
      "info": "Upload a video to Shopify Files and paste the link here."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Unleash The Power"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Experience the next generation of performance."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Watch Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0, "max": 100, "step": 10,
      "label": "Overlay Opacity",
      "default": 40
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Video Background Hero",
      "category": "Hero"
    }
  ]
}
{% endschema %}
