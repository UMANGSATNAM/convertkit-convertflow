<footer class="footer-multi-column bg-[var(--color-background)] text-[var(--color-text)] pt-20 pb-10 px-6 border-t border-neutral-800">
  <div class="max-w-[1440px] mx-auto">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 lg:gap-8 mb-16">
      
      <!-- Brand & Mission (Spans 2 columns on lg) -->
      <div class="lg:col-span-2">
        {%- if section.settings.logo_light != blank -%}
          <img src="{{ section.settings.logo_light | img_url: '400x' }}" alt="{{ shop.name }}" class="h-10 w-auto mb-6" loading="lazy">
        {%- else -%}
          <h2 class="text-3xl font-black uppercase tracking-widest mb-6">{{ shop.name }}</h2>
        {%- endif -%}
        
        <p class="text-[var(--color-text-muted, #a3a3a3)] max-w-sm mb-8 leading-relaxed">
          {{ section.settings.mission_text }}
        </p>

        <!-- Social Icons -->
        <div class="flex gap-4">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" class="w-10 h-10 rounded-full border border-neutral-700 flex items-center justify-center hover:bg-[var(--color-background)] hover:text-[var(--color-text)] transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          {%- endif -%}
          <!-- Add other social icons similarly mapped to settings -->
        </div>
      </div>

      <!-- Link Columns -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div>
            <h4 class="text-sm font-bold uppercase tracking-widest mb-6">{{ block.settings.title }}</h4>
            <ul class="space-y-4 text-[var(--color-text-muted, #a3a3a3)]">
              {%- for link in linklists[block.settings.menu].links -%}
                <li>
                  <a href="{{ link.url }}" class="hover:text-[var(--color-background)] transition-colors relative group inline-block">
                    {{ link.title }}
                    <span class="absolute -bottom-1 left-0 w-full h-px bg-[var(--color-background)] scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-neutral-800 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-neutral-500">
      <div class="flex gap-4">
        <span>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.</span>
      </div>
      <div class="flex items-center gap-4">
        <!-- Payment Icons -->
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'h-6 w-auto grayscale opacity-50' }}
        {%- endfor -%}
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer - Multi-Column",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_light",
      "label": "Light Logo"
    },
    {
      "type": "textarea",
      "id": "mission_text",
      "label": "Mission Text",
      "default": "Redefining everyday essentials with uncompromising quality and timeless design."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu Column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer - Multi-Column",
      "blocks": [
        { "type": "link_list" },
        { "type": "link_list" }
      ]
    }
  ]
}
{% endschema %}
