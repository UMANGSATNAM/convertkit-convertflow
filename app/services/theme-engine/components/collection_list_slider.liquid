{%- comment -%}
  collection_list_slider.liquid — Horizontal Collection Carousel / Slider
  
  DESIGN PHILOSOPHY:
  Touch-friendly horizontal scrolling carousel for browsing categories.
  Features smooth native snap scrolling, hover zoom cards, and clean
  arrow navigation controls. Works across mobile and desktop.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --cls-bg: var(--color-background, #ffffff);
    --cls-text: var(--color-text, #18181b);
    --cls-muted: color-mix(in srgb, var(--cls-text) 50%, transparent);
    --cls-border: color-mix(in srgb, var(--cls-text) 12%, transparent);
    --cls-accent: var(--color-accent, #2563eb);
    --cls-font: var(--font-body, 'Inter', -apple-system, sans-serif);
    --cls-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
  }

  .cls-section {
    background: var(--cls-bg);
    padding: clamp(3rem, 7vw, 6rem) clamp(1.25rem, 4vw, 3.5rem);
  }

  .cls-inner {
    max-width: 1360px;
    margin: 0 auto;
  }

  .cls-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
  }
  .cls-eyebrow {
    font-family: var(--cls-font);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--cls-accent);
    margin-bottom: 0.4rem;
  }
  .cls-title {
    font-family: var(--cls-font-head);
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--cls-text);
    margin: 0;
  }

  .cls-controls {
    display: flex;
    gap: 0.5rem;
  }
  .cls-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--cls-border);
    background: var(--cls-bg);
    color: var(--cls-text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, transform 0.15s;
  }
  .cls-btn:hover {
    background: color-mix(in srgb, var(--cls-text) 6%, transparent);
    border-color: var(--cls-text);
  }
  .cls-btn:active {
    transform: scale(0.92);
  }
  .cls-btn svg {
    width: 18px;
    height: 18px;
    stroke-width: 2;
    stroke: currentColor;
    fill: none;
  }

  .cls-track {
    display: flex;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 1rem;
    scrollbar-width: none;
  }
  .cls-track::-webkit-scrollbar {
    display: none;
  }

  .cls-card {
    flex: 0 0 clamp(240px, 45vw, 340px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--cls-text);
    group: cls-card;
  }

  .cls-media {
    aspect-ratio: var(--aspect, 4/5);
    background: color-mix(in srgb, var(--cls-text) 4%, transparent);
    border-radius: var(--radius-card, 16px);
    overflow: hidden;
    position: relative;
    margin-bottom: 1rem;
    border: 1px solid var(--cls-border);
  }
  .cls-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cls-card:hover .cls-media img {
    transform: scale(1.06);
  }

  .cls-card-title {
    font-family: var(--cls-font-head);
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 0.2rem 0;
  }
  .cls-card-count {
    font-family: var(--cls-font);
    font-size: 0.8rem;
    color: var(--cls-muted);
  }
</style>

<section class="cls-section" aria-labelledby="cls-title-{{ section.id }}">
  <div class="cls-inner">
    <div class="cls-header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="cls-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="cls-title-{{ section.id }}" class="cls-title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>
      <div class="cls-controls">
        <button type="button" class="cls-btn" id="cls-prev-{{ section.id }}" aria-label="Previous categories">
          <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="cls-btn" id="cls-next-{{ section.id }}" aria-label="Next categories">
          <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>

    <div class="cls-track" id="cls-track-{{ section.id }}" style="--aspect: {{ section.settings.aspect_ratio | default: '4/5' }};">
      {%- for block in section.blocks -%}
        {%- assign coll = collections[block.settings.collection] -%}
        <a href="{{ block.settings.url | default: coll.url | default: '#' }}" class="cls-card" {{ block.shopify_attributes }}>
          <div class="cls-media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- elsif coll.image != blank -%}
              {{ coll.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: coll.title }}
            {%- else -%}
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--cls-muted); font-size: 0.8rem;">
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
          <h3 class="cls-card-title">{{ block.settings.title | default: coll.title | default: 'Category Name' }}</h3>
          <span class="cls-card-count">{{ block.settings.count_text | default: coll.all_products_count | append: ' Products' | default: '12 Products' }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var track = document.getElementById('cls-track-' + sid);
    var prev = document.getElementById('cls-prev-' + sid);
    var next = document.getElementById('cls-next-' + sid);
    if (!track || !prev || !next) return;

    var step = 320;
    prev.addEventListener('click', function() {
      track.scrollBy({ left: -step, behavior: 'smooth' });
    });
    next.addEventListener('click', function() {
      track.scrollBy({ left: step, behavior: 'smooth' });
    });
  })();
</script>

{% schema %}
{
  "name": "Collection Slider",
  "tag": "section",
  "class": "section-collection-slider",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Browse Categories"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop by Department"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Card Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "16/9", "label": "Landscape (16:9)" }
      ],
      "default": "4/5"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Shopify Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom Image (Override)" },
        { "type": "text", "id": "title", "label": "Custom Title (Override)", "default": "New Arrivals" },
        { "type": "text", "id": "count_text", "label": "Subtitle / Count", "default": "24 Products" },
        { "type": "url", "id": "url", "label": "Custom URL (Override)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Slider",
      "blocks": [
        { "type": "collection", "settings": { "title": "New Arrivals", "count_text": "32 Products" } },
        { "type": "collection", "settings": { "title": "Best Sellers", "count_text": "18 Products" } },
        { "type": "collection", "settings": { "title": "Accessories & Gear", "count_text": "45 Products" } },
        { "type": "collection", "settings": { "title": "Limited Drops", "count_text": "8 Products" } }
      ]
    }
  ]
}
{% endschema %}
