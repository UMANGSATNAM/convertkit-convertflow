  const handle = "{{ product.handle }}";
  let viewed = JSON.parse(localStorage.getItem('shopify_recently_viewed') || '[]');
  viewed = viewed.filter(h => h !== handle); // Remove if exists
  viewed.unshift(handle); // Add to beginning
  viewed = viewed.slice(0, 10); // Keep last 10
  localStorage.setItem('shopify_recently_viewed', JSON.stringify(viewed));
</script>
*/
</script>

{% schema %}
{
  "name": "Recently Viewed",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Recently Viewed"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 10,
      "step": 1,
      "default": 5,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Recently Viewed"
    }
  ]
}
{% endschema %}
