    <!-- Footer Guarantee -->
    <div class="bb__footer">
      // <strong>THE HARDWARE ECOSYSTEM PLEDGE:</strong> Built by engineers for engineers. We guarantee absolute hardware compatibility across every adapter, cable, and peripheral in our curated catalog. //
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var slots = section.querySelectorAll('.bb__slot');
    var cards = section.querySelectorAll('.bb__card');
    var summaryList = section.querySelector('[data-summary-list]');
    var sumSub = section.querySelector('[data-sum-sub]');
    var sumDisc = section.querySelector('[data-sum-disc]');
    var sumShip = section.querySelector('[data-sum-ship]');
    var sumFinal = section.querySelector('[data-sum-final]');
    var addBtn = section.querySelector('[data-add-rig]');

    var trackStatus = section.querySelector('[data-track-status]');
    var trackSavings = section.querySelector('[data-track-savings]');
    var trackBar = section.querySelector('[data-track-bar]');
    var tier1 = section.querySelector('[data-tier-1]');
    var tier2 = section.querySelector('[data-tier-2]');
    var tier3 = section.querySelector('[data-tier-3]');

    var tabs = section.querySelectorAll('.bb__tab');
    var contents = section.querySelectorAll('.bb__content');

    var selectedProducts = {
      '1': { id: 'p1', name: 'CYBER DECK PRO 16" (M3 MAX)', price: 245000 },
      '2': { id: 'p3', name: '140W GAN 3-PORT NITRO STATION', price: 8500 }
    };

    function updateSummary() {
      var subtotal = 0;
      var count = 0;
      var html = '';

      for (var slotId in selectedProducts) {
        var p = selectedProducts[slotId];
        subtotal += p.price;
        count++;
        html += '<div class="bb__summary-item"><span class="bb__sum-name">[' + slotId + '] ' + p.name + '</span><span class="bb__sum-price">RS. ' + p.price.toLocaleString('en-IN') + '</span></div>';
      }

      if (summaryList) summaryList.innerHTML = html || '<div class="bb__summary-item">// NO HARDWARE SELECTED //</div>';

      var discPct = 0;
      if (count === 2) discPct = 10;
      else if (count === 3) discPct = 15;
      else if (count >= 4) discPct = 20;

      var discAmount = Math.round(subtotal * (discPct / 100));
      var finalAmount = subtotal - discAmount;

      if (sumSub) sumSub.textContent = 'RS. ' + subtotal.toLocaleString('en-IN');
      if (sumDisc) sumDisc.textContent = discPct > 0 ? ('- RS. ' + discAmount.toLocaleString('en-IN') + ' (' + discPct + '% OFF)') : 'RS. 0';
      if (sumShip) sumShip.textContent = count >= 3 ? 'FREE PRIORITY AIR EXPRESS' : 'STANDARD CHARGE (RS. 500)';
      if (sumFinal) sumFinal.textContent = 'RS. ' + finalAmount.toLocaleString('en-IN');

      if (addBtn) {
        addBtn.textContent = '[ ADD ' + count + '-SLOT ECOSYSTEM RIG TO CART &bull; INSTANT LOCK ]';
      }

      // Update progress bar
      if (tier1) tier1.classList.toggle('is-unlocked', count >= 2);
      if (tier2) tier2.classList.toggle('is-unlocked', count >= 3);
      if (tier3) tier3.classList.toggle('is-unlocked', count >= 4);

      if (trackBar) {
        var widthPct = count <= 1 ? 25 : (count === 2 ? 50 : (count === 3 ? 75 : 100));
        trackBar.style.width = widthPct + '%';
      }

      if (trackStatus && trackSavings) {
        if (count <= 1) {
          trackStatus.textContent = '[ STATUS: BASE WORKSTATION ONLY ]';
          trackSavings.textContent = '// ADD 1 MORE ITEM TO UNLOCK +10% OFF //';
        } else if (count === 2) {
          trackStatus.textContent = '[ STATUS: TIER 1 ACTIVE &bull; 10% SAVINGS UNLOCKED ]';
          trackSavings.textContent = '// ADD 1 MORE ITEM TO UNLOCK +15% OFF + FREE SHIPPING //';
        } else if (count === 3) {
          trackStatus.textContent = '[ STATUS: TIER 2 ACTIVE &bull; 15% SAVINGS UNLOCKED ]';
          trackSavings.textContent = '// ADD 1 MORE ITEM TO UNLOCK +20% OFF + FREE 2-YR VIP CARE //';
        } else {
          trackStatus.textContent = '[ STATUS: MAX TIER 3 ACTIVE &bull; 20% SAVINGS + VIP CARE UNLOCKED ]';
          trackSavings.textContent = '// MAXIMUM ECOSYSTEM SYNCHRONIZATION ACHIEVED //';
        }
      }
    }

    cards.forEach(function(card) {
      card.addEventListener('click', function() {
        var slot = this.closest('.bb__slot');
        if (!slot) return;
        var slotId = slot.getAttribute('data-slot');

        var id = this.getAttribute('data-id');
        var name = this.getAttribute('data-name');
        var price = parseInt(this.getAttribute('data-price') || '0', 10);

        // Check if already active
        if (this.classList.contains('is-active')) {
          if (slotId === '1') {
            alert('[ SYSTEM NOTE ] Core Workstation Device is required for ecosystem setup.');
            return;
          }
          this.classList.remove('is-active');
          var cb = this.querySelector('.bb__checkbox');
          if (cb) cb.textContent = '[ ]';
          delete selectedProducts[slotId];
          slot.classList.remove('is-selected');
        } else {
          var slotCards = slot.querySelectorAll('.bb__card');
          slotCards.forEach(function(c) {
            c.classList.remove('is-active');
            var cb = c.querySelector('.bb__checkbox');
            if (cb) cb.textContent = '[ ]';
          });

          this.classList.add('is-active');
          var cb2 = this.querySelector('.bb__checkbox');
          if (cb2) cb2.textContent = '[X]';
          selectedProducts[slotId] = { id: id, name: name, price: price };
          slot.classList.add('is-selected');
        }

        updateSummary();
      });
    });

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('is-active'); });
        this.classList.add('is-active');
        var target = this.getAttribute('data-target') || 'proto';

        contents.forEach(function(c) {
          var cTarget = c.getAttribute('data-content') || 'proto';
          if (cTarget === target) {
            c.classList.add('is-active');
          } else {
            c.classList.remove('is-active');
          }
        });
      });
    });

    if (addBtn) {
      addBtn.addEventListener('click', function() {
        addBtn.textContent = '[ SYNCHRONIZING HARDWARE ECOSYSTEM... ]';
        setTimeout(function() {
          addBtn.textContent = '[ RIG ADDED TO CART * PROTOCOL VERIFIED ]';
          alert('[ SYSTEM NOTE ] Your custom workstation rig has been added to cart with all unlocked tiered discounts.');
        }, 500);
      });
    }

    updateSummary();
  });
</script>

