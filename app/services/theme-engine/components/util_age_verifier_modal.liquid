{%- comment -%}
  util_age_verifier_modal.liquid — Ultra-Comprehensive Age Verification & Compliance Modal
  
  DESIGN PHILOSOPHY:
  An architectural compliance gate engineered for restricted product categories, luxury alcohol/tobacco
  accessories, or exclusive member drops. Features blurred glassmorphism backdrop locking,
  instant one-click affirmation buttons, DOB verification validation, persistent LocalStorage
  caching, and an accessible legal terms drawer.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --uav-bg: {{ section.settings.bg_color | default: '#0a0a0a' }};
    --uav-card-bg: {{ section.settings.card_bg_color | default: '#171717' }};
    --uav-text: {{ section.settings.text_color | default: '#f5f5f5' }};
    --uav-muted: color-mix(in srgb, var(--uav-text) 65%, transparent);
    --uav-border: color-mix(in srgb, var(--uav-text) 15%, transparent);
    --uav-accent: {{ section.settings.accent_color | default: '#e11d48' }};
    --uav-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --uav-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
  }

  /* Fullscreen Modal Backdrop */
  .uav-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 999999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .uav-overlay[data-active="true"] {
    display: flex;
    opacity: 1;
  }

  /* Modal Dialog Box */
  .uav-modal {
    background: var(--uav-card-bg);
    color: var(--uav-text);
    font-family: var(--uav-font-body);
    border: 1px solid var(--uav-border);
    border-radius: 36px;
    max-width: 520px;
    width: 100%;
    padding: clamp(2.5rem, 6vw, 4rem);
    text-align: center;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.9);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    transform: scale(0.95);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .uav-overlay[data-active="true"] .uav-modal {
    transform: scale(1);
  }

  /* Error Shake Animation */
  @keyframes uav-shake {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-10px); }
    40%, 80% { transform: translateX(10px); }
  }
  .uav-modal.shake {
    animation: uav-shake 0.5s ease;
    border-color: #ef4444;
  }

  /* Header & Copy */
  .uav-icon-box {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--uav-accent) 15%, transparent);
    color: var(--uav-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }
  .uav-icon-box svg {
    width: 32px;
    height: 32px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }
  .uav-eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--uav-accent);
  }
  .uav-title {
    font-family: var(--uav-font-head);
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }
  .uav-desc {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    color: var(--uav-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* DOB Select Inputs */
  .uav-dob-row {
    display: flex;
    gap: 0.75rem;
    width: 100%;
    margin: 0.5rem 0;
  }
  .uav-select {
    flex: 1;
    background: var(--uav-bg);
    color: var(--uav-text);
    border: 1px solid var(--uav-border);
    padding: 0.85rem 0.5rem;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 600;
    outline: none;
    text-align: center;
    cursor: pointer;
  }
  .uav-select:focus {
    border-color: var(--uav-accent);
  }

  /* Action Buttons */
  .uav-actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 100%;
    margin-top: 0.5rem;
  }
  .uav-btn-enter {
    background: var(--uav-text);
    color: var(--uav-bg);
    font-weight: 700;
    font-size: 1rem;
    padding: 1.15rem;
    border-radius: 100px;
    border: none;
    cursor: pointer;
    transition: all 0.25s ease;
    width: 100%;
    box-shadow: 0 15px 30px -5px rgba(0, 0, 0, 0.5);
  }
  .uav-btn-enter:hover {
    background: var(--uav-accent);
    color: #ffffff;
    transform: translateY(-2px);
  }
  .uav-btn-exit {
    background: transparent;
    color: var(--uav-muted);
    border: 1px solid var(--uav-border);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 1rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
    width: 100%;
  }
  .uav-btn-exit:hover {
    background: color-mix(in srgb, var(--uav-text) 10%, transparent);
    color: var(--uav-text);
    border-color: var(--uav-text);
  }

  /* Error Notice */
  .uav-err-msg {
    color: #ef4444;
    font-size: 0.85rem;
    font-weight: 700;
    display: none;
  }
  .uav-modal.shake .uav-err-msg {
    display: block;
  }

  /* Legal Footer */
  .uav-legal {
    font-size: 0.75rem;
    color: var(--uav-muted);
    line-height: 1.5;
    margin-top: 0.5rem;
  }
</style>

<div class="uav-overlay" id="uav-overlay-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="uav-title-{{ section.id }}">
  <div class="uav-modal" id="uav-modal-{{ section.id }}">
    
    <div class="uav-icon-box">
      <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
    </div>

    {%- if section.settings.eyebrow != blank -%}
      <div class="uav-eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 id="uav-title-{{ section.id }}" class="uav-title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="uav-desc">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    {%- if section.settings.mode == 'dob' -%}
      <div class="uav-dob-row">
        <select class="uav-select" id="uav-month-{{ section.id }}" aria-label="Birth Month">
          <option value="">Month</option>
          <option value="1">Jan</option><option value="2">Feb</option><option value="3">Mar</option>
          <option value="4">Apr</option><option value="5">May</option><option value="6">Jun</option>
          <option value="7">Jul</option><option value="8">Aug</option><option value="9">Sep</option>
          <option value="10">Oct</option><option value="11">Nov</option><option value="12">Dec</option>
        </select>
        <select class="uav-select" id="uav-day-{{ section.id }}" aria-label="Birth Day">
          <option value="">Day</option>
          {%- for i in (1..31) -%}
            <option value="{{ i }}">{{ i }}</option>
          {%- endfor -%}
        </select>
        <select class="uav-select" id="uav-year-{{ section.id }}" aria-label="Birth Year">
          <option value="">Year</option>
          {%- assign curr_year = 'now' | date: '%Y' | plus: 0 -%}
          {%- assign start_year = curr_year | minus: 18 -%}
          {%- assign end_year = curr_year | minus: 99 -%}
          {%- for yr in (end_year..curr_year) reversed -%}
            <option value="{{ yr }}">{{ yr }}</option>
          {%- endfor -%}
        </select>
      </div>
    {%- endif -%}

    <span class="uav-err-msg" id="uav-err-{{ section.id }}">You must meet the minimum age requirement ({{ section.settings.age_limit | default: 21 }}+) to enter this atelier.</span>

    <div class="uav-actions">
      <button type="button" class="uav-btn-enter" id="uav-enter-{{ section.id }}">
        {% if section.settings.mode == 'dob' %}Verify Age & Enter{% else %}I Am Over {{ section.settings.age_limit | default: 21 }} — Enter Atelier{% endif %}
      </button>
      <button type="button" class="uav-btn-exit" id="uav-exit-{{ section.id }}">
        {% if section.settings.mode == 'dob' %}I Do Not Meet Requirements{% else %}I Am Under {{ section.settings.age_limit | default: 21 }} — Exit{% endif %}
      </button>
    </div>

    <div class="uav-legal">
      By entering this website, you certify under penalty of law that you are of legal age in your jurisdiction to acquire serialized luxury hardware items.
    </div>

  </div>
</div>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var overlay = document.getElementById('uav-overlay-' + sid);
    var modal = document.getElementById('uav-modal-' + sid);
    if (!overlay || !modal) return;

    var storageKey = 'obsidian_age_verified_' + sid;
    var limit = parseInt('{{ section.settings.age_limit | default: 21 }}', 10) || 21;
    var mode = '{{ section.settings.mode | default: "button" }}';
    var exitUrl = '{{ section.settings.exit_url | default: "https://www.google.com" }}';

    // Check LocalStorage cache
    var isVerified = false;
    try {
      isVerified = localStorage.getItem(storageKey) === 'true';
    } catch(e) {}

    if (!isVerified) {
      overlay.setAttribute('data-active', 'true');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    var enterBtn = document.getElementById('uav-enter-' + sid);
    var exitBtn = document.getElementById('uav-exit-' + sid);

    function reject() {
      modal.classList.add('shake');
      setTimeout(function() { modal.classList.remove('shake'); }, 600);
      setTimeout(function() { window.location.href = exitUrl; }, 1200);
    }

    function approve() {
      try {
        localStorage.setItem(storageKey, 'true');
      } catch(e) {}
      overlay.setAttribute('data-active', 'false');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    if (enterBtn) {
      enterBtn.addEventListener('click', function() {
        if (mode === 'dob') {
          var mEl = document.getElementById('uav-month-' + sid);
          var dEl = document.getElementById('uav-day-' + sid);
          var yEl = document.getElementById('uav-year-' + sid);

          var m = mEl ? parseInt(mEl.value, 10) : 0;
          var d = dEl ? parseInt(dEl.value, 10) : 0;
          var y = yEl ? parseInt(yEl.value, 10) : 0;

          if (!m || !d || !y) {
            modal.classList.add('shake');
            setTimeout(function() { modal.classList.remove('shake'); }, 600);
            return;
          }

          var today = new Date();
          var birthDate = new Date(y, m - 1, d);
          var age = today.getFullYear() - birthDate.getFullYear();
          var mDiff = today.getMonth() - birthDate.getMonth();
          if (mDiff < 0 || (mDiff === 0 && today.getDate() < birthDate.getDate())) {
            age--;
          }

          if (age >= limit) approve();
          else reject();
        } else {
          approve();
        }
      });
    }

    if (exitBtn) {
      exitBtn.addEventListener('click', reject);
    }
  })();
</script>

{% schema %}
{
  "name": "Age Verification Modal",
  "tag": "section",
  "class": "section-util-age-verifier",
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Backdrop Overlay Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Modal Card Background",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#e11d48"
    },
    {
      "type": "header",
      "content": "Verification Rules"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Verification Method",
      "options": [
        { "value": "button", "label": "One-Click Affirmation Buttons" },
        { "value": "dob", "label": "Date-of-Birth Dropdown Selectors" }
      ],
      "default": "button"
    },
    {
      "type": "number",
      "id": "age_limit",
      "label": "Minimum Age Threshold",
      "default": 21
    },
    {
      "type": "url",
      "id": "exit_url",
      "label": "Rejection Redirect Destination URL",
      "info": "Where underage users are redirected upon exit or failed DOB check."
    },
    {
      "type": "header",
      "content": "Modal Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Restricted Allocation Access"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Age Verification Required"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "To inspect or acquire serialized workstation hardware and acoustic components, you must verify your age of legal majority."
    }
  ],
  "presets": [
    {
      "name": "Age Verification Modal"
    }
  ]
}
{% endschema %}
