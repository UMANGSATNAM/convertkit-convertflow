{%- comment -%}
  testimonials_luxury_1.liquid — Luxury Testimonials
  
  DESIGN PHILOSOPHY:
  Large italic serif quote. Cinematic, editorial feel.
  One powerful testimonial takes up the full viewport.
  Inspired by Vogue/Harper's pull-quotes.
  
  CONVERSION PSYCHOLOGY:
  Social proof (Cialdini) — A single high-status quote
  is more credible than 10 generic ones. Authority bias.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --ltst-bg: var(--color-surface, var(--color-background, #faf9f7));
    --ltst-text: var(--color-text, #1a1a1a);
    --ltst-muted: color-mix(in srgb, var(--ltst-text) 45%, transparent);
    --ltst-border: color-mix(in srgb, var(--ltst-text) 8%, transparent);
    --ltst-accent: var(--color-accent, #c9a96e);
    --ltst-font: var(--font-body, 'Inter', sans-serif);
    --ltst-font-quote: var(--font-heading, 'Playfair Display', serif);
  }

  .lx-testimonials {
    background: var(--ltst-bg);
    padding: clamp(4rem, 10vw, 8rem) clamp(1.25rem, 4vw, 4rem);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .lx-testimonials__inner {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
  }

  /* Decorative quotation mark */
  .lx-testimonials__deco {
    font-family: var(--ltst-font-quote);
    font-size: clamp(4rem, 8vw, 6rem);
    color: var(--ltst-accent);
    opacity: 0.25;
    line-height: 1;
    margin-bottom: -1rem;
    user-select: none;
  }

  /* Slide container */
  .lx-testimonials__slides {
    position: relative;
    min-height: 200px;
  }
  .lx-testimonials__slide {
    display: none;
    animation: ltst-fadeIn 0.6s ease;
  }
  .lx-testimonials__slide[data-active="true"] {
    display: block;
  }
  @keyframes ltst-fadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .lx-testimonials__quote {
    font-family: var(--ltst-font-quote);
    font-size: clamp(1.35rem, 3vw, 2.25rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.5;
    color: var(--ltst-text);
    margin: 0 0 2rem 0;
    quotes: none;
  }

  /* Attribution */
  .lx-testimonials__author {
    font-family: var(--ltst-font);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--ltst-muted);
    margin-bottom: 0.25rem;
  }
  .lx-testimonials__role {
    font-family: var(--ltst-font);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--ltst-muted);
    opacity: 0.7;
  }

  /* Star rating */
  .lx-testimonials__stars {
    color: var(--ltst-accent);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }

  /* Navigation dots */
  .lx-testimonials__dots {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 2.5rem;
  }
  .lx-testimonials__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ltst-border);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.25s ease;
  }
  .lx-testimonials__dot[data-active="true"] {
    background: var(--ltst-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .lx-testimonials__slide { animation: none; }
  }
</style>

<section class="lx-testimonials">
  <div class="lx-testimonials__inner">

    <div class="lx-testimonials__deco" aria-hidden="true">"</div>

    <div class="lx-testimonials__slides" id="ltst-slides-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="lx-testimonials__slide" data-active="{{ forloop.first }}" {{ block.shopify_attributes }}>
          {%- if block.settings.show_stars -%}
            <div class="lx-testimonials__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.rating -%}★{%- else -%}☆{%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          <blockquote class="lx-testimonials__quote">
            "{{ block.settings.quote }}"
          </blockquote>
          <div class="lx-testimonials__author">— {{ block.settings.author }}</div>
          {%- if block.settings.role != blank -%}
            <div class="lx-testimonials__role">{{ block.settings.role }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="lx-testimonials__dots" id="ltst-dots-{{ section.id }}">
        {%- for block in section.blocks -%}
          <button
            class="lx-testimonials__dot"
            data-active="{{ forloop.first }}"
            data-index="{{ forloop.index0 }}"
            aria-label="Show testimonial {{ forloop.index }}"
            onclick="(function(idx, sid){
              var slides=document.querySelectorAll('#ltst-slides-'+sid+' .lx-testimonials__slide');
              var dots=document.querySelectorAll('#ltst-dots-'+sid+' .lx-testimonials__dot');
              slides.forEach(function(s,i){s.dataset.active=i===idx?'true':'false'});
              dots.forEach(function(d,i){d.dataset.active=i===idx?'true':'false'});
            })({{ forloop.index0 }}, '{{ section.id }}')"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Luxury Testimonials",
  "tag": "section",
  "class": "section-testimonials-luxury",
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-Rotate Testimonials",
      "default": false,
      "info": "Cycles through testimonials automatically every 6 seconds."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "An exquisite experience. The attention to detail is evident in every aspect. Truly the pinnacle of modern luxury."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Harper's Bazaar"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / Publication",
          "default": "Editorial Review"
        },
        {
          "type": "checkbox",
          "id": "show_stars",
          "label": "Show Star Rating",
          "default": false
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "An exquisite experience. The attention to detail is evident in every aspect. Truly the pinnacle of modern luxury.",
            "author": "Harper's Bazaar",
            "role": "Editorial Review"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "A masterclass in understated elegance. This collection redefines what premium means.",
            "author": "Vogue India",
            "role": "Style Desk"
          }
        }
      ]
    }
  ]
}
{% endschema %}
