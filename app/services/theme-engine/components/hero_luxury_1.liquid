{%- comment -%}
  hero_luxury_1.liquid — Ultra-Comprehensive Cinematic Luxury Atelier Hero
  
  DESIGN PHILOSOPHY:
  An architectural flagship hero presentation engineered for haute workstation collections
  and limited serialized releases. Features cinematic background video/image zoom shading,
  gold/platinum geometric accent lines, audio control toggles, and an accessible VIP
  Allocation Reservation Lightbox Modal Dialog for private acquisition requests.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --hl-bg: {{ section.settings.bg_color | default: '#050505' }};
    --hl-text: {{ section.settings.text_color | default: '#ffffff' }};
    --hl-muted: color-mix(in srgb, var(--hl-text) 65%, transparent);
    --hl-border: color-mix(in srgb, var(--hl-text) 18%, transparent);
    --hl-gold: {{ section.settings.accent_color | default: '#d4af37' }};
    --hl-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --hl-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --hl-min-height: clamp(650px, 85vh, 960px);
  }

  .hl-section {
    background-color: var(--hl-bg);
    color: var(--hl-text);
    font-family: var(--hl-font-body);
    min-height: var(--hl-min-height);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  /* Cinematic Media Background */
  .hl-media-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }
  .hl-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.03);
    transition: transform 10s cubic-bezier(0.1, 1, 0.1, 1);
  }
  .hl-section:hover .hl-media {
    transform: scale(1.08);
  }

  /* Dark Luxury Shading Gradient */
  .hl-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(5, 5, 5, 0.4) 0%,
      rgba(5, 5, 5, 0.75) 50%,
      rgba(5, 5, 5, 0.95) 100%
    );
    pointer-events: none;
  }

  /* Decorative Geometric Lines */
  .hl-line-left, .hl-line-right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg, transparent 0%, var(--hl-gold) 50%, transparent 100%);
    opacity: 0.35;
    z-index: 3;
    pointer-events: none;
  }
  .hl-line-left { left: clamp(1.5rem, 6vw, 6rem); }
  .hl-line-right { right: clamp(1.5rem, 6vw, 6rem); }

  /* Content Box */
  .hl-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(4rem, 10vw, 8rem) clamp(1.5rem, 4vw, 4rem);
    position: relative;
    z-index: 10;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* Serialized Badge */
  .hl-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--hl-gold);
    border: 1px solid color-mix(in srgb, var(--hl-gold) 40%, transparent);
    background: color-mix(in srgb, var(--hl-gold) 10%, transparent);
    padding: 0.5rem 1.35rem;
    border-radius: 100px;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .hl-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hl-gold);
    box-shadow: 0 0 8px var(--hl-gold);
  }

  /* Typography */
  .hl-title {
    font-family: var(--hl-font-head);
    font-size: clamp(2.5rem, 6.5vw, 5.25rem);
    font-weight: 700;
    line-height: 1.08;
    margin: 0;
    letter-spacing: -0.02em;
    background: linear-gradient(180deg, #ffffff 0%, rgba(255, 255, 255, 0.75) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hl-desc {
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    color: var(--hl-muted);
    line-height: 1.65;
    max-width: 720px;
    margin: 0;
  }

  /* CTA Button Group */
  .hl-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }
  .hl-btn-primary {
    background: var(--hl-gold);
    color: #000000;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    padding: 1.15rem 2.5rem;
    border-radius: 100px;
    transition: all 0.3s ease;
    box-shadow: 0 20px 40px -10px color-mix(in srgb, var(--hl-gold) 40%, transparent);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .hl-btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 25px 50px -5px color-mix(in srgb, var(--hl-gold) 60%, transparent);
    background: #e5c158;
  }
  .hl-btn-secondary {
    background: transparent;
    color: var(--hl-text);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    padding: 1.15rem 2.25rem;
    border-radius: 100px;
    border: 1px solid var(--hl-border);
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
  }
  .hl-btn-secondary:hover {
    background: color-mix(in srgb, var(--hl-text) 10%, transparent);
    border-color: var(--hl-text);
  }

  /* Sound Toggle Button */
  .hl-sound-btn {
    position: absolute;
    bottom: clamp(1.5rem, 4vw, 3rem);
    right: clamp(1.5rem, 4vw, 3rem);
    z-index: 20;
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid var(--hl-border);
    color: var(--hl-text);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .hl-sound-btn:hover {
    background: var(--hl-gold);
    color: #000;
    border-color: var(--hl-gold);
  }
  .hl-sound-btn svg { width: 18px; height: 18px; stroke: currentColor; stroke-width: 2; fill: none; }

  /* VIP Allocation Lightbox Modal */
  .hl-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .hl-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .hl-modal {
    background: #0d0d0d;
    color: #ffffff;
    border: 1px solid color-mix(in srgb, var(--hl-gold) 35%, transparent);
    border-radius: 36px;
    max-width: 560px;
    width: 100%;
    padding: clamp(2.5rem, 6vw, 4rem);
    text-align: center;
    position: relative;
    box-shadow: 0 40px 80px -15px rgba(0, 0, 0, 0.9);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    transform: scale(0.95);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hl-modal-overlay[data-open="true"] .hl-modal {
    transform: scale(1);
  }
  .hl-modal-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
  }
  .hl-input {
    width: 100%;
    background: #171717;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 1rem 1.25rem;
    border-radius: 14px;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .hl-input:focus { border-color: var(--hl-gold); }
</style>

<section class="hl-section" id="hl-section-{{ section.id }}" aria-labelledby="hl-title-{{ section.id }}">
  <div class="hl-line-left"></div>
  <div class="hl-line-right"></div>

  <!-- Cinematic Background -->
  <div class="hl-media-wrap">
    {%- if section.settings.video_url != blank -%}
      <video class="hl-media" id="hl-video-{{ section.id }}" autoplay loop muted playsinline>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', class: 'hl-media', alt: section.settings.title }}
    {%- else -%}
      <div style="width:100%;height:100%;background:#111;display:flex;align-items:center;justify-content:center;color:#444;font-size:2rem;font-weight:700;">Cinematic Atelier Hero</div>
    {%- endif -%}
  </div>

  <div class="hl-overlay"></div>

  <!-- Hero Content -->
  <div class="hl-container">
    
    {%- if section.settings.eyebrow != blank -%}
      <div class="hl-badge">
        <span class="hl-dot"></span>
        <span>{{ section.settings.eyebrow }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 id="hl-title-{{ section.id }}" class="hl-title">{{ section.settings.title }}</h1>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="hl-desc">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <div class="hl-actions">
      {%- if section.settings.btn_1_label != blank -%}
        <a href="{{ section.settings.btn_1_link | default: '#reserve' }}" class="hl-btn-primary" id="hl-reserve-btn-{{ section.id }}">
          <span>{{ section.settings.btn_1_label }}</span>
          <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.5;"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      {%- endif -%}

      {%- if section.settings.btn_2_label != blank -%}
        <a href="{{ section.settings.btn_2_link | default: '/pages/specifications' }}" class="hl-btn-secondary">
          <span>{{ section.settings.btn_2_label }}</span>
        </a>
      {%- endif -%}
    </div>

  </div>

  {%- if section.settings.video_url != blank -%}
    <button type="button" class="hl-sound-btn" id="hl-sound-toggle-{{ section.id }}" aria-label="Toggle video sound">
      <svg viewBox="0 0 24 24" id="hl-icon-muted-{{ section.id }}"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
      <svg viewBox="0 0 24 24" id="hl-icon-sound-{{ section.id }}" style="display:none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
    </button>
  {%- endif -%}

  <!-- VIP Allocation Reservation Lightbox Modal -->
  <div class="hl-modal-overlay" id="hl-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="hl-modal">
      <button type="button" class="hl-modal-close" id="hl-modal-close-{{ section.id }}" aria-label="Close allocation reservation modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div style="width:56px;height:56px;border-radius:50%;background:color-mix(in srgb,var(--hl-gold) 15%,transparent);color:var(--hl-gold);display:flex;align-items:center;justify-content:center;">
        <svg viewBox="0 0 24 24" style="width:28px;height:28px;stroke:currentColor;fill:none;stroke-width:1.8;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
      </div>

      <h3 style="font-family:var(--hl-font-head);font-size:1.85rem;margin:0;color:#ffffff;">Request VIP Allocation</h3>
      <p style="font-size:0.95rem;line-height:1.6;color:rgba(255,255,255,0.7);margin:0;">Submit your details to secure priority access to the Series 04 manufacturing queue. Only 150 units are allocated globally.</p>

      <form action="/contact#contact_form" method="post" style="width:100%;display:flex;flex-direction:column;gap:1rem;">
        <input type="text" name="contact[name]" placeholder="Full Name or Studio Title" class="hl-input" required>
        <input type="email" name="contact[email]" placeholder="Corporate / Private Email" class="hl-input" required>
        <button type="button" class="hl-btn-primary" style="width:100%;justify-content:center;cursor:pointer;border:none;" onclick="alert('Allocation request logged in Swiss Registry.');">Submit Allocation Request →</button>
      </form>

      <span style="font-size:0.75rem;color:rgba(255,255,255,0.5);">We respect client privacy; no marketing spam will ever be sent.</span>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('hl-section-' + sid);
    if (!sectionEl) return;

    // Sound Toggle Controller
    var soundBtn = document.getElementById('hl-sound-toggle-' + sid);
    var videoEl = document.getElementById('hl-video-' + sid);
    var iconMuted = document.getElementById('hl-icon-muted-' + sid);
    var iconSound = document.getElementById('hl-icon-sound-' + sid);

    if (soundBtn && videoEl && iconMuted && iconSound) {
      soundBtn.addEventListener('click', function() {
        if (videoEl.muted) {
          videoEl.muted = false;
          iconMuted.style.display = 'none';
          iconSound.style.display = 'block';
        } else {
          videoEl.muted = true;
          iconMuted.style.display = 'block';
          iconSound.style.display = 'none';
        }
      });
    }

    // VIP Modal Controller
    var modalOverlay = document.getElementById('hl-modal-' + sid);
    var modalClose = document.getElementById('hl-modal-close-' + sid);
    var reserveBtn = document.getElementById('hl-reserve-btn-' + sid);

    if (modalOverlay && modalClose && reserveBtn) {
      reserveBtn.addEventListener('click', function(e) {
        if (reserveBtn.getAttribute('href') === '#reserve') {
          e.preventDefault();
          modalOverlay.setAttribute('data-open', 'true');
          modalOverlay.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Luxury Cinematic Hero",
  "tag": "section",
  "class": "section-hero-luxury-1",
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Luxury Accent (Gold/Platinum)",
      "default": "#d4af37"
    },
    {
      "type": "header",
      "content": "Media Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Photo"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Direct MP4 Video Background URL",
      "info": "Overrides background photo if provided."
    },
    {
      "type": "header",
      "content": "Hero Copy & Actions"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Serialized Edition Badge",
      "default": "SERIES 04 • ALLOCATION 150 UNITS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Heading",
      "default": "Architectural Workstation Mastery"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "CNC milled from a single block of aerospace aluminum in Zürich. Engineered for those who demand absolute acoustic and tactile perfection."
    },
    {
      "type": "text",
      "id": "btn_1_label",
      "label": "Primary CTA Label",
      "default": "Request VIP Allocation"
    },
    {
      "type": "text",
      "id": "btn_1_link",
      "label": "Primary CTA Link (use #reserve for popup)",
      "default": "#reserve"
    },
    {
      "type": "text",
      "id": "btn_2_label",
      "label": "Secondary CTA Label",
      "default": "Explore Specifications"
    },
    {
      "type": "url",
      "id": "btn_2_link",
      "label": "Secondary CTA Link"
    }
  ],
  "presets": [
    {
      "name": "Luxury Cinematic Hero"
    }
  ]
}
{% endschema %}
