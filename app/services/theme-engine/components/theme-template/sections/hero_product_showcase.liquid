<div class="sf-showcase sf-showcase-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-showcase-text">
    <h1 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h1>
    <p style="color: {{ section.settings.text_color }};">{{ section.settings.subtitle }}</p>
    <div class="sf-showcase-price" style="color: {{ section.settings.text_color }};">{{ section.settings.price }}</div>
    <a href="{{ section.settings.btn_link }}" class="sf-btn-showcase" style="background: {{ section.settings.btn_bg }}; color: {{ section.settings.btn_text }};">
      {{ section.settings.btn_label }}
    </a>
  </div>
  <div class="sf-showcase-image">
    {% if section.settings.product_image != blank %}
      <img src="{{ section.settings.product_image | img_url: 'master' }}" alt="{{ section.settings.title }}" fetchpriority="high">
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'sf-placeholder' }}
    {% endif %}
  </div>
</div>

<style>
  .sf-showcase-{{ section.id }} {
    display: flex; flex-direction: column-reverse; align-items: center; padding: 4rem 1rem;
    max-width: 1200px; margin: 0 auto; min-height: 70vh;
  }
  @media (min-width: 768px) {
    .sf-showcase-{{ section.id }} { flex-direction: row; justify-content: space-between; }
  }
  .sf-showcase-text { flex: 1; padding: 2rem; }
  .sf-showcase-text h1 { font-size: 4rem; line-height: 1.1; margin-bottom: 1rem; font-weight: 900; }
  .sf-showcase-text p { font-size: 1.2rem; margin-bottom: 2rem; opacity: 0.8; max-width: 400px; }
  .sf-showcase-price { font-size: 2rem; font-weight: bold; margin-bottom: 2rem; }
  .sf-showcase-image { flex: 1; display: flex; justify-content: center; align-items: center; padding: 2rem; }
  .sf-showcase-image img { max-width: 100%; max-height: 600px; object-fit: contain; filter: drop-shadow(0 20px 30px color-mix(in srgb, var(--color-text) 10%, transparent)); }
  .sf-btn-showcase { display: inline-block; padding: 16px 36px; text-decoration: none; font-weight: bold; text-transform: uppercase; border-radius: 50px; transition: transform 0.2s; }
  .sf-btn-showcase:hover { transform: scale(1.05); }
</style>

{% schema %}
{
  "name": "Product Showcase Hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "BG", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "text", "id": "title", "label": "Title", "default": "The Ultimate Device" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Designed to perfection. Built to last." },
    { "type": "text", "id": "price", "label": "Price Text", "default": "₹4,999" },
    { "type": "image_picker", "id": "product_image", "label": "Product Image (Transparent PNG ideal)" },
    { "type": "text", "id": "btn_label", "label": "Button", "default": "Buy Now" },
    { "type": "url", "id": "btn_link", "label": "Link" },
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#111111" },
    { "type": "color", "id": "btn_text", "label": "Button Text", "default": "#ffffff" }
  ],
  "presets": [ { "name": "Product Showcase Hero", "category": "Hero" } ]
}
{% endschema %}
