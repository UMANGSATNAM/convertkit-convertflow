<div class="content-faq py-20 px-6 bg-[var(--color-surface)]">
  <div class="max-w-4xl mx-auto">
    {%- if section.settings.title != blank -%}
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-[var(--color-text)]">{{ section.settings.title }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="text-lg text-[var(--color-text-muted, #555)] mt-4">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="faq-accordion space-y-4">
      {%- for block in section.blocks -%}
        <div class="faq-item border border-[var(--color-border)] rounded-lg overflow-hidden transition-all duration-300" {{ block.shopify_attributes }}>
          <button class="faq-btn w-full px-6 py-5 flex justify-between items-center text-left bg-[var(--color-background)] hover:bg-neutral-50 transition-colors focus:outline-none">
            <span class="text-lg font-bold text-[var(--color-text)] pr-4">{{ block.settings.question | default: "Frequently Asked Question?" }}</span>
            <span class="icon-plus-minus relative w-5 h-5 flex-shrink-0">
              <span class="absolute top-1/2 left-0 w-full h-[2px] bg-[var(--color-text)] -translate-y-1/2 transition-transform duration-300"></span>
              <span class="absolute top-0 left-1/2 w-[2px] h-full bg-[var(--color-text)] -translate-x-1/2 transition-transform duration-300 vertical-line"></span>
            </span>
          </button>
          <div class="faq-content overflow-hidden max-h-0 transition-all duration-300 ease-in-out bg-neutral-50/50">
            <div class="p-6 pt-0 text-[var(--color-text-muted, #555)] prose prose-sm max-w-none">
              {{ block.settings.answer | default: "<p>Detailed answer goes here. Provide helpful information to resolve customer doubts immediately.</p>" }}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
    
    {%- if section.settings.contact_text != blank -%}
      <div class="mt-12 text-center text-[var(--color-text-muted, #555)]">
        {{ section.settings.contact_text }} 
        <a href="{{ section.settings.contact_link }}" class="text-[var(--color-text)] font-bold underline">{{ section.settings.contact_link_text }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const container = document.querySelector('#shopify-section-{{ section.id }}');
  if (!container) return;

  const faqs = container.querySelectorAll('.faq-item');

  faqs.forEach(faq => {
    const btn = faq.querySelector('.faq-btn');
    const content = faq.querySelector('.faq-content');
    const verticalLine = faq.querySelector('.vertical-line');

    btn.addEventListener('click', () => {
      const isOpen = content.style.maxHeight;

      // Close all others (Accordion behavior)
      faqs.forEach(otherFaq => {
        otherFaq.querySelector('.faq-content').style.maxHeight = null;
        otherFaq.querySelector('.vertical-line').style.transform = 'translateX(-50%) rotate(0deg)';
        otherFaq.classList.remove('border-[var(--color-primary, #000)]');
      });

      if (!isOpen) {
        content.style.maxHeight = content.scrollHeight + "px";
        verticalLine.style.transform = 'translateX(-50%) rotate(90deg)';
        faq.classList.add('border-[var(--color-primary, #000)]');
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Everything you need to know about the product and billing."
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Contact Prompt Text",
      "default": "Still have questions?"
    },
    {
      "type": "text",
      "id": "contact_link_text",
      "label": "Contact Link Text",
      "default": "Contact Support"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact Link"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We offer a 30-day money-back guarantee. If you are not 100% satisfied, you can return it for a full refund.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
