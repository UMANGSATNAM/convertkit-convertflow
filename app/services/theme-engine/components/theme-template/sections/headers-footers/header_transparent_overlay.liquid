<header class="header-transparent absolute top-0 left-0 w-full z-50 transition-all duration-300 {% if section.settings.enable_sticky %}fixed-header-logic{% endif %}" id="header-{{ section.id }}" data-bg-color="{{ section.settings.scroll_bg_color | default: '#ffffff' }}">
  <div class="max-w-7xl mx-auto px-6 h-24 flex items-center justify-between">
    
    <!-- Logo -->
    <div class="flex-shrink-0 z-20">
      <a href="/" class="block">
        {%- if section.settings.logo_light != blank and section.settings.logo_dark != blank -%}
          <!-- Light Logo (Default for transparent) -->
          <img src="{{ section.settings.logo_light | img_url: '400x' }}" alt="{{ shop.name }}" class="h-10 w-auto object-contain logo-light transition-opacity duration-300" loading="lazy">
          <!-- Dark Logo (For scrolled state) -->
          <img src="{{ section.settings.logo_dark | img_url: '400x' }}" alt="{{ shop.name }}" class="h-10 w-auto object-contain logo-dark absolute top-1/2 left-0 -translate-y-1/2 opacity-0 transition-opacity duration-300" loading="lazy">
        {%- else -%}
          <span class="text-3xl font-black uppercase tracking-widest text-[var(--color-background)] transition-colors duration-300 logo-text">{{ shop.name | default: 'YOUR BRAND' }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center gap-8 z-20">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}" class="nav-link text-sm font-bold uppercase tracking-widest text-[var(--color-background)] hover:text-[var(--color-background)]/70 transition-colors">
          {{ link.title }}
        </a>
      {%- endfor -%}
      {%- if linklists[section.settings.menu].links.size == 0 -%}
         <a href="#" class="nav-link text-sm font-bold uppercase tracking-widest text-[var(--color-background)] hover:text-[var(--color-background)]/70 transition-colors">Shop</a>
         <a href="#" class="nav-link text-sm font-bold uppercase tracking-widest text-[var(--color-background)] hover:text-[var(--color-background)]/70 transition-colors">Collections</a>
      {%- endif -%}
    </nav>

    <!-- Icons -->
    <div class="flex items-center justify-end gap-6 z-20">
      <a href="/cart" class="nav-link relative text-[var(--color-background)] hover:text-[var(--color-background)]/70 transition-colors flex items-center gap-2">
        <span class="text-sm font-bold uppercase tracking-widest">Cart</span>
        <span class="w-6 h-6 rounded-full bg-[var(--color-background)] text-[var(--color-text)] flex items-center justify-center text-xs font-bold cart-badge transition-colors duration-300">
          {{ cart.item_count | default: 0 }}
        </span>
      </a>
      <button class="md:hidden nav-link text-[var(--color-background)]">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>

    <!-- Background Layer for Scroll -->
    <div class="header-bg absolute inset-0 w-full h-full opacity-0 transition-opacity duration-300 shadow-sm z-10" style="background-color: {{ section.settings.scroll_bg_color | default: 'var(--color-background)' }}"></div>
  </div>
</header>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const header = document.getElementById('header-{{ section.id }}');
  if(!header) return;

  const bg = header.querySelector('.header-bg');
  const links = header.querySelectorAll('.nav-link');
  const logoLight = header.querySelector('.logo-light');
  const logoDark = header.querySelector('.logo-dark');
  const logoText = header.querySelector('.logo-text');
  const cartBadge = header.querySelector('.cart-badge');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header.classList.add('fixed');
      header.classList.remove('absolute');
      bg.style.opacity = '1';
      
      links.forEach(l => {
        l.classList.remove('text-white', 'hover:text-white/70');
        l.classList.add('text-black', 'hover:text-gray-500');
      });

      if(logoLight && logoDark) {
        logoLight.style.opacity = '0';
        logoDark.style.opacity = '1';
      }
      if(logoText) {
        logoText.classList.remove('text-white');
        logoText.classList.add('text-black');
      }
      if(cartBadge) {
        cartBadge.classList.remove('bg-white', 'text-black');
        cartBadge.classList.add('bg-black', 'text-white');
      }

    } else {
      header.classList.remove('fixed');
      header.classList.add('absolute');
      bg.style.opacity = '0';
      
      links.forEach(l => {
        l.classList.add('text-white', 'hover:text-white/70');
        l.classList.remove('text-black', 'hover:text-gray-500');
      });

      if(logoLight && logoDark) {
        logoLight.style.opacity = '1';
        logoDark.style.opacity = '0';
      }
      if(logoText) {
        logoText.classList.add('text-white');
        logoText.classList.remove('text-black');
      }
      if(cartBadge) {
        cartBadge.classList.add('bg-white', 'text-black');
        cartBadge.classList.remove('bg-black', 'text-white');
      }
    }
  });
});
</script>

{% schema %}
{
  "name": "Header - Transparent",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_light",
      "label": "Light Logo (For transparent state)"
    },
    {
      "type": "image_picker",
      "id": "logo_dark",
      "label": "Dark Logo (For scrolled state)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "color",
      "id": "scroll_bg_color",
      "label": "Background Color on Scroll",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable Sticky on Scroll",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Header - Transparent"
    }
  ]
}
{% endschema %}
