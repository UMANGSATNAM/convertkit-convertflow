<header class="header-classic border-b border-[var(--color-border)] bg-[var(--color-background)] sticky top-0 z-50 transition-all duration-300" id="header-{{ section.id }}">
  <div class="max-w-7xl mx-auto px-4 md:px-8 h-20 md:h-24 flex items-center justify-between">
    
    <!-- Left: Navigation (Desktop) / Hamburger (Mobile) -->
    <div class="w-1/3 flex items-center">
      <!-- Mobile Hamburger -->
      <button class="md:hidden p-2 -ml-2 text-[var(--color-text)] focus:outline-none" aria-label="Menu" id="mobile-menu-btn-{{ section.id }}">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-6 lg:gap-8">
        {%- for link in linklists[section.settings.menu].links -%}
          <a href="{{ link.url }}" class="text-sm font-bold uppercase tracking-widest text-[var(--color-text)] hover:text-[var(--color-accent, #ff0000)] transition-colors relative group">
            {{ link.title }}
            <span class="absolute -bottom-2 left-0 w-full h-0.5 bg-[var(--color-text)] scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></span>
          </a>
        {%- endfor -%}
        {%- if linklists[section.settings.menu].links.size == 0 -%}
           <a href="#" class="text-sm font-bold uppercase tracking-widest text-[var(--color-text)] hover:text-[var(--color-accent, #ff0000)] transition-colors">Shop</a>
           <a href="#" class="text-sm font-bold uppercase tracking-widest text-[var(--color-text)] hover:text-[var(--color-accent, #ff0000)] transition-colors">About</a>
        {%- endif -%}
      </nav>
    </div>

    <!-- Center: Logo -->
    <div class="w-1/3 flex justify-center">
      <a href="/" class="block">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | img_url: '400x' }}" alt="{{ shop.name }}" class="h-10 md:h-12 w-auto object-contain" loading="lazy">
        {%- else -%}
          <span class="text-2xl md:text-3xl font-black uppercase tracking-widest text-[var(--color-text)]">{{ shop.name | default: 'YOUR BRAND' }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Right: Icons (Search, Account, Cart) -->
    <div class="w-1/3 flex items-center justify-end gap-4 md:gap-6">
      {%- if section.settings.show_search -%}
        <a href="/search" class="p-2 text-[var(--color-text)] hover:text-[var(--color-text)] transition-colors">
          <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </a>
      {%- endif -%}
      
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}/account{% else %}/account/login{% endif %}" class="hidden md:block p-2 text-[var(--color-text)] hover:text-[var(--color-text)] transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
        </a>
      {%- endif -%}

      <a href="/cart" class="relative p-2 text-[var(--color-text)] hover:text-[var(--color-text)] transition-colors">
        <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
        <span class="absolute top-0 right-0 w-4 h-4 md:w-5 md:h-5 bg-[var(--color-text)] text-[var(--color-background)] text-[10px] md:text-xs font-bold rounded-full flex items-center justify-center translate-x-1 -translate-y-1">
          {{ cart.item_count | default: 0 }}
        </span>
      </a>
    </div>

  </div>
</header>

<script>
// Hide header on scroll down, show on scroll up
document.addEventListener('DOMContentLoaded', () => {
  const header = document.getElementById('header-{{ section.id }}');
  if(!header) return;

  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;
    if (currentScroll <= 0) {
      header.classList.remove('-translate-y-full', 'shadow-md');
    } else if (currentScroll > lastScroll && currentScroll > 100) {
      // scroll down
      header.classList.add('-translate-y-full');
      header.classList.remove('shadow-md');
    } else {
      // scroll up
      header.classList.remove('-translate-y-full');
      header.classList.add('shadow-md');
    }
    lastScroll = currentScroll;
  });
});
</script>

{% schema %}
{
  "name": "Header - Classic Center",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Header - Classic Center"
    }
  ]
}
{% endschema %}
