<div class="hero-minimal flex flex-col items-center justify-center text-center py-24 md:py-32 px-6 bg-[var(--color-background)]">
  <div class="max-w-3xl mx-auto">
    {%- if section.settings.subheading != blank -%}
      <p class="text-sm font-medium uppercase tracking-[0.25em] text-[var(--color-accent, #666)] mb-6">
        {{ section.settings.subheading }}
      </p>
    {%- endif -%}

    <h1 class="text-5xl md:text-7xl font-light text-[var(--color-text)] leading-tight mb-8" style="letter-spacing: -0.02em;">
      {{ section.settings.title }}
    </h1>

    {%- if section.settings.text != blank -%}
      <div class="text-lg md:text-xl text-[var(--color-text-muted, #555)] mb-10 max-w-2xl mx-auto font-light leading-relaxed">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    <div class="flex flex-wrap items-center justify-center gap-4">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="px-8 py-4 bg-[var(--color-text)] text-[var(--color-background)] font-medium rounded-full hover:scale-105 transition-transform duration-300 shadow-lg shadow-black/10">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
      
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 }}" class="px-8 py-4 bg-transparent text-[var(--color-text)] font-medium rounded-full hover:bg-neutral-100 transition-colors duration-300">
          {{ section.settings.button_label_2 }} &rarr;
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Minimal Center Hero",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Elevate Your Everyday."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "ESSENTIALS REIMAGINED"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A curated collection of timeless pieces designed for the modern lifestyle. Quality without compromise."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary Button",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Link"
    }
  ],
  "presets": [
    {
      "name": "Minimal Center Hero"
    }
  ]
}
{% endschema %}
