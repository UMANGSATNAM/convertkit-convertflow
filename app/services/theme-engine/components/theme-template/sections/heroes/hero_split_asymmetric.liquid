<div class="hero-split flex flex-col lg:flex-row min-h-[80vh] bg-[var(--color-background)]">
  
  <!-- Content Side (60%) -->
  <div class="w-full lg:w-[60%] flex items-center justify-center p-10 md:p-20 lg:p-32 order-2 lg:order-1 relative z-10">
    <div class="max-w-2xl w-full">
      {%- if section.settings.badge != blank -%}
        <span class="inline-block py-1 px-3 bg-[var(--color-text)] text-[var(--color-background)] text-xs font-bold uppercase tracking-wider mb-6 rounded-sm">
          {{ section.settings.badge }}
        </span>
      {%- endif -%}

      <h1 class="text-5xl md:text-7xl font-black text-[var(--color-text)] mb-6 uppercase leading-[0.95]" style="letter-spacing: -0.03em;">
        {{ section.settings.title }}
      </h1>
      
      <p class="text-xl md:text-2xl text-[var(--color-text-muted, #444)] mb-10 leading-relaxed font-medium">
        {{ section.settings.text }}
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="group relative inline-flex items-center justify-center px-8 py-4 font-bold text-[var(--color-background)] bg-[var(--color-text)] overflow-hidden rounded-md">
            <span class="absolute inset-0 w-full h-full -mt-1 rounded-lg opacity-30 bg-gradient-to-b from-transparent via-transparent to-black"></span>
            <span class="relative">{{ section.settings.button_label }}</span>
            <svg class="w-5 h-5 ml-2 relative group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <!-- Image Side (40%) -->
  <div class="w-full lg:w-[40%] relative min-h-[50vh] lg:min-h-full order-1 lg:order-2 overflow-hidden">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | img_url: 'master' }}" alt="{{ section.settings.title }}" class="absolute inset-0 w-full h-full object-cover object-center transform hover:scale-105 transition-transform duration-[2s]" fetchpriority="high">
    {%- else -%}
      <div class="absolute inset-0 bg-neutral-200">
        {{ 'collection-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
      </div>
    {%- endif -%}
    
    <!-- Abstract Shape Overlay for asymmetry -->
    <svg class="absolute top-0 left-0 h-full w-24 -ml-1 text-[var(--color-background)] hidden lg:block" preserveAspectRatio="none" viewBox="0 0 100 100" fill="currentColor">
      <polygon points="0,0 100,0 0,100" />
    </svg>
  </div>
</div>

{% schema %}
{
  "name": "Asymmetric Split Hero",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "New Drop"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Defy The Ordinary"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Bold designs for those who dare to stand out. Shop the latest collection now."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Asymmetric Split Hero"
    }
  ]
}
{% endschema %}
