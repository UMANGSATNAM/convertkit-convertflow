<div class="sf-urgency-stock py-3 px-4 bg-[var(--color-surface)] text-center border-b border-[var(--color-border)]" style="content-visibility: auto;">
  <div class="max-w-xl mx-auto flex items-center justify-center gap-2">
    <svg class="w-5 h-5 text-[var(--color-accent)] animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    <p class="text-sm md:text-base font-medium text-[var(--color-text)]">
      Hurry! Only <span class="font-bold text-[var(--color-accent)]">{{ section.settings.stock_left }} left</span> in stock.
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Stock Urgency Bar",
  "settings": [
    {
      "type": "number",
      "id": "stock_left",
      "label": "Stock Left Number",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Stock Urgency Bar"
    }
  ]
}
{% endschema %}
