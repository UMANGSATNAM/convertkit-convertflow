<div id="cookie-consent" class="fixed bottom-0 left-0 w-full z-[90] transform translate-y-full transition-transform duration-500 ease-in-out p-4 md:p-6 pointer-events-none">
  
  <div class="max-w-7xl mx-auto pointer-events-auto bg-[var(--color-background)] shadow-[0_-10px_40px_rgba(0,0,0,0.1)] md:shadow-2xl md:rounded-xl border border-[var(--color-border)] p-6 flex flex-col md:flex-row items-center justify-between gap-6 relative">
    
    <div class="flex-grow pr-8">
      <h3 class="font-bold text-lg mb-2 text-[var(--color-text)]">{{ section.settings.title }}</h3>
      <p class="text-sm text-[var(--color-text-muted, #555)]">
        {{ section.settings.text }}
        {%- if section.settings.privacy_link != blank -%}
          <a href="{{ section.settings.privacy_link }}" class="underline font-bold hover:text-[var(--color-accent, #ff0000)]">Privacy Policy</a>
        {%- endif -%}
      </p>
    </div>

    <div class="flex flex-shrink-0 gap-3 w-full md:w-auto">
      <button id="cookie-reject" class="flex-1 md:flex-none px-6 py-3 border border-[var(--color-border)] rounded font-bold text-sm hover:bg-[var(--color-surface)] transition-colors">
        Decline
      </button>
      <button id="cookie-accept" class="flex-1 md:flex-none px-6 py-3 bg-[var(--color-text)] text-[var(--color-background)] rounded font-bold text-sm hover:bg-neutral-800 transition-colors shadow-md hover:shadow-lg">
        Accept All
      </button>
    </div>

    <button id="cookie-close" class="absolute top-4 right-4 text-[var(--color-text-secondary)] hover:text-[var(--color-text)]">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  {% if section.settings.enable_cookie_consent %}
    const consentBox = document.getElementById('cookie-consent');
    const acceptBtn = document.getElementById('cookie-accept');
    const rejectBtn = document.getElementById('cookie-reject');
    const closeBtn = document.getElementById('cookie-close');

    if (!localStorage.getItem('cookie_consent_choice')) {
      // Small delay before showing
      setTimeout(() => {
        consentBox.classList.remove('translate-y-full');
      }, 2000);
    }

    const hideBox = (choice) => {
      localStorage.setItem('cookie_consent_choice', choice);
      consentBox.classList.add('translate-y-full');
    };

    acceptBtn.addEventListener('click', () => hideBox('accepted'));
    rejectBtn.addEventListener('click', () => hideBox('rejected'));
    closeBtn.addEventListener('click', () => hideBox('dismissed'));
  {% endif %}
});
</script>

{% schema %}
{
  "name": "Cookie Consent",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_cookie_consent",
      "label": "Enable Cookie Consent Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "We value your privacy"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We use cookies to enhance your browsing experience, serve personalized ads or content, and analyze our traffic. By clicking \"Accept All\", you consent to our use of cookies."
    },
    {
      "type": "url",
      "id": "privacy_link",
      "label": "Privacy Policy Link"
    }
  ],
  "presets": [
    {
      "name": "Cookie Consent"
    }
  ]
}
{% endschema %}
