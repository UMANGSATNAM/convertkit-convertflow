<div id="size-guide-modal" class="fixed inset-0 z-[110] invisible flex items-center justify-center p-4">
  <!-- Overlay -->
  <div class="size-guide-overlay absolute inset-0 bg-[var(--color-text)]/50 opacity-0 transition-opacity duration-300"></div>

  <!-- Content -->
  <div class="size-guide-content relative w-full max-w-2xl bg-[var(--color-background)] rounded-xl shadow-2xl transform scale-95 opacity-0 transition-all duration-300 overflow-hidden flex flex-col max-h-[90vh]">
    
    <!-- Header -->
    <div class="p-6 border-b border-[var(--color-border)] flex justify-between items-center bg-[var(--color-surface)]">
      <h3 class="text-xl font-bold uppercase tracking-widest text-[var(--color-text)]">{{ section.settings.title }}</h3>
      <button class="size-guide-close p-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors rounded-full hover:bg-[var(--color-border)]">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Body -->
    <div class="p-6 overflow-y-auto">
      
      <!-- Image/Diagram -->
      {%- if section.settings.guide_image != blank -%}
        <div class="mb-8 flex justify-center">
          <img src="{{ section.settings.guide_image | img_url: 'master' }}" alt="Size Guide Diagram" class="max-h-64 object-contain" loading="lazy">
        </div>
      {%- endif -%}

      <!-- Instructions -->
      {%- if section.settings.instructions != blank -%}
        <div class="prose prose-sm text-[var(--color-text-secondary)] mb-8 max-w-none">
          {{ section.settings.instructions }}
        </div>
      {%- endif -%}

      <!-- Responsive Table -->
      <div class="overflow-x-auto border border-[var(--color-border)] rounded-lg">
        <table class="w-full text-left text-sm whitespace-nowrap">
          <thead class="bg-[var(--color-surface)] text-[var(--color-text-secondary)] font-bold uppercase text-xs">
            <tr>
              <th class="px-6 py-4">Size</th>
              <th class="px-6 py-4">US</th>
              <th class="px-6 py-4">UK</th>
              <th class="px-6 py-4">EU</th>
              <th class="px-6 py-4">Chest (in)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <!-- Mock rows, can be driven by metafields or blocks in real usage -->
            <tr class="hover:bg-[var(--color-surface)]">
              <td class="px-6 py-4 font-bold">Small</td>
              <td class="px-6 py-4">4 - 6</td>
              <td class="px-6 py-4">8 - 10</td>
              <td class="px-6 py-4">36</td>
              <td class="px-6 py-4">34 - 36</td>
            </tr>
            <tr class="hover:bg-[var(--color-surface)]">
              <td class="px-6 py-4 font-bold">Medium</td>
              <td class="px-6 py-4">8 - 10</td>
              <td class="px-6 py-4">12 - 14</td>
              <td class="px-6 py-4">38</td>
              <td class="px-6 py-4">38 - 40</td>
            </tr>
            <tr class="hover:bg-[var(--color-surface)]">
              <td class="px-6 py-4 font-bold">Large</td>
              <td class="px-6 py-4">12 - 14</td>
              <td class="px-6 py-4">16 - 18</td>
              <td class="px-6 py-4">40</td>
              <td class="px-6 py-4">42 - 44</td>
            </tr>
             <tr class="hover:bg-[var(--color-surface)]">
              <td class="px-6 py-4 font-bold">X-Large</td>
              <td class="px-6 py-4">16 - 18</td>
              <td class="px-6 py-4">20 - 22</td>
              <td class="px-6 py-4">42</td>
              <td class="px-6 py-4">46 - 48</td>
            </tr>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('size-guide-modal');
  if(!modal) return;
  
  const overlay = modal.querySelector('.size-guide-overlay');
  const content = modal.querySelector('.size-guide-content');
  const closeBtns = modal.querySelectorAll('.size-guide-close');

  window.openSizeGuide = () => {
    modal.classList.remove('invisible');
    setTimeout(() => {
      overlay.classList.add('opacity-100');
      content.classList.remove('scale-95', 'opacity-0');
      content.classList.add('scale-100', 'opacity-100');
    }, 10);
  };

  const closeModal = () => {
    overlay.classList.remove('opacity-100');
    content.classList.remove('scale-100', 'opacity-100');
    content.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      modal.classList.add('invisible');
    }, 300);
  };

  closeBtns.forEach(btn => btn.addEventListener('click', closeModal));
  overlay.addEventListener('click', closeModal);

  // Trigger from PDP buttons
  document.querySelectorAll('[data-action="open-size-guide"]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      window.openSizeGuide();
    });
  });
});
</script>

{% schema %}
{
  "name": "Size Guide Modal",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Modal Title",
      "default": "Size Guide"
    },
    {
      "type": "image_picker",
      "id": "guide_image",
      "label": "Guide Illustration/Diagram"
    },
    {
      "type": "richtext",
      "id": "instructions",
      "label": "Instructions",
      "default": "<p>Measure yourself correctly to ensure the perfect fit.</p>"
    }
  ],
  "presets": [
    {
      "name": "Size Guide Modal"
    }
  ]
}
{% endschema %}
