{%- if template contains 'collection' and collection.filters.size > 0 -%}
<div class="active-filters py-4 border-b border-[var(--color-border)] bg-[var(--color-background)]">
  <div class="max-w-7xl mx-auto px-6 flex flex-wrap items-center gap-3">
    
    <span class="text-xs font-bold uppercase tracking-widest text-[var(--color-text-secondary)] mr-2">Active Filters:</span>

    {%- assign has_active = false -%}

    {%- for filter in collection.filters -%}
      {%- if filter.type == "price_range" -%}
        {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
          {%- assign has_active = true -%}
          <a href="{{ filter.url_to_remove }}" class="inline-flex items-center gap-2 px-3 py-1 bg-neutral-100 rounded-full text-sm hover:bg-red-50 hover:text-[var(--color-accent)] transition-colors group">
            {%- if filter.min_value.value -%}{{ filter.min_value.value | money }}{%- else -%}{{ 0 | money }}{%- endif -%} - 
            {%- if filter.max_value.value -%}{{ filter.max_value.value | money }}{%- else -%}{{ filter.range_max | money }}{%- endif -%}
            <svg class="w-3 h-3 text-[var(--color-text-secondary)] group-hover:text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </a>
        {%- endif -%}
      {%- else -%}
        {%- for filter_value in filter.active_values -%}
          {%- assign has_active = true -%}
          <a href="{{ filter_value.url_to_remove }}" class="inline-flex items-center gap-2 px-3 py-1 bg-[var(--color-text)] text-[var(--color-background)] rounded-full text-sm hover:bg-red-600 transition-colors group">
            {{ filter.label }}: {{ filter_value.label }}
            <svg class="w-3 h-3 text-[var(--color-background)]/70 group-hover:text-[var(--color-background)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </a>
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_active -%}
      <a href="{{ collection.url }}?sort_by={{ collection.sort_by }}" class="text-xs font-bold underline text-[var(--color-text-secondary)] hover:text-[var(--color-text)] ml-2 transition-colors">Clear All</a>
    {%- else -%}
      <span class="text-sm text-[var(--color-text-secondary)] italic">None</span>
    {%- endif -%}

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Collection Active Filters",
  "settings": [],
  "presets": [
    {
      "name": "Collection Active Filters"
    }
  ]
}
{% endschema %}
