<div id="age-verification-modal" class="fixed inset-0 z-[200] invisible flex items-center justify-center bg-[var(--color-text)]/90 backdrop-blur-md">
  
  <div class="relative bg-[var(--color-background)] text-[var(--color-text)] shadow-2xl rounded-2xl overflow-hidden max-w-lg w-full mx-4 p-8 md:p-12 text-center transform scale-95 opacity-0 transition-all duration-500">
    
    {%- if section.settings.logo != blank -%}
      <img src="{{ section.settings.logo | img_url: '300x' }}" class="h-12 w-auto mx-auto mb-8" loading="lazy">
    {%- else -%}
      <div class="w-16 h-16 mx-auto mb-6 bg-red-100 text-[var(--color-accent)] rounded-full flex items-center justify-center">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      </div>
    {%- endif -%}

    <h2 class="text-3xl font-black uppercase tracking-wider mb-4">{{ section.settings.title }}</h2>
    <p class="text-[var(--color-text-secondary)] mb-8">{{ section.settings.text }}</p>

    <div class="flex flex-col gap-4">
      <button id="age-verify-yes" class="w-full py-4 bg-[var(--color-text)] text-[var(--color-background)] font-bold uppercase tracking-widest rounded hover:bg-neutral-800 transition-colors">
        Yes, I am {{ section.settings.age_limit }} or older
      </button>
      <a href="{{ section.settings.redirect_url }}" class="w-full py-4 bg-transparent border-2 border-[var(--color-border)] text-[var(--color-text-secondary)] font-bold uppercase tracking-widest rounded hover:border-black hover:text-[var(--color-text)] transition-colors">
        No, I am under {{ section.settings.age_limit }}
      </a>
    </div>

    <p class="mt-8 text-xs text-[var(--color-text-secondary)]">By entering this site you agree to our Terms and Conditions & Privacy Policy.</p>

  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  {% if section.settings.enable_age_verification %}
    const modal = document.getElementById('age-verification-modal');
    const content = modal.querySelector('div.relative');
    const btnYes = document.getElementById('age-verify-yes');

    // Check if verified
    if (!localStorage.getItem('age_verified')) {
      // Prevent scrolling
      document.body.style.overflow = 'hidden';
      
      modal.classList.remove('invisible');
      setTimeout(() => {
        content.classList.remove('scale-95', 'opacity-0');
        content.classList.add('scale-100', 'opacity-100');
      }, 100);
    }

    btnYes.addEventListener('click', () => {
      localStorage.setItem('age_verified', 'true');
      content.classList.remove('scale-100', 'opacity-100');
      content.classList.add('scale-95', 'opacity-0');
      
      setTimeout(() => {
        modal.classList.add('invisible');
        document.body.style.overflow = '';
      }, 500);
    });
  {% endif %}
});
</script>

{% schema %}
{
  "name": "Age Verification",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_age_verification",
      "label": "Enable Age Verification",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Are you of legal age?"
    },
    {
      "type": "number",
      "id": "age_limit",
      "label": "Age Limit",
      "default": 18
    },
    {
      "type": "text",
      "id": "text",
      "label": "Message",
      "default": "You must be of legal age to enter this site."
    },
    {
      "type": "url",
      "id": "redirect_url",
      "label": "Underage Redirect URL",
      "default": "https://google.com"
    }
  ],
  "presets": [
    {
      "name": "Age Verification"
    }
  ]
}
{% endschema %}
