<div class="sf-urgency-timer py-4 px-6 bg-[var(--color-text)] text-[var(--color-background)] text-center" style="content-visibility: auto;">
  <p class="text-base font-medium">
    {{ section.settings.message }} 
    <span class="font-bold ml-2 p-1 bg-[var(--color-accent)] text-[var(--color-text)] rounded shadow" id="sf-timer-{{ section.id }}">15:00</span>
  </p>
</div>

<script>
  let time = 15 * 60;
  const el = document.getElementById('sf-timer-{{ section.id }}');
  if(el) {
    setInterval(() => {
      if (time <= 0) return;
      time--;
      const m = Math.floor(time / 60);
      const s = time % 60;
      el.innerText = `${m}:${s.toString().padStart(2, '0')}`;
    }, 1000);
  }
</script>

{% schema %}
{
  "name": "Cart Timer",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "Your cart is reserved for:"
    }
  ],
  "presets": [
    {
      "name": "Cart Timer"
    }
  ]
}
{% endschema %}
