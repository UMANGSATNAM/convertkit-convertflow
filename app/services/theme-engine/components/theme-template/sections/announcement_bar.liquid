<div class="sf-announcement sf-announcement-{{ section.id }}" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="sf-announcement-content">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" style="color: inherit;">{{ section.settings.text }}</a>
    {% else %}
      {{ section.settings.text }}
    {% endif %}
  </div>
</div>

<style>
  .sf-announcement-{{ section.id }} {
    padding: 10px;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .sf-announcement-content a {
    text-decoration: none;
  }
  .sf-announcement-content a:hover {
    text-decoration: underline;
  }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Free Shipping on all orders over ₹999!"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "D2C Announcement Bar",
      "category": "Header"
    }
  ]
}
{% endschema %}
