<div class="modern-trust" style="background-color: var(--color-background); color: var(--color-background); padding: 80px 20px; text-align: center; border-top: 1px solid color-mix(in srgb, var(--color-background) 5%, transparent);">
  <div style="display: flex; justify-content: center; max-width: 1100px; margin: 0 auto; flex-wrap: wrap; gap: 30px;">
    <div style="flex: 1; min-width: 250px; background: var(--color-surface); padding: 40px 30px; border-radius: var(--radius-card, 16px); border: 1px solid color-mix(in srgb, var(--color-background) 5%, transparent);">
      <h4 style="font-family: var(--font-heading, 'Space Grotesk', sans-serif); font-size: 20px; font-weight: 600; margin-bottom: 15px; color: var(--color-background);">Next-Day Delivery</h4>
      <p style="font-family: var(--font-body, 'Inter', sans-serif); font-size: 15px; font-weight: 400; color: var(--color-text-secondary); line-height: 1.6;">Orders placed before 5 PM ship immediately via expedited courier.</p>
    </div>
    <div style="flex: 1; min-width: 250px; background: var(--color-surface); padding: 40px 30px; border-radius: var(--radius-card, 16px); border: 1px solid color-mix(in srgb, var(--color-background) 5%, transparent);">
      <h4 style="font-family: var(--font-heading, 'Space Grotesk', sans-serif); font-size: 20px; font-weight: 600; margin-bottom: 15px; color: var(--color-background);">2-Year Warranty</h4>
      <p style="font-family: var(--font-body, 'Inter', sans-serif); font-size: 15px; font-weight: 400; color: var(--color-text-secondary); line-height: 1.6;">Full coverage on all hardware defects, no questions asked.</p>
    </div>
    <div style="flex: 1; min-width: 250px; background: var(--color-surface); padding: 40px 30px; border-radius: var(--radius-card, 16px); border: 1px solid color-mix(in srgb, var(--color-background) 5%, transparent);">
      <h4 style="font-family: var(--font-heading, 'Space Grotesk', sans-serif); font-size: 20px; font-weight: 600; margin-bottom: 15px; color: var(--color-background);">24/7 Priority Support</h4>
      <p style="font-family: var(--font-body, 'Inter', sans-serif); font-size: 15px; font-weight: 400; color: var(--color-text-secondary); line-height: 1.6;">Direct line to our technical experts whenever you need them.</p>
    </div>
  </div>
</div>

