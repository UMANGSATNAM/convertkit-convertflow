<div class="luxury-grid" style="padding: 80px 40px; background-color: var(--color-background); text-align: center;">
  <h2 style="font-family: var(--font-heading, 'Playfair Display', serif); font-size: 36px; margin-bottom: 40px; color: var(--color-text); font-weight: 400;">Curated Collection</h2>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px;">
    {% for product in collections['all'].products limit: 4 %}
      <div class="product-card" style="text-align: left;">
        <a href="{{ product.url }}" style="text-decoration: none;">
          <div style="width: 100%; padding-top: 130%; position: relative; background-color: var(--color-surface); overflow: hidden; border-radius: var(--radius-card, 4px);">
            <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title }}" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" loading="lazy">
          </div>
          <h3 style="font-family: var(--font-body, 'Inter', sans-serif); font-size: 14px; text-transform: uppercase; margin-top: 20px; color: var(--color-text); letter-spacing: 1px;">{{ product.title }}</h3>
          <p style="font-family: var(--font-heading, 'Playfair Display', serif); font-size: 16px; color: var(--color-text-secondary); margin-top: 5px;">{{ product.price | money }}</p>
        </a>
      </div>
    {% else %}
      <!-- Mock Data -->
      {% for i in (1..4) %}
        <div class="product-card" style="text-align: left;">
          <div style="width: 100%; padding-top: 130%; position: relative; background-color: var(--color-border); border-radius: var(--radius-card, 4px);"></div>
          <h3 style="font-family: var(--font-body, 'Inter', sans-serif); font-size: 14px; text-transform: uppercase; margin-top: 20px; color: var(--color-text); letter-spacing: 1px;">Premium Item {{ i }}</h3>
          <p style="font-family: var(--font-heading, 'Playfair Display', serif); font-size: 16px; color: var(--color-text-secondary); margin-top: 5px;">$295.00</p>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Luxury Product Grid",
  "settings": []
}
{% endschema %}
