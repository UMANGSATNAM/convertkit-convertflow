<div class="bold-grid" style="padding: 100px 40px; background-color: var(--color-surface); text-align: left;">
  <h2 style="font-family: var(--font-heading, 'Anton', sans-serif); font-size: 72px; text-transform: uppercase; line-height: 0.9; margin-bottom: 60px; color: var(--color-text);">Latest<br>Releases</h2>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 0;">
    {% for product in collections['all'].products limit: 4 %}
      <div class="product-card" style="border: 4px solid var(--color-text); border-right: none; border-bottom: none; position: relative;">
        <a href="{{ product.url }}" style="text-decoration: none; color: var(--color-text);">
          <div style="width: 100%; padding-top: 100%; position: relative; background-color: var(--color-background); overflow: hidden;">
            <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title }}" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; filter: contrast(1.2) grayscale(0.2); transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'" loading="lazy">
          </div>
          <div style="padding: 20px; border-top: 4px solid var(--color-text); background: var(--color-accent); display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-family: var(--font-body, 'Roboto Mono', monospace); font-size: 18px; font-weight: 700; text-transform: uppercase; margin: 0;">{{ product.title }}</h3>
            <span style="font-family: var(--font-heading, 'Anton', sans-serif); font-size: 24px;">{{ product.price | money }}</span>
          </div>
        </a>
      </div>
    {% else %}
      <!-- Mock Data -->
      {% for i in (1..4) %}
        <div class="product-card" style="border: 4px solid var(--color-text); margin-right: -4px; margin-bottom: -4px; position: relative;">
          <div style="width: 100%; padding-top: 100%; position: relative; background-color: var(--color-background); overflow: hidden;">
            <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: repeating-linear-gradient(45deg, var(--color-text), var(--color-text) 10px, var(--color-background) 10px, var(--color-background) 20px);"></div>
          </div>
          <div style="padding: 20px; border-top: 4px solid var(--color-text); background: var(--color-accent); display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-family: var(--font-body, 'Roboto Mono', monospace); font-size: 18px; font-weight: 700; text-transform: uppercase; margin: 0; color: var(--color-text);">Drop {{ i }}</h3>
            <span style="font-family: var(--font-heading, 'Anton', sans-serif); font-size: 24px; color: var(--color-text);">$120</span>
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Bold Product Grid",
  "settings": []
}
{% endschema %}
