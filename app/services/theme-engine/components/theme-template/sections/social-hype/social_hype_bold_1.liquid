<div class="bold-social-hype" style="background-color: var(--color-text); color: var(--color-background); padding: 120px 0; overflow: hidden; position: relative;">
  <div style="white-space: nowrap; font-family: var(--font-heading, 'Anton', sans-serif); font-size: 120px; text-transform: uppercase; color: transparent; -webkit-text-stroke: 2px var(--color-background); line-height: 1;">
    <marquee scrollamount="15">JOIN THE MOVEMENT // NO RESTOCKS // EXCLUSIVE DROPS // JOIN THE MOVEMENT // NO RESTOCKS // EXCLUSIVE DROPS //</marquee>
  </div>
  <div style="text-align: center; margin-top: 60px;">
    <a href="#" style="display: inline-block; background: var(--color-accent); color: var(--color-text); font-family: var(--font-body, 'Roboto Mono', monospace); font-weight: 700; font-size: 20px; padding: 20px 60px; text-decoration: none; border: 4px solid var(--color-background); text-transform: uppercase; transition: transform 0.1s;" onmouseover="this.style.transform='translate(-5px, -5px)'; this.style.boxShadow='5px 5px 0px #fff'" onmouseout="this.style.transform='translate(0, 0)'; this.style.boxShadow='none'">Follow on IG</a>
  </div>
</div>

{% schema %}
{
  "name": "Bold Social Hype",
  "settings": []
}
{% endschema %}
