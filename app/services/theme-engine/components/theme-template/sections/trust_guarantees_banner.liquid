<div class="sf-guarantee sf-gb-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-gb-container">
    <div class="sf-gb-grid">
      {% for block in section.blocks %}
        <div class="sf-gb-item">
          <div class="sf-gb-icon" style="color: {{ section.settings.icon_color }};">
            {% case block.settings.icon %}
              {% when 'shipping' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 18H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H19a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2"></path><circle cx="9" cy="18" r="2"></circle><circle cx="17" cy="18" r="2"></circle></svg>
              {% when 'returns' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
              {% when 'secure' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
              {% when 'support' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              {% else %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            {% endcase %}
          </div>
          <div class="sf-gb-info">
            <h3 style="color: {{ section.settings.text_color }};">{{ block.settings.title }}</h3>
            <p style="color: {{ section.settings.text_color }};">{{ block.settings.text }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .sf-gb-{{ section.id }} { padding: 3rem 1rem; border-top: 1px solid color-mix(in srgb, var(--color-text) 5%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--color-text) 5%, transparent); }
  .sf-gb-container { max-width: 1400px; margin: 0 auto; }
  .sf-gb-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  @media (min-width: 768px) { .sf-gb-grid { grid-template-columns: repeat({{ section.blocks.size | at_most: 4 }}, 1fr); } }
  .sf-gb-item { display: flex; align-items: flex-start; gap: 1rem; }
  .sf-gb-icon { display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; flex-shrink: 0; }
  .sf-gb-info h3 { font-size: 1.1rem; font-weight: bold; margin-bottom: 0.25rem; }
  .sf-gb-info p { opacity: 0.8; font-size: 0.95rem; line-height: 1.4; }
</style>

{% schema %}
{
  "name": "Guarantees Banner",
  "max_blocks": 4,
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f9f9f9" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111111" },
    { "type": "color", "id": "icon_color", "label": "Icon Color", "default": "#111111" }
  ],
  "blocks": [
    {
      "type": "guarantee", "name": "Guarantee",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "shipping", "label": "Shipping" }, { "value": "returns", "label": "Returns" }, { "value": "secure", "label": "Secure" }, { "value": "support", "label": "Support" }, { "value": "time", "label": "Time" } ], "default": "shipping" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free Shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On all orders over $50" }
      ]
    }
  ],
  "presets": [ { "name": "Guarantees Banner", "category": "Trust", "blocks": [{"type":"guarantee"},{"type":"guarantee"},{"type":"guarantee"},{"type":"guarantee"}] } ]
}
{% endschema %}
