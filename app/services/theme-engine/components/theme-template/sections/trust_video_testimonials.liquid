<div class="sf-vt sf-vt-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-vt-container">
    <div class="sf-vt-header">
      <h2 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
    </div>
    
    <div class="sf-vt-grid">
      {% for block in section.blocks %}
        <div class="sf-vt-item">
          <div class="sf-vt-video-wrapper">
            {% if block.settings.video_url != blank %}
              {% if block.settings.video_url.type == 'youtube' %}
                <iframe src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?controls=0" frameborder="0" allowfullscreen></iframe>
              {% elsif block.settings.video_url.type == 'vimeo' %}
                <iframe src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}" frameborder="0" allowfullscreen></iframe>
              {% endif %}
            {% else %}
              <div class="sf-vt-placeholder">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'sf-placeholder' }}
                <div class="sf-vt-play">▶</div>
              </div>
            {% endif %}
          </div>
          <div class="sf-vt-info" style="color: {{ section.settings.text_color }};">
            <h3>{{ block.settings.name }}</h3>
            <p>{{ block.settings.handle }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .sf-vt-{{ section.id }} { padding: 5rem 1rem; }
  .sf-vt-container { max-width: 1400px; margin: 0 auto; }
  .sf-vt-header { text-align: center; margin-bottom: 4rem; }
  .sf-vt-header h2 { font-size: 2.5rem; }
  .sf-vt-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  @media (min-width: 768px) { .sf-vt-grid { grid-template-columns: repeat({{ section.blocks.size | at_most: 4 }}, 1fr); } }
  .sf-vt-item { text-align: center; }
  .sf-vt-video-wrapper { width: 100%; aspect-ratio: 9/16; background: var(--color-text); border-radius: 16px; overflow: hidden; position: relative; margin-bottom: 1.5rem; box-shadow: 0 10px 30px color-mix(in srgb, var(--color-text) 10%, transparent); }
  .sf-vt-video-wrapper iframe { width: 100%; height: 100%; position: absolute; top: 0; left: 0; }
  .sf-vt-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; position: relative; }
  .sf-vt-placeholder svg { width: 100%; height: 100%; object-fit: cover; opacity: 0.6; }
  .sf-vt-play { position: absolute; font-size: 2rem; color: white; background: color-mix(in srgb, var(--color-text) 50%, transparent); width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(5px); }
  .sf-vt-info h3 { font-size: 1.25rem; font-weight: bold; margin-bottom: 0.5rem; }
  .sf-vt-info p { opacity: 0.7; font-size: 0.95rem; }
</style>

{% schema %}
{
  "name": "Video Testimonials",
  "max_blocks": 4,
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111111" },
    { "type": "text", "id": "title", "label": "Title", "default": "Real Results from Real People" }
  ],
  "blocks": [
    {
      "type": "video", "name": "Video",
      "settings": [
        { "type": "video_url", "id": "video_url", "label": "Video URL", "accept": ["youtube", "vimeo"] },
        { "type": "text", "id": "name", "label": "Name", "default": "Emily R." },
        { "type": "text", "id": "handle", "label": "Social Handle", "default": "@emily.style" }
      ]
    }
  ],
  "presets": [ { "name": "Video Testimonials", "category": "Trust", "blocks": [{"type":"video"},{"type":"video"},{"type":"video"}] } ]
}
{% endschema %}
