<header style="display: flex; justify-content: space-between; align-items: center; padding: 20px 40px; border-bottom: 1px solid var(--color-border);">
  <div class="logo">
    <h2 style="margin: 0; font-size: 24px; letter-spacing: 2px; text-transform: uppercase;">
      {{ shop.name }}
    </h2>
  </div>
  <nav>
    <ul style="list-style: none; display: flex; gap: 20px; margin: 0; padding: 0;">
      {% for link in linklists.main-menu.links %}
        <li><a href="{{ link.url }}" style="text-decoration: none; color: var(--color-text-secondary); font-weight: 500;">{{ link.title }}</a></li>
      {% endfor %}
    </ul>
  </nav>
  <div class="icons">
    <a href="/cart" style="text-decoration: none; color: var(--color-text-secondary); font-weight: 500;">Cart ({{ cart.item_count }})</a>
  </div>
</header>

{% schema %}
{
  "name": "Fashion Header 1",
  "settings": [],
  "presets": [
    {
      "name": "Fashion Header 1"
    }
  ]
}
{% endschema %}
