<div class="hero-fashion" style="background-color: {{ section.settings.bg_color }}; text-align: center; padding: 60px 20px;">
  <h1 style="font-family: {{ section.settings.heading_font.family }}; color: {{ section.settings.text_color }}; font-size: 3em; margin-bottom: 20px;">
    {{ section.settings.title | default: "Luxury Minimalist Fashion" }}
  </h1>
  <p style="color: {{ section.settings.text_color }}; font-size: 1.2em; margin-bottom: 30px;">
    {{ section.settings.subtitle | default: "Discover the new season collection." }}
  </p>
  <a href="{{ section.settings.button_link }}" style="display: inline-block; padding: 15px 30px; background-color: {{ section.settings.button_bg_color }}; color: {{ section.settings.button_text_color }}; text-decoration: none; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
    {{ section.settings.button_label | default: "Shop Now" }}
  </a>
</div>

{% schema %}
{
  "name": "Fashion Hero 1",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Luxury Minimalist Fashion"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Discover the new season collection."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Fashion Hero 1"
    }
  ]
}
{% endschema %}
