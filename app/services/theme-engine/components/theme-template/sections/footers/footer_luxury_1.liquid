<div class="luxury-footer" style="background-color: var(--color-text); color: var(--color-text-secondary); padding: 80px 40px 40px; text-align: center; border-top: 1px solid var(--color-text);">
  <h2 style="font-family: var(--font-heading, 'Playfair Display', serif); font-size: 32px; color: var(--color-background); margin-bottom: 20px;">{{ shop.name | default: 'Maison' }}</h2>
  <div style="font-family: var(--font-body, 'Inter', sans-serif); font-size: 12px; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 40px; display: flex; justify-content: center; gap: 30px;">
    <a href="#" style="color: var(--color-text-secondary); text-decoration: none;">Instagram</a>
    <a href="#" style="color: var(--color-text-secondary); text-decoration: none;">Journal</a>
    <a href="#" style="color: var(--color-text-secondary); text-decoration: none;">Contact</a>
  </div>
  <p style="font-family: var(--font-body, 'Inter', sans-serif); font-size: 11px; letter-spacing: 1px; color: var(--color-text-secondary);">&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All Rights Reserved.</p>
</div>

{% schema %}
{
  "name": "Luxury Footer",
  "settings": []
}
{% endschema %}
