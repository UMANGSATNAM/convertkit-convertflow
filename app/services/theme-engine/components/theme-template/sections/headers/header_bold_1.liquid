<div class="bold-header" style="background-color: var(--color-accent); color: var(--color-text); padding: 20px 40px; display: flex; justify-content: space-between; align-items: center; border-bottom: 4px solid var(--color-text); text-transform: uppercase;">
  <div class="header-nav" style="font-family: var(--font-body, 'Roboto Mono', monospace); font-size: 16px; font-weight: 700; display: flex; gap: 30px;">
    <a href="/collections/all" style="color: var(--color-text); text-decoration: none; border-bottom: 2px solid transparent;" onmouseover="this.style.borderBottom='2px solid #000'" onmouseout="this.style.borderBottom='2px solid transparent'">Drops</a>
    <a href="/pages/community" style="color: var(--color-text); text-decoration: none; border-bottom: 2px solid transparent;" onmouseover="this.style.borderBottom='2px solid #000'" onmouseout="this.style.borderBottom='2px solid transparent'">Crew</a>
  </div>
  <div class="header-logo" style="font-family: var(--font-heading, 'Anton', sans-serif); font-size: 40px; letter-spacing: 2px; line-height: 1;">
    {{ shop.name | default: 'STREET' }}
  </div>
  <div class="header-actions" style="font-family: var(--font-body, 'Roboto Mono', monospace); font-size: 16px; font-weight: 700;">
    <a href="/cart" style="color: var(--color-text); text-decoration: none;">[ CART: {{ cart.item_count }} ]</a>
  </div>
</div>

{% schema %}
{
  "name": "Bold Header",
  "settings": []
}
{% endschema %}
