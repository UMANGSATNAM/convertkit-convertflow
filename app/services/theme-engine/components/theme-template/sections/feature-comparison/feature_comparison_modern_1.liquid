<div class="modern-feature-comparison" style="padding: 100px 20px; background-color: var(--color-background); color: var(--color-background); text-align: center; border-top: 1px solid color-mix(in srgb, var(--color-background) 5%, transparent);">
  <h2 style="font-family: var(--font-heading, 'Space Grotesk', sans-serif); font-size: 32px; margin-bottom: 60px; font-weight: 700;">Engineered for Superiority</h2>
  
  <div style="max-width: 800px; margin: 0 auto; overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; font-family: var(--font-body, 'Inter', sans-serif); text-align: left;">
      <thead>
        <tr style="border-bottom: 1px solid color-mix(in srgb, var(--color-background) 10%, transparent);">
          <th style="padding: 20px; color: var(--color-text-secondary); font-weight: 500; font-size: 14px;">Feature</th>
          <th style="padding: 20px; color: var(--color-accent); font-weight: 700; font-size: 16px;">Our Standard</th>
          <th style="padding: 20px; color: var(--color-text-secondary); font-weight: 500; font-size: 14px;">Industry Average</th>
        </tr>
      </thead>
      <tbody>
        <tr style="border-bottom: 1px solid color-mix(in srgb, var(--color-background) 5%, transparent);">
          <td style="padding: 20px; font-weight: 600;">Processing Speed</td>
          <td style="padding: 20px; color: var(--color-background); font-weight: 600;">4.2 GHz Base</td>
          <td style="padding: 20px; color: var(--color-text-secondary);">3.5 GHz Base</td>
        </tr>
        <tr style="border-bottom: 1px solid color-mix(in srgb, var(--color-background) 5%, transparent);">
          <td style="padding: 20px; font-weight: 600;">Build Material</td>
          <td style="padding: 20px; color: var(--color-background); font-weight: 600;">Aerospace Aluminum</td>
          <td style="padding: 20px; color: var(--color-text-secondary);">Recycled Plastic</td>
        </tr>
        <tr style="border-bottom: 1px solid color-mix(in srgb, var(--color-background) 5%, transparent);">
          <td style="padding: 20px; font-weight: 600;">Warranty</td>
          <td style="padding: 20px; color: var(--color-background); font-weight: 600;">2 Years Included</td>
          <td style="padding: 20px; color: var(--color-text-secondary);">1 Year Limited</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "Modern Feature Comparison",
  "settings": []
}
{% endschema %}
