{%- comment -%}
  Section: product_interactive_comparison
  Interactive spec matrix: our product vs alternatives.
  Highlighted own column + checkmark circles; mobile competitor switcher.
  Niche-adaptive via theme CSS tokens. No ternary/pluralize/color_modify.
{%- endcomment -%}

<style>
  #cfcmp-{{ section.id }}{
    --cf-accent: var(--color-accent, #111111);
    --cf-bg: var(--color-background, #ffffff);
    --cf-text: var(--color-text, #15110b);
    --cf-heading: var(--font-heading-family, 'Inter', system-ui, sans-serif);
    --cf-card-radius: var(--card-radius, 14px);
    --cf-btn-radius: var(--button-radius, 0px);
    --cf-muted: color-mix(in srgb, var(--cf-text) 50%, transparent);
    --cf-line: color-mix(in srgb, var(--cf-text) 12%, transparent);
    --cf-soft: color-mix(in srgb, var(--cf-bg) 94%, var(--cf-text) 6%);
    --cf-accent-soft: color-mix(in srgb, var(--cf-accent) 10%, var(--cf-bg));
    --cf-cross: color-mix(in srgb, var(--cf-text) 30%, transparent);
  }
  {%- if section.settings.bg_override != blank -%}#cfcmp-{{ section.id }}{--cf-bg:{{ section.settings.bg_override }};}{%- endif -%}
</style>

<section class="cfcmp" id="cfcmp-{{ section.id }}">
  <div class="cfcmp-wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="cfcmp-head">
        {%- if section.settings.eyebrow != blank -%}<span class="cfcmp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="cfcmp-title">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="cfcmp-sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Mobile competitor switcher {%- endcomment -%}
    <div class="cfcmp-switch" data-cfcmp-switch>
      <span class="cfcmp-switch-label">Compare against:</span>
      <div class="cfcmp-chips">
        {%- if section.settings.comp1_name != blank -%}<button type="button" class="cfcmp-chip is-active" data-comp="1">{{ section.settings.comp1_name }}</button>{%- endif -%}
        {%- if section.settings.comp2_name != blank -%}<button type="button" class="cfcmp-chip" data-comp="2">{{ section.settings.comp2_name }}</button>{%- endif -%}
        {%- if section.settings.comp3_name != blank -%}<button type="button" class="cfcmp-chip" data-comp="3">{{ section.settings.comp3_name }}</button>{%- endif -%}
      </div>
    </div>

    <div class="cfcmp-scroll">
      <table class="cfcmp-table" data-cfcmp-table data-active-comp="1">
        <thead>
          <tr>
            <th class="cfcmp-feat-h"></th>
            <th class="cfcmp-us-h" scope="col">
              {%- if section.settings.our_badge != blank -%}<span class="cfcmp-badge">{{ section.settings.our_badge }}</span>{%- endif -%}
              <span class="cfcmp-colname">{{ section.settings.our_col_name }}</span>
            </th>
            {%- if section.settings.comp1_name != blank -%}<th class="cfcmp-comp-h" data-col="1" scope="col">{{ section.settings.comp1_name }}</th>{%- endif -%}
            {%- if section.settings.comp2_name != blank -%}<th class="cfcmp-comp-h" data-col="2" scope="col">{{ section.settings.comp2_name }}</th>{%- endif -%}
            {%- if section.settings.comp3_name != blank -%}<th class="cfcmp-comp-h" data-col="3" scope="col">{{ section.settings.comp3_name }}</th>{%- endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <tr {{ block.shopify_attributes }}>
                <td class="cfcmp-feat-name">{{ block.settings.title }}</td>
                <td class="cfcmp-us-val">
                  <div class="cfcmp-val-wrap">
                    {%- if block.settings.our_status == 'check' -%}
                      <span class="cfcmp-icon cfcmp-icon--check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>
                    {%- elsif block.settings.our_status == 'cross' -%}
                      <span class="cfcmp-icon cfcmp-icon--cross"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>
                    {%- endif -%}
                    {%- if block.settings.our_text != blank -%}<span class="cfcmp-val-text">{{ block.settings.our_text }}</span>{%- endif -%}
                  </div>
                </td>
                {%- if section.settings.comp1_name != blank -%}
                  <td class="cfcmp-comp-val" data-col="1">
                    <div class="cfcmp-val-wrap">
                      {%- if block.settings.comp1_status == 'check' -%}
                        <span class="cfcmp-icon cfcmp-icon--check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>
                      {%- elsif block.settings.comp1_status == 'cross' -%}
                        <span class="cfcmp-icon cfcmp-icon--cross"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>
                      {%- endif -%}
                      {%- if block.settings.comp1_text != blank -%}<span class="cfcmp-val-text">{{ block.settings.comp1_text }}</span>{%- endif -%}
                    </div>
                  </td>
                {%- endif -%}
                {%- if section.settings.comp2_name != blank -%}
                  <td class="cfcmp-comp-val" data-col="2">
                    <div class="cfcmp-val-wrap">
                      {%- if block.settings.comp2_status == 'check' -%}
                        <span class="cfcmp-icon cfcmp-icon--check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>
                      {%- elsif block.settings.comp2_status == 'cross' -%}
                        <span class="cfcmp-icon cfcmp-icon--cross"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>
                      {%- endif -%}
                      {%- if block.settings.comp2_text != blank -%}<span class="cfcmp-val-text">{{ block.settings.comp2_text }}</span>{%- endif -%}
                    </div>
                  </td>
                {%- endif -%}
                {%- if section.settings.comp3_name != blank -%}
                  <td class="cfcmp-comp-val" data-col="3">
                    <div class="cfcmp-val-wrap">
                      {%- if block.settings.comp3_status == 'check' -%}
                        <span class="cfcmp-icon cfcmp-icon--check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>
                      {%- elsif block.settings.comp3_status == 'cross' -%}
                        <span class="cfcmp-icon cfcmp-icon--cross"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>
                      {%- endif -%}
                      {%- if block.settings.comp3_text != blank -%}<span class="cfcmp-val-text">{{ block.settings.comp3_text }}</span>{%- endif -%}
                    </div>
                  </td>
                {%- endif -%}
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% stylesheet %}
.cfcmp{background:var(--cf-bg);color:var(--cf-text);padding:64px 0;font-family:'Inter',system-ui,sans-serif}
.cfcmp *{box-sizing:border-box}
.cfcmp-wrap{max-width:1160px;margin:0 auto;padding:0 20px}
.cfcmp-head{text-align:center;max-width:640px;margin:0 auto 44px}
.cfcmp-eyebrow{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--cf-accent);margin-bottom:10px}
.cfcmp-title{font-family:var(--cf-heading);font-size:34px;line-height:1.12;font-weight:700;margin:0}
.cfcmp-sub{font-size:15px;color:var(--cf-muted);margin:12px 0 0;line-height:1.6}

.cfcmp-switch{display:none;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px;padding:0 4px}
.cfcmp-switch-label{font-size:13px;font-weight:600;color:var(--cf-muted)}
.cfcmp-chips{display:flex;gap:6px}
.cfcmp-chip{background:var(--cf-soft);border:1px solid var(--cf-line);color:var(--cf-text);font-size:12px;font-weight:700;padding:6px 14px;border-radius:99px;cursor:pointer;transition:.15s;border:1px solid var(--cf-line)}
.cfcmp-chip.is-active{background:var(--cf-accent);color:#fff;border-color:var(--cf-accent)}

.cfcmp-scroll{width:100%;overflow-x:auto}
.cfcmp-table{width:100%;border-collapse:separate;border-spacing:0;font-size:14px;min-width:600px}
.cfcmp-table th, .cfcmp-table td{padding:18px 16px;border-bottom:1px solid var(--cf-line);vertical-align:middle}

.cfcmp-feat-h{width:35%}
.cfcmp-us-h{width:25%;background:var(--cf-accent-soft);border-top-left-radius:var(--cf-card-radius);border-top-right-radius:var(--cf-card-radius);position:relative;text-align:center}
.cfcmp-comp-h{width:20%;text-align:center;color:var(--cf-muted)}

.cfcmp-badge{position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--cf-accent);color:#fff;font-size:9.5px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;padding:4px 10px;border-radius:99px;white-space:nowrap;box-shadow:0 4px 10px rgba(10,8,4,0.15)}
.cfcmp-colname{font-family:var(--cf-heading);font-size:16px;font-weight:700;color:var(--cf-accent);display:block}

.cfcmp-feat-name{font-weight:600;color:var(--cf-text)}
.cfcmp-us-val{background:var(--cf-accent-soft);text-align:center;font-weight:700}
.cfcmp-comp-val{text-align:center;color:var(--cf-muted)}

.cfcmp-val-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px}
.cfcmp-icon{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:50%}
.cfcmp-icon--check{background:var(--cf-accent-soft);color:var(--cf-accent)}
.cfcmp-icon--check svg{width:14px;height:14px}
.cfcmp-icon--cross{background:var(--cf-soft);color:var(--cf-cross)}
.cfcmp-icon--cross svg{width:12px;height:12px}
.cfcmp-val-text{font-size:12.5px;margin-top:2px}

.cfcmp-table tr:last-child .cfcmp-us-val{border-bottom-left-radius:var(--cf-card-radius);border-bottom-right-radius:var(--cf-card-radius)}

@media(max-width:768px){
  .cfcmp{padding:48px 0}
  .cfcmp-title{font-size:26px}
  .cfcmp-switch{display:flex}
  .cfcmp-table{min-width:100%}
  .cfcmp-feat-h{width:50%}
  .cfcmp-us-h{width:25%}
  .cfcmp-comp-h{width:25%}
  
  /* Hide competitor columns except the active one */
  .cfcmp-table[data-active-comp="1"] .cfcmp-comp-h[data-col="2"],
  .cfcmp-table[data-active-comp="1"] .cfcmp-comp-h[data-col="3"],
  .cfcmp-table[data-active-comp="1"] .cfcmp-comp-val[data-col="2"],
  .cfcmp-table[data-active-comp="1"] .cfcmp-comp-val[data-col="3"]{display:none}

  .cfcmp-table[data-active-comp="2"] .cfcmp-comp-h[data-col="1"],
  .cfcmp-table[data-active-comp="2"] .cfcmp-comp-h[data-col="3"],
  .cfcmp-table[data-active-comp="2"] .cfcmp-comp-val[data-col="1"],
  .cfcmp-table[data-active-comp="2"] .cfcmp-comp-val[data-col="3"]{display:none}

  .cfcmp-table[data-active-comp="3"] .cfcmp-comp-h[data-col="1"],
  .cfcmp-table[data-active-comp="3"] .cfcmp-comp-h[data-col="2"],
  .cfcmp-table[data-active-comp="3"] .cfcmp-comp-val[data-col="1"],
  .cfcmp-table[data-active-comp="3"] .cfcmp-comp-val[data-col="2"]{display:none}
}
@media(prefers-reduced-motion:reduce){.cfcmp-chip{transition:none}}
{% endstylesheet %}

<script>
(function(){
  var root = document.getElementById('cfcmp-{{ section.id }}');
  if(!root || root.dataset.bound) return; root.dataset.bound='1';
  var table = root.querySelector('[data-cfcmp-table]');
  var chips = root.querySelectorAll('.cfcmp-chip');
  
  chips.forEach(function(btn){
    btn.addEventListener('click', function(){
      var compId = btn.dataset.comp;
      table.setAttribute('data-active-comp', compId);
      chips.forEach(function(c){ c.classList.toggle('is-active', c === btn); });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Product Comparison Matrix",
  "tag": "section",
  "class": "cf-comparison-section",
  "settings": [
    {"type":"header","content":"Heading"},
    {"type":"text","id":"eyebrow","label":"Comparison","default":"Why us"},
    {"type":"text","id":"heading","label":"How we stack up","default":"How we stack up"},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"A side-by-side spec comparison against traditional products."},
    {"type":"header","content":"Columns"},
    {"type":"text","id":"our_col_name","label":"Our Column Name","default":"Our Product"},
    {"type":"text","id":"our_badge","label":"Our Column Badge","default":"Best choice"},
    {"type":"text","id":"comp1_name","label":"Competitor 1 Name","default":"Traditional Brands"},
    {"type":"text","id":"comp2_name","label":"Competitor 2 Name","default":"Generic Alternatives"},
    {"type":"text","id":"comp3_name","label":"Competitor 3 Name","default":""},
    {"type":"header","content":"Style override (optional)"},
    {"type":"color","id":"bg_override","label":"Background override","info":"Leave blank to inherit --color-background."}
  ],
  "blocks":[
    {"type":"feature","name":"Feature Row","settings":[
      {"type":"text","id":"title","label":"Feature name","default":"Clean formulation"},
      {"type":"header","content":"Our Brand"},
      {"type":"select","id":"our_status","label":"Check/Cross Status","default":"check","options":[
        {"value":"none","label":"None"},{"value":"check","label":"Checkmark"},{"value":"cross","label":"Cross"}
      ]},
      {"type":"text","id":"our_text","label":"Detail text","default":"100% Active"},
      {"type":"header","content":"Competitor 1"},
      {"type":"select","id":"comp1_status","label":"Check/Cross Status","default":"cross","options":[
        {"value":"none","label":"None"},{"value":"check","label":"Checkmark"},{"value":"cross","label":"Cross"}
      ]},
      {"type":"text","id":"comp1_text","label":"Detail text","default":"Diluted"},
      {"type":"header","content":"Competitor 2"},
      {"type":"select","id":"comp2_status","label":"Check/Cross Status","default":"cross","options":[
        {"value":"none","label":"None"},{"value":"check","label":"Checkmark"},{"value":"cross","label":"Cross"}
      ]},
      {"type":"text","id":"comp2_text","label":"Detail text","default":"Synthetic"},
      {"type":"header","content":"Competitor 3"},
      {"type":"select","id":"comp3_status","label":"Check/Cross Status","default":"none","options":[
        {"value":"none","label":"None"},{"value":"check","label":"Checkmark"},{"value":"cross","label":"Cross"}
      ]},
      {"type":"text","id":"comp3_text","label":"Detail text","default":""}
    ]}
  ],
  "presets":[{"name":"Product Comparison Matrix","blocks":[
    {"type":"feature","settings":{"title":"Ingredient purity","our_status":"check","our_text":"100% active","comp1_status":"cross","comp1_text":"Diluted with fillers","comp2_status":"cross","comp2_text":"Synthetic additives"}},
    {"type":"feature","settings":{"title":"Hallmark certification","our_status":"check","our_text":"Certified pure","comp1_status":"cross","comp1_text":"Uncertified","comp2_status":"cross","comp2_text":"Not guaranteed"}},
    {"type":"feature","settings":{"title":"Pricing transparency","our_status":"check","our_text":"No hidden fees","comp1_status":"check","comp1_text":"Vague","comp2_status":"cross","comp2_text":"High markups"}}
  ]}]
}
{% endschema %}
