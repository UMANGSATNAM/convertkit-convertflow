        {
          "type": "text",
          "id": "threshold",
          "label": "USP Safety Threshold",
          "default": "< 0.500 ppm"
        },
        {
          "type": "text",
          "id": "result",
          "label": "Our Lab Batch Result",
          "default": "< 0.005 ppm (Not Detected)"
        },
        {
