        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredient Transparency",
      "blocks": [
        {
          "type": "assay",
          "settings": {
            "category": "metals",
            "parameter": "Lead (Pb) Spectrometry",
            "threshold": "< 0.500 ppm (USP 232)",
            "result": "< 0.005 ppm (Not Detected)",
            "explanation": "Lead contamination in herbs typically stems from polluted groundwater. Our organic farms utilize deep aquifer drip irrigation, resulting in lead levels 100 times cleaner than standard United States Pharmacopeia (USP) safety limits."
          }
        },
        {
          "type": "assay",
          "settings": {
            "category": "metals",
            "parameter": "Inorganic Mercury (Hg)",
            "threshold": "< 0.300 ppm (USP 232)",
            "result": "< 0.002 ppm (Not Detected)",
            "explanation": "Tested using cold vapor atomic absorption spectrometry. Zero bio-accumulation detected across all marine and plant-derived excipients."
          }
        },
        {
          "type": "assay",
          "settings": {
            "category": "metals",
            "parameter": "Arsenic & Cadmium (As, Cd)",
            "threshold": "< 1.500 ppm Combined",
            "result": "< 0.010 ppm (Not Detected)",
            "explanation": "Heavy metal chelation screening confirms zero industrial agricultural pesticide runoff present in our standardized botanical extracts."
          }
        },
        {
          "type": "assay",
          "settings": {
            "category": "microbial",
            "parameter": "Total Aerobic Microbial Count",
            "threshold": "< 1,000 CFU / g",
            "result": "0 CFU / g (Sterile Assay)",
            "explanation": "Post-encapsulation microbiological screening confirms complete absence of yeast, mold, Salmonella, and E. coli pathogens prior to jar sealing."
          }
        },
        {
          "type": "assay",
          "settings": {
            "category": "potency",
            "parameter": "Elemental Magnesium (Chelated)",
            "threshold": "> 95.0% Label Claim",
            "result": "101.4% Validated Potency",
            "explanation": "High-performance liquid chromatography (HPLC) verifies that every serving delivers precisely 400mg of elemental magnesium bound to organic glycine molecules."
          }
        },
        {
          "type": "assay",
          "settings": {
            "category": "potency",
            "parameter": "Standardized Withanolides (KSM-66)",
            "threshold": "5.0% Min Concentration",
            "result": "5.32% Validated Bio-Potency",
            "explanation": "Spectrophotometric assay confirms high concentration of root-only root adaptogenic withanolides without toxic leaves or synthetic chemical extraction solvents."
          }
        }
      ]
    }
  ]
}
{% endschema %}
