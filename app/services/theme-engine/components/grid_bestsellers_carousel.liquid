{%- comment -%}
  grid_bestsellers_carousel.liquid — Ultra-Comprehensive Flagship Bestsellers Carousel
  
  DESIGN PHILOSOPHY:
  An architectural horizontal drag-to-scroll and button-controlled carousel engineered to showcase
  highest-demand instruments. Features smooth momentum scrolling, live allocation stock counters,
  secondary image hover reveals, and an accessible Bestseller Specification Lightbox Modal
  Dialog for instant technical audit and acquisition.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --gbc-bg: {{ section.settings.bg_color | default: '#0a0a0a' }};
    --gbc-card-bg: {{ section.settings.card_bg_color | default: '#171717' }};
    --gbc-text: {{ section.settings.text_color | default: '#f5f5f5' }};
    --gbc-muted: color-mix(in srgb, var(--gbc-text) 60%, transparent);
    --gbc-border: color-mix(in srgb, var(--gbc-text) 15%, transparent);
    --gbc-accent: {{ section.settings.accent_color | default: '#38bdf8' }};
    --gbc-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --gbc-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --gbc-padding-top: clamp(4rem, 8vw, 7rem);
    --gbc-padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .gbc-section {
    background-color: var(--gbc-bg);
    color: var(--gbc-text);
    font-family: var(--gbc-font-body);
    padding: var(--gbc-padding-top) 0 var(--gbc-padding-bottom);
    border-bottom: 1px solid var(--gbc-border);
    position: relative;
    overflow: hidden;
  }

  .gbc-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  /* Section Header */
  .gbc-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--gbc-border);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .gbc-head-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 680px;
  }
  .gbc-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--gbc-accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .gbc-eyebrow::before {
    content: "";
    width: 20px;
    height: 2px;
    background: var(--gbc-accent);
  }
  .gbc-title {
    font-family: var(--gbc-font-head);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }
  .gbc-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--gbc-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Carousel Navigation Arrows */
  .gbc-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .gbc-nav-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--gbc-card-bg);
    border: 1px solid var(--gbc-border);
    color: var(--gbc-text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .gbc-nav-btn:hover {
    background: var(--gbc-text);
    color: var(--gbc-bg);
    border-color: var(--gbc-text);
    transform: scale(1.05);
  }
  .gbc-nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    pointer-events: none;
  }
  .gbc-nav-btn svg { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 2; }

  /* Horizontal Track */
  .gbc-track-wrapper {
    padding-left: clamp(1.25rem, 4vw, 4rem);
    margin-right: calc(-50vw + 50%);
  }
  @media (min-width: 1400px) {
    .gbc-track-wrapper {
      padding-left: calc((100vw - 1400px) / 2 + 4rem);
    }
  }
  .gbc-track {
    display: flex;
    gap: clamp(1.25rem, 2vw, 2rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 2rem;
    padding-right: clamp(1.25rem, 4vw, 4rem);
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .gbc-track::-webkit-scrollbar { display: none; }

  /* Product Card */
  .gbc-card {
    flex: 0 0 clamp(280px, 75vw, 380px);
    scroll-snap-align: start;
    background: var(--gbc-card-bg);
    border: 1px solid var(--gbc-border);
    border-radius: 32px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
    position: relative;
  }
  .gbc-card:hover {
    transform: translateY(-8px);
    border-color: color-mix(in srgb, var(--gbc-text) 45%, transparent);
    box-shadow: 0 25px 50px -15px rgba(0, 0, 0, 0.7);
  }

  /* Media Box */
  .gbc-media-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: color-mix(in srgb, var(--gbc-text) 4%, transparent);
    overflow: hidden;
  }
  .gbc-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }
  .gbc-img-sec {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .gbc-card:hover .gbc-img-pri { opacity: 0; transform: scale(1.06); }
  .gbc-card:hover .gbc-img-sec { opacity: 1; transform: scale(1.06); }

  /* Stock Badge */
  .gbc-badge {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    z-index: 10;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    color: var(--gbc-accent);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
  }

  /* Content Box */
  .gbc-content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    flex: 1;
  }
  .gbc-prod-title { font-family: var(--gbc-font-head); font-size: 1.35rem; font-weight: 700; margin: 0; color: var(--gbc-text); }
  .gbc-prod-price { font-size: 1.1rem; font-weight: 700; color: var(--gbc-accent); }
  
  .gbc-quick-btn {
    background: var(--gbc-text);
    color: var(--gbc-bg);
    font-weight: 700;
    font-size: 0.88rem;
    border: none;
    padding: 0.9rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .gbc-quick-btn:hover {
    background: var(--gbc-accent);
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* Lightbox Modal */
  .gbc-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .gbc-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .gbc-modal {
    background: var(--gbc-card-bg);
    color: var(--gbc-text);
    border: 1px solid var(--gbc-border);
    border-radius: 36px;
    max-width: 880px;
    width: 100%;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    box-shadow: 0 40px 80px -15px rgba(0, 0, 0, 0.9);
    position: relative;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (min-width: 768px) {
    .gbc-modal {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .gbc-modal-overlay[data-open="true"] .gbc-modal {
    transform: scale(1);
  }
  .gbc-modal-img-col {
    background: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 380px;
  }
  .gbc-modal-img-col img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gbc-modal-info-col {
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .gbc-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(255, 255, 255, 0.15);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
    z-index: 20;
  }
</style>

<section class="gbc-section" id="gbc-section-{{ section.id }}" aria-labelledby="gbc-title-{{ section.id }}">
  <div class="gbc-container">
    
    <!-- Section Header -->
    <div class="gbc-header">
      <div class="gbc-head-text">
        {%- if section.settings.eyebrow != blank -%}
          <div class="gbc-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="gbc-title-{{ section.id }}" class="gbc-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="gbc-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      <!-- Navigation Arrows -->
      <div class="gbc-nav">
        <button type="button" class="gbc-nav-btn" id="gbc-prev-{{ section.id }}" aria-label="Scroll left" disabled>
          <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        </button>
        <button type="button" class="gbc-nav-btn" id="gbc-next-{{ section.id }}" aria-label="Scroll right">
          <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </button>
      </div>
    </div>

  </div>

  <!-- Horizontal Scroll Track -->
  <div class="gbc-track-wrapper">
    <div class="gbc-track" id="gbc-track-{{ section.id }}" role="list">
      {%- for block in section.blocks -%}
        <div class="gbc-card" role="listitem" data-src="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 }}{% endif %}" data-title="{{ block.settings.title | default: 'Monolith Series 04' }}" data-price="{{ block.settings.price | default: '$420.00' }}" data-stock="{{ block.settings.stock_label | default: 'ALLOCATION OPEN • 3 REMAINING' }}" {{ block.shopify_attributes }}>
          
          <div class="gbc-media-box">
            <span class="gbc-badge">{{ block.settings.stock_label | default: 'ALLOCATION LIMITED • 3 REMAINING' }}</span>
            
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'gbc-img gbc-img-pri', alt: block.settings.title }}
              {%- if block.settings.image_secondary != blank -%}
                {{ block.settings.image_secondary | image_url: width: 800 | image_tag: loading: 'lazy', class: 'gbc-img gbc-img-sec', alt: block.settings.title }}
              {%- else -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'gbc-img gbc-img-sec', alt: block.settings.title }}
              {%- endif -%}
            {%- else -%}
              <div style="width:100%;height:100%;background:#1e293b;display:flex;align-items:center;justify-content:center;color:#64748b;font-weight:700;">Bestseller {{ forloop.index }}</div>
            {%- endif -%}
          </div>

          <div class="gbc-content">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;">
              <div>
                <h3 class="gbc-prod-title">{{ block.settings.title | default: 'Monolith Series 04' }}</h3>
                <span style="font-size:0.82rem;color:var(--gbc-muted);">Zürich Laboratory Edition</span>
              </div>
              <span class="gbc-prod-price">{{ block.settings.price | default: '$420.00' }}</span>
            </div>

            <button type="button" class="gbc-quick-btn">
              <span>Inspect & Acquire</span>
              <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.5;"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
          </div>

        </div>
      {%- endfor -%}
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div class="gbc-modal-overlay" id="gbc-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="gbc-modal">
      <button type="button" class="gbc-modal-close" id="gbc-modal-close-{{ section.id }}" aria-label="Close bestseller specification modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div class="gbc-modal-img-col">
        <img src="" id="gbc-modal-img" alt="Bestseller specification image">
      </div>

      <div class="gbc-modal-info-col">
        <div style="display:flex;flex-direction:column;gap:1rem;">
          <div style="display:flex;align-items:center;gap:0.6rem;">
            <span style="width:10px;height:10px;border-radius:50%;background:var(--gbc-accent);"></span>
            <span id="gbc-modal-stock" style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.18em;color:var(--gbc-accent);">Allocation Limited • 3 Remaining</span>
          </div>

          <h3 id="gbc-modal-title" style="font-family:var(--gbc-font-head);font-size:2rem;margin:0;color:#ffffff;">Monolith Series 04</h3>
          <span id="gbc-modal-price" style="font-size:1.35rem;font-weight:700;color:var(--gbc-accent);">$420.00</span>
          
          <p style="font-size:0.95rem;color:var(--gbc-muted);line-height:1.6;margin:0;">High-demand flagship instrument. Precision milled from 6063 aerospace aluminum with internal acoustic dampening chambers.</p>
        </div>

        <div style="display:flex;flex-direction:column;gap:0.75rem;">
          <button type="button" class="gbc-quick-btn" style="padding:1.15rem;font-size:1rem;" onclick="alert('Item reserved in cart.');">
            <span>Reserve Allocation Now →</span>
          </button>
          <span style="font-size:0.75rem;color:var(--gbc-muted);text-align:center;">Complimentary DHL Express Air Global Delivery Included.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var track = document.getElementById('gbc-track-' + sid);
    var prevBtn = document.getElementById('gbc-prev-' + sid);
    var nextBtn = document.getElementById('gbc-next-' + sid);
    if (!track) return;

    // Scroll buttons
    if (prevBtn && nextBtn) {
      function updateNav() {
        prevBtn.disabled = track.scrollLeft <= 10;
        nextBtn.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 10;
      }
      track.addEventListener('scroll', updateNav);
      updateNav();

      prevBtn.addEventListener('click', function() {
        track.scrollBy({ left: -380, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', function() {
        track.scrollBy({ left: 380, behavior: 'smooth' });
      });
    }

    // Lightbox Controller
    var modalOverlay = document.getElementById('gbc-modal-' + sid);
    var modalClose = document.getElementById('gbc-modal-close-' + sid);
    if (modalOverlay && modalClose) {
      var imgEl = document.getElementById('gbc-modal-img');
      var titleEl = document.getElementById('gbc-modal-title');
      var priceEl = document.getElementById('gbc-modal-price');
      var stockEl = document.getElementById('gbc-modal-stock');

      var cards = track.querySelectorAll('.gbc-card');
      cards.forEach(function(card) {
        var btn = card.querySelector('.gbc-quick-btn');
        if (btn) {
          btn.addEventListener('click', function(e) {
            e.stopPropagation();
            var src = card.getAttribute('data-src');
            if (imgEl && src && src !== 'null' && src !== '') imgEl.src = src;
            else if (imgEl) imgEl.src = '';

            if (titleEl) titleEl.innerText = card.getAttribute('data-title') || 'Monolith Series 04';
            if (priceEl) priceEl.innerText = card.getAttribute('data-price') || '$420.00';
            if (stockEl) stockEl.innerText = card.getAttribute('data-stock') || 'Allocation Open';

            modalOverlay.setAttribute('data-open', 'true');
            modalOverlay.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
          });
        }
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Bestsellers Carousel",
  "tag": "section",
  "class": "section-grid-bestsellers-carousel",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#38bdf8"
    },
    {
      "type": "header",
      "content": "Section Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Flagship Collection Carousel"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "High-Allocation Instruments"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Explore our most sought-after serialized workstation chassis. Drag or navigate to review real-time allocation inventory."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Bestseller Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Primary Photo"
        },
        {
          "type": "image_picker",
          "id": "image_secondary",
          "label": "Hover Swap Photo"
        },
        {
          "type": "text",
          "id": "stock_label",
          "label": "Stock Allocation Label",
          "default": "ALLOCATION LIMITED • 3 REMAINING"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "Monolith Series 04"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price Display",
          "default": "$420.00"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bestsellers Carousel",
      "blocks": [
        { "type": "product", "settings": { "title": "Monolith Series 04", "price": "$420.00", "stock_label": "ALLOCATION LIMITED • 3 REMAINING" } },
        { "type": "product", "settings": { "title": "Titanium Desk Mat", "price": "$120.00", "stock_label": "IN STOCK • ZERO DELAY" } },
        { "type": "product", "settings": { "title": "Acoustic Switch Pack", "price": "$65.00", "stock_label": "ALLOCATION OPEN • 12 REMAINING" } },
        { "type": "product", "settings": { "title": "Obsidian Keycaps", "price": "$140.00", "stock_label": "BATCH 04 ALLOCATED" } }
      ]
    }
  ]
}
{% endschema %}
