{%- comment -%}
  content_rich_text.liquid — Ultra-Comprehensive Editorial Manifesto & Rich Text
  
  DESIGN PHILOSOPHY:
  An architectural editorial engine designed for deep storytelling, technical manifestos,
  and brand essays. Features an automated scroll reading progress bar, drop-cap typography,
  interactive pull-quote callouts, expandable footnote references, and an integrated one-click
  clipboard article share bar. Engineered for flawless readability and typography hierarchy.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --crt-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --crt-card-bg: {{ section.settings.card_bg_color | default: '#f8fafc' }};
    --crt-text: {{ section.settings.text_color | default: '#0f172a' }};
    --crt-muted: color-mix(in srgb, var(--crt-text) 65%, transparent);
    --crt-border: color-mix(in srgb, var(--crt-text) 14%, transparent);
    --crt-accent: {{ section.settings.accent_color | default: '#0f172a' }};
    --crt-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --crt-font-head: var(--font-heading, 'Playfair Display', serif);
    --crt-padding-top: clamp(4rem, 8vw, 7rem);
    --crt-padding-bottom: clamp(4rem, 8vw, 7rem);
    --crt-max-width: {{ section.settings.max_width | default: '820px' }};
  }

  .crt-section {
    background-color: var(--crt-bg);
    color: var(--crt-text);
    font-family: var(--crt-font-body);
    padding: var(--crt-padding-top) clamp(1.25rem, 4vw, 4rem) var(--crt-padding-bottom);
    border-bottom: 1px solid var(--crt-border);
    position: relative;
  }

  /* Reading Progress Top Bar */
  .crt-progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 4px;
    background: var(--crt-accent);
    width: 0%;
    z-index: 50;
    transition: width 0.1s ease;
  }

  .crt-container {
    max-width: var(--crt-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  /* Editorial Header */
  .crt-header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    text-align: {{ section.settings.text_alignment | default: 'center' }};
    align-items: {% if section.settings.text_alignment == 'left' %}flex-start{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}center{% endif %};
    border-bottom: 1px solid var(--crt-border);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }
  .crt-eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--crt-accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .crt-eyebrow::before {
    content: "";
    width: 24px;
    height: 1px;
    background: var(--crt-accent);
  }
  .crt-title {
    font-family: var(--crt-font-head);
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.1;
    margin: 0;
  }
  .crt-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.85rem;
    color: var(--crt-muted);
    font-weight: 600;
  }

  /* Editorial Body Content */
  .crt-body {
    display: flex;
    flex-direction: column;
    gap: 1.85rem;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.8;
    color: var(--crt-text);
  }
  .crt-body p {
    margin: 0;
  }
  /* Optional Drop Cap */
  .crt-body[data-dropcap="true"] p:first-of-type::first-letter {
    font-family: var(--crt-font-head);
    font-size: 4.5em;
    float: left;
    line-height: 0.8;
    margin-right: 0.15em;
    margin-bottom: -0.1em;
    color: var(--crt-accent);
    font-weight: 700;
  }

  /* Pull-Quote Callout Block */
  .crt-pullquote {
    background: var(--crt-card-bg);
    border-left: 4px solid var(--crt-accent);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: 0 20px 20px 0;
    margin: 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
  }
  .crt-pullquote-quote {
    font-family: var(--crt-font-head);
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-style: italic;
    line-height: 1.35;
    margin: 0;
    color: var(--crt-text);
  }
  .crt-pullquote-author {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--crt-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* Footnote Reference Box */
  .crt-footnotes {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--crt-border);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .crt-fn-title {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--crt-muted);
  }
  .crt-fn-list {
    list-style: decimal;
    padding-left: 1.5rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.88rem;
    color: var(--crt-muted);
  }

  /* Article Action & Social Share Bar */
  .crt-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 2rem;
    background: var(--crt-card-bg);
    border: 1px solid var(--crt-border);
    border-radius: 100px;
    margin-top: 1rem;
  }
  .crt-share-label {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--crt-text);
  }
  .crt-share-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .crt-share-btn {
    background: var(--crt-bg);
    color: var(--crt-text);
    border: 1px solid var(--crt-border);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.5rem 1.15rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
  }
  .crt-share-btn:hover {
    background: var(--crt-accent);
    color: #ffffff;
    border-color: var(--crt-accent);
    transform: translateY(-2px);
  }
  .crt-share-btn svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }
</style>

<section class="crt-section" id="crt-section-{{ section.id }}" aria-labelledby="crt-title-{{ section.id }}">
  <div class="crt-progress-bar" id="crt-prog-{{ section.id }}" aria-hidden="true"></div>

  <div class="crt-container">
    
    <!-- Editorial Header -->
    <div class="crt-header">
      {%- if section.settings.eyebrow != blank -%}
        <div class="crt-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h1 id="crt-title-{{ section.id }}" class="crt-title">{{ section.settings.title }}</h1>
      {%- endif -%}

      <div class="crt-meta">
        <span>By {{ section.settings.author | default: 'Dr. Marcus Vance' }}</span>
        <span>•</span>
        <span>{{ section.settings.read_time | default: '4 Min Technical Read' }}</span>
        <span>•</span>
        <span>Published {{ section.settings.pub_date | default: 'October 2026' }}</span>
      </div>
    </div>

    <!-- Rich Text Body -->
    <div class="crt-body" data-dropcap="{% if section.settings.show_dropcap %}true{% else %}false{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'paragraph' -%}
            <div class="crt-para" {{ block.shopify_attributes }}>
              {{ block.settings.content }}
            </div>

          {%- when 'pullquote' -%}
            <blockquote class="crt-pullquote" {{ block.shopify_attributes }}>
              <p class="crt-pullquote-quote">"{{ block.settings.quote }}"</p>
              {%- if block.settings.author != blank -%}
                <cite class="crt-pullquote-author">— {{ block.settings.author }}</cite>
              {%- endif -%}
            </blockquote>

          {%- when 'button' -%}
            <div style="margin: 1rem 0; text-align: {{ section.settings.text_alignment | default: 'center' }};" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.btn_link | default: '/collections/all' }}" style="background:var(--crt-accent);color:#ffffff;font-weight:700;font-size:0.95rem;text-decoration:none;padding:1.1rem 2.5rem;border-radius:100px;display:inline-block;transition:all 0.25s ease;box-shadow:0 15px 30px -5px rgba(0,0,0,0.15);">
                {{ block.settings.btn_label }} →
              </a>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <!-- Footnote References -->
    {%- if section.settings.show_footnotes -%}
      <div class="crt-footnotes">
        <span class="crt-fn-title">Technical Citations & References</span>
        <ol class="crt-fn-list">
          <li>Vance, M. (2025). "Acoustic Damping and Mechanical Resilience in Aluminum Workstation Bezel Architecture." Swiss Journal of Industrial Design, 14(3), 88-104.</li>
          <li>Rostova, E. & Sterling, J. (2026). "Ergonomic Strain Reduction in 14-Hour Research and Editorial Environments." European Ergonomics Archive.</li>
        </ol>
      </div>
    {%- endif -%}

    <!-- Article Share Bar -->
    <div class="crt-actions">
      <span class="crt-share-label">Share This Manifesto</span>
      <div class="crt-share-btns">
        <button type="button" class="crt-share-btn" id="crt-copy-btn-{{ section.id }}" aria-label="Copy article link to clipboard">
          <svg viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"></path></svg>
          <span id="crt-copy-txt-{{ section.id }}">Copy Link</span>
        </button>
        <a href="https://twitter.com/intent/tweet?text={{ section.settings.title | url_encode }}&url={{ request.origin }}{{ request.path }}" target="_blank" rel="noopener noreferrer" class="crt-share-btn">Twitter</a>
        <a href="https://www.linkedin.com/shareArticle?mini=true&url={{ request.origin }}{{ request.path }}&title={{ section.settings.title | url_encode }}" target="_blank" rel="noopener noreferrer" class="crt-share-btn">LinkedIn</a>
      </div>
    </div>

  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('crt-section-' + sid);
    if (!sectionEl) return;

    // 1. Reading Progress Bar Controller
    var progBar = document.getElementById('crt-prog-' + sid);
    if (progBar) {
      window.addEventListener('scroll', function() {
        var rect = sectionEl.getBoundingClientRect();
        var totalHeight = rect.height - window.innerHeight;
        if (totalHeight <= 0) return;

        var scrolled = -rect.top;
        var pct = Math.min(Math.max((scrolled / totalHeight) * 100, 0), 100);
        progBar.style.width = pct + '%';
      }, { passive: true });
    }

    // 2. Clipboard Link Copy Controller
    var copyBtn = document.getElementById('crt-copy-btn-' + sid);
    var copyTxt = document.getElementById('crt-copy-txt-' + sid);
    if (copyBtn && copyTxt) {
      copyBtn.addEventListener('click', function() {
        var url = window.location.href;
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url);
          copyTxt.innerText = 'Copied! ✓';
          copyBtn.style.background = '#10b981';
          copyBtn.style.color = '#ffffff';
          copyBtn.style.borderColor = '#10b981';
          setTimeout(function() {
            copyTxt.innerText = 'Copy Link';
            copyBtn.style.background = '';
            copyBtn.style.color = '';
            copyBtn.style.borderColor = '';
          }, 2500);
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Editorial Rich Text",
  "tag": "section",
  "class": "section-content-rich-text",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
