{%- comment -%}
  faq_bold_1.liquid — Bold / Streetwear FAQ
  
  In-your-face FAQ with numbered items, heavy borders,
  and monospace type. Built for drop culture.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --bdfq-bg: var(--color-background, #0a0a0a);
    --bdfq-text: var(--color-text, #fff);
    --bdfq-accent: var(--color-accent, #ff3c00);
    --bdfq-muted: color-mix(in srgb, var(--bdfq-text) 50%, transparent);
    --bdfq-border: color-mix(in srgb, var(--bdfq-text) 15%, transparent);
    --bdfq-font: var(--font-body, 'Roboto Mono', monospace);
    --bdfq-font-heading: var(--font-heading, 'Anton', sans-serif);
  }

  .bd-faq {
    background: var(--bdfq-bg);
    padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 4vw, 3rem);
    border-top: 4px solid var(--bdfq-accent);
  }

  .bd-faq__inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .bd-faq__heading {
    font-family: var(--bdfq-font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    text-transform: uppercase;
    color: var(--bdfq-text);
    margin: 0 0 2.5rem 0;
    line-height: 1.1;
  }
  .bd-faq__heading span {
    color: var(--bdfq-accent);
  }

  .bd-faq__item {
    border-bottom: 2px solid var(--bdfq-border);
  }
  .bd-faq__item summary {
    font-family: var(--bdfq-font);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--bdfq-text);
    cursor: pointer;
    padding: 1.25rem 0;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: color 0.2s ease;
  }
  .bd-faq__item summary::-webkit-details-marker { display: none; }
  .bd-faq__item summary:hover {
    color: var(--bdfq-accent);
  }

  .bd-faq__num {
    font-family: var(--bdfq-font-heading);
    font-size: 1.5rem;
    color: var(--bdfq-accent);
    min-width: 2rem;
    flex-shrink: 0;
  }

  .bd-faq__toggle {
    margin-left: auto;
    font-size: 1.25rem;
    color: var(--bdfq-muted);
    transition: transform 0.3s ease;
  }
  .bd-faq__item[open] .bd-faq__toggle {
    transform: rotate(45deg);
    color: var(--bdfq-accent);
  }

  .bd-faq__answer {
    font-family: var(--bdfq-font);
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--bdfq-muted);
    padding: 0 0 1.25rem 3rem;
  }

  .bd-faq__cta {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 2px solid var(--bdfq-border);
    text-align: center;
  }
  .bd-faq__cta-btn {
    display: inline-block;
    font-family: var(--bdfq-font);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--bdfq-bg);
    background: var(--bdfq-accent);
    border: 2px solid var(--bdfq-accent);
    text-decoration: none;
    padding: 0.8rem 2rem;
    transition: background 0.2s, color 0.2s;
  }
  .bd-faq__cta-btn:hover {
    background: transparent;
    color: var(--bdfq-accent);
  }
</style>

<section class="bd-faq">
  <div class="bd-faq__inner">

    <h2 class="bd-faq__heading">
      {{ section.settings.heading_before | default: 'Got' }}
      <span>{{ section.settings.heading_accent | default: 'Questions' }}</span>?
    </h2>

    {%- for block in section.blocks -%}
      <details class="bd-faq__item" {{ block.shopify_attributes }}>
        <summary>
          <span class="bd-faq__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {{ block.settings.question }}
          <span class="bd-faq__toggle" aria-hidden="true">+</span>
        </summary>
        <div class="bd-faq__answer">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}

    {%- if section.settings.show_cta -%}
      <div class="bd-faq__cta">
        <a href="{{ section.settings.cta_url | default: '/pages/contact' }}" class="bd-faq__cta-btn">
          {{ section.settings.cta_text | default: 'Hit us up →' }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Bold FAQ",
  "tag": "section",
  "class": "section-faq-bold",
  "settings": [
    {
      "type": "text",
      "id": "heading_before",
      "label": "Heading (Before Accent)",
      "default": "Got"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading (Accent Word)",
      "default": "Questions"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show Contact CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Hit us up →"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Link"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "When's the next drop?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Follow us on social for early access announcements. Drops usually go live at 12pm EST.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bold FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "When's the next drop?", "answer": "<p>Follow us on social for early access. Drops go live at 12pm EST.</p>" } },
        { "type": "question", "settings": { "question": "Do you do exchanges?", "answer": "<p>Yeah, within 14 days. Hit up support with your order number.</p>" } },
        { "type": "question", "settings": { "question": "How fast is shipping?", "answer": "<p>Most orders ship same day. Domestic delivery is 3-5 business days.</p>" } }
      ]
    }
  ]
}
{% endschema %}
