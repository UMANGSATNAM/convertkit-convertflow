{% comment %} Hero Luxury Editorial — Full-screen dark hero with GSAP text reveal, gold accents {% endcomment %}

<section class="sf-lux sf-hero-editorial sf-hle-{{ section.id }}" id="sf-hero-{{ section.id }}">

  {%- comment -%} Background layer {%- endcomment -%}
  <div class="sf-hle-bg">
    {% if section.settings.bg_video_url != blank %}
      <video class="sf-hle-video" autoplay muted loop playsinline>
        <source src="{{ section.settings.bg_video_url }}">
      </video>
    {% elsif section.settings.bg_image != blank %}
      <img src="{{ section.settings.bg_image | img_url: 'master' }}" alt="{{ section.settings.title }}" loading="eager" fetchpriority="high">
    {% else %}
      <div class="sf-hle-gradient-bg"></div>
    {% endif %}
    <div class="sf-hle-overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  </div>

  {%- comment -%} Decorative gold lines {%- endcomment -%}
  <div class="sf-hle-deco-left"></div>
  <div class="sf-hle-deco-right"></div>

  {%- comment -%} Content {%- endcomment -%}
  <div class="sf-hle-content sf-hle-align-{{ section.settings.content_align }}">
    {% if section.settings.eyebrow != blank %}
      <p class="sf-hle-eyebrow" id="sf-hle-eyebrow-{{ section.id }}">
        <span class="sf-hle-eyebrow-line"></span>
        {{ section.settings.eyebrow }}
        <span class="sf-hle-eyebrow-line"></span>
      </p>
    {% endif %}

    <h1 class="sf-hle-title" id="sf-hle-title-{{ section.id }}">
      {{ section.settings.title | newline_to_br }}
    </h1>

    {% if section.settings.subtitle != blank %}
      <p class="sf-hle-subtitle" id="sf-hle-sub-{{ section.id }}">{{ section.settings.subtitle }}</p>
    {% endif %}

    <div class="sf-hle-cta-row" id="sf-hle-cta-{{ section.id }}">
      {% if section.settings.btn1_label != blank %}
        <a href="{{ section.settings.btn1_link }}" class="sf-btn-gold">
          <span>{{ section.settings.btn1_label }}</span>
          <svg width="16" height="8" viewBox="0 0 16 8" fill="none" style="position:relative;z-index:1">
            <path d="M0 4H14M14 4L10 1M14 4L10 7" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </a>
      {% endif %}
      {% if section.settings.btn2_label != blank %}
        <a href="{{ section.settings.btn2_link }}" class="sf-btn-ghost">
          {{ section.settings.btn2_label }}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M1 13L13 1M13 1H4M13 1V10" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>

  {%- comment -%} Scroll indicator {%- endcomment -%}
  <div class="sf-hle-scroll-indicator" id="sf-hle-scroll-{{ section.id }}">
    <span class="sf-hle-scroll-text">Scroll</span>
    <div class="sf-hle-scroll-line"><div class="sf-hle-scroll-dot"></div></div>
  </div>

  {%- comment -%} Corner badge (optional) {%- endcomment -%}
  {% if section.settings.badge_text != blank %}
    <div class="sf-hle-badge">
      <span>{{ section.settings.badge_text }}</span>
    </div>
  {% endif %}

</section>

<style>
  .sf-hle-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.height_vh }}vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--color-background);
  }

  /* Background */
  .sf-hle-bg { position: absolute; inset: 0; }
  .sf-hle-video, .sf-hle-bg > img { width: 100%; height: 100%; object-fit: cover; }
  .sf-hle-gradient-bg {
    width: 100%; height: 100%;
    background: radial-gradient(ellipse 80% 80% at 20% 50%, var(--color-text) 0%, var(--color-background) 60%),
                linear-gradient(135deg, var(--color-text) 0%, var(--color-text) 50%, var(--color-text) 100%);
  }
  .sf-hle-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(160deg, color-mix(in srgb, var(--color-text) 40%, transparent) 0%, color-mix(in srgb, var(--color-text) 85%, transparent) 100%);
  }

  /* Gold decorative vertical lines */
  .sf-hle-deco-left, .sf-hle-deco-right {
    position: absolute; top: 0; bottom: 0; width: 1px;
    background: linear-gradient(180deg, transparent 0%, var(--color-accent) 30%, var(--color-accent) 70%, transparent 100%);
    opacity: 0.15;
  }
  .sf-hle-deco-left { left: 60px; }
  .sf-hle-deco-right { right: 60px; }
  @media (max-width: 768px) { .sf-hle-deco-left { left: 20px; } .sf-hle-deco-right { right: 20px; } }

  /* Content layout */
  .sf-hle-content {
    position: relative; z-index: 2;
    width: 100%; max-width: 1200px;
    padding: 0 80px;
  }
  .sf-hle-align-center { text-align: center; }
  .sf-hle-align-left { text-align: left; }
  @media (max-width: 768px) { .sf-hle-content { padding: 0 24px; } }

  /* Eyebrow */
  .sf-hle-eyebrow {
    display: flex; align-items: center; gap: 12px;
    font-size: 0.65rem; font-weight: 500; letter-spacing: 0.3em;
    text-transform: uppercase; color: var(--color-accent);
    margin-bottom: 1.5rem;
    opacity: 0; animation: sfHleEyebrowIn 1s var(--transition-base) 0.3s forwards;
  }
  .sf-hle-align-center .sf-hle-eyebrow { justify-content: center; }
  .sf-hle-eyebrow-line {
    display: block; flex: none; width: 32px; height: 1px; background: var(--color-accent); opacity: 0.6;
  }

  /* Title */
  .sf-hle-title {
    font-family: var(--font-heading); font-weight: 400;
    font-size: clamp(2.8rem, 6vw, 5.5rem);
    line-height: 1.1; letter-spacing: -0.01em;
    color: var(--color-surface);
    margin-bottom: 1.5rem;
    clip-path: inset(0 0 0 0);
    opacity: 0; animation: sfHleTitleIn 1.2s var(--transition-base) 0.5s forwards;
  }
  .sf-hle-title em { font-style: italic; color: var(--color-accent); }

  /* Subtitle */
  .sf-hle-subtitle {
    font-family: var(--font-body); font-weight: 300;
    font-size: clamp(0.9rem, 1.5vw, 1.1rem);
    line-height: 1.7; color: color-mix(in srgb, var(--color-surface) 65%, transparent);
    max-width: 520px; margin-bottom: 2.5rem;
    opacity: 0; animation: sfHleSubIn 1s var(--transition-base) 0.7s forwards;
  }
  .sf-hle-align-center .sf-hle-subtitle { margin-left: auto; margin-right: auto; }

  /* CTA Row */
  .sf-hle-cta-row {
    display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: center;
    opacity: 0; animation: sfHleCtaIn 1s var(--transition-base) 0.9s forwards;
  }
  .sf-hle-align-center .sf-hle-cta-row { justify-content: center; }

  /* Scroll indicator */
  .sf-hle-scroll-indicator {
    position: absolute; bottom: 2.5rem; left: 50%; transform: translateX(-50%);
    z-index: 3; display: flex; flex-direction: column; align-items: center; gap: 10px;
    opacity: 0; animation: sfHleScrollIn 1s var(--transition-base) 1.4s forwards;
  }
  .sf-hle-scroll-text {
    font-size: 0.6rem; letter-spacing: 0.25em; text-transform: uppercase;
    color: color-mix(in srgb, var(--color-accent) 60%, transparent); writing-mode: horizontal-tb;
  }
  .sf-hle-scroll-line {
    width: 1px; height: 48px; background: color-mix(in srgb, var(--color-accent) 20%, transparent);
    position: relative; overflow: hidden;
  }
  .sf-hle-scroll-dot {
    position: absolute; top: -6px; left: -1px; width: 3px; height: 12px;
    background: var(--color-accent); border-radius: 2px;
    animation: sfScrollDrop 1.8s ease-in-out infinite;
  }

  /* Corner badge */
  .sf-hle-badge {
    position: absolute; top: 40px; right: 80px; z-index: 3;
    width: 80px; height: 80px; border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 0.58rem; font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-accent); text-align: center;
    animation: sfRotate 20s linear infinite;
  }
  @media (max-width: 768px) { .sf-hle-badge { top: 20px; right: 20px; width: 60px; height: 60px; } }

  /* Keyframes */
  @keyframes sfHleEyebrowIn { to { opacity: 1; } }
  @keyframes sfHleTitleIn { to { opacity: 1; } }
  @keyframes sfHleSubIn { to { opacity: 1; } }
  @keyframes sfHleCtaIn { to { opacity: 1; } }
  @keyframes sfHleScrollIn { to { opacity: 1; } }
  @keyframes sfScrollDrop { 0%,100% { transform: translateY(-6px); opacity: 0; } 50% { opacity: 1; } 100% { transform: translateY(54px); opacity: 0; } }
  @keyframes sfRotate { to { transform: rotate(360deg); } }
</style>

{% schema %}
{
  "name": "Hero — Luxury Editorial",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "text", "id": "bg_video_url", "label": "Background Video URL (.mp4)" },
    { "type": "range", "id": "overlay_opacity", "min": 30, "max": 95, "step": 5, "label": "Overlay Darkness", "default": 60 },
    { "type": "range", "id": "height_vh", "min": 70, "max": 100, "step": 5, "label": "Height (vh)", "default": 100 },
    { "type": "header", "content": "Content" },
    { "type": "select", "id": "content_align", "label": "Alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"}], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Label", "default": "New Collection 2025" },
    { "type": "textarea", "id": "title", "label": "Title (use line breaks)", "default": "Crafted For\nEternity" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Handcrafted jewellery for the ones who define their own legacy." },
    { "type": "text", "id": "badge_text", "label": "Corner Badge Text", "default": "BIS\nHallmarked" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "btn1_label", "label": "Primary Button", "default": "Shop Collection" },
    { "type": "url", "id": "btn1_link", "label": "Primary Link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary Button", "default": "Our Story" },
    { "type": "url", "id": "btn2_link", "label": "Secondary Link" }
  ],
  "presets": [{ "name": "Hero — Luxury Editorial", "category": "Hero" }]
}
{% endschema %}
