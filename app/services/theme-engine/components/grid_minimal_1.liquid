{%- comment -%}
  grid_minimal_1.liquid — Minimalist Editorial Grid
  
  DESIGN PHILOSOPHY:
  Distraction-free grid system with generous breathing room.
  Supports products, collections, or custom promo banners with
  subtle image zoom on hover and clean typography.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --mng-bg: var(--color-background, #fff);
    --mng-text: var(--color-text, #1a1a1a);
    --mng-muted: color-mix(in srgb, var(--mng-text) 50%, transparent);
    --mng-border: color-mix(in srgb, var(--mng-text) 8%, transparent);
    --mng-font: var(--font-body, 'Helvetica Neue', -apple-system, sans-serif);
  }

  .mng-section {
    background: var(--mng-bg);
    padding: clamp(3rem, 7vw, 6rem) clamp(1.25rem, 4vw, 3.5rem);
  }

  .mng-inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  .mng-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--mng-border);
    padding-bottom: 1.25rem;
  }
  .mng-title {
    font-family: var(--font-heading, var(--mng-font));
    font-size: clamp(1.35rem, 2.5vw, 2rem);
    font-weight: 400;
    color: var(--mng-text);
    margin: 0;
  }
  .mng-link {
    font-family: var(--mng-font);
    font-size: 0.8rem;
    color: var(--mng-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .mng-link:hover {
    color: var(--mng-text);
  }

  .mng-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (min-width: 640px) {
    .mng-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .mng-grid[data-cols="3"] { grid-template-columns: repeat(3, 1fr); }
    .mng-grid[data-cols="4"] { grid-template-columns: repeat(4, 1fr); }
  }

  .mng-item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--mng-text);
    group: mng-card;
  }

  .mng-media {
    aspect-ratio: var(--aspect, 4/5);
    background: color-mix(in srgb, var(--mng-text) 3%, transparent);
    overflow: hidden;
    position: relative;
    margin-bottom: 1rem;
  }
  .mng-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mng-item:hover .mng-media img {
    transform: scale(1.05);
  }

  .mng-meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }
  .mng-item-title {
    font-family: var(--mng-font);
    font-size: 0.9rem;
    font-weight: 400;
    margin: 0;
  }
  .mng-item-sub {
    font-family: var(--mng-font);
    font-size: 0.8rem;
    color: var(--mng-muted);
    margin: 0.2rem 0 0 0;
  }
  .mng-item-price {
    font-family: var(--mng-font);
    font-size: 0.9rem;
    font-weight: 500;
  }
</style>

<section class="mng-section" aria-label="{{ section.settings.title | default: 'Editorial Grid' }}">
  <div class="mng-inner">
    {%- if section.settings.title != blank or section.settings.cta_text != blank -%}
      <div class="mng-header">
        <h2 class="mng-title">{{ section.settings.title }}</h2>
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="mng-link">{{ section.settings.cta_text }} →</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="mng-grid" data-cols="{{ section.settings.columns | default: '3' }}" style="--aspect: {{ section.settings.aspect_ratio | default: '4/5' }};">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.url | default: '#' }}" class="mng-item" {{ block.shopify_attributes }}>
          <div class="mng-media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- else -%}
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--mng-muted); font-size: 0.8rem;">
                {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
          <div class="mng-meta">
            <div>
              <h3 class="mng-item-title">{{ block.settings.title | default: 'Item Title' }}</h3>
              {%- if block.settings.subtitle != blank -%}
                <p class="mng-item-sub">{{ block.settings.subtitle }}</p>
              {%- endif -%}
            </div>
            {%- if block.settings.price != blank -%}
              <span class="mng-item-price">{{ block.settings.price }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Minimal Grid",
  "tag": "section",
  "class": "section-grid-minimal",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Selected Works"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Link Text",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link URL"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Desktop Columns",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "3/4", "label": "Tall (3:4)" },
        { "value": "16/9", "label": "Landscape (16:9)" }
      ],
      "default": "4/5"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Grid Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Minimalist Ceramic Vessel" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Handmade in Kyoto" },
        { "type": "text", "id": "price", "label": "Price / Meta", "default": "$120" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Minimal Grid",
      "blocks": [
        { "type": "item", "settings": { "title": "Ceramic Vessel No. 1", "subtitle": "Matte White Finish", "price": "$120" } },
        { "type": "item", "settings": { "title": "Stoneware Plate Set", "subtitle": "Set of 4", "price": "$85" } },
        { "type": "item", "settings": { "title": "Oak Serving Tray", "subtitle": "Natural Grain", "price": "$140" } }
      ]
    }
  ]
}
{% endschema %}
