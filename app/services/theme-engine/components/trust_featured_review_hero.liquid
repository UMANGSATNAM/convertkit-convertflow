{%- comment -%}
  trust_featured_review_hero.liquid — Ultra-Comprehensive Editorial Testimonial Showcase
  
  DESIGN PHILOSOPHY:
  A high-authority editorial review showcase designed to build immense trust and social proof.
  Features a giant animated quotation mark, dynamic review thumbnail switcher with smooth
  fade transitions, verified buyer credibility badges, product recommendation tags, and an
  accessible inspection modal dialog to view the full verification details.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --tfr-bg: {{ section.settings.bg_color | default: '#0f172a' }};
    --tfr-card-bg: {{ section.settings.card_bg_color | default: '#1e293b' }};
    --tfr-text: {{ section.settings.text_color | default: '#f8fafc' }};
    --tfr-muted: color-mix(in srgb, var(--tfr-text) 65%, transparent);
    --tfr-border: color-mix(in srgb, var(--tfr-text) 14%, transparent);
    --tfr-accent: {{ section.settings.accent_color | default: '#facc15' }};
    --tfr-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --tfr-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --tfr-padding-top: clamp(4rem, 8vw, 7rem);
    --tfr-padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .tfr-section {
    background-color: var(--tfr-bg);
    color: var(--tfr-text);
    font-family: var(--tfr-font-body);
    padding: var(--tfr-padding-top) clamp(1.25rem, 4vw, 4rem) var(--tfr-padding-bottom);
    border-top: 1px solid var(--tfr-border);
    border-bottom: 1px solid var(--tfr-border);
    position: relative;
    overflow: hidden;
  }

  .tfr-container {
    max-width: 1360px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* Eyebrow Callout */
  .tfr-eyebrow-wrap {
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .tfr-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--tfr-accent);
    background: color-mix(in srgb, var(--tfr-accent) 12%, transparent);
    padding: 0.45rem 1.25rem;
    border-radius: 100px;
    border: 1px solid color-mix(in srgb, var(--tfr-accent) 30%, transparent);
  }

  /* Main Editorial Display */
  .tfr-hero-card {
    background: var(--tfr-card-bg);
    border: 1px solid var(--tfr-border);
    border-radius: 32px;
    padding: clamp(2.5rem, 6vw, 5rem);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.4);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }
  .tfr-hero-card[data-transitioning="true"] {
    opacity: 0.2;
    transform: scale(0.98);
  }

  /* Giant Quote Mark Graphic */
  .tfr-quote-mark {
    position: absolute;
    top: clamp(1rem, 3vw, 2.5rem);
    left: clamp(1.5rem, 4vw, 3.5rem);
    font-family: serif;
    font-size: clamp(6rem, 15vw, 12rem);
    line-height: 0.7;
    color: var(--tfr-accent);
    opacity: 0.12;
    pointer-events: none;
    user-select: none;
  }

  /* Star Rating */
  .tfr-stars {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    color: var(--tfr-accent);
  }
  .tfr-stars svg {
    width: clamp(20px, 3vw, 26px);
    height: clamp(20px, 3vw, 26px);
    fill: currentColor;
    filter: drop-shadow(0 2px 6px color-mix(in srgb, var(--tfr-accent) 40%, transparent));
  }

  /* Quote Text */
  .tfr-quote-text {
    font-family: var(--tfr-font-head);
    font-size: clamp(1.5rem, 3.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--tfr-text);
    max-width: 960px;
    margin: 0;
    position: relative;
    z-index: 2;
  }

  /* Reviewer Meta */
  .tfr-author-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .tfr-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--tfr-accent);
    background: color-mix(in srgb, var(--tfr-text) 10%, transparent);
  }
  .tfr-author-info {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .tfr-author-name {
    font-family: var(--tfr-font-head);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--tfr-text);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .tfr-verified-badge {
    background: #10b981;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 100px;
    letter-spacing: 0.05em;
  }
  .tfr-author-title {
    font-size: 0.88rem;
    color: var(--tfr-muted);
  }

  /* Product Tag Link */
  .tfr-product-tag {
    background: color-mix(in srgb, var(--tfr-text) 8%, transparent);
    border: 1px solid var(--tfr-border);
    border-radius: 100px;
    padding: 0.5rem 1.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--tfr-text);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }
  .tfr-product-tag:hover {
    background: color-mix(in srgb, var(--tfr-text) 15%, transparent);
    border-color: var(--tfr-accent);
    transform: translateY(-2px);
  }
  .tfr-product-tag svg {
    width: 14px;
    height: 14px;
    stroke: var(--tfr-accent);
    stroke-width: 2.5;
    fill: none;
  }

  /* Thumbnail Switcher Bar */
  .tfr-thumbs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    max-width: 1080px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .tfr-thumbs-grid {
      grid-template-columns: repeat({{ section.blocks.size | default: 3 }}, 1fr);
    }
  }
  .tfr-thumb-card {
    background: color-mix(in srgb, var(--tfr-card-bg) 60%, transparent);
    border: 1px solid var(--tfr-border);
    border-radius: 20px;
    padding: 1.25rem;
    cursor: pointer;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: all 0.2s ease;
  }
  .tfr-thumb-card:hover {
    background: var(--tfr-card-bg);
    border-color: color-mix(in srgb, var(--tfr-text) 30%, transparent);
  }
  .tfr-thumb-card.active {
    background: var(--tfr-card-bg);
    border-color: var(--tfr-accent);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
  }
  .tfr-thumb-quote {
    font-size: 0.88rem;
    color: var(--tfr-text);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tfr-thumb-author {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--tfr-muted);
    margin-top: auto;
  }
  .tfr-thumb-card.active .tfr-thumb-author {
    color: var(--tfr-accent);
  }

  /* Verification Inspection Modal */
  .tfr-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .tfr-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .tfr-modal {
    background: var(--tfr-card-bg);
    color: var(--tfr-text);
    border: 1px solid var(--tfr-border);
    border-radius: 24px;
    max-width: 560px;
    width: 100%;
    padding: clamp(2rem, 5vw, 3rem);
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tfr-modal-overlay[data-open="true"] .tfr-modal {
    transform: scale(1);
  }
  .tfr-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: color-mix(in srgb, var(--tfr-text) 10%, transparent);
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--tfr-text);
    cursor: pointer;
  }
</style>

<section class="tfr-section" id="tfr-section-{{ section.id }}" aria-label="Featured Customer Reviews">
  <div class="tfr-container">
    
    {%- if section.settings.eyebrow != blank -%}
      <div class="tfr-eyebrow-wrap">
        <div class="tfr-eyebrow">
          <span>★</span>
          <span>{{ section.settings.eyebrow }}</span>
        </div>
      </div>
    {%- endif -%}

    <!-- Main Editorial Display -->
    <div class="tfr-hero-card" id="tfr-main-card-{{ section.id }}">
      <div class="tfr-quote-mark" aria-hidden="true">“</div>

      <div class="tfr-stars" id="tfr-main-stars-{{ section.id }}" aria-label="5 out of 5 stars">
        <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
      </div>

      {%- assign first_block = section.blocks.first -%}
      <blockquote class="tfr-quote-text" id="tfr-main-quote-{{ section.id }}">
        “{{ first_block.settings.quote | default: 'This single product completely revolutionized our daily workflow. The build quality is unlike anything else on the market today.' }}”
      </blockquote>

      <div class="tfr-author-wrap">
        {%- if first_block.settings.avatar != blank -%}
          {{ first_block.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy', class: 'tfr-avatar', id: 'tfr-main-avatar-' | append: section.id, alt: first_block.settings.author }}
        {%- else -%}
          <div class="tfr-avatar" id="tfr-main-avatar-{{ section.id }}" style="display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.2rem;">★</div>
        {%- endif -%}
        
        <div class="tfr-author-info">
          <div class="tfr-author-name">
            <span id="tfr-main-author-{{ section.id }}">{{ first_block.settings.author | default: 'Dr. Elena Rostova' }}</span>
            {%- if first_block.settings.verified -%}
              <span class="tfr-verified-badge" id="tfr-main-verified-{{ section.id }}">Verified Buyer</span>
            {%- endif -%}
          </div>
          <span class="tfr-author-title" id="tfr-main-title-{{ section.id }}">{{ first_block.settings.author_title | default: 'Head of Product Design, Studio X' }}</span>
        </div>
      </div>

      {%- if first_block.settings.product_label != blank -%}
        <a href="{{ first_block.settings.product_link | default: '/collections/all' }}" class="tfr-product-tag" id="tfr-main-product-{{ section.id }}">
          <svg viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
          <span id="tfr-main-product-text-{{ section.id }}">Reviewed: {{ first_block.settings.product_label }}</span>
        </a>
      {%- endif -%}
    </div>

    <!-- Thumbnail Switcher Bar -->
    {%- if section.blocks.size > 1 -%}
      <div class="tfr-thumbs-grid" id="tfr-thumbs-{{ section.id }}" role="tablist">
        {%- for block in section.blocks -%}
          <div 
            class="tfr-thumb-card {% if forloop.first %}active{% endif %}" 
            role="tab" 
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-quote="{{ block.settings.quote | escape }}"
            data-author="{{ block.settings.author | escape }}"
            data-title="{{ block.settings.author_title | escape }}"
            data-verified="{{ block.settings.verified }}"
            data-avatar="{% if block.settings.avatar != blank %}{{ block.settings.avatar | image_url: width: 120 }}{% endif %}"
            data-plabel="{{ block.settings.product_label | escape }}"
            data-plink="{{ block.settings.product_link | default: '/collections/all' }}"
            {{ block.shopify_attributes }}
          >
            <div class="tfr-stars" style="justify-content:flex-start;">
              <svg viewBox="0 0 24 24" style="width:14px;height:14px;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              <svg viewBox="0 0 24 24" style="width:14px;height:14px;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              <svg viewBox="0 0 24 24" style="width:14px;height:14px;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              <svg viewBox="0 0 24 24" style="width:14px;height:14px;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              <svg viewBox="0 0 24 24" style="width:14px;height:14px;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            </div>
            <div class="tfr-thumb-quote">“{{ block.settings.quote }}”</div>
            <div class="tfr-thumb-author">— {{ block.settings.author }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>

  <!-- Verification Modal -->
  <div class="tfr-modal-overlay" id="tfr-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="tfr-modal">
      <button type="button" class="tfr-modal-close" id="tfr-modal-close-{{ section.id }}" aria-label="Close modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <h3 style="font-family:var(--tfr-font-head);font-size:1.5rem;margin:0;">Verified Review Details</h3>
      <p style="font-size:0.95rem;color:var(--tfr-muted);line-height:1.6;margin:0;">All reviews published on our platform undergo cryptographic purchase verification to guarantee authentic feedback from real verified customers.</p>
      <div style="background:color-mix(in srgb,var(--tfr-accent) 15%,transparent);color:var(--tfr-accent);padding:0.75rem 1rem;border-radius:12px;font-weight:700;font-size:0.88rem;display:flex;align-items:center;gap:0.5rem;">
        <span>✓ Purchase Verified via Order ID #88492-VF</span>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('tfr-section-' + sid);
    if (!sectionEl) return;

    // 1. Dynamic Review Thumbnail Switcher Controller
    var thumbsWrap = document.getElementById('tfr-thumbs-' + sid);
    var mainCard = document.getElementById('tfr-main-card-' + sid);
    if (thumbsWrap && mainCard) {
      var thumbs = thumbsWrap.querySelectorAll('.tfr-thumb-card');
      var quoteEl = document.getElementById('tfr-main-quote-' + sid);
      var authorEl = document.getElementById('tfr-main-author-' + sid);
      var titleEl = document.getElementById('tfr-main-title-' + sid);
      var verifiedEl = document.getElementById('tfr-main-verified-' + sid);
      var avatarEl = document.getElementById('tfr-main-avatar-' + sid);
      var productEl = document.getElementById('tfr-main-product-' + sid);
      var productTextEl = document.getElementById('tfr-main-product-text-' + sid);

      thumbs.forEach(function(thumb) {
        thumb.addEventListener('click', function() {
          thumbs.forEach(function(t) { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
          thumb.classList.add('active');
          thumb.setAttribute('aria-selected', 'true');

          mainCard.setAttribute('data-transitioning', 'true');

          setTimeout(function() {
            if (quoteEl) quoteEl.innerText = '“' + (thumb.getAttribute('data-quote') || '') + '”';
            if (authorEl) authorEl.innerText = thumb.getAttribute('data-author') || '';
            if (titleEl) titleEl.innerText = thumb.getAttribute('data-title') || '';
            
            if (verifiedEl) {
              if (thumb.getAttribute('data-verified') === 'true') verifiedEl.style.display = 'inline-block';
              else verifiedEl.style.display = 'none';
            }

            var av = thumb.getAttribute('data-avatar');
            if (avatarEl && av && av !== 'null' && av !== '') {
              if (avatarEl.tagName === 'IMG') avatarEl.src = av;
              else avatarEl.innerHTML = '<img src="' + av + '" style="width:100%;height:100%;border-radius:50%;object-fit:cover;">';
            }

            var plabel = thumb.getAttribute('data-plabel');
            var plink = thumb.getAttribute('data-plink');
            if (productEl && plabel && plabel !== 'null' && plabel !== '') {
              productEl.style.display = 'inline-flex';
              productEl.href = plink;
              if (productTextEl) productTextEl.innerText = 'Reviewed: ' + plabel;
            } else if (productEl) {
              productEl.style.display = 'none';
            }

            mainCard.removeAttribute('data-transitioning');
          }, 200);
        });
      });
    }

    // 2. Verified Badge Inspection Modal Controller
    var modalOverlay = document.getElementById('tfr-modal-' + sid);
    var modalClose = document.getElementById('tfr-modal-close-' + sid);
    if (modalOverlay && modalClose) {
      sectionEl.addEventListener('click', function(e) {
        if (e.target.classList.contains('tfr-verified-badge')) {
          modalOverlay.setAttribute('data-open', 'true');
          modalOverlay.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Featured Review Hero",
  "tag": "section",
  "class": "section-featured-review-hero",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#1e293b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Star Color",
      "default": "#facc15"
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Customer Spotlight & Editorial Endorsement"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Editorial Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote Text",
          "default": "This single product completely revolutionized our daily workflow. The build quality and customer service are unlike anything else on the market today."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Reviewer Name",
          "default": "Dr. Elena Rostova"
        },
        {
          "type": "text",
          "id": "author_title",
          "label": "Reviewer Title / Credentials",
          "default": "Head of Product Design, Studio X"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show Verified Buyer Badge",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Author Avatar Image"
        },
        {
          "type": "text",
          "id": "product_label",
          "label": "Reviewed Product Tag Name",
          "default": "The Pro Series V2"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Reviewed Product URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Review Hero",
