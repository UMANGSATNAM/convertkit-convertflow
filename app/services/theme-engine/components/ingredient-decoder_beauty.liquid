{%- comment -%}
  sections/ingredient-decoder_beauty.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (520+ lines):
  1. TRANSPARENCY & INCI AUTHORITY: Modern clinical beauty shoppers scrutinize ingredient labels for active concentrations and molecular weights. Decoding technical nomenclature into clear biochemical action and clinical trial evidence builds medical-grade trust.
  2. LIVE SKIN-TYPE COMPATIBILITY ANALYZER: Allowing shoppers to test active compounds against their specific skin barrier profile (acne-prone, dehydrated, mature) eliminates fear of irritation or breakouts.
  3. EXCLUSION MATRIX (Safety Assurance): Explicitly validating the absence of endocrine disruptors, sulfates, and parabens removes health-conscious purchase friction.
  4. ZERO EMOJI GUARANTEE: Uses clinical ASCII brackets [ CLINICAL INCI DECODER ], [ EWG GREEN 1 ], [ +48% COLLAGEN ], and pharmaceutical rose/slate styling.
{%- endcomment -%}

{%- assign section_id = 'bt-ing-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --id-bg: {{ section.settings.bg_color | default: '#faf9f8' }};
    --id-card: #ffffff;
    --id-border: #e2e8f0;
    --id-text: #334155;
    --id-heading: #0f172a;
    --id-rose: #be123c;
    --id-rose-bg: #fff1f2;
    --id-accent: #9f1239;
    --id-muted: #64748b;
    --id-dark: #0f172a;

    background-color: var(--id-bg);
    color: var(--id-text);
    padding: clamp(4rem, 8vw, 7rem) clamp(1.2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--id-border);
    border-bottom: 1px solid var(--id-border);
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    position: relative;
  }

  #{{ section_id }} .id__container {
    max-width: 1250px;
    margin: 0 auto;
  }

  /* Header Ribbon */
  #{{ section_id }} .id__header {
    text-align: center;
    max-width: 850px;
    margin: 0 auto 3.5rem auto;
  }

  #{{ section_id }} .id__badge {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--id-rose);
    background: var(--id-rose-bg);
    border: 1px solid #fecdd3;
    padding: 0.35rem 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  #{{ section_id }} .id__title {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 900;
    color: var(--id-heading);
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  #{{ section_id }} .id__sub {
    font-size: 0.95rem;
    color: var(--id-muted);
    line-height: 1.6;
  }

  #{{ section_id }} .id__sub strong {
    color: var(--id-heading);
  }

  /* Live Skin-Type Compatibility Analyzer Ribbon */
  #{{ section_id }} .id__analyzer {
    background: var(--id-dark);
    color: #ffffff;
    padding: 2rem clamp(1.5rem, 4vw, 3rem);
    border: 2px solid var(--id-rose);
    margin-bottom: 3.5rem;
    box-shadow: 0 20px 40px rgba(190, 18, 60, 0.1);
  }

  #{{ section_id }} .id__ana-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed #334155;
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  #{{ section_id }} .id__ana-title {
    font-size: 0.95rem;
    font-weight: 900;
    color: #fda4af;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }

  #{{ section_id }} .id__ana-score {
    font-size: 0.85rem;
    font-weight: 800;
    color: #10b981;
    font-family: 'Courier New', Courier, monospace;
  }

  #{{ section_id }} .id__ana-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    #{{ section_id }} .id__ana-grid { grid-template-columns: 1.2fr 1fr; }
  }

  #{{ section_id }} .id__prof-select {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  #{{ section_id }} .id__prof-btn {
    background: #1e293b;
    border: 1px solid #334155;
    color: #cbd5e1;
    padding: 0.65rem 1.1rem;
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .id__prof-btn.is-active,
  #{{ section_id }} .id__prof-btn:hover {
    background: var(--id-rose);
    color: #ffffff;
    border-color: var(--id-rose);
  }

  #{{ section_id }} .id__ana-feedback {
    background: #111827;
    border-left: 4px solid #10b981;
    padding: 1.25rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: #e2e8f0;
  }

  #{{ section_id }} .id__ana-feedback strong {
    color: #34d399;
  }

  /* Category Filter Ribbon */
  #{{ section_id }} .id__filters {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }

  #{{ section_id }} .id__fil-btn {
    background: var(--id-card);
    border: 1px solid var(--id-border);
    color: var(--id-muted);
    padding: 0.7rem 1.3rem;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .id__fil-btn.is-active,
  #{{ section_id }} .id__fil-btn:hover {
    background: var(--id-heading);
    color: #ffffff;
    border-color: var(--id-heading);
  }

  /* Ingredients Grid */
  #{{ section_id }} .id__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.8rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 600px) {
    #{{ section_id }} .id__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    #{{ section_id }} .id__grid { grid-template-columns: repeat(3, 1fr); }
  }

  #{{ section_id }} .id__card {
    background: var(--id-card);
    border: 1px solid var(--id-border);
    padding: 1.8rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s ease;
    position: relative;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
  }

  #{{ section_id }} .id__card:hover {
    box-shadow: 0 15px 35px rgba(0,0,0,0.08);
    transform: translateY(-3px);
    border-color: var(--id-rose);
  }

  #{{ section_id }} .id__card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.25rem;
  }

  #{{ section_id }} .id__inci-tag {
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--id-rose);
    background: var(--id-rose-bg);
    padding: 0.25rem 0.6rem;
    text-transform: uppercase;
  }

  #{{ section_id }} .id__ewg-tag {
    font-size: 0.68rem;
    font-weight: 900;
    color: #10b981;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    padding: 0.25rem 0.5rem;
    text-transform: uppercase;
  }

  #{{ section_id }} .id__ing-title {
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--id-heading);
    margin: 0 0 0.4rem 0;
  }

  #{{ section_id }} .id__ing-sub {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--id-muted);
    font-family: 'Courier New', Courier, monospace;
    margin-bottom: 1rem;
    display: block;
  }

  #{{ section_id }} .id__ing-desc {
    font-size: 0.85rem;
    color: var(--id-text);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  #{{ section_id }} .id__trial-box {
    background: #f8fafc;
    border: 1px dashed var(--id-border);
    padding: 0.85rem;
    margin-bottom: 1.5rem;
    font-size: 0.75rem;
    color: var(--id-heading);
    line-height: 1.4;
  }

  #{{ section_id }} .id__trial-box strong {
    color: var(--id-rose);
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  #{{ section_id }} .id__open-btn {
    width: 100%;
    background: #f1f5f9;
    color: var(--id-heading);
    border: 1px solid var(--id-border);
    padding: 0.8rem;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .id__open-btn:hover {
    background: var(--id-rose);
    color: #ffffff;
    border-color: var(--id-rose);
  }

  /* Exclusion Safety Matrix */
  #{{ section_id }} .id__exclusion {
    background: #ffffff;
    border: 1px solid var(--id-border);
    padding: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 3.5rem;
  }

  #{{ section_id }} .id__ex-head {
    font-size: 1.05rem;
    font-weight: 900;
    color: var(--id-heading);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 1.5rem 0;
    border-bottom: 2px solid var(--id-heading);
    padding-bottom: 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #{{ section_id }} .id__ex-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    #{{ section_id }} .id__ex-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    #{{ section_id }} .id__ex-grid { grid-template-columns: repeat(4, 1fr); }
  }

  #{{ section_id }} .id__ex-item {
    background: #f8fafc;
    border: 1px solid var(--id-border);
    padding: 1.25rem;
    text-align: center;
  }

  #{{ section_id }} .id__ex-badge {
    font-size: 0.68rem;
    font-weight: 900;
    color: #ffffff;
    background: #10b981;
    padding: 0.2rem 0.6rem;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  #{{ section_id }} .id__ex-title {
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--id-heading);
    margin: 0 0 0.35rem 0;
    text-transform: uppercase;
  }

  #{{ section_id }} .id__ex-desc {
    font-size: 0.75rem;
    color: var(--id-muted);
    line-height: 1.4;
  }

  /* Molecular Telemetry Modal */
  #{{ section_id }} .id__modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    backdrop-filter: blur(4px);
  }

  #{{ section_id }} .id__modal-overlay.is-open { display: flex; }

  #{{ section_id }} .id__modal {
    background: #ffffff;
    width: min(700px, 100%);
    max-height: 90vh;
    overflow-y: auto;
    border: 1px solid var(--id-border);
    box-shadow: 0 25px 60px rgba(0,0,0,0.3);
    padding: clamp(1.8rem, 4vw, 3rem);
    position: relative;
  }

  #{{ section_id }} .id__m-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: #f1f5f9;
    border: 1px solid var(--id-border);
    color: var(--id-heading);
    padding: 0.4rem 0.8rem;
    font-size: 0.75rem;
    font-weight: 800;
    cursor: pointer;
  }

  #{{ section_id }} .id__m-title {
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--id-heading);
    margin: 0 0 0.35rem 0;
  }

  #{{ section_id }} .id__m-inci {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--id-rose);
    font-family: 'Courier New', Courier, monospace;
    margin-bottom: 1.5rem;
    display: block;
  }

  #{{ section_id }} .id__m-specs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  #{{ section_id }} .id__m-box {
    background: #f8fafc;
    border: 1px solid var(--id-border);
    padding: 1rem;
  }

  #{{ section_id }} .id__m-lbl { font-size: 0.68rem; color: var(--id-muted); text-transform: uppercase; display: block; }
  #{{ section_id }} .id__m-val { font-size: 0.85rem; font-weight: 800; color: var(--id-heading); margin-top: 0.25rem; display: block; }

  #{{ section_id }} .id__m-desc { font-size: 0.9rem; color: var(--id-text); line-height: 1.65; margin-bottom: 2rem; }

  #{{ section_id }} .id__m-add {
    width: 100%;
    background: var(--id-heading);
    color: #ffffff;
    border: none;
    padding: 1.15rem;
    font-size: 0.88rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  #{{ section_id }} .id__m-add:hover { background: var(--id-rose); }
</style>

<section id="{{ section_id }}">
  <div class="id__container">
    <div class="id__header">
      <span class="id__badge">[ {{ section.settings.eyebrow | default: "SYS.VERIFIED: BIO-CHEMICAL INCI DECODER" }} ]</span>
