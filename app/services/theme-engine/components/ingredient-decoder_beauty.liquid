          <div class="id__prof-select" data-prof-group>
            <button type="button" class="id__prof-btn is-active" data-prof="acne">[ 01: OILY &amp; ACNE-PRONE ]</button>
            <button type="button" class="id__prof-btn" data-prof="dry">[ 02: DEHYDRATED &amp; COMPROMISED ]</button>
            <button type="button" class="id__prof-btn" data-prof="mature">[ 03: MATURE &amp; HYPERPIGMENTED ]</button>
