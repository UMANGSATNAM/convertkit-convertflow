<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    // Skin Analyzer Logic
    var profBtns = section.querySelectorAll('[data-prof-group] .id__prof-btn');
    var feedbackDisp = section.querySelector('[data-ana-feedback]');
    var scoreDisp = section.querySelector('[data-score-disp]');

    var profData = {
      acne: {
        score: '[ 99.4% BIO-COMPATIBLE WITH YOUR PROFILE ]',
        text: '// <strong>CLINICAL PROFILE MATCH:</strong> For oily and acne-prone skin, our 10% Niacinamide PC and Zinc PCA matrix downregulates sebaceous lipogenesis without stripping essential ceramides. Zero comedogenic risk rated. //'
      },
      dry: {
        score: '[ 99.8% BIO-COMPATIBLE WITH YOUR PROFILE ]',
        text: '// <strong>CLINICAL PROFILE MATCH:</strong> For dehydrated or compromised barriers, our Tri-Dalton Hyaluronic Acid and 3:1:1 Biomimetic Ceramide Matrix instantly halts water loss and reconstructs intercellular lipid sheets. //'
      },
      mature: {
        score: '[ 99.6% BIO-COMPATIBLE WITH YOUR PROFILE ]',
        text: '// <strong>CLINICAL PROFILE MATCH:</strong> For mature and sun-damaged skin, our Copper Tripeptide-1 (GHK-Cu) and Granactive Retinoid ester stimulate collagen I &amp; III transcription while accelerating cellular turnover without peeling. //'
      }
    };

    profBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        profBtns.forEach(function(b) { b.classList.remove('is-active'); });
        this.classList.add('is-active');
        var p = this.getAttribute('data-prof') || 'acne';

        if (profData[p]) {
          if (scoreDisp) scoreDisp.textContent = profData[p].score;
          if (feedbackDisp) feedbackDisp.innerHTML = profData[p].text;
        }
      });
    });

    // Category Filter Logic
    var filterBtns = section.querySelectorAll('[data-filter-group] .id__fil-btn');
    var cards = section.querySelectorAll('.id__card');

    filterBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        filterBtns.forEach(function(b) { b.classList.remove('is-active'); });
        this.classList.add('is-active');
        var cat = this.getAttribute('data-filter') || 'all';

        cards.forEach(function(card) {
          var cCat = card.getAttribute('data-cat') || '';
          if (cat === 'all' || cCat === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Molecular Telemetry Modal Logic
    var openBtns = section.querySelectorAll('[data-open-ing]');
    var modal = section.querySelector('[data-ing-modal]');
    var closeBtn = section.querySelector('[data-close-ing]');

    var mTitle = section.querySelector('[data-m-title]');
    var mInci = section.querySelector('[data-m-inci]');
    var mWeight = section.querySelector('[data-m-weight]');
    var mEwg = section.querySelector('[data-m-ewg]');
    var mDesc = section.querySelector('[data-m-desc]');
    var mTrial = section.querySelector('[data-m-trial]');
    var mAdd = section.querySelector('[data-m-add]');

    openBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var card = this.closest('.id__card');
        if (!card || !modal) return;

        var title = card.getAttribute('data-title');
        var inci = card.getAttribute('data-inci');
        var weight = card.getAttribute('data-weight');
        var ewg = card.getAttribute('data-ewg');
        var desc = card.getAttribute('data-desc');
        var trial = card.getAttribute('data-trial');

        if (mTitle) mTitle.textContent = title;
        if (mInci) mInci.textContent = inci;
        if (mWeight) mWeight.textContent = weight;
        if (mEwg) mEwg.textContent = ewg;
        if (mDesc) mDesc.textContent = desc;
        if (mTrial) mTrial.innerHTML = '<strong>[ VERIFIED DERMATOLOGICAL TRIAL DATA ]:</strong> ' + trial;

        modal.classList.add('is-open');
      });
    });

    if (closeBtn && modal) {
      closeBtn.addEventListener('click', function() {
        modal.classList.remove('is-open');
      });
      modal.addEventListener('click', function(e) {
        if (e.target === modal) modal.classList.remove('is-open');
      });
    }

    if (mAdd) {
      mAdd.addEventListener('click', function() {
        mAdd.textContent = '[ TITRATING CLINICAL REGIMEN... ]';
        setTimeout(function() {
          mAdd.textContent = '[ BIO-FORMULA ADDED TO CART V ]';
          alert('[ SYSTEM NOTE ] The clinical bio-formula has been added to your cart with a 60-day barrier satisfaction guarantee.');
          if (modal) modal.classList.remove('is-open');
          mAdd.textContent = '[ LOCK IN BIO-FORMULA &bull; ADD REGIMEN TO CART ]';
        }, 600);
      });
    }
  });
</script>

