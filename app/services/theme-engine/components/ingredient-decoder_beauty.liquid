    <div class="id__grid" data-ing-grid>
      <!-- Card 1 -->
      <div class="id__card" data-cat="hydra" data-title="10% Niacinamide PC + Zinc" data-inci="INCI: NIACINAMIDE, ZINC PCA" data-weight="122.12 G/MOL (ULTRA-LOW DALTON)" data-ewg="EWG GREEN RATING: 1 (NON-TOXIC)" data-desc="Pharmaceutical-grade Vitamin B3 purified to remove nicotinic acid (which causes skin flushing). Strengthens intercellular lipid matrix and visibly refines pore architecture." data-trial="[ 14-DAY TRIAL ]: 89% reduction in sebum oxidation and noticeable pore tightening across 42 subjects.">
        <div class="id__card-top">
          <span class="id__inci-tag">[ 10% CLINICAL DOSE ]</span>
          <span class="id__ewg-tag">[ EWG: 1 ]</span>
        </div>
        <div>
          <h3 class="id__ing-title">Niacinamide PC + Zinc</h3>
          <span class="id__ing-sub">// INCI: NIACINAMIDE //</span>
          <p class="id__ing-desc">Strengthens the stratum corneum lipid barrier, downregulates sebaceous excretion, and prevents UV-induced immunosuppression without causing irritation.</p>
          <div class="id__trial-box">
            <strong>[ DERMATOLOGICAL TRIAL DATA ]</strong>
            89% reduction in sebum oxidation and pore prominence verified over 14 days.
          </div>
        </div>
        <button type="button" class="id__open-btn" data-open-ing>[ DECODE MOLECULAR PROFILE &rarr; ]</button>
      </div>

      <!-- Card 2 -->
      <div class="id__card" data-cat="hydra" data-title="Multi-Molecular Hyaluronic Acid 2%" data-inci="INCI: SODIUM HYALURONATE, HYDROLYZED HA" data-weight="50 KDA - 1,500 KDA (TRI-DALTON)" data-ewg="EWG GREEN RATING: 1 (NON-TOXIC)" data-desc="Combines low, medium, and high molecular weight hyaluronic acid polymers. High weights seal surface moisture while micro-50 kDa fragments penetrate deep dermis layers." data-trial="[ 24-HR BIOMETRIC ASSAY ]: +142% sustained subcutaneous moisture retention verified by corneometer testing.">
        <div class="id__card-top">
          <span class="id__inci-tag">[ TRI-DALTON MATRIX ]</span>
          <span class="id__ewg-tag">[ EWG: 1 ]</span>
        </div>
        <div>
          <h3 class="id__ing-title">Multi-Molecular HA 2%</h3>
          <span class="id__ing-sub">// INCI: SODIUM HYALURONATE //</span>
          <p class="id__ing-desc">Delivers immediate surface plumping while low-weight 50 kDa monomers penetrate intercellular channels to stimulate endogenous hyaluronic acid synthesis.</p>
          <div class="id__trial-box">
            <strong>[ DERMATOLOGICAL TRIAL DATA ]</strong>
            +142% deep dermal hydration retention measured at 24 hours post-application.
          </div>
        </div>
        <button type="button" class="id__open-btn" data-open-ing>[ DECODE MOLECULAR PROFILE &rarr; ]</button>
      </div>

      <!-- Card 3 -->
      <div class="id__card" data-cat="anti" data-title="Copper Tripeptide-1 (GHK-Cu)" data-inci="INCI: BIS(TRIPEPTIDE-1) COPPER ACETATE" data-weight="340.38 G/MOL (BIO-SIGNAL PEPTIDE)" data-ewg="EWG GREEN RATING: 1 (NON-TOXIC)" data-desc="A high-affinity carrier peptide that delivers bio-available copper ions directly to fibroblasts. Upregulates collagen I, III, and elastin messenger RNA transcription." data-trial="[ 28-DAY BIO-BIOPSY ]: +48% increase in pro-collagen synthesis and measurable skin density thickening.">
