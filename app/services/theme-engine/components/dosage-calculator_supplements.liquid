<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var inputMass = section.querySelector('[data-input-mass]');
    var massDisp = section.querySelector('[data-mass-disp]');
    var inputAct = section.querySelector('[data-input-act]');
    var inputGoal = section.querySelector('[data-input-goal]');

    var outMg = section.querySelector('[data-out-mg]');
    var outCaps = section.querySelector('[data-out-caps]');
    var mAm = section.querySelector('[data-m-am]');
    var mPm = section.querySelector('[data-m-pm]');
    var mSup = section.querySelector('[data-m-sup]');
    var addBtn = section.querySelector('[data-add-regimen]');

    var tabs = section.querySelectorAll('.dc__tab');
    var contents = section.querySelectorAll('.dc__content');

    function calculateDose() {
      if (!inputMass || !inputAct || !inputGoal) return;
      var mass = parseInt(inputMass.value || '80', 10);
      var actRatio = parseFloat(inputAct.value || '1.3');
      var goal = inputGoal.value || 'atp';

      if (massDisp) massDisp.textContent = mass + ' KG (' + Math.round(mass * 2.20462) + ' LBS)';

      var baseMgPerKg = 25;
      if (goal === 'neuro') baseMgPerKg = 28;
      if (goal === 'hyp') baseMgPerKg = 32;

      var totalMg = Math.round((mass * baseMgPerKg * actRatio) / 50) * 50;
      if (totalMg < 1000) totalMg = 1000;
      if (totalMg > 4500) totalMg = 4500;

      var caps = Math.ceil(totalMg / 650);
      if (caps < 2) caps = 2;
      if (caps > 8) caps = 8;
      if (caps % 2 !== 0) caps += 1;

      var splitCaps = caps / 2;
      var splitMg = Math.round(totalMg / 2);

      var bottles = Math.ceil((caps * 60) / 120);

      if (outMg) outMg.textContent = totalMg.toLocaleString('en-US') + ' MG';
      if (outCaps) outCaps.textContent = '[ ' + caps + ' BIO-ACTIVE CAPSULES DAILY ]';
      if (mAm) mAm.textContent = splitMg.toLocaleString('en-US') + ' MG (' + splitCaps + ' CAPS)';
      if (mPm) mPm.textContent = splitMg.toLocaleString('en-US') + ' MG (' + splitCaps + ' CAPS)';
      if (mSup) mSup.textContent = bottles + ' BOTTLES (60-DAY CYCLE)';

      if (addBtn) {
        addBtn.textContent = '[ LOCK IN ' + totalMg + ' MG CLINICAL PROTOCOL (' + bottles + ' BOTTLES) &bull; ADD TO CART ]';
      }
    }

    if (inputMass) inputMass.addEventListener('input', calculateDose);
    if (inputAct) inputAct.addEventListener('change', calculateDose);
    if (inputGoal) inputGoal.addEventListener('change', calculateDose);

    if (addBtn) {
      addBtn.addEventListener('click', function() {
        addBtn.textContent = '[ TITRATING BIO-ACTIVE MATRIX... ]';
        setTimeout(function() {
          addBtn.textContent = '[ PERSONALIZED PROTOCOL ADDED TO CART V ]';
          alert('[ SYSTEM NOTE ] Your exact calculated daily dosage protocol has been locked into your cart with a 60-day efficacy guarantee.');
        }, 500);
      });
    }

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('is-active'); });
        this.classList.add('is-active');
        var target = this.getAttribute('data-target') || 'assay';

        contents.forEach(function(c) {
          var cTarget = c.getAttribute('data-content') || 'assay';
          if (cTarget === target) {
            c.classList.add('is-active');
          } else {
            c.classList.remove('is-active');
          }
        });
      });
    });

    calculateDose();
  });
</script>

