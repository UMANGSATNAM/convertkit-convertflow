<section id="{{ section_id }}">
  <div class="dc__container">
    <div class="dc__header">
      <span class="dc__badge">[ {{ section.settings.eyebrow | default: "SYS.VERIFIED: BIOMETRIC TITRATION" }} ]</span>
      <h2 class="dc__title">{{ section.settings.heading | default: "Clinical Dosage Calculator" }}</h2>
      <p class="dc__sub">
        Standard supplement labels recommend generic one-size-fits-all dosages that under-dose athletes and over-stimulate sedentary individuals. Adjust your biometric variables below to calculate your <strong>exact medical-grade titration and 24-hour absorption protocol.</strong>
      </p>
    </div>

    <!-- Main Calculator Grid -->
    <div class="dc__grid">
      <!-- Left: Biometric Input Controls -->
      <div class="dc__panel-left">
        <div class="dc__panel-head">
          <h3 class="dc__panel-title">[ BIOMETRIC INPUT PARAMETERS ]</h3>
          <span class="dc__step-tag">[ LIVE CALCULATION ENGINE ]</span>
        </div>

        <!-- Control 1: Body Mass -->
        <div class="dc__field">
          <div class="dc__field-top">
            <label class="dc__label" for="dc-mass-{{ section.id }}">[ 01: TOTAL BODY MASS (KG) ]</label>
            <span class="dc__val-disp" data-mass-disp>80 KG</span>
          </div>
          <input type="range" id="dc-mass-{{ section.id }}" class="dc__slider" data-input-mass min="45" max="135" step="5" value="80">
          <div class="dc__scale">
            <span>45 KG (100 LBS)</span>
            <span>90 KG (200 LBS)</span>
            <span>135 KG (300 LBS)</span>
          </div>
        </div>

        <!-- Control 2: Activity Intensity -->
        <div class="dc__field">
          <div class="dc__field-top">
            <label class="dc__label" for="dc-act-{{ section.id }}">[ 02: DAILY EXERTION INTENSITY ]</label>
          </div>
          <select id="dc-act-{{ section.id }}" class="dc__select" data-input-act>
            <option value="1.0">SEDENTARY / LOW METABOLIC DRAIN (1.0X RATIO)</option>
            <option value="1.3" selected>MODERATE ENDURANCE / ATHLETIC (1.3X RATIO)</option>
            <option value="1.6">HYPER-INTENSE / POWERLIFTING &amp; HIIT (1.6X RATIO)</option>
