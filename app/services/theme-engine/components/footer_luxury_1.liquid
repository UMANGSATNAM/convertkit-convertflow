{%- comment -%}
  footer_luxury_1.liquid — Luxury Footer
  
  DESIGN PHILOSOPHY:
  Inverted dark footer with refined typography.
  Multi-column layout with newsletter, social, and legal links.
  The "quiet close" to a luxury experience.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --lft-bg: var(--color-text, #1a1a1a);
    --lft-text: var(--color-background, #faf9f7);
    --lft-muted: color-mix(in srgb, var(--lft-text) 45%, transparent);
    --lft-border: color-mix(in srgb, var(--lft-text) 10%, transparent);
    --lft-accent: var(--color-accent, #c9a96e);
    --lft-font: var(--font-body, 'Inter', sans-serif);
    --lft-font-logo: var(--font-heading, 'Playfair Display', serif);
  }

  .lx-footer {
    background: var(--lft-bg);
    color: var(--lft-text);
    padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 4vw, 4rem) 2rem;
  }

  .lx-footer__inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  /* ── TOP: Brand + Newsletter ──── */
  .lx-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--lft-border);
    margin-bottom: 2.5rem;
  }
  @media (min-width: 768px) {
    .lx-footer__top {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }

  .lx-footer__brand-name {
    font-family: var(--lft-font-logo);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 0.75rem 0;
    color: var(--lft-text);
  }
  .lx-footer__brand-tagline {
    font-family: var(--lft-font);
    font-size: 0.8rem;
    color: var(--lft-muted);
    line-height: 1.6;
    max-width: 360px;
  }

  .lx-footer__newsletter-label {
    font-family: var(--lft-font);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--lft-muted);
    margin-bottom: 0.75rem;
  }
  .lx-footer__newsletter-form {
    display: flex;
    gap: 0;
    max-width: 400px;
  }
  .lx-footer__newsletter-input {
    flex: 1;
    padding: 0.8rem 1rem;
    background: transparent;
    border: 1px solid var(--lft-border);
    border-right: none;
    color: var(--lft-text);
    font-family: var(--lft-font);
    font-size: 0.85rem;
    outline: none;
    transition: border-color 0.2s;
  }
  .lx-footer__newsletter-input::placeholder {
    color: var(--lft-muted);
  }
  .lx-footer__newsletter-input:focus {
    border-color: var(--lft-accent);
  }
  .lx-footer__newsletter-btn {
    padding: 0.8rem 1.5rem;
    background: var(--lft-text);
    color: var(--lft-bg);
    border: 1px solid var(--lft-text);
    font-family: var(--lft-font);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .lx-footer__newsletter-btn:hover {
    opacity: 0.85;
  }

  /* ── MIDDLE: Navigation Columns ── */
  .lx-footer__columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--lft-border);
    margin-bottom: 2rem;
  }
  @media (min-width: 768px) {
    .lx-footer__columns {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .lx-footer__col-title {
    font-family: var(--lft-font);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--lft-muted);
    margin-bottom: 1.25rem;
  }
  .lx-footer__col-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .lx-footer__col-links a {
    font-family: var(--lft-font);
    font-size: 0.8rem;
    color: var(--lft-text);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .lx-footer__col-links a:hover {
    color: var(--lft-accent);
  }

  /* ── BOTTOM: Legal + Social ──── */
  .lx-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
    text-align: center;
  }
  @media (min-width: 768px) {
    .lx-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .lx-footer__copyright {
    font-family: var(--lft-font);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--lft-muted);
  }

  .lx-footer__social {
    display: flex;
    gap: 1.5rem;
  }
  .lx-footer__social a {
    font-family: var(--lft-font);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--lft-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .lx-footer__social a:hover {
    color: var(--lft-text);
  }

  .lx-footer__legal {
    display: flex;
    gap: 1.25rem;
  }
  .lx-footer__legal a {
    font-family: var(--lft-font);
    font-size: 0.65rem;
    color: var(--lft-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .lx-footer__legal a:hover {
    color: var(--lft-text);
  }
</style>

<footer class="lx-footer">
  <div class="lx-footer__inner">

    {%- comment -%} ── Top: Brand + Newsletter ── {%- endcomment -%}
    <div class="lx-footer__top">
      <div>
        <h2 class="lx-footer__brand-name">{{ shop.name }}</h2>
        {%- if section.settings.tagline != blank -%}
          <p class="lx-footer__brand-tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.show_newsletter -%}
        <div>
          <div class="lx-footer__newsletter-label">{{ section.settings.newsletter_heading | default: 'Join the Maison' }}</div>
          <form class="lx-footer__newsletter-form" action="/contact#contact_form" method="post" accept-charset="UTF-8">
            <input type="hidden" name="form_type" value="customer">
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input
              type="email"
              name="contact[email]"
              class="lx-footer__newsletter-input"
              placeholder="Email Address"
              required
              autocomplete="email"
              aria-label="Email for newsletter">
            <button type="submit" class="lx-footer__newsletter-btn">Subscribe</button>
          </form>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── Navigation Columns ── {%- endcomment -%}
    <div class="lx-footer__columns">
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          <div>
            <div class="lx-footer__col-title">{{ block.settings.title }}</div>
            <ul class="lx-footer__col-links">
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} ── Bottom: Legal + Social ── {%- endcomment -%}
    <div class="lx-footer__bottom">
      <div class="lx-footer__copyright">
        &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All Rights Reserved.
      </div>
      <div class="lx-footer__social">
        {%- if section.settings.social_instagram != blank -%}
          <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>
        {%- endif -%}
        {%- if section.settings.social_pinterest != blank -%}
          <a href="{{ section.settings.social_pinterest }}" target="_blank" rel="noopener">Pinterest</a>
        {%- endif -%}
        {%- if section.settings.social_twitter != blank -%}
          <a href="{{ section.settings.social_twitter }}" target="_blank" rel="noopener">Twitter</a>
        {%- endif -%}
      </div>
      <div class="lx-footer__legal">
        <a href="/policies/privacy-policy">Privacy</a>
        <a href="/policies/terms-of-service">Terms</a>
        <a href="/policies/refund-policy">Returns</a>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Luxury Footer",
  "tag": "section",
  "class": "section-footer-luxury",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand Tagline",
      "default": "Crafted with intention. Designed for the discerning."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Newsletter Signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Join the Maison"
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "Twitter / X URL"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column Title",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Footer",
      "blocks": [
        { "type": "column", "settings": { "title": "Shop", "menu": "footer" } },
        { "type": "column", "settings": { "title": "About", "menu": "footer" } },
        { "type": "column", "settings": { "title": "Help", "menu": "footer" } },
        { "type": "column", "settings": { "title": "Legal", "menu": "footer" } }
      ]
    }
  ]
}
{% endschema %}
