{%- comment -%}
  footer_minimal.liquid — Ultra-Comprehensive Minimalist Luxury Footer
  
  DESIGN PHILOSOPHY:
  A refined, high-performance footer designed for luxury brands and modern e-commerce.
  Combines clean architectural lines with rich functionality: interactive newsletter,
  accessible mobile accordions, localization selectors, payment badge grids, and
  smooth back-to-top navigation. Engineered for 60fps performance and zero layout shift.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --fm-bg: {{ section.settings.bg_color | default: '#0f172a' }};
    --fm-text: {{ section.settings.text_color | default: '#f8fafc' }};
    --fm-muted: color-mix(in srgb, var(--fm-text) 60%, transparent);
    --fm-border: color-mix(in srgb, var(--fm-text) 12%, transparent);
    --fm-accent: {{ section.settings.accent_color | default: '#38bdf8' }};
    --fm-card-bg: color-mix(in srgb, var(--fm-text) 5%, transparent);
    --fm-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --fm-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --fm-padding-top: clamp(3.5rem, 8vw, 6.5rem);
    --fm-padding-bottom: clamp(2rem, 5vw, 4rem);
  }

  .fm-section {
    background-color: var(--fm-bg);
    color: var(--fm-text);
    font-family: var(--fm-font-body);
    border-top: 1px solid var(--fm-border);
    position: relative;
    overflow: hidden;
  }

  .fm-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--fm-padding-top) clamp(1.25rem, 4vw, 4rem) var(--fm-padding-bottom);
  }

  /* Main Grid Layout */
  .fm-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  @media (min-width: 768px) {
    .fm-main-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .fm-main-grid {
      grid-template-columns: 3.5fr 2fr 2fr 3.5fr;
      gap: 3rem;
    }
  }

  /* Brand Column */
  .fm-brand-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .fm-logo-link {
    display: inline-block;
    text-decoration: none;
    color: var(--fm-text);
    font-family: var(--fm-font-head);
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .fm-logo-img {
    max-height: 48px;
    width: auto;
    object-fit: contain;
  }
  .fm-tagline {
    font-size: 0.95rem;
    color: var(--fm-muted);
    line-height: 1.6;
    max-width: 320px;
    margin: 0;
  }

  /* Social Icons */
  .fm-social-list {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
  }
  .fm-social-link {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--fm-card-bg);
    border: 1px solid var(--fm-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fm-text);
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .fm-social-link:hover {
    transform: translateY(-3px);
    background: var(--fm-accent);
    color: #000000;
    border-color: var(--fm-accent);
  }
  .fm-social-link svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  /* Navigation Accordion / Columns */
  .fm-nav-col {
    border-bottom: 1px solid var(--fm-border);
    padding-bottom: 1.25rem;
  }
  @media (min-width: 768px) {
    .fm-nav-col {
      border-bottom: none;
      padding-bottom: 0;
    }
  }
  .fm-col-heading {
    font-family: var(--fm-font-head);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fm-text);
    margin: 0 0 1.25rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
  }
  @media (min-width: 768px) {
    .fm-col-heading {
      cursor: default;
      pointer-events: none;
    }
  }
  .fm-accordion-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }
  @media (min-width: 768px) {
    .fm-accordion-icon {
      display: none;
    }
  }
  .fm-nav-col[data-expanded="true"] .fm-accordion-icon {
    transform: rotate(180deg);
  }
  .fm-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    opacity: 0;
  }
  @media (min-width: 768px) {
    .fm-nav-list {
      max-height: none !important;
      opacity: 1 !important;
      overflow: visible;
    }
  }
  .fm-nav-col[data-expanded="true"] .fm-nav-list {
    max-height: 500px;
    opacity: 1;
    margin-top: 0.5rem;
  }
  .fm-nav-item a {
    color: var(--fm-muted);
    text-decoration: none;
    font-size: 0.92rem;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }
  .fm-nav-item a:hover {
    color: var(--fm-text);
    transform: translateX(4px);
  }

  /* Newsletter Box */
  .fm-newsletter-col {
    background: var(--fm-card-bg);
    border: 1px solid var(--fm-border);
    border-radius: 16px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .fm-nl-title {
    font-family: var(--fm-font-head);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--fm-text);
    margin: 0;
  }
  .fm-nl-desc {
    font-size: 0.88rem;
    color: var(--fm-muted);
    line-height: 1.5;
    margin: 0;
  }
  .fm-nl-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .fm-nl-input-group {
    position: relative;
    display: flex;
    align-items: center;
  }
  .fm-nl-input {
    width: 100%;
    background: color-mix(in srgb, var(--fm-text) 8%, transparent);
    border: 1px solid var(--fm-border);
    border-radius: 100px;
    padding: 0.85rem 1.25rem;
    color: var(--fm-text);
    font-family: var(--fm-font-body);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .fm-nl-input::placeholder {
    color: color-mix(in srgb, var(--fm-text) 40%, transparent);
  }
  .fm-nl-input:focus {
    border-color: var(--fm-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--fm-accent) 25%, transparent);
  }
  .fm-nl-submit {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    background: var(--fm-accent);
    color: #000000;
    border: none;
    border-radius: 100px;
    padding: 0.6rem 1.25rem;
    font-family: var(--fm-font-body);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .fm-nl-submit:hover {
    opacity: 0.9;
    transform: translateY(-50%) scale(1.03);
  }
  .fm-nl-gdpr {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--fm-muted);
    line-height: 1.4;
    cursor: pointer;
  }
  .fm-nl-gdpr input {
    margin-top: 2px;
    accent-color: var(--fm-accent);
  }

  /* Bottom Bar */
  .fm-bottom-bar {
    padding-top: 2rem;
    border-top: 1px solid var(--fm-border);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--fm-muted);
  }
  @media (min-width: 768px) {
    .fm-bottom-bar {
      flex-direction: row;
    }
  }

  .fm-copy-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }
  .fm-legal-links {
    display: flex;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .fm-legal-links a {
    color: var(--fm-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .fm-legal-links a:hover {
    color: var(--fm-text);
  }

  /* Payments & Localization */
  .fm-utils-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }
  .fm-payment-icons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .fm-payment-icons li {
    background: #ffffff;
    border-radius: 4px;
    padding: 2px 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 24px;
  }
  .fm-payment-icons svg {
    max-height: 16px;
    width: auto;
  }

  /* Back to Top Floating Button */
  .fm-back-top {
    position: absolute;
    right: clamp(1.25rem, 4vw, 4rem);
    top: 2.5rem;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--fm-card-bg);
    border: 1px solid var(--fm-border);
    color: var(--fm-text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .fm-back-top:hover {
    background: var(--fm-accent);
    color: #000000;
    border-color: var(--fm-accent);
    transform: translateY(-3px);
  }
  .fm-back-top svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    stroke-width: 2.5;
  }
</style>

<footer class="fm-section" id="fm-section-{{ section.id }}" aria-label="Store Footer">
  <div class="fm-container">
    
    <!-- Back To Top Button -->
    <button type="button" class="fm-back-top" id="fm-back-top-{{ section.id }}" aria-label="Scroll back to top">
      <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <div class="fm-main-grid">
      
      <!-- Column 1: Brand Info -->
      <div class="fm-brand-col">
        <a href="{{ routes.root_url }}" class="fm-logo-link">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', class: 'fm-logo-img', alt: shop.name }}
          {%- else -%}
            {{ shop.name }}
          {%- endif -%}
        </a>
        
        {%- if section.settings.tagline != blank -%}
          <p class="fm-tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- if section.settings.show_social -%}
          <ul class="fm-social-list" aria-label="Social Media Links">
            {%- if settings.social_instagram_link != blank -%}
              <li><a href="{{ settings.social_instagram_link }}" class="fm-social-link" target="_blank" rel="noopener" aria-label="Instagram">
                <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a></li>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
              <li><a href="{{ settings.social_facebook_link }}" class="fm-social-link" target="_blank" rel="noopener" aria-label="Facebook">
                <svg viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
              </a></li>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
              <li><a href="{{ settings.social_tiktok_link }}" class="fm-social-link" target="_blank" rel="noopener" aria-label="TikTok">
                <svg viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-.99-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
              </a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      <!-- Column 2: Quick Links 1 -->
      <div class="fm-nav-col" data-expanded="false">
        <h3 class="fm-col-heading" role="button" aria-expanded="false" tabindex="0">
          <span>{{ section.settings.menu_1_title | default: 'Shop' }}</span>
          <svg class="fm-accordion-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </h3>
        <ul class="fm-nav-list">
          {%- assign menu_1 = linklists[section.settings.menu_1] -%}
          {%- if menu_1 != blank -%}
            {%- for link in menu_1.links -%}
              <li class="fm-nav-item"><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li class="fm-nav-item"><a href="#">New Arrivals</a></li>
            <li class="fm-nav-item"><a href="#">Best Sellers</a></li>
            <li class="fm-nav-item"><a href="#">Collections</a></li>
            <li class="fm-nav-item"><a href="#">Accessories</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Column 3: Quick Links 2 -->
      <div class="fm-nav-col" data-expanded="false">
        <h3 class="fm-col-heading" role="button" aria-expanded="false" tabindex="0">
          <span>{{ section.settings.menu_2_title | default: 'Support' }}</span>
          <svg class="fm-accordion-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </h3>
        <ul class="fm-nav-list">
          {%- assign menu_2 = linklists[section.settings.menu_2] -%}
          {%- if menu_2 != blank -%}
            {%- for link in menu_2.links -%}
              <li class="fm-nav-item"><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li class="fm-nav-item"><a href="#">Help Center / FAQ</a></li>
            <li class="fm-nav-item"><a href="#">Shipping & Returns</a></li>
            <li class="fm-nav-item"><a href="#">Order Tracking</a></li>
            <li class="fm-nav-item"><a href="#">Contact Us</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Column 4: Newsletter Box -->
      <div class="fm-newsletter-col">
        <h3 class="fm-nl-title">{{ section.settings.nl_title | default: 'Join The Club' }}</h3>
        <p class="fm-nl-desc">{{ section.settings.nl_desc | default: 'Receive insider access to limited edition drops, private sales, and curated editorial content.' }}</p>
        
        {%- form 'customer', class: 'fm-nl-form', id: 'fm-newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="fm-nl-input-group">
            <input 
              type="email" 
              name="contact[email]" 
              class="fm-nl-input" 
              placeholder="{{ section.settings.nl_placeholder | default: 'Enter your email address...' }}" 
              required
              aria-label="Email address for newsletter"
            >
            <button type="submit" class="fm-nl-submit" aria-label="Subscribe">
              {{ section.settings.nl_btn | default: 'Join' }}
            </button>
          </div>
          {%- if section.settings.show_gdpr -%}
            <label class="fm-nl-gdpr">
              <input type="checkbox" required>
              <span>I agree to receive marketing communications and agree to the <a href="/pages/privacy" style="color: inherit; text-decoration: underline;">Privacy Policy</a>.</span>
            </label>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p style="color: #10b981; font-size: 0.85rem; margin: 0;">✓ Thank you for subscribing to our newsletter!</p>
          {%- elsif form.errors -%}
            <p style="color: #ef4444; font-size: 0.85rem; margin: 0;">✕ {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>

    </div>

    <!-- Bottom Legal & Payment Bar -->
    <div class="fm-bottom-bar">
      <div class="fm-copy-wrap">
        <span>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.</span>
        <ul class="fm-legal-links">
          <li><a href="/pages/terms">Terms of Service</a></li>
          <li><a href="/pages/privacy">Privacy Policy</a></li>
          <li><a href="/pages/cookies">Cookie Policy</a></li>
        </ul>
      </div>

      <div class="fm-utils-wrap">
        {%- if section.settings.show_payment_icons and shop.enabled_payment_types != blank -%}
          <ul class="fm-payment-icons" aria-label="Supported Payment Methods">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

  </div>
</footer>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var sectionEl = document.getElementById('fm-section-' + sectionId);
    if (!sectionEl) return;

    // Mobile Accordion Toggle
    var navCols = sectionEl.querySelectorAll('.fm-nav-col');
    navCols.forEach(function(col) {
      var heading = col.querySelector('.fm-col-heading');
      if (!heading) return;

      heading.addEventListener('click', function() {
        if (window.innerWidth >= 768) return; // Desktop ignore
        var isExpanded = col.getAttribute('data-expanded') === 'true';
        col.setAttribute('data-expanded', !isExpanded);
        heading.setAttribute('aria-expanded', !isExpanded);
      });

      heading.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          heading.click();
        }
      });
    });

    // Smooth Back To Top Scroll
    var backTopBtn = document.getElementById('fm-back-top-' + sectionId);
    if (backTopBtn) {
      backTopBtn.addEventListener('click', function() {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Footer - Minimal Luxury",
  "tag": "section",
  "class": "section-footer-minimal-luxury",
  "settings": [
    {
      "type": "header",
      "content": "Brand Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#38bdf8"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Footer Logo (Optional)"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Brand Tagline",
      "default": "Crafting timeless essentials engineered for everyday luxury and uncompromising performance."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Media Icons",
      "default": true
