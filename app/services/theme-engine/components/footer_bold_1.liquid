{%- comment -%}
  footer_bold_1.liquid — Bold / Streetwear Footer
  
  DESIGN PHILOSOPHY:
  Loud, graphic, heavy borders. Block-letter branding.
  Raw and unapologetic like a zine back cover.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --bft-bg: var(--color-text, #0a0a0a);
    --bft-text: var(--color-accent, #ff3c00);
    --bft-muted: color-mix(in srgb, var(--color-background, #fff) 40%, transparent);
    --bft-border: color-mix(in srgb, var(--bft-text) 30%, transparent);
    --bft-font: var(--font-body, 'Roboto Mono', monospace);
    --bft-font-logo: var(--font-heading, 'Anton', sans-serif);
  }

  .bd-footer {
    background: var(--bft-bg);
    color: var(--bft-text);
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 4vw, 3rem) 1.5rem;
    border-top: 4px solid var(--bft-text);
  }

  .bd-footer__inner {
    max-width: 1440px;
    margin: 0 auto;
  }

  /* ── TOP: Giant logo ──────────── */
  .bd-footer__logo {
    font-family: var(--bft-font-logo);
    font-size: clamp(3rem, 10vw, 8rem);
    text-transform: uppercase;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--bft-text);
    margin-bottom: 2rem;
    word-break: break-word;
  }

  /* ── GRID: Links + Newsletter ── */
  .bd-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2rem 0;
    border-top: 2px solid var(--bft-border);
    border-bottom: 2px solid var(--bft-border);
    margin-bottom: 2rem;
  }
  @media (min-width: 640px) {
    .bd-footer__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bd-footer__col-title {
    font-family: var(--bft-font);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--bft-muted);
    margin-bottom: 1rem;
  }
  .bd-footer__col-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .bd-footer__col-links a {
    font-family: var(--bft-font);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--bft-text);
    text-decoration: none;
    transition: text-decoration 0.15s;
  }
  .bd-footer__col-links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Newsletter */
  .bd-footer__newsletter-form {
    display: flex;
    gap: 0;
    margin-top: 0.5rem;
  }
  .bd-footer__newsletter-input {
    flex: 1;
    padding: 0.75rem 1rem;
    background: transparent;
    border: 2px solid var(--bft-text);
    border-right: none;
    color: var(--bft-text);
    font-family: var(--bft-font);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    outline: none;
  }
  .bd-footer__newsletter-input::placeholder {
    color: var(--bft-muted);
  }
  .bd-footer__newsletter-btn {
    padding: 0.75rem 1.5rem;
    background: var(--bft-text);
    color: var(--bft-bg);
    border: 2px solid var(--bft-text);
    font-family: var(--bft-font);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .bd-footer__newsletter-btn:hover {
    background: transparent;
    color: var(--bft-text);
  }

  /* ── BOTTOM: Copyright + Social ── */
  .bd-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    text-align: center;
  }
  @media (min-width: 640px) {
    .bd-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .bd-footer__copyright {
    font-family: var(--bft-font);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--bft-muted);
  }

  .bd-footer__social {
    display: flex;
    gap: 1.5rem;
  }
  .bd-footer__social a {
    font-family: var(--bft-font);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--bft-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .bd-footer__social a:hover {
    color: var(--bft-text);
  }
</style>

<footer class="bd-footer">
  <div class="bd-footer__inner">

    <div class="bd-footer__logo">{{ shop.name }}</div>

    <div class="bd-footer__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          <div>
            <div class="bd-footer__col-title">{{ block.settings.title }}</div>
            <ul class="bd-footer__col-links">
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        {%- if block.type == 'newsletter' -%}
          <div>
            <div class="bd-footer__col-title">{{ block.settings.heading | default: 'Stay in the loop' }}</div>
            <form class="bd-footer__newsletter-form" action="/contact#contact_form" method="post">
              <input type="hidden" name="form_type" value="customer">
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input type="email" name="contact[email]" class="bd-footer__newsletter-input" placeholder="YOUR EMAIL" required autocomplete="email" aria-label="Email">
              <button type="submit" class="bd-footer__newsletter-btn">GO →</button>
            </form>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="bd-footer__bottom">
      <div class="bd-footer__copyright">&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All Rights Reserved.</div>
      <div class="bd-footer__social">
        {%- if section.settings.social_instagram != blank -%}
          <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener">IG</a>
        {%- endif -%}
        {%- if section.settings.social_tiktok != blank -%}
          <a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener">TT</a>
        {%- endif -%}
        {%- if section.settings.social_twitter != blank -%}
          <a href="{{ section.settings.social_twitter }}" target="_blank" rel="noopener">X</a>
        {%- endif -%}
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Bold Footer",
  "tag": "section",
  "class": "section-footer-bold",
  "settings": [
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "Twitter / X URL"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column Title",
          "default": "Menu"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Stay in the loop"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bold Footer",
      "blocks": [
        { "type": "column", "settings": { "title": "Drops", "menu": "footer" } },
        { "type": "column", "settings": { "title": "Info", "menu": "footer" } },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
