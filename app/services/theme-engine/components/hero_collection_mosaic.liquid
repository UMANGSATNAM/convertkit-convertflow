{%- comment -%}
  hero_collection_mosaic.liquid — Asymmetric Collection Bento Mosaic
  
  DESIGN PHILOSOPHY:
  High-impact visual gallery layout. Spanning bento items create dynamic
  rhythm for featuring key collections or lookbook imagery. Smooth zoom
  hover effects and dark gradient protection for readable typography.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --hcm-bg: var(--color-background, #ffffff);
    --hcm-text: var(--color-text, #ffffff);
    --hcm-muted: color-mix(in srgb, var(--hcm-text) 80%, transparent);
    --hcm-font: var(--font-body, 'Inter', -apple-system, sans-serif);
    --hcm-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
  }

  .hcm-section {
    background: var(--hcm-bg);
    padding: clamp(2rem, 5vw, 4.5rem) clamp(1rem, 3.5vw, 3rem);
  }

  .hcm-inner {
    max-width: 1400px;
    margin: 0 auto;
  }

  .hcm-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .hcm-grid {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(2, clamp(240px, 28vw, 340px));
      gap: 1.25rem;
    }
    .hcm-item-0 { grid-column: 1 / 3; grid-row: 1 / 3; }
    .hcm-item-1 { grid-column: 3 / 5; grid-row: 1 / 2; }
    .hcm-item-2 { grid-column: 3 / 4; grid-row: 2 / 3; }
    .hcm-item-3 { grid-column: 4 / 5; grid-row: 2 / 3; }
  }

  .hcm-card {
    position: relative;
    border-radius: var(--radius-card, 16px);
    overflow: hidden;
    text-decoration: none;
    color: var(--hcm-text);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    min-height: 240px;
    background: #18181b;
  }

  .hcm-media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .hcm-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hcm-card:hover .hcm-media img {
    transform: scale(1.06);
  }

  .hcm-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.65) 100%);
    z-index: 2;
    transition: background 0.3s ease;
  }
  .hcm-card:hover .hcm-overlay {
    background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.75) 100%);
  }

  .hcm-content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .hcm-badge {
    font-family: var(--hcm-font);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--hcm-muted);
  }

  .hcm-title {
    font-family: var(--hcm-font-head);
    font-size: clamp(1.35rem, 2.5vw, 2.25rem);
    font-weight: 700;
    margin: 0;
    line-height: 1.15;
    color: var(--hcm-text);
  }

  .hcm-btn {
    font-family: var(--hcm-font);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--hcm-text);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.4rem;
    transition: transform 0.2s ease;
  }
  .hcm-card:hover .hcm-btn {
    transform: translateX(4px);
  }
</style>

<section class="hcm-section" aria-label="Collection Gallery">
  <div class="hcm-inner">
    <div class="hcm-grid">
      {%- for block in section.blocks limit: 4 -%}
        {%- assign coll = collections[block.settings.collection] -%}
        <a href="{{ block.settings.url | default: coll.url | default: '#' }}" class="hcm-card hcm-item-{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="hcm-media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- elsif coll.image != blank -%}
              {{ coll.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: coll.title }}
            {%- else -%}
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #27272a; color: #71717a;">
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
          <div class="hcm-overlay"></div>
          <div class="hcm-content">
            {%- if block.settings.badge != blank -%}
              <span class="hcm-badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            <h3 class="hcm-title">{{ block.settings.title | default: coll.title | default: 'Featured Collection' }}</h3>
            <span class="hcm-btn">{{ block.settings.button_text | default: 'Explore Now' }} →</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Bento Mosaic",
  "tag": "section",
  "class": "section-hero-mosaic",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "collection",
      "name": "Mosaic Box",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Shopify Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom Image (Override)" },
        { "type": "text", "id": "badge", "label": "Badge Text", "default": "New Arrivals" },
        { "type": "text", "id": "title", "label": "Title (Override)", "default": "Menswear Edit" },
        { "type": "text", "id": "button_text", "label": "Button Text", "default": "Shop Now" },
        { "type": "url", "id": "url", "label": "Custom URL (Override)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Bento Mosaic",
      "blocks": [
        { "type": "collection", "settings": { "badge": "New Season", "title": "The Autumn Edit", "button_text": "Discover More" } },
        { "type": "collection", "settings": { "badge": "Best Sellers", "title": "Iconic Footwear", "button_text": "Shop Now" } },
        { "type": "collection", "settings": { "badge": "Essentials", "title": "Accessories", "button_text": "Explore" } },
        { "type": "collection", "settings": { "badge": "Limited", "title": "Exclusives", "button_text": "View All" } }
      ]
    }
  ]
}
{% endschema %}
