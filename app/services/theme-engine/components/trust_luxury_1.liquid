{%- comment -%}
  trust_luxury_1.liquid — Luxury Heritage & Guarantee Seals
  
  DESIGN PHILOSOPHY:
  Aristocratic elegance. Serif headlines, generous whitespace, and
  understated guarantees (e.g., "Handcrafted in Milan", "Lifetime Care").
  Designed to build long-term brand equity and prestige.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --lxt-bg: var(--color-surface, var(--color-background, #faf9f7));
    --lxt-text: var(--color-text, #181818);
    --lxt-muted: color-mix(in srgb, var(--lxt-text) 50%, transparent);
    --lxt-border: color-mix(in srgb, var(--lxt-text) 12%, transparent);
    --lxt-accent: var(--color-accent, #b89758);
    --lxt-font: var(--font-body, 'Inter', -apple-system, sans-serif);
    --lxt-font-serif: var(--font-heading, 'Playfair Display', Georgia, serif);
  }

  .lxt-section {
    background: var(--lxt-bg);
    padding: clamp(3.5rem, 8vw, 6.5rem) clamp(1.25rem, 4vw, 4rem);
    border-top: 1px solid var(--lxt-border);
    border-bottom: 1px solid var(--lxt-border);
  }

  .lxt-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .lxt-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto clamp(2.5rem, 5vw, 4.5rem);
  }
  .lxt-eyebrow {
    font-family: var(--lxt-font);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--lxt-accent);
    margin-bottom: 0.75rem;
  }
  .lxt-title {
    font-family: var(--lxt-font-serif);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 400;
    color: var(--lxt-text);
    margin: 0;
    line-height: 1.25;
  }

  .lxt-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    position: relative;
  }
  @media (min-width: 768px) {
    .lxt-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .lxt-item {
    text-align: center;
    padding: 0 1rem;
    position: relative;
  }
  @media (min-width: 768px) {
    .lxt-item:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 15%;
      right: 0;
      height: 70%;
      width: 1px;
      background: var(--lxt-border);
    }
  }

  .lxt-seal {
    width: 44px;
    height: 44px;
    margin: 0 auto 1.25rem;
    color: var(--lxt-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lxt-seal svg {
    width: 32px;
    height: 32px;
    stroke-width: 1.25;
    stroke: currentColor;
    fill: none;
  }

  .lxt-item-title {
    font-family: var(--lxt-font-serif);
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--lxt-text);
    margin: 0 0 0.6rem 0;
    letter-spacing: 0.02em;
  }

  .lxt-item-desc {
    font-family: var(--lxt-font);
    font-size: 0.82rem;
    color: var(--lxt-muted);
    line-height: 1.7;
    margin: 0;
    max-width: 280px;
    margin-left: auto;
    margin-right: auto;
  }
</style>

<section class="lxt-section" aria-labelledby="lxt-title-{{ section.id }}">
  <div class="lxt-inner">
    {%- if section.settings.title != blank or section.settings.eyebrow != blank -%}
      <div class="lxt-header">
        {%- if section.settings.eyebrow != blank -%}
          <div class="lxt-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="lxt-title-{{ section.id }}" class="lxt-title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="lxt-grid">
      {%- for block in section.blocks -%}
        <div class="lxt-item" {{ block.shopify_attributes }}>
          <div class="lxt-seal" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'heritage' -%}
                <svg viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              {%- when 'craft' -%}
                <svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              {%- when 'care' -%}
                <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            {%- endcase -%}
          </div>
          <h3 class="lxt-item-title">{{ block.settings.title }}</h3>
          <p class="lxt-item-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luxury Guarantee Seals",
  "tag": "section",
  "class": "section-trust-luxury",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Maison Standards"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Uncompromising Quality & Care"
    }
  ],
  "blocks": [
    {
      "type": "seal",
      "name": "Guarantee Seal",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "heritage", "label": "Heritage / Prestige" },
            { "value": "craft", "label": "Handcrafted Artistry" },
            { "value": "care", "label": "Complimentary Care / Heart" },
            { "value": "check", "label": "Approved Seal" }
          ],
          "default": "craft"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Artisanal Craftsmanship"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Each piece is meticulously assembled by master craftsmen in limited quantities."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Guarantee Seals",
      "blocks": [
        { "type": "seal", "settings": { "icon": "craft", "title": "Artisanal Craftsmanship", "description": "Each piece is meticulously assembled by master craftsmen in limited quantities." } },
        { "type": "seal", "settings": { "icon": "heritage", "title": "Ethical Sourcing", "description": "We partner exclusively with certified sustainable and responsible ateliers." } },
        { "type": "seal", "settings": { "icon": "care", "title": "Complimentary Care", "description": "Enjoy lifetime maintenance and cleaning services at any of our boutiques." } }
      ]
    }
  ]
}
{% endschema %}
