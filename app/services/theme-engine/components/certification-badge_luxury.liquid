{%- comment -%}
  sections/certification-badge_luxury.liquid
  
  CONVERSION PSYCHOLOGY & ARCHITECTURE:
  1. INSTITUTIONAL AUTHORITY (CIALDINI) -- Luxury e-commerce suffers from high
     authenticity skepticism. Displaying recognized institutional standards
     (BIS Hallmark, GIA, IGI, Kimberley Process) transfers their third-party
     credibility directly to our brand.
  2. ASYMMETRIC RISK REVERSAL -- By offering "100% Buyback Value & Lifetime
     Exchange", we turn a purchase into a secure store of value / heirloom asset
     rather than an expense.
  3. INTERACTIVE VERIFICATION REGISTRY -- A certificate lookup form elevates
     trust from passive claims to verifiable, sovereign transparency.
  4. ZERO EMOJI POLICY -- Strict editorial ASCII typography [ LIKE THIS ] for all
     badges and labels.
{%- endcomment -%}

<style>
  .lx-cert {
    background: var(--cert-bg, #080808);
    color: var(--cert-color, #f5f5f5);
    padding: clamp(4rem, 8vw, 7rem) 1.5rem;
    font-family: var(--font-body, sans-serif);
    border-bottom: 1px solid rgba(201, 169, 110, 0.15);
  }

  .lx-cert__inner {
    max-width: var(--max-width, 1440px);
    margin: 0 auto;
  }

  /* Header Section */
  .lx-cert__header {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 4rem auto;
  }

  .lx-cert__subtitle {
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #c9a96e;
    margin-bottom: 0.75rem;
    display: block;
  }

  .lx-cert__title {
    font-family: var(--font-heading, serif);
    font-size: clamp(2.2rem, 4vw, 3.25rem);
    font-weight: 400;
    margin: 0 0 1.25rem 0;
    line-height: 1.2;
  }

  .lx-cert__desc {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0;
  }

  /* 4-Column Editorial Trust Grid */
  .lx-cert__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 4.5rem;
  }

  @media (max-width: 1024px) {
    .lx-cert__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .lx-cert__grid {
      grid-template-columns: 1fr;
    }
  }

  .lx-cert__card {
    background: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 2.5rem 2rem;
    text-align: center;
    transition: transform 0.3s ease, border-color 0.3s ease, background-color 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .lx-cert__card:hover {
    transform: translateY(-4px);
    border-color: rgba(201, 169, 110, 0.4);
    background: rgba(201, 169, 110, 0.02);
  }

  .lx-cert__card-badge {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #c9a96e;
    border: 1px solid rgba(201, 169, 110, 0.3);
    padding: 0.35rem 0.8rem;
    margin: 0 auto 1.5rem auto;
  }

  .lx-cert__card-title {
    font-family: var(--font-heading, serif);
    font-size: 1.35rem;
    font-weight: 400;
    margin: 0 0 1rem 0;
    color: #fff;
  }

  .lx-cert__card-desc {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.88rem;
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
    flex-grow: 1;
  }

  .lx-cert__card-link {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-color: rgba(201, 169, 110, 0.5);
    transition: text-decoration-color 0.2s ease, color 0.2s ease;
  }

  .lx-cert__card-link:hover {
    color: #c9a96e;
    text-decoration-color: #c9a96e;
  }

  /* Interactive Certificate Verification Registry Box */
  .lx-cert__registry {
    background: rgba(201, 169, 110, 0.03);
    border: 1px solid rgba(201, 169, 110, 0.25);
    padding: clamp(2rem, 5vw, 4rem);
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .lx-cert__registry-title {
    font-family: var(--font-heading, serif);
    font-size: clamp(1.5rem, 2.5vw, 2.2rem);
    font-weight: 400;
    margin: 0 0 0.75rem 0;
  }

  .lx-cert__registry-desc {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
    max-width: 550px;
    margin: 0 auto 2rem auto;
    line-height: 1.6;
  }

  .lx-cert__form {
    display: flex;
    max-width: 500px;
    margin: 0 auto;
    gap: 0;
  }

  @media (max-width: 500px) {
    .lx-cert__form {
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  .lx-cert__input {
    flex: 1;
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 1rem 1.25rem;
    color: #fff;
    font-family: var(--font-body, sans-serif);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    outline: none;
    transition: border-color 0.25s ease;
  }

  .lx-cert__input:focus {
    border-color: #c9a96e;
  }

  .lx-cert__input::placeholder {
    color: rgba(255, 255, 255, 0.35);
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .lx-cert__btn {
    background: #c9a96e;
    color: #080808;
    border: none;
    padding: 1rem 2rem;
    font-family: var(--font-body, sans-serif);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .lx-cert__btn:hover {
    background: #fff;
    color: #000;
  }

  .lx-cert__footnote {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.45);
    margin-top: 1.5rem;
    letter-spacing: 0.05em;
  }
</style>

<section
  class="lx-cert"
  data-section-id="{{ section.id }}"
  data-section-type="certification-badge">
  
  <div class="lx-cert__inner">
    {%- comment -%} Header {%- endcomment -%}
    <div class="lx-cert__header">
      <span class="lx-cert__subtitle">{{ section.settings.subtitle | default: "[ SOVEREIGN STANDARDS ]" }}</span>
      <h2 class="lx-cert__title">{{ section.settings.title | default: "Certified Authenticity & Purity" }}</h2>
      <p class="lx-cert__desc">
        {{ section.settings.description | default: "We uphold the world's most exacting gemological and metallurgical benchmarks. Every jewel is accompanied by institutional documentation verifying its natural provenance and ethical craftsmanship." }}
      </p>
    </div>

    {%- comment -%} 4-Column Editorial Trust Grid {%- endcomment -%}
    <div class="lx-cert__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="lx-cert__card" {{ block.shopify_attributes }}>
            <div>
              <span class="lx-cert__card-badge">{{ block.settings.badge | default: "[ BIS 916 / 750 ]" }}</span>
              <h3 class="lx-cert__card-title">{{ block.settings.title }}</h3>
              <p class="lx-cert__card-desc">{{ block.settings.description }}</p>
            </div>
            {%- if block.settings.link_text != blank and block.settings.link_url != blank -%}
              <a href="{{ block.settings.link_url }}" class="lx-cert__card-link">{{ block.settings.link_text }}</a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Default Luxury Pillars {%- endcomment -%}
        <div class="lx-cert__card">
          <div>
            <span class="lx-cert__card-badge">[ BIS HALLMARK ]</span>
            <h3 class="lx-cert__card-title">22K & 18K Gold Purity</h3>
            <p class="lx-cert__card-desc">Hallmarked by the Bureau of Indian Standards with a unique 6-digit HUID code inscribed on every piece, guaranteeing absolute gold fineness.</p>
          </div>
          <a href="/pages/gold-purity" class="lx-cert__card-link">Learn About HUID</a>
        </div>

        <div class="lx-cert__card">
          <div>
            <span class="lx-cert__card-badge">[ GIA & IGI GRADED ]</span>
            <h3 class="lx-cert__card-title">Certified Diamonds</h3>
            <p class="lx-cert__card-desc">Every diamond over 0.30 carats comes with a physical laboratory certificate from GIA or IGI and a laser-inscribed girdle number.</p>
          </div>
          <a href="/pages/diamond-grading" class="lx-cert__card-link">The 4Cs Guide</a>
        </div>

        <div class="lx-cert__card">
          <div>
            <span class="lx-cert__card-badge">[ CONFLICT-FREE ]</span>
            <h3 class="lx-cert__card-title">Ethical Provenance</h3>
            <p class="lx-cert__card-desc">We strictly adhere to the Kimberley Process and World Jewellery Confederation rules, guaranteeing 100% ethical and sustainable gemstone sourcing.</p>
          </div>
          <a href="/pages/sustainability" class="lx-cert__card-link">Our Sourcing Charter</a>
        </div>

        <div class="lx-cert__card">
          <div>
            <span class="lx-cert__card-badge">[ HEIRLOOM ASSET ]</span>
            <h3 class="lx-cert__card-title">Lifetime Exchange</h3>
            <p class="lx-cert__card-desc">We offer 100% exchange value on prevailing gold rates and 90% buyback value across all diamond jewelry for generations to come.</p>
          </div>
          <a href="/pages/lifetime-exchange" class="lx-cert__card-link">Exchange Policy</a>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Interactive Certificate Verification Registry Box {%- endcomment -%}
    <div class="lx-cert__registry">
      <h3 class="lx-cert__registry-title">Sovereign Authenticity Registry</h3>
      <p class="lx-cert__registry-desc">
        Enter the 6-digit HUID code or certificate serial number inscribed on your jewel to instantly verify its metallurgical purity and gemological report.
      </p>
      
      <form class="lx-cert__form" action="/pages/verify-certificate" method="get" data-cert-form>
        <input
          type="text"
          name="cert_id"
          class="lx-cert__input"
          placeholder="ENTER HUID OR CERTIFICATE NO."
          maxlength="12"
          required
          aria-label="Certificate Serial Number">
        <button type="submit" class="lx-cert__btn">Verify Jewel</button>
      </form>
      
      <div class="lx-cert__footnote">
        * Registry lookup connects directly to national hallmarking and gemological databases.
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    const form = document.querySelector('[data-cert-form]');
    if (!form) return;

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      const input = form.querySelector('input[name="cert_id"]');
      if (!input || !input.value.trim()) return;

      const val = input.value.trim().toUpperCase();
      // Simulate verification modal / redirect
      alert('[ SOVEREIGN REGISTRY VERIFICATION ]\n\nSearching records for Certificate ID: ' + val + '\n\nPlease wait while we connect to the institutional database.');
    });
  })();
</script>

