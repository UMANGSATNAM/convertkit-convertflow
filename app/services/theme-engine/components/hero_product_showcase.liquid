{%- comment -%}
  hero_product_showcase.liquid — Premium Product Showcase Hero
  
  DESIGN PHILOSOPHY:
  Flagship product presentation hero. Designed for launching key items,
  hardware devices, or luxury goods. Features clean typography,
  highlight badges, price callout, and responsive image scaling.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --hps-bg: var(--color-surface, var(--color-background, #090d16));
    --hps-text: var(--color-text, #ffffff);
    --hps-muted: color-mix(in srgb, var(--hps-text) 65%, transparent);
    --hps-border: color-mix(in srgb, var(--hps-text) 12%, transparent);
    --hps-accent: var(--color-accent, #6366f1);
    --hps-font: var(--font-body, 'Inter', -apple-system, sans-serif);
    --hps-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
  }

  .hps-section {
    background: var(--hps-bg);
    padding: clamp(3.5rem, 8vw, 7rem) clamp(1.25rem, 4vw, 3.5rem);
    position: relative;
    overflow: hidden;
  }

  .hps-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  @media (min-width: 992px) {
    .hps-inner {
      grid-template-columns: 1fr 1.1fr;
    }
  }

  .hps-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    z-index: 2;
  }

  .hps-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: color-mix(in srgb, var(--hps-accent) 15%, transparent);
    color: var(--hps-accent);
    font-family: var(--hps-font);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.4rem 0.9rem;
    border-radius: 100px;
    border: 1px solid color-mix(in srgb, var(--hps-accent) 35%, transparent);
  }

  .hps-title {
    font-family: var(--hps-font-head);
    font-size: clamp(2.25rem, 5vw, 4.25rem);
    font-weight: 700;
    line-height: 1.08;
    color: var(--hps-text);
    margin: 0;
  }

  .hps-desc {
    font-family: var(--hps-font);
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--hps-muted);
    line-height: 1.65;
    margin: 0;
    max-width: 520px;
  }

  .hps-price-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .hps-price {
    font-family: var(--hps-font-head);
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--hps-text);
  }
  .hps-compare {
    font-family: var(--hps-font);
    font-size: 1.15rem;
    color: var(--hps-muted);
    text-decoration: line-through;
  }

  .hps-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .hps-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--hps-font);
    font-size: 0.95rem;
    font-weight: 600;
    color: #ffffff;
    background: var(--hps-accent);
    padding: 1rem 2.25rem;
    border-radius: 100px;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 10px 25px -5px color-mix(in srgb, var(--hps-accent) 40%, transparent);
  }
  .hps-btn-primary:hover {
    opacity: 0.92;
    transform: translateY(-2px);
    box-shadow: 0 15px 30px -5px color-mix(in srgb, var(--hps-accent) 50%, transparent);
  }

  .hps-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--hps-font);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--hps-text);
    background: color-mix(in srgb, var(--hps-text) 8%, transparent);
    padding: 1rem 2rem;
    border-radius: 100px;
    text-decoration: none;
    border: 1px solid var(--hps-border);
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .hps-btn-secondary:hover {
    background: color-mix(in srgb, var(--hps-text) 14%, transparent);
    border-color: var(--hps-text);
  }

  .hps-media-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }
  .hps-media-wrap::before {
    content: '';
    position: absolute;
    width: 80%;
    height: 80%;
    background: radial-gradient(circle, color-mix(in srgb, var(--hps-accent) 30%, transparent) 0%, transparent 70%);
    z-index: -1;
    filter: blur(40px);
  }
  .hps-media {
    width: 100%;
    max-height: 640px;
    object-fit: contain;
    filter: drop-shadow(0 25px 50px rgba(0,0,0,0.3));
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hps-media-wrap:hover .hps-media {
    transform: scale(1.04) rotate(-1deg);
  }
</style>

<section class="hps-section" aria-labelledby="hps-title-{{ section.id }}">
  <div class="hps-inner">
    <div class="hps-content">
      {%- if section.settings.badge != blank -%}
        <div class="hps-badge">{{ section.settings.badge }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h1 id="hps-title-{{ section.id }}" class="hps-title">{{ section.settings.title }}</h1>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="hps-desc">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      {%- if section.settings.price != blank -%}
        <div class="hps-price-wrap">
          <span class="hps-price">{{ section.settings.price }}</span>
          {%- if section.settings.compare_price != blank -%}
            <span class="hps-compare">{{ section.settings.compare_price }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="hps-actions">
        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_link | default: '/products/all' }}" class="hps-btn-primary">{{ section.settings.btn_label }} →</a>
        {%- endif -%}
        {%- if section.settings.btn_sec_label != blank -%}
          <a href="{{ section.settings.btn_sec_link | default: '/pages/about' }}" class="hps-btn-secondary">{{ section.settings.btn_sec_label }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="hps-media-wrap">
      {%- if section.settings.product_image != blank -%}
        {{ section.settings.product_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: section.settings.title, class: 'hps-media' }}
      {%- else -%}
        <div style="width: 100%; height: 420px; display: flex; align-items: center; justify-content: center; color: var(--hps-muted);">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Showcase Hero",
  "tag": "section",
  "class": "section-hero-product-showcase",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Callout",
      "default": "Flagship Release"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Ultimate Device"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Engineered with aerospace-grade aluminum and customized precision acoustics. Experience sound like never before."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price Callout",
      "default": "$499"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare Price (Optional)",
      "default": "$599"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image (Transparent PNG ideal)"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Primary Button Text",
      "default": "Pre-Order Now"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "btn_sec_label",
      "label": "Secondary Button Text",
      "default": "View Tech Specs"
    },
    {
      "type": "url",
      "id": "btn_sec_link",
      "label": "Secondary Button URL"
    }
  ],
  "presets": [
    {
      "name": "Product Showcase Hero"
    }
  ]
}
{% endschema %}
