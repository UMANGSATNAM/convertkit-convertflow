{%- comment -%}
  trust_before_after_slider.liquid — Ultra-Comprehensive Before & After Comparison Slider
  
  DESIGN PHILOSOPHY:
  An architectural visual verification engine engineered to demonstrate dramatic upgrades in
  workstation acoustics, desk aesthetics, or keycap durability. Features smooth mouse/touch
  drag scrubbing with custom divider physics, before/after label badges, and an accessible
  Laboratory Test Report Lightbox Modal Dialog detailing testing metrics.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --tba-bg: {{ section.settings.bg_color | default: '#0f172a' }};
    --tba-card-bg: {{ section.settings.card_bg_color | default: '#1e293b' }};
    --tba-text: {{ section.settings.text_color | default: '#ffffff' }};
    --tba-muted: color-mix(in srgb, var(--tba-text) 65%, transparent);
    --tba-border: color-mix(in srgb, var(--tba-text) 15%, transparent);
    --tba-accent: {{ section.settings.accent_color | default: '#38bdf8' }};
    --tba-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --tba-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --tba-padding-top: clamp(4rem, 8vw, 7rem);
    --tba-padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .tba-section {
    background-color: var(--tba-bg);
    color: var(--tba-text);
    font-family: var(--tba-font-body);
    padding: var(--tba-padding-top) clamp(1.25rem, 4vw, 4rem) var(--tba-padding-bottom);
    border-bottom: 1px solid var(--tba-border);
    position: relative;
    overflow: hidden;
  }

  .tba-container {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* Section Header */
  .tba-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--tba-border);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .tba-head-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 680px;
  }
  .tba-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--tba-accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tba-eyebrow::before {
    content: "";
    width: 20px;
    height: 2px;
    background: var(--tba-accent);
  }
  .tba-title {
    font-family: var(--tba-font-head);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }
  .tba-desc {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--tba-muted);
    line-height: 1.6;
    margin: 0;
  }
  .tba-report-btn {
    background: var(--tba-text);
    color: var(--tba-bg);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.9rem 1.85rem;
    border-radius: 100px;
    border: none;
    cursor: pointer;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tba-report-btn:hover {
    background: var(--tba-accent);
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* Slider Card Wrap */
  .tba-slider-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 380px;
    border-radius: 36px;
    overflow: hidden;
    border: 1px solid var(--tba-border);
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.6);
    background: #000000;
    user-select: none;
    -webkit-user-select: none;
  }

  /* After Image (Base / Background) */
  .tba-after-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .tba-after-layer img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Before Image (Top Layer, Clipped via JS) */
  .tba-before-layer {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 50%; /* Default 50% start */
    overflow: hidden;
    z-index: 2;
  }
  .tba-before-img-wrap {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
  }
  .tba-before-layer img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Draggable Divider Handle Line */
  .tba-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 3px;
    background: #ffffff;
    z-index: 10;
    transform: translateX(-50%);
    cursor: ew-resize;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.8);
  }
  .tba-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #ffffff;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    border: 3px solid var(--tba-accent);
    transition: transform 0.2s ease;
  }
  .tba-divider:hover .tba-handle,
  .tba-slider-box:active .tba-handle {
    transform: translate(-50%, -50%) scale(1.15);
  }
  .tba-handle svg { width: 22px; height: 22px; stroke: currentColor; stroke-width: 2.5; fill: none; }

  /* Label Badges */
  .tba-badge-before, .tba-badge-after {
    position: absolute;
    top: clamp(1.5rem, 3vw, 2.5rem);
    z-index: 5;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    padding: 0.5rem 1.25rem;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .tba-badge-before { left: clamp(1.5rem, 3vw, 2.5rem); }
  .tba-badge-after { right: clamp(1.5rem, 3vw, 2.5rem); }

  /* Laboratory Test Report Lightbox Modal */
  .tba-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .tba-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .tba-modal {
    background: var(--tba-card-bg);
    color: var(--tba-text);
    border: 1px solid var(--tba-border);
    border-radius: 36px;
    max-width: 720px;
    width: 100%;
    padding: clamp(2.5rem, 5vw, 4rem);
    position: relative;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.9);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tba-modal-overlay[data-open="true"] .tba-modal {
    transform: scale(1);
  }
  .tba-modal-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
  }
</style>

<section class="tba-section" id="tba-section-{{ section.id }}" aria-labelledby="tba-title-{{ section.id }}">
  <div class="tba-container">
    
    <!-- Section Header -->
    <div class="tba-header">
      <div class="tba-head-text">
        {%- if section.settings.eyebrow != blank -%}
          <div class="tba-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="tba-title-{{ section.id }}" class="tba-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="tba-desc">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      <button type="button" class="tba-report-btn" id="tba-report-btn-{{ section.id }}">
        <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        <span>View Laboratory Test Report</span>
      </button>
    </div>

    <!-- Comparison Slider Box -->
    <div class="tba-slider-box" id="tba-box-{{ section.id }}" role="region" aria-label="Before and after image comparison slider">
      
      <!-- After (Background) -->
      <div class="tba-after-layer">
        {%- if section.settings.image_after != blank -%}
          {{ section.settings.image_after | image_url: width: 2000 | image_tag: loading: 'lazy', alt: 'After upgrade specification' }}
        {%- else -%}
          <div style="width:100%;height:100%;background:#0a0f1d;display:flex;align-items:center;justify-content:center;color:#38bdf8;font-size:1.5rem;font-weight:700;">AFTER: Obsidian CNC Mechanical (6.5° Incline)</div>
        {%- endif -%}
      </div>

      <!-- Before (Top Layer) -->
      <div class="tba-before-layer" id="tba-before-{{ section.id }}">
        <div class="tba-before-img-wrap" id="tba-wrap-{{ section.id }}">
          {%- if section.settings.image_before != blank -%}
            {{ section.settings.image_before | image_url: width: 2000 | image_tag: loading: 'lazy', alt: 'Before upgrade specification' }}
          {%- else -%}
            <div style="width:100%;height:100%;background:#334155;display:flex;align-items:center;justify-content:center;color:#f8fafc;font-size:1.5rem;font-weight:700;">BEFORE: Standard Stock Keyboard (Flat Profile)</div>
          {%- endif -%}
        </div>
      </div>

      <!-- Draggable Divider Line -->
      <div class="tba-divider" id="tba-divider-{{ section.id }}" style="left: 50%;">
        <div class="tba-handle">
          <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
          <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </div>
      </div>

      <!-- Label Badges -->
      <span class="tba-badge-before">{{ section.settings.label_before | default: 'BEFORE: STOCK SETUP' }}</span>
      <span class="tba-badge-after">{{ section.settings.label_after | default: 'AFTER: OBSIDIAN ATELIER' }}</span>

    </div>

  </div>

  <!-- Laboratory Test Report Modal -->
  <div class="tba-modal-overlay" id="tba-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="tba-modal">
      <button type="button" class="tba-modal-close" id="tba-modal-close-{{ section.id }}" aria-label="Close laboratory report modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div style="display:flex;align-items:center;gap:0.75rem;">
        <span style="width:12px;height:12px;border-radius:50%;background:var(--tba-accent);"></span>
        <span style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:rgba(255,255,255,0.6);">Laboratory Audit #442-A</span>
      </div>

      <h3 style="font-family:var(--tba-font-head);font-size:1.85rem;margin:0;">Acoustic & Ergonomic Delta Analysis</h3>
      <p style="font-size:0.98rem;line-height:1.65;color:rgba(255,255,255,0.8);margin:0;">This comparative study evaluates the reduction in high-frequency acoustic rattle and wrist fatigue when transitioning from a standard plastic membrane chassis to an unibody CNC aluminum workstation.</p>

      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;border-top:1px solid rgba(255,255,255,0.15);padding-top:1.5rem;">
        <div style="background:rgba(255,255,255,0.05);border-radius:20px;padding:1.25rem;">
          <span style="font-size:0.75rem;color:rgba(255,255,255,0.6);text-transform:uppercase;letter-spacing:0.1em;display:block;margin-bottom:0.25rem;">Acoustic Dampening</span>
          <strong style="font-size:1.5rem;color:var(--tba-accent);font-family:var(--tba-font-head);display:block;">-42.5 dB</strong>
          <span style="font-size:0.8rem;color:rgba(255,255,255,0.7);">Elimination of internal case reverberation via silicone gasket mounting.</span>
        </div>
        <div style="background:rgba(255,255,255,0.05);border-radius:20px;padding:1.25rem;">
          <span style="font-size:0.75rem;color:rgba(255,255,255,0.6);text-transform:uppercase;letter-spacing:0.1em;display:block;margin-bottom:0.25rem;">Ergonomic Strain</span>
          <strong style="font-size:1.5rem;color:#10b981;font-family:var(--tba-font-head);display:block;">-68.0 %</strong>
          <span style="font-size:0.8rem;color:rgba(255,255,255,0.7);">Reduced carpal dorsiflexion angle over an 8-hour continuous work session.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var box = document.getElementById('tba-box-' + sid);
    if (!box) return;

    var beforeLayer = document.getElementById('tba-before-' + sid);
    var beforeWrap = document.getElementById('tba-wrap-' + sid);
    var divider = document.getElementById('tba-divider-' + sid);
    var isDragging = false;

    function matchWidth() {
      if (beforeWrap && box) {
        beforeWrap.style.width = box.offsetWidth + 'px';
      }
    }
    matchWidth();
    window.addEventListener('resize', matchWidth);

    function updateSlider(pageX) {
      var rect = box.getBoundingClientRect();
      var offsetX = pageX - rect.left - window.scrollX;
      var width = rect.width;
      var percent = (offsetX / width) * 100;
      if (percent < 2) percent = 2;
      if (percent > 98) percent = 98;

      beforeLayer.style.width = percent + '%';
      divider.style.left = percent + '%';
    }

    box.addEventListener('mousedown', function(e) {
      isDragging = true;
      updateSlider(e.pageX);
    });
    window.addEventListener('mousemove', function(e) {
      if (!isDragging) return;
      updateSlider(e.pageX);
    });
    window.addEventListener('mouseup', function() { isDragging = false; });

    // Touch support
    box.addEventListener('touchstart', function(e) {
      isDragging = true;
      if (e.touches[0]) updateSlider(e.touches[0].pageX);
    });
    window.addEventListener('touchmove', function(e) {
      if (!isDragging) return;
      if (e.touches[0]) updateSlider(e.touches[0].pageX);
    });
    window.addEventListener('touchend', function() { isDragging = false; });

    // Modal Controller
    var modalOverlay = document.getElementById('tba-modal-' + sid);
    var modalClose = document.getElementById('tba-modal-close-' + sid);
    var reportBtn = document.getElementById('tba-report-btn-' + sid);

    if (modalOverlay && modalClose && reportBtn) {
      reportBtn.addEventListener('click', function() {
        modalOverlay.setAttribute('data-open', 'true');
        modalOverlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Before & After Slider",
  "tag": "section",
  "class": "section-trust-before-after-slider",
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#1e293b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#38bdf8"
    },
    {
      "type": "header",
      "content": "Comparison Media"
    },
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "Before Photo (Left Side)"
    },
    {
      "type": "text",
      "id": "label_before",
      "label": "Before Label Badge",
      "default": "BEFORE: STOCK SETUP"
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "After Photo (Right Side)"
    },
    {
      "type": "text",
      "id": "label_after",
      "label": "After Label Badge",
      "default": "AFTER: OBSIDIAN ATELIER"
    },
    {
      "type": "header",
      "content": "Section Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Visual & Acoustic Proof"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Ergonomic Transformation"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Scrub across the viewport to observe the elimination of hollow desk resonance and high-angle wrist strain when upgrading to our CNC chassis."
    }
  ],
  "presets": [
    {
      "name": "Before & After Slider"
    }
  ]
}
{% endschema %}
