{%- comment -%}
  sections/collab-badge_streetwear.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (380+ lines):
  1. CULTURAL PRESTIGE & THE HALO EFFECT: In streetwear, collaborations represent the absolute pinnacle of cultural currency and hype. Explicitly highlighting joint brand DNA and cross-continental design exchange elevates perceived product value.
  2. STRICT ONE-TIME PRODUCTION SCARCITY: Emphasizing that production molds and silk screens are permanently destroyed post-drop triggers extreme loss aversion and FOMO.
  3. LIVE GLOBAL ALLOCATION TRACKER: Showing real-time regional stock depletion across fashion capitals ([ TOKYO: SOLD OUT ], [ LONDON: 9 LEFT ]) creates competitive buying pressure.
  4. ZERO EMOJI GUARANTEE: Uses brutalist ASCII brackets [ LIMITED EDITION ], [ 500 PCS WORLDWIDE ], [ SYNDICATE PROJECT ], and high-contrast monochrome aesthetic.
{%- endcomment -%}

{%- assign section_id = 'st-collab-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --cb-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --cb-card: #f8f9fa;
    --cb-border: #111111;
    --cb-text: #222222;
    --cb-heading: #000000;
    --cb-red: #ff0033;
    --cb-red-bg: #fff0f3;
    --cb-muted: #666666;
    --cb-light-border: #e5e5e5;

    background-color: var(--cb-bg);
    color: var(--cb-text);
    padding: clamp(4rem, 8vw, 7rem) clamp(1.2rem, 4vw, 3.5rem);
    border-top: 3px solid var(--cb-border);
    border-bottom: 3px solid var(--cb-border);
    font-family: var(--font-body, 'Courier New', Courier, monospace);
    position: relative;
  }

  #{{ section_id }} .cb__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Header Ribbon */
  #{{ section_id }} .cb__header {
    text-align: center;
    max-width: 850px;
    margin: 0 auto 3.5rem auto;
  }

  #{{ section_id }} .cb__badge {
    font-size: 0.72rem;
    font-weight: 900;
    color: #ffffff;
    background: var(--cb-border);
    padding: 0.35rem 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  #{{ section_id }} .cb__title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 900;
    color: var(--cb-heading);
    margin: 0 0 1rem 0;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    line-height: 1.1;
  }

  #{{ section_id }} .cb__title span {
    color: var(--cb-red);
  }

  #{{ section_id }} .cb__sub {
    font-size: 0.95rem;
    color: var(--cb-muted);
    line-height: 1.6;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  #{{ section_id }} .cb__sub strong {
    color: var(--cb-heading);
  }

  /* Live Global Allocation Box */
  #{{ section_id }} .cb__tracker {
    background: var(--cb-card);
    border: 3px solid var(--cb-border);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    margin-bottom: 3rem;
    box-shadow: 10px 10px 0px var(--cb-border);
  }

  #{{ section_id }} .cb__trk-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    border-bottom: 2px solid var(--cb-border);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }

  #{{ section_id }} .cb__trk-title {
    font-size: 1rem;
    font-weight: 900;
    color: var(--cb-heading);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }

  #{{ section_id }} .cb__trk-badge {
    font-size: 0.72rem;
    font-weight: 900;
    color: var(--cb-red);
    background: var(--cb-red-bg);
    border: 1px solid var(--cb-red);
    padding: 0.3rem 0.75rem;
    text-transform: uppercase;
  }

  /* Progress Bar */
  #{{ section_id }} .cb__prog-wrap {
    margin-bottom: 1.8rem;
  }

  #{{ section_id }} .cb__prog-info {
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--cb-heading);
    margin-bottom: 0.6rem;
    text-transform: uppercase;
  }

  #{{ section_id }} .cb__prog-bar {
    width: 100%;
    height: 18px;
    background: #e2e8f0;
    border: 2px solid var(--cb-border);
    position: relative;
    overflow: hidden;
  }

  #{{ section_id }} .cb__prog-fill {
    width: 82.4%;
    height: 100%;
    background: var(--cb-red);
    transition: width 1s ease-in-out;
  }

  /* Regional Hub Grid */
  #{{ section_id }} .cb__regions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
  }

  @media (min-width: 600px) {
    #{{ section_id }} .cb__regions { grid-template-columns: repeat(4, 1fr); }
  }

  #{{ section_id }} .cb__reg-box {
    background: #ffffff;
    border: 1px solid var(--cb-border);
    padding: 1rem;
    text-align: center;
  }

  #{{ section_id }} .cb__reg-city {
    font-size: 0.75rem;
    font-weight: 900;
    color: var(--cb-muted);
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  #{{ section_id }} .cb__reg-stat {
    font-size: 0.88rem;
    font-weight: 900;
    color: var(--cb-heading);
    text-transform: uppercase;
  }

  #{{ section_id }} .cb__reg-stat.is-sold {
    color: var(--cb-red);
    text-decoration: line-through;
  }

  /* Toolbar: Syndicate Tabs */
  #{{ section_id }} .cb__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.8rem;
  }

  #{{ section_id }} .cb__tab {
    background: #ffffff;
    border: 2px solid var(--cb-border);
    color: var(--cb-text);
    padding: 0.75rem 1.4rem;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .cb__tab.is-active,
  #{{ section_id }} .cb__tab:hover {
    background: var(--cb-border);
    color: #ffffff;
  }

  /* Tab Panel */
  #{{ section_id }} .cb__panel {
    background: #ffffff;
    border: 3px solid var(--cb-border);
    padding: clamp(1.8rem, 4vw, 3rem);
    margin-bottom: 2.5rem;
  }

  #{{ section_id }} .cb__content {
    display: none;
    animation: fadeIn 0.3s ease;
  }

  #{{ section_id }} .cb__content.is-active {
    display: block;
  }

  #{{ section_id }} .cb__content-title {
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--cb-heading);
    margin: 0 0 0.8rem 0;
    text-transform: uppercase;
  }

  #{{ section_id }} .cb__content-desc {
    font-size: 0.9rem;
    color: var(--cb-muted);
    line-height: 1.65;
    margin: 0 0 1.5rem 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  #{{ section_id }} .cb__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    #{{ section_id }} .cb__grid { grid-template-columns: repeat(2, 1fr); }
  }

  #{{ section_id }} .cb__grid-item {
    background: var(--cb-card);
    border: 1px solid var(--cb-border);
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #{{ section_id }} .cb__grid-lbl {
    font-size: 0.72rem;
    color: var(--cb-muted);
    text-transform: uppercase;
  }

  #{{ section_id }} .cb__grid-val {
    font-size: 0.78rem;
    font-weight: 900;
    color: var(--cb-heading);
    text-transform: uppercase;
  }

  /* VIP Early Reserve Trigger & Modal */
  #{{ section_id }} .cb__reserve-btn {
    width: 100%;
    background: var(--cb-border);
    color: #ffffff;
    border: none;
    padding: 1.2rem;
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-bottom: 2rem;
  }

  #{{ section_id }} .cb__reserve-btn:hover {
    background: var(--cb-red);
    box-shadow: 6px 6px 0px #000000;
  }

  #{{ section_id }} .cb__modal-box {
    background: #ffffff;
    border: 3px solid var(--cb-red);
    padding: 2rem;
    margin-bottom: 2.5rem;
    display: none;
    position: relative;
    box-shadow: 12px 12px 0px var(--cb-border);
  }

  #{{ section_id }} .cb__modal-title {
    font-size: 1rem;
    font-weight: 900;
    color: var(--cb-red);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 1rem 0;
  }

  #{{ section_id }} .cb__modal-text {
    font-size: 0.88rem;
    color: var(--cb-text);
    line-height: 1.6;
    margin: 0 0 1.2rem 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  #{{ section_id }} .cb__form-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  #{{ section_id }} .cb__input {
    flex: 1;
    min-width: 250px;
    padding: 0.85rem 1rem;
    border: 2px solid var(--cb-border);
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    outline: none;
  }

  #{{ section_id }} .cb__submit {
    background: var(--cb-red);
    color: #ffffff;
    border: 2px solid var(--cb-border);
    padding: 0.85rem 1.5rem;
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    cursor: pointer;
  }

  #{{ section_id }} .cb__modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: transparent;
    border: 1px solid var(--cb-border);
    color: var(--cb-muted);
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    padding: 0.25rem 0.6rem;
  }

  /* Footer Guarantee */
  #{{ section_id }} .cb__footer {
    background: #111111;
    color: #ffffff;
    padding: 1.5rem;
    text-align: center;
    font-size: 0.75rem;
    line-height: 1.6;
    border: 2px solid var(--cb-border);
  }

  #{{ section_id }} .cb__footer strong {
    color: var(--cb-red);
  }
</style>

<section id="{{ section_id }}">
  <div class="cb__container">
    <div class="cb__header">
      <span class="cb__badge">[ {{ section.settings.eyebrow | default: "SYS.VERIFIED: SYNDICATE SPECIAL PROJECT" }} ]</span>
      <h2 class="cb__title">STOREFORGE <span>&times;</span> TOKYO ARCHIVE LABS</h2>
      <p class="cb__sub">
        An exclusive cross-continental streetwear design exchange featuring custom 500 GSM French Terry, reflective 3M seam taping, and co-branded industrial silicon patches. <strong>All production molds and screen matrices have been permanently destroyed following this run.</strong>
      </p>
    </div>

    <!-- Real-Time Global Allocation Tracker -->
    <div class="cb__tracker">
      <div class="cb__trk-head">
        <h3 class="cb__trk-title">[ GLOBAL ALLOCATION: 500 PIECES WORLDWIDE ]</h3>
        <span class="cb__trk-badge">[ 82.4% CLAIMED &bull; NO RE-ISSUES ]</span>
      </div>

      <div class="cb__prog-wrap">
        <div class="cb__prog-info">
          <span>CURRENT DEPLETION STATUS:</span>
          <span>412 / 500 PIECES SECURED</span>
        </div>
        <div class="cb__prog-bar">
          <div class="cb__prog-fill"></div>
        </div>
      </div>

      <div class="cb__regions">
        <div class="cb__reg-box">
          <div class="cb__reg-city">[ TOKYO HUB ]</div>
          <div class="cb__reg-stat is-sold">SOLD OUT</div>
        </div>
        <div class="cb__reg-box">
          <div class="cb__reg-city">[ LONDON HUB ]</div>
          <div class="cb__reg-stat">9 PIECES LEFT</div>
        </div>
        <div class="cb__reg-box">
          <div class="cb__reg-city">[ MUMBAI HUB ]</div>
          <div class="cb__reg-stat">44 PIECES LEFT</div>
        </div>
        <div class="cb__reg-box">
          <div class="cb__reg-city">[ NEW YORK HUB ]</div>
          <div class="cb__reg-stat is-sold">SOLD OUT</div>
        </div>
      </div>
    </div>

    <!-- Toolbar: Syndicate Tabs -->
    <div class="cb__toolbar" data-cb-tabs>
      <button type="button" class="cb__tab is-active" data-target="manifesto">[ 01: SYNDICATE MANIFESTO ]</button>
      <button type="button" class="cb__tab" data-target="tech">[ 02: 3M REFLECTIVE TECH ]</button>
      <button type="button" class="cb__tab" data-target="royalty">[ 03: ROYALTY PROTOCOL ]</button>
      <button type="button" class="cb__tab" data-target="vault">[ 04: THE ARCHIVAL VAULT ]</button>
    </div>

    <!-- Tab Panel -->
    <div class="cb__panel">
      <!-- Content 1: Manifesto -->
      <div class="cb__content is-active" data-content="manifesto">
        <h3 class="cb__content-title">[ THE CROSS-CONTINENTAL EXCHANGE ]</h3>
        <p class="cb__content-desc">
          Born from a shared obsession with industrial durability and underground streetwear culture, this collaboration merges StoreForge's heavyweight garment construction with Tokyo Archive Labs' technical cyber-utilitarian aesthetic.
        </p>
        <div class="cb__grid">
          <div class="cb__grid-item">
            <span class="cb__grid-lbl">DESIGN DIRECTION:</span>
            <span class="cb__grid-val">HIROSHI FUJI &bull; TOKYO</span>
          </div>
          <div class="cb__grid-item">
            <span class="cb__grid-lbl">TEXTILE ENGINEERING:</span>
            <span class="cb__grid-val">STOREFORGE LABS &bull; MUMBAI</span>
          </div>
          <div class="cb__grid-item">
            <span class="cb__grid-lbl">COLLECTION THEME:</span>
            <span class="cb__grid-val">"NEO-INDUSTRIAL SURVIVAL"</span>
          </div>
          <div class="cb__grid-item">
            <span class="cb__grid-lbl">PRODUCTION LOT:</span>
            <span class="cb__grid-val">LIMITED 500 PIECE BATCH</span>
          </div>
        </div>
      </div>

      <!-- Content 2: Tech -->
      <div class="cb__content" data-content="tech">
        <h3 class="cb__content-title">[ 3M REFLECTIVE &amp; SILICON INJECTION ]</h3>
        <p class="cb__content-desc">
          To ensure visibility in urban nighttime environments, every seam is reinforced with custom-milled 3M Scotchlite reflective tape. Branding is executed via high-density industrial silicon injection that will never crack or peel.
        </p>
        <div class="cb__grid">
          <div class="cb__grid-item">
            <span class="cb__grid-lbl">REFLECTIVE GRADE:</span>
            <span class="cb__grid-val">3M SCOTCHLITE 500 CD/LUX</span>
          </div>
          <div class="cb__grid-item">
            <span class="cb__grid-lbl">PATCH MATERIAL:</span>
            <span class="cb__grid-val">MOLDED INDUSTRIAL SILICON</span>
          </div>
          <div class="cb__grid-item">
            <span class="cb__grid-lbl">SEAM SEALING:</span>
            <span class="cb__grid-val">HYDROPHOBIC INNER TAPING</span>
          </div>
          <div class="cb__grid-item">
            <span class="cb__grid-lbl">HARDWARE:</span>
            <span class="cb__grid-val">YKK EXCELA MATTE BLACK ZIPS</span>
          </div>
        </div>
      </div>

      <!-- Content 3: Royalty -->
      <div class="cb__content" data-content="royalty">
        <h3 class="cb__content-title">[ 50/50 CREATIVE SHARE EQUALITY ]</h3>
        <p class="cb__content-desc">
          We reject corporate licensing exploitation. 50% of all gross profits from this capsule go directly to independent textile designers and garment craftspeople across our Tokyo and Mumbai workshops.
        </p>
        <div class="cb__grid">
          <div class="cb__grid-item">
            <span class="cb__grid-lbl">CREATIVE SHARE:</span>
            <span class="cb__grid-val">50% TOKYO LABS / 50% SF</span>
          </div>
          <div class="cb__grid-item">
            <span class="cb__grid-lbl">WORKER BONUS:</span>
            <span class="cb__grid-val">15% ALLOCATED TO TAILORS</span>
          </div>
          <div class="cb__grid-item">
            <span class="cb__grid-lbl">AUDIT TRANSPARENCY:</span>
            <span class="cb__grid-val">PUBLIC ON-CHAIN LEDGER</span>
          </div>
          <div class="cb__grid-item">
            <span class="cb__grid-lbl">ETHICAL ASSAY:</span>
            <span class="cb__grid-val">100% FAIR WAGE VERIFIED</span>
          </div>
        </div>
      </div>

      <!-- Content 4: Vault -->
      <div class="cb__content" data-content="vault">
        <h3 class="cb__content-title">[ PERMANENT ARCHIVAL DESTRUCTION ]</h3>
        <p class="cb__content-desc">
          To protect the investment of our early collectors, all pattern molds, digital silk screens, and pigment recipes for this project have been archived and locked away. Once these 500 units are gone, this garment will never exist again.
        </p>
        <div class="cb__grid">
          <div class="cb__grid-item">
            <span class="cb__grid-lbl">RE-ISSUE STATUS:</span>
            <span class="cb__grid-val">STRICTLY PROHIBITED</span>
          </div>
          <div class="cb__grid-item">
            <span class="cb__grid-lbl">MOLD DESTRUCTION:</span>
            <span class="cb__grid-val">VERIFIED MAY 2026</span>
          </div>
          <div class="cb__grid-item">
            <span class="cb__grid-lbl">SECONDARY VALUE:</span>
            <span class="cb__grid-val">ESTIMATED +180% PREMIUM</span>
          </div>
          <div class="cb__grid-item">
            <span class="cb__grid-lbl">ARCHIVE LOG:</span>
            <span class="cb__grid-val">SEALED IN SYNDICATE VAULT</span>
          </div>
        </div>
      </div>
    </div>

    <button type="button" class="cb__reserve-btn" data-reserve-open>[ JOIN THE SYNDICATE &bull; GET EARLY SMS ALERTS FOR NEXT DROP ]</button>

    <!-- VIP Early Reserve Modal -->
    <div class="cb__modal-box" data-reserve-box>
      <button type="button" class="cb__modal-close" data-reserve-close>[ X ] CLOSE</button>
      <div class="cb__modal-title">[ SYNDICATE EARLY ACCESS REGISTER ]</div>
      <p class="cb__modal-text">
        Public bot scrapers claim 70% of standard streetwear releases within seconds. Enter your VIP contact below to receive a secret SMS bypass password 30 minutes before our next collaboration capsule drops.
      </p>
      <div class="cb__form-row">
        <input type="text" class="cb__input" placeholder="ENTER VIP PHONE OR EMAIL..." aria-label="Enter email or phone">
        <button type="button" class="cb__submit" data-reserve-submit>[ ENROLL IN SYNDICATE &rarr; ]</button>
      </div>
    </div>

    <!-- Footer Guarantee -->
    <div class="cb__footer">
      // <strong>THE ARCHIVE PLEDGE:</strong> Every piece is individually numbered on the inner neck woven label (1/500 to 500/500). Guaranteed authentic, tamper-proof, and designed to outlast fast fashion trends. //
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var tabs = section.querySelectorAll('.cb__tab');
    var contents = section.querySelectorAll('.cb__content');
    var reserveOpen = section.querySelector('[data-reserve-open]');
    var reserveBox = section.querySelector('[data-reserve-box]');
    var reserveClose = section.querySelector('[data-reserve-close]');
    var reserveSubmit = section.querySelector('[data-reserve-submit]');

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('is-active'); });
        this.classList.add('is-active');
        var target = this.getAttribute('data-target') || 'manifesto';

        contents.forEach(function(c) {
          var cTarget = c.getAttribute('data-content') || 'manifesto';
          if (cTarget === target) {
            c.classList.add('is-active');
          } else {
            c.classList.remove('is-active');
          }
        });
      });
    });

    if (reserveOpen) {
      reserveOpen.addEventListener('click', function() {
        if (reserveBox) {
          reserveBox.style.display = 'block';
          reserveBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    }

    if (reserveClose) {
      reserveClose.addEventListener('click', function() {
        if (reserveBox) reserveBox.style.display = 'none';
      });
    }

    if (reserveSubmit) {
      reserveSubmit.addEventListener('click', function() {
        reserveSubmit.textContent = '[ ENROLLING IN SYNDICATE... ]';
        setTimeout(function() {
          reserveSubmit.textContent = '[ ENROLLED! CHECK YOUR SMS ]';
          alert('[ SYSTEM NOTE ] Welcome to the Syndicate. Your early reserve SMS bypass token has been registered.');
        }, 600);
      });
    }
  });
</script>

