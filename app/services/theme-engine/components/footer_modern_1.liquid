{%- comment -%}
  footer_modern_1.liquid — Modern / Tech Footer
  
  DESIGN PHILOSOPHY:
  Dark, clean tech aesthetic. Gradient accents,
  rounded pills, and compact information density.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --mdft-bg: var(--color-background, #0a0a0a);
    --mdft-text: var(--color-text, #e0e0e0);
    --mdft-muted: color-mix(in srgb, var(--mdft-text) 40%, transparent);
    --mdft-border: color-mix(in srgb, var(--mdft-text) 8%, transparent);
    --mdft-accent: var(--color-accent, #6366f1);
    --mdft-font: var(--font-body, 'Inter', sans-serif);
    --mdft-font-logo: var(--font-heading, 'Space Grotesk', sans-serif);
    --mdft-radius: var(--radius-card, 8px);
  }

  .md-footer {
    background: var(--mdft-bg);
    color: var(--mdft-text);
    padding: clamp(3rem, 7vw, 5rem) clamp(1.25rem, 4vw, 3rem) 2rem;
    border-top: 1px solid var(--mdft-border);
  }

  .md-footer__inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  /* Top: Brand + Newsletter + Columns */
  .md-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--mdft-border);
    margin-bottom: 2rem;
  }
  @media (min-width: 768px) {
    .md-footer__top {
      grid-template-columns: 1.5fr repeat(3, 1fr);
    }
  }

  .md-footer__brand {
    font-family: var(--mdft-font-logo);
    font-size: 1.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--mdft-accent), color-mix(in srgb, var(--mdft-accent) 60%, var(--mdft-text)));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
  }
  .md-footer__brand-desc {
    font-family: var(--mdft-font);
    font-size: 0.82rem;
    color: var(--mdft-muted);
    line-height: 1.6;
    max-width: 320px;
    margin-bottom: 1.5rem;
  }

  /* Newsletter pill */
  .md-footer__newsletter-form {
    display: flex;
    gap: 0;
    max-width: 360px;
    border-radius: 100px;
    overflow: hidden;
    border: 1px solid var(--mdft-border);
  }
  .md-footer__newsletter-input {
    flex: 1;
    padding: 0.7rem 1.25rem;
    background: transparent;
    border: none;
    color: var(--mdft-text);
    font-family: var(--mdft-font);
    font-size: 0.82rem;
    outline: none;
  }
  .md-footer__newsletter-input::placeholder {
    color: var(--mdft-muted);
  }
  .md-footer__newsletter-btn {
    padding: 0.7rem 1.5rem;
    background: var(--mdft-accent);
    color: #fff;
    border: none;
    font-family: var(--mdft-font);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .md-footer__newsletter-btn:hover {
    opacity: 0.85;
  }

  /* Columns */
  .md-footer__col-title {
    font-family: var(--mdft-font);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mdft-muted);
    margin-bottom: 1rem;
  }
  .md-footer__col-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .md-footer__col-links a {
    font-family: var(--mdft-font);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--mdft-text);
    text-decoration: none;
    transition: color 0.2s;
  }
  .md-footer__col-links a:hover {
    color: var(--mdft-accent);
  }

  /* Bottom row */
  .md-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .md-footer__copyright {
    font-family: var(--mdft-font);
    font-size: 0.68rem;
    color: var(--mdft-muted);
  }
  .md-footer__social {
    display: flex;
    gap: 1rem;
  }
  .md-footer__social-pill {
    display: inline-flex;
    align-items: center;
    font-family: var(--mdft-font);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--mdft-text);
    text-decoration: none;
    background: color-mix(in srgb, var(--mdft-text) 8%, transparent);
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    transition: background 0.2s;
  }
  .md-footer__social-pill:hover {
    background: color-mix(in srgb, var(--mdft-text) 15%, transparent);
  }

  .md-footer__legal {
    display: flex;
    gap: 1rem;
  }
  .md-footer__legal a {
    font-family: var(--mdft-font);
    font-size: 0.65rem;
    color: var(--mdft-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .md-footer__legal a:hover {
    color: var(--mdft-text);
  }
</style>

<footer class="md-footer">
  <div class="md-footer__inner">

    <div class="md-footer__top">
      <div>
        <div class="md-footer__brand">{{ shop.name }}</div>
        {%- if section.settings.description != blank -%}
          <p class="md-footer__brand-desc">{{ section.settings.description }}</p>
        {%- endif -%}
        {%- if section.settings.show_newsletter -%}
          <form class="md-footer__newsletter-form" action="/contact#contact_form" method="post">
            <input type="hidden" name="form_type" value="customer">
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="email" name="contact[email]" class="md-footer__newsletter-input" placeholder="your@email.com" required autocomplete="email" aria-label="Email">
            <button type="submit" class="md-footer__newsletter-btn">Subscribe</button>
          </form>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div>
          <div class="md-footer__col-title">{{ block.settings.title }}</div>
          <ul class="md-footer__col-links">
            {%- for link in linklists[block.settings.menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="md-footer__bottom">
      <div class="md-footer__copyright">&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.</div>
      <div class="md-footer__social">
        {%- if section.settings.social_github != blank -%}
          <a href="{{ section.settings.social_github }}" class="md-footer__social-pill" target="_blank" rel="noopener">GitHub</a>
        {%- endif -%}
        {%- if section.settings.social_twitter != blank -%}
          <a href="{{ section.settings.social_twitter }}" class="md-footer__social-pill" target="_blank" rel="noopener">X</a>
        {%- endif -%}
        {%- if section.settings.social_linkedin != blank -%}
          <a href="{{ section.settings.social_linkedin }}" class="md-footer__social-pill" target="_blank" rel="noopener">LinkedIn</a>
        {%- endif -%}
      </div>
      <div class="md-footer__legal">
        <a href="/policies/privacy-policy">Privacy</a>
        <a href="/policies/terms-of-service">Terms</a>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Modern Footer",
  "tag": "section",
  "class": "section-footer-modern",
  "settings": [
    {
      "type": "text",
      "id": "description",
      "label": "Brand Description",
      "default": "Building the future of commerce, one pixel at a time."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Newsletter",
      "default": true
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "url",
      "id": "social_github",
      "label": "GitHub URL"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "Twitter / X URL"
    },
    {
      "type": "url",
      "id": "social_linkedin",
      "label": "LinkedIn URL"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link Column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Product" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Modern Footer",
      "blocks": [
        { "type": "column", "settings": { "title": "Product", "menu": "footer" } },
        { "type": "column", "settings": { "title": "Company", "menu": "footer" } },
        { "type": "column", "settings": { "title": "Support", "menu": "footer" } }
      ]
    }
  ]
}
{% endschema %}
