{%- comment -%}
  testimonials_bold_1.liquid — Bold / Streetwear Testimonials
  
  DESIGN PHILOSOPHY:
  Community-driven social proof. Grid of real customer
  callouts with bold typography and street aesthetic.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --btst-bg: var(--color-background, #0a0a0a);
    --btst-text: var(--color-text, #fff);
    --btst-accent: var(--color-accent, #ff3c00);
    --btst-muted: color-mix(in srgb, var(--btst-text) 50%, transparent);
    --btst-border: color-mix(in srgb, var(--btst-text) 15%, transparent);
    --btst-font: var(--font-body, 'Roboto Mono', monospace);
    --btst-font-quote: var(--font-heading, 'Anton', sans-serif);
  }

  .bd-testimonials {
    background: var(--btst-bg);
    padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 4vw, 3rem);
    border-top: 4px solid var(--btst-accent);
  }

  .bd-testimonials__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .bd-testimonials__heading {
    font-family: var(--btst-font-quote);
    font-size: clamp(2rem, 5vw, 3.5rem);
    text-transform: uppercase;
    color: var(--btst-text);
    margin: 0 0 2.5rem 0;
    line-height: 1.1;
  }
  .bd-testimonials__heading span {
    color: var(--btst-accent);
  }

  .bd-testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .bd-testimonials__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .bd-testimonials__grid { grid-template-columns: repeat(3, 1fr); }
  }

  .bd-testimonials__card {
    background: color-mix(in srgb, var(--btst-text) 5%, transparent);
    border: 2px solid var(--btst-border);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.2s ease;
  }
  .bd-testimonials__card:hover {
    border-color: var(--btst-accent);
  }

  .bd-testimonials__stars {
    color: var(--btst-accent);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  .bd-testimonials__quote {
    font-family: var(--btst-font);
    font-size: 0.85rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--btst-text);
    flex: 1;
  }

  .bd-testimonials__author-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--btst-border);
  }
  .bd-testimonials__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--btst-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--btst-font-quote);
    font-size: 0.85rem;
    color: var(--btst-bg);
    flex-shrink: 0;
  }
  .bd-testimonials__author-name {
    font-family: var(--btst-font);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--btst-text);
  }
  .bd-testimonials__verified {
    font-family: var(--btst-font);
    font-size: 0.6rem;
    color: var(--btst-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>

<section class="bd-testimonials">
  <div class="bd-testimonials__inner">

    <h2 class="bd-testimonials__heading">
      {{ section.settings.heading_line1 | default: 'The' }}
      <span>{{ section.settings.heading_line2 | default: 'Community' }}</span>
      {{ section.settings.heading_line3 | default: 'Speaks' }}
    </h2>

    <div class="bd-testimonials__grid">
      {%- for block in section.blocks -%}
        <div class="bd-testimonials__card" {{ block.shopify_attributes }}>
          <div class="bd-testimonials__stars" aria-label="{{ block.settings.rating }} stars">
            {%- for i in (1..5) -%}
              {%- if i <= block.settings.rating -%}★{%- else -%}☆{%- endif -%}
            {%- endfor -%}
          </div>
          <div class="bd-testimonials__quote">"{{ block.settings.quote }}"</div>
          <div class="bd-testimonials__author-row">
            <div class="bd-testimonials__avatar">{{ block.settings.author | slice: 0 | upcase }}</div>
            <div>
              <div class="bd-testimonials__author-name">{{ block.settings.author }}</div>
              {%- if block.settings.verified -%}
                <div class="bd-testimonials__verified">✓ Verified Buyer</div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Bold Testimonials",
  "tag": "section",
  "class": "section-testimonials-bold",
  "settings": [
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading Line 1",
      "default": "The"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading Line 2 (Accent)",
      "default": "Community"
    },
    {
      "type": "text",
      "id": "heading_line3",
      "label": "Heading Line 3",
      "default": "Speaks"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Text",
          "default": "Absolute fire. The quality is next level and shipping was crazy fast."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "Alex K."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified Buyer",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bold Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "Absolute fire. The quality is next level.", "author": "Alex K.", "rating": 5, "verified": true } },
        { "type": "testimonial", "settings": { "quote": "Been waiting for a drop like this. Copped instantly.", "author": "Jordan M.", "rating": 5, "verified": true } },
        { "type": "testimonial", "settings": { "quote": "The fit is perfect. Already ordered another colorway.", "author": "Sam R.", "rating": 4, "verified": true } }
      ]
    }
  ]
}
{% endschema %}
