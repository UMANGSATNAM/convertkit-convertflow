{%- comment -%}
  content_image_with_text.liquid — Ultra-Comprehensive Editorial Image with Text Showcase
  
  DESIGN PHILOSOPHY:
  An architectural split showcase engineered to present flagship hardware and brand stories.
  Features reversible layout orientation (image left/right), floating glassmorphism inspection badges,
  animated benefit checkmark lists, and an accessible Editorial Deep-Dive Lightbox Modal
  Dialog allowing clients to review high-res imagery and design principles.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --cit-bg: {{ section.settings.bg_color | default: '#0a0a0a' }};
    --cit-card-bg: {{ section.settings.card_bg_color | default: '#171717' }};
    --cit-text: {{ section.settings.text_color | default: '#f5f5f5' }};
    --cit-muted: color-mix(in srgb, var(--cit-text) 65%, transparent);
    --cit-border: color-mix(in srgb, var(--cit-text) 15%, transparent);
    --cit-accent: {{ section.settings.accent_color | default: '#38bdf8' }};
    --cit-font-body: var(--font-body, 'Inter', -apple-system, sans-serif);
    --cit-font-head: var(--font-heading, 'Space Grotesk', -apple-system, sans-serif);
    --cit-padding-top: clamp(4rem, 8vw, 7rem);
    --cit-padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .cit-section {
    background-color: var(--cit-bg);
    color: var(--cit-text);
    font-family: var(--cit-font-body);
    padding: var(--cit-padding-top) clamp(1.25rem, 4vw, 4rem) var(--cit-padding-bottom);
    border-bottom: 1px solid var(--cit-border);
    position: relative;
    overflow: hidden;
  }

  .cit-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(3rem, 6vw, 5.5rem);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .cit-container {
      grid-template-columns: 1.1fr 0.9fr;
    }
    .cit-container[data-orient="text_first"] {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .cit-container[data-orient="text_first"] .cit-media-col {
      order: 2;
    }
    .cit-container[data-orient="text_first"] .cit-text-col {
      order: 1;
    }
  }

  /* Media Column */
  .cit-media-col {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--cit-card-bg);
    border: 1px solid var(--cit-border);
    border-radius: 36px;
    overflow: hidden;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.8);
    group: true;
  }
  .cit-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cit-media-col:hover .cit-img {
    transform: scale(1.05);
  }

  /* Floating Glass Badge */
  .cit-badge {
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.8);
    z-index: 10;
  }
  .cit-badge-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--cit-accent);
    box-shadow: 0 0 12px var(--cit-accent);
  }
  .cit-badge-title { font-family: var(--cit-font-head); font-size: 0.95rem; font-weight: 700; margin: 0; color: #ffffff; }
  .cit-badge-sub { font-size: 0.78rem; color: rgba(255, 255, 255, 0.6); text-transform: uppercase; letter-spacing: 0.1em; }

  /* Text Column */
  .cit-text-col {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .cit-eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--cit-accent);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .cit-eyebrow::before {
    content: "";
    width: 24px;
    height: 2px;
    background: var(--cit-accent);
  }
  .cit-title {
    font-family: var(--cit-font-head);
    font-size: clamp(2.25rem, 4.5vw, 4rem);
    font-weight: 700;
    line-height: 1.12;
    margin: 0;
  }
  .cit-desc {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--cit-muted);
    line-height: 1.65;
    margin: 0;
  }

  /* Benefit List */
  .cit-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .cit-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    font-size: 1rem;
    color: var(--cit-text);
  }
  .cit-check {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(56, 189, 248, 0.15);
    color: var(--cit-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .cit-check svg { width: 14px; height: 14px; stroke: currentColor; stroke-width: 3; fill: none; }

  /* CTAs */
  .cit-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.75rem;
  }
  .cit-btn-primary {
    background: var(--cit-text);
    color: var(--cit-bg);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    padding: 1.1rem 2.25rem;
    border-radius: 100px;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cit-btn-primary:hover {
    background: var(--cit-accent);
    color: #ffffff;
    transform: translateY(-2px);
  }
  .cit-btn-sec {
    background: transparent;
    color: var(--cit-text);
    font-weight: 700;
    font-size: 0.95rem;
    border: 1px solid var(--cit-border);
    padding: 1.1rem 2rem;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .cit-btn-sec:hover {
    background: var(--cit-card-bg);
    border-color: var(--cit-text);
  }

  /* Editorial Deep-Dive Lightbox Modal */
  .cit-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .cit-modal-overlay[data-open="true"] {
    display: flex;
    opacity: 1;
  }
  .cit-modal {
    background: var(--cit-card-bg);
    color: var(--cit-text);
    border: 1px solid var(--cit-border);
    border-radius: 36px;
    max-width: 900px;
    width: 100%;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    box-shadow: 0 40px 80px -15px rgba(0, 0, 0, 0.9);
    position: relative;
    transform: scale(0.95);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (min-width: 768px) {
    .cit-modal {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .cit-modal-overlay[data-open="true"] .cit-modal {
    transform: scale(1);
  }
  .cit-modal-img-col {
    background: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 380px;
  }
  .cit-modal-img-col img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cit-modal-info-col {
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .cit-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(255, 255, 255, 0.15);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
    z-index: 20;
  }
</style>

<section class="cit-section" id="cit-section-{{ section.id }}" aria-labelledby="cit-title-{{ section.id }}">
  <div class="cit-container" data-orient="{{ section.settings.layout | default: 'image_first' }}">
    
    <!-- Media Column -->
    <div class="cit-media-col">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'cit-img', alt: section.settings.title }}
      {%- else -%}
        <div style="width:100%;height:100%;background:#1e293b;display:flex;align-items:center;justify-content:center;color:#64748b;font-weight:700;font-size:1.25rem;">Editorial Showcase</div>
      {%- endif -%}

      <div class="cit-badge">
        <div class="cit-badge-dot"></div>
        <div>
          <h4 class="cit-badge-title">{{ section.settings.badge_title | default: 'Zürich Atelier Certified' }}</h4>
          <span class="cit-badge-sub">{{ section.settings.badge_sub | default: 'Series 04 Acoustic Ecosystem' }}</span>
        </div>
      </div>
    </div>

    <!-- Text Column -->
    <div class="cit-text-col">
      {%- if section.settings.eyebrow != blank -%}
        <div class="cit-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 id="cit-title-{{ section.id }}" class="cit-title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.desc != blank -%}
        <p class="cit-desc">{{ section.settings.desc }}</p>
      {%- endif -%}

      <!-- Benefit Checkmarks -->
      <div class="cit-list" role="list">
        {%- for block in section.blocks -%}
          <div class="cit-item" role="listitem" {{ block.shopify_attributes }}>
            <div class="cit-check">
              <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <span>{{ block.settings.text | default: 'Milled from a single block of 6063 aerospace aluminum.' }}</span>
          </div>
        {%- endfor -%}
      </div>

      <div class="cit-actions">
        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_link | default: '/collections/all' }}" class="cit-btn-primary">
            <span>{{ section.settings.btn_label }}</span>
            <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.5;"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        {%- endif -%}

        <button type="button" class="cit-btn-sec" id="cit-modal-btn-{{ section.id }}">Editorial Deep-Dive</button>
      </div>
    </div>

  </div>

  <!-- Editorial Deep-Dive Lightbox Modal -->
  <div class="cit-modal-overlay" id="cit-modal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="cit-modal">
      <button type="button" class="cit-modal-close" id="cit-modal-close-{{ section.id }}" aria-label="Close editorial modal">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div class="cit-modal-img-col">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.title }}
        {%- else -%}
          <div style="width:100%;height:100%;background:#111;display:flex;align-items:center;justify-content:center;color:#666;font-weight:700;">Atelier Photography</div>
        {%- endif -%}
      </div>

      <div class="cit-modal-info-col">
        <div style="display:flex;flex-direction:column;gap:1rem;">
          <div style="display:flex;align-items:center;gap:0.6rem;">
            <span style="width:10px;height:10px;border-radius:50%;background:var(--cit-accent);"></span>
            <span style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.18em;color:var(--cit-accent);">Atelier Design Story</span>
          </div>

          <h3 style="font-family:var(--cit-font-head);font-size:2rem;margin:0;color:#ffffff;">{{ section.settings.title | default: 'Unibody Acoustic Mastery' }}</h3>
          
          <p style="font-size:0.95rem;color:var(--cit-muted);line-height:1.6;margin:0;">{{ section.settings.desc | default: 'We eliminate hollow plastic resonance through precision metal fabrication and custom silicone gaskets.' }}</p>

          <div style="background:color-mix(in srgb,var(--cit-text) 5%,transparent);border:1px solid var(--cit-border);border-radius:20px;padding:1.25rem;display:flex;flex-direction:column;gap:0.6rem;">
            <strong style="font-size:0.95rem;color:#ffffff;font-family:var(--cit-font-head);">Zürich Production Metrics:</strong>
            <span style="font-size:0.85rem;color:var(--cit-muted);">• 4.5 hours of 5-axis CNC machining per chassis</span>
            <span style="font-size:0.85rem;color:var(--cit-muted);">• Zero exterior screws or visible plastic seams</span>
            <span style="font-size:0.85rem;color:var(--cit-muted);">• Individual serial engraving archived in Switzerland</span>
          </div>
        </div>

        <button type="button" class="cit-btn-primary" style="justify-content:center;width:100%;border:none;cursor:pointer;" onclick="document.getElementById('cit-modal-close-{{ section.id }}').click();">Explore Complete Lineup →</button>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var sid = '{{ section.id }}';
    var sectionEl = document.getElementById('cit-section-' + sid);
    if (!sectionEl) return;

    // Editorial Modal Controller
    var modalOverlay = document.getElementById('cit-modal-' + sid);
    var modalClose = document.getElementById('cit-modal-close-' + sid);
    var modalBtn = document.getElementById('cit-modal-btn-' + sid);

    if (modalOverlay && modalClose && modalBtn) {
      modalBtn.addEventListener('click', function() {
        modalOverlay.setAttribute('data-open', 'true');
        modalOverlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });

      function closeModal() {
        modalOverlay.setAttribute('data-open', 'false');
        modalOverlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeModal();
      });
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalOverlay.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Image With Text",
  "tag": "section",
  "class": "section-content-image-with-text",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#38bdf8"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop Layout Orientation",
      "options": [
        { "value": "image_first", "label": "Image Left / Copy Right" },
        { "value": "text_first", "label": "Copy Left / Image Right" }
      ],
      "default": "image_first"
    },
    {
      "type": "header",
      "content": "Media & Badge"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "High-Res Photography"
    },
    {
      "type": "text",
      "id": "badge_title",
      "label": "Floating Badge Title",
      "default": "Zürich Atelier Certified"
    },
    {
      "type": "text",
      "id": "badge_sub",
      "label": "Floating Badge Subtitle",
      "default": "Series 04 Acoustic Ecosystem"
    },
    {
      "type": "header",
      "content": "Section Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Callout",
      "default": "Architectural Spotlight"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Unibody Acoustic Mastery"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Description",
      "default": "We eliminate hollow plastic resonance through precision metal fabrication. Each Series 04 instrument is milled from 2,150g of aerospace aluminum."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Primary CTA Label",
      "default": "Acquire Series 04"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Primary CTA Link"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Checkmark",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Benefit Item Text",
          "default": "Milled from a single block of 6063 aerospace aluminum."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image With Text",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Milled from a single block of 6063 aerospace aluminum." } },
        { "type": "benefit", "settings": { "text": "Precision 50A silicone gasket mount eliminates ping." } },
        { "type": "benefit", "settings": { "text": "Individual serial engraving recorded in Swiss archives." } }
      ]
    }
  ]
}
{% endschema %}
