{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shop Forge Component Metadata Schema",
  "description": "Standardized schema for all curated enterprise components. The compiler reads only this metadata.",
  "type": "object",
  "required": [
    "id",
    "version",
    "category",
    "industry",
    "dependencies",
    "requiredAssets",
    "requiredSnippets",
    "performanceScore",
    "croScore",
    "accessibilityScore",
    "mobileScore",
    "designFamily"
  ],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "category": { "type": "string" },
    "industry": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requiredAssets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requiredSnippets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "performanceScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "croScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "accessibilityScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "mobileScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "designFamily": { "type": "string" }
  },
  "additionalProperties": true
}
