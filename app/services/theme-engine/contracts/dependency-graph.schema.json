{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shop Forge Dependency Graph Schema",
  "description": "Deterministic dependency resolution graph mapping components to required assets, snippets, and sections.",
  "type": "object",
  "patternProperties": {
    "^[a-zA-Z0-9_-]+$": {
      "type": "object",
      "required": ["needs"],
      "properties": {
        "needs": {
          "type": "object",
          "properties": {
            "assets": {
              "type": "array",
              "items": { "type": "string" }
            },
            "snippets": {
              "type": "array",
              "items": { "type": "string" }
            },
            "sections": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
