{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shop Forge Theme DNA / Manifest Schema",
  "description": "Immutable versioned build manifest generated with every store for bug reports, reproducible generation, and partial upgrades.",
  "type": "object",
  "required": [
    "themeVersion",
    "blueprintVersion",
    "designFamily",
    "industry",
    "componentHash",
    "tokenHash",
    "layoutHash",
    "registryVersion",
    "generatorVersion"
  ],
  "properties": {
    "themeVersion": { "type": "string" },
    "blueprintVersion": { "type": "string" },
    "designFamily": { "type": "string" },
    "industry": { "type": "string" },
    "componentHash": { "type": "string" },
    "tokenHash": { "type": "string" },
    "layoutHash": { "type": "string" },
    "registryVersion": { "type": "string" },
    "generatorVersion": { "type": "string" }
  },
  "additionalProperties": true
}
