{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shop Forge Blueprint Schema",
  "description": "Immutable contract between AI Layer and Deterministic Engine Layer. AI returns ONLY this JSON.",
  "type": "object",
  "required": ["schemaVersion", "industry", "brand", "design", "layout", "components"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "industry": {
      "type": "string"
    },
    "brand": {
      "type": "object",
      "required": ["personality", "tone", "style"],
      "properties": {
        "personality": { "type": "string" },
        "tone": { "type": "string" },
        "style": { "type": "string" }
      }
    },
    "design": {
      "type": "object",
      "required": ["colorToken", "typographyToken", "spacingToken"],
      "properties": {
        "colorToken": { "type": "string" },
        "typographyToken": { "type": "string" },
        "spacingToken": { "type": "string" }
      }
    },
    "layout": {
      "type": "object",
      "required": ["homepage"],
      "properties": {
        "homepage": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "settings": { "type": "object" }
        }
      }
    }
  },
  "additionalProperties": true
}
