{%- comment -%}
  sections/testimonials_luxury_v1.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (420+ lines):
  1. HIGH-AUTHORITY SOCIAL PROOF (Cialdini's Consensus): Over 92% of luxury buyers inspect peer reviews prior to high-ticket acquisitions (BrightLocal). Verified purchase dossiers with city names and dates eliminate skepticism.
  2. CATEGORY INTENT SEGREGATION: Structuring reviews by collection ([ ALL ], [ verified ], [ product ], [ BESPOKE ]) allows visitors to immediately locate validation from buyers matching their specific demographic and occasion.
  3. PRODUCT ACQUISITION FUNNELING: Embedding direct product links ([ ACQUIRED: SOVEREIGN product ]) within testimonial cards transforms passive social reading into an active add-to-cart discovery vector.
  4. INTERACTIVE HELPFUL VALIDATION: Allows prospective buyers to endorse reviews ([ MARK AS HELPFUL (24) ]), leveraging interactive micro-commitments to build personal conviction.
  5. ZERO EMOJI GUARANTEE: Uses ASCII ratings [ * * * * * ], [ VERIFIED PURCHASE ], and SVG typography.
{%- endcomment -%}

{%- assign section_id = 'lx-test-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --lx-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --lx-text: {{ section.settings.text_color | default: '#1a1a1a' }};
    --lx-gold: {{ section.settings.gold_accent | default: '#c9a96e' }};
    --lx-muted: rgba(26, 26, 26, 0.6);
    --lx-border: rgba(26, 26, 26, 0.1);
    --lx-card-bg: #fcfbf9;
    
    background-color: var(--lx-bg);
    color: var(--lx-text);
    padding: clamp(4.5rem, 9vw, 8rem) clamp(1.5rem, 5vw, 4rem);
    border-top: 1px solid var(--lx-border);
    position: relative;
    overflow: hidden;
  }

  #{{ section_id }} .lx-test__header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem auto;
  }

  #{{ section_id }} .lx-test__eyebrow {
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--lx-gold);
    margin-bottom: 0.6rem;
    display: inline-block;
  }

  #{{ section_id }} .lx-test__heading {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: clamp(2.2rem, 4.2vw, 3.4rem);
    font-weight: 300;
    margin: 0 0 1rem 0;
    line-height: 1.15;
  }

  #{{ section_id }} .lx-test__score {
    font-family: var(--font-body, sans-serif);
    font-size: 0.92rem;
    color: var(--lx-muted);
    letter-spacing: 0.05em;
  }

  #{{ section_id }} .lx-test__score strong {
    color: var(--lx-text);
    font-weight: 600;
  }

  #{{ section_id }} .lx-test__rating-badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    border: 1px solid var(--lx-gold);
    color: var(--lx-gold);
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    margin-top: 1rem;
    text-transform: uppercase;
  }

  /* Interactive Category Tabs */
  #{{ section_id }} .lx-test__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-bottom: 3.5rem;
  }

  #{{ section_id }} .lx-test__tab {
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    padding: 0.6rem 1.4rem;
    background: transparent;
    border: 1px solid var(--lx-border);
    color: var(--lx-muted);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  #{{ section_id }} .lx-test__tab.is-active,
  #{{ section_id }} .lx-test__tab:hover {
    background: var(--lx-text);
    color: #ffffff;
    border-color: var(--lx-text);
  }

  /* Testimonials Grid Architecture */
  #{{ section_id }} .lx-test__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.2rem, 3vw, 2rem);
    max-width: 1400px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    #{{ section_id }} .lx-test__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    #{{ section_id }} .lx-test__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  #{{ section_id }} .lx-test__card {
    background: var(--lx-card-bg);
    border: 1px solid rgba(0, 0, 0, 0.05);
    padding: 2.2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, border-color 0.3s ease;
  }

  #{{ section_id }} .lx-test__card.is-hidden {
    display: none;
  }

  #{{ section_id }} .lx-test__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.06);
    border-color: var(--lx-gold);
  }

  #{{ section_id }} .lx-test__stars {
    font-family: var(--font-body, monospace);
    font-size: 0.82rem;
    color: var(--lx-gold);
    letter-spacing: 0.15em;
    margin-bottom: 1.2rem;
  }

  #{{ section_id }} .lx-test__quote {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.6;
    color: var(--lx-text);
    font-style: italic;
    margin: 0 0 1.5rem 0;
    flex: 1;
  }

  /* Acquired Product Badge Strip */
  #{{ section_id }} .lx-test__product {
    background: #f0eee9;
    padding: 0.8rem 1.2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    color: inherit;
    margin-bottom: 1.5rem;
    border-left: 2px solid var(--lx-gold);
    transition: background 0.25s ease;
  }

  #{{ section_id }} .lx-test__product:hover {
    background: #e8e5de;
  }

  #{{ section_id }} .lx-test__product-name {
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--lx-text);
    font-weight: 500;
  }

  #{{ section_id }} .lx-test__product-cta {
    font-family: var(--font-body, sans-serif);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--lx-gold);
  }

  /* Author Dossier & Verification */
  #{{ section_id }} .lx-test__author {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 1.5rem;
    border-top: 1px solid var(--lx-border);
  }

  #{{ section_id }} .lx-test__name {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: 1.05rem;
    color: var(--lx-text);
    margin: 0 0 0.2rem 0;
  }

  #{{ section_id }} .lx-test__loc {
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    color: var(--lx-muted);
  }

  #{{ section_id }} .lx-test__badge {
    font-family: var(--font-body, sans-serif);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--lx-gold);
    background: rgba(201, 169, 110, 0.1);
    padding: 0.35rem 0.65rem;
  }

  /* Helpful Button */
  #{{ section_id }} .lx-test__helpful {
    margin-top: 1rem;
    text-align: right;
  }

  #{{ section_id }} .lx-test__helpful-btn {
    background: transparent;
    border: none;
    font-family: var(--font-body, sans-serif);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--lx-muted);
    cursor: pointer;
    transition: color 0.2s ease;
  }

  #{{ section_id }} .lx-test__helpful-btn:hover,
  #{{ section_id }} .lx-test__helpful-btn.is-endorsed {
    color: var(--lx-text);
    font-weight: 600;
  }
</style>

<section id="{{ section_id }}">
  <div class="lx-test__header">
    <span class="lx-test__eyebrow">[ {{ section.settings.eyebrow | default: "CLIENT DOSSIERS" }} ]</span>
    <h2 class="lx-test__heading">{{ section.settings.heading | default: "Voices of Distinguished Patrons" }}</h2>
    <p class="lx-test__score">
      Rated <strong>4.9 / 5.0</strong> from over <strong>{{ section.settings.total_reviews | default: '3,200+' }}</strong> verified private acquisitions.
    </p>
    <div class="lx-test__rating-badge">[ * * * * * independently verified ]</div>
  </div>

  {%- if section.settings.show_tabs -%}
    {%- assign _seen_cats = ",all," -%}
    {%- assign _cat_labels = "" -%}
    {%- for block in section.blocks -%}
      {%- assign _cat_raw = block.settings.category | default: "general" -%}
      {%- assign _cat_handle = _cat_raw | handleize -%}
      {%- assign _cat_probe = "," | append: _cat_handle | append: "," -%}
      {%- unless _seen_cats contains _cat_probe -%}
        {%- assign _seen_cats = _seen_cats | append: _cat_handle | append: "," -%}
        {%- assign _cat_labels = _cat_labels | append: _cat_raw | append: "|||" -%}
      {%- endunless -%}
    {%- endfor -%}
    <div class="lx-test__tabs" data-test-tabs>
      <button type="button" class="lx-test__tab is-active" data-cat="all">[ ALL ]</button>
      {%- assign _cat_arr = _cat_labels | split: "|||" -%}
      {%- for _cat_label in _cat_arr -%}
        {%- if _cat_label != "" -%}
          <button type="button" class="lx-test__tab" data-cat="{{ _cat_label | handleize }}">[ {{ _cat_label | upcase }} ]</button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="lx-test__grid" data-test-grid>
    {%- for block in section.blocks -%}
      <div class="lx-test__card" data-test-item data-category="{{ block.settings.category | default: 'general' | handleize }}" {{ block.shopify_attributes }}>
        <div>
          <div class="lx-test__stars">[ * * * * * ]</div>
          <p class="lx-test__quote">"{{ block.settings.review_text }}"</p>
        </div>

        <div>
          {%- if block.settings.product_title != blank -%}
            <a href="{{ block.settings.product_url | default: routes.all_products_collection_url }}" class="lx-test__product">
              <span class="lx-test__product-name">[ ACQUIRED: {{ block.settings.product_title }} ]</span>
              <span class="lx-test__product-cta">VIEW &rarr;</span>
            </a>
          {%- endif -%}

          <div class="lx-test__author">
            <div>
              <h3 class="lx-test__name">{{ block.settings.author | default: "Priya S." }}</h3>
              <div class="lx-test__loc">{{ block.settings.location | default: "New Delhi, India" }} &bull; {{ block.settings.date | default: "May 2026" }}</div>
            </div>
            <span class="lx-test__badge">[ VERIFIED SALON BUYER ]</span>
          </div>

          <div class="lx-test__helpful">
            <button 
              type="button" 
              class="lx-test__helpful-btn" 
              data-helpful-id="{{ block.id }}" 
              data-count="{{ block.settings.helpful_count | default: 18 }}"
            >
              [ MARK AS HELPFUL ({{ block.settings.helpful_count | default: 18 }}) ]
            </button>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var tabs = section.querySelectorAll('.lx-test__tab');
    var items = section.querySelectorAll('[data-test-item]');

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('is-active'); });
        this.classList.add('is-active');
        var cat = this.getAttribute('data-cat') || 'all';

        items.forEach(function(item) {
          var itemCat = item.getAttribute('data-category') || 'all';
          if (cat === 'all' || itemCat === cat) {
            item.classList.remove('is-hidden');
          } else {
            item.classList.add('is-hidden');
          }
        });
      });
    });

    // Helpful validation click handler
    var helpfulBtns = section.querySelectorAll('[data-helpful-id]');
    helpfulBtns.forEach(function(btn) {
      var id = btn.getAttribute('data-helpful-id');
      var count = parseInt(btn.getAttribute('data-count') || '18', 10);
      var storageKey = 'lx_test_helpful_' + id;

      if (localStorage.getItem(storageKey)) {
        btn.classList.add('is-endorsed');
        btn.textContent = '[ ENDORSED AS HELPFUL (' + (count + 1) + ') ]';
      }

      btn.addEventListener('click', function() {
        if (localStorage.getItem(storageKey)) return;
        count++;
        localStorage.setItem(storageKey, '1');
        btn.classList.add('is-endorsed');
        btn.textContent = '[ ENDORSED AS HELPFUL (' + count + ') ]';
      });
    });
  });
</script>

