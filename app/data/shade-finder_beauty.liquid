{%- comment -%}
  =============================================================================
  STOREFORGE BEAUTY NICHE KILLER: CLINICAL SHADE FINDER WIZARD
  =============================================================================
  Psychological Conversion Framework:
  1. Skin Tone Confidence & Return Elimination: In cosmetics and skincare, shade mismatch is the #1 cause of customer returns and cart abandonment. A guided 2-step undertone matching wizard gives clinical precision and 100% shade match guarantee.
  2. Authority & Personalization: Positioning the recommendations as "CLINICALLY OPTIMIZED" builds medical-grade trust.
  
  Design Aesthetics & Rules:
  - 0% Emoji Policy: Clean ASCII brackets [ CLINICAL SHADE MATCH ], precise percentages, and elegant clinical aesthetics.
  - Scoped CSS: Soft clinical neutrals with high-contrast active states.
  =============================================================================
{%- endcomment -%}

<div class="sf-beauty-shade" data-beauty-shade>
  <style>
    .sf-beauty-shade {
      margin: 1.5rem 0;
      padding: 1.5rem;
      background-color: var(--color-background-secondary, #faf9f6);
      border: 1px solid #e2ded6;
      font-family: var(--font-body-family, sans-serif);
      color: #2b2b2b;
    }

    .sf-bt-shade__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid #e2ded6;
    }

    .sf-bt-shade__title {
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #1a1a1a;
    }

    .sf-bt-shade__guarantee {
      font-size: 0.68rem;
      font-weight: 600;
      color: #2e6b4d;
      background-color: #e8f3ec;
      padding: 0.2rem 0.5rem;
      border-radius: 2px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .sf-bt-shade__step {
      margin-bottom: 1.25rem;
    }

    .sf-bt-shade__step-label {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 0.6rem;
      color: #4a4a4a;
      display: block;
    }

    .sf-bt-shade__grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.6rem;
    }

    .sf-bt-shade__swatch-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0.5rem;
      background: #ffffff;
      border: 1px solid #dcd8d0;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .sf-bt-shade__swatch-btn.is-active {
      border-color: #1a1a1a;
      box-shadow: 0 0 0 1px #1a1a1a;
    }

    .sf-bt-shade__color-circle {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      margin-bottom: 0.4rem;
      border: 1px solid rgba(0,0,0,0.1);
    }

    .sf-bt-shade__swatch-label {
      font-size: 0.68rem;
      font-weight: 600;
      color: #333333;
      text-transform: capitalize;
    }

    .sf-bt-shade__result {
      margin-top: 1.25rem;
      padding: 1rem;
      background-color: #ffffff;
      border: 1px solid #2e6b4d;
      text-align: center;
    }

    .sf-bt-shade__result-title {
      font-size: 0.68rem;
      color: #2e6b4d;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .sf-bt-shade__result-val {
      font-size: 1.15rem;
      font-weight: 700;
      color: #1a1a1a;
      margin: 0.3rem 0;
      letter-spacing: 0.05em;
    }

    .sf-bt-shade__result-sub {
      font-size: 0.7rem;
      color: #666666;
    }
  </style>

  <div class="sf-bt-shade__header">
    <span class="sf-bt-shade__title">[ CLINICAL SHADE MATCH WIZARD ]</span>
    <span class="sf-bt-shade__guarantee">100% SHADE MATCH GUARANTEE</span>
  </div>

  <div class="sf-bt-shade__step">
    <span class="sf-bt-shade__step-label">STEP 1: SELECT YOUR COMPLEXION DEPTH</span>
    <div class="sf-bt-shade__grid" data-depth-group>
      <button type="button" class="sf-bt-shade__swatch-btn is-active" data-val="fair">
        <span class="sf-bt-shade__color-circle" style="background-color: #f7e2d2;"></span>
        <span class="sf-bt-shade__swatch-label">Fair</span>
      </button>
      <button type="button" class="sf-bt-shade__swatch-btn" data-val="light">
        <span class="sf-bt-shade__color-circle" style="background-color: #ebd1b9;"></span>
        <span class="sf-bt-shade__swatch-label">Light</span>
      </button>
      <button type="button" class="sf-bt-shade__swatch-btn" data-val="medium">
        <span class="sf-bt-shade__color-circle" style="background-color: #d1ab8c;"></span>
        <span class="sf-bt-shade__swatch-label">Medium</span>
      </button>
      <button type="button" class="sf-bt-shade__swatch-btn" data-val="deep">
        <span class="sf-bt-shade__color-circle" style="background-color: #8c5d3b;"></span>
        <span class="sf-bt-shade__swatch-label">Deep</span>
      </button>
    </div>
  </div>

  <div class="sf-bt-shade__step">
    <span class="sf-bt-shade__step-label">STEP 2: SELECT YOUR UNDERTONE</span>
    <div class="sf-bt-shade__grid" data-tone-group style="grid-template-columns: repeat(3, 1fr);">
      <button type="button" class="sf-bt-shade__swatch-btn is-active" data-val="cool">
        <span class="sf-bt-shade__swatch-label">Cool (Rosy/Blue)</span>
      </button>
      <button type="button" class="sf-bt-shade__swatch-btn" data-val="neutral">
        <span class="sf-bt-shade__swatch-label">Neutral (Balanced)</span>
      </button>
      <button type="button" class="sf-bt-shade__swatch-btn" data-val="warm">
        <span class="sf-bt-shade__swatch-label">Warm (Golden/Yellow)</span>
      </button>
    </div>
  </div>

  <div class="sf-bt-shade__result">
    <div class="sf-bt-shade__result-title">[ YOUR PERFECT SHADE MATCH ]</div>
    <div class="sf-bt-shade__result-val" data-shade-result>SHADE 110 - FAIR COOL IVORY</div>
    <div class="sf-bt-shade__result-sub">Formulated with mineral light-diffusing spheres for seamless blending.</div>
  </div>

  <script>
    (function() {
      const container = document.querySelector('[data-beauty-shade]');
      if (!container) return;

      const depthBtns = container.querySelectorAll('[data-depth-group] .sf-bt-shade__swatch-btn');
      const toneBtns = container.querySelectorAll('[data-tone-group] .sf-bt-shade__swatch-btn');
      const resultVal = container.querySelector('[data-shade-result]');

      let depth = 'fair';
      let tone = 'cool';

      const shadeMap = {
        'fair-cool': 'SHADE 110 - FAIR COOL IVORY',
        'fair-neutral': 'SHADE 120 - FAIR NEUTRAL PORCELAIN',
        'fair-warm': 'SHADE 130 - FAIR WARM SAND',
        'light-cool': 'SHADE 210 - LIGHT COOL ROSE',
        'light-neutral': 'SHADE 220 - LIGHT NEUTRAL BEIGE',
        'light-warm': 'SHADE 230 - LIGHT WARM GOLDEN',
        'medium-cool': 'SHADE 310 - MEDIUM COOL ALMOND',
        'medium-neutral': 'SHADE 320 - MEDIUM NEUTRAL TAN',
        'medium-warm': 'SHADE 330 - MEDIUM WARM HONEY',
        'deep-cool': 'SHADE 410 - DEEP COOL MAHOGANY',
        'deep-neutral': 'SHADE 420 - DEEP NEUTRAL ESPRESSO',
        'deep-warm': 'SHADE 430 - DEEP WARM CACAO'
      };

      function updateShade() {
        const key = `${depth}-${tone}`;
        if (resultVal && shadeMap[key]) {
          resultVal.textContent = shadeMap[key];
        }
      }

      depthBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          depthBtns.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          depth = btn.getAttribute('data-val') || 'fair';
          updateShade();
        });
      });

      toneBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          toneBtns.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          tone = btn.getAttribute('data-val') || 'cool';
          updateShade();
        });
      });
    })();
  </script>
</div>
