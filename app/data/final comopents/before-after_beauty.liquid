{%- comment -%}
  sections/before-after_beauty.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (450+ lines):
  1. EMPIRICAL VISUAL PROOF & SKEPTICISM ERADICATION: In clinical skincare, subjective claims fail to convert high-ticket buyers. An interactive drag slider comparing untouched baseline photos against 14-day and 30-day clinical results provides undeniable proof of efficacy.
  2. MULTI-CONCERN PERSONALIZATION: Allowing shoppers to toggle between [ HYPERPIGMENTATION ], [ FINE LINES ], and [ ROSACEA REDUCTION ] aligns the transformation data directly with their primary skin insecurity.
  3. QUANTIFIABLE BIOMETRIC EVIDENCE: Displaying specific clinical improvement percentages (-74% melanin density, +88% elasticity) transforms marketing into dermatological science.
  4. ZERO EMOJI GUARANTEE: Uses clinical ASCII brackets [ DAY 0 BASELINE ], [ DAY 14 RESULTS ], [ -74% REDUCTION ], and botanical forest green styling.
{%- endcomment -%}

{%- assign section_id = 'bt-ba-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --ba-bg: {{ section.settings.bg_color | default: '#f4f9f5' }};
    --ba-card: #ffffff;
    --ba-border: #c8e0d0;
    --ba-text: #2d3748;
    --ba-heading: #1a202c;
    --ba-green: #1b4d36;
    --ba-accent: #2e6b4d;
    --ba-light-bg: #e8f3ec;
    --ba-muted: #718096;

    background-color: var(--ba-bg);
    color: var(--ba-text);
    padding: clamp(4rem, 8vw, 7rem) clamp(1.2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--ba-border);
    border-bottom: 1px solid var(--ba-border);
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    position: relative;
  }

  #{{ section_id }} .ba__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Header Ribbon */
  #{{ section_id }} .ba__header {
    text-align: center;
    max-width: 850px;
    margin: 0 auto 3.5rem auto;
  }

  #{{ section_id }} .ba__badge {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--ba-green);
    background: var(--ba-light-bg);
    border: 1px solid var(--ba-border);
    padding: 0.35rem 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  #{{ section_id }} .ba__title {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 800;
    color: var(--ba-heading);
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }

  #{{ section_id }} .ba__sub {
    font-size: 0.95rem;
    color: var(--ba-muted);
    line-height: 1.6;
  }

  #{{ section_id }} .ba__sub strong {
    color: var(--ba-green);
  }

  /* Concern Switcher Ribbon */
  #{{ section_id }} .ba__switcher {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  #{{ section_id }} .ba__switch-btn {
    background: var(--ba-card);
    border: 1px solid var(--ba-border);
    color: var(--ba-text);
    padding: 0.75rem 1.4rem;
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .ba__switch-btn.is-active,
  #{{ section_id }} .ba__switch-btn:hover {
    background: var(--ba-green);
    color: #ffffff;
    border-color: var(--ba-green);
    box-shadow: 0 4px 12px rgba(27, 77, 54, 0.2);
  }

  /* Main Interactive Grid */
  #{{ section_id }} .ba__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: flex-start;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 992px) {
    #{{ section_id }} .ba__grid { grid-template-columns: 1.3fr 1fr; }
  }

  /* Left: Slider Container */
  #{{ section_id }} .ba__slider-wrap {
    background: var(--ba-card);
    border: 2px solid var(--ba-green);
    padding: 1rem;
    box-shadow: 0 15px 35px rgba(27, 77, 54, 0.1);
  }

  #{{ section_id }} .ba__slider-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.8rem;
    background: var(--ba-light-bg);
    border-bottom: 1px solid var(--ba-border);
    margin-bottom: 1rem;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--ba-green);
    text-transform: uppercase;
  }

  #{{ section_id }} .ba__slider-box {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    cursor: ew-resize;
    background-color: #f0ebe1;
  }

  #{{ section_id }} .ba__img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    pointer-events: none;
  }

  #{{ section_id }} .ba__before-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    overflow: hidden;
    border-right: 2px solid #ffffff;
    box-shadow: 2px 0 10px rgba(0,0,0,0.3);
  }

  #{{ section_id }} .ba__before-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    max-width: none;
  }

  #{{ section_id }} .ba__label {
    position: absolute;
    bottom: 1rem;
    padding: 0.4rem 0.8rem;
    background: rgba(27, 77, 54, 0.85);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    pointer-events: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  #{{ section_id }} .ba__label--before { left: 1rem; }
  #{{ section_id }} .ba__label--after { right: 1rem; }

  #{{ section_id }} .ba__handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    background: #ffffff;
    border: 2px solid var(--ba-green);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.25);
    pointer-events: none;
    font-weight: 900;
    font-size: 0.72rem;
    color: var(--ba-green);
  }

  #{{ section_id }} .ba__slider-foot {
    padding: 0.8rem;
    text-align: center;
    font-size: 0.72rem;
    color: var(--ba-muted);
    border-top: 1px dashed var(--ba-border);
    margin-top: 1rem;
  }

  /* Right: Clinical Metrics & Regimen Panel */
  #{{ section_id }} .ba__panel {
    background: var(--ba-card);
    border: 1px solid var(--ba-border);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    position: sticky;
    top: 2rem;
  }

  #{{ section_id }} .ba__panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--ba-green);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }

  #{{ section_id }} .ba__panel-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--ba-green);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }

  #{{ section_id }} .ba__acc-pill {
    font-size: 0.68rem;
    font-weight: 800;
    color: #ffffff;
    background: var(--ba-green);
    padding: 0.25rem 0.6rem;
    text-transform: uppercase;
  }

  #{{ section_id }} .ba__metric-item {
    margin-bottom: 1.25rem;
  }

  #{{ section_id }} .ba__metric-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
    font-size: 0.8rem;
  }

  #{{ section_id }} .ba__metric-lbl {
    font-weight: 700;
    color: var(--ba-heading);
    text-transform: uppercase;
  }

  #{{ section_id }} .ba__metric-val {
    font-weight: 900;
    color: var(--ba-green);
  }

  #{{ section_id }} .ba__progress-bg {
    width: 100%;
    height: 8px;
    background: var(--ba-light-bg);
    border: 1px solid var(--ba-border);
    overflow: hidden;
  }

  #{{ section_id }} .ba__progress-bar {
    height: 100%;
    background: var(--ba-green);
    transition: width 0.5s ease;
  }

  #{{ section_id }} .ba__commentary {
    background: var(--ba-light-bg);
    border-left: 3px solid var(--ba-green);
    padding: 1rem;
    font-size: 0.8rem;
    color: var(--ba-text);
    line-height: 1.6;
    margin: 1.5rem 0;
  }

  #{{ section_id }} .ba__commentary strong {
    color: var(--ba-green);
    display: block;
    margin-bottom: 0.25rem;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  #{{ section_id }} .ba__add-btn {
    width: 100%;
    background: var(--ba-green);
    color: #ffffff;
    border: none;
    padding: 1.1rem;
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
