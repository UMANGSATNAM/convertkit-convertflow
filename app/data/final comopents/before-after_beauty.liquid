    background: #123323;
  }

  /* Toolbar: Protocol Tabs */
  #{{ section_id }} .ba__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.8rem;
  }

  #{{ section_id }} .ba__tab {
    background: var(--ba-card);
    border: 1px solid var(--ba-border);
    color: var(--ba-muted);
    padding: 0.75rem 1.4rem;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .ba__tab.is-active,
  #{{ section_id }} .ba__tab:hover {
    background: var(--ba-green);
    color: #ffffff;
    border-color: var(--ba-green);
  }

  /* Tab Panel */
  #{{ section_id }} .ba__tab-panel {
    background: var(--ba-card);
    border: 1px solid var(--ba-border);
    padding: clamp(1.8rem, 4vw, 3rem);
    margin-bottom: 2.5rem;
  }

  #{{ section_id }} .ba__content {
    display: none;
    animation: fadeIn 0.3s ease;
  }

  #{{ section_id }} .ba__content.is-active {
    display: block;
  }

  #{{ section_id }} .ba__content-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--ba-heading);
    margin: 0 0 0.8rem 0;
    text-transform: uppercase;
  }

  #{{ section_id }} .ba__content-desc {
    font-size: 0.88rem;
    color: var(--ba-muted);
    line-height: 1.65;
    margin: 0 0 1.5rem 0;
  }

  #{{ section_id }} .ba__spec-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    #{{ section_id }} .ba__spec-grid { grid-template-columns: repeat(2, 1fr); }
  }

  #{{ section_id }} .ba__spec-item {
    background: var(--ba-light-bg);
    border: 1px solid var(--ba-border);
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #{{ section_id }} .ba__spec-lbl {
    font-size: 0.72rem;
    color: var(--ba-muted);
    text-transform: uppercase;
  }

  #{{ section_id }} .ba__spec-val {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--ba-green);
    text-transform: uppercase;
  }

  /* Footer Guarantee */
  #{{ section_id }} .ba__footer {
    background: var(--ba-light-bg);
    border: 1px solid var(--ba-border);
    padding: 1.5rem;
    text-align: center;
    font-size: 0.78rem;
    color: var(--ba-accent);
    line-height: 1.6;
  }

  #{{ section_id }} .ba__footer strong {
    color: var(--ba-green);
  }
</style>

<section id="{{ section_id }}">
  <div class="ba__container">
