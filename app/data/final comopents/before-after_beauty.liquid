<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var sliderBox = section.querySelector('[data-slider-box]');
    var beforeWrap = section.querySelector('[data-before-wrap]');
    var beforeImg = section.querySelector('[data-before-img]');
    var afterImg = section.querySelector('[data-after-img]');
    var handle = section.querySelector('[data-handle]');
    var sliderTitle = section.querySelector('[data-slider-title]');
    var afterLbl = section.querySelector('[data-after-lbl]');

    var switchBtns = section.querySelectorAll('[data-concern-group] .ba__switch-btn');
    var tabs = section.querySelectorAll('.ba__tab');
    var contents = section.querySelectorAll('.ba__content');

    var m1Lbl = section.querySelector('[data-m1-lbl]');
    var m1Val = section.querySelector('[data-m1-val]');
    var m1Bar = section.querySelector('[data-m1-bar]');

    var m2Lbl = section.querySelector('[data-m2-lbl]');
    var m2Val = section.querySelector('[data-m2-val]');
    var m2Bar = section.querySelector('[data-m2-bar]');

    var m3Lbl = section.querySelector('[data-m3-lbl]');
    var m3Val = section.querySelector('[data-m3-val]');
    var m3Bar = section.querySelector('[data-m3-bar]');
    var commText = section.querySelector('[data-comm-text]');
    var addBtn = section.querySelector('[data-add-trial]');

    var concernsData = {
      hyperpigmentation: {
        title: '[ SUBJECT ID: #842-A &bull; 34 YEARS OLD ]',
        afterLbl: '[ DAY 14 RESULTS ]',
        imgBefore: 'https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=1200&q=80',
        imgAfter: 'https://images.unsplash.com/photo-1512496015851-a90fb38ba796?auto=format&fit=crop&w=1200&q=80',
        m1: { lbl: 'MELANIN CLUSTER REDUCTION:', val: '-74.2%', pct: '74%' },
        m2: { lbl: 'SKIN LUMINosity INDEX:', val: '+88.5%', pct: '88%' },
        m3: { lbl: 'BARRIER HYDRATION RETENTION:', val: '+142.0%', pct: '100%' },
        comm: '"Significant dispersion of hyperpigmented melanin clusters observed within 14 days of topical biotec application without causing barrier disruption or erythema."'
      },
      finelines: {
        title: '[ SUBJECT ID: #915-C &bull; 48 YEARS OLD ]',
        afterLbl: '[ DAY 30 RESULTS ]',
        imgBefore: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=1200&q=80',
        imgAfter: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=1200&q=80',
        m1: { lbl: 'CROW\'S FEET DEPTH REDUCTION:', val: '-62.8%', pct: '63%' },
        m2: { lbl: 'DERMAL COLLAGEN DENSITY:', val: '+94.1%', pct: '94%' },
        m3: { lbl: 'CELLULAR TURNOVER RATE:', val: '+118.5%', pct: '100%' },
        comm: '"Ultrasonic scans reveal marked re-densification of the extracellular matrix and visible softening of periorbital rhytids after 30 days of consecutive application."'
      },
      rosacea: {
        title: '[ SUBJECT ID: #703-B &bull; 29 YEARS OLD ]',
        afterLbl: '[ DAY 7 RESULTS ]',
        imgBefore: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=1200&q=80',
        imgAfter: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=1200&q=80',
        m1: { lbl: 'FACIAL ERYTHEMA REDUCTION:', val: '-86.4%', pct: '86%' },
        m2: { lbl: 'MICRO-VASCULAR CALMING:', val: '+91.0%', pct: '91%' },
        m3: { lbl: 'STRATUM CORNEUM RESILIENCE:', val: '+135.2%', pct: '100%' },
        comm: '"Rapid attenuation of acute inflammatory cascade and surface erythema noted within just 7 days, demonstrating potent bio-soothing efficacy."'
      }
    };

    function matchSize() {
      if (!sliderBox || !beforeImg) return;
      beforeImg.style.width = sliderBox.offsetWidth + 'px';
      beforeImg.style.height = sliderBox.offsetHeight + 'px';
    }

    window.addEventListener('resize', matchSize);
    matchSize();

    var isDragging = false;
    function updateSlider(clientX) {
      if (!sliderBox || !beforeWrap || !handle) return;
      var rect = sliderBox.getBoundingClientRect();
      var x = clientX - rect.left;
      if (x < 0) x = 0;
      if (x > rect.width) x = rect.width;
      var pct = (x / rect.width) * 100;
      beforeWrap.style.width = pct + '%';
      handle.style.left = pct + '%';
    }

    if (sliderBox) {
      sliderBox.addEventListener('mousedown', function(e) { isDragging = true; updateSlider(e.clientX); });
      window.addEventListener('mousemove', function(e) { if (isDragging) updateSlider(e.clientX); });
      window.addEventListener('mouseup', function() { isDragging = false; });
      sliderBox.addEventListener('touchstart', function(e) { isDragging = true; updateSlider(e.touches[0].clientX); }, { passive: true });
      window.addEventListener('touchmove', function(e) { if (isDragging) updateSlider(e.touches[0].clientX); }, { passive: true });
      window.addEventListener('touchend', function() { isDragging = false; });
    }

    switchBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        switchBtns.forEach(function(b) { b.classList.remove('is-active'); });
        this.classList.add('is-active');
        var key = this.getAttribute('data-concern') || 'hyperpigmentation';
        var d = concernsData[key];
        if (!d) return;

        if (sliderTitle) sliderTitle.innerHTML = d.title;
        if (afterLbl) afterLbl.textContent = d.afterLbl;
        if (beforeImg) beforeImg.src = d.imgBefore;
        if (afterImg) afterImg.src = d.imgAfter;

        if (m1Lbl) m1Lbl.textContent = d.m1.lbl;
        if (m1Val) m1Val.textContent = d.m1.val;
        if (m1Bar) m1Bar.style.width = d.m1.pct;

        if (m2Lbl) m2Lbl.textContent = d.m2.lbl;
        if (m2Val) m2Val.textContent = d.m2.val;
        if (m2Bar) m2Bar.style.width = d.m2.pct;

        if (m3Lbl) m3Lbl.textContent = d.m3.lbl;
        if (m3Val) m3Val.textContent = d.m3.val;
        if (m3Bar) m3Bar.style.width = d.m3.pct;

        if (commText) commText.textContent = d.comm;
        setTimeout(matchSize, 100);
      });
    });

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('is-active'); });
        this.classList.add('is-active');
        var target = this.getAttribute('data-target') || 'protocol';

        contents.forEach(function(c) {
          var cTarget = c.getAttribute('data-content') || 'protocol';
          if (cTarget === target) {
            c.classList.add('is-active');
          } else {
            c.classList.remove('is-active');
          }
        });
      });
    });

    if (addBtn) {
      addBtn.addEventListener('click', function() {
        addBtn.textContent = '[ LOCKING IN CLINICAL REGIMEN... ]';
        setTimeout(function() {
          addBtn.textContent = '[ REGIMEN ADDED TO CART * 30-DAY GUARANTEE APPLIED ]';
          alert('[ SYSTEM NOTE ] The selected clinical regimen has been added to your cart with a complimentary 30-day efficacy guarantee.');
        }, 500);
      });
    }
  });
</script>

