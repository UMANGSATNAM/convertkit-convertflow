{%- comment -%}
  =============================================================================
  STOREFORGE STREETWEAR NICHE KILLER: EDITORIAL LOOKBOOK SLIDER
  =============================================================================
  Psychological Conversion Framework:
  1. Cultural Belonging & Social Proof: Streetwear buyers do not just buy clothing; they buy into a culture and aesthetic tribe. Showing editorial street styling builds aspiration and identity alignment.
  2. Complete Outfitting Upsell: Highlighting complementary garments in each slide drives multi-item basket additions.
  
  Design Aesthetics & Rules:
  - 0% Emoji Policy: Clean ASCII brackets, brutalist borders, and industrial counter [ 01 / 04 ].
  - Scoped CSS: High-contrast monochrome aesthetic.
  =============================================================================
{%- endcomment -%}

<div class="sf-st-lookbook" data-streetwear-lookbook>
  <style>
    .sf-st-lookbook {
      margin: 2rem 0;
      border: 3px solid #111111;
      background-color: #111111;
      color: #ffffff;
      font-family: var(--font-body-family, 'Courier New', monospace);
    }

    .sf-st-lb__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.85rem 1rem;
      border-bottom: 2px solid #333333;
      font-size: 0.75rem;
      font-weight: 900;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    .sf-st-lb__counter {
      color: #ffcc00;
      font-weight: 900;
    }

    .sf-st-lb__viewport {
      position: relative;
      overflow: hidden;
      aspect-ratio: 16 / 9;
      background: #000000;
      min-height: 320px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .sf-st-lb__slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s ease;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 1.5rem;
      background-size: cover;
      background-position: center;
      background-image: linear-gradient(0deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0) 100%), url('https://images.unsplash.com/photo-1552374196-1ab2a1c593e8?auto=format&fit=crop&w=1200&q=80');
    }

    .sf-st-lb__slide[data-slide="2"] {
      background-image: linear-gradient(0deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0) 100%), url('https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=1200&q=80');
    }

    .sf-st-lb__slide[data-slide="3"] {
      background-image: linear-gradient(0deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0) 100%), url('https://images.unsplash.com/photo-1576995853123-5a10305d93c0?auto=format&fit=crop&w=1200&q=80');
    }

    .sf-st-lb__slide.is-active {
      opacity: 1;
      pointer-events: auto;
    }

    .sf-st-lb__caption-box {
      border-left: 4px solid #ffcc00;
      padding-left: 1rem;
      max-width: 480px;
    }

    .sf-st-lb__tag {
      font-size: 0.65rem;
      font-weight: 800;
      color: #ffcc00;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 0.25rem;
    }

    .sf-st-lb__title {
      font-size: 1.25rem;
      font-weight: 900;
      color: #ffffff;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      line-height: 1.1;
      margin-bottom: 0.5rem;
    }

    .sf-st-lb__desc {
      font-size: 0.75rem;
      color: #dddddd;
      line-height: 1.4;
    }

    .sf-st-lb__controls {
      display: flex;
      border-top: 2px solid #333333;
    }

    .sf-st-lb__btn {
      flex: 1;
      padding: 0.85rem;
      background: #111111;
      color: #ffffff;
      border: none;
      font-family: inherit;
      font-size: 0.75rem;
      font-weight: 900;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s ease, color 0.2s ease;
    }

    .sf-st-lb__btn:first-child {
      border-right: 2px solid #333333;
    }

    .sf-st-lb__btn:hover {
      background: #ffffff;
      color: #111111;
    }
  </style>

  <div class="sf-st-lb__header">
    <span>[ CURATED LOOKBOOK // DROP 04 ]</span>
    <span class="sf-st-lb__counter" data-lb-counter>[ 01 / 03 ]</span>
  </div>

  <div class="sf-st-lb__viewport">
    <div class="sf-st-lb__slide is-active" data-slide="1">
      <div class="sf-st-lb__caption-box">
        <div class="sf-st-lb__tag">// LOOK 01 : THE MONOCHROME SYNDICATE //</div>
        <div class="sf-st-lb__title">HEAVYWEIGHT FRENCH TERRY HOODIE + CARGO PANTS</div>
        <div class="sf-st-lb__desc">Styled with oversized dropped shoulders and industrial cinch drawstrings.</div>
      </div>
    </div>

    <div class="sf-st-lb__slide" data-slide="2">
      <div class="sf-st-lb__caption-box">
        <div class="sf-st-lb__tag">// LOOK 02 : UNDERGROUND ATELIER //</div>
        <div class="sf-st-lb__title">ACID WASH BOX TEE + UTILITY VEST</div>
        <div class="sf-st-lb__desc">Pre-shrunk 300 GSM combed cotton with reinforced double-needle stitching.</div>
      </div>
    </div>

    <div class="sf-st-lb__slide" data-slide="3">
      <div class="sf-st-lb__caption-box">
        <div class="sf-st-lb__tag">// LOOK 03 : NOCTURNAL ARCHITECTURE //</div>
        <div class="sf-st-lb__title">BALLISTIC NYLON WINDBREAKER + TRACK PANT</div>
        <div class="sf-st-lb__desc">Water-repellent matte black shell engineered for all-weather urban transit.</div>
      </div>
    </div>
  </div>

  <div class="sf-st-lb__controls">
    <button type="button" class="sf-st-lb__btn" data-lb-prev>&larr; [ PREV LOOK ]</button>
    <button type="button" class="sf-st-lb__btn" data-lb-next>[ NEXT LOOK ] &rarr;</button>
  </div>

  <script>
    (function() {
      const container = document.querySelector('[data-streetwear-lookbook]');
      if (!container) return;

      const slides = container.querySelectorAll('.sf-st-lb__slide');
      const counter = container.querySelector('[data-lb-counter]');
      const prevBtn = container.querySelector('[data-lb-prev]');
      const nextBtn = container.querySelector('[data-lb-next]');

      let currentIndex = 0;
      const total = slides.length;

      function showSlide(idx) {
        slides.forEach(s => s.classList.remove('is-active'));
        slides[idx].classList.add('is-active');
        if (counter) {
          counter.textContent = `[ 0${idx + 1} / 0${total} ]`;
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          currentIndex = (currentIndex - 1 + total) % total;
          showSlide(currentIndex);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          currentIndex = (currentIndex + 1) % total;
          showSlide(currentIndex);
        });
      }
    })();
  </script>
</div>
