{%- comment -%}
  sections/main-cart_luxury_v1.liquid
  CONVERSION PSYCHOLOGY:
  1. LOSS AVERSION - Displaying savings explicitly triggers loss aversion (Kahneman).
  2. GOAL GRADIENT - Progress bar accelerates behavior as user nears the goal.
  3. COGNITIVE FLUENCY - Replaced emojis with pure typography trust markers.
  4. FRICTIONLESS UX - Clear, large hit-areas for quantity and checkout.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --text-primary: var(--color-text, #1a1a1a);
    --text-muted: rgba(26,26,26,0.55);
    --border-subtle: rgba(13,13,13,0.08);
    --accent-green: #2d7a3a;
  }

  .lx-cart {
    padding: 3rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .lx-cart__title {
    font-family: var(--font-heading, serif);
    font-size: clamp(2rem, 3vw, 2.5rem);
    font-weight: 400;
    margin: 0 0 0.5rem 0;
  }
  .lx-cart__count {
    font-family: var(--font-body, sans-serif);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  /* SAVINGS BANNER */
  .lx-cart__savings-banner {
    background: rgba(45,122,58,0.04);
    border: 1px solid rgba(45,122,58,0.15);
    padding: 0.75rem 1rem;
    font-family: var(--font-body, sans-serif);
    font-size: 0.85rem;
    color: var(--accent-green);
    margin-bottom: 1.5rem;
    text-align: center;
    letter-spacing: 0.02em;
  }

  /* FREE SHIPPING PROGRESS */
  .lx-cart__shipping-bar {
    margin-bottom: 2rem;
  }
  .lx-cart__shipping-text {
    font-family: var(--font-body, sans-serif);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    text-align: center;
  }
  .lx-cart__shipping-text strong {
    color: var(--text-primary);
  }
  .lx-cart__progress-track {
    width: 100%;
    height: 3px;
    background: var(--border-subtle);
    position: relative;
    overflow: hidden;
  }
  .lx-cart__progress-fill {
    height: 100%;
    background: var(--text-primary);
    transition: width 0.5s ease;
  }

  /* LAYOUT */
  .lx-cart__body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 900px) {
    .lx-cart__body {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  /* CART ITEMS */
  .lx-cart-item {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border-subtle);
    align-items: start;
  }
  .lx-cart-item__image {
    width: 100px;
    aspect-ratio: 1;
    object-fit: cover;
    background: #f5f5f5;
  }
  .lx-cart-item__title {
    font-family: var(--font-body, sans-serif);
    font-size: 0.9rem;
    margin: 0 0 0.25rem 0;
  }
  .lx-cart-item__variant {
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }
  .lx-cart-item__qty {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid var(--border-subtle);
    padding: 0.25rem 0.5rem;
  }
  .lx-cart-item__qty button {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    color: var(--text-primary);
    padding: 0.25rem;
  }
  .lx-cart-item__qty span {
    font-family: var(--font-body, sans-serif);
    font-size: 0.85rem;
    min-width: 1.5rem;
    text-align: center;
  }
  .lx-cart-item__price {
    font-family: var(--font-body, sans-serif);
    font-size: 0.9rem;
    font-weight: 600;
    text-align: right;
  }
  .lx-cart-item__remove {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-decoration: underline;
    cursor: pointer;
    background: none;
    border: none;
    margin-top: 0.5rem;
  }

  /* ORDER SUMMARY */
  .lx-cart__summary {
    background: rgba(0,0,0,0.02);
    padding: 2.5rem;
    height: fit-content;
  }
  @media (min-width: 900px) {
    .lx-cart__summary {
      position: sticky;
      top: 6rem;
    }
  }
  .lx-cart__summary-title {
    font-family: var(--font-heading, serif);
    font-size: 1.25rem;
    margin: 0 0 1.5rem 0;
  }
  .lx-cart__summary-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-body, sans-serif);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }
  .lx-cart__summary-row--total {
    font-weight: 600;
    font-size: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
    margin-top: 0.75rem;
  }
  .lx-cart__checkout-btn {
    width: 100%;
    padding: 1.15rem;
    background: var(--text-primary);
    color: var(--color-background, #fff);
    border: none;
    font-family: var(--font-body, sans-serif);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    cursor: pointer;
    margin-top: 1.5rem;
    transition: opacity 0.2s;
  }
  .lx-cart__checkout-btn:hover { opacity: 0.88; }

  /* Payment Icons */
  .lx-cart__payment-icons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.25rem;
    font-family: var(--font-body, sans-serif);
    font-size: 0.65rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Trust reinforcement - Typography only */
  .lx-cart__trust-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    font-family: var(--font-body, sans-serif);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  /* Empty cart */
  .lx-cart__empty {
    text-align: center;
    padding: 4rem 2rem;
  }
  .lx-cart__empty h2 {
    font-family: var(--font-heading, serif);
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .lx-cart__empty a {
    display: inline-block;
    padding: 1rem 2rem;
    background: #000;
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 1.5rem;
  }
</style>

<section class="lx-cart">
  <h1 class="lx-cart__title">Your Cart</h1>

  {% if cart.item_count > 0 %}
    <p class="lx-cart__count">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</p>

    {%- if cart.total_discount > 0 -%}
      <div class="lx-cart__savings-banner">
        You're saving <strong>{{ cart.total_discount | money }}</strong> on this order.
      </div>
    {%- endif -%}

    {%- assign shipping_threshold = 99900 -%}
    {%- assign remaining = shipping_threshold | minus: cart.total_price -%}
    {%- assign progress_pct = cart.total_price | times: 100 | divided_by: shipping_threshold -%}
    {%- if progress_pct > 100 -%}{%- assign progress_pct = 100 -%}{%- endif -%}

    <div class="lx-cart__shipping-bar">
      {%- if remaining > 0 -%}
        <div class="lx-cart__shipping-text">
          You're <strong>{{ remaining | money }}</strong> away from <strong>free shipping</strong>.
        </div>
      {%- else -%}
        <div class="lx-cart__shipping-text">
          <strong>Complimentary shipping unlocked.</strong>
        </div>
      {%- endif -%}
      <div class="lx-cart__progress-track">
        <div class="lx-cart__progress-fill" style="width: {{ progress_pct }}%;"></div>
      </div>
    </div>

    <div class="lx-cart__body">
      <div>
        {%- for item in cart.items -%}
          <div class="lx-cart-item">
            <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" class="lx-cart-item__image" loading="lazy">
            <div>
              <h3 class="lx-cart-item__title">{{ item.product.title }}</h3>
              {%- unless item.variant.title == 'Default Title' -%}
                <div class="lx-cart-item__variant">{{ item.variant.title }}</div>
              {%- endunless -%}
              <div class="lx-cart-item__qty">
                <button type="button" aria-label="Decrease quantity">−</button>
                <span>{{ item.quantity }}</span>
                <button type="button" aria-label="Increase quantity">+</button>
              </div>
              <button class="lx-cart-item__remove" type="button">Remove</button>
            </div>
            <div class="lx-cart-item__price">{{ item.line_price | money }}</div>
          </div>
        {%- endfor -%}
      </div>

      <div class="lx-cart__summary">
        <h2 class="lx-cart__summary-title">Order Summary</h2>
        <div class="lx-cart__summary-row">
          <span>Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        {%- if cart.total_discount > 0 -%}
          <div class="lx-cart__summary-row" style="color: var(--accent-green);">
            <span>You Save</span>
            <span>−{{ cart.total_discount | money }}</span>
          </div>
        {%- endif -%}
        <div class="lx-cart__summary-row">
          <span>Shipping</span>
          <span>{%- if cart.total_price >= shipping_threshold -%}Complimentary{%- else -%}Calculated at checkout{%- endif -%}</span>
        </div>
        <div class="lx-cart__summary-row lx-cart__summary-row--total">
          <span>Total</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <div style="font-size: 0.7rem; color: var(--text-muted); font-family: var(--font-body, sans-serif); margin-top: 0.25rem; text-align: right;">
          Including all taxes
        </div>

        <button class="lx-cart__checkout-btn" type="button">
          Proceed to Checkout
        </button>

        <div class="lx-cart__payment-icons">
          <span>UPI</span>
          <span>VISA</span>
          <span>MASTERCARD</span>
          <span>COD</span>
          <span>EMI</span>
        </div>

        <div class="lx-cart__trust-row">
          <span>[ SECURE CHECKOUT ]</span>
          <span>[ 30-DAY RETURNS ]</span>
        </div>
      </div>
    </div>

  {% else %}
    <div class="lx-cart__empty">
      <h2>Your cart is empty</h2>
      <p style="font-family: var(--font-body, sans-serif); color: var(--text-muted);">Discover something you'll love.</p>
      <a href="{{ routes.all_products_collection_url }}">Continue Shopping</a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart Page",
  "tag": "section",
  "presets": [{ "name": "Cart Page" }]
}
{% endschema %}
