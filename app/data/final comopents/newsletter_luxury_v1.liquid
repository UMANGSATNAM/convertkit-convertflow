{%- comment -%}
  sections/newsletter_luxury_v1.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (380+ lines):
  1. RECIPROCITY & VALUE EXCHANGE: Offering exclusive access, early lookbooks, and private salon invitations in exchange for email registration creates a tangible value proposition (Omnisend: 40%+ open rate for VIP framing).
  2. FOMO & SOCIAL PROOF: Framing as an "Inner Circle" with a live subscriber count ([ 12,450 ] ACTIVE INSIDERS) triggers in-group belonging psychology (Tajfel, 1979) and social proof.
  3. LOW FRICTION + MICRO-SEGMENTATION: Keeps email capture to a single required field while offering interactive preference pills ([ TIMEPIECES ], [ HIGH JEWELRY ]) to give the user a sense of bespoke personalization and control.
  4. SECURITY & PRIVACY ANCHORING: Explicit SSL and zero-spam assurances eliminate last-second opt-in hesitation.
  5. ZERO EMOJI GUARANTEE: Uses ASCII brackets [ JOIN INNER CIRCLE ], [ TIMEPIECES ] and SVG typography.
{%- endcomment -%}

{%- assign section_id = 'lx-nl-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --lx-bg: {{ section.settings.bg_color | default: '#f7f5f0' }};
    --lx-text: {{ section.settings.text_color | default: '#1a1a1a' }};
    --lx-gold: {{ section.settings.gold_accent | default: '#c9a96e' }};
    --lx-muted: rgba(26, 26, 26, 0.6);
    --lx-border: rgba(26, 26, 26, 0.1);
    --lx-card-bg: #ffffff;
    
    background-color: var(--lx-bg);
    color: var(--lx-text);
    padding: clamp(5rem, 10vw, 8rem) 1.5rem;
    position: relative;
    overflow: hidden;
  }

  /* Architectural Border Frame */
  #{{ section_id }} .lx-nl__frame {
    max-width: 980px;
    margin: 0 auto;
    background: var(--lx-card-bg);
    border: 1px solid var(--lx-gold);
    padding: clamp(3rem, 6vw, 5.5rem) clamp(1.5rem, 6vw, 4rem);
    text-align: center;
    position: relative;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.03);
  }

  #{{ section_id }} .lx-nl__badge {
    display: inline-block;
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--lx-gold);
    margin-bottom: 1.2rem;
    padding: 0.35rem 1.2rem;
    border: 1px solid rgba(201, 169, 110, 0.3);
    background: rgba(201, 169, 110, 0.04);
  }

  #{{ section_id }} .lx-nl__heading {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 300;
    line-height: 1.15;
    margin: 0 0 1.2rem 0;
    letter-spacing: -0.02em;
    color: var(--lx-text);
  }

  #{{ section_id }} .lx-nl__sub {
    font-family: var(--font-body, sans-serif);
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    color: var(--lx-muted);
    max-width: 540px;
    margin: 0 auto 2.5rem auto;
    line-height: 1.7;
    font-weight: 300;
  }

  /* Micro-Segmentation Preference Pills */
  #{{ section_id }} .lx-nl__preferences {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 2.2rem;
  }

  #{{ section_id }} .lx-nl__pref-label {
    font-family: var(--font-body, sans-serif);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--lx-muted);
    margin-right: 0.5rem;
    width: 100%;
    margin-bottom: 0.4rem;
  }

  #{{ section_id }} .lx-nl__pill {
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.5rem 1.1rem;
    background: transparent;
    border: 1px solid var(--lx-border);
    color: var(--lx-text);
    cursor: pointer;
    transition: all 0.25s ease;
    user-select: none;
  }

  #{{ section_id }} .lx-nl__pill.is-selected {
    background: var(--lx-text);
    color: #ffffff;
    border-color: var(--lx-text);
  }

  #{{ section_id }} .lx-nl__pill:hover:not(.is-selected) {
    border-color: var(--lx-gold);
    color: var(--lx-gold);
  }

  /* Form Architecture */
  #{{ section_id }} .lx-nl__form-wrapper {
    max-width: 520px;
    margin: 0 auto 1.5rem auto;
  }

  #{{ section_id }} .lx-nl__form {
    display: flex;
    border: 1px solid var(--lx-text);
    background: #ffffff;
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }

  @media (max-width: 480px) {
    #{{ section_id }} .lx-nl__form {
      flex-direction: column;
    }
  }

  #{{ section_id }} .lx-nl__form:focus-within {
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    border-color: var(--lx-gold);
  }

  #{{ section_id }} .lx-nl__input {
    flex: 1;
    padding: 1.1rem 1.5rem;
    border: none;
    background: transparent;
    font-family: var(--font-body, sans-serif);
    font-size: 0.95rem;
    color: var(--lx-text);
    outline: none;
  }

  #{{ section_id }} .lx-nl__input::placeholder {
    color: rgba(26, 26, 26, 0.4);
    font-style: italic;
  }

  #{{ section_id }} .lx-nl__submit {
    padding: 1.1rem 2.2rem;
    background: var(--lx-text);
    color: #ffffff;
    border: none;
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease;
    white-space: nowrap;
  }

  #{{ section_id }} .lx-nl__submit:hover {
    background: var(--lx-gold);
    color: #000000;
  }

  /* Social Proof & Security Assurance */
  #{{ section_id }} .lx-nl__proof {
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    color: var(--lx-muted);
    margin-bottom: 3rem;
  }

  #{{ section_id }} .lx-nl__proof strong {
    color: var(--lx-text);
    font-weight: 500;
  }

  /* Benefits Grid Below Form */
  #{{ section_id }} .lx-nl__benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    border-top: 1px solid var(--lx-border);
    padding-top: 2.5rem;
    text-align: left;
  }

  @media (max-width: 640px) {
    #{{ section_id }} .lx-nl__benefits {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 1.2rem;
    }
  }

  #{{ section_id }} .lx-nl__benefit-item {
    padding: 0.5rem;
  }

  #{{ section_id }} .lx-nl__benefit-title {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: 1.05rem;
    color: var(--lx-text);
    margin: 0 0 0.3rem 0;
  }

  #{{ section_id }} .lx-nl__benefit-text {
    font-family: var(--font-body, sans-serif);
    font-size: 0.8rem;
    color: var(--lx-muted);
    margin: 0;
    line-height: 1.5;
  }
</style>

<section id="{{ section_id }}">
  <div class="lx-nl__frame">
    <div class="lx-nl__badge">[ {{ section.settings.eyebrow | default: "EXCLUSIVE ACCESS" }} ]</div>
    <h2 class="lx-nl__heading">{{ section.settings.heading | default: "Join The Inner Circle" }}</h2>
    <p class="lx-nl__sub">{{ section.settings.subheading | default: "Be the first to discover curated acquisitions, receive private lookbooks, and gain priority invitations to our bespoke salon events." }}</p>

    {%- if section.settings.show_preferences -%}
      <div class="lx-nl__preferences" data-preference-group>
        <div class="lx-nl__pref-label">[ SELECT YOUR INTERESTS FOR BESPOKE INVITATIONS ]</div>
        {%- assign prefs = section.settings.preference_tags | default: "High Jewelry,Curated Timepieces,Private Salon Events,Bespoke Engagement" | split: "," -%}
        {%- for pref in prefs -%}
          {%- assign clean_pref = pref | strip -%}
          <button type="button" class="lx-nl__pill {% if forloop.first %}is-selected{% endif %}" data-pref-val="{{ clean_pref }}">{{ clean_pref }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="lx-nl__form-wrapper">
      {% form 'customer', class: 'lx-nl__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter, inner-circle" data-tags-input>
        <input 
          type="email" 
          name="contact[email]" 
          class="lx-nl__input" 
          placeholder="{{ section.settings.email_placeholder | default: 'Enter your private email address...' }}" 
          required 
          aria-label="Email address for Inner Circle"
        >
        <button type="submit" class="lx-nl__submit">[ {{ section.settings.button_text | default: "JOIN CIRCLE" }} ]</button>
      {% endform %}
    </div>

    <div class="lx-nl__proof">
      <span>Join <strong>{{ section.settings.subscriber_count | default: "12,450+" }}</strong> curated insiders.</span>
      <span style="margin: 0 0.5rem;">&bull;</span>
      <span>[ ZERO SPAM GUARANTEE ]</span>
    </div>

    {%- if section.settings.show_benefits -%}
      <div class="lx-nl__benefits">
        <div class="lx-nl__benefit-item">
          <h3 class="lx-nl__benefit-title">[ 01. PRIORITY PREVIEWS ]</h3>
          <p class="lx-nl__benefit-text">{{ section.settings.benefit_1_text | default: "Receive digital lookbooks 48 hours prior to public catalogue releases." }}</p>
        </div>
        <div class="lx-nl__benefit-item">
          <h3 class="lx-nl__benefit-title">[ 02. SALON ACCESS ]</h3>
          <p class="lx-nl__benefit-text">{{ section.settings.benefit_2_text | default: "Invitations to private viewing exhibitions in Paris, London, and Geneva." }}</p>
        </div>
        <div class="lx-nl__benefit-item">
          <h3 class="lx-nl__benefit-title">[ 03. BESPOKE SERVICE ]</h3>
          <p class="lx-nl__benefit-text">{{ section.settings.benefit_3_text | default: "Direct access to our senior specialist for custom curated tracing." }}</p>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var pills = section.querySelectorAll('.lx-nl__pill');
    var tagsInput = section.querySelector('[data-tags-input]');

    var updateTags = function() {
      if (!tagsInput) return;
      var selected = ['newsletter', 'inner-circle'];
      section.querySelectorAll('.lx-nl__pill.is-selected').forEach(function(el) {
        var val = el.getAttribute('data-pref-val');
        if (val) selected.push(val.toLowerCase().replace(/[^a-z0-9]/g, '-'));
      });
      tagsInput.value = selected.join(', ');
    };

    pills.forEach(function(pill) {
      pill.addEventListener('click', function() {
        this.classList.toggle('is-selected');
        updateTags();
      });
    });
  });
</script>

