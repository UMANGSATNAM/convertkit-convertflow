{%- comment -%}
  sections/sustainability-badge_beauty.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (380+ lines):
  1. ETHICAL ALIGNMENT & GUILT ELIMINATION: In clinical beauty and luxury skincare, eco-conscious consumers experience cognitive dissonance over packaging waste. Proving 100% PCR recyclable glass and Leaping Bunny cruelty-free certification eradicates moral purchase friction.
  2. LIVE ENVIRONMENTAL IMPACT CALCULATOR: Translates individual purchases into tangible planetary metrics ([ 12 PLASTIC BOTTLES DIVERTED ], [ -64% CO2 EMISSIONS ]), transforming shopping into a positive environmental action.
  3. CIRCULAR REFILL LOYALTY PROTOCOL: Highlighting a free refill voucher program for returning empty vessels encourages long-term retention and brand evangelism.
  4. ZERO EMOJI GUARANTEE: Uses clinical ASCII brackets [ LEAPING BUNNY ], [ 100% PCR GLASS ], [ REEF SAFE ], and botanical forest green styling.
{%- endcomment -%}

{%- assign section_id = 'bt-sust-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --sust-bg: {{ section.settings.bg_color | default: '#f4f9f5' }};
    --sust-card: #ffffff;
    --sust-border: #c8e0d0;
    --sust-text: #2d3748;
    --sust-heading: #1a202c;
    --sust-green: #1b4d36;
    --sust-accent: #2e6b4d;
    --sust-light-bg: #e8f3ec;
    --sust-muted: #718096;

    background-color: var(--sust-bg);
    color: var(--sust-text);
    padding: clamp(4rem, 8vw, 7rem) clamp(1.2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--sust-border);
    border-bottom: 1px solid var(--sust-border);
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    position: relative;
  }

  #{{ section_id }} .sust__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Header Ribbon */
  #{{ section_id }} .sust__header {
    text-align: center;
    max-width: 850px;
    margin: 0 auto 3.5rem auto;
  }

  #{{ section_id }} .sust__badge {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--sust-green);
    background: var(--sust-light-bg);
    border: 1px solid var(--sust-border);
    padding: 0.35rem 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  #{{ section_id }} .sust__title {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 800;
    color: var(--sust-heading);
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }

  #{{ section_id }} .sust__sub {
    font-size: 0.95rem;
    color: var(--sust-muted);
    line-height: 1.6;
  }

  #{{ section_id }} .sust__sub strong {
    color: var(--sust-green);
  }

  /* Real-Time Eco Impact Box */
  #{{ section_id }} .sust__impact-box {
    background: var(--sust-card);
    border: 2px solid var(--sust-green);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    margin-bottom: 3.5rem;
    box-shadow: 0 15px 35px rgba(27, 77, 54, 0.08);
  }

  #{{ section_id }} .sust__imp-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    border-bottom: 2px solid var(--sust-light-bg);
    padding-bottom: 1rem;
    margin-bottom: 1.8rem;
  }

  #{{ section_id }} .sust__imp-title {
    font-size: 1rem;
    font-weight: 800;
    color: var(--sust-green);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }

  #{{ section_id }} .sust__cert-pill {
    font-size: 0.72rem;
    font-weight: 800;
    color: #ffffff;
    background: var(--sust-green);
    padding: 0.3rem 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Metric Grid */
  #{{ section_id }} .sust__metrics {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1.8rem;
  }

  @media (min-width: 600px) {
    #{{ section_id }} .sust__metrics { grid-template-columns: repeat(3, 1fr); }
  }

  #{{ section_id }} .sust__metric-card {
    background: var(--sust-light-bg);
    border: 1px solid var(--sust-border);
    padding: 1.5rem 1rem;
    text-align: center;
  }

  #{{ section_id }} .sust__metric-num {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 900;
    color: var(--sust-green);
    line-height: 1;
    margin-bottom: 0.4rem;
  }

  #{{ section_id }} .sust__metric-lbl {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--sust-heading);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  #{{ section_id }} .sust__metric-sub {
    font-size: 0.68rem;
    color: var(--sust-muted);
    margin-top: 0.3rem;
  }

  /* Quantity Simulation Toggle */
  #{{ section_id }} .sust__calc-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    background: #ffffff;
    border: 1px dashed var(--sust-border);
    padding: 1rem 1.5rem;
  }

  #{{ section_id }} .sust__calc-lbl {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--sust-text);
  }

  #{{ section_id }} .sust__calc-btns {
    display: flex;
    gap: 0.5rem;
  }

  #{{ section_id }} .sust__calc-btn {
    background: var(--sust-light-bg);
    border: 1px solid var(--sust-border);
    color: var(--sust-green);
    padding: 0.4rem 0.85rem;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .sust__calc-btn.is-active,
  #{{ section_id }} .sust__calc-btn:hover {
    background: var(--sust-green);
    color: #ffffff;
    border-color: var(--sust-green);
  }

  /* Toolbar: Eco-Audit Tabs */
  #{{ section_id }} .sust__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.8rem;
  }

  #{{ section_id }} .sust__tab {
    background: var(--sust-card);
    border: 1px solid var(--sust-border);
    color: var(--sust-muted);
    padding: 0.75rem 1.4rem;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .sust__tab.is-active,
  #{{ section_id }} .sust__tab:hover {
    background: var(--sust-green);
    color: #ffffff;
    border-color: var(--sust-green);
  }

  /* Tab Panel */
  #{{ section_id }} .sust__panel {
    background: var(--sust-card);
    border: 1px solid var(--sust-border);
    padding: clamp(1.8rem, 4vw, 3rem);
    margin-bottom: 2.5rem;
  }

  #{{ section_id }} .sust__content {
    display: none;
    animation: fadeIn 0.3s ease;
  }

  #{{ section_id }} .sust__content.is-active {
    display: block;
  }

  #{{ section_id }} .sust__content-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--sust-heading);
    margin: 0 0 0.8rem 0;
    text-transform: uppercase;
  }

  #{{ section_id }} .sust__content-desc {
    font-size: 0.88rem;
    color: var(--sust-muted);
    line-height: 1.65;
    margin: 0 0 1.5rem 0;
  }

  #{{ section_id }} .sust__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    #{{ section_id }} .sust__grid { grid-template-columns: repeat(2, 1fr); }
  }

  #{{ section_id }} .sust__grid-item {
    background: var(--sust-light-bg);
    border: 1px solid var(--sust-border);
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #{{ section_id }} .sust__grid-lbl {
    font-size: 0.72rem;
    color: var(--sust-muted);
    text-transform: uppercase;
  }

  #{{ section_id }} .sust__grid-val {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--sust-green);
    text-transform: uppercase;
  }

  /* Circular Refill Modal Trigger */
  #{{ section_id }} .sust__refill-btn {
    width: 100%;
    background: var(--sust-green);
    color: #ffffff;
    border: none;
    padding: 1.1rem;
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: background 0.2s ease;
    margin-bottom: 2rem;
  }

  #{{ section_id }} .sust__refill-btn:hover {
    background: #123323;
  }

  #{{ section_id }} .sust__modal-box {
    background: #ffffff;
    border: 2px solid var(--sust-green);
    padding: 2rem;
    margin-bottom: 2.5rem;
    display: none;
    position: relative;
    box-shadow: 0 15px 30px rgba(27, 77, 54, 0.12);
  }

  #{{ section_id }} .sust__modal-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--sust-green);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 1rem 0;
  }

  #{{ section_id }} .sust__modal-text {
    font-size: 0.85rem;
    color: var(--sust-text);
    line-height: 1.6;
    margin: 0 0 1rem 0;
  }

  #{{ section_id }} .sust__modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: transparent;
    border: 1px solid var(--sust-border);
    color: var(--sust-muted);
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    padding: 0.25rem 0.6rem;
  }

  /* Footer Guarantee */
  #{{ section_id }} .sust__footer {
    background: var(--sust-light-bg);
    border: 1px solid var(--sust-border);
    padding: 1.5rem;
    text-align: center;
    font-size: 0.78rem;
    color: var(--sust-accent);
    line-height: 1.6;
  }

  #{{ section_id }} .sust__footer strong {
    color: var(--sust-green);
  }
</style>

<section id="{{ section_id }}">
  <div class="sust__container">
    <div class="sust__header">
      <span class="sust__badge">[ {{ section.settings.eyebrow | default: "SYS.VERIFIED: CONSCIOUS BIOTEC ARCHITECTURE" }} ]</span>
      <h2 class="sust__title">{{ section.settings.heading | default: "Ethical & Marine-Safe Commitment" }}</h2>
      <p class="sust__sub">
        Luxury skincare should never come at the expense of our planetary biosphere. Every StoreForge formula is housed in <strong>100% Post-Consumer Recycled (PCR) glass vessels</strong> and certified cruelty-free by Leaping Bunny international.
      </p>
    </div>

    <!-- Live Environmental Impact Box -->
    <div class="sust__impact-box">
      <div class="sust__imp-head">
        <h3 class="sust__imp-title">[ YOUR PLANETARY FOOTPRINT SAVINGS ]</h3>
        <span class="sust__cert-pill">[ LEAPING BUNNY &bull; REEF SAFE ]</span>
      </div>

      <div class="sust__metrics">
        <div class="sust__metric-card">
          <div class="sust__metric-num" data-val-plastic>[ 12 PCS ]</div>
          <div class="sust__metric-lbl">PLASTIC BOTTLES DIVERTED</div>
          <div class="sust__metric-sub">// Prevented from entering marine ecosystems //</div>
        </div>
        <div class="sust__metric-card">
          <div class="sust__metric-num" data-val-co2>[ -64% ]</div>
          <div class="sust__metric-lbl">CO2 EMISSIONS REDUCTION</div>
          <div class="sust__metric-sub">// Compared to virgin acrylic packaging //</div>
        </div>
        <div class="sust__metric-card">
          <div class="sust__metric-num" data-val-reef>[ +10 SQ FT ]</div>
          <div class="sust__metric-lbl">CORAL REEF RESTORED</div>
          <div class="sust__metric-sub">// Funded via 1% For The Planet contributions //</div>
        </div>
      </div>

      <div class="sust__calc-row">
        <span class="sust__calc-lbl">SIMULATE IMPACT ACROSS YOUR ANNUAL SKINCARE REGIMEN:</span>
        <div class="sust__calc-btns" data-qty-group>
          <button type="button" class="sust__calc-btn is-active" data-mult="1">[ 1 VESSEL ]</button>
          <button type="button" class="sust__calc-btn" data-mult="3">[ 3 MONTH SUPPLY ]</button>
          <button type="button" class="sust__calc-btn" data-mult="6">[ ANNUAL 6-PACK ]</button>
        </div>
      </div>
    </div>

    <!-- Toolbar: Eco-Audit Tabs -->
    <div class="sust__toolbar" data-sust-tabs>
      <button type="button" class="sust__tab is-active" data-target="glass">[ 01: 100% PCR GLASS VESSEL ]</button>
      <button type="button" class="sust__tab" data-target="bunny">[ 02: LEAPING BUNNY CRUELTY-FREE ]</button>
      <button type="button" class="sust__tab" data-target="reef">[ 03: REEF-SAFE BIO-DEGRADABLE ]</button>
      <button type="button" class="sust__tab" data-target="refill">[ 04: CIRCULAR REFILL SYSTEM ]</button>
    </div>

    <!-- Tab Panel -->
    <div class="sust__panel">
      <!-- Content 1: Glass -->
      <div class="sust__content is-active" data-content="glass">
        <h3 class="sust__content-title">[ INFINITELY RECYCLABLE PCR GLASS ]</h3>
        <p class="sust__content-desc">
          Unlike plastic acrylics that leach micro-toxins and degrade in landfills for 450 years, our medical-grade amber glass is molded from 80% Post-Consumer Recycled materials and can be recycled indefinitely without loss of purity.
        </p>
        <div class="sust__grid">
          <div class="sust__grid-item">
            <span class="sust__grid-lbl">VESSEL MATERIAL:</span>
            <span class="sust__grid-val">80% PCR MEDICAL AMBER GLASS</span>
          </div>
          <div class="sust__grid-item">
            <span class="sust__grid-lbl">UV PROTECTION:</span>
            <span class="sust__grid-val">99.4% BIOPHOTONIC BLOCKING</span>
          </div>
          <div class="sust__grid-item">
            <span class="sust__grid-lbl">PUMP MECHANISM:</span>
            <span class="sust__grid-val">MONO-MATERIAL ANODIZED ALUMINUM</span>
          </div>
          <div class="sust__grid-item">
            <span class="sust__grid-lbl">LANDFILL DEGRADATION:</span>
            <span class="sust__grid-val">ZERO MICRO-PLASTIC SHEDDING</span>
          </div>
        </div>
      </div>

      <!-- Content 2: Bunny -->
      <div class="sust__content" data-content="bunny">
        <h3 class="sust__content-title">[ LEAPING BUNNY &amp; 100% VEGAN ASSAY ]</h3>
        <p class="sust__content-desc">
          We conduct zero animal testing across any phase of formulation or ingredient sourcing. Certified by the Coalition for Consumer Information on Cosmetics (Leaping Bunny) and registered with the Vegan Society.
        </p>
        <div class="sust__grid">
          <div class="sust__grid-item">
            <span class="sust__grid-lbl">ANIMAL TESTING:</span>
            <span class="sust__grid-val">0.0% &bull; NEVER TESTED ON ANIMALS</span>
          </div>
          <div class="sust__grid-item">
            <span class="sust__grid-lbl">VEGAN STATUS:</span>
            <span class="sust__grid-val">100% PLANT &amp; BIOTEC DERIVED</span>
          </div>
          <div class="sust__grid-item">
            <span class="sust__grid-lbl">SUPPLIER AUDIT:</span>
            <span class="sust__grid-val">ANNUAL ON-SITE ETHICAL ASSAY</span>
          </div>
          <div class="sust__grid-item">
            <span class="sust__grid-lbl">CERTIFICATE ID:</span>
            <span class="sust__grid-val">LB-2026-STOREFORGE-GLOBAL</span>
          </div>
        </div>
      </div>

      <!-- Content 3: Reef -->
      <div class="sust__content" data-content="reef">
        <h3 class="sust__content-title">[ REEF &amp; MARINE ECOSYSTEM SAFE ]</h3>
        <p class="sust__content-desc">
          Standard skincare formulations contain oxybenzone, octinoxate, and synthetic silicones that bleach coral reefs and disrupt marine endocrine systems. Our active botanical matrix is 100% biodegradable and ocean compatible.
        </p>
        <div class="sust__grid">
          <div class="sust__grid-item">
            <span class="sust__grid-lbl">OXYBENZONE / OCTINOXATE:</span>
            <span class="sust__grid-val">0.0% &bull; REEF SAFE GUARANTEED</span>
          </div>
          <div class="sust__grid-item">
            <span class="sust__grid-lbl">BIODEGRADABILITY:</span>
            <span class="sust__grid-val">99.8% IN 28 DAYS (OECD 301B)</span>
          </div>
          <div class="sust__grid-item">
            <span class="sust__grid-lbl">PARABENS / SULFATES:</span>
            <span class="sust__grid-val">ZERO SYNTHETIC PRESERVATIVES</span>
          </div>
          <div class="sust__grid-item">
            <span class="sust__grid-lbl">MARINE COMPATIBILITY:</span>
            <span class="sust__grid-val">HAWAII &amp; PALAU REEF COMPLIANT</span>
          </div>
        </div>
      </div>

      <!-- Content 4: Refill -->
      <div class="sust__content" data-content="refill">
        <h3 class="sust__content-title">[ THE CIRCULAR REFILL REWARD PROGRAM ]</h3>
        <p class="sust__content-desc">
          Never throw away an empty StoreForge glass vessel. Return 3 empty jars using our pre-paid biodegradable carbon-neutral shipping box to receive a complimentary full-sized refill of any serum or cream in our catalog.
        </p>
        <div class="sust__grid">
          <div class="sust__grid-item">
            <span class="sust__grid-lbl">RETURN REQUIREMENT:</span>
            <span class="sust__grid-val">3 EMPTY GLASS VESSELS</span>
          </div>
          <div class="sust__grid-item">
            <span class="sust__grid-lbl">SHIPPING COST:</span>
            <span class="sust__grid-val">100% PRE-PAID ECO LABEL</span>
          </div>
          <div class="sust__grid-item">
            <span class="sust__grid-lbl">REWARD VALUE:</span>
            <span class="sust__grid-val">FREE FULL-SIZED SERUM VOUCHER</span>
          </div>
          <div class="sust__grid-item">
            <span class="sust__grid-lbl">CIRCULARITY RATE:</span>
            <span class="sust__grid-val">84.2% OF VESSELS RE-WASHED</span>
          </div>
        </div>
      </div>
    </div>

    <button type="button" class="sust__refill-btn" data-modal-open>[ HOW DOES THE FREE REFILL REWARD PROGRAM WORK? ]</button>

    <!-- Circular Refill Modal -->
    <div class="sust__modal-box" data-modal-box>
      <button type="button" class="sust__modal-close" data-modal-close>[ X ] CLOSE</button>
      <div class="sust__modal-title">[ CIRCULAR REFILL INSTRUCTIONS ]</div>
      <p class="sust__modal-text">
        1. Keep your empty StoreForge glass jars (do not rinse with harsh detergents).<br>
        2. Visit your account dashboard and click "Request Eco-Return Label."<br>
        3. Place 3 empty vessels into any cardboard shipping box and adhere the pre-paid label.<br>
        4. Once scanned by the courier, a voucher for a <strong>free full-sized refill (up to RS. 4,500 value)</strong> is instantly credited to your account.
      </p>
      <div style="font-size:0.75rem; color:var(--sust-muted);">
        // Together, we have diverted over 140,000 glass jars from municipal landfills to date. //
      </div>
    </div>

    <!-- Footer Guarantee -->
    <div class="sust__footer">
      // <strong>THE 1% FOR THE PLANET PLEDGE:</strong> Regardless of profitability, we donate 1% of all gross revenues directly to marine conservation and coral reef reforestation projects across the Indian Ocean. //
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var tabs = section.querySelectorAll('.sust__tab');
    var contents = section.querySelectorAll('.sust__content');
    var qtyBtns = section.querySelectorAll('[data-qty-group] .sust__calc-btn');

    var valPlastic = section.querySelector('[data-val-plastic]');
    var valCo2 = section.querySelector('[data-val-co2]');
    var valReef = section.querySelector('[data-val-reef]');

    var modalOpen = section.querySelector('[data-modal-open]');
    var modalBox = section.querySelector('[data-modal-box]');
    var modalClose = section.querySelector('[data-modal-close]');

    qtyBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        qtyBtns.forEach(function(b) { b.classList.remove('is-active'); });
        this.classList.add('is-active');
        var mult = parseInt(this.getAttribute('data-mult') || '1', 10);

        if (valPlastic) valPlastic.textContent = '[ ' + (12 * mult) + ' PCS ]';
        if (valCo2) valCo2.textContent = '[ -' + Math.min(88, (64 + (mult * 4))) + '% ]';
        if (valReef) valReef.textContent = '[ +' + (10 * mult) + ' SQ FT ]';
      });
    });

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('is-active'); });
        this.classList.add('is-active');
        var target = this.getAttribute('data-target') || 'glass';

        contents.forEach(function(c) {
          var cTarget = c.getAttribute('data-content') || 'glass';
          if (cTarget === target) {
            c.classList.add('is-active');
          } else {
            c.classList.remove('is-active');
          }
        });
      });
    });

    if (modalOpen) {
      modalOpen.addEventListener('click', function() {
        if (modalBox) {
          modalBox.style.display = 'block';
          modalBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    }

    if (modalClose) {
      modalClose.addEventListener('click', function() {
        if (modalBox) modalBox.style.display = 'none';
      });
    }
  });
</script>

