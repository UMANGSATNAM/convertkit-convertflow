{%- comment -%}
  sections/doctor-endorsement_supplements.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (380+ lines):
  1. MEDICAL AUTHORITY & HALO EFFECT (Cialdini's Authority): Supplement buyers experience high bodily risk anxiety. Featuring explicit credentials from MDs, PhD biochemists, and Ayurvedic physicians eliminates health skepticism and establishes clinical trust.
  2. INTERACTIVE ADVISORY BOARD TABS: Toggling between specialists ([ SPORTS PHYSIOLOGY ], [ BIOCHEMISTRY ], [ AYURVEDIC INTEGRATION ]) demonstrates holistic, multi-disciplinary validation.
  3. CLINICAL RESEARCH ABSTRACT VALIDATION: An interactive trigger ([ VIEW PEER-REVIEWED ABSTRACT ]) allowing consumers to read actual clinical trial design summaries (e.g., Double-Blind Placebo N=450) validates scientific rigor.
  4. PHYSICIAN Q&A PROTOCOL: An embedded accordion addresses bioavailability and safety questions before checkout.
  5. ZERO EMOJI GUARANTEE: Uses clinical-grade ASCII brackets [ ADVISORY BOARD ], [ CLINICAL TRIAL ], and laboratory aesthetics.
{%- endcomment -%}

{%- assign section_id = 'sp-doc-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --doc-bg: {{ section.settings.bg_color | default: '#f8fafc' }};
    --doc-card: #ffffff;
    --doc-border: #cbd5e1;
    --doc-text: #1e293b;
    --doc-heading: #0f172a;
    --doc-blue: #0f2d5c;
    --doc-accent: #0284c7;
    --doc-muted: #64748b;

    background-color: var(--doc-bg);
    color: var(--doc-text);
    padding: clamp(4rem, 8vw, 7rem) clamp(1.2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--doc-border);
    border-bottom: 1px solid var(--doc-border);
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    position: relative;
  }

  #{{ section_id }} .doc__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Header Ribbon */
  #{{ section_id }} .doc__header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem auto;
  }

  #{{ section_id }} .doc__sys-badge {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--doc-blue);
    background: #e2e8f0;
    border: 1px solid var(--doc-border);
    padding: 0.35rem 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  #{{ section_id }} .doc__title {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 800;
    color: var(--doc-heading);
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }

  #{{ section_id }} .doc__sub {
    font-size: 0.95rem;
    color: var(--doc-muted);
    line-height: 1.6;
  }

  #{{ section_id }} .doc__sub strong {
    color: var(--doc-heading);
  }

  /* Interactive Advisory Board Tabs */
  #{{ section_id }} .doc__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-bottom: 3rem;
  }

  #{{ section_id }} .doc__tab {
    background: transparent;
    border: 1px solid var(--doc-border);
    color: var(--doc-muted);
    padding: 0.7rem 1.4rem;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  #{{ section_id }} .doc__tab.is-active,
  #{{ section_id }} .doc__tab:hover {
    background: var(--doc-blue);
    color: #ffffff;
    border-color: var(--doc-blue);
    box-shadow: 0 4px 12px rgba(15, 45, 92, 0.15);
  }

  /* Doctor Dossier Cards */
  #{{ section_id }} .doc__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  #{{ section_id }} .doc__card {
    background: var(--doc-card);
    border: 1px solid var(--doc-border);
    padding: clamp(1.8rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    transition: all 0.3s ease;
  }

  @media (min-width: 768px) {
    #{{ section_id }} .doc__card {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  #{{ section_id }} .doc__card.is-hidden {
    display: none;
  }

  #{{ section_id }} .doc__avatar-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 180px;
  }

  #{{ section_id }} .doc__avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--doc-blue);
    margin-bottom: 1rem;
    background: #e2e8f0;
  }

  #{{ section_id }} .doc__name {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--doc-heading);
    margin: 0 0 0.2rem 0;
  }

  #{{ section_id }} .doc__cred {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--doc-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  #{{ section_id }} .doc__info {
    flex: 1;
  }

  #{{ section_id }} .doc__quote {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    font-style: italic;
    color: var(--doc-heading);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
    padding-left: 1.2rem;
    border-left: 4px solid var(--doc-blue);
  }

  #{{ section_id }} .doc__bio {
    font-size: 0.85rem;
    color: var(--doc-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  #{{ section_id }} .doc__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  #{{ section_id }} .doc__abstract-btn {
    background: var(--doc-blue);
    color: #ffffff;
    border: none;
    padding: 0.7rem 1.4rem;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  #{{ section_id }} .doc__abstract-btn:hover {
    background: #0a1e3f;
  }

  #{{ section_id }} .doc__verify-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--doc-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Clinical Research Abstract Modal / Drawer Banner */
  #{{ section_id }} .doc__modal-box {
    background: var(--doc-card);
    border: 2px solid var(--doc-blue);
    padding: 2rem;
    margin-bottom: 3rem;
    display: none;
    position: relative;
    box-shadow: 0 20px 40px rgba(15, 45, 92, 0.1);
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  #{{ section_id }} .doc__modal-title {
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--doc-blue);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 0.75rem 0;
  }

  #{{ section_id }} .doc__modal-text {
    font-size: 0.88rem;
    color: var(--doc-text);
    line-height: 1.65;
    margin: 0 0 1rem 0;
  }

  #{{ section_id }} .doc__modal-meta {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--doc-accent);
    text-transform: uppercase;
  }

  #{{ section_id }} .doc__modal-close {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    background: transparent;
    border: 1px solid var(--doc-border);
    color: var(--doc-muted);
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    padding: 0.3rem 0.6rem;
  }

  /* Physician Q&A Accordion Protocol */
  #{{ section_id }} .doc__faq {
    background: var(--doc-card);
    border: 1px solid var(--doc-border);
    padding: 2rem;
  }

  #{{ section_id }} .doc__faq-title {
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--doc-blue);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 1.5rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--doc-border);
  }

  #{{ section_id }} .doc__faq-item {
    border-bottom: 1px solid #e2e8f0;
  }

  #{{ section_id }} .doc__faq-sum {
    padding: 1.2rem 0;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--doc-heading);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }

  #{{ section_id }} .doc__faq-sum::-webkit-details-marker {
    display: none;
  }

  #{{ section_id }} .doc__faq-ans {
    padding: 0 0 1.2rem 0;
    font-size: 0.85rem;
    color: var(--doc-muted);
    line-height: 1.6;
  }

  /* Footer Trust Strip */
  #{{ section_id }} .doc__footer {
    margin-top: 2.5rem;
    padding: 1.2rem;
    background: #e2e8f0;
    border: 1px solid var(--doc-border);
    text-align: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--doc-blue);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
</style>

<section id="{{ section_id }}">
  <div class="doc__container">
    <div class="doc__header">
      <span class="doc__sys-badge">[ {{ section.settings.eyebrow | default: "SYS.VERIFIED: MEDICAL BOARD" }} ]</span>
      <h2 class="doc__title">{{ section.settings.heading | default: "Formulated & Verified by Physicians" }}</h2>
      <p class="doc__sub">
        We refuse to rely on generic wellness hype. Every formula is designed in clinical consultation with our accredited Medical Advisory Board, ensuring <strong>cellular bioavailability, heavy metal safety, and clinical efficacy.</strong>
      </p>
    </div>

    <!-- Toolbar: Advisory Board Tabs -->
    <div class="doc__tabs" data-doc-tabs>
      <button type="button" class="doc__tab is-active" data-doctor="vance">[ DR. MARCUS VANCE - PHYSIOLOGY ]</button>
      <button type="button" class="doc__tab" data-doctor="rostova">[ DR. ELENA ROSTOVA - BIOCHEMISTRY ]</button>
      <button type="button" class="doc__tab" data-doctor="mehta">[ DR. ARJUN MEHTA - AYURVEDIC INTEGRATION ]</button>
    </div>

    <!-- Clinical Research Abstract Modal Box -->
    <div class="doc__modal-box" data-modal-box>
      <button type="button" class="doc__modal-close" data-modal-close>[ X ] CLOSE ABSTRACT</button>
      <div class="doc__modal-title" data-modal-title>[ CLINICAL TRIAL ABSTRACT ]</div>
      <p class="doc__modal-text" data-modal-text>Select any physician dossier below to view peer-reviewed clinical data.</p>
      <div class="doc__modal-meta" data-modal-meta>[ STUDY ID: CLIN-2026-REV4 ]</div>
    </div>

    <!-- Doctor Dossiers Grid -->
    <div class="doc__grid" data-doc-grid>
      {%- for block in section.blocks -%}
        <div 
          class="doc__card {% if forloop.index > 1 %}is-hidden{% endif %}" 
          data-doc-card 
          data-doc-id="{{ block.settings.doc_id | default: 'vance' }}" 
          {{ block.shopify_attributes }}
        >
          <div class="doc__avatar-wrap">
            <img 
              class="doc__avatar" 
              src="{{ block.settings.avatar_url | default: 'https://images.unsplash.com/photo-1537368910025-700350fe46c7?auto=format&fit=crop&w=200&q=80' }}" 
              alt="{{ block.settings.name }}"
            >
            <h3 class="doc__name">{{ block.settings.name | default: "Dr. Marcus Vance" }}</h3>
            <div class="doc__cred">{{ block.settings.cred | default: "MD, PHD SPORTS NUTRITION" }}</div>
          </div>

          <div class="doc__info">
            <blockquote class="doc__quote">"{{ block.settings.quote }}"</blockquote>
            <p class="doc__bio">{{ block.settings.bio }}</p>
            <div class="doc__actions">
              <button 
                type="button" 
                class="doc__abstract-btn" 
                data-abstract-title="{{ block.settings.name }} - Research Abstract"
                data-abstract-text="{{ block.settings.abstract_text }}"
                data-abstract-meta="STUDY ID: {{ block.settings.study_id | default: 'CLIN-2026-V1' }} &bull; N={{ block.settings.sample_size | default: '450' }} PARTICIPANTS"
              >
                [ VIEW PEER-REVIEWED ABSTRACT &rarr; ]
              </button>
              <span class="doc__verify-tag">[ INDEPENDENT CLINICAL ADVISOR ]</span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <!-- Physician Q&A Accordion -->
    <div class="doc__faq">
      <div class="doc__faq-title">// CLINICAL ADVISORY BOARD Q&amp;A ARCHIVE //</div>
      
      <details class="doc__faq-item">
        <summary class="doc__faq-sum">
          <span>Why do your formulas use chelated minerals instead of standard oxides?</span>
          <span>[ + ]</span>
        </summary>
        <div class="doc__faq-ans">
          Inorganic mineral oxides (such as magnesium oxide) pass through the digestive tract with less than 4% absorption, often causing gastric distress. We utilize amino-acid chelation (bisglycinate and citrate forms), which binds the mineral to organic molecules, achieving up to 88% cellular uptake without stomach irritation.
        </div>
      </details>

      <details class="doc__faq-item">
        <summary class="doc__faq-sum">
          <span>Are these supplements tested for heavy metals and WADA compliance?</span>
          <span>[ + ]</span>
        </summary>
        <div class="doc__faq-ans">
          Yes. Every production batch undergoes triple-blind third-party assay testing by ISO 17025 accredited laboratories. We screen for lead, mercury, arsenic, cadmium, and over 280 WADA-banned athletic substances. Certificates of Analysis (COA) are publicly available via lot number.
        </div>
      </details>

      <details class="doc__faq-item">
        <summary class="doc__faq-sum">
          <span>Can I take this clinical stack on an empty stomach?</span>
          <span>[ + ]</span>
        </summary>
        <div class="doc__faq-ans">
          Our formulations include bio-fermented enzymes and soothing Ayurvedic ginger root extract specifically engineered to maintain gastric pH balance. However, for maximum fat-soluble vitamin absorption (A, D3, K2), our Advisory Board recommends ingestion alongside your morning meal.
        </div>
      </details>
    </div>

    <!-- Footer Trust Guarantee -->
    <div class="doc__footer">
      [ CERTIFIED WADA COMPLIANT ] &bull; [ FSSAI CLINICAL ASSAY VERIFIED ] &bull; [ 100% GMP MANUFACTURED IN INDIA ]
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var tabs = section.querySelectorAll('.doc__tab');
    var cards = section.querySelectorAll('[data-doc-card]');

    var modalBox = section.querySelector('[data-modal-box]');
    var modalTitle = section.querySelector('[data-modal-title]');
    var modalText = section.querySelector('[data-modal-text]');
    var modalMeta = section.querySelector('[data-modal-meta]');
    var modalClose = section.querySelector('[data-modal-close]');

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('is-active'); });
        this.classList.add('is-active');
        var docId = this.getAttribute('data-doctor') || 'vance';

        cards.forEach(function(card) {
          var cardId = card.getAttribute('data-doc-id') || 'vance';
          if (cardId === docId) {
            card.classList.remove('is-hidden');
          } else {
            card.classList.add('is-hidden');
          }
        });
      });
    });

    var abstractBtns = section.querySelectorAll('[data-abstract-title]');
    abstractBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var title = btn.getAttribute('data-abstract-title');
        var text = btn.getAttribute('data-abstract-text');
        var meta = btn.getAttribute('data-abstract-meta');

        if (modalBox && modalTitle && modalText && modalMeta) {
          modalTitle.textContent = '[ CLINICAL TRIAL: ' + title.toUpperCase() + ' ]';
          modalText.textContent = text;
          modalMeta.textContent = '[ ' + meta + ' ]';
          modalBox.style.display = 'block';
          modalBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    });

    if (modalClose) {
      modalClose.addEventListener('click', function() {
        if (modalBox) modalBox.style.display = 'none';
      });
    }
  });
</script>

