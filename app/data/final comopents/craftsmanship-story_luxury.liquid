{%- comment -%}
  sections/craftsmanship-story_luxury.liquid
  
  CONVERSION PSYCHOLOGY & ARCHITECTURE:
  1. THE LABOR ILLUSION (NORTON ET AL.) -- Research proves that when consumers
     witness the intense effort, hours, and multi-stage manual skill required to
     create an object, their perceived value and willingness to pay surges by up
     to 40%. This section transforms price resistance into deep appreciation.
  2. NARRATIVE ANCHORING -- By structuring creation into 4 chronological stages
     (Sketch, Alloy, Setting, Hallmarking), we anchor our products in heritage
     and artistry rather than mere commodity metal weight.
  3. EDITORIAL ASYMMETRY -- Magazine-grade 2-column layout (Vogue / Architectural
     Digest feel) that breaks grid monotony and retains high scroll depth.
  4. ZERO EMOJI POLICY -- Strict editorial ASCII typography [ LIKE THIS ] for all
     step numbers and quotes.
{%- endcomment -%}

<style>
  .lx-craft {
    background: var(--craft-bg, #0a0a0a);
    color: var(--craft-color, #fff);
    padding: clamp(4rem, 8vw, 8rem) 1.5rem;
    font-family: var(--font-body, sans-serif);
    border-bottom: 1px solid rgba(201, 169, 110, 0.15);
  }

  .lx-craft__inner {
    max-width: var(--max-width, 1440px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }

  @media (max-width: 1024px) {
    .lx-craft__inner {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }

  /* Left Column: Visual Showcase & Quote */
  .lx-craft__visual {
    position: relative;
  }

  .lx-craft__img-wrapper {
    position: relative;
    aspect-ratio: 4 / 5;
    background: #141414;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .lx-craft__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%) contrast(105%);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), filter 0.8s ease;
  }

  .lx-craft__img-wrapper:hover .lx-craft__img {
    transform: scale(1.04);
    filter: grayscale(0%) contrast(110%);
  }

  .lx-craft__badge-overlay {
    position: absolute;
    top: 2rem;
    left: 2rem;
    background: rgba(8, 8, 8, 0.85);
    border: 1px solid rgba(201, 169, 110, 0.4);
    padding: 0.6rem 1.2rem;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9a96e;
    backdrop-filter: blur(8px);
  }

  .lx-craft__quote-box {
    margin-top: 2.5rem;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.02);
    border-left: 2px solid #c9a96e;
  }

  .lx-craft__quote-text {
    font-family: var(--font-heading, serif);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-style: italic;
    line-height: 1.6;
    margin: 0 0 1rem 0;
    color: #f0f0f0;
  }

  .lx-craft__quote-author {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #c9a96e;
  }

  /* Right Column: Numbered Timeline */
  .lx-craft__content {
    display: flex;
    flex-direction: column;
  }

  .lx-craft__subtitle {
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #c9a96e;
    margin-bottom: 0.75rem;
    display: block;
  }

  .lx-craft__title {
    font-family: var(--font-heading, serif);
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 400;
    margin: 0 0 1.5rem 0;
    line-height: 1.15;
  }

  .lx-craft__intro {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0 0 3.5rem 0;
  }

  .lx-craft__timeline {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    position: relative;
  }

  .lx-craft__timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: rgba(201, 169, 110, 0.2);
  }

  .lx-craft__step {
    position: relative;
    padding-left: 2.5rem;
  }

  .lx-craft__step::before {
    content: "";
    position: absolute;
    left: -4px;
    top: 6px;
    width: 9px;
    height: 9px;
    background: #0a0a0a;
    border: 2px solid #c9a96e;
  }

  .lx-craft__step-num {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9a96e;
    margin-bottom: 0.5rem;
    display: block;
    font-weight: 600;
  }

  .lx-craft__step-title {
    font-family: var(--font-heading, serif);
    font-size: 1.5rem;
    font-weight: 400;
    margin: 0 0 0.75rem 0;
    color: #fff;
  }

  .lx-craft__step-desc {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0;
  }

  .lx-craft__cta-wrapper {
    margin-top: 3.5rem;
  }

  .lx-craft__btn {
    display: inline-block;
    background: transparent;
    color: #c9a96e;
    border: 1px solid #c9a96e;
    padding: 1rem 2.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .lx-craft__btn:hover {
    background: #c9a96e;
    color: #080808;
  }
</style>

<section
  class="lx-craft"
  data-section-id="{{ section.id }}"
  data-section-type="craftsmanship-story">
  
  <div class="lx-craft__inner">
    {%- comment -%} Left Column: Atelier Image & Artisan Quote {%- endcomment -%}
    <div class="lx-craft__visual">
      <div class="lx-craft__img-wrapper">
        <span class="lx-craft__badge-overlay">{{ section.settings.badge | default: "[ 140+ HOURS OF HANDWORK ]" }}</span>
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url }}"
            alt="{{ section.settings.title | escape }}"
            class="lx-craft__img"
            loading="lazy">
        {%- else -%}
          <img
            src="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?q=80&w=1000&auto=format&fit=crop"
            alt="Atelier Goldsmithing"
            class="lx-craft__img"
            loading="lazy">
        {%- endif -%}
      </div>

      <div class="lx-craft__quote-box">
        <p class="lx-craft__quote-text">
          "{{ section.settings.quote | default: "In an era of relentless mass automation, true luxury remains a patient, intimate conversation between the master artisan's hand and the precious metal." }}"
        </p>
        <span class="lx-craft__quote-author">
          -- {{ section.settings.quote_author | default: "S. MUKHERJEE, MASTER GOLDSMITH" }}
        </span>
      </div>
    </div>

    {%- comment -%} Right Column: Labor Illusion Timeline {%- endcomment -%}
    <div class="lx-craft__content">
      <span class="lx-craft__subtitle">{{ section.settings.subtitle | default: "[ ATELIER HERITAGE ]" }}</span>
      <h2 class="lx-craft__title">{{ section.settings.title | default: "The Anatomy of an Heirloom" }}</h2>
      <p class="lx-craft__intro">
        {{ section.settings.intro | default: "We reject industrial shortcuts. Every creation originating from our ateliers undergoes a rigorous four-stage metamorphosis, combining centuries-old Indian goldsmithing heritage with modern micro-precision engineering." }}
      </p>

      <div class="lx-craft__timeline">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="lx-craft__step" {{ block.shopify_attributes }}>
              <span class="lx-craft__step-num">{{ block.settings.step_num | default: "[ STEP 01 ]" }}</span>
              <h3 class="lx-craft__step-title">{{ block.settings.title }}</h3>
              <p class="lx-craft__step-desc">{{ block.settings.description }}</p>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Default 4-Stage Labor Illusion Timeline {%- endcomment -%}
          <div class="lx-craft__step">
            <span class="lx-craft__step-num">[ STEP 01 ]</span>
            <h3 class="lx-craft__step-title">The Master Sketch & Wax Sculpting</h3>
            <p class="lx-craft__step-desc">Before touching metal, our designers spend up to two weeks hand-sketching architectural silhouettes and carving three-dimensional lost-wax models to achieve impeccable proportion and balance.</p>
          </div>

          <div class="lx-craft__step">
            <span class="lx-craft__step-num">[ STEP 02 ]</span>
            <h3 class="lx-craft__step-title">Bespoke Metallurgy & Alloying</h3>
            <p class="lx-craft__step-desc">We custom-distill our premium essences in small, sovereign batches using refined organic ingredients, ensuring our signature silk texture, gentle purity, and exceptional protective efficacy.</p>
          </div>

          <div class="lx-craft__step">
            <span class="lx-craft__step-num">[ STEP 03 ]</span>
            <h3 class="lx-craft__step-title">Bio-Active Compound Stabilization</h3>
            <p class="lx-craft__step-desc">Working under precision laboratory controls, master chemists hand-blend rare organic lipids and stabilize bio-active premium compounds to ensure maximum intensive penetration.</p>
          </div>

          <div class="lx-craft__step">
            <span class="lx-craft__step-num">[ STEP 04 ]</span>
            <h3 class="lx-craft__step-title">Micro-Emulsion & verified Assay</h3>
            <p class="lx-craft__step-desc">After undergoing three successive stages of micro-filtration and cold-emulsion processing, every completed batch is submitted for rigorous independent laboratory verification and safety certification.</p>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_cta -%}
        <div class="lx-craft__cta-wrapper">
          <a href="{{ section.settings.cta_link | default: '/pages/atelier' }}" class="lx-craft__btn">
            {{ section.settings.cta_text | default: "[ EXPLORE OUR ATELIERS ]" }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

