{%- comment -%}
  =============================================================================
  STOREFORGE BEAUTY NICHE KILLER: INTERACTIVE AM/PM ROUTINE BUILDER
  =============================================================================
  Psychological Conversion Framework:
  1. Habit Stacking & Basket Building: Skincare items are rarely used in isolation. By presenting a structured 3-step AM / PM protocol, customers see exactly how the product fits into their daily regimen and are motivated to buy the entire system.
  2. Protocol Clarity: Removing ambiguity about application order (Cleanse -> Treat -> Protect) builds immense product confidence.
  
  Design Aesthetics & Rules:
  - 0% Emoji Policy: Clean ASCII brackets, clinical typography, and time-of-day toggle [ AM PROTOCOL / PM PROTOCOL ].
  - Scoped CSS: Soft clinical neutrals.
  =============================================================================
{%- endcomment -%}

<div class="sf-bt-routine" data-beauty-routine>
  <style>
    .sf-bt-routine {
      margin: 1.5rem 0;
      border: 1px solid #e2ded6;
      background-color: #faf9f6;
      font-family: var(--font-body-family, sans-serif);
      color: #1a1a1a;
    }

    .sf-bt-rt__header {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid #e2ded6;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background-color: #ffffff;
    }

    .sf-bt-rt__title {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    .sf-bt-rt__toggle {
      display: flex;
      border: 1px solid #1a1a1a;
    }

    .sf-bt-rt__btn {
      padding: 0.35rem 0.75rem;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      background: transparent;
      border: none;
      cursor: pointer;
      text-transform: uppercase;
    }

    .sf-bt-rt__btn.is-active {
      background-color: #1a1a1a;
      color: #ffffff;
    }

    .sf-bt-rt__body {
      padding: 1.25rem;
    }

    .sf-bt-rt__step-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .sf-bt-rt__step {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      padding: 0.85rem;
      background-color: #ffffff;
      border: 1px solid #e2ded6;
    }

    .sf-bt-rt__num {
      width: 28px;
      height: 28px;
      background-color: #2e6b4d;
      color: #ffffff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: 700;
      flex-shrink: 0;
    }

    .sf-bt-rt__info {
      flex: 1;
    }

    .sf-bt-rt__step-title {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #1a1a1a;
      margin-bottom: 0.25rem;
    }

    .sf-bt-rt__step-desc {
      font-size: 0.72rem;
      color: #666666;
      line-height: 1.4;
    }

    .sf-bt-rt__footer {
      padding: 0.75rem 1.25rem;
      background-color: #e8f3ec;
      color: #2e6b4d;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-align: center;
      border-top: 1px solid #c8e0d0;
    }
  </style>

  <div class="sf-bt-rt__header">
    <span class="sf-bt-rt__title">[ RECOMMENDED CLINICAL PROTOCOL ]</span>
    <div class="sf-bt-rt__toggle" data-time-toggle>
      <button type="button" class="sf-bt-rt__btn is-active" data-val="am">AM ROUTINE</button>
      <button type="button" class="sf-bt-rt__btn" data-val="pm">PM ROUTINE</button>
    </div>
  </div>

  <div class="sf-bt-rt__body">
    <!-- AM PROTOCOL -->
    <div class="sf-bt-rt__step-list" data-list="am">
      <div class="sf-bt-rt__step">
        <div class="sf-bt-rt__num">1</div>
        <div class="sf-bt-rt__info">
          <div class="sf-bt-rt__step-title">CLEANSE : GENTLE HYDRATING GEL</div>
          <div class="sf-bt-rt__step-desc">Wash with lukewarm water to remove overnight sebum without stripping essential ceramides.</div>
        </div>
      </div>
      <div class="sf-bt-rt__step" style="border-color: #2e6b4d; background-color: #f4faf6;">
        <div class="sf-bt-rt__num" style="background-color: #1a1a1a;">2</div>
        <div class="sf-bt-rt__info">
          <div class="sf-bt-rt__step-title" style="color: #2e6b4d;">[ THIS PRODUCT ] APPLY 3-4 DROPS TO CLEAN SKIN</div>
          <div class="sf-bt-rt__step-desc">Gently press into face and neck until fully absorbed. Wait 60 seconds before moisturizing.</div>
        </div>
      </div>
      <div class="sf-bt-rt__step">
        <div class="sf-bt-rt__num">3</div>
        <div class="sf-bt-rt__info">
          <div class="sf-bt-rt__step-title">PROTECT : BROAD SPECTRUM MINERAL SPF 50</div>
          <div class="sf-bt-rt__step-desc">Crucial step to shield delicate active ingredients from UV degradation and photo-aging.</div>
        </div>
      </div>
    </div>

    <!-- PM PROTOCOL -->
    <div class="sf-bt-rt__step-list" data-list="pm" style="display: none;">
      <div class="sf-bt-rt__step">
        <div class="sf-bt-rt__num">1</div>
        <div class="sf-bt-rt__info">
          <div class="sf-bt-rt__step-title">DOUBLE CLEANSE : OIL + WATER CLEANSER</div>
          <div class="sf-bt-rt__step-desc">Dissolve makeup, SPF, and urban pollutants completely before treatment application.</div>
        </div>
      </div>
      <div class="sf-bt-rt__step" style="border-color: #2e6b4d; background-color: #f4faf6;">
        <div class="sf-bt-rt__num" style="background-color: #1a1a1a;">2</div>
        <div class="sf-bt-rt__info">
          <div class="sf-bt-rt__step-title" style="color: #2e6b4d;">[ THIS PRODUCT ] REGENERATIVE NIGHT APPLICATION</div>
          <div class="sf-bt-rt__step-desc">Apply generously across face and décolletage to maximize nocturnal cellular repair.</div>
        </div>
      </div>
      <div class="sf-bt-rt__step">
        <div class="sf-bt-rt__num">3</div>
        <div class="sf-bt-rt__info">
          <div class="sf-bt-rt__step-title">SEAL : BARRIER REPAIR CERAMIDE CREAM</div>
          <div class="sf-bt-rt__step-desc">Lock in moisture and active peptides overnight for plump, restored morning radiance.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="sf-bt-rt__footer">
    // FOR OPTIMAL RESULTS, CONSISTENT 28-DAY CELLULAR TURNOVER CYCLE IS REQUIRED //
  </div>

  <script>
    (function() {
      const container = document.querySelector('[data-beauty-routine]');
      if (!container) return;

      const btns = container.querySelectorAll('[data-time-toggle] .sf-bt-rt__btn');
      const listAm = container.querySelector('[data-list="am"]');
      const listPm = container.querySelector('[data-list="pm"]');

      btns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          btns.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          const val = btn.getAttribute('data-val');
          if (val === 'am') {
            if (listAm) listAm.style.display = 'flex';
            if (listPm) listPm.style.display = 'none';
          } else {
            if (listAm) listAm.style.display = 'none';
            if (listPm) listPm.style.display = 'flex';
          }
        });
      });
    })();
  </script>
</div>
