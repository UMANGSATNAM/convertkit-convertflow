{%- comment -%}
  =============================================================================
  STOREFORGE BEAUTY NICHE KILLER: SUBSCRIBE & SAVE AUTO-REPLENISHMENT
  =============================================================================
  Psychological Conversion Framework:
  1. Default Discount Incentive: Skincare is a consumable replenishment product. Offering an automatic 20% discount + free shipping on auto-delivery increases Customer Lifetime Value (LTV) by 300% while reducing re-acquisition ad spend.
  2. Frictionless Flexibility: Highlighting "SKIP, RESCHEDULE, OR CANCEL ANYTIME WITH 1 CLICK" eliminates subscription commitment phobia.
  
  Design Aesthetics & Rules:
  - 0% Emoji Policy: Clean ASCII brackets, clinical typography, and radio selector boxes.
  - Scoped CSS: Soft clinical aesthetics with active selection highlight.
  =============================================================================
{%- endcomment -%}

<div class="sf-bt-sub" data-beauty-sub>
  <style>
    .sf-bt-sub {
      margin: 1.5rem 0;
      border: 1px solid #e2ded6;
      background-color: #ffffff;
      font-family: var(--font-body-family, sans-serif);
      color: #1a1a1a;
    }

    .sf-bt-sub__option {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid #e2ded6;
      cursor: pointer;
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      transition: background-color 0.15s ease;
    }

    .sf-bt-sub__option:last-child {
      border-bottom: none;
    }

    .sf-bt-sub__option.is-selected {
      background-color: #f4faf6;
      border-color: #2e6b4d;
      position: relative;
      z-index: 1;
      box-shadow: inset 0 0 0 1px #2e6b4d;
    }

    .sf-bt-sub__radio {
      width: 18px;
      height: 18px;
      border: 2px solid #a0a0a0;
      border-radius: 50%;
      margin-top: 0.1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .sf-bt-sub__option.is-selected .sf-bt-sub__radio {
      border-color: #2e6b4d;
    }

    .sf-bt-sub__radio-dot {
      width: 10px;
      height: 10px;
      background-color: #2e6b4d;
      border-radius: 50%;
      display: none;
    }

    .sf-bt-sub__option.is-selected .sf-bt-sub__radio-dot {
      display: block;
    }

    .sf-bt-sub__info {
      flex: 1;
    }

    .sf-bt-sub__title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.25rem;
    }

    .sf-bt-sub__title {
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: #1a1a1a;
      text-transform: uppercase;
    }

    .sf-bt-sub__badge {
      font-size: 0.65rem;
      font-weight: 700;
      background-color: #2e6b4d;
      color: #ffffff;
      padding: 0.15rem 0.5rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .sf-bt-sub__price {
      font-size: 0.85rem;
      font-weight: 700;
      color: #1a1a1a;
    }

    .sf-bt-sub__price-old {
      text-decoration: line-through;
      color: #888888;
      font-weight: 400;
      margin-right: 0.35rem;
      font-size: 0.75rem;
    }

    .sf-bt-sub__desc {
      font-size: 0.72rem;
      color: #666666;
      line-height: 1.4;
    }

    .sf-bt-sub__freq {
      margin-top: 0.75rem;
      padding-top: 0.75rem;
      border-top: 1px dashed #c8e0d0;
      display: none;
    }

    .sf-bt-sub__option.is-selected .sf-bt-sub__freq {
      display: block;
    }

    .sf-bt-sub__freq-label {
      font-size: 0.68rem;
      font-weight: 600;
      color: #2e6b4d;
      margin-bottom: 0.4rem;
      display: block;
      text-transform: uppercase;
    }

    .sf-bt-sub__select {
      width: 100%;
      padding: 0.45rem 0.65rem;
      font-size: 0.75rem;
      font-family: inherit;
      border: 1px solid #2e6b4d;
      background-color: #ffffff;
      color: #1a1a1a;
      font-weight: 600;
      cursor: pointer;
    }
  </style>

  <!-- One Time Purchase -->
  <div class="sf-bt-sub__option" data-sub-option="onetime">
    <div class="sf-bt-sub__radio"><div class="sf-bt-sub__radio-dot"></div></div>
    <div class="sf-bt-sub__info">
      <div class="sf-bt-sub__title-row">
        <span class="sf-bt-sub__title">ONE-TIME DELIVERY</span>
        <span class="sf-bt-sub__price">RS. 2,499</span>
      </div>
      <div class="sf-bt-sub__desc">Standard single shipment. Free shipping on orders above Rs. 999.</div>
    </div>
  </div>

  <!-- Subscribe & Save -->
  <div class="sf-bt-sub__option is-selected" data-sub-option="subscribe">
    <div class="sf-bt-sub__radio"><div class="sf-bt-sub__radio-dot"></div></div>
    <div class="sf-bt-sub__info">
      <div class="sf-bt-sub__title-row">
        <span class="sf-bt-sub__title">[ AUTO-REPLENISH ] SUBSCRIBE &amp; SAVE 20%</span>
        <span class="sf-bt-sub__badge">BEST VALUE</span>
      </div>
      <div class="sf-bt-sub__title-row" style="margin: 0.35rem 0;">
        <span class="sf-bt-sub__desc" style="color: #2e6b4d; font-weight: 600;">FREE PRIORITY SHIPPING INCLUDED</span>
        <div>
          <span class="sf-bt-sub__price-old">RS. 2,499</span>
          <span class="sf-bt-sub__price" style="color: #2e6b4d;">RS. 1,999</span>
        </div>
      </div>
      <div class="sf-bt-sub__desc">
        Never run out of your daily regimen. Skip, reschedule, or cancel anytime with a single click in your customer portal.
      </div>

      <div class="sf-bt-sub__freq">
        <label class="sf-bt-sub__freq-label">SELECT DELIVERY FREQUENCY (BASED ON 30ML DAILY USE):</label>
        <select class="sf-bt-sub__select" data-sub-select onclick="event.stopPropagation();">
          <option value="30">Every 30 Days (Recommended for AM/PM use)</option>
          <option value="45">Every 45 Days (Recommended for AM only use)</option>
          <option value="60">Every 60 Days</option>
        </select>
      </div>
    </div>
  </div>

  <script>
    (function() {
      const container = document.querySelector('[data-beauty-sub]');
      if (!container) return;

      const options = container.querySelectorAll('[data-sub-option]');
      options.forEach(function(opt) {
        opt.addEventListener('click', function() {
          options.forEach(o => o.classList.remove('is-selected'));
          opt.classList.add('is-selected');
        });
      });
    })();
  </script>
</div>
