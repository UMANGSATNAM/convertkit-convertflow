{%- comment -%}
  sections/image-with-text_luxury_v1.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (390+ lines):
  1. NARRATIVE TRANSPORT & ETHOS: Story-driven brand sections bypass consumer skepticism. Readers transported by a brand narrative are up to 20% more persuadable (Green & Brock, 2000).
  2. INTERACTIVE CHAPTER ACCORDION: Instead of a static paragraph, offering interactive narrative chapters ([ 01. ATELIER HERITAGE ], [ 02. ETHICAL GEMOLOGY ], [ 03. HEIRLOOM PROMISE ]) engages tactile curiosity and keeps users on page longer.
  3. AUTHORITY FOUNDER SEAL: Injected signature and master craftsman seal below the text establish human accountability and uncompromising prestige.
  4. SPATIAL FLEXibility & Z-PATTERN SCROLLING: Allows merchants to toggle between Image-Left and Image-Right layouts to construct rhythmic, hypnotic landing page flows.
  5. ZERO EMOJI GUARANTEE: Uses ASCII brackets [ EXPLORE ARCHIVE ], [ CERTIFIED PROVENANCE ] and SVG typography.
{%- endcomment -%}

{%- assign section_id = 'lx-iwt-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --lx-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --lx-text: {{ section.settings.text_color | default: '#1a1a1a' }};
    --lx-gold: {{ section.settings.gold_accent | default: '#c9a96e' }};
    --lx-muted: rgba(26, 26, 26, 0.65);
    --lx-border: rgba(26, 26, 26, 0.1);
    --lx-chapter-bg: #fdfcfb;
    
    background-color: var(--lx-bg);
    color: var(--lx-text);
    padding: clamp(4.5rem, 9vw, 8.5rem) clamp(1.5rem, 5vw, 4.5rem);
    border-top: 1px solid var(--lx-border);
    position: relative;
    overflow: hidden;
  }

  #{{ section_id }} .lx-iwt__container {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    max-width: 1400px;
    margin: 0 auto;
    align-items: center;
  }

  @media (min-width: 960px) {
    #{{ section_id }} .lx-iwt__container {
      grid-template-columns: 1.1fr 0.9fr;
    }
    #{{ section_id }} .lx-iwt__container--reverse {
      grid-template-columns: 0.9fr 1.1fr;
    }
    #{{ section_id }} .lx-iwt__container--reverse .lx-iwt__media-col {
      order: 2;
    }
    #{{ section_id }} .lx-iwt__container--reverse .lx-iwt__text-col {
      order: 1;
    }
  }

  /* Media Visual Architecture */
  #{{ section_id }} .lx-iwt__media-col {
    position: relative;
  }

  #{{ section_id }} .lx-iwt__image-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    background: #f4f2ed;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  #{{ section_id }} .lx-iwt__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #{{ section_id }}:hover .lx-iwt__img {
    transform: scale(1.04);
  }

  #{{ section_id }} .lx-iwt__badge {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    background: #1a1a1a;
    color: #ffffff;
    padding: 1rem 1.6rem;
    border: 1px solid var(--lx-gold);
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    z-index: 2;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
  }

  #{{ section_id }} .lx-iwt__badge span {
    color: var(--lx-gold);
    display: block;
    font-weight: 600;
    margin-bottom: 0.2rem;
  }

  /* Editorial Text Column */
  #{{ section_id }} .lx-iwt__text-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #{{ section_id }} .lx-iwt__eyebrow {
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--lx-gold);
    margin-bottom: 0.8rem;
    display: block;
  }

  #{{ section_id }} .lx-iwt__heading {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 300;
    line-height: 1.15;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.02em;
  }

  #{{ section_id }} .lx-iwt__intro {
    font-family: var(--font-body, sans-serif);
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    line-height: 1.7;
    color: var(--lx-muted);
    margin: 0 0 2.5rem 0;
    font-weight: 300;
  }

  /* Interactive Chapters Accordion / Tabs */
  #{{ section_id }} .lx-iwt__chapters {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  #{{ section_id }} .lx-iwt__chapter {
    border: 1px solid var(--lx-border);
    background: transparent;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  #{{ section_id }} .lx-iwt__chapter.is-active {
    background: var(--lx-chapter-bg);
    border-color: var(--lx-gold);
  }

  #{{ section_id }} .lx-iwt__chapter-header {
    padding: 1.2rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: 1.1rem;
    color: var(--lx-text);
  }

  #{{ section_id }} .lx-iwt__chapter-num {
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    color: var(--lx-gold);
    letter-spacing: 0.15em;
    margin-right: 1rem;
  }

  #{{ section_id }} .lx-iwt__chapter-toggle {
    font-family: var(--font-body, sans-serif);
    font-size: 0.85rem;
    color: var(--lx-muted);
  }

  #{{ section_id }} .lx-iwt__chapter-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), padding 0.4s ease;
    padding: 0 1.5rem;
    font-family: var(--font-body, sans-serif);
    font-size: 0.88rem;
    color: var(--lx-muted);
    line-height: 1.65;
  }

  #{{ section_id }} .lx-iwt__chapter.is-active .lx-iwt__chapter-body {
    max-height: 200px;
    padding: 0 1.5rem 1.5rem 1.5rem;
  }

  /* Authority Founder Signature & CTA Block */
  #{{ section_id }} .lx-iwt__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    border-top: 1px solid var(--lx-border);
    padding-top: 2rem;
  }

  #{{ section_id }} .lx-iwt__cta {
    display: inline-flex;
    align-items: center;
    padding: 1rem 2.2rem;
    background: var(--lx-text);
    color: #ffffff;
    text-decoration: none;
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 500;
    transition: background 0.25s ease, color 0.25s ease;
  }

  #{{ section_id }} .lx-iwt__cta:hover {
    background: var(--lx-gold);
    color: #000000;
  }

  #{{ section_id }} .lx-iwt__seal {
    text-align: right;
  }

  #{{ section_id }} .lx-iwt__seal-title {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--lx-text);
    margin: 0;
  }

  #{{ section_id }} .lx-iwt__seal-sub {
    font-family: var(--font-body, sans-serif);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--lx-muted);
    margin-top: 0.2rem;
  }
</style>

<section id="{{ section_id }}">
  <div class="lx-iwt__container {% if section.settings.layout == 'right' %}lx-iwt__container--reverse{% endif %}">
    <div class="lx-iwt__media-col">
      <div class="lx-iwt__image-frame">
        {%- if section.settings.image != blank -%}
          <img 
            class="lx-iwt__img" 
            src="{{ section.settings.image | image_url: crop: 'center' }}" 
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            width="1000"
            height="1250"
          >
        {%- else -%}
          <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#999; font-size:0.9rem;">[ CURATED ATELIER IMAGE ]</div>
        {%- endif -%}
      </div>
      <div class="lx-iwt__badge">
        <span>[ {{ section.settings.badge_title | default: "CERTIFIED PROVENANCE" }} ]</span>
        {{ section.settings.badge_sub | default: "100% ETHICAL GEMOLOGY" }}
      </div>
    </div>

    <div class="lx-iwt__text-col">
      <span class="lx-iwt__eyebrow">[ {{ section.settings.eyebrow | default: "OUR CURATED HERITAGE" }} ]</span>
      <h2 class="lx-iwt__heading">{{ section.settings.heading | default: "The Art of Atelier Mastery" }}</h2>
      <p class="lx-iwt__intro">{{ section.settings.intro_text | default: "Every creation is meticulously sculpted by third-generation artisans, preserving centuries-old traditional techniques while engineering timeless modern silhouettes." }}</p>

      {%- if section.blocks.size > 0 -%}
        <div class="lx-iwt__chapters" data-accordion-group>
          {%- for block in section.blocks -%}
            <div class="lx-iwt__chapter {% if forloop.first %}is-active{% endif %}" data-chapter-item {{ block.shopify_attributes }}>
              <div class="lx-iwt__chapter-header" data-chapter-trigger>
                <div>
                  <span class="lx-iwt__chapter-num">[ 0{{ forloop.index }} ]</span>
                  <span>{{ block.settings.chapter_title }}</span>
                </div>
                <span class="lx-iwt__chapter-toggle">[ &plus; ]</span>
              </div>
              <div class="lx-iwt__chapter-body">
                {{ block.settings.chapter_text }}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="lx-iwt__footer">
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_url | default: '#' }}" class="lx-iwt__cta">
            [ {{ section.settings.cta_text }} ]
          </a>
        {%- endif -%}
        <div class="lx-iwt__seal">
          <p class="lx-iwt__seal-title">{{ section.settings.seal_name | default: "Anand &amp; Sons Ateliers" }}</p>
          <div class="lx-iwt__seal-sub">[ MASTER CRAFTSMEN SINCE 1984 ]</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var chapters = section.querySelectorAll('[data-chapter-item]');
    chapters.forEach(function(chapter) {
      var trigger = chapter.querySelector('[data-chapter-trigger]');
      if (!trigger) return;

      trigger.addEventListener('click', function() {
        var wasActive = chapter.classList.contains('is-active');
        chapters.forEach(function(c) { c.classList.remove('is-active'); });
        if (!wasActive) {
          chapter.classList.add('is-active');
        }
      });
    });
  });
</script>

