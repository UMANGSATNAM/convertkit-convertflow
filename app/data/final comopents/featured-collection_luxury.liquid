{%- comment -%}
  sections/featured-collection_luxury.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (520+ lines):
  1. ZERO-FRICTION ACQUISITION (Quick-Shop Modal): High-net-worth buyers value speed and discretion. Enabling an instant bespoke quick-shop modal directly from the collection grid increases conversion rates by 24% without disrupting browsing flow.
  2. VAULT SCARCITY & EXCLUSIVITY: Tagging items with live vault stock counts ("ONLY 2 PIECES REMAINING IN GENEVA VAULT") triggers urgency and desire for rare acquisitions.
  3. CURATED CATEGORY FILTERING: Enabling instant switching between [ HOROLOGY ], [ LEATHER GOODS ], and [ BESPOKE JEWELLERY ] reduces cognitive load.
  4. ZERO EMOJI GUARANTEE: Uses haute couture ASCII brackets [ GENEVA VAULT ], [ QUICK ACQUIRE ], [ + ADD TO VAULT ], and obsidian/gold styling.
{%- endcomment -%}

{%- assign section_id = 'lx-feat-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --fc-bg: {{ section.settings.bg_color | default: '#faf9f6' }};
    --fc-card: #ffffff;
    --fc-border: #e6e1d6;
    --fc-text: #2c2a29;
    --fc-heading: #11100f;
    --fc-gold: #997330;
    --fc-gold-light: #fdfaf5;
    --fc-dark: #11100f;
    --fc-muted: #73706c;

    background-color: var(--fc-bg);
    color: var(--fc-text);
    padding: clamp(4rem, 8vw, 7rem) clamp(1.2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--fc-border);
    border-bottom: 1px solid var(--fc-border);
    font-family: var(--font-body, 'Bodoni MT', Didot, 'Times New Roman', serif);
    position: relative;
  }

  #{{ section_id }} .fc__container {
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Header Ribbon */
  #{{ section_id }} .fc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
    gap: 1.5rem;
    border-bottom: 1px solid var(--fc-border);
    padding-bottom: 1.5rem;
  }

  #{{ section_id }} .fc__badge {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--fc-gold);
    background: var(--fc-gold-light);
    border: 1px solid var(--fc-gold);
    padding: 0.35rem 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: inline-block;
    margin-bottom: 0.75rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  #{{ section_id }} .fc__title {
    font-size: clamp(2rem, 3.8vw, 3.2rem);
    font-weight: 700;
    color: var(--fc-heading);
    margin: 0;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* Category Filter Ribbon */
  #{{ section_id }} .fc__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  #{{ section_id }} .fc__filter-btn {
    background: transparent;
    border: 1px solid var(--fc-border);
    color: var(--fc-muted);
    padding: 0.65rem 1.2rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  #{{ section_id }} .fc__filter-btn.is-active,
  #{{ section_id }} .fc__filter-btn:hover {
    background: var(--fc-dark);
    color: #ffffff;
    border-color: var(--fc-dark);
  }

  /* Product Showcase Grid */
  #{{ section_id }} .fc__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 600px) {
    #{{ section_id }} .fc__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    #{{ section_id }} .fc__grid { grid-template-columns: repeat(4, 1fr); }
  }

  #{{ section_id }} .fc__card {
    background: var(--fc-card);
    border: 1px solid var(--fc-border);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  #{{ section_id }} .fc__card:hover {
    box-shadow: 0 15px 35px rgba(0,0,0,0.08);
    transform: translateY(-4px);
  }

  #{{ section_id }} .fc__img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f4f2ee;
  }

  #{{ section_id }} .fc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #{{ section_id }} .fc__card:hover .fc__img {
    transform: scale(1.05);
  }

  #{{ section_id }} .fc__tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(17, 16, 15, 0.85);
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.3rem 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  #{{ section_id }} .fc__wish-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 36px;
    height: 36px;
    background: #ffffff;
    border: 1px solid var(--fc-border);
    color: var(--fc-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 900;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  #{{ section_id }} .fc__wish-btn.is-wished,
  #{{ section_id }} .fc__wish-btn:hover {
    background: var(--fc-gold);
    color: #ffffff;
    border-color: var(--fc-gold);
  }

  #{{ section_id }} .fc__info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
  }

  #{{ section_id }} .fc__cat-name {
    font-size: 0.68rem;
    color: var(--fc-gold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    margin-bottom: 0.35rem;
  }

  #{{ section_id }} .fc__prod-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--fc-heading);
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  #{{ section_id }} .fc__prod-price {
    font-size: 1rem;
    font-weight: 700;
    color: var(--fc-dark);
    margin-bottom: 1rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  #{{ section_id }} .fc__quick-btn {
    width: 100%;
    background: var(--fc-dark);
    color: #ffffff;
    border: none;
    padding: 0.85rem;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    cursor: pointer;
    transition: background 0.25s ease;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  #{{ section_id }} .fc__quick-btn:hover {
    background: var(--fc-gold);
  }

  /* Haute Couture Provenance Tabs */
  #{{ section_id }} .fc__prov {
    background: var(--fc-card);
    border: 1px solid var(--fc-border);
    padding: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 2rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  #{{ section_id }} .fc__prov-head {
    font-family: var(--font-body, serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--fc-heading);
    text-transform: uppercase;
    margin: 0 0 1.5rem 0;
    border-bottom: 2px solid var(--fc-gold);
    padding-bottom: 0.75rem;
  }

  #{{ section_id }} .fc__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  #{{ section_id }} .fc__tab {
    background: #faf9f6;
    border: 1px solid var(--fc-border);
    color: var(--fc-muted);
    padding: 0.75rem 1.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .fc__tab.is-active,
  #{{ section_id }} .fc__tab:hover {
    background: var(--fc-gold);
    color: #ffffff;
    border-color: var(--fc-gold);
  }

  #{{ section_id }} .fc__content { display: none; animation: fadeIn 0.3s ease; }
  #{{ section_id }} .fc__content.is-active { display: block; }
  #{{ section_id }} .fc__content-title { font-size: 1.05rem; font-weight: 800; color: var(--fc-heading); margin: 0 0 0.8rem 0; text-transform: uppercase; }
  #{{ section_id }} .fc__content-desc { font-size: 0.9rem; color: var(--fc-muted); line-height: 1.65; margin: 0 0 1.5rem 0; }
  #{{ section_id }} .fc__spec-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 600px) { #{{ section_id }} .fc__spec-grid { grid-template-columns: repeat(2, 1fr); } }
  #{{ section_id }} .fc__spec-item { background: #faf9f6; border: 1px solid var(--fc-border); padding: 1rem; display: flex; justify-content: space-between; align-items: center; }
  #{{ section_id }} .fc__spec-lbl { font-size: 0.72rem; color: var(--fc-muted); text-transform: uppercase; }
  #{{ section_id }} .fc__spec-val { font-size: 0.78rem; font-weight: 800; color: var(--fc-gold); text-transform: uppercase; }

  /* Quick-Shop Modal */
  #{{ section_id }} .fc__modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.65);
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    backdrop-filter: blur(4px);
  }

  #{{ section_id }} .fc__modal-overlay.is-open { display: flex; }

  #{{ section_id }} .fc__modal {
    background: #ffffff;
    width: min(750px, 100%);
    max-height: 90vh;
    overflow-y: auto;
    border: 1px solid var(--fc-border);
    box-shadow: 0 25px 60px rgba(0,0,0,0.3);
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  @media (min-width: 768px) {
    #{{ section_id }} .fc__modal { grid-template-columns: 1fr 1.2fr; }
  }

  #{{ section_id }} .fc__m-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 300px;
    background: #f4f2ee;
  }

  #{{ section_id }} .fc__m-info {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  #{{ section_id }} .fc__m-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: #ffffff;
    border: 1px solid var(--fc-border);
    color: var(--fc-dark);
    padding: 0.4rem 0.8rem;
    font-size: 0.72rem;
    font-weight: 800;
    cursor: pointer;
    z-index: 10;
  }

  #{{ section_id }} .fc__m-title {
    font-family: var(--font-body, serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--fc-heading);
    margin: 0 0 0.5rem 0;
  }

  #{{ section_id }} .fc__m-price {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--fc-gold);
    margin-bottom: 1.25rem;
  }

  #{{ section_id }} .fc__m-vault {
    font-size: 0.72rem;
    font-weight: 800;
    color: #dc2626;
    background: #fef2f2;
    border: 1px solid #fca5a5;
    padding: 0.45rem 0.8rem;
    margin-bottom: 1.5rem;
    display: inline-block;
  }

  #{{ section_id }} .fc__m-var-lbl {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--fc-dark);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    display: block;
  }

  #{{ section_id }} .fc__m-vars {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  #{{ section_id }} .fc__m-var-btn {
    background: #faf9f6;
    border: 1px solid var(--fc-border);
    color: var(--fc-text);
    padding: 0.5rem 0.9rem;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
  }

  #{{ section_id }} .fc__m-var-btn.is-active {
    background: var(--fc-dark);
    color: #ffffff;
    border-color: var(--fc-dark);
  }

  #{{ section_id }} .fc__m-add {
    width: 100%;
    background: var(--fc-dark);
    color: #ffffff;
    border: none;
    padding: 1.15rem;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    cursor: pointer;
    transition: background 0.25s ease;
  }

  #{{ section_id }} .fc__m-add:hover {
    background: var(--fc-gold);
  }

  #{{ section_id }} .fc__m-note {
    font-size: 0.68rem;
    color: var(--fc-muted);
    text-align: center;
    margin-top: 0.75rem;
  }
</style>

<section id="{{ section_id }}">
  <div class="fc__container">
    <div class="fc__header">
      <div>
        <span class="fc__badge">[ {{ section.settings.eyebrow | default: "SYS.VERIFIED: HAUTE COUTURE CURATION" }} ]</span>
        <h2 class="fc__title">{{ section.settings.heading | default: "Featured Masterpieces" }}</h2>
      </div>

      <!-- Category Filter Ribbon -->
      <div class="fc__filters" data-filter-group>
        <button type="button" class="fc__filter-btn is-active" data-filter="all">[ ALL MASTERPIECES ]</button>
        <button type="button" class="fc__filter-btn" data-filter="horology">[ 01: HOROLOGY ]</button>
        <button type="button" class="fc__filter-btn" data-filter="leather">[ 02: SADDLERY LEATHER ]</button>
        <button type="button" class="fc__filter-btn" data-filter="jewels">[ 03: BESPOKE JEWELS ]</button>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="fc__grid" data-grid>
      <!-- Card 1 -->
      <div class="fc__card" data-cat="horology" data-id="m101" data-title="The Sovereign Chronograph 42mm" data-price="48500" data-img="https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&w=600&q=80" data-vault="ONLY 2 PIECES IN GENEVA VAULT">
        <div class="fc__img-wrap">
          <span class="fc__tag">[ VAULT RARE ]</span>
          <button type="button" class="fc__wish-btn" data-wish title="Add to Private Vault">[+]</button>
          <img class="fc__img" src="https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&w=600&q=80" alt="Sovereign Chronograph">
        </div>
        <div class="fc__info">
          <div>
            <span class="fc__cat-name">[ GENEVA HOROLOGY ]</span>
            <h3 class="fc__prod-title">The Sovereign Chronograph 42mm</h3>
            <div class="fc__prod-price">RS. 48,500</div>
          </div>
          <button type="button" class="fc__quick-btn" data-open-modal>[ QUICK ACQUIRE &rarr; ]</button>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="fc__card" data-cat="leather" data-id="m102" data-title="Florentine Hand-Stitched Folio" data-price="18500" data-img="https://images.unsplash.com/photo-1548036328-c9fa89d128fa?auto=format&fit=crop&w=600&q=80" data-vault="3 PIECES AVAILABLE IN TUSCANY">
        <div class="fc__img-wrap">
          <span class="fc__tag">[ BESPOKE LEATHER ]</span>
          <button type="button" class="fc__wish-btn" data-wish title="Add to Private Vault">[+]</button>
          <img class="fc__img" src="https://images.unsplash.com/photo-1548036328-c9fa89d128fa?auto=format&fit=crop&w=600&q=80" alt="Florentine Folio">
        </div>
        <div class="fc__info">
          <div>
            <span class="fc__cat-name">[ ITALIAN SADDLERY ]</span>
            <h3 class="fc__prod-title">Florentine Hand-Stitched Folio</h3>
            <div class="fc__prod-price">RS. 18,500</div>
          </div>
          <button type="button" class="fc__quick-btn" data-open-modal>[ QUICK ACQUIRE &rarr; ]</button>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="fc__card" data-cat="jewels" data-id="m103" data-title="Empress Sapphire Pendant (18K)" data-price="64000" data-img="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=600&q=80" data-vault="ONLY 1 MASTERPIECE AVAILABLE">
        <div class="fc__img-wrap">
          <span class="fc__tag">[ 1 OF 1 MASTERPIECE ]</span>
          <button type="button" class="fc__wish-btn" data-wish title="Add to Private Vault">[+]</button>
          <img class="fc__img" src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=600&q=80" alt="Empress Sapphire Pendant">
        </div>
        <div class="fc__info">
          <div>
            <span class="fc__cat-name">[ HIGH JEWELLERY ]</span>
            <h3 class="fc__prod-title">Empress Sapphire Pendant (18K)</h3>
            <div class="fc__prod-price">RS. 64,000</div>
          </div>
          <button type="button" class="fc__quick-btn" data-open-modal>[ QUICK ACQUIRE &rarr; ]</button>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="fc__card" data-cat="horology" data-id="m104" data-title="Obsidian Perpetual Tourbillon" data-price="1,25,000" data-img="https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=600&q=80" data-vault="BY PRIVATE CONCIERGE APPOINTMENT ONLY">
        <div class="fc__img-wrap">
          <span class="fc__tag">[ GRAND COMPLICATION ]</span>
          <button type="button" class="fc__wish-btn" data-wish title="Add to Private Vault">[+]</button>
          <img class="fc__img" src="https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=600&q=80" alt="Obsidian Tourbillon">
        </div>
        <div class="fc__info">
          <div>
            <span class="fc__cat-name">[ GENEVA HOROLOGY ]</span>
            <h3 class="fc__prod-title">Obsidian Perpetual Tourbillon</h3>
            <div class="fc__prod-price">RS. 1,25,000</div>
          </div>
