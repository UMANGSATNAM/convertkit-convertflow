{%- comment -%}
  sections/tech-specs_electronics.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (400+ lines):
  1. DEEP TECHNICAL TRANSPARENCY (Analytical Conviction): Audiophiles, developers, and tech enthusiasts demand micro-architectural specifications (DAC chipsets, frequency response graphs, impedance, battery chemistry). Presenting a comprehensive, searchable specification table eliminates analytical hesitation and justifies premium pricing.
  2. CATEGORY INTENT SEGREGATION: Structuring specs by subsystem ([ ALL ], [ ACOUSTICS ], [ CONNECTIVITY ], [ POWER ], [ BUILD ]) prevents cognitive overload while allowing domain specialists to immediately inspect their critical metrics.
  3. REAL-TIME TECHNICAL FILTERING: An embedded terminal search input allows users to instantly query exact terms ("LDAC", "battery", "384kHz"), delivering immediate gratification to high-intent buyers.
  4. INTERACTIVE DOSSIER EXPORT: A button allowing users to copy the entire technical specification dossier to their clipboard ([ COPY DOSSIER TO CLIPBOARD ]) facilitates peer consultation and engineering validation.
  5. ZERO EMOJI GUARANTEE: Uses cyber-precision ASCII brackets [ ARCHITECTURAL SPECS ], [ COPY DOSSIER ], and monospace terminal aesthetics.
{%- endcomment -%}

{%- assign section_id = 'el-specs-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --ts-bg: {{ section.settings.bg_color | default: '#090c10' }};
    --ts-card: #161b22;
    --ts-border: #30363d;
    --ts-text: #c9d1d9;
    --ts-heading: #ffffff;
    --ts-green: #3fb950;
    --ts-blue: #58a6ff;
    --ts-muted: #8b949e;

    background-color: var(--ts-bg);
    color: var(--ts-text);
    padding: clamp(4rem, 8vw, 7rem) clamp(1.2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--ts-border);
    border-bottom: 1px solid var(--ts-border);
    font-family: var(--font-body, 'Courier New', monospace);
    position: relative;
  }

  #{{ section_id }} .ts__container {
    max-width: 1300px;
    margin: 0 auto;
  }

  /* Header Architecture */
  #{{ section_id }} .ts__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 2px solid var(--ts-border);
    padding-bottom: 1.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  #{{ section_id }} .ts__badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ts-blue);
    background: rgba(88, 166, 255, 0.1);
    border: 1px solid rgba(88, 166, 255, 0.4);
    padding: 0.35rem 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  #{{ section_id }} .ts__title {
    font-size: clamp(1.6rem, 3.2vw, 2.6rem);
    font-weight: 800;
    color: var(--ts-heading);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  #{{ section_id }} .ts__meta {
    text-align: right;
    font-size: 0.75rem;
    color: var(--ts-muted);
    line-height: 1.6;
  }

  #{{ section_id }} .ts__meta strong {
    color: var(--ts-green);
  }

  /* Interactive Search & Filter Toolbar */
  #{{ section_id }} .ts__toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    background: var(--ts-card);
    border: 1px solid var(--ts-border);
    padding: 1rem 1.2rem;
  }

  #{{ section_id }} .ts__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  #{{ section_id }} .ts__tab {
    background: transparent;
    border: 1px solid var(--ts-border);
    color: var(--ts-muted);
    padding: 0.5rem 1rem;
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .ts__tab.is-active,
  #{{ section_id }} .ts__tab:hover {
    background: var(--ts-blue);
    color: #000000;
    border-color: var(--ts-blue);
  }

  #{{ section_id }} .ts__search-wrap {
    position: relative;
    flex: 1;
    min-width: 260px;
    max-width: 400px;
  }

  #{{ section_id }} .ts__search-input {
    width: 100%;
    background: #090c10;
    border: 1px solid var(--ts-border);
    padding: 0.6rem 1rem 0.6rem 2.5rem;
    color: var(--ts-heading);
    font-family: inherit;
    font-size: 0.78rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  #{{ section_id }} .ts__search-input:focus {
    border-color: var(--ts-blue);
  }

  #{{ section_id }} .ts__search-icon {
    position: absolute;
    left: 0.8rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--ts-muted);
    font-size: 0.75rem;
  }

  /* Specifications Matrix Grid */
  #{{ section_id }} .ts__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--ts-border);
    border: 1px solid var(--ts-border);
  }

  @media (min-width: 768px) {
    #{{ section_id }} .ts__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    #{{ section_id }} .ts__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  #{{ section_id }} .ts__item {
    background: var(--ts-card);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: background 0.25s ease;
  }

  #{{ section_id }} .ts__item.is-hidden {
    display: none;
  }

  #{{ section_id }} .ts__item:hover {
    background: #1f242c;
  }

  #{{ section_id }} .ts__item-cat {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--ts-blue);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: 0.5rem;
  }

  #{{ section_id }} .ts__item-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ts-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.4rem;
  }

  #{{ section_id }} .ts__item-val {
    font-size: 1rem;
    font-weight: 800;
    color: var(--ts-heading);
    line-height: 1.35;
    margin-bottom: 0.6rem;
  }

  #{{ section_id }} .ts__item-sub {
    font-size: 0.72rem;
    color: var(--ts-green);
    font-weight: 600;
    border-top: 1px dashed var(--ts-border);
    padding-top: 0.5rem;
  }

  /* Dossier Export Footer */
  #{{ section_id }} .ts__footer {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: #090c10;
    border: 1px solid var(--ts-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  #{{ section_id }} .ts__footer-text {
    font-size: 0.78rem;
    color: var(--ts-muted);
    line-height: 1.5;
    max-width: 700px;
  }

  #{{ section_id }} .ts__footer-text strong {
    color: var(--ts-heading);
  }

  #{{ section_id }} .ts__export-btn {
    background: transparent;
    border: 1px solid var(--ts-green);
    color: var(--ts-green);
    padding: 0.7rem 1.5rem;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  #{{ section_id }} .ts__export-btn:hover,
  #{{ section_id }} .ts__export-btn.is-copied {
    background: var(--ts-green);
    color: #000000;
  }

  /* Empty Search Notice */
  #{{ section_id }} .ts__empty {
    padding: 3rem;
    text-align: center;
    color: var(--ts-muted);
    font-size: 0.9rem;
    display: none;
    grid-column: 1 / -1;
    background: var(--ts-card);
  }
</style>

<section id="{{ section_id }}">
  <div class="ts__container">
    <div class="ts__header">
      <div>
        <span class="ts__badge">[ {{ section.settings.eyebrow | default: "SYS.VERIFIED: ARCHITECTURE" }} ]</span>
        <h2 class="ts__title">{{ section.settings.heading | default: "Architectural Hardware Specs" }}</h2>
      </div>
      <div class="ts__meta">
        <div>[ SILICON REVISION: <strong>REV 4.2-PRO</strong> ]</div>
        <div>[ ISO 9001 CERTIFIED ASSEMBLY TOLERANCES ]</div>
      </div>
    </div>

    <!-- Toolbar: Category Tabs & Real-time Search -->
    <div class="ts__toolbar">
      <div class="ts__tabs" data-ts-tabs>
        <button type="button" class="ts__tab is-active" data-cat="all">[ ALL SUB-SYSTEMS ]</button>
        <button type="button" class="ts__tab" data-cat="acoustics">[ ACOUSTICS &amp; DAC ]</button>
        <button type="button" class="ts__tab" data-cat="connectivity">[ WIRELESS &amp; BT ]</button>
        <button type="button" class="ts__tab" data-cat="power">[ POWER &amp; BATTERY ]</button>
        <button type="button" class="ts__tab" data-cat="build">[ CHASSIS &amp; BUILD ]</button>
      </div>

      <div class="ts__search-wrap">
        <span class="ts__search-icon">&gt;</span>
        <input 
          type="text" 
          class="ts__search-input" 
          placeholder="FILTER SPECS (E.G. 'LDAC', '384KHZ', 'BATTERY')..." 
          aria-label="Filter technical specifications"
          data-ts-search
        >
      </div>
    </div>

    <!-- Specifications Grid -->
    <div class="ts__grid" data-ts-grid>
      {%- for block in section.blocks -%}
        <div 
          class="ts__item" 
          data-ts-item 
          data-category="{{ block.settings.category | default: 'acoustics' }}" 
          data-search-text="{{ block.settings.label | downcase }} {{ block.settings.value | downcase }} {{ block.settings.sub_note | downcase }}"
          {{ block.shopify_attributes }}
        >
          <div>
            <div class="ts__item-cat">[ {{ block.settings.category | upcase }} ]</div>
            <div class="ts__item-label">{{ block.settings.label | default: "DAC CHIPSET" }}</div>
            <div class="ts__item-val">{{ block.settings.value | default: "ESS Sabre ES9219Q Dual DAC" }}</div>
          </div>
          {%- if block.settings.sub_note != blank -%}
            <div class="ts__item-sub">// {{ block.settings.sub_note }} //</div>
          {%- endif -%}
        </div>
      {%- endfor -%}

      <div class="ts__empty" data-ts-empty>
        [ ! ] NO TECHNICAL SPECIFICATIONS MATCHING YOUR SEARCH QUERY. RESET FILTER OR SELECT ANOTHER CATEGORY.
      </div>
    </div>

    <!-- Footer Dossier Export -->
    <div class="ts__footer">
      <div class="ts__footer-text">
        <strong>ARCHITECTURAL ASSURANCE:</strong> All silicon chipsets, acoustic transducers, and lithium-polymer cells undergo 72-hour burn-in testing prior to final chassis sealing. Specifications verified at 25&deg;C ambient room temperature.
      </div>
      <button type="button" class="ts__export-btn" data-export-btn>
        [ COPY DOSSIER TO CLIPBOARD ]
      </button>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var tabs = section.querySelectorAll('.ts__tab');
    var items = section.querySelectorAll('[data-ts-item]');
    var searchInput = section.querySelector('[data-ts-search]');
    var emptyMsg = section.querySelector('[data-ts-empty]');
    var exportBtn = section.querySelector('[data-export-btn]');

    var currentCat = 'all';
    var currentQuery = '';

    function filterSpecs() {
      var visibleCount = 0;
      items.forEach(function(item) {
        var itemCat = item.getAttribute('data-category') || 'all';
        var searchText = item.getAttribute('data-search-text') || '';

        var matchCat = (currentCat === 'all' || itemCat === currentCat);
        var matchQuery = (currentQuery === '' || searchText.indexOf(currentQuery) !== -1);

        if (matchCat && matchQuery) {
          item.classList.remove('is-hidden');
          visibleCount++;
        } else {
          item.classList.add('is-hidden');
        }
      });

      if (emptyMsg) {
        emptyMsg.style.display = (visibleCount === 0) ? 'block' : 'none';
      }
    }

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('is-active'); });
        this.classList.add('is-active');
        currentCat = this.getAttribute('data-cat') || 'all';
        filterSpecs();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function() {
        currentQuery = this.value.trim().toLowerCase();
        filterSpecs();
      });
    }

    if (exportBtn) {
      exportBtn.addEventListener('click', function() {
        var textToCopy = "STOREFORGE TECHNICAL DOSSIER\n============================\n";
        items.forEach(function(item) {
          if (!item.classList.contains('is-hidden')) {
            var label = item.querySelector('.ts__item-label');
            var val = item.querySelector('.ts__item-val');
            var sub = item.querySelector('.ts__item-sub');
            if (label && val) {
              textToCopy += label.textContent.trim() + ": " + val.textContent.trim() + "\n";
              if (sub) textToCopy += "  " + sub.textContent.trim() + "\n";
            }
          }
        });
        textToCopy += "============================\nVERIFIED SILICON REVISION 4.2-PRO";

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(textToCopy).then(function() {
            exportBtn.textContent = "[ DOSSIER COPIED! ]";
            exportBtn.classList.add('is-copied');
            setTimeout(function() {
              exportBtn.textContent = "[ COPY DOSSIER TO CLIPBOARD ]";
              exportBtn.classList.remove('is-copied');
            }, 3000);
          });
        }
      });
    }
  });
</script>

