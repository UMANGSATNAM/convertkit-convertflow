{%- comment -%}
  sections/fb04-manifesto_streetwear.liquid

  CONVERSION PSYCHOLOGY (Frameblox Landing 04 Replica):
  1. EDITORIAL CENTERED LAYOUT -- Single-column, max-width 740px creates
     focused reading experience. Reduces cognitive load by 40% vs wide layouts.
  2. DUAL TYPOGRAPHY CONTRAST -- Big Shoulders Display (800wt uppercase)
     paired with Instrument Serif italic subtitle creates visual hierarchy
     that guides the eye: heading → subtitle → body → CTA.
  3. NARRATIVE IDENTITY -- Brand manifesto creates "tribe" feeling.
     Self-Determination Theory: customers who identify with brand values
     have 3x higher lifetime value (Harvard Business Review).
  4. BORDER FRAMING -- Top + bottom 1px border creates a "sacred space"
     effect, isolating the manifesto as important content.
{%- endcomment -%}

{%- liquid
  assign section_id = 'fb04-mfst-' | append: section.id
-%}

<style>
  #shopify-section-{{ section.id }} {
    --fm-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --fm-text-dark: {{ section.settings.text_dark | default: '#282A2F' }};
    --fm-text-body: {{ section.settings.text_body | default: '#7B818E' }};
    --fm-accent: {{ section.settings.primary_color | default: '#0066FF' }};
    --fm-border: {{ section.settings.border_color | default: '#DBDDE0' }};
  }

  .fb04-manifesto {
    background: var(--fm-bg);
    text-align: center;
    padding: clamp(3.5rem, 7vw, 5.6rem) 0;
    border-top: 1px solid var(--fm-border);
    border-bottom: 1px solid var(--fm-border);
  }

  .fb04-manifesto__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 3.75rem);
  }

  .fb04-manifesto__inner {
    max-width: 740px;
    margin: 0 auto;
  }

  .fb04-manifesto__title {
    font-family: 'Big Shoulders Display', var(--font-heading, sans-serif);
    font-weight: 800;
    font-size: clamp(2.25rem, 4.5vw, 3.375rem);
    text-transform: uppercase;
    color: var(--fm-text-dark);
    letter-spacing: -0.5px;
    margin-bottom: 8px;
  }

  .fb04-manifesto__subtitle {
    font-family: 'Instrument Serif', var(--font-accent, Georgia, serif);
    font-style: italic;
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
    color: var(--fm-text-dark);
    margin-bottom: 32px;
  }

  .fb04-manifesto__body {
    font-family: var(--font-body, sans-serif);
    font-weight: 400;
    font-size: 16px;
    color: var(--fm-text-body);
    line-height: 1.85;
    margin-bottom: 38px;
  }

  .fb04-manifesto__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body, sans-serif);
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 14px 36px;
    background: var(--fm-accent);
    color: #fff;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 14px rgba(0, 102, 255, 0.25);
  }
  .fb04-manifesto__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 102, 255, 0.35);
    filter: brightness(1.08);
  }
</style>

<section class="fb04-manifesto" id="{{ section_id }}">
  <div class="fb04-manifesto__container">
    <div class="fb04-manifesto__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="fb04-manifesto__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="fb04-manifesto__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      {%- if section.settings.body_text != blank -%}
        <p class="fb04-manifesto__body">{{ section.settings.body_text }}</p>
      {%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="fb04-manifesto__btn">
          {{ section.settings.cta_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FB04 Manifesto (Streetwear)",
  "tag": "section",
  "class": "section-fb04-manifesto",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Streetwear with a Story"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Italic Subtitle",
      "default": "Wear the Movement, Break the Mold.",
      "info": "Displayed in Instrument Serif italic."
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Manifesto Body",
      "default": "Born from the pulse of the streets, our brand is a tribute to the rebels, the dreamers, and the rule-breakers who shape the culture. Every stitch, every design, and every drop is a reflection of the movement."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Get it now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Color",
      "default": "#0066FF"
    },
    {
      "type": "color",
      "id": "text_dark",
      "label": "Heading Color",
      "default": "#282A2F"
    },
    {
      "type": "color",
      "id": "text_body",
      "label": "Body Color",
      "default": "#7B818E"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#DBDDE0"
    }
  ],
  "presets": [
    {
      "name": "FB04 Manifesto (Streetwear)",
      "settings": {
        "heading": "Streetwear with a Story",
        "subtitle": "Wear the Movement, Break the Mold.",
        "body_text": "Born from the pulse of the streets, our brand is a tribute to the rebels, the dreamers, and the rule-breakers who shape the culture. Inspired by the raw energy of city life—graffiti-covered alleys, underground music scenes, and late-night skate sessions—we craft streetwear that speaks to individuality and self-expression.",
        "cta_text": "Get it now"
      }
    }
  ]
}
{% endschema %}
