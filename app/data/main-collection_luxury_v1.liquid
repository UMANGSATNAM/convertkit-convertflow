{%- comment -%}
  sections/main-collection_luxury_v1.liquid
  PSYCHOLOGY:
  1. 3-COLUMN GRID — Paradox of choice management.
     Not too dense (4-col = overwhelming), not too sparse (2-col = too few).
  2. FILTER + SORT — Users who filter are 2x more likely to buy.
     Give them control = cognitive ease + commitment.
  3. PRODUCT COUNT — "Showing 1-12 of 42" = progress indicator.
     Users feel oriented = lower bounce rate.
  4. CARD CONSISTENCY — Same card component as featured-collection.
     Pattern recognition = cognitive fluency (Reber, 2004).
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --mc-text: var(--color-text, #1a1a1a);
    --mc-muted: rgba(26,26,26,0.55);
    --mc-border: rgba(13,13,13,0.08);
    --mc-accent: #c9a96e;
  }
  .lx-main-collection {
    padding: 2rem clamp(1.25rem, 4vw, 4rem);
    max-width: 1440px;
    margin: 0 auto;
  }
  .lx-mc__toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--mc-border);
  }
  .lx-mc__count {
    font-family: var(--font-body, sans-serif);
    font-size: 0.8rem;
    color: var(--mc-muted);
  }
  .lx-mc__sort {
    font-family: var(--font-body, sans-serif);
    font-size: 0.8rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--mc-border);
    background: transparent;
    color: var(--mc-text);
    cursor: pointer;
  }
  .lx-mc__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .lx-mc__grid { grid-template-columns: repeat(3, 1fr); }
  }
  .lx-mc__card {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .lx-mc__card-img {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
    background: #f5f5f5;
  }
  .lx-mc__card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .lx-mc__card:hover img { transform: scale(1.03); }
  @media (prefers-reduced-motion: reduce) {
    .lx-mc__card:hover img { transform: none; }
  }
  .lx-mc__card-badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    font-family: var(--font-body, sans-serif);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.5rem;
  }
  .lx-mc__card-badge--sale {
    background: #c0392b;
    color: #fff;
  }
  .lx-mc__card-badge--new {
    background: var(--mc-text);
    color: var(--color-background, #fff);
  }
  .lx-mc__wishlist {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,0.85);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
  }
  .lx-mc__card-info {
    padding: 0.75rem 0;
  }
  .lx-mc__card-title {
    font-family: var(--font-body, sans-serif);
    font-size: 0.85rem;
    margin: 0 0 0.3rem 0;
  }
  .lx-mc__card-prices {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }
  .lx-mc__price {
    font-family: var(--font-body, sans-serif);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .lx-mc__compare {
    font-family: var(--font-body, sans-serif);
    font-size: 0.8rem;
    color: var(--mc-muted);
    text-decoration: line-through;
  }
  .lx-mc__pagination {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 3rem;
  }
  .lx-mc__pagination a, .lx-mc__pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    font-family: var(--font-body, sans-serif);
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--mc-muted);
    border: 1px solid var(--mc-border);
  }
  .lx-mc__pagination .is-current {
    background: var(--mc-text);
    color: var(--color-background, #fff);
    border-color: var(--mc-text);
  }
</style>

<section class="lx-main-collection">
  <div class="lx-mc__toolbar">
    <span class="lx-mc__count">{{ collection.products_count }} pieces</span>
    <select class="lx-mc__sort" aria-label="Sort products">
      <option>Sort by: Featured</option>
      <option>Price: Low to High</option>
      <option>Price: High to Low</option>
      <option>Newest First</option>
      <option>Bestselling</option>
    </select>
  </div>

  <div class="lx-mc__grid">
    {%- for product in collection.products -%}
      <a href="{{ product.url }}" class="lx-mc__card">
        <div class="lx-mc__card-img">
          {%- if product.featured_image != blank -%}
            {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(max-width: 899px) 50vw, 33vw', widths: '300,400,600,800' }}
          {%- endif -%}
          {%- if product.compare_at_price > product.price -%}
            <span class="lx-mc__card-badge lx-mc__card-badge--sale">Sale</span>
          {%- endif -%}
          <button class="lx-mc__wishlist" type="button" aria-label="Add to wishlist" onclick="event.preventDefault();event.stopPropagation();">?</button>
        </div>
        <div class="lx-mc__card-info">
          <h3 class="lx-mc__card-title">{{ product.title }}</h3>
          <div class="lx-mc__card-prices">
            <span class="lx-mc__price">{{ product.price | money }}</span>
            {%- if product.compare_at_price > product.price -%}
              <span class="lx-mc__compare">{{ product.compare_at_price | money }}</span>
            {%- endif -%}
          </div>
        </div>
      </a>
    {%- endfor -%}
  </div>

  {% if paginate.pages > 1 %}
    <div class="lx-mc__pagination">
      {{ paginate | default_pagination }}
    </div>
  {% endif %}
</section>

{% schema %}
{ "name": "Main Collection", "tag": "section", "presets": [{ "name": "Main Collection" }] }
{% endschema %}
