{%- comment -%}
  =============================================================================
  STOREFORGE STREETWEAR NICHE KILLER: OVERSIZED BOXY FIT GUIDE
  =============================================================================
  Psychological Conversion Framework:
  1. Fit Anxiety & RTO Elimination: In streetwear, customers fear oversized garments might look baggy or ill-fitting. Providing precise model dimensions (e.g., "6'1 wearing XL Boxy") gives immediate sizing confidence and eliminates return rates.
  2. Industrial Brutalist Authority: Raw borders, uppercase monospace metrics, and architectural grid tables reinforce brand authenticity.
  3. Interactive Metric Toggle: Switch instantly between CM and INCHES without leaving the product page.
  
  Design Aesthetics & Rules:
  - 0% Emoji Policy: Clean ASCII brackets [ FIT SPECIFICATIONS ] and sharp technical lines.
  - Scoped CSS: Industrial brutalist contrast with hover highlights.
  =============================================================================
{%- endcomment -%}

<div class="sf-streetwear-size" data-streetwear-size>
  <style>
    .sf-streetwear-size {
      margin: 1.5rem 0;
      font-family: var(--font-body-family, 'Courier New', monospace);
    }

    .sf-st-size__trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 0.85rem 1.25rem;
      background-color: var(--color-background, #111111);
      color: var(--color-text, #ffffff);
      border: 2px solid var(--color-border, #111111);
      cursor: pointer;
      text-transform: uppercase;
      font-weight: 800;
      letter-spacing: 0.15em;
      font-size: 0.8rem;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .sf-st-size__trigger:hover {
      background-color: var(--color-primary, #ffffff);
      color: var(--color-background, #111111);
      border-color: var(--color-primary, #ffffff);
    }

    .sf-st-size__badge {
      font-size: 0.65rem;
      padding: 0.2rem 0.5rem;
      background-color: var(--color-primary, #ffffff);
      color: var(--color-background, #111111);
      font-weight: 900;
    }

    .sf-st-size__trigger:hover .sf-st-size__badge {
      background-color: var(--color-background, #111111);
      color: var(--color-primary, #ffffff);
    }

    /* Modal Overlay */
    .sf-st-size__modal-overlay {
      position: fixed;
      inset: 0;
      background-color: rgba(0, 0, 0, 0.85);
      z-index: 99999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }

    .sf-st-size__modal-overlay.is-active {
      opacity: 1;
      pointer-events: auto;
    }

    .sf-st-size__modal {
      background-color: var(--color-background, #ffffff);
      color: var(--color-text, #111111);
      border: 4px solid #111111;
      max-width: 580px;
      width: 100%;
      padding: 2rem;
      position: relative;
      transform: scale(0.96);
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 12px 12px 0px #111111;
    }

    .sf-st-size__modal-overlay.is-active .sf-st-size__modal {
      transform: scale(1);
    }

    .sf-st-size__close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: #111111;
      color: #ffffff;
      border: none;
      font-size: 1rem;
      font-weight: 900;
      width: 36px;
      height: 36px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .sf-st-size__title {
      font-size: 1.1rem;
      font-weight: 900;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 0.5rem;
      border-bottom: 2px solid #111111;
      padding-bottom: 0.5rem;
    }

    .sf-st-size__model {
      font-size: 0.75rem;
      font-weight: 700;
      color: #555555;
      margin-bottom: 1.25rem;
      text-transform: uppercase;
    }

    .sf-st-size__unit-toggle {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .sf-st-size__unit-btn {
      padding: 0.4rem 0.8rem;
      font-size: 0.7rem;
      font-weight: 800;
      border: 2px solid #111111;
      background: transparent;
      cursor: pointer;
      text-transform: uppercase;
    }

    .sf-st-size__unit-btn.is-active {
      background: #111111;
      color: #ffffff;
    }

    .sf-st-size__table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.75rem;
      text-align: left;
      margin-bottom: 1.5rem;
    }

    .sf-st-size__table th, .sf-st-size__table td {
      border: 1px solid #111111;
      padding: 0.65rem;
      font-weight: 700;
    }

    .sf-st-size__table th {
      background-color: #f3f3f3;
      text-transform: uppercase;
    }

    .sf-st-size__footer {
      font-size: 0.7rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      text-align: center;
      padding-top: 1rem;
      border-top: 2px dashed #111111;
    }
  </style>

  <button type="button" class="sf-st-size__trigger" data-size-toggle aria-label="Open size guide">
    <span>[ HEAVYWEIGHT FIT SPECIFICATIONS ]</span>
    <span class="sf-st-size__badge">BOXY FIT &rarr;</span>
  </button>

  <div class="sf-st-size__modal-overlay" data-size-modal role="dialog" aria-modal="true" aria-label="Oversized Fit Guide">
    <div class="sf-st-size__modal" onclick="event.stopPropagation();">
      <button type="button" class="sf-st-size__close" data-size-close aria-label="Close">&times;</button>
      
      <div class="sf-st-size__title">[ OVERSIZED BOXY SILHOUETTE ]</div>
      <div class="sf-st-size__model">
        // MODEL IS 6'1" (185 CM) / 78 KG & WEARING SIZE L //
      </div>

      <div class="sf-st-size__unit-toggle">
        <button type="button" class="sf-st-size__unit-btn is-active" data-unit="cm">CENTIMETERS (CM)</button>
        <button type="button" class="sf-st-size__unit-btn" data-unit="in">INCHES (IN)</button>
      </div>

      <table class="sf-st-size__table" data-table-cm>
        <thead>
          <tr>
            <th>SIZE</th>
            <th>CHEST WIDTH</th>
            <th>BODY LENGTH</th>
            <th>SHOULDER DROPPED</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>S</td><td>58 cm</td><td>70 cm</td><td>54 cm</td></tr>
          <tr><td>M</td><td>61 cm</td><td>72 cm</td><td>56 cm</td></tr>
          <tr><td>L</td><td>64 cm</td><td>74 cm</td><td>58 cm</td></tr>
          <tr><td>XL</td><td>67 cm</td><td>76 cm</td><td>60 cm</td></tr>
          <tr><td>XXL</td><td>70 cm</td><td>78 cm</td><td>62 cm</td></tr>
        </tbody>
      </table>

      <table class="sf-st-size__table" data-table-in style="display: none;">
        <thead>
          <tr>
            <th>SIZE</th>
            <th>CHEST WIDTH</th>
            <th>BODY LENGTH</th>
            <th>SHOULDER DROPPED</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>S</td><td>22.8"</td><td>27.5"</td><td>21.2"</td></tr>
          <tr><td>M</td><td>24.0"</td><td>28.3"</td><td>22.0"</td></tr>
          <tr><td>L</td><td>25.2"</td><td>29.1"</td><td>22.8"</td></tr>
          <tr><td>XL</td><td>26.4"</td><td>29.9"</td><td>23.6"</td></tr>
          <tr><td>XXL</td><td>27.5"</td><td>30.7"</td><td>24.4"</td></tr>
        </tbody>
      </table>

      <div class="sf-st-size__footer">
        [ PRE-SHRUNK 500 GSM // DESIGNED FOR AN ARCHITECTURAL DRAPE ]
      </div>
    </div>
  </div>

  <script>
    (function() {
      const container = document.querySelector('[data-streetwear-size]');
      if (!container) return;

      const toggleBtn = container.querySelector('[data-size-toggle]');
      const modal = container.querySelector('[data-size-modal]');
      const closeBtn = container.querySelector('[data-size-close]');
      const unitBtns = container.querySelectorAll('[data-unit]');
      const tableCm = container.querySelector('[data-table-cm]');
      const tableIn = container.querySelector('[data-table-in]');

      if (toggleBtn && modal) {
        toggleBtn.addEventListener('click', function() {
          modal.classList.add('is-active');
          document.body.style.overflow = 'hidden';
        });
      }

      function closeModal(e) {
        if (e) e.stopPropagation();
        if (modal) {
          modal.classList.remove('is-active');
          document.body.style.overflow = '';
        }
      }

      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (modal) modal.addEventListener('click', closeModal);

      unitBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          unitBtns.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          const unit = btn.getAttribute('data-unit');
          if (unit === 'cm') {
            if (tableCm) tableCm.style.display = 'table';
            if (tableIn) tableIn.style.display = 'none';
          } else {
            if (tableCm) tableCm.style.display = 'none';
            if (tableIn) tableIn.style.display = 'table';
          }
        });
      });
    })();
  </script>
</div>
