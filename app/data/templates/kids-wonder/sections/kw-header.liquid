<style>
  :root {
    --kw-font-sans: 'Inter', sans-serif;
    --kw-transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  /* Announcement Bar */
  .kw-announcement {
    background: #ff69b4;
    color: #fff;
    padding: 10px 0;
    overflow: hidden;
    position: relative;
    z-index: 1000;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
  }
  .kw-announcement__track {
    display: flex;
    white-space: nowrap;
    animation: kw-marquee 20s linear infinite;
  }
  .kw-announcement__item {
    padding: 0 40px;
  }
  @keyframes kw-marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* Header */
  .kw-header-wrapper {
    position: sticky;
    top: 0;
    z-index: 900;
  }
  .kw-header {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(0,0,0,0.05);
    transition: var(--kw-transition);
  }
  .kw-header.dark-mode {
    background: rgba(10, 10, 10, 0.85);
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .kw-header.kw-scrolled {
    padding: 5px 0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }
  .kw-header__container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 20px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: var(--kw-transition);
  }
  .kw-header.kw-scrolled .kw-header__container {
    padding: 10px 40px;
  }
  
  /* Navigation & Mega Menu */
  .kw-nav {
    display: flex;
    gap: 35px;
  }
  .kw-nav-item {
    position: relative;
  }
  .kw-nav-link {
    text-decoration: none;
    color: inherit;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 500;
    padding-bottom: 5px;
    position: relative;
  }
  .kw-nav-link::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 0; height: 2px;
    background: #ff69b4;
    transition: var(--kw-transition);
  }
  .kw-nav-link:hover::after {
    width: 100%;
  }
  
  .kw-mega-menu {
    position: absolute;
    top: 100%;
    left: -50px;
    width: 600px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    padding: 30px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: var(--kw-transition);
    pointer-events: none;
  }
  .kw-header.dark-mode .kw-mega-menu {
    background: #111;
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    border: 1px solid #222;
  }
  .kw-nav-item:hover .kw-mega-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Logo */
  .kw-logo {
    font-size: 24px;
    font-weight: 800;
    text-decoration: none;
    color: inherit;
    letter-spacing: 2px;
  }
  
  /* Icons */
  .kw-icons {
    display: flex;
    gap: 20px;
    align-items: center;
  }
  .kw-icon-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    transition: transform 0.3s;
    position: relative;
  }
  .kw-icon-btn:hover {
    transform: scale(1.1);
    color: #ff69b4;
  }
  .kw-cart-count {
    position: absolute;
    top: -8px; right: -10px;
    background: #ff69b4;
    color: #fff;
    font-size: 10px;
    width: 18px; height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .kw-nav { display: none; }
    .kw-header__container { padding: 15px 20px; }
  }
</style>

<div class="kw-header-wrapper">
  <div class="kw-announcement">
    <div class="kw-announcement__track">
      <div class="kw-announcement__item">✨ Premium Design. Exceptional Quality. Free Shipping Worldwide. ✨</div>
      <div class="kw-announcement__item">✨ Premium Design. Exceptional Quality. Free Shipping Worldwide. ✨</div>
      <div class="kw-announcement__item">✨ Premium Design. Exceptional Quality. Free Shipping Worldwide. ✨</div>
    </div>
  </div>

  <header class="kw-header {% if section.settings.dark_mode %}dark-mode{% endif %}" id="kw-header">
    <div class="kw-header__container">
      
      <div class="kw-mobile-menu-btn" style="display:none;">
         <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </div>

      <nav class="kw-nav">
        {% for link in linklists.main-menu.links %}
          <div class="kw-nav-item">
            <a href="{{ link.url }}" class="kw-nav-link">{{ link.title }}</a>
            {% if link.links.size > 0 %}
              <div class="kw-mega-menu">
                {% for child_link in link.links %}
                  <div>
                    <a href="{{ child_link.url }}" style="font-weight: 600; text-decoration: none; color: inherit; display: block; margin-bottom: 10px;">{{ child_link.title }}</a>
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </nav>
      
      <a href="/" class="kw-logo">{{ section.settings.logo_text | default: "BRAND" }}</a>
      
      <div class="kw-icons">
        <button class="kw-icon-btn" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>
        <button class="kw-icon-btn" aria-label="Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </button>
        <button class="kw-icon-btn" onclick="document.getElementById('kw-cart-drawer').classList.add('active'); document.getElementById('kw-cart-overlay').classList.add('active');">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          <span class="kw-cart-count">{{ cart.item_count | default: 0 }}</span>
        </button>
      </div>
    </div>
  </header>
</div>

<script>
  window.addEventListener('scroll', () => {
    const header = document.getElementById('kw-header');
    if (window.scrollY > 50) {
      header.classList.add('kw-scrolled');
    } else {
      header.classList.remove('kw-scrolled');
    }
  });
</script>

{% schema %}
{
  "name": "Premium Header",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo Text", "default": "BRAND" },
    { "type": "checkbox", "id": "dark_mode", "label": "Enable Dark Mode", "default": false }
  ]
}
{% endschema %}
