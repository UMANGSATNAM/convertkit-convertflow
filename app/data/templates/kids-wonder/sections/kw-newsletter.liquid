<style>
  .kw-newsletter { padding: 100px 0; background: #FFE66D; position: relative; overflow: hidden; text-align: center; }
  .kw-newsletter::before { content: ''; position: absolute; top: -50px; left: -50px; width: 200px; height: 200px; background: rgba(255,255,255,0.4); border-radius: 50%; filter: blur(10px); }
  .kw-newsletter::after { content: ''; position: absolute; bottom: -50px; right: -50px; width: 300px; height: 300px; background: rgba(255,107,107,0.2); border-radius: 50%; filter: blur(20px); }
  .kw-newsletter__container { max-width: 600px; margin: 0 auto; padding: 0 40px; position: relative; z-index: 2; }
  .kw-newsletter__title { font-family: 'Fredoka One', cursive; font-size: 40px; color: #2d3748; margin-bottom: 20px; line-height: 1.2; text-shadow: 2px 2px 0px #fff; }
  .kw-newsletter__text { font-family: 'Nunito', sans-serif; font-size: 18px; color: #4a5568; margin-bottom: 40px; font-weight: 700; }
  .kw-newsletter__form { display: flex; gap: 15px; }
  @media (max-width: 600px) { .kw-newsletter__form { flex-direction: column; } }
  .kw-newsletter__input { flex: 1; padding: 20px 30px; border: 4px solid #fff; border-radius: 30px; background: #fff; font-family: 'Nunito', sans-serif; font-size: 16px; color: #2d3748; outline: none; font-weight: 700; box-shadow: 0 10px 20px rgba(0,0,0,0.05); }
  .kw-newsletter__input::placeholder { color: #a0aec0; }
  .kw-newsletter__input:focus { border-color: #FF6B6B; }
  .kw-newsletter__btn { padding: 20px 40px; background: #FF6B6B; color: #fff; border: 4px solid #fff; border-radius: 30px; font-family: 'Nunito', sans-serif; font-size: 16px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 10px 20px rgba(255,107,107,0.2); }
  .kw-newsletter__btn:hover { transform: translateY(-3px) scale(1.05); box-shadow: 0 15px 30px rgba(255,107,107,0.3); }
</style>
<section class="kw-newsletter">
  <div class="kw-newsletter__container">
    <h2 class="kw-newsletter__title">{{ section.settings.title }}</h2>
    <div class="kw-newsletter__text">{{ section.settings.text }}</div>
    {% form 'customer' %}
      <div class="kw-newsletter__form">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" class="kw-newsletter__input" placeholder="{{ section.settings.placeholder }}" required>
        <button type="submit" class="kw-newsletter__btn">{{ section.settings.btn_label }}</button>
      </div>
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "KW Newsletter", "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Join the Fun! 🎈" },
    { "type": "richtext", "id": "text", "label": "Body", "default": "<p>Sign up for magical updates, secret sales, and a special birthday treat.</p>" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Enter parents email..." },
    { "type": "text", "id": "btn_label", "label": "Button", "default": "Subscribe" }
  ],
  "presets": [{ "name": "KW Newsletter" }]
}
{% endschema %}
