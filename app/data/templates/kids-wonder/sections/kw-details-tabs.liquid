<style>
  .kw-tabs { padding: 40px 0; margin-top: 40px; }
  .kw-tabs__header { display: flex; gap: 15px; margin-bottom: 30px; border-bottom: 4px solid #F7FFF7; padding-bottom: 15px; overflow-x: auto; }
  .kw-tabs__header::-webkit-scrollbar { display: none; }
  .kw-tabs__btn { background: none; border: none; font-family: 'Fredoka One', cursive; font-size: 18px; color: #a0aec0; padding: 10px 20px; cursor: pointer; border-radius: 20px; transition: all 0.3s; white-space: nowrap; }
  .kw-tabs__btn.active { background: #4ECDC4; color: #fff; box-shadow: 0 5px 15px rgba(78,205,196,0.3); }
  .kw-tabs__btn:hover:not(.active) { color: #2d3748; background: #F7FFF7; }
  .kw-tabs__content { display: none; padding: 20px; background: #F7FFF7; border-radius: 30px; }
  .kw-tabs__content.active { display: block; animation: fadeIn 0.4s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .kw-tabs__body { font-family: 'Nunito', sans-serif; font-size: 16px; line-height: 1.6; color: #4a5568; font-weight: 600; }
  .kw-tabs__body p { margin-bottom: 15px; }
</style>
<section class="kw-tabs">
  <div class="kw-tabs__header">
    {% for block in section.blocks %}
      <button class="kw-tabs__btn {% if forloop.first %}active{% endif %}" onclick="document.querySelectorAll('.kw-tabs__btn').forEach(b=>b.classList.remove('active')); this.classList.add('active'); document.querySelectorAll('.kw-tabs__content').forEach(c=>c.classList.remove('active')); document.getElementById('kw-tab-{{ forloop.index }}').classList.add('active');">{{ block.settings.heading }}</button>
    {% endfor %}
  </div>
  {% for block in section.blocks %}
    <div id="kw-tab-{{ forloop.index }}" class="kw-tabs__content {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }}>
      <div class="kw-tabs__body">{{ block.settings.body }}</div>
    </div>
  {% endfor %}
</section>
{% schema %}
{
  "name": "KW Details Tabs", "tag": "section",
  "settings": [],
  "blocks": [{ "type": "tab", "name": "Tab", "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Features" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Bright colors and fun shapes to keep little ones engaged.</p>" }
  ]}],
  "presets": [{ "name": "KW Details Tabs", "blocks": [
    { "type": "tab", "settings": { "heading": "Description" }},
    { "type": "tab", "settings": { "heading": "Safety Info" }},
    { "type": "tab", "settings": { "heading": "Shipping" }}
  ]}]
}
{% endschema %}
