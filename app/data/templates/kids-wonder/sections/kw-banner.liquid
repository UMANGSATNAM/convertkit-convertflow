<style>
  .kw-banner { padding: 80px 0; background: #fff; }
  .kw-banner__container { max-width: 1200px; margin: 0 auto; padding: 60px 40px; background: {{ section.settings.bg_color }}; border-radius: 40px; display: flex; align-items: center; justify-content: space-between; position: relative; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.05); }
  @media (max-width: 900px) { .kw-banner__container { flex-direction: column; text-align: center; gap: 40px; border-radius: 30px; } }
  .kw-banner__content { max-width: 500px; position: relative; z-index: 2; }
  .kw-banner__title { font-family: 'Fredoka One', cursive; font-size: 48px; color: #fff; margin-bottom: 20px; line-height: 1.1; text-shadow: 2px 2px 0px rgba(0,0,0,0.1); }
  .kw-banner__desc { font-family: 'Nunito', sans-serif; font-size: 20px; color: #fff; font-weight: 700; margin-bottom: 30px; }
  .kw-banner__cta { display: inline-flex; background: #fff; color: {{ section.settings.bg_color }}; padding: 18px 40px; font-family: 'Nunito', sans-serif; font-size: 18px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; text-decoration: none; border-radius: 30px; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
  .kw-banner__cta:hover { transform: translateY(-5px) scale(1.05); box-shadow: 0 15px 30px rgba(0,0,0,0.2); }
  .kw-banner__image { max-width: 400px; position: relative; z-index: 2; transform: rotate(5deg); transition: transform 0.5s; }
  .kw-banner__container:hover .kw-banner__image { transform: rotate(0deg) scale(1.05); }
  .kw-banner__shape { position: absolute; top: -50px; left: -50px; width: 300px; height: 300px; background: rgba(255,255,255,0.2); border-radius: 50%; z-index: 1; filter: blur(20px); }
  .kw-banner__shape2 { position: absolute; bottom: -50px; right: -50px; width: 200px; height: 200px; background: rgba(255,255,255,0.2); border-radius: 50%; z-index: 1; filter: blur(20px); }
</style>
<section class="kw-banner">
  <div class="kw-banner__container">
    <div class="kw-banner__shape"></div>
    <div class="kw-banner__shape2"></div>
    <div class="kw-banner__content">
      <h2 class="kw-banner__title">{{ section.settings.title }}</h2>
      <p class="kw-banner__desc">{{ section.settings.desc }}</p>
      {% if section.settings.btn_label != blank %}<a href="{{ section.settings.btn_link }}" class="kw-banner__cta">{{ section.settings.btn_label }}</a>{% endif %}
    </div>
    {% if section.settings.image %}<img class="kw-banner__image" src="{{ section.settings.image | image_url: width: 600 }}" alt="Banner Image" loading="lazy">{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "KW Banner", "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Let's Play Outside!" },
    { "type": "text", "id": "desc", "label": "Description", "default": "Check out our new summer collection of outdoor games and activities." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Shop Summer" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#4ECDC4" }
  ],
  "presets": [{ "name": "KW Banner" }]
}
{% endschema %}
