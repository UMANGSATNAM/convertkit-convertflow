<style>
  .kw-gallery { padding: 40px 0; background: #fff; }
  .kw-gallery__container { max-width: 1400px; margin: 0 auto; padding: 0 40px; display: flex; flex-direction: column; gap: 20px; }
  .kw-gallery__main { width: 100%; aspect-ratio: 1; background: #F7FFF7; border-radius: 40px; overflow: hidden; border: 4px solid #fff; box-shadow: 0 15px 30px rgba(0,0,0,0.05); }
  .kw-gallery__main img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; padding: 20px; }
  .kw-gallery__thumbs { display: flex; gap: 15px; overflow-x: auto; padding-bottom: 15px; }
  .kw-gallery__thumbs::-webkit-scrollbar { height: 8px; }
  .kw-gallery__thumbs::-webkit-scrollbar-thumb { background: #FF6B6B; border-radius: 10px; }
  .kw-gallery__thumb { width: 100px; height: 100px; flex-shrink: 0; background: #F7FFF7; border-radius: 20px; cursor: pointer; border: 3px solid transparent; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); overflow: hidden; }
  .kw-gallery__thumb:hover, .kw-gallery__thumb.active { border-color: #4ECDC4; transform: scale(1.05); box-shadow: 0 5px 15px rgba(78,205,196,0.3); }
  .kw-gallery__thumb img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; padding: 5px; }
</style>
<section class="kw-gallery">
  <div class="kw-gallery__container">
    <div class="kw-gallery__main">
      <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" id="kw-main-img">
    </div>
    <div class="kw-gallery__thumbs">
      {% for image in product.images %}
        <div class="kw-gallery__thumb {% if forloop.first %}active{% endif %}" onclick="document.getElementById('kw-main-img').src='{{ image | image_url: width: 1200 }}'; document.querySelectorAll('.kw-gallery__thumb').forEach(t=>t.classList.remove('active')); this.classList.add('active');"><img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | escape }}" loading="lazy"></div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{ "name": "KW Product Gallery", "tag": "section", "settings": [], "presets": [{ "name": "KW Product Gallery" }] }
{% endschema %}
