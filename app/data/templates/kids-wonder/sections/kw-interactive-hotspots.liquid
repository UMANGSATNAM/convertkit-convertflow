<style>
  .kw-hotspots-section {
    padding: 80px 20px;
    display: flex;
    justify-content: center;
  }
  .kw-hotspots-container {
    position: relative;
    max-width: 1000px;
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
  }
  .kw-hotspots-img {
    width: 100%;
    height: auto;
    display: block;
  }
  .kw-hotspot {
    position: absolute;
    width: 24px;
    height: 24px;
    background: #ff69b4;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    box-shadow: 0 0 0 0 #ff69b480;
    animation: kw-pulse 2s infinite;
  }
  .kw-hotspot:hover {
    animation: none;
    transform: translate(-50%, -50%) scale(1.2);
  }
  .kw-hotspot-tooltip {
    position: absolute;
    bottom: 130%;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.9);
    color: #fff;
    padding: 12px 20px;
    border-radius: 8px;
    font-family: var(--kw-font-sans, sans-serif);
    font-size: 14px;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s;
    pointer-events: none;
    border: 1px solid rgba(255,255,255,0.1);
    backdrop-filter: blur(10px);
  }
  .kw-hotspot:hover .kw-hotspot-tooltip {
    opacity: 1;
    visibility: visible;
    bottom: 150%;
  }
  @keyframes kw-pulse {
    0% { box-shadow: 0 0 0 0 #ff69b480; }
    70% { box-shadow: 0 0 0 15px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
</style>

<section class="kw-hotspots-section">
  <div class="kw-hotspots-container">
    <img src="{{ section.settings.image | img_url: 'master' | default: 'https://images.unsplash.com/photo-1542393545-10f5cde2c810?w=1200&q=80' }}" class="kw-hotspots-img" alt="Product Hotspots">
    
    <div class="kw-hotspot" style="top: 40%; left: 30%;">
      <div class="kw-hotspot-tooltip">{{ section.settings.hotspot_1 | default: 'Premium Aluminum Chassis' }}</div>
    </div>
    <div class="kw-hotspot" style="top: 60%; left: 70%;">
      <div class="kw-hotspot-tooltip">{{ section.settings.hotspot_2 | default: 'Advanced Cooling System' }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Interactive Hotspots",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Base Image" },
    { "type": "text", "id": "hotspot_1", "label": "Hotspot 1 Text" },
    { "type": "text", "id": "hotspot_2", "label": "Hotspot 2 Text" }
  ],
  "presets": [{ "name": "Interactive Hotspots" }]
}
{% endschema %}
