<style>
  .kw-buybox { position: sticky; top: 120px; padding: 40px; background: #fff; border-radius: 40px; box-shadow: 0 15px 30px rgba(0,0,0,0.05); border: 4px solid #F7FFF7; }
  .kw-buybox__vendor { font-family: 'Nunito', sans-serif; font-size: 14px; color: #4ECDC4; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; }
  .kw-buybox__title { font-family: 'Fredoka One', cursive; font-size: 36px; color: #2d3748; line-height: 1.2; margin-bottom: 15px; }
  .kw-buybox__price { font-family: 'Fredoka One', cursive; font-size: 28px; color: #FF6B6B; margin-bottom: 30px; display: flex; align-items: center; gap: 15px; }
  .kw-buybox__compare { color: #a0aec0; text-decoration: line-through; font-size: 20px; font-family: 'Nunito', sans-serif; font-weight: 700; }
  .kw-buybox__variants { margin-bottom: 30px; padding-top: 30px; border-top: 2px dashed #edf2f7; }
  .kw-buybox__variant-label { font-family: 'Nunito', sans-serif; font-size: 16px; color: #4a5568; font-weight: 800; margin-bottom: 10px; display: block; }
  .kw-buybox__variant-select { width: 100%; padding: 18px 24px; background: #F7FFF7; border: 3px solid #edf2f7; border-radius: 20px; color: #2d3748; font-family: 'Nunito', sans-serif; font-size: 16px; font-weight: 700; cursor: pointer; outline: none; transition: border-color 0.3s; margin-bottom: 20px; }
  .kw-buybox__variant-select:focus { border-color: #FFE66D; }
  .kw-buybox__add-btn { width: 100%; padding: 22px; background: #FFE66D; color: #2d3748; border: none; border-radius: 30px; font-family: 'Fredoka One', cursive; font-size: 18px; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 10px 20px rgba(255,230,109,0.3); display: flex; align-items: center; justify-content: center; gap: 10px; }
  .kw-buybox__add-btn:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 15px 30px rgba(255,230,109,0.4); }
  .kw-buybox__meta { margin-top: 30px; padding-top: 20px; border-top: 2px dashed #edf2f7; display: flex; flex-direction: column; gap: 15px; }
  .kw-buybox__meta-item { font-family: 'Nunito', sans-serif; font-size: 15px; color: #718096; display: flex; align-items: center; gap: 12px; font-weight: 700; }
  .kw-buybox__meta-icon { font-size: 20px; }
</style>
<div class="kw-buybox">
  <div class="kw-buybox__vendor">{{ product.vendor }}</div>
  <h1 class="kw-buybox__title">{{ product.title }}</h1>
  <div class="kw-buybox__price">{{ product.selected_or_first_available_variant.price | money }}{% if product.compare_at_price > product.price %}<span class="kw-buybox__compare">{{ product.compare_at_price | money }}</span>{% endif %}</div>
  {% form 'product', product %}
    {% unless product.has_only_default_variant %}
      <div class="kw-buybox__variants">
        {% for option in product.options_with_values %}
          <label class="kw-buybox__variant-label">{{ option.name }}</label>
          <select name="id" class="kw-buybox__variant-select">
            {% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title }} - {{ variant.price | money }}</option>{% endfor %}
          </select>
        {% endfor %}
      </div>
    {% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}
    <button type="submit" class="kw-buybox__add-btn" {% unless product.available %}disabled{% endunless %}>{% if product.available %}🪄 Add to Magic Bag{% else %}Out of Stock 😢{% endif %}</button>
  {% endform %}
  <div class="kw-buybox__meta">
    <div class="kw-buybox__meta-item"><span class="kw-buybox__meta-icon">🧸</span> 100% Child Safe Materials</div>
    <div class="kw-buybox__meta-item"><span class="kw-buybox__meta-icon">🎁</span> Free Gift Wrapping Available</div>
    <div class="kw-buybox__meta-item"><span class="kw-buybox__meta-icon">🚀</span> Ships within 24 Hours</div>
  </div>
</div>
{% schema %}
{ "name": "KW Sticky Buybox", "tag": "section", "settings": [], "presets": [{ "name": "KW Sticky Buybox" }] }
{% endschema %}
