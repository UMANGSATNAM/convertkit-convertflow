<style>.fb-vid-bnr{position:relative;width:100%;height:80vh;display:flex;align-items:center;justify-content:center;overflow:hidden}.fb-vid-bnr video{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);min-width:100%;min-height:100%;object-fit:cover;z-index:1}.fb-vid-bnr__overlay{position:absolute;inset:0;background:rgba(0,0,0,0.4);z-index:2}.fb-vid-bnr__content{position:relative;z-index:3;text-align:center;color:#fff;max-width:800px;padding:20px}.fb-vid-bnr h2{font-size:clamp(40px,6vw,72px);margin-bottom:20px;font-weight:500;font-family:var(--fb-font-serif,serif)}</style><section class="fb-vid-bnr"><video autoplay loop muted playsinline><source src="{{ section.settings.video_url }}" type="video/mp4"></video><div class="fb-vid-bnr__overlay"></div><div class="fb-vid-bnr__content"><h2>{{ section.settings.title }}</h2><p>{{ section.settings.text }}</p><a href="{{ section.settings.link }}" class="fb-btn">{{ section.settings.btn_text }}</a></div></section>{% schema %}{"name":"Premium Video Banner","settings":[{"type":"text","id":"video_url","label":"Video URL (MP4)"},{"type":"text","id":"title","label":"Heading","default":"Immersive Experience"},{"type":"textarea","id":"text","label":"Text","default":"Discover our latest campaign."},{"type":"text","id":"btn_text","label":"Button Text","default":"Watch Now"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Premium Video Banner"}]}{% endschema %}