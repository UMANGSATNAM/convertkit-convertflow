<style>
  .fb-benefits { padding: 60px 0; background: {{ section.settings.bg_color }}; }
  .fb-benefits__container { max-width: 1200px; margin: 0 auto; padding: 0 40px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 30px; }
  .fb-benefit { display: flex; align-items: center; gap: 15px; flex: 1; min-width: 250px; background: #fff; padding: 25px; border-radius: 16px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); border: 1px solid #edf2f7; transition: transform 0.3s; }
  .fb-benefit:hover { transform: translateY(-3px); box-shadow: 0 10px 15px rgba(0,0,0,0.05); }
  .fb-benefit__icon { width: 48px; height: 48px; border-radius: 50%; background: {{ section.settings.accent_color }}22; color: {{ section.settings.accent_color }}; display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0; }
  .fb-benefit__title { font-family: 'DM Sans', sans-serif; font-size: 16px; font-weight: 700; color: #2d3748; margin-bottom: 4px; }
  .fb-benefit__text { font-family: 'DM Sans', sans-serif; font-size: 14px; color: #718096; line-height: 1.4; }
</style>
<section class="fb-benefits">
  <div class="fb-benefits__container">
    {% for block in section.blocks %}
      <div class="fb-benefit" {{ block.shopify_attributes }}>
        <div class="fb-benefit__icon">{{ block.settings.icon }}</div>
        <div>
          <div class="fb-benefit__title">{{ block.settings.title }}</div>
          <div class="fb-benefit__text">{{ block.settings.text }}</div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "FB Benefits", "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fdfdf9" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#4CAF50" }
  ],
  "blocks": [{ "type": "benefit", "name": "Benefit", "settings": [
    { "type": "text", "id": "icon", "label": "Emoji Icon", "default": "🌿" },
    { "type": "text", "id": "title", "label": "Heading", "default": "100% Organic" },
    { "type": "text", "id": "text", "label": "Text", "default": "Certified fresh & natural." }
  ]}],
  "presets": [{ "name": "FB Benefits", "blocks": [
    { "type": "benefit", "settings": { "icon": "🌿", "title": "100% Organic", "text": "Certified fresh & natural." }},
    { "type": "benefit", "settings": { "icon": "🚜", "title": "Local Farms", "text": "Sourced from nearby growers." }},
    { "type": "benefit", "settings": { "icon": "🚚", "title": "Next-Day Delivery", "text": "Freshness guaranteed." }}
  ]}]
}
{% endschema %}
