<style>.fb-testi{background:#f9f9f9;padding:80px 20px;text-align:center}.fb-testi h2{font-size:32px;margin-bottom:50px}.fb-testi-grid{display:flex;gap:30px;max-width:1200px;margin:0 auto;overflow-x:auto;padding-bottom:20px;scrollbar-width:none}.fb-testi-card{flex:0 0 350px;background:#fff;padding:40px;border-radius:8px;box-shadow:0 10px 30px rgba(0,0,0,0.05);text-align:left}.fb-testi-stars{color:#e6a200;margin-bottom:20px}.fb-testi-text{font-size:16px;line-height:1.6;color:#555;margin-bottom:20px;font-style:italic}.fb-testi-author{font-weight:600;font-size:14px;color:#000;text-transform:uppercase}</style><section class="fb-testi"><h2>{{ section.settings.title }}</h2><div class="fb-testi-grid">{% for block in section.blocks %}<div class="fb-testi-card"><div class="fb-testi-stars">★★★★★</div><p class="fb-testi-text">"{{ block.settings.text }}"</p><div class="fb-testi-author">{{ block.settings.author }}</div></div>{% endfor %}</div></section>{% schema %}{"name":"Premium Testimonials","settings":[{"type":"text","id":"title","label":"Heading","default":"What Our Clients Say"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"text","label":"Review Text","default":"This product completely changed my life."},{"type":"text","id":"author","label":"Author","default":"Jane Doe, Verified Buyer"}]}],"presets":[{"name":"Premium Testimonials","blocks":[{"type":"review"},{"type":"review"},{"type":"review"}]}]}{% endschema %}