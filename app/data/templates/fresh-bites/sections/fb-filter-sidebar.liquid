<style>
  .fb-sidebar { padding: 60px 40px 60px 0; border-right: 1px dashed #e2e8f0; }
  .fb-sidebar__group { margin-bottom: 40px; }
  .fb-sidebar__title { font-family: 'DM Sans', sans-serif; font-size: 16px; font-weight: 700; color: #2d3748; margin-bottom: 20px; }
  .fb-sidebar__list { list-style: none; padding: 0; margin: 0; }
  .fb-sidebar__item { margin-bottom: 12px; }
  .fb-sidebar__label { display: flex; align-items: center; gap: 12px; font-family: 'DM Sans', sans-serif; font-size: 15px; color: #4a5568; cursor: pointer; transition: color 0.3s; font-weight: 500; }
  .fb-sidebar__label:hover { color: #4CAF50; }
  .fb-sidebar__checkbox { appearance: none; width: 20px; height: 20px; border: 2px solid #cbd5e0; border-radius: 6px; outline: none; cursor: pointer; transition: all 0.2s; position: relative; background: #fff; }
  .fb-sidebar__checkbox:checked { background: #4CAF50; border-color: #4CAF50; }
  .fb-sidebar__checkbox:checked::after { content: ''; position: absolute; top: 2px; left: 6px; width: 4px; height: 10px; border: solid white; border-width: 0 2px 2px 0; transform: rotate(45deg); }
</style>
<aside class="fb-sidebar">
  <div class="fb-sidebar__group">
    <div class="fb-sidebar__title">Dietary</div>
    <ul class="fb-sidebar__list">
      <li class="fb-sidebar__item"><label class="fb-sidebar__label"><input type="checkbox" class="fb-sidebar__checkbox"> Organic</label></li>
      <li class="fb-sidebar__item"><label class="fb-sidebar__label"><input type="checkbox" class="fb-sidebar__checkbox"> Gluten-Free</label></li>
      <li class="fb-sidebar__item"><label class="fb-sidebar__label"><input type="checkbox" class="fb-sidebar__checkbox"> Vegan</label></li>
      <li class="fb-sidebar__item"><label class="fb-sidebar__label"><input type="checkbox" class="fb-sidebar__checkbox"> Keto</label></li>
    </ul>
  </div>
  <div class="fb-sidebar__group">
    <div class="fb-sidebar__title">Categories</div>
    <ul class="fb-sidebar__list">
      <li class="fb-sidebar__item"><label class="fb-sidebar__label"><input type="checkbox" class="fb-sidebar__checkbox"> Produce</label></li>
      <li class="fb-sidebar__item"><label class="fb-sidebar__label"><input type="checkbox" class="fb-sidebar__checkbox"> Dairy</label></li>
      <li class="fb-sidebar__item"><label class="fb-sidebar__label"><input type="checkbox" class="fb-sidebar__checkbox"> Bakery</label></li>
      <li class="fb-sidebar__item"><label class="fb-sidebar__label"><input type="checkbox" class="fb-sidebar__checkbox"> Pantry</label></li>
    </ul>
  </div>
</aside>
{% schema %}
{ "name": "FB Filter Sidebar", "tag": "section", "settings": [], "presets": [{ "name": "FB Filter Sidebar" }] }
{% endschema %}
