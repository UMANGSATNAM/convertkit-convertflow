<style>
  .fb-drawer-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(45, 55, 72, 0.4); z-index: 999; opacity: 0; visibility: hidden; transition: all 0.3s ease; backdrop-filter: blur(2px); }
  .fb-drawer-overlay.active { opacity: 1; visibility: visible; }
  .fb-drawer { position: fixed; top: 0; right: -420px; width: 400px; max-width: 90vw; height: 100%; background: #ffffff; box-shadow: -10px 0 30px rgba(0,0,0,0.1); z-index: 1000; transition: right 0.4s cubic-bezier(0.16, 1, 0.3, 1); display: flex; flex-direction: column; }
  .fb-drawer.active { right: 0; }
  .fb-drawer__header { display: flex; justify-content: space-between; align-items: center; padding: 30px; border-bottom: 1px dashed #e2e8f0; }
  .fb-drawer__title { font-family: 'Fraunces', serif; font-size: 24px; font-weight: 600; color: #2d3748; margin: 0; }
  .fb-drawer__close { background: #f7fafc; border: none; color: #4a5568; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; font-size: 20px; display: flex; align-items: center; justify-content: center; font-weight: 400; transition: background 0.3s, color 0.3s; }
  .fb-drawer__close:hover { background: #e2e8f0; color: #2d3748; }
  .fb-drawer__body { flex: 1; overflow-y: auto; padding: 30px; background: #fdfdf9; }
  .fb-drawer__empty { text-align: center; padding: 60px 20px; color: #718096; font-family: 'DM Sans', sans-serif; font-size: 16px; font-weight: 500; }
  .fb-drawer__item { display: flex; gap: 20px; padding: 20px; background: #fff; border-radius: 16px; border: 1px solid #edf2f7; margin-bottom: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
  .fb-drawer__item-img { width: 70px; height: 70px; object-fit: contain; background: #f7fafc; border-radius: 10px; mix-blend-mode: multiply; }
  .fb-drawer__item-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
  .fb-drawer__item-name { font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 600; color: #2d3748; margin-bottom: 5px; }
  .fb-drawer__item-price { font-family: 'Fraunces', serif; font-size: 16px; font-weight: 600; color: #4CAF50; margin-bottom: 10px; }
  .fb-drawer__item-qty { display: flex; align-items: center; background: #f7fafc; border-radius: 8px; width: fit-content; padding: 2px; }
  .fb-drawer__qty-btn { width: 28px; height: 28px; background: none; border: none; color: #4a5568; cursor: pointer; font-size: 16px; font-weight: 500; border-radius: 6px; transition: background 0.2s; }
  .fb-drawer__qty-btn:hover { background: #e2e8f0; }
  .fb-drawer__qty-val { font-family: 'DM Sans', sans-serif; font-size: 14px; color: #2d3748; min-width: 30px; text-align: center; font-weight: 500; }
  .fb-drawer__footer { padding: 30px; background: #ffffff; border-top: 1px solid #e2e8f0; box-shadow: 0 -10px 20px rgba(0,0,0,0.03); }
  .fb-drawer__total { display: flex; justify-content: space-between; margin-bottom: 25px; align-items: center; }
  .fb-drawer__total-label { font-family: 'DM Sans', sans-serif; font-size: 16px; font-weight: 600; color: #4a5568; }
  .fb-drawer__total-value { font-family: 'Fraunces', serif; font-size: 28px; font-weight: 600; color: #2d3748; }
  .fb-drawer__checkout { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 18px; background: #4CAF50; color: #fff; border: none; border-radius: 12px; font-family: 'DM Sans', sans-serif; font-size: 16px; font-weight: 700; cursor: pointer; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
  .fb-drawer__checkout:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(76, 175, 80, 0.2); }
</style>
<div class="fb-drawer-overlay" id="fb-cart-overlay" onclick="document.getElementById('fb-cart-drawer').classList.remove('active'); this.classList.remove('active');"></div>
<aside class="fb-drawer" id="fb-cart-drawer">
  <div class="fb-drawer__header">
    <h3 class="fb-drawer__title">Your Basket</h3>
    <button class="fb-drawer__close" onclick="document.getElementById('fb-cart-drawer').classList.remove('active'); document.getElementById('fb-cart-overlay').classList.remove('active');">✕</button>
  </div>
  <div class="fb-drawer__body">
    {% if cart.item_count == 0 %}
      <div class="fb-drawer__empty">Your basket is empty.<br><br>Let's find some fresh produce!</div>
    {% else %}
      {% for item in cart.items %}
        <div class="fb-drawer__item">
          <img class="fb-drawer__item-img" src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title | escape }}">
          <div class="fb-drawer__item-info">
            <div>
              <div class="fb-drawer__item-name">{{ item.product.title }}</div>
              <div class="fb-drawer__item-price">{{ item.final_line_price | money }}</div>
            </div>
            <div class="fb-drawer__item-qty">
              <button class="fb-drawer__qty-btn">−</button>
              <span class="fb-drawer__qty-val">{{ item.quantity }}</span>
              <button class="fb-drawer__qty-btn">+</button>
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
  {% if cart.item_count > 0 %}
    <div class="fb-drawer__footer">
      <div class="fb-drawer__total">
        <span class="fb-drawer__total-label">Subtotal</span>
        <span class="fb-drawer__total-value">{{ cart.total_price | money }}</span>
      </div>
      <a href="/checkout" class="fb-drawer__checkout">Proceed to Checkout <span>→</span></a>
    </div>
  {% endif %}
</aside>
{% schema %}
{ "name": "FB Drawer Cart", "tag": "section", "settings": [], "presets": [{ "name": "FB Drawer Cart" }] }
{% endschema %}
