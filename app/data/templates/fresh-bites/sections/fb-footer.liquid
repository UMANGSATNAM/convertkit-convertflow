<style>
  .fb-footer { background: #fdfdf9; padding: 100px 0 40px; border-top: 1px dashed #e2e8f0; margin-top: 60px; }
  .fb-footer__container { max-width: 1400px; margin: 0 auto; padding: 0 40px; }
  .fb-footer__grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1.5fr; gap: 60px; margin-bottom: 60px; }
  @media (max-width: 1024px) { .fb-footer__grid { grid-template-columns: 1fr 1fr; gap: 40px; } }
  @media (max-width: 600px) { .fb-footer__grid { grid-template-columns: 1fr; } }
  .fb-footer__logo { font-family: 'Fraunces', serif; font-size: 24px; color: #4CAF50; text-decoration: none; font-weight: 700; display: flex; align-items: center; gap: 8px; margin-bottom: 20px; }
  .fb-footer__desc { font-family: 'DM Sans', sans-serif; font-size: 15px; color: #718096; line-height: 1.6; max-width: 320px; }
  .fb-footer__title { font-family: 'DM Sans', sans-serif; font-size: 16px; font-weight: 700; color: #2d3748; margin-bottom: 20px; }
  .fb-footer__links { list-style: none; padding: 0; margin: 0; }
  .fb-footer__links li { margin-bottom: 12px; }
  .fb-footer__links a { font-family: 'DM Sans', sans-serif; font-size: 15px; color: #718096; text-decoration: none; transition: color 0.2s; font-weight: 500; }
  .fb-footer__links a:hover { color: #4CAF50; }
  .fb-footer__bottom { padding-top: 30px; border-top: 1px solid #edf2f7; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; }
  .fb-footer__copy { font-family: 'DM Sans', sans-serif; font-size: 14px; color: #a0aec0; font-weight: 500; }
  .fb-footer__socials { display: flex; gap: 15px; }
  .fb-footer__social { width: 36px; height: 36px; background: #edf2f7; color: #4a5568; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none; transition: background 0.3s, color 0.3s; }
  .fb-footer__social:hover { background: #4CAF50; color: #fff; }
</style>
<footer class="fb-footer">
  <div class="fb-footer__container">
    <div class="fb-footer__grid">
      <div>
        <a href="/" class="fb-footer__logo">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          {{ section.settings.logo_text }}
        </a>
        <p class="fb-footer__desc">{{ section.settings.description }}</p>
      </div>
      {% for block in section.blocks %}
        <div>
          <h4 class="fb-footer__title">{{ block.settings.title }}</h4>
          <ul class="fb-footer__links">
            {% assign links = block.settings.menu | default: linklists.footer-menu %}
            {% if block.settings.menu != blank %}
              {% for link in linklists[block.settings.menu].links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
            {% endif %}
          </ul>
        </div>
      {% endfor %}
    </div>
    <div class="fb-footer__bottom">
      <span class="fb-footer__copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}. Supporting local farms.</span>
      <div class="fb-footer__socials">
        {% if section.settings.instagram != blank %}<a href="{{ section.settings.instagram }}" class="fb-footer__social" target="_blank">In</a>{% endif %}
        {% if section.settings.facebook != blank %}<a href="{{ section.settings.facebook }}" class="fb-footer__social" target="_blank">Fb</a>{% endif %}
      </div>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "FB Footer", "tag": "section",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo Text", "default": "FreshBites" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Bringing farm-fresh, organic goodness straight to your table. Eat well, live better." },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "facebook", "label": "Facebook" }
  ],
  "blocks": [{ "type": "column", "name": "Link Column", "settings": [
    { "type": "text", "id": "title", "label": "Column Title", "default": "Shop" },
    { "type": "link_list", "id": "menu", "label": "Menu" }
  ]}],
  "presets": [{ "name": "FB Footer", "blocks": [{ "type": "column", "settings": { "title": "Categories" }}, { "type": "column", "settings": { "title": "About Us" }}, { "type": "column", "settings": { "title": "Help & Support" }}] }]
}
{% endschema %}
