<style>
  .fb-comp { padding: 80px 0; background: #fdfdf9; }
  .fb-comp__container { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
  .fb-comp__title { font-family: 'Fraunces', serif; font-size: 28px; font-weight: 600; color: #2d3748; margin-bottom: 40px; text-align: center; }
  .fb-comp__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 25px; }
  @media (max-width: 900px) { .fb-comp__grid { grid-template-columns: repeat(2, 1fr); } }
  .fb-comp-card { text-decoration: none; display: flex; flex-direction: column; background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.02); transition: transform 0.3s; border: 1px solid #edf2f7; }
  .fb-comp-card:hover { transform: translateY(-4px); box-shadow: 0 10px 15px rgba(0,0,0,0.05); }
  .fb-comp-card__img-wrapper { aspect-ratio: 1; padding: 15px; background: #f7fafc; }
  .fb-comp-card__img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .fb-comp-card__info { padding: 15px; text-align: center; }
  .fb-comp-card__title { font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 600; color: #2d3748; margin-bottom: 5px; }
  .fb-comp-card__price { font-family: 'Fraunces', serif; font-size: 16px; font-weight: 600; color: #4CAF50; }
</style>
<section class="fb-comp">
  <div class="fb-comp__container">
    <h2 class="fb-comp__title">{{ section.settings.title }}</h2>
    <div class="fb-comp__grid">
      {% for product in recommendations.products limit: section.settings.limit %}
        <a href="{{ product.url }}" class="fb-comp-card">
          <div class="fb-comp-card__img-wrapper"><img class="fb-comp-card__img" src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy"></div>
          <div class="fb-comp-card__info">
            <div class="fb-comp-card__title">{{ product.title }}</div>
            <div class="fb-comp-card__price">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FB Complementary", "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Perfect Pairings" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 8, "step": 4, "default": 4 }
  ],
  "presets": [{ "name": "FB Complementary" }]
}
{% endschema %}
