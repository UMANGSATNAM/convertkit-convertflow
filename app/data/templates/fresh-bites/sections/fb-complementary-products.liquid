<style>
  .fb-complementary {
    padding: 80px 5%;
    background-color: {{ section.settings.bg_color }};
  }
  .fb-comp__title {
    font-family: 'Georgia', serif;
    font-size: 24px;
    font-weight: normal;
    text-align: center;
    margin-bottom: 40px;
  }
  .fb-comp__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .fb-comp__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .fb-comp-card {
    display: block;
    text-decoration: none;
    color: #000;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }
  .fb-comp-card__img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    margin-bottom: 10px;
  }
  .fb-comp-card__title {
    font-size: 13px;
    text-transform: uppercase;
    margin-bottom: 5px;
  }
  .fb-comp-card__price {
    font-size: 13px;
    color: #666;
  }
</style>

<section class="fb-complementary">
  <h2 class="fb-comp__title">{{ section.settings.title }}</h2>
  
  <div class="fb-comp__grid">
    {% assign count = 0 %}
    {% for related in collections.all.products limit: section.settings.limit %}
      {% if related.id != product.id %}
        {% assign count = count | plus: 1 %}
        <a href="{{ related.url }}" class="fb-comp-card">
          <img class="fb-comp-card__img" src="{{ related.featured_image | image_url: width: 400 }}" alt="{{ related.title | escape }}">
          <div class="fb-comp-card__title">{{ related.title }}</div>
          <div class="fb-comp-card__price">{{ related.price | money }}</div>
        </a>
      {% endif %}
    {% endfor %}
    
    {% if count == 0 %}
      <p style="text-align:center; grid-column: 1/-1;">No complementary products found.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "FB Complementary",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Complete The Look"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Limit",
      "default": 4
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "templates": ["product"],
  "presets": [
    {
      "name": "FB Complementary"
    }
  ]
}
{% endschema %}
