<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Courier+Prime&display=swap');

  .mf-lookbook {
    --bg-white: #ffffff;
    --bg-gray: #f3f3f3;
    --ink: #000000;
    --signal-red: #ff3e3e;
    --border-thick: 2px solid #000000;

    padding: 80px 5%;
    background-color: var(--bg-white);
    color: var(--ink);
    font-family: 'Space Grotesk', sans-serif;
  }

  .mf-lookbook__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .mf-lookbook__header {
    margin-bottom: 50px;
    text-align: left;
  }

  .mf-lookbook__subtitle {
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    color: var(--signal-red);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 3px;
    display: block;
    margin-bottom: 12px;
  }

  .mf-lookbook__title {
    font-size: clamp(34px, 5vw, 42px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -1px;
    line-height: 0.95;
    margin: 0;
  }

  /* Lookbook Grid */
  .mf-lookbook__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 768px) {
    .mf-lookbook__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
    }
  }

  .mf-lookbook__card {
    background-color: var(--bg-gray);
    border: var(--border-thick);
    box-shadow: 6px 6px 0px var(--ink);
    padding: 24px;
    position: relative;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .mf-lookbook__card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 10px 10px 0px var(--signal-red);
    border-color: var(--ink);
  }

  .mf-lookbook__image-container {
    background-color: var(--bg-white);
    border: var(--border-thick);
    aspect-ratio: 3/4;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    overflow: hidden;
    margin-bottom: 20px;
    transition: border-color 0.3s ease;
  }

  .mf-lookbook__card:hover .mf-lookbook__image-container {
    border-color: var(--signal-red);
  }

  .mf-lookbook__image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    opacity: 0.8;
  }

  .mf-lookbook__image-placeholder svg {
    width: 60px;
    height: 60px;
    margin-bottom: 12px;
    fill: currentColor;
    transition: transform 0.4s ease;
  }

  .mf-lookbook__card:hover svg {
    transform: scale(1.1) rotate(2deg);
    color: var(--signal-red);
  }

  .mf-lookbook__placeholder-text {
    font-family: 'Courier Prime', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .mf-lookbook__meta {
    border-top: var(--border-thick);
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mf-lookbook__tag {
    font-family: 'Courier Prime', monospace;
    font-size: 12px;
    font-weight: 700;
    color: var(--ink);
  }

  .mf-lookbook__number {
    font-family: 'Courier Prime', monospace;
    font-size: 11px;
    font-weight: 700;
    color: var(--signal-red);
    border: 1px solid var(--signal-red);
    padding: 2px 8px;
  }

  .mf-lookbook__card-desc {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink);
    margin: 12px 0 0 0;
    opacity: 0.8;
  }
</style>

<section class="mf-lookbook" id="mf-lookbook-{{ section.id }}">
  <div class="mf-lookbook__container">
    <div class="mf-lookbook__header">
      <span class="mf-lookbook__subtitle">{{ section.settings.subtitle }}</span>
      <h2 class="mf-lookbook__title">{{ section.settings.title }}</h2>
    </div>

    <div class="mf-lookbook__grid">
      <!-- Look 1 -->
      <div class="mf-lookbook__card">
        <div class="mf-lookbook__image-container">
          <!-- Styled Street model mockup box -->
          <div class="mf-lookbook__image-placeholder">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17.93c-3.95-.49-7-3.85-7-7.93s3.05-7.44 7-7.93v15.86zm2-15.86c3.95.49 7 3.85 7 7.93s-3.05 7.44-7 7.93V4.07z"/>
            </svg>
            <span class="mf-lookbook__placeholder-text">[STREET_SHOT // VOLT_01]</span>
          </div>
        </div>
        <div class="mf-lookbook__meta">
          <span class="mf-lookbook__tag">[LOOK_01 // UTILITY_PARKA]</span>
          <span class="mf-lookbook__number">01</span>
        </div>
        <p class="mf-lookbook__card-desc">Water-resistant nylon frame, modular utility pockets, finished with raw zip bindings.</p>
      </div>

      <!-- Look 2 -->
      <div class="mf-lookbook__card">
        <div class="mf-lookbook__image-container">
          <div class="mf-lookbook__image-placeholder">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 15c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6zm1-10h-2v3H8v2h3v3h2v-3h3v-2h-3V8z"/>
            </svg>
            <span class="mf-lookbook__placeholder-text">[SNEAKER_SHOT // AIR_03]</span>
          </div>
        </div>
        <div class="mf-lookbook__meta">
          <span class="mf-lookbook__tag">[LOOK_02 // CONCRETE_MIDSOLE]</span>
          <span class="mf-lookbook__number">02</span>
        </div>
        <p class="mf-lookbook__card-desc">Heavy chunky vulcanized rubber base, distressed gray suede panels, and monospace logo stamps.</p>
      </div>

      <!-- Look 3 -->
      <div class="mf-lookbook__card">
        <div class="mf-lookbook__image-container">
          <div class="mf-lookbook__image-placeholder">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 19.4c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0l1.9-1.9C9.07 19.58 10.47 20 12 20c4.97 0 9-4.03 9-9s-4.03-9-9-9z"/>
            </svg>
            <span class="mf-lookbook__placeholder-text">[TOTE_BAG // NYLON_04]</span>
          </div>
        </div>
        <div class="mf-lookbook__meta">
          <span class="mf-lookbook__tag">[LOOK_03 // TACTICAL_CARRIER]</span>
          <span class="mf-lookbook__number">03</span>
        </div>
        <p class="mf-lookbook__card-desc">Military-grade ballistic nylon tote with metal clasps and dual compression straps.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Streetwear Lookbook",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "VOLT° EDITORIAL // VOL_03"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "CURATED STREET MOVEMENT"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Lookbook"
    }
  ]
}
{% endschema %}
