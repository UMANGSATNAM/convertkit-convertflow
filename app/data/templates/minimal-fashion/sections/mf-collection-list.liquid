<style>.mf-cl{max-width:1400px;margin:80px auto;padding:0 20px}.mf-cl h2{text-align:center;font-size:36px;margin-bottom:50px}.mf-cl-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}.mf-cl-item{position:relative;display:block;aspect-ratio:4/5;overflow:hidden;border-radius:4px}.mf-cl-item img{width:100%;height:100%;object-fit:cover;transition:transform 0.5s}.mf-cl-item:hover img{transform:scale(1.05)}.mf-cl-overlay{position:absolute;inset:0;background:rgba(0,0,0,0.2);display:flex;align-items:center;justify-content:center}.mf-cl-overlay h3{color:#fff;font-size:24px;text-transform:uppercase;letter-spacing:2px;font-weight:500}@media(max-width:768px){.mf-cl-grid{grid-template-columns:1fr}}</style><section class="mf-cl"><h2>{{ section.settings.title }}</h2><div class="mf-cl-grid">{% for block in section.blocks %}<a href="{{ block.settings.collection.url }}" class="mf-cl-item"><img src="{{ block.settings.image | img_url: '800x' }}" alt=""><div class="mf-cl-overlay"><h3>{{ block.settings.title }}</h3></div></a>{% endfor %}</div></section>{% schema %}{"name":"Collection List Grid","settings":[{"type":"text","id":"title","label":"Heading","default":"Shop by Category"}],"blocks":[{"type":"collection","name":"Collection","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Collection"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Collection List Grid"}]}{% endschema %}