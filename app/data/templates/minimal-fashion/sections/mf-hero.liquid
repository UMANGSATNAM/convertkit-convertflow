<style>
  .mf-hero {
    position: relative;
    width: 100%;
    height: 80vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .mf-hero__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .mf-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.2);
    z-index: 2;
  }
  .mf-hero__content {
    position: relative;
    z-index: 3;
    text-align: center;
    color: {{ section.settings.text_color }};
    max-width: 800px;
    padding: 0 20px;
  }
  .mf-hero__title {
    font-family: 'Georgia', serif;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: normal;
    line-height: 1.1;
    margin-bottom: 20px;
  }
  .mf-hero__subtitle {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 40px;
  }
  .mf-hero__btn {
    display: inline-block;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    padding: 15px 40px;
    text-decoration: none;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: opacity 0.3s ease;
  }
  .mf-hero__btn:hover {
    opacity: 0.8;
  }
</style>

<section class="mf-hero">
  {% if section.settings.image %}
    <img class="mf-hero__image" src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.title | escape }}">
  {% else %}
    <div class="mf-hero__image" style="background-color: #ddd;"></div>
  {% endif %}
  <div class="mf-hero__overlay"></div>
  <div class="mf-hero__content">
    {% if section.settings.title != blank %}
      <h1 class="mf-hero__title">{{ section.settings.title }}</h1>
    {% endif %}
    {% if section.settings.subtitle != blank %}
      <div class="mf-hero__subtitle">{{ section.settings.subtitle }}</div>
    {% endif %}
    {% if section.settings.btn_label != blank and section.settings.btn_link != blank %}
      <a href="{{ section.settings.btn_link }}" class="mf-hero__btn">{{ section.settings.btn_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "MF Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "New Collection"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Discover the latest editorial pieces"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "MF Hero"
    }
  ]
}
{% endschema %}
