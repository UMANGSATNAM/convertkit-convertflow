<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Courier+Prime:wght@400;700&display=swap');

  .mf-pdp {
    --bg-white: #ffffff;
    --bg-gray: #f3f3f3;
    --ink: #000000;
    --signal-red: #ff3e3e;
    --border-thick: 2px solid #000000;
    
    background-color: var(--bg-white);
    color: var(--ink);
    font-family: 'Space Grotesk', sans-serif;
    padding: 60px 5%;
  }

  .mf-pdp__container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 768px) {
    .mf-pdp__container {
      grid-template-columns: 1.15fr 1fr;
      gap: 60px;
    }
  }

  /* Gallery CSS */
  .mf-pdp__gallery {
    position: sticky;
    top: 30px;
  }

  .mf-pdp__main-image-wrapper {
    background-color: var(--bg-gray);
    border: var(--border-thick);
    box-shadow: 6px 6px 0px var(--ink);
    padding: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    position: relative;
  }

  .mf-pdp__main-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .mf-pdp__thumbnails {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 20px;
  }

  .mf-pdp__thumb {
    background-color: var(--bg-gray);
    border: var(--border-thick);
    box-shadow: 3px 3px 0px var(--ink);
    padding: 8px;
    cursor: pointer;
    aspect-ratio: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: all 0.2s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .mf-pdp__thumb:hover, .mf-pdp__thumb.is-active {
    border-color: var(--signal-red);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px var(--ink);
  }

  .mf-pdp__thumb img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* Info/Buy-Box CSS */
  .mf-pdp__info {
    display: flex;
    flex-direction: column;
  }

  .mf-pdp__vendor {
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    text-transform: uppercase;
    color: var(--signal-red);
    font-weight: 700;
    margin-bottom: 8px;
    display: block;
  }

  .mf-pdp__title {
    font-size: clamp(32px, 5vw, 44px);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.95;
    letter-spacing: -1.5px;
    margin: 0 0 16px 0;
  }

  /* Ratings */
  .mf-pdp__rating-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    font-weight: 700;
  }

  .mf-pdp__stars {
    display: flex;
    gap: 2px;
    color: var(--signal-red);
  }

  .mf-pdp__stars svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* Price Area */
  .mf-pdp__price-area {
    margin-bottom: 30px;
  }

  .mf-pdp__price-container {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .mf-pdp__price {
    font-size: 30px;
    font-weight: 700;
    color: var(--ink);
  }

  .mf-pdp__compare-price {
    font-size: 20px;
    color: var(--signal-red);
    text-decoration: line-through;
    font-weight: 500;
  }

  .mf-pdp__tax-notice {
    font-family: 'Courier Prime', monospace;
    font-size: 12px;
    color: var(--ink);
    margin-top: 4px;
    font-weight: 700;
    opacity: 0.7;
  }

  /* Variant Size Pills */
  .mf-pdp__option-group {
    margin-bottom: 24px;
  }

  .mf-pdp__option-title {
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 12px;
    display: block;
  }

  .mf-pdp__size-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 8px;
  }

  .mf-pdp__size-pill {
    background-color: var(--bg-white);
    border: var(--border-thick);
    box-shadow: 2px 2px 0px var(--ink);
    padding: 12px 0;
    font-family: 'Courier Prime', monospace;
    font-size: 14px;
    font-weight: 700;
    border-radius: 0px;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s ease;
  }

  .mf-pdp__size-pill:hover:not(:disabled) {
    border-color: var(--signal-red);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px var(--ink);
  }

  .mf-pdp__size-pill.is-active {
    background-color: var(--ink);
    color: var(--bg-white);
    box-shadow: none;
    transform: none;
  }

  .mf-pdp__size-pill:disabled {
    opacity: 0.25;
    background-image: linear-gradient(45deg, transparent 48%, var(--ink) 48%, var(--ink) 52%, transparent 52%);
    cursor: not-allowed;
    box-shadow: none;
  }

  /* Subscribe & Save Panel */
  .mf-pdp__subscription-panel {
    border: var(--border-thick);
    border-radius: 0px;
    background-color: var(--bg-white);
    margin-bottom: 30px;
    box-shadow: 4px 4px 0px var(--ink);
  }

  .mf-pdp__sub-option {
    padding: 16px 20px;
    display: flex;
    align-items: start;
    gap: 12px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .mf-pdp__sub-option:not(:last-child) {
    border-bottom: var(--border-thick);
  }

  .mf-pdp__sub-option:hover {
    background-color: var(--bg-gray);
  }

  .mf-pdp__sub-option.is-active {
    background-color: var(--bg-gray);
  }

  .mf-pdp__radio-wrapper {
    margin-top: 2px;
  }

  .mf-pdp__radio {
    appearance: none;
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    border: var(--border-thick);
    border-radius: 0%;
    outline: none;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-white);
    cursor: pointer;
  }

  .mf-pdp__radio:checked {
    background-color: var(--signal-red);
  }

  .mf-pdp__sub-details {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .mf-pdp__sub-label-row {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .mf-pdp__sub-discount-text {
    font-family: 'Courier Prime', monospace;
    font-size: 12px;
    color: var(--signal-red);
    font-weight: 700;
    margin-top: 4px;
  }

  .mf-pdp__sub-frequency {
    margin-top: 10px;
    display: none;
  }

  .mf-pdp__sub-option.is-active .mf-pdp__sub-frequency {
    display: block;
  }

  .mf-pdp__sub-select {
    padding: 8px 12px;
    border-radius: 0px;
    border: var(--border-thick);
    background-color: var(--bg-white);
    font-family: 'Courier Prime', monospace;
    font-size: 12px;
    font-weight: 700;
    color: var(--ink);
    outline: none;
    width: 100%;
    max-width: 240px;
  }

  /* CTAs & Badges */
  .mf-pdp__btn-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 35px;
  }

  .mf-pdp__atc {
    background-color: var(--ink);
    color: var(--bg-white);
    border: var(--border-thick);
    border-radius: 0px;
    box-shadow: 4px 4px 0px var(--signal-red);
    padding: 16px;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.19, 1, 0.22, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .mf-pdp__atc:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px var(--signal-red);
    background-color: var(--signal-red);
    color: var(--bg-white);
  }

  .mf-pdp__whatsapp {
    background-color: var(--bg-white);
    color: var(--ink);
    border: var(--border-thick);
    border-radius: 0px;
    box-shadow: 4px 4px 0px var(--ink);
    padding: 14px;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.19, 1, 0.22, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .mf-pdp__whatsapp:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px var(--ink);
    background-color: var(--bg-gray);
  }

  .mf-pdp__whatsapp svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  /* COD Badge */
  .mf-pdp__cod-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--bg-gray);
    color: var(--ink);
    border: var(--border-thick);
    box-shadow: 3px 3px 0px var(--ink);
    padding: 8px 16px;
    border-radius: 0px;
    font-family: 'Courier Prime', monospace;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    align-self: flex-start;
    margin-bottom: 28px;
  }

  .mf-pdp__cod-badge svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* Specifications Table */
  .mf-pdp__specs-card {
    border: var(--border-thick);
    background-color: var(--bg-gray);
    padding: 24px;
    margin-bottom: 30px;
    box-shadow: 4px 4px 0px var(--ink);
  }

  .mf-pdp__specs-title {
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 16px;
    display: block;
  }

  .mf-pdp__spec-row {
    display: flex;
    justify-content: space-between;
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    margin-bottom: 8px;
    border-bottom: 1px dashed var(--ink);
    padding-bottom: 6px;
  }

  .mf-pdp__spec-label {
    font-weight: 700;
    color: var(--signal-red);
  }

  .mf-pdp__spec-val {
    font-weight: 700;
    color: var(--ink);
  }

  /* Pincode Checker */
  .mf-pdp__pincode-card {
    border: var(--border-thick);
    background-color: var(--bg-white);
    padding: 24px;
    margin-bottom: 30px;
    box-shadow: 4px 4px 0px var(--ink);
  }

  .mf-pdp__pincode-title {
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 12px;
    display: block;
  }

  .mf-pdp__pincode-form {
    display: flex;
    gap: 0;
  }

  .mf-pdp__pincode-input {
    flex-grow: 1;
    padding: 10px 16px;
    border-radius: 0px;
    border: var(--border-thick);
    background-color: var(--bg-white);
    font-family: 'Courier Prime', monospace;
    font-size: 13.5px;
    outline: none;
    color: var(--ink);
  }

  .mf-pdp__pincode-btn {
    background-color: var(--ink);
    color: var(--bg-white);
    border: var(--border-thick);
    border-left: none;
    border-radius: 0px;
    padding: 10px 24px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mf-pdp__pincode-btn:hover {
    background-color: var(--signal-red);
    color: var(--bg-white);
  }

  .mf-pdp__pincode-result {
    font-family: 'Courier Prime', monospace;
    font-size: 12.5px;
    margin-top: 10px;
    display: none;
    font-weight: 700;
  }

  .mf-pdp__pincode-result.is-success {
    display: block;
    color: var(--ink);
    border-left: 4px solid var(--ink);
    padding-left: 8px;
  }

  .mf-pdp__pincode-result.is-error {
    display: block;
    color: var(--signal-red);
    border-left: 4px solid var(--signal-red);
    padding-left: 8px;
  }

  /* Accordion details */
  .mf-pdp__accordion {
    border-top: var(--border-thick);
  }

  .mf-pdp__accordion-item {
    border-bottom: var(--border-thick);
  }

  .mf-pdp__accordion-btn {
    width: 100%;
    padding: 18px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: none;
    border: none;
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    color: var(--ink);
  }

  .mf-pdp__accordion-btn svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
    transition: transform 0.2s ease;
  }

  .mf-pdp__accordion-btn.is-active svg {
    transform: rotate(180deg);
  }

  .mf-pdp__accordion-content {
    display: none;
    padding-bottom: 20px;
    font-size: 14px;
    line-height: 1.6;
    opacity: 0.85;
  }
</style>

<section class="mf-pdp" id="mf-pdp-{{ section.id }}">
  <div class="mf-pdp__container">
    
    <!-- LEFT COLUMN: Image Gallery -->
    <div class="mf-pdp__gallery">
      <div class="mf-pdp__main-image-wrapper">
        {% if product.featured_image %}
          <img class="mf-pdp__main-image" id="main-image-{{ section.id }}" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}">
        {% else %}
          <!-- Standard placeholder SVG for brutalist sneaker -->
          <svg class="mf-pdp__main-image" id="main-image-{{ section.id }}" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
            <rect width="100" height="100" fill="#f3f3f3" />
            <!-- Sneaker outline visual -->
            <path d="M20 70l20-30h15l15 15h15v15H20z" fill="none" stroke="#000000" stroke-width="2" />
            <line x1="20" y1="70" x2="85" y2="70" stroke="#ff3e3e" stroke-width="3" />
          </svg>
        {% endif %}
      </div>

      <div class="mf-pdp__thumbnails">
        {% if product.images.size > 1 %}
          {% for image in product.images limit: 4 %}
            <div class="mf-pdp__thumb {% if forloop.first %}is-active{% endif %}" data-url="{{ image | image_url: width: 800 }}">
              <img src="{{ image | image_url: width: 150 }}" alt="{{ product.title | escape }}">
            </div>
          {% endfor %}
        {% else %}
          <div class="mf-pdp__thumb is-active" data-url="mock-1">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/></svg>
          </div>
          <div class="mf-pdp__thumb" data-url="mock-2">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/></svg>
          </div>
          <div class="mf-pdp__thumb" data-url="mock-3">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20"><path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 19.4"/></svg>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- RIGHT COLUMN: Buy-Box details -->
    <div class="mf-pdp__info">
      <span class="mf-pdp__vendor">// BRAND: {{ product.vendor | default: "VOLT° LABS" }}</span>
      <h1 class="mf-pdp__title">{{ product.title | default: "VOLT AIR-03 SNEAKER" }}</h1>

      <!-- Ratings -->
      <div class="mf-pdp__rating-row">
        <div class="mf-pdp__stars">
          <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        </div>
        <span>[142 REVIEWS // VERIFIED]</span>
      </div>

      <!-- Pricing -->
      <div class="mf-pdp__price-area">
        <div class="mf-pdp__price-container">
          <span class="mf-pdp__price" id="pdp-price-val-{{ section.id }}">
            {% if product %}
              {{ product.selected_or_first_available_variant.price | money }}
            {% else %}
              ₹14,999
            {% endif %}
          </span>
          <span class="mf-pdp__compare-price" id="pdp-compare-val-{{ section.id }}">
            {% if product.compare_at_price > product.price %}
              {{ product.compare_at_price | money }}
            {% else %}
              ₹17,499
            {% endif %}
          </span>
        </div>
        <div class="mf-pdp__tax-notice">// PRICE INCLUSIVE OF GST / TAXES</div>
      </div>

      <!-- COD Badge -->
      <div class="mf-pdp__cod-badge">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4z"/>
        </svg>
        COD AVAILABLE // SHIPPED FROM INDIA
      </div>

      {% form 'product', product, class: 'mf-pdp__form' %}
        <!-- Size Grid options -->
        <div class="mf-pdp__option-group">
          <span class="mf-pdp__option-title">// SELECT SIZE [UK GRID]</span>
          <div class="mf-pdp__size-grid">
            <button type="button" class="mf-pdp__size-pill" data-price="14999" data-compare="17499">6</button>
            <button type="button" class="mf-pdp__size-pill" data-price="14999" data-compare="17499">7</button>
            <button type="button" class="mf-pdp__size-pill" disabled>8</button>
            <button type="button" class="mf-pdp__size-pill is-active" data-price="14999" data-compare="17499">9</button>
            <button type="button" class="mf-pdp__size-pill" disabled>10</button>
            <button type="button" class="mf-pdp__size-pill" data-price="14999" data-compare="17499">11</button>
          </div>
          <input type="hidden" name="id" id="variant-id-{{ section.id }}" value="{{ product.selected_or_first_available_variant.id | default: '87654321' }}">
        </div>

        <!-- Subscribe & Save Options -->
        <div class="mf-pdp__subscription-panel">
          
          <!-- One Time Drop -->
          <div class="mf-pdp__sub-option is-active" id="sub-one-time-{{ section.id }}">
            <div class="mf-pdp__radio-wrapper">
              <input type="radio" name="purchase_type" class="mf-pdp__radio" checked id="radio-ot-{{ section.id }}">
            </div>
            <div class="mf-pdp__sub-details">
              <div class="mf-pdp__sub-label-row">
                <span>ONE-TIME DROP</span>
                <span class="mf-pdp__sub-price" id="ot-price-display-{{ section.id }}">₹14,999</span>
              </div>
            </div>
          </div>

          <!-- Auto-Drop (Subscribe) -->
          <div class="mf-pdp__sub-option" id="sub-recurring-{{ section.id }}">
            <div class="mf-pdp__radio-wrapper">
              <input type="radio" name="purchase_type" class="mf-pdp__radio" id="radio-rec-{{ section.id }}">
            </div>
            <div class="mf-pdp__sub-details">
              <div class="mf-pdp__sub-label-row">
                <span>AUTO-DROP (SAVE 15%)</span>
                <span class="mf-pdp__sub-price" id="rec-price-display-{{ section.id }}">₹12,749</span>
              </div>
              <span class="mf-pdp__sub-discount-text">15% SAVED ON EVERY AUTO-RELEASE</span>
              
              <!-- Frequency select -->
              <div class="mf-pdp__sub-frequency">
                <select class="mf-pdp__sub-select">
                  <option>RELEASE EVERY 30 DAYS (RECOMMENDED)</option>
                  <option>RELEASE EVERY 45 DAYS</option>
                  <option>RELEASE EVERY 60 DAYS</option>
                </select>
              </div>
            </div>
          </div>

        </div>

        <!-- CTAs -->
        <div class="mf-pdp__btn-group">
          <button type="submit" class="mf-pdp__atc" id="mf-atc-btn-{{ section.id }}">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M19 6h-2c0-2.76-2.24-5-5-5S7 3.24 7 6H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-7-3c1.66 0 3 1.34 3 3H9c0-1.66 1.34-3 3-3z"/>
            </svg>
            ADD TO BAG
          </button>
          
          <a href="https://wa.me/919999999999?text=Hi!%20I%20have%20an%20enquiry%20about%20your%20VOLT%20AIR-03%20SNEAKER." target="_blank" class="mf-pdp__whatsapp">
            <svg viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg">
