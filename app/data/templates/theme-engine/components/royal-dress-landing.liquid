    align-items: center;
    gap: 1rem;
    margin-top: auto;
  }

  #shopify-section-{{ section.id }} .rd-client-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--rd-emerald-surface);
    color: var(--rd-gold-light);
    font-family: var(--rd-font-royal);
