<!-- Interactive Liquid Script Engine -->
<script>
  (function() {
    const sectionId = "{{ section.id }}";
    const waPhone = "{{ section.settings.whatsapp_phone | default: '919876543210' }}";
    
    // Elements
    const header = document.getElementById('rdHeader-' + sectionId);
    const filterContainer = document.getElementById('rdFilterTabs-' + sectionId);
    let filterBtns = document.querySelectorAll('#shopify-section-' + sectionId + ' .rd-filter-btn');
    const productCards = document.querySelectorAll('#shopify-section-' + sectionId + ' .rd-product-card');
    const wishlistCount = document.getElementById('rdWishlistCount-' + sectionId);
    const wishlistBtnHeader = document.getElementById('rdWishlistBtn-' + sectionId);
    const wishlistBtns = document.querySelectorAll('#shopify-section-' + sectionId + ' .rd-card-wishlist');
    const quickBtns = document.querySelectorAll('#shopify-section-' + sectionId + ' .rd-btn-quick');
    const modal = document.getElementById('rdModal-' + sectionId);
    const modalClose = document.getElementById('rdModalClose-' + sectionId);
    const modalTitle = document.getElementById('rdModalTitle-' + sectionId);
    const modalPrice = document.getElementById('rdModalPrice-' + sectionId);
    const modalDesc = document.getElementById('rdModalDesc-' + sectionId);
    const modalImg = document.getElementById('rdModalImg-' + sectionId);
    const modalFabric = document.getElementById('rdModalFabric-' + sectionId);
    const modalCraft = document.getElementById('rdModalCraft-' + sectionId);
    const modalWaBtn = document.getElementById('rdModalWaBtn-' + sectionId);
    const consultForm = document.getElementById('rdConsultForm-' + sectionId);
    const consultSuccess = document.getElementById('rdSuccess-' + sectionId);
    const waDirectBtn = document.getElementById('rdWaDirectBtn-' + sectionId);
    const faqHeaders = document.querySelectorAll('#shopify-section-' + sectionId + ' .rd-faq-header');

    // Sticky Header Scroll
    window.addEventListener('scroll', function() {
      if (header) {
        if (window.scrollY > 40) {
          header.classList.add('scrolled');
        } else {
          header.classList.remove('scrolled');
        }
      }
    });

    // Dynamic Category Detection & Filter Tabs
    const presentCategories = new Set(['all']);
    productCards.forEach(function(card) {
      const cat = (card.getAttribute('data-category') || '').trim().toLowerCase();
      if (cat) presentCategories.add(cat);
    });

    function applyFilter(filter) {
      filterBtns.forEach(function(b) { b.classList.remove('active'); });
      const activeBtn = document.querySelector('#shopify-section-' + sectionId + ' .rd-filter-btn[data-filter="' + filter + '"]');
      if (activeBtn) activeBtn.classList.add('active');

      productCards.forEach(function(card) {
        const category = (card.getAttribute('data-category') || '').toLowerCase();
        if (filter === 'all' || category.indexOf(filter) !== -1 || filter.indexOf(category) !== -1) {
          card.style.display = 'flex';
          card.style.opacity = '1';
        } else {
          card.style.display = 'none';
        }
      });
    }

    filterBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        const filter = btn.getAttribute('data-filter');
        applyFilter(filter);
      });
    });

    // Wishlist Counter & LocalStorage Persistence
    let savedWishlist = [];
    try {
      savedWishlist = JSON.parse(localStorage.getItem('rd_wishlist_' + sectionId)) || [];
    } catch(e) {}
    
    if (wishlistCount) wishlistCount.textContent = savedWishlist.length;

    wishlistBtns.forEach(function(btn) {
      const id = btn.getAttribute('data-id');
      if (savedWishlist.indexOf(id) !== -1) {
        btn.classList.add('active');
      }

      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        const index = savedWishlist.indexOf(id);
        if (index === -1) {
          savedWishlist.push(id);
          btn.classList.add('active');
        } else {
          savedWishlist.splice(index, 1);
          btn.classList.remove('active');
        }
        try {
          localStorage.setItem('rd_wishlist_' + sectionId, JSON.stringify(savedWishlist));
        } catch(e) {}
        if (wishlistCount) wishlistCount.textContent = savedWishlist.length;
      });
    });

    // Header Wishlist Button: Highlights / Filters saved items
    if (wishlistBtnHeader) {
      wishlistBtnHeader.addEventListener('click', function() {
        if (savedWishlist.length === 0) {
          alert('Your wishlist is currently empty! Click the heart ♥ icon on any dress to save it.');
          return;
        }
        productCards.forEach(function(card) {
          const cardWishlistBtn = card.querySelector('.rd-card-wishlist');
          const id = cardWishlistBtn ? cardWishlistBtn.getAttribute('data-id') : null;
          if (id && savedWishlist.indexOf(id) !== -1) {
            card.style.display = 'flex';
            card.style.boxShadow = '0 0 0 2px var(--rd-ruby-rich)';
          } else {
            card.style.display = 'none';
          }
        });
        const collSection = document.getElementById('rd-collections-' + sectionId);
        if (collSection) collSection.scrollIntoView({ behavior: 'smooth' });
      });
    }

    // Direct WhatsApp Inquiry Buttons (Opens WhatsApp with specific Dress Name & Price)
    document.querySelectorAll('#shopify-section-' + sectionId + ' .rd-btn-wa-inquire').forEach(function(btn) {
      btn.addEventListener('click', function() {
        const title = btn.getAttribute('data-title') || 'Dress';
        const price = btn.getAttribute('data-price') || '';
        const msg = "Namaste, I want to inquire about \"" + title + "\" (" + price + "). Please share fabric drape video, custom sizing options, and delivery timeline.";
        window.open("https://wa.me/" + waPhone + "?text=" + encodeURIComponent(msg), '_blank');
      });
    });

    // Quick View Modal
    quickBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        const title = btn.getAttribute('data-title') || 'Heirloom Dress';
        const price = btn.getAttribute('data-price') || '';
        const desc = btn.getAttribute('data-desc') || '';
        const img = btn.getAttribute('data-img') || '';
        const fabric = btn.getAttribute('data-fabric') || 'Pure Katan Silk';
        const craft = btn.getAttribute('data-craft') || 'Handcrafted Zardozi';

        if (modalTitle) modalTitle.textContent = title;
        if (modalPrice) modalPrice.textContent = price;
        if (modalDesc) modalDesc.textContent = desc;
        if (modalImg) modalImg.src = img;
        if (modalFabric) modalFabric.textContent = fabric;
        if (modalCraft) modalCraft.textContent = craft;

        if (modalWaBtn) {
          modalWaBtn.onclick = function() {
            const msg = "Namaste, I am viewing \"" + title + "\" (" + price + ") in your royal vault. Please connect me with a senior stylist.";
            window.open("https://wa.me/" + waPhone + "?text=" + encodeURIComponent(msg), '_blank');
          };
        }

        if (modal) modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    });

    function closeModal() {
      if (modal) modal.classList.remove('active');
      document.body.style.overflow = '';
    }

    if (modalClose) {
      modalClose.addEventListener('click', closeModal);
    }

    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeModal();
    });

    // FAQ Accordion (Smooth expand/collapse)
    faqHeaders.forEach(function(header) {
      header.addEventListener('click', function() {
        const item = header.parentElement;
        const isActive = item.classList.contains('active');

        document.querySelectorAll('#shopify-section-' + sectionId + ' .rd-faq-item').forEach(function(el) {
          el.classList.remove('active');
          const icon = el.querySelector('.rd-faq-icon');
          if (icon) icon.textContent = '+';
        });

        if (!isActive) {
          item.classList.add('active');
          const icon = item.querySelector('.rd-faq-icon');
          if (icon) icon.textContent = '×';
        }
      });
    });

    // Working VIP Consultation Form: Validates and directly dispatches to WhatsApp
    if (consultForm) {
      consultForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const name = document.getElementById('rdName-' + sectionId).value;
        const phone = document.getElementById('rdPhone-' + sectionId).value;
        const occ = document.getElementById('rdOccasion-' + sectionId).value;
        const city = document.getElementById('rdCity-' + sectionId).value;

        consultForm.style.display = 'none';
        if (consultSuccess) consultSuccess.style.display = 'block';

        const consultMsg = "Namaste Riwaayat Team, I would like to confirm a VIP Salon Consultation.\n\n" +
          "• Full Name: " + name + "\n" +
          "• Phone/WhatsApp: " + phone + "\n" +
          "• Occasion: " + occ + "\n" +
          "• City: " + city;

        const directWaUrl = "https://wa.me/" + waPhone + "?text=" + encodeURIComponent(consultMsg);
        if (waDirectBtn) waDirectBtn.href = directWaUrl;

        // Auto open WhatsApp with the details
        setTimeout(function() {
          window.open(directWaUrl, '_blank');
        }, 800);
      });
    }
  })();
</script>

