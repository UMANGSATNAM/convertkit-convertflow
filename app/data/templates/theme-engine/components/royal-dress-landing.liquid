{% comment %}
  =============================================================================
  RIWAAYAT ROYAL ETHNIC DRESS LANDING PAGE (SHOPIFY OS 2.0 SECTION)
  -----------------------------------------------------------------------------
  A complete, globally reusable and 100% modular Liquid landing page section
  built specifically for Indian & global ethnic dress brands.
  
  EVERY SECTION IS WORKING & FULLY CHANGEABLE IN THE THEME CUSTOMIZER:
  - Announcement Bar: Text, badge, link, background/text colors, visibility toggle
  - Header: Brand logo/text, subtitle, wishlist counter, bespoke booking CTA
  - Hero Masthead: Asymmetric layout, headline lines 1 & 2, subtitle, CTAs,
    trust stats, rotating 360° craft seal, primary & secondary images, floating card
  - Curated Collection Vault: Dynamic filter tabs that auto-adapt to custom dress
    categories, collection picker OR customizable dress blocks, Quick View modal,
    and direct WhatsApp inquiry generator with dress name + price prefilled
  - Living Tapestry Craft Section: Headline, description, artisan image, weaver quote,
    and modular craft pillars (add/remove/reorder in Customizer)
  - Lookbook 2026: Modular lookbook cards (add/edit/delete in Customizer with images & CTAs)
  - Real Brides Diaries: Dynamic 5-star testimonials with client names, wedding locations, quotes
  - VIP Salon Booking: Interactive lead-capture form that validates and directly dispatches
    the booking details to merchant's WhatsApp
  - Collapsible FAQ Accordion: Dynamic questions & answers with smooth accordion toggles
  - Footer & Navigation: Atelier vault links, craft narrative, social links, copyright
  - Floating WhatsApp Concierge & Mobile Bottom Sticky Bar: Custom phone, messages, toggles
  =============================================================================
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --rd-emerald-deep: {{ section.settings.color_primary_dark | default: '#082018' }};
    --rd-emerald-rich: {{ section.settings.color_primary | default: '#0e3025' }};
    --rd-emerald-surface: {{ section.settings.color_primary_surface | default: '#143e31' }};
    --rd-emerald-light: {{ section.settings.color_primary_light | default: '#1e5242' }};

    --rd-gold-base: {{ section.settings.color_gold | default: '#c5a059' }};
    --rd-gold-light: {{ section.settings.color_gold_light | default: '#dfba73' }};
    --rd-gold-dark: {{ section.settings.color_gold_dark | default: '#967537' }};
    --rd-gold-glow: rgba(197, 160, 89, 0.25);

    --rd-ruby-deep: {{ section.settings.color_accent_deep | default: '#6f0f1c' }};
    --rd-ruby-rich: {{ section.settings.color_accent | default: '#8b1e2d' }};

    --rd-ivory-bg: {{ section.settings.color_bg | default: '#faf7f2' }};
    --rd-ivory-card: #ffffff;
    --rd-ivory-warm: {{ section.settings.color_bg_warm | default: '#f3ede2' }};
    --rd-ivory-border: {{ section.settings.color_border | default: '#e6decb' }};

    --rd-text-main: {{ section.settings.color_text | default: '#19211e' }};
    --rd-text-muted: {{ section.settings.color_text_muted | default: '#5e6b66' }};
    --rd-text-light: #e2ece8;

    --rd-font-royal: 'Cinzel', Georgia, serif;
    --rd-font-editorial: 'Playfair Display', Georgia, serif;
    --rd-font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

    --rd-shadow-subtle: 0 4px 20px rgba(8, 32, 24, 0.05);
    --rd-shadow-medium: 0 10px 30px rgba(8, 32, 24, 0.08);
    --rd-shadow-elevated: 0 20px 45px rgba(8, 32, 24, 0.14);
    --rd-shadow-gold: 0 8px 30px rgba(197, 160, 89, 0.22);

    --rd-transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    --rd-radius-sm: 4px;
    --rd-radius-md: 8px;
    --rd-radius-lg: 16px;

    font-family: var(--rd-font-body);
    background-color: var(--rd-ivory-bg);
    color: var(--rd-text-main);
    line-height: 1.65;
    position: relative;
    overflow-x: hidden;
  }

  /* Reset & Container */
  #shopify-section-{{ section.id }} * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .rd-container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  #shopify-section-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
    transition: var(--rd-transition);
  }

  #shopify-section-{{ section.id }} button {
    cursor: pointer;
    font-family: inherit;
    background: none;
    border: none;
  }

  #shopify-section-{{ section.id }} img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* Typography Utilities */
  #shopify-section-{{ section.id }} .rd-serif {
    font-family: var(--rd-font-editorial);
  }

  #shopify-section-{{ section.id }} .rd-royal-title {
    font-family: var(--rd-font-royal);
  }

  #shopify-section-{{ section.id }} .rd-text-gold {
    color: var(--rd-gold-base);
  }

  #shopify-section-{{ section.id }} .rd-eyebrow {
    display: inline-block;
    font-family: var(--rd-font-royal);
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    font-weight: 700;
    color: var(--rd-gold-dark);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .rd-section-header {
    max-width: 720px;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .rd-section-title {
    font-family: var(--rd-font-editorial);
    font-size: 2.6rem;
    color: var(--rd-emerald-deep);
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  #shopify-section-{{ section.id }} .rd-section-desc {
    font-size: 1.05rem;
    color: var(--rd-text-muted);
    line-height: 1.7;
  }

  /* Buttons */
  #shopify-section-{{ section.id }} .rd-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: 0.05em;
    padding: 0.85rem 1.85rem;
    border-radius: var(--rd-radius-sm);
    transition: var(--rd-transition);
  }

  #shopify-section-{{ section.id }} .rd-btn-gold {
    background: linear-gradient(135deg, var(--rd-gold-base) 0%, var(--rd-gold-light) 50%, var(--rd-gold-dark) 100%);
    color: var(--rd-emerald-deep);
    box-shadow: var(--rd-shadow-gold);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  #shopify-section-{{ section.id }} .rd-btn-gold:hover {
    background: linear-gradient(135deg, var(--rd-gold-light) 0%, #ecd093 50%, var(--rd-gold-base) 100%);
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(197, 160, 89, 0.35);
  }

  #shopify-section-{{ section.id }} .rd-btn-emerald {
    background-color: var(--rd-emerald-surface);
    color: #ffffff;
    border: 1px solid var(--rd-emerald-light);
  }

  #shopify-section-{{ section.id }} .rd-btn-emerald:hover {
    background-color: var(--rd-emerald-deep);
    color: var(--rd-gold-light);
    transform: translateY(-3px);
  }

  #shopify-section-{{ section.id }} .rd-btn-outline {
    border: 1px solid var(--rd-gold-base);
    color: var(--rd-emerald-deep);
    padding: 0.55rem 1.25rem;
    font-size: 0.82rem;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .rd-btn-outline:hover {
    background-color: var(--rd-gold-base);
    color: #ffffff;
  }

  /* Top Announcement Bar */
  #shopify-section-{{ section.id }} .rd-announcement-bar {
    background-color: var(--rd-emerald-deep);
    color: var(--rd-ivory-warm);
    font-size: 0.82rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(197, 160, 89, 0.3);
  }

  #shopify-section-{{ section.id }} .rd-announcement-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .rd-announcement-badge {
    background-color: var(--rd-ruby-rich);
    color: #ffffff;
    padding: 0.2rem 0.65rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: var(--rd-radius-sm);
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .rd-announcement-text {
    flex: 1;
    text-align: center;
    letter-spacing: 0.02em;
  }

  #shopify-section-{{ section.id }} .rd-announcement-link {
    color: var(--rd-gold-light);
    font-weight: 600;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* Header Navigation */
  #shopify-section-{{ section.id }} .rd-header {
    background-color: rgba(250, 247, 242, 0.95);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--rd-ivory-border);
    transition: var(--rd-transition);
  }

  #shopify-section-{{ section.id }} .rd-header.scrolled {
    box-shadow: var(--rd-shadow-subtle);
    background-color: rgba(255, 255, 255, 0.98);
  }

  #shopify-section-{{ section.id }} .rd-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 84px;
  }

  #shopify-section-{{ section.id }} .rd-brand-name {
    font-family: var(--rd-font-royal);
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--rd-emerald-deep);
  }

  #shopify-section-{{ section.id }} .rd-brand-sub {
    font-size: 0.58rem;
    letter-spacing: 0.35em;
    color: var(--rd-gold-dark);
    font-weight: 600;
    display: block;
    margin-top: -3px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .rd-nav-list {
    display: flex;
    list-style: none;
    gap: 2rem;
  }

  #shopify-section-{{ section.id }} .rd-nav-link {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--rd-emerald-deep);
    letter-spacing: 0.04em;
    position: relative;
    padding: 0.25rem 0;
  }

  #shopify-section-{{ section.id }} .rd-nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--rd-gold-base);
    transition: var(--rd-transition);
  }

  #shopify-section-{{ section.id }} .rd-nav-link:hover::after {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .rd-header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  #shopify-section-{{ section.id }} .rd-wishlist-trigger {
    font-size: 1.15rem;
    color: var(--rd-emerald-deep);
    position: relative;
    padding: 0.4rem;
  }

  #shopify-section-{{ section.id }} .rd-wishlist-badge {
    position: absolute;
    top: -2px;
    right: -4px;
    background-color: var(--rd-ruby-rich);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Hero Editorial Masthead */
  #shopify-section-{{ section.id }} .rd-hero {
    position: relative;
    background-color: var(--rd-emerald-deep);
    color: #ffffff;
    padding: 5rem 0 6rem;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .rd-hero-texture {
    position: absolute;
    inset: 0;
    opacity: 0.04;
    background-image: radial-gradient(var(--rd-gold-base) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .rd-hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 3.5rem;
  }

  #shopify-section-{{ section.id }} .rd-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    background: rgba(197, 160, 89, 0.12);
    border: 1px solid rgba(197, 160, 89, 0.35);
    border-radius: 100px;
    font-size: 0.72rem;
    font-family: var(--rd-font-royal);
    letter-spacing: 0.15em;
    color: var(--rd-gold-light);
    margin-bottom: 1.75rem;
  }

  #shopify-section-{{ section.id }} .rd-hero-pill .dot {
    width: 6px;
    height: 6px;
    background-color: var(--rd-gold-light);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--rd-gold-light);
  }

  #shopify-section-{{ section.id }} .rd-hero-title {
    font-family: var(--rd-font-editorial);
    font-size: 3.6rem;
    line-height: 1.15;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  #shopify-section-{{ section.id }} .rd-hero-subtitle {
    font-size: 1.12rem;
    line-height: 1.75;
    color: #b5c7c0;
    margin-bottom: 2.5rem;
    font-weight: 300;
    max-width: 580px;
  }

  #shopify-section-{{ section.id }} .rd-hero-btns {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
  }

  #shopify-section-{{ section.id }} .rd-hero-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(197, 160, 89, 0.2);
  }

  #shopify-section-{{ section.id }} .rd-stat-val {
    font-family: var(--rd-font-royal);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--rd-gold-light);
    display: block;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .rd-stat-lbl {
    font-size: 0.76rem;
    color: #9cb1a9;
  }

  #shopify-section-{{ section.id }} .rd-stat-divider {
    width: 1px;
    height: 35px;
    background-color: rgba(197, 160, 89, 0.25);
  }

  /* Asymmetric Visual Collage */
  #shopify-section-{{ section.id }} .rd-hero-collage {
    position: relative;
    min-height: 520px;
    display: flex;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .rd-visual-card {
    position: absolute;
    border-radius: var(--rd-radius-md);
    overflow: hidden;
    box-shadow: var(--rd-shadow-elevated);
    border: 1px solid rgba(197, 160, 89, 0.3);
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  #shopify-section-{{ section.id }} .rd-visual-primary {
    width: 360px;
    height: 480px;
    left: 10%;
    top: 0;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .rd-visual-secondary {
    width: 240px;
    height: 330px;
    right: 0%;
    bottom: -20px;
    z-index: 3;
  }

  #shopify-section-{{ section.id }} .rd-visual-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  #shopify-section-{{ section.id }} .rd-visual-card:hover img {
    transform: scale(1.05);
  }

  #shopify-section-{{ section.id }} .rd-card-caption {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    background: rgba(8, 32, 24, 0.88);
    backdrop-filter: blur(8px);
    padding: 0.85rem 1.2rem;
    border-radius: var(--rd-radius-sm);
    border-left: 3px solid var(--rd-gold-base);
  }

  #shopify-section-{{ section.id }} .rd-caption-title {
    font-family: var(--rd-font-royal);
    font-size: 0.92rem;
    color: #ffffff;
    font-weight: 600;
    display: block;
  }

  #shopify-section-{{ section.id }} .rd-caption-meta {
    font-size: 0.72rem;
    color: var(--rd-gold-light);
    display: block;
  }

  /* Rotating Gold Seal Stamp */
  #shopify-section-{{ section.id }} .rd-hero-stamp {
    position: absolute;
    bottom: 20px;
    left: -20px;
    width: 110px;
    height: 110px;
    z-index: 4;
  }

  #shopify-section-{{ section.id }} .rd-stamp-svg {
    width: 100%;
    height: 100%;
    animation: rdRotateStamp 22s linear infinite;
  }

  @keyframes rdRotateStamp {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  #shopify-section-{{ section.id }} .rd-stamp-center {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 44px;
    height: 44px;
    background-color: var(--rd-gold-base);
    color: var(--rd-emerald-deep);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }

  /* Collection Filter & Grid Section */
  #shopify-section-{{ section.id }} .rd-collection-section {
    padding: 7rem 0 6rem;
    background-color: var(--rd-ivory-bg);
  }

  #shopify-section-{{ section.id }} .rd-filter-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 3.5rem;
  }

  #shopify-section-{{ section.id }} .rd-filter-tabs {
    display: inline-flex;
    gap: 0.5rem;
    background-color: var(--rd-ivory-warm);
    padding: 0.4rem;
    border-radius: 100px;
    border: 1px solid var(--rd-ivory-border);
    flex-wrap: wrap;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .rd-filter-btn {
    padding: 0.65rem 1.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--rd-text-muted);
    border-radius: 100px;
    transition: var(--rd-transition);
  }

  #shopify-section-{{ section.id }} .rd-filter-btn.active {
    background-color: var(--rd-emerald-deep);
    color: var(--rd-gold-light);
    box-shadow: var(--rd-shadow-subtle);
  }

  #shopify-section-{{ section.id }} .rd-product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.25rem;
  }

  #shopify-section-{{ section.id }} .rd-product-card {
    background-color: var(--rd-ivory-card);
    border-radius: var(--rd-radius-md);
    overflow: hidden;
    border: 1px solid var(--rd-ivory-border);
    box-shadow: var(--rd-shadow-subtle);
    transition: var(--rd-transition);
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .rd-product-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--rd-shadow-elevated);
    border-color: rgba(197, 160, 89, 0.4);
  }

  #shopify-section-{{ section.id }} .rd-product-media {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
    background-color: #f1ece4;
  }

  #shopify-section-{{ section.id }} .rd-product-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  #shopify-section-{{ section.id }} .rd-product-card:hover .rd-product-media img {
    transform: scale(1.06);
  }

  #shopify-section-{{ section.id }} .rd-card-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: var(--rd-ruby-rich);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: var(--rd-radius-sm);
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .rd-card-wishlist {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: var(--rd-emerald-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    z-index: 2;
    transition: var(--rd-transition);
  }

  #shopify-section-{{ section.id }} .rd-card-wishlist:hover,
  #shopify-section-{{ section.id }} .rd-card-wishlist.active {
    background-color: var(--rd-ruby-rich);
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .rd-quick-overlay {
    position: absolute;
    inset: auto 1rem 1rem 1rem;
    opacity: 0;
    transform: translateY(10px);
    transition: var(--rd-transition);
    z-index: 3;
  }

  #shopify-section-{{ section.id }} .rd-product-card:hover .rd-quick-overlay {
    opacity: 1;
    transform: translateY(0);
  }

  #shopify-section-{{ section.id }} .rd-btn-quick {
    width: 100%;
    background: rgba(8, 32, 24, 0.92);
    backdrop-filter: blur(6px);
    color: #ffffff;
    padding: 0.75rem;
    font-size: 0.84rem;
    font-weight: 600;
    border-radius: var(--rd-radius-sm);
    border: 1px solid rgba(197, 160, 89, 0.35);
    transition: var(--rd-transition);
  }

  #shopify-section-{{ section.id }} .rd-btn-quick:hover {
    background-color: var(--rd-gold-base);
    color: var(--rd-emerald-deep);
  }

  #shopify-section-{{ section.id }} .rd-product-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  #shopify-section-{{ section.id }} .rd-product-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--rd-gold-dark);
    margin-bottom: 0.35rem;
  }

  #shopify-section-{{ section.id }} .rd-product-title {
    font-family: var(--rd-font-editorial);
    font-size: 1.28rem;
    color: var(--rd-emerald-deep);
    line-height: 1.35;
    margin-bottom: 0.4rem;
  }

  #shopify-section-{{ section.id }} .rd-product-craft {
    font-size: 0.82rem;
    color: var(--rd-text-muted);
    margin-bottom: 1.2rem;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .rd-product-prices {
    margin-top: auto;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  #shopify-section-{{ section.id }} .rd-price-curr {
