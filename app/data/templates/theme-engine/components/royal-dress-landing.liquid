  /* VIP Booking & Salon Consultation Section */
  #shopify-section-{{ section.id }} .rd-booking-section {
    padding: 6.5rem 0;
    background: linear-gradient(135deg, var(--rd-emerald-deep) 0%, #0d3427 100%);
