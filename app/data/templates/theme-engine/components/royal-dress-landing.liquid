    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    box-shadow: var(--rd-shadow-elevated);
  }

  #shopify-section-{{ section.id }} .rd-form-box {
    background: #ffffff;
    color: var(--rd-text-main);
    padding: 2.5rem;
    border-radius: var(--rd-radius-md);
    box-shadow: var(--rd-shadow-elevated);
  }

  #shopify-section-{{ section.id }} .rd-form-field {
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  #shopify-section-{{ section.id }} .rd-form-field label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--rd-emerald-deep);
  }

  #shopify-section-{{ section.id }} .rd-form-field input,
  #shopify-section-{{ section.id }} .rd-form-field select {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #d4ddd9;
    border-radius: var(--rd-radius-sm);
    font-size: 0.92rem;
    background-color: var(--rd-ivory-bg);
  }

  #shopify-section-{{ section.id }} .rd-btn-submit {
    width: 100%;
    background: var(--rd-emerald-deep);
    color: var(--rd-gold-light);
    padding: 0.95rem;
    font-size: 0.92rem;
    font-weight: 700;
    border-radius: var(--rd-radius-sm);
    transition: var(--rd-transition);
    margin-top: 0.5rem;
  }

  #shopify-section-{{ section.id }} .rd-btn-submit:hover {
    background: var(--rd-emerald-surface);
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* FAQ Accordion Section */
  #shopify-section-{{ section.id }} .rd-faq-section {
    padding: 6.5rem 0;
    background-color: var(--rd-ivory-bg);
  }

  #shopify-section-{{ section.id }} .rd-faq-container {
    max-width: 820px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .rd-faq-item {
    border-bottom: 1px solid var(--rd-ivory-border);
    margin-bottom: 1rem;
  }

  #shopify-section-{{ section.id }} .rd-faq-header {
    width: 100%;
    padding: 1.25rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--rd-font-editorial);
    font-size: 1.2rem;
    color: var(--rd-emerald-deep);
    text-align: left;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .rd-faq-icon {
    font-size: 1.2rem;
    color: var(--rd-gold-dark);
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .rd-faq-item.active .rd-faq-icon {
    transform: rotate(45deg);
  }

  #shopify-section-{{ section.id }} .rd-faq-body {
    display: none;
    padding-bottom: 1.5rem;
    font-size: 0.95rem;
    color: var(--rd-text-muted);
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .rd-faq-item.active .rd-faq-body {
    display: block;
  }

  /* Floating WhatsApp Concierge */
  #shopify-section-{{ section.id }} .rd-floating-concierge {
    position: fixed;
    bottom: 2.2rem;
    right: 2.2rem;
    z-index: 99;
  }

  #shopify-section-{{ section.id }} .rd-concierge-anchor {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background: #25d366;
    color: #ffffff;
    padding: 0.75rem 1.35rem 0.75rem 0.9rem;
    border-radius: 100px;
    box-shadow: 0 10px 30px rgba(37, 211, 102, 0.4);
    position: relative;
    transition: var(--rd-transition);
  }

  #shopify-section-{{ section.id }} .rd-concierge-anchor:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 14px 35px rgba(37, 211, 102, 0.5);
  }

  #shopify-section-{{ section.id }} .rd-concierge-pulse {
    position: absolute;
    inset: 0;
    border-radius: 100px;
    background: #25d366;
    opacity: 0.5;
    animation: rdPulsePing 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
    z-index: -1;
  }

  @keyframes rdPulsePing {
    70%, 100% {
      transform: scale(1.3, 1.6);
      opacity: 0;
    }
  }

  #shopify-section-{{ section.id }} .rd-concierge-icon {
    width: 38px;
    height: 38px;
    background: #ffffff;
    color: #25d366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
  }

  /* Mobile Sticky Bottom Bar */
  #shopify-section-{{ section.id }} .rd-mobile-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #ffffff;
    border-top: 1px solid var(--rd-ivory-border);
    padding: 0.75rem 1rem;
    z-index: 90;
    gap: 0.75rem;
    box-shadow: 0 -4px 15px rgba(0, 0, 0, 0.08);
  }

  #shopify-section-{{ section.id }} .rd-mobile-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.8rem;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: var(--rd-radius-sm);
  }

  #shopify-section-{{ section.id }} .rd-mobile-primary {
    background: #25d366;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .rd-mobile-secondary {
    background: var(--rd-emerald-deep);
    color: var(--rd-gold-light);
  }

  /* Quick View Modal */
  #shopify-section-{{ section.id }} .rd-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(8, 32, 24, 0.78);
    backdrop-filter: blur(8px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    visibility: hidden;
    transition: var(--rd-transition);
  }

  #shopify-section-{{ section.id }} .rd-modal-backdrop.active {
    opacity: 1;
    visibility: visible;
  }

  #shopify-section-{{ section.id }} .rd-modal-box {
    background: #ffffff;
    border-radius: var(--rd-radius-md);
    max-width: 860px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
  }

  #shopify-section-{{ section.id }} .rd-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--rd-ivory-warm);
    color: var(--rd-emerald-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    z-index: 10;
  }

  #shopify-section-{{ section.id }} .rd-modal-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
  }

  #shopify-section-{{ section.id }} .rd-modal-media {
    aspect-ratio: 3/4;
    overflow: hidden;
    background: #f5f1eb;
  }

  #shopify-section-{{ section.id }} .rd-modal-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .rd-modal-info {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
  }

  /* Responsive Rules */
  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .rd-hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    #shopify-section-{{ section.id }} .rd-hero-pill {
      margin: 0 auto 1.5rem;
    }
    #shopify-section-{{ section.id }} .rd-hero-subtitle {
      margin-left: auto;
      margin-right: auto;
    }
    #shopify-section-{{ section.id }} .rd-hero-btns {
      justify-content: center;
    }
    #shopify-section-{{ section.id }} .rd-hero-stats {
      justify-content: center;
    }
    #shopify-section-{{ section.id }} .rd-product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    #shopify-section-{{ section.id }} .rd-craft-grid {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .rd-booking-card {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .rd-lookbook-card.large {
      grid-column: auto;
    }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .rd-nav-list {
      display: none;
    }
    #shopify-section-{{ section.id }} .rd-hero-title {
      font-size: 2.5rem;
    }
    #shopify-section-{{ section.id }} .rd-product-grid {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .rd-floating-concierge {
      display: none;
    }
    #shopify-section-{{ section.id }} .rd-mobile-bar {
      display: flex;
    }
    #shopify-section-{{ section.id }} {
      padding-bottom: 70px;
    }
    #shopify-section-{{ section.id }} .rd-modal-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<!-- Top Announcement Banner (Changeable) -->
{% if section.settings.show_announcement %}
<div class="rd-announcement-bar">
  <div class="rd-container rd-announcement-inner">
    <span class="rd-announcement-badge">{{ section.settings.announcement_badge | default: "Festive Season 2026" }}</span>
    <p class="rd-announcement-text">{{ section.settings.announcement_text | default: "Complimentary Worldwide Express Delivery & Bespoke Blouse Fitting on All Orders" }}</p>
    {% if section.settings.announcement_link_text != blank %}
      <a href="{{ section.settings.announcement_link | default: '#rd-booking' }}" class="rd-announcement-link">
        {{ section.settings.announcement_link_text }} →
      </a>
    {% endif %}
  </div>
</div>
{% endif %}

<!-- Primary Sticky Header Navigation (Changeable) -->
<header class="rd-header" id="rdHeader-{{ section.id }}">
  <div class="rd-container rd-header-inner">
    <div class="rd-brand-box">
      <a href="{{ routes.root_url | default: '/' }}" class="rd-brand-link">
        <span class="rd-brand-name">{{ section.settings.brand_name | default: "RIWAAYAT" }}</span>
        <span class="rd-brand-sub">{{ section.settings.brand_tagline | default: "HAUTE HERITAGE COUTURE" }}</span>
      </a>
    </div>

    <nav class="rd-main-nav">
      <ul class="rd-nav-list">
        <li><a href="#rd-collections-{{ section.id }}" class="rd-nav-link">Creations</a></li>
        <li><a href="#rd-craft-{{ section.id }}" class="rd-nav-link">Artisan Heritage</a></li>
        <li><a href="#rd-lookbook-{{ section.id }}" class="rd-nav-link">Lookbook</a></li>
        <li><a href="#rd-testimonials-{{ section.id }}" class="rd-nav-link">Real Brides</a></li>
        <li><a href="#rd-faq-{{ section.id }}" class="rd-nav-link">Bespoke FAQs</a></li>
      </ul>
    </nav>

    <div class="rd-header-actions">
      <button class="rd-wishlist-trigger" id="rdWishlistBtn-{{ section.id }}" aria-label="View Saved Dresses" title="Click to view saved wishlist">
        ♥ <span class="rd-wishlist-badge" id="rdWishlistCount-{{ section.id }}">0</span>
      </button>
      <a href="#rd-booking-{{ section.id }}" class="rd-btn rd-btn-outline">
        {{ section.settings.header_cta_text | default: "Book Fitting" }}
      </a>
    </div>
  </div>
</header>

<main>
  <!-- Hero Section (Changeable & Interactive) -->
  <section class="rd-hero">
    <div class="rd-hero-texture"></div>
    <div class="rd-container rd-hero-grid">
      <div class="rd-hero-content">
        <div class="rd-hero-pill">
          <span class="dot"></span> {{ section.settings.hero_eyebrow | default: "PURE BANARASI SILK & HANDCRAFTED ZARDOZI" }}
        </div>
        <h1 class="rd-hero-title">
          {{ section.settings.hero_title_line1 | default: "Where Regal Heritage" }} <br>
          <span class="rd-serif rd-text-gold">{{ section.settings.hero_title_line2 | default: "Meets Modern Majesty" }}</span>
        </h1>
        <p class="rd-hero-subtitle">
          {{ section.settings.hero_subtitle | default: "Heirloom bridal lehengas, hand-spun Katan silks, and majestic festive attire crafted by master karigars across Varanasi and Jaipur. Woven for memories that span generations." }}
        </p>
        
        <div class="rd-hero-btns">
          <a href="{{ section.settings.hero_btn_primary_link | default: '#rd-collections' }}" class="rd-btn rd-btn-gold">
            {{ section.settings.hero_btn_primary | default: "Explore The Vault" }}
          </a>
          <a href="https://wa.me/{{ section.settings.whatsapp_phone | default: '919876543210' }}?text={{ section.settings.whatsapp_message | url_encode | default: 'Hello%20team,%20I%20want%20to%20consult%20a%20bridal%20stylist' }}" target="_blank" rel="noopener" class="rd-btn rd-btn-emerald">
            {{ section.settings.hero_btn_secondary | default: "Consult Stylist on WhatsApp" }}
          </a>
        </div>

        <div class="rd-hero-stats">
          <div class="rd-stat">
            <span class="rd-stat-val">{{ section.settings.stat_1_val | default: "100%" }}</span>
            <span class="rd-stat-lbl">{{ section.settings.stat_1_lbl | default: "Pure Silk Mark Certified" }}</span>
          </div>
          <div class="rd-stat-divider"></div>
          <div class="rd-stat">
            <span class="rd-stat-val">{{ section.settings.stat_2_val | default: "450+" }}</span>
            <span class="rd-stat-lbl">{{ section.settings.stat_2_lbl | default: "Karigar Hours / Outfit" }}</span>
          </div>
          <div class="rd-stat-divider"></div>
          <div class="rd-stat">
            <span class="rd-stat-val">{{ section.settings.stat_3_val | default: "Global" }}</span>
            <span class="rd-stat-lbl">{{ section.settings.stat_3_lbl | default: "Insured Express Doorstep" }}</span>
          </div>
        </div>
      </div>

      <!-- Asymmetric Visual Collage -->
      <div class="rd-hero-collage">
        <div class="rd-visual-card rd-visual-primary">
          <img src="{{ section.settings.hero_img_primary | default: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?auto=format&fit=crop&w=1000&q=80' }}" alt="Royal Indian Bridal Dress" loading="eager">
          <div class="rd-card-caption">
            <span class="rd-caption-title">{{ section.settings.hero_card_title | default: "The Noor-e-Kashi Lehenga" }}</span>
            <span class="rd-caption-meta">{{ section.settings.hero_card_meta | default: "Hand-dyed Crimson • 24k Gold Thread" }}</span>
          </div>
        </div>

        <div class="rd-visual-card rd-visual-secondary">
          <img src="{{ section.settings.hero_img_secondary | default: 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=600&q=80' }}" alt="Banarasi Royal Handloom Saree" loading="eager">
        </div>

        <div class="rd-hero-stamp">
          <svg viewBox="0 0 100 100" class="rd-stamp-svg">
