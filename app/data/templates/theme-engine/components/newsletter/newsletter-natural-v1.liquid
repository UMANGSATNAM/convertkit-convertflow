{%- comment -%}
  Component: newsletter-natural-home-v1
  Family: Home | Style: natural
  Archetypes: cozy, artisanal
  v2.0 — StoreForge Component Library
{%- endcomment -%}
<section class="newsletter newsletter--home-decor" style="padding: var(--space-80) 0; background-color: var(--color-background); border-bottom: 1px solid var(--color-border); text-align: center;">
  <div class="container" style="max-width: 600px;">
    
    <div style="border: 1px solid var(--color-border); border-radius: var(--card-radius); box-shadow: var(--card-shadow); padding: var(--space-48) var(--space-32); background-color: var(--color-surface);">
      <h2 class="newsletter-heading" style="font-family: var(--font-heading-family); font-size: 2.4rem; font-weight: 500; margin: 0 0 var(--space-16) 0; color: var(--color-text);">
        {{ section.settings.heading | escape }}
      </h2>

      {%- if section.settings.subtext != blank -%}
        <div class="newsletter-subtext" style="font-family: var(--font-body-family); font-size: 0.95rem; line-height: 1.7; color: var(--color-text); margin-bottom: var(--space-32); opacity: 0.85;">
          {{ section.settings.subtext }}
        </div>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        <div class="newsletter-form-fields" style="display: flex; flex-direction: column; gap: var(--space-16); align-items: stretch; width: 100%;">
          <input type="email" 
                 name="contact[email]" 
                 class="newsletter-email-input" 
                 value="{{ form.email }}" 
                 placeholder="your.email@example.com" 
                 required 
                 aria-label="Email address"
                 style="width: 100%; padding: 14px 18px; border: 1px solid var(--color-border); background-color: var(--color-background); color: var(--color-text); font-family: var(--font-body-family); font-size: 0.95rem; border-radius: var(--button-radius); outline: none;">
          
          <button type="submit" class="button button--primary newsletter-submit-btn" style="padding: 14px 0; font-size: 0.95rem; border-radius: var(--button-radius);">
            Subscribe for Updates
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <p class="newsletter-success-msg" style="color: var(--color-sale-accent); font-size: 0.95rem; margin-top: var(--space-20); font-weight: 600;">
            Thank you for subscribing. We will keep in touch.
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <p class="newsletter-error-msg" style="color: var(--color-sale-accent); font-size: 0.95rem; margin-top: var(--space-20);">
            Error: {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join our Journal"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Sign up to receive design editorials, styling guides, and notifications of raw batch releases.</p>"
    }
  ]
}
{% endschema %}
