{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp46-news-bg: {{ section.settings.bg_color | default: '#0B0F19' }};
    
    background-color: var(--hp46-news-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp46-news__box {
    max-width: {{ section.settings.container_width | default: 760 }}px;
    margin: 0 auto;
    padding: 50px 40px;
    background: rgba(15, 23, 42, 0.7);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 28px;
    text-align: center;
    box-shadow: 0 0 40px rgba(56, 189, 248, 0.15);
  }

  .hp46-news__title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 12px;
  }

  .hp46-news__title span {
    background: linear-gradient(135deg, #38BDF8, #F472B6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp46-news__desc {
    font-size: 15px;
    line-height: 1.7;
    color: #94A3B8;
    margin: 0 0 32px;
  }

  .hp46-news__form {
    display: flex;
    gap: 12px;
    max-width: 500px;
    margin: 0 auto;
  }

  .hp46-news__input {
    flex: 1;
    padding: 15px 22px;
    background: rgba(11, 15, 25, 0.8);
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 50px;
    color: #FFFFFF;
    font-size: 14px;
    outline: none;
    font-family: 'Outfit', sans-serif;
  }

  .hp46-news__input:focus {
    border-color: #F472B6;
    box-shadow: 0 0 15px rgba(244, 114, 182, 0.4);
  }

  .hp46-news__btn {
    padding: 15px 32px;
    background: linear-gradient(135deg, #38BDF8, #F472B6);
    color: #0B0F19;
    border: none;
    border-radius: 50px;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 13px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp46-news__btn:hover {
    box-shadow: 0 0 30px rgba(56, 189, 248, 0.6);
  }

  @media screen and (max-width: 600px) {
    .hp46-news__box { padding: 36px 20px; }
    .hp46-news__form { flex-direction: column; }
  }
{%- endstyle -%}

<div class="hp46-news__box">
  <h2 class="hp46-news__title">JOIN THE <span>CYBER COLLECTIVE</span></h2>
  <p class="hp46-news__desc">{{ section.settings.description | default: 'Subscribe to access limited holographic drop release dates and receive an instant 15% VIP welcome code.' }}</p>
  <form class="hp46-news__form" onsubmit="event.preventDefault(); alert('Cyber VIP subscription confirmed!');">
    <input type="email" class="hp46-news__input" placeholder="{{ section.settings.placeholder | default: 'Enter your email address' }}" required>
    <button type="submit" class="hp46-news__btn">{{ section.settings.btn_text | default: 'SUBSCRIBE' }}</button>
  </form>
</div>

{% schema %}
{
  "name": "HP46 - Cyber News",
  "class": "section-hp46-news",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0B0F19" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Subscribe to access limited holographic drop release dates." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "SUBSCRIBE" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 500, "max": 1000, "step": 20, "unit": "px", "label": "Container Width", "default": 760 }
  ],
  "presets": [
    { "name": "HP46 - Cyber News" }
  ]
}
{% endschema %}
