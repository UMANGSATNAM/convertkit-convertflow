{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-primary: {{ section.settings.accent_primary }};
    --accent-secondary: {{ section.settings.accent_secondary }};
    --font-heading: 'Orbitron', sans-serif;
    --font-body: 'Share Tech Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp24-news-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp24-news-wrapper {
      padding: 0 20px;
    }
  }

  /* The Terminal Box */
  .hp24-news__terminal {
    background: #050505;
    border: 2px solid var(--accent-primary);
    box-shadow: 0 0 20px rgba(0, 243, 255, 0.2);
    position: relative;
    padding: 40px;
    max-width: 800px;
    margin: 0 auto;
  }

  @media screen and (max-width: 768px) {
    .hp24-news__terminal {
      padding: 30px 20px;
    }
  }

  /* Terminal Header */
  .hp24-news__terminal-header {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 30px;
    background: var(--accent-primary);
    display: flex;
    align-items: center;
    padding: 0 15px;
    color: var(--bg-color);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
  }

  .hp24-news__terminal-controls {
    margin-left: auto;
    display: flex;
    gap: 8px;
  }

  .hp24-news__terminal-controls span {
    width: 12px;
    height: 12px;
    background: var(--bg-color);
    border-radius: 50%;
  }

  .hp24-news__content {
    margin-top: 30px;
    text-align: left;
  }

  .hp24-news__sys-text {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--accent-secondary);
    margin-bottom: 20px;
    text-transform: uppercase;
  }
  
  .hp24-news__sys-text::before {
    content: '>';
    margin-right: 10px;
    animation: alertBlink 1s infinite;
  }

  .hp24-news__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 15px;
    text-transform: uppercase;
    text-shadow: 2px 2px 0 rgba(0, 243, 255, 0.2);
  }

  .hp24-news__text {
    font-family: var(--font-body);
    font-size: {{ section.settings.text_size }}px;
    color: var(--text-color);
    margin: 0 0 30px;
    opacity: 0.8;
  }

  .hp24-news__form {
    display: flex;
    position: relative;
    max-width: 600px;
  }

  @media screen and (max-width: 600px) {
    .hp24-news__form {
      flex-direction: column;
      gap: 15px;
    }
  }

  .hp24-news__input-group {
    display: flex;
    width: 100%;
    position: relative;
  }

  .hp24-news__input-group::before {
    content: 'C:\\>';
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-body);
    color: var(--accent-primary);
    font-size: 16px;
    pointer-events: none;
  }

  .hp24-news__input {
    width: 100%;
    padding: 15px 15px 15px 55px;
    background: transparent;
    border: 1px solid rgba(0, 243, 255, 0.5);
    color: var(--accent-primary);
    font-family: var(--font-body);
    font-size: 16px;
    outline: none;
    transition: all 0.3s ease;
  }

  .hp24-news__input:focus {
    border-color: var(--accent-primary);
    box-shadow: inset 0 0 10px rgba(0, 243, 255, 0.2);
  }

  .hp24-news__input::placeholder {
    color: rgba(0, 243, 255, 0.3);
  }

  .hp24-news__btn {
    padding: 15px 30px;
    background: var(--accent-primary);
    color: var(--bg-color);
    border: none;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  @media screen and (min-width: 601px) {
    .hp24-news__btn {
      margin-left: 10px;
    }
  }

  .hp24-news__btn:hover {
    background: var(--accent-secondary);
    color: var(--bg-color);
    box-shadow: 0 0 15px var(--accent-secondary);
  }

  .hp24-news__form-message {
    margin-top: 15px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--accent-primary);
  }
  
  .hp24-news__form-message--error {
    color: var(--accent-secondary);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp24-news-wrapper" id="HP24News-{{ section.id }}">
  <div class="hp24-news__terminal">
    <div class="hp24-news__terminal-header">
      SYSTEM_UPDATE.EXE
      <div class="hp24-news__terminal-controls">
        <span></span><span></span><span></span>
      </div>
    </div>
    
    <div class="hp24-news__content">
      <div class="hp24-news__sys-text">ESTABLISH SECURE CONNECTION</div>
      
      {%- if section.settings.title != blank -%}
        <h2 class="hp24-news__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="hp24-news__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- form 'customer', class: 'hp24-news__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        <div class="hp24-news__input-group">
          <input 
            type="email" 
            name="contact[email]" 
            class="hp24-news__input" 
            value="{{ form.email }}" 
            placeholder="INPUT_EMAIL_ADDRESS..."
            aria-label="Email address"
            required
          >
        </div>
        
        <button type="submit" class="hp24-news__btn">
          {{ section.settings.btn_text | default: 'EXECUTE' }}
        </button>

        {%- if form.posted_successfully? -%}
          <div class="hp24-news__form-message" tabindex="-1" autofocus>
            >>> CONNECTION ESTABLISHED. UPLINK SUCCESSFUL.
          </div>
        {%- elsif form.errors -%}
          <div class="hp24-news__form-message hp24-news__form-message--error" tabindex="-1" autofocus>
            >>> ERROR: {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP24 - Cyber Newsletter",
  "class": "section-hp24-newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "JOIN THE RESISTANCE"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body Text",
      "default": "<p>Input your coordinates to receive encrypted updates, hardware drops, and system overrides.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "EXECUTE"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Cyberpunk Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_primary",
      "label": "Accent Primary (Neon Blue)",
      "default": "#00F3FF"
    },
    {
      "type": "color",
      "id": "accent_secondary",
      "label": "Accent Secondary (Neon Pink)",
      "default": "#FF00E6"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP24 - Cyber Newsletter"
    }
  ]
}
{% endschema %}
