{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --box-bg: {{ section.settings.box_bg }};
    --text-color: {{ section.settings.text_color }};
    --font-heading: 'Cormorant Garamond', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp26-news-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp26-news-wrapper {
      padding: 0 20px;
    }
  }

  .hp26-news__container {
    background-color: var(--box-bg);
    border-radius: 4px; /* subtle softness */
    padding: 80px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    .hp26-news__container {
      padding: 60px 20px;
    }
  }

  /* Decorative organic shapes */
  .hp26-news__shape {
    position: absolute;
    width: 300px;
    height: 300px;
    background: var(--bg-color);
    opacity: 0.5;
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    z-index: 0;
    pointer-events: none;
  }

  .hp26-news__shape--1 {
    top: -100px;
    left: -100px;
    transform: rotate(30deg);
  }

  .hp26-news__shape--2 {
    bottom: -150px;
    right: -50px;
    transform: rotate(-15deg);
  }

  .hp26-news__content {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin: 0 auto;
  }

  .hp26-news__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 20px;
  }

  .hp26-news__title em {
    font-style: italic;
    font-weight: 300;
  }

  .hp26-news__text {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.5vw, {{ section.settings.text_size }}px);
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0 0 40px;
  }

  .hp26-news__form {
    display: flex;
    align-items: flex-end;
    border-bottom: 1px solid var(--text-color);
    padding-bottom: 10px;
  }

  .hp26-news__input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-color);
    padding: 10px 0;
  }

  .hp26-news__input::placeholder {
    color: var(--text-color);
    opacity: 0.5;
    letter-spacing: 0.05em;
  }

  .hp26-news__btn {
    background: transparent;
    border: none;
    color: var(--text-color);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 10px 0 10px 20px;
    transition: opacity 0.3s ease;
  }

  .hp26-news__btn:hover {
    opacity: 0.6;
  }

  .hp26-news__disclaimer {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--text-color);
    opacity: 0.5;
    margin-top: 20px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp26-news-wrapper" id="HP26News-{{ section.id }}">
  <div class="hp26-news__container">
    <div class="hp26-news__shape hp26-news__shape--1"></div>
    <div class="hp26-news__shape hp26-news__shape--2"></div>
    
    <div class="hp26-news__content">
      {%- if section.settings.title != blank -%}
        <h2 class="hp26-news__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="hp26-news__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- form 'customer', id: 'HP26NewsletterForm' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="hp26-news__form">
          <input 
            type="email" 
            name="contact[email]" 
            class="hp26-news__input" 
            placeholder="{{ section.settings.placeholder }}" 
            required
            aria-label="Email address"
          >
          <button type="submit" class="hp26-news__btn">{{ section.settings.btn_text }}</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p style="margin-top:20px;font-family:var(--font-body);font-size:14px;color:var(--text-color);">Thank you for subscribing.</p>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.disclaimer != blank -%}
        <div class="hp26-news__disclaimer">{{ section.settings.disclaimer }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP26 - Japandi Newsletter",
  "class": "section-hp26-newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Join our <em>inner circle</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Receive mindful notes on design, slow living, and early access to new collections.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SUBSCRIBE"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "By subscribing, you agree to our Terms of Service & Privacy Policy."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1000
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Japandi Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5F2EB"
    },
    {
      "type": "color",
      "id": "box_bg",
      "label": "Box Background",
      "default": "#EAE6DF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C2A28"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP26 - Japandi Newsletter"
    }
  ]
}
{% endschema %}
