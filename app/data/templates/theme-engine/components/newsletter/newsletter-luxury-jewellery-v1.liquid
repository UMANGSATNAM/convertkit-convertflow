{%- comment -%}
  Component: newsletter-luxury-jewellery-v1
  Family: Luxury | Style: luxury
  Archetypes: luxury, premium
  v2.0 — StoreForge Component Library
{%- endcomment -%}
<section class="newsletter newsletter--jewellery" style="padding: var(--space-64) 0; background-color: var(--color-background); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); text-align: center;">
  <div class="container" style="max-width: 600px;">
    
    <h2 class="newsletter-heading" style="font-family: var(--font-heading-family); font-size: 2.2rem; font-weight: 400; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: var(--space-12);">
      {{ section.settings.heading | escape }}
    </h2>

    {%- if section.settings.subtext != blank -%}
      <div class="newsletter-subtext" style="font-family: var(--font-body-family); font-size: 0.95rem; line-height: 1.6; color: #4a4944; margin-bottom: var(--space-24);">
        {{ section.settings.subtext }}
      </div>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      
      <div class="newsletter-form-fields" style="display: flex; flex-direction: column; gap: var(--space-12); align-items: stretch; width: 100%;">
        <div style="flex-grow: 1; position: relative;">
          <input type="email" 
                 name="contact[email]" 
                 class="newsletter-email-input" 
                 value="{{ form.email }}" 
                 placeholder="your.email@example.com" 
                 required 
                 aria-label="Email address"
                 style="width: 100%; padding: 12px 16px; border: 1px solid var(--color-border); background-color: var(--color-surface); color: var(--color-text); font-family: var(--font-body-family); font-size: 0.95rem; border-radius: var(--button-radius); transition: border-color var(--transition-fast);">
        </div>
        
        <button type="submit" class="button button--primary newsletter-submit-btn" style="letter-spacing: 0.15em; font-size: 0.85rem; padding: 12px 32px;">
          Subscribe
        </button>
      </div>

      {%- if form.posted_successfully? -%}
        <p class="newsletter-success-msg" style="color: var(--color-accent); font-size: 0.9rem; margin-top: var(--space-16); font-weight: 500;">
          Thank you for joining our private circle.
        </p>
      {%- endif -%}

      {%- if form.errors -%}
        <p class="newsletter-error-msg" style="color: var(--color-sale-accent); font-size: 0.9rem; margin-top: var(--space-16);">
          {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
        </p>
      {%- endif -%}
    {%- endform -%}

  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Private Circle"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Subscribe to receive early notifications of exclusive private drops, boutique launches, and limited collections.</p>"
    }
  ]
}
{% endschema %}
