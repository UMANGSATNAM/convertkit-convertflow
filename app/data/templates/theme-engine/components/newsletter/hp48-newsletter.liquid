{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp48-news-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
    --hp48-gold: {{ section.settings.accent_gold | default: '#C59B27' }};
    
    background-color: var(--hp48-news-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp48-news__box {
    max-width: {{ section.settings.container_width | default: 760 }}px;
    margin: 0 auto;
    padding: 50px 40px;
    background: #FFFFFF;
    border: 1px solid rgba(197, 155, 39, 0.35);
    border-radius: 8px;
    text-align: center;
    box-shadow: 0 15px 40px rgba(197, 155, 39, 0.1);
  }

  .hp48-news__title {
    font-family: 'Cinzel', serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    color: #1A1715;
    margin: 0 0 12px;
  }

  .hp48-news__desc {
    font-size: 14px;
    line-height: 1.8;
    color: #5C554E;
    margin: 0 0 32px;
  }

  .hp48-news__form {
    display: flex;
    gap: 12px;
    max-width: 500px;
    margin: 0 auto;
  }

  .hp48-news__input {
    flex: 1;
    padding: 15px 20px;
    background: #FAF8F5;
    border: 1px solid rgba(197, 155, 39, 0.35);
    border-radius: 4px;
    color: #1A1715;
    font-size: 13px;
    outline: none;
    font-family: 'Montserrat', sans-serif;
  }

  .hp48-news__input:focus { border-color: var(--hp48-gold); }

  .hp48-news__btn {
    padding: 15px 32px;
    background: #1A1715;
    color: var(--hp48-gold);
    border: 1px solid var(--hp48-gold);
    border-radius: 4px;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp48-news__btn:hover { background: var(--hp48-gold); color: #1A1715; }

  @media screen and (max-width: 600px) {
    .hp48-news__box { padding: 36px 20px; }
    .hp48-news__form { flex-direction: column; }
  }
{%- endstyle -%}

<div class="hp48-news__box">
  <h2 class="hp48-news__title">{{ section.settings.heading | default: 'The Sovereign Registry' }}</h2>
  <p class="hp48-news__desc">{{ section.settings.description | default: 'Receive private invitations to confidential gold batch harvests and an immediate 15% VIP welcome voucher.' }}</p>
  <form class="hp48-news__form" onsubmit="event.preventDefault(); alert('Subscribed to The Sovereign Registry.');">
    <input type="email" class="hp48-news__input" placeholder="{{ section.settings.placeholder | default: 'Enter your email address' }}" required>
    <button type="submit" class="hp48-news__btn">{{ section.settings.btn_text | default: 'Subscribe' }}</button>
  </form>
</div>

{% schema %}
{
  "name": "HP48 - Royal News",
  "class": "section-hp48-news",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF8F5" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#C59B27" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Sovereign Registry" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Receive private invitations to confidential gold batch harvests." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Subscribe" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 500, "max": 1000, "step": 20, "unit": "px", "label": "Container Width", "default": 760 }
  ],
  "presets": [
    { "name": "HP48 - Royal News" }
  ]
}
{% endschema %}
