{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  /* Soft organic shape in background */
  .hp29-nl__bg-blob {
    position: absolute;
    bottom: -50px; left: -50px;
    width: 300px; height: 300px;
    background-color: var(--accent-color);
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    opacity: 0.1;
    z-index: 0;
    pointer-events: none;
    animation: hp29NLBlob 15s ease-in-out infinite alternate;
  }
  
  @keyframes hp29NLBlob {
    0% { transform: scale(1) rotate(0deg); }
    100% { transform: scale(1.2) rotate(45deg); }
  }

  .hp29-nl-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .hp29-nl-wrapper {
      padding: 0 20px;
    }
  }

  .hp29-nl__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    line-height: 1.2;
    color: var(--text-color);
    margin: 0 0 15px;
  }

  .hp29-nl__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp29-nl__text {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0 0 40px;
    max-width: 500px;
  }

  .hp29-nl__form-wrap {
    width: 100%;
    max-width: 500px;
  }

  .hp29-nl__form {
    display: flex;
    position: relative;
    border-bottom: 1px solid rgba(0,0,0,0.2);
    transition: border-color 0.3s ease;
  }

  .hp29-nl__form:focus-within {
    border-color: var(--text-color);
  }

  .hp29-nl__input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 15px 0;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 300;
    color: var(--text-color);
    outline: none;
  }

  .hp29-nl__input::placeholder {
    color: var(--text-color);
    opacity: 0.5;
  }

  .hp29-nl__btn {
    background: transparent;
    border: none;
    padding: 0 10px;
    color: var(--text-color);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .hp29-nl__btn svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .hp29-nl__btn:hover {
    transform: translateX(5px);
    color: var(--accent-color);
  }

  .hp29-nl__message {
    margin-top: 20px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .hp29-nl__message--success {
    color: var(--accent-color);
  }

  .hp29-nl__message--error {
    color: #cc0000;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp29-nl-wrapper" id="HP29Newsletter-{{ section.id }}">
  <div class="hp29-nl__bg-blob"></div>

  {%- if section.settings.title != blank -%}
    <h2 class="hp29-nl__title">{{ section.settings.title }}</h2>
  {%- endif -%}

  {%- if section.settings.text != blank -%}
    <div class="hp29-nl__text">{{ section.settings.text }}</div>
  {%- endif -%}

  <div class="hp29-nl__form-wrap">
    {%- form 'customer', class: 'hp29-nl__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      
      <input 
        type="email" 
        name="contact[email]" 
        class="hp29-nl__input"
        placeholder="{{ section.settings.placeholder }}" 
        required
        aria-label="Email address"
      >
      
      <button type="submit" class="hp29-nl__btn" aria-label="Subscribe">
        <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>

      {%- if form.posted_successfully? -%}
        <div class="hp29-nl__message hp29-nl__message--success">Thank you for joining our journal.</div>
      {%- elsif form.errors -%}
        <div class="hp29-nl__message hp29-nl__message--error">Please check your email address and try again.</div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "HP29 - Boho Newsletter",
  "class": "section-hp29-newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Join our <em>Journal</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sign up to receive mindful notes, early access to new pieces, and a softer approach to inbox inspiration.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 800
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Earthy Boho Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Sage Green)",
      "default": "#81B29A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Beige)",
      "default": "#F4F1DE"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (Terracotta)",
      "default": "#E07A5F"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP29 - Boho Newsletter"
    }
  ]
}
{% endschema %}
