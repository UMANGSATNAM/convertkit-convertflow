{%- style -%}
  #shopify-section-{{ section.id }} {
    background: radial-gradient(circle at 50% 50%, #064E3B 0%, #0F172A 100%);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp62-news__container { max-width: {{ section.settings.container_width | default: 700 }}px; margin: 0 auto; padding: 0 24px; text-align: center; }
  .hp62-news__eyebrow { font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #A7F3D0; margin: 0 0 16px; }
  .hp62-news__heading { font-family: 'Italiana', serif; font-size: clamp(28px, 4vw, 44px); font-weight: 700; color: #FFFFFF; margin: 0 0 16px; }
  .hp62-news__desc { font-size: 15px; line-height: 1.7; color: #E2E8F0; margin: 0 0 32px; }
  .hp62-news__form { display: flex; gap: 12px; max-width: 480px; margin: 0 auto; }
  .hp62-news__input {
    flex: 1; padding: 15px 22px; background: #FFFFFF; border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50px; color: #064E3B; font-family: 'Outfit', sans-serif; font-size: 14px;
  }
  .hp62-news__input::placeholder { color: #94A3B8; }
  .hp62-news__btn {
    padding: 15px 32px; background: {{ section.settings.btn_bg | default: '#10B981' }};
    color: #064E3B; border: none; border-radius: 50px; font-family: 'Outfit', sans-serif;
    font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    cursor: pointer; transition: all 0.3s ease; box-shadow: 0 8px 25px rgba(16, 185, 129, 0.3);
  }
  .hp62-news__btn:hover { transform: translateY(-2px); box-shadow: 0 12px 35px rgba(16, 185, 129, 0.5); }
  @media screen and (max-width: 480px) { .hp62-news__form { flex-direction: column; } }
{%- endstyle -%}
<div class="hp62-news__container">
  {%- if section.settings.eyebrow != blank -%}<p class="hp62-news__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  <h2 class="hp62-news__heading">{{ section.settings.heading | default: 'Alpine Sanctuary Circle' }}</h2>
  <p class="hp62-news__desc">{{ section.settings.description | default: 'Join our Swiss Alpine circle for seasonal harvest invitations, high-altitude botanical insights, and private laboratory access.' }}</p>
  {%- form 'customer', id: 'hp62-newsletter' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="hp62-news__form">
      <input type="email" name="contact[email]" class="hp62-news__input" placeholder="{{ section.settings.placeholder | default: 'Your email address' }}" required>
      <button type="submit" class="hp62-news__btn">{{ section.settings.btn_label | default: 'Join Circle' }}</button>
    </div>
  {%- endform -%}
</div>
{% schema %}
{
  "name": "HP62 Newsletter",
  "class": "section-hp62-news",
  "settings": [
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#10B981" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🏔️ ALPINE SANCTUARY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Alpine Sanctuary Circle" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Join our Swiss Alpine circle for seasonal harvest invitations." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Your email address" },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Join Circle" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 500, "max": 900, "step": 20, "unit": "px", "label": "Container Width", "default": 700 }
  ],
  "presets": [{ "name": "HP62 Newsletter" }]
}
{% endschema %}
