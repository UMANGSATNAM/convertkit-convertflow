{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --gold-color: {{ section.settings.gold_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Montserrat', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp33-news-wrapper {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp33-news-wrapper {
      padding: 0 20px;
    }
  }

  .hp33-news__container {
    background: var(--bg-color);
    border: 1px solid var(--gold-color);
    padding: 80px 40px;
    text-align: center;
    position: relative;
  }

  /* Inner thin line */
  .hp33-news__container::after {
    content: '';
    position: absolute;
    top: 6px; left: 6px; right: 6px; bottom: 6px;
    border: 1px solid rgba(212, 175, 55, 0.3);
    pointer-events: none;
  }

  /* Corner accents */
  .hp33-news__corner {
    position: absolute;
    width: 30px; height: 30px;
    border: 2px solid var(--gold-color);
    z-index: 2;
    background: var(--bg-color);
  }

  .hp33-news__corner--tl { top: -2px; left: -2px; border-right: none; border-bottom: none; }
  .hp33-news__corner--tr { top: -2px; right: -2px; border-left: none; border-bottom: none; }
  .hp33-news__corner--bl { bottom: -2px; left: -2px; border-right: none; border-top: none; }
  .hp33-news__corner--br { bottom: -2px; right: -2px; border-left: none; border-top: none; }

  .hp33-news__subtitle {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--gold-color);
    text-transform: uppercase;
    letter-spacing: 4px;
    margin-bottom: 20px;
    display: inline-block;
  }

  .hp33-news__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 20px;
    font-weight: 400;
  }

  .hp33-news__text {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    margin: 0 0 40px;
    font-weight: 300;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
    opacity: 0.8;
  }

  .hp33-news__form {
    max-width: 450px;
    margin: 0 auto;
    position: relative;
    z-index: 3; /* above the inner border */
  }

  .hp33-news__input-group {
    display: flex;
    border-bottom: 1px solid var(--gold-color);
    padding-bottom: 10px;
  }

  .hp33-news__input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 10px 0;
    color: var(--text-color);
    font-family: var(--font-body);
    font-size: 16px;
    outline: none;
  }

  .hp33-news__input::placeholder {
    color: var(--text-color);
    opacity: 0.5;
    text-transform: uppercase;
    font-size: 13px;
    letter-spacing: 2px;
  }

  .hp33-news__submit {
    background: transparent;
    border: none;
    color: var(--gold-color);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 10px 20px;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .hp33-news__submit:hover {
    color: #fff;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp33-news-wrapper" id="HP33News-{{ section.id }}">
  <div class="hp33-news__container">
    <div class="hp33-news__corner hp33-news__corner--tl"></div>
    <div class="hp33-news__corner hp33-news__corner--tr"></div>
    <div class="hp33-news__corner hp33-news__corner--bl"></div>
    <div class="hp33-news__corner hp33-news__corner--br"></div>

    {%- if section.settings.subtitle != blank -%}
      <div class="hp33-news__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    
    <h2 class="hp33-news__title">{{ section.settings.title }}</h2>
    
    <p class="hp33-news__text">{{ section.settings.text }}</p>
    
    <div class="hp33-news__form">
      {% form 'customer', class: 'hp33-news__form-inner' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="hp33-news__input-group">
          <input type="email"
            name="contact[email]"
            id="Email-{{ section.id }}"
            class="hp33-news__input"
            value="{% if customer %}{{ customer.email }}{% endif %}"
            placeholder="{{ section.settings.placeholder }}"
            autocorrect="off"
            autocapitalize="off"
            required>
          <button type="submit" class="hp33-news__submit">
            {{ section.settings.btn_text }}
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <p style="margin-top:20px; color:var(--gold-color); font-family:var(--font-body); font-size:14px;">Welcome to the Inner Circle.</p>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP33 - Deco Newsletter",
  "class": "section-hp33-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE INNER CIRCLE"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Join the Registry"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Subscribe to receive private invitations to exclusive events and early access to new collections."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "YOUR EMAIL ADDRESS"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SUBMIT"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Deco Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Deep Emerald)",
      "default": "#0e1a14"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold Accent",
      "default": "#d4af37"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP33 - Deco Newsletter"
    }
  ]
}
{% endschema %}
