{%- style -%}
  #shopify-section-{{ section.id }} {
    background: radial-gradient(circle at 50% 50%, #FEF3C7 0%, #FDE68A 100%);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    border-top: 1px solid rgba(249, 115, 22, 0.2);
  }
  .hp59-news__container { max-width: {{ section.settings.container_width | default: 700 }}px; margin: 0 auto; padding: 0 24px; text-align: center; }
  .hp59-news__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #F97316; margin: 0 0 16px; }
  .hp59-news__heading { font-family: 'Cormorant Garamond', serif; font-size: clamp(28px, 4vw, 44px); font-weight: 700; color: #042F2E; margin: 0 0 16px; }
  .hp59-news__desc { font-size: 15px; line-height: 1.7; color: #475569; margin: 0 0 32px; }
  .hp59-news__form { display: flex; gap: 12px; max-width: 480px; margin: 0 auto; }
  .hp59-news__input {
    flex: 1; padding: 15px 22px; background: #FFFFFF; border: 1px solid rgba(249, 115, 22, 0.3);
    border-radius: 50px; color: #042F2E; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px;
  }
  .hp59-news__input::placeholder { color: rgba(71, 85, 105, 0.6); }
  .hp59-news__btn {
    padding: 15px 32px; background: {{ section.settings.btn_bg | default: '#F97316' }};
    color: #FFFFFF; border: none; border-radius: 50px; font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.3s ease;
    box-shadow: 0 6px 20px rgba(249, 115, 22, 0.35);
  }
  .hp59-news__btn:hover { box-shadow: 0 10px 30px rgba(249, 115, 22, 0.55); transform: translateY(-2px); }
  @media screen and (max-width: 480px) { .hp59-news__form { flex-direction: column; } }
{%- endstyle -%}
<div class="hp59-news__container">
  {%- if section.settings.eyebrow != blank -%}<p class="hp59-news__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  <h2 class="hp59-news__heading">{{ section.settings.heading | default: 'The Marine Radiance Journal' }}</h2>
  <p class="hp59-news__desc">{{ section.settings.description | default: 'Receive oceanic ingredient discoveries, golden hour photoprotection guides, and exclusive small-batch coral pressings.' }}</p>
  {%- form 'customer', id: 'hp59-newsletter' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="hp59-news__form">
      <input type="email" name="contact[email]" class="hp59-news__input" placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}" required>
      <button type="submit" class="hp59-news__btn">{{ section.settings.btn_label | default: 'Subscribe' }}</button>
    </div>
  {%- endform -%}
</div>
{% schema %}
{
  "name": "HP59 Newsletter",
  "class": "section-hp59-news",
  "settings": [
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#F97316" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🪸 MARINE JOURNAL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Marine Radiance Journal" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Receive oceanic ingredient discoveries and golden hour photoprotection guides." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Enter your email" },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Subscribe" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 500, "max": 900, "step": 20, "unit": "px", "label": "Container Width", "default": 700 }
  ],
  "presets": [{ "name": "HP59 Newsletter" }]
}
{% endschema %}
