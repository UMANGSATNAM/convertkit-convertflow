{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,700&family=Inter:wght@300;400&display=swap');

  #shopify-section-{{ section.id }} {
    --bg: {{ section.settings.bg_color }};
    --text: {{ section.settings.text_color }};
    --gold: {{ section.settings.accent_color }};
    --serif: 'Playfair Display', serif;
    --sans: 'Inter', sans-serif;
    background: var(--bg);
    padding: 120px 20px;
  }

  .hp42-news {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .hp42-news__line { width: 40px; height: 1px; background: var(--gold); margin: 0 auto 40px; }

  .hp42-news__title {
    font-family: var(--serif);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    font-style: italic;
    color: var(--text);
    margin: 0 0 15px;
  }

  .hp42-news__text {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 300;
    color: var(--text);
    opacity: 0.6;
    margin: 0 0 40px;
  }

  .hp42-news__form {
    display: flex;
    border-bottom: 1px solid var(--gold);
    max-width: 400px;
    margin: 0 auto;
  }

  .hp42-news__input {
    flex: 1;
    padding: 15px 0;
    border: none;
    background: transparent;
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 300;
    color: var(--text);
    outline: none;
  }
  .hp42-news__input::placeholder { color: rgba(245,240,235,0.3); }

  .hp42-news__btn {
    padding: 15px 0;
    background: none;
    border: none;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    cursor: pointer;
    transition: opacity 0.3s;
  }
  .hp42-news__btn:hover { opacity: 0.6; }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp42-news" id="HP42News-{{ section.id }}">
  <div class="hp42-news__line"></div>
  <h2 class="hp42-news__title">{{ section.settings.title }}</h2>
  {%- if section.settings.text != blank -%}
    <p class="hp42-news__text">{{ section.settings.text }}</p>
  {%- endif -%}

  {%- form 'customer', class: 'hp42-news__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email" name="contact[email]" class="hp42-news__input" placeholder="{{ section.settings.placeholder }}" required>
    <button type="submit" class="hp42-news__btn">{{ section.settings.btn_label }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "HP42 - Noir Newsletter",
  "class": "section-hp42-newsletter",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "The Inner Circle" },
    { "type": "text", "id": "text", "label": "Text", "default": "Exclusive access to new collections and private events." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Your email address" },
    { "type": "text", "id": "btn_label", "label": "Button", "default": "Join" },
    { "type": "range", "id": "title_size", "min": 24, "max": 80, "step": 2, "unit": "px", "label": "Title Size", "default": 48 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A0A0A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F0EB" },
    { "type": "color", "id": "accent_color", "label": "Gold", "default": "#C9A96E" },
    { "type": "html", "id": "custom_css", "label": "Custom CSS" }
  ],
  "presets": [{ "name": "HP42 - Noir Newsletter" }]
}
{% endschema %}
