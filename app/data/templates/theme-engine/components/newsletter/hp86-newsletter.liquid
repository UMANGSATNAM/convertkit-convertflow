{%- style -%}#shopify-section-{{ section.id }}{background:#ECFEFF;padding:50px 24px;text-align:center}.hp86-nl{max-width:520px;margin:0 auto}.hp86-nl input{flex:1;padding:12px;border:1px solid rgba(0,0,0,.15);border-radius:8px}.hp86-nl button{padding:12px 20px;background:#06B6D4;color:#fff;border:none;border-radius:8px;font-weight:700}{%- endstyle -%}<div class="hp86-nl"><h2 style="font-size:24px;font-weight:800;margin:0">{{section.settings.heading|default:'Join ACTIVEWEAR'}}</h2><p style="opacity:.6">{{section.settings.sub|default:'Get 10% off'}}</p><form method="post" action="/contact#contact_form" style="display:flex;gap:8px;margin-top:12px"><input type="email" name="contact[email]" placeholder="you@email.com" required><button type="submit">{{section.settings.btn|default:'Subscribe'}}</button></form></div>{% schema %}{"name":"HP86 Newsletter","settings":[{"type":"text","id":"heading","label":"Heading","default":"Join ACTIVEWEAR"},{"type":"text","id":"sub","label":"Sub","default":"Get 10% off"},{"type":"text","id":"btn","label":"Btn","default":"Subscribe"}],"presets":[{"name":"HP86 Newsletter"}]}{% endschema %}