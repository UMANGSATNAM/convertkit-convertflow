{%- style -%}
  #shopify-section-{{ section.id }} {
    background: radial-gradient(circle at 50% 50%, #083344 0%, #030712 100%);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    border-top: 1px solid rgba(6, 182, 212, 0.3);
  }
  .hp64-news__container { max-width: {{ section.settings.container_width | default: 700 }}px; margin: 0 auto; padding: 0 24px; text-align: center; }
  .hp64-news__eyebrow { font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #10B981; margin: 0 0 16px; }
  .hp64-news__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 4vw, 44px); font-weight: 800; color: #FFFFFF; margin: 0 0 16px; }
  .hp64-news__desc { font-size: 15px; line-height: 1.7; color: #94A3B8; margin: 0 0 32px; font-family: 'Space Grotesk', sans-serif; }
  .hp64-news__form { display: flex; gap: 12px; max-width: 480px; margin: 0 auto; }
  .hp64-news__input {
    flex: 1; padding: 15px 22px; background: #090D16; border: 1px solid rgba(6, 182, 212, 0.4);
    border-radius: 4px; color: #FFFFFF; font-family: 'Space Grotesk', sans-serif; font-size: 14px;
  }
  .hp64-news__input::placeholder { color: rgba(148, 163, 184, 0.6); }
  .hp64-news__btn {
    padding: 15px 32px; background: {{ section.settings.btn_bg | default: '#06B6D4' }};
    color: #030712; border: none; border-radius: 4px; font-family: 'Space Grotesk', sans-serif;
    font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    cursor: pointer; transition: all 0.3s ease; box-shadow: 0 0 25px rgba(6, 182, 212, 0.4);
  }
  .hp64-news__btn:hover { box-shadow: 0 0 40px rgba(6, 182, 212, 0.7); transform: translateY(-2px); }
  @media screen and (max-width: 480px) { .hp64-news__form { flex-direction: column; } }
{%- endstyle -%}
<div class="hp64-news__container">
  {%- if section.settings.eyebrow != blank -%}<p class="hp64-news__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  <h2 class="hp64-news__heading">{{ section.settings.heading | default: 'The Abyssal Lab Protocol' }}</h2>
  <p class="hp64-news__desc">{{ section.settings.description | default: 'Subscribe for early access to deep spectrum batch syntheses, marine bio-reactor releases, and private research briefings.' }}</p>
  {%- form 'customer', id: 'hp64-newsletter' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="hp64-news__form">
      <input type="email" name="contact[email]" class="hp64-news__input" placeholder="{{ section.settings.placeholder | default: 'Your email address' }}" required>
      <button type="submit" class="hp64-news__btn">{{ section.settings.btn_label | default: 'Join Protocol' }}</button>
    </div>
  {%- endform -%}
</div>
{% schema %}
{
  "name": "HP64 Newsletter",
  "class": "section-hp64-news",
  "settings": [
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#06B6D4" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🧬 ABYSSAL PROTOCOL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Abyssal Lab Protocol" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Subscribe for early access to deep spectrum batch syntheses." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Your email address" },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Join Protocol" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 500, "max": 900, "step": 20, "unit": "px", "label": "Container Width", "default": 700 }
  ],
  "presets": [{ "name": "HP64 Newsletter" }]
}
{% endschema %}
