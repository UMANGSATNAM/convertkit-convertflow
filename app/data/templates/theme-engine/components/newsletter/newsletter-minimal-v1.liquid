{%- comment -%}
  Component: newsletter-minimal-beauty-v1
  Family: Beauty | Style: minimal
  Archetypes: premium, organic, minimal
  v2.0 — StoreForge Component Library
{%- endcomment -%}
<section class="newsletter newsletter--beauty" style="padding: var(--space-64) 0; background-color: var(--color-background); border-bottom: 1px solid var(--color-border); text-align: center;">
  <div class="container" style="max-width: 600px;">
    
    <div style="border: 1px solid var(--color-border); border-radius: var(--card-radius); box-shadow: var(--card-shadow); padding: var(--space-40) var(--space-24); background-color: #fff;">
      <h2 class="newsletter-heading" style="font-family: var(--font-heading-family); font-size: 2.2rem; font-weight: 600; margin: 0 0 var(--space-12) 0; color: var(--color-text);">
        {{ section.settings.heading | escape }}
      </h2>

      {%- if section.settings.subtext != blank -%}
        <div class="newsletter-subtext" style="font-family: var(--font-body-family); font-size: 0.95rem; line-height: 1.6; color: #5a5450; margin-bottom: var(--space-24);">
          {{ section.settings.subtext }}
        </div>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        <div class="newsletter-form-fields" style="display: flex; flex-direction: column; gap: var(--space-12); align-items: stretch; width: 100%;">
          <input type="email" 
                 name="contact[email]" 
                 class="newsletter-email-input" 
                 value="{{ form.email }}" 
                 placeholder="your.email@example.com" 
                 required 
                 aria-label="Email address"
                 style="width: 100%; padding: 12px 16px; border: 1px solid var(--color-border); background-color: var(--color-surface); color: var(--color-text); font-family: var(--font-body-family); font-size: 0.95rem; border-radius: var(--button-radius); outline: none;">
          
          <button type="submit" class="button button--primary newsletter-submit-btn" style="padding: 12px 0; font-size: 0.9rem; border-radius: var(--button-radius);">
            Join the List
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <p class="newsletter-success-msg" style="color: var(--color-accent); font-size: 0.9rem; margin-top: var(--space-16); font-weight: 500;">
            Thank you for subscribing. We will keep in touch.
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <p class="newsletter-error-msg" style="color: var(--color-sale-accent); font-size: 0.9rem; margin-top: var(--space-16);">
            Error: {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Unlock 10% Off Your First Order"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Sign up to receive clean personal care guides, skin wellness tips, and notifications of limited fresh batches.</p>"
    }
  ]
}
{% endschema %}
