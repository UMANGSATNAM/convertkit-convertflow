{%- liquid
  assign bg_color = section.settings.bg_color | default: '#2c2c2c'
  assign text_color = section.settings.text_color | default: '#f9f6f0'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp4-nl-bg: {{ bg_color }};
    --hp4-nl-text: {{ text_color }};
    
    --hp4-nl-pt-desk: {{ padding_top_desktop }}px;
    --hp4-nl-pb-desk: {{ padding_bottom_desktop }}px;
    --hp4-nl-pt-mob: {{ padding_top_mobile }}px;
    --hp4-nl-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp4-decor-nl-{{ section.id }} {
    padding-top: var(--hp4-nl-pt-desk);
    padding-bottom: var(--hp4-nl-pb-desk);
    background-color: var(--hp4-nl-bg);
    color: var(--hp4-nl-text);
    font-family: 'Inter', sans-serif;
  }

  .hp4-nl-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
  }

  /* Reversed Layout */
  .hp4-nl-inner.layout-right {
    flex-direction: row-reverse;
  }

  .hp4-nl-content {
    flex: 1;
    max-width: 500px;
  }

  .hp4-nl-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 400;
    margin: 0 0 20px 0;
    line-height: 1.1;
  }
  .hp4-nl-title em { font-style: italic; }

  .hp4-nl-desc {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(249,246,240,0.8);
    margin-bottom: 40px;
    font-weight: 300;
  }

  /* Form */
  .hp4-nl-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .hp4-nl-input-group {
    display: flex;
    border-bottom: 1px solid rgba(249,246,240,0.3);
    padding-bottom: 10px;
    transition: border-color 0.3s ease;
  }
  .hp4-nl-input-group:focus-within {
    border-color: var(--hp4-nl-text);
  }

  .hp4-nl-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--hp4-nl-text);
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    outline: none;
    padding: 5px 0;
  }
  .hp4-nl-input::placeholder {
    color: rgba(249,246,240,0.4);
  }

  .hp4-nl-submit {
    background: transparent;
    border: none;
    color: var(--hp4-nl-text);
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    padding: 5px 10px;
    transition: opacity 0.3s ease;
  }
  .hp4-nl-submit:hover {
    opacity: 0.7;
  }

  /* Image */
  .hp4-nl-media {
    flex: 1;
    position: relative;
    max-width: 500px;
  }
  
  .hp4-nl-img-wrap {
    width: 100%;
    aspect-ratio: 4/5;
    background: #e8e3d8;
    border-radius: 200px 200px 0 0; /* Arch */
    overflow: hidden;
  }
  
  .hp4-nl-img {
    width: 100%; height: 100%; object-fit: cover;
  }

  @media screen and (max-width: 900px) {
    .hp4-nl-inner {
      flex-direction: column !important;
      text-align: center;
      gap: 50px;
    }
    .hp4-nl-content, .hp4-nl-media {
      max-width: 100%;
    }
    .hp4-nl-img-wrap {
      max-width: 400px;
      margin: 0 auto;
    }
  }

  @media screen and (max-width: 768px) {
    .hp4-decor-nl-{{ section.id }} {
      padding-top: var(--hp4-nl-pt-mob);
      padding-bottom: var(--hp4-nl-pb-mob);
    }
    .hp4-nl-inner {
      padding: 0 20px;
    }
    .hp4-nl-title {
      font-size: 32px;
    }
  }
</style>

<section class="hp4-decor-nl-{{ section.id }}" aria-label="Newsletter">
  <div class="hp4-nl-inner layout-{{ section.settings.layout }}">
    
    <div class="hp4-nl-content">
      <h2 class="hp4-nl-title">{{ section.settings.heading | default: 'Join our <em>Journal</em>' }}</h2>
      <p class="hp4-nl-desc">{{ section.settings.description | default: 'Subscribe to receive early access to new collections, design inspiration, and exclusive offers.' }}</p>
      
      {%- form 'customer', class: 'hp4-nl-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="hp4-nl-input-group">
          <input type="email"
                 name="contact[email]"
                 class="hp4-nl-input"
                 value="{{ form.email }}"
                 placeholder="Your email address"
                 required>
          <button type="submit" class="hp4-nl-submit">Subscribe</button>
        </div>
        {%- if form.posted_successfully? -%}
          <div style="color: #4CAF50; font-size: 14px; margin-top: 10px;">Welcome to the studio.</div>
        {%- endif -%}
        {%- if form.errors -%}
          <div style="color: #f44336; font-size: 14px; margin-top: 10px;">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</div>
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="hp4-nl-media">
      <div class="hp4-nl-img-wrap">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" class="hp4-nl-img" loading="lazy" alt="Newsletter">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hp4-nl-img placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP4 Decor Newsletter",
  "tag": "section",
  "class": "section-hp4-newsletter",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Join our <em>Journal</em>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Subscribe to receive early access to new collections, design inspiration, and exclusive offers."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#2c2c2c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f9f6f0"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP4 Decor Newsletter",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
