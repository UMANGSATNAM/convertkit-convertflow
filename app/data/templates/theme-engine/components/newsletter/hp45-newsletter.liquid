{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp45-news-bg: {{ section.settings.bg_color | default: '#F5F5F0' }};
    --hp45-border: {{ section.settings.border_color | default: '#0A0A0A' }};
    
    background-color: var(--hp45-news-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp45-news__box {
    max-width: {{ section.settings.container_width | default: 760 }}px;
    margin: 0 auto;
    padding: 50px 40px;
    background: #FFFFFF;
    border: 2px solid var(--hp45-border);
    box-shadow: 6px 6px 0 var(--hp45-border);
    text-align: center;
  }

  .hp45-news__tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    background: #0A0A0A;
    color: #FFFFFF;
    padding: 4px 10px;
    display: inline-block;
    margin-bottom: 20px;
  }

  .hp45-news__title {
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 700;
    text-transform: uppercase;
    color: #0A0A0A;
    margin: 0 0 12px;
  }

  .hp45-news__desc {
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    line-height: 1.65;
    color: #4A4A4A;
    margin: 0 0 30px;
  }

  .hp45-news__form {
    display: flex;
    gap: 12px;
    max-width: 520px;
    margin: 0 auto;
  }

  .hp45-news__input {
    flex: 1;
    padding: 14px 18px;
    border: 2px solid var(--hp45-border);
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    outline: none;
    background: #FAFAFA;
  }

  .hp45-news__input:focus { background: #FFFFFF; }

  .hp45-news__btn {
    padding: 14px 28px;
    background: #0A0A0A;
    color: #FFFFFF;
    border: 2px solid #0A0A0A;
    box-shadow: 3px 3px 0 #0A0A0A;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hp45-news__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 #0A0A0A;
  }

  @media screen and (max-width: 600px) {
    .hp45-news__box { padding: 30px 20px; }
    .hp45-news__form { flex-direction: column; }
  }
{%- endstyle -%}

<div class="hp45-news__box">
  <span class="hp45-news__tag">[BATCH TELEMETRY DISPATCH]</span>
  <h2 class="hp45-news__title">{{ section.settings.heading | default: 'ACCESS SYSTEM DISPATCH' }}</h2>
  <p class="hp45-news__desc">{{ section.settings.description | default: 'Receive batch release notifications and formulation spec dossiers directly to your terminal.' }}</p>
  <form class="hp45-news__form" onsubmit="event.preventDefault(); alert('Terminal subscription verified.');">
    <input type="email" class="hp45-news__input" placeholder="{{ section.settings.placeholder | default: 'TERMINAL_EMAIL@DOMAIN.COM' }}" required>
    <button type="submit" class="hp45-news__btn">{{ section.settings.btn_text | default: 'ENROLL [→]' }}</button>
  </form>
</div>

{% schema %}
{
  "name": "HP45 - Brutal News",
  "class": "section-hp45-news",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F5F0" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#0A0A0A" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "ACCESS SYSTEM DISPATCH" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Receive batch release notifications and formulation spec dossiers directly to your terminal." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "TERMINAL_EMAIL@DOMAIN.COM" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "ENROLL [→]" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 500, "max": 1000, "step": 20, "unit": "px", "label": "Container Width", "default": 760 }
  ],
  "presets": [
    { "name": "HP45 - Brutal News" }
  ]
}
{% endschema %}
