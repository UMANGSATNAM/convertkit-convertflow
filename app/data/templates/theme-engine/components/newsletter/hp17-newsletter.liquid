{%- liquid
  assign section_id = section.id
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: #000;
    padding: 100px 40px;
    border-bottom: 1px solid rgba(0, 255, 65, 0.3);
    position: relative;
    overflow: hidden;
  }
  
  .hp17-news-grid-bg-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-image: 
      linear-gradient(rgba(0, 255, 65, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 255, 65, 0.05) 1px, transparent 1px);
    background-size: 20px 20px;
    z-index: 1;
  }
  
  .hp17-news-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    text-align: center;
    background: #0A0A0A;
    border: 1px solid #00FF41;
    padding: 50px;
    box-shadow: 0 0 30px rgba(0, 255, 65, 0.2);
  }
  
  .hp17-news-container-{{ section_id }}::before,
  .hp17-news-container-{{ section_id }}::after {
    content: '';
    position: absolute;
    width: 30px; height: 30px;
  }
  .hp17-news-container-{{ section_id }}::before {
    top: 0; left: 0;
    border-top: 3px solid #00FF41; border-left: 3px solid #00FF41;
  }
  .hp17-news-container-{{ section_id }}::after {
    bottom: 0; right: 0;
    border-bottom: 3px solid #00FF41; border-right: 3px solid #00FF41;
  }
  
  .hp17-news-title-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    text-transform: uppercase;
    color: #FFF;
    margin: 0 0 15px 0;
    letter-spacing: 2px;
  }
  
  .hp17-news-text-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    color: rgba(255,255,255,0.6);
    margin: 0 0 30px 0;
  }
  
  .hp17-news-form-{{ section_id }} {
    display: flex;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .hp17-news-input-{{ section_id }} {
    flex: 1;
    background: #000;
    border: 1px solid rgba(0, 255, 65, 0.5);
    padding: 15px 20px;
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    color: #00FF41;
    outline: none;
  }
  
  .hp17-news-input-{{ section_id }}::placeholder {
    color: rgba(0, 255, 65, 0.3);
  }
  
  .hp17-news-input-{{ section_id }}:focus {
    border-color: #00FF41;
    box-shadow: inset 0 0 10px rgba(0, 255, 65, 0.2);
  }
  
  .hp17-news-btn-{{ section_id }} {
    background: #00FF41;
    color: #000;
    border: 1px solid #00FF41;
    padding: 0 30px;
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    font-weight: bold;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  .hp17-news-btn-{{ section_id }}:hover {
    background: #B800FF;
    border-color: #B800FF;
    color: #FFF;
    box-shadow: 0 0 15px rgba(184, 0, 255, 0.5);
  }

  @media (max-width: 600px) {
    .hp17-news-container-{{ section_id }} {
      padding: 30px 20px;
    }
    .hp17-news-form-{{ section_id }} {
      flex-direction: column;
      gap: 10px;
    }
    .hp17-news-btn-{{ section_id }} {
      padding: 15px;
    }
  }
</style>

<div class="hp17-news-grid-bg-{{ section_id }}"></div>

<div class="hp17-news-container-{{ section_id }}">
  <h2 class="hp17-news-title-{{ section_id }}">{{ section.settings.title | default: 'ENCRYPTED INTEL' }}</h2>
  <p class="hp17-news-text-{{ section_id }}">{{ section.settings.text | default: 'Join the network. Receive early drops and classified data.' }}</p>
  
  {% form 'customer', class: 'hp17-news-form-' | append: section_id %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email" name="contact[email]" class="hp17-news-input-{{ section_id }}" placeholder="ENTER_EMAIL_ADDRESS" required>
    <button type="submit" class="hp17-news-btn-{{ section_id }}">CONNECT</button>
  {% endform %}
</div>

{% schema %}
{
  "name": "HP17 Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "ENCRYPTED INTEL"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Join the network. Receive early drops and classified data."
    }
  ],
  "presets": [
    {
      "name": "HP17 Newsletter"
    }
  ]
}
{% endschema %}
