{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: #000000;
    --border-width: 4px;
    --shadow-offset: 8px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: var(--border-width) solid var(--border-color);
    font-family: 'Space Grotesk', 'Outfit', sans-serif;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp23-news-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp23-news-wrapper {
      padding: 0 20px;
    }
  }

  .hp23-news__box {
    background: var(--accent-color);
    border: var(--border-width) solid var(--border-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--border-color);
    padding: 60px 40px;
    text-align: center;
    position: relative;
    border-radius: {{ section.settings.border_radius }}px;
  }

  @media screen and (max-width: 768px) {
    .hp23-news__box {
      padding: 40px 20px;
    }
  }

  .hp23-news__title {
    font-size: clamp(36px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    margin: 0 0 15px;
    text-transform: uppercase;
    line-height: 1.1;
    letter-spacing: -1px;
  }
  
  .hp23-news__title em {
    font-style: normal;
    background: #ffffff;
    padding: 0 10px;
    border: 3px solid #000;
    display: inline-block;
    transform: rotate(-2deg);
    box-shadow: 4px 4px 0 #000;
  }

  .hp23-news__text {
    font-family: var(--font-body);
    font-size: clamp(16px, 2vw, 20px);
    font-weight: 600;
    color: var(--text-color);
    margin: 0 0 40px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hp23-news__form-wrapper {
    max-width: 600px;
    margin: 0 auto;
  }

  .hp23-news__form {
    display: flex;
    flex-direction: row;
    gap: 0; /* Attach button to input */
    border: var(--border-width) solid var(--border-color);
    background: #ffffff;
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--border-color);
    border-radius: 0;
    overflow: hidden;
  }

  @media screen and (max-width: 600px) {
    .hp23-news__form {
      flex-direction: column;
      box-shadow: none;
      border: none;
      background: transparent;
      gap: 15px;
    }
  }

  .hp23-news__input {
    flex: 1;
    border: none;
    padding: 20px;
    font-size: 16px;
    font-weight: 700;
    color: var(--text-color);
    background: transparent;
    outline: none;
    font-family: 'Space Grotesk', 'Outfit', sans-serif;
  }
  
  .hp23-news__input::placeholder {
    color: rgba(0,0,0,0.5);
    text-transform: uppercase;
  }

  @media screen and (max-width: 600px) {
    .hp23-news__input {
      border: var(--border-width) solid var(--border-color);
      background: #ffffff;
      box-shadow: 4px 4px 0 var(--border-color);
    }
  }

  .hp23-news__btn {
    background: var(--text-color);
    color: #ffffff;
    border: none;
    border-left: var(--border-width) solid var(--border-color);
    padding: 0 30px;
    font-size: 16px;
    font-weight: 900;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: 'Space Grotesk', 'Outfit', sans-serif;
  }
  
  .hp23-news__btn:hover {
    background: #ffffff;
    color: var(--text-color);
  }

  @media screen and (max-width: 600px) {
    .hp23-news__btn {
      border: var(--border-width) solid var(--border-color);
      padding: 20px;
      box-shadow: 4px 4px 0 var(--border-color);
    }
  }
  
  .hp23-news__success {
    margin-top: 20px;
    padding: 15px;
    background: #ffffff;
    border: 2px solid var(--border-color);
    font-weight: 700;
    display: inline-block;
  }

  /* Decorative tape/sticker */
  .hp23-news__sticker {
    position: absolute;
    top: -20px;
    left: -20px;
    background: #ffffff;
    border: 3px solid #000;
    padding: 10px 20px;
    font-weight: 900;
    font-size: 14px;
    text-transform: uppercase;
    transform: rotate(-5deg);
    box-shadow: 4px 4px 0 #000;
    z-index: 2;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp23-news-wrapper" id="HP23News-{{ section.id }}">
  <div class="hp23-news__box">
    
    <div class="hp23-news__sticker">VIP ACCESS</div>
    
    {%- if section.settings.title != blank -%}
      <h2 class="hp23-news__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hp23-news__text">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="hp23-news__form-wrapper">
      {%- form 'customer', class: 'hp23-news__form-container' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        <div class="hp23-news__form">
          <input 
            type="email" 
            name="contact[email]" 
            class="hp23-news__input" 
            value="{{ form.email }}" 
            placeholder="{{ section.settings.placeholder | escape }}" 
            required 
            aria-label="Email Address"
          >
          <button type="submit" class="hp23-news__btn">
            {{ section.settings.btn_text | escape }}
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <div class="hp23-news__success">
            WELCOME TO THE CLUB.
          </div>
        {%- endif -%}
        
        {%- if form.errors -%}
          <div class="hp23-news__success" style="color:red;">
            {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "HP23 - Brutalist News",
  "class": "section-hp23-newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>JOIN THE <em>CULT</em></p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body Text",
      "default": "<p>Sign up to get access to limited drops, unhinged rants, and early access.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "ENTER YOUR EMAIL..."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SUBSCRIBE"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1000
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Box Border Radius",
      "default": 16
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Box Background Color",
      "default": "#39FF14"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP23 - Brutalist News"
    }
  ]
}
{% endschema %}
