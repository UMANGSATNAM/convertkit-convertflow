{%- comment -%}
  sections/fb04-cta-banner_streetwear.liquid

  CONVERSION PSYCHOLOGY (Frameblox Landing 04 Replica):
  1. DARK MODE IMPACT -- Full-width deep charcoal (#282A2F) creates visual pop and contrast.
  2. RADIAL GLOW ACCENT -- Subtle top radial gradient draws eye to headline.
  3. CALL TO ACTION HIERARCHY -- Single clear conversion action ("Shop now") with pill button styling.
{%- endcomment -%}

{%- liquid
  assign section_id = 'fb04-cta-' | append: section.id
-%}

<style>
  #shopify-section-{{ section.id }} {
    --cta-bg: {{ section.settings.bg_color | default: '#282A2F' }};
    --cta-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    --cta-subtext: {{ section.settings.subtext_color | default: '#A0A5B1' }};
    --cta-accent: {{ section.settings.primary_color | default: '#0066FF' }};
    --cta-accent-hover: {{ section.settings.primary_hover | default: '#2E82FF' }};
  }

  .fb04-cta-banner {
    background: var(--cta-bg);
    color: var(--cta-text);
    text-align: center;
    padding: clamp(4rem, 8vw, 6.25rem) 0;
    position: relative;
    overflow: hidden;
  }

  .fb04-cta-banner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: radial-gradient(circle, rgba(0,102,255,0.6) 0%, transparent 80%);
  }

  .fb04-cta-banner__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 3.75rem);
    position: relative;
    z-index: 2;
  }

  .fb04-cta-banner__inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .fb04-cta-banner__title {
    font-family: 'Big Shoulders Display', var(--font-heading, sans-serif);
    font-weight: 800;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.5px;
    margin-bottom: 16px;
  }

  .fb04-cta-banner__body {
    font-family: var(--font-body, sans-serif);
    font-weight: 400;
    font-size: 16px;
    color: var(--cta-subtext);
    line-height: 1.7;
    margin-bottom: 36px;
  }

  .fb04-cta-banner__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body, sans-serif);
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 14px 36px;
    background: var(--cta-accent);
    color: #fff;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 14px rgba(0, 102, 255, 0.35);
  }

  .fb04-cta-banner__btn:hover {
    background: var(--cta-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 102, 255, 0.45);
  }
</style>

<section class="fb04-cta-banner" id="{{ section_id }}">
  <div class="fb04-cta-banner__container">
    <div class="fb04-cta-banner__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="fb04-cta-banner__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="fb04-cta-banner__body">{{ section.settings.description }}</p>
      {%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="fb04-cta-banner__btn">
          {{ section.settings.cta_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FB04 Dark CTA Banner",
  "tag": "section",
  "class": "section-fb04-cta",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Movement. Wear the Future."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Streetwear designed for those who break the mold. Limited drops, bold designs, and premium quality—don't miss out."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#282A2F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#A0A5B1"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Color",
      "default": "#0066FF"
    },
    {
      "type": "color",
      "id": "primary_hover",
      "label": "Primary Hover",
      "default": "#2E82FF"
    }
  ],
  "presets": [
    {
      "name": "FB04 Dark CTA Banner",
      "settings": {
        "heading": "Join the Movement. Wear the Future.",
        "description": "Streetwear designed for those who break the mold. Limited drops, bold designs, and premium quality—don't miss out.",
        "cta_text": "Shop now"
      }
    }
  ]
}
{% endschema %}
