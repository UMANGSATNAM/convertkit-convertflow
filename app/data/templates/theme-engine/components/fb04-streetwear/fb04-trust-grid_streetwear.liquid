{%- comment -%}
  sections/fb04-trust-grid_streetwear.liquid

  CONVERSION PSYCHOLOGY (Frameblox Landing 04 Replica):
  1. TRUST ANCHORING -- 4 core reassurance points reduce friction at critical drop decisions.
  2. ICON ACCENT PADS -- Light blue circle/square icon containers highlight benefits visually.
  3. RESPONSIVE GRID -- 4 columns desktop, 2 columns tablet, 1 column mobile for seamless scanning.
{%- endcomment -%}

{%- liquid
  assign section_id = 'fb04-trust-' | append: section.id
-%}

<style>
  #shopify-section-{{ section.id }} {
    --tg-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --tg-card-bg: {{ section.settings.card_bg | default: '#F3F4F5' }};
    --tg-icon-bg: {{ section.settings.icon_bg | default: '#E8F1FF' }};
    --tg-icon-color: {{ section.settings.icon_color | default: '#0066FF' }};
    --tg-text-dark: {{ section.settings.text_dark | default: '#282A2F' }};
    --tg-text-body: {{ section.settings.text_body | default: '#7B818E' }};
  }

  .fb04-trust {
    background: var(--tg-bg);
    padding: clamp(3.5rem, 7vw, 5.6rem) 0;
  }

  .fb04-trust__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 3.75rem);
  }

  .fb04-trust__header {
    margin-bottom: 48px;
  }

  .fb04-trust__title {
    font-family: 'Big Shoulders Display', var(--font-heading, sans-serif);
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 2.75rem);
    text-transform: uppercase;
    color: var(--tg-text-dark);
    margin-bottom: 8px;
  }

  .fb04-trust__desc {
    font-family: var(--font-body, sans-serif);
    font-weight: 400;
    font-size: 16px;
    color: var(--tg-text-body);
    max-width: 580px;
    line-height: 1.6;
  }

  .fb04-trust__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .fb04-trust__card {
    background: var(--tg-card-bg);
    border-radius: 12px;
    padding: 36px 26px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fb04-trust__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.05);
  }

  .fb04-trust__icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--tg-icon-bg);
    color: var(--tg-icon-color);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
  }

  .fb04-trust__card-title {
    font-family: var(--font-body, sans-serif);
    font-weight: 700;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--tg-text-dark);
    margin-bottom: 10px;
  }

  .fb04-trust__card-desc {
    font-family: var(--font-body, sans-serif);
    font-weight: 400;
    font-size: 14px;
    color: var(--tg-text-body);
    line-height: 1.55;
  }

  @media (max-width: 809px) {
    .fb04-trust__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  @media (min-width: 810px) and (max-width: 1199px) {
    .fb04-trust__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<section class="fb04-trust" id="{{ section_id }}">
  <div class="fb04-trust__container">

    {%- if section.settings.heading != blank -%}
      <div class="fb04-trust__header">
        <h2 class="fb04-trust__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.description != blank -%}
          <p class="fb04-trust__desc">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="fb04-trust__grid">
      {%- for block in section.blocks -%}
        <div class="fb04-trust__card" {{ block.shopify_attributes }}>
          <div class="fb04-trust__icon">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
              {%- when 'lock' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
              {%- when 'rotate' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
              {%- else -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            {%- endcase -%}
          </div>
          <h3 class="fb04-trust__card-title">{{ block.settings.title }}</h3>
          <p class="fb04-trust__card-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "FB04 Trust Grid",
  "tag": "section",
  "class": "section-fb04-trust",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Shop With Us?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We've got you covered with hassle-free shopping, top-tier service, and guarantees that keep you confident."
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#F3F4F5"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon Background",
      "default": "#E8F1FF"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#0066FF"
    },
    {
      "type": "color",
      "id": "text_dark",
      "label": "Heading Color",
      "default": "#282A2F"
    },
    {
      "type": "color",
      "id": "text_body",
      "label": "Body Color",
      "default": "#7B818E"
    }
  ],
  "blocks": [
    {
      "type": "trust_card",
      "name": "Trust Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Free Delivery (Truck)" },
            { "value": "lock", "label": "Secure Payment (Lock)" },
            { "value": "rotate", "label": "Easy Returns (Rotate)" },
            { "value": "support", "label": "24/7 Support (Message)" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Delivery"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Get your streetwear fast and free, with no extra shipping costs on all orders."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FB04 Trust Grid",
      "blocks": [
        {
          "type": "trust_card",
          "settings": {
            "icon": "truck",
            "title": "Free Delivery",
            "description": "Get your streetwear fast and free, with no extra shipping costs on all orders worldwide."
          }
        },
        {
          "type": "trust_card",
          "settings": {
            "icon": "lock",
            "title": "100% Secure Payment",
            "description": "Shop with confidence using encrypted, safe, and trusted payment methods & fraud shield."
          }
        },
        {
          "type": "trust_card",
          "settings": {
            "icon": "rotate",
            "title": "30 Days Return",
            "description": "Not the perfect fit? No worries. Return or exchange hassle-free within 30 days of arrival."
          }
        },
        {
          "type": "trust_card",
          "settings": {
            "icon": "support",
            "title": "24/7 Support",
            "description": "Got questions about sizing or orders? Our street team is here for you anytime, anywhere."
          }
        }
      ]
    }
  ]
}
{% endschema %}
