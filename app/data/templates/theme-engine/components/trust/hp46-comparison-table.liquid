{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp46-comp-bg: {{ section.settings.bg_color | default: '#0B0F19' }};
    
    background-color: var(--hp46-comp-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp46-comp__wrap {
    max-width: {{ section.settings.container_width | default: 980 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp46-comp__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .hp46-comp__heading {
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 8px;
  }

  .hp46-comp__heading span {
    background: linear-gradient(135deg, #38BDF8, #F472B6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp46-comp__card {
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 0 35px rgba(56, 189, 248, 0.1);
  }

  .hp46-comp__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .hp46-comp__table th, .hp46-comp__table td {
    padding: 18px 24px;
    text-align: center;
    border-bottom: 1px solid rgba(56, 189, 248, 0.15);
    color: #FFFFFF;
  }

  .hp46-comp__table th {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    background: rgba(11, 15, 25, 0.8);
    text-transform: uppercase;
  }

  .hp46-comp__highlight {
    background: rgba(56, 189, 248, 0.1);
    color: #38BDF8 !important;
    font-weight: 700;
  }

  @media screen and (max-width: 600px) {
    .hp46-comp__table th, .hp46-comp__table td { padding: 12px 10px; font-size: 12px; }
  }
{%- endstyle -%}

<div class="hp46-comp__wrap">
  <div class="hp46-comp__header">
    <h2 class="hp46-comp__heading">HOLOGRAPHIC <span>BENCHMARK MATRIX</span></h2>
    <p style="font-size:14px; color:#94A3B8;">{{ section.settings.subheading | default: 'Bio-luminescent enzymes vs standard synthetic lab cosmetics.' }}</p>
  </div>

  <div class="hp46-comp__card">
    <table class="hp46-comp__table">
      <thead>
        <tr>
          <th style="text-align:left;">BIO-TECH PARAMETER</th>
          <th class="hp46-comp__highlight">CYBER V46 FORMULA</th>
          <th>LEGACY FORMULA</th>
        </tr>
      </thead>
      <tbody>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td style="text-align:left; font-weight:600;">{{ block.settings.feature }}</td>
              <td class="hp46-comp__highlight">{{ block.settings.brand_val }}</td>
              <td>{{ block.settings.other_val }}</td>
            </tr>
          {%- endfor -%}
        {%- else -%}
          <tr>
            <td style="text-align:left; font-weight:600;">Light Refraction Source</td>
            <td class="hp46-comp__highlight">Pure Phytoplankton Enzymes</td>
            <td>Synthetic Plastic Micro-Glitter</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:600;">Blue Light Defense</td>
            <td class="hp46-comp__highlight">98% High-Energy Screen Barrier</td>
            <td>0% Protection (No Filter)</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:600;">Cellular Hydration Depth</td>
            <td class="hp46-comp__highlight">Multi-Depth 5D Peptides</td>
            <td>Surface-Only Mineral Oil</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:600;">Global DDP Air Shipping</td>
            <td class="hp46-comp__highlight">100% Pre-Paid Customs &amp; Taxes</td>
            <td>Unexpected Border Clearance Fees</td>
          </tr>
        {%- endif -%}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "HP46 - Cyber Matrix",
  "class": "section-hp46-matrix",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0B0F19" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 980 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Matrix Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Light Refraction Source" },
        { "type": "text", "id": "brand_val", "label": "Our Formula", "default": "Pure Phytoplankton Enzymes" },
        { "type": "text", "id": "other_val", "label": "Legacy Formula", "default": "Synthetic Plastic Micro-Glitter" }
      ]
    }
  ],
  "presets": [
    { "name": "HP46 - Cyber Matrix" }
  ]
}
{% endschema %}
