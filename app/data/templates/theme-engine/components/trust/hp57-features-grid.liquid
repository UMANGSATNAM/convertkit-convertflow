{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0F291E' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp57-feat__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp57-feat__header { text-align: center; margin-bottom: 50px; }
  .hp57-feat__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#D97706' }}; margin: 0 0 12px; }
  .hp57-feat__heading { font-family: 'Cormorant Garamond', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #FFFFFF; margin: 0; }
  .hp57-feat__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 24px; }
  .hp57-feat__card {
    background: {{ section.settings.card_bg | default: '#1B4332' }};
    border: 1px solid rgba(167, 243, 208, 0.15); border-radius: 12px; padding: 28px 24px;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .hp57-feat__card:hover { transform: translateY(-4px); border-color: rgba(217, 119, 6, 0.45); }
  .hp57-feat__card-icon {
    width: 48px; height: 48px; background: linear-gradient(135deg, #0F291E, #2D5A43);
    border-radius: 8px; display: flex; align-items: center; justify-content: center;
    font-size: 20px; color: #A7F3D0; margin-bottom: 18px;
    border: 1px solid rgba(167, 243, 208, 0.25);
  }
  .hp57-feat__card-title { font-family: 'Cormorant Garamond', serif; font-size: 18px; font-weight: 700; color: #FFFFFF; margin: 0 0 8px; }
  .hp57-feat__card-desc { font-size: 13px; line-height: 1.6; color: #CBD5E1; margin: 0; }
  @media screen and (max-width: 992px) { .hp57-feat__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp57-feat__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp57-feat__container">
  <div class="hp57-feat__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp57-feat__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp57-feat__heading">{{ section.settings.heading | default: 'Apothecary Principles' }}</h2>
  </div>
  <div class="hp57-feat__grid">
    {%- for block in section.blocks -%}
      <div class="hp57-feat__card" {{ block.shopify_attributes }}>
        <div class="hp57-feat__card-icon">{{ block.settings.icon | default: '🌿' }}</div>
        <h3 class="hp57-feat__card-title">{{ block.settings.title | default: 'Live Plant Active' }}</h3>
        <p class="hp57-feat__card-desc">{{ block.settings.description | default: 'Cold macerated botanical oils.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP57 Features",
  "class": "section-hp57-feat",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0F291E" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#1B4332" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#D97706" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌿 PRINCIPLES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Apothecary Principles" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "feature", "name": "Feature",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🌿" },
      { "type": "text", "id": "title", "label": "Title", "default": "Live Plant Active" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "Cold macerated botanical oils." }
    ]
  }],
  "presets": [{
    "name": "HP57 Features",
    "blocks": [
      { "type": "feature", "settings": { "icon": "🌿", "title": "Living Fern Phytosterols", "description": "Naturally mimics human skin sebum to instantly seal damaged lipid layers." } },
      { "type": "feature", "settings": { "icon": "🌼", "title": "Whole Flower Calendula", "description": "High-carotenoid oil calming irritation and dermal micro-inflammation." } },
      { "type": "feature", "settings": { "icon": "🍯", "title": "Raw Meadowfoam Fatty Acids", "description": "Rich in eicosenoic acid for exceptional oxidative stability and softness." } },
      { "type": "feature", "settings": { "icon": "🧪", "title": "Zero Petrochemicals", "description": "100% plant-derived without mineral oil, PEGs, or synthetic fillers." } },
      { "type": "feature", "settings": { "icon": "🍾", "title": "Amber UV Shield Glass", "description": "Pharmaceutical glass preventing light oxidation and prolonging shelf life." } },
      { "type": "feature", "settings": { "icon": "🌱", "title": "Small Batch Harvest", "description": "Crafted in 500-bottle artisanal press cycles for peak therapeutic freshness." } }
    ]
  }]
}
{% endschema %}
