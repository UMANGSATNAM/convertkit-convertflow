{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-primary: {{ section.settings.accent_primary }};
    --accent-secondary: {{ section.settings.accent_secondary }};
    --font-heading: 'Orbitron', sans-serif;
    --font-body: 'Share Tech Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Grid lines in background */
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-size: 30px 30px;
    background-image: 
      linear-gradient(to right, rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.02) 1px, transparent 1px);
    pointer-events: none;
    z-index: 0;
  }

  .hp24-usp-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp24-usp-wrapper {
      padding: 0 20px;
    }
  }

  .hp24-usp__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 30px;
  }

  @media screen and (max-width: 992px) {
    .hp24-usp__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 600px) {
    .hp24-usp__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .hp24-usp__item {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--accent-primary);
    padding: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    backdrop-filter: blur(5px);
    transition: all 0.3s ease;
  }

  /* Corner brackets */
  .hp24-usp__item::before,
  .hp24-usp__item::after {
    content: '';
    position: absolute;
    width: 15px;
    height: 15px;
    border: 2px solid var(--accent-secondary);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .hp24-usp__item::before {
    top: -5px; left: -5px;
    border-right: none; border-bottom: none;
  }

  .hp24-usp__item::after {
    bottom: -5px; right: -5px;
    border-left: none; border-top: none;
  }

  .hp24-usp__item:hover {
    box-shadow: 0 0 15px rgba(0, 243, 255, 0.2), inset 0 0 10px rgba(0, 243, 255, 0.1);
    transform: translateY(-5px);
  }

  .hp24-usp__item:hover::before,
  .hp24-usp__item:hover::after {
    opacity: 1;
  }

  .hp24-usp__icon {
    width: 50px;
    height: 50px;
    margin-bottom: 20px;
    position: relative;
  }

  .hp24-usp__icon svg {
    width: 100%;
    height: 100%;
    fill: var(--accent-primary);
    filter: drop-shadow(0 0 5px var(--accent-primary));
    transition: all 0.3s ease;
  }

  .hp24-usp__item:hover .hp24-usp__icon svg {
    fill: var(--accent-secondary);
    filter: drop-shadow(0 0 8px var(--accent-secondary));
  }

  .hp24-usp__title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-shadow: 0 0 2px var(--accent-primary);
  }

  .hp24-usp__text {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-color);
    margin: 0;
    line-height: 1.5;
    opacity: 0.7;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp24-usp-wrapper" id="HP24Usp-{{ section.id }}">
  <div class="hp24-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp24-usp__item" {{ block.shopify_attributes }}>
        
        <div class="hp24-usp__icon">
          {%- if block.settings.icon == 'shield' -%}
            <svg viewBox="0 0 24 24"><path d="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,7C14.76,7 17,9.24 17,12C17,14.76 14.76,17 12,17C9.24,17 7,14.76 7,12C7,9.24 9.24,7 12,7Z"/></svg>
          {%- elsif block.settings.icon == 'lightning' -%}
            <svg viewBox="0 0 24 24"><path d="M7,2V13H10V22L17,10H13L17,2H7Z"/></svg>
          {%- elsif block.settings.icon == 'chip' -%}
            <svg viewBox="0 0 24 24"><path d="M6,4H18V5H21V7H18V9H21V11H18V13H21V15H18V17H21V19H18V20H6V19H3V17H6V15H3V13H6V11H3V9H6V7H3V5H6V4M8,7V17H16V7H8M10,9H14V11H10V9M10,13H14V15H10V13Z"/></svg>
          {%- elsif block.settings.icon == 'globe' -%}
            <svg viewBox="0 0 24 24"><path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4.04C16.03,4.04 19.36,7.03 19.9,10.96L17.58,8.64L16.16,10.05L19.46,13.35C19.16,16.8 16.32,19.5 12.8,19.9L10.3,17.4L8.89,18.81L12.55,22.47C6.7,22.47 2,17.77 2,11.92C2,6.07 6.7,1.37 12.55,1.37V4.04Z"/></svg>
          {%- else -%}
            <svg viewBox="0 0 24 24"><path d="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L5,8.09L12,12.03L19,8.09L12,4.15Z"/></svg>
          {%- endif -%}
        </div>

        {%- if block.settings.title != blank -%}
          <h3 class="hp24-usp__title">{{ block.settings.title }}</h3>
        {%- endif -%}

        {%- if block.settings.text != blank -%}
          <p class="hp24-usp__text">{{ block.settings.text }}</p>
        {%- endif -%}

      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP24 - Cyberpunk USP",
  "class": "section-hp24-usp",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Cyberpunk Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_primary",
      "label": "Accent Primary (Neon Blue)",
      "default": "#00F3FF"
    },
    {
      "type": "color",
      "id": "accent_secondary",
      "label": "Accent Secondary (Neon Pink)",
      "default": "#FF00E6"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "cube", "label": "Cube" },
            { "value": "shield", "label": "Shield" },
            { "value": "lightning", "label": "Lightning" },
            { "value": "chip", "label": "Microchip" },
            { "value": "globe", "label": "Globe" }
          ],
          "default": "cube"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "SECURE PROTOCOL"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Encrypted checkout. Your data is safe in the mainframe."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP24 - Cyberpunk USP",
      "blocks": [
        { "type": "usp", "settings": { "icon": "lightning", "title": "HYPER SPEED", "text": "Next cycle delivery to sector 7." } },
        { "type": "usp", "settings": { "icon": "shield", "title": "SECURE PROTOCOL", "text": "Encrypted checkout via secure nodes." } },
        { "type": "usp", "settings": { "icon": "chip", "title": "TECH ENHANCED", "text": "Engineered with maximum precision." } },
        { "type": "usp", "settings": { "icon": "globe", "title": "GLOBAL NETWORK", "text": "Connecting nodes across the planet." } }
      ]
    }
  ]
}
{% endschema %}
