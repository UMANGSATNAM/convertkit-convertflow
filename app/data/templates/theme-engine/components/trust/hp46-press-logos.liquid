<style>
@media screen and (max-width: 768px) {
  .hp46-press-logos {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp46-press-bg: {{ section.settings.bg_color | default: '#0B0F19' }};
    
    background-color: var(--hp46-press-bg);
    padding: {{ section.settings.padding_vertical | default: 30 }}px 0;
    border-top: 1px solid rgba(56, 189, 248, 0.2);
    border-bottom: 1px solid rgba(244, 114, 182, 0.2);
  }

  .hp46-press__wrap {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: 30px;
    font-family: 'Syne', sans-serif;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #94A3B8;
  }
{%- endstyle -%}

<div class="hp46-press__wrap">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.title }}</span>
    {%- endfor -%}
  {%- else -%}
    <span>CYBER GLAMOUR</span>
    <span>VOGUE DIGITAL</span>
    <span>WIRED BEAUTY</span>
    <span>DAZED BIO-TECH</span>
    <span>HYPEBAE GLOW</span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP46 - Cyber Press",
  "class": "section-hp46-press",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0B0F19" },
    { "type": "range", "id": "padding_vertical", "min": 15, "max": 60, "step": 5, "unit": "px", "label": "Vertical Padding", "default": 30 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1100 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Publication Name", "default": "CYBER GLAMOUR" }
      ]
    }
  ],
  "presets": [
    { "name": "HP46 - Cyber Press" }
  ]
}
{% endschema %}
