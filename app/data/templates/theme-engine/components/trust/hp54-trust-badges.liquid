{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#060D17' }};
    padding-top: {{ section.settings.padding_top | default: 50 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    border-top: 1px solid rgba(59, 130, 246, 0.15);
  }
  .hp54-trust__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp54-trust__grid { display: flex; justify-content: center; gap: 50px; flex-wrap: wrap; }
  .hp54-trust__item { display: flex; align-items: center; gap: 14px; }
  .hp54-trust__icon {
    width: 44px; height: 44px; background: linear-gradient(135deg, #1E3A5F, #3B82F6);
    border-radius: 10px; display: flex; align-items: center; justify-content: center;
    font-size: 18px; color: #FFFFFF; flex-shrink: 0;
  }
  .hp54-trust__label { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 700; color: #FFFFFF; margin: 0; }
  .hp54-trust__sub { font-size: 11px; color: {{ section.settings.accent_color | default: '#60A5FA' }}; margin: 2px 0 0; }
  @media screen and (max-width: 768px) { .hp54-trust__grid { gap: 24px; } }
  @media screen and (max-width: 480px) {
    .hp54-trust__grid { flex-direction: column; align-items: center; text-align: center; }
    .hp54-trust__item { flex-direction: column; }
  }
{%- endstyle -%}
<div class="hp54-trust__container">
  <div class="hp54-trust__grid">
    {%- for block in section.blocks -%}
      <div class="hp54-trust__item" {{ block.shopify_attributes }}>
        <div class="hp54-trust__icon">{{ block.settings.icon | default: '◆' }}</div>
        <div>
          <p class="hp54-trust__label">{{ block.settings.title | default: 'Free Express Shipping' }}</p>
          <p class="hp54-trust__sub">{{ block.settings.subtitle | default: 'Orders over $65' }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP54 - Sapphire Trust",
  "class": "section-hp54-trust",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#060D17" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#60A5FA" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 50 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "badge", "name": "Badge",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "◆" },
      { "type": "text", "id": "title", "label": "Title", "default": "Free Express Shipping" },
      { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Orders over $65" }
    ]
  }],
  "presets": [{
    "name": "HP54 - Sapphire Trust",
    "blocks": [
      { "type": "badge", "settings": { "icon": "✈️", "title": "Priority Delivery", "subtitle": "2-3 day tracked global shipping" } },
      { "type": "badge", "settings": { "icon": "💎", "title": "Dermatologist Tested", "subtitle": "100% hypoallergenic certified" } },
      { "type": "badge", "settings": { "icon": "🌙", "title": "60-Night Guarantee", "subtitle": "Full refund if not transformed" } },
      { "type": "badge", "settings": { "icon": "🔒", "title": "Encrypted Checkout", "subtitle": "Bank-grade 256-bit security" } }
    ]
  }]
}
{% endschema %}
