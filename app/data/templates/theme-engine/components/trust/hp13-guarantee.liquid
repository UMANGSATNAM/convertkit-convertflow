{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#00FFA3'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 1px solid #333;
  }
  
  .hp13-guarantee-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }
  
  .hp13-guarantee-item-{{ section_id }} {
    text-align: center;
    color: #FFF;
    border: 1px solid #333;
    padding: 30px 20px;
    background: #111;
    position: relative;
  }
  
  .hp13-guarantee-item-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: 5px; left: 5px;
    width: 100%; height: 100%;
    border: 1px solid {{ text_color }};
    z-index: 0;
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  
  .hp13-guarantee-item-{{ section_id }}:hover::before {
    opacity: 1;
    transform: translate(-10px, -10px);
  }
  
  .hp13-guarantee-content-{{ section_id }} {
    position: relative;
    z-index: 1;
  }
  
  .hp13-guarantee-icon-{{ section_id }} {
    margin-bottom: 20px;
    color: {{ text_color }};
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.5rem;
    font-weight: bold;
  }
  
  .hp13-guarantee-title-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    font-weight: bold;
    text-transform: uppercase;
    margin: 0 0 10px 0;
  }
  
  .hp13-guarantee-text-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.85rem;
    opacity: 0.7;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 992px) {
    .hp13-guarantee-container-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp13-guarantee-container-{{ section_id }} {
      grid-template-columns: 1fr;
    }
    .hp13-guarantee-item-{{ section_id }}:hover::before {
      transform: translate(-5px, -5px);
    }
  }
</style>

<div class="hp13-guarantee-container-{{ section_id }}">
  {% for block in section.blocks limit: 4 %}
    <div class="hp13-guarantee-item-{{ section_id }}" {{ block.shopify_attributes }}>
      <div class="hp13-guarantee-content-{{ section_id }}">
        <div class="hp13-guarantee-icon-{{ section_id }}">
          {% if block.settings.icon == 'shipping' %}
            [S]
          {% elsif block.settings.icon == 'return' %}
            [R]
          {% elsif block.settings.icon == 'quality' %}
            [Q]
          {% else %}
            [+]
          {% endif %}
        </div>
        <h3 class="hp13-guarantee-title-{{ section_id }}">{{ block.settings.title }}</h3>
        <p class="hp13-guarantee-text-{{ section_id }}">{{ block.settings.text }}</p>
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP13 Guarantee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Highlight Color",
      "default": "#00FFA3"
    }
  ],
  "blocks": [
    {
      "type": "guarantee",
      "name": "Guarantee Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon Code",
          "options": [
            { "value": "shipping", "label": "Shipping [S]" },
            { "value": "return", "label": "Return [R]" },
            { "value": "quality", "label": "Quality [Q]" },
            { "value": "circle", "label": "Default [+]" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "GLOBAL_TRANSIT"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Secure routing to all active zones."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP13 Guarantee",
      "blocks": [
        { "type": "guarantee", "settings": { "icon": "shipping", "title": "GLOBAL_TRANSIT", "text": "Secure routing to all active zones." } },
        { "type": "guarantee", "settings": { "icon": "quality", "title": "MIL_SPEC", "text": "Tested for extreme durability." } },
        { "type": "guarantee", "settings": { "icon": "return", "title": "RECALL_POLICY", "text": "30-day extraction guarantee." } },
        { "type": "guarantee", "settings": { "icon": "circle", "title": "SECURE_COMMS", "text": "24/7 encrypted support." } }
      ]
    }
  ]
}
{% endschema %}
