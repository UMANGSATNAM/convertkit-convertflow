{%- style -%}#shopify-section-{{ section.id }}{background:#fff;padding:22px 0;border-bottom:1px solid rgba(0,0,0,.06)}.hp72-usp{max-width:1280px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:16px}@media(max-width:700px){.hp72-usp{grid-template-columns:repeat(2,1fr)}}.hp72-u{display:flex;gap:10px;align-items:center}.hp72-ico{width:38px;height:38px;border-radius:8px;background:#7C3AED18;color:#7C3AED;display:grid;place-items:center;border:1px solid #7C3AED30}{%- endstyle -%}<div class="hp72-usp">{% for block in section.blocks %}<div class="hp72-u"><div class="hp72-ico">{{block.settings.icon}}</div><div><b style="font-size:13px">{{block.settings.title}}</b><br><small style="opacity:.6">{{block.settings.desc}}</small></div></div>{% else %}<div class="hp72-u"><div class="hp72-ico">✓</div><div><b>Free Ship</b><br><small>Over ₹999</small></div></div><div class="hp72-u"><div class="hp72-ico">↺</div><div><b>Returns</b><br><small>7 days</small></div></div><div class="hp72-u"><div class="hp72-ico">★</div><div><b>4.8 ★</b><br><small>50k reviews</small></div></div>{% if 4==4 %}<div class="hp72-u"><div class="hp72-ico">⚡</div><div><b>COD</b><br><small>Pan India</small></div></div>{% endif %}{% endfor %}</div>{% schema %}
{
  "name": "HP72 USP",
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Desc",
          "default": "Over ₹999"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP72 USP"
    }
  ]
}
{% endschema %}