{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp46-feat-bg: {{ section.settings.bg_color | default: '#0B0F19' }};
    
    background-color: var(--hp46-feat-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp46-feat__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp46-feat__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp46-feat__heading {
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 8px;
  }

  .hp46-feat__heading span {
    background: linear-gradient(135deg, #38BDF8, #F472B6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp46-feat__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp46-feat__card {
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 24px;
    padding: 36px 28px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    transition: all 0.3s ease;
  }

  .hp46-feat__card:hover {
    border-color: #F472B6;
    transform: translateY(-4px);
    box-shadow: 0 15px 40px rgba(244, 114, 182, 0.15);
  }

  .hp46-feat__title {
    font-family: 'Syne', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #38BDF8;
    margin: 0 0 12px;
  }

  .hp46-feat__desc {
    font-size: 14px;
    line-height: 1.7;
    color: #94A3B8;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp46-feat__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="hp46-feat__wrap">
  <div class="hp46-feat__header">
    <h2 class="hp46-feat__heading">QUANTUM <span>BIO-INNOVATIONS</span></h2>
    <p style="font-size:14px; color:#94A3B8;">{{ section.settings.subheading | default: 'Breakthrough biochemical innovations powering the V46 holographic drops.' }}</p>
  </div>

  <div class="hp46-feat__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp46-feat__card" {{ block.shopify_attributes }}>
          <h3 class="hp46-feat__title">{{ block.settings.title }}</h3>
          <p class="hp46-feat__desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp46-feat__card">
        <h3 class="hp46-feat__title">PHOTONIC REFLECTION ENZYMES</h3>
        <p class="hp46-feat__desc">Harnesses marine luminescence to refract ambient room light into a stunning holographic crystal finish.</p>
      </div>
      <div class="hp46-feat__card">
        <h3 class="hp46-feat__title">HEV DIGITAL SCREEN FILTER</h3>
        <p class="hp46-feat__desc">Lutein-rich micro-lipids create an invisible cellular shield against high-energy visible screen fatigue.</p>
      </div>
      <div class="hp46-feat__card">
        <h3 class="hp46-feat__title">BIODEGRADABLE AIRLESS PODS</h3>
        <p class="hp46-feat__desc">100% recyclable vacuum-sealed dispensers maintain 0% oxidation across the product lifespan.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP46 - Cyber Feat",
  "class": "section-hp46-features",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0B0F19" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "PHOTONIC REFLECTION ENZYMES" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Harnesses marine luminescence." }
      ]
    }
  ],
  "presets": [
    { "name": "HP46 - Cyber Feat" }
  ]
}
{% endschema %}
