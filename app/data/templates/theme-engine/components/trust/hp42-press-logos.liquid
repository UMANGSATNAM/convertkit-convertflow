{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300&display=swap');

  #shopify-section-{{ section.id }} {
    --bg: {{ section.settings.bg_color }};
    --gold: {{ section.settings.accent_color }};
    --sans: 'Inter', sans-serif;
    background: var(--bg);
    padding: 60px 20px;
    border-top: 1px solid rgba(201,169,110,0.15);
    border-bottom: 1px solid rgba(201,169,110,0.15);
  }

  .hp42-press {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 80px;
  }

  @media (max-width: 768px) { .hp42-press { gap: 40px; } }

  .hp42-press__logo {
    max-height: 30px;
    width: auto;
    opacity: 0.25;
    filter: brightness(10); /* Make dark logos appear light on dark bg */
    transition: opacity 0.4s;
  }
  .hp42-press__logo:hover { opacity: 0.6; }

  .hp42-press__fallback {
    font-family: var(--sans);
    font-size: 20px;
    font-weight: 300;
    letter-spacing: 6px;
    text-transform: uppercase;
    color: #F5F0EB;
    opacity: 0.25;
    transition: opacity 0.4s;
  }
  .hp42-press__fallback:hover { opacity: 0.6; }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp42-press" id="HP42Press-{{ section.id }}">
  {%- for block in section.blocks -%}
    <div {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: height: 60 }}" alt="Press" class="hp42-press__logo" loading="lazy">
      {%- else -%}
        <div class="hp42-press__fallback">{{ block.settings.text_fallback }}</div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP42 - Noir Press",
  "class": "section-hp42-press-logos",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A0A0A" },
    { "type": "color", "id": "accent_color", "label": "Gold", "default": "#C9A96E" },
    { "type": "html", "id": "custom_css", "label": "Custom CSS" }
  ],
  "blocks": [{ "type": "logo", "name": "Logo", "settings": [
    { "type": "image_picker", "id": "image", "label": "Logo" },
    { "type": "text", "id": "text_fallback", "label": "Fallback", "default": "VOGUE" }
  ]}],
  "presets": [{ "name": "HP42 - Noir Press", "blocks": [
    { "type": "logo", "settings": { "text_fallback": "VOGUE" } },
    { "type": "logo", "settings": { "text_fallback": "ROBB REPORT" } },
    { "type": "logo", "settings": { "text_fallback": "TATLER" } },
    { "type": "logo", "settings": { "text_fallback": "WSJ" } }
  ]}]
}
{% endschema %}
