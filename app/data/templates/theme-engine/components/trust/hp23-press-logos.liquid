{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: #000000;
    --border-width: 3px;
    --shadow-offset: 4px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: var(--border-width) solid var(--border-color);
    font-family: 'Space Grotesk', 'Outfit', sans-serif;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp23-press-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp23-press-wrapper {
      padding: 0 20px;
    }
  }

  .hp23-press__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp23-press__title {
    font-size: clamp(24px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -1px;
    display: inline-block;
    padding: 10px 20px;
    background: #ffffff;
    border: var(--border-width) solid var(--border-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--border-color);
    transform: rotate(-1deg);
  }

  .hp23-press__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 20px;
  }

  @media screen and (max-width: 992px) {
    .hp23-press__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 600px) {
    .hp23-press__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .hp23-press__item {
    background: #ffffff;
    border: var(--border-width) solid var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    padding: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--border-color);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hp23-press__item:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--border-color);
  }

  .hp23-press__logo {
    max-width: 100%;
    max-height: 50px;
    object-fit: contain;
    filter: grayscale(100%) contrast(1.5);
    opacity: 0.8;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }
  
  .hp23-press__item:hover .hp23-press__logo {
    filter: none;
    opacity: 1;
  }

  .hp23-press__text-placeholder {
    font-weight: 900;
    font-size: 20px;
    color: var(--text-color);
    text-transform: uppercase;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp23-press-wrapper" id="HP23Press-{{ section.id }}">
  
  {%- if section.settings.title != blank -%}
    <div class="hp23-press__header">
      <h2 class="hp23-press__title">{{ section.settings.title | escape }}</h2>
    </div>
  {%- endif -%}

  <div class="hp23-press__grid">
    {%- for block in section.blocks -%}
      <div class="hp23-press__item" {{ block.shopify_attributes }}>
        {%- if block.settings.logo != blank -%}
          <img src="{{ block.settings.logo | image_url: width: 300 }}" alt="" class="hp23-press__logo" loading="lazy">
        {%- else -%}
          <div class="hp23-press__text-placeholder">LOGO</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

</div>

{% schema %}
{
  "name": "HP23 - Brutalist Press",
  "class": "section-hp23-press-logos",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HATED BY MANY. LOVED BY THEM."
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 5
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP23 - Brutalist Press",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
