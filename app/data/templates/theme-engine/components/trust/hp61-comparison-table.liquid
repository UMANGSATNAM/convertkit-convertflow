{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#18181B' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp61-comp__container { max-width: {{ section.settings.container_width | default: 1000 }}px; margin: 0 auto; padding: 0 24px; }
  .hp61-comp__header { text-align: center; margin-bottom: 50px; }
  .hp61-comp__eyebrow { font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#EF4444' }}; margin: 0 0 12px; }
  .hp61-comp__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; color: #FFFFFF; margin: 0; }
  .hp61-comp__table {
    width: 100%; border-collapse: collapse; background: {{ section.settings.card_bg | default: '#09090B' }};
    border-radius: 6px; overflow: hidden; border: 1px solid rgba(239, 68, 68, 0.25);
    box-shadow: 0 0 30px rgba(239, 68, 68, 0.1);
  }
  .hp61-comp__table th {
    background: #030712; color: #EF4444; font-family: 'Space Grotesk', sans-serif;
    font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    padding: 18px 20px; text-align: left; border-bottom: 1px solid rgba(239, 68, 68, 0.25);
  }
  .hp61-comp__table td {
    padding: 16px 20px; font-size: 14px; color: #F4F4F5;
    border-bottom: 1px solid rgba(239, 68, 68, 0.1);
  }
  .hp61-comp__table tr:last-child td { border-bottom: none; }
  .hp61-comp__check { color: #EF4444; font-weight: 700; }
  @media screen and (max-width: 768px) {
    .hp61-comp__table { font-size: 13px; }
    .hp61-comp__table th, .hp61-comp__table td { padding: 12px 14px; }
  }
{%- endstyle -%}
<div class="hp61-comp__container">
  <div class="hp61-comp__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp61-comp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp61-comp__heading">{{ section.settings.heading | default: 'The Volcanic Purity Index' }}</h2>
  </div>
  <table class="hp61-comp__table">
    <thead>
      <tr>
        <th>{{ section.settings.col1_head | default: 'Mineral Factor' }}</th>
        <th>{{ section.settings.col2_head | default: 'Obsidian Volcanic' }}</th>
        <th>{{ section.settings.col3_head | default: 'Standard Clay Masks' }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for block in section.blocks -%}
        <tr {{ block.shopify_attributes }}>
          <td>{{ block.settings.feature | default: 'Particle Micronization' }}</td>
          <td class="hp61-comp__check">{{ block.settings.us | default: '🌋 < 5 Micron Basalt' }}</td>
          <td style="color:#71717A;">{{ block.settings.them | default: '> 50 Micron Abrasive' }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
</div>
{% schema %}
{
  "name": "HP61 Compare",
  "class": "section-hp61-comp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#18181B" },
    { "type": "color", "id": "card_bg", "label": "Table BG", "default": "#09090B" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#EF4444" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌋 PURITY INDEX" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Volcanic Purity Index" },
    { "type": "text", "id": "col1_head", "label": "Column 1", "default": "Mineral Factor" },
    { "type": "text", "id": "col2_head", "label": "Column 2", "default": "Obsidian Volcanic" },
    { "type": "text", "id": "col3_head", "label": "Column 3", "default": "Standard Clay Masks" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 1000 }
  ],
  "blocks": [{
    "type": "row", "name": "Row",
    "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "Particle Micronization" },
      { "type": "text", "id": "us", "label": "Us", "default": "🌋 < 5 Micron Basalt" },
      { "type": "text", "id": "them", "label": "Others", "default": "> 50 Micron Abrasive" }
    ]
  }],
  "presets": [{
    "name": "HP61 Compare",
    "blocks": [
      { "type": "row", "settings": { "feature": "Impurities Magnetic Binding", "us": "🌋 10x Ionic Charge Adsorption", "them": "Passive Surface Drying" } },
      { "type": "row", "settings": { "feature": "Pore Stripping Effect", "us": "🌋 Zero Moisture Depletion", "them": "Cracks, Tightens & Dehydrates" } },
      { "type": "row", "settings": { "feature": "Bioactive Silica Content", "us": "🌋 48% Pure Geothermal Silica", "them": "0% Inactive Fillers" } },
      { "type": "row", "settings": { "feature": "Heavy Metal Removal", "us": "🌋 Certified Detox Clinically Proven", "them": "Unverified Claims" } }
    ]
  }]
}
{% endschema %}
