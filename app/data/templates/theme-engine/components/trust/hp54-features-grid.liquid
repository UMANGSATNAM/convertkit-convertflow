{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0A1628' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp54-feat__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp54-feat__header { text-align: center; margin-bottom: 50px; }
  .hp54-feat__eyebrow { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#60A5FA' }}; margin: 0 0 12px; }
  .hp54-feat__heading { font-family: 'Tenor Sans', serif; font-size: clamp(28px, 3.5vw, 42px); color: #FFFFFF; margin: 0; }
  .hp54-feat__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 24px; }
  .hp54-feat__card {
    background: {{ section.settings.card_bg | default: '#111D33' }};
    border: 1px solid rgba(59, 130, 246, 0.15); border-radius: 12px; padding: 28px 24px;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .hp54-feat__card:hover { transform: translateY(-4px); border-color: rgba(59, 130, 246, 0.4); }
  .hp54-feat__card-icon {
    width: 48px; height: 48px; background: linear-gradient(135deg, #1E3A5F, #3B82F6);
    border-radius: 10px; display: flex; align-items: center; justify-content: center;
    font-size: 20px; color: #FFFFFF; margin-bottom: 18px;
  }
  .hp54-feat__card-title { font-family: 'Tenor Sans', serif; font-size: 18px; color: #FFFFFF; margin: 0 0 8px; }
  .hp54-feat__card-desc { font-size: 13px; line-height: 1.6; color: #94A3B8; margin: 0; }
  @media screen and (max-width: 992px) { .hp54-feat__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp54-feat__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp54-feat__container">
  <div class="hp54-feat__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp54-feat__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp54-feat__heading">{{ section.settings.heading | default: 'Nocturnal Bio-Technology' }}</h2>
  </div>
  <div class="hp54-feat__grid">
    {%- for block in section.blocks -%}
      <div class="hp54-feat__card" {{ block.shopify_attributes }}>
        <div class="hp54-feat__card-icon">{{ block.settings.icon | default: '◆' }}</div>
        <h3 class="hp54-feat__card-title">{{ block.settings.title | default: 'Night Repair' }}</h3>
        <p class="hp54-feat__card-desc">{{ block.settings.description | default: 'Advanced night-activation restores lipid moisture.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP54 - Sapphire Features",
  "class": "section-hp54-feat",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A1628" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#111D33" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#60A5FA" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◆ CLINICAL PILLARS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nocturnal Bio-Technology" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "feature", "name": "Feature",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "◆" },
      { "type": "text", "id": "title", "label": "Title", "default": "Night Repair" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "Advanced night-activation restores lipid moisture." }
    ]
  }],
  "presets": [{
    "name": "HP54 - Sapphire Features",
    "blocks": [
      { "type": "feature", "settings": { "icon": "🧬", "title": "Sapphire Infused Peptides", "description": "Micro-milled gemstone crystals catalyzing collagen renewal." } },
      { "type": "feature", "settings": { "icon": "🌊", "title": "Deep Marine Bio-Lipids", "description": "Harvested from arctic thermal vents for extreme skin resilience." } },
      { "type": "feature", "settings": { "icon": "🌙", "title": "Circadian Synchronization", "description": "Aligns with your body's natural 11PM-4AM cellular repair cycle." } },
      { "type": "feature", "settings": { "icon": "💧", "title": "Triple Hyaluronic Matrix", "description": "Multi-molecular weights deliver hydration to 5 skin depths." } },
      { "type": "feature", "settings": { "icon": "🛡️", "title": "Blue Light Defensive Shield", "description": "Neutralizes screen radiation damage while you sleep." } },
      { "type": "feature", "settings": { "icon": "✨", "title": "Zero Silicones or Fillers", "description": "100% active, clean, biocompatible botanical formulation." } }
    ]
  }]
}
{% endschema %}
