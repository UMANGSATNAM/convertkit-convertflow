{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp44-comp-bg: {{ section.settings.bg_color | default: '#EDF4EE' }};
    --hp44-comp-card: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --hp44-comp-border: {{ section.settings.card_border | default: '#D8E8DC' }};
    --hp44-comp-title: {{ section.settings.title_color | default: '#143D2B' }};
    --hp44-comp-highlight: {{ section.settings.highlight_bg | default: 'rgba(45, 106, 79, 0.08)' }};
    
    background-color: var(--hp44-comp-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp44-comp__wrapper {
    max-width: {{ section.settings.container_width | default: 960 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp44-comp__title-block {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 45px;
  }

  .hp44-comp__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    color: var(--hp44-comp-title);
    margin: 0 0 10px;
  }

  .hp44-comp__sub {
    font-size: 15px;
    color: #406352;
    margin: 0;
  }

  .hp44-comp__table-card {
    background: var(--hp44-comp-card);
    border: 1px solid var(--hp44-comp-border);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(20, 61, 43, 0.05);
  }

  .hp44-comp__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .hp44-comp__table th, .hp44-comp__table td {
    padding: 18px 24px;
    text-align: center;
    border-bottom: 1px solid var(--hp44-comp-border);
    color: #143D2B;
  }

  .hp44-comp__table th {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    background: rgba(20, 61, 43, 0.04);
  }

  .hp44-comp__highlight-col {
    background: var(--hp44-comp-highlight);
    font-weight: 700;
    color: #2D6A4F !important;
  }

  @media screen and (max-width: 600px) {
    .hp44-comp__table th, .hp44-comp__table td { padding: 12px 10px; font-size: 12px; }
  }
{%- endstyle -%}

<div class="hp44-comp__wrapper">
  <div class="hp44-comp__title-block">
    <h2 class="hp44-comp__heading">{{ section.settings.heading | default: 'The Nordic Herbarium Standard' }}</h2>
    <p class="hp44-comp__sub">{{ section.settings.subheading | default: 'How our pure cold-extracted botanical formulas compare to conventional lab cosmetics.' }}</p>
  </div>

  <div class="hp44-comp__table-card">
    <table class="hp44-comp__table">
      <thead>
        <tr>
          <th style="text-align:left;">Botanical Criteria</th>
          <th class="hp44-comp__highlight-col">{{ section.settings.brand_col_title | default: 'Peri Botanical v44' }}</th>
          <th>{{ section.settings.other_col_title | default: 'Commercial Brand' }}</th>
        </tr>
      </thead>
      <tbody>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td style="text-align:left; font-weight:600;">{{ block.settings.feature }}</td>
              <td class="hp44-comp__highlight-col">{{ block.settings.brand_val }}</td>
              <td>{{ block.settings.other_val }}</td>
            </tr>
          {%- endfor -%}
        {%- else -%}
          <tr>
            <td style="text-align:left; font-weight:600;">Clary Sage Purity</td>
            <td class="hp44-comp__highlight-col">100% Cold-Extracted Nordic</td>
            <td>Synthetic Sage Fragrance</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:600;">Carrier Base</td>
            <td class="hp44-comp__highlight-col">Wild Calendula Infusion</td>
            <td>Diluted Water & Mineral Oil</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:600;">Packaging Recyclability</td>
            <td class="hp44-comp__highlight-col">100% Frosted Glass & Birch Wood</td>
            <td>Single-Use Plastic Jars</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:600;">Doorstep Air Delivery</td>
            <td class="hp44-comp__highlight-col">Pre-Paid DDP Duty Express</td>
            <td>Unpaid Postal Duty Clearance</td>
          </tr>
        {%- endif -%}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "HP44 - Sage Matrix",
  "class": "section-hp44-matrix",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#EDF4EE" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border", "label": "Card Border", "default": "#D8E8DC" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#143D2B" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Nordic Herbarium Standard" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "How our botanical formulas compare to conventional lab cosmetics." },
    { "type": "text", "id": "brand_col_title", "label": "Brand Column Title", "default": "Peri Botanical v44" },
    { "type": "text", "id": "other_col_title", "label": "Competitor Column Title", "default": "Commercial Brand" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 960 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Clary Sage Purity" },
        { "type": "text", "id": "brand_val", "label": "Our Value", "default": "100% Cold-Extracted Nordic" },
        { "type": "text", "id": "other_val", "label": "Competitor Value", "default": "Synthetic Sage Fragrance" }
      ]
    }
  ],
  "presets": [
    { "name": "HP44 - Sage Matrix" }
  ]
}
{% endschema %}
