{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp48-feat-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
    --hp48-gold: {{ section.settings.accent_gold | default: '#C59B27' }};
    
    background-color: var(--hp48-feat-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp48-feat__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp48-feat__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp48-feat__heading {
    font-family: 'Cinzel', serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 700;
    color: #1A1715;
    margin: 0 0 8px;
  }

  .hp48-feat__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp48-feat__card {
    background: #FFFFFF;
    border: 1px solid rgba(197, 155, 39, 0.3);
    border-radius: 8px;
    padding: 36px 28px;
    box-shadow: 0 10px 30px rgba(26, 23, 21, 0.04);
    transition: all 0.3s ease;
  }

  .hp48-feat__card:hover {
    border-color: var(--hp48-gold);
    transform: translateY(-4px);
    box-shadow: 0 18px 45px rgba(197, 155, 39, 0.15);
  }

  .hp48-feat__title {
    font-family: 'Cinzel', serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--hp48-gold);
    margin: 0 0 12px;
    letter-spacing: 0.5px;
  }

  .hp48-feat__desc {
    font-size: 13px;
    line-height: 1.8;
    color: #5C554E;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp48-feat__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="hp48-feat__wrap">
  <div class="hp48-feat__header">
    <h2 class="hp48-feat__heading">Royal Cellular Innovations</h2>
    <p style="font-size:13px; color:#5C554E;">{{ section.settings.subheading | default: 'Exclusive biotechnological milestones from our Swiss high-altitude laboratories.' }}</p>
  </div>

  <div class="hp48-feat__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp48-feat__card" {{ block.shopify_attributes }}>
          <h3 class="hp48-feat__title">{{ block.settings.title }}</h3>
          <p class="hp48-feat__desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp48-feat__card">
        <h3 class="hp48-feat__title">Micronized 24K Gold Particles</h3>
        <p class="hp48-feat__desc">Engineered to 50 nanometers to conduct subtle biological micro-currents, promoting collagen synthesis.</p>
      </div>
      <div class="hp48-feat__card">
        <h3 class="hp48-feat__title">Piedmont White Truffle Nectar</h3>
        <p class="hp48-feat__desc">Harvested during peak autumn full moons to preserve high concentrations of natural superoxide dismutase enzymes.</p>
      </div>
      <div class="hp48-feat__card">
        <h3 class="hp48-feat__title">Imperial Akoya Pearl Hydrolysate</h3>
        <p class="hp48-feat__desc">Enriched with 17 amino acids to dissolve hyper-pigmentation clusters and restore regal clarity.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP48 - Royal Feat",
  "class": "section-hp48-features",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF8F5" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#C59B27" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Micronized 24K Gold Particles" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Engineered to 50 nanometers to conduct subtle biological micro-currents." }
      ]
    }
  ],
  "presets": [
    { "name": "HP48 - Royal Feat" }
  ]
}
{% endschema %}
