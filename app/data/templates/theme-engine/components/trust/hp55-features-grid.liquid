{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#1F0B18' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp55-feat__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp55-feat__header { text-align: center; margin-bottom: 50px; }
  .hp55-feat__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#C084FC' }}; margin: 0 0 12px; }
  .hp55-feat__heading { font-family: 'Playfair Display', serif; font-size: clamp(28px, 3.5vw, 42px); color: #FFFFFF; margin: 0; }
  .hp55-feat__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 24px; }
  .hp55-feat__card {
    background: {{ section.settings.card_bg | default: '#2A0E22' }};
    border: 1px solid rgba(233, 213, 255, 0.15); border-radius: 16px; padding: 28px 24px;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .hp55-feat__card:hover { transform: translateY(-4px); border-color: rgba(192, 132, 252, 0.45); }
  .hp55-feat__card-icon {
    width: 48px; height: 48px; background: linear-gradient(135deg, #3B1230, #C084FC);
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 20px; color: #FFFFFF; margin-bottom: 18px;
    border: 1px solid rgba(233, 213, 255, 0.3);
  }
  .hp55-feat__card-title { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 700; color: #FFFFFF; margin: 0 0 8px; }
  .hp55-feat__card-desc { font-size: 13px; line-height: 1.6; color: #E9D5FF; margin: 0; opacity: 0.85; }
  @media screen and (max-width: 992px) { .hp55-feat__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp55-feat__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp55-feat__container">
  <div class="hp55-feat__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp55-feat__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp55-feat__heading">{{ section.settings.heading | default: 'The Royal Alchemy' }}</h2>
  </div>
  <div class="hp55-feat__grid">
    {%- for block in section.blocks -%}
      <div class="hp55-feat__card" {{ block.shopify_attributes }}>
        <div class="hp55-feat__card-icon">{{ block.settings.icon | default: '✦' }}</div>
        <h3 class="hp55-feat__card-title">{{ block.settings.title | default: 'Pearl Science' }}</h3>
        <p class="hp55-feat__card-desc">{{ block.settings.description | default: 'Bio-fermented pearl proteins restore collagen density.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP55 Features",
  "class": "section-hp55-feat",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1F0B18" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#2A0E22" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C084FC" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "✦ ALCHEMY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Royal Alchemy" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "feature", "name": "Feature",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "✦" },
      { "type": "text", "id": "title", "label": "Title", "default": "Pearl Science" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "Bio-fermented pearl proteins restore collagen density." }
    ]
  }],
  "presets": [{
    "name": "HP55 Features",
    "blocks": [
      { "type": "feature", "settings": { "icon": "🦪", "title": "Conchiolin Nacre Matrix", "description": "17 essential amino acids naturally rebuilding epidermal mesh." } },
      { "type": "feature", "settings": { "icon": "👑", "title": "Wild Plum Bio-Lipids", "description": "Cold-pressed French plums restoring optimal skin moisture barrier." } },
      { "type": "feature", "settings": { "icon": "🌸", "title": "Black Orchid Phyto-Complex", "description": "Immortal orchid extract protecting telomeres from cellular aging." } },
      { "type": "feature", "settings": { "icon": "✨", "title": "24K Colloidal Gold", "description": "Ionic gold micro-particles accelerating deep active delivery." } },
      { "type": "feature", "settings": { "icon": "💎", "title": "Velvet Touch Finish", "description": "Non-greasy, feather-light dry oil infusion with satin sheen." } },
      { "type": "feature", "settings": { "icon": "🛡️", "title": "Dermatological Mastery", "description": "Clinically validated across 500+ diverse luxury skin profiles." } }
    ]
  }]
}
{% endschema %}
