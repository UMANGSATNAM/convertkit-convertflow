{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Shrikhand&family=DM+Sans:wght@400;500;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Shrikhand', cursive;
    --font-body: 'DM Sans', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp37-usp-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 60px;
  }

  @media screen and (max-width: 992px) {
    .hp37-usp-wrapper {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp37-usp-wrapper {
      padding: 0 20px;
    }
  }

  .hp37-usp__item {
    text-align: center;
    background: #fff;
    padding: 40px 30px;
    border-radius: 20px;
    border: 3px solid var(--text-color);
    box-shadow: 6px 6px 0px var(--text-color);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  
  .hp37-usp__item:hover {
    transform: translate(3px, 3px);
    box-shadow: 3px 3px 0px var(--text-color);
  }

  .hp37-usp__icon {
    width: 60px;
    height: 60px;
    margin: 0 auto 20px;
    background: var(--accent-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-color);
    border: 2px solid var(--text-color);
  }

  .hp37-usp__icon svg {
    width: 30px;
    height: 30px;
    fill: currentColor;
  }

  .hp37-usp__title {
    font-family: var(--font-heading);
    font-size: 24px;
    color: var(--text-color);
    margin: 0 0 15px;
    letter-spacing: 0.05em;
  }

  .hp37-usp__text {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    line-height: 1.5;
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp37-usp-wrapper" id="HP37USP-{{ section.id }}">
  {%- for block in section.blocks -%}
    <div class="hp37-usp__item" {{ block.shopify_attributes }}>
      <div class="hp37-usp__icon">
        {%- if block.settings.icon_name == 'sun' -%}
          <svg viewBox="0 0 24 24"><path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18.75a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25a.75.75 0 01.75-.75zM6.166 17.834a.75.75 0 00-1.06 1.06l1.59 1.591a.75.75 0 101.06-1.061l-1.59-1.591zM4.5 12a.75.75 0 01-.75-.75H1.5a.75.75 0 010 1.5h2.25A.75.75 0 014.5 12zM5.106 6.166a.75.75 0 001.06-1.06l-1.59-1.59a.75.75 0 10-1.06 1.061l1.59 1.59z"/></svg>
        {%- elsif block.settings.icon_name == 'wave' -%}
          <svg viewBox="0 0 24 24"><path d="M2 12c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
        {%- else -%}
          <svg viewBox="0 0 24 24"><path d="M4 12l4 4 12-12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {%- endif -%}
      </div>
      <h3 class="hp37-usp__title">{{ block.settings.title }}</h3>
      <p class="hp37-usp__text">{{ block.settings.text }}</p>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP37 - Retro USP",
  "class": "section-hp37-usp",
  "settings": [
    {
      "type": "header",
      "content": "Retro Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4E3C5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A3219"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#798A58"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Value Prop",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon_name",
          "label": "Icon",
          "options": [
            { "value": "sun", "label": "Sun" },
            { "value": "wave", "label": "Wave" },
            { "value": "check", "label": "Check" }
          ],
          "default": "sun"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Organic Cotton"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Kind to the earth, soft on the skin."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP37 - Retro USP",
      "blocks": [
        { "type": "usp", "settings": { "icon_name": "sun", "title": "Sunshine Made", "text": "Designed under the California sun." } },
        { "type": "usp", "settings": { "icon_name": "wave", "title": "Ocean Friendly", "text": "Sustainable materials for a better tomorrow." } },
        { "type": "usp", "settings": { "icon_name": "check", "title": "Lifetime Guarantee", "text": "Built to last through all your adventures." } }
      ]
    }
  ]
}
{% endschema %}
