{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    
    --font-heading: 'Space Grotesk', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding: 80px 20px;
  }

  .hp41-usp-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp41-usp-wrapper {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  .hp41-usp__card {
    padding: 40px;
    background: #FFF;
    border: 4px solid var(--border-color);
    border-radius: 16px;
    box-shadow: 8px 8px 0px var(--border-color);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.2s ease;
  }
  
  /* Give them some brutalist asymmetry via nth-child backgrounds */
  .hp41-usp__card:nth-child(1) { background: #D7FF43; } /* Lime */
  .hp41-usp__card:nth-child(2) { background: #F0A8E3; } /* Pink */
  .hp41-usp__card:nth-child(3) { background: #38C6F4; } /* Cyan */
  .hp41-usp__card:nth-child(4) { background: #FF4911; color: #FFF; } /* Orange */

  .hp41-usp__card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0px var(--border-color);
  }
  
  .hp41-usp__card:active {
    transform: translate(4px, 4px);
    box-shadow: 4px 4px 0px var(--border-color);
  }

  .hp41-usp__icon {
    width: 80px;
    height: 80px;
    background: #FFF;
    border: 3px solid var(--border-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    box-shadow: 4px 4px 0px var(--border-color);
  }

  .hp41-usp__icon svg {
    width: 40px;
    height: 40px;
    fill: var(--border-color);
  }

  .hp41-usp__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--border-color);
    margin: 0 0 10px;
    text-transform: uppercase;
  }
  
  .hp41-usp__card:nth-child(4) .hp41-usp__title { color: #FFF; }

  .hp41-usp__text {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    color: var(--border-color);
    margin: 0;
  }
  
  .hp41-usp__card:nth-child(4) .hp41-usp__text { color: #FFF; }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp41-usp-wrapper" id="HP41Usp-{{ section.id }}">
  {%- for block in section.blocks limit: 4 -%}
    <div class="hp41-usp__card" {{ block.shopify_attributes }}>
      
      <div class="hp41-usp__icon">
        <!-- Fun abstract shape depending on index -->
        {%- if forloop.index == 1 -%}
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        {%- elsif forloop.index == 2 -%}
          <svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        {%- else -%}
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
        {%- endif -%}
      </div>
      
      <h3 class="hp41-usp__title">{{ block.settings.title }}</h3>
      {%- if block.settings.text != blank -%}
        <p class="hp41-usp__text">{{ block.settings.text }}</p>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP41 - Neo USP",
  "class": "section-hp41-usp",
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 28
    },
    {
      "type": "header",
      "content": "Neo Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FDF0D5"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "FUN STUFF"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Cool things that do cool things."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP41 - Neo USP",
      "blocks": [
        { "type": "benefit", "settings": { "title": "FAST AF SHIPPING" } },
        { "type": "benefit", "settings": { "title": "CRAZY GOOD" } },
        { "type": "benefit", "settings": { "title": "EASY RETURNS" } }
      ]
    }
  ]
}
{% endschema %}
