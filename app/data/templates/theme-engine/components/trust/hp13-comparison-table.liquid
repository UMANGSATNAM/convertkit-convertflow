{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#00FFA3'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 1px solid #333;
  }
  
  .hp13-comparison-container-{{ section_id }} {
    max-width: 1000px;
    margin: 0 auto;
    border: 1px solid {{ text_color }};
    background: #111;
    padding: 40px;
    position: relative;
  }
  
  .hp13-comparison-container-{{ section_id }}::before {
    content: '';
    position: absolute;
    bottom: -10px; right: -10px;
    width: 20px; height: 20px;
    border-bottom: 2px solid {{ text_color }};
    border-right: 2px solid {{ text_color }};
  }
  
  .hp13-comparison-heading-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    text-align: left;
    margin: 0 0 40px 0;
    color: #FFF;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  
  .hp13-comparison-heading-{{ section_id }} span {
    color: {{ text_color }};
  }
  
  .hp13-comparison-table-wrap-{{ section_id }} {
    overflow-x: auto;
  }
  
  .hp13-comparison-table-{{ section_id }} {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 600px;
  }
  
  .hp13-comparison-table-{{ section_id }} th,
  .hp13-comparison-table-{{ section_id }} td {
    padding: 20px;
    border-bottom: 1px solid #333;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9rem;
  }
  
  .hp13-comparison-table-{{ section_id }} th {
    font-weight: bold;
    text-transform: uppercase;
    color: #666;
    border-bottom: 1px solid {{ text_color }};
  }
  
  .hp13-comparison-table-{{ section_id }} td.hp13-feature-{{ section_id }} {
    color: #FFF;
    font-weight: bold;
    text-transform: uppercase;
  }
  
  .hp13-comparison-table-{{ section_id }} td.hp13-us-{{ section_id }} {
    color: {{ text_color }};
    font-weight: bold;
  }
  
  .hp13-comparison-table-{{ section_id }} td.hp13-them-{{ section_id }} {
    color: #999;
    text-decoration: line-through;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp13-comparison-container-{{ section_id }} {
      padding: 20px;
    }
    .hp13-comparison-table-{{ section_id }} th,
    .hp13-comparison-table-{{ section_id }} td {
      padding: 15px 10px;
    }
  }
</style>

<div class="hp13-comparison-container-{{ section_id }}">
  <h2 class="hp13-comparison-heading-{{ section_id }}">SPEC <span>COMPARISON</span></h2>
  
  <div class="hp13-comparison-table-wrap-{{ section_id }}">
    <table class="hp13-comparison-table-{{ section_id }}">
      <thead>
        <tr>
          <th>MODULE_TYPE</th>
          <th>CYBER_SYS (US)</th>
          <th>LEGACY_BRANDS</th>
        </tr>
      </thead>
      <tbody>
        {% for block in section.blocks %}
          <tr>
            <td class="hp13-feature-{{ section_id }}">{{ block.settings.feature }}</td>
            <td class="hp13-us-{{ section_id }}">[+] {{ block.settings.us_desc }}</td>
            <td class="hp13-them-{{ section_id }}">[-] {{ block.settings.them_desc }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "HP13 Comparison Table",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Highlight Color",
      "default": "#00FFA3"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature Name",
          "default": "MATERIAL_TIER"
        },
        {
          "type": "text",
          "id": "us_desc",
          "label": "Our Approach",
          "default": "MIL-SPEC CORDURA"
        },
        {
          "type": "text",
          "id": "them_desc",
          "label": "Legacy Approach",
          "default": "BASIC POLYESTER"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP13 Comparison Table",
      "blocks": [
        { "type": "feature", "settings": { "feature": "MATERIAL_TIER", "us_desc": "MIL-SPEC CORDURA", "them_desc": "BASIC POLYESTER" } },
        { "type": "feature", "settings": { "feature": "WATER_RESISTANCE", "us_desc": "10,000MM HYDROSTATIC", "them_desc": "LIGHT DWR COATING" } },
        { "type": "feature", "settings": { "feature": "MODULARITY", "us_desc": "FULL MOLLE COMPATIBLE", "them_desc": "STATIC DESIGN" } }
      ]
    }
  ]
}
{% endschema %}
