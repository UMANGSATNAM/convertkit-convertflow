{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#042F2E' }};
    padding-top: {{ section.settings.padding_top | default: 50 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
  }
  .hp59-trust__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp59-trust__grid { display: flex; justify-content: center; gap: 50px; flex-wrap: wrap; }
  .hp59-trust__item { display: flex; align-items: center; gap: 14px; }
  .hp59-trust__icon {
    width: 44px; height: 44px; background: linear-gradient(135deg, #0F766E, #115E59);
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 18px; color: #FEF3C7; flex-shrink: 0;
    border: 1px solid rgba(254, 243, 199, 0.3);
  }
  .hp59-trust__label { font-family: 'Cormorant Garamond', serif; font-size: 16px; font-weight: 700; color: #FFFFFF; margin: 0; }
  .hp59-trust__sub { font-size: 11px; color: #99F6E4; margin: 2px 0 0; }
  @media screen and (max-width: 768px) { .hp59-trust__grid { gap: 24px; } }
  @media screen and (max-width: 480px) {
    .hp59-trust__grid { flex-direction: column; align-items: center; text-align: center; }
    .hp59-trust__item { flex-direction: column; }
  }
{%- endstyle -%}
<div class="hp59-trust__container">
  <div class="hp59-trust__grid">
    {%- for block in section.blocks -%}
      <div class="hp59-trust__item" {{ block.shopify_attributes }}>
        <div class="hp59-trust__icon">{{ block.settings.icon | default: '🪸' }}</div>
        <div>
          <p class="hp59-trust__label">{{ block.settings.title | default: '100% Coral Reef Safe' }}</p>
          <p class="hp59-trust__sub">{{ block.settings.subtitle | default: 'Eco-certified ocean formula' }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP59 Trust",
  "class": "section-hp59-trust",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#042F2E" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 50 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "badge", "name": "Badge",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🪸" },
      { "type": "text", "id": "title", "label": "Title", "default": "100% Coral Reef Safe" },
      { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Eco-certified ocean formula" }
    ]
  }],
  "presets": [{
    "name": "HP59 Trust",
    "blocks": [
      { "type": "badge", "settings": { "icon": "🪸", "title": "100% Coral Reef Safe", "subtitle": "Eco-certified ocean formula" } },
      { "type": "badge", "settings": { "icon": "🌊", "title": "Sustainably Wild Harvested", "subtitle": "Protected coastal kelp" } },
      { "type": "badge", "settings": { "icon": "📦", "title": "Ocean Plastic Free Box", "subtitle": "Compostable sugarcane fiber" } },
      { "type": "badge", "settings": { "icon": "🛡️", "title": "Marine Radiance Promise", "subtitle": "45-day satisfaction guarantee" } }
    ]
  }]
}
{% endschema %}
