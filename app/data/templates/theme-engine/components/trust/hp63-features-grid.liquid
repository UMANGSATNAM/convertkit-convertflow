{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FFFBEB' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp63-feat__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp63-feat__header { text-align: center; margin-bottom: 50px; }
  .hp63-feat__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#881337' }}; margin: 0 0 12px; }
  .hp63-feat__heading { font-family: 'Playfair Display', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #1C1917; margin: 0; }
  .hp63-feat__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 24px; }
  .hp63-feat__card {
    background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border: 1px solid rgba(217, 119, 6, 0.25); border-radius: 6px; padding: 28px 24px;
    box-shadow: 0 4px 20px rgba(136, 19, 55, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hp63-feat__card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(136, 19, 55, 0.12); }
  .hp63-feat__card-icon {
    width: 48px; height: 48px; background: linear-gradient(135deg, #FCE7F3, #881337);
    border-radius: 4px; display: flex; align-items: center; justify-content: center;
    font-size: 20px; color: #FFFFFF; margin-bottom: 18px;
    border: 1px solid rgba(217, 119, 6, 0.3);
  }
  .hp63-feat__card-title { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 700; color: #1C1917; margin: 0 0 8px; }
  .hp63-feat__card-desc { font-size: 13px; line-height: 1.6; color: #57534E; margin: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
  @media screen and (max-width: 992px) { .hp63-feat__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp63-feat__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp63-feat__container">
  <div class="hp63-feat__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp63-feat__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp63-feat__heading">{{ section.settings.heading | default: 'The Moroccan Apothecary Matrix' }}</h2>
  </div>
  <div class="hp63-feat__grid">
    {%- for block in section.blocks -%}
      <div class="hp63-feat__card" {{ block.shopify_attributes }}>
        <div class="hp63-feat__card-icon">{{ block.settings.icon | default: '🌹' }}</div>
        <h3 class="hp63-feat__card-title">{{ block.settings.title | default: 'Damask Rose' }}</h3>
        <p class="hp63-feat__card-desc">{{ block.settings.description | default: 'Moroccan botanical treasures.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP63 Features",
  "class": "section-hp63-feat",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFBEB" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#881337" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌹 BOTANICAL MATRIX" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Moroccan Apothecary Matrix" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "feature", "name": "Feature",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🌹" },
      { "type": "text", "id": "title", "label": "Title", "default": "Damask Rose" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "Moroccan botanical treasures." }
    ]
  }],
  "presets": [{
    "name": "HP63 Features",
    "blocks": [
      { "type": "feature", "settings": { "icon": "🌹", "title": "Dades Valley Damask Rose", "description": "Single-origin steam-distilled hydrosol restoring cellular hydration and balancing skin pH." } },
      { "type": "feature", "settings": { "icon": "🏺", "title": "45-Day Macerated Amber", "description": "Aged Moroccan pine resin soothing hyper-reactive nerves and locking in deep lipid moisture." } },
      { "type": "feature", "settings": { "icon": "✨", "title": "First-Press Desert Argan", "description": "Hand-cracked argan kernels providing rich linoleic acid and natural antioxidant squalene." } },
      { "type": "feature", "settings": { "icon": "🍊", "title": "Moroccan Neroli Blossom", "description": "Steam-extracted citrus flower essence calming dermal tension and evening discoloration." } },
      { "type": "feature", "settings": { "icon": "🌱", "title": "Prickly Pear Seed Nectar", "description": "The world's most concentrated botanical source of vitamin K for brightening under-eye shadows." } },
      { "type": "feature", "settings": { "icon": "🛡️", "title": "Berber Cooperative Direct", "description": "Ethically traded, supporting women's agricultural collectives throughout Southern Morocco." } }
    ]
  }]
}
{% endschema %}
