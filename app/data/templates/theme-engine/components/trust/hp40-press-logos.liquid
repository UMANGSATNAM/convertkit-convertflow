{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    
    --font-heading: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    border-bottom: 2px solid var(--text-color);
  }

  .hp40-press-wrapper {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  @media screen and (max-width: 992px) {
    .hp40-press-wrapper {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .hp40-press__header {
    grid-column: 1 / -1;
    padding: 40px;
    border-bottom: 2px solid var(--text-color);
    text-align: center;
  }

  .hp40-press__title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0;
  }

  .hp40-press__item {
    border-right: 2px solid var(--text-color);
    border-bottom: 2px solid var(--text-color);
    padding: 60px 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-color);
    transition: background 0.3s ease;
  }

  /* Handle Borders */
  .hp40-press__item:nth-child(4n) {
    border-right: none;
  }
  .hp40-press__item:nth-last-child(-n+4) {
    /* Depending on row count, bottom borders can be complex. In Swiss, it's fine if the grid is just fully walled */
  }

  @media screen and (max-width: 992px) {
    .hp40-press__item:nth-child(even) {
      border-right: none;
    }
    .hp40-press__item:nth-child(odd) {
      border-right: 2px solid var(--text-color);
    }
  }

  .hp40-press__item:hover {
    background: var(--text-color);
  }

  .hp40-press__logo {
    max-height: 40px;
    width: auto;
    filter: grayscale(100%) contrast(200%);
    transition: filter 0.3s ease, invert 0.3s ease;
  }
  
  /* Invert black logo to white on hover when bg turns black */
  .hp40-press__item:hover .hp40-press__logo {
    filter: invert(1);
  }
  
  /* If background is dark mode */
  .hp40-press-wrapper.is-dark .hp40-press__logo {
    filter: invert(1);
  }
  .hp40-press-wrapper.is-dark .hp40-press__item:hover .hp40-press__logo {
    filter: invert(0);
  }

  .hp40-press__text-fallback {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 900;
    color: var(--text-color);
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .hp40-press__item:hover .hp40-press__text-fallback {
    color: var(--bg-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

{%- assign is_dark = false -%}
{%- if section.settings.bg_color == '#111111' or section.settings.bg_color == '#000000' -%}
  {%- assign is_dark = true -%}
{%- endif -%}

<div class="hp40-press-wrapper {% if is_dark %}is-dark{% endif %}" id="HP40Press-{{ section.id }}">
  
  <div class="hp40-press__header">
    <h3 class="hp40-press__title">ACCREDITATION</h3>
  </div>

  {%- for block in section.blocks -%}
    <div class="hp40-press__item" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: height: 80 }}" alt="Press Logo" class="hp40-press__logo" loading="lazy">
      {%- else -%}
        <div class="hp40-press__text-fallback">{{ block.settings.text_fallback }}</div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP40 - Swiss Press",
  "class": "section-hp40-press-logos",
  "settings": [
    {
      "type": "header",
      "content": "Swiss Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Lines",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "text_fallback",
          "label": "Text Fallback",
          "default": "MEDIA"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP40 - Swiss Press",
      "blocks": [
        { "type": "logo", "settings": { "text_fallback": "VOGUE" } },
        { "type": "logo", "settings": { "text_fallback": "GQ" } },
        { "type": "logo", "settings": { "text_fallback": "WIRED" } },
        { "type": "logo", "settings": { "text_fallback": "FORBES" } }
      ]
    }
  ]
}
{% endschema %}
