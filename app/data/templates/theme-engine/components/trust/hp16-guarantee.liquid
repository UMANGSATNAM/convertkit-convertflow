{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#00FFFF'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 40px;
    border-bottom: 4px solid #000;
  }
  
  .hp16-guar-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }
  
  .hp16-guar-item-{{ section_id }} {
    text-align: center;
    color: {{ text_color }};
  }
  
  .hp16-guar-icon-{{ section_id }} {
    width: 60px;
    height: 60px;
    background: #FFF;
    border: 3px solid #000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 15px;
    box-shadow: 4px 4px 0 #FF00FF;
    transform: rotate(-10deg);
  }
  
  .hp16-guar-item-{{ section_id }}:nth-child(even) .hp16-guar-icon-{{ section_id }} {
    box-shadow: 4px 4px 0 #FFFF00;
    transform: rotate(10deg);
  }
  
  .hp16-guar-icon-{{ section_id }} svg {
    width: 30px;
    height: 30px;
    stroke-width: 2.5;
  }
  
  .hp16-guar-title-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: 1.1rem;
    text-transform: uppercase;
    margin: 0 0 10px 0;
  }
  
  .hp16-guar-text-{{ section_id }} {
    font-family: 'Comic Sans MS', cursive;
    font-size: 0.9rem;
    font-weight: bold;
    margin: 0;
  }

  @media (max-width: 992px) {
    .hp16-guar-container-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 20px;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 40px 20px;
    }
    .hp16-guar-container-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="hp16-guar-container-{{ section_id }}">
  {% for block in section.blocks limit: 4 %}
    <div class="hp16-guar-item-{{ section_id }}" {{ block.shopify_attributes }}>
      <div class="hp16-guar-icon-{{ section_id }}">
        {% if block.settings.icon == 'shipping' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="22" y1="12" x2="2" y2="12"></line><polyline points="15 5 22 12 15 19"></polyline></svg>
        {% elsif block.settings.icon == 'return' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
        {% elsif block.settings.icon == 'heart' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
        {% else %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>
        {% endif %}
      </div>
      <h3 class="hp16-guar-title-{{ section_id }}">{{ block.settings.title }}</h3>
      <p class="hp16-guar-text-{{ section_id }}">{{ block.settings.text }}</p>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP16 Guarantee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "guarantee",
      "name": "Guarantee Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "return", "label": "Return" },
            { "value": "heart", "label": "Heart" },
            { "value": "smile", "label": "Smile" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "FAST AF SHIPPING"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Free on orders over $75."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP16 Guarantee",
      "blocks": [
        { "type": "guarantee", "settings": { "icon": "shipping", "title": "FAST AF SHIPPING", "text": "Free on orders over $75." } },
        { "type": "guarantee", "settings": { "icon": "heart", "title": "SO CUTE", "text": "Guaranteed to turn heads." } },
        { "type": "guarantee", "settings": { "icon": "return", "title": "EASY RETURNS", "text": "Send it back within 30 days." } },
        { "type": "guarantee", "settings": { "icon": "smile", "title": "BFF SUPPORT", "text": "We are here for you 24/7." } }
      ]
    }
  ]
}
{% endschema %}
