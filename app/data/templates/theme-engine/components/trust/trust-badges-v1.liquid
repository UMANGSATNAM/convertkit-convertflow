{% schema %}
{
  "name": "Trust Badges (Beauty v1)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fafafa"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon_name",
          "label": "Icon Name",
          "info": "E.g., leaf, check, star, lab",
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "100% Organic"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges (Beauty v1)",
      "category": "Trust",
      "blocks": [
        { "type": "badge", "settings": { "icon_name": "leaf", "heading": "Vegan & Cruelty Free" } },
        { "type": "badge", "settings": { "icon_name": "lab", "heading": "quality tested" } },
        { "type": "badge", "settings": { "icon_name": "globe", "heading": "Sustainably Sourced" } },
        { "type": "badge", "settings": { "icon_name": "shield", "heading": "Clean Ingredients" } }
      ]
    }
  ]
}
{% endschema %}

<div class="trust-badges trust-badges--beauty" style="background-color: {{ section.settings.bg_color }}; padding: 3rem 1rem;">
  <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: center; gap: 3rem; flex-wrap: wrap;">
    {% for block in section.blocks %}
      <div class="trust-badge" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1rem; width: 150px;" {{ block.shopify_attributes }}>
        <div class="trust-badge__icon" style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-bg); box-shadow: var(--shadow-sm); color: var(--color-primary);">
          {% case block.settings.icon_name %}
            {% when 'leaf' %}
              {% render 'icon-leaf' %}
            {% when 'lab' %}
              {% render 'icon-lab' %}
            {% when 'globe' %}
              {% render 'icon-globe' %}
            {% when 'shield' %}
              {% render 'icon-shield' %}
            {% else %}
              {% render 'icon-check' %}
          {% endcase %}
        </div>
        <span style="font-family: var(--font-body-family); font-size: 0.9rem; font-weight: 600; color: var(--color-text);">{{ block.settings.heading }}</span>
      </div>
    {% endfor %}
  </div>
</div>
