{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FFFDF0' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp60-comp__container { max-width: {{ section.settings.container_width | default: 1000 }}px; margin: 0 auto; padding: 0 24px; }
  .hp60-comp__header { text-align: center; margin-bottom: 50px; }
  .hp60-comp__eyebrow { font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#3F6212' }}; margin: 0 0 12px; }
  .hp60-comp__heading { font-family: 'Bodoni Moda', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #1E293B; margin: 0; }
  .hp60-comp__table {
    width: 100%; border-collapse: collapse; background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border-radius: 8px; overflow: hidden; border: 1px solid rgba(63, 98, 18, 0.2);
    box-shadow: 0 4px 25px rgba(63, 98, 18, 0.08);
  }
  .hp60-comp__table th {
    background: #FEFCE8; color: #3F6212; font-family: 'Outfit', sans-serif;
    font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    padding: 18px 20px; text-align: left; border-bottom: 1px solid rgba(63, 98, 18, 0.2);
  }
  .hp60-comp__table td {
    padding: 16px 20px; font-size: 14px; color: #334155;
    border-bottom: 1px solid rgba(63, 98, 18, 0.1);
  }
  .hp60-comp__table tr:last-child td { border-bottom: none; }
  .hp60-comp__check { color: #3F6212; font-weight: 700; }
  @media screen and (max-width: 768px) {
    .hp60-comp__table { font-size: 13px; }
    .hp60-comp__table th, .hp60-comp__table td { padding: 12px 14px; }
  }
{%- endstyle -%}
<div class="hp60-comp__container">
  <div class="hp60-comp__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp60-comp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp60-comp__heading">{{ section.settings.heading | default: 'The Tuscan Quality Standard' }}</h2>
  </div>
  <table class="hp60-comp__table">
    <thead>
      <tr>
        <th>{{ section.settings.col1_head | default: 'Attribute' }}</th>
        <th>{{ section.settings.col2_head | default: 'Tuscan Citrus Estate' }}</th>
        <th>{{ section.settings.col3_head | default: 'Mass Market Skincare' }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for block in section.blocks -%}
        <tr {{ block.shopify_attributes }}>
          <td>{{ block.settings.feature | default: 'Milling Temperature' }}</td>
          <td class="hp60-comp__check">{{ block.settings.us | default: '🏛️ Cold Milled < 22°C' }}</td>
          <td style="color:#64748B;">{{ block.settings.them | default: 'High Heat Industrial' }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
</div>
{% schema %}
{
  "name": "HP60 Compare",
  "class": "section-hp60-comp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFDF0" },
    { "type": "color", "id": "card_bg", "label": "Table BG", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#3F6212" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🏛️ STANDARDS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Tuscan Quality Standard" },
    { "type": "text", "id": "col1_head", "label": "Column 1", "default": "Attribute" },
    { "type": "text", "id": "col2_head", "label": "Column 2", "default": "Tuscan Citrus Estate" },
    { "type": "text", "id": "col3_head", "label": "Column 3", "default": "Mass Market Skincare" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 1000 }
  ],
  "blocks": [{
    "type": "row", "name": "Row",
    "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "Milling Temperature" },
      { "type": "text", "id": "us", "label": "Us", "default": "🏛️ Cold Milled < 22°C" },
      { "type": "text", "id": "them", "label": "Others", "default": "High Heat Industrial" }
    ]
  }],
  "presets": [{
    "name": "HP60 Compare",
    "blocks": [
      { "type": "row", "settings": { "feature": "Olive Oleuropein Content", "us": "🏛️ 400% Concentrated Polyphenols", "them": "Diluted Solvent Extraction" } },
      { "type": "row", "settings": { "feature": "Bergamot Processing", "us": "🏛️ 100% Bergapten-Free Sun Safe", "them": "Photosensitizing Unpurified" } },
      { "type": "row", "settings": { "feature": "Estate Traceability", "us": "🏛️ Single Tuscan Grove Origin", "them": "Commingled Global Bulk Oils" } },
      { "type": "row", "settings": { "feature": "Carrier Base", "us": "🏛️ First Press Extra Virgin Olive Oil", "them": "Synthetic Silicones & Fillers" } }
    ]
  }]
}
{% endschema %}
