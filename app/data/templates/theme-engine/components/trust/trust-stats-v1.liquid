{% schema %}
{
  "name": "Trust Stats (Lifestyle)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Movement"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "10k+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Happy Customers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Stats (Lifestyle)",
      "category": "Trust",
      "blocks": [
        { "type": "stat", "settings": { "number": "50k+", "label": "Orders Shipped" } },
        { "type": "stat", "settings": { "number": "4.9/5", "label": "Average Rating" } },
        { "type": "stat", "settings": { "number": "100%", "label": "Satisfaction" } }
      ]
    }
  ]
}
{% endschema %}

<div class="trust-stats trust-stats--lifestyle" style="padding: 5rem 2rem; background: var(--color-text); color: var(--color-bg); text-align: center;">
  <h2 style="font-family: var(--font-heading-family); font-size: 2.5rem; margin-bottom: 4rem;">{{ section.settings.heading }}</h2>
  
  <div style="max-width: 1000px; margin: 0 auto; display: flex; justify-content: space-around; flex-wrap: wrap; gap: 3rem;">
    {% for block in section.blocks %}
      <div class="trust-stat" style="display: flex; flex-direction: column; gap: 0.5rem;" {{ block.shopify_attributes }}>
        <span style="font-family: var(--font-heading-family); font-size: 4rem; font-weight: bold; line-height: 1; color: var(--color-primary);">{{ block.settings.number }}</span>
        <span style="font-family: var(--font-body-family); font-size: 1.2rem; text-transform: uppercase; letter-spacing: 0.1em; opacity: 0.9;">{{ block.settings.label }}</span>
      </div>
    {% endfor %}
  </div>
</div>
