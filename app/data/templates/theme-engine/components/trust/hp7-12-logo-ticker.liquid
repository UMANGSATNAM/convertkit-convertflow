{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#F4F4F0'
  assign text_color = section.settings.text_color | default: '#050505'
  assign speed = section.settings.speed | default: 30
  assign padding_y = section.settings.padding_y | default: 40
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --padding-y: {{ padding_y }}px;
    --speed: {{ speed }}s;
    
    background-color: var(--bg-color);
    overflow: hidden;
    position: relative;
    padding: var(--padding-y) 0;
    display: flex;
    align-items: center;
  }

  .hp7-logoticker-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    width: 100%;
  }

  .hp7-logoticker__content {
    display: flex;
    animation: hp7-logoticker-scroll var(--speed) linear infinite;
  }
  
  .hp7-logoticker-{{ section_id }}:hover .hp7-logoticker__content {
    animation-play-state: paused;
  }

  .hp7-logoticker__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 4vw;
  }

  .hp7-logoticker__item img {
    height: 40px;
    width: auto;
    object-fit: contain;
    /* Force logos to match text color for brutalist starkness */
    filter: brightness(0) invert({% if text_color contains '#F' or text_color contains '#f' %}1{% else %}0{% endif %});
    opacity: 0.7;
    transition: opacity 0.3s;
  }
  
  .hp7-logoticker__item:hover img {
    opacity: 1;
  }
  
  /* Fallback text if no image */
  .hp7-logoticker__text {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-color);
    text-transform: uppercase;
  }

  @keyframes hp7-logoticker-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media screen and (max-width: 768px) {
    .hp7-logoticker__item img {
      height: 30px;
    }
  }
</style>

<section class="hp7-logoticker-{{ section_id }}" aria-hidden="true">
  <div class="hp7-logoticker__content">
    {%- capture ticker_items -%}
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="hp7-logoticker__item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy' }}
            {%- else -%}
              <span class="hp7-logoticker__text">{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="hp7-logoticker__item"><span class="hp7-logoticker__text">VOGUE</span></div>
        <div class="hp7-logoticker__item"><span class="hp7-logoticker__text">GQ</span></div>
        <div class="hp7-logoticker__item"><span class="hp7-logoticker__text">DAZED</span></div>
        <div class="hp7-logoticker__item"><span class="hp7-logoticker__text">HYPEBEAST</span></div>
        <div class="hp7-logoticker__item"><span class="hp7-logoticker__text">HIGHSNOBIETY</span></div>
      {%- endif -%}
    {%- endcapture -%}

    <!-- Loop to ensure infinite scroll -->
    {{ ticker_items }}
    {{ ticker_items }}
    {{ ticker_items }}
    {{ ticker_items }}
  </div>
</section>

{% schema %}
{
  "name": "HP7 Logo Ticker",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Aesthetic: Editorial Brutalism",
      "info": "A high contrast, color-inverted infinite logo scroll."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Icon/Text Color",
      "default": "#050505"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "sec",
      "label": "Scroll Speed",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 10,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image (SVG/PNG)"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Fallback Text",
          "default": "MAGAZINE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP7 Logo Ticker",
      "blocks": [
        { "type": "logo", "settings": { "text": "VOGUE" } },
        { "type": "logo", "settings": { "text": "DAZED" } },
        { "type": "logo", "settings": { "text": "HYPEBEAST" } }
      ]
    }
  ]
}
{% endschema %}
