{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&family=JetBrains+Mono:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --grid-color: rgba(255, 255, 255, 0.1);
    
    --font-heading: 'Inter', sans-serif;
    --font-body: 'JetBrains Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--grid-color);
  }

  .hp34-usp-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp34-usp-wrapper {
      padding: 0 20px;
    }
  }

  .hp34-usp__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 1px; /* 1px gap for grid lines */
    background: var(--grid-color);
    border: 1px solid var(--grid-color);
  }

  @media screen and (max-width: 992px) {
    .hp34-usp__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 576px) {
    .hp34-usp__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp34-usp__item {
    background: var(--bg-color);
    padding: 40px 30px;
    position: relative;
    transition: background 0.3s ease;
  }

  .hp34-usp__item:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .hp34-usp__id {
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--accent-color);
    position: absolute;
    top: 15px;
    right: 15px;
  }

  .hp34-usp__icon {
    font-size: 24px;
    color: var(--accent-color);
    margin-bottom: 20px;
    font-family: var(--font-body);
  }

  .hp34-usp__title {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .hp34-usp__text {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp34-usp-wrapper" id="HP34Usp-{{ section.id }}">
  <div class="hp34-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp34-usp__item" {{ block.shopify_attributes }}>
        <div class="hp34-usp__id">MOD.{{ forloop.index | prepend: '0' }}</div>
        
        <div class="hp34-usp__icon">
          {%- if block.settings.custom_icon != blank -%}
            {{ block.settings.custom_icon }}
          {%- else -%}
            [x]
          {%- endif -%}
        </div>
        
        <h3 class="hp34-usp__title">{{ block.settings.title }}</h3>
        <p class="hp34-usp__text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP34 - Tech USP",
  "class": "section-hp34-usp",
  "max_blocks": 4,
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Tech Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF4500"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "text",
          "id": "custom_icon",
          "label": "Icon (Text/Emoji)",
          "default": "[!]"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "RAPID DEPLOYMENT"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Shipping modules activated globally within 24h."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP34 - Tech USP",
      "blocks": [
        { "type": "usp", "settings": { "custom_icon": "[!]", "title": "RAPID DEPLOYMENT" } },
        { "type": "usp", "settings": { "custom_icon": "[*]", "title": "VERIFIED QUALITY" } },
        { "type": "usp", "settings": { "custom_icon": "[<]", "title": "DATA ENCRYPTED" } },
        { "type": "usp", "settings": { "custom_icon": "[~]", "title": "24/7 SUPPORT_LOG" } }
      ]
    }
  ]
}
{% endschema %}
