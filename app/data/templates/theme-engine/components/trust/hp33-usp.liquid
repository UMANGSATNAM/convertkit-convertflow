{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --gold-color: {{ section.settings.gold_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Montserrat', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .hp33-usp-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp33-usp-wrapper {
      padding: 0 20px;
    }
  }

  .hp33-usp__container {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--gold-color);
    border-bottom: 1px solid var(--gold-color);
    padding: 60px 0;
    position: relative;
  }

  /* Inner thin line */
  .hp33-usp__container::before,
  .hp33-usp__container::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    height: 1px;
    background: rgba(212, 175, 55, 0.3);
  }

  .hp33-usp__container::before { top: 3px; }
  .hp33-usp__container::after { bottom: 3px; }

  @media screen and (max-width: 992px) {
    .hp33-usp__container {
      flex-direction: column;
      gap: 40px;
      padding: 40px 0;
    }
  }

  .hp33-usp__item {
    flex: 1;
    text-align: center;
    padding: 0 40px;
    position: relative;
  }

  /* Vertical separators */
  .hp33-usp__item:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 10%;
    bottom: 10%;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgba(212, 175, 55, 0.5), transparent);
  }

  @media screen and (max-width: 992px) {
    .hp33-usp__item {
      padding: 0 20px;
    }
    .hp33-usp__item:not(:last-child)::after {
      right: 10%;
      left: 10%;
      top: auto;
      bottom: -20px;
      width: auto;
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(212, 175, 55, 0.5), transparent);
    }
  }

  .hp33-usp__icon {
    font-size: 32px;
    color: var(--gold-color);
    margin-bottom: 20px;
    display: inline-block;
  }

  .hp33-usp__title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 400;
    color: var(--text-color);
    margin: 0 0 15px;
    letter-spacing: 1px;
  }

  .hp33-usp__text {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0;
    font-weight: 300;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp33-usp-wrapper" id="HP33Usp-{{ section.id }}">
  <div class="hp33-usp__container">
    {%- for block in section.blocks -%}
      <div class="hp33-usp__item" {{ block.shopify_attributes }}>
        <div class="hp33-usp__icon">
          {%- if block.settings.icon != blank -%}
            {{ block.settings.icon }}
          {%- else -%}
            ✦
          {%- endif -%}
        </div>
        <h3 class="hp33-usp__title">{{ block.settings.title }}</h3>
        <p class="hp33-usp__text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP33 - Deco USP",
  "class": "section-hp33-usp",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Deco Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Deep Emerald)",
      "default": "#0e1a14"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold Accent",
      "default": "#d4af37"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Emoji/Symbol)",
          "default": "✦"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Heritage Craft"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Meticulously crafted by artisans with decades of experience."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP33 - Deco USP",
      "blocks": [
        { "type": "feature", "settings": { "title": "Heritage Craft", "icon": "✦" } },
        { "type": "feature", "settings": { "title": "Finest Materials", "icon": "✧" } },
        { "type": "feature", "settings": { "title": "Timeless Design", "icon": "✥" } }
      ]
    }
  ]
}
{% endschema %}
