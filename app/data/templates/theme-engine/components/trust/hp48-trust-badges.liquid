{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp48-trust-bg: {{ section.settings.bg_color | default: '#1A1715' }};
    --hp48-gold: {{ section.settings.accent_gold | default: '#C59B27' }};
    
    background-color: var(--hp48-trust-bg);
    color: #FAF8F5;
    padding-top: {{ section.settings.padding_top | default: 50 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    border-top: 1px solid rgba(197, 155, 39, 0.3);
  }

  .hp48-trust__grid {
    max-width: {{ section.settings.container_width | default: 1200 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 30px;
    text-align: center;
  }

  .hp48-trust__icon {
    font-size: 28px;
    margin-bottom: 12px;
    color: var(--hp48-gold);
  }

  .hp48-trust__title {
    font-family: 'Cinzel', serif;
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 6px;
    letter-spacing: 0.5px;
  }

  .hp48-trust__desc {
    font-size: 12px;
    color: #D6CCC2;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp48-trust__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp48-trust__grid">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <div class="hp48-trust__icon">{{ block.settings.icon | default: '👑' }}</div>
        <h4 class="hp48-trust__title">{{ block.settings.title }}</h4>
        <p class="hp48-trust__desc">{{ block.settings.description }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div>
      <div class="hp48-trust__icon">👑</div>
      <h4 class="hp48-trust__title">24K Gold Purity</h4>
      <p class="hp48-trust__desc">Certified Swiss bullion alchemy.</p>
    </div>
    <div>
      <div class="hp48-trust__icon">✈️</div>
      <h4 class="hp48-trust__title">Diplomatic DDP Air</h4>
      <p class="hp48-trust__desc">Pre-cleared customs in 180+ nations.</p>
    </div>
    <div>
      <div class="hp48-trust__icon">🛡️</div>
      <h4 class="hp48-trust__title">Sovereign Warranty</h4>
      <p class="hp48-trust__desc">Complete satisfaction guarantee.</p>
    </div>
    <div>
      <div class="hp48-trust__icon">🔒</div>
      <h4 class="hp48-trust__title">256-Bit Encrypted</h4>
      <p class="hp48-trust__desc">Zero-storage payment security.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP48 - Royal Badges",
  "class": "section-hp48-badges",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#1A1715" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#C59B27" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 100, "step": 5, "unit": "px", "label": "Padding Top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 100, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 50 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1200 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "👑" },
        { "type": "text", "id": "title", "label": "Title", "default": "24K Gold Purity" },
        { "type": "text", "id": "description", "label": "Description", "default": "Certified Swiss bullion alchemy." }
      ]
    }
  ],
  "presets": [
    { "name": "HP48 - Royal Badges" }
  ]
}
{% endschema %}
