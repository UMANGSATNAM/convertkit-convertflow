{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 20px;
    border-bottom: 3px solid #000;
  }
  
  .hp11-press-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    text-align: center;
  }
  
  .hp11-press-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 900;
    text-transform: uppercase;
    color: {{ text_color }};
    margin-bottom: 30px;
    letter-spacing: 2px;
  }
  
  .hp11-press-logos-{{ section_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 60px;
  }
  
  .hp11-press-logo-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 2rem;
    font-weight: 900;
    color: #FFF;
    text-transform: uppercase;
    opacity: 0.5;
    transition: opacity 0.2s ease, transform 0.2s ease;
    -webkit-text-stroke: 1px #FFF;
  }
  
  .hp11-press-logo-{{ section_id }}:hover {
    opacity: 1;
    color: #CCFF00;
    transform: scale(1.1);
    -webkit-text-stroke: 0;
  }

  @media (max-width: 768px) {
    .hp11-press-logos-{{ section_id }} {
      gap: 30px;
    }
    .hp11-press-logo-{{ section_id }} {
      font-size: 1.5rem;
    }
  }
</style>

<div class="hp11-press-container-{{ section_id }}">
  <div class="hp11-press-heading-{{ section_id }}">{{ section.settings.heading | default: 'AS SEEN ON' }}</div>
  
  <div class="hp11-press-logos-{{ section_id }}">
    {% for block in section.blocks %}
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 200 }}" alt="Press Logo" style="max-height: 40px; opacity: 0.5;" class="hp11-press-logo-{{ section_id }}">
      {% else %}
        <div class="hp11-press-logo-{{ section_id }}">{{ block.settings.title | default: 'MAGAZINE' }}</div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP11 Press Logos",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AS SEEN ON"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Logo Text",
          "default": "HYPEBEAST"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP11 Press Logos",
      "blocks": [
        { "type": "logo", "settings": { "title": "HYPEBEAST" } },
        { "type": "logo", "settings": { "title": "HIGHSNOBIETY" } },
        { "type": "logo", "settings": { "title": "COMPLEX" } },
        { "type": "logo", "settings": { "title": "GQ" } }
      ]
    }
  ]
}
{% endschema %}
