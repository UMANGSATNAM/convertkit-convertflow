{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#00FF41'
  assign text_color = section.settings.text_color | default: '#0A0A0A'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 20px;
    border-bottom: 1px solid #FFF;
  }
  
  .hp17-guarantee-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }
  
  .hp17-guarantee-item-{{ section_id }} {
    text-align: center;
    color: {{ text_color }};
    padding: 20px;
    border: 1px solid rgba(10, 10, 10, 0.2);
    transition: all 0.3s ease;
  }
  
  .hp17-guarantee-item-{{ section_id }}:hover {
    background: rgba(10, 10, 10, 0.05);
    border-color: rgba(10, 10, 10, 0.5);
  }
  
  .hp17-guarantee-icon-{{ section_id }} {
    width: 50px; height: 50px;
    margin: 0 auto 15px;
    display: flex; align-items: center; justify-content: center;
  }
  
  .hp17-guarantee-icon-{{ section_id }} svg {
    width: 40px; height: 40px;
    stroke-width: 1.5;
  }
  
  .hp17-guarantee-title-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: 1.1rem;
    text-transform: uppercase;
    margin: 0 0 10px 0;
    letter-spacing: 1px;
  }
  
  .hp17-guarantee-text-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9rem;
    line-height: 1.4;
    margin: 0;
  }

  @media (max-width: 992px) {
    .hp17-guarantee-container-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 600px) {
    .hp17-guarantee-container-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="hp17-guarantee-container-{{ section_id }}">
  {% for block in section.blocks limit: 4 %}
    <div class="hp17-guarantee-item-{{ section_id }}" {{ block.shopify_attributes }}>
      <div class="hp17-guarantee-icon-{{ section_id }}">
        {% if block.settings.icon == 'shield' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        {% elsif block.settings.icon == 'truck' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
        {% elsif block.settings.icon == 'refresh' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
        {% else %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        {% endif %}
      </div>
      <h3 class="hp17-guarantee-title-{{ section_id }}">{{ block.settings.title }}</h3>
      <p class="hp17-guarantee-text-{{ section_id }}">{{ block.settings.text }}</p>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP17 Guarantee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#00FF41"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0A0A0A"
    }
  ],
  "blocks": [
    {
      "type": "guarantee",
      "name": "Guarantee Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "refresh", "label": "Refresh" },
            { "value": "clock", "label": "Clock" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "SECURE PROTOCOL"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "256-bit encrypted checkout."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP17 Guarantee",
      "blocks": [
        { "type": "guarantee", "settings": { "icon": "shield", "title": "SECURE PROTOCOL", "text": "256-bit encrypted checkout." } },
        { "type": "guarantee", "settings": { "icon": "truck", "title": "RAPID DEPLOY", "text": "Free global shipping." } },
        { "type": "guarantee", "settings": { "icon": "refresh", "title": "30-CYCLE RETURNS", "text": "No questions asked." } },
        { "type": "guarantee", "settings": { "icon": "clock", "title": "24/7 SUPPORT", "text": "AI assistance anytime." } }
      ]
    }
  ]
}
{% endschema %}
