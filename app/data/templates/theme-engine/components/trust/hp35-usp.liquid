{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito:wght@300;400;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --icon-color: {{ section.settings.icon_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Nunito', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp35-usp-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp35-usp-wrapper {
      padding: 0 20px;
    }
  }

  .hp35-usp__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 60px;
    text-align: center;
  }

  @media screen and (max-width: 992px) {
    .hp35-usp__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
    }
  }

  @media screen and (max-width: 576px) {
    .hp35-usp__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp35-usp__item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hp35-usp__icon {
    width: 60px;
    height: 60px;
    margin-bottom: 25px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--icon-color);
  }
  
  .hp35-usp__icon svg {
    width: 100%;
    height: 100%;
    stroke-width: 1px; /* thin, elegant strokes */
  }

  .hp35-usp__title {
    font-family: var(--font-heading);
    font-size: 22px;
    color: var(--text-color);
    margin: 0 0 15px;
    font-weight: 500;
  }

  .hp35-usp__text {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-color);
    margin: 0;
    opacity: 0.8;
    font-weight: 300;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp35-usp-wrapper" id="HP35Usp-{{ section.id }}">
  <div class="hp35-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp35-usp__item" {{ block.shopify_attributes }}>
        <div class="hp35-usp__icon">
          {%- if block.settings.icon == 'leaf' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/></svg>
          {%- elsif block.settings.icon == 'sun' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          {%- elsif block.settings.icon == 'heart' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/></svg>
          {%- endif -%}
        </div>
        <h3 class="hp35-usp__title">{{ block.settings.title }}</h3>
        <p class="hp35-usp__text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP35 - Organic USP",
  "class": "section-hp35-usp",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 3
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Soft Beige)",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C422F"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color (e.g. Terracotta)",
      "default": "#CC7B5E"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Value Proposition",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "sun", "label": "Sun" },
            { "value": "heart", "label": "Heart" },
            { "value": "circle", "label": "Circle" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Ethically Sourced"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "We trace every material back to its roots, ensuring harmony with the earth."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP35 - Organic USP",
      "blocks": [
        { "type": "usp", "settings": { "icon": "leaf", "title": "Ethically Sourced" } },
        { "type": "usp", "settings": { "icon": "sun", "title": "Slow Crafted" } },
        { "type": "usp", "settings": { "icon": "heart", "title": "Mindful Living" } }
      ]
    }
  ]
}
{% endschema %}
