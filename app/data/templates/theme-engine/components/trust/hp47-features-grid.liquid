{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp47-feat-bg: {{ section.settings.bg_color | default: '#F5F0EB' }};
    
    background-color: var(--hp47-feat-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp47-feat__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp47-feat__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp47-feat__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 4.5vw, 44px);
    font-weight: 600;
    color: #382E2B;
    margin: 0 0 8px;
  }

  .hp47-feat__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp47-feat__card {
    background: #FAF7F2;
    border: 1px solid #EAE3DA;
    border-radius: 24px;
    padding: 36px 28px;
    box-shadow: 0 10px 30px rgba(56, 46, 43, 0.04);
    transition: all 0.3s ease;
  }

  .hp47-feat__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 45px rgba(56, 46, 43, 0.08);
  }

  .hp47-feat__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 700;
    color: #8C6D58;
    margin: 0 0 12px;
  }

  .hp47-feat__desc {
    font-size: 14px;
    line-height: 1.7;
    color: #6E5E58;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp47-feat__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="hp47-feat__wrap">
  <div class="hp47-feat__header">
    <h2 class="hp47-feat__heading">Botanical Innovations</h2>
    <p style="font-size:14px; color:#6E5E58;">{{ section.settings.subheading | default: 'Gentle Scandinavian science crafted for sensitive and barrier-compromised skin.' }}</p>
  </div>

  <div class="hp47-feat__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp47-feat__card" {{ block.shopify_attributes }}>
          <h3 class="hp47-feat__title">{{ block.settings.title }}</h3>
          <p class="hp47-feat__desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp47-feat__card">
        <h3 class="hp47-feat__title">Lacto-Enzymatic Fermentation</h3>
        <p class="hp47-feat__desc">Gentle bio-fermentation releases locked ceramides without damaging delicate antioxidant fractions.</p>
      </div>
      <div class="hp47-feat__card">
        <h3 class="hp47-feat__title">Zero-Wax Micro-Emulsion</h3>
        <p class="hp47-feat__desc">Leaves zero greasy residue on pillowcases, sinking smoothly into stratum corneum within 60 seconds.</p>
      </div>
      <div class="hp47-feat__card">
        <h3 class="hp47-feat__title">Nordic Forestry Stewardship</h3>
        <p class="hp47-feat__desc">Every wooden vessel closure is crafted from sustainably harvested Swedish birch with 100% replanted forests.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP47 - Taupe Feat",
  "class": "section-hp47-features",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F0EB" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Lacto-Enzymatic Fermentation" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Gentle bio-fermentation releases locked ceramides." }
      ]
    }
  ],
  "presets": [
    { "name": "HP47 - Taupe Feat" }
  ]
}
{% endschema %}
