{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAFAFA'
  assign text_color = section.settings.text_color | default: '#333333'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 40px;
    border-bottom: 1px solid #E5E5E5;
  }
  
  .hp12-comparison-container-{{ section_id }} {
    max-width: 1000px;
    margin: 0 auto;
  }
  
  .hp12-comparison-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    text-align: center;
    margin: 0 0 60px 0;
    color: {{ text_color }};
    letter-spacing: 1px;
  }
  
  .hp12-comparison-table-wrap-{{ section_id }} {
    overflow-x: auto;
  }
  
  .hp12-comparison-table-{{ section_id }} {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 600px;
  }
  
  .hp12-comparison-table-{{ section_id }} th,
  .hp12-comparison-table-{{ section_id }} td {
    padding: 25px 20px;
    border-bottom: 1px solid #E5E5E5;
    font-family: 'Inter', sans-serif;
    color: {{ text_color }};
  }
  
  .hp12-comparison-table-{{ section_id }} th {
    font-size: 0.9rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 2px;
    opacity: 0.6;
    border-bottom: 1px solid #CCC;
  }
  
  .hp12-comparison-table-{{ section_id }} td.hp12-feature-{{ section_id }} {
    font-size: 1rem;
    font-weight: 300;
  }
  
  .hp12-comparison-table-{{ section_id }} td.hp12-us-{{ section_id }} {
    font-weight: 600;
  }
  
  .hp12-comparison-table-{{ section_id }} td.hp12-them-{{ section_id }} {
    font-weight: 300;
    opacity: 0.6;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp12-comparison-table-{{ section_id }} th,
    .hp12-comparison-table-{{ section_id }} td {
      padding: 20px 10px;
    }
  }
</style>

<div class="hp12-comparison-container-{{ section_id }}">
  <h2 class="hp12-comparison-heading-{{ section_id }}">{{ section.settings.heading | default: 'Our standard.' }}</h2>
  
  <div class="hp12-comparison-table-wrap-{{ section_id }}">
    <table class="hp12-comparison-table-{{ section_id }}">
      <thead>
        <tr>
          <th>Detail</th>
          <th>Our Approach</th>
          <th>Industry Norm</th>
        </tr>
      </thead>
      <tbody>
        {% for block in section.blocks %}
          <tr>
            <td class="hp12-feature-{{ section_id }}">{{ block.settings.feature }}</td>
            <td class="hp12-us-{{ section_id }}">{{ block.settings.us_desc }}</td>
            <td class="hp12-them-{{ section_id }}">{{ block.settings.them_desc }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "HP12 Comparison Table",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our standard."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature Name",
          "default": "Materials"
        },
        {
          "type": "text",
          "id": "us_desc",
          "label": "Our Approach",
          "default": "Solid Oak & Linen"
        },
        {
          "type": "text",
          "id": "them_desc",
          "label": "Industry Norm",
          "default": "Veneer & Synthetic"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP12 Comparison Table",
      "blocks": [
        { "type": "feature", "settings": { "feature": "Materials", "us_desc": "Solid Oak & Natural Linen", "them_desc": "Veneer & Synthetic" } },
        { "type": "feature", "settings": { "feature": "Construction", "us_desc": "Traditional Joinery", "them_desc": "Mass Assembled" } },
        { "type": "feature", "settings": { "feature": "Lifespan", "us_desc": "Generational", "them_desc": "Disposable" } }
      ]
    }
  ]
}
{% endschema %}
