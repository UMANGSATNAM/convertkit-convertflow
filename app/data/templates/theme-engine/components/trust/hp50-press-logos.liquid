<style>
@media screen and (max-width: 768px) {
  .hp50-press-logos {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp50-press-bg: {{ section.settings.bg_color | default: '#000000' }};
    
    background-color: var(--hp50-press-bg);
    padding: {{ section.settings.padding_vertical | default: 30 }}px 0;
    border-top: 1px solid rgba(226, 232, 240, 0.2);
    border-bottom: 1px solid rgba(226, 232, 240, 0.2);
  }

  .hp50-press__wrap {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: 30px;
    font-family: 'Italiana', serif;
    font-size: 22px;
    letter-spacing: 2px;
    color: #FFFFFF;
    opacity: 0.85;
  }
{%- endstyle -%}

<div class="hp50-press__wrap">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.title }}</span>
    {%- endfor -%}
  {%- else -%}
    <span>VOGUE PARIS</span>
    <span>NUMÉRO HOMME</span>
    <span>L'OFFICIEL COUTURE</span>
    <span>DAZED FASHION</span>
    <span>SHOWSTUDIO</span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP50 - Runway Press",
  "class": "section-hp50-press",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "range", "id": "padding_vertical", "min": 15, "max": 60, "step": 5, "unit": "px", "label": "Vertical Padding", "default": 30 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1100 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Publication Name", "default": "VOGUE PARIS" }
      ]
    }
  ],
  "presets": [
    { "name": "HP50 - Runway Press" }
  ]
}
{% endschema %}
