{%- style -%}
  .why-choose-us-v2 {
    background-color: var(--bg-base);
    padding: var(--space-48) 0;
    position: relative;
  }
  @media (min-width: 768px) {
    .why-choose-us-v2 {
      padding: var(--space-64) 0;
    }
  }

  .why-choose-us-v2__header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--space-40);
  }
  .why-choose-us-v2__pill {
    display: inline-block;
    background-color: var(--tint-green);
    color: var(--primary);
    font-size: var(--text-12);
    font-weight: 600;
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: var(--space-12);
  }
  .why-choose-us-v2__title {
    font-size: var(--text-32);
    font-weight: 400;
    color: var(--text-main);
    margin: 0 0 var(--space-12);
  }
  @media (min-width: 768px) {
    .why-choose-us-v2__title {
      font-size: var(--text-40);
    }
  }
  .why-choose-us-v2__subtext {
    font-size: var(--text-16);
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .why-choose-us-v2__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-20);
  }
  @media (min-width: 640px) {
    .why-choose-us-v2__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .why-choose-us-v2__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .pillar-card {
    background-color: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: var(--space-28) var(--space-24);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .pillar-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary);
  }

  .pillar-card__icon-box {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-button);
    background-color: var(--tint-green);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pillar-card__icon-box svg {
    width: 24px;
    height: 24px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pillar-card__title {
    font-size: var(--text-18);
    font-weight: 600;
    color: var(--text-main);
    margin: 0;
  }
  .pillar-card__desc {
    font-size: var(--text-14);
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }
{%- endstyle -%}

<div class="why-choose-us-v2">
  <div class="fresh-container">
    <div class="why-choose-us-v2__header">
      <span class="why-choose-us-v2__pill">{{ section.settings.badge | default: "Quality & Care" }}</span>
      <h2 class="why-choose-us-v2__title">{{ section.settings.title | default: "Why Customers Trust Our Rituals" }}</h2>
      <p class="why-choose-us-v2__subtext">{{ section.settings.subtext | default: "We focus on clean botanical formulation, careful sourcing, and delightful everyday care." }}</p>
    </div>

    <div class="why-choose-us-v2__grid">
      {%- for block in section.blocks -%}
        <div class="pillar-card" {{ block.shopify_attributes }}>
          <div class="pillar-card__icon-box">
            {%- case block.settings.icon -%}
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.4 19 2c1 2 2 4.1 2 8 0 5.5-4.5 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
              {%- when 'flask' -%}
                <svg viewBox="0 0 24 24"><path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/><path d="M8.5 2h7"/><path d="M7 16h10"/></svg>
              {%- when 'heart' -%}
                <svg viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              {%- when 'sparkle' -%}
                <svg viewBox="0 0 24 24"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.4 19 2c1 2 2 4.1 2 8 0 5.5-4.5 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
            {%- endcase -%}
          </div>
          <h3 class="pillar-card__title">{{ block.settings.title }}</h3>
          <p class="pillar-card__desc">{{ block.settings.description }}</p>
        </div>
      {%- else -%}
        <div class="pillar-card">
          <div class="pillar-card__icon-box">
            <svg viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.4 19 2c1 2 2 4.1 2 8 0 5.5-4.5 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
          </div>
          <h3 class="pillar-card__title">Pure Botanical Extracts</h3>
          <p class="pillar-card__desc">Formulated with carefully selected botanical extracts and natural plant oils for daily care.</p>
        </div>
        <div class="pillar-card">
          <div class="pillar-card__icon-box">
            <svg viewBox="0 0 24 24"><path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/><path d="M8.5 2h7"/><path d="M7 16h10"/></svg>
          </div>
          <h3 class="pillar-card__title">Balanced Formulation</h3>
          <p class="pillar-card__desc">Designed to support healthy-looking skin with gentle ingredients suitable for everyday ritual.</p>
        </div>
        <div class="pillar-card">
          <div class="pillar-card__icon-box">
            <svg viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          </div>
          <h3 class="pillar-card__title">Mindful Sourcing</h3>
          <p class="pillar-card__desc">Committed to ethical ingredient sourcing and modern recyclable glass packaging design.</p>
        </div>
        <div class="pillar-card">
          <div class="pillar-card__icon-box">
            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3 class="pillar-card__title">Quality Standards</h3>
          <p class="pillar-card__desc">Every batch is crafted and inspected to ensure a consistent, delightful customer experience.</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why Choose Us V2",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Pill Text",
      "default": "Quality & Care"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Why Customers Trust Our Rituals"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "We focus on clean botanical formulation, careful sourcing, and delightful everyday care."
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Trust Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Botanical Leaf" },
            { "value": "flask", "label": "Science Beaker" },
            { "value": "heart", "label": "Care Heart" },
            { "value": "shield", "label": "Quality Shield" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Add your benefit title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Describe how your product formulation or service benefit helps customers achieve their goals."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us V2",
      "blocks": [
        { "type": "pillar", "settings": { "icon": "leaf", "title": "Pure Botanical Extracts", "description": "Formulated with carefully selected botanical extracts and natural plant oils for daily care." } },
        { "type": "pillar", "settings": { "icon": "flask", "title": "Balanced Formulation", "description": "Designed to support healthy-looking skin with gentle ingredients suitable for everyday ritual." } },
        { "type": "pillar", "settings": { "icon": "heart", "title": "Mindful Sourcing", "description": "Committed to ethical ingredient sourcing and modern recyclable glass packaging design." } },
        { "type": "pillar", "settings": { "icon": "shield", "title": "Quality Standards", "description": "Every batch is crafted and inspected to ensure a consistent, delightful customer experience." } }
      ]
    }
  ]
}
{% endschema %}
