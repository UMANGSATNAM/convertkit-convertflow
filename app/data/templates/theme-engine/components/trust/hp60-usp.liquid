{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FEFCE8' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }
  .hp60-usp__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp60-usp__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr); gap: 20px; }
  .hp60-usp__card {
    background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border: 1px solid rgba(63, 98, 18, 0.2);
    border-radius: 6px; padding: 32px 22px; text-align: center;
    box-shadow: 0 4px 20px rgba(63, 98, 18, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hp60-usp__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(63, 98, 18, 0.12);
  }
  .hp60-usp__icon {
    width: 52px; height: 52px;
    background: linear-gradient(135deg, #FEF9C3, #FEF08A);
    border-radius: 4px; display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px; font-size: 22px; color: #3F6212;
    border: 1px solid rgba(63, 98, 18, 0.2);
  }
  .hp60-usp__title {
    font-family: 'Bodoni Moda', serif; font-size: 19px; font-weight: 700; color: #1E293B; margin: 0 0 8px;
  }
  .hp60-usp__desc { font-size: 13px; line-height: 1.6; color: #475569; margin: 0; }
  @media screen and (max-width: 992px) { .hp60-usp__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp60-usp__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp60-usp__container">
  <div class="hp60-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp60-usp__card" {{ block.shopify_attributes }}>
        <div class="hp60-usp__icon">{{ block.settings.icon | default: '🍋' }}</div>
        <h3 class="hp60-usp__title">{{ block.settings.title | default: 'Bergamot Essence' }}</h3>
        <p class="hp60-usp__desc">{{ block.settings.description | default: 'Cold pressed in Calabria.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP60 Pillars",
  "class": "section-hp60-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FEFCE8" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#FFFFFF" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "pillar", "name": "Pillar", "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "🍋" },
    { "type": "text", "id": "title", "label": "Title", "default": "Bergamot Essence" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Cold pressed in Calabria." }
  ]}],
  "presets": [{ "name": "HP60 Pillars", "blocks": [
    { "type": "pillar", "settings": { "icon": "🍋", "title": "Calabrian Bergamot", "description": "Sun-ripened citrus delivering natural Vitamin C and bioflavonoids." } },
    { "type": "pillar", "settings": { "icon": "🌿", "title": "Tuscan Olive Oleuropein", "description": "Ancient polyphenol compound neutralizing lipid oxidative degradation." } },
    { "type": "pillar", "settings": { "icon": "🏛️", "title": "Travertine Spring Water", "description": "Thermal limestone spring water rich in silica and calcium carbonate." } },
    { "type": "pillar", "settings": { "icon": "🏺", "title": "Cold-Milled First Press", "description": "Artisanal granite press cycles operating below 22°C for peak freshness." } }
  ]}]
}
{% endschema %}
