{% comment %}
  CF Comparison Matrix - High-Converting CRO "Us vs Traditional Brands" Comparison Table
  Category: trust
  Version: 2.0 - Shopify 2.0 Dynamic Blocks with Fallback
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding: clamp(48px, 7vw, 96px) 20px;
    background: {{ section.settings.bg_color | default: '#f8fafc' }};
    font-family: inherit;
  }

  .cf-comp-inner {
    max-width: 980px;
    margin: 0 auto;
  }

  .cf-comp-header {
    text-align: center;
    margin-bottom: clamp(36px, 5vw, 60px);
  }

  .cf-comp-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #0284c7;
    background: #e0f2fe;
    border: 1px solid rgba(2, 132, 199, 0.2);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 16px;
    box-shadow: 0 2px 8px rgba(2, 132, 199, 0.08);
  }

  .cf-comp-heading {
    font-size: clamp(26px, 4.5vw, 42px);
    font-weight: 850;
    color: #0f172a;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 14px 0;
  }

  .cf-comp-subheading {
    font-size: clamp(14px, 1.6vw, 16px);
    color: #64748b;
    max-width: 580px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .cf-comp-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.07), 0 0 0 1px rgba(15, 23, 42, 0.04);
  }

  .cf-comp-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .cf-comp-th {
    padding: 22px 28px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.02em;
    border-bottom: 2px solid #f1f5f9;
  }

  .cf-comp-th-feature {
    color: #475569;
    width: 44%;
  }

  .cf-comp-th-us {
    background: #0f172a;
    color: #ffffff;
    text-align: center;
    width: 28%;
    position: relative;
  }

  .cf-comp-us-pill {
    display: inline-block;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #10b981;
    color: #ffffff;
    padding: 2px 8px;
    border-radius: 999px;
    margin-left: 6px;
    vertical-align: middle;
  }

  .cf-comp-th-them {
    background: #f8fafc;
    color: #64748b;
    text-align: center;
    width: 28%;
    border-left: 1px solid #f1f5f9;
  }

  .cf-comp-td {
    padding: 18px 28px;
    font-size: 14px;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
    font-weight: 600;
  }

  .cf-comp-td-us {
    background: rgba(15, 23, 42, 0.02);
    text-align: center;
    font-weight: 700;
  }

  .cf-comp-td-them {
    text-align: center;
    color: #94a3b8;
    background: #ffffff;
    border-left: 1px solid #f1f5f9;
  }

  .cf-check-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #dcfce7;
    color: #15803d;
    font-size: 14px;
    font-weight: 900;
    box-shadow: 0 2px 6px rgba(21, 128, 61, 0.15);
  }

  .cf-cross-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #fee2e2;
    color: #b91c1c;
    font-size: 13px;
    font-weight: 900;
  }

  @media (max-width: 640px) {
    .cf-comp-th, .cf-comp-td {
      padding: 14px 12px;
      font-size: 12px;
    }
    .cf-comp-us-pill {
      display: block;
      margin: 4px auto 0 auto;
      width: fit-content;
    }
    .cf-check-icon, .cf-cross-icon {
      width: 22px;
      height: 22px;
      font-size: 11px;
    }
  }
{%- endstyle -%}

<div class="cf-comp-inner">
  <div class="cf-comp-header">
    <span class="cf-comp-badge">{{ section.settings.badge | default: 'The Clear Difference' }}</span>
    <h2 class="cf-comp-heading">{{ section.settings.heading | default: 'Why Modern Buyers Choose Us' }}</h2>
    <p class="cf-comp-subheading">{{ section.settings.subheading | default: 'Engineered without compromises, synthetic fillers, or unnecessary distributor markups.' }}</p>
  </div>

  <div class="cf-comp-card">
    <table class="cf-comp-table">
      <thead>
        <tr>
          <th class="cf-comp-th cf-comp-th-feature">Standard &amp; Quality</th>
          <th class="cf-comp-th cf-comp-th-us">
            {{ section.settings.our_name | default: 'Our Brand' }}
            <span class="cf-comp-us-pill">WINNER</span>
          </th>
          <th class="cf-comp-th cf-comp-th-them">{{ section.settings.their_name | default: 'Traditional Brands' }}</th>
        </tr>
      </thead>
      <tbody>
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <tr {{ block.shopify_attributes }}>
              <td class="cf-comp-td">{{ block.settings.feature }}</td>
              <td class="cf-comp-td cf-comp-td-us">
                {% if block.settings.us_check %}
                  <span class="cf-check-icon">✓</span>
                {% else %}
                  <span class="cf-cross-icon">✕</span>
                {% endif %}
              </td>
              <td class="cf-comp-td cf-comp-td-them">
                {% if block.settings.them_check %}
                  <span class="cf-check-icon">✓</span>
                {% else %}
                  <span class="cf-cross-icon">✕</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td class="cf-comp-td">100% Third-Party Lab Certified &amp; Purity Tested</td>
            <td class="cf-comp-td cf-comp-td-us"><span class="cf-check-icon">✓</span></td>
            <td class="cf-comp-td cf-comp-td-them"><span class="cf-cross-icon">✕</span></td>
          </tr>
          <tr>
            <td class="cf-comp-td">Zero Synthetic Fillers, Harmful Dyes or Toxins</td>
            <td class="cf-comp-td cf-comp-td-us"><span class="cf-check-icon">✓</span></td>
            <td class="cf-comp-td cf-comp-td-them"><span class="cf-cross-icon">✕</span></td>
          </tr>
          <tr>
            <td class="cf-comp-td">Direct-to-Consumer Fair Price (No Middlemen Markup)</td>
            <td class="cf-comp-td cf-comp-td-us"><span class="cf-check-icon">✓</span></td>
            <td class="cf-comp-td cf-comp-td-them"><span class="cf-cross-icon">✕</span></td>
          </tr>
          <tr>
            <td class="cf-comp-td">Eco-Friendly Recycled Plastic-Free Packaging</td>
            <td class="cf-comp-td cf-comp-td-us"><span class="cf-check-icon">✓</span></td>
            <td class="cf-comp-td cf-comp-td-them"><span class="cf-cross-icon">✕</span></td>
          </tr>
          <tr>
            <td class="cf-comp-td">60-Day Full Refund Guarantee (Keep the Item)</td>
            <td class="cf-comp-td cf-comp-td-us"><span class="cf-check-icon">✓</span></td>
            <td class="cf-comp-td cf-comp-td-them"><span class="cf-cross-icon">✕</span></td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "CF Comparison Matrix",
  "tag": "section",
  "class": "cf-comparison-matrix-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f8fafc" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "The Clear Difference" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Modern Buyers Choose Us" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Engineered without compromises, synthetic fillers, or unnecessary distributor markups." },
    { "type": "text", "id": "our_name", "label": "Our Brand Label", "default": "Our Brand" },
    { "type": "text", "id": "their_name", "label": "Competitor Label", "default": "Traditional Brands" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature / Standard", "default": "Purity & Quality Certified" },
        { "type": "checkbox", "id": "us_check", "label": "Our Brand Has This", "default": true },
        { "type": "checkbox", "id": "them_check", "label": "Competitor Has This", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF Comparison Matrix",
      "blocks": [
        { "type": "row", "settings": { "feature": "100% Third-Party Lab Certified & Purity Tested", "us_check": true, "them_check": false } },
        { "type": "row", "settings": { "feature": "Zero Synthetic Fillers, Harmful Dyes or Toxins", "us_check": true, "them_check": false } },
        { "type": "row", "settings": { "feature": "Direct-to-Consumer Fair Price (No Middlemen Markup)", "us_check": true, "them_check": false } },
        { "type": "row", "settings": { "feature": "Eco-Friendly Recycled Plastic-Free Packaging", "us_check": true, "them_check": false } },
        { "type": "row", "settings": { "feature": "60-Day Full Refund Guarantee (Keep the Item)", "us_check": true, "them_check": false } }
      ]
    }
  ]
}
{% endschema %}
