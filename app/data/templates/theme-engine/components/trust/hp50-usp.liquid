{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp50-usp-bg: {{ section.settings.bg_color | default: '#000000' }};
    --hp50-card-bg: {{ section.settings.card_bg | default: '#111111' }};
    --hp50-border: {{ section.settings.border_color | default: '#222222' }};
    --hp50-title: {{ section.settings.title_color | default: '#FFFFFF' }};
    
    background-color: var(--hp50-usp-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp50-usp__grid {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 24px;
  }

  .hp50-usp__card {
    background: var(--hp50-card-bg);
    border: 1px solid var(--hp50-border);
    padding: 36px 24px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    transition: all 0.3s ease;
  }

  .hp50-usp__card:hover {
    border-color: #E2E8F0;
    transform: translateY(-4px);
  }

  .hp50-usp__icon {
    font-size: 26px;
    margin-bottom: 16px;
    color: #E2E8F0;
  }

  .hp50-usp__title {
    font-family: 'Syne', sans-serif;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--hp50-title);
    margin: 0 0 10px;
  }

  .hp50-usp__desc {
    font-size: 13px;
    line-height: 1.7;
    color: #94A3B8;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp50-usp__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (max-width: 576px) {
    .hp50-usp__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="hp50-usp__grid">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="hp50-usp__card" {{ block.shopify_attributes }}>
        <div class="hp50-usp__icon">{{ block.settings.icon | default: '✦' }}</div>
        <h3 class="hp50-usp__title">{{ block.settings.title }}</h3>
        <p class="hp50-usp__desc">{{ block.settings.description }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="hp50-usp__card">
      <div class="hp50-usp__icon">✦</div>
      <h3 class="hp50-usp__title">Platinum Micro-Peptides</h3>
      <p class="hp50-usp__desc">Provides high-tensile lifting vectors for runway-sculpted cheekbones.</p>
    </div>
    <div class="hp50-usp__card">
      <div class="hp50-usp__icon">💎</div>
      <h3 class="hp50-usp__title">Obsidian Bio-Filter</h3>
      <p class="hp50-usp__desc">Volcanic glass enzymes refract studio flashes for immediate porcelain finish.</p>
    </div>
    <div class="hp50-usp__card">
      <div class="hp50-usp__icon">✈️</div>
      <h3 class="hp50-usp__title">White-Glove DDP Air</h3>
      <p class="hp50-usp__desc">Diplomatic priority air courier with 100% pre-paid customs clearance.</p>
    </div>
    <div class="hp50-usp__card">
      <div class="hp50-usp__icon">🛡️</div>
      <h3 class="hp50-usp__title">Editorial Guarantee</h3>
      <p class="hp50-usp__desc">30-day flawless performance accord backed by personal concierge.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP50 - Runway Pillars",
  "class": "section-hp50-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#111111" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#222222" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#FFFFFF" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar Card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "✦" },
        { "type": "text", "id": "title", "label": "Title", "default": "Platinum Micro-Peptides" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Provides high-tensile lifting vectors." }
      ]
    }
  ],
  "presets": [
    { "name": "HP50 - Runway Pillars" }
  ]
}
{% endschema %}
