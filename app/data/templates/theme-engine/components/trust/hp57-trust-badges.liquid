{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0A1C14' }};
    padding-top: {{ section.settings.padding_top | default: 50 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    border-top: 1px solid rgba(167, 243, 208, 0.15);
  }
  .hp57-trust__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp57-trust__grid { display: flex; justify-content: center; gap: 50px; flex-wrap: wrap; }
  .hp57-trust__item { display: flex; align-items: center; gap: 14px; }
  .hp57-trust__icon {
    width: 44px; height: 44px; background: linear-gradient(135deg, #0F291E, #2D5A43);
    border-radius: 8px; display: flex; align-items: center; justify-content: center;
    font-size: 18px; color: #A7F3D0; flex-shrink: 0;
    border: 1px solid rgba(167, 243, 208, 0.3);
  }
  .hp57-trust__label { font-family: 'Cormorant Garamond', serif; font-size: 16px; font-weight: 700; color: #FFFFFF; margin: 0; }
  .hp57-trust__sub { font-size: 11px; color: #A7F3D0; margin: 2px 0 0; }
  @media screen and (max-width: 768px) { .hp57-trust__grid { gap: 24px; } }
  @media screen and (max-width: 480px) {
    .hp57-trust__grid { flex-direction: column; align-items: center; text-align: center; }
    .hp57-trust__item { flex-direction: column; }
  }
{%- endstyle -%}
<div class="hp57-trust__container">
  <div class="hp57-trust__grid">
    {%- for block in section.blocks -%}
      <div class="hp57-trust__item" {{ block.shopify_attributes }}>
        <div class="hp57-trust__icon">{{ block.settings.icon | default: '🌿' }}</div>
        <div>
          <p class="hp57-trust__label">{{ block.settings.title | default: 'Botanical Purity Seal' }}</p>
          <p class="hp57-trust__sub">{{ block.settings.subtitle | default: '100% cold-macerated' }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP57 Trust",
  "class": "section-hp57-trust",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A1C14" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 50 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "badge", "name": "Badge",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🌿" },
      { "type": "text", "id": "title", "label": "Title", "default": "Botanical Purity Seal" },
      { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "100% cold-macerated" }
    ]
  }],
  "presets": [{
    "name": "HP57 Trust",
    "blocks": [
      { "type": "badge", "settings": { "icon": "🌿", "title": "Botanical Purity Seal", "subtitle": "100% cold-macerated" } },
      { "type": "badge", "settings": { "icon": "📦", "title": "Eco Glass Packaging", "subtitle": "Pharmaceutical amber glass" } },
      { "type": "badge", "settings": { "icon": "🚚", "title": "Apothecary Express", "subtitle": "Carbon-neutral shipping" } },
      { "type": "badge", "settings": { "icon": "🛡️", "title": "Botanical Guarantee", "subtitle": "45-day radiant guarantee" } }
    ]
  }]
}
{% endschema %}
