{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Oswald:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    
    --font-serif: 'Playfair Display', serif;
    --font-sans: 'Oswald', sans-serif;
    
    background-color: var(--bg-color);
    border-bottom: 1px solid var(--border-color);
  }

  .hp36-press-wrapper {
    display: flex;
    align-items: stretch;
    min-height: 120px;
  }

  @media screen and (max-width: 992px) {
    .hp36-press-wrapper {
      flex-direction: column;
    }
  }

  .hp36-press__title-col {
    padding: 30px 40px;
    border-right: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    background: var(--text-color);
    color: var(--bg-color);
    flex-shrink: 0;
  }

  @media screen and (max-width: 992px) {
    .hp36-press__title-col {
      border-right: none;
      border-bottom: 1px solid var(--border-color);
      justify-content: center;
    }
  }

  .hp36-press__title {
    font-family: var(--font-sans);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin: 0;
  }

  .hp36-press__logos {
    display: flex;
    flex: 1;
  }

  @media screen and (max-width: 768px) {
    .hp36-press__logos {
      flex-direction: column;
    }
  }

  .hp36-press__logo-item {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30px;
    border-right: 1px solid var(--border-color);
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  .hp36-press__logo-item:last-child {
    border-right: none;
  }

  @media screen and (max-width: 768px) {
    .hp36-press__logo-item {
      border-right: none;
      border-bottom: 1px solid var(--border-color);
      padding: 40px;
    }
    .hp36-press__logo-item:last-child {
      border-bottom: none;
    }
  }

  .hp36-press__logo-item:hover {
    opacity: 1;
  }

  .hp36-press__logo {
    max-height: 30px;
    width: auto;
    filter: invert(0); /* Assuming black logos */
  }
  
  .hp36-press__logo-text {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 600;
    text-transform: uppercase;
    font-style: italic;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp36-press-wrapper" id="HP36Press-{{ section.id }}">
  <div class="hp36-press__title-col">
    <h2 class="hp36-press__title">{{ section.settings.title }}</h2>
  </div>
  
  <div class="hp36-press__logos">
    {%- for block in section.blocks -%}
      <div class="hp36-press__logo-item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: height: 60 }}" alt="Press Logo" class="hp36-press__logo" loading="lazy">
        {%- else -%}
          <span class="hp36-press__logo-text">{{ block.settings.text_fallback }}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP36 - Editorial Press",
  "class": "section-hp36-press-logos",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "PRESS / MENTIONS"
    },
    {
      "type": "header",
      "content": "Editorial Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "text_fallback",
          "label": "Text Fallback",
          "default": "VOGUE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP36 - Editorial Press",
      "blocks": [
        { "type": "logo", "settings": { "text_fallback": "VOGUE" } },
        { "type": "logo", "settings": { "text_fallback": "GQ" } },
        { "type": "logo", "settings": { "text_fallback": "DAZED" } },
        { "type": "logo", "settings": { "text_fallback": "i-D" } }
      ]
    }
  ]
}
{% endschema %}
