{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0a0a0a'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign hover_glow_color = section.settings.hover_glow_color | default: '#00ffcc'
  assign heading = section.settings.heading | default: 'APPROVED BY THE PROS'
  assign subtext = section.settings.subtext | default: 'As seen in leading fitness publications and trusted by top athletes worldwide.'
  assign animation_speed = section.settings.animation_speed | default: 25
  assign logo_opacity = section.settings.logo_opacity | default: 40
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 0;
    overflow: hidden;
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  
  .hp6-press-container-{{ section_id }} {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  
  .hp6-press-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 60px;
    padding: 0 20px;
  }
  
  .hp6-press-heading-{{ section_id }} {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: {{ text_color }};
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    margin: 0 0 15px 0;
    font-family: 'Impact', 'Arial Black', sans-serif;
    line-height: 1;
    position: relative;
    display: inline-block;
  }
  
  .hp6-press-heading-{{ section_id }}::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 50%;
    transform: translateX(-50%) skewX(-20deg);
    width: 60px;
    height: 4px;
    background-color: {{ hover_glow_color }};
  }
  
  .hp6-press-subtext-{{ section_id }} {
    font-size: 1.1rem;
    color: {{ text_color | color_modify: 'alpha', 0.7 }};
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
    font-family: 'Inter', sans-serif;
  }
  
  .hp6-marquee-wrapper-{{ section_id }} {
    display: flex;
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: hidden;
    padding: 20px 0;
  }
  
  /* Gradient masks for smooth fade out at edges */
  .hp6-marquee-wrapper-{{ section_id }}::before,
  .hp6-marquee-wrapper-{{ section_id }}::after {
    content: '';
    position: absolute;
    top: 0;
    width: 15vw;
    height: 100%;
    z-index: 5;
    pointer-events: none;
  }
  
  .hp6-marquee-wrapper-{{ section_id }}::before {
    left: 0;
    background: linear-gradient(to right, {{ bg_color }} 0%, transparent 100%);
  }
  
  .hp6-marquee-wrapper-{{ section_id }}::after {
    right: 0;
    background: linear-gradient(to left, {{ bg_color }} 0%, transparent 100%);
  }
  
  .hp6-marquee-track-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: 80px;
    padding-right: 80px; /* matches gap */
    white-space: nowrap;
    animation: hp6Marquee {{ animation_speed }}s linear infinite;
  }
  
  .hp6-marquee-wrapper-{{ section_id }}:hover .hp6-marquee-track-{{ section_id }} {
    animation-play-state: paused;
  }
  
  .hp6-press-logo-{{ section_id }} {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: pointer;
    group: logo;
  }
  
  .hp6-press-logo-{{ section_id }} img {
    max-height: 50px;
    width: auto;
    object-fit: contain;
    filter: grayscale(100%) brightness(200%) opacity({{ logo_opacity }}%);
    transition: all 0.4s ease;
  }
  
  .hp6-press-logo-{{ section_id }}:hover img {
    filter: grayscale(0%) brightness(100%) opacity(100%);
    transform: scale(1.15) rotate(-2deg);
    filter: drop-shadow(0 0 15px {{ hover_glow_color | color_modify: 'alpha', 0.6 }});
  }
  
  .hp6-press-quote-{{ section_id }} {
    position: absolute;
    bottom: -40px;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: rgba(25, 25, 25, 0.95);
    border: 1px solid {{ hover_glow_color }};
    color: {{ text_color }};
    padding: 8px 15px;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    border-radius: 4px;
    pointer-events: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: 'Inter', sans-serif;
  }
  
  .hp6-press-quote-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 10px;
    height: 10px;
    background: rgba(25, 25, 25, 0.95);
    border-top: 1px solid {{ hover_glow_color }};
    border-left: 1px solid {{ hover_glow_color }};
  }
  
  .hp6-press-logo-{{ section_id }}:hover .hp6-press-quote-{{ section_id }} {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  
  @keyframes hp6Marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }
  
  /* Abstract background shapes */
  .hp6-press-bg-shape-1-{{ section_id }} {
    position: absolute;
    top: -20%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, {{ hover_glow_color | color_modify: 'alpha', 0.05 }} 0%, transparent 70%);
    pointer-events: none;
    z-index: 1;
  }
  
  .hp6-press-bg-shape-2-{{ section_id }} {
    position: absolute;
    bottom: -30%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, {{ hover_glow_color | color_modify: 'alpha', 0.03 }} 0%, transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  @media (max-width: 768px) {
    .hp6-press-heading-{{ section_id }} {
      font-size: 2.5rem;
    }
    .hp6-marquee-track-{{ section_id }} {
      gap: 50px;
      padding-right: 50px;
    }
    .hp6-press-logo-{{ section_id }} img {
      max-height: 40px;
    }
    #shopify-section-{{ section_id }} {
      padding: 60px 0;
    }
  }
</style>

<div class="hp6-press-bg-shape-1-{{ section_id }}"></div>
<div class="hp6-press-bg-shape-2-{{ section_id }}"></div>

<div class="hp6-press-container-{{ section_id }}">
  {% if heading != blank or subtext != blank %}
    <div class="hp6-press-header-{{ section_id }}">
      {% if heading != blank %}
        <h2 class="hp6-press-heading-{{ section_id }}">{{ heading }}</h2>
      {% endif %}
      {% if subtext != blank %}
        <p class="hp6-press-subtext-{{ section_id }}">{{ subtext }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="hp6-marquee-wrapper-{{ section_id }}">
    <!-- We need two tracks for seamless infinite scroll -->
    {% for track in (1..2) %}
      <div class="hp6-marquee-track-{{ section_id }}" aria-hidden="{% if forloop.index == 2 %}true{% else %}false{% endif %}">
        {% for block in section.blocks %}
          {% if block.type == 'logo' %}
            <div class="hp6-press-logo-{{ section_id }}" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 400 }}" 
                     alt="{{ block.settings.image.alt | default: 'Press Logo' }}"
                     loading="lazy"
                     width="200"
                     height="100">
              {% else %}
                <div style="width: 150px; height: 50px; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; color: #fff; font-family: monospace; font-weight: bold; border-radius: 4px; border: 1px dashed rgba(255,255,255,0.3);">
                  LOGO {{ forloop.index }}
                </div>
              {% endif %}
              
              {% if block.settings.quote != blank %}
                <div class="hp6-press-quote-{{ section_id }}">
                  "{{ block.settings.quote }}"
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>

<script>
  // Simple intersection observer to only animate marquee when in viewport for performance
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('#shopify-section-{{ section_id }}');
    const tracks = section.querySelectorAll('.hp6-marquee-track-{{ section_id }}');
    
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            tracks.forEach(track => track.style.animationPlayState = 'running');
          } else {
            tracks.forEach(track => track.style.animationPlayState = 'paused');
          }
        });
      }, { rootMargin: '100px' });
      
      observer.observe(section);
    }
  });
</script>

{% schema %}
{
  "name": "HP6 Press Logos",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "hover_glow_color",
      "label": "Hover Glow/Accent Color",
      "default": "#00ffcc"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "APPROVED BY THE PROS"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "As seen in leading fitness publications and trusted by top athletes worldwide."
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Marquee Speed (Seconds)",
      "min": 10,
      "max": 60,
      "step": 1,
      "default": 25
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Default Logo Opacity (%)",
      "min": 10,
      "max": 100,
      "step": 10,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Hover Quote (Optional)",
          "default": "The best gear on the market."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP6 Press Logos",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
