{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#00FF41'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 80px 40px;
    border-bottom: 1px solid rgba(0, 255, 65, 0.3);
  }
  
  .hp17-usp-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  
  .hp17-usp-item-{{ section_id }} {
    color: {{ text_color }};
    background: #0A0A0A;
    border: 1px solid rgba(0, 255, 65, 0.3);
    padding: 40px 30px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }
  
  .hp17-usp-item-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 4px; height: 100%;
    background: #00FF41;
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.3s ease;
  }
  
  .hp17-usp-item-{{ section_id }}:hover {
    border-color: #00FF41;
    box-shadow: 0 0 15px rgba(0, 255, 65, 0.2);
    transform: translateY(-5px);
  }
  
  .hp17-usp-item-{{ section_id }}:hover::before {
    transform: scaleY(1);
  }
  
  .hp17-usp-header-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
  }
  
  .hp17-usp-index-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.8rem;
    color: rgba(0, 255, 65, 0.5);
  }
  
  .hp17-usp-title-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: 1.5rem;
    text-transform: uppercase;
    margin: 0;
    color: #FFF;
    letter-spacing: 1px;
  }
  
  .hp17-usp-text-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 992px) {
    .hp17-usp-container-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 40px 20px;
    }
  }
</style>

<div class="hp17-usp-container-{{ section_id }}">
  {% for block in section.blocks limit: 3 %}
    <div class="hp17-usp-item-{{ section_id }}" {{ block.shopify_attributes }}>
      <div class="hp17-usp-header-{{ section_id }}">
        <span class="hp17-usp-index-{{ section_id }}">0{{ forloop.index }}//</span>
        <h3 class="hp17-usp-title-{{ section_id }}">{{ block.settings.title }}</h3>
      </div>
      <p class="hp17-usp-text-{{ section_id }}">{{ block.settings.text }}</p>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP17 USP",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#00FF41"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "SYSTEM PROTOCOL"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "All gear engineered for maximum performance and stealth capabilities."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP17 USP",
      "blocks": [
        { "type": "usp", "settings": { "title": "RAPID DEPLOY", "text": "Global shipping algorithms ensure your gear arrives before you need it." } },
        { "type": "usp", "settings": { "title": "STEALTH RETURNS", "text": "30-day return policy. No questions asked. Wipe the data." } },
        { "type": "usp", "settings": { "title": "ENCRYPTED SECURE", "text": "Military-grade encryption protects all transactions." } }
      ]
    }
  ]
}
{% endschema %}
