{%- style -%}#shopify-section-{{ section.id }}{background:#fff;padding:22px 0;border-bottom:1px solid rgba(0,0,0,.06)}.hp95-usp{max-width:1280px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:16px}@media(max-width:700px){.hp95-usp{grid-template-columns:repeat(2,1fr)}}.hp95-u{display:flex;gap:10px;align-items:center}.hp95-ico{width:38px;height:38px;border-radius:8px;background:#E11D4818;color:#E11D48;display:grid;place-items:center;border:1px solid #E11D4830}{%- endstyle -%}<div class="hp95-usp">{% for block in section.blocks %}<div class="hp95-u"><div class="hp95-ico">{{block.settings.icon}}</div><div><b style="font-size:13px">{{block.settings.title}}</b><br><small style="opacity:.6">{{block.settings.desc}}</small></div></div>{% else %}<div class="hp95-u"><div class="hp95-ico">✓</div><div><b>Free Ship</b><br><small>Over ₹999</small></div></div><div class="hp95-u"><div class="hp95-ico">↺</div><div><b>Returns</b><br><small>7 days</small></div></div><div class="hp95-u"><div class="hp95-ico">★</div><div><b>4.8 ★</b><br><small>50k reviews</small></div></div>{% if 4==4 %}<div class="hp95-u"><div class="hp95-ico">⚡</div><div><b>COD</b><br><small>Pan India</small></div></div>{% endif %}{% endfor %}</div>{% schema %}
{
  "name": "HP95 USP",
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Desc",
          "default": "Over ₹999"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP95 USP"
    }
  ]
}
{% endschema %}