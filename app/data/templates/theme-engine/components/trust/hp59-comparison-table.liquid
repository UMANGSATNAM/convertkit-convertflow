{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FFFBEB' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp59-comp__container { max-width: {{ section.settings.container_width | default: 1000 }}px; margin: 0 auto; padding: 0 24px; }
  .hp59-comp__header { text-align: center; margin-bottom: 50px; }
  .hp59-comp__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#F97316' }}; margin: 0 0 12px; }
  .hp59-comp__heading { font-family: 'Cormorant Garamond', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #042F2E; margin: 0; }
  .hp59-comp__table {
    width: 100%; border-collapse: collapse; background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border-radius: 16px; overflow: hidden; border: 1px solid rgba(249, 115, 22, 0.2);
    box-shadow: 0 4px 25px rgba(249, 115, 22, 0.08);
  }
  .hp59-comp__table th {
    background: #FEF3C7; color: #9A3412; font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    padding: 18px 20px; text-align: left; border-bottom: 1px solid rgba(249, 115, 22, 0.2);
  }
  .hp59-comp__table td {
    padding: 16px 20px; font-size: 14px; color: #334155;
    border-bottom: 1px solid rgba(249, 115, 22, 0.1);
  }
  .hp59-comp__table tr:last-child td { border-bottom: none; }
  .hp59-comp__check { color: #F97316; font-weight: 700; }
  @media screen and (max-width: 768px) {
    .hp59-comp__table { font-size: 13px; }
    .hp59-comp__table th, .hp59-comp__table td { padding: 12px 14px; }
  }
{%- endstyle -%}
<div class="hp59-comp__container">
  <div class="hp59-comp__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp59-comp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp59-comp__heading">{{ section.settings.heading | default: 'The Marine Antioxidant Scale' }}</h2>
  </div>
  <table class="hp59-comp__table">
    <thead>
      <tr>
        <th>{{ section.settings.col1_head | default: 'Criteria' }}</th>
        <th>{{ section.settings.col2_head | default: 'Sunset Coral Astaxanthin' }}</th>
        <th>{{ section.settings.col3_head | default: 'Standard Vitamin C' }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for block in section.blocks -%}
        <tr {{ block.shopify_attributes }}>
          <td>{{ block.settings.feature | default: 'Antioxidant Multiplier' }}</td>
          <td class="hp59-comp__check">{{ block.settings.us | default: '🪸 6,000x Vitamin C' }}</td>
          <td style="color:#64748B;">{{ block.settings.them | default: '1x Baseline' }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
</div>
{% schema %}
{
  "name": "HP59 Compare",
  "class": "section-hp59-comp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFBEB" },
    { "type": "color", "id": "card_bg", "label": "Table BG", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#F97316" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🪸 BENCHMARK" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Marine Antioxidant Scale" },
    { "type": "text", "id": "col1_head", "label": "Column 1", "default": "Criteria" },
    { "type": "text", "id": "col2_head", "label": "Column 2", "default": "Sunset Coral Astaxanthin" },
    { "type": "text", "id": "col3_head", "label": "Column 3", "default": "Standard Vitamin C" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 1000 }
  ],
  "blocks": [{
    "type": "row", "name": "Row",
    "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "Antioxidant Multiplier" },
      { "type": "text", "id": "us", "label": "Us", "default": "🪸 6,000x Vitamin C" },
      { "type": "text", "id": "them", "label": "Others", "default": "1x Baseline" }
    ]
  }],
  "presets": [{
    "name": "HP59 Compare",
    "blocks": [
      { "type": "row", "settings": { "feature": "Free Radical Scavenging", "us": "🪸 6,000x Stronger than Vit C", "them": "Easily Oxidizes & Destabilizes" } },
      { "type": "row", "settings": { "feature": "Cell Membrane Span", "us": "🪸 Spans Entire Bilayer Shield", "them": "Surface Cytoplasm Only" } },
      { "type": "row", "settings": { "feature": "Photo-Protection", "us": "🪸 Protects Under UV Radiation", "them": "Decomposes in Sunlight" } },
      { "type": "row", "settings": { "feature": "Pro-Oxidant Risk", "us": "🪸 Never Turns Pro-Oxidant", "them": "Can Turn Pro-Oxidant at High Dose" } }
    ]
  }]
}
{% endschema %}
