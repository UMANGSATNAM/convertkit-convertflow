{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Oswald:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    
    --font-serif: 'Playfair Display', serif;
    --font-sans: 'Oswald', sans-serif;
    
    background-color: var(--bg-color);
  }

  .hp36-usp-wrapper {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--border-color);
  }

  @media screen and (max-width: 992px) {
    .hp36-usp-wrapper {
      grid-template-columns: 1fr;
    }
  }

  .hp36-usp__item {
    padding: 60px 40px;
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    transition: background-color 0.3s ease;
  }

  .hp36-usp__item:last-child {
    border-right: none;
  }

  @media screen and (max-width: 992px) {
    .hp36-usp__item {
      border-right: none;
      border-bottom: 1px solid var(--border-color);
    }
    .hp36-usp__item:last-child {
      border-bottom: none;
    }
  }

  .hp36-usp__item:hover {
    background-color: rgba(0,0,0,0.02);
  }

  .hp36-usp__number {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 20px;
    opacity: 0.5;
  }

  .hp36-usp__title {
    font-family: var(--font-serif);
    font-size: 32px;
    color: var(--text-color);
    margin: 0 0 15px;
    font-weight: 400;
  }

  .hp36-usp__title em {
    font-style: italic;
  }

  .hp36-usp__text {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-color);
    line-height: 1.6;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    max-width: 300px;
    margin: 0 auto;
    opacity: 0.8;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp36-usp-wrapper" id="HP36USP-{{ section.id }}">
  {%- for block in section.blocks limit: 3 -%}
    <div class="hp36-usp__item" {{ block.shopify_attributes }}>
      <div class="hp36-usp__number">No. 0{{ forloop.index }}</div>
      <h3 class="hp36-usp__title">{{ block.settings.title }}</h3>
      <div class="hp36-usp__text">{{ block.settings.text }}</div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP36 - Editorial USP",
  "class": "section-hp36-usp",
  "settings": [
    {
      "type": "header",
      "content": "Editorial Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Avant-Garde Design"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Pushing the boundaries of modern aesthetics."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP36 - Editorial USP",
      "blocks": [
        { "type": "usp", "settings": { "title": "Avant-Garde", "text": "Pushing boundaries of aesthetics." } },
        { "type": "usp", "settings": { "title": "Unrivaled Craft", "text": "Precision in every detail." } },
        { "type": "usp", "settings": { "title": "Limited Edition", "text": "Exclusive curations released monthly." } }
      ]
    }
  ]
}
{% endschema %}
