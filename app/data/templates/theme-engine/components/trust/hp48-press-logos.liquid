{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp48-press-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
    
    background-color: var(--hp48-press-bg);
    padding: {{ section.settings.padding_vertical | default: 30 }}px 0;
    border-top: 1px solid rgba(197, 155, 39, 0.3);
    border-bottom: 1px solid rgba(197, 155, 39, 0.3);
  }

  .hp48-press__wrap {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: 30px;
    font-family: 'Cinzel', serif;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #1A1715;
    opacity: 0.85;
  }
{%- endstyle -%}

<div class="hp48-press__wrap">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.title }}</span>
    {%- endfor -%}
  {%- else -%}
    <span>VOGUE ARABIA</span>
    <span>HARPER'S BAZAAR</span>
    <span>L'OFFICIEL MONACO</span>
    <span>TATLER HAUTE</span>
    <span>ROBB REPORT</span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP48 - Royal Press",
  "class": "section-hp48-press",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF8F5" },
    { "type": "range", "id": "padding_vertical", "min": 15, "max": 60, "step": 5, "unit": "px", "label": "Vertical Padding", "default": 30 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1100 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Publication Name", "default": "VOGUE ARABIA" }
      ]
    }
  ],
  "presets": [
    { "name": "HP48 - Royal Press" }
  ]
}
{% endschema %}
