{%- liquid
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign border_color = section.settings.border_color | default: '#333333'
  assign speed = section.settings.animation_speed | default: 20
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp2-press-bg: {{ bg_color }};
    --hp2-press-text: {{ text_color }};
    --hp2-press-border: {{ border_color }};
    --hp2-press-speed: {{ speed }}s;
    
    --hp2-press-pt-desk: {{ padding_top_desktop }}px;
    --hp2-press-pb-desk: {{ padding_bottom_desktop }}px;
    --hp2-press-pt-mob: {{ padding_top_mobile }}px;
    --hp2-press-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp2-fashion-press-{{ section.id }} {
    padding-top: var(--hp2-press-pt-desk);
    padding-bottom: var(--hp2-press-pb-desk);
    background-color: var(--hp2-press-bg);
    color: var(--hp2-press-text);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    border-top: 1px solid var(--hp2-press-border);
    border-bottom: 1px solid var(--hp2-press-border);
    overflow: hidden;
  }
  
  .hp2-press-inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
  }
  
  .hp2-press-header {
    text-align: center;
    margin-bottom: 40px;
  }
  
  .hp2-press-title {
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin: 0;
    opacity: 0.6;
  }

  .hp2-press-track-wrapper {
    display: flex;
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  /* Fade edges */
  .hp2-press-track-wrapper::before,
  .hp2-press-track-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100px;
    pointer-events: none;
    z-index: 2;
  }
  .hp2-press-track-wrapper::before {
    left: 0;
    background: linear-gradient(to right, var(--hp2-press-bg), transparent);
  }
  .hp2-press-track-wrapper::after {
    right: 0;
    background: linear-gradient(to left, var(--hp2-press-bg), transparent);
  }

  .hp2-press-track {
    display: flex;
    align-items: center;
    white-space: nowrap;
    will-change: transform;
    animation: hp2PressMarquee var(--hp2-press-speed) linear infinite;
  }
  
  {% if section.settings.pause_on_hover %}
    .hp2-fashion-press-{{ section.id }}:hover .hp2-press-track {
      animation-play-state: paused;
    }
  {% endif %}

  .hp2-press-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 50px;
    flex-shrink: 0;
  }

  .hp2-press-logo {
    height: {{ section.settings.logo_height }}px;
    width: auto;
    max-width: 200px;
    object-fit: contain;
    /* Convert logos to grayscale and lower opacity unless hovered */
    filter: grayscale(100%) opacity(0.5) contrast(1.2);
    transition: all 0.3s ease;
  }

  /* Highlight on hover */
  .hp2-press-item:hover .hp2-press-logo {
    filter: grayscale(0%) opacity(1) contrast(1);
    transform: scale(1.05);
  }
  
  /* Fallback text if no logo image */
  .hp2-press-text {
    font-size: 24px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.5px;
    opacity: 0.5;
    transition: all 0.3s ease;
  }
  .hp2-press-item:hover .hp2-press-text {
    opacity: 1;
    transform: scale(1.05);
  }

  @keyframes hp2PressMarquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); } /* Scrolls half because content is duplicated */
  }

  @media screen and (max-width: 768px) {
    .hp2-fashion-press-{{ section.id }} {
      padding-top: var(--hp2-press-pt-mob);
      padding-bottom: var(--hp2-press-pb-mob);
    }
    .hp2-press-inner {
      padding: 0;
    }
    .hp2-press-track-wrapper::before,
    .hp2-press-track-wrapper::after {
      width: 40px;
    }
    .hp2-press-item {
      padding: 0 30px;
    }
    .hp2-press-logo {
      height: {{ section.settings.logo_height_mobile }}px;
    }
    /* Disable hover effects on mobile */
    .hp2-press-item:hover .hp2-press-logo {
      filter: grayscale(100%) opacity(0.5) contrast(1.2);
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp2-press-track {
      animation: none !important;
      transform: none !important;
      flex-wrap: wrap;
      justify-content: center;
    }
    .hp2-press-item {
      margin: 15px;
    }
    /* Hide the duplicated set if no animation */
    .hp2-press-track .hp2-press-item:nth-child(n+{{ section.blocks.size | plus: 1 }}) {
      display: none;
    }
    .hp2-press-track-wrapper::before,
    .hp2-press-track-wrapper::after {
      display: none;
    }
  }
</style>

<section class="hp2-fashion-press-{{ section.id }}" aria-label="Press and Media Mentions">
  <div class="hp2-press-inner">
    
    {%- if section.settings.heading != blank -%}
      <div class="hp2-press-header">
        <h2 class="hp2-press-title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="hp2-press-track-wrapper">
      <div class="hp2-press-track">
        
        {%- capture press_content -%}
          {%- for block in section.blocks -%}
            <div class="hp2-press-item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" target="_blank" rel="noopener" aria-label="Read press article from {{ block.settings.title | default: 'Publisher' }}">
              {%- endif -%}
              
              {%- if block.settings.logo != blank -%}
                <img src="{{ block.settings.logo | image_url: width: 400 }}" 
                     class="hp2-press-logo" 
                     loading="lazy" 
                     alt="{{ block.settings.logo.alt | default: block.settings.title | escape }}">
              {%- else -%}
                <span class="hp2-press-text">{{ block.settings.title | default: 'PUBLISHER' }}</span>
              {%- endif -%}
              
              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
          
          {%- if section.blocks.size == 0 -%}
            {%- for i in (1..5) -%}
              <div class="hp2-press-item">
                <span class="hp2-press-text">VOGUE</span>
              </div>
              <div class="hp2-press-item">
                <span class="hp2-press-text">GQ</span>
              </div>
              <div class="hp2-press-item">
                <span class="hp2-press-text">HYPEBEAST</span>
              </div>
              <div class="hp2-press-item">
                <span class="hp2-press-text">HIGHSNOBIETY</span>
              </div>
            {%- endfor -%}
          {%- endif -%}
        {%- endcapture -%}

        {{ press_content }}
        {{ press_content }}
        
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP2 Press Logos",
  "tag": "section",
  "class": "section-hp2-press",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AS SEEN IN"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20, "max": 100, "step": 2, "unit": "px",
      "label": "Desktop Logo Height",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "min": 10, "max": 60, "step": 2, "unit": "px",
      "label": "Mobile Logo Height",
      "default": 24
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 10, "max": 60, "step": 1, "unit": "sec",
      "label": "Scroll Speed",
      "info": "Lower is faster.",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 40
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Publisher Name (Fallback)",
          "info": "Used if no image is selected, or for screen readers."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Article Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP2 Press Logos (Advanced)",
      "category": "Trust",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
