{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#090D16' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp64-comp__container { max-width: {{ section.settings.container_width | default: 1000 }}px; margin: 0 auto; padding: 0 24px; }
  .hp64-comp__header { text-align: center; margin-bottom: 50px; }
  .hp64-comp__eyebrow { font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#06B6D4' }}; margin: 0 0 12px; }
  .hp64-comp__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; color: #FFFFFF; margin: 0; }
  .hp64-comp__table {
    width: 100%; border-collapse: collapse; background: {{ section.settings.card_bg | default: '#030712' }};
    border-radius: 6px; overflow: hidden; border: 1px solid rgba(6, 182, 212, 0.3);
    box-shadow: 0 0 35px rgba(6, 182, 212, 0.15);
  }
  .hp64-comp__table th {
    background: #020617; color: #06B6D4; font-family: 'Space Grotesk', sans-serif;
    font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    padding: 18px 20px; text-align: left; border-bottom: 1px solid rgba(6, 182, 212, 0.3);
  }
  .hp64-comp__table td {
    padding: 16px 20px; font-size: 14px; color: #F1F5F9;
    border-bottom: 1px solid rgba(6, 182, 212, 0.1); font-family: 'Space Grotesk', sans-serif;
  }
  .hp64-comp__table tr:last-child td { border-bottom: none; }
  .hp64-comp__check { color: #06B6D4; font-weight: 700; }
  @media screen and (max-width: 768px) {
    .hp64-comp__table { font-size: 13px; }
    .hp64-comp__table th, .hp64-comp__table td { padding: 12px 14px; }
  }
{%- endstyle -%}
<div class="hp64-comp__container">
  <div class="hp64-comp__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp64-comp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp64-comp__heading">{{ section.settings.heading | default: 'The Bio-Luminescent Spectrum Index' }}</h2>
  </div>
  <table class="hp64-comp__table">
    <thead>
      <tr>
        <th>{{ section.settings.col1_head | default: 'Bio-Active Metric' }}</th>
        <th>{{ section.settings.col2_head | default: 'Bio-Luminescent Deep Spectrum' }}</th>
        <th>{{ section.settings.col3_head | default: 'Standard Marine Algae' }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for block in section.blocks -%}
        <tr {{ block.shopify_attributes }}>
          <td>{{ block.settings.feature | default: 'Cellular Photon Output' }}</td>
          <td class="hp64-comp__check">{{ block.settings.us | default: '🧬 Active Luciferin Enzyme Complex' }}</td>
          <td style="color:#64748B;">{{ block.settings.them | default: 'Zero Photon Emission' }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
</div>
{% schema %}
{
  "name": "HP64 Compare",
  "class": "section-hp64-comp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#090D16" },
    { "type": "color", "id": "card_bg", "label": "Table BG", "default": "#030712" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#06B6D4" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🧬 SPECTRUM BENCHMARK" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Bio-Luminescent Spectrum Index" },
    { "type": "text", "id": "col1_head", "label": "Column 1", "default": "Bio-Active Metric" },
    { "type": "text", "id": "col2_head", "label": "Column 2", "default": "Bio-Luminescent Deep Spectrum" },
    { "type": "text", "id": "col3_head", "label": "Column 3", "default": "Standard Marine Algae" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 1000 }
  ],
  "blocks": [{
    "type": "row", "name": "Row",
    "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "Cellular Photon Output" },
      { "type": "text", "id": "us", "label": "Us", "default": "🧬 Active Luciferin Enzyme Complex" },
      { "type": "text", "id": "them", "label": "Others", "default": "Zero Photon Emission" }
    ]
  }],
  "presets": [{
    "name": "HP64 Compare",
    "blocks": [
      { "type": "row", "settings": { "feature": "Pressure Stability", "us": "🧬 400 Bar Hydrothermal Pressure Stable", "them": "Degrades Under Environmental Heat" } },
      { "type": "row", "settings": { "feature": "HEV Blue Light Defense", "us": "🧬 98.4% High-Energy Absorption", "them": "Unfiltered Light Penetration" } },
      { "type": "row", "settings": { "feature": "Mitochondrial ATP Boost", "us": "🧬 +86% Cellular Energy Production", "them": "Temporary Hydration Only" } },
      { "type": "row", "settings": { "feature": "Cultivation Ethics", "us": "🧬 Closed-Loop Zero-Waste Bio-Reactors", "them": "Wild Marine Habitat Depletion" } }
    ]
  }]
}
{% endschema %}
