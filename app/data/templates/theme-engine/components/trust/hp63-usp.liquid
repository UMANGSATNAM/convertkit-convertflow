{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FEF3C7' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }
  .hp63-usp__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp63-usp__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr); gap: 20px; }
  .hp63-usp__card {
    background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border: 1px solid rgba(217, 119, 6, 0.25);
    border-radius: 6px; padding: 32px 22px; text-align: center;
    box-shadow: 0 4px 20px rgba(136, 19, 55, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hp63-usp__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(136, 19, 55, 0.12);
  }
  .hp63-usp__icon {
    width: 52px; height: 52px;
    background: linear-gradient(135deg, #FCE7F3, #881337);
    border-radius: 4px; display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px; font-size: 22px; color: #FFFFFF;
    border: 1px solid rgba(217, 119, 6, 0.3);
  }
  .hp63-usp__title {
    font-family: 'Playfair Display', serif; font-size: 19px; font-weight: 700; color: #1C1917; margin: 0 0 8px;
  }
  .hp63-usp__desc { font-size: 13px; line-height: 1.6; color: #57534E; margin: 0; }
  @media screen and (max-width: 992px) { .hp63-usp__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp63-usp__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp63-usp__container">
  <div class="hp63-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp63-usp__card" {{ block.shopify_attributes }}>
        <div class="hp63-usp__icon">{{ block.settings.icon | default: '🌹' }}</div>
        <h3 class="hp63-usp__title">{{ block.settings.title | default: 'Dades Damask Rose' }}</h3>
        <p class="hp63-usp__desc">{{ block.settings.description | default: 'Dawn harvested petals.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP63 Pillars",
  "class": "section-hp63-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FEF3C7" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#FFFFFF" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "pillar", "name": "Pillar", "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "🌹" },
    { "type": "text", "id": "title", "label": "Title", "default": "Dades Damask Rose" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Dawn harvested petals." }
  ]}],
  "presets": [{ "name": "HP63 Pillars", "blocks": [
    { "type": "pillar", "settings": { "icon": "🌹", "title": "Dades Valley Damask Rose", "description": "Harvested strictly before dawn to preserve volatile rose damascenone aromatics." } },
    { "type": "pillar", "settings": { "icon": "🏺", "title": "Aged Spiced Amber", "description": "Warm soothing tree resin providing rich triterpenoid barrier protective lipids." } },
    { "type": "pillar", "settings": { "icon": "✨", "title": "Cold-Pressed Desert Argan", "description": "High concentration of vitamin E and omega-6 fatty acids to nourish depleted tissue." } },
    { "type": "pillar", "settings": { "icon": "🍊", "title": "Moroccan Neroli Flower", "description": "Pure orange blossom hydrosol reducing surface cortisol and hormonal breakouts." } }
  ]}]
}
{% endschema %}
