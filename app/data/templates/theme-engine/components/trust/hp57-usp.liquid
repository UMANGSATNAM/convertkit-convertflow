{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0F291E' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }
  .hp57-usp__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp57-usp__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr); gap: 20px; }
  .hp57-usp__card {
    background: {{ section.settings.card_bg | default: '#1B4332' }};
    border: 1px solid rgba(167, 243, 208, 0.15);
    border-radius: 12px; padding: 32px 22px; text-align: center;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .hp57-usp__card:hover { transform: translateY(-4px); border-color: rgba(167, 243, 208, 0.4); }
  .hp57-usp__icon {
    width: 52px; height: 52px;
    background: linear-gradient(135deg, #0F291E, #2D5A43);
    border-radius: 10px; display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px; font-size: 22px; color: #A7F3D0;
    border: 1px solid rgba(167, 243, 208, 0.25);
  }
  .hp57-usp__title {
    font-family: 'Cormorant Garamond', serif; font-size: 18px; font-weight: 700; color: #FFFFFF; margin: 0 0 8px;
  }
  .hp57-usp__desc { font-size: 13px; line-height: 1.6; color: #CBD5E1; margin: 0; }
  @media screen and (max-width: 992px) { .hp57-usp__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp57-usp__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp57-usp__container">
  <div class="hp57-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp57-usp__card" {{ block.shopify_attributes }}>
        <div class="hp57-usp__icon">{{ block.settings.icon | default: '🌿' }}</div>
        <h3 class="hp57-usp__title">{{ block.settings.title | default: 'Botanical Alchemy' }}</h3>
        <p class="hp57-usp__desc">{{ block.settings.description | default: 'Cold-pressed forest bio-lipids.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP57 Pillars",
  "class": "section-hp57-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0F291E" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#1B4332" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "pillar", "name": "Pillar", "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "🌿" },
    { "type": "text", "id": "title", "label": "Title", "default": "Botanical Alchemy" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Cold-pressed forest bio-lipids." }
  ]}],
  "presets": [{ "name": "HP57 Pillars", "blocks": [
    { "type": "pillar", "settings": { "icon": "🌿", "title": "Wild Forest Fern", "description": "Cold-macerated lipid complex for deep hydration." } },
    { "type": "pillar", "settings": { "icon": "🌼", "title": "Ochre Calendula", "description": "Soothing flower oil calming stressed barriers." } },
    { "type": "pillar", "settings": { "icon": "🧪", "title": "Apothecary Cold-Press", "description": "Zero heat extraction preserving all live enzymes." } },
    { "type": "pillar", "settings": { "icon": "🌱", "title": "Biodynamic Certified", "description": "Sustainably grown in protected alpine soil." } }
  ]}]
}
{% endschema %}
