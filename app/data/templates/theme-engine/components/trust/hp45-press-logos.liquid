{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp45-press-bg: {{ section.settings.bg_color | default: '#F5F5F0' }};
    --hp45-border: {{ section.settings.border_color | default: '#0A0A0A' }};
    
    background-color: var(--hp45-press-bg);
    padding: {{ section.settings.padding_vertical | default: 28 }}px 0;
    border-top: 2px solid var(--hp45-border);
    border-bottom: 2px solid var(--hp45-border);
  }

  .hp45-press__wrap {
    max-width: {{ section.settings.container_width | default: 1300 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: 30px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 17px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #0A0A0A;
  }
{%- endstyle -%}

<div class="hp45-press__wrap">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }}>[ {{ block.settings.title }} ]</span>
    {%- endfor -%}
  {%- else -%}
    <span>[ ARCHITECTURAL DIGEST ]</span>
    <span>[ MONOCLE LABS ]</span>
    <span>[ WIRED DERMATOLOGY ]</span>
    <span>[ WALLPAPER* AESTHETICS ]</span>
    <span>[ FAST COMPANY INNOVATION ]</span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP45 - Brutal Press",
  "class": "section-hp45-press",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F5F0" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#0A0A0A" },
    { "type": "range", "id": "padding_vertical", "min": 15, "max": 60, "step": 5, "unit": "px", "label": "Vertical Padding", "default": 30 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1300 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Publication",
      "settings": [
        { "type": "text", "id": "title", "label": "Publication Name", "default": "MONOCLE LABS" }
      ]
    }
  ],
  "presets": [
    { "name": "HP45 - Brutal Press" }
  ]
}
{% endschema %}
