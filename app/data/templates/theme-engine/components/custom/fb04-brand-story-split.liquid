{% comment %}
  FB04 Brand Story Split — Image left, text right with CTA
{% endcomment %}

<style>
  .fb04-story {
    padding: 100px 60px;
    background: #fff;
  }
  .fb04-story__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .fb04-story__image {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }
  .fb04-story__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fb04-story__image .placeholder-story {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #282A2F 0%, #3D4047 50%, #282A2F 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.1);
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: 36px;
    text-transform: uppercase;
    letter-spacing: 6px;
  }
  .fb04-story__text h2 {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 700;
    font-size: 42px;
    color: #282A2F;
    line-height: 1.1;
    margin-bottom: 20px;
  }
  .fb04-story__text p {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 400;
    font-size: 16px;
    color: #7B818E;
    line-height: 1.7;
    margin-bottom: 28px;
  }
  .fb04-story__link {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 600;
    font-size: 15px;
    color: #0066FF;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: gap 0.2s ease;
  }
  .fb04-story__link:hover {
    gap: 14px;
  }
  .fb04-story__link::after {
    content: '\2192';
    font-size: 18px;
  }

  @media (max-width: 809px) {
    .fb04-story {
      padding: 60px 24px;
    }
    .fb04-story__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .fb04-story__text h2 {
      font-size: 32px;
    }
  }
  @media (min-width: 810px) and (max-width: 1199px) {
    .fb04-story {
      padding: 80px 40px;
    }
    .fb04-story__inner {
      gap: 40px;
    }
    .fb04-story__text h2 {
      font-size: 36px;
    }
  }
</style>

<section class="fb04-story">
  <div class="fb04-story__inner">
    <div class="fb04-story__image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 800 }}"
             alt="{{ section.settings.heading }}" loading="lazy" width="800" height="800">
      {% else %}
        <div class="placeholder-story">RAWBLOX</div>
      {% endif %}
    </div>
    <div class="fb04-story__text">
      <h2>{{ section.settings.heading | default: 'Built by the Streets, Made for You' }}</h2>
      <p>{{ section.settings.body | default: "From the streets to your style—our journey is all about self-expression and rebellion. Join the movement." }}</p>
      <a href="{{ section.settings.cta_link | default: '#' }}" class="fb04-story__link">
        {{ section.settings.cta_text | default: 'Read our story' }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FB04 Brand Story",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Story Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built by the Streets, Made for You" },
    { "type": "textarea", "id": "body", "label": "Body Text", "default": "From the streets to your style—our journey is all about self-expression and rebellion. Join the movement." },
    { "type": "text", "id": "cta_text", "label": "CTA Text", "default": "Read our story" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" }
  ],
  "presets": [{ "name": "FB04 Brand Story" }]
}
{% endschema %}
