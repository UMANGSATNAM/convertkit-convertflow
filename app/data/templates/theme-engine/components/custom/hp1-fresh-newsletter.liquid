{%- liquid
  assign bg_color = section.settings.bg_color | default: '#1C1917'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
-%}

<section class="hp1-fresh-newsletter" style="--bg: {{ bg_color }}; --text: {{ text_color }};">
  <div class="hp1-fresh-newsletter__container">
    <div class="hp1-fresh-newsletter__card">
      
      <span class="hp1-fresh-newsletter__tag">Join The Glow Club</span>
      <h2 class="hp1-fresh-newsletter__title">Get $15 Off Your First Order + Secret Drops</h2>
      <p class="hp1-fresh-newsletter__subtitle">Subscribe to receive dermatologist skin tips, exclusive VIP sample drops, and 15% off your first purchase.</p>

      <form class="hp1-fresh-newsletter__form" onsubmit="event.preventDefault(); alert('Discount unlocked! Use code GLOW15 at checkout.');">
        <input type="email" placeholder="Enter your email address..." class="hp1-fresh-newsletter__input" required>
        <button type="submit" class="hp1-fresh-newsletter__btn">
          <span>Claim $15 Discount</span>
        </button>
      </form>

      <div class="hp1-fresh-newsletter__guarantee">
        🔒 We respect your privacy. Unsubscribe anytime with 1 click.
      </div>

    </div>
  </div>
</section>

<style>
  .hp1-fresh-newsletter {
    background-color: var(--bg);
    color: var(--text);
    padding: 80px 24px;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .hp1-fresh-newsletter__container {
    max-width: 900px;
    margin: 0 auto;
  }

  .hp1-fresh-newsletter__card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 28px;
    padding: 56px 40px;
    text-align: center;
    backdrop-filter: blur(12px);
  }

  .hp1-fresh-newsletter__tag {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #F59E0B;
    display: block;
    margin-bottom: 12px;
  }
  .hp1-fresh-newsletter__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 700;
    margin: 0 0 16px 0;
  }
  .hp1-fresh-newsletter__subtitle {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto 36px;
  }

  .hp1-fresh-newsletter__form {
    display: flex;
    max-width: 520px;
    margin: 0 auto 20px;
    gap: 12px;
  }
  @media (max-width: 576px) {
    .hp1-fresh-newsletter__form { flex-direction: column; }
  }

  .hp1-fresh-newsletter__input {
    flex-grow: 1;
    padding: 16px 20px;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.1);
    color: #FFF;
    font-size: 15px;
    outline: none;
  }
  .hp1-fresh-newsletter__input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }
  .hp1-fresh-newsletter__input:focus {
    border-color: #F59E0B;
    background: rgba(255, 255, 255, 0.15);
  }

  .hp1-fresh-newsletter__btn {
    background: #F59E0B;
    color: #1C1917;
    border: none;
    padding: 16px 28px;
    border-radius: 100px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .hp1-fresh-newsletter__btn:hover {
    background: #D97706;
    color: #FFF;
  }

  .hp1-fresh-newsletter__guarantee {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
  }
</style>

{% schema %}
{
  "name": "HP1 Fresh - Newsletter",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#1C1917" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "HP1 Fresh - Newsletter" }
  ]
}
{% endschema %}
