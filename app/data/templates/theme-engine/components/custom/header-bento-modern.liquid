{%- style -%}
#shopify-section-{{ section.id }}{--hdr-bg:#fdfbf7;--hdr-text:#1c1917;--hdr-accent:#7c3aed;background:var(--hdr-bg);border-bottom:1px solid rgba(0,0,0,.06);position:sticky;top:0;z-index:40;backdrop-filter:blur(8px)}
.hdr-bento-modern{max-width:1280px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.hdr-bento-modern__logo{font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--hdr-text);font-size:16px;text-decoration:none}
.hdr-bento-modern__nav{display:flex;gap:18px}
.hdr-bento-modern__nav a{font-size:13px;font-weight:600;color:var(--hdr-text);text-decoration:none;opacity:.8}
.hdr-bento-modern__nav a:hover{opacity:1;color:var(--hdr-accent)}
.hdr-bento-modern__cart{background:var(--hdr-accent);color:#fff;padding:8px 14px;border-radius:999px;font-size:12px;font-weight:700;text-decoration:none}
@media(max-width:768px){.hdr-bento-modern__nav{display:none}}
{%- endstyle -%}
<header class="hdr-bento-modern"><a href="/" class="hdr-bento-modern__logo">LIFESTYLE • BENTO-MODERN</a><nav class="hdr-bento-modern__nav"><a href="/collections/all">Shop</a><a href="/collections/all">New</a><a href="/pages/about">Story</a><a href="/pages/contact">Contact</a></nav><div><a href="{{ routes.cart_url }}" class="hdr-bento-modern__cart">Cart ({{ cart.item_count | default: 0 }})</a></div></header>
{% schema %}{"name":"Header bento-modern","settings":[],"presets":[{"name":"Header bento-modern"}]}{% endschema %}