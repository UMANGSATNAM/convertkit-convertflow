{%- style -%}
#shopify-section-{{ section.id }}{
  --hdr-bg: #fdfbf7;
  --hdr-text: #1c1917;
  --hdr-accent: #7c3aed;
  background: var(--hdr-bg);
  border-bottom:1px solid rgba(0,0,0,.06);
  position:sticky; top:0; z-index:40; backdrop-filter:blur(8px);
}
.hdr-index{max-width:1280px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.hdr-index__logo{font-family:'Playfair Display',sans-serif;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--hdr-text);font-size:16px;text-decoration:none}
.hdr-index__nav{display:flex;gap:18px;align-items:center}
.hdr-index__nav a{font-size:13px;font-weight:600;color:var(--hdr-text);text-decoration:none;opacity:.8}
.hdr-index__nav a:hover{opacity:1;color:var(--hdr-accent)}
.hdr-index__actions{display:flex;gap:10px;align-items:center}
.hdr-index__cart{background:var(--hdr-accent);color:#fff;padding:8px 14px;border-radius:999px;font-size:12px;font-weight:700;text-decoration:none}
@media(max-width:768px){.hdr-index__nav{display:none}}
{%- endstyle -%}
<header class="hdr-index">
  <a href="/" class="hdr-index__logo">GENERAL <span style="color:var(--hdr-accent)">•</span> INDEX</a>
  <nav class="hdr-index__nav">
    <a href="/collections/all">Shop</a>
    <a href="/collections/all">New</a>
    <a href="/pages/about">Story</a>
    <a href="/pages/contact">Contact</a>
  </nav>
  <div class="hdr-index__actions">
    <a href="/search" style="color:var(--hdr-text);opacity:.7">Search</a>
    <a href="{{ routes.cart_url }}" class="hdr-index__cart">Cart ({{ cart.item_count | default: 0 }})</a>
  </div>
</header>
{% schema %}{"name":"Header index","settings":[],"presets":[{"name":"Header index"}]}{% endschema %}