{%- comment -%}
  Section: Streetwear Drop PDP (Handcrafted)
  Niche: Streetwear, Apparel, Limited Drops, Urban Fashion
  Aesthetics: Dark Obsidian, Neon Orange/Yellow Accents, Bold Brutalist Typography
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign inventory = current_variant.inventory_quantity | default: 12 -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Syncopate:wght@700&display=swap');

  .pdp-street-{{ section.id }} {
    --street-bg: #0A0A0A;
    --street-surface: #141414;
    --street-border: #262626;
    --street-text: #FAFAFA;
    --street-muted: #A3A3A3;
    --street-neon: #F59E0B;
    --street-red: #EF4444;
    --street-font-display: 'Syncopate', sans-serif;
    --street-font-body: 'Space Grotesk', sans-serif;

    background-color: var(--street-bg);
    color: var(--street-text);
    font-family: var(--street-font-body);
    padding-bottom: 60px;
  }

  /* Marquee Header */
  .pdp-street-marquee {
    background: var(--street-neon);
    color: #000;
    font-family: var(--street-font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 10px 0;
    overflow: hidden;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .pdp-street-marquee-track {
    display: inline-flex;
    gap: 24px;
    animation: streetMarquee 20s linear infinite;
  }

  @keyframes streetMarquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .pdp-street-container {
    max-width: 1280px;
    margin: 40px auto 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  @media (min-width: 992px) {
    .pdp-street-container {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 64px;
    }
  }

  /* Gallery */
  .pdp-street-gallery {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .pdp-street-main-box {
    position: relative;
    background: var(--street-surface);
    border: 1px solid var(--street-border);
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 1/1;
  }

  .pdp-street-main-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pdp-street-tag {
    position: absolute;
    top: 16px;
    left: 16px;
    background: #000;
    color: var(--street-neon);
    border: 1px solid var(--street-neon);
    font-family: var(--street-font-display);
    font-size: 11px;
    padding: 6px 12px;
    border-radius: 4px;
    letter-spacing: 0.1em;
  }

  .pdp-street-thumbs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .pdp-street-thumb-item {
    aspect-ratio: 1/1;
    border: 1px solid var(--street-border);
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    background: var(--street-surface);
    transition: all 0.2s ease;
  }

  .pdp-street-thumb-item.is-active,
  .pdp-street-thumb-item:hover {
    border-color: var(--street-neon);
  }

  .pdp-street-thumb-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Right Info */
  .pdp-street-title {
    font-family: var(--street-font-display);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 16px 0;
  }

  @media (min-width: 768px) {
    .pdp-street-title {
      font-size: 42px;
    }
  }

  .pdp-street-price-box {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .pdp-street-price {
    font-size: 32px;
    font-weight: 700;
    color: var(--street-text);
  }

  .pdp-street-compare-price {
    font-size: 20px;
    color: var(--street-muted);
    text-decoration: line-through;
  }

  /* Scarcity Bar */
  .pdp-street-scarcity {
    background: var(--street-surface);
    border: 1px solid var(--street-border);
    border-radius: 10px;
    padding: 16px;
    margin-bottom: 28px;
  }

  .pdp-street-scarcity-top {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .pdp-street-progress {
    height: 6px;
    background: #262626;
    border-radius: 99px;
    overflow: hidden;
  }

  .pdp-street-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #F59E0B, #EF4444);
    border-radius: 99px;
    width: 78%;
  }

  /* Size Selector */
  .pdp-street-sizes-head {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .pdp-street-sizes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 32px;
  }

  .pdp-street-size-btn {
    background: var(--street-surface);
    border: 1px solid var(--street-border);
    color: var(--street-text);
    padding: 14px;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pdp-street-size-btn:hover,
  .pdp-street-size-btn.is-selected {
    background: var(--street-neon);
    color: #000;
    border-color: var(--street-neon);
  }

  /* Buy Button */
  .pdp-street-atc-btn {
    width: 100%;
    background: var(--street-neon);
    color: #000;
    font-family: var(--street-font-display);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 20px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.25s ease;
    margin-bottom: 24px;
  }

  .pdp-street-atc-btn:hover {
    background: #FFF;
    box-shadow: 0 0 25px rgba(245, 158, 11, 0.4);
    transform: translateY(-2px);
  }

  /* Feature Grid */
  .pdp-street-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--street-border);
    font-size: 13px;
    color: var(--street-muted);
  }

  .pdp-street-feature-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pdp-street-feature-item svg {
    color: var(--street-neon);
    flex-shrink: 0;
  }
</style>

<div class="pdp-street-{{ section.id }}">
  
  <!-- MARQUEE BAR -->
  <div class="pdp-street-marquee">
    <div class="pdp-street-marquee-track">
      <span>★ LIMITED DROP NO. 04</span>
      <span>• 450 GSM HEAVYWEIGHT COTTON</span>
      <span>★ OVERSIZED FIT</span>
      <span>• FREE SHIPPING IN INDIA</span>
      <span>★ LIMITED DROP NO. 04</span>
      <span>• 450 GSM HEAVYWEIGHT COTTON</span>
      <span>★ OVERSIZED FIT</span>
      <span>• FREE SHIPPING IN INDIA</span>
    </div>
  </div>

  <div class="pdp-street-container">
    
    <!-- GALLERY -->
    <div class="pdp-street-gallery">
      <div class="pdp-street-main-box">
        <div class="pdp-street-tag">LIMITED DROP</div>
        {% if product.featured_media %}
          <img id="street-main-img-{{ section.id }}" src="{{ product.featured_media | image_url: width: 1000 }}" alt="{{ product.title | escape }}" width="1000" height="1000">
        {% else %}
          {{ 'product-1' | placeholder_svg_tag }}
        {% endif %}
      </div>

      {% if product.media.size > 1 %}
        <div class="pdp-street-thumbs-grid">
          {% for media in product.media limit: 4 %}
            <div class="pdp-street-thumb-item {% if forloop.first %}is-active{% endif %}" onclick="changeStreetImg('{{ media | image_url: width: 1000 }}', this)">
              <img src="{{ media | image_url: width: 300 }}" alt="" width="300" height="300" loading="lazy">
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- INFO -->
    <div class="pdp-street-info">
      <h1 class="pdp-street-title">{{ product.title }}</h1>
      
      <div class="pdp-street-price-box">
        <span class="pdp-street-price">{{ current_variant.price | money }}</span>
        {% if current_variant.compare_at_price > current_variant.price %}
          <span class="pdp-street-compare-price">{{ current_variant.compare_at_price | money }}</span>
        {% endif %}
      </div>

      <!-- SCARCITY -->
      <div class="pdp-street-scarcity">
        <div class="pdp-street-scarcity-top">
          <span>Hurry! Stock Running Low</span>
          <span style="color:var(--street-neon);">85% Sold Out</span>
        </div>
        <div class="pdp-street-progress">
          <div class="pdp-street-progress-fill"></div>
        </div>
      </div>

      <!-- SIZE PICKER -->
      <div class="pdp-street-sizes-head">
        <span>Select Size</span>
        <span style="color:var(--street-muted); cursor:pointer;">Size Guide 📏</span>
      </div>
      <div class="pdp-street-sizes-grid">
        <div class="pdp-street-size-btn" onclick="selectStreetSize(this)">S</div>
        <div class="pdp-street-size-btn is-selected" onclick="selectStreetSize(this)">M</div>
        <div class="pdp-street-size-btn" onclick="selectStreetSize(this)">L</div>
        <div class="pdp-street-size-btn" onclick="selectStreetSize(this)">XL</div>
      </div>

      <!-- CTA BUTTON -->
      <button type="button" class="pdp-street-atc-btn">
        ADD TO CART — {{ current_variant.price | money }}
      </button>

      <!-- FEATURES -->
      <div class="pdp-street-features">
        <div class="pdp-street-feature-item">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
          <span>450 GSM Organic Terry</span>
        </div>
        <div class="pdp-street-feature-item">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
          <span>Puff Print Graphics</span>
        </div>
        <div class="pdp-street-feature-item">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
          <span>Boxy / Oversized Silhouette</span>
        </div>
        <div class="pdp-street-feature-item">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
          <span>Ships in 24-48 Hours</span>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  function changeStreetImg(src, thumbEl) {
    const img = document.getElementById('street-main-img-{{ section.id }}');
    if (img) img.src = src;
    document.querySelectorAll('.pdp-street-thumb-item').forEach(t => t.classList.remove('is-active'));
    if (thumbEl) thumbEl.classList.add('is-active');
  }

  function selectStreetSize(btnEl) {
    document.querySelectorAll('.pdp-street-size-btn').forEach(b => b.classList.remove('is-selected'));
    if (btnEl) btnEl.classList.add('is-selected');
  }
</script>

{% schema %}
{
  "name": "Streetwear Drop PDP",
  "settings": [],
  "presets": [{ "name": "Streetwear Drop PDP" }]
}
{% endschema %}
