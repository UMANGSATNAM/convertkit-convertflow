{%- liquid
  assign section_id = section.id
  assign layout = section.settings.layout | default: 'full'
  assign style = section.settings.style | default: 'pills'
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign columns_mobile = section.settings.columns_mobile | default: 'slider'
  
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#2D3748'
  assign item_bg = section.settings.item_bg | default: '#F7FAFC'
  assign item_text = section.settings.item_text | default: '#2D3748'
  assign item_hover_bg = section.settings.item_hover_bg | default: '#2D3748'
  assign item_hover_text = section.settings.item_hover_text | default: '#FFFFFF'
  
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --item-bg: {{ item_bg }};
    --item-text: {{ item_text }};
    --item-hover-bg: {{ item_hover_bg }};
    --item-hover-text: {{ item_hover_text }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    --cols-desktop: {{ columns_desktop }};
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .hpv6-collections-{{ section_id }} {
    width: 100%;
    margin: 0 auto;
    {%- if layout == 'boxed' -%}
      max-width: var(--page-width, 1440px);
      padding-left: 5vw;
      padding-right: 5vw;
    {%- else -%}
      padding-left: 20px;
      padding-right: 20px;
    {%- endif -%}
  }

  .hpv6-collections__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hpv6-collections__title {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    margin: 0;
    line-height: 1.2;
  }

  .hpv6-collections__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-top: 1rem;
    opacity: 0.7;
  }

  /* Grid Layout */
  .hpv6-collections__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: center;
  }

  {%- if style == 'cards' -%}
    .hpv6-collections__grid {
      display: grid;
      grid-template-columns: repeat(var(--cols-desktop), 1fr);
      gap: 2rem;
    }
  {%- endif -%}

  /* Pill Style */
  .hpv6-collections__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 36px;
    border-radius: 50px;
    background-color: var(--item-bg);
    color: var(--item-text);
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.5px;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    border: 1px solid transparent;
  }

  .hpv6-collections__pill:hover,
  .hpv6-collections__pill:focus-visible {
    background-color: var(--item-hover-bg);
    color: var(--item-hover-text);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    outline: none;
  }
  
  .hpv6-collections__pill:focus-visible {
    box-shadow: 0 0 0 3px var(--item-hover-bg);
  }

  /* Card Style */
  .hpv6-collections__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background-color: var(--item-bg);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .hpv6-collections__card:hover,
  .hpv6-collections__card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.08);
    outline: none;
  }

  .hpv6-collections__card-image-wrap {
    position: relative;
    padding-top: 100%; /* 1:1 Aspect ratio */
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .hpv6-collections__card-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .hpv6-collections__card:hover .hpv6-collections__card-image {
    transform: scale(1.05);
  }

  .hpv6-collections__card-content {
    padding: 24px;
    text-align: center;
    background-color: var(--item-bg);
    color: var(--item-text);
    transition: all 0.3s ease;
  }

  .hpv6-collections__card:hover .hpv6-collections__card-content {
    background-color: var(--item-hover-bg);
    color: var(--item-hover-text);
  }

  .hpv6-collections__card-title {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: 1.5rem;
    margin: 0;
    font-weight: 500;
  }

  .hpv6-collections__card-count {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    margin-top: 8px;
    opacity: 0.8;
  }

  /* Mobile Adjustments */
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }

    .hpv6-collections__header {
      margin-bottom: 2rem;
    }

    {%- if columns_mobile == 'slider' -%}
      .hpv6-collections__grid {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        justify-content: flex-start;
        padding-bottom: 1rem;
      }
      
      .hpv6-collections__grid::-webkit-scrollbar {
        display: none;
      }

      .hpv6-collections__pill {
        flex: 0 0 auto;
        scroll-snap-align: center;
      }

      .hpv6-collections__card {
        flex: 0 0 80%;
        scroll-snap-align: center;
      }
    {%- else -%}
      {%- if style == 'cards' -%}
        .hpv6-collections__grid {
          grid-template-columns: repeat({{ columns_mobile }}, 1fr);
          gap: 1rem;
        }
      {%- endif -%}
    {%- endif -%}
  }
</style>

<div class="hpv6-collections-{{ section_id }}">
  
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="hpv6-collections__header">
      {%- if section.settings.title != blank -%}
        <h2 class="hpv6-collections__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <div class="hpv6-collections__subtitle">{{ section.settings.subtitle | escape }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="hpv6-collections__grid" role="list">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      {%- assign title = collection.title | default: 'Collection ' | append: forloop.index -%}
      {%- assign url = collection.url | default: '#' -%}
      
      <div role="listitem" {{ block.shopify_attributes }}>
        {%- if style == 'pills' -%}
          <a href="{{ url }}" class="hpv6-collections__pill" aria-label="Shop {{ title }}">
            {{ title }}
          </a>
        {%- else -%}
          <a href="{{ url }}" class="hpv6-collections__card" aria-label="Shop {{ title }}">
            <div class="hpv6-collections__card-image-wrap">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: 
                   loading: 'lazy',
                   class: 'hpv6-collections__card-image',
                   alt: block.settings.image.alt | default: title
                }}
              {%- elsif collection.image != blank -%}
                {{ collection.image | image_url: width: 600 | image_tag: 
                   loading: 'lazy',
                   class: 'hpv6-collections__card-image',
                   alt: collection.image.alt | default: title
                }}
              {%- else -%}
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'hpv6-collections__card-image placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="hpv6-collections__card-content">
              <h3 class="hpv6-collections__card-title">{{ title }}</h3>
              {%- if section.settings.show_count and collection != blank -%}
                <div class="hpv6-collections__card-count">{{ collection.products_count }} products</div>
              {%- endif -%}
            </div>
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

</div>

{% schema %}
{
  "name": "HPV6 Collection List",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Curated selections"
    },
    {
      "type": "header",
      "content": "Layout & Style"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Section Layout",
      "options": [
        { "value": "full", "label": "Full Width" },
        { "value": "boxed", "label": "Boxed" }
      ],
      "default": "boxed"
    },
    {
      "type": "select",
      "id": "style",
      "label": "List Style",
      "options": [
        { "value": "pills", "label": "Text Pills" },
        { "value": "cards", "label": "Image Cards" }
      ],
      "default": "cards"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count (Card style only)",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns on Desktop (Card style)",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Layout",
      "options": [
        { "value": "slider", "label": "Horizontal Slider" },
        { "value": "1", "label": "1 Column Grid" },
        { "value": "2", "label": "2 Column Grid" }
      ],
      "default": "slider"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "item_bg",
      "label": "Item Background",
      "default": "#F7FAFC"
    },
    {
      "type": "color",
      "id": "item_text",
      "label": "Item Text Color",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "item_hover_bg",
      "label": "Item Hover Background",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "item_hover_text",
      "label": "Item Hover Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image",
          "info": "Overrides collection image. Used only in Card style."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HPV6 Collection List",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
