{% comment %}
  FB04 Manifesto — Centered full-width text block with Instrument Serif accent
{% endcomment %}

<style>
  .fb04-manifesto {
    padding: 120px 60px;
    background: #fff;
  }
  .fb04-manifesto__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  .fb04-manifesto__title {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 700;
    font-size: 48px;
    color: #282A2F;
    line-height: 1.1;
    margin-bottom: 8px;
  }
  .fb04-manifesto__subtitle {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-weight: 400;
    font-size: 24px;
    color: #282A2F;
    margin-bottom: 32px;
  }
  .fb04-manifesto__body {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 400;
    font-size: 16px;
    color: #7B818E;
    line-height: 1.8;
    margin-bottom: 40px;
  }
  .fb04-manifesto__cta {
    display: inline-block;
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 600;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 14px 36px;
    background: #0066FF;
    color: #fff;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .fb04-manifesto__cta:hover {
    background: #2E82FF;
    transform: translateY(-2px);
  }

  @media (max-width: 809px) {
    .fb04-manifesto {
      padding: 60px 24px;
    }
    .fb04-manifesto__title {
      font-size: 32px;
    }
    .fb04-manifesto__subtitle {
      font-size: 18px;
    }
  }
  @media (min-width: 810px) and (max-width: 1199px) {
    .fb04-manifesto {
      padding: 80px 40px;
    }
    .fb04-manifesto__title {
      font-size: 40px;
    }
  }
</style>

<section class="fb04-manifesto">
  <div class="fb04-manifesto__inner">
    <h2 class="fb04-manifesto__title">{{ section.settings.title | default: 'Streetwear with a Story' }}</h2>
    <p class="fb04-manifesto__subtitle">{{ section.settings.subtitle | default: 'Wear the Movement, Break the Mold.' }}</p>
    <p class="fb04-manifesto__body">{{ section.settings.body | default: "Born from the pulse of the streets, our brand is a tribute to the rebels, the dreamers, and the rule-breakers who shape the culture. Inspired by the raw energy of city life—graffiti-covered alleys, underground music scenes, and late-night skate sessions—we craft streetwear that speaks to individuality and self-expression. Every stitch, every design, and every drop is a reflection of the movement, blending bold graphics, oversized silhouettes, and urban edge. More than just clothing, we're a statement—wear your story, break the mold, and define your own path." }}</p>
    <a href="{{ section.settings.cta_link | default: '#' }}" class="fb04-manifesto__cta">
      {{ section.settings.cta_text | default: 'Get it now' }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "FB04 Manifesto",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Streetwear with a Story" },
    { "type": "text", "id": "subtitle", "label": "Subtitle (Italic)", "default": "Wear the Movement, Break the Mold." },
    { "type": "textarea", "id": "body", "label": "Body Text", "default": "Born from the pulse of the streets, our brand is a tribute to the rebels, the dreamers, and the rule-breakers who shape the culture." },
    { "type": "text", "id": "cta_text", "label": "CTA Text", "default": "Get it now" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" }
  ],
  "presets": [{ "name": "FB04 Manifesto" }]
}
{% endschema %}
