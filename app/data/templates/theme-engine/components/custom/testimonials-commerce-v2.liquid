{%- style -%}
  .testimonials-commerce-v2 {
    background-color: var(--surface);
    padding: var(--space-48) 0;
    position: relative;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  @media (min-width: 768px) {
    .testimonials-commerce-v2 {
      padding: var(--space-64) 0;
    }
  }

  .testimonials-commerce-v2__header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto var(--space-40);
  }
  .testimonials-commerce-v2__pill {
    display: inline-block;
    background-color: var(--tint-green);
    color: var(--primary);
    font-size: var(--text-12);
    font-weight: 600;
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: var(--space-12);
  }
  .testimonials-commerce-v2__title {
    font-size: var(--text-32);
    font-weight: 400;
    color: var(--text-main);
    margin: 0 0 var(--space-12);
  }
  @media (min-width: 768px) {
    .testimonials-commerce-v2__title {
      font-size: var(--text-40);
    }
  }
  .testimonials-commerce-v2__subtext {
    font-size: var(--text-16);
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .testimonials-commerce-v2__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-20);
  }
  @media (min-width: 768px) {
    .testimonials-commerce-v2__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .testi-card {
    background-color: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: var(--space-28) var(--space-24);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-20);
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .testi-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .testi-card__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .testi-card__stars {
    display: flex;
    gap: 4px;
    color: #eab308;
  }
  .testi-card__stars svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
  .testi-card__quote {
    font-size: var(--text-16);
    color: var(--text-main);
    line-height: 1.6;
    margin: 0;
    font-style: italic;
  }

  .testi-card__author-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--border);
    padding-top: var(--space-16);
  }
  .testi-card__author-name {
    font-size: var(--text-14);
    font-weight: 600;
    color: var(--text-main);
    margin: 0;
  }
  .testi-card__author-sub {
    font-size: var(--text-12);
    color: var(--text-muted);
    margin: 0;
  }
  .testi-card__verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-12);
    font-weight: 500;
    color: var(--primary);
    background-color: var(--tint-green);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }
  .testi-card__verified svg {
    width: 12px;
    height: 12px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2.5;
  }
{%- endstyle -%}

<div class="testimonials-commerce-v2">
  <div class="fresh-container">
    <div class="testimonials-commerce-v2__header">
      <span class="testimonials-commerce-v2__pill">{{ section.settings.pill_text | default: "Client Reviews" }}</span>
      <h2 class="testimonials-commerce-v2__title">{{ section.settings.title | default: "Community Experiences" }}</h2>
      <p class="testimonials-commerce-v2__subtext">{{ section.settings.subtitle | default: "We invite verified customers to share their honest everyday feedback with our botanical rituals." }}</p>
    </div>

    <div class="testimonials-commerce-v2__grid">
      {%- for block in section.blocks -%}
        <div class="testi-card" {{ block.shopify_attributes }}>
          <div class="testi-card__top">
            <div class="testi-card__stars">
              {%- assign stars = block.settings.stars | default: 5 -%}
              {%- for i in (1..stars) -%}
                <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {%- endfor -%}
            </div>
            <p class="testi-card__quote">"{{ block.settings.quote | default: 'Share your customer feedback and genuine experience with your product ritual here.' }}"</p>
          </div>

          <div class="testi-card__author-row">
            <div>
              <h4 class="testi-card__author-name">{{ block.settings.author_name | default: 'Customer Name' }}</h4>
              {%- if block.settings.author_detail != blank -%}
                <p class="testi-card__author-sub">{{ block.settings.author_detail }}</p>
              {%- endif -%}
            </div>
            {%- if block.settings.show_verified -%}
              <span class="testi-card__verified">
                <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Verified Buyer
              </span>
            {%- endif -%}
          </div>
        </div>
      {%- else -%}
        <div class="testi-card">
          <div class="testi-card__top">
            <div class="testi-card__stars">
              {%- for i in (1..5) -%}<svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{%- endfor -%}
            </div>
            <p class="testi-card__quote">"Share your customer's honest review and daily experience with your product formulation here."</p>
          </div>
          <div class="testi-card__author-row">
            <div>
              <h4 class="testi-card__author-name">Customer Name</h4>
              <p class="testi-card__author-sub">Daily Ritual User</p>
            </div>
            <span class="testi-card__verified"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Verified Buyer</span>
          </div>
        </div>
        <div class="testi-card">
          <div class="testi-card__top">
            <div class="testi-card__stars">
              {%- for i in (1..5) -%}<svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{%- endfor -%}
            </div>
            <p class="testi-card__quote">"Highlight specific details about texture, scent, or packaging that your community enjoys."</p>
          </div>
          <div class="testi-card__author-row">
            <div>
              <h4 class="testi-card__author-name">Customer Name</h4>
              <p class="testi-card__author-sub">Verified Purchase</p>
            </div>
            <span class="testi-card__verified"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Verified Buyer</span>
          </div>
        </div>
        <div class="testi-card">
          <div class="testi-card__top">
            <div class="testi-card__stars">
              {%- for i in (1..5) -%}<svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{%- endfor -%}
            </div>
            <p class="testi-card__quote">"Let your customers speak for the quality and reliability of your brand and customer support."</p>
          </div>
          <div class="testi-card__author-row">
            <div>
              <h4 class="testi-card__author-name">Customer Name</h4>
              <p class="testi-card__author-sub">Repeat Customer</p>
            </div>
            <span class="testi-card__verified"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Verified Buyer</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials V2",
  "settings": [
    {
      "type": "text",
      "id": "pill_text",
      "label": "Badge Pill Text",
      "default": "Client Reviews"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Community Experiences"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtext",
      "default": "We invite verified customers to share their honest everyday feedback with our botanical rituals."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial Block",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star Rating"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote Text",
          "default": "Share your customer feedback and genuine experience with your product ritual here."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Customer Name"
        },
        {
          "type": "text",
          "id": "author_detail",
          "label": "Author Subtitle / Detail",
          "default": "Verified Buyer"
        },
        {
          "type": "checkbox",
          "id": "show_verified",
          "label": "Show Verified Badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials V2",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "Share your customer's honest review and daily experience with your product formulation here.", "author_name": "Customer Name", "author_detail": "Daily Ritual User" } },
        { "type": "testimonial", "settings": { "quote": "Highlight specific details about texture, scent, or packaging that your community enjoys.", "author_name": "Customer Name", "author_detail": "Verified Purchase" } },
        { "type": "testimonial", "settings": { "quote": "Let your customers speak for the quality and reliability of your brand and customer support.", "author_name": "Customer Name", "author_detail": "Repeat Customer" } }
      ]
    }
  ]
}
{% endschema %}
