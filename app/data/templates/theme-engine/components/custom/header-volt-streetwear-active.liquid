{%- style -%}
#shopify-section-{{ section.id }}{--hdr-bg:#0a0a0a;--hdr-text:#ffffff;--hdr-accent:#facc15;background:var(--hdr-bg);border-bottom:1px solid rgba(0,0,0,.06);position:sticky;top:0;z-index:40;backdrop-filter:blur(8px)}
.hdr-volt-streetwear-active{max-width:1280px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.hdr-volt-streetwear-active__logo{font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--hdr-text);font-size:16px;text-decoration:none}
.hdr-volt-streetwear-active__nav{display:flex;gap:18px}
.hdr-volt-streetwear-active__nav a{font-size:13px;font-weight:600;color:var(--hdr-text);text-decoration:none;opacity:.8}
.hdr-volt-streetwear-active__nav a:hover{opacity:1;color:var(--hdr-accent)}
.hdr-volt-streetwear-active__cart{background:var(--hdr-accent);color:#111;padding:8px 14px;border-radius:999px;font-size:12px;font-weight:700;text-decoration:none}
@media(max-width:768px){.hdr-volt-streetwear-active__nav{display:none}}
{%- endstyle -%}
<header class="hdr-volt-streetwear-active"><a href="/" class="hdr-volt-streetwear-active__logo">STREETWEAR • VOLT-STREETWEAR-ACTIVE</a><nav class="hdr-volt-streetwear-active__nav"><a href="/collections/all">Shop</a><a href="/collections/all">New</a><a href="/pages/about">Story</a><a href="/pages/contact">Contact</a></nav><div><a href="{{ routes.cart_url }}" class="hdr-volt-streetwear-active__cart">Cart {{'{{ cart.item_count }}'}}</a></div></header>
{% schema %}{"name":"Header volt-streetwear-active","settings":[],"presets":[{"name":"Header volt-streetwear-active"}]}{% endschema %}