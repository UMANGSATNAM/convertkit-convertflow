{%- liquid
  assign bg_color = section.settings.bg_color | default: '#FAF6F0'
  assign text_color = section.settings.text_color | default: '#1C1917'
  assign accent_color = section.settings.accent_color | default: '#D97706'
  assign button_bg = section.settings.button_bg | default: '#1C1917'
  assign button_text = section.settings.button_text | default: '#FFFFFF'
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">

<section class="hp1-fresh-hero" style="--bg: {{ bg_color }}; --text: {{ text_color }}; --accent: {{ accent_color }}; --btn-bg: {{ button_bg }}; --btn-text: {{ button_text }};">
  <div class="hp1-fresh-hero__container">
    <div class="hp1-fresh-hero__grid">
      
      <!-- Content Column -->
      <div class="hp1-fresh-hero__content">
        <!-- Trust Badge -->
        <div class="hp1-fresh-hero__trust-pill">
          <div class="hp1-fresh-hero__stars">
            ★★★★★
          </div>
          <span class="hp1-fresh-hero__trust-text"><strong>4.9/5</strong> rated by 14,200+ clean beauty lovers</span>
        </div>

        <!-- Heading -->
        <h1 class="hp1-fresh-hero__title">
          {{ section.settings.heading | default: 'Science-Backed Botanical Skincare for Radiant Glow.' }}
        </h1>

        <!-- Subheading -->
        <p class="hp1-fresh-hero__subtitle">
          {{ section.settings.subtitle | default: 'Formulated with cold-pressed botanical extracts and clinical bio-actives to restore your skin barrier in 14 days.' }}
        </p>

        <!-- Live Social Proof Notification -->
        <div class="hp1-fresh-hero__live-proof">
          <span class="hp1-fresh-hero__pulse-dot"></span>
          <span><strong>42 people</strong> bought the Glow Serum in the last hour</span>
        </div>

        <!-- CTA Buttons Group -->
        <div class="hp1-fresh-hero__cta-group">
          <a href="{{ section.settings.primary_btn_link | default: '#' }}" class="hp1-fresh-hero__btn hp1-fresh-hero__btn--primary">
            <span>{{ section.settings.primary_btn_label | default: 'Shop Best-Sellers — $38' }}</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href="{{ section.settings.secondary_btn_link | default: '#' }}" class="hp1-fresh-hero__btn hp1-fresh-hero__btn--secondary">
            <span>{{ section.settings.secondary_btn_label | default: 'Take 60s Skin Quiz' }}</span>
          </a>
        </div>

        <!-- Key Benefits Chips -->
        <div class="hp1-fresh-hero__chips">
          <div class="hp1-fresh-hero__chip">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span>Dermatologist Approved</span>
          </div>
          <div class="hp1-fresh-hero__chip">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span>100% Cruelty-Free & Vegan</span>
          </div>
          <div class="hp1-fresh-hero__chip">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span>30-Day Guarantee</span>
          </div>
        </div>

      </div>

      <!-- Visual Media Column -->
      <div class="hp1-fresh-hero__media-col">
        <div class="hp1-fresh-hero__media-card">
          <img src="{{ section.settings.hero_image | image_url: width: 1200 | default: 'https://images.unsplash.com/photo-1556228720-195a672e8a03?q=80&w=1200&auto=format&fit=crop' }}" 
               alt="Botanical Serum" 
               class="hp1-fresh-hero__image"
               loading="eager">
          
          <!-- Glassmorphism Floating Badge -->
          <div class="hp1-fresh-hero__float-badge">
            <div class="hp1-fresh-hero__badge-icon">✨</div>
            <div class="hp1-fresh-hero__badge-text">
              <strong>Award Winner 2026</strong>
              <span>Best Natural Hydration Serum</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hp1-fresh-hero {
    background-color: var(--bg);
    color: var(--text);
    font-family: 'Plus Jakarta Sans', sans-serif;
    padding: 80px 24px;
    overflow: hidden;
    position: relative;
  }
  .hp1-fresh-hero__container {
    max-width: 1280px;
    margin: 0 auto;
  }
  .hp1-fresh-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  @media (max-width: 991px) {
    .hp1-fresh-hero { padding: 48px 16px; }
    .hp1-fresh-hero__grid { grid-template-columns: 1fr; gap: 40px; }
  }

  .hp1-fresh-hero__trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(28, 25, 23, 0.1);
    padding: 8px 16px;
    border-radius: 100px;
    font-size: 13px;
    margin-bottom: 24px;
  }
  .hp1-fresh-hero__stars {
    color: #F59E0B;
    letter-spacing: 2px;
    font-size: 14px;
  }

  .hp1-fresh-hero__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 4.5vw, 56px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 20px 0;
    color: var(--text);
  }

  .hp1-fresh-hero__subtitle {
    font-size: 18px;
    line-height: 1.6;
    color: rgba(28, 25, 23, 0.8);
    margin: 0 0 28px 0;
    max-width: 540px;
  }

  .hp1-fresh-hero__live-proof {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: #047857;
    background: #ECFDF5;
    border: 1px solid #A7F3D0;
    padding: 8px 14px;
    border-radius: 8px;
    width: fit-content;
    margin-bottom: 32px;
  }
  .hp1-fresh-hero__pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #10B981;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: hp1Pulse 1.8s infinite;
  }

  @keyframes hp1Pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  .hp1-fresh-hero__cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 36px;
  }
  .hp1-fresh-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 32px;
    border-radius: 100px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
    cursor: pointer;
  }
  .hp1-fresh-hero__btn--primary {
    background-color: var(--btn-bg);
    color: var(--btn-text);
    box-shadow: 0 10px 25px -5px rgba(28, 25, 23, 0.2);
  }
  .hp1-fresh-hero__btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px -5px rgba(28, 25, 23, 0.3);
    background-color: #322D29;
  }
  .hp1-fresh-hero__btn--secondary {
    background-color: transparent;
    color: var(--text);
    border: 1.5px solid rgba(28, 25, 23, 0.25);
  }
  .hp1-fresh-hero__btn--secondary:hover {
    background-color: rgba(28, 25, 23, 0.05);
    border-color: var(--text);
  }

  .hp1-fresh-hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .hp1-fresh-hero__chip {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: rgba(28, 25, 23, 0.75);
    font-weight: 500;
  }
  .hp1-fresh-hero__chip svg { color: var(--accent); }

  .hp1-fresh-hero__media-col {
    position: relative;
  }
  .hp1-fresh-hero__media-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
    aspect-ratio: 4 / 5;
  }
  .hp1-fresh-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hp1-fresh-hero__media-card:hover .hp1-fresh-hero__image {
    transform: scale(1.04);
  }

  .hp1-fresh-hero__float-badge {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 16px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }
  .hp1-fresh-hero__badge-icon {
    font-size: 24px;
    background: #FEF3C7;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hp1-fresh-hero__badge-text strong {
    display: block;
    font-size: 14px;
    color: var(--text);
  }
  .hp1-fresh-hero__badge-text span {
    font-size: 12px;
    color: rgba(28, 25, 23, 0.65);
  }
</style>

{% schema %}
{
  "name": "HP1 Fresh - Hero D2C",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Science-Backed Botanical Skincare for Radiant Glow." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Formulated with cold-pressed botanical extracts and clinical bio-actives to restore your skin barrier in 14 days." },
    { "type": "text", "id": "primary_btn_label", "label": "Primary Button Label", "default": "Shop Best-Sellers — $38" },
    { "type": "url", "id": "primary_btn_link", "label": "Primary Button Link" },
    { "type": "text", "id": "secondary_btn_label", "label": "Secondary Button Label", "default": "Take 60s Skin Quiz" },
    { "type": "url", "id": "secondary_btn_link", "label": "Secondary Button Link" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero Image" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF6F0" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1C1917" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#D97706" },
    { "type": "color", "id": "button_bg", "label": "Button Background", "default": "#1C1917" },
    { "type": "color", "id": "button_text", "label": "Button Text Color", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "HP1 Fresh - Hero D2C" }
  ]
}
{% endschema %}
