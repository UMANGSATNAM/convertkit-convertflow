{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#2D3748'
  assign accent_color = section.settings.accent_color | default: '#4A5568'
  assign padding_top = section.settings.padding_top | default: 120
  assign padding_bottom = section.settings.padding_bottom | default: 120
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 60
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 60
  assign text_alignment = section.settings.text_alignment | default: 'center'
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --accent-color: {{ accent_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    overflow: hidden;
  }

  .hpv6-testimonials-{{ section_id }} {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 0 5vw;
    text-align: {{ text_alignment }};
  }

  .hpv6-testimonials__header {
    margin-bottom: 4rem;
  }

  .hpv6-testimonials__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent-color);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .hpv6-testimonials__title {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    line-height: 1.2;
    margin: 0;
  }

  .hpv6-testimonials__slider {
    position: relative;
    max-width: 900px;
    margin: 0 {% if text_alignment == 'center' %}auto{% else %}0{% endif %};
  }

  .hpv6-testimonials__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE and Edge */
    gap: 2rem;
    scroll-behavior: smooth;
    padding-bottom: 2rem; /* space for dots if needed */
  }

  .hpv6-testimonials__track::-webkit-scrollbar {
    display: none;
  }

  .hpv6-testimonials__slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0.5;
    transition: opacity 0.4s ease;
  }

  .hpv6-testimonials__slide.is-active {
    opacity: 1;
  }

  .hpv6-testimonials__stars {
    display: flex;
    gap: 4px;
    justify-content: {% if text_alignment == 'center' %}center{% elsif text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
    margin-bottom: 2rem;
    color: var(--accent-color);
  }

  .hpv6-testimonials__stars svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .hpv6-testimonials__quote {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: clamp(1.5rem, 3.5vw, 2.75rem);
    line-height: 1.4;
    font-weight: 400;
    margin-bottom: 2.5rem;
    font-style: italic;
  }

  .hpv6-testimonials__author-wrap {
    display: flex;
    align-items: center;
    justify-content: {% if text_alignment == 'center' %}center{% elsif text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
    gap: 16px;
  }

  .hpv6-testimonials__avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
  }

  .hpv6-testimonials__author-info {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .hpv6-testimonials__author {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .hpv6-testimonials__role {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    opacity: 0.7;
    margin-top: 4px;
  }

  /* Controls */
  .hpv6-testimonials__controls {
    display: flex;
    justify-content: {% if text_alignment == 'center' %}center{% elsif text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hpv6-testimonials__btn {
    background: transparent;
    border: 1px solid var(--text-color);
    color: var(--text-color);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hpv6-testimonials__btn:hover {
    background: var(--text-color);
    color: var(--bg-color);
  }

  .hpv6-testimonials__btn svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }
    
    .hpv6-testimonials__header {
      margin-bottom: 2.5rem;
    }
    
    .hpv6-testimonials__quote {
      font-size: clamp(1.25rem, 5vw, 1.75rem);
    }
    
    .hpv6-testimonials__avatar {
      width: 48px;
      height: 48px;
    }
    
    .hpv6-testimonials__btn {
      width: 40px;
      height: 40px;
    }
  }
</style>

<div class="hpv6-testimonials-{{ section_id }}">
  
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="hpv6-testimonials__header">
      {%- if section.settings.subtitle != blank -%}
        <div class="hpv6-testimonials__subtitle">{{ section.settings.subtitle | escape }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="hpv6-testimonials__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="hpv6-testimonials__slider" id="TestimonialSlider-{{ section_id }}">
    <div class="hpv6-testimonials__track" role="region" aria-label="Testimonials" tabindex="0">
      {%- for block in section.blocks -%}
        <div class="hpv6-testimonials__slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }} data-index="{{ forloop.index0 }}">
          
          {%- if block.settings.show_stars -%}
            <div class="hpv6-testimonials__stars" aria-label="{{ block.settings.star_rating }} out of 5 stars">
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.star_rating -%}
                  <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          <blockquote class="hpv6-testimonials__quote">
            "{{ block.settings.quote }}"
          </blockquote>

          <div class="hpv6-testimonials__author-wrap">
            {%- if block.settings.author_image != blank -%}
              {{ block.settings.author_image | image_url: width: 120 | image_tag: 
                 loading: 'lazy',
                 class: 'hpv6-testimonials__avatar',
                 alt: block.settings.author | escape
              }}
            {%- endif -%}
            <div class="hpv6-testimonials__author-info">
              <span class="hpv6-testimonials__author">{{ block.settings.author | escape }}</span>
              {%- if block.settings.role != blank -%}
                <span class="hpv6-testimonials__role">{{ block.settings.role | escape }}</span>
              {%- endif -%}
            </div>
          </div>

        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="hpv6-testimonials__controls">
        <button type="button" class="hpv6-testimonials__btn js-prev" aria-label="Previous testimonial">
          <svg viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="hpv6-testimonials__btn js-next" aria-label="Next testimonial">
          <svg viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.blocks.size > 1 -%}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.getElementById('TestimonialSlider-{{ section_id }}');
    if (!slider) return;

    const track = slider.querySelector('.hpv6-testimonials__track');
    const slides = slider.querySelectorAll('.hpv6-testimonials__slide');
    const prevBtn = slider.querySelector('.js-prev');
    const nextBtn = slider.querySelector('.js-next');
    
    let currentIndex = 0;
    
    const updateActiveSlide = () => {
      slides.forEach((slide, index) => {
        if (index === currentIndex) {
          slide.classList.add('is-active');
        } else {
          slide.classList.remove('is-active');
        }
      });
    };

    const scrollToCurrent = () => {
      const slideWidth = slides[0].offsetWidth;
      track.scrollTo({
        left: currentIndex * (slideWidth + 32), // 32 is the gap (2rem)
        behavior: 'smooth'
      });
      updateActiveSlide();
    };

    nextBtn.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % slides.length;
      scrollToCurrent();
    });

    prevBtn.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + slides.length) % slides.length;
      scrollToCurrent();
    });

    // Handle manual scroll updating active state
    let scrollTimeout;
    track.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        const slideWidth = slides[0].offsetWidth;
        const scrollLeft = track.scrollLeft;
        currentIndex = Math.round(scrollLeft / slideWidth);
        updateActiveSlide();
      }, 100);
    });
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "HPV6 Testimonial Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What Our Clients Say"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Stars/Subtitle)",
      "default": "#4A5568"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_stars",
          "label": "Show Star Rating",
          "default": true
        },
        {
          "type": "range",
          "id": "star_rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The quality and aesthetic have completely transformed my living space. Pure elegance."
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author Image",
          "info": "Square image recommended"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "M. Anderson"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Author Role / Location",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HPV6 Testimonial Slider",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
