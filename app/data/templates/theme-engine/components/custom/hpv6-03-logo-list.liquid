{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#F7FAFC'
  assign text_color = section.settings.text_color | default: '#2D3748'
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign columns_mobile = section.settings.columns_mobile | default: 2
  assign use_grayscale = section.settings.use_grayscale
  assign enable_slider_mobile = section.settings.enable_slider_mobile
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    --cols-desktop: {{ columns_desktop }};
    --cols-mobile: {{ columns_mobile }};
    
    background-color: var(--bg-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .hpv6-logos-{{ section_id }} {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 4vw;
    text-align: center;
  }

  .hpv6-logos__title {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--text-color);
    margin: 0 0 3rem 0;
    opacity: 0.7;
    font-weight: 500;
  }

  .hpv6-logos__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols-desktop), 1fr);
    gap: 3rem;
    align-items: center;
    justify-content: center;
  }

  .hpv6-logo-item {
    display: flex;
    justify-content: center;
    align-items: center;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  {% if use_grayscale %}
  .hpv6-logo-item img, .hpv6-logo-item svg {
    filter: grayscale(100%) contrast(120%);
    opacity: 0.5;
    transition: all 0.3s ease;
  }
  .hpv6-logo-item:hover img, .hpv6-logo-item:hover svg {
    filter: grayscale(0%) contrast(100%);
    opacity: 1;
    transform: scale(1.05);
  }
  {% else %}
  .hpv6-logo-item:hover {
    opacity: 0.8;
    transform: scale(1.05);
  }
  {% endif %}

  .hpv6-logo-item img, .hpv6-logo-item svg {
    max-width: 100%;
    height: auto;
    max-height: 50px;
    object-fit: contain;
  }

  .hpv6-logo-item a {
    display: block;
    width: 100%;
    text-decoration: none;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }
    .hpv6-logos__title {
      font-size: 11px;
      margin-bottom: 2rem;
    }

    {% if enable_slider_mobile %}
      .hpv6-logos__grid {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none;  /* IE and Edge */
        padding-bottom: 1rem;
        gap: 2rem;
      }
      .hpv6-logos__grid::-webkit-scrollbar {
        display: none;
      }
      .hpv6-logo-item {
        flex: 0 0 calc((100% / var(--cols-mobile)) - 1rem);
        scroll-snap-align: center;
      }
    {% else %}
      .hpv6-logos__grid {
        grid-template-columns: repeat(var(--cols-mobile), 1fr);
        gap: 2rem;
      }
    {% endif %}
    
    .hpv6-logo-item img, .hpv6-logo-item svg {
      max-height: 40px;
    }
  }
</style>

<div class="hpv6-logos-{{ section_id }}">
  {%- if section.settings.title != blank -%}
    <h2 class="hpv6-logos__title">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  <div class="hpv6-logos__grid" role="list">
    {%- for block in section.blocks -%}
      <div class="hpv6-logo-item" role="listitem" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" target="_blank" rel="noopener" aria-label="Visit partner site">
        {%- endif -%}
        
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 300 | image_tag: 
             loading: 'lazy',
             alt: block.settings.image.alt | default: 'Partner Logo',
             sizes: '(min-width: 768px) 200px, 120px'
          }}
        {%- else -%}
          {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}

        {%- if block.settings.link != blank -%}
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HPV6 Logo List",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "As Seen In"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "use_grayscale",
      "label": "Use Grayscale Filter",
      "default": true,
      "info": "Applies a black/white filter to logos, revealing color on hover."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F7FAFC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D3748"
    },
    {
      "type": "header",
      "content": "Desktop Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 8,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Mobile Layout"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on Mobile",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "enable_slider_mobile",
      "label": "Enable horizontal swipe on mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Transparent PNG recommended."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HPV6 Logo List",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
