{% comment %}
  FB04 Newsletter — Email subscribe with centered layout
{% endcomment %}

<style>
  .fb04-newsletter {
    padding: 100px 60px;
    background: #fff;
  }
  .fb04-newsletter__inner {
    max-width: 520px;
    margin: 0 auto;
    text-align: center;
  }
  .fb04-newsletter__heading {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 700;
    font-size: 32px;
    color: #282A2F;
    margin-bottom: 12px;
  }
  .fb04-newsletter__desc {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 400;
    font-size: 15px;
    color: #7B818E;
    line-height: 1.6;
    margin-bottom: 32px;
  }
  .fb04-newsletter__form {
    display: flex;
    gap: 12px;
    margin-bottom: 12px;
  }
  .fb04-newsletter__input {
    flex: 1;
    font-family: 'Host Grotesk', sans-serif;
    font-size: 14px;
    padding: 14px 20px;
    border: 1px solid #DBDDE0;
    border-radius: 8px;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    color: #282A2F;
    background: #fff;
  }
  .fb04-newsletter__input::placeholder {
    color: #7B818E;
  }
  .fb04-newsletter__input:focus {
    border-color: #0066FF;
    box-shadow: 0 0 0 3px rgba(0,102,255,0.1);
  }
  .fb04-newsletter__btn {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 14px 28px;
    background: #0066FF;
    color: #fff;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s ease;
    white-space: nowrap;
  }
  .fb04-newsletter__btn:hover {
    background: #2E82FF;
  }
  .fb04-newsletter__disclaimer {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 400;
    font-size: 12px;
    color: #7B818E;
  }

  @media (max-width: 809px) {
    .fb04-newsletter {
      padding: 60px 24px;
    }
    .fb04-newsletter__heading {
      font-size: 26px;
    }
    .fb04-newsletter__form {
      flex-direction: column;
    }
  }
  @media (min-width: 810px) and (max-width: 1199px) {
    .fb04-newsletter {
      padding: 80px 40px;
    }
  }
</style>

<section class="fb04-newsletter">
  <div class="fb04-newsletter__inner">
    <h2 class="fb04-newsletter__heading">{{ section.settings.heading | default: 'Subscribe to our newsletter now!' }}</h2>
    <p class="fb04-newsletter__desc">{{ section.settings.description | default: 'Get top Framer components, exclusive freebies, and expert tips delivered to your inbox weekly.' }}</p>

    <form class="fb04-newsletter__form" action="#" method="post">
      <input type="email"
             class="fb04-newsletter__input"
             placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}"
             required
             aria-label="Email address">
      <button type="submit" class="fb04-newsletter__btn">
        {{ section.settings.button_text | default: 'Subscribe' }}
      </button>
    </form>

    <p class="fb04-newsletter__disclaimer">{{ section.settings.disclaimer | default: 'Weekly newsletter. Unsubscribe anytime.' }}</p>
  </div>
</section>

{% schema %}
{
  "name": "FB04 Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Subscribe to our newsletter now!" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Get top Framer components, exclusive freebies, and expert tips delivered to your inbox weekly." },
    { "type": "text", "id": "placeholder", "label": "Input Placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Subscribe" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Weekly newsletter. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "FB04 Newsletter" }]
}
{% endschema %}
