{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#F4F4F0'
  assign padding_top = section.settings.padding_top | default: 120
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --padding-top: {{ padding_top }}px;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    border-top: 2px solid var(--text-color);
    position: relative;
    overflow: hidden;
  }

  /* Massive background watermark */
  .hp7-footer__watermark {
    position: absolute;
    bottom: -10%;
    right: -5%;
    font-family: 'Playfair Display', serif;
    font-size: clamp(20rem, 40vw, 40rem);
    font-weight: 700;
    color: var(--text-color);
    opacity: 0.03;
    line-height: 0.8;
    pointer-events: none;
    z-index: 1;
    text-transform: uppercase;
  }

  .hp7-footer-{{ section_id }} {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 4vw;
    position: relative;
    z-index: 2;
  }

  .hp7-footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 4vw;
    margin-bottom: 6rem;
  }
  
  .hp7-footer__col-title {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 2rem;
    color: var(--text-color);
    opacity: 0.5;
  }

  .hp7-footer__brand-text {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.2;
    max-width: 600px;
    margin: 0 0 2rem 0;
  }
  
  .hp7-footer__brand-text em {
    font-style: italic;
  }

  .hp7-footer__menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .hp7-footer__menu-item {
    margin-bottom: 1rem;
  }
  
  .hp7-footer__menu-link {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-color);
    text-decoration: none;
    transition: opacity 0.3s;
    display: inline-block;
  }
  
  .hp7-footer__menu-link:hover {
    opacity: 0.5;
  }

  .hp7-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: 'Inter', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  
  .hp7-footer__bottom-links {
    display: flex;
    gap: 2rem;
  }
  
  .hp7-footer__bottom-links a {
    color: inherit;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.3s;
  }
  
  .hp7-footer__bottom-links a:hover {
    opacity: 1;
  }

  .hp7-footer__payment {
    display: flex;
    gap: 0.5rem;
  }
  
  .hp7-footer__payment svg {
    height: 20px;
    width: auto;
  }

  @media screen and (max-width: 990px) {
    .hp7-footer__grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
    
    .hp7-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }
    
    .hp7-footer__bottom-links {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>

<div class="hp7-footer__watermark" aria-hidden="true">
  {{ section.settings.watermark | default: 'AVNT' }}
</div>

<footer class="hp7-footer-{{ section_id }}">
  
  <div class="hp7-footer__grid">
    <div class="hp7-footer__col hp7-footer__col--brand">
      <h3 class="hp7-footer__col-title">MANIFESTO</h3>
      <div class="hp7-footer__brand-text">
        {{ section.settings.brand_text | default: 'REJECTING THE SUPERFLUOUS.<br><em>EMBRACING THE STRUCTURAL.</em>' }}
      </div>
    </div>
    
    {%- for block in section.blocks -%}
      {%- if block.type == 'menu' -%}
        <div class="hp7-footer__col" {{ block.shopify_attributes }}>
          <h3 class="hp7-footer__col-title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.menu != blank -%}
            <ul class="hp7-footer__menu">
              {%- for link in linklists[block.settings.menu].links -%}
                <li class="hp7-footer__menu-item">
                  <a href="{{ link.url }}" class="hp7-footer__menu-link">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <ul class="hp7-footer__menu">
              <li class="hp7-footer__menu-item"><a href="#" class="hp7-footer__menu-link">SHOP COLLECTION</a></li>
              <li class="hp7-footer__menu-item"><a href="#" class="hp7-footer__menu-link">ARCHIVE</a></li>
              <li class="hp7-footer__menu-item"><a href="#" class="hp7-footer__menu-link">JOURNAL</a></li>
              <li class="hp7-footer__menu-item"><a href="#" class="hp7-footer__menu-link">ATELIER</a></li>
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="hp7-footer__bottom">
    <div class="hp7-footer__copyright">
      &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. ALL RIGHTS RESERVED.
    </div>
    
    <div class="hp7-footer__bottom-links">
      <a href="/policies/privacy-policy">PRIVACY PROTOCOL</a>
      <a href="/policies/terms-of-service">TERMS OF SERVICE</a>
    </div>

    {%- if section.settings.show_payment -%}
      <div class="hp7-footer__payment">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

</footer>

{% schema %}
{
  "name": "HP7 Brutalist Footer",
  "tag": "section",
  "class": "section",
  "max_blocks": 2,
  "settings": [
    {
      "type": "header",
      "content": "Aesthetic: Editorial Brutalism"
    },
    {
      "type": "html",
      "id": "brand_text",
      "label": "Brand Manifesto",
      "default": "REJECTING THE SUPERFLUOUS.<br><em>EMBRACING THE STRUCTURAL.</em>"
    },
    {
      "type": "text",
      "id": "watermark",
      "label": "Background Watermark Text",
      "default": "AVNT"
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F4F4F0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "NAVIGATION"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP7 Brutalist Footer",
      "blocks": [
        { "type": "menu", "settings": { "title": "COLLECTIONS" } },
        { "type": "menu", "settings": { "title": "SUPPORT" } }
      ]
    }
  ]
}
{% endschema %}
