{% comment %}
  FB04 CTA Banner — Dark full-width call-to-action
{% endcomment %}

<style>
  .fb04-cta-banner {
    padding: 100px 60px;
    background: #282A2F;
  }
  .fb04-cta-banner__inner {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }
  .fb04-cta-banner__heading {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 700;
    font-size: 48px;
    color: #fff;
    line-height: 1.1;
    margin-bottom: 16px;
  }
  .fb04-cta-banner__body {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 400;
    font-size: 16px;
    color: #7B818E;
    line-height: 1.7;
    margin-bottom: 36px;
  }
  .fb04-cta-banner__btn {
    display: inline-block;
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 600;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 16px 40px;
    background: #0066FF;
    color: #fff;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .fb04-cta-banner__btn:hover {
    background: #2E82FF;
    transform: translateY(-2px);
  }

  @media (max-width: 809px) {
    .fb04-cta-banner {
      padding: 60px 24px;
    }
    .fb04-cta-banner__heading {
      font-size: 32px;
    }
  }
  @media (min-width: 810px) and (max-width: 1199px) {
    .fb04-cta-banner {
      padding: 80px 40px;
    }
    .fb04-cta-banner__heading {
      font-size: 40px;
    }
  }
</style>

<section class="fb04-cta-banner">
  <div class="fb04-cta-banner__inner">
    <h2 class="fb04-cta-banner__heading">{{ section.settings.heading | default: 'Join the Movement. Wear the Future.' }}</h2>
    <p class="fb04-cta-banner__body">{{ section.settings.body | default: "Streetwear designed for those who break the mold. Limited drops, bold designs, and premium quality—don't miss out." }}</p>
    <a href="{{ section.settings.cta_link | default: '#' }}" class="fb04-cta-banner__btn">
      {{ section.settings.cta_text | default: 'Shop now' }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "FB04 CTA Banner",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Movement. Wear the Future." },
    { "type": "textarea", "id": "body", "label": "Body Text", "default": "Streetwear designed for those who break the mold. Limited drops, bold designs, and premium quality—don't miss out." },
    { "type": "text", "id": "cta_text", "label": "CTA Text", "default": "Shop now" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" }
  ],
  "presets": [{ "name": "FB04 CTA Banner" }]
}
{% endschema %}
