<style>
  #shopify-section-{{ section.id }} .sf-reset {
    background: var(--color-bg, #fff);
    color: var(--color-text, #1a1a1a);
    padding: var(--spacing-section-y, 80px) var(--spacing-section-x, 20px);
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .sf-reset__box {
    max-width: 440px;
    width: 100%;
    margin: 0 auto;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .sf-reset__title {
    font-family: var(--font-heading, inherit);
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 400;
    margin: 0 0 8px;
  }
  #shopify-section-{{ section.id }} .sf-reset__sub {
    color: var(--color-text-muted, #888);
    font-size: 0.95rem;
    margin: 0 0 32px;
  }
  #shopify-section-{{ section.id }} .sf-reset__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: left;
  }
  #shopify-section-{{ section.id }} .sf-reset__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  #shopify-section-{{ section.id }} .sf-reset__label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-text, #1a1a1a);
  }
  #shopify-section-{{ section.id }} .sf-reset__input {
    border: 1px solid var(--color-border, #e0e0e0);
    padding: 12px 14px;
    font-size: 0.95rem;
    background: transparent;
    color: var(--color-text, #1a1a1a);
    outline: none;
  }
  #shopify-section-{{ section.id }} .sf-reset__submit {
    border: none;
    background: var(--color-primary, #1a1a1a);
    color: var(--color-btn-text, #fff);
    padding: 14px;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s;
    margin-top: 8px;
  }
  #shopify-section-{{ section.id }} .sf-reset__submit:hover { opacity: 0.8; }
</style>

<section id="shopify-section-{{ section.id }}" class="sf-reset" data-section-id="{{ section.id }}" data-section-type="main-reset-password">
  <div class="sf-reset__box">
    <h1 class="sf-reset__title">{{ 'customer.reset_password.title' | t: default: 'Reset Account Password' }}</h1>
    <p class="sf-reset__sub">{{ 'customer.reset_password.subtext' | t: default: 'Enter a new password for your account.' }}</p>

    {% form 'reset_customer_password', class: 'sf-reset__form' %}
      {%- if form.errors -%}
        <div style="color:#e44;font-size:0.85rem;margin-bottom:8px;">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="sf-reset__field">
        <label class="sf-reset__label" for="password">{{ 'customer.reset_password.password' | t: default: 'Password' }}</label>
        <input type="password" name="customer[password]" id="password" class="sf-reset__input" autocomplete="new-password" required>
      </div>

      <div class="sf-reset__field">
        <label class="sf-reset__label" for="password_confirmation">{{ 'customer.reset_password.password_confirm' | t: default: 'Confirm Password' }}</label>
        <input type="password" name="customer[password_confirmation]" id="password_confirmation" class="sf-reset__input" autocomplete="new-password" required>
      </div>

      <button type="submit" class="sf-reset__submit">{{ 'customer.reset_password.submit' | t: default: 'Reset Password' }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Reset Password Main",
  "tag": "section",
  "class": "section-main-reset-password",
  "settings": [],
  "presets": [
    {
      "name": "Reset Password Main"
    }
  ]
}
{% endschema %}
