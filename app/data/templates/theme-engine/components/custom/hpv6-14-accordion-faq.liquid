{%- liquid
  assign section_id = section.id
  assign layout = section.settings.layout | default: 'centered'
  
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#2D3748'
  assign border_color = section.settings.border_color | default: 'rgba(45, 55, 72, 0.1)'
  assign icon_color = section.settings.icon_color | default: '#2D3748'
  
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --border-color: {{ border_color }};
    --icon-color: {{ icon_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .hpv6-faq-{{ section_id }} {
    max-width: var(--page-width, 1000px);
    margin: 0 auto;
    padding: 0 5vw;
    {%- if layout == 'split' -%}
      max-width: var(--page-width, 1440px);
      display: flex;
      flex-wrap: wrap;
      gap: 4rem;
    {%- endif -%}
  }

  .hpv6-faq__header {
    margin-bottom: 4rem;
    {%- if layout == 'centered' -%}
      text-align: center;
    {%- elsif layout == 'split' -%}
      flex: 1 1 35%;
      margin-bottom: 0;
    {%- endif -%}
  }

  .hpv6-faq__title {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 400;
    margin: 0;
    line-height: 1.2;
  }

  .hpv6-faq__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-top: 1rem;
    opacity: 0.7;
  }

  .hpv6-faq__accordion-wrap {
    {%- if layout == 'split' -%}
      flex: 1 1 55%;
    {%- endif -%}
  }

  /* HTML5 Details/Summary Accordion */
  .hpv6-faq__details {
    border-bottom: 1px solid var(--border-color);
  }

  .hpv6-faq__details:first-child {
    border-top: 1px solid var(--border-color);
  }

  .hpv6-faq__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
    font-family: 'Inter', sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none; /* Hide default marker */
    outline: none;
    transition: opacity 0.3s ease;
  }

  .hpv6-faq__summary:hover,
  .hpv6-faq__summary:focus-visible {
    opacity: 0.7;
  }

  .hpv6-faq__summary::-webkit-details-marker {
    display: none; /* Hide Safari default marker */
  }

  .hpv6-faq__icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    margin-left: 16px;
    position: relative;
    color: var(--icon-color);
  }

  .hpv6-faq__icon::before,
  .hpv6-faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: currentColor;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .hpv6-faq__icon::before {
    width: 14px;
    height: 2px;
  }

  .hpv6-faq__icon::after {
    width: 2px;
    height: 14px;
  }

  .hpv6-faq__details[open] .hpv6-faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }

  .hpv6-faq__content {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.8;
    padding-bottom: 24px;
    padding-right: 40px; /* Leave space under icon */
  }

  .hpv6-faq__content p {
    margin: 0 0 1rem 0;
  }
  .hpv6-faq__content p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }

    .hpv6-faq-{{ section_id }} {
      {%- if layout == 'split' -%}
        flex-direction: column;
        gap: 2rem;
      {%- endif -%}
    }

    .hpv6-faq__header {
      margin-bottom: 2rem;
      text-align: left;
    }

    .hpv6-faq__summary {
      font-size: 1rem;
      padding: 20px 0;
    }

    .hpv6-faq__content {
      padding-bottom: 20px;
    }
  }
</style>

<div class="hpv6-faq-{{ section_id }}">
  
  <div class="hpv6-faq__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hpv6-faq__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <div class="hpv6-faq__subtitle">{{ section.settings.subtitle | escape }}</div>
    {%- endif -%}
  </div>

  <div class="hpv6-faq__accordion-wrap">
    {%- for block in section.blocks -%}
      {%- if block.settings.question != blank and block.settings.answer != blank -%}
        <details class="hpv6-faq__details" {{ block.shopify_attributes }}>
          <summary class="hpv6-faq__summary" aria-expanded="false">
            {{ block.settings.question | escape }}
            <span class="hpv6-faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="hpv6-faq__content">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>

</div>

<!-- FAQPage Structured Data for SEO -->
{%- if section.settings.enable_seo -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign faq_blocks = section.blocks | where: "type", "faq" -%}
        {%- for block in faq_blocks -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | strip_html | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | json }}
              }
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

<script>
  // Add simple JS to toggle aria-expanded for screen readers, though native <details> handles most accessibility itself.
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.hpv6-faq-{{ section_id }}');
    if (!section) return;

    const detailsEls = section.querySelectorAll('details');
    detailsEls.forEach(detail => {
      detail.addEventListener('toggle', (e) => {
        const summary = detail.querySelector('summary');
        if (summary) {
          summary.setAttribute('aria-expanded', detail.open);
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HPV6 Accordion FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everything you need to know"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Section Layout",
      "options": [
        { "value": "centered", "label": "Centered Content" },
        { "value": "split", "label": "Split (Title Left, FAQ Right)" }
      ],
      "default": "centered"
    },
    {
      "type": "header",
      "content": "SEO"
    },
    {
      "type": "checkbox",
      "id": "enable_seo",
      "label": "Enable FAQ Structured Data",
      "default": true,
      "info": "Injects JSON-LD FAQPage schema for Google Search enhancements."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon/Border Color",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "rgba(45, 55, 72, 0.1)"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We accept returns within 30 days of purchase. Items must be in original condition with tags attached.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HPV6 Accordion FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "Do you ship internationally?", "answer": "<p>Yes, we ship to over 100 countries worldwide. Shipping costs will apply, and will be added at checkout.</p>" } },
        { "type": "faq", "settings": { "question": "How long will it take to get my order?", "answer": "<p>It depends on where you are. Orders processed here will take 5-7 business days to arrive. Overseas deliveries can take anywhere from 7-16 days.</p>" } },
        { "type": "faq", "settings": { "question": "Can I return my product?", "answer": "<p>We always aim for make sure our customers love our products, but if you do need to return an order, we’re happy to help.</p>" } }
      ]
    }
  ]
}
{% endschema %}
