{%- liquid
  assign section_id = section.id
  assign blog = section.settings.blog
  assign post_limit = section.settings.post_limit | default: 3
  assign layout_desktop = section.settings.layout_desktop | default: 'grid'
  assign layout_mobile = section.settings.layout_mobile | default: 'slider'
  
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#2D3748'
  assign card_bg = section.settings.card_bg | default: '#F7FAFC'
  assign card_text = section.settings.card_text | default: '#2D3748'
  
  assign padding_top = section.settings.padding_top | default: 120
  assign padding_bottom = section.settings.padding_bottom | default: 120
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 60
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 60
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --card-bg: {{ card_bg }};
    --card-text: {{ card_text }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    --cols-desktop: {%- if post_limit == 2 -%}2{%- elsif post_limit == 4 -%}4{%- else -%}3{%- endif -%};
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .hpv6-blog-{{ section_id }} {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 0 5vw;
  }

  .hpv6-blog__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 4rem;
  }

  .hpv6-blog__header-left {
    max-width: 600px;
  }

  .hpv6-blog__title {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 400;
    margin: 0;
    line-height: 1.1;
  }

  .hpv6-blog__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 1rem;
    opacity: 0.7;
    font-weight: 500;
  }

  .hpv6-blog__view-all {
    display: inline-flex;
    align-items: center;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-color);
    text-decoration: none;
    position: relative;
    padding-bottom: 4px;
  }

  .hpv6-blog__view-all::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--text-color);
    transform: scaleX(1);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .hpv6-blog__view-all:hover::after {
    transform: scaleX(0);
    transform-origin: right;
  }

  /* Grid/Slider Layout */
  .hpv6-blog__grid {
    display: grid;
    gap: 3rem;
  }

  {%- if layout_desktop == 'grid' -%}
    .hpv6-blog__grid {
      grid-template-columns: repeat(var(--cols-desktop), 1fr);
    }
  {%- else -%}
    .hpv6-blog__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      gap: 2rem;
      padding-bottom: 2rem;
    }
    .hpv6-blog__grid::-webkit-scrollbar {
      display: none;
    }
  {%- endif -%}

  /* Card */
  .hpv6-blog-card {
    text-decoration: none;
    color: var(--card-text);
    display: flex;
    flex-direction: column;
    background-color: var(--card-bg);
    height: 100%;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    {%- if layout_desktop == 'slider' -%}
      flex: 0 0 calc(100% / var(--cols-desktop) - 2rem);
      scroll-snap-align: start;
    {%- endif -%}
  }

  .hpv6-blog-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.05);
  }

  .hpv6-blog-card__image-wrap {
    aspect-ratio: 3/2;
    background: #E2E8F0;
    overflow: hidden;
    position: relative;
  }

  .hpv6-blog-card__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .hpv6-blog-card:hover .hpv6-blog-card__image {
    transform: scale(1.05);
  }

  .hpv6-blog-card__content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  
  {%- if card_bg == 'transparent' or card_bg == 'rgba(0,0,0,0)' -%}
    .hpv6-blog-card__content {
      padding: 2rem 0 0 0;
    }
    .hpv6-blog-card:hover {
      box-shadow: none;
    }
  {%- endif -%}

  .hpv6-blog-card__meta {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.6;
    margin-bottom: 1rem;
    display: block;
  }

  .hpv6-blog-card__title {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: 1.75rem;
    margin: 0 0 1rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--card-text);
  }

  .hpv6-blog-card__excerpt {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.8;
    margin: 0 0 1.5rem 0;
    color: var(--card-text);
    flex-grow: 1;
  }

  .hpv6-blog-card__read-more {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    color: var(--card-text);
  }

  .hpv6-blog-card__read-more svg {
    width: 16px;
    height: 16px;
    margin-left: 8px;
    transition: transform 0.3s ease;
    fill: currentColor;
  }

  .hpv6-blog-card:hover .hpv6-blog-card__read-more svg {
    transform: translateX(4px);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }
    
    .hpv6-blog__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
      margin-bottom: 3rem;
    }

    {%- if layout_mobile == 'slider' -%}
      .hpv6-blog__grid {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        gap: 1.5rem;
        padding-bottom: 1rem;
      }
      .hpv6-blog__grid::-webkit-scrollbar {
        display: none;
      }
      .hpv6-blog-card {
        flex: 0 0 85%;
        scroll-snap-align: center;
      }
    {%- else -%}
      .hpv6-blog__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
      }
    {%- endif -%}
  }
</style>

<div class="hpv6-blog-{{ section_id }}">
  
  <div class="hpv6-blog__header">
    <div class="hpv6-blog__header-left">
      {%- if section.settings.subtitle != blank -%}
        <div class="hpv6-blog__subtitle">{{ section.settings.subtitle | escape }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="hpv6-blog__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.show_view_all and blog != blank -%}
      <a href="{{ blog.url }}" class="hpv6-blog__view-all" aria-label="View all posts from {{ blog.title | escape }}">
        {{ section.settings.view_all_label | default: 'View All' }}
      </a>
    {%- endif -%}
  </div>

  <div class="hpv6-blog__grid" role="list">
    {%- if blog != blank and blog.articles_count > 0 -%}
      {%- for article in blog.articles limit: post_limit -%}
        <article class="hpv6-blog-card-wrap" role="listitem">
          <a href="{{ article.url }}" class="hpv6-blog-card" aria-label="Read article: {{ article.title | escape }}">
            <div class="hpv6-blog-card__image-wrap">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: 
                   loading: 'lazy',
                   class: 'hpv6-blog-card__image',
                   alt: article.image.alt | default: article.title
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'hpv6-blog-card__image placeholder-svg' }}
              {%- endif -%}
            </div>
            
            <div class="hpv6-blog-card__content">
              {%- if section.settings.show_date or section.settings.show_author -%}
                <span class="hpv6-blog-card__meta">
                  {%- if section.settings.show_date -%}
                    {{ article.published_at | date: "%B %d, %Y" }}
                  {%- endif -%}
                  {%- if section.settings.show_date and section.settings.show_author -%} &bull; {%- endif -%}
                  {%- if section.settings.show_author -%}
                    {{ article.author }}
                  {%- endif -%}
                </span>
              {%- endif -%}

              <h3 class="hpv6-blog-card__title">{{ article.title }}</h3>
              
              {%- if section.settings.show_excerpt -%}
                <p class="hpv6-blog-card__excerpt">
                  {%- if article.excerpt.size > 0 -%}
                    {{ article.excerpt | strip_html | truncatewords: 25 }}
                  {%- else -%}
                    {{ article.content | strip_html | truncatewords: 25 }}
                  {%- endif -%}
                </p>
              {%- endif -%}

              <span class="hpv6-blog-card__read-more">
                Read More
                <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
              </span>
            </div>
          </a>
        </article>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..post_limit) -%}
        <article class="hpv6-blog-card-wrap" role="listitem">
          <div class="hpv6-blog-card">
            <div class="hpv6-blog-card__image-wrap">
              {{ 'lifestyle-' | append: i | placeholder_svg_tag: 'hpv6-blog-card__image placeholder-svg' }}
            </div>
            <div class="hpv6-blog-card__content">
              {%- if section.settings.show_date -%}
                <span class="hpv6-blog-card__meta">August {{ i | plus: 10 }}, 2026</span>
              {%- endif -%}
              <h3 class="hpv6-blog-card__title">The Art of Minimalist Living - Part {{ i }}</h3>
              {%- if section.settings.show_excerpt -%}
                <p class="hpv6-blog-card__excerpt">Discover how stripping away the excess can lead to a more fulfilling and intentional life with our latest guide to minimalism and design.</p>
              {%- endif -%}
              <span class="hpv6-blog-card__read-more">
                Read More
                <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
              </span>
            </div>
          </div>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HPV6 Blog Posts",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Latest Stories"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Number of Posts to Show",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Label",
      "default": "View All"
    },
    {
      "type": "header",
      "content": "Card Content"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show Excerpt",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_desktop",
      "label": "Desktop Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "slider", "label": "Horizontal Slider" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "Mobile Layout",
      "options": [
        { "value": "grid", "label": "Vertical Stack" },
        { "value": "slider", "label": "Horizontal Slider" }
      ],
      "default": "slider"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "transparent",
      "info": "Set to transparent to remove card box styling."
    },
    {
      "type": "color",
      "id": "card_text",
      "label": "Card Text Color",
      "default": "#2D3748"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "HPV6 Blog Posts",
      "settings": {
        "post_limit": 3
      }
    }
  ]
}
{% endschema %}
