{%- comment -%}
  Component: hero-1000cr-elite.liquid
  Family: 1000cr Elite D2C Standard
  Archetypes: premium, high-conversion, modern, d2c
  Description: Hyper-optimized hero section with trust signals, dual CTAs, media overlay, and responsive layout.
{%- endcomment -%}

{%- style -%}
  .hero-elite-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;
    {%- if section.settings.custom_bg != blank and section.settings.custom_bg != 'rgba(0,0,0,0)' -%}
      background-color: {{ section.settings.custom_bg }};
    {%- else -%}
      background-color: var(--color-bg, #ffffff);
    {%- endif -%}
    {%- if section.settings.custom_text != blank and section.settings.custom_text != 'rgba(0,0,0,0)' -%}
      color: {{ section.settings.custom_text }};
    {%- else -%}
      color: var(--color-text, #111827);
    {%- endif -%}
  }

  .hero-elite-container {
    max-width: var(--page-width, 1280px);
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  .hero-elite-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 990px) {
    .hero-elite-grid {
      grid-template-columns: {% if section.settings.media_position == 'left' %}1.1fr 1fr{% else %}1fr 1.1fr{% endif %};
      gap: 64px;
    }
  }

  /* Content Column */
  .hero-elite-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .hero-elite-content.text-center {
    align-items: center;
    text-align: center;
  }

  /* Badge Pill */
  .hero-elite-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: var(--radius-badge, 99px);
    background-color: rgba(var(--color-primary-rgb, 17, 24, 39), 0.06);
    border: 1px solid var(--color-border, rgba(0,0,0,0.08));
    font-family: var(--font-body, sans-serif);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .hero-elite-eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-sale, #dc2626);
    display: inline-block;
    animation: heroPulse 2s infinite ease-in-out;
  }

  @keyframes heroPulse {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.2); opacity: 1; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }

  /* Title Heading */
  .hero-elite-heading {
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 20px 0;
    color: inherit;
  }

  .hero-elite-heading span.highlight {
    color: var(--color-accent, #2563eb);
    background: linear-gradient(135deg, var(--color-accent, #2563eb) 0%, var(--color-primary, #111827) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Story / Subheading */
  .hero-elite-subheading {
    font-family: var(--font-body, sans-serif);
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.6;
    color: var(--color-text-muted, #4b5563);
    margin: 0 0 28px 0;
    max-width: 600px;
  }

  /* USPs List */
  .hero-elite-usps {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    margin-bottom: 32px;
    padding: 0;
    list-style: none;
  }

  .hero-elite-usp-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: inherit;
  }

  .hero-elite-usp-icon {
    width: 18px;
    height: 18px;
    color: var(--color-accent, #2563eb);
    flex-shrink: 0;
  }

  /* Action Buttons */
  .hero-elite-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    width: 100%;
    margin-bottom: 32px;
  }

  .hero-elite-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 36px;
    border-radius: var(--radius-button, 8px);
    background-color: var(--color-primary, #111827);
    color: var(--color-surface, #ffffff);
    font-family: var(--font-body, sans-serif);
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    box-shadow: 0 4px 14px rgba(0,0,0,0.12);
    min-height: 52px;
    text-align: center;
  }

  .hero-elite-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.18);
    opacity: 0.95;
  }

  .hero-elite-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 32px;
    border-radius: var(--radius-button, 8px);
    background-color: transparent;
    color: inherit;
    border: 1px solid var(--color-border, #e5e7eb);
    font-family: var(--font-body, sans-serif);
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
    min-height: 52px;
    text-align: center;
  }

  .hero-elite-btn-secondary:hover {
    background-color: rgba(0,0,0,0.04);
    border-color: var(--color-text, #111827);
  }

  /* Trust Rating Counter Bar */
  .hero-elite-trust {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border, #e5e7eb);
    width: 100%;
  }

  .hero-elite-rating-stars {
    display: flex;
    align-items: center;
    gap: 2px;
    color: var(--color-star, #f59e0b);
  }

  .hero-elite-trust-text {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-muted, #6b7280);
    line-height: 1.4;
  }

  .hero-elite-trust-text span {
    color: inherit;
    font-weight: 700;
  }

  /* Media Card Column */
  .hero-elite-media-wrapper {
    position: relative;
    width: 100%;
    border-radius: var(--radius-card, 16px);
    overflow: hidden;
    box-shadow: 0 20px 40px -15px rgba(0,0,0,0.12);
    border: 1px solid var(--color-border, rgba(0,0,0,0.06));
    background-color: var(--color-bg-secondary, #f9fafb);
    aspect-ratio: 4/3;
  }

  @media (min-width: 750px) {
    .hero-elite-media-wrapper {
      aspect-ratio: 16/11;
    }
  }

  .hero-elite-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .hero-elite-media-wrapper:hover .hero-elite-image {
    transform: scale(1.03);
  }

  .hero-elite-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
    color: #9ca3af;
  }

  /* Floating Badge Overlay */
  .hero-elite-float-badge {
    position: absolute;
    bottom: 24px;
    left: 24px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    padding: 14px 20px;
    border-radius: 12px;
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.15);
    border: 1px solid rgba(255,255,255,0.6);
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 260px;
    z-index: 2;
  }

  .hero-elite-float-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-accent, #2563eb);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .hero-elite-float-title {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    color: #111827;
  }

  .hero-elite-float-subtitle {
    font-size: 11px;
    color: #6b7280;
    margin-top: 2px;
  }

  @media (max-width: 749px) {
    .hero-elite-actions {
      flex-direction: column;
    }
    .hero-elite-btn-primary, .hero-elite-btn-secondary {
      width: 100%;
    }
    .hero-elite-float-badge {
      bottom: 12px;
      left: 12px;
      padding: 10px 14px;
    }
  }
{%- endstyle -%}

<section class="hero-elite-{{ section.id }} hero-elite-section" data-section-id="{{ section.id }}">
  <div class="hero-elite-container">
    <div class="hero-elite-grid">
      
      {% comment %} Content Column {% endcomment %}
      <div class="hero-elite-content {% if section.settings.content_alignment == 'center' %}text-center{% endif %}">
        
        {%- if section.settings.eyebrow_text != blank -%}
          <div class="hero-elite-eyebrow">
            <span class="hero-elite-eyebrow-dot"></span>
            {{ section.settings.eyebrow_text | escape }}
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="hero-elite-heading">
            {{ section.settings.heading }}
          </h1>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <div class="hero-elite-subheading">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}

        {%- if section.settings.show_usps -%}
          <ul class="hero-elite-usps">
            {%- if section.settings.usp_1 != blank -%}
              <li class="hero-elite-usp-item">
                <svg class="hero-elite-usp-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span>{{ section.settings.usp_1 | escape }}</span>
              </li>
            {%- endif -%}
            {%- if section.settings.usp_2 != blank -%}
              <li class="hero-elite-usp-item">
                <svg class="hero-elite-usp-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span>{{ section.settings.usp_2 | escape }}</span>
              </li>
            {%- endif -%}
            {%- if section.settings.usp_3 != blank -%}
              <li class="hero-elite-usp-item">
                <svg class="hero-elite-usp-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span>{{ section.settings.usp_3 | escape }}</span>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
          <div class="hero-elite-actions">
            {%- if section.settings.button_label_1 != blank -%}
              <a href="{{ section.settings.button_link_1 | default: '#' }}" class="hero-elite-btn-primary">
                {{ section.settings.button_label_1 | escape }}
              </a>
            {%- endif -%}
            {%- if section.settings.button_label_2 != blank -%}
              <a href="{{ section.settings.button_link_2 | default: '#' }}" class="hero-elite-btn-secondary">
                {{ section.settings.button_label_2 | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_trust -%}
          <div class="hero-elite-trust">
            <div class="hero-elite-rating-stars">
              {% for i in (1..5) %}
                <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              {% endfor %}
            </div>
            <div class="hero-elite-trust-text">
              <span>{{ section.settings.trust_rating_text | default: "4.9/5 Rating" }}</span> &bull; {{ section.settings.trust_count_text | default: "10,000+ Happy Customers" }}
            </div>
          </div>
        {%- endif -%}

      </div>

      {% comment %} Media Column {% endcomment %}
      <div class="hero-elite-media-col">
        <div class="hero-elite-media-wrapper">
          {%- if section.settings.image != blank -%}
            <img 
              src="{{ section.settings.image | image_url: width: 1200 }}" 
              alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              loading="eager"
              class="hero-elite-image"
            >
          {%- else -%}
            <div class="hero-elite-placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-elite-image' }}
            </div>
          {%- endif -%}

          {%- if section.settings.show_float_badge and section.settings.float_badge_title != blank -%}
            <div class="hero-elite-float-badge">
              <div class="hero-elite-float-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              </div>
              <div>
                <div class="hero-elite-float-title">{{ section.settings.float_badge_title | escape }}</div>
                {%- if section.settings.float_badge_subtitle != blank -%}
                  <div class="hero-elite-float-subtitle">{{ section.settings.float_badge_subtitle | escape }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "1000cr Elite Hero",
  "tag": "section",
  "class": "section-1000cr-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content & Typography"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Badge Text",
      "default": "🔥 #1 D2C Bestselling Brand"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Transform Your Daily Routine With <span class=\"highlight\">1000cr Quality</span>"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading / Story Text",
      "default": "<p>Engineered for maximum performance, purity, and aesthetic excellence. Trusted by over 50,000+ conscious customers worldwide.</p>"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Key USPs & Bullet Points"
    },
    {
      "type": "checkbox",
      "id": "show_usps",
      "label": "Show USPs List",
      "default": true
    },
    {
      "type": "text",
      "id": "usp_1",
      "label": "USP 1",
      "default": "100% Organic & Clinically Tested"
    },
    {
      "type": "text",
      "id": "usp_2",
      "label": "USP 2",
      "default": "Free Express Delivery Nationwide"
    },
    {
      "type": "text",
      "id": "usp_3",
      "label": "USP 3",
      "default": "30-Day Risk-Free Guarantee"
    },
    {
      "type": "header",
      "content": "Call to Actions (CTAs)"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary Button Label",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary Button Label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Social Proof & Trust"
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show Trust Rating Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_rating_text",
      "label": "Rating Text",
      "default": "4.9/5 Rating"
    },
    {
      "type": "text",
      "id": "trust_count_text",
      "label": "Reviews Count Text",
      "default": "10,000+ Verified Reviews"
    },
    {
      "type": "header",
      "content": "Media Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media Position (Desktop)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "show_float_badge",
      "label": "Show Floating Card Overlay",
      "default": true
    },
    {
      "type": "text",
      "id": "float_badge_title",
      "label": "Floating Card Title",
      "default": "Verified Quality"
    },
    {
      "type": "text",
      "id": "float_badge_subtitle",
      "label": "Floating Card Subtitle",
      "default": "Dermatologist Approved"
    },
    {
      "type": "header",
      "content": "Custom Styling & Spacing"
    },
    {
      "type": "color",
      "id": "custom_bg",
      "label": "Background Color Override",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "custom_text",
      "label": "Text Color Override",
      "default": "#111827"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "1000cr Elite Hero",
      "category": "Hero"
    }
  ]
