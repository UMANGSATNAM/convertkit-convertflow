{% comment %}
  Category Story Bubbles - Instagram / TikTok style circular category links
  Category: collection
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding: clamp(24px, 4vw, 48px) 20px;
    max-width: 1240px;
    margin: 0 auto;
    font-family: inherit;
  }

  .cf-stories-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 20px;
  }

  .cf-stories-heading {
    font-size: 20px;
    font-weight: 800;
    margin: 0;
    color: #0f172a;
  }

  .cf-stories-rail {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 32px);
    overflow-x: auto;
    padding-bottom: 12px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .cf-stories-rail::-webkit-scrollbar {
    display: none;
  }

  .cf-story-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    flex-shrink: 0;
    width: 84px;
    text-align: center;
  }

  .cf-story-ring {
    position: relative;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    padding: 2.5px;
    background: linear-gradient(135deg, #f59e0b 0%, #ec4899 50%, #8b5cf6 100%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cf-story-item:hover .cf-story-ring {
    transform: scale(1.08);
  }

  .cf-story-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    background: #ffffff;
    border: 2px solid #ffffff;
  }

  .cf-story-label {
    font-size: 12px;
    font-weight: 700;
    color: #1e293b;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 80px;
  }
{%- endstyle -%}

<div class="cf-stories-wrap">
  <div class="cf-stories-title-row">
    <h2 class="cf-stories-heading">{{ section.settings.heading | default: 'Shop by Category' }}</h2>
    <a href="/collections" style="font-size:13px;font-weight:700;color:#0f766e;text-decoration:none;">View All &rarr;</a>
  </div>

  <div class="cf-stories-rail">
    <a href="{{ section.settings.url_1 | default: '/collections/skincare' }}" class="cf-story-item">
      <div class="cf-story-ring">
        <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=160&q=80" alt="Skincare" class="cf-story-avatar" width="76" height="76">
      </div>
      <span class="cf-story-label">Skincare</span>
    </a>

    <a href="{{ section.settings.url_2 | default: '/collections/serums' }}" class="cf-story-item">
      <div class="cf-story-ring">
        <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=160&q=80" alt="Serums" class="cf-story-avatar" width="76" height="76">
      </div>
      <span class="cf-story-label">Serums</span>
    </a>

    <a href="{{ section.settings.url_3 | default: '/collections/cleansers' }}" class="cf-story-item">
      <div class="cf-story-ring">
        <img src="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=160&q=80" alt="Cleansers" class="cf-story-avatar" width="76" height="76">
      </div>
      <span class="cf-story-label">Cleansers</span>
    </a>

    <a href="{{ section.settings.url_4 | default: '/collections/moisturizers' }}" class="cf-story-item">
      <div class="cf-story-ring">
        <img src="https://images.unsplash.com/photo-1608248597359-07f2a71f00a4?w=160&q=80" alt="Creams" class="cf-story-avatar" width="76" height="76">
      </div>
      <span class="cf-story-label">Moisturizers</span>
    </a>

    <a href="{{ section.settings.url_5 | default: '/collections/sunscreen' }}" class="cf-story-item">
      <div class="cf-story-ring">
        <img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?w=160&q=80" alt="SPF" class="cf-story-avatar" width="76" height="76">
      </div>
      <span class="cf-story-label">Sunscreen</span>
    </a>

    <a href="{{ section.settings.url_6 | default: '/collections/body' }}" class="cf-story-item">
      <div class="cf-story-ring">
        <img src="https://images.unsplash.com/photo-1512290900672-1f021743d5c9?w=160&q=80" alt="Body Care" class="cf-story-avatar" width="76" height="76">
      </div>
      <span class="cf-story-label">Body Care</span>
    </a>

    <a href="{{ section.settings.url_7 | default: '/collections/bestsellers' }}" class="cf-story-item">
      <div class="cf-story-ring" style="background:linear-gradient(135deg, #10b981, #06b6d4);">
        <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=160&q=80" alt="Best Sellers" class="cf-story-avatar" width="76" height="76">
      </div>
      <span class="cf-story-label">Best Sellers</span>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Category Story Bubbles",
  "tag": "section",
  "class": "cf-category-stories-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "presets": [
    {
      "name": "Category Story Bubbles"
    }
  ]
}
{% endschema %}
