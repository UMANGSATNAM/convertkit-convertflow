{% comment %}
  Category Minimal Tiles - Clean 4-Column Minimal Cards
  Category: collection
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(36px, 6vw, 72px) 24px;
    font-family: inherit;
  }

  .cf-ctiles-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 32px;
  }

  .cf-ctiles-title {
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    margin: 0 0 6px 0;
    color: #0f172a;
  }

  .cf-ctiles-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  @media (max-width: 990px) {
    .cf-ctiles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .cf-ctile-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cf-ctile-media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: #f1f5f9;
    aspect-ratio: 1 / 1.1;
  }

  .cf-ctile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .cf-ctile-card:hover .cf-ctile-img {
    transform: scale(1.04);
  }

  .cf-ctile-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cf-ctile-name {
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
  }

  .cf-ctile-arrow {
    color: #64748b;
    font-size: 16px;
    transition: transform 0.2s, color 0.2s;
  }

  .cf-ctile-card:hover .cf-ctile-arrow {
    transform: translateX(4px);
    color: #0f172a;
  }
{%- endstyle -%}

<div class="cf-ctiles-wrap">
  <div class="cf-ctiles-head">
    <div>
      <h2 class="cf-ctiles-title">{{ section.settings.heading | default: 'Shop by Department' }}</h2>
      <p style="color:#64748b;font-size:14px;margin:0;">Handpicked essentials crafted for durability and comfort.</p>
    </div>
    <a href="/collections" style="font-size:14px;font-weight:700;color:#0f766e;text-decoration:none;">View All Categories &rarr;</a>
  </div>

  <div class="cf-ctiles-grid">
    <a href="/collections/footwear" class="cf-ctile-card">
      <div class="cf-ctile-media">
        <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600&q=80" alt="Footwear" class="cf-ctile-img" width="300" height="330">
      </div>
      <div class="cf-ctile-label-row">
        <h3 class="cf-ctile-name">Performance Footwear</h3>
        <span class="cf-ctile-arrow">&rarr;</span>
      </div>
    </a>

    <a href="/collections/apparel" class="cf-ctile-card">
      <div class="cf-ctile-media">
        <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=600&q=80" alt="Apparel" class="cf-ctile-img" width="300" height="330">
      </div>
      <div class="cf-ctile-label-row">
        <h3 class="cf-ctile-name">Active Apparel</h3>
        <span class="cf-ctile-arrow">&rarr;</span>
      </div>
    </a>

    <a href="/collections/gear" class="cf-ctile-card">
      <div class="cf-ctile-media">
        <img src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=600&q=80" alt="Gear" class="cf-ctile-img" width="300" height="330">
      </div>
      <div class="cf-ctile-label-row">
        <h3 class="cf-ctile-name">Technical Gear</h3>
        <span class="cf-ctile-arrow">&rarr;</span>
      </div>
    </a>

    <a href="/collections/recovery" class="cf-ctile-card">
      <div class="cf-ctile-media">
        <img src="https://images.unsplash.com/photo-1518611012118-696072aa579a?w=600&q=80" alt="Recovery" class="cf-ctile-img" width="300" height="330">
      </div>
      <div class="cf-ctile-label-row">
        <h3 class="cf-ctile-name">Recovery &amp; Mobility</h3>
        <span class="cf-ctile-arrow">&rarr;</span>
      </div>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Category Minimal Tiles",
  "tag": "section",
  "class": "cf-category-tiles-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Department"
    }
  ],
  "presets": [
    {
      "name": "Category Minimal Tiles"
    }
  ]
}
{% endschema %}
