{% comment %}
  Category Masonry Lookbook - Staggered Magazine Layout
  Category: collection
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 80px) 24px;
    font-family: inherit;
  }

  .cf-masonry-head {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 40px auto;
  }

  .cf-masonry-title {
    font-size: clamp(26px, 3.5vw, 42px);
    font-weight: 850;
    margin: 0 0 12px 0;
    color: #0f172a;
  }

  .cf-masonry-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 768px) {
    .cf-masonry-grid {
      grid-template-columns: 1fr;
    }
  }

  .cf-masonry-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .cf-masonry-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    background: #0f172a;
  }

  .cf-masonry-card.tall {
    min-height: 440px;
  }

  .cf-masonry-card.short {
    min-height: 280px;
  }

  .cf-masonry-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 0.5s ease;
  }

  .cf-masonry-card:hover .cf-masonry-img {
    transform: scale(1.05);
  }

  .cf-masonry-grad {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.8) 100%);
    z-index: 2;
  }

  .cf-masonry-meta {
    position: relative;
    z-index: 3;
  }

  .cf-masonry-name {
    font-size: 20px;
    font-weight: 800;
    margin: 0 0 4px 0;
  }

  .cf-masonry-link {
    font-size: 13px;
    font-weight: 700;
    color: #38bdf8;
  }
{%- endstyle -%}

<div class="cf-masonry-wrap">
  <div class="cf-masonry-head">
    <h2 class="cf-masonry-title">{{ section.settings.heading | default: 'Editorial Lookbook' }}</h2>
    <p style="color:#64748b;font-size:15px;margin:0;">Explore how our design pieces work together harmoniously across spaces.</p>
  </div>

  <div class="cf-masonry-grid">
    <!-- Col 1 -->
    <div class="cf-masonry-col">
      <a href="/collections/linen" class="cf-masonry-card tall">
        <img src="https://images.unsplash.com/photo-1509631179647-0177331693ae?w=600&q=80" alt="Linen Capsule" class="cf-masonry-img" width="400" height="440">
        <div class="cf-masonry-grad"></div>
        <div class="cf-masonry-meta">
          <h3 class="cf-masonry-name">Linen Capsule</h3>
          <span class="cf-masonry-link">Explore Edit &rarr;</span>
        </div>
      </a>
      <a href="/collections/accessories" class="cf-masonry-card short">
        <img src="https://images.unsplash.com/photo-1512436991641-6745cdb1723f?w=600&q=80" alt="Handcrafted Bags" class="cf-masonry-img" width="400" height="280">
        <div class="cf-masonry-grad"></div>
        <div class="cf-masonry-meta">
          <h3 class="cf-masonry-name">Handcrafted Bags</h3>
          <span class="cf-masonry-link">Explore Edit &rarr;</span>
        </div>
      </a>
    </div>

    <!-- Col 2 -->
    <div class="cf-masonry-col">
      <a href="/collections/footwear" class="cf-masonry-card short">
        <img src="https://images.unsplash.com/photo-1543163521-1bf539c55dd2?w=600&q=80" alt="Artisan Footwear" class="cf-masonry-img" width="400" height="280">
        <div class="cf-masonry-grad"></div>
        <div class="cf-masonry-meta">
          <h3 class="cf-masonry-name">Artisan Footwear</h3>
          <span class="cf-masonry-link">Explore Edit &rarr;</span>
        </div>
      </a>
      <a href="/collections/knitwear" class="cf-masonry-card tall">
        <img src="https://images.unsplash.com/photo-1434389677669-e08b4cac3105?w=600&q=80" alt="Merino Knitwear" class="cf-masonry-img" width="400" height="440">
        <div class="cf-masonry-grad"></div>
        <div class="cf-masonry-meta">
          <h3 class="cf-masonry-name">Merino Knitwear</h3>
          <span class="cf-masonry-link">Explore Edit &rarr;</span>
        </div>
      </a>
    </div>

    <!-- Col 3 -->
    <div class="cf-masonry-col">
      <a href="/collections/outerwear" class="cf-masonry-card tall">
        <img src="https://images.unsplash.com/photo-1539533018447-63fcce667883?w=600&q=80" alt="Winter Trench" class="cf-masonry-img" width="400" height="440">
        <div class="cf-masonry-grad"></div>
        <div class="cf-masonry-meta">
          <h3 class="cf-masonry-name">Seasonal Trench &amp; Coats</h3>
          <span class="cf-masonry-link">Explore Edit &rarr;</span>
        </div>
      </a>
      <a href="/collections/jewelry" class="cf-masonry-card short">
        <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Fine Jewelry" class="cf-masonry-img" width="400" height="280">
        <div class="cf-masonry-grad"></div>
        <div class="cf-masonry-meta">
          <h3 class="cf-masonry-name">Fine Jewelry Edit</h3>
          <span class="cf-masonry-link">Explore Edit &rarr;</span>
        </div>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Category Masonry Lookbook",
  "tag": "section",
  "class": "cf-category-masonry-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Editorial Lookbook"
    }
  ],
  "presets": [
    {
      "name": "Category Masonry Lookbook"
    }
  ]
}
{% endschema %}
