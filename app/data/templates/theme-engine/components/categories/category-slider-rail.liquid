{% comment %}
  Category Slider Rail - Touch-friendly Horizontal Collection Slider
  Category: collection
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(36px, 6vw, 72px) 24px;
    font-family: inherit;
    position: relative;
  }

  .cf-crail-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
  }

  .cf-crail-title {
    font-size: clamp(24px, 3.2vw, 36px);
    font-weight: 850;
    margin: 0 0 6px 0;
    color: #0f172a;
  }

  .cf-crail-arrows {
    display: flex;
    gap: 8px;
  }

  .cf-crail-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 16px;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .cf-crail-btn:hover {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  .cf-crail-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 16px;
  }

  .cf-crail-track::-webkit-scrollbar {
    display: none;
  }

  .cf-crail-card {
    flex: 0 0 clamp(240px, 30vw, 300px);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .cf-crail-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
  }

  .cf-crail-img-wrap {
    width: 100%;
    aspect-ratio: 4 / 3.2;
    overflow: hidden;
  }

  .cf-crail-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .cf-crail-card:hover .cf-crail-img {
    transform: scale(1.05);
  }

  .cf-crail-info {
    padding: 18px 20px;
  }

  .cf-crail-name {
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 4px 0;
  }

  .cf-crail-items {
    font-size: 13px;
    color: #64748b;
  }
{%- endstyle -%}

<div class="cf-crail-wrap">
  <div class="cf-crail-header">
    <div>
      <h2 class="cf-crail-title">{{ section.settings.heading | default: 'Featured Collections' }}</h2>
      <p style="color:#64748b;font-size:14px;margin:0;">Swipe to explore curated seasonal drops.</p>
    </div>
    <div class="cf-crail-arrows">
      <button type="button" class="cf-crail-btn" onclick="document.getElementById('cf-crail-{{ section.id }}').scrollBy({left: -320, behavior: 'smooth'})" aria-label="Previous">&larr;</button>
      <button type="button" class="cf-crail-btn" onclick="document.getElementById('cf-crail-{{ section.id }}').scrollBy({left: 320, behavior: 'smooth'})" aria-label="Next">&rarr;</button>
    </div>
  </div>

  <div class="cf-crail-track" id="cf-crail-{{ section.id }}">
    <a href="/collections/headphones" class="cf-crail-card">
      <div class="cf-crail-img-wrap">
        <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500&q=80" alt="Audio" class="cf-crail-img" width="300" height="240">
      </div>
      <div class="cf-crail-info">
        <h3 class="cf-crail-name">Wireless Acoustics</h3>
        <span class="cf-crail-items">18 Products</span>
      </div>
    </a>

    <a href="/collections/speakers" class="cf-crail-card">
      <div class="cf-crail-img-wrap">
        <img src="https://images.unsplash.com/photo-1545454675-3531b543be5d?w=500&q=80" alt="Speakers" class="cf-crail-img" width="300" height="240">
      </div>
      <div class="cf-crail-info">
        <h3 class="cf-crail-name">Home Audio &amp; Soundbars</h3>
        <span class="cf-crail-items">24 Products</span>
      </div>
    </a>

    <a href="/collections/wearables" class="cf-crail-card">
      <div class="cf-crail-img-wrap">
        <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&q=80" alt="Wearables" class="cf-crail-img" width="300" height="240">
      </div>
      <div class="cf-crail-info">
        <h3 class="cf-crail-name">Smart Fitness Wearables</h3>
        <span class="cf-crail-items">14 Products</span>
      </div>
    </a>

    <a href="/collections/accessories" class="cf-crail-card">
      <div class="cf-crail-img-wrap">
        <img src="https://images.unsplash.com/photo-1572569511254-d8f925fe2cbb?w=500&q=80" alt="Accessories" class="cf-crail-img" width="300" height="240">
      </div>
      <div class="cf-crail-info">
        <h3 class="cf-crail-name">Cables &amp; Charging Docks</h3>
        <span class="cf-crail-items">32 Products</span>
      </div>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Category Slider Rail",
  "tag": "section",
  "class": "cf-category-slider-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collections"
    }
  ],
  "presets": [
    {
      "name": "Category Slider Rail"
    }
  ]
}
{% endschema %}
