{% comment %}
  Category Bento Cards - Asymmetrical Grid of Collections
  Category: collection
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 80px) 24px;
    font-family: inherit;
  }

  .cf-catbento-head {
    text-align: center;
    margin-bottom: 40px;
  }

  .cf-catbento-title {
    font-size: clamp(26px, 3.5vw, 42px);
    font-weight: 850;
    margin: 0 0 10px 0;
    letter-spacing: -0.02em;
  }

  .cf-catbento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 280px;
    gap: 20px;
  }

  @media (max-width: 900px) {
    .cf-catbento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .cf-catbento-grid {
      grid-template-columns: 1fr;
    }
  }

  .cf-catbento-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  }

  .cf-catbento-card.span-2 {
    grid-column: span 2;
  }

  @media (max-width: 600px) {
    .cf-catbento-card.span-2 {
      grid-column: span 1;
    }
  }

  .cf-catbento-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cf-catbento-card:hover .cf-catbento-bg {
    transform: scale(1.05);
  }

  .cf-catbento-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.75) 100%);
    z-index: 2;
  }

  .cf-catbento-content {
    position: relative;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .cf-catbento-name {
    font-size: 22px;
    font-weight: 800;
    margin: 0 0 4px 0;
  }

  .cf-catbento-count {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.8);
  }

  .cf-catbento-arrow {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    transition: background-color 0.2s, transform 0.2s;
  }

  .cf-catbento-card:hover .cf-catbento-arrow {
    background: #ffffff;
    color: #0f172a;
    transform: translateX(4px);
  }
{%- endstyle -%}

<div class="cf-catbento-wrap">
  <div class="cf-catbento-head">
    <h2 class="cf-catbento-title">{{ section.settings.heading | default: 'Curated Collections' }}</h2>
    <p style="color:#64748b;font-size:15px;margin:0;">Handcrafted pieces categorized by room and style purpose.</p>
  </div>

  <div class="cf-catbento-grid">
    <a href="/collections/living" class="cf-catbento-card span-2">
      <img src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=800&q=80" alt="Living Room" class="cf-catbento-bg" width="800" height="300">
      <div class="cf-catbento-overlay"></div>
      <div class="cf-catbento-content">
        <div>
          <h3 class="cf-catbento-name">Living Room Architecture</h3>
          <span class="cf-catbento-count">48 Products</span>
        </div>
        <span class="cf-catbento-arrow">&rarr;</span>
      </div>
    </a>

    <a href="/collections/lighting" class="cf-catbento-card">
      <img src="https://images.unsplash.com/photo-1507473885765-e6ed057f782c?w=600&q=80" alt="Sculptural Lighting" class="cf-catbento-bg" width="400" height="300">
      <div class="cf-catbento-overlay"></div>
      <div class="cf-catbento-content">
        <div>
          <h3 class="cf-catbento-name">Sculptural Lighting</h3>
          <span class="cf-catbento-count">24 Products</span>
        </div>
        <span class="cf-catbento-arrow">&rarr;</span>
      </div>
    </a>

    <a href="/collections/ceramics" class="cf-catbento-card">
      <img src="https://images.unsplash.com/photo-1615529182904-14819c35db37?w=600&q=80" alt="Ceramics & Vases" class="cf-catbento-bg" width="400" height="300">
      <div class="cf-catbento-overlay"></div>
      <div class="cf-catbento-content">
        <div>
          <h3 class="cf-catbento-name">Ceramics &amp; Vessels</h3>
          <span class="cf-catbento-count">36 Products</span>
        </div>
        <span class="cf-catbento-arrow">&rarr;</span>
      </div>
    </a>

    <a href="/collections/bedroom" class="cf-catbento-card span-2">
      <img src="https://images.unsplash.com/photo-1540518614846-7ede433c4ef7?w=800&q=80" alt="Linen Bedroom" class="cf-catbento-bg" width="800" height="300">
      <div class="cf-catbento-overlay"></div>
      <div class="cf-catbento-content">
        <div>
          <h3 class="cf-catbento-name">Organic Bedroom &amp; Bedding</h3>
          <span class="cf-catbento-count">52 Products</span>
        </div>
        <span class="cf-catbento-arrow">&rarr;</span>
      </div>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Category Bento Cards",
  "tag": "section",
  "class": "cf-category-bento-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated Collections"
    }
  ],
  "presets": [
    {
      "name": "Category Bento Cards"
    }
  ]
}
{% endschema %}
