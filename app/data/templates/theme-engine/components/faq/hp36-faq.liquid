{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Oswald:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    
    --font-serif: 'Playfair Display', serif;
    --font-sans: 'Oswald', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--border-color);
  }

  .hp36-faq-wrapper {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp36-faq-wrapper {
      padding: 0 20px;
    }
  }

  .hp36-faq__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .hp36-faq__subtitle {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 20px;
  }

  .hp36-faq__title {
    font-family: var(--font-serif);
    font-size: clamp(40px, 6vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
  }
  
  .hp36-faq__title em {
    font-style: italic;
    text-transform: lowercase;
  }

  .hp36-faq__list {
    border-top: 1px solid var(--border-color);
  }

  .hp36-faq__item {
    border-bottom: 1px solid var(--border-color);
  }

  .hp36-faq__question {
    width: 100%;
    background: none;
    border: none;
    padding: 30px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 18px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: left;
  }

  .hp36-faq__icon {
    font-size: 24px;
    font-weight: 300;
    transition: transform 0.3s ease;
  }
  
  .hp36-faq__item.is-open .hp36-faq__icon {
    transform: rotate(45deg);
  }

  .hp36-faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s cubic-bezier(0, 1, 0, 1);
  }
  
  .hp36-faq__item.is-open .hp36-faq__answer {
    max-height: 1000px;
    transition: max-height 1s ease-in-out;
  }

  .hp36-faq__answer-inner {
    padding: 0 0 40px 0;
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-color);
    max-width: 800px;
  }
  
  .hp36-faq__answer-inner p {
    margin: 0 0 15px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp36-faq-wrapper" id="HP36FAQ-{{ section.id }}">
  <div class="hp36-faq__header">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp36-faq__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    <h2 class="hp36-faq__title">{{ section.settings.title | replace: 'Inquiries', '<em>Inquiries</em>' }}</h2>
  </div>

  <div class="hp36-faq__list">
    {%- for block in section.blocks -%}
      <div class="hp36-faq__item" {{ block.shopify_attributes }}>
        <button class="hp36-faq__question" aria-expanded="false">
          {{ block.settings.question }}
          <span class="hp36-faq__icon">+</span>
        </button>
        <div class="hp36-faq__answer">
          <div class="hp36-faq__answer-inner">
            {{ block.settings.answer }}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const items = document.querySelectorAll('#HP36FAQ-{{ section.id }} .hp36-faq__item');
    items.forEach(item => {
      const btn = item.querySelector('.hp36-faq__question');
      btn.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');
        // Close all
        items.forEach(i => {
          i.classList.remove('is-open');
          i.querySelector('.hp36-faq__question').setAttribute('aria-expanded', 'false');
        });
        // Open clicked if it wasn't open
        if (!isOpen) {
          item.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP36 - Editorial FAQ",
  "class": "section-hp36-faq",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Client Inquiries"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "CONCIERGE"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Editorial Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Where are the collections manufactured?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Every garment is meticulously constructed in our ateliers in Milan and Paris, working exclusively with master tailors to ensure uncompromising quality.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP36 - Editorial FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "Do you offer private appointments?", "answer": "<p>Yes, private showroom appointments can be arranged in New York, London, and Paris. Please contact our concierge service to schedule a viewing.</p>" } },
        { "type": "faq", "settings": { "question": "What is the return policy for archive pieces?", "answer": "<p>Archive pieces are final sale, given their rarity and delicate nature. We advise consulting our fit guide prior to acquisition.</p>" } }
      ]
    }
  ]
}
{% endschema %}
