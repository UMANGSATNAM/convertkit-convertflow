{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#00FFA3'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 1px solid #333;
    color: #FFF;
  }
  
  .hp13-faq-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .hp13-faq-heading-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    margin: 0 0 40px 0;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  
  .hp13-faq-heading-{{ section_id }} span {
    color: {{ text_color }};
  }
  
  .hp13-faq-item-{{ section_id }} {
    border: 1px solid #333;
    margin-bottom: 10px;
    background: #111;
  }
  
  .hp13-faq-question-{{ section_id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background: transparent;
    border: none;
    color: #FFF;
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    text-align: left;
    outline: none;
  }
  
  .hp13-faq-question-{{ section_id }}:hover {
    color: {{ text_color }};
  }
  
  .hp13-faq-icon-{{ section_id }} {
    color: {{ text_color }};
    font-size: 1.2rem;
    font-weight: bold;
    transition: transform 0.3s ease;
  }
  
  .hp13-faq-item-{{ section_id }}.is-active .hp13-faq-icon-{{ section_id }} {
    transform: rotate(45deg);
  }
  
  .hp13-faq-item-{{ section_id }}.is-active .hp13-faq-question-{{ section_id }} {
    color: {{ text_color }};
    border-bottom: 1px solid #333;
  }
  
  .hp13-faq-answer-{{ section_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #CCC;
    padding: 0 20px;
  }
  
  .hp13-faq-item-{{ section_id }}.is-active .hp13-faq-answer-{{ section_id }} {
    max-height: 500px;
    padding: 20px;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
  }
</style>

<div class="hp13-faq-container-{{ section_id }}">
  <h2 class="hp13-faq-heading-{{ section_id }}">INTEL <span>DATABASE</span></h2>
  
  <div class="hp13-faq-list-{{ section_id }}">
    {% for block in section.blocks %}
      <div class="hp13-faq-item-{{ section_id }}" {{ block.shopify_attributes }}>
        <button class="hp13-faq-question-{{ section_id }}" onclick="this.parentElement.classList.toggle('is-active')">
          > {{ block.settings.question | default: 'QUERY_STRING' }}
          <span class="hp13-faq-icon-{{ section_id }}">+</span>
        </button>
        <div class="hp13-faq-answer-{{ section_id }}">
          {{ block.settings.answer | default: 'Data response generated.' }}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP13 FAQ",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Highlight Color",
      "default": "#00FFA3"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "ARE THE MODULES WATERPROOF?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Yes. All outerwear utilizes a 3-layer bonded matrix with a 10,000mm hydrostatic head rating."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP13 FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "ARE THE MODULES WATERPROOF?" } },
        { "type": "faq", "settings": { "question": "HOW DOES THE MOLLE SYSTEM INTEGRATE?" } },
        { "type": "faq", "settings": { "question": "WHAT IS THE DEPLOYMENT TIMEFRAME?" } }
      ]
    }
  ]
}
{% endschema %}
