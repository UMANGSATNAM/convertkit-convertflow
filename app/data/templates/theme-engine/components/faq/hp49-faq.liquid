{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp49-faq-bg: {{ section.settings.bg_color | default: '#F5F3FF' }};
    --hp49-accent: {{ section.settings.accent_color | default: '#7C3AED' }};
    
    background-color: var(--hp49-faq-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp49-faq__wrap {
    max-width: {{ section.settings.container_width | default: 860 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp49-faq__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .hp49-faq__heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 800;
    color: #2E1065;
    margin: 0 0 8px;
  }

  .hp49-faq__item {
    background: #FFFFFF;
    border: 1px solid rgba(124, 58, 237, 0.15);
    border-radius: 24px;
    padding: 24px 28px;
    margin-bottom: 16px;
    box-shadow: 0 4px 16px rgba(124, 58, 237, 0.04);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp49-faq__item:hover { border-color: var(--hp49-accent); }

  .hp49-faq__q {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 16px;
    font-weight: 800;
    color: #2E1065;
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp49-faq__a {
    font-size: 14px;
    line-height: 1.7;
    color: #5B21B6;
    opacity: 0.85;
    margin: 14px 0 0;
    padding-top: 14px;
    border-top: 1px solid rgba(124, 58, 237, 0.12);
  }
{%- endstyle -%}

<div class="hp49-faq__wrap">
  <div class="hp49-faq__header">
    <h2 class="hp49-faq__heading">{{ section.settings.heading | default: 'Lavender Dream Clarifications' }}</h2>
    <p style="font-size:14px; color:#5B21B6; opacity:0.85;">{{ section.settings.subheading | default: 'Helpful guidance on alpine hydrosols, hypoallergenic security, and express global dispatch.' }}</p>
  </div>

  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="hp49-faq__item" {{ block.shopify_attributes }}>
        <h3 class="hp49-faq__q">
          <span>{{ block.settings.question }}</span>
          <span style="color:var(--hp49-accent);">+</span>
        </h3>
        <p class="hp49-faq__a">{{ block.settings.answer }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="hp49-faq__item">
      <h3 class="hp49-faq__q"><span>How does French Alpine lavender benefit reactive skin?</span><span style="color:#7C3AED;">+</span></h3>
      <p class="hp49-faq__a">Grown above 1,200 meters, high-altitude lavender develops high concentrations of natural linalyl acetate, which actively inhibits histamine flare-ups and calms skin flush.</p>
    </div>
    <div class="hp49-faq__item">
      <h3 class="hp49-faq__q"><span>Are international customs duties fully covered?</span><span style="color:#7C3AED;">+</span></h3>
      <p class="hp49-faq__a">Yes, all international shipments are dispatched via DDP air express with all national VAT, tariffs, and customs duties pre-paid at checkout.</p>
    </div>
    <div class="hp49-faq__item">
      <h3 class="hp49-faq__q"><span>Is the packaging recyclable and eco-friendly?</span><span style="color:#7C3AED;">+</span></h3>
      <p class="hp49-faq__a">Yes, our lavender-tinted bottles are crafted from 100% recyclable frosted glass with biodegradable plant-based outer carton cushioning.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP49 - Lavender FAQ",
  "class": "section-hp49-faq",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F3FF" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#7C3AED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lavender Dream Clarifications" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Helpful guidance on alpine hydrosols, hypoallergenic security, and express global dispatch." },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 860 }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does French Alpine lavender benefit reactive skin?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Grown above 1,200 meters, high-altitude lavender develops natural linalyl acetate." }
      ]
    }
  ],
  "presets": [
    { "name": "HP49 - Lavender FAQ" }
  ]
}
{% endschema %}
