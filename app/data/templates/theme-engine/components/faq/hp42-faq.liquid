{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@300;400&display=swap');

  #shopify-section-{{ section.id }} {
    --bg: {{ section.settings.bg_color }};
    --text: {{ section.settings.text_color }};
    --gold: {{ section.settings.accent_color }};
    --serif: 'Playfair Display', serif;
    --sans: 'Inter', sans-serif;
    background: var(--bg);
    padding: 100px 20px;
  }

  .hp42-faq {
    max-width: 800px;
    margin: 0 auto;
  }

  .hp42-faq__title {
    font-family: var(--serif);
    font-size: clamp(36px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text);
    margin: 0 0 60px;
    text-align: center;
  }

  .hp42-faq__list {
    display: flex;
    flex-direction: column;
  }

  .hp42-faq__item {
    border-bottom: 1px solid rgba(201,169,110,0.15);
  }

  .hp42-faq__question {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 30px 0;
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 400;
    color: var(--text);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.3s;
  }

  .hp42-faq__question:hover { color: var(--gold); }

  .hp42-faq__icon {
    width: 20px; height: 20px;
    position: relative;
    flex-shrink: 0;
  }

  .hp42-faq__icon::before, .hp42-faq__icon::after {
    content: '';
    position: absolute;
    background: var(--gold);
    transition: transform 0.3s ease;
  }

  .hp42-faq__icon::before {
    width: 100%;
    height: 1px;
    top: 50%;
  }

  .hp42-faq__icon::after {
    width: 1px;
    height: 100%;
    left: 50%;
  }

  .hp42-faq__item.is-active .hp42-faq__icon::after {
    transform: rotate(90deg);
  }

  .hp42-faq__answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  .hp42-faq__answer-inner { overflow: hidden; }

  .hp42-faq__answer-inner > div {
    padding: 0 0 30px;
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.7;
    color: var(--text);
    opacity: 0.6;
    max-width: 600px;
  }

  .hp42-faq__item.is-active .hp42-faq__answer {
    grid-template-rows: 1fr;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp42-faq" id="HP42Faq-{{ section.id }}">
  <h2 class="hp42-faq__title">{{ section.settings.title }}</h2>

  <div class="hp42-faq__list">
    {%- for block in section.blocks -%}
      <div class="hp42-faq__item {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
        <button class="hp42-faq__question">
          {{ block.settings.question }}
          <span class="hp42-faq__icon"></span>
        </button>
        <div class="hp42-faq__answer">
          <div class="hp42-faq__answer-inner">
            <div>{{ block.settings.answer }}</div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var w = document.getElementById('HP42Faq-{{ section.id }}');
    var items = w.querySelectorAll('.hp42-faq__item');
    items.forEach(function(el) {
      el.querySelector('.hp42-faq__question').addEventListener('click', function() {
        var a = el.classList.contains('is-active');
        items.forEach(function(i) { i.classList.remove('is-active'); });
        if (!a) el.classList.add('is-active');
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP42 - Noir FAQ",
  "class": "section-hp42-faq",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Frequently Asked" },
    { "type": "range", "id": "title_size", "min": 24, "max": 80, "step": 2, "unit": "px", "label": "Title Size", "default": 48 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A0A0A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F0EB" },
    { "type": "color", "id": "accent_color", "label": "Gold", "default": "#C9A96E" },
    { "type": "html", "id": "custom_css", "label": "Custom CSS" }
  ],
  "blocks": [{ "type": "faq", "name": "FAQ", "settings": [
    { "type": "text", "id": "question", "label": "Question", "default": "What materials do you use?" },
    { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Only the rarest, ethically sourced materials. Each piece passes through seventeen stages of quality control.</p>" }
  ]}],
  "presets": [{ "name": "HP42 - Noir FAQ", "blocks": [
    { "type": "faq" },
    { "type": "faq", "settings": { "question": "Do you offer international shipping?", "answer": "<p>We ship to over 60 countries with complimentary tracking and discreet packaging.</p>" } },
    { "type": "faq", "settings": { "question": "What is your return policy?", "answer": "<p>We offer a 30-day return window. Items must be in original condition with all packaging.</p>" } }
  ]}]
}
{% endschema %}
