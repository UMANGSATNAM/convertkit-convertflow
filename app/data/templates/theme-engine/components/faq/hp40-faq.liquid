{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Inter', sans-serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    border-bottom: 2px solid var(--text-color);
  }

  .hp40-faq-wrapper {
    /* Standard flow */
  }

  .hp40-faq__header {
    padding: 60px 40px;
    border-bottom: 2px solid var(--text-color);
  }

  .hp40-faq__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -2px;
  }

  .hp40-faq__list {
    display: flex;
    flex-direction: column;
  }

  .hp40-faq__item {
    border-bottom: 2px solid var(--text-color);
    transition: background 0.3s ease, color 0.3s ease;
    background: var(--bg-color);
  }

  .hp40-faq__item:last-child {
    border-bottom: none;
  }

  .hp40-faq__question {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 30px 40px;
    font-family: var(--font-heading);
    font-size: clamp(20px, 3vw, 36px);
    font-weight: 900;
    color: var(--text-color);
    cursor: pointer;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 30px;
    align-items: center;
    text-transform: uppercase;
    letter-spacing: -1px;
    transition: color 0.3s ease;
  }
  
  @media screen and (max-width: 600px) {
    .hp40-faq__question {
      padding: 20px;
      gap: 15px;
    }
  }

  .hp40-faq__item:hover {
    background: var(--text-color);
  }
  .hp40-faq__item:hover .hp40-faq__question {
    color: var(--bg-color);
  }
  .hp40-faq__item:hover .hp40-faq__index {
    color: var(--bg-color);
  }
  .hp40-faq__item:hover .hp40-faq__icon svg {
    fill: var(--bg-color);
  }

  .hp40-faq__index {
    font-size: 14px;
    color: var(--text-color);
    font-weight: 700;
    transition: color 0.3s ease;
  }

  .hp40-faq__icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hp40-faq__icon svg {
    width: 20px; height: 20px;
    fill: var(--text-color);
    transition: transform 0.3s ease, fill 0.3s ease;
  }

  .hp40-faq__answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  
  .hp40-faq__answer-inner {
    overflow: hidden;
  }

  .hp40-faq__answer-inner > div {
    padding: 0 40px 40px;
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.5;
    color: var(--bg-color); /* Need this for when open since bg is inverted */
    max-width: 800px;
  }
  
  @media screen and (max-width: 600px) {
    .hp40-faq__answer-inner > div {
      padding: 0 20px 20px;
    }
  }

  /* Active state logic */
  .hp40-faq__item.is-active {
    background: var(--accent-color) !important;
  }
  .hp40-faq__item.is-active .hp40-faq__question,
  .hp40-faq__item.is-active .hp40-faq__index {
    color: var(--bg-color) !important;
  }
  .hp40-faq__item.is-active .hp40-faq__icon svg {
    transform: rotate(45deg);
    fill: var(--bg-color) !important;
  }
  .hp40-faq__item.is-active .hp40-faq__answer {
    grid-template-rows: 1fr;
  }
  .hp40-faq__item.is-active .hp40-faq__answer-inner > div {
    color: var(--bg-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp40-faq-wrapper" id="HP40Faq-{{ section.id }}">
  <div class="hp40-faq__header">
    <h2 class="hp40-faq__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp40-faq__list">
    {%- for block in section.blocks -%}
      <div class="hp40-faq__item {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
        <button class="hp40-faq__question">
          <span class="hp40-faq__index">0{{ forloop.index }}</span>
          <span>{{ block.settings.question }}</span>
          <span class="hp40-faq__icon">
            <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
          </span>
        </button>
        <div class="hp40-faq__answer">
          <div class="hp40-faq__answer-inner">
            <div>{{ block.settings.answer }}</div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const wrapper = document.getElementById('HP40Faq-{{ section.id }}');
    const items = wrapper.querySelectorAll('.hp40-faq__item');
    
    items.forEach(item => {
      const btn = item.querySelector('.hp40-faq__question');
      
      btn.addEventListener('click', () => {
        const isActive = item.classList.contains('is-active');
        
        // Close all
        items.forEach(i => i.classList.remove('is-active'));
        
        // Open clicked if it wasn't already open
        if (!isActive) {
          item.classList.add('is-active');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP40 - Swiss FAQ",
  "class": "section-hp40-faq",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SYSTEM INQUIRIES"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "header",
      "content": "Swiss Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Lines",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Active Background Color",
      "default": "#E21833"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "WHAT IS THE DESIGN PHILOSOPHY?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We believe in the removal of the unnecessary so that the necessary may speak. Pure utility.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP40 - Swiss FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "SHIPPING PROTOCOL?", "answer": "<p>Standardized packaging. Shipped precisely within 24 hours of order processing.</p>" } },
        { "type": "faq", "settings": { "question": "RETURN FRAMEWORK?", "answer": "<p>A 30-day logical evaluation period. If utility is not met, return for full processing.</p>" } }
      ]
    }
  ]
}
{% endschema %}
