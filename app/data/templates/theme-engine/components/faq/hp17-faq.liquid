{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 1px solid rgba(0, 255, 65, 0.3);
  }
  
  .hp17-faq-container-{{ section_id }} {
    max-width: 900px;
    margin: 0 auto;
  }
  
  .hp17-faq-header-{{ section_id }} {
    margin-bottom: 50px;
  }
  
  .hp17-faq-subtitle-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    color: #B800FF;
    font-size: 0.9rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .hp17-faq-subtitle-{{ section_id }}::before { content: '// '; }
  
  .hp17-faq-title-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    text-transform: uppercase;
    color: #FFF;
    margin: 0;
    line-height: 1;
  }
  
  .hp17-faq-item-{{ section_id }} {
    border: 1px solid rgba(0, 255, 65, 0.3);
    margin-bottom: 20px;
    background: #0A0A0A;
    transition: all 0.3s ease;
  }
  
  .hp17-faq-item-{{ section_id }}:hover {
    border-color: #00FF41;
    box-shadow: -5px 5px 0 rgba(0, 255, 65, 0.1);
  }
  
  .hp17-faq-question-{{ section_id }} {
    padding: 25px 30px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.1rem;
    font-weight: bold;
    color: #00FF41;
    text-transform: uppercase;
  }
  
  .hp17-faq-icon-{{ section_id }} {
    color: #B800FF;
    font-size: 1.5rem;
    line-height: 1;
    transition: transform 0.3s ease;
  }
  
  .hp17-faq-answer-{{ section_id }} {
    padding: 0 30px;
    max-height: 0;
    overflow: hidden;
    transition: all 0.3s ease;
    font-family: 'Arial', sans-serif;
    color: rgba(255,255,255,0.7);
    line-height: 1.6;
    border-top: 1px solid transparent;
  }
  
  .hp17-faq-item-{{ section_id }}.active .hp17-faq-answer-{{ section_id }} {
    padding: 20px 30px 30px;
    max-height: 500px;
    border-top-color: rgba(0, 255, 65, 0.2);
  }
  
  .hp17-faq-item-{{ section_id }}.active .hp17-faq-icon-{{ section_id }} {
    transform: rotate(45deg);
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp17-faq-question-{{ section_id }} {
      padding: 20px;
      font-size: 0.95rem;
    }
    .hp17-faq-answer-{{ section_id }} {
      padding: 0 20px;
    }
    .hp17-faq-item-{{ section_id }}.active .hp17-faq-answer-{{ section_id }} {
      padding: 15px 20px 25px;
    }
  }
</style>

<div class="hp17-faq-container-{{ section_id }}">
  <div class="hp17-faq-header-{{ section_id }}">
    <div class="hp17-faq-subtitle-{{ section_id }}">KNOWLEDGE_BASE</div>
    <h2 class="hp17-faq-title-{{ section_id }}">{{ section.settings.title | default: 'SYSTEM LOGS' }}</h2>
  </div>
  
  <div class="hp17-faq-list-{{ section_id }}">
    {% for block in section.blocks %}
      <div class="hp17-faq-item-{{ section_id }}" {{ block.shopify_attributes }}>
        <div class="hp17-faq-question-{{ section_id }}" onclick="this.parentElement.classList.toggle('active')">
          <span>{{ block.settings.question }}</span>
          <span class="hp17-faq-icon-{{ section_id }}">+</span>
        </div>
        <div class="hp17-faq-answer-{{ section_id }}">
          {{ block.settings.answer }}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP17 FAQ",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "SYSTEM LOGS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "HOW DO I UPGRADE MY GEAR?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>All modules are plug-and-play compatible with the base exosuit layer. Check the specs on individual product pages.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP17 FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "IS THIS WATERPROOF?", "answer": "<p>Acid rain resistant up to class 4 storms.</p>" } },
        { "type": "faq", "settings": { "question": "SHIPPING TO OFF-WORLD COLONIES?", "answer": "<p>We currently only ship within the terrestrial network. Mars expansion coming 2049.</p>" } }
      ]
    }
  ]
}
{% endschema %}
