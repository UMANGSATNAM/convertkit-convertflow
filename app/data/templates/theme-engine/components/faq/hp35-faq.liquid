{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito:wght@300;400;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Nunito', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp35-faq-wrapper {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp35-faq-wrapper {
      padding: 0 20px;
    }
  }

  .hp35-faq__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .hp35-faq__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.2;
    color: var(--text-color);
    margin: 0;
    font-weight: 400;
  }
  
  .hp35-faq__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp35-faq__list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hp35-faq__item {
    border-bottom: 1px solid rgba(0,0,0,0.05);
    padding-bottom: 20px;
  }

  .hp35-faq__question {
    font-family: var(--font-body);
    font-size: 18px;
    color: var(--text-color);
    font-weight: 600;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
    transition: color 0.3s ease;
  }

  .hp35-faq__question:hover {
    color: var(--accent-color);
  }

  .hp35-faq__icon {
    width: 24px;
    height: 24px;
    border: 1px solid var(--text-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    opacity: 0.5;
  }

  .hp35-faq__icon::before,
  .hp35-faq__icon::after {
    content: '';
    position: absolute;
    background: currentColor;
    border-radius: 2px;
  }

  .hp35-faq__icon::before {
    width: 10px; height: 1px;
  }
  
  .hp35-faq__icon::after {
    width: 1px; height: 10px;
    transition: transform 0.3s ease;
  }

  .hp35-faq__item.active .hp35-faq__icon::after {
    transform: rotate(90deg) scale(0);
  }
  
  .hp35-faq__item.active .hp35-faq__icon {
    border-color: var(--accent-color);
    color: var(--accent-color);
    opacity: 1;
  }

  .hp35-faq__answer {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-color);
    opacity: 0.8;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s ease, margin-top 0.5s ease;
    font-weight: 300;
  }

  .hp35-faq__item.active .hp35-faq__answer {
    max-height: 500px;
    margin-top: 20px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp35-faq-wrapper" id="HP35FAQ-{{ section.id }}">
  <div class="hp35-faq__header">
    <h2 class="hp35-faq__title">{{ section.settings.title | replace: 'curiosities', '<em>curiosities</em>' }}</h2>
  </div>

  <div class="hp35-faq__list">
    {%- for block in section.blocks -%}
      <div class="hp35-faq__item" {{ block.shopify_attributes }}>
        <div class="hp35-faq__question" onclick="this.parentElement.classList.toggle('active')">
          {{ block.settings.question }}
          <span class="hp35-faq__icon"></span>
        </div>
        <div class="hp35-faq__answer">
          {{ block.settings.answer }}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP35 - Organic FAQ",
  "class": "section-hp35-faq",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Common curiosities"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C422F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CC7B5E"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How are your pieces made?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Every item is crafted slowly and with intention by skilled artisans using sustainable, ethically sourced materials."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP35 - Organic FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
