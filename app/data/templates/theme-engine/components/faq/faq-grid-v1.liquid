{% schema %}
{
  "name": "FAQ Grid (Home)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Got Questions?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know about our furniture."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How is the furniture delivered?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "We offer white-glove delivery service for all large items."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Grid (Home)",
      "category": "FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "What is the return policy?", "answer": "You have 30 days to return any item in original condition." } },
        { "type": "faq", "settings": { "question": "Are materials sustainably sourced?", "answer": "Yes, we use FSC certified wood and ethical sourcing." } },
        { "type": "faq", "settings": { "question": "Do you offer assembly?", "answer": "Yes, white-glove delivery includes full assembly." } }
      ]
    }
  ]
}
{% endschema %}

<div class="faq-grid faq-grid--home" style="max-width: 1200px; margin: 0 auto; padding: 5rem 2rem;">
  <div style="text-align: center; margin-bottom: 4rem;">
    <h2 style="font-family: var(--font-heading-family); color: var(--color-text); font-size: 2.5rem; margin-bottom: 1rem;">{{ section.settings.heading }}</h2>
    <p style="font-family: var(--font-body-family); color: var(--color-text); opacity: 0.8; font-size: 1.1rem;">{{ section.settings.subheading }}</p>
  </div>
  
  <div class="faq-grid__container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem;">
    {% for block in section.blocks %}
      <div class="faq-grid__item" {{ block.shopify_attributes }}>
        <h3 style="font-family: var(--font-heading-family); color: var(--color-text); font-size: 1.2rem; margin-bottom: 1rem;">{{ block.settings.question }}</h3>
        <p style="font-family: var(--font-body-family); color: var(--color-text); opacity: 0.8; line-height: 1.6;">{{ block.settings.answer }}</p>
      </div>
    {% endfor %}
  </div>
</div>
