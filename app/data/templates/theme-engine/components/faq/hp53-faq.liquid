{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#F5EDE3' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp53-faq__container {
    max-width: {{ section.settings.container_width | default: 800 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp53-faq__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp53-faq__eyebrow {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#C2703E' }};
    margin: 0 0 12px;
  }

  .hp53-faq__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#5C3D2E' }};
    margin: 0;
  }

  .hp53-faq__item {
    border-bottom: 1px solid {{ section.settings.border_color | default: '#E8D5C0' }};
  }

  .hp53-faq__question {
    width: 100%;
    background: none;
    border: none;
    padding: 22px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#5C3D2E' }};
    text-align: left;
  }

  .hp53-faq__icon {
    font-size: 20px;
    color: {{ section.settings.accent_color | default: '#C2703E' }};
    transition: transform 0.3s ease;
    flex-shrink: 0;
    margin-left: 16px;
  }

  .hp53-faq__item.active .hp53-faq__icon {
    transform: rotate(45deg);
  }

  .hp53-faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease;
  }

  .hp53-faq__item.active .hp53-faq__answer {
    max-height: 300px;
  }

  .hp53-faq__answer-inner {
    padding: 0 0 22px;
    font-size: 15px;
    line-height: 1.7;
    color: {{ section.settings.text_color | default: '#8B6F5E' }};
  }
{%- endstyle -%}

<div class="hp53-faq__container">
  <div class="hp53-faq__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hp53-faq__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="hp53-faq__heading">{{ section.settings.heading | default: 'Common Questions' }}</h2>
  </div>

  {%- for block in section.blocks -%}
    <div class="hp53-faq__item" {{ block.shopify_attributes }}>
      <button class="hp53-faq__question" onclick="this.parentElement.classList.toggle('active')">
        <span>{{ block.settings.question | default: 'What makes your products unique?' }}</span>
        <span class="hp53-faq__icon">+</span>
      </button>
      <div class="hp53-faq__answer">
        <div class="hp53-faq__answer-inner">{{ block.settings.answer | default: 'Our formulations are inspired by Saharan beauty rituals.' }}</div>
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP53 - Dune FAQ",
  "class": "section-hp53-faq",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5EDE3" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#5C3D2E" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C2703E" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#8B6F5E" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E8D5C0" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◈ FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Common Questions" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1000, "step": 20, "unit": "px", "label": "Container Width", "default": 800 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What makes your products unique?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Our formulations are inspired by Saharan beauty rituals using argan oil and desert botanicals." }
      ]
    }
  ],
  "presets": [{
    "name": "HP53 - Dune FAQ",
    "blocks": [
      { "type": "faq" },
      { "type": "faq", "settings": { "question": "Are your products cruelty-free?", "answer": "Yes, all products are 100% cruelty-free and vegan." } },
      { "type": "faq", "settings": { "question": "How long does shipping take?", "answer": "Standard shipping takes 3-5 business days." } }
    ]
  }]
}
{% endschema %}
