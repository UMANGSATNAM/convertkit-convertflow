{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ffcc'
  assign heading = section.settings.heading | default: 'KNOWLEDGE BASE'
  assign subtext = section.settings.subtext | default: 'Everything you need to know about our gear.'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 0;
    color: {{ text_color }};
    position: relative;
    overflow: hidden;
  }
  
  .hp6-faq-container-{{ section_id }} {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }
  
  .hp6-faq-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .hp6-faq-header-{{ section_id }} h2 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    text-transform: uppercase;
    font-family: 'Impact', 'Arial Black', sans-serif;
    margin: 0;
    letter-spacing: -0.02em;
    position: relative;
    display: inline-block;
  }
  
  /* Angled accent bar under heading */
  .hp6-faq-header-{{ section_id }} h2::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%) skewX(-20deg);
    width: 80px;
    height: 6px;
    background-color: {{ accent_color }};
  }
  
  .hp6-faq-header-{{ section_id }} p {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    opacity: 0.7;
    margin-top: 25px;
  }
  
  .hp6-faq-wrapper-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  
  .hp6-faq-item-{{ section_id }} {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transform: skewX(-3deg);
    transition: all 0.3s ease;
  }
  
  .hp6-faq-item-{{ section_id }}:hover {
    border-color: {{ accent_color | color_modify: 'alpha', 0.5 }};
    background: rgba(255, 255, 255, 0.05);
  }
  
  .hp6-faq-item-{{ section_id }}.active {
    border-color: {{ accent_color }};
    background: rgba(0, 0, 0, 0.5);
    box-shadow: -5px 5px 0 {{ accent_color | color_modify: 'alpha', 0.2 }};
  }
  
  .hp6-faq-question-{{ section_id }} {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    color: {{ text_color }};
    padding: 25px 30px;
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transform: skewX(3deg); /* Undo skew for text */
  }
  
  .hp6-faq-icon-{{ section_id }} {
    position: relative;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  }
  
  .hp6-faq-icon-{{ section_id }}::before,
  .hp6-faq-icon-{{ section_id }}::after {
    content: '';
    position: absolute;
    background-color: {{ accent_color }};
    transition: all 0.3s ease;
  }
  
  /* Horizontal line */
  .hp6-faq-icon-{{ section_id }}::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 3px;
    transform: translateY(-50%);
  }
  
  /* Vertical line */
  .hp6-faq-icon-{{ section_id }}::after {
    top: 0;
    left: 50%;
    width: 3px;
    height: 100%;
    transform: translateX(-50%);
  }
  
  .hp6-faq-item-{{ section_id }}.active .hp6-faq-icon-{{ section_id }} {
    transform: rotate(180deg);
  }
  
  .hp6-faq-item-{{ section_id }}.active .hp6-faq-icon-{{ section_id }}::after {
    transform: translateX(-50%) scaleY(0);
    opacity: 0;
  }
  
  .hp6-faq-answer-{{ section_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s cubic-bezier(0, 1, 0, 1);
    transform: skewX(3deg); /* Undo skew for text */
  }
  
  .hp6-faq-item-{{ section_id }}.active .hp6-faq-answer-{{ section_id }} {
    max-height: 500px;
    transition: max-height 0.8s ease-in-out;
  }
  
  .hp6-faq-answer-inner-{{ section_id }} {
    padding: 0 30px 25px 30px;
    font-family: 'Inter', sans-serif;
    font-size: 1.05rem;
    line-height: 1.6;
    color: {{ text_color | color_modify: 'alpha', 0.8 }};
  }
  
  .hp6-faq-answer-inner-{{ section_id }} p:last-child {
    margin-bottom: 0;
  }
  
  .hp6-faq-answer-inner-{{ section_id }} a {
    color: {{ accent_color }};
    text-decoration: none;
    font-weight: 600;
    position: relative;
  }
  
  .hp6-faq-answer-inner-{{ section_id }} a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background: {{ accent_color }};
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }
  
  .hp6-faq-answer-inner-{{ section_id }} a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* Abstract background elements */
  .hp6-faq-bg-grid-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 50px 50px;
    z-index: 1;
    pointer-events: none;
    transform: skewY(-5deg) scale(1.2);
    transform-origin: center;
  }
  
  @media (max-width: 768px) {
    .hp6-faq-header-{{ section_id }} h2 {
      font-size: 2.5rem;
    }
    .hp6-faq-question-{{ section_id }} {
      padding: 20px;
      font-size: 1.1rem;
    }
    .hp6-faq-answer-inner-{{ section_id }} {
      padding: 0 20px 20px 20px;
    }
    #shopify-section-{{ section_id }} {
      padding: 60px 0;
    }
  }
</style>

<div class="hp6-faq-bg-grid-{{ section_id }}"></div>

<div class="hp6-faq-container-{{ section_id }}">
  <div class="hp6-faq-header-{{ section_id }}">
    <h2>{{ heading }}</h2>
    {% if subtext != blank %}
      <p>{{ subtext }}</p>
    {% endif %}
  </div>
  
  <div class="hp6-faq-wrapper-{{ section_id }}">
    {% for block in section.blocks %}
      <div class="hp6-faq-item-{{ section_id }} {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }}>
        <button class="hp6-faq-question-{{ section_id }}" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
          {{ block.settings.title }}
          <span class="hp6-faq-icon-{{ section_id }}"></span>
        </button>
        <div class="hp6-faq-answer-{{ section_id }}">
          <div class="hp6-faq-answer-inner-{{ section_id }}">
            {{ block.settings.answer }}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqItems = document.querySelectorAll('.hp6-faq-item-{{ section_id }}');
    
    faqItems.forEach(item => {
      const button = item.querySelector('.hp6-faq-question-{{ section_id }}');
      
      button.addEventListener('click', () => {
        const isActive = item.classList.contains('active');
        
        // Close all items (Accordion style)
        faqItems.forEach(otherItem => {
          otherItem.classList.remove('active');
          otherItem.querySelector('.hp6-faq-question-{{ section_id }}').setAttribute('aria-expanded', 'false');
        });
        
        // Open clicked item if it wasn't already active
        if (!isActive) {
          item.classList.add('active');
          button.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP6 FAQ Accordion",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ffcc"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "KNOWLEDGE BASE"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Everything you need to know about our gear."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "What is the return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We offer a 30-day wear-test guarantee. If our gear doesn't perform to your standards, send it back for a full refund, no questions asked.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP6 FAQ Accordion",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
