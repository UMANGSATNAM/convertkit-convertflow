{%- style -%}#shopify-section-{{ section.id }}{background:#fff;padding:50px 24px}.hp90-faq{max-width:760px;margin:0 auto}.hp90-faq h2{text-align:center;font-size:26px;font-weight:800;margin:0 0 16px}.hp90-faq details{border:1px solid rgba(0,0,0,.08);border-radius:10px;padding:14px;margin-bottom:10px}{%- endstyle -%}<div class="hp90-faq"><h2>{{section.settings.heading|default:'FAQs v90'}}</h2>{% for block in section.blocks %}<details><summary style="font-weight:700;cursor:pointer">{{block.settings.q}}</summary><p style="opacity:.7">{{block.settings.a}}</p></details>{% else %}<details><summary>Delivery time?</summary><p style="opacity:.7">3-5 days.</p></details>{% endfor %}</div>{% schema %}
{
  "name": "HP90 FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQs v90"
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "QA",
      "settings": [
        {
          "type": "text",
          "id": "q",
          "label": "Q",
          "default": "What is delivery?"
        },
        {
          "type": "textarea",
          "id": "a",
          "label": "A",
          "default": "3-5 days"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP90 FAQ"
    }
  ]
}
{% endschema %}