{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FEF3C7' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp59-faq__container { max-width: {{ section.settings.container_width | default: 800 }}px; margin: 0 auto; padding: 0 24px; }
  .hp59-faq__header { text-align: center; margin-bottom: 50px; }
  .hp59-faq__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#F97316' }}; margin: 0 0 12px; }
  .hp59-faq__heading { font-family: 'Cormorant Garamond', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #042F2E; margin: 0; }
  .hp59-faq__item {
    background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border: 1px solid rgba(249, 115, 22, 0.2);
    border-radius: 16px; margin-bottom: 14px; overflow: hidden;
    box-shadow: 0 2px 10px rgba(249, 115, 22, 0.05);
    transition: border-color 0.3s ease;
  }
  .hp59-faq__item.active { border-color: #F97316; }
  .hp59-faq__question {
    width: 100%; background: none; border: none; padding: 20px 24px;
    display: flex; justify-content: space-between; align-items: center; cursor: pointer;
    font-family: 'Cormorant Garamond', serif; font-size: 18px; font-weight: 700; color: #042F2E; text-align: left;
  }
  .hp59-faq__icon { font-size: 20px; color: {{ section.settings.accent_color | default: '#F97316' }}; transition: transform 0.3s ease; flex-shrink: 0; margin-left: 16px; }
  .hp59-faq__item.active .hp59-faq__icon { transform: rotate(45deg); }
  .hp59-faq__answer { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .hp59-faq__item.active .hp59-faq__answer { max-height: 300px; }
  .hp59-faq__answer-inner { padding: 0 24px 20px; font-size: 14px; line-height: 1.7; color: #475569; }
{%- endstyle -%}
<div class="hp59-faq__container">
  <div class="hp59-faq__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp59-faq__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp59-faq__heading">{{ section.settings.heading | default: 'Marine Science Inquiries' }}</h2>
  </div>
  {%- for block in section.blocks -%}
    <div class="hp59-faq__item" {{ block.shopify_attributes }}>
      <button class="hp59-faq__question" onclick="this.parentElement.classList.toggle('active')">
        <span>{{ block.settings.question | default: 'What gives the oil its intense coral-red color?' }}</span>
        <span class="hp59-faq__icon">+</span>
      </button>
      <div class="hp59-faq__answer">
        <div class="hp59-faq__answer-inner">{{ block.settings.answer | default: 'The vivid coral tint comes directly from 100% natural, unbleached micro-algal astaxanthin, giving your skin an immediate golden glow without synthetic dyes.' }}</div>
      </div>
    </div>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "HP59 FAQ",
  "class": "section-hp59-faq",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FEF3C7" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#F97316" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🪸 FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Marine Science Inquiries" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1000, "step": 20, "unit": "px", "label": "Container Width", "default": 800 }
  ],
  "blocks": [{
    "type": "faq", "name": "Question",
    "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "What gives the oil its coral color?" },
      { "type": "textarea", "id": "answer", "label": "Answer", "default": "The vivid coral tint comes directly from natural micro-algal astaxanthin." }
    ]
  }],
  "presets": [{
    "name": "HP59 FAQ",
    "blocks": [
      { "type": "faq" },
      { "type": "faq", "settings": { "question": "Is the formula reef-safe and sustainable?", "answer": "100%. Our marine algae is cultured in closed-loop sustainable biospheres without disrupting wild ocean reefs." } },
      { "type": "faq", "settings": { "question": "Will the red oil stain pillows or clothing?", "answer": "No. The high bio-affinity lipids absorb fully into the dermal stratum corneum within 2 minutes of gentle massage." } }
    ]
  }]
}
{% endschema %}
