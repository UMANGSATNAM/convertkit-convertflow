{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --gold-color: {{ section.settings.gold_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Montserrat', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .hp33-faq-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp33-faq-wrapper {
      padding: 0 20px;
    }
  }

  .hp33-faq__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .hp33-faq__subtitle {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--gold-color);
    text-transform: uppercase;
    letter-spacing: 4px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }

  .hp33-faq__subtitle::before,
  .hp33-faq__subtitle::after {
    content: '';
    height: 1px;
    width: 30px;
    background: var(--gold-color);
  }

  .hp33-faq__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0;
    font-weight: 400;
  }

  .hp33-faq__list {
    border-top: 1px solid rgba(212, 175, 55, 0.4);
  }

  .hp33-faq__item {
    border-bottom: 1px solid rgba(212, 175, 55, 0.4);
  }

  .hp33-faq__question {
    width: 100%;
    background: transparent;
    border: none;
    padding: 30px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    text-align: left;
    color: var(--text-color);
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 400;
    transition: color 0.3s ease;
  }

  .hp33-faq__question:hover {
    color: var(--gold-color);
  }

  .hp33-faq__icon {
    width: 20px;
    height: 20px;
    position: relative;
    flex-shrink: 0;
    margin-left: 20px;
  }

  .hp33-faq__icon::before,
  .hp33-faq__icon::after {
    content: '';
    position: absolute;
    background: var(--gold-color);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: transform 0.4s ease;
  }

  .hp33-faq__icon::before {
    width: 100%;
    height: 1px;
  }

  .hp33-faq__icon::after {
    height: 100%;
    width: 1px;
  }

  .hp33-faq__item.is-active .hp33-faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .hp33-faq__item.is-active .hp33-faq__question {
    color: var(--gold-color);
  }

  .hp33-faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s ease-in-out;
  }

  .hp33-faq__answer-inner {
    padding: 0 0 30px 0;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-color);
    font-weight: 300;
    opacity: 0.8;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp33-faq-wrapper" id="HP33Faq-{{ section.id }}">
  <div class="hp33-faq__header">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp33-faq__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    <h2 class="hp33-faq__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp33-faq__list">
    {%- for block in section.blocks -%}
      <div class="hp33-faq__item" {{ block.shopify_attributes }}>
        <button class="hp33-faq__question" onclick="this.parentElement.classList.toggle('is-active'); const ans = this.nextElementSibling; if(this.parentElement.classList.contains('is-active')){ans.style.maxHeight = ans.scrollHeight + 'px';} else {ans.style.maxHeight = '0px';}">
          {{ block.settings.question }}
          <span class="hp33-faq__icon"></span>
        </button>
        <div class="hp33-faq__answer">
          <div class="hp33-faq__answer-inner">
            {{ block.settings.answer }}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Optionally open the first FAQ
    const firstItem = document.querySelector('#HP33Faq-{{ section.id }} .hp33-faq__item');
    if(firstItem) {
      firstItem.classList.add('is-active');
      const ans = firstItem.querySelector('.hp33-faq__answer');
      ans.style.maxHeight = ans.scrollHeight + 'px';
    }
  });
</script>

{% schema %}
{
  "name": "HP33 - Deco FAQ",
  "class": "section-hp33-faq",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "INQUIRIES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Patron Services"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Deco Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Deep Emerald)",
      "default": "#0e1a14"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold Accent",
      "default": "#d4af37"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Do you offer bespoke commissions?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes, our master artisans are available for a limited number of bespoke commissions each year. Please contact our conciergerie for a private consultation.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP33 - Deco FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "What is your return policy for fine items?", "answer": "<p>We accept returns of pristine, unworn pieces within 14 days of receipt, provided all original packaging and certificates of authenticity are intact.</p>" } },
        { "type": "faq", "settings": { "question": "How should I care for my acquisition?", "answer": "<p>Each piece is accompanied by a detailed care guide. Generally, avoid exposure to harsh chemicals and store in the provided velvet-lined case when not in use.</p>" } }
      ]
    }
  ]
}
{% endschema %}
