{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Syncopate:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Syncopate', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp27-faq-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    gap: 80px;
    align-items: flex-start;
  }

  @media screen and (max-width: 992px) {
    .hp27-faq-wrapper {
      flex-direction: column;
      gap: 40px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp27-faq-wrapper {
      padding: 0 20px;
    }
  }

  .hp27-faq__sidebar {
    flex: 0 0 350px;
    position: sticky;
    top: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp27-faq__sidebar {
      flex: none;
      width: 100%;
      position: static;
    }
  }

  .hp27-faq__label {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bg-color);
    background: var(--text-color);
    padding: 4px 8px;
    margin-bottom: 20px;
  }

  .hp27-faq__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 20px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp27-faq__text {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0 0 30px;
  }

  .hp27-faq__link {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-color);
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .hp27-faq__link:hover {
    opacity: 0.7;
  }
  
  .hp27-faq__link svg {
    width: 14px; height: 14px;
    margin-left: 8px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .hp27-faq__accordion {
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hp27-faq__item {
    background: #111;
    border: 1px solid rgba(226, 226, 226, 0.1);
    transition: all 0.3s ease;
  }

  .hp27-faq__item.is-open {
    border-color: var(--accent-color);
    background: rgba(255, 42, 42, 0.02);
  }

  .hp27-faq__question {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 20px 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-color);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  @media screen and (max-width: 768px) {
    .hp27-faq__question {
      padding: 15px 20px;
    }
  }

  .hp27-faq__icon {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-color);
    opacity: 0.8;
  }

  .hp27-faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp27-faq__answer-inner {
    padding: 0 25px 25px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.7;
  }

  @media screen and (max-width: 768px) {
    .hp27-faq__answer-inner {
      padding: 0 20px 20px;
    }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp27-faq-wrapper" id="HP27FAQ-{{ section.id }}">
  
  <div class="hp27-faq__sidebar">
    {%- if section.settings.label != blank -%}
      <div class="hp27-faq__label">{{ section.settings.label }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="hp27-faq__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="hp27-faq__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.link_text != blank -%}
      <a href="{{ section.settings.link_url | default: '#' }}" class="hp27-faq__link">
        {{ section.settings.link_text }}
        <svg viewBox="0 0 24 24"><path d="M5 12H19M19 12L12 5M19 12L12 19"/></svg>
      </a>
    {%- endif -%}
  </div>

  <div class="hp27-faq__accordion">
    {%- for block in section.blocks -%}
      <div class="hp27-faq__item" {{ block.shopify_attributes }}>
        <button class="hp27-faq__question" aria-expanded="false">
          {{ block.settings.question }}
          <span class="hp27-faq__icon">[ + ]</span>
        </button>
        <div class="hp27-faq__answer">
          <div class="hp27-faq__answer-inner">
            {{ block.settings.answer }}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqContainer = document.querySelector('#HP27FAQ-{{ section.id }}');
    if(!faqContainer) return;

    const questions = faqContainer.querySelectorAll('.hp27-faq__question');

    questions.forEach(btn => {
      btn.addEventListener('click', function() {
        const item = this.closest('.hp27-faq__item');
        const answer = item.querySelector('.hp27-faq__answer');
        const icon = this.querySelector('.hp27-faq__icon');
        const isOpen = item.classList.contains('is-open');

        // Close all others
        faqContainer.querySelectorAll('.hp27-faq__item').forEach(otherItem => {
          if(otherItem !== item) {
            otherItem.classList.remove('is-open');
            otherItem.querySelector('.hp27-faq__question').setAttribute('aria-expanded', 'false');
            otherItem.querySelector('.hp27-faq__answer').style.maxHeight = null;
            otherItem.querySelector('.hp27-faq__icon').textContent = '[ + ]';
          }
        });

        // Toggle current
        if(isOpen) {
          item.classList.remove('is-open');
          this.setAttribute('aria-expanded', 'false');
          answer.style.maxHeight = null;
          icon.textContent = '[ + ]';
        } else {
          item.classList.add('is-open');
          this.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + "px";
          icon.textContent = '[ - ]';
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP27 - Eng FAQ",
  "class": "section-hp27-faq",
  "settings": [
    {
      "type": "header",
      "content": "Sidebar Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small Label",
      "default": "SYSTEM.QUERY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "KNOWLEDGE BASE"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Access detailed technical specifications, warranty information, and integration protocols."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "CONTACT SUPPORT"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Dark Engineered Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#E2E2E2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF2A2A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "WHAT IS THE OPERATING TEMPERATURE RANGE?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>All systems are rated for continuous operation between -40°C and 85°C with passive cooling enabled.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP27 - Eng FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "ARE MODULES HOT-SWAPPABLE?" } },
        { "type": "faq", "settings": { "question": "WHAT IS THE WARRANTY PERIOD?" } },
        { "type": "faq", "settings": { "question": "DO YOU OFFER ENTERPRISE LICENSING?" } }
      ]
    }
  ]
}
{% endschema %}
