{% schema %}
{
  "name": "FAQ Accordion (Beauty)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Are your products cruelty-free?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Yes, all our products are 100% cruelty-free and leaping bunny certified."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion (Beauty)",
      "category": "FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "Are they suitable for sensitive skin?", "answer": "Absolutely. We use clean, non-irritating ingredients." } },
        { "type": "faq", "settings": { "question": "What is the shelf life?", "answer": "12 months after opening." } }
      ]
    }
  ]
}
{% endschema %}

<div class="faq-accordion faq-accordion--beauty" style="max-width: 800px; margin: 0 auto; padding: 4rem 2rem;">
  <h2 style="font-family: var(--font-heading-family); color: var(--color-text); text-align: center; margin-bottom: 3rem;">{{ section.settings.heading }}</h2>
  
  <div class="faq-accordion__list" style="border-top: 1px solid rgba(var(--color-text-rgb), 0.1);">
    {% for block in section.blocks %}
      <details class="faq-accordion__item" style="border-bottom: 1px solid rgba(var(--color-text-rgb), 0.1);" {{ block.shopify_attributes }}>
        <summary style="padding: 1.5rem 0; font-family: var(--font-body-family); font-weight: 600; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; color: var(--color-text);">
          {{ block.settings.question }}
          <span class="faq-accordion__icon" style="font-size: 1.5rem; transition: transform 0.3s ease;">+</span>
        </summary>
        <div class="faq-accordion__content" style="padding-bottom: 1.5rem; font-family: var(--font-body-family); color: var(--color-text); opacity: 0.8; line-height: 1.6;">
          {{ block.settings.answer }}
        </div>
      </details>
    {% endfor %}
  </div>
</div>

<style>
details[open] summary .faq-accordion__icon {
  transform: rotate(45deg);
}
</style>
