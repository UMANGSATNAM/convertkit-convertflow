{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp47-faq-bg: {{ section.settings.bg_color | default: '#F5F0EB' }};
    
    background-color: var(--hp47-faq-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp47-faq__wrap {
    max-width: {{ section.settings.container_width | default: 860 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp47-faq__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .hp47-faq__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 4.5vw, 42px);
    font-weight: 600;
    color: #382E2B;
    margin: 0 0 8px;
  }

  .hp47-faq__item {
    background: #FAF7F2;
    border: 1px solid #EAE3DA;
    border-radius: 20px;
    padding: 24px 28px;
    margin-bottom: 16px;
    box-shadow: 0 4px 16px rgba(56, 46, 43, 0.03);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp47-faq__item:hover { border-color: #8C6D58; }

  .hp47-faq__q {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #382E2B;
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp47-faq__a {
    font-size: 14px;
    line-height: 1.7;
    color: #6E5E58;
    margin: 14px 0 0;
    padding-top: 14px;
    border-top: 1px solid #EAE3DA;
  }
{%- endstyle -%}

<div class="hp47-faq__wrap">
  <div class="hp47-faq__header">
    <h2 class="hp47-faq__heading">{{ section.settings.heading | default: 'Linen & Oat Knowledge Base' }}</h2>
    <p style="font-size:14px; color:#6E5E58;">{{ section.settings.subheading | default: 'Clear answers regarding Scandinavian harvesting, sensitive skin safety, and global delivery.' }}</p>
  </div>

  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="hp47-faq__item" {{ block.shopify_attributes }}>
        <h3 class="hp47-faq__q">
          <span>{{ block.settings.question }}</span>
          <span>+</span>
        </h3>
        <p class="hp47-faq__a">{{ block.settings.answer }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="hp47-faq__item">
      <h3 class="hp47-faq__q"><span>How do fermented oat lipids benefit sensitive skin?</span><span>+</span></h3>
      <p class="hp47-faq__a">Fermentation breaks down whole oat lipids into micro-ceramides and beta-glucans that integrate instantly into human skin layers without clogging pores.</p>
    </div>
    <div class="hp47-faq__item">
      <h3 class="hp47-faq__q"><span>Are international import duties included at checkout?</span><span>+</span></h3>
      <p class="hp47-faq__a">Yes, all international tariffs and customs taxes are calculated and 100% pre-paid at checkout, ensuring zero unexpected border fees.</p>
    </div>
    <div class="hp47-faq__item">
      <h3 class="hp47-faq__q"><span>Is the packaging eco-certified and recyclable?</span><span>+</span></h3>
      <p class="hp47-faq__a">Yes, all containers are made of heavyweight European cosmetic glass with FSC-certified Nordic wooden caps, packed in biodegradable unbleached linen boxes.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP47 - Taupe FAQ",
  "class": "section-hp47-faq",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F0EB" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Linen & Oat Knowledge Base" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Clear answers regarding Scandinavian harvesting, sensitive skin safety, and global delivery." },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 860 }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do fermented oat lipids benefit sensitive skin?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Fermentation breaks down whole oat lipids into micro-ceramides." }
      ]
    }
  ],
  "presets": [
    { "name": "HP47 - Taupe FAQ" }
  ]
}
{% endschema %}
