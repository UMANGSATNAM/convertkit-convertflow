{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Lato', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp31-faq-wrapper {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp31-faq-wrapper {
      padding: 0 20px;
    }
  }

  .hp31-faq__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .hp31-faq__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, {{ section.settings.title_size }}px);
    line-height: 1.2;
    color: var(--text-color);
    margin: 0;
    font-weight: 400;
  }
  
  .hp31-faq__title em {
    font-style: italic;
  }

  .hp31-faq__item {
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }

  .hp31-faq__item:first-child {
    border-top: 1px solid rgba(0,0,0,0.08);
  }

  .hp31-faq__question {
    width: 100%;
    background: transparent;
    border: none;
    padding: 24px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    color: var(--text-color);
    text-align: left;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .hp31-faq__question:hover {
    opacity: 0.7;
  }

  .hp31-faq__icon {
    width: 20px;
    height: 20px;
    position: relative;
    flex-shrink: 0;
    margin-left: 20px;
  }

  .hp31-faq__icon::before,
  .hp31-faq__icon::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    background: var(--text-color);
    transition: transform 0.4s ease;
  }

  .hp31-faq__icon::before {
    width: 12px;
    height: 1px;
  }

  .hp31-faq__icon::after {
    width: 1px;
    height: 12px;
  }

  .hp31-faq__item.is-active .hp31-faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .hp31-faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, opacity 0.4s ease;
    opacity: 0;
  }

  .hp31-faq__item.is-active .hp31-faq__answer {
    opacity: 1;
  }

  .hp31-faq__answer-inner {
    padding-bottom: 30px;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    font-weight: 300;
    color: var(--text-color);
    opacity: 0.8;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp31-faq-wrapper" id="HP31FAQ-{{ section.id }}">
  <div class="hp31-faq__header">
    <h2 class="hp31-faq__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp31-faq__accordion">
    {%- for block in section.blocks -%}
      <div class="hp31-faq__item" {{ block.shopify_attributes }}>
        <button class="hp31-faq__question" aria-expanded="false">
          {{ block.settings.question }}
          <span class="hp31-faq__icon"></span>
        </button>
        <div class="hp31-faq__answer">
          <div class="hp31-faq__answer-inner">
            {{ block.settings.answer }}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqItems = document.querySelectorAll('#HP31FAQ-{{ section.id }} .hp31-faq__item');
    
    faqItems.forEach(item => {
      const btn = item.querySelector('.hp31-faq__question');
      const answer = item.querySelector('.hp31-faq__answer');
      
      btn.addEventListener('click', () => {
        const isActive = item.classList.contains('is-active');
        
        faqItems.forEach(faq => {
          faq.classList.remove('is-active');
          faq.querySelector('.hp31-faq__question').setAttribute('aria-expanded', 'false');
          faq.querySelector('.hp31-faq__answer').style.maxHeight = null;
        });

        if (!isActive) {
          item.classList.add('is-active');
          btn.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + "px";
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP31 - Zen FAQ",
  "class": "section-hp31-faq",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Common <em>Inquiries</em>"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 42
    },
    {
      "type": "header",
      "content": "Zen Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Beige)",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#2C2C2C"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your shipping policy?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "We offer complimentary standard shipping on all orders over $150. Pieces are thoughtfully packaged and dispatched within 2 business days."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP31 - Zen FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "Do you accept returns?", "answer": "Yes, we accept returns within 30 days of receipt, provided the items are unused and in their original packaging." } },
        { "type": "faq", "settings": { "question": "Where are your products sourced?", "answer": "We work closely with artisans and mindful manufacturers globally to ensure every piece is created ethically and sustainably." } }
      ]
    }
  ]
}
{% endschema %}
