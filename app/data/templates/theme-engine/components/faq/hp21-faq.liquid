{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: {{ section.settings.border_color }};
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Jost', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp21-faq-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    gap: 80px;
  }

  @media screen and (max-width: 992px) {
    .hp21-faq-wrapper {
      flex-direction: column;
      gap: 40px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp21-faq-wrapper {
      padding: 0 20px;
    }
  }

  .hp21-faq__info {
    flex: 1;
    position: sticky;
    top: 40px;
    align-self: flex-start;
  }

  @media screen and (max-width: 992px) {
    .hp21-faq__info {
      position: static;
      text-align: center;
    }
  }

  .hp21-faq__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 300;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 4px;
    margin: 0 0 16px;
  }

  .hp21-faq__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0 0 24px;
    line-height: 1.2;
  }
  
  .hp21-faq__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp21-faq__desc {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    color: var(--text-color);
    opacity: 0.8;
    line-height: 1.6;
    margin: 0 0 32px;
  }

  .hp21-faq__contact-btn {
    display: inline-block;
    padding: 16px 40px;
    border: 1px solid var(--accent-color);
    color: var(--text-color);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 300;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.4s ease;
  }

  .hp21-faq__contact-btn:hover {
    background: var(--accent-color);
    color: #000;
  }

  .hp21-faq__accordion {
    flex: 1.5;
  }

  .hp21-faq__item {
    border-bottom: 1px solid var(--border-color);
  }

  .hp21-faq__item:first-child {
    border-top: 1px solid var(--border-color);
  }

  .hp21-faq__question {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 32px 0;
    font-family: var(--font-heading);
    font-size: {{ section.settings.question_size }}px;
    font-weight: 400;
    color: var(--text-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .hp21-faq__question:hover {
    color: var(--accent-color);
  }

  .hp21-faq__icon {
    width: 20px;
    height: 20px;
    position: relative;
    flex-shrink: 0;
    margin-left: 20px;
  }

  .hp21-faq__icon::before,
  .hp21-faq__icon::after {
    content: '';
    position: absolute;
    background: var(--accent-color);
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    transition: transform 0.4s ease;
  }

  .hp21-faq__icon::before {
    width: 100%;
    height: 1px;
  }

  .hp21-faq__icon::after {
    width: 1px;
    height: 100%;
  }

  .hp21-faq__item.is-active .hp21-faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .hp21-faq__item.is-active .hp21-faq__question {
    color: var(--accent-color);
  }

  .hp21-faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp21-faq__answer-inner {
    padding-bottom: 32px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.8;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp21-faq-wrapper" id="HP21Faq-{{ section.id }}">
  
  <div class="hp21-faq__info">
    {%- if section.settings.subtitle != blank -%}
      <p class="hp21-faq__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
    
    {%- if section.settings.title != blank -%}
      <h2 class="hp21-faq__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    
    {%- if section.settings.text != blank -%}
      <p class="hp21-faq__desc">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.btn_text != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp21-faq__contact-btn">
        {{ section.settings.btn_text | escape }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp21-faq__accordion">
    {%- for block in section.blocks -%}
      <div class="hp21-faq__item" {{ block.shopify_attributes }}>
        <button class="hp21-faq__question" aria-expanded="false" onclick="toggleFaq(this)">
          {{ block.settings.question | escape }}
          <span class="hp21-faq__icon"></span>
        </button>
        <div class="hp21-faq__answer">
          <div class="hp21-faq__answer-inner">
            {{ block.settings.answer }}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

</div>

<script>
  function toggleFaq(btn) {
    const item = btn.closest('.hp21-faq__item');
    const answer = btn.nextElementSibling;
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    
    // Optional: Close others (accordion style)
    // document.querySelectorAll('.hp21-faq__item').forEach(i => {
    //   i.classList.remove('is-active');
    //   i.querySelector('.hp21-faq__question').setAttribute('aria-expanded', 'false');
    //   i.querySelector('.hp21-faq__answer').style.maxHeight = null;
    // });

    if (!isExpanded) {
      item.classList.add('is-active');
      btn.setAttribute('aria-expanded', 'true');
      answer.style.maxHeight = answer.scrollHeight + "px";
    } else {
      item.classList.remove('is-active');
      btn.setAttribute('aria-expanded', 'false');
      answer.style.maxHeight = null;
    }
  }
</script>

{% schema %}
{
  "name": "HP21 - Luxury FAQ",
  "class": "section-hp21-faq",
  "settings": [
    {
      "type": "header",
      "content": "Info Area"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "KNOWLEDGE"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>Frequently Asked <em>Questions</em></p>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover the details behind our craftsmanship, materials, and exceptional service."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "CONTACT CONCIERGE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 12
    },
    {
      "type": "range",
      "id": "question_size",
      "min": 16,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Question Size",
      "default": 24
    },
    {
      "type": "header",
      "content": "Luxury Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "rgba(255, 255, 255, 0.1)"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is the expected delivery time?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Each piece is handled with the utmost care. Standard delivery requires 3-5 business days, while expedited concierge delivery is available upon request.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP21 - Luxury FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
