{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp29-faq-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    gap: 80px;
  }

  @media screen and (max-width: 992px) {
    .hp29-faq-wrapper {
      flex-direction: column;
      gap: 40px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp29-faq-wrapper {
      padding: 0 20px;
    }
  }

  .hp29-faq__header-col {
    flex: 1;
    max-width: 400px;
  }

  .hp29-faq__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    line-height: 1.2;
    color: var(--text-color);
    margin: 0 0 20px;
  }

  .hp29-faq__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp29-faq__subtitle {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0;
  }

  .hp29-faq__accordion-col {
    flex: 2;
  }

  .hp29-faq__item {
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }

  .hp29-faq__item:first-child {
    border-top: 1px solid rgba(0,0,0,0.1);
  }

  .hp29-faq__question {
    width: 100%;
    background: transparent;
    border: none;
    padding: 25px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 400;
    color: var(--text-color);
    text-align: left;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .hp29-faq__question:hover {
    color: var(--accent-color);
  }

  .hp29-faq__icon {
    width: 24px;
    height: 24px;
    position: relative;
    flex-shrink: 0;
    margin-left: 20px;
    color: var(--text-color);
    opacity: 0.5;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .hp29-faq__icon::before,
  .hp29-faq__icon::after {
    content: '';
    position: absolute;
    background-color: currentColor;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
  }

  .hp29-faq__icon::before {
    width: 14px;
    height: 1px;
  }

  .hp29-faq__icon::after {
    width: 1px;
    height: 14px;
    transition: transform 0.3s ease;
  }

  .hp29-faq__item.is-active .hp29-faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .hp29-faq__item.is-active .hp29-faq__icon {
    opacity: 1;
    color: var(--accent-color);
    transform: rotate(90deg);
  }

  .hp29-faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hp29-faq__answer-inner {
    padding: 0 0 25px 0;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.8;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp29-faq-wrapper" id="HP29FAQ-{{ section.id }}">
  <div class="hp29-faq__header-col">
    {%- if section.settings.title != blank -%}
      <h2 class="hp29-faq__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="hp29-faq__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  <div class="hp29-faq__accordion-col">
    {%- for block in section.blocks -%}
      <div class="hp29-faq__item" {{ block.shopify_attributes }}>
        <button class="hp29-faq__question" aria-expanded="false">
          {{ block.settings.question }}
          <span class="hp29-faq__icon"></span>
        </button>
        <div class="hp29-faq__answer">
          <div class="hp29-faq__answer-inner">
            {{ block.settings.answer }}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqItems = document.querySelectorAll('#HP29FAQ-{{ section.id }} .hp29-faq__item');
    
    faqItems.forEach(item => {
      const btn = item.querySelector('.hp29-faq__question');
      const answer = item.querySelector('.hp29-faq__answer');
      
      btn.addEventListener('click', () => {
        const isActive = item.classList.contains('is-active');
        
        // Close all
        faqItems.forEach(faq => {
          faq.classList.remove('is-active');
          faq.querySelector('.hp29-faq__question').setAttribute('aria-expanded', 'false');
          faq.querySelector('.hp29-faq__answer').style.maxHeight = null;
        });

        // Open current if it wasn't active
        if (!isActive) {
          item.classList.add('is-active');
          btn.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + "px";
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP29 - Boho FAQ",
  "class": "section-hp29-faq",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Curious <em>Minds</em>"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everything you need to know about our sourcing, materials, and care."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Earthy Boho Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Beige)",
      "default": "#F4F1DE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#3D405B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (Terracotta)",
      "default": "#E07A5F"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Where are your materials sourced?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We source our organic fibers from small-scale farmers who prioritize regenerative agriculture practices.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP29 - Boho FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "How should I care for my pieces?", "answer": "<p>Wash on cold with a gentle, eco-friendly detergent and lay flat to dry. This ensures longevity and minimizes environmental impact.</p>" } },
        { "type": "faq", "settings": { "question": "Do you offer international shipping?", "answer": "<p>Yes, we ship globally using carbon-neutral logistics partners.</p>" } }
      ]
    }
  ]
}
{% endschema %}
