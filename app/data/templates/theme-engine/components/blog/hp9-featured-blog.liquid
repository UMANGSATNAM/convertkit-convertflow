{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0a0a0d'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ff88'
  assign blog = blogs[section.settings.blog]
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
  }
  
  .hp9-blog-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp9-blog-header-{{ section_id }} {
    margin-bottom: 50px;
    border-left: 4px solid {{ accent_color }};
    padding-left: 20px;
  }
  
  .hp9-blog-title-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 1rem;
    font-weight: 700;
    color: {{ accent_color }};
    margin: 0 0 10px 0;
    letter-spacing: 2px;
  }
  
  .hp9-blog-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -1px;
  }
  
  .hp9-blog-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  
  .hp9-blog-card-{{ section_id }} {
    background: #111;
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }
  
  .hp9-blog-card-{{ section_id }}:hover {
    border-color: rgba(0, 255, 136, 0.3);
    transform: translateY(-5px);
  }
  
  .hp9-blog-image-wrapper-{{ section_id }} {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #1a1a1a;
  }
  
  .hp9-blog-image-wrapper-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: all 0.5s ease;
  }
  
  .hp9-blog-card-{{ section_id }}:hover .hp9-blog-image-wrapper-{{ section_id }} img {
    filter: grayscale(0%);
    transform: scale(1.05);
  }
  
  .hp9-blog-content-{{ section_id }} {
    padding: 30px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .hp9-blog-meta-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.5);
    margin-bottom: 15px;
    display: flex;
    justify-content: space-between;
  }
  
  .hp9-blog-article-title-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 15px 0;
    color: #fff;
  }
  
  .hp9-blog-excerpt-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.6);
    margin: 0 0 25px 0;
    flex: 1;
  }
  
  .hp9-blog-readmore-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 0.85rem;
    color: {{ accent_color }};
    font-weight: 700;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  
  .hp9-blog-readmore-{{ section_id }} svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
    transition: transform 0.3s ease;
  }
  
  .hp9-blog-card-{{ section_id }}:hover .hp9-blog-readmore-{{ section_id }} svg {
    transform: translateX(5px);
  }

  @media (max-width: 992px) {
    .hp9-blog-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    .hp9-blog-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="hp9-blog-container-{{ section_id }}">
  <div class="hp9-blog-header-{{ section_id }}">
    <p class="hp9-blog-title-{{ section_id }}">{{ section.settings.subheading | default: '/// DEV_LOGS' }}</p>
    <h2 class="hp9-blog-heading-{{ section_id }}">{{ section.settings.heading | default: 'SYSTEM UPDATES' }}</h2>
  </div>
  
  <div class="hp9-blog-grid-{{ section_id }}">
    {% if blog != blank and blog.articles_count > 0 %}
      {% for article in blog.articles limit: 3 %}
        <a href="{{ article.url }}" class="hp9-blog-card-{{ section_id }}">
          <div class="hp9-blog-image-wrapper-{{ section_id }}">
            {% if article.image %}
              <img height="{{ article.image.height }}" width="{{ article.image.width }}" src="{{ article.image | image_url: width: 600, height: 400, crop: 'center' }}" alt="{{ article.title }}" loading="lazy">
            {% else %}
              <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#333; font-family:'Space Mono', monospace;">NO_IMG_DATA</div>
            {% endif %}
          </div>
          <div class="hp9-blog-content-{{ section_id }}">
            <div class="hp9-blog-meta-{{ section_id }}">
              <span>DATE: {{ article.published_at | date: "%Y.%m.%d" }}</span>
              <span>AUTHOR: {{ article.author }}</span>
            </div>
            <h3 class="hp9-blog-article-title-{{ section_id }}">{{ article.title }}</h3>
            <div class="hp9-blog-excerpt-{{ section_id }}">
              {% if article.excerpt.size > 0 %}
                {{ article.excerpt | strip_html | truncatewords: 20 }}
              {% else %}
                {{ article.content | strip_html | truncatewords: 20 }}
              {% endif %}
            </div>
            <span class="hp9-blog-readmore-{{ section_id }}">READ_LOG <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg></span>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..3) %}
        <a href="#" class="hp9-blog-card-{{ section_id }}">
          <div class="hp9-blog-image-wrapper-{{ section_id }}">
            <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#333; font-family:'Space Mono', monospace;">NO_IMG_DATA</div>
          </div>
          <div class="hp9-blog-content-{{ section_id }}">
            <div class="hp9-blog-meta-{{ section_id }}">
              <span>DATE: 202X.XX.XX</span>
              <span>AUTHOR: SYS_ADMIN</span>
            </div>
            <h3 class="hp9-blog-article-title-{{ section_id }}">Architecture Optimization Protocol</h3>
            <div class="hp9-blog-excerpt-{{ section_id }}">Select a blog in the section settings to stream your latest articles into this module.</div>
            <span class="hp9-blog-readmore-{{ section_id }}">READ_LOG <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg></span>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP9 Featured Blog",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ff88"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "/// DEV_LOGS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SYSTEM UPDATES"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    }
  ],
  "presets": [
    {
      "name": "HP9 Featured Blog"
    }
  ]
}
{% endschema %}
