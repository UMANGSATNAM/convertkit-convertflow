{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#00FFA3'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 1px solid #333;
  }
  
  .hp13-blog-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp13-blog-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    border-bottom: 1px solid #333;
    padding-bottom: 20px;
  }
  
  .hp13-blog-heading-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    margin: 0;
    color: #FFF;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  
  .hp13-blog-heading-{{ section_id }} span {
    color: {{ text_color }};
  }
  
  .hp13-blog-view-all-{{ section_id }} {
    color: {{ text_color }};
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.85rem;
    font-weight: bold;
    text-transform: uppercase;
    text-decoration: none;
  }
  
  .hp13-blog-view-all-{{ section_id }}:hover {
    text-decoration: underline;
  }
  
  .hp13-blog-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  
  .hp13-blog-card-{{ section_id }} {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: #111;
    border: 1px solid #333;
    transition: all 0.2s ease;
  }
  
  .hp13-blog-card-{{ section_id }}:hover {
    border-color: {{ text_color }};
  }
  
  .hp13-blog-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 60%; 
    background: #000;
    border-bottom: 1px solid #333;
    overflow: hidden;
  }
  
  .hp13-blog-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
  }
  
  .hp13-blog-card-{{ section_id }}:hover .hp13-blog-image-{{ section_id }} {
    filter: grayscale(0%);
  }
  
  .hp13-blog-content-{{ section_id }} {
    padding: 25px;
    display: flex;
    flex-direction: column;
  }
  
  .hp13-blog-meta-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.75rem;
    color: {{ text_color }};
    margin-bottom: 10px;
  }
  
  .hp13-blog-title-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.1rem;
    font-weight: bold;
    color: #FFF;
    margin: 0;
    text-transform: uppercase;
    line-height: 1.4;
  }

  @media (max-width: 992px) {
    .hp13-blog-grid-{{ section_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp13-blog-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
  }
</style>

<div class="hp13-blog-container-{{ section_id }}">
  <div class="hp13-blog-header-{{ section_id }}">
    <h2 class="hp13-blog-heading-{{ section_id }}">TRANSMISSION <span>LOGS</span></h2>
    {% if section.settings.blog != blank %}
      <a href="{{ blogs[section.settings.blog].url }}" class="hp13-blog-view-all-{{ section_id }}">[ACCESS_ALL]</a>
    {% endif %}
  </div>
  
  <div class="hp13-blog-grid-{{ section_id }}">
    {% assign blog = blogs[section.settings.blog] %}
    {% if blog != blank and blog.articles_count > 0 %}
      {% for article in blog.articles limit: 3 %}
        <a href="{{ article.url }}" class="hp13-blog-card-{{ section_id }}">
          <div class="hp13-blog-image-wrap-{{ section_id }}">
            {% if article.image %}
              <img height="{{ article.image.height }}" width="{{ article.image.width }}" src="{{ article.image | image_url: width: 600 }}" class="hp13-blog-image-{{ section_id }}" loading="lazy" alt="{{ article.title }}">
            {% else %}
              <div class="hp13-blog-image-{{ section_id }}"></div>
            {% endif %}
          </div>
          <div class="hp13-blog-content-{{ section_id }}">
            <div class="hp13-blog-meta-{{ section_id }}">DATE: {{ article.published_at | date: "%Y.%m.%d" }}</div>
            <h3 class="hp13-blog-title-{{ section_id }}">{{ article.title }}</h3>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..3) %}
        <a href="#" class="hp13-blog-card-{{ section_id }}">
          <div class="hp13-blog-image-wrap-{{ section_id }}">
            <div class="hp13-blog-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
          </div>
          <div class="hp13-blog-content-{{ section_id }}">
            <div class="hp13-blog-meta-{{ section_id }}">DATE: 2025.10.24</div>
            <h3 class="hp13-blog-title-{{ section_id }}">SURVIVING THE NEON GRID: TACTICAL GUIDE</h3>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP13 Blog Posts",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Highlight Color",
      "default": "#00FFA3"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    }
  ],
  "presets": [
    {
      "name": "HP13 Blog Posts"
    }
  ]
}
{% endschema %}
