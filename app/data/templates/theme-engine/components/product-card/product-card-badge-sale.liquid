{% comment %}
  Product Card Badge Sale - High urgency sale card with discount pill, stock meter, and countdown
{% endcomment %}

<div class="product-card-sale" id="ProductCardSale-{{ section.id }}">
  <div class="sale-card-box">
    <div class="card-media">
      <div class="badge-stack">
        <span class="discount-badge">{{ section.settings.discount_badge | default: '-40% OFF' }}</span>
        <span class="hot-badge">{{ section.settings.status_badge | default: 'HOT DEAL' }}</span>
      </div>

      <a href="{{ section.settings.product_url | default: '#' }}" class="product-link">
        <img
          src="{{ section.settings.product_image | default: 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&auto=format&fit=crop&q=80' }}"
          alt="{{ section.settings.product_title | escape }}"
          loading="lazy"
          class="sale-img"
        />
      </a>

      <div class="timer-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>Ends in: <strong>03h 45m 12s</strong></span>
      </div>
    </div>

    <div class="card-info">
      <span class="vendor-tag">{{ section.settings.vendor_tag | default: 'Limited Edition' }}</span>
      
      <h3 class="sale-title">
        <a href="{{ section.settings.product_url | default: '#' }}">{{ section.settings.product_title | default: 'Studio Wireless Pro Noise Cancelling' }}</a>
      </h3>

      <div class="price-box">
        <span class="deal-price">{{ section.settings.sale_price | default: '$179.00' }}</span>
        <span class="orig-price">{{ section.settings.original_price | default: '$299.00' }}</span>
        <span class="save-tag">{{ section.settings.save_text | default: 'Save $120' }}</span>
      </div>

      <div class="stock-meter-wrap">
        <div class="meter-text">
          <span>⚡ Almost Sold Out</span>
          <span class="units-left">Only {{ section.settings.units_left | default: '7' }} left</span>
        </div>
        <div class="meter-track">
          <div class="meter-fill" style="width: {{ section.settings.claimed_percent | default: '82' }}%;"></div>
        </div>
      </div>

      <button type="button" class="claim-deal-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        {{ section.settings.btn_label | default: 'Claim Offer Now' }}
      </button>
    </div>
  </div>
</div>

<style>
  #ProductCardSale-{{ section.id }} {
    padding: {{ section.settings.padding_y | default: 24 }}px 16px;
    max-width: 380px;
    margin: 0 auto;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    box-sizing: border-box;
  }
  #ProductCardSale-{{ section.id }} * {
    box-sizing: border-box;
  }
  #ProductCardSale-{{ section.id }} .sale-card-box {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #fee2e2;
    box-shadow: 0 4px 16px -2px rgba(239, 68, 68, 0.08);
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  #ProductCardSale-{{ section.id }} .sale-card-box:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -8px rgba(239, 68, 68, 0.16);
  }
  #ProductCardSale-{{ section.id }} .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #f8fafc;
    overflow: hidden;
  }
  #ProductCardSale-{{ section.id }} .sale-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  #ProductCardSale-{{ section.id }} .sale-card-box:hover .sale-img {
    transform: scale(1.06);
  }
  #ProductCardSale-{{ section.id }} .badge-stack {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 2;
  }
  #ProductCardSale-{{ section.id }} .discount-badge {
    background: #ef4444;
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.03em;
  }
  #ProductCardSale-{{ section.id }} .hot-badge {
    background: #0f172a;
    color: #fef08a;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 6px;
    letter-spacing: 0.05em;
  }
  #ProductCardSale-{{ section.id }} .timer-badge {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 11px;
    padding: 6px 12px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  #ProductCardSale-{{ section.id }} .card-info {
    padding: 20px;
  }
  #ProductCardSale-{{ section.id }} .vendor-tag {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ef4444;
    display: block;
    margin-bottom: 6px;
  }
  #ProductCardSale-{{ section.id }} .sale-title {
    margin: 0 0 12px 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
  }
  #ProductCardSale-{{ section.id }} .sale-title a {
    color: #0f172a;
    text-decoration: none;
    transition: color 0.2s;
  }
  #ProductCardSale-{{ section.id }} .sale-title a:hover {
    color: #ef4444;
  }
  #ProductCardSale-{{ section.id }} .price-box {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  #ProductCardSale-{{ section.id }} .deal-price {
    font-size: 20px;
    font-weight: 800;
    color: #ef4444;
  }
  #ProductCardSale-{{ section.id }} .orig-price {
    font-size: 14px;
    color: #94a3b8;
    text-decoration: line-through;
  }
  #ProductCardSale-{{ section.id }} .save-tag {
    background: #fef2f2;
    color: #dc2626;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 9999px;
  }
  #ProductCardSale-{{ section.id }} .stock-meter-wrap {
    margin-bottom: 18px;
  }
  #ProductCardSale-{{ section.id }} .meter-text {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 600;
    color: #64748b;
    margin-bottom: 6px;
  }
  #ProductCardSale-{{ section.id }} .units-left {
    color: #ef4444;
    font-weight: 700;
  }
  #ProductCardSale-{{ section.id }} .meter-track {
    width: 100%;
    height: 6px;
    background: #f1f5f9;
    border-radius: 9999px;
    overflow: hidden;
  }
  #ProductCardSale-{{ section.id }} .meter-fill {
    height: 100%;
    background: linear-gradient(90deg, #f59e0b, #ef4444);
    border-radius: 9999px;
    transition: width 0.5s ease;
  }
  #ProductCardSale-{{ section.id }} .claim-deal-btn {
    width: 100%;
    background: #ef4444;
    color: #ffffff;
    border: none;
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  #ProductCardSale-{{ section.id }} .claim-deal-btn:hover {
    background: #dc2626;
    transform: translateY(-1px);
  }
</style>

{% schema %}
{
  "name": "Product Card Badge Sale",
  "settings": [
    {
      "type": "text",
      "id": "discount_badge",
      "label": "Discount Badge",
      "default": "-40% OFF"
    },
    {
      "type": "text",
      "id": "status_badge",
      "label": "Status Badge",
      "default": "HOT DEAL"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "vendor_tag",
      "label": "Vendor / Subtitle",
      "default": "Limited Edition"
    },
    {
      "type": "text",
      "id": "product_title",
      "label": "Product Title",
      "default": "Studio Wireless Pro Noise Cancelling"
    },
    {
      "type": "url",
      "id": "product_url",
      "label": "Product Link"
    },
    {
      "type": "text",
      "id": "sale_price",
      "label": "Sale Price",
      "default": "$179.00"
    },
    {
      "type": "text",
      "id": "original_price",
      "label": "Original Price",
      "default": "$299.00"
    },
    {
      "type": "text",
      "id": "save_text",
      "label": "Savings Tag",
      "default": "Save $120"
    },
    {
      "type": "text",
      "id": "units_left",
      "label": "Units Left",
      "default": "7"
    },
    {
      "type": "range",
      "id": "claimed_percent",
      "min": 10,
      "max": 95,
      "step": 1,
      "unit": "%",
      "label": "Claimed Percentage",
      "default": 82
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Claim Offer Now"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Card Vertical Padding",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Product Card Badge Sale"
    }
  ]
}
{% endschema %}
