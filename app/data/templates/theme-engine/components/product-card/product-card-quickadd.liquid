{% comment %}
  Product Card Quick Add - Secondary Hover Flip & Instant Size Selector
  Category: product-grid
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(36px, 6vw, 72px) 24px;
    font-family: inherit;
  }

  .cf-pcqa-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 990px) {
    .cf-pcqa-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .cf-pcqa-grid {
      grid-template-columns: 1fr;
    }
  }

  .cf-pcqa-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #0f172a;
    position: relative;
  }

  .cf-pcqa-media {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    background: #f1f5f9;
    aspect-ratio: 1 / 1.25;
    margin-bottom: 14px;
  }

  .cf-pcqa-img-main,
  .cf-pcqa-img-hover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
    transition: opacity 0.35s ease, transform 0.5s ease;
  }

  .cf-pcqa-img-hover {
    opacity: 0;
  }

  .cf-pcqa-card:hover .cf-pcqa-img-hover {
    opacity: 1;
    transform: scale(1.03);
  }

  .cf-pcqa-card:hover .cf-pcqa-img-main {
    transform: scale(1.03);
  }

  .cf-pcqa-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #0f172a;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 999px;
    z-index: 3;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .cf-pcqa-quick-drawer {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    padding: 12px;
    display: flex;
    justify-content: center;
    gap: 8px;
    transform: translateY(100%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 4;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .cf-pcqa-card:hover .cf-pcqa-quick-drawer {
    transform: translateY(0);
  }

  .cf-pcqa-size-btn {
    border: 1px solid #cbd5e1;
    background: #ffffff;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
  }

  .cf-pcqa-size-btn:hover {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  .cf-pcqa-title {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 6px 0;
  }

  .cf-pcqa-price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .cf-pcqa-price {
    font-size: 15px;
    font-weight: 800;
    color: #0f172a;
  }

  .cf-pcqa-comp {
    font-size: 13px;
    text-decoration: line-through;
    color: #94a3b8;
  }
{%- endstyle -%}

<div class="cf-pcqa-wrap">
  <div style="margin-bottom: 28px; text-align: center;">
    <h2 style="font-size: clamp(24px, 3.2vw, 36px); font-weight: 850; margin: 0 0 6px 0;">Trending Products</h2>
    <p style="color: #64748b; font-size: 14px; margin: 0;">Hover any product card to select your size and quick-add.</p>
  </div>

  <div class="cf-pcqa-grid">
    <!-- Card 1 -->
    <div class="cf-pcqa-card">
      <div class="cf-pcqa-media">
        <span class="cf-pcqa-badge">BESTSELLER</span>
        <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=500&q=80" alt="Heavyweight Tee" class="cf-pcqa-img-main" width="300" height="375">
        <img src="https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?w=500&q=80" alt="Heavyweight Tee Hover" class="cf-pcqa-img-hover" width="300" height="375">
        <div class="cf-pcqa-quick-drawer">
          <button type="button" class="cf-pcqa-size-btn" onclick="alert('Added Size S to Cart!')">S</button>
          <button type="button" class="cf-pcqa-size-btn" onclick="alert('Added Size M to Cart!')">M</button>
          <button type="button" class="cf-pcqa-size-btn" onclick="alert('Added Size L to Cart!')">L</button>
          <button type="button" class="cf-pcqa-size-btn" onclick="alert('Added Size XL to Cart!')">XL</button>
        </div>
      </div>
      <h3 class="cf-pcqa-title">Relaxed Heavyweight Tee</h3>
      <div class="cf-pcqa-price-row">
        <span class="cf-pcqa-price">$48.00</span>
        <span class="cf-pcqa-comp">$60.00</span>
      </div>
    </div>

    <!-- Card 2 -->
    <div class="cf-pcqa-card">
      <div class="cf-pcqa-media">
        <span class="cf-pcqa-badge" style="background:#dc2626;">SAVE 20%</span>
        <img src="https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=500&q=80" alt="Oversized Hoodie" class="cf-pcqa-img-main" width="300" height="375">
        <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=500&q=80" alt="Oversized Hoodie Hover" class="cf-pcqa-img-hover" width="300" height="375">
        <div class="cf-pcqa-quick-drawer">
          <button type="button" class="cf-pcqa-size-btn" onclick="alert('Added Size S to Cart!')">S</button>
          <button type="button" class="cf-pcqa-size-btn" onclick="alert('Added Size M to Cart!')">M</button>
          <button type="button" class="cf-pcqa-size-btn" onclick="alert('Added Size L to Cart!')">L</button>
        </div>
      </div>
      <h3 class="cf-pcqa-title">Vintage French Terry Hoodie</h3>
      <div class="cf-pcqa-price-row">
        <span class="cf-pcqa-price">$88.00</span>
        <span class="cf-pcqa-comp">$110.00</span>
      </div>
    </div>

    <!-- Card 3 -->
    <div class="cf-pcqa-card">
      <div class="cf-pcqa-media">
        <img src="https://images.unsplash.com/photo-1576995853123-5a10305d93c0?w=500&q=80" alt="Pleated Trouser" class="cf-pcqa-img-main" width="300" height="375">
        <img src="https://images.unsplash.com/photo-1473966968600-fa801b869a1a?w=500&q=80" alt="Pleated Trouser Hover" class="cf-pcqa-img-hover" width="300" height="375">
        <div class="cf-pcqa-quick-drawer">
          <button type="button" class="cf-pcqa-size-btn" onclick="alert('Added Size 30 to Cart!')">30</button>
          <button type="button" class="cf-pcqa-size-btn" onclick="alert('Added Size 32 to Cart!')">32</button>
          <button type="button" class="cf-pcqa-size-btn" onclick="alert('Added Size 34 to Cart!')">34</button>
        </div>
      </div>
      <h3 class="cf-pcqa-title">Relaxed Wool-Blend Trouser</h3>
      <div class="cf-pcqa-price-row">
        <span class="cf-pcqa-price">$120.00</span>
      </div>
    </div>

    <!-- Card 4 -->
    <div class="cf-pcqa-card">
      <div class="cf-pcqa-media">
        <span class="cf-pcqa-badge" style="background:#0f766e;">NEW IN</span>
        <img src="https://images.unsplash.com/photo-1543163521-1bf539c55dd2?w=500&q=80" alt="Leather Derby" class="cf-pcqa-img-main" width="300" height="375">
        <img src="https://images.unsplash.com/photo-1549298916-b41d501d3772?w=500&q=80" alt="Leather Derby Hover" class="cf-pcqa-img-hover" width="300" height="375">
        <div class="cf-pcqa-quick-drawer">
          <button type="button" class="cf-pcqa-size-btn" onclick="alert('Added Size 41 to Cart!')">41</button>
          <button type="button" class="cf-pcqa-size-btn" onclick="alert('Added Size 42 to Cart!')">42</button>
          <button type="button" class="cf-pcqa-size-btn" onclick="alert('Added Size 43 to Cart!')">43</button>
        </div>
      </div>
      <h3 class="cf-pcqa-title">Italian Calfskin Derby Shoe</h3>
      <div class="cf-pcqa-price-row">
        <span class="cf-pcqa-price">$220.00</span>
      </div>
    </div>
  </div>
</div>

