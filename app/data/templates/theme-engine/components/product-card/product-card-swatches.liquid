{% comment %}
  Product Card Swatches - Interactive Color Dots Switching Thumbnail
  Category: product-grid
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(36px, 6vw, 72px) 24px;
    font-family: inherit;
  }

  .cf-pcsw-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 990px) {
    .cf-pcsw-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .cf-pcsw-grid {
      grid-template-columns: 1fr;
    }
  }

  .cf-pcsw-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #0f172a;
  }

  .cf-pcsw-media {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    background: #f8fafc;
    aspect-ratio: 1 / 1.15;
    margin-bottom: 14px;
    border: 1px solid #f1f5f9;
  }

  .cf-pcsw-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .cf-pcsw-card:hover .cf-pcsw-img {
    transform: scale(1.03);
  }

  .cf-pcsw-dots {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .cf-pcsw-dot {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid #ffffff;
    box-shadow: 0 0 0 1px #cbd5e1;
    cursor: pointer;
    padding: 0;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .cf-pcsw-dot:hover,
  .cf-pcsw-dot.active {
    transform: scale(1.15);
    box-shadow: 0 0 0 2px #0f172a;
  }

  .cf-pcsw-title {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 4px 0;
  }

  .cf-pcsw-price {
    font-size: 15px;
    font-weight: 800;
    color: #0f172a;
  }
{%- endstyle -%}

<div class="cf-pcsw-wrap">
  <div style="margin-bottom: 28px; text-align: center;">
    <h2 style="font-size: clamp(24px, 3.2vw, 36px); font-weight: 850; margin: 0 0 6px 0;">Colorways &amp; Variations</h2>
    <p style="color: #64748b; font-size: 14px; margin: 0;">Click any color swatch to preview dynamic variant finishes.</p>
  </div>

  <div class="cf-pcsw-grid">
    <!-- Card 1 -->
    <div class="cf-pcsw-card" id="cf-sw-card-1">
      <div class="cf-pcsw-media">
        <img id="cf-sw-img-1" src="https://images.unsplash.com/photo-1546868871-7041f2a55e12?w=500&q=80" alt="Minimal Smartwatch" class="cf-pcsw-img" width="300" height="345">
      </div>
      <div class="cf-pcsw-dots">
        <button type="button" class="cf-pcsw-dot active" style="background:#0f172a;" onclick="document.getElementById('cf-sw-img-1').src='https://images.unsplash.com/photo-1546868871-7041f2a55e12?w=500&q=80'" aria-label="Black"></button>
        <button type="button" class="cf-pcsw-dot" style="background:#cbd5e1;" onclick="document.getElementById('cf-sw-img-1').src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&q=80'" aria-label="White"></button>
        <button type="button" class="cf-pcsw-dot" style="background:#eab308;" onclick="document.getElementById('cf-sw-img-1').src='https://images.unsplash.com/photo-1508057198894-247b23fe5ade?w=500&q=80'" aria-label="Gold"></button>
      </div>
      <h3 class="cf-pcsw-title">Titanium Series Watch</h3>
      <div class="cf-pcsw-price">$299.00</div>
    </div>

    <!-- Card 2 -->
    <div class="cf-pcsw-card" id="cf-sw-card-2">
      <div class="cf-pcsw-media">
        <img id="cf-sw-img-2" src="https://images.unsplash.com/photo-1572569511254-d8f925fe2cbb?w=500&q=80" alt="Earbuds" class="cf-pcsw-img" width="300" height="345">
      </div>
      <div class="cf-pcsw-dots">
        <button type="button" class="cf-pcsw-dot active" style="background:#1e293b;" onclick="document.getElementById('cf-sw-img-2').src='https://images.unsplash.com/photo-1572569511254-d8f925fe2cbb?w=500&q=80'" aria-label="Dark Slate"></button>
        <button type="button" class="cf-pcsw-dot" style="background:#f8fafc;" onclick="document.getElementById('cf-sw-img-2').src='https://images.unsplash.com/photo-1606220588913-b3aacb4d2f46?w=500&q=80'" aria-label="Pure White"></button>
      </div>
      <h3 class="cf-pcsw-title">True Wireless ANC Pods</h3>
      <div class="cf-pcsw-price">$149.00</div>
    </div>

    <!-- Card 3 -->
    <div class="cf-pcsw-card" id="cf-sw-card-3">
      <div class="cf-pcsw-media">
        <img id="cf-sw-img-3" src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500&q=80" alt="Headphones" class="cf-pcsw-img" width="300" height="345">
      </div>
      <div class="cf-pcsw-dots">
        <button type="button" class="cf-pcsw-dot active" style="background:#0f172a;" onclick="document.getElementById('cf-sw-img-3').src='https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500&q=80'" aria-label="Midnight"></button>
        <button type="button" class="cf-pcsw-dot" style="background:#0f766e;" onclick="document.getElementById('cf-sw-img-3').src='https://images.unsplash.com/photo-1545454675-3531b543be5d?w=500&q=80'" aria-label="Teal"></button>
      </div>
      <h3 class="cf-pcsw-title">Studio Reference Headphones</h3>
      <div class="cf-pcsw-price">$349.00</div>
    </div>

    <!-- Card 4 -->
    <div class="cf-pcsw-card" id="cf-sw-card-4">
      <div class="cf-pcsw-media">
        <img id="cf-sw-img-4" src="https://images.unsplash.com/photo-1608248597359-07f2a71f00a4?w=500&q=80" alt="Glass bottle" class="cf-pcsw-img" width="300" height="345">
      </div>
      <div class="cf-pcsw-dots">
        <button type="button" class="cf-pcsw-dot active" style="background:#e0e7ff;" onclick="document.getElementById('cf-sw-img-4').src='https://images.unsplash.com/photo-1608248597359-07f2a71f00a4?w=500&q=80'" aria-label="Clear"></button>
        <button type="button" class="cf-pcsw-dot" style="background:#d97706;" onclick="document.getElementById('cf-sw-img-4').src='https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=500&q=80'" aria-label="Amber"></button>
      </div>
      <h3 class="cf-pcsw-title">Botanical Facial Essence</h3>
      <div class="cf-pcsw-price">$62.00</div>
    </div>
  </div>
</div>

