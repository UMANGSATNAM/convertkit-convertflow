{% comment %}
  Product Card Minimal - Scandinavian minimalist boutique card with wishlist toggle and subtle quick buy
{% endcomment %}

<div class="product-card-minimal" id="ProductCardMinimal-{{ section.id }}">
  <div class="minimal-card">
    <div class="image-container">
      <a href="{{ section.settings.product_url | default: '#' }}" class="image-link">
        <img
          src="{{ section.settings.product_image | default: 'https://images.unsplash.com/photo-1544816155-12df9643f363?w=600&auto=format&fit=crop&q=80' }}"
          alt="{{ section.settings.product_title | escape }}"
          loading="lazy"
          class="product-thumb"
        />
      </a>
      
      <button type="button" class="wishlist-btn" aria-label="Add to Wishlist" onclick="this.classList.toggle('active')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      </button>

      <div class="quick-buy-overlay">
        <button type="button" class="quick-buy-btn">
          {{ section.settings.quick_buy_text | default: '+ Quick Add' }}
        </button>
      </div>
    </div>

    <div class="meta-container">
      <div class="top-meta">
        <span class="collection-title">{{ section.settings.collection_title | default: 'Ceramics' }}</span>
        <div class="color-options">
          <span class="color-circle" style="background-color: #d6cfc7;"></span>
          <span class="color-circle" style="background-color: #2b2b28;"></span>
          <span class="color-circle" style="background-color: #a89f91;"></span>
        </div>
      </div>

      <h4 class="item-title">
        <a href="{{ section.settings.product_url | default: '#' }}">{{ section.settings.product_title | default: 'Handcrafted Sand Glaze Vase' }}</a>
      </h4>

      <div class="price-container">
        <span class="price-amount">{{ section.settings.price | default: '$68.00' }}</span>
      </div>
    </div>
  </div>
</div>

<style>
  #ProductCardMinimal-{{ section.id }} {
    padding: {{ section.settings.padding_y | default: 24 }}px 16px;
    max-width: 360px;
    margin: 0 auto;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    box-sizing: border-box;
  }
  #ProductCardMinimal-{{ section.id }} * {
    box-sizing: border-box;
  }
  #ProductCardMinimal-{{ section.id }} .minimal-card {
    background: transparent;
    display: flex;
    flex-direction: column;
  }
  #ProductCardMinimal-{{ section.id }} .image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    background: #f4f4f4;
    border-radius: 12px;
    overflow: hidden;
  }
  #ProductCardMinimal-{{ section.id }} .product-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #ProductCardMinimal-{{ section.id }} .minimal-card:hover .product-thumb {
    transform: scale(1.04);
  }
  #ProductCardMinimal-{{ section.id }} .wishlist-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #475569;
    transition: all 0.2s ease;
    z-index: 2;
  }
  #ProductCardMinimal-{{ section.id }} .wishlist-btn:hover {
    color: #ef4444;
    transform: scale(1.1);
  }
  #ProductCardMinimal-{{ section.id }} .wishlist-btn.active {
    color: #ef4444;
  }
  #ProductCardMinimal-{{ section.id }} .wishlist-btn.active svg {
    fill: #ef4444;
  }
  #ProductCardMinimal-{{ section.id }} .quick-buy-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px;
    transform: translateY(100%);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 2;
  }
  #ProductCardMinimal-{{ section.id }} .minimal-card:hover .quick-buy-overlay {
    transform: translateY(0);
    opacity: 1;
  }
  #ProductCardMinimal-{{ section.id }} .quick-buy-btn {
    width: 100%;
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(8px);
    color: #ffffff;
    border: none;
    padding: 12px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  #ProductCardMinimal-{{ section.id }} .quick-buy-btn:hover {
    background: #000000;
  }
  #ProductCardMinimal-{{ section.id }} .meta-container {
    padding-top: 14px;
  }
  #ProductCardMinimal-{{ section.id }} .top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }
  #ProductCardMinimal-{{ section.id }} .collection-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
    font-weight: 600;
  }
  #ProductCardMinimal-{{ section.id }} .color-options {
    display: flex;
    gap: 4px;
  }
  #ProductCardMinimal-{{ section.id }} .color-circle {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  #ProductCardMinimal-{{ section.id }} .item-title {
    margin: 0 0 6px 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
  }
  #ProductCardMinimal-{{ section.id }} .item-title a {
    color: #0f172a;
    text-decoration: none;
    transition: color 0.2s;
  }
  #ProductCardMinimal-{{ section.id }} .item-title a:hover {
    color: #64748b;
  }
  #ProductCardMinimal-{{ section.id }} .price-container {
    font-size: 15px;
    font-weight: 600;
    color: #0f172a;
  }
</style>

{% schema %}
{
  "name": "Product Card Minimal",
  "settings": [
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "collection_title",
      "label": "Category / Collection Label",
      "default": "Ceramics"
    },
    {
      "type": "text",
      "id": "product_title",
      "label": "Product Title",
      "default": "Handcrafted Sand Glaze Vase"
    },
    {
      "type": "url",
      "id": "product_url",
      "label": "Product Link"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$68.00"
    },
    {
      "type": "text",
      "id": "quick_buy_text",
      "label": "Quick Buy Button Text",
      "default": "+ Quick Add"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Card Vertical Padding",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Product Card Minimal"
    }
  ]
}
{% endschema %}
