{% comment %}
  Product Card Trust - High-converting product card with ratings, reviews, and trust installment badges
{% endcomment %}

<div class="product-card-trust" id="ProductCardTrust-{{ section.id }}">
  <div class="card-inner">
    <div class="card-image-wrap">
      {% if section.settings.badge_text != blank %}
        <span class="trust-pill-tag">{{ section.settings.badge_text }}</span>
      {% endif %}
      <a href="{{ section.settings.product_url | default: '#' }}" class="img-link">
        <img
          src="{{ section.settings.product_image | default: 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop&q=80' }}"
          alt="{{ section.settings.product_title | escape }}"
          loading="lazy"
          class="main-img"
        />
      </a>
      <button type="button" class="quick-view-btn" aria-label="Quick View">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        Quick View
      </button>
    </div>

    <div class="card-content">
      <div class="rating-row">
        <div class="stars" aria-label="5 star rating">
          ★★★★★
        </div>
        <span class="rating-score">{{ section.settings.rating_score | default: '4.9' }}</span>
        <span class="review-count">({{ section.settings.review_count | default: '284' }})</span>
      </div>

      <h3 class="product-title">
        <a href="{{ section.settings.product_url | default: '#' }}">{{ section.settings.product_title | default: 'Chronograph Minimalist Watch' }}</a>
      </h3>

      <div class="price-row">
        <span class="current-price">{{ section.settings.price | default: '$149.00' }}</span>
        {% if section.settings.compare_at_price != blank %}
          <span class="compare-price">{{ section.settings.compare_at_price }}</span>
        {% endif %}
      </div>

      <div class="installment-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
        <span>{{ section.settings.installment_text | default: 'or 4 interest-free payments of $37.25' }}</span>
      </div>

      <div class="trust-footer">
        <span class="guarantee-text">{{ section.settings.guarantee_text | default: '⚡ Free 2-Day Shipping & 30-Day Returns' }}</span>
        <button type="button" class="add-to-cart-btn">
          {{ section.settings.btn_text | default: 'Add to Cart' }}
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  #ProductCardTrust-{{ section.id }} {
    padding: {{ section.settings.padding_y | default: 24 }}px 16px;
    max-width: 380px;
    margin: 0 auto;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  #ProductCardTrust-{{ section.id }} * {
    box-sizing: border-box;
  }
  #ProductCardTrust-{{ section.id }} .card-inner {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  #ProductCardTrust-{{ section.id }} .card-inner:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.08);
  }
  #ProductCardTrust-{{ section.id }} .card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #f8fafc;
    overflow: hidden;
  }
  #ProductCardTrust-{{ section.id }} .main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
    display: block;
  }
  #ProductCardTrust-{{ section.id }} .card-inner:hover .main-img {
    transform: scale(1.05);
  }
  #ProductCardTrust-{{ section.id }} .trust-pill-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #0f172a;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: 9999px;
    z-index: 2;
  }
  #ProductCardTrust-{{ section.id }} .quick-view-btn {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%) translateY(16px);
    opacity: 0;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    color: #0f172a;
    border: 1px solid #e2e8f0;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: all 0.25s ease;
    z-index: 2;
  }
  #ProductCardTrust-{{ section.id }} .card-inner:hover .quick-view-btn {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  #ProductCardTrust-{{ section.id }} .card-content {
    padding: 20px;
  }
  #ProductCardTrust-{{ section.id }} .rating-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }
  #ProductCardTrust-{{ section.id }} .stars {
    color: #f59e0b;
    font-size: 14px;
    letter-spacing: 1px;
  }
  #ProductCardTrust-{{ section.id }} .rating-score {
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
  }
  #ProductCardTrust-{{ section.id }} .review-count {
    font-size: 12px;
    color: #64748b;
  }
  #ProductCardTrust-{{ section.id }} .product-title {
    margin: 0 0 10px 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
  }
  #ProductCardTrust-{{ section.id }} .product-title a {
    color: #0f172a;
    text-decoration: none;
    transition: color 0.2s;
  }
  #ProductCardTrust-{{ section.id }} .product-title a:hover {
    color: #2563eb;
  }
  #ProductCardTrust-{{ section.id }} .price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 10px;
  }
  #ProductCardTrust-{{ section.id }} .current-price {
    font-size: 18px;
    font-weight: 700;
    color: #0f172a;
  }
  #ProductCardTrust-{{ section.id }} .compare-price {
    font-size: 14px;
    color: #94a3b8;
    text-decoration: line-through;
  }
  #ProductCardTrust-{{ section.id }} .installment-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #475569;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 6px 10px;
    border-radius: 6px;
    margin-bottom: 16px;
  }
  #ProductCardTrust-{{ section.id }} .trust-footer {
    border-top: 1px solid #f1f5f9;
    padding-top: 14px;
  }
  #ProductCardTrust-{{ section.id }} .guarantee-text {
    display: block;
    font-size: 11px;
    color: #10b981;
    font-weight: 600;
    margin-bottom: 12px;
  }
  #ProductCardTrust-{{ section.id }} .add-to-cart-btn {
    width: 100%;
    background: #0f172a;
    color: #ffffff;
    border: none;
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  #ProductCardTrust-{{ section.id }} .add-to-cart-btn:hover {
    background: #2563eb;
    transform: translateY(-1px);
  }
</style>

{% schema %}
{
  "name": "Product Card Trust",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "Best Seller"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "product_title",
      "label": "Product Title",
      "default": "Chronograph Minimalist Watch"
    },
    {
      "type": "url",
      "id": "product_url",
      "label": "Product Link"
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review Count",
      "default": "284"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Current Price",
      "default": "$149.00"
    },
    {
      "type": "text",
      "id": "compare_at_price",
      "label": "Compare Price (Optional)",
      "default": "$199.00"
    },
    {
      "type": "text",
      "id": "installment_text",
      "label": "Installment / EMI Text",
      "default": "or 4 interest-free payments of $37.25"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee Text",
      "default": "⚡ Free 2-Day Shipping & 30-Day Returns"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Add to Cart"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Card Vertical Padding",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Product Card Trust"
    }
  ]
}
{% endschema %}
