{% comment %}
  Offer Bento Grid - 3 Interactive Promotional Cards
  Category: offer
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding: clamp(40px, 6vw, 80px) 24px;
    max-width: 1280px;
    margin: 0 auto;
    font-family: inherit;
  }

  .cf-obento-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    grid-template-rows: auto auto;
    gap: 20px;
  }

  @media (max-width: 860px) {
    .cf-obento-grid {
      grid-template-columns: 1fr;
    }
  }

  .cf-obento-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    padding: 36px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: #ffffff;
    text-decoration: none;
    min-height: 260px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .cf-obento-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }

  .cf-obento-card-main {
    grid-row: span 2;
    min-height: 540px;
    background: #0f172a;
  }

  @media (max-width: 860px) {
    .cf-obento-card-main {
      grid-row: span 1;
      min-height: 380px;
    }
  }

  .cf-obento-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 0.6s ease;
  }

  .cf-obento-card:hover .cf-obento-bg {
    transform: scale(1.04);
  }

  .cf-obento-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.85) 100%);
    z-index: 2;
  }

  .cf-obento-content {
    position: relative;
    z-index: 3;
  }

  .cf-obento-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    background: #ef4444;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 12px;
    width: fit-content;
  }

  .cf-obento-title {
    font-size: clamp(24px, 3.5vw, 42px);
    font-weight: 850;
    line-height: 1.1;
    margin: 0 0 8px 0;
  }

  .cf-obento-sub {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 16px 0;
    max-width: 420px;
  }

  .cf-obento-link {
    font-size: 13px;
    font-weight: 800;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cf-obento-card-side1 {
    background: #064e3b;
  }

  .cf-obento-card-side2 {
    background: #1e1b4b;
  }
{%- endstyle -%}

<div class="cf-obento-grid">
  <!-- Card 1 (Main Big Card) -->
  <a href="{{ section.settings.link_1 | default: '/collections/all' }}" class="cf-obento-card cf-obento-card-main">
    <img
      src="{{ section.settings.image_1 | default: 'https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=900&q=80' }}"
      alt="Big promotion"
      class="cf-obento-bg"
      width="700"
      height="540"
    >
    <div class="cf-obento-gradient"></div>
    <div class="cf-obento-content">
      <span class="cf-obento-badge" style="background:#dc2626;">{{ section.settings.badge_1 | default: 'ANNUAL SALE' }}</span>
      <h3 class="cf-obento-title">{{ section.settings.title_1 | default: 'Up to 50% Off Outerwear & Knitwear' }}</h3>
      <p class="cf-obento-sub">{{ section.settings.sub_1 | default: 'Limited seasonal run. Use checkout code WINTER50.' }}</p>
      <span class="cf-obento-link">Shop The Sale &rarr;</span>
    </div>
  </a>

  <!-- Card 2 (Top Side Card) -->
  <a href="{{ section.settings.link_2 | default: '/collections/bogo' }}" class="cf-obento-card cf-obento-card-side1">
    <img
      src="{{ section.settings.image_2 | default: 'https://images.unsplash.com/photo-1512436991641-6745cdb1723f?w=600&q=80' }}"
      alt="BOGO promotion"
      class="cf-obento-bg"
      width="500"
      height="260"
    >
    <div class="cf-obento-gradient"></div>
    <div class="cf-obento-content">
      <span class="cf-obento-badge" style="background:#059669;">{{ section.settings.badge_2 | default: 'BUY 1 GET 1' }}</span>
      <h4 class="cf-obento-title" style="font-size:24px;">{{ section.settings.title_2 | default: 'BOGO on Organic Tees' }}</h4>
      <span class="cf-obento-link">Claim Deal &rarr;</span>
    </div>
  </a>

  <!-- Card 3 (Bottom Side Card) -->
  <a href="{{ section.settings.link_3 | default: '/collections/accessories' }}" class="cf-obento-card cf-obento-card-side2">
    <img
      src="{{ section.settings.image_3 | default: 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&q=80' }}"
      alt="Accessories promotion"
      class="cf-obento-bg"
      width="500"
      height="260"
    >
    <div class="cf-obento-gradient"></div>
    <div class="cf-obento-content">
      <span class="cf-obento-badge" style="background:#7c3aed;">{{ section.settings.badge_3 | default: 'FREE SHIPPING' }}</span>
      <h4 class="cf-obento-title" style="font-size:24px;">{{ section.settings.title_3 | default: 'Free Express Shipping Over $60' }}</h4>
      <span class="cf-obento-link">Explore Now &rarr;</span>
    </div>
  </a>
</div>

