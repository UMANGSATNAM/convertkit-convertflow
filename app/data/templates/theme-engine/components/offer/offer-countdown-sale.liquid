{% comment %}
  Offer Countdown Sale - Large Boxed Sale Module with Claim Meter
  Category: offer
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --cds-bg: {{ section.settings.bg_color | default: '#0f172a' }};
    --cds-text: {{ section.settings.text_color | default: '#ffffff' }};
    --cds-accent: {{ section.settings.accent_color | default: '#f59e0b' }};
    padding: clamp(40px, 7vw, 80px) 24px;
    font-family: inherit;
  }

  .cf-cds-box {
    max-width: 1100px;
    margin: 0 auto;
    background: var(--cds-bg);
    color: var(--cds-text);
    border-radius: 28px;
    padding: clamp(36px, 6vw, 64px) clamp(24px, 5vw, 56px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.3);
    flex-wrap: wrap;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cf-cds-left {
    max-width: 540px;
  }

  .cf-cds-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(245, 158, 11, 0.15);
    color: var(--cds-accent);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }

  .cf-cds-heading {
    font-size: clamp(28px, 4.2vw, 48px);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 14px 0;
  }

  .cf-cds-sub {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin: 0 0 24px 0;
  }

  .cf-cds-claim-meter {
    margin-top: 16px;
  }

  .cf-cds-meter-label {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 6px;
    color: #cbd5e1;
  }

  .cf-cds-meter-track {
    width: 100%;
    height: 8px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 99px;
    overflow: hidden;
  }

  .cf-cds-meter-bar {
    height: 100%;
    width: 82%;
    background: var(--cds-accent);
    border-radius: 99px;
  }

  .cf-cds-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 32px 36px;
  }

  .cf-cds-timer-boxes {
    display: flex;
    gap: 12px;
  }

  .cf-cds-time-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 60px;
    background: rgba(0, 0, 0, 0.35);
    border-radius: 12px;
    padding: 12px 6px;
  }

  .cf-cds-time-val {
    font-size: 26px;
    font-weight: 900;
    font-family: ui-monospace, monospace;
    color: #ffffff;
    line-height: 1;
  }

  .cf-cds-time-lbl {
    font-size: 10px;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 6px;
    font-weight: 700;
  }

  .cf-cds-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--cds-accent);
    color: #0f172a;
    font-size: 16px;
    font-weight: 800;
    padding: 16px 36px;
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.2s;
    width: 100%;
  }

  .cf-cds-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(245, 158, 11, 0.35);
  }
{%- endstyle -%}

<div class="cf-cds-box">
  <div class="cf-cds-left">
    <span class="cf-cds-pill">⚡ {{ section.settings.pill_text | default: 'MID-SEASON CLEARANCE' }}</span>
    <h2 class="cf-cds-heading">{{ section.settings.heading | default: 'Save Up to 40% On Selected Styles' }}</h2>
    <p class="cf-cds-sub">{{ section.settings.subheading | default: 'Our deepest markdown of the year. Once our limited warehouse allocation sells out, these price points disappear permanently.' }}</p>

    <div class="cf-cds-claim-meter">
      <div class="cf-cds-meter-label">
        <span>Deal Allocation Claimed</span>
        <span style="color:#f59e0b;">84% Claimed</span>
      </div>
      <div class="cf-cds-meter-track">
        <div class="cf-cds-meter-bar"></div>
      </div>
    </div>
  </div>

  <div class="cf-cds-right">
    <div style="font-size:12px;font-weight:800;letter-spacing:0.15em;text-transform:uppercase;color:#94a3b8;">ENDS IN</div>
    <div class="cf-cds-timer-boxes">
      <div class="cf-cds-time-unit">
        <span class="cf-cds-time-val">02</span>
        <span class="cf-cds-time-lbl">Days</span>
      </div>
      <div class="cf-cds-time-unit">
        <span class="cf-cds-time-val">14</span>
        <span class="cf-cds-time-lbl">Hours</span>
      </div>
      <div class="cf-cds-time-unit">
        <span class="cf-cds-time-val">38</span>
        <span class="cf-cds-time-lbl">Mins</span>
      </div>
      <div class="cf-cds-time-unit">
        <span class="cf-cds-time-val">45</span>
        <span class="cf-cds-time-lbl">Secs</span>
      </div>
    </div>
    <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="cf-cds-cta-btn">
      {{ section.settings.cta_label | default: 'Shop the Sale Now →' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Offer Countdown Sale",
  "tag": "section",
  "class": "cf-offer-countdown-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#f59e0b"
    },
    {
      "type": "text",
      "id": "pill_text",
      "label": "Urgency pill text",
      "default": "MID-SEASON CLEARANCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Save Up to 40% On Selected Styles"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our deepest markdown of the year. Once our limited warehouse allocation sells out, these price points disappear permanently."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop the Sale Now →"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Offer Countdown Sale"
    }
  ]
}
{% endschema %}
