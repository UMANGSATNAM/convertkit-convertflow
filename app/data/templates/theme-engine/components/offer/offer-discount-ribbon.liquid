{% comment %}
  Offer Discount Ribbon - High Urgency Interactive Banner
  Category: offer
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --rib-bg: {{ section.settings.bg_color | default: '#4338ca' }};
    --rib-text: {{ section.settings.text_color | default: '#ffffff' }};
    background: var(--rib-bg);
    color: var(--rib-text);
    padding: 16px 24px;
    font-family: inherit;
    position: relative;
    overflow: hidden;
  }

  .cf-ribbon-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .cf-ribbon-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cf-ribbon-spark {
    font-size: 20px;
  }

  .cf-ribbon-title {
    font-size: 15px;
    font-weight: 800;
    margin: 0;
  }

  .cf-ribbon-badge {
    background: #fbbf24;
    color: #1e1b4b;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
  }

  .cf-ribbon-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #ffffff;
    color: #4338ca;
    padding: 8px 18px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s, opacity 0.15s;
  }

  .cf-ribbon-cta:hover {
    transform: translateY(-1px);
    opacity: 0.95;
  }
{%- endstyle -%}

<div class="cf-ribbon-container">
  <div class="cf-ribbon-left">
    <span class="cf-ribbon-spark">⚡</span>
    <span class="cf-ribbon-badge">{{ section.settings.badge | default: 'TODAY ONLY' }}</span>
    <p class="cf-ribbon-title">{{ section.settings.text | default: 'Buy Any 2 Products, Get 1 Free with code B2G1FREE at checkout!' }}</p>
  </div>

  <a href="{{ section.settings.link_url | default: '/collections/all' }}" class="cf-ribbon-cta">
    <span>{{ section.settings.link_text | default: 'Shop Now' }}</span>
    <span>&rarr;</span>
  </a>
</div>

{% schema %}
{
  "name": "Offer Discount Ribbon",
  "tag": "section",
  "class": "cf-offer-ribbon-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#4338ca"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge text",
      "default": "TODAY ONLY"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Promotion message",
      "default": "Buy Any 2 Products, Get 1 Free with code B2G1FREE at checkout!"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Offer Discount Ribbon"
    }
  ]
}
{% endschema %}
