{% comment %}
  Offer Dual Poster - Side-by-side Split Campaign Posters
  Category: offer
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(32px, 6vw, 70px) 24px;
    font-family: inherit;
  }

  .cf-dual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  @media (max-width: 768px) {
    .cf-dual-grid {
      grid-template-columns: 1fr;
    }
  }

  .cf-dual-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(28px, 4vw, 48px);
    text-decoration: none;
    color: #ffffff;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
  }

  .cf-dual-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cf-dual-card:hover .cf-dual-img {
    transform: scale(1.04);
  }

  .cf-dual-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.8) 100%);
    z-index: 2;
  }

  .cf-dual-content {
    position: relative;
    z-index: 3;
  }

  .cf-dual-tag {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #38bdf8;
    margin-bottom: 8px;
    display: block;
  }

  .cf-dual-title {
    font-size: clamp(26px, 3.2vw, 40px);
    font-weight: 850;
    line-height: 1.1;
    margin: 0 0 16px 0;
  }

  .cf-dual-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    color: #0f172a;
    font-size: 14px;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 10px;
    transition: background-color 0.2s, transform 0.15s;
  }

  .cf-dual-card:hover .cf-dual-btn {
    background: #f1f5f9;
    transform: translateX(4px);
  }
{%- endstyle -%}

<div class="cf-dual-grid">
  <a href="{{ section.settings.link_1 | default: '/collections/men' }}" class="cf-dual-card">
    <img
      src="{{ section.settings.img_1 | default: 'https://images.unsplash.com/photo-1516257984-b1b4d707412e?w=800&q=80' }}"
      alt="Men Collection"
      class="cf-dual-img"
      width="600"
      height="750"
    >
    <div class="cf-dual-overlay"></div>
    <div class="cf-dual-content">
      <span class="cf-dual-tag">{{ section.settings.tag_1 | default: 'SPRING CAMPAIGN' }}</span>
      <h3 class="cf-dual-title">{{ section.settings.title_1 | default: 'Men’s Tailored Essentials' }}</h3>
      <span class="cf-dual-btn">Explore Collection &rarr;</span>
    </div>
  </a>

  <a href="{{ section.settings.link_2 | default: '/collections/women' }}" class="cf-dual-card">
    <img
      src="{{ section.settings.img_2 | default: 'https://images.unsplash.com/photo-1539109136881-3be0616acf4b?w=800&q=80' }}"
      alt="Women Collection"
      class="cf-dual-img"
      width="600"
      height="750"
    >
    <div class="cf-dual-overlay"></div>
    <div class="cf-dual-content">
      <span class="cf-dual-tag" style="color:#f472b6;">{{ section.settings.tag_2 | default: 'LIMITED CAPSULE' }}</span>
      <h3 class="cf-dual-title">{{ section.settings.title_2 | default: 'Women’s Silk & Linen Edit' }}</h3>
      <span class="cf-dual-btn">Explore Collection &rarr;</span>
    </div>
  </a>
</div>

{% schema %}
{
  "name": "Offer Dual Poster",
  "tag": "section",
  "class": "cf-offer-dual-poster-section",
  "settings": [
    {
      "type": "header",
      "content": "Poster Left"
    },
    {
      "type": "text",
      "id": "tag_1",
      "label": "Tag",
      "default": "SPRING CAMPAIGN"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Title",
      "default": "Men’s Tailored Essentials"
    },
    {
      "type": "text",
      "id": "img_1",
      "label": "Image URL",
      "default": "https://images.unsplash.com/photo-1516257984-b1b4d707412e?w=800&q=80"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Poster Right"
    },
    {
      "type": "text",
      "id": "tag_2",
      "label": "Tag",
      "default": "LIMITED CAPSULE"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Title",
      "default": "Women’s Silk & Linen Edit"
    },
    {
      "type": "text",
      "id": "img_2",
      "label": "Image URL",
      "default": "https://images.unsplash.com/photo-1539109136881-3be0616acf4b?w=800&q=80"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Offer Dual Poster"
    }
  ]
}
{% endschema %}
