{% comment %}
  Offer Coupon Strip - Click to Copy Coupon Code
  Category: offer
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --cpn-bg: {{ section.settings.bg_color | default: '#eff6ff' }};
    --cpn-border: {{ section.settings.border_color | default: '#93c5fd' }};
    --cpn-text: {{ section.settings.text_color | default: '#1e3a8a' }};
    padding: 24px;
    font-family: inherit;
  }

  .cf-coupon-wrap {
    max-width: 900px;
    margin: 0 auto;
    background: var(--cpn-bg);
    border: 2px dashed var(--cpn-border);
    border-radius: 20px;
    padding: 20px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    color: var(--cpn-text);
  }

  .cf-coupon-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .cf-coupon-icon {
    font-size: 36px;
    flex-shrink: 0;
  }

  .cf-coupon-headline {
    font-size: 18px;
    font-weight: 800;
    margin: 0 0 4px 0;
  }

  .cf-coupon-sub {
    font-size: 13px;
    opacity: 0.85;
    margin: 0;
  }

  .cf-coupon-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cf-coupon-box {
    background: #ffffff;
    border: 1px solid #bfdbfe;
    padding: 10px 18px;
    border-radius: 10px;
    font-family: ui-monospace, monospace;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #1d4ed8;
    user-select: all;
  }

  .cf-coupon-btn {
    background: #1d4ed8;
    color: #ffffff;
    border: none;
    padding: 12px 22px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
    white-space: nowrap;
  }

  .cf-coupon-btn:hover {
    background: #1e40af;
    transform: translateY(-1px);
  }

  .cf-coupon-btn:active {
    transform: scale(0.97);
  }
{%- endstyle -%}

<div class="cf-coupon-wrap">
  <div class="cf-coupon-left">
    <span class="cf-coupon-icon">🎁</span>
    <div>
      <h3 class="cf-coupon-headline">{{ section.settings.title | default: 'VIP Welcome Gift: Take 20% Off Your Order' }}</h3>
      <p class="cf-coupon-sub">{{ section.settings.subtext | default: 'Valid for new subscribers on full-price orders over $40.' }}</p>
    </div>
  </div>

  <div class="cf-coupon-right">
    <div class="cf-coupon-box">{{ section.settings.code | default: 'WELCOME20' }}</div>
    <button type="button" class="cf-coupon-btn" onclick="
      navigator.clipboard.writeText('{{ section.settings.code | default: 'WELCOME20' }}');
      var b = this;
      b.innerText = 'Copied! 🎉';
      setTimeout(function(){ b.innerText = 'Copy Code 📋'; }, 2000);
    ">
      Copy Code 📋
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Offer Coupon Strip",
  "tag": "section",
  "class": "cf-offer-coupon-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#eff6ff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Dashed border color",
      "default": "#93c5fd"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1e3a8a"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "VIP Welcome Gift: Take 20% Off Your Order"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Valid for new subscribers on full-price orders over $40."
    },
    {
      "type": "text",
      "id": "code",
      "label": "Coupon code",
      "default": "WELCOME20"
    }
  ],
  "presets": [
    {
      "name": "Offer Coupon Strip",
      "settings": {
        "code": "WELCOME20"
      }
    }
  ]
}
{% endschema %}
