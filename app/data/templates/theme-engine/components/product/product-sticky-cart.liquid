{% comment %}
  Dynamic Sticky Add-To-Cart Bar for Mobile & Desktop
{% endcomment %}
<div class="product-sticky-bar" style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 9999; background: #ffffff; border-top: 1px solid #e2e8f0; padding: 12px 20px; box-shadow: 0 -4px 20px rgba(0,0,0,0.08); display: flex; align-items: center; justify-content: space-between; gap: 16px;">
  <div style="display: flex; align-items: center; gap: 12px;">
    <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=100&q=80" style="width: 44px; height: 44px; border-radius: 8px; object-fit: cover;" />
    <div>
      <span style="display: block; font-size: 13px; font-weight: 800; color: #0f172a; max-width: 220px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
        {{ section.settings.title | default: product.title | default: 'PREMIUM ULTRA-FORMULA CLINICAL CARE' }}
      </span>
      <span style="font-size: 12px; font-weight: 700; color: #16a34a;">
        {{ section.settings.price | default: '$48.00' }} <span style="font-size: 11px; color: #94a3b8; text-decoration: line-through;">$75.00</span>
      </span>
    </div>
  </div>
  <div style="display: flex; align-items: center; gap: 10px;">
    <button style="padding: 10px 20px; background: #0f172a; color: #ffffff; border: 0; border-radius: 8px; font-size: 13px; font-weight: 800; cursor: pointer;">
      🛒 Quick Add — $48.00
    </button>
  </div>
</div>
