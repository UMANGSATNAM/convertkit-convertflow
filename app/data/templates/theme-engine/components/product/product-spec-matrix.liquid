{% comment %}
  Detailed Product Specifications & Clinical Proof Comparison Matrix
{% endcomment %}
<div style="padding: 60px 20px; max-width: 1280px; margin: 0 auto;">
  <h2 style="font-size: 28px; font-weight: 800; color: #0f172a; text-align: center; margin-bottom: 12px;">🔬 Clinical Benchmark & Specification Matrix</h2>
  <p style="font-size: 15px; color: #64748b; text-align: center; margin-bottom: 40px;">Rigorously tested in independent clinical trials against industry standard market formulas.</p>
  
  <div style="overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
      <thead>
        <tr style="background: #0f172a; color: #ffffff;">
          <th style="padding: 16px; border-radius: 8px 0 0 0;">Feature / Metric</th>
          <th style="padding: 16px; background: #2563eb; color: #ffffff; font-weight: 800;">Our Formula</th>
          <th style="padding: 16px; border-radius: 0 8px 0 0;">Standard Brands</th>
        </tr>
      </thead>
      <tbody>
        <tr style="border-bottom: 1px solid #e2e8f0; background: #ffffff;">
          <td style="padding: 14px 16px; font-weight: 700; color: #334155;">Bio-Active Purity Rating</td>
          <td style="padding: 14px 16px; background: #eff6ff; font-weight: 800; color: #1d4ed8;">99.8% Pure Concentration</td>
          <td style="padding: 14px 16px; color: #64748b;">40% - 60% Diluted</td>
        </tr>
        <tr style="border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
          <td style="padding: 14px 16px; font-weight: 700; color: #334155;">Clinical Absorption Speed</td>
          <td style="padding: 14px 16px; background: #eff6ff; font-weight: 800; color: #1d4ed8;">Instant (< 10 Seconds)</td>
          <td style="padding: 14px 16px; color: #64748b;">Slow (Greasy Residue)</td>
        </tr>
        <tr style="border-bottom: 1px solid #e2e8f0; background: #ffffff;">
          <td style="padding: 14px 16px; font-weight: 700; color: #334155;">Barrier Hydration Duration</td>
          <td style="padding: 14px 16px; background: #eff6ff; font-weight: 800; color: #1d4ed8;">24-Hour Sustained Release</td>
          <td style="padding: 14px 16px; color: #64748b;">4 - 6 Hours</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
