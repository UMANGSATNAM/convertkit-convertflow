{%- liquid
  assign bg_color = section.settings.bg_color | default: '#f9f6f0'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp4-hero-bg: {{ bg_color }};
    --hp4-hero-text: {{ text_color }};
    --hp4-hero-accent: {{ accent_color }};
    
    --hp4-hero-pt-desk: {{ padding_top_desktop }}px;
    --hp4-hero-pb-desk: {{ padding_bottom_desktop }}px;
    --hp4-hero-pt-mob: {{ padding_top_mobile }}px;
    --hp4-hero-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp4-decor-hero-{{ section.id }} {
    padding-top: var(--hp4-hero-pt-desk);
    padding-bottom: var(--hp4-hero-pb-desk);
    background-color: var(--hp4-hero-bg);
    color: var(--hp4-hero-text);
    font-family: 'Playfair Display', serif; /* Elegant Serif for headings */
    position: relative;
    overflow: hidden;
  }

  .hp4-hero-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 60px;
    position: relative;
    z-index: 2;
  }

  /* Reversed Layout */
  .hp4-hero-inner.layout-right {
    flex-direction: row-reverse;
  }

  /* Text Content */
  .hp4-hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 600px;
  }

  .hp4-hero-badge {
    display: inline-block;
    padding: 0 0 10px 0;
    color: var(--hp4-hero-text);
    font-family: 'Inter', sans-serif; /* Clean sans for small text */
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 3px;
    border-bottom: 1px solid var(--hp4-hero-accent);
    align-self: flex-start;
    margin-bottom: 30px;
  }

  .hp4-hero-title {
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 30px 0;
    color: var(--hp4-hero-text);
  }
  .hp4-hero-title em {
    font-style: italic;
    color: var(--hp4-hero-accent);
  }

  .hp4-hero-desc {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: rgba(44,44,44,0.7);
    margin-bottom: 40px;
    font-weight: 300;
  }
  .hp4-hero-desc p { margin: 0; }

  .hp4-hero-btn-group {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .hp4-hero-btn-primary {
    font-family: 'Inter', sans-serif;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background: var(--hp4-hero-text);
    color: var(--hp4-hero-bg);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.4s ease;
  }
  .hp4-hero-btn-primary:hover {
    background: var(--hp4-hero-accent);
    color: #fff;
  }

  .hp4-hero-btn-secondary {
    font-family: 'Inter', sans-serif;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 30px;
    background: transparent;
    color: var(--hp4-hero-text);
    border: 1px solid var(--hp4-hero-text);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.4s ease;
  }
  .hp4-hero-btn-secondary:hover {
    background: rgba(44,44,44,0.05);
  }

  /* Media Column (Arch Shape) */
  .hp4-hero-media-wrapper {
    flex: 1.2;
    position: relative;
    display: flex;
    justify-content: center;
  }

  .hp4-hero-media {
    width: 100%;
    max-width: 500px;
    aspect-ratio: 3/4;
    background: #e8e3d8;
    border-radius: 200px 200px 0 0; /* Elegant Arch */
    overflow: hidden;
    position: relative;
    box-shadow: 0 30px 60px rgba(0,0,0,0.05);
  }

  .hp4-hero-img, .hp4-hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.5s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .hp4-hero-media:hover .hp4-hero-img {
    transform: scale(1.05);
  }

  /* Floating Accent Image */
  .hp4-hero-floating {
    position: absolute;
    bottom: -30px;
    left: -40px;
    width: 200px;
    aspect-ratio: 1/1;
    border-radius: 50%;
    border: 10px solid var(--hp4-hero-bg);
    overflow: hidden;
    z-index: 3;
    background: #dcd7cb;
    box-shadow: 0 15px 30px rgba(0,0,0,0.08);
  }
  .hp4-hero-inner.layout-right .hp4-hero-floating {
    left: auto;
    right: -40px;
  }
  .hp4-hero-floating img {
    width: 100%; height: 100%;
    object-fit: cover;
  }

  /* Decorative Leaf SVG Background */
  .hp4-hero-decor {
    position: absolute;
    top: -50px;
    right: -100px;
    width: 400px;
    height: 400px;
    opacity: 0.05;
    z-index: 0;
    pointer-events: none;
    color: var(--hp4-hero-text);
  }
  .hp4-hero-inner.layout-right .hp4-hero-decor {
    right: auto;
    left: -100px;
    transform: scaleX(-1);
  }

  @media screen and (max-width: 1024px) {
    .hp4-hero-inner {
      flex-direction: column !important;
      gap: 60px;
      text-align: center;
    }
    .hp4-hero-content {
      align-items: center;
      max-width: 100%;
    }
    .hp4-hero-badge {
      align-self: center;
    }
    .hp4-hero-media {
      max-width: 400px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp4-decor-hero-{{ section.id }} {
      padding-top: var(--hp4-hero-pt-mob);
      padding-bottom: var(--hp4-hero-pb-mob);
    }
    .hp4-hero-inner {
      padding: 0 20px;
    }
    .hp4-hero-btn-group {
      flex-direction: column;
      width: 100%;
    }
    .hp4-hero-btn-primary, .hp4-hero-btn-secondary {
      width: 100%;
    }
    .hp4-hero-floating {
      width: 120px;
      bottom: -15px;
      left: -10px;
      border-width: 5px;
    }
    .hp4-hero-inner.layout-right .hp4-hero-floating {
      left: auto;
      right: -10px;
    }
  }
</style>

<section class="hp4-decor-hero-{{ section.id }}" aria-label="Hero">
  
  <svg class="hp4-hero-decor" viewBox="0 0 100 100" fill="currentColor">
    <path d="M50 0 C70 30, 90 40, 100 70 C80 100, 40 90, 0 80 C20 50, 30 20, 50 0 Z"></path>
  </svg>

  <div class="hp4-hero-inner layout-{{ section.settings.layout }}">
    
    <div class="hp4-hero-content">
      {%- if section.settings.badge != blank -%}
        <div class="hp4-hero-badge">{{ section.settings.badge }}</div>
      {%- endif -%}
      
      {%- if section.settings.heading != blank -%}
        <h1 class="hp4-hero-title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      
      {%- if section.settings.description != blank -%}
        <div class="hp4-hero-desc">{{ section.settings.description }}</div>
      {%- endif -%}

      <div class="hp4-hero-btn-group">
        {%- if section.settings.btn_1_text != blank and section.settings.btn_1_link != blank -%}
          <a href="{{ section.settings.btn_1_link }}" class="hp4-hero-btn-primary">{{ section.settings.btn_1_text }}</a>
        {%- endif -%}
        {%- if section.settings.btn_2_text != blank and section.settings.btn_2_link != blank -%}
          <a href="{{ section.settings.btn_2_link }}" class="hp4-hero-btn-secondary">{{ section.settings.btn_2_text }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="hp4-hero-media-wrapper">
      <div class="hp4-hero-media">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: class: 'hp4-hero-video', autoplay: true, loop: true, muted: true, playsinline: true }}
        {%- elsif section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1000 }}" 
               class="hp4-hero-img" 
               loading="lazy" 
               alt="Hero Background">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hp4-hero-img placeholder-svg' }}
        {%- endif -%}
      </div>
      
      {%- if section.settings.show_floating_image -%}
        <div class="hp4-hero-floating">
          {%- if section.settings.floating_image != blank -%}
            <img src="{{ section.settings.floating_image | image_url: width: 400 }}" loading="lazy" alt="Detail">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP4 Decor Hero",
  "tag": "section",
  "class": "section-hp4-hero",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (Overrides Image)"
    },
    {
      "type": "checkbox",
      "id": "show_floating_image",
      "label": "Show Floating Detail Image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "floating_image",
      "label": "Floating Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Media Position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "NEW COLLECTION 2024"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Curate Your <em>Sanctuary</em>",
      "info": "Use <em> for italicized accent word."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover thoughtfully designed pieces crafted to bring warmth, balance, and timeless elegance to your home.</p>"
    },
    {
      "type": "text",
      "id": "btn_1_text",
      "label": "Primary Button Text",
      "default": "SHOP THE COLLECTION"
    },
    {
      "type": "url",
      "id": "btn_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn_2_text",
      "label": "Secondary Button Text",
      "default": "VIEW LOOKBOOK"
    },
    {
      "type": "url",
      "id": "btn_2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f6f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8c7b66"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP4 Decor Hero (Adv)",
      "category": "Hero"
    }
  ]
}
{% endschema %}
