{% comment %}
  CF Hero Editorial - Rhode & Glossier Standard D2C Storytelling Hero
  Category: hero
  Version: 2.0 - 100% Self-Contained, Zero Snippet Dependency
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    position: relative;
    min-height: clamp(560px, 88vh, 840px);
    display: flex;
    align-items: center;
    background-color: {{ section.settings.bg_color | default: '#0c0a09' }};
    color: #ffffff;
    overflow: hidden;
    font-family: inherit;
    padding: clamp(60px, 8vw, 100px) 20px;
  }

  .cf-hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    filter: brightness(0.82) contrast(1.05);
    transition: transform 10s ease-out;
  }

  #shopify-section-{{ section.id }}:hover .cf-hero-media {
    transform: scale(1.03);
  }

  .cf-hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(12, 10, 9, 0.88) 0%, rgba(12, 10, 9, 0.6) 45%, rgba(12, 10, 9, 0.2) 100%);
    z-index: 2;
  }

  @media (max-width: 768px) {
    .cf-hero-gradient {
      background: linear-gradient(180deg, rgba(12, 10, 9, 0.4) 0%, rgba(12, 10, 9, 0.92) 80%);
    }
  }

  .cf-hero-container {
    position: relative;
    z-index: 3;
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
  }

  @media (max-width: 960px) {
    .cf-hero-container {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }

  .cf-hero-content {
    max-width: 640px;
  }

  @media (max-width: 960px) {
    .cf-hero-content {
      margin: 0 auto;
    }
  }

  /* Social proof badge */
  .cf-hero-proof-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 6px 16px;
    border-radius: 999px;
    margin-bottom: 24px;
  }

  .cf-hero-avatars {
    display: flex;
    align-items: center;
  }

  .cf-hero-avatar-img {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid #ffffff;
    margin-left: -8px;
    object-fit: cover;
  }

  .cf-hero-avatar-img:first-child {
    margin-left: 0;
  }

  .cf-hero-stars {
    color: #fbbf24;
    font-size: 13px;
    letter-spacing: 1px;
  }

  .cf-hero-proof-text {
    font-size: 12px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.02em;
  }

  .cf-hero-eyebrow {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#f59e0b' }};
    margin-bottom: 14px;
    display: block;
  }

  .cf-hero-headline {
    font-size: clamp(34px, 5.2vw, 64px);
    font-weight: 850;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 20px 0;
    color: #ffffff;
  }

  .cf-hero-subtext {
    font-size: clamp(15px, 1.8vw, 19px);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
    margin: 0 0 36px 0;
    font-weight: 400;
  }

  .cf-hero-ctas {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 960px) {
    .cf-hero-ctas {
      justify-content: center;
    }
  }

  .cf-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: {{ section.settings.accent_color | default: '#f59e0b' }};
    color: #0f172a;
    font-size: 15px;
    font-weight: 800;
    padding: 16px 36px;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
  }

  .cf-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.4);
    filter: brightness(1.05);
  }

  .cf-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    padding: 16px 28px;
    border-radius: 999px;
    text-decoration: none;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .cf-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: #ffffff;
  }

  /* Floating Editorial Quote Chip */
  .cf-hero-quote-chip {
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 24px;
    max-width: 380px;
    margin-left: auto;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 960px) {
    .cf-hero-quote-chip {
      margin: 20px auto 0 auto;
      text-align: left;
    }
  }

  .cf-hero-quote-source {
    font-family: 'Times New Roman', Times, serif;
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 8px;
    display: block;
  }

  .cf-hero-quote-text {
    font-size: 14px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    font-style: italic;
    margin: 0;
  }
{%- endstyle -%}

<!-- Background Hero Media -->
<img
  src="{{ section.settings.image | default: 'https://images.unsplash.com/photo-1556228720-195a672e8a03?w=1600&q=85' }}"
  alt="{{ section.settings.heading | escape }}"
  class="cf-hero-media"
  loading="eager"
  width="1600"
  height="900"
>
<div class="cf-hero-gradient"></div>

<div class="cf-hero-container">
  <div class="cf-hero-content">
    <!-- Above-The-Fold Social Proof Pill -->
    <div class="cf-hero-proof-pill">
      <div class="cf-hero-avatars">
        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=60&q=80" alt="Buyer" class="cf-hero-avatar-img">
        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=60&q=80" alt="Buyer" class="cf-hero-avatar-img">
        <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=60&q=80" alt="Buyer" class="cf-hero-avatar-img">
      </div>
      <span class="cf-hero-stars">★★★★★</span>
      <span class="cf-hero-proof-text">{{ section.settings.social_proof | default: '4.95★ by 14,200+ Buyers' }}</span>
    </div>

    <span class="cf-hero-eyebrow">{{ section.settings.eyebrow | default: 'CLINICAL GRADE FORMULATION' }}</span>
    <h1 class="cf-hero-headline">{{ section.settings.heading | default: 'Cellular Radiance Meets Cold-Pressed Botanicals.' }}</h1>
    <p class="cf-hero-subtext">
      {{ section.settings.subtext | default: 'Clinically proven to restore skin barrier hydration by 96% in 14 days. Zero synthetic fillers, zero compromises.' }}
    </p>

    <div class="cf-hero-ctas">
      <a href="{{ section.settings.button_link_1 | default: '#bundle-builder' }}" class="cf-btn-primary">
        <span>{{ section.settings.button_label_1 | default: 'Claim Routine Bundle — Save 20%' }}</span>
        <span>&rarr;</span>
      </a>
      {% if section.settings.button_label_2 != blank %}
        <a href="{{ section.settings.button_link_2 | default: '#proof' }}" class="cf-btn-secondary">
          {{ section.settings.button_label_2 | default: 'View 14-Day Proof ▷' }}
        </a>
      {% endif %}
    </div>
  </div>

  <!-- Floating Editorial Press Quote -->
  <div class="cf-hero-quote-chip">
    <span class="cf-hero-quote-source">{{ section.settings.press_outlet | default: 'VOGUE' }}</span>
    <p class="cf-hero-quote-text">
      "{{ section.settings.press_quote | default: 'The single most transformative botanical formula we tested all year. Results were visible within 48 hours.' }}"
    </p>
  </div>
</div>

{% schema %}
{
  "name": "CF Hero Editorial",
  "tag": "section",
  "class": "cf-hero-editorial-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0c0a09" },
    { "type": "color", "id": "accent_color", "label": "Accent / Button Color", "default": "#f59e0b" },
    { "type": "text", "id": "image", "label": "Hero Image URL", "default": "https://images.unsplash.com/photo-1556228720-195a672e8a03?w=1600&q=85" },
    { "type": "text", "id": "social_proof", "label": "Social Proof Pill Text", "default": "4.95★ by 14,200+ Buyers" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Tag", "default": "CLINICAL GRADE FORMULATION" },
    { "type": "text", "id": "heading", "label": "Hero Headline", "default": "Cellular Radiance Meets Cold-Pressed Botanicals." },
    { "type": "textarea", "id": "subtext", "label": "Subtext Description", "default": "Clinically proven to restore skin barrier hydration by 96% in 14 days. Zero synthetic fillers, zero compromises." },
    { "type": "text", "id": "button_label_1", "label": "Primary Button Text", "default": "Claim Routine Bundle — Save 20%" },
    { "type": "url", "id": "button_link_1", "label": "Primary Button Link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary Button Text", "default": "View 14-Day Proof ▷" },
    { "type": "url", "id": "button_link_2", "label": "Secondary Button Link" },
    { "type": "text", "id": "press_outlet", "label": "Press Outlet Name", "default": "VOGUE" },
    { "type": "textarea", "id": "press_quote", "label": "Press Quote Text", "default": "The single most transformative botanical formula we tested all year. Results were visible within 48 hours." }
  ],
  "presets": [
    {
      "name": "CF Hero Editorial"
    }
  ]
}
{% endschema %}
