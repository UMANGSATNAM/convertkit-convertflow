{%- style -%}
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@600;800&family=Inter:wght@400;500&display=swap');
#shopify-section-{{ section.id }}{background:#F0FDF4;padding:50px 0}
.hp100-wrap{max-width:1280px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
.hp100-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:18px 0}
.hp100-stat{background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:12px;padding:14px;text-align:center}
.hp100-stat b{font-family:'Manrope',sans-serif;font-size:20px;display:block}
.hp100-stat span{font-size:11px;letter-spacing:1px;text-transform:uppercase;opacity:.6}
.hp100-h{font-family:'Manrope',sans-serif;font-size:clamp(32px,4.5vw,52px);font-weight:800;line-height:1;margin:0}
.hp100-h span{color:#16A34A}
.hp100-btn{margin-top:18px;display:inline-block;padding:14px 26px;background:#16A34A;color:#fff;border-radius:10px;text-decoration:none;font-weight:700}
.hp100-media{border-radius:16px;overflow:hidden;height:520px;position:relative}
.hp100-media img{width:100%;height:100%;object-fit:cover}
.hp100-float{position:absolute;bottom:14px;left:14px;background:#fff;border-radius:12px;padding:12px 14px;display:flex;gap:10px;align-items:center;box-shadow:0 10px 30px rgba(0,0,0,.12)}
@media(max-width:900px){.hp100-wrap{grid-template-columns:1fr}.hp100-media{height:360px}}
{%- endstyle -%}
<div class="hp100-wrap">
  <div>
    <p style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#16A34A;font-weight:700;margin:0 0 8px">{{section.settings.badge|default:'GOURMET LAB v100'}}</p>
    <h1 class="hp100-h">{{section.settings.heading|default:'Measure <span>Every Rep</span>'}}</h1>
    <p style="opacity:.7;line-height:1.7;margin:10px 0">{{section.settings.description|default:'Artisan organic staples for honest kitchens'}}</p>
    <div class="hp100-stats"><div class="hp100-stat"><b>4.8★</b><span>50k reviews</span></div><div class="hp100-stat"><b>₹2500</b><span>from</span></div><div class="hp100-stat"><b>7d</b><span>returns</span></div></div>
    <a href="{{section.settings.btn_url|default:'/collections/all'}}" class="hp100-btn">{{section.settings.btn_text|default:'Shop GOURMET'}}</a>
  </div>
  <div class="hp100-media">{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:1000}}" alt="" loading="eager">{% else %}{{'collection-1'|placeholder_svg_tag}}{% endif %}<div class="hp100-float"><span style="width:38px;height:38px;border-radius:8px;background:#16A34A;display:grid;place-items:center;color:#fff">🌿</span><span><b>{{section.settings.float_title|default:'Lab Tested'}}</b><br><small style="opacity:.6">{{section.settings.float_sub|default:'Certified'}}</small></span></div></div>
</div>
{% schema %}{"name":"HP100 Hero Stats","settings":[{"type":"color","id":"bg_color","label":"BG","default":"#F0FDF4"},{"type":"text","id":"badge","label":"Badge","default":"GOURMET LAB v100"},{"type":"textarea","id":"heading","label":"Heading","default":"Measure Every Rep"},{"type":"textarea","id":"description","label":"Desc","default":"Artisan organic staples for honest kitchens"},{"type":"text","id":"btn_text","label":"CTA","default":"Shop GOURMET"},{"type":"url","id":"btn_url","label":"Link"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"float_title","label":"Float","default":"Lab Tested"},{"type":"text","id":"float_sub","label":"Sub","default":"Certified"}],"presets":[{"name":"HP100 Hero Stats"}]}{% endschema %}