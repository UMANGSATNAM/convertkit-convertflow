{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffe8d6'
  assign text_color = section.settings.text_color | default: '#6b705c'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 40px;
    color: {{ text_color }};
  }
  
  .hp14-hero-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 80px;
  }
  
  .hp14-hero-content-{{ section_id }} {
    flex: 1;
  }
  
  .hp14-hero-subheading-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 20px;
    color: #cb997e;
  }
  
  .hp14-hero-heading-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: normal;
    line-height: 1.1;
    margin: 0 0 30px 0;
    color: {{ text_color }};
  }
  
  .hp14-hero-heading-{{ section_id }} span {
    font-style: italic;
    color: #a5a58d;
  }
  
  .hp14-hero-text-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0 0 40px 0;
    max-width: 500px;
    color: #6b705c;
  }
  
  .hp14-hero-btn-{{ section_id }} {
    display: inline-block;
    padding: 16px 40px;
    background: #cb997e;
    color: #fff;
    text-decoration: none;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 50px;
    transition: background 0.3s ease;
  }
  
  .hp14-hero-btn-{{ section_id }}:hover {
    background: #b58368;
  }
  
  .hp14-hero-image-wrap-{{ section_id }} {
    flex: 1;
    position: relative;
    border-radius: 20px 20px 20px 200px;
    overflow: hidden;
    height: 700px;
  }
  
  .hp14-hero-image-{{ section_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 992px) {
    .hp14-hero-container-{{ section_id }} {
      flex-direction: column;
      gap: 40px;
      text-align: center;
    }
    .hp14-hero-text-{{ section_id }} {
      margin-left: auto;
      margin-right: auto;
    }
    .hp14-hero-image-wrap-{{ section_id }} {
      width: 100%;
      height: 500px;
      border-radius: 20px;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 40px 20px;
    }
  }
</style>

<div class="hp14-hero-container-{{ section_id }}">
  <div class="hp14-hero-content-{{ section_id }}">
    <div class="hp14-hero-subheading-{{ section_id }}">{{ section.settings.subheading | default: 'Pure & Organic' }}</div>
    <h1 class="hp14-hero-heading-{{ section_id }}">
      {{ section.settings.heading | default: 'Nourish your skin <span>naturally.</span>' }}
    </h1>
    <p class="hp14-hero-text-{{ section_id }}">
      {{ section.settings.text | default: 'Discover our new botanical collection crafted from earth-sourced ingredients for a radiant, healthy glow.' }}
    </p>
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hp14-hero-btn-{{ section_id }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
  <div class="hp14-hero-image-wrap-{{ section_id }}">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 1200 }}" class="hp14-hero-image-{{ section_id }}" alt="Hero Image">
    {% else %}
      <div class="hp14-hero-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP14 Hero",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffe8d6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6b705c"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pure & Organic"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nourish your skin <span>naturally.</span>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover our new botanical collection crafted from earth-sourced ingredients for a radiant, healthy glow."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "HP14 Hero"
    }
  ]
}
{% endschema %}
