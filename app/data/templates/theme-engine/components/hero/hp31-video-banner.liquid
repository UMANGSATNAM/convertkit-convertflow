{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Lato', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp31-video-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp31-video-wrapper {
      padding: 0 20px;
    }
  }

  .hp31-video__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp31-video__tagline {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-color);
    margin-bottom: 16px;
    display: block;
    opacity: 0.6;
  }

  .hp31-video__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, {{ section.settings.title_size }}px);
    line-height: 1.2;
    color: var(--text-color);
    margin: 0;
    font-weight: 400;
  }
  
  .hp31-video__title em {
    font-style: italic;
  }

  .hp31-video__container {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 24px;
    overflow: hidden;
    background: #E8E2D6;
  }

  @media screen and (max-width: 768px) {
    .hp31-video__container {
      aspect-ratio: 4/5;
    }
  }

  .hp31-video__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 10s ease;
  }

  .hp31-video__container:hover .hp31-video__media {
    transform: scale(1.05);
  }

  .hp31-video__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.5s ease;
  }

  .hp31-video__container:hover .hp31-video__overlay {
    background: rgba(0,0,0,0.1);
  }

  .hp31-video__play-btn {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.6);
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.5s ease;
  }

  .hp31-video__play-btn:hover {
    background: rgba(255,255,255,0.9);
    border-color: #fff;
    transform: scale(1.05);
  }

  .hp31-video__play-icon {
    width: 0;
    height: 0;
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
    border-left: 14px solid #fff;
    margin-left: 4px;
    transition: border-color 0.5s ease;
  }

  .hp31-video__play-btn:hover .hp31-video__play-icon {
    border-left-color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp31-video-wrapper" id="HP31Video-{{ section.id }}">
  <div class="hp31-video__header">
    {%- if section.settings.tagline != blank -%}
      <span class="hp31-video__tagline">{{ section.settings.tagline }}</span>
    {%- endif -%}
    <h2 class="hp31-video__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp31-video__container">
    {%- if section.settings.video_url != blank -%}
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe class="hp31-video__media" src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=0&controls=0&mute=1&loop=1&playlist={{ section.settings.video_url.id }}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
      {%- elsif section.settings.video_url.type == 'vimeo' -%}
        <iframe class="hp31-video__media" src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?background=1" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hp31-video__media' }}
    {%- endif -%}

    <div class="hp31-video__overlay">
      <div class="hp31-video__play-btn" aria-label="Play Video">
        <div class="hp31-video__play-icon"></div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP31 - Zen Video",
  "class": "section-hp31-video-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "The Process"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Moments of <em>Creation</em>"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "Video URL"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 42
    },
    {
      "type": "header",
      "content": "Zen Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Beige)",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#2C2C2C"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP31 - Zen Video"
    }
  ]
}
{% endschema %}
