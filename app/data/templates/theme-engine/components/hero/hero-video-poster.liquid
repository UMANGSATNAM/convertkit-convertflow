{% comment %}
  Hero Video Poster - Ambient Video / Visual with Hotspot
  Category: hero
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    position: relative;
    min-height: clamp(550px, 90vh, 850px);
    display: flex;
    align-items: flex-end;
    padding: clamp(40px, 6vw, 80px) 24px;
    background-color: #020617;
    color: #ffffff;
    overflow: hidden;
    font-family: inherit;
  }

  .cf-vposter-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .cf-vposter-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(2, 6, 23, 0.2) 0%, rgba(2, 6, 23, 0.85) 100%);
    z-index: 2;
  }

  .cf-vposter-container {
    position: relative;
    z-index: 3;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
  }

  .cf-vposter-left {
    max-width: 720px;
  }

  .cf-vposter-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #38bdf8;
    margin-bottom: 20px;
  }

  .cf-vposter-title {
    font-size: clamp(38px, 6vw, 76px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin: 0 0 20px 0;
    text-transform: uppercase;
  }

  .cf-vposter-desc {
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 32px 0;
  }

  .cf-vposter-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #ffffff;
    color: #020617;
    font-size: 16px;
    font-weight: 800;
    padding: 16px 36px;
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.2s, background-color 0.2s;
  }

  .cf-vposter-btn:hover {
    transform: translateY(-2px);
    background: #f1f5f9;
  }

  .cf-vposter-hotspot {
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    text-decoration: none;
    color: #ffffff;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    transition: transform 0.2s;
    min-width: 260px;
  }

  .cf-vposter-hotspot:hover {
    transform: translateY(-4px);
  }

  .cf-vposter-spot-img {
    width: 54px;
    height: 54px;
    border-radius: 12px;
    object-fit: cover;
    background: #1e293b;
  }

  .cf-vposter-spot-title {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }

  .cf-vposter-spot-price {
    font-size: 13px;
    color: #38bdf8;
    font-weight: 800;
    margin-top: 4px;
  }
{%- endstyle -%}

<img
  src="{{ section.settings.image | default: 'https://images.unsplash.com/photo-1508739773434-c26b3d09e071?w=1800&q=80' }}"
  alt="{{ section.settings.heading | escape }}"
  class="cf-vposter-bg"
  loading="eager"
  width="1800"
  height="1000"
>
<div class="cf-vposter-gradient"></div>

<div class="cf-vposter-container">
  <div class="cf-vposter-left">
    <div class="cf-vposter-tag">{{ section.settings.tag | default: 'NEXT GENERATION AUDIO' }}</div>
    <h1 class="cf-vposter-title">{{ section.settings.heading | default: 'Immersive Sound. Pure Isolation.' }}</h1>
    <p class="cf-vposter-desc">
      {{ section.settings.desc | default: 'Equipped with custom 40mm beryllium drivers and ultra-dense active noise cancellation for the purest acoustic fidelity ever made.' }}
    </p>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="cf-vposter-btn">
      <span>{{ section.settings.btn_text | default: 'Order Now &mdash; $299' }}</span>
      <span>→</span>
    </a>
  </div>

  <a href="{{ section.settings.spot_url | default: '/products' }}" class="cf-vposter-hotspot">
    <img
      src="{{ section.settings.spot_image | default: 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=200&q=80' }}"
      alt="Featured item"
      class="cf-vposter-spot-img"
      width="54"
      height="54"
    >
    <div>
      <div class="cf-vposter-spot-title">{{ section.settings.spot_title | default: 'AeroMax Pro Wireless' }}</div>
      <div class="cf-vposter-spot-price">{{ section.settings.spot_price | default: '$299 USD' }}</div>
    </div>
  </a>
</div>

{% schema %}
{
  "name": "Hero Video Poster",
  "tag": "section",
  "class": "cf-hero-video-poster-section",
  "settings": [
    {
      "type": "text",
      "id": "image",
      "label": "Poster image URL",
      "default": "https://images.unsplash.com/photo-1508739773434-c26b3d09e071?w=1800&q=80"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Category tag",
      "default": "NEXT GENERATION AUDIO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Immersive Sound. Pure Isolation."
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Description",
      "default": "Equipped with custom 40mm beryllium drivers and ultra-dense active noise cancellation for the purest acoustic fidelity ever made."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text",
      "default": "Order Now — $299"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Product Hotspot"
    },
    {
      "type": "text",
      "id": "spot_title",
      "label": "Hotspot product title",
      "default": "AeroMax Pro Wireless"
    },
    {
      "type": "text",
      "id": "spot_price",
      "label": "Hotspot price",
      "default": "$299 USD"
    },
    {
      "type": "text",
      "id": "spot_image",
      "label": "Hotspot thumbnail URL",
      "default": "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=200&q=80"
    },
    {
      "type": "url",
      "id": "spot_url",
      "label": "Hotspot link"
    }
  ],
  "presets": [
    {
      "name": "Hero Video Poster",
      "settings": {
        "heading": "Immersive Sound. Pure Isolation.",
        "btn_text": "Order Now — $299"
      }
    }
  ]
}
{% endschema %}
