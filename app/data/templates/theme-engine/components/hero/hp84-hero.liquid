{%- style -%}
@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@600;800&family=Space+Grotesk:wght@500;700&display=swap');
#shopify-section-{{ section.id }}{--hp84-bg:{{section.settings.bg_color|default:'#FFF7ED'}};--hp84-accent:#F97316;background: var(--hp84-bg);color: {{section.settings.text_color|default:'#431407'}};font-family:'Space Grotesk',sans-serif;padding:0;position:relative;overflow:hidden}
#shopify-section-{{ section.id }}::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(90deg, rgba(255,255,255,.03) 0 1px, transparent 1px 80px), repeating-linear-gradient(0deg, rgba(255,255,255,.02) 0 1px, transparent 1px 80px);pointer-events:none}
.hp84-hero{max-width:{{section.settings.container_width|default:1280}}px;margin:0 auto;padding:70px 24px 70px;display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center;position:relative;z-index:1}
.hp84-kicker{display:inline-flex;gap:8px;align-items:center;padding:6px 14px;border:1px solid #F97316;background: #F9731614;color:#F97316;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;border-radius:4px}
.hp84-title{font-family:'JetBrains Mono',monospace;font-size:clamp(30px,4.8vw,54px);font-weight:800;line-height:1;text-transform:uppercase;margin:18px 0 14px;letter-spacing:-1px}
.hp84-title span{background:linear-gradient(90deg,#F97316,#FB923C);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hp84-desc{opacity:.7;line-height:1.7;max-width:520px}
.hp84-cta{margin-top:22px;display:flex;gap:12px;flex-wrap:wrap}
.hp84-btn{padding:14px 26px;background:#F97316;color:#fff;font-weight:700;font-size:12px;letter-spacing:1.4px;text-transform:uppercase;text-decoration:none;border-radius:4px}
.hp84-btn--ghost{background:transparent;color:#F97316;border:1px solid #F97316}
.hp84-media{position:relative;border:1px solid #F9731640;border-radius:12px;overflow:hidden;height:520px;background:#000}
.hp84-media img{width:100%;height:100%;object-fit:cover;filter:contrast(1.1) saturate(1.2)}
.hp84-hud{position:absolute;bottom:12px;left:12px;right:12px;display:flex;justify-content:space-between;gap:10px}
.hp84-hud span{background:rgba(0,0,0,.7);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.15);color:#fff;padding:8px 12px;border-radius:6px;font-size:11px;font-family:'JetBrains Mono',monospace}
@media(max-width:992px){.hp84-hero{grid-template-columns:1fr;text-align:center}.hp84-cta{justify-content:center}.hp84-media{height:360px}}
{%- endstyle -%}
<div class="hp84-hero">
  <div>
    <div class="hp84-kicker"><span>★</span><span>{{section.settings.badge|default:'KIDS // MATRIX v84'}}</span></div>
    <h1 class="hp84-title">{{section.settings.heading|default:'KIDS <span>KIDS</span>'}}</h1>
    <p class="hp84-desc">{{section.settings.description|default:'Safe soft creative essentials for tiny humans Cyber grid, terminal hud & drop-coded utility.'}}</p>
    <div class="hp84-cta"><a href="{{section.settings.btn_url|default:'/collections/all'}}" class="hp84-btn">{{section.settings.btn_text|default:'Enter Matrix'}}</a>{% if section.settings.btn2_text != blank %}<a href="{{section.settings.btn2_url}}" class="hp84-btn hp84-btn--ghost">{{section.settings.btn2_text}}</a>{% endif %}</div>
  </div>
  <div class="hp84-media">{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:1000}}" alt="{{section.settings.heading|strip_html}}" loading="eager">{% else %}{{'lifestyle-1'|placeholder_svg_tag}}{% endif %}<div class="hp84-hud"><span>● LIVE DROP</span><span>{{section.settings.float_sub|default:'50K VERIFIED'}}</span></div></div>
</div>
{% schema %}{"name":"HP84 Hero Cyber","settings":[{"type":"color","id":"bg_color","label":"BG","default":"#FFF7ED"},{"type":"color","id":"text_color","label":"Text","default":"#431407"},{"type":"text","id":"badge","label":"Badge","default":"KIDS // MATRIX v84"},{"type":"textarea","id":"heading","label":"Heading","default":"KIDS <span>KIDS</span>"},{"type":"textarea","id":"description","label":"Desc","default":"Safe soft creative essentials for tiny humans"},{"type":"text","id":"btn_text","label":"CTA","default":"Enter Matrix"},{"type":"url","id":"btn_url","label":"Link"},{"type":"text","id":"btn2_text","label":"Ghost"},{"type":"url","id":"btn2_url","label":"Ghost link"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"float_sub","label":"HUD","default":"50K VERIFIED"},{"type":"range","id":"container_width","min":1000,"max":1440,"step":20,"unit":"px","label":"Width","default":1280}],"presets":[{"name":"HP84 Hero Cyber"}]}{% endschema %}