{%- style -%}
@import url('https://fonts.googleapis.com/css2?family=Anton&family=Space+Mono:wght@400;700&display=swap');
#shopify-section-{{ section.id }}{background:{{section.settings.bg_color|default:'#ffffff'}};color:#111;padding:0;border-top:6px solid #06B6D4;border-bottom:6px solid #111}
.hp86-bar{background:#06B6D4;color:#fff;padding:8px 0;overflow:hidden;white-space:nowrap}
.hp86-bar span{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;margin-right:32px}
.hp86-grid{max-width:{{section.settings.container_width|default:1280}}px;margin:0 auto;display:grid;grid-template-columns:1.1fr .9fr;min-height:560px}
.hp86-left{padding:50px 24px;border-right:6px solid #111;display:flex;flex-direction:column;justify-content:center}
.hp86-badge{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;background:#111;color:#fff;display:inline-block;padding:6px 10px;margin-bottom:16px}
.hp86-h{font-family:'Anton',sans-serif;font-size:clamp(40px,6vw,78px);line-height:.9;text-transform:uppercase;margin:0}
.hp86-h span{color:#06B6D4;-webkit-text-stroke:1.5px #111}
.hp86-p{font-family:'Space Mono',monospace;font-size:13px;line-height:1.7;opacity:.7;margin:14px 0 22px;max-width:480px}
.hp86-btn{font-family:'Anton',sans-serif;font-size:18px;letter-spacing:1px;text-transform:uppercase;background:#06B6D4;color:#111;border:3px solid #111;padding:14px 26px;text-decoration:none;display:inline-block;box-shadow:6px 6px 0 #111}
.hp86-right{background:#f5f5f5;position:relative;overflow:hidden}
.hp86-right img{width:100%;height:100%;object-fit:cover;filter:grayscale(.1) contrast(1.1)}
.hp86-price{position:absolute;top:16px;right:16px;background:#fff;border:3px solid #111;padding:10px 14px;font-family:'Anton',sans-serif;box-shadow:4px 4px 0 #111}
@media(max-width:900px){.hp86-grid{grid-template-columns:1fr}.hp86-left{border-right:none;border-bottom:6px solid #111;text-align:center;align-items:center}}
{%- endstyle -%}
<div class="hp86-bar"><span>● ACTIVEWEAR DROP v86</span><span>● FREE SHIPPING</span><span>● LIMITED STOCK</span><span>● ACTIVEWEAR DROP v86</span></div>
<div class="hp86-grid">
  <div class="hp86-left">
    <div class="hp86-badge">{{section.settings.badge|default:'ACTIVEWEAR v86 — BRUTALIST'}}</div>
    <h1 class="hp86-h">{{section.settings.heading|default:'RAW <span>ACTIVEWEAR</span>'}}</h1>
    <p class="hp86-p">{{section.settings.description|default:'Seamless stretch, breathable knit for every rep Built brutal, worn daily.'}}</p>
    <a href="{{section.settings.btn_url|default:'/collections/all'}}" class="hp86-btn">{{section.settings.btn_text|default:'Shop Brutal'}} →</a>
  </div>
  <div class="hp86-right">{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:1000}}" alt="" loading="eager">{% else %}{{'product-1'|placeholder_svg_tag}}{% endif %}<div class="hp86-price">FROM {{section.settings.price|default:'₹1,499'}}</div></div>
</div>
{% schema %}{"name":"HP86 Hero Brutalist","settings":[{"type":"color","id":"bg_color","label":"BG","default":"#ffffff"},{"type":"text","id":"badge","label":"Badge","default":"ACTIVEWEAR v86 — BRUTALIST"},{"type":"textarea","id":"heading","label":"Heading","default":"RAW ACTIVEWEAR"},{"type":"textarea","id":"description","label":"Desc","default":"Seamless stretch, breathable knit for every rep"},{"type":"text","id":"btn_text","label":"CTA","default":"Shop Brutal"},{"type":"url","id":"btn_url","label":"Link"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"price","label":"Price badge","default":"FROM ₹1,499"},{"type":"range","id":"container_width","min":1000,"max":1440,"step":20,"unit":"px","label":"Width","default":1280}],"presets":[{"name":"HP86 Hero Brutalist"}]}{% endschema %}