{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Outfit:wght@400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --hp46-bg: {{ section.settings.bg_color | default: '#0B0F19' }};
    --hp46-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    --hp46-cyan: {{ section.settings.cyan_color | default: '#38BDF8' }};
    --hp46-pink: {{ section.settings.pink_color | default: '#F472B6' }};
    
    background-color: var(--hp46-bg);
    color: var(--hp46-text);
    font-family: 'Outfit', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp46-hero__glow-bg {
    position: absolute;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.15) 0%, rgba(244, 114, 182, 0.15) 50%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    filter: blur(60px);
  }

  .hp46-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hp46-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--hp46-cyan);
    margin-bottom: 24px;
  }

  .hp46-hero__title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(40px, 6vw, 68px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -1px;
    margin: 0 0 22px;
  }

  .hp46-hero__title span {
    background: linear-gradient(135deg, #38BDF8 0%, #F472B6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp46-hero__desc {
    font-size: 16px;
    line-height: 1.7;
    color: #94A3B8;
    margin: 0 0 36px;
    max-width: 520px;
  }

  .hp46-hero__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hp46-hero__btn-holo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: linear-gradient(135deg, #38BDF8 0%, #F472B6 100%);
    color: #0B0F19;
    font-family: 'Syne', sans-serif;
    font-size: 15px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 0 30px rgba(56, 189, 248, 0.35);
    transition: all 0.3s ease;
  }

  .hp46-hero__btn-holo:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 45px rgba(244, 114, 182, 0.5);
  }

  .hp46-hero__card {
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 28px;
    padding: 18px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 30px rgba(56, 189, 248, 0.15);
    position: relative;
  }

  .hp46-hero__img {
    width: 100%;
    height: 460px;
    object-fit: cover;
    border-radius: 18px;
    display: block;
  }

  .hp46-hero__float-chip {
    position: absolute;
    bottom: -15px;
    right: -15px;
    background: rgba(11, 15, 25, 0.9);
    backdrop-filter: blur(12px);
    border: 1px solid var(--hp46-pink);
    border-radius: 18px;
    padding: 12px 20px;
    box-shadow: 0 10px 25px rgba(244, 114, 182, 0.25);
  }

  .hp46-hero__float-chip p {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    color: var(--hp46-pink);
  }

  @media screen and (max-width: 992px) {
    .hp46-hero__container { grid-template-columns: 1fr; text-align: center; }
    .hp46-hero__desc { margin-left: auto; margin-right: auto; }
    .hp46-hero__actions { justify-content: center; }
    .hp46-hero__img { height: 340px; }
    .hp46-hero__float-chip { right: 20px; }
  }
{%- endstyle -%}

<div class="hp46-hero__glow-bg"></div>

<div class="hp46-hero__container">
  <div>
    <div class="hp46-hero__badge">
      <span>⚡</span>
      <span>{{ section.settings.badge | default: 'HOLOGRAPHIC BIO-TECH v46' }}</span>
    </div>

    <h1 class="hp46-hero__title">
      {{ section.settings.heading | default: 'CYBERNETIC <span>LUMINESCENCE</span> FORMULAS' }}
    </h1>

    <p class="hp46-hero__desc">
      {{ section.settings.description | default: 'Bio-luminescent phytoplankton enzymes combined with multi-depth peptide matrices to ignite instant cellular radiance and barrier defense.' }}
    </p>

    <div class="hp46-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp46-hero__btn-holo">
        <span>{{ section.settings.btn_text | default: 'ENTER THE NEON DROP' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp46-hero__card">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1000 }}" class="hp46-hero__img" alt="Cyber Neon Skincare" loading="eager">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp46-hero__img' }}
    {%- endif -%}

    <div class="hp46-hero__float-chip">
      <p>✦ 400% LUMINESCENT GLOW</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP46 - Cyber Hero",
  "class": "section-hp46-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0B0F19" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFFFF" },
    { "type": "color", "id": "cyan_color", "label": "Neon Cyan Color", "default": "#38BDF8" },
    { "type": "color", "id": "pink_color", "label": "Neon Pink Color", "default": "#F472B6" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "HOLOGRAPHIC BIO-TECH v46" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "CYBERNETIC LUMINESCENCE FORMULAS" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Bio-luminescent phytoplankton enzymes combined with multi-depth peptide matrices to ignite instant cellular radiance." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "ENTER THE NEON DROP" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [
    { "name": "HP46 - Cyber Hero" }
  ]
}
{% endschema %}
