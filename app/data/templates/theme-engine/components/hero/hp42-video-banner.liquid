{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,700&family=Inter:wght@300&display=swap');

  #shopify-section-{{ section.id }} {
    --bg: {{ section.settings.bg_color }};
    --text: {{ section.settings.text_color }};
    --gold: {{ section.settings.accent_color }};
    --serif: 'Playfair Display', serif;
    --sans: 'Inter', sans-serif;
    background: var(--bg);
  }

  .hp42-video {
    position: relative;
    width: 100%;
    aspect-ratio: 21/9;
    overflow: hidden;
  }

  @media (max-width: 768px) { .hp42-video { aspect-ratio: 16/9; } }

  .hp42-video__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.4) contrast(1.1);
  }

  .hp42-video__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
  }

  .hp42-video__title {
    font-family: var(--serif);
    font-size: clamp(28px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    font-style: italic;
    color: var(--text);
    margin: 0 0 30px;
  }

  .hp42-video__play {
    width: 80px; height: 80px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.4s ease;
  }
  .hp42-video__play:hover { background: rgba(201,169,110,0.2); transform: scale(1.1); }

  .hp42-video__play svg { width: 24px; height: 24px; fill: var(--gold); margin-left: 4px; }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp42-video" id="HP42Video-{{ section.id }}">
  {%- if section.settings.video_url != blank -%}
    <video class="hp42-video__media" autoplay loop muted playsinline>
      <source src="{{ section.settings.video_url }}" type="video/mp4">
    </video>
  {%- elsif section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 1800 }}" class="hp42-video__media" alt="Video" loading="lazy">
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'hp42-video__media' }}
  {%- endif -%}

  <div class="hp42-video__overlay">
    <h2 class="hp42-video__title">{{ section.settings.title }}</h2>
    <div class="hp42-video__play">
      <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP42 - Noir Video",
  "class": "section-hp42-video-banner",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Behind the Collection" },
    { "type": "url", "id": "video_url", "label": "Video URL" },
    { "type": "image_picker", "id": "image", "label": "Fallback Image" },
    { "type": "range", "id": "title_size", "min": 28, "max": 80, "step": 2, "unit": "px", "label": "Title Size", "default": 48 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A0A0A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F0EB" },
    { "type": "color", "id": "accent_color", "label": "Gold", "default": "#C9A96E" },
    { "type": "html", "id": "custom_css", "label": "Custom CSS" }
  ],
  "presets": [{ "name": "HP42 - Noir Video" }]
}
{% endschema %}
