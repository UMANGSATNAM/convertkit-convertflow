{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Space Mono', monospace;
    
    background-color: var(--bg-color);
    border-bottom: 2px solid var(--text-color);
  }

  .hp38-video-wrapper {
    width: 100%;
    position: relative;
    /* Maintain an ultra-wide cinematic or sharp aspect ratio */
    aspect-ratio: 21/9;
    background: #000;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    .hp38-video-wrapper {
      aspect-ratio: 16/9;
    }
  }
  @media screen and (max-width: 480px) {
    .hp38-video-wrapper {
      aspect-ratio: 1/1;
    }
  }

  .hp38-video__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
    filter: grayscale(100%);
  }

  .hp38-video__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 3;
    pointer-events: none;
  }

  .hp38-video__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: #fff;
    margin: 0;
    text-align: center;
    padding: 0 20px;
    letter-spacing: -2px;
  }

  .hp38-video__play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100px; height: 100px;
    background: transparent;
    border: 2px solid #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    cursor: pointer;
    z-index: 4;
    transition: all 0.3s ease;
  }
  
  @media screen and (max-width: 768px) {
    .hp38-video__play-btn {
      width: 80px; height: 80px;
    }
  }

  .hp38-video__play-btn:hover {
    background: #fff;
    color: #000;
  }

  .hp38-video__play-btn svg {
    width: 40px; height: 40px;
    fill: currentColor;
    margin-left: 5px;
  }

  .hp38-video__meta {
    position: absolute;
    bottom: 20px;
    left: 20px;
    font-family: var(--font-heading);
    font-size: 12px;
    color: #fff;
    border: 1px solid #fff;
    padding: 4px 8px;
    z-index: 3;
    pointer-events: none;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp38-video-wrapper" id="HP38Video-{{ section.id }}">
  {%- if section.settings.video_url != blank -%}
    {%- if section.settings.video_url.type == 'youtube' -%}
      <iframe class="hp38-video__media" src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=0&controls=0&mute=1&loop=1&playlist={{ section.settings.video_url.id }}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
    {%- elsif section.settings.video_url.type == 'vimeo' -%}
      <iframe class="hp38-video__media" src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?background=1" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
    {%- endif -%}
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'hp38-video__media' }}
  {%- endif -%}

  <div class="hp38-video__meta">REC // 00:00:00</div>

  <div class="hp38-video__overlay">
    {%- if section.settings.title != blank -%}
      <h2 class="hp38-video__title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>
  
  <button class="hp38-video__play-btn" aria-label="Play Video">
    <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
  </button>
</div>

{% schema %}
{
  "name": "HP38 - Brutalist Video",
  "class": "section-hp38-video-banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SYSTEM.WATCH"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "Video URL"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 140,
      "step": 5,
      "unit": "px",
      "label": "Heading Size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Grid Lines (Global)",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP38 - Brutalist Video"
    }
  ]
}
{% endschema %}
