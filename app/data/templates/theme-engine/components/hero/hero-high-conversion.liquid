{% comment %}
  Hero High Conversion - Social Proof & Benefit Bullets
  Category: hero
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --hc-bg: {{ section.settings.bg_color | default: '#090d16' }};
    --hc-text: {{ section.settings.text_color | default: '#f8fafc' }};
    --hc-accent: {{ section.settings.accent_color | default: '#10b981' }};
    background-color: var(--hc-bg);
    color: var(--hc-text);
    padding: clamp(48px, 8vw, 100px) 24px;
    font-family: inherit;
    position: relative;
    overflow: hidden;
  }

  .cf-hc-grid {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  @media (max-width: 960px) {
    .cf-hc-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }

  .cf-hc-left {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media (max-width: 960px) {
    .cf-hc-left {
      align-items: center;
    }
  }

  .cf-hc-proof-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 6px 14px;
    border-radius: 999px;
    width: fit-content;
    font-size: 13px;
    font-weight: 600;
  }

  .cf-hc-stars {
    color: #f59e0b;
    font-size: 14px;
  }

  .cf-hc-title {
    font-size: clamp(34px, 4.8vw, 64px);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 0;
    color: #ffffff;
  }

  .cf-hc-highlight {
    background: linear-gradient(135deg, #10b981 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .cf-hc-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cf-hc-bullet {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: clamp(15px, 1.5vw, 17px);
    color: #cbd5e1;
  }

  @media (max-width: 960px) {
    .cf-hc-bullet {
      justify-content: center;
    }
  }

  .cf-hc-check {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.2);
    color: var(--hc-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 900;
    flex-shrink: 0;
  }

  .cf-hc-cta-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
  }

  @media (max-width: 960px) {
    .cf-hc-cta-group {
      align-items: center;
    }
  }

  .cf-hc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--hc-accent);
    color: #090d16;
    font-size: 17px;
    font-weight: 800;
    padding: 18px 36px;
    border-radius: 12px;
    text-decoration: none;
    box-shadow: 0 10px 25px rgba(16, 185, 129, 0.35);
    transition: transform 0.2s, box-shadow 0.2s;
    width: fit-content;
  }

  .cf-hc-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(16, 185, 129, 0.45);
  }

  .cf-hc-guarantee {
    font-size: 12px;
    color: #94a3b8;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cf-hc-card-wrap {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #1e293b;
  }

  .cf-hc-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 4 / 4.5;
  }

  .cf-hc-floating-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 10px 16px;
    border-radius: 12px;
    text-align: right;
  }

  .cf-hc-fb-val {
    font-size: 20px;
    font-weight: 900;
    color: #38bdf8;
  }

  .cf-hc-fb-label {
    font-size: 10px;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
{%- endstyle -%}

<div class="cf-hc-grid">
  <div class="cf-hc-left">
    <div class="cf-hc-proof-pill">
      <span class="cf-hc-stars">★★★★★</span>
      <span>{{ section.settings.proof_text | default: 'Trusted by 45,000+ happy buyers' }}</span>
    </div>

    <h1 class="cf-hc-title">
      {{ section.settings.heading | default: 'The All-Day Comfort Shoe That Feels Like Walking On Clouds.' }}
    </h1>

    <ul class="cf-hc-bullets">
      <li class="cf-hc-bullet">
        <span class="cf-hc-check">✓</span>
        <span>{{ section.settings.bullet_1 | default: 'Orthopedic arch support engineered for 12+ hour standing' }}</span>
      </li>
      <li class="cf-hc-bullet">
        <span class="cf-hc-check">✓</span>
        <span>{{ section.settings.bullet_2 | default: 'Ultra-breathable zero-sweat recycled eucalyptus mesh' }}</span>
      </li>
      <li class="cf-hc-bullet">
        <span class="cf-hc-check">✓</span>
        <span>{{ section.settings.bullet_3 | default: 'Machine washable & durable slip-resistant sole' }}</span>
      </li>
    </ul>

    <div class="cf-hc-cta-group">
      <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="cf-hc-btn">
        <span>{{ section.settings.cta_text | default: 'Claim Your 30-Day Trial →' }}</span>
      </a>
      <div class="cf-hc-guarantee">
        <span>🔒 30-Day Risk-Free Money Back Guarantee &middot; Free Exchanges</span>
      </div>
    </div>
  </div>

  <div class="cf-hc-card-wrap">
    <img
      src="{{ section.settings.image | default: 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=1000&q=80' }}"
      alt="{{ section.settings.heading | escape }}"
      class="cf-hc-img"
      loading="eager"
      width="600"
      height="680"
    >
    <div class="cf-hc-floating-badge">
      <div class="cf-hc-fb-val">{{ section.settings.badge_stat | default: '98%' }}</div>
      <div class="cf-hc-fb-label">{{ section.settings.badge_stat_label | default: 'Pain-Free Rating' }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero High Conversion",
  "tag": "section",
  "class": "cf-hero-conversion-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#090d16"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / CTA color",
      "default": "#10b981"
    },
    {
      "type": "text",
      "id": "proof_text",
      "label": "Social proof text",
      "default": "Trusted by 45,000+ happy buyers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The All-Day Comfort Shoe That Feels Like Walking On Clouds."
    },
    {
      "type": "text",
      "id": "bullet_1",
      "label": "Benefit 1",
      "default": "Orthopedic arch support engineered for 12+ hour standing"
    },
    {
      "type": "text",
      "id": "bullet_2",
      "label": "Benefit 2",
      "default": "Ultra-breathable zero-sweat recycled eucalyptus mesh"
    },
    {
      "type": "text",
      "id": "bullet_3",
      "label": "Benefit 3",
      "default": "Machine washable & durable slip-resistant sole"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Claim Your 30-Day Trial →"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "image",
      "label": "Product image URL",
      "default": "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=1000&q=80"
    },
    {
      "type": "text",
      "id": "badge_stat",
      "label": "Badge statistic",
      "default": "98%"
    },
    {
      "type": "text",
      "id": "badge_stat_label",
      "label": "Badge statistic label",
      "default": "Pain-Free Rating"
    }
  ],
  "presets": [
    {
      "name": "Hero High Conversion",
      "settings": {
        "heading": "The All-Day Comfort Shoe That Feels Like Walking On Clouds.",
        "cta_text": "Claim Your 30-Day Trial →"
      }
    }
  ]
}
{% endschema %}
