{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --overlay-color: {{ section.settings.overlay_color | color_modify: 'alpha', section.settings.overlay_opacity | divided_by: 100.0 }};
    
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    background-color: var(--bg-color);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      --padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp19-hero-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: {{ section.settings.desktop_content_position }};
    justify-content: {{ section.settings.desktop_content_alignment }};
    min-height: {{ section.settings.desktop_min_height }};
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    .hp19-hero-wrapper {
      min-height: {{ section.settings.mobile_min_height }};
      align-items: {{ section.settings.mobile_content_position }};
      justify-content: {{ section.settings.mobile_content_alignment }};
    }
  }

  .hp19-hero__background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hp19-hero__background-image img,
  .hp19-hero__background-image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hp19-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--overlay-color);
    z-index: 2;
  }

  .hp19-hero__content-box {
    position: relative;
    z-index: 3;
    max-width: {{ section.settings.content_max_width }}px;
    padding: 40px;
    background: {{ section.settings.box_bg_color | color_modify: 'alpha', section.settings.box_opacity | divided_by: 100.0 }};
    text-align: {{ section.settings.text_alignment }};
    border-radius: {{ section.settings.border_radius }}px;
    margin: 0 24px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    animation: fadeInUp 0.8s ease forwards;
  }

  @media screen and (max-width: 768px) {
    .hp19-hero__content-box {
      padding: 24px;
      margin: 0 16px;
      text-align: {{ section.settings.mobile_text_alignment }};
    }
  }

  .hp19-hero__tagline {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent-color);
    margin-bottom: 20px;
    display: block;
  }

  .hp19-hero__title {
    font-family: 'Baskerville', 'Georgia', serif;
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    font-style: italic;
    color: var(--text-color);
    margin: 0 0 24px;
    line-height: 1.1;
  }

  .hp19-hero__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: clamp(16px, 3vw, {{ section.settings.subtitle_size }}px);
    color: var(--text-color);
    opacity: 0.9;
    margin: 0 0 32px;
    line-height: 1.6;
  }

  .hp19-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: {% if section.settings.text_alignment == 'center' %}center{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  @media screen and (max-width: 768px) {
    .hp19-hero__buttons {
      justify-content: {% if section.settings.mobile_text_alignment == 'center' %}center{% elsif section.settings.mobile_text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
      flex-direction: column;
    }
  }

  .hp19-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: {{ section.settings.button_radius }}px;
    transition: all 0.3s ease;
  }

  .hp19-hero__btn--primary {
    background-color: var(--accent-color);
    color: #FFFFFF;
    border: 1px solid var(--accent-color);
  }

  .hp19-hero__btn--primary:hover {
    background-color: transparent;
    color: var(--accent-color);
  }

  .hp19-hero__btn--secondary {
    background-color: transparent;
    color: var(--text-color);
    border: 1px solid var(--text-color);
  }

  .hp19-hero__btn--secondary:hover {
    background-color: var(--text-color);
    color: var(--bg-color);
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp19-hero-wrapper" id="HP19Hero-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <div class="hp19-hero__background-image">
      {%- if section.settings.image_mobile != blank -%}
        <picture>
          <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 800 }}">
          <source media="(min-width: 769px)" srcset="{{ section.settings.image | image_url: width: 2000 }}">
          <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
        </picture>
      {%- else -%}
        <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="hp19-hero__background-image">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}

  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="hp19-hero__overlay"></div>
  {%- endif -%}

  <div class="hp19-hero__content-box">
    {%- if section.settings.tagline != blank -%}
      <span class="hp19-hero__tagline">{{ section.settings.tagline | escape }}</span>
    {%- endif -%}
    
    {%- if section.settings.title != blank -%}
      <h1 class="hp19-hero__title">{{ section.settings.title | escape }}</h1>
    {%- endif -%}
    
    {%- if section.settings.subtitle != blank -%}
      <div class="hp19-hero__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    
    <div class="hp19-hero__buttons">
      {%- if section.settings.btn1_text != blank and section.settings.btn1_link != blank -%}
        <a href="{{ section.settings.btn1_link }}" class="hp19-hero__btn hp19-hero__btn--primary">
          {{ section.settings.btn1_text | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.btn2_text != blank and section.settings.btn2_link != blank -%}
        <a href="{{ section.settings.btn2_link }}" class="hp19-hero__btn hp19-hero__btn--secondary">
          {{ section.settings.btn2_text | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

