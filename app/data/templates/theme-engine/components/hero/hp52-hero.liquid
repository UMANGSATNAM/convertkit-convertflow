{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,700;1,6..96,400&family=Jost:wght@400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --hp52-bg: {{ section.settings.bg_color | default: '#F7EFE6' }};
    --hp52-text: {{ section.settings.text_color | default: '#2D3B2D' }};
    --hp52-terracotta: {{ section.settings.accent_terra | default: '#C2593F' }};
    --hp52-card-bg: {{ section.settings.card_bg | default: '#FFFDF9' }};
    --hp52-btn-bg: {{ section.settings.btn_bg | default: '#C2593F' }};
    --hp52-btn-text-color: {{ section.settings.btn_text_color | default: '#FFFDF9' }};
    
    background-color: var(--hp52-bg);
    color: var(--hp52-text);
    font-family: 'Jost', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp52-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hp52-hero__sun-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 20px;
    background: #EFE4D6;
    border-radius: 50px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--hp52-terracotta);
    margin-bottom: 24px;
  }

  .hp52-hero__title {
    font-family: 'Bodoni Moda', serif;
    font-size: clamp(38px, 5.5vw, 62px);
    font-weight: 700;
    line-height: 1.1;
    color: var(--hp52-text);
    margin: 0 0 22px;
  }

  .hp52-hero__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--hp52-terracotta);
  }

  .hp52-hero__desc {
    font-size: 16px;
    line-height: 1.8;
    color: #5C675B;
    margin: 0 0 36px;
    max-width: 520px;
  }

  .hp52-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp52-hero__btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp52-btn-bg);
    color: var(--hp52-btn-text-color);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(194, 89, 63, 0.25);
    transition: all 0.3s ease;
  }

  .hp52-hero__btn-primary:hover {
    background: #A94B34;
    transform: translateY(-2px);
  }

  .hp52-hero__media-frame {
    position: relative;
    border-radius: 140px 140px 24px 24px;
    overflow: hidden;
    background: #EFE4D6;
    box-shadow: 0 25px 60px rgba(45, 59, 45, 0.12);
    height: 540px;
    border: 3px solid #FFFDF9;
  }

  .hp52-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp52-hero__floating-card {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    background: rgba(255, 253, 249, 0.94);
    backdrop-filter: blur(12px);
    border-radius: 16px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid rgba(194, 89, 63, 0.15);
  }

  .hp52-hero__float-title {
    font-family: 'Bodoni Moda', serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--hp52-text);
    margin: 0;
  }

  .hp52-hero__float-sub {
    font-size: 11px;
    color: var(--hp52-terracotta);
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp52-hero__container { grid-template-columns: 1fr; text-align: center; }
    .hp52-hero__desc { margin-left: auto; margin-right: auto; }
    .hp52-hero__actions { justify-content: center; }
    .hp52-hero__media-frame { height: 400px; }
  }
{%- endstyle -%}

<div class="hp52-hero__container">
  <div>
    <div class="hp52-hero__sun-badge">
      <span>☀️</span>
      <span>{{ section.settings.badge | default: 'MEDITERRANEAN BOTANICAL ATELIER v52' }}</span>
    </div>

    <h1 class="hp52-hero__title">
      {{ section.settings.heading | default: 'Sun-Drenched Terracotta & <em>Wild Olive</em> Radiance' }}
    </h1>

    <p class="hp52-hero__desc">
      {{ section.settings.description | default: 'Artisanal cold-pressed Tuscan olive squalane and mineral-rich Sicilian terracotta clay to restore lipid moisture barriers.' }}
    </p>

    <div class="hp52-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp52-hero__btn-primary">
        <span>{{ section.settings.btn_text | default: 'Discover Mediterranean Edit' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp52-hero__media-frame">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1000 }}" class="hp52-hero__img" alt="{{ section.settings.heading }}" loading="eager">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp52-hero__img' }}
    {%- endif -%}

    <div class="hp52-hero__floating-card">
      <div>
        <p class="hp52-hero__float-title">Tuscan Olive Squalane &amp; Terracotta</p>
        <p class="hp52-hero__float-sub">Cold-Pressed Artisanal Harvest</p>
      </div>
      <span>🏺</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP52 - Terra Hero",
  "class": "section-hp52-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F7EFE6" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#2D3B2D" },
    { "type": "color", "id": "accent_terra", "label": "Terracotta Accent", "default": "#C2593F" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#C2593F" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#FFFDF9" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "MEDITERRANEAN BOTANICAL ATELIER v52" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Sun-Drenched Terracotta & <em>Wild Olive</em> Radiance" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Artisanal cold-pressed Tuscan olive squalane and mineral-rich Sicilian terracotta clay." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Discover Mediterranean Edit" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [
    { "name": "HP52 - Terra Hero" }
  ]
}
{% endschema %}
