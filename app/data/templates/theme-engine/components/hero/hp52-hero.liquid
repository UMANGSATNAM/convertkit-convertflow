{%- style -%}#shopify-section-{{ section.id }}{background:#0B0B0D;padding:50px 0}.hp52-wrap{max-width:1280px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr 1fr;gap:40px}@media(max-width:900px){.hp52-wrap{grid-template-columns:1fr}}{%- endstyle -%}<div class="hp52-wrap"><div><h1 style="font-size:32px;font-weight:800">{{section.settings.heading|default:'STREETWEAR v52'}}</h1><p>{{section.settings.description|default:'Heavyweight cotton, utility cuts'}}</p><a href="{{section.settings.btn_url|default:'/collections/all'}}" style="background:#E11D48;color:#fff;padding:12px 20px;border-radius:8px;text-decoration:none">{{section.settings.btn_text|default:'Shop'}}</a></div><div>{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:1000}}" style="width:100%;height:400px;object-fit:cover;border-radius:12px">{% else %}{{'collection-1'|placeholder_svg_tag}}{% endif %}</div></div>{% schema %}{"name":"HP52 Hero Stats","settings":[{"type":"textarea","id":"heading","label":"Heading","default":"STREETWEAR v52"},{"type":"textarea","id":"description","label":"Desc","default":"Heavyweight cotton, utility cuts"},{"type":"text","id":"btn_text","label":"CTA","default":"Shop"},{"type":"url","id":"btn_url","label":"Link"},{"type":"image_picker","id":"image","label":"Image"}],"presets":[{"name":"HP52 Hero Stats"}]}{% endschema %}