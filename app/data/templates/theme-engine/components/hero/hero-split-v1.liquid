<div class="sf-hero-split js-motion-enabled sf-hero-{{ section.id }}">
  <div class="sf-hero-split__content">
    {% if section.settings.eyebrow != blank %}
      <span class="sf-reveal eyebrow sf-hero-split__eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    <h1 class="sf-reveal display-heading sf-hero-split__title">{{ section.settings.title }}</h1>
    {% if section.settings.subtitle != blank %}
      <p class="sf-reveal sf-hero-split__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
    
    <div class="sf-hero-split__actions sf-reveal">
      {% if section.settings.button_link != blank and section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="button button--primary">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
      {% if section.settings.button_link_2 != blank and section.settings.button_text_2 != blank %}
        <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">
          {{ section.settings.button_text_2 }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.trust_text != blank %}
      <div class="sf-hero-split__trust sf-reveal">
        {{ section.settings.trust_text }}
      </div>
    {% endif %}
  </div>
  <div class="sf-hero-split__media sf-reveal">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | img_url: 'master' }}" alt="{{ section.settings.title }}" loading="lazy" fetchpriority="high">
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'sf-placeholder-svg' }}
    {% endif %}
  </div>
</div>

<style>
  .sf-hero-{{ section.id }} {
    display: flex;
    flex-direction: column;
    background-color: var(--color-background);
    color: var(--color-text);
  }
  .sf-hero-split__content {
    padding: var(--spacing-section-y) var(--space-20);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .sf-hero-split__eyebrow {
    margin-bottom: var(--space-12);
  }
  .sf-hero-split__title {
    margin-bottom: var(--space-16);
    font-weight: var(--weight-display);
  }
  .sf-hero-split__subtitle {
    margin-bottom: var(--space-24);
    opacity: 0.9;
  }
  .sf-hero-split__actions {
    display: flex;
    gap: var(--space-16);
    flex-wrap: wrap;
    margin-bottom: var(--space-24);
  }
  .sf-hero-split__trust {
    font-size: var(--font-small);
    color: var(--color-text-muted);
  }
  .sf-hero-split__media {
    width: 100%;
    min-height: 300px;
    background-color: var(--color-surface);
  }
  .sf-hero-split__media img, .sf-hero-split__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sf-placeholder-svg {
    fill: var(--color-border);
  }
  .button {
    display: inline-block;
    padding: var(--space-12) var(--space-24);
    font-weight: var(--weight-heading);
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: var(--button-radius);
    transition: transform var(--transition-fast) ease, background-color var(--transition-fast) ease;
  }
  .button--primary {
    background-color: var(--color-accent);
    color: var(--color-background);
    border: 1px solid var(--color-accent);
  }
  .button--secondary {
    background-color: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-text);
  }
  .button:hover {
    transform: translateY(-2px);
  }
  
  /* Stagger animation overrides */
  .sf-hero-split__content > .sf-reveal:nth-child(1) { transition-delay: calc(var(--motion-stagger) * 1); }
  .sf-hero-split__content > .sf-reveal:nth-child(2) { transition-delay: calc(var(--motion-stagger) * 2); }
  .sf-hero-split__content > .sf-reveal:nth-child(3) { transition-delay: calc(var(--motion-stagger) * 3); }
  .sf-hero-split__content > .sf-reveal:nth-child(4) { transition-delay: calc(var(--motion-stagger) * 4); }
  .sf-hero-split__content > .sf-reveal:nth-child(5) { transition-delay: calc(var(--motion-stagger) * 5); }

  @media (min-width: 768px) {
    .sf-hero-{{ section.id }} {
      flex-direction: row;
      min-height: 80vh;
    }
    .sf-hero-split__content {
      width: 50%;
      padding: var(--spacing-section-y) 10%;
    }
    .sf-hero-split__media {
      width: 50%;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Split",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "New Arrival"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Add a descriptive subheading to guide the user."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Primary Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_text_2",
      "label": "Secondary Button Text"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button Link"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust Strip (Optional)",
      "info": "E.g., Free shipping on orders over $50"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Hero Split",
      "category": "Hero"
    }
  ]
}
{% endschema %}
