{%- style -%}
@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@600;800&family=Space+Grotesk:wght@500;700&display=swap');
#shopify-section-{{ section.id }}{--hp72-bg:{{section.settings.bg_color|default:'#F5F3FF'}};--hp72-accent:#7C3AED;background: var(--hp72-bg);color: {{section.settings.text_color|default:'#1E1B4B'}};font-family:'Space Grotesk',sans-serif;padding:0;position:relative;overflow:hidden}
#shopify-section-{{ section.id }}::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(90deg, rgba(255,255,255,.03) 0 1px, transparent 1px 80px), repeating-linear-gradient(0deg, rgba(255,255,255,.02) 0 1px, transparent 1px 80px);pointer-events:none}
.hp72-hero{max-width:{{section.settings.container_width|default:1280}}px;margin:0 auto;padding:70px 24px 70px;display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center;position:relative;z-index:1}
.hp72-kicker{display:inline-flex;gap:8px;align-items:center;padding:6px 14px;border:1px solid #7C3AED;background: #7C3AED14;color:#7C3AED;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;border-radius:4px}
.hp72-title{font-family:'JetBrains Mono',monospace;font-size:clamp(30px,4.8vw,54px);font-weight:800;line-height:1;text-transform:uppercase;margin:18px 0 14px;letter-spacing:-1px}
.hp72-title span{background:linear-gradient(90deg,#7C3AED,#A78BFA);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hp72-desc{opacity:.7;line-height:1.7;max-width:520px}
.hp72-cta{margin-top:22px;display:flex;gap:12px;flex-wrap:wrap}
.hp72-btn{padding:14px 26px;background:#7C3AED;color:#fff;font-weight:700;font-size:12px;letter-spacing:1.4px;text-transform:uppercase;text-decoration:none;border-radius:4px}
.hp72-btn--ghost{background:transparent;color:#7C3AED;border:1px solid #7C3AED}
.hp72-media{position:relative;border:1px solid #7C3AED40;border-radius:12px;overflow:hidden;height:520px;background:#000}
.hp72-media img{width:100%;height:100%;object-fit:cover;filter:contrast(1.1) saturate(1.2)}
.hp72-hud{position:absolute;bottom:12px;left:12px;right:12px;display:flex;justify-content:space-between;gap:10px}
.hp72-hud span{background:rgba(0,0,0,.7);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.15);color:#fff;padding:8px 12px;border-radius:6px;font-size:11px;font-family:'JetBrains Mono',monospace}
@media(max-width:992px){.hp72-hero{grid-template-columns:1fr;text-align:center}.hp72-cta{justify-content:center}.hp72-media{height:360px}}
{%- endstyle -%}
<div class="hp72-hero">
  <div>
    <div class="hp72-kicker"><span>⬢</span><span>{{section.settings.badge|default:'HOME DECOR // MATRIX v72'}}</span></div>
    <h1 class="hp72-title">{{section.settings.heading|default:'HOME <span>HOME-DECOR</span>'}}</h1>
    <p class="hp72-desc">{{section.settings.description|default:'Handcrafted ceramics & linens for lived-in spaces Cyber grid, terminal hud & drop-coded utility.'}}</p>
    <div class="hp72-cta"><a href="{{section.settings.btn_url|default:'/collections/all'}}" class="hp72-btn">{{section.settings.btn_text|default:'Enter Matrix'}}</a>{% if section.settings.btn2_text != blank %}<a href="{{section.settings.btn2_url}}" class="hp72-btn hp72-btn--ghost">{{section.settings.btn2_text}}</a>{% endif %}</div>
  </div>
  <div class="hp72-media">{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:1000}}" alt="{{section.settings.heading|strip_html}}" loading="eager">{% else %}{{'lifestyle-1'|placeholder_svg_tag}}{% endif %}<div class="hp72-hud"><span>● LIVE DROP</span><span>{{section.settings.float_sub|default:'50K VERIFIED'}}</span></div></div>
</div>
{% schema %}{"name":"HP72 Hero Cyber","settings":[{"type":"color","id":"bg_color","label":"BG","default":"#F5F3FF"},{"type":"color","id":"text_color","label":"Text","default":"#1E1B4B"},{"type":"text","id":"badge","label":"Badge","default":"HOME DECOR // MATRIX v72"},{"type":"textarea","id":"heading","label":"Heading","default":"HOME <span>HOME-DECOR</span>"},{"type":"textarea","id":"description","label":"Desc","default":"Handcrafted ceramics & linens for lived-in spaces"},{"type":"text","id":"btn_text","label":"CTA","default":"Enter Matrix"},{"type":"url","id":"btn_url","label":"Link"},{"type":"text","id":"btn2_text","label":"Ghost"},{"type":"url","id":"btn2_url","label":"Ghost link"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"float_sub","label":"HUD","default":"50K VERIFIED"},{"type":"range","id":"container_width","min":1000,"max":1440,"step":20,"unit":"px","label":"Width","default":1280}],"presets":[{"name":"HP72 Hero Cyber"}]}{% endschema %}