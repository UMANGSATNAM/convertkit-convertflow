{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Outfit:wght@300;400;600;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-orange: {{ section.settings.accent_orange }};
    --accent-yellow: {{ section.settings.accent_yellow }};
    --font-heading: 'Fraunces', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    /* Subtle grainy texture */
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp25-video-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp25-video-wrapper {
      padding: 0 20px;
    }
  }

  .hp25-video__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp25-video__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    font-style: italic;
    color: var(--text-color);
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-shadow: 3px 3px 0 var(--accent-orange);
  }

  /* The Vintage TV Set */
  .hp25-video__tv {
    background-color: var(--accent-yellow);
    border: 8px solid var(--text-color);
    border-radius: 40px;
    padding: 30px;
    box-shadow: 15px 15px 0 var(--text-color);
    display: flex;
    gap: 30px;
    position: relative;
  }

  @media screen and (max-width: 992px) {
    .hp25-video__tv {
      flex-direction: column;
      padding: 20px;
      border-radius: 20px;
      border-width: 4px;
      box-shadow: 8px 8px 0 var(--text-color);
    }
  }

  /* Screen Area */
  .hp25-video__screen-wrapper {
    flex: 1;
    position: relative;
    border: 6px solid var(--text-color);
    /* TV screen shape */
    border-radius: 50% / 10%;
    overflow: hidden;
    background: #000;
    aspect-ratio: 16/9;
  }
  
  .hp25-video__screen-inner {
    position: absolute;
    top: -5%;
    bottom: -5%;
    left: -5%;
    right: -5%;
    border-radius: 10% / 50%;
    overflow: hidden;
  }

  .hp25-video__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    filter: sepia(0.4) contrast(1.2) saturate(0.8);
  }

  .hp25-video__overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: repeating-linear-gradient(
      transparent,
      transparent 2px,
      rgba(0,0,0,0.1) 3px,
      rgba(0,0,0,0.1) 4px
    );
    pointer-events: none;
    z-index: 2;
  }

  /* TV Controls Panel */
  .hp25-video__controls-panel {
    width: 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
    padding: 20px 0;
    background: var(--bg-color);
    border: 4px solid var(--text-color);
    border-radius: 20px;
  }

  @media screen and (max-width: 992px) {
    .hp25-video__controls-panel {
      width: 100%;
      flex-direction: row;
      height: 80px;
      padding: 0 20px;
    }
  }

  .hp25-video__dial {
    width: 60px;
    height: 60px;
    background: var(--text-color);
    border-radius: 50%;
    position: relative;
    box-shadow: inset -5px -5px 0 rgba(0,0,0,0.3);
  }

  .hp25-video__dial::after {
    content: '';
    position: absolute;
    top: 10px;
    left: 50%;
    width: 4px;
    height: 15px;
    background: var(--bg-color);
    transform: translateX(-50%);
    border-radius: 2px;
  }

  .hp25-video__speaker {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  @media screen and (max-width: 992px) {
    .hp25-video__speaker {
      flex-direction: row;
    }
  }

  .hp25-video__speaker span {
    display: block;
    width: 40px;
    height: 6px;
    background: var(--text-color);
    border-radius: 3px;
  }

  @media screen and (max-width: 992px) {
    .hp25-video__speaker span {
      width: 6px;
      height: 40px;
    }
  }

  /* Play Button Overlay */
  .hp25-video__play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    background: var(--accent-orange);
    border: 4px solid var(--text-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    transition: all 0.3s ease;
    box-shadow: 4px 4px 0 var(--text-color);
  }

  .hp25-video__play-btn:hover {
    transform: translate(-50%, -50%) scale(1.1);
    background: var(--accent-yellow);
  }

  .hp25-video__play-btn svg {
    width: 40px;
    height: 40px;
    fill: var(--text-color);
    margin-left: 5px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp25-video-wrapper" id="HP25Video-{{ section.id }}">
  <div class="hp25-video__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp25-video__title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

  <div class="hp25-video__tv">
    
    <div class="hp25-video__screen-wrapper">
      <div class="hp25-video__screen-inner">
        {%- if section.settings.video_url != blank -%}
          {%- if section.settings.video_url contains 'youtube' or section.settings.video_url contains 'youtu.be' -%}
            <iframe class="hp25-video__media" src="https://www.youtube.com/embed/{{ section.settings.video_url | split: 'v=' | last | split: '&' | first }}?autoplay=0&controls=0&mute=1&loop=1&playlist={{ section.settings.video_url | split: 'v=' | last | split: '&' | first }}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
          {%- elsif section.settings.video_url contains 'vimeo' -%}
            <iframe class="hp25-video__media" src="https://player.vimeo.com/video/{{ section.settings.video_url | split: '/' | last }}?background=1&autoplay=0&loop=1&byline=0&title=0" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
          {%- else -%}
            <video class="hp25-video__media" autoplay muted loop playsinline>
              <source src="{{ section.settings.video_url }}" type="video/mp4">
            </video>
          {%- endif -%}
        {%- else -%}
          <div style="width:100%;height:100%;background:#D15F3C;"></div>
        {%- endif -%}
        
        <div class="hp25-video__overlay"></div>
        
        <div class="hp25-video__play-btn">
          <svg viewBox="0 0 24 24"><path d="M8,5.14V19.14L19,12.14L8,5.14Z"/></svg>
        </div>
      </div>
    </div>

    <div class="hp25-video__controls-panel">
      <div class="hp25-video__dial" style="transform: rotate(45deg);"></div>
      <div class="hp25-video__dial" style="transform: rotate(-30deg);"></div>
      <div class="hp25-video__speaker">
        <span></span><span></span><span></span><span></span>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP25 - Retro Video",
  "class": "section-hp25-video-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "TUNE IN"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (MP4, YouTube, Vimeo)",
      "info": "Leave blank to show placeholder color"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 50
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "header",
      "content": "Retro 70s Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5E6D3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text / Border (Dark Brown)",
      "default": "#3E2723"
    },
    {
      "type": "color",
      "id": "accent_orange",
      "label": "Accent (Burnt Orange)",
      "default": "#D15F3C"
    },
    {
      "type": "color",
      "id": "accent_yellow",
      "label": "Accent (Mustard)",
      "default": "#E2B144"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP25 - Retro Video"
    }
  ]
}
{% endschema %}
