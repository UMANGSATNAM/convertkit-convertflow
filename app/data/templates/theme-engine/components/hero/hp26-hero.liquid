{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Cormorant Garamond', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp26-hero-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
    min-height: {{ section.settings.min_height }}vh;
  }

  @media screen and (max-width: 1024px) {
    .hp26-hero-wrapper {
      gap: 50px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp26-hero-wrapper {
      flex-direction: column;
      padding: 0 20px;
      text-align: center;
      gap: 40px;
      min-height: auto;
    }
  }

  .hp26-hero__content {
    flex: 1;
    max-width: 500px;
    z-index: 2;
  }

  @media screen and (max-width: 768px) {
    .hp26-hero__content {
      max-width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  }

  .hp26-hero__subtitle {
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-color);
    margin-bottom: 25px;
    opacity: 0.7;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .hp26-hero__subtitle::before {
    content: '';
    display: block;
    width: 30px;
    height: 1px;
    background-color: var(--text-color);
    opacity: 0.5;
  }

  @media screen and (max-width: 768px) {
    .hp26-hero__subtitle::before {
      display: none;
    }
  }

  .hp26-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    line-height: 1.05;
    color: var(--text-color);
    margin: 0 0 30px;
  }

  .hp26-hero__title em {
    font-style: italic;
    color: var(--accent-color);
    font-weight: 300;
  }

  .hp26-hero__text {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.5vw, {{ section.settings.text_size }}px);
    line-height: 1.7;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0 0 40px;
    max-width: 90%;
  }

  @media screen and (max-width: 768px) {
    .hp26-hero__text {
      max-width: 100%;
    }
  }

  .hp26-hero__actions {
    display: flex;
    gap: 20px;
    align-items: center;
  }

  @media screen and (max-width: 480px) {
    .hp26-hero__actions {
      flex-direction: column;
      width: 100%;
    }
  }

  .hp26-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background-color: var(--text-color);
    color: var(--bg-color);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.4s ease;
    border: 1px solid var(--text-color);
  }

  .hp26-hero__btn:hover {
    background-color: transparent;
    color: var(--text-color);
  }

  .hp26-hero__btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background-color: transparent;
    color: var(--text-color);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.4s ease;
    position: relative;
  }

  .hp26-hero__btn-secondary::after {
    content: '';
    position: absolute;
    bottom: 12px;
    left: 40px;
    right: 40px;
    height: 1px;
    background-color: var(--text-color);
    opacity: 0.3;
    transition: opacity 0.4s ease, bottom 0.4s ease;
  }

  .hp26-hero__btn-secondary:hover::after {
    opacity: 1;
    bottom: 8px;
  }

  .hp26-hero__image-col {
    flex: 1;
    position: relative;
    display: flex;
    justify-content: flex-end;
  }

  @media screen and (max-width: 768px) {
    .hp26-hero__image-col {
      width: 100%;
      justify-content: center;
    }
  }

  .hp26-hero__image-wrapper {
    position: relative;
    width: 80%;
    aspect-ratio: 3/4;
    border-radius: 200px 200px 0 0; /* Arched window shape */
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    .hp26-hero__image-wrapper {
      width: 100%;
      max-width: 400px;
    }
  }

  .hp26-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    transition: transform 1.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp26-hero-wrapper:hover .hp26-hero__image {
    transform: scale(1);
  }

  /* Decorative secondary image (offset) */
  .hp26-hero__image-secondary {
    position: absolute;
    bottom: -40px;
    left: -40px;
    width: 45%;
    aspect-ratio: 4/5;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
  }

  @media screen and (max-width: 768px) {
    .hp26-hero__image-secondary {
      display: none;
    }
  }

  .hp26-hero__image-secondary img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp26-hero-wrapper" id="HP26Hero-{{ section.id }}">
  
  <div class="hp26-hero__content">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp26-hero__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="hp26-hero__title">{{ section.settings.title }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hp26-hero__text">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="hp26-hero__actions">
      {%- if section.settings.btn_text != blank -%}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="hp26-hero__btn">
          {{ section.settings.btn_text }}
        </a>
      {%- endif -%}

      {%- if section.settings.btn_secondary_text != blank -%}
        <a href="{{ section.settings.btn_secondary_link | default: '#' }}" class="hp26-hero__btn-secondary">
          {{ section.settings.btn_secondary_text }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="hp26-hero__image-col">
    <div class="hp26-hero__image-wrapper">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title | escape }}" class="hp26-hero__image" loading="lazy">
      {%- else -%}
        <div style="width:100%;height:100%;background:#E0D5C1;display:flex;align-items:center;justify-content:center;color:#2C2A28;font-family:var(--font-body);font-weight:300;">Primary Image</div>
      {%- endif -%}
    </div>

    <div class="hp26-hero__image-secondary">
      {%- if section.settings.image_secondary != blank -%}
        <img src="{{ section.settings.image_secondary | image_url: width: 600 }}" alt="Secondary Image" loading="lazy">
      {%- else -%}
        <div style="width:100%;height:100%;background:#8B9582;display:flex;align-items:center;justify-content:center;color:#fff;font-family:var(--font-body);font-weight:300;">Accent Image</div>
      {%- endif -%}
    </div>
  </div>

</div>

{% schema %}
{
  "name": "HP26 - Japandi Hero",
  "class": "section-hp26-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "ELEVATED ESSENTIALS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Mindful living,<br><em>curated design.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Discover our collection of thoughtfully crafted pieces that bring harmony and balance to your everyday spaces.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Primary Button Text",
      "default": "SHOP COLLECTION"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn_secondary_text",
      "label": "Secondary Button Text",
      "default": "DISCOVER MORE"
    },
    {
      "type": "url",
      "id": "btn_secondary_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Primary Image (Arched)"
    },
    {
      "type": "image_picker",
      "id": "image_secondary",
      "label": "Secondary Image (Offset block)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Minimum Height (Desktop)",
      "default": 85
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 72
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Japandi Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5F2EB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C2A28"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8B9582"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP26 - Japandi Hero"
    }
  ]
}
{% endschema %}
