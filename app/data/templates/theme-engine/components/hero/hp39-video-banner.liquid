{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    
    --font-heading: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding: 80px 20px;
  }

  .hp39-video-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    border-radius: 40px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 16/9;
    box-shadow: 0 30px 60px rgba(0,0,0,0.08);
  }

  @media screen and (max-width: 768px) {
    .hp39-video-wrapper {
      border-radius: 30px;
      aspect-ratio: 4/3;
    }
  }

  .hp39-video__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hp39-video__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.1);
    z-index: 2;
    pointer-events: none;
  }

  .hp39-video__play-btn {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    cursor: pointer;
    pointer-events: auto;
    transition: transform 0.3s ease, background 0.3s ease;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }

  .hp39-video__play-btn:hover {
    transform: scale(1.1);
    background: rgba(255, 255, 255, 0.6);
  }

  .hp39-video__play-btn svg {
    width: 40px;
    height: 40px;
    fill: currentColor;
    margin-left: 6px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp39-video-wrapper" id="HP39Video-{{ section.id }}">
  {%- if section.settings.video_url != blank -%}
    {%- if section.settings.video_url.type == 'youtube' -%}
      <iframe class="hp39-video__media" src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=0&controls=0&mute=1&loop=1&playlist={{ section.settings.video_url.id }}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
    {%- elsif section.settings.video_url.type == 'vimeo' -%}
      <iframe class="hp39-video__media" src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?background=1" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
    {%- endif -%}
  {%- else -%}
    {{ 'lifestyle-2' | placeholder_svg_tag: 'hp39-video__media' }}
  {%- endif -%}

  <div class="hp39-video__overlay">
    <button class="hp39-video__play-btn" aria-label="Play Video">
      <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
    </button>
  </div>
</div>

{% schema %}
{
  "name": "HP39 - Aura Video",
  "class": "section-hp39-video-banner",
  "settings": [
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "Video URL"
    },
    {
      "type": "header",
      "content": "Aura Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#faf9f8"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP39 - Aura Video"
    }
  ]
}
{% endschema %}
