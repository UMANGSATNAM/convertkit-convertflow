{% comment %}
  Hero Split Luxury - 50/50 Dual Column Hero
  Category: hero
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --hero-bg: {{ section.settings.bg_color | default: '#fafaf9' }};
    --hero-text: {{ section.settings.text_color | default: '#1c1917' }};
    --hero-accent: {{ section.settings.accent_color | default: '#0f766e' }};
    background-color: var(--hero-bg);
    color: var(--hero-text);
    padding: clamp(40px, 8vw, 90px) 24px;
    font-family: inherit;
    position: relative;
    overflow: hidden;
  }

  .cf-split-hero-container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  @media (max-width: 900px) {
    .cf-split-hero-container {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }

  .cf-split-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  @media (max-width: 900px) {
    .cf-split-content {
      align-items: center;
    }
  }

  .cf-split-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(15, 118, 110, 0.1);
    color: var(--hero-accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    width: fit-content;
  }

  .cf-split-title {
    font-size: clamp(34px, 4.5vw, 62px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--hero-text);
  }

  .cf-split-title em {
    font-style: italic;
    font-weight: 400;
    color: var(--hero-accent);
  }

  .cf-split-desc {
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.6;
    color: rgba(28, 25, 23, 0.75);
    max-width: 520px;
    margin: 0;
  }

  .cf-split-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .cf-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--hero-accent);
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 28px;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 14px rgba(15, 118, 110, 0.25);
  }

  .cf-btn-primary:hover {
    transform: translateY(-2px);
    opacity: 0.95;
    box-shadow: 0 6px 20px rgba(15, 118, 110, 0.35);
  }

  .cf-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--hero-text);
    font-size: 15px;
    font-weight: 600;
    padding: 14px 24px;
    border-radius: 10px;
    text-decoration: none;
    border: 1px solid rgba(28, 25, 23, 0.2);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .cf-btn-secondary:hover {
    background: rgba(28, 25, 23, 0.05);
    border-color: var(--hero-text);
  }

  .cf-split-proof {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
    font-size: 13px;
    color: rgba(28, 25, 23, 0.65);
  }

  .cf-stars {
    color: #f59e0b;
    letter-spacing: 2px;
  }

  .cf-split-visual-wrap {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.15);
    background: #e7e5e4;
    aspect-ratio: 4 / 3.8;
  }

  .cf-split-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cf-split-visual-wrap:hover .cf-split-img {
    transform: scale(1.03);
  }

  .cf-floating-pill {
    position: absolute;
    bottom: 24px;
    left: 24px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    padding: 12px 18px;
    border-radius: 14px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cf-floating-pill-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(15, 118, 110, 0.1);
    color: var(--hero-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
  }

  .cf-floating-pill-title {
    font-size: 12px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
  }

  .cf-floating-pill-sub {
    font-size: 11px;
    color: #64748b;
  }
{%- endstyle -%}

<div class="cf-split-hero-container">
  <div class="cf-split-content">
    <div class="cf-split-badge">
      <span>✨</span>
      <span>{{ section.settings.badge | default: 'AWARD WINNING FORMULA' }}</span>
    </div>

    <h1 class="cf-split-title">
      {{ section.settings.heading | default: 'Science-backed skincare for <em>radiant</em> mornings.' }}
    </h1>

    <p class="cf-split-desc">
      {{ section.settings.subheading | default: 'Formulated with cold-pressed botanical active oils that deeply penetrate, restore skin barriers, and boost 72-hour deep cellular hydration.' }}
    </p>

    <div class="cf-split-actions">
      <a href="{{ section.settings.primary_url | default: '/collections/all' }}" class="cf-btn-primary">
        {{ section.settings.primary_label | default: 'Shop the Collection' }}
      </a>
      {% if section.settings.secondary_label != blank %}
        <a href="{{ section.settings.secondary_url | default: '/pages/about' }}" class="cf-btn-secondary">
          {{ section.settings.secondary_label | default: 'Our Clinical Results' }}
        </a>
      {% endif %}
    </div>

    <div class="cf-split-proof">
      <span class="cf-stars">★★★★★</span>
      <span><strong>4.9/5</strong> from 3,800+ verified customer reviews</span>
    </div>
  </div>

  <div class="cf-split-visual-wrap">
    <img
      src="{{ section.settings.image | default: 'https://images.unsplash.com/photo-1556228720-195a672e8a03?w=1000&q=80' }}"
      alt="{{ section.settings.heading | escape }}"
      class="cf-split-img"
      loading="eager"
      width="700"
      height="650"
    >

    <div class="cf-floating-pill">
      <div class="cf-floating-pill-icon">✓</div>
      <div>
        <div class="cf-floating-pill-title">Dermatologist Approved</div>
        <div class="cf-floating-pill-sub">Zero Parabens &middot; 100% Vegan</div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Split Luxury",
  "tag": "section",
  "class": "cf-hero-split-luxury-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#fafaf9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1c1917"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#0f766e"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge label",
      "default": "AWARD WINNING FORMULA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Science-backed skincare for radiant mornings."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Formulated with cold-pressed botanical active oils that deeply penetrate, restore skin barriers, and boost 72-hour deep cellular hydration."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Our Clinical Results"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "image",
      "label": "Image URL",
      "default": "https://images.unsplash.com/photo-1556228720-195a672e8a03?w=1000&q=80"
    }
  ],
  "presets": [
    {
      "name": "Hero Split Luxury",
      "settings": {
        "bg_color": "#fafaf9",
        "text_color": "#1c1917",
        "accent_color": "#0f766e",
        "badge": "AWARD WINNING FORMULA",
        "heading": "Science-backed skincare for radiant mornings.",
        "primary_label": "Shop the Collection"
      }
    }
  ]
}
{% endschema %}
