{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito:wght@300;400;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --button-bg: {{ section.settings.button_bg }};
    --button-text: {{ section.settings.button_text }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Nunito', sans-serif;
    
    position: relative;
    background-color: var(--bg-color);
  }

  .hp35-hero {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.hero_height }}vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* Soft, organic background */
  .hp35-hero__bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 1;
  }
  
  .hp35-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
  }

  .hp35-hero__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to top, var(--bg-color) 0%, transparent 50%, var(--bg-color) 100%);
    opacity: 0.7;
    z-index: 2;
  }

  .hp35-hero__content {
    position: relative;
    z-index: 3;
    max-width: 900px;
    padding: 0 40px;
    text-align: center;
    margin-top: 50px;
  }

  @media screen and (max-width: 768px) {
    .hp35-hero__content {
      padding: 0 20px;
    }
  }

  .hp35-hero__subtitle {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 30px;
    font-weight: 400;
  }
  
  .hp35-hero__subtitle i {
    font-style: italic;
    font-family: var(--font-heading);
    text-transform: lowercase;
    font-size: 18px;
    margin: 0 8px;
  }

  .hp35-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(48px, 8vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 30px;
    font-weight: 400;
  }

  .hp35-hero__title em {
    font-style: italic;
    color: var(--button-bg); /* Use button bg as a subtle accent */
  }

  .hp35-hero__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-color);
    margin: 0 auto 40px;
    max-width: 600px;
    font-weight: 300;
  }

  .hp35-hero__actions {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hp35-hero__btn {
    font-family: var(--font-body);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    padding: 18px 40px;
    border-radius: 50px; /* Soft pill shape */
    font-weight: 600;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hp35-hero__btn--primary {
    background-color: var(--button-bg);
    color: var(--button-text);
  }

  .hp35-hero__btn--primary:hover {
    background-color: var(--text-color);
    color: var(--bg-color);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
  }

  .hp35-hero__btn--secondary {
    background-color: transparent;
    color: var(--text-color);
    border: 1px solid var(--text-color);
  }

  .hp35-hero__btn--secondary:hover {
    background-color: var(--text-color);
    color: var(--bg-color);
    transform: translateY(-2px);
  }

  /* Organic floating shape */
  .hp35-hero__shape {
    position: absolute;
    width: 60vw;
    height: 60vw;
    background: radial-gradient(circle, var(--button-bg) 0%, transparent 70%);
    opacity: 0.1;
    border-radius: 50%;
    filter: blur(60px);
    top: -20%;
    right: -10%;
    z-index: 1;
    pointer-events: none;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp35-hero">
  <div class="hp35-hero__shape"></div>
  
  <div class="hp35-hero__bg">
    {%- if section.settings.bg_image != blank -%}
      <img src="{{ section.settings.bg_image | image_url: width: 2000 }}" alt="Hero Background" loading="eager">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  
  <div class="hp35-hero__overlay"></div>

  <div class="hp35-hero__content">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp35-hero__subtitle">{{ section.settings.subtitle | replace: 'and', '<i>and</i>' }}</div>
    {%- endif -%}
    
    <h1 class="hp35-hero__title">{{ section.settings.title }}</h1>
    
    {%- if section.settings.text != blank -%}
      <p class="hp35-hero__text">{{ section.settings.text }}</p>
    {%- endif -%}

    <div class="hp35-hero__actions">
      {%- if section.settings.btn_1_label != blank -%}
        <a href="{{ section.settings.btn_1_link | default: '#' }}" class="hp35-hero__btn hp35-hero__btn--primary">
          {{ section.settings.btn_1_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.btn_2_label != blank -%}
        <a href="{{ section.settings.btn_2_link | default: '#' }}" class="hp35-hero__btn hp35-hero__btn--secondary">
          {{ section.settings.btn_2_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP35 - Organic Hero",
  "class": "section-hp35-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "CONSCIOUS and CURATED"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Return to <em>nature.</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Embrace the beauty of imperfection. Sustainably crafted pieces for a mindful life."
    },
    {
      "type": "text",
      "id": "btn_1_label",
      "label": "Primary Button",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "btn_1_link",
      "label": "Primary Link"
    },
    {
      "type": "text",
      "id": "btn_2_label",
      "label": "Secondary Button",
      "default": "Our Philosophy"
    },
    {
      "type": "url",
      "id": "btn_2_link",
      "label": "Secondary Link"
    },
    {
      "type": "header",
      "content": "Sizing"
    },
    {
      "type": "range",
      "id": "hero_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Hero Height",
      "default": 90
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Overlay (e.g. Warm Sand)",
      "default": "#F4F0EA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color (e.g. Deep Forest/Charcoal)",
      "default": "#2C422F"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background (e.g. Terracotta)",
      "default": "#CC7B5E"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP35 - Organic Hero"
    }
  ]
}
{% endschema %}
