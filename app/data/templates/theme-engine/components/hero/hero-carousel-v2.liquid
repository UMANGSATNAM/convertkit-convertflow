{% schema %}
{
  "name": "Carousel Hero (Lifestyle)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay speed",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "New Arrivals"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Collection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carousel Hero (Lifestyle)",
      "category": "Hero",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}

<div class="hero-carousel hero-carousel--lifestyle" data-autoplay="{{ section.settings.autoplay_speed | times: 1000 }}" style="position: relative; overflow: hidden; width: 100%; height: 80vh;">
  <div class="hero-carousel__track" style="display: flex; height: 100%; transition: transform 0.5s ease-in-out;">
    {% for block in section.blocks %}
      <div class="hero-carousel__slide" style="flex: 0 0 100%; position: relative;" {{ block.shopify_attributes }}>
        {% if block.settings.image %}
          <img src="{{ block.settings.image | image_url: width: 1500 }}" alt="{{ block.settings.heading | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
        {% else %}
          {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
        
        <div class="hero-carousel__content" style="position: absolute; bottom: 10%; left: 5%; background: var(--color-bg); padding: 2rem; max-width: 400px; box-shadow: var(--shadow-md);">
          <h2 style="font-family: var(--font-heading-family); color: var(--color-text); margin-bottom: 1rem;">{{ block.settings.heading }}</h2>
          {% if block.settings.button_label != blank %}
            <a href="{{ block.settings.button_link }}" class="btn btn--primary" style="background-color: var(--color-primary); color: var(--color-bg); padding: 0.8rem 1.5rem; text-decoration: none; display: inline-block;">
              {{ block.settings.button_label }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>
