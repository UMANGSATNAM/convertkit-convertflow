{% schema %}
{
  "name": "Magazine Hero (Home v2)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "image_picker",
      "id": "secondary_image",
      "label": "Secondary Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover the Collection"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Magazine Hero (Home v2)",
      "category": "Hero"
    }
  ]
}
{% endschema %}

<div class="hero-magazine hero-magazine--home" style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 2rem; max-width: 1400px; margin: 0 auto; padding: 4rem 2rem;">
  <div class="hero-magazine__main" style="position: relative;">
    {% if section.settings.main_image %}
      <img src="{{ section.settings.main_image | image_url: width: 1500 }}" alt="{{ section.settings.heading | escape }}" style="width: 100%; height: 80vh; object-fit: cover;">
    {% else %}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
    
    <div class="hero-magazine__text" style="position: absolute; bottom: 10%; left: -5%; background: var(--color-bg); padding: 3rem; max-width: 500px; z-index: 2; border: 1px solid var(--color-text);">
      <span style="font-family: var(--font-body-family); text-transform: uppercase; letter-spacing: 0.2em; font-size: 0.8rem; margin-bottom: 1rem; display: block;">{{ section.settings.eyebrow }}</span>
      <h1 style="font-family: var(--font-heading-family); font-size: 3.5rem; line-height: 1.1; margin-bottom: 2rem;">{{ section.settings.heading }}</h1>
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="btn btn--secondary" style="color: var(--color-text); text-transform: uppercase; letter-spacing: 0.1em; text-decoration: none; border-bottom: 1px solid var(--color-text); padding-bottom: 0.2rem;">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
  
  <div class="hero-magazine__secondary" style="padding-top: 20%;">
    {% if section.settings.secondary_image %}
      <img src="{{ section.settings.secondary_image | image_url: width: 1500 }}" alt="Secondary Feature" style="width: 100%; height: 50vh; object-fit: cover;">
    {% else %}
      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>
</div>
