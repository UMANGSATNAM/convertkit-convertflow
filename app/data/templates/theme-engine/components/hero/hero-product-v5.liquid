{%- assign featured_collection = collections[section.settings.collection] -%}
{%- assign product_count = featured_collection.products.size | default: 0 -%}

{% if product_count >= 2 %}
<div class="sf-hero-product js-motion-enabled sf-hero-{{ section.id }}">
  <div class="sf-hero-product__content">
    {% if section.settings.eyebrow != blank %}
      <span class="sf-reveal eyebrow sf-hero-product__eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    <h1 class="sf-reveal display-heading sf-hero-product__title">{{ section.settings.title }}</h1>
    {% if section.settings.subtitle != blank %}
      <p class="sf-reveal sf-hero-product__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
    
    <div class="sf-hero-product__actions sf-reveal">
      {% if section.settings.button_link != blank and section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="button button--primary">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
      {% if section.settings.button_link_2 != blank and section.settings.button_text_2 != blank %}
        <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">
          {{ section.settings.button_text_2 }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.trust_text != blank %}
      <div class="sf-hero-product__trust sf-reveal">
        {{ section.settings.trust_text }}
      </div>
    {% endif %}
  </div>
  
  <div class="sf-hero-product__products sf-reveal">
    <div class="sf-hero-product__grid">
      {% for product in featured_collection.products limit: 3 %}
        {% render 'product-card-snippet', product: product %}
      {% else %}
        <!-- Fallback placeholders if collection empty in editor -->
        {% for i in (1..3) %}
          <div class="sf-product-placeholder">
            {{ 'product-' | append: i | placeholder_svg_tag: 'sf-placeholder-svg' }}
            <div class="sf-product-placeholder__info">
              <span>Example Product</span>
              <span>$99.00</span>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .sf-hero-{{ section.id }} {
    display: flex;
    flex-direction: column;
    background-color: var(--color-background);
    color: var(--color-text);
  }
  .sf-hero-product__content {
    padding: var(--spacing-section-y) var(--space-20) 0 var(--space-20);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .sf-hero-product__eyebrow {
    margin-bottom: var(--space-12);
  }
  .sf-hero-product__title {
    margin-bottom: var(--space-16);
    font-weight: var(--weight-display);
  }
  .sf-hero-product__subtitle {
    margin-bottom: var(--space-24);
    opacity: 0.9;
  }
  .sf-hero-product__actions {
    display: flex;
    gap: var(--space-16);
    flex-wrap: wrap;
    margin-bottom: var(--space-24);
  }
  .sf-hero-product__trust {
    font-size: var(--font-small);
    color: var(--color-text-muted);
  }
  
  .sf-hero-product__products {
    width: 100%;
    padding: var(--space-24) var(--space-20) var(--spacing-section-y) var(--space-20);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .sf-hero-product__products::-webkit-scrollbar {
    display: none;
  }
  .sf-hero-product__grid {
    display: flex;
    gap: var(--space-16);
    min-width: max-content;
  }
  .sf-hero-product__grid > * {
    width: 280px;
    scroll-snap-align: start;
    flex-shrink: 0;
  }

  .sf-product-placeholder {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card, 4px);
  }
  .sf-product-placeholder svg {
    width: 100%;
    height: auto;
    fill: var(--color-border);
  }
  .sf-product-placeholder__info {
    padding: var(--space-16);
    display: flex;
    justify-content: space-between;
    font-weight: var(--weight-heading);
  }

  .button {
    display: inline-block;
    padding: var(--space-12) var(--space-24);
    font-weight: var(--weight-heading);
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: var(--button-radius);
    transition: transform var(--transition-fast) ease, background-color var(--transition-fast) ease;
  }
  .button--primary {
    background-color: var(--color-accent);
    color: var(--color-background);
    border: 1px solid var(--color-accent);
  }
  .button--secondary {
    background-color: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-text);
  }
  .button:hover {
    transform: translateY(-2px);
  }
  
  /* Stagger animation overrides */
  .sf-hero-product__content > .sf-reveal:nth-child(1) { transition-delay: calc(var(--motion-stagger) * 1); }
  .sf-hero-product__content > .sf-reveal:nth-child(2) { transition-delay: calc(var(--motion-stagger) * 2); }
  .sf-hero-product__content > .sf-reveal:nth-child(3) { transition-delay: calc(var(--motion-stagger) * 3); }
  .sf-hero-product__content > .sf-reveal:nth-child(4) { transition-delay: calc(var(--motion-stagger) * 4); }
  .sf-hero-product__content > .sf-reveal:nth-child(5) { transition-delay: calc(var(--motion-stagger) * 5); }
  .sf-hero-product__products.sf-reveal { transition-delay: calc(var(--motion-stagger) * 6); }

  @media (min-width: 768px) {
    .sf-hero-{{ section.id }} {
      flex-direction: row;
      min-height: 80vh;
      align-items: center;
    }
    .sf-hero-product__content {
      width: 40%;
      padding: var(--spacing-section-y) 5%;
    }
    .sf-hero-product__products {
      width: 60%;
      padding: var(--spacing-section-y) 5% var(--spacing-section-y) 0;
      overflow-x: visible;
    }
    .sf-hero-product__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      min-width: 0;
    }
    .sf-hero-product__grid > * {
      width: auto;
    }
  }
</style>

{% else %}
  <!-- Fallback to Hero V1 if <2 products -->
  {% render 'hero-split-v1-fallback', section: section %}
{% endif %}

{% schema %}
{
  "name": "Hero Product Showcase",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured Collection",
      "info": "Needs at least 2 products. If fewer, section falls back to Split layout."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "New Arrival"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Add a descriptive subheading to guide the user."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Primary Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust Strip (Optional)",
      "info": "E.g., Free shipping on orders over $50"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback Image",
      "info": "Used if section falls back to Split layout."
    }
  ],
  "presets": [
    {
      "name": "Hero Product Showcase",
      "category": "Hero"
    }
  ]
}
{% endschema %}
