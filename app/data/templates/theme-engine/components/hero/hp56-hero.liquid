{%- style -%}
@import url('https://fonts.googleapis.com/css2?family=Anton&family=Space+Mono&display=swap');
#shopify-section-{{ section.id }}{border-top:6px solid #B45309;border-bottom:6px solid #111}
.hp56-grid{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1.1fr .9fr;min-height:520px}
.hp56-left{padding:40px 24px;border-right:6px solid #111}
.hp56-h{font-family:'Anton',sans-serif;font-size:clamp(42px,6vw,74px);text-transform:uppercase}
.hp56-h span{color:#B45309}
@media(max-width:900px){.hp56-grid{grid-template-columns:1fr}}
{%- endstyle -%}
<div class="hp56-grid"><div class="hp56-left"><h1 class="hp56-h">{{section.settings.heading|default:'RAW <span>ETHNIC-WEAR</span>'}}</h1><p>{{section.settings.description|default:'Handloom sarees rooted in craft'}}</p><a href="{{section.settings.btn_url|default:'/collections/all'}}" style="background:#B45309;padding:12px 20px;text-decoration:none;font-weight:700">{{section.settings.btn_text|default:'Shop'}}</a></div><div>{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:1000}}" style="width:100%;height:520px;object-fit:cover">{% else %}{{'product-1'|placeholder_svg_tag}}{% endif %}</div></div>
{% schema %}{"name":"HP56 Hero Brutalist","settings":[{"type":"textarea","id":"heading","label":"Heading","default":"RAW ethnic-wear"},{"type":"textarea","id":"description","label":"Desc","default":"Handloom sarees rooted in craft"},{"type":"text","id":"btn_text","label":"CTA","default":"Shop"},{"type":"url","id":"btn_url","label":"Link"},{"type":"image_picker","id":"image","label":"Image"}],"presets":[{"name":"HP56 Hero Brutalist"}]}{% endschema %}