{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 80px 20px;
    border-bottom: 3px solid #000;
  }
  
  .hp11-video-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    border: 4px solid #000;
    box-shadow: 10px 10px 0 #000;
    overflow: hidden;
    padding-top: 56.25%; /* 16:9 Aspect Ratio */
    background: #000;
  }
  
  .hp11-video-element-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }
  
  .hp11-video-overlay-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
  }
  
  .hp11-video-play-btn-{{ section_id }} {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: #FF00FF;
    border: 4px solid #000;
    box-shadow: 4px 4px 0 #000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease;
    margin-bottom: 20px;
  }
  
  .hp11-video-play-btn-{{ section_id }} svg {
    width: 40px;
    height: 40px;
    fill: #FFF;
    margin-left: 5px;
  }
  
  .hp11-video-play-btn-{{ section_id }}:hover {
    transform: scale(1.1);
    background: #CCFF00;
  }
  
  .hp11-video-heading-{{ section_id }} {
    color: #FFF;
    font-family: 'Inter', sans-serif;
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
    letter-spacing: -2px;
    -webkit-text-stroke: 1px #000;
    text-shadow: 3px 3px 0 #000;
  }

  @media (max-width: 768px) {
    .hp11-video-container-{{ section_id }} {
      padding-top: 100%; /* Square on mobile */
    }
  }
</style>

<div class="hp11-video-container-{{ section_id }}">
  {% if section.settings.video_url != blank %}
    <!-- Placeholder for video integration -->
    <div class="hp11-video-element-{{ section_id }}"></div>
  {% else %}
    {% if section.settings.cover_image != blank %}
      <img height="{{ section.settings.cover_image.height }}" width="{{ section.settings.cover_image.width }}" src="{{ section.settings.cover_image | image_url: width: 2000 }}" class="hp11-video-element-{{ section_id }}" alt="Video Cover">
    {% endif %}
  {% endif %}
  
  <div class="hp11-video-overlay-{{ section_id }}">
    <div class="hp11-video-play-btn-{{ section_id }}">
      <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
    </div>
    {% if section.settings.heading != blank %}
      <h2 class="hp11-video-heading-{{ section_id }}">{{ section.settings.heading }}</h2>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP11 Video",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WATCH THE CAMPAIGN"
    }
  ],
  "presets": [
    {
      "name": "HP11 Video"
    }
  ]
}
{% endschema %}
