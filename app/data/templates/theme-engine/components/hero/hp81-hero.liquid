{%- style -%}
@import url('https://fonts.googleapis.com/css2?family=Syne:wght@600;800&family=Inter:wght@400;500&display=swap');
#shopify-section-{{ section.id }}{background:{{section.settings.bg_color|default:'#ffffff'}};color:{{section.settings.text_color|default:'#134E4A'}};text-align:center;padding:60px 0}
.hp81-inner{max-width:820px;margin:0 auto;padding:0 24px}
.hp81-pill{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#0D9488;border:1px solid #0D948830;padding:6px 12px;border-radius:999px}
.hp81-h{font-family:'Syne',sans-serif;font-size:clamp(36px,6vw,64px);font-weight:800;line-height:1;margin:16px 0 12px}
.hp81-p{opacity:.6;line-height:1.8;margin:0 auto 22px;max-width:600px}
.hp81-btns{display:flex;gap:12px;justify-content:center;margin-bottom:28px;flex-wrap:wrap}
.hp81-btn{padding:14px 26px;background:#0D9488;color:#fff;border-radius:999px;text-decoration:none;font-weight:700;font-size:13px}
.hp81-btn--line{background:#fff;color:#0D9488;border:1.5px solid #0D9488}
.hp81-media{border-radius:20px;overflow:hidden;height:460px;box-shadow:0 20px 60px rgba(0,0,0,.12)}
.hp81-media img{width:100%;height:100%;object-fit:cover}
@media(max-width:600px){.hp81-media{height:300px}}
{%- endstyle -%}
<div class="hp81-inner">
  <span class="hp81-pill">{{section.settings.badge|default:'GROOMING • v81'}}</span>
  <h1 class="hp81-h">{{section.settings.heading|default:'grooming — Made Simple'}}</h1>
  <p class="hp81-p">{{section.settings.description|default:'Barber-grade care for modern men Minimal, honest, designed to last.'}}</p>
  <div class="hp81-btns"><a href="{{section.settings.btn_url|default:'/collections/all'}}" class="hp81-btn">{{section.settings.btn_text|default:'Shop Now'}}</a>{% if section.settings.btn2_text != blank %}<a href="{{section.settings.btn2_url}}" class="hp81-btn hp81-btn--line">{{section.settings.btn2_text}}</a>{% endif %}</div>
  <div class="hp81-media">{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:1200}}" alt="" loading="eager">{% else %}{{'lifestyle-2'|placeholder_svg_tag}}{% endif %}</div>
</div>
{% schema %}{"name":"HP81 Hero Center","settings":[{"type":"color","id":"bg_color","label":"BG","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#134E4A"},{"type":"text","id":"badge","label":"Pill","default":"GROOMING • v81"},{"type":"textarea","id":"heading","label":"Heading","default":"grooming — Made Simple"},{"type":"textarea","id":"description","label":"Desc","default":"Barber-grade care for modern men"},{"type":"text","id":"btn_text","label":"CTA","default":"Shop Now"},{"type":"url","id":"btn_url","label":"Link"},{"type":"text","id":"btn2_text","label":"Ghost"},{"type":"url","id":"btn2_url","label":"Ghost link"},{"type":"image_picker","id":"image","label":"Image"}],"presets":[{"name":"HP81 Hero Center"}]}{% endschema %}