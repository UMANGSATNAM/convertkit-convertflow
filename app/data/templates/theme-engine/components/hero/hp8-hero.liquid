{%- liquid
  assign section_id = section.id
  assign image = section.settings.image
  assign heading = section.settings.heading | default: 'THE FALL COLLECTION'
  assign subheading = section.settings.subheading | default: 'Redefining modern elegance with structural silhouettes.'
  assign button_text = section.settings.button_text | default: 'DISCOVER'
  assign button_link = section.settings.button_link | default: '#'
-%}

<style>
  #shopify-section-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 700px;
    background-color: #000;
    overflow: hidden;
  }
  
  .hp8-hero-bg-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  
  .hp8-hero-bg-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.8;
    transform: scale(1.05);
    animation: hp8-hero-zoom-{{ section_id }} 20s ease-out infinite alternate;
  }
  
  @keyframes hp8-hero-zoom-{{ section_id }} {
    0% { transform: scale(1.05); }
    100% { transform: scale(1.1); }
  }
  
  .hp8-hero-overlay-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.1) 50%, rgba(0,0,0,0.4) 100%);
    z-index: 2;
  }
  
  .hp8-hero-content-{{ section_id }} {
    position: absolute;
    bottom: 10%;
    left: 5%;
    width: 90%;
    max-width: 800px;
    z-index: 3;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  
  .hp8-hero-heading-{{ section_id }} {
    font-family: 'Bodoni MT', 'Didot', 'Playfair Display', serif;
    font-size: clamp(3rem, 6vw, 6rem);
    line-height: 1.1;
    font-weight: 400;
    margin: 0 0 20px 0;
    letter-spacing: 1px;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(30px);
    animation: hp8-hero-fade-up-{{ section_id }} 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards 0.5s;
  }
  
  .hp8-hero-subheading-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 300;
    letter-spacing: 0.5px;
    margin: 0 0 40px 0;
    max-width: 500px;
    line-height: 1.5;
    opacity: 0;
    transform: translateY(30px);
    animation: hp8-hero-fade-up-{{ section_id }} 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards 0.7s;
  }
  
  .hp8-hero-btn-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 45px;
    background-color: transparent;
    color: #ffffff;
    border: 1px solid #ffffff;
    text-decoration: none;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    position: relative;
    overflow: hidden;
    transition: color 0.4s ease;
    opacity: 0;
    transform: translateY(30px);
    animation: hp8-hero-fade-up-{{ section_id }} 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards 0.9s;
  }
  
  .hp8-hero-btn-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #ffffff;
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    z-index: -1;
  }
  
  .hp8-hero-btn-{{ section_id }}:hover {
    color: #000000;
  }
  
  .hp8-hero-btn-{{ section_id }}:hover::before {
    transform: scaleY(1);
    transform-origin: top;
  }
  
  @keyframes hp8-hero-fade-up-{{ section_id }} {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      height: 80vh;
      min-height: 500px;
    }
    .hp8-hero-content-{{ section_id }} {
      bottom: 8%;
      align-items: center;
      text-align: center;
    }
    .hp8-hero-heading-{{ section_id }} {
      font-size: clamp(2.5rem, 10vw, 3.5rem);
    }
  }
</style>

<div class="hp8-hero-bg-{{ section_id }}">
  {% if image != blank %}
    <img src="{{ image | image_url: width: 2000 }}" alt="{{ heading }}" loading="eager" width="2000" height="1200">
  {% else %}
    <!-- Placeholder Gradient -->
    <div style="width:100%; height:100%; background: linear-gradient(45deg, #111, #333);"></div>
  {% endif %}
</div>

<div class="hp8-hero-overlay-{{ section_id }}"></div>

<div class="hp8-hero-content-{{ section_id }}">
  <h1 class="hp8-hero-heading-{{ section_id }}">{{ heading }}</h1>
  {% if subheading != blank %}
    <p class="hp8-hero-subheading-{{ section_id }}">{{ subheading }}</p>
  {% endif %}
  {% if button_text != blank %}
    <a href="{{ button_link }}" class="hp8-hero-btn-{{ section_id }}">{{ button_text }}</a>
  {% endif %}
</div>

{% schema %}
{
  "name": "HP8 Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE FALL COLLECTION"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Redefining modern elegance with structural silhouettes."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "DISCOVER"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP8 Hero"
    }
  ]
}
{% endschema %}
