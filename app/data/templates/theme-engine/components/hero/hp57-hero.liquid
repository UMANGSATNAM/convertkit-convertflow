{%- style -%}
#shopify-section-{{ section.id }}{text-align:center;padding:60px 0}
.hp57-inner{max-width:820px;margin:0 auto;padding:0 24px}
.hp57-h{font-size:clamp(36px,6vw,60px);font-weight:800}
.hp57-media{height:460px;border-radius:20px;overflow:hidden;margin-top:20px}
.hp57-media img{width:100%;height:100%;object-fit:cover}
{%- endstyle -%}
<div class="hp57-inner"><h1 class="hp57-h">{{section.settings.heading|default:'food Simple'}}</h1><p>{{section.settings.description|default:'Artisan organic staples'}}</p><a href="{{section.settings.btn_url|default:'/collections/all'}}" style="background:#16A34A;color:#fff;padding:12px 20px;border-radius:999px;text-decoration:none;font-weight:700">{{section.settings.btn_text|default:'Shop Now'}}</a><div class="hp57-media">{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:1200}}">{% else %}{{'lifestyle-2'|placeholder_svg_tag}}{% endif %}</div></div>
{% schema %}{"name":"HP57 Hero Center","settings":[{"type":"textarea","id":"heading","label":"Heading","default":"food Simple"},{"type":"textarea","id":"description","label":"Desc","default":"Artisan organic staples"},{"type":"text","id":"btn_text","label":"CTA","default":"Shop Now"},{"type":"url","id":"btn_url","label":"Link"},{"type":"image_picker","id":"image","label":"Image"}],"presets":[{"name":"HP57 Hero Center"}]}{% endschema %}