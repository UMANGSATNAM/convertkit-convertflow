{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffe8d6'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
  }
  
  .hp14-video-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    border-radius: 40px;
    overflow: hidden;
    height: 700px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .hp14-video-element-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }
  
  .hp14-video-overlay-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(107, 112, 92, 0.3);
  }
  
  .hp14-video-play-{{ section_id }} {
    position: relative;
    z-index: 2;
    width: 100px;
    height: 100px;
    background: #ffe8d6;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #cb997e;
    text-decoration: none;
    transition: transform 0.3s ease;
  }
  
  .hp14-video-play-{{ section_id }}:hover {
    transform: scale(1.1);
  }
  
  .hp14-video-play-{{ section_id }} svg {
    width: 40px;
    height: 40px;
    margin-left: 5px;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp14-video-container-{{ section_id }} {
      height: 400px;
      border-radius: 20px;
    }
    .hp14-video-play-{{ section_id }} {
      width: 70px;
      height: 70px;
    }
    .hp14-video-play-{{ section_id }} svg {
      width: 30px;
      height: 30px;
    }
  }
</style>

<div class="hp14-video-container-{{ section_id }}">
  {% if section.settings.video_url != blank %}
    <iframe class="hp14-video-element-{{ section_id }}" src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=0&loop=1&mute=1&playlist={{ section.settings.video_url.id }}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
  {% else %}
    <div class="hp14-video-element-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
  {% endif %}
  <div class="hp14-video-overlay-{{ section_id }}"></div>
  <a href="#" class="hp14-video-play-{{ section_id }}">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
  </a>
</div>

{% schema %}
{
  "name": "HP14 Video",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffe8d6"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"]
    }
  ],
  "presets": [
    {
      "name": "HP14 Video"
    }
  ]
}
{% endschema %}
