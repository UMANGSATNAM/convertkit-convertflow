{%- style -%}
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap');
#shopify-section-{{ section.id }}{--hp91-bg:{{section.settings.bg_color|default:'#FFFBEB'}};--hp91-accent:#0D9488;background:var(--hp91-bg);color:{{section.settings.text_color|default:'#134E4A'}};font-family:'Plus Jakarta Sans',sans-serif;padding:80px 0;position:relative}
.hp91-wrap{max-width:{{section.settings.container_width|default:1240}}px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:.95fr 1.05fr;gap:56px;align-items:center}
.hp91-eyebrow{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#0D9488;font-weight:700;margin-bottom:14px}
.hp91-h{font-family:'Cormorant Garamond',serif;font-size:clamp(36px,5vw,62px);line-height:.95;font-weight:700;margin:0}
.hp91-h em{font-style:italic;font-weight:400;color:#0D9488}
.hp91-p{margin:16px 0 28px;opacity:.7;line-height:1.8;max-width:500px}
.hp91-btn{display:inline-flex;align-items:center;gap:10px;padding:15px 30px;background:#0D9488;color:#fff;text-decoration:none;border-radius:999px;font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase}
.hp91-arch{border-radius:180px 180px 24px 24px;overflow:hidden;height:560px;border:1px solid #0D948822;box-shadow:0 20px 50px rgba(0,0,0,.08);position:relative}
.hp91-arch img{width:100%;height:100%;object-fit:cover}
.hp91-note{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);background:#fff;border-radius:12px;padding:12px 18px;display:flex;gap:12px;align-items:center;box-shadow:0 8px 24px rgba(0,0,0,.12);white-space:nowrap}
@media(max-width:900px){.hp91-wrap{grid-template-columns:1fr;text-align:center}.hp91-p{margin-left:auto;margin-right:auto}.hp91-arch{height:380px;border-radius:24px}}
{%- endstyle -%}
<div class="hp91-wrap">
  <div>
    <div class="hp91-eyebrow">{{section.settings.badge|default:'GROOMING — Atelier v91'}}</div>
    <h1 class="hp91-h">{{section.settings.heading|default:'Quiet Luxury, <em>grooming</em>'}}</h1>
    <p class="hp91-p">{{section.settings.description|default:'Barber-grade care for modern men Soft drape, heritage craft & modern ease.'}}</p>
    <a href="{{section.settings.btn_url|default:'/collections/all'}}" class="hp91-btn">{{section.settings.btn_text|default:'Explore Collection'}} →</a>
  </div>
  <div class="hp91-arch">{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:1000}}" alt="" loading="eager">{% else %}{{'collection-1'|placeholder_svg_tag}}{% endif %}<div class="hp91-note"><span style="width:36px;height:36px;border-radius:50%;background:#0D9488;display:grid;place-items:center;color:#fff">✂</span><span style="font-weight:700">{{section.settings.float_title|default:'Handcrafted'}}</span></div></div>
</div>
{% schema %}{"name":"HP91 Hero Editorial","settings":[{"type":"color","id":"bg_color","label":"BG","default":"#F0FDFA"},{"type":"color","id":"text_color","label":"Text","default":"#134E4A"},{"type":"text","id":"badge","label":"Eyebrow","default":"GROOMING — Atelier v91"},{"type":"textarea","id":"heading","label":"Heading","default":"Quiet Luxury, <em>grooming</em>"},{"type":"textarea","id":"description","label":"Desc","default":"Barber-grade care for modern men"},{"type":"text","id":"btn_text","label":"CTA","default":"Explore Collection"},{"type":"url","id":"btn_url","label":"Link"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"float_title","label":"Note","default":"Handcrafted"},{"type":"range","id":"container_width","min":1000,"max":1440,"step":20,"unit":"px","label":"Width","default":1240}],"presets":[{"name":"HP91 Hero Editorial"}]}{% endschema %}