{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --hp58-bg: {{ section.settings.bg_color | default: '#0B0F19' }};
    --hp58-text: {{ section.settings.text_color | default: '#F8FAFC' }};
    --hp58-cyan: {{ section.settings.accent_cyan | default: '#06B6D4' }};
    --hp58-violet: {{ section.settings.accent_violet | default: '#8B5CF6' }};
    --hp58-btn-bg: {{ section.settings.btn_bg | default: '#06B6D4' }};
    --hp58-btn-text: {{ section.settings.btn_text_color | default: '#0B0F19' }};

    background: radial-gradient(circle at 80% 20%, #1E1B4B 0%, var(--hp58-bg) 70%);
    color: var(--hp58-text);
    font-family: 'Space Grotesk', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 100 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp58-hero__cyber-glow {
    position: absolute;
    top: -150px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.15) 0%, rgba(139, 92, 246, 0.1) 50%, transparent 70%);
    pointer-events: none;
  }

  .hp58-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 70px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hp58-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 18px;
    background: rgba(6, 182, 212, 0.1);
    border: 1px solid rgba(6, 182, 212, 0.35);
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--hp58-cyan);
    margin-bottom: 26px;
    box-shadow: 0 0 15px rgba(6, 182, 212, 0.2);
  }

  .hp58-hero__title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(38px, 5.2vw, 64px);
    font-weight: 800;
    line-height: 1.08;
    color: #FFFFFF;
    margin: 0 0 24px;
    letter-spacing: -1px;
  }

  .hp58-hero__title span {
    background: linear-gradient(135deg, #06B6D4 0%, #8B5CF6 50%, #F43F5E 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp58-hero__desc {
    font-size: 16px;
    line-height: 1.75;
    color: #94A3B8;
    margin: 0 0 36px;
    max-width: 520px;
  }

  .hp58-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp58-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp58-btn-bg);
    color: var(--hp58-btn-text);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.35s ease;
    box-shadow: 0 0 25px rgba(6, 182, 212, 0.4);
  }

  .hp58-hero__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 35px rgba(6, 182, 212, 0.7);
  }

  .hp58-hero__media {
    position: relative;
  }

  .hp58-hero__img-wrap {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    height: 520px;
    border: 1px solid rgba(6, 182, 212, 0.3);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 30px rgba(6, 182, 212, 0.15);
  }

  .hp58-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.9) contrast(1.15);
    transition: transform 0.6s ease;
  }

  .hp58-hero__img-wrap:hover .hp58-hero__img {
    transform: scale(1.04);
  }

  .hp58-hero__float-card {
    position: absolute;
    bottom: -16px;
    left: -16px;
    background: rgba(11, 15, 25, 0.92);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(6, 182, 212, 0.4);
    border-radius: 8px;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .hp58-hero__float-icon {
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, #06B6D4, #8B5CF6);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-size: 18px;
  }

  .hp58-hero__float-label {
    font-family: 'Syne', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
  }

  .hp58-hero__float-sub {
    font-size: 11px;
    color: #06B6D4;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 2px 0 0;
  }

  @media screen and (max-width: 992px) {
    .hp58-hero__container { grid-template-columns: 1fr; text-align: center; gap: 40px; }
    .hp58-hero__desc { margin-left: auto; margin-right: auto; }
    .hp58-hero__actions { justify-content: center; }
    .hp58-hero__img-wrap { height: 380px; }
    .hp58-hero__float-card { left: 50%; transform: translateX(-50%); bottom: -16px; }
  }

  @media screen and (max-width: 480px) {
    .hp58-hero__img-wrap { height: 300px; }
  }
{%- endstyle -%}

<div class="hp58-hero__cyber-glow"></div>

<div class="hp58-hero__container">
  <div>
    <div class="hp58-hero__badge">
      <span>⚡</span>
      <span>{{ section.settings.badge | default: 'TOKYO CYBER LAB v58' }}</span>
    </div>

    <h1 class="hp58-hero__title">
      {{ section.settings.heading | default: 'Tokyo <span>Cyber Neon & Cellular</span> Bio-Tech' }}
    </h1>

    <p class="hp58-hero__desc">
      {{ section.settings.description | default: 'Engineered in Shibuya bio-labs with synthetic peptide quantum matrices, fermented cyber-algae, and neon photoprotectants.' }}
    </p>

    <div class="hp58-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp58-hero__btn">
        <span>{{ section.settings.btn_text | default: 'Access Bio-Lab' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp58-hero__media">
    <div class="hp58-hero__img-wrap">
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" class="hp58-hero__img" alt="{{ section.settings.heading }}" loading="eager">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp58-hero__img' }}
      {%- endif -%}

      <div class="hp58-hero__float-card">
        <div class="hp58-hero__float-icon">⚡</div>
        <div>
          <p class="hp58-hero__float-label">Quantum Peptide 7X</p>
          <p class="hp58-hero__float-sub">Cellular Synthesis Lab</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP58 Hero",
  "class": "section-hp58-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0B0F19" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#F8FAFC" },
    { "type": "color", "id": "accent_cyan", "label": "Cyan Accent", "default": "#06B6D4" },
    { "type": "color", "id": "accent_violet", "label": "Violet Accent", "default": "#8B5CF6" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#06B6D4" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#0B0F19" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "TOKYO CYBER LAB v58" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Tokyo <span>Cyber Neon & Cellular</span> Bio-Tech" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Engineered in Shibuya bio-labs with synthetic peptide quantum matrices." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Access Bio-Lab" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 100 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP58 Hero" }]
}
{% endschema %}
