{% schema %}
{
  "name": "Video Hero (Jewellery)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (MP4)",
      "default": "https://cdn.shopify.com/s/files/1/0000/0000/0000/files/placeholder-video.mp4"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Timeless Elegance"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover the new collection"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Video Hero (Jewellery)",
      "category": "Hero"
    }
  ]
}
{% endschema %}

<div class="hero-video hero-video--jewellery" style="position: relative; height: 100vh; min-height: 600px; display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden;">
  <video autoplay muted loop playsinline style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1;">
    <source src="{{ section.settings.video_url }}" type="video/mp4">
  </video>
  <div class="hero-video__overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.3); z-index: 0;"></div>
  
  <div class="hero-video__content" style="position: relative; z-index: 1; color: #fff; padding: 2rem;">
    <h1 style="font-family: var(--font-heading-family); font-size: clamp(3rem, 5vw, 6rem); margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.1em; text-shadow: 0 2px 4px rgba(0,0,0,0.5);">
      {{ section.settings.heading }}
    </h1>
    <p style="font-family: var(--font-body-family); font-size: 1.2rem; margin-bottom: 2rem; letter-spacing: 0.05em; text-shadow: 0 1px 2px rgba(0,0,0,0.5);">
      {{ section.settings.subheading }}
    </p>
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="btn btn--outline" style="border: 1px solid #fff; color: #fff; padding: 1rem 3rem; text-decoration: none; text-transform: uppercase; letter-spacing: 0.1em; transition: all 0.3s ease;">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>
