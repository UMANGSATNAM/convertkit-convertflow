{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Shrikhand&family=DM+Sans:wght@400;500;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Shrikhand', cursive;
    --font-body: 'DM Sans', sans-serif;
    
    background-color: var(--bg-color);
  }

  .hp37-hero-wrapper {
    position: relative;
    width: 100%;
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 40px;
  }

  @media screen and (max-width: 768px) {
    .hp37-hero-wrapper {
      min-height: 80vh;
      padding: 20px;
    }
  }

  .hp37-hero__bg {
    position: absolute;
    top: 20px; left: 20px; right: 20px; bottom: 20px;
    border-radius: 40px;
    overflow: hidden;
    background: var(--accent-color);
  }

  @media screen and (max-width: 768px) {
    .hp37-hero__bg {
      top: 10px; left: 10px; right: 10px; bottom: 10px;
      border-radius: 20px;
    }
  }

  .hp37-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8; /* Slight vintage wash */
    mix-blend-mode: multiply; /* Blends with accent color for a retro tint */
  }

  .hp37-hero__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(circle, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.5) 100%);
    pointer-events: none;
  }

  .hp37-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 900px;
    padding: 40px;
  }

  .hp37-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(60px, 12vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: {{ section.settings.title_color }};
    margin: 0 0 20px;
    text-shadow: 4px 4px 0px var(--text-color); /* Retro solid drop shadow */
    transform: rotate(-2deg); /* Quirky retro tilt */
  }

  .hp37-hero__subtitle {
    font-family: var(--font-body);
    font-size: clamp(16px, 3vw, 24px);
    color: {{ section.settings.title_color }};
    font-weight: 500;
    margin: 0 auto 40px;
    max-width: 600px;
    line-height: 1.4;
  }

  .hp37-hero__btn {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    text-decoration: none;
    padding: 18px 40px;
    background-color: var(--text-color);
    color: var(--bg-color);
    border-radius: 50px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 4px 4px 0px var(--accent-color);
  }

  .hp37-hero__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--accent-color);
  }

  /* Retro grain overlay */
  .hp37-hero__grain {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: url('data:image/svg+xml;utf8,%3Csvg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"%3E%3Cfilter id="noiseFilter"%3E%3CfeTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/%3E%3C/filter%3E%3Crect width="100%25" height="100%25" filter="url(%23noiseFilter)" opacity="0.15"/%3E%3C/svg%3E');
    pointer-events: none;
    z-index: 3;
    opacity: 0.5;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp37-hero-wrapper" id="HP37Hero-{{ section.id }}">
  <div class="hp37-hero__bg">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.title | escape }}" class="hp37-hero__image" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hp37-hero__image' }}
    {%- endif -%}
    <div class="hp37-hero__overlay"></div>
    <div class="hp37-hero__grain"></div>
  </div>

  <div class="hp37-hero__content">
    <h1 class="hp37-hero__title">{{ section.settings.title }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="hp37-hero__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp37-hero__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP37 - Retro Hero",
  "class": "section-hp37-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Good Vibes Only."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Catch the wave of our new summer collection. Made for the sun seekers."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Shop Summer"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 60,
      "max": 180,
      "step": 5,
      "unit": "px",
      "label": "Heading Size",
      "default": 140
    },
    {
      "type": "header",
      "content": "Retro Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F4E3C5" 
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A3219"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Image Wash/Shadow)",
      "default": "#D96C4A"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#F4E3C5"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP37 - Retro Hero"
    }
  ]
}
{% endschema %}
