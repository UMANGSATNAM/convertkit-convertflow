      "id": "desc",
      "label": "Description",
      "default": "Explore our curated lineup of architectural furniture and home accents engineered for calm spaces."
    },
    {
      "type": "header",
      "content": "Category Pills"
    },
    {
      "type": "text",
      "id": "pill_1",
      "label": "Pill 1 label",
      "default": "All Collections"
    },
    {
      "type": "url",
      "id": "pill_link_1",
      "label": "Pill 1 link"
    },
    {
      "type": "text",
      "id": "pill_2",
      "label": "Pill 2 label",
      "default": "Living Room"
    },
    {
      "type": "url",
      "id": "pill_link_2",
      "label": "Pill 2 link"
    },
    {
      "type": "text",
      "id": "pill_3",
      "label": "Pill 3 label",
      "default": "Dining & Kitchen"
    },
    {
      "type": "url",
      "id": "pill_link_3",
      "label": "Pill 3 link"
    },
    {
      "type": "text",
      "id": "pill_4",
      "label": "Pill 4 label",
      "default": "Home Workspace"
    },
    {
      "type": "url",
      "id": "pill_link_4",
      "label": "Pill 4 link"
    },
    {
      "type": "text",
      "id": "image",
      "label": "Banner image URL",
      "default": "https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=1600&q=80"
    }
  ],
  "presets": [
    {
      "name": "Hero Minimal Clean",
      "settings": {
        "title": "Designed with Purpose. Built to Last.",
        "subtitle": "ESSENTIALS FOR MODERN LIVING"
      }
    }
  ]
}
{% endschema %}
