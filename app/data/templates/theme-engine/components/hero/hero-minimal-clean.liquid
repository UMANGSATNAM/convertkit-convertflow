{% comment %}
  Hero Minimal Clean - Scandinavian Clean Typography & Category Filter Pills
  Category: hero
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --min-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --min-text: {{ section.settings.text_color | default: '#111827' }};
    background-color: var(--min-bg);
    color: var(--min-text);
    padding: clamp(60px, 10vw, 120px) 24px clamp(40px, 6vw, 80px) 24px;
    font-family: inherit;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .cf-min-container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .cf-min-sub {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #64748b;
    margin-bottom: 20px;
    display: inline-block;
  }

  .cf-min-title {
    font-size: clamp(38px, 6.5vw, 84px);
    font-weight: 850;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 auto 28px auto;
    max-width: 950px;
    color: var(--min-text);
  }

  .cf-min-desc {
    font-size: clamp(16px, 1.8vw, 21px);
    line-height: 1.6;
    color: #475569;
    max-width: 640px;
    margin: 0 auto 40px auto;
  }

  .cf-min-pills {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 50px;
  }

  .cf-min-pill {
    display: inline-flex;
    align-items: center;
    padding: 10px 22px;
    border-radius: 999px;
    background: #f1f5f9;
    color: #1e293b;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s, transform 0.2s;
  }

  .cf-min-pill:hover,
  .cf-min-pill.active {
    background: #0f172a;
    color: #ffffff;
    transform: translateY(-2px);
  }

  .cf-min-hero-image-wrap {
    border-radius: 24px;
    overflow: hidden;
    max-width: 1100px;
    margin: 0 auto;
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.1);
    background: #f8fafc;
    aspect-ratio: 16 / 9;
  }

  .cf-min-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
{%- endstyle -%}

<div class="cf-min-container">
  <span class="cf-min-sub">{{ section.settings.subtitle | default: 'ESSENTIALS FOR MODERN LIVING' }}</span>
  <h1 class="cf-min-title">{{ section.settings.title | default: 'Designed with Purpose. Built to Last.' }}</h1>
  <p class="cf-min-desc">
    {{ section.settings.desc | default: 'Explore our curated lineup of architectural furniture and home accents engineered for calm spaces.' }}
  </p>

  <div class="cf-min-pills">
    <a href="{{ section.settings.pill_link_1 | default: '/collections/all' }}" class="cf-min-pill active">
      {{ section.settings.pill_1 | default: 'All Collections' }}
    </a>
    <a href="{{ section.settings.pill_link_2 | default: '/collections/living' }}" class="cf-min-pill">
      {{ section.settings.pill_2 | default: 'Living Room' }}
    </a>
    <a href="{{ section.settings.pill_link_3 | default: '/collections/dining' }}" class="cf-min-pill">
      {{ section.settings.pill_3 | default: 'Dining & Kitchen' }}
    </a>
    <a href="{{ section.settings.pill_link_4 | default: '/collections/workspace' }}" class="cf-min-pill">
      {{ section.settings.pill_4 | default: 'Home Workspace' }}
    </a>
  </div>

  <div class="cf-min-hero-image-wrap">
    <img
      src="{{ section.settings.image | default: 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=1600&q=80' }}"
      alt="{{ section.settings.title | escape }}"
      class="cf-min-hero-image"
      loading="eager"
      width="1100"
      height="620"
    >
  </div>
</div>

{% schema %}
{
  "name": "Hero Minimal Clean",
  "tag": "section",
  "class": "cf-hero-minimal-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111827"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sub-title eyebrow",
      "default": "ESSENTIALS FOR MODERN LIVING"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Designed with Purpose. Built to Last."
    },
    {
