{% comment %}
  Hero Editorial Brand - Full-bleed with Frosted Glass Card
  Category: hero
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    position: relative;
    min-height: clamp(520px, 85vh, 800px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 24px;
    background-color: #0f172a;
    color: #ffffff;
    overflow: hidden;
    font-family: inherit;
  }

  .cf-editorial-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    filter: brightness(0.85);
  }

  .cf-editorial-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(15, 23, 42, 0.4) 0%, rgba(15, 23, 42, 0.8) 100%);
    z-index: 2;
  }

  .cf-editorial-card {
    position: relative;
    z-index: 3;
    max-width: 760px;
    margin: 0 auto;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 28px;
    padding: clamp(32px, 6vw, 64px) clamp(24px, 5vw, 56px);
    text-align: center;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
  }

  .cf-editorial-eyebrow {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#f59e0b' }};
    margin-bottom: 16px;
    display: inline-block;
  }

  .cf-editorial-headline {
    font-size: clamp(32px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0 0 20px 0;
    color: #ffffff;
  }

  .cf-editorial-subtext {
    font-size: clamp(15px, 1.6vw, 19px);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 auto 32px auto;
    max-width: 580px;
  }

  .cf-editorial-btns {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .cf-btn-gold {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.accent_color | default: '#f59e0b' }};
    color: #0f172a;
    font-size: 15px;
    font-weight: 800;
    padding: 15px 34px;
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .cf-btn-gold:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(245, 158, 11, 0.35);
  }

  .cf-btn-outline-white {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    padding: 15px 28px;
    border-radius: 12px;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.25);
    transition: background-color 0.2s, border-color 0.2s;
  }

  .cf-btn-outline-white:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: #ffffff;
  }
{%- endstyle -%}

<img
  src="{{ section.settings.image | default: 'https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=1600&q=80' }}"
  alt="{{ section.settings.heading | escape }}"
  class="cf-editorial-bg"
  loading="eager"
  width="1600"
  height="900"
>
<div class="cf-editorial-overlay"></div>

<div class="cf-editorial-card">
  <span class="cf-editorial-eyebrow">{{ section.settings.eyebrow | default: 'AUTUMN / WINTER 2026 EDITION' }}</span>
  <h1 class="cf-editorial-headline">{{ section.settings.heading | default: 'Redefining Modern Simplicity.' }}</h1>
  <p class="cf-editorial-subtext">
    {{ section.settings.subtext | default: 'Crafted from sustainable organic linen and natural fibers, engineered for timeless silhouettes that transition from studio to evening.' }}
  </p>
  <div class="cf-editorial-btns">
    <a href="{{ section.settings.button_link_1 | default: '/collections/all' }}" class="cf-btn-gold">
      {{ section.settings.button_label_1 | default: 'Explore Lookbook' }}
    </a>
    {% if section.settings.button_label_2 != blank %}
      <a href="{{ section.settings.button_link_2 | default: '/pages/story' }}" class="cf-btn-outline-white">
        {{ section.settings.button_label_2 | default: 'Read Our Story' }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Hero Editorial Brand",
  "tag": "section",
  "class": "cf-hero-editorial-section",
  "settings": [
    {
      "type": "text",
      "id": "image",
      "label": "Background image URL",
      "default": "https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=1600&q=80"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#f59e0b"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag",
      "default": "AUTUMN / WINTER 2026 EDITION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Redefining Modern Simplicity."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext description",
      "default": "Crafted from sustainable organic linen and natural fibers, engineered for timeless silhouettes that transition from studio to evening."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "Explore Lookbook"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Hero Editorial Brand",
      "settings": {
        "eyebrow": "AUTUMN / WINTER 2026 EDITION",
        "heading": "Redefining Modern Simplicity.",
        "button_label_1": "Explore Lookbook"
      }
    }
  ]
}
{% endschema %}
