{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#00FFA3'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: 60px 40px;
    border-bottom: 1px solid {{ text_color }};
  }
  
  .hp13-hero-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }
  
  .hp13-hero-image-wrap-{{ section_id }} {
    position: relative;
    border: 1px solid {{ text_color }};
    padding: 10px;
  }
  
  .hp13-hero-image-{{ section_id }} {
    width: 100%;
    height: auto;
    display: block;
    filter: contrast(120%) grayscale(20%);
  }
  
  .hp13-hero-ui-overlay-{{ section_id }} {
    position: absolute;
    top: 20px; left: 20px;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.75rem;
    color: {{ text_color }};
    font-weight: bold;
    text-shadow: 0 0 5px {{ text_color }};
  }
  
  .hp13-hero-ui-overlay-tr-{{ section_id }} {
    position: absolute;
    top: 20px; right: 20px;
    width: 20px; height: 20px;
    border-top: 2px solid {{ text_color }};
    border-right: 2px solid {{ text_color }};
  }
  
  .hp13-hero-ui-overlay-bl-{{ section_id }} {
    position: absolute;
    bottom: 20px; left: 20px;
    width: 20px; height: 20px;
    border-bottom: 2px solid {{ text_color }};
    border-left: 2px solid {{ text_color }};
  }
  
  .hp13-hero-content-{{ section_id }} {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  
  .hp13-hero-sys-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.8rem;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  
  .hp13-hero-heading-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 900;
    line-height: 1;
    margin: 0 0 30px 0;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px {{ text_color }};
  }
  
  .hp13-hero-text-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    line-height: 1.5;
    margin: 0 0 40px 0;
    max-width: 500px;
  }
  
  .hp13-hero-btn-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    font-weight: bold;
    text-decoration: none;
    text-transform: uppercase;
    color: {{ bg_color }};
    background-color: {{ text_color }};
    padding: 15px 30px;
    box-shadow: 4px 4px 0 {{ text_color | color_darken: 20 }};
    transition: all 0.2s ease;
    display: inline-block;
  }
  
  .hp13-hero-btn-{{ section_id }}:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 {{ text_color | color_darken: 20 }};
  }
  
  .hp13-hero-btn-{{ section_id }}:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 {{ text_color | color_darken: 20 }};
  }

  @media (max-width: 992px) {
    .hp13-hero-container-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 40px 20px;
    }
    .hp13-hero-heading-{{ section_id }} {
      font-size: 2.5rem;
    }
  }
</style>

<div class="hp13-hero-container-{{ section_id }}">
  <div class="hp13-hero-image-wrap-{{ section_id }}">
    <div class="hp13-hero-ui-overlay-{{ section_id }}">REC <span style="color: #FF003C;">●</span></div>
    <div class="hp13-hero-ui-overlay-tr-{{ section_id }}"></div>
    <div class="hp13-hero-ui-overlay-bl-{{ section_id }}"></div>
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 1000 }}" class="hp13-hero-image-{{ section_id }}" alt="Hero Image">
    {% else %}
      <div class="hp13-hero-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px); height: 500px;"></div>
    {% endif %}
  </div>
  
  <div class="hp13-hero-content-{{ section_id }}">
    <div class="hp13-hero-sys-{{ section_id }}">>> INIT_PROTOCOL: NEON_CITY</div>
    <h1 class="hp13-hero-heading-{{ section_id }}">{{ section.settings.heading | default: 'NEXT_GEN APPAREL' }}</h1>
    <p class="hp13-hero-text-{{ section_id }}">{{ section.settings.text | default: 'Equip yourself with the latest tech-wear designed for the urban grid. Durable, waterproof, and hyper-functional.' }}</p>
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hp13-hero-btn-{{ section_id }}">{{ section.settings.button_label }}_</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP13 Hero",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#00FFA3"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEXT_GEN APPAREL"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Equip yourself with the latest tech-wear designed for the urban grid. Durable, waterproof, and hyper-functional."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "ACCESS_CATALOG"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP13 Hero"
    }
  ]
}
{% endschema %}
