{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --hp63-bg: {{ section.settings.bg_color | default: '#FFFBEB' }};
    --hp63-text: {{ section.settings.text_color | default: '#1C1917' }};
    --hp63-crimson: {{ section.settings.accent_crimson | default: '#881337' }};
    --hp63-gold: {{ section.settings.accent_gold | default: '#D97706' }};
    --hp63-btn-bg: {{ section.settings.btn_bg | default: '#881337' }};
    --hp63-btn-text: {{ section.settings.btn_text_color | default: '#FFFFFF' }};

    background: radial-gradient(circle at 85% 20%, #FEF3C7 0%, var(--hp63-bg) 60%, #FCE7F3 100%);
    color: var(--hp63-text);
    font-family: 'Plus Jakarta Sans', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp63-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 70px;
    align-items: center;
  }

  .hp63-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 18px;
    background: rgba(136, 19, 55, 0.08);
    border: 1px solid rgba(136, 19, 55, 0.2);
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--hp63-crimson);
    margin-bottom: 24px;
  }

  .hp63-hero__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(38px, 5.2vw, 64px);
    font-weight: 700;
    line-height: 1.1;
    color: #1C1917;
    margin: 0 0 24px;
  }

  .hp63-hero__title em {
    font-style: italic;
    color: var(--hp63-crimson);
  }

  .hp63-hero__desc {
    font-size: 16px;
    line-height: 1.8;
    color: #57534E;
    margin: 0 0 36px;
    max-width: 520px;
  }

  .hp63-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp63-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp63-btn-bg);
    color: var(--hp63-btn-text);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.35s ease;
    box-shadow: 0 8px 25px rgba(136, 19, 55, 0.25);
  }

  .hp63-hero__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(136, 19, 55, 0.4);
  }

  .hp63-hero__media {
    position: relative;
  }

  .hp63-hero__img-wrap {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    height: 520px;
    border: 1px solid rgba(217, 119, 6, 0.3);
    box-shadow: 0 25px 60px rgba(136, 19, 55, 0.12);
  }

  .hp63-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .hp63-hero__img-wrap:hover .hp63-hero__img {
    transform: scale(1.04);
  }

  .hp63-hero__float-card {
    position: absolute;
    bottom: -16px;
    left: -16px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(217, 119, 6, 0.3);
    border-radius: 6px;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 10px 30px rgba(136, 19, 55, 0.1);
  }

  .hp63-hero__float-icon {
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, #FCE7F3, #881337);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-size: 18px;
  }

  .hp63-hero__float-label {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    font-weight: 700;
    color: #1C1917;
    margin: 0;
  }

  .hp63-hero__float-sub {
    font-size: 11px;
    color: #881337;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 2px 0 0;
  }

  @media screen and (max-width: 992px) {
    .hp63-hero__container { grid-template-columns: 1fr; text-align: center; gap: 40px; }
    .hp63-hero__desc { margin-left: auto; margin-right: auto; }
    .hp63-hero__actions { justify-content: center; }
    .hp63-hero__img-wrap { height: 380px; }
    .hp63-hero__float-card { left: 50%; transform: translateX(-50%); bottom: -16px; }
  }

  @media screen and (max-width: 480px) {
    .hp63-hero__img-wrap { height: 300px; }
  }
{%- endstyle -%}

<div class="hp63-hero__container">
  <div>
    <div class="hp63-hero__badge">
      <span>🌹</span>
      <span>{{ section.settings.badge | default: 'MARRAKECH SOUK HARVEST v63' }}</span>
    </div>

    <h1 class="hp63-hero__title">
      Moroccan Damask Rose & <em>Warm Amber Bazaar</em>
    </h1>

    <p class="hp63-hero__desc">
      {{ section.settings.description | default: 'Steam-distilled at dawn in the Dades Valley of Roses, infused with aged amber resin, cold-pressed desert argan, and Moroccan orange blossom neroli.' }}
    </p>

    <div class="hp63-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp63-hero__btn">
        <span>{{ section.settings.btn_text | default: 'Explore Rose Bazaar' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp63-hero__media">
    <div class="hp63-hero__img-wrap">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" class="hp63-hero__img" alt="{{ section.settings.heading }}" loading="eager">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp63-hero__img' }}
      {%- endif -%}

      <div class="hp63-hero__float-card">
        <div class="hp63-hero__float-icon">🌹</div>
        <div>
          <p class="hp63-hero__float-label">100% Pure Dades Rose</p>
          <p class="hp63-hero__float-sub">Valley of Roses Single Origin</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP63 Hero",
  "class": "section-hp63-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FFFBEB" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1C1917" },
    { "type": "color", "id": "accent_crimson", "label": "Crimson Accent", "default": "#881337" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#D97706" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#881337" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "MARRAKECH SOUK HARVEST v63" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Moroccan Damask Rose & <em>Warm Amber Bazaar</em>" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Steam-distilled at dawn in the Dades Valley of Roses." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Explore Rose Bazaar" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP63 Hero" }]
}
{% endschema %}
