{%- style -%}
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500&display=swap');
#shopify-section-{{ section.id }}{position:relative;color:#fff}
.hp95-bg{position:absolute;inset:0}
.hp95-bg img{width:100%;height:100%;object-fit:cover}
.hp95-bg::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg, rgba(0,0,0,.65) 0%, rgba(0,0,0,.15) 60%, rgba(0,0,0,.25) 100%)}
.hp95-content{position:relative;max-width:1280px;margin:0 auto;padding:90px 24px;min-height:560px;display:flex;align-items:center}
.hp95-box{max-width:560px}
.hp95-eyebrow{font-size:11px;letter-spacing:3px;text-transform:uppercase;opacity:.9}
.hp95-h{font-family:'Playfair Display',serif;font-size:clamp(38px,5vw,60px);line-height:1;margin:12px 0}
.hp95-p{opacity:.85;line-height:1.7}
.hp95-btn{margin-top:18px;display:inline-block;padding:14px 26px;background:#fff;color:#111;text-decoration:none;font-weight:700;border-radius:6px}
@media(max-width:700px){.hp95-content{padding:60px 24px;min-height:480px}}
{%- endstyle -%}
<div class="hp95-bg">{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:1600}}" alt="" loading="eager">{% else %}{{'lifestyle-1'|placeholder_svg_tag}}{% endif %}</div>
<div class="hp95-content"><div class="hp95-box"><div class="hp95-eyebrow">{{section.settings.badge|default:'STREETWEAR • v95'}}</div><h1 class="hp95-h">{{section.settings.heading|default:'Live In Your streetwear'}}</h1><p class="hp95-p">{{section.settings.description|default:'Heavyweight cotton, utility cuts for city motion Full-bleed immersion for streetwear.'}}</p><a href="{{section.settings.btn_url|default:'/collections/all'}}" class="hp95-btn">{{section.settings.btn_text|default:'Explore'}}</a></div></div>
{% schema %}{"name":"HP95 Hero Full","settings":[{"type":"text","id":"badge","label":"Eyebrow","default":"STREETWEAR • v95"},{"type":"textarea","id":"heading","label":"Heading","default":"Live In Your streetwear"},{"type":"textarea","id":"description","label":"Desc","default":"Heavyweight cotton, utility cuts for city motion"},{"type":"text","id":"btn_text","label":"CTA","default":"Explore"},{"type":"url","id":"btn_url","label":"Link"},{"type":"image_picker","id":"image","label":"Image"}],"presets":[{"name":"HP95 Hero Full"}]}{% endschema %}