{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --hp59-bg: {{ section.settings.bg_color | default: '#FFFBEB' }};
    --hp59-text: {{ section.settings.text_color | default: '#042F2E' }};
    --hp59-coral: {{ section.settings.accent_coral | default: '#FB7185' }};
    --hp59-tangerine: {{ section.settings.accent_tangerine | default: '#F97316' }};
    --hp59-btn-bg: {{ section.settings.btn_bg | default: '#F97316' }};
    --hp59-btn-text: {{ section.settings.btn_text_color | default: '#FFFFFF' }};

    background: radial-gradient(circle at 10% 20%, #FEF3C7 0%, var(--hp59-bg) 60%, #FDE68A 100%);
    color: var(--hp59-text);
    font-family: 'Plus Jakarta Sans', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp59-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 70px;
    align-items: center;
  }

  .hp59-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 18px;
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.3);
    border-radius: 50px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--hp59-tangerine);
    margin-bottom: 24px;
  }

  .hp59-hero__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(40px, 5.5vw, 68px);
    font-weight: 700;
    line-height: 1.05;
    color: #042F2E;
    margin: 0 0 24px;
    letter-spacing: -0.5px;
  }

  .hp59-hero__title em {
    font-style: italic;
    background: linear-gradient(135deg, #F97316 0%, #FB7185 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp59-hero__desc {
    font-size: 16px;
    line-height: 1.8;
    color: #334155;
    margin: 0 0 36px;
    max-width: 520px;
  }

  .hp59-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp59-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp59-btn-bg);
    color: var(--hp59-btn-text);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 50px;
    transition: all 0.35s ease;
    box-shadow: 0 8px 25px rgba(249, 115, 22, 0.35);
  }

  .hp59-hero__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(249, 115, 22, 0.5);
  }

  .hp59-hero__media {
    position: relative;
  }

  .hp59-hero__img-wrap {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    height: 520px;
    border: 1px solid rgba(249, 115, 22, 0.25);
    box-shadow: 0 25px 60px rgba(249, 115, 22, 0.15);
  }

  .hp59-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .hp59-hero__img-wrap:hover .hp59-hero__img {
    transform: scale(1.04);
  }

  .hp59-hero__float-card {
    position: absolute;
    bottom: -16px;
    left: -16px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(249, 115, 22, 0.3);
    border-radius: 16px;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 10px 30px rgba(4, 47, 46, 0.08);
  }

  .hp59-hero__float-icon {
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, #F97316, #FB7185);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-size: 18px;
  }

  .hp59-hero__float-label {
    font-family: 'Cormorant Garamond', serif;
    font-size: 17px;
    font-weight: 700;
    color: #042F2E;
    margin: 0;
  }

  .hp59-hero__float-sub {
    font-size: 11px;
    color: #F97316;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 2px 0 0;
  }

  @media screen and (max-width: 992px) {
    .hp59-hero__container { grid-template-columns: 1fr; text-align: center; gap: 40px; }
    .hp59-hero__desc { margin-left: auto; margin-right: auto; }
    .hp59-hero__actions { justify-content: center; }
    .hp59-hero__img-wrap { height: 380px; }
    .hp59-hero__float-card { left: 50%; transform: translateX(-50%); bottom: -16px; }
  }

  @media screen and (max-width: 480px) {
    .hp59-hero__img-wrap { height: 300px; }
  }
{%- endstyle -%}

<div class="hp59-hero__container">
  <div>
    <div class="hp59-hero__badge">
      <span>🪸</span>
      <span>{{ section.settings.badge | default: 'SUNSET REEF v59' }}</span>
    </div>

    <h1 class="hp59-hero__title">
      {{ section.settings.heading | default: 'Sunset Coral Reef & <em>Marine Kelp</em> Glow' }}
    </h1>

    <p class="hp59-hero__desc">
      {{ section.settings.description | default: 'Harness the golden hour radiance with marine astaxanthin, nutrient-rich deep ocean kelp, and sea buckthorn coral nectar.' }}
    </p>

    <div class="hp59-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp59-hero__btn">
        <span>{{ section.settings.btn_text | default: 'Explore Coral Elixirs' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp59-hero__media">
    <div class="hp59-hero__img-wrap">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" class="hp59-hero__img" alt="{{ section.settings.heading }}" loading="eager">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp59-hero__img' }}
      {%- endif -%}

      <div class="hp59-hero__float-card">
        <div class="hp59-hero__float-icon">🪸</div>
        <div>
          <p class="hp59-hero__float-label">Astaxanthin Coral Glow</p>
          <p class="hp59-hero__float-sub">6,000x Vitamin C Potency</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP59 Hero",
  "class": "section-hp59-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FFFBEB" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#042F2E" },
    { "type": "color", "id": "accent_coral", "label": "Coral Accent", "default": "#FB7185" },
    { "type": "color", "id": "accent_tangerine", "label": "Tangerine Accent", "default": "#F97316" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#F97316" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "SUNSET REEF v59" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Sunset Coral Reef & <em>Marine Kelp</em> Glow" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Harness the golden hour radiance with marine astaxanthin and sea kelp." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Explore Coral Elixirs" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP59 Hero" }]
}
{% endschema %}
