{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --font-heading: 'Cormorant Garamond', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp26-video-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media screen and (max-width: 768px) {
    .hp26-video-wrapper {
      padding: 0 20px;
    }
  }

  .hp26-video__container {
    position: relative;
    width: 100%;
    /* Create an arch shape for the video */
    aspect-ratio: 16/9;
    border-top-left-radius: 50vw;
    border-top-right-radius: 50vw;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    overflow: hidden;
    background-color: #EAE6DF;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 768px) {
    .hp26-video__container {
      aspect-ratio: 4/5;
      border-top-left-radius: 40vw;
      border-top-right-radius: 40vw;
    }
  }

  .hp26-video__media {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }

  /* Overlay for text if placed inside */
  .hp26-video__overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    pointer-events: none;
  }

  .hp26-video__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 40px;
    color: #fff;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .hp26-video__subtitle {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 20px;
    opacity: 0.8;
  }

  .hp26-video__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 20px;
  }

  .hp26-video__title em {
    font-style: italic;
    font-weight: 300;
  }

  .hp26-video__play {
    width: 60px;
    height: 60px;
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(4px);
    transition: all 0.4s ease;
    margin-top: 20px;
  }

  .hp26-video__play:hover {
    background: #fff;
    border-color: #fff;
  }

  .hp26-video__play svg {
    width: 20px;
    height: 20px;
    fill: #fff;
    margin-left: 4px; /* optical center */
    transition: fill 0.4s ease;
  }

  .hp26-video__play:hover svg {
    fill: var(--text-color);
  }

  /* Text below video option */
  .hp26-video__text-below {
    text-align: center;
    margin-top: {{ section.settings.text_margin }}px;
    max-width: 600px;
  }

  .hp26-video__text-below-title {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 400;
    font-style: italic;
    color: var(--text-color);
    margin: 0 0 15px;
  }

  .hp26-video__text-below-p {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp26-video-wrapper" id="HP26Video-{{ section.id }}">
  <div class="hp26-video__container">
    {%- if section.settings.video_url != blank -%}
      <video class="hp26-video__media" autoplay muted loop playsinline>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image != blank -%}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1600 }}" alt="{{ section.settings.title | escape }}" class="hp26-video__media" loading="lazy">
    {%- else -%}
      <div class="hp26-video__media" style="background:#EAE6DF;display:flex;align-items:center;justify-content:center;color:#2C2A28;font-family:var(--font-heading);">VIDEO BACKGROUND</div>
    {%- endif -%}

    <div class="hp26-video__overlay"></div>

    <div class="hp26-video__content">
      {%- if section.settings.subtitle != blank -%}
        <div class="hp26-video__subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="hp26-video__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.show_play -%}
        <div class="hp26-video__play">
          <svg viewBox="0 0 24 24"><path d="M8 5V19L19 12L8 5Z"/></svg>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.text_below_title != blank or section.settings.text_below_p != blank -%}
    <div class="hp26-video__text-below">
      {%- if section.settings.text_below_title != blank -%}
        <h3 class="hp26-video__text-below-title">{{ section.settings.text_below_title }}</h3>
      {%- endif -%}
      {%- if section.settings.text_below_p != blank -%}
        <p class="hp26-video__text-below-p">{{ section.settings.text_below_p }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP26 - Japandi Video",
  "class": "section-hp26-video-banner",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (MP4)",
      "info": "Direct link to .mp4 file"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Overlay Opacity (%)",
      "default": 30
    },
    {
      "type": "header",
      "content": "Overlay Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "BEHIND THE SCENES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Making of <em>Simplicity</em>"
    },
    {
      "type": "checkbox",
      "id": "show_play",
      "label": "Show Play Button",
      "default": true
    },
    {
      "type": "header",
      "content": "Text Below Video"
    },
    {
      "type": "text",
      "id": "text_below_title",
      "label": "Bottom Title",
      "default": "Artisan Crafted."
    },
    {
      "type": "textarea",
      "id": "text_below_p",
      "label": "Bottom Text",
      "default": "Every piece is thoughtfully designed and slowly crafted to ensure minimal impact and maximum longevity."
    },
    {
      "type": "range",
      "id": "text_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Top for Text",
      "default": 60
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "header",
      "content": "Japandi Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5F2EB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C2A28"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP26 - Japandi Video"
    }
  ]
}
{% endschema %}
