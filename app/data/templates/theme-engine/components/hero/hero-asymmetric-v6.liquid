<div class="sf-hero-asymmetric js-motion-enabled sf-hero-{{ section.id }} {% if section.settings.layout == 'image_first' %}sf-hero-asymmetric--reverse{% endif %}">
  <div class="sf-hero-asymmetric__content">
    {% if section.settings.eyebrow != blank %}
      <span class="sf-reveal eyebrow sf-hero-asymmetric__eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    <h1 class="sf-reveal display-heading sf-hero-asymmetric__title">{{ section.settings.title }}</h1>
    {% if section.settings.subtitle != blank %}
      <p class="sf-reveal sf-hero-asymmetric__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
    
    <div class="sf-hero-asymmetric__actions sf-reveal">
      {% if section.settings.button_link != blank and section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="button button--primary">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
      {% if section.settings.button_link_2 != blank and section.settings.button_text_2 != blank %}
        <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">
          {{ section.settings.button_text_2 }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.trust_text != blank %}
      <div class="sf-hero-asymmetric__trust sf-reveal">
        {{ section.settings.trust_text }}
      </div>
    {% endif %}
  </div>
  
  <div class="sf-hero-asymmetric__media-wrapper sf-reveal">
    <div class="sf-hero-asymmetric__media">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: 'master' }}" alt="{{ section.settings.title }}" loading="lazy" fetchpriority="high">
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'sf-placeholder-svg' }}
      {% endif %}
    </div>
  </div>
</div>

<style>
  .sf-hero-{{ section.id }} {
    display: flex;
    flex-direction: column;
    background-color: var(--color-background);
    color: var(--color-text);
    overflow: hidden;
  }
  .sf-hero-asymmetric--reverse {
    flex-direction: column-reverse;
  }
  .sf-hero-asymmetric__content {
    padding: var(--spacing-section-y) var(--space-20);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .sf-hero-asymmetric__eyebrow {
    margin-bottom: var(--space-16);
    /* Intentional offset */
    margin-left: var(--space-24);
  }
  .sf-hero-asymmetric__title {
    margin-bottom: var(--space-20);
    font-weight: var(--weight-display);
  }
  .sf-hero-asymmetric__subtitle {
    margin-bottom: var(--space-32);
    opacity: 0.9;
  }
  .sf-hero-asymmetric__actions {
    display: flex;
    gap: var(--space-16);
    flex-wrap: wrap;
    margin-bottom: var(--space-24);
  }
  .sf-hero-asymmetric__trust {
    font-size: var(--font-small);
    color: var(--color-text-muted);
  }
  
  .sf-hero-asymmetric__media-wrapper {
    width: 100%;
    padding: 0;
  }
  .sf-hero-asymmetric__media {
    width: 100%;
    height: 400px;
    background-color: var(--color-surface);
  }
  .sf-hero-asymmetric__media img, .sf-hero-asymmetric__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sf-placeholder-svg {
    fill: var(--color-border);
  }

  .button {
    display: inline-block;
    padding: var(--space-12) var(--space-24);
    font-weight: var(--weight-heading);
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: var(--button-radius);
    transition: transform var(--transition-fast) ease, background-color var(--transition-fast) ease;
  }
  .button--primary {
    background-color: var(--color-accent);
    color: var(--color-background);
    border: 1px solid var(--color-accent);
  }
  .button--secondary {
    background-color: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-text);
  }
  .button:hover {
    transform: translateY(-2px);
  }
  
  /* Stagger animation overrides */
  .sf-hero-asymmetric__content > .sf-reveal:nth-child(1) { transition-delay: calc(var(--motion-stagger) * 1); }
  .sf-hero-asymmetric__content > .sf-reveal:nth-child(2) { transition-delay: calc(var(--motion-stagger) * 2); }
  .sf-hero-asymmetric__content > .sf-reveal:nth-child(3) { transition-delay: calc(var(--motion-stagger) * 3); }
  .sf-hero-asymmetric__content > .sf-reveal:nth-child(4) { transition-delay: calc(var(--motion-stagger) * 4); }
  .sf-hero-asymmetric__content > .sf-reveal:nth-child(5) { transition-delay: calc(var(--motion-stagger) * 5); }

  @media (min-width: 768px) {
    .sf-hero-{{ section.id }} {
      flex-direction: row;
      min-height: 80vh;
      align-items: center;
      padding: var(--spacing-section-y) 0;
    }
    .sf-hero-asymmetric--reverse {
      flex-direction: row-reverse;
    }
    .sf-hero-asymmetric__content {
      width: 45%;
      padding: 0 5% 0 10%;
    }
    .sf-hero-asymmetric--reverse .sf-hero-asymmetric__content {
      padding: 0 10% 0 5%;
    }
    .sf-hero-asymmetric__media-wrapper {
      width: 55%;
      /* Bleed off the edge, overlap top/bottom slightly */
      height: 90vh;
      margin-top: calc(var(--spacing-section-y) * -1);
      margin-bottom: calc(var(--spacing-section-y) * -1);
    }
    .sf-hero-asymmetric__media {
      height: 100%;
      border-radius: var(--radius-card, 0);
    }
    .sf-hero-asymmetric:not(.sf-hero-asymmetric--reverse) .sf-hero-asymmetric__media {
      border-top-left-radius: var(--radius-card, 0);
      border-bottom-left-radius: var(--radius-card, 0);
      border-top-right-radius: 0;
      border-bottom-right-radius: 0;
    }
    .sf-hero-asymmetric--reverse .sf-hero-asymmetric__media {
      border-top-right-radius: var(--radius-card, 0);
      border-bottom-right-radius: var(--radius-card, 0);
      border-top-left-radius: 0;
      border-bottom-left-radius: 0;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Asymmetric",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Image Placement",
      "options": [
        { "value": "text_first", "label": "Image Right" },
        { "value": "image_first", "label": "Image Left" }
      ],
      "default": "text_first"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "New Arrival"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Add a descriptive subheading to guide the user."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Primary Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_text_2",
      "label": "Secondary Button Text"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button Link"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust Strip (Optional)",
      "info": "E.g., Free shipping on orders over $50"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Hero Asymmetric",
      "category": "Hero"
    }
  ]
}
{% endschema %}
