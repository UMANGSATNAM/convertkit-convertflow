{%- comment -%}
  Component: hero-storytelling-luxury-v2
  Family: Luxury | Style: luxury
  Archetypes: luxury, premium, storytelling
  v2.0 — StoreForge Component Library
{%- endcomment -%}

<section class="hero-storytelling" style="position: relative; overflow: hidden; background-color: #000; color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 85vh;">
  
  <div class="hero-storytelling-media" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1920 }}" 
           alt="{{ section.settings.image.alt | escape }}" 
           loading="eager"
           style="width: 100%; height: 100%; object-fit: cover; filter: brightness(0.7);">
    {%- else -%}
      <div style="width: 100%; height: 100%; background: linear-gradient(180deg, #1A1A1A 0%, #000000 100%);"></div>
    {%- endif -%}
  </div>

  <div class="hero-storytelling-content" style="position: relative; z-index: 2; max-width: 900px; text-align: center; padding: var(--space-64) var(--space-24);">
    <div style="margin-bottom: var(--space-24);">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent, #c9a84c)" stroke-width="1" style="display: inline-block;">
        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
      </svg>
    </div>
    
    <h2 style="font-family: var(--font-heading-family); font-size: calc(2.5rem + 1vw); font-weight: 300; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: var(--space-24); line-height: 1.2;">
      {{ section.settings.heading | escape }}
    </h2>
    
    <p style="font-family: var(--font-body-family); font-size: 1.1rem; font-weight: 300; letter-spacing: 0.05em; max-width: 600px; margin: 0 auto var(--space-48) auto; line-height: 1.8; color: #d1d1d1;">
      {{ section.settings.text | escape }}
    </p>

    <div style="display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;">
      {%- if section.settings.button_label_1 != blank -%}
        <a href="{{ section.settings.button_link_1 }}" class="button" style="background-color: var(--color-accent, #c9a84c); color: #000; border: none; padding: 16px 40px; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.1em;">
          {{ section.settings.button_label_1 | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 }}" class="button" style="background-color: transparent; color: #fff; border: 1px solid rgba(255,255,255,0.3); padding: 16px 40px; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.1em; transition: border-color 0.3s;">
          {{ section.settings.button_label_2 | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Storytelling Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover the Collection"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Story Text",
      "default": "Explore our curated selection of premium products."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Storytelling Hero",
      "category": "Hero"
    }
  ]
}
{% endschema %}
