{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#F9F6F0'
  assign text_color = section.settings.text_color | default: '#2A3B2C'
  assign button_color = section.settings.button_color | default: '#8A9A86'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 20px; /* Small outer padding for framed look */
  }
  
  .hp10-hero-container-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 80vh;
    min-height: 600px;
    border-radius: 32px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .hp10-hero-bg-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  
  .hp10-hero-overlay-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(42, 59, 44, 0.3); /* Dark green tint */
    z-index: 2;
  }
  
  .hp10-hero-content-{{ section_id }} {
    position: relative;
    z-index: 3;
    text-align: center;
    color: #F9F6F0;
    max-width: 800px;
    padding: 0 20px;
  }
  
  .hp10-hero-subheading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: 0 0 20px 0;
    font-weight: 500;
  }
  
  .hp10-hero-heading-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 30px 0;
  }
  
  .hp10-hero-btn-{{ section_id }} {
    display: inline-block;
    background: {{ button_color }};
    color: #F9F6F0;
    padding: 16px 40px;
    border-radius: 40px; /* Pill shape */
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    border: none;
  }
  
  .hp10-hero-btn-{{ section_id }}:hover {
    background: #2A3B2C;
    transform: translateY(-2px);
  }
</style>

<div class="hp10-hero-container-{{ section_id }}">
  {% if section.settings.image != blank %}
    <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="Hero Image" class="hp10-hero-bg-{{ section_id }}">
  {% else %}
    <div class="hp10-hero-bg-{{ section_id }}" style="background: #D4A373;"></div>
  {% endif %}
  
  <div class="hp10-hero-overlay-{{ section_id }}"></div>
  
  <div class="hp10-hero-content-{{ section_id }}">
    <div class="hp10-hero-subheading-{{ section_id }}">{{ section.settings.subheading | default: '100% Organic Essentials' }}</div>
    <h1 class="hp10-hero-heading-{{ section_id }}">{{ section.settings.heading | default: 'Nature in harmony with you.' }}</h1>
    
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hp10-hero-btn-{{ section_id }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP10 Hero",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Outer Background Color",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#8A9A86"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "100% Organic Essentials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nature in harmony with you."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP10 Hero"
    }
  ]
}
{% endschema %}
