{%- style -%}
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@600;800&family=Inter:wght@400;500&display=swap');
#shopify-section-{{ section.id }}{background:#FFF7ED;padding:50px 0}
.hp94-wrap{max-width:1280px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
.hp94-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:18px 0}
.hp94-stat{background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:12px;padding:14px;text-align:center}
.hp94-stat b{font-family:'Manrope',sans-serif;font-size:20px;display:block}
.hp94-stat span{font-size:11px;letter-spacing:1px;text-transform:uppercase;opacity:.6}
.hp94-h{font-family:'Manrope',sans-serif;font-size:clamp(32px,4.5vw,52px);font-weight:800;line-height:1;margin:0}
.hp94-h span{color:#F97316}
.hp94-btn{margin-top:18px;display:inline-block;padding:14px 26px;background:#F97316;color:#fff;border-radius:10px;text-decoration:none;font-weight:700}
.hp94-media{border-radius:16px;overflow:hidden;height:520px;position:relative}
.hp94-media img{width:100%;height:100%;object-fit:cover}
.hp94-float{position:absolute;bottom:14px;left:14px;background:#fff;border-radius:12px;padding:12px 14px;display:flex;gap:10px;align-items:center;box-shadow:0 10px 30px rgba(0,0,0,.12)}
@media(max-width:900px){.hp94-wrap{grid-template-columns:1fr}.hp94-media{height:360px}}
{%- endstyle -%}
<div class="hp94-wrap">
  <div>
    <p style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#F97316;font-weight:700;margin:0 0 8px">{{section.settings.badge|default:'KIDS LAB v94'}}</p>
    <h1 class="hp94-h">{{section.settings.heading|default:'Measure <span>Every Rep</span>'}}</h1>
    <p style="opacity:.7;line-height:1.7;margin:10px 0">{{section.settings.description|default:'Safe soft creative essentials for tiny humans'}}</p>
    <div class="hp94-stats"><div class="hp94-stat"><b>4.8★</b><span>50k reviews</span></div><div class="hp94-stat"><b>₹2440</b><span>from</span></div><div class="hp94-stat"><b>7d</b><span>returns</span></div></div>
    <a href="{{section.settings.btn_url|default:'/collections/all'}}" class="hp94-btn">{{section.settings.btn_text|default:'Shop KIDS'}}</a>
  </div>
  <div class="hp94-media">{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:1000}}" alt="" loading="eager">{% else %}{{'collection-1'|placeholder_svg_tag}}{% endif %}<div class="hp94-float"><span style="width:38px;height:38px;border-radius:8px;background:#F97316;display:grid;place-items:center;color:#fff">★</span><span><b>{{section.settings.float_title|default:'Lab Tested'}}</b><br><small style="opacity:.6">{{section.settings.float_sub|default:'Certified'}}</small></span></div></div>
</div>
{% schema %}{"name":"HP94 Hero Stats","settings":[{"type":"color","id":"bg_color","label":"BG","default":"#FFF7ED"},{"type":"text","id":"badge","label":"Badge","default":"KIDS LAB v94"},{"type":"textarea","id":"heading","label":"Heading","default":"Measure Every Rep"},{"type":"textarea","id":"description","label":"Desc","default":"Safe soft creative essentials for tiny humans"},{"type":"text","id":"btn_text","label":"CTA","default":"Shop KIDS"},{"type":"url","id":"btn_url","label":"Link"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"float_title","label":"Float","default":"Lab Tested"},{"type":"text","id":"float_sub","label":"Sub","default":"Certified"}],"presets":[{"name":"HP94 Hero Stats"}]}{% endschema %}