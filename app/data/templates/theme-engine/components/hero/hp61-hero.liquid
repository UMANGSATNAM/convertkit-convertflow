{%- style -%}
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;600&display=swap');
#shopify-section-{{ section.id }}{background:#FFFBEB;padding:80px 0}
.hp61-wrap{max-width:1240px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:.95fr 1.05fr;gap:50px;align-items:center}
.hp61-h{font-family:'Cormorant Garamond',serif;font-size:clamp(38px,5vw,60px);font-weight:700}
.hp61-h em{color:#F97316;font-style:italic}
.hp61-arch{border-radius:180px 180px 24px 24px;overflow:hidden;height:520px;border:1px solid #F9731630}
.hp61-arch img{width:100%;height:100%;object-fit:cover}
@media(max-width:900px){.hp61-wrap{grid-template-columns:1fr}}
{%- endstyle -%}
<div class="hp61-wrap"><div><p style="letter-spacing:3px;text-transform:uppercase;color:#F97316;font-size:11px;font-weight:700">{{section.settings.badge|default:'KIDS v61'}}</p><h1 class="hp61-h">{{section.settings.heading|default:'Quiet <em>kids</em>'}}</h1><p>{{section.settings.description|default:'Safe soft essentials'}}</p><a href="{{section.settings.btn_url|default:'/collections/all'}}" style="background:#F97316;color:#fff;padding:14px 26px;border-radius:999px;text-decoration:none;font-weight:700">{{section.settings.btn_text|default:'Explore'}}</a></div><div class="hp61-arch">{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:1000}}">{% else %}{{'collection-1'|placeholder_svg_tag}}{% endif %}</div></div>
{% schema %}{"name":"HP61 Hero Editorial","settings":[{"type":"text","id":"badge","label":"Badge","default":"KIDS v61"},{"type":"textarea","id":"heading","label":"Heading","default":"Quiet kids"},{"type":"textarea","id":"description","label":"Desc","default":"Safe soft essentials"},{"type":"text","id":"btn_text","label":"CTA","default":"Explore"},{"type":"url","id":"btn_url","label":"Link"},{"type":"image_picker","id":"image","label":"Image"}],"presets":[{"name":"HP61 Hero Editorial"}]}{% endschema %}