{%- style -%}
@import url('https://fonts.googleapis.com/css2?family=Anton&family=Space+Mono:wght@400;700&display=swap');
#shopify-section-{{ section.id }}{background:{{section.settings.bg_color|default:'#ffffff'}};color:#111;padding:0;border-top:6px solid #16A34A;border-bottom:6px solid #111}
.hp80-bar{background:#16A34A;color:#fff;padding:8px 0;overflow:hidden;white-space:nowrap}
.hp80-bar span{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;margin-right:32px}
.hp80-grid{max-width:{{section.settings.container_width|default:1280}}px;margin:0 auto;display:grid;grid-template-columns:1.1fr .9fr;min-height:560px}
.hp80-left{padding:50px 24px;border-right:6px solid #111;display:flex;flex-direction:column;justify-content:center}
.hp80-badge{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;background:#111;color:#fff;display:inline-block;padding:6px 10px;margin-bottom:16px}
.hp80-h{font-family:'Anton',sans-serif;font-size:clamp(40px,6vw,78px);line-height:.9;text-transform:uppercase;margin:0}
.hp80-h span{color:#16A34A;-webkit-text-stroke:1.5px #111}
.hp80-p{font-family:'Space Mono',monospace;font-size:13px;line-height:1.7;opacity:.7;margin:14px 0 22px;max-width:480px}
.hp80-btn{font-family:'Anton',sans-serif;font-size:18px;letter-spacing:1px;text-transform:uppercase;background:#16A34A;color:#111;border:3px solid #111;padding:14px 26px;text-decoration:none;display:inline-block;box-shadow:6px 6px 0 #111}
.hp80-right{background:#f5f5f5;position:relative;overflow:hidden}
.hp80-right img{width:100%;height:100%;object-fit:cover;filter:grayscale(.1) contrast(1.1)}
.hp80-price{position:absolute;top:16px;right:16px;background:#fff;border:3px solid #111;padding:10px 14px;font-family:'Anton',sans-serif;box-shadow:4px 4px 0 #111}
@media(max-width:900px){.hp80-grid{grid-template-columns:1fr}.hp80-left{border-right:none;border-bottom:6px solid #111;text-align:center;align-items:center}}
{%- endstyle -%}
<div class="hp80-bar"><span>● GOURMET DROP v80</span><span>● FREE SHIPPING</span><span>● LIMITED STOCK</span><span>● GOURMET DROP v80</span></div>
<div class="hp80-grid">
  <div class="hp80-left">
    <div class="hp80-badge">{{section.settings.badge|default:'GOURMET v80 — BRUTALIST'}}</div>
    <h1 class="hp80-h">{{section.settings.heading|default:'RAW <span>FOOD</span>'}}</h1>
    <p class="hp80-p">{{section.settings.description|default:'Artisan organic staples for honest kitchens Built brutal, worn daily.'}}</p>
    <a href="{{section.settings.btn_url|default:'/collections/all'}}" class="hp80-btn">{{section.settings.btn_text|default:'Shop Brutal'}} →</a>
  </div>
  <div class="hp80-right">{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:1000}}" alt="" loading="eager">{% else %}{{'product-1'|placeholder_svg_tag}}{% endif %}<div class="hp80-price">FROM {{section.settings.price|default:'₹1,499'}}</div></div>
</div>
{% schema %}{"name":"HP80 Hero Brutalist","settings":[{"type":"color","id":"bg_color","label":"BG","default":"#ffffff"},{"type":"text","id":"badge","label":"Badge","default":"GOURMET v80 — BRUTALIST"},{"type":"textarea","id":"heading","label":"Heading","default":"RAW FOOD"},{"type":"textarea","id":"description","label":"Desc","default":"Artisan organic staples for honest kitchens"},{"type":"text","id":"btn_text","label":"CTA","default":"Shop Brutal"},{"type":"url","id":"btn_url","label":"Link"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"price","label":"Price badge","default":"FROM ₹1,499"},{"type":"range","id":"container_width","min":1000,"max":1440,"step":20,"unit":"px","label":"Width","default":1280}],"presets":[{"name":"HP80 Hero Brutalist"}]}{% endschema %}