{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --hp47-bg: {{ section.settings.bg_color | default: '#F5F0EB' }};
    --hp47-text: {{ section.settings.text_color | default: '#382E2B' }};
    --hp47-accent: {{ section.settings.accent_color | default: '#8C6D58' }};
    --hp47-card-bg: {{ section.settings.card_bg | default: '#FAF7F2' }};
    --hp47-btn-bg: {{ section.settings.btn_bg | default: '#382E2B' }};
    --hp47-btn-text-color: {{ section.settings.btn_text_color | default: '#FFFFFF' }};
    
    background-color: var(--hp47-bg);
    color: var(--hp47-text);
    font-family: 'Plus Jakarta Sans', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp47-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hp47-hero__arch-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 22px;
    background: #EAE3DA;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--hp47-text);
    margin-bottom: 24px;
  }

  .hp47-hero__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(42px, 6vw, 68px);
    font-weight: 600;
    line-height: 1.08;
    color: var(--hp47-text);
    margin: 0 0 22px;
  }

  .hp47-hero__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--hp47-accent);
  }

  .hp47-hero__desc {
    font-size: 16px;
    line-height: 1.75;
    color: #6E5E58;
    margin: 0 0 36px;
    max-width: 520px;
  }

  .hp47-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp47-hero__btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp47-btn-bg);
    color: var(--hp47-btn-text-color);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 10px 25px rgba(56, 46, 43, 0.15);
    transition: all 0.3s ease;
  }

  .hp47-hero__btn-primary:hover {
    background: var(--hp47-accent);
    transform: translateY(-2px);
  }

  .hp47-hero__media-arch {
    position: relative;
    border-radius: 300px 300px 30px 30px;
    overflow: hidden;
    background: #EAE3DA;
    box-shadow: 0 25px 60px rgba(56, 46, 43, 0.1);
    height: 520px;
  }

  .hp47-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp47-hero__floating-card {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    background: rgba(250, 247, 242, 0.92);
    backdrop-filter: blur(12px);
    border-radius: 20px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .hp47-hero__float-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--hp47-text);
    margin: 0;
  }

  .hp47-hero__float-sub {
    font-size: 12px;
    color: #8C6D58;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp47-hero__container { grid-template-columns: 1fr; text-align: center; }
    .hp47-hero__desc { margin-left: auto; margin-right: auto; }
    .hp47-hero__actions { justify-content: center; }
    .hp47-hero__media-arch { height: 380px; }
  }
{%- endstyle -%}

<div class="hp47-hero__container">
  <div>
    <div class="hp47-hero__arch-tag">
      <span>🌾</span>
      <span>{{ section.settings.badge | default: 'SCANDINAVIAN LINEN & TAUPE v47' }}</span>
    </div>

    <h1 class="hp47-hero__title">
      {{ section.settings.heading | default: 'Organic Linen & <em>Warm Taupe</em> Serenity' }}
    </h1>

    <p class="hp47-hero__desc">
      {{ section.settings.description | default: 'Gentle bio-fermented oat lipids and Nordic birch water that restore your natural lipid mantle with quiet Scandinavian sophistication.' }}
    </p>

    <div class="hp47-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp47-hero__btn-primary">
        <span>{{ section.settings.btn_text | default: 'Discover Linen Collection' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp47-hero__media-arch">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1000 }}" class="hp47-hero__img" alt="{{ section.settings.heading }}" loading="eager">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp47-hero__img' }}
    {%- endif -%}

    <div class="hp47-hero__floating-card">
      <div>
        <p class="hp47-hero__float-title">Nordic Oat &amp; Flax Lipids</p>
        <p class="hp47-hero__float-sub">100% Sustainable Scandinavian Harvest</p>
      </div>
      <span>🌾</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP47 - Taupe Hero",
  "class": "section-hp47-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F0EB" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#382E2B" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#8C6D58" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#382E2B" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "SCANDINAVIAN LINEN & TAUPE v47" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Organic Linen & <em>Warm Taupe</em> Serenity" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Gentle bio-fermented oat lipids and Nordic birch water that restore your natural lipid mantle." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Discover Linen Collection" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [
    { "name": "HP47 - Taupe Hero" }
  ]
}
{% endschema %}
