{%- liquid
  assign section_id = section.id
-%}

<style>
  #shopify-section-{{ section_id }} {
    border-bottom: 3px solid #000;
  }
  
  .hp11-banner-container-{{ section_id }} {
    width: 100%;
    position: relative;
    padding-top: 40%;
    min-height: 400px;
    background: #000;
    overflow: hidden;
  }
  
  .hp11-banner-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.6;
  }
  
  .hp11-banner-content-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  
  .hp11-banner-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 900;
    text-transform: uppercase;
    color: #CCFF00;
    margin: 0;
    line-height: 1;
    text-shadow: 5px 5px 0 #000;
  }
</style>

<div class="hp11-banner-container-{{ section_id }}">
  {% if section.settings.image != blank %}
    <img src="{{ section.settings.image | image_url: width: 2000 }}" class="hp11-banner-image-{{ section_id }}" alt="Banner">
  {% else %}
    <div class="hp11-banner-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
  {% endif %}
  
  <div class="hp11-banner-content-{{ section_id }}">
    <h2 class="hp11-banner-heading-{{ section_id }}">{{ section.settings.heading | default: 'STREET LEVEL' }}</h2>
  </div>
</div>

{% schema %}
{
  "name": "HP11 Image Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "STREET LEVEL"
    }
  ],
  "presets": [
    {
      "name": "HP11 Image Banner"
    }
  ]
}
{% endschema %}
