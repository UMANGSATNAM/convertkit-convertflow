{%- liquid
  assign section_id = section.id
-%}

<style>
  #shopify-section-{{ section_id }} {
    padding: 0;
  }
  
  .hp15-hero-container-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 90vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  
  .hp15-hero-bg-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
    filter: grayscale(100%) contrast(1.1);
  }
  
  .hp15-hero-overlay-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.2);
    z-index: 2;
  }
  
  .hp15-hero-content-{{ section_id }} {
    position: relative;
    z-index: 3;
    text-align: center;
    color: #ffffff;
    padding: 0 20px;
    max-width: 800px;
  }
  
  .hp15-hero-subtitle-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    margin-bottom: 20px;
  }
  
  .hp15-hero-title-{{ section_id }} {
    font-family: 'Didot', 'Playfair Display', serif;
    font-size: clamp(3rem, 6vw, 6rem);
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 40px 0;
    line-height: 1;
  }
  
  .hp15-hero-btn-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #000;
    background: #fff;
    text-decoration: none;
    padding: 18px 40px;
    display: inline-block;
    transition: all 0.3s ease;
  }
  
  .hp15-hero-btn-{{ section_id }}:hover {
    background: #000;
    color: #fff;
  }
  
  @media (max-width: 768px) {
    .hp15-hero-container-{{ section_id }} {
      height: 70vh;
    }
  }
</style>

<div class="hp15-hero-container-{{ section_id }}">
  {% if section.settings.image != blank %}
    <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 2000 }}" class="hp15-hero-bg-{{ section_id }}" alt="Hero Image">
  {% else %}
    <div class="hp15-hero-bg-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
  {% endif %}
  <div class="hp15-hero-overlay-{{ section_id }}"></div>
  
  <div class="hp15-hero-content-{{ section_id }}">
    {% if section.settings.subtitle != blank %}
      <div class="hp15-hero-subtitle-{{ section_id }}">{{ section.settings.subtitle }}</div>
    {% endif %}
    {% if section.settings.title != blank %}
      <h1 class="hp15-hero-title-{{ section_id }}">{{ section.settings.title }}</h1>
    {% endif %}
    {% if section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp15-hero-btn-{{ section_id }}">{{ section.settings.btn_text }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP15 Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "FW26 COLLECTION"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "THE NEW AVANT-GARDE"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "EXPLORE COLLECTION"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP15 Hero"
    }
  ]
}
{% endschema %}
