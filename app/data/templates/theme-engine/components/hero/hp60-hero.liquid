{%- style -%}
@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@600;800&family=Space+Grotesk:wght@500;700&display=swap');
#shopify-section-{{ section.id }}{background:#FEFCE8;color:#422006;font-family:'Space Grotesk',sans-serif;padding:0;position:relative;overflow:hidden}
.hp60-hero{max-width:1280px;margin:0 auto;padding:70px 24px;display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center}
.hp60-kicker{border:1px solid #CA8A04;color:#CA8A04;padding:6px 12px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase}
.hp60-title{font-family:'JetBrains Mono',monospace;font-size:clamp(32px,5vw,54px);font-weight:800;line-height:1;margin:14px 0}
.hp60-title span{color:#CA8A04}
.hp60-media{border:1px solid #CA8A0440;border-radius:12px;overflow:hidden;height:520px}
.hp60-media img{width:100%;height:100%;object-fit:cover}
@media(max-width:900px){.hp60-hero{grid-template-columns:1fr;text-align:center}}
{%- endstyle -%}
<div class="hp60-hero"><div><div class="hp60-kicker">{{section.settings.badge|default:'JEWELLERY v60'}}</div><h1 class="hp60-title">{{section.settings.heading|default:'JEWELLERY <span>jewellery</span>'}}</h1><p>{{section.settings.description|default:'Gold & lab diamonds'}}</p><a href="{{section.settings.btn_url|default:'/collections/all'}}" style="display:inline-block;margin-top:14px;padding:14px 26px;background:#CA8A04;color:#fff;text-decoration:none;font-weight:700">{{section.settings.btn_text|default:'Shop Now'}}</a></div><div class="hp60-media">{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:1000}}" alt="">{% else %}{{'lifestyle-1'|placeholder_svg_tag}}{% endif %}</div></div>
{% schema %}{"name":"HP60 Hero Cyber","settings":[{"type":"color","id":"bg_color","label":"BG","default":"#FEFCE8"},{"type":"text","id":"badge","label":"Badge","default":"JEWELLERY v60"},{"type":"textarea","id":"heading","label":"Heading","default":"JEWELLERY jewellery"},{"type":"textarea","id":"description","label":"Desc","default":"Gold & lab diamonds"},{"type":"text","id":"btn_text","label":"CTA","default":"Shop Now"},{"type":"url","id":"btn_url","label":"Link"},{"type":"image_picker","id":"image","label":"Image"}],"presets":[{"name":"HP60 Hero Cyber"}]}{% endschema %}