{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --btn-bg: {{ section.settings.btn_bg }};
    --btn-text: {{ section.settings.btn_text }};
    --font-heading: 'Lora', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Organic grain texture overlay */
  {% if section.settings.show_grain %}
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0.04;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
  {% endif %}

  .hp22-hero-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 768px) {
    .hp22-hero-wrapper {
      padding: 0 20px;
    }
  }

  .hp22-hero__container {
    display: flex;
    align-items: center;
    gap: {{ section.settings.gap }}px;
    flex-direction: {% if section.settings.layout == 'image_right' %}row{% else %}row-reverse{% endif %};
    min-height: {{ section.settings.min_height }}px;
  }

  @media screen and (max-width: 992px) {
    .hp22-hero__container {
      flex-direction: column-reverse;
      text-align: center;
      gap: 40px;
      min-height: auto;
      padding-top: 40px;
    }
  }

  .hp22-hero__text-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
  }

  @media screen and (max-width: 992px) {
    .hp22-hero__text-col {
      align-items: center;
    }
  }

  .hp22-hero__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--accent-color);
    text-transform: uppercase;
    margin: 0 0 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  @media screen and (max-width: 992px) {
    .hp22-hero__subtitle {
      justify-content: center;
    }
  }

  .hp22-hero__subtitle::before {
    content: '';
    display: {% if section.settings.layout == 'image_right' %}block{% else %}none{% endif %};
    width: 30px;
    height: 1px;
    background-color: var(--accent-color);
  }

  .hp22-hero__subtitle::after {
    content: '';
    display: {% if section.settings.layout == 'image_left' %}block{% else %}none{% endif %};
    width: 30px;
    height: 1px;
    background-color: var(--accent-color);
  }

  @media screen and (max-width: 992px) {
    .hp22-hero__subtitle::before,
    .hp22-hero__subtitle::after {
      display: none;
    }
  }

  .hp22-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 32px;
  }
  
  .hp22-hero__title em {
    font-style: italic;
    color: var(--accent-color);
    font-weight: 300;
  }

  .hp22-hero__text {
    font-family: var(--font-body);
    font-size: {{ section.settings.text_size }}px;
    font-weight: 300;
    line-height: 1.7;
    color: var(--text-color);
    opacity: 0.85;
    margin: 0 0 48px;
    max-width: 90%;
  }

  @media screen and (max-width: 992px) {
    .hp22-hero__text {
      max-width: 100%;
    }
  }

  .hp22-hero__btn-group {
    display: flex;
    gap: 20px;
    align-items: center;
  }

  @media screen and (max-width: 480px) {
    .hp22-hero__btn-group {
      flex-direction: column;
      width: 100%;
    }
  }

  .hp22-hero__btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background: var(--btn-bg);
    color: var(--btn-text);
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 15px;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: 40px; /* Pill shape for organic feel */
    transition: all 0.3s ease;
    border: 1px solid var(--btn-bg);
  }

  @media screen and (max-width: 480px) {
    .hp22-hero__btn-primary {
      width: 100%;
    }
  }

  .hp22-hero__btn-primary:hover {
    background: transparent;
    color: var(--btn-bg);
  }

  .hp22-hero__btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background: transparent;
    color: var(--text-color);
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 15px;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: 40px;
    transition: all 0.3s ease;
    border: 1px solid var(--text-color);
  }

  @media screen and (max-width: 480px) {
    .hp22-hero__btn-secondary {
      width: 100%;
    }
  }

  .hp22-hero__btn-secondary:hover {
    background: var(--text-color);
    color: var(--bg-color);
  }

  /* Image Column with Organic Shapes */
  .hp22-hero__image-col {
    flex: 1;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hp22-hero__image-wrapper {
    position: relative;
    width: 100%;
    max-width: 550px;
    aspect-ratio: {{ section.settings.image_ratio }};
    {% if section.settings.image_shape == 'arch' %}
      border-radius: 300px 300px 0 0;
    {% elsif section.settings.image_shape == 'pill' %}
      border-radius: 300px;
    {% elsif section.settings.image_shape == 'soft' %}
      border-radius: 24px;
    {% else %}
      border-radius: 0;
    {% endif %}
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,0.05);
  }

  .hp22-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 3s ease;
  }
  
  .hp22-hero__image-wrapper:hover .hp22-hero__image {
    transform: scale(1.05);
  }

  /* Decorative Abstract Shape behind image */
  .hp22-hero__deco-shape {
    position: absolute;
    width: 80%;
    height: 90%;
    background: var(--accent-color);
    opacity: 0.15;
    z-index: -1;
    {% if section.settings.image_shape == 'arch' %}
      border-radius: 300px 300px 0 0;
      top: -20px;
      right: -20px;
    {% elsif section.settings.image_shape == 'pill' %}
      border-radius: 300px;
      top: 20px;
      left: -20px;
    {% else %}
      border-radius: 40px;
      bottom: -20px;
      right: -20px;
    {% endif %}
    transition: all 0.5s ease;
  }

  .hp22-hero__image-col:hover .hp22-hero__deco-shape {
    transform: translate(10px, 10px);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp22-hero-wrapper" id="HP22Hero-{{ section.id }}">
  <div class="hp22-hero__container">
    
    <div class="hp22-hero__text-col">
      {%- if section.settings.subtitle != blank -%}
        <div class="hp22-hero__subtitle">{{ section.settings.subtitle | escape }}</div>
      {%- endif -%}
      
      {%- if section.settings.title != blank -%}
        <h1 class="hp22-hero__title">{{ section.settings.title }}</h1>
      {%- endif -%}
      
      {%- if section.settings.text != blank -%}
        <div class="hp22-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}
      
      <div class="hp22-hero__btn-group">
        {%- if section.settings.btn_primary_text != blank -%}
          <a href="{{ section.settings.btn_primary_link | default: '#' }}" class="hp22-hero__btn-primary">
            {{ section.settings.btn_primary_text | escape }}
          </a>
        {%- endif -%}
        
        {%- if section.settings.btn_secondary_text != blank -%}
          <a href="{{ section.settings.btn_secondary_link | default: '#' }}" class="hp22-hero__btn-secondary">
            {{ section.settings.btn_secondary_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="hp22-hero__image-col">
      <div class="hp22-hero__deco-shape"></div>
      <div class="hp22-hero__image-wrapper">
        {%- if section.settings.image != blank -%}
          <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.title | escape }}" class="hp22-hero__image" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;background:#e0d8d0;display:flex;align-items:center;justify-content:center;color:#8A9A86;">ORGANIC IMAGE</div>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP22 - Organic Hero",
  "class": "section-hp22-hero",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Position (Desktop)",
      "options": [
        { "value": "image_right", "label": "Image Right" },
        { "value": "image_left", "label": "Image Left" }
      ],
      "default": "image_right"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 400,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Desktop Min Height",
      "default": 750
    },
    {
      "type": "range",
      "id": "gap",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Gap between columns",
      "default": 80
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image Shape",
      "options": [
        { "value": "arch", "label": "Arch (Top Rounded)" },
        { "value": "pill", "label": "Pill (Fully Rounded)" },
        { "value": "soft", "label": "Soft Rounded Corners" },
        { "value": "square", "label": "Sharp Square" }
      ],
      "default": "arch"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Tall (4:5)" }
      ],
      "default": "4/5"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "NATURAL HARMONY"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>Return to your <em>roots</em> with pure botanicals.</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body Text",
      "default": "<p>Discover our consciously crafted collection of earthy essentials, designed to restore balance and cultivate inner peace.</p>"
    },
    {
      "type": "text",
      "id": "btn_primary_text",
      "label": "Primary Button Text",
      "default": "SHOP THE COLLECTION"
    },
    {
      "type": "url",
      "id": "btn_primary_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn_secondary_text",
      "label": "Secondary Button Text",
      "default": "OUR STORY"
    },
    {
      "type": "url",
      "id": "btn_secondary_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Organic Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3A3A3A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Green/Terracotta)",
      "default": "#8A9A86"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#8A9A86"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button Text",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Show subtle paper grain texture",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP22 - Organic Hero"
    }
  ]
}
{% endschema %}
