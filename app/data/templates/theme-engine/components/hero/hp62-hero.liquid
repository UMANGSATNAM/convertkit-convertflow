{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Italiana&family=Outfit:wght@400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --hp62-bg: {{ section.settings.bg_color | default: '#ECFDF5' }};
    --hp62-text: {{ section.settings.text_color | default: '#064E3B' }};
    --hp62-mint: {{ section.settings.accent_mint | default: '#10B981' }};
    --hp62-cyan: {{ section.settings.accent_cyan | default: '#06B6D4' }};
    --hp62-btn-bg: {{ section.settings.btn_bg | default: '#064E3B' }};
    --hp62-btn-text: {{ section.settings.btn_text_color | default: '#FFFFFF' }};

    background: radial-gradient(circle at 15% 25%, #CCFBF1 0%, var(--hp62-bg) 60%, #D1FAE5 100%);
    color: var(--hp62-text);
    font-family: 'Outfit', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp62-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 70px;
    align-items: center;
  }

  .hp62-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 18px;
    background: rgba(6, 78, 59, 0.08);
    border: 1px solid rgba(6, 78, 59, 0.2);
    border-radius: 50px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--hp62-text);
    margin-bottom: 24px;
  }

  .hp62-hero__title {
    font-family: 'Italiana', serif;
    font-size: clamp(40px, 5.5vw, 68px);
    font-weight: 400;
    line-height: 1.05;
    color: #064E3B;
    margin: 0 0 24px;
    letter-spacing: -0.5px;
  }

  .hp62-hero__title span {
    background: linear-gradient(135deg, #064E3B 0%, #059669 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp62-hero__desc {
    font-size: 16px;
    line-height: 1.8;
    color: #334155;
    margin: 0 0 36px;
    max-width: 520px;
  }

  .hp62-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp62-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp62-btn-bg);
    color: var(--hp62-btn-text);
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 50px;
    transition: all 0.35s ease;
    box-shadow: 0 8px 25px rgba(6, 78, 59, 0.25);
  }

  .hp62-hero__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(6, 78, 59, 0.4);
  }

  .hp62-hero__media {
    position: relative;
  }

  .hp62-hero__img-wrap {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    height: 520px;
    border: 1px solid rgba(6, 78, 59, 0.15);
    box-shadow: 0 25px 60px rgba(6, 78, 59, 0.12);
  }

  .hp62-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .hp62-hero__img-wrap:hover .hp62-hero__img {
    transform: scale(1.04);
  }

  .hp62-hero__float-card {
    position: absolute;
    bottom: -16px;
    left: -16px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(6, 78, 59, 0.2);
    border-radius: 16px;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 10px 30px rgba(6, 78, 59, 0.08);
  }

  .hp62-hero__float-icon {
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, #A7F3D0, #064E3B);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-size: 18px;
  }

  .hp62-hero__float-label {
    font-family: 'Italiana', serif;
    font-size: 18px;
    font-weight: 700;
    color: #064E3B;
    margin: 0;
  }

  .hp62-hero__float-sub {
    font-size: 11px;
    color: #059669;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 2px 0 0;
  }

  @media screen and (max-width: 992px) {
    .hp62-hero__container { grid-template-columns: 1fr; text-align: center; gap: 40px; }
    .hp62-hero__desc { margin-left: auto; margin-right: auto; }
    .hp62-hero__actions { justify-content: center; }
    .hp62-hero__img-wrap { height: 380px; }
    .hp62-hero__float-card { left: 50%; transform: translateX(-50%); bottom: -16px; }
  }

  @media screen and (max-width: 480px) {
    .hp62-hero__img-wrap { height: 300px; }
  }
{%- endstyle -%}

<div class="hp62-hero__container">
  <div>
    <div class="hp62-hero__badge">
      <span>🏔️</span>
      <span>{{ section.settings.badge | default: 'SWISS ALPS HARVEST v62' }}</span>
    </div>

    <h1 class="hp62-hero__title">
      Alpine Edelweiss & <span>Glacial Mineral Dew</span>
    </h1>

    <p class="hp62-hero__desc">
      {{ section.settings.description | default: 'Cultivated at 3,000 meters altitude in pristine Swiss alpine peaks, capturing leontopodic acid flavonoids and filtered Zermatt glacial mineral water.' }}
    </p>

    <div class="hp62-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp62-hero__btn">
        <span>{{ section.settings.btn_text | default: 'Discover Alpine Science' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp62-hero__media">
    <div class="hp62-hero__img-wrap">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" class="hp62-hero__img" alt="{{ section.settings.heading }}" loading="eager">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp62-hero__img' }}
      {%- endif -%}

      <div class="hp62-hero__float-card">
        <div class="hp62-hero__float-icon">🏔️</div>
        <div>
          <p class="hp62-hero__float-label">Leontopodic Acid 4X</p>
          <p class="hp62-hero__float-sub">High-Altitude Cellular Defense</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP62 Hero",
  "class": "section-hp62-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ECFDF5" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#064E3B" },
    { "type": "color", "id": "accent_mint", "label": "Mint Accent", "default": "#10B981" },
    { "type": "color", "id": "accent_cyan", "label": "Cyan Accent", "default": "#06B6D4" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#064E3B" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "SWISS ALPS HARVEST v62" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Alpine Edelweiss & <span>Glacial Mineral Dew</span>" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Cultivated at 3,000 meters altitude in pristine Swiss alpine peaks." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Discover Alpine Science" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP62 Hero" }]
}
{% endschema %}
