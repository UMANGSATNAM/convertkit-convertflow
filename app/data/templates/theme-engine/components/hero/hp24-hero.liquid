{%- style -%}
  /* Google Fonts for Cyberpunk aesthetic */
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-primary: {{ section.settings.accent_primary }};
    --accent-secondary: {{ section.settings.accent_secondary }};
    --font-heading: 'Orbitron', sans-serif;
    --font-body: 'Share Tech Mono', monospace;
    
    background-color: var(--bg-color);
    position: relative;
    overflow: hidden;
  }

  .hp24-hero-wrapper {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.hero_height_desktop }}vh;
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.content_alignment }};
    padding: 60px 40px;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp24-hero-wrapper {
      min-height: {{ section.settings.hero_height_mobile }}vh;
      padding: 40px 20px;
      justify-content: center;
      text-align: center;
    }
  }

  /* Grid Background Effect */
  .hp24-hero__grid-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-size: 40px 40px;
    background-image: 
      linear-gradient(to right, rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.05) 1px, transparent 1px);
    z-index: 0;
    pointer-events: none;
    perspective: 1000px;
  }

  /* Optional glowing overlay */
  .hp24-hero__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60vw;
    height: 60vw;
    background: radial-gradient(circle, var(--accent-primary) 0%, transparent 60%);
    opacity: 0.15;
    z-index: 0;
    filter: blur(50px);
    pointer-events: none;
  }

  /* Media Background */
  .hp24-hero__media {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
    opacity: {{ section.settings.media_opacity | divided_by: 100.0 }};
    filter: contrast(1.2) saturate(1.5);
  }

  /* Scanline effect */
  .hp24-hero__scanlines {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.2));
    background-size: 100% 4px;
    z-index: 0;
    pointer-events: none;
  }

  .hp24-hero__content {
    position: relative;
    z-index: 2;
    max-width: 800px;
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid var(--accent-primary);
    padding: 40px;
    backdrop-filter: blur(10px);
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.5), inset 0 0 10px var(--accent-primary);
  }

  /* Corner crosshairs */
  .hp24-hero__content::before,
  .hp24-hero__content::after {
    content: '';
    position: absolute;
    width: 20px;
    height: 20px;
    border: 2px solid var(--accent-secondary);
  }

  .hp24-hero__content::before {
    top: -5px; left: -5px;
    border-right: none; border-bottom: none;
  }

  .hp24-hero__content::after {
    bottom: -5px; right: -5px;
    border-left: none; border-top: none;
  }

  .hp24-hero__sys-text {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--accent-secondary);
    margin-bottom: 20px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hp24-hero__sys-text::before {
    content: '>';
    animation: blink 1s infinite;
  }

  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  .hp24-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    margin: 0 0 20px;
    text-transform: uppercase;
    line-height: 1;
    position: relative;
    text-shadow: 2px 2px 0px var(--accent-primary), -2px -2px 0px var(--accent-secondary);
  }

  /* Glitch effect on hover */
  .hp24-hero__title:hover {
    animation: glitch 0.3s cubic-bezier(.25, .46, .45, .94) both infinite;
  }

  @keyframes glitch {
    0% { transform: translate(0) }
    20% { transform: translate(-2px, 2px) }
    40% { transform: translate(-2px, -2px) }
    60% { transform: translate(2px, 2px) }
    80% { transform: translate(2px, -2px) }
    100% { transform: translate(0) }
  }

  .hp24-hero__text {
    font-family: var(--font-body);
    font-size: {{ section.settings.text_size }}px;
    color: var(--text-color);
    margin: 0 0 30px;
    line-height: 1.5;
    opacity: 0.9;
  }

  .hp24-hero__btn-group {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }

  @media screen and (max-width: 768px) {
    .hp24-hero__btn-group {
      justify-content: center;
    }
  }

  .hp24-hero__btn {
    font-family: var(--font-heading);
    display: inline-flex;
    align-items: center;
    padding: 15px 30px;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 2px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    background: transparent;
  }

  .hp24-hero__btn--primary {
    color: var(--bg-color);
    background: var(--accent-primary);
    border: 1px solid var(--accent-primary);
    box-shadow: 0 0 10px var(--accent-primary);
  }

  .hp24-hero__btn--primary:hover {
    background: transparent;
    color: var(--accent-primary);
    box-shadow: 0 0 20px var(--accent-primary);
  }

  .hp24-hero__btn--secondary {
    color: var(--accent-secondary);
    border: 1px solid var(--accent-secondary);
  }

  .hp24-hero__btn--secondary:hover {
    background: var(--accent-secondary);
    color: var(--bg-color);
    box-shadow: 0 0 15px var(--accent-secondary);
  }

  /* Scanline inside button */
  .hp24-hero__btn::after {
    content: '';
    position: absolute;
    top: 0; left: -100%; width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    transition: left 0.5s ease;
  }

  .hp24-hero__btn:hover::after {
    left: 100%;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp24-hero-wrapper" id="HP24Hero-{{ section.id }}">
  <div class="hp24-hero__grid-bg"></div>
  <div class="hp24-hero__glow"></div>
  <div class="hp24-hero__scanlines"></div>

  {%- if section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.title | strip_html | escape }}" class="hp24-hero__media" loading="eager">
  {%- endif -%}

  <div class="hp24-hero__content">
    {%- if section.settings.sys_text != blank -%}
      <div class="hp24-hero__sys-text">{{ section.settings.sys_text }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="hp24-hero__title">{{ section.settings.title }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hp24-hero__text">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="hp24-hero__btn-group">
      {%- if section.settings.btn_1_text != blank -%}
        <a href="{{ section.settings.btn_1_link | default: '#' }}" class="hp24-hero__btn hp24-hero__btn--primary">
          {{ section.settings.btn_1_text | escape }}
        </a>
      {%- endif -%}

      {%- if section.settings.btn_2_text != blank -%}
        <a href="{{ section.settings.btn_2_link | default: '#' }}" class="hp24-hero__btn hp24-hero__btn--secondary">
          {{ section.settings.btn_2_text | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP24 - Cyberpunk Hero",
  "class": "section-hp24-hero",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "media_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Media Opacity",
      "default": 40
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "sys_text",
      "label": "System Log Text",
      "default": "SYSTEM.INIT // V.20.77"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>ENTER THE NEON STREAM</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Upgrade your hardware. Maximize your output. The future is unwritten.</p>"
    },
    {
      "type": "text",
      "id": "btn_1_text",
      "label": "Button 1 Text",
      "default": "INITIALIZE"
    },
    {
      "type": "url",
      "id": "btn_1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn_2_text",
      "label": "Button 2 Text",
      "default": "VIEW DOCS"
    },
    {
      "type": "url",
      "id": "btn_2_link",
      "label": "Button 2 Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "hero_height_desktop",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop Height",
      "default": 90
    },
    {
      "type": "range",
      "id": "hero_height_mobile",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile Height",
      "default": 80
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment (Desktop)",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Cyberpunk Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_primary",
      "label": "Accent Primary (Neon Blue/Cyan)",
      "default": "#00F3FF"
    },
    {
      "type": "color",
      "id": "accent_secondary",
      "label": "Accent Secondary (Neon Pink/Magenta)",
      "default": "#FF00E6"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP24 - Cyberpunk Hero"
    }
  ]
}
{% endschema %}
