{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#F9F6F0'
  assign text_color = section.settings.text_color | default: '#2A3B2C'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(42, 59, 44, 0.1);
  }
  
  .hp10-header-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .hp10-header-nav-{{ section_id }} {
    display: flex;
    gap: 30px;
  }
  
  .hp10-header-nav-link-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: {{ text_color }};
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.5px;
    transition: opacity 0.3s ease;
  }
  
  .hp10-header-nav-link-{{ section_id }}:hover {
    opacity: 0.6;
  }
  
  .hp10-header-logo-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: 2rem;
    font-weight: 600;
    color: {{ text_color }};
    text-decoration: none;
    text-align: center;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  
  .hp10-header-icons-{{ section_id }} {
    display: flex;
    gap: 20px;
    align-items: center;
  }
  
  .hp10-header-icon-{{ section_id }} {
    color: {{ text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }
  
  .hp10-header-icon-{{ section_id }} svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  
  .hp10-header-icon-{{ section_id }}:hover {
    opacity: 0.6;
  }
  
  @media (max-width: 768px) {
    .hp10-header-nav-{{ section_id }} {
      display: none;
    }
    .hp10-header-logo-{{ section_id }} {
      position: static;
      transform: none;
      font-size: 1.5rem;
    }
    .hp10-header-menu-btn-{{ section_id }} {
      display: block;
    }
  }
  
  @media (min-width: 769px) {
    .hp10-header-menu-btn-{{ section_id }} {
      display: none;
    }
  }
</style>

<div class="hp10-header-container-{{ section_id }}">
  <div class="hp10-header-menu-btn-{{ section_id }}">
    <a href="#" class="hp10-header-icon-{{ section_id }}">
      <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/></svg>
    </a>
  </div>

  <nav class="hp10-header-nav-{{ section_id }}">
    {% for link in linklists.main-menu.links limit: 3 %}
      <a href="{{ link.url }}" class="hp10-header-nav-link-{{ section_id }}">{{ link.title }}</a>
    {% else %}
      <a href="#" class="hp10-header-nav-link-{{ section_id }}">Shop</a>
      <a href="#" class="hp10-header-nav-link-{{ section_id }}">Our Story</a>
      <a href="#" class="hp10-header-nav-link-{{ section_id }}">Sustainability</a>
    {% endfor %}
  </nav>
  
  <a href="/" class="hp10-header-logo-{{ section_id }}">
    {{ shop.name | default: 'BOTANICA' }}
  </a>
  
  <div class="hp10-header-icons-{{ section_id }}">
    <a href="/search" class="hp10-header-icon-{{ section_id }}">
      <svg viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <a href="/account" class="hp10-header-icon-{{ section_id }}">
      <svg viewBox="0 0 24 24"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    {% render 'search-bar', compact: true %}
    {% render 'wishlist-icon' %}
    <a href="/cart" data-cart-open class="hp10-header-icon-{{ section_id }}">
      <svg viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP10 Header",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2A3B2C"
    }
  ],
  "presets": [
    {
      "name": "HP10 Header"
    }
  ]
}
{% endschema %}
