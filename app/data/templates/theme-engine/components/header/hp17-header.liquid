{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0A0A0A'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    border-bottom: 1px solid rgba(0, 255, 65, 0.3);
    position: sticky;
    top: 0;
    z-index: 99;
  }
  
  .hp17-header-container-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 40px;
    max-width: 1600px;
    margin: 0 auto;
  }
  
  .hp17-header-menu-{{ section_id }} {
    display: flex;
    gap: 30px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }
  
  .hp17-header-menu-{{ section_id }} a {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: {{ text_color }};
    text-decoration: none;
    position: relative;
    padding: 5px 0;
    transition: all 0.2s ease;
  }
  
  .hp17-header-menu-{{ section_id }} a::before {
    content: '[';
    opacity: 0;
    color: #00FF41;
    margin-right: 5px;
    transition: opacity 0.2s ease;
  }
  
  .hp17-header-menu-{{ section_id }} a::after {
    content: ']';
    opacity: 0;
    color: #00FF41;
    margin-left: 5px;
    transition: opacity 0.2s ease;
  }
  
  .hp17-header-menu-{{ section_id }} a:hover {
    color: #00FF41;
    text-shadow: 0 0 5px rgba(0,255,65,0.5);
  }
  
  .hp17-header-menu-{{ section_id }} a:hover::before,
  .hp17-header-menu-{{ section_id }} a:hover::after {
    opacity: 1;
  }
  
  .hp17-header-logo-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: 2rem;
    font-weight: 900;
    color: #FFF;
    text-decoration: none;
    text-align: center;
    flex: 1;
    letter-spacing: 5px;
    position: relative;
  }
  
  .hp17-header-logo-{{ section_id }} span {
    color: #00FF41;
  }
  
  .hp17-header-icons-{{ section_id }} {
    display: flex;
    gap: 25px;
    justify-content: flex-end;
    flex: 1;
  }
  
  .hp17-header-icon-{{ section_id }} {
    color: {{ text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }
  
  .hp17-header-icon-{{ section_id }}:hover {
    color: #00FF41;
    filter: drop-shadow(0 0 5px rgba(0,255,65,0.5));
  }
  
  .hp17-header-icon-{{ section_id }} svg {
    width: 22px;
    height: 22px;
    stroke-width: 1.5;
  }
  
  .hp17-header-hamburger-{{ section_id }} {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    color: #00FF41;
  }

  @media (max-width: 992px) {
    .hp17-header-menu-{{ section_id }} {
      display: none;
    }
    .hp17-header-hamburger-{{ section_id }} {
      display: block;
    }
    .hp17-header-container-{{ section_id }} {
      padding: 15px 20px;
    }
  }
</style>

<div class="hp17-header-container-{{ section_id }}">
  <div style="flex:1;">
    <button class="hp17-header-hamburger-{{ section_id }}">
      <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>
    <ul class="hp17-header-menu-{{ section_id }}">
      {%- assign cf_menu = section.settings.menu | default: linklists['main-menu'] -%}

      {%- if cf_menu == blank -%}{%- assign cf_menu = linklists['main-menu'] -%}{%- endif -%}

      {%- for link in cf_menu.links -%}

        <li><a href="{{ link.url }}">{{ link.title }}</a></li>

      {%- endfor -%}
    </ul>
  </div>
  
  <a href="/" class="hp17-header-logo-{{ section_id }}">{{ shop.name | default: 'CYBER<span>TECH</span>' }}</a>
  
  <div class="hp17-header-icons-{{ section_id }}">
    <a href="/search" class="hp17-header-icon-{{ section_id }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </a>
    {% render 'search-bar', compact: true %}
    {% render 'wishlist-icon' %}
    <a href="/cart" data-cart-open class="hp17-header-icon-{{ section_id }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP17 Header",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "info": "Leave empty to use the store's main menu.",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border colour",
      "default": "#E5E7EB"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Falls back to the store name when empty."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stick to the top on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "HP17 Header"
    }
  ]
}
{% endschema %}
