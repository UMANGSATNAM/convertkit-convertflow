{% comment %}
  Header Minimal Inline - Streamlined boutique navigation with clean typography and subtle micro-borders
{% endcomment %}

<header class="header-minimal-inline" id="HeaderMinimalInline-{{ section.id }}">
  <div class="inline-nav-inner">
    <div class="left-section">
      <a href="{{ routes.root_url | default: '/' }}" class="brand-monogram">
        <span class="mono-symbol">◈</span>
        <span class="mono-title">{{ section.settings.brand_name | default: 'STUDIO NORDIC' }}</span>
      </a>
    </div>

    <nav class="center-links" aria-label="Main Store Navigation">
      <ul class="link-group">
        <li><a href="#" class="nav-anchor active">Essentials</a></li>
        <li><a href="#" class="nav-anchor">Furniture</a></li>
        <li><a href="#" class="nav-anchor">Lighting</a></li>
        <li><a href="#" class="nav-anchor">About</a></li>
      </ul>
    </nav>

    <div class="right-tools">
      <button type="button" class="tool-btn" aria-label="Search Catalog">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <span class="tool-label">Search</span>
      </button>

      <a href="/cart" class="tool-btn cart-indicator" aria-label="Shopping Bag">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="cart-dot">1</span>
      </a>
    </div>
  </div>
</header>

<style>
  #HeaderMinimalInline-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#ffffff' }};
    border-bottom: 1px solid #f1f5f9;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  #HeaderMinimalInline-{{ section.id }} * {
    box-sizing: border-box;
  }
  #HeaderMinimalInline-{{ section.id }} .inline-nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  #HeaderMinimalInline-{{ section.id }} .brand-monogram {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #0f172a;
  }
  #HeaderMinimalInline-{{ section.id }} .mono-symbol {
    font-size: 18px;
    color: #0f172a;
  }
  #HeaderMinimalInline-{{ section.id }} .mono-title {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  #HeaderMinimalInline-{{ section.id }} .center-links .link-group {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  #HeaderMinimalInline-{{ section.id }} .nav-anchor {
    color: #64748b;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    padding: 6px 0;
    position: relative;
    transition: color 0.2s;
  }
  #HeaderMinimalInline-{{ section.id }} .nav-anchor:hover,
  #HeaderMinimalInline-{{ section.id }} .nav-anchor.active {
    color: #0f172a;
  }
  #HeaderMinimalInline-{{ section.id }} .nav-anchor.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: #0f172a;
    border-radius: 2px;
  }
  #HeaderMinimalInline-{{ section.id }} .right-tools {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  #HeaderMinimalInline-{{ section.id }} .tool-btn {
    background: none;
    border: none;
    color: #0f172a;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    padding: 6px;
  }
  #HeaderMinimalInline-{{ section.id }} .cart-dot {
    background: #0f172a;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 2px;
  }

  @media (max-width: 768px) {
    #HeaderMinimalInline-{{ section.id }} .center-links {
      display: none;
    }
    #HeaderMinimalInline-{{ section.id }} .tool-label {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Header Minimal Inline",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "STUDIO NORDIC"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Header Background Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Header Minimal Inline"
    }
  ]
}
{% endschema %}
