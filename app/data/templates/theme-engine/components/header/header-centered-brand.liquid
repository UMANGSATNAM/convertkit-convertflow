{% comment %}
  Header Centered Brand - Symmetrical split navigation with prominent centered logo
{% endcomment %}

<header class="header-centered" id="HeaderCentered-{{ section.id }}">
  <div class="centered-nav-wrapper">
    <!-- Left Nav Links -->
    <nav class="split-nav nav-left" aria-label="Left Navigation">
      <ul class="nav-links">
        <li><a href="{{ section.settings.link_1_url | default: '#' }}">{{ section.settings.link_1_text | default: 'Collections' }}</a></li>
        <li><a href="{{ section.settings.link_2_url | default: '#' }}">{{ section.settings.link_2_text | default: 'New Drops' }}</a></li>
        <li><a href="{{ section.settings.link_3_url | default: '#' }}">{{ section.settings.link_3_text | default: 'Our Story' }}</a></li>
      </ul>
    </nav>

    <!-- Center Logo -->
    <div class="center-brand">
      <a href="{{ routes.root_url | default: '/' }}" class="brand-link">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo }}" alt="{{ shop.name | default: 'Brand' }}" class="brand-image" />
        {% else %}
          <span class="brand-heading">{{ section.settings.brand_text | default: 'MAISON ÉDITION' }}</span>
        {% endif %}
      </a>
    </div>

    <!-- Right Nav Links & Utilities -->
    <div class="right-cluster">
      <nav class="split-nav nav-right" aria-label="Right Navigation">
        <ul class="nav-links">
          <li><a href="{{ section.settings.link_4_url | default: '#' }}">{{ section.settings.link_4_text | default: 'Journal' }}</a></li>
          <li><a href="{{ section.settings.link_5_url | default: '#' }}">{{ section.settings.link_5_text | default: 'Archive' }}</a></li>
        </ul>
      </nav>

      <div class="utility-icons">
        <button type="button" class="icon-btn" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <a href="/cart" class="icon-btn cart-pill-btn" aria-label="Cart">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span class="cart-num">0</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  #HeaderCentered-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#faf9f6' }};
    border-bottom: 1px solid #e7e5e4;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  #HeaderCentered-{{ section.id }} * {
    box-sizing: border-box;
  }
  #HeaderCentered-{{ section.id }} .centered-nav-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 32px;
    height: 84px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  #HeaderCentered-{{ section.id }} .split-nav .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  #HeaderCentered-{{ section.id }} .split-nav a {
    color: #44403c;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  #HeaderCentered-{{ section.id }} .split-nav a:hover {
    color: #0c0a09;
  }
  #HeaderCentered-{{ section.id }} .center-brand {
    text-align: center;
    padding: 0 24px;
  }
  #HeaderCentered-{{ section.id }} .brand-heading {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #1c1917;
    text-transform: uppercase;
  }
  #HeaderCentered-{{ section.id }} .brand-image {
    max-height: 48px;
    width: auto;
    display: block;
    margin: 0 auto;
  }
  #HeaderCentered-{{ section.id }} .right-cluster {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 32px;
  }
  #HeaderCentered-{{ section.id }} .utility-icons {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  #HeaderCentered-{{ section.id }} .icon-btn {
    background: none;
    border: none;
    color: #1c1917;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    text-decoration: none;
  }
  #HeaderCentered-{{ section.id }} .cart-pill-btn {
    background: #1c1917;
    color: #ffffff;
    padding: 6px 12px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 600;
  }
  #HeaderCentered-{{ section.id }} .cart-num {
    font-size: 12px;
  }

  @media (max-width: 900px) {
    #HeaderCentered-{{ section.id }} .split-nav {
      display: none;
    }
    #HeaderCentered-{{ section.id }} .centered-nav-wrapper {
      display: flex;
      justify-content: space-between;
      height: 68px;
      padding: 0 20px;
    }
    #HeaderCentered-{{ section.id }} .brand-heading {
      font-size: 17px;
    }
  }
</style>

