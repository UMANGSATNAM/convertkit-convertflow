      "label": "Left Link 1 URL"
    },
    {
      "type": "text",
      "id": "link_2_text",
      "label": "Left Link 2 Text",
      "default": "New Drops"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Left Link 2 URL"
    },
    {
      "type": "text",
      "id": "link_3_text",
      "label": "Left Link 3 Text",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "link_3_url",
      "label": "Left Link 3 URL"
    },
    {
      "type": "text",
      "id": "link_4_text",
      "label": "Right Link 1 Text",
      "default": "Journal"
    },
    {
      "type": "url",
      "id": "link_4_url",
