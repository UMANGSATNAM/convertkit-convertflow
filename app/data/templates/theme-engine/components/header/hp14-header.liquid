{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffe8d6'
  assign text_color = section.settings.text_color | default: '#cb997e'
-%}

<style>
  :root { --border-color: {{ s.border_color }}; }

  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 25px 40px;
    border-bottom: 1px solid rgba(203, 153, 126, 0.2);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  
  .hp14-header-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .hp14-header-logo-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: 2rem;
    font-weight: normal;
    color: {{ text_color }};
    text-decoration: none;
    letter-spacing: -0.5px;
  }
  
  .hp14-header-nav-{{ section_id }} {
    display: flex;
    gap: 40px;
  }
  
  .hp14-header-nav-link-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    color: #6b705c;
    text-decoration: none;
    text-transform: capitalize;
    transition: color 0.3s ease;
  }
  
  .hp14-header-nav-link-{{ section_id }}:hover {
    color: {{ text_color }};
  }
  
  .hp14-header-icons-{{ section_id }} {
    display: flex;
    gap: 25px;
  }
  
  .hp14-header-icon-{{ section_id }} {
    color: #6b705c;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  
  .hp14-header-icon-{{ section_id }}:hover {
    color: {{ text_color }};
  }

  @media (max-width: 992px) {
    .hp14-header-nav-{{ section_id }} {
      display: none;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 20px;
    }
  }
</style>

<div class="hp14-header-container-{{ section_id }}">
  <div style="display: flex; align-items: center; gap: 20px;" class="hide-desktop">
    <a href="#" class="hp14-header-icon-{{ section_id }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </a>
  </div>

  <nav class="hp14-header-nav-{{ section_id }}">
    {% for link in linklists[section.settings.menu].links %}
      <a href="{{ link.url }}" class="hp14-header-nav-link-{{ section_id }}">{{ link.title }}</a>
    {% else %}
      {%- assign cf_menu = section.settings.menu | default: linklists['main-menu'] -%}

      {%- if cf_menu == blank -%}{%- assign cf_menu = linklists['main-menu'] -%}{%- endif -%}

      {%- for link in cf_menu.links -%}

        <a href="{{ link.url }}" class="hp14-header-nav-link-{{ section_id }}">{{ link.title }}</a>

      {%- endfor -%}
    {% endfor %}
  </nav>

  <a href="/" class="hp14-header-logo-{{ section_id }}">
    {{ shop.name | default: 'Botanica.' }}
  </a>

  <div class="hp14-header-icons-{{ section_id }}">
    <a href="/search" class="hp14-header-icon-{{ section_id }}">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </a>
    <a href="/account" class="hp14-header-icon-{{ section_id }}">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
    </a>
    {% render 'search-bar', compact: true %}
    {% render 'wishlist-icon' %}
    <a href="/cart" data-cart-open class="hp14-header-icon-{{ section_id }}">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP14 Header",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffe8d6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#cb997e"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border colour",
      "default": "#E5E7EB"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Falls back to the store name when empty."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stick to the top on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "HP14 Header"
    }
  ]
}
{% endschema %}
