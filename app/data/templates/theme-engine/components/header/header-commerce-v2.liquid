<div class="header-commerce-v2">
  <div class="header-tier-b">
    <div class="page-width">
      <div class="tier-b-inner">
        <div class="header-logo">
          {% if section.settings.logo_url != blank %}
            <img src="{{ section.settings.logo_url }}" alt="Logo" width="120" />
          {% else %}
            <span class="logo-text">{{ shop.name | default: 'Store Name' }}</span>
          {% endif %}
        </div>
        <div class="header-search">
          <input type="text" placeholder="{{ section.settings.search_placeholder | default: 'Search for products, brands, or categories...' }}" class="search-input" />
          <button class="search-btn">
             <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </button>
        </div>
        <div class="header-icons">
          <a href="#" class="icon-link">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            <span class="icon-text">Wishlist</span>
          </a>
          <a href="/cart" class="icon-link cart-link">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
            <span class="icon-text">Cart</span>
            <span class="cart-badge">2</span>
          </a>
        </div>
      </div>
    </div>
  </div>
  
  <div class="header-tier-c">
    <div class="page-width">
      <div class="tier-c-inner">
        <div class="browse-categories">
          <button class="browse-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            Browse Categories
          </button>
        </div>
        <nav class="header-nav">
          <a href="/">Home</a>
          <a href="/collections/all">Shop</a>
          <a href="/collections/bestsellers">Bestsellers</a>
          <a href="/pages/about">Our Story</a>
        </nav>
        <div class="header-contact">
           Need help? <strong>{{ section.settings.help_phone | default: '1800-123-456' }}</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.header-commerce-v2 {
  background-color: var(--surface);
  font-family: var(--font-family);
  box-shadow: var(--shadow-sm);
  position: relative;
  z-index: 100;
}
.tier-b-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-16) 0;
  gap: var(--space-32);
}
.header-logo .logo-text {
  font-size: var(--text-24);
  font-weight: 700;
  color: var(--primary);
  letter-spacing: -0.5px;
}
.header-search {
  flex: 1;
  max-width: 600px;
  display: flex;
  position: relative;
}
.search-input {
  width: 100%;
  padding: 14px 48px 14px 20px;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-pill);
  font-size: var(--text-14);
  background-color: var(--bg-base);
  outline: none;
  transition: all 0.2s ease;
  font-family: var(--font-family);
}
.search-input:focus {
  border-color: var(--primary);
  background-color: var(--surface);
}
.search-btn {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  cursor: pointer;
  color: var(--text-muted);
  display: flex;
  align-items: center;
}
.header-icons {
  display: flex;
  align-items: center;
  gap: var(--space-24);
}
.icon-link {
  font-size: var(--text-14);
  color: var(--text-main);
  text-decoration: none;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: color 0.2s;
}
.icon-link:hover {
  color: var(--primary);
}
.cart-link {
  position: relative;
}
.cart-badge {
  background-color: var(--sale-red, #D32F2F);
  color: var(--surface);
  font-size: 10px;
  width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  font-weight: 700;
  position: absolute;
  top: -8px;
  left: 14px;
  border: 2px solid var(--surface);
}
.header-tier-c {
  border-top: 1px solid var(--border);
}
.tier-c-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.browse-categories {
  height: 100%;
}
.browse-btn {
  background-color: var(--primary);
  color: var(--surface);
  border: none;
  padding: 14px var(--space-24);
  font-size: var(--text-14);
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: var(--space-12);
  transition: background-color 0.2s;
  font-family: var(--font-family);
}
.browse-btn:hover {
  background-color: var(--primary-hover, #146c43);
}
.header-nav {
  display: flex;
  gap: var(--space-32);
}
.header-nav a {
  color: var(--text-main);
  text-decoration: none;
  font-size: var(--text-14);
  font-weight: 500;
  padding: 14px 0;
  position: relative;
}
.header-nav a::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  width: 0%;
  height: 2px;
  background-color: var(--primary);
  transition: width 0.2s ease;
}
.header-nav a:hover::after {
  width: 100%;
}
.header-contact {
  font-size: var(--text-14);
  color: var(--text-muted);
}
.header-contact strong {
  color: var(--text-main);
  font-weight: 600;
}
@media (max-width: 990px) {
  .header-tier-c {
    display: none;
  }
  .header-search {
    display: none;
  }
  .icon-text {
    display: none;
  }
}
</style>

{% schema %}
{
  "name": "Header Commerce V2",
  "settings": [
    {
      "type": "url",
      "id": "logo_url",
      "label": "Logo URL"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder"
    },
    {
      "type": "text",
      "id": "help_phone",
      "label": "Help Phone Number"
    }
  ]
}
{% endschema %}
