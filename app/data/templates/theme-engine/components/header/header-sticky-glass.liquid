{% comment %}
  Header Sticky Glass - Floating capsule glassmorphic navigation with frosted backdrop
{% endcomment %}

<div class="header-sticky-glass-wrapper" id="HeaderStickyGlass-{{ section.id }}">
  <div class="glass-pill-nav">
    <div class="glass-brand">
      <a href="{{ routes.root_url | default: '/' }}" class="glass-logo">
        <span class="logo-dot"></span>
        <span class="brand-name">{{ section.settings.brand_name | default: 'LUMEN' }}</span>
      </a>
    </div>

    <nav class="glass-nav" aria-label="Quick Nav">
      <ul class="nav-items">
        <li><a href="#" class="nav-a active">Overview</a></li>
        <li><a href="#" class="nav-a">Features</a></li>
        <li><a href="#" class="nav-a">Catalog</a></li>
        <li><a href="#" class="nav-a">Reviews</a></li>
      </ul>
    </nav>

    <div class="glass-cta-wrap">
      <a href="/cart" class="glass-cart-btn" aria-label="Cart">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      </a>
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="glass-action-btn">
        {{ section.settings.btn_text | default: 'Get Started' }}
      </a>
    </div>
  </div>
</div>

<style>
  #HeaderStickyGlass-{{ section.id }} {
    position: sticky;
    top: 16px;
    z-index: 999;
    padding: 12px 16px;
    max-width: 1040px;
    margin: 0 auto;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    box-sizing: border-box;
  }
  #HeaderStickyGlass-{{ section.id }} * {
    box-sizing: border-box;
  }
  #HeaderStickyGlass-{{ section.id }} .glass-pill-nav {
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 12px 32px -4px rgba(15, 23, 42, 0.08), 0 0 0 1px rgba(0, 0, 0, 0.04);
    border-radius: 9999px;
    height: 56px;
    padding: 0 10px 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  #HeaderStickyGlass-{{ section.id }} .glass-brand {
    display: flex;
    align-items: center;
  }
  #HeaderStickyGlass-{{ section.id }} .glass-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #0f172a;
    font-weight: 800;
    font-size: 16px;
    letter-spacing: 0.1em;
  }
  #HeaderStickyGlass-{{ section.id }} .logo-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #2563eb;
  }
  #HeaderStickyGlass-{{ section.id }} .glass-nav {
    display: flex;
    align-items: center;
  }
  #HeaderStickyGlass-{{ section.id }} .nav-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  #HeaderStickyGlass-{{ section.id }} .nav-a {
    color: #475569;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 9999px;
    transition: all 0.2s ease;
  }
  #HeaderStickyGlass-{{ section.id }} .nav-a:hover {
    color: #0f172a;
    background: rgba(0, 0, 0, 0.04);
  }
  #HeaderStickyGlass-{{ section.id }} .nav-a.active {
    color: #0f172a;
    background: rgba(0, 0, 0, 0.05);
  }
  #HeaderStickyGlass-{{ section.id }} .glass-cta-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  #HeaderStickyGlass-{{ section.id }} .glass-cart-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0f172a;
    text-decoration: none;
    transition: background 0.2s;
  }
  #HeaderStickyGlass-{{ section.id }} .glass-cart-btn:hover {
    background: #e2e8f0;
  }
  #HeaderStickyGlass-{{ section.id }} .glass-action-btn {
    background: #0f172a;
    color: #ffffff;
    padding: 9px 18px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }
  #HeaderStickyGlass-{{ section.id }} .glass-action-btn:hover {
    background: #1e293b;
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    #HeaderStickyGlass-{{ section.id }} .glass-nav {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Header Sticky Glass",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "LUMEN"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "CTA Button Text",
      "default": "Get Started"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "CTA Button URL"
    }
  ],
  "presets": [
    {
      "name": "Header Sticky Glass"
    }
  ]
}
{% endschema %}
