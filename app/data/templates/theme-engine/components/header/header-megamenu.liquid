{% comment %}
  Header Megamenu - Full-featured navigation header with mega menu dropdown columns, search, and cart counter
{% endcomment %}

<header class="header-megamenu" id="HeaderMegamenu-{{ section.id }}">
  <div class="header-container">
    <!-- Mobile Hamburger Toggle -->
    <button type="button" class="mobile-menu-toggle" aria-label="Toggle Menu" onclick="document.getElementById('MobileNav-{{ section.id }}').classList.toggle('is-open')">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <!-- Brand Logo -->
    <div class="logo-wrap">
      <a href="{{ routes.root_url | default: '/' }}" class="logo-link">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo }}" alt="{{ shop.name | default: 'Store' }}" class="logo-img" />
        {% else %}
          <span class="logo-text">{{ section.settings.brand_name | default: 'ATELIER' }}</span>
        {% endif %}
      </a>
    </div>

    <!-- Desktop Navigation with Mega Menu -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        <li class="nav-item has-megamenu">
          <a href="#" class="nav-link">
            <span>Shop All</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </a>
          <!-- Mega Menu Dropdown Panel -->
          <div class="megamenu-panel">
            <div class="megamenu-grid">
              <div class="mega-col">
                <h4 class="mega-heading">New & Featured</h4>
                <ul class="mega-links">
                  <li><a href="#">Best Sellers</a></li>
                  <li><a href="#">New Arrivals</a></li>
                  <li><a href="#">Trending Now</a></li>
                  <li><a href="#">Gift Guide</a></li>
                  <li><a href="#">Special Offers</a></li>
                </ul>
              </div>
              <div class="mega-col">
                <h4 class="mega-heading">Apparel</h4>
                <ul class="mega-links">
                  <li><a href="#">Outerwear & Coats</a></li>
                  <li><a href="#">Premium Knitwear</a></li>
                  <li><a href="#">Tailored Trousers</a></li>
                  <li><a href="#">Organic Cotton Tees</a></li>
                  <li><a href="#">Loungewear</a></li>
                </ul>
              </div>
              <div class="mega-col">
                <h4 class="mega-heading">Accessories</h4>
                <ul class="mega-links">
                  <li><a href="#">Leather Bags</a></li>
                  <li><a href="#">Footwear & Boots</a></li>
                  <li><a href="#">Belts & Wallets</a></li>
                  <li><a href="#">Jewelry & Watches</a></li>
                  <li><a href="#">Hats & Scarves</a></li>
                </ul>
              </div>
              <div class="mega-col mega-promo">
                <div class="promo-card">
                  <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=400&auto=format&fit=crop&q=80" alt="Autumn Lookbook" loading="lazy" />
                  <div class="promo-info">
                    <span class="promo-tag">Collection</span>
                    <h5>Autumn Essentials</h5>
                    <a href="#" class="promo-link">Explore Drop →</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </li>
        <li class="nav-item"><a href="#" class="nav-link">Men</a></li>
        <li class="nav-item"><a href="#" class="nav-link">Women</a></li>
        <li class="nav-item"><a href="#" class="nav-link">Lookbook</a></li>
        <li class="nav-item"><a href="#" class="nav-link nav-sale">Sale <span class="sale-badge">Hot</span></a></li>
      </ul>
    </nav>

    <!-- Header Actions (Search, Account, Cart) -->
    <div class="header-actions">
      <button type="button" class="action-btn search-btn" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>

      <a href="/account" class="action-btn account-btn" aria-label="Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>

      <a href="/cart" class="action-btn cart-btn" aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="cart-count">2</span>
      </a>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-drawer" id="MobileNav-{{ section.id }}">
    <div class="drawer-header">
      <span class="drawer-title">Navigation</span>
      <button type="button" class="drawer-close" onclick="document.getElementById('MobileNav-{{ section.id }}').classList.remove('is-open')">✕</button>
    </div>
    <ul class="mobile-links">
      <li><a href="#">Shop All</a></li>
      <li><a href="#">Men's Collection</a></li>
      <li><a href="#">Women's Collection</a></li>
      <li><a href="#">Lookbook 2026</a></li>
      <li><a href="#" class="mobile-sale">Sale (Up to 50% Off)</a></li>
      <li><a href="/account">Account / Login</a></li>
    </ul>
  </div>
</header>

<style>
  #HeaderMegamenu-{{ section.id }} {
    position: relative;
    background: {{ section.settings.bg_color | default: '#ffffff' }};
    border-bottom: 1px solid #e2e8f0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    z-index: 99;
  }
  #HeaderMegamenu-{{ section.id }} * {
    box-sizing: border-box;
  }
  #HeaderMegamenu-{{ section.id }} .header-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  #HeaderMegamenu-{{ section.id }} .logo-text {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #0f172a;
    text-decoration: none;
  }
  #HeaderMegamenu-{{ section.id }} .logo-img {
    max-height: 44px;
    width: auto;
    display: block;
  }
  #HeaderMegamenu-{{ section.id }} .desktop-nav {
    display: flex;
    align-items: center;
  }
  #HeaderMegamenu-{{ section.id }} .nav-list {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #HeaderMegamenu-{{ section.id }} .nav-item {
    position: relative;
  }
  #HeaderMegamenu-{{ section.id }} .nav-link {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #334155;
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    padding: 26px 0;
    transition: color 0.2s;
  }
  #HeaderMegamenu-{{ section.id }} .nav-link:hover {
    color: #0f172a;
  }
  #HeaderMegamenu-{{ section.id }} .sale-badge {
    background: #ef4444;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 9999px;
    margin-left: 4px;
  }
  #HeaderMegamenu-{{ section.id }} .megamenu-panel {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    width: 900px;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.15);
    border: 1px solid #e2e8f0;
    padding: 32px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all 0.25s ease;
    z-index: 100;
  }
  #HeaderMegamenu-{{ section.id }} .has-megamenu:hover .megamenu-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  #HeaderMegamenu-{{ section.id }} .megamenu-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr) 1.5fr;
    gap: 32px;
  }
  #HeaderMegamenu-{{ section.id }} .mega-heading {
    margin: 0 0 16px 0;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #0f172a;
  }
  #HeaderMegamenu-{{ section.id }} .mega-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  #HeaderMegamenu-{{ section.id }} .mega-links a {
    color: #64748b;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.15s;
  }
  #HeaderMegamenu-{{ section.id }} .mega-links a:hover {
    color: #0f172a;
  }
  #HeaderMegamenu-{{ section.id }} .promo-card {
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    background: #f8fafc;
    height: 100%;
  }
  #HeaderMegamenu-{{ section.id }} .promo-card img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    display: block;
  }
  #HeaderMegamenu-{{ section.id }} .promo-info {
    padding: 16px;
  }
  #HeaderMegamenu-{{ section.id }} .promo-tag {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    color: #64748b;
  }
  #HeaderMegamenu-{{ section.id }} .promo-info h5 {
    margin: 4px 0 8px 0;
    font-size: 14px;
    font-weight: 600;
    color: #0f172a;
  }
  #HeaderMegamenu-{{ section.id }} .promo-link {
    color: #2563eb;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }
  #HeaderMegamenu-{{ section.id }} .header-actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  #HeaderMegamenu-{{ section.id }} .action-btn {
    background: none;
    border: none;
    color: #334155;
    cursor: pointer;
    position: relative;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }
  #HeaderMegamenu-{{ section.id }} .action-btn:hover {
    color: #0f172a;
  }
  #HeaderMegamenu-{{ section.id }} .cart-count {
    position: absolute;
    top: 0;
    right: -2px;
    background: #0f172a;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #HeaderMegamenu-{{ section.id }} .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: #0f172a;
    padding: 6px;
  }
  #HeaderMegamenu-{{ section.id }} .mobile-drawer {
    display: none;
  }

  @media (max-width: 991px) {
    #HeaderMegamenu-{{ section.id }} .desktop-nav {
      display: none;
    }
    #HeaderMegamenu-{{ section.id }} .mobile-menu-toggle {
      display: block;
    }
    #HeaderMegamenu-{{ section.id }} .mobile-drawer {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: 300px;
      background: #ffffff;
      box-shadow: 20px 0 50px rgba(0,0,0,0.2);
      transform: translateX(-100%);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 9999;
      padding: 24px;
    }
    #HeaderMegamenu-{{ section.id }} .mobile-drawer.is-open {
      transform: translateX(0);
    }
    #HeaderMegamenu-{{ section.id }} .drawer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      border-bottom: 1px solid #e2e8f0;
      padding-bottom: 16px;
    }
    #HeaderMegamenu-{{ section.id }} .drawer-title {
      font-size: 18px;
      font-weight: 700;
      color: #0f172a;
    }
    #HeaderMegamenu-{{ section.id }} .drawer-close {
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
    }
    #HeaderMegamenu-{{ section.id }} .mobile-links {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    #HeaderMegamenu-{{ section.id }} .mobile-links a {
      color: #0f172a;
      text-decoration: none;
      font-size: 16px;
      font-weight: 600;
    }
  }
</style>

{% schema %}
{
  "name": "Header Mega Menu",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "ATELIER"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Header Mega Menu"
    }
  ]
}
{% endschema %}
