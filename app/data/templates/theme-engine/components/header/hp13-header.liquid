{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#00FFA3'
-%}

<style>
  :root { --border-color: {{ s.border_color }}; }

  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    border-bottom: 1px solid {{ text_color }};
    position: sticky;
    top: 0;
    z-index: 999;
  }
  
  .hp13-header-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 15px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .hp13-header-nav-{{ section_id }} {
    display: flex;
    gap: 30px;
  }
  
  .hp13-header-nav-{{ section_id }} a {
    color: {{ text_color }};
    text-decoration: none;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.85rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.2s ease;
  }
  
  .hp13-header-nav-{{ section_id }} a:hover {
    text-shadow: 0 0 10px {{ text_color }};
  }
  
  .hp13-header-logo-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.5rem;
    font-weight: 900;
    color: {{ text_color }};
    text-decoration: none;
    letter-spacing: 4px;
    text-shadow: 2px 2px 0px rgba(0,255,163,0.3);
  }
  
  .hp13-header-actions-{{ section_id }} {
    display: flex;
    gap: 20px;
  }

  .hp13-header-icon-{{ section_id }} {
    color: {{ text_color }};
    text-decoration: none;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.85rem;
    font-weight: bold;
    display: flex;
    align-items: center;
  }

  .hp13-header-icon-{{ section_id }}:hover {
    text-shadow: 0 0 10px {{ text_color }};
  }

  @media (max-width: 768px) {
    .hp13-header-container-{{ section_id }} {
      padding: 15px 20px;
    }
    .hp13-header-nav-{{ section_id }} {
      display: none;
    }
  }
</style>

<div class="hp13-header-container-{{ section_id }}">
  <div class="hp13-header-nav-{{ section_id }}">
    {%- assign cf_menu = section.settings.menu | default: linklists['main-menu'] -%}

    {%- if cf_menu == blank -%}{%- assign cf_menu = linklists['main-menu'] -%}{%- endif -%}

    {%- for link in cf_menu.links -%}

      <a href="{{ link.url }}">{{ link.title }}</a>

    {%- endfor -%}
  </div>
  
  <a href="/" class="hp13-header-logo-{{ section_id }}">{{ shop.name | default: 'CYBER_SYS' }}</a>
  
  <div class="hp13-header-actions-{{ section_id }}">
    <a href="/search" class="hp13-header-icon-{{ section_id }}">[SRC]</a>
    <a href="/account" class="hp13-header-icon-{{ section_id }}">[USR]</a>
    {% render 'search-bar', compact: true %}
    {% render 'wishlist-icon' %}
    <a href="/cart" data-cart-open class="hp13-header-icon-{{ section_id }}">[CRT:0]</a>
  </div>
</div>

{% schema %}
{
  "name": "HP13 Header",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#00FFA3"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "info": "Leave empty to use the store's main menu.",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border colour",
      "default": "#E5E7EB"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Falls back to the store name when empty."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stick to the top on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "HP13 Header"
    }
  ]
}
{% endschema %}
