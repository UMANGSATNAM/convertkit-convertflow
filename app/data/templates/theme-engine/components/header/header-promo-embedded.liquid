{% comment %}
  Header Promo Embedded - Integrated announcement bar, WhatsApp direct chat, and conversion-focused navigation
{% endcomment %}

<header class="header-promo-embedded" id="HeaderPromo-{{ section.id }}">
  <!-- Integrated Top Banner -->
  <div class="embedded-top-strip">
    <div class="top-strip-inner">
      <div class="left-shipping">
        <span>{{ section.settings.shipping_notice | default: '⚡ Free Express Delivery on orders over $75' }}</span>
      </div>
      <div class="right-support">
        <a href="https://wa.me/{{ section.settings.whatsapp_number | default: '1234567890' }}" target="_blank" rel="noopener" class="whatsapp-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          <span>Chat on WhatsApp</span>
        </a>
        <span class="divider">|</span>
        <a href="/pages/faq" class="support-faq">Help & FAQ</a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Row -->
  <div class="main-bar">
    <div class="main-bar-inner">
      <div class="brand-area">
        <a href="{{ routes.root_url | default: '/' }}" class="store-logo">
          {{ section.settings.store_name | default: 'VELOCITY COMMERCE' }}
        </a>
      </div>

      <div class="search-form-wrap">
        <form action="/search" method="get" class="search-box">
          <input type="text" name="q" placeholder="{{ section.settings.search_placeholder | default: 'Search 5,000+ trending products...' }}" class="search-input" />
          <button type="submit" class="search-submit" aria-label="Submit Search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </button>
        </form>
      </div>

      <div class="user-cart-area">
        <a href="/cart" class="cart-pill-action">
          <div class="cart-icon-wrap">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <span class="cart-count">3</span>
          </div>
          <div class="cart-subtotal-text">
            <span class="cart-label">My Bag</span>
            <span class="cart-price">$84.50</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  #HeaderPromo-{{ section.id }} {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    border-bottom: 1px solid #e2e8f0;
  }
  #HeaderPromo-{{ section.id }} * {
    box-sizing: border-box;
  }
  #HeaderPromo-{{ section.id }} .embedded-top-strip {
    background: #0f172a;
    color: #ffffff;
    font-size: 12px;
    padding: 8px 24px;
  }
  #HeaderPromo-{{ section.id }} .top-strip-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  #HeaderPromo-{{ section.id }} .right-support {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  #HeaderPromo-{{ section.id }} .whatsapp-link {
    color: #4ade80;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }
  #HeaderPromo-{{ section.id }} .divider {
    color: #475569;
  }
  #HeaderPromo-{{ section.id }} .support-faq {
    color: #cbd5e1;
    text-decoration: none;
  }
  #HeaderPromo-{{ section.id }} .support-faq:hover {
    color: #ffffff;
  }
  #HeaderPromo-{{ section.id }} .main-bar {
    background: #ffffff;
    padding: 16px 24px;
  }
  #HeaderPromo-{{ section.id }} .main-bar-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  #HeaderPromo-{{ section.id }} .store-logo {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #0f172a;
    text-decoration: none;
    white-space: nowrap;
  }
  #HeaderPromo-{{ section.id }} .search-form-wrap {
    flex: 1;
    max-width: 580px;
  }
  #HeaderPromo-{{ section.id }} .search-box {
    display: flex;
    align-items: center;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.2s;
  }
  #HeaderPromo-{{ section.id }} .search-box:focus-within {
    border-color: #2563eb;
  }
  #HeaderPromo-{{ section.id }} .search-input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 10px 16px;
    font-size: 14px;
    outline: none;
    color: #0f172a;
  }
  #HeaderPromo-{{ section.id }} .search-submit {
    background: none;
    border: none;
    color: #64748b;
    padding: 0 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
  }
  #HeaderPromo-{{ section.id }} .search-submit:hover {
    color: #0f172a;
  }
  #HeaderPromo-{{ section.id }} .cart-pill-action {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 8px 16px;
    border-radius: 12px;
    text-decoration: none;
    transition: background 0.2s;
  }
  #HeaderPromo-{{ section.id }} .cart-pill-action:hover {
    background: #f1f5f9;
  }
  #HeaderPromo-{{ section.id }} .cart-icon-wrap {
    position: relative;
    color: #0f172a;
    display: flex;
    align-items: center;
  }
  #HeaderPromo-{{ section.id }} .cart-count {
    position: absolute;
    top: -6px;
    right: -8px;
    background: #ef4444;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #HeaderPromo-{{ section.id }} .cart-subtotal-text {
    display: flex;
    flex-direction: column;
  }
  #HeaderPromo-{{ section.id }} .cart-label {
    font-size: 10px;
    text-transform: uppercase;
    color: #64748b;
    font-weight: 700;
  }
  #HeaderPromo-{{ section.id }} .cart-price {
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
  }

  @media (max-width: 768px) {
    #HeaderPromo-{{ section.id }} .embedded-top-strip {
      display: none;
    }
    #HeaderPromo-{{ section.id }} .search-form-wrap {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Header Promo Embedded",
  "settings": [
    {
      "type": "text",
      "id": "store_name",
      "label": "Store Name",
      "default": "VELOCITY COMMERCE"
    },
    {
      "type": "text",
      "id": "shipping_notice",
      "label": "Top Shipping Notice",
      "default": "⚡ Free Express Delivery on orders over $75"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Phone Number",
      "default": "1234567890"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Box Placeholder",
      "default": "Search 5,000+ trending products..."
    }
  ],
  "presets": [
    {
      "name": "Header Promo Embedded"
    }
  ]
}
{% endschema %}
