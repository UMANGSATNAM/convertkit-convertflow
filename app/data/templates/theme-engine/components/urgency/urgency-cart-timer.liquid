{% comment %}
  Urgency Cart Reservation Timer - High-CRO Cart Reservation Bar
  PageFly-Style Booster Section
{% endcomment %}

<div id="cf-cart-timer-{{ section.id }}" class="cf-cart-reserve-bar" style="background: {{ section.settings.bg_color | default: '#fef2f2' }}; border-color: {{ section.settings.border_color | default: '#fecaca' }};">
  <div class="cf-cart-reserve-inner">
    <div class="cf-cart-reserve-left">
      <div class="cf-clock-pulse">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <div class="cf-cart-reserve-text">
        <strong style="color: {{ section.settings.text_color | default: '#991b1b' }};">{{ section.settings.title | default: 'Your cart is reserved for' }}</strong>
        <span class="cf-cart-clock-display" style="color: {{ section.settings.accent_color | default: '#dc2626' }};">
          <strong class="cf-cart-mins">14</strong>:<strong class="cf-cart-secs">59</strong> minutes!
        </span>
      </div>
    </div>
    <div class="cf-cart-reserve-right">
      <span class="cf-cart-reserve-sub" style="color: {{ section.settings.sub_text_color | default: '#b91c1c' }};">
        {{ section.settings.subtext | default: 'High demand! Items may sell out if not purchased.' }}
      </span>
    </div>
  </div>
</div>

<style>
  .cf-cart-reserve-bar {
    margin: 12px 0;
    padding: 12px 18px;
    border-radius: 8px;
    border: 1px solid #fecaca;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .cf-cart-reserve-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cf-cart-reserve-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cf-clock-pulse {
    width: 32px;
    height: 32px;
    border-radius: 99px;
    background: #fee2e2;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    animation: cfClockAlert 1.5s infinite;
  }
  @keyframes cfClockAlert {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }
  .cf-cart-reserve-text {
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .cf-cart-clock-display {
    font-family: monospace;
    font-size: 14px;
    font-weight: 800;
    background: rgba(220, 38, 38, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .cf-cart-reserve-sub {
    font-size: 11px;
    font-weight: 600;
  }
</style>

<script>
  (function() {
    var bar = document.getElementById("cf-cart-timer-{{ section.id }}");
    if (!bar) return;
    var durationMins = {{ section.settings.duration_minutes | default: 15 }};
    var storageKey = "cf_cart_reserve_end";
    var target = sessionStorage.getItem(storageKey);
    if (!target || isNaN(parseInt(target, 10)) || Date.now() > parseInt(target, 10)) {
      target = Date.now() + durationMins * 60 * 1000;
      sessionStorage.setItem(storageKey, target);
    } else {
      target = parseInt(target, 10);
    }

    var minsEl = bar.querySelector(".cf-cart-mins");
    var secsEl = bar.querySelector(".cf-cart-secs");

    function update() {
      var remaining = Math.max(0, target - Date.now());
      var m = Math.floor(remaining / (60 * 1000));
      var s = Math.floor((remaining % (60 * 1000)) / 1000);
      if (minsEl) minsEl.textContent = ("0" + m).slice(-2);
      if (secsEl) secsEl.textContent = ("0" + s).slice(-2);
      if (remaining === 0) {
        // Reset or keep at 00:00
        target = Date.now() + durationMins * 60 * 1000;
        sessionStorage.setItem(storageKey, target);
      }
    }
    update();
    setInterval(update, 1000);
  })();
</script>

{% schema %}
{
  "name": "Urgency Cart Timer",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Your cart is reserved for" },
    { "type": "number", "id": "duration_minutes", "label": "Reservation Duration (Minutes)", "default": 15 },
    { "type": "text", "id": "subtext", "label": "Urgency Subtext", "default": "High demand! Items may sell out if not purchased." },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#fef2f2" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#fecaca" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#991b1b" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#dc2626" }
  ],
  "presets": [
    {
      "name": "Urgency Cart Timer"
    }
  ]
}
{% endschema %}
