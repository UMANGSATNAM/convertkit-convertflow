{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0a0a0d'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ff88'
  assign image_position = section.settings.image_position | default: 'left'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
    position: relative;
    overflow: hidden;
  }
  
  .hp9-iwt-bg-elements-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  
  .hp9-iwt-bg-line-{{ section_id }} {
    position: absolute;
    background-color: rgba(0, 255, 136, 0.05);
  }
  
  .hp9-iwt-bg-line-h-{{ section_id }} { width: 100%; height: 1px; top: 30%; }
  .hp9-iwt-bg-line-v-{{ section_id }} { width: 1px; height: 100%; left: 70%; }
  
  .hp9-iwt-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 60px;
    position: relative;
    z-index: 2;
    flex-direction: {% if image_position == 'right' %}row-reverse{% else %}row{% endif %};
  }
  
  .hp9-iwt-image-col-{{ section_id }} {
    flex: 1;
    position: relative;
  }
  
  .hp9-iwt-image-wrapper-{{ section_id }} {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 20px;
    background: #111;
  }
  
  .hp9-iwt-image-wrapper-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: -5px;
    left: -5px;
    width: 30px;
    height: 30px;
    border-top: 2px solid {{ accent_color }};
    border-left: 2px solid {{ accent_color }};
  }
  
  .hp9-iwt-image-wrapper-{{ section_id }}::after {
    content: '';
    position: absolute;
    bottom: -5px;
    right: -5px;
    width: 30px;
    height: 30px;
    border-bottom: 2px solid {{ accent_color }};
    border-right: 2px solid {{ accent_color }};
  }
  
  .hp9-iwt-image-{{ section_id }} {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(100%) contrast(1.2);
    transition: filter 0.5s ease;
  }
  
  .hp9-iwt-image-wrapper-{{ section_id }}:hover .hp9-iwt-image-{{ section_id }} {
    filter: grayscale(0%) contrast(1);
  }
  
  .hp9-iwt-content-col-{{ section_id }} {
    flex: 1;
    padding: 40px 0;
  }
  
  .hp9-iwt-tag-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    color: {{ accent_color }};
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .hp9-iwt-tag-{{ section_id }}::before {
    content: '';
    width: 30px;
    height: 1px;
    background-color: {{ accent_color }};
  }
  
  .hp9-iwt-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 900;
    line-height: 1.1;
    margin: 0 0 25px 0;
    text-transform: uppercase;
    letter-spacing: -1px;
  }
  
  .hp9-iwt-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 40px 0;
    max-width: 500px;
  }
  
  .hp9-iwt-list-{{ section_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 40px 0;
    font-family: 'Space Mono', monospace;
    font-size: 0.9rem;
  }
  
  .hp9-iwt-list-{{ section_id }} li {
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 15px;
  }
  
  .hp9-iwt-list-{{ section_id }} li::before {
    content: '[+]';
    color: {{ accent_color }};
  }
  
  .hp9-iwt-btn-{{ section_id }} {
    display: inline-block;
    padding: 15px 35px;
    background: transparent;
    color: {{ accent_color }};
    border: 1px solid {{ accent_color }};
    text-decoration: none;
    font-family: 'Space Mono', monospace;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .hp9-iwt-btn-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: {{ accent_color }};
    transition: transform 0.3s ease;
    transform-origin: right;
    z-index: -1;
  }
  
  .hp9-iwt-btn-{{ section_id }}:hover {
    color: #000;
  }
  
  .hp9-iwt-btn-{{ section_id }}:hover::before {
    left: 0;
  }

  @media (max-width: 992px) {
    .hp9-iwt-container-{{ section_id }} {
      flex-direction: column;
      gap: 40px;
    }
    .hp9-iwt-image-col-{{ section_id }},
    .hp9-iwt-content-col-{{ section_id }} {
      width: 100%;
    }
  }
</style>

<div class="hp9-iwt-bg-elements-{{ section_id }}">
  <div class="hp9-iwt-bg-line-{{ section_id }} hp9-iwt-bg-line-h-{{ section_id }}"></div>
  <div class="hp9-iwt-bg-line-{{ section_id }} hp9-iwt-bg-line-v-{{ section_id }}"></div>
</div>

<div class="hp9-iwt-container-{{ section_id }}">
  <div class="hp9-iwt-image-col-{{ section_id }}">
    <div class="hp9-iwt-image-wrapper-{{ section_id }}">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading | escape }}" class="hp9-iwt-image-{{ section_id }}" loading="lazy" width="800" height="800">
      {% else %}
        <div style="width:100%; padding-bottom:100%; background:#1a1a1a; position:relative;">
          <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); color:rgba(255,255,255,0.2); font-family:'Space Mono', monospace;">VISUAL_DATA_MISSING</div>
        </div>
      {% endif %}
    </div>
  </div>
  
  <div class="hp9-iwt-content-col-{{ section_id }}">
    <div class="hp9-iwt-tag-{{ section_id }}">{{ section.settings.tag | default: 'SYSTEM_ARCHITECTURE' }}</div>
    <h2 class="hp9-iwt-heading-{{ section_id }}">{{ section.settings.heading | default: 'ENGINEERED FOR SUPREMACY' }}</h2>
    <p class="hp9-iwt-text-{{ section_id }}">{{ section.settings.text | default: 'Our hardware is built from the ground up using aerospace-grade materials and next-generation processing units. No compromises, no bottlenecks.' }}</p>
    
    <ul class="hp9-iwt-list-{{ section_id }}">
      <li>Quantum-level precision</li>
      <li>Zero-latency architecture</li>
      <li>Thermal dynamically optimized</li>
    </ul>
    
    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hp9-iwt-btn-{{ section_id }}">{{ section.settings.button_text }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP9 Image with Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ff88"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "SYSTEM_ARCHITECTURE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ENGINEERED FOR SUPREMACY"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Our hardware is built from the ground up using aerospace-grade materials and next-generation processing units. No compromises, no bottlenecks."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "VIEW SPECS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP9 Image with Text"
    }
  ]
}
{% endschema %}
