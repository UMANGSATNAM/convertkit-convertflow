{%- liquid
  assign bg_color = section.settings.bg_color | default: '#f4f7f9'
  assign text_color = section.settings.text_color | default: '#1a2a3a'
  assign accent_color = section.settings.accent_color | default: '#0066cc'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp5-brand-bg: {{ bg_color }};
    --hp5-brand-text: {{ text_color }};
    --hp5-brand-accent: {{ accent_color }};
    
    --hp5-brand-pt-desk: {{ padding_top_desktop }}px;
    --hp5-brand-pb-desk: {{ padding_bottom_desktop }}px;
    --hp5-brand-pt-mob: {{ padding_top_mobile }}px;
    --hp5-brand-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp5-health-brand-{{ section.id }} {
    padding-top: var(--hp5-brand-pt-desk);
    padding-bottom: var(--hp5-brand-pb-desk);
    background-color: var(--hp5-brand-bg);
    color: var(--hp5-brand-text);
    font-family: 'Inter', sans-serif;
  }

  .hp5-brand-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
  }

  .hp5-brand-inner.layout-right {
    flex-direction: row-reverse;
  }

  /* Media Side */
  .hp5-brand-media {
    flex: 1;
    position: relative;
  }

  .hp5-brand-img-wrap {
    width: 100%;
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 4/5;
    position: relative;
  }
  .hp5-brand-img {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  
  /* Floating stats card */
  .hp5-brand-stat {
    position: absolute;
    bottom: 40px;
    right: -40px;
    background: #ffffff;
    padding: 25px 35px;
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    text-align: center;
  }
  .hp5-brand-inner.layout-right .hp5-brand-stat {
    right: auto;
    left: -40px;
  }
  .hp5-brand-stat-num {
    display: block;
    font-size: 40px;
    font-weight: 800;
    color: var(--hp5-brand-accent);
    line-height: 1;
    margin-bottom: 5px;
  }
  .hp5-brand-stat-text {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: rgba(26,42,58,0.7);
  }

  /* Content Side */
  .hp5-brand-content {
    flex: 1;
    max-width: 600px;
  }

  .hp5-brand-label {
    display: inline-block;
    color: var(--hp5-brand-accent);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 20px;
  }

  .hp5-brand-title {
    font-size: clamp(36px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 25px 0;
    letter-spacing: -1px;
  }

  .hp5-brand-desc {
    font-size: 18px;
    line-height: 1.7;
    color: rgba(26,42,58,0.7);
    margin: 0 0 40px 0;
  }

  .hp5-brand-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    border-top: 1px solid rgba(26,42,58,0.1);
    padding-top: 40px;
  }

  .hp5-brand-icon-box {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .hp5-brand-icon {
    width: 48px; height: 48px;
    background: #ffffff;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    color: var(--hp5-brand-accent);
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
  }
  .hp5-brand-icon svg { width: 24px; height: 24px; }
  
  .hp5-brand-icon-title {
    font-size: 16px;
    font-weight: 700;
    margin: 0;
  }
  .hp5-brand-icon-text {
    font-size: 14px;
    color: rgba(26,42,58,0.7);
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 1024px) {
    .hp5-brand-inner, .hp5-brand-inner.layout-right {
      flex-direction: column;
      gap: 60px;
    }
    .hp5-brand-stat {
      right: 20px; left: auto;
      bottom: 20px;
    }
    .hp5-brand-inner.layout-right .hp5-brand-stat {
      left: 20px; right: auto;
    }
    .hp5-brand-content {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 768px) {
    .hp5-health-brand-{{ section.id }} {
      padding-top: var(--hp5-brand-pt-mob);
      padding-bottom: var(--hp5-brand-pb-mob);
    }
    .hp5-brand-inner {
      padding: 0 20px;
    }
    .hp5-brand-stat {
      padding: 15px 25px;
    }
    .hp5-brand-stat-num { font-size: 32px; }
    .hp5-brand-grid {
      grid-template-columns: 1fr;
      gap: 20px;
      padding-top: 30px;
    }
  }
</style>

<section class="hp5-health-brand-{{ section.id }}" aria-label="Brand Story">
  <div class="hp5-brand-inner layout-{{ section.settings.layout }}">
    
    <div class="hp5-brand-media">
      <div class="hp5-brand-img-wrap">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1000 }}" class="hp5-brand-img" loading="lazy" alt="Research">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'hp5-brand-img placeholder-svg' }}
        {%- endif -%}
      </div>
      
      {%- if section.settings.show_stat -%}
      <div class="hp5-brand-stat">
        <span class="hp5-brand-stat-num">{{ section.settings.stat_num }}</span>
        <span class="hp5-brand-stat-text">{{ section.settings.stat_text }}</span>
      </div>
      {%- endif -%}
    </div>

    <div class="hp5-brand-content">
      <span class="hp5-brand-label">{{ section.settings.label }}</span>
      <h2 class="hp5-brand-title">{{ section.settings.title }}</h2>
      <p class="hp5-brand-desc">{{ section.settings.description }}</p>

      <div class="hp5-brand-grid">
        {%- for block in section.blocks -%}
          <div class="hp5-brand-icon-box" {{ block.shopify_attributes }}>
            <div class="hp5-brand-icon">
              <!-- Inline SVGs for trust -->
              {%- case forloop.index -%}
                {%- when 1 -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                {%- when 2 -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
              {%- endcase -%}
            </div>
            <div>
              <h4 class="hp5-brand-icon-title">{{ block.settings.title }}</h4>
              <p class="hp5-brand-icon-text">{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endfor -%}
        
        {%- if section.blocks.size == 0 -%}
          <div class="hp5-brand-icon-box">
            <div class="hp5-brand-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></div>
            <div>
              <h4 class="hp5-brand-icon-title">3rd Party Tested</h4>
              <p class="hp5-brand-icon-text">Every batch is rigorously tested for purity, potency, and safety.</p>
            </div>
          </div>
          <div class="hp5-brand-icon-box">
            <div class="hp5-brand-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></div>
            <div>
              <h4 class="hp5-brand-icon-title">Transparent Sourcing</h4>
              <p class="hp5-brand-icon-text">We trace every ingredient to its origin, ensuring ethical standards.</p>
            </div>
          </div>
        {%- endif -%}
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP5 Health Brand Story",
  "tag": "section",
  "class": "section-hp5-brand-story",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Image Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "show_stat",
      "label": "Show Floating Stat",
      "default": true
    },
    {
      "type": "text",
      "id": "stat_num",
      "label": "Stat Number",
      "default": "15+"
    },
    {
      "type": "text",
      "id": "stat_text",
      "label": "Stat Text",
      "default": "Patented Ingredients"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small Label",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Bridging the gap between nature and clinical science."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We believe that optimal health requires more than just good intentions. That's why every product we create starts with peer-reviewed research and ends with clinical trials."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f7f9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a2a3a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0066cc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "3rd Party Tested"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every batch is rigorously tested for purity, potency, and safety."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP5 Health Brand Story",
      "category": "About",
      "blocks": [
        { "type": "point", "settings": { "title": "3rd Party Tested" } },
        { "type": "point", "settings": { "title": "Transparent Sourcing" } }
      ]
    }
  ]
}
{% endschema %}
