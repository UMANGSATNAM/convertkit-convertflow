{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffe8d6'
  assign text_color = section.settings.text_color | default: '#6b705c'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 40px;
    border-bottom: 1px solid rgba(107, 112, 92, 0.1);
  }
  
  .hp14-brand-story-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  
  .hp14-brand-story-subheading-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 30px;
    color: #cb997e;
  }
  
  .hp14-brand-story-heading-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: normal;
    color: {{ text_color }};
    margin: 0 0 40px 0;
    line-height: 1.2;
  }
  
  .hp14-brand-story-heading-{{ section_id }} span {
    font-style: italic;
    color: #a5a58d;
  }
  
  .hp14-brand-story-text-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1.1rem;
    line-height: 1.8;
    color: #6b705c;
    margin: 0 0 50px 0;
  }
  
  .hp14-brand-story-btn-{{ section_id }} {
    display: inline-block;
    padding: 16px 40px;
    background: transparent;
    border: 1px solid #cb997e;
    color: #cb997e;
    text-decoration: none;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 50px;
    transition: all 0.3s ease;
  }
  
  .hp14-brand-story-btn-{{ section_id }}:hover {
    background: #cb997e;
    color: #fff;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 80px 20px;
    }
  }
</style>

<div class="hp14-brand-story-container-{{ section_id }}">
  <div class="hp14-brand-story-subheading-{{ section_id }}">{{ section.settings.subheading | default: 'Our Heritage' }}</div>
  <h2 class="hp14-brand-story-heading-{{ section_id }}">{{ section.settings.heading | default: 'Born from the earth, crafted with <span>care.</span>' }}</h2>
  <div class="hp14-brand-story-text-{{ section_id }}">
    {{ section.settings.text | default: 'We started with a simple belief: that nature holds the key to true beauty. For over a decade, we have been working with local farmers to ethically source the finest ingredients, creating formulas that honor your skin and our planet.' }}
  </div>
  
  {% if section.settings.button_label != blank %}
    <a href="{{ section.settings.button_link | default: '#' }}" class="hp14-brand-story-btn-{{ section_id }}">
      {{ section.settings.button_label }}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "HP14 Brand Story",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffe8d6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6b705c"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our Heritage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Born from the earth, crafted with <span>care.</span>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We started with a simple belief: that nature holds the key to true beauty. For over a decade, we have been working with local farmers to ethically source the finest ingredients, creating formulas that honor your skin and our planet."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP14 Brand Story"
    }
  ]
}
{% endschema %}
