{%- comment -%}
  Component: brand-story-luxury-jewellery-v1
  Family: Luxury | Style: luxury
  Archetypes: luxury, premium
  v2.0 — StoreForge Component Library
{%- endcomment -%}
<section class="image-with-text image-with-text--jewellery" style="padding: var(--space-64) 0; background-color: var(--color-background);">
  <div class="container" style="display: flex; flex-direction: column; gap: var(--space-40); align-items: center;" class="md-flex-row">
    
    {%- liquid
      assign is_reversed = false
      if section.settings.layout == 'text_first'
        assign is_reversed = true
      endif
    -%}

    <div style="display: flex; flex-direction: column; gap: var(--space-48); align-items: center; width: 100%;" class="md-flex-row {% if is_reversed %}flex-row-reverse{% endif %}">
      
      <!-- Image Col -->
      <div class="image-with-text-media" style="flex: 1; width: 100%;">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1000 }}" 
               alt="{{ section.settings.image.alt | escape }}" 
               loading="lazy"
               style="width: 100%; border: 1px solid var(--color-border); padding: var(--space-8); background-color: var(--color-background);">
        {%- else -%}
          <div style="width: 100%; aspect-ratio: 4/3; background-color: var(--color-surface); display: flex; align-items: center; justify-content: center; border: 1px solid var(--color-border);">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <!-- Text Col -->
      <div class="image-with-text-content" style="flex: 1; width: 100%; padding: 0 var(--space-16); text-align: left;">
        <h3 class="image-with-text-heading" style="font-family: var(--font-heading-family); font-size: 2.2rem; font-weight: 400; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: var(--space-16); line-height: 1.2;">
          {{ section.settings.heading | escape }}
        </h3>
        
        <div class="image-with-text-text rte" style="font-family: var(--font-body-family); font-size: 0.95rem; line-height: 1.8; color: #4a4944; margin-bottom: var(--space-24);">
          {{ section.settings.text }}
        </div>

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="button button--primary">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>

    </div>

  </div>
</section>

<style>
  @media screen and (min-width: 768px) {
    .image-with-text-niche > .container {
      flex-direction: row !important;
    }
    .flex-row-reverse {
      flex-direction: row-reverse !important;
    }
  }
</style>

{% schema %}
{
  "name": "Image with Text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image_first", "label": "Image first" },
        { "value": "text_first", "label": "Text first" }
      ],
      "default": "image_first"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heritage & Craft"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Each piece is individually sculpted by our master jewelers in our private workshop, ensuring unmatched precision, design clarity, and longevity.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ]
}
{% endschema %}
