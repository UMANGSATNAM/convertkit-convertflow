{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#F4F4F0'
  assign layout_style = section.settings.layout_style | default: 'asymmetrical'
  assign padding_top = section.settings.padding_top | default: 120
  assign padding_bottom = section.settings.padding_bottom | default: 120
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .hp7-editorial-{{ section_id }} {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 4vw;
  }
  
  .hp7-editorial__header {
    margin-bottom: 6rem;
    {%- if section.settings.title_alignment == 'center' -%}
      text-align: center;
    {%- elsif section.settings.title_alignment == 'right' -%}
      text-align: right;
    {%- endif -%}
  }
  
  .hp7-editorial__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3rem, 6vw, 6rem);
    font-weight: 400;
    line-height: 1;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  
  .hp7-editorial__title em {
    font-style: italic;
    opacity: 0.7;
  }

  .hp7-editorial__grid {
    display: grid;
    gap: 4vw;
  }
  
  /* Layout: Asymmetrical */
  .hp7-editorial__grid--asymmetrical {
    grid-template-columns: repeat(12, 1fr);
    align-items: center;
  }
  
  .hp7-editorial__grid--asymmetrical .hp7-editorial__column:nth-child(1) {
    grid-column: 1 / 8;
  }
  .hp7-editorial__grid--asymmetrical .hp7-editorial__column:nth-child(2) {
    grid-column: 9 / 13;
  }
  .hp7-editorial__grid--asymmetrical .hp7-editorial__column:nth-child(even) .hp7-editorial__image-wrap {
    aspect-ratio: 3/4;
  }

  /* Layout: Even */
  .hp7-editorial__grid--even {
    grid-template-columns: repeat(2, 1fr);
  }

  .hp7-editorial__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .hp7-editorial__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  
  .hp7-editorial__column:hover .hp7-editorial__image {
    transform: scale(1.05);
  }

  .hp7-editorial__content {
    display: flex;
    flex-direction: column;
  }

  .hp7-editorial__col-title {
    font-family: 'Inter', sans-serif;
    font-size: clamp(14px, 1.2vw, 18px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--text-color);
    padding-bottom: 1rem;
  }

  .hp7-editorial__col-text {
    font-family: 'Inter', sans-serif;
    font-size: clamp(14px, 1vw, 16px);
    line-height: 1.6;
    opacity: 0.8;
    margin: 0;
  }

  @media screen and (max-width: 990px) {
    #shopify-section-{{ section_id }} {
      --padding-top: {{ padding_top | times: 0.7 }}px;
      --padding-bottom: {{ padding_bottom | times: 0.7 }}px;
    }
    
    .hp7-editorial__grid--asymmetrical,
    .hp7-editorial__grid--even {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
    
    .hp7-editorial__grid--asymmetrical .hp7-editorial__column:nth-child(n) {
      grid-column: 1 / -1;
    }
  }
</style>

<section class="hp7-editorial-{{ section_id }}">
  
  {%- if section.settings.title != blank -%}
    <div class="hp7-editorial__header">
      <h2 class="hp7-editorial__title">{{ section.settings.title }}</h2>
    </div>
  {%- endif -%}

  <div class="hp7-editorial__grid hp7-editorial__grid--{{ layout_style }}">
    {%- for block in section.blocks -%}
      <div class="hp7-editorial__column" {{ block.shopify_attributes }}>
        
        <div class="hp7-editorial__image-wrap">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: 
               loading: 'lazy',
               class: 'hp7-editorial__image',
               alt: block.settings.title | escape
            }}
          {%- else -%}
            {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'hp7-editorial__image placeholder-svg' }}
          {%- endif -%}
        </div>

        <div class="hp7-editorial__content">
          {%- if block.settings.title != blank -%}
            <h3 class="hp7-editorial__col-title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          
          {%- if block.settings.text != blank -%}
            <div class="hp7-editorial__col-text">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>

      </div>
    {%- endfor -%}
  </div>

</section>

{% schema %}
{
  "name": "HP7 Editorial Columns",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Aesthetic: Editorial Brutalism"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Section Title",
      "default": "THE <em>MANIFESTO</em>",
      "info": "Use <em> for italicized serif."
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Grid Layout",
      "options": [
        { "value": "asymmetrical", "label": "Asymmetrical (2 cols, offset)" },
        { "value": "even", "label": "Even Columns (2 cols)" }
      ],
      "default": "asymmetrical",
      "info": "Requires exactly 2 blocks for asymmetrical."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F4F4F0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "REDEFINING SILHOUETTES"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>An exploration of structural volumes and severe tailoring, rejecting conventional comfort for stark architectural forms.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP7 Editorial Columns",
      "blocks": [
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
