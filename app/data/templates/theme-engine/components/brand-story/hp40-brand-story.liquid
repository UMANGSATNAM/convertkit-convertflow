{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Inter', sans-serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    border-bottom: 2px solid var(--text-color);
  }

  .hp40-story-wrapper {
    display: grid;
    grid-template-columns: 2fr 1fr;
  }

  @media screen and (max-width: 992px) {
    .hp40-story-wrapper {
      grid-template-columns: 1fr;
    }
  }

  .hp40-story__headline-col {
    padding: 80px 60px;
    border-right: 2px solid var(--text-color);
    background: var(--accent-color);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (max-width: 992px) {
    .hp40-story__headline-col {
      border-right: none;
      border-bottom: 2px solid var(--text-color);
      padding: 60px 40px;
    }
  }

  .hp40-story__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    line-height: 0.9;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: -2px;
    margin: 0;
  }

  .hp40-story__text-col {
    padding: 80px 60px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  @media screen and (max-width: 992px) {
    .hp40-story__text-col {
      padding: 60px 40px;
    }
  }

  .hp40-story__text {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.5;
    font-weight: 400;
    color: var(--text-color);
    margin: 0 0 40px;
  }

  .hp40-story__btn {
    display: inline-block;
    padding: 15px 30px;
    background: var(--text-color);
    color: var(--bg-color);
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    align-self: flex-start;
  }

  .hp40-story__btn:hover {
    background: var(--accent-color);
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp40-story-wrapper" id="HP40Story-{{ section.id }}">
  <div class="hp40-story__headline-col">
    <h2 class="hp40-story__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp40-story__text-col">
    {%- if section.settings.text != blank -%}
      <div class="hp40-story__text">
        {{ section.settings.text }}
      </div>
    {%- endif -%}
    
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp40-story__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP40 - Swiss Story",
  "class": "section-hp40-brand-story",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE GRID\nIS THE\nFOUNDATION."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A rigid underlying structure allows for infinite variation above. We build systems that endure trends and focus entirely on utility and clarity of message.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "READ MANIFESTO"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Heading Size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Swiss Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Right Column Background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Lines",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Left Column Background",
      "default": "#FFDD00"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP40 - Swiss Story"
    }
  ]
}
{% endschema %}
