{%- style -%}#shopify-section-{{ section.id }}{background:#fff;padding:60px 0}.hp72-story{max-width:1100px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1.1fr .9fr;gap:32px;align-items:center}@media(max-width:800px){.hp72-story{grid-template-columns:1fr}}.hp72-story img{width:100%;height:420px;object-fit:cover;border-radius:24px 4px 24px 4px}{%- endstyle -%}<div class="hp72-story"><div>{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:800}}">{% else %}{{'collection-1'|placeholder_svg_tag}}{% endif %}</div><div><p style="color:#7C3AED;font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:700">{{section.settings.kicker|default:'Our Story v72'}}</p><h2 style="font-size:28px;font-weight:800;margin:8px 0">{{section.settings.heading|default:'Made for home-decor'}}</h2><p style="opacity:.7;line-height:1.7">{{section.settings.text|default:'Handcrafted ceramics & linens for lived-in spaces'}}</p><a href="{{section.settings.url|default:'/collections/all'}}" style="display:inline-block;margin-top:14px;padding:12px 20px;background:#7C3AED;color:#fff;border-radius:8px;text-decoration:none;font-weight:700">{{section.settings.btn|default:'Discover'}}</a></div></div>{% schema %}{"name":"HP72 Story","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"Our Story v72"},{"type":"text","id":"heading","label":"Heading","default":"Made for home-decor"},{"type":"textarea","id":"text","label":"Text","default":"Handcrafted ceramics & linens for lived-in spaces"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"btn","label":"Btn","default":"Discover"},{"type":"url","id":"url","label":"Link"}],"presets":[{"name":"HP72 Story"}]}{% endschema %}