{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp44-story-bg: {{ section.settings.bg_color | default: '#EDF4EE' }};
    --hp44-story-title: {{ section.settings.title_color | default: '#143D2B' }};
    --hp44-story-desc: {{ section.settings.desc_color | default: '#406352' }};
    --hp44-story-accent: {{ section.settings.accent_color | default: '#2D6A4F' }};
    
    background-color: var(--hp44-story-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp44-story__container {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
  }

  {% if section.settings.layout_direction == 'image_right' %}
    .hp44-story__media-col { order: 2; }
    .hp44-story__content-col { order: 1; }
  {% endif %}

  .hp44-story__media-wrap {
    position: relative;
  }

  .hp44-story__img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    border-radius: 28px;
    border: 1px solid #D8E8DC;
    box-shadow: 0 20px 50px rgba(20, 61, 43, 0.08);
    display: block;
  }

  .hp44-story__badge-float {
    position: absolute;
    bottom: -20px;
    right: -20px;
    background: #143D2B;
    color: #FFFFFF;
    padding: 16px 24px;
    border-radius: 20px;
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 700;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }

  .hp44-story__badge-float span {
    display: block;
    font-family: 'Outfit', sans-serif;
    font-size: 11px;
    font-weight: 600;
    color: #D8E8DC;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .hp44-story__subhead {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--hp44-story-accent);
    margin: 0 0 12px;
  }

  .hp44-story__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 700;
    line-height: 1.15;
    color: var(--hp44-story-title);
    margin: 0 0 20px;
  }

  .hp44-story__desc {
    font-size: 16px;
    line-height: 1.75;
    color: var(--hp44-story-desc);
    margin: 0 0 32px;
  }

  .hp44-story__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 36px;
    padding-top: 24px;
    border-top: 1px solid #D8E8DC;
  }

  .hp44-story__stat-val {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 700;
    color: var(--hp44-story-title);
    margin: 0 0 4px;
  }

  .hp44-story__stat-lbl {
    font-size: 12px;
    color: #52796F;
    margin: 0;
  }

  .hp44-story__btn {
    display: inline-flex;
    padding: 16px 36px;
    background: #143D2B;
    color: #FFFFFF;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 15px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .hp44-story__btn:hover {
    background: var(--hp44-story-accent);
    transform: translateY(-2px);
  }

  @media screen and (max-width: 992px) {
    .hp44-story__container {
      grid-template-columns: 1fr;
      gap: 50px;
      text-align: center;
    }
    .hp44-story__media-col { order: 1 !important; }
    .hp44-story__content-col { order: 2 !important; }
    .hp44-story__img { height: 340px; }
    .hp44-story__badge-float { right: 20px; bottom: -15px; }
    .hp44-story__stats { justify-content: center; }
  }

  @media screen and (max-width: 576px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 90 | times: 0.7 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 90 | times: 0.7 | round }}px;
    }
    .hp44-story__stats { grid-template-columns: 1fr; gap: 14px; }
  }
{%- endstyle -%}

<div class="hp44-story__container">
  <div class="hp44-story__media-col">
    <div class="hp44-story__media-wrap">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" class="hp44-story__img" alt="{{ section.settings.title }}" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp44-story__img' }}
      {%- endif -%}

      <div class="hp44-story__badge-float">
        {{ section.settings.badge_stat | default: '100% PURE' }}
        <span>{{ section.settings.badge_sub | default: 'Nordic Herbarium' }}</span>
      </div>
    </div>
  </div>

  <div class="hp44-story__content-col">
    {%- if section.settings.subheading != blank -%}
      <p class="hp44-story__subhead">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <h2 class="hp44-story__title">{{ section.settings.heading | default: 'Sustainably Harvested in Nordic Wilds' }}</h2>
    <p class="hp44-story__desc">
      {{ section.settings.description | default: 'Our clary sage is ethically grown in mineral-rich Nordic soil, nurtured by pristine glacial springs. Extracted at low temperatures within hours of harvest to preserve active polyphenols and bio-peptides.' }}
    </p>

    <div class="hp44-story__stats">
      <div>
        <p class="hp44-story__stat-val">{{ section.settings.stat_1_val | default: '98.6%' }}</p>
        <p class="hp44-story__stat-lbl">{{ section.settings.stat_1_lbl | default: 'Natural Origin' }}</p>
      </div>
      <div>
        <p class="hp44-story__stat-val">{{ section.settings.stat_2_val | default: '72 Hrs' }}</p>
        <p class="hp44-story__stat-lbl">{{ section.settings.stat_2_lbl | default: 'Moisture Lock' }}</p>
      </div>
      <div>
        <p class="hp44-story__stat-val">{{ section.settings.stat_3_val | default: '0%' }}</p>
        <p class="hp44-story__stat-lbl">{{ section.settings.stat_3_lbl | default: 'Synthetic Fillers' }}</p>
      </div>
    </div>

    <a href="{{ section.settings.btn_url | default: '/pages/about' }}" class="hp44-story__btn">
      {{ section.settings.btn_text | default: 'Read Our Atelier Story &rarr;' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP44 - Sage Story",
  "class": "section-hp44-story",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#EDF4EE" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#143D2B" },
    { "type": "color", "id": "desc_color", "label": "Description Color", "default": "#406352" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#2D6A4F" },
    { "type": "select", "id": "layout_direction", "label": "Image Alignment", "options": [
      { "value": "image_left", "label": "Image Left" },
      { "value": "image_right", "label": "Image Right" }
    ], "default": "image_left" },
    { "type": "image_picker", "id": "image", "label": "Story Image" },
    { "type": "text", "id": "badge_stat", "label": "Badge Stat", "default": "100% PURE" },
    { "type": "text", "id": "badge_sub", "label": "Badge Subtitle", "default": "Nordic Herbarium" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Our Botanical Heritage" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sustainably Harvested in Nordic Wilds" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Our clary sage is ethically grown in mineral-rich Nordic soil, nurtured by pristine glacial springs. Extracted at low temperatures within hours of harvest to preserve active polyphenols and bio-peptides." },
    { "type": "text", "id": "stat_1_val", "label": "Stat 1 Value", "default": "98.6%" },
    { "type": "text", "id": "stat_1_lbl", "label": "Stat 1 Label", "default": "Natural Origin" },
    { "type": "text", "id": "stat_2_val", "label": "Stat 2 Value", "default": "72 Hrs" },
    { "type": "stat", "type": "text", "id": "stat_2_lbl", "label": "Stat 2 Label", "default": "Moisture Lock" },
    { "type": "text", "id": "stat_3_val", "label": "Stat 3 Value", "default": "0%" },
    { "type": "text", "id": "stat_3_lbl", "label": "Stat 3 Label", "default": "Synthetic Fillers" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Read Our Atelier Story →" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "presets": [
    { "name": "HP44 - Sage Story" }
  ]
}
{% endschema %}
