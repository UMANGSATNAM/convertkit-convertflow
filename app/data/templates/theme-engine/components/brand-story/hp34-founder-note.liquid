{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --grid-color: rgba(255, 255, 255, 0.1);
    
    --font-body: 'JetBrains Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--grid-color);
  }

  .hp34-founder-wrapper {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp34-founder-wrapper {
      padding: 0 20px;
    }
  }

  .hp34-founder__terminal {
    background: #050505;
    border: 1px solid var(--accent-color);
    padding: 40px;
    position: relative;
    font-family: var(--font-body);
  }

  .hp34-founder__terminal::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 20px;
    background: var(--accent-color);
    opacity: 0.1;
  }

  .hp34-founder__header {
    font-size: 11px;
    color: var(--accent-color);
    margin-bottom: 30px;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px dashed var(--accent-color);
    padding-bottom: 10px;
  }

  .hp34-founder__text {
    font-size: 14px;
    line-height: 1.8;
    color: var(--text-color);
    margin-bottom: 30px;
  }

  .hp34-founder__signature {
    font-size: 14px;
    color: var(--accent-color);
    font-weight: 700;
  }
  
  .hp34-founder__cursor {
    display: inline-block;
    width: 8px;
    height: 15px;
    background: var(--accent-color);
    animation: blink 1s infinite;
    vertical-align: middle;
    margin-left: 5px;
  }

  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp34-founder-wrapper" id="HP34Founder-{{ section.id }}">
  <div class="hp34-founder__terminal">
    <div class="hp34-founder__header">
      <span>TRANSMISSION_INCOMING</span>
      <span>SECURE_CHANNEL</span>
    </div>
    
    <div class="hp34-founder__text">
      {{ section.settings.text }}
    </div>
    
    <div class="hp34-founder__signature">
      > END_TRANSMISSION: {{ section.settings.signature }}<span class="hp34-founder__cursor"></span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP34 - Tech Founder Note",
  "class": "section-hp34-founder-note",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Our directive is simple: Build systems, not just garments. The modern environment requires tools that perform under pressure, adapt to changing variables, and look precise. Welcome to the new standard."
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature/Name",
      "default": "SYSTEM_ARCHITECT"
    },
    {
      "type": "header",
      "content": "Tech Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF4500"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP34 - Tech Founder Note"
    }
  ]
}
{% endschema %}
