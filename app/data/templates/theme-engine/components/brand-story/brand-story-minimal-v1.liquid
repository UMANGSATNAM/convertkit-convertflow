{%- comment -%}
  Component: brand-story-minimal-beauty-v1
  Family: Beauty | Style: minimal
  Archetypes: premium, organic
  v2.0 — StoreForge Component Library
{%- endcomment -%}
<section class="image-with-text image-with-text--beauty" style="padding: var(--space-64) 0; background-color: var(--color-background); border-bottom: 1px solid var(--color-border);">
  <div class="container" style="display: flex; flex-direction: column; gap: var(--space-48); align-items: center;" class="md-flex-row">
    
    {%- liquid
      assign is_reversed = false
      if section.settings.layout == 'text_first'
        assign is_reversed = true
      endif
    -%}

    <div style="display: flex; flex-direction: column; gap: var(--space-48); align-items: center; width: 100%;" class="md-flex-row {% if is_reversed %}flex-row-reverse{% endif %}">
      
      <!-- Image Col -->
      <div class="image-with-text-media" style="flex: 1; width: 100%;">
        {%- if section.settings.image != blank -%}
          <div style="border: 1px solid var(--color-border); border-radius: var(--card-radius); overflow: hidden; box-shadow: var(--card-shadow); line-height: 0;">
            <img src="{{ section.settings.image | image_url: width: 1000 }}" 
                 alt="{{ section.settings.image.alt | escape }}" 
                 loading="lazy"
                 style="width: 100%; height: auto; object-fit: cover;">
          </div>
        {%- else -%}
          <div style="width: 100%; aspect-ratio: 1; background-color: var(--color-surface); display: flex; align-items: center; justify-content: center; border: 1px solid var(--color-border); border-radius: var(--card-radius); box-shadow: var(--card-shadow);">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <!-- Text Col -->
      <div class="image-with-text-content" style="flex: 1; width: 100%; text-align: left; padding: var(--space-16);">
        <span style="color: var(--color-text-muted); font-size: var(--font-eyebrow); font-weight: 600; letter-spacing: var(--tracking-wide); text-transform: uppercase; display: inline-block; margin-bottom: var(--space-12);">
          OUR PROMISE
        </span>
        <h3 class="image-with-text-heading" style="font-family: var(--font-heading-family); font-size: 2.2rem; font-weight: 600; line-height: 1.25; margin: 0 0 var(--space-16) 0; color: var(--color-text);">
          {{ section.settings.heading | escape }}
        </h3>
        
        <div class="image-with-text-text rte" style="font-family: var(--font-body-family); font-size: 0.95rem; line-height: 1.7; color: #5a5450; margin-bottom: var(--space-32);">
          {{ section.settings.text }}
        </div>

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="button button--primary" style="border-radius: var(--button-radius);">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Image with Text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image_first", "label": "Image first" },
        { "value": "text_first", "label": "Text first" }
      ],
      "default": "image_first"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean & Honest Formulas"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We formulate using only non-toxic, bio-compatible ingredients. Our personal care range is specialistly tested, vegan, and packed with active premiums designed to restore your glow naturally.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Read Our Ingredients"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ]
}
{% endschema %}
