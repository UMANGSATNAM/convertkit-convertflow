{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --btn-bg: {{ section.settings.btn_bg }};
    --btn-text: {{ section.settings.btn_text_color }};
    --font-heading: 'Lora', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Organic grain texture overlay */
  {% if section.settings.show_grain %}
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0.04;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
  {% endif %}

  .hp22-brand-story-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 768px) {
    .hp22-brand-story-wrapper {
      padding: 0 20px;
    }
  }

  .hp22-brand-story__container {
    display: flex;
    align-items: center;
    gap: {{ section.settings.gap }}px;
    flex-direction: {% if section.settings.layout == 'image_right' %}row{% else %}row-reverse{% endif %};
  }

  @media screen and (max-width: 992px) {
    .hp22-brand-story__container {
      flex-direction: column;
      text-align: center;
      gap: 60px;
    }
  }

  /* Image Column with overlapping organic shapes */
  .hp22-brand-story__image-col {
    flex: 1;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 500px;
  }

  @media screen and (max-width: 992px) {
    .hp22-brand-story__image-col {
      width: 100%;
      min-height: 400px;
    }
  }

  .hp22-brand-story__image-main {
    position: relative;
    width: 80%;
    max-width: 500px;
    aspect-ratio: {{ section.settings.main_image_ratio }};
    border-radius: 300px 300px 0 0; /* Arch */
    overflow: hidden;
    z-index: 2;
    box-shadow: 0 20px 40px rgba(0,0,0,0.06);
  }

  .hp22-brand-story__image-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 3s ease;
  }

  .hp22-brand-story__image-main:hover img {
    transform: scale(1.05);
  }

  .hp22-brand-story__image-second {
    position: absolute;
    bottom: -30px;
    {% if section.settings.layout == 'image_right' %}left: 0;{% else %}right: 0;{% endif %}
    width: 45%;
    max-width: 280px;
    aspect-ratio: 1/1;
    border-radius: 50%;
    overflow: hidden;
    z-index: 3;
    box-shadow: 0 15px 30px rgba(0,0,0,0.08);
    border: 8px solid var(--bg-color);
  }

  .hp22-brand-story__image-second img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 2s ease;
  }

  .hp22-brand-story__image-second:hover img {
    transform: scale(1.1);
  }

  /* Decorative Leaf SVG */
  .hp22-brand-story__deco-leaf {
    position: absolute;
    top: -20px;
    {% if section.settings.layout == 'image_right' %}right: 20px;{% else %}left: 20px;{% endif %}
    width: 80px;
    height: 80px;
    color: var(--accent-color);
    opacity: 0.4;
    z-index: 1;
    animation: hp22Float 6s ease-in-out infinite;
  }

  @keyframes hp22Float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-15px) rotate(5deg); }
  }

  /* Text Column */
  .hp22-brand-story__text-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (max-width: 992px) {
    .hp22-brand-story__text-col {
      align-items: center;
    }
  }

  .hp22-brand-story__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--accent-color);
    text-transform: uppercase;
    margin: 0 0 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  @media screen and (max-width: 992px) {
    .hp22-brand-story__subtitle {
      justify-content: center;
    }
  }

  .hp22-brand-story__subtitle::after {
    content: '';
    display: inline-block;
    width: 40px;
    height: 1px;
    background-color: var(--accent-color);
  }

  .hp22-brand-story__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    line-height: 1.15;
    color: var(--text-color);
    margin: 0 0 32px;
  }
  
  .hp22-brand-story__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp22-brand-story__text {
    font-family: var(--font-body);
    font-size: {{ section.settings.text_size }}px;
    font-weight: 300;
    line-height: 1.8;
    color: var(--text-color);
    opacity: 0.85;
    margin: 0 0 40px;
    max-width: 90%;
  }

  @media screen and (max-width: 992px) {
    .hp22-brand-story__text {
      max-width: 100%;
    }
  }

  .hp22-brand-story__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background: var(--btn-bg);
    color: var(--btn-text);
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 15px;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: 40px; /* Pill */
    transition: all 0.3s ease;
    align-self: flex-start;
  }

  @media screen and (max-width: 992px) {
    .hp22-brand-story__btn {
      align-self: center;
    }
  }

  .hp22-brand-story__btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp22-brand-story-wrapper" id="HP22BrandStory-{{ section.id }}">
  <div class="hp22-brand-story__container">
    
    <div class="hp22-brand-story__image-col">
      <svg class="hp22-brand-story__deco-leaf" viewBox="0 0 24 24" fill="currentColor"><path d="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 7,14 7,14C18,14 17,8 17,8Z"/></svg>
      
      <div class="hp22-brand-story__image-main">
        {%- if section.settings.image_1 != blank -%}
          <img src="{{ section.settings.image_1 | image_url: width: 800 }}" alt="Brand Story Main" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;background:#EAE3D9;display:flex;align-items:center;justify-content:center;color:#8A9A86;">IMAGE 1</div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_second_image -%}
      <div class="hp22-brand-story__image-second">
        {%- if section.settings.image_2 != blank -%}
          <img src="{{ section.settings.image_2 | image_url: width: 400 }}" alt="Brand Story Detail" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;background:#DCD2C6;display:flex;align-items:center;justify-content:center;color:#8A9A86;">IMAGE 2</div>
        {%- endif -%}
      </div>
      {%- endif -%}
    </div>

    <div class="hp22-brand-story__text-col">
      {%- if section.settings.subtitle != blank -%}
        <div class="hp22-brand-story__subtitle">{{ section.settings.subtitle | escape }}</div>
      {%- endif -%}
      
      {%- if section.settings.title != blank -%}
        <h2 class="hp22-brand-story__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      
      {%- if section.settings.text != blank -%}
        <div class="hp22-brand-story__text">{{ section.settings.text }}</div>
      {%- endif -%}
      
      {%- if section.settings.btn_text != blank -%}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="hp22-brand-story__btn">
          {{ section.settings.btn_text | escape }}
        </a>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP22 - Organic Story",
  "class": "section-hp22-brand-story",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Position (Desktop)",
      "options": [
        { "value": "image_left", "label": "Image Left" },
        { "value": "image_right", "label": "Image Right" }
      ],
      "default": "image_left"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "gap",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Gap between columns",
      "default": 80
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Main Image (Arch Shape)"
    },
    {
      "type": "select",
      "id": "main_image_ratio",
      "label": "Main Image Aspect Ratio",
      "options": [
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Tall (4:5)" },
        { "value": "1/1", "label": "Square (1:1)" }
      ],
      "default": "3/4"
    },
    {
      "type": "checkbox",
      "id": "show_second_image",
      "label": "Show overlapping circular image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Secondary Image (Circle)"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>A return to <em>simplicity</em> and natural rhythms.</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body Text",
      "default": "<p>We believe in the healing power of the earth. Our journey began with a simple desire to create skincare that honors the body and respects the planet, using only the purest botanical ingredients.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "DISCOVER OUR STORY"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 17
    },
    {
      "type": "header",
      "content": "Organic Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3A3A3A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8A9A86"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#C87965"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Show subtle paper grain texture",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP22 - Organic Story"
    }
  ]
}
{% endschema %}
