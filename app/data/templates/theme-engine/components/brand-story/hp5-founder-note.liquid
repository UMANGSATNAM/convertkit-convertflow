{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#1a2a3a'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp5-fn-bg: {{ bg_color }};
    --hp5-fn-text: {{ text_color }};
    
    --hp5-fn-pt-desk: {{ padding_top_desktop }}px;
    --hp5-fn-pb-desk: {{ padding_bottom_desktop }}px;
    --hp5-fn-pt-mob: {{ padding_top_mobile }}px;
    --hp5-fn-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp5-health-fn-{{ section.id }} {
    padding-top: var(--hp5-fn-pt-desk);
    padding-bottom: var(--hp5-fn-pb-desk);
    background-color: var(--hp5-fn-bg);
    color: var(--hp5-fn-text);
    font-family: 'Inter', sans-serif;
  }

  .hp5-fn-inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 60px;
  }
  .hp5-fn-inner.layout-right {
    flex-direction: row-reverse;
  }

  .hp5-fn-media {
    flex: 0 0 350px;
  }
  .hp5-fn-img-wrap {
    width: 100%;
    aspect-ratio: 3/4;
    border-radius: 16px;
    overflow: hidden;
    background: #e6eff6;
  }
  .hp5-fn-img {
    width: 100%; height: 100%; object-fit: cover;
  }

  .hp5-fn-content {
    flex: 1;
  }
  .hp5-fn-quote-icon {
    width: 40px; height: 40px;
    color: #0066cc;
    margin-bottom: 20px;
  }
  .hp5-fn-quote-icon svg { width: 100%; height: 100%; fill: currentColor; }

  .hp5-fn-quote {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 30px 0;
    letter-spacing: -0.5px;
  }

  .hp5-fn-signature {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .hp5-fn-name {
    font-size: 16px; font-weight: 700; margin: 0;
  }
  .hp5-fn-title {
    font-size: 14px; color: rgba(26,42,58,0.6); margin: 0;
  }

  @media screen and (max-width: 768px) {
    .hp5-health-fn-{{ section.id }} {
      padding-top: var(--hp5-fn-pt-mob);
      padding-bottom: var(--hp5-fn-pb-mob);
    }
    .hp5-fn-inner, .hp5-fn-inner.layout-right {
      flex-direction: column;
      text-align: center;
      gap: 40px;
    }
    .hp5-fn-media {
      flex: 0 0 auto;
      max-width: 300px;
      margin: 0 auto;
    }
    .hp5-fn-quote-icon { margin: 0 auto 20px auto; }
  }
</style>

<section class="hp5-health-fn-{{ section.id }}" aria-label="Founder Note">
  <div class="hp5-fn-inner layout-{{ section.settings.layout }}">
    
    <div class="hp5-fn-media">
      <div class="hp5-fn-img-wrap">
        {%- if section.settings.image != blank -%}
          <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 600 }}" class="hp5-fn-img" loading="lazy" alt="{{ section.settings.name }}">
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'hp5-fn-img placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    <div class="hp5-fn-content">
      <div class="hp5-fn-quote-icon">
        <svg viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.714 4.026-9.609 9.983-9.609v3.391c-3.111 0-5.014 1.487-5.014 4.298h5.014v9.311h-9.983zm-14.017 0v-7.391c0-5.714 4.026-9.609 9.983-9.609v3.391c-3.111 0-5.014 1.487-5.014 4.298h5.014v9.311h-9.983z"/></svg>
      </div>
      
      <h2 class="hp5-fn-quote">"{{ section.settings.quote | default: "We don't believe in miracle pills. We believe in clinically-backed science that supports your body's natural systems." }}"</h2>
      
      <div class="hp5-fn-signature">
        <p class="hp5-fn-name">{{ section.settings.name | default: 'Dr. Emily Chen, MD' }}</p>
        <p class="hp5-fn-title">{{ section.settings.title | default: 'Chief Medical Officer' }}</p>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP5 Health Founder Note",
  "tag": "section",
  "class": "section-hp5-founder",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "We don't believe in miracle pills. We believe in clinically-backed science that supports your body's natural systems."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Dr. Emily Chen, MD"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Chief Medical Officer"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a2a3a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP5 Health Founder Note",
      "category": "About"
    }
  ]
}
{% endschema %}
