{% comment %} Story Brand Editorial — Centered editorial manifesto and mission statement with clean typography {% endcomment %}

<section class="sf-story sf-story-{{ section.id }}" id="sf-story-{{ section.id }}">
  <div class="sf-story-content">
    {% if section.settings.heading != blank %}
      <h2 class="sf-story-heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="sf-story-text rte">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}" class="sf-btn">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

<style>
  .sf-story-{{ section.id }} {
    padding: var(--space-64, 5rem) var(--space-20, 1rem);
    background-color: var(--color-background);
    color: var(--color-text);
    text-align: center;
  }
  .sf-story-content {
    max-width: 760px;
    margin: 0 auto;
  }
  .sf-story-heading {
    font-family: var(--font-heading-family, serif);
    font-size: var(--font-h2, clamp(2rem, 4vw, 3rem));
    line-height: var(--leading-tight, 1.2);
    color: var(--color-text);
    margin-bottom: var(--space-24, 1.5rem);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .sf-story-text {
    font-family: var(--font-body-family, sans-serif);
    font-size: var(--font-body, 1.1rem);
    line-height: var(--leading-body, 1.8);
    color: var(--color-text-secondary, var(--color-text));
    margin-bottom: var(--space-32, 2rem);
  }
  .sf-story-text p {
    margin-bottom: var(--space-16, 1rem);
  }
  .sf-story-text p:last-child {
    margin-bottom: 0;
  }
  .sf-btn {
    display: inline-block;
    padding: var(--space-12, 12px) var(--space-24, 28px);
    border-radius: var(--button-radius, 4px);
    background-color: var(--color-accent);
    color: var(--color-background);
    text-decoration: none;
    font-family: var(--font-body-family, sans-serif);
    font-weight: 600;
    font-size: var(--font-small, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: opacity 0.3s ease;
  }
  .sf-btn:hover {
    opacity: 0.9;
  }
</style>

{% schema %}
{
  "name": "Editorial Manifesto",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Heritage & Craft"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe true elegance lies in exceptional artistry, enduring materials, and timeless design. By focusing on uncompromising quality and ethical sourcing, each piece is thoughtfully created to be cherished for generations.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Discover Our Philosophy"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Editorial Manifesto",
      "category": "Brand Story"
    }
  ]
}
{% endschema %}
