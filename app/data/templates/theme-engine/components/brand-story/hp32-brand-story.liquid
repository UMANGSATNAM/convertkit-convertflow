{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Syne:wght@700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Syne', sans-serif;
    --font-body: 'Space Mono', monospace;
    
    background-color: var(--bg-color);
    border-bottom: 4px solid var(--border-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  /* Decorative repeating text background */
  .hp32-story__bg-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-heading);
    font-size: 200px;
    color: rgba(0,0,0,0.03);
    white-space: nowrap;
    z-index: 1;
    pointer-events: none;
    line-height: 0.8;
    text-align: center;
  }

  .hp32-story-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 60px;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 992px) {
    .hp32-story-wrapper {
      flex-direction: column;
      gap: 40px;
      padding: 0 20px;
    }
  }

  .hp32-story__image-col {
    flex: 1;
    max-width: 500px;
  }

  @media screen and (max-width: 992px) {
    .hp32-story__image-col {
      width: 100%;
      margin: 0 auto;
    }
  }

  .hp32-story__image-wrap {
    border: 4px solid var(--border-color);
    box-shadow: 12px 12px 0 var(--border-color);
    background: #fff;
    aspect-ratio: 4/5;
    position: relative;
  }

  .hp32-story__image-wrap::before {
    content: 'FIG.01';
    position: absolute;
    top: -4px; left: -4px;
    background: var(--border-color);
    color: var(--accent-color);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    padding: 6px 12px;
    z-index: 3;
  }

  .hp32-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(100%) hue-rotate(180deg) saturate(200%) contrast(150%);
    /* This creates a stark duotone effect */
  }

  .hp32-story__content-col {
    flex: 1.2;
    background: #fff;
    border: 4px solid var(--border-color);
    padding: 40px;
    box-shadow: 8px 8px 0 var(--border-color);
  }

  @media screen and (max-width: 768px) {
    .hp32-story__content-col {
      padding: 20px;
    }
  }

  .hp32-story__tagline {
    font-family: var(--font-body);
    font-size: 14px;
    color: #000;
    font-weight: 700;
    text-transform: uppercase;
    display: block;
    margin-bottom: 20px;
    border-bottom: 2px dashed #000;
    padding-bottom: 10px;
  }

  .hp32-story__tagline::before {
    content: '>> CLASSIFIED // ';
    color: var(--accent-color);
    background: #000;
    padding: 2px 6px;
    margin-right: 8px;
  }

  .hp32-story__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: #000;
    text-transform: uppercase;
    margin: 0 0 24px;
    letter-spacing: -1px;
  }

  .hp32-story__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: #000;
    margin: 0 0 30px;
  }
  
  .hp32-story__text p {
    margin-bottom: 16px;
  }

  .hp32-story__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 30px;
    padding-top: 20px;
    border-top: 4px solid var(--border-color);
  }

  .hp32-story__stat-item {
    display: flex;
    flex-direction: column;
  }

  .hp32-story__stat-num {
    font-family: var(--font-heading);
    font-size: 32px;
    color: var(--border-color);
    line-height: 1;
    margin-bottom: 5px;
  }

  .hp32-story__stat-label {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    color: #000;
    opacity: 0.7;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp32-story__bg-text" aria-hidden="true">
  {{ section.settings.bg_text }}<br>{{ section.settings.bg_text }}<br>{{ section.settings.bg_text }}
</div>

<div class="hp32-story-wrapper" id="HP32Story-{{ section.id }}">
  <div class="hp32-story__image-col">
    <div class="hp32-story__image-wrap">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp32-story__image" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp32-story__image' }}
      {%- endif -%}
    </div>
  </div>

  <div class="hp32-story__content-col">
    {%- if section.settings.tagline != blank -%}
      <span class="hp32-story__tagline">{{ section.settings.tagline }}</span>
    {%- endif -%}
    
    <h2 class="hp32-story__title">{{ section.settings.title }}</h2>
    
    <div class="hp32-story__text">
      {{ section.settings.text }}
    </div>

    <div class="hp32-story__stats">
      {%- for block in section.blocks -%}
        <div class="hp32-story__stat-item" {{ block.shopify_attributes }}>
          <span class="hp32-story__stat-num">{{ block.settings.stat_value }}</span>
          <span class="hp32-story__stat-label">{{ block.settings.stat_label }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP32 - Brutalist Story",
  "class": "section-hp32-brand-story",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (will be duotoned)"
    },
    {
      "type": "text",
      "id": "bg_text",
      "label": "Background Watermark Text",
      "default": "SYSTEM.DATA"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "ARCHIVE_LOG"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "FORGED IN THE GRID."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>WE REJECT THE ORDINARY. DESIGNED FOR MAXIMUM IMPACT AND UNCOMPROMISING DURABILITY. EVERY COMPONENT IS ENGINEERED TO SURVIVE THE HARSHEST ENVIRONMENTS.</p><p>THIS IS NOT FAST FASHION. THIS IS INDUSTRIAL GRADE.</p>"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Light Grey)",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (e.g. Lime)",
      "default": "#ccff00"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Item",
      "settings": [
        {
          "type": "text",
          "id": "stat_value",
          "label": "Stat Value",
          "default": "10K+"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Stat Label",
          "default": "UNITS DEPLOYED"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP32 - Brutalist Story",
      "blocks": [
        { "type": "stat", "settings": { "stat_value": "V.04", "stat_label": "CURRENT ITERATION" } },
        { "type": "stat", "settings": { "stat_value": "99.9%", "stat_label": "DURABILITY SCORE" } }
      ]
    }
  ]
}
{% endschema %}
