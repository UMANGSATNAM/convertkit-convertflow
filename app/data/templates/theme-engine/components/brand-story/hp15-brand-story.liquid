{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 150px 40px;
    color: {{ text_color }};
    text-align: center;
  }
  
  .hp15-story-container-{{ section_id }} {
    max-width: 900px;
    margin: 0 auto;
  }
  
  .hp15-story-subtitle-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    margin-bottom: 30px;
    opacity: 0.8;
  }
  
  .hp15-story-title-{{ section_id }} {
    font-family: 'Didot', 'Playfair Display', serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 40px 0;
    line-height: 1.1;
  }
  
  .hp15-story-text-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1.1rem;
    line-height: 2;
    margin: 0 0 50px 0;
    opacity: 0.9;
  }
  
  .hp15-story-btn-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #000;
    background: #fff;
    text-decoration: none;
    padding: 18px 40px;
    display: inline-block;
    transition: opacity 0.3s ease;
  }
  
  .hp15-story-btn-{{ section_id }}:hover {
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 80px 20px;
    }
  }
</style>

<div class="hp15-story-container-{{ section_id }}">
  <div class="hp15-story-subtitle-{{ section_id }}">{{ section.settings.subtitle | default: 'THE MANIFESTO' }}</div>
  <h2 class="hp15-story-title-{{ section_id }}">{{ section.settings.title | default: 'BEYOND TRENDS' }}</h2>
  <div class="hp15-story-text-{{ section_id }}">{{ section.settings.text | default: '<p>Founded on the principles of uncompromising quality and radical minimalism. We strip away the non-essential to reveal the pure architectural form of clothing. This is not fashion; this is armor for the modern era.</p>' }}</div>
  <a href="{{ section.settings.btn_link | default: '#' }}" class="hp15-story-btn-{{ section_id }}">{{ section.settings.btn_text | default: 'READ THE MANIFESTO' }}</a>
</div>

{% schema %}
{
  "name": "HP15 Brand Story",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE MANIFESTO"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "BEYOND TRENDS"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Founded on the principles of uncompromising quality and radical minimalism. We strip away the non-essential to reveal the pure architectural form of clothing. This is not fashion; this is armor for the modern era.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "READ THE MANIFESTO"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP15 Brand Story"
    }
  ]
}
{% endschema %}
