{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#2A3B2C'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
  }
  
  .hp10-rt-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  
  .hp10-rt-subheading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 20px 0;
    color: rgba(42, 59, 44, 0.6);
  }
  
  .hp10-rt-heading-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    margin: 0 0 30px 0;
    line-height: 1.2;
  }
  
  .hp10-rt-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    line-height: 1.8;
    color: rgba(42, 59, 44, 0.8);
    margin: 0;
  }
  
  .hp10-rt-btn-{{ section_id }} {
    display: inline-block;
    margin-top: 40px;
    padding: 14px 40px;
    background: transparent;
    color: {{ text_color }};
    border: 1px solid {{ text_color }};
    border-radius: 40px;
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  
  .hp10-rt-btn-{{ section_id }}:hover {
    background: {{ text_color }};
    color: {{ bg_color }};
  }
</style>

<div class="hp10-rt-container-{{ section_id }}">
  <div class="hp10-rt-subheading-{{ section_id }}">{{ section.settings.subheading | default: 'Our Philosophy' }}</div>
  <h2 class="hp10-rt-heading-{{ section_id }}">{{ section.settings.heading | default: 'Less is more when it comes to your skin.' }}</h2>
  <div class="hp10-rt-text-{{ section_id }}">
    {{ section.settings.text | default: '<p>We believe in minimal ingredients with maximum impact. By removing the unnecessary fillers, synthetics, and harsh chemicals, we let the true power of nature shine through.</p>' }}
  </div>
  {% if section.settings.button_label != blank %}
    <a href="{{ section.settings.button_link | default: '#' }}" class="hp10-rt-btn-{{ section_id }}">{{ section.settings.button_label }}</a>
  {% endif %}
</div>

{% schema %}
{
  "name": "HP10 Rich Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our Philosophy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Less is more when it comes to your skin."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe in minimal ingredients with maximum impact.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP10 Rich Text"
    }
  ]
}
{% endschema %}
