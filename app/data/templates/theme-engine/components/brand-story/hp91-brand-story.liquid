{%- style -%}#shopify-section-{{ section.id }}{background:#F0FDFA;padding:60px 0}.hp91-story{max-width:1100px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:center}@media(max-width:800px){.hp91-story{grid-template-columns:1fr}}.hp91-story img{width:100%;height:420px;object-fit:cover;border-radius:16px}{%- endstyle -%}<div class="hp91-story"><div>{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:800}}">{% else %}{{'collection-1'|placeholder_svg_tag}}{% endif %}</div><div><p style="color:#0D9488;font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:700">{{section.settings.kicker|default:'Our Story v91'}}</p><h2 style="font-size:28px;font-weight:800;margin:8px 0">{{section.settings.heading|default:'Made for grooming'}}</h2><p style="opacity:.7;line-height:1.7">{{section.settings.text|default:'Barber-grade care for modern men'}}</p><a href="{{section.settings.url|default:'/collections/all'}}" style="display:inline-block;margin-top:14px;padding:12px 20px;background:#0D9488;color:#fff;border-radius:8px;text-decoration:none;font-weight:700">{{section.settings.btn|default:'Discover'}}</a></div></div>{% schema %}{"name":"HP91 Story","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"Our Story v91"},{"type":"text","id":"heading","label":"Heading","default":"Made for grooming"},{"type":"textarea","id":"text","label":"Text","default":"Barber-grade care for modern men"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"btn","label":"Btn","default":"Discover"},{"type":"url","id":"url","label":"Link"}],"presets":[{"name":"HP91 Story"}]}{% endschema %}