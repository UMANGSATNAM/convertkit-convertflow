{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign title = section.settings.title
  assign text = section.settings.text
  assign btn_text = section.settings.btn_text
  assign btn_link = section.settings.btn_link
  assign image = section.settings.image
-%}

<style>
  .hp19-imgtext-{{ sec_id }} {
    background-color: {{ bg_color }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }

  .hp19-imgtext-{{ sec_id }}__container {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 80px;
  }

  .hp19-imgtext-{{ sec_id }}__image-col {
    flex: 1;
    position: relative;
  }

  .hp19-imgtext-{{ sec_id }}__image-wrapper {
    width: 100%;
    aspect-ratio: 4/5;
    overflow: hidden;
  }

  .hp19-imgtext-{{ sec_id }}__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.5s ease;
  }

  .hp19-imgtext-{{ sec_id }}__image-wrapper:hover .hp19-imgtext-{{ sec_id }}__image {
    transform: scale(1.05);
  }

  .hp19-imgtext-{{ sec_id }}__text-col {
    flex: 1;
    max-width: 500px;
  }

  .hp19-imgtext-{{ sec_id }}__title {
    font-family: 'Times New Roman', Times, serif;
    font-size: clamp(36px, 5vw, 64px);
    color: {{ text_color }};
    font-weight: normal;
    margin: 0 0 30px 0;
    line-height: 1.1;
  }

  .hp19-imgtext-{{ sec_id }}__text {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 14px;
    line-height: 1.8;
    color: {{ text_color }};
    opacity: 0.7;
    margin: 0 0 40px 0;
    letter-spacing: 0.5px;
  }

  .hp19-imgtext-{{ sec_id }}__link {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 11px;
    letter-spacing: 2px;
    color: {{ text_color }};
    text-transform: uppercase;
    text-decoration: none;
    padding-bottom: 5px;
    position: relative;
    display: inline-block;
  }

  .hp19-imgtext-{{ sec_id }}__link::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 100%;
    height: 1px;
    background-color: {{ text_color }};
    transform-origin: right;
    transform: scaleX(0);
    transition: transform 0.4s ease;
  }

  .hp19-imgtext-{{ sec_id }}__text-col:hover .hp19-imgtext-{{ sec_id }}__link::after {
    transform-origin: left;
    transform: scaleX(1);
  }

  @media screen and (max-width: 992px) {
    .hp19-imgtext-{{ sec_id }}__container { flex-direction: column; gap: 50px; }
    .hp19-imgtext-{{ sec_id }}__text-col { max-width: 100%; text-align: center; }
    .hp19-imgtext-{{ sec_id }}__title { font-size: 40px; }
  }

  @media screen and (max-width: 600px) {
    .hp19-imgtext-{{ sec_id }}__container { padding: 0 20px; }
  }
</style>

<section class="hp19-imgtext-{{ sec_id }}">
  <div class="hp19-imgtext-{{ sec_id }}__container">
    
    <div class="hp19-imgtext-{{ sec_id }}__image-col">
      <div class="hp19-imgtext-{{ sec_id }}__image-wrapper">
        {% if image != blank %}
          <img src="{{ image | image_url: width: 2048 }}" alt="{{ title }}" class="hp19-imgtext-{{ sec_id }}__image" loading="lazy">
        {% else %}
          {% capture tmp_class %}hp19-imgtext-{{ sec_id }}__image{% endcapture %}{{ 'lifestyle-1'  | placeholder_svg_tag: tmp_class }}
        {% endif %}
      </div>
    </div>
    
    <div class="hp19-imgtext-{{ sec_id }}__text-col">
      <h2 class="hp19-imgtext-{{ sec_id }}__title">{{ title }}</h2>
      <div class="hp19-imgtext-{{ sec_id }}__text">
        {{ text | newline_to_br }}
      </div>
      {% if btn_text != blank and btn_link != blank %}
        <a href="{{ btn_link }}" class="hp19-imgtext-{{ sec_id }}__link">{{ btn_text }}</a>
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP19 Luxury Image Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 100
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Heritage Collection"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Imbued with a sense of history and meticulous craftsmanship. Discover the pieces that define the modern wardrobe, balancing timeless elegance with contemporary subtlety."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Discover the Collection"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP19 Luxury Image Text"
    }
  ]
}
{% endschema %}
