{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    overflow: hidden;
  }
  
  .hp8-story-container-{{ section_id }} {
    display: flex;
    min-height: 800px;
    align-items: stretch;
  }
  
  .hp8-story-image-col-{{ section_id }} {
    flex: 1;
    position: relative;
    overflow: hidden;
  }
  
  .hp8-story-image-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .hp8-story-text-col-{{ section_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 10% 8%;
  }
  
  .hp8-story-subtitle-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 4px;
    text-transform: uppercase;
    margin: 0 0 30px 0;
    color: {{ text_color | color_modify: 'alpha', 0.6 }};
  }
  
  .hp8-story-title-{{ section_id }} {
    font-family: 'Bodoni MT', 'Didot', 'Playfair Display', serif;
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 40px 0;
  }
  
  .hp8-story-text-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1.1rem;
    line-height: 1.8;
    font-weight: 300;
    margin: 0 0 50px 0;
    max-width: 600px;
    opacity: 0.8;
  }
  
  .hp8-story-btn-{{ section_id }} {
    display: inline-block;
    padding: 15px 40px;
    border: 1px solid {{ text_color }};
    color: {{ text_color }};
    text-decoration: none;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: all 0.4s ease;
    align-self: flex-start;
  }
  
  .hp8-story-btn-{{ section_id }}:hover {
    background-color: {{ text_color }};
    color: {{ bg_color }};
  }

  @media (max-width: 992px) {
    .hp8-story-container-{{ section_id }} {
      flex-direction: column;
      min-height: auto;
    }
    .hp8-story-image-col-{{ section_id }} {
      height: 50vh;
      min-height: 400px;
    }
    .hp8-story-text-col-{{ section_id }} {
      padding: 80px 20px;
    }
  }
</style>

<div class="hp8-story-container-{{ section_id }}">
  {% if section.settings.image_position == 'left' %}
    <div class="hp8-story-image-col-{{ section_id }}">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="Brand Story" class="hp8-story-image-{{ section_id }}" loading="lazy" width="800" height="1000">
      {% else %}
        <div style="width:100%; height:100%; background:#222;" class="hp8-story-image-{{ section_id }}"></div>
      {% endif %}
    </div>
  {% endif %}
  
  <div class="hp8-story-text-col-{{ section_id }}">
    <p class="hp8-story-subtitle-{{ section_id }}">{{ section.settings.subtitle | default: 'THE MAISON' }}</p>
    <h2 class="hp8-story-title-{{ section_id }}">{{ section.settings.title | default: 'A Legacy of<br>Craftsmanship' }}</h2>
    <div class="hp8-story-text-{{ section_id }}">
      {{ section.settings.text | default: '<p>Founded on the principles of uncompromising quality and avant-garde design, our maison continues to redefine modern luxury. Every piece is a testament to the artisans who dedicate their lives to the pursuit of perfection.</p>' }}
    </div>
    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hp8-story-btn-{{ section_id }}">{{ section.settings.button_text }}</a>
    {% endif %}
  </div>

  {% if section.settings.image_position == 'right' %}
    <div class="hp8-story-image-col-{{ section_id }}">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="Brand Story" class="hp8-story-image-{{ section_id }}" loading="lazy" width="800" height="1000">
      {% else %}
        <div style="width:100%; height:100%; background:#222;" class="hp8-story-image-{{ section_id }}"></div>
      {% endif %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "HP8 Brand Story",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE MAISON"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "A Legacy of Craftsmanship"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Founded on the principles of uncompromising quality and avant-garde design, our maison continues to redefine modern luxury. Every piece is a testament to the artisans who dedicate their lives to the pursuit of perfection.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "DISCOVER OUR HERITAGE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP8 Brand Story"
    }
  ]
}
{% endschema %}
