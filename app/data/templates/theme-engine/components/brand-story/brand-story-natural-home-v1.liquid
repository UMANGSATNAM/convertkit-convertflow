{%- comment -%}
  Component: brand-story-natural-home-v1
  Family: Home | Style: natural
  Archetypes: cozy, artisanal
  v2.0 — StoreForge Component Library
{%- endcomment -%}
<section class="image-with-text image-with-text--home-decor" style="padding: var(--space-80) 0; background-color: var(--color-background); border-bottom: 1px solid var(--color-border);">
  <div class="container" style="display: flex; flex-direction: column; gap: var(--space-64); align-items: center;" class="md-flex-row">
    
    {%- liquid
      assign is_reversed = false
      if section.settings.layout == 'text_first'
        assign is_reversed = true
      endif
    -%}

    <div style="display: flex; flex-direction: column; gap: var(--space-64); align-items: center; width: 100%;" class="md-flex-row {% if is_reversed %}flex-row-reverse{% endif %}">
      
      <!-- Image Column -->
      <div class="image-with-text-media" style="flex: 1; width: 100%;">
        {%- if section.settings.image != blank -%}
          <div style="border: 1px solid var(--color-border); border-radius: var(--card-radius); overflow: hidden; box-shadow: var(--card-shadow); line-height: 0;">
            <img src="{{ section.settings.image | image_url: width: 1000 }}" 
                 alt="{{ section.settings.image.alt | escape }}" 
                 loading="lazy"
                 style="width: 100%; height: auto; object-fit: cover;">
          </div>
        {%- else -%}
          <div style="width: 100%; aspect-ratio: 1.2; background-color: var(--color-surface); display: flex; align-items: center; justify-content: center; border: 1px solid var(--color-border); border-radius: var(--card-radius); box-shadow: var(--card-shadow);">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <!-- Text Column -->
      <div class="image-with-text-content" style="flex: 1; width: 100%; text-align: left; padding: var(--space-24);">
        <span style="color: var(--color-accent); font-family: var(--font-body-family); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; display: inline-block; margin-bottom: var(--space-16);">
          EDITORIAL COLLECTION
        </span>
        <h3 class="image-with-text-heading" style="font-family: var(--font-heading-family); font-size: 2.5rem; font-weight: 500; line-height: 1.3; margin: 0 0 var(--space-20) 0; color: var(--color-text);">
          {{ section.settings.heading | escape }}
        </h3>
        
        <div class="image-with-text-text rte" style="font-family: var(--font-body-family); font-size: 0.95rem; line-height: 1.8; color: var(--color-text); margin-bottom: var(--space-32); opacity: 0.85;">
          {{ section.settings.text }}
        </div>

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="button button--primary" style="border-radius: var(--button-radius);">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Image with Text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image_first", "label": "Image first" },
        { "value": "text_first", "label": "Text first" }
      ],
      "default": "image_first"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Harmonious Living Spaces"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We design objects that bring comfort, warmth, and visual balance to your daily environments. Crafted sustainably from earth-born terracotta, hand-woven linens, and premium hardwoods designed to mature gracefully over time.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore the Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ]
}
{% endschema %}
