{%- liquid
  assign sec_id = section.id
-%}

<style>
  #shopify-section-{{ sec_id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
  }

  .hp20-richtext-{{ sec_id }} {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: {{ section.settings.text_alignment }};
  }

  .hp20-richtext-{{ sec_id }}__label {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: {{ section.settings.text_color }};
    opacity: 0.6;
    margin-bottom: 32px;
    display: block;
  }

  .hp20-richtext-{{ sec_id }}__text {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 300;
    line-height: 1.3;
    color: {{ section.settings.text_color }};
    margin: 0;
    letter-spacing: -0.01em;
  }

  .hp20-richtext-{{ sec_id }}__text p {
    margin: 0 0 24px 0;
  }
  .hp20-richtext-{{ sec_id }}__text p:last-child {
    margin-bottom: 0;
  }
  .hp20-richtext-{{ sec_id }}__text strong {
    font-weight: 500;
  }

  .hp20-richtext-{{ sec_id }}__btn {
    display: inline-block;
    margin-top: 48px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: {{ section.settings.text_color }};
    text-decoration: none;
    padding: 14px 32px;
    border: 1px solid rgba({{ section.settings.text_color | color_to_rgb | remove: 'rgb(' | remove: ')' }}, {{ 0.2 }});
    transition: all 0.3s ease;
  }

  .hp20-richtext-{{ sec_id }}__btn:hover {
    border-color: {{ section.settings.text_color }};
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.bg_color }};
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ sec_id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px 0;
    }
  }
</style>

<section class="hp20-richtext-{{ sec_id }}">
  {% if section.settings.label != blank %}
    <span class="hp20-richtext-{{ sec_id }}__label">{{ section.settings.label }}</span>
  {% endif %}

  {% if section.settings.text != blank %}
    <div class="hp20-richtext-{{ sec_id }}__text">
      {{ section.settings.text }}
    </div>
  {% endif %}

  {% if section.settings.btn_label != blank and section.settings.btn_link != blank %}
    <a href="{{ section.settings.btn_link }}" class="hp20-richtext-{{ sec_id }}__btn">{{ section.settings.btn_label }}</a>
  {% endif %}
</section>

{% schema %}
{
  "name": "HP20 Oversized Text",
  "settings": [
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow Label",
      "default": "Our Philosophy"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe that true luxury lies in simplicity. Stripping away the excess leaves only what is essential, beautiful, and timeless.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 10,
      "unit": "px",
      "label": "Desktop Top Padding",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 10,
      "unit": "px",
      "label": "Desktop Bottom Padding",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP20 Oversized Text"
    }
  ]
}
{% endschema %}
