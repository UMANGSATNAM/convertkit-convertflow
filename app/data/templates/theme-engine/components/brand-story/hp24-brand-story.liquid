{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-primary: {{ section.settings.accent_primary }};
    --accent-secondary: {{ section.settings.accent_secondary }};
    --font-heading: 'Orbitron', sans-serif;
    --font-body: 'Share Tech Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Scanline background */
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.2) 3px,
      rgba(0,0,0,0.2) 4px
    );
    pointer-events: none;
    z-index: 1;
  }

  .hp24-story-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 768px) {
    .hp24-story-wrapper {
      padding: 0 20px;
    }
  }

  .hp24-story__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  @media screen and (max-width: 992px) {
    .hp24-story__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .hp24-story__image-col {
    position: relative;
    order: {{ section.settings.image_position }};
  }
  
  @media screen and (max-width: 992px) {
    .hp24-story__image-col {
      order: 1;
    }
    .hp24-story__text-col {
      order: 2;
    }
  }

  .hp24-story__image-wrapper {
    position: relative;
    border: 1px solid var(--accent-primary);
    padding: 20px;
    background: rgba(0,0,0,0.5);
    box-shadow: 0 0 20px rgba(0, 243, 255, 0.1);
  }

  /* HUD Corners */
  .hp24-story__image-wrapper::before,
  .hp24-story__image-wrapper::after {
    content: '';
    position: absolute;
    width: 30px;
    height: 30px;
    border: 3px solid var(--accent-secondary);
  }

  .hp24-story__image-wrapper::before {
    top: -5px; left: -5px;
    border-right: none; border-bottom: none;
  }

  .hp24-story__image-wrapper::after {
    bottom: -5px; right: -5px;
    border-left: none; border-top: none;
  }

  .hp24-story__image {
    width: 100%;
    height: auto;
    aspect-ratio: 4/5;
    object-fit: cover;
    filter: sepia(1) hue-rotate(180deg) saturate(2) contrast(1.2); /* Creates a cyan/blue tint */
    transition: filter 0.5s ease;
  }

  .hp24-story__image-wrapper:hover .hp24-story__image {
    filter: none;
  }
  
  .hp24-story__hud-overlay {
    position: absolute;
    top: 40px;
    right: 40px;
    color: var(--accent-primary);
    font-family: var(--font-body);
    font-size: 12px;
    text-align: right;
    pointer-events: none;
  }
  
  .hp24-story__hud-overlay span {
    display: block;
    margin-bottom: 5px;
  }

  .hp24-story__text-col {
    background: rgba(0,0,0,0.8);
    border: 1px solid rgba(255,255,255,0.1);
    border-left: 3px solid var(--accent-primary);
    padding: 40px;
    position: relative;
  }

  .hp24-story__sys-text {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--accent-secondary);
    margin-bottom: 20px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hp24-story__sys-text::before {
    content: '>';
    animation: blink 1s infinite;
  }

  .hp24-story__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 30px;
    text-transform: uppercase;
    line-height: 1.1;
    text-shadow: 2px 2px 0 rgba(0,243,255,0.3);
  }

  .hp24-story__text {
    font-family: var(--font-body);
    font-size: {{ section.settings.text_size }}px;
    color: var(--text-color);
    margin: 0 0 30px;
    line-height: 1.6;
    opacity: 0.8;
  }
  
  .hp24-story__text em {
    font-style: normal;
    color: var(--accent-primary);
  }

  .hp24-story__btn {
    font-family: var(--font-body);
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    background: transparent;
    color: var(--accent-primary);
    border: 1px solid var(--accent-primary);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: inset 0 0 0 var(--accent-primary);
  }

  .hp24-story__btn:hover {
    background: var(--accent-primary);
    color: var(--bg-color);
    box-shadow: inset 0 0 10px rgba(255,255,255,0.5), 0 0 15px var(--accent-primary);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp24-story-wrapper" id="HP24Story-{{ section.id }}">
  <div class="hp24-story__grid">
    
    <div class="hp24-story__image-col">
      <div class="hp24-story__image-wrapper">
        <div class="hp24-story__hud-overlay">
          <span>REC ⏺</span>
          <span>SYS.ON</span>
          <span>MEM: 99%</span>
        </div>
        
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | strip_html | escape }}" class="hp24-story__image" loading="lazy">
        {%- else -%}
          <div style="width:100%;aspect-ratio:4/5;background:#111;display:flex;align-items:center;justify-content:center;color:#444;font-family:'Share Tech Mono';border:1px solid #333;">IMAGE.NOT_FOUND</div>
        {%- endif -%}
      </div>
    </div>

    <div class="hp24-story__text-col">
      {%- if section.settings.sys_text != blank -%}
        <div class="hp24-story__sys-text">{{ section.settings.sys_text }}</div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="hp24-story__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="hp24-story__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.btn_text != blank -%}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="hp24-story__btn">
          {{ section.settings.btn_text | escape }}
        </a>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP24 - Cyber Story",
  "class": "section-hp24-brand-story",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "sys_text",
      "label": "System Text",
      "default": "SYSTEM.LOG // ORIGIN"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>REWRITING THE CODE</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body Text",
      "default": "<p>In a world of obsolete hardware and sluggish performance, we decided to build something better. We are the <em>architects</em> of the new digital dawn. Upgrade your existence.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "READ THE MANIFESTO"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position (Desktop)",
      "options": [
        { "value": "1", "label": "Left" },
        { "value": "2", "label": "Right" }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Cyberpunk Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_primary",
      "label": "Accent Primary (Neon Blue)",
      "default": "#00F3FF"
    },
    {
      "type": "color",
      "id": "accent_secondary",
      "label": "Accent Secondary (Neon Pink)",
      "default": "#FF00E6"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP24 - Cyber Story"
    }
  ]
}
{% endschema %}
