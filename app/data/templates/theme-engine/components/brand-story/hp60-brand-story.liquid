{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FFFDF0' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp60-story__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto; padding: 0 24px;
    display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 70px; align-items: center;
  }
  .hp60-story__img-wrap {
    border-radius: 8px; overflow: hidden; height: 480px;
    border: 1px solid rgba(217, 119, 6, 0.25); box-shadow: 0 20px 50px rgba(63, 98, 18, 0.12);
  }
  .hp60-story__img { width: 100%; height: 100%; object-fit: cover; }
  .hp60-story__eyebrow { font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#3F6212' }}; margin: 0 0 16px; }
  .hp60-story__heading { font-family: 'Bodoni Moda', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #1E293B; margin: 0 0 22px; line-height: 1.15; }
  .hp60-story__text { font-size: 15px; line-height: 1.8; color: #475569; margin: 0 0 32px; }
  .hp60-story__btn {
    display: inline-flex; align-items: center; gap: 10px; padding: 14px 34px;
    background: {{ section.settings.btn_bg | default: '#3F6212' }}; color: #FFFFFF;
    font-family: 'Outfit', sans-serif; font-size: 13px; font-weight: 700;
    letter-spacing: 1.5px; text-transform: uppercase;
    text-decoration: none; border-radius: 4px; transition: all 0.3s ease;
    box-shadow: 0 6px 20px rgba(63, 98, 18, 0.25);
  }
  .hp60-story__btn:hover { box-shadow: 0 10px 30px rgba(63, 98, 18, 0.45); transform: translateY(-2px); }
  @media screen and (max-width: 992px) { .hp60-story__container { grid-template-columns: 1fr; text-align: center; gap: 40px; } .hp60-story__img-wrap { height: 350px; } }
{%- endstyle -%}
<div class="hp60-story__container">
  <div class="hp60-story__img-wrap">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 800 }}" class="hp60-story__img" alt="{{ section.settings.heading }}" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp60-story__img' }}
    {%- endif -%}
  </div>
  <div>
    <p class="hp60-story__eyebrow">{{ section.settings.eyebrow | default: '🏛️ TUSCAN ESTATE ROOTS' }}</p>
    <h2 class="hp60-story__heading">{{ section.settings.heading | default: 'The Centenarian Olive Grove' }}</h2>
    <p class="hp60-story__text">{{ section.settings.text | default: 'Surrounded by limestone hills and wild cypress trees, our family estate hand-picks centenarian olive leaves and Calabrian bergamots during the golden morning mist, creating rich antioxidant extractions unmatched in purity.' }}</p>
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_url | default: '/pages/about' }}" class="hp60-story__btn">{{ section.settings.btn_label }} &rarr;</a>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "HP60 Story",
  "class": "section-hp60-story",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFDF0" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#3F6212" },
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#3F6212" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🏛️ TUSCAN ESTATE ROOTS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Centenarian Olive Grove" },
    { "type": "textarea", "id": "text", "label": "Story Text", "default": "Surrounded by limestone hills and wild cypress trees." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Estate Story" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP60 Story" }]
}
{% endschema %}
