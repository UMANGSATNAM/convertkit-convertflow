{%- style -%}#shopify-section-{{ section.id }}{background:#0F172A;padding:60px 0}.hp88-story{max-width:1100px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:center}@media(max-width:800px){.hp88-story{grid-template-columns:1fr}}.hp88-story img{width:100%;height:420px;object-fit:cover;border-radius:16px}{%- endstyle -%}<div class="hp88-story"><div>{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:800}}">{% else %}{{'collection-1'|placeholder_svg_tag}}{% endif %}</div><div><p style="color:#6366F1;font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:700">{{section.settings.kicker|default:'Our Story v88'}}</p><h2 style="font-size:28px;font-weight:800;margin:8px 0">{{section.settings.heading|default:'Made for electronics'}}</h2><p style="opacity:.7;line-height:1.7">{{section.settings.text|default:'Flagship specs, honest price on gadgets that matter'}}</p><a href="{{section.settings.url|default:'/collections/all'}}" style="display:inline-block;margin-top:14px;padding:12px 20px;background:#6366F1;color:#fff;border-radius:8px;text-decoration:none;font-weight:700">{{section.settings.btn|default:'Discover'}}</a></div></div>{% schema %}{"name":"HP88 Story","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"Our Story v88"},{"type":"text","id":"heading","label":"Heading","default":"Made for electronics"},{"type":"textarea","id":"text","label":"Text","default":"Flagship specs, honest price on gadgets that matter"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"btn","label":"Btn","default":"Discover"},{"type":"url","id":"url","label":"Link"}],"presets":[{"name":"HP88 Story"}]}{% endschema %}