{%- liquid
  assign bg_color = section.settings.bg_color | default: '#f9f6f0'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp4-fn-bg: {{ bg_color }};
    --hp4-fn-text: {{ text_color }};
    
    --hp4-fn-pt-desk: {{ padding_top_desktop }}px;
    --hp4-fn-pb-desk: {{ padding_bottom_desktop }}px;
    --hp4-fn-pt-mob: {{ padding_top_mobile }}px;
    --hp4-fn-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp4-decor-fn-{{ section.id }} {
    padding-top: var(--hp4-fn-pt-desk);
    padding-bottom: var(--hp4-fn-pb-desk);
    background-color: var(--hp4-fn-bg);
    color: var(--hp4-fn-text);
    font-family: 'Playfair Display', serif;
    text-align: center;
  }

  .hp4-fn-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hp4-fn-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: #e8e3d8;
    overflow: hidden;
    margin-bottom: 30px;
    border: 2px solid var(--hp4-fn-text);
    padding: 4px;
  }
  .hp4-fn-avatar img {
    width: 100%; height: 100%; object-fit: cover; border-radius: 50%;
  }

  .hp4-fn-quote {
    font-size: clamp(24px, 4vw, 36px);
    line-height: 1.4;
    font-style: italic;
    margin: 0 0 40px 0;
  }

  .hp4-fn-signature {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .hp4-fn-signature img {
    max-width: 150px;
    filter: invert(1); /* Assuming black signature on dark bg? Wait, adjust based on text color */
  }

  /* Auto invert signature based on text color - heuristic approach */
  {% if text_color == '#ffffff' or text_color == '#f9f6f0' %}
    .hp4-fn-signature img { filter: invert(1); }
  {% endif %}

  .hp4-fn-name {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0;
  }
  .hp4-fn-title {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: rgba(44,44,44,0.6);
    margin: 5px 0 0 0;
  }

  @media screen and (max-width: 768px) {
    .hp4-decor-fn-{{ section.id }} {
      padding-top: var(--hp4-fn-pt-mob);
      padding-bottom: var(--hp4-fn-pb-mob);
    }
    .hp4-fn-inner {
      padding: 0 20px;
    }
    .hp4-fn-quote {
      font-size: 22px;
    }
  }
</style>

<section class="hp4-decor-fn-{{ section.id }}" aria-label="Founder Note">
  <div class="hp4-fn-inner">
    
    {%- if section.settings.image != blank -%}
      <div class="hp4-fn-avatar">
        <img src="{{ section.settings.image | image_url: width: 200 }}" loading="lazy" alt="{{ section.settings.name }}">
      </div>
    {%- endif -%}

    {%- if section.settings.quote != blank -%}
      <h2 class="hp4-fn-quote">"{{ section.settings.quote }}"</h2>
    {%- endif -%}

    <div class="hp4-fn-signature">
      {%- if section.settings.signature != blank -%}
        <img src="{{ section.settings.signature | image_url: width: 300 }}" loading="lazy" alt="Signature">
      {%- else -%}
        <!-- Fallback artistic font for signature -->
        <span style="font-family: 'Brush Script MT', cursive; font-size: 32px;">Emma Woods</span>
      {%- endif -%}
      
      <div>
        <p class="hp4-fn-name">{{ section.settings.name | default: 'Emma Woods' }}</p>
        <p class="hp4-fn-title">{{ section.settings.title | default: 'Founder & Creative Director' }}</p>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP4 Decor Founder Note",
  "tag": "section",
  "class": "section-hp4-founder",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder Photo"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "True luxury is found in the quiet details—the texture of natural linen, the warmth of handmade ceramics, the spaces that invite you to simply be."
    },
    {
      "type": "image_picker",
      "id": "signature",
      "label": "Signature Image (Transparent PNG)"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Emma Woods"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Founder & Creative Director"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f6f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP4 Decor Founder Note",
      "category": "About"
    }
  ]
}
{% endschema %}
