{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#00FFA3'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 40px;
    color: #FFF;
    border-bottom: 1px solid #333;
    position: relative;
    overflow: hidden;
  }
  
  .hp13-brand-story-bg-{{ section_id }} {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: 20vw;
    color: #111;
    z-index: 0;
    text-align: center;
    line-height: 1;
    white-space: nowrap;
    pointer-events: none;
  }
  
  .hp13-brand-story-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    text-align: center;
    background: rgba(5, 5, 5, 0.8);
    border: 1px solid {{ text_color }};
    padding: 60px 40px;
    backdrop-filter: blur(5px);
  }
  
  .hp13-brand-story-sys-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.85rem;
    color: {{ text_color }};
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  
  .hp13-brand-story-heading-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 900;
    margin: 0 0 30px 0;
    text-transform: uppercase;
    letter-spacing: 2px;
    line-height: 1.1;
  }
  
  .hp13-brand-story-text-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 40px 0;
    color: #CCC;
  }
  
  .hp13-brand-story-btn-{{ section_id }} {
    display: inline-block;
    padding: 12px 25px;
    color: {{ bg_color }};
    background-color: {{ text_color }};
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9rem;
    font-weight: bold;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 4px 4px 0 rgba(255,255,255,0.2);
    transition: all 0.2s ease;
  }
  
  .hp13-brand-story-btn-{{ section_id }}:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 rgba(255,255,255,0.2);
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp13-brand-story-container-{{ section_id }} {
      padding: 40px 20px;
    }
  }
</style>

<div class="hp13-brand-story-bg-{{ section_id }}">CYBER_SYS</div>

<div class="hp13-brand-story-container-{{ section_id }}">
  <div class="hp13-brand-story-sys-{{ section_id }}">> EXEC: ABOUT_PROTOCOL</div>
  <h2 class="hp13-brand-story-heading-{{ section_id }}">{{ section.settings.heading | default: 'ENGINEERED FOR THE GRID' }}</h2>
  <div class="hp13-brand-story-text-{{ section_id }}">
    {{ section.settings.text | default: 'Born in the sprawl, built for survival. We design modular, high-performance gear that adapts to any environment. This is not fashion, this is functional armor for the modern citizen.' }}
  </div>
  
  {% if section.settings.button_label != blank %}
    <a href="{{ section.settings.button_link | default: '#' }}" class="hp13-brand-story-btn-{{ section_id }}">
      {{ section.settings.button_label }}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "HP13 Brand Story",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Highlight Color",
      "default": "#00FFA3"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ENGINEERED FOR THE GRID"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Born in the sprawl, built for survival. We design modular, high-performance gear that adapts to any environment. This is not fashion, this is functional armor for the modern citizen."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "ACCESS_ARCHIVES"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP13 Brand Story"
    }
  ]
}
{% endschema %}
