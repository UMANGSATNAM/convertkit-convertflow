{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0F291E' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp57-story__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto; padding: 0 24px;
    display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 70px; align-items: center;
  }
  .hp57-story__img-wrap {
    border-radius: 16px; overflow: hidden; height: 480px;
    border: 1px solid rgba(167, 243, 208, 0.25); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }
  .hp57-story__img { width: 100%; height: 100%; object-fit: cover; }
  .hp57-story__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#D97706' }}; margin: 0 0 16px; }
  .hp57-story__heading { font-family: 'Cormorant Garamond', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #FFFFFF; margin: 0 0 22px; line-height: 1.15; }
  .hp57-story__text { font-size: 15px; line-height: 1.8; color: #CBD5E1; margin: 0 0 32px; }
  .hp57-story__btn {
    display: inline-flex; align-items: center; gap: 10px; padding: 14px 34px;
    background: {{ section.settings.btn_bg | default: '#D97706' }}; color: #0F291E;
    font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; font-weight: 700;
    text-decoration: none; border-radius: 6px; transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(217, 119, 6, 0.3);
  }
  .hp57-story__btn:hover { box-shadow: 0 8px 25px rgba(217, 119, 6, 0.5); transform: translateY(-2px); }
  @media screen and (max-width: 992px) { .hp57-story__container { grid-template-columns: 1fr; text-align: center; gap: 40px; } .hp57-story__img-wrap { height: 350px; } }
{%- endstyle -%}
<div class="hp57-story__container">
  <div class="hp57-story__img-wrap">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 800 }}" class="hp57-story__img" alt="{{ section.settings.heading }}" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp57-story__img' }}
    {%- endif -%}
  </div>
  <div>
    <p class="hp57-story__eyebrow">{{ section.settings.eyebrow | default: '🌿 GREENHOUSE ROOTS' }}</p>
    <h2 class="hp57-story__heading">{{ section.settings.heading | default: 'The 18th Century Apothecary' }}</h2>
    <p class="hp57-story__text">{{ section.settings.text | default: 'Inside our Victorian glasshouse conservatories, rare alpine ferns and heirloom calendula are harvested by hand at sunrise when plant volatile compounds are at their biological zenith.' }}</p>
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_url | default: '/pages/about' }}" class="hp57-story__btn">{{ section.settings.btn_label }} &rarr;</a>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "HP57 Story",
  "class": "section-hp57-story",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0F291E" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#D97706" },
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#D97706" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌿 GREENHOUSE ROOTS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The 18th Century Apothecary" },
    { "type": "textarea", "id": "text", "label": "Story Text", "default": "Inside our Victorian glasshouse conservatories, rare alpine ferns are harvested at sunrise." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Enter Greenhouse" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP57 Story" }]
}
{% endschema %}
