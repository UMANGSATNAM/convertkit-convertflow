{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp50-story-bg: {{ section.settings.bg_color | default: '#000000' }};
    
    background-color: var(--hp50-story-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp50-story__container {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
  }

  .hp50-story__media-frame {
    overflow: hidden;
    height: 480px;
    background: #111111;
    border: 1px solid rgba(226, 232, 240, 0.25);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
  }

  .hp50-story__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(40%) contrast(1.1);
  }

  .hp50-story__subhead {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    color: #94A3B8;
    margin: 0 0 12px;
  }

  .hp50-story__title {
    font-family: 'Italiana', serif;
    font-size: clamp(34px, 4.5vw, 50px);
    font-weight: 400;
    line-height: 1.1;
    color: #FFFFFF;
    margin: 0 0 20px;
  }

  .hp50-story__desc {
    font-size: 15px;
    line-height: 1.8;
    color: #94A3B8;
    margin: 0 0 32px;
  }

  .hp50-story__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    border-top: 1px solid rgba(226, 232, 240, 0.2);
    padding-top: 24px;
    margin-bottom: 36px;
  }

  .hp50-story__val {
    font-family: 'Syne', sans-serif;
    font-size: 28px;
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 4px;
  }

  .hp50-story__lbl {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #94A3B8;
    text-transform: uppercase;
    margin: 0;
  }

  .hp50-story__btn {
    display: inline-flex;
    padding: 16px 36px;
    background: #FFFFFF;
    color: #000000;
    border: 1px solid #FFFFFF;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .hp50-story__btn:hover {
    background: transparent;
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  @media screen and (max-width: 992px) {
    .hp50-story__container { grid-template-columns: 1fr; text-align: center; }
    .hp50-story__media-frame { height: 340px; }
  }
{%- endstyle -%}

<div class="hp50-story__container">
  <div class="hp50-story__media-frame">
    {%- if section.settings.image != blank -%}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" class="hp50-story__img" alt="Backstage Editorial" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp50-story__img' }}
    {%- endif -%}
  </div>

  <div>
    <p class="hp50-story__subhead">HAUTE COUTURE EDITORIAL</p>
    <h2 class="hp50-story__title">{{ section.settings.heading | default: 'Precision Contouring for Runway Perfection' }}</h2>
    <p class="hp50-story__desc">
      {{ section.settings.description | default: 'Born in backstage green rooms across Paris, Milan, and New York. Formulated with colloidal platinum catalysts and obsidian volcanic minerals that immediately tighten facial contours under high-wattage runway studio lights.' }}
    </p>

    <div class="hp50-story__stats">
      <div>
        <p class="hp50-story__val">100%</p>
        <p class="hp50-story__lbl">PARISIAN COUTURE</p>
      </div>
      <div>
        <p class="hp50-story__val">0.05μm</p>
        <p class="hp50-story__lbl">PLATINUM PARTICLES</p>
      </div>
      <div>
        <p class="hp50-story__val">DDP</p>
        <p class="hp50-story__lbl">AIR EXPRESS DISPATCH</p>
      </div>
    </div>

    <a href="{{ section.settings.btn_url | default: '/pages/about' }}" class="hp50-story__btn">
      {{ section.settings.btn_text | default: 'Read Backstage Dossier &rarr;' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP50 - Runway Story",
  "class": "section-hp50-story",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "image_picker", "id": "image", "label": "Story Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Precision Contouring for Runway Perfection" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Born in backstage green rooms across Paris, Milan, and New York." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Read Backstage Dossier →" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "presets": [
    { "name": "HP50 - Runway Story" }
  ]
}
{% endschema %}
