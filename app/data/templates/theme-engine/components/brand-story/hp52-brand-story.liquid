{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp52-story-bg: {{ section.settings.bg_color | default: '#F7EFE6' }};
    --hp52-terra: {{ section.settings.accent_terra | default: '#C2593F' }};
    
    background-color: var(--hp52-story-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp52-story__container {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
  }

  .hp52-story__media-frame {
    border-radius: 140px 140px 24px 24px;
    overflow: hidden;
    height: 480px;
    background: #EFE4D6;
    box-shadow: 0 20px 50px rgba(45, 59, 45, 0.08);
    border: 3px solid #FFFDF9;
  }

  .hp52-story__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp52-story__subhead {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--hp52-terra);
    margin: 0 0 12px;
  }

  .hp52-story__title {
    font-family: 'Bodoni Moda', serif;
    font-size: clamp(32px, 4.5vw, 46px);
    font-weight: 700;
    line-height: 1.15;
    color: #2D3B2D;
    margin: 0 0 20px;
  }

  .hp52-story__desc {
    font-size: 16px;
    line-height: 1.8;
    color: #5C675B;
    margin: 0 0 32px;
  }

  .hp52-story__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    border-top: 1px solid rgba(194, 89, 63, 0.2);
    padding-top: 24px;
    margin-bottom: 36px;
  }

  .hp52-story__val {
    font-family: 'Bodoni Moda', serif;
    font-size: 30px;
    font-weight: 700;
    color: #2D3B2D;
    margin: 0 0 4px;
  }

  .hp52-story__lbl {
    font-size: 11px;
    font-weight: 700;
    color: var(--hp52-terra);
    text-transform: uppercase;
    margin: 0;
  }

  .hp52-story__btn {
    display: inline-flex;
    padding: 16px 36px;
    background: #C2593F;
    color: #FFFDF9;
    font-family: 'Jost', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .hp52-story__btn:hover {
    background: #A94B34;
    transform: translateY(-2px);
  }

  @media screen and (max-width: 992px) {
    .hp52-story__container { grid-template-columns: 1fr; text-align: center; }
    .hp52-story__media-frame { height: 340px; }
  }
{%- endstyle -%}

<div class="hp52-story__container">
  <div class="hp52-story__media-frame">
    {%- if section.settings.image != blank -%}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" class="hp52-story__img" alt="Tuscan Grove" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp52-story__img' }}
    {%- endif -%}
  </div>

  <div>
    <p class="hp52-story__subhead">TUSCAN OLIVE HARVEST</p>
    <h2 class="hp52-story__title">{{ section.settings.heading | default: 'Sun-Soaked Botanical Wisdom from Italian Groves' }}</h2>
    <p class="hp52-story__desc">
      {{ section.settings.description | default: 'Cultivated in century-old olive groves along the rolling hills of Tuscany. Our cold-pressed botanical extractions retain pure squalene and oleic acids, locking in deep moisture for radiant sun-kissed skin.' }}
    </p>

    <div class="hp52-story__stats">
      <div>
        <p class="hp52-story__val">100%</p>
        <p class="hp52-story__lbl">COLD PRESS EXTRACTION</p>
      </div>
      <div>
        <p class="hp52-story__val">300 YRS</p>
        <p class="hp52-story__lbl">HERITAGE OLIVE GROVES</p>
      </div>
      <div>
        <p class="hp52-story__val">DDP</p>
        <p class="hp52-story__lbl">AIR EXPRESS DISPATCH</p>
      </div>
    </div>

    <a href="{{ section.settings.btn_url | default: '/pages/about' }}" class="hp52-story__btn">
      {{ section.settings.btn_text | default: 'Read Our Tuscan Grove Journal &rarr;' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP52 - Terra Story",
  "class": "section-hp52-story",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F7EFE6" },
    { "type": "color", "id": "accent_terra", "label": "Terracotta Accent", "default": "#C2593F" },
    { "type": "image_picker", "id": "image", "label": "Story Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sun-Soaked Botanical Wisdom from Italian Groves" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Cultivated in century-old olive groves along the rolling hills of Tuscany." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Read Our Tuscan Grove Journal →" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "presets": [
    { "name": "HP52 - Terra Story" }
  ]
}
{% endschema %}
