{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Jost', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp21-founder-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp21-founder-wrapper {
      padding: 0 20px;
    }
  }

  .hp21-founder__container {
    display: flex;
    align-items: center;
    gap: {{ section.settings.gap }}px;
    background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0) 100%);
    border: 1px solid rgba(255,255,255,0.05);
    padding: 0;
  }

  @media screen and (max-width: 992px) {
    .hp21-founder__container {
      flex-direction: column;
    }
  }

  .hp21-founder__image-area {
    flex: 1;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .hp21-founder__image-area::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    box-shadow: inset 0 0 80px rgba(10,10,10,0.5);
    pointer-events: none;
  }

  .hp21-founder__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4/5;
    filter: {% if section.settings.image_grayscale %}grayscale(100%){% else %}none{% endif %};
    transition: transform 1.5s ease;
  }

  .hp21-founder__container:hover .hp21-founder__image {
    transform: scale(1.05);
  }

  .hp21-founder__content {
    flex: 1;
    padding: 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (max-width: 992px) {
    .hp21-founder__content {
      padding: 40px 24px;
      text-align: center;
      align-items: center;
    }
  }

  .hp21-founder__quote-mark {
    font-family: var(--font-heading);
    font-size: 60px;
    color: var(--accent-color);
    line-height: 1;
    margin-bottom: 16px;
  }

  .hp21-founder__text {
    font-family: var(--font-heading);
    font-size: clamp(24px, 4vw, {{ section.settings.text_size }}px);
    font-weight: 300;
    line-height: 1.5;
    color: var(--text-color);
    margin: 0 0 40px;
    font-style: italic;
  }

  .hp21-founder__name {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--text-color);
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .hp21-founder__title {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 300;
    color: var(--accent-color);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .hp21-founder__signature {
    margin-top: 32px;
  }
  
  .hp21-founder__signature img {
    max-width: 150px;
    filter: invert(1);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp21-founder-wrapper" id="HP21Founder-{{ section.id }}">
  <div class="hp21-founder__container">
    
    <div class="hp21-founder__image-area">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.name | escape }}" class="hp21-founder__image" loading="lazy">
      {%- else -%}
        <div style="width:100%;height:100%;aspect-ratio:4/5;background:#111;display:flex;align-items:center;justify-content:center;color:#333;">FOUNDER IMAGE</div>
      {%- endif -%}
    </div>

    <div class="hp21-founder__content">
      <div class="hp21-founder__quote-mark">"</div>
      
      {%- if section.settings.text != blank -%}
        <div class="hp21-founder__text">{{ section.settings.text }}</div>
      {%- endif -%}
      
      <div class="hp21-founder__meta">
        {%- if section.settings.name != blank -%}
          <div class="hp21-founder__name">{{ section.settings.name | escape }}</div>
        {%- endif -%}
        {%- if section.settings.title_text != blank -%}
          <div class="hp21-founder__title">{{ section.settings.title_text | escape }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.signature != blank -%}
        <div class="hp21-founder__signature">
          <img src="{{ section.settings.signature | image_url: width: 200 }}" alt="Signature" loading="lazy">
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP21 Luxury Founder",
  "class": "section-hp21-founder-note",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder Image"
    },
    {
      "type": "checkbox",
      "id": "image_grayscale",
      "label": "Grayscale Image",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Message",
      "default": "<p>True luxury is not about excess, it is about absolute clarity of vision and uncompromising dedication to craft.</p>"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Founder Name",
      "default": "E. MONTGOMERY"
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Founder Title",
      "default": "FOUNDER & CREATIVE DIRECTOR"
    },
    {
      "type": "image_picker",
      "id": "signature",
      "label": "Signature Image (Optional)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap between image and text",
      "default": 0
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Message Text Size",
      "default": 36
    },
    {
      "type": "header",
      "content": "Luxury Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D4AF37"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP21 Luxury Founder"
    }
  ]
}
{% endschema %}
