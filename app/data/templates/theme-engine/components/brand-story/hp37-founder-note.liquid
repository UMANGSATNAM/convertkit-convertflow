{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Shrikhand&family=DM+Sans:wght@400;500;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --card-bg: {{ section.settings.card_bg }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Shrikhand', cursive;
    --font-body: 'DM Sans', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp37-founder-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 60px 40px;
    background: var(--card-bg);
    border: 4px solid var(--text-color);
    border-radius: 40px;
    box-shadow: 12px 12px 0px var(--accent-color);
    text-align: center;
    position: relative;
    transform: rotate(1deg);
  }

  @media screen and (max-width: 768px) {
    .hp37-founder-wrapper {
      padding: 40px 20px;
      border-radius: 20px;
      box-shadow: 8px 8px 0px var(--accent-color);
    }
  }

  .hp37-founder__pin {
    position: absolute;
    top: -15px;
    left: 50%;
    transform: translateX(-50%);
    width: 30px;
    height: 30px;
    background: var(--accent-color);
    border-radius: 50%;
    border: 3px solid var(--text-color);
    box-shadow: 2px 2px 0px var(--text-color);
    z-index: 2;
  }

  .hp37-founder__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, 48px);
    color: var(--text-color);
    margin: 0 0 30px;
    transform: rotate(-2deg);
  }

  .hp37-founder__content {
    font-family: var(--font-body);
    font-size: clamp(16px, 2vw, {{ section.settings.text_size }}px);
    line-height: 1.6;
    color: var(--text-color);
    font-weight: 500;
    margin-bottom: 40px;
  }

  .hp37-founder__content p {
    margin: 0 0 20px;
  }

  .hp37-founder__signature {
    margin-bottom: 10px;
  }

  .hp37-founder__signature-img {
    max-width: 150px;
    height: auto;
  }

  .hp37-founder__name {
    font-family: var(--font-heading);
    font-size: 24px;
    color: var(--accent-color);
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp37-founder-wrapper" id="HP37Founder-{{ section.id }}">
  <div class="hp37-founder__pin"></div>
  
  <h2 class="hp37-founder__title">{{ section.settings.title }}</h2>
  
  <div class="hp37-founder__content">
    {{ section.settings.text }}
  </div>
  
  {%- if section.settings.signature != blank -%}
    <div class="hp37-founder__signature">
      <img src="{{ section.settings.signature | image_url: width: 300 }}" alt="{{ section.settings.name }}" class="hp37-founder__signature-img" loading="lazy">
    </div>
  {%- endif -%}
  
  <div class="hp37-founder__name">{{ section.settings.name }}</div>
</div>

{% schema %}
{
  "name": "HP37 - Retro Note",
  "class": "section-hp37-founder-note",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "A Note from the Crew"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Hey friends! We started this whole thing because we couldn't find gear that felt right. We wanted clothes that could take a beating at the beach but still look fresh when grabbing a bite afterward. Thanks for riding this wave with us.</p>"
    },
    {
      "type": "image_picker",
      "id": "signature",
      "label": "Signature Image"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "The Founders"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 20
    },
    {
      "type": "header",
      "content": "Retro Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4E3C5"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#F9F3EA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A3219"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#798A58"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP37 - Retro Note"
    }
  ]
}
{% endschema %}
