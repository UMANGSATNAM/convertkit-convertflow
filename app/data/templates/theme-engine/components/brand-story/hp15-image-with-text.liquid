{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign layout = section.settings.layout | default: 'image_left'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
  }
  
  .hp15-iwt-container-{{ section_id }} {
    display: flex;
    min-height: 80vh;
    {% if layout == 'image_right' %}
      flex-direction: row-reverse;
    {% endif %}
  }
  
  .hp15-iwt-image-wrap-{{ section_id }} {
    flex: 1;
    position: relative;
  }
  
  .hp15-iwt-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
  }
  
  .hp15-iwt-content-{{ section_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 100px;
    color: {{ text_color }};
  }
  
  .hp15-iwt-subtitle-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 30px;
  }
  
  .hp15-iwt-title-{{ section_id }} {
    font-family: 'Didot', 'Playfair Display', serif;
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 30px 0;
    line-height: 1.1;
  }
  
  .hp15-iwt-text-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.95rem;
    line-height: 1.8;
    margin: 0 0 40px 0;
    max-width: 500px;
    opacity: 0.8;
  }
  
  .hp15-iwt-btn-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: {{ text_color }};
    text-decoration: none;
    border-bottom: 1px solid {{ text_color }};
    padding-bottom: 5px;
    align-self: flex-start;
    transition: opacity 0.3s ease;
  }
  
  .hp15-iwt-btn-{{ section_id }}:hover {
    opacity: 0.6;
  }

  @media (max-width: 992px) {
    .hp15-iwt-container-{{ section_id }} {
      flex-direction: column;
    }
    .hp15-iwt-image-wrap-{{ section_id }} {
      min-height: 50vh;
    }
    .hp15-iwt-content-{{ section_id }} {
      padding: 60px 30px;
    }
  }
</style>

<div class="hp15-iwt-container-{{ section_id }}">
  <div class="hp15-iwt-image-wrap-{{ section_id }}">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 1200 }}" class="hp15-iwt-image-{{ section_id }}" loading="lazy" alt="Image">
    {% else %}
      <div class="hp15-iwt-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
    {% endif %}
  </div>
  
  <div class="hp15-iwt-content-{{ section_id }}">
    <div class="hp15-iwt-subtitle-{{ section_id }}">{{ section.settings.subtitle | default: 'THE ARCHIVE' }}</div>
    <h2 class="hp15-iwt-title-{{ section_id }}">{{ section.settings.title | default: 'TAILORED PERFECTION' }}</h2>
    <div class="hp15-iwt-text-{{ section_id }}">{{ section.settings.text | default: '<p>Our signature silhouettes redefined. Exploring the intersection of structured tailoring and fluid drape. A study in contrasts and monochromatic elegance.</p>' }}</div>
    <a href="{{ section.settings.btn_link | default: '#' }}" class="hp15-iwt-btn-{{ section_id }}">{{ section.settings.btn_text | default: 'DISCOVER MORE' }}</a>
  </div>
</div>

{% schema %}
{
  "name": "HP15 Image with Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Alignment",
      "options": [
        { "value": "image_left", "label": "Left" },
        { "value": "image_right", "label": "Right" }
      ],
      "default": "image_left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE ARCHIVE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "TAILORED PERFECTION"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our signature silhouettes redefined. Exploring the intersection of structured tailoring and fluid drape. A study in contrasts and monochromatic elegance.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "DISCOVER MORE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP15 Image with Text"
    }
  ]
}
{% endschema %}
