{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --border-thickness: {{ section.settings.border_thickness }}px;
    --shadow-color: {{ section.settings.shadow_color }};
    --shadow-offset: {{ section.settings.shadow_offset }}px;
    --accent-color: {{ section.settings.accent_color }};
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp20-founder-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: {{ section.settings.alignment }};
  }

  .hp20-founder__container {
    background: {{ section.settings.content_bg }};
    border: var(--border-thickness) solid var(--border-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0px var(--shadow-color);
    padding: {{ section.settings.content_padding }}px;
    max-width: 800px;
    position: relative;
  }

  @media screen and (max-width: 768px) {
    .hp20-founder__container {
      padding: 32px 24px;
    }
  }

  .hp20-founder__tape {
    position: absolute;
    top: -15px;
    left: -15px;
    background: var(--accent-color);
    color: var(--text-color);
    border: var(--border-thickness) solid var(--border-color);
    padding: 8px 16px;
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: 14px;
    text-transform: uppercase;
    transform: rotate(-3deg);
    z-index: 2;
    box-shadow: 4px 4px 0px var(--shadow-color);
  }

  .hp20-founder__title {
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(32px, 6vw, {{ section.settings.title_size }}px);
    color: var(--text-color);
    text-transform: uppercase;
    margin: 0 0 32px;
    letter-spacing: -1px;
    line-height: 1.1;
  }

  .hp20-founder__text {
    font-family: 'Inter', sans-serif;
    font-size: {{ section.settings.text_size }}px;
    font-weight: 500;
    line-height: 1.6;
    color: var(--text-color);
    margin: 0 0 40px;
  }
  
  /* Ransom Note Style Highlights */
  .hp20-founder__text strong {
    background: var(--text-color);
    color: var(--bg-color); /* assuming outer bg is contrasting, or hardcoded white */
    padding: 2px 8px;
    font-weight: 900;
    text-transform: uppercase;
    display: inline-block;
    margin: 0 4px;
    transform: rotate(-1deg);
  }

  .hp20-founder__footer {
    display: flex;
    align-items: center;
    gap: 24px;
    border-top: var(--border-thickness) dashed var(--border-color);
    padding-top: 32px;
  }

  .hp20-founder__image {
    width: {{ section.settings.image_size }}px;
    height: {{ section.settings.image_size }}px;
    border: var(--border-thickness) solid var(--border-color);
    object-fit: cover;
    filter: grayscale(100%);
  }

  .hp20-founder__info {
    display: flex;
    flex-direction: column;
  }

  .hp20-founder__name {
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: 20px;
    text-transform: uppercase;
    color: var(--text-color);
    margin: 0 0 4px;
  }

  .hp20-founder__role {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 14px;
    color: var(--text-color);
    text-transform: uppercase;
    opacity: 0.7;
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp20-founder-wrapper" id="HP20FounderNote-{{ section.id }}">
  <div class="hp20-founder__container">
    
    {%- if section.settings.badge != blank -%}
      <div class="hp20-founder__tape">{{ section.settings.badge | escape }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="hp20-founder__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hp20-founder__text">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="hp20-founder__footer">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 200 }}" alt="{{ section.settings.name | escape }}" class="hp20-founder__image" loading="lazy">
      {%- endif -%}
      
      <div class="hp20-founder__info">
        <p class="hp20-founder__name">{{ section.settings.name | escape }}</p>
        <p class="hp20-founder__role">{{ section.settings.role | escape }}</p>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP20 - Brutalist Founder",
  "class": "section-hp20-founder-note",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Box Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Desktop Box Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Tape Text",
      "default": "A NOTE FROM THE FOUNDER"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "WE REFUSED TO COMPROMISE."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Note Text",
      "info": "Use bolding to create 'ransom note' style highlights."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder Image"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Founder Name",
      "default": "JOHN DOE"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Founder Role",
      "default": "FOUNDER / CEO"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 18
    },
    {
      "type": "range",
      "id": "image_size",
      "min": 40,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Avatar Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Brutalist Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Outer Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "content_bg",
      "label": "Note Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Tape)",
      "default": "#E2FF00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Thickness",
      "default": 3
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Hard Shadow Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "shadow_offset",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Shadow Offset",
      "default": 12
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP20 - Brutalist Founder"
    }
  ]
}
{% endschema %}
