{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp51-story-bg: {{ section.settings.bg_color | default: '#F2EFE9' }};
    --hp51-matcha: {{ section.settings.accent_matcha | default: '#2D5A3D' }};
    
    background-color: var(--hp51-story-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp51-story__container {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
  }

  .hp51-story__media-frame {
    border-radius: 20px;
    overflow: hidden;
    height: 480px;
    background: #E3DDD3;
    box-shadow: 0 20px 50px rgba(30, 58, 43, 0.08);
    border: 1px solid rgba(30, 58, 43, 0.12);
  }

  .hp51-story__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp51-story__subhead {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--hp51-matcha);
    margin: 0 0 12px;
  }

  .hp51-story__title {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(32px, 4.5vw, 46px);
    font-weight: 700;
    line-height: 1.15;
    color: #1E3A2B;
    margin: 0 0 20px;
  }

  .hp51-story__desc {
    font-size: 16px;
    line-height: 1.8;
    color: #4A5B50;
    margin: 0 0 32px;
  }

  .hp51-story__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    border-top: 1px solid rgba(30, 58, 43, 0.15);
    padding-top: 24px;
    margin-bottom: 36px;
  }

  .hp51-story__val {
    font-family: 'Noto Serif JP', serif;
    font-size: 30px;
    font-weight: 700;
    color: #1E3A2B;
    margin: 0 0 4px;
  }

  .hp51-story__lbl {
    font-size: 11px;
    font-weight: 700;
    color: var(--hp51-matcha);
    text-transform: uppercase;
    margin: 0;
  }

  .hp51-story__btn {
    display: inline-flex;
    padding: 16px 36px;
    background: #1E3A2B;
    color: #FAF8F5;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .hp51-story__btn:hover {
    background: var(--hp51-matcha);
    transform: translateY(-2px);
  }

  @media screen and (max-width: 992px) {
    .hp51-story__container { grid-template-columns: 1fr; text-align: center; }
    .hp51-story__media-frame { height: 340px; }
  }
{%- endstyle -%}

<div class="hp51-story__container">
  <div class="hp51-story__media-frame">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1000 }}" class="hp51-story__img" alt="Kyoto Zen Garden" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp51-story__img' }}
    {%- endif -%}
  </div>

  <div>
    <p class="hp51-story__subhead">KYOTO BOTANICAL HERITAGE</p>
    <h2 class="hp51-story__title">{{ section.settings.heading | default: 'Ancient Japanese Tea Wisdom Meets Cellular Science' }}</h2>
    <p class="hp51-story__desc">
      {{ section.settings.description | default: 'Our ceremonial matcha is hand-picked in Uji during the first spring flush after 30 days of shade growing. This traditional canopy method elevates theanine and EGCG content, providing unmatched cellular defense against skin stress.' }}
    </p>

    <div class="hp51-story__stats">
      <div>
        <p class="hp51-story__val">30 DAYS</p>
        <p class="hp51-story__lbl">SHADE CANOPY CULTIVATION</p>
      </div>
      <div>
        <p class="hp51-story__val">137X</p>
        <p class="hp51-story__lbl">MORE ANTIOXIDANTS</p>
      </div>
      <div>
        <p class="hp51-story__val">100%</p>
        <p class="hp51-story__lbl">ORGANIC HARVEST</p>
      </div>
    </div>

    <a href="{{ section.settings.btn_url | default: '/pages/about' }}" class="hp51-story__btn">
      {{ section.settings.btn_text | default: 'Read Our Tea Master Journal &rarr;' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP51 - Zen Story",
  "class": "section-hp51-story",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F2EFE9" },
    { "type": "color", "id": "accent_matcha", "label": "Matcha Accent", "default": "#2D5A3D" },
    { "type": "image_picker", "id": "image", "label": "Story Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ancient Japanese Tea Wisdom Meets Cellular Science" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Our ceremonial matcha is hand-picked in Uji during the first spring flush." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Read Our Tea Master Journal →" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "presets": [
    { "name": "HP51 - Zen Story" }
  ]
}
{% endschema %}
