{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Cedarville+Cursive&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Lato', sans-serif;
    --font-script: 'Cedarville Cursive', cursive;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp31-founder-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
  }

  @media screen and (max-width: 992px) {
    .hp31-founder-wrapper {
      flex-direction: column;
      gap: 40px;
      padding: 0 20px;
      text-align: center;
    }
  }

  .hp31-founder__image-col {
    flex: 1;
    max-width: 400px;
    position: relative;
  }

  @media screen and (max-width: 992px) {
    .hp31-founder__image-col {
      margin: 0 auto;
    }
  }

  .hp31-founder__image-wrap {
    position: relative;
    border-radius: 200px 200px 24px 24px; /* Arch shape */
    overflow: hidden;
    background: #E8E2D6;
    aspect-ratio: 3/4;
    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
  }

  .hp31-founder__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hp31-founder__content-col {
    flex: 1.5;
  }

  .hp31-founder__tagline {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-color);
    margin-bottom: 24px;
    display: block;
    opacity: 0.6;
  }

  .hp31-founder__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, {{ section.settings.title_size }}px);
    line-height: 1.2;
    color: var(--text-color);
    margin: 0 0 32px;
    font-weight: 400;
  }

  .hp31-founder__title em {
    font-style: italic;
  }

  .hp31-founder__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0 0 40px;
    font-weight: 300;
  }

  .hp31-founder__signature-wrap {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  @media screen and (max-width: 992px) {
    .hp31-founder__signature-wrap {
      align-items: center;
    }
  }

  .hp31-founder__signature {
    font-family: var(--font-script);
    font-size: 36px;
    color: var(--text-color);
    line-height: 1;
    margin: 0;
  }

  .hp31-founder__name {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-color);
    opacity: 0.5;
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp31-founder-wrapper" id="HP31Founder-{{ section.id }}">
  <div class="hp31-founder__image-col">
    <div class="hp31-founder__image-wrap">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 600 }}" alt="{{ section.settings.name | escape }}" class="hp31-founder__image" loading="lazy">
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'hp31-founder__image' }}
      {%- endif -%}
    </div>
  </div>

  <div class="hp31-founder__content-col">
    {%- if section.settings.tagline != blank -%}
      <span class="hp31-founder__tagline">{{ section.settings.tagline }}</span>
    {%- endif -%}
    
    <h2 class="hp31-founder__title">{{ section.settings.title }}</h2>
    
    <div class="hp31-founder__text">
      {{ section.settings.text }}
    </div>

    <div class="hp31-founder__signature-wrap">
      <p class="hp31-founder__signature">{{ section.settings.name }}</p>
      <p class="hp31-founder__name">{{ section.settings.name }} &mdash; Founder</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP31 - Zen Founder Note",
  "class": "section-hp31-founder-note",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder Image"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "A Note From The Founder"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Cultivating <em>stillness</em>."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>I started this project with a simple intention: to create objects that encourage us to slow down. In a world of constant noise, we hope these pieces bring a sense of quiet and comfort into your daily rituals.</p>"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Founder Name",
      "default": "Eleanor Vance"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Zen Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Beige)",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#2C2C2C"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP31 - Zen Founder Note"
    }
  ]
}
{% endschema %}
