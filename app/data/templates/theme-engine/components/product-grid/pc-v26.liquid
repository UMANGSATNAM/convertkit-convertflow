{%- comment -%}
  PC V26 — FUTURISTIC HOLOGRAPHIC VAPORWAVE PRODUCT GRID
  Design: Midnight Neon (#0D0614), Electric Cyan (#00F0FF) & Magenta (#D946EF) gradient accents, Orbitron & Lexend typography
  Card Shape: 12px corners, holographic gradient borders, neon cyber glow
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&family=Orbitron:wght@600;800;900&display=swap');

  .pcv26 {
    --bg: {{ section.settings.bg_color | default: '#0D0614' }};
    --card-bg: {{ section.settings.card_bg | default: '#170C24' }};
    --text: {{ section.settings.text_color | default: '#F3E8FF' }};
    --muted: {{ section.settings.muted_color | default: '#A855F7' }};
    --accent: {{ section.settings.accent_color | default: '#00F0FF' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#D946EF' }};
    --border: {{ section.settings.border_color | default: '#3B0764' }};
    --badge-sale-bg: #D946EF;
    --badge-sale-text: #FFFFFF;
    --f-heading: 'Orbitron', sans-serif;
    --f-body: 'Lexend', sans-serif;
    --r-card: 12px;
    --ease: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv26 *, .pcv26 *::before, .pcv26 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv26 a { color: inherit; text-decoration: none; }
  .pcv26 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv26 img { max-width: 100%; display: block; }

  .pcv26__wrap { max-width: 1320px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv26__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv26__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv26__title { font-family: var(--f-heading); font-size: 28px; font-weight: 800; color: #FFFFFF; text-shadow: 0 0 12px rgba(0, 240, 255, 0.6); letter-spacing: 0.05em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv26__title { font-size: 38px; } }
  .pcv26__sub { font-size: 15px; color: var(--muted); }
  .pcv26__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 12px; font-family: var(--f-heading); text-transform: uppercase; letter-spacing: 0.1em; color: #00F0FF; background: rgba(0, 240, 255, 0.1); border: 1px solid #00F0FF; padding: 8px 20px; border-radius: 20px; box-shadow: 0 0 15px rgba(0, 240, 255, 0.3); transition: var(--ease); }
  .pcv26__viewall:hover { background: #00F0FF; color: #0D0614; box-shadow: 0 0 25px rgba(0, 240, 255, 0.6); }

  /* GRID */
  .pcv26__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv26__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv26__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv26__card {
    background: var(--card-bg);
    border: 1px solid rgba(0, 240, 255, 0.2);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 8px 20px -5px rgba(217, 70, 239, 0.15);
    transition: var(--ease);
  }
  .pcv26__card:hover {
    transform: translateY(-5px);
    border-color: #00F0FF;
    box-shadow: 0 12px 30px rgba(0, 240, 255, 0.3), 0 0 15px rgba(217, 70, 239, 0.3);
  }

  /* IMAGE CONTAINER */
  .pcv26__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #050209;
    overflow: hidden;
  }
  .pcv26__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pcv26__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv26__card:hover .pcv26__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.06);
    {% endif %}
  }
  .pcv26__card:hover .pcv26__img--sec { opacity: 1; transform: scale(1.06); }

  /* BADGES */
  .pcv26__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv26__badge { font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 4px 10px; border-radius: 12px; letter-spacing: 0.05em; font-family: var(--f-heading); }
  .pcv26__badge--sale { background: linear-gradient(135deg, #D946EF, #8B5CF6); color: #FFFFFF; }
  .pcv26__badge--tag { background: linear-gradient(135deg, #00F0FF, #3B82F6); color: #0D0614; }
  .pcv26__badge--sold { background: #3B0764; color: #A855F7; }

  /* WISHLIST BUTTON */
  .pcv26__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(13, 6, 20, 0.8);
    border: 1px solid rgba(0, 240, 255, 0.4);
    backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv26__wish:hover { background: #00F0FF; color: #0D0614; box-shadow: 0 0 15px #00F0FF; transform: scale(1.1); }
  .pcv26__wish.active { color: #0D0614; background: #00F0FF; box-shadow: 0 0 15px #00F0FF; }

  /* QUICK ADD HOVER */
  .pcv26__quick-box {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    z-index: 3;
    transform: translateY(12px);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv26__card:hover .pcv26__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv26__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 14px 14px; }
  }

  .pcv26__quick-btn {
    width: 100%;
    padding: 11px 16px;
    background: linear-gradient(135deg, #00F0FF, #D946EF);
    color: #0D0614;
    font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
    font-family: var(--f-heading);
    border-radius: 20px;
    border: none;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
  }
  .pcv26__quick-btn:hover { box-shadow: 0 0 25px rgba(217, 70, 239, 0.7); transform: scale(1.02); }
  .pcv26__quick-btn:disabled { background: #3B0764; color: #A855F7; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv26__content { padding: 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv26__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 700; font-family: var(--f-heading); letter-spacing: 0.1em; }
  .pcv26__item-title { font-family: var(--f-body); font-size: 15px; font-weight: 600; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv26__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; color: var(--accent); font-weight: 700; }
  .pcv26__stars { letter-spacing: 1px; text-shadow: 0 0 8px var(--accent); }
  .pcv26__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 400; }

  /* PRICE */
  .pcv26__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv26__price { font-size: 17px; font-weight: 800; color: #FFFFFF; font-family: var(--f-heading); text-shadow: 0 0 8px rgba(0, 240, 255, 0.4); }
  .pcv26__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv26__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv26__swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv26__swatch:hover, .pcv26__swatch.active { transform: scale(1.25); border-color: var(--accent); box-shadow: 0 0 8px var(--accent); }

  /* URGENCY MICRO */
  .pcv26__urgency { font-size: 11px; color: #D946EF; font-weight: 800; font-family: var(--f-heading); text-transform: uppercase; display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; text-shadow: 0 0 8px #D946EF; }

  /* TOAST */
  .pcv26__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: linear-gradient(135deg, #00F0FF, #D946EF); color: #0D0614;
    padding: 12px 22px; border-radius: 20px;
    font-size: 12px; font-weight: 800; font-family: var(--f-heading); text-transform: uppercase;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 0 25px rgba(0, 240, 255, 0.6);
  }
  .pcv26__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv26">
  <div class="pcv26__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv26__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv26__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv26__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv26__viewall">
            {{ section.settings.view_all_label | default: 'Access Holo Vault' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv26__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v26', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v26', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv26__toast" id="pcv26-toast">HOLO ITEM ADDED</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv26-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv26Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'SYNCING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ SYNCED';
        showT('HOLO ITEM ADDED');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv26-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

