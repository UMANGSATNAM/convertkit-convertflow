{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito:wght@300;400;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Nunito', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp35-feat-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp35-feat-wrapper {
      padding: 0 20px;
    }
  }

  .hp35-feat__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .hp35-feat__subtitle {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 15px;
    font-weight: 600;
  }

  .hp35-feat__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.2;
    color: var(--text-color);
    margin: 0;
    font-weight: 400;
  }
  
  .hp35-feat__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp35-feat__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp35-feat__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 576px) {
    .hp35-feat__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp35-feat__item {
    text-decoration: none;
    display: block;
    group: card;
  }

  .hp35-feat__image-wrap {
    aspect-ratio: 3/4;
    background: #e9e5de;
    position: relative;
    overflow: hidden;
    margin-bottom: 25px;
    border-radius: 120px 120px 0 0; /* Arch shape */
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hp35-feat__item:hover .hp35-feat__image-wrap {
    transform: translateY(-10px);
  }

  .hp35-feat__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .hp35-feat__item:hover .hp35-feat__image {
    transform: scale(1.05);
  }

  .hp35-feat__info {
    text-align: center;
  }

  .hp35-feat__product-title {
    font-family: var(--font-heading);
    font-size: 20px;
    color: var(--text-color);
    margin: 0 0 10px;
    font-weight: 500;
    transition: color 0.3s ease;
  }
  
  .hp35-feat__item:hover .hp35-feat__product-title {
    color: var(--accent-color);
  }

  .hp35-feat__product-price {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--text-color);
    font-weight: 300;
    opacity: 0.8;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp35-feat-wrapper" id="HP35Feat-{{ section.id }}">
  <div class="hp35-feat__header">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp35-feat__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    <h2 class="hp35-feat__title">{{ section.settings.title | replace: 'curated', '<em>curated</em>' }}</h2>
  </div>

  <div class="hp35-feat__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.product_link | default: '#' }}" class="hp35-feat__item" {{ block.shopify_attributes }}>
        <div class="hp35-feat__image-wrap">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" class="hp35-feat__image" loading="lazy">
          {%- else -%}
            {%- assign placeholder = 'product-' | append: forloop.index -%}
            {%- if forloop.index > 6 -%}{%- assign placeholder = 'product-1' -%}{%- endif -%}
            {{ placeholder | placeholder_svg_tag: 'hp35-feat__image' }}
          {%- endif -%}
        </div>
        
        <div class="hp35-feat__info">
          <h3 class="hp35-feat__product-title">{{ block.settings.title }}</h3>
          <div class="hp35-feat__product-price">{{ block.settings.price }}</div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP35 - Organic Featured",
  "class": "section-hp35-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Carefully curated pieces"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C422F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CC7B5E"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Linen Wrap Dress"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$145.00"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP35 - Organic Featured",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
