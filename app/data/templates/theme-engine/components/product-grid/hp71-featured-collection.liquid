{%- style -%}#shopify-section-{{ section.id }}{background:{{section.settings.bg_color|default:'#F0FDFA'}};padding:60px 0}.hp71-fc3{max-width:1280px;margin:0 auto;padding:0 24px}.hp71-h3{text-align:center;font-size:28px;font-weight:800;margin:0 0 6px}.hp71-sub{text-align:center;opacity:.6;margin:0 0 22px}.hp71-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}@media(max-width:800px){.hp71-grid3{grid-template-columns:1fr}}.hp71-card3{border-radius:16px;overflow:hidden;background:#fff;border:1px solid rgba(0,0,0,.06)}.hp71-card3 img{width:100%;aspect-ratio:4/5;object-fit:cover}{%- endstyle -%}<div class="hp71-fc3"><h2 class="hp71-h3">{{section.settings.heading|default:'Best of GROOMING'}}</h2><p class="hp71-sub">{{section.settings.subheading|default:'Curated for grooming'}}</p><div class="hp71-grid3">{% for product in collections[section.settings.collection].products limit:3 %}<a href="{{product.url}}" style="text-decoration:none;color:inherit"><div class="hp71-card3"><img src="{{product.featured_image|image_url:width:600}}" alt="{{product.title|escape}}"><div style="padding:12px"><p style="font-weight:700;margin:0">{{product.title}}</p><p style="color:#0D9488;font-weight:700">{{product.price|money}}</p></div></div></a>{% else %}{% for i in (1..3) %}<div class="hp71-card3"><div style="aspect-ratio:4/5;background:#eee"></div><div style="padding:12px"><p>Sample GROOMING</p></div></div>{% endfor %}{% endfor %}</div></div>{% schema %}{"name":"HP71 Featured Large","settings":[{"type":"text","id":"heading","label":"Heading","default":"Best of GROOMING"},{"type":"text","id":"subheading","label":"Sub","default":"Curated for grooming"},{"type":"collection","id":"collection","label":"Collection"},{"type":"color","id":"bg_color","label":"BG","default":"#F0FDFA"}],"presets":[{"name":"HP71 Featured Large"}]}{% endschema %}