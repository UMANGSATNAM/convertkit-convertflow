{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#09090B' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp61-bs__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp61-bs__header { text-align: center; margin-bottom: 50px; }
  .hp61-bs__eyebrow { font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #EF4444; margin: 0 0 12px; }
  .hp61-bs__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; color: #FFFFFF; margin: 0; }
  .hp61-bs__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr); gap: 20px; }
  .hp61-bs__card {
    background: #18181B; border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: 6px; overflow: hidden; transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .hp61-bs__card:hover { transform: translateY(-6px); border-color: #EF4444; box-shadow: 0 0 25px rgba(239, 68, 68, 0.25); }
  .hp61-bs__img-wrap { aspect-ratio: 3/4; overflow: hidden; background: #27272A; }
  .hp61-bs__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; filter: brightness(0.9) contrast(1.15); }
  .hp61-bs__card:hover .hp61-bs__img { transform: scale(1.06); }
  .hp61-bs__info { padding: 18px 16px; }
  .hp61-bs__name { font-family: 'Syne', sans-serif; font-size: 15px; font-weight: 700; color: #FFFFFF; margin: 0 0 6px; text-decoration: none; display: block; }
  .hp61-bs__price { font-family: 'Space Grotesk', sans-serif; font-size: 15px; font-weight: 700; color: #EF4444; margin: 0; }
  @media screen and (max-width: 992px) { .hp61-bs__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp61-bs__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
{%- endstyle -%}
<div class="hp61-bs__container">
  <div class="hp61-bs__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp61-bs__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp61-bs__heading">{{ section.settings.heading | default: 'Geothermal Bestsellers' }}</h2>
  </div>
  {%- assign collection = collections[section.settings.collection] -%}
  <div class="hp61-bs__grid">
    {%- for product in collection.products limit: section.settings.products_to_show -%}
      <div class="hp61-bs__card">
        <a href="{{ product.url }}" class="hp61-bs__img-wrap">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" class="hp61-bs__img" alt="{{ product.title }}" loading="lazy">{%- endif -%}</a>
        <div class="hp61-bs__info"><a href="{{ product.url }}" class="hp61-bs__name">{{ product.title }}</a><p class="hp61-bs__price">{{ product.price | money }}</p></div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP61 Bestsellers",
  "class": "section-hp61-bs",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#09090B" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌋 CORE THERMAL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Geothermal Bestsellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products", "default": 4 },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP61 Bestsellers" }]
}
{% endschema %}
