{%- comment -%}
  PC V40 — RETRO 80S SYNTHWAVE SUNSET PRODUCT GRID
  Design: Midnight Violet (#1A0B2E), Neon Pink (#FF71CE) & Cyan (#01CDFE) gradient accents, Orbitron typography
  Card Shape: 14px corners, 1px neon pink borders, 80s synthwave retro aesthetic
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&family=Orbitron:wght@600;700;800;900&display=swap');

  .pcv40 {
    --bg: {{ section.settings.bg_color | default: '#1A0B2E' }};
    --card-bg: {{ section.settings.card_bg | default: '#271247' }};
    --text: {{ section.settings.text_color | default: '#F8FAFC' }};
    --muted: {{ section.settings.muted_color | default: '#C084FC' }};
    --accent: {{ section.settings.accent_color | default: '#FF71CE' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#01CDFE' }};
    --border: {{ section.settings.border_color | default: '#FF71CE' }};
    --badge-sale-bg: #FF71CE;
    --badge-sale-text: #1A0B2E;
    --f-heading: 'Orbitron', sans-serif;
    --f-body: 'Lexend', sans-serif;
    --r-card: 14px;
    --ease: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv40 *, .pcv40 *::before, .pcv40 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv40 a { color: inherit; text-decoration: none; }
  .pcv40 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv40 img { max-width: 100%; display: block; }

  .pcv40__wrap { max-width: 1320px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv40__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv40__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv40__title { font-family: var(--f-heading); font-size: 28px; font-weight: 800; color: #FFFFFF; text-shadow: 0 0 12px #FF71CE; letter-spacing: 0.05em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv40__title { font-size: 38px; } }
  .pcv40__sub { font-size: 15px; color: var(--muted); }
  .pcv40__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 12px; font-family: var(--f-heading); text-transform: uppercase; letter-spacing: 0.1em; color: #01CDFE; background: rgba(1, 205, 254, 0.1); border: 1px solid #01CDFE; padding: 8px 20px; border-radius: 20px; box-shadow: 0 0 15px rgba(1, 205, 254, 0.4); transition: var(--ease); }
  .pcv40__viewall:hover { background: #01CDFE; color: #1A0B2E; box-shadow: 0 0 25px rgba(1, 205, 254, 0.7); }

  /* GRID */
  .pcv40__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv40__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv40__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv40__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 0 15px rgba(255, 113, 206, 0.25);
    transition: var(--ease);
  }
  .pcv40__card:hover {
    transform: translateY(-5px);
    border-color: #01CDFE;
    box-shadow: 0 0 25px rgba(1, 205, 254, 0.4), 0 0 15px rgba(255, 113, 206, 0.3);
  }

  /* IMAGE CONTAINER */
  .pcv40__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #10061E;
    overflow: hidden;
  }
  .pcv40__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pcv40__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv40__card:hover .pcv40__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.06);
    {% endif %}
  }
  .pcv40__card:hover .pcv40__img--sec { opacity: 1; transform: scale(1.06); }

  /* BADGES */
  .pcv40__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv40__badge { font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 4px 10px; border-radius: 12px; letter-spacing: 0.05em; font-family: var(--f-heading); }
  .pcv40__badge--sale { background: linear-gradient(135deg, #FF71CE, #01CDFE); color: #1A0B2E; }
  .pcv40__badge--tag { background: #01CDFE; color: #1A0B2E; }
  .pcv40__badge--sold { background: #3B1669; color: #C084FC; }

  /* WISHLIST BUTTON */
  .pcv40__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(26, 11, 46, 0.85);
    border: 1px solid rgba(255, 113, 206, 0.4);
    backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center;
    color: #FF71CE;
    z-index: 3;
    transition: var(--ease);
  }
  .pcv40__wish:hover { background: #FF71CE; color: #1A0B2E; box-shadow: 0 0 15px #FF71CE; transform: scale(1.1); }
  .pcv40__wish.active { color: #1A0B2E; background: #FF71CE; box-shadow: 0 0 15px #FF71CE; }

  /* QUICK ADD HOVER */
  .pcv40__quick-box {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    z-index: 3;
    transform: translateY(12px);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv40__card:hover .pcv40__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv40__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 14px 14px; }
  }

  .pcv40__quick-btn {
    width: 100%;
    padding: 11px 16px;
    background: linear-gradient(135deg, #FF71CE, #01CDFE);
    color: #1A0B2E;
    font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
    font-family: var(--f-heading);
    border-radius: 20px;
    border: none;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
    box-shadow: 0 0 15px rgba(255, 113, 206, 0.4);
  }
  .pcv40__quick-btn:hover { box-shadow: 0 0 25px rgba(1, 205, 254, 0.7); transform: scale(1.02); }
  .pcv40__quick-btn:disabled { background: #3B1669; color: #C084FC; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv40__content { padding: 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv40__vendor { font-size: 10px; text-transform: uppercase; color: #01CDFE; font-weight: 700; font-family: var(--f-heading); letter-spacing: 0.1em; }
  .pcv40__item-title { font-family: var(--f-body); font-size: 15px; font-weight: 600; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv40__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; color: #FF71CE; font-weight: 700; }
  .pcv40__stars { letter-spacing: 1px; text-shadow: 0 0 8px #FF71CE; }
  .pcv40__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 400; }

  /* PRICE */
  .pcv40__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv40__price { font-size: 17px; font-weight: 800; color: #FFFFFF; font-family: var(--f-heading); text-shadow: 0 0 8px rgba(255, 113, 206, 0.4); }
  .pcv40__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv40__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv40__swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv40__swatch:hover, .pcv40__swatch.active { transform: scale(1.25); border-color: var(--accent); box-shadow: 0 0 8px var(--accent); }

  /* URGENCY MICRO */
  .pcv40__urgency { font-size: 11px; color: #FF71CE; font-weight: 800; font-family: var(--f-heading); text-transform: uppercase; display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; text-shadow: 0 0 8px #FF71CE; }

  /* TOAST */
  .pcv40__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: linear-gradient(135deg, #FF71CE, #01CDFE); color: #1A0B2E;
    padding: 12px 22px; border-radius: 20px;
    font-size: 12px; font-weight: 800; font-family: var(--f-heading); text-transform: uppercase;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 0 25px rgba(255, 113, 206, 0.6);
  }
  .pcv40__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv40">
  <div class="pcv40__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv40__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv40__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv40__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv40__viewall">
            {{ section.settings.view_all_label | default: 'Explore Synthwave' }} 🌅 &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv40__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% render 'card-v40', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v40', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv40__toast" id="pcv40-toast">SYNTH ITEM ADDED</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv40-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv40Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'SYNTHESIZING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ ADDED';
        showT('SYNTH ITEM ADDED');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv40-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

