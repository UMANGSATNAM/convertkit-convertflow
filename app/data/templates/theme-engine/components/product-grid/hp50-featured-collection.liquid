{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp50-fc-bg: {{ section.settings.bg_color | default: '#000000' }};
    --hp50-fc-card: {{ section.settings.card_bg | default: '#111111' }};
    --hp50-fc-title: {{ section.settings.title_color | default: '#FFFFFF' }};
    --hp50-silver: {{ section.settings.accent_silver | default: '#E2E8F0' }};
    
    background-color: var(--hp50-fc-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp50-fc__wrapper {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp50-fc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 45px;
  }

  .hp50-fc__heading {
    font-family: 'Italiana', serif;
    font-size: clamp(34px, 4.5vw, 48px);
    font-weight: 400;
    color: var(--hp50-fc-title);
    margin: 0;
    letter-spacing: 1px;
  }

  .hp50-fc__view-all {
    color: var(--hp50-silver);
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hp50-fc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 24px;
  }

  .hp50-card {
    background: var(--hp50-fc-card);
    border: 1px solid rgba(226, 232, 240, 0.2);
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    transition: all 0.3s ease;
  }

  .hp50-card:hover {
    border-color: #FFFFFF;
    transform: translateY(-6px);
  }

  .hp50-card__media {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    position: relative;
    background: #18181B;
  }

  .hp50-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(30%) contrast(1.05);
    transition: transform 0.4s ease;
  }

  .hp50-card:hover .hp50-card__img { transform: scale(1.04); filter: grayscale(0%); }

  .hp50-card__badge {
    position: absolute;
    top: 12px; left: 12px;
    background: #000000;
    color: #FFFFFF;
    border: 1px solid #FFFFFF;
    font-family: 'Syne', sans-serif;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 10px;
  }

  .hp50-card__body {
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .hp50-card__tag {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #94A3B8;
    text-transform: uppercase;
    margin: 0 0 6px;
  }

  .hp50-card__title {
    font-family: 'Italiana', serif;
    font-size: 20px;
    font-weight: 400;
    color: var(--hp50-fc-title);
    margin: 0 0 8px;
    letter-spacing: 0.5px;
  }

  .hp50-card__price {
    font-size: 16px;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 16px;
  }

  .hp50-card__btn {
    width: 100%;
    margin-top: auto;
    padding: 13px;
    background: #FFFFFF;
    color: #000000;
    border: 1px solid #FFFFFF;
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp50-card__btn:hover { background: transparent; color: #FFFFFF; }

  @media screen and (max-width: 992px) {
    .hp50-fc__grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
{%- endstyle -%}

<div class="hp50-fc__wrapper">
  <div class="hp50-fc__header">
    <h2 class="hp50-fc__heading">{{ section.settings.heading | default: 'The Runway Noir Edit' }}</h2>
    <a href="{{ section.settings.view_all_url | default: '/collections/all' }}" class="hp50-fc__view-all">
      {{ section.settings.view_all_text | default: 'Explore Runway Edit →' }}
    </a>
  </div>

  <div class="hp50-fc__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp50-card" {{ block.shopify_attributes }}>
          <div class="hp50-card__media">
            {%- if block.settings.badge != blank -%}
              <span class="hp50-card__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp50-card__img" alt="{{ block.settings.title }}" loading="lazy">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'hp50-card__img' }}
            {%- endif -%}
          </div>
          <div class="hp50-card__body">
            <span class="hp50-card__tag">{{ block.settings.tag | default: 'PLATINUM PEPTIDE' }}</span>
            <h3 class="hp50-card__title">{{ block.settings.title }}</h3>
            <div class="hp50-card__price">{{ block.settings.price | default: '$120.00 USD' }}</div>
            <button class="hp50-card__btn">{{ block.settings.btn_text | default: 'Acquire Formulation' }}</button>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp50-card">
        <div class="hp50-card__media">
          <span class="hp50-card__badge">Runway Hero</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp50-card__img' }}
        </div>
        <div class="hp50-card__body">
          <span class="hp50-card__tag">PLATINUM PEPTIDE</span>
          <h3 class="hp50-card__title">Platinum Contour Vector Elixir</h3>
          <div class="hp50-card__price">$135.00 USD</div>
          <button class="hp50-card__btn">Acquire Formulation</button>
        </div>
      </div>
      <div class="hp50-card">
        <div class="hp50-card__media">
          <span class="hp50-card__badge">Backstage Pass</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp50-card__img' }}
        </div>
        <div class="hp50-card__body">
          <span class="hp50-card__tag">OBSIDIAN MINERAL</span>
          <h3 class="hp50-card__title">Runway Noir Thermal Infusion Crème</h3>
          <div class="hp50-card__price">$120.00 USD</div>
          <button class="hp50-card__btn">Acquire Formulation</button>
        </div>
      </div>
      <div class="hp50-card">
        <div class="hp50-card__media">
          {{ 'product-1' | placeholder_svg_tag: 'hp50-card__img' }}
        </div>
        <div class="hp50-card__body">
          <span class="hp50-card__tag">STERLING SILVER</span>
          <h3 class="hp50-card__title">Sterling Micro-Mist Matte Finisher</h3>
          <div class="hp50-card__price">$85.00 USD</div>
          <button class="hp50-card__btn">Acquire Formulation</button>
        </div>
      </div>
      <div class="hp50-card">
        <div class="hp50-card__media">
          <span class="hp50-card__badge">Limited Edition</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp50-card__img' }}
        </div>
        <div class="hp50-card__body">
          <span class="hp50-card__tag">VOLCANIC CLAY</span>
          <h3 class="hp50-card__title">Obsidian Gloss Peel-Off Mask</h3>
          <div class="hp50-card__price">$95.00 USD</div>
          <button class="hp50-card__btn">Acquire Formulation</button>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP50 - Runway Grid",
  "class": "section-hp50-grid",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#111111" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_silver", "label": "Silver Accent", "default": "#E2E8F0" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Runway Noir Edit" },
    { "type": "text", "id": "view_all_text", "label": "View All Text", "default": "Explore Runway Edit →" },
    { "type": "url", "id": "view_all_url", "label": "View All URL" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Runway Hero" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "PLATINUM PEPTIDE" },
        { "type": "text", "id": "title", "label": "Title", "default": "Platinum Contour Vector Elixir" },
        { "type": "text", "id": "price", "label": "Price", "default": "$135.00 USD" },
        { "type": "text", "id": "btn_text", "label": "Button Label", "default": "Acquire Formulation" },
        { "type": "url", "id": "url", "label": "Product Link" }
      ]
    }
  ],
  "presets": [
    { "name": "HP50 - Runway Grid" }
  ]
}
{% endschema %}
