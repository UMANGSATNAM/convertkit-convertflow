{%- comment -%}
  PC V44 — HIGH-PERFORMANCE CYCLING & VELOCITY PRODUCT GRID
  Design: Carbon Slate (#111827), Velocity Crimson (#E11D48) accents, Barlow Semi Condensed & Archivo typography
  Card Shape: 6px chamfered race corners, skewed speed badges, high-performance cycling vibe
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@600;700&family=Barlow+Semi+Condensed:ital,wght@0,700;0,800;1,700&display=swap');

  .pcv44 {
    --bg: {{ section.settings.bg_color | default: '#111827' }};
    --card-bg: {{ section.settings.card_bg | default: '#1F2937' }};
    --text: {{ section.settings.text_color | default: '#F9FAFB' }};
    --muted: {{ section.settings.muted_color | default: '#9CA3AF' }};
    --accent: {{ section.settings.accent_color | default: '#E11D48' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#BE123C' }};
    --border: {{ section.settings.border_color | default: '#374151' }};
    --badge-sale-bg: #E11D48;
    --badge-sale-text: #FFFFFF;
    --f-heading: 'Barlow Semi Condensed', sans-serif;
    --f-body: 'Archivo', sans-serif;
    --r-card: 6px;
    --ease: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv44 *, .pcv44 *::before, .pcv44 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv44 a { color: inherit; text-decoration: none; }
  .pcv44 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv44 img { max-width: 100%; display: block; }

  .pcv44__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv44__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv44__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv44__title { font-family: var(--f-heading); font-size: 32px; font-weight: 800; color: #FFFFFF; text-transform: uppercase; font-style: italic; letter-spacing: -0.01em; }
  @media (min-width: 768px) { .pcv44__title { font-size: 42px; } }
  .pcv44__sub { font-size: 15px; color: var(--muted); }
  .pcv44__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 800; font-size: 12px; font-family: var(--f-heading); text-transform: uppercase; font-style: italic; letter-spacing: 0.1em; color: #FFFFFF; background: var(--accent); padding: 9px 22px; border-radius: 4px; transform: skewX(-10deg); transition: var(--ease); box-shadow: 0 0 15px rgba(225, 29, 72, 0.4); }
  .pcv44__viewall:hover { background: var(--accent-hover); transform: skewX(-10deg) scale(1.05); }

  /* GRID */
  .pcv44__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv44__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv44__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv44__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.4);
    transition: var(--ease);
  }
  .pcv44__card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 0 20px rgba(225, 29, 72, 0.4);
  }

  /* IMAGE CONTAINER */
  .pcv44__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #0B0F19;
    overflow: hidden;
  }
  .pcv44__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .pcv44__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv44__card:hover .pcv44__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.06);
    {% endif %}
  }
  .pcv44__card:hover .pcv44__img--sec { opacity: 1; transform: scale(1.06); }

  /* BADGES */
  .pcv44__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv44__badge { font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 4px 10px; border-radius: 2px; letter-spacing: 0.05em; font-family: var(--f-heading); font-style: italic; transform: skewX(-10deg); }
  .pcv44__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv44__badge--tag { background: #06B6D4; color: #111827; }
  .pcv44__badge--sold { background: #374151; color: #9CA3AF; }

  /* WISHLIST BUTTON */
  .pcv44__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(17, 24, 39, 0.85);
    border: 1px solid var(--border);
    backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv44__wish:hover { background: var(--accent); color: #FFFFFF; border-color: var(--accent); box-shadow: 0 0 12px #E11D48; transform: scale(1.1); }
  .pcv44__wish.active { color: #FFFFFF; background: var(--accent); border-color: var(--accent); box-shadow: 0 0 12px #E11D48; }

  /* QUICK ADD HOVER */
  .pcv44__quick-box { padding: 12px; background: var(--card-bg); border-top: 1px solid var(--border); }
  .pcv44__quick-btn {
    width: 100%;
    padding: 10px 14px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 12px; font-weight: 800; text-transform: uppercase; font-style: italic; letter-spacing: 0.08em;
    font-family: var(--f-heading);
    border-radius: 4px;
    border: none;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
    box-shadow: 0 0 12px rgba(225, 29, 72, 0.3);
  }
  .pcv44__quick-btn:hover { background: var(--accent-hover); box-shadow: 0 0 20px rgba(225, 29, 72, 0.6); }
  .pcv44__quick-btn:disabled { background: #374151; color: #9CA3AF; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv44__content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv44__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 800; font-family: var(--f-heading); font-style: italic; letter-spacing: 0.1em; }
  .pcv44__item-title { font-family: var(--f-heading); font-size: 17px; font-weight: 700; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-transform: uppercase; }

  /* RATING */
  .pcv44__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; color: var(--accent); font-weight: 700; }
  .pcv44__stars { letter-spacing: 1px; }
  .pcv44__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 400; }

  /* PRICE */
  .pcv44__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv44__price { font-size: 18px; font-weight: 800; color: #FFFFFF; font-family: var(--f-heading); font-style: italic; }
  .pcv44__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv44__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv44__swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv44__swatch:hover, .pcv44__swatch.active { transform: scale(1.25); border-color: var(--accent); }

  /* URGENCY MICRO */
  .pcv44__urgency { font-size: 11px; color: var(--accent); font-weight: 800; font-family: var(--f-heading); font-style: italic; text-transform: uppercase; display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv44__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #FFFFFF;
    padding: 12px 22px; border-radius: 4px;
    font-size: 12px; font-weight: 800; font-family: var(--f-heading); font-style: italic; text-transform: uppercase;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 0 20px rgba(225, 29, 72, 0.6);
  }
  .pcv44__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv44">
  <div class="pcv44__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv44__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv44__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv44__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv44__viewall">
            {{ section.settings.view_all_label | default: 'Shop Velocity Gear' }} 🚴 &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv44__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v44', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v44', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv44__toast" id="pcv44-toast">VELOCITY GEAR ADDED!</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv44-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv44Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'SHIFTING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ ADDED';
        showT('VELOCITY GEAR ADDED!');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv44-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

