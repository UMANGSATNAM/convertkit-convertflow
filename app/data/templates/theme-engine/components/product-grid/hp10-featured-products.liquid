{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#8A9A86'
  assign text_color = section.settings.text_color | default: '#F9F6F0'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
  }
  
  .hp10-fp-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    gap: 60px;
    align-items: center;
  }
  
  .hp10-fp-sidebar-{{ section_id }} {
    flex: 0 0 350px;
  }
  
  .hp10-fp-heading-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    margin: 0 0 20px 0;
  }
  
  .hp10-fp-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 40px 0;
    opacity: 0.9;
  }
  
  .hp10-fp-btn-{{ section_id }} {
    display: inline-block;
    padding: 14px 35px;
    background: transparent;
    color: {{ text_color }};
    border: 1px solid {{ text_color }};
    border-radius: 40px;
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  
  .hp10-fp-btn-{{ section_id }}:hover {
    background: {{ text_color }};
    color: {{ bg_color }};
  }
  
  .hp10-fp-slider-{{ section_id }} {
    flex: 1;
    display: flex;
    gap: 30px;
    overflow-x: auto;
    padding-bottom: 20px;
    scroll-snap-type: x mandatory;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  .hp10-fp-slider-{{ section_id }}::-webkit-scrollbar {
    display: none;
  }
  
  .hp10-fp-card-{{ section_id }} {
    flex: 0 0 calc(50% - 15px);
    scroll-snap-align: start;
    background: #F9F6F0;
    border-radius: 24px;
    padding: 15px;
    color: #2A3B2C;
  }
  
  .hp10-fp-card-img-{{ section_id }} {
    width: 100%;
    border-radius: 16px;
    aspect-ratio: 4/5;
    object-fit: cover;
    margin-bottom: 20px;
  }
  
  .hp10-fp-card-title-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: 1.2rem;
    font-weight: 500;
    margin: 0 0 5px 0;
  }
  
  .hp10-fp-card-price-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: rgba(42, 59, 44, 0.7);
  }

  @media (max-width: 992px) {
    .hp10-fp-container-{{ section_id }} {
      flex-direction: column;
    }
    .hp10-fp-sidebar-{{ section_id }} {
      flex: none;
      text-align: center;
    }
    .hp10-fp-card-{{ section_id }} {
      flex: 0 0 calc(70% - 15px);
    }
  }
  
  @media (max-width: 768px) {
    .hp10-fp-card-{{ section_id }} {
      flex: 0 0 85%;
    }
  }
</style>

<div class="hp10-fp-container-{{ section_id }}">
  <div class="hp10-fp-sidebar-{{ section_id }}">
    <h2 class="hp10-fp-heading-{{ section_id }}">{{ section.settings.heading | default: 'New Arrivals' }}</h2>
    <p class="hp10-fp-text-{{ section_id }}">{{ section.settings.text | default: 'Discover the latest additions to our organic family.' }}</p>
    <a href="{{ section.settings.link | default: '#' }}" class="hp10-fp-btn-{{ section_id }}">Shop the Drop</a>
  </div>
  
  <div class="hp10-fp-slider-{{ section_id }}">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank %}
      {% for product in collection.products limit: 4 %}
        <a href="{{ product.url }}" class="hp10-fp-card-{{ section_id }}">
          <img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 600 }}" class="hp10-fp-card-img-{{ section_id }}" alt="{{ product.title }}">
          <h3 class="hp10-fp-card-title-{{ section_id }}">{{ product.title }}</h3>
          <div class="hp10-fp-card-price-{{ section_id }}">{{ product.price | money }}</div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..3) %}
        <div class="hp10-fp-card-{{ section_id }}">
          <div class="hp10-fp-card-img-{{ section_id }}" style="background: #e8e3d5;"></div>
          <h3 class="hp10-fp-card-title-{{ section_id }}">New Product</h3>
          <div class="hp10-fp-card-price-{{ section_id }}">$35.00</div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP10 Featured Products",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#8A9A86"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F9F6F0"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover the latest additions to our organic family."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "HP10 Featured Products"
    }
  ]
}
{% endschema %}
