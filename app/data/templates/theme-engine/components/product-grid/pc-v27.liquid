{%- comment -%}
  PC V27 — BRUTALIST HIGH-FASHION MAGAZINE PRODUCT GRID
  Design: Stark White (#FFFFFF), Pitch Black (#000000) accents, Cabinet Grotesk & Archivo typography
  Card Shape: 0px boxy corners, 3px heavy black borders, high contrast lookbook grid
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Cabinet+Grotesk:wght@700;800;900&display=swap');

  .pcv27 {
    --bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#000000' }};
    --muted: {{ section.settings.muted_color | default: '#666666' }};
    --accent: {{ section.settings.accent_color | default: '#000000' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#222222' }};
    --border: {{ section.settings.border_color | default: '#000000' }};
    --badge-sale-bg: #000000;
    --badge-sale-text: #FFFFFF;
    --f-heading: 'Cabinet Grotesk', sans-serif;
    --f-body: 'Archivo', sans-serif;
    --ease: all 0.2s ease;
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 64 }}px 0 {{ section.settings.padding_bottom | default: 64 }}px 0;
    line-height: 1.3;
    -webkit-font-smoothing: antialiased;
  }

  .pcv27 *, .pcv27 *::before, .pcv27 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv27 a { color: inherit; text-decoration: none; }
  .pcv27 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv27 img { max-width: 100%; display: block; }

  .pcv27__wrap { max-width: 1320px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv27__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 40px; border-bottom: 4px solid var(--border); padding-bottom: 20px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv27__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv27__title { font-family: var(--f-heading); font-size: 36px; font-weight: 900; color: var(--text); letter-spacing: -0.04em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv27__title { font-size: 48px; } }
  .pcv27__sub { font-size: 15px; color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .pcv27__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 900; font-size: 13px; font-family: var(--f-heading); text-transform: uppercase; color: #FFFFFF; background: var(--text); padding: 10px 24px; border: 3px solid var(--text); box-shadow: 4px 4px 0 var(--text); transition: var(--ease); }
  .pcv27__viewall:hover { background: #FFFFFF; color: var(--text); }

  /* GRID */
  .pcv27__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv27__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv27__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv27__card {
    background: var(--card-bg);
    border: 3px solid var(--border);
    border-radius: 0px;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 4px 4px 0 var(--border);
    transition: var(--ease);
  }
  .pcv27__card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 8px 8px 0 var(--border);
  }

  /* IMAGE BOX */
  .pcv27__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '3/4' }};
    background: #F0F0F0;
    overflow: hidden;
    border-bottom: 3px solid var(--border);
  }
  .pcv27__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.3s ease, transform 0.4s ease;
  }
  .pcv27__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv27__card:hover .pcv27__img { filter: grayscale(0%); }
  .pcv27__card:hover .pcv27__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.04);
    {% endif %}
  }
  .pcv27__card:hover .pcv27__img--sec { opacity: 1; transform: scale(1.04); }

  /* BADGES */
  .pcv27__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv27__badge { font-size: 11px; font-weight: 900; text-transform: uppercase; padding: 4px 10px; border: 2px solid var(--border); letter-spacing: 0.08em; font-family: var(--f-heading); }
  .pcv27__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv27__badge--tag { background: #FFFFFF; color: #000000; }
  .pcv27__badge--sold { background: #666666; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv27__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 38px; height: 38px;
    background: #FFFFFF;
    border: 3px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    color: var(--text);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv27__wish:hover { background: var(--text); color: #FFFFFF; }
  .pcv27__wish.active { background: var(--text); color: #FFFFFF; }

  /* QUICK ADD BUTTON */
  .pcv27__quick-box { padding: 12px; background: #FFFFFF; border-top: 3px solid var(--border); }
  .pcv27__quick-btn {
    width: 100%;
    padding: 12px 16px;
    background: var(--text);
    color: #FFFFFF;
    font-size: 12px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em;
    font-family: var(--f-heading);
    border: 2px solid var(--border);
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv27__quick-btn:hover { background: #FFFFFF; color: var(--text); }
  .pcv27__quick-btn:disabled { background: #CCCCCC; color: #666666; cursor: not-allowed; border-color: #CCCCCC; }

  /* CARD CONTENT */
  .pcv27__content { padding: 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; }

  .pcv27__vendor { font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 900; letter-spacing: 0.15em; font-family: var(--f-heading); }
  .pcv27__item-title { font-family: var(--f-heading); font-size: 18px; font-weight: 800; color: var(--text); text-transform: uppercase; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv27__rating { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text); font-weight: 900; }
  .pcv27__stars { letter-spacing: 2px; }
  .pcv27__rev-cnt { color: var(--muted); font-size: 11px; }

  /* PRICE */
  .pcv27__price-row { display: flex; align-items: baseline; gap: 10px; margin-top: auto; padding-top: 4px; }
  .pcv27__price { font-size: 18px; font-weight: 900; color: var(--text); font-family: var(--f-heading); }
  .pcv27__cmp-price { font-size: 14px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv27__swatches { display: flex; gap: 6px; align-items: center; margin-top: 4px; }
  .pcv27__swatch { width: 14px; height: 14px; border: 2px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv27__swatch:hover, .pcv27__swatch.active { background: var(--text); }

  /* URGENCY MICRO */
  .pcv27__urgency { font-size: 11px; color: var(--text); font-weight: 900; font-family: var(--f-heading); text-transform: uppercase; display: flex; align-items: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv27__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--text); color: #FFFFFF;
    border: 3px solid var(--border); padding: 14px 24px;
    font-size: 13px; font-weight: 900; text-transform: uppercase; font-family: var(--f-heading);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.2s ease;
    box-shadow: 4px 4px 0 #000;
  }
  .pcv27__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv27">
  <div class="pcv27__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv27__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv27__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv27__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv27__viewall">
            {{ section.settings.view_all_label | default: 'View Lookbook N°1' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv27__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v27', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v27', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv27__toast" id="pcv27-toast">PIECE ACQUIRED</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv27-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv27Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'ACQUIRING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ ACQUIRED';
        showT('PIECE ACQUIRED');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv27-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

