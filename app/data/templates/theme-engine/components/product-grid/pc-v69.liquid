{%- comment -%}
  PC V69 — DARK NEUMORPHIC AUDIO ENGINEER WORKSPACE PRODUCT GRID
  Design: Studio Dark Slate (#141824), Audio Cyan (#38BDF8) & Peak Red (#EF4444) accents, Share Tech Mono typography
  Card Shape: 14px corners, dual neumorphic inset/outset shadows, studio audio console aesthetic
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');

  .pcv69 {
    --bg: {{ section.settings.bg_color | default: '#141824' }};
    --card-bg: {{ section.settings.card_bg | default: '#1A2030' }};
    --text: {{ section.settings.text_color | default: '#F8FAFC' }};
    --muted: {{ section.settings.muted_color | default: '#64748B' }};
    --accent: {{ section.settings.accent_color | default: '#38BDF8' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#0284C7' }};
    --border: {{ section.settings.border_color | default: '#232C42' }};
    --badge-sale-bg: #EF4444;
    --badge-sale-text: #FFFFFF;
    --f-mono: 'Share Tech Mono', monospace;
    --r-card: 14px;
    --ease: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-mono);
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv69 *, .pcv69 *::before, .pcv69 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv69 a { color: inherit; text-decoration: none; }
  .pcv69 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv69 img { max-width: 100%; display: block; }

  .pcv69__wrap { max-width: 1320px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv69__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; border-bottom: 1px solid var(--border); padding-bottom: 16px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv69__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv69__title { font-family: var(--f-mono); font-size: 28px; font-weight: 700; color: var(--accent); letter-spacing: 0.05em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv69__title { font-size: 36px; } }
  .pcv69__sub { font-size: 14px; color: var(--muted); }
  .pcv69__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 12px; font-family: var(--f-mono); text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); background: rgba(56, 189, 248, 0.1); border: 1px solid var(--accent); padding: 8px 20px; border-radius: 20px; transition: var(--ease); }
  .pcv69__viewall:hover { background: var(--accent); color: #141824; }

  /* GRID */
  .pcv69__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv69__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv69__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv69__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 6px 6px 14px #0E111A, -6px -6px 14px #1F273C;
    transition: var(--ease);
  }
  .pcv69__card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 10px 25px -5px rgba(56, 189, 248, 0.25);
  }

  /* IMAGE CONTAINER */
  .pcv69__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #0D1018;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .pcv69__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pcv69__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv69__card:hover .pcv69__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv69__card:hover .pcv69__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv69__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv69__badge { font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; letter-spacing: 0.05em; font-family: var(--f-mono); }
  .pcv69__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv69__badge--tag { background: #38BDF8; color: #141824; }
  .pcv69__badge--sold { background: #232C42; color: #64748B; }

  /* WISHLIST BUTTON */
  .pcv69__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(20, 24, 36, 0.85);
    border: 1px solid var(--border);
    backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv69__wish:hover { background: var(--accent); color: #141824; border-color: var(--accent); transform: scale(1.1); }
  .pcv69__wish.active { color: #141824; background: var(--accent); border-color: var(--accent); }

  /* QUICK ADD HOVER */
  .pcv69__quick-box {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    z-index: 3;
    transform: translateY(12px);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv69__card:hover .pcv69__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv69__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 14px 14px; }
  }

  .pcv69__quick-btn {
    width: 100%;
    padding: 11px 16px;
    background: var(--accent);
    color: #141824;
    font-size: 11px; font-weight: 700; text-transform: uppercase; font-family: var(--f-mono); letter-spacing: 0.1em;
    border-radius: 6px;
    border: none;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
    box-shadow: 0 4px 12px rgba(56, 189, 248, 0.3);
  }
  .pcv69__quick-btn:hover { background: var(--accent-hover); color: #FFFFFF; transform: scale(1.02); }
  .pcv69__quick-btn:disabled { background: #232C42; color: #64748B; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv69__content { padding: 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv69__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 700; letter-spacing: 0.1em; }
  .pcv69__item-title { font-family: var(--f-mono); font-size: 15px; font-weight: 600; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv69__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; color: var(--accent); font-weight: 700; }
  .pcv69__stars { letter-spacing: 1px; text-shadow: 0 0 6px var(--accent); }
  .pcv69__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 400; }

  /* PRICE */
  .pcv69__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv69__price { font-size: 17px; font-weight: 700; color: #FFFFFF; font-family: var(--f-mono); }
  .pcv69__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv69__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv69__swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv69__swatch:hover, .pcv69__swatch.active { transform: scale(1.25); border-color: var(--accent); }

  /* URGENCY MICRO */
  .pcv69__urgency { font-size: 11px; color: #EF4444; font-weight: 700; font-family: var(--f-mono); text-transform: uppercase; display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv69__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #141824;
    padding: 12px 22px; border-radius: 6px;
    font-size: 12px; font-weight: 700; font-family: var(--f-mono); text-transform: uppercase;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pcv69__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv69">
  <div class="pcv69__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv69__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv69__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv69__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv69__viewall">
            {{ section.settings.view_all_label | default: 'Explore Studio Rack' }} 🎛️ &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv69__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v69', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v69', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv69__toast" id="pcv69-toast">STUDIO RACK ADDED</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv69-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv69Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'PATCHING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ ADDED';
        showT('STUDIO RACK ADDED');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv69-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

