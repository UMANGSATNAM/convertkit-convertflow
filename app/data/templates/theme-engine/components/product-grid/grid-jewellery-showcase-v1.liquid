{% comment %}
  ============================================================================
  SECTION — Jewellery & Luxury Showcase Grid v1
  ----------------------------------------------------------------------------
  Conversion-focused luxury product grid with:
    • Clean tokenized palette & typography (no hardcoded colors)
    • Soft rounded cards with elevation + image zoom on hover
    • Star ratings, savings flags, trust highlights
    • Real AJAX add-to-cart via /cart/add.js → dispatches cart:refresh
    • In-place tag filtering · variant color swatches · localStorage wishlist
    • IntersectionObserver scroll reveal · full a11y · reduced-motion safe
  ============================================================================
{% endcomment %}

{%- liquid
  assign sec = section.settings
  assign coll = collections[sec.collection]
  assign count = sec.product_count
  assign uid = section.id
-%}

<section class="rz rz--{{ uid }}" data-section-id="{{ uid }}" aria-labelledby="rz-title-{{ uid }}">
  <div class="rz-inner">

    {%- comment -%} Header {%- endcomment -%}
    <header class="rz-head">
      {% if sec.label != blank %}
        <p class="rz-eyebrow rz-rv">{{ sec.label }}</p>
      {% endif %}
      {% if sec.title != blank %}
        <h2 id="rz-title-{{ uid }}" class="rz-title rz-rv" style="--d:1">{{ sec.title }}</h2>
      {% endif %}
      {% if sec.subtitle != blank %}
        <p class="rz-sub rz-rv" style="--d:2">{{ sec.subtitle }}</p>
      {% endif %}

      {% if sec.enable_filter and sec.filter_tags != blank %}
        {% assign tags = sec.filter_tags | split: ',' %}
        <div class="rz-filter rz-rv" style="--d:3" role="tablist" aria-label="Filter products">
          <button class="rz-chip is-active" data-filter="*" role="tab" aria-selected="true">All</button>
          {% for t in tags %}
            {% assign tag = t | strip %}
            <button class="rz-chip" data-filter="{{ tag | handleize }}" role="tab" aria-selected="false">{{ tag }}</button>
          {% endfor %}
        </div>
      {% endif %}
    </header>

    {%- comment -%} Grid {%- endcomment -%}
    <div class="rz-grid" id="rz-grid-{{ uid }}" style="--grid-cols: {{ sec.columns }};">
      {% if coll != blank and coll.products.size > 0 %}
        {% for product in coll.products limit: count %}

          {%- liquid
            assign on_sale = false
            if product.compare_at_price > product.price
              assign on_sale = true
            endif
            assign tag_handles = ''
            for t in product.tags
              assign tag_handles = tag_handles | append: ' ' | append: t | handleize
            endfor
            assign rating = product.metafields.reviews.rating.value
            assign rating_count = product.metafields.reviews.rating_count.value
          -%}

          <article class="rz-card rz-rv" style="--d:{{ forloop.index }}" data-tags="{{ tag_handles | strip }}">
            <div class="rz-media">
              <a href="{{ product.url }}" class="rz-media-link" aria-label="{{ product.title | escape }}">
                {% if product.featured_media %}
                  <img class="rz-img rz-img--a"
                       src="{{ product.featured_media | image_url: width: 800 }}"
                       srcset="{{ product.featured_media | image_url: width: 400 }} 400w, {{ product.featured_media | image_url: width: 800 }} 800w"
                       sizes="(max-width:768px) 50vw, 25vw"
                       width="800" height="800"
                       alt="{{ product.featured_media.alt | escape | default: product.title }}" loading="lazy">
                  {% if product.media[1] %}
                    <img class="rz-img rz-img--b" src="{{ product.media[1] | image_url: width: 800 }}" width="800" height="800" alt="" aria-hidden="true" loading="lazy">
                  {% endif %}
                {% else %}
                  <div class="rz-ph">{{ 'image' | placeholder_svg_tag: 'rz-placeholder' }}</div>
                {% endif %}
              </a>

              {% if on_sale %}
                {% assign pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                <span class="rz-flag rz-flag--save">{{ pct }}% OFF</span>
              {% elsif product.tags contains 'new' or product.tags contains 'New' %}
                <span class="rz-flag rz-flag--new">New In</span>
              {% endif %}
              {% if product.available == false %}
                <span class="rz-flag rz-flag--sold">Sold Out</span>
              {% endif %}

              <button class="rz-wish" data-wish="{{ product.id }}" aria-label="Save {{ product.title | escape }}" title="Save">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M12 20s-7-4.6-9.3-9C1.2 8 2.6 4.8 5.8 4.4 8 4.1 9.7 5.3 12 8c2.3-2.7 4-3.9 6.2-3.6 3.2.4 4.6 3.6 3.1 6.6C19 15.4 12 20 12 20Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              </button>

              {% if product.available %}
                {% if product.variants.size == 1 %}
                  <button type="button" class="rz-add" data-add="{{ product.variants.first.id }}">
                    <span class="rz-add-txt">Add to Cart</span>
                    <span class="rz-add-done" aria-hidden="true">Added ✓</span>
                    <span class="rz-spin" aria-hidden="true"></span>
                  </button>
                {% else %}
                  <a href="{{ product.url }}" class="rz-add rz-add--opt"><span class="rz-add-txt">Select Options</span></a>
                {% endif %}
              {% else %}
                <a href="{{ product.url }}" class="rz-add rz-add--sold">Notify Me</a>
              {% endif %}
            </div>

            <div class="rz-info">
              {% if rating != blank and sec.show_ratings %}
                <div class="rz-rating" aria-label="Rated {{ rating }} out of 5">
                  <span class="rz-stars" style="--r:{{ rating }}">★★★★★</span>
                  {% if rating_count != blank %}<span class="rz-rcount">({{ rating_count }})</span>{% endif %}
                </div>
              {% endif %}

              <h3 class="rz-name"><a href="{{ product.url }}">{{ product.title }}</a></h3>

              {% for opt in product.options_with_values %}
                {% assign on = opt.name | downcase %}
                {% if on == 'color' or on == 'colour' %}
                  <div class="rz-swatches" aria-label="Colours">
                    {% for value in opt.values limit: 5 %}
                      <span class="rz-sw" style="background: {{ value | downcase | split: ' ' | last }};" title="{{ value }}"></span>
                    {% endfor %}
                  </div>
                {% endif %}
              {% endfor %}

              <div class="rz-price">
                <span class="rz-price-now">{{ product.price | money }}</span>
                {% if on_sale %}
                  <span class="rz-price-was">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>

              {% if sec.trust_line != blank %}
                <p class="rz-trust">{{ sec.trust_line }}</p>
              {% endif %}
            </div>
          </article>

        {% endfor %}

      {% else %}
        {% for i in (1..count) %}
          <article class="rz-card rz-rv" style="--d:{{ forloop.index }}">
            <div class="rz-media"><div class="rz-ph">{{ 'image' | placeholder_svg_tag: 'rz-placeholder' }}</div></div>
            <div class="rz-info">
              <div class="rz-rating"><span class="rz-stars" style="--r:4.5">★★★★★</span><span class="rz-rcount">(128)</span></div>
              <h3 class="rz-name"><a href="#">Signature Curated Piece</a></h3>
              <div class="rz-price"><span class="rz-price-now">$1,250</span><span class="rz-price-was">$1,500</span></div>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>

    {% if sec.view_all_link != blank %}
      <div class="rz-foot">
        <a href="{{ sec.view_all_link }}" class="rz-cta">
          {{ sec.view_all_text | default: 'Explore All Collection' }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

<style>
  .rz--{{ uid }} {
    padding: var(--space-64, 5rem) var(--space-20, 1rem);
    background-color: var(--color-background);
    color: var(--color-text);
  }
  .rz-inner {
    max-width: 1440px;
    margin: 0 auto;
  }
  .rz-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-48, 3rem);
  }
  .rz-eyebrow {
    font-family: var(--font-body-family, sans-serif);
    font-size: var(--font-small, 0.8rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-secondary, var(--color-text));
    margin-bottom: var(--space-12, 0.75rem);
  }
  .rz-title {
    font-family: var(--font-heading-family, serif);
    font-size: var(--font-h2, clamp(1.8rem, 3.5vw, 2.75rem));
    line-height: var(--leading-tight, 1.2);
    color: var(--color-text);
    margin-bottom: var(--space-16, 1rem);
    font-weight: 400;
  }
  .rz-sub {
    font-family: var(--font-body-family, sans-serif);
    font-size: var(--font-body, 1rem);
    line-height: var(--leading-body, 1.6);
    color: var(--color-text-secondary, var(--color-text));
    margin-bottom: var(--space-24, 1.5rem);
  }
  .rz-filter {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-8, 0.5rem);
    margin-top: var(--space-24, 1.5rem);
  }
  .rz-chip {
    padding: var(--space-8, 8px) var(--space-16, 16px);
    border-radius: 100px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-body-family, sans-serif);
    font-size: var(--font-small, 0.85rem);
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .rz-chip.is-active, .rz-chip:hover {
    background: var(--color-text);
    color: var(--color-background);
    border-color: var(--color-text);
  }
  .rz-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-20, 1.25rem);
  }
  @media (min-width: 768px) {
    .rz-grid {
      grid-template-columns: repeat(var(--grid-cols, 4), 1fr);
      gap: var(--space-32, 2rem);
    }
  }
  .rz-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border-radius: var(--card-radius, 12px);
    overflow: hidden;
    border: 1px solid var(--color-border, transparent);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .rz-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px color-mix(in srgb, var(--color-text) 8%, transparent);
  }
  .rz-card.is-hidden {
    display: none !important;
  }
  .rz-media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-background);
  }
  .rz-media-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .rz-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.4s ease;
  }
  .rz-img--b {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .rz-card:hover .rz-img--a {
    transform: scale(1.05);
  }
  .rz-card:hover .rz-img--b {
    opacity: 1;
    transform: scale(1.05);
  }
  .rz-ph, .rz-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
  }
  .rz-flag {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    border-radius: 100px;
    font-family: var(--font-body-family, sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 2;
  }
  .rz-flag--save {
    background: var(--color-accent);
    color: var(--color-background);
  }
  .rz-flag--new {
    background: var(--color-text);
    color: var(--color-background);
  }
  .rz-flag--sold {
    background: color-mix(in srgb, var(--color-text) 80%, transparent);
    color: var(--color-background);
  }
  .rz-wish {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: all 0.2s ease;
  }
  .rz-wish:hover {
    transform: scale(1.08);
  }
  .rz-wish.is-saved {
    border-color: var(--color-accent);
  }
  .rz-wish.is-saved svg path {
    fill: var(--color-accent);
  }
  .rz-add {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    padding: 10px;
    background: var(--color-text);
    color: var(--color-background);
    border: none;
    border-radius: var(--button-radius, 6px);
    font-family: var(--font-body-family, sans-serif);
    font-size: var(--font-small, 0.8rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    z-index: 2;
    transform: translateY(120%);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease, background 0.3s ease;
    text-align: center;
    text-decoration: none;
  }
  .rz-card:hover .rz-add {
    transform: translateY(0);
    opacity: 1;
  }
  .rz-add:hover {
    background: var(--color-accent);
    color: var(--color-background);
  }
  .rz-add--opt:hover {
    background: var(--color-accent);
    color: var(--color-background);
  }
  .rz-add--sold {
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .rz-add-done, .rz-spin {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rz-add-done { opacity: 0; }
  .rz-spin { opacity: 0; }
  .rz-spin::after {
    content: '';
    width: 15px;
    height: 15px;
    border: 2px solid var(--color-background);
    border-top-color: transparent;
    border-radius: 50%;
    animation: rz-rot 0.6s linear infinite;
  }
  @keyframes rz-rot {
    to { transform: rotate(360deg); }
  }
  .rz-add.is-loading .rz-add-txt { opacity: 0; }
  .rz-add.is-loading .rz-spin { opacity: 1; }
  .rz-add.is-done {
    background: var(--color-accent);
    color: var(--color-background);
  }
  .rz-add.is-done .rz-add-txt { opacity: 0; }
  .rz-add.is-done .rz-add-done { opacity: 1; }

  .rz-info {
    padding: var(--space-16, 1rem);
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .rz-rating {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: var(--space-8, 0.5rem);
  }
  .rz-stars {
    position: relative;
    display: inline-block;
    font-size: 0.8rem;
    letter-spacing: 1px;
    color: var(--color-border);
  }
  .rz-stars::before {
    content: '★★★★★';
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--r, 5) / 5 * 100%);
    overflow: hidden;
    /* testimonial-rating */ color: var(--color-accent);
    white-space: nowrap;
  }
  .rz-rcount {
    font-family: var(--font-body-family, sans-serif);
    font-size: 0.72rem;
    color: var(--color-text-secondary, var(--color-text));
  }
  .rz-name {
    font-family: var(--font-heading-family, serif);
    font-size: var(--font-h4, 1.1rem);
    font-weight: 500;
    line-height: 1.35;
    margin-bottom: var(--space-8, 0.5rem);
  }
  .rz-name a {
    color: var(--color-text);
    text-decoration: none;
  }
  .rz-name a:hover {
    color: var(--color-accent);
  }
  .rz-swatches {
    display: flex;
    gap: 6px;
    margin-bottom: var(--space-8, 0.5rem);
  }
  .rz-sw {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
  }
  .rz-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: auto;
  }
  .rz-price-now {
    font-family: var(--font-body-family, sans-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .rz-price-was {
    font-family: var(--font-body-family, sans-serif);
    font-size: 0.85rem;
    color: var(--color-text-secondary, var(--color-text));
    text-decoration: line-through;
  }
  .rz-trust {
    margin-top: var(--space-8, 0.5rem);
    font-family: var(--font-body-family, sans-serif);
    font-size: 0.72rem;
    color: var(--color-text-secondary, var(--color-text));
    font-weight: 500;
  }

  .rz-foot {
    margin-top: var(--space-48, 3rem);
    text-align: center;
  }
  .rz-cta {
    display: inline-flex;
    align-items: center;
    padding: 14px 36px;
    background: var(--color-accent);
    color: var(--color-background);
    text-decoration: none;
    border-radius: 100px;
    font-family: var(--font-body-family, sans-serif);
    font-size: var(--font-small, 0.875rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .rz-cta:hover {
    transform: translateY(-2px);
    opacity: 0.95;
  }

  .rz-rv {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s ease, transform 0.7s ease;
    transition-delay: calc(50ms * var(--d, 0));
  }
  .rz-rv.is-in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .rz-rv, .rz-img, .rz-add, .rz-card, .rz-cta { transition: none !important; }
    .rz-rv { opacity: 1; transform: none; }
    .rz-add { opacity: 1; transform: none; }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('.rz--{{ uid }}');
    if (!root) return;

    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    root.querySelectorAll('.rz-rv').forEach(function (el) { io.observe(el); });

    root.querySelectorAll('.rz-chip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        var f = chip.getAttribute('data-filter');
        root.querySelectorAll('.rz-chip').forEach(function (c) { c.classList.remove('is-active'); c.setAttribute('aria-selected','false'); });
        chip.classList.add('is-active'); chip.setAttribute('aria-selected','true');
        root.querySelectorAll('.rz-card').forEach(function (card) {
          var tags = (card.getAttribute('data-tags') || '');
          card.classList.toggle('is-hidden', !(f === '*' || tags.split(' ').indexOf(f) !== -1));
        });
      });
    });

    var KEY = 'sf_wishlist';
    var saved = JSON.parse(localStorage.getItem(KEY) || '[]');
    root.querySelectorAll('.rz-wish').forEach(function (btn) {
      var id = btn.getAttribute('data-wish');
      if (saved.indexOf(id) !== -1) btn.classList.add('is-saved');
      btn.addEventListener('click', function () {
        var i = saved.indexOf(id);
        if (i === -1) { saved.push(id); btn.classList.add('is-saved'); }
        else { saved.splice(i,1); btn.classList.remove('is-saved'); }
        localStorage.setItem(KEY, JSON.stringify(saved));
      });
    });

    root.querySelectorAll('.rz-add[data-add]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (btn.classList.contains('is-loading')) return;
        var id = btn.getAttribute('data-add');
        btn.classList.add('is-loading');
        fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: [{ id: id, quantity: 1 }] }) })
          .then(function (r) { return r.json(); })
          .then(function () {
            btn.classList.remove('is-loading'); btn.classList.add('is-done');
            document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
            setTimeout(function () { btn.classList.remove('is-done'); }, 1800);
          })
          .catch(function () { btn.classList.remove('is-loading'); });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Luxury Product Showcase",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow label",
      "default": "Curated Selection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Signature Creations"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Thoughtfully designed and certified pieces crafted for everyday elegance and enduring beauty."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_count",
      "min": 4,
      "max": 16,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout & options"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_ratings",
      "label": "Show review ratings",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Trust line under price",
      "default": "✓ Free shipping · 30-day returns"
    },
    {
      "type": "header",
      "content": "Filtering"
    },
    {
      "type": "checkbox",
      "id": "enable_filter",
      "label": "Enable tag filter",
      "default": true
    },
    {
      "type": "text",
      "id": "filter_tags",
      "label": "Filter tags (comma separated)",
      "default": "Rings, Earrings, Necklaces, Bracelets"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "Button text",
      "default": "Explore All Collection"
    }
  ],
  "presets": [
    {
      "name": "Luxury Showcase Grid",
      "category": "Grid"
    }
  ]
}
{% endschema %}
