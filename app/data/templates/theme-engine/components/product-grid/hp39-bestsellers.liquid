{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --card-bg: {{ section.settings.card_bg }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Outfit', sans-serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding: 80px 20px;
    overflow: hidden;
  }

  .hp39-bestsellers-wrapper {
    max-width: 1400px;
    margin: 0 auto;
  }

  .hp39-bs__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 60px;
  }

  @media screen and (max-width: 768px) {
    .hp39-bs__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp39-bs__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
    letter-spacing: -0.5px;
  }

  .hp39-bs__nav {
    display: flex;
    gap: 15px;
  }

  .hp39-bs__nav-btn {
    width: 50px; height: 50px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid rgba(0,0,0,0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text-color);
    box-shadow: 0 10px 20px rgba(0,0,0,0.03);
    transition: all 0.3s ease;
  }

  .hp39-bs__nav-btn:hover {
    background: var(--accent-color);
    color: #fff;
    transform: translateY(-2px);
  }

  .hp39-bs__nav-btn svg {
    width: 24px; height: 24px;
    fill: currentColor;
  }

  .hp39-bs__track {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    padding-bottom: 20px;
  }
  .hp39-bs__track::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .hp39-bs-card {
    flex: 0 0 calc(33.333% - 20px);
    scroll-snap-align: start;
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 40px;
    padding: 20px;
    text-decoration: none;
    box-shadow: 0 20px 40px rgba(0,0,0,0.03);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    display: flex;
    flex-direction: column;
  }

  @media screen and (max-width: 992px) {
    .hp39-bs-card { flex: 0 0 calc(50% - 15px); }
  }
  @media screen and (max-width: 600px) {
    .hp39-bs-card { flex: 0 0 85%; }
  }

  .hp39-bs-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 30px 60px rgba(0,0,0,0.08);
  }

  .hp39-bs-card__image-wrap {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 25px;
    overflow: hidden;
    margin-bottom: 20px;
    background: #f0f0f0;
    position: relative;
  }

  .hp39-bs-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .hp39-bs-card:hover .hp39-bs-card__image {
    transform: scale(1.05);
  }

  .hp39-bs-card__add {
    position: absolute;
    bottom: 15px; right: 15px;
    width: 45px; height: 45px;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-color);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hp39-bs-card__add:hover {
    background: var(--accent-color);
    color: #fff;
    transform: scale(1.1);
  }

  .hp39-bs-card__add svg {
    width: 20px; height: 20px;
    fill: currentColor;
  }

  .hp39-bs-card__info {
    padding: 0 10px 10px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .hp39-bs-card__title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 600;
    color: var(--text-color);
    margin: 0 0 5px;
  }

  .hp39-bs-card__price {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    color: var(--text-color);
    opacity: 0.8;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp39-bestsellers-wrapper" id="HP39Bestsellers-{{ section.id }}">
  <div class="hp39-bs__header">
    <h2 class="hp39-bs__title">{{ section.settings.title }}</h2>
    
    <div class="hp39-bs__nav">
      <button class="hp39-bs__nav-btn" aria-label="Previous" id="hp39-prev-{{ section.id }}">
        <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </button>
      <button class="hp39-bs__nav-btn" aria-label="Next" id="hp39-next-{{ section.id }}">
        <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
      </button>
    </div>
  </div>

  <div class="hp39-bs__track" id="hp39-track-{{ section.id }}">
    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: section.settings.limit -%}
        <a href="{{ product.url }}" class="hp39-bs-card">
          <div class="hp39-bs-card__image-wrap">
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="hp39-bs-card__image" loading="lazy">
            <button class="hp39-bs-card__add" aria-label="Add to cart">
              <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
            </button>
          </div>
          <div class="hp39-bs-card__info">
            <div>
              <h3 class="hp39-bs-card__title">{{ product.title }}</h3>
            </div>
            <div class="hp39-bs-card__price">{{ product.price | money }}</div>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.limit) -%}
        <a href="#" class="hp39-bs-card">
          <div class="hp39-bs-card__image-wrap">
            {{ 'product-' | append: i | placeholder_svg_tag: 'hp39-bs-card__image' }}
            <button class="hp39-bs-card__add" aria-label="Add to cart">
              <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
            </button>
          </div>
          <div class="hp39-bs-card__info">
            <div>
              <h3 class="hp39-bs-card__title">Soft Product {{ i }}</h3>
            </div>
            <div class="hp39-bs-card__price">$99.00</div>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const track = document.getElementById('hp39-track-{{ section.id }}');
    const prevBtn = document.getElementById('hp39-prev-{{ section.id }}');
    const nextBtn = document.getElementById('hp39-next-{{ section.id }}');
    
    if(track && prevBtn && nextBtn) {
      nextBtn.addEventListener('click', () => {
        const itemWidth = track.querySelector('.hp39-bs-card').offsetWidth;
        track.scrollBy({ left: itemWidth + 30, behavior: 'smooth' });
      });
      
      prevBtn.addEventListener('click', () => {
        const itemWidth = track.querySelector('.hp39-bs-card').offsetWidth;
        track.scrollBy({ left: -(itemWidth + 30), behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP39 - Aura Bestsellers",
  "class": "section-hp39-bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Loved by Everyone."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Product Limit",
      "default": 6
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Aura Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#faf9f8"
    },
    {
      "type": "color_background",
      "id": "card_bg",
      "label": "Card Glass Background",
      "default": "rgba(255, 255, 255, 0.7)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D2D2D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#fbc2eb"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP39 - Aura Bestsellers"
    }
  ]
}
{% endschema %}
