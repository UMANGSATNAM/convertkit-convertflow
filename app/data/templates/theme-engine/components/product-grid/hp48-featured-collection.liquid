{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp48-fc-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
    --hp48-fc-card: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --hp48-gold: {{ section.settings.accent_gold | default: '#C59B27' }};
    --hp48-fc-title: {{ section.settings.title_color | default: '#1A1715' }};
    
    background-color: var(--hp48-fc-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp48-fc__wrapper {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp48-fc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 45px;
  }

  .hp48-fc__heading {
    font-family: 'Cinzel', serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 700;
    color: var(--hp48-fc-title);
    margin: 0;
  }

  .hp48-fc__view-all {
    color: var(--hp48-gold);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hp48-fc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 24px;
  }

  .hp48-card {
    background: var(--hp48-fc-card);
    border: 1px solid rgba(197, 155, 39, 0.25);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(26, 23, 21, 0.04);
    transition: all 0.3s ease;
  }

  .hp48-card:hover {
    border-color: var(--hp48-gold);
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(197, 155, 39, 0.15);
  }

  .hp48-card__media {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    position: relative;
    background: #EAE6DF;
  }

  .hp48-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hp48-card:hover .hp48-card__img { transform: scale(1.04); }

  .hp48-card__badge {
    position: absolute;
    top: 12px; left: 12px;
    background: #1A1715;
    color: var(--hp48-gold);
    border: 1px solid var(--hp48-gold);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 4px;
  }

  .hp48-card__body {
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .hp48-card__tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--hp48-gold);
    text-transform: uppercase;
    margin: 0 0 6px;
  }

  .hp48-card__title {
    font-family: 'Cinzel', serif;
    font-size: 17px;
    font-weight: 700;
    color: var(--hp48-fc-title);
    margin: 0 0 8px;
  }

  .hp48-card__price {
    font-size: 16px;
    font-weight: 700;
    color: var(--hp48-gold);
    margin-bottom: 16px;
  }

  .hp48-card__btn {
    width: 100%;
    margin-top: auto;
    padding: 13px;
    background: #1A1715;
    color: #FAF8F5;
    border: 1px solid var(--hp48-gold);
    border-radius: 4px;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp48-card__btn:hover { background: var(--hp48-gold); color: #1A1715; }

  @media screen and (max-width: 992px) {
    .hp48-fc__grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
{%- endstyle -%}

<div class="hp48-fc__wrapper">
  <div class="hp48-fc__header">
    <h2 class="hp48-fc__heading">{{ section.settings.heading | default: 'The Royal Sovereign Collection' }}</h2>
    <a href="{{ section.settings.view_all_url | default: '/collections/all' }}" class="hp48-fc__view-all">
      {{ section.settings.view_all_text | default: 'Explore Sovereign Suite →' }}
    </a>
  </div>

  <div class="hp48-fc__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp48-card" {{ block.shopify_attributes }}>
          <div class="hp48-card__media">
            {%- if block.settings.badge != blank -%}
              <span class="hp48-card__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp48-card__img" alt="{{ block.settings.title }}" loading="lazy">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'hp48-card__img' }}
            {%- endif -%}
          </div>
          <div class="hp48-card__body">
            <span class="hp48-card__tag">{{ block.settings.tag | default: '24K GOLD ELIXIR' }}</span>
            <h3 class="hp48-card__title">{{ block.settings.title }}</h3>
            <div class="hp48-card__price">{{ block.settings.price | default: '$145.00 USD' }}</div>
            <button class="hp48-card__btn">{{ block.settings.btn_text | default: 'Acquire Ritual' }}</button>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp48-card">
        <div class="hp48-card__media">
          <span class="hp48-card__badge">Grand Sovereign</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp48-card__img' }}
        </div>
        <div class="hp48-card__body">
          <span class="hp48-card__tag">24K COLLOIDAL GOLD</span>
          <h3 class="hp48-card__title">Sovereign 24K Gold Cellular Nectar</h3>
          <div class="hp48-card__price">$165.00 USD</div>
          <button class="hp48-card__btn">Acquire Ritual</button>
        </div>
      </div>
      <div class="hp48-card">
        <div class="hp48-card__media">
          <span class="hp48-card__badge">Royal Reserve</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp48-card__img' }}
        </div>
        <div class="hp48-card__body">
          <span class="hp48-card__tag">WHITE TRUFFLE EXTRACT</span>
          <h3 class="hp48-card__title">Champagne Pearl Velvet Crème</h3>
          <div class="hp48-card__price">$145.00 USD</div>
          <button class="hp48-card__btn">Acquire Ritual</button>
        </div>
      </div>
      <div class="hp48-card">
        <div class="hp48-card__media">
          {{ 'product-1' | placeholder_svg_tag: 'hp48-card__img' }}
        </div>
        <div class="hp48-card__body">
          <span class="hp48-card__tag">IMPERIAL PEARL</span>
          <h3 class="hp48-card__title">Imperial Pearl Illuminating Oil</h3>
          <div class="hp48-card__price">$130.00 USD</div>
          <button class="hp48-card__btn">Acquire Ritual</button>
        </div>
      </div>
      <div class="hp48-card">
        <div class="hp48-card__media">
          <span class="hp48-card__badge">Limited Edition</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp48-card__img' }}
        </div>
        <div class="hp48-card__body">
          <span class="hp48-card__tag">FOIL INFUSION</span>
          <h3 class="hp48-card__title">Royal 24K Gold Leaf Thermal Mask</h3>
          <div class="hp48-card__price">$110.00 USD</div>
          <button class="hp48-card__btn">Acquire Ritual</button>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP48 - Royal Grid",
  "class": "section-hp48-grid",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF8F5" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#C59B27" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#1A1715" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Royal Sovereign Collection" },
    { "type": "text", "id": "view_all_text", "label": "View All Text", "default": "Explore Sovereign Suite →" },
    { "type": "url", "id": "view_all_url", "label": "View All URL" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Grand Sovereign" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "24K COLLOIDAL GOLD" },
        { "type": "text", "id": "title", "label": "Title", "default": "Sovereign 24K Gold Cellular Nectar" },
        { "type": "text", "id": "price", "label": "Price", "default": "$165.00 USD" },
        { "type": "text", "id": "btn_text", "label": "Button Label", "default": "Acquire Ritual" },
        { "type": "url", "id": "url", "label": "Product Link" }
      ]
    }
  ],
  "presets": [
    { "name": "HP48 - Royal Grid" }
  ]
}
{% endschema %}
