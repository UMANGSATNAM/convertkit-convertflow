{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: {{ section.settings.border_color }};
    --card-bg: {{ section.settings.card_bg }};
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Jost', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp21-feat-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp21-feat-wrapper {
      padding: 0 20px;
    }
  }

  .hp21-feat__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: {{ section.settings.header_margin }}px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 24px;
  }

  @media screen and (max-width: 768px) {
    .hp21-feat__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }

  .hp21-feat__title-area {
    max-width: 600px;
  }

  .hp21-feat__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    color: var(--text-color);
    margin: 0 0 8px;
    line-height: 1.2;
  }
  
  .hp21-feat__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp21-feat__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 300;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .hp21-feat__view-all {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-color);
    text-decoration: none;
    position: relative;
    padding-bottom: 4px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.3s ease;
  }
  
  .hp21-feat__view-all::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 1px;
    background: var(--text-color);
    transform: scaleX(0.3);
    transform-origin: right;
    transition: transform 0.4s ease;
  }
  
  .hp21-feat__view-all:hover {
    color: var(--accent-color);
  }
  
  .hp21-feat__view-all:hover::after {
    transform: scaleX(1);
    transform-origin: left;
    background: var(--accent-color);
  }

  /* Slider Container */
  .hp21-feat__slider-container {
    position: relative;
    margin-right: -40px; /* Bleed off edge on desktop */
    padding-right: 40px;
  }

  @media screen and (max-width: 768px) {
    .hp21-feat__slider-container {
      margin-right: -20px;
      padding-right: 20px;
    }
  }

  .hp21-feat__slider {
    display: flex;
    gap: {{ section.settings.grid_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    padding-bottom: 40px;
  }
  
  .hp21-feat__slider::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .hp21-feat__product {
    flex: 0 0 calc(100% / {{ section.settings.desktop_columns }} - {{ section.settings.grid_gap | times: section.settings.desktop_columns | minus: section.settings.grid_gap | divided_by: section.settings.desktop_columns | plus: 10 }}px);
    scroll-snap-align: start;
    position: relative;
    group: product;
  }
  
  @media screen and (max-width: 992px) {
    .hp21-feat__product {
      flex: 0 0 calc(100% / {{ section.settings.tablet_columns }} - {{ section.settings.grid_gap | divided_by: 2 }}px);
    }
  }

  @media screen and (max-width: 768px) {
    .hp21-feat__product {
      flex: 0 0 75vw;
    }
  }

  .hp21-feat__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    background: var(--card-bg);
    overflow: hidden;
    margin-bottom: 24px;
    border: 1px solid transparent;
    transition: border-color 0.4s ease;
  }
  
  .hp21-feat__product:hover .hp21-feat__image-wrapper {
    border-color: var(--accent-color);
  }

  .hp21-feat__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.7s ease;
  }
  
  .hp21-feat__image--hover {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }

  .hp21-feat__product:hover .hp21-feat__image--main {
    transform: scale(1.05);
    {% if section.settings.hover_image %}
    opacity: 0;
    {% endif %}
  }

  {% if section.settings.hover_image %}
  .hp21-feat__product:hover .hp21-feat__image--hover {
    opacity: 1;
    transform: scale(1.05);
  }
  {% endif %}

  .hp21-feat__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(4px);
    color: var(--text-color);
    border: 1px solid var(--border-color);
    padding: 6px 12px;
    font-family: var(--font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    z-index: 2;
  }

  .hp21-feat__add-btn {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: rgba(0,0,0,0.8);
    backdrop-filter: blur(8px);
    color: var(--text-color);
    border: none;
    border-top: 1px solid var(--border-color);
    padding: 16px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.3s;
    z-index: 2;
  }
  
  .hp21-feat__product:hover .hp21-feat__add-btn {
    transform: translateY(0);
  }
  
  .hp21-feat__add-btn:hover {
    background: var(--accent-color);
    color: #000;
  }

  .hp21-feat__info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .hp21-feat__product-title {
    font-family: var(--font-heading);
    font-size: {{ section.settings.product_title_size }}px;
    font-weight: 400;
    color: var(--text-color);
    margin: 0 0 8px;
    text-decoration: none;
    display: block;
    line-height: 1.3;
    transition: color 0.3s;
  }
  
  .hp21-feat__product-title:hover {
    color: var(--accent-color);
  }

  .hp21-feat__vendor {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--text-color);
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
  }

  .hp21-feat__price {
    font-family: var(--font-body);
    font-size: {{ section.settings.price_size }}px;
    font-weight: 300;
    color: var(--text-color);
    white-space: nowrap;
  }

  .hp21-feat__price--compare {
    text-decoration: line-through;
    opacity: 0.4;
    font-size: 0.85em;
    margin-right: 8px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp21-feat-wrapper" id="HP21Featured-{{ section.id }}">
  
  <div class="hp21-feat__header">
    <div class="hp21-feat__title-area">
      {%- if section.settings.subtitle != blank -%}
        <p class="hp21-feat__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="hp21-feat__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
    
    {%- if section.settings.view_all_text != blank -%}
      <a href="{{ section.settings.collection.url | default: '#' }}" class="hp21-feat__view-all">
        {{ section.settings.view_all_text | escape }}
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    {%- endif -%}
  </div>

  <div class="hp21-feat__slider-container">
    <div class="hp21-feat__slider">
      {%- assign collection = section.settings.collection -%}
      {%- assign limit = section.settings.product_limit -%}
      
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: limit -%}
          <div class="hp21-feat__product">
            <div class="hp21-feat__image-wrapper">
              {%- if product.compare_at_price > product.price -%}
                <div class="hp21-feat__badge">Sale</div>
              {%- elsif product.tags contains 'New' -%}
                <div class="hp21-feat__badge">New Arrival</div>
              {%- endif -%}

              <a href="{{ product.url }}">
                <img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="hp21-feat__image hp21-feat__image--main" loading="lazy">
                {%- if product.images[1] and section.settings.hover_image -%}
                  <img height="{{ product.images[1].height }}" width="{{ product.images[1].width }}" src="{{ product.images[1] | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="hp21-feat__image hp21-feat__image--hover" loading="lazy">
                {%- endif -%}
              </a>

              <button class="hp21-feat__add-btn">
                Add to Cart
              </button>
            </div>
            
            <div class="hp21-feat__info">
              <div>
                <a href="{{ product.url }}" class="hp21-feat__product-title">{{ product.title }}</a>
                {%- if section.settings.show_vendor -%}
                  <p class="hp21-feat__vendor">{{ product.vendor }}</p>
                {%- endif -%}
              </div>
              <div class="hp21-feat__price">
                {%- if product.compare_at_price > product.price -%}
                  <span class="hp21-feat__price--compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
                <span>{{ product.price | money }}</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Placeholders -->
        {%- for i in (1..5) -%}
          <div class="hp21-feat__product">
            <div class="hp21-feat__image-wrapper">
              {{ 'product-' | append: i | placeholder_svg_tag: 'hp21-feat__image' }}
              <button class="hp21-feat__add-btn">Add to Cart</button>
            </div>
            <div class="hp21-feat__info">
              <div>
                <a href="#" class="hp21-feat__product-title">Luxury Item Title</a>
                {%- if section.settings.show_vendor -%}
                  <p class="hp21-feat__vendor">Maison Brand</p>
                {%- endif -%}
              </div>
              <div class="hp21-feat__price">$250.00</div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

</div>

{% schema %}
{
  "name": "HP21 - Luxury Featured",
  "class": "section-hp21-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "CURATED EXCLUSIVES"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>The <em>Signature</em> Collection</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Product Limit",
      "default": 8
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Link Text",
      "default": "EXPLORE ALL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 60
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Tablet Columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap",
      "default": 32
    },
    {
      "type": "header",
      "content": "Product Cards"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Tall (4:5)" },
        { "value": "9/16", "label": "Story (9:16)" }
      ],
      "default": "3/4"
    },
    {
      "type": "checkbox",
      "id": "hover_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "product_title_size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Product Title Size",
      "default": 18
    },
    {
      "type": "range",
      "id": "price_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Price Size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Luxury Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Image Background (if transparent PNG)",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Hover states)",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "rgba(255, 255, 255, 0.1)"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP21 - Luxury Featured"
    }
  ]
}
{% endschema %}
