{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: "#080B10" }};
    padding: {{ section.settings.padding_top | default: 90 }}px 20px {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp43-fc__header {
    max-width: 1320px;
    margin: 0 auto 50px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    border-bottom: 1px solid {{ section.settings.border_color | default: "#1E293B" }};
    padding-bottom: 20px;
  }

  .hp43-fc__title {
    font-family: 'Orbitron', sans-serif;
    font-size: 32px;
    font-weight: 800;
    color: {{ section.settings.text_color | default: "#F1F5F9" }};
    margin: 0;
    text-transform: uppercase;
  }

  .hp43-fc__link {
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: {{ section.settings.accent_color | default: "#00F0FF" }};
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .hp43-fc__link:hover { color: {{ section.settings.tag_color | default: "#FF0055" }}; }

  .hp43-fc__grid {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr);
    gap: 24px;
  }

  .hp43-product-card {
    background: {{ section.settings.card_bg | default: "#101622" }};
    border: 1px solid {{ section.settings.border_color | default: "#1E293B" }};
    border-radius: 6px;
    overflow: hidden;
    transition: all 0.3s ease;
    position: relative;
  }

  .hp43-product-card:hover {
    border-color: {{ section.settings.accent_color | default: "#00F0FF" }};
    box-shadow: 0 10px 30px {{ section.settings.accent_color | default: "#00F0FF" }}33;
    transform: translateY(-4px);
  }

  .hp43-product-card__tag {
    position: absolute;
    top: 12px;
    left: 12px;
    background: {{ section.settings.tag_color | default: "#FF0055" }};
    color: #FFFFFF;
    font-family: 'Rajdhani', sans-serif;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 3px;
    text-transform: uppercase;
    z-index: 2;
  }

  .hp43-product-card__media {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: {{ section.settings.bg_color | default: "#080B10" }};
    display: block;
  }

  .hp43-product-card__media img,
  .hp43-product-card__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
    display: block;
  }

  .hp43-product-card:hover .hp43-product-card__media img { transform: scale(1.06); }

  .hp43-product-card__info { padding: 20px; }

  .hp43-product-card__name {
    font-family: 'Orbitron', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: {{ section.settings.text_color | default: "#F1F5F9" }};
    margin: 0 0 10px;
    text-transform: uppercase;
    text-decoration: none;
    display: block;
  }

  .hp43-product-card__price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .hp43-product-card__price {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: {{ section.settings.accent_color | default: "#00F0FF" }};
  }

  .hp43-product-card__compare {
    font-size: 14px;
    color: #64748B;
    text-decoration: line-through;
    margin-left: 8px;
  }

  .hp43-product-card__btn {
    width: 100%;
    padding: 12px;
    background: transparent;
    border: 1px solid {{ section.settings.accent_color | default: "#00F0FF" }};
    color: {{ section.settings.accent_color | default: "#00F0FF" }};
    font-family: 'Rajdhani', sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 44px;
  }

  .hp43-product-card__btn:hover {
    background: {{ section.settings.accent_color | default: "#00F0FF" }};
    color: {{ section.settings.bg_color | default: "#080B10" }};
  }
  .hp43-product-card__btn[disabled] { opacity: 0.45; cursor: not-allowed; }

  .hp43-fc__empty {
    grid-column: 1 / -1;
    text-align: center;
    color: {{ section.settings.text_color | default: "#F1F5F9" }};
    opacity: 0.7;
  }

  @media screen and (max-width: 990px) {
    .hp43-fc__grid { grid-template-columns: repeat(2, 1fr); }
    .hp43-fc__header { flex-direction: column; align-items: flex-start; margin-bottom: 30px; }
    .hp43-fc__title { font-size: 24px; }
  }

  @media screen and (max-width: 580px) {
    .hp43-fc__grid { grid-template-columns: repeat({{ section.settings.columns_mobile | default: 1 }}, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp43-product-card, .hp43-product-card__media img { transition: none; }
    .hp43-product-card:hover { transform: none; }
    .hp43-product-card:hover .hp43-product-card__media img { transform: none; }
  }
{%- endstyle -%}

{%- liquid
  assign fc_collection = collections[section.settings.collection]
  assign fc_limit = section.settings.products_count | default: 4
-%}

<div class="hp43-fc__header">
  {%- if section.settings.heading != blank -%}
    <h2 class="hp43-fc__title">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.link_label != blank -%}
    <a href="{{ fc_collection.url | default: routes.all_products_collection_url }}" class="hp43-fc__link">
      {{ section.settings.link_label }} &rarr;
    </a>
  {%- endif -%}
</div>

<div class="hp43-fc__grid">
  {%- if fc_collection.products.size > 0 -%}
    {%- for product in fc_collection.products limit: fc_limit -%}
      {%- liquid
        assign fc_variant = product.selected_or_first_available_variant
        assign fc_tag = ''
        if product.available == false
          assign fc_tag = section.settings.sold_out_label | default: 'Sold out'
        elsif fc_variant.compare_at_price > fc_variant.price
          assign fc_tag = section.settings.sale_tag | default: 'Sale'
        endif
      -%}
      <div class="hp43-product-card">
        {%- if fc_tag != blank -%}
          <div class="hp43-product-card__tag">{{ fc_tag }}</div>
        {%- endif -%}

        <a class="hp43-product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
          {%- if product.featured_image -%}
            <img
              src="{{ product.featured_image | image_url: width: 600 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              width="600" height="600" loading="lazy">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </a>

        <div class="hp43-product-card__info">
          <a class="hp43-product-card__name" href="{{ product.url }}">{{ product.title }}</a>
          <div class="hp43-product-card__price-row">
            <div>
              <span class="hp43-product-card__price">{{ fc_variant.price | money }}</span>
              {%- if fc_variant.compare_at_price > fc_variant.price -%}
                <span class="hp43-product-card__compare">{{ fc_variant.compare_at_price | money }}</span>
              {%- endif -%}
            </div>
          </div>

          {%- if product.available -%}
            <form method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ fc_variant.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="hp43-product-card__btn">{{ section.settings.button_label | default: 'Add to cart' }}</button>
            </form>
          {%- else -%}
            <button type="button" class="hp43-product-card__btn" disabled>{{ section.settings.sold_out_label | default: 'Sold out' }}</button>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  {%- else -%}
    <p class="hp43-fc__empty">{{ section.settings.empty_text | default: 'Choose a collection in the section settings to show products here.' }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP43 - Cyber Featured",
  "class": "section-hp43-featured",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Neon gear drops"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "View all link label",
      "default": "View full catalogue"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "sale_tag",
      "label": "Sale badge label",
      "default": "Sale"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Choose a collection in the section settings to show products here."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 90
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#080B10"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#101622"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#F1F5F9"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#00F0FF"
    },
    {
      "type": "color",
      "id": "tag_color",
      "label": "Badge",
      "default": "#FF0055"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#1E293B"
    }
  ],
  "presets": [
    {
      "name": "HP43 - Cyber Featured Drop"
    }
  ]
}
{% endschema %}
