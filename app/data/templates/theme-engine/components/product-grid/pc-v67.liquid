{%- comment -%}
  PC V67 — HAUTE COUTURE LEATHERCRAFT PRODUCT GRID
  Design: Espresso Dark (#1A110B), Saddle Tan (#C87D55) & Vintage Gold (#E2C044) accents, Bodoni Moda & Plus Jakarta Sans typography
  Card Shape: 4px corners, 1px dashed leather-stitched borders, haute couture leathercraft aesthetic
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,600;0,6..96,700;1,6..96,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .pcv67 {
    --bg: {{ section.settings.bg_color | default: '#1A110B' }};
    --card-bg: {{ section.settings.card_bg | default: '#251A12' }};
    --text: {{ section.settings.text_color | default: '#FDFBF7' }};
    --muted: {{ section.settings.muted_color | default: '#C87D55' }};
    --accent: {{ section.settings.accent_color | default: '#E2C044' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#C4A332' }};
    --border: {{ section.settings.border_color | default: '#C87D55' }};
    --badge-sale-bg: #E2C044;
    --badge-sale-text: #1A110B;
    --f-serif: 'Bodoni Moda', serif;
    --f-sans: 'Plus Jakarta Sans', sans-serif;
    --r-card: 4px;
    --ease: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-sans);
    padding: {{ section.settings.padding_top | default: 64 }}px 0 {{ section.settings.padding_bottom | default: 64 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv67 *, .pcv67 *::before, .pcv67 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv67 a { color: inherit; text-decoration: none; }
  .pcv67 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv67 img { max-width: 100%; display: block; }

  .pcv67__wrap { max-width: 1320px; margin: 0 auto; padding: 0 24px; }

  /* HEADER */
  .pcv67__head { display: flex; flex-direction: column; gap: 10px; margin-bottom: 44px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv67__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv67__title { font-family: var(--f-serif); font-size: 32px; font-weight: 600; color: var(--text); letter-spacing: 0.05em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv67__title { font-size: 42px; } }
  .pcv67__sub { font-size: 14px; color: var(--muted); font-style: italic; }
  .pcv67__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--accent); border-bottom: 1px solid var(--accent); padding-bottom: 3px; transition: var(--ease); }
  .pcv67__viewall:hover { color: #FFFFFF; border-color: #FFFFFF; }

  /* GRID */
  .pcv67__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv67__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 28px; }
  }
  @media (min-width: 1024px) {
    .pcv67__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 32px; }
  }

  /* CARD */
  .pcv67__card {
    background: var(--card-bg);
    border: 1px dashed var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.4);
    transition: var(--ease);
  }
  .pcv67__card:hover {
    transform: translateY(-4px);
    border-style: solid;
    border-color: var(--accent);
    box-shadow: 0 12px 30px -5px rgba(226, 192, 68, 0.2);
  }

  /* IMAGE CONTAINER */
  .pcv67__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '4/5' }};
    background: #120B07;
    overflow: hidden;
    border-bottom: 1px dashed var(--border);
  }
  .pcv67__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pcv67__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv67__card:hover .pcv67__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv67__card:hover .pcv67__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv67__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv67__badge { font-size: 9px; font-weight: 600; text-transform: uppercase; padding: 4px 10px; border-radius: 2px; letter-spacing: 0.15em; font-family: var(--f-sans); }
  .pcv67__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv67__badge--tag { background: rgba(200, 125, 85, 0.2); color: #C87D55; border: 1px solid #C87D55; }
  .pcv67__badge--sold { background: #35261C; color: #888888; }

  /* WISHLIST BUTTON */
  .pcv67__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(26, 17, 11, 0.85);
    border: 1px solid rgba(226, 192, 68, 0.4);
    backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv67__wish:hover { background: var(--accent); color: #1A110B; border-color: var(--accent); }
  .pcv67__wish.active { color: #1A110B; background: var(--accent); border-color: var(--accent); }

  /* QUICK ADD HOVER */
  .pcv67__quick-box {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    z-index: 3;
    transform: translateY(100%);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv67__card:hover .pcv67__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv67__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 16px 16px; }
  }

  .pcv67__quick-btn {
    width: 100%;
    padding: 13px 16px;
    background: var(--accent);
    color: #1A110B;
    font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.2em;
    font-family: var(--f-sans);
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv67__quick-btn:hover { background: #FFFFFF; color: #1A110B; }
  .pcv67__quick-btn:disabled { background: #35261C; color: #888888; cursor: not-allowed; }

  /* CARD CONTENT */
  .pcv67__content { padding: 18px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv67__vendor { font-size: 9px; text-transform: uppercase; color: var(--accent); font-weight: 500; letter-spacing: 0.25em; }
  .pcv67__item-title { font-family: var(--f-serif); font-size: 18px; font-weight: 600; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv67__rating { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; color: var(--accent); }
  .pcv67__stars { letter-spacing: 2px; text-shadow: 0 0 6px rgba(226, 192, 68, 0.4); }
  .pcv67__rev-cnt { color: #888888; font-size: 11px; }

  /* PRICE */
  .pcv67__price-row { display: flex; align-items: baseline; justify-content: center; gap: 10px; margin-top: auto; padding-top: 4px; }
  .pcv67__price { font-size: 17px; font-weight: 500; color: var(--text); font-family: var(--f-sans); letter-spacing: 0.05em; }
  .pcv67__cmp-price { font-size: 13px; color: #888888; text-decoration: line-through; }

  /* SWATCHES */
  .pcv67__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv67__swatch { width: 12px; height: 12px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv67__swatch:hover, .pcv67__swatch.active { transform: scale(1.25); border-color: var(--accent); box-shadow: 0 0 6px var(--accent); }

  /* URGENCY MICRO */
  .pcv67__urgency { font-size: 11px; color: var(--accent); font-style: italic; font-family: var(--f-serif); display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv67__toast {
    position: fixed; bottom: 24px; right: 24px;
    background: var(--accent); color: #1A110B;
    padding: 14px 24px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.15em;
    font-family: var(--f-sans);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pcv67__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv67">
  <div class="pcv67__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv67__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv67__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv67__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv67__viewall">
            {{ section.settings.view_all_label | default: 'Explore Leather Atelier' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv67__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v67', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v67', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv67__toast" id="pcv67-toast">Leathercraft Acquired</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv67-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv67Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Stitching...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = 'Acquired';
        showT('Leathercraft Acquired');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv67-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

