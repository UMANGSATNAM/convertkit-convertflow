{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    
    --font-heading: 'Space Grotesk', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding: 80px 0; /* Full bleed for scrolling track */
    border-bottom: 4px solid var(--border-color);
    overflow: hidden;
  }

  .hp41-bs-wrapper {
    width: 100%;
  }

  .hp41-bs__header {
    max-width: 1400px;
    margin: 0 auto 50px;
    padding: 0 20px;
  }

  .hp41-bs__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--border-color);
    margin: 0;
    text-transform: uppercase;
    display: inline-block;
    background: #D7FF43;
    padding: 10px 20px;
    border: 4px solid var(--border-color);
    border-radius: 16px;
    box-shadow: 8px 8px 0px var(--border-color);
    transform: rotate(-2deg);
  }

  .hp41-bs__track {
    display: flex;
    gap: 40px;
    padding: 20px 40px 60px; /* Room for shadow */
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .hp41-bs__track::-webkit-scrollbar {
    display: none;
  }

  .hp41-bs-card {
    flex: 0 0 350px;
    scroll-snap-align: center;
    background: #FFF;
    border: 4px solid var(--border-color);
    border-radius: 20px;
    box-shadow: 12px 12px 0px var(--border-color);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all 0.2s ease;
  }
  
  @media screen and (max-width: 768px) {
    .hp41-bs-card {
      flex: 0 0 280px;
    }
  }

  .hp41-bs-card:nth-child(even) {
    transform: rotate(2deg);
  }
  .hp41-bs-card:nth-child(odd) {
    transform: rotate(-2deg);
  }

  .hp41-bs-card:hover {
    transform: rotate(0) translate(-5px, -5px) !important;
    box-shadow: 16px 16px 0px var(--border-color);
  }

  .hp41-bs-card__image-wrap {
    width: 100%;
    aspect-ratio: 1;
    border-bottom: 4px solid var(--border-color);
    background: #F0A8E3;
    border-radius: 16px 16px 0 0;
    overflow: hidden;
  }
  
  .hp41-bs-card:nth-child(3n+1) .hp41-bs-card__image-wrap { background: #38C6F4; }
  .hp41-bs-card:nth-child(3n+2) .hp41-bs-card__image-wrap { background: #FF4911; }

  .hp41-bs-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  .hp41-bs-card__info {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hp41-bs-card__title {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 900;
    color: var(--border-color);
    margin: 0;
    text-transform: uppercase;
  }

  .hp41-bs-card__price {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--border-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp41-bs-wrapper" id="HP41Bestsellers-{{ section.id }}">
  <div class="hp41-bs__header">
    <h2 class="hp41-bs__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp41-bs__track">
    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: section.settings.limit -%}
        <a href="{{ product.url }}" class="hp41-bs-card">
          <div class="hp41-bs-card__image-wrap">
            <img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="hp41-bs-card__image" loading="lazy">
          </div>
          <div class="hp41-bs-card__info">
            <h3 class="hp41-bs-card__title">{{ product.title }}</h3>
            <div class="hp41-bs-card__price">{{ product.price | money_without_trailing_zeros }}</div>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.limit) -%}
        <a href="#" class="hp41-bs-card">
          <div class="hp41-bs-card__image-wrap">
            {{ 'product-' | append: i | placeholder_svg_tag: 'hp41-bs-card__image' }}
          </div>
          <div class="hp41-bs-card__info">
            <h3 class="hp41-bs-card__title">TOP ITEM {{ i }}</h3>
            <div class="hp41-bs-card__price">$45</div>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP41 - Neo Bestsellers",
  "class": "section-hp41-bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "CROWD FAVES"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Product Limit",
      "default": 6
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 60
    },
    {
      "type": "header",
      "content": "Neo Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FDF0D5"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP41 - Neo Bestsellers"
    }
  ]
}
{% endschema %}
