{%- comment -%}
  PC V9 — HAUTE COUTURE LUXURY FASHION PRODUCT GRID
  Design: Noir Black (#0A0A0A), Champagne Gold (#D4AF37) accents, Bodoni Moda & Jost typography
  Card Shape: Ultra-slim gold borders, zero radius, luxury slide-up drawer preview
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,500;0,600;0,700;1,400&family=Jost:wght@300;400;500;600;700&display=swap');

  .pcv9 {
    --bg: {{ section.settings.bg_color | default: '#0A0A0A' }};
    --card-bg: {{ section.settings.card_bg | default: '#121212' }};
    --text: {{ section.settings.text_color | default: '#F5F5F5' }};
    --muted: {{ section.settings.muted_color | default: '#999999' }};
    --accent: {{ section.settings.accent_color | default: '#D4AF37' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#AA8828' }};
    --border: {{ section.settings.border_color | default: 'rgba(212, 175, 55, 0.25)' }};
    --badge-sale-bg: #D4AF37;
    --badge-sale-text: #0A0A0A;
    --f-serif: 'Bodoni Moda', serif;
    --f-sans: 'Jost', sans-serif;
    --ease: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-sans);
    padding: {{ section.settings.padding_top | default: 64 }}px 0 {{ section.settings.padding_bottom | default: 64 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv9 *, .pcv9 *::before, .pcv9 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv9 a { color: inherit; text-decoration: none; }
  .pcv9 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv9 img { max-width: 100%; display: block; }

  .pcv9__wrap { max-width: 1320px; margin: 0 auto; padding: 0 24px; }

  /* HEADER */
  .pcv9__head { display: flex; flex-direction: column; gap: 10px; margin-bottom: 44px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv9__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv9__title { font-family: var(--f-serif); font-size: 32px; font-weight: 500; color: var(--text); letter-spacing: 0.05em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv9__title { font-size: 42px; } }
  .pcv9__sub { font-size: 14px; color: var(--muted); font-weight: 300; letter-spacing: 0.08em; text-transform: uppercase; }
  .pcv9__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--accent); border-bottom: 1px solid var(--accent); padding-bottom: 3px; transition: var(--ease); }
  .pcv9__viewall:hover { color: #FFFFFF; border-color: #FFFFFF; }

  /* GRID */
  .pcv9__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv9__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 28px; }
  }
  @media (min-width: 1024px) {
    .pcv9__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 32px; }
  }

  /* CARD */
  .pcv9__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 0px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--ease);
  }
  .pcv9__card:hover {
    border-color: var(--accent);
    box-shadow: 0 15px 35px -10px rgba(212, 175, 55, 0.2);
  }

  /* IMAGE CONTAINER */
  .pcv9__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '4/5' }};
    background: #050505;
    overflow: hidden;
  }
  .pcv9__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pcv9__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv9__card:hover .pcv9__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.06);
    {% endif %}
  }
  .pcv9__card:hover .pcv9__img--sec { opacity: 1; transform: scale(1.06); }

  /* BADGES */
  .pcv9__badges { position: absolute; top: 14px; left: 14px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv9__badge { font-size: 10px; font-weight: 600; text-transform: uppercase; padding: 4px 10px; letter-spacing: 0.15em; font-family: var(--f-sans); }
  .pcv9__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); font-weight: 700; }
  .pcv9__badge--tag { background: rgba(255, 255, 255, 0.1); color: #FFFFFF; border: 1px solid rgba(255, 255, 255, 0.3); backdrop-filter: blur(6px); }
  .pcv9__badge--sold { background: #333333; color: #888888; }

  /* WISHLIST BUTTON */
  .pcv9__wish {
    position: absolute;
    top: 14px; right: 14px;
    width: 36px; height: 36px;
    background: rgba(10, 10, 10, 0.7);
    border: 1px solid rgba(212, 175, 55, 0.3);
    backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv9__wish:hover { background: var(--accent); color: #0A0A0A; border-color: var(--accent); }
  .pcv9__wish.active { color: var(--accent); border-color: var(--accent); background: rgba(10, 10, 10, 0.9); }

  /* OVERLAY QUICK ADD */
  .pcv9__quick-box {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    z-index: 3;
    transform: translateY(100%);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv9__card:hover .pcv9__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv9__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 16px 16px; }
  }

  .pcv9__quick-btn {
    width: 100%;
    padding: 13px 16px;
    background: var(--accent);
    color: #0A0A0A;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2em;
    font-family: var(--f-sans);
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv9__quick-btn:hover { background: #FFFFFF; color: #0A0A0A; }
  .pcv9__quick-btn:disabled { background: #222222; color: #666666; cursor: not-allowed; }

  /* CARD CONTENT */
  .pcv9__content { padding: 18px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv9__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 600; letter-spacing: 0.2em; }
  .pcv9__item-title { font-family: var(--f-serif); font-size: 17px; font-weight: 500; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pcv9__item-title:hover { color: var(--accent); }

  /* RATING */
  .pcv9__rating { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; color: var(--accent); }
  .pcv9__stars { letter-spacing: 2px; }
  .pcv9__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 300; }

  /* PRICE */
  .pcv9__price-row { display: flex; align-items: baseline; justify-content: center; gap: 10px; margin-top: auto; padding-top: 4px; }
  .pcv9__price { font-size: 16px; font-weight: 600; color: var(--text); font-family: var(--f-sans); letter-spacing: 0.05em; }
  .pcv9__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv9__swatches { display: flex; gap: 8px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv9__swatch { width: 12px; height: 12px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv9__swatch:hover, .pcv9__swatch.active { transform: scale(1.3); border-color: var(--accent); box-shadow: 0 0 6px var(--accent); }

  /* URGENCY MICRO */
  .pcv9__urgency { font-size: 11px; color: var(--accent); font-style: italic; font-family: var(--f-serif); letter-spacing: 0.05em; display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv9__toast {
    position: fixed; bottom: 24px; right: 24px;
    background: var(--accent); color: #0A0A0A;
    padding: 14px 24px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 30px rgba(212, 175, 55, 0.3);
  }
  .pcv9__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv9">
  <div class="pcv9__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv9__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv9__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv9__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv9__viewall">
            {{ section.settings.view_all_label | default: 'Explore Runway' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv9__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v9', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v9', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv9__toast" id="pcv9-toast">Creation Acquired</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv9-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv9Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Acquiring...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = 'Acquired';
        showT('Creation Acquired');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv9-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

