{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --cyan: {{ section.settings.cyan_color }};
    --magenta: {{ section.settings.magenta_color }};
    --green: {{ section.settings.green_color }};
    --font-heading: 'Press Start 2P', cursive;
    --font-body: 'Chakra Petch', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 2px dashed var(--magenta);
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp28-best-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
  }

  @media screen and (max-width: 768px) {
    .hp28-best-wrapper {
      padding: 0 20px;
    }
  }

  .hp28-best__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
    border-bottom: 2px solid var(--text-color);
    padding-bottom: 10px;
  }

  @media screen and (max-width: 768px) {
    .hp28-best__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp28-best__title {
    font-family: var(--font-heading);
    font-size: clamp(20px, 3vw, {{ section.settings.title_size }}px);
    color: var(--magenta);
    text-shadow: 2px 2px 0 var(--cyan);
    margin: 0;
    line-height: 1.2;
    text-transform: uppercase;
  }

  /* Blinking Arrows */
  .hp28-best__arrows {
    font-family: var(--font-heading);
    color: var(--green);
    font-size: 16px;
    animation: blinkArrows 1s step-end infinite;
  }

  @keyframes blinkArrows {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .hp28-best__carousel {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
    gap: 30px;
    padding-bottom: 40px; /* space for drop shadows */
    margin-bottom: -40px; /* offset padding */
  }

  .hp28-best__carousel::-webkit-scrollbar {
    display: none;
  }

  .hp28-best__item {
    flex: 0 0 calc({{ 100.0 | divided_by: section.settings.columns_desktop }}% - 30px);
    scroll-snap-align: start;
    background: #000;
    border: 2px solid var(--cyan);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  @media screen and (max-width: 992px) {
    .hp28-best__item {
      flex: 0 0 calc(50% - 15px);
    }
  }

  @media screen and (max-width: 768px) {
    .hp28-best__item {
      flex: 0 0 85%;
    }
  }

  .hp28-best__item:hover {
    transform: translate(-5px, -5px);
    box-shadow: 10px 10px 0 var(--magenta);
  }

  .hp28-best__image-wrapper {
    position: relative;
    aspect-ratio: {{ section.settings.image_ratio }};
    border-bottom: 2px solid var(--cyan);
    background: #111;
    overflow: hidden;
  }

  .hp28-best__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* High contrast Y2K look */
    filter: saturate(120%) contrast(1.1);
  }

  .hp28-best__badge {
    position: absolute;
    top: 10px; right: -10px;
    background: var(--magenta);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 10px;
    padding: 6px 12px;
    text-transform: uppercase;
    box-shadow: -4px 4px 0 var(--cyan);
    z-index: 2;
  }

  .hp28-best__content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    text-align: left;
  }

  .hp28-best__product-title {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hp28-best__product-price {
    font-family: var(--font-heading);
    font-size: 14px;
    color: var(--cyan);
    margin: 0 0 20px;
  }

  .hp28-best__btn {
    margin-top: auto;
    background: transparent;
    border: 2px solid var(--text-color);
    color: var(--text-color);
    padding: 12px 0;
    font-family: var(--font-heading);
    font-size: 10px;
    text-align: center;
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }

  .hp28-best__item:hover .hp28-best__btn {
    background: var(--text-color);
    color: #000;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-best-wrapper" id="HP28Best-{{ section.id }}">
  
  <div class="hp28-best__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp28-best__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    <div class="hp28-best__arrows">>>> >>> >>></div>
  </div>

  <div class="hp28-best__carousel">
    {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        <a href="{{ product.url }}" class="hp28-best__item">
          
          <div class="hp28-best__image-wrapper">
            {%- if product.compare_at_price > product.price -%}
              <div class="hp28-best__badge">HOT</div>
            {%- endif -%}
            <img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="hp28-best__image" loading="lazy">
          </div>
          
          <div class="hp28-best__content">
            <h3 class="hp28-best__product-title">{{ product.title }}</h3>
            <div class="hp28-best__product-price">
              {{ product.price | money }}
            </div>
            <div class="hp28-best__btn">ACQUIRE_NOW</div>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.products_to_show) -%}
        <a href="#" class="hp28-best__item">
          <div class="hp28-best__image-wrapper">
            <div class="hp28-best__badge">NEW</div>
            {{ 'product-' | append: i | placeholder_svg_tag: 'hp28-best__image' }}
          </div>
          <div class="hp28-best__content">
            <h3 class="hp28-best__product-title">SIMULATED ENTITY {{ i }}</h3>
            <div class="hp28-best__product-price">$120.00</div>
            <div class="hp28-best__btn">ACQUIRE_NOW</div>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "HP28 - Y2K Bestsellers",
  "class": "section-hp28-bestsellers",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "TOP TIER LOOT"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Products to Show",
      "default": 6
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Vertical (4:5)" }
      ],
      "default": "4/5"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Y2K Cyber Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Deep Purple)",
      "default": "#1C0B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cyan_color",
      "label": "Cyan Accent",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "magenta_color",
      "label": "Magenta Accent",
      "default": "#FF00FF"
    },
    {
      "type": "color",
      "id": "green_color",
      "label": "Acid Green Accent",
      "default": "#39FF14"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP28 - Y2K Bestsellers"
    }
  ]
}
{% endschema %}
