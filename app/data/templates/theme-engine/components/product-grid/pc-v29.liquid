{%- comment -%}
  PC V29 — ULTRA-MINIMAL DARK STEALTH PRODUCT GRID
  Design: Pitch Jet Black (#000000), Pure White (#FFFFFF) accents, Outfit typography
  Card Shape: 6px corners, subtle charcoal borders, ultra-clean stealth layout
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap');

  .pcv29 {
    --bg: {{ section.settings.bg_color | default: '#000000' }};
    --card-bg: {{ section.settings.card_bg | default: '#121212' }};
    --text: {{ section.settings.text_color | default: '#FFFFFF' }};
    --muted: {{ section.settings.muted_color | default: '#888888' }};
    --accent: {{ section.settings.accent_color | default: '#FFFFFF' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#DDDDDD' }};
    --border: {{ section.settings.border_color | default: '#262626' }};
    --badge-sale-bg: #FFFFFF;
    --badge-sale-text: #000000;
    --f-main: 'Outfit', sans-serif;
    --r-card: 6px;
    --ease: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-main);
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv29 *, .pcv29 *::before, .pcv29 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv29 a { color: inherit; text-decoration: none; }
  .pcv29 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv29 img { max-width: 100%; display: block; }

  .pcv29__wrap { max-width: 1320px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv29__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv29__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv29__title { font-size: 32px; font-weight: 800; color: var(--text); letter-spacing: -0.02em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv29__title { font-size: 42px; } }
  .pcv29__sub { font-size: 15px; color: var(--muted); }
  .pcv29__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--text); border: 1px solid var(--border); padding: 9px 20px; border-radius: 4px; transition: var(--ease); }
  .pcv29__viewall:hover { background: #FFFFFF; color: #000000; }

  /* GRID */
  .pcv29__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv29__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv29__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv29__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--ease);
  }
  .pcv29__card:hover {
    background: #1A1A1A;
    border-color: #444444;
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
  }

  /* IMAGE CONTAINER */
  .pcv29__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #080808;
    overflow: hidden;
  }
  .pcv29__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pcv29__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv29__card:hover .pcv29__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv29__card:hover .pcv29__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv29__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv29__badge { font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; letter-spacing: 0.08em; }
  .pcv29__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv29__badge--tag { background: #262626; color: #FFFFFF; border: 1px solid #444444; }
  .pcv29__badge--sold { background: #444444; color: #888888; }

  /* WISHLIST BUTTON */
  .pcv29__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 4px;
    background: rgba(18, 18, 18, 0.8);
    border: 1px solid var(--border);
    backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv29__wish:hover { background: #FFFFFF; color: #000000; border-color: #FFFFFF; }
  .pcv29__wish.active { color: #000000; background: #FFFFFF; border-color: #FFFFFF; }

  /* QUICK ADD HOVER */
  .pcv29__quick-box {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    z-index: 3;
    transform: translateY(100%);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv29__card:hover .pcv29__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv29__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 14px 14px; }
  }

  .pcv29__quick-btn {
    width: 100%;
    padding: 11px 16px;
    background: #FFFFFF;
    color: #000000;
    font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
    border-radius: 4px;
    border: none;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv29__quick-btn:hover { background: #DDDDDD; }
  .pcv29__quick-btn:disabled { background: #333333; color: #777777; cursor: not-allowed; }

  /* CARD CONTENT */
  .pcv29__content { padding: 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; }

  .pcv29__vendor { font-size: 10px; text-transform: uppercase; color: var(--muted); font-weight: 700; letter-spacing: 0.15em; }
  .pcv29__item-title { font-size: 15px; font-weight: 700; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv29__rating { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #FFFFFF; font-weight: 700; }
  .pcv29__stars { letter-spacing: 1px; }
  .pcv29__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 400; }

  /* PRICE */
  .pcv29__price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv29__price { font-size: 17px; font-weight: 800; color: var(--text); }
  .pcv29__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv29__swatches { display: flex; gap: 6px; align-items: center; margin-top: 4px; }
  .pcv29__swatch { width: 13px; height: 13px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv29__swatch:hover, .pcv29__swatch.active { transform: scale(1.25); border-color: #FFFFFF; }

  /* URGENCY MICRO */
  .pcv29__urgency { font-size: 11px; color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv29__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: #FFFFFF; color: #000000;
    padding: 12px 22px; border-radius: 4px;
    font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pcv29__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv29">
  <div class="pcv29__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv29__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv29__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv29__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv29__viewall">
            {{ section.settings.view_all_label | default: 'View Stealth Vault' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv29__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v29', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v29', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv29__toast" id="pcv29-toast">STEALTH ITEM ADDED</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv29-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv29Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'ADDING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ ADDED';
        showT('STEALTH ITEM ADDED');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv29-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

