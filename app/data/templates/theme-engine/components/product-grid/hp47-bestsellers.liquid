{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp47-bs-bg: {{ section.settings.bg_color | default: '#F5F0EB' }};
    
    background-color: var(--hp47-bs-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp47-bs__wrap {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp47-bs__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp47-bs__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 4.5vw, 44px);
    font-weight: 600;
    color: #382E2B;
    margin: 0 0 8px;
  }

  .hp47-bs__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp47-bs__card {
    background: #FAF7F2;
    border: 1px solid #EAE3DA;
    border-radius: 24px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(56, 46, 43, 0.04);
    transition: all 0.3s ease;
  }

  .hp47-bs__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 45px rgba(56, 46, 43, 0.09);
  }

  .hp47-bs__img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 18px;
    margin-bottom: 20px;
  }

  .hp47-bs__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 700;
    color: #382E2B;
    margin: 0 0 8px;
  }

  .hp47-bs__price {
    font-size: 16px;
    font-weight: 700;
    color: #8C6D58;
    margin-bottom: 18px;
  }

  .hp47-bs__btn {
    width: 100%;
    margin-top: auto;
    padding: 13px;
    background: #382E2B;
    color: #FFFFFF;
    border: none;
    border-radius: 50px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp47-bs__btn:hover { background: #8C6D58; }

  @media screen and (max-width: 992px) {
    .hp47-bs__grid { grid-template-columns: 1fr; max-width: 460px; margin: 0 auto; }
  }
{%- endstyle -%}

<div class="hp47-bs__wrap">
  <div class="hp47-bs__header">
    <h2 class="hp47-bs__heading">{{ section.settings.heading | default: 'Our Most Coveted Linen Rituals' }}</h2>
    <p style="font-size:14px; color:#6E5E58;">{{ section.settings.subheading | default: 'Beloved by minimalist skincare devotees worldwide.' }}</p>
  </div>

  <div class="hp47-bs__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp47-bs__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp47-bs__img" alt="{{ block.settings.title }}" loading="lazy">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'hp47-bs__img' }}
          {%- endif -%}
          <h3 class="hp47-bs__title">{{ block.settings.title }}</h3>
          <div class="hp47-bs__price">{{ block.settings.price | default: '$58.00 USD' }}</div>
          <button class="hp47-bs__btn">{{ block.settings.btn_text | default: 'Acquire Ritual' }}</button>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp47-bs__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp47-bs__img' }}
        <h3 class="hp47-bs__title">Nordic Oat &amp; Flax Barrier Balm</h3>
        <div class="hp47-bs__price">$58.00 USD</div>
        <button class="hp47-bs__btn">Acquire Ritual</button>
      </div>
      <div class="hp47-bs__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp47-bs__img' }}
        <h3 class="hp47-bs__title">Pristine Birch Sap Essence</h3>
        <div class="hp47-bs__price">$48.00 USD</div>
        <button class="hp47-bs__btn">Acquire Ritual</button>
      </div>
      <div class="hp47-bs__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp47-bs__img' }}
        <h3 class="hp47-bs__title">Warm Taupe Cashmere Cream</h3>
        <div class="hp47-bs__price">$64.00 USD</div>
        <button class="hp47-bs__btn">Acquire Ritual</button>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP47 - Taupe Best",
  "class": "section-hp47-bestsellers",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F0EB" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Most Coveted Linen Rituals" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Beloved by minimalist skincare devotees worldwide." },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Nordic Oat & Flax Barrier Balm" },
        { "type": "text", "id": "price", "label": "Price", "default": "$58.00 USD" },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Acquire Ritual" },
        { "type": "url", "id": "url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    { "name": "HP47 - Taupe Best" }
  ]
}
{% endschema %}
