{%- comment -%}
  Component: grid-luxury-jewellery-v1
  Family: Luxury | Style: luxury
  Archetypes: luxury, premium
  v2.0 — StoreForge Component Library
{%- endcomment -%}
<section class="featured-collection featured-collection--jewellery" style="padding: var(--space-64) 0; background-color: var(--color-background);">
  <div class="container">
    
    <header class="section-header text-center" style="margin-bottom: var(--space-40);">
      <h2 class="section-title" style="font-family: var(--font-heading-family); font-size: 2.2rem; font-weight: 400; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: var(--space-8);">
        {{ section.settings.title | escape }}
      </h2>
      <div style="width: 60px; height: 1px; background-color: var(--color-accent); margin: 0 auto;"></div>
    </header>

    {%- liquid
      assign collection_obj = collections[section.settings.collection]
      assign limit = section.settings.products_to_show
      assign cols = section.settings.columns_desktop
    -%}

    <div class="grid grid-cols-1 grid-cols-md-2 grid-cols-lg-{{ cols }}" style="--grid-spacing: var(--space-32);">
      {%- if collection_obj != blank and collection_obj.products_count > 0 -%}
        {%- for product in collection_obj.products limit: limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback empty state for editor convenience -->
        {%- for i in (1..limit) -%}
          <div class="product-card product-card--jewellery text-center product-card--placeholder">
            <div style="aspect-ratio: 1; background-color: var(--color-surface); margin-bottom: var(--space-12); display: flex; align-items: center; justify-content: center;">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <h3 class="product-card-title" style="font-family: var(--font-heading-family); font-size: 1.1rem; margin-bottom: var(--space-4);">
              Jewelry Item {{ i }}
            </h3>
            <div class="price-container">
              <span class="price-item price-item--regular">$199.00</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns Desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor name",
      "default": false
    }
  ]
}
{% endschema %}
