{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp53-bs-bg: {{ section.settings.bg_color | default: '#F5EDE3' }};

    background-color: var(--hp53-bs-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp53-bs__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp53-bs__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp53-bs__eyebrow {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#C2703E' }};
    margin: 0 0 12px;
  }

  .hp53-bs__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#5C3D2E' }};
    margin: 0;
  }

  .hp53-bs__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr);
    gap: 24px;
  }

  .hp53-bs__card {
    background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border: 1px solid {{ section.settings.border_color | default: '#E8D5C0' }};
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .hp53-bs__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(92, 61, 46, 0.12);
  }

  .hp53-bs__img-wrap {
    aspect-ratio: 3/4;
    overflow: hidden;
    background: #E8D5C0;
  }

  .hp53-bs__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .hp53-bs__card:hover .hp53-bs__img {
    transform: scale(1.06);
  }

  .hp53-bs__info {
    padding: 18px 16px;
  }

  .hp53-bs__name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#5C3D2E' }};
    margin: 0 0 6px;
    text-decoration: none;
    display: block;
  }

  .hp53-bs__price {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: {{ section.settings.accent_color | default: '#C2703E' }};
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp53-bs__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media screen and (max-width: 480px) {
    .hp53-bs__grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  }
{%- endstyle -%}

<div class="hp53-bs__container">
  <div class="hp53-bs__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hp53-bs__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="hp53-bs__heading">{{ section.settings.heading | default: 'Bestselling Elixirs' }}</h2>
  </div>

  {%- assign collection = collections[section.settings.collection] -%}
  <div class="hp53-bs__grid">
    {%- assign limit = section.settings.products_to_show | default: 4 -%}
    {%- for product in collection.products limit: limit -%}
      <div class="hp53-bs__card">
        <a href="{{ product.url }}" class="hp53-bs__img-wrap">
          {%- if product.featured_image != blank -%}
            <img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 600 }}" class="hp53-bs__img" alt="{{ product.title }}" loading="lazy">
          {%- endif -%}
        </a>
        <div class="hp53-bs__info">
          <a href="{{ product.url }}" class="hp53-bs__name">{{ product.title }}</a>
          <p class="hp53-bs__price">{{ product.price | money }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP53 - Dune Bestsellers",
  "class": "section-hp53-bs",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5EDE3" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E8D5C0" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#5C3D2E" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C2703E" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◈ MOST LOVED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestselling Elixirs" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products", "default": 4 },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP53 - Dune Bestsellers" }]
}
{% endschema %}
