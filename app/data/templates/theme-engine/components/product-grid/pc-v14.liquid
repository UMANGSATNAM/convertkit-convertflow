{%- comment -%}
  PC V14 — RETRO 90S CYBER ARCADE PRODUCT GRID
  Design: Cyber Night (#09090E), Neon Magenta (#FF007F) & Neon Cyan (#00F0FF) accents
  Card Shape: Pixelated boxy borders, Orbitron & Press Start 2P typography
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800;900&family=Press+Start+2P&display=swap');

  .pcv14 {
    --bg: {{ section.settings.bg_color | default: '#09090E' }};
    --card-bg: {{ section.settings.card_bg | default: '#12121A' }};
    --text: {{ section.settings.text_color | default: '#FFFFFF' }};
    --muted: {{ section.settings.muted_color | default: '#8A8A9E' }};
    --accent: {{ section.settings.accent_color | default: '#FF007F' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#D9006C' }};
    --border: {{ section.settings.border_color | default: '#FF007F' }};
    --badge-sale-bg: #FF007F;
    --badge-sale-text: #FFFFFF;
    --f-heading: 'Orbitron', sans-serif;
    --f-pixel: 'Press Start 2P', monospace;
    --ease: all 0.2s cubic-bezier(0, 0, 0.2, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-heading);
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv14 *, .pcv14 *::before, .pcv14 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv14 a { color: inherit; text-decoration: none; }
  .pcv14 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv14 img { max-width: 100%; display: block; }

  .pcv14__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv14__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv14__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv14__title { font-size: 28px; font-weight: 900; color: #00F0FF; text-transform: uppercase; letter-spacing: 0.05em; text-shadow: 0 0 10px rgba(0, 240, 255, 0.5); }
  @media (min-width: 768px) { .pcv14__title { font-size: 38px; } }
  .pcv14__sub { font-size: 14px; color: var(--muted); font-family: var(--f-pixel); font-size: 10px; line-height: 1.6; }
  .pcv14__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 11px; font-family: var(--f-pixel); text-transform: uppercase; color: #09090E; background: #00F0FF; border: 2px solid #00F0FF; padding: 8px 16px; box-shadow: 3px 3px 0 var(--accent); transition: var(--ease); }
  .pcv14__viewall:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 var(--accent); }

  /* GRID */
  .pcv14__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv14__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv14__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv14__card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    border-radius: 0px;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 4px 4px 0 #00F0FF;
    transition: var(--ease);
  }
  .pcv14__card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 #00F0FF;
    border-color: #00F0FF;
  }

  /* IMAGE CONTAINER */
  .pcv14__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #05050A;
    overflow: hidden;
    border-bottom: 2px solid var(--border);
  }
  .pcv14__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .pcv14__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv14__card:hover .pcv14__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv14__card:hover .pcv14__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv14__badges { position: absolute; top: 10px; left: 10px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv14__badge { font-size: 8px; font-weight: 700; text-transform: uppercase; padding: 4px 8px; font-family: var(--f-pixel); border: 1px solid #000000; box-shadow: 2px 2px 0 #000000; }
  .pcv14__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv14__badge--tag { background: #00F0FF; color: #09090E; }
  .pcv14__badge--sold { background: #444455; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv14__wish {
    position: absolute;
    top: 10px; right: 10px;
    width: 34px; height: 34px;
    background: #09090E;
    border: 2px solid var(--border);
    box-shadow: 2px 2px 0 #00F0FF;
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv14__wish:hover { background: var(--accent); color: #FFFFFF; border-color: var(--accent); }
  .pcv14__wish.active { color: var(--accent); border-color: var(--accent); background: #09090E; }

  /* QUICK ADD BUTTON */
  .pcv14__quick-box { padding: 12px; background: var(--card-bg); }
  .pcv14__quick-btn {
    width: 100%;
    padding: 10px 12px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 9px; font-weight: 700; text-transform: uppercase; font-family: var(--f-pixel);
    border: 2px solid #000000;
    box-shadow: 3px 3px 0 #00F0FF;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv14__quick-btn:hover { background: #00F0FF; color: #09090E; box-shadow: 3px 3px 0 var(--accent); transform: translate(-1px, -1px); }
  .pcv14__quick-btn:disabled { background: #333344; color: #777788; box-shadow: none; cursor: not-allowed; }

  /* CARD CONTENT */
  .pcv14__content { padding: 14px 14px 0 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; }

  .pcv14__vendor { font-size: 9px; text-transform: uppercase; color: #00F0FF; font-weight: 700; font-family: var(--f-pixel); }
  .pcv14__item-title { font-size: 14px; font-weight: 700; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv14__rating { display: flex; align-items: center; gap: 6px; font-size: 11px; color: #FF007F; font-weight: 700; }
  .pcv14__stars { letter-spacing: 1px; }
  .pcv14__rev-cnt { color: var(--muted); font-size: 10px; font-family: var(--f-pixel); }

  /* PRICE */
  .pcv14__price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv14__price { font-size: 16px; font-weight: 800; color: var(--text); }
  .pcv14__cmp-price { font-size: 12px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv14__swatches { display: flex; gap: 6px; align-items: center; margin-top: 4px; }
  .pcv14__swatch { width: 12px; height: 12px; border: 1px solid #00F0FF; cursor: pointer; transition: var(--ease); }
  .pcv14__swatch:hover, .pcv14__swatch.active { transform: scale(1.2); box-shadow: 2px 2px 0 var(--accent); }

  /* URGENCY MICRO */
  .pcv14__urgency { font-size: 9px; font-family: var(--f-pixel); color: var(--accent); text-transform: uppercase; display: flex; align-items: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv14__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: #00F0FF; color: #09090E;
    border: 2px solid #000000; box-shadow: 4px 4px 0 var(--accent);
    padding: 12px 20px; font-size: 10px; font-weight: 700; font-family: var(--f-pixel);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.2s ease;
  }
  .pcv14__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv14">
  <div class="pcv14__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv14__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv14__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv14__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv14__viewall">
            {{ section.settings.view_all_label | default: 'PRESS START' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv14__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v14', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v14', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv14__toast" id="pcv14-toast">POWER UP ADDED!</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv14-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv14Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'LOADING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ COIN ACCEPTED';
        showT('POWER UP ADDED!');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv14-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

{% schema %}
