{%- liquid
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ffcc'
  
  assign collection = collections[section.settings.collection]
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp3-bs-bg: {{ bg_color }};
    --hp3-bs-text: {{ text_color }};
    --hp3-bs-accent: {{ accent_color }};
    
    --hp3-bs-pt-desk: {{ padding_top_desktop }}px;
    --hp3-bs-pb-desk: {{ padding_bottom_desktop }}px;
    --hp3-bs-pt-mob: {{ padding_top_mobile }}px;
    --hp3-bs-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp3-tech-bs-{{ section.id }} {
    padding-top: var(--hp3-bs-pt-desk);
    padding-bottom: var(--hp3-bs-pb-desk);
    background-color: var(--hp3-bs-bg);
    color: var(--hp3-bs-text);
    font-family: 'Inter', sans-serif;
    position: relative;
    overflow: hidden;
  }
  
  /* Cyber grid background decoration */
  .hp3-tech-bs-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: 
      linear-gradient(rgba(0, 255, 204, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 255, 204, 0.03) 1px, transparent 1px);
    background-size: 100px 100px;
    pointer-events: none;
    z-index: 1;
  }

  .hp3-bs-inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  .hp3-bs-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 50px;
  }

  .hp3-bs-title {
    font-size: clamp(32px, 5vw, 60px);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -2px;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 15px;
  }
  
  .hp3-bs-title::before {
    content: '';
    display: block;
    width: 20px;
    height: 20px;
    background: var(--hp3-bs-accent);
    box-shadow: 0 0 15px var(--hp3-bs-accent);
  }

  .hp3-bs-controls {
    display: flex;
    gap: 10px;
  }

  .hp3-bs-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.2);
    color: var(--hp3-bs-text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .hp3-bs-btn:hover {
    background: var(--hp3-bs-accent);
    border-color: var(--hp3-bs-accent);
    color: #000;
  }
  .hp3-bs-btn svg {
    width: 20px;
    height: 20px;
  }

  /* Carousel */
  .hp3-bs-track-container {
    overflow: hidden;
    margin: 0 -20px;
    padding: 0 20px 20px 20px; /* shadow room */
  }

  .hp3-bs-track {
    display: flex;
    gap: 30px;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Product Card */
  .hp3-bs-card {
    flex: 0 0 calc(25% - 22.5px); /* 4 items */
    background: #0a0a0a;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    padding: 20px;
    position: relative;
    transition: all 0.3s ease;
  }

  .hp3-bs-card:hover {
    border-color: var(--hp3-bs-accent);
    box-shadow: 0 10px 30px rgba(0, 255, 204, 0.1);
    transform: translateY(-5px);
  }

  /* Rank Badge */
  .hp3-bs-rank {
    position: absolute;
    top: -15px;
    left: 20px;
    background: var(--hp3-bs-accent);
    color: #000;
    font-size: 14px;
    font-weight: 900;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    z-index: 5;
  }

  .hp3-bs-media {
    aspect-ratio: 1/1;
    background: #111;
    border-radius: 8px;
    margin-bottom: 20px;
    overflow: hidden;
    display: block;
  }

  .hp3-bs-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 20px;
    transition: transform 0.5s ease;
  }
  .hp3-bs-card:hover .hp3-bs-img {
    transform: scale(1.1);
  }

  .hp3-bs-info {
    text-align: left;
  }

  .hp3-bs-vendor {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--hp3-bs-accent);
    margin-bottom: 5px;
  }

  .hp3-bs-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--hp3-bs-text);
    text-decoration: none;
    display: block;
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .hp3-bs-price {
    font-size: 16px;
    font-weight: 400;
    color: rgba(255,255,255,0.7);
  }

  @media screen and (max-width: 1200px) {
    .hp3-bs-card { flex: 0 0 calc(33.333% - 20px); }
  }
  @media screen and (max-width: 900px) {
    .hp3-bs-card { flex: 0 0 calc(50% - 15px); }
  }
  @media screen and (max-width: 768px) {
    .hp3-tech-bs-{{ section.id }} {
      padding-top: var(--hp3-bs-pt-mob);
      padding-bottom: var(--hp3-bs-pb-mob);
    }
    .hp3-bs-inner {
      padding: 0 20px;
    }
    .hp3-bs-header {
      margin-bottom: 30px;
    }
    .hp3-bs-title {
      font-size: 24px;
    }
    .hp3-bs-title::before {
      width: 12px; height: 12px;
    }
    .hp3-bs-btn {
      width: 36px; height: 36px;
    }
    /* Allow native scroll on mobile for better UX */
    .hp3-bs-track-container {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none; /* Firefox */
      margin: 0 -20px;
      padding: 20px;
    }
    .hp3-bs-track-container::-webkit-scrollbar { display: none; }
    
    .hp3-bs-track {
      transform: none !important; /* Disable JS transform on mobile */
    }
    .hp3-bs-card { 
      flex: 0 0 250px; 
      scroll-snap-align: start;
    }
  }
</style>

<section class="hp3-tech-bs-{{ section.id }}" aria-label="Bestsellers Carousel">
  <div class="hp3-bs-inner">
    
    <div class="hp3-bs-header">
      <h2 class="hp3-bs-title">{{ section.settings.heading | default: 'TOP RATED' }}</h2>
      <div class="hp3-bs-controls hidden-mobile">
        <button class="hp3-bs-btn prev" aria-label="Previous">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button class="hp3-bs-btn next" aria-label="Next">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>

    <div class="hp3-bs-track-container" id="track-container-{{ section.id }}">
      <div class="hp3-bs-track" id="track-{{ section.id }}">
        
        {%- if collection != blank and collection.products_count > 0 -%}
          {%- for product in collection.products limit: section.settings.product_limit -%}
            <div class="hp3-bs-card">
              <div class="hp3-bs-rank">#{{ forloop.index }}</div>
              
              <a href="{{ product.url }}" class="hp3-bs-media">
                <img src="{{ product.featured_image | image_url: width: 400 }}" 
                     class="hp3-bs-img" 
                     loading="lazy" 
                     alt="{{ product.title | escape }}">
              </a>
              
              <div class="hp3-bs-info">
                <div class="hp3-bs-vendor">{{ product.vendor }}</div>
                <a href="{{ product.url }}" class="hp3-bs-title">{{ product.title }}</a>
                <div class="hp3-bs-price">{{ product.price | money }}</div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..8) -%}
            <div class="hp3-bs-card">
              <div class="hp3-bs-rank">#{{ i }}</div>
              <a href="#" class="hp3-bs-media">
                {%- capture current -%}{% cycle 1, 2, 3, 4, 5, 6 %}{%- endcapture -%}
                {{ 'product-' | append: current | placeholder_svg_tag: 'hp3-bs-img placeholder-svg' }}
              </a>
              <div class="hp3-bs-info">
                <div class="hp3-bs-vendor">TECHBRAND</div>
                <a href="#" class="hp3-bs-title">Wireless Earbuds Pro</a>
                <div class="hp3-bs-price">$199.00</div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
        
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Only run carousel logic on desktop
    if(window.innerWidth <= 768) return;

    const track = document.getElementById('track-{{ section.id }}');
    if(!track) return;
    
    const prevBtn = document.querySelector('.hp3-tech-bs-{{ section.id }} .prev');
    const nextBtn = document.querySelector('.hp3-tech-bs-{{ section.id }} .next');
    
    let currentIndex = 0;
    const cards = track.querySelectorAll('.hp3-bs-card');
    if(cards.length === 0) return;
    
    const cardWidth = cards[0].offsetWidth;
    const gap = 30; // matches CSS
    const totalItems = cards.length;
    
    function getVisibleItems() {
      if(window.innerWidth > 1200) return 4;
      if(window.innerWidth > 900) return 3;
      return 2;
    }
    
    function updatePosition() {
      const moveAmount = currentIndex * (cardWidth + gap);
      track.style.transform = `translateX(-${moveAmount}px)`;
    }
    
    nextBtn.addEventListener('click', () => {
      const visible = getVisibleItems();
      if(currentIndex < totalItems - visible) {
        currentIndex++;
        updatePosition();
      }
    });
    
    prevBtn.addEventListener('click', () => {
      if(currentIndex > 0) {
        currentIndex--;
        updatePosition();
      }
    });
    
    window.addEventListener('resize', () => {
      if(window.innerWidth > 768) {
        // Recalculate max boundary
        const visible = getVisibleItems();
        if(currentIndex > totalItems - visible) {
          currentIndex = Math.max(0, totalItems - visible);
        }
        updatePosition();
      } else {
        track.style.transform = 'none';
      }
    });
  });
</script>

{% schema %}
{
  "name": "HP3 Tech Bestsellers",
  "tag": "section",
  "class": "section-hp3-bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TOP RATED GEAR"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4, "max": 12, "step": 1,
      "label": "Product Limit",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ffcc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP3 Tech Bestsellers (Adv)",
      "category": "Product"
    }
  ]
}
{% endschema %}
