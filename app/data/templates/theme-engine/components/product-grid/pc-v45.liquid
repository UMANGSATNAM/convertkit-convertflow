{%- comment -%}
  PC V45 — MINIMALIST MONOCHROMATIC STUDIO PRODUCT GRID
  Design: Gallery White (#FAFAFA), Pitch Black (#000000) accents, Inter typography
  Card Shape: 4px soft corners, borderless clean gallery layout, minimal monochromatic studio vibe
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

  .pcv45 {
    --bg: {{ section.settings.bg_color | default: '#FAFAFA' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#111111' }};
    --muted: {{ section.settings.muted_color | default: '#777777' }};
    --accent: {{ section.settings.accent_color | default: '#000000' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#222222' }};
    --border: {{ section.settings.border_color | default: '#EEEEEE' }};
    --badge-sale-bg: #000000;
    --badge-sale-text: #FFFFFF;
    --f-sans: 'Inter', sans-serif;
    --r-card: 4px;
    --ease: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-sans);
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv45 *, .pcv45 *::before, .pcv45 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv45 a { color: inherit; text-decoration: none; }
  .pcv45 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv45 img { max-width: 100%; display: block; }

  .pcv45__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv45__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 40px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv45__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv45__title { font-size: 30px; font-weight: 600; color: var(--text); letter-spacing: -0.02em; }
  @media (min-width: 768px) { .pcv45__title { font-size: 38px; } }
  .pcv45__sub { font-size: 15px; color: var(--muted); }
  .pcv45__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: 13px; color: var(--text); border-bottom: 1.5px solid var(--text); padding-bottom: 2px; transition: var(--ease); }
  .pcv45__viewall:hover { opacity: 0.6; }

  /* GRID */
  .pcv45__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv45__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 28px; }
  }
  @media (min-width: 1024px) {
    .pcv45__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 32px; }
  }

  /* CARD */
  .pcv45__card {
    background: var(--card-bg);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
    transition: var(--ease);
  }
  .pcv45__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.1);
  }

  /* IMAGE CONTAINER */
  .pcv45__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '4/5' }};
    background: #F0F0F0;
    overflow: hidden;
  }
  .pcv45__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pcv45__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv45__card:hover .pcv45__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.04);
    {% endif %}
  }
  .pcv45__card:hover .pcv45__img--sec { opacity: 1; transform: scale(1.04); }

  /* BADGES */
  .pcv45__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv45__badge { font-size: 10px; font-weight: 600; text-transform: uppercase; padding: 4px 10px; border-radius: 20px; letter-spacing: 0.05em; }
  .pcv45__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv45__badge--tag { background: #EAEAEA; color: #111111; }
  .pcv45__badge--sold { background: #888888; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv45__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    color: var(--text);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv45__wish:hover { background: var(--text); color: #FFFFFF; transform: scale(1.1); }
  .pcv45__wish.active { color: #FFFFFF; background: var(--text); }

  /* QUICK ADD HOVER */
  .pcv45__quick-box {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    z-index: 3;
    transform: translateY(12px);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv45__card:hover .pcv45__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv45__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 16px 16px; }
  }

  .pcv45__quick-btn {
    width: 100%;
    padding: 11px 16px;
    background: var(--text);
    color: #FFFFFF;
    font-size: 12px; font-weight: 500; letter-spacing: 0.02em;
    border-radius: 20px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }
  .pcv45__quick-btn:hover { background: #333333; }
  .pcv45__quick-btn:disabled { background: #EEEEEE; color: #888888; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv45__content { padding: 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv45__vendor { font-size: 10px; text-transform: uppercase; color: var(--muted); font-weight: 600; letter-spacing: 0.1em; }
  .pcv45__item-title { font-size: 16px; font-weight: 500; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv45__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; color: var(--text); }
  .pcv45__stars { letter-spacing: 1px; }
  .pcv45__rev-cnt { color: var(--muted); font-size: 11px; }

  /* PRICE */
  .pcv45__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv45__price { font-size: 16px; font-weight: 600; color: var(--text); }
  .pcv45__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv45__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv45__swatch { width: 12px; height: 12px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv45__swatch:hover, .pcv45__swatch.active { transform: scale(1.25); background: var(--text); }

  /* URGENCY MICRO */
  .pcv45__urgency { font-size: 11px; color: var(--text); font-weight: 500; display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv45__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--text); color: #FFFFFF;
    padding: 12px 22px; border-radius: 20px;
    font-size: 12px; font-weight: 500;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pcv45__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv45">
  <div class="pcv45__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv45__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv45__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv45__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv45__viewall">
            {{ section.settings.view_all_label | default: 'View Monochromatic Collection' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv45__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v45', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v45', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv45__toast" id="pcv45-toast">Item Added to Bag</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv45-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv45Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Adding...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ Added';
        showT('Item Added to Bag');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv45-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

