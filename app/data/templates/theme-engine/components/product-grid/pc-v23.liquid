{%- comment -%}
  PC V23 — Y2K CYBER GIRL AESTHETIC PRODUCT GRID
  Design: Pastel Pink (#FCE7F3), Electric Pink (#EC4899) accents, Syne & Outfit typography
  Card Shape: 18px Pill corners, glossy pink border, Y2K sparkle aesthetic
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Syne:wght@700;800&display=swap');

  .pcv23 {
    --bg: {{ section.settings.bg_color | default: '#FCE7F3' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#831843' }};
    --muted: {{ section.settings.muted_color | default: '#BE185D' }};
    --accent: {{ section.settings.accent_color | default: '#EC4899' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#DB2777' }};
    --border: {{ section.settings.border_color | default: '#F472B6' }};
    --badge-sale-bg: #EC4899;
    --badge-sale-text: #FFFFFF;
    --f-heading: 'Syne', sans-serif;
    --f-body: 'Outfit', sans-serif;
    --r-card: 18px;
    --ease: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv23 *, .pcv23 *::before, .pcv23 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv23 a { color: inherit; text-decoration: none; }
  .pcv23 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv23 img { max-width: 100%; display: block; }

  .pcv23__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv23__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv23__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv23__title { font-family: var(--f-heading); font-size: 30px; font-weight: 800; color: var(--text); letter-spacing: -0.02em; }
  @media (min-width: 768px) { .pcv23__title { font-size: 38px; } }
  .pcv23__sub { font-size: 15px; color: var(--muted); font-weight: 500; }
  .pcv23__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; color: #FFFFFF; background: var(--accent); padding: 10px 22px; border-radius: 30px; box-shadow: 0 4px 15px rgba(236, 72, 153, 0.4); transition: var(--ease); }
  .pcv23__viewall:hover { background: var(--accent-hover); transform: scale(1.05); }

  /* GRID */
  .pcv23__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv23__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv23__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv23__card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 10px 20px -5px rgba(244, 114, 182, 0.2);
    transition: var(--ease);
  }
  .pcv23__card:hover {
    transform: translateY(-5px) rotate(-1deg);
    box-shadow: 0 16px 30px -8px rgba(236, 72, 153, 0.35);
    border-color: var(--accent);
  }

  /* IMAGE CONTAINER */
  .pcv23__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #FDF2F8;
    overflow: hidden;
    border-radius: var(--r-card) var(--r-card) 0 0;
  }
  .pcv23__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .pcv23__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv23__card:hover .pcv23__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.06);
    {% endif %}
  }
  .pcv23__card:hover .pcv23__img--sec { opacity: 1; transform: scale(1.06); }

  /* BADGES */
  .pcv23__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv23__badge { font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 4px 10px; border-radius: 20px; letter-spacing: 0.05em; font-family: var(--f-body); }
  .pcv23__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv23__badge--tag { background: #A855F7; color: #FFFFFF; }
  .pcv23__badge--sold { background: #9CA3AF; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv23__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 2px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
    z-index: 3;
    transition: var(--ease);
    box-shadow: 0 4px 10px rgba(236, 72, 153, 0.2);
  }
  .pcv23__wish:hover { background: var(--accent); color: #FFFFFF; border-color: var(--accent); transform: scale(1.15); }
  .pcv23__wish.active { color: #FFFFFF; background: var(--accent); border-color: var(--accent); }

  /* QUICK ADD BUTTON */
  .pcv23__quick-box { padding: 12px 14px 14px; background: var(--card-bg); }
  .pcv23__quick-btn {
    width: 100%;
    padding: 10px 16px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 13px; font-weight: 700; font-family: var(--f-body);
    border-radius: 25px;
    border: none;
    box-shadow: 0 4px 14px rgba(236, 72, 153, 0.35);
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv23__quick-btn:hover { background: var(--accent-hover); transform: scale(1.03); }
  .pcv23__quick-btn:disabled { background: #F472B6; color: #FFFFFF; opacity: 0.6; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv23__content { padding: 14px 14px 0 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv23__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 700; letter-spacing: 0.08em; }
  .pcv23__item-title { font-family: var(--f-heading); font-size: 16px; font-weight: 700; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv23__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; color: var(--accent); font-weight: 700; }
  .pcv23__stars { letter-spacing: 1px; }
  .pcv23__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 500; }

  /* PRICE */
  .pcv23__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv23__price { font-size: 17px; font-weight: 800; color: var(--text); font-family: var(--f-heading); }
  .pcv23__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv23__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv23__swatch { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv23__swatch:hover, .pcv23__swatch.active { transform: scale(1.3); border-color: var(--accent); }

  /* URGENCY MICRO */
  .pcv23__urgency { font-size: 11px; color: var(--accent); font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv23__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #FFFFFF;
    padding: 12px 22px; border-radius: 25px;
    font-size: 13px; font-weight: 700; font-family: var(--f-body);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 10px 25px rgba(236, 72, 153, 0.4);
  }
  .pcv23__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv23">
  <div class="pcv23__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv23__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv23__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv23__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv23__viewall">
            {{ section.settings.view_all_label | default: 'Shop Y2K Drop' }} ✨ &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv23__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v23', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v23', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv23__toast" id="pcv23-toast">💖 Added to Bag!</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv23-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv23Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'ADDING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ ADDED';
        showT('💖 ADDED TO BAG!');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv23-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

