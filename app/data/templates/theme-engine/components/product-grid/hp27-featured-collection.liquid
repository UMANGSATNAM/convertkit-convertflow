{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Syncopate:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Syncopate', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp27-fc-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp27-fc-wrapper {
      padding: 0 20px;
    }
  }

  .hp27-fc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
    border-bottom: 1px solid rgba(226, 226, 226, 0.1);
    padding-bottom: 20px;
  }

  @media screen and (max-width: 768px) {
    .hp27-fc__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp27-fc__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp27-fc__title span {
    color: var(--accent-color);
  }

  .hp27-fc__view-all {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-color);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.3s ease;
  }

  .hp27-fc__view-all:hover {
    color: var(--accent-color);
  }

  .hp27-fc__view-all svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .hp27-fc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 20px;
  }

  @media screen and (max-width: 992px) {
    .hp27-fc__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 600px) {
    .hp27-fc__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp27-fc__item {
    text-decoration: none;
    display: block;
    position: relative;
    group;
  }

  .hp27-fc__image-wrapper {
    position: relative;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    background: #111;
    overflow: hidden;
    border: 1px solid rgba(226, 226, 226, 0.1);
    padding: 1px; /* "Blueprint" border effect */
  }

  .hp27-fc__image-wrapper::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border: 1px solid var(--accent-color);
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    transform: scale(0.98);
    pointer-events: none;
    z-index: 2;
  }

  .hp27-fc__item:hover .hp27-fc__image-wrapper::after {
    opacity: 1;
    transform: scale(1);
  }

  .hp27-fc__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.1);
    transition: filter 0.4s ease, transform 0.8s ease;
  }

  .hp27-fc__item:hover .hp27-fc__image {
    filter: grayscale(0%) contrast(1);
    transform: scale(1.05);
  }

  .hp27-fc__meta {
    padding: 15px 0 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .hp27-fc__product-title {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-color);
    margin: 0 0 5px;
    text-transform: uppercase;
  }

  .hp27-fc__product-type {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--text-color);
    opacity: 0.5;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .hp27-fc__product-price {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp27-fc-wrapper" id="HP27FC-{{ section.id }}">
  <div class="hp27-fc__header">
    <h2 class="hp27-fc__title">{{ section.settings.title }}</h2>
    
    {%- if section.settings.btn_text != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp27-fc__view-all">
        {{ section.settings.btn_text }}
        <svg viewBox="0 0 24 24"><path d="M5 12H19M19 12L12 5M19 12L12 19"/></svg>
      </a>
    {%- endif -%}
  </div>

  <div class="hp27-fc__grid">
    {%- if section.settings.collection != blank -%}
      {%- for product in collections[section.settings.collection].products limit: section.settings.limit -%}
        <a href="{{ product.url }}" class="hp27-fc__item">
          <div class="hp27-fc__image-wrapper">
            <img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" class="hp27-fc__image" loading="lazy">
          </div>
          <div class="hp27-fc__meta">
            <div>
              <h3 class="hp27-fc__product-title">{{ product.title }}</h3>
              <div class="hp27-fc__product-type">{{ product.type | default: 'SYSTEM.OBJ' }}</div>
            </div>
            <div class="hp27-fc__product-price">{{ product.price | money }}</div>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.limit) -%}
        <a href="#" class="hp27-fc__item">
          <div class="hp27-fc__image-wrapper">
            {{ 'product-' | append: i | placeholder_svg_tag: 'hp27-fc__image' }}
          </div>
          <div class="hp27-fc__meta">
            <div>
              <h3 class="hp27-fc__product-title">PROTOTYPE_{{ i }}</h3>
              <div class="hp27-fc__product-type">SYSTEM.OBJ</div>
            </div>
            <div class="hp27-fc__product-price">$299.00</div>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP27 - Eng Featured",
  "class": "section-hp27-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "SYSTEM <span>INTEGRATION</span>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "VIEW CATALOG"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of Products",
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "16/9", "label": "Landscape (16:9)" }
      ],
      "default": "3/4"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Dark Engineered Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#E2E2E2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF2A2A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP27 - Eng Featured"
    }
  ]
}
{% endschema %}
