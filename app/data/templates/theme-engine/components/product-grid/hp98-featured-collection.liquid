{%- style -%}#shopify-section-{{ section.id }}{background:{{section.settings.bg_color|default:'#fff'}};padding:50px 0}.hp98-fc{max-width:1280px;margin:0 auto;padding:0 24px}.hp98-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:18px}.hp98-h{font-size:24px;font-weight:800;margin:0}.hp98-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}@media(max-width:900px){.hp98-grid{grid-template-columns:repeat(2,1fr)}}.hp98-card{border:1px solid rgba(0,0,0,.06);border-radius:12px;overflow:hidden;background:#fff;text-decoration:none;color:inherit}.hp98-card img{width:100%;aspect-ratio:1;object-fit:cover}.hp98-body{padding:10px}.hp98-title{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0}.hp98-price{font-weight:700;color:#6366F1;margin:4px 0 0}{%- endstyle -%}<div class="hp98-fc"><div class="hp98-head"><h2 class="hp98-h">{{section.settings.heading|default:'Featured ELECTRONICS'}}</h2><a href="{{section.settings.link|default:'/collections/all'}}" style="font-size:12px;font-weight:700;color:#6366F1;text-decoration:none">{{section.settings.link_text|default:'View All →'}}</a></div><div class="hp98-grid">{% for product in collections[section.settings.collection].products limit: section.settings.limit %}<a href="{{product.url}}" class="hp98-card"><img src="{{product.featured_image|image_url:width:500}}" alt="{{product.title|escape}}" loading="lazy"><div class="hp98-body"><p class="hp98-title">{{product.title}}</p><p class="hp98-price">{{product.price|money}}</p></div></a>{% else %}{% for i in (1..4) %}<div class="hp98-card"><div style="aspect-ratio:1;background:#f5f5f5">{{'product-1'|placeholder_svg_tag}}</div><div class="hp98-body"><p class="hp98-title">Sample ELECTRONICS</p><p class="hp98-price">₹1,999</p></div></div>{% endfor %}{% endfor %}</div></div>{% schema %}{"name":"HP98 Featured Grid","settings":[{"type":"text","id":"heading","label":"Heading","default":"Featured ELECTRONICS"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","min":2,"max":8,"step":1,"label":"Limit","default":4},{"type":"color","id":"bg_color","label":"BG","default":"#ffffff"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"link_text","label":"Link text","default":"View All →"}],"presets":[{"name":"HP98 Featured Grid"}]}{% endschema %}