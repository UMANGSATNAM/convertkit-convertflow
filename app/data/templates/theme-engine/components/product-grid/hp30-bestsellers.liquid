{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Space+Grotesk:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Oswald', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 4px solid var(--border-color);
  }

  .hp30-bs-wrapper {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp30-bs-wrapper {
      padding: 0 20px;
    }
  }

  .hp30-bs__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    border-bottom: 4px solid var(--border-color);
    padding-bottom: 20px;
  }

  @media screen and (max-width: 768px) {
    .hp30-bs__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp30-bs__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    line-height: 1;
    text-transform: uppercase;
    color: var(--text-color);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .hp30-bs__nav {
    display: flex;
    gap: 10px;
  }

  .hp30-bs__nav-btn {
    width: 50px;
    height: 50px;
    background: var(--bg-color);
    border: 4px solid var(--text-color);
    color: var(--text-color);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0s, color 0s;
  }

  .hp30-bs__nav-btn svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  .hp30-bs__nav-btn:hover {
    background: var(--text-color);
    color: var(--bg-color);
  }

  .hp30-bs__slider-container {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Hide scrollbar for a cleaner look */
    -webkit-overflow-scrolling: touch;
    display: flex;
    gap: 20px;
    padding-bottom: 20px;
  }
  .hp30-bs__slider-container::-webkit-scrollbar {
    display: none;
  }

  .hp30-bs__card {
    flex: 0 0 calc(100% / {{ section.settings.columns_desktop }} - 15px);
    scroll-snap-align: start;
    border: 4px solid var(--border-color);
    background: var(--bg-color);
    position: relative;
    display: flex;
    flex-direction: column;
  }

  @media screen and (max-width: 992px) {
    .hp30-bs__card {
      flex: 0 0 calc(50% - 10px);
    }
  }

  @media screen and (max-width: 576px) {
    .hp30-bs__card {
      flex: 0 0 calc(100% - 10px);
    }
  }

  .hp30-bs__card-number {
    position: absolute;
    top: 10px;
    left: 10px;
    font-family: var(--font-heading);
    font-size: 60px;
    line-height: 0.8;
    color: var(--accent-color);
    z-index: 2;
    -webkit-text-stroke: 1px var(--border-color);
    opacity: 0.9;
  }

  .hp30-bs__image-wrap {
    width: 100%;
    aspect-ratio: 1/1;
    overflow: hidden;
    background: #222;
    border-bottom: 4px solid var(--border-color);
  }

  .hp30-bs__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(130%) grayscale(50%);
    transition: filter 0s, transform 0s;
  }

  .hp30-bs__card:hover .hp30-bs__image {
    filter: contrast(100%) grayscale(0%);
  }

  .hp30-bs__info {
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex: 1;
  }

  .hp30-bs__title-price {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .hp30-bs__product-title {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-color);
    margin: 0;
    text-decoration: none;
  }

  .hp30-bs__product-title:hover {
    color: var(--accent-color);
  }

  .hp30-bs__price {
    font-family: var(--font-heading);
    font-size: 22px;
    color: var(--text-color);
  }

  .hp30-bs__add-btn {
    background: transparent;
    color: var(--text-color);
    border: 4px solid var(--text-color);
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 30px;
    line-height: 1;
    transition: background-color 0s;
  }

  .hp30-bs__add-btn:hover {
    background: var(--text-color);
    color: var(--bg-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp30-bs-wrapper" id="HP30Bestsellers-{{ section.id }}">
  <div class="hp30-bs__header">
    <h2 class="hp30-bs__title">{{ section.settings.title }}</h2>
    
    <div class="hp30-bs__nav">
      <button class="hp30-bs__nav-btn" id="hp30-prev-{{ section.id }}" aria-label="Previous">
        <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="hp30-bs__nav-btn" id="hp30-next-{{ section.id }}" aria-label="Next">
        <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <div class="hp30-bs__slider-container" id="hp30-slider-{{ section.id }}">
    {%- for i in (1..6) -%}
      <div class="hp30-bs__card">
        <div class="hp30-bs__card-number">0{{ i }}</div>
        <a href="#" class="hp30-bs__image-wrap">
          {%- assign placeholder = 'product-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'product-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp30-bs__image' }}
        </a>
        <div class="hp30-bs__info">
          <div class="hp30-bs__title-price">
            <a href="#" class="hp30-bs__product-title">Item 00{{ i }}</a>
            <div class="hp30-bs__price">$2{{ i }}0.00</div>
          </div>
          <button class="hp30-bs__add-btn" aria-label="Add to cart">+</button>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.getElementById('hp30-slider-{{ section.id }}');
    const prevBtn = document.getElementById('hp30-prev-{{ section.id }}');
    const nextBtn = document.getElementById('hp30-next-{{ section.id }}');

    if (slider && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        const itemWidth = slider.querySelector('.hp30-bs__card').offsetWidth + 20;
        slider.scrollBy({ left: -itemWidth, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        const itemWidth = slider.querySelector('.hp30-bs__card').offsetWidth + 20;
        slider.scrollBy({ left: itemWidth, behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP30 - Brutalist Tops",
  "class": "section-hp30-bestsellers",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "TOP TIER"
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 3
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (White)",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders (White)",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (Red)",
      "default": "#FF0000"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP30 - Brutalist Tops"
    }
  ]
}
{% endschema %}
