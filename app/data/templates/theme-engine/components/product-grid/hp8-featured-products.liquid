{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f4f4f4'
  assign text_color = section.settings.text_color | default: '#000000'
  assign heading = section.settings.heading | default: 'CURATED ESSENTIALS'
  assign collection = collections[section.settings.collection]
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 20px;
    color: {{ text_color }};
  }
  
  .hp8-featured-container-{{ section_id }} {
    max-width: 1600px;
    margin: 0 auto;
  }
  
  .hp8-featured-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 80px;
  }
  
  .hp8-featured-header-{{ section_id }} h2 {
    font-family: 'Bodoni MT', 'Didot', 'Playfair Display', serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
    margin: 0;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  
  .hp8-featured-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  
  .hp8-product-card-{{ section_id }} {
    position: relative;
    group;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  
  .hp8-product-image-wrapper-{{ section_id }} {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
    background-color: #e0e0e0;
    margin-bottom: 25px;
  }
  
  .hp8-product-image-{{ section_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  
  .hp8-product-card-{{ section_id }}:hover .hp8-product-image-{{ section_id }} {
    transform: scale(1.05);
  }
  
  .hp8-product-image-hover-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  
  .hp8-product-card-{{ section_id }}:hover .hp8-product-image-hover-{{ section_id }} {
    opacity: 1;
  }
  
  .hp8-product-quick-add-{{ section_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: #000000;
    color: #ffffff;
    border: none;
    padding: 15px 30px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    opacity: 0;
    cursor: pointer;
    transition: all 0.4s ease;
    width: 80%;
  }
  
  .hp8-product-card-{{ section_id }}:hover .hp8-product-quick-add-{{ section_id }} {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  
  .hp8-product-quick-add-{{ section_id }}:hover {
    background: #333333;
  }
  
  .hp8-product-info-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  
  .hp8-product-title-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1rem;
    font-weight: 400;
    margin: 0 0 5px 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  
  .hp8-product-type-{{ section_id }} {
    font-family: 'Bodoni MT', 'Didot', 'Playfair Display', serif;
    font-size: 0.9rem;
    font-style: italic;
    color: {{ text_color | color_modify: 'alpha', 0.6 }};
    margin: 0;
  }
  
  .hp8-product-price-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1rem;
    font-weight: 500;
    text-align: right;
  }

  @media (max-width: 1200px) {
    .hp8-featured-grid-{{ section_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  @media (max-width: 992px) {
    .hp8-featured-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
    .hp8-product-quick-add-{{ section_id }} {
      display: none; /* Hide quick add on tablet/mobile for cleaner UI */
    }
  }
  
  @media (max-width: 576px) {
    .hp8-featured-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="hp8-featured-container-{{ section_id }}">
  {% if heading != blank %}
    <div class="hp8-featured-header-{{ section_id }}">
      <h2>{{ heading }}</h2>
    </div>
  {% endif %}
  
  <div class="hp8-featured-grid-{{ section_id }}">
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: 4 %}
        <a href="{{ product.url }}" class="hp8-product-card-{{ section_id }}">
          <div class="hp8-product-image-wrapper-{{ section_id }}">
            <img src="{{ product.featured_image | image_url: width: 600, height: 800, crop: 'center' }}" alt="{{ product.title }}" class="hp8-product-image-{{ section_id }}" loading="lazy" width="400" height="533">
            {% if product.images.size > 1 %}
              <img src="{{ product.images[1] | image_url: width: 600, height: 800, crop: 'center' }}" alt="{{ product.title }} alternate" class="hp8-product-image-hover-{{ section_id }}" loading="lazy" width="400" height="533">
            {% endif %}
            <button class="hp8-product-quick-add-{{ section_id }}">Add to Bag</button>
          </div>
          <div class="hp8-product-info-{{ section_id }}">
            <div>
              <h3 class="hp8-product-title-{{ section_id }}">{{ product.title }}</h3>
              <p class="hp8-product-type-{{ section_id }}">{{ product.type | default: 'Ready to Wear' }}</p>
            </div>
            <div class="hp8-product-price-{{ section_id }}">
              {{ product.price | money }}
            </div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <a href="#" class="hp8-product-card-{{ section_id }}">
          <div class="hp8-product-image-wrapper-{{ section_id }}">
            <div style="width:100%; height:100%; background:#e0e0e0; display:flex; align-items:center; justify-content:center; color:#999;">PRODUCT {{ i }}</div>
            <button class="hp8-product-quick-add-{{ section_id }}">Add to Bag</button>
          </div>
          <div class="hp8-product-info-{{ section_id }}">
            <div>
              <h3 class="hp8-product-title-{{ section_id }}">LUXURY ITEM {{ i }}</h3>
              <p class="hp8-product-type-{{ section_id }}">Ready to Wear</p>
            </div>
            <div class="hp8-product-price-{{ section_id }}">
              $850.00
            </div>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP8 Featured Products",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CURATED ESSENTIALS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "HP8 Featured Products"
    }
  ]
}
{% endschema %}
