{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0A0A0A'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 1px solid rgba(0, 255, 65, 0.3);
  }
  
  .hp17-bs-container-{{ section_id }} {
    max-width: 1600px;
    margin: 0 auto;
  }
  
  .hp17-bs-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
    border-bottom: 1px solid rgba(0, 255, 65, 0.2);
    padding-bottom: 20px;
  }
  
  .hp17-bs-heading-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: clamp(2rem, 4vw, 4rem);
    text-transform: uppercase;
    color: #FFF;
    margin: 0;
    line-height: 1;
    letter-spacing: 2px;
  }
  
  .hp17-bs-heading-{{ section_id }} span {
    color: #00FF41;
  }
  
  .hp17-bs-link-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9rem;
    font-weight: bold;
    text-transform: uppercase;
    color: #00FF41;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: all 0.2s ease;
  }
  
  .hp17-bs-link-{{ section_id }}:hover {
    color: #FFF;
    text-shadow: 0 0 5px rgba(255,255,255,0.5);
  }
  
  .hp17-bs-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  
  .hp17-bs-card-{{ section_id }} {
    background: #000;
    border: 1px solid rgba(0, 255, 65, 0.2);
    text-decoration: none;
    color: #FFF;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.3s ease;
  }
  
  .hp17-bs-card-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 10px; height: 10px;
    border-top: 1px solid #00FF41; border-left: 1px solid #00FF41;
    opacity: 0; transition: opacity 0.3s ease; z-index: 2;
  }
  .hp17-bs-card-{{ section_id }}::after {
    content: '';
    position: absolute;
    bottom: 0; right: 0; width: 10px; height: 10px;
    border-bottom: 1px solid #00FF41; border-right: 1px solid #00FF41;
    opacity: 0; transition: opacity 0.3s ease; z-index: 2;
  }
  
  .hp17-bs-card-{{ section_id }}:hover {
    border-color: #00FF41;
    box-shadow: 0 0 15px rgba(0, 255, 65, 0.1);
  }
  
  .hp17-bs-card-{{ section_id }}:hover::before,
  .hp17-bs-card-{{ section_id }}:hover::after {
    opacity: 1;
  }
  
  .hp17-bs-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 130%;
    overflow: hidden;
    background: #111;
  }
  
  .hp17-bs-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(80%);
    transition: all 0.5s ease;
  }
  
  .hp17-bs-card-{{ section_id }}:hover .hp17-bs-image-{{ section_id }} {
    filter: grayscale(0%);
    transform: scale(1.05);
  }
  
  .hp17-bs-overlay-{{ section_id }} {
    position: absolute;
    top: 10px; left: 10px;
    background: rgba(0,0,0,0.8);
    border: 1px solid #00FF41;
    color: #00FF41;
    padding: 3px 8px;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.7rem;
    font-weight: bold;
    letter-spacing: 1px;
  }
  
  .hp17-bs-info-{{ section_id }} {
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-top: 1px solid rgba(0, 255, 65, 0.2);
  }
  
  .hp17-bs-title-{{ section_id }} {
    font-family: 'Arial', sans-serif;
    font-weight: bold;
    font-size: 1rem;
    text-transform: uppercase;
    margin: 0 0 5px 0;
    color: #FFF;
  }
  
  .hp17-bs-sku-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.7rem;
    color: rgba(255,255,255,0.4);
  }
  
  .hp17-bs-price-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    color: #00FF41;
    font-weight: bold;
  }

  @media (max-width: 1200px) {
    .hp17-bs-grid-{{ section_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 992px) {
    .hp17-bs-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp17-bs-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
  }
</style>

<div class="hp17-bs-container-{{ section_id }}">
  <div class="hp17-bs-header-{{ section_id }}">
    <h2 class="hp17-bs-heading-{{ section_id }}">PRIORITY <span>TARGETS</span></h2>
    <a href="{{ collections[section.settings.collection].url | default: '#' }}" class="hp17-bs-link-{{ section_id }}">ACCESS_ALL ></a>
  </div>
  
  <div class="hp17-bs-grid-{{ section_id }}">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: 4 %}
        <a href="{{ product.url }}" class="hp17-bs-card-{{ section_id }}">
          <div class="hp17-bs-image-wrap-{{ section_id }}">
            <img src="{{ product.featured_image | image_url: width: 600 }}" class="hp17-bs-image-{{ section_id }}" loading="lazy" alt="{{ product.title }}">
            <div class="hp17-bs-overlay-{{ section_id }}">CLASS: ALPHA</div>
          </div>
          <div class="hp17-bs-info-{{ section_id }}">
            <div>
              <h3 class="hp17-bs-title-{{ section_id }}">{{ product.title }}</h3>
              <div class="hp17-bs-sku-{{ section_id }}">ID: {{ product.id | slice: 0, 8 }}</div>
            </div>
            <div class="hp17-bs-price-{{ section_id }}">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <a href="#" class="hp17-bs-card-{{ section_id }}">
          <div class="hp17-bs-image-wrap-{{ section_id }}">
            <div class="hp17-bs-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
            <div class="hp17-bs-overlay-{{ section_id }}">CLASS: ALPHA</div>
          </div>
          <div class="hp17-bs-info-{{ section_id }}">
            <div>
              <h3 class="hp17-bs-title-{{ section_id }}">TACTICAL SHELL</h3>
              <div class="hp17-bs-sku-{{ section_id }}">ID: 8F92A1B4</div>
            </div>
            <div class="hp17-bs-price-{{ section_id }}">$250.00</div>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP17 Bestsellers",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A0A0A"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "HP17 Bestsellers"
    }
  ]
}
{% endschema %}
