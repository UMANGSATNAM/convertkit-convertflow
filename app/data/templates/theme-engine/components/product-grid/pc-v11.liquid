{%- comment -%}
  PC V11 — MINIMALIST SCANDINAVIAN CLEAN PRODUCT GRID
  Design: Snow White (#FAFAFA), Warm Taupe (#8C827A) accents, Plus Jakarta Sans typography
  Card Shape: Subtle 6px rounded, minimal stroke, Scandinavian light aesthetic
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .pcv11 {
    --bg: {{ section.settings.bg_color | default: '#FAFAFA' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#262626' }};
    --muted: {{ section.settings.muted_color | default: '#737373' }};
    --accent: {{ section.settings.accent_color | default: '#8C827A' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#6E655E' }};
    --border: {{ section.settings.border_color | default: '#E5E5E5' }};
    --badge-sale-bg: #8C827A;
    --badge-sale-text: #FFFFFF;
    --f-main: 'Plus Jakarta Sans', sans-serif;
    --r-card: 6px;
    --ease: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-main);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv11 *, .pcv11 *::before, .pcv11 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv11 a { color: inherit; text-decoration: none; }
  .pcv11 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv11 img { max-width: 100%; display: block; }

  .pcv11__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv11__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv11__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv11__title { font-size: 28px; font-weight: 600; color: var(--text); letter-spacing: -0.02em; }
  @media (min-width: 768px) { .pcv11__title { font-size: 34px; } }
  .pcv11__sub { font-size: 15px; color: var(--muted); font-weight: 400; }
  .pcv11__viewall { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 13px; color: var(--accent); transition: var(--ease); }
  .pcv11__viewall:hover { color: var(--accent-hover); gap: 10px; }

  /* GRID */
  .pcv11__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 16px;
  }
  @media (min-width: 640px) {
    .pcv11__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 20px; }
  }
  @media (min-width: 1024px) {
    .pcv11__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 24px; }
  }

  /* CARD */
  .pcv11__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--ease);
  }
  .pcv11__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.06);
    border-color: #D4D4D4;
  }

  /* IMAGE BOX */
  .pcv11__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '3/4' }};
    background: #F5F5F5;
    overflow: hidden;
  }
  .pcv11__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .pcv11__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv11__card:hover .pcv11__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.03);
    {% endif %}
  }
  .pcv11__card:hover .pcv11__img--sec { opacity: 1; transform: scale(1.03); }

  /* BADGES */
  .pcv11__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv11__badge { font-size: 11px; font-weight: 600; text-transform: uppercase; padding: 4px 8px; border-radius: 4px; letter-spacing: 0.04em; }
  .pcv11__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv11__badge--tag { background: #262626; color: #FFFFFF; }
  .pcv11__badge--sold { background: #A3A3A3; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv11__wish {
    position: absolute;
    top: 10px; right: 10px;
    width: 34px; height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv11__wish:hover { background: #FFFFFF; color: var(--accent); transform: scale(1.08); }
  .pcv11__wish.active { color: var(--accent); background: #FFFFFF; }

  /* QUICK ADD HOVER */
  .pcv11__quick-box {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    z-index: 3;
    transform: translateY(12px);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv11__card:hover .pcv11__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv11__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 14px 14px; }
  }

  .pcv11__quick-btn {
    width: 100%;
    padding: 10px 14px;
    background: var(--text);
    color: #FFFFFF;
    font-size: 12px; font-weight: 600;
    border-radius: 4px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv11__quick-btn:hover { background: var(--accent); }
  .pcv11__quick-btn:disabled { background: #D4D4D4; cursor: not-allowed; }

  /* CARD CONTENT */
  .pcv11__content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; }

  .pcv11__vendor { font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 600; letter-spacing: 0.05em; }
  .pcv11__item-title { font-size: 14px; font-weight: 600; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv11__rating { display: flex; align-items: center; gap: 4px; font-size: 12px; color: var(--accent); font-weight: 600; }
  .pcv11__stars { letter-spacing: 1px; }
  .pcv11__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 400; }

  /* PRICE */
  .pcv11__price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv11__price { font-size: 15px; font-weight: 700; color: var(--text); }
  .pcv11__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv11__swatches { display: flex; gap: 6px; align-items: center; margin-top: 4px; }
  .pcv11__swatch { width: 12px; height: 12px; border-radius: 50%; border: 1px solid #E5E5E5; cursor: pointer; transition: var(--ease); }
  .pcv11__swatch:hover, .pcv11__swatch.active { transform: scale(1.2); border-color: var(--text); }

  /* URGENCY MICRO */
  .pcv11__urgency { font-size: 11px; color: var(--accent); font-weight: 600; display: flex; align-items: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv11__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--text); color: #FFFFFF;
    padding: 12px 20px; border-radius: 6px;
    font-size: 13px; font-weight: 600;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.3s ease;
  }
  .pcv11__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv11">
  <div class="pcv11__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv11__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv11__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv11__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv11__viewall">
            {{ section.settings.view_all_label | default: 'Explore Scandinavian range' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv11__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v11', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v11', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv11__toast" id="pcv11-toast">Item added to cart</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv11-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv11Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Adding...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ Added';
        showT('Item added to cart');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv11-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

