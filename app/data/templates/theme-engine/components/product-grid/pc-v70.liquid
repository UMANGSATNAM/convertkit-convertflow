{%- comment -%}
  PC V70 — VIBRANT Y2K POP-ART COLLECTOR & TOYS PRODUCT GRID
  Design: Candy Cream (#FFF5F5), Bubblegum Pink (#EC4899) & Pop Yellow (#FBBF24) accents, Fredoka & Lexend typography
  Card Shape: 20px bubble corners, 2px pink borders, 4px 3D pop offset shadows, Y2K pop-art aesthetic
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Lexend:wght@600;700;800&display=swap');

  .pcv70 {
    --bg: {{ section.settings.bg_color | default: '#FFF5F5' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#831843' }};
    --muted: {{ section.settings.muted_color | default: '#BE185D' }};
    --accent: {{ section.settings.accent_color | default: '#EC4899' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#DB2777' }};
    --border: {{ section.settings.border_color | default: '#EC4899' }};
    --badge-sale-bg: #FBBF24;
    --badge-sale-text: #831843;
    --f-heading: 'Fredoka', cursive;
    --f-body: 'Lexend', sans-serif;
    --r-card: 20px;
    --ease: all 0.2s ease;
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv70 *, .pcv70 *::before, .pcv70 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv70 a { color: inherit; text-decoration: none; }
  .pcv70 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv70 img { max-width: 100%; display: block; }

  .pcv70__wrap { max-width: 1320px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv70__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv70__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv70__title { font-family: var(--f-heading); font-size: 32px; font-weight: 700; color: var(--text); letter-spacing: -0.01em; }
  @media (min-width: 768px) { .pcv70__title { font-size: 42px; } }
  .pcv70__sub { font-size: 15px; color: var(--muted); }
  .pcv70__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 800; font-size: 12px; font-family: var(--f-body); text-transform: uppercase; letter-spacing: 0.1em; color: #FFFFFF; background: var(--accent); padding: 8px 20px; border-radius: 20px; border: 2px solid #831843; box-shadow: 3px 3px 0px #FBBF24; transition: var(--ease); }
  .pcv70__viewall:hover { background: #FBBF24; color: #831843; box-shadow: 5px 5px 0px var(--accent); }

  /* GRID */
  .pcv70__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv70__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv70__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv70__card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    border-radius: var(--r-card);
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 4px 4px 0px #FBBF24;
    transition: var(--ease);
  }
  .pcv70__card:hover {
    transform: translate(-3px, -4px);
    border-color: #FBBF24;
    box-shadow: 6px 6px 0px #EC4899;
  }

  /* IMAGE CONTAINER */
  .pcv70__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #FCE7F3;
    overflow: hidden;
    border-top-left-radius: calc(var(--r-card) - 2px);
    border-top-right-radius: calc(var(--r-card) - 2px);
    border-bottom: 2px solid var(--border);
  }
  .pcv70__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .pcv70__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv70__card:hover .pcv70__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.06);
    {% endif %}
  }
  .pcv70__card:hover .pcv70__img--sec { opacity: 1; transform: scale(1.06); }

  /* BADGES */
  .pcv70__badges { position: absolute; top: 10px; left: 10px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv70__badge { font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 4px 10px; border-radius: 12px; border: 1.5px solid #831843; letter-spacing: 0.05em; font-family: var(--f-body); }
  .pcv70__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv70__badge--tag { background: #EC4899; color: #FFFFFF; }
  .pcv70__badge--sold { background: #F3F4F6; color: #9CA3AF; border-color: #F3F4F6; }

  /* WISHLIST BUTTON */
  .pcv70__wish {
    position: absolute;
    top: 10px; right: 10px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: #FFF5F5;
    border: 2px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv70__wish:hover { background: var(--accent); color: #FFFFFF; border-color: var(--accent); transform: scale(1.1); }
  .pcv70__wish.active { color: #FFFFFF; background: var(--accent); border-color: var(--accent); }

  /* QUICK ADD HOVER */
  .pcv70__quick-box { padding: 12px; background: var(--card-bg); border-top: 2px solid var(--border); border-bottom-left-radius: calc(var(--r-card) - 2px); border-bottom-right-radius: calc(var(--r-card) - 2px); }
  .pcv70__quick-btn {
    width: 100%;
    padding: 10px 14px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    font-family: var(--f-body);
    border-radius: 14px;
    border: 2px solid #831843;
    box-shadow: 2px 3px 0px #FBBF24;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv70__quick-btn:hover { background: #FBBF24; color: #831843; box-shadow: 4px 5px 0px #EC4899; }
  .pcv70__quick-btn:disabled { background: #F3F4F6; color: #9CA3AF; cursor: not-allowed; box-shadow: none; border-color: #F3F4F6; }

  /* CARD CONTENT */
  .pcv70__content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv70__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 800; letter-spacing: 0.1em; }
  .pcv70__item-title { font-family: var(--f-heading); font-size: 17px; font-weight: 700; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv70__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; color: #FBBF24; font-weight: 700; }
  .pcv70__stars { letter-spacing: 1px; }
  .pcv70__rev-cnt { color: var(--muted); font-size: 11px; }

  /* PRICE */
  .pcv70__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv70__price { font-size: 18px; font-weight: 800; color: var(--text); font-family: var(--f-heading); }
  .pcv70__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv70__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv70__swatch { width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv70__swatch:hover, .pcv70__swatch.active { border-color: var(--accent); background: var(--accent); transform: scale(1.25); }

  /* URGENCY MICRO */
  .pcv70__urgency { font-size: 11px; color: #EC4899; font-weight: 800; font-family: var(--f-body); text-transform: uppercase; display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv70__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #FFFFFF;
    border: 2px solid #831843; padding: 12px 20px; border-radius: 14px;
    font-size: 12px; font-weight: 800; text-transform: uppercase; font-family: var(--f-body);
    box-shadow: 4px 4px 0px #FBBF24;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.2s ease;
  }
  .pcv70__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv70">
  <div class="pcv70__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv70__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv70__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv70__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv70__viewall">
            {{ section.settings.view_all_label | default: 'Shop Y2K Collectibles' }} 🎈 &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv70__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v70', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v70', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv70__toast" id="pcv70-toast">Y2K POP TOY ADDED</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv70-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv70Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'POPPING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ ADDED';
        showT('Y2K POP TOY ADDED');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv70-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

