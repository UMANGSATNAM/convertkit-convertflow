{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&family=JetBrains+Mono:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --grid-color: rgba(255, 255, 255, 0.1);
    
    --font-heading: 'Inter', sans-serif;
    --font-body: 'JetBrains Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--grid-color);
  }

  .hp34-best-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
  }

  @media screen and (max-width: 768px) {
    .hp34-best-wrapper {
      padding: 0 20px;
    }
  }

  .hp34-best__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--grid-color);
  }

  .hp34-best__subtitle {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 10px;
  }

  .hp34-best__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: var(--text-color);
    margin: 0;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp34-best__list {
    display: flex;
    flex-direction: column;
  }

  .hp34-best__item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 0;
    border-bottom: 1px solid var(--grid-color);
    text-decoration: none;
    position: relative;
    cursor: pointer;
    transition: background 0.3s ease, padding 0.3s ease;
  }

  .hp34-best__item:hover {
    background: rgba(255, 255, 255, 0.02);
    padding-left: 20px;
    padding-right: 20px;
  }

  .hp34-best__col-left {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .hp34-best__index {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--accent-color);
    width: 40px;
  }

  .hp34-best__product-title {
    font-family: var(--font-heading);
    font-size: clamp(20px, 3vw, 32px);
    color: var(--text-color);
    margin: 0;
    font-weight: 700;
    text-transform: uppercase;
  }

  .hp34-best__col-right {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .hp34-best__sku {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--text-color);
    opacity: 0.5;
  }

  @media screen and (max-width: 576px) {
    .hp34-best__sku { display: none; }
  }

  .hp34-best__price {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    font-weight: 700;
  }

  /* Hover image logic */
  .hp34-best__hover-img {
    position: absolute;
    width: 300px;
    height: 400px;
    object-fit: cover;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    opacity: 0;
    pointer-events: none;
    z-index: 10;
    border: 1px solid var(--grid-color);
    filter: grayscale(100%);
    transition: all 0.3s ease;
  }

  .hp34-best__item:hover .hp34-best__hover-img {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp34-best-wrapper" id="HP34Best-{{ section.id }}">
  <div class="hp34-best__header">
    <div>
      {%- if section.settings.subtitle != blank -%}
        <div class="hp34-best__subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}
      <h2 class="hp34-best__title">{{ section.settings.title }}</h2>
    </div>
  </div>

  <div class="hp34-best__list">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.product_link | default: '#' }}" class="hp34-best__item" {{ block.shopify_attributes }}>
        <div class="hp34-best__col-left">
          <span class="hp34-best__index">[0{{ forloop.index }}]</span>
          <h3 class="hp34-best__product-title">{{ block.settings.title }}</h3>
        </div>
        <div class="hp34-best__col-right">
          <span class="hp34-best__sku">SKU_{{ block.settings.title | slice: 0, 4 | upcase | replace: ' ', '_' }}</span>
          <span class="hp34-best__price">{{ block.settings.price }}</span>
        </div>
        
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp34-best__hover-img" loading="lazy" alt="{{ block.settings.title }}">
        {%- else -%}
          {%- assign placeholder = 'product-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'product-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp34-best__hover-img' }}
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP34 - Tech Bestsellers",
  "class": "section-hp34-bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "QUERY: POPULAR_MODULES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "High Demand Assets"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Tech Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF4500"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Hover Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cargo Pants V2"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$185"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP34 - Tech Bestsellers",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
