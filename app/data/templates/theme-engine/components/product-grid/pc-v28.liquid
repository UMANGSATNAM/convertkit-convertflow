{%- comment -%}
  PC V28 — EARTHY TERRACOTTA CRAFT PRODUCT GRID
  Design: Warm Sand (#F7F1E5), Terracotta (#D97706) & Clay (#9A3412) accents, Fraunces & Plus Jakarta Sans typography
  Card Shape: 16px warm corners, pottery craft aesthetic, warm drop shadows
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap');

  .pcv28 {
    --bg: {{ section.settings.bg_color | default: '#F7F1E5' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#4A2810' }};
    --muted: {{ section.settings.muted_color | default: '#9A6B43' }};
    --accent: {{ section.settings.accent_color | default: '#D97706' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#B45309' }};
    --border: {{ section.settings.border_color | default: '#E5D9C5' }};
    --badge-sale-bg: #9A3412;
    --badge-sale-text: #FFFFFF;
    --f-serif: 'Fraunces', serif;
    --f-sans: 'Plus Jakarta Sans', sans-serif;
    --r-card: 16px;
    --ease: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-sans);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv28 *, .pcv28 *::before, .pcv28 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv28 a { color: inherit; text-decoration: none; }
  .pcv28 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv28 img { max-width: 100%; display: block; }

  .pcv28__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv28__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv28__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv28__title { font-family: var(--f-serif); font-size: 30px; font-weight: 700; color: var(--text); letter-spacing: -0.01em; }
  @media (min-width: 768px) { .pcv28__title { font-size: 38px; } }
  .pcv28__sub { font-size: 15px; color: var(--muted); font-style: italic; }
  .pcv28__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; color: var(--text); background: #FFFFFF; border: 1px solid var(--border); padding: 9px 20px; border-radius: 25px; transition: var(--ease); }
  .pcv28__viewall:hover { background: var(--accent); color: #FFFFFF; border-color: var(--accent); }

  /* GRID */
  .pcv28__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv28__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv28__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv28__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 10px 20px -5px rgba(154, 52, 18, 0.08);
    transition: var(--ease);
  }
  .pcv28__card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 30px -8px rgba(154, 52, 18, 0.16);
    border-color: #D97706;
  }

  /* IMAGE CONTAINER */
  .pcv28__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #EFE4D3;
    overflow: hidden;
  }
  .pcv28__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pcv28__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv28__card:hover .pcv28__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv28__card:hover .pcv28__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv28__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv28__badge { font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 4px 10px; border-radius: 12px; letter-spacing: 0.05em; font-family: var(--f-sans); }
  .pcv28__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv28__badge--tag { background: #4A2810; color: #F7F1E5; }
  .pcv28__badge--sold { background: #9A6B43; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv28__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(247, 241, 229, 0.9);
    backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv28__wish:hover { background: var(--accent); color: #FFFFFF; transform: scale(1.1); }
  .pcv28__wish.active { color: #FFFFFF; background: var(--accent); }

  /* QUICK ADD HOVER */
  .pcv28__quick-box {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    z-index: 3;
    transform: translateY(12px);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv28__card:hover .pcv28__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv28__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 14px 14px; }
  }

  .pcv28__quick-btn {
    width: 100%;
    padding: 11px 16px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 12px; font-weight: 700;
    border-radius: 20px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
    box-shadow: 0 4px 12px rgba(217, 119, 6, 0.3);
  }
  .pcv28__quick-btn:hover { background: var(--accent-hover); transform: scale(1.02); }
  .pcv28__quick-btn:disabled { background: #E5D9C5; color: #9A6B43; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv28__content { padding: 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv28__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 700; letter-spacing: 0.08em; }
  .pcv28__item-title { font-family: var(--f-serif); font-size: 17px; font-weight: 600; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv28__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; color: var(--accent); font-weight: 700; }
  .pcv28__stars { letter-spacing: 1px; }
  .pcv28__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 400; }

  /* PRICE */
  .pcv28__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv28__price { font-size: 16px; font-weight: 700; color: var(--text); font-family: var(--f-sans); }
  .pcv28__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv28__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv28__swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv28__swatch:hover, .pcv28__swatch.active { transform: scale(1.25); border-color: var(--accent); }

  /* URGENCY MICRO */
  .pcv28__urgency { font-size: 11px; color: #9A3412; font-style: italic; font-family: var(--f-serif); display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv28__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #FFFFFF;
    padding: 12px 22px; border-radius: 20px;
    font-size: 13px; font-weight: 700;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 25px rgba(217, 119, 6, 0.4);
  }
  .pcv28__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv28">
  <div class="pcv28__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv28__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv28__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv28__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv28__viewall">
            {{ section.settings.view_all_label | default: 'Explore Terracotta Craft' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv28__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v28', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v28', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv28__toast" id="pcv28-toast">Craft Piece Added!</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv28-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv28Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Crafting...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ Added';
        showT('Craft Piece Added!');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv28-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

