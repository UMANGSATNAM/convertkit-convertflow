{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FF00FF'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 4px solid #000;
  }
  
  .hp16-fp-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp16-fp-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 50px;
  }
  
  .hp16-fp-heading-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(3rem, 5vw, 5rem);
    text-transform: uppercase;
    color: #FFFF00;
    -webkit-text-stroke: 2px #000;
    text-shadow: 4px 4px 0 #000;
    margin: 0;
    line-height: 1;
    display: inline-block;
    transform: rotate(2deg);
  }
  
  .hp16-fp-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }
  
  .hp16-fp-card-{{ section_id }} {
    background: #00FFFF;
    border: 4px solid #000;
    border-radius: 20px;
    text-decoration: none;
    color: {{ text_color }};
    display: flex;
    flex-direction: column;
    box-shadow: 8px 8px 0 #000;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    overflow: hidden;
  }
  
  .hp16-fp-card-{{ section_id }}:hover {
    transform: translate(-5px, -5px);
    box-shadow: 13px 13px 0 #000;
  }
  
  .hp16-fp-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 120%;
    border-bottom: 4px solid #000;
    background: #FFF;
  }
  
  .hp16-fp-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }
  
  .hp16-fp-info-{{ section_id }} {
    padding: 15px;
    text-align: center;
  }
  
  .hp16-fp-title-{{ section_id }} {
    font-family: 'Comic Sans MS', cursive;
    font-weight: bold;
    font-size: 1.1rem;
    text-transform: uppercase;
    margin: 0 0 10px 0;
  }
  
  .hp16-fp-price-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: 1.2rem;
    color: #000;
    background: #FFFF00;
    display: inline-block;
    padding: 2px 10px;
    border-radius: 10px;
    border: 2px solid #000;
  }

  @media (max-width: 992px) {
    .hp16-fp-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
  }
</style>

<div class="hp16-fp-container-{{ section_id }}">
  <div class="hp16-fp-header-{{ section_id }}">
    <h2 class="hp16-fp-heading-{{ section_id }}">{{ section.settings.title | default: 'MUST HAVES' }}</h2>
  </div>
  
  <div class="hp16-fp-grid-{{ section_id }}">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: 4 %}
        <a href="{{ product.url }}" class="hp16-fp-card-{{ section_id }}">
          <div class="hp16-fp-image-wrap-{{ section_id }}">
            <img src="{{ product.featured_image | image_url: width: 600 }}" class="hp16-fp-image-{{ section_id }}" loading="lazy" alt="{{ product.title }}">
          </div>
          <div class="hp16-fp-info-{{ section_id }}">
            <h3 class="hp16-fp-title-{{ section_id }}">{{ product.title }}</h3>
            <div class="hp16-fp-price-{{ section_id }}">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <a href="#" class="hp16-fp-card-{{ section_id }}">
          <div class="hp16-fp-image-wrap-{{ section_id }}">
            <div class="hp16-fp-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
          </div>
          <div class="hp16-fp-info-{{ section_id }}">
            <h3 class="hp16-fp-title-{{ section_id }}">VELOUR TRACKSUIT</h3>
            <div class="hp16-fp-price-{{ section_id }}">$120.00</div>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP16 Featured Products",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FF00FF"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "MUST HAVES"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "HP16 Featured Products"
    }
  ]
}
{% endschema %}
