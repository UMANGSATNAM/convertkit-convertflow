{%- comment -%}
  PC V51 — CYBERPUNK NEON RAMEN STREET FOOD PRODUCT GRID
  Design: Dark Violet (#0D0714), Neon Pink (#FF0055) & Neon Yellow (#FFD600) accents, Bungee & Outfit typography
  Card Shape: 14px corners, 2px neon borders, Japanese arcade street food vibe
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bungee&family=Outfit:wght@500;600;700;800&display=swap');

  .pcv51 {
    --bg: {{ section.settings.bg_color | default: '#0D0714' }};
    --card-bg: {{ section.settings.card_bg | default: '#1A0E28' }};
    --text: {{ section.settings.text_color | default: '#F3E8FF' }};
    --muted: {{ section.settings.muted_color | default: '#C084FC' }};
    --accent: {{ section.settings.accent_color | default: '#FF0055' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#E0004B' }};
    --border: {{ section.settings.border_color | default: '#FF0055' }};
    --badge-sale-bg: #FFD600;
    --badge-sale-text: #0D0714;
    --f-heading: 'Bungee', cursive;
    --f-body: 'Outfit', sans-serif;
    --r-card: 14px;
    --ease: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv51 *, .pcv51 *::before, .pcv51 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv51 a { color: inherit; text-decoration: none; }
  .pcv51 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv51 img { max-width: 100%; display: block; }

  .pcv51__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv51__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv51__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv51__title { font-family: var(--f-heading); font-size: 28px; font-weight: 400; color: #FFD600; text-shadow: 0 0 10px #FF0055; letter-spacing: 0.02em; }
  @media (min-width: 768px) { .pcv51__title { font-size: 38px; } }
  .pcv51__sub { font-size: 16px; color: var(--muted); font-weight: 600; }
  .pcv51__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; font-family: var(--f-heading); color: #0D0714; background: #FFD600; padding: 10px 22px; border-radius: 20px; box-shadow: 0 0 15px rgba(255, 214, 0, 0.5); transition: var(--ease); }
  .pcv51__viewall:hover { background: #FF0055; color: #FFFFFF; box-shadow: 0 0 20px rgba(255, 0, 85, 0.7); transform: scale(1.05); }

  /* GRID */
  .pcv51__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv51__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv51__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv51__card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 0 15px rgba(255, 0, 85, 0.25);
    transition: var(--ease);
  }
  .pcv51__card:hover {
    transform: translateY(-5px) rotate(-1deg);
    border-color: #FFD600;
    box-shadow: 0 0 25px rgba(255, 214, 0, 0.5);
  }

  /* IMAGE CONTAINER */
  .pcv51__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #08040C;
    overflow: hidden;
  }
  .pcv51__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pcv51__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv51__card:hover .pcv51__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.06);
    {% endif %}
  }
  .pcv51__card:hover .pcv51__img--sec { opacity: 1; transform: scale(1.06); }

  /* BADGES */
  .pcv51__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv51__badge { font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 4px 10px; border-radius: 12px; letter-spacing: 0.05em; font-family: var(--f-heading); }
  .pcv51__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv51__badge--tag { background: #FF0055; color: #FFFFFF; }
  .pcv51__badge--sold { background: #4C1D95; color: #DDD6FE; }

  /* WISHLIST BUTTON */
  .pcv51__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(13, 7, 20, 0.85);
    border: 2px solid var(--border);
    backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    color: #FF0055;
    z-index: 3;
    transition: var(--ease);
  }
  .pcv51__wish:hover { background: #FF0055; color: #FFFFFF; border-color: #FF0055; transform: scale(1.15); box-shadow: 0 0 15px #FF0055; }
  .pcv51__wish.active { color: #FFFFFF; background: #FF0055; border-color: #FF0055; box-shadow: 0 0 15px #FF0055; }

  /* QUICK ADD BUTTON */
  .pcv51__quick-box { padding: 12px; background: var(--card-bg); }
  .pcv51__quick-btn {
    width: 100%;
    padding: 10px 16px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 12px; font-weight: 700; font-family: var(--f-heading);
    border-radius: 20px;
    border: none;
    box-shadow: 0 0 15px rgba(255, 0, 85, 0.4);
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv51__quick-btn:hover { background: var(--accent-hover); transform: scale(1.03); box-shadow: 0 0 20px rgba(255, 0, 85, 0.6); }
  .pcv51__quick-btn:disabled { background: #4C1D95; color: #DDD6FE; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv51__content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv51__vendor { font-size: 11px; text-transform: uppercase; color: #FFD600; font-weight: 700; font-family: var(--f-heading); letter-spacing: 0.05em; }
  .pcv51__item-title { font-family: var(--f-body); font-size: 17px; font-weight: 700; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv51__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 13px; color: #FFD600; font-weight: 700; }
  .pcv51__stars { letter-spacing: 1px; text-shadow: 0 0 6px #FFD600; }
  .pcv51__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 600; }

  /* PRICE */
  .pcv51__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv51__price { font-size: 18px; font-weight: 700; color: #FFFFFF; font-family: var(--f-body); text-shadow: 0 0 8px rgba(255, 255, 255, 0.4); }
  .pcv51__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv51__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv51__swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv51__swatch:hover, .pcv51__swatch.active { transform: scale(1.25); border-color: var(--accent); box-shadow: 0 0 8px var(--accent); }

  /* URGENCY MICRO */
  .pcv51__urgency { font-size: 11px; color: #FF0055; font-weight: 700; font-family: var(--f-heading); display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; text-shadow: 0 0 8px #FF0055; }

  /* TOAST */
  .pcv51__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #FFFFFF;
    padding: 12px 22px; border-radius: 20px;
    font-size: 12px; font-weight: 700; font-family: var(--f-heading);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 0 25px rgba(255, 0, 85, 0.6);
  }
  .pcv51__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv51">
  <div class="pcv51__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv51__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv51__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv51__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv51__viewall">
            {{ section.settings.view_all_label | default: 'Shop Cyber Ramen' }} 🍜 &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv51__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v51', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v51', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv51__toast" id="pcv51-toast">RAMEN BOWL ADDED!</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv51-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv51Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'COOKING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ ADDED';
        showT('RAMEN BOWL ADDED!');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv51-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

