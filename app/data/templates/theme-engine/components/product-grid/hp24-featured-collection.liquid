{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-primary: {{ section.settings.accent_primary }};
    --accent-secondary: {{ section.settings.accent_secondary }};
    --font-heading: 'Orbitron', sans-serif;
    --font-body: 'Share Tech Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Glitchy circuit lines in background */
  .hp24-collection__bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.2;
    background-image: 
      linear-gradient(var(--accent-primary) 1px, transparent 1px),
      linear-gradient(90deg, var(--accent-primary) 1px, transparent 1px);
    background-size: 50px 50px;
    background-position: center center;
    mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
  }

  .hp24-collection-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp24-collection-wrapper {
      padding: 0 20px;
    }
  }

  .hp24-collection__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: {{ section.settings.header_margin }}px;
    border-bottom: 1px solid rgba(255,255,255,0.2);
    padding-bottom: 20px;
  }

  @media screen and (max-width: 768px) {
    .hp24-collection__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }

  .hp24-collection__title-wrap {
    display: flex;
    flex-direction: column;
  }

  .hp24-collection__sys-text {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--accent-secondary);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .hp24-collection__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-shadow: 0 0 10px rgba(255,255,255,0.2);
  }

  .hp24-collection__btn {
    font-family: var(--font-body);
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    background: transparent;
    color: var(--accent-primary);
    border: 1px solid var(--accent-primary);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .hp24-collection__btn:hover {
    background: var(--accent-primary);
    color: var(--bg-color);
    box-shadow: 0 0 15px var(--accent-primary);
  }

  /* Grid */
  .hp24-collection__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 30px;
  }

  @media screen and (max-width: 992px) {
    .hp24-collection__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 600px) {
    .hp24-collection__grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 20px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .hp24-collection__grid::-webkit-scrollbar {
      display: none;
    }
  }

  /* Product Card */
  .hp24-product-card {
    position: relative;
    background: rgba(0,0,0,0.6);
    border: 1px solid rgba(255,255,255,0.1);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  @media screen and (max-width: 600px) {
    .hp24-product-card {
      flex: 0 0 80%;
      scroll-snap-align: start;
    }
  }

  /* HUD Borders on Hover */
  .hp24-product-card::before,
  .hp24-product-card::after {
    content: '';
    position: absolute;
    width: 20px;
    height: 20px;
    border: 2px solid var(--accent-primary);
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    z-index: 2;
  }

  .hp24-product-card::before {
    top: -2px; left: -2px;
    border-right: none; border-bottom: none;
    transform: translate(-10px, -10px);
  }

  .hp24-product-card::after {
    bottom: -2px; right: -2px;
    border-left: none; border-top: none;
    transform: translate(10px, 10px);
  }

  .hp24-product-card:hover {
    border-color: var(--accent-primary);
    box-shadow: 0 0 20px rgba(0, 243, 255, 0.1);
  }

  .hp24-product-card:hover::before,
  .hp24-product-card:hover::after {
    opacity: 1;
    transform: translate(0, 0);
  }

  .hp24-product-card__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    overflow: hidden;
    background: #111;
  }

  .hp24-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, filter 0.5s ease;
    filter: grayscale(0.5) contrast(1.2);
  }

  .hp24-product-card:hover .hp24-product-card__image {
    transform: scale(1.05);
    filter: grayscale(0) contrast(1.1);
  }

  /* Glitch Overlay */
  .hp24-product-card__glitch-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(255,255,255,0.05) 2px,
      rgba(255,255,255,0.05) 4px
    );
    pointer-events: none;
    z-index: 1;
  }

  .hp24-product-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--accent-secondary);
    color: var(--bg-color);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    padding: 2px 8px;
    text-transform: uppercase;
    z-index: 2;
  }

  .hp24-product-card__info {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .hp24-product-card__vendor {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--accent-secondary);
    margin-bottom: 5px;
    text-transform: uppercase;
  }

  .hp24-product-card__title {
    font-family: var(--font-heading);
    font-size: 16px;
    color: var(--text-color);
    margin: 0 0 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .hp24-product-card__price-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
  }

  .hp24-product-card__price {
    font-family: var(--font-body);
    font-size: 18px;
    color: var(--accent-primary);
    font-weight: 700;
  }

  .hp24-product-card__price--compare {
    font-size: 14px;
    color: rgba(255,255,255,0.5);
    text-decoration: line-through;
  }

  .hp24-product-card__action {
    margin-top: 20px;
    width: 100%;
    padding: 10px;
    background: transparent;
    border: 1px dashed rgba(255,255,255,0.3);
    color: var(--text-color);
    font-family: var(--font-body);
    font-size: 14px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hp24-product-card:hover .hp24-product-card__action {
    border-color: var(--accent-primary);
    border-style: solid;
    color: var(--accent-primary);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp24-collection-wrapper" id="HP24Featured-{{ section.id }}">
  <div class="hp24-collection__bg"></div>

  <div class="hp24-collection__header">
    <div class="hp24-collection__title-wrap">
      <div class="hp24-collection__sys-text">DATA.QUERY: COLLECTION</div>
      {%- if section.settings.title != blank -%}
        <h2 class="hp24-collection__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>

    {%- if section.settings.btn_text != blank -%}
      <a href="{{ section.settings.collection.url | default: '#' }}" class="hp24-collection__btn">
        {{ section.settings.btn_text | escape }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp24-collection__grid">
    {%- assign collection = section.settings.collection -%}
    {%- assign limit = section.settings.limit -%}
    
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: limit -%}
        <a href="{{ product.url }}" class="hp24-product-card" {{ block.shopify_attributes }}>
          
          <div class="hp24-product-card__image-wrapper">
            {%- if product.compare_at_price > product.price -%}
              <div class="hp24-product-card__badge">SALE</div>
            {%- endif -%}

            <div class="hp24-product-card__glitch-overlay"></div>

            <img 
              src="{{ product.featured_image | image_url: width: 600 }}" 
              alt="{{ product.title | escape }}"
              class="hp24-product-card__image"
              loading="lazy"
            >
          </div>

          <div class="hp24-product-card__info">
            <div class="hp24-product-card__vendor">{{ product.vendor | default: "SYS.VENDOR" }}</div>
            <h3 class="hp24-product-card__title">{{ product.title }}</h3>
            
            <div class="hp24-product-card__price-wrapper">
              <span class="hp24-product-card__price">{{ product.price | money }}</span>
              {%- if product.compare_at_price > product.price -%}
                <span class="hp24-product-card__price--compare">{{ product.compare_at_price | money }}</span>
              {%- endif -%}
            </div>

            <button class="hp24-product-card__action">ADD TO SYS_CART</button>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..limit) -%}
        <a href="#" class="hp24-product-card">
          <div class="hp24-product-card__image-wrapper">
            <div class="hp24-product-card__badge">NEW</div>
            <div class="hp24-product-card__glitch-overlay"></div>
            <div style="width:100%;height:100%;background:#222;display:flex;align-items:center;justify-content:center;color:#444;font-family:'Share Tech Mono';">IMG.ERROR</div>
          </div>
          <div class="hp24-product-card__info">
            <div class="hp24-product-card__vendor">SYS.VENDOR</div>
            <h3 class="hp24-product-card__title">NEURAL IMPLANT V{{ i }}</h3>
            <div class="hp24-product-card__price-wrapper">
              <span class="hp24-product-card__price">$99.00</span>
            </div>
            <button class="hp24-product-card__action">ADD TO SYS_CART</button>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP24 - Cyber Collection",
  "class": "section-hp24-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "UPGRADE MODULES"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "VIEW ALL MODULES"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 40
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to Show",
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "16/9", "label": "Landscape (16:9)" }
      ],
      "default": "1/1"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Cyberpunk Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_primary",
      "label": "Accent Primary (Neon Blue)",
      "default": "#00F3FF"
    },
    {
      "type": "color",
      "id": "accent_secondary",
      "label": "Accent Secondary (Neon Pink)",
      "default": "#FF00E6"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP24 - Cyber Collection"
    }
  ]
}
{% endschema %}
