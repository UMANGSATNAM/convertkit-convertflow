{% comment %} Lookbook / Shoppable Editorial — Interactive hotspots with product tooltips and tokenized luxury layout {% endcomment %}

<section class="sf-lb sf-lb-{{ section.id }}" id="sf-lb-{{ section.id }}">
  <div class="sf-lb-container">
    <div class="sf-lb-image-col sf-reveal">
      <div class="sf-lb-image-wrapper">
        {% assign img_src = section.settings.image %}
        {% if img_src != blank %}
          <img src="{{ img_src | image_url: width: 1400 }}" alt="{{ section.settings.title | escape }}" loading="lazy" width="800" height="1000">
        {% else %}
          <img src="{{ 'placeholder-beauty-lookbook-1.jpg' | asset_url }}" alt="Placeholder Lookbook" loading="lazy" width="800" height="1000">
        {% endif %}
        
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <div class="sf-lb-hotspot" style="top: {{ block.settings.top }}%; left: {{ block.settings.left }}%;" {{ block.shopify_attributes }}>
              <button type="button" class="sf-lb-dot" aria-label="View product details"></button>
              <div class="sf-lb-tooltip">
                {% if block.settings.product != blank %}
                  {% assign lb_prod = all_products[block.settings.product] %}
                  {% if lb_prod != blank %}
                    <a href="{{ lb_prod.url }}" class="sf-lb-tt-link">
                      {% if lb_prod.featured_image != blank %}
                        <img src="{{ lb_prod.featured_image | image_url: width: 200, height: 200 }}" alt="{{ lb_prod.title | escape }}" loading="lazy" width="60" height="60">
                      {% endif %}
                      <div class="sf-lb-tt-info">
                        <strong class="sf-lb-tt-title">{{ lb_prod.title }}</strong>
                        <span class="sf-lb-tt-price">{{ lb_prod.price | money }}</span>
                      </div>
                    </a>
                  {% endif %}
                {% else %}
                  <div class="sf-lb-tt-link">
                    <div class="sf-lb-tt-placeholder-img"></div>
                    <div class="sf-lb-tt-info">
                      <strong class="sf-lb-tt-title">Signature Creation #{{ forloop.index }}</strong>
                      <span class="sf-lb-tt-price">$450.00</span>
                    </div>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          {%- comment -%} Default placeholder hotspots {%- endcomment -%}
          <div class="sf-lb-hotspot" style="top: 38%; left: 42%;">
            <button type="button" class="sf-lb-dot" aria-label="View product details"></button>
            <div class="sf-lb-tooltip">
              <div class="sf-lb-tt-link">
                <div class="sf-lb-tt-placeholder-img"></div>
                <div class="sf-lb-tt-info">
                  <strong class="sf-lb-tt-title">Signature Luxury Piece</strong>
                  <span class="sf-lb-tt-price">$1,250.00</span>
                </div>
              </div>
            </div>
          </div>
          <div class="sf-lb-hotspot" style="top: 65%; left: 58%;">
            <button type="button" class="sf-lb-dot" aria-label="View product details"></button>
            <div class="sf-lb-tooltip">
              <div class="sf-lb-tt-link">
                <div class="sf-lb-tt-placeholder-img"></div>
                <div class="sf-lb-tt-info">
                  <strong class="sf-lb-tt-title">Curated Editorial Piece</strong>
                  <span class="sf-lb-tt-price">$890.00</span>
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="sf-lb-text-col sf-reveal sf-reveal-delay-2">
      {% if section.settings.label != blank %}
        <span class="sf-section-label">{{ section.settings.label }}</span>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="sf-lb-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="sf-lb-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
      {% if section.settings.btn_link != blank and section.settings.btn_label != blank %}
        <a href="{{ section.settings.btn_link }}" class="sf-lb-btn">{{ section.settings.btn_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .sf-lb-{{ section.id }} {
    padding: var(--space-64, 5rem) var(--space-20, 1.25rem);
    background: var(--color-background);
    color: var(--color-text);
  }
  .sf-lb-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-48, 3rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .sf-lb-container {
      flex-direction: row;
      gap: var(--space-64, 4.5rem);
    }
    .sf-lb-image-col { flex: 1.2; width: 100%; }
    .sf-lb-text-col { flex: 0.8; width: 100%; }
  }
  .sf-lb-image-wrapper {
    position: relative;
    width: 100%;
    border-radius: var(--card-radius, 8px);
    overflow: visible;
    background: var(--color-surface);
  }
  .sf-lb-image-wrapper img, .sf-placeholder {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--card-radius, 8px);
    object-fit: cover;
  }
  .sf-lb-hotspot {
    position: absolute;
    z-index: 10;
    transform: translate(-50%, -50%);
  }
  .sf-lb-dot {
    display: block;
    width: 28px;
    height: 28px;
    background: var(--color-background);
    border: none;
    border-radius: 50%;
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-background) 40%, transparent);
    cursor: pointer;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .sf-lb-dot::after {
    content: '';
    position: absolute;
    inset: 7px;
    background: var(--color-accent);
    border-radius: 50%;
  }
  .sf-lb-hotspot:hover .sf-lb-dot,
  .sf-lb-dot:focus {
    transform: scale(1.15);
    box-shadow: 0 0 0 8px color-mix(in srgb, var(--color-accent) 25%, transparent);
  }
  .sf-lb-tooltip {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(12px);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-12, 12px) var(--space-16, 16px);
    border-radius: var(--card-radius, 8px);
    box-shadow: 0 16px 32px color-mix(in srgb, var(--color-text) 12%, transparent);
    display: none;
    width: max-content;
    max-width: 260px;
    margin-bottom: 16px;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
    z-index: 20;
  }
  .sf-lb-hotspot:hover .sf-lb-tooltip,
  .sf-lb-hotspot:focus-within .sf-lb-tooltip {
    display: block;
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }
  .sf-lb-tt-link {
    display: flex;
    align-items: center;
    gap: var(--space-12, 12px);
    text-decoration: none;
    color: var(--color-text);
  }
  .sf-lb-tt-link img {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .sf-lb-tt-placeholder-img {
    width: 56px;
    height: 56px;
    background: var(--color-border);
    border-radius: 4px;
    flex-shrink: 0;
  }
  .sf-lb-tt-info {
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  .sf-lb-tt-title {
    font-family: var(--font-heading-family, serif);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 2px;
  }
  .sf-lb-tt-price {
    font-family: var(--font-body-family, sans-serif);
    font-size: 0.825rem;
    color: var(--color-text);
    font-weight: 500;
  }
  .sf-section-label {
    display: block;
    font-family: var(--font-body-family, sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-secondary, var(--color-text));
    margin-bottom: var(--space-12, 0.75rem);
  }
  .sf-lb-title {
    font-family: var(--font-heading-family, serif);
    font-weight: 400;
    font-size: var(--font-h2, clamp(2rem, 4vw, 3.2rem));
    color: var(--color-text);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-16, 1rem);
    line-height: var(--leading-heading, 1.2);
  }
  .sf-lb-subtitle {
    font-family: var(--font-body-family, sans-serif);
    font-size: var(--font-body, 1.05rem);
    color: var(--color-text-secondary, var(--color-text));
    line-height: var(--leading-body, 1.6);
    margin-bottom: var(--space-32, 2rem);
  }
  .sf-lb-btn {
    display: inline-block;
    padding: var(--space-16, 1rem) var(--space-32, 2rem);
    background: var(--color-text);
    color: var(--color-background);
    font-family: var(--font-body-family, sans-serif);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--btn-radius, 4px);
    transition: background 0.3s ease, transform 0.3s ease;
  }
  .sf-lb-btn:hover {
    background: var(--color-accent);
    color: var(--color-background);
    transform: translateY(-2px);
  }
</style>

{% schema %}
{
  "name": "Lookbook Editorial",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow Label", "default": "Curated Ensemble" },
    { "type": "text", "id": "title", "label": "Title", "default": "Signature Lookbook" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Explore our curated editorial ensemble and interact with hotspots to discover the signature pieces." },
    { "type": "image_picker", "id": "image", "label": "Lookbook Image", "info": "Placeholder — replace with your own image" },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Explore Collection" },
    { "type": "url", "id": "btn_link", "label": "Button Link" }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Product Hotspot",
      "settings": [
        { "type": "range", "id": "top", "min": 5, "max": 95, "step": 1, "label": "Position Top (%)", "default": 45 },
        { "type": "range", "id": "left", "min": 5, "max": 95, "step": 1, "label": "Position Left (%)", "default": 50 },
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook Editorial",
      "category": "Product Grid",
      "blocks": [
        { "type": "hotspot", "settings": { "top": 38, "left": 42 } },
        { "type": "hotspot", "settings": { "top": 65, "left": 58 } }
      ]
    }
  ]
}
{% endschema %}
