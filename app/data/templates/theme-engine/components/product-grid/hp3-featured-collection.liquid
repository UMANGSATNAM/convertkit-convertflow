{%- liquid
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ffcc'
  
  assign collection = collections[section.settings.collection]
  assign product_limit = section.settings.product_limit
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp3-fc-bg: {{ bg_color }};
    --hp3-fc-text: {{ text_color }};
    --hp3-fc-accent: {{ accent_color }};
    
    --hp3-fc-pt-desk: {{ padding_top_desktop }}px;
    --hp3-fc-pb-desk: {{ padding_bottom_desktop }}px;
    --hp3-fc-pt-mob: {{ padding_top_mobile }}px;
    --hp3-fc-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp3-tech-fc-{{ section.id }} {
    padding-top: var(--hp3-fc-pt-desk);
    padding-bottom: var(--hp3-fc-pb-desk);
    background-color: var(--hp3-fc-bg);
    color: var(--hp3-fc-text);
    font-family: 'Inter', -apple-system, sans-serif;
  }

  .hp3-fc-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Header */
  .hp3-fc-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 20px;
  }

  .hp3-fc-title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -1px;
    margin: 0;
    position: relative;
    display: inline-block;
  }
  
  .hp3-fc-title::after {
    content: '';
    position: absolute;
    bottom: -21px; /* Align with border */
    left: 0;
    width: 50%;
    height: 3px;
    background: var(--hp3-fc-accent);
  }

  .hp3-fc-view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--hp3-fc-text);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: color 0.3s ease;
  }
  .hp3-fc-view-all:hover {
    color: var(--hp3-fc-accent);
  }

  /* Grid */
  .hp3-fc-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 30px;
  }

  /* Product Card */
  .hp3-fc-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 12px;
    padding: 20px;
    position: relative;
    transition: all 0.4s ease;
    display: flex;
    flex-direction: column;
    group;
  }

  .hp3-fc-card:hover {
    background: rgba(255,255,255,0.05);
    border-color: rgba(255,255,255,0.2);
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  }

  .hp3-fc-card-media {
    position: relative;
    aspect-ratio: 1/1;
    background: #000;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .hp3-fc-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  
  .hp3-fc-card:hover .hp3-fc-card-img {
    transform: scale(1.05);
  }

  .hp3-fc-card-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--hp3-fc-accent);
    color: #000;
    padding: 4px 10px;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 4px;
    z-index: 2;
  }

  .hp3-fc-card-info {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .hp3-fc-card-title {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 10px 0;
    line-height: 1.3;
    text-decoration: none;
    color: var(--hp3-fc-text);
  }

  .hp3-fc-card-price {
    font-size: 16px;
    font-weight: 400;
    color: rgba(255,255,255,0.7);
    margin-bottom: 20px;
  }
  
  .hp3-fc-card-price s {
    opacity: 0.5;
    margin-right: 8px;
    font-size: 14px;
  }

  .hp3-fc-card-btn {
    margin-top: auto;
    width: 100%;
    padding: 12px;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.2);
    color: var(--hp3-fc-text);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
    text-decoration: none;
  }

  .hp3-fc-card-btn:hover {
    background: var(--hp3-fc-text);
    color: #000;
    border-color: var(--hp3-fc-text);
  }
  
  /* Quick view specific tech hover */
  .hp3-fc-card-quick {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0,0,0,0.8);
    color: var(--hp3-fc-accent);
    padding: 10px 20px;
    border: 1px solid var(--hp3-fc-accent);
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    opacity: 0;
    transition: all 0.3s ease;
    z-index: 3;
  }
  
  .hp3-fc-card-media:hover .hp3-fc-card-quick {
    opacity: 1;
  }

  @media screen and (max-width: 1024px) {
    .hp3-fc-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp3-tech-fc-{{ section.id }} {
      padding-top: var(--hp3-fc-pt-mob);
      padding-bottom: var(--hp3-fc-pb-mob);
    }
    .hp3-fc-inner {
      padding: 0 20px;
    }
    .hp3-fc-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
    .hp3-fc-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: 15px;
    }
    .hp3-fc-card {
      padding: 15px;
    }
    .hp3-fc-card-title {
      font-size: 14px;
    }
    .hp3-fc-card-price {
      font-size: 14px;
      margin-bottom: 15px;
    }
    .hp3-fc-card-btn {
      font-size: 11px;
      padding: 10px;
    }
  }
</style>

<section class="hp3-tech-fc-{{ section.id }}" aria-label="Featured Collection">
  <div class="hp3-fc-inner">
    
    <div class="hp3-fc-header">
      <h2 class="hp3-fc-title">{{ section.settings.heading | default: 'FEATURED TECH' }}</h2>
      {%- if collection != blank -%}
        <a href="{{ collection.url }}" class="hp3-fc-view-all">
          EXPLORE ALL
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="hp3-fc-grid">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: product_limit -%}
          <div class="hp3-fc-card">
            <a href="{{ product.url }}" class="hp3-fc-card-media">
              {%- if product.compare_at_price > product.price -%}
                <div class="hp3-fc-card-badge">SALE</div>
              {%- endif -%}
              
              <img src="{{ product.featured_image | image_url: width: 600 }}" 
                   class="hp3-fc-card-img" 
                   loading="lazy" 
                   alt="{{ product.title | escape }}">
                   
              <div class="hp3-fc-card-quick">VIEW SPECS</div>
            </a>
            
            <div class="hp3-fc-card-info">
              <a href="{{ product.url }}" class="hp3-fc-card-title">{{ product.title }}</a>
              <div class="hp3-fc-card-price">
                {%- if product.compare_at_price > product.price -%}
                  <s>{{ product.compare_at_price | money }}</s>
                {%- endif -%}
                {{ product.price | money }}
              </div>
              
              {%- form 'product', product -%}
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                <button type="submit" class="hp3-fc-card-btn" {% unless product.available %}disabled{% endunless %}>
                  {%- if product.available -%}
                    ADD TO CART
                  {%- else -%}
                    SOLD OUT
                  {%- endif -%}
                </button>
              {%- endform -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..product_limit) -%}
          <div class="hp3-fc-card">
            <div class="hp3-fc-card-media">
               {%- capture current -%}{% cycle 1, 2, 3, 4, 5, 6 %}{%- endcapture -%}
               {{ 'product-' | append: current | placeholder_svg_tag: 'hp3-fc-card-img placeholder-svg' }}
            </div>
            <div class="hp3-fc-card-info">
              <a href="#" class="hp3-fc-card-title">Pro Gaming Headset V2</a>
              <div class="hp3-fc-card-price">$149.99</div>
              <button class="hp3-fc-card-btn">ADD TO CART</button>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP3 Featured Collection",
  "tag": "section",
  "class": "section-hp3-fc",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LATEST DROPS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2, "max": 12, "step": 1,
      "label": "Product Limit",
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2, "max": 5, "step": 1,
      "label": "Columns (Desktop)", "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2, "max": 4, "step": 1,
      "label": "Columns (Tablet)", "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ffcc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP3 Featured Collection (Adv)",
      "category": "Product"
    }
  ]
}
{% endschema %}
