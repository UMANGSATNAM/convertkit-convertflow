{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Syne:wght@700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Syne', sans-serif;
    --font-body: 'Space Mono', monospace;
    
    background-color: var(--bg-color);
    border-bottom: 4px solid var(--border-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp32-fc-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp32-fc-wrapper {
      padding: 0 20px;
    }
  }

  .hp32-fc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    border-bottom: 4px solid var(--border-color);
    padding-bottom: 20px;
  }

  @media screen and (max-width: 768px) {
    .hp32-fc__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp32-fc__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: #000;
    text-transform: uppercase;
    margin: 0;
    letter-spacing: -1px;
  }

  .hp32-fc__title::before {
    content: '>';
    color: var(--accent-color);
    margin-right: 10px;
  }

  .hp32-fc__link {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    color: #000;
    text-decoration: none;
    background: var(--accent-color);
    padding: 8px 16px;
    border: 2px solid var(--border-color);
    box-shadow: 4px 4px 0 var(--border-color);
    transition: all 0.1s ease;
  }

  .hp32-fc__link:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--border-color);
  }

  .hp32-fc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp32-fc__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media screen and (max-width: 576px) {
    .hp32-fc__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp32-fc__product {
    background: #ffffff;
    border: 4px solid var(--border-color);
    box-shadow: 8px 8px 0 var(--border-color);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .hp32-fc__product:hover {
    transform: translate(4px, 4px);
    box-shadow: 4px 4px 0 var(--border-color);
  }

  .hp32-fc__image-wrap {
    width: 100%;
    aspect-ratio: 1/1;
    border-bottom: 4px solid var(--border-color);
    position: relative;
    overflow: hidden;
    background: #f4f4f4;
  }

  .hp32-fc__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(120%);
    transition: filter 0.3s ease;
  }

  .hp32-fc__product:hover .hp32-fc__image {
    filter: contrast(100%);
  }

  .hp32-fc__tag {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--accent-color);
    color: #000;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    padding: 4px 8px;
    border: 2px solid var(--border-color);
    text-transform: uppercase;
  }

  .hp32-fc__info {
    padding: 20px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .hp32-fc__vendor {
    font-family: var(--font-body);
    font-size: 12px;
    color: #000;
    text-transform: uppercase;
    font-weight: 700;
    opacity: 0.5;
    margin-bottom: 8px;
  }

  .hp32-fc__product-title {
    font-family: var(--font-heading);
    font-size: 20px;
    color: #000;
    margin: 0 0 10px;
    text-transform: uppercase;
    text-decoration: none;
  }

  .hp32-fc__price-wrap {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    color: #000;
    margin-bottom: 20px;
  }

  .hp32-fc__compare-price {
    text-decoration: line-through;
    opacity: 0.5;
    font-size: 14px;
    margin-left: 8px;
  }

  .hp32-fc__btn {
    width: 100%;
    background: #000;
    color: var(--accent-color);
    border: none;
    padding: 15px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    margin-top: auto;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .hp32-fc__product:hover .hp32-fc__btn {
    background: var(--accent-color);
    color: #000;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp32-fc-wrapper" id="HP32Featured-{{ section.id }}">
  <div class="hp32-fc__header">
    <h2 class="hp32-fc__title">{{ section.settings.title }}</h2>
    {%- if section.settings.view_all_label != blank -%}
      <a href="{{ section.settings.view_all_link | default: '#' }}" class="hp32-fc__link">
        {{ section.settings.view_all_label }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp32-fc__grid">
    {%- for block in section.blocks -%}
      <div class="hp32-fc__product" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.product_link | default: '#' }}" class="hp32-fc__image-wrap">
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" class="hp32-fc__image" loading="lazy">
          {%- else -%}
            {%- assign placeholder = 'product-' | append: forloop.index -%}
            {%- if forloop.index > 6 -%}{%- assign placeholder = 'product-1' -%}{%- endif -%}
            {{ placeholder | placeholder_svg_tag: 'hp32-fc__image' }}
          {%- endif -%}
          
          {%- if block.settings.tag != blank -%}
            <div class="hp32-fc__tag">{{ block.settings.tag }}</div>
          {%- endif -%}
        </a>
        
        <div class="hp32-fc__info">
          {%- if block.settings.vendor != blank -%}
            <div class="hp32-fc__vendor">{{ block.settings.vendor }}</div>
          {%- endif -%}
          
          <a href="{{ block.settings.product_link | default: '#' }}" class="hp32-fc__product-title">
            {{ block.settings.title }}
          </a>
          
          <div class="hp32-fc__price-wrap">
            <span class="hp32-fc__price">{{ block.settings.price }}</span>
            {%- if block.settings.compare_price != blank -%}
              <span class="hp32-fc__compare-price">{{ block.settings.compare_price }}</span>
            {%- endif -%}
          </div>
          
          <button type="button" class="hp32-fc__btn">Add to Cart</button>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP32 - Brutalist Features",
  "class": "section-hp32-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "LATEST_DROPS"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Label",
      "default": "VIEW CATALOG"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 50
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Light Grey)",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (e.g. Lime)",
      "default": "#ccff00"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Badge/Tag",
          "default": "HOT"
        },
        {
          "type": "text",
          "id": "vendor",
          "label": "Vendor/Category",
          "default": "HARDWARE"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "UNIT-01 JACKET"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$240.00"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP32 - Brutalist Features",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
