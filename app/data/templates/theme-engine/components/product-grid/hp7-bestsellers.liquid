{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f7f4ed'
  assign text_color = section.settings.text_color | default: '#2b302a'
  assign accent_color = section.settings.accent_color | default: '#4a6741'
  assign heading = section.settings.heading | default: 'Our Most Loved'
  assign collection = collections[section.settings.collection]
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
    position: relative;
    overflow: hidden;
  }
  
  .hp7-best-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp7-best-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .hp7-best-header-{{ section_id }} h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 500;
    margin: 0;
    color: {{ text_color }};
  }
  
  /* Horizontal scroll for products */
  .hp7-best-scroll-{{ section_id }} {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    padding-bottom: 40px;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none;  /* IE and Edge */
    scroll-snap-type: x mandatory;
  }
  
  .hp7-best-scroll-{{ section_id }}::-webkit-scrollbar {
    display: none;
  }
  
  .hp7-best-item-{{ section_id }} {
    flex: 0 0 calc(25% - 22.5px);
    min-width: 280px;
    scroll-snap-align: start;
  }
  
  .hp7-best-image-wrapper-{{ section_id }} {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 20px;
  }
  
  .hp7-best-image-wrapper-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  
  .hp7-best-item-{{ section_id }}:hover .hp7-best-image-wrapper-{{ section_id }} img {
    transform: scale(1.03);
  }
  
  .hp7-best-badge-{{ section_id }} {
    position: absolute;
    top: 15px;
    left: 15px;
    background: {{ bg_color }};
    color: {{ accent_color }};
    padding: 5px 12px;
    border-radius: 20px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }
  
  .hp7-best-title-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 5px 0;
    color: {{ text_color }};
    text-decoration: none;
  }
  
  .hp7-best-price-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    color: rgba({{ text_color | color_to_rgb | remove: 'rgb(' | remove: ')' }}, {{ 0.7 }});
    font-size: 1rem;
  }

  @media (max-width: 1024px) {
    .hp7-best-item-{{ section_id }} {
      flex: 0 0 calc(33.333% - 20px);
    }
  }
  
  @media (max-width: 768px) {
    .hp7-best-item-{{ section_id }} {
      flex: 0 0 calc(50% - 15px);
    }
  }
  
  @media (max-width: 480px) {
    .hp7-best-item-{{ section_id }} {
      flex: 0 0 calc(80% - 15px);
    }
  }
</style>

<div class="hp7-best-container-{{ section_id }}">
  <div class="hp7-best-header-{{ section_id }}">
    <h2>{{ heading }}</h2>
  </div>
  
  <div class="hp7-best-scroll-{{ section_id }}">
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: 6 %}
        <div class="hp7-best-item-{{ section_id }}">
          <a href="{{ product.url }}" class="hp7-best-image-wrapper-{{ section_id }}" style="display: block;">
            {% if forloop.index <= 3 %}
              <div class="hp7-best-badge-{{ section_id }}">Best Seller</div>
            {% endif %}
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" loading="lazy" width="400" height="500">
          </a>
          <a href="{{ product.url }}" style="text-decoration: none;">
            <h3 class="hp7-best-title-{{ section_id }}">{{ product.title }}</h3>
          </a>
          <div class="hp7-best-price-{{ section_id }}">{{ product.price | money }}</div>
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..5) %}
        <div class="hp7-best-item-{{ section_id }}">
          <div class="hp7-best-image-wrapper-{{ section_id }}" style="background: #e0ddd5; display:flex; align-items:center; justify-content:center; color:#999;">
            Image
          </div>
          <h3 class="hp7-best-title-{{ section_id }}">Eco Product {{ i }}</h3>
          <div class="hp7-best-price-{{ section_id }}">$65.00</div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP7 Bestsellers",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f7f4ed"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2b302a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#4a6741"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Most Loved"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "HP7 Bestsellers"
    }
  ]
}
{% endschema %}
