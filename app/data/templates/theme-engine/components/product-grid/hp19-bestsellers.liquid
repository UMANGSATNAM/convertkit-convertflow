{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --bg-color: {{ section.settings.bg_color }};
    --heading-color: {{ section.settings.heading_color }};
    --grid-gap: {{ section.settings.grid_gap }}px;
    
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    background-color: var(--bg-color);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      --padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
      --grid-gap: {{ section.settings.mobile_grid_gap }}px;
    }
  }

  .hp19-best-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: {{ section.settings.header_alignment }};
  }

  .hp19-best__title {
    font-family: 'Baskerville', 'Georgia', serif;
    font-size: clamp(32px, 6vw, {{ section.settings.title_size }}px);
    color: var(--heading-color);
    margin: 0 0 {{ section.settings.header_margin }}px;
    font-style: italic;
  }

  .hp19-best__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    gap: var(--grid-gap);
    text-align: left;
  }

  @media screen and (max-width: 992px) {
    .hp19-best__grid {
      grid-template-columns: repeat({{ section.settings.tablet_columns }}, 1fr);
    }
  }

  @media screen and (max-width: 576px) {
    .hp19-best__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
    }
  }

  .hp19-best__empty-card {
    background: {{ section.settings.bg_color | color_darken: 5 }};
    aspect-ratio: 3/4;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--heading-color);
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    text-transform: uppercase;
    border-radius: {{ section.settings.card_radius }}px;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }
  
  .hp19-best__empty-card:hover {
    opacity: 1;
  }

  {% if section.settings.show_view_all %}
  .hp19-best__footer {
    margin-top: 48px;
    text-align: center;
  }
  .hp19-best__view-all {
    display: inline-block;
    padding: 12px 32px;
    border: 1px solid var(--heading-color);
    color: var(--heading-color);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    text-decoration: none;
    transition: all 0.3s;
  }
  .hp19-best__view-all:hover {
    background: var(--heading-color);
    color: var(--bg-color);
  }
  {% endif %}

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp19-best-wrapper" id="HP19Bestsellers-{{ section.id }}">
  {%- if section.settings.title != blank -%}
    <h2 class="hp19-best__title">{{ section.settings.title | escape }}</h2>
  {%- endif -%}
  
  <div class="hp19-best__grid">
    {%- assign target_coll = collections[section.settings.collection] -%}
    {%- assign product_limit = section.settings.product_limit -%}
    
    {%- if target_coll != blank and target_coll.products.size > 0 -%}
      {%- for product in target_coll.products limit: product_limit -%}
        {%- render 'card-v19', product: product, show_secondary_image: section.settings.show_secondary_image, show_vendor: section.settings.show_vendor, show_rating: section.settings.show_rating -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..product_limit) -%}
        <div class="hp19-best__empty-card">
          Product Placeholder {{ i }}
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.show_view_all and section.settings.collection != blank -%}
    <div class="hp19-best__footer">
      <a href="{{ target_coll.url }}" class="hp19-best__view-all">View All {{ target_coll.title }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP19 - Bestsellers Pro",
  "class": "section-hp19-bestsellers",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Classics"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Button",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1360
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Maximum Products to Show",
      "default": 3
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on Tablet",
      "default": 2
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns on Mobile",
      "default": 1
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Grid Gap (Desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_grid_gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Grid Gap (Mobile)",
      "default": 48
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Spacing Below Header",
      "default": 64
    },
    {
      "type": "header",
      "content": "Card Settings"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "default": false
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius (if applicable)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Typography & Colors"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FEF3C7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#451A03"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP19 - Bestsellers Pro",
      "category": "Collection"
    }
  ]
}
{% endschema %}
