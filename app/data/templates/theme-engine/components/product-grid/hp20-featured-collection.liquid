{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: {{ section.settings.border_color }};
    --border-thickness: {{ section.settings.border_thickness }}px;
    --shadow-color: {{ section.settings.shadow_color }};
    --shadow-offset: {{ section.settings.shadow_offset }}px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp20-fc-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp20-fc__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: {{ section.settings.header_margin }}px;
    border-bottom: var(--border-thickness) solid var(--border-color);
    padding-bottom: 16px;
  }
  
  @media screen and (max-width: 768px) {
    .hp20-fc__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }

  .hp20-fc__title {
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: -1px;
    margin: 0;
    line-height: 1;
  }

  .hp20-fc__view-all {
    display: inline-flex;
    align-items: center;
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--bg-color);
    background: var(--text-color);
    padding: 10px 20px;
    text-decoration: none;
    border: var(--border-thickness) solid var(--border-color);
    box-shadow: calc(var(--shadow-offset) / 2) calc(var(--shadow-offset) / 2) 0px var(--shadow-color);
    transition: all 0.2s;
  }
  
  .hp20-fc__view-all:hover {
    background: var(--accent-color);
    color: var(--text-color);
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--shadow-color);
  }

  .hp20-fc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
  }

  @media screen and (max-width: 992px) {
    .hp20-fc__grid {
      grid-template-columns: repeat({{ section.settings.tablet_columns }}, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp20-fc__grid {
      {% if section.settings.mobile_layout == 'swipe' %}
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 24px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin-left: -24px;
      margin-right: -24px;
      padding-left: 24px;
      padding-right: 24px;
      gap: 16px;
      {% else %}
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      gap: {{ section.settings.mobile_grid_gap }}px;
      {% endif %}
    }
    
    {% if section.settings.mobile_layout == 'swipe' %}
    .hp20-fc__grid::-webkit-scrollbar {
      display: none;
    }
    .hp20-fc__grid > * {
      flex: 0 0 75%;
      scroll-snap-align: start;
    }
    {% endif %}
  }

  /* Custom Brutalist Product Card Override */
  .hp20-fc__grid .card-v20 { /* Assuming card-v20 snippet handles this styling, but injecting here just in case */
    border: var(--border-thickness) solid var(--border-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0px var(--shadow-color);
    background: #fff;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  
  .hp20-fc__grid .card-v20:hover {
    transform: translate(calc(var(--shadow-offset) * -0.2), calc(var(--shadow-offset) * -0.2));
    box-shadow: calc(var(--shadow-offset) * 1.2) calc(var(--shadow-offset) * 1.2) 0px var(--shadow-color);
  }

  .hp20-fc__empty-state {
    background: #fff;
    border: var(--border-thickness) dashed var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 3/4;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-color);
    opacity: 0.5;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp20-fc-wrapper" id="HP20FeaturedCollection-{{ section.id }}">
  
  <div class="hp20-fc__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp20-fc__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    
    {%- assign target_coll = collections[section.settings.collection] -%}
    {%- if section.settings.show_view_all and target_coll != blank -%}
      <a href="{{ target_coll.url }}" class="hp20-fc__view-all">VIEW ALL</a>
    {%- endif -%}
  </div>

  <div class="hp20-fc__grid">
    {%- assign product_limit = section.settings.product_limit -%}
    
    {%- if target_coll != blank and target_coll.products.size > 0 -%}
      {%- for product in target_coll.products limit: product_limit -%}
        <!-- Using a hypothetical card-v20 snippet for brutalist styling -->
        {%- render 'card-v20', product: product, show_secondary_image: section.settings.show_secondary_image, show_vendor: section.settings.show_vendor -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..product_limit) -%}
        <div class="hp20-fc__empty-state">
          PRODUCT {{ i }}
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "HP20 - Brutalist Products",
  "class": "section-hp20-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HEAVY HITTERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'VIEW ALL' Button",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Product Limit",
      "default": 4
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Tablet Columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Mobile Columns (if stacked)",
      "default": 1
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout",
      "options": [
        { "value": "stack", "label": "Stacked" },
        { "value": "swipe", "label": "Horizontal Swipe" }
      ],
      "default": "swipe"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_grid_gap",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 40
    },
    {
      "type": "header",
      "content": "Card Settings"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Brutalist Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Border Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#E2FF00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Thickness",
      "default": 3
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Hard Shadow Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "shadow_offset",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Hard Shadow Offset",
      "default": 8
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP20 - Brutalist Products",
      "category": "Collection"
    }
  ]
}
{% endschema %}
