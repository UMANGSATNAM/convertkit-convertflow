{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp44-bs-bg: {{ section.settings.bg_color | default: '#EDF4EE' }};
    --hp44-bs-card: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --hp44-bs-border: {{ section.settings.card_border | default: '#D8E8DC' }};
    --hp44-bs-title: {{ section.settings.title_color | default: '#143D2B' }};
    --hp44-bs-accent: {{ section.settings.accent_color | default: '#2D6A4F' }};
    
    background-color: var(--hp44-bs-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp44-bs__wrapper {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp44-bs__title-block {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp44-bs__subhead {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--hp44-bs-accent);
    margin: 0 0 8px;
  }

  .hp44-bs__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 700;
    color: var(--hp44-bs-title);
    margin: 0;
  }

  .hp44-bs__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp44-bs__card {
    background: var(--hp44-bs-card);
    border: 1px solid var(--hp44-bs-border);
    border-radius: 24px;
    padding: 24px;
    box-shadow: 0 10px 30px rgba(20, 61, 43, 0.05);
    transition: all 0.3s ease;
    text-align: center;
    display: flex;
    flex-direction: column;
  }

  .hp44-bs__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 45px rgba(20, 61, 43, 0.1);
  }

  .hp44-bs__img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 16px;
    margin-bottom: 20px;
  }

  .hp44-bs__name {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--hp44-bs-title);
    margin: 0 0 8px;
  }

  .hp44-bs__price {
    font-size: 17px;
    font-weight: 700;
    color: var(--hp44-bs-accent);
    margin-bottom: 16px;
  }

  .hp44-bs__btn {
    width: 100%;
    margin-top: auto;
    padding: 14px;
    background: #143D2B;
    color: #FFFFFF;
    border: none;
    border-radius: 50px;
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp44-bs__btn:hover {
    background: var(--hp44-bs-accent);
  }

  @media screen and (max-width: 992px) {
    .hp44-bs__grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin: 0 auto;
    }
  }
{%- endstyle -%}

<div class="hp44-bs__wrapper">
  <div class="hp44-bs__title-block">
    {%- if section.settings.subheading != blank -%}
      <p class="hp44-bs__subhead">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <h2 class="hp44-bs__heading">{{ section.settings.heading | default: 'Most Coveted Sage Formulas' }}</h2>
  </div>

  <div class="hp44-bs__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp44-bs__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp44-bs__img" alt="{{ block.settings.title }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hp44-bs__img' }}
          {%- endif -%}
          <h3 class="hp44-bs__name">{{ block.settings.title }}</h3>
          <div class="hp44-bs__price">{{ block.settings.price | default: '$54.00 USD' }}</div>
          <button class="hp44-bs__btn">{{ block.settings.btn_text | default: 'Acquire Ritual' }}</button>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp44-bs__card">
        {{ 'product-1' | placeholder_svg_tag: 'hp44-bs__img' }}
        <h3 class="hp44-bs__name">Clary Sage Botanical Elixir</h3>
        <div class="hp44-bs__price">$54.00 USD</div>
        <button class="hp44-bs__btn">Acquire Ritual</button>
      </div>
      <div class="hp44-bs__card">
        {{ 'product-1' | placeholder_svg_tag: 'hp44-bs__img' }}
        <h3 class="hp44-bs__name">Sage & Calendula Velvet Cream</h3>
        <div class="hp44-bs__price">$68.00 USD</div>
        <button class="hp44-bs__btn">Acquire Ritual</button>
      </div>
      <div class="hp44-bs__card">
        {{ 'product-1' | placeholder_svg_tag: 'hp44-bs__img' }}
        <h3 class="hp44-bs__name">Nordic Sage Essence Mist</h3>
        <div class="hp44-bs__price">$38.00 USD</div>
        <button class="hp44-bs__btn">Acquire Ritual</button>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP44 - Sage Best",
  "class": "section-hp44-bestsellers",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#EDF4EE" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border", "label": "Card Border", "default": "#D8E8DC" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#143D2B" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#2D6A4F" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Customer Favorites" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most Coveted Sage Formulas" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Bestseller Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product Image" },
        { "type": "text", "id": "title", "label": "Product Name", "default": "Clary Sage Botanical Elixir" },
        { "type": "text", "id": "price", "label": "Price", "default": "$54.00 USD" },
        { "type": "text", "id": "btn_text", "label": "Button Label", "default": "Acquire Ritual" },
        { "type": "url", "id": "url", "label": "Product Link" }
      ]
    }
  ],
  "presets": [
    { "name": "HP44 - Sage Best" }
  ]
}
{% endschema %}
