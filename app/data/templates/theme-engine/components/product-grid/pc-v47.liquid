{%- comment -%}
  PC V47 — LUXURY HAUTE PERFUMERY NICHE PRODUCT GRID
  Design: Midnight Obsidian (#0B0B0C), Vintage Gold (#E2C044) accents, Italiana & Jost typography
  Card Shape: 0px corners, 1px fine gold borders, haute perfumery luxury bottle aesthetic
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Italiana&family=Jost:ital,wght@0,400;0,500;0,600;1,400&display=swap');

  .pcv47 {
    --bg: {{ section.settings.bg_color | default: '#0B0B0C' }};
    --card-bg: {{ section.settings.card_bg | default: '#141416' }};
    --text: {{ section.settings.text_color | default: '#F5F5F0' }};
    --muted: {{ section.settings.muted_color | default: '#E2C044' }};
    --accent: {{ section.settings.accent_color | default: '#E2C044' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#C7A630' }};
    --border: {{ section.settings.border_color | default: '#28282D' }};
    --badge-sale-bg: #E2C044;
    --badge-sale-text: #0B0B0C;
    --f-serif: 'Italiana', serif;
    --f-sans: 'Jost', sans-serif;
    --ease: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-sans);
    padding: {{ section.settings.padding_top | default: 64 }}px 0 {{ section.settings.padding_bottom | default: 64 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv47 *, .pcv47 *::before, .pcv47 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv47 a { color: inherit; text-decoration: none; }
  .pcv47 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv47 img { max-width: 100%; display: block; }

  .pcv47__wrap { max-width: 1320px; margin: 0 auto; padding: 0 24px; }

  /* HEADER */
  .pcv47__head { display: flex; flex-direction: column; gap: 10px; margin-bottom: 44px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv47__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv47__title { font-family: var(--f-serif); font-size: 34px; font-weight: 400; color: var(--text); letter-spacing: 0.08em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv47__title { font-size: 44px; } }
  .pcv47__sub { font-size: 14px; color: var(--muted); letter-spacing: 0.05em; font-style: italic; }
  .pcv47__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--accent); border-bottom: 1px solid var(--accent); padding-bottom: 3px; transition: var(--ease); }
  .pcv47__viewall:hover { color: #FFFFFF; border-color: #FFFFFF; }

  /* GRID */
  .pcv47__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv47__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 28px; }
  }
  @media (min-width: 1024px) {
    .pcv47__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 32px; }
  }

  /* CARD */
  .pcv47__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 0px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--ease);
  }
  .pcv47__card:hover {
    border-color: var(--accent);
    box-shadow: 0 10px 30px -5px rgba(226, 192, 68, 0.15);
  }

  /* IMAGE CONTAINER */
  .pcv47__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '4/5' }};
    background: #070708;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .pcv47__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pcv47__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv47__card:hover .pcv47__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv47__card:hover .pcv47__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv47__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv47__badge { font-size: 10px; font-weight: 500; text-transform: uppercase; padding: 4px 10px; border-radius: 0px; letter-spacing: 0.15em; font-family: var(--f-sans); }
  .pcv47__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv47__badge--tag { background: rgba(226, 192, 68, 0.12); color: #E2C044; border: 1px solid #E2C044; }
  .pcv47__badge--sold { background: #28282D; color: #777777; }

  /* WISHLIST BUTTON */
  .pcv47__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(11, 11, 12, 0.85);
    border: 1px solid rgba(226, 192, 68, 0.4);
    backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv47__wish:hover { background: var(--accent); color: #0B0B0C; border-color: var(--accent); }
  .pcv47__wish.active { color: #0B0B0C; background: var(--accent); border-color: var(--accent); }

  /* QUICK ADD HOVER */
  .pcv47__quick-box {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    z-index: 3;
    transform: translateY(100%);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv47__card:hover .pcv47__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv47__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 16px 16px; }
  }

  .pcv47__quick-btn {
    width: 100%;
    padding: 13px 16px;
    background: var(--accent);
    color: #0B0B0C;
    font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.2em;
    font-family: var(--f-sans);
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv47__quick-btn:hover { background: #FFFFFF; color: #0B0B0C; }
  .pcv47__quick-btn:disabled { background: #28282D; color: #777777; cursor: not-allowed; }

  /* CARD CONTENT */
  .pcv47__content { padding: 18px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv47__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 500; letter-spacing: 0.2em; }
  .pcv47__item-title { font-family: var(--f-serif); font-size: 20px; font-weight: 400; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv47__rating { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; color: var(--accent); }
  .pcv47__stars { letter-spacing: 2px; text-shadow: 0 0 6px rgba(226, 192, 68, 0.4); }
  .pcv47__rev-cnt { color: #888888; font-size: 11px; }

  /* PRICE */
  .pcv47__price-row { display: flex; align-items: baseline; justify-content: center; gap: 10px; margin-top: auto; padding-top: 4px; }
  .pcv47__price { font-size: 17px; font-weight: 500; color: var(--text); font-family: var(--f-sans); letter-spacing: 0.05em; }
  .pcv47__cmp-price { font-size: 13px; color: #888888; text-decoration: line-through; }

  /* SWATCHES */
  .pcv47__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv47__swatch { width: 12px; height: 12px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv47__swatch:hover, .pcv47__swatch.active { transform: scale(1.25); border-color: var(--accent); box-shadow: 0 0 6px var(--accent); }

  /* URGENCY MICRO */
  .pcv47__urgency { font-size: 11px; color: var(--accent); font-style: italic; font-family: var(--f-serif); display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv47__toast {
    position: fixed; bottom: 24px; right: 24px;
    background: var(--accent); color: #0B0B0C;
    padding: 14px 24px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.15em;
    font-family: var(--f-sans);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pcv47__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv47">
  <div class="pcv47__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv47__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv47__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv47__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv47__viewall">
            {{ section.settings.view_all_label | default: 'Explore Perfumery' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv47__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v47', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v47', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv47__toast" id="pcv47-toast">Flacon Acquired</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv47-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv47Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Acquiring...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = 'Acquired';
        showT('Flacon Acquired');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv47-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

