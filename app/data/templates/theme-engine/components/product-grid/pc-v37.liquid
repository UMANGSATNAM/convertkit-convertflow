{%- comment -%}
  PC V37 — CYBERPUNK HACKER MATRIX PRODUCT GRID
  Design: Matrix Dark (#050805), Terminal Neon Green (#00FF41) accents, Share Tech Mono typography
  Card Shape: 0px crisp corners, 1px green terminal borders, code block matrix tags
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');

  .pcv37 {
    --bg: {{ section.settings.bg_color | default: '#050805' }};
    --card-bg: {{ section.settings.card_bg | default: '#0C120C' }};
    --text: {{ section.settings.text_color | default: '#00FF41' }};
    --muted: {{ section.settings.muted_color | default: '#008F24' }};
    --accent: {{ section.settings.accent_color | default: '#00FF41' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#00CC33' }};
    --border: {{ section.settings.border_color | default: '#005514' }};
    --badge-sale-bg: #00FF41;
    --badge-sale-text: #050805;
    --f-mono: 'Share Tech Mono', monospace;
    --ease: all 0.2s ease;
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-mono);
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv37 *, .pcv37 *::before, .pcv37 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv37 a { color: inherit; text-decoration: none; }
  .pcv37 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv37 img { max-width: 100%; display: block; }

  .pcv37__wrap { max-width: 1320px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv37__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; border-bottom: 2px dashed var(--border); padding-bottom: 16px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv37__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv37__title { font-size: 28px; font-weight: 400; color: var(--text); text-shadow: 0 0 8px rgba(0, 255, 65, 0.6); letter-spacing: 0.05em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv37__title { font-size: 38px; } }
  .pcv37__sub { font-size: 14px; color: var(--muted); }
  .pcv37__viewall { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text); border: 1px solid var(--accent); padding: 8px 18px; box-shadow: 0 0 10px rgba(0, 255, 65, 0.2); transition: var(--ease); }
  .pcv37__viewall:hover { background: var(--accent); color: #050805; box-shadow: 0 0 20px rgba(0, 255, 65, 0.6); }

  /* GRID */
  .pcv37__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv37__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv37__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv37__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 0px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--ease);
  }
  .pcv37__card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 0 20px rgba(0, 255, 65, 0.35);
  }

  /* IMAGE CONTAINER */
  .pcv37__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #020402;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .pcv37__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.1) hue-rotate(90deg);
    transition: transform 0.4s ease;
  }
  .pcv37__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv37__card:hover .pcv37__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv37__card:hover .pcv37__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv37__badges { position: absolute; top: 10px; left: 10px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv37__badge { font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 3px 8px; border: 1px solid var(--accent); letter-spacing: 0.05em; }
  .pcv37__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv37__badge--tag { background: #002B0A; color: #00FF41; }
  .pcv37__badge--sold { background: #1C2B1F; color: #008F24; border-color: #005514; }

  /* WISHLIST BUTTON */
  .pcv37__wish {
    position: absolute;
    top: 10px; right: 10px;
    width: 36px; height: 36px;
    background: rgba(5, 8, 5, 0.85);
    border: 1px solid var(--border);
    backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv37__wish:hover { background: var(--accent); color: #050805; border-color: var(--accent); box-shadow: 0 0 10px #00FF41; }
  .pcv37__wish.active { color: #050805; background: var(--accent); border-color: var(--accent); box-shadow: 0 0 10px #00FF41; }

  /* QUICK ADD HOVER */
  .pcv37__quick-box { padding: 12px; background: var(--card-bg); border-top: 1px solid var(--border); }
  .pcv37__quick-btn {
    width: 100%;
    padding: 10px 14px;
    background: var(--accent);
    color: #050805;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    font-family: var(--f-mono);
    border: none;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
    box-shadow: 0 0 12px rgba(0, 255, 65, 0.4);
  }
  .pcv37__quick-btn:hover { background: var(--accent-hover); box-shadow: 0 0 20px rgba(0, 255, 65, 0.7); }
  .pcv37__quick-btn:disabled { background: #005514; color: #008F24; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv37__content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; }

  .pcv37__vendor { font-size: 10px; text-transform: uppercase; color: var(--muted); letter-spacing: 0.1em; }
  .pcv37__item-title { font-size: 15px; font-weight: 400; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-transform: uppercase; text-shadow: 0 0 4px rgba(0, 255, 65, 0.4); }

  /* RATING */
  .pcv37__rating { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--accent); }
  .pcv37__stars { letter-spacing: 1px; text-shadow: 0 0 6px var(--accent); }
  .pcv37__rev-cnt { color: var(--muted); font-size: 11px; }

  /* PRICE */
  .pcv37__price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv37__price { font-size: 17px; font-weight: 700; color: var(--text); text-shadow: 0 0 6px var(--accent); }
  .pcv37__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv37__swatches { display: flex; gap: 6px; align-items: center; margin-top: 4px; }
  .pcv37__swatch { width: 12px; height: 12px; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv37__swatch:hover, .pcv37__swatch.active { border-color: var(--accent); background: var(--accent); box-shadow: 0 0 6px var(--accent); }

  /* URGENCY MICRO */
  .pcv37__urgency { font-size: 11px; color: var(--accent); text-transform: uppercase; display: flex; align-items: center; gap: 4px; margin-top: 2px; text-shadow: 0 0 6px var(--accent); }

  /* TOAST */
  .pcv37__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #050805;
    border: 1px solid var(--accent); padding: 12px 20px;
    font-size: 12px; font-weight: 700; text-transform: uppercase;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.2s ease;
    box-shadow: 0 0 20px rgba(0, 255, 65, 0.6);
  }
  .pcv37__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv37">
  <div class="pcv37__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv37__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv37__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv37__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv37__viewall">
            {{ section.settings.view_all_label | default: '> FETCH_ALL_NODES' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv37__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v37', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v37', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv37__toast" id="pcv37-toast">NODE_EXECUTED_SUCCESSFULLY</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv37-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv37Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '> EXECUTING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ EXECUTED';
        showT('NODE_EXECUTED_SUCCESSFULLY');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERR_FAIL';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv37-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

