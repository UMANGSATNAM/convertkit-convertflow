{%- style -%}#shopify-section-{{ section.id }}{background:#fff;padding:60px 0}.hp65-ed{max-width:1280px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1.2fr .8fr;gap:20px}@media(max-width:900px){.hp65-ed{grid-template-columns:1fr}}.hp65-big{border-radius:16px;overflow:hidden;position:relative;height:480px}.hp65-big img{width:100%;height:100%;object-fit:cover}.hp65-small{display:grid;gap:16px}.hp65-sm{border:1px solid rgba(0,0,0,.06);border-radius:12px;overflow:hidden;display:flex;gap:12px;padding:10px;align-items:center;text-decoration:none;color:inherit}.hp65-sm img{width:90px;height:90px;object-fit:cover;border-radius:8px}{%- endstyle -%}<div class="hp65-ed"><a href="{{section.settings.link|default:'/collections/all'}}" class="hp65-big">{% assign prod = collections[section.settings.collection].products.first %}{% if prod %}<img src="{{prod.featured_image|image_url:width:800}}" alt="">{% else %}{{'collection-1'|placeholder_svg_tag}}{% endif %}<span style="position:absolute;bottom:16px;left:16px;background:#fff;padding:8px 12px;border-radius:8px;font-weight:700">{{section.settings.heading|default:'STREETWEAR Edit'}}</span></a><div class="hp65-small">{% for product in collections[section.settings.collection].products limit:3 %}<a href="{{product.url}}" class="hp65-sm"><img src="{{product.featured_image|image_url:width:200}}"><span><b>{{product.title}}</b><br><span style="color:#E11D48">{{product.price|money}}</span></span></a>{% endfor %}</div></div>{% schema %}{"name":"HP65 Editorial Picks","settings":[{"type":"text","id":"heading","label":"Heading","default":"STREETWEAR Edit"},{"type":"collection","id":"collection","label":"Collection"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"HP65 Editorial Picks"}]}{% endschema %}