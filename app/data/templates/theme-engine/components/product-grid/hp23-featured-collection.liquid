{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: #000000;
    --border-width: 3px;
    --shadow-offset: 6px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: var(--border-width) solid var(--border-color);
    font-family: 'Space Grotesk', 'Outfit', sans-serif;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp23-featured-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp23-featured-wrapper {
      padding: 0 20px;
    }
  }

  .hp23-featured__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: {{ section.settings.header_margin }}px;
    padding-bottom: 20px;
    border-bottom: var(--border-width) solid var(--border-color);
  }

  @media screen and (max-width: 768px) {
    .hp23-featured__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp23-featured__title {
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -1px;
    line-height: 1.1;
  }
  
  .hp23-featured__title em {
    font-style: normal;
    background: var(--accent-color);
    padding: 0 8px;
    display: inline-block;
    border: var(--border-width) solid var(--border-color);
    box-shadow: 4px 4px 0 var(--border-color);
    transform: rotate(-2deg);
    margin-left: 8px;
  }

  .hp23-featured__btn-view {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    background: var(--text-color);
    color: #ffffff;
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    text-decoration: none;
    border: var(--border-width) solid var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    box-shadow: 4px 4px 0 var(--border-color);
    transition: all 0.2s ease;
  }

  .hp23-featured__btn-view:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--border-color);
  }

  .hp23-featured__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 30px;
  }

  @media screen and (max-width: 992px) {
    .hp23-featured__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media screen and (max-width: 480px) {
    .hp23-featured__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Product Card */
  .hp23-product-card {
    background: #ffffff;
    border: var(--border-width) solid var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--border-color);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
    color: var(--text-color);
    overflow: hidden;
  }

  .hp23-product-card:hover {
    transform: translate(2px, 2px);
    box-shadow: calc(var(--shadow-offset) - 2px) calc(var(--shadow-offset) - 2px) 0 var(--border-color);
  }

  .hp23-product-card__image-wrapper {
    position: relative;
    aspect-ratio: 4/5;
    background: #f4f4f4;
    border-bottom: var(--border-width) solid var(--border-color);
    overflow: hidden;
  }

  .hp23-product-card__image {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  
  .hp23-product-card:hover .hp23-product-card__image {
    transform: scale(1.05);
  }

  .hp23-product-card__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: var(--accent-color);
    color: var(--text-color);
    border: 2px solid var(--border-color);
    font-weight: 800;
    font-size: 11px;
    padding: 6px 10px;
    text-transform: uppercase;
    box-shadow: 2px 2px 0 var(--border-color);
    transform: rotate(-3deg);
    z-index: 2;
  }

  .hp23-product-card__info {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    background: #ffffff;
  }

  .hp23-product-card__title {
    font-size: 18px;
    font-weight: 800;
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: -0.5px;
  }

  .hp23-product-card__price-wrapper {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 24px;
    font-weight: 700;
    font-size: 16px;
  }

  .hp23-product-card__price--regular {
    text-decoration: line-through;
    color: var(--text-color);
    opacity: 0.6;
  }

  .hp23-product-card__btn {
    margin-top: auto;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 20px;
    background: var(--accent-color);
    color: var(--text-color);
    font-family: inherit;
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    border: 2px solid var(--border-color);
    box-shadow: 3px 3px 0 var(--border-color);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hp23-product-card__btn:hover {
    background: var(--text-color);
    color: #ffffff;
    box-shadow: 2px 2px 0 var(--border-color);
    transform: translate(1px, 1px);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp23-featured-wrapper" id="HP23Featured-{{ section.id }}">
  
  <div class="hp23-featured__header">
    <h2 class="hp23-featured__title">{{ section.settings.title }}</h2>
    
    {%- if section.settings.btn_text != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp23-featured__btn-view">
        {{ section.settings.btn_text | escape }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp23-featured__grid">
    {%- assign collection = collections[section.settings.collection] -%}
    {%- assign limit = section.settings.products_to_show -%}
    
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: limit -%}
        <a href="{{ product.url }}" class="hp23-product-card">
          <div class="hp23-product-card__image-wrapper">
            {%- if product.compare_at_price > product.price -%}
              <div class="hp23-product-card__badge">SALE</div>
            {%- endif -%}
            
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="hp23-product-card__image" loading="lazy">
          </div>
          
          <div class="hp23-product-card__info">
            <h3 class="hp23-product-card__title">{{ product.title }}</h3>
            <div class="hp23-product-card__price-wrapper">
              {%- if product.compare_at_price > product.price -%}
                <span class="hp23-product-card__price--regular">{{ product.compare_at_price | money }}</span>
              {%- endif -%}
              <span class="hp23-product-card__price">{{ product.price | money }}</span>
            </div>
            
            <button class="hp23-product-card__btn" type="button">ADD TO CART</button>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..limit) -%}
        <a href="#" class="hp23-product-card">
          <div class="hp23-product-card__image-wrapper">
            {%- if i == 1 -%}<div class="hp23-product-card__badge">HOT</div>{%- endif -%}
            <div style="width:100%;height:100%;background:#e0e0e0;display:flex;align-items:center;justify-content:center;font-weight:bold;">PRODUCT IMG</div>
          </div>
          <div class="hp23-product-card__info">
            <h3 class="hp23-product-card__title">Brutalist Product {{ i }}</h3>
            <div class="hp23-product-card__price-wrapper">
              <span class="hp23-product-card__price">$35.00</span>
            </div>
            <button class="hp23-product-card__btn" type="button">ADD TO CART</button>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "HP23 - Brutalist Featured",
  "class": "section-hp23-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>HEAVY <em>HITTERS</em></p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "View All Button Text",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "View All Link"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 40
    },
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to Show",
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Section Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Highlight & Buttons)",
      "default": "#FF3B30",
      "info": "Try bright red, lime green, or bold yellow"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP23 - Brutalist Featured"
    }
  ]
}
{% endschema %}
