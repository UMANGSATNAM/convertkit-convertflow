{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --cyan: {{ section.settings.cyan_color }};
    --magenta: {{ section.settings.magenta_color }};
    
    --font-heading: 'Press Start 2P', cursive;
    --font-body: 'Chakra Petch', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    border-bottom: 2px dashed var(--cyan);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp28-featured-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp28-featured-wrapper {
      padding: 0 20px;
    }
  }

  .hp28-featured__header {
    text-align: center;
    margin-bottom: 50px;
    position: relative;
  }

  .hp28-featured__title {
    font-family: var(--font-heading);
    font-size: clamp(20px, 3.5vw, {{ section.settings.title_size }}px);
    color: var(--cyan);
    text-shadow: 3px 3px 0 var(--magenta);
    margin: 0;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hp28-featured__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 30px;
  }

  @media screen and (max-width: 992px) {
    .hp28-featured__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp28-featured__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-bottom: 20px;
    }
    .hp28-featured__grid::-webkit-scrollbar {
      display: none;
    }
  }

  /* Retro Card */
  .hp28-featured__item {
    background: #000;
    border: 3px solid var(--magenta);
    padding: 15px;
    position: relative;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
  }

  @media screen and (max-width: 768px) {
    .hp28-featured__item {
      flex: 0 0 80%;
      scroll-snap-align: start;
    }
  }

  .hp28-featured__item:hover {
    transform: translate(-4px, -4px);
    box-shadow: 8px 8px 0 var(--cyan);
    border-color: var(--cyan);
  }

  /* Image container with duotone effect */
  .hp28-featured__image-wrapper {
    position: relative;
    aspect-ratio: {{ section.settings.image_ratio }};
    width: 100%;
    overflow: hidden;
    background: var(--bg-color);
    margin-bottom: 15px;
    border: 2px solid #fff;
  }

  .hp28-featured__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Basic Duotone trick using filters if possible, or just high contrast */
    filter: sepia(100%) hue-rotate(250deg) saturate(500%) contrast(1.2);
    transition: filter 0.3s ease;
  }

  .hp28-featured__item:hover .hp28-featured__image {
    filter: sepia(0%) hue-rotate(0deg) saturate(100%) contrast(1);
  }

  /* Badge */
  .hp28-featured__badge {
    position: absolute;
    top: 10px;
    left: -5px;
    background: var(--cyan);
    color: #000;
    font-family: var(--font-heading);
    font-size: 10px;
    padding: 6px 10px;
    text-transform: uppercase;
    box-shadow: 2px 2px 0 var(--magenta);
    z-index: 2;
  }

  .hp28-featured__content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    text-align: center;
  }

  .hp28-featured__product-title {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hp28-featured__product-price {
    font-family: var(--font-heading);
    font-size: 14px;
    color: var(--green);
    margin: 0 0 15px;
    text-shadow: 1px 1px 0 #000;
  }

  /* Retro Button */
  .hp28-featured__btn {
    margin-top: auto;
    width: 100%;
    background: #c0c0c0;
    border-top: 2px solid #fff;
    border-left: 2px solid #fff;
    border-right: 2px solid #808080;
    border-bottom: 2px solid #808080;
    padding: 10px 0;
    font-family: var(--font-heading);
    font-size: 12px;
    color: #000;
    text-align: center;
    cursor: pointer;
    text-transform: uppercase;
  }

  .hp28-featured__item:hover .hp28-featured__btn {
    background: var(--magenta);
    color: #fff;
    border-top: 2px solid #ff66ff;
    border-left: 2px solid #ff66ff;
    border-right: 2px solid #990099;
    border-bottom: 2px solid #990099;
  }

  .hp28-featured__btn:active {
    border-top: 2px solid #808080;
    border-left: 2px solid #808080;
    border-right: 2px solid #fff;
    border-bottom: 2px solid #fff;
  }

  .hp28-featured__view-all {
    margin-top: 50px;
    text-align: center;
  }

  .hp28-featured__view-btn {
    display: inline-block;
    background: transparent;
    color: var(--cyan);
    font-family: var(--font-heading);
    font-size: 14px;
    text-decoration: none;
    padding: 15px 30px;
    border: 2px dashed var(--magenta);
    transition: all 0.3s ease;
    text-transform: uppercase;
  }

  .hp28-featured__view-btn:hover {
    background: var(--magenta);
    color: #fff;
    border-style: solid;
    border-color: #fff;
    box-shadow: 4px 4px 0 var(--cyan);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-featured-wrapper" id="HP28Featured-{{ section.id }}">
  <div class="hp28-featured__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp28-featured__title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

  <div class="hp28-featured__grid">
    {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        <a href="{{ product.url }}" class="hp28-featured__item">
          {%- if product.compare_at_price > product.price -%}
            <div class="hp28-featured__badge">SALE</div>
          {%- endif -%}
          
          <div class="hp28-featured__image-wrapper">
            <img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="hp28-featured__image" loading="lazy">
          </div>
          
          <div class="hp28-featured__content">
            <h3 class="hp28-featured__product-title">{{ product.title }}</h3>
            <div class="hp28-featured__product-price">
              {{ product.price | money }}
            </div>
            <div class="hp28-featured__btn">ADD TO CART</div>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.products_to_show) -%}
        <a href="#" class="hp28-featured__item">
          <div class="hp28-featured__image-wrapper">
            {{ 'product-' | append: i | placeholder_svg_tag: 'hp28-featured__image' }}
          </div>
          <div class="hp28-featured__content">
            <h3 class="hp28-featured__product-title">VIRTUAL ITEM {{ i }}</h3>
            <div class="hp28-featured__product-price">$99.00</div>
            <div class="hp28-featured__btn">ADD TO CART</div>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.show_view_all -%}
    <div class="hp28-featured__view-all">
      <a href="{{ section.settings.collection.url | default: '/collections/all' }}" class="hp28-featured__view-btn">
        {{ section.settings.view_all_text }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP28 - Y2K Featured Col",
  "class": "section-hp28-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SYSTEM CACHE"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to Show",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "LOAD_MORE.EXE"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/3", "label": "Landscape (4:3)" }
      ],
      "default": "1/1"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Y2K Cyber Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Deep Purple)",
      "default": "#1C0B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cyan_color",
      "label": "Cyan Accent",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "magenta_color",
      "label": "Magenta Accent",
      "default": "#FF00FF"
    },
    {
      "type": "color",
      "id": "green_color",
      "label": "Acid Green Accent",
      "default": "#39FF14"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP28 - Y2K Featured Col"
    }
  ]
}
{% endschema %}
