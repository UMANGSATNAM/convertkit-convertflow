{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    
    --font-heading: 'Space Grotesk', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding: 80px 20px;
    border-top: 4px solid var(--border-color);
    border-bottom: 4px solid var(--border-color);
  }

  .hp41-featured-wrapper {
    max-width: 1400px;
    margin: 0 auto;
  }

  .hp41-featured__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 60px;
  }

  @media screen and (max-width: 768px) {
    .hp41-featured__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp41-featured__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    line-height: 1;
    color: var(--border-color);
    margin: 0;
    text-transform: uppercase;
  }

  .hp41-featured__btn-top {
    display: inline-block;
    padding: 12px 30px;
    background: #FF4911; /* Bright orange */
    color: #fff;
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 900;
    text-transform: uppercase;
    text-decoration: none;
    border: 4px solid var(--border-color);
    border-radius: 12px;
    box-shadow: 4px 4px 0px var(--border-color);
    transition: all 0.1s ease;
  }

  .hp41-featured__btn-top:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--border-color);
  }

  .hp41-featured__btn-top:active {
    transform: translate(4px, 4px);
    box-shadow: 0px 0px 0px var(--border-color);
  }

  .hp41-featured__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
  }

  .hp41-fc-card {
    background: #fff;
    border: 4px solid var(--border-color);
    border-radius: 16px;
    box-shadow: 8px 8px 0px var(--border-color);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    position: relative;
    transition: all 0.2s ease;
  }

  .hp41-fc-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0px var(--border-color);
  }

  .hp41-fc-card__badge {
    position: absolute;
    top: -15px;
    left: -15px;
    background: #D7FF43;
    color: var(--border-color);
    padding: 5px 15px;
    border: 3px solid var(--border-color);
    border-radius: 50px;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 14px;
    transform: rotate(-10deg);
    z-index: 2;
    box-shadow: 3px 3px 0px var(--border-color);
  }

  .hp41-fc-card__image-wrap {
    width: 100%;
    aspect-ratio: 1;
    border-bottom: 4px solid var(--border-color);
    background: #F0A8E3;
    border-radius: 12px 12px 0 0;
    overflow: hidden;
  }

  /* Different background colors for images based on nth-child */
  .hp41-fc-card:nth-child(2) .hp41-fc-card__image-wrap { background: #38C6F4; }
  .hp41-fc-card:nth-child(3) .hp41-fc-card__image-wrap { background: #D7FF43; }
  .hp41-fc-card:nth-child(4) .hp41-fc-card__image-wrap { background: #FF4911; }

  .hp41-fc-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply; /* Cool effect on bright backgrounds */
  }

  .hp41-fc-card__info {
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
  }

  .hp41-fc-card__title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 900;
    color: var(--border-color);
    margin: 0;
    text-transform: uppercase;
  }

  .hp41-fc-card__price {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 900;
    color: var(--border-color);
    background: #D7FF43;
    padding: 5px 10px;
    border: 3px solid var(--border-color);
    border-radius: 8px;
    box-shadow: 2px 2px 0px var(--border-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp41-featured-wrapper" id="HP41Featured-{{ section.id }}">
  <div class="hp41-featured__header">
    <h2 class="hp41-featured__title">{{ section.settings.title }}</h2>
    
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: collections[section.settings.collection].url | default: '#' }}" class="hp41-featured__btn-top">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp41-featured__grid">
    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: section.settings.limit -%}
        <a href="{{ product.url }}" class="hp41-fc-card">
          {%- if forloop.index == 1 or forloop.index == 3 -%}
            <div class="hp41-fc-card__badge">HOT!</div>
          {%- endif -%}
          <div class="hp41-fc-card__image-wrap">
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="hp41-fc-card__image" loading="lazy">
          </div>
          <div class="hp41-fc-card__info">
            <h3 class="hp41-fc-card__title">{{ product.title }}</h3>
            <div class="hp41-fc-card__price">{{ product.price | money_without_trailing_zeros }}</div>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.limit) -%}
        <a href="#" class="hp41-fc-card">
          {%- if i == 1 -%}
            <div class="hp41-fc-card__badge">FRESH!</div>
          {%- endif -%}
          <div class="hp41-fc-card__image-wrap">
            {{ 'product-' | append: i | placeholder_svg_tag: 'hp41-fc-card__image' }}
          </div>
          <div class="hp41-fc-card__info">
            <h3 class="hp41-fc-card__title">COOL ITEM {{ i }}</h3>
            <div class="hp41-fc-card__price">$99</div>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP41 - Neo Collection",
  "class": "section-hp41-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FRESH DROPS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 2,
      "label": "Product Limit",
      "default": 4
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Neo Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FDF0D5"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP41 - Neo Collection"
    }
  ]
}
{% endschema %}
