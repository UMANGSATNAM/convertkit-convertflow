{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAFAFA'
  assign text_color = section.settings.text_color | default: '#333333'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 0;
    color: {{ text_color }};
    border-bottom: 1px solid #E5E5E5;
    overflow: hidden;
  }
  
  .hp12-fp-container-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }
  
  .hp12-fp-header-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }
  
  .hp12-fp-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    margin: 0;
    line-height: 1.2;
    letter-spacing: 1px;
  }
  
  .hp12-fp-view-all-{{ section_id }} {
    color: {{ text_color }};
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    text-decoration: none;
    border-bottom: 1px solid {{ text_color }};
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding-bottom: 5px;
    transition: opacity 0.3s ease;
  }
  
  .hp12-fp-view-all-{{ section_id }}:hover {
    opacity: 0.5;
  }
  
  .hp12-fp-scroll-{{ section_id }} {
    display: flex;
    overflow-x: auto;
    gap: 40px;
    padding: 20px 40px;
    -ms-overflow-style: none;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }
  
  .hp12-fp-scroll-{{ section_id }}::-webkit-scrollbar {
    display: none;
  }
  
  .hp12-fp-card-{{ section_id }} {
    flex: 0 0 400px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: {{ text_color }};
    scroll-snap-align: start;
  }
  
  .hp12-fp-image-wrap-{{ section_id }} {
    position: relative;
    overflow: hidden;
    padding-top: 130%; 
    background: #E5E5E5;
    margin-bottom: 25px;
  }
  
  .hp12-fp-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  
  .hp12-fp-card-{{ section_id }}:hover .hp12-fp-image-{{ section_id }} {
    transform: scale(1.03);
  }
  
  .hp12-fp-info-{{ section_id }} {
    text-align: left;
    display: flex;
    flex-direction: column;
  }
  
  .hp12-fp-title-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin: 0 0 10px 0;
  }
  
  .hp12-fp-price-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 300;
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 0;
    }
    .hp12-fp-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
      padding: 0 20px;
    }
    .hp12-fp-scroll-{{ section_id }} {
      padding: 10px 20px;
      gap: 20px;
    }
    .hp12-fp-card-{{ section_id }} {
      flex: 0 0 280px;
    }
  }
</style>

<div class="hp12-fp-container-{{ section_id }}">
  <div class="hp12-fp-header-{{ section_id }}">
    <h2 class="hp12-fp-heading-{{ section_id }}">{{ section.settings.heading | default: 'New arrivals.' }}</h2>
    {% if section.settings.show_view_all %}
      <a href="{{ collections[section.settings.collection].url | default: '#' }}" class="hp12-fp-view-all-{{ section_id }}">See all</a>
    {% endif %}
  </div>
  
  <div class="hp12-fp-scroll-{{ section_id }}">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank %}
      {% for product in collection.products limit: 6 %}
        <a href="{{ product.url }}" class="hp12-fp-card-{{ section_id }}">
          <div class="hp12-fp-image-wrap-{{ section_id }}">
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" height="600" class="hp12-fp-image-{{ section_id }}" loading="lazy">
          </div>
          <div class="hp12-fp-info-{{ section_id }}">
            <h3 class="hp12-fp-title-{{ section_id }}">{{ product.title }}</h3>
            <div class="hp12-fp-price-{{ section_id }}">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..5) %}
        <a href="#" class="hp12-fp-card-{{ section_id }}">
          <div class="hp12-fp-image-wrap-{{ section_id }}">
            <div class="hp12-fp-image-{{ section_id }}" style="background: #E5E5E5;"></div>
          </div>
          <div class="hp12-fp-info-{{ section_id }}">
            <h3 class="hp12-fp-title-{{ section_id }}">MINIMALIST OBJECT {{ i }}</h3>
            <div class="hp12-fp-price-{{ section_id }}">$120.00</div>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP12 Featured Products",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New arrivals."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "HP12 Featured Products"
    }
  ]
}
{% endschema %}
