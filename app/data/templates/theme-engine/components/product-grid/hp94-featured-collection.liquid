{%- style -%}#shopify-section-{{ section.id }}{background:{{section.settings.bg_color|default:'#fff'}};padding:50px 0}.hp94-fc{max-width:1280px;margin:0 auto;padding:0 24px}.hp94-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:18px}.hp94-h{font-size:24px;font-weight:800;margin:0}.hp94-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}@media(max-width:900px){.hp94-grid{grid-template-columns:repeat(2,1fr)}}.hp94-card{border:1px solid rgba(0,0,0,.06);border-radius:12px;overflow:hidden;background:#fff;text-decoration:none;color:inherit}.hp94-card img{width:100%;aspect-ratio:1;object-fit:cover}.hp94-body{padding:10px}.hp94-title{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0}.hp94-price{font-weight:700;color:#F97316;margin:4px 0 0}{%- endstyle -%}<div class="hp94-fc"><div class="hp94-head"><h2 class="hp94-h">{{section.settings.heading|default:'Featured KIDS'}}</h2><a href="{{section.settings.link|default:'/collections/all'}}" style="font-size:12px;font-weight:700;color:#F97316;text-decoration:none">{{section.settings.link_text|default:'View All →'}}</a></div><div class="hp94-grid">{% for product in collections[section.settings.collection].products limit: section.settings.limit %}<a href="{{product.url}}" class="hp94-card"><img src="{{product.featured_image|image_url:width:500}}" alt="{{product.title|escape}}" loading="lazy"><div class="hp94-body"><p class="hp94-title">{{product.title}}</p><p class="hp94-price">{{product.price|money}}</p></div></a>{% else %}{% for i in (1..4) %}<div class="hp94-card"><div style="aspect-ratio:1;background:#f5f5f5">{{'product-1'|placeholder_svg_tag}}</div><div class="hp94-body"><p class="hp94-title">Sample KIDS</p><p class="hp94-price">₹1,999</p></div></div>{% endfor %}{% endfor %}</div></div>{% schema %}{"name":"HP94 Featured Grid","settings":[{"type":"text","id":"heading","label":"Heading","default":"Featured KIDS"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","min":2,"max":8,"step":1,"label":"Limit","default":4},{"type":"color","id":"bg_color","label":"BG","default":"#ffffff"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"link_text","label":"Link text","default":"View All →"}],"presets":[{"name":"HP94 Featured Grid"}]}{% endschema %}