{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp44-fc-bg: {{ section.settings.bg_color | default: '#EDF4EE' }};
    --hp44-fc-card: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --hp44-fc-border: {{ section.settings.card_border | default: '#D8E8DC' }};
    --hp44-fc-title: {{ section.settings.title_color | default: '#143D2B' }};
    --hp44-fc-accent: {{ section.settings.accent_color | default: '#2D6A4F' }};
    
    background-color: var(--hp44-fc-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp44-fc__wrapper {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp44-fc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  .hp44-fc__subhead {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--hp44-fc-accent);
    margin: 0 0 8px;
  }

  .hp44-fc__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 700;
    color: var(--hp44-fc-title);
    margin: 0;
  }

  .hp44-fc__view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--hp44-fc-title);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .hp44-fc__view-all:hover {
    color: var(--hp44-fc-accent);
  }

  .hp44-fc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 24px;
  }

  .hp44-prod-card {
    background: var(--hp44-fc-card);
    border: 1px solid var(--hp44-fc-border);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(20, 61, 43, 0.05);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .hp44-prod-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 45px rgba(20, 61, 43, 0.1);
  }

  .hp44-prod-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: #F4F8F5;
  }

  .hp44-prod-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hp44-prod-card:hover .hp44-prod-card__img {
    transform: scale(1.04);
  }

  .hp44-prod-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #143D2B;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 50px;
    letter-spacing: 0.5px;
  }

  .hp44-prod-card__body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .hp44-prod-card__tag {
    font-size: 12px;
    font-weight: 600;
    color: #52796F;
    margin: 0 0 6px;
    text-transform: uppercase;
  }

  .hp44-prod-card__title {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--hp44-fc-title);
    margin: 0 0 8px;
  }

  .hp44-prod-card__price-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 16px;
    font-weight: 700;
    color: var(--hp44-fc-accent);
  }

  .hp44-prod-card__btn {
    width: 100%;
    margin-top: auto;
    padding: 13px;
    background: #143D2B;
    color: #FFFFFF;
    border: none;
    border-radius: 50px;
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp44-prod-card__btn:hover {
    background: var(--hp44-fc-accent);
  }

  @media screen and (max-width: 992px) {
    .hp44-fc__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media screen and (max-width: 576px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 80 | times: 0.7 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 80 | times: 0.7 | round }}px;
    }
    .hp44-fc__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
{%- endstyle -%}

<div class="hp44-fc__wrapper">
  <div class="hp44-fc__header">
    <div>
      {%- if section.settings.subheading != blank -%}
        <p class="hp44-fc__subhead">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <h2 class="hp44-fc__heading">{{ section.settings.heading | default: 'Nordic Herbarium Formulas' }}</h2>
    </div>
    <a href="{{ section.settings.view_all_url | default: '/collections/all' }}" class="hp44-fc__view-all">
      <span>{{ section.settings.view_all_text | default: 'Explore All Formulas' }}</span>
      <span>&rarr;</span>
    </a>
  </div>

  <div class="hp44-fc__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp44-prod-card" {{ block.shopify_attributes }}>
          <div class="hp44-prod-card__media">
            {%- if block.settings.badge != blank -%}
              <span class="hp44-prod-card__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp44-prod-card__img" alt="{{ block.settings.title }}" loading="lazy">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'hp44-prod-card__img' }}
            {%- endif -%}
          </div>
          <div class="hp44-prod-card__body">
            <span class="hp44-prod-card__tag">{{ block.settings.tag | default: 'Active Botanical' }}</span>
            <h3 class="hp44-prod-card__title">{{ block.settings.title }}</h3>
            <div class="hp44-prod-card__price-row">{{ block.settings.price | default: '$52.00 USD' }}</div>
            <button class="hp44-prod-card__btn">{{ block.settings.btn_text | default: 'Add to Bag' }}</button>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp44-prod-card">
        <div class="hp44-prod-card__media">
          <span class="hp44-prod-card__badge">Bestseller</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp44-prod-card__img' }}
        </div>
        <div class="hp44-prod-card__body">
          <span class="hp44-prod-card__tag">Barrier Repair</span>
          <h3 class="hp44-prod-card__title">Clary Sage Botanical Elixir</h3>
          <div class="hp44-prod-card__price-row">$54.00 USD</div>
          <button class="hp44-prod-card__btn">Add to Bag</button>
        </div>
      </div>
      <div class="hp44-prod-card">
        <div class="hp44-prod-card__media">
          <span class="hp44-prod-card__badge">New Drop</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp44-prod-card__img' }}
        </div>
        <div class="hp44-prod-card__body">
          <span class="hp44-prod-card__tag">Deep Hydration</span>
          <h3 class="hp44-prod-card__title">Sage & Calendula Velvet Cream</h3>
          <div class="hp44-prod-card__price-row">$68.00 USD</div>
          <button class="hp44-prod-card__btn">Add to Bag</button>
        </div>
      </div>
      <div class="hp44-prod-card">
        <div class="hp44-prod-card__media">
          {{ 'product-1' | placeholder_svg_tag: 'hp44-prod-card__img' }}
        </div>
        <div class="hp44-prod-card__body">
          <span class="hp44-prod-card__tag">Clarifying</span>
          <h3 class="hp44-prod-card__title">Nordic Sage Essence Mist</h3>
          <div class="hp44-prod-card__price-row">$38.00 USD</div>
          <button class="hp44-prod-card__btn">Add to Bag</button>
        </div>
      </div>
      <div class="hp44-prod-card">
        <div class="hp44-prod-card__media">
          <span class="hp44-prod-card__badge">Award Winner</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp44-prod-card__img' }}
        </div>
        <div class="hp44-prod-card__body">
          <span class="hp44-prod-card__tag">Detox Ritual</span>
          <h3 class="hp44-prod-card__title">Green Tea & Sage Gel Mask</h3>
          <div class="hp44-prod-card__price-row">$46.00 USD</div>
          <button class="hp44-prod-card__btn">Add to Bag</button>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP44 - Sage Grid",
  "class": "section-hp44-grid",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#EDF4EE" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border", "label": "Card Border", "default": "#D8E8DC" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#143D2B" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#2D6A4F" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Targeted Herbarium Solutions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nordic Herbarium Formulas" },
    { "type": "text", "id": "view_all_text", "label": "View All Text", "default": "Explore All Formulas" },
    { "type": "url", "id": "view_all_url", "label": "View All URL" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product Image" },
        { "type": "text", "id": "badge", "label": "Badge Label" },
        { "type": "text", "id": "tag", "label": "Category Tag", "default": "Barrier Repair" },
        { "type": "text", "id": "title", "label": "Product Title", "default": "Clary Sage Botanical Elixir" },
        { "type": "text", "id": "price", "label": "Price", "default": "$54.00 USD" },
        { "type": "text", "id": "btn_text", "label": "Button Label", "default": "Add to Bag" },
        { "type": "url", "id": "url", "label": "Product URL" }
      ]
    }
  ],
  "presets": [
    { "name": "HP44 - Sage Grid" }
  ]
}
{% endschema %}
