{%- comment -%}
  PC V19 — JAPANESE ZEN STUDIO PRODUCT GRID
  Design: Crisp Sand (#F5F5F0), Sumi Ink (#2B2B2B) accents, Shippori Mincho & Noto Sans typography
  Card Shape: 0px corners, ultra-thin borders, generous whitespace, zen minimalist aesthetic
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans:wght@300;400;500;600&family=Shippori+Mincho:wght@500;600;700&display=swap');

  .pcv19 {
    --bg: {{ section.settings.bg_color | default: '#F5F5F0' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#2B2B2B' }};
    --muted: {{ section.settings.muted_color | default: '#8C8C85' }};
    --accent: {{ section.settings.accent_color | default: '#2B2B2B' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#555550' }};
    --border: {{ section.settings.border_color | default: '#E5E5E0' }};
    --badge-sale-bg: #2B2B2B;
    --badge-sale-text: #F5F5F0;
    --f-serif: 'Shippori Mincho', serif;
    --f-sans: 'Noto Sans', sans-serif;
    --ease: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-sans);
    padding: {{ section.settings.padding_top | default: 64 }}px 0 {{ section.settings.padding_bottom | default: 64 }}px 0;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .pcv19 *, .pcv19 *::before, .pcv19 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv19 a { color: inherit; text-decoration: none; }
  .pcv19 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv19 img { max-width: 100%; display: block; }

  .pcv19__wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px; }

  /* HEADER */
  .pcv19__head { display: flex; flex-direction: column; gap: 10px; margin-bottom: 44px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv19__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv19__title { font-family: var(--f-serif); font-size: 30px; font-weight: 600; color: var(--text); letter-spacing: 0.05em; }
  @media (min-width: 768px) { .pcv19__title { font-size: 40px; } }
  .pcv19__sub { font-size: 14px; color: var(--muted); font-weight: 300; letter-spacing: 0.05em; }
  .pcv19__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent); border-bottom: 1px solid var(--accent); padding-bottom: 3px; transition: var(--ease); }
  .pcv19__viewall:hover { color: var(--accent-hover); border-color: var(--accent-hover); }

  /* GRID */
  .pcv19__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv19__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 28px; }
  }
  @media (min-width: 1024px) {
    .pcv19__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 32px; }
  }

  /* CARD */
  .pcv19__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 0px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--ease);
  }
  .pcv19__card:hover {
    border-color: #A3A39C;
    box-shadow: 0 10px 25px -5px rgba(43, 43, 43, 0.06);
  }

  /* IMAGE BOX */
  .pcv19__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '4/5' }};
    background: #EBEBE6;
    overflow: hidden;
  }
  .pcv19__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pcv19__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv19__card:hover .pcv19__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.04);
    {% endif %}
  }
  .pcv19__card:hover .pcv19__img--sec { opacity: 1; transform: scale(1.04); }

  /* BADGES */
  .pcv19__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv19__badge { font-size: 10px; font-weight: 500; text-transform: uppercase; padding: 4px 8px; letter-spacing: 0.1em; font-family: var(--f-sans); }
  .pcv19__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv19__badge--tag { background: #8C8C85; color: #FFFFFF; }
  .pcv19__badge--sold { background: #C5C5C0; color: #2B2B2B; }

  /* WISHLIST BUTTON */
  .pcv19__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--border);
    backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv19__wish:hover { background: var(--accent); color: #F5F5F0; border-color: var(--accent); transform: scale(1.08); }
  .pcv19__wish.active { color: var(--accent); background: #FFFFFF; border-color: var(--accent); }

  /* QUICK ADD HOVER */
  .pcv19__quick-box {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    z-index: 3;
    transform: translateY(100%);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv19__card:hover .pcv19__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv19__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 16px 16px; }
  }

  .pcv19__quick-btn {
    width: 100%;
    padding: 12px 16px;
    background: var(--accent);
    color: #F5F5F0;
    font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.15em;
    font-family: var(--f-sans);
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv19__quick-btn:hover { background: var(--accent-hover); }
  .pcv19__quick-btn:disabled { background: #E5E5E0; color: #8C8C85; cursor: not-allowed; }

  /* CARD CONTENT */
  .pcv19__content { padding: 18px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv19__vendor { font-size: 10px; text-transform: uppercase; color: var(--muted); font-weight: 500; letter-spacing: 0.15em; }
  .pcv19__item-title { font-family: var(--f-serif); font-size: 17px; font-weight: 500; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv19__rating { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; color: var(--accent); }
  .pcv19__stars { letter-spacing: 2px; }
  .pcv19__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 300; }

  /* PRICE */
  .pcv19__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv19__price { font-size: 16px; font-weight: 500; color: var(--text); font-family: var(--f-sans); }
  .pcv19__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv19__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv19__swatch { width: 12px; height: 12px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv19__swatch:hover, .pcv19__swatch.active { transform: scale(1.25); border-color: var(--accent); }

  /* URGENCY MICRO */
  .pcv19__urgency { font-size: 11px; color: var(--accent); font-style: italic; font-family: var(--f-serif); display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv19__toast {
    position: fixed; bottom: 24px; right: 24px;
    background: var(--accent); color: #F5F5F0;
    padding: 12px 24px; font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.12em;
    font-family: var(--f-sans);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pcv19__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv19">
  <div class="pcv19__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv19__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv19__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv19__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv19__viewall">
            {{ section.settings.view_all_label | default: 'View Zen Collection' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv19__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v19', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v19', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv19__toast" id="pcv19-toast">Object Selected</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv19-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv19Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Selecting...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ Selected';
        showT('Object Selected');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv19-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

