{%- comment -%}
  PC V10 — PLAYFUL NEO-POP GEN-Z PRODUCT GRID
  Design: Soft Lavender (#F3E8FF), Bubblegum Pink (#FF6B6B) & Electric Purple (#7C3AED) accents
  Card Shape: 18px Soft Bubble corners, 3D pop offset shadow, Fredoka & Lexend typography
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Lexend:wght@400;500;600;700&display=swap');

  .pcv10 {
    --bg: {{ section.settings.bg_color | default: '#F3E8FF' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#2E1065' }};
    --muted: {{ section.settings.muted_color | default: '#6D28D9' }};
    --accent: {{ section.settings.accent_color | default: '#FF6B6B' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#EE5252' }};
    --border: {{ section.settings.border_color | default: '#DDD6FE' }};
    --pop-shadow: #7C3AED;
    --badge-sale-bg: #FF6B6B;
    --badge-sale-text: #FFFFFF;
    --f-heading: 'Fredoka', sans-serif;
    --f-body: 'Lexend', sans-serif;
    --r-card: 18px;
    --ease: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv10 *, .pcv10 *::before, .pcv10 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv10 a { color: inherit; text-decoration: none; }
  .pcv10 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv10 img { max-width: 100%; display: block; }

  .pcv10__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv10__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv10__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv10__title { font-family: var(--f-heading); font-size: 32px; font-weight: 700; color: var(--text); letter-spacing: -0.01em; }
  @media (min-width: 768px) { .pcv10__title { font-size: 40px; } }
  .pcv10__sub { font-size: 15px; color: var(--muted); font-weight: 500; }
  .pcv10__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; font-family: var(--f-heading); color: #FFFFFF; background: var(--pop-shadow); padding: 10px 22px; border-radius: 30px; box-shadow: 3px 3px 0 #2E1065; transition: var(--ease); }
  .pcv10__viewall:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 #2E1065; background: var(--accent); }

  /* GRID */
  .pcv10__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv10__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv10__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv10__card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 4px 4px 0 var(--pop-shadow);
    transition: var(--ease);
  }
  .pcv10__card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 8px 8px 0 var(--pop-shadow);
    border-color: var(--pop-shadow);
  }

  /* IMAGE CONTAINER */
  .pcv10__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #F5F3FF;
    overflow: hidden;
    border-radius: var(--r-card) var(--r-card) 0 0;
  }
  .pcv10__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .pcv10__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv10__card:hover .pcv10__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.08) rotate(1deg);
    {% endif %}
  }
  .pcv10__card:hover .pcv10__img--sec { opacity: 1; transform: scale(1.08) rotate(1deg); }

  /* BADGES */
  .pcv10__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv10__badge { font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 4px 10px; border-radius: 20px; font-family: var(--f-heading); letter-spacing: 0.05em; box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.15); }
  .pcv10__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv10__badge--tag { background: #4ADE80; color: #052E16; }
  .pcv10__badge--sold { background: #6B7280; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv10__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 2px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    z-index: 3;
    transition: var(--ease);
    box-shadow: 2px 2px 0 var(--pop-shadow);
  }
  .pcv10__wish:hover { background: var(--accent); color: #FFFFFF; border-color: var(--accent); transform: scale(1.15) rotate(-5deg); }
  .pcv10__wish.active { color: #FFFFFF; background: var(--accent); border-color: var(--accent); }

  /* QUICK ADD BUTTON */
  .pcv10__quick-box { padding: 12px 14px 14px; background: var(--card-bg); }
  .pcv10__quick-btn {
    width: 100%;
    padding: 10px 16px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 13px; font-weight: 700; font-family: var(--f-heading);
    border-radius: 25px;
    border: 2px solid #2E1065;
    box-shadow: 3px 3px 0 #2E1065;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv10__quick-btn:hover { background: #4ADE80; color: #052E16; transform: translate(-1px, -1px); box-shadow: 4px 4px 0 #2E1065; }
  .pcv10__quick-btn:disabled { background: #E5E7EB; color: #9CA3AF; border-color: #9CA3AF; box-shadow: none; cursor: not-allowed; }

  /* CARD CONTENT */
  .pcv10__content { padding: 14px 14px 0 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv10__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 700; font-family: var(--f-heading); letter-spacing: 0.08em; }
  .pcv10__item-title { font-family: var(--f-heading); font-size: 16px; font-weight: 600; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv10__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; color: var(--pop-shadow); font-weight: 700; }
  .pcv10__stars { letter-spacing: 1px; }
  .pcv10__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 500; }

  /* PRICE */
  .pcv10__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv10__price { font-size: 17px; font-weight: 700; color: var(--text); font-family: var(--f-heading); }
  .pcv10__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv10__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv10__swatch { width: 14px; height: 14px; border-radius: 50%; border: 2px solid #2E1065; cursor: pointer; transition: var(--ease); }
  .pcv10__swatch:hover, .pcv10__swatch.active { transform: scale(1.3); box-shadow: 2px 2px 0 #2E1065; }

  /* URGENCY MICRO */
  .pcv10__urgency { font-size: 11px; color: var(--accent); font-weight: 700; font-family: var(--f-heading); display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv10__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: #4ADE80; color: #052E16;
    border: 2px solid #2E1065; box-shadow: 4px 4px 0 #2E1065;
    padding: 12px 22px; border-radius: 25px;
    font-size: 13px; font-weight: 700; font-family: var(--f-heading);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .pcv10__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv10">
  <div class="pcv10__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv10__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv10__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv10__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv10__viewall">
            {{ section.settings.view_all_label | default: 'Shop The Drop' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv10__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v10', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v10', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv10__toast" id="pcv10-toast">🎉 Grabbed to Bag!</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv10-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv10Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'GRABBING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ GRABBED';
        showT('🎉 GRABBED TO BAG!');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv10-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

