{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#2b302a'
  assign accent_color = section.settings.accent_color | default: '#4a6741'
  assign heading = section.settings.heading | default: 'New Arrivals'
  assign collection = collections[section.settings.collection]
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
  }
  
  .hp7-feat-container-{{ section_id }} {
    max-width: 1300px;
    margin: 0 auto;
  }
  
  .hp7-feat-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
    border-bottom: 1px solid rgba(43, 48, 42, 0.1);
    padding-bottom: 20px;
  }
  
  .hp7-feat-header-{{ section_id }} h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 500;
    margin: 0;
  }
  
  .hp7-feat-shop-all-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: {{ accent_color }};
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    position: relative;
    padding-bottom: 5px;
  }
  
  .hp7-feat-shop-all-{{ section_id }}::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: {{ accent_color }};
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }
  
  .hp7-feat-shop-all-{{ section_id }}:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  
  .hp7-feat-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }
  
  .hp7-product-card-{{ section_id }} {
    position: relative;
    group: card;
  }
  
  .hp7-product-image-wrapper-{{ section_id }} {
    position: relative;
    aspect-ratio: 3/4;
    border-radius: 200px 200px 20px 20px; /* Organic top */
    overflow: hidden;
    background-color: #f5f5f5;
    margin-bottom: 20px;
  }
  
  .hp7-product-image-wrapper-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }
  
  .hp7-product-card-{{ section_id }}:hover .hp7-product-image-wrapper-{{ section_id }} img {
    transform: scale(1.05);
  }
  
  /* Hover second image if available */
  .hp7-product-img-hover-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  
  .hp7-product-card-{{ section_id }}:hover .hp7-product-img-hover-{{ section_id }} {
    opacity: 1;
  }
  
  .hp7-eco-badge-{{ section_id }} {
    position: absolute;
    top: 15px;
    left: 50%;
    transform: translateX(-50%);
    background: {{ bg_color }};
    color: {{ accent_color }};
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 6px 15px;
    border-radius: 30px;
    z-index: 2;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  }
  
  .hp7-product-info-{{ section_id }} {
    text-align: center;
  }
  
  .hp7-product-title-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.1rem;
    font-weight: 500;
    margin: 0 0 5px 0;
    color: {{ text_color }};
    text-decoration: none;
  }
  
  .hp7-product-price-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    color: {{ text_color | color_modify: 'alpha', 0.7 }};
  }
  
  .hp7-add-btn-{{ section_id }} {
    display: block;
    width: 100%;
    background-color: transparent;
    border: 1px solid {{ text_color | color_modify: 'alpha', 0.2 }};
    color: {{ text_color }};
    padding: 12px 0;
    font-family: 'DM Sans', sans-serif;
    font-weight: 600;
    border-radius: 30px;
    cursor: pointer;
    margin-top: 15px;
    transition: all 0.3s ease;
    opacity: 0;
    transform: translateY(10px);
  }
  
  .hp7-product-card-{{ section_id }}:hover .hp7-add-btn-{{ section_id }} {
    opacity: 1;
    transform: translateY(0);
  }
  
  .hp7-add-btn-{{ section_id }}:hover {
    background-color: {{ accent_color }};
    border-color: {{ accent_color }};
    color: #fff;
  }

  @media (max-width: 992px) {
    .hp7-feat-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
    .hp7-add-btn-{{ section_id }} {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @media (max-width: 576px) {
    .hp7-feat-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
  }
</style>

<div class="hp7-feat-container-{{ section_id }}">
  <div class="hp7-feat-header-{{ section_id }}">
    <h2>{{ heading }}</h2>
    <a href="{{ collection.url | default: '#' }}" class="hp7-feat-shop-all-{{ section_id }}">Shop All</a>
  </div>
  
  <div class="hp7-feat-grid-{{ section_id }}">
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: 4 %}
        <div class="hp7-product-card-{{ section_id }}">
          <a href="{{ product.url }}" class="hp7-product-image-wrapper-{{ section_id }}" style="display: block;">
            {% if product.tags contains 'sustainable' or product.tags contains 'organic' %}
              <div class="hp7-eco-badge-{{ section_id }}">Earth Friendly</div>
            {% endif %}
            
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" loading="lazy" width="400" height="500">
            
            {% if product.images[1] != blank %}
              <img src="{{ product.images[1] | image_url: width: 600 }}" alt="{{ product.title }}" class="hp7-product-img-hover-{{ section_id }}" loading="lazy" width="400" height="500">
            {% endif %}
          </a>
          
          <div class="hp7-product-info-{{ section_id }}">
            <a href="{{ product.url }}" style="text-decoration: none;">
              <h3 class="hp7-product-title-{{ section_id }}">{{ product.title }}</h3>
            </a>
            <div class="hp7-product-price-{{ section_id }}">{{ product.price | money }}</div>
            
            <form action="/cart/add" method="post">
              <input type="hidden" name="id" value="{{ product.variants.first.id }}">
              <button type="submit" class="hp7-add-btn-{{ section_id }}">Add to Cart</button>
            </form>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <div class="hp7-product-card-{{ section_id }}">
          <div class="hp7-product-image-wrapper-{{ section_id }}">
            <div class="hp7-eco-badge-{{ section_id }}">Organic</div>
            <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #eaeaea; color: #999;">
              Product {{ i }}
            </div>
          </div>
          <div class="hp7-product-info-{{ section_id }}">
            <h3 class="hp7-product-title-{{ section_id }}">Linen Essential Shirt</h3>
            <div class="hp7-product-price-{{ section_id }}">$85.00</div>
            <button class="hp7-add-btn-{{ section_id }}">Add to Cart</button>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP7 Featured Products",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2b302a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#4a6741"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "HP7 Featured Products"
    }
  ]
}
{% endschema %}
