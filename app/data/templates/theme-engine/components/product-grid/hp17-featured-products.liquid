{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0A0A0A'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 1px solid rgba(0, 255, 65, 0.3);
  }
  
  .hp17-fp-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp17-fp-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }
  
  .hp17-fp-heading-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: clamp(2rem, 4vw, 4rem);
    text-transform: uppercase;
    color: #FFF;
    margin: 0;
    line-height: 1;
  }
  
  .hp17-fp-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }
  
  .hp17-fp-card-{{ section_id }} {
    display: flex;
    background: #000;
    border: 1px solid rgba(184, 0, 255, 0.3);
    text-decoration: none;
    color: #FFF;
    position: relative;
    transition: all 0.3s ease;
  }
  
  .hp17-fp-card-{{ section_id }}:hover {
    border-color: #B800FF;
    box-shadow: 0 0 20px rgba(184, 0, 255, 0.2);
  }
  
  .hp17-fp-image-wrap-{{ section_id }} {
    width: 40%;
    position: relative;
    overflow: hidden;
    border-right: 1px solid rgba(184, 0, 255, 0.3);
  }
  
  .hp17-fp-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: hue-rotate(280deg);
    transition: transform 0.5s ease;
  }
  
  .hp17-fp-card-{{ section_id }}:hover .hp17-fp-image-{{ section_id }} {
    transform: scale(1.05);
  }
  
  .hp17-fp-info-{{ section_id }} {
    width: 60%;
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .hp17-fp-title-{{ section_id }} {
    font-family: 'Arial', sans-serif;
    font-weight: bold;
    font-size: 1.5rem;
    text-transform: uppercase;
    margin: 0 0 10px 0;
    color: #FFF;
  }
  
  .hp17-fp-price-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.2rem;
    color: #B800FF;
    font-weight: bold;
    margin-bottom: 20px;
  }
  
  .hp17-fp-btn-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9rem;
    font-weight: bold;
    color: #000;
    background: #B800FF;
    padding: 10px 20px;
    text-align: center;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.3s ease;
    align-self: flex-start;
  }
  
  .hp17-fp-card-{{ section_id }}:hover .hp17-fp-btn-{{ section_id }} {
    background: #FFF;
    box-shadow: 0 0 15px rgba(255,255,255,0.5);
  }

  @media (max-width: 992px) {
    .hp17-fp-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
  
  @media (max-width: 600px) {
    .hp17-fp-card-{{ section_id }} {
      flex-direction: column;
    }
    .hp17-fp-image-wrap-{{ section_id }} {
      width: 100%;
      padding-top: 100%;
      border-right: none;
      border-bottom: 1px solid rgba(184, 0, 255, 0.3);
    }
    .hp17-fp-info-{{ section_id }} {
      width: 100%;
    }
  }
</style>

<div class="hp17-fp-container-{{ section_id }}">
  <div class="hp17-fp-header-{{ section_id }}">
    <h2 class="hp17-fp-heading-{{ section_id }}">{{ section.settings.title | default: 'HOT_DROPS' }}</h2>
  </div>
  
  <div class="hp17-fp-grid-{{ section_id }}">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: 2 %}
        <a href="{{ product.url }}" class="hp17-fp-card-{{ section_id }}">
          <div class="hp17-fp-image-wrap-{{ section_id }}">
            <img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 600 }}" class="hp17-fp-image-{{ section_id }}" loading="lazy" alt="{{ product.title }}">
          </div>
          <div class="hp17-fp-info-{{ section_id }}">
            <div>
              <h3 class="hp17-fp-title-{{ section_id }}">{{ product.title }}</h3>
              <div class="hp17-fp-price-{{ section_id }}">{{ product.price | money }}</div>
            </div>
            <div class="hp17-fp-btn-{{ section_id }}">ACQUIRE</div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..2) %}
        <a href="#" class="hp17-fp-card-{{ section_id }}">
          <div class="hp17-fp-image-wrap-{{ section_id }}">
            <div class="hp17-fp-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
          </div>
          <div class="hp17-fp-info-{{ section_id }}">
            <div>
              <h3 class="hp17-fp-title-{{ section_id }}">EXO-SUIT MK{{ i }}</h3>
              <div class="hp17-fp-price-{{ section_id }}">$450.00</div>
            </div>
            <div class="hp17-fp-btn-{{ section_id }}">ACQUIRE</div>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP17 Featured Products",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A0A0A"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "HOT_DROPS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "HP17 Featured Products"
    }
  ]
}
{% endschema %}
