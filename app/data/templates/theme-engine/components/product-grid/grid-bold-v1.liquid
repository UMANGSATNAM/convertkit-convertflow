{%- comment -%}
  Component: grid-bold-lifestyle-v1
  Family: Lifestyle | Style: bold
  Archetypes: streetwear, hype
  v2.0 — StoreForge Component Library
{%- endcomment -%}
<section class="featured-collection featured-collection--streetwear" style="padding: var(--space-64) 0; background-color: var(--color-background); border-bottom: 2px solid var(--color-border);">
  <div class="container">
    
    {%- if section.settings.title != blank -%}
    <header class="section-header text-left" style="margin-bottom: var(--space-48); border-left: 6px solid var(--color-accent); padding-left: var(--space-16);">
      <h2 class="section-title" style="font-family: var(--font-heading-family); font-size: 2.5rem; font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em; line-height: 1; margin: 0;">
        {{ section.settings.title | escape }}
      </h2>
    </header>
    {%- endif -%}

    {%- liquid
      assign collection_obj = collections[section.settings.collection]
      assign limit = section.settings.products_to_show
      assign cols = section.settings.columns_desktop
    -%}

    <div class="grid grid-cols-1 md:grid-cols-2 grid-cols-lg-{{ cols }}" style="--grid-spacing: var(--space-32);">
      {%- if collection_obj != blank and collection_obj.products_count > 0 -%}
        {%- for product in collection_obj.products limit: limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <div class="product-card product-card--streetwear product-card--placeholder" style="border: 2px solid var(--color-border); box-shadow: var(--card-shadow); background-color: #fff; overflow: hidden; display: flex; flex-direction: column;">
            <div style="aspect-ratio: 0.8; background-color: var(--color-surface); border-bottom: 2px solid var(--color-border); display: flex; align-items: center; justify-content: center;">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div style="padding: var(--space-16); text-align: left;">
              <h3 class="product-card-title" style="font-family: var(--font-heading-family); font-size: 1.15rem; margin: 0 0 var(--space-8) 0;">
                DROP OVERSIZED TEE {{ i }}
              </h3>
              <div class="price-container">
                <span class="price-item price-item--regular">$85.00</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns Desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor name",
      "default": false
    }
  ]
}
{% endschema %}
