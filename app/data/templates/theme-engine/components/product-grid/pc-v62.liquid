{%- comment -%}
  PC V62 — LUXURY SWISS WATCHMAKING & HOROLOGY PRODUCT GRID
  Design: Midnight Obsidian (#080A0F), Champagne Gold (#D4AF37) & Platinum Silver (#E2E8F0) accents, Cinzel & Jost typography
  Card Shape: 2px fine corners, 1px gold watch bezel borders, Swiss horology luxury aesthetic
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Jost:wght@400;500;600;700&display=swap');

  .pcv62 {
    --bg: {{ section.settings.bg_color | default: '#080A0F' }};
    --card-bg: {{ section.settings.card_bg | default: '#10141E' }};
    --text: {{ section.settings.text_color | default: '#F8FAFC' }};
    --muted: {{ section.settings.muted_color | default: '#D4AF37' }};
    --accent: {{ section.settings.accent_color | default: '#D4AF37' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#B59226' }};
    --border: {{ section.settings.border_color | default: '#1E2638' }};
    --badge-sale-bg: #D4AF37;
    --badge-sale-text: #080A0F;
    --f-serif: 'Cinzel', serif;
    --f-sans: 'Jost', sans-serif;
    --r-card: 2px;
    --ease: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-sans);
    padding: {{ section.settings.padding_top | default: 64 }}px 0 {{ section.settings.padding_bottom | default: 64 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv62 *, .pcv62 *::before, .pcv62 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv62 a { color: inherit; text-decoration: none; }
  .pcv62 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv62 img { max-width: 100%; display: block; }

  .pcv62__wrap { max-width: 1320px; margin: 0 auto; padding: 0 24px; }

  /* HEADER */
  .pcv62__head { display: flex; flex-direction: column; gap: 10px; margin-bottom: 44px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv62__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv62__title { font-family: var(--f-serif); font-size: 30px; font-weight: 600; color: var(--text); letter-spacing: 0.1em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv62__title { font-size: 40px; } }
  .pcv62__sub { font-size: 14px; color: var(--muted); letter-spacing: 0.05em; font-style: italic; }
  .pcv62__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.25em; color: var(--accent); border-bottom: 1px solid var(--accent); padding-bottom: 3px; transition: var(--ease); }
  .pcv62__viewall:hover { color: #FFFFFF; border-color: #FFFFFF; }

  /* GRID */
  .pcv62__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv62__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 28px; }
  }
  @media (min-width: 1024px) {
    .pcv62__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 32px; }
  }

  /* CARD */
  .pcv62__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.5);
    transition: var(--ease);
  }
  .pcv62__card:hover {
    border-color: var(--accent);
    box-shadow: 0 15px 35px -5px rgba(212, 175, 55, 0.25);
  }

  /* IMAGE CONTAINER */
  .pcv62__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #05060A;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .pcv62__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pcv62__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv62__card:hover .pcv62__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv62__card:hover .pcv62__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv62__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv62__badge { font-size: 9px; font-weight: 600; text-transform: uppercase; padding: 4px 10px; border-radius: 2px; letter-spacing: 0.18em; font-family: var(--f-sans); }
  .pcv62__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv62__badge--tag { background: rgba(212, 175, 55, 0.15); color: #D4AF37; border: 1px solid #D4AF37; }
  .pcv62__badge--sold { background: #1E2638; color: #777777; }

  /* WISHLIST BUTTON */
  .pcv62__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(8, 10, 15, 0.85);
    border: 1px solid rgba(212, 175, 55, 0.4);
    backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv62__wish:hover { background: var(--accent); color: #080A0F; border-color: var(--accent); }
  .pcv62__wish.active { color: #080A0F; background: var(--accent); border-color: var(--accent); }

  /* QUICK ADD HOVER */
  .pcv62__quick-box {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    z-index: 3;
    transform: translateY(100%);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv62__card:hover .pcv62__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv62__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 16px 16px; }
  }

  .pcv62__quick-btn {
    width: 100%;
    padding: 13px 16px;
    background: var(--accent);
    color: #080A0F;
    font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.2em;
    font-family: var(--f-sans);
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv62__quick-btn:hover { background: #FFFFFF; color: #080A0F; }
  .pcv62__quick-btn:disabled { background: #1E2638; color: #777777; cursor: not-allowed; }

  /* CARD CONTENT */
  .pcv62__content { padding: 18px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv62__vendor { font-size: 9px; text-transform: uppercase; color: var(--accent); font-weight: 500; letter-spacing: 0.25em; }
  .pcv62__item-title { font-family: var(--f-serif); font-size: 17px; font-weight: 500; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; letter-spacing: 0.05em; }

  /* RATING */
  .pcv62__rating { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; color: var(--accent); }
  .pcv62__stars { letter-spacing: 2px; text-shadow: 0 0 6px rgba(212, 175, 55, 0.4); }
  .pcv62__rev-cnt { color: #888888; font-size: 11px; }

  /* PRICE */
  .pcv62__price-row { display: flex; align-items: baseline; justify-content: center; gap: 10px; margin-top: auto; padding-top: 4px; }
  .pcv62__price { font-size: 17px; font-weight: 500; color: var(--text); font-family: var(--f-sans); letter-spacing: 0.05em; }
  .pcv62__cmp-price { font-size: 13px; color: #888888; text-decoration: line-through; }

  /* SWATCHES */
  .pcv62__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv62__swatch { width: 12px; height: 12px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv62__swatch:hover, .pcv62__swatch.active { transform: scale(1.25); border-color: var(--accent); box-shadow: 0 0 6px var(--accent); }

  /* URGENCY MICRO */
  .pcv62__urgency { font-size: 11px; color: var(--accent); font-style: italic; font-family: var(--f-serif); display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv62__toast {
    position: fixed; bottom: 24px; right: 24px;
    background: var(--accent); color: #080A0F;
    padding: 14px 24px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.15em;
    font-family: var(--f-sans);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pcv62__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv62">
  <div class="pcv62__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv62__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv62__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv62__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv62__viewall">
            {{ section.settings.view_all_label | default: 'Explore Swiss Horology' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv62__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% render 'card-v62', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v62', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv62__toast" id="pcv62-toast">Timepiece Acquired</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv62-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv62Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Winding...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = 'Acquired';
        showT('Timepiece Acquired');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv62-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

