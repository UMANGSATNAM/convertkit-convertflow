{%- comment -%}
  PC V18 — HIGH-PERFORMANCE ACTIVEWEAR PRODUCT GRID
  Design: Carbon Black (#0F172A), Dynamic Crimson Red (#DC2626) accents, Montserrat & Barlow typography
  Card Shape: 4px corners, skewed accent badges, fast speed-slide quick add
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:ital,wght@0,600;0,700;0,800;1,600&family=Montserrat:wght@400;500;600;700;800&display=swap');

  .pcv18 {
    --bg: {{ section.settings.bg_color | default: '#0F172A' }};
    --card-bg: {{ section.settings.card_bg | default: '#1E293B' }};
    --text: {{ section.settings.text_color | default: '#F8FAFC' }};
    --muted: {{ section.settings.muted_color | default: '#94A3B8' }};
    --accent: {{ section.settings.accent_color | default: '#DC2626' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#B91C1C' }};
    --border: {{ section.settings.border_color | default: '#334155' }};
    --badge-sale-bg: #DC2626;
    --badge-sale-text: #FFFFFF;
    --f-heading: 'Barlow Semi Condensed', sans-serif;
    --f-body: 'Montserrat', sans-serif;
    --r-card: 4px;
    --ease: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv18 *, .pcv18 *::before, .pcv18 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv18 a { color: inherit; text-decoration: none; }
  .pcv18 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv18 img { max-width: 100%; display: block; }

  .pcv18__wrap { max-width: 1320px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv18__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv18__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv18__title { font-family: var(--f-heading); font-size: 32px; font-weight: 800; color: var(--text); letter-spacing: 0.02em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv18__title { font-size: 42px; } }
  .pcv18__sub { font-size: 15px; color: var(--muted); }
  .pcv18__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; font-family: var(--f-heading); text-transform: uppercase; letter-spacing: 0.08em; color: #FFFFFF; background: var(--accent); padding: 8px 20px; transform: skewX(-12deg); transition: var(--ease); }
  .pcv18__viewall span { transform: skewX(12deg); }
  .pcv18__viewall:hover { background: var(--accent-hover); box-shadow: 0 0 15px rgba(220, 38, 38, 0.4); }

  /* GRID */
  .pcv18__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 16px;
  }
  @media (min-width: 640px) {
    .pcv18__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 20px; }
  }
  @media (min-width: 1024px) {
    .pcv18__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 24px; }
  }

  /* CARD */
  .pcv18__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--ease);
  }
  .pcv18__card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 10px 25px -5px rgba(220, 38, 38, 0.3);
  }

  /* IMAGE BOX */
  .pcv18__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '3/4' }};
    background: #090D16;
    overflow: hidden;
  }
  .pcv18__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .pcv18__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv18__card:hover .pcv18__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.06);
    {% endif %}
  }
  .pcv18__card:hover .pcv18__img--sec { opacity: 1; transform: scale(1.06); }

  /* BADGES */
  .pcv18__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv18__badge { font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 4px 10px; transform: skewX(-12deg); letter-spacing: 0.05em; font-family: var(--f-heading); }
  .pcv18__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv18__badge--tag { background: #FFFFFF; color: #0F172A; }
  .pcv18__badge--sold { background: #475569; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv18__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 4px;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv18__wish:hover { background: var(--accent); color: #FFFFFF; border-color: var(--accent); transform: scale(1.05); }
  .pcv18__wish.active { color: #FFFFFF; background: var(--accent); border-color: var(--accent); }

  /* QUICK ADD HOVER */
  .pcv18__quick-box {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    z-index: 3;
    transform: translateY(100%);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv18__card:hover .pcv18__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv18__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 12px 12px; }
  }

  .pcv18__quick-btn {
    width: 100%;
    padding: 11px 16px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    font-family: var(--f-heading);
    border-radius: 2px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
    box-shadow: 0 4px 15px rgba(220, 38, 38, 0.4);
  }
  .pcv18__quick-btn:hover { background: var(--accent-hover); box-shadow: 0 4px 20px rgba(220, 38, 38, 0.6); }
  .pcv18__quick-btn:disabled { background: #334155; color: #64748B; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv18__content { padding: 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; }

  .pcv18__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 800; font-family: var(--f-heading); letter-spacing: 0.1em; }
  .pcv18__item-title { font-family: var(--f-heading); font-size: 17px; font-weight: 700; color: var(--text); text-transform: uppercase; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv18__rating { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--accent); font-weight: 700; }
  .pcv18__stars { letter-spacing: 1px; }
  .pcv18__rev-cnt { color: var(--muted); font-size: 11px; }

  /* PRICE */
  .pcv18__price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv18__price { font-size: 17px; font-weight: 700; color: var(--text); font-family: var(--f-heading); }
  .pcv18__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv18__swatches { display: flex; gap: 6px; align-items: center; margin-top: 4px; }
  .pcv18__swatch { width: 13px; height: 13px; border-radius: 2px; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv18__swatch:hover, .pcv18__swatch.active { transform: scale(1.2); border-color: var(--accent); box-shadow: 0 0 6px var(--accent); }

  /* URGENCY MICRO */
  .pcv18__urgency { font-size: 11px; color: var(--accent); font-weight: 800; font-family: var(--f-heading); text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv18__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #FFFFFF;
    padding: 12px 22px; border-radius: 2px;
    font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;
    font-family: var(--f-heading);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 10px 25px rgba(220, 38, 38, 0.4);
  }
  .pcv18__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv18">
  <div class="pcv18__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv18__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv18__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv18__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv18__viewall">
            <span>{{ section.settings.view_all_label | default: 'Shop Performance Range' }} &rarr;</span>
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv18__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v18', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v18', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv18__toast" id="pcv18-toast">Activewear Added</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv18-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv18Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'ADDING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ ADDED';
        showT('Activewear Added');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv18-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

