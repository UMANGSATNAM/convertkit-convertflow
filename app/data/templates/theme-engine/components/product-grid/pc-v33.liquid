{%- comment -%}
  PC V33 — FRENCH RIVIERA RETRO COASTAL PRODUCT GRID
  Design: Sand Cream (#FFFBF0), Mediterranean Blue (#1D4ED8) & Coral Red (#EF4444) accents, Playfair Display & Jost typography
  Card Shape: 16px corners, 2px blue borders, retro nautical resort aesthetic
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap');

  .pcv33 {
    --bg: {{ section.settings.bg_color | default: '#FFFBF0' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#1E3A8A' }};
    --muted: {{ section.settings.muted_color | default: '#3B82F6' }};
    --accent: {{ section.settings.accent_color | default: '#1D4ED8' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#1E40AF' }};
    --border: {{ section.settings.border_color | default: '#1D4ED8' }};
    --badge-sale-bg: #EF4444;
    --badge-sale-text: #FFFFFF;
    --f-serif: 'Playfair Display', serif;
    --f-sans: 'Jost', sans-serif;
    --r-card: 16px;
    --ease: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-sans);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv33 *, .pcv33 *::before, .pcv33 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv33 a { color: inherit; text-decoration: none; }
  .pcv33 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv33 img { max-width: 100%; display: block; }

  .pcv33__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv33__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv33__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv33__title { font-family: var(--f-serif); font-size: 32px; font-weight: 700; color: var(--text); letter-spacing: -0.01em; }
  @media (min-width: 768px) { .pcv33__title { font-size: 40px; } }
  .pcv33__sub { font-size: 15px; color: var(--muted); font-style: italic; }
  .pcv33__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; color: #FFFFFF; background: var(--accent); padding: 9px 22px; border-radius: 25px; transition: var(--ease); }
  .pcv33__viewall:hover { background: var(--accent-hover); transform: scale(1.04); }

  /* GRID */
  .pcv33__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv33__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv33__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv33__card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 10px 20px -5px rgba(29, 78, 216, 0.12);
    transition: var(--ease);
  }
  .pcv33__card:hover {
    transform: translateY(-5px) rotate(-1deg);
    box-shadow: 0 16px 30px -8px rgba(29, 78, 216, 0.22);
  }

  /* IMAGE CONTAINER */
  .pcv33__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '3/4' }};
    background: #EFF6FF;
    overflow: hidden;
    border-bottom: 2px solid var(--border);
  }
  .pcv33__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pcv33__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv33__card:hover .pcv33__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv33__card:hover .pcv33__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv33__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv33__badge { font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 4px 10px; border-radius: 12px; letter-spacing: 0.05em; font-family: var(--f-sans); }
  .pcv33__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv33__badge--tag { background: #1D4ED8; color: #FFFFFF; }
  .pcv33__badge--sold { background: #94A3B8; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv33__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 2px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv33__wish:hover { background: var(--accent); color: #FFFFFF; transform: scale(1.1); }
  .pcv33__wish.active { color: #FFFFFF; background: var(--accent); }

  /* QUICK ADD HOVER */
  .pcv33__quick-box {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    z-index: 3;
    transform: translateY(12px);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv33__card:hover .pcv33__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv33__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 14px 14px; }
  }

  .pcv33__quick-btn {
    width: 100%;
    padding: 11px 16px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 12px; font-weight: 700;
    border-radius: 20px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
    box-shadow: 0 4px 12px rgba(29, 78, 216, 0.3);
  }
  .pcv33__quick-btn:hover { background: var(--accent-hover); transform: scale(1.02); }
  .pcv33__quick-btn:disabled { background: #93C5FD; color: #FFFFFF; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv33__content { padding: 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv33__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 700; letter-spacing: 0.1em; }
  .pcv33__item-title { font-family: var(--f-serif); font-size: 17px; font-weight: 600; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv33__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; color: #EAB308; font-weight: 700; }
  .pcv33__stars { letter-spacing: 1px; }
  .pcv33__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 500; }

  /* PRICE */
  .pcv33__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv33__price { font-size: 17px; font-weight: 700; color: var(--text); font-family: var(--f-sans); }
  .pcv33__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv33__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv33__swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv33__swatch:hover, .pcv33__swatch.active { transform: scale(1.25); border-color: var(--accent); }

  /* URGENCY MICRO */
  .pcv33__urgency { font-size: 11px; color: #EF4444; font-style: italic; font-family: var(--f-serif); display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv33__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #FFFFFF;
    padding: 12px 22px; border-radius: 20px;
    font-size: 13px; font-weight: 700;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 25px rgba(29, 78, 216, 0.4);
  }
  .pcv33__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv33">
  <div class="pcv33__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv33__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv33__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv33__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv33__viewall">
            {{ section.settings.view_all_label | default: 'Explore Resort Drop' }} ⛵ &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv33__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v33', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v33', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv33__toast" id="pcv33-toast">Resort Wear Added!</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv33-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv33Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Adding...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ Added';
        showT('Resort Wear Added!');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv33-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

