{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - Luxury Newsletter
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-newsletter'
  assign bg_color = section.settings.bg_color | default: '#0f172a'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
-%}

<section id="caratlane-news-{{ sec_id }}" class="cl-news-wrap">
  <div class="cl-news-container">
    <div class="cl-news-box">
      <span class="cl-news-tag">🎁 EXCLUSIVE FESTIVE INSIDER PRIVILEGES</span>
      <h2 class="cl-news-title">JOIN THE CARATLANE LUXURY CLUB</h2>
      <p class="cl-news-desc">Subscribe to receive a <strong>₹1,000 Voucher</strong> on your first solitaire or fine gold jewelry order + early access to new collection launches.</p>

      <form onsubmit="event.preventDefault(); alert('✨ Welcome to CaratLane Insiders! Check your email for your ₹1,000 Discount Code.');" class="cl-news-form">
        <input type="email" placeholder="Enter your email address..." required class="cl-news-input" />
        <button type="submit" class="cl-btn-sub">
          GET ₹1,000 DISCOUNT &rarr;
        </button>
      </form>

      <div class="cl-news-perks">
        <span>🔒 Zero Spam Guarantee</span> • <span>💎 Exclusive Diamond Drop Alerts</span>
      </div>
    </div>
  </div>
</section>

<style>
  #caratlane-news-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    border-top: 1px solid rgba(212, 175, 55, 0.25);
  }
  #caratlane-news-{{ sec_id }} .cl-news-container { max-width: 900px; margin: 0 auto; text-align: center; }
  #caratlane-news-{{ sec_id }} .cl-news-tag { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #caratlane-news-{{ sec_id }} .cl-news-title { font-family: 'Cinzel', serif; font-size: clamp(26px, 3.5vw, 40px); font-weight: 800; color: #ffffff; margin: 8px 0 14px 0; }
  #caratlane-news-{{ sec_id }} .cl-news-desc { font-size: 14px; line-height: 1.6; color: #cbd5e1; margin-bottom: 28px; }
  #caratlane-news-{{ sec_id }} .cl-news-desc strong { color: {{ accent_color }}; }

  #caratlane-news-{{ sec_id }} .cl-news-form { display: flex; gap: 10px; max-width: 580px; margin: 0 auto 20px auto; }
  #caratlane-news-{{ sec_id }} .cl-news-input {
    flex-grow: 1;
    padding: 14px 20px;
    border-radius: 99px;
    border: 1px solid #475569;
    background: #1e293b;
    color: #ffffff;
    font-size: 13px;
    outline: none;
  }
  #caratlane-news-{{ sec_id }} .cl-news-input:focus { border-color: {{ accent_color }}; }
  #caratlane-news-{{ sec_id }} .cl-btn-sub {
    background: linear-gradient(135deg, {{ accent_color }} 0%, #b89628 100%);
    color: #0f172a;
    font-weight: 900;
    font-size: 12px;
    padding: 14px 28px;
    border-radius: 99px;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    letter-spacing: 0.5px;
    box-shadow: 0 8px 24px rgba(212, 175, 55, 0.25);
  }

  #caratlane-news-{{ sec_id }} .cl-news-perks { font-size: 11px; color: #94a3b8; }

  @media (max-width: 600px) {
    #caratlane-news-{{ sec_id }} .cl-news-form { flex-direction: column; }
    #caratlane-news-{{ sec_id }} .cl-btn-sub { width: 100%; text-align: center; }
  }
</style>

{% schema %}
{
  "name": "CaratLane Newsletter",
  "tag": "section",
  "class": "caratlane-newsletter-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0f172a" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane Newsletter" }
  ]
}
{% endschema %}
