{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - Spotlight Solitaire & 4Cs Matrix
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-featured-solitaire'
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#0f172a'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
-%}

<section id="caratlane-solitaire-{{ sec_id }}" class="cl-sol-wrap">
  <div class="cl-sol-container">
    <div class="cl-sol-grid">
      
      <!-- Media Left -->
      <div class="cl-sol-media">
        <span class="cl-sol-badge">★ IGI CERTIFIED NATURAL SOLITAIRE</span>
        <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=800&q=80" alt="Crown Solitaire Ring" class="cl-sol-img" loading="lazy" />
      </div>

      <!-- Specs Right -->
      <div class="cl-sol-content">
        <span class="cl-sol-sub">✨ THE SOLITAIRE MASTERPIECE</span>
        <h2 class="cl-sol-title">The Royal Crown Solitaire Ring</h2>
        <div class="cl-sol-rating">★★★★★ <span>(4.98/5 • 1,420 Verified Reviews)</span></div>

        <div class="cl-sol-price-row">
          <span class="cl-sol-price">₹48,999</span>
          <span class="cl-sol-orig">₹62,000</span>
          <span class="cl-sol-save">SAVE ₹13,001 (21% OFF)</span>
        </div>

        <p class="cl-sol-desc">Featuring an exquisite 0.50 Carat IGI Certified Ideal Cut Solitaire Diamond handset in 18k Solid Rose Gold. Crafted with micro-pave setting for maximum brilliance.</p>

        <!-- 4Cs Certification Matrix -->
        <div class="cl-4cs-matrix">
          <div class="cl-4c-box">
            <span class="cl-4c-label">CARAT</span>
            <span class="cl-4c-val">0.50 Ct</span>
          </div>
          <div class="cl-4c-box">
            <span class="cl-4c-label">CLARITY</span>
            <span class="cl-4c-val">VVS1</span>
          </div>
          <div class="cl-4c-box">
            <span class="cl-4c-label">COLOR</span>
            <span class="cl-4c-val">EF (Colorless)</span>
          </div>
          <div class="cl-4c-box">
            <span class="cl-4c-label">CUT</span>
            <span class="cl-4c-val">Ideal Hearts</span>
          </div>
        </div>

        <!-- Transparent Price Breakdown Accordion -->
        <div class="cl-price-breakdown">
          <div class="cl-pb-head">
            <span>📊 Transparent Price Breakdown:</span>
            <strong>₹48,999</strong>
          </div>
          <div class="cl-pb-list">
            <div class="cl-pb-row"><span>Gold Value (2.8g 18K):</span> <span>₹18,420</span></div>
            <div class="cl-pb-row"><span>Diamond Value (0.50 Ct VVS-EF):</span> <span>₹24,500</span></div>
            <div class="cl-pb-row"><span>Making Charges:</span> <span>₹6,079</span></div>
            <div class="cl-pb-row cl-pb-total"><span>Total Transparent Price:</span> <span>₹48,999</span></div>
          </div>
        </div>

        <div class="cl-sol-actions">
          <button type="button" class="cl-btn-buy" onclick="this.textContent = 'ADDED TO BAG! ✓'; setTimeout(() => this.textContent = 'BUY NOW WITH INSURED DISPATCH &rarr;', 2000)">
            BUY NOW WITH INSURED DISPATCH &rarr;
          </button>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  #caratlane-solitaire-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
  }
  #caratlane-solitaire-{{ sec_id }} .cl-sol-container { max-width: 1240px; margin: 0 auto; }
  #caratlane-solitaire-{{ sec_id }} .cl-sol-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  
  #caratlane-solitaire-{{ sec_id }} .cl-sol-media { position: relative; border-radius: 20px; overflow: hidden; border: 1px solid #e2e8f0; aspect-ratio: 1; background: #f8fafc; }
  #caratlane-solitaire-{{ sec_id }} .cl-sol-img { width: 100%; height: 100%; object-fit: cover; }
  #caratlane-solitaire-{{ sec_id }} .cl-sol-badge { position: absolute; top: 16px; left: 16px; background: #0f172a; color: {{ accent_color }}; font-size: 10px; font-weight: 900; padding: 6px 12px; border-radius: 6px; letter-spacing: 0.5px; }

  #caratlane-solitaire-{{ sec_id }} .cl-sol-sub { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #caratlane-solitaire-{{ sec_id }} .cl-sol-title { font-family: 'Cinzel', serif; font-size: clamp(26px, 3.5vw, 38px); font-weight: 800; color: #0f172a; margin: 6px 0 10px 0; }
  #caratlane-solitaire-{{ sec_id }} .cl-sol-rating { color: #f59e0b; font-size: 12px; margin-bottom: 16px; }
  #caratlane-solitaire-{{ sec_id }} .cl-sol-rating span { color: #64748b; margin-left: 6px; }

  #caratlane-solitaire-{{ sec_id }} .cl-sol-price-row { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; flex-wrap: wrap; }
  #caratlane-solitaire-{{ sec_id }} .cl-sol-price { font-size: 26px; font-weight: 900; color: #0f172a; }
  #caratlane-solitaire-{{ sec_id }} .cl-sol-orig { font-size: 16px; text-decoration: line-through; color: #94a3b8; }
  #caratlane-solitaire-{{ sec_id }} .cl-sol-save { font-size: 11px; font-weight: 800; color: #059669; background: #ecfdf5; padding: 4px 8px; border-radius: 4px; }
  
  #caratlane-solitaire-{{ sec_id }} .cl-sol-desc { font-size: 14px; line-height: 1.6; color: #475569; margin-bottom: 22px; }

  #caratlane-solitaire-{{ sec_id }} .cl-4cs-matrix { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 24px; }
  #caratlane-solitaire-{{ sec_id }} .cl-4c-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px 10px; text-align: center; }
  #caratlane-solitaire-{{ sec_id }} .cl-4c-label { font-size: 9px; font-weight: 800; color: #64748b; letter-spacing: 0.5px; display: block; }
  #caratlane-solitaire-{{ sec_id }} .cl-4c-val { font-size: 13px; font-weight: 900; color: #0f172a; margin-top: 2px; display: block; }

  #caratlane-solitaire-{{ sec_id }} .cl-price-breakdown { background: #fdfbf7; border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 12px; padding: 16px; margin-bottom: 24px; font-size: 12px; }
  #caratlane-solitaire-{{ sec_id }} .cl-pb-head { display: flex; justify-content: space-between; font-weight: 800; margin-bottom: 10px; color: #0f172a; }
  #caratlane-solitaire-{{ sec_id }} .cl-pb-row { display: flex; justify-content: space-between; color: #64748b; margin-bottom: 4px; }
  #caratlane-solitaire-{{ sec_id }} .cl-pb-total { font-weight: 900; color: #0f172a; border-top: 1px solid #e2e8f0; padding-top: 6px; margin-top: 6px; }

  #caratlane-solitaire-{{ sec_id }} .cl-btn-buy {
    width: 100%;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: {{ accent_color }};
    border: 1px solid {{ accent_color }};
    padding: 16px;
    border-radius: 99px;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.8px;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.15);
    transition: transform 0.2s ease;
  }
  #caratlane-solitaire-{{ sec_id }} .cl-btn-buy:hover { transform: translateY(-2px); }

  @media (max-width: 990px) {
    #caratlane-solitaire-{{ sec_id }} .cl-sol-grid { grid-template-columns: 1fr; }
    #caratlane-solitaire-{{ sec_id }} .cl-4cs-matrix { grid-template-columns: repeat(2, 1fr); }
  }
</style>

{% schema %}
{
  "name": "CaratLane Featured Solitaire",
  "tag": "section",
  "class": "caratlane-solitaire-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#0f172a" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane Featured Solitaire" }
  ]
}
{% endschema %}
