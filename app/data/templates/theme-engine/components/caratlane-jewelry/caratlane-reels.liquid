{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - Shoppable Video Reels
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-reels'
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#0f172a'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
  assign title = section.settings.title | default: 'SHOP THE REELS & LOOKBOOK'
  assign subtitle = section.settings.subtitle | default: 'SEE OUR DIAMONDS IN REAL LIGHT'
-%}

<section id="caratlane-reels-{{ sec_id }}" class="cl-reels-wrap">
  <div class="cl-reels-container">
    <div class="cl-section-header">
      <span class="cl-sub-tag">{{ subtitle }}</span>
      <h2 class="cl-section-title">{{ title }}</h2>
    </div>

    <div class="cl-reels-grid">
      
      <!-- Reel 1 -->
      <div class="cl-reel-card">
        <div class="cl-reel-media">
          <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=600&q=80" alt="Bridal Solitaire Stack" class="cl-reel-img" loading="lazy" />
          <div class="cl-play-badge">▶</div>
          <div class="cl-reel-overlay"></div>
        </div>
        <div class="cl-reel-meta">
          <span class="cl-reel-tag">BRIDAL SPECIAL</span>
          <h3 class="cl-reel-title">Bridal Solitaire Stack</h3>
          <span class="cl-reel-price">₹48,999</span>
          <button type="button" class="cl-btn-reel-shop" onclick="alert('🛍️ Opening Shoppable Reel Video & Product Details...')">
            SHOP THIS LOOK &rarr;
          </button>
        </div>
      </div>

      <!-- Reel 2 -->
      <div class="cl-reel-card">
        <div class="cl-reel-media">
          <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=600&q=80" alt="Daily Wear Diamond Studs" class="cl-reel-img" loading="lazy" />
          <div class="cl-play-badge">▶</div>
          <div class="cl-reel-overlay"></div>
        </div>
        <div class="cl-reel-meta">
          <span class="cl-reel-tag">EVERYDAY LUXURY</span>
          <h3 class="cl-reel-title">Bloom Solitaire Studs</h3>
          <span class="cl-reel-price">₹29,499</span>
          <button type="button" class="cl-btn-reel-shop" onclick="alert('🛍️ Opening Shoppable Reel Video & Product Details...')">
            SHOP THIS LOOK &rarr;
          </button>
        </div>
      </div>

      <!-- Reel 3 -->
      <div class="cl-reel-card">
        <div class="cl-reel-media">
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Eternal Infinity Pendant" class="cl-reel-img" loading="lazy" />
          <div class="cl-play-badge">▶</div>
          <div class="cl-reel-overlay"></div>
        </div>
        <div class="cl-reel-meta">
          <span class="cl-reel-tag">GIFT FAVORITE</span>
          <h3 class="cl-reel-title">Eternal Infinity Pendant</h3>
          <span class="cl-reel-price">₹18,999</span>
          <button type="button" class="cl-btn-reel-shop" onclick="alert('🛍️ Opening Shoppable Reel Video & Product Details...')">
            SHOP THIS LOOK &rarr;
          </button>
        </div>
      </div>

      <!-- Reel 4 -->
      <div class="cl-reel-card">
        <div class="cl-reel-media">
          <img src="https://images.unsplash.com/photo-1611591475141-89d554a93cf4?w=600&q=80" alt="Aura Modern Mangalsutra" class="cl-reel-img" loading="lazy" />
          <div class="cl-play-badge">▶</div>
          <div class="cl-reel-overlay"></div>
        </div>
        <div class="cl-reel-meta">
          <span class="cl-reel-tag">MODERN HERITAGE</span>
          <h3 class="cl-reel-title">Aura Solitaire Mangalsutra</h3>
          <span class="cl-reel-price">₹38,499</span>
          <button type="button" class="cl-btn-reel-shop" onclick="alert('🛍️ Opening Shoppable Reel Video & Product Details...')">
            SHOP THIS LOOK &rarr;
          </button>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #caratlane-reels-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
  }
  #caratlane-reels-{{ sec_id }} .cl-reels-container { max-width: 1320px; margin: 0 auto; }
  #caratlane-reels-{{ sec_id }} .cl-section-header { text-align: center; margin-bottom: 40px; }
  #caratlane-reels-{{ sec_id }} .cl-sub-tag { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #caratlane-reels-{{ sec_id }} .cl-section-title { font-family: 'Cinzel', serif; font-size: clamp(26px, 3.5vw, 38px); font-weight: 800; color: #0f172a; margin: 6px 0 0 0; }

  #caratlane-reels-{{ sec_id }} .cl-reels-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  #caratlane-reels-{{ sec_id }} .cl-reel-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: #0f172a;
    border: 1px solid rgba(212, 175, 55, 0.25);
    aspect-ratio: 9 / 16;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    transition: transform 0.3s ease;
  }
  #caratlane-reels-{{ sec_id }} .cl-reel-card:hover { transform: translateY(-4px); }
  #caratlane-reels-{{ sec_id }} .cl-reel-media { width: 100%; height: 100%; position: absolute; inset: 0; }
  #caratlane-reels-{{ sec_id }} .cl-reel-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  #caratlane-reels-{{ sec_id }} .cl-reel-card:hover .cl-reel-img { transform: scale(1.05); }
  
  #caratlane-reels-{{ sec_id }} .cl-play-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(15,23,42,0.8);
    backdrop-filter: blur(4px);
    color: {{ accent_color }};
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    z-index: 3;
    border: 1px solid {{ accent_color }};
  }
  #caratlane-reels-{{ sec_id }} .cl-reel-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.1) 40%, rgba(15,23,42,0.92) 100%); }

  #caratlane-reels-{{ sec_id }} .cl-reel-meta {
    position: absolute;
    bottom: 18px;
    left: 18px;
    right: 18px;
    display: flex;
    flex-direction: column;
    z-index: 2;
  }
  #caratlane-reels-{{ sec_id }} .cl-reel-tag { font-size: 9px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 0.5px; }
  #caratlane-reels-{{ sec_id }} .cl-reel-title { font-family: 'Cinzel', serif; font-size: 15px; font-weight: 700; color: #ffffff; margin: 2px 0 4px 0; }
  #caratlane-reels-{{ sec_id }} .cl-reel-price { font-size: 14px; font-weight: 900; color: {{ accent_color }}; margin-bottom: 10px; }
  
  #caratlane-reels-{{ sec_id }} .cl-btn-reel-shop {
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(8px);
    color: #ffffff;
    border: 1px solid rgba(255,255,255,0.3);
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 10px;
    font-weight: 800;
    cursor: pointer;
    letter-spacing: 0.5px;
  }

  @media (max-width: 990px) {
    #caratlane-reels-{{ sec_id }} .cl-reels-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

{% schema %}
{
  "name": "CaratLane Shoppable Reels",
  "tag": "section",
  "class": "caratlane-reels-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Title", "default": "SHOP THE REELS & LOOKBOOK" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "SEE OUR DIAMONDS IN REAL LIGHT" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#0f172a" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane Shoppable Reels" }
  ]
}
{% endschema %}
