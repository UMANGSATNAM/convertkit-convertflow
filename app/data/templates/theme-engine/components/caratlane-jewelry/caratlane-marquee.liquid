{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - Marquee Ticker
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-marquee'
  assign bg_color = section.settings.bg_color | default: '#090d16'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
  assign ticker_text = section.settings.text | default: '✦ 100% BIS HALLMARKED SOLID GOLD • IGI & GIA CERTIFIED DIAMONDS ✦ 15-DAY MONEY BACK EXCHANGE ✦ LIFETIME BUYBACK GUARANTEE ✦ FREE INSURED DOORSTEP DELIVERY ✦'
-%}

<div id="caratlane-marquee-{{ sec_id }}" class="cl-marquee-wrap">
  <div class="cl-marquee-track">
    <div class="cl-marquee-content">
      <span>{{ ticker_text }}</span>
      <span>{{ ticker_text }}</span>
      <span>{{ ticker_text }}</span>
    </div>
  </div>
</div>

<style>
  #caratlane-marquee-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: 14px 0;
    overflow: hidden;
    border-top: 1px solid rgba(212, 175, 55, 0.25);
    border-bottom: 1px solid rgba(212, 175, 55, 0.25);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  #caratlane-marquee-{{ sec_id }} .cl-marquee-track { display: flex; width: 100%; overflow: hidden; white-space: nowrap; }
  #caratlane-marquee-{{ sec_id }} .cl-marquee-content { display: inline-flex; gap: 40px; animation: cl-marquee-scroll 25s linear infinite; }
  #caratlane-marquee-{{ sec_id }} .cl-marquee-content span { color: {{ accent_color }}; }
  @keyframes cl-marquee-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
</style>

{% schema %}
{
  "name": "CaratLane Marquee Ticker",
  "tag": "section",
  "class": "caratlane-marquee-section",
  "settings": [
    { "type": "text", "id": "text", "label": "Ticker Text", "default": "✦ 100% BIS HALLMARKED SOLID GOLD • IGI & GIA CERTIFIED DIAMONDS ✦ 15-DAY MONEY BACK EXCHANGE ✦ LIFETIME BUYBACK GUARANTEE ✦" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#090d16" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane Marquee Ticker" }
  ]
}
{% endschema %}
