{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - Trust & Hallmarking Pillars
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-trust-badges'
  assign bg_color = section.settings.bg_color | default: '#0f172a'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
-%}

<section id="caratlane-trust-{{ sec_id }}" class="cl-trust-wrap">
  <div class="cl-trust-container">
    <div class="cl-trust-grid">
      
      <!-- Pillar 1 -->
      <div class="cl-trust-box">
        <div class="cl-trust-icon">🏛️</div>
        <h3 class="cl-trust-title">100% BIS HALLMARKED GOLD</h3>
        <p class="cl-trust-desc">Every piece of gold jewelry carries the official Govt. of India BIS Hallmark stamp & purity certificate.</p>
      </div>

      <!-- Pillar 2 -->
      <div class="cl-trust-box">
        <div class="cl-trust-icon">💎</div>
        <h3 class="cl-trust-title">IGI & GIA CERTIFIED DIAMONDS</h3>
        <p class="cl-trust-desc">100% natural, ethically sourced VVS-EF grade diamonds independently verified by world authorities.</p>
      </div>

      <!-- Pillar 3 -->
      <div class="cl-trust-box">
        <div class="cl-trust-icon">🔄</div>
        <h3 class="cl-trust-title">15-DAY MONEY BACK EXCHANGE</h3>
        <p class="cl-trust-desc">No questions asked 15-day return policy with 100% refund guarantee on fine jewelry purchases.</p>
      </div>

      <!-- Pillar 4 -->
      <div class="cl-trust-box">
        <div class="cl-trust-icon">⚖️</div>
        <h3 class="cl-trust-title">LIFETIME BUYBACK GUARANTEE</h3>
        <p class="cl-trust-desc">Exchange or upgrade your jewelry anytime with guaranteed market gold & diamond buyback value.</p>
      </div>

    </div>
  </div>
</section>

<style>
  #caratlane-trust-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(40px, 5vw, 64px) 24px;
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    border-top: 1px solid rgba(212, 175, 55, 0.25);
    border-bottom: 1px solid rgba(212, 175, 55, 0.25);
  }
  #caratlane-trust-{{ sec_id }} .cl-trust-container { max-width: 1320px; margin: 0 auto; }
  #caratlane-trust-{{ sec_id }} .cl-trust-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  
  #caratlane-trust-{{ sec_id }} .cl-trust-box {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 16px;
    padding: 24px 20px;
    text-align: center;
  }
  #caratlane-trust-{{ sec_id }} .cl-trust-icon { font-size: 32px; margin-bottom: 12px; }
  #caratlane-trust-{{ sec_id }} .cl-trust-title { font-family: 'Cinzel', serif; font-size: 13px; font-weight: 800; color: {{ accent_color }}; margin: 0 0 8px 0; letter-spacing: 0.5px; }
  #caratlane-trust-{{ sec_id }} .cl-trust-desc { font-size: 12px; line-height: 1.5; color: #cbd5e1; margin: 0; }

  @media (max-width: 990px) {
    #caratlane-trust-{{ sec_id }} .cl-trust-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    #caratlane-trust-{{ sec_id }} .cl-trust-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "CaratLane Trust Badges",
  "tag": "section",
  "class": "caratlane-trust-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0f172a" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane Trust Badges" }
  ]
}
{% endschema %}
