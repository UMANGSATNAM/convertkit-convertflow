{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - Bestsellers Multi-Tab Grid
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-bestsellers-tabs'
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#0f172a'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
  assign title = section.settings.title | default: 'BESTSELLING FINE JEWELRY'
  assign subtitle = section.settings.subtitle | default: 'MOST LOVED BY 2,50,000+ BRIDES & WOMEN'
-%}

<section id="caratlane-bs-{{ sec_id }}" class="cl-bs-wrap">
  <div class="cl-bs-container">
    
    <div class="cl-bs-header">
      <div>
        <span class="cl-bs-sub">{{ subtitle }}</span>
        <h2 class="cl-bs-title">{{ title }}</h2>
      </div>
      <div class="cl-bs-tabs">
        <button class="cl-tab-btn cl-tab-active" onclick="switchClTab(this, 'all')">EVERYDAY FINE</button>
        <button class="cl-tab-btn" onclick="switchClTab(this, 'solitaire')">SOLITAIRE SPECIALS</button>
        <button class="cl-tab-btn" onclick="switchClTab(this, 'gift')">GIFTS UNDER ₹20K</button>
      </div>
    </div>

    <div class="cl-bs-grid">
      
      <!-- Product 1 -->
      <div class="cl-product-card">
        <div class="cl-card-media">
          <span class="cl-card-tag">BESTSELLER</span>
          <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=600&q=80" alt="Royal Crown Diamond Ring" class="cl-card-img" loading="lazy" />
          <button type="button" class="cl-quick-add-btn" onclick="this.textContent = 'ADDED TO BAG! ✓'; setTimeout(() => this.textContent = '+ QUICK ADD', 2000)">
            + QUICK ADD
          </button>
        </div>
        <div class="cl-card-info">
          <div class="cl-card-stars">★★★★★ <span class="cl-card-reviews">(1,420)</span></div>
          <h3 class="cl-card-title">The Royal Crown Solitaire Ring</h3>
          <div class="cl-card-price">
            <span class="cl-price-current">₹48,999</span>
            <span class="cl-price-original">₹62,000</span>
            <span class="cl-discount-tag">SAVE 21%</span>
          </div>
          <!-- Metal Tone Pills -->
          <div class="cl-metal-tones">
            <span class="cl-tone-pill cl-tone-yellow cl-tone-active" title="18K Yellow Gold"></span>
            <span class="cl-tone-pill cl-tone-rose" title="18K Rose Gold"></span>
            <span class="cl-tone-pill cl-tone-white" title="18K White Gold"></span>
            <span class="cl-tone-label">18K Solid Gold</span>
          </div>
        </div>
      </div>

      <!-- Product 2 -->
      <div class="cl-product-card">
        <div class="cl-card-media">
          <span class="cl-card-tag">TRY AT HOME</span>
          <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=600&q=80" alt="Bloom Diamond Stud Earrings" class="cl-card-img" loading="lazy" />
          <button type="button" class="cl-quick-add-btn" onclick="this.textContent = 'ADDED TO BAG! ✓'; setTimeout(() => this.textContent = '+ QUICK ADD', 2000)">
            + QUICK ADD
          </button>
        </div>
        <div class="cl-card-info">
          <div class="cl-card-stars">★★★★★ <span class="cl-card-reviews">(980)</span></div>
          <h3 class="cl-card-title">Bloom Solitaire Diamond Stud Earrings</h3>
          <div class="cl-card-price">
            <span class="cl-price-current">₹29,499</span>
            <span class="cl-price-original">₹36,000</span>
            <span class="cl-discount-tag">SAVE 18%</span>
          </div>
          <!-- Metal Tone Pills -->
          <div class="cl-metal-tones">
            <span class="cl-tone-pill cl-tone-yellow cl-tone-active" title="14K Yellow Gold"></span>
            <span class="cl-tone-pill cl-tone-rose" title="14K Rose Gold"></span>
            <span class="cl-tone-pill cl-tone-white" title="14K White Gold"></span>
            <span class="cl-tone-label">14K Solid Gold</span>
          </div>
        </div>
      </div>

      <!-- Product 3 -->
      <div class="cl-product-card">
        <div class="cl-card-media">
          <span class="cl-card-tag">TRENDING</span>
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Infinity Diamond Pendant" class="cl-card-img" loading="lazy" />
          <button type="button" class="cl-quick-add-btn" onclick="this.textContent = 'ADDED TO BAG! ✓'; setTimeout(() => this.textContent = '+ QUICK ADD', 2000)">
            + QUICK ADD
          </button>
        </div>
        <div class="cl-card-info">
          <div class="cl-card-stars">★★★★★ <span class="cl-card-reviews">(2,150)</span></div>
          <h3 class="cl-card-title">Eternal Infinity Diamond Pendant</h3>
          <div class="cl-card-price">
            <span class="cl-price-current">₹18,999</span>
            <span class="cl-price-original">₹24,000</span>
            <span class="cl-discount-tag">SAVE 20%</span>
          </div>
          <!-- Metal Tone Pills -->
          <div class="cl-metal-tones">
            <span class="cl-tone-pill cl-tone-yellow cl-tone-active" title="18K Yellow Gold"></span>
            <span class="cl-tone-pill cl-tone-rose" title="18K Rose Gold"></span>
            <span class="cl-tone-pill cl-tone-white" title="18K White Gold"></span>
            <span class="cl-tone-label">18K Solid Gold</span>
          </div>
        </div>
      </div>

      <!-- Product 4 -->
      <div class="cl-product-card">
        <div class="cl-card-media">
          <span class="cl-card-tag">NEW LAUNCH</span>
          <img src="https://images.unsplash.com/photo-1611591475141-89d554a93cf4?w=600&q=80" alt="Aura Solitaire Mangalsutra" class="cl-card-img" loading="lazy" />
          <button type="button" class="cl-quick-add-btn" onclick="this.textContent = 'ADDED TO BAG! ✓'; setTimeout(() => this.textContent = '+ QUICK ADD', 2000)">
            + QUICK ADD
          </button>
        </div>
        <div class="cl-card-info">
          <div class="cl-card-stars">★★★★★ <span class="cl-card-reviews">(640)</span></div>
          <h3 class="cl-card-title">Aura Modern Solitaire Mangalsutra</h3>
          <div class="cl-card-price">
            <span class="cl-price-current">₹38,499</span>
            <span class="cl-price-original">₹49,000</span>
            <span class="cl-discount-tag">SAVE 21%</span>
          </div>
          <!-- Metal Tone Pills -->
          <div class="cl-metal-tones">
            <span class="cl-tone-pill cl-tone-yellow cl-tone-active" title="18K Yellow Gold"></span>
            <span class="cl-tone-pill cl-tone-rose" title="18K Rose Gold"></span>
            <span class="cl-tone-pill cl-tone-white" title="18K White Gold"></span>
            <span class="cl-tone-label">18K Solid Gold</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #caratlane-bs-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
  }
  #caratlane-bs-{{ sec_id }} .cl-bs-container { max-width: 1320px; margin: 0 auto; }
  #caratlane-bs-{{ sec_id }} .cl-bs-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 36px; gap: 20px; flex-wrap: wrap; }
  #caratlane-bs-{{ sec_id }} .cl-bs-sub { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #caratlane-bs-{{ sec_id }} .cl-bs-title { font-family: 'Cinzel', serif; font-size: clamp(26px, 3.5vw, 38px); font-weight: 800; color: #0f172a; margin: 6px 0 0 0; }
  
  #caratlane-bs-{{ sec_id }} .cl-bs-tabs { display: flex; gap: 10px; flex-wrap: wrap; }
  #caratlane-bs-{{ sec_id }} .cl-tab-btn {
    background: #f8fafc;
    color: #334155;
    border: 1px solid #cbd5e1;
    padding: 8px 18px;
    border-radius: 99px;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
    letter-spacing: 0.5px;
    transition: all 0.2s ease;
  }
  #caratlane-bs-{{ sec_id }} .cl-tab-btn.cl-tab-active,
  #caratlane-bs-{{ sec_id }} .cl-tab-btn:hover {
    background: #0f172a;
    color: {{ accent_color }};
    border-color: #0f172a;
  }

  #caratlane-bs-{{ sec_id }} .cl-bs-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  #caratlane-bs-{{ sec_id }} .cl-product-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  #caratlane-bs-{{ sec_id }} .cl-product-card:hover {
    transform: translateY(-4px);
    border-color: {{ accent_color }};
    box-shadow: 0 12px 30px rgba(212, 175, 55, 0.15);
  }

  #caratlane-bs-{{ sec_id }} .cl-card-media { position: relative; aspect-ratio: 1; overflow: hidden; background: #f8fafc; }
  #caratlane-bs-{{ sec_id }} .cl-card-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  #caratlane-bs-{{ sec_id }} .cl-product-card:hover .cl-card-img { transform: scale(1.06); }
  
  #caratlane-bs-{{ sec_id }} .cl-card-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #0f172a;
    color: {{ accent_color }};
    font-size: 9px;
    font-weight: 900;
    padding: 4px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    z-index: 2;
  }
  #caratlane-bs-{{ sec_id }} .cl-quick-add-btn {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(8px);
    color: #ffffff;
    border: 1px solid {{ accent_color }};
    border-radius: 8px;
    padding: 10px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
    cursor: pointer;
    transform: translateY(120%);
    transition: transform 0.25s ease;
  }
  #caratlane-bs-{{ sec_id }} .cl-product-card:hover .cl-quick-add-btn { transform: translateY(0); }

  #caratlane-bs-{{ sec_id }} .cl-card-info { padding: 18px; display: flex; flex-direction: column; flex-grow: 1; }
  #caratlane-bs-{{ sec_id }} .cl-card-stars { color: #f59e0b; font-size: 11px; margin-bottom: 6px; }
  #caratlane-bs-{{ sec_id }} .cl-card-reviews { color: #64748b; font-size: 11px; }
  #caratlane-bs-{{ sec_id }} .cl-card-title { font-family: 'Cinzel', serif; font-size: 14px; font-weight: 700; line-height: 1.4; margin: 0 0 10px 0; color: #0f172a; }

  #caratlane-bs-{{ sec_id }} .cl-card-price { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
  #caratlane-bs-{{ sec_id }} .cl-price-current { font-size: 16px; font-weight: 900; color: #0f172a; }
  #caratlane-bs-{{ sec_id }} .cl-price-original { font-size: 13px; text-decoration: line-through; color: #94a3b8; }
  #caratlane-bs-{{ sec_id }} .cl-discount-tag { font-size: 10px; font-weight: 800; color: #059669; background: #ecfdf5; padding: 2px 6px; border-radius: 4px; }

  #caratlane-bs-{{ sec_id }} .cl-metal-tones { display: flex; align-items: center; gap: 6px; margin-top: auto; }
  #caratlane-bs-{{ sec_id }} .cl-tone-pill { width: 14px; height: 14px; border-radius: 50%; cursor: pointer; border: 1px solid rgba(0,0,0,0.1); }
  #caratlane-bs-{{ sec_id }} .cl-tone-yellow { background: #d4af37; }
  #caratlane-bs-{{ sec_id }} .cl-tone-rose { background: #e0a996; }
  #caratlane-bs-{{ sec_id }} .cl-tone-white { background: #e2e8f0; }
  #caratlane-bs-{{ sec_id }} .cl-tone-active { box-shadow: 0 0 0 2px #0f172a; }
  #caratlane-bs-{{ sec_id }} .cl-tone-label { font-size: 10px; color: #64748b; margin-left: 4px; font-weight: 600; }

  @media (max-width: 990px) {
    #caratlane-bs-{{ sec_id }} .cl-bs-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    #caratlane-bs-{{ sec_id }} .cl-bs-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  function switchClTab(btn, cat) {
    var parent = btn.closest('.cl-bs-wrap');
    if (!parent) return;
    parent.querySelectorAll('.cl-tab-btn').forEach(function(b) { b.classList.remove('cl-tab-active'); });
    btn.classList.add('cl-tab-active');
  }
</script>

{% schema %}
{
  "name": "CaratLane Bestsellers",
  "tag": "section",
  "class": "caratlane-bestsellers-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Title", "default": "BESTSELLING FINE JEWELRY" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "MOST LOVED BY 2,50,000+ BRIDES & WOMEN" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#0f172a" },
    { "type": "color", "id": "accent_color", "label": "Accent Gold", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane Bestsellers" }
  ]
}
{% endschema %}
