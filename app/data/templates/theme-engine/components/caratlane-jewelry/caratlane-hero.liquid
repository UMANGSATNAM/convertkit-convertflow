{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - Luxury Solitaire Hero
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-hero'
  assign bg_color = section.settings.bg_color | default: '#0f172a'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
  assign title = section.settings.heading | default: 'EVERYDAY FINE JEWELRY & CERTIFIED SOLITAIRES'
  assign subtitle = section.settings.badge | default: '✨ 100% BIS HALLMARKED • IGI CERTIFIED NATURAL DIAMONDS'
  assign desc = section.settings.desc | default: 'Handcrafted in 14k & 18k solid gold with VVS-EF natural diamonds. Designed for effortless elegance from everyday wear to bridal grandeur.'
  assign btn_1_text = section.settings.btn_1_text | default: 'EXPLORE SOLITAIRES'
  assign btn_1_link = section.settings.btn_1_link | default: '/collections/all'
  assign btn_2_text = section.settings.btn_2_text | default: '🏠 BOOK FREE HOME TRIAL'
-%}

<section id="caratlane-hero-{{ sec_id }}" class="cl-hero-wrap">
  <div class="cl-hero-bg-overlay"></div>
  <div class="cl-hero-container">
    <div class="cl-hero-grid">
      
      <!-- Content Left -->
      <div class="cl-hero-content">
        <div class="cl-hero-badge">
          <span class="cl-badge-sparkle">✦</span>
          <span>{{ subtitle }}</span>
        </div>

        <h1 class="cl-hero-title">{{ title }}</h1>
        <p class="cl-hero-desc">{{ desc }}</p>

        <!-- Live Price & Offer Pill -->
        <div class="cl-hero-offer-card">
          <div class="cl-offer-item">
            <span class="cl-offer-icon">💎</span>
            <div>
              <div class="cl-offer-heading">FLAT 25% OFF ON DIAMOND VALUE</div>
              <div class="cl-offer-sub">Valid on Solitaire Rings, Pendants & Earrings</div>
            </div>
          </div>
          <div class="cl-cert-seal">
            <span>IGI</span> CERTIFIED
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="cl-hero-actions">
          <a href="{{ btn_1_link }}" class="cl-btn-primary">
            {{ btn_1_text }} &rarr;
          </a>
          <button type="button" class="cl-btn-secondary" onclick="alert('✨ Free Home Trial Booked! Our Jewellery Expert will bring 500+ Top Designs to your doorstep.')">
            {{ btn_2_text }}
          </button>
        </div>

        <!-- Trust & Social Proof -->
        <div class="cl-hero-proof">
          <div class="cl-avatar-stack">
            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&q=80" alt="Client" />
            <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=100&q=80" alt="Client" />
            <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&q=80" alt="Client" />
          </div>
          <div class="cl-proof-info">
            <div class="cl-proof-stars">★★★★★ <span class="cl-score">4.95/5</span></div>
            <span><strong>2,50,000+ Happy Clients</strong> • 15-Day Exchange • Lifetime Buyback</span>
          </div>
        </div>
      </div>

      <!-- Media Right -->
      <div class="cl-hero-media">
        <div class="cl-media-frame">
          <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=900&q=85" alt="Fine Jewelry Ring" class="cl-hero-img" loading="eager" />
          
          <!-- Floating Benchmark Card -->
          <div class="cl-float-card">
            <span class="cl-float-badge">SOLITAIRE BENCHMARK</span>
            <div class="cl-float-title">The Royal Crown Solitaire Ring</div>
            <div class="cl-float-meta">
              <span class="cl-float-price">₹48,999</span>
              <span class="cl-float-orig">₹62,000</span>
              <span class="cl-float-save">SAVE ₹13,001</span>
            </div>
            <div class="cl-float-specs">18K Solid Rose Gold • VVS1 Clarity • Ideal Cut</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #caratlane-hero-{{ sec_id }} {
    position: relative;
    background: radial-gradient(circle at 10% 20%, #1e293b 0%, #0f172a 100%);
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    overflow: hidden;
  }
  #caratlane-hero-{{ sec_id }} .cl-hero-bg-overlay {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.15) 0%, rgba(0,0,0,0) 70%);
    pointer-events: none;
  }
  #caratlane-hero-{{ sec_id }} .cl-hero-container { max-width: 1320px; margin: 0 auto; position: relative; z-index: 2; }
  #caratlane-hero-{{ sec_id }} .cl-hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  
  #caratlane-hero-{{ sec_id }} .cl-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid rgba(212, 175, 55, 0.3);
    color: {{ accent_color }};
    font-size: 11px;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: 99px;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  #caratlane-hero-{{ sec_id }} .cl-badge-sparkle { font-size: 12px; }
  #caratlane-hero-{{ sec_id }} .cl-hero-title {
    font-family: 'Cinzel', 'Playfair Display', serif;
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.5px;
    margin: 0 0 16px 0;
    background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  #caratlane-hero-{{ sec_id }} .cl-hero-desc {
    font-size: 15px;
    line-height: 1.6;
    color: #94a3b8;
    margin-bottom: 24px;
    max-width: 540px;
  }

  #caratlane-hero-{{ sec_id }} .cl-hero-offer-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 12px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
  }
  #caratlane-hero-{{ sec_id }} .cl-offer-item { display: flex; align-items: center; gap: 12px; }
  #caratlane-hero-{{ sec_id }} .cl-offer-icon { font-size: 24px; }
  #caratlane-hero-{{ sec_id }} .cl-offer-heading { font-size: 13px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 0.5px; }
  #caratlane-hero-{{ sec_id }} .cl-offer-sub { font-size: 11px; color: #cbd5e1; margin-top: 2px; }
  #caratlane-hero-{{ sec_id }} .cl-cert-seal {
    background: {{ accent_color }};
    color: #0f172a;
    font-size: 10px;
    font-weight: 900;
    padding: 6px 10px;
    border-radius: 6px;
    text-align: center;
    line-height: 1.1;
  }

  #caratlane-hero-{{ sec_id }} .cl-hero-actions { display: flex; gap: 14px; margin-bottom: 32px; flex-wrap: wrap; }
  #caratlane-hero-{{ sec_id }} .cl-btn-primary {
    background: linear-gradient(135deg, {{ accent_color }} 0%, #b89628 100%);
    color: #0f172a;
    font-weight: 900;
    font-size: 13px;
    letter-spacing: 0.8px;
    padding: 14px 28px;
    border-radius: 99px;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(212, 175, 55, 0.3);
    transition: transform 0.2s ease;
  }
  #caratlane-hero-{{ sec_id }} .cl-btn-primary:hover { transform: translateY(-2px); }
  #caratlane-hero-{{ sec_id }} .cl-btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-weight: 800;
    font-size: 13px;
    padding: 14px 24px;
    border-radius: 99px;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  #caratlane-hero-{{ sec_id }} .cl-btn-secondary:hover { background: rgba(255, 255, 255, 0.15); }

  #caratlane-hero-{{ sec_id }} .cl-hero-proof { display: flex; align-items: center; gap: 14px; }
  #caratlane-hero-{{ sec_id }} .cl-avatar-stack { display: flex; }
  #caratlane-hero-{{ sec_id }} .cl-avatar-stack img { width: 34px; height: 34px; border-radius: 50%; border: 2px solid #0f172a; margin-left: -10px; object-fit: cover; }
  #caratlane-hero-{{ sec_id }} .cl-avatar-stack img:first-child { margin-left: 0; }
  #caratlane-hero-{{ sec_id }} .cl-proof-info { font-size: 12px; color: #94a3b8; }
  #caratlane-hero-{{ sec_id }} .cl-proof-stars { color: #f59e0b; font-size: 11px; margin-bottom: 2px; }
  #caratlane-hero-{{ sec_id }} .cl-proof-info strong { color: #ffffff; }

  /* Media Frame */
  #caratlane-hero-{{ sec_id }} .cl-media-frame {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.3);
    aspect-ratio: 4 / 5;
    box-shadow: 0 25px 60px rgba(0,0,0,0.5);
    background: #0f172a;
  }
  #caratlane-hero-{{ sec_id }} .cl-hero-img { width: 100%; height: 100%; object-fit: cover; }
  
  #caratlane-hero-{{ sec_id }} .cl-float-card {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 14px;
    padding: 14px 18px;
  }
  #caratlane-hero-{{ sec_id }} .cl-float-badge { font-size: 9px; font-weight: 900; color: {{ accent_color }}; letter-spacing: 1px; }
  #caratlane-hero-{{ sec_id }} .cl-float-title { font-family: 'Cinzel', serif; font-size: 15px; font-weight: 700; color: #ffffff; margin: 2px 0 4px 0; }
  #caratlane-hero-{{ sec_id }} .cl-float-price { font-size: 16px; font-weight: 900; color: {{ accent_color }}; }
  #caratlane-hero-{{ sec_id }} .cl-float-orig { font-size: 12px; text-decoration: line-through; color: #94a3b8; margin-left: 6px; }
  #caratlane-hero-{{ sec_id }} .cl-float-save { font-size: 10px; font-weight: 800; color: #22c55e; background: rgba(34, 197, 94, 0.15); padding: 2px 6px; border-radius: 4px; margin-left: 6px; }
  #caratlane-hero-{{ sec_id }} .cl-float-specs { font-size: 10px; color: #cbd5e1; margin-top: 4px; }

  @media (max-width: 990px) {
    #caratlane-hero-{{ sec_id }} .cl-hero-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "CaratLane Luxury Hero",
  "tag": "section",
  "class": "caratlane-hero-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Main Headline", "default": "EVERYDAY FINE JEWELRY & CERTIFIED SOLITAIRES" },
    { "type": "text", "id": "badge", "label": "Badge Text", "default": "✨ 100% BIS HALLMARKED • IGI CERTIFIED NATURAL DIAMONDS" },
    { "type": "textarea", "id": "desc", "label": "Subheading", "default": "Handcrafted in 14k & 18k solid gold with VVS-EF natural diamonds. Designed for effortless elegance from everyday wear to bridal grandeur." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0f172a" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" },
    { "type": "text", "id": "btn_1_text", "label": "CTA 1 Text", "default": "EXPLORE SOLITAIRES" },
    { "type": "url", "id": "btn_1_link", "label": "CTA 1 Link" }
  ],
  "presets": [
    { "name": "CaratLane Luxury Hero" }
  ]
}
{% endschema %}
