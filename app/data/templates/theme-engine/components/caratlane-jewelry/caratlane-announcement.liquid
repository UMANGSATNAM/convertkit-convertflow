{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - Luxury Announcement Bar
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-announcement'
  assign bg_color = section.settings.bg_color | default: '#0f172a'
  assign text_color = section.settings.text_color | default: '#f8fafc'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
  assign gold_rate = section.settings.gold_rate | default: '₹6,840/g (22K)'
  assign announcement_text = section.settings.text | default: '✨ FESTIVE DIAMOND FESTIVAL: GET UP TO 25% OFF ON DIAMOND VALUE • USE CODE: CARAT25'
-%}

<div id="caratlane-announcement-{{ sec_id }}" class="cl-announcement-wrap">
  <div class="cl-ann-container">
    <!-- Left: Gold Rate Indicator -->
    <div class="cl-gold-ticker">
      <span class="cl-gold-dot"></span>
      <span>TODAY'S GOLD RATE: <strong>{{ gold_rate }}</strong></span>
    </div>

    <!-- Center: Main Promo Ticker -->
    <div class="cl-ann-text">
      <span>{{ announcement_text }}</span>
      <a href="/collections/all" class="cl-ann-link">CLAIM OFFER &rarr;</a>
    </div>

    <!-- Right: Perks Badges -->
    <div class="cl-ann-perks">
      <span>💎 100% Certified Diamonds</span>
      <span class="cl-perk-sep">•</span>
      <span>🚚 Free Insured Shipping</span>
    </div>
  </div>
</div>

<style>
  #caratlane-announcement-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: 9px 20px;
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 600;
    border-bottom: 1px solid rgba(212, 175, 55, 0.25);
  }
  #caratlane-announcement-{{ sec_id }} .cl-ann-container {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  #caratlane-announcement-{{ sec_id }} .cl-gold-ticker {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: #94a3b8;
    white-space: nowrap;
  }
  #caratlane-announcement-{{ sec_id }} .cl-gold-dot {
    width: 7px;
    height: 7px;
    background: {{ accent_color }};
    border-radius: 50%;
    box-shadow: 0 0 8px {{ accent_color }};
    animation: cl-gold-pulse 2s infinite;
  }
  @keyframes cl-gold-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }
  #caratlane-announcement-{{ sec_id }} .cl-gold-ticker strong {
    color: {{ accent_color }};
  }
  #caratlane-announcement-{{ sec_id }} .cl-ann-text {
    display: flex;
    align-items: center;
    gap: 10px;
    letter-spacing: 0.3px;
    text-align: center;
  }
  #caratlane-announcement-{{ sec_id }} .cl-ann-link {
    color: {{ accent_color }};
    font-weight: 800;
    text-decoration: none;
    letter-spacing: 0.5px;
    transition: opacity 0.2s ease;
  }
  #caratlane-announcement-{{ sec_id }} .cl-ann-link:hover {
    opacity: 0.8;
  }
  #caratlane-announcement-{{ sec_id }} .cl-ann-perks {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: #cbd5e1;
    white-space: nowrap;
  }
  #caratlane-announcement-{{ sec_id }} .cl-perk-sep {
    color: {{ accent_color }};
  }

  @media (max-width: 990px) {
    #caratlane-announcement-{{ sec_id }} .cl-gold-ticker,
    #caratlane-announcement-{{ sec_id }} .cl-ann-perks { display: none; }
    #caratlane-announcement-{{ sec_id }} .cl-ann-container { justify-content: center; }
  }
</style>

{% schema %}
{
  "name": "CaratLane Announcement",
  "tag": "section",
  "class": "caratlane-announcement-section",
  "settings": [
    { "type": "text", "id": "text", "label": "Announcement Text", "default": "✨ FESTIVE DIAMOND FESTIVAL: GET UP TO 25% OFF ON DIAMOND VALUE • USE CODE: CARAT25" },
    { "type": "text", "id": "gold_rate", "label": "Gold Rate Ticker", "default": "₹6,840/g (22K)" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0f172a" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#f8fafc" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane Announcement" }
  ]
}
{% endschema %}
