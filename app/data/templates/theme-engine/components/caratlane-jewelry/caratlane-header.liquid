{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - Luxury Sticky Header
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-header'
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#0f172a'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
  assign brand_name = section.settings.brand_name | default: 'CARATLANE'
  assign brand_sub = section.settings.brand_sub | default: 'A TATA PRODUCT'
-%}

<header id="caratlane-header-{{ sec_id }}" class="cl-header-wrap">
  <div class="cl-header-inner">
    
    <!-- Mobile Menu Toggle Button -->
    <button type="button" class="cl-mobile-toggle" aria-label="Toggle Navigation" onclick="document.getElementById('cl-nav-drawer-{{ sec_id }}').classList.toggle('cl-drawer-open')">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>

    <!-- Brand Logo -->
    <a href="/" class="cl-brand-logo">
      <div class="cl-logo-mark">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="{{ accent_color }}" stroke-width="2">
          <polygon points="12 2 2 9 12 22 22 9 12 2"/>
          <line x1="2" y1="9" x2="22" y2="9"/>
          <line x1="12" y1="2" x2="12" y2="22"/>
        </svg>
      </div>
      <div class="cl-logo-text">
        <span class="cl-logo-title">{{ brand_name }}</span>
        <span class="cl-logo-sub">{{ brand_sub }}</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="cl-nav-links">
      <a href="/collections/all" class="cl-nav-item cl-nav-active">RINGS <span class="cl-nav-badge">HOT</span></a>
      <a href="/collections/all" class="cl-nav-item">EARRINGS</a>
      <a href="/collections/all" class="cl-nav-item">SOLITAIRES</a>
      <a href="/collections/all" class="cl-nav-item">MANGALSUTRAS <span class="cl-nav-badge cl-badge-gold">22K</span></a>
      <a href="/collections/all" class="cl-nav-item">BRACELETS</a>
      <a href="/collections/all" class="cl-nav-item cl-nav-highlight">GIFTS UNDER ₹20K</a>
    </nav>

    <!-- Search & Conversion CTAs -->
    <div class="cl-header-actions">
      <!-- Search Input -->
      <div class="cl-search-box">
        <svg class="cl-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" placeholder="Search Solitaires, Rings, Gold..." class="cl-search-input" />
      </div>

      <!-- Try At Home CTA -->
      <button type="button" class="cl-btn-tryathome" onclick="alert('✨ Book a Free Try at Home Slot! Our Jewelry Consultant will visit your doorstep with 500+ Designs.')">
        <span class="cl-home-pulse"></span>
        <span>🏠 TRY AT HOME</span>
      </button>

      <!-- Wishlist Icon -->
      <a href="/pages/wishlist" class="cl-icon-btn" title="Wishlist">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span class="cl-badge-count">4</span>
      </a>

      <!-- Cart Icon -->
      <a href="/cart" class="cl-icon-btn cl-cart-btn" title="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="cl-badge-count cl-cart-count">2</span>
      </a>
    </div>

  </div>

  <!-- Mobile Drawer Menu -->
  <div id="cl-nav-drawer-{{ sec_id }}" class="cl-mobile-drawer">
    <div class="cl-drawer-content">
      <div class="cl-drawer-head">
        <span>MENU</span>
        <button type="button" onclick="document.getElementById('cl-nav-drawer-{{ sec_id }}').classList.remove('cl-drawer-open')">&times;</button>
      </div>
      <div class="cl-drawer-links">
        <a href="/collections/all">RINGS (HOT)</a>
        <a href="/collections/all">EARRINGS</a>
        <a href="/collections/all">SOLITAIRES</a>
        <a href="/collections/all">MANGALSUTRAS</a>
        <a href="/collections/all">BRACELETS & BANGLES</a>
        <a href="/collections/all">GIFTS UNDER ₹20K</a>
        <a href="/pages/try-at-home" style="color: {{ accent_color }}; font-weight: 800;">🏠 BOOK FREE HOME TRIAL</a>
      </div>
    </div>
  </div>
</header>

<style>
  #caratlane-header-{{ sec_id }} {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: {{ bg_color }};
    color: {{ text_color }};
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
  }
  #caratlane-header-{{ sec_id }} .cl-header-inner {
    max-width: 1360px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  #caratlane-header-{{ sec_id }} .cl-brand-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: {{ text_color }};
  }
  #caratlane-header-{{ sec_id }} .cl-logo-title {
    font-family: 'Cinzel', 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 2px;
    display: block;
    line-height: 1;
  }
  #caratlane-header-{{ sec_id }} .cl-logo-sub {
    font-size: 8px;
    font-weight: 800;
    color: {{ accent_color }};
    letter-spacing: 1.5px;
    display: block;
    margin-top: 2px;
  }
  #caratlane-header-{{ sec_id }} .cl-nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  #caratlane-header-{{ sec_id }} .cl-nav-item {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.8px;
    color: #334155;
    text-decoration: none;
    position: relative;
    padding: 6px 0;
    transition: color 0.2s ease;
  }
  #caratlane-header-{{ sec_id }} .cl-nav-item:hover,
  #caratlane-header-{{ sec_id }} .cl-nav-active {
    color: {{ accent_color }};
  }
  #caratlane-header-{{ sec_id }} .cl-nav-badge {
    background: #ef4444;
    color: #ffffff;
    font-size: 8px;
    font-weight: 900;
    padding: 2px 5px;
    border-radius: 4px;
    margin-left: 4px;
    vertical-align: top;
  }
  #caratlane-header-{{ sec_id }} .cl-badge-gold {
    background: {{ accent_color }};
    color: #0f172a;
  }
  #caratlane-header-{{ sec_id }} .cl-nav-highlight {
    color: {{ accent_color }};
    font-weight: 800;
  }
  
  #caratlane-header-{{ sec_id }} .cl-header-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  #caratlane-header-{{ sec_id }} .cl-search-box {
    position: relative;
    width: 220px;
  }
  #caratlane-header-{{ sec_id }} .cl-search-input {
    width: 100%;
    padding: 8px 12px 8px 34px;
    border-radius: 99px;
    border: 1px solid #cbd5e1;
    font-size: 11px;
    background: #f8fafc;
    outline: none;
    transition: all 0.2s ease;
  }
  #caratlane-header-{{ sec_id }} .cl-search-input:focus {
    border-color: {{ accent_color }};
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
  }
  #caratlane-header-{{ sec_id }} .cl-search-icon {
    position: absolute;
    left: 11px;
    top: 50%;
    transform: translateY(-50%);
    color: #94a3b8;
  }

  #caratlane-header-{{ sec_id }} .cl-btn-tryathome {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: #f8fafc;
    border: 1px solid {{ accent_color }};
    padding: 8px 14px;
    border-radius: 99px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
    transition: transform 0.2s ease;
  }
  #caratlane-header-{{ sec_id }} .cl-btn-tryathome:hover {
    transform: translateY(-1px);
  }
  #caratlane-header-{{ sec_id }} .cl-home-pulse {
    width: 6px;
    height: 6px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 6px #22c55e;
  }

  #caratlane-header-{{ sec_id }} .cl-icon-btn {
    position: relative;
    color: #334155;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    border-radius: 50%;
    transition: color 0.2s ease;
  }
  #caratlane-header-{{ sec_id }} .cl-icon-btn:hover { color: {{ accent_color }}; }
  #caratlane-header-{{ sec_id }} .cl-badge-count {
    position: absolute;
    top: 0;
    right: 0;
    background: {{ accent_color }};
    color: #0f172a;
    font-size: 9px;
    font-weight: 900;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #caratlane-header-{{ sec_id }} .cl-mobile-toggle {
    display: none;
    background: none;
    border: none;
    color: {{ text_color }};
    cursor: pointer;
  }

  /* Mobile Drawer Styling */
  .cl-mobile-drawer {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 2000;
  }
  .cl-drawer-open { display: block !important; }
  .cl-drawer-content {
    width: 280px;
    height: 100%;
    background: #ffffff;
    padding: 24px;
  }
  .cl-drawer-head { display: flex; justify-content: space-between; font-weight: 900; margin-bottom: 20px; font-size: 16px; }
  .cl-drawer-links a { display: block; padding: 12px 0; border-bottom: 1px solid #f1f5f9; text-decoration: none; color: #0f172a; font-weight: 700; font-size: 13px; }

  @media (max-width: 1100px) {
    #caratlane-header-{{ sec_id }} .cl-nav-links,
    #caratlane-header-{{ sec_id }} .cl-search-box { display: none; }
    #caratlane-header-{{ sec_id }} .cl-mobile-toggle { display: block; }
  }
</style>

{% schema %}
{
  "name": "CaratLane Luxury Header",
  "tag": "section",
  "class": "caratlane-header-section",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand Title", "default": "CARATLANE" },
    { "type": "text", "id": "brand_sub", "label": "Subtitle Badge", "default": "A TATA PRODUCT" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#0f172a" },
    { "type": "color", "id": "accent_color", "label": "Accent Gold Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane Luxury Header" }
  ]
}
{% endschema %}
