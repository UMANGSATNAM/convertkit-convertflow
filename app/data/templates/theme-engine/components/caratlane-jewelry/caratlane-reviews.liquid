{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - Customer Reviews & Ratings
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-reviews'
  assign bg_color = section.settings.bg_color | default: '#fdfbf7'
  assign text_color = section.settings.text_color | default: '#0f172a'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
-%}

<section id="caratlane-reviews-{{ sec_id }}" class="cl-rev-wrap">
  <div class="cl-rev-container">
    <div class="cl-section-header">
      <span class="cl-sub-tag">⭐ VERIFIED CLIENT EXPERIENCES</span>
      <h2 class="cl-section-title">LOVED BY OVER 2,50,000 HAPPY CLIENTS</h2>
    </div>

    <div class="cl-rev-grid">
      
      <!-- Review 1 -->
      <div class="cl-rev-card">
        <div class="cl-rev-head">
          <div class="cl-rev-stars">★★★★★</div>
          <span class="cl-rev-verify">✓ VERIFIED BUYER</span>
        </div>
        <h3 class="cl-rev-title">"The Home Trial Service Changed Everything!"</h3>
        <p class="cl-rev-body">"I was skeptical about ordering a ₹50k solitaire ring online. But CaratLane's Try at Home consultant arrived with 10 beautiful ring options. Selected the Royal Crown ring — the diamond sparkle in real light is unmatched!"</p>
        <div class="cl-rev-author">
          <strong>Priya Sharma</strong> — Mumbai • Purchased Solitaire Ring
        </div>
      </div>

      <!-- Review 2 -->
      <div class="cl-rev-card">
        <div class="cl-rev-head">
          <div class="cl-rev-stars">★★★★★</div>
          <span class="cl-rev-verify">✓ VERIFIED BUYER</span>
        </div>
        <h3 class="cl-rev-title">"100% Authentic IGI Certificate & Purity"</h3>
        <p class="cl-rev-body">"Bought the Bloom Stud Earrings for my anniversary. The packaging, IGI card, and BIS hallmark logo gave us complete confidence. My wife hasn't taken them off since!"</p>
        <div class="cl-rev-author">
          <strong>Ankit Verma</strong> — Bengaluru • Purchased Diamond Studs
        </div>
      </div>

      <!-- Review 3 -->
      <div class="cl-rev-card">
        <div class="cl-rev-head">
          <div class="cl-rev-stars">★★★★★</div>
          <span class="cl-rev-verify">✓ VERIFIED BUYER</span>
        </div>
        <h3 class="cl-rev-title">"Modern Mangalsutra Design is Stunning"</h3>
        <p class="cl-rev-body">"Finding a modern mangalsutra that looks elegant with western office wear was tough until I found the Aura Solitaire Mangalsutra. Lightweight, stylish, and premium 18k rose gold finish."</p>
        <div class="cl-rev-author">
          <strong>Neha Kapoor</strong> — Delhi • Purchased Solitaire Mangalsutra
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #caratlane-reviews-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
  }
  #caratlane-reviews-{{ sec_id }} .cl-rev-container { max-width: 1320px; margin: 0 auto; }
  #caratlane-reviews-{{ sec_id }} .cl-section-header { text-align: center; margin-bottom: 40px; }
  #caratlane-reviews-{{ sec_id }} .cl-sub-tag { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #caratlane-reviews-{{ sec_id }} .cl-section-title { font-family: 'Cinzel', serif; font-size: clamp(24px, 3.5vw, 36px); font-weight: 800; color: #0f172a; margin: 6px 0 0 0; }

  #caratlane-reviews-{{ sec_id }} .cl-rev-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  #caratlane-reviews-{{ sec_id }} .cl-rev-card {
    background: #ffffff;
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    display: flex;
    flex-direction: column;
  }
  #caratlane-reviews-{{ sec_id }} .cl-rev-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  #caratlane-reviews-{{ sec_id }} .cl-rev-stars { color: #f59e0b; font-size: 14px; }
  #caratlane-reviews-{{ sec_id }} .cl-rev-verify { font-size: 9px; font-weight: 800; color: #059669; background: #ecfdf5; padding: 3px 8px; border-radius: 4px; }
  
  #caratlane-reviews-{{ sec_id }} .cl-rev-title { font-family: 'Cinzel', serif; font-size: 16px; font-weight: 700; color: #0f172a; margin: 0 0 10px 0; }
  #caratlane-reviews-{{ sec_id }} .cl-rev-body { font-size: 13px; line-height: 1.6; color: #475569; margin-bottom: 18px; flex-grow: 1; }
  #caratlane-reviews-{{ sec_id }} .cl-rev-author { font-size: 11px; color: #64748b; border-top: 1px solid #f1f5f9; padding-top: 12px; }
  #caratlane-reviews-{{ sec_id }} .cl-rev-author strong { color: #0f172a; }

  @media (max-width: 990px) {
    #caratlane-reviews-{{ sec_id }} .cl-rev-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "CaratLane Reviews",
  "tag": "section",
  "class": "caratlane-reviews-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fdfbf7" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#0f172a" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane Reviews" }
  ]
}
{% endschema %}
