{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - Try At Home Booking Banner Widget
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-try-at-home'
  assign bg_color = section.settings.bg_color | default: '#0f172a'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
  assign title = section.settings.title | default: 'TRY 500+ FINE JEWELRY DESIGNS AT HOME FOR FREE'
  assign desc = section.settings.desc | default: 'Our certified Jewelry Consultant will visit your doorstep with your selected designs. Zero obligation to buy, 100% free and private home consultation.'
-%}

<section id="caratlane-home-trial-{{ sec_id }}" class="cl-trial-wrap">
  <div class="cl-trial-container">
    <div class="cl-trial-card">
      <div class="cl-trial-grid">
        
        <!-- Left: Trial Info -->
        <div class="cl-trial-info">
          <span class="cl-trial-tag">✨ #1 CARATLANE EXCLUSIVE SERVICE</span>
          <h2 class="cl-trial-title">{{ title }}</h2>
          <p class="cl-trial-desc">{{ desc }}</p>

          <div class="cl-trial-steps">
            <div class="cl-step-item">
              <span class="cl-step-num">1</span>
              <span>Select 5 Designs Online</span>
            </div>
            <div class="cl-step-item">
              <span class="cl-step-num">2</span>
              <span>Pick Slot & Pincode</span>
            </div>
            <div class="cl-step-item">
              <span class="cl-step-num">3</span>
              <span>Try at Doorstep Free</span>
            </div>
          </div>
        </div>

        <!-- Right: Pincode Check & Booking Box -->
        <div class="cl-trial-box">
          <h3 class="cl-box-title">BOOK FREE HOME TRIAL SLOT</h3>
          <p class="cl-box-sub">Enter Pincode to check immediate slot availability:</p>

          <div class="cl-pincode-form">
            <input type="text" placeholder="Enter 6-digit Pincode (e.g. 400001)" class="cl-pin-input" maxlength="6" />
            <button type="button" class="cl-btn-check-pin" onclick="var inp = this.previousElementSibling.value; if(inp.length === 6){ alert('✅ Great news! Free Try at Home is AVAILABLE in your area (' + inp + '). A consultant will contact you within 15 mins.'); } else { alert('Please enter a valid 6-digit Pincode.'); }">
              CHECK SLOT
            </button>
          </div>

          <div class="cl-trial-guarantees">
            <span>🛡️ Fully Insured Safe Transit</span> • <span>💎 Certified Jewelry Only</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  #caratlane-home-trial-{{ sec_id }} {
    background: #fdfbf7;
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
  }
  #caratlane-home-trial-{{ sec_id }} .cl-trial-container { max-width: 1320px; margin: 0 auto; }
  #caratlane-home-trial-{{ sec_id }} .cl-trial-card {
    background: radial-gradient(circle at 90% 10%, #1e293b 0%, #0f172a 100%);
    color: {{ text_color }};
    border-radius: 24px;
    padding: clamp(32px, 5vw, 56px);
    border: 1px solid rgba(212, 175, 55, 0.3);
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.15);
  }
  #caratlane-home-trial-{{ sec_id }} .cl-trial-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: clamp(32px, 4vw, 56px); align-items: center; }
  
  #caratlane-home-trial-{{ sec_id }} .cl-trial-tag { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #caratlane-home-trial-{{ sec_id }} .cl-trial-title { font-family: 'Cinzel', serif; font-size: clamp(24px, 3.2vw, 36px); font-weight: 800; line-height: 1.2; margin: 8px 0 14px 0; color: #ffffff; }
  #caratlane-home-trial-{{ sec_id }} .cl-trial-desc { font-size: 14px; line-height: 1.6; color: #94a3b8; margin-bottom: 28px; }

  #caratlane-home-trial-{{ sec_id }} .cl-trial-steps { display: flex; gap: 16px; flex-wrap: wrap; }
  #caratlane-home-trial-{{ sec_id }} .cl-step-item { display: flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 700; color: #cbd5e1; }
  #caratlane-home-trial-{{ sec_id }} .cl-step-num { width: 24px; height: 24px; border-radius: 50%; background: {{ accent_color }}; color: #0f172a; font-weight: 900; display: flex; align-items: center; justify-content: center; font-size: 11px; }

  #caratlane-home-trial-{{ sec_id }} .cl-trial-box {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 18px;
    padding: 28px;
  }
  #caratlane-home-trial-{{ sec_id }} .cl-box-title { font-family: 'Cinzel', serif; font-size: 16px; font-weight: 800; color: {{ accent_color }}; margin: 0 0 6px 0; }
  #caratlane-home-trial-{{ sec_id }} .cl-box-sub { font-size: 12px; color: #cbd5e1; margin-bottom: 18px; }
  
  #caratlane-home-trial-{{ sec_id }} .cl-pincode-form { display: flex; gap: 8px; margin-bottom: 16px; }
  #caratlane-home-trial-{{ sec_id }} .cl-pin-input {
    flex-grow: 1;
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid #475569;
    background: #0f172a;
    color: #ffffff;
    font-size: 13px;
    outline: none;
  }
  #caratlane-home-trial-{{ sec_id }} .cl-pin-input:focus { border-color: {{ accent_color }}; }
  #caratlane-home-trial-{{ sec_id }} .cl-btn-check-pin {
    background: linear-gradient(135deg, {{ accent_color }} 0%, #b89628 100%);
    color: #0f172a;
    font-weight: 900;
    font-size: 12px;
    padding: 12px 20px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    letter-spacing: 0.5px;
  }

  #caratlane-home-trial-{{ sec_id }} .cl-trial-guarantees { font-size: 11px; color: #94a3b8; text-align: center; }

  @media (max-width: 990px) {
    #caratlane-home-trial-{{ sec_id }} .cl-trial-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "CaratLane Try At Home Ban",
  "tag": "section",
  "class": "caratlane-tryathome-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Banner Title",
      "default": "TRY 500+ FINE JEWELRY DESIGNS AT HOME FOR FREE"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Banner Subtext",
      "default": "Our certified Jewelry Consultant will visit your doorstep with your selected designs. Zero obligation to buy, 100% free and private home consultation."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#d4af37"
    }
  ],
  "presets": [
    {
      "name": "CaratLane Try At Home Banner"
    }
  ]
}
{% endschema %}
