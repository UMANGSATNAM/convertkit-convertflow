{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - PLP Collection Header Banner
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-plp-header'
  assign bg_color = section.settings.bg_color | default: '#0f172a'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
  
  assign col_title = collection.title | default: 'CERTIFIED SOLITAIRE & FINE GOLD JEWELRY'
  assign col_desc = collection.description | default: 'Explore 1,200+ handcrafted solid gold & natural diamond designs with 100% BIS Hallmarking and IGI Certification.'
-%}

<section id="cl-plph-{{ sec_id }}" class="cl-plph-wrap">
  <div class="cl-plph-container">
    <div class="cl-plph-content">
      <span class="cl-plph-badge">✨ 100% BIS HALLMARKED • IGI CERTIFIED</span>
      <h1 class="cl-plph-title">{{ col_title }}</h1>
      <p class="cl-plph-desc">{{ col_desc }}</p>
      <div class="cl-plph-perks">
        <span>🏠 Free Doorstep Try at Home</span> • <span>🚚 Insured Express Shipping</span> • <span>🔄 15-Day Exchange</span>
      </div>
    </div>
  </div>
</section>

<style>
  #cl-plph-{{ sec_id }} { background: radial-gradient(circle at 50% 0%, #1e293b 0%, #0f172a 100%); color: {{ text_color }}; padding: clamp(48px, 6vw, 72px) 24px; text-align: center; font-family: 'Plus Jakarta Sans', sans-serif; border-bottom: 1px solid rgba(212, 175, 55, 0.25); }
  #cl-plph-{{ sec_id }} .cl-plph-container { max-width: 900px; margin: 0 auto; }
  #cl-plph-{{ sec_id }} .cl-plph-badge { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #cl-plph-{{ sec_id }} .cl-plph-title { font-family: 'Cinzel', serif; font-size: clamp(28px, 4vw, 44px); font-weight: 800; color: #ffffff; margin: 8px 0 12px 0; }
  #cl-plph-{{ sec_id }} .cl-plph-desc { font-size: 14px; line-height: 1.6; color: #94a3b8; margin-bottom: 20px; }
  #cl-plph-{{ sec_id }} .cl-plph-perks { font-size: 11px; color: #cbd5e1; font-weight: 700; }
</style>

{% schema %}
{
  "name": "CaratLane PLP Header",
  "tag": "section",
  "class": "caratlane-plp-header-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0f172a" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane PLP Header" }
  ]
}
{% endschema %}
