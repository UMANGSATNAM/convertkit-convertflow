{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - PDP Reviews & Customer Photos
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-pdp-reviews'
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#0f172a'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
-%}

<section id="cl-pdp-rev-{{ sec_id }}" class="cl-pdpr-wrap">
  <div class="cl-pdpr-container">
    <div class="cl-section-header">
      <span class="cl-sub-tag">⭐ VERIFIED PURCHASER REVIEWS</span>
      <h2 class="cl-section-title">REAL SPARKLE IN REAL CLIENT PHOTOS</h2>
    </div>

    <div class="cl-pdpr-grid">
      
      <div class="cl-pdpr-card">
        <div class="cl-pdpr-media">
          <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=500&q=80" alt="Client Photo 1" class="cl-pdpr-img" />
        </div>
        <div class="cl-pdpr-info">
          <div class="cl-pdpr-stars">★★★★★ <span class="cl-pdpr-verify">✓ VERIFIED PURCHASE</span></div>
          <h3 class="cl-pdpr-title">"The 18k Rose Gold Finish is Divine"</h3>
          <p class="cl-pdpr-body">"Ordered this for my engagement. The diamond clarity VVS-EF sparkles even in low indoor light. Highly recommend using their Try at Home service before buying!"</p>
          <div class="cl-pdpr-meta"><strong>Ananya R.</strong> — Mumbai • Verified Buyer</div>
        </div>
      </div>

      <div class="cl-pdpr-card">
        <div class="cl-pdpr-media">
          <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=500&q=80" alt="Client Photo 2" class="cl-pdpr-img" />
        </div>
        <div class="cl-pdpr-info">
          <div class="cl-pdpr-stars">★★★★★ <span class="cl-pdpr-verify">✓ VERIFIED PURCHASE</span></div>
          <h3 class="cl-pdpr-title">"IGI Certificate & Packaging 10/10"</h3>
          <p class="cl-pdpr-body">"Came in a luxury tamper-proof security box with physical IGI card and hallmark certificate. Worth every rupee!"</p>
          <div class="cl-pdpr-meta"><strong>Rohan K.</strong> — Delhi • Verified Buyer</div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #cl-pdp-rev-{{ sec_id }} { background: {{ bg_color }}; color: {{ text_color }}; padding: clamp(40px, 5vw, 64px) 24px; font-family: 'Plus Jakarta Sans', sans-serif; }
  #cl-pdp-rev-{{ sec_id }} .cl-pdpr-container { max-width: 1280px; margin: 0 auto; }
  #cl-pdp-rev-{{ sec_id }} .cl-section-header { text-align: center; margin-bottom: 36px; }
  #cl-pdp-rev-{{ sec_id }} .cl-sub-tag { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; }
  #cl-pdp-rev-{{ sec_id }} .cl-section-title { font-family: 'Cinzel', serif; font-size: clamp(24px, 3.2vw, 34px); font-weight: 800; color: #0f172a; margin: 4px 0 0 0; }

  #cl-pdp-rev-{{ sec_id }} .cl-pdpr-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  #cl-pdp-rev-{{ sec_id }} .cl-pdpr-card { background: #fdfbf7; border-radius: 16px; border: 1px solid rgba(212, 175, 55, 0.25); overflow: hidden; display: flex; }
  #cl-pdp-rev-{{ sec_id }} .cl-pdpr-media { width: 40%; flex-shrink: 0; }
  #cl-pdp-rev-{{ sec_id }} .cl-pdpr-img { width: 100%; height: 100%; object-fit: cover; }
  #cl-pdp-rev-{{ sec_id }} .cl-pdpr-info { padding: 24px; display: flex; flex-direction: column; }
  #cl-pdp-rev-{{ sec_id }} .cl-pdpr-stars { color: #f59e0b; font-size: 12px; margin-bottom: 8px; }
  #cl-pdp-rev-{{ sec_id }} .cl-pdpr-verify { color: #059669; font-size: 9px; font-weight: 800; background: #ecfdf5; padding: 2px 6px; border-radius: 4px; margin-left: 6px; }
  #cl-pdp-rev-{{ sec_id }} .cl-pdpr-title { font-family: 'Cinzel', serif; font-size: 15px; font-weight: 700; color: #0f172a; margin: 0 0 6px 0; }
  #cl-pdp-rev-{{ sec_id }} .cl-pdpr-body { font-size: 13px; line-height: 1.6; color: #475569; margin-bottom: 14px; flex-grow: 1; }
  #cl-pdp-rev-{{ sec_id }} .cl-pdpr-meta { font-size: 11px; color: #64748b; border-top: 1px solid #e2e8f0; padding-top: 10px; }

  @media (max-width: 768px) {
    #cl-pdp-rev-{{ sec_id }} .cl-pdpr-grid { grid-template-columns: 1fr; }
    #cl-pdp-rev-{{ sec_id }} .cl-pdpr-card { flex-direction: column; }
    #cl-pdp-rev-{{ sec_id }} .cl-pdpr-media { width: 100%; height: 200px; }
  }
</style>

{% schema %}
{
  "name": "CaratLane PDP Reviews",
  "tag": "section",
  "class": "caratlane-pdp-reviews-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#0f172a" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane PDP Reviews" }
  ]
}
{% endschema %}
