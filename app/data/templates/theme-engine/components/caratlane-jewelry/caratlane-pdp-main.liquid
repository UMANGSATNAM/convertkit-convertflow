{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - High-Converting PDP Main Section
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-pdp-main'
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#0f172a'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
  
  assign p_title = product.title | default: 'The Royal Crown Solitaire Ring'
  assign p_price = product.price | default: 4899900 | money_without_trailing_zeros | default: '₹48,999'
  assign p_compare = product.compare_at_price | default: 6200000 | money_without_trailing_zeros | default: '₹62,000'
-%}

<section id="cl-pdp-{{ sec_id }}" class="cl-pdp-wrap">
  <div class="cl-pdp-container">
    <div class="cl-pdp-grid">
      
      <!-- Gallery Left -->
      <div class="cl-pdp-gallery">
        <div class="cl-gallery-main">
          <span class="cl-gallery-tag">✨ IGI CERTIFIED NATURAL SOLITAIRE</span>
          <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=900&q=85" id="cl-main-img-{{ sec_id }}" alt="{{ p_title }}" class="cl-main-img" />
        </div>
        <div class="cl-gallery-thumbs">
          <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=200&q=80" alt="Angle 1" class="cl-thumb cl-thumb-active" onclick="document.getElementById('cl-main-img-{{ sec_id }}').src = this.src" />
          <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=200&q=80" alt="Angle 2" class="cl-thumb" onclick="document.getElementById('cl-main-img-{{ sec_id }}').src = this.src" />
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=200&q=80" alt="Angle 3" class="cl-thumb" onclick="document.getElementById('cl-main-img-{{ sec_id }}').src = this.src" />
        </div>
      </div>

      <!-- Info Right -->
      <div class="cl-pdp-info">
        <div class="cl-pdp-stars">★★★★★ <span class="cl-star-count">4.98 (1,420 Reviews)</span></div>
        <h1 class="cl-pdp-title">{{ p_title }}</h1>
        <p class="cl-pdp-sku">SKU: CR-SOL-9902 • BIS Hallmarked 18K Gold</p>

        <!-- Pricing -->
        <div class="cl-pdp-price-row">
          <span class="cl-pdp-price">{{ p_price }}</span>
          <span class="cl-pdp-compare">{{ p_compare }}</span>
          <span class="cl-pdp-save">SAVE 21%</span>
        </div>

        <!-- 4Cs Quick Matrix -->
        <div class="cl-pdp-matrix">
          <div class="cl-matrix-box"><span>CARAT</span><strong>0.50 Ct</strong></div>
          <div class="cl-matrix-box"><span>CLARITY</span><strong>VVS1</strong></div>
          <div class="cl-matrix-box"><span>COLOR</span><strong>EF</strong></div>
          <div class="cl-matrix-box"><span>CUT</span><strong>Ideal</strong></div>
        </div>

        <!-- Metal Selection -->
        <div class="cl-pdp-option">
          <label class="cl-option-label">SELECT METAL & TONE:</label>
          <div class="cl-metal-options">
            <button type="button" class="cl-metal-btn cl-metal-active" onclick="selectClMetal(this)">18K Yellow Gold</button>
            <button type="button" class="cl-metal-btn" onclick="selectClMetal(this)">18K Rose Gold</button>
            <button type="button" class="cl-metal-btn" onclick="selectClMetal(this)">18K White Gold</button>
          </div>
        </div>

        <!-- Ring Size Selection -->
        <div class="cl-pdp-option">
          <div class="cl-size-head">
            <label class="cl-option-label">SELECT RING SIZE (INDIAN):</label>
            <a href="javascript:void(0)" onclick="alert('📐 Ring Size Guide: Measure circumference of your finger with a string. Size 12 = 52mm, Size 14 = 54mm.')" class="cl-size-guide-link">Size Guide &rarr;</a>
          </div>
          <div class="cl-size-options">
            <button type="button" class="cl-size-btn" onclick="selectClSize(this)">10</button>
            <button type="button" class="cl-size-btn cl-size-active" onclick="selectClSize(this)">12</button>
            <button type="button" class="cl-size-btn" onclick="selectClSize(this)">14</button>
            <button type="button" class="cl-size-btn" onclick="selectClSize(this)">16</button>
            <button type="button" class="cl-size-btn" onclick="selectClSize(this)">18</button>
          </div>
        </div>

        <!-- Doorstep Pincode Checker -->
        <div class="cl-pdp-pin-box">
          <label class="cl-option-label">CHECK DOORSTEP TRY AT HOME & EXPRESS DISPATCH:</label>
          <div class="cl-pin-form">
            <input type="text" placeholder="Enter Pincode (e.g. 400001)" maxlength="6" class="cl-pdp-pin-input" />
            <button type="button" class="cl-btn-pin-check" onclick="var v = this.previousElementSibling.value; if(v.length===6){ alert('✅ Doorstep Free Home Trial available at ' + v + '! Express Dispatch by Tomorrow.'); } else { alert('Enter 6-digit Pincode.'); }">CHECK</button>
          </div>
        </div>

        <!-- CTAs -->
        <div class="cl-pdp-actions">
          <button type="button" class="cl-btn-add-cart" onclick="this.textContent = 'ADDED TO BAG! ✓'; setTimeout(() => this.textContent = 'ADD TO SHOPPING BAG', 2000)">
            ADD TO SHOPPING BAG
          </button>
          <button type="button" class="cl-btn-try-home" onclick="alert('✨ Booked Free Home Trial! Consultant will call within 15 mins.')">
            🏠 TRY AT HOME FREE
          </button>
        </div>

        <!-- Perks List -->
        <div class="cl-pdp-perks">
          <span>🏛️ 100% BIS Hallmarked</span> • <span>💎 IGI Certified</span> • <span>🔄 15-Day Exchange</span> • <span>⚖️ Lifetime Buyback</span>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- Mobile Sticky ATC Bar -->
<div class="cl-sticky-atc-bar">
  <div class="cl-satc-inner">
    <div>
      <div class="cl-satc-title">{{ p_title }}</div>
      <div class="cl-satc-price">{{ p_price }}</div>
    </div>
    <button type="button" class="cl-satc-btn" onclick="alert('Added to Shopping Bag!')">ADD TO BAG</button>
  </div>
</div>

<style>
  #cl-pdp-{{ sec_id }} { background: {{ bg_color }}; color: {{ text_color }}; padding: clamp(36px, 5vw, 64px) 24px; font-family: 'Plus Jakarta Sans', sans-serif; }
  #cl-pdp-{{ sec_id }} .cl-pdp-container { max-width: 1280px; margin: 0 auto; }
  #cl-pdp-{{ sec_id }} .cl-pdp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 64px); }
  
  #cl-pdp-{{ sec_id }} .cl-pdp-gallery { display: flex; flex-direction: column; gap: 16px; }
  #cl-pdp-{{ sec_id }} .cl-gallery-main { position: relative; aspect-ratio: 1; border-radius: 20px; overflow: hidden; border: 1px solid #e2e8f0; background: #f8fafc; }
  #cl-pdp-{{ sec_id }} .cl-main-img { width: 100%; height: 100%; object-fit: cover; }
  #cl-pdp-{{ sec_id }} .cl-gallery-tag { position: absolute; top: 16px; left: 16px; background: #0f172a; color: {{ accent_color }}; font-size: 10px; font-weight: 900; padding: 6px 12px; border-radius: 6px; }

  #cl-pdp-{{ sec_id }} .cl-gallery-thumbs { display: flex; gap: 12px; }
  #cl-pdp-{{ sec_id }} .cl-thumb { width: 70px; height: 70px; border-radius: 10px; object-fit: cover; border: 2px solid #e2e8f0; cursor: pointer; }
  #cl-pdp-{{ sec_id }} .cl-thumb-active { border-color: {{ accent_color }}; }

  #cl-pdp-{{ sec_id }} .cl-pdp-stars { color: #f59e0b; font-size: 12px; margin-bottom: 8px; }
  #cl-pdp-{{ sec_id }} .cl-star-count { color: #64748b; margin-left: 6px; }
  #cl-pdp-{{ sec_id }} .cl-pdp-title { font-family: 'Cinzel', serif; font-size: clamp(24px, 3.2vw, 36px); font-weight: 800; margin: 0 0 6px 0; color: #0f172a; }
  #cl-pdp-{{ sec_id }} .cl-pdp-sku { font-size: 11px; color: #94a3b8; margin-bottom: 18px; }

  #cl-pdp-{{ sec_id }} .cl-pdp-price-row { display: flex; align-items: center; gap: 10px; margin-bottom: 22px; }
  #cl-pdp-{{ sec_id }} .cl-pdp-price { font-size: 26px; font-weight: 900; color: #0f172a; }
  #cl-pdp-{{ sec_id }} .cl-pdp-compare { font-size: 16px; text-decoration: line-through; color: #94a3b8; }
  #cl-pdp-{{ sec_id }} .cl-pdp-save { font-size: 11px; font-weight: 800; color: #059669; background: #ecfdf5; padding: 4px 8px; border-radius: 4px; }

  #cl-pdp-{{ sec_id }} .cl-pdp-matrix { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 24px; }
  #cl-pdp-{{ sec_id }} .cl-matrix-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px; text-align: center; }
  #cl-pdp-{{ sec_id }} .cl-matrix-box span { font-size: 9px; font-weight: 800; color: #64748b; display: block; }
  #cl-pdp-{{ sec_id }} .cl-matrix-box strong { font-size: 12px; font-weight: 900; color: #0f172a; margin-top: 2px; display: block; }

  #cl-pdp-{{ sec_id }} .cl-pdp-option { margin-bottom: 20px; }
  #cl-pdp-{{ sec_id }} .cl-option-label { font-size: 11px; font-weight: 800; color: #0f172a; letter-spacing: 0.5px; display: block; margin-bottom: 8px; }
  
  #cl-pdp-{{ sec_id }} .cl-metal-options { display: flex; gap: 8px; flex-wrap: wrap; }
  #cl-pdp-{{ sec_id }} .cl-metal-btn { background: #f8fafc; color: #334155; border: 1px solid #cbd5e1; padding: 8px 14px; border-radius: 8px; font-size: 11px; font-weight: 700; cursor: pointer; }
  #cl-pdp-{{ sec_id }} .cl-metal-btn.cl-metal-active { background: #0f172a; color: {{ accent_color }}; border-color: #0f172a; }

  #cl-pdp-{{ sec_id }} .cl-size-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  #cl-pdp-{{ sec_id }} .cl-size-guide-link { font-size: 11px; color: {{ accent_color }}; font-weight: 800; text-decoration: none; }
  #cl-pdp-{{ sec_id }} .cl-size-options { display: flex; gap: 8px; }
  #cl-pdp-{{ sec_id }} .cl-size-btn { width: 38px; height: 38px; border-radius: 8px; border: 1px solid #cbd5e1; background: #f8fafc; font-size: 12px; font-weight: 800; cursor: pointer; }
  #cl-pdp-{{ sec_id }} .cl-size-btn.cl-size-active { background: #0f172a; color: {{ accent_color }}; border-color: #0f172a; }

  #cl-pdp-{{ sec_id }} .cl-pdp-pin-box { background: #fdfbf7; border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 12px; padding: 14px; margin-bottom: 24px; }
  #cl-pdp-{{ sec_id }} .cl-pin-form { display: flex; gap: 8px; margin-top: 6px; }
  #cl-pdp-{{ sec_id }} .cl-pdp-pin-input { flex-grow: 1; padding: 10px 14px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 12px; outline: none; }
  #cl-pdp-{{ sec_id }} .cl-btn-pin-check { background: #0f172a; color: {{ accent_color }}; border: none; padding: 10px 16px; border-radius: 8px; font-weight: 800; font-size: 11px; cursor: pointer; }

  #cl-pdp-{{ sec_id }} .cl-pdp-actions { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
  #cl-pdp-{{ sec_id }} .cl-btn-add-cart { background: linear-gradient(135deg, {{ accent_color }} 0%, #b89628 100%); color: #0f172a; font-weight: 900; font-size: 13px; padding: 16px; border-radius: 99px; border: none; cursor: pointer; letter-spacing: 0.8px; box-shadow: 0 8px 20px rgba(212, 175, 55, 0.25); }
  #cl-pdp-{{ sec_id }} .cl-btn-try-home { background: #0f172a; color: #ffffff; border: 1px solid {{ accent_color }}; font-weight: 800; font-size: 12px; padding: 14px; border-radius: 99px; cursor: pointer; }

  #cl-pdp-{{ sec_id }} .cl-pdp-perks { font-size: 11px; color: #64748b; text-align: center; }

  /* Mobile Sticky ATC */
  .cl-sticky-atc-bar { display: none; position: fixed; bottom: 0; left: 0; right: 0; background: #0f172a; color: #ffffff; padding: 12px 18px; z-index: 1000; border-top: 1px solid {{ accent_color }}; }
  .cl-satc-inner { display: flex; justify-content: space-between; align-items: center; }
  .cl-satc-title { font-size: 12px; font-weight: 800; }
  .cl-satc-price { font-size: 14px; font-weight: 900; color: {{ accent_color }}; }
  .cl-satc-btn { background: {{ accent_color }}; color: #0f172a; border: none; padding: 10px 18px; border-radius: 99px; font-size: 11px; font-weight: 900; }

  @media (max-width: 990px) {
    #cl-pdp-{{ sec_id }} .cl-pdp-grid { grid-template-columns: 1fr; }
    .cl-sticky-atc-bar { display: block; }
  }
</style>

<script>
  function selectClMetal(btn) {
    var p = btn.parentElement;
    p.querySelectorAll('.cl-metal-btn').forEach(function(b) { b.classList.remove('cl-metal-active'); });
    btn.classList.add('cl-metal-active');
  }
  function selectClSize(btn) {
    var p = btn.parentElement;
    p.querySelectorAll('.cl-size-btn').forEach(function(b) { b.classList.remove('cl-size-active'); });
    btn.classList.add('cl-size-active');
  }
</script>

{% schema %}
{
  "name": "CaratLane PDP Main",
  "tag": "section",
  "class": "caratlane-pdp-main-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#0f172a" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane PDP Main" }
  ]
}
{% endschema %}
