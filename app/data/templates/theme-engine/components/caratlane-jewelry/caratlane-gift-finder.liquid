{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - Interactive Gift Finder Widget
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-gift-finder'
  assign bg_color = section.settings.bg_color | default: '#fdfbf7'
  assign text_color = section.settings.text_color | default: '#0f172a'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
-%}

<section id="caratlane-gift-{{ sec_id }}" class="cl-gift-wrap">
  <div class="cl-gift-container">
    <div class="cl-gift-header">
      <span class="cl-gift-sub">✨ FIND THE PERFECT JEWELRY GIFT</span>
      <h2 class="cl-gift-title">GIFTS THAT TELL A THOUSAND STORIES</h2>
      <p class="cl-gift-desc">Select recipient & budget to discover personalized, certified gold & diamond gift recommendations:</p>
    </div>

    <div class="cl-gift-widget">
      
      <!-- Step 1: Recipient -->
      <div class="cl-widget-col">
        <label class="cl-widget-label">1. WHO ARE YOU SHOPPING FOR?</label>
        <div class="cl-widget-options">
          <button type="button" class="cl-opt-btn cl-opt-active" onclick="selectGiftOpt(this)">For Wife / Partner</button>
          <button type="button" class="cl-opt-btn" onclick="selectGiftOpt(this)">For Mother</button>
          <button type="button" class="cl-opt-btn" onclick="selectGiftOpt(this)">For Sister</button>
          <button type="button" class="cl-opt-btn" onclick="selectGiftOpt(this)">Self Gift</button>
        </div>
      </div>

      <!-- Step 2: Budget -->
      <div class="cl-widget-col">
        <label class="cl-widget-label">2. SELECT BUDGET RANGE</label>
        <div class="cl-widget-options">
          <button type="button" class="cl-opt-btn" onclick="selectGiftOpt(this)">Under ₹15,000</button>
          <button type="button" class="cl-opt-btn cl-opt-active" onclick="selectGiftOpt(this)">₹15,000 - ₹30,000</button>
          <button type="button" class="cl-opt-btn" onclick="selectGiftOpt(this)">₹30,000 - ₹50,000</button>
          <button type="button" class="cl-opt-btn" onclick="selectGiftOpt(this)">₹50,000+</button>
        </div>
      </div>

      <!-- Submit CTA -->
      <div class="cl-widget-action">
        <a href="/collections/all" class="cl-btn-find-gift">
          DISCOVER GIFT RECOMMENDATIONS &rarr;
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  #caratlane-gift-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
  }
  #caratlane-gift-{{ sec_id }} .cl-gift-container { max-width: 1240px; margin: 0 auto; }
  #caratlane-gift-{{ sec_id }} .cl-gift-header { text-align: center; margin-bottom: 40px; }
  #caratlane-gift-{{ sec_id }} .cl-gift-sub { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #caratlane-gift-{{ sec_id }} .cl-gift-title { font-family: 'Cinzel', serif; font-size: clamp(26px, 3.5vw, 38px); font-weight: 800; color: #0f172a; margin: 6px 0 10px 0; }
  #caratlane-gift-{{ sec_id }} .cl-gift-desc { font-size: 14px; color: #64748b; margin: 0; }

  #caratlane-gift-{{ sec_id }} .cl-gift-widget {
    background: #ffffff;
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 20px;
    padding: clamp(24px, 4vw, 40px);
    box-shadow: 0 15px 40px rgba(15, 23, 42, 0.05);
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 32px;
    align-items: center;
  }
  #caratlane-gift-{{ sec_id }} .cl-widget-label { font-size: 11px; font-weight: 800; color: #0f172a; letter-spacing: 0.5px; display: block; margin-bottom: 12px; }
  #caratlane-gift-{{ sec_id }} .cl-widget-options { display: flex; flex-wrap: wrap; gap: 8px; }
  #caratlane-gift-{{ sec_id }} .cl-opt-btn {
    background: #f8fafc;
    color: #475569;
    border: 1px solid #cbd5e1;
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  #caratlane-gift-{{ sec_id }} .cl-opt-btn.cl-opt-active,
  #caratlane-gift-{{ sec_id }} .cl-opt-btn:hover {
    background: #0f172a;
    color: {{ accent_color }};
    border-color: #0f172a;
  }

  #caratlane-gift-{{ sec_id }} .cl-btn-find-gift {
    background: linear-gradient(135deg, {{ accent_color }} 0%, #b89628 100%);
    color: #0f172a;
    font-weight: 900;
    font-size: 12px;
    padding: 16px 24px;
    border-radius: 99px;
    text-decoration: none;
    display: inline-block;
    white-space: nowrap;
    letter-spacing: 0.5px;
    box-shadow: 0 8px 20px rgba(212, 175, 55, 0.25);
    transition: transform 0.2s ease;
  }
  #caratlane-gift-{{ sec_id }} .cl-btn-find-gift:hover { transform: translateY(-2px); }

  @media (max-width: 990px) {
    #caratlane-gift-{{ sec_id }} .cl-gift-widget { grid-template-columns: 1fr; gap: 24px; }
    #caratlane-gift-{{ sec_id }} .cl-btn-find-gift { width: 100%; text-align: center; }
  }
</style>

<script>
  function selectGiftOpt(btn) {
    var parent = btn.parentElement;
    parent.querySelectorAll('.cl-opt-btn').forEach(function(b) { b.classList.remove('cl-opt-active'); });
    btn.classList.add('cl-opt-active');
  }
</script>

{% schema %}
{
  "name": "CaratLane Gift Finder",
  "tag": "section",
  "class": "caratlane-gift-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fdfbf7" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#0f172a" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane Gift Finder" }
  ]
}
{% endschema %}
