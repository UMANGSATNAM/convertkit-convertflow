{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - Luxury Footer
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-footer'
  assign bg_color = section.settings.bg_color | default: '#090d16'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
-%}

<footer id="caratlane-footer-{{ sec_id }}" class="cl-foot-wrap">
  <div class="cl-foot-container">
    
    <div class="cl-foot-grid">
      
      <!-- Brand Column -->
      <div class="cl-foot-col cl-foot-brand">
        <a href="/" class="cl-foot-logo">
          <span class="cl-foot-title">CARATLANE</span>
          <span class="cl-foot-tata">A TATA PRODUCT</span>
        </a>
        <p class="cl-foot-tagline">India's premier modern fine jewelry destination. 100% Certified Diamonds, BIS Hallmarked 14K & 18K Solid Gold crafted with precision.</p>
        <div class="cl-foot-cert-logos">
          <span class="cl-cert-pill">🏛️ BIS HALLMARK</span>
          <span class="cl-cert-pill">💎 IGI CERTIFIED</span>
          <span class="cl-cert-pill">🛡️ GIA VERIFIED</span>
        </div>
      </div>

      <!-- Links 1 -->
      <div class="cl-foot-col">
        <h4 class="cl-col-title">OUR COLLECTIONS</h4>
        <ul class="cl-foot-links">
          <li><a href="/collections/all">Solitaire Rings</a></li>
          <li><a href="/collections/all">Diamond Earrings</a></li>
          <li><a href="/collections/all">Gold Pendants</a></li>
          <li><a href="/collections/all">Modern Mangalsutras</a></li>
          <li><a href="/collections/all">Tennis Bracelets</a></li>
        </ul>
      </div>

      <!-- Links 2 -->
      <div class="cl-foot-col">
        <h4 class="cl-col-title">CUSTOMER SERVICES</h4>
        <ul class="cl-foot-links">
          <li><a href="/pages/try-at-home">🏠 Book Free Home Trial</a></li>
          <li><a href="/pages/contact">Track Insured Delivery</a></li>
          <li><a href="/pages/contact">15-Day Money Back Exchange</a></li>
          <li><a href="/pages/contact">Lifetime Buyback Value</a></li>
          <li><a href="/pages/contact">Find 250+ Retail Stores</a></li>
        </ul>
      </div>

      <!-- Links 3 -->
      <div class="cl-foot-col">
        <h4 class="cl-col-title">STORE LOCATOR & CARE</h4>
        <p class="cl-store-text">Visit our 250+ experience stores across India or call our 24/7 VIP Concierge:</p>
        <div class="cl-concierge-phone">📞 1800-102-0103 (Toll Free)</div>
        <div class="cl-payment-icons">
          <span>💳 Visa</span> • <span>💳 Mastercard</span> • <span>📱 UPI</span> • <span>🏦 NetBanking</span>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="cl-foot-bottom">
      <div class="cl-copy">
        &copy; {{ 'now' | date: "%Y" }} CARATLANE TRADING PRIVATE LIMITED (A TATA ENTERPRISE). ALL RIGHTS RESERVED.
      </div>
      <div class="cl-legal-links">
        <a href="/policies/privacy-policy">PRIVACY POLICY</a>
        <a href="/policies/terms-of-service">TERMS OF SERVICE</a>
        <a href="/pages/contact">HALLMARKING VERIFICATION</a>
      </div>
    </div>

  </div>
</footer>

<style>
  #caratlane-footer-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px 30px 24px;
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    border-top: 1px solid rgba(212, 175, 55, 0.3);
  }
  #caratlane-footer-{{ sec_id }} .cl-foot-container { max-width: 1320px; margin: 0 auto; }
  #caratlane-footer-{{ sec_id }} .cl-foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.2fr; gap: 40px; margin-bottom: 48px; }
  
  #caratlane-footer-{{ sec_id }} .cl-foot-logo { text-decoration: none; color: #ffffff; display: block; margin-bottom: 14px; }
  #caratlane-footer-{{ sec_id }} .cl-foot-title { font-family: 'Cinzel', serif; font-size: 22px; font-weight: 900; letter-spacing: 2px; display: block; }
  #caratlane-footer-{{ sec_id }} .cl-foot-tata { font-size: 9px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; display: block; margin-top: 2px; }
  #caratlane-footer-{{ sec_id }} .cl-foot-tagline { font-size: 13px; line-height: 1.6; color: #94a3b8; margin-bottom: 18px; max-width: 340px; }
  
  #caratlane-footer-{{ sec_id }} .cl-foot-cert-logos { display: flex; gap: 8px; flex-wrap: wrap; }
  #caratlane-footer-{{ sec_id }} .cl-cert-pill { background: rgba(255,255,255,0.06); border: 1px solid rgba(212, 175, 55, 0.25); color: {{ accent_color }}; font-size: 9px; font-weight: 800; padding: 4px 8px; border-radius: 4px; }

  #caratlane-footer-{{ sec_id }} .cl-col-title { font-family: 'Cinzel', serif; font-size: 13px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1px; margin: 0 0 18px 0; }
  #caratlane-footer-{{ sec_id }} .cl-foot-links { list-style: none; padding: 0; margin: 0; }
  #caratlane-footer-{{ sec_id }} .cl-foot-links li { margin-bottom: 10px; }
  #caratlane-footer-{{ sec_id }} .cl-foot-links a { color: #cbd5e1; text-decoration: none; font-size: 13px; transition: color 0.2s ease; }
  #caratlane-footer-{{ sec_id }} .cl-foot-links a:hover { color: {{ accent_color }}; }

  #caratlane-footer-{{ sec_id }} .cl-store-text { font-size: 13px; color: #94a3b8; line-height: 1.5; margin-bottom: 12px; }
  #caratlane-footer-{{ sec_id }} .cl-concierge-phone { font-size: 14px; font-weight: 800; color: #ffffff; margin-bottom: 16px; }
  #caratlane-footer-{{ sec_id }} .cl-payment-icons { font-size: 11px; color: #64748b; }

  #caratlane-footer-{{ sec_id }} .cl-foot-bottom { border-top: 1px solid #1e293b; padding-top: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; font-size: 11px; color: #64748b; }
  #caratlane-footer-{{ sec_id }} .cl-legal-links a { color: #64748b; text-decoration: none; margin-left: 16px; transition: color 0.2s ease; }
  #caratlane-footer-{{ sec_id }} .cl-legal-links a:hover { color: {{ accent_color }}; }

  @media (max-width: 990px) {
    #caratlane-footer-{{ sec_id }} .cl-foot-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 550px) {
    #caratlane-footer-{{ sec_id }} .cl-foot-grid { grid-template-columns: 1fr; }
    #caratlane-footer-{{ sec_id }} .cl-foot-bottom { flex-direction: column; text-align: center; }
    #caratlane-footer-{{ sec_id }} .cl-legal-links a { margin: 0 8px; }
  }
</style>

{% schema %}
{
  "name": "CaratLane Luxury Footer",
  "tag": "section",
  "class": "caratlane-footer-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#090d16" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent Gold Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane Luxury Footer" }
  ]
}
{% endschema %}
