{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - FAQ Accordion
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-faq'
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#0f172a'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
-%}

<section id="caratlane-faq-{{ sec_id }}" class="cl-faq-wrap">
  <div class="cl-faq-container">
    <div class="cl-section-header">
      <span class="cl-sub-tag">❓ FREQUENTLY ASKED QUESTIONS</span>
      <h2 class="cl-section-title">EVERYTHING YOU NEED TO KNOW ABOUT FINE JEWELRY</h2>
    </div>

    <div class="cl-faq-list">
      
      <!-- FAQ 1 -->
      <div class="cl-faq-item">
        <button type="button" class="cl-faq-btn" onclick="toggleClFaq(this)">
          <span>How does CaratLane's Free Try at Home service work?</span>
          <span class="cl-faq-icon">+</span>
        </button>
        <div class="cl-faq-ans">
          <p>Our Try at Home service allows you to pick up to 5 designs online. A certified Jewelry Consultant will bring them to your doorstep at your chosen time slot. It is 100% free, fully insured, with zero obligation to buy!</p>
        </div>
      </div>

      <!-- FAQ 2 -->
      <div class="cl-faq-item">
        <button type="button" class="cl-faq-btn" onclick="toggleClFaq(this)">
          <span>Are CaratLane diamonds and gold 100% certified?</span>
          <span class="cl-faq-icon">+</span>
        </button>
        <div class="cl-faq-ans">
          <p>Yes! Every single piece of gold carries the official Govt. of India BIS Hallmark stamp (14K, 18K, or 22K). All natural diamonds come with independent certificates from world-renowned gemological laboratories like IGI and GIA.</p>
        </div>
      </div>

      <!-- FAQ 3 -->
      <div class="cl-faq-item">
        <button type="button" class="cl-faq-btn" onclick="toggleClFaq(this)">
          <span>What is the Lifetime Buyback & 15-Day Exchange policy?</span>
          <span class="cl-faq-icon">+</span>
        </button>
        <div class="cl-faq-ans">
          <p>We offer a 15-day 100% money-back exchange policy. In addition, all CaratLane jewelry is backed by a Lifetime Buyback Guarantee — you can exchange or upgrade your jewelry anytime at prevailing market gold & diamond rates!</p>
        </div>
      </div>

      <!-- FAQ 4 -->
      <div class="cl-faq-item">
        <button type="button" class="cl-faq-btn" onclick="toggleClFaq(this)">
          <span>How is my jewelry shipped and delivered safely?</span>
          <span class="cl-faq-icon">+</span>
        </button>
        <div class="cl-faq-ans">
          <p>All shipments are sent in tamper-proof, temperature-sealed security boxes with 100% transit insurance. Delivery is handled by specialized logistics partners with OTP verification at your doorstep.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #caratlane-faq-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
  }
  #caratlane-faq-{{ sec_id }} .cl-faq-container { max-width: 900px; margin: 0 auto; }
  #caratlane-faq-{{ sec_id }} .cl-section-header { text-align: center; margin-bottom: 40px; }
  #caratlane-faq-{{ sec_id }} .cl-sub-tag { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #caratlane-faq-{{ sec_id }} .cl-section-title { font-family: 'Cinzel', serif; font-size: clamp(24px, 3.5vw, 34px); font-weight: 800; color: #0f172a; margin: 6px 0 0 0; }

  #caratlane-faq-{{ sec_id }} .cl-faq-list { display: flex; flex-direction: column; gap: 14px; }
  #caratlane-faq-{{ sec_id }} .cl-faq-item {
    background: #fdfbf7;
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 12px;
    overflow: hidden;
  }
  #caratlane-faq-{{ sec_id }} .cl-faq-btn {
    width: 100%;
    padding: 18px 24px;
    background: none;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'Cinzel', serif;
    font-size: 15px;
    font-weight: 700;
    color: #0f172a;
    cursor: pointer;
    text-align: left;
  }
  #caratlane-faq-{{ sec_id }} .cl-faq-icon { font-size: 18px; color: {{ accent_color }}; font-weight: 900; }

  #caratlane-faq-{{ sec_id }} .cl-faq-ans {
    padding: 0 24px 18px 24px;
    font-size: 13px;
    line-height: 1.6;
    color: #475569;
    display: none;
  }
  #caratlane-faq-{{ sec_id }} .cl-faq-open .cl-faq-ans { display: block; }
  #caratlane-faq-{{ sec_id }} .cl-faq-open .cl-faq-icon { transform: rotate(45deg); }
</style>

<script>
  function toggleClFaq(btn) {
    var item = btn.parentElement;
    item.classList.toggle('cl-faq-open');
  }
</script>

{% schema %}
{
  "name": "CaratLane FAQ",
  "tag": "section",
  "class": "caratlane-faq-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#0f172a" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane FAQ" }
  ]
}
{% endschema %}
