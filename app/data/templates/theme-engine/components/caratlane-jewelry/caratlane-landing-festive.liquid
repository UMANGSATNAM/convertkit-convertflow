{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - Festive Campaign Sales Landing Page
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-landing-festive'
  assign bg_color = section.settings.bg_color | default: '#0f172a'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
-%}

<section id="cl-land-{{ sec_id }}" class="cl-land-wrap">
  <div class="cl-land-container">
    <div class="cl-land-grid">
      
      <div class="cl-land-content">
        <span class="cl-land-badge">✨ FESTIVE DIAMOND FESTIVAL 2026</span>
        <h1 class="cl-land-title">EXCLUSIVE FESTIVE DIAMOND & GOLD PRIVILEGES</h1>
        <p class="cl-land-desc">Flat 25% Off on Diamond Value + Free Insured Express Delivery + Complimentary Silver Coin on orders above ₹30,000.</p>

        <!-- Live Countdown Timer -->
        <div class="cl-timer-box">
          <span class="cl-timer-label">⚡ OFFER ENDS IN:</span>
          <div class="cl-timer-digits">
            <div class="cl-digit"><span>02</span><small>DAYS</small></div>
            <div class="cl-digit"><span>14</span><small>HOURS</small></div>
            <div class="cl-digit"><span>38</span><small>MINS</small></div>
            <div class="cl-digit"><span>52</span><small>SECS</small></div>
          </div>
        </div>

        <div class="cl-land-actions">
          <a href="/collections/all" class="cl-btn-claim-landing">CLAIM FESTIVE DISCOUNT &rarr;</a>
          <button type="button" class="cl-btn-trial-landing" onclick="alert('✨ Booked Free Home Trial for Festive Collection!')">🏠 BOOK FREE HOME TRIAL</button>
        </div>
      </div>

      <div class="cl-land-media">
        <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=800&q=80" alt="Festive Solitaire" class="cl-land-img" />
      </div>

    </div>
  </div>
</section>

<style>
  #cl-land-{{ sec_id }} { background: radial-gradient(circle at 10% 20%, #1e293b 0%, #0f172a 100%); color: {{ text_color }}; padding: clamp(48px, 6vw, 84px) 24px; font-family: 'Plus Jakarta Sans', sans-serif; }
  #cl-land-{{ sec_id }} .cl-land-container { max-width: 1280px; margin: 0 auto; }
  #cl-land-{{ sec_id }} .cl-land-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(32px, 5vw, 64px); align-items: center; }

  #cl-land-{{ sec_id }} .cl-land-badge { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; background: rgba(212, 175, 55, 0.12); border: 1px solid rgba(212, 175, 55, 0.3); padding: 6px 14px; border-radius: 99px; display: inline-block; margin-bottom: 16px; }
  #cl-land-{{ sec_id }} .cl-land-title { font-family: 'Cinzel', serif; font-size: clamp(28px, 4vw, 46px); font-weight: 900; line-height: 1.15; color: #ffffff; margin: 0 0 14px 0; }
  #cl-land-{{ sec_id }} .cl-land-desc { font-size: 15px; line-height: 1.6; color: #cbd5e1; margin-bottom: 24px; }

  #cl-land-{{ sec_id }} .cl-timer-box { background: rgba(255,255,255,0.05); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 14px; padding: 16px 20px; margin-bottom: 28px; }
  #cl-land-{{ sec_id }} .cl-timer-label { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1px; display: block; margin-bottom: 10px; }
  #cl-land-{{ sec_id }} .cl-timer-digits { display: flex; gap: 14px; }
  #cl-land-{{ sec_id }} .cl-digit { text-align: center; background: #0f172a; border: 1px solid #334155; padding: 8px 12px; border-radius: 8px; min-width: 54px; }
  #cl-land-{{ sec_id }} .cl-digit span { font-size: 18px; font-weight: 900; color: #ffffff; display: block; }
  #cl-land-{{ sec_id }} .cl-digit small { font-size: 8px; color: #94a3b8; font-weight: 800; letter-spacing: 0.5px; }

  #cl-land-{{ sec_id }} .cl-land-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  #cl-land-{{ sec_id }} .cl-btn-claim-landing { background: linear-gradient(135deg, {{ accent_color }} 0%, #b89628 100%); color: #0f172a; font-weight: 900; font-size: 13px; padding: 14px 28px; border-radius: 99px; text-decoration: none; box-shadow: 0 8px 24px rgba(212, 175, 55, 0.3); }
  #cl-land-{{ sec_id }} .cl-btn-trial-landing { background: rgba(255,255,255,0.08); color: #ffffff; border: 1px solid rgba(255,255,255,0.2); font-weight: 800; font-size: 12px; padding: 14px 22px; border-radius: 99px; cursor: pointer; }

  #cl-land-{{ sec_id }} .cl-land-media { border-radius: 20px; overflow: hidden; border: 1px solid rgba(212, 175, 55, 0.3); aspect-ratio: 4/5; }
  #cl-land-{{ sec_id }} .cl-land-img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 990px) { #cl-land-{{ sec_id }} .cl-land-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "CaratLane Festive Landing",
  "tag": "section",
  "class": "caratlane-landing-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0f172a" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane Festive Landing" }
  ]
}
{% endschema %}
