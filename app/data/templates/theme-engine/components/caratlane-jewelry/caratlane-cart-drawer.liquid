{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - High-Converting Cart Page & Slide Drawer
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-cart-drawer'
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#0f172a'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
-%}

<section id="cl-cart-{{ sec_id }}" class="cl-cart-wrap">
  <div class="cl-cart-container">
    
    <div class="cl-cart-header">
      <h1 class="cl-cart-title">YOUR SHOPPING BAG (2 ITEMS)</h1>
      <p class="cl-cart-sub">✨ 100% Insured Doorstep Delivery + Complimentary Gift Box Included</p>
    </div>

    <!-- Free Insured Shipping Progress Bar -->
    <div class="cl-ship-progress">
      <div class="cl-sp-text">🎉 YOU HAVE UNLOCKED <strong>FREE INSURED DOORSTEP EXPRESS DELIVERY!</strong></div>
      <div class="cl-sp-bar"><div class="cl-sp-fill" style="width: 100%;"></div></div>
    </div>

    <div class="cl-cart-grid">
      
      <!-- Cart Items List -->
      <div class="cl-cart-items">
        
        <!-- Item 1 -->
        <div class="cl-citem">
          <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=200&q=80" alt="Royal Crown Ring" class="cl-citem-img" />
          <div class="cl-citem-info">
            <h3 class="cl-citem-title">The Royal Crown Solitaire Ring</h3>
            <div class="cl-citem-meta">18K Solid Rose Gold • Size: 14 • IGI Certified</div>
            <div class="cl-citem-price">₹48,999 <span class="cl-citem-orig">₹62,000</span></div>
            <div class="cl-citem-qty">
              <button type="button">-</button>
              <span>1</span>
              <button type="button">+</button>
              <a href="javascript:void(0)" class="cl-citem-remove">Remove</a>
            </div>
          </div>
        </div>

        <!-- Item 2 -->
        <div class="cl-citem">
          <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=200&q=80" alt="Bloom Solitaire Studs" class="cl-citem-img" />
          <div class="cl-citem-info">
            <h3 class="cl-citem-title">Bloom Solitaire Stud Earrings</h3>
            <div class="cl-citem-meta">14K Yellow Gold • EF Colorless</div>
            <div class="cl-citem-price">₹29,499 <span class="cl-citem-orig">₹36,000</span></div>
            <div class="cl-citem-qty">
              <button type="button">-</button>
              <span>1</span>
              <button type="button">+</button>
              <a href="javascript:void(0)" class="cl-citem-remove">Remove</a>
            </div>
          </div>
        </div>

      </div>

      <!-- Order Summary Box -->
      <div class="cl-cart-summary">
        <h3 class="cl-summary-title">ORDER SUMMARY</h3>
        
        <div class="cl-sum-row"><span>Subtotal:</span> <span>₹78,498</span></div>
        <div class="cl-sum-row"><span>Festive Offer Discount (CARAT25):</span> <span class="cl-sum-discount">-₹10,000</span></div>
        <div class="cl-sum-row"><span>Insured Doorstep Shipping:</span> <span class="cl-sum-free">FREE</span></div>
        <div class="cl-sum-row cl-sum-total"><span>Grand Total:</span> <span>₹68,498</span></div>

        <!-- Coupon Form -->
        <div class="cl-coupon-box">
          <input type="text" placeholder="Promo / Coupon Code" value="CARAT25" class="cl-coupon-input" />
          <button type="button" class="cl-btn-coupon">APPLIED ✓</button>
        </div>

        <button type="button" class="cl-btn-checkout" onclick="alert('🔒 Redirecting to Shopify Secure Insured Checkout...')">
          PROCEED TO SECURE CHECKOUT &rarr;
        </button>

        <div class="cl-summary-trust">
          <span>🛡️ 100% Insured Transit</span> • <span>💳 All Cards & UPI Accepted</span>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #cl-cart-{{ sec_id }} { background: {{ bg_color }}; color: {{ text_color }}; padding: clamp(40px, 5vw, 64px) 24px; font-family: 'Plus Jakarta Sans', sans-serif; }
  #cl-cart-{{ sec_id }} .cl-cart-container { max-width: 1200px; margin: 0 auto; }
  #cl-cart-{{ sec_id }} .cl-cart-header { text-align: center; margin-bottom: 24px; }
  #cl-cart-{{ sec_id }} .cl-cart-title { font-family: 'Cinzel', serif; font-size: clamp(24px, 3.5vw, 34px); font-weight: 800; color: #0f172a; margin: 0 0 6px 0; }
  #cl-cart-{{ sec_id }} .cl-cart-sub { font-size: 13px; color: #64748b; }

  #cl-cart-{{ sec_id }} .cl-ship-progress { background: #fdfbf7; border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 12px; padding: 14px 20px; margin-bottom: 32px; text-align: center; }
  #cl-cart-{{ sec_id }} .cl-sp-text { font-size: 12px; color: #0f172a; margin-bottom: 8px; }
  #cl-cart-{{ sec_id }} .cl-sp-text strong { color: #059669; }
  #cl-cart-{{ sec_id }} .cl-sp-bar { width: 100%; height: 8px; background: #e2e8f0; border-radius: 99px; overflow: hidden; }
  #cl-cart-{{ sec_id }} .cl-sp-fill { height: 100%; background: linear-gradient(90deg, #059669 0%, {{ accent_color }} 100%); }

  #cl-cart-{{ sec_id }} .cl-cart-grid { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: 36px; align-items: start; }
  #cl-cart-{{ sec_id }} .cl-cart-items { display: flex; flex-direction: column; gap: 16px; }
  #cl-cart-{{ sec_id }} .cl-citem { display: flex; gap: 16px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 16px; }
  #cl-cart-{{ sec_id }} .cl-citem-img { width: 90px; height: 90px; border-radius: 10px; object-fit: cover; }
  #cl-cart-{{ sec_id }} .cl-citem-info { flex-grow: 1; }
  #cl-cart-{{ sec_id }} .cl-citem-title { font-family: 'Cinzel', serif; font-size: 14px; font-weight: 700; color: #0f172a; margin: 0 0 4px 0; }
  #cl-cart-{{ sec_id }} .cl-citem-meta { font-size: 11px; color: #64748b; margin-bottom: 6px; }
  #cl-cart-{{ sec_id }} .cl-citem-price { font-size: 15px; font-weight: 900; color: #0f172a; margin-bottom: 10px; }
  #cl-cart-{{ sec_id }} .cl-citem-orig { font-size: 12px; text-decoration: line-through; color: #94a3b8; margin-left: 4px; }
  #cl-cart-{{ sec_id }} .cl-citem-qty { display: flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 800; }
  #cl-cart-{{ sec_id }} .cl-citem-qty button { width: 24px; height: 24px; border: 1px solid #cbd5e1; border-radius: 4px; background: #f8fafc; cursor: pointer; }
  #cl-cart-{{ sec_id }} .cl-citem-remove { color: #ef4444; font-size: 11px; margin-left: 12px; text-decoration: none; }

  #cl-cart-{{ sec_id }} .cl-cart-summary { background: #0f172a; color: #ffffff; border-radius: 18px; padding: 28px; border: 1px solid rgba(212, 175, 55, 0.3); }
  #cl-cart-{{ sec_id }} .cl-summary-title { font-family: 'Cinzel', serif; font-size: 16px; font-weight: 800; color: {{ accent_color }}; margin: 0 0 18px 0; }
  #cl-cart-{{ sec_id }} .cl-sum-row { display: flex; justify-content: space-between; font-size: 13px; color: #cbd5e1; margin-bottom: 10px; }
  #cl-cart-{{ sec_id }} .cl-sum-discount { color: #22c55e; font-weight: 800; }
  #cl-cart-{{ sec_id }} .cl-sum-free { color: #22c55e; font-weight: 900; }
  #cl-cart-{{ sec_id }} .cl-sum-total { font-size: 16px; font-weight: 900; color: #ffffff; border-top: 1px solid #334155; padding-top: 12px; margin-top: 12px; }

  #cl-cart-{{ sec_id }} .cl-coupon-box { display: flex; gap: 8px; margin: 20px 0; }
  #cl-cart-{{ sec_id }} .cl-coupon-input { flex-grow: 1; padding: 10px 14px; border-radius: 8px; border: 1px solid #475569; background: #1e293b; color: #ffffff; font-size: 12px; outline: none; }
  #cl-cart-{{ sec_id }} .cl-btn-coupon { background: {{ accent_color }}; color: #0f172a; border: none; padding: 10px 14px; border-radius: 8px; font-weight: 900; font-size: 11px; cursor: pointer; }

  #cl-cart-{{ sec_id }} .cl-btn-checkout { width: 100%; background: linear-gradient(135deg, {{ accent_color }} 0%, #b89628 100%); color: #0f172a; border: none; padding: 16px; border-radius: 99px; font-size: 13px; font-weight: 900; cursor: pointer; letter-spacing: 0.8px; box-shadow: 0 8px 24px rgba(212, 175, 55, 0.3); margin-bottom: 16px; }
  #cl-cart-{{ sec_id }} .cl-summary-trust { font-size: 11px; color: #94a3b8; text-align: center; }

  @media (max-width: 990px) { #cl-cart-{{ sec_id }} .cl-cart-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "CaratLane Cart Drawer",
  "tag": "section",
  "class": "caratlane-cart-drawer-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#0f172a" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane Cart Drawer" }
  ]
}
{% endschema %}
