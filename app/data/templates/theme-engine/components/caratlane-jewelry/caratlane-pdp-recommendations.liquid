{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - Product Page Recommendations
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-pdp-recs'
  assign bg_color = section.settings.bg_color | default: '#fdfbf7'
  assign text_color = section.settings.text_color | default: '#0f172a'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
-%}

<section id="cl-recs-{{ sec_id }}" class="cl-recs-wrap">
  <div class="cl-recs-container">
    <div class="cl-section-header">
      <span class="cl-sub-tag">✨ COMPLETE YOUR JEWELRY STACK</span>
      <h2 class="cl-section-title">YOU MAY ALSO LOVE</h2>
    </div>

    <div class="cl-recs-grid">
      
      <!-- Rec 1 -->
      <div class="cl-rec-card">
        <div class="cl-rec-media">
          <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=500&q=80" alt="Bloom Diamond Stud Earrings" class="cl-rec-img" />
          <button type="button" class="cl-rec-add" onclick="alert('Added Bloom Studs to your Shopping Bag!')">+ QUICK ADD</button>
        </div>
        <div class="cl-rec-info">
          <div class="cl-rec-stars">★★★★★</div>
          <h3 class="cl-rec-title">Bloom Solitaire Stud Earrings</h3>
          <div class="cl-rec-price">₹29,499 <span class="cl-rec-orig">₹36,000</span></div>
        </div>
      </div>

      <!-- Rec 2 -->
      <div class="cl-rec-card">
        <div class="cl-rec-media">
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=500&q=80" alt="Eternal Infinity Pendant" class="cl-rec-img" />
          <button type="button" class="cl-rec-add" onclick="alert('Added Eternal Infinity Pendant to your Shopping Bag!')">+ QUICK ADD</button>
        </div>
        <div class="cl-rec-info">
          <div class="cl-rec-stars">★★★★★</div>
          <h3 class="cl-rec-title">Eternal Infinity Diamond Pendant</h3>
          <div class="cl-rec-price">₹18,999 <span class="cl-rec-orig">₹24,000</span></div>
        </div>
      </div>

      <!-- Rec 3 -->
      <div class="cl-rec-card">
        <div class="cl-rec-media">
          <img src="https://images.unsplash.com/photo-1611591475141-89d554a93cf4?w=500&q=80" alt="Aura Solitaire Mangalsutra" class="cl-rec-img" />
          <button type="button" class="cl-rec-add" onclick="alert('Added Aura Mangalsutra to your Shopping Bag!')">+ QUICK ADD</button>
        </div>
        <div class="cl-rec-info">
          <div class="cl-rec-stars">★★★★★</div>
          <h3 class="cl-rec-title">Aura Modern Solitaire Mangalsutra</h3>
          <div class="cl-rec-price">₹38,499 <span class="cl-rec-orig">₹49,000</span></div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #cl-recs-{{ sec_id }} { background: {{ bg_color }}; color: {{ text_color }}; padding: clamp(40px, 5vw, 64px) 24px; font-family: 'Plus Jakarta Sans', sans-serif; }
  #cl-recs-{{ sec_id }} .cl-recs-container { max-width: 1280px; margin: 0 auto; }
  #cl-recs-{{ sec_id }} .cl-section-header { text-align: center; margin-bottom: 36px; }
  #cl-recs-{{ sec_id }} .cl-sub-tag { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; }
  #cl-recs-{{ sec_id }} .cl-section-title { font-family: 'Cinzel', serif; font-size: clamp(24px, 3.2vw, 34px); font-weight: 800; color: #0f172a; margin: 4px 0 0 0; }

  #cl-recs-{{ sec_id }} .cl-recs-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  #cl-recs-{{ sec_id }} .cl-rec-card { background: #ffffff; border-radius: 16px; overflow: hidden; border: 1px solid #e2e8f0; display: flex; flex-direction: column; }
  #cl-recs-{{ sec_id }} .cl-rec-media { position: relative; aspect-ratio: 1; overflow: hidden; background: #f8fafc; }
  #cl-recs-{{ sec_id }} .cl-rec-img { width: 100%; height: 100%; object-fit: cover; }
  #cl-recs-{{ sec_id }} .cl-rec-add { position: absolute; bottom: 10px; left: 10px; right: 10px; background: rgba(15,23,42,0.9); color: #ffffff; border: 1px solid {{ accent_color }}; padding: 10px; border-radius: 8px; font-size: 11px; font-weight: 800; cursor: pointer; }

  #cl-recs-{{ sec_id }} .cl-rec-info { padding: 16px; }
  #cl-recs-{{ sec_id }} .cl-rec-stars { color: #f59e0b; font-size: 11px; margin-bottom: 4px; }
  #cl-recs-{{ sec_id }} .cl-rec-title { font-family: 'Cinzel', serif; font-size: 14px; font-weight: 700; color: #0f172a; margin: 0 0 6px 0; }
  #cl-recs-{{ sec_id }} .cl-rec-price { font-size: 15px; font-weight: 900; color: #0f172a; }
  #cl-recs-{{ sec_id }} .cl-rec-orig { font-size: 12px; text-decoration: line-through; color: #94a3b8; margin-left: 6px; }

  @media (max-width: 768px) { #cl-recs-{{ sec_id }} .cl-recs-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "CaratLane PDP Recommendat",
  "tag": "section",
  "class": "caratlane-pdp-recs-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#fdfbf7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#d4af37"
    }
  ],
  "presets": [
    {
      "name": "CaratLane PDP Recommendations"
    }
  ]
}
{% endschema %}
