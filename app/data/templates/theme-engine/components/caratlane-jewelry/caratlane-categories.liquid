{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - Category Tiles Grid
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-categories'
  assign bg_color = section.settings.bg_color | default: '#fdfbf7'
  assign text_color = section.settings.text_color | default: '#0f172a'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
  assign title = section.settings.title | default: 'EXPLORE FINE JEWELRY BY CATEGORY'
  assign subtitle = section.settings.subtitle | default: 'CURATED HERITAGE & MODERN DESIGNS'
-%}

<section id="caratlane-categories-{{ sec_id }}" class="cl-categories-wrap">
  <div class="cl-cat-container">
    <div class="cl-section-header">
      <span class="cl-sub-tag">{{ subtitle }}</span>
      <h2 class="cl-section-title">{{ title }}</h2>
    </div>

    <div class="cl-categories-grid">
      
      <!-- Category 1 -->
      <a href="/collections/all" class="cl-cat-card">
        <div class="cl-cat-media">
          <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=600&q=80" alt="Solitaire Rings" class="cl-cat-img" loading="lazy" />
          <div class="cl-cat-overlay"></div>
        </div>
        <div class="cl-cat-meta">
          <span class="cl-cat-count">1,240+ Designs</span>
          <h3 class="cl-cat-name">Solitaire Rings</h3>
          <span class="cl-cat-arrow">SHOP COLLECTION &rarr;</span>
        </div>
      </a>

      <!-- Category 2 -->
      <a href="/collections/all" class="cl-cat-card">
        <div class="cl-cat-media">
          <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=600&q=80" alt="Diamond Earrings" class="cl-cat-img" loading="lazy" />
          <div class="cl-cat-overlay"></div>
        </div>
        <div class="cl-cat-meta">
          <span class="cl-cat-count">890+ Designs</span>
          <h3 class="cl-cat-name">Diamond Earrings</h3>
          <span class="cl-cat-arrow">SHOP COLLECTION &rarr;</span>
        </div>
      </a>

      <!-- Category 3 -->
      <a href="/collections/all" class="cl-cat-card">
        <div class="cl-cat-media">
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Gold Pendants" class="cl-cat-img" loading="lazy" />
          <div class="cl-cat-overlay"></div>
        </div>
        <div class="cl-cat-meta">
          <span class="cl-cat-count">650+ Designs</span>
          <h3 class="cl-cat-name">Gold Pendants</h3>
          <span class="cl-cat-arrow">SHOP COLLECTION &rarr;</span>
        </div>
      </a>

      <!-- Category 4 -->
      <a href="/collections/all" class="cl-cat-card">
        <div class="cl-cat-media">
          <img src="https://images.unsplash.com/photo-1611591475141-89d554a93cf4?w=600&q=80" alt="Modern Mangalsutras" class="cl-cat-img" loading="lazy" />
          <div class="cl-cat-overlay"></div>
        </div>
        <div class="cl-cat-meta">
          <span class="cl-cat-count">420+ Designs</span>
          <h3 class="cl-cat-name">Modern Mangalsutras</h3>
          <span class="cl-cat-arrow">SHOP COLLECTION &rarr;</span>
        </div>
      </a>

    </div>
  </div>
</section>

<style>
  #caratlane-categories-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
  }
  #caratlane-categories-{{ sec_id }} .cl-cat-container { max-width: 1320px; margin: 0 auto; }
  #caratlane-categories-{{ sec_id }} .cl-section-header { text-align: center; margin-bottom: 40px; }
  #caratlane-categories-{{ sec_id }} .cl-sub-tag { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #caratlane-categories-{{ sec_id }} .cl-section-title { font-family: 'Cinzel', serif; font-size: clamp(26px, 3.5vw, 38px); font-weight: 800; color: #0f172a; margin: 6px 0 0 0; }

  #caratlane-categories-{{ sec_id }} .cl-categories-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  #caratlane-categories-{{ sec_id }} .cl-cat-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    background: #0f172a;
    border: 1px solid rgba(212, 175, 55, 0.25);
    aspect-ratio: 3 / 4;
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  #caratlane-categories-{{ sec_id }} .cl-cat-card:hover { transform: translateY(-4px); border-color: {{ accent_color }}; }
  #caratlane-categories-{{ sec_id }} .cl-cat-media { width: 100%; height: 100%; position: absolute; inset: 0; }
  #caratlane-categories-{{ sec_id }} .cl-cat-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  #caratlane-categories-{{ sec_id }} .cl-cat-card:hover .cl-cat-img { transform: scale(1.06); }
  #caratlane-categories-{{ sec_id }} .cl-cat-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.05) 30%, rgba(15,23,42,0.88) 100%); }

  #caratlane-categories-{{ sec_id }} .cl-cat-meta {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    display: flex;
    flex-direction: column;
    z-index: 2;
  }
  #caratlane-categories-{{ sec_id }} .cl-cat-count { font-size: 10px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 0.5px; text-transform: uppercase; }
  #caratlane-categories-{{ sec_id }} .cl-cat-name { font-family: 'Cinzel', serif; font-size: 18px; font-weight: 800; color: #ffffff; margin: 4px 0 6px 0; }
  #caratlane-categories-{{ sec_id }} .cl-cat-arrow { font-size: 10px; font-weight: 800; color: #cbd5e1; letter-spacing: 0.5px; transition: color 0.2s ease; }
  #caratlane-categories-{{ sec_id }} .cl-cat-card:hover .cl-cat-arrow { color: {{ accent_color }}; }

  @media (max-width: 990px) {
    #caratlane-categories-{{ sec_id }} .cl-categories-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    #caratlane-categories-{{ sec_id }} .cl-categories-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "CaratLane Category Tiles",
  "tag": "section",
  "class": "caratlane-categories-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Title", "default": "EXPLORE FINE JEWELRY BY CATEGORY" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "CURATED HERITAGE & MODERN DESIGNS" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fdfbf7" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#0f172a" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane Category Tiles" }
  ]
}
{% endschema %}
