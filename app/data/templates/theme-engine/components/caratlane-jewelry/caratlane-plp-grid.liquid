{% comment %}
  -----------------------------------------------------------------------------
  10X CaratLane Fine Jewelry Benchmark - PLP Product Grid with Smart Filters
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'caratlane-plp-grid'
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#0f172a'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
-%}

<section id="cl-plpg-{{ sec_id }}" class="cl-plpg-wrap">
  <div class="cl-plpg-container">
    
    <!-- Filter Bar Top -->
    <div class="cl-plpg-topbar">
      <div class="cl-filter-tags">
        <button type="button" class="cl-ftag cl-ftag-active" onclick="filterPlp(this, 'all')">ALL DESIGNS (1,240)</button>
        <button type="button" class="cl-ftag" onclick="filterPlp(this, '18k')">18K SOLID GOLD</button>
        <button type="button" class="cl-ftag" onclick="filterPlp(this, 'solitaire')">SOLITAIRES</button>
        <button type="button" class="cl-ftag" onclick="filterPlp(this, 'gift')">UNDER ₹20K</button>
      </div>
      <div class="cl-sort-box">
        <label>SORT BY:</label>
        <select class="cl-sort-select">
          <option>Bestsellers (Popular)</option>
          <option>Price: Low to High</option>
          <option>Price: High to Low</option>
          <option>Newest Drops</option>
        </select>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="cl-plpg-grid">
      
      <!-- Item 1 -->
      <div class="cl-pcard">
        <div class="cl-pcard-media">
          <span class="cl-pcard-tag">BESTSELLER</span>
          <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=600&q=80" alt="Royal Crown Solitaire Ring" class="cl-pcard-img" />
          <button type="button" class="cl-pcard-add" onclick="alert('Added to Bag!')">+ QUICK ADD</button>
        </div>
        <div class="cl-pcard-info">
          <div class="cl-pcard-stars">★★★★★ <span class="cl-pcard-reviews">(1,420)</span></div>
          <h3 class="cl-pcard-title">The Royal Crown Solitaire Ring</h3>
          <div class="cl-pcard-price">₹48,999 <span class="cl-pcard-orig">₹62,000</span> <span class="cl-pcard-save">21% OFF</span></div>
          <div class="cl-pcard-metal">18K Solid Gold • VVS1 Clarity</div>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="cl-pcard">
        <div class="cl-pcard-media">
          <span class="cl-pcard-tag">TRY AT HOME</span>
          <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=600&q=80" alt="Bloom Solitaire Stud Earrings" class="cl-pcard-img" />
          <button type="button" class="cl-pcard-add" onclick="alert('Added to Bag!')">+ QUICK ADD</button>
        </div>
        <div class="cl-pcard-info">
          <div class="cl-pcard-stars">★★★★★ <span class="cl-pcard-reviews">(980)</span></div>
          <h3 class="cl-pcard-title">Bloom Solitaire Stud Earrings</h3>
          <div class="cl-pcard-price">₹29,499 <span class="cl-pcard-orig">₹36,000</span> <span class="cl-pcard-save">18% OFF</span></div>
          <div class="cl-pcard-metal">14K Solid Gold • EF Colorless</div>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="cl-pcard">
        <div class="cl-pcard-media">
          <span class="cl-pcard-tag">GIFTS UNDER ₹20K</span>
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Eternal Infinity Diamond Pendant" class="cl-pcard-img" />
          <button type="button" class="cl-pcard-add" onclick="alert('Added to Bag!')">+ QUICK ADD</button>
        </div>
        <div class="cl-pcard-info">
          <div class="cl-pcard-stars">★★★★★ <span class="cl-pcard-reviews">(2,150)</span></div>
          <h3 class="cl-pcard-title">Eternal Infinity Diamond Pendant</h3>
          <div class="cl-pcard-price">₹18,999 <span class="cl-pcard-orig">₹24,000</span> <span class="cl-pcard-save">20% OFF</span></div>
          <div class="cl-pcard-metal">18K Solid Gold • Ideal Cut</div>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="cl-pcard">
        <div class="cl-pcard-media">
          <span class="cl-pcard-tag">NEW LAUNCH</span>
          <img src="https://images.unsplash.com/photo-1611591475141-89d554a93cf4?w=600&q=80" alt="Aura Modern Solitaire Mangalsutra" class="cl-pcard-img" />
          <button type="button" class="cl-pcard-add" onclick="alert('Added to Bag!')">+ QUICK ADD</button>
        </div>
        <div class="cl-pcard-info">
          <div class="cl-pcard-stars">★★★★★ <span class="cl-pcard-reviews">(640)</span></div>
          <h3 class="cl-pcard-title">Aura Modern Solitaire Mangalsutra</h3>
          <div class="cl-pcard-price">₹38,499 <span class="cl-pcard-orig">₹49,000</span> <span class="cl-pcard-save">21% OFF</span></div>
          <div class="cl-pcard-metal">18K Rose Gold • Natural Diamond</div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #cl-plpg-{{ sec_id }} { background: {{ bg_color }}; color: {{ text_color }}; padding: clamp(36px, 5vw, 64px) 24px; font-family: 'Plus Jakarta Sans', sans-serif; }
  #cl-plpg-{{ sec_id }} .cl-plpg-container { max-width: 1320px; margin: 0 auto; }
  
  #cl-plpg-{{ sec_id }} .cl-plpg-topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; flex-wrap: wrap; gap: 16px; border-bottom: 1px solid #e2e8f0; padding-bottom: 18px; }
  #cl-plpg-{{ sec_id }} .cl-filter-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  #cl-plpg-{{ sec_id }} .cl-ftag { background: #f8fafc; color: #475569; border: 1px solid #cbd5e1; padding: 8px 16px; border-radius: 99px; font-size: 11px; font-weight: 800; cursor: pointer; }
  #cl-plpg-{{ sec_id }} .cl-ftag.cl-ftag-active { background: #0f172a; color: {{ accent_color }}; border-color: #0f172a; }

  #cl-plpg-{{ sec_id }} .cl-sort-box { display: flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 800; color: #64748b; }
  #cl-plpg-{{ sec_id }} .cl-sort-select { padding: 6px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 11px; font-weight: 700; outline: none; }

  #cl-plpg-{{ sec_id }} .cl-plpg-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  #cl-plpg-{{ sec_id }} .cl-pcard { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 4px 16px rgba(0,0,0,0.03); }
  #cl-plpg-{{ sec_id }} .cl-pcard-media { position: relative; aspect-ratio: 1; overflow: hidden; background: #f8fafc; }
  #cl-plpg-{{ sec_id }} .cl-pcard-img { width: 100%; height: 100%; object-fit: cover; }
  #cl-plpg-{{ sec_id }} .cl-pcard-tag { position: absolute; top: 10px; left: 10px; background: #0f172a; color: {{ accent_color }}; font-size: 9px; font-weight: 900; padding: 4px 8px; border-radius: 4px; }
  #cl-plpg-{{ sec_id }} .cl-pcard-add { position: absolute; bottom: 10px; left: 10px; right: 10px; background: rgba(15,23,42,0.9); color: #ffffff; border: 1px solid {{ accent_color }}; padding: 10px; border-radius: 8px; font-size: 11px; font-weight: 800; cursor: pointer; }

  #cl-plpg-{{ sec_id }} .cl-pcard-info { padding: 16px; display: flex; flex-direction: column; flex-grow: 1; }
  #cl-plpg-{{ sec_id }} .cl-pcard-stars { color: #f59e0b; font-size: 11px; margin-bottom: 4px; }
  #cl-plpg-{{ sec_id }} .cl-pcard-reviews { color: #64748b; font-size: 10px; }
  #cl-plpg-{{ sec_id }} .cl-pcard-title { font-family: 'Cinzel', serif; font-size: 14px; font-weight: 700; color: #0f172a; margin: 0 0 8px 0; }
  #cl-plpg-{{ sec_id }} .cl-pcard-price { font-size: 15px; font-weight: 900; color: #0f172a; margin-bottom: 6px; }
  #cl-plpg-{{ sec_id }} .cl-pcard-orig { font-size: 12px; text-decoration: line-through; color: #94a3b8; margin-left: 4px; }
  #cl-plpg-{{ sec_id }} .cl-pcard-save { font-size: 10px; font-weight: 800; color: #059669; background: #ecfdf5; padding: 2px 6px; border-radius: 4px; margin-left: 4px; }
  #cl-plpg-{{ sec_id }} .cl-pcard-metal { font-size: 10px; color: #64748b; margin-top: auto; }

  @media (max-width: 990px) { #cl-plpg-{{ sec_id }} .cl-plpg-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { #cl-plpg-{{ sec_id }} .cl-plpg-grid { grid-template-columns: 1fr; } }
</style>

<script>
  function filterPlp(btn, cat) {
    var p = btn.parentElement;
    p.querySelectorAll('.cl-ftag').forEach(function(b) { b.classList.remove('cl-ftag-active'); });
    btn.classList.add('cl-ftag-active');
  }
</script>

{% schema %}
{
  "name": "CaratLane PLP Product Grid",
  "tag": "section",
  "class": "caratlane-plp-grid-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#0f172a" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "CaratLane PLP Product Grid" }
  ]
}
{% endschema %}
