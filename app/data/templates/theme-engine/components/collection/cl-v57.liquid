{% comment %} CL V57 — Automotive (Carbon/Red) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv57 { background: {{ section.settings.bg_color | default: '#0F0F0F' }}; color: {{ section.settings.text_color | default: '#FFFFFF' }}; padding: 40px 20px; font-family: 'Roboto Condensed', sans-serif; text-transform: uppercase; }
  .clv57-hero { text-align: left; margin-bottom: 40px; padding: 50px 40px; background: #1A1A1A; border-left: 10px solid #E63946; position: relative; overflow: hidden; background-image: repeating-linear-gradient(45deg, rgba(255,255,255,0.02) 0, rgba(255,255,255,0.02) 2px, transparent 2px, transparent 8px); }
  .clv57-hero h1 { font-size: 56px; font-weight: 900; margin-bottom: 10px; color: #FFF; font-style: italic; letter-spacing: 1px; }
  .clv57-hero p { font-size: 16px; color: #AAA; max-width: 600px; font-weight: 400; letter-spacing: 1px; }
  .clv57-chips { display: flex; gap: 10px; margin-bottom: 40px; flex-wrap: wrap; }
  .clv57-chips a { padding: 10px 20px; background: #222; color: #FFF; text-decoration: none; font-size: 14px; font-weight: 700; font-style: italic; border: 1px solid #444; transition: 0.2s; }
  .clv57-chips a:hover, .clv57-chips a.active { background: #E63946; border-color: #E63946; }
  .clv57-toolbar { background: #1A1A1A; border: 1px solid #333; padding: 15px 25px; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center; }
  .clv57-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 20px; }
  .clv57-promo { grid-column: span 1; background: #E63946; color: #FFF; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; align-items: center; background-image: repeating-linear-gradient(45deg, rgba(0,0,0,0.1) 0, rgba(0,0,0,0.1) 5px, transparent 5px, transparent 10px); }
  .clv57-promo h3 { font-size: 32px; font-weight: 900; margin-bottom: 15px; font-style: italic; line-height: 1.1; text-shadow: 2px 2px 0 #000; }
  .clv57-promo a { display: inline-block; padding: 10px 20px; background: #000; color: #FFF; text-decoration: none; font-weight: 900; font-size: 14px; font-style: italic; transition: 0.2s; }
  .clv57-promo a:hover { background: #FFF; color: #E63946; }
  .clv57-seo { margin-top: 60px; background: #1A1A1A; padding: 40px; border-top: 5px solid #E63946; text-align: center; }
  @media (max-width: 768px) { .clv57-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv57-hero h1 { font-size: 40px; } .clv57-hero { padding: 30px 20px; } }
</style>
<div class="clv57" style="max-width: 1300px; margin: 0 auto;">
  <div class="clv57-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}PERFORMANCE PARTS{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Precision engineered for maximum output.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv57-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv57-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 15px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; font-weight: 700; color: #E63946;">{{ filter.label }} [ + ]</summary>
              <div style="position: absolute; background: #1A1A1A; border: 1px solid #333; padding: 20px; z-index: 10; margin-top: 15px; min-width: 200px; box-shadow: 0 5px 15px rgba(0,0,0,0.5);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 14px; color: #FFF;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} style="accent-color: #E63946;">
                    {{ value.label }} <span style="color: #666;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #222; border: 1px solid #444; color: #FFF; padding: 8px 12px; font-size: 14px; font-weight: 700; cursor: pointer; outline: none; text-transform: uppercase; font-style: italic;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv57-grid">
      {% for product in collection.products %}
        {% render 'card-v57', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv57-promo">
            <h3>TRACK<br>DAY<br>DEALS</h3>
            <a href="/collections/clearance">VIEW ALL</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v57', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 40px; text-align: center; font-size: 20px; font-weight: 900; font-style: italic; color: #E63946;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv57-seo">
      <h2 style="font-size: 24px; font-weight: 900; color: #FFF; margin-bottom: 15px; font-style: italic;">{{ section.settings.seo_title | default: 'OEM & AFTERMARKET' }}</h2>
      <p style="font-size: 14px; color: #AAA; max-width: 800px; margin: 0 auto; line-height: 1.5;">{{ section.settings.seo_text | default: 'We stock only the highest quality components. Ensure your vehicle runs at peak performance on the street or track.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V57 — Automotive", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#0F0F0F"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFFFF"}
  ], "presets": [{"name": "CL V57 — Automotive"}]
}
{% endschema %}
