{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ff88'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
  }
  
  .hp9-collections-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp9-collections-header-{{ section_id }} {
    margin-bottom: 50px;
  }
  
  .hp9-collections-title-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 1rem;
    font-weight: 700;
    color: {{ accent_color }};
    margin: 0 0 10px 0;
    letter-spacing: 2px;
  }
  
  .hp9-collections-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -1px;
  }
  
  .hp9-collections-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  
  .hp9-collection-card-{{ section_id }} {
    position: relative;
    height: 450px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 30px;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    background: #111;
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 4px;
  }
  
  .hp9-collection-bg-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    opacity: 0.4;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.3s ease;
    filter: grayscale(80%);
  }
  
  .hp9-collection-card-{{ section_id }}:hover .hp9-collection-bg-{{ section_id }} {
    transform: scale(1.05);
    opacity: 0.7;
    filter: grayscale(0%);
  }
  
  .hp9-collection-overlay-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, #050505 0%, transparent 60%);
    z-index: 2;
  }
  
  .hp9-collection-content-{{ section_id }} {
    position: relative;
    z-index: 3;
    border-left: 2px solid {{ accent_color }};
    padding-left: 15px;
    transform: translateY(20px);
    transition: transform 0.3s ease;
  }
  
  .hp9-collection-card-{{ section_id }}:hover .hp9-collection-content-{{ section_id }} {
    transform: translateY(0);
  }
  
  .hp9-collection-title-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 2rem;
    font-weight: 900;
    margin: 0 0 10px 0;
    text-transform: uppercase;
  }
  
  .hp9-collection-link-text-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 0.85rem;
    color: {{ accent_color }};
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0;
    transition: opacity 0.3s ease 0.1s;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  
  .hp9-collection-card-{{ section_id }}:hover .hp9-collection-link-text-{{ section_id }} {
    opacity: 1;
  }

  @media (max-width: 992px) {
    .hp9-collections-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    .hp9-collections-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }
    .hp9-collection-card-{{ section_id }} {
      height: 300px;
    }
    .hp9-collection-content-{{ section_id }} {
      transform: translateY(0);
    }
    .hp9-collection-link-text-{{ section_id }} {
      opacity: 1;
    }
  }
</style>

<div class="hp9-collections-container-{{ section_id }}">
  <div class="hp9-collections-header-{{ section_id }}">
    <p class="hp9-collections-title-{{ section_id }}">{{ section.settings.subheading | default: '/// CATALOG_INDEX' }}</p>
    <h2 class="hp9-collections-heading-{{ section_id }}">{{ section.settings.heading | default: 'SELECT YOUR PROTOCOL' }}</h2>
  </div>
  
  <div class="hp9-collections-grid-{{ section_id }}">
    {% for block in section.blocks limit: 3 %}
      {% assign collection = collections[block.settings.collection] %}
      <a href="{{ collection.url | default: '#' }}" class="hp9-collection-card-{{ section_id }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ collection.title | default: 'Collection' }}" class="hp9-collection-bg-{{ section_id }}" loading="lazy">
        {% elsif collection.image != blank %}
          <img height="{{ collection.image.height }}" width="{{ collection.image.width }}" src="{{ collection.image | image_url: width: 800 }}" alt="{{ collection.title }}" class="hp9-collection-bg-{{ section_id }}" loading="lazy">
        {% else %}
          <div class="hp9-collection-bg-{{ section_id }}" style="background: #222;"></div>
        {% endif %}
        
        <div class="hp9-collection-overlay-{{ section_id }}"></div>
        
        <div class="hp9-collection-content-{{ section_id }}">
          <h3 class="hp9-collection-title-{{ section_id }}">{{ block.settings.title | default: collection.title | default: 'SYSTEM_PART' }}</h3>
          <span class="hp9-collection-link-text-{{ section_id }}">ACCESS_NOW <span>_></span></span>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP9 Collection List",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ff88"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "/// CATALOG_INDEX"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SELECT YOUR PROTOCOL"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP9 Collection List",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
