{% comment %} CL V27 — Gothic / Alternative (Black & Crimson) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv27 { background: {{ section.settings.bg_color | default: '#090909' }}; color: {{ section.settings.text_color | default: '#E5E5E5' }}; padding: 60px 20px; font-family: 'Cinzel', serif; }
  .clv27-hero { text-align: center; margin-bottom: 50px; border: 1px solid #8B0000; padding: 60px 40px; background: url('https://cdn.shopify.com/s/files/1/0000/0000/0000/files/grunge-texture.png'); background-color: #111; }
  .clv27-hero h1 { font-size: 50px; font-weight: 700; color: #8B0000; margin-bottom: 15px; letter-spacing: 3px; text-transform: uppercase; }
  .clv27-hero p { font-size: 16px; font-family: 'Helvetica', sans-serif; color: #A0A0A0; max-width: 600px; margin: 0 auto; line-height: 1.6; }
  .clv27-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv27-chips a { padding: 10px 25px; background: #000; color: #E5E5E5; text-decoration: none; font-size: 13px; letter-spacing: 2px; text-transform: uppercase; border: 1px solid #333; transition: 0.3s; }
  .clv27-chips a:hover, .clv27-chips a.active { border-color: #8B0000; color: #8B0000; }
  .clv27-toolbar { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; padding-bottom: 20px; margin-bottom: 40px; font-family: 'Helvetica', sans-serif; }
  .clv27-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 20px; }
  .clv27-promo { grid-column: span 1; background: #000; border: 1px solid #8B0000; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; }
  .clv27-promo h3 { font-size: 28px; color: #8B0000; margin-bottom: 20px; letter-spacing: 1px; }
  .clv27-promo a { display: inline-block; padding: 12px 25px; background: transparent; color: #E5E5E5; border: 1px solid #E5E5E5; font-family: 'Helvetica', sans-serif; text-decoration: none; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; transition: 0.3s; }
  .clv27-promo a:hover { background: #8B0000; border-color: #8B0000; }
  .clv27-seo { margin-top: 60px; text-align: center; padding: 50px; background: #111; border: 1px solid #333; }
  @media (max-width: 768px) { .clv27-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 10px; } }
</style>
<div class="clv27" style="max-width: 1300px; margin: 0 auto;">
  <div class="clv27-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}NOCTURNAL{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Embrace the shadows with our dark aesthetic collection.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv27-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv27-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: 2px; color: #A0A0A0;">{{ filter.label }} ☩</summary>
              <div style="position: absolute; background: #000; border: 1px solid #333; padding: 25px; z-index: 10; margin-top: 15px; min-width: 220px; box-shadow: 0 10px 30px rgba(0,0,0,0.8);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 13px; color: #E5E5E5;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #000; border: 1px solid #333; color: #A0A0A0; padding: 10px 15px; font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv27-grid">
      {% for product in collection.products %}
        {% render 'card-v27', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv27-promo">
            <h3>Cursed<br>Items</h3>
            <a href="/collections/limited">View Relics</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v27', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; font-family: 'Helvetica', sans-serif; font-size: 14px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv27-seo">
      <h2 style="font-size: 26px; font-weight: 700; color: #8B0000; margin-bottom: 15px; letter-spacing: 2px;">{{ section.settings.seo_title | default: 'FOR THE WICKED' }}</h2>
      <p style="font-family: 'Helvetica', sans-serif; font-size: 14px; color: #A0A0A0; max-width: 650px; margin: 0 auto; line-height: 1.6;">{{ section.settings.seo_text | default: 'Distressed fabrics, heavy hardware, and uncompromising silhouettes.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V27 — Alternative", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#090909"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#E5E5E5"}
  ], "presets": [{"name": "CL V27 — Alternative"}]
}
{% endschema %}
