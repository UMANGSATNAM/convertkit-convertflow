{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Lora', serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp35-pills-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp35-pills-wrapper {
      padding: 0 20px;
    }
  }

  .hp35-pills__list {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
  }

  .hp35-pills__item {
    font-family: var(--font-heading);
    font-size: 18px;
    color: var(--text-color);
    text-decoration: none;
    font-style: italic;
    padding: 15px 40px;
    background: transparent;
    border: 1px solid var(--text-color);
    border-radius: 50px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hp35-pills__item:hover {
    background: var(--text-color);
    color: var(--bg-color);
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp35-pills-wrapper" id="HP35Pills-{{ section.id }}">
  <div class="hp35-pills__list">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp35-pills__item" {{ block.shopify_attributes }}>
        {{ block.settings.title }}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP35 - Organic Pills",
  "class": "section-hp35-category-pills",
  "settings": [
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text/Border Color",
      "default": "#2C422F"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Tag",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Earthenware"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP35 - Organic Pills",
      "blocks": [
        { "type": "tag", "settings": { "title": "Ceramics" } },
        { "type": "tag", "settings": { "title": "Linens" } },
        { "type": "tag", "settings": { "title": "Apothecary" } },
        { "type": "tag", "settings": { "title": "Living" } }
      ]
    }
  ]
}
{% endschema %}
