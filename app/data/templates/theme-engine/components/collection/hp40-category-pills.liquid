{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    border-bottom: 2px solid var(--text-color);
  }

  .hp40-cat-wrapper {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  @media screen and (max-width: 992px) {
    .hp40-cat-wrapper {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media screen and (max-width: 600px) {
    .hp40-cat-wrapper {
      grid-template-columns: 1fr;
    }
  }

  .hp40-cat__item {
    padding: 60px 40px;
    border-right: 2px solid var(--text-color);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    position: relative;
    transition: background 0.3s ease, color 0.3s ease;
    min-height: 200px;
    background: var(--bg-color);
  }

  .hp40-cat__item:last-child {
    border-right: none;
  }
  
  @media screen and (max-width: 992px) {
    .hp40-cat__item:nth-child(even) {
      border-right: none;
    }
    .hp40-cat__item:nth-last-child(-n+2) {
      border-bottom: none;
    }
    .hp40-cat__item {
      border-bottom: 2px solid var(--text-color);
    }
  }
  @media screen and (max-width: 600px) {
    .hp40-cat__item {
      border-right: none !important;
    }
    .hp40-cat__item:last-child {
      border-bottom: none;
    }
  }

  .hp40-cat__item:hover {
    background: var(--accent-color);
  }

  .hp40-cat__item:hover .hp40-cat__title {
    color: var(--text-color); /* Usually black on yellow/red/blue looks great in Swiss */
  }

  .hp40-cat__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: -1px;
    margin: 0;
    transition: color 0.3s ease;
  }
  
  .hp40-cat__index {
    position: absolute;
    top: 20px;
    left: 20px;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp40-cat-wrapper" id="HP40Categories-{{ section.id }}">
  {%- for block in section.blocks -%}
    <a href="{{ block.settings.link | default: '#' }}" class="hp40-cat__item" {{ block.shopify_attributes }}>
      <span class="hp40-cat__index">0{{ forloop.index }}</span>
      <h3 class="hp40-cat__title">{{ block.settings.title }}</h3>
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP40 - Swiss Categories",
  "class": "section-hp40-category-pills",
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Swiss Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Lines",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Hover Accent Color",
      "default": "#0055FF"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Block",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "CATEGORY"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP40 - Swiss Categories",
      "blocks": [
        { "type": "category", "settings": { "title": "EDITION 01" } },
        { "type": "category", "settings": { "title": "EDITION 02" } },
        { "type": "category", "settings": { "title": "ARCHIVE" } },
        { "type": "category", "settings": { "title": "INDEX" } }
      ]
    }
  ]
}
{% endschema %}
