{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
-%}

<section class="hp1-beauty-tiles" style="background-color: {{ bg_color }}; color: {{ text_color }};" id="hp1-category-tiles-{{ section.id }}">
  <div class="hp1-tiles-inner">
    
    {%- if section.settings.heading != blank -%}
      <div class="hp1-section-header">
        <h2 class="hp1-section-heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="hp1-tiles-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="hp1-tile-item hp1-tile-{{ block.type }}" {{ block.shopify_attributes }}>
          <div class="hp1-tile-image-wrapper">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" 
                   alt="{{ block.settings.title | escape }}" 
                   width="800" height="800" 
                   class="hp1-tile-img" loading="lazy">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'hp1-tile-img placeholder-svg' }}
            {%- endif -%}
            <div class="hp1-tile-overlay"></div>
          </div>
          <div class="hp1-tile-content">
            <h3 class="hp1-tile-title">{{ block.settings.title }}</h3>
            {%- if block.settings.button_text != blank -%}
              <span class="hp1-tile-btn">{{ block.settings.button_text }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
  .hp1-beauty-tiles {
    padding: 60px 0;
    font-family: 'Inter', sans-serif;
  }
  .hp1-tiles-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .hp1-section-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .hp1-section-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 400;
    margin: 0;
  }
  .hp1-tiles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .hp1-tile-item {
    position: relative;
    display: block;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: {{ text_color }};
    aspect-ratio: 4 / 5;
  }
  .hp1-tile-item.hp1-tile-large {
    grid-column: span 2;
    aspect-ratio: 16 / 9;
  }
  .hp1-tile-image-wrapper {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 1;
    overflow: hidden;
  }
  .hp1-tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  .hp1-tile-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 50%);
    z-index: 2;
    transition: background 0.4s ease;
  }
  .hp1-tile-item:hover .hp1-tile-img {
    transform: scale(1.05);
  }
  .hp1-tile-item:hover .hp1-tile-overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.1) 50%);
  }
  .hp1-tile-content {
    position: relative;
    z-index: 3;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    padding: 30px;
    text-align: center;
    color: #fff;
  }
  .hp1-tile-title {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    font-weight: 400;
    margin: 0 0 10px;
    letter-spacing: 1px;
  }
  .hp1-tile-btn {
    display: inline-block;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-bottom: 1px solid #fff;
    padding-bottom: 2px;
    transition: opacity 0.3s ease;
  }
  .hp1-tile-item:hover .hp1-tile-btn {
    opacity: 0.8;
  }

  @media (max-width: 991px) {
    .hp1-tiles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .hp1-tile-item.hp1-tile-large {
      grid-column: span 2;
      aspect-ratio: 2 / 1;
    }
  }
  @media (max-width: 767px) {
    .hp1-tiles-grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      scroll-snap-type: x mandatory;
      padding-bottom: 20px;
    }
    .hp1-tiles-grid::-webkit-scrollbar {
      display: none;
    }
    .hp1-tile-item {
      flex: 0 0 80%;
      scroll-snap-align: center;
    }
    .hp1-tile-item.hp1-tile-large {
      flex: 0 0 80%;
      aspect-ratio: 4 / 5;
    }
  }
</style>

{% schema %}
{
  "name": "HP1 Category Tiles",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    }
  ],
  "blocks": [
    {
      "type": "regular",
      "name": "Regular Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Category Name", "default": "Face Care" },
        { "type": "text", "id": "button_text", "label": "Button Text", "default": "Shop Now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "large",
      "name": "Large Tile (2 Columns)",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Category Name", "default": "Body Care Essentials" },
        { "type": "text", "id": "button_text", "label": "Button Text", "default": "Discover" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP1 Category Tiles",
      "blocks": [
        { "type": "large" },
        { "type": "regular" },
        { "type": "regular" },
        { "type": "regular" }
      ]
    }
  ]
}
{% endschema %}
