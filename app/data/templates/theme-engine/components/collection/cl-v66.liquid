{% comment %} CL V66 — Music / Vinyl (Black/Cream) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv66 { background: {{ section.settings.bg_color | default: '#111111' }}; color: {{ section.settings.text_color | default: '#FDFBF7' }}; padding: 50px 20px; font-family: 'Courier New', Courier, monospace; }
  .clv66-hero { text-align: center; margin-bottom: 50px; padding: 60px 20px; background: #000; border: 1px solid #333; position: relative; overflow: hidden; border-radius: 50%; width: 100%; max-width: 800px; margin-left: auto; margin-right: auto; aspect-ratio: 1/1; display: flex; flex-direction: column; justify-content: center; box-shadow: 0 0 50px rgba(0,0,0,0.8); }
  .clv66-hero::before { content: ''; position: absolute; top: 10%; left: 10%; right: 10%; bottom: 10%; border: 1px solid #333; border-radius: 50%; pointer-events: none; }
  .clv66-hero::after { content: ''; position: absolute; top: 20%; left: 20%; right: 20%; bottom: 20%; border: 1px solid #333; border-radius: 50%; pointer-events: none; }
  .clv66-hero-inner { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: #D22B2B; width: 30%; height: 30%; border-radius: 50%; z-index: 0; }
  .clv66-hero-center { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: #111; width: 20px; height: 20px; border-radius: 50%; z-index: 1; border: 2px solid #FFF; }
  .clv66-hero h1 { font-size: 42px; font-weight: bold; color: #FFF; margin-bottom: 10px; position: relative; z-index: 2; letter-spacing: 2px; }
  .clv66-hero p { font-size: 14px; color: #FFF; max-width: 400px; margin: 0 auto; position: relative; z-index: 2; line-height: 1.5; }
  .clv66-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv66-chips a { padding: 8px 20px; background: transparent; color: #FDFBF7; text-decoration: none; font-size: 14px; border: 1px solid #FDFBF7; border-radius: 20px; transition: 0.3s; }
  .clv66-chips a:hover, .clv66-chips a.active { background: #FDFBF7; color: #111; }
  .clv66-toolbar { background: #000; border: 1px solid #333; padding: 15px 25px; margin-bottom: 40px; display: flex; justify-content: space-between; align-items: center; border-radius: 4px; }
  .clv66-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 30px; }
  .clv66-promo { grid-column: span 1; background: #FDFBF7; color: #111; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; align-items: center; border: 1px solid #333; }
  .clv66-promo h3 { font-size: 28px; font-weight: bold; margin-bottom: 20px; letter-spacing: 1px; }
  .clv66-promo a { display: inline-block; padding: 10px 25px; background: #111; color: #FDFBF7; text-decoration: none; font-size: 14px; border-radius: 4px; transition: 0.3s; border: 1px solid #111; }
  .clv66-promo a:hover { background: transparent; color: #111; }
  .clv66-seo { margin-top: 60px; text-align: center; padding: 40px; border-top: 1px solid #333; border-bottom: 1px solid #333; }
  @media (max-width: 768px) { .clv66-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv66-hero { aspect-ratio: auto; border-radius: 10px; width: auto; max-width: none; padding: 40px 20px; } .clv66-hero::before, .clv66-hero::after, .clv66-hero-inner, .clv66-hero-center { display: none; } .clv66-hero h1 { font-size: 32px; } }
</style>
<div class="clv66" style="max-width: 1300px; margin: 0 auto;">
  <div class="clv66-hero">
    <div class="clv66-hero-inner"></div>
    <div class="clv66-hero-center"></div>
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}THE RECORD SHOP{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Analog sound for a digital world.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv66-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv66-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 25px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; font-weight: bold; color: #FDFBF7;">{{ filter.label }} [+]</summary>
              <div style="position: absolute; background: #000; border: 1px solid #333; padding: 20px; z-index: 10; margin-top: 15px; min-width: 220px; box-shadow: 0 5px 15px rgba(0,0,0,0.5);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 14px; color: #FDFBF7;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} style="accent-color: #D22B2B;">
                    {{ value.label }} <span style="opacity: 0.5;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-family: inherit; font-size: 14px; font-weight: bold; color: #FDFBF7; cursor: pointer; outline: none;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv66-grid">
      {% for product in collection.products %}
        {% render 'card-v66', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv66-promo">
            <h3>TURNTABLE<br>ACCESSORIES</h3>
            <a href="/collections/hardware">UPGRADE</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v66', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; font-size: 18px; font-weight: bold; color: #FDFBF7;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv66-seo">
      <h2 style="font-size: 24px; font-weight: bold; color: #FDFBF7; margin-bottom: 15px; letter-spacing: 1px;">{{ section.settings.seo_title | default: 'MINT CONDITION' }}</h2>
      <p style="font-size: 14px; color: #AAA; max-width: 600px; margin: 0 auto; line-height: 1.6;">{{ section.settings.seo_text | default: 'All pre-owned records are ultrasonically cleaned, play-graded, and guaranteed to sound as good as they look.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V66 — Music", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#111111"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#FDFBF7"}
  ], "presets": [{"name": "CL V66 — Music"}]
}
{% endschema %}
