{%- style -%}#shopify-section-{{ section.id }}{background:{{ section.settings.bg_color | default: '#fff' }};padding:24px 0}.hp65-pills{max-width:1280px;margin:0 auto;padding:0 24px;display:flex;gap:12px;overflow-x:auto;scrollbar-width:none}.hp65-pills::-webkit-scrollbar{display:none}.hp65-pill{flex:0 0 auto;padding:10px 18px;border-radius:999px;background:#fff;border:1px solid rgba(0,0,0,.1);font-size:13px;font-weight:600;text-decoration:none;color:inherit;white-space:nowrap} .hp65-pill--active{background:#E11D48;color:#fff;border-color:#E11D48}{%- endstyle -%}<div class="hp65-pills">{% for block in section.blocks %}<a href="{{ block.settings.url }}" class="hp65-pill">{{ block.settings.label }}</a>{% else %}{% for cat in collections limit:6 %}<a href="{{ cat.url }}" class="hp65-pill">{{ cat.title }}</a>{% endfor %}{% endfor %}</div>{% schema %}
{
  "name": "HP65 Pills",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "BG",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "All"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP65 Pills"
    }
  ]
}
{% endschema %}