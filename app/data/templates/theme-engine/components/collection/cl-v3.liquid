{% comment %} CL V3 — Soft Pastel Beauty {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv3 { background: {{ section.settings.bg_color | default: '#FFF0F5' }}; color: {{ section.settings.text_color | default: '#5C4033' }}; padding: 50px 20px; font-family: 'Georgia', serif; }
  .clv3-hero { text-align: center; margin-bottom: 50px; }
  .clv3-hero h1 { font-size: 42px; font-style: italic; margin-bottom: 15px; color: #8B5A2B; }
  .clv3-hero p { font-size: 16px; font-family: sans-serif; color: #8B7D6B; max-width: 600px; margin: 0 auto; line-height: 1.6; }
  .clv3-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv3-chips a { padding: 10px 25px; background: #FFE4E1; color: #8B5A2B; border-radius: 30px; text-decoration: none; font-family: sans-serif; font-size: 13px; font-weight: 500; transition: 0.3s; }
  .clv3-chips a:hover { background: #FFB6C1; }
  .clv3-toolbar { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #FFC0CB; border-bottom: 1px solid #FFC0CB; padding: 20px 0; margin-bottom: 40px; font-family: sans-serif; }
  .clv3-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 25px; }
  .clv3-promo { grid-column: span 1; background: #FFF; border: 2px dashed #FFB6C1; border-radius: 12px; padding: 30px; text-align: center; display: flex; flex-direction: column; justify-content: center; }
  .clv3-promo h3 { font-size: 24px; font-style: italic; color: #8B5A2B; margin-bottom: 15px; }
  .clv3-promo a { display: inline-block; padding: 10px 20px; background: #8B5A2B; color: #FFF; border-radius: 20px; text-decoration: none; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; }
  .clv3-seo { margin-top: 60px; text-align: center; background: #FFF; padding: 40px; border-radius: 12px; }
  @media (max-width: 768px) { .clv3-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } }
</style>
<div class="clv3" style="max-width: 1200px; margin: 0 auto;">
  <div class="clv3-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Skincare Essentials{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Nurture your skin with our gentle, plant-based formulas.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv3-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv3-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; width: 100%; align-items: center; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 13px; font-weight: 500; color: #8B5A2B;">{{ filter.label }} ▾</summary>
              <div style="position: absolute; background: #FFF; border: 1px solid #FFC0CB; border-radius: 8px; padding: 20px; z-index: 10; margin-top: 15px; min-width: 220px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 10px; cursor: pointer; font-size: 13px; color: #8B7D6B;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-size: 13px; color: #8B5A2B; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv3-grid">
      {% for product in collection.products %}
        {% render 'card-v3', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv3-promo">
            <span style="font-family: sans-serif; font-size: 11px; color: #FF69B4; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px;">Glow Up</span>
            <h3>Free Sample With Every Order</h3>
            <a href="/collections/all">Shop Collection</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v3', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; font-family: sans-serif;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv3-seo">
      <h2 style="font-size: 26px; font-style: italic; color: #8B5A2B; margin-bottom: 15px;">{{ section.settings.seo_title | default: 'Radiance in Every Bottle' }}</h2>
      <p style="font-family: sans-serif; font-size: 14px; color: #8B7D6B; max-width: 700px; margin: 0 auto; line-height: 1.7;">{{ section.settings.seo_text | default: 'Our skincare range is meticulously crafted with natural ingredients to reveal your inner glow.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V3 — Beauty", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#FFF0F5"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#5C4033"}
  ], "presets": [{"name": "CL V3 — Beauty"}]
}
{% endschema %}
