{% comment %} CL V14 — Organic Skincare (Rounded/Soft) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv14 { background: {{ section.settings.bg_color | default: '#F9F6F0' }}; color: {{ section.settings.text_color | default: '#5C6B52' }}; padding: 60px 20px; font-family: 'Lato', sans-serif; }
  .clv14-hero { text-align: center; margin-bottom: 50px; background: #E9E1D3; padding: 60px 40px; border-radius: 40px; }
  .clv14-hero h1 { font-size: 38px; font-weight: 400; color: #4A5642; margin-bottom: 15px; }
  .clv14-hero p { font-size: 16px; color: #6D7E62; max-width: 600px; margin: 0 auto; line-height: 1.6; }
  .clv14-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv14-chips a { padding: 12px 24px; background: #FFFFFF; color: #5C6B52; text-decoration: none; border-radius: 30px; font-size: 14px; transition: 0.3s; box-shadow: 0 4px 10px rgba(0,0,0,0.03); }
  .clv14-chips a:hover, .clv14-chips a.active { background: #5C6B52; color: #FFF; }
  .clv14-toolbar { background: #FFF; border-radius: 30px; padding: 15px 30px; margin-bottom: 40px; box-shadow: 0 4px 15px rgba(0,0,0,0.02); }
  .clv14-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 30px; }
  .clv14-promo { grid-column: span 1; background: #E4ECDF; border-radius: 30px; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; color: #4A5642; }
  .clv14-promo h3 { font-size: 24px; font-weight: 400; margin-bottom: 20px; }
  .clv14-promo a { display: inline-block; padding: 14px 28px; background: #5C6B52; color: #FFF; border-radius: 30px; text-decoration: none; font-size: 13px; font-weight: 700; letter-spacing: 1px; }
  .clv14-seo { margin-top: 70px; background: #FFFFFF; border-radius: 30px; padding: 50px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.03); }
  @media (max-width: 768px) { .clv14-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 20px; } }
</style>
<div class="clv14" style="max-width: 1200px; margin: 0 auto;">
  <div class="clv14-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Pure Earth{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Natural ingredients for healthy, glowing skin.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv14-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv14-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; font-weight: 600;">{{ filter.label }} 🌿</summary>
              <div style="position: absolute; background: #FFF; padding: 25px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); z-index: 10; min-width: 220px; margin-top: 15px;">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 14px; color: #6D7E62;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #F9F6F0; border: none; padding: 10px 20px; border-radius: 20px; color: #5C6B52; font-weight: 600; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv14-grid">
      {% for product in collection.products %}
        {% render 'card-v14', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv14-promo">
            <span style="font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 10px;">Self Care</span>
            <h3>Build Your Routine</h3>
            <a href="/pages/routine-builder">Start Now</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v14', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv14-seo">
      <h2 style="font-size: 26px; font-weight: 400; color: #4A5642; margin-bottom: 20px;">{{ section.settings.seo_title | default: 'Rooted in Nature' }}</h2>
      <p style="color: #6D7E62; line-height: 1.8; max-width: 750px; margin: 0 auto; font-size: 15px;">{{ section.settings.seo_text | default: 'All our formulas are cruelty-free, vegan, and packed with botanical extracts to nourish your skin.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V14 — Organic", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#F9F6F0"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#5C6B52"}
  ], "presets": [{"name": "CL V14 — Organic"}]
}
{% endschema %}
