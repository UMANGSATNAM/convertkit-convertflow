{% comment %} CL V24 — Gamer / Esports {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv24 { background: {{ section.settings.bg_color | default: '#0B0B0E' }}; color: {{ section.settings.text_color | default: '#B548C6' }}; padding: 40px 20px; font-family: 'Orbitron', sans-serif; }
  .clv24-hero { background: #13131A; border: 2px solid #B548C6; border-radius: 8px; padding: 50px; text-align: center; margin-bottom: 40px; box-shadow: 0 0 20px rgba(181,72,198,0.2); }
  .clv24-hero h1 { font-size: 50px; font-weight: 900; color: #FFF; margin-bottom: 10px; text-transform: uppercase; text-shadow: 2px 2px 0px #B548C6; }
  .clv24-hero p { font-size: 16px; color: #8A8A93; font-family: 'Inter', sans-serif; max-width: 500px; margin: 0 auto; line-height: 1.5; }
  .clv24-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv24-chips a { padding: 10px 20px; background: #13131A; color: #B548C6; border: 1px solid #B548C6; font-size: 14px; text-decoration: none; text-transform: uppercase; font-weight: bold; transition: 0.2s; border-radius: 4px; }
  .clv24-chips a:hover, .clv24-chips a.active { background: #B548C6; color: #FFF; box-shadow: 0 0 10px #B548C6; }
  .clv24-toolbar { display: flex; justify-content: space-between; align-items: center; background: #13131A; padding: 20px; border-radius: 8px; margin-bottom: 30px; font-family: 'Inter', sans-serif; }
  .clv24-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 20px; }
  .clv24-promo { grid-column: span 1; background: #39FF14; color: #0B0B0E; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; border-radius: 8px; box-shadow: 0 0 20px rgba(57,255,20,0.3); }
  .clv24-promo h3 { font-size: 28px; font-weight: 900; margin-bottom: 15px; text-transform: uppercase; line-height: 1.2; }
  .clv24-promo a { display: inline-block; padding: 12px 24px; background: #0B0B0E; color: #39FF14; text-decoration: none; font-weight: bold; text-transform: uppercase; border-radius: 4px; }
  .clv24-seo { margin-top: 50px; background: #13131A; padding: 40px; border-radius: 8px; text-align: center; border: 1px solid #2C2C35; }
  @media (max-width: 768px) { .clv24-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv24-hero h1 { font-size: 38px; } }
</style>
<div class="clv24" style="max-width: 1400px; margin: 0 auto;">
  <div class="clv24-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}GEAR UP{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Elite peripherals for elite players. Level up your setup.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv24-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv24-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; font-weight: 600; color: #FFF; text-transform: uppercase; font-family: 'Orbitron', sans-serif;">{{ filter.label }} ⏷</summary>
              <div style="position: absolute; background: #13131A; border: 1px solid #2C2C35; padding: 20px; border-radius: 8px; z-index: 10; margin-top: 15px; min-width: 220px; box-shadow: 0 10px 20px rgba(0,0,0,0.5);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 14px; color: #8A8A93;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #0B0B0E; border: 1px solid #2C2C35; color: #FFF; padding: 10px 15px; border-radius: 4px; font-size: 14px; font-family: 'Inter', sans-serif; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv24-grid">
      {% for product in collection.products %}
        {% render 'card-v24', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv24-promo">
            <h3>PRO<br>MEMBERS</h3>
            <a href="/pages/esports-club">JOIN CLUB</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v24', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 40px; text-align: center; color: #39FF14; font-size: 18px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv24-seo">
      <h2 style="font-size: 26px; font-weight: 900; color: #FFF; margin-bottom: 10px; text-transform: uppercase;">{{ section.settings.seo_title | default: 'Zero Latency. Total Control.' }}</h2>
      <p style="font-size: 15px; font-family: 'Inter', sans-serif; color: #8A8A93; max-width: 700px; margin: 0 auto; line-height: 1.6;">{{ section.settings.seo_text | default: 'Tested by pros, built for gamers. We provide the hardware you need to dominate the leaderboards.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V24 — Gamer", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#0B0B0E"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#B548C6"}
  ], "presets": [{"name": "CL V24 — Gamer"}]
}
{% endschema %}
