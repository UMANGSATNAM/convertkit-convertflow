{% comment %} CL V20 — Vintage Thrift / Sepia {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv20 { background: {{ section.settings.bg_color | default: '#F5F1E7' }}; color: {{ section.settings.text_color | default: '#3E3124' }}; padding: 60px 20px; font-family: 'Courier New', Courier, monospace; }
  .clv20-hero { text-align: center; margin-bottom: 50px; border: 2px dashed #B8A89A; padding: 40px; background: rgba(255,255,255,0.4); }
  .clv20-hero h1 { font-size: 38px; font-weight: bold; margin-bottom: 15px; letter-spacing: 2px; }
  .clv20-hero p { font-size: 15px; max-width: 600px; margin: 0 auto; line-height: 1.6; }
  .clv20-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv20-chips a { padding: 8px 20px; background: #E9E1D3; color: #3E3124; text-decoration: none; font-size: 14px; font-weight: bold; border: 1px solid #B8A89A; transition: 0.2s; }
  .clv20-chips a:hover, .clv20-chips a.active { background: #3E3124; color: #F5F1E7; }
  .clv20-toolbar { display: flex; justify-content: space-between; align-items: center; border-top: 2px solid #3E3124; border-bottom: 2px solid #3E3124; padding: 15px 0; margin-bottom: 40px; }
  .clv20-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 25px; }
  .clv20-promo { grid-column: span 1; background: #3E3124; color: #F5F1E7; border: 4px double #B8A89A; padding: 30px; text-align: center; display: flex; flex-direction: column; justify-content: center; }
  .clv20-promo h3 { font-size: 22px; margin-bottom: 15px; text-transform: uppercase; letter-spacing: 2px; }
  .clv20-promo a { display: inline-block; padding: 10px 25px; background: #F5F1E7; color: #3E3124; text-decoration: none; font-weight: bold; border: 1px solid #3E3124; font-size: 13px; text-transform: uppercase; }
  .clv20-seo { margin-top: 60px; text-align: center; padding: 40px; border: 1px solid #B8A89A; background: rgba(255,255,255,0.3); }
  @media (max-width: 768px) { .clv20-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } }
</style>
<div class="clv20" style="max-width: 1200px; margin: 0 auto;">
  <div class="clv20-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}The Archive{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Curated vintage pieces, each with its own story to tell.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv20-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv20-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">{{ filter.label }} ▾</summary>
              <div style="position: absolute; background: #F5F1E7; border: 1px solid #3E3124; padding: 20px; z-index: 10; margin-top: 15px; min-width: 220px; box-shadow: 4px 4px 0 rgba(62,49,36,0.2);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 10px; cursor: pointer; font-size: 14px;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-size: 14px; font-weight: bold; font-family: 'Courier New', Courier, monospace; cursor: pointer; text-transform: uppercase;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv20-grid">
      {% for product in collection.products %}
        {% render 'card-v20', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv20-promo">
            <span style="font-size: 11px; letter-spacing: 2px; margin-bottom: 10px; display: block;">Rare Finds</span>
            <h3>Designer<br>Vault</h3>
            <a href="/collections/designer">Shop Vault</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v20', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; font-weight: bold;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv20-seo">
      <h2 style="font-size: 24px; font-weight: bold; margin-bottom: 15px; letter-spacing: 1px;">{{ section.settings.seo_title | default: 'History in Your Hands' }}</h2>
      <p style="font-size: 14px; line-height: 1.6; max-width: 700px; margin: 0 auto;">{{ section.settings.seo_text | default: 'We scour the globe for the finest vintage garments, ensuring each piece meets our strict standards for quality and authenticity.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V20 — Vintage", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F1E7"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#3E3124"}
  ], "presets": [{"name": "CL V20 — Vintage"}]
}
{% endschema %}
