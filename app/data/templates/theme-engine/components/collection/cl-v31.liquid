{% comment %} CL V31 — Y2K Nostalgia (Silver/Pink) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv31 { background: {{ section.settings.bg_color | default: '#E2E8F0' }}; color: {{ section.settings.text_color | default: '#1E293B' }}; padding: 40px 20px; font-family: 'Verdana', sans-serif; }
  .clv31-hero { text-align: center; margin-bottom: 50px; background: linear-gradient(135deg, #F8FAFC 0%, #CBD5E1 100%); padding: 50px; border-radius: 20px; box-shadow: inset 0 0 10px #FFF, 0 10px 20px rgba(0,0,0,0.05); border: 1px solid #FFF; }
  .clv31-hero h1 { font-size: 44px; font-weight: 700; color: #EC4899; margin-bottom: 10px; text-shadow: 2px 2px 0 #FFF, 4px 4px 0 #CBD5E1; letter-spacing: -1px; }
  .clv31-hero p { font-size: 14px; color: #64748B; max-width: 500px; margin: 0 auto; line-height: 1.5; font-weight: bold; }
  .clv31-chips { display: flex; gap: 10px; justify-content: center; margin-bottom: 30px; flex-wrap: wrap; }
  .clv31-chips a { padding: 10px 20px; background: #FFF; color: #EC4899; text-decoration: none; font-size: 13px; font-weight: bold; border-radius: 30px; border: 2px solid #EC4899; transition: 0.2s; box-shadow: 0 4px 0 #EC4899; }
  .clv31-chips a:hover, .clv31-chips a.active { background: #EC4899; color: #FFF; transform: translateY(2px); box-shadow: 0 2px 0 #EC4899; }
  .clv31-toolbar { background: #FFF; border-radius: 20px; padding: 15px 25px; margin-bottom: 40px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); border: 1px solid #E2E8F0; }
  .clv31-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 20px; }
  .clv31-promo { grid-column: span 1; background: #EC4899; color: #FFF; border-radius: 20px; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; box-shadow: inset 0 0 10px rgba(255,255,255,0.5); border: 2px solid #FFF; }
  .clv31-promo h3 { font-size: 24px; font-weight: 700; margin-bottom: 15px; }
  .clv31-promo a { display: inline-block; padding: 10px 20px; background: #FFF; color: #EC4899; text-decoration: none; font-weight: bold; border-radius: 20px; font-size: 13px; }
  .clv31-seo { margin-top: 50px; background: #FFF; padding: 40px; border-radius: 20px; text-align: center; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
  @media (max-width: 768px) { .clv31-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv31-hero h1 { font-size: 34px; } }
</style>
<div class="clv31" style="max-width: 1200px; margin: 0 auto;">
  <div class="clv31-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Y2K VIBES{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Shiny, metallic, and perfectly pink. Welcome to the new millennium.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv31-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv31-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 15px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 13px; font-weight: bold; color: #1E293B; text-transform: uppercase;">{{ filter.label }} ✨</summary>
              <div style="position: absolute; background: #FFF; padding: 20px; border-radius: 15px; z-index: 10; margin-top: 15px; min-width: 200px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); border: 1px solid #E2E8F0;">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 10px; cursor: pointer; font-size: 13px; color: #475569;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #F8FAFC; border: 1px solid #E2E8F0; padding: 8px 16px; border-radius: 20px; font-size: 13px; font-weight: bold; color: #1E293B; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv31-grid">
      {% for product in collection.products %}
        {% render 'card-v31', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv31-promo">
            <h3>Flip<br>Phones &<br>Fashion</h3>
            <a href="/pages/y2k-lookbook">Lookbook</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v31', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 40px; text-align: center; font-weight: bold;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv31-seo">
      <h2 style="font-size: 22px; font-weight: 700; color: #EC4899; margin-bottom: 10px;">{{ section.settings.seo_title | default: "That's Hot" }}</h2>
      <p style="font-size: 13px; color: #64748B; max-width: 600px; margin: 0 auto; line-height: 1.6;">{{ section.settings.seo_text | default: 'From low-rise jeans to frosted lip gloss, the early 2000s are back and better than ever.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V31 — Y2K", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#E2E8F0"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#1E293B"}
  ], "presets": [{"name": "CL V31 — Y2K"}]
}
{% endschema %}
