{% comment %} CL V63 — Tech / Gadgets (Silicon Valley Blue) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv63 { background: {{ section.settings.bg_color | default: '#FAFAFA' }}; color: {{ section.settings.text_color | default: '#1A1A24' }}; padding: 40px 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
  .clv63-hero { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; padding: 40px 60px; background: #FFF; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.03); border: 1px solid #EAEAEA; }
  .clv63-hero-content { max-width: 60%; }
  .clv63-hero h1 { font-size: 42px; font-weight: 600; color: #1A1A24; margin-bottom: 10px; letter-spacing: -1px; }
  .clv63-hero p { font-size: 18px; color: #666; margin: 0; line-height: 1.5; }
  .clv63-chips { display: flex; gap: 10px; margin-bottom: 30px; overflow-x: auto; padding-bottom: 10px; }
  .clv63-chips::-webkit-scrollbar { height: 4px; }
  .clv63-chips::-webkit-scrollbar-thumb { background: #CCC; border-radius: 4px; }
  .clv63-chips a { padding: 8px 16px; background: #FFF; color: #1A1A24; text-decoration: none; font-size: 14px; font-weight: 500; border-radius: 8px; border: 1px solid #EAEAEA; white-space: nowrap; transition: 0.2s; }
  .clv63-chips a:hover, .clv63-chips a.active { background: #0055FF; color: #FFF; border-color: #0055FF; }
  .clv63-toolbar { background: transparent; padding: 10px 0; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center; }
  .clv63-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 24px; }
  .clv63-promo { grid-column: span 1; background: #0055FF; color: #FFF; border-radius: 12px; padding: 30px; display: flex; flex-direction: column; justify-content: center; box-shadow: 0 15px 30px rgba(0,85,255,0.2); }
  .clv63-promo h3 { font-size: 24px; font-weight: 600; margin-bottom: 15px; letter-spacing: -0.5px; }
  .clv63-promo a { display: inline-block; padding: 10px 20px; background: #FFF; color: #0055FF; text-decoration: none; font-size: 14px; font-weight: 600; border-radius: 6px; width: fit-content; }
  .clv63-seo { margin-top: 60px; background: #FFF; padding: 40px; border-radius: 16px; text-align: center; border: 1px solid #EAEAEA; }
  @media (max-width: 768px) { .clv63-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 16px; } .clv63-hero { flex-direction: column; text-align: center; padding: 30px 20px; } .clv63-hero-content { max-width: 100%; } .clv63-hero h1 { font-size: 32px; } }
</style>
<div class="clv63" style="max-width: 1400px; margin: 0 auto;">
  <div class="clv63-hero">
    <div class="clv63-hero-content">
      <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Smart Home{% endif %}</h1>
      <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Connect your world with the latest intelligent devices.{% endif %}</p>
    </div>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv63-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv63-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 15px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; font-weight: 500; color: #1A1A24; padding: 8px 16px; background: #FFF; border: 1px solid #EAEAEA; border-radius: 8px;">{{ filter.label }} ⌄</summary>
              <div style="position: absolute; background: #FFF; border: 1px solid #EAEAEA; padding: 15px; border-radius: 12px; z-index: 10; margin-top: 5px; min-width: 200px; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 10px; cursor: pointer; font-size: 14px; color: #666;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} style="accent-color: #0055FF;">
                    {{ value.label }} <span style="font-size: 12px; color: #999;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-size: 14px; font-weight: 500; color: #666; cursor: pointer; outline: none;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort by: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv63-grid">
      {% for product in collection.products %}
        {% render 'card-v63', product: product %}
        {% if forloop.index == 4 and section.settings.show_promo_tile %}
          <div class="clv63-promo">
            <h3>New<br>Arrivals</h3>
            <a href="/collections/new">Discover</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v63', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 40px; text-align: center; font-size: 16px; font-weight: 500; color: #666;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv63-seo">
      <h2 style="font-size: 20px; font-weight: 600; color: #1A1A24; margin-bottom: 10px; letter-spacing: -0.5px;">{{ section.settings.seo_title | default: 'Seamless Integration' }}</h2>
      <p style="font-size: 14px; color: #666; max-width: 600px; margin: 0 auto; line-height: 1.6;">{{ section.settings.seo_text | default: 'All devices are cross-compatible and designed to simplify your daily routine through advanced automation and machine learning.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V63 — Tech", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAFAFA"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#1A1A24"}
  ], "presets": [{"name": "CL V63 — Tech"}]
}
{% endschema %}
