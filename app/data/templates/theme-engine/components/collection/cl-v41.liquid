{% comment %} CL V41 — Neon / Synthwave {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv41 { background: {{ section.settings.bg_color | default: '#09090E' }}; color: {{ section.settings.text_color | default: '#00F0FF' }}; padding: 60px 20px; font-family: 'Orbitron', 'Courier New', monospace; }
  .clv41-hero { text-align: center; margin-bottom: 50px; padding: 60px 20px; background: linear-gradient(180deg, #1A0B2E 0%, #09090E 100%); border-bottom: 2px solid #FF003C; box-shadow: 0 10px 30px rgba(255,0,60,0.2); }
  .clv41-hero h1 { font-size: 54px; font-weight: 900; color: #00F0FF; margin-bottom: 15px; text-transform: uppercase; text-shadow: 0 0 10px #00F0FF, 0 0 20px #00F0FF; letter-spacing: 5px; }
  .clv41-hero p { font-size: 16px; color: #FCEE09; max-width: 600px; margin: 0 auto; letter-spacing: 2px; text-shadow: 0 0 5px #FCEE09; }
  .clv41-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv41-chips a { padding: 12px 25px; background: transparent; color: #FF003C; text-decoration: none; font-size: 14px; font-weight: bold; border: 1px solid #FF003C; text-transform: uppercase; box-shadow: inset 0 0 10px rgba(255,0,60,0.5), 0 0 10px rgba(255,0,60,0.5); transition: 0.2s; }
  .clv41-chips a:hover, .clv41-chips a.active { background: #FF003C; color: #FFF; box-shadow: 0 0 20px #FF003C; }
  .clv41-toolbar { background: #130B1C; border: 1px solid #00F0FF; padding: 15px 25px; margin-bottom: 40px; box-shadow: 0 0 15px rgba(0,240,255,0.2); }
  .clv41-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 30px; }
  .clv41-promo { grid-column: span 1; background: #000; color: #00F0FF; border: 2px dashed #00F0FF; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; box-shadow: inset 0 0 20px rgba(0,240,255,0.3); }
  .clv41-promo h3 { font-size: 26px; margin-bottom: 20px; text-transform: uppercase; text-shadow: 0 0 10px #00F0FF; }
  .clv41-promo a { display: inline-block; padding: 10px 20px; background: #00F0FF; color: #000; text-decoration: none; font-weight: bold; text-transform: uppercase; font-size: 14px; box-shadow: 0 0 15px #00F0FF; }
  .clv41-seo { margin-top: 60px; background: #130B1C; border: 1px solid #FF003C; padding: 40px; text-align: center; box-shadow: inset 0 0 20px rgba(255,0,60,0.2); }
  @media (max-width: 768px) { .clv41-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv41-hero h1 { font-size: 36px; } }
</style>
<div class="clv41" style="max-width: 1300px; margin: 0 auto;">
  <div class="clv41-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}CYBER GRID{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Jack in. Upgrade your hardware. Rule the net.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv41-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv41-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; color: #00F0FF; text-transform: uppercase; font-weight: bold; text-shadow: 0 0 5px #00F0FF;">> {{ filter.label }}</summary>
              <div style="position: absolute; background: #09090E; border: 1px solid #00F0FF; padding: 20px; z-index: 10; margin-top: 15px; min-width: 200px; box-shadow: 0 0 15px rgba(0,240,255,0.5);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 13px; color: #FFF;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} [{{ value.count }}]
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: 1px solid #FCEE09; color: #FCEE09; padding: 8px 15px; font-size: 13px; font-weight: bold; cursor: pointer; text-transform: uppercase; text-shadow: 0 0 5px #FCEE09;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" style="background: #09090E; color: #FCEE09;"{% if option.value == sort_by %} selected{% endif %}>SORT // {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv41-grid">
      {% for product in collection.products %}
        {% render 'card-v41', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv41-promo">
            <h3>NEW<br>AUGMENTS</h3>
            <a href="/collections/augments">ACCESS</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v41', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; color: #00F0FF; text-shadow: 0 0 10px #00F0FF; font-weight: bold;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv41-seo">
      <h2 style="font-size: 24px; color: #FF003C; margin-bottom: 15px; text-transform: uppercase; text-shadow: 0 0 10px #FF003C;">{{ section.settings.seo_title | default: 'SYSTEM OVERRIDE' }}</h2>
      <p style="font-size: 14px; color: #FFF; max-width: 700px; margin: 0 auto; line-height: 1.6;">{{ section.settings.seo_text | default: 'Welcome to the neon-drenched future. Equip yourself with next-gen peripherals designed for maximum output and undeniable style.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V41 — Synthwave", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#09090E"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#00F0FF"}
  ], "presets": [{"name": "CL V41 — Synthwave"}]
}
{% endschema %}
