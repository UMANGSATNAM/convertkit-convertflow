{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent_color = section.settings.accent_color
  assign hover_bg_color = section.settings.hover_bg_color
  assign border_color = section.settings.border_color
  assign border_width = section.settings.border_width
  assign shadow_color = section.settings.shadow_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign title = section.settings.title
-%}

<style>
  .hp18-categories-{{ sec_id }} {
    background-color: {{ bg_color }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    border-bottom: {{ border_width }}px solid {{ border_color }};
  }

  .hp18-categories-{{ sec_id }}__container {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp18-categories-{{ sec_id }}__header {
    margin-bottom: 60px;
    text-align: center;
  }

  .hp18-categories-{{ sec_id }}__title {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(36px, 5vw, 64px);
    color: {{ text_color }};
    text-transform: uppercase;
    margin: 0;
    text-shadow: 4px 4px 0px {{ accent_color }};
    letter-spacing: -1px;
  }

  .hp18-categories-{{ sec_id }}__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
  }

  .hp18-categories-{{ sec_id }}__item {
    background-color: #ffffff;
    border: {{ border_width }}px solid {{ border_color }};
    box-shadow: 8px 8px 0px {{ shadow_color }};
    padding: 40px 30px;
    text-decoration: none;
    text-align: center;
    transition: all 0.2s cubic-bezier(0.25, 1, 0.5, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    position: relative;
    overflow: hidden;
  }

  .hp18-categories-{{ sec_id }}__item::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-color: {{ hover_bg_color }};
    transform: translateY(100%);
    transition: transform 0.3s ease;
    z-index: 1;
  }

  .hp18-categories-{{ sec_id }}__item:hover::before {
    transform: translateY(0);
  }

  .hp18-categories-{{ sec_id }}__item:hover {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0px {{ shadow_color }};
  }

  .hp18-categories-{{ sec_id }}__item:active {
    transform: translate(8px, 8px);
    box-shadow: 0px 0px 0px {{ shadow_color }};
  }

  .hp18-categories-{{ sec_id }}__icon {
    font-size: 64px;
    position: relative;
    z-index: 2;
    transition: transform 0.3s ease;
  }

  .hp18-categories-{{ sec_id }}__item:hover .hp18-categories-{{ sec_id }}__icon {
    transform: scale(1.1) rotate(5deg);
  }

  .hp18-categories-{{ sec_id }}__name {
    font-family: 'Courier New', monospace;
    font-size: 24px;
    font-weight: bold;
    color: {{ text_color }};
    text-transform: uppercase;
    margin: 0;
    position: relative;
    z-index: 2;
    background: {{ bg_color }};
    padding: 5px 10px;
    border: 2px solid {{ border_color }};
  }

  @media screen and (max-width: 768px) {
    .hp18-categories-{{ sec_id }}__container {
      padding: 0 20px;
    }
    .hp18-categories-{{ sec_id }}__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .hp18-categories-{{ sec_id }}__item {
      padding: 20px 15px;
    }
    .hp18-categories-{{ sec_id }}__icon {
      font-size: 40px;
    }
    .hp18-categories-{{ sec_id }}__name {
      font-size: 16px;
    }
  }

  @media screen and (max-width: 480px) {
    .hp18-categories-{{ sec_id }}__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<section class="hp18-categories-{{ sec_id }}">
  <div class="hp18-categories-{{ sec_id }}__container">
    
    {% if title != blank %}
    <div class="hp18-categories-{{ sec_id }}__header">
      <h2 class="hp18-categories-{{ sec_id }}__title">{{ title }}</h2>
    </div>
    {% endif %}

    <div class="hp18-categories-{{ sec_id }}__grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.collection.url | default: '#' }}" class="hp18-categories-{{ sec_id }}__item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <span class="hp18-categories-{{ sec_id }}__icon">{{ block.settings.icon }}</span>
          {% else %}
            <span class="hp18-categories-{{ sec_id }}__icon">🔥</span>
          {% endif %}
          
          <h3 class="hp18-categories-{{ sec_id }}__name">
            {{ block.settings.title | default: block.settings.collection.title | default: 'Category' }}
          </h3>
        </a>
      {% else %}
        {% for i in (1..4) %}
        <a href="#" class="hp18-categories-{{ sec_id }}__item">
          <span class="hp18-categories-{{ sec_id }}__icon">👕</span>
          <h3 class="hp18-categories-{{ sec_id }}__name">Apparel {{ i }}</h3>
        </a>
        {% endfor %}
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP18 Category Pills",
  "settings": [
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Title Shadow Color",
      "default": "#FF3366"
    },
    {
      "type": "color",
      "id": "hover_bg_color",
      "label": "Card Hover Fill Color",
      "default": "#CCFF00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Shadow Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SHOP BY CAT"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji Icon",
          "default": "👕"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Override Title (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP18 Advanced Categories",
      "blocks": [
        { "type": "category", "settings": { "icon": "👕", "title": "Heavy Tees" } },
        { "type": "category", "settings": { "icon": "🧥", "title": "Hoodies" } },
        { "type": "category", "settings": { "icon": "👖", "title": "Bottoms" } },
        { "type": "category", "settings": { "icon": "🧢", "title": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
