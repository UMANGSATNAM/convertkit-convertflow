{% comment %} CL V45 — Coffee Shop (Warm Browns) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv45 { background: {{ section.settings.bg_color | default: '#FDF8F5' }}; color: {{ section.settings.text_color | default: '#4A3B32' }}; padding: 50px 20px; font-family: 'Merriweather', serif; }
  .clv45-hero { text-align: center; margin-bottom: 50px; padding: 40px; background: #F5EBE1; border-radius: 8px; }
  .clv45-hero h1 { font-size: 42px; font-weight: 700; color: #332721; margin-bottom: 15px; }
  .clv45-hero p { font-size: 15px; font-family: 'Inter', sans-serif; color: #665345; max-width: 550px; margin: 0 auto; line-height: 1.6; }
  .clv45-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv45-chips a { padding: 10px 22px; background: transparent; color: #4A3B32; text-decoration: none; font-size: 14px; font-family: 'Inter', sans-serif; border: 1px solid #D8C3B5; border-radius: 4px; transition: 0.2s; }
  .clv45-chips a:hover, .clv45-chips a.active { background: #4A3B32; color: #FDF8F5; border-color: #4A3B32; }
  .clv45-toolbar { border-top: 1px solid #D8C3B5; border-bottom: 1px solid #D8C3B5; padding: 20px 0; margin-bottom: 40px; font-family: 'Inter', sans-serif; }
  .clv45-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 25px; }
  .clv45-promo { grid-column: span 1; background: #4A3B32; color: #FDF8F5; border-radius: 8px; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; }
  .clv45-promo h3 { font-size: 24px; margin-bottom: 15px; font-weight: 700; }
  .clv45-promo a { display: inline-block; padding: 12px 25px; background: #D8C3B5; color: #332721; text-decoration: none; font-size: 13px; font-family: 'Inter', sans-serif; font-weight: 600; border-radius: 4px; transition: 0.2s; }
  .clv45-promo a:hover { background: #F5EBE1; }
  .clv45-seo { margin-top: 60px; background: #F5EBE1; padding: 40px; border-radius: 8px; text-align: center; }
  @media (max-width: 768px) { .clv45-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv45-hero h1 { font-size: 32px; } }
</style>
<div class="clv45" style="max-width: 1200px; margin: 0 auto;">
  <div class="clv45-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Single Origin{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Freshly roasted beans sourced directly from independent farmers.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv45-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv45-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 25px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; font-weight: 500; color: #4A3B32;">{{ filter.label }} ▾</summary>
              <div style="position: absolute; background: #FFF; border: 1px solid #D8C3B5; padding: 20px; border-radius: 4px; z-index: 10; margin-top: 15px; min-width: 220px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 14px; color: #665345;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: 1px solid #D8C3B5; padding: 8px 15px; font-size: 14px; color: #4A3B32; font-family: inherit; border-radius: 4px; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv45-grid">
      {% for product in collection.products %}
        {% render 'card-v45', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv45-promo">
            <h3>Brewing<br>Equipment</h3>
            <a href="/collections/equipment">Shop Brewers</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v45', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; font-family: 'Inter', sans-serif;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv45-seo">
      <h2 style="font-size: 24px; color: #332721; margin-bottom: 15px;">{{ section.settings.seo_title | default: 'The Perfect Cup' }}</h2>
      <p style="font-size: 14px; font-family: 'Inter', sans-serif; color: #665345; max-width: 650px; margin: 0 auto; line-height: 1.7;">{{ section.settings.seo_text | default: 'We believe that great coffee starts at the source. We roast in small batches daily to ensure you experience the full flavor profile of every bean.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V45 — Coffee", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#FDF8F5"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#4A3B32"}
  ], "presets": [{"name": "CL V45 — Coffee"}]
}
{% endschema %}
