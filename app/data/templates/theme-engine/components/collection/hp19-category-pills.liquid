{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --bg-color: {{ section.settings.bg_color }};
    --pill-bg: {{ section.settings.pill_bg_color }};
    --pill-text: {{ section.settings.pill_text_color }};
    --pill-border: {{ section.settings.pill_border_color }};
    --pill-bg-hover: {{ section.settings.pill_bg_hover }};
    --pill-text-hover: {{ section.settings.pill_text_hover }};
    --pill-border-hover: {{ section.settings.pill_border_hover }};
    --gap: {{ section.settings.pill_gap }}px;
    
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    background-color: var(--bg-color);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      --padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
      --gap: {{ section.settings.mobile_pill_gap }}px;
    }
  }

  .hp19-pills-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: {{ section.settings.alignment }};
  }

  {%- if section.settings.title != blank -%}
  .hp19-pills__title {
    font-family: 'Baskerville', 'Georgia', serif;
    font-size: clamp(24px, 4vw, {{ section.settings.title_size }}px);
    color: {{ section.settings.title_color }};
    margin: 0 0 {{ section.settings.title_margin }}px;
    font-style: italic;
  }
  {%- endif -%}

  .hp19-pills__container {
    display: flex;
    flex-wrap: {% if section.settings.wrap_mobile %}wrap{% else %}nowrap{% endif %};
    justify-content: {{ section.settings.alignment }};
    gap: var(--gap);
  }

  @media screen and (min-width: 769px) {
    .hp19-pills__container {
      flex-wrap: wrap;
    }
  }

  @media screen and (max-width: 768px) {
    .hp19-pills__container {
      {% if section.settings.wrap_mobile == false %}
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 12px;
      scrollbar-width: none; /* Firefox */
      -ms-overflow-style: none;  /* IE and Edge */
      {% endif %}
    }
    
    {% if section.settings.wrap_mobile == false %}
    .hp19-pills__container::-webkit-scrollbar {
      display: none;
    }
    {% endif %}
  }

  .hp19-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.pill_padding_y }}px {{ section.settings.pill_padding_x }}px;
    background-color: var(--pill-bg);
    color: var(--pill-text);
    border: {{ section.settings.border_thickness }}px solid var(--pill-border);
    border-radius: {{ section.settings.border_radius }}px;
    font-family: 'Inter', sans-serif;
    font-size: {{ section.settings.font_size }}px;
    font-weight: {{ section.settings.font_weight }};
    text-transform: {% if section.settings.uppercase %}uppercase{% else %}none{% endif %};
    letter-spacing: {{ section.settings.letter_spacing }}px;
    text-decoration: none;
    transition: all 0.3s ease;
    white-space: nowrap;
    
    {% if section.settings.wrap_mobile == false %}
    scroll-snap-align: start;
    {% endif %}
  }

  .hp19-pill:hover,
  .hp19-pill:focus {
    background-color: var(--pill-bg-hover);
    color: var(--pill-text-hover);
    border-color: var(--pill-border-hover);
    transform: translateY(-2px);
    {% if section.settings.show_shadow_on_hover %}
    box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    {% endif %}
  }
  
  .hp19-pill.active {
    background-color: var(--pill-bg-hover);
    color: var(--pill-text-hover);
    border-color: var(--pill-border-hover);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp19-pills-wrapper" id="HP19Pills-{{ section.id }}">
  {%- if section.settings.title != blank -%}
    <h2 class="hp19-pills__title">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  <div class="hp19-pills__container">
    {%- for block in section.blocks -%}
      {%- assign is_active = false -%}
      {%- if request.path == block.settings.link -%}
        {%- assign is_active = true -%}
      {%- endif -%}
      
      <a href="{{ block.settings.link | default: '#' }}" 
         class="hp19-pill {% if is_active %}active{% endif %}"
         {{ block.shopify_attributes }}>
        {{ block.settings.title | escape }}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP19 - Category Pills Pro",
  "class": "section-hp19-category-pills",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_margin",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Bottom Margin",
      "default": 32
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1000
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "wrap_mobile",
      "label": "Wrap pills to new lines on mobile",
      "info": "If disabled, pills will form a horizontal scrolling list.",
      "default": true
    },
    {
      "type": "range",
      "id": "pill_gap",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between pills (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_pill_gap",
      "min": 4,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Gap between pills (Mobile)",
      "default": 12
    },
    {
      "type": "header",
      "content": "Pill Styling"
    },
    {
      "type": "range",
      "id": "pill_padding_x",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Horizontal Padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "pill_padding_y",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Border Thickness",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Border Radius",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "show_shadow_on_hover",
      "label": "Show shadow on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase Text",
      "default": true
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Letter Spacing",
      "default": 1
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FFFBEB"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading Color",
      "default": "#451A03"
    },
    {
      "type": "color",
      "id": "pill_bg_color",
      "label": "Pill Background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "pill_text_color",
      "label": "Pill Text Color",
      "default": "#451A03"
    },
    {
      "type": "color",
      "id": "pill_border_color",
      "label": "Pill Border Color",
      "default": "#D97706"
    },
    {
      "type": "color",
      "id": "pill_bg_hover",
      "label": "Pill Hover Background",
      "default": "#451A03"
    },
    {
      "type": "color",
      "id": "pill_text_hover",
      "label": "Pill Hover Text Color",
      "default": "#FFFBEB"
    },
    {
      "type": "color",
      "id": "pill_border_hover",
      "label": "Pill Hover Border",
      "default": "#451A03"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Category Pill",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP19 - Category Pills Pro",
      "category": "Navigation",
      "blocks": [
        { "type": "pill", "settings": { "title": "Breads" } },
        { "type": "pill", "settings": { "title": "Pastries" } },
        { "type": "pill", "settings": { "title": "Coffee Beans" } },
        { "type": "pill", "settings": { "title": "Pantry" } },
        { "type": "pill", "settings": { "title": "Gifts" } }
      ]
    }
  ]
}
{% endschema %}
