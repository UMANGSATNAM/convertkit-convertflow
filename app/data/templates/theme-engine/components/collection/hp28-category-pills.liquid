{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --cyan: {{ section.settings.cyan_color }};
    --magenta: {{ section.settings.magenta_color }};
    --font-heading: 'Press Start 2P', cursive;
    --font-body: 'Chakra Petch', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 2px dashed var(--magenta);
    position: relative;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp28-cat-pills-wrapper {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media screen and (max-width: 768px) {
    .hp28-cat-pills-wrapper {
      padding: 0 20px;
    }
  }

  .hp28-cat-pills__title {
    font-family: var(--font-heading);
    font-size: clamp(14px, 2vw, {{ section.settings.title_size }}px);
    color: var(--text-color);
    margin: 0 0 30px;
    text-transform: uppercase;
    text-shadow: 2px 2px 0 var(--magenta);
  }

  .hp28-cat-pills__scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 15px;
  }

  .hp28-cat-pills__scroll::-webkit-scrollbar {
    display: none;
  }

  .hp28-cat-pills__list {
    display: flex;
    justify-content: center;
    gap: 15px;
    min-width: max-content;
  }

  @media screen and (max-width: 768px) {
    .hp28-cat-pills__list {
      justify-content: flex-start;
      padding: 0 10px; /* buffer for scroll */
    }
  }

  .hp28-cat-pills__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    background: #000;
    color: var(--text-color);
    font-family: var(--font-heading);
    font-size: 12px;
    padding: 15px 25px;
    border: 2px solid var(--text-color);
    box-shadow: 4px 4px 0 var(--cyan);
    transition: all 0.2s ease;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hp28-cat-pills__pill:hover,
  .hp28-cat-pills__pill.is-active {
    background: var(--magenta);
    color: #fff;
    border-color: var(--magenta);
    box-shadow: 2px 2px 0 var(--cyan);
    transform: translate(2px, 2px);
  }

  .hp28-cat-pills__pill:active {
    box-shadow: 0 0 0 var(--cyan);
    transform: translate(4px, 4px);
  }

  /* Optional icon within pill */
  .hp28-cat-pills__icon {
    width: 20px;
    height: 20px;
    margin-right: 10px;
    image-rendering: pixelated;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-cat-pills-wrapper" id="HP28CatPills-{{ section.id }}">
  {%- if section.settings.title != blank -%}
    <h2 class="hp28-cat-pills__title">[{{ section.settings.title }}]</h2>
  {%- endif -%}

  <div class="hp28-cat-pills__scroll">
    <div class="hp28-cat-pills__list">
      {%- for block in section.blocks -%}
        {%- assign is_active = false -%}
        {%- if block.settings.link == request.path -%}
          {%- assign is_active = true -%}
        {%- endif -%}

        <a href="{{ block.settings.link | default: '#' }}" class="hp28-cat-pills__pill {% if is_active or forloop.first and section.settings.highlight_first %}is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 40 }}" class="hp28-cat-pills__icon" alt="icon">
          {%- endif -%}
          {{ block.settings.title }}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP28 - Y2K Category Pills",
  "class": "section-hp28-category-pills",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SELECT DIR"
    },
    {
      "type": "checkbox",
      "id": "highlight_first",
      "label": "Highlight First Item as Active",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Heading Size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Y2K Cyber Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Deep Purple)",
      "default": "#1C0B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cyan_color",
      "label": "Cyan Accent",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "magenta_color",
      "label": "Magenta Accent",
      "default": "#FF00FF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "CATEGORY"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Pixel Icon (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP28 - Y2K Category Pills",
      "blocks": [
        { "type": "category", "settings": { "title": "ALL FILES" } },
        { "type": "category", "settings": { "title": "HARDWARE" } },
        { "type": "category", "settings": { "title": "SOFTWARE" } },
        { "type": "category", "settings": { "title": "ARCHIVES" } },
        { "type": "category", "settings": { "title": "EXPANSIONS" } }
      ]
    }
  ]
}
{% endschema %}
