{% comment %} CL V30 — Luxury Watches {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv30 { background: {{ section.settings.bg_color | default: '#000000' }}; color: {{ section.settings.text_color | default: '#D4AF37' }}; padding: 60px 20px; font-family: 'Cinzel', serif; }
  .clv30-hero { text-align: center; margin-bottom: 60px; padding: 50px 20px; border-bottom: 1px solid #333; }
  .clv30-hero h1 { font-size: 44px; font-weight: normal; margin-bottom: 20px; letter-spacing: 4px; text-transform: uppercase; color: #FFF; }
  .clv30-hero p { font-size: 15px; font-family: 'Helvetica', sans-serif; color: #888; max-width: 600px; margin: 0 auto; letter-spacing: 1px; line-height: 1.8; }
  .clv30-chips { display: flex; gap: 30px; justify-content: center; margin-bottom: 50px; flex-wrap: wrap; }
  .clv30-chips a { padding: 10px 0; color: #D4AF37; text-decoration: none; font-size: 12px; letter-spacing: 3px; text-transform: uppercase; font-family: 'Helvetica', sans-serif; border-bottom: 1px solid transparent; transition: 0.4s; opacity: 0.7; }
  .clv30-chips a:hover, .clv30-chips a.active { opacity: 1; border-color: #D4AF37; }
  .clv30-toolbar { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #222; padding-bottom: 20px; margin-bottom: 50px; font-family: 'Helvetica', sans-serif; }
  .clv30-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 3 }}, 1fr); gap: 40px; }
  .clv30-promo { grid-column: span 1; background: #111; border: 1px solid #333; padding: 50px; text-align: center; display: flex; flex-direction: column; justify-content: center; }
  .clv30-promo h3 { font-size: 24px; color: #FFF; margin-bottom: 25px; letter-spacing: 2px; text-transform: uppercase; }
  .clv30-promo a { display: inline-block; padding: 15px 35px; background: transparent; color: #D4AF37; border: 1px solid #D4AF37; text-decoration: none; font-family: 'Helvetica', sans-serif; font-size: 11px; text-transform: uppercase; letter-spacing: 2px; transition: 0.4s; }
  .clv30-promo a:hover { background: #D4AF37; color: #000; }
  .clv30-seo { margin-top: 80px; text-align: center; padding: 60px 20px; background: #0A0A0A; border-top: 1px solid #222; }
  @media (max-width: 768px) { .clv30-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 20px; } .clv30-hero h1 { font-size: 34px; } }
</style>
<div class="clv30" style="max-width: 1200px; margin: 0 auto;">
  <div class="clv30-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Horology{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Masterpieces of timekeeping, engineered for eternity.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv30-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv30-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 30px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 11px; text-transform: uppercase; letter-spacing: 3px; color: #888;">{{ filter.label }} +</summary>
              <div style="position: absolute; background: #111; border: 1px solid #333; padding: 30px; z-index: 10; margin-top: 20px; min-width: 250px; box-shadow: 0 20px 50px rgba(0,0,0,0.5);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 15px; cursor: pointer; font-size: 12px; color: #CCC; letter-spacing: 1px;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} <span style="color:#666;font-size:10px;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-size: 11px; text-transform: uppercase; letter-spacing: 2px; color: #D4AF37; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 12 %}
  {% paginate collection.products by limit_num %}
    <div class="clv30-grid">
      {% for product in collection.products %}
        {% render 'card-v30', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv30-promo">
            <span style="font-family: 'Helvetica', sans-serif; font-size: 10px; letter-spacing: 3px; color: #888; margin-bottom: 15px; text-transform: uppercase;">Concierge</span>
            <h3>Private<br>Viewing</h3>
            <a href="/pages/appointments">Book Session</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v30', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 70px; text-align: center; font-family: 'Helvetica', sans-serif; font-size: 12px; letter-spacing: 2px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv30-seo">
      <h2 style="font-size: 28px; font-weight: normal; margin-bottom: 20px; color: #FFF; letter-spacing: 2px;">{{ section.settings.seo_title | default: 'A Legacy on Your Wrist' }}</h2>
      <p style="font-family: 'Helvetica', sans-serif; font-size: 13px; color: #888; line-height: 2; max-width: 600px; margin: 0 auto; letter-spacing: 1px;">{{ section.settings.seo_text | default: 'Every timepiece is meticulously inspected for authenticity and mechanical precision by our certified master watchmakers.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V30 — Watches", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 6, "max": 36, "step": 3, "default": 12},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 4, "default": 3},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#D4AF37"}
  ], "presets": [{"name": "CL V30 — Watches"}]
}
{% endschema %}
