{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --cyan: {{ section.settings.cyan_color }};
    --magenta: {{ section.settings.magenta_color }};
    
    --win-bg: #c0c0c0;
    --win-dark: #000000;
    --win-light: #ffffff;
    --win-border-light: #dfdfdf;
    --win-border-dark: #808080;
    
    --font-heading: 'Press Start 2P', cursive;
    --font-body: 'Chakra Petch', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp28-tiles-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp28-tiles-wrapper {
      padding: 0 20px;
    }
  }

  .hp28-tiles__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp28-tiles__title {
    font-family: var(--font-heading);
    font-size: clamp(20px, 3.5vw, {{ section.settings.title_size }}px);
    color: var(--cyan);
    text-shadow: 3px 3px 0 var(--magenta);
    margin: 0;
    text-transform: uppercase;
  }

  .hp28-tiles__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 30px;
  }

  @media screen and (max-width: 992px) {
    .hp28-tiles__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp28-tiles__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Win95 Button Style Tile */
  .hp28-tiles__item {
    display: block;
    background: var(--win-bg);
    border-top: 4px solid var(--win-light);
    border-left: 4px solid var(--win-light);
    border-right: 4px solid var(--win-dark);
    border-bottom: 4px solid var(--win-dark);
    padding: 6px;
    position: relative;
    text-decoration: none;
    box-shadow: inset 2px 2px 0 var(--win-border-light), inset -2px -2px 0 var(--win-border-dark), 5px 5px 0 var(--magenta);
    transition: all 0.1s ease;
  }

  .hp28-tiles__item:active {
    border-top: 4px solid var(--win-dark);
    border-left: 4px solid var(--win-dark);
    border-right: 4px solid var(--win-light);
    border-bottom: 4px solid var(--win-light);
    box-shadow: inset 2px 2px 0 var(--win-border-dark), inset -2px -2px 0 var(--win-border-light), 0 0 0 var(--magenta);
    transform: translate(5px, 5px);
  }

  .hp28-tiles__image-container {
    aspect-ratio: {{ section.settings.image_ratio }};
    background: #000;
    position: relative;
    overflow: hidden;
    border-top: 2px solid var(--win-border-dark);
    border-left: 2px solid var(--win-border-dark);
    border-right: 2px solid var(--win-light);
    border-bottom: 2px solid var(--win-light);
  }

  .hp28-tiles__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(100%) hue-rotate(280deg) saturate(300%) contrast(1.2);
    transition: filter 0.3s ease, transform 0.3s ease;
  }

  .hp28-tiles__item:hover .hp28-tiles__image {
    filter: sepia(0%) hue-rotate(0deg) saturate(100%) contrast(1);
    transform: scale(1.05);
  }

  /* Glitch scanline on hover */
  .hp28-tiles__image-container::after {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: repeating-linear-gradient(
      transparent,
      transparent 4px,
      rgba(0, 255, 255, 0.2) 4px,
      rgba(0, 255, 255, 0.2) 8px
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .hp28-tiles__item:hover .hp28-tiles__image-container::after {
    opacity: 1;
  }

  .hp28-tiles__content {
    background: #000;
    margin-top: 6px;
    padding: 15px;
    text-align: center;
    border-top: 2px solid var(--win-border-dark);
    border-left: 2px solid var(--win-border-dark);
    border-right: 2px solid var(--win-light);
    border-bottom: 2px solid var(--win-light);
  }

  .hp28-tiles__label {
    font-family: var(--font-heading);
    font-size: 14px;
    color: var(--cyan);
    margin: 0;
    text-transform: uppercase;
  }

  .hp28-tiles__item:hover .hp28-tiles__label {
    color: var(--magenta);
    animation: flash 0.2s infinite;
  }

  @keyframes flash {
    0%, 100% { color: var(--magenta); }
    50% { color: var(--text-color); }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-tiles-wrapper" id="HP28Tiles-{{ section.id }}">
  <div class="hp28-tiles__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp28-tiles__title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

  <div class="hp28-tiles__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link_url | default: '#' }}" class="hp28-tiles__item" {{ block.shopify_attributes }}>
        <div class="hp28-tiles__image-container">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" class="hp28-tiles__image" loading="lazy">
          {%- else -%}
            {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'hp28-tiles__image' }}
          {%- endif -%}
        </div>
        <div class="hp28-tiles__content">
          <h3 class="hp28-tiles__label">C:\SYS\{{ block.settings.title | replace: ' ', '_' }}</h3>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP28 - Y2K Category Tiles",
  "class": "section-hp28-category-tiles",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SYSTEM DIRECTORIES"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "16/9", "label": "Widescreen (16:9)" }
      ],
      "default": "4/3"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Y2K Cyber Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Deep Purple)",
      "default": "#1C0B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cyan_color",
      "label": "Cyan Accent",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "magenta_color",
      "label": "Magenta Accent",
      "default": "#FF00FF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "HARDWARE"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP28 - Y2K Category Tiles",
      "blocks": [
        { "type": "category", "settings": { "title": "HARDWARE" } },
        { "type": "category", "settings": { "title": "SOFTWARE" } },
        { "type": "category", "settings": { "title": "UPGRADES" } }
      ]
    }
  ]
}
{% endschema %}
