{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp44-pills-bg: {{ section.settings.bg_color | default: '#EDF4EE' }};
    --hp44-pill-bg: {{ section.settings.pill_bg | default: '#FFFFFF' }};
    --hp44-pill-border: {{ section.settings.pill_border | default: '#D8E8DC' }};
    --hp44-pill-text: {{ section.settings.pill_text | default: '#143D2B' }};
    --hp44-pill-active-bg: {{ section.settings.pill_active_bg | default: '#143D2B' }};
    --hp44-pill-active-text: {{ section.settings.pill_active_text | default: '#FFFFFF' }};
    
    background-color: var(--hp44-pills-bg);
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
  }

  .hp44-pills__wrap {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hp44-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 26px;
    background: var(--hp44-pill-bg);
    border: 1px solid var(--hp44-pill-border);
    border-radius: 50px;
    color: var(--hp44-pill-text);
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 12px rgba(20, 61, 43, 0.04);
  }

  .hp44-pill:hover, .hp44-pill--active {
    background: var(--hp44-pill-active-bg);
    color: var(--hp44-pill-active-text);
    border-color: var(--hp44-pill-active-bg);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(20, 61, 43, 0.15);
  }

  @media screen and (max-width: 576px) {
    .hp44-pills__wrap {
      justify-content: flex-start;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 8px;
      -webkit-overflow-scrolling: touch;
    }
    .hp44-pill {
      flex-shrink: 0;
      padding: 10px 20px;
      font-size: 13px;
    }
  }
{%- endstyle -%}

<div class="hp44-pills__wrap">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url | default: '/collections/all' }}" class="hp44-pill {% if forloop.first %}hp44-pill--active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          <span>{{ block.settings.icon }}</span>
        {%- endif -%}
        <span>{{ block.settings.title }}</span>
      </a>
    {%- endfor -%}
  {%- else -%}
    <a href="/collections/all" class="hp44-pill hp44-pill--active"><span>🌿</span><span>All Botanical Care</span></a>
    <a href="/collections/sage" class="hp44-pill"><span>🌱</span><span>Clary Sage Elixirs</span></a>
    <a href="/collections/calendula" class="hp44-pill"><span>🌼</span><span>Calendula Balms</span></a>
    <a href="/collections/masks" class="hp44-pill"><span>✨</span><span>Nordic Detox Masks</span></a>
    <a href="/collections/mists" class="hp44-pill"><span>💧</span><span>Essence Mists</span></a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP44 - Sage Pills",
  "class": "section-hp44-pills",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#EDF4EE" },
    { "type": "color", "id": "pill_bg", "label": "Pill Background", "default": "#FFFFFF" },
    { "type": "color", "id": "pill_border", "label": "Pill Border", "default": "#D8E8DC" },
    { "type": "color", "id": "pill_text", "label": "Pill Text Color", "default": "#143D2B" },
    { "type": "color", "id": "pill_active_bg", "label": "Active Pill Background", "default": "#143D2B" },
    { "type": "color", "id": "pill_active_text", "label": "Active Pill Text Color", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "min": 10, "max": 80, "step": 5, "unit": "px", "label": "Padding Top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 10, "max": 80, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 40 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1100 }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Category Pill",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji / Icon", "default": "🌿" },
        { "type": "text", "id": "title", "label": "Pill Title", "default": "All Botanical Care" },
        { "type": "url", "id": "url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP44 - Sage Pills",
      "blocks": [
        { "type": "pill", "settings": { "icon": "🌿", "title": "All Botanical Care" } },
        { "type": "pill", "settings": { "icon": "🌱", "title": "Clary Sage Elixirs" } },
        { "type": "pill", "settings": { "icon": "🌼", "title": "Calendula Balms" } },
        { "type": "pill", "settings": { "icon": "✨", "title": "Nordic Detox Masks" } },
        { "type": "pill", "settings": { "icon": "💧", "title": "Essence Mists" } }
      ]
    }
  ]
}
{% endschema %}
