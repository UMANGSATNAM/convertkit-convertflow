{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    
    background-color: var(--bg-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .hp7-mosaic-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 25vw; /* Square-ish based on width */
    gap: 0; /* Brutalist edge-to-edge */
    width: 100%;
  }

  .hp7-mosaic__item {
    position: relative;
    overflow: hidden;
    background: #111;
    border: 1px solid var(--bg-color);
  }
  
  /* Complex Masonry Span Logic */
  .hp7-mosaic__item:nth-child(1) { grid-column: span 2; grid-row: span 2; }
  .hp7-mosaic__item:nth-child(4) { grid-row: span 2; }
  .hp7-mosaic__item:nth-child(5) { grid-column: span 2; }
  
  .hp7-mosaic__link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hp7-mosaic__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s filter 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    filter: grayscale(100%) contrast(1.2);
  }
  
  .hp7-mosaic__link:hover .hp7-mosaic__image {
    transform: scale(1.05);
    filter: grayscale(0%) contrast(1);
  }

  @media screen and (max-width: 990px) {
    .hp7-mosaic-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 50vw;
    }
    
    .hp7-mosaic__item:nth-child(1) { grid-column: span 2; grid-row: span 2; }
    .hp7-mosaic__item:nth-child(4) { grid-row: span 1; }
    .hp7-mosaic__item:nth-child(5) { grid-column: span 2; }
    
    .hp7-mosaic__image {
      filter: grayscale(0%) contrast(1); /* Disable grayscale on mobile for clarity */
    }
  }
</style>

<section class="hp7-mosaic-{{ section_id }}">
  {%- for block in section.blocks -%}
    <div class="hp7-mosaic__item" {{ block.shopify_attributes }}>
      <a href="{{ block.settings.link | default: '#' }}" class="hp7-mosaic__link" aria-label="View collection">
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1200 | image_tag: 
             loading: 'lazy',
             class: 'hp7-mosaic__image',
             alt: block.settings.image.alt | default: 'Collection image'
          }}
        {%- else -%}
          {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'hp7-mosaic__image placeholder-svg' }}
        {%- endif -%}
      </a>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "HP7 Collection Mosaic",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Aesthetic: Editorial Brutalism",
      "info": "Edge-to-edge grayscale mosaic that reveals color on hover. Best with exactly 5 blocks."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Border/Background Color",
      "default": "#050505"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Mosaic Item",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP7 Collection Mosaic",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
