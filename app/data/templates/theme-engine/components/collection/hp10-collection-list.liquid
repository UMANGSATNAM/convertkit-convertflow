{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#2A3B2C'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
  }
  
  .hp10-cl-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp10-cl-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
  }
  
  .hp10-cl-title-wrap-{{ section_id }} {
    max-width: 600px;
  }
  
  .hp10-cl-heading-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 400;
    color: {{ text_color }};
    margin: 0 0 15px 0;
  }
  
  .hp10-cl-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.05rem;
    color: rgba(42, 59, 44, 0.7);
    margin: 0;
  }
  
  .hp10-cl-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  
  .hp10-cl-card-{{ section_id }} {
    position: relative;
    border-radius: 30px;
    overflow: hidden;
    display: block;
    text-decoration: none;
    padding-top: 130%;
    background: #e8e3d5;
  }
  
  .hp10-cl-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  
  .hp10-cl-card-{{ section_id }}:hover .hp10-cl-image-{{ section_id }} {
    transform: scale(1.05);
  }
  
  .hp10-cl-content-{{ section_id }} {
    position: absolute;
    bottom: 0; left: 0; width: 100%;
    padding: 30px;
    background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);
    color: #fff;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .hp10-cl-card-title-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: 1.8rem;
    font-weight: 400;
    margin: 0;
  }
  
  .hp10-cl-arrow-{{ section_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }
  
  .hp10-cl-arrow-{{ section_id }} svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
  }

  @media (max-width: 992px) {
    .hp10-cl-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    .hp10-cl-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .hp10-cl-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }
    .hp10-cl-card-{{ section_id }} {
      padding-top: 100%;
    }
  }
</style>

<div class="hp10-cl-container-{{ section_id }}">
  <div class="hp10-cl-header-{{ section_id }}">
    <div class="hp10-cl-title-wrap-{{ section_id }}">
      <h2 class="hp10-cl-heading-{{ section_id }}">{{ section.settings.heading | default: 'Curated Collections' }}</h2>
      <p class="hp10-cl-text-{{ section_id }}">{{ section.settings.text | default: 'Find exactly what your body needs.' }}</p>
    </div>
  </div>
  
  <div class="hp10-cl-grid-{{ section_id }}">
    {% for block in section.blocks limit: 3 %}
      <a href="{{ block.settings.link | default: '#' }}" class="hp10-cl-card-{{ section_id }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 800 }}" class="hp10-cl-image-{{ section_id }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        {% else %}
          <div class="hp10-cl-image-{{ section_id }}" style="background: #D4A373;"></div>
        {% endif %}
        <div class="hp10-cl-content-{{ section_id }}">
          <h3 class="hp10-cl-card-title-{{ section_id }}">{{ block.settings.title | default: 'Collection' }}</h3>
          <div class="hp10-cl-arrow-{{ section_id }}">
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP10 Collection List",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2A3B2C"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated Collections"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Find exactly what your body needs."
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Face Care"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP10 Collection List",
      "blocks": [
        { "type": "collection", "settings": { "title": "Face Care" } },
        { "type": "collection", "settings": { "title": "Body Rituals" } },
        { "type": "collection", "settings": { "title": "Home Fragrance" } }
      ]
    }
  ]
}
{% endschema %}
