{% comment %} CL V10 — Pet Supplies / Playful {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv10 { background: {{ section.settings.bg_color | default: '#FDF4FF' }}; color: {{ section.settings.text_color | default: '#701A75' }}; padding: 50px 20px; font-family: 'Nunito', sans-serif; }
  .clv10-hero { text-align: center; margin-bottom: 40px; padding: 40px; background: #FAE8FF; border-radius: 30px; }
  .clv10-hero h1 { font-size: 40px; font-weight: 800; margin-bottom: 10px; color: #86198F; }
  .clv10-hero p { font-size: 16px; color: #A21CAF; max-width: 600px; margin: 0 auto; font-weight: 600; }
  .clv10-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv10-chips a { padding: 12px 24px; background: #FFF; color: #86198F; text-decoration: none; border-radius: 50px; font-size: 15px; font-weight: 700; box-shadow: 0 4px 10px rgba(134,25,143,0.1); transition: 0.3s; }
  .clv10-chips a:hover, .clv10-chips a.active { background: #D946EF; color: #FFF; box-shadow: 0 6px 15px rgba(217,70,239,0.3); transform: translateY(-2px); }
  .clv10-toolbar { background: #FFF; border-radius: 20px; padding: 20px 25px; margin-bottom: 40px; box-shadow: 0 4px 15px rgba(134,25,143,0.05); }
  .clv10-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 24px; }
  .clv10-promo { grid-column: span 1; background: #FDF4FF; border: 2px dashed #D946EF; border-radius: 24px; padding: 30px; text-align: center; display: flex; flex-direction: column; justify-content: center; align-items: center; }
  .clv10-promo h3 { font-size: 24px; font-weight: 800; color: #86198F; margin-bottom: 15px; }
  .clv10-promo a { display: inline-block; padding: 12px 28px; background: #D946EF; color: #FFF; border-radius: 50px; text-decoration: none; font-weight: 800; font-size: 14px; box-shadow: 0 4px 10px rgba(217,70,239,0.3); }
  .clv10-seo { margin-top: 60px; padding: 50px 30px; background: #FAE8FF; border-radius: 30px; text-align: center; }
  @media (max-width: 768px) { .clv10-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 16px; } .clv10-hero h1 { font-size: 32px; } }
</style>
<div class="clv10" style="max-width: 1300px; margin: 0 auto;">
  <div class="clv10-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Happy Tails{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Premium treats, toys, and gear for your furry best friends! 🐾{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv10-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv10-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 15px; font-weight: 700; color: #86198F;">{{ filter.label }} 🐶</summary>
              <div style="position: absolute; background: #FFF; padding: 20px; border-radius: 16px; z-index: 10; margin-top: 10px; min-width: 220px; box-shadow: 0 10px 30px rgba(134,25,143,0.15);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 15px; font-weight: 600; color: #701A75;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} <span style="color:#C026D3;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #FDF4FF; border: 1px solid #F0ABFC; color: #86198F; padding: 10px 20px; border-radius: 50px; font-size: 15px; font-weight: 700; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv10-grid">
      {% for product in collection.products %}
        {% render 'card-v10', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv10-promo">
            <span style="font-size: 40px; margin-bottom: 10px;">🦴</span>
            <h3>Treat Time!</h3>
            <a href="/discount/BARK20">20% Off Treats</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v10', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; font-weight: 700;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv10-seo">
      <h2 style="font-size: 26px; font-weight: 800; color: #86198F; margin-bottom: 15px;">{{ section.settings.seo_title | default: 'Because They Deserve the Best' }}</h2>
      <p style="font-size: 16px; font-weight: 600; color: #A21CAF; max-width: 800px; margin: 0 auto; line-height: 1.7;">{{ section.settings.seo_text | default: 'Our pet supplies are carefully vetted to ensure they are safe, durable, and bring maximum joy to your companions.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V10 — Pets", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#FDF4FF"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#701A75"}
  ], "presets": [{"name": "CL V10 — Pets"}]
}
{% endschema %}
