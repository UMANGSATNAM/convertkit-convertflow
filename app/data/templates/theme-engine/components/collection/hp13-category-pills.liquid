{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#00FFA3'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 40px;
    border-bottom: 1px solid #333;
  }
  
  .hp13-pills-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
  }
  
  .hp13-pill-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border: 1px solid #333;
    background: #111;
    color: #FFF;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.85rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 2px 2px 0 #000;
  }
  
  .hp13-pill-{{ section_id }}:hover {
    border-color: {{ text_color }};
    color: {{ text_color }};
    box-shadow: 2px 2px 0 {{ text_color }};
    transform: translate(-1px, -1px);
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 40px 20px;
    }
    .hp13-pills-container-{{ section_id }} {
      justify-content: flex-start;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 15px;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .hp13-pills-container-{{ section_id }}::-webkit-scrollbar {
      display: none;
    }
    .hp13-pill-{{ section_id }} {
      flex: 0 0 auto;
      white-space: nowrap;
    }
  }
</style>

<div class="hp13-pills-container-{{ section_id }}">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link | default: '#' }}" class="hp13-pill-{{ section_id }}" {{ block.shopify_attributes }}>
      [{{ block.settings.title | default: 'CATEGORY' }}]
    </a>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP13 Category Pills",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Highlight Color",
      "default": "#00FFA3"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Category Pill",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "CATEGORY"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP13 Category Pills",
      "blocks": [
        { "type": "pill", "settings": { "title": "OUTERWEAR" } },
        { "type": "pill", "settings": { "title": "MID-LAYERS" } },
        { "type": "pill", "settings": { "title": "BOTTOMS" } },
        { "type": "pill", "settings": { "title": "FOOTWEAR" } },
        { "type": "pill", "settings": { "title": "ACCESSORIES" } }
      ]
    }
  ]
}
{% endschema %}
