{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 4px solid var(--border-color);
  }

  .hp30-cat-pills-wrapper {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp30-cat-pills-wrapper {
      padding: 0 20px;
    }
  }

  .hp30-cat-pills__scroll {
    display: flex;
    gap: 15px;
    overflow-x: auto;
    padding-bottom: 20px;
    scrollbar-width: thin;
    scrollbar-color: var(--text-color) var(--bg-color);
  }

  .hp30-cat-pills__scroll::-webkit-scrollbar {
    height: 8px;
  }
  .hp30-cat-pills__scroll::-webkit-scrollbar-track {
    background: var(--bg-color);
    border: 2px solid var(--border-color);
  }
  .hp30-cat-pills__scroll::-webkit-scrollbar-thumb {
    background: var(--text-color);
  }

  .hp30-cat-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 15px 30px;
    background: var(--bg-color);
    border: 4px solid var(--border-color);
    color: var(--text-color);
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 1px;
    white-space: nowrap;
    transition: background-color 0s, color 0s, border-color 0s;
  }

  .hp30-cat-pill:hover,
  .hp30-cat-pill.is-active {
    background: var(--text-color);
    color: var(--bg-color);
    border-color: var(--text-color);
  }

  .hp30-cat-pill--accent:hover {
    background: var(--accent-color);
    color: var(--bg-color);
    border-color: var(--accent-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp30-cat-pills-wrapper" id="HP30CatPills-{{ section.id }}">
  <div class="hp30-cat-pills__scroll">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" 
         class="hp30-cat-pill {% if forloop.first %}is-active{% endif %} {% if block.settings.is_accent %}hp30-cat-pill--accent{% endif %}"
         {{ block.shopify_attributes }}>
        {{ block.settings.title }}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP30 - Brutalist Pills",
  "class": "section-hp30-category-pills",
  "settings": [
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (White)",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text / Active (Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Hover (Red)",
      "default": "#FF0000"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "CATEGORY"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        },
        {
          "type": "checkbox",
          "id": "is_accent",
          "label": "Use Accent Color on Hover",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP30 - Brutalist Pills",
      "blocks": [
        { "type": "category", "settings": { "title": "VIEW ALL" } },
        { "type": "category", "settings": { "title": "OUTERWEAR" } },
        { "type": "category", "settings": { "title": "TOPS" } },
        { "type": "category", "settings": { "title": "BOTTOMS" } },
        { "type": "category", "settings": { "title": "ACCESSORIES" } },
        { "type": "category", "settings": { "title": "SALE", "is_accent": true } }
      ]
    }
  ]
}
{% endschema %}
