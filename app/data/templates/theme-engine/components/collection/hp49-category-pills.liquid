{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp49-pills-bg: {{ section.settings.bg_color | default: '#F5F3FF' }};
    
    background-color: var(--hp49-pills-bg);
    padding: {{ section.settings.padding_vertical | default: 35 }}px 0;
  }

  .hp49-pills__wrap {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hp49-pill {
    padding: 11px 26px;
    background: #FFFFFF;
    border: 1px solid rgba(124, 58, 237, 0.2);
    border-radius: 50px;
    color: #2E1065;
    font-family: 'Urbanist', sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 12px rgba(124, 58, 237, 0.04);
  }

  .hp49-pill:hover, .hp49-pill--active {
    background: #7C3AED;
    color: #FFFFFF;
    border-color: #7C3AED;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(124, 58, 237, 0.3);
  }

  @media screen and (max-width: 576px) {
    .hp49-pills__wrap { justify-content: flex-start; overflow-x: auto; flex-wrap: nowrap; }
    .hp49-pill { flex-shrink: 0; }
  }
{%- endstyle -%}

<div class="hp49-pills__wrap">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url | default: '/collections/all' }}" class="hp49-pill {% if forloop.first %}hp49-pill--active{% endif %}" {{ block.shopify_attributes }}>
        {{ block.settings.title }}
      </a>
    {%- endfor -%}
  {%- else -%}
    <a href="/collections/all" class="hp49-pill hp49-pill--active">🌸 All Dream Formulas</a>
    <a href="/collections/lavender" class="hp49-pill">🌿 Alpine Lavender Serums</a>
    <a href="/collections/blossom" class="hp49-pill">🌸 Cherry Blossom Mists</a>
    <a href="/collections/creams" class="hp49-pill">☁️ Lilac Cushion Crèmes</a>
    <a href="/collections/balms" class="hp49-pill">✨ Melt-In Cleansing Balms</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP49 - Lavender Pills",
  "class": "section-hp49-pills",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F3FF" },
    { "type": "range", "id": "padding_vertical", "min": 10, "max": 70, "step": 5, "unit": "px", "label": "Vertical Padding", "default": 35 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1100 }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill",
      "settings": [
        { "type": "text", "id": "title", "label": "Label", "default": "🌸 All Dream Formulas" },
        { "type": "url", "id": "url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    { "name": "HP49 - Lavender Pills" }
  ]
}
{% endschema %}
