{%- comment -%}
  sections/hp33-footer.liquid
  Dedicated Footer for Homepage 33
{%- endcomment -%}

{%- liquid
  assign section_id = 'hp33-ftr-' | append: section.id
-%}

<style>
  #shopify-section-{{ section.id }} {
    --ftr-bg: {{ section.settings.bg_color | default: '#111827' }};
    --ftr-text: {{ section.settings.text_color | default: '#f9fafb' }};
    --ftr-muted: {{ section.settings.muted_color | default: '#9ca3af' }};
    --ftr-accent: {{ section.settings.primary_color | default: '#2563eb' }};
  }

  .hp33-footer {
    background: var(--ftr-bg);
    color: var(--ftr-text);
    padding: 64px 0 32px;
  }
  .hp33-footer__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .hp33-footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 48px;
  }
  .hp33-footer__brand {
    font-family: var(--font-heading, sans-serif);
    font-weight: 800;
    font-size: 24px;
    color: #ffffff;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hp33-footer__brand-dot {
    width: 8px;
    height: 8px;
    background: var(--ftr-accent);
    border-radius: 50%;
  }
  .hp33-footer__desc {
    font-size: 14px;
    color: var(--ftr-muted);
    line-height: 1.6;
    max-width: 320px;
  }
  .hp33-footer__title {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #ffffff;
    margin-bottom: 18px;
  }
  .hp33-footer__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hp33-footer__nav a {
    font-size: 14px;
    color: var(--ftr-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .hp33-footer__nav a:hover {
    color: #ffffff;
  }
  .hp33-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    color: var(--ftr-muted);
  }
  .hp33-footer__links {
    display: flex;
    gap: 16px;
  }
  .hp33-footer__links a {
    color: var(--ftr-muted);
    text-decoration: none;
  }
  .hp33-footer__links a:hover {
    color: #ffffff;
  }
  @media (max-width: 768px) {
    .hp33-footer__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .hp33-footer__bottom {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }
</style>

<footer class="hp33-footer" id="{{ section_id }}">
  <div class="hp33-footer__container">
    <div class="hp33-footer__grid">
      <div>
        <div class="hp33-footer__brand">
          {{ section.settings.brand_name | default: 'STORE' }}
          <span class="hp33-footer__brand-dot"></span>
        </div>
        <p class="hp33-footer__desc">
          {{ section.settings.about_text | default: 'Premium products crafted with excellence and care.' }}
        </p>
      </div>

      <div>
        <h4 class="hp33-footer__title">Navigation</h4>
        <ul class="hp33-footer__nav">
          <li><a href="#hero">Home</a></li>
          <li><a href="#featured">Shop</a></li>
          <li><a href="#categories">Collections</a></li>
          <li><a href="#story">About Us</a></li>
        </ul>
      </div>

      <div>
        <h4 class="hp33-footer__title">Categories</h4>
        <ul class="hp33-footer__nav">
          <li><a href="#categories">New Arrivals</a></li>
          <li><a href="#categories">Best Sellers</a></li>
          <li><a href="#categories">Featured</a></li>
          <li><a href="#categories">Special Offers</a></li>
        </ul>
      </div>

      <div>
        <h4 class="hp33-footer__title">Connect</h4>
        <ul class="hp33-footer__nav">
          <li><a href="https://instagram.com" target="_blank">Instagram</a></li>
          <li><a href="https://facebook.com" target="_blank">Facebook</a></li>
          <li><a href="https://twitter.com" target="_blank">Twitter</a></li>
          <li><a href="https://tiktok.com" target="_blank">TikTok</a></li>
        </ul>
      </div>
    </div>

    <div class="hp33-footer__bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'STORE' }}. All rights reserved.</div>
      <div class="hp33-footer__links">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "HP33 Footer",
  "tag": "section",
  "class": "section-hp33-footer",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand Name", "default": "STORE" },
    { "type": "textarea", "id": "about_text", "label": "About Text", "default": "Premium products crafted with excellence and care." },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#111827" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#f9fafb" },
    { "type": "color", "id": "primary_color", "label": "Accent Color", "default": "#2563eb" }
  ],
  "presets": [{ "name": "HP33 Footer" }]
}
{% endschema %}
