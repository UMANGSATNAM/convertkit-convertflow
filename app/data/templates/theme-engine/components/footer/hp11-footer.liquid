{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 80px 20px 40px;
    color: {{ text_color }};
  }
  
  .hp11-footer-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp11-footer-top-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 40px;
    margin-bottom: 80px;
  }
  
  .hp11-footer-logo-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 3.5rem;
    font-weight: 900;
    color: #CCFF00;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: -2px;
    display: block;
  }
  
  .hp11-footer-menu-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  
  .hp11-footer-title-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 900;
    color: #FF00FF;
    text-transform: uppercase;
    margin: 0 0 10px 0;
  }
  
  .hp11-footer-link-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: {{ text_color }};
    text-decoration: none;
    text-transform: uppercase;
  }
  
  .hp11-footer-link-{{ section_id }}:hover {
    color: #CCFF00;
  }
  
  .hp11-footer-bottom-{{ section_id }} {
    border-top: 3px solid #FFF;
    padding-top: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
  }
  
  .hp11-footer-socials-{{ section_id }} {
    display: flex;
    gap: 20px;
  }
  
  .hp11-footer-social-link-{{ section_id }} {
    color: #FFF;
    text-decoration: none;
    font-weight: 900;
  }
  
  .hp11-footer-social-link-{{ section_id }}:hover {
    color: #FF00FF;
  }

  @media (max-width: 768px) {
    .hp11-footer-top-{{ section_id }} {
      flex-direction: column;
    }
    .hp11-footer-bottom-{{ section_id }} {
      flex-direction: column;
      text-align: center;
      gap: 20px;
    }
  }
</style>

<div class="hp11-footer-container-{{ section_id }}">
  <div class="hp11-footer-top-{{ section_id }}">
    <div>
      <a href="/" class="hp11-footer-logo-{{ section_id }}">
        {{ shop.name | default: 'STREET' }}
      </a>
    </div>
    
    <div class="hp11-footer-menu-{{ section_id }}">
      <div class="hp11-footer-title-{{ section_id }}">SHOP</div>
      <a href="#" class="hp11-footer-link-{{ section_id }}">ALL PRODUCTS</a>
      <a href="#" class="hp11-footer-link-{{ section_id }}">HOODIES</a>
      <a href="#" class="hp11-footer-link-{{ section_id }}">TEES</a>
      <a href="#" class="hp11-footer-link-{{ section_id }}">BOTTOMS</a>
    </div>
    
    <div class="hp11-footer-menu-{{ section_id }}">
      <div class="hp11-footer-title-{{ section_id }}">SUPPORT</div>
      <a href="#" class="hp11-footer-link-{{ section_id }}">FAQ</a>
      <a href="#" class="hp11-footer-link-{{ section_id }}">RETURNS</a>
      <a href="#" class="hp11-footer-link-{{ section_id }}">CONTACT</a>
    </div>
  </div>
  
  <div class="hp11-footer-bottom-{{ section_id }}">
    <div>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. ALL RIGHTS RESERVED.</div>
    <div class="hp11-footer-socials-{{ section_id }}">
      <a href="#" class="hp11-footer-social-link-{{ section_id }}">IG</a>
      <a href="#" class="hp11-footer-social-link-{{ section_id }}">TT</a>
      <a href="#" class="hp11-footer-social-link-{{ section_id }}">X</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP11 Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "HP11 Footer"
    }
  ]
}
{% endschema %}
