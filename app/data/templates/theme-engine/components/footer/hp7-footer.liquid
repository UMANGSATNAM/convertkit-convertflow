{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#2b302a'
  assign text_color = section.settings.text_color | default: '#f7f4ed'
  assign accent_color = section.settings.accent_color | default: '#4a6741'
  assign menu1 = linklists[section.settings.menu_1]
  assign menu2 = linklists[section.settings.menu_2]
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: 100px 20px 40px 20px;
    font-family: 'DM Sans', sans-serif;
    border-radius: 60px 60px 0 0; /* Organic curve at the top */
    margin-top: -30px;
    position: relative;
    z-index: 10;
  }
  
  .hp7-footer-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 60px;
  }
  
  .hp7-footer-brand-{{ section_id }} {
    max-width: 400px;
  }
  
  .hp7-footer-logo-{{ section_id }} {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 700;
    color: {{ text_color }};
    text-decoration: none;
    margin-bottom: 20px;
    display: inline-block;
  }
  
  .hp7-footer-desc-{{ section_id }} {
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.8;
    margin-bottom: 40px;
  }
  
  .hp7-footer-newsletter-{{ section_id }} h4 {
    font-size: 1.1rem;
    margin: 0 0 15px 0;
    font-weight: 600;
  }
  
  .hp7-footer-form-{{ section_id }} {
    display: flex;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 30px;
    padding: 5px;
    border: 1px solid rgba(247, 244, 237, 0.2);
  }
  
  .hp7-footer-input-{{ section_id }} {
    flex-grow: 1;
    background: transparent;
    border: none;
    padding: 10px 20px;
    color: {{ text_color }};
    font-family: 'DM Sans', sans-serif;
    outline: none;
  }
  
  .hp7-footer-input-{{ section_id }}::placeholder {
    color: {{ text_color | color_modify: 'alpha', 0.5 }};
  }
  
  .hp7-footer-btn-{{ section_id }} {
    background: {{ accent_color }};
    color: #fff;
    border: none;
    padding: 10px 25px;
    border-radius: 25px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.3s ease;
  }
  
  .hp7-footer-btn-{{ section_id }}:hover {
    background: #ffffff;
    color: {{ accent_color }};
  }
  
  .hp7-footer-menu-{{ section_id }} h4 {
    font-size: 1.2rem;
    font-family: 'Playfair Display', serif;
    margin: 0 0 25px 0;
    font-weight: 500;
  }
  
  .hp7-footer-links-{{ section_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  
  .hp7-footer-links-{{ section_id }} a {
    color: {{ text_color | color_modify: 'alpha', 0.7 }};
    text-decoration: none;
    transition: color 0.3s ease;
    font-size: 0.95rem;
  }
  
  .hp7-footer-links-{{ section_id }} a:hover {
    color: {{ text_color }};
  }
  
  .hp7-footer-bottom-{{ section_id }} {
    max-width: 1400px;
    margin: 80px auto 0 auto;
    padding-top: 30px;
    border-top: 1px solid rgba(247, 244, 237, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: {{ text_color | color_modify: 'alpha', 0.6 }};
  }
  
  .hp7-social-icons-{{ section_id }} {
    display: flex;
    gap: 15px;
  }
  
  .hp7-social-icons-{{ section_id }} a {
    color: inherit;
    transition: color 0.3s ease;
  }
  
  .hp7-social-icons-{{ section_id }} a:hover {
    color: {{ text_color }};
  }
  
  .hp7-social-icons-{{ section_id }} svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  @media (max-width: 992px) {
    .hp7-footer-container-{{ section_id }} {
      grid-template-columns: 1fr;
      gap: 50px;
    }
    .hp7-footer-brand-{{ section_id }} {
      max-width: 100%;
    }
  }
  
  @media (max-width: 576px) {
    #shopify-section-{{ section_id }} {
      border-radius: 40px 40px 0 0;
      padding: 60px 20px 30px 20px;
    }
    .hp7-footer-bottom-{{ section_id }} {
      flex-direction: column;
      gap: 20px;
      text-align: center;
    }
  }
</style>

<div class="hp7-footer-container-{{ section_id }}">
  <div class="hp7-footer-brand-{{ section_id }}">
    <a href="/" class="hp7-footer-logo-{{ section_id }}">{{ shop.name }}</a>
    <p class="hp7-footer-desc-{{ section_id }}">Creating beautiful, sustainable products for everyday living. Better for you, better for the planet.</p>
    
    <div class="hp7-footer-newsletter-{{ section_id }}">
      <h4>Join our community</h4>
      {% form 'customer', class: 'hp7-footer-form-' | append: section_id %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" class="hp7-footer-input-{{ section_id }}" placeholder="Email address" required>
        <button type="submit" class="hp7-footer-btn-{{ section_id }}">Subscribe</button>
      {% endform %}
    </div>
  </div>
  
  <div class="hp7-footer-menu-{{ section_id }}">
    <h4>{{ section.settings.menu_1_title | default: 'Shop' }}</h4>
    <ul class="hp7-footer-links-{{ section_id }}">
      {% if menu1.links != blank %}
        {% for link in menu1.links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      {% else %}
        <li><a href="#">New Arrivals</a></li>
        <li><a href="#">Best Sellers</a></li>
        <li><a href="#">Clothing</a></li>
        <li><a href="#">Accessories</a></li>
        <li><a href="#">Gift Cards</a></li>
      {% endif %}
    </ul>
  </div>
  
  <div class="hp7-footer-menu-{{ section_id }}">
    <h4>{{ section.settings.menu_2_title | default: 'About' }}</h4>
    <ul class="hp7-footer-links-{{ section_id }}">
      {% if menu2.links != blank %}
        {% for link in menu2.links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      {% else %}
        <li><a href="#">Our Story</a></li>
        <li><a href="#">Sustainability</a></li>
        <li><a href="#">Materials</a></li>
        <li><a href="#">Contact Us</a></li>
        <li><a href="#">FAQ</a></li>
      {% endif %}
    </ul>
  </div>
</div>

<div class="hp7-footer-bottom-{{ section_id }}">
  <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</div>
  
  <div class="hp7-social-icons-{{ section_id }}">
    <a href="#" aria-label="Instagram">
      <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
    </a>
    <a href="#" aria-label="Facebook">
      <svg viewBox="0 0 24 24"><path d="M12 2.04C6.5 2.04 2 6.53 2 12.06C2 17.06 5.66 21.21 10.44 21.96V14.96H7.9V12.06H10.44V9.85C10.44 7.34 11.93 5.96 14.22 5.96C15.31 5.96 16.45 6.15 16.45 6.15V8.62H15.19C13.95 8.62 13.56 9.39 13.56 10.18V12.06H16.34L15.89 14.96H13.56V21.96A10 10 0 0 0 22 12.06C22 6.53 17.5 2.04 12 2.04Z"/></svg>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP7 Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#2b302a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f7f4ed"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#4a6741"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Menu 1 Title",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Menu 2 Title",
      "default": "About"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2"
    }
  ],
  "presets": [
    {
      "name": "HP7 Footer"
    }
  ]
}
{% endschema %}
