{% comment %}
  Footer Trust Badges - High-assurance footer featuring 4 guarantee pillars and security seals
{% endcomment %}

<footer class="footer-trust-badges" id="FooterTrustBadges-{{ section.id }}">
  <!-- Trust Pillars Strip -->
  <div class="trust-pillars-bar">
    <div class="pillars-inner">
      <div class="pillar-box">
        <div class="pillar-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </div>
        <div class="pillar-text">
          <h5>{{ section.settings.pillar_1_title | default: 'Free Express Shipping' }}</h5>
          <p>{{ section.settings.pillar_1_sub | default: 'On all orders over $60 worldwide' }}</p>
        </div>
      </div>

      <div class="pillar-box">
        <div class="pillar-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div class="pillar-text">
          <h5>{{ section.settings.pillar_2_title | default: '30-Day Guarantee' }}</h5>
          <p>{{ section.settings.pillar_2_sub | default: '100% money back if not satisfied' }}</p>
        </div>
      </div>

      <div class="pillar-box">
        <div class="pillar-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <div class="pillar-text">
          <h5>{{ section.settings.pillar_3_title | default: '256-Bit SSL Secure' }}</h5>
          <p>{{ section.settings.pillar_3_sub | default: 'Bank-grade encryption standard' }}</p>
        </div>
      </div>

      <div class="pillar-box">
        <div class="pillar-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <div class="pillar-text">
          <h5>{{ section.settings.pillar_4_title | default: '24/7 Human Support' }}</h5>
          <p>{{ section.settings.pillar_4_sub | default: 'Real agents ready to assist anytime' }}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Standard Footer Links Section -->
  <div class="lower-footer">
    <div class="lower-inner">
      <div class="lower-col-left">
        <span class="lower-brand">{{ shop.name | default: 'SECURE STORE' }}</span>
        <p class="lower-desc">Premium goods protected with industry-leading buyer assurance and global fulfillment guarantees.</p>
      </div>

      <div class="lower-col-links">
        <div class="sub-link-col">
          <h6>Customer Help</h6>
          <a href="/pages/tracking">Order Status</a>
          <a href="/pages/returns">Returns Portal</a>
          <a href="/pages/shipping">Shipping Rates</a>
        </div>
        <div class="sub-link-col">
          <h6>Legal & Safety</h6>
          <a href="/policies/privacy">Privacy Policy</a>
          <a href="/policies/terms">Terms of Service</a>
          <a href="/pages/security">Security Assurance</a>
        </div>
      </div>
    </div>

    <div class="bottom-legal-row">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name | default: 'Store' }}. Verified Secure Merchant.</span>
      <div class="shield-badges">
        <span class="shield-pill">🔒 Verified Merchant</span>
        <span class="shield-pill">🛡️ Buyer Protection</span>
      </div>
    </div>
  </div>
</footer>

<style>
  #FooterTrustBadges-{{ section.id }} {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    box-sizing: border-box;
  }
  #FooterTrustBadges-{{ section.id }} * {
    box-sizing: border-box;
  }
  #FooterTrustBadges-{{ section.id }} .trust-pillars-bar {
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    padding: 36px 24px;
  }
  #FooterTrustBadges-{{ section.id }} .pillars-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  #FooterTrustBadges-{{ section.id }} .pillar-box {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  #FooterTrustBadges-{{ section.id }} .pillar-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: #2563eb;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  #FooterTrustBadges-{{ section.id }} .pillar-text h5 {
    margin: 0 0 4px 0;
    font-size: 14px;
    font-weight: 700;
    color: #0f172a;
  }
  #FooterTrustBadges-{{ section.id }} .pillar-text p {
    margin: 0;
    font-size: 12px;
    color: #64748b;
    line-height: 1.4;
  }
  #FooterTrustBadges-{{ section.id }} .lower-footer {
    background: #ffffff;
    padding: 48px 24px 28px;
  }
  #FooterTrustBadges-{{ section.id }} .lower-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 48px;
    padding-bottom: 40px;
    border-bottom: 1px solid #f1f5f9;
  }
  #FooterTrustBadges-{{ section.id }} .lower-brand {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #0f172a;
    display: block;
    margin-bottom: 10px;
  }
  #FooterTrustBadges-{{ section.id }} .lower-desc {
    max-width: 380px;
    font-size: 13px;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }
  #FooterTrustBadges-{{ section.id }} .lower-col-links {
    display: flex;
    gap: 60px;
  }
  #FooterTrustBadges-{{ section.id }} .sub-link-col h6 {
    margin: 0 0 14px 0;
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
  }
  #FooterTrustBadges-{{ section.id }} .sub-link-col a {
    display: block;
    color: #64748b;
    text-decoration: none;
    font-size: 13px;
    margin-bottom: 10px;
    transition: color 0.2s;
  }
  #FooterTrustBadges-{{ section.id }} .sub-link-col a:hover {
    color: #0f172a;
  }
  #FooterTrustBadges-{{ section.id }} .bottom-legal-row {
    max-width: 1280px;
    margin: 24px auto 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: #94a3b8;
  }
  #FooterTrustBadges-{{ section.id }} .shield-badges {
    display: flex;
    gap: 10px;
  }
  #FooterTrustBadges-{{ section.id }} .shield-pill {
    background: #ecfdf5;
    color: #059669;
    border: 1px solid #a7f3d0;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 6px;
  }

  @media (max-width: 900px) {
    #FooterTrustBadges-{{ section.id }} .pillars-inner {
      grid-template-columns: 1fr 1fr;
    }
    #FooterTrustBadges-{{ section.id }} .lower-inner {
      flex-direction: column;
    }
  }
  @media (max-width: 600px) {
    #FooterTrustBadges-{{ section.id }} .pillars-inner {
      grid-template-columns: 1fr;
    }
    #FooterTrustBadges-{{ section.id }} .bottom-legal-row {
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
    }
  }
</style>

