{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ff88'
-%}

<style>
  :root { --border-color: {{ s.border_color }}; }

  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 80px 20px 40px;
    color: {{ text_color }};
    border-top: 1px solid rgba(255,255,255,0.05);
    font-family: 'Space Mono', monospace;
  }
  
  .hp9-footer-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 50px;
  }
  
  .hp9-footer-col-{{ section_id }} {
    display: flex;
    flex-direction: column;
  }
  
  .hp9-footer-logo-{{ section_id }} {
    font-size: 2rem;
    font-weight: 900;
    color: #fff;
    text-decoration: none;
    margin-bottom: 20px;
    letter-spacing: -1px;
    font-family: 'Inter', sans-serif;
  }
  
  .hp9-footer-logo-{{ section_id }} span {
    color: {{ accent_color }};
  }
  
  .hp9-footer-text-{{ section_id }} {
    color: rgba(255,255,255,0.5);
    font-size: 0.85rem;
    line-height: 1.6;
    max-width: 300px;
    margin: 0;
  }
  
  .hp9-footer-title-{{ section_id }} {
    font-size: 0.9rem;
    font-weight: 700;
    color: {{ accent_color }};
    margin: 0 0 20px 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  
  .hp9-footer-link-{{ section_id }} {
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    font-size: 0.85rem;
    margin-bottom: 12px;
    transition: color 0.2s ease;
    display: inline-block;
  }
  
  .hp9-footer-link-{{ section_id }}:hover {
    color: #fff;
  }
  
  .hp9-footer-socials-{{ section_id }} {
    display: flex;
    gap: 15px;
  }
  
  .hp9-footer-social-link-{{ section_id }} {
    color: #fff;
    width: 35px;
    height: 35px;
    background: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    border: 1px solid rgba(255,255,255,0.1);
    transition: all 0.3s ease;
  }
  
  .hp9-footer-social-link-{{ section_id }} svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }
  
  .hp9-footer-social-link-{{ section_id }}:hover {
    background: {{ accent_color }};
    color: #000;
    border-color: {{ accent_color }};
  }
  
  .hp9-footer-bottom-{{ section_id }} {
    max-width: 1400px;
    margin: 60px auto 0;
    padding-top: 30px;
    border-top: 1px solid rgba(255,255,255,0.05);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.4);
  }
  
  .hp9-footer-status-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .hp9-footer-status-dot-{{ section_id }} {
    width: 8px;
    height: 8px;
    background-color: {{ accent_color }};
    border-radius: 50%;
    animation: hp9-pulse-dot-{{ section_id }} 2s infinite;
  }
  
  @keyframes hp9-pulse-dot-{{ section_id }} {
    0% { box-shadow: 0 0 0 0 rgba(0, 255, 136, 0.4); }
    70% { box-shadow: 0 0 0 6px rgba(0, 255, 136, 0); }
    100% { box-shadow: 0 0 0 0 rgba(0, 255, 136, 0); }
  }

  @media (max-width: 992px) {
    .hp9-footer-container-{{ section_id }} {
      grid-template-columns: 1fr 1fr;
    }
  }
  
  @media (max-width: 600px) {
    .hp9-footer-container-{{ section_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hp9-footer-bottom-{{ section_id }} {
      flex-direction: column;
      gap: 15px;
      text-align: center;
    }
  }
</style>

<div class="hp9-footer-container-{{ section_id }}">
  <div class="hp9-footer-col-{{ section_id }}">
    <a href="/" class="hp9-footer-logo-{{ section_id }}">
      {% if section.settings.logo_text != blank %}
        {{ section.settings.logo_text }}<span>.SYS</span>
      {% else %}
        {{ shop.name }}<span>.SYS</span>
      {% endif %}
    </a>
    <p class="hp9-footer-text-{{ section_id }}">{{ section.settings.text | default: 'Next-generation hardware designed for performance enthusiasts. Secure, reliable, unmatched.' }}</p>
  </div>
  
  <div class="hp9-footer-col-{{ section_id }}">
    <h4 class="hp9-footer-title-{{ section_id }}">NAVIGATION</h4>
    {% if section.settings.menu != blank %}
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}" class="hp9-footer-link-{{ section_id }}">{{ link.title }}</a>
      {% endfor %}
    {% else %}
      {%- assign cf_menu = section.settings.menu | default: linklists['footer'] -%}

      {%- if cf_menu == blank -%}{%- assign cf_menu = linklists['main-menu'] -%}{%- endif -%}

      {%- for link in cf_menu.links -%}

        <a href="{{ link.url }}" class="hp9-footer-link-{{ section_id }}">{{ link.title }}</a>

      {%- endfor -%}
    {% endif %}
  </div>
  
  <div class="hp9-footer-col-{{ section_id }}">
    <h4 class="hp9-footer-title-{{ section_id }}">LEGAL</h4>
    {%- assign cf_menu = section.settings.menu | default: linklists['footer'] -%}

    {%- if cf_menu == blank -%}{%- assign cf_menu = linklists['main-menu'] -%}{%- endif -%}

    {%- for link in cf_menu.links -%}

      <a href="{{ link.url }}" class="hp9-footer-link-{{ section_id }}">{{ link.title }}</a>

    {%- endfor -%}
  </div>
  
  <div class="hp9-footer-col-{{ section_id }}">
    <h4 class="hp9-footer-title-{{ section_id }}">COMM_CHANNELS</h4>
    <div class="hp9-footer-socials-{{ section_id }}">
      <a href="#" class="hp9-footer-social-link-{{ section_id }}" aria-label="Twitter">
        <svg viewBox="0 0 24 24"><path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.05c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.521 8.521 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z"/></svg>
      </a>
      <a href="#" class="hp9-footer-social-link-{{ section_id }}" aria-label="Instagram">
        <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
      </a>
      <a href="#" class="hp9-footer-social-link-{{ section_id }}" aria-label="GitHub">
        <svg viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
      </a>
    </div>
  </div>
</div>

<div class="hp9-footer-bottom-{{ section_id }}">
  <div>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. ALL RIGHTS RESERVED.</div>
  <div class="hp9-footer-status-{{ section_id }}">
    <div class="hp9-footer-status-dot-{{ section_id }}"></div>
    SYSTEMS_ONLINE
  </div>
</div>

{% schema %}
{
  "name": "HP9 Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ff88"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "NEON"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description Text",
      "default": "Next-generation hardware designed for performance enthusiasts. Secure, reliable, unmatched."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer Menu"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border colour",
      "default": "#E5E7EB"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_note",
      "label": "Copyright line",
      "info": "The year and store name are added automatically.",
      "default": "All rights reserved."
    }
  ],
  "presets": [
    {
      "name": "HP9 Footer"
    }
  ]
}
{% endschema %}
