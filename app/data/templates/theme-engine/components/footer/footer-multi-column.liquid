{% comment %}
  Footer Multi Column - Comprehensive 4-column ecommerce footer with newsletter, customer care, and payment icons
{% endcomment %}

<footer class="footer-multi-column" id="FooterMultiColumn-{{ section.id }}">
  <div class="footer-container">
    <div class="footer-main-grid">
      <!-- Col 1: Brand Story -->
      <div class="grid-col brand-col">
        <h3 class="col-brand-name">{{ section.settings.brand_title | default: 'ATELIER BOTANICA' }}</h3>
        <p class="brand-desc">
          {{ section.settings.brand_desc | default: 'Crafting thoughtful essentials for modern living. Sustainably sourced, ethically made, and built to last a lifetime.' }}
        </p>
        <div class="social-icons">
          <a href="#" aria-label="Instagram" class="social-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="#" aria-label="Twitter" class="social-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
          </a>
          <a href="#" aria-label="YouTube" class="social-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Shop Links -->
      <div class="grid-col">
        <h4 class="col-heading">Explore</h4>
        <ul class="col-links">
          <li><a href="/collections/all">New Arrivals</a></li>
          <li><a href="/collections/best-sellers">Best Sellers</a></li>
          <li><a href="/pages/sustainability">Sustainability</a></li>
          <li><a href="/collections/gift-sets">Gift Cards</a></li>
          <li><a href="/pages/lookbook">Lookbook 2026</a></li>
        </ul>
      </div>

      <!-- Col 3: Customer Care -->
      <div class="grid-col">
        <h4 class="col-heading">Support</h4>
        <ul class="col-links">
          <li><a href="/pages/contact">Contact Us</a></li>
          <li><a href="/pages/shipping">Shipping & Delivery</a></li>
          <li><a href="/pages/returns">Returns & Exchanges</a></li>
          <li><a href="/pages/track-order">Track My Order</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter -->
      <div class="grid-col newsletter-col">
        <h4 class="col-heading">{{ section.settings.newsletter_title | default: 'Stay in the loop' }}</h4>
        <p class="news-text">
          {{ section.settings.newsletter_sub | default: 'Subscribe to receive special offers, free giveaways, and once-in-a-lifetime deals.' }}
        </p>
        <form class="news-form" onsubmit="event.preventDefault(); alert('Subscribed successfully!');">
          <div class="input-wrap">
            <input type="email" placeholder="Your email address" required class="email-input" />
            <button type="submit" class="submit-btn" aria-label="Subscribe">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom-bar">
      <div class="copy-text">
        © {{ 'now' | date: '%Y' }} {{ shop.name | default: 'Atelier' }}. All rights reserved.
      </div>
      <div class="legal-links">
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <a href="/policies/terms-of-service">Terms of Service</a>
        <a href="/policies/refund-policy">Refund Policy</a>
      </div>
      <div class="payment-badges">
        <span class="pay-chip">VISA</span>
        <span class="pay-chip">MC</span>
        <span class="pay-chip">AMEX</span>
        <span class="pay-chip">APPLE PAY</span>
        <span class="pay-chip">PAYPAL</span>
      </div>
    </div>
  </div>
</footer>

<style>
  #FooterMultiColumn-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#0f172a' }};
    color: #94a3b8;
    padding: 70px 24px 32px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  #FooterMultiColumn-{{ section.id }} * {
    box-sizing: border-box;
  }
  #FooterMultiColumn-{{ section.id }} .footer-container {
    max-width: 1320px;
    margin: 0 auto;
  }
  #FooterMultiColumn-{{ section.id }} .footer-main-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.8fr;
    gap: 48px;
    padding-bottom: 56px;
    border-bottom: 1px solid #1e293b;
  }
  #FooterMultiColumn-{{ section.id }} .col-brand-name {
    color: #ffffff;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin: 0 0 16px 0;
  }
  #FooterMultiColumn-{{ section.id }} .brand-desc {
    font-size: 14px;
    line-height: 1.6;
    margin: 0 0 24px 0;
    max-width: 320px;
  }
  #FooterMultiColumn-{{ section.id }} .social-icons {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  #FooterMultiColumn-{{ section.id }} .social-link {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #1e293b;
    color: #cbd5e1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  #FooterMultiColumn-{{ section.id }} .social-link:hover {
    background: #334155;
    color: #ffffff;
  }
  #FooterMultiColumn-{{ section.id }} .col-heading {
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 20px 0;
  }
  #FooterMultiColumn-{{ section.id }} .col-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  #FooterMultiColumn-{{ section.id }} .col-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }
  #FooterMultiColumn-{{ section.id }} .col-links a:hover {
    color: #ffffff;
  }
  #FooterMultiColumn-{{ section.id }} .news-text {
    font-size: 14px;
    line-height: 1.5;
    margin: 0 0 16px 0;
  }
  #FooterMultiColumn-{{ section.id }} .input-wrap {
    display: flex;
    align-items: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 4px;
  }
  #FooterMultiColumn-{{ section.id }} .email-input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 10px 14px;
    color: #ffffff;
    font-size: 14px;
    outline: none;
  }
  #FooterMultiColumn-{{ section.id }} .submit-btn {
    background: #ffffff;
    color: #0f172a;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  #FooterMultiColumn-{{ section.id }} .submit-btn:hover {
    opacity: 0.9;
  }
  #FooterMultiColumn-{{ section.id }} .footer-bottom-bar {
    padding-top: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 13px;
  }
  #FooterMultiColumn-{{ section.id }} .legal-links {
    display: flex;
    gap: 20px;
  }
  #FooterMultiColumn-{{ section.id }} .legal-links a {
    color: #94a3b8;
    text-decoration: none;
  }
  #FooterMultiColumn-{{ section.id }} .legal-links a:hover {
    color: #ffffff;
  }
  #FooterMultiColumn-{{ section.id }} .payment-badges {
    display: flex;
    gap: 8px;
  }
  #FooterMultiColumn-{{ section.id }} .pay-chip {
    background: #1e293b;
    color: #cbd5e1;
    font-size: 10px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    border: 1px solid #334155;
  }

  @media (max-width: 900px) {
    #FooterMultiColumn-{{ section.id }} .footer-main-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    #FooterMultiColumn-{{ section.id }} .footer-bottom-bar {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

{% schema %}
{
  "name": "Footer Multi Column",
  "settings": [
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand Title",
      "default": "ATELIER BOTANICA"
    },
    {
      "type": "textarea",
      "id": "brand_desc",
      "label": "Brand Description",
      "default": "Crafting thoughtful essentials for modern living. Sustainably sourced, ethically made, and built to last a lifetime."
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Title",
      "default": "Stay in the loop"
    },
    {
      "type": "textarea",
      "id": "newsletter_sub",
      "label": "Newsletter Subtitle",
      "default": "Subscribe to receive special offers, free giveaways, and once-in-a-lifetime deals."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0f172a"
    }
  ],
  "presets": [
    {
      "name": "Footer Multi Column"
    }
  ]
}
{% endschema %}
