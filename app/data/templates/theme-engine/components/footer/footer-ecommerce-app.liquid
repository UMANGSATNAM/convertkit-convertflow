{% comment %}
  Footer Ecommerce App - Mobile app download callouts, multi-currency switcher, and collapsible link groups
{% endcomment %}

<footer class="footer-ecommerce-app" id="FooterEcommerceApp-{{ section.id }}">
  <div class="app-footer-wrap">
    <!-- Top App Download Banner -->
    <div class="app-banner-card">
      <div class="app-banner-text">
        <span class="pill-new">NEW MOBILE EXPERIENCE</span>
        <h3>{{ section.settings.app_title | default: 'Shop Faster on the Official App' }}</h3>
        <p>{{ section.settings.app_desc | default: 'Download now to unlock exclusive app-only 20% discounts and real-time shipment notifications.' }}</p>
      </div>

      <div class="app-buttons">
        <a href="#" class="store-badge-btn" aria-label="Download on the App Store">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.93-2.85-.9.04-2 .6-2.65 1.35-.58.66-1.08 1.73-.95 2.76 1.01.08 2.05-.51 2.67-1.26z"/></svg>
          <div class="badge-text">
            <small>Download on the</small>
            <span>App Store</span>
          </div>
        </a>

        <a href="#" class="store-badge-btn" aria-label="Get it on Google Play">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3.609 1.814L13.792 12 3.61 22.186a1.99 1.99 0 0 1-.22-.924V2.738c0-.334.078-.65.22-.924zM15.207 13.414l2.296 2.296-12.06 6.892 9.764-9.188zM17.503 8.29l-2.296 2.296-9.764-9.188 12.06 6.892zm1.414 1.414l2.84 1.623a1.2 1.2 0 0 1 0 2.072l-2.84 1.623-2.072-2.072 2.072-2.072z"/></svg>
          <div class="badge-text">
            <small>GET IT ON</small>
            <span>Google Play</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Navigation Link Columns -->
    <div class="nav-grid">
      <div class="nav-group">
        <h4>Catalog</h4>
        <a href="/collections">All Collections</a>
        <a href="/collections/trending">Trending Releases</a>
        <a href="/collections/clearance">Final Clearance</a>
        <a href="/collections/gift-cards">Digital Gift Cards</a>
      </div>

      <div class="nav-group">
        <h4>Company</h4>
        <a href="/pages/about">Our Atelier</a>
        <a href="/pages/craftsmanship">Craftsmanship</a>
        <a href="/pages/careers">Careers (We're Hiring)</a>
        <a href="/pages/press">Press & Media</a>
      </div>

      <div class="nav-group">
        <h4>Client Services</h4>
        <a href="/pages/contact">Personal Stylist</a>
        <a href="/pages/shipping">Worldwide Shipping</a>
        <a href="/pages/returns">Easy Exchanges</a>
        <a href="/pages/warranty">Lifetime Warranty</a>
      </div>

      <div class="nav-group locale-group">
        <h4>Preferences</h4>
        <label for="CurrencySelect-{{ section.id }}" class="sr-only">Currency</label>
        <select id="CurrencySelect-{{ section.id }}" class="currency-dropdown">
          <option value="USD">🇺🇸 USD ($)</option>
          <option value="EUR">🇪🇺 EUR (€)</option>
          <option value="GBP">🇬🇧 GBP (£)</option>
          <option value="CAD">🇨🇦 CAD ($)</option>
          <option value="AUD">🇦🇺 AUD ($)</option>
        </select>
        <p class="tax-note">Taxes & duties calculated automatically at checkout.</p>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="app-footer-bottom">
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name | default: 'ConvertFlow App' }}. All rights reserved.</p>
      <div class="safe-checkout">
        <span>🔒 100% Encrypted Safe Checkout</span>
      </div>
    </div>
  </div>
</footer>

<style>
  #FooterEcommerceApp-{{ section.id }} {
    background: #0f172a;
    color: #94a3b8;
    padding: 60px 24px 32px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  #FooterEcommerceApp-{{ section.id }} * {
    box-sizing: border-box;
  }
  #FooterEcommerceApp-{{ section.id }} .app-footer-wrap {
    max-width: 1280px;
    margin: 0 auto;
  }
  #FooterEcommerceApp-{{ section.id }} .app-banner-card {
    background: linear-gradient(135deg, #1e293b, #0f172a);
    border: 1px solid #334155;
    border-radius: 20px;
    padding: 36px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    margin-bottom: 56px;
  }
  #FooterEcommerceApp-{{ section.id }} .pill-new {
    display: inline-block;
    background: #2563eb;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 9999px;
    margin-bottom: 12px;
  }
  #FooterEcommerceApp-{{ section.id }} .app-banner-text h3 {
    margin: 0 0 8px 0;
    color: #ffffff;
    font-size: 24px;
    font-weight: 700;
  }
  #FooterEcommerceApp-{{ section.id }} .app-banner-text p {
    margin: 0;
    color: #cbd5e1;
    font-size: 14px;
    max-width: 480px;
    line-height: 1.5;
  }
  #FooterEcommerceApp-{{ section.id }} .app-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  #FooterEcommerceApp-{{ section.id }} .store-badge-btn {
    background: #000000;
    color: #ffffff;
    border: 1px solid #475569;
    border-radius: 12px;
    padding: 8px 18px;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }
  #FooterEcommerceApp-{{ section.id }} .store-badge-btn:hover {
    background: #1e293b;
    transform: translateY(-2px);
  }
  #FooterEcommerceApp-{{ section.id }} .badge-text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  #FooterEcommerceApp-{{ section.id }} .badge-text small {
    font-size: 9px;
    text-transform: uppercase;
    color: #94a3b8;
    line-height: 1.1;
  }
  #FooterEcommerceApp-{{ section.id }} .badge-text span {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
  }
  #FooterEcommerceApp-{{ section.id }} .nav-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 36px;
    padding-bottom: 48px;
    border-bottom: 1px solid #1e293b;
  }
  #FooterEcommerceApp-{{ section.id }} .nav-group h4 {
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 18px 0;
  }
  #FooterEcommerceApp-{{ section.id }} .nav-group a {
    display: block;
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
    margin-bottom: 12px;
    transition: color 0.2s;
  }
  #FooterEcommerceApp-{{ section.id }} .nav-group a:hover {
    color: #ffffff;
  }
  #FooterEcommerceApp-{{ section.id }} .currency-dropdown {
    width: 100%;
    max-width: 200px;
    background: #1e293b;
    border: 1px solid #334155;
    color: #ffffff;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 13px;
    outline: none;
    cursor: pointer;
    margin-bottom: 10px;
  }
  #FooterEcommerceApp-{{ section.id }} .tax-note {
    font-size: 12px;
    color: #64748b;
    line-height: 1.4;
    margin: 0;
  }
  #FooterEcommerceApp-{{ section.id }} .app-footer-bottom {
    padding-top: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
  }
  #FooterEcommerceApp-{{ section.id }} .safe-checkout {
    color: #10b981;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    #FooterEcommerceApp-{{ section.id }} .app-banner-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px;
    }
    #FooterEcommerceApp-{{ section.id }} .nav-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    #FooterEcommerceApp-{{ section.id }} .nav-grid {
      grid-template-columns: 1fr;
    }
    #FooterEcommerceApp-{{ section.id }} .app-footer-bottom {
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
    }
  }
</style>

{% schema %}
{
  "name": "Footer Ecommerce App",
  "settings": [
    {
      "type": "text",
      "id": "app_title",
      "label": "App Banner Title",
      "default": "Shop Faster on the Official App"
    },
    {
      "type": "textarea",
      "id": "app_desc",
      "label": "App Banner Description",
      "default": "Download now to unlock exclusive app-only 20% discounts and real-time shipment notifications."
    }
  ],
  "presets": [
    {
      "name": "Footer Ecommerce App"
    }
  ]
}
{% endschema %}
