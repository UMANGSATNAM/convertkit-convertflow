{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FF00FF'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 80px 40px 40px;
    color: {{ text_color }};
  }
  
  .hp16-footer-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
  }
  
  .hp16-footer-logo-wrap-{{ section_id }} {
    max-width: 300px;
  }
  
  .hp16-footer-logo-{{ section_id }} {
    font-family: 'Comic Sans MS', cursive;
    font-size: 3rem;
    font-weight: 900;
    color: #FFF;
    text-shadow: 3px 3px 0 #000;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 20px;
    transform: rotate(-3deg);
  }
  
  .hp16-footer-text-{{ section_id }} {
    font-family: 'Comic Sans MS', cursive;
    font-size: 1rem;
    font-weight: bold;
    line-height: 1.5;
  }
  
  .hp16-footer-heading-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: 1.2rem;
    text-transform: uppercase;
    margin: 0 0 20px 0;
    color: #00FFFF;
    text-shadow: 2px 2px 0 #000;
    -webkit-text-stroke: 1px #000;
  }
  
  .hp16-footer-menu-{{ section_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .hp16-footer-menu-{{ section_id }} li {
    margin-bottom: 12px;
  }
  
  .hp16-footer-menu-{{ section_id }} a {
    font-family: 'Comic Sans MS', cursive;
    font-size: 1rem;
    font-weight: bold;
    color: {{ text_color }};
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-block;
  }
  
  .hp16-footer-menu-{{ section_id }} a:hover {
    color: #FFF;
    text-shadow: 2px 2px 0 #000;
    transform: translateX(5px);
  }
  
  .hp16-footer-bottom-{{ section_id }} {
    max-width: 1400px;
    margin: 60px auto 0;
    padding-top: 30px;
    border-top: 4px dashed #000;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .hp16-footer-copyright-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: 0.9rem;
    text-transform: uppercase;
  }
  
  .hp16-footer-social-{{ section_id }} {
    display: flex;
    gap: 15px;
  }
  
  .hp16-footer-social-{{ section_id }} a {
    color: {{ text_color }};
    background: #FFF;
    border: 3px solid #000;
    border-radius: 50%;
    width: 40px; height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 3px 3px 0 #000;
    transition: all 0.2s ease;
  }
  
  .hp16-footer-social-{{ section_id }} a:hover {
    background: #FFFF00;
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 #000;
  }
  
  .hp16-footer-social-{{ section_id }} svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 992px) {
    .hp16-footer-container-{{ section_id }} {
      grid-template-columns: 1fr 1fr;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px 20px;
    }
    .hp16-footer-container-{{ section_id }} {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hp16-footer-logo-{{ section_id }} {
      transform: none;
    }
    .hp16-footer-menu-{{ section_id }} a:hover {
      transform: scale(1.05);
    }
    .hp16-footer-bottom-{{ section_id }} {
      flex-direction: column;
      gap: 20px;
    }
  }
</style>

<div class="hp16-footer-container-{{ section_id }}">
  <div class="hp16-footer-logo-wrap-{{ section_id }}">
    <a href="/" class="hp16-footer-logo-{{ section_id }}">{{ shop.name | default: 'Y2KGURL' }}</a>
    <p class="hp16-footer-text-{{ section_id }}">Bringing back the best era of fashion. Don't forget your lip gloss.</p>
  </div>
  
  <div class="hp16-footer-column-{{ section_id }}">
    <h4 class="hp16-footer-heading-{{ section_id }}">SHOP</h4>
    <ul class="hp16-footer-menu-{{ section_id }}">
      <li><a href="#">New Arrivals</a></li>
      <li><a href="#">Tops</a></li>
      <li><a href="#">Bottoms</a></li>
      <li><a href="#">Accessories</a></li>
    </ul>
  </div>
  
  <div class="hp16-footer-column-{{ section_id }}">
    <h4 class="hp16-footer-heading-{{ section_id }}">INFO</h4>
    <ul class="hp16-footer-menu-{{ section_id }}">
      <li><a href="#">About Us</a></li>
      <li><a href="#">Shipping</a></li>
      <li><a href="#">Returns</a></li>
      <li><a href="#">FAQ</a></li>
    </ul>
  </div>
  
  <div class="hp16-footer-column-{{ section_id }}">
    <h4 class="hp16-footer-heading-{{ section_id }}">STALKER?</h4>
    <ul class="hp16-footer-menu-{{ section_id }}">
      <li><a href="#">Contact Us</a></li>
      <li><a href="#">Privacy Policy</a></li>
      <li><a href="#">Terms of Service</a></li>
    </ul>
  </div>
</div>

<div class="hp16-footer-bottom-{{ section_id }}">
  <div class="hp16-footer-copyright-{{ section_id }}">
    &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. ALL RIGHTS RESERVED. <br/> STAY CUTE.
  </div>
  <div class="hp16-footer-social-{{ section_id }}">
    <a href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a>
    <a href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a>
    <a href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg></a>
  </div>
</div>

{% schema %}
{
  "name": "HP16 Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FF00FF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "HP16 Footer"
    }
  ]
}
{% endschema %}
