{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#00FFA3'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px 40px;
    color: #FFF;
    border-top: 1px solid {{ text_color }};
  }
  
  .hp13-footer-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 60px;
  }
  
  .hp13-footer-logo-wrap-{{ section_id }} {
    max-width: 300px;
  }
  
  .hp13-footer-logo-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.8rem;
    font-weight: 900;
    color: {{ text_color }};
    text-decoration: none;
    letter-spacing: 4px;
    text-shadow: 2px 2px 0px rgba(0,255,163,0.3);
    display: block;
    margin-bottom: 20px;
  }
  
  .hp13-footer-text-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9rem;
    line-height: 1.6;
    opacity: 0.7;
  }
  
  .hp13-footer-heading-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    font-weight: bold;
    text-transform: uppercase;
    margin: 0 0 25px 0;
    color: {{ text_color }};
  }
  
  .hp13-footer-menu-{{ section_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .hp13-footer-menu-{{ section_id }} li {
    margin-bottom: 15px;
  }
  
  .hp13-footer-menu-{{ section_id }} a {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9rem;
    color: #FFF;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  
  .hp13-footer-menu-{{ section_id }} a:hover {
    color: {{ text_color }};
    text-decoration: underline;
  }
  
  .hp13-footer-bottom-{{ section_id }} {
    max-width: 1400px;
    margin: 80px auto 0;
    padding-top: 40px;
    border-top: 1px solid #333;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .hp13-footer-copyright-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.8rem;
    color: #666;
  }
  
  .hp13-footer-payments-{{ section_id }} {
    display: flex;
    gap: 10px;
    opacity: 0.5;
  }
  
  .hp13-footer-payments-{{ section_id }} svg {
    width: 30px;
    height: 20px;
  }

  @media (max-width: 992px) {
    .hp13-footer-container-{{ section_id }} {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px 20px;
    }
    .hp13-footer-container-{{ section_id }} {
      grid-template-columns: 1fr;
    }
    .hp13-footer-bottom-{{ section_id }} {
      flex-direction: column;
      gap: 20px;
      text-align: center;
      margin-top: 40px;
      padding-top: 20px;
    }
  }
</style>

<div class="hp13-footer-container-{{ section_id }}">
  <div class="hp13-footer-logo-wrap-{{ section_id }}">
    <a href="/" class="hp13-footer-logo-{{ section_id }}">{{ shop.name | default: 'CYBER_SYS' }}</a>
    <p class="hp13-footer-text-{{ section_id }}">Equipping operatives for the hyper-connected urban grid. Survive. Adapt. Evolve.</p>
  </div>
  
  <div class="hp13-footer-column-{{ section_id }}">
    <h4 class="hp13-footer-heading-{{ section_id }}">DATABASE</h4>
    <ul class="hp13-footer-menu-{{ section_id }}">
      <li><a href="#">// APPAREL</a></li>
      <li><a href="#">// FOOTWEAR</a></li>
      <li><a href="#">// HARDWARE</a></li>
      <li><a href="#">// ARCHIVES</a></li>
    </ul>
  </div>
  
  <div class="hp13-footer-column-{{ section_id }}">
    <h4 class="hp13-footer-heading-{{ section_id }}">NETWORK</h4>
    <ul class="hp13-footer-menu-{{ section_id }}">
      <li><a href="#">// TRANSMISSIONS</a></li>
      <li><a href="#">// COMMS</a></li>
      <li><a href="#">// DIRECTIVES</a></li>
    </ul>
  </div>
  
  <div class="hp13-footer-column-{{ section_id }}">
    <h4 class="hp13-footer-heading-{{ section_id }}">SUPPORT</h4>
    <ul class="hp13-footer-menu-{{ section_id }}">
      <li><a href="#">// INTEL (FAQ)</a></li>
      <li><a href="#">// SHIPPING_LOGS</a></li>
      <li><a href="#">// EXTRACTION (RETURNS)</a></li>
    </ul>
  </div>
</div>

<div class="hp13-footer-bottom-{{ section_id }}">
  <div class="hp13-footer-copyright-{{ section_id }}">
    > SYSTEM_UPTIME: {{ 'now' | date: "%Y" }} {{ shop.name }}. ALL_RIGHTS_RESERVED.
  </div>
  <div class="hp13-footer-payments-{{ section_id }}">
    {{ shop.enabled_payment_types | payment_type_svg_tag }}
  </div>
</div>

{% schema %}
{
  "name": "HP13 Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Highlight Color",
      "default": "#00FFA3"
    }
  ],
  "presets": [
    {
      "name": "HP13 Footer"
    }
  ]
}
{% endschema %}
