{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px 40px;
    color: {{ text_color }};
  }
  
  .hp15-footer-container-{{ section_id }} {
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 60px;
  }
  
  .hp15-footer-logo-wrap-{{ section_id }} {
    max-width: 300px;
  }
  
  .hp15-footer-logo-{{ section_id }} {
    font-family: 'Didot', 'Playfair Display', serif;
    font-size: 2.5rem;
    font-weight: normal;
    color: {{ text_color }};
    text-decoration: none;
    letter-spacing: 4px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 20px;
  }
  
  .hp15-footer-text-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    line-height: 1.6;
    opacity: 0.6;
  }
  
  .hp15-footer-heading-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 30px 0;
    color: {{ text_color }};
  }
  
  .hp15-footer-menu-{{ section_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .hp15-footer-menu-{{ section_id }} li {
    margin-bottom: 15px;
  }
  
  .hp15-footer-menu-{{ section_id }} a {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    color: {{ text_color }};
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }
  
  .hp15-footer-menu-{{ section_id }} a:hover {
    opacity: 1;
  }
  
  .hp15-footer-bottom-{{ section_id }} {
    max-width: 1600px;
    margin: 80px auto 0;
    padding-top: 40px;
    border-top: 1px solid rgba(255,255,255,0.2);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .hp15-footer-copyright-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    opacity: 0.5;
  }
  
  .hp15-footer-social-{{ section_id }} {
    display: flex;
    gap: 20px;
  }
  
  .hp15-footer-social-{{ section_id }} a {
    color: {{ text_color }};
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }
  
  .hp15-footer-social-{{ section_id }} a:hover {
    opacity: 1;
  }
  
  .hp15-footer-social-{{ section_id }} svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 992px) {
    .hp15-footer-container-{{ section_id }} {
      grid-template-columns: 1fr 1fr;
      gap: 50px;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px 20px;
    }
    .hp15-footer-container-{{ section_id }} {
      grid-template-columns: 1fr;
    }
    .hp15-footer-bottom-{{ section_id }} {
      flex-direction: column;
      gap: 20px;
      text-align: center;
      margin-top: 40px;
      padding-top: 20px;
    }
  }
</style>

<div class="hp15-footer-container-{{ section_id }}">
  <div class="hp15-footer-logo-wrap-{{ section_id }}">
    <a href="/" class="hp15-footer-logo-{{ section_id }}">{{ shop.name | default: 'MAISON' }}</a>
    <p class="hp15-footer-text-{{ section_id }}">A study in minimalism and architectural tailoring. Founded in Paris, 2025.</p>
  </div>
  
  <div class="hp15-footer-column-{{ section_id }}">
    <h4 class="hp15-footer-heading-{{ section_id }}">COLLECTIONS</h4>
    <ul class="hp15-footer-menu-{{ section_id }}">
      <li><a href="#">Ready to Wear</a></li>
      <li><a href="#">Leather Goods</a></li>
      <li><a href="#">Accessories</a></li>
      <li><a href="#">The Archive</a></li>
    </ul>
  </div>
  
  <div class="hp15-footer-column-{{ section_id }}">
    <h4 class="hp15-footer-heading-{{ section_id }}">THE HOUSE</h4>
    <ul class="hp15-footer-menu-{{ section_id }}">
      <li><a href="#">Manifesto</a></li>
      <li><a href="#">Sustainability</a></li>
      <li><a href="#">Boutiques</a></li>
      <li><a href="#">Careers</a></li>
    </ul>
  </div>
  
  <div class="hp15-footer-column-{{ section_id }}">
    <h4 class="hp15-footer-heading-{{ section_id }}">CLIENT SERVICES</h4>
    <ul class="hp15-footer-menu-{{ section_id }}">
      <li><a href="#">Contact Concierge</a></li>
      <li><a href="#">Shipping & Returns</a></li>
      <li><a href="#">Private Appointments</a></li>
      <li><a href="#">FAQ</a></li>
    </ul>
  </div>
</div>

<div class="hp15-footer-bottom-{{ section_id }}">
  <div class="hp15-footer-copyright-{{ section_id }}">
    &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. ALL RIGHTS RESERVED.
  </div>
  <div class="hp15-footer-social-{{ section_id }}">
    <a href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a>
    <a href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a>
    <a href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg></a>
  </div>
</div>

{% schema %}
{
  "name": "HP15 Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "HP15 Footer"
    }
  ]
}
{% endschema %}
