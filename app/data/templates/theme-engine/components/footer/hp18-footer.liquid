{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent_color = section.settings.accent_color
  assign border_color = section.settings.border_color
  assign border_width = section.settings.border_width
-%}

<style>
  .hp18-footer-{{ sec_id }} {
    background-color: {{ bg_color }};
    border-top: {{ border_width }}px solid {{ border_color }};
    padding-top: 80px;
    padding-bottom: 40px;
    position: relative;
    overflow: hidden;
  }

  .hp18-footer-{{ sec_id }}__container {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp18-footer-{{ sec_id }}__top {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 60px;
    margin-bottom: 60px;
  }

  .hp18-footer-{{ sec_id }}__brand {
    flex: 1 1 300px;
  }

  .hp18-footer-{{ sec_id }}__logo {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: 48px;
    color: {{ text_color }};
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1;
    margin-bottom: 20px;
    display: block;
    letter-spacing: -2px;
  }
  
  .hp18-footer-{{ sec_id }}__desc {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    font-size: 16px;
    color: {{ text_color }};
    opacity: 0.8;
    line-height: 1.5;
    max-width: 350px;
  }

  .hp18-footer-{{ sec_id }}__menus {
    display: flex;
    gap: 80px;
    flex-wrap: wrap;
  }

  .hp18-footer-{{ sec_id }}__menu-title {
    font-family: 'Arial Black', sans-serif;
    font-size: 18px;
    color: {{ text_color }};
    text-transform: uppercase;
    margin: 0 0 20px 0;
    border-bottom: {{ border_width }}px solid {{ border_color }};
    display: inline-block;
    padding-bottom: 5px;
  }

  .hp18-footer-{{ sec_id }}__menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .hp18-footer-{{ sec_id }}__menu-link {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    font-size: 16px;
    color: {{ text_color }};
    text-decoration: none;
    transition: color 0.2s;
  }

  .hp18-footer-{{ sec_id }}__menu-link:hover {
    color: {{ accent_color }};
  }

  .hp18-footer-{{ sec_id }}__bottom {
    border-top: {{ border_width }}px solid {{ border_color }};
    padding-top: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }

  .hp18-footer-{{ sec_id }}__copy {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    font-size: 14px;
    color: {{ text_color }};
    opacity: 0.7;
    margin: 0;
  }

  .hp18-footer-{{ sec_id }}__social {
    display: flex;
    gap: 15px;
  }

  .hp18-footer-{{ sec_id }}__social-link {
    width: 40px;
    height: 40px;
    border: {{ border_width }}px solid {{ border_color }};
    background-color: {{ text_color }};
    color: {{ bg_color }};
    display: flex;
    justify-content: center;
    align-items: center;
    text-decoration: none;
    font-family: 'Arial Black', sans-serif;
    font-size: 18px;
    transition: all 0.2s;
  }

  .hp18-footer-{{ sec_id }}__social-link:hover {
    background-color: {{ accent_color }};
    color: {{ border_color }};
    transform: translateY(-5px);
    box-shadow: 4px 4px 0px {{ border_color }};
  }

  /* Massive background text graphic */
  .hp18-footer-{{ sec_id }}__bg-text {
    position: absolute;
    bottom: -15%;
    left: 0;
    font-family: 'Arial Black', sans-serif;
    font-size: 30vw;
    color: {{ border_color }};
    opacity: 0.05;
    pointer-events: none;
    z-index: 0;
    white-space: nowrap;
    line-height: 1;
  }

  @media screen and (max-width: 768px) {
    .hp18-footer-{{ sec_id }}__container { padding: 0 20px; }
    .hp18-footer-{{ sec_id }}__menus { gap: 40px; flex-direction: column; }
    .hp18-footer-{{ sec_id }}__bottom { flex-direction: column; text-align: center; }
  }
</style>

<footer class="hp18-footer-{{ sec_id }}">
  
  <div class="hp18-footer-{{ sec_id }}__bg-text">{{ shop.name }}</div>

  <div class="hp18-footer-{{ sec_id }}__container">
    
    <div class="hp18-footer-{{ sec_id }}__top">
      <div class="hp18-footer-{{ sec_id }}__brand">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" style="max-width: 200px; margin-bottom: 20px;">
        {% else %}
          <a href="/" class="hp18-footer-{{ sec_id }}__logo">{{ shop.name }}</a>
        {% endif %}
        
        <p class="hp18-footer-{{ sec_id }}__desc">{{ section.settings.description }}</p>
      </div>

      <div class="hp18-footer-{{ sec_id }}__menus">
        {% for block in section.blocks %}
          <div class="hp18-footer-{{ sec_id }}__menu-col" {{ block.shopify_attributes }}>
            <h4 class="hp18-footer-{{ sec_id }}__menu-title">{{ block.settings.title }}</h4>
            {% if block.settings.menu != blank %}
              <ul class="hp18-footer-{{ sec_id }}__menu-list">
                {% for link in linklists[block.settings.menu].links %}
                  <li><a href="{{ link.url }}" class="hp18-footer-{{ sec_id }}__menu-link">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            {% else %}
              <ul class="hp18-footer-{{ sec_id }}__menu-list">
                <li><a href="#" class="hp18-footer-{{ sec_id }}__menu-link">Shop All</a></li>
                <li><a href="#" class="hp18-footer-{{ sec_id }}__menu-link">New Arrivals</a></li>
                <li><a href="#" class="hp18-footer-{{ sec_id }}__menu-link">About Us</a></li>
              </ul>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="hp18-footer-{{ sec_id }}__bottom">
      <p class="hp18-footer-{{ sec_id }}__copy">&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All Rights Reserved.</p>
      
      <div class="hp18-footer-{{ sec_id }}__social">
        {% if section.settings.social_ig != blank %}
          <a href="{{ section.settings.social_ig }}" target="_blank" class="hp18-footer-{{ sec_id }}__social-link">IG</a>
        {% endif %}
        {% if section.settings.social_tt != blank %}
          <a href="{{ section.settings.social_tt }}" target="_blank" class="hp18-footer-{{ sec_id }}__social-link">TT</a>
        {% endif %}
        {% if section.settings.social_x != blank %}
          <a href="{{ section.settings.social_x }}" target="_blank" class="hp18-footer-{{ sec_id }}__social-link">X</a>
        {% endif %}
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "HP18 Adv Footer",
  "max_blocks": 3,
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CCFF00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 3
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Override (Optional)"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Brand Description",
      "default": "Redefining the modern uniform. Built in the streets, made for the world."
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "url",
      "id": "social_ig",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_tt",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "social_x",
      "label": "X (Twitter)"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Footer Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Menu Title",
          "default": "EXPLORE"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Select Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP18 Advanced Footer",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "title": "SHOP"
          }
        },
        {
          "type": "menu",
          "settings": {
            "title": "SUPPORT"
          }
        }
      ]
    }
  ]
}
{% endschema %}
