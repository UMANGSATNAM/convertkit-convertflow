{% comment %}
  Footer Minimal Centered - Scandinavian clean centered footer with payment methods and social pills
{% endcomment %}

<footer class="footer-minimal-centered" id="FooterMinCent-{{ section.id }}">
  <div class="centered-box">
    <!-- Centered Brand / Logo -->
    <div class="foot-brand">
      <a href="{{ routes.root_url | default: '/' }}" class="brand-link">
        {{ section.settings.brand_name | default: 'MONOCHROME' }}
      </a>
    </div>

    <!-- Centered Primary Links -->
    <ul class="nav-center-row">
      <li><a href="/collections">Shop All</a></li>
      <li><a href="/pages/our-story">About Us</a></li>
      <li><a href="/pages/sustainability">Ethics</a></li>
      <li><a href="/pages/journal">Journal</a></li>
      <li><a href="/pages/contact">Contact</a></li>
    </ul>

    <!-- Social Icon Pills -->
    <div class="social-pills-row">
      <a href="#" aria-label="Instagram" class="pill-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
      </a>
      <a href="#" aria-label="Pinterest" class="pill-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/><circle cx="12" cy="12" r="10"/></svg>
      </a>
      <a href="#" aria-label="Twitter" class="pill-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
      </a>
    </div>

    <!-- Payment Badges -->
    <div class="payments-strip">
      <span class="pay-tag">Visa</span>
      <span class="pay-tag">Mastercard</span>
      <span class="pay-tag">Amex</span>
      <span class="pay-tag">Apple Pay</span>
      <span class="pay-tag">Google Pay</span>
      <span class="pay-tag">PayPal</span>
    </div>

    <!-- Copyright -->
    <p class="copyright-note">
      © {{ 'now' | date: '%Y' }} {{ shop.name | default: 'Monochrome Inc' }}. Built for sustainable commerce.
    </p>
  </div>
</footer>

<style>
  #FooterMinCent-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#fafafa' }};
    padding: 60px 24px 40px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    border-top: 1px solid #f0f0f0;
  }
  #FooterMinCent-{{ section.id }} * {
    box-sizing: border-box;
  }
  #FooterMinCent-{{ section.id }} .centered-box {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }
  #FooterMinCent-{{ section.id }} .foot-brand {
    margin-bottom: 24px;
  }
  #FooterMinCent-{{ section.id }} .brand-link {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: #171717;
    text-decoration: none;
    text-transform: uppercase;
  }
  #FooterMinCent-{{ section.id }} .nav-center-row {
    list-style: none;
    margin: 0 0 28px 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  #FooterMinCent-{{ section.id }} .nav-center-row a {
    color: #525252;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s;
  }
  #FooterMinCent-{{ section.id }} .nav-center-row a:hover {
    color: #171717;
  }
  #FooterMinCent-{{ section.id }} .social-pills-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }
  #FooterMinCent-{{ section.id }} .pill-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #e5e5e5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #525252;
    text-decoration: none;
    transition: all 0.2s;
  }
  #FooterMinCent-{{ section.id }} .pill-btn:hover {
    color: #171717;
    border-color: #a3a3a3;
    transform: translateY(-2px);
  }
  #FooterMinCent-{{ section.id }} .payments-strip {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  #FooterMinCent-{{ section.id }} .pay-tag {
    background: #ffffff;
    border: 1px solid #e5e5e5;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    color: #737373;
  }
  #FooterMinCent-{{ section.id }} .copyright-note {
    font-size: 12px;
    color: #a3a3a3;
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "Footer Minimal Centered",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "MONOCHROME"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fafafa"
    }
  ],
  "presets": [
    {
      "name": "Footer Minimal Centered"
    }
  ]
}
{% endschema %}
