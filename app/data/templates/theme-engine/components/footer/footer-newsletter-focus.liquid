{% comment %}
  Footer Newsletter Focus - High-converting lead generation footer with discount incentive
{% endcomment %}

<footer class="footer-news-focus" id="FooterNewsFocus-{{ section.id }}">
  <div class="news-focus-inner">
    <div class="promo-box">
      <span class="vip-tag">{{ section.settings.pill_text | default: 'VIP INNER CIRCLE' }}</span>
      <h2 class="promo-headline">{{ section.settings.headline | default: 'Get 15% Off Your First Order' }}</h2>
      <p class="promo-sub">
        {{ section.settings.subheading | default: 'Be the first to hear about private archive sales, limited seasonal drops, and insider member perks.' }}
      </p>

      <form class="lead-form" onsubmit="event.preventDefault(); alert('Discount code WELCOME15 sent to your inbox!');">
        <div class="field-cluster">
          <input type="email" placeholder="Enter your best email address..." required class="focus-input" />
          <button type="submit" class="focus-submit">
            {{ section.settings.btn_text | default: 'Unlock 15% Off' }}
          </button>
        </div>
      </form>

      <div class="perks-row">
        <div class="perk-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <span>Instant Promo Code</span>
        </div>
        <div class="perk-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <span>Zero Spam Policy</span>
        </div>
        <div class="perk-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <span>Cancel Anytime</span>
        </div>
      </div>
    </div>

    <div class="bottom-simple-bar">
      <div class="left-brand">
        <span class="store-mark">{{ shop.name | default: 'NOIR STUDIOS' }}</span>
        <span class="year-mark">© {{ 'now' | date: '%Y' }}</span>
      </div>

      <ul class="mini-links">
        <li><a href="/pages/privacy">Privacy</a></li>
        <li><a href="/pages/terms">Terms</a></li>
        <li><a href="/pages/shipping">Shipping</a></li>
        <li><a href="/pages/contact">Contact</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  #FooterNewsFocus-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#09090b' }};
    color: #a1a1aa;
    padding: 80px 24px 40px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  #FooterNewsFocus-{{ section.id }} * {
    box-sizing: border-box;
  }
  #FooterNewsFocus-{{ section.id }} .news-focus-inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  #FooterNewsFocus-{{ section.id }} .vip-tag {
    display: inline-block;
    background: #27272a;
    color: #f4f4f5;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 6px 14px;
    border-radius: 9999px;
    margin-bottom: 20px;
  }
  #FooterNewsFocus-{{ section.id }} .promo-headline {
    font-size: 38px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0 0 14px 0;
    line-height: 1.2;
  }
  #FooterNewsFocus-{{ section.id }} .promo-sub {
    font-size: 16px;
    line-height: 1.6;
    color: #a1a1aa;
    margin: 0 auto 32px auto;
    max-width: 560px;
  }
  #FooterNewsFocus-{{ section.id }} .field-cluster {
    display: flex;
    gap: 8px;
    max-width: 500px;
    margin: 0 auto 24px auto;
    background: #18181b;
    border: 1px solid #27272a;
    padding: 6px;
    border-radius: 14px;
  }
  #FooterNewsFocus-{{ section.id }} .focus-input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 12px 18px;
    color: #ffffff;
    font-size: 15px;
    outline: none;
  }
  #FooterNewsFocus-{{ section.id }} .focus-submit {
    background: #ffffff;
    color: #09090b;
    border: none;
    padding: 12px 24px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }
  #FooterNewsFocus-{{ section.id }} .focus-submit:hover {
    background: #e4e4e7;
    transform: translateY(-1px);
  }
  #FooterNewsFocus-{{ section.id }} .perks-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 64px;
  }
  #FooterNewsFocus-{{ section.id }} .perk-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: #71717a;
    font-weight: 500;
  }
  #FooterNewsFocus-{{ section.id }} .bottom-simple-bar {
    border-top: 1px solid #18181b;
    padding-top: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
  }
  #FooterNewsFocus-{{ section.id }} .left-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #71717a;
  }
  #FooterNewsFocus-{{ section.id }} .store-mark {
    font-weight: 700;
    color: #e4e4e7;
    letter-spacing: 0.08em;
  }
  #FooterNewsFocus-{{ section.id }} .mini-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 20px;
  }
  #FooterNewsFocus-{{ section.id }} .mini-links a {
    color: #71717a;
    text-decoration: none;
    transition: color 0.2s;
  }
  #FooterNewsFocus-{{ section.id }} .mini-links a:hover {
    color: #ffffff;
  }

  @media (max-width: 600px) {
    #FooterNewsFocus-{{ section.id }} .promo-headline {
      font-size: 26px;
    }
    #FooterNewsFocus-{{ section.id }} .field-cluster {
      flex-direction: column;
      background: transparent;
      border: none;
      padding: 0;
    }
    #FooterNewsFocus-{{ section.id }} .focus-input {
      background: #18181b;
      border: 1px solid #27272a;
      border-radius: 10px;
      margin-bottom: 8px;
    }
    #FooterNewsFocus-{{ section.id }} .focus-submit {
      width: 100%;
    }
    #FooterNewsFocus-{{ section.id }} .bottom-simple-bar {
      flex-direction: column;
      gap: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Footer Newsletter Focus",
  "settings": [
    {
      "type": "text",
      "id": "pill_text",
      "label": "Top Pill Text",
      "default": "VIP INNER CIRCLE"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Get 15% Off Your First Order"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Be the first to hear about private archive sales, limited seasonal drops, and insider member perks."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Label",
      "default": "Unlock 15% Off"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#09090b"
    }
  ],
  "presets": [
    {
      "name": "Footer Newsletter Focus"
    }
  ]
}
{% endschema %}
