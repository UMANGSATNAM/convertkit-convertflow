{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#ECFDF5' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }
  .hp62-ugc__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp62-ugc__header { text-align: center; margin-bottom: 40px; }
  .hp62-ugc__eyebrow { font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#059669' }}; margin: 0 0 12px; }
  .hp62-ugc__heading { font-family: 'Italiana', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #064E3B; margin: 0; }
  .hp62-ugc__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr); gap: 16px; }
  .hp62-ugc__item {
    aspect-ratio: 9/16; border-radius: 16px; overflow: hidden; position: relative;
    background: #D1FAE5; border: 1px solid rgba(6, 78, 59, 0.15); box-shadow: 0 4px 15px rgba(6, 78, 59, 0.05);
  }
  .hp62-ugc__item img { width: 100%; height: 100%; object-fit: cover; }
  .hp62-ugc__overlay {
    position: absolute; bottom: 0; left: 0; right: 0; padding: 16px;
    background: linear-gradient(transparent, rgba(6, 78, 59, 0.9));
  }
  .hp62-ugc__handle { font-family: 'Outfit', sans-serif; font-size: 12px; font-weight: 600; color: #ECFDF5; margin: 0; }
  @media screen and (max-width: 992px) { .hp62-ugc__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp62-ugc__grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } }
{%- endstyle -%}
<div class="hp62-ugc__container">
  <div class="hp62-ugc__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp62-ugc__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp62-ugc__heading">{{ section.settings.heading | default: 'Alpine Glow Community' }}</h2>
  </div>
  <div class="hp62-ugc__grid">
    {%- for block in section.blocks -%}
      <div class="hp62-ugc__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.handle }}" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {%- endif -%}
        <div class="hp62-ugc__overlay">
          <p class="hp62-ugc__handle">{{ block.settings.handle | default: '@swiss_skin_ritual' }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP62 UGC",
  "class": "section-hp62-ugc",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ECFDF5" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#059669" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🏔️ REELS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Alpine Glow Community" },
    { "type": "range", "id": "columns", "min": 2, "max": 6, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "reel", "name": "Reel",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "handle", "label": "Handle", "default": "@swiss_skin_ritual" }
    ]
  }],
  "presets": [{ "name": "HP62 UGC", "blocks": [
    { "type": "reel" },
    { "type": "reel", "settings": { "handle": "@zermatt_glow" } },
    { "type": "reel", "settings": { "handle": "@edelweiss_dew" } },
    { "type": "reel", "settings": { "handle": "@alpine_clean" } }
  ]}]
}
{% endschema %}
