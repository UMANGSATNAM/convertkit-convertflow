{%- liquid
  assign bg_color = section.settings.bg_color | default: '#1a2a3a'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#0066cc'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp5-ugc-bg: {{ bg_color }};
    --hp5-ugc-text: {{ text_color }};
    --hp5-ugc-accent: {{ accent_color }};
    
    --hp5-ugc-pt-desk: {{ padding_top_desktop }}px;
    --hp5-ugc-pb-desk: {{ padding_bottom_desktop }}px;
    --hp5-ugc-pt-mob: {{ padding_top_mobile }}px;
    --hp5-ugc-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp5-health-ugc-{{ section.id }} {
    padding-top: var(--hp5-ugc-pt-desk);
    padding-bottom: var(--hp5-ugc-pb-desk);
    background-color: var(--hp5-ugc-bg);
    color: var(--hp5-ugc-text);
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }

  .hp5-ugc-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp5-ugc-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp5-ugc-title {
    font-size: clamp(32px, 4vw, 40px);
    font-weight: 700;
    margin: 0 0 15px 0;
    letter-spacing: -1px;
  }
  .hp5-ugc-desc {
    font-size: 16px;
    color: rgba(255,255,255,0.7);
    margin: 0;
  }

  .hp5-ugc-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 20px;
  }
  .hp5-ugc-track::-webkit-scrollbar { display: none; }

  .hp5-ugc-card {
    flex: 0 0 calc(25% - 15px);
    scroll-snap-align: start;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 9/16;
    background: #000;
    cursor: pointer;
  }

  .hp5-ugc-video {
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }
  .hp5-ugc-card:hover .hp5-ugc-video {
    opacity: 1;
  }

  .hp5-ugc-play {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 50px; height: 50px;
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(5px);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: #fff;
    transition: transform 0.3s ease, background 0.3s ease;
    z-index: 2;
  }
  .hp5-ugc-play svg {
    width: 20px; height: 20px; margin-left: 3px; fill: currentColor;
  }
  .hp5-ugc-card:hover .hp5-ugc-play {
    transform: translate(-50%, -50%) scale(1.1);
    background: var(--hp5-ugc-accent);
  }

  .hp5-ugc-info {
    position: absolute;
    bottom: 0; left: 0; width: 100%;
    padding: 40px 20px 20px 20px;
    background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
    z-index: 3;
    pointer-events: none;
  }
  .hp5-ugc-author {
    font-size: 14px; font-weight: 700; margin: 0 0 5px 0; color: #fff;
  }
  .hp5-ugc-tag {
    font-size: 12px; color: #fff; background: rgba(255,255,255,0.2);
    padding: 4px 8px; border-radius: 4px; display: inline-block;
  }

  @media screen and (max-width: 1024px) {
    .hp5-ugc-card { flex: 0 0 calc(33.333% - 13.33px); }
  }
  @media screen and (max-width: 768px) {
    .hp5-health-ugc-{{ section.id }} {
      padding-top: var(--hp5-ugc-pt-mob);
      padding-bottom: var(--hp5-ugc-pb-mob);
    }
    .hp5-ugc-inner {
      padding: 0 0 0 20px;
    }
    .hp5-ugc-header {
      padding-right: 20px;
    }
    .hp5-ugc-card { flex: 0 0 calc(60% - 15px); }
  }
</style>

<section class="hp5-health-ugc-{{ section.id }}" aria-label="Customer Results">
  <div class="hp5-ugc-inner">
    
    <div class="hp5-ugc-header">
      <h2 class="hp5-ugc-title">{{ section.settings.title }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="hp5-ugc-desc">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <div class="hp5-ugc-track">
      {%- for block in section.blocks -%}
        <div class="hp5-ugc-card" {{ block.shopify_attributes }}>
          {%- if block.settings.video_url != blank -%}
            <!-- Fake video for design, use HTML5 video in production if hosted -->
            <video class="hp5-ugc-video" autoplay loop muted playsinline poster="{{ block.settings.image | image_url: width: 600 }}">
              <source src="{{ block.settings.video_url }}" type="video/mp4">
            </video>
          {%- elsif block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp5-ugc-video" loading="lazy" alt="UGC">
          {%- else -%}
            {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'hp5-ugc-video placeholder-svg' }}
          {%- endif -%}

          <div class="hp5-ugc-play"><svg viewBox="0 0 24 24"><path d="M5 3l14 9-14 9V3z"/></svg></div>
          
          <div class="hp5-ugc-info">
            <p class="hp5-ugc-author">{{ block.settings.author }}</p>
            <span class="hp5-ugc-tag">{{ block.settings.tag }}</span>
          </div>
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..5) -%}
          <div class="hp5-ugc-card">
            {{ 'collection-' | append: i | placeholder_svg_tag: 'hp5-ugc-video placeholder-svg' }}
            <div class="hp5-ugc-play"><svg viewBox="0 0 24 24"><path d="M5 3l14 9-14 9V3z"/></svg></div>
            <div class="hp5-ugc-info">
              <p class="hp5-ugc-author">@health.expert</p>
              <span class="hp5-ugc-tag">Immunity Review</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP5 Health UGC Reels",
  "tag": "section",
  "class": "section-hp5-ugc",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Real Results. Real Science."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "See what doctors, experts, and customers are saying."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1a2a3a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0066cc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Video Poster Image"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL (.mp4)"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author/Handle",
          "default": "@dr.smith"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Product/Topic Tag",
          "default": "Gut Health Review"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP5 Health UGC Reels",
      "category": "Social",
      "blocks": [
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" }
      ]
    }
  ]
}
{% endschema %}
