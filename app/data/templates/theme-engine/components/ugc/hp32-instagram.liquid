{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Syne:wght@700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Syne', sans-serif;
    --font-body: 'Space Mono', monospace;
    
    background-color: var(--bg-color);
    border-bottom: 4px solid var(--border-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp32-insta-wrapper {
    width: 100%;
    /* No max-width for a full screen surveillance effect */
  }

  .hp32-insta__header {
    text-align: center;
    margin-bottom: 40px;
    padding: 0 20px;
  }

  .hp32-insta__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: #000;
    text-transform: uppercase;
    margin: 0 0 15px;
    letter-spacing: -1px;
  }

  .hp32-insta__handle {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    color: var(--accent-color);
    background: #000;
    padding: 6px 12px;
    display: inline-block;
    text-decoration: none;
    border: 2px solid var(--border-color);
    box-shadow: 4px 4px 0 var(--border-color);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .hp32-insta__handle:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--border-color);
  }

  .hp32-insta__grid {
    display: flex;
    flex-wrap: wrap;
    border-top: 4px solid var(--border-color);
  }

  .hp32-insta__item {
    width: 25%;
    aspect-ratio: 1/1;
    position: relative;
    border-right: 4px solid var(--border-color);
    border-bottom: 4px solid var(--border-color);
    overflow: hidden;
    display: block;
  }

  /* Remove right border from last item in row */
  .hp32-insta__item:nth-child(4n) {
    border-right: none;
  }

  @media screen and (max-width: 992px) {
    .hp32-insta__item { width: 33.333%; }
    .hp32-insta__item:nth-child(4n) { border-right: 4px solid var(--border-color); }
    .hp32-insta__item:nth-child(3n) { border-right: none; }
  }

  @media screen and (max-width: 576px) {
    .hp32-insta__item { width: 50%; }
    .hp32-insta__item:nth-child(3n) { border-right: 4px solid var(--border-color); }
    .hp32-insta__item:nth-child(2n) { border-right: none; }
  }

  .hp32-insta__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(120%);
    transition: transform 0.5s ease, filter 0.3s ease;
  }

  .hp32-insta__item:hover .hp32-insta__image {
    transform: scale(1.05);
    filter: grayscale(0%);
  }

  /* Surveillance crosshairs */
  .hp32-insta__item::before {
    content: '+';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-body);
    font-size: 24px;
    color: var(--accent-color);
    opacity: 0;
    z-index: 2;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .hp32-insta__item:hover::before {
    opacity: 1;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp32-insta-wrapper" id="HP32Insta-{{ section.id }}">
  <div class="hp32-insta__header">
    <h2 class="hp32-insta__title">{{ section.settings.title }}</h2>
    {%- if section.settings.handle != blank -%}
      <a href="{{ section.settings.link | default: '#' }}" class="hp32-insta__handle">{{ section.settings.handle }}</a>
    {%- endif -%}
  </div>

  <div class="hp32-insta__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp32-insta__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 600 }}" alt="Instagram Image" class="hp32-insta__image" loading="lazy">
        {%- else -%}
          {%- assign placeholder = 'collection-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'collection-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp32-insta__image' }}
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP32 - Brutalist Insta",
  "class": "section-hp32-instagram",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SURVEILLANCE_GRID"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "@SYSTEM_CORE"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Light Grey)",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (e.g. Lime)",
      "default": "#ccff00"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Instagram Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP32 - Brutalist Insta",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
