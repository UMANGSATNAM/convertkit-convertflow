{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp45-insta-bg: {{ section.settings.bg_color | default: '#F5F5F0' }};
    --hp45-border: {{ section.settings.border_color | default: '#0A0A0A' }};
    
    background-color: var(--hp45-insta-bg);
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
  }

  .hp45-insta__wrap {
    max-width: {{ section.settings.container_width | default: 1300 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp45-insta__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp45-insta__heading {
    font-size: clamp(26px, 3.5vw, 36px);
    font-weight: 700;
    text-transform: uppercase;
    color: #0A0A0A;
    margin: 0;
  }

  .hp45-insta__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 18px;
  }

  .hp45-insta__card {
    aspect-ratio: 1;
    border: 2px solid var(--hp45-border);
    box-shadow: 4px 4px 0 var(--hp45-border);
    position: relative;
    overflow: hidden;
    background: #0A0A0A;
  }

  .hp45-insta__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(100%);
    transition: all 0.3s ease;
  }

  .hp45-insta__card:hover .hp45-insta__img {
    filter: grayscale(0%);
    transform: scale(1.05);
  }

  .hp45-insta__tag {
    position: absolute;
    bottom: 10px;
    left: 10px;
    background: #0A0A0A;
    color: #FFFFFF;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 8px;
    border: 1px solid #FFFFFF;
  }

  @media screen and (max-width: 992px) {
    .hp45-insta__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp45-insta__wrap">
  <div class="hp45-insta__header">
    <h2 class="hp45-insta__heading">{{ section.settings.heading | default: 'ARCHIVE CURATION // VISUAL INDEX' }}</h2>
  </div>

  <div class="hp45-insta__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp45-insta__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" class="hp45-insta__img" alt="{{ block.settings.tag }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hp45-insta__img' }}
          {%- endif -%}
          <span class="hp45-insta__tag">{{ block.settings.tag | default: '[VIEW SPEC]' }}</span>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp45-insta__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp45-insta__img' }}
        <span class="hp45-insta__tag">[VIEW SPEC 01]</span>
      </div>
      <div class="hp45-insta__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp45-insta__img' }}
        <span class="hp45-insta__tag">[VIEW SPEC 02]</span>
      </div>
      <div class="hp45-insta__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp45-insta__img' }}
        <span class="hp45-insta__tag">[VIEW SPEC 03]</span>
      </div>
      <div class="hp45-insta__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp45-insta__img' }}
        <span class="hp45-insta__tag">[VIEW SPEC 04]</span>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP45 - Brutal Gallery",
  "class": "section-hp45-gallery",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F5F0" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#0A0A0A" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "ARCHIVE CURATION // VISUAL INDEX" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 70 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1300 }
  ],
  "blocks": [
    {
      "type": "gallery_item",
      "name": "Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "[VIEW SPEC]" }
      ]
    }
  ],
  "presets": [
    { "name": "HP45 - Brutal Gallery" }
  ]
}
{% endschema %}
