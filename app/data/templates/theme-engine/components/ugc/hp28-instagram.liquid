{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --cyan: {{ section.settings.cyan_color }};
    --magenta: {{ section.settings.magenta_color }};
    
    --font-heading: 'Press Start 2P', cursive;
    --font-body: 'Chakra Petch', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 2px dashed var(--magenta);
    position: relative;
    /* Early web starfield background sim */
    background-image: 
      radial-gradient(white, rgba(255,255,255,.2) 2px, transparent 4px),
      radial-gradient(white, rgba(255,255,255,.15) 1px, transparent 3px),
      radial-gradient(white, rgba(255,255,255,.1) 2px, transparent 4px),
      radial-gradient(rgba(255,255,255,.4), rgba(255,255,255,.1) 2px, transparent 3px);
    background-size: 550px 550px, 350px 350px, 250px 250px, 150px 150px; 
    background-position: 0 0, 40px 60px, 130px 270px, 70px 100px;
    animation: hp28Starfield 100s linear infinite;
  }

  @keyframes hp28Starfield {
    from { background-position: 0 0, 40px 60px, 130px 270px, 70px 100px; }
    to { background-position: -550px -550px, -310px -490px, -120px -280px, -80px -50px; }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp28-ig-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp28-ig-wrapper {
      padding: 0 20px;
    }
  }

  .hp28-ig__header {
    text-align: center;
    margin-bottom: 50px;
    background: #000;
    padding: 20px;
    border: 3px solid var(--cyan);
    box-shadow: 8px 8px 0 var(--magenta);
    display: inline-block;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }

  .hp28-ig__title {
    font-family: var(--font-heading);
    font-size: clamp(20px, 3.5vw, {{ section.settings.title_size }}px);
    color: var(--cyan);
    text-shadow: 3px 3px 0 var(--magenta);
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .hp28-ig__subtitle {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .hp28-ig__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 20px;
    margin-bottom: 50px;
  }

  @media screen and (max-width: 992px) {
    .hp28-ig__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp28-ig__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
  }

  .hp28-ig__item {
    display: block;
    aspect-ratio: 1/1;
    background: #000;
    border: 2px solid var(--text-color);
    position: relative;
    overflow: hidden;
    box-shadow: 4px 4px 0 var(--cyan);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  /* Make items look like random early web polaroids */
  .hp28-ig__item:nth-child(even) {
    border-color: var(--cyan);
    box-shadow: -4px 4px 0 var(--magenta);
  }

  .hp28-ig__item:hover {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 8px 8px 0 var(--magenta);
    z-index: 2;
  }
  .hp28-ig__item:nth-child(even):hover {
    box-shadow: -8px 8px 0 var(--cyan);
  }

  .hp28-ig__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(150%) contrast(1.1);
    transition: filter 0.3s ease;
  }

  .hp28-ig__item:hover .hp28-ig__image {
    filter: saturate(100%) contrast(1) sepia(100%) hue-rotate(240deg);
  }

  /* Overlay text */
  .hp28-ig__overlay {
    position: absolute;
    bottom: 0; left: 0; width: 100%;
    background: rgba(0, 0, 0, 0.7);
    color: var(--cyan);
    font-family: var(--font-heading);
    font-size: 10px;
    padding: 10px;
    text-align: center;
    text-transform: uppercase;
    transform: translateY(100%);
    transition: transform 0.2s ease;
  }

  .hp28-ig__item:hover .hp28-ig__overlay {
    transform: translateY(0);
  }

  .hp28-ig__footer {
    text-align: center;
  }

  .hp28-ig__btn {
    display: inline-block;
    background: var(--magenta);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 16px;
    text-decoration: none;
    padding: 15px 30px;
    border: 3px solid #fff;
    box-shadow: 6px 6px 0 var(--cyan);
    transition: all 0.2s ease;
    text-transform: uppercase;
    animation: hp28Shake 3s infinite;
  }

  @keyframes hp28Shake {
    0%, 90% { transform: translate(0, 0) rotate(0); }
    92% { transform: translate(2px, 2px) rotate(2deg); }
    94% { transform: translate(-2px, -2px) rotate(-2deg); }
    96% { transform: translate(2px, -2px) rotate(2deg); }
    98% { transform: translate(-2px, 2px) rotate(-2deg); }
    100% { transform: translate(0, 0) rotate(0); }
  }

  .hp28-ig__btn:hover {
    background: var(--cyan);
    color: #000;
    box-shadow: 4px 4px 0 var(--magenta);
    animation: none;
    transform: translate(2px, 2px);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-ig-wrapper" id="HP28Instagram-{{ section.id }}">
  
  <div class="hp28-ig__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp28-ig__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="hp28-ig__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  <div class="hp28-ig__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link_url | default: '#' }}" class="hp28-ig__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 600 }}" alt="Instagram Image" class="hp28-ig__image" loading="lazy">
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'hp28-ig__image' }}
        {%- endif -%}
        
        <div class="hp28-ig__overlay">VIEW_DATA</div>
      </a>
    {%- endfor -%}
  </div>

  <div class="hp28-ig__footer">
    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hp28-ig__btn">
        {{ section.settings.button_text }}
      </a>
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "HP28 - Y2K Instagram",
  "class": "section-hp28-instagram",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SOCIAL_GRID"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "@YOURHANDLE"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "FOLLOW NETWORK"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 5
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Y2K Cyber Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Deep Purple)",
      "default": "#1C0B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cyan_color",
      "label": "Cyan Accent",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "magenta_color",
      "label": "Magenta Accent",
      "default": "#FF00FF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 10,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP28 - Y2K Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
