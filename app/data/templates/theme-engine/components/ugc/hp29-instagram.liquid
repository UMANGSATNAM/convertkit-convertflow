{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp29-ig-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .hp29-ig-wrapper {
      padding: 0 20px;
    }
  }

  .hp29-ig__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .hp29-ig__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp29-ig__handle {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 400;
    text-decoration: none;
    color: var(--text-color);
    margin-bottom: 40px;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .hp29-ig__handle:hover {
    opacity: 1;
    color: var(--accent-color);
  }

  .hp29-ig__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 20px;
  }

  @media screen and (max-width: 992px) {
    .hp29-ig__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 576px) {
    .hp29-ig__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .hp29-ig__item {
    position: relative;
    aspect-ratio: 1/1;
    border-radius: 40px; /* Soft organic corners */
    overflow: hidden;
    text-decoration: none;
    display: block;
    background: rgba(0,0,0,0.03);
  }
  
  /* Alternate shapes for visual interest */
  .hp29-ig__item:nth-child(even) {
    border-radius: 20px 60px 20px 60px;
  }

  .hp29-ig__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hp29-ig__item:hover .hp29-ig__image {
    transform: scale(1.05);
  }

  .hp29-ig__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .hp29-ig__item:hover .hp29-ig__overlay {
    opacity: 1;
  }

  .hp29-ig__icon {
    width: 32px;
    height: 32px;
    color: #fff;
    fill: currentColor;
    transform: translateY(10px);
    transition: transform 0.4s ease;
  }

  .hp29-ig__item:hover .hp29-ig__icon {
    transform: translateY(0);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp29-ig-wrapper" id="HP29IG-{{ section.id }}">
  {%- if section.settings.title != blank -%}
    <h2 class="hp29-ig__title">{{ section.settings.title }}</h2>
  {%- endif -%}

  {%- if section.settings.handle != blank -%}
    <a href="{{ section.settings.link | default: '#' }}" class="hp29-ig__handle" target="_blank">
      {{ section.settings.handle }}
    </a>
  {%- endif -%}

  <div class="hp29-ig__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp29-ig__item" target="_blank" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="Instagram Post" class="hp29-ig__image" loading="lazy">
        {%- else -%}
          {%- assign placeholder = 'collection-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'collection-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp29-ig__image' }}
        {%- endif -%}
        
        <div class="hp29-ig__overlay">
          <svg class="hp29-ig__icon" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm3.975-9.458a1.44 1.44 0 100-2.88 1.44 1.44 0 000 2.88z"/>
          </svg>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP29 - Boho Instagram",
  "class": "section-hp29-instagram",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Join the <em>Community</em>"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "@bohostudio"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Instagram URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Earthy Boho Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Beige)",
      "default": "#F4F1DE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#3D405B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (Terracotta)",
      "default": "#E07A5F"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Instagram Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP29 - Boho Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
