{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Shrikhand&family=DM+Sans:wght@400;500;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Shrikhand', cursive;
    --font-body: 'DM Sans', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  .hp37-ugc-wrapper {
    max-width: 100vw;
  }

  .hp37-ugc__header {
    padding: 0 40px 40px;
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .hp37-ugc__header {
      padding: 0 20px 30px;
    }
  }

  .hp37-ugc__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 6vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0;
    text-shadow: 2px 2px 0px var(--accent-color);
    transform: rotate(-2deg);
  }

  .hp37-ugc__track {
    display: flex;
    overflow-x: auto;
    padding: 20px 40px 60px;
    gap: 40px;
    scrollbar-width: none;
  }

  .hp37-ugc__track::-webkit-scrollbar {
    display: none;
  }

  /* Polaroid style card */
  .hp37-ugc__card {
    flex: 0 0 300px;
    background: #fff;
    padding: 15px 15px 60px 15px; /* Big bottom padding for polaroid look */
    border: 3px solid var(--text-color);
    box-shadow: 8px 8px 0px var(--accent-color);
    text-decoration: none;
    position: relative;
    transition: transform 0.3s ease;
  }

  /* Rotate odd/even cards for messy polaroid pile effect */
  .hp37-ugc__card:nth-child(odd) {
    transform: rotate(-3deg);
  }
  .hp37-ugc__card:nth-child(even) {
    transform: rotate(2deg);
    margin-top: 20px;
  }

  .hp37-ugc__card:hover {
    transform: rotate(0deg) scale(1.05) translateY(-10px);
    z-index: 10;
  }

  .hp37-ugc__image-wrap {
    width: 100%;
    aspect-ratio: 1;
    background: #f4f4f4;
    border: 2px solid var(--text-color);
    overflow: hidden;
  }

  .hp37-ugc__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  .hp37-ugc__handle {
    position: absolute;
    bottom: 20px;
    left: 20px;
    font-family: var(--font-heading); /* Use cursive for handwritten feel */
    font-size: 20px;
    color: var(--text-color);
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp37-ugc-wrapper" id="HP37UGC-{{ section.id }}">
  <div class="hp37-ugc__header">
    <h2 class="hp37-ugc__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp37-ugc__track">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp37-ugc__card" {{ block.shopify_attributes }}>
        <div class="hp37-ugc__image-wrap">
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.handle | escape }}" class="hp37-ugc__image" loading="lazy">
          {%- else -%}
            {%- assign placeholder = 'collection-' | append: forloop.index -%}
            {%- if forloop.index > 6 -%}{%- assign placeholder = 'collection-1' -%}{%- endif -%}
            {{ placeholder | placeholder_svg_tag: 'hp37-ugc__image' }}
          {%- endif -%}
        </div>
        <div class="hp37-ugc__handle">{{ block.settings.handle }}</div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP37 - Retro UGC",
  "class": "section-hp37-ugc-reels",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "In The Wild"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "header",
      "content": "Retro Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4E3C5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A3219"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D96C4A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "ugc",
      "name": "UGC Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Social Handle",
          "default": "@surfsup"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP37 - Retro UGC",
      "blocks": [
        { "type": "ugc" },
        { "type": "ugc" },
        { "type": "ugc" },
        { "type": "ugc" },
        { "type": "ugc" }
      ]
    }
  ]
}
{% endschema %}
