{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp49-insta-bg: {{ section.settings.bg_color | default: '#F5F3FF' }};
    
    background-color: var(--hp49-insta-bg);
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
  }

  .hp49-insta__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp49-insta__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp49-insta__sub {
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #7C3AED;
    margin: 0 0 8px;
  }

  .hp49-insta__heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 800;
    color: #2E1065;
    margin: 0;
  }

  .hp49-insta__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 18px;
  }

  .hp49-insta__item {
    aspect-ratio: 1;
    border-radius: 28px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(124, 58, 237, 0.15);
    box-shadow: 0 10px 30px rgba(124, 58, 237, 0.06);
  }

  .hp49-insta__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hp49-insta__item:hover .hp49-insta__img { transform: scale(1.06); }

  .hp49-insta__tag {
    position: absolute;
    bottom: 12px; left: 12px;
    background: rgba(46, 16, 101, 0.85);
    backdrop-filter: blur(8px);
    color: #FFFFFF;
    font-family: 'Urbanist', sans-serif;
    font-size: 11px;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: 50px;
  }

  @media screen and (max-width: 992px) {
    .hp49-insta__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp49-insta__wrap">
  <div class="hp49-insta__header">
    <p class="hp49-insta__sub">{{ section.settings.subheading | default: '@PERI_LAVENDER' }}</p>
    <h2 class="hp49-insta__heading">{{ section.settings.heading | default: 'Shop The Lavender Cloud Gallery' }}</h2>
  </div>

  <div class="hp49-insta__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp49-insta__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" class="hp49-insta__img" alt="{{ block.settings.tag }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hp49-insta__img' }}
          {%- endif -%}
          <span class="hp49-insta__tag">{{ block.settings.tag | default: 'Shop Cloud Serum' }}</span>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp49-insta__item">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp49-insta__img' }}
        <span class="hp49-insta__tag">Shop Cloud Serum</span>
      </div>
      <div class="hp49-insta__item">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp49-insta__img' }}
        <span class="hp49-insta__tag">Shop Blossom Mist</span>
      </div>
      <div class="hp49-insta__item">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp49-insta__img' }}
        <span class="hp49-insta__tag">Shop Pillow Mask</span>
      </div>
      <div class="hp49-insta__item">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp49-insta__img' }}
        <span class="hp49-insta__tag">Shop Melt Balm</span>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP49 - Lavender Lookbook",
  "class": "section-hp49-lookbook",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F3FF" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 70 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "gallery_item",
      "name": "Lookbook Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Shop Cloud Serum" }
      ]
    }
  ],
  "presets": [
    { "name": "HP49 - Lavender Lookbook" }
  ]
}
{% endschema %}
