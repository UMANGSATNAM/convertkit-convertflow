{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-primary: {{ section.settings.accent_primary }};
    --accent-secondary: {{ section.settings.accent_secondary }};
    --font-heading: 'Orbitron', sans-serif;
    --font-body: 'Share Tech Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    border-top: 1px dashed rgba(255,255,255,0.1);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp24-insta-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp24-insta-wrapper {
      padding: 0 20px;
    }
  }

  .hp24-insta__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp24-insta__sys-text {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--accent-secondary);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .hp24-insta__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-shadow: 0 0 10px rgba(0, 243, 255, 0.3);
  }

  .hp24-insta__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 15px;
  }

  @media screen and (max-width: 992px) {
    .hp24-insta__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 600px) {
    .hp24-insta__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }

  .hp24-insta__item {
    position: relative;
    aspect-ratio: 1/1;
    display: block;
    overflow: hidden;
    background: #000;
    border: 1px solid rgba(0, 243, 255, 0.2);
  }

  .hp24-insta__item::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(
      transparent,
      transparent 2px,
      rgba(0,0,0,0.3) 3px,
      rgba(0,0,0,0.3) 4px
    );
    z-index: 2;
    pointer-events: none;
  }

  .hp24-insta__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.5) hue-rotate(180deg) saturate(1.5);
    transition: all 0.5s ease;
    z-index: 1;
  }

  .hp24-insta__item:hover .hp24-insta__image {
    filter: none;
    transform: scale(1.1);
  }

  .hp24-insta__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 243, 255, 0.8);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 3;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .hp24-insta__item:hover .hp24-insta__overlay {
    opacity: 1;
  }

  .hp24-insta__icon {
    width: 32px;
    height: 32px;
    fill: var(--bg-color);
    margin-bottom: 10px;
  }

  .hp24-insta__text {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: var(--bg-color);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .hp24-insta__btn-wrapper {
    text-align: center;
    margin-top: 50px;
  }

  .hp24-insta__btn {
    font-family: var(--font-heading);
    display: inline-flex;
    align-items: center;
    padding: 12px 30px;
    background: transparent;
    color: var(--accent-primary);
    border: 1px solid var(--accent-primary);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: inset 0 0 0 rgba(0, 243, 255, 0);
  }

  .hp24-insta__btn:hover {
    background: var(--accent-primary);
    color: var(--bg-color);
    box-shadow: inset 0 0 10px rgba(255,255,255,0.5), 0 0 15px var(--accent-primary);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp24-insta-wrapper" id="HP24Insta-{{ section.id }}">
  <div class="hp24-insta__header">
    <div class="hp24-insta__sys-text">DATA_LINK: SOCIAL_NODE</div>
    {%- if section.settings.title != blank -%}
      <h2 class="hp24-insta__title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

  <div class="hp24-insta__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp24-insta__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="Social image" class="hp24-insta__image" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;background:#111;display:flex;align-items:center;justify-content:center;color:#444;font-family:'Share Tech Mono';">IMG_FILE</div>
        {%- endif -%}
        
        <div class="hp24-insta__overlay">
          <svg class="hp24-insta__icon" viewBox="0 0 24 24"><path d="M7.8,2H16.2C19.4,2 22,4.6 22,7.8V16.2A5.8,5.8 0 0,1 16.2,22H7.8C4.6,22 2,19.4 2,16.2V7.8A5.8,5.8 0 0,1 7.8,2M7.6,4A3.6,3.6 0 0,0 4,7.6V16.4C4,18.39 5.61,20 7.6,20H16.4A3.6,3.6 0 0,0 20,16.4V7.6C20,5.61 18.39,4 16.4,4H7.6M17.25,5.5A1.25,1.25 0 0,1 18.5,6.75A1.25,1.25 0 0,1 17.25,8A1.25,1.25 0 0,1 16,6.75A1.25,1.25 0 0,1 17.25,5.5M12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"/></svg>
          <span class="hp24-insta__text">VIEW_LOG</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
  
  {%- if section.settings.btn_text != blank -%}
    <div class="hp24-insta__btn-wrapper">
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp24-insta__btn">
        {{ section.settings.btn_text | escape }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP24 - Cyber Instagram",
  "class": "section-hp24-instagram",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SOCIAL NODE"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 40
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "CONNECT TO NETWORK"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 5
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Cyberpunk Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_primary",
      "label": "Accent Primary (Neon Blue)",
      "default": "#00F3FF"
    },
    {
      "type": "color",
      "id": "accent_secondary",
      "label": "Accent Secondary (Neon Pink)",
      "default": "#FF00E6"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Social Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP24 - Cyber Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
