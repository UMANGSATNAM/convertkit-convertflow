{%- liquid
  assign bg_color = section.settings.bg_color | default: '#f9f6f0'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp4-ig-bg: {{ bg_color }};
    --hp4-ig-text: {{ text_color }};
    
    --hp4-ig-pt-desk: {{ padding_top_desktop }}px;
    --hp4-ig-pb-desk: {{ padding_bottom_desktop }}px;
    --hp4-ig-pt-mob: {{ padding_top_mobile }}px;
    --hp4-ig-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp4-decor-ig-{{ section.id }} {
    padding-top: var(--hp4-ig-pt-desk);
    padding-bottom: var(--hp4-ig-pb-desk);
    background-color: var(--hp4-ig-bg);
    color: var(--hp4-ig-text);
    font-family: 'Inter', sans-serif;
  }

  .hp4-ig-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp4-ig-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp4-ig-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 15px 0;
  }
  .hp4-ig-title em { font-style: italic; }

  .hp4-ig-handle {
    font-size: 15px;
    color: rgba(44,44,44,0.7);
    margin: 0;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .hp4-ig-handle:hover {
    color: var(--hp4-ig-text);
  }

  /* Masonry-style Grid */
  .hp4-ig-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 250px;
    gap: 15px;
  }

  .hp4-ig-item {
    position: relative;
    display: block;
    overflow: hidden;
    background: #e8e3d8;
  }
  
  /* Make some items span 2 rows */
  .hp4-ig-item:nth-child(2),
  .hp4-ig-item:nth-child(5) {
    grid-row: span 2;
  }

  .hp4-ig-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.25, 1, 0.5, 1), filter 0.5s ease;
  }

  .hp4-ig-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(5px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: all 0.5s ease;
  }

  .hp4-ig-icon {
    width: 40px; height: 40px;
    color: var(--hp4-ig-text);
    transform: translateY(20px);
    transition: all 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .hp4-ig-icon svg { width: 100%; height: 100%; fill: currentColor; }

  .hp4-ig-item:hover .hp4-ig-img {
    transform: scale(1.05);
    filter: brightness(0.9);
  }
  .hp4-ig-item:hover .hp4-ig-overlay {
    opacity: 1;
  }
  .hp4-ig-item:hover .hp4-ig-icon {
    transform: translateY(0);
  }

  @media screen and (max-width: 1024px) {
    .hp4-ig-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 200px;
    }
    .hp4-ig-item:nth-child(5) { grid-row: span 1; }
  }

  @media screen and (max-width: 768px) {
    .hp4-decor-ig-{{ section.id }} {
      padding-top: var(--hp4-ig-pt-mob);
      padding-bottom: var(--hp4-ig-pb-mob);
    }
    .hp4-ig-inner {
      padding: 0 20px;
    }
    .hp4-ig-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 160px;
      gap: 10px;
    }
    .hp4-ig-item:nth-child(2) { grid-row: span 1; }
  }
</style>

<section class="hp4-decor-ig-{{ section.id }}" aria-label="Instagram Feed">
  <div class="hp4-ig-inner">
    
    <div class="hp4-ig-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="hp4-ig-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.handle != blank -%}
        <a href="{{ section.settings.link }}" class="hp4-ig-handle" target="_blank">{{ section.settings.handle }}</a>
      {%- endif -%}
    </div>

    <div class="hp4-ig-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" target="_blank" class="hp4-ig-item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp4-ig-img" loading="lazy" alt="Instagram Post">
          {%- else -%}
            {%- capture current -%}{% cycle 1, 2, 3, 4, 5, 6 %}{%- endcapture -%}
            {{ 'collection-' | append: current | placeholder_svg_tag: 'hp4-ig-img placeholder-svg' }}
          {%- endif -%}
          <div class="hp4-ig-overlay">
            <div class="hp4-ig-icon">
              <!-- Instagram Icon SVG -->
              <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </div>
          </div>
        </a>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..6) -%}
          <a href="#" class="hp4-ig-item">
            {{ 'collection-' | append: i | placeholder_svg_tag: 'hp4-ig-img placeholder-svg' }}
            <div class="hp4-ig-overlay"><div class="hp4-ig-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle></svg></div></div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP4 Decor Instagram",
  "tag": "section",
  "class": "section-hp4-instagram",
  "max_blocks": 8,
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Join the <em>Studio</em>"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "@yourbrand"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Instagram Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f6f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Instagram Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP4 Decor Instagram",
      "category": "Social",
      "blocks": [
        { "type": "post" }, { "type": "post" }, { "type": "post" },
        { "type": "post" }, { "type": "post" }, { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
