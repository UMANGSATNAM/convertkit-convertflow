{%- style -%}#shopify-section-{{ section.id }}{background:#FFF1F2;padding:40px 0}.hp97-ugc{max-width:1280px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:12px}@media(max-width:800px){.hp97-ugc{grid-template-columns:repeat(2,1fr)}}.hp97-reel{aspect-ratio:9/16;border-radius:12px;overflow:hidden;background:#000;position:relative}.hp97-reel img{width:100%;height:100%;object-fit:cover}.hp97-play{position:absolute;inset:0;display:grid;place-items:center;color:#fff;font-size:28px}{%- endstyle -%}<div class="hp97-ugc">{% for i in (1..4) %}<div class="hp97-reel">{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:400}}">{% else %}{{'collection-1'|placeholder_svg_tag}}{% endif %}<span class="hp97-play">▶</span></div>{% endfor %}</div>{% schema %}{"name":"HP97 Reels","settings":[{"type":"image_picker","id":"image","label":"Image"}],"presets":[{"name":"HP97 Reels"}]}{% endschema %}