{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp44-insta-bg: {{ section.settings.bg_color | default: '#EDF4EE' }};
    --hp44-insta-title: {{ section.settings.title_color | default: '#143D2B' }};
    --hp44-insta-accent: {{ section.settings.accent_color | default: '#2D6A4F' }};
    
    background-color: var(--hp44-insta-bg);
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
  }

  .hp44-insta__wrapper {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp44-insta__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp44-insta__sub {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--hp44-insta-accent);
    margin: 0 0 8px;
  }

  .hp44-insta__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(26px, 3.5vw, 36px);
    font-weight: 700;
    color: var(--hp44-insta-title);
    margin: 0;
  }

  .hp44-insta__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 18px;
  }

  .hp44-insta__item {
    aspect-ratio: 1;
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    border: 1px solid #D8E8DC;
    box-shadow: 0 8px 24px rgba(20, 61, 43, 0.05);
  }

  .hp44-insta__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hp44-insta__item:hover .hp44-insta__img {
    transform: scale(1.06);
  }

  .hp44-insta__shop-tag {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(20, 61, 43, 0.85);
    backdrop-filter: blur(8px);
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 50px;
  }

  @media screen and (max-width: 992px) {
    .hp44-insta__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp44-insta__wrapper">
  <div class="hp44-insta__header">
    <p class="hp44-insta__sub">{{ section.settings.subheading | default: '@PERI_HERBARIUM' }}</p>
    <h2 class="hp44-insta__heading">{{ section.settings.heading | default: 'Shop The Herbarium Aesthetic' }}</h2>
  </div>

  <div class="hp44-insta__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp44-insta__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" class="hp44-insta__img" alt="{{ block.settings.title }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hp44-insta__img' }}
          {%- endif -%}
          <span class="hp44-insta__shop-tag">{{ block.settings.tag | default: 'Shop Sage Elixir' }}</span>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp44-insta__item">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp44-insta__img' }}
        <span class="hp44-insta__shop-tag">Shop Sage Elixir</span>
      </div>
      <div class="hp44-insta__item">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp44-insta__img' }}
        <span class="hp44-insta__shop-tag">Shop Velvet Cream</span>
      </div>
      <div class="hp44-insta__item">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp44-insta__img' }}
        <span class="hp44-insta__shop-tag">Shop Essence Mist</span>
      </div>
      <div class="hp44-insta__item">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp44-insta__img' }}
        <span class="hp44-insta__shop-tag">Shop Gel Mask</span>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP44 - Sage Lookbook",
  "class": "section-hp44-lookbook",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#EDF4EE" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#143D2B" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#2D6A4F" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "@PERI_HERBARIUM" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop The Herbarium Aesthetic" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 70 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "gallery_item",
      "name": "Lookbook Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Product Tag", "default": "Shop Sage Elixir" },
        { "type": "url", "id": "url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    { "name": "HP44 - Sage Lookbook" }
  ]
}
{% endschema %}
