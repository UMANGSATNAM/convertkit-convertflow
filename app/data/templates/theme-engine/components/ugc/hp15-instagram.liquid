{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    color: {{ text_color }};
  }
  
  .hp15-ig-container-{{ section_id }} {
    max-width: 1600px;
    margin: 0 auto;
  }
  
  .hp15-ig-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 60px;
  }
  
  .hp15-ig-heading-{{ section_id }} {
    font-family: 'Didot', 'Playfair Display', serif;
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0;
  }
  
  .hp15-ig-handle-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: {{ text_color }};
    text-decoration: none;
    border-bottom: 1px solid {{ text_color }};
    padding-bottom: 5px;
  }
  
  .hp15-ig-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.1);
  }
  
  .hp15-ig-item-{{ section_id }} {
    position: relative;
    padding-top: 100%;
    overflow: hidden;
    display: block;
    background: {{ bg_color }};
  }
  
  .hp15-ig-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.5s ease;
  }
  
  .hp15-ig-item-{{ section_id }}:hover .hp15-ig-image-{{ section_id }} {
    filter: grayscale(0%);
  }

  @media (max-width: 992px) {
    .hp15-ig-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp15-ig-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }
</style>

<div class="hp15-ig-container-{{ section_id }}">
  <div class="hp15-ig-header-{{ section_id }}">
    <h2 class="hp15-ig-heading-{{ section_id }}">THE NETWORK</h2>
    <a href="{{ section.settings.link | default: '#' }}" class="hp15-ig-handle-{{ section_id }}">@{{ section.settings.handle | default: 'MAISON' }}</a>
  </div>
  
  <div class="hp15-ig-grid-{{ section_id }}">
    {% for block in section.blocks limit: 4 %}
      <a href="{{ block.settings.link | default: '#' }}" class="hp15-ig-item-{{ section_id }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600, height: 600, crop: 'center' }}" class="hp15-ig-image-{{ section_id }}" alt="Instagram" loading="lazy">
        {% else %}
          <div class="hp15-ig-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP15 Instagram",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "MAISON"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Profile Link"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Instagram Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP15 Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
