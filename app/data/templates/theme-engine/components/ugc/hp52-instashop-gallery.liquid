{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: "#FFF8F5" }};
    padding: {{ section.settings.padding_top | default: 70 }}px 20px {{ section.settings.padding_bottom | default: 70 }}px;
  }

  .hp52-insta__title {
    font-family: 'Outfit', sans-serif;
    font-size: 28px;
    font-weight: 800;
    color: {{ section.settings.title_color | default: "#431407" }};
    text-align: center;
    margin: 0 0 35px;
  }

  .hp52-insta__grid {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr);
    gap: 16px;
  }

  .hp52-insta__card {
    aspect-ratio: 1;
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    border: 1px solid {{ section.settings.border_color | default: "#FFEDD5" }};
    display: block;
  }

  .hp52-insta__card img,
  .hp52-insta__card svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp52-insta__tag {
    position: absolute;
    left: 10px;
    bottom: 10px;
    background: rgba(67, 20, 7, 0.75);
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 99px;
  }

  @media screen and (max-width: 768px) {
    .hp52-insta__grid { grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, 1fr); }
    .hp52-insta__title { font-size: 22px; margin-bottom: 24px; }
  }
{%- endstyle -%}

{%- if section.settings.title != blank -%}
  <div class="hp52-insta__title">{{ section.settings.title }}</div>
{%- endif -%}

<div class="hp52-insta__grid">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign gl_link = block.settings.link
        if gl_link == blank
          assign gl_link = '#'
        endif
      -%}
      <a class="hp52-insta__card" href="{{ gl_link }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 500 }}"
            alt="{{ block.settings.image.alt | default: block.settings.tag | escape }}"
            width="500" height="500" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
        {%- if block.settings.tag != blank -%}
          <span class="hp52-insta__tag">{{ block.settings.tag }}</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
  {%- else -%}
    {%- for i in (1..4) -%}
      <div class="hp52-insta__card">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
    {%- endfor -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP52 - Clay Gallery",
  "class": "section-hp52-gallery",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop the look"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 70
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFF8F5"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading",
      "default": "#431407"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "#FFEDD5"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "HP52 - Clay Gallery",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
