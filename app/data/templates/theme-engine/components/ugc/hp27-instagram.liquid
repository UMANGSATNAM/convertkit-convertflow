{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Syncopate:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Syncopate', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    border-top: 1px solid rgba(226, 226, 226, 0.1);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp27-ig-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp27-ig-wrapper {
      padding: 0 20px;
    }
  }

  .hp27-ig__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  @media screen and (max-width: 768px) {
    .hp27-ig__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp27-ig__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3.5vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp27-ig__handle {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--bg-color);
    background: var(--accent-color);
    padding: 8px 16px;
    text-decoration: none;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: opacity 0.3s ease;
  }

  .hp27-ig__handle:hover {
    opacity: 0.8;
  }

  /* Grid lines mimicking a HUD */
  .hp27-ig__grid-container {
    position: relative;
    border: 1px solid rgba(226, 226, 226, 0.2);
    padding: 1px; /* space for internal borders */
  }

  .hp27-ig__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 1px;
    background: rgba(226, 226, 226, 0.2); /* Creates the 1px grid lines */
  }

  @media screen and (max-width: 992px) {
    .hp27-ig__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp27-ig__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .hp27-ig__item {
    position: relative;
    aspect-ratio: 1/1;
    background: var(--bg-color);
    overflow: hidden;
    display: block;
    cursor: pointer;
  }

  .hp27-ig__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.1);
    transition: all 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp27-ig__item:hover .hp27-ig__image {
    filter: grayscale(0%) contrast(1);
    transform: scale(1.03);
  }

  /* Crosshair on hover */
  .hp27-ig__crosshair {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%) scale(0.8);
    width: 40px; height: 40px;
    opacity: 0;
    transition: all 0.4s ease;
    pointer-events: none;
    z-index: 2;
  }

  .hp27-ig__crosshair::before,
  .hp27-ig__crosshair::after {
    content: '';
    position: absolute;
    background: var(--text-color);
  }
  .hp27-ig__crosshair::before {
    top: 50%; left: 0; width: 100%; height: 2px; transform: translateY(-50%);
  }
  .hp27-ig__crosshair::after {
    left: 50%; top: 0; height: 100%; width: 2px; transform: translateX(-50%);
  }

  .hp27-ig__item:hover .hp27-ig__crosshair {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp27-ig-wrapper" id="HP27IG-{{ section.id }}">
  <div class="hp27-ig__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp27-ig__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.handle != blank -%}
      <a href="{{ section.settings.link_url | default: '#' }}" class="hp27-ig__handle" target="_blank" rel="noopener">
        <span>{{ section.settings.handle }}</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
      </a>
    {%- endif -%}
  </div>

  <div class="hp27-ig__grid-container">
    <div class="hp27-ig__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link_url | default: '#' }}" class="hp27-ig__item" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="Instagram Image" class="hp27-ig__image" loading="lazy">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'hp27-ig__image' }}
          {%- endif -%}
          <div class="hp27-ig__crosshair"></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP27 - Eng Instagram",
  "class": "section-hp27-instagram",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SYSTEM.GALLERY"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle / Button",
      "default": "ACCESS LOGS: @BRAND"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Instagram URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 5
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Dark Engineered Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#E2E2E2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF2A2A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Instagram Post",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Post URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP27 - Eng Instagram",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
