{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Oswald:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    
    --font-serif: 'Playfair Display', serif;
    --font-sans: 'Oswald', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--border-color);
    overflow: hidden;
  }

  .hp36-ugc-wrapper {
    max-width: 100vw;
  }

  .hp36-ugc__header {
    padding: 0 40px 40px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid var(--border-color);
  }

  @media screen and (max-width: 768px) {
    .hp36-ugc__header {
      padding: 0 20px 30px;
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp36-ugc__title {
    font-family: var(--font-serif);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
  }
  
  .hp36-ugc__title em {
    font-style: italic;
    text-transform: lowercase;
  }

  .hp36-ugc__subtitle {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .hp36-ugc__track {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
  }

  .hp36-ugc__track::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .hp36-ugc__card {
    flex: 0 0 320px;
    aspect-ratio: 4/5;
    position: relative;
    border-right: 1px solid var(--border-color);
    text-decoration: none;
    background: #f4f4f4;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    .hp36-ugc__card {
      flex: 0 0 260px;
    }
  }

  .hp36-ugc__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.4s ease, transform 0.8s ease;
  }

  .hp36-ugc__card:hover .hp36-ugc__image {
    filter: grayscale(0%);
    transform: scale(1.05);
  }

  .hp36-ugc__overlay {
    position: absolute;
    bottom: 20px; left: 20px;
    background: var(--bg-color);
    padding: 8px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 2;
  }

  .hp36-ugc__handle {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  .hp36-ugc__icon {
    width: 16px; height: 16px;
    background: var(--text-color);
    color: var(--bg-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hp36-ugc__icon svg {
    width: 8px; height: 8px;
    fill: currentColor;
    margin-left: 1px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp36-ugc-wrapper" id="HP36UGC-{{ section.id }}">
  <div class="hp36-ugc__header">
    <h2 class="hp36-ugc__title">{{ section.settings.title | replace: 'Society', '<em>Society</em>' }}</h2>
    {%- if section.settings.subtitle != blank -%}
      <div class="hp36-ugc__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
  </div>

  <div class="hp36-ugc__track">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp36-ugc__card" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.handle | escape }}" class="hp36-ugc__image" loading="lazy">
        {%- else -%}
          {%- assign placeholder = 'collection-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'collection-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp36-ugc__image' }}
        {%- endif -%}
        
        <div class="hp36-ugc__overlay">
          <div class="hp36-ugc__icon">
            <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </div>
          <div class="hp36-ugc__handle">{{ block.settings.handle }}</div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP36 - Editorial UGC",
  "class": "section-hp36-ugc-reels",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "High Society"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "IN THE WILD"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "header",
      "content": "Editorial Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "ugc",
      "name": "UGC Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Social Handle",
          "default": "@username"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP36 - Editorial UGC",
      "blocks": [
        { "type": "ugc" },
        { "type": "ugc" },
        { "type": "ugc" },
        { "type": "ugc" },
        { "type": "ugc" },
        { "type": "ugc" }
      ]
    }
  ]
}
{% endschema %}
