{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f4f1de'
  assign text_color = section.settings.text_color | default: '#6b705c'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
  }
  
  .hp14-ig-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp14-ig-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
  }
  
  .hp14-ig-heading-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: normal;
    color: {{ text_color }};
    margin: 0;
  }
  
  .hp14-ig-heading-{{ section_id }} span {
    font-style: italic;
    color: #cb997e;
  }
  
  .hp14-ig-handle-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #cb997e;
    text-decoration: none;
    border-bottom: 1px solid #cb997e;
    padding-bottom: 2px;
  }
  
  .hp14-ig-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  
  .hp14-ig-item-{{ section_id }} {
    position: relative;
    padding-top: 100%;
    overflow: hidden;
    display: block;
    border-radius: 20px;
  }
  
  .hp14-ig-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  
  .hp14-ig-item-{{ section_id }}:hover .hp14-ig-image-{{ section_id }} {
    transform: scale(1.05);
  }
  
  .hp14-ig-overlay-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(107, 112, 92, 0.2);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  
  .hp14-ig-item-{{ section_id }}:hover .hp14-ig-overlay-{{ section_id }} {
    opacity: 1;
  }
  
  .hp14-ig-icon-{{ section_id }} {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    color: #fff;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 2;
  }
  
  .hp14-ig-item-{{ section_id }}:hover .hp14-ig-icon-{{ section_id }} {
    opacity: 1;
  }

  @media (max-width: 992px) {
    .hp14-ig-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp14-ig-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }
</style>

<div class="hp14-ig-container-{{ section_id }}">
  <div class="hp14-ig-header-{{ section_id }}">
    <h2 class="hp14-ig-heading-{{ section_id }}">On <span>Social</span></h2>
    <a href="{{ section.settings.link | default: '#' }}" class="hp14-ig-handle-{{ section_id }}">@{{ section.settings.handle | default: 'botanica' }}</a>
  </div>
  
  <div class="hp14-ig-grid-{{ section_id }}">
    {% for block in section.blocks limit: 4 %}
      <a href="{{ block.settings.link | default: '#' }}" class="hp14-ig-item-{{ section_id }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600, height: 600, crop: 'center' }}" class="hp14-ig-image-{{ section_id }}" alt="Instagram" loading="lazy">
        {% else %}
          <div class="hp14-ig-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
        {% endif %}
        <div class="hp14-ig-overlay-{{ section_id }}"></div>
        <div class="hp14-ig-icon-{{ section_id }}">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP14 Instagram",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f1de"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6b705c"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "botanica"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Profile Link"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Instagram Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP14 Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
