{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp44-ugc-bg: {{ section.settings.bg_color | default: '#EDF4EE' }};
    --hp44-ugc-title: {{ section.settings.title_color | default: '#143D2B' }};
    --hp44-ugc-accent: {{ section.settings.accent_color | default: '#2D6A4F' }};
    
    background-color: var(--hp44-ugc-bg);
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
  }

  .hp44-ugc__wrapper {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp44-ugc__title-block {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 40px;
  }

  .hp44-ugc__subhead {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--hp44-ugc-accent);
    margin: 0 0 8px;
  }

  .hp44-ugc__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(26px, 3.5vw, 36px);
    font-weight: 700;
    color: var(--hp44-ugc-title);
    margin: 0;
  }

  .hp44-ugc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 18px;
  }

  .hp44-ugc__card {
    aspect-ratio: 9/16;
    border-radius: 22px;
    overflow: hidden;
    position: relative;
    border: 1px solid #D8E8DC;
    box-shadow: 0 10px 30px rgba(20, 61, 43, 0.06);
    background: #143D2B;
  }

  .hp44-ugc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp44-ugc__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px 16px;
    background: linear-gradient(to top, rgba(20, 61, 43, 0.85), transparent);
    color: #FFFFFF;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .hp44-ugc__author {
    font-size: 13px;
    font-weight: 700;
    margin: 0 0 2px;
  }

  .hp44-ugc__tag {
    font-size: 11px;
    color: #D8E8DC;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp44-ugc__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{%- endstyle -%}

<div class="hp44-ugc__wrapper">
  <div class="hp44-ugc__title-block">
    {%- if section.settings.subheading != blank -%}
      <p class="hp44-ugc__subhead">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <h2 class="hp44-ugc__heading">{{ section.settings.heading | default: 'Nordic Herbarium In Real Life' }}</h2>
  </div>

  <div class="hp44-ugc__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp44-ugc__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp44-ugc__img" alt="{{ block.settings.handle }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'hp44-ugc__img' }}
          {%- endif -%}
          <div class="hp44-ugc__overlay">
            <div>
              <p class="hp44-ugc__author">{{ block.settings.handle | default: '@botanical_glow' }}</p>
              <p class="hp44-ugc__tag">{{ block.settings.tag | default: '#SageAlchemy' }}</p>
            </div>
            <span>▶</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp44-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp44-ugc__img' }}
        <div class="hp44-ugc__overlay">
          <div><p class="hp44-ugc__author">@linnea_nord</p><p class="hp44-ugc__tag">#ClarySageRitual</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp44-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp44-ugc__img' }}
        <div class="hp44-ugc__overlay">
          <div><p class="hp44-ugc__author">@nordic_skin</p><p class="hp44-ugc__tag">#SageVelvetCream</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp44-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp44-ugc__img' }}
        <div class="hp44-ugc__overlay">
          <div><p class="hp44-ugc__author">@herbarium_botanics</p><p class="hp44-ugc__tag">#MorningGlow</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp44-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp44-ugc__img' }}
        <div class="hp44-ugc__overlay">
          <div><p class="hp44-ugc__author">@astrid_wellness</p><p class="hp44-ugc__tag">#CleanBeauty</p></div>
          <span>▶</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP44 - Sage UGC",
  "class": "section-hp44-ugc",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#EDF4EE" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#143D2B" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#2D6A4F" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Community Rituals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nordic Herbarium In Real Life" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 70 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Reel Poster Image" },
        { "type": "text", "id": "handle", "label": "Social Handle", "default": "@botanical_glow" },
        { "type": "text", "id": "tag", "label": "Hashtag", "default": "#SageAlchemy" }
      ]
    }
  ],
  "presets": [
    { "name": "HP44 - Sage UGC" }
  ]
}
{% endschema %}
