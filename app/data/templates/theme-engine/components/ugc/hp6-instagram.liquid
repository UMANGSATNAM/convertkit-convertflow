{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#ff2a5f'
  assign heading = section.settings.heading | default: 'COMMUNITY'
  assign subtext = section.settings.subtext | default: 'Show us how you move. Tag @brandname to be featured.'
  assign ig_handle = section.settings.ig_handle | default: '@YOURBRAND'
  assign columns_desktop = section.settings.columns_desktop | default: 4
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 0;
    color: {{ text_color }};
  }
  
  .hp6-ig-container-{{ section_id }} {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .hp6-ig-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
    flex-wrap: wrap;
    gap: 20px;
  }
  
  .hp6-ig-title-area-{{ section_id }} h2 {
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.9;
    margin: 0;
    font-family: 'Impact', 'Arial Black', sans-serif;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px {{ text_color }};
    position: relative;
    display: inline-block;
  }
  
  .hp6-ig-title-area-{{ section_id }} h2::before {
    content: attr(data-text);
    position: absolute;
    left: 4px;
    top: 4px;
    color: {{ accent_color }};
    -webkit-text-stroke: 0;
    z-index: -1;
    opacity: 0.8;
  }
  
  .hp6-ig-title-area-{{ section_id }} p {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    margin: 15px 0 0 0;
    opacity: 0.7;
    max-width: 400px;
  }
  
  .hp6-ig-handle-link-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: {{ bg_color }};
    background: {{ text_color }};
    padding: 12px 25px;
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: none;
    font-size: 1rem;
    letter-spacing: 1px;
    transform: skewX(-15deg);
    transition: all 0.3s ease;
    border: 2px solid {{ text_color }};
  }
  
  .hp6-ig-handle-link-{{ section_id }} span {
    transform: skewX(15deg);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .hp6-ig-handle-link-{{ section_id }}:hover {
    background: transparent;
    color: {{ text_color }};
    border-color: {{ accent_color }};
    box-shadow: 5px 5px 0 {{ accent_color }};
    transform: skewX(-15deg) translateY(-5px);
  }
  
  .hp6-ig-handle-link-{{ section_id }} svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  
  .hp6-ig-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat({{ columns_desktop }}, 1fr);
    gap: 15px;
  }
  
  .hp6-ig-item-{{ section_id }} {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    background: #111;
    cursor: pointer;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    transition: clip-path 0.4s ease;
  }
  
  /* Create an edgy clip-path on hover */
  .hp6-ig-item-{{ section_id }}:hover {
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
  }
  
  .hp6-ig-item-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), filter 0.4s ease;
    filter: saturate(0.8) contrast(1.1);
  }
  
  .hp6-ig-item-{{ section_id }}:hover img {
    transform: scale(1.1);
    filter: saturate(1.2) contrast(1.2);
  }
  
  .hp6-ig-overlay-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 2;
  }
  
  .hp6-ig-item-{{ section_id }}:hover .hp6-ig-overlay-{{ section_id }} {
    opacity: 1;
  }
  
  .hp6-ig-icon-{{ section_id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 30px;
    height: 30px;
    background: {{ accent_color }};
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transform: translateY(-20px) scale(0.8);
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    z-index: 3;
  }
  
  .hp6-ig-item-{{ section_id }}:hover .hp6-ig-icon-{{ section_id }} {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  
  .hp6-ig-stats-{{ section_id }} {
    display: flex;
    gap: 20px;
    transform: translateY(20px);
    transition: transform 0.4s ease;
  }
  
  .hp6-ig-item-{{ section_id }}:hover .hp6-ig-stats-{{ section_id }} {
    transform: translateY(0);
  }
  
  .hp6-ig-stat-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1rem;
  }
  
  .hp6-ig-stat-{{ section_id }} svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  /* Make items span different rows/cols for a dynamic masonry look if desired. 
     For now, we stick to a clean square grid. */
  
  @media (max-width: 1024px) {
    .hp6-ig-grid-{{ section_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    .hp6-ig-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 30px;
    }
    .hp6-ig-title-area-{{ section_id }} h2 {
      font-size: 2.5rem;
    }
    .hp6-ig-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .hp6-ig-overlay-{{ section_id }} {
      opacity: 1;
      background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 60%);
    }
    .hp6-ig-stats-{{ section_id }} {
      transform: translateY(0);
    }
  }
  
  @media (max-width: 480px) {
    .hp6-ig-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="hp6-ig-container-{{ section_id }}">
  <div class="hp6-ig-header-{{ section_id }}">
    <div class="hp6-ig-title-area-{{ section_id }}">
      <h2 data-text="{{ heading }}">{{ heading }}</h2>
      {% if subtext != blank %}
        <p>{{ subtext }}</p>
      {% endif %}
    </div>
    
    {% if ig_handle != blank %}
      <a href="https://instagram.com/{{ ig_handle | remove: '@' }}" target="_blank" rel="noopener" class="hp6-ig-handle-link-{{ section_id }}">
        <span>
          <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          {{ ig_handle }}
        </span>
      </a>
    {% endif %}
  </div>

  <div class="hp6-ig-grid-{{ section_id }}">
    {% for block in section.blocks %}
      {% if block.type == 'image' %}
        <a href="{{ block.settings.link | default: '#' }}" class="hp6-ig-item-{{ section_id }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 800, height: 800, crop: 'center' }}" 
                 alt="Instagram Post"
                 loading="lazy"
                 width="800"
                 height="800">
          {% else %}
            <div style="width:100%; height:100%; background: #222; display:flex; align-items:center; justify-content:center; color:#555;">
              POST {{ forloop.index }}
            </div>
          {% endif %}
          
          <div class="hp6-ig-icon-{{ section_id }}">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </div>
          
          <div class="hp6-ig-overlay-{{ section_id }}">
            <div class="hp6-ig-stats-{{ section_id }}">
              <div class="hp6-ig-stat-{{ section_id }}">
                <svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                <span>{{ block.settings.likes | default: '1.2k' }}</span>
              </div>
              <div class="hp6-ig-stat-{{ section_id }}">
                <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <span>{{ block.settings.comments | default: '45' }}</span>
              </div>
            </div>
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP6 Instagram Grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff2a5f"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "COMMUNITY"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Show us how you move. Tag @brandname to be featured."
    },
    {
      "type": "text",
      "id": "ig_handle",
      "label": "Instagram Handle",
      "default": "@YOURBRAND"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Instagram Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post Link"
        },
        {
          "type": "text",
          "id": "likes",
          "label": "Likes Count",
          "default": "1.2k"
        },
        {
          "type": "text",
          "id": "comments",
          "label": "Comments Count",
          "default": "45"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP6 Instagram Grid",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
