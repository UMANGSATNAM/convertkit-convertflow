{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#2b302a'
  assign accent_color = section.settings.accent_color | default: '#4a6741'
  assign heading = section.settings.heading | default: 'Join the Movement'
  assign handle = section.settings.handle | default: '@yourbrand'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
  }
  
  .hp7-ig-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp7-ig-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 50px;
  }
  
  .hp7-ig-header-{{ section_id }} h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 500;
    margin: 0 0 15px 0;
  }
  
  .hp7-ig-handle-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: {{ accent_color }};
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  
  .hp7-ig-handle-{{ section_id }}:hover {
    opacity: 0.7;
  }
  
  .hp7-ig-handle-{{ section_id }} svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  
  .hp7-ig-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  
  .hp7-ig-item-{{ section_id }} {
    position: relative;
    aspect-ratio: 1/1;
    border-radius: 30px;
    overflow: hidden;
    background: #f5f5f5;
  }
  
  /* Make every even item have different border radius for organic feel */
  .hp7-ig-item-{{ section_id }}:nth-child(even) {
    border-radius: 50px 20px 50px 20px;
  }
  
  .hp7-ig-item-{{ section_id }}:nth-child(odd) {
    border-radius: 20px 50px 20px 50px;
  }
  
  .hp7-ig-item-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  
  .hp7-ig-item-{{ section_id }}:hover img {
    transform: scale(1.05);
  }
  
  .hp7-ig-overlay-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(74, 103, 65, 0.7); /* Accent color transparent */
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  
  .hp7-ig-item-{{ section_id }}:hover .hp7-ig-overlay-{{ section_id }} {
    opacity: 1;
  }
  
  .hp7-ig-icon-{{ section_id }} {
    color: #ffffff;
    transform: translateY(20px);
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  .hp7-ig-item-{{ section_id }}:hover .hp7-ig-icon-{{ section_id }} {
    transform: translateY(0);
  }
  
  .hp7-ig-icon-{{ section_id }} svg {
    width: 40px;
    height: 40px;
    fill: currentColor;
  }

  @media (max-width: 992px) {
    .hp7-ig-grid-{{ section_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    .hp7-ig-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
  }
</style>

<div class="hp7-ig-container-{{ section_id }}">
  <div class="hp7-ig-header-{{ section_id }}">
    <h2>{{ heading }}</h2>
    <a href="#" class="hp7-ig-handle-{{ section_id }}">
      <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
      {{ handle }}
    </a>
  </div>
  
  <div class="hp7-ig-grid-{{ section_id }}">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link | default: '#' }}" class="hp7-ig-item-{{ section_id }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 600, height: 600, crop: 'center' }}" alt="Instagram post" loading="lazy" width="300" height="300">
        {% else %}
          <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #eaeaea; color: #999;">
            POST {{ forloop.index }}
          </div>
        {% endif %}
        
        <div class="hp7-ig-overlay-{{ section_id }}">
          <div class="hp7-ig-icon-{{ section_id }}">
            <svg viewBox="0 0 24 24"><path d="M12,21.35L10.55,20.03C5.4,15.36 2,12.28 2,8.5C2,5.42 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.09C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.42 22,8.5C22,12.28 18.6,15.36 13.45,20.04L12,21.35Z" /></svg>
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP7 Instagram",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2b302a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#4a6741"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Movement"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "@yourbrand"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP7 Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
