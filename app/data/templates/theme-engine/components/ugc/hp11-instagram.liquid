{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    border-bottom: 3px solid #000;
  }
  
  .hp11-ig-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp11-ig-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
  }
  
  .hp11-ig-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
    color: #000;
    letter-spacing: -1px;
  }
  
  .hp11-ig-handle-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 800;
    color: #FF00FF;
    text-decoration: none;
    border-bottom: 2px solid #FF00FF;
    text-transform: uppercase;
  }
  
  .hp11-ig-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  
  .hp11-ig-item-{{ section_id }} {
    position: relative;
    padding-top: 100%;
    background: #000;
    border: 3px solid #000;
    overflow: hidden;
    box-shadow: 6px 6px 0 #000;
    transition: transform 0.2s ease;
  }
  
  .hp11-ig-item-{{ section_id }}:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 #000;
  }
  
  .hp11-ig-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.8;
    transition: opacity 0.3s;
  }
  
  .hp11-ig-item-{{ section_id }}:hover .hp11-ig-image-{{ section_id }} {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .hp11-ig-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
    .hp11-ig-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>

<div class="hp11-ig-container-{{ section_id }}">
  <div class="hp11-ig-header-{{ section_id }}">
    <h2 class="hp11-ig-heading-{{ section_id }}">{{ section.settings.heading | default: 'ON THE GRID' }}</h2>
    <a href="{{ section.settings.link | default: '#' }}" class="hp11-ig-handle-{{ section_id }}">{{ section.settings.handle | default: '@STREETWEAR' }}</a>
  </div>
  
  <div class="hp11-ig-grid-{{ section_id }}">
    {% for block in section.blocks limit: 4 %}
      <a href="{{ block.settings.link | default: '#' }}" class="hp11-ig-item-{{ section_id }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp11-ig-image-{{ section_id }}" alt="Instagram post">
        {% else %}
          <div class="hp11-ig-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
        {% endif %}
      </a>
    {% else %}
      {% for i in (1..4) %}
        <a href="#" class="hp11-ig-item-{{ section_id }}">
          <div class="hp11-ig-image-{{ section_id }}" style="background: #EEE;"></div>
        </a>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP11 Instagram",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ON THE GRID"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "@STREETWEAR"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Profile Link"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP11 Instagram"
    }
  ]
}
{% endschema %}
