{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAFAFA'
  assign text_color = section.settings.text_color | default: '#333333'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 1px solid #E5E5E5;
  }
  
  .hp12-ig-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp12-ig-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .hp12-ig-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 300;
    margin: 0 0 10px 0;
    letter-spacing: 1px;
    color: {{ text_color }};
  }
  
  .hp12-ig-handle-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 400;
    color: {{ text_color }};
    text-decoration: none;
    opacity: 0.6;
    letter-spacing: 1px;
  }
  
  .hp12-ig-handle-{{ section_id }}:hover {
    opacity: 1;
  }
  
  .hp12-ig-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  
  .hp12-ig-item-{{ section_id }} {
    position: relative;
    padding-top: 100%;
    background: #E5E5E5;
    overflow: hidden;
    display: block;
  }
  
  .hp12-ig-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  
  .hp12-ig-item-{{ section_id }}:hover .hp12-ig-image-{{ section_id }} {
    transform: scale(1.05);
  }

  @media (max-width: 992px) {
    .hp12-ig-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp12-ig-grid-{{ section_id }} {
      gap: 10px;
    }
  }
</style>

<div class="hp12-ig-container-{{ section_id }}">
  <div class="hp12-ig-header-{{ section_id }}">
    <h2 class="hp12-ig-heading-{{ section_id }}">{{ section.settings.heading | default: 'Spaces we love.' }}</h2>
    <a href="{{ section.settings.link | default: '#' }}" class="hp12-ig-handle-{{ section_id }}">{{ section.settings.handle | default: '@yourbrand' }}</a>
  </div>
  
  <div class="hp12-ig-grid-{{ section_id }}">
    {% for block in section.blocks limit: 4 %}
      <a href="{{ block.settings.link | default: '#' }}" class="hp12-ig-item-{{ section_id }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 600, height: 600, crop: 'center' }}" class="hp12-ig-image-{{ section_id }}" alt="Instagram" loading="lazy">
        {% else %}
          <div class="hp12-ig-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP12 Instagram",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Spaces we love."
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "@yourbrand"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Profile Link"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Instagram Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP12 Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
