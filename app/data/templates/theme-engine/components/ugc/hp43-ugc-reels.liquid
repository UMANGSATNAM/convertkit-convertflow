{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: "#080B10" }};
    padding: {{ section.settings.padding_top | default: 70 }}px 20px {{ section.settings.padding_bottom | default: 70 }}px;
  }

  .hp43-ugc__title {
    font-family: 'Orbitron', sans-serif;
    font-size: 28px;
    font-weight: 800;
    color: {{ section.settings.title_color | default: "#F1F5F9" }};
    text-align: center;
    margin: 0 0 40px;
    text-transform: uppercase;
  }

  .hp43-ugc__grid {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr);
    gap: 18px;
  }

  .hp43-ugc__card {
    aspect-ratio: 9/16;
    border-radius: 6px;
    overflow: hidden;
    position: relative;
    border: 1px solid {{ section.settings.border_color | default: "#1E293B" }};
    display: block;
    background: #000000;
  }

  .hp43-ugc__card img,
  .hp43-ugc__card svg,
  .hp43-ugc__card video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp43-ugc__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    pointer-events: none;
  }
  .hp43-ugc__play svg { width: 42px; height: 42px; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.5)); }

  .hp43-ugc__handle {
    position: absolute;
    left: 8px;
    bottom: 8px;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
  }

  @media screen and (max-width: 768px) {
    .hp43-ugc__grid { grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, 1fr); }
    .hp43-ugc__title { font-size: 22px; margin-bottom: 24px; }
  }
{%- endstyle -%}

{%- if section.settings.title != blank -%}
  <div class="hp43-ugc__title">{{ section.settings.title }}</div>
{%- endif -%}

<div class="hp43-ugc__grid">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign reel_link = block.settings.link
        if reel_link == blank and block.settings.product != blank
          assign reel_link = block.settings.product.url
        endif
        if reel_link == blank
          assign reel_link = '#'
        endif
      -%}
      <a class="hp43-ugc__card" href="{{ reel_link }}" {{ block.shopify_attributes }}>
        {%- if block.settings.video != blank -%}
          {{ block.settings.video | video_tag: image_size: '400x', autoplay: true, loop: true, muted: true, controls: false }}
        {%- elsif block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 400 }}"
            alt="{{ block.settings.image.alt | default: block.settings.handle | escape }}"
            width="400" height="711" loading="lazy">
          <span class="hp43-ugc__play" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {%- endif -%}
        {%- if block.settings.handle != blank -%}
          <span class="hp43-ugc__handle">{{ block.settings.handle }}</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
  {%- else -%}
    {%- for i in (1..4) -%}
      <div class="hp43-ugc__card">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
    {%- endfor -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP43 - Cyber UGC Reels",
  "class": "section-hp43-ugc",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Systems in the wild"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 70
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#080B10"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading",
      "default": "#F1F5F9"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "#1E293B"
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Vertical 9:16 works best. Falls back to the image if empty."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover image"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Creator handle"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Linked product"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Overrides the linked product."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "HP43 - Cyber UGC Reels",
      "blocks": [
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" }
      ]
    }
  ]
}
{% endschema %}
