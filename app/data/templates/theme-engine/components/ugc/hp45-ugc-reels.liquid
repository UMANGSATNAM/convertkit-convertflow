{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp45-ugc-bg: {{ section.settings.bg_color | default: '#F5F5F0' }};
    --hp45-border: {{ section.settings.border_color | default: '#0A0A0A' }};
    
    background-color: var(--hp45-ugc-bg);
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
  }

  .hp45-ugc__wrap {
    max-width: {{ section.settings.container_width | default: 1300 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp45-ugc__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp45-ugc__heading {
    font-size: clamp(26px, 3.5vw, 36px);
    font-weight: 700;
    text-transform: uppercase;
    color: #0A0A0A;
    margin: 0;
  }

  .hp45-ugc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 18px;
  }

  .hp45-ugc__card {
    aspect-ratio: 9/16;
    border: 2px solid var(--hp45-border);
    box-shadow: 4px 4px 0 var(--hp45-border);
    position: relative;
    overflow: hidden;
    background: #0A0A0A;
  }

  .hp45-ugc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
  }

  .hp45-ugc__card:hover .hp45-ugc__img { filter: grayscale(0%); }

  .hp45-ugc__overlay {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 16px;
    background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
    color: #FFFFFF;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .hp45-ugc__handle {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    margin: 0 0 2px;
  }

  @media screen and (max-width: 992px) {
    .hp45-ugc__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp45-ugc__wrap">
  <div class="hp45-ugc__header">
    <h2 class="hp45-ugc__heading">{{ section.settings.heading | default: 'SYSTEM SURVEILLANCE // COMMUNITY FEED' }}</h2>
  </div>

  <div class="hp45-ugc__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp45-ugc__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp45-ugc__img" alt="{{ block.settings.handle }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'hp45-ugc__img' }}
          {%- endif -%}
          <div class="hp45-ugc__overlay">
            <div>
              <p class="hp45-ugc__handle">{{ block.settings.handle | default: '@USER_ARCHIVE' }}</p>
              <p style="font-family:'JetBrains Mono', monospace; font-size:10px; color:#AAA; margin:0;">[VERIFIED USAGE]</p>
            </div>
            <span>[▶]</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp45-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp45-ugc__img' }}
        <div class="hp45-ugc__overlay">
          <div><p class="hp45-ugc__handle">@TECH_DERM</p><p style="font-family:'JetBrains Mono', monospace; font-size:10px; color:#AAA; margin:0;">[VERIFIED USAGE]</p></div>
          <span>[▶]</span>
        </div>
      </div>
      <div class="hp45-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp45-ugc__img' }}
        <div class="hp45-ugc__overlay">
          <div><p class="hp45-ugc__handle">@MINIMAL_BIO</p><p style="font-family:'JetBrains Mono', monospace; font-size:10px; color:#AAA; margin:0;">[VERIFIED USAGE]</p></div>
          <span>[▶]</span>
        </div>
      </div>
      <div class="hp45-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp45-ugc__img' }}
        <div class="hp45-ugc__overlay">
          <div><p class="hp45-ugc__handle">@CLINICAL_CHENG</p><p style="font-family:'JetBrains Mono', monospace; font-size:10px; color:#AAA; margin:0;">[VERIFIED USAGE]</p></div>
          <span>[▶]</span>
        </div>
      </div>
      <div class="hp45-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp45-ugc__img' }}
        <div class="hp45-ugc__overlay">
          <div><p class="hp45-ugc__handle">@BARRIER_RESEARCH</p><p style="font-family:'JetBrains Mono', monospace; font-size:10px; color:#AAA; margin:0;">[VERIFIED USAGE]</p></div>
          <span>[▶]</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP45 - Brutal UGC",
  "class": "section-hp45-ugc",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F5F0" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#0A0A0A" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "SYSTEM SURVEILLANCE // COMMUNITY FEED" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 70 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1300 }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "handle", "label": "Handle", "default": "@USER_ARCHIVE" }
      ]
    }
  ],
  "presets": [
    { "name": "HP45 - Brutal UGC" }
  ]
}
{% endschema %}
