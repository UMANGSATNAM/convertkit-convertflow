{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp51-ugc-bg: {{ section.settings.bg_color | default: '#F2EFE9' }};
    --hp51-matcha: {{ section.settings.accent_matcha | default: '#2D5A3D' }};
    
    background-color: var(--hp51-ugc-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp51-ugc__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp51-ugc__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp51-ugc__heading {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 700;
    color: #1E3A2B;
    margin: 0;
  }

  .hp51-ugc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 18px;
  }

  .hp51-ugc__card {
    aspect-ratio: 9/16;
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 10px 30px rgba(30, 58, 43, 0.08);
  }

  .hp51-ugc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hp51-ugc__card:hover .hp51-ugc__img { transform: scale(1.05); }

  .hp51-ugc__overlay {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 18px;
    background: linear-gradient(to top, rgba(30, 58, 43, 0.9), transparent);
    color: #FAF8F5;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .hp51-ugc__handle {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 12px;
    margin: 0 0 2px;
  }

  .hp51-ugc__tag {
    font-size: 11px;
    opacity: 0.85;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp51-ugc__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp51-ugc__wrap">
  <div class="hp51-ugc__header">
    <h2 class="hp51-ugc__heading">{{ section.settings.heading | default: 'Tea Ritual Moments #ZenMatchaCare' }}</h2>
  </div>

  <div class="hp51-ugc__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp51-ugc__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp51-ugc__img" alt="{{ block.settings.handle }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'hp51-ugc__img' }}
          {%- endif -%}
          <div class="hp51-ugc__overlay">
            <div>
              <p class="hp51-ugc__handle">{{ block.settings.handle | default: '@zen_rituals' }}</p>
              <p class="hp51-ugc__tag">{{ block.settings.tag | default: '#KyotoMatcha' }}</p>
            </div>
            <span>▶</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp51-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp51-ugc__img' }}
        <div class="hp51-ugc__overlay">
          <div><p class="hp51-ugc__handle">@sakura_tokyo</p><p class="hp51-ugc__tag">#UjiSerum</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp51-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp51-ugc__img' }}
        <div class="hp51-ugc__overlay">
          <div><p class="hp51-ugc__handle">@bamboo_glow</p><p class="hp51-ugc__tag">#BambooSap</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp51-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp51-ugc__img' }}
        <div class="hp51-ugc__overlay">
          <div><p class="hp51-ugc__handle">@kyoto_wellness</p><p class="hp51-ugc__tag">#ZenMoisture</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp51-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp51-ugc__img' }}
        <div class="hp51-ugc__overlay">
          <div><p class="hp51-ugc__handle">@botanical_calm</p><p class="hp51-ugc__tag">#MatchaMask</p></div>
          <span>▶</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP51 - Zen UGC",
  "class": "section-hp51-ugc",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F2EFE9" },
    { "type": "color", "id": "accent_matcha", "label": "Matcha Accent", "default": "#2D5A3D" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tea Ritual Moments #ZenMatchaCare" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "handle", "label": "Handle", "default": "@zen_rituals" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "#KyotoMatcha" }
      ]
    }
  ],
  "presets": [
    { "name": "HP51 - Zen UGC" }
  ]
}
{% endschema %}
