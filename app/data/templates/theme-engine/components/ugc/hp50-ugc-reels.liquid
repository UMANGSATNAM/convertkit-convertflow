{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp50-ugc-bg: {{ section.settings.bg_color | default: '#000000' }};
    
    background-color: var(--hp50-ugc-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp50-ugc__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp50-ugc__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp50-ugc__heading {
    font-family: 'Italiana', serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 400;
    color: #FFFFFF;
    margin: 0;
    letter-spacing: 1px;
  }

  .hp50-ugc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 18px;
  }

  .hp50-ugc__card {
    aspect-ratio: 9/16;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(226, 232, 240, 0.2);
    background: #111111;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
  }

  .hp50-ugc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(40%) contrast(1.1);
    transition: transform 0.4s ease;
  }

  .hp50-ugc__card:hover .hp50-ugc__img { transform: scale(1.05); filter: grayscale(0%); }

  .hp50-ugc__overlay {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 18px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9), transparent);
    color: #FFFFFF;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .hp50-ugc__handle {
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 0 0 2px;
    color: #FFFFFF;
  }

  .hp50-ugc__tag {
    font-size: 10px;
    color: #94A3B8;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp50-ugc__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp50-ugc__wrap">
  <div class="hp50-ugc__header">
    <h2 class="hp50-ugc__heading">{{ section.settings.heading | default: 'Backstage Moments & Runway Motion' }}</h2>
  </div>

  <div class="hp50-ugc__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp50-ugc__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp50-ugc__img" alt="{{ block.settings.handle }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'hp50-ugc__img' }}
          {%- endif -%}
          <div class="hp50-ugc__overlay">
            <div>
              <p class="hp50-ugc__handle">{{ block.settings.handle | default: '@runway_paris' }}</p>
              <p class="hp50-ugc__tag">{{ block.settings.tag | default: '#PlatinumContour' }}</p>
            </div>
            <span>▶</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp50-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp50-ugc__img' }}
        <div class="hp50-ugc__overlay">
          <div><p class="hp50-ugc__handle">@paris_couture</p><p class="hp50-ugc__tag">#PlatinumElixir</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp50-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp50-ugc__img' }}
        <div class="hp50-ugc__overlay">
          <div><p class="hp50-ugc__handle">@milan_backstage</p><p class="hp50-ugc__tag">#NoirCreme</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp50-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp50-ugc__img' }}
        <div class="hp50-ugc__overlay">
          <div><p class="hp50-ugc__handle">@nyc_editorial</p><p class="hp50-ugc__tag">#SilverMist</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp50-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp50-ugc__img' }}
        <div class="hp50-ugc__overlay">
          <div><p class="hp50-ugc__handle">@london_runway</p><p class="hp50-ugc__tag">#PeelMask</p></div>
          <span>▶</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP50 - Runway UGC",
  "class": "section-hp50-ugc",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Backstage Moments & Runway Motion" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "handle", "label": "Handle", "default": "@runway_paris" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "#PlatinumContour" }
      ]
    }
  ],
  "presets": [
    { "name": "HP50 - Runway UGC" }
  ]
}
{% endschema %}
