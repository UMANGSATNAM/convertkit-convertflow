{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Lora', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Organic grain texture overlay */
  {% if section.settings.show_grain %}
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0.04;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
  {% endif %}

  .hp22-ugc-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 768px) {
    .hp22-ugc-wrapper {
      padding: 0 20px;
    }
  }

  .hp22-ugc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: {{ section.settings.header_margin }}px;
    border-bottom: 1px solid rgba(0,0,0,0.05);
    padding-bottom: 24px;
  }

  @media screen and (max-width: 768px) {
    .hp22-ugc__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp22-ugc__title-wrapper {
    max-width: 600px;
  }

  .hp22-ugc__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--accent-color);
    text-transform: uppercase;
    margin: 0 0 12px;
  }

  .hp22-ugc__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0;
    line-height: 1.2;
  }
  
  .hp22-ugc__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp22-ugc__view-all {
    font-family: var(--font-body);
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--text-color);
    text-decoration: none;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: color 0.3s ease;
  }

  .hp22-ugc__view-all:hover {
    color: var(--accent-color);
  }

  .hp22-ugc__view-all svg {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .hp22-ugc__view-all:hover svg {
    transform: translateX(5px);
  }

  .hp22-ugc__slider-container {
    margin: 0 -20px;
    padding: 20px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .hp22-ugc__slider-container::-webkit-scrollbar {
    display: none;
  }

  .hp22-ugc__grid {
    display: flex;
    gap: {{ section.settings.gap }}px;
    min-width: min-content;
  }

  .hp22-ugc__item {
    width: {{ section.settings.card_width }}px;
    flex: 0 0 auto;
    position: relative;
    aspect-ratio: 9/16;
    background: #EAE3D9;
    border-radius: 200px; /* Fully rounded pill shape for UGC */
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 15px 30px rgba(0,0,0,0.05);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  @media screen and (max-width: 768px) {
    .hp22-ugc__item {
      width: {{ section.settings.card_width | times: 0.8 | round }}px;
    }
  }

  .hp22-ugc__item:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
  }

  .hp22-ugc__media {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 2s ease;
  }

  .hp22-ugc__item:hover .hp22-ugc__media {
    transform: scale(1.05);
  }

  .hp22-ugc__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.5) 100%);
    z-index: 1;
  }

  .hp22-ugc__play-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 50px;
    height: 50px;
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(4px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    z-index: 2;
    transition: all 0.3s ease;
  }

  .hp22-ugc__item:hover .hp22-ugc__play-icon {
    background: rgba(255,255,255,0.9);
    color: var(--accent-color);
    transform: translate(-50%, -50%) scale(1.1);
  }

  .hp22-ugc__play-icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
    margin-left: 2px;
  }

  .hp22-ugc__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30px 20px 40px; /* extra bottom padding because of pill shape */
    z-index: 2;
    text-align: center;
  }

  .hp22-ugc__handle {
    font-family: var(--font-body);
    font-size: 13px;
    color: #ffffff;
    font-weight: 500;
    letter-spacing: 1px;
    margin: 0 0 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .hp22-ugc__handle svg {
    width: 14px;
    height: 14px;
    fill: #E2B254; /* warm yellow */
  }

  .hp22-ugc__text {
    font-family: var(--font-heading);
    font-size: 16px;
    color: #ffffff;
    margin: 0;
    line-height: 1.3;
    opacity: 0.9;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp22-ugc-wrapper" id="HP22Ugc-{{ section.id }}">
  
  <div class="hp22-ugc__header">
    <div class="hp22-ugc__title-wrapper">
      {%- if section.settings.subtitle != blank -%}
        <p class="hp22-ugc__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="hp22-ugc__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
    
    {%- if section.settings.show_social_link -%}
      <a href="{{ section.settings.social_link | default: '#' }}" class="hp22-ugc__view-all" target="_blank">
        {{ section.settings.social_link_text | escape }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    {%- endif -%}
  </div>

  <div class="hp22-ugc__slider-container">
    <div class="hp22-ugc__grid">
      {%- for block in section.blocks -%}
        <div class="hp22-ugc__item" {{ block.shopify_attributes }}>
          {%- if block.settings.video_url != blank -%}
            <video class="hp22-ugc__media" loop muted playsinline>
              <source src="{{ block.settings.video_url }}" type="video/mp4">
            </video>
          {%- elsif block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="UGC content" class="hp22-ugc__media" loading="lazy">
          {%- else -%}
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#eae3d9;color:#8A9A86;">VIDEO</div>
          {%- endif -%}
          
          <div class="hp22-ugc__overlay"></div>
          
          <div class="hp22-ugc__play-icon">
            <svg viewBox="0 0 24 24"><path d="M8,5.14V19.14L19,12.14L8,5.14Z"/></svg>
          </div>
          
          <div class="hp22-ugc__content">
            {%- if block.settings.handle != blank -%}
              <div class="hp22-ugc__handle">
                {%- if block.settings.verified -%}
                  <svg viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12S6.5 22 12 22 22 17.5 22 12 17.5 2 12 2M10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z"/></svg>
                {%- endif -%}
                {{ block.settings.handle | escape }}
              </div>
            {%- endif -%}
            
            {%- if block.settings.text != blank -%}
              <p class="hp22-ugc__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
      
      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..5) -%}
          <div class="hp22-ugc__item">
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#eae3d9;color:#8A9A86;">VIDEO</div>
            <div class="hp22-ugc__overlay"></div>
            <div class="hp22-ugc__play-icon">
              <svg viewBox="0 0 24 24"><path d="M8,5.14V19.14L19,12.14L8,5.14Z"/></svg>
            </div>
            <div class="hp22-ugc__content">
              <div class="hp22-ugc__handle">@organiclover{{ i }}</div>
              <p class="hp22-ugc__text">"Obsessed with this texture!"</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const ugcItems = document.querySelectorAll('#HP22Ugc-{{ section.id }} .hp22-ugc__item');
    
    ugcItems.forEach(item => {
      const video = item.querySelector('video');
      
      if(video) {
        // Play on hover
        item.addEventListener('mouseenter', () => {
          video.play().catch(e => console.log(e));
        });
        
        item.addEventListener('mouseleave', () => {
          video.pause();
        });
      }
    });
  });
</script>

{% schema %}
{
  "name": "HP22 - Organic Reels",
  "class": "section-hp22-ugc-reels",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "REAL RESULTS"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>Seen in the <em>Wild</em></p>"
    },
    {
      "type": "checkbox",
      "id": "show_social_link",
      "label": "Show social link",
      "default": true
    },
    {
      "type": "text",
      "id": "social_link_text",
      "label": "Link Text",
      "default": "Follow Us on TikTok"
    },
    {
      "type": "url",
      "id": "social_link",
      "label": "Link URL"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 50
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 250,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Video Card Width",
      "default": 320
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Gap between videos",
      "default": 20
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Section Heading Size",
      "default": 42
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Section Subtitle Size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3A3A3A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8A9A86"
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Show subtle paper grain texture",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "UGC Video",
      "settings": [
        {
          "type": "text",
          "id": "video_url",
          "label": "MP4 Video URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fallback Image",
          "info": "Displays if video fails or is empty"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Social Handle",
          "default": "@username"
