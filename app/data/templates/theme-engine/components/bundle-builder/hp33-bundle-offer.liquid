{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --gold-color: {{ section.settings.gold_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Montserrat', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .hp33-bundle-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
  }

  @media screen and (max-width: 992px) {
    .hp33-bundle-wrapper {
      flex-direction: column;
      gap: 40px;
      padding: 0 20px;
    }
  }

  .hp33-bundle__image-col {
    flex: 1;
    position: relative;
  }

  @media screen and (max-width: 992px) {
    .hp33-bundle__image-col {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
    }
  }

  .hp33-bundle__image-wrap {
    position: relative;
    padding: 20px;
  }

  /* Ornate frame */
  .hp33-bundle__image-wrap::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border: 1px solid var(--gold-color);
    z-index: 1;
  }

  .hp33-bundle__image-wrap::after {
    content: '';
    position: absolute;
    top: 6px; left: 6px; right: 6px; bottom: 6px;
    border: 1px solid rgba(212, 175, 55, 0.3);
    z-index: 1;
  }

  .hp33-bundle__image {
    width: 100%;
    height: auto;
    aspect-ratio: 4/5;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 2;
  }

  .hp33-bundle__content-col {
    flex: 1.2;
  }

  @media screen and (max-width: 992px) {
    .hp33-bundle__content-col {
      text-align: center;
    }
  }

  .hp33-bundle__subtitle {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--gold-color);
    text-transform: uppercase;
    letter-spacing: 4px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  @media screen and (max-width: 992px) {
    .hp33-bundle__subtitle {
      justify-content: center;
    }
  }

  .hp33-bundle__subtitle::before,
  .hp33-bundle__subtitle::after {
    content: '';
    height: 1px;
    width: 30px;
    background: var(--gold-color);
  }

  .hp33-bundle__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 15px;
    font-weight: 400;
  }

  .hp33-bundle__price-wrap {
    font-family: var(--font-heading);
    font-size: 28px;
    color: var(--gold-color);
    margin-bottom: 30px;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  @media screen and (max-width: 992px) {
    .hp33-bundle__price-wrap {
      justify-content: center;
    }
  }

  .hp33-bundle__price-old {
    text-decoration: line-through;
    opacity: 0.5;
    font-size: 20px;
    color: var(--text-color);
  }

  .hp33-bundle__text {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-color);
    margin: 0 0 40px;
    font-weight: 300;
    max-width: 500px;
  }

  @media screen and (max-width: 992px) {
    .hp33-bundle__text {
      margin-left: auto;
      margin-right: auto;
    }
  }

  .hp33-bundle__list {
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
    border-top: 1px solid rgba(212, 175, 55, 0.3);
  }

  .hp33-bundle__list li {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-color);
    padding: 20px 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.3);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 300;
  }

  .hp33-bundle__list li::before {
    content: '◈';
    color: var(--gold-color);
    margin-right: 15px;
    font-size: 12px;
  }

  .hp33-bundle__btn {
    display: inline-table;
    background: transparent;
    color: var(--text-color);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 2px;
    padding: 18px 50px;
    border: 1px solid var(--gold-color);
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
  }

  .hp33-bundle__btn::before {
    content: '';
    position: absolute;
    top: 4px; left: 4px; right: 4px; bottom: 4px;
    border: 1px solid rgba(212, 175, 55, 0.3);
    transition: all 0.4s ease;
  }

  .hp33-bundle__btn:hover {
    background: var(--gold-color);
    color: #000;
  }

  .hp33-bundle__btn:hover::before {
    border-color: #000;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp33-bundle-wrapper" id="HP33Bundle-{{ section.id }}">
  <div class="hp33-bundle__image-col">
    <div class="hp33-bundle__image-wrap">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp33-bundle__image" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp33-bundle__image' }}
      {%- endif -%}
    </div>
  </div>

  <div class="hp33-bundle__content-col">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp33-bundle__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    
    <h2 class="hp33-bundle__title">{{ section.settings.title }}</h2>
    
    <div class="hp33-bundle__price-wrap">
      <span>{{ section.settings.price }}</span>
      {%- if section.settings.compare_price != blank -%}
        <span class="hp33-bundle__price-old">{{ section.settings.compare_price }}</span>
      {%- endif -%}
    </div>
    
    <p class="hp33-bundle__text">{{ section.settings.text }}</p>
    
    <ul class="hp33-bundle__list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {{ block.settings.item_name }}
          <span style="opacity: 0.6; font-style: italic;">{{ block.settings.item_detail }}</span>
        </li>
      {%- endfor -%}
    </ul>
    
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp33-bundle__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP33 - Deco Bundle",
  "class": "section-hp33-bundle-offer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bundle Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE CURATED SET"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "The Gentleman's Collection"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$2,500"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare Price",
      "default": "$3,200"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Acquire our most distinguished pieces as a single, harmonious collection."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "ACQUIRE THE SET"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Deco Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Deep Emerald)",
      "default": "#0e1a14"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold Accent",
      "default": "#d4af37"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bundle Item",
      "settings": [
        {
          "type": "text",
          "id": "item_name",
          "label": "Item Name",
          "default": "The Heritage Watch"
        },
        {
          "type": "text",
          "id": "item_detail",
          "label": "Detail",
          "default": "Gold Plated"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP33 - Deco Bundle",
      "blocks": [
        { "type": "item", "settings": { "item_name": "The Heritage Watch", "item_detail": "Gold Plated" } },
        { "type": "item", "settings": { "item_name": "Cufflinks Set", "item_detail": "Onyx Inlay" } },
        { "type": "item", "settings": { "item_name": "Leather Briefcase", "item_detail": "Full Grain" } }
      ]
    }
  ]
}
{% endschema %}
