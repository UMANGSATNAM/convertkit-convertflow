{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Syncopate:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Syncopate', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp27-bundle-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp27-bundle-wrapper {
      padding: 0 20px;
    }
  }

  .hp27-bundle__container {
    display: flex;
    align-items: center;
    gap: 60px;
    background: #111;
    border: 1px solid rgba(226, 226, 226, 0.1);
    padding: 60px;
    position: relative;
    overflow: hidden;
  }

  /* Blueprint background */
  .hp27-bundle__container::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: 
      linear-gradient(rgba(226, 226, 226, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(226, 226, 226, 0.03) 1px, transparent 1px);
    background-size: 30px 30px;
    pointer-events: none;
    z-index: 0;
  }

  @media screen and (max-width: 992px) {
    .hp27-bundle__container {
      flex-direction: column;
      padding: 40px 20px;
      gap: 40px;
    }
  }

  .hp27-bundle__images {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .hp27-bundle__image-card {
    width: 45%;
    aspect-ratio: 1/1;
    background: var(--bg-color);
    border: 1px solid rgba(226, 226, 226, 0.2);
    position: relative;
    padding: 2px;
  }

  .hp27-bundle__image-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.1);
    transition: filter 0.4s ease;
  }

  .hp27-bundle__image-card:hover img {
    filter: grayscale(0%) contrast(1);
  }

  .hp27-bundle__plus {
    width: 40px;
    height: 40px;
    background: var(--bg-color);
    border: 1px solid var(--accent-color);
    color: var(--accent-color);
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .hp27-bundle__plus svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .hp27-bundle__content {
    flex: 1;
    max-width: 500px;
    position: relative;
    z-index: 1;
  }

  .hp27-bundle__label {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bg-color);
    background: var(--text-color);
    padding: 4px 8px;
    margin-bottom: 20px;
  }

  .hp27-bundle__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 20px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp27-bundle__text {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.5vw, 16px);
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0 0 30px;
  }

  .hp27-bundle__items {
    list-style: none;
    padding: 0;
    margin: 0 0 30px;
    border-top: 1px solid rgba(226, 226, 226, 0.1);
  }

  .hp27-bundle__item {
    display: flex;
    justify-content: space-between;
    padding: 15px 0;
    border-bottom: 1px solid rgba(226, 226, 226, 0.1);
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-color);
  }

  .hp27-bundle__item-title {
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hp27-bundle__item-price {
    font-weight: 600;
    color: var(--accent-color);
  }

  .hp27-bundle__pricing {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 30px;
  }

  .hp27-bundle__price {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 700;
    color: var(--text-color);
  }

  .hp27-bundle__price-compare {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-color);
    opacity: 0.5;
    text-decoration: line-through;
  }

  .hp27-bundle__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 16px 32px;
    background: var(--text-color);
    color: var(--bg-color);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .hp27-bundle__btn::before {
    content: '';
    position: absolute;
    top: 0; left: -100%; width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,42,42,0.8), transparent);
    transition: left 0.5s ease;
    z-index: 0;
  }

  .hp27-bundle__btn span {
    position: relative;
    z-index: 1;
  }

  .hp27-bundle__btn:hover {
    background: var(--bg-color);
    color: #fff;
    box-shadow: 0 0 15px rgba(255, 42, 42, 0.4);
    border: 1px solid var(--accent-color);
  }

  .hp27-bundle__btn:hover::before {
    left: 100%;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp27-bundle-wrapper" id="HP27Bundle-{{ section.id }}">
  <div class="hp27-bundle__container">
    
    <div class="hp27-bundle__images">
      <div class="hp27-bundle__image-card" style="transform: translateY(-20px);">
        {%- if section.settings.image_1 != blank -%}
          <img src="{{ section.settings.image_1 | image_url: width: 600 }}" alt="Bundle Item 1" loading="lazy">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      
      <div class="hp27-bundle__plus">
        <svg viewBox="0 0 24 24"><path d="M12 4v16m-8-8h16"/></svg>
      </div>

      <div class="hp27-bundle__image-card" style="transform: translateY(20px);">
        {%- if section.settings.image_2 != blank -%}
          <img src="{{ section.settings.image_2 | image_url: width: 600 }}" alt="Bundle Item 2" loading="lazy">
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
    </div>

    <div class="hp27-bundle__content">
      {%- if section.settings.label != blank -%}
        <div class="hp27-bundle__label">{{ section.settings.label }}</div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="hp27-bundle__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="hp27-bundle__text">{{ section.settings.text }}</p>
      {%- endif -%}

      <ul class="hp27-bundle__items">
        <li class="hp27-bundle__item">
          <span class="hp27-bundle__item-title">{{ section.settings.item_1_name }}</span>
          <span class="hp27-bundle__item-price">{{ section.settings.item_1_val }}</span>
        </li>
        <li class="hp27-bundle__item">
          <span class="hp27-bundle__item-title">{{ section.settings.item_2_name }}</span>
          <span class="hp27-bundle__item-price">{{ section.settings.item_2_val }}</span>
        </li>
      </ul>

      <div class="hp27-bundle__pricing">
        <span class="hp27-bundle__price">{{ section.settings.bundle_price }}</span>
        <span class="hp27-bundle__price-compare">{{ section.settings.compare_price }}</span>
      </div>

      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp27-bundle__btn">
        <span>{{ section.settings.btn_text }}</span>
      </a>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP27 - Eng Bundle",
  "class": "section-hp27-bundle-offer",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Badge Label",
      "default": "SYSTEM_KIT"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE ESSENTIALS KIT"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Combine core modules for maximum efficiency. Designed to work in perfect synchronization."
    },
    {
      "type": "text",
      "id": "item_1_name",
      "label": "Item 1 Name",
      "default": "UNIT_01 CORE"
    },
    {
      "type": "text",
      "id": "item_1_val",
      "label": "Item 1 Value",
      "default": "VALUE $120"
    },
    {
      "type": "text",
      "id": "item_2_name",
      "label": "Item 2 Name",
      "default": "UNIT_02 MODULE"
    },
    {
      "type": "text",
      "id": "item_2_val",
      "label": "Item 2 Value",
      "default": "VALUE $80"
    },
    {
      "type": "text",
      "id": "bundle_price",
      "label": "Bundle Price",
      "default": "$160"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare at Price",
      "default": "$200"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "INITIALIZE BUNDLE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Dark Engineered Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#E2E2E2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF2A2A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP27 - Eng Bundle"
    }
  ]
}
{% endschema %}
