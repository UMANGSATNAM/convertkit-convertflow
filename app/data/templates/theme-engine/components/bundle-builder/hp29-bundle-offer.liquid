{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --card-bg: {{ section.settings.card_bg }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp29-bundle-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp29-bundle-wrapper {
      padding: 0 20px;
    }
  }

  .hp29-bundle__container {
    display: flex;
    background-color: var(--card-bg);
    border-radius: 40px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,0.05);
  }

  @media screen and (max-width: 992px) {
    .hp29-bundle__container {
      flex-direction: column;
    }
  }

  .hp29-bundle__image-col {
    flex: 1;
    position: relative;
    min-height: 400px;
  }

  .hp29-bundle__image {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }

  .hp29-bundle__content-col {
    flex: 1;
    padding: 80px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (max-width: 992px) {
    .hp29-bundle__content-col {
      padding: 50px 30px;
    }
  }

  .hp29-bundle__badge {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-color);
    margin-bottom: 20px;
  }

  .hp29-bundle__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    line-height: 1.2;
    color: var(--text-color);
    margin: 0 0 15px;
  }
  
  .hp29-bundle__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp29-bundle__text {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0 0 30px;
  }

  .hp29-bundle__items {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
  }

  .hp29-bundle__item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .hp29-bundle__item-img {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    object-fit: cover;
    background: #f0f0f0;
  }

  .hp29-bundle__item-info {
    flex: 1;
  }

  .hp29-bundle__item-title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 400;
    color: var(--text-color);
    margin: 0 0 5px;
  }

  .hp29-bundle__item-price {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-color);
    opacity: 0.7;
  }

  .hp29-bundle__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .hp29-bundle__total {
    font-family: var(--font-heading);
    font-size: 24px;
    color: var(--text-color);
  }
  
  .hp29-bundle__total span {
    font-family: var(--font-body);
    font-size: 14px;
    opacity: 0.6;
    text-decoration: line-through;
    margin-right: 10px;
  }

  .hp29-bundle__btn {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    padding: 16px 40px;
    border-radius: 30px;
    background: var(--text-color);
    color: var(--card-bg);
    transition: all 0.3s ease;
    border: 1px solid transparent;
  }

  .hp29-bundle__btn:hover {
    background: transparent;
    color: var(--text-color);
    border-color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp29-bundle-wrapper" id="HP29Bundle-{{ section.id }}">
  <div class="hp29-bundle__container">
    
    <div class="hp29-bundle__image-col">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title | escape }}" class="hp29-bundle__image" loading="lazy">
      {%- else -%}
        {{ 'collection-2' | placeholder_svg_tag: 'hp29-bundle__image' }}
      {%- endif -%}
    </div>

    <div class="hp29-bundle__content-col">
      {%- if section.settings.badge != blank -%}
        <div class="hp29-bundle__badge">{{ section.settings.badge }}</div>
      {%- endif -%}
      
      {%- if section.settings.title != blank -%}
        <h2 class="hp29-bundle__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      
      {%- if section.settings.text != blank -%}
        <div class="hp29-bundle__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="hp29-bundle__items">
        {%- for block in section.blocks -%}
          <div class="hp29-bundle__item" {{ block.shopify_attributes }}>
            {%- if block.settings.product != blank -%}
              <img src="{{ block.settings.product.featured_image | image_url: width: 160 }}" alt="{{ block.settings.product.title | escape }}" class="hp29-bundle__item-img" loading="lazy">
              <div class="hp29-bundle__item-info">
                <h4 class="hp29-bundle__item-title">{{ block.settings.product.title }}</h4>
                <div class="hp29-bundle__item-price">{{ block.settings.product.price | money }}</div>
              </div>
            {%- else -%}
              {%- assign placeholder = 'product-' | append: forloop.index -%}
              {%- if forloop.index > 6 -%}{%- assign placeholder = 'product-1' -%}{%- endif -%}
              {{ placeholder | placeholder_svg_tag: 'hp29-bundle__item-img' }}
              <div class="hp29-bundle__item-info">
                <h4 class="hp29-bundle__item-title">Organic Essential {{ forloop.index }}</h4>
                <div class="hp29-bundle__item-price">$35.00</div>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="hp29-bundle__footer">
        <div class="hp29-bundle__total">
          {%- if section.settings.compare_price != blank -%}
            <span>{{ section.settings.compare_price }}</span>
          {%- endif -%}
          {{ section.settings.price }}
        </div>
        {%- if section.settings.btn_text != blank -%}
          <a href="{{ section.settings.btn_link | default: '#' }}" class="hp29-bundle__btn">
            {{ section.settings.btn_text }}
          </a>
        {%- endif -%}
      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP29 - Boho Bundle",
  "class": "section-hp29-bundle-offer",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bundle Image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "THE CURATED KIT"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "The Morning <em>Ritual</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Start your day with intention. We've bundled our three most loved essentials to help you craft the perfect morning routine.</p>"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare Price",
      "default": "$105.00"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Bundle Price",
      "default": "$85.00"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Add Bundle to Cart"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Earthy Boho Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Page Background",
      "default": "#F4F1DE"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#3D405B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (Terracotta)",
      "default": "#E07A5F"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Bundle Product",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP29 - Boho Bundle",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
