{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --cyan: {{ section.settings.cyan_color }};
    --magenta: {{ section.settings.magenta_color }};
    --green: {{ section.settings.green_color }};
    
    --font-heading: 'Press Start 2P', cursive;
    --font-body: 'Chakra Petch', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 2px dashed var(--cyan);
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  /* Grid dots bg */
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: radial-gradient(var(--cyan) 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.1;
    pointer-events: none;
    z-index: 0;
  }

  .hp28-bundle-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
    position: relative;
    z-index: 1;
  }

  {% if section.settings.image_position == 'right' %}
    .hp28-bundle-wrapper {
      flex-direction: row-reverse;
    }
  {% endif %}

  @media screen and (max-width: 992px) {
    .hp28-bundle-wrapper {
      flex-direction: column;
      gap: 50px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp28-bundle-wrapper {
      padding: 0 20px;
    }
  }

  .hp28-bundle__image-col {
    flex: 1;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Stacked retro image effect */
  .hp28-bundle__image-stack {
    position: relative;
    width: 100%;
    max-width: 500px;
    aspect-ratio: 1/1;
  }

  .hp28-bundle__image-layer {
    position: absolute;
    border: 3px solid var(--magenta);
    background: #000;
    box-shadow: 8px 8px 0 rgba(0,255,255,0.5);
    transition: transform 0.3s ease;
  }

  .hp28-bundle__image-layer--1 {
    top: 0; left: 0; width: 80%; height: 80%;
    z-index: 1;
    border-color: var(--cyan);
    box-shadow: 8px 8px 0 rgba(255,0,255,0.5);
  }

  .hp28-bundle__image-layer--2 {
    bottom: 0; right: 0; width: 75%; height: 75%;
    z-index: 2;
  }

  .hp28-bundle__image-stack:hover .hp28-bundle__image-layer--1 {
    transform: translate(-10px, -10px);
  }
  .hp28-bundle__image-stack:hover .hp28-bundle__image-layer--2 {
    transform: translate(10px, 10px);
  }

  .hp28-bundle__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(200%) contrast(1.2);
  }

  .hp28-bundle__text-col {
    flex: 1;
    background: #000;
    border: 4px solid var(--cyan);
    padding: 50px;
    box-shadow: -15px 15px 0 var(--magenta);
    position: relative;
  }

  @media screen and (max-width: 768px) {
    .hp28-bundle__text-col {
      padding: 30px 20px;
      box-shadow: -8px 8px 0 var(--magenta);
    }
  }

  .hp28-bundle__badge {
    position: absolute;
    top: -15px; right: 30px;
    background: var(--green);
    color: #000;
    font-family: var(--font-heading);
    font-size: 12px;
    padding: 8px 16px;
    text-transform: uppercase;
    box-shadow: 4px 4px 0 #000;
  }

  .hp28-bundle__title {
    font-family: var(--font-heading);
    font-size: clamp(20px, 3vw, {{ section.settings.title_size }}px);
    color: var(--text-color);
    margin: 0 0 20px;
    line-height: 1.3;
    text-transform: uppercase;
    text-shadow: 2px 2px 0 var(--magenta);
  }

  .hp28-bundle__text {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.5vw, 16px);
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-color);
    margin: 0 0 30px;
  }

  .hp28-bundle__price-area {
    display: flex;
    align-items: baseline;
    gap: 15px;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px dashed var(--text-color);
  }

  .hp28-bundle__price {
    font-family: var(--font-heading);
    font-size: 28px;
    color: var(--green);
    text-shadow: 2px 2px 0 #000;
  }

  .hp28-bundle__compare {
    font-family: var(--font-heading);
    font-size: 16px;
    color: var(--magenta);
    text-decoration: line-through;
    opacity: 0.7;
  }

  .hp28-bundle__list {
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
  }

  .hp28-bundle__list li {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 10px;
    text-transform: uppercase;
  }

  .hp28-bundle__list li::before {
    content: '>';
    color: var(--cyan);
    font-family: var(--font-heading);
    font-size: 12px;
  }

  .hp28-bundle__btn {
    display: block;
    width: 100%;
    background: var(--cyan);
    color: #000;
    font-family: var(--font-heading);
    font-size: 14px;
    text-decoration: none;
    text-align: center;
    padding: 20px;
    border: 2px solid #fff;
    box-shadow: 5px 5px 0 var(--magenta);
    transition: all 0.2s ease;
    text-transform: uppercase;
  }

  .hp28-bundle__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 var(--magenta);
    background: var(--magenta);
    color: #fff;
  }

  .hp28-bundle__btn:active {
    transform: translate(5px, 5px);
    box-shadow: 0 0 0 var(--magenta);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-bundle-wrapper" id="HP28Bundle-{{ section.id }}">
  <div class="hp28-bundle__image-col">
    <div class="hp28-bundle__image-stack">
      <div class="hp28-bundle__image-layer hp28-bundle__image-layer--1">
        {%- if section.settings.image_1 != blank -%}
          <img height="{{ section.settings.image_1.height }}" width="{{ section.settings.image_1.width }}" src="{{ section.settings.image_1 | image_url: width: 600 }}" alt="Bundle Image 1" class="hp28-bundle__image" loading="lazy">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'hp28-bundle__image' }}
        {%- endif -%}
      </div>
      <div class="hp28-bundle__image-layer hp28-bundle__image-layer--2">
        {%- if section.settings.image_2 != blank -%}
          <img height="{{ section.settings.image_2.height }}" width="{{ section.settings.image_2.width }}" src="{{ section.settings.image_2 | image_url: width: 600 }}" alt="Bundle Image 2" class="hp28-bundle__image" loading="lazy">
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag: 'hp28-bundle__image' }}
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="hp28-bundle__text-col">
    {%- if section.settings.badge != blank -%}
      <div class="hp28-bundle__badge">{{ section.settings.badge }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="hp28-bundle__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hp28-bundle__text">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="hp28-bundle__price-area">
      <div class="hp28-bundle__price">{{ section.settings.price }}</div>
      {%- if section.settings.compare_price != blank -%}
        <div class="hp28-bundle__compare">{{ section.settings.compare_price }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="hp28-bundle__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hp28-bundle__btn">
        {{ section.settings.button_text }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP28 - Y2K Bundle Offer",
  "class": "section-hp28-bundle-offer",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Foreground Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "VALUE PKG"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ULTIMATE STARTER KIT"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Install the complete hardware suite and save credits. Limited availability in this sector.</p>"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$149"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare at Price",
      "default": "$199"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "INITIATE_PURCHASE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Y2K Cyber Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Deep Purple)",
      "default": "#1C0B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cyan_color",
      "label": "Cyan Accent",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "magenta_color",
      "label": "Magenta Accent",
      "default": "#FF00FF"
    },
    {
      "type": "color",
      "id": "green_color",
      "label": "Acid Green Accent",
      "default": "#39FF14"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "List Item",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Includes Core Module"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP28 - Y2K Bundle Offer",
      "blocks": [
        { "type": "item", "settings": { "text": "MAIN UNIT EXECUTABLE" } },
        { "type": "item", "settings": { "text": "EXPANSION PACK VOL. 1" } },
        { "type": "item", "settings": { "text": "LIFETIME OVER THE AIR UPDATES" } }
      ]
    }
  ]
}
{% endschema %}
