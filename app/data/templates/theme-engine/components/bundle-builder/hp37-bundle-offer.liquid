{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Shrikhand&family=DM+Sans:wght@400;500;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --card-bg: {{ section.settings.card_bg }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Shrikhand', cursive;
    --font-body: 'DM Sans', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp37-bundle-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    gap: 40px;
    background: var(--card-bg);
    border: 4px solid var(--text-color);
    border-radius: 40px;
    box-shadow: 12px 12px 0px var(--accent-color);
    overflow: hidden;
  }

  @media screen and (max-width: 992px) {
    .hp37-bundle-wrapper {
      flex-direction: column;
      border-radius: 20px;
      box-shadow: 8px 8px 0px var(--accent-color);
    }
  }

  @media screen and (max-width: 768px) {
    .hp37-bundle-wrapper {
      padding: 0;
    }
  }

  .hp37-bundle__image-col {
    flex: 1;
    position: relative;
    border-right: 4px solid var(--text-color);
  }

  @media screen and (max-width: 992px) {
    .hp37-bundle__image-col {
      border-right: none;
      border-bottom: 4px solid var(--text-color);
    }
  }

  .hp37-bundle__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  .hp37-bundle__badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background: var(--accent-color);
    color: var(--bg-color);
    font-family: var(--font-heading);
    font-size: 18px;
    padding: 10px 20px;
    border-radius: 50px;
    border: 2px solid var(--text-color);
    transform: rotate(-5deg);
    box-shadow: 4px 4px 0px var(--text-color);
  }

  .hp37-bundle__content-col {
    flex: 1;
    padding: 60px 40px;
    display: flex;
    flex-direction: column;
  }

  @media screen and (max-width: 768px) {
    .hp37-bundle__content-col {
      padding: 40px 20px;
    }
  }

  .hp37-bundle__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 10px;
    text-shadow: 2px 2px 0px var(--accent-color);
  }

  .hp37-bundle__subtitle {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 30px;
  }

  .hp37-bundle__list {
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
    border-top: 2px dashed var(--text-color);
  }

  .hp37-bundle__list li {
    padding: 20px 0;
    border-bottom: 2px dashed var(--text-color);
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    color: var(--text-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp37-bundle__list li span {
    font-weight: 400;
    color: var(--accent-color);
    font-size: 16px;
  }

  .hp37-bundle__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  @media screen and (max-width: 500px) {
    .hp37-bundle__footer {
      flex-direction: column;
      gap: 20px;
      align-items: flex-start;
    }
  }

  .hp37-bundle__price {
    font-family: var(--font-heading);
    font-size: 32px;
    color: var(--text-color);
  }

  .hp37-bundle__btn {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    padding: 16px 35px;
    background-color: var(--text-color);
    color: var(--bg-color);
    border-radius: 50px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 4px 4px 0px var(--accent-color);
  }

  .hp37-bundle__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--accent-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp37-bundle-wrapper" id="HP37Bundle-{{ section.id }}">
  <div class="hp37-bundle__image-col">
    {%- if section.settings.badge_text != blank -%}
      <div class="hp37-bundle__badge">{{ section.settings.badge_text }}</div>
    {%- endif -%}
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp37-bundle__image" loading="lazy">
    {%- else -%}
      {{ 'collection-2' | placeholder_svg_tag: 'hp37-bundle__image' }}
    {%- endif -%}
  </div>

  <div class="hp37-bundle__content-col">
    <h2 class="hp37-bundle__title">{{ section.settings.title }}</h2>
    {%- if section.settings.subtitle != blank -%}
      <div class="hp37-bundle__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    
    <ul class="hp37-bundle__list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {{ block.settings.item_name }}
          <span>{{ block.settings.item_desc }}</span>
        </li>
      {%- endfor -%}
    </ul>
    
    <div class="hp37-bundle__footer">
      <div class="hp37-bundle__price">{{ section.settings.price }}</div>
      {%- if section.settings.btn_label != blank -%}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="hp37-bundle__btn">
          {{ section.settings.btn_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP37 - Retro Bundle",
  "class": "section-hp37-bundle-offer",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bundle Image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "THE KIT"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Weekend Set"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "EVERYTHING YOU NEED."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$120"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Grab It"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Retro Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4E3C5"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#F9F3EA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A3219"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#798A58"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bundle Item",
      "settings": [
        {
          "type": "text",
          "id": "item_name",
          "label": "Item Name",
          "default": "Terry Polo"
        },
        {
          "type": "text",
          "id": "item_desc",
          "label": "Item Detail",
          "default": "Color: Mustard"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP37 - Retro Bundle",
      "blocks": [
        { "type": "item", "settings": { "item_name": "Terry Polo", "item_desc": "Mustard" } },
        { "type": "item", "settings": { "item_name": "Boardshorts", "item_desc": "Checkerboard" } },
        { "type": "item", "settings": { "item_name": "Tote Bag", "item_desc": "Canvas" } }
      ]
    }
  ]
}
{% endschema %}
