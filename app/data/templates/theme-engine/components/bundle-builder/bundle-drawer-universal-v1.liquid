{% schema %}
{
  "name": "Bundle Drawer",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Bundle"
    },
    {
      "type": "collection",
      "id": "bundle_collection",
      "label": "Bundle Products Collection"
    },
    {
      "type": "range",
      "id": "discount_percentage",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "%",
      "label": "Bundle Discount",
      "default": 15
    },
    {
      "type": "number",
      "id": "required_items",
      "label": "Items required for discount",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Bundle Drawer (Universal)",
      "category": "Bundle"
    }
  ]
}
{% endschema %}

<div class="bundle-drawer bundle-drawer--universal" id="BundleDrawer" style="position: fixed; top: 0; right: -400px; width: 400px; max-width: 100vw; height: 100vh; background: var(--color-bg); z-index: 999; box-shadow: -5px 0 15px rgba(0,0,0,0.1); transition: right 0.3s ease; display: flex; flex-direction: column;">
  <div class="bundle-drawer__header" style="padding: 1.5rem; border-bottom: 1px solid rgba(var(--color-text-rgb), 0.1); display: flex; justify-content: space-between; align-items: center;">
    <h2 style="font-family: var(--font-heading-family); color: var(--color-text); margin: 0;">{{ section.settings.heading }}</h2>
    <button class="bundle-drawer__close" aria-label="Close" style="background: none; border: none; cursor: pointer; font-size: 1.5rem; color: var(--color-text);">&times;</button>
  </div>
  
  <div class="bundle-drawer__progress" style="padding: 1rem 1.5rem; background: rgba(var(--color-primary-rgb), 0.05); border-bottom: 1px solid rgba(var(--color-primary-rgb), 0.1);">
    <p style="font-family: var(--font-body-family); font-weight: bold; font-size: 0.9rem; text-align: center; color: var(--color-primary); margin-bottom: 0.5rem;">
      Add <span id="BundleItemsNeeded">{{ section.settings.required_items }}</span> more items to unlock {{ section.settings.discount_percentage }}% OFF
    </p>
    <div class="bundle-drawer__progress-bar" style="width: 100%; height: 8px; background: rgba(var(--color-primary-rgb), 0.2); border-radius: 4px; overflow: hidden;">
      <div class="bundle-drawer__progress-fill" style="width: 0%; height: 100%; background: var(--color-primary); transition: width 0.3s ease;"></div>
    </div>
  </div>

  <div class="bundle-drawer__products" style="flex: 1; overflow-y: auto; padding: 1.5rem;">
    {% if section.settings.bundle_collection != blank %}
      {% for product in section.settings.bundle_collection.products limit: 10 %}
        <div class="bundle-product" style="display: flex; gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(var(--color-text-rgb), 0.05);">
          <div class="bundle-product__image" style="width: 80px; height: 80px; flex-shrink: 0;">
            <img src="{{ product.featured_image | img_url: '160x' }}" alt="{{ product.title | escape }}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px;">
          </div>
          <div class="bundle-product__info" style="flex: 1;">
            <h3 style="font-family: var(--font-heading-family); font-size: 1rem; margin: 0 0 0.5rem 0; color: var(--color-text);">{{ product.title }}</h3>
            <p style="font-family: var(--font-body-family); font-weight: bold; color: var(--color-text); margin: 0 0 0.5rem 0;">{{ product.price | money }}</p>
            <button class="btn btn--secondary btn--small bundle-add" data-id="{{ product.first_available_variant.id }}" style="width: 100%; padding: 0.5rem; background: transparent; border: 1px solid var(--color-text); color: var(--color-text); cursor: pointer;">Add to Bundle</button>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <p style="text-align: center; color: var(--color-text); opacity: 0.5;">Please select a collection in theme settings.</p>
    {% endif %}
  </div>
  
  <div class="bundle-drawer__footer" style="padding: 1.5rem; border-top: 1px solid rgba(var(--color-text-rgb), 0.1); background: var(--color-bg);">
    <button class="btn btn--primary bundle-checkout" disabled style="width: 100%; padding: 1rem; background: var(--color-primary); color: var(--color-bg); border: none; font-weight: bold; font-family: var(--font-heading-family); cursor: not-allowed; opacity: 0.5;">
      Checkout Bundle
    </button>
  </div>
</div>

<div class="bundle-drawer-overlay" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 998; display: none; opacity: 0; transition: opacity 0.3s ease;"></div>
