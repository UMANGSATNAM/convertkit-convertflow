{%- comment -%}
  Component: collection-natural-home-v1
  Family: Home | Style: natural
  Archetypes: cozy, artisanal
  v2.0 — StoreForge Component Library
{%- endcomment -%}
<section class="main-collection main-collection--home-decor container" style="padding: var(--space-64) 0; background-color: var(--color-background);" data-section="{{ section.id }}">
  
  <header class="collection-header text-center" style="margin-bottom: var(--space-64);">
    <h1 class="collection-title" style="font-family: var(--font-heading-family); font-size: 2.8rem; font-weight: 500; margin-bottom: var(--space-16); color: var(--color-text);">
      {{ collection.title }}
    </h1>
    {%- if collection.description != blank -%}
      <div class="collection-description rte" style="max-width: 650px; margin: 0 auto; font-family: var(--font-body-family); font-size: 0.95rem; line-height: 1.7; color: var(--color-text); opacity: 0.85;">
        {{ collection.description }}
      </div>
    {%- endif -%}
  </header>

  {%- paginate collection.products by section.settings.products_per_page -%}
    
    <!-- Filter and Sort bar -->
    <div class="collection-toolbar" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-20); margin-bottom: var(--space-40);">
      
      <!-- Filter trigger -->
      {%- if section.settings.enable_filtering -%}
        <button type="button" class="collection-filter-trigger-btn" data-disclosure-btn aria-expanded="false" aria-controls="filter-drawer-home-decor" 
                style="background: none; border: 1px solid var(--color-border); padding: 10px 22px; cursor: pointer; text-transform: uppercase; font-size: 0.8rem; font-family: var(--font-body-family); font-weight: 700; letter-spacing: 0.1em; display: flex; align-items: center; gap: var(--space-8); border-radius: var(--button-radius); transition: background-color var(--transition-fast);">
          <span>Filters</span>
          {% render 'icon-chevron' %}
        </button>
      {%- else -%}
        <div></div>
      {%- endif -%}

      <!-- Sort Selection -->
      {%- if section.settings.enable_sorting -%}
        <div class="collection-sort-selector-wrapper" style="display: flex; align-items: center; gap: var(--space-12);">
          <label style="font-size: 0.8rem; text-transform: uppercase; font-family: var(--font-body-family); font-weight: 700; letter-spacing: 0.1em; color: var(--color-text);">Sort By:</label>
          <select id="SortBy" class="collection-sort-select" style="padding: 10px 20px; border: 1px solid var(--color-border); background-color: var(--color-surface); font-family: var(--font-body-family); font-size: 0.85rem; border-radius: var(--button-radius); outline: none;" 
                  onchange="window.location.search = '?sort_by=' + this.value;">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected="selected"{% endif %}>
                {{ option.name }}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
    </div>

    <!-- Filter Drawer Container -->
    {%- if section.settings.enable_filtering -%}
      <div id="filter-drawer-home-decor" class="collection-filter-drawer" style="max-height: 0; overflow: hidden; transition: max-height var(--transition-normal) ease-out; margin-bottom: var(--space-24);">
        <div style="border: 1px solid var(--color-border); padding: var(--space-32); background-color: var(--color-surface); margin-bottom: var(--space-32); border-radius: var(--card-radius);">
          <form id="CollectionFiltersForm" class="filter-form">
            {%- for filter in collection.filters -%}
              <div class="filter-group" style="margin-bottom: var(--space-20);">
                <h4 style="font-family: var(--font-heading-family); font-size: 1.1rem; font-weight: 600; margin-bottom: var(--space-12); text-transform: uppercase; color: var(--color-text);">{{ filter.label }}</h4>
                <div style="display: flex; flex-wrap: wrap; gap: var(--space-16);">
                  {%- for value in filter.values -%}
                    <label style="font-family: var(--font-body-family); font-size: 0.85rem; display: flex; align-items: center; gap: var(--space-8); cursor: pointer; color: var(--color-text);">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} style="accent-color: var(--color-accent);">
                      {{ value.label }} ({{ value.count }})
                    </label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
            <button type="submit" class="button button--secondary button--small" style="margin-top: var(--space-12); border-radius: var(--button-radius);">Apply Filters</button>
          </form>
        </div>
      </div>
    {%- endif -%}

    <style>
      #filter-drawer-home-decor.drawer-open {
        max-height: 800px !important;
        transition: max-height var(--transition-slow) ease-in !important;
      }
    </style>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 grid-cols-md-2 grid-cols-lg-3" style="--grid-spacing: var(--space-40);">
      {%- for product in collection.products -%}
        {%- render 'product-card', product: product -%}
      {%- else -%}
        <p class="collection-empty-message" style="grid-column: 1 / -1; text-align: center; padding: var(--space-64) 0; font-family: var(--font-body-family); color: var(--color-text); opacity: 0.7;">
          {{ 'sections.featured_collection.empty_collection' | t }}
        </p>
      {%- endfor -%}
    </div>

    <!-- Pagination -->
    {%- if paginate.pages > 1 -%}
      <div style="margin-top: var(--space-64); text-align: center;">
        {% render 'pagination', paginate: paginate %}
      </div>
    {%- endif -%}

  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per Page",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable sidebar filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting dropdown",
      "default": true
    }
  ]
}
{% endschema %}
