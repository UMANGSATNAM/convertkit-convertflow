<div class="collection-slider py-16 pl-6 pr-0 md:pl-12 bg-[var(--color-surface)] overflow-hidden">
  <div class="max-w-7xl mx-auto pr-6 mb-8 flex justify-between items-end">
    <div>
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-text)]">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="text-[var(--color-text-muted,#555)] mt-2">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
    
    <!-- Custom Navigation Arrows -->
    <div class="hidden md:flex gap-2">
      <button class="slider-btn-prev w-12 h-12 rounded-full border border-[var(--color-border)] flex items-center justify-center hover:bg-[var(--color-text)] hover:text-[var(--color-background)] hover:border-transparent transition-all">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      </button>
      <button class="slider-btn-next w-12 h-12 rounded-full border border-[var(--color-border)] flex items-center justify-center hover:bg-[var(--color-text)] hover:text-[var(--color-background)] hover:border-transparent transition-all">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
  </div>

  <div class="slider-track-container w-full overflow-x-auto snap-x snap-mandatory scrollbar-hide pb-8">
    <div class="flex gap-6 w-max pr-6">
      {%- assign collection = collections[section.settings.collection] -%}
      {%- comment -%}
        On a freshly generated store nobody has picked a collection yet, so this
        used to fall through to the demo branch below and render six cards
        reading "Featured Product 1" at "$49.99". Falling back to a real
        collection shows real products instead, and leaves the demo branch for
        the only case it should ever cover: a store with no products at all.
      {%- endcomment -%}
      {%- if collection == blank or collection.products_count == 0 -%}
        {%- assign collection = collections.all -%}
      {%- endif -%}
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <div class="snap-start w-[280px] sm:w-[320px] md:w-[350px] flex-shrink-0">
            {% render 'product-card', product: product %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}
          <div class="snap-start w-[280px] sm:w-[320px] md:w-[350px] flex-shrink-0 group cursor-pointer">
            <div class="relative aspect-[3/4] bg-neutral-200 mb-4 rounded-xl overflow-hidden">
              {{ 'product-' | append: i | placeholder_svg_tag: 'w-full h-full object-cover opacity-60 mix-blend-multiply group-hover:scale-105 transition-transform duration-700' }}
              <div class="absolute bottom-4 left-4 right-4 translate-y-10 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                <button class="w-full py-3 bg-[var(--color-background)] text-[var(--color-text)] font-bold text-sm uppercase rounded">Quick Add</button>
              </div>
            </div>
            {%- comment -%}
              Reached only when the store genuinely has no products. Inventing a
              name and a "$49.99" price here made an empty store look like a
              stocked one, and hardcoded the currency for every merchant.
            {%- endcomment -%}
            <h3 class="font-bold text-lg text-[var(--color-text-secondary)]">{{ 'onboarding.product_title' | t: default: 'Your product' }}</h3>
          </div>
        {%- endfor -%}
      {%- endif -%}

      <!-- View All Card -->
      {%- if collection != blank -%}
      <div class="snap-start w-[280px] sm:w-[320px] md:w-[350px] flex-shrink-0 flex items-center justify-center bg-[var(--color-background)] border border-[var(--color-border)] rounded-xl">
        <a href="{{ collection.url }}" class="flex flex-col items-center justify-center p-8 group">
          <div class="w-16 h-16 rounded-full bg-[var(--color-surface)] flex items-center justify-center group-hover:bg-[var(--color-text)] group-hover:text-[var(--color-background)] transition-colors duration-300 mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </div>
          <span class="font-bold uppercase tracking-wider text-[var(--color-text)]">View All</span>
        </a>
      </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
/* Hide scrollbar for Chrome, Safari and Opera */
.scrollbar-hide::-webkit-scrollbar {
  display: none;
}
/* Hide scrollbar for IE, Edge and Firefox */
.scrollbar-hide {
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;  /* Firefox */
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const container = document.querySelector('#shopify-section-{{ section.id }} .slider-track-container');
  const prev = document.querySelector('#shopify-section-{{ section.id }} .slider-btn-prev');
  const next = document.querySelector('#shopify-section-{{ section.id }} .slider-btn-next');
  
  if (!container) return;

  const scrollAmount = 350 + 24; // Card width + gap

  prev?.addEventListener('click', () => {
    container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
  });

  next?.addEventListener('click', () => {
    container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  });
});
</script>

{% schema %}
{
  "name": "Collection Slider",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Trending Now"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Swipe to explore our most loved items."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Collection Slider"
    }
  ]
}
{% endschema %}
