{%- comment -%}
  PDP V8: India D2C (Vibrant Marketplace)
  FULL PAGE ARCHITECTURE
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700&family=Rubik:wght@400;500;600;700&display=swap');

  :root {
    --v8-primary: #3B82F6;
    --v8-accent: #F97316;
    --v8-bg: #F8FAFC;
    --v8-surface: #FFFFFF;
    --v8-border: #E2E8F0;
    --v8-text: #1E293B;
    --v8-text-muted: #64748B;
    --v8-whatsapp: #25D366;
    
    --v8-font-heading: 'Rubik', sans-serif;
    --v8-font-body: 'Nunito Sans', sans-serif;
    --v8-radius: 8px;
  }

  .pdp-v8 {
    background-color: var(--v8-bg);
    color: var(--v8-text);
    font-family: var(--v8-font-body);
    overflow-x: hidden;
  }

  /* --- HERO --- */
  .pdp-v8__hero { padding: 24px 16px; }
  .pdp-v8__container { max-width: 1200px; margin: 0 auto; display: grid; gap: 32px; }
  @media (min-width: 992px) {
    .pdp-v8__container { grid-template-columns: 1fr 1fr; gap: 48px; padding: 40px; background: var(--v8-surface); border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
  }

  .pdp-v8__gallery img, .pdp-v8__gallery svg { width: 100%; border-radius: var(--v8-radius); border: 1px solid var(--v8-border); aspect-ratio: 1; object-fit: cover; }

  .pdp-v8__title { font-family: var(--v8-font-heading); font-size: 28px; font-weight: 600; margin: 0 0 12px 0; }
  .pdp-v8__reviews { display: inline-block; background: #FEF3C7; color: #D97706; padding: 4px 12px; border-radius: 99px; font-size: 13px; font-weight: 700; margin-bottom: 24px; }

  .pdp-v8__price-box { background: #F1F5F9; border: 2px dashed #94A3B8; border-radius: var(--v8-radius); padding: 20px; margin-bottom: 24px; }
  .pdp-v8__price-row { display: flex; align-items: center; gap: 16px; }
  .pdp-v8__price { font-size: 32px; font-weight: 700; font-family: var(--v8-font-heading); color: var(--v8-primary); }
  .pdp-v8__compare { font-size: 18px; text-decoration: line-through; color: var(--v8-text-muted); }
  .pdp-v8__save-badge { background: #DC2626; color: #FFF; padding: 4px 8px; border-radius: 4px; font-size: 13px; font-weight: 700; }

  .pdp-v8__btn-row { display: grid; grid-template-columns: 1fr; gap: 12px; margin-bottom: 32px; }
  @media (min-width: 768px) { .pdp-v8__btn-row { grid-template-columns: 1fr 1fr; } }
  .pdp-v8__atc { background: var(--v8-accent); color: #FFF; border: none; padding: 16px; font-size: 16px; font-weight: 700; border-radius: var(--v8-radius); cursor: pointer; box-shadow: 0 4px 12px rgba(249, 115, 22, 0.3); }
  .pdp-v8__whatsapp { background: var(--v8-whatsapp); color: #FFF; border: none; padding: 16px; font-size: 16px; font-weight: 700; border-radius: var(--v8-radius); cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3); }
  .pdp-v8__whatsapp svg { width: 20px; height: 20px; fill: currentColor; }

  .pdp-v8__trust { display: flex; justify-content: space-around; padding-top: 24px; border-top: 1px solid var(--v8-border); }
  .pdp-v8__trust-item { text-align: center; font-size: 12px; font-weight: 600; color: var(--v8-text-muted); }
  .pdp-v8__trust-icon { width: 32px; height: 32px; background: var(--v8-primary); color: #FFF; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 8px auto; }
  .pdp-v8__trust-icon svg { width: 16px; height: 16px; }

  /* --- DELIVERY ESTIMATOR --- */
  .pdp-v8__delivery { background: #FFF; padding: 16px; border-radius: var(--v8-radius); border: 1px solid var(--v8-border); margin-bottom: 24px; }
  .pdp-v8__delivery-title { font-weight: 700; font-size: 14px; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
  .pdp-v8__pincode { display: flex; gap: 8px; }
  .pdp-v8__pin-input { flex: 1; padding: 12px; border: 1px solid var(--v8-border); border-radius: 4px; font-family: var(--v8-font-body); }
  .pdp-v8__pin-btn { background: var(--v8-text); color: #FFF; border: none; padding: 0 20px; border-radius: 4px; font-weight: 700; cursor: pointer; }

  /* --- FULL DESCRIPTION --- */
  .pdp-v8__desc { max-width: 1200px; margin: 40px auto; padding: 0 16px; }
  .pdp-v8__desc-box { background: var(--v8-surface); padding: 40px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.02); }
  .pdp-v8__desc-title { font-family: var(--v8-font-heading); font-size: 24px; font-weight: 700; margin-bottom: 20px; border-bottom: 2px solid var(--v8-primary); display: inline-block; padding-bottom: 8px; }
  .pdp-v8__desc-content { font-size: 16px; line-height: 1.8; color: var(--v8-text-muted); }
  
  /* --- FREQUENTLY BOUGHT TOGETHER --- */
  .pdp-v8__fbt { max-width: 1200px; margin: 0 auto 60px auto; padding: 0 16px; }
  .pdp-v8__fbt-box { background: #FFF9C4; padding: 32px; border-radius: 16px; border: 1px solid #FDE047; }
  .pdp-v8__fbt-title { font-family: var(--v8-font-heading); font-size: 20px; font-weight: 700; margin-bottom: 24px; color: #9A3412; }
  .pdp-v8__fbt-items { display: flex; flex-direction: column; gap: 16px; }
  @media (min-width: 768px) { .pdp-v8__fbt-items { flex-direction: row; align-items: center; justify-content: space-between; } }
  .pdp-v8__fbt-item { display: flex; align-items: center; gap: 12px; flex: 1; }
  .pdp-v8__fbt-img { width: 64px; height: 64px; border-radius: 8px; background: #FFF; object-fit: cover; }
  .pdp-v8__fbt-plus { font-size: 24px; font-weight: 700; color: #CA8A04; margin: 0 16px; display: none; }
  @media (min-width: 768px) { .pdp-v8__fbt-plus { display: block; } }

  .pdp-v8__fbt-total { background: #FFF; padding: 20px; border-radius: 12px; text-align: center; min-width: 200px; }
  .pdp-v8__fbt-atc { background: #D97706; color: #FFF; border: none; padding: 12px 24px; width: 100%; border-radius: 8px; font-weight: 700; margin-top: 12px; cursor: pointer; }

  /* --- GRID --- */
  .pdp-v8__grid { max-width: 1200px; margin: 0 auto 60px auto; padding: 0 16px; }
  .pdp-v8__grid-title { font-family: var(--v8-font-heading); font-size: 24px; font-weight: 700; margin-bottom: 24px; }
  .pdp-v8__grid-wrap { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media (min-width: 768px) { .pdp-v8__grid-wrap { grid-template-columns: repeat(4, 1fr); gap: 24px; } }
  .pdp-v8__grid-item { background: var(--v8-surface); border-radius: 12px; padding: 12px; border: 1px solid var(--v8-border); text-align: center; }
  .pdp-v8__grid-item img, .pdp-v8__grid-item svg { width: 100%; aspect-ratio: 1; border-radius: 8px; margin-bottom: 12px; background: #F1F5F9; }
  .pdp-v8__grid-name { font-weight: 600; font-size: 14px; margin-bottom: 4px; }
  .pdp-v8__grid-price { color: var(--v8-primary); font-weight: 700; }

</style>

<div class="pdp-v8" data-section="{{ section.id }}">
  
  <!-- HERO -->
  <div class="pdp-v8__hero">
    <div class="pdp-v8__container">
      <div class="pdp-v8__gallery">
        {% if product.featured_media %}
          <img height="{{ product.featured_media.height }}" width="{{ product.featured_media.width }}" src="{{ product.featured_media | image_url: width: 800 }}" alt="{{ product.title }}" fetchpriority="high" loading="eager">
        {% else %}
          {{ 'product-4' | placeholder_svg_tag }}
        {% endif %}
      </div>

      <div class="pdp-v8__info">
        <div class="pdp-v8__reviews">★ 4.8 (3,492 Verified Reviews)</div>
        <h1 class="pdp-v8__title">{{ product.title }}</h1>
        
        <div class="pdp-v8__price-box">
          <div style="font-size:14px; font-weight:700; color:#DC2626; margin-bottom:8px;">🔥 HURRY! LIMITED TIME OFFER</div>
          <div class="pdp-v8__price-row">
            <div class="pdp-v8__price">{{ current_variant.price | money }}</div>
            {% if current_variant.compare_at_price > current_variant.price %}
              <div class="pdp-v8__compare">{{ current_variant.compare_at_price | money }}</div>
              <div class="pdp-v8__save-badge">Huge Savings!</div>
            {% endif %}
          </div>
          <div style="font-size:12px; color:var(--v8-text-muted); margin-top:8px;">Inclusive of all taxes</div>
        </div>

        <div class="pdp-v8__delivery">
          <div class="pdp-v8__delivery-title">ðŸ“ Check Delivery Time</div>
          <div class="pdp-v8__pincode">
            <input type="text" class="pdp-v8__pin-input" placeholder="Enter Pincode">
            <button class="pdp-v8__pin-btn">Check</button>
          </div>
        </div>

        <div class="pdp-v8__btn-row">
          <button class="pdp-v8__atc">Buy Now (Cash on Delivery)</button>
          <button class="pdp-v8__whatsapp">
            <svg viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2Z"/></svg>
            Order via WhatsApp
          </button>
        </div>

        <div class="pdp-v8__trust">
          <div class="pdp-v8__trust-item"><div class="pdp-v8__trust-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></div>100% Genuine</div>
          <div class="pdp-v8__trust-item"><div class="pdp-v8__trust-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>Fast Delivery</div>
          <div class="pdp-v8__trust-item"><div class="pdp-v8__trust-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg></div>COD Available</div>
        </div>
      </div>
    </div>
  </div>

  <!-- FREQUENTLY BOUGHT TOGETHER -->
  <div class="pdp-v8__fbt">
    <div class="pdp-v8__fbt-box">
      <div class="pdp-v8__fbt-title">Make it a Combo & Save More!</div>
      <div class="pdp-v8__fbt-items">
        <div class="pdp-v8__fbt-item">
          {{ 'product-1' | placeholder_svg_tag: 'pdp-v8__fbt-img' }}
          <div><div style="font-weight:700;">{{ product.title }}</div><div style="color:var(--v8-text-muted);">{{ current_variant.price | money }}</div></div>
        </div>
        <div class="pdp-v8__fbt-plus">+</div>
        <div class="pdp-v8__fbt-item">
          {{ 'product-2' | placeholder_svg_tag: 'pdp-v8__fbt-img' }}
          <div><div style="font-weight:700;">Essential Add-on</div><div style="color:var(--v8-text-muted);">$15.00</div></div>
        </div>
        <div class="pdp-v8__fbt-total">
          <div style="font-size:12px; color:var(--v8-text-muted);">Total Price:</div>
          <div style="font-size:24px; font-weight:700; color:#DC2626; margin:4px 0;">$54.99</div>
          <button class="pdp-v8__fbt-atc">Add Combo to Cart</button>
        </div>
      </div>
    </div>
  </div>

  <!-- FULL DESCRIPTION -->
  <div class="pdp-v8__desc">
    <div class="pdp-v8__desc-box">
      <h2 class="pdp-v8__desc-title">Product Details</h2>
      <div class="pdp-v8__desc-content">
        {{ product.description | default: "Experience premium quality with our meticulously crafted product. Designed to bring joy and utility to your daily routine. Every piece undergoes strict quality control to ensure you get nothing but the best. Proudly made with love." }}
      </div>
    </div>
  </div>

  <!-- GRID -->
  <div class="pdp-v8__grid">
    <h2 class="pdp-v8__grid-title">Customers Also Bought</h2>
    <div class="pdp-v8__grid-wrap">
      {% for i in (1..4) %}
      <div class="pdp-v8__grid-item">
        {{ 'product-' | append: i | placeholder_svg_tag }}
        <div class="pdp-v8__grid-name">Bestseller Product {{ i }}</div>
        <div class="pdp-v8__grid-price">$29.99</div>
      </div>
      {% endfor %}
    </div>
  </div>

</div>


<!-- STICKY ATC -->
<style>
  .sticky-atc-{{ section.id }} {
    position: fixed;
    bottom: -100px;
    left: 0;
    width: 100%;
    background: #FFF;
    box-shadow: 0 -4px 10px rgba(0,0,0,0.1);
    z-index: 999;
    padding: 10px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: bottom 0.3s ease-in-out;
    border-top: 1px solid #eee;
  }
  .sticky-atc-{{ section.id }}.visible {
    bottom: 0;
  }
  .sticky-atc-{{ section.id }}__info { display: flex; align-items: center; gap: 10px; }
  .sticky-atc-{{ section.id }}__img { width: 40px; height: 40px; object-fit: cover; border-radius: 4px; }
  .sticky-atc-{{ section.id }}__title { font-weight: 600; font-size: 14px; color: #000; }
  .sticky-atc-{{ section.id }}__price { font-weight: 700; color: #D32F2F; font-size: 14px; }
  .sticky-atc-{{ section.id }}__btn { background: #000; color: #FFF; border: none; padding: 12px 24px; font-weight: 700; cursor: pointer; border-radius: 4px; text-transform: uppercase; }
  .sticky-atc-{{ section.id }}__btn:hover { opacity: 0.8; }
  @media (max-width: 768px) {
    .sticky-atc-{{ section.id }}__info { display: none; }
    .sticky-atc-{{ section.id }}__btn { width: 100%; padding: 14px; font-size: 16px; }
  }
</style>

<div class="sticky-atc-{{ section.id }}" id="sticky-atc-{{ section.id }}">
  <div class="sticky-atc-{{ section.id }}__info">
    {% if product.featured_media %}
      <img src="{{ product.featured_media | image_url: width: 100 }}" alt="{{ product.title | escape }}" width="100" height="100" loading="lazy" class="sticky-atc-{{ section.id }}__img">
    {% endif %}
    <div>
      <div class="sticky-atc-{{ section.id }}__title">{{ product.title }}</div>
      <div class="sticky-atc-{{ section.id }}__price">{{ product.selected_or_first_available_variant.price | money }}</div>
    </div>
  </div>
  
      <!-- D2C SCARCITY & NOTIFY -->
      {% if product.available %}
        <div style="background:#FFF3E0; border:1px solid #FFCC80; padding:10px; border-radius:8px; margin-bottom:12px; display:flex; align-items:center; gap:12px;">
          <svg style="width:24px; height:24px; color:#E65100; flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <div style="font-size:13px; color:#E65100;">
            <div style="font-weight:700;">Limited Time Offer Ends In:</div>
            <div style="font-size:16px; font-weight:700; margin-top:2px;"><b>{% render 'countdown-timer', product: product %}</b></div>
          </div>
        </div>
      {% endif %}

      {% render 'back-in-stock', product: product %}

      {% if product.available %}
      <button class="sticky-atc-{{ section.id }}__btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">ADD TO CART</button>
      {% else %}
      <button class="sticky-atc-{{ section.id }}__btn" disabled style="opacity:0.5; cursor:not-allowed;">SOLD OUT</button>
      {% endif %}
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const stickyBar = document.getElementById('sticky-atc-{{ section.id }}');
    if(stickyBar) {
      window.addEventListener('scroll', function() {
        if (window.scrollY > 600) {
          stickyBar.classList.add('visible');
        } else {
          stickyBar.classList.remove('visible');
        }
      });
    }
  });
</script>

{% schema %}

{
  "name": "PDP V8 - India D2C Full",
  "settings": [],
  "presets": [
    {
      "name": "PDP V8 - India D2C Full"
    }
  ]
}
{% endschema %}
