          </div>
        </div>
      {% endif %}

      
      {% if section.settings.show_coupon %}
        <div class="pdp-v17__coupon">
          <div class="pdp-v17__c-icon">✂️</div>
          <div class="pdp-v17__c-text">Get 20% Off Your First Bag!</div>
          <div class="pdp-v17__c-code">WOOF20</div>
        </div>
      {% endif %}

      <div class="pdp-v17__flavors">
        <div class="pdp-v17__flavor active">Beef & Sweet Potato</div>
        <div class="pdp-v17__flavor">Salmon & Pea</div>
        <div class="pdp-v17__flavor">Chicken & Rice</div>
      </div>

      <div class="pdp-v17__price-wrap">
        <span class="pdp-v17__price">{{ current_variant.price | money }}</span>
        {% if current_variant.compare_at_price > current_variant.price %}
          <span class="pdp-v17__compare">{{ current_variant.compare_at_price | money }}</span>
        {% endif %}
      </div>

      <button class="pdp-v17__atc" id="v17-atc">ADD TO BOWL 🦴</button>

      <!-- BOUGHT TOGETHER BUNDLE -->
      {% if section.settings.show_fbt %}
        <div class="pdp-v17__fbt">
          <div class="pdp-v17__fbt-title">ðŸ¾ Often Bought Together</div>
          <div class="pdp-v17__fbt-item">
            <input type="checkbox" class="pdp-v17__fbt-check" checked disabled>
            {{ 'product-1' | placeholder_svg_tag: 'pdp-v17__fbt-img' }}
            <div class="pdp-v17__fbt-info">
              <div class="pdp-v17__fbt-name">This Item: {{ product.title | default: "Premium Kibble" }}</div>
              <div class="pdp-v17__fbt-price">{{ current_variant.price | money }}</div>
            </div>
          </div>
          <div class="pdp-v17__fbt-item">
            <input type="checkbox" class="pdp-v17__fbt-check">
            {{ 'product-2' | placeholder_svg_tag: 'pdp-v17__fbt-img' }}
            <div class="pdp-v17__fbt-info">
              <div class="pdp-v17__fbt-name">Dental Chew Sticks (30 Pack)</div>
              <div class="pdp-v17__fbt-price">₹499</div>
            </div>
          </div>
        </div>
      {% endif %}

      <!-- TRUST ICONS -->
      <div class="pdp-v17__icons">
        <div class="pdp-v17__icon">
          <div class="pdp-v17__icon-circle">🌾</div>
          Grain Free
        </div>
        <div class="pdp-v17__icon">
          <div class="pdp-v17__icon-circle">💪</div>
          High Protein
        </div>
        <div class="pdp-v17__icon">
          <div class="pdp-v17__icon-circle">❤️</div>
          Heart Healthy
        </div>
      </div>

    </div>
  </div>

  <!-- FULL WIDTH IMAGE / LIFESTYLE -->
  {% if section.settings.show_full_image %}
    <div style="width: 100%; position: relative; margin-top: 60px;">
      {{ 'lifestyle-2' | placeholder_svg_tag: 'style="width: 100%; height: 60vh; object-fit: cover;"' }}
      <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to top, rgba(45,55,72,0.8), rgba(45,55,72,0.3)); display: flex; flex-direction: column; justify-content: flex-end; align-items: center; text-align: center; color: #FFF; padding: 60px 40px;">
        <h2 style="font-family: var(--v17-font-head); font-size: 42px; font-weight: 900; margin-bottom: 16px; line-height: 1.1;">Healthy Pets, Happy Lives.</h2>
        <p style="font-size: 18px; font-weight: 700; max-width: 600px; margin-bottom: 32px; font-family: var(--v17-font-body);">Made with real, whole-food ingredients. No fillers, no artificial preservatives. Just pure, tail-wagging nutrition.</p>
        <button style="background: var(--v17-primary); color: #FFF; border: none; padding: 16px 40px; font-family: var(--v17-font-head); font-weight: 900; font-size: 16px; cursor: pointer; text-transform: uppercase; border-radius: 40px; box-shadow: 0 10px 20px rgba(255,123,84,0.3); transition: transform 0.2s;" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" onmousedown="this.style.transform='scale(0.95)'" onmouseup="this.style.transform='scale(1)'">Shop Nutrition</button>
      </div>
    </div>
  {% endif %}

  <!-- CROSS SELL / FEATURED -->
  {% if section.settings.show_cross_sell %}
    <div style="max-width: 1200px; margin: 80px auto; padding: 0 20px;">
      <h2 style="font-family: var(--v17-font-head); font-size: 32px; font-weight: 900; text-align: center; margin-bottom: 40px; color: var(--v17-text);">More Tail-Wagging Favorites</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px;">
        <div style="background: #FFF; padding: 24px; border-radius: 20px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.05); transition: transform 0.3s;" onmouseover="this.style.transform='translateY(-10px)'" onmouseout="this.style.transform='translateY(0)'">
          {{ 'product-3' | placeholder_svg_tag: 'style="width:100%; height:200px; object-fit:cover; border-radius:12px; margin-bottom:16px;"' }}
          <h3 style="font-family: var(--v17-font-head); font-size: 18px; font-weight: 800; margin-bottom: 8px;">Salmon Oil Supplement</h3>
          <p style="color: var(--v17-text-light); font-weight: 700; margin-bottom: 16px;">₹899</p>
          
      <!-- D2C SCARCITY & NOTIFY -->
      {% if product.available %}
        <div style="background:#FFF3E0; border:1px solid #FFCC80; padding:10px; border-radius:8px; margin-bottom:12px; display:flex; align-items:center; gap:12px;">
          <svg style="width:24px; height:24px; color:#E65100; flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <div style="font-size:13px; color:#E65100;">
            <div style="font-weight:700;">Limited Time Offer Ends In:</div>
            <div style="font-size:16px; font-weight:700; margin-top:2px;"><b>{% render 'countdown-timer', product: product %}</b></div>
          </div>
        </div>
      {% endif %}

      {% render 'back-in-stock', product: product %}

      {% if product.available %}
      <button style="width: 100%; background: var(--v17-secondary); color: #FFF; border: none; padding: 12px; font-family: var(--v17-font-head); font-weight: 800; text-transform: uppercase; border-radius: 30px; cursor: pointer;">Add to Cart</button>
      {% else %}
      <button class="" disabled style="opacity:0.5; cursor:not-allowed;">SOLD OUT</button>
      {% endif %}
        </div>
        <div style="background: #FFF; padding: 24px; border-radius: 20px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.05); transition: transform 0.3s;" onmouseover="this.style.transform='translateY(-10px)'" onmouseout="this.style.transform='translateY(0)'">
          {{ 'product-4' | placeholder_svg_tag: 'style="width:100%; height:200px; object-fit:cover; border-radius:12px; margin-bottom:16px;"' }}
          <h3 style="font-family: var(--v17-font-head); font-size: 18px; font-weight: 800; margin-bottom: 8px;">Soothing Oatmeal Shampoo</h3>
          <p style="color: var(--v17-text-light); font-weight: 700; margin-bottom: 16px;">₹650</p>
          <button style="width: 100%; background: var(--v17-secondary); color: #FFF; border: none; padding: 12px; font-family: var(--v17-font-head); font-weight: 800; text-transform: uppercase; border-radius: 30px; cursor: pointer;">Add to Cart</button>
        </div>
        <div style="background: #FFF; padding: 24px; border-radius: 20px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.05); transition: transform 0.3s;" onmouseover="this.style.transform='translateY(-10px)'" onmouseout="this.style.transform='translateY(0)'">
          {{ 'product-5' | placeholder_svg_tag: 'style="width:100%; height:200px; object-fit:cover; border-radius:12px; margin-bottom:16px;"' }}
          <h3 style="font-family: var(--v17-font-head); font-size: 18px; font-weight: 800; margin-bottom: 8px;">Durable Chew Toy</h3>
          <p style="color: var(--v17-text-light); font-weight: 700; margin-bottom: 16px;">₹499</p>
          <button style="width: 100%; background: var(--v17-secondary); color: #FFF; border: none; padding: 12px; font-family: var(--v17-font-head); font-weight: 800; text-transform: uppercase; border-radius: 30px; cursor: pointer;">Add to Cart</button>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- RECENTLY VIEWED SECTION -->
  {% if section.settings.show_recently_viewed %}
    <div style="max-width: 1400px; margin: 40px auto; padding: 20px;">
      <h2 style="font-size: 24px; font-weight: 600; margin-bottom: 20px;">Recently Viewed</h2>
      <div id="dynamic-recently-viewed" style="display: flex; gap: 16px; overflow-x: auto; padding-bottom: 16px;">
        <!-- Hydrated via JS -->
      </div>
</div>
    </div>
  {% endif %}

  <!-- BUILT-IN STICKY ATC -->
  <div class="pdp-v17-sticky" id="v17-sticky">
    <div class="pdp-v17-sticky__title">{{ product.title | default: "Premium Kibble" }}</div>
    <button class="pdp-v17-sticky__btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">ADD TO BOWL - {{ current_variant.price | money }}</button>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const stickyBar = document.getElementById('v17-sticky');
      const mainAtc = document.getElementById('v17-atc');
      if(stickyBar && mainAtc) {
        window.addEventListener('scroll', function() {
          const mainAtcRect = mainAtc.getBoundingClientRect();
          if (mainAtcRect.top < 0) {
            stickyBar.classList.add('visible');
          } else {
            stickyBar.classList.remove('visible');
          }
        });
      }
    });
  </script>

</div>


  <!-- GLOBAL D2C SCRIPTS -->
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      // RECENTLY VIEWED LOGIC
      const handle = {{ product.handle | json }};
      const rvKey = 'cf_recent_products';
      let recent = JSON.parse(localStorage.getItem(rvKey) || '[]');
      if (handle && !recent.includes(handle)) {
        recent.unshift(handle);
        if (recent.length > 6) recent.pop();
        localStorage.setItem(rvKey, JSON.stringify(recent));
      }

      const rvContainer = document.getElementById('dynamic-recently-viewed');
      if (rvContainer) {
        const fetchRecent = recent.filter(h => h !== handle);
        if (fetchRecent.length > 0) {
          const query = fetchRecent.map(h => `handle:${h}`).join(' OR ');
          fetch(`/search?type=product&q=${query}&section_id=product-card-api`)
            .then(res => res.text())
            .then(html => {
              if (html && !html.includes('404')) {
                rvContainer.innerHTML = html;
              } else {
                rvContainer.parentElement.style.display = 'none';
              }
            })
            .catch(() => rvContainer.parentElement.style.display = 'none');
        } else {
          rvContainer.parentElement.style.display = 'none';
        }
      }

    });
  </script>

{% schema %}
{
  "name": "PDP V17 - Pet Care",
  "settings": [
    {
      "type": "header",
      "content": "Offers"
    },
    {
      "type": "text",
      "id": "review_text",
      "label": "Review count line",
      "info": "Use your real rating and review count, or leave empty. A review app can replace this.",
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "show_coupon",
      "label": "Show Scissor Coupon",
      "default": true
    },
    {
      "type": "header",
      "content": "Bundles"
    },
    {
      "type": "checkbox",
      "id": "show_fbt",
      "label": "Show Bought Together Block",
      "default": true
    },
    {
      "type": "header",
      "content": "Urgency"
    },
    {
      "type": "checkbox",
      "id": "show_urgency",
      "label": "Show 'Selling Fast' Urgency",
      "default": true
    },
    {
      "type": "header",
      "content": "Bottom Sections"
    },
    {
      "type": "checkbox",
      "id": "show_full_image",
      "label": "Show Full Width Lifestyle Image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cross_sell",
      "label": "Show 'More Favorites' Cross Sell",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_recently_viewed",
      "label": "Show Recently Viewed",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "PDP V17 - Pet Care"
    }
  ]
}
{% endschema %}
