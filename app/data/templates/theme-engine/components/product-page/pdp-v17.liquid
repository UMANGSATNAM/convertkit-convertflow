{%- comment -%}
  PDP V17: PET CARE & NUTRITION
  Aesthetic: Playful, Rounded, Vibrant, Trust-driven.
  CRO: "Scissor Cut" coupons, FBT bundles, Subscription.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@500;700;800;900&family=Quicksand:wght@500;700&display=swap');

  :root {
    --v17-bg: #FDF9F1;
    --v17-surface: #FFFFFF;
    --v17-text: #2D3748;
    --v17-text-light: #718096;
    --v17-primary: #FF7B54; /* Vibrant Orange */
    --v17-secondary: #4A90E2; /* Friendly Blue */
    --v17-border: #EDF2F7;
    --v17-font-head: 'Nunito', sans-serif;
    --v17-font-body: 'Quicksand', sans-serif;
  }

  .pdp-v17 {
    background-color: var(--v17-bg);
    color: var(--v17-text);
    font-family: var(--v17-font-body);
    line-height: 1.5;
  }

  .pdp-v17__container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    padding: 20px;
    gap: 30px;
  }
  @media (min-width: 992px) {
    .pdp-v17__container { grid-template-columns: 1fr 1fr; padding: 60px 40px; gap: 60px; }
  }

  /* --- GALLERY --- */
  .pdp-v17__gallery { position: relative; }
  .pdp-v17__gallery img, .pdp-v17__gallery svg {
    width: 100%; border-radius: 30px; background: #FFF; box-shadow: 0 10px 40px rgba(0,0,0,0.05);
  }
  .pdp-v17__badge {
    position: absolute; top: 20px; right: -10px; background: var(--v17-primary); color: #FFF;
    padding: 10px 20px; border-radius: 30px; font-family: var(--v17-font-head); font-weight: 800;
    transform: rotate(5deg); box-shadow: 0 5px 15px rgba(255,123,84,0.4);
  }

  /* --- INFO --- */
  .pdp-v17__title { font-family: var(--v17-font-head); font-size: 38px; font-weight: 900; line-height: 1.1; margin: 0 0 16px 0; color: var(--v17-text); }
  
  .pdp-v17__reviews { display: flex; align-items: center; gap: 8px; font-weight: 700; margin-bottom: 24px; color: var(--v17-secondary); }
  .pdp-v17__reviews svg { width: 20px; height: 20px; fill: currentColor; }

  /* --- SCISSOR COUPON --- */
  .pdp-v17__coupon {
    background: #FFF; border: 2px dashed var(--v17-primary); border-radius: 12px; padding: 16px;
    margin-bottom: 32px; display: flex; align-items: center; gap: 16px; position: relative; overflow: hidden;
  }
  .pdp-v17__coupon::before, .pdp-v17__coupon::after {
    content:''; position: absolute; width: 24px; height: 24px; background: var(--v17-bg); border-radius: 50%; top: 50%; transform: translateY(-50%); border: 2px dashed var(--v17-primary);
  }
  .pdp-v17__coupon::before { left: -14px; border-right-color: transparent; border-top-color: transparent; border-bottom-color: transparent; }
  .pdp-v17__coupon::after { right: -14px; border-left-color: transparent; border-top-color: transparent; border-bottom-color: transparent; }
  
  .pdp-v17__c-icon { font-size: 24px; }
  .pdp-v17__c-text { flex: 1; font-weight: 700; font-family: var(--v17-font-head); font-size: 16px; color: var(--v17-primary); }
  .pdp-v17__c-code { background: var(--v17-bg); padding: 6px 12px; border-radius: 8px; font-weight: 800; font-family: monospace; font-size: 14px; }

  /* --- FLAVOR SELECTION --- */
  .pdp-v17__flavors { display: flex; gap: 12px; margin-bottom: 32px; flex-wrap: wrap; }
  .pdp-v17__flavor {
    padding: 10px 20px; border: 2px solid var(--v17-border); border-radius: 30px; font-weight: 700; cursor: pointer;
    background: #FFF; transition: all 0.2s;
  }
  .pdp-v17__flavor.active { border-color: var(--v17-secondary); background: var(--v17-secondary); color: #FFF; }

  /* --- PRICE & ATC --- */
  .pdp-v17__price-wrap { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; }
  .pdp-v17__price { font-size: 32px; font-family: var(--v17-font-head); font-weight: 900; }
  .pdp-v17__compare { font-size: 18px; color: var(--v17-text-light); text-decoration: line-through; font-weight: 700; }

  .pdp-v17__atc {
    width: 100%; background: var(--v17-primary); color: #FFF; border: none; padding: 20px;
    font-family: var(--v17-font-head); font-size: 20px; font-weight: 900; text-transform: uppercase;
    border-radius: 40px; cursor: pointer; margin-bottom: 32px; box-shadow: 0 10px 20px rgba(255,123,84,0.3);
    transition: transform 0.2s;
  }
  .pdp-v17__atc:active { transform: scale(0.95); }

  /* --- BOUGHT TOGETHER BUNDLE --- */
  .pdp-v17__fbt {
    background: #FFF; border-radius: 20px; padding: 24px; margin-bottom: 32px; box-shadow: 0 5px 20px rgba(0,0,0,0.03);
  }
  .pdp-v17__fbt-title { font-family: var(--v17-font-head); font-size: 20px; font-weight: 800; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
  .pdp-v17__fbt-item { display: flex; gap: 16px; align-items: center; margin-bottom: 16px; }
  .pdp-v17__fbt-check { appearance: none; width: 24px; height: 24px; border: 2px solid var(--v17-text-light); border-radius: 6px; cursor: pointer; position: relative; }
  .pdp-v17__fbt-check:checked { background: var(--v17-secondary); border-color: var(--v17-secondary); }
  .pdp-v17__fbt-check:checked::after { content:'✓'; position: absolute; color:#FFF; font-weight:bold; top:50%; left:50%; transform:translate(-50%,-50%); }
  .pdp-v17__fbt-img { width: 60px; height: 60px; object-fit: cover; border-radius: 12px; background: var(--v17-bg); }
  .pdp-v17__fbt-info { flex: 1; }
  .pdp-v17__fbt-name { font-weight: 700; font-size: 14px; margin-bottom: 4px; }
  .pdp-v17__fbt-price { font-weight: 800; color: var(--v17-secondary); }

  /* --- ICONS ROW --- */
  .pdp-v17__icons { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; text-align: center; border-top: 2px dashed var(--v17-border); padding-top: 24px; }
  .pdp-v17__icon { font-weight: 700; font-size: 13px; color: var(--v17-text-light); }
  .pdp-v17__icon-circle { width: 50px; height: 50px; background: #FFF; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 8px auto; box-shadow: 0 4px 10px rgba(0,0,0,0.05); color: var(--v17-primary); font-size: 24px; }

  /* --- STICKY ATC --- */
  .pdp-v17-sticky {
    position: fixed; bottom: -100px; left: 0; width: 100%; background: #FFF; box-shadow: 0 -10px 30px rgba(0,0,0,0.1);
    z-index: 999; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center;
    transition: bottom 0.4s cubic-bezier(0.4, 0, 0.2, 1); border-radius: 30px 30px 0 0;
  }
  .pdp-v17-sticky.visible { bottom: 0; }
  .pdp-v17-sticky__title { font-family: var(--v17-font-head); font-size: 18px; font-weight: 800; }
  .pdp-v17-sticky__btn {
    background: var(--v17-primary); color: #FFF; border: none; padding: 12px 32px;
    font-family: var(--v17-font-head); font-size: 16px; font-weight: 900; text-transform: uppercase; cursor: pointer; border-radius: 30px;
  }

</style>

<div class="pdp-v17" data-section="{{ section.id }}">
  
  <div class="pdp-v17__container">
    
    <!-- GALLERY -->
    <div class="pdp-v17__gallery">
