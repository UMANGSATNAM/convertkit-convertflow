{%- comment -%}
  PDP V31 — NEON CYBER-POP HOLOGRAPHIC
  Design: High-vibe holographic neon cyberpunk, Orbitron display + Space Grotesk body
  Night Sky Dark (#090D16), Electric Pink (#EC4899), Laser Cyan (#06B6D4), Holographic Purple (#8B5CF6)
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign inv_qty = current_variant.inventory_quantity | default: 15 -%}
{%- if inv_qty <= 0 -%}{%- assign inv_qty = 6 -%}{%- endif -%}
{%- assign viewer_count = inv_qty | times: 8 | modulo: 60 | plus: 30 -%}
{%- assign sold_count = inv_qty | times: 18 | modulo: 450 | plus: 240 -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap');

  .pdpv31 {
    --bg: #090D16; --surface: #0F172A; --border: #1E293B; --border-dark: #EC4899;
    --text: #F8FAFC; --muted: #94A3B8; --accent: #EC4899; --accent-hover: #DB2777;
    --cyan: #06B6D4; --purple: #8B5CF6; --danger: #EF4444;
    --f-head: 'Orbitron', sans-serif; --f-body: 'Space Grotesk', sans-serif;
    --r: 10px; --r-pill: 9999px; --ease: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    background: var(--bg); color: var(--text); font-family: var(--f-body); font-size: 16px; line-height: 1.5; -webkit-font-smoothing: antialiased;
  }
  .pdpv31 *, .pdpv31 *::before, .pdpv31 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pdpv31 img { max-width: 100%; display: block; }
  .pdpv31 button { font-family: inherit; cursor: pointer; }
  .pdpv31__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* OFFER BAR */
  .pdpv31__offer { background: linear-gradient(90deg, #EC4899, #8B5CF6, #06B6D4); color: #FFF; padding: 12px; text-align: center; font-family: var(--f-head); font-size: 14px; font-weight: 800; letter-spacing: 3px; text-transform: uppercase; text-shadow: 0 0 10px rgba(236,72,153,0.6); }

  /* GRID */
  .pdpv31__grid { display: grid; grid-template-columns: 1fr; gap: 36px; padding: 36px 0; }
  @media (min-width: 992px) { .pdpv31__grid { grid-template-columns: 1.1fr 1fr; gap: 48px; padding: 48px 0; } }

  /* GALLERY */
  .pdpv31__gal { display: flex; flex-direction: column; gap: 12px; }
  .pdpv31__hero { width: 100%; aspect-ratio: 1; border-radius: var(--r); overflow: hidden; background: var(--surface); border: 1px solid var(--accent); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 30px rgba(236,72,153,0.3); position: relative; }
  .pdpv31__hero img { width: 100%; height: 100%; object-fit: contain; }
  .pdpv31__holo-tag { position: absolute; top: 14px; left: 14px; background: rgba(9,13,22,0.85); border: 1px solid var(--cyan); color: var(--cyan); font-family: var(--f-head); font-size: 11px; font-weight: 800; padding: 4px 12px; border-radius: var(--r); text-transform: uppercase; letter-spacing: 2px; box-shadow: 0 0 10px rgba(6,182,212,0.4); }

  .pdpv31__thumbs { display: flex; gap: 10px; overflow-x: auto; }
  .pdpv31__th { width: 64px; height: 64px; flex-shrink: 0; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; cursor: pointer; background: var(--surface); transition: var(--ease); }
  .pdpv31__th:hover, .pdpv31__th.on { border-color: var(--accent); box-shadow: 0 0 12px rgba(236,72,153,0.5); }
  .pdpv31__th img { width: 100%; height: 100%; object-fit: cover; }

  /* INFO PANEL */
  .pdpv31__info { display: flex; flex-direction: column; gap: 18px; }
  .pdpv31__crumb { font-family: var(--f-head); font-size: 12px; letter-spacing: 3px; color: var(--cyan); font-weight: 800; text-transform: uppercase; }
  .pdpv31__title { font-family: var(--f-head); font-size: 32px; font-weight: 800; line-height: 1.15; color: var(--text); letter-spacing: 1px; text-transform: uppercase; text-shadow: 0 0 15px rgba(248,250,252,0.15); }
  @media (min-width: 992px) { .pdpv31__title { font-size: 40px; } }

  .pdpv31__rating { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--muted); font-weight: 600; }
  .pdpv31__stars { color: var(--accent); }

  /* PRICE CARD */
  .pdpv31__price-card { background: var(--surface); border: 1px solid var(--accent); border-radius: var(--r); padding: 18px 22px; display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 0 0 20px rgba(236,72,153,0.2); }
  .pdpv31__price { font-family: var(--f-head); font-size: 38px; font-weight: 800; color: var(--accent); text-shadow: 0 0 12px rgba(236,72,153,0.5); }
  .pdpv31__cmp { font-size: 20px; color: var(--muted); text-decoration: line-through; }
  .pdpv31__badge { background: var(--cyan); color: #000; font-family: var(--f-head); font-weight: 800; font-size: 12px; padding: 4px 10px; border-radius: 4px; letter-spacing: 1px; }

  /* VARIANTS */
  .pdpv31__vlabel { font-family: var(--f-head); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; color: var(--cyan); margin-bottom: 8px; }
  .pdpv31__vopts { display: flex; flex-wrap: wrap; gap: 10px; }
  .pdpv31__vr { display: none; }
  .pdpv31__vbtn { padding: 10px 22px; border: 1px solid var(--border); border-radius: var(--r); background: var(--surface); color: var(--text); font-family: var(--f-head); font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; transition: var(--ease); cursor: pointer; }
  .pdpv31__vbtn:hover { border-color: var(--cyan); color: var(--cyan); }
  .pdpv31__vr:checked + .pdpv31__vbtn { border-color: var(--accent); background: var(--accent); color: #FFF; box-shadow: 0 0 14px rgba(236,72,153,0.6); }

  /* PROMO */
  .pdpv31__promo { background: var(--surface); border: 1px dashed var(--accent); border-radius: var(--r); padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; font-family: var(--f-head); font-size: 13px; font-weight: 800; color: var(--text); letter-spacing: 1px; }
  .pdpv31__promo-code { background: var(--accent); color: #FFF; padding: 4px 12px; border-radius: 4px; }

  /* URGENCY */
  .pdpv31__urg { background: var(--surface); border-left: 4px solid var(--cyan); border-radius: 0 var(--r) var(--r) 0; padding: 18px; display: flex; flex-direction: column; gap: 8px; font-family: var(--f-head); font-size: 13px; font-weight: 800; letter-spacing: 1px; }
  .pdpv31__pulse { display: inline-block; width: 8px; height: 8px; background: var(--cyan); border-radius: 50%; margin-right: 6px; animation: pdpv31p 1.5s infinite; box-shadow: 0 0 8px var(--cyan); }
  @keyframes pdpv31p { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
  .pdpv31__bar { height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; margin-top: 4px; }
  .pdpv31__fill { height: 100%; background: linear-gradient(90deg, var(--accent), var(--cyan)); border-radius: 3px; }

  /* QTY & CTA */
  .pdpv31__qty-row { display: flex; align-items: center; gap: 14px; }
  .pdpv31__qty { display: flex; border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; background: var(--surface); }
  .pdpv31__qty button { width: 44px; height: 48px; border: none; background: transparent; font-size: 18px; font-weight: 800; color: var(--text); }
  .pdpv31__qty input { width: 44px; height: 48px; border: none; border-left: 1px solid var(--border); border-right: 1px solid var(--border); text-align: center; font-size: 15px; font-weight: 800; background: transparent; color: var(--text); }

  .pdpv31__atc { width: 100%; padding: 18px; border: none; border-radius: var(--r); background: linear-gradient(90deg, #EC4899, #8B5CF6); color: #FFF; font-family: var(--f-head); font-size: 16px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; transition: var(--ease); box-shadow: 0 0 24px rgba(236,72,153,0.5); }
  .pdpv31__atc:hover { background: linear-gradient(90deg, #DB2777, #7C3AED); transform: translateY(-1px); box-shadow: 0 0 32px rgba(236,72,153,0.7); }
  .pdpv31__atc:disabled { opacity: 0.4; cursor: not-allowed; box-shadow: none; }
  .pdpv31__buynow .shopify-payment-button__button { border-radius: var(--r) !important; }

  /* TRUST */
  .pdpv31__trust { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; text-align: center; padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .pdpv31__trust-item { font-family: var(--f-head); font-size: 10px; font-weight: 800; text-transform: uppercase; color: var(--muted); letter-spacing: 1px; }
  .pdpv31__trust-icon { font-size: 20px; margin-bottom: 3px; color: var(--cyan); }
  @media (max-width: 480px) { .pdpv31__trust { grid-template-columns: repeat(2, 1fr); } }

  /* ACCORDION */
  .pdpv31__acc { border-top: 1px solid var(--border); margin-top: 48px; }
  .pdpv31__acc-item { border-bottom: 1px solid var(--border); }
  .pdpv31__acc-btn { width: 100%; padding: 18px 0; border: none; background: transparent; display: flex; justify-content: space-between; align-items: center; font-family: var(--f-head); font-size: 16px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--text); }
  .pdpv31__acc-btn::after { content: '⚡'; font-size: 16px; color: var(--cyan); }
  .pdpv31__acc-body { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .pdpv31__acc-item.open .pdpv31__acc-body { max-height: 500px; }
  .pdpv31__acc-inner { padding: 0 0 18px; font-size: 15px; line-height: 1.7; color: var(--muted); }

  /* SECTION TITLE */
  .pdpv31__sh { font-family: var(--f-head); font-size: 24px; font-weight: 800; text-transform: uppercase; text-align: center; margin: 48px 0 20px; color: var(--text); letter-spacing: 2px; text-shadow: 0 0 12px rgba(236,72,153,0.4); }

  /* REELS */
  .pdpv31__reels { display: flex; gap: 14px; overflow-x: auto; padding-bottom: 12px; }
  .pdpv31__reel { min-width: 180px; width: 180px; aspect-ratio: 9/16; background: #000; border: 1px solid var(--accent); border-radius: var(--r); overflow: hidden; flex-shrink: 0; position: relative; box-shadow: 0 0 15px rgba(236,72,153,0.3); }
  .pdpv31__reel video { width: 100%; height: 100%; object-fit: cover; }
  .pdpv31__reel-cap { position: absolute; bottom: 0; left: 0; right: 0; padding: 10px; background: rgba(9,13,22,0.9); color: var(--cyan); font-family: var(--f-head); font-size: 10px; font-weight: 800; text-transform: uppercase; }
  .pdpv31__reel-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--cyan); font-size: 36px; }

  /* CARDS */
  .pdpv31__pgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media (min-width: 768px) { .pdpv31__pgrid { grid-template-columns: repeat(4, 1fr); } }
  .pdpv31__pcard { background: var(--surface); border-radius: var(--r); border: 1px solid var(--border); overflow: hidden; transition: var(--ease); text-decoration: none; color: inherit; display: block; }
  .pdpv31__pcard:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 0 20px rgba(236,72,153,0.3); }
  .pdpv31__pcard img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .pdpv31__pcard-info { padding: 14px; }
  .pdpv31__pcard-title { font-family: var(--f-head); font-size: 13px; font-weight: 800; margin-bottom: 4px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-transform: uppercase; }
  .pdpv31__pcard-price { font-family: var(--f-head); font-size: 15px; font-weight: 800; color: var(--accent); }

  /* REVIEWS */
  .pdpv31__revgrid { display: grid; grid-template-columns: 1fr; gap: 14px; }
  @media (min-width: 768px) { .pdpv31__revgrid { grid-template-columns: repeat(3, 1fr); } }
  .pdpv31__revcard { background: var(--surface); border-radius: var(--r); border: 1px solid var(--border); padding: 20px; }
  .pdpv31__rev-stars { color: var(--accent); font-size: 14px; margin-bottom: 8px; }
  .pdpv31__rev-txt { font-size: 14px; line-height: 1.6; color: var(--muted); font-style: italic; margin-bottom: 12px; }
  .pdpv31__rev-auth { font-family: var(--f-head); font-size: 13px; font-weight: 800; text-transform: uppercase; color: var(--cyan); }
  .pdpv31__rev-vf { font-family: var(--f-head); font-size: 10px; color: var(--accent); font-weight: 800; }

  /* RECENTLY VIEWED */
  #pdpv31-rv { display: none; }
  #pdpv31-rv.has { display: block; }

  /* STICKY ATC */
  .pdpv31__sticky { position: fixed; bottom: -80px; left: 0; width: 100%; background: var(--surface); border-top: 1px solid var(--accent); padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; z-index: 9999; transition: bottom 0.3s ease; box-shadow: 0 -4px 20px rgba(0,0,0,0.5); }
  .pdpv31__sticky.show { bottom: 0; }
  .pdpv31__sticky-l { display: flex; align-items: center; gap: 14px; }
  .pdpv31__sticky-img { width: 42px; height: 42px; border-radius: 6px; border: 1px solid var(--cyan); object-fit: cover; }
  .pdpv31__sticky-t { font-family: var(--f-head); font-size: 13px; font-weight: 800; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-transform: uppercase; }
  .pdpv31__sticky-p { font-family: var(--f-head); font-size: 15px; font-weight: 800; color: var(--accent); }
  .pdpv31__sticky-btn { background: linear-gradient(90deg, #EC4899, #8B5CF6); color: #FFF; border: none; padding: 12px 26px; border-radius: var(--r); font-family: var(--f-head); font-weight: 800; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; transition: var(--ease); box-shadow: 0 0 16px rgba(236,72,153,0.5); }
  .pdpv31__sticky-btn:hover { background: linear-gradient(90deg, #DB2777, #7C3AED); }
  @media (max-width: 600px) { .pdpv31__sticky-l { display: none; } .pdpv31__sticky-btn { width: 100%; padding: 15px; } }

  .pdpv31__toast { position: fixed; top: 20px; right: 20px; background: linear-gradient(90deg, #EC4899, #8B5CF6); color: #FFF; border-radius: var(--r); padding: 12px 24px; font-family: var(--f-head); font-size: 13px; font-weight: 800; z-index: 10000; transform: translateX(130%); transition: transform 0.3s ease; box-shadow: 0 0 20px rgba(236,72,153,0.6); }
  .pdpv31__toast.show { transform: translateX(0); }
</style>

<div class="pdpv31">
  {% if section.settings.show_offer %}<div class="pdpv31__offer">{{ section.settings.offer_text }}</div>{% endif %}

  <div class="pdpv31__wrap">
    <div class="pdpv31__grid">

      <!-- GALLERY -->
      <div class="pdpv31__gal">
        <div class="pdpv31__hero" id="pdpv31-hero">
          <span class="pdpv31__holo-tag">⚡ NEON HOLOGRAPHIC</span>
          {% if product.featured_media %}<img height="{{ product.featured_media.height }}" width="{{ product.featured_media.width }}" src="{{ product.featured_media | image_url: width: 900 }}" alt="{{ product.title | escape }}" id="pdpv31-himg">{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
        </div>
        <div class="pdpv31__thumbs">
          {% for media in product.media limit: 6 %}
            <div class="pdpv31__th {% if forloop.first %}on{% endif %}">
              <img height="{{ media.height }}" width="{{ media.width }}" src="{{ media | image_url: width: 150 }}" alt="{{ media.alt | escape }}" loading="lazy">
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- INFO -->
      <div class="pdpv31__info">
        <div class="pdpv31__crumb">⚡ {% if product.collections.size > 0 %}{{ product.collections.first.title }}{% else %}Neon Cyber-Pop{% endif %}</div>
        <h1 class="pdpv31__title">{{ product.title }}</h1>

        {% if section.settings.show_rating %}
          <div class="pdpv31__rating">
            <span class="pdpv31__stars">★★★★★</span>
            <span>{{ section.settings.rating_val }} · {{ section.settings.rev_count }} Neon Reviews</span>
          </div>
        {% endif %}

        <div class="pdpv31__price-card">
          <span class="pdpv31__price" id="pdpv31-price">{{ current_variant.price | money }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="pdpv31__cmp">{{ current_variant.compare_at_price | money }}</span>
            {%- assign sv = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
            <span class="pdpv31__badge">SAVE {{ sv }}%</span>
          {% endif %}
        </div>

        {% if product.variants.size > 1 %}
          {% for option in product.options_with_values %}
            <div>
              <div class="pdpv31__vlabel">Select {{ option.name }}</div>
              <div class="pdpv31__vopts">
                {% for value in option.values %}
                  <label>
                    <input type="radio" name="pdpv31-o-{{ option.position }}" value="{{ value | escape }}" class="pdpv31__vr" data-pos="{{ option.position }}" {% if option.selected_value == value %}checked{% endif %}>
                    <span class="pdpv31__vbtn">{{ value }}</span>
                  </label>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% endif %}

        {% if section.settings.show_promo %}
          <div class="pdpv31__promo">
            <span>⚡ Neon Pass: Apply {{ section.settings.promo_code }}</span>
            <span class="pdpv31__promo-code">Save {{ section.settings.promo_disc }}</span>
          </div>
        {% endif %}

        {% if section.settings.show_urgency %}
          <div class="pdpv31__urg">
            <div><span class="pdpv31__pulse"></span><strong>{{ viewer_count }}</strong> cyber units active</div>
            <div>⚡ <strong>{{ sold_count }}</strong> neon orders completed today</div>
            <div>Telemetry: Only <strong>{{ inv_qty }}</strong> remaining
              <div class="pdpv31__bar">
                {%- assign sp = inv_qty | times: 100 | divided_by: 45 -%}
                {%- if sp > 100 -%}{%- assign sp = 100 -%}{%- endif -%}
                <div class="pdpv31__fill" style="width:{{ sp }}%"></div>
              </div>
            </div>
            {% if section.settings.show_countdown %}
              <div>⏳ Neon Drop Ends In: <strong id="pdpv31-cd" style="color:var(--cyan)">{{ section.settings.cd_hrs }}h 00m 00s</strong></div>
            {% endif %}
          </div>
        {% endif %}

        <div class="pdpv31__qty-row">
          <div class="pdpv31__qty">
            <button type="button" id="pdpv31-qm">−</button>
            <input type="number" id="pdpv31-qi" value="1" min="1" max="10" readonly>
            <button type="button" id="pdpv31-qp">+</button>
          </div>
          {% form 'product', product, id: 'pdpv31-form', style: 'flex:1' %}
            <input type="hidden" name="id" id="pdpv31-vid" value="{{ current_variant.id }}">
            <input type="hidden" name="quantity" id="pdpv31-fq" value="1">
            <button type="submit" name="add" class="pdpv31__atc" id="pdpv31-atc" {% unless current_variant.available %}disabled{% endunless %}>
              {% if current_variant.available %}Add to Cart — {{ current_variant.price | money }}{% else %}Sold Out{% endif %}
            </button>
            <div class="pdpv31__buynow" style="margin-top:10px">{{ form | payment_button }}</div>
          {% endform %}
        </div>

        <div class="pdpv31__trust">
          <div class="pdpv31__trust-item"><div class="pdpv31__trust-icon">🔒</div>256-Bit Encrypted</div>
          <div class="pdpv31__trust-item"><div class="pdpv31__trust-icon">⚡</div>Hyper Dispatch</div>
          <div class="pdpv31__trust-item"><div class="pdpv31__trust-icon">↩️</div>Easy Returns</div>
          <div class="pdpv31__trust-item"><div class="pdpv31__trust-icon">🛡️</div>Full Warranty</div>
        </div>
      </div>
    </div>

    <!-- ACCORDION -->
    <div class="pdpv31__acc">
      <div class="pdpv31__acc-item open">
        <button class="pdpv31__acc-btn" type="button">Holographic Specifications</button>
        <div class="pdpv31__acc-body"><div class="pdpv31__acc-inner">{{ product.description }}</div></div>
      </div>
      {% if section.settings.holo_specs != blank %}
        <div class="pdpv31__acc-item">
          <button class="pdpv31__acc-btn" type="button">Build & Material Telemetry</button>
          <div class="pdpv31__acc-body"><div class="pdpv31__acc-inner">{{ section.settings.holo_specs }}</div></div>
        </div>
      {% endif %}
    </div>

    <!-- FBT -->
    {% if section.settings.fbt_coll != blank %}
      {%- assign fbt = collections[section.settings.fbt_coll] -%}
      {% if fbt.products.size > 0 %}
        <div class="pdpv31__sh">Cyber-Pop Pairings</div>
        <div class="pdpv31__pgrid">
          {% for item in fbt.products limit: 4 %}
            <a href="{{ item.url }}" class="pdpv31__pcard">
              <img height="{{ item.featured_image.height }}" width="{{ item.featured_image.width }}" src="{{ item.featured_image | image_url: width: 400 }}" alt="{{ item.title | escape }}" loading="lazy">
              <div class="pdpv31__pcard-info">
                <div class="pdpv31__pcard-title">{{ item.title }}</div>
                <div class="pdpv31__pcard-price">{{ item.price | money }}</div>
              </div>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}

    <!-- REELS -->
    {% if section.settings.show_reels %}
      <div class="pdpv31__sh">Neon Stream</div>
      <div class="pdpv31__reels">
        {% if section.settings.r1 != blank %}<div class="pdpv31__reel"><video src="{{ section.settings.r1 }}" muted playsinline loop></video><div class="pdpv31__reel-cap">⚡ Holographic Glow</div></div>{% else %}<div class="pdpv31__reel"><div class="pdpv31__reel-ph">▶</div></div>{% endif %}
        {% if section.settings.r2 != blank %}<div class="pdpv31__reel"><video src="{{ section.settings.r2 }}" muted playsinline loop></video><div class="pdpv31__reel-cap">⚡ Neon Pink</div></div>{% else %}<div class="pdpv31__reel"><div class="pdpv31__reel-ph">▶</div></div>{% endif %}
        {% if section.settings.r3 != blank %}<div class="pdpv31__reel"><video src="{{ section.settings.r3 }}" muted playsinline loop></video><div class="pdpv31__reel-cap">⚡ High Performance</div></div>{% else %}<div class="pdpv31__reel"><div class="pdpv31__reel-ph">▶</div></div>{% endif %}
      </div>
    {% endif %}

    <!-- REVIEWS -->
    {% if section.settings.show_reviews %}
      <div class="pdpv31__sh" id="reviews">Cyber Community Reviews</div>
      <div class="pdpv31__revgrid">
        {% if section.settings.rv1 != blank %}<div class="pdpv31__revcard"><div class="pdpv31__rev-stars">★★★★★</div><div class="pdpv31__rev-txt">"{{ section.settings.rv1 }}"</div><div class="pdpv31__rev-auth">{{ section.settings.rv1n }}</div><div class="pdpv31__rev-vf">✓ Verified Buyer</div></div>{% endif %}
        {% if section.settings.rv2 != blank %}<div class="pdpv31__revcard"><div class="pdpv31__rev-stars">★★★★★</div><div class="pdpv31__rev-txt">"{{ section.settings.rv2 }}"</div><div class="pdpv31__rev-auth">{{ section.settings.rv2n }}</div><div class="pdpv31__rev-vf">✓ Verified Buyer</div></div>{% endif %}
        {% if section.settings.rv3 != blank %}<div class="pdpv31__revcard"><div class="pdpv31__rev-stars">★★★★★</div><div class="pdpv31__rev-txt">"{{ section.settings.rv3 }}"</div><div class="pdpv31__rev-auth">{{ section.settings.rv3n }}</div><div class="pdpv31__rev-vf">✓ Verified Buyer</div></div>{% endif %}
      </div>
    {% endif %}

    <!-- FEATURED -->
    {% if section.settings.feat_coll != blank %}
      {%- assign fc = collections[section.settings.feat_coll] -%}
      {% if fc.products.size > 0 %}
        <div class="pdpv31__sh">Recommended Hardware</div>
        <div class="pdpv31__pgrid">
          {% for item in fc.products limit: 4 %}
            {% if item.handle != product.handle %}
              <a href="{{ item.url }}" class="pdpv31__pcard">
                <img height="{{ item.featured_image.height }}" width="{{ item.featured_image.width }}" src="{{ item.featured_image | image_url: width: 400 }}" alt="{{ item.title | escape }}" loading="lazy">
                <div class="pdpv31__pcard-info">
                  <div class="pdpv31__pcard-title">{{ item.title }}</div>
                  <div class="pdpv31__pcard-price">{{ item.price | money }}</div>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}

    <!-- RECENTLY VIEWED -->
    <div id="pdpv31-rv">
      <div class="pdpv31__sh">Recently Viewed</div>
      <div class="pdpv31__pgrid" id="pdpv31-rvg"></div>
    </div>
  </div>
</div>

<!-- STICKY ATC -->
<div class="pdpv31__sticky" id="pdpv31-sticky">
  <div class="pdpv31__sticky-l">
    {% if product.featured_media %}<img height="{{ product.featured_media.height }}" width="{{ product.featured_media.width }}" src="{{ product.featured_media | image_url: width: 80 }}" class="pdpv31__sticky-img" alt="{{ product.title | escape }}">{% endif %}
    <div>
      <div class="pdpv31__sticky-t">{{ product.title }}</div>
      <div class="pdpv31__sticky-p" id="pdpv31-sp">{{ current_variant.price | money }}</div>
    </div>
  </div>
  
      <!-- D2C SCARCITY & NOTIFY -->
      {% if product.available %}
        <div style="background:#FFF3E0; border:1px solid #FFCC80; padding:10px; border-radius:8px; margin-bottom:12px; display:flex; align-items:center; gap:12px;">
          <svg style="width:24px; height:24px; color:#E65100; flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <div style="font-size:13px; color:#E65100;">
            <div style="font-weight:700;">Limited Time Offer Ends In:</div>
            <div style="font-size:16px; font-weight:700; margin-top:2px;"><b>{% render 'countdown-timer', product: product %}</b></div>
          </div>
        </div>
      {% endif %}

      {% render 'back-in-stock', product: product %}

      {% if product.available %}
      <button type="button" class="pdpv31__sticky-btn" id="pdpv31-sbtn">Add to Cart</button>
      {% else %}
      <button class="pdpv31__sticky-btn" disabled style="opacity:0.5; cursor:not-allowed;">SOLD OUT</button>
      {% endif %}
</div>

<div class="pdpv31__toast" id="pdpv31-toast">⚡ Added to cart!</div>

<script>
(function(){
  var PJ={{ product | json }}, cid={{ current_variant.id }};
  function getO(){ var o=[]; document.querySelectorAll('.pdpv31__vr:checked').forEach(function(r){ o.push({p:parseInt(r.dataset.pos),v:r.value}); }); o.sort(function(a,b){return a.p-b.p}); return o.map(function(x){return x.v}); }
  function findV(o){ for(var i=0;i<PJ.variants.length;i++){ var v=PJ.variants[i],ok=true; for(var j=0;j<o.length;j++){ if(v.options[j]!==o[j]){ ok=false; break; } } if(ok) return v; } return null; }
  function upd(){
    var o=getO(); if(!o.length) return; var v=findV(o); if(!v) return; cid=v.id;
    document.getElementById('pdpv31-vid').value=v.id;
    var pf=(v.price/100).toLocaleString('en-US',{style:'currency',currency:PJ.currency||'USD'});
    var pe=document.getElementById('pdpv31-price'); if(pe) pe.textContent=pf;
    var sp=document.getElementById('pdpv31-sp'); if(sp) sp.textContent=pf;
    var ab=document.getElementById('pdpv31-atc');
    if(ab){ ab.disabled=!v.available; ab.textContent=v.available?'Add to Cart — '+pf:'Sold Out'; }
    var u=new URL(window.location); u.searchParams.set('variant',v.id); history.replaceState({},'',u);
  }
  document.querySelectorAll('.pdpv31__vr').forEach(function(r){ r.addEventListener('change',upd); });

  var fm=document.getElementById('pdpv31-form');
  if(fm) fm.addEventListener('submit',function(e){
    e.preventDefault(); var b=document.getElementById('pdpv31-atc'), ot=b.textContent;
    b.disabled=true; b.textContent='Adding...';
    var q=parseInt(document.getElementById('pdpv31-qi').value)||1;
    document.getElementById('pdpv31-fq').value=q;
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:cid,quantity:q})})
    .then(function(r){return r.json();})
    .then(function(){ b.textContent='✓ Added!'; toast31(); setTimeout(function(){ b.disabled=false; b.textContent=ot; },2000); })
    .catch(function(){ b.textContent='Error'; setTimeout(function(){ b.disabled=false; b.textContent=ot; },2000); });
  });

  function toast31(){ var t=document.getElementById('pdpv31-toast'); t.classList.add('show'); setTimeout(function(){ t.classList.remove('show'); },3000); }

  var qi=document.getElementById('pdpv31-qi');
  document.getElementById('pdpv31-qm').addEventListener('click',function(){ var v=parseInt(qi.value); if(v>1) qi.value=v-1; });
  document.getElementById('pdpv31-qp').addEventListener('click',function(){ var v=parseInt(qi.value); if(v<10) qi.value=v+1; });

  document.querySelectorAll('.pdpv31__th').forEach(function(th){
    th.addEventListener('click',function(){
      document.querySelectorAll('.pdpv31__th').forEach(function(t){ t.classList.remove('on'); });
      th.classList.add('on');
      var hi=document.getElementById('pdpv31-himg'), ti=th.querySelector('img');
      if(hi&&ti) hi.src=ti.src.replace(/width=\d+/,'width=900');
    });
  });

  var sb=document.getElementById('pdpv31-sticky'), ab=document.getElementById('pdpv31-atc');
  if(sb&&ab) window.addEventListener('scroll',function(){ sb.classList.toggle('show', ab.getBoundingClientRect().top<-50); });
  var sbn=document.getElementById('pdpv31-sbtn');
  if(sbn) sbn.addEventListener('click',function(){ document.getElementById('pdpv31-atc').click(); });

  document.querySelectorAll('.pdpv31__acc-btn').forEach(function(b){ b.addEventListener('click',function(){ b.closest('.pdpv31__acc-item').classList.toggle('open'); }); });

  var ce=document.getElementById('pdpv31-cd');
  if(ce){
    var hrs=parseInt('{{ section.settings.cd_hrs | default: 6 }}')||6, ts=hrs*3600;
    var sk=sessionStorage.getItem('pdpv31_cd'); if(sk) ts=parseInt(sk);
    setInterval(function(){ ts--; if(ts<=0){ ce.textContent='EXPIRED'; return; } var h=Math.floor(ts/3600), m=Math.floor((ts%3600)/60), s=ts%60; ce.textContent=h+'h '+(m<10?'0':'')+m+'m '+(s<10?'0':'')+s+'s'; sessionStorage.setItem('pdpv31_cd',ts); },1000);
  }

  if('IntersectionObserver' in window){
    var ro=new IntersectionObserver(function(es){ es.forEach(function(e){ var v=e.target.querySelector('video'); if(v){ e.isIntersecting?v.play():v.pause(); } }); },{threshold:0.5});
    document.querySelectorAll('.pdpv31__reel').forEach(function(r){ ro.observe(r); });
  }

  var RK='pdpv31_rv', cp={handle:'{{ product.handle }}',title:'{{ product.title | escape }}',price:'{{ product.price | money }}',image:'{{ product.featured_image | image_url: width: 400 }}',url:'{{ product.url }}'};
  try{ var its=JSON.parse(localStorage.getItem(RK)||'[]'); its=its.filter(function(i){ return i.handle!==cp.handle; }); its.unshift(cp); if(its.length>8) its=its.slice(0,8); localStorage.setItem(RK,JSON.stringify(its)); }catch(e){}
  try{
    var its2=JSON.parse(localStorage.getItem(RK)||'[]').filter(function(i){ return i.handle!==cp.handle; });
    var c=document.getElementById('pdpv31-rv'), g=document.getElementById('pdpv31-rvg');
    if(g&&its2.length>0){ c.classList.add('has'); var h=''; its2.slice(0,4).forEach(function(i){ h+='<a href="'+i.url+'" class="pdpv31__pcard"><img src="'+i.image+'" alt="'+i.title+'" loading="lazy"><div class="pdpv31__pcard-info"><div class="pdpv31__pcard-title">'+i.title+'</div><div class="pdpv31__pcard-price">'+i.price+'</div></div></a>'; }); g.innerHTML=h; }
  }catch(e){}
})();
</script>

{% schema %}
{
  "name": "PDP V31 — Neon Cyber-Pop",
  "tag": "section",
  "class": "pdpv31-section",
  "settings": [
    { "type": "header", "content": "Rating" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "text", "id": "rating_val", "label": "Rating score", "default": "4.99" },
    { "type": "text", "id": "rev_count", "label": "Total reviews", "default": "2,280" },
    { "type": "header", "content": "Offer Banner" },
    { "type": "checkbox", "id": "show_offer", "label": "Show offer", "default": true },
    { "type": "text", "id": "offer_text", "label": "Offer text", "default": "⚡ NEON CYBER-POP: ENJOY 20% DISCOUNT WITH CODE 'NEON20'" },
    { "type": "header", "content": "Promo" },
    { "type": "checkbox", "id": "show_promo", "label": "Show promo", "default": true },
    { "type": "text", "id": "promo_code", "label": "Code", "default": "NEON20" },
    { "type": "text", "id": "promo_disc", "label": "Discount", "default": "20%" },
    { "type": "header", "content": "Urgency" },
    { "type": "checkbox", "id": "show_urgency", "label": "Show urgency", "default": true },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown", "default": true },
    { "type": "range", "id": "cd_hrs", "label": "Countdown hours", "min": 1, "max": 48, "default": 6 },
    { "type": "header", "content": "Accordion" },
    { "type": "richtext", "id": "holo_specs", "label": "Build & material telemetry" },
    { "type": "header", "content": "FBT" },
    { "type": "collection", "id": "fbt_coll", "label": "FBT collection" },
    { "type": "header", "content": "Reels" },
    { "type": "checkbox", "id": "show_reels", "label": "Show reels", "default": true },
    { "type": "url", "id": "r1", "label": "Reel 1 URL" },
    { "type": "url", "id": "r2", "label": "Reel 2 URL" },
    { "type": "url", "id": "r3", "label": "Reel 3 URL" },
    { "type": "header", "content": "Reviews" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show reviews", "default": true },
    { "type": "text", "id": "rv1", "label": "Review 1", "default": "Absolute perfection! The neon aesthetics are stunning." },
    { "type": "text", "id": "rv1n", "label": "Author 1", "default": "Roxie L." },
    { "type": "text", "id": "rv2", "label": "Review 2", "default": "Ultra fast delivery and high cyber quality." },
    { "type": "text", "id": "rv2n", "label": "Author 2", "default": "Dexter P." },
    { "type": "text", "id": "rv3", "label": "Review 3", "default": "Best neon product experience ever." },
    { "type": "text", "id": "rv3n", "label": "Author 3", "default": "Vesper T." },
    { "type": "header", "content": "Featured" },
    { "type": "collection", "id": "feat_coll", "label": "Featured collection" }
  ],
  "presets": [{ "name": "PDP V31 — Neon Cyber-Pop" }]
}
{% endschema %}