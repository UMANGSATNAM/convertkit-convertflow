<!-- ── JAVASCRIPT: TITAN ENGINE ── -->
<script>
(function() {
  window.switchTitanImage = function(sectionId, imgSrc, btn) {
    var img = document.getElementById('titan-active-img-' + sectionId);
    if (img) {
      img.style.opacity = '0.35';
      setTimeout(function() {
        img.src = imgSrc;
        img.style.opacity = '1';
      }, 120);
    }
    var sec = document.getElementById('titan-pdp-' + sectionId);
    if (sec) {
      var all = sec.querySelectorAll('.titan-thumb-btn');
      all.forEach(function(el) { el.classList.remove('is-active'); });
    }
    if (btn) btn.classList.add('is-active');
  };

  window.selectTitanFinish = function(sectionId, finish, btn) {
    var sec = document.getElementById('titan-pdp-' + sectionId);
    if (!sec) return;
    var all = sec.querySelectorAll('.titan-finish-chip');
    all.forEach(function(b) { b.classList.remove('is-active'); });
    btn.classList.add('is-active');

    var label = document.getElementById('titan-finish-name-' + sectionId);
    if (label) label.innerText = finish;
  };

  var basePrice = 29999;
  window.toggleTitanShield = function(sectionId, shieldAddon) {
    var chk = document.getElementById('titan-shield-check-' + sectionId);
    if (!chk) return;
    chk.checked = !chk.checked;
    
    var totalPrice = chk.checked ? (basePrice + shieldAddon) : basePrice;
    var formatted = '₹' + totalPrice.toLocaleString('en-IN');

    var pDisplay = document.getElementById('titan-display-price-' + sectionId);
    var btnPrice = document.getElementById('titan-btn-price-' + sectionId);
    var stickyPrice = document.getElementById('titan-sticky-price-' + sectionId);

    if (pDisplay) pDisplay.innerText = formatted;
    if (btnPrice) btnPrice.innerText = formatted;
    if (stickyPrice) stickyPrice.innerText = formatted;

    var upsellBox = chk.closest('.titan-shield-upsell');
    if (upsellBox) {
      if (chk.checked) {
        upsellBox.style.borderColor = '#38bdf8';
        upsellBox.style.background = 'rgba(56, 189, 248, 0.1)';
      } else {
        upsellBox.style.borderColor = 'rgba(56, 189, 248, 0.3)';
        upsellBox.style.background = 'rgba(56, 189, 248, 0.04)';
      }
    }
  };

  window.toggleTitanAcc = function(btn) {
    var item = btn.closest('.titan-acc-item');
    if (item) item.classList.toggle('is-open');
  };

  window.checkTitanPincode = function(sectionId) {
    var input = document.getElementById('titan-pincode-' + sectionId);
    var res = document.getElementById('titan-pincode-result-' + sectionId);
    if (!input || !res) return;
    var code = input.value.trim();
    if (code.length === 6 && /^\d+$/.test(code)) {
      res.innerHTML = '<span style="color: #38bdf8; font-weight: 700;">Guaranteed Next-Day Air Express to ' + code + ' with insured tamper-proof vault seal. COD Available!</span>';
    } else {
      res.innerHTML = '<span style="color: #f87171; font-weight: 600;">Please enter a valid 6-digit postal pincode.</span>';
    }
  };

  window.handleTitanATC = function(sectionId) {
    var btn = document.getElementById('titan-atc-btn-' + sectionId);
    if (!btn) return;
    var original = btn.innerHTML;
    btn.innerHTML = '<span>RESERVING VAULT ALLOCATION...</span>';
    btn.style.opacity = '0.7';

    setTimeout(function() {
      btn.innerHTML = '<span style="color:#7dd3fc;">HARDWARE ALLOCATED TO BAG</span>';
      btn.style.opacity = '1';
      setTimeout(function() {
        btn.innerHTML = original;
      }, 2400);
    }, 600);
  };

  window.handleTitanCOD = function(sectionId) {
    alert('Titan Doorstep Verification activated! Your unit is locked in batch allocation with doorstep unboxing.');
  };

  // Live countdown timer
  document.addEventListener('DOMContentLoaded', function() {
    var timerEl = document.getElementById('titan-timer-' + '{{ section.id }}');
    if (timerEl) {
      var sec = 585;
      setInterval(function() {
        if (sec > 0) {
          sec--;
          var m = Math.floor(sec / 60);
          var s = sec % 60;
          timerEl.innerText = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
        }
      }, 1000);
    }

    var bar = document.querySelector('.titan-sticky-bar');
    if (!bar) return;
    window.addEventListener('scroll', function() {
      if (window.scrollY > 400) {
        bar.classList.add('is-visible');
      } else {
        bar.classList.remove('is-visible');
      }
    });
  });
})();
</script>

