{% comment %}
  Titan Vault PDP Buy Box
  High-AOV Luxury Electronics, Smart Hardware & Gadgets Buy Box
  1000cr Architecture • Zero Emojis • 100% Vector SVGs • Precision Engineering
{% endcomment %}

{%- liquid
  assign p = section.settings.product | default: product
  assign has_real_product = false
  if p != blank and p.title != blank
    assign has_real_product = true
    assign p_title = p.title
    assign p_price = p.price
    assign p_compare_at = p.compare_at_price
    assign p_desc = p.description
  else
    assign p_title = section.settings.title | default: "Titan Apex Titanium Wireless ANC Headphones"
    assign p_price = 2999900
    assign p_compare_at = 3999900
    assign p_desc = "Precision-milled from Grade 5 Aerospace Titanium with 45dB adaptive hybrid noise cancellation, beryllium acoustic drivers, and 48-hour continuous playback stamina."
  endif
-%}

<div 
  class="titan-pdp-section" 
  id="titan-pdp-{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="
    --tt-bg: {{ section.settings.bg_color | default: '#0a0f1d' }};
    --tt-card-bg: {{ section.settings.card_bg | default: '#0f172a' }};
    --tt-border: {{ section.settings.border_color | default: '#1e293b' }};
    --tt-text: {{ section.settings.text_color | default: '#f8fafc' }};
    --tt-muted: {{ section.settings.muted_color | default: '#94a3b8' }};
    --tt-cyan: {{ section.settings.cyan_color | default: '#38bdf8' }};
    --tt-cyan-glow: rgba(56, 189, 248, 0.15);
  "
>
  <div class="titan-container">
    
    <!-- ── LEFT COLUMN: PRECISION HARDWARE GALLERY ── -->
    <div class="titan-gallery-col">
      <div class="titan-image-card">
        <!-- Live Batch & Reservation Badge -->
        <div class="titan-badges-top">
          <div class="titan-pulse-badge">
            <span class="titan-pulse-dot"></span>
            <span>Batch 04 • Limited Allocation</span>
          </div>
          <span class="titan-spec-stamp">CNC Grade 5 Titanium</span>
        </div>

        <div class="titan-img-wrap">
          <img 
            id="titan-active-img-{{ section.id }}"
            class="titan-active-img"
            src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=1200&q=85" 
            alt="{{ p_title | escape }}"
            loading="eager"
          />
        </div>

        <!-- Audio Architecture Spec Strip -->
        <div class="titan-spec-bar">
          <div class="titan-spec-chip">40mm Pure Beryllium</div>
          <div class="titan-spec-chip">Hi-Res LDAC Wireless</div>
          <div class="titan-spec-chip">Spatial Dolby Atmos</div>
        </div>
      </div>

      <!-- Thumbs Strip -->
      <div class="titan-thumbs-row">
        <button 
          type="button" 
          class="titan-thumb-btn is-active" 
          onclick="window.switchTitanImage('{{ section.id }}', 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=1200&q=85', this)"
        >
          <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=240&q=75" alt="Front profile" />
        </button>
        <button 
          type="button" 
          class="titan-thumb-btn" 
          onclick="window.switchTitanImage('{{ section.id }}', 'https://images.unsplash.com/photo-1583394838336-acd977736f90?auto=format&fit=crop&w=1200&q=85', this)"
        >
          <img src="https://images.unsplash.com/photo-1583394838336-acd977736f90?auto=format&fit=crop&w=240&q=75" alt="Side cups" />
        </button>
        <button 
          type="button" 
          class="titan-thumb-btn" 
          onclick="window.switchTitanImage('{{ section.id }}', 'https://images.unsplash.com/photo-1546435770-a3e426bf472b?auto=format&fit=crop&w=1200&q=85', this)"
        >
          <img src="https://images.unsplash.com/photo-1546435770-a3e426bf472b?auto=format&fit=crop&w=240&q=75" alt="Titanium milled" />
        </button>
      </div>

      <!-- Key Engineering Metrics Grid -->
      <div class="titan-metrics-grid">
        <div class="titan-metric-box">
          <div class="titan-metric-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="16" height="10" rx="2" ry="2"/><line x1="22" y1="11" x2="22" y2="13"/></svg>
          </div>
          <div class="titan-metric-val">48 Hours</div>
          <div class="titan-metric-lbl">Battery Stamina</div>
        </div>

        <div class="titan-metric-box">
          <div class="titan-metric-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
          </div>
          <div class="titan-metric-val">-45 dB</div>
          <div class="titan-metric-lbl">Adaptive Hybrid ANC</div>
        </div>

        <div class="titan-metric-box">
          <div class="titan-metric-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="titan-metric-val">IP68</div>
          <div class="titan-metric-lbl">Water & Dust Proof</div>
        </div>

        <div class="titan-metric-box">
          <div class="titan-metric-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <div class="titan-metric-val">0.02s</div>
          <div class="titan-metric-lbl">Ultra-Low Latency</div>
        </div>
      </div>
    </div>

    <!-- ── RIGHT COLUMN: BUY BOX & SCARCITY ── -->
    <div class="titan-buybox-col">
      <div class="titan-buybox-card">
        
        <!-- Header & Countdown -->
        <div class="titan-header-group">
          <div class="titan-eyebrow-row">
            <span class="titan-eyebrow-text">TITAN ADVANCED HARDWARE LABS</span>
            <div class="titan-stars-box">
              <div class="titan-stars">
                {%- for i in (1..5) -%}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="#38bdf8"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- endfor -%}
              </div>
              <span class="titan-stars-text">4.98 / 5.0 (642 Verified Owners)</span>
            </div>
          </div>

          <h1 class="titan-product-title">{{ p_title }}</h1>
          <p class="titan-product-desc">{{ p_desc }}</p>

          <!-- Price & Savings -->
          <div class="titan-price-bar">
            <div class="titan-price-main">
              <span class="titan-current-price" id="titan-display-price-{{ section.id }}">
                {%- if has_real_product -%}{{ p_price | money }}{%- else -%}₹29,999{%- endif -%}
              </span>
              <span class="titan-compare-price" id="titan-display-compare-{{ section.id }}">
                {%- if has_real_product and p_compare_at > p_price -%}{{ p_compare_at | money }}{%- else -%}₹39,999{%- endif -%}
              </span>
            </div>
            <span class="titan-save-badge">
              SAVE ₹10,000 (25% LAUNCH DISCOUNT)
            </span>
          </div>
        </div>

        <!-- ── REAL-TIME SCARCITY & VAULT TIMER ── -->
        <div class="titan-scarcity-box">
          <div class="titan-scarcity-top">
            <div class="titan-scarcity-left">
              <span class="titan-live-pulse-dot"></span>
              <span class="titan-scarcity-count">
                <strong>High Demand:</strong> Only <strong>6 units</strong> remain in current batch
              </span>
            </div>
            <div class="titan-countdown-clock">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>Lock: <strong id="titan-timer-{{ section.id }}">09:45</strong></span>
            </div>
          </div>
          <div class="titan-meter-track">
            <div class="titan-meter-fill" style="width: 86%;"></div>
          </div>
        </div>

        <!-- ── ALLOY FINISH SELECTOR ── -->
        <div class="titan-finishes-section">
          <div class="titan-section-heading">
            <span>Select Aerospace Finish:</span>
            <span class="titan-selected-name" id="titan-finish-name-{{ section.id }}">DLC Stealth Obsidian</span>
          </div>
          <div class="titan-finishes-grid">
            <button 
              type="button" 
              class="titan-finish-chip is-active" 
              onclick="window.selectTitanFinish('{{ section.id }}', 'DLC Stealth Obsidian', this)"
            >
              <span class="titan-finish-swatch" style="background: #0f172a; border: 1px solid #334155;"></span>
              <span>DLC Stealth Obsidian</span>
            </button>
            <button 
              type="button" 
              class="titan-finish-chip" 
              onclick="window.selectTitanFinish('{{ section.id }}', 'Aerospace Platinum', this)"
            >
              <span class="titan-finish-swatch" style="background: #cbd5e1;"></span>
              <span>Aerospace Platinum</span>
            </button>
            <button 
              type="button" 
              class="titan-finish-chip" 
              onclick="window.selectTitanFinish('{{ section.id }}', 'Cyber Electric Cobalt', this)"
            >
              <span class="titan-finish-swatch" style="background: #0284c7;"></span>
              <span>Cyber Cobalt</span>
            </button>
          </div>
        </div>

        <!-- ── HIGH-AOV UPSELL: 2-YEAR TITAN SHIELD CARE ── -->
        <div class="titan-shield-upsell">
          <label class="titan-shield-label" onclick="window.toggleTitanShield('{{ section.id }}', 1499)">
            <input type="checkbox" id="titan-shield-check-{{ section.id }}" class="titan-shield-checkbox" />
            <div class="titan-shield-content">
              <div class="titan-shield-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <div class="titan-shield-text">
                <div class="titan-shield-title">Add 2-Year Titan Shield Care (+₹1,499)</div>
                <div class="titan-shield-desc">Zero-deductible accidental damage repair, water immersion, and battery replacement.</div>
              </div>
            </div>
            <div class="titan-shield-add-pill">+ ADD CARE</div>
          </label>
        </div>

        <!-- ── ACTION CTA BUTTONS ── -->
        <div class="titan-actions-group">
          <button 
            type="button" 
            class="titan-primary-atc-btn" 
            id="titan-atc-btn-{{ section.id }}"
            onclick="window.handleTitanATC('{{ section.id }}')"
          >
            <span class="titan-atc-txt">CLAIM HARDWARE FROM VAULT</span>
            <span class="titan-atc-sep">•</span>
            <span class="titan-atc-price" id="titan-btn-price-{{ section.id }}">₹29,999</span>
          </button>

          <!-- 1-Click COD Option -->
          <button 
            type="button" 
            class="titan-cod-btn" 
            onclick="window.handleTitanCOD('{{ section.id }}')"
          >
            <div class="titan-cod-left">
              <span class="titan-cod-icon">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              </span>
              <div>
                <div class="titan-cod-title">CASH ON DELIVERY (DOORSTEP UNBOXING)</div>
                <div class="titan-cod-sub">Inspect hardware serial at doorstep before cash payment • Free Shipping</div>
              </div>
            </div>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>

        <!-- ── PINCODE AIR DISPATCH ESTIMATOR ── -->
        <div class="titan-pincode-card">
          <div class="titan-pincode-title">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Air Express Courier Dispatch Calculator</span>
          </div>
          <div class="titan-pincode-row">
            <input 
              type="text" 
              id="titan-pincode-{{ section.id }}" 
              class="titan-pincode-input" 
              placeholder="Enter 6-digit Pincode (e.g. 560001)"
              maxlength="6"
            />
            <button type="button" class="titan-pincode-btn" onclick="window.checkTitanPincode('{{ section.id }}')">
              Calculate SLA
            </button>
          </div>
          <div class="titan-pincode-result" id="titan-pincode-result-{{ section.id }}">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Enter destination postal code for guaranteed air courier timeline</span>
          </div>
        </div>

        <!-- ── 4 PRECISION TRUST PILLARS ── -->
        <div class="titan-trust-grid">
          <div class="titan-trust-item">
            <div class="titan-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <div class="titan-trust-head">2-Year Full Warranty</div>
              <div class="titan-trust-sub">Direct hardware replacement guarantee</div>
            </div>
          </div>

          <div class="titan-trust-item">
            <div class="titan-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <div>
              <div class="titan-trust-head">Next-Day Air Shipping</div>
              <div class="titan-trust-sub">Dispatched via express priority aviation</div>
            </div>
          </div>

          <div class="titan-trust-item">
            <div class="titan-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <div>
              <div class="titan-trust-head">30-Day Risk-Free Trial</div>
              <div class="titan-trust-sub">Try in your studio with full refunds</div>
            </div>
          </div>

          <div class="titan-trust-item">
            <div class="titan-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            </div>
            <div>
              <div class="titan-trust-head">256-Bit Encrypted Payments</div>
              <div class="titan-trust-sub">UPI • Cards • NetBanking • Doorstep Cash</div>
            </div>
          </div>
        </div>

        <!-- ── HARDWARE ACCORDIONS ── -->
        <div class="titan-accordions-group">
          <div class="titan-acc-item is-open">
            <button type="button" class="titan-acc-header" onclick="window.toggleTitanAcc(this)">
              <div class="titan-acc-title-wrap">
                <span class="titan-acc-bullet">
                  <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6"/></svg>
                </span>
                <span class="titan-acc-title">Technical Specifications Matrix</span>
              </div>
              <span class="titan-acc-indicator">+</span>
            </button>
            <div class="titan-acc-body">
              <ul class="titan-specs-list">
                <li><strong>Drivers:</strong> 40mm Custom Beryllium-Coated Dynamic Transducers</li>
                <li><strong>Frequency Response:</strong> 5 Hz – 45,000 Hz (Ultra-Wide Acoustic Bandwidth)</li>
                <li><strong>Noise Cancellation:</strong> 4-Mic Hybrid Adaptive ANC with Transparency Mode</li>
                <li><strong>Connectivity:</strong> Bluetooth 5.4 Low Latency + 3.5mm Analog Audio Bypass</li>
                <li><strong>Weight:</strong> 248g (Optimized Ergonomic Balance)</li>
              </ul>
            </div>
          </div>

          <div class="titan-acc-item">
            <button type="button" class="titan-acc-header" onclick="window.toggleTitanAcc(this)">
              <div class="titan-acc-title-wrap">
                <span class="titan-acc-bullet">
                  <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6"/></svg>
                </span>
                <span class="titan-acc-title">What's in the Vault Box</span>
              </div>
              <span class="titan-acc-indicator">+</span>
            </button>
            <div class="titan-acc-body">
              <p>Includes Titan Apex Headphones, Magnetic Hard-Shell Magnetic Travel Vault, Braided 1.8m USB-C Fast Charging Cable, 3.5mm Gold-Plated Audio Cable, Flight Adapter, and Certificate of Authenticity with Individual Serial Number.</p>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- ── FLOATING STICKY ATC BAR ON SCROLL ── -->
  <div class="titan-sticky-bar" id="titan-sticky-bar-{{ section.id }}">
    <div class="titan-sticky-inner">
      <div class="titan-sticky-left">
        <img 
          src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=120&q=80" 
          alt="{{ p_title | escape }}" 
          class="titan-sticky-thumb" 
        />
        <div>
          <div class="titan-sticky-title">{{ p_title }}</div>
          <div class="titan-sticky-sub">
            <span class="titan-sticky-price" id="titan-sticky-price-{{ section.id }}">₹29,999</span>
            <span class="titan-sticky-tag">Air Priority • 6 Units in Batch</span>
          </div>
        </div>
      </div>
      <button 
        type="button" 
        class="titan-sticky-cta" 
        onclick="window.handleTitanATC('{{ section.id }}')"
      >
        <span>CLAIM HARDWARE</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>

</div>

<!-- ── STYLES: PRECISION AEROSPACE TECH LUXURY ── -->
<style>
  .titan-pdp-section {
    background: var(--tt-bg);
    color: var(--tt-text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
    padding: 32px 20px 80px 20px;
    box-sizing: border-box;
    position: relative;
    border-bottom: 1px solid var(--tt-border);
  }

  .titan-container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 48px;
    align-items: flex-start;
  }

  @media (max-width: 1024px) {
    .titan-container {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  /* ── Gallery Column ── */
  .titan-gallery-col {
    position: sticky;
    top: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .titan-image-card {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 4.4;
    border-radius: 12px;
    overflow: hidden;
    background: #0f172a;
    border: 1px solid var(--tt-border);
  }

  .titan-img-wrap {
    width: 100%;
    height: 100%;
  }

  .titan-active-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: opacity 0.2s ease;
    display: block;
  }

  .titan-badges-top {
    position: absolute;
    top: 14px;
    left: 14px;
    right: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 2;
  }

  .titan-pulse-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: var(--tt-cyan);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 9px;
    border-radius: 4px;
  }

  .titan-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tt-cyan);
    box-shadow: 0 0 8px var(--tt-cyan);
  }

  .titan-spec-stamp {
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--tt-border);
    color: var(--tt-muted);
    font-size: 10px;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 4px;
  }

  .titan-spec-bar {
    position: absolute;
    bottom: 0;
    inset-inline: 0;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--tt-border);
    padding: 10px 14px;
    display: flex;
    gap: 8px;
    overflow-x: auto;
  }

  .titan-spec-chip {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--tt-text);
    font-size: 10px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .titan-thumbs-row {
    display: flex;
    gap: 10px;
  }

  .titan-thumb-btn {
    width: 76px;
    height: 76px;
    border-radius: 8px;
    overflow: hidden;
    border: 1.5px solid var(--tt-border);
    padding: 0;
    background: #0f172a;
    cursor: pointer;
    opacity: 0.65;
    transition: all 0.15s ease;
  }

  .titan-thumb-btn.is-active,
  .titan-thumb-btn:hover {
    opacity: 1;
    border-color: var(--tt-cyan);
  }

  .titan-thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Metrics Grid ── */
  .titan-metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
