{%- comment -%}
  PDP V25: JEWELRY & ACCESSORIES
  Aesthetic: Elegant, sparkling, soft champagne/blush tones, delicate serif.
  Features: Pincode Checker, Product Reels (sparkle focus), Gifting Upsell, Sticky ATC.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign random_stock = 'now' | date: '%s' | modulo: 4 | plus: 1 -%}
{%- assign random_viewers = 'now' | date: '%s' | modulo: 15 | plus: 5 -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap');

  :root {
    --v25-bg: #FCFAFA; /* Soft blush white */
    --v25-text: #332B2B; /* Deep charcoal with warm undertone */
    --v25-text-light: #8E8383;
    --v25-primary: #D4AF37; /* Gold */
    --v25-accent: #F4E8E8; /* Blush pink */
    --v25-border: #E8DCDC;
    --v25-font-heading: 'Cormorant Garamond', serif;
    --v25-font-body: 'Montserrat', sans-serif;
  }

  .pdp-v25 {
    background-color: var(--v25-bg);
    color: var(--v25-text);
    font-family: var(--v25-font-body);
    line-height: 1.6;
  }

  .pdp-v25__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    display: grid;
    gap: 30px;
  }
  @media (min-width: 992px) {
    .pdp-v25__container { grid-template-columns: 1.2fr 1fr; gap: 60px; padding: 60px 20px; }
  }

  /* --- GALLERY --- */
  .pdp-v25__gallery {
    display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 10px;
  }
  @media (min-width: 992px) {
    .pdp-v25__gallery { display: grid; grid-template-columns: 1fr 1fr; overflow-x: visible; }
  }
  .pdp-v25__img-wrap { min-width: 85%; scroll-snap-align: start; }
  @media (min-width: 992px) { .pdp-v25__img-wrap { min-width: 100%; } }
  .pdp-v25__gallery img, .pdp-v25__gallery svg { width: 100%; aspect-ratio: 1; object-fit: cover; background: #F0EDED; }

  /* --- INFO --- */
  .pdp-v25__title {
    font-family: var(--v25-font-heading);
    font-size: 38px; font-weight: 400; margin: 0 0 8px 0; color: var(--v25-text); line-height: 1.2;
  }
  
  .pdp-v25__price-wrap {
    display: flex; align-items: center; gap: 16px; margin-bottom: 24px;
  }
  .pdp-v25__price { font-family: var(--v25-font-heading); font-size: 28px; font-weight: 600; color: var(--v25-text); }
  .pdp-v25__compare { font-size: 16px; color: var(--v25-text-light); text-decoration: line-through; }

  /* --- URGENCY --- */
  .pdp-v25__urgency {
    display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 500; color: #A05252; margin-bottom: 24px; padding: 12px; background: var(--v25-accent); border-radius: 4px;
  }

  /* --- VARIANTS (METAL TYPE) --- */
  .pdp-v25__variants { margin-bottom: 30px; }
  .pdp-v25__v-head { font-size: 12px; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 12px; color: var(--v25-text-light); }
  .pdp-v25__v-grid { display: flex; gap: 12px; }
  .pdp-v25__v-item {
    width: 40px; height: 40px; border-radius: 50%;
    cursor: pointer; border: 1px solid var(--v25-border); padding: 3px;
    transition: all 0.3s;
  }
  .pdp-v25__v-item.active { border-color: var(--v25-text); }
  .pdp-v25__v-inner { width: 100%; height: 100%; border-radius: 50%; }
  .pdp-v25__v-inner.gold { background: linear-gradient(135deg, #F3E5AB 0%, #D4AF37 100%); }
  .pdp-v25__v-inner.silver { background: linear-gradient(135deg, #E0E0E0 0%, #BDBDBD 100%); }
  .pdp-v25__v-inner.rosegold { background: linear-gradient(135deg, #FADADD 0%, #B76E79 100%); }

  /* --- GIFTING --- */
  .pdp-v25__gift {
    border: 1px solid var(--v25-primary); padding: 16px; border-radius: 4px; margin-bottom: 30px; display: flex; gap: 12px; align-items: center;
  }
  .pdp-v25__gift-check { accent-color: var(--v25-primary); width: 18px; height: 18px; }
  .pdp-v25__gift-text { font-size: 14px; font-weight: 500; }
  .pdp-v25__gift-sub { font-size: 12px; color: var(--v25-text-light); }

  /* --- PINCODE CHECKER --- */
  .pdp-v25__pincode { margin-bottom: 30px; }
  .pdp-v25__pin-title { font-size: 12px; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--v25-text-light); }
  .pdp-v25__pin-input-wrap { display: flex; border-bottom: 1px solid var(--v25-border); padding-bottom: 8px; }
  .pdp-v25__pin-input { flex: 1; background: transparent; border: none; font-family: var(--v25-font-body); font-size: 14px; outline: none; color: var(--v25-text); }
  .pdp-v25__pin-btn { background: transparent; color: var(--v25-primary); border: none; font-weight: 500; font-size: 13px; cursor: pointer; text-transform: uppercase; letter-spacing: 1px; }
  .pdp-v25__pin-msg { margin-top: 12px; font-size: 13px; color: #188038; display: none; font-style: italic; }

  /* --- ATC --- */
  .pdp-v25__atc {
    width: 100%; background: var(--v25-text); color: #FFF; border: none; padding: 18px; font-size: 14px; font-weight: 400; cursor: pointer; margin-bottom: 16px; font-family: var(--v25-font-body); letter-spacing: 2px; text-transform: uppercase; transition: background 0.3s;
  }
  .pdp-v25__atc:hover { background: #000; }
  .pdp-v25__secure { display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 12px; color: var(--v25-text-light); margin-bottom: 40px; }
  .pdp-v25__secure svg { width: 14px; height: 14px; }

  /* --- ACCORDION --- */
  .pdp-v25__accordion { border-top: 1px solid var(--v25-border); border-bottom: 1px solid var(--v25-border); }
  .pdp-v25__acc-item { border-bottom: 1px solid var(--v25-border); }
  .pdp-v25__acc-item:last-child { border-bottom: none; }
  .pdp-v25__acc-head { padding: 16px 0; display: flex; justify-content: space-between; cursor: pointer; font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 1px; }
  .pdp-v25__acc-content { padding-bottom: 16px; font-size: 14px; color: var(--v25-text-light); font-weight: 300; line-height: 1.8; }

  /* --- PRODUCT REELS --- */
  .pdp-v25__reels-wrap { margin-bottom: 60px; margin-top: 60px; }
  .pdp-v25__reels-title { font-family: var(--v25-font-heading); font-size: 32px; margin-bottom: 24px; text-align: center; }
  .pdp-v25__reels { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 10px; justify-content: center; }
  .pdp-v25__reel { min-width: 200px; max-width: 300px; aspect-ratio: 9/16; background: #F0EDED; position: relative; scroll-snap-align: center; flex: 1; border-radius: 4px; overflow: hidden; }
  .pdp-v25__reel img, .pdp-v25__reel svg { width: 100%; height: 100%; object-fit: cover; }
  .pdp-v25__reel-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 50px; height: 50px; border: 1px solid #FFF; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #FFF; background: rgba(255,255,255,0.2); backdrop-filter: blur(2px); cursor: pointer; }

  /* --- TRUST BADGES --- */
  .pdp-v25__trust { display: flex; justify-content: center; gap: 40px; text-align: center; margin-bottom: 60px; }
  .pdp-v25__t-item svg { width: 32px; height: 32px; color: var(--v25-primary); margin-bottom: 12px; }
  .pdp-v25__t-item span { display: block; font-size: 12px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; }

  /* --- GRIDS --- */
  .pdp-v25__section { padding: 0 20px 80px 20px; max-width: 1200px; margin: 0 auto; }
  .pdp-v25__sec-title { font-family: var(--v25-font-heading); font-size: 32px; margin-bottom: 30px; text-align: center; }
  .pdp-v25__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (min-width: 768px) { .pdp-v25__grid { grid-template-columns: repeat(4, 1fr); gap: 30px; } }
  .pdp-v25__card { text-align: center; }
  .pdp-v25__card img { width: 100%; aspect-ratio: 1; object-fit: cover; margin-bottom: 16px; background: #F0EDED; }
  .pdp-v25__card-title { font-size: 14px; font-weight: 400; margin-bottom: 8px; font-family: var(--v25-font-heading); }
  .pdp-v25__card-price { font-weight: 500; color: var(--v25-text); font-size: 14px; }

</style>

<div class="pdp-v25" data-section="{{ section.id }}">
  <div class="pdp-v25__container">
    
    <!-- GALLERY -->
    <div class="pdp-v25__gallery">
      {% if product.featured_media %}
        {% for media in product.media limit: 4 %}
          <div class="pdp-v25__img-wrap"><img src="{{ media | image_url: width: 800 }}" alt="{{ product.title }}"></div>
        {% endfor %}
      {% else %}
        <div class="pdp-v25__img-wrap">{{ 'product-1' | placeholder_svg_tag }}</div>
        <div class="pdp-v25__img-wrap">{{ 'product-2' | placeholder_svg_tag }}</div>
        <div class="pdp-v25__img-wrap">{{ 'product-3' | placeholder_svg_tag }}</div>
        <div class="pdp-v25__img-wrap">{{ 'product-4' | placeholder_svg_tag }}</div>
      {% endif %}
    </div>

    <!-- INFO -->
    <div class="pdp-v25__info">
      <h1 class="pdp-v25__title">{{ product.title | default: "Solitaire Diamond Pendant" }}</h1>
      
      <div class="pdp-v25__price-wrap">
        <span class="pdp-v25__price">{{ current_variant.price | money | default: "₹24,999" }}</span>
        {% if current_variant.compare_at_price > current_variant.price %}
          <span class="pdp-v25__compare">{{ current_variant.compare_at_price | money }}</span>
        {% endif %}
      </div>

      {% if section.settings.show_urgency %}
        <div class="pdp-v25__urgency">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
          {{ random_viewers }} people are viewing this right now. Only {{ random_stock }} left in stock.
        </div>
      {% endif %}

      <div class="pdp-v25__variants">
        <div class="pdp-v25__v-head">Select Metal Color</div>
        <div class="pdp-v25__v-grid">
          <div class="pdp-v25__v-item active"><div class="pdp-v25__v-inner gold"></div></div>
          <div class="pdp-v25__v-item"><div class="pdp-v25__v-inner silver"></div></div>
          <div class="pdp-v25__v-item"><div class="pdp-v25__v-inner rosegold"></div></div>
        </div>
      </div>

      <div class="pdp-v25__gift">
        <input type="checkbox" class="pdp-v25__gift-check" id="v25-gift">
        <div>
          <div class="pdp-v25__gift-text">Make it a Gift (+₹500)</div>
          <div class="pdp-v25__gift-sub">Includes premium velvet box & personalized note.</div>
        </div>
      </div>

      {% if section.settings.show_pincode %}
        <div class="pdp-v25__pincode">
          <div class="pdp-v25__pin-title">Check Delivery</div>
          <div class="pdp-v25__pin-input-wrap">
            <input type="text" class="pdp-v25__pin-input" id="v25-pin" placeholder="Enter Pincode" maxlength="6">
            <button class="pdp-v25__pin-btn" onclick="document.getElementById('v25-pin-msg').style.display='block'">Verify</button>
          </div>
          <div class="pdp-v25__pin-msg" id="v25-pin-msg">Insured delivery available to your location.</div>
        </div>
      {% endif %}

      
      <!-- D2C SCARCITY & NOTIFY -->
      {% if product.available %}
        <div style="background:#FFF3E0; border:1px solid #FFCC80; padding:10px; border-radius:8px; margin-bottom:12px; display:flex; align-items:center; gap:12px;">
          <svg style="width:24px; height:24px; color:#E65100; flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <div style="font-size:13px; color:#E65100;">
            <div style="font-weight:700;">Limited Time Offer Ends In:</div>
            <div style="font-size:16px; font-weight:700; margin-top:2px;"><b>{% render 'countdown-timer', product: product %}</b></div>
          </div>
        </div>
      {% endif %}

      {% render 'back-in-stock', product: product %}

      {% if product.available %}
      <button class="pdp-v25__atc" id="v25-atc">Add to Shopping Bag</button>
      {% else %}
      <button class="pdp-v25__atc" disabled style="opacity:0.5; cursor:not-allowed;">SOLD OUT</button>
      {% endif %}
      <div class="pdp-v25__secure">
        <svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path></svg>
        100% Secure Checkout & Insured Shipping
      </div>

      <div class="pdp-v25__accordion">
        <div class="pdp-v25__acc-item">
          <div class="pdp-v25__acc-head">Details & Specifications <span>+</span></div>
          <div class="pdp-v25__acc-content">
            {{ product.description | strip_html | default: "Handcrafted in 18k solid gold. Features a 0.5 carat ethically sourced diamond (VVS clarity, F color). Chain length is adjustable from 16 to 18 inches." }}
          </div>
        </div>
        <div class="pdp-v25__acc-item">
          <div class="pdp-v25__acc-head">Shipping & Returns <span>+</span></div>
        </div>
        <div class="pdp-v25__acc-item">
          <div class="pdp-v25__acc-head">Care Guide <span>+</span></div>
        </div>
      </div>

    </div>
  </div>

  {% if section.settings.show_reels %}
    <div class="pdp-v25__reels-wrap">
      <h2 class="pdp-v25__reels-title">See The Sparkle</h2>
      <div class="pdp-v25__reels">
        <div class="pdp-v25__reel">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
          <div class="pdp-v25__reel-play"><svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
        </div>
        <div class="pdp-v25__reel">
          {{ 'lifestyle-2' | placeholder_svg_tag }}
          <div class="pdp-v25__reel-play"><svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
        </div>
        <div class="pdp-v25__reel">
          {{ 'image' | placeholder_svg_tag }}
          <div class="pdp-v25__reel-play"><svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
        </div>
      </div>
    </div>
  {% endif %}

  {% if section.settings.show_trust_badges %}
    <div class="pdp-v25__trust">
      <div class="pdp-v25__t-item">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"></path></svg>
        <span>Ethically<br>Sourced</span>
      </div>
      <div class="pdp-v25__t-item">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        <span>Lifetime<br>Warranty</span>
      </div>
      <div class="pdp-v25__t-item">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
        <span>Free Gifting<br>Box</span>
      </div>
    </div>
  {% endif %}

  {% if section.settings.show_full_image %}
    <div style="width:100%; margin:40px 0;">
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    </div>
  {% endif %}

  {% if section.settings.show_cross_sell %}
    <div class="pdp-v25__section">
      <h2 class="pdp-v25__sec-title">Complete The Look</h2>
      <div class="pdp-v25__grid">
        {% for i in (1..4) %}
          <div class="pdp-v25__card">
            {% capture ph %}product-{{ i }}{% endcapture %}
            {{ ph | placeholder_svg_tag }}
            <div class="pdp-v25__card-title">Matching Diamond Studs</div>
            <div class="pdp-v25__card-price">₹18,500</div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

</div>

<!-- STICKY ATC -->
<style>
  .sticky-atc-{{ section.id }} {
    position: fixed; bottom: -100px; left: 0; width: 100%;
    background: rgba(252, 250, 250, 0.95); backdrop-filter: blur(10px);
    border-top: 1px solid var(--v25-border);
    z-index: 999; padding: 12px 20px;
    display: flex; justify-content: space-between; align-items: center;
    transition: bottom 0.4s ease; font-family: var(--v25-font-body);
  }
  .sticky-atc-{{ section.id }}.visible { bottom: 0; }
  .sticky-atc-{{ section.id }}__info { display: flex; align-items: center; gap: 16px; }
  .sticky-atc-{{ section.id }}__img { width: 48px; height: 48px; object-fit: cover; border-radius: 50%; }
  .sticky-atc-{{ section.id }}__title { font-weight: 500; font-size: 14px; color: var(--v25-text); }
  .sticky-atc-{{ section.id }}__price { font-weight: 500; color: var(--v25-text-light); font-size: 14px; }
  .sticky-atc-{{ section.id }}__btn { background: var(--v25-text); color: #FFF; border: none; padding: 12px 32px; font-weight: 400; font-size: 13px; cursor: pointer; text-transform: uppercase; letter-spacing: 2px; }
  @media (max-width: 768px) {
    .sticky-atc-{{ section.id }}__info { display: none; }
    .sticky-atc-{{ section.id }}__btn { width: 100%; padding: 16px; font-size: 14px; }
  }
</style>

<div class="sticky-atc-{{ section.id }}" id="sticky-atc-{{ section.id }}">
  <div class="sticky-atc-{{ section.id }}__info">
    {% if product.featured_media %}
      <img src="{{ product.featured_media | image_url: width: 100 }}" alt="{{ product.title | escape }}" width="100" height="100" loading="lazy" class="sticky-atc-{{ section.id }}__img">
    {% endif %}
    <div>
      <div class="sticky-atc-{{ section.id }}__title">{{ product.title | default: "Solitaire Diamond Pendant" }}</div>
      <div class="sticky-atc-{{ section.id }}__price">{{ current_variant.price | money | default: "₹24,999" }}</div>
    </div>
  </div>
  <button class="sticky-atc-{{ section.id }}__btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">Add to Bag</button>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const stickyBar = document.getElementById('sticky-atc-{{ section.id }}');
    const mainAtc = document.getElementById('v25-atc');
    
    if(stickyBar && mainAtc) {
      window.addEventListener('scroll', function() {
        const mainAtcRect = mainAtc.getBoundingClientRect();
        if (mainAtcRect.top < 0) {
          stickyBar.classList.add('visible');
        } else {
          stickyBar.classList.remove('visible');
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "PDP V25 - Jewelry",
  "settings": [
    {
      "type": "header",
      "content": "Urgency & Pincode"
    },
    {
      "type": "checkbox",
      "id": "show_urgency",
      "label": "Show Viewing Urgency",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pincode",
      "label": "Show Pincode Checker",
      "default": true
    },
    {
      "type": "header",
      "content": "Media Blocks"
    },
    {
      "type": "checkbox",
      "id": "show_reels",
      "label": "Show Product Reels",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_full_image",
      "label": "Show Full Width Lifestyle Image",
      "default": true
    },
    {
      "type": "header",
      "content": "Trust & Cross Sells"
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Show Trust Badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cross_sell",
      "label": "Show 'Complete The Look'",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "PDP V25 - Jewelry"
    }
  ]
}
{% endschema %}
