{%- comment -%}
  PDP V42 — MIDNIGHT OBSIDIAN GLASS
  Design: Deep obsidian dark glassmorphism luxury, Cinzel serif + Plus Jakarta Sans body font
  Obsidian Dark (#0F172A), Sapphire Glow (#2563EB), Frosted Glass, Silver (#E2E8F0)
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign inv_qty = current_variant.inventory_quantity | default: 15 -%}
{%- if inv_qty <= 0 -%}{%- assign inv_qty = 8 -%}{%- endif -%}
{%- assign viewer_count = inv_qty | times: 6 | modulo: 40 | plus: 22 -%}
{%- assign sold_count = inv_qty | times: 14 | modulo: 320 | plus: 160 -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,500&display=swap');

  .pdpv42 {
    --bg: #0F172A; --surface: rgba(30, 41, 59, 0.7); --border: rgba(51, 65, 85, 0.8); --border-dark: #2563EB;
    --text: #F8FAFC; --muted: #94A3B8; --accent: #2563EB; --accent-hover: #1D4ED8;
    --silver: #E2E8F0; --danger: #EF4444;
    --f-head: 'Cinzel', serif; --f-body: 'Plus Jakarta Sans', sans-serif;
    --r: 16px; --r-pill: 9999px; --ease: all 0.25s ease;
    background: var(--bg); color: var(--text); font-family: var(--f-body); font-size: 15px; line-height: 1.6; -webkit-font-smoothing: antialiased;
  }
  .pdpv42 *, .pdpv42 *::before, .pdpv42 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pdpv42 img { max-width: 100%; display: block; }
  .pdpv42 button { font-family: inherit; cursor: pointer; }
  .pdpv42__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* OFFER BAR */
  .pdpv42__offer { background: linear-gradient(90deg, #0F172A, #2563EB, #1E293B); color: #FFF; padding: 12px; text-align: center; font-family: var(--f-head); font-size: 14px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; border-bottom: 1px solid var(--accent); }

  /* GRID */
  .pdpv42__grid { display: grid; grid-template-columns: 1fr; gap: 36px; padding: 36px 0; }
  @media (min-width: 992px) { .pdpv42__grid { grid-template-columns: 1.1fr 1fr; gap: 48px; padding: 48px 0; } }

  /* GALLERY */
  .pdpv42__gal { display: flex; flex-direction: column; gap: 12px; }
  .pdpv42__hero { width: 100%; aspect-ratio: 1; border-radius: var(--r); overflow: hidden; background: var(--surface); backdrop-filter: blur(12px); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 30px rgba(0,0,0,0.5); position: relative; }
  .pdpv42__hero img { width: 100%; height: 100%; object-fit: contain; }
  .pdpv42__obs-tag { position: absolute; top: 14px; left: 14px; background: rgba(37,99,235,0.85); color: #FFF; font-family: var(--f-head); font-size: 11px; font-weight: 700; padding: 4px 14px; border-radius: var(--r-pill); backdrop-filter: blur(8px); }

  .pdpv42__thumbs { display: flex; gap: 10px; overflow-x: auto; }
  .pdpv42__th { width: 64px; height: 64px; flex-shrink: 0; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; cursor: pointer; background: var(--surface); backdrop-filter: blur(8px); transition: var(--ease); }
  .pdpv42__th:hover, .pdpv42__th.on { border-color: var(--accent); box-shadow: 0 0 12px rgba(37,99,235,0.4); }
  .pdpv42__th img { width: 100%; height: 100%; object-fit: cover; }

  /* INFO PANEL */
  .pdpv42__info { display: flex; flex-direction: column; gap: 18px; }
  .pdpv42__crumb { font-family: var(--f-head); font-size: 13px; letter-spacing: 2px; color: var(--accent); font-weight: 700; text-transform: uppercase; }
  .pdpv42__title { font-family: var(--f-head); font-size: 34px; font-weight: 700; line-height: 1.2; color: var(--text); }
  @media (min-width: 992px) { .pdpv42__title { font-size: 42px; } }

  .pdpv42__rating { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--muted); font-weight: 600; }
  .pdpv42__stars { color: var(--accent); }

  /* PRICE CARD */
  .pdpv42__price-card { background: var(--surface); backdrop-filter: blur(12px); border: 1px solid var(--border); border-radius: var(--r); padding: 16px 20px; display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 0 4px 20px rgba(0,0,0,0.3); }
  .pdpv42__price { font-family: var(--f-head); font-size: 38px; font-weight: 700; color: var(--accent); }
  .pdpv42__cmp { font-size: 20px; color: var(--muted); text-decoration: line-through; }
  .pdpv42__badge { background: var(--accent); color: #FFF; font-weight: 700; font-size: 12px; padding: 4px 12px; border-radius: var(--r-pill); }

  /* VARIANTS */
  .pdpv42__vlabel { font-family: var(--f-head); font-size: 13px; font-weight: 700; text-transform: uppercase; color: var(--text); margin-bottom: 8px; }
  .pdpv42__vopts { display: flex; flex-wrap: wrap; gap: 10px; }
  .pdpv42__vr { display: none; }
  .pdpv42__vbtn { padding: 10px 22px; border: 1px solid var(--border); border-radius: var(--r-pill); background: var(--surface); color: var(--text); font-weight: 600; font-size: 14px; transition: var(--ease); cursor: pointer; }
  .pdpv42__vbtn:hover { border-color: var(--accent); }
  .pdpv42__vr:checked + .pdpv42__vbtn { border-color: var(--accent); background: var(--accent); color: #FFF; }

  /* PROMO */
  .pdpv42__promo { background: var(--surface); backdrop-filter: blur(12px); border: 1px dashed var(--accent); border-radius: var(--r); padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; font-size: 14px; font-weight: 600; color: var(--accent); }
  .pdpv42__promo-code { background: var(--accent); color: #FFF; font-family: var(--f-head); font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 6px; }

  /* URGENCY */
  .pdpv42__urg { background: var(--surface); backdrop-filter: blur(12px); border-left: 4px solid var(--accent); border-radius: 0 var(--r) var(--r) 0; padding: 16px; display: flex; flex-direction: column; gap: 8px; font-size: 14px; font-weight: 600; box-shadow: 0 4px 14px rgba(0,0,0,0.3); }
  .pdpv42__pulse { display: inline-block; width: 8px; height: 8px; background: var(--accent); border-radius: 50%; margin-right: 6px; animation: pdpv42p 1.5s infinite; }
  @keyframes pdpv42p { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
  .pdpv42__bar { height: 6px; background: #1E293B; border-radius: 3px; overflow: hidden; margin-top: 4px; }
  .pdpv42__fill { height: 100%; background: var(--accent); border-radius: 3px; }

  /* QTY & CTA */
  .pdpv42__qty-row { display: flex; align-items: center; gap: 14px; }
  .pdpv42__qty { display: flex; border: 1px solid var(--border); border-radius: var(--r-pill); overflow: hidden; background: var(--surface); }
  .pdpv42__qty button { width: 42px; height: 46px; border: none; background: transparent; font-size: 18px; color: var(--text); }
  .pdpv42__qty input { width: 44px; height: 46px; border: none; border-left: 1px solid var(--border); border-right: 1px solid var(--border); text-align: center; font-size: 15px; font-weight: 700; background: transparent; color: var(--text); }

  .pdpv42__atc { width: 100%; padding: 16px; border: none; border-radius: var(--r-pill); background: var(--accent); color: #FFF; font-family: var(--f-head); font-size: 16px; font-weight: 700; letter-spacing: 1px; transition: var(--ease); box-shadow: 0 6px 18px rgba(37,99,235,0.3); }
  .pdpv42__atc:hover { background: var(--accent-hover); transform: translateY(-1px); }
  .pdpv42__atc:disabled { opacity: 0.4; cursor: not-allowed; box-shadow: none; }
  .pdpv42__buynow .shopify-payment-button__button { border-radius: var(--r-pill) !important; }

  /* TRUST */
  .pdpv42__trust { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; text-align: center; padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .pdpv42__trust-item { font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; }
  .pdpv42__trust-icon { font-size: 20px; margin-bottom: 3px; color: var(--accent); }
  @media (max-width: 480px) { .pdpv42__trust { grid-template-columns: repeat(2, 1fr); } }

  /* ACCORDION */
  .pdpv42__acc { border-top: 1px solid var(--border); margin-top: 48px; }
  .pdpv42__acc-item { border-bottom: 1px solid var(--border); }
  .pdpv42__acc-btn { width: 100%; padding: 18px 0; border: none; background: transparent; display: flex; justify-content: space-between; align-items: center; font-family: var(--f-head); font-size: 18px; font-weight: 700; color: var(--text); }
  .pdpv42__acc-btn::after { content: '💎'; font-size: 18px; }
  .pdpv42__acc-body { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .pdpv42__acc-item.open .pdpv42__acc-body { max-height: 500px; }
  .pdpv42__acc-inner { padding: 0 0 18px; font-size: 15px; line-height: 1.7; color: var(--muted); }

  /* SECTION TITLE */
  .pdpv42__sh { font-family: var(--f-head); font-size: 28px; font-weight: 700; text-align: center; margin: 48px 0 20px; color: var(--text); }

  /* REELS */
  .pdpv42__reels { display: flex; gap: 14px; overflow-x: auto; padding-bottom: 12px; }
  .pdpv42__reel { min-width: 180px; width: 180px; aspect-ratio: 9/16; background: #1E293B; border-radius: var(--r); overflow: hidden; flex-shrink: 0; position: relative; }
  .pdpv42__reel video { width: 100%; height: 100%; object-fit: cover; }
  .pdpv42__reel-cap { position: absolute; bottom: 0; left: 0; right: 0; padding: 10px; background: linear-gradient(transparent, rgba(0,0,0,0.85)); color: #FFF; font-size: 12px; font-weight: 600; }
  .pdpv42__reel-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--accent); font-size: 36px; }

  /* CARDS */
  .pdpv42__pgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media (min-width: 768px) { .pdpv42__pgrid { grid-template-columns: repeat(4, 1fr); } }
  .pdpv42__pcard { background: var(--surface); backdrop-filter: blur(12px); border-radius: var(--r); border: 1px solid var(--border); overflow: hidden; transition: var(--ease); text-decoration: none; color: inherit; display: block; }
  .pdpv42__pcard:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.3); }
  .pdpv42__pcard img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .pdpv42__pcard-info { padding: 14px; }
  .pdpv42__pcard-title { font-family: var(--f-head); font-size: 15px; font-weight: 700; margin-bottom: 4px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pdpv42__pcard-price { font-size: 15px; font-weight: 700; color: var(--accent); }

  /* REVIEWS */
  .pdpv42__revgrid { display: grid; grid-template-columns: 1fr; gap: 14px; }
  @media (min-width: 768px) { .pdpv42__revgrid { grid-template-columns: repeat(3, 1fr); } }
  .pdpv42__revcard { background: var(--surface); backdrop-filter: blur(12px); border-radius: var(--r); border: 1px solid var(--border); padding: 20px; }
  .pdpv42__rev-stars { color: var(--accent); font-size: 14px; margin-bottom: 8px; }
  .pdpv42__rev-txt { font-size: 14px; line-height: 1.6; color: var(--muted); font-style: italic; margin-bottom: 12px; }
  .pdpv42__rev-auth { font-family: var(--f-head); font-size: 14px; font-weight: 700; }
  .pdpv42__rev-vf { font-size: 11px; color: var(--accent); font-weight: 700; }

  /* RECENTLY VIEWED */
  #pdpv42-rv { display: none; }
  #pdpv42-rv.has { display: block; }

  /* STICKY ATC */
  .pdpv42__sticky { position: fixed; bottom: -80px; left: 0; width: 100%; background: var(--surface); backdrop-filter: blur(16px); border-top: 3px solid var(--accent); padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; z-index: 9999; transition: bottom 0.3s ease; box-shadow: 0 -4px 20px rgba(0,0,0,0.5); }
  .pdpv42__sticky.show { bottom: 0; }
  .pdpv42__sticky-l { display: flex; align-items: center; gap: 14px; }
  .pdpv42__sticky-img { width: 42px; height: 42px; border-radius: 10px; object-fit: cover; }
  .pdpv42__sticky-t { font-family: var(--f-head); font-size: 14px; font-weight: 700; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pdpv42__sticky-p { font-size: 15px; font-weight: 700; color: var(--accent); }
  .pdpv42__sticky-btn { background: var(--accent); color: #FFF; border: none; padding: 12px 26px; border-radius: var(--r-pill); font-family: var(--f-head); font-weight: 700; font-size: 14px; transition: var(--ease); }
  .pdpv42__sticky-btn:hover { background: var(--accent-hover); }
  @media (max-width: 600px) { .pdpv42__sticky-l { display: none; } .pdpv42__sticky-btn { width: 100%; padding: 15px; } }

  .pdpv42__toast { position: fixed; top: 20px; right: 20px; background: var(--accent); color: #FFF; padding: 12px 24px; border-radius: var(--r-pill); font-family: var(--f-head); font-size: 14px; font-weight: 700; z-index: 10000; transform: translateX(130%); transition: transform 0.3s ease; box-shadow: 0 4px 16px rgba(37,99,235,0.4); }
  .pdpv42__toast.show { transform: translateX(0); }
</style>

<div class="pdpv42">
  {% if section.settings.show_offer %}<div class="pdpv42__offer">{{ section.settings.offer_text }}</div>{% endif %}

  <div class="pdpv42__wrap">
    <div class="pdpv42__grid">

      <!-- GALLERY -->
      <div class="pdpv42__gal">
        <div class="pdpv42__hero" id="pdpv42-hero">
          <span class="pdpv42__obs-tag">💎 MIDNIGHT OBSIDIAN</span>
          {% if product.featured_media %}<img height="{{ product.featured_media.height }}" width="{{ product.featured_media.width }}" src="{{ product.featured_media | image_url: width: 900 }}" alt="{{ product.title | escape }}" id="pdpv42-himg">{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
        </div>
        <div class="pdpv42__thumbs">
          {% for media in product.media limit: 6 %}
            <div class="pdpv42__th {% if forloop.first %}on{% endif %}">
              <img height="{{ media.height }}" width="{{ media.width }}" src="{{ media | image_url: width: 150 }}" alt="{{ media.alt | escape }}" loading="lazy">
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- INFO -->
      <div class="pdpv42__info">
        <div class="pdpv42__crumb">💎 {% if product.collections.size > 0 %}{{ product.collections.first.title }}{% else %}Obsidian Glass{% endif %}</div>
        <h1 class="pdpv42__title">{{ product.title }}</h1>

        {% if section.settings.show_rating %}
          <div class="pdpv42__rating">
            <span class="pdpv42__stars">★★★★★</span>
            <span>{{ section.settings.rating_val }} · {{ section.settings.rev_count }} Obsidian Reviews</span>
          </div>
        {% endif %}

        <div class="pdpv42__price-card">
          <span class="pdpv42__price" id="pdpv42-price">{{ current_variant.price | money }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="pdpv42__cmp">{{ current_variant.compare_at_price | money }}</span>
            {%- assign sv = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
            <span class="pdpv42__badge">SAVE {{ sv }}%</span>
          {% endif %}
        </div>

        {% if product.variants.size > 1 %}
          {% for option in product.options_with_values %}
            <div>
              <div class="pdpv42__vlabel">Select {{ option.name }}</div>
              <div class="pdpv42__vopts">
                {% for value in option.values %}
                  <label>
                    <input type="radio" name="pdpv42-o-{{ option.position }}" value="{{ value | escape }}" class="pdpv42__vr" data-pos="{{ option.position }}" {% if option.selected_value == value %}checked{% endif %}>
                    <span class="pdpv42__vbtn">{{ value }}</span>
                  </label>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% endif %}

        {% if section.settings.show_promo %}
          <div class="pdpv42__promo">
            <span>💎 Obsidian Pass: Apply {{ section.settings.promo_code }}</span>
            <span class="pdpv42__promo-code">Save {{ section.settings.promo_disc }}</span>
          </div>
        {% endif %}

        {% if section.settings.show_urgency %}
          <div class="pdpv42__urg">
            <div><span class="pdpv42__pulse"></span><strong>{{ viewer_count }}</strong> luxury patrons online</div>
            <div>💎 <strong>{{ sold_count }}</strong> obsidian orders completed today</div>
            <div>Availability: Only <strong>{{ inv_qty }}</strong> remaining
              <div class="pdpv42__bar">
                {%- assign sp = inv_qty | times: 100 | divided_by: 45 -%}
                {%- if sp > 100 -%}{%- assign sp = 100 -%}{%- endif -%}
                <div class="pdpv42__fill" style="width:{{ sp }}%"></div>
              </div>
            </div>
            {% if section.settings.show_countdown %}
              <div>⏳ Obsidian Offer Ends In: <strong id="pdpv42-cd" style="color:var(--accent)">{{ section.settings.cd_hrs }}h 00m 00s</strong></div>
            {% endif %}
          </div>
        {% endif %}

        <div class="pdpv42__qty-row">
          <div class="pdpv42__qty">
            <button type="button" id="pdpv42-qm">−</button>
            <input type="number" id="pdpv42-qi" value="1" min="1" max="10" readonly>
            <button type="button" id="pdpv42-qp">+</button>
          </div>
          {% form 'product', product, id: 'pdpv42-form', style: 'flex:1' %}
            <input type="hidden" name="id" id="pdpv42-vid" value="{{ current_variant.id }}">
            <input type="hidden" name="quantity" id="pdpv42-fq" value="1">
            <button type="submit" name="add" class="pdpv42__atc" id="pdpv42-atc" {% unless current_variant.available %}disabled{% endunless %}>
              {% if current_variant.available %}Add to Cart — {{ current_variant.price | money }}{% else %}Sold Out{% endif %}
            </button>
            <div class="pdpv42__buynow" style="margin-top:10px">{{ form | payment_button }}</div>
          {% endform %}
        </div>

        <div class="pdpv42__trust">
          <div class="pdpv42__trust-item"><div class="pdpv42__trust-icon">🔒</div>Secure</div>
          <div class="pdpv42__trust-item"><div class="pdpv42__trust-icon">💎</div>Obsidian Craft</div>
          <div class="pdpv42__trust-item"><div class="pdpv42__trust-icon">↩️</div>Easy Returns</div>
          <div class="pdpv42__trust-item"><div class="pdpv42__trust-icon">✨</div>Sapphire Glow</div>
        </div>
      </div>
    </div>

    <!-- ACCORDION -->
    <div class="pdpv42__acc">
      <div class="pdpv42__acc-item open">
        <button class="pdpv42__acc-btn" type="button">Obsidian Story & Craftsmanship</button>
        <div class="pdpv42__acc-body"><div class="pdpv42__acc-inner">{{ product.description }}</div></div>
      </div>
      {% if section.settings.obs_specs != blank %}
        <div class="pdpv42__acc-item">
          <button class="pdpv42__acc-btn" type="button">Materials & Technical Build</button>
          <div class="pdpv42__acc-body"><div class="pdpv42__acc-inner">{{ section.settings.obs_specs }}</div></div>
        </div>
      {% endif %}
    </div>

    <!-- FBT -->
    {% if section.settings.fbt_coll != blank %}
      {%- assign fbt = collections[section.settings.fbt_coll] -%}
      {% if fbt.products.size > 0 %}
        <div class="pdpv42__sh">Obsidian Glass Pairings</div>
        <div class="pdpv42__pgrid">
          {% for item in fbt.products limit: 4 %}
            <a href="{{ item.url }}" class="pdpv42__pcard">
              <img height="{{ item.featured_image.height }}" width="{{ item.featured_image.width }}" src="{{ item.featured_image | image_url: width: 400 }}" alt="{{ item.title | escape }}" loading="lazy">
              <div class="pdpv42__pcard-info">
                <div class="pdpv42__pcard-title">{{ item.title }}</div>
                <div class="pdpv42__pcard-price">{{ item.price | money }}</div>
              </div>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}

    <!-- REELS -->
    {% if section.settings.show_reels %}
      <div class="pdpv42__sh">Luxury Stream</div>
      <div class="pdpv42__reels">
        {% if section.settings.r1 != blank %}<div class="pdpv42__reel"><video src="{{ section.settings.r1 }}" muted playsinline loop></video><div class="pdpv42__reel-cap">💎 Obsidian Refraction</div></div>{% else %}<div class="pdpv42__reel"><div class="pdpv42__reel-ph">▶</div></div>{% endif %}
        {% if section.settings.r2 != blank %}<div class="pdpv42__reel"><video src="{{ section.settings.r2 }}" muted playsinline loop></video><div class="pdpv42__reel-cap">✨ Sapphire Touch</div></div>{% else %}<div class="pdpv42__reel"><div class="pdpv42__reel-ph">▶</div></div>{% endif %}
        {% if section.settings.r3 != blank %}<div class="pdpv42__reel"><video src="{{ section.settings.r3 }}" muted playsinline loop></video><div class="pdpv42__reel-cap">💎 Glass Unboxing</div></div>{% else %}<div class="pdpv42__reel"><div class="pdpv42__reel-ph">▶</div></div>{% endif %}
      </div>
    {% endif %}

    <!-- REVIEWS -->
    {% if section.settings.show_reviews %}
      <div class="pdpv42__sh" id="reviews">Customer Reviews</div>
      <div class="pdpv42__revgrid">
        {% if section.settings.rv1 != blank %}<div class="pdpv42__revcard"><div class="pdpv42__rev-stars">★★★★★</div><div class="pdpv42__rev-txt">"{{ section.settings.rv1 }}"</div><div class="pdpv42__rev-auth">{{ section.settings.rv1n }}</div><div class="pdpv42__rev-vf">✓ Verified Buyer</div></div>{% endif %}
        {% if section.settings.rv2 != blank %}<div class="pdpv42__revcard"><div class="pdpv42__rev-stars">★★★★★</div><div class="pdpv42__rev-txt">"{{ section.settings.rv2 }}"</div><div class="pdpv42__rev-auth">{{ section.settings.rv2n }}</div><div class="pdpv42__rev-vf">✓ Verified Buyer</div></div>{% endif %}
        {% if section.settings.rv3 != blank %}<div class="pdpv42__revcard"><div class="pdpv42__rev-stars">★★★★★</div><div class="pdpv42__rev-txt">"{{ section.settings.rv3 }}"</div><div class="pdpv42__rev-auth">{{ section.settings.rv3n }}</div><div class="pdpv42__rev-vf">✓ Verified Buyer</div></div>{% endif %}
      </div>
    {% endif %}

    <!-- FEATURED -->
    {% if section.settings.feat_coll != blank %}
      {%- assign fc = collections[section.settings.feat_coll] -%}
      {% if fc.products.size > 0 %}
        <div class="pdpv42__sh">Recommended Obsidian Items</div>
        <div class="pdpv42__pgrid">
          {% for item in fc.products limit: 4 %}
            {% if item.handle != product.handle %}
              <a href="{{ item.url }}" class="pdpv42__pcard">
                <img height="{{ item.featured_image.height }}" width="{{ item.featured_image.width }}" src="{{ item.featured_image | image_url: width: 400 }}" alt="{{ item.title | escape }}" loading="lazy">
                <div class="pdpv42__pcard-info">
                  <div class="pdpv42__pcard-title">{{ item.title }}</div>
                  <div class="pdpv42__pcard-price">{{ item.price | money }}</div>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}

    <!-- RECENTLY VIEWED -->
    <div id="pdpv42-rv">
      <div class="pdpv42__sh">Recently Viewed</div>
      <div class="pdpv42__pgrid" id="pdpv42-rvg"></div>
    </div>
  </div>
</div>

<!-- STICKY ATC -->
<div class="pdpv42__sticky" id="pdpv42-sticky">
  <div class="pdpv42__sticky-l">
    {% if product.featured_media %}<img height="{{ product.featured_media.height }}" width="{{ product.featured_media.width }}" src="{{ product.featured_media | image_url: width: 80 }}" class="pdpv42__sticky-img" alt="{{ product.title | escape }}">{% endif %}
    <div>
      <div class="pdpv42__sticky-t">{{ product.title }}</div>
      <div class="pdpv42__sticky-p" id="pdpv42-sp">{{ current_variant.price | money }}</div>
    </div>
  </div>
  
      <!-- D2C SCARCITY & NOTIFY -->
      {% if product.available %}
        <div style="background:#FFF3E0; border:1px solid #FFCC80; padding:10px; border-radius:8px; margin-bottom:12px; display:flex; align-items:center; gap:12px;">
          <svg style="width:24px; height:24px; color:#E65100; flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <div style="font-size:13px; color:#E65100;">
            <div style="font-weight:700;">Limited Time Offer Ends In:</div>
            <div style="font-size:16px; font-weight:700; margin-top:2px;"><b>{% render 'countdown-timer', product: product %}</b></div>
          </div>
        </div>
      {% endif %}

      {% render 'back-in-stock', product: product %}

      {% if product.available %}
      <button type="button" class="pdpv42__sticky-btn" id="pdpv42-sbtn">Add to Cart</button>
      {% else %}
      <button class="pdpv42__sticky-btn" disabled style="opacity:0.5; cursor:not-allowed;">SOLD OUT</button>
      {% endif %}
</div>

<div class="pdpv42__toast" id="pdpv42-toast">💎 Added to cart!</div>

<script>
(function(){
  var PJ={{ product | json }}, cid={{ current_variant.id }};
  function getO(){ var o=[]; document.querySelectorAll('.pdpv42__vr:checked').forEach(function(r){ o.push({p:parseInt(r.dataset.pos),v:r.value}); }); o.sort(function(a,b){return a.p-b.p}); return o.map(function(x){return x.v}); }
  function findV(o){ for(var i=0;i<PJ.variants.length;i++){ var v=PJ.variants[i],ok=true; for(var j=0;j<o.length;j++){ if(v.options[j]!==o[j]){ ok=false; break; } } if(ok) return v; } return null; }
  function upd(){
    var o=getO(); if(!o.length) return; var v=findV(o); if(!v) return; cid=v.id;
    document.getElementById('pdpv42-vid').value=v.id;
    var pf=(v.price/100).toLocaleString('en-US',{style:'currency',currency:PJ.currency||'USD'});
    var pe=document.getElementById('pdpv42-price'); if(pe) pe.textContent=pf;
    var sp=document.getElementById('pdpv42-sp'); if(sp) sp.textContent=pf;
    var ab=document.getElementById('pdpv42-atc');
    if(ab){ ab.disabled=!v.available; ab.textContent=v.available?'Add to Cart — '+pf:'Sold Out'; }
    var u=new URL(window.location); u.searchParams.set('variant',v.id); history.replaceState({},'',u);
  }
  document.querySelectorAll('.pdpv42__vr').forEach(function(r){ r.addEventListener('change',upd); });

  var fm=document.getElementById('pdpv42-form');
  if(fm) fm.addEventListener('submit',function(e){
    e.preventDefault(); var b=document.getElementById('pdpv42-atc'), ot=b.textContent;
    b.disabled=true; b.textContent='Adding...';
    var q=parseInt(document.getElementById('pdpv42-qi').value)||1;
    document.getElementById('pdpv42-fq').value=q;
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:cid,quantity:q})})
    .then(function(r){return r.json();})
    .then(function(){ b.textContent='✓ Added!'; toast42(); setTimeout(function(){ b.disabled=false; b.textContent=ot; },2000); })
    .catch(function(){ b.textContent='Error'; setTimeout(function(){ b.disabled=false; b.textContent=ot; },2000); });
  });

  function toast42(){ var t=document.getElementById('pdpv42-toast'); t.classList.add('show'); setTimeout(function(){ t.classList.remove('show'); },3000); }

  var qi=document.getElementById('pdpv42-qi');
  document.getElementById('pdpv42-qm').addEventListener('click',function(){ var v=parseInt(qi.value); if(v>1) qi.value=v-1; });
  document.getElementById('pdpv42-qp').addEventListener('click',function(){ var v=parseInt(qi.value); if(v<10) qi.value=v+1; });

  document.querySelectorAll('.pdpv42__th').forEach(function(th){
    th.addEventListener('click',function(){
      document.querySelectorAll('.pdpv42__th').forEach(function(t){ t.classList.remove('on'); });
      th.classList.add('on');
      var hi=document.getElementById('pdpv42-himg'), ti=th.querySelector('img');
      if(hi&&ti) hi.src=ti.src.replace(/width=\d+/,'width=900');
    });
  });

  var sb=document.getElementById('pdpv42-sticky'), ab=document.getElementById('pdpv42-atc');
  if(sb&&ab) window.addEventListener('scroll',function(){ sb.classList.toggle('show', ab.getBoundingClientRect().top<-50); });
  var sbn=document.getElementById('pdpv42-sbtn');
  if(sbn) sbn.addEventListener('click',function(){ document.getElementById('pdpv42-atc').click(); });

  document.querySelectorAll('.pdpv42__acc-btn').forEach(function(b){ b.addEventListener('click',function(){ b.closest('.pdpv42__acc-item').classList.toggle('open'); }); });

  var ce=document.getElementById('pdpv42-cd');
  if(ce){
    var hrs=parseInt('{{ section.settings.cd_hrs | default: 8 }}')||8, ts=hrs*3600;
    var sk=sessionStorage.getItem('pdpv42_cd'); if(sk) ts=parseInt(sk);
    setInterval(function(){ ts--; if(ts<=0){ ce.textContent='EXPIRED'; return; } var h=Math.floor(ts/3600), m=Math.floor((ts%3600)/60), s=ts%60; ce.textContent=h+'h '+(m<10?'0':'')+m+'m '+(s<10?'0':'')+s+'s'; sessionStorage.setItem('pdpv42_cd',ts); },1000);
  }

  if('IntersectionObserver' in window){
    var ro=new IntersectionObserver(function(es){ es.forEach(function(e){ var v=e.target.querySelector('video'); if(v){ e.isIntersecting?v.play():v.pause(); } }); },{threshold:0.5});
    document.querySelectorAll('.pdpv42__reel').forEach(function(r){ ro.observe(r); });
  }

  var RK='pdpv42_rv', cp={handle:'{{ product.handle }}',title:'{{ product.title | escape }}',price:'{{ product.price | money }}',image:'{{ product.featured_image | image_url: width: 400 }}',url:'{{ product.url }}'};
  try{ var its=JSON.parse(localStorage.getItem(RK)||'[]'); its=its.filter(function(i){ return i.handle!==cp.handle; }); its.unshift(cp); if(its.length>8) its=its.slice(0,8); localStorage.setItem(RK,JSON.stringify(its)); }catch(e){}
  try{
    var its2=JSON.parse(localStorage.getItem(RK)||'[]').filter(function(i){ return i.handle!==cp.handle; });
    var c=document.getElementById('pdpv42-rv'), g=document.getElementById('pdpv42-rvg');
    if(g&&its2.length>0){ c.classList.add('has'); var h=''; its2.slice(0,4).forEach(function(i){ h+='<a href="'+i.url+'" class="pdpv42__pcard"><img src="'+i.image+'" alt="'+i.title+'" loading="lazy"><div class="pdpv42__pcard-info"><div class="pdpv42__pcard-title">'+i.title+'</div><div class="pdpv42__pcard-price">'+i.price+'</div></div></a>'; }); g.innerHTML=h; }
  }catch(e){}
})();
</script>

