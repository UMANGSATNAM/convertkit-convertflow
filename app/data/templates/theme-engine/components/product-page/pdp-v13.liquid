  {% endif %}

  <!-- RECENTLY VIEWED SECTION -->
  {% if section.settings.show_recently_viewed %}
    <div style="max-width: 1400px; margin: 40px auto; padding: 20px;">
      <h2 style="font-size: 24px; font-weight: 600; margin-bottom: 20px;">Recently Viewed</h2>
      <div id="dynamic-recently-viewed" style="display: flex; gap: 16px; overflow-x: auto; padding-bottom: 16px;">
        <!-- Hydrated via JS -->
      </div>
</div>
    </div>
  {% endif %}

  <!-- BUILT-IN STICKY ATC -->
  <div class="pdp-v13-sticky" id="v13-sticky">
    <div class="pdp-v13-sticky__left">
      {% if product.featured_media %}
        <img src="{{ product.featured_media | image_url: width: 100 }}" alt="{{ product.title | escape }}" width="100" height="100" loading="lazy" class="pdp-v13-sticky__img">
      {% else %}
        <div class="pdp-v13-sticky__img" style="background:#FFF;">{{ 'product-1' | placeholder_svg_tag: 'style="width:100%;height:100%;"' }}</div>
      {% endif %}
      <div class="pdp-v13-sticky__info">
        <h5>{{ product.title | default: "Jordan 1 Retro High OG" }}</h5>
        <p>{{ current_variant.price | money | default: "₹16,999" }}</p>
      </div>
    </div>
    <button class="pdp-v13-sticky__btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">Purchase Now</button>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      // Accordions
      const accBtns = document.querySelectorAll('.pdp-v13__acc-btn');
      accBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const content = this.nextElementSibling;
          const icon = this.querySelector('.icon');
          if (content.classList.contains('open')) {
            content.classList.remove('open');
            icon.innerText = "+";
          } else {
            content.classList.add('open');
            icon.innerText = "-";
          }
        });
      });

      // Sticky ATC
      const stickyBar = document.getElementById('v13-sticky');
      const mainAtc = document.getElementById('v13-atc');
      if(stickyBar && mainAtc) {
        window.addEventListener('scroll', function() {
          const mainAtcRect = mainAtc.getBoundingClientRect();
          if (mainAtcRect.top < 0) {
            stickyBar.classList.add('visible');
          } else {
            stickyBar.classList.remove('visible');
          }
        });
      }
    });
  </script>

</div>


  <!-- GLOBAL D2C SCRIPTS -->
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      // RECENTLY VIEWED LOGIC
      const handle = {{ product.handle | json }};
      const rvKey = 'cf_recent_products';
      let recent = JSON.parse(localStorage.getItem(rvKey) || '[]');
      if (handle && !recent.includes(handle)) {
        recent.unshift(handle);
        if (recent.length > 6) recent.pop();
        localStorage.setItem(rvKey, JSON.stringify(recent));
      }

      const rvContainer = document.getElementById('dynamic-recently-viewed');
      if (rvContainer) {
        const fetchRecent = recent.filter(h => h !== handle);
        if (fetchRecent.length > 0) {
          const query = fetchRecent.map(h => `handle:${h}`).join(' OR ');
          fetch(`/search?type=product&q=${query}&section_id=product-card-api`)
            .then(res => res.text())
            .then(html => {
              if (html && !html.includes('404')) {
                rvContainer.innerHTML = html;
              } else {
                rvContainer.parentElement.style.display = 'none';
              }
            })
            .catch(() => rvContainer.parentElement.style.display = 'none');
        } else {
          rvContainer.parentElement.style.display = 'none';
        }
      }

    });
  </script>

