          <div class="pdp-v13__card-price">₹8,500</div>
          <button class="pdp-v13__card-btn">View Product</button>
        </div>
        <div class="pdp-v13__card">
          {{ 'product-4' | placeholder_svg_tag: 'pdp-v13__card-img' }}
          <div class="pdp-v13__card-brand">Nike</div>
          <div class="pdp-v13__card-title">No-Show Socks (3-Pack)</div>
          <div class="pdp-v13__card-price">₹1,195</div>
          <button class="pdp-v13__card-btn">View Product</button>
        </div>
        <div class="pdp-v13__card">
          {{ 'product-5' | placeholder_svg_tag: 'pdp-v13__card-img' }}
          <div class="pdp-v13__card-brand">Jordan</div>
          <div class="pdp-v13__card-title">Flight Utility Cargo Pants</div>
          <div class="pdp-v13__card-price">₹6,295</div>
          <button class="pdp-v13__card-btn">View Product</button>
        </div>
        <div class="pdp-v13__card">
          {{ 'product-6' | placeholder_svg_tag: 'pdp-v13__card-img' }}
          <div class="pdp-v13__card-brand">New Era</div>
          <div class="pdp-v13__card-title">59FIFTY Fitted Cap - NY Yankees</div>
          <div class="pdp-v13__card-price">₹2,999</div>
          <button class="pdp-v13__card-btn">View Product</button>
