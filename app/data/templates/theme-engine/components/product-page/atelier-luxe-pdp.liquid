{% comment %}
  Atelier Luxe PDP Buy Box
  High-Ticket Editorial Fashion & Apparel Buy Box
  1000cr Architecture • Zero Emojis • 100% Vector SVGs • Ultra-Minimalist Luxury
{% endcomment %}

{%- liquid
  assign p = section.settings.product | default: product
  assign has_real_product = false
  if p != blank and p.title != blank
    assign has_real_product = true
    assign p_title = p.title
    assign p_price = p.price
    assign p_compare_at = p.compare_at_price
    assign p_desc = p.description
    assign p_images = p.images
    assign p_variants = p.variants
    assign first_variant = p.selected_or_first_available_variant
  else
    assign p_title = section.settings.title | default: "The Atelier Cashmere Double-Faced Wrap Coat"
    assign p_price = 1499900
    assign p_compare_at = 2199900
    assign p_desc = "Expertly tailored from Grade-A Mongolian cashmere with a brushed velour finish. Designed with clean raglan shoulders, an effortless self-tie sash belt, and hand-pick stitched lapels."
  endif
-%}

<div 
  class="atelier-pdp-section" 
  id="atelier-pdp-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-product-id="{% if has_real_product %}{{ p.id }}{% else %}demo-atelier{% endif %}"
  style="
    --atl-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --atl-surface: {{ section.settings.card_bg | default: '#fdfcfb' }};
    --atl-border: {{ section.settings.border_color | default: '#e8e4df' }};
    --atl-text: {{ section.settings.text_color | default: '#1a1816' }};
    --atl-text-muted: {{ section.settings.muted_color | default: '#736d66' }};
    --atl-accent: {{ section.settings.accent_color | default: '#1a1816' }};
    --atl-accent-hover: {{ section.settings.accent_hover | default: '#2d2925' }};
    --atl-gold: {{ section.settings.gold_color | default: '#b39062' }};
  "
>
  <div class="atelier-pdp-container">
    
    <!-- ── LEFT COLUMN: EDITORIAL GALLERY ── -->
    <div class="atelier-gallery-col">
      <div class="atelier-main-image-wrap">
        <div class="atelier-badge-stack">
          <span class="atelier-badge-edition">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15 9 22 12 15 15 12 22 9 15 2 12 9 9 12 2"/></svg>
            <span>{{ section.settings.collection_label | default: "Atelier Runway 2026" }}</span>
          </span>
          {%- if section.settings.show_limited_badge -%}
            <span class="atelier-badge-limited">Limited Edition (08/300)</span>
          {%- endif -%}
        </div>

        <div class="atelier-main-img-holder" id="atelier-main-holder-{{ section.id }}">
          <img 
            id="atelier-active-img-{{ section.id }}" 
            class="atelier-active-img"
            src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=1200&q=85" 
            alt="{{ p_title | escape }}"
            loading="eager"
          />
        </div>

        <div class="atelier-model-fit-bar">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="4"/><path d="M6 21v-2a6 6 0 0 1 12 0v2"/></svg>
          <span>Model is 179cm / 5'10" with 32" bust wearing Size S (Tailored Fit)</span>
        </div>
      </div>

      <!-- Thumbnail Strip -->
      <div class="atelier-thumbs-strip" id="atelier-thumbs-{{ section.id }}">
        <button 
          type="button" 
          class="atelier-thumb-item is-active" 
          onclick="window.switchAtelierImage('{{ section.id }}', 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=1200&q=85', this)"
          aria-label="View front angle"
        >
          <img src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=240&q=75" alt="Front angle" />
        </button>
        <button 
          type="button" 
          class="atelier-thumb-item" 
          onclick="window.switchAtelierImage('{{ section.id }}', 'https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1200&q=85', this)"
          aria-label="View profile drape"
        >
          <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=240&q=75" alt="Profile drape" />
        </button>
        <button 
          type="button" 
          class="atelier-thumb-item" 
          onclick="window.switchAtelierImage('{{ section.id }}', 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=1200&q=85', this)"
          aria-label="View movement angle"
        >
          <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=240&q=75" alt="Movement angle" />
        </button>
        <button 
          type="button" 
          class="atelier-thumb-item" 
          onclick="window.switchAtelierImage('{{ section.id }}', 'https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=1200&q=85', this)"
          aria-label="View fabric detail"
        >
          <img src="https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=240&q=75" alt="Fabric detail" />
        </button>
      </div>
    </div>

    <!-- ── RIGHT COLUMN: HIGH-AOV BUY BOX ── -->
    <div class="atelier-buybox-col">
      <div class="atelier-buybox-card">
        
        <!-- Header Info -->
        <div class="atelier-header-block">
          <div class="atelier-meta-row">
            <span class="atelier-brand-eyebrow">{{ section.settings.eyebrow_text | default: "MAISON ATELIER COUTURE" }}</span>
            <div class="atelier-rating-wrap">
              <div class="atelier-stars">
                {%- for i in (1..5) -%}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="atelier-star-icon"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- endfor -%}
              </div>
              <span class="atelier-reviews-count">4.9 / 5.0 (312 Client Reviews)</span>
            </div>
          </div>

          <h1 class="atelier-product-title">{{ p_title }}</h1>

          <!-- Price Display -->
          <div class="atelier-price-row">
            <div class="atelier-price-left">
              <span class="atelier-main-price" id="atelier-display-price-{{ section.id }}">
                {%- if has_real_product -%}{{ p_price | money }}{%- else -%}₹14,999{%- endif -%}
              </span>
              <span class="atelier-compare-price" id="atelier-display-compare-{{ section.id }}">
                {%- if has_real_product and p_compare_at > p_price -%}{{ p_compare_at | money }}{%- else -%}₹21,999{%- endif -%}
              </span>
            </div>
            <span class="atelier-save-pill" id="atelier-display-save-{{ section.id }}">
              SAVE 32% TODAY
            </span>
          </div>

          <div class="atelier-shipping-microcopy">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Complimentary Global Express Air Shipping • All Import Duties & Taxes Paid</span>
          </div>
        </div>

        <!-- ── TIERED BUNDLE BUILDER (HIGH AOV BOOST) ── -->
        <div class="atelier-bundles-section">
          <div class="atelier-bundles-header">
            <span class="atelier-bundles-title">Select Purchase Option:</span>
            <span class="atelier-bundles-save-hint">Bundle & Save Up to 25%</span>
          </div>

          <div class="atelier-bundle-tiers">
            <!-- Tier 1 -->
            <label class="atelier-tier-card" onclick="window.selectAtelierBundle('{{ section.id }}', 1, 14999, 21999, 'SAVE 32% TODAY')">
              <input type="radio" name="atelier_bundle_{{ section.id }}" value="1" class="atelier-tier-radio" />
              <div class="atelier-tier-content">
                <div class="atelier-tier-left">
                  <div class="atelier-tier-name">1x Atelier Single Coat</div>
                  <div class="atelier-tier-sub">Standard bespoke client packaging</div>
                </div>
                <div class="atelier-tier-right">
                  <span class="atelier-tier-price">₹14,999</span>
                </div>
              </div>
            </label>

            <!-- Tier 2 (Most Popular) -->
            <label class="atelier-tier-card is-active is-popular" onclick="window.selectAtelierBundle('{{ section.id }}', 2, 25499, 43998, 'SAVE 42% (DUO BUNDLE)')">
              <input type="radio" name="atelier_bundle_{{ section.id }}" value="2" checked class="atelier-tier-radio" />
              <div class="atelier-popular-tag">MOST COVETED • SAVE 15% EXTRA</div>
              <div class="atelier-tier-content">
                <div class="atelier-tier-left">
                  <div class="atelier-tier-name">2x Wardrobe Duo (Pair & Layer)</div>
                  <div class="atelier-tier-sub">Includes Complimentary Monogrammed Silk Scarf (Worth ₹4,500)</div>
                </div>
                <div class="atelier-tier-right">
                  <span class="atelier-tier-price">₹25,499</span>
                  <span class="atelier-tier-unit">₹12,749 / each</span>
                </div>
              </div>
            </label>

            <!-- Tier 3 -->
            <label class="atelier-tier-card" onclick="window.selectAtelierBundle('{{ section.id }}', 3, 33749, 65997, 'SAVE 49% (TRIO SUITE)')">
              <input type="radio" name="atelier_bundle_{{ section.id }}" value="3" class="atelier-tier-radio" />
              <div class="atelier-tier-content">
                <div class="atelier-tier-left">
                  <div class="atelier-tier-name">3x Collector Trio Suite</div>
                  <div class="atelier-tier-sub">Includes Italian Leather Garment Travel Bag + Priority Concierge</div>
                </div>
                <div class="atelier-tier-right">
                  <span class="atelier-tier-price">₹33,749</span>
                  <span class="atelier-tier-unit">₹11,249 / each</span>
                </div>
              </div>
            </label>
          </div>
        </div>

        <!-- ── COLOR SWATCHES ── -->
        <div class="atelier-variants-block">
          <div class="atelier-variant-header">
            <span class="atelier-variant-label">Color Finish:</span>
            <span class="atelier-variant-val" id="atelier-color-val-{{ section.id }}">Camel Heather</span>
          </div>
          <div class="atelier-swatches-grid">
            <button 
              type="button" 
              class="atelier-swatch-chip is-active" 
              data-color="Camel Heather"
              onclick="window.selectAtelierColor('{{ section.id }}', 'Camel Heather', this)"
            >
              <span class="atelier-swatch-circle" style="background: #bfa178;"></span>
              <span>Camel Heather</span>
            </button>
            <button 
              type="button" 
              class="atelier-swatch-chip" 
              data-color="Midnight Caviar"
              onclick="window.selectAtelierColor('{{ section.id }}', 'Midnight Caviar', this)"
            >
              <span class="atelier-swatch-circle" style="background: #11141a;"></span>
              <span>Midnight Caviar</span>
            </button>
            <button 
              type="button" 
              class="atelier-swatch-chip" 
              data-color="Chalk Alabaster"
              onclick="window.selectAtelierColor('{{ section.id }}', 'Chalk Alabaster', this)"
            >
              <span class="atelier-swatch-circle" style="background: #f0ebe1; border: 1px solid #d4cdc3;"></span>
              <span>Chalk Alabaster</span>
            </button>
          </div>
        </div>

        <!-- ── SIZE SELECTION WITH SIZE GUIDE ── -->
        <div class="atelier-sizes-block">
          <div class="atelier-variant-header">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="atelier-variant-label">Select Size:</span>
              <span class="atelier-variant-val" id="atelier-size-val-{{ section.id }}">S (38 IT/FR)</span>
            </div>
            <button type="button" class="atelier-size-guide-btn" onclick="window.openAtelierModal('{{ section.id }}')">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 3H3v18h18V3zM3 9h18M9 21V9"/></svg>
              <span>Fit & Tailoring Guide</span>
            </button>
          </div>
          <div class="atelier-sizes-grid">
            {%- assign sizes = "XS,S,M,L,XL" | split: "," -%}
            {%- for sz in sizes -%}
              <button 
                type="button" 
                class="atelier-size-pill {% if sz == 'S' %}is-active{% endif %}"
                data-size="{{ sz }}"
                onclick="window.selectAtelierSize('{{ section.id }}', '{{ sz }}', this)"
              >
                <span>{{ sz }}</span>
                {%- if sz == 'S' -%}
                  <span class="atelier-size-micro">Client Choice</span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        </div>

        <!-- ── ACTION CTA BUTTONS ── -->
        <div class="atelier-actions-row">
          <button 
            type="button" 
            class="atelier-primary-atc-btn" 
            id="atelier-atc-btn-{{ section.id }}"
            onclick="window.handleAtelierATC('{{ section.id }}')"
          >
            <span class="atelier-atc-label">ADD TO ATELIER BAG</span>
            <span class="atelier-atc-dot">•</span>
            <span class="atelier-atc-price" id="atelier-btn-price-{{ section.id }}">₹25,499</span>
          </button>

          <!-- 1-Click COD Direct Button -->
          <button 
            type="button" 
            class="atelier-cod-fast-btn" 
            onclick="window.handleAtelierCOD('{{ section.id }}')"
          >
            <div class="atelier-cod-inner">
              <span class="atelier-cod-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              </span>
              <div class="atelier-cod-copy">
                <div class="atelier-cod-title">CASH ON DELIVERY (DOORSTEP TRIAL)</div>
                <div class="atelier-cod-desc">Inspect garment at doorstep before payment • Free Returns</div>
              </div>
            </div>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>

        <!-- ── PINCODE DELIVERY ESTIMATOR ── -->
        <div class="atelier-pincode-card">
          <div class="atelier-pincode-title">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Guaranteed Express Delivery & Trial Availability</span>
          </div>
          <div class="atelier-pincode-input-row">
            <input 
              type="text" 
              id="atelier-pincode-{{ section.id }}" 
              class="atelier-pincode-field" 
              placeholder="Enter 6-digit Pincode (e.g. 110001)"
              maxlength="6"
            />
            <button type="button" class="atelier-pincode-check-btn" onclick="window.checkAtelierPincode('{{ section.id }}')">
              Calculate SLA
            </button>
          </div>
          <div class="atelier-pincode-msg" id="atelier-pincode-msg-{{ section.id }}">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Enter destination pincode for guaranteed dispatch timeline</span>
          </div>
        </div>

        <!-- ── 4 LUXURY ATELIER PILLARS ── -->
        <div class="atelier-trust-grid">
          <div class="atelier-trust-item">
            <div class="atelier-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <div class="atelier-trust-heading">Grade-A Mongolian Cashmere</div>
              <div class="atelier-trust-sub">Certified 100% sustainable yarns</div>
            </div>
          </div>

          <div class="atelier-trust-item">
            <div class="atelier-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <div>
              <div class="atelier-trust-heading">Air Express Doorstep Delivery</div>
              <div class="atelier-trust-sub">Dispatched within 24 business hours</div>
            </div>
          </div>

          <div class="atelier-trust-item">
            <div class="atelier-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
            </div>
            <div>
              <div class="atelier-trust-heading">15-Day Complimentary Trial</div>
              <div class="atelier-trust-sub">Effortless home fitting & exchanges</div>
            </div>
          </div>

          <div class="atelier-trust-item">
            <div class="atelier-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            </div>
            <div>
              <div class="atelier-trust-heading">Encrypted Checkout & COD</div>
              <div class="atelier-trust-sub">UPI • Cards • Doorstep Cash</div>
            </div>
          </div>
        </div>

        <!-- ── EDITORIAL ACCORDIONS ── -->
        <div class="atelier-accordions-wrap">
          <div class="atelier-acc-item is-open">
            <button type="button" class="atelier-acc-header" onclick="window.toggleAtelierAcc(this)">
              <div class="atelier-acc-title-group">
                <span class="atelier-acc-bullet">
                  <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6"/></svg>
                </span>
                <span class="atelier-acc-title">Bespoke Craftsmanship & Fiber Sourcing</span>
              </div>
              <span class="atelier-acc-indicator">+</span>
            </button>
            <div class="atelier-acc-body">
              <p>Woven on heritage looms from pure, unadulterated Mongolian virgin cashmere. The double-faced fabric construction eliminates bulky inner linings while retaining unparalleled insulating warmth with a sculptured, featherweight drape.</p>
              <ul class="atelier-features-list">
                <li>Double-faced 520 GSM Mongolian virgin cashmere</li>
                <li>Hand-finished bound seams with artisanal hand-pick stitching</li>
                <li>Hand-carved water horn buttons with subtle matte finish</li>
                <li>Internal tailored passport & smartphone breast pocket</li>
              </ul>
            </div>
          </div>

          <div class="atelier-acc-item">
            <button type="button" class="atelier-acc-header" onclick="window.toggleAtelierAcc(this)">
              <div class="atelier-acc-title-group">
                <span class="atelier-acc-bullet">
                  <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6"/></svg>
                </span>
                <span class="atelier-acc-title">Silhouette, Measurements & Layering</span>
              </div>
              <span class="atelier-acc-indicator">+</span>
            </button>
            <div class="atelier-acc-body">
              <p>Designed with an intentional contemporary relaxed silhouette. Falls elegantly below the knee. Engineered to layer seamlessly over tailored suits, chunky knitwear, or relaxed evening silk dresses without pulling or bunching.</p>
            </div>
          </div>

          <div class="atelier-acc-item">
            <button type="button" class="atelier-acc-header" onclick="window.toggleAtelierAcc(this)">
              <div class="atelier-acc-title-group">
                <span class="atelier-acc-bullet">
                  <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6"/></svg>
                </span>
                <span class="atelier-acc-title">Complimentary Concierge & Returns</span>
              </div>
              <span class="atelier-acc-indicator">+</span>
            </button>
            <div class="atelier-acc-body">
              <p>Every Atelier piece arrives housed within our signature breathable Italian cotton garment dust bag and wooden contoured hanger. Enjoy our complimentary 15-day doorstep home fitting service with hassle-free reverse courier pickup.</p>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- ── FLOATING STICKY ATC BAR ON MOBILE / DESKTOP SCROLL ── -->
  <div class="atelier-sticky-bar" id="atelier-sticky-bar-{{ section.id }}">
    <div class="atelier-sticky-inner">
      <div class="atelier-sticky-info">
        <img 
          src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=120&q=80" 
          alt="{{ p_title | escape }}" 
          class="atelier-sticky-thumb" 
        />
        <div class="atelier-sticky-text">
          <div class="atelier-sticky-title">{{ p_title }}</div>
          <div class="atelier-sticky-sub">
            <span class="atelier-sticky-price" id="atelier-sticky-price-{{ section.id }}">₹25,499</span>
            <span class="atelier-sticky-tag">Air Express • Guaranteed Dispatch</span>
          </div>
        </div>
      </div>
      <button 
        type="button" 
        class="atelier-sticky-cta" 
        onclick="window.handleAtelierATC('{{ section.id }}')"
      >
        <span>ADD TO BAG</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>

  <!-- ── TAILORING & SIZE GUIDE MODAL ── -->
  <div class="atelier-modal-overlay" id="atelier-modal-{{ section.id }}" onclick="if(event.target === this) window.closeAtelierModal('{{ section.id }}')">
    <div class="atelier-modal-content">
      <div class="atelier-modal-top">
        <h3 class="atelier-modal-heading">Atelier Tailoring & Sizing Guide</h3>
        <button type="button" class="atelier-modal-exit" onclick="window.closeAtelierModal('{{ section.id }}')" aria-label="Close modal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="atelier-modal-scroll">
        <p style="font-size: 13px; color: var(--atl-text-muted); margin-bottom: 16px;">
          All measurements are taken flat across the garment in inches. Designed with an intentional architectural drape.
        </p>
