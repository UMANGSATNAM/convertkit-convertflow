      img.style.opacity = '0.4';
      setTimeout(function() {
        img.src = imgSrc;
        img.style.opacity = '1';
      }, 120);
    }
    var strip = document.getElementById('atelier-thumbs-' + sectionId);
    if (strip) {
      var all = strip.querySelectorAll('.atelier-thumb-item');
      all.forEach(function(el) { el.classList.remove('is-active'); });
    }
    if (btn) btn.classList.add('is-active');
  };

  window.selectAtelierBundle = function(sectionId, qty, price, compareAt, saveText) {
    var sec = document.getElementById('atelier-pdp-' + sectionId);
    if (!sec) return;
    var cards = sec.querySelectorAll('.atelier-tier-card');
    cards.forEach(function(c) { c.classList.remove('is-active'); });
    event.currentTarget.classList.add('is-active');

    var pDisplay = document.getElementById('atelier-display-price-' + sectionId);
    var cDisplay = document.getElementById('atelier-display-compare-' + sectionId);
    var sDisplay = document.getElementById('atelier-display-save-' + sectionId);
    var btnPrice = document.getElementById('atelier-btn-price-' + sectionId);
    var stickyPrice = document.getElementById('atelier-sticky-price-' + sectionId);

    var formatted = '₹' + price.toLocaleString('en-IN');
    var compFormatted = '₹' + compareAt.toLocaleString('en-IN');

    if (pDisplay) pDisplay.innerText = formatted;
    if (cDisplay) cDisplay.innerText = compFormatted;
    if (sDisplay) sDisplay.innerText = saveText;
    if (btnPrice) btnPrice.innerText = formatted;
    if (stickyPrice) stickyPrice.innerText = formatted;
  };

  window.selectAtelierColor = function(sectionId, color, btn) {
    var sec = document.getElementById('atelier-pdp-' + sectionId);
    if (!sec) return;
    var chips = sec.querySelectorAll('.atelier-swatch-chip');
    chips.forEach(function(c) { c.classList.remove('is-active'); });
    btn.classList.add('is-active');
    var val = document.getElementById('atelier-color-val-' + sectionId);
    if (val) val.innerText = color;
  };

  window.selectAtelierSize = function(sectionId, size, btn) {
    var sec = document.getElementById('atelier-pdp-' + sectionId);
    if (!sec) return;
    var pills = sec.querySelectorAll('.atelier-size-pill');
    pills.forEach(function(p) { p.classList.remove('is-active'); });
    btn.classList.add('is-active');
    var val = document.getElementById('atelier-size-val-' + sectionId);
    if (val) val.innerText = size;
  };

  window.toggleAtelierAcc = function(btn) {
    var item = btn.closest('.atelier-acc-item');
    if (item) item.classList.toggle('is-open');
  };

  window.openAtelierModal = function(sectionId) {
    var m = document.getElementById('atelier-modal-' + sectionId);
    if (m) m.classList.add('is-open');
  };

  window.closeAtelierModal = function(sectionId) {
    var m = document.getElementById('atelier-modal-' + sectionId);
    if (m) m.classList.remove('is-open');
  };

  window.checkAtelierPincode = function(sectionId) {
    var input = document.getElementById('atelier-pincode-' + sectionId);
    var msg = document.getElementById('atelier-pincode-msg-' + sectionId);
    if (!input || !msg) return;
    var code = input.value.trim();
    if (code.length === 6 && /^\d+$/.test(code)) {
      msg.innerHTML = '<span style="color: #059669; font-weight: 700;">Guaranteed Doorstep Air Delivery to ' + code + ' in 2 business days. COD Available!</span>';
    } else {
      msg.innerHTML = '<span style="color: #dc2626; font-weight: 600;">Please enter a valid 6-digit postal pincode.</span>';
    }
  };

  window.handleAtelierATC = function(sectionId) {
    var btn = document.getElementById('atelier-atc-btn-' + sectionId);
    if (!btn) return;
    var original = btn.innerHTML;
    btn.innerHTML = '<span>ADDING TO ATELIER BAG...</span>';
    btn.style.opacity = '0.7';

    setTimeout(function() {
      btn.innerHTML = '<span style="color:#a7f3d0;">ADDED TO BAG</span>';
      btn.style.opacity = '1';
      setTimeout(function() {
        btn.innerHTML = original;
      }, 2400);
    }, 600);
  };

  window.handleAtelierCOD = function(sectionId) {
    alert('Atelier White-Glove Doorstep Trial selected! You will receive an SMS confirmation for OTP verification upon dispatch.');
  };

  // Sticky Scroll Observer
  document.addEventListener('DOMContentLoaded', function() {
    var bar = document.querySelector('.atelier-sticky-bar');
    if (!bar) return;
    window.addEventListener('scroll', function() {
      if (window.scrollY > 400) {
        bar.classList.add('is-visible');
      } else {
        bar.classList.remove('is-visible');
      }
    });
  });
})();
</script>

