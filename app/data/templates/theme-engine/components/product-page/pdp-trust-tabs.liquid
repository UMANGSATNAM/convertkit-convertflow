{% comment %}
  PDP Trust Tabs - Accordion & Specification Blocks
  Category: product-page
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --tab-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --tab-text: {{ section.settings.text_color | default: '#0f172a' }};
    background: var(--tab-bg);
    color: var(--tab-text);
    padding: clamp(32px, 5vw, 64px) 24px;
    font-family: inherit;
  }

  .cf-tabs-container {
    max-width: 860px;
    margin: 0 auto;
  }

  .cf-tabs-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .cf-tabs-heading {
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 800;
    margin: 0 0 10px 0;
    letter-spacing: -0.02em;
  }

  .cf-tabs-sub {
    font-size: 15px;
    color: #64748b;
    margin: 0;
  }

  .cf-acc-item {
    border-bottom: 1px solid #e2e8f0;
    transition: background-color 0.2s ease;
  }

  .cf-acc-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 8px;
    background: transparent;
    border: none;
    font-size: 16px;
    font-weight: 700;
    color: var(--tab-text);
    text-align: left;
    cursor: pointer;
  }

  .cf-acc-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 600;
    transition: transform 0.25s ease, background-color 0.2s;
  }

  .cf-acc-item.active .cf-acc-icon {
    transform: rotate(45deg);
    background: #0f172a;
    color: #ffffff;
  }

  .cf-acc-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1), padding 0.3s ease;
    padding: 0 8px;
    font-size: 15px;
    line-height: 1.65;
    color: #475569;
  }

  .cf-acc-item.active .cf-acc-body {
    max-height: 500px;
    padding-bottom: 24px;
  }
{%- endstyle -%}

<div class="cf-tabs-container">
  <div class="cf-tabs-header">
    <h2 class="cf-tabs-heading">{{ section.settings.heading | default: 'Specifications & Transparency' }}</h2>
    <p class="cf-tabs-sub">{{ section.settings.subheading | default: 'Everything you need to know about craftsmanship, materials, and care.' }}</p>
  </div>

  <div class="cf-acc-item active">
    <button type="button" class="cf-acc-trigger" onclick="this.parentElement.classList.toggle('active')">
      <span>🌿 Materials &amp; Ingredients</span>
      <span class="cf-acc-icon">+</span>
    </button>
    <div class="cf-acc-body">
      {{ section.settings.content_1 | default: '100% GOTS-certified organic cotton, ring-spun for exceptional softness. Harvested sustainably without synthetic fertilizers or chemical pesticides.' }}
    </div>
  </div>

  <div class="cf-acc-item">
    <button type="button" class="cf-acc-trigger" onclick="this.parentElement.classList.toggle('active')">
      <span>🚚 Shipping, Customs &amp; Free Returns</span>
      <span class="cf-acc-icon">+</span>
    </button>
    <div class="cf-acc-body">
      {{ section.settings.content_2 | default: 'Free domestic express shipping on all orders over $50. All deliveries arrive in 100% recycled biodegradable compostable mailers with 30-day no-questions-asked free exchanges.' }}
    </div>
  </div>

  <div class="cf-acc-item">
    <button type="button" class="cf-acc-trigger" onclick="this.parentElement.classList.toggle('active')">
      <span>🛡️ Lifetime Quality Guarantee</span>
      <span class="cf-acc-icon">+</span>
    </button>
    <div class="cf-acc-body">
      {{ section.settings.content_3 | default: 'We stand behind the engineering of every stitch. If any seam, zipper, or hardware fails during normal use within 2 years, we replace it free of charge.' }}
    </div>
  </div>

  <div class="cf-acc-item">
    <button type="button" class="cf-acc-trigger" onclick="this.parentElement.classList.toggle('active')">
      <span>🧼 Care Instructions &amp; Maintenance</span>
      <span class="cf-acc-icon">+</span>
    </button>
    <div class="cf-acc-body">
      {{ section.settings.content_4 | default: 'Machine wash cold with like colors. Tumble dry on low or hang dry for longest garment life. Do not bleach or dry clean.' }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PDP Trust Tabs",
  "tag": "section",
  "class": "cf-pdp-trust-tabs-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0f172a"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Specifications & Transparency"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know about craftsmanship, materials, and care."
    },
    {
      "type": "textarea",
      "id": "content_1",
      "label": "Materials tab content",
      "default": "100% GOTS-certified organic cotton, ring-spun for exceptional softness. Harvested sustainably without synthetic fertilizers."
    },
    {
      "type": "textarea",
      "id": "content_2",
      "label": "Shipping tab content",
      "default": "Free domestic express shipping on all orders over $50. All deliveries arrive in 100% recycled biodegradable compostable mailers."
    },
    {
      "type": "textarea",
      "id": "content_3",
      "label": "Guarantee tab content",
      "default": "We stand behind the engineering of every stitch. If any seam, zipper, or hardware fails within 2 years, we replace it free."
    },
    {
      "type": "textarea",
      "id": "content_4",
      "label": "Care tab content",
      "default": "Machine wash cold with like colors. Tumble dry on low or hang dry for longest garment life. Do not bleach."
    }
  ],
  "presets": [
    {
      "name": "PDP Trust Tabs",
      "settings": {
        "heading": "Specifications & Transparency"
      }
    }
  ]
}
{% endschema %}
