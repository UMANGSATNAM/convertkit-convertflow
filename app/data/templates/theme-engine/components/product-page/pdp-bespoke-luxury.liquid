{%- comment -%}
  Section: Bespoke Luxury PDP (Handcrafted)
  Niche: Premium Skincare / Beauty / Fragrance / High-End D2C
  Aesthetics: Champagne Gold, Warm Cream, Glassmorphic Surfaces, Playfair Serif Header
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign on_sale = false -%}
{%- if current_variant.compare_at_price > current_variant.price -%}
  {%- assign on_sale = true -%}
{%- endif -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

  .pdp-luxury-{{ section.id }} {
    --lux-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
    --lux-surface: rgba(255, 255, 255, 0.82);
    --lux-surface-solid: #FFFFFF;
    --lux-text: #1C1917;
    --lux-muted: #78716C;
    --lux-border: #E7E5E4;
    --lux-gold: {{ section.settings.accent_color | default: '#B45309' }};
    --lux-gold-light: #FEF3C7;
    --lux-font-heading: 'Cormorant Garamond', serif;
    --lux-font-body: 'Plus Jakarta Sans', sans-serif;
    
    background-color: var(--lux-bg);
    color: var(--lux-text);
    font-family: var(--lux-font-body);
    padding: 40px 16px;
    line-height: 1.6;
  }

  .pdp-luxury-container {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 992px) {
    .pdp-luxury-container {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 56px;
    }
  }

  /* Gallery */
  .pdp-luxury-gallery {
    position: relative;
  }
  @media (min-width: 992px) {
    .pdp-luxury-gallery {
      position: sticky;
      top: 40px;
      height: fit-content;
    }
  }

  .pdp-luxury-main-img {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: #FFF;
    border: 1px solid var(--lux-border);
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    margin-bottom: 16px;
    aspect-ratio: 4/5;
    position: relative;
  }

  .pdp-luxury-main-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .pdp-luxury-main-img:hover img {
    transform: scale(1.03);
  }

  .pdp-luxury-thumbs {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 8px;
  }

  .pdp-luxury-thumb {
    width: 80px;
    height: 96px;
    border-radius: 10px;
    border: 1.5px solid var(--lux-border);
    cursor: pointer;
    overflow: hidden;
    flex-shrink: 0;
    transition: all 0.2s ease;
    background: #FFF;
  }

  .pdp-luxury-thumb.is-active,
  .pdp-luxury-thumb:hover {
    border-color: var(--lux-gold);
    box-shadow: 0 0 0 2px rgba(180, 83, 9, 0.2);
  }

  .pdp-luxury-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Info Column */
  .pdp-luxury-info {
    display: flex;
    flex-direction: column;
  }

  .pdp-luxury-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--lux-gold);
    background: var(--lux-gold-light);
    padding: 4px 12px;
    border-radius: 99px;
    width: fit-content;
    margin-bottom: 14px;
  }

  .pdp-luxury-title {
    font-family: var(--lux-font-heading);
    font-size: 38px;
    font-weight: 600;
    line-height: 1.15;
    margin: 0 0 12px 0;
    letter-spacing: -0.02em;
  }

  @media (min-width: 768px) {
    .pdp-luxury-title {
      font-size: 46px;
    }
  }

  .pdp-luxury-subtitle {
    font-size: 15px;
    color: var(--lux-muted);
    margin-bottom: 20px;
  }

  /* Price */
  .pdp-luxury-price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--lux-border);
  }

  .pdp-luxury-price-current {
    font-family: var(--lux-font-heading);
    font-size: 36px;
    font-weight: 600;
    color: var(--lux-text);
  }

  .pdp-luxury-price-compare {
    font-size: 18px;
    color: var(--lux-muted);
    text-decoration: line-through;
  }

  .pdp-luxury-save-tag {
    font-size: 12px;
    font-weight: 700;
    color: #047857;
    background: #D1FAE5;
    padding: 3px 8px;
    border-radius: 6px;
  }

  /* Swatches */
  .pdp-luxury-section-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--lux-text);
    margin-bottom: 12px;
  }

  .pdp-luxury-swatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 12px;
    margin-bottom: 28px;
  }

  .pdp-luxury-swatch-card {
    position: relative;
    background: var(--lux-surface);
    backdrop-filter: blur(8px);
    border: 1.5px solid var(--lux-border);
    border-radius: 12px;
    padding: 16px 12px;
    text-align: center;
    cursor: pointer;
    transition: all 0.25 ease;
  }

  .pdp-luxury-swatch-card:hover,
  .pdp-luxury-swatch-card.is-selected {
    border-color: var(--lux-gold);
    background: #FFF;
    box-shadow: 0 6px 20px rgba(180, 83, 9, 0.1);
  }

  .pdp-luxury-swatch-title {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .pdp-luxury-swatch-price {
    font-size: 13px;
    color: var(--lux-muted);
  }

  /* Ingredients Highlight Grid */
  .pdp-luxury-ingredients {
    background: var(--lux-surface-solid);
    border: 1px solid var(--lux-border);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 28px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
  }

  .pdp-luxury-ingredients-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    text-align: center;
    margin-top: 12px;
  }

  .pdp-luxury-ing-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--lux-bg);
    border: 1px solid var(--lux-border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 8px auto;
    color: var(--lux-gold);
  }

  .pdp-luxury-ing-title {
    font-size: 13px;
    font-weight: 600;
  }

  /* Actions */
  .pdp-luxury-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 24px;
  }

  .pdp-luxury-qty {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--lux-border);
    border-radius: 12px;
    background: #FFF;
    padding: 0 8px;
  }

  .pdp-luxury-qty button {
    background: none;
    border: none;
    width: 36px;
    height: 48px;
    font-size: 18px;
    cursor: pointer;
    color: var(--lux-text);
  }

  .pdp-luxury-qty input {
    width: 40px;
    text-align: center;
    border: none;
    font-size: 15px;
    font-weight: 600;
    outline: none;
  }

  .pdp-luxury-atc-btn {
    flex: 1;
    background: var(--lux-text);
    color: #FFF;
    border: none;
    border-radius: 12px;
    padding: 16px 28px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 0 4px 14px rgba(28, 25, 23, 0.15);
  }

  .pdp-luxury-atc-btn:hover {
    background: var(--lux-gold);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(180, 83, 9, 0.25);
  }

  /* Trust Grid */
  .pdp-luxury-trust-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    padding: 16px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 12px;
    border: 1px solid var(--lux-border);
    margin-bottom: 28px;
    font-size: 12px;
    text-align: center;
    color: var(--lux-muted);
  }

  .pdp-luxury-trust-bar svg {
    width: 20px;
    height: 20px;
    color: var(--lux-gold);
    margin-bottom: 4px;
  }

  /* Accordions */
  .pdp-luxury-accordion {
    border-top: 1px solid var(--lux-border);
  }

  .pdp-luxury-accordion-item {
    border-bottom: 1px solid var(--lux-border);
  }

  .pdp-luxury-accordion-header {
    width: 100%;
    background: none;
    border: none;
    padding: 18px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 15px;
    font-weight: 600;
    color: var(--lux-text);
    cursor: pointer;
  }

  .pdp-luxury-accordion-body {
    display: none;
    padding-bottom: 18px;
    font-size: 14px;
    color: var(--lux-muted);
    line-height: 1.7;
  }

  .pdp-luxury-accordion-item.is-open .pdp-luxury-accordion-body {
    display: block;
  }

  /* Sticky Footer ATC */
  .pdp-luxury-sticky-bar {
    position: fixed;
    bottom: -100px;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--lux-border);
    padding: 12px 24px;
    z-index: 999;
    transition: bottom 0.3s ease;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.06);
  }

  .pdp-luxury-sticky-bar.is-visible {
    bottom: 0;
  }

  .pdp-luxury-sticky-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
</style>

<div class="pdp-luxury-{{ section.id }}">
  <div class="pdp-luxury-container">
    
    <!-- LEFT: GALLERY -->
    <div class="pdp-luxury-gallery">
      <div class="pdp-luxury-main-img" id="lux-main-viewport-{{ section.id }}">
        {% if product.featured_media %}
          <img src="{{ product.featured_media | image_url: width: 1000 }}" alt="{{ product.title | escape }}" id="lux-main-img-{{ section.id }}" width="1000" height="1250">
        {% else %}
          {{ 'product-1' | placeholder_svg_tag }}
        {% endif %}
      </div>

      {% if product.media.size > 1 %}
        <div class="pdp-luxury-thumbs">
          {% for media in product.media limit: 6 %}
            <div class="pdp-luxury-thumb {% if forloop.first %}is-active{% endif %}" onclick="changeLuxImage('{{ media | image_url: width: 1000 }}', this)">
              <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | default: product.title | escape }}" width="200" height="240" loading="lazy">
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- RIGHT: PRODUCT INFO -->
    <div class="pdp-luxury-info">
      
      <div class="pdp-luxury-badge">{{ section.settings.badge_text | default: 'BOTANICAL FORMULATION' }}</div>
      
      <h1 class="pdp-luxury-title">{{ product.title }}</h1>
      <div class="pdp-luxury-subtitle">{{ section.settings.subtitle | default: 'Deep hydration & cellular rejuvenation elixir.' }}</div>

      <!-- PRICE ROW -->
      <div class="pdp-luxury-price-row">
        <span class="pdp-luxury-price-current">{{ current_variant.price | money }}</span>
        {% if on_sale %}
          <span class="pdp-luxury-price-compare">{{ current_variant.compare_at_price | money }}</span>
          {% assign save_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price %}
          <span class="pdp-luxury-save-tag">SAVE {{ save_pct }}%</span>
        {% endif %}
      </div>

      <!-- VARIANT SELECTION -->
      {% if product.variants.size > 1 %}
        <div class="pdp-luxury-section-label">Select Option</div>
        <div class="pdp-luxury-swatches">
          {% for variant in product.variants limit: 4 %}
            <div class="pdp-luxury-swatch-card {% if variant.id == current_variant.id %}is-selected{% endif %}" onclick="selectLuxVariant('{{ variant.id }}', '{{ variant.price | money }}', this)">
              <div class="pdp-luxury-swatch-title">{{ variant.title }}</div>
              <div class="pdp-luxury-swatch-price">{{ variant.price | money }}</div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <!-- INGREDIENTS HIGHLIGHT -->
      {% if section.settings.show_ingredients %}
        <div class="pdp-luxury-ingredients">
          <div class="pdp-luxury-section-label" style="margin-bottom:8px;">Key Actives</div>
          <div class="pdp-luxury-ingredients-grid">
            <div>
              <div class="pdp-luxury-ing-icon">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
              </div>
              <div class="pdp-luxury-ing-title">{{ section.settings.ing1 | default: 'Hyaluronic Acid' }}</div>
            </div>
            <div>
              <div class="pdp-luxury-ing-icon">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
              </div>
              <div class="pdp-luxury-ing-title">{{ section.settings.ing2 | default: 'Niacinamide 5%' }}</div>
            </div>
            <div>
              <div class="pdp-luxury-ing-icon">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
              </div>
              <div class="pdp-luxury-ing-title">{{ section.settings.ing3 | default: 'Rosehip Seed' }}</div>
            </div>
          </div>
        </div>
      {% endif %}

      <!-- ACTIONS ROW -->
      <div class="pdp-luxury-actions">
        <div class="pdp-luxury-qty">
          <button type="button" onclick="adjustLuxQty(-1)">-</button>
          <input type="number" id="lux-qty-input-{{ section.id }}" value="1" min="1" readonly>
          <button type="button" onclick="adjustLuxQty(1)">+</button>
        </div>

        <button type="button" class="pdp-luxury-atc-btn">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          ADD TO CART — <span id="lux-btn-price-{{ section.id }}">{{ current_variant.price | money }}</span>
        </button>
      </div>

      <!-- TRUST BAR -->
      <div class="pdp-luxury-trust-bar">
        <div>
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          <div>100% Organic</div>
        </div>
        <div>
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          <div>Free Express Shipping</div>
        </div>
        <div>
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <div>Dermatologist Tested</div>
        </div>
      </div>

      <!-- ACCORDION -->
      <div class="pdp-luxury-accordion">
        <div class="pdp-luxury-accordion-item is-open">
          <button type="button" class="pdp-luxury-accordion-header" onclick="toggleLuxAccordion(this)">
            <span>Description & Formula</span>
            <span>+</span>
          </button>
          <div class="pdp-luxury-accordion-body">
            {{ product.description | default: 'Formulated with ultra-pure botanical actives to restore skin vibrancy, improve elasticity, and protect against environmental stressors.' }}
          </div>
        </div>

        <div class="pdp-luxury-accordion-item">
          <button type="button" class="pdp-luxury-accordion-header" onclick="toggleLuxAccordion(this)">
            <span>How to Apply</span>
            <span>+</span>
          </button>
          <div class="pdp-luxury-accordion-body">
            Apply 3-4 drops onto clean, dry face every morning and evening. Gently press into skin with fingertips until fully absorbed.
          </div>
        </div>

        <div class="pdp-luxury-accordion-item">
          <button type="button" class="pdp-luxury-accordion-header" onclick="toggleLuxAccordion(this)">
            <span>Shipping & Returns</span>
            <span>+</span>
          </button>
          <div class="pdp-luxury-accordion-body">
            Free shipping on orders above ₹499. Orders dispatched within 24 hours. Hassle-free 7-day returns policy.
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- STICKY BOTTOM BAR -->
<div class="pdp-luxury-sticky-bar" id="lux-sticky-bar-{{ section.id }}">
  <div class="pdp-luxury-sticky-inner">
    <div style="display:flex; align-items:center; gap:12px;">
      {% if product.featured_media %}
        <img src="{{ product.featured_media | image_url: width: 80 }}" alt="" width="44" height="44" style="border-radius:6px; object-fit:cover;">
      {% endif %}
      <div>
        <div style="font-weight:600; font-size:14px; color:var(--lux-text);">{{ product.title }}</div>
        <div style="font-size:13px; color:var(--lux-gold); font-weight:600;">{{ current_variant.price | money }}</div>
      </div>
    </div>
    <button type="button" class="pdp-luxury-atc-btn" style="padding: 12px 24px; width:auto;" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
      ADD TO CART
    </button>
  </div>
</div>

<script>
  function changeLuxImage(src, thumbEl) {
    const mainImg = document.getElementById('lux-main-img-{{ section.id }}');
    if (mainImg) mainImg.src = src;
    document.querySelectorAll('.pdp-luxury-thumb').forEach(t => t.classList.remove('is-active'));
    if (thumbEl) thumbEl.classList.add('is-active');
  }

  function selectLuxVariant(id, priceStr, cardEl) {
    document.querySelectorAll('.pdp-luxury-swatch-card').forEach(c => c.classList.remove('is-selected'));
    if (cardEl) cardEl.classList.add('is-selected');
    const priceBtn = document.getElementById('lux-btn-price-{{ section.id }}');
    if (priceBtn) priceBtn.textContent = priceStr;
  }

  function adjustLuxQty(delta) {
    const input = document.getElementById('lux-qty-input-{{ section.id }}');
    if (input) {
      let val = parseInt(input.value || 1, 10) + delta;
      if (val < 1) val = 1;
      input.value = val;
    }
  }

  function toggleLuxAccordion(headerEl) {
    const item = headerEl.closest('.pdp-luxury-accordion-item');
    if (item) {
      item.classList.toggle('is-open');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const stickyBar = document.getElementById('lux-sticky-bar-{{ section.id }}');
    if (stickyBar) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 500) {
          stickyBar.classList.add('is-visible');
        } else {
          stickyBar.classList.remove('is-visible');
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Bespoke Luxury PDP",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF8F5" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#B45309" },
    { "type": "text", "id": "badge_text", "label": "Badge Text", "default": "BOTANICAL FORMULATION" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Deep hydration & cellular rejuvenation elixir." },
    { "type": "checkbox", "id": "show_ingredients", "label": "Show Key Actives Grid", "default": true },
    { "type": "text", "id": "ing1", "label": "Active 1", "default": "Hyaluronic Acid" },
    { "type": "text", "id": "ing2", "label": "Active 2", "default": "Niacinamide 5%" },
    { "type": "text", "id": "ing3", "label": "Active 3", "default": "Rosehip Seed" }
  ],
  "presets": [{ "name": "Bespoke Luxury PDP" }]
}
{% endschema %}
