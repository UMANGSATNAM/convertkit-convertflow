{% comment %}
  PDP Frequently Bought Together (FBT) Bundle
  Category: product-page
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --fbt-bg: {{ section.settings.bg_color | default: '#f8fafc' }};
    --fbt-text: {{ section.settings.text_color | default: '#0f172a' }};
    --fbt-accent: {{ section.settings.accent_color | default: '#2563eb' }};
    background: var(--fbt-bg);
    color: var(--fbt-text);
    padding: clamp(32px, 5vw, 60px) 24px;
    border-radius: 24px;
    font-family: inherit;
    margin: 30px auto;
    max-width: 1100px;
    border: 1px solid #e2e8f0;
  }

  .cf-fbt-title {
    font-size: 22px;
    font-weight: 800;
    margin: 0 0 6px 0;
  }

  .cf-fbt-sub {
    font-size: 14px;
    color: #64748b;
    margin: 0 0 28px 0;
  }

  .cf-fbt-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }

  .cf-fbt-items {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .cf-fbt-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 140px;
    text-align: center;
  }

  .cf-fbt-img-wrap {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: 16px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    margin-bottom: 10px;
  }

  .cf-fbt-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cf-fbt-checkbox {
    position: absolute;
    top: 8px;
    left: 8px;
    width: 18px;
    height: 18px;
    accent-color: var(--fbt-accent);
    cursor: pointer;
  }

  .cf-fbt-item-title {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 4px 0;
  }

  .cf-fbt-item-price {
    font-size: 13px;
    font-weight: 800;
    color: var(--fbt-accent);
  }

  .cf-fbt-plus {
    font-size: 24px;
    font-weight: 800;
    color: #94a3b8;
  }

  .cf-fbt-summary {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 24px;
    min-width: 260px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .cf-fbt-total-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .cf-fbt-total-price {
    font-size: 24px;
    font-weight: 900;
    color: #0f172a;
  }

  .cf-fbt-save-pill {
    display: inline-block;
    background: #dcfce7;
    color: #15803d;
    font-size: 12px;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 999px;
  }

  .cf-fbt-btn {
    background: var(--fbt-accent);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 14px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.1s;
    width: 100%;
  }

  .cf-fbt-btn:hover {
    opacity: 0.92;
  }

  .cf-fbt-btn:active {
    transform: scale(0.98);
  }
{%- endstyle -%}

<div class="cf-fbt-container">
  <h2 class="cf-fbt-title">{{ section.settings.heading | default: 'Frequently Bought Together' }}</h2>
  <p class="cf-fbt-sub">{{ section.settings.subheading | default: 'Bundle up these matching essentials and get an instant 15% discount.' }}</p>

  <div class="cf-fbt-grid">
    <div class="cf-fbt-items">
      <div class="cf-fbt-card">
        <div class="cf-fbt-img-wrap">
          <input type="checkbox" class="cf-fbt-checkbox" checked disabled>
          <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=200&q=80" alt="Main item" class="cf-fbt-img" width="120" height="120">
        </div>
        <div class="cf-fbt-item-title">Classic Heavy Tee</div>
        <div class="cf-fbt-item-price">$45.00</div>
      </div>

      <span class="cf-fbt-plus">+</span>

      <div class="cf-fbt-card">
        <div class="cf-fbt-img-wrap">
          <input type="checkbox" class="cf-fbt-checkbox" checked>
          <img src="https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=200&q=80" alt="Hoodie" class="cf-fbt-img" width="120" height="120">
        </div>
        <div class="cf-fbt-item-title">Vintage Oversized Hoodie</div>
        <div class="cf-fbt-item-price">$78.00</div>
      </div>

      <span class="cf-fbt-plus">+</span>

      <div class="cf-fbt-card">
        <div class="cf-fbt-img-wrap">
          <input type="checkbox" class="cf-fbt-checkbox" checked>
          <img src="https://images.unsplash.com/photo-1576995853123-5a10305d93c0?w=200&q=80" alt="Cap" class="cf-fbt-img" width="120" height="120">
        </div>
        <div class="cf-fbt-item-title">Embroidered Dad Cap</div>
        <div class="cf-fbt-item-price">$28.00</div>
      </div>
    </div>

    <div class="cf-fbt-summary">
      <div class="cf-fbt-save-pill">BUNDLE &amp; SAVE 15%</div>
      <div class="cf-fbt-total-row">
        <span style="font-size:13px;color:#64748b;">Total Price:</span>
        <div>
          <span style="text-decoration:line-through;color:#94a3b8;font-size:14px;margin-right:6px;">$151.00</span>
          <span class="cf-fbt-total-price">$128.00</span>
        </div>
      </div>
      <button type="button" class="cf-fbt-btn" onclick="
        var b = this;
        b.innerText = 'Bundle Added to Bag! 🎉';
        setTimeout(function(){ b.innerText = 'Add All 3 to Cart'; }, 2000);
      ">
        Add All 3 to Cart
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PDP Bundle FBT",
  "tag": "section",
  "class": "cf-pdp-bundle-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Button color",
      "default": "#2563eb"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Bought Together"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Bundle up these matching essentials and get an instant 15% discount."
    }
  ],
  "presets": [
    {
      "name": "PDP Bundle FBT",
      "settings": {
        "heading": "Frequently Bought Together"
      }
    }
  ]
}
{% endschema %}
