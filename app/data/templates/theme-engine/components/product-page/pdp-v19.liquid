{%- comment -%}
  PDP V19: MODERN INTIMATES (Skims Style)
  Aesthetic: Earth Tones, Seamless, Inclusive.
  CRO: Tiered Bundles (Buy 3 save 20%), Skin-tone swatches.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600&display=swap');

  :root {
    --v19-bg: #F7F5F0; /* Warm Earthy Beige */
    --v19-surface: #FFFFFF;
    --v19-text: #3D352F; /* Warm Dark Brown */
    --v19-text-light: #8B837A;
    --v19-border: #E8E3DD;
    --v19-accent: #C7AE9A;
    --v19-font: 'Jost', sans-serif;
  }

  .pdp-v19 {
    background-color: var(--v19-bg);
    color: var(--v19-text);
    font-family: var(--v19-font);
    line-height: 1.5;
  }

  .pdp-v19__container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
  }
  @media (min-width: 992px) {
    .pdp-v19__container { grid-template-columns: 1fr 500px; }
  }

  /* --- GALLERY --- */
  .pdp-v19__gallery {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2px;
  }
  .pdp-v19__gallery img, .pdp-v19__gallery svg {
    width: 100%; height: 100%; object-fit: cover; aspect-ratio: 3/4; background: var(--v19-accent);
  }
  @media (max-width: 991px) {
    .pdp-v19__gallery { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 0; }
    .pdp-v19__gallery img, .pdp-v19__gallery svg { min-width: 100%; scroll-snap-align: start; }
  }

  /* --- INFO --- */
  .pdp-v19__info {
    padding: 32px 24px;
    background: var(--v19-bg);
  }
  @media (min-width: 992px) {
    .pdp-v19__info { padding: 60px 40px; position: sticky; top: 0; height: 100vh; overflow-y: auto; }
  }

  .pdp-v19__title { font-size: 28px; font-weight: 500; margin: 0 0 12px 0; letter-spacing: -0.5px; }
  
  .pdp-v19__price-wrap { display: flex; align-items: baseline; gap: 12px; margin-bottom: 32px; }
  .pdp-v19__price { font-size: 22px; font-weight: 600; }

  /* --- SKIN TONE SWATCHES --- */
  .pdp-v19__swatches { margin-bottom: 24px; }
  .pdp-v19__label { font-size: 12px; font-weight: 500; text-transform: uppercase; margin-bottom: 12px; display: block; letter-spacing: 1px; color: var(--v19-text-light); }
  .pdp-v19__label span { color: var(--v19-text); font-weight: 600; }
  .pdp-v19__swatch-wrap { display: flex; gap: 8px; flex-wrap: wrap; }
  .pdp-v19__swatch {
    width: 32px; height: 32px; border-radius: 50%; cursor: pointer; border: 1px solid var(--v19-border);
    transition: all 0.2s; position: relative;
  }
  .pdp-v19__swatch.active { border-color: var(--v19-text); padding: 2px; }
  .pdp-v19__swatch.active::after {
    content:''; position: absolute; top:2px; left:2px; right:2px; bottom:2px; border-radius: 50%; background: inherit; border: 1px solid #FFF;
  }

  /* --- SIZES --- */
  .pdp-v19__sizes { margin-bottom: 32px; }
  .pdp-v19__size-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
  .pdp-v19__size {
    border: 1px solid var(--v19-border); padding: 12px 0; text-align: center;
    font-size: 13px; font-weight: 500; cursor: pointer; border-radius: 4px; background: var(--v19-surface);
  }
  .pdp-v19__size.active { background: var(--v19-text); color: #FFF; border-color: var(--v19-text); }

  /* --- TIERED BUNDLES (CRO) --- */
  .pdp-v19__bundles { margin-bottom: 32px; }
  .pdp-v19__bundle {
    border: 1px solid var(--v19-border); background: var(--v19-surface); border-radius: 8px;
    padding: 16px; margin-bottom: 12px; cursor: pointer; display: flex; justify-content: space-between; align-items: center;
    transition: border-color 0.2s;
  }
  .pdp-v19__bundle.active { border: 2px solid var(--v19-text); }
  .pdp-v19__b-left { display: flex; align-items: center; gap: 12px; }
  .pdp-v19__b-radio {
    width: 18px; height: 18px; border: 1px solid var(--v19-text-light); border-radius: 50%; display: flex; align-items: center; justify-content: center;
  }
  .pdp-v19__bundle.active .pdp-v19__b-radio { border-color: var(--v19-text); }
  .pdp-v19__bundle.active .pdp-v19__b-radio::after { content:''; width: 10px; height: 10px; background: var(--v19-text); border-radius: 50%; }
  
  .pdp-v19__b-title { font-size: 14px; font-weight: 600; margin-bottom: 2px; }
  .pdp-v19__b-badge { background: #EFE8E1; color: var(--v19-text); font-size: 11px; padding: 2px 6px; border-radius: 4px; font-weight: 500; }
  .pdp-v19__b-price { font-size: 15px; font-weight: 600; }
  .pdp-v19__b-compare { font-size: 12px; color: var(--v19-text-light); text-decoration: line-through; display: block; text-align: right; }

  /* --- ATC --- */
  .pdp-v19__atc {
    width: 100%; background: var(--v19-text); color: #FFF; border: none; padding: 18px;
    font-family: var(--v19-font); font-size: 15px; font-weight: 500; text-transform: uppercase; letter-spacing: 2px;
    border-radius: 30px; cursor: pointer; margin-bottom: 32px; transition: opacity 0.2s;
  }
  .pdp-v19__atc:hover { opacity: 0.9; }

  /* --- ACCORDIONS --- */
  .pdp-v19__acc { border-top: 1px solid var(--v19-border); }
  .pdp-v19__acc:last-child { border-bottom: 1px solid var(--v19-border); }
  .pdp-v19__acc-btn {
    width: 100%; text-align: left; background: none; border: none; padding: 20px 0;
    font-family: var(--v19-font); font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;
    display: flex; justify-content: space-between; cursor: pointer;
  }
  .pdp-v19__acc-content { padding-bottom: 20px; font-size: 14px; color: var(--v19-text-light); line-height: 1.6; }

  /* --- STICKY ATC --- */
  .pdp-v19-sticky {
    position: fixed; bottom: -100px; left: 0; width: 100%; background: var(--v19-bg); box-shadow: 0 -4px 20px rgba(61,53,47,0.05);
    z-index: 999; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center;
    transition: bottom 0.3s ease; border-top: 1px solid var(--v19-border);
  }
  .pdp-v19-sticky.visible { bottom: 0; }
  .pdp-v19-sticky__title { font-weight: 500; font-size: 15px; }
  .pdp-v19-sticky__btn {
    background: var(--v19-text); color: #FFF; border: none; padding: 12px 32px;
    font-family: var(--v19-font); font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 1px; border-radius: 20px; cursor: pointer;
  }

</style>

<div class="pdp-v19" data-section="{{ section.id }}">
  
  <div class="pdp-v19__container">
    
    <!-- GALLERY -->
    <div class="pdp-v19__gallery">
      {% if product.featured_media %}
        {% for media in product.media limit: 4 %}
          <img src="{{ media | image_url: width: 800 }}"
               alt="{{ media.alt | default: product.title | escape }}"
               width="800" height="800"
               {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
        {% endfor %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag }}
        {{ 'product-2' | placeholder_svg_tag }}
        {{ 'product-3' | placeholder_svg_tag }}
        {{ 'product-4' | placeholder_svg_tag }}
      {% endif %}
    </div>

    <!-- INFO BOX -->
    <div class="pdp-v19__info">
      
      <h1 class="pdp-v19__title">{{ product.title | default: "Fits Everybody Sculpting Bralette" }}</h1>
      
      <!-- URGENCY SECTION -->
      {% if section.settings.show_urgency %}
        <div style="background: rgba(199, 174, 154, 0.15); border: 1px solid var(--v19-accent); padding: 12px 16px; border-radius: 4px; display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
          <div style="width: 8px; height: 8px; background: #D9534F; border-radius: 50%; box-shadow: 0 0 0 4px rgba(217,83,79,0.2); animation: pulse 2s infinite;"></div>
          <style>@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(217,83,79,0.4); } 70% { box-shadow: 0 0 0 6px rgba(217,83,79,0); } 100% { box-shadow: 0 0 0 0 rgba(217,83,79,0); } }</style>
          <div>
            <div style="font-weight: 600; font-size: 13px; color: var(--v19-text);">Almost Sold Out</div>
            <div style="font-size: 12px; color: var(--v19-text-light);">Only a few pieces left in this shade.</div>
          </div>
        </div>
      {% endif %}

      <div class="pdp-v19__price-wrap">
        <span class="pdp-v19__price">{{ current_variant.price | money }}</span>
      </div>

      <div class="pdp-v19__swatches">
        <span class="pdp-v19__label">Color: <span>Clay</span></span>
        <div class="pdp-v19__swatch-wrap">
          <div class="pdp-v19__swatch" style="background: #F3E5DB;"></div>
          <div class="pdp-v19__swatch" style="background: #E8D0BB;"></div>
          <div class="pdp-v19__swatch active" style="background: #C39977;"></div>
          <div class="pdp-v19__swatch" style="background: #8F5C38;"></div>
          <div class="pdp-v19__swatch" style="background: #4A2B18;"></div>
          <div class="pdp-v19__swatch" style="background: #252220;"></div>
        </div>
      </div>

      <div class="pdp-v19__sizes">
        <div style="display:flex; justify-content:space-between;">
          <span class="pdp-v19__label">Size</span>
          <span class="pdp-v19__label" style="text-decoration:underline; cursor:pointer;">Size Guide</span>
        </div>
        <div class="pdp-v19__size-grid">
          <div class="pdp-v19__size">XXS</div>
          <div class="pdp-v19__size">XS</div>
          <div class="pdp-v19__size active">S</div>
          <div class="pdp-v19__size">M</div>
          <div class="pdp-v19__size">L</div>
          <div class="pdp-v19__size">XL</div>
          <div class="pdp-v19__size">2X</div>
          <div class="pdp-v19__size">3X</div>
          <div class="pdp-v19__size">4X</div>
        </div>
      </div>

      <!-- TIERED BUNDLES -->
      {% if section.settings.show_bundles %}
        <div class="pdp-v19__bundles">
          
          <div class="pdp-v19__bundle" onclick="document.querySelectorAll('.pdp-v19__bundle').forEach(el=>el.classList.remove('active')); this.classList.add('active');">
            <div class="pdp-v19__b-left">
              <div class="pdp-v19__b-radio"></div>
              <div>
                <div class="pdp-v19__b-title">Buy 1</div>
              </div>
            </div>
            <div>
              <div class="pdp-v19__b-price">₹1,499</div>
            </div>
          </div>

          <div class="pdp-v19__bundle active" onclick="document.querySelectorAll('.pdp-v19__bundle').forEach(el=>el.classList.remove('active')); this.classList.add('active');">
            <div class="pdp-v19__b-left">
              <div class="pdp-v19__b-radio"></div>
              <div>
                <div class="pdp-v19__b-title">Buy 3 <span class="pdp-v19__b-badge">Save 20%</span></div>
              </div>
            </div>
            <div>
              <div class="pdp-v19__b-price">₹3,597</div>
              <span class="pdp-v19__b-compare">₹4,497</span>
            </div>
          </div>

        </div>
      {% endif %}

      
      <!-- D2C SCARCITY & NOTIFY -->
      {% if product.available %}
        <div style="background:#FFF3E0; border:1px solid #FFCC80; padding:10px; border-radius:8px; margin-bottom:12px; display:flex; align-items:center; gap:12px;">
          <svg style="width:24px; height:24px; color:#E65100; flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <div style="font-size:13px; color:#E65100;">
            <div style="font-weight:700;">Limited Time Offer Ends In:</div>
            <div style="font-size:16px; font-weight:700; margin-top:2px;"><b>{% render 'countdown-timer', product: product %}</b></div>
          </div>
        </div>
      {% endif %}

      {% render 'back-in-stock', product: product %}

      {% if product.available %}
      <button class="pdp-v19__atc" id="v19-atc">ADD TO BAG</button>
      {% else %}
      <button class="pdp-v19__atc" disabled style="opacity:0.5; cursor:not-allowed;">SOLD OUT</button>
      {% endif %}

      <!-- ACCORDIONS -->
      <div class="pdp-v19__acc">
        <button class="pdp-v19__acc-btn">Details <span>+</span></button>
        <div class="pdp-v19__acc-content">
          {{ product.description | strip_html | default: "Our buttery soft signature fabric stretches to twice its size. Designed to melt into your skin for a seamless look." }}
        </div>
      </div>
      <div class="pdp-v19__acc">
        <button class="pdp-v19__acc-btn">Fit & Fabric <span>+</span></button>
        <div class="pdp-v19__acc-content" style="display:none;">
          76% Polyamide / 24% Elastane. Machine wash cold, do not bleach. True to size fit.
        </div>
      </div>
      <div class="pdp-v19__acc">
        <button class="pdp-v19__acc-btn">Shipping & Returns <span>+</span></button>
        <div class="pdp-v19__acc-content" style="display:none;">
          Free shipping on domestic orders over ₹3000. Returns accepted within 30 days of delivery on unwashed, unworn items with tags attached.
        </div>
      </div>

    </div>
  </div>

  <!-- FULL WIDTH IMAGE / LIFESTYLE -->
  {% if section.settings.show_full_image %}
    <div style="width: 100%; position: relative; margin-top: 2px;">
      {{ 'lifestyle-2' | placeholder_svg_tag: 'style="width: 100%; height: 80vh; object-fit: cover;"' }}
      <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(61, 53, 47, 0.4); display: flex; flex-direction: column; justify-content: flex-end; align-items: center; text-align: center; color: #FFF; padding: 60px 20px;">
        <h2 style="font-family: var(--v19-font); font-size: 42px; font-weight: 500; margin-bottom: 16px; letter-spacing: -0.5px;">Second Skin Comfort.</h2>
        <p style="font-size: 16px; font-weight: 400; max-width: 500px; margin-bottom: 32px; color: #F7F5F0; line-height: 1.6;">Buttery soft, incredibly stretchy, and designed to melt into your natural curves. Experience the ultimate invisible feel.</p>
        <button style="background: var(--v19-bg); color: var(--v19-text); border: none; padding: 16px 48px; font-family: var(--v19-font); font-weight: 500; font-size: 14px; cursor: pointer; text-transform: uppercase; letter-spacing: 2px; border-radius: 30px; transition: transform 0.2s;" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">Shop The Collection</button>
      </div>
    </div>
  {% endif %}

  <!-- CROSS SELL / FEATURED -->
  {% if section.settings.show_cross_sell %}
    <div style="background: var(--v19-surface); padding: 80px 20px;">
      <div style="max-width: 1400px; margin: 0 auto;">
        <h2 style="font-family: var(--v19-font); font-size: 28px; font-weight: 500; text-align: center; margin-bottom: 48px; color: var(--v19-text); letter-spacing: -0.5px;">Complete The Look</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 4px;">
          <div style="background: var(--v19-bg); padding: 16px; text-align: center;">
            {{ 'product-3' | placeholder_svg_tag: 'style="width:100%; height:320px; object-fit:cover; margin-bottom:16px; background:var(--v19-accent);"' }}
            <h3 style="font-family: var(--v19-font); font-size: 16px; font-weight: 500; margin-bottom: 8px;">Sculpting High Waist Brief</h3>
            <p style="color: var(--v19-text-light); font-size: 15px; margin-bottom: 20px;">₹1,199</p>
            <button style="width: 100%; background: transparent; color: var(--v19-text); border: 1px solid var(--v19-text); padding: 12px; font-family: var(--v19-font); font-weight: 500; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='var(--v19-text)'; this.style.color='#FFF';" onmouseout="this.style.background='transparent'; this.style.color='var(--v19-text)';">Quick Add</button>
          </div>
          <div style="background: var(--v19-bg); padding: 16px; text-align: center;">
            {{ 'product-4' | placeholder_svg_tag: 'style="width:100%; height:320px; object-fit:cover; margin-bottom:16px; background:var(--v19-accent);"' }}
            <h3 style="font-family: var(--v19-font); font-size: 16px; font-weight: 500; margin-bottom: 8px;">Seamless Thong</h3>
            <p style="color: var(--v19-text-light); font-size: 15px; margin-bottom: 20px;">₹899</p>
            <button style="width: 100%; background: transparent; color: var(--v19-text); border: 1px solid var(--v19-text); padding: 12px; font-family: var(--v19-font); font-weight: 500; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='var(--v19-text)'; this.style.color='#FFF';" onmouseout="this.style.background='transparent'; this.style.color='var(--v19-text)';">Quick Add</button>
          </div>
          <div style="background: var(--v19-bg); padding: 16px; text-align: center;">
            {{ 'product-5' | placeholder_svg_tag: 'style="width:100%; height:320px; object-fit:cover; margin-bottom:16px; background:var(--v19-accent);"' }}
            <h3 style="font-family: var(--v19-font); font-size: 16px; font-weight: 500; margin-bottom: 8px;">Soft Lounge Slip Dress</h3>
            <p style="color: var(--v19-text-light); font-size: 15px; margin-bottom: 20px;">₹2,999</p>
            <button style="width: 100%; background: transparent; color: var(--v19-text); border: 1px solid var(--v19-text); padding: 12px; font-family: var(--v19-font); font-weight: 500; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='var(--v19-text)'; this.style.color='#FFF';" onmouseout="this.style.background='transparent'; this.style.color='var(--v19-text)';">Quick Add</button>
          </div>
          <div style="background: var(--v19-bg); padding: 16px; text-align: center;">
            {{ 'product-6' | placeholder_svg_tag: 'style="width:100%; height:320px; object-fit:cover; margin-bottom:16px; background:var(--v19-accent);"' }}
            <h3 style="font-family: var(--v19-font); font-size: 16px; font-weight: 500; margin-bottom: 8px;">Cotton Rib Legging</h3>
            <p style="color: var(--v19-text-light); font-size: 15px; margin-bottom: 20px;">₹2,499</p>
            <button style="width: 100%; background: transparent; color: var(--v19-text); border: 1px solid var(--v19-text); padding: 12px; font-family: var(--v19-font); font-weight: 500; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='var(--v19-text)'; this.style.color='#FFF';" onmouseout="this.style.background='transparent'; this.style.color='var(--v19-text)';">Quick Add</button>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- RECENTLY VIEWED SECTION -->
  {% if section.settings.show_recently_viewed %}
    <div style="max-width: 1400px; margin: 40px auto; padding: 20px;">
      <h2 style="font-size: 24px; font-weight: 600; margin-bottom: 20px;">Recently Viewed</h2>
      <div id="dynamic-recently-viewed" style="display: flex; gap: 16px; overflow-x: auto; padding-bottom: 16px;">
        <!-- Hydrated via JS -->
      </div>
</div>
    </div>
  {% endif %}

  <!-- BUILT-IN STICKY ATC -->
  <div class="pdp-v19-sticky" id="v19-sticky">
    <div class="pdp-v19-sticky__title">{{ product.title | default: "Fits Everybody Bralette" }} - {{ current_variant.price | money }}</div>
    <button class="pdp-v19-sticky__btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">ADD TO BAG</button>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const accBtns = document.querySelectorAll('.pdp-v19__acc-btn');
      accBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const content = this.nextElementSibling;
          if (content.style.display === "none" || content.style.display === "") {
            content.style.display = "block";
            this.querySelector('span').innerText = "-";
          } else {
            content.style.display = "none";
            this.querySelector('span').innerText = "+";
          }
        });
      });

      const stickyBar = document.getElementById('v19-sticky');
      const mainAtc = document.getElementById('v19-atc');
      if(stickyBar && mainAtc) {
        window.addEventListener('scroll', function() {
          const mainAtcRect = mainAtc.getBoundingClientRect();
          if (mainAtcRect.top < 0) {
            stickyBar.classList.add('visible');
          } else {
            stickyBar.classList.remove('visible');
          }
        });
      }
    });
  </script>

</div>


  <!-- GLOBAL D2C SCRIPTS -->
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      // RECENTLY VIEWED LOGIC
      const handle = {{ product.handle | json }};
      const rvKey = 'cf_recent_products';
      let recent = JSON.parse(localStorage.getItem(rvKey) || '[]');
      if (handle && !recent.includes(handle)) {
        recent.unshift(handle);
        if (recent.length > 6) recent.pop();
        localStorage.setItem(rvKey, JSON.stringify(recent));
      }

      const rvContainer = document.getElementById('dynamic-recently-viewed');
      if (rvContainer) {
        const fetchRecent = recent.filter(h => h !== handle);
        if (fetchRecent.length > 0) {
          const query = fetchRecent.map(h => `handle:${h}`).join(' OR ');
          fetch(`/search?type=product&q=${query}&section_id=product-card-api`)
            .then(res => res.text())
            .then(html => {
              if (html && !html.includes('404')) {
                rvContainer.innerHTML = html;
              } else {
                rvContainer.parentElement.style.display = 'none';
              }
            })
            .catch(() => rvContainer.parentElement.style.display = 'none');
        } else {
          rvContainer.parentElement.style.display = 'none';
        }
      }

    });
  </script>

{% schema %}
{
  "name": "PDP V19 - Intimates",
  "settings": [
    {
      "type": "header",
      "content": "Bundles"
    },
    {
