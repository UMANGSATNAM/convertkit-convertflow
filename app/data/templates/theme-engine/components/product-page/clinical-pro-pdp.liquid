{% comment %}
  Clinical Pro PDP Buy Box
  Clinical Skincare & Dermocosmetics High-Conversion Buy Box
  1000cr Architecture • Zero Emojis • 100% Vector SVGs • Dermatologist Formulations
{% endcomment %}

{%- liquid
  assign p = section.settings.product | default: product
  assign has_real_product = false
  if p != blank and p.title != blank
    assign has_real_product = true
    assign p_title = p.title
    assign p_price = p.price
    assign p_compare_at = p.compare_at_price
    assign p_desc = p.description
  else
    assign p_title = section.settings.title | default: "Cellular Bio-Lipid Barrier Repair Serum"
    assign p_price = 249900
    assign p_compare_at = 349900
    assign p_desc = "Clinical strength dermal concentrate engineered with 12% stabilized bio-peptides, pure ectoin, and ceramide NP to reverse micro-damage and restore skin barrier function."
  endif
-%}

<div 
  class="clinical-pdp-section" 
  id="clinical-pdp-{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="
    --cl-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --cl-card-bg: {{ section.settings.card_bg | default: '#f8fafc' }};
    --cl-border: {{ section.settings.border_color | default: '#e2e8f0' }};
    --cl-text: {{ section.settings.text_color | default: '#0f172a' }};
    --cl-muted: {{ section.settings.muted_color | default: '#64748b' }};
    --cl-emerald: {{ section.settings.emerald_color | default: '#059669' }};
    --cl-emerald-light: #ecfdf5;
  "
>
  <div class="clinical-container">
    
    <!-- ── LEFT COLUMN: CLINICAL GALLERY & TRIAL PROOF ── -->
    <div class="clinical-gallery-col">
      <div class="clinical-image-card">
        <!-- Lab Trust Badges Overlay -->
        <div class="clinical-badges-overlay">
          <span class="clinical-badge-derm">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Dermatologist Formulated</span>
          </span>
          <span class="clinical-badge-batch">Lot #4982 • Tested 99.4% Purity</span>
        </div>

        <div class="clinical-img-wrap">
          <img 
            id="clinical-active-img-{{ section.id }}"
            class="clinical-active-img"
            src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=1200&q=85" 
            alt="{{ p_title | escape }}"
            loading="eager"
          />
        </div>

        <!-- Routine Step Indicator -->
        <div class="clinical-step-bar">
          <div class="clinical-step-pill">REGIMEN STEP 03</div>
          <span class="clinical-step-name">Targeted Dermal Treatment • AM & PM Daily Use</span>
        </div>
      </div>

      <!-- Thumbnail Strip -->
      <div class="clinical-thumbs-row">
        <button 
          type="button" 
          class="clinical-thumb-btn is-active" 
          onclick="window.switchClinicalImage('{{ section.id }}', 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=1200&q=85', this)"
        >
          <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=240&q=75" alt="Front bottle" />
        </button>
        <button 
          type="button" 
          class="clinical-thumb-btn" 
          onclick="window.switchClinicalImage('{{ section.id }}', 'https://images.unsplash.com/photo-1608248597359-074413156cf3?auto=format&fit=crop&w=1200&q=85', this)"
        >
          <img src="https://images.unsplash.com/photo-1608248597359-074413156cf3?auto=format&fit=crop&w=240&q=75" alt="Texture dropper" />
        </button>
        <button 
          type="button" 
          class="clinical-thumb-btn" 
          onclick="window.switchClinicalImage('{{ section.id }}', 'https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=1200&q=85', this)"
        >
          <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=240&q=75" alt="Clinical lab" />
        </button>
      </div>

      <!-- Clinical Trial Results Card -->
      <div class="clinical-results-card">
        <div class="clinical-results-header">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          <span class="clinical-results-title">Peer-Reviewed 28-Day Clinical Trial Results (n=140)</span>
        </div>
        <div class="clinical-metric-bars">
          <div class="clinical-metric-item">
            <div class="clinical-metric-info">
              <span class="clinical-metric-pct">96%</span>
              <span class="clinical-metric-label">Reported instant dermal soothing & redness relief</span>
            </div>
            <div class="clinical-bar-bg"><div class="clinical-bar-fill" style="width: 96%;"></div></div>
          </div>
          <div class="clinical-metric-item">
            <div class="clinical-metric-info">
              <span class="clinical-metric-pct">93%</span>
              <span class="clinical-metric-label">Measured significant skin moisture barrier repair in 14 days</span>
            </div>
            <div class="clinical-bar-bg"><div class="clinical-bar-fill" style="width: 93%;"></div></div>
          </div>
          <div class="clinical-metric-item">
            <div class="clinical-metric-info">
              <span class="clinical-metric-pct">0%</span>
              <span class="clinical-metric-label">Reported pore-clogging or breakouts in double-blind patch test</span>
            </div>
            <div class="clinical-bar-bg"><div class="clinical-bar-fill" style="width: 100%; background: #059669;"></div></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── RIGHT COLUMN: CLINICAL BUY BOX ── -->
    <div class="clinical-buybox-col">
      <div class="clinical-buybox-card">
        
        <!-- Header & Dermatologist Seals -->
        <div class="clinical-header-group">
          <div class="clinical-eyebrow-row">
            <span class="clinical-lab-eyebrow">BIO-CELLULAR DERMOCOSMETICS</span>
            <div class="clinical-stars-rating">
              <div class="clinical-stars">
                {%- for i in (1..5) -%}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="#059669"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- endfor -%}
              </div>
              <span class="clinical-reviews-text">4.96 Rating (428 Verified Patients)</span>
            </div>
          </div>

          <h1 class="clinical-product-title">{{ p_title }}</h1>
          <p class="clinical-product-subtitle">{{ p_desc }}</p>

          <!-- Active Ingredients Spec Tags -->
          <div class="clinical-actives-row">
            <span class="clinical-active-chip">
              <strong>12%</strong> Bio-Peptide Complex
            </span>
            <span class="clinical-active-chip">
              <strong>2%</strong> Multi-Weight HA
            </span>
            <span class="clinical-active-chip">
              <strong>1%</strong> Pure Ceramide NP
            </span>
            <span class="clinical-active-chip">
              pH 5.4 Skin Balanced
            </span>
          </div>
        </div>

        <!-- ── SUBSCRIBE & SAVE TOGGLE (SUBSCRIPTION CRO ENGINE) ── -->
        <div class="clinical-purchase-toggle-box">
          
          <!-- Option A: Subscribe & Save 20% -->
          <label class="clinical-purchase-option is-active" id="clinical-sub-opt-{{ section.id }}" onclick="window.selectClinicalPurchase('{{ section.id }}', 'sub')">
            <input type="radio" name="clinical_plan_{{ section.id }}" value="sub" checked class="clinical-plan-radio" />
            <div class="clinical-plan-header">
              <div class="clinical-plan-left">
                <span class="clinical-radio-indicator"></span>
                <div>
                  <div class="clinical-plan-title">SUBSCRIBE & SAVE 20%</div>
                  <div class="clinical-plan-sub">Free VIP Express Delivery • Pause or Cancel Anytime in 1 Click</div>
                </div>
              </div>
              <div class="clinical-plan-price-group">
                <span class="clinical-plan-price" id="clinical-sub-price-{{ section.id }}">₹1,999</span>
                <span class="clinical-plan-compare" id="clinical-sub-compare-{{ section.id }}">₹2,499</span>
              </div>
            </div>

            <!-- Frequency Dropdown -->
            <div class="clinical-freq-selector-wrap" id="clinical-freq-wrap-{{ section.id }}">
              <span class="clinical-freq-label">Delivered every:</span>
              <select class="clinical-freq-select" aria-label="Subscription Frequency">
                <option value="30">30 Days (Recommended for daily regimen)</option>
                <option value="45">45 Days</option>
                <option value="60">60 Days</option>
              </select>
            </div>
          </label>

          <!-- Option B: One-Time Purchase -->
          <label class="clinical-purchase-option" id="clinical-onetime-opt-{{ section.id }}" onclick="window.selectClinicalPurchase('{{ section.id }}', 'onetime')">
            <input type="radio" name="clinical_plan_{{ section.id }}" value="onetime" class="clinical-plan-radio" />
            <div class="clinical-plan-header">
              <div class="clinical-plan-left">
                <span class="clinical-radio-indicator"></span>
                <div>
                  <div class="clinical-plan-title">ONE-TIME DISPATCH</div>
                  <div class="clinical-plan-sub">Single bottle order with complimentary standard dispatch</div>
                </div>
              </div>
              <div class="clinical-plan-price-group">
                <span class="clinical-plan-price" id="clinical-onetime-price-{{ section.id }}">₹2,499</span>
                <span class="clinical-plan-compare">₹3,499</span>
              </div>
            </div>
          </label>

        </div>

        <!-- ── VOLUME & COURSE SELECTOR ── -->
        <div class="clinical-volume-section">
          <div class="clinical-section-label">Select Treatment Course Size:</div>
          <div class="clinical-volumes-grid">
            <button 
              type="button" 
              class="clinical-vol-btn" 
              onclick="window.selectClinicalVolume('{{ section.id }}', '30ml', 1999, 2499, this)"
            >
              <div class="clinical-vol-size">30ml Standard</div>
              <div class="clinical-vol-sub">30-Day Regimen</div>
            </button>
            <button 
              type="button" 
              class="clinical-vol-btn is-active" 
              onclick="window.selectClinicalVolume('{{ section.id }}', '60ml', 3399, 4499, this)"
            >
              <div class="clinical-vol-badge">SAVE 25% EXTRA</div>
              <div class="clinical-vol-size">60ml Intensive Course</div>
              <div class="clinical-vol-sub">60-Day Full Dermal Recovery</div>
            </button>
          </div>
        </div>

        <!-- ── ACTIONS BLOCK ── -->
        <div class="clinical-actions-block">
          <button 
            type="button" 
            class="clinical-primary-atc-btn" 
            id="clinical-atc-btn-{{ section.id }}"
            onclick="window.handleClinicalATC('{{ section.id }}')"
          >
            <span class="clinical-btn-txt">START YOUR 28-DAY RECOVERY</span>
            <span class="clinical-btn-sep">•</span>
            <span class="clinical-btn-price" id="clinical-btn-price-{{ section.id }}">₹3,399</span>
          </button>

          <!-- 1-Click COD Option -->
          <button 
            type="button" 
            class="clinical-cod-btn" 
            onclick="window.handleClinicalCOD('{{ section.id }}')"
          >
            <div class="clinical-cod-left">
              <span class="clinical-cod-icon">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              </span>
              <div>
                <div class="clinical-cod-main">ORDER WITH CASH ON DELIVERY (DOORSTEP)</div>
                <div class="clinical-cod-sub">Pay cash when package arrives at your door • 100% Secure</div>
              </div>
            </div>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>

        <!-- ── PINCODE & COD VERIFICATION ── -->
        <div class="clinical-pincode-box">
          <div class="clinical-pincode-header">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0f172a" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Express Delivery & Temperature-Controlled Cold Chain Check</span>
          </div>
          <div class="clinical-pincode-input-row">
            <input 
              type="text" 
              id="clinical-pincode-{{ section.id }}" 
              class="clinical-pincode-input" 
              placeholder="Enter 6-digit Pincode (e.g. 400001)"
              maxlength="6"
            />
            <button type="button" class="clinical-pincode-submit" onclick="window.checkClinicalPincode('{{ section.id }}')">
              Verify SLA
            </button>
          </div>
          <div class="clinical-pincode-status" id="clinical-pincode-status-{{ section.id }}">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Enter destination postal code to confirm Cold-Chain express transit</span>
          </div>
        </div>

        <!-- ── 4 CLINICAL TRUST PILLARS ── -->
        <div class="clinical-trust-grid">
          <div class="clinical-trust-item">
            <div class="clinical-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <div class="clinical-trust-title">30-Day Dermal Guarantee</div>
              <div class="clinical-trust-sub">Full refund even if bottle is empty</div>
            </div>
          </div>

          <div class="clinical-trust-item">
            <div class="clinical-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <div>
              <div class="clinical-trust-title">Clean & Hypoallergenic</div>
              <div class="clinical-trust-sub">Zero fragrance, sulfates, or parabens</div>
            </div>
          </div>

          <div class="clinical-trust-item">
            <div class="clinical-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <div>
              <div class="clinical-trust-title">Cold-Chain Express Delivery</div>
              <div class="clinical-trust-sub">Preserves active bio-peptide integrity</div>
            </div>
          </div>

          <div class="clinical-trust-item">
            <div class="clinical-trust-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            </div>
            <div>
              <div class="clinical-trust-title">256-Bit Encrypted Payments</div>
              <div class="clinical-trust-sub">UPI • NetBanking • Credit Cards • COD</div>
            </div>
          </div>
        </div>

        <!-- ── TRANSPARENCY ACCORDIONS ── -->
        <div class="clinical-accordions-group">
          <div class="clinical-acc-item is-open">
            <button type="button" class="clinical-acc-head" onclick="window.toggleClinicalAcc(this)">
              <div class="clinical-acc-title-wrap">
                <span class="clinical-acc-bullet">
                  <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6"/></svg>
                </span>
                <span class="clinical-acc-title">Full INCI Formulation Transparency</span>
              </div>
              <span class="clinical-acc-plus">+</span>
            </button>
            <div class="clinical-acc-content">
              <p>Water/Aqua, Propanediol, Glycerin, Niacinamide, Palmitoyl Tripeptide-38, Ceramide NP, Ceramide AP, Phytosphingosine, Sodium Hyaluronate (Multi-Molecular), Ectoin, Panthenol, Allantoin, Carbomer, Phenoxyethanol, Ethylhexylglycerin.</p>
            </div>
          </div>

          <div class="clinical-acc-item">
            <button type="button" class="clinical-acc-head" onclick="window.toggleClinicalAcc(this)">
              <div class="clinical-acc-title-wrap">
                <span class="clinical-acc-bullet">
                  <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6"/></svg>
                </span>
                <span class="clinical-acc-title">Clinical Protocol (How to Apply)</span>
              </div>
              <span class="clinical-acc-plus">+</span>
            </button>
            <div class="clinical-acc-content">
              <p>Dispense 3-4 drops onto clean fingertips. Gently press and smooth across cleansed face, neck, and decolletage every morning and evening before heavier lipid creams. Safe for post-laser and compromised skin barriers.</p>
            </div>
          </div>

          <div class="clinical-acc-item">
            <button type="button" class="clinical-acc-head" onclick="window.toggleClinicalAcc(this)">
              <div class="clinical-acc-title-wrap">
                <span class="clinical-acc-bullet">
                  <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6"/></svg>
                </span>
                <span class="clinical-acc-title">Our 30-Day Dermal Money-Back Guarantee</span>
              </div>
              <span class="clinical-acc-plus">+</span>
            </button>
            <div class="clinical-acc-content">
              <p>We stand behind the scientific rigor of our cellular formulations. If your skin does not experience noticeable barrier recovery, reduced sensitivity, and deeper hydration within 30 days, simply contact us for an instant 100% refund.</p>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- ── STICKY FLOATING BUY BAR ── -->
  <div class="clinical-sticky-bar" id="clinical-sticky-bar-{{ section.id }}">
    <div class="clinical-sticky-inner">
      <div class="clinical-sticky-left">
        <img 
          src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=120&q=80" 
          alt="{{ p_title | escape }}" 
          class="clinical-sticky-thumb" 
        />
        <div>
          <div class="clinical-sticky-title">{{ p_title }}</div>
          <div class="clinical-sticky-price-row">
            <span class="clinical-sticky-price" id="clinical-sticky-price-{{ section.id }}">₹3,399</span>
            <span class="clinical-sticky-tag">Dermatologist Verified • Cold-Chain Dispatch</span>
          </div>
        </div>
      </div>
      <button 
        type="button" 
        class="clinical-sticky-cta" 
        onclick="window.handleClinicalATC('{{ section.id }}')"
      >
        <span>START RECOVERY</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>

</div>

<!-- ── STYLES: CLINICAL DERMOCOSMETIC LUXURY ── -->
<style>
  .clinical-pdp-section {
    background: var(--cl-bg);
    color: var(--cl-text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    padding: 32px 20px 80px 20px;
    box-sizing: border-box;
    position: relative;
    border-bottom: 1px solid var(--cl-border);
  }

  .clinical-container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 44px;
    align-items: flex-start;
  }

  @media (max-width: 1024px) {
    .clinical-container {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  /* ── Gallery Column ── */
  .clinical-gallery-col {
    position: sticky;
    top: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .clinical-image-card {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 4.6;
    border-radius: 12px;
    overflow: hidden;
    background: #f1f5f9;
    border: 1px solid var(--cl-border);
  }

  .clinical-img-wrap {
    width: 100%;
    height: 100%;
  }

  .clinical-active-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: opacity 0.2s ease;
    display: block;
  }

  .clinical-badges-overlay {
    position: absolute;
    top: 14px;
    left: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 2;
  }

  .clinical-badge-derm {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #0f172a;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 5px 10px;
    border-radius: 4px;
  }

  .clinical-badge-batch {
    display: inline-block;
    background: #ffffff;
    color: var(--cl-emerald);
    border: 1px solid #a7f3d0;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .clinical-step-bar {
    position: absolute;
    bottom: 0;
    inset-inline: 0;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
  }

  .clinical-step-pill {
    background: #0f172a;
    color: #ffffff;
    font-size: 9px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .clinical-step-name {
    font-weight: 600;
    color: var(--cl-text);
  }

  .clinical-thumbs-row {
    display: flex;
    gap: 10px;
  }

  .clinical-thumb-btn {
    width: 76px;
    height: 76px;
    border-radius: 8px;
    overflow: hidden;
    border: 1.5px solid transparent;
    padding: 0;
    background: #f1f5f9;
    cursor: pointer;
    opacity: 0.65;
    transition: all 0.15s ease;
  }

  .clinical-thumb-btn.is-active,
  .clinical-thumb-btn:hover {
    opacity: 1;
    border-color: #0f172a;
  }

  .clinical-thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Results Proof Box ── */
  .clinical-results-card {
    background: #f8fafc;
    border: 1px solid var(--cl-border);
    border-radius: 10px;
    padding: 16px;
  }

  .clinical-results-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .clinical-results-title {
    font-size: 12px;
    font-weight: 700;
    color: var(--cl-text);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .clinical-metric-bars {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .clinical-metric-info {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 11px;
    margin-bottom: 4px;
  }

  .clinical-metric-pct {
    font-weight: 800;
    color: var(--cl-emerald);
    font-size: 13px;
  }

  .clinical-metric-label {
    color: var(--cl-muted);
