<!-- ── JAVASCRIPT: CLINICAL ENGINE ── -->
<script>
(function() {
  window.switchClinicalImage = function(sectionId, imgSrc, btn) {
    var img = document.getElementById('clinical-active-img-' + sectionId);
    if (img) {
      img.style.opacity = '0.35';
      setTimeout(function() {
        img.src = imgSrc;
        img.style.opacity = '1';
      }, 120);
    }
    var col = document.getElementById('clinical-pdp-' + sectionId);
    if (col) {
      var all = col.querySelectorAll('.clinical-thumb-btn');
      all.forEach(function(el) { el.classList.remove('is-active'); });
    }
    if (btn) btn.classList.add('is-active');
  };

  window.selectClinicalPurchase = function(sectionId, mode) {
    var subOpt = document.getElementById('clinical-sub-opt-' + sectionId);
    var oneOpt = document.getElementById('clinical-onetime-opt-' + sectionId);
    var freqWrap = document.getElementById('clinical-freq-wrap-' + sectionId);
    var btnPrice = document.getElementById('clinical-btn-price-' + sectionId);
    var stickyPrice = document.getElementById('clinical-sticky-price-' + sectionId);

    if (mode === 'sub') {
      if (subOpt) subOpt.classList.add('is-active');
      if (oneOpt) oneOpt.classList.remove('is-active');
      if (freqWrap) freqWrap.style.display = 'flex';
      var subVal = document.getElementById('clinical-sub-price-' + sectionId);
      if (subVal && btnPrice) btnPrice.innerText = subVal.innerText;
      if (subVal && stickyPrice) stickyPrice.innerText = subVal.innerText;
    } else {
      if (oneOpt) oneOpt.classList.add('is-active');
      if (subOpt) subOpt.classList.remove('is-active');
      if (freqWrap) freqWrap.style.display = 'none';
      var oneVal = document.getElementById('clinical-onetime-price-' + sectionId);
      if (oneVal && btnPrice) btnPrice.innerText = oneVal.innerText;
      if (oneVal && stickyPrice) stickyPrice.innerText = oneVal.innerText;
    }
  };

  window.selectClinicalVolume = function(sectionId, size, price, compPrice, btn) {
    var sec = document.getElementById('clinical-pdp-' + sectionId);
    if (!sec) return;
    var all = sec.querySelectorAll('.clinical-vol-btn');
    all.forEach(function(b) { b.classList.remove('is-active'); });
    btn.classList.add('is-active');

    var formatted = '₹' + price.toLocaleString('en-IN');
    var subFormatted = '₹' + Math.round(price * 0.8).toLocaleString('en-IN');

    var subP = document.getElementById('clinical-sub-price-' + sectionId);
    var subComp = document.getElementById('clinical-sub-compare-' + sectionId);
    var oneP = document.getElementById('clinical-onetime-price-' + sectionId);
    var btnPrice = document.getElementById('clinical-btn-price-' + sectionId);
    var stickyPrice = document.getElementById('clinical-sticky-price-' + sectionId);

    if (subP) subP.innerText = subFormatted;
    if (subComp) subComp.innerText = formatted;
    if (oneP) oneP.innerText = formatted;

    var isSub = document.getElementById('clinical-sub-opt-' + sectionId)?.classList.contains('is-active');
    var activePrice = isSub ? subFormatted : formatted;
    if (btnPrice) btnPrice.innerText = activePrice;
    if (stickyPrice) stickyPrice.innerText = activePrice;
  };

  window.toggleClinicalAcc = function(btn) {
    var item = btn.closest('.clinical-acc-item');
    if (item) item.classList.toggle('is-open');
  };

  window.checkClinicalPincode = function(sectionId) {
    var input = document.getElementById('clinical-pincode-' + sectionId);
    var status = document.getElementById('clinical-pincode-status-' + sectionId);
    if (!input || !status) return;
    var code = input.value.trim();
    if (code.length === 6 && /^\d+$/.test(code)) {
      status.innerHTML = '<span style="color: #059669; font-weight: 700;">Cold-Chain Express Delivery to ' + code + ' in 2 business days. COD Available!</span>';
    } else {
      status.innerHTML = '<span style="color: #dc2626; font-weight: 600;">Please enter a valid 6-digit postal code.</span>';
    }
  };

  window.handleClinicalATC = function(sectionId) {
    var btn = document.getElementById('clinical-atc-btn-' + sectionId);
    if (!btn) return;
    var original = btn.innerHTML;
    btn.innerHTML = '<span>DISPATCHING DERMAL REGIMEN...</span>';
    btn.style.opacity = '0.7';

    setTimeout(function() {
      btn.innerHTML = '<span style="color:#6ee7b7;">REGIMEN ADDED TO BAG</span>';
      btn.style.opacity = '1';
      setTimeout(function() {
        btn.innerHTML = original;
      }, 2400);
    }, 600);
  };

  window.handleClinicalCOD = function(sectionId) {
    alert('Clinical Doorstep Cash on Delivery activated! Your cold-chain pack will dispatch within 24 hours with SMS verification.');
  };

  // Sticky Scroll
  document.addEventListener('DOMContentLoaded', function() {
    var bar = document.querySelector('.clinical-sticky-bar');
    if (!bar) return;
    window.addEventListener('scroll', function() {
      if (window.scrollY > 400) {
        bar.classList.add('is-visible');
      } else {
        bar.classList.remove('is-visible');
      }
    });
  });
})();
</script>

