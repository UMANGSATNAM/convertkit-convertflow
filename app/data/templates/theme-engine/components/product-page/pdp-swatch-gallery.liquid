{% comment %}
  PDP Swatch Selector & Image Switcher
  Category: product-page
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --sw-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --sw-text: {{ section.settings.text_color | default: '#0f172a' }};
    background: var(--sw-bg);
    color: var(--sw-text);
    padding: 24px;
    border-radius: 20px;
    border: 1px solid #e2e8f0;
    font-family: inherit;
    margin: 20px 0;
  }

  .cf-sw-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    font-size: 14px;
  }

  .cf-sw-name {
    font-weight: 700;
  }

  .cf-sw-selected {
    font-weight: 800;
    color: #0f766e;
  }

  .cf-sw-list {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .cf-sw-dot {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 2px solid transparent;
    padding: 3px;
    cursor: pointer;
    transition: transform 0.15s, border-color 0.15s;
    background: transparent;
  }

  .cf-sw-dot.active {
    border-color: #0f172a;
    transform: scale(1.08);
  }

  .cf-sw-dot-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: block;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.15);
  }

  .cf-sw-sizes {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .cf-sw-chip {
    padding: 10px 18px;
    border-radius: 8px;
    border: 1.5px solid #cbd5e1;
    background: #ffffff;
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .cf-sw-chip:hover {
    border-color: #0f172a;
  }

  .cf-sw-chip.active {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }
{%- endstyle -%}

<div class="cf-sw-wrap">
  <div class="cf-sw-label-row">
    <span class="cf-sw-name">Color: <span class="cf-sw-selected" id="cf-selected-color">Obsidian Black</span></span>
    <span style="font-size:12px;color:#64748b;">3 finishes in stock</span>
  </div>

  <div class="cf-sw-list">
    <button type="button" class="cf-sw-dot active" onclick="
      document.querySelectorAll('.cf-sw-dot').forEach(el => el.classList.remove('active'));
      this.classList.add('active');
      document.getElementById('cf-selected-color').innerText = 'Obsidian Black';
    " aria-label="Obsidian Black">
      <span class="cf-sw-dot-inner" style="background:#0f172a;"></span>
    </button>
    <button type="button" class="cf-sw-dot" onclick="
      document.querySelectorAll('.cf-sw-dot').forEach(el => el.classList.remove('active'));
      this.classList.add('active');
      document.getElementById('cf-selected-color').innerText = 'Champagne Gold';
    " aria-label="Champagne Gold">
      <span class="cf-sw-dot-inner" style="background:#eab308;"></span>
    </button>
    <button type="button" class="cf-sw-dot" onclick="
      document.querySelectorAll('.cf-sw-dot').forEach(el => el.classList.remove('active'));
      this.classList.add('active');
      document.getElementById('cf-selected-color').innerText = 'Glacier Silver';
    " aria-label="Glacier Silver">
      <span class="cf-sw-dot-inner" style="background:#cbd5e1;"></span>
    </button>
  </div>

  <div class="cf-sw-label-row">
    <span class="cf-sw-name">Size: <span class="cf-sw-selected" id="cf-selected-size">Medium</span></span>
    <a href="#" style="font-size:12px;color:#0f766e;text-decoration:underline;">Size Guide 📏</a>
  </div>

  <div class="cf-sw-sizes">
    <button type="button" class="cf-sw-chip" onclick="
      document.querySelectorAll('.cf-sw-chip').forEach(el => el.classList.remove('active'));
      this.classList.add('active');
      document.getElementById('cf-selected-size').innerText = 'Small';
    ">S</button>
    <button type="button" class="cf-sw-chip active" onclick="
      document.querySelectorAll('.cf-sw-chip').forEach(el => el.classList.remove('active'));
      this.classList.add('active');
      document.getElementById('cf-selected-size').innerText = 'Medium';
    ">M</button>
    <button type="button" class="cf-sw-chip" onclick="
      document.querySelectorAll('.cf-sw-chip').forEach(el => el.classList.remove('active'));
      this.classList.add('active');
      document.getElementById('cf-selected-size').innerText = 'Large';
    ">L</button>
    <button type="button" class="cf-sw-chip" onclick="
      document.querySelectorAll('.cf-sw-chip').forEach(el => el.classList.remove('active'));
      this.classList.add('active');
      document.getElementById('cf-selected-size').innerText = 'Extra Large';
    ">XL</button>
  </div>
</div>

{% schema %}
{
  "name": "PDP Swatch Selector",
  "tag": "section",
  "class": "cf-pdp-swatch-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0f172a"
    }
  ],
  "presets": [
    {
      "name": "PDP Swatch Selector"
    }
  ]
}
{% endschema %}
