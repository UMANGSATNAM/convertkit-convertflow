{% comment %}
  PDP Stock Urgency & Live Viewers Pulse
  Category: product-page
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --urg-bg: {{ section.settings.bg_color | default: '#fef2f2' }};
    --urg-border: {{ section.settings.border_color | default: '#fecaca' }};
    --urg-text: {{ section.settings.text_color | default: '#991b1b' }};
    --urg-bar-fill: {{ section.settings.bar_color | default: '#ef4444' }};
    background: var(--urg-bg);
    border: 1px solid var(--urg-border);
    border-radius: 16px;
    padding: 16px 20px;
    margin: 16px 0;
    font-family: inherit;
    color: var(--urg-text);
  }

  .cf-urg-pulse-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .cf-urg-dot {
    position: relative;
    width: 10px;
    height: 10px;
  }

  .cf-urg-dot::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #22c55e;
  }

  .cf-urg-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: rgba(34, 197, 94, 0.4);
    animation: cf-pulse-ring 1.8s cubic-bezier(0.24, 0, 0.38, 1) infinite;
  }

  @keyframes cf-pulse-ring {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.6); opacity: 0; }
    100% { transform: scale(0.95); opacity: 0; }
  }

  .cf-urg-stock-text {
    font-size: 14px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .cf-urg-meter-bg {
    width: 100%;
    height: 7px;
    background: rgba(0, 0, 0, 0.08);
    border-radius: 99px;
    overflow: hidden;
  }

  .cf-urg-meter-fill {
    height: 100%;
    width: {{ section.settings.stock_percent | default: 28 }}%;
    background: var(--urg-bar-fill);
    border-radius: 99px;
    animation: cf-pulse-bar 2s ease infinite alternate;
  }

  @keyframes cf-pulse-bar {
    0% { opacity: 0.85; }
    100% { opacity: 1; }
  }

  .cf-urg-shipping-pill {
    margin-top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: #4b5563;
  }
{%- endstyle -%}

<div class="cf-urg-container">
  <div class="cf-urg-pulse-row">
    <span class="cf-urg-dot"></span>
    <span>{{ section.settings.live_text | default: '16 people are viewing this product right now' }}</span>
  </div>

  <div class="cf-urg-stock-text">
    <span>🔥 {{ section.settings.stock_label | default: 'Almost Gone — Only 4 items left in stock!' }}</span>
    <span>{{ section.settings.stock_percent | default: 28 }}%</span>
  </div>

  <div class="cf-urg-meter-bg" role="progressbar" aria-valuenow="{{ section.settings.stock_percent | default: 28 }}" aria-valuemin="0" aria-valuemax="100">
    <div class="cf-urg-meter-fill"></div>
  </div>

  <div class="cf-urg-shipping-pill">
    <span>📦</span>
    <span>{{ section.settings.shipping_note | default: 'Order in the next 2 hrs 14 mins to get it by Thursday' }}</span>
  </div>
</div>

{% schema %}
{
  "name": "PDP Stock Urgency",
  "tag": "section",
  "class": "cf-pdp-stock-urgency-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#fef2f2"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#fecaca"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#991b1b"
    },
    {
      "type": "color",
      "id": "bar_color",
      "label": "Progress bar color",
      "default": "#ef4444"
    },
    {
      "type": "text",
      "id": "live_text",
      "label": "Live viewers message",
      "default": "16 people are viewing this product right now"
    },
    {
      "type": "text",
      "id": "stock_label",
      "label": "Stock urgency headline",
      "default": "Almost Gone — Only 4 items left in stock!"
    },
    {
      "type": "range",
      "id": "stock_percent",
      "label": "Stock remaining (%)",
      "min": 5,
      "max": 95,
      "step": 1,
      "default": 28
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Shipping urgency footer",
      "default": "Order in the next 2 hrs 14 mins to get it by Thursday"
    }
  ],
  "presets": [
    {
      "name": "PDP Stock Urgency",
      "settings": {
        "stock_label": "Almost Gone — Only 4 items left in stock!"
      }
    }
  ]
}
{% endschema %}
