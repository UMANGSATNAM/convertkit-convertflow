{%- comment -%}
  PDP V10: "DAILY OBJECTS" STYLE D2C FUNNEL
  Aesthetic: Clean, Premium Tech/Accessories, Grey/White/Green.
  CRO: Image swatches, Pincode checker, Direct Add-On Accessories.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

  :root {
    --v10-bg: #FFFFFF;
    --v10-text: #212121;
    --v10-text-light: #757575;
    --v10-border: #E0E0E0;
    --v10-green: #29A76E; /* Daily Objects Green */
    --v10-green-hover: #228b5b;
    --v10-font: 'Inter', sans-serif;
  }

  .pdp-v10 {
    background-color: var(--v10-bg);
    color: var(--v10-text);
    font-family: var(--v10-font);
    line-height: 1.5;
  }

  .pdp-v10__container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    gap: 30px;
  }
  @media (min-width: 992px) {
    .pdp-v10__container { grid-template-columns: 1fr 450px; gap: 60px; padding-right: 40px; }
  }

  /* --- GALLERY --- */
  .pdp-v10__gallery {
    background: #F4F4F4;
    position: relative;
    padding-bottom: 30px;
  }
  @media (min-width: 992px) {
    .pdp-v10__gallery { height: calc(100vh - 40px); position: sticky; top: 0; display: flex; align-items: center; justify-content: center; }
  }
  .pdp-v10__gallery img, .pdp-v10__gallery svg {
    width: 100%;
    max-width: 600px;
    height: auto;
    object-fit: contain;
    margin: 0 auto;
    display: block;
  }
  .pdp-v10__dots {
    display: flex; justify-content: center; gap: 8px; position: absolute; bottom: 20px; width: 100%;
  }
  .pdp-v10__dot { width: 6px; height: 6px; border-radius: 50%; background: #CCC; }
  .pdp-v10__dot.active { background: var(--v10-green); width: 24px; border-radius: 4px; }

  /* --- INFO BOX --- */
  .pdp-v10__info {
    padding: 24px;
  }
  @media (min-width: 992px) {
    .pdp-v10__info { padding: 60px 0; min-height: 100vh; }
  }

  .pdp-v10__title {
    font-size: 24px;
    font-weight: 500;
    margin: 0 0 12px 0;
    color: var(--v10-text);
    line-height: 1.3;
  }
  
  .pdp-v10__price-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }
  .pdp-v10__price { font-size: 22px; font-weight: 800; color: var(--v10-text); }
  .pdp-v10__compare { font-size: 16px; color: var(--v10-text-light); text-decoration: line-through; }
  .pdp-v10__tax { font-size: 12px; color: var(--v10-text-light); }

  /* --- DEVICE SELECTOR --- */
  .pdp-v10__device { margin-bottom: 24px; }
  .pdp-v10__label { font-size: 13px; font-weight: 700; text-transform: uppercase; margin-bottom: 8px; display: block; }
  .pdp-v10__select {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--v10-border);
    border-radius: 4px;
    background: #FAFAFA;
    font-size: 14px;
    font-weight: 500;
    color: var(--v10-green);
    cursor: pointer;
    appearance: none;
    background-image: url('data:image/svg+xml;utf8,<svg fill="none" stroke="%23212121" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>');
    background-repeat: no-repeat;
    background-position: right 16px center;
    background-size: 16px;
  }

  /* --- SWATCHES (COLLECTION) --- */
  .pdp-v10__swatches { margin-bottom: 24px; }
  .pdp-v10__s-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 12px; }
  .pdp-v10__s-opt { font-size: 12px; color: var(--v10-text-light); }
  .pdp-v10__s-grid { display: flex; gap: 8px; flex-wrap: wrap; }
  .pdp-v10__s-item {
    width: 60px; height: 80px;
    border: 1px solid var(--v10-border);
    border-radius: 4px;
    cursor: pointer;
    padding: 2px;
    background: #F9F9F9;
  }
  .pdp-v10__s-item img, .pdp-v10__s-item svg { width: 100%; height: 100%; object-fit: contain; }
  .pdp-v10__s-item.active { border: 2px solid var(--v10-green); }

  /* --- ATC BUTTON --- */
  .pdp-v10__atc {
    width: 100%;
    background: var(--v10-green);
    color: #FFF;
    border: none;
    padding: 16px;
    font-size: 16px;
    font-weight: 700;
    border-radius: 4px;
    cursor: pointer;
    text-transform: uppercase;
    transition: background 0.3s;
    margin-bottom: 24px;
  }
  .pdp-v10__atc:hover { background: var(--v10-green-hover); }

  /* --- PINCODE CHECKER --- */
  .pdp-v10__pincode {
    display: flex;
    gap: 8px;
    margin-bottom: 32px;
  }
  .pdp-v10__pincode input {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid var(--v10-border);
    border-radius: 4px;
    font-size: 14px;
    background: #FAFAFA;
  }
  .pdp-v10__pincode button {
    background: #FFF;
    border: 1px solid var(--v10-border);
    border-radius: 4px;
    padding: 0 20px;
    font-size: 13px;
    font-weight: 600;
    color: var(--v10-text-light);
    cursor: pointer;
    text-transform: uppercase;
  }

  /* --- ADD ON ACCESSORY (UPSELL) --- */
  .pdp-v10__addon {
    margin-bottom: 32px;
  }
  .pdp-v10__addon-list {
    display: flex; flex-direction: column; gap: 12px;
  }
  .pdp-v10__addon-item {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px;
    border: 1px solid var(--v10-border);
    border-radius: 8px;
  }
  .pdp-v10__addon-left { display: flex; gap: 16px; align-items: center; }
  .pdp-v10__addon-img { width: 50px; height: 50px; background: #F4F4F4; border-radius: 4px; object-fit: cover; }
  .pdp-v10__addon-title { font-size: 13px; font-weight: 500; margin-bottom: 4px; }
  .pdp-v10__addon-price { font-size: 13px; font-weight: 700; display: flex; gap: 8px; }
  .pdp-v10__addon-price del { color: var(--v10-text-light); font-weight: 400; }
  .pdp-v10__addon-btn {
    border: 1px solid var(--v10-green);
    color: var(--v10-green);
    background: transparent;
    border-radius: 20px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    text-transform: uppercase;
  }
  .pdp-v10__addon-btn:hover { background: var(--v10-green); color: #FFF; }

  /* --- COUNTDOWN TIMER --- */
  .pdp-v10__countdown { display: flex; align-items: center; justify-content: space-between; background: #FEF3F2; border: 1px solid #F9DEDC; border-radius: 4px; padding: 12px 16px; margin-bottom: 24px; }
  .pdp-v10__countdown-title { color: #B3261E; font-size: 14px; font-weight: 700; display: flex; align-items: center; gap: 6px;}
  .pdp-v10__timer { display: flex; gap: 8px; }
  .pdp-v10__time { background: #FFF; border: 1px solid #F9DEDC; border-radius: 4px; padding: 4px 8px; text-align: center; color: #B3261E; min-width: 40px;}
  .pdp-v10__time span { display: block; font-size: 16px; font-weight: 800; line-height: 1.2; }
  .pdp-v10__time small { font-size: 9px; font-weight: 600; }

  /* --- NOTIFY ME FORM --- */
  .pdp-v10__atc--soldout { background: #E0E0E0 !important; color: #757575 !important; cursor: not-allowed; }
  .pdp-v10__notify { background: #F9F9F9; padding: 16px; border-radius: 8px; margin-bottom: 24px; border: 1px solid var(--v10-border); }
  .pdp-v10__notify p { margin: 0 0 12px 0; font-size: 14px; font-weight: 600; color: var(--v10-text); }
  .pdp-v10__notify form { display: flex; gap: 8px; }
  .pdp-v10__notify-input { flex: 1; padding: 12px; border: 1px solid var(--v10-border); border-radius: 4px; font-size: 14px;}
  .pdp-v10__notify-btn { background: var(--v10-text); color: #FFF; padding: 0 16px; border-radius: 4px; font-weight: 600; cursor: pointer; border: none; font-size: 13px;}

  /* --- ACCORDIONS --- */
  .pdp-v10__acc { border-top: 1px solid var(--v10-border); }
  .pdp-v10__acc:last-child { border-bottom: 1px solid var(--v10-border); margin-bottom: 40px; }
  .pdp-v10__acc-btn {
    width: 100%; text-align: left; background: none; border: none;
    padding: 20px 0; font-size: 14px; font-weight: 700;
    display: flex; justify-content: space-between; cursor: pointer;
    text-transform: uppercase;
  }
  .pdp-v10__acc-content { padding-bottom: 20px; font-size: 14px; color: var(--v10-text-light); line-height: 1.6; }

  /* --- GRIDS (Cross Sell / Recents) --- */
  .pdp-v10__section { max-width: 1400px; margin: 60px auto 40px auto; padding: 0 20px; }
  .pdp-v10__sec-title { font-size: 20px; font-weight: 700; margin-bottom: 24px; text-transform: uppercase; }
  .pdp-v10__grid { display: flex; overflow-x: auto; gap: 16px; scroll-snap-type: x mandatory; padding-bottom: 10px; }
  @media (min-width: 768px) { .pdp-v10__grid { display: grid; grid-template-columns: repeat(4, 1fr); overflow-x: visible; } }
  .pdp-v10__card { min-width: 200px; scroll-snap-align: start; }
  @media (min-width: 768px) { .pdp-v10__card { min-width: 100%; } }
  .pdp-v10__card img, .pdp-v10__card svg { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; margin-bottom: 12px; background: #F4F4F4; }
  .pdp-v10__card-title { font-size: 14px; font-weight: 500; margin-bottom: 6px; color: var(--v10-text); }
  .pdp-v10__card-price { font-weight: 700; font-size: 14px; }

  /* --- STICKY ATC (BUILT-IN) --- */
  .pdp-v10-sticky {
    position: fixed; bottom: -100px; left: 0; width: 100%; background: #FFF; box-shadow: 0 -4px 10px rgba(0,0,0,0.05);
    z-index: 999; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center;
    transition: bottom 0.3s ease-in-out; border-top: 1px solid var(--v10-border);
  }
  .pdp-v10-sticky.visible { bottom: 0; }
  .pdp-v10-sticky__info { display: flex; align-items: center; gap: 16px; }
  .pdp-v10-sticky__img { width: 48px; height: 48px; object-fit: contain; background:#F4F4F4; border-radius: 4px; }
  .pdp-v10-sticky__title { font-weight: 600; font-size: 14px; color: var(--v10-text); margin-bottom: 4px; }
  .pdp-v10-sticky__price { font-weight: 800; color: var(--v10-text); font-size: 14px; }
  .pdp-v10-sticky__btn { background: var(--v10-green); color: #FFF; border: none; padding: 12px 32px; font-weight: 700; cursor: pointer; border-radius: 4px; text-transform: uppercase; }
  @media (max-width: 768px) {
    .pdp-v10-sticky__info { display: none; }
    .pdp-v10-sticky__btn { width: 100%; padding: 16px; font-size: 16px; }
  }

</style>

<div class="pdp-v10" data-section="{{ section.id }}">
  
  <div class="pdp-v10__container">
    
    <!-- LEFT GALLERY -->
    <div class="pdp-v10__gallery">
      {% if product.featured_media %}
        <img src="{{ product.featured_media | image_url: width: 800 }}" alt="{{ product.title | escape }}" fetchpriority="high" loading="eager">
      {% else %}
        {{ 'product-1' | placeholder_svg_tag }}
      {% endif %}
      <div class="pdp-v10__dots">
        <div class="pdp-v10__dot active"></div>
        <div class="pdp-v10__dot"></div>
        <div class="pdp-v10__dot"></div>
      </div>
    </div>

    <!-- RIGHT INFO BOX -->
    <div class="pdp-v10__info">
      
      <h1 class="pdp-v10__title">{{ product.title | default: "The Loners Stride 2.0 MagSafe Case Cover" }}</h1>
      
      <div class="pdp-v10__price-wrap">
        <span class="pdp-v10__price">{{ current_variant.price | money }}</span>
        {% if current_variant.compare_at_price > current_variant.price %}
          <span class="pdp-v10__compare">{{ current_variant.compare_at_price | money }}</span>
        {% endif %}
        <span class="pdp-v10__tax">MRP Inclusive of all taxes</span>
      </div>

      <!-- DEVICE SELECTOR -->
      <div class="pdp-v10__device">
        <label class="pdp-v10__label">Select Device</label>
        <select class="pdp-v10__select">
          <option>iPhone 15 Pro Max</option>
          <option>iPhone 15 Pro</option>
          <option>iPhone 15</option>
          <option>iPhone 14 Pro Max</option>
        </select>
      </div>

      <!-- SWATCH COLLECTION -->
      <div class="pdp-v10__swatches">
        <div class="pdp-v10__s-head">
          <span class="pdp-v10__label" style="margin:0;">Collection</span>
          <span class="pdp-v10__s-opt">6 Options</span>
        </div>
        <div class="pdp-v10__s-grid">
          <div class="pdp-v10__s-item active">{{ 'product-1' | placeholder_svg_tag }}</div>
          <div class="pdp-v10__s-item">{{ 'product-2' | placeholder_svg_tag }}</div>
          <div class="pdp-v10__s-item">{{ 'product-3' | placeholder_svg_tag }}</div>
          <div class="pdp-v10__s-item">{{ 'product-4' | placeholder_svg_tag }}</div>
          <div class="pdp-v10__s-item">{{ 'product-5' | placeholder_svg_tag }}</div>
          <div class="pdp-v10__s-item">{{ 'product-6' | placeholder_svg_tag }}</div>
        </div>
      </div>

      <!-- COUNTDOWN TIMER -->
      {% if section.settings.show_countdown %}
      <div class="pdp-v10__countdown">
        <span class="pdp-v10__countdown-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          Hurry! Sale ends in:
        </span>
        <div class="pdp-v10__timer" data-countdown="{{ section.settings.countdown_time | default: 4 }}">
          <div class="pdp-v10__time"><span class="hours">00</span><small>HRS</small></div>
          <div class="pdp-v10__time"><span class="minutes">00</span><small>MINS</small></div>
          <div class="pdp-v10__time"><span class="seconds">00</span><small>SECS</small></div>
        </div>
      </div>
      {% endif %}

      {% if current_variant.available %}
        <button class="pdp-v10__atc" id="v10-main-atc">ADD TO CART</button>
      {% else %}
        <button class="pdp-v10__atc pdp-v10__atc--soldout" disabled>SOLD OUT</button>
      {% endif %}

      {% render 'back-in-stock', product: product, accent: '#212121' %}

      {% if section.settings.show_pincode %}
        <div class="pdp-v10__pincode">
          <input type="text" placeholder="Enter Pincode To Check Delivery">
          <button>CHECK</button>
        </div>
      {% endif %}

      <!-- ADD ON ACCESSORY -->
      {% if section.settings.show_addons %}
        <div class="pdp-v10__addon">
          <span class="pdp-v10__label">Add On Accessory</span>
          <div class="pdp-v10__addon-list">
            
            <div class="pdp-v10__addon-item">
              <div class="pdp-v10__addon-left">
                {{ 'product-2' | placeholder_svg_tag: 'pdp-v10__addon-img' }}
                <div>
                  <div class="pdp-v10__addon-title">Red Crossbody Phone Lanyard</div>
                  <div class="pdp-v10__addon-price"><span>₹1199</span> <del>₹1699</del></div>
                </div>
              </div>
              <button class="pdp-v10__addon-btn">+ ADD</button>
            </div>

            <div class="pdp-v10__addon-item">
              <div class="pdp-v10__addon-left">
                {{ 'product-3' | placeholder_svg_tag: 'pdp-v10__addon-img' }}
                <div>
                  <div class="pdp-v10__addon-title">20W Fast Charger Adapter</div>
                  <div class="pdp-v10__addon-price"><span>₹899</span> <del>₹1499</del></div>
                </div>
              </div>
              <button class="pdp-v10__addon-btn">+ ADD</button>
            </div>

          </div>
        </div>
      {% endif %}

      <!-- DETAILS & CARE -->
      <div class="pdp-v10__acc">
        <button class="pdp-v10__acc-btn">Product Description <span>+</span></button>
        <div class="pdp-v10__acc-content">
          {{ product.description | strip_html | default: "Engineered for maximum drop protection while maintaining a slim profile. Features raised bezels for screen and camera protection, plus seamless MagSafe compatibility." }}
        </div>
      </div>
      <div class="pdp-v10__acc">
        <button class="pdp-v10__acc-btn">Materials & Care <span>+</span></button>
        <div class="pdp-v10__acc-content" style="display:none;">
          Crafted from premium shock-absorbing TPU and tough polycarbonate. Wipe clean with a damp cloth. Do not use harsh chemicals.
        </div>
      </div>
      <div class="pdp-v10__acc">
        <button class="pdp-v10__acc-btn">Warranty Information <span>+</span></button>
        <div class="pdp-v10__acc-content" style="display:none;">
          Covered by our 1-year limited warranty against manufacturing defects.
        </div>
      </div>

    </div>
  </div>

  <!-- FEATURED / CROSS SELL -->
  {% if section.settings.show_featured %}
    <div class="pdp-v10__section">
      <h2 class="pdp-v10__sec-title">Shop By Collection</h2>
      <div class="pdp-v10__grid">
        {% for i in (1..4) %}
          <div class="pdp-v10__card">
            {% capture ph %}product-{{ i }}{% endcapture %}
            {{ ph | placeholder_svg_tag }}
            <div class="pdp-v10__card-title">Premium Vegan Leather Wallet</div>
            <div class="pdp-v10__card-price">₹1499</div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <!-- RECENTLY VIEWED (DYNAMIC) -->
  {% if section.settings.show_recently_viewed %}
    <div class="pdp-v10__section">
      <h2 class="pdp-v10__sec-title">Recently Viewed</h2>
      <!-- The JS below will populate this grid -->
      <div class="pdp-v10__grid" id="v10-recently-viewed-grid"></div>
    </div>
  {% endif %}

  <!-- BUILT-IN STICKY ATC -->
  <div class="pdp-v10-sticky" id="v10-sticky-atc">
    <div class="pdp-v10-sticky__info">
      {% if product.featured_media %}
        <img src="{{ product.featured_media | image_url: width: 100 }}" alt="{{ product.title | escape }}" width="100" height="100" loading="lazy" class="pdp-v10-sticky__img">
      {% else %}
        <div class="pdp-v10-sticky__img">{{ 'product-1' | placeholder_svg_tag }}</div>
      {% endif %}
      <div>
        <div class="pdp-v10-sticky__title">{{ product.title | default: "The Loners Stride 2.0" }}</div>
        <div class="pdp-v10-sticky__price">{{ current_variant.price | money }}</div>
      </div>
    </div>
    <button class="pdp-v10-sticky__btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">ADD TO CART</button>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      // Basic accordion logic
      const accBtns = document.querySelectorAll('.pdp-v10__acc-btn');
      accBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const content = this.nextElementSibling;
          if (content.style.display === "none" || content.style.display === "") {
            content.style.display = "block";
            this.querySelector('span').innerText = "-";
          } else {
            content.style.display = "none";
            this.querySelector('span').innerText = "+";
          }
        });
      });

      // Sticky ATC Logic
      const stickyBar = document.getElementById('v10-sticky-atc');
      const mainAtc = document.getElementById('v10-main-atc');
      
      if(stickyBar && mainAtc) {
        window.addEventListener('scroll', function() {
          const mainAtcRect = mainAtc.getBoundingClientRect();
          // Show sticky when main ATC is scrolled past top of screen
          if (mainAtcRect.top < 0) {
            stickyBar.classList.add('visible');
          } else {
            stickyBar.classList.remove('visible');
          }
        });
      }
      // Countdown Timer Logic (LocalStorage based)
      const countdowns = document.querySelectorAll('.pdp-v10__timer');
      countdowns.forEach(timer => {
        const hoursToAdd = parseInt(timer.getAttribute('data-countdown')) || 4;
        const endTimeKey = 'pdp_countdown_end_' + window.location.pathname;
        let endTime = localStorage.getItem(endTimeKey);
        
        if (!endTime) {
          endTime = new Date().getTime() + (hoursToAdd * 60 * 60 * 1000);
          localStorage.setItem(endTimeKey, endTime);
        } else {
          endTime = parseInt(endTime);
          // Reset if timer is already in the past
          if (new Date().getTime() > endTime) {
             endTime = new Date().getTime() + (hoursToAdd * 60 * 60 * 1000);
             localStorage.setItem(endTimeKey, endTime);
          }
        }

        const updateTimer = () => {
          const now = new Date().getTime();
          const distance = endTime - now;

          if (distance < 0) return;

          const h = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const m = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const s = Math.floor((distance % (1000 * 60)) / 1000);

          timer.querySelector('.hours').innerText = h < 10 ? '0' + h : h;
          timer.querySelector('.minutes').innerText = m < 10 ? '0' + m : m;
          timer.querySelector('.seconds').innerText = s < 10 ? '0' + s : s;
        };
        
        updateTimer();
        setInterval(updateTimer, 1000);
      });

      // --- RECENTLY VIEWED LOGIC ---
      const currentHandle = "{{ product.handle }}";
      const rvStorageKey = 'cf_recent_products';
      let viewed = JSON.parse(localStorage.getItem(rvStorageKey) || '[]');
      
      // Save current product if not already first
      if (currentHandle && currentHandle !== "") {
        viewed = viewed.filter(h => h !== currentHandle);
        viewed.unshift(currentHandle);
        if (viewed.length > 6) viewed.pop(); // Keep max 6
        localStorage.setItem(rvStorageKey, JSON.stringify(viewed));
      }

      // Load Recently Viewed Products
      const rvGrid = document.getElementById('v10-recently-viewed-grid');
      if (rvGrid && viewed.length > 0) {
        // Filter out current product so we don't show what they are already looking at
        const handlesToFetch = viewed.filter(h => h !== currentHandle).slice(0, 4); 
        
        if (handlesToFetch.length > 0) {
          Promise.all(handlesToFetch.map(handle => 
            fetch(`/products/${handle}?section_id=product-card-api`)
              .then(res => res.text())
          ))
          .then(htmls => {
            // Check if any returned valid HTML (not 404)
            const validHtmls = htmls.filter(html => html && !html.includes('404'));
            if(validHtmls.length > 0) {
               rvGrid.innerHTML = validHtmls.join('');
            } else {
               rvGrid.parentElement.style.display = 'none'; // hide section if nothing
            }
          })
          .catch(err => {
            console.error("Recently viewed fetch error:", err);
            rvGrid.parentElement.style.display = 'none';
          });
        } else {
           rvGrid.parentElement.style.display = 'none';
        }
      } else if(rvGrid) {
        rvGrid.parentElement.style.display = 'none';
      }

    });
  </script>

</div>

