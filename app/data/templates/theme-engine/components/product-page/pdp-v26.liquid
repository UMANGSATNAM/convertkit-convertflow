{%- comment -%}
  PDP V26: FOOTWEAR / SNEAKERS
  Aesthetic: Hypebeast, bold, high contrast, streetwear vibe.
  Features: Pincode Checker, Product Reels (on-feet), Size Toggle, Urgency, Sticky ATC.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign random_stock = 'now' | date: '%s' | modulo: 12 | plus: 3 -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Anton&family=Roboto:ital,wght@0,400;0,700;0,900;1,900&display=swap');

  :root {
    --v26-bg: #EAEAEA;
    --v26-bg-panel: #FFFFFF;
    --v26-text: #000000;
    --v26-text-light: #666666;
    --v26-primary: #FF3300; /* Hype Red/Orange */
    --v26-border: #D0D0D0;
    --v26-font-heading: 'Anton', sans-serif;
    --v26-font-body: 'Roboto', sans-serif;
  }

  .pdp-v26 {
    background-color: var(--v26-bg);
    color: var(--v26-text);
    font-family: var(--v26-font-body);
    line-height: 1.5;
  }

  .pdp-v26__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px;
    display: grid;
    gap: 20px;
  }
  @media (min-width: 992px) {
    .pdp-v26__container { grid-template-columns: 1fr 400px; gap: 40px; padding: 40px 20px; }
  }

  /* --- GALLERY --- */
  .pdp-v26__gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .pdp-v26__img-wrap:first-child { grid-column: 1 / -1; }
  .pdp-v26__gallery img, .pdp-v26__gallery svg { width: 100%; aspect-ratio: 1; object-fit: cover; background: #FFF; box-shadow: 4px 4px 0 rgba(0,0,0,0.1); }

  /* --- INFO PANEL --- */
  .pdp-v26__panel {
    background: var(--v26-bg-panel);
    padding: 24px;
    box-shadow: 8px 8px 0 var(--v26-text);
    border: 2px solid var(--v26-text);
    align-self: start;
    position: sticky;
    top: 20px;
  }
  
  .pdp-v26__title {
    font-family: var(--v26-font-heading);
    font-size: 42px; font-weight: 400; margin: 0 0 10px 0; color: var(--v26-text); line-height: 1; text-transform: uppercase; letter-spacing: 1px;
  }
  
  .pdp-v26__price-wrap {
    display: flex; align-items: flex-end; gap: 12px; margin-bottom: 24px;
  }
  .pdp-v26__price { font-size: 32px; font-weight: 900; color: var(--v26-primary); line-height: 1; }
  .pdp-v26__compare { font-size: 18px; color: var(--v26-text-light); text-decoration: line-through; font-weight: 700; margin-bottom: 4px; }

  /* --- URGENCY --- */
  .pdp-v26__urgency {
    display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 900; color: #FFF; background: var(--v26-text); padding: 12px; margin-bottom: 24px; text-transform: uppercase; letter-spacing: 1px;
  }
  .pdp-v26__urgency span { color: var(--v26-primary); }

  /* --- SIZES --- */
  .pdp-v26__sizes { margin-bottom: 24px; }
  .pdp-v26__s-head { display: flex; justify-content: space-between; align-items: center; font-weight: 900; margin-bottom: 12px; font-size: 14px; text-transform: uppercase; }
  .pdp-v26__s-toggle { display: flex; gap: 10px; font-size: 12px; color: var(--v26-text-light); }
  .pdp-v26__s-toggle span { cursor: pointer; }
  .pdp-v26__s-toggle span.active { color: var(--v26-text); text-decoration: underline; }
  
  .pdp-v26__s-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .pdp-v26__s-item {
    border: 2px solid var(--v26-border); height: 48px;
    display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px;
    cursor: pointer; background: var(--v26-bg-panel); transition: all 0.2s;
  }
  .pdp-v26__s-item.active { border-color: var(--v26-text); color: #FFF; background: var(--v26-text); }
  .pdp-v26__s-item:hover:not(.active) { border-color: var(--v26-text); }
  .pdp-v26__s-item.oos { opacity: 0.3; text-decoration: line-through; pointer-events: none; }

  /* --- PINCODE CHECKER --- */
  .pdp-v26__pincode { margin-bottom: 24px; border: 2px dashed var(--v26-border); padding: 16px; }
  .pdp-v26__pin-title { font-weight: 900; font-size: 14px; margin-bottom: 12px; text-transform: uppercase; }
  .pdp-v26__pin-input-wrap { display: flex; }
  .pdp-v26__pin-input { flex: 1; background: var(--v26-bg); border: none; padding: 12px; font-family: var(--v26-font-body); font-weight: 700; font-size: 14px; outline: none; }
  .pdp-v26__pin-btn { background: var(--v26-text); color: #FFF; border: none; padding: 0 16px; font-weight: 900; font-size: 14px; cursor: pointer; text-transform: uppercase; }
  .pdp-v26__pin-msg { margin-top: 8px; font-size: 13px; font-weight: 700; color: #188038; display: none; }

  /* --- ATC --- */
  .pdp-v26__atc {
    width: 100%; background: var(--v26-primary); color: #FFF; border: none; padding: 20px; font-size: 24px; font-weight: 400; cursor: pointer; margin-bottom: 16px; font-family: var(--v26-font-heading); text-transform: uppercase; letter-spacing: 2px; transition: transform 0.1s;
    box-shadow: 4px 4px 0 var(--v26-text);
  }
  .pdp-v26__atc:active { transform: translate(4px, 4px); box-shadow: 0 0 0 transparent; }
  
  .pdp-v26__desc { font-size: 14px; color: var(--v26-text-light); margin-top: 24px; font-weight: 500; }

  /* --- PRODUCT REELS --- */
  .pdp-v26__section { padding: 40px 20px; max-width: 1400px; margin: 0 auto; }
  .pdp-v26__sec-title { font-family: var(--v26-font-heading); font-size: 48px; margin-bottom: 24px; text-transform: uppercase; line-height: 1; }
  
  .pdp-v26__reels { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 10px; }
  .pdp-v26__reel { min-width: 250px; aspect-ratio: 4/5; background: #FFF; position: relative; scroll-snap-align: start; flex: 1; box-shadow: 6px 6px 0 var(--v26-text); border: 2px solid var(--v26-text); }
  .pdp-v26__reel img, .pdp-v26__reel svg { width: 100%; height: 100%; object-fit: cover; }
  .pdp-v26__reel-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 60px; height: 60px; background: var(--v26-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #FFF; border: 2px solid var(--v26-text); cursor: pointer; }

  /* --- TRUST BADGES --- */
  .pdp-v26__trust { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; text-align: center; margin-top: 24px; border-top: 2px dashed var(--v26-border); padding-top: 24px; }
  .pdp-v26__t-item svg { width: 28px; height: 28px; color: var(--v26-text); margin-bottom: 8px; }
  .pdp-v26__t-item span { display: block; font-size: 12px; font-weight: 900; text-transform: uppercase; }

  /* --- FULL WIDTH LIFESTYLE --- */
  .pdp-v26__lifestyle { width: 100%; position: relative; margin: 60px 0; border-top: 4px solid var(--v26-text); border-bottom: 4px solid var(--v26-text); }
  .pdp-v26__lifestyle img, .pdp-v26__lifestyle svg { width: 100%; height: 60vh; object-fit: cover; display: block; filter: grayscale(100%); }
  .pdp-v26__life-overlay { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; background: var(--v26-primary); padding: 20px 40px; border: 4px solid var(--v26-text); box-shadow: 12px 12px 0 var(--v26-text); color: #FFF; transform: translate(-50%, -50%) rotate(-2deg); }
  .pdp-v26__life-title { font-family: var(--v26-font-heading); font-size: 48px; margin: 0; line-height: 1; letter-spacing: 2px; }

  /* --- GRIDS (RELATED) --- */
  .pdp-v26__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (min-width: 768px) { .pdp-v26__grid { grid-template-columns: repeat(4, 1fr); gap: 24px; } }
  .pdp-v26__card { background: #FFF; padding: 12px; border: 2px solid var(--v26-text); box-shadow: 4px 4px 0 var(--v26-text); transition: transform 0.2s; }
  .pdp-v26__card:hover { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--v26-text); }
  .pdp-v26__card img { width: 100%; aspect-ratio: 1; object-fit: cover; border-bottom: 2px solid var(--v26-text); margin-bottom: 12px; }
  .pdp-v26__card-title { font-size: 16px; font-weight: 900; margin-bottom: 4px; text-transform: uppercase; }
  .pdp-v26__card-price { font-weight: 700; color: var(--v26-primary); font-size: 18px; }

</style>

<div class="pdp-v26" data-section="{{ section.id }}">
  <div class="pdp-v26__container">
    
    <!-- GALLERY -->
    <div class="pdp-v26__gallery">
      {% if product.featured_media %}
        {% for media in product.media limit: 5 %}
          <div class="pdp-v26__img-wrap"><img height="{{ media.height }}" width="{{ media.width }}" src="{{ media | image_url: width: 800 }}" alt="{{ product.title }}"></div>
        {% endfor %}
      {% else %}
        <div class="pdp-v26__img-wrap">{{ 'product-1' | placeholder_svg_tag }}</div>
        <div class="pdp-v26__img-wrap">{{ 'product-2' | placeholder_svg_tag }}</div>
        <div class="pdp-v26__img-wrap">{{ 'product-3' | placeholder_svg_tag }}</div>
        <div class="pdp-v26__img-wrap">{{ 'product-4' | placeholder_svg_tag }}</div>
        <div class="pdp-v26__img-wrap">{{ 'product-5' | placeholder_svg_tag }}</div>
      {% endif %}
    </div>

    <!-- INFO PANEL -->
    <div class="pdp-v26__panel">
      <h1 class="pdp-v26__title">{{ product.title | default: "Retro High OG 'Chicago'" }}</h1>
      
      <div class="pdp-v26__price-wrap">
        <span class="pdp-v26__price">{{ current_variant.price | money | default: "₹14,999" }}</span>
        {% if current_variant.compare_at_price > current_variant.price %}
          <span class="pdp-v26__compare">{{ current_variant.compare_at_price | money }}</span>
        {% endif %}
      </div>

      {% if section.settings.show_urgency %}
        <div class="pdp-v26__urgency">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path></svg>
          HYPE DROP • <span>ONLY {{ random_stock }} PAIRS LEFT</span>
        </div>
      {% endif %}

      <div class="pdp-v26__sizes">
        <div class="pdp-v26__s-head">
          <span>Select Size</span>
          <div class="pdp-v26__s-toggle">
            <span class="active">UK</span> | <span>US</span> | <span>EU</span>
          </div>
        </div>
        <div class="pdp-v26__s-grid">
          <div class="pdp-v26__s-item">7</div>
          <div class="pdp-v26__s-item active">8</div>
          <div class="pdp-v26__s-item">9</div>
          <div class="pdp-v26__s-item">10</div>
          <div class="pdp-v26__s-item oos">11</div>
          <div class="pdp-v26__s-item">12</div>
        </div>
      </div>

      {% if section.settings.show_pincode %}
        <div class="pdp-v26__pincode">
          <div class="pdp-v26__pin-title">Check Delivery</div>
          <div class="pdp-v26__pin-input-wrap">
            <input type="text" class="pdp-v26__pin-input" id="v26-pin" placeholder="ENTER PIN" maxlength="6">
            <button class="pdp-v26__pin-btn" onclick="document.getElementById('v26-pin-msg').style.display='block'">Check</button>
          </div>
          <div class="pdp-v26__pin-msg" id="v26-pin-msg">✔ Ships in 24 Hours.</div>
        </div>
      {% endif %}

      
      <!-- D2C SCARCITY & NOTIFY -->
      {% if product.available %}
        <div style="background:#FFF3E0; border:1px solid #FFCC80; padding:10px; border-radius:8px; margin-bottom:12px; display:flex; align-items:center; gap:12px;">
          <svg style="width:24px; height:24px; color:#E65100; flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <div style="font-size:13px; color:#E65100;">
            <div style="font-weight:700;">Limited Time Offer Ends In:</div>
            <div style="font-size:16px; font-weight:700; margin-top:2px;"><b>{% render 'countdown-timer', product: product %}</b></div>
          </div>
        </div>
      {% endif %}

      {% render 'back-in-stock', product: product %}

      {% if product.available %}
      <button class="pdp-v26__atc" id="v26-atc">ADD TO CART</button>
      {% else %}
      <button class="pdp-v26__atc" disabled style="opacity:0.5; cursor:not-allowed;">SOLD OUT</button>
      {% endif %}
      
      <div class="pdp-v26__desc">
        {{ product.description | strip_html | default: "The sneaker that started it all. Premium leather upper, encapsulated Air-Sole unit, and timeless color blocking. 100% Authentic Guaranteed." }}
      </div>

      {% if section.settings.show_trust_badges %}
        <div class="pdp-v26__trust">
          <div class="pdp-v26__t-item">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>Auth<br>Guaranteed</span>
          </div>
          <div class="pdp-v26__t-item">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
            <span>Secure<br>Payment</span>
          </div>
          <div class="pdp-v26__t-item">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            <span>Free<br>Shipping</span>
          </div>
        </div>
      {% endif %}

    </div>
  </div>

  {% if section.settings.show_reels %}
    <div class="pdp-v26__section">
      <h2 class="pdp-v26__sec-title">ON FEET</h2>
      <div class="pdp-v26__reels">
        <div class="pdp-v26__reel">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
          <div class="pdp-v26__reel-play"><svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
        </div>
        <div class="pdp-v26__reel">
          {{ 'lifestyle-2' | placeholder_svg_tag }}
          <div class="pdp-v26__reel-play"><svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
        </div>
        <div class="pdp-v26__reel">
          {{ 'image' | placeholder_svg_tag }}
          <div class="pdp-v26__reel-play"><svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
        </div>
      </div>
    </div>
  {% endif %}

  {% if section.settings.show_full_image %}
    <div class="pdp-v26__lifestyle">
      {{ 'collection-1' | placeholder_svg_tag }}
      <div class="pdp-v26__life-overlay">
        <h2 class="pdp-v26__life-title">DON'T SLEEP</h2>
      </div>
    </div>
  {% endif %}

  {% if section.settings.show_cross_sell %}
    <div class="pdp-v26__section">
      <h2 class="pdp-v26__sec-title">MORE HEAT</h2>
      <div class="pdp-v26__grid">
        {% for i in (1..4) %}
          <div class="pdp-v26__card">
            {% capture ph %}product-{{ i }}{% endcapture %}
            {{ ph | placeholder_svg_tag }}
            <div class="pdp-v26__card-title">Dunk Low 'Panda'</div>
            <div class="pdp-v26__card-price">₹8,999</div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

</div>

<!-- STICKY ATC -->
<style>
  .sticky-atc-{{ section.id }} {
    position: fixed; bottom: -100px; left: 0; width: 100%;
    background: var(--v26-text); border-top: 4px solid var(--v26-primary);
    z-index: 999; padding: 16px 20px;
    display: flex; justify-content: space-between; align-items: center;
    transition: bottom 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); font-family: var(--v26-font-body);
  }
  .sticky-atc-{{ section.id }}.visible { bottom: 0; }
  .sticky-atc-{{ section.id }}__info { display: flex; align-items: center; gap: 16px; }
  .sticky-atc-{{ section.id }}__img { width: 50px; height: 50px; object-fit: cover; background: #FFF; }
  .sticky-atc-{{ section.id }}__title { font-weight: 900; font-size: 16px; color: #FFF; text-transform: uppercase; }
  .sticky-atc-{{ section.id }}__price { font-weight: 700; color: var(--v26-primary); font-size: 16px; }
  .sticky-atc-{{ section.id }}__btn { background: var(--v26-primary); color: #FFF; border: none; padding: 14px 40px; font-weight: 400; font-family: var(--v26-font-heading); font-size: 20px; cursor: pointer; text-transform: uppercase; letter-spacing: 1px; box-shadow: 4px 4px 0 #FFF; transition: transform 0.1s; }
  .sticky-atc-{{ section.id }}__btn:active { transform: translate(4px, 4px); box-shadow: 0 0 0 transparent; }
  @media (max-width: 768px) {
    .sticky-atc-{{ section.id }}__info { display: none; }
    .sticky-atc-{{ section.id }}__btn { width: 100%; padding: 16px; font-size: 24px; }
  }
</style>

<div class="sticky-atc-{{ section.id }}" id="sticky-atc-{{ section.id }}">
  <div class="sticky-atc-{{ section.id }}__info">
    {% if product.featured_media %}
      <img src="{{ product.featured_media | image_url: width: 100 }}" alt="{{ product.title | escape }}" width="100" height="100" loading="lazy" class="sticky-atc-{{ section.id }}__img">
    {% endif %}
    <div>
      <div class="sticky-atc-{{ section.id }}__title">{{ product.title | default: "Retro High OG 'Chicago'" }}</div>
      <div class="sticky-atc-{{ section.id }}__price">{{ current_variant.price | money | default: "₹14,999" }}</div>
    </div>
  </div>
  <button class="sticky-atc-{{ section.id }}__btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">COP NOW</button>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const stickyBar = document.getElementById('sticky-atc-{{ section.id }}');
    const mainAtc = document.getElementById('v26-atc');
    
    if(stickyBar && mainAtc) {
      window.addEventListener('scroll', function() {
        const mainAtcRect = mainAtc.getBoundingClientRect();
        if (mainAtcRect.top < 0) {
          stickyBar.classList.add('visible');
        } else {
          stickyBar.classList.remove('visible');
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "PDP V26 - Sneakers",
  "settings": [
    {
      "type": "header",
      "content": "Urgency & Pincode"
    },
    {
      "type": "checkbox",
      "id": "show_urgency",
      "label": "Show 'Hype Drop' Banner",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pincode",
      "label": "Show Pincode Checker",
      "default": true
    },
    {
      "type": "header",
      "content": "Media Blocks"
    },
    {
      "type": "checkbox",
      "id": "show_reels",
      "label": "Show 'On Feet' Reels",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_full_image",
      "label": "Show Full Width Lifestyle Image",
      "default": true
    },
    {
      "type": "header",
      "content": "Trust & Cross Sells"
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Show Trust Badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cross_sell",
      "label": "Show 'More Heat' Section",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "PDP V26 - Sneakers"
    }
  ]
}
{% endschema %}
