<style>
@media screen and (max-width: 768px) {
  .hp44-marquee {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp44-marq-bg: {{ section.settings.bg_color | default: '#143D2B' }};
    --hp44-marq-text: {{ section.settings.text_color | default: '#F2E8CF' }};
    
    background: var(--hp44-marq-bg);
    color: var(--hp44-marq-text);
    padding-top: {{ section.settings.padding_vertical | default: 16 }}px;
    padding-bottom: {{ section.settings.padding_vertical | default: 16 }}px;
    overflow: hidden;
    white-space: nowrap;
    position: relative;
  }

  .hp44-marquee__track {
    display: inline-flex;
    gap: 40px;
    animation: hp44-marquee-scroll {{ section.settings.speed | default: 22 }}s linear infinite;
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .hp44-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  @keyframes hp44-marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}

<div class="hp44-marquee__track">
  {%- if section.blocks.size > 0 -%}
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <div class="hp44-marquee__item" {{ block.shopify_attributes }}>
          <span>{{ block.settings.icon | default: '🌿' }}</span>
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  {%- else -%}
    {%- for i in (1..2) -%}
      <div class="hp44-marquee__item"><span>🌿</span><span>COLD-PRESSED CLARY SAGE PEPTIDES</span></div>
      <div class="hp44-marquee__item"><span>✦</span><span>100% ORGANIC NORDIC INGREDIENTS</span></div>
      <div class="hp44-marquee__item"><span>✈️</span><span>FREE EXPRESS AIR SHIPPING OVER $70</span></div>
      <div class="hp44-marquee__item"><span>🛡️</span><span>DERMATOLOGIST CLINICALLY TESTED</span></div>
    {%- endfor -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP44 - Sage Marquee",
  "class": "section-hp44-marquee",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#143D2B" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#F2E8CF" },
    { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 2, "unit": "s", "label": "Scroll Duration", "default": 22 },
    { "type": "range", "id": "padding_vertical", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Vertical Padding", "default": 16 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ticker Item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon / Emoji", "default": "🌿" },
        { "type": "text", "id": "text", "label": "Text", "default": "Cold-Pressed Clary Sage Peptides" }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP44 - Sage Marquee",
      "blocks": [
        { "type": "item", "settings": { "icon": "🌿", "text": "COLD-PRESSED CLARY SAGE PEPTIDES" } },
        { "type": "item", "settings": { "icon": "✦", "text": "100% ORGANIC NORDIC INGREDIENTS" } },
        { "type": "item", "settings": { "icon": "✈️", "text": "FREE EXPRESS AIR SHIPPING OVER $70" } },
        { "type": "item", "settings": { "icon": "🛡️", "text": "DERMATOLOGIST CLINICALLY TESTED" } }
      ]
    }
  ]
}
{% endschema %}
