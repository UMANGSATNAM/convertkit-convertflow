{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 0;
    overflow: hidden;
    border-top: 1px solid rgba(0,0,0,0.1);
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }
  
  .hp15-scroll-container-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
  }
  
  .hp15-scroll-content-{{ section_id }} {
    display: inline-block;
    padding-left: 100%;
    animation: hp15-scroll-{{ section_id }} 25s linear infinite;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: {{ text_color }};
  }
  
  .hp15-scroll-content-{{ section_id }} span {
    margin: 0 50px;
    font-family: 'Didot', 'Playfair Display', serif;
    font-size: 1.2rem;
    vertical-align: middle;
  }
  
  @keyframes hp15-scroll-{{ section_id }} {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-100%, 0); }
  }
</style>

<div class="hp15-scroll-container-{{ section_id }}">
  <div class="hp15-scroll-content-{{ section_id }}">
    {% for i in (1..6) %}
      {{ section.settings.text | default: 'PARIS' }}
      <span>|</span>
      {{ section.settings.text_2 | default: 'LONDON' }}
      <span>|</span>
      {{ section.settings.text_3 | default: 'NEW YORK' }}
      <span>|</span>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP15 Scrolling Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text 1",
      "default": "PARIS"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Text 2",
      "default": "LONDON"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Text 3",
      "default": "NEW YORK"
    }
  ],
  "presets": [
    {
      "name": "HP15 Scrolling Text"
    }
  ]
}
{% endschema %}
