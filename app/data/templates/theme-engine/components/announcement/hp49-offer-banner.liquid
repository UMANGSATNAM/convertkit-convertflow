{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp49-offer-bg: {{ section.settings.bg_color | default: '#7C3AED' }};
    --hp49-offer-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    
    background: var(--hp49-offer-bg);
    color: var(--hp49-offer-text);
    padding-top: {{ section.settings.padding_top | default: 75 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 75 }}px;
    text-align: center;
  }

  .hp49-offer__box {
    max-width: {{ section.settings.container_width | default: 860 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp49-offer__pill {
    display: inline-block;
    padding: 6px 18px;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .hp49-offer__title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 16px;
  }

  .hp49-offer__desc {
    font-size: 16px;
    line-height: 1.7;
    color: #EDE9FE;
    margin: 0 auto 30px;
    max-width: 580px;
  }

  .hp49-offer__code-wrap {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.15);
    border: 1px dashed rgba(255, 255, 255, 0.5);
    padding: 10px 24px;
    border-radius: 50px;
    margin-bottom: 30px;
  }

  .hp49-offer__code {
    font-family: 'Urbanist', sans-serif;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .hp49-offer__btn {
    display: inline-flex;
    padding: 16px 36px;
    background: #FFFFFF;
    color: #7C3AED;
    font-family: 'Urbanist', sans-serif;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    transition: all 0.25s ease;
  }

  .hp49-offer__btn:hover {
    background: #F5F3FF;
    transform: translateY(-2px);
  }
{%- endstyle -%}

<div class="hp49-offer__box">
  <span class="hp49-offer__pill">{{ section.settings.badge | default: 'CLOUD WELCOME OFFER' }}</span>
  <h2 class="hp49-offer__title">{{ section.settings.heading | default: 'ENJOY 20% OFF YOUR INITIAL DREAM RITUAL' }}</h2>
  <p class="hp49-offer__desc">
    {{ section.settings.description | default: 'Experience the restorative serenity of French alpine lavender and cherry blossom peptides. Apply dream voucher at checkout.' }}
  </p>

  <div class="hp49-offer__code-wrap">
    <span class="hp49-offer__code">CODE: {{ section.settings.promo_code | default: 'DREAM20' }}</span>
  </div>

  <div>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp49-offer__btn">
      {{ section.settings.btn_text | default: 'Claim Dream Code &rarr;' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP49 - Lavender Offer",
  "class": "section-hp49-offer",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#7C3AED" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFFFF" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "CLOUD WELCOME OFFER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "ENJOY 20% OFF YOUR INITIAL DREAM RITUAL" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Experience the restorative serenity of French alpine lavender and cherry blossom peptides." },
    { "type": "text", "id": "promo_code", "label": "Promo Code", "default": "DREAM20" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Claim Dream Code →" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Top", "default": 75 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 75 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 860 }
  ],
  "presets": [
    { "name": "HP49 - Lavender Offer" }
  ]
}
{% endschema %}
