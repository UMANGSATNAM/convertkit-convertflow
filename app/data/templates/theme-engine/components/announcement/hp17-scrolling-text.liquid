{%- liquid
  assign section_id = section.id
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: #000;
    padding: 30px 0;
    overflow: hidden;
    border-top: 1px dashed rgba(184, 0, 255, 0.5);
    border-bottom: 1px dashed rgba(184, 0, 255, 0.5);
  }
  
  .hp17-scroll-container-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
    transform: rotate(-2deg) scale(1.05);
    background: #111;
    border: 1px solid #B800FF;
    padding: 10px 0;
    box-shadow: 0 0 15px rgba(184, 0, 255, 0.2);
  }
  
  .hp17-scroll-content-{{ section_id }} {
    display: inline-block;
    padding-left: 100%;
    animation: hp17-scroll-{{ section_id }} 15s linear infinite;
    font-family: 'Arial Black', sans-serif;
    font-size: 2rem;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px #B800FF;
    letter-spacing: 5px;
  }
  
  .hp17-scroll-content-{{ section_id }} span {
    margin: 0 30px;
    color: #B800FF;
    -webkit-text-stroke: 0;
  }
  
  @keyframes hp17-scroll-{{ section_id }} {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-100%, 0); }
  }
</style>

<div class="hp17-scroll-container-{{ section_id }}">
  <div class="hp17-scroll-content-{{ section_id }}">
    {% for i in (1..6) %}
      {{ section.settings.text | default: 'JACK INTO THE MATRIX' }}
      <span>&#x271A;</span>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP17 Scrolling Text",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "JACK INTO THE MATRIX"
    }
  ],
  "presets": [
    {
      "name": "HP17 Scrolling Text"
    }
  ]
}
{% endschema %}
