{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp57-marq-bg: {{ section.settings.bg_color | default: '#1B4332' }};
    --hp57-marq-text: {{ section.settings.text_color | default: '#A7F3D0' }};
    background: var(--hp57-marq-bg);
    overflow: hidden;
    padding: {{ section.settings.padding_vertical | default: 10 }}px 0;
  }
  .hp57-marquee__track {
    display: flex; gap: 50px;
    animation: hp57MarqueeScroll {{ section.settings.speed | default: 25 }}s linear infinite;
    width: max-content;
  }
  .hp57-marquee__item {
    display: flex; align-items: center; gap: 50px; white-space: nowrap;
    font-family: 'Cormorant Garamond', serif;
    font-size: {{ section.settings.font_size | default: 15 }}px;
    font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--hp57-marq-text);
  }
  .hp57-marquee__dot {
    width: 6px; height: 6px;
    background: {{ section.settings.dot_color | default: '#D97706' }};
    border-radius: 50%; flex-shrink: 0;
  }
  @keyframes hp57MarqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}
<div class="hp57-marquee__track">
  {%- for i in (1..12) -%}
    <div class="hp57-marquee__item">
      <span>{{ section.settings.marquee_text | default: '🌿 FOREST FERN 🌿 OCHRE CALENDULA 🌿 BOTANICAL APOTHECARY 🌿 PURE BIO-LIPIDS' }}</span>
      <span class="hp57-marquee__dot"></span>
    </div>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "HP57 Marquee",
  "class": "section-hp57-marquee",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1B4332" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#A7F3D0" },
    { "type": "color", "id": "dot_color", "label": "Dot Color", "default": "#D97706" },
    { "type": "text", "id": "marquee_text", "label": "Marquee Text", "default": "🌿 FOREST FERN 🌿 OCHRE CALENDULA 🌿 BOTANICAL APOTHECARY 🌿 PURE BIO-LIPIDS" },
    { "type": "range", "id": "speed", "min": 10, "max": 50, "step": 5, "unit": "s", "label": "Speed", "default": 25 },
    { "type": "range", "id": "font_size", "min": 10, "max": 22, "step": 1, "unit": "px", "label": "Font Size", "default": 15 },
    { "type": "range", "id": "padding_vertical", "min": 4, "max": 24, "step": 2, "unit": "px", "label": "Padding", "default": 10 }
  ],
  "presets": [{ "name": "HP57 Marquee" }]
}
{% endschema %}
