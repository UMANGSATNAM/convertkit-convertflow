{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-bg: {{ section.settings.accent_bg }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Lato', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp31-offer-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp31-offer-wrapper {
      padding: 0 20px;
    }
  }

  .hp31-offer__container {
    background-color: var(--accent-bg);
    border-radius: 24px;
    padding: 80px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    .hp31-offer__container {
      padding: 60px 20px;
    }
  }

  .hp31-offer__tagline {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-color);
    margin-bottom: 24px;
    display: block;
    opacity: 0.7;
    position: relative;
    z-index: 2;
  }

  .hp31-offer__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.2;
    color: var(--text-color);
    margin: 0 auto 24px;
    font-weight: 400;
    max-width: 700px;
    position: relative;
    z-index: 2;
  }

  .hp31-offer__title em {
    font-style: italic;
  }

  .hp31-offer__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0 auto 40px;
    max-width: 500px;
    font-weight: 300;
    position: relative;
    z-index: 2;
  }

  .hp31-offer__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    background: transparent;
    color: var(--text-color);
    border: 1px solid var(--text-color);
    border-radius: 50px;
    transition: all 0.4s ease;
    position: relative;
    z-index: 2;
  }

  .hp31-offer__btn:hover {
    background: var(--text-color);
    color: var(--bg-color);
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
  }

  .hp31-offer__bg-shape {
    position: absolute;
    width: 500px;
    height: 500px;
    background: #ffffff;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.3;
    top: -250px;
    left: -150px;
    z-index: 1;
    pointer-events: none;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp31-offer-wrapper" id="HP31Offer-{{ section.id }}">
  <div class="hp31-offer__container">
    <div class="hp31-offer__bg-shape"></div>
    
    {%- if section.settings.tagline != blank -%}
      <span class="hp31-offer__tagline">{{ section.settings.tagline }}</span>
    {%- endif -%}
    
    <h2 class="hp31-offer__title">{{ section.settings.title }}</h2>
    
    {%- if section.settings.text != blank -%}
      <p class="hp31-offer__text">{{ section.settings.text }}</p>
    {%- endif -%}
    
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp31-offer__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP31 - Zen Offer Banner",
  "class": "section-hp31-offer-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Special Invitation"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Find your <em>balance</em> with 15% off."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Join our community and receive a welcome gift on your first curated order."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Sign Up Now"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 54
    },
    {
      "type": "header",
      "content": "Zen Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Outer)",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "accent_bg",
      "label": "Container Background (Muted)",
      "default": "#EAE6DF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#2C2C2C"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP31 - Zen Offer Banner"
    }
  ]
}
{% endschema %}
