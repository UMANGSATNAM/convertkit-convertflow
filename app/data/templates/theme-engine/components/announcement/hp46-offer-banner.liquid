{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp46-offer-bg: {{ section.settings.bg_color | default: 'linear-gradient(135deg, rgba(56, 189, 248, 0.15), rgba(244, 114, 182, 0.15))' }};
    
    background: var(--hp46-offer-bg);
    padding-top: {{ section.settings.padding_top | default: 75 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 75 }}px;
    border-top: 1px solid rgba(56, 189, 248, 0.3);
    border-bottom: 1px solid rgba(244, 114, 182, 0.3);
    text-align: center;
  }

  .hp46-offer__box {
    max-width: {{ section.settings.container_width | default: 860 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp46-offer__pill {
    display: inline-block;
    padding: 6px 18px;
    background: rgba(56, 189, 248, 0.2);
    border: 1px solid #38BDF8;
    border-radius: 50px;
    color: #38BDF8;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin-bottom: 20px;
  }

  .hp46-offer__title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 800;
    line-height: 1.1;
    color: #FFFFFF;
    margin: 0 0 16px;
  }

  .hp46-offer__title span {
    background: linear-gradient(135deg, #38BDF8, #F472B6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp46-offer__desc {
    font-size: 16px;
    line-height: 1.7;
    color: #94A3B8;
    margin: 0 auto 30px;
    max-width: 580px;
  }

  .hp46-offer__code-wrap {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid #F472B6;
    padding: 10px 24px;
    border-radius: 50px;
    margin-bottom: 30px;
    box-shadow: 0 0 25px rgba(244, 114, 182, 0.3);
  }

  .hp46-offer__code {
    font-family: 'Syne', sans-serif;
    font-size: 18px;
    font-weight: 800;
    color: #F472B6;
    letter-spacing: 2px;
  }

  .hp46-offer__btn {
    display: inline-flex;
    padding: 16px 36px;
    background: linear-gradient(135deg, #38BDF8, #F472B6);
    color: #0B0F19;
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 0 30px rgba(56, 189, 248, 0.4);
    transition: all 0.25s ease;
  }

  .hp46-offer__btn:hover {
    box-shadow: 0 0 45px rgba(244, 114, 182, 0.6);
    transform: translateY(-2px);
  }
{%- endstyle -%}

<div class="hp46-offer__box">
  <span class="hp46-offer__pill">{{ section.settings.badge | default: 'LIMITED ACCESS CODE' }}</span>
  <h2 class="hp46-offer__title">UNLOCK <span>20% PRIVILEGE</span> ACCESS</h2>
  <p class="hp46-offer__desc">
    {{ section.settings.description | default: 'Experience the revolutionary power of holographic bioluminescence. Apply cyber privilege code on first order.' }}
  </p>

  <div class="hp46-offer__code-wrap">
    <span class="hp46-offer__code">CODE: {{ section.settings.promo_code | default: 'CYBER20' }}</span>
  </div>

  <div>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp46-offer__btn">
      {{ section.settings.btn_text | default: 'CLAIM CYBER REWARD &rarr;' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP46 - Cyber Offer",
  "class": "section-hp46-offer",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "LIMITED ACCESS CODE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "UNLOCK 20% PRIVILEGE ACCESS" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Experience the revolutionary power of holographic bioluminescence." },
    { "type": "text", "id": "promo_code", "label": "Promo Code", "default": "CYBER20" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "CLAIM CYBER REWARD →" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Top", "default": 75 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 75 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 860 }
  ],
  "presets": [
    { "name": "HP46 - Cyber Offer" }
  ]
}
{% endschema %}
