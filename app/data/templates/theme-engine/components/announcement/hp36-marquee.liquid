{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --font-sans: 'Oswald', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--text-color);
    overflow: hidden;
  }

  .hp36-marquee-wrapper {
    display: flex;
    white-space: nowrap;
    position: relative;
    width: 100vw;
  }

  .hp36-marquee-track {
    display: flex;
    align-items: center;
    gap: {{ section.settings.gap }}px;
    animation: hp36Marquee {{ section.settings.speed }}s linear infinite;
  }

  .hp36-marquee-item {
    font-family: var(--font-sans);
    font-size: clamp(40px, 8vw, {{ section.settings.font_size }}px);
    font-weight: 500;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: {{ section.settings.gap }}px;
  }

  .hp36-marquee-separator {
    width: 10px;
    height: 10px;
    background-color: var(--text-color);
    border-radius: 50%;
  }

  @keyframes hp36Marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-100% - {{ section.settings.gap }}px)); }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp36-marquee-wrapper" id="HP36Marquee-{{ section.id }}">
  <div class="hp36-marquee-track">
    {%- for i in (1..8) -%}
      {%- for block in section.blocks -%}
        <div class="hp36-marquee-item" {{ block.shopify_attributes }}>
          {{ block.settings.text }}
          <div class="hp36-marquee-separator"></div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP36 - Editorial Marquee",
  "class": "section-hp36-marquee",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "label": "Animation Speed",
      "default": 30
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 24,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Text Size",
      "default": 80
    },
    {
      "type": "range",
      "id": "gap",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap between items",
      "default": 50
    },
    {
      "type": "header",
      "content": "Editorial Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "THE NEW STANDARD"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP36 - Editorial Marquee",
      "blocks": [
        { "type": "text", "settings": { "text": "THE NEW STANDARD" } },
        { "type": "text", "settings": { "text": "RADICAL SIMPLICITY" } },
        { "type": "text", "settings": { "text": "EXCLUSIVELY CURATED" } }
      ]
    }
  ]
}
{% endschema %}
