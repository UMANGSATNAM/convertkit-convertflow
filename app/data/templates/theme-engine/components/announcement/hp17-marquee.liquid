{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#00FF41'
  assign text_color = section.settings.text_color | default: '#0A0A0A'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 12px 0;
    overflow: hidden;
    border-top: 1px solid #FFF;
    border-bottom: 1px solid #FFF;
  }
  
  .hp17-marquee-container-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
  }
  
  .hp17-marquee-content-{{ section_id }} {
    display: inline-block;
    padding-left: 100%;
    animation: hp17-marquee-{{ section_id }} 12s linear infinite;
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.2rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: {{ text_color }};
  }
  
  .hp17-marquee-content-{{ section_id }} span {
    margin: 0 40px;
    opacity: 0.5;
  }
  
  @keyframes hp17-marquee-{{ section_id }} {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-100%, 0); }
  }

@media screen and (max-width: 768px) {
  .hp17-marquee {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}

</style>

<div class="hp17-marquee-container-{{ section_id }}">
  <div class="hp17-marquee-content-{{ section_id }}">
    {% for i in (1..8) %}
      {{ section.settings.text | default: 'WARNING: HIGH VOLTAGE GEAR DETECTED' }}
      <span>//</span>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP17 Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#00FF41"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0A0A0A"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "WARNING: HIGH VOLTAGE GEAR DETECTED"
    }
  ],
  "presets": [
    {
      "name": "HP17 Marquee"
    }
  ]
}
{% endschema %}
