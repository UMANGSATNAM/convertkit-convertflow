{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --speed: {{ section.settings.speed }}s;
    
    --font-heading: 'Inter', sans-serif;
    
    border-bottom: 2px solid var(--text-color);
  }

  .hp40-marquee-wrapper {
    background: var(--bg-color);
    padding: 30px 0;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    align-items: center;
    position: relative;
  }

  .hp40-marquee__track {
    display: inline-block;
    animation: hp40-scroll var(--speed) linear infinite;
  }
  
  .hp40-marquee__track:hover {
    animation-play-state: paused;
  }

  @keyframes hp40-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .hp40-marquee__content {
    display: inline-flex;
    align-items: center;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .hp40-marquee__item {
    display: inline-flex;
    align-items: center;
    padding: 0 40px;
    font-family: var(--font-heading);
    font-size: clamp(30px, 6vw, {{ section.settings.text_size }}px);
    font-weight: 900;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: -2px;
  }
  
  /* Alternate styles for every even item */
  .hp40-marquee__item:nth-child(even) {
    -webkit-text-stroke: 2px var(--text-color);
    color: transparent;
  }

  .hp40-marquee__separator {
    display: inline-block;
    width: 20px;
    height: 20px;
    background: var(--text-color);
    margin: 0 40px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp40-marquee-wrapper" id="HP40Marquee-{{ section.id }}">
  <div class="hp40-marquee__track">
    <ul class="hp40-marquee__content">
      {%- for block in section.blocks -%}
        <li class="hp40-marquee__item" {{ block.shopify_attributes }}>
          {{ block.settings.text }}
          <span class="hp40-marquee__separator"></span>
        </li>
      {%- endfor -%}
      {%- for block in section.blocks -%}
        <li class="hp40-marquee__item" aria-hidden="true">
          {{ block.settings.text }}
          <span class="hp40-marquee__separator"></span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "HP40 - Swiss Marquee",
  "class": "section-hp40-marquee",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll Speed",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Text Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Swiss Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F4F4F4"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Marquee Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "SYSTEMATIC"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP40 - Swiss Marquee",
      "blocks": [
        { "type": "text_block", "settings": { "text": "CLARITY" } },
        { "type": "text_block", "settings": { "text": "ORDER" } },
        { "type": "text_block", "settings": { "text": "FUNCTION" } }
      ]
    }
  ]
}
{% endschema %}
