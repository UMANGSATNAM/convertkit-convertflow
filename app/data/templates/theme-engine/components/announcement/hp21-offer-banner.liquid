{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --overlay-color: {{ section.settings.overlay_color }};
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Jost', sans-serif;
    
    background-color: var(--bg-color);
    position: relative;
    overflow: hidden;
  }

  .hp21-offer-wrapper {
    min-height: {{ section.settings.desktop_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
    position: relative;
  }

  @media screen and (max-width: 768px) {
    .hp21-offer-wrapper {
      min-height: {{ section.settings.mobile_height }}px;
      padding: {{ section.settings.padding_top | times: 0.75 | round }}px 20px {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp21-offer__bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 1;
  }

  .hp21-offer__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: {% if section.settings.bg_blur %}blur(5px){% else %}none{% endif %};
    transform: {% if section.settings.bg_blur %}scale(1.05){% else %}none{% endif %};
  }
  
  .hp21-offer__bg::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: var(--overlay-color);
    opacity: var(--overlay-opacity);
  }

  .hp21-offer__content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(0,0,0,0.3);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 60px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  @media screen and (max-width: 768px) {
    .hp21-offer__content {
      padding: 40px 20px;
      width: 100%;
    }
  }

  .hp21-offer__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 300;
    letter-spacing: 4px;
    color: var(--accent-color);
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .hp21-offer__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0 0 24px;
    line-height: 1.1;
  }
  
  .hp21-offer__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp21-offer__text {
    font-family: var(--font-body);
    font-size: {{ section.settings.text_size }}px;
    font-weight: 300;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0 0 40px;
    line-height: 1.6;
    max-width: 600px;
  }

  .hp21-offer__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 48px;
    background: transparent;
    color: var(--text-color);
    border: 1px solid var(--accent-color);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-decoration: none;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
  }

  .hp21-offer__btn::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: var(--accent-color);
    transform: translateY(100%);
    transition: transform 0.4s ease;
    z-index: -1;
  }

  .hp21-offer__btn:hover {
    color: #000;
    border-color: var(--accent-color);
  }
  
  .hp21-offer__btn:hover::before {
    transform: translateY(0);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp21-offer-wrapper" id="HP21Offer-{{ section.id }}">
  
  <div class="hp21-offer__bg">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.title | escape }}" loading="lazy">
    {%- else -%}
      <div style="width:100%;height:100%;background:#111;"></div>
    {%- endif -%}
  </div>

  <div class="hp21-offer__content">
    {%- if section.settings.subtitle != blank -%}
      <p class="hp21-offer__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
    
    {%- if section.settings.title != blank -%}
      <h2 class="hp21-offer__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    
    {%- if section.settings.text != blank -%}
      <p class="hp21-offer__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.btn_text != blank and section.settings.btn_link != blank -%}
      <a href="{{ section.settings.btn_link }}" class="hp21-offer__btn">
        {{ section.settings.btn_text | escape }}
      </a>
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "HP21 - Luxury Offer",
  "class": "section-hp21-offer-banner",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "checkbox",
      "id": "bg_blur",
      "label": "Apply Cinematic Blur",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "LIMITED TIME PRIVILEGE"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>A Gift of <em>Elegance</em></p>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Enjoy complimentary expedited shipping and a signature gift wrap on all orders above $500."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "UNLOCK OFFER"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Min Height (Desktop)",
      "default": 500
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 300,
      "max": 600,
      "step": 50,
      "unit": "px",
      "label": "Min Height (Mobile)",
      "default": 450
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 56
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Luxury Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fallback Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 60
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D4AF37"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP21 - Luxury Offer"
    }
  ]
}
{% endschema %}
