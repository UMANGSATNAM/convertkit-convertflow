{%- style -%}
  #shopify-section-{{ section.id }} {
    background: radial-gradient(circle at 20% 50%, #881337 0%, #1C1917 100%);
    color: #FFFFFF;
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    border-top: 1px solid rgba(217, 119, 6, 0.3);
    border-bottom: 1px solid rgba(217, 119, 6, 0.3);
  }
  .hp63-offer__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .hp63-offer__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #F59E0B; margin: 0 0 16px; }
  .hp63-offer__heading { font-family: 'Playfair Display', serif; font-size: clamp(28px, 4vw, 48px); font-weight: 700; color: #FFFFFF; margin: 0 0 18px; line-height: 1.1; }
  .hp63-offer__desc { font-size: 15px; line-height: 1.7; color: #E7E5E4; margin: 0 0 30px; }
  .hp63-offer__btn {
    display: inline-flex; align-items: center; gap: 10px; padding: 16px 36px;
    background: #D97706; color: #FFFFFF; font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    text-decoration: none; border-radius: 4px;
    box-shadow: 0 8px 30px rgba(217, 119, 6, 0.35); transition: all 0.3s ease;
  }
  .hp63-offer__btn:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(217, 119, 6, 0.55); }
  .hp63-offer__img-wrap { border-radius: 8px; overflow: hidden; height: 400px; border: 1px solid rgba(217, 119, 6, 0.35); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5); }
  .hp63-offer__img { width: 100%; height: 100%; object-fit: cover; }
  @media screen and (max-width: 992px) { .hp63-offer__container { grid-template-columns: 1fr; text-align: center; } .hp63-offer__img-wrap { height: 300px; } }
{%- endstyle -%}
<div class="hp63-offer__container">
  <div>
    <p class="hp63-offer__eyebrow">{{ section.settings.eyebrow | default: '🌹 SOUK HAMMAM RITUAL' }}</p>
    <h2 class="hp63-offer__heading">{{ section.settings.heading | default: 'The Royal Rose & Amber Set' }}</h2>
    <p class="hp63-offer__desc">{{ section.settings.description | default: 'Includes our Dades Valley Damask Rose Hydrosol, Spiced Amber Regenerating Night Nectar, and Gold Flake Desert Argan Oil.' }}</p>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp63-offer__btn">{{ section.settings.btn_label | default: 'Claim Royal Rose Set' }} &rarr;</a>
  </div>
  <div class="hp63-offer__img-wrap">
    {%- if section.settings.image != blank -%}<img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" class="hp63-offer__img" alt="{{ section.settings.heading }}" loading="lazy">
    {%- else -%}{{ 'product-1' | placeholder_svg_tag: 'hp63-offer__img' }}{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "HP63 Offer",
  "class": "section-hp63-offer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌹 SOUK HAMMAM RITUAL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Royal Rose & Amber Set" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Includes our Dades Valley Damask Rose Hydrosol." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Claim Royal Rose Set" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP63 Offer" }]
}
{% endschema %}
