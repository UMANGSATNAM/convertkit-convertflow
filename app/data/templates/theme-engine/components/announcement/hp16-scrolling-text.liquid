{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFF00'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 30px 0;
    overflow: hidden;
    border-bottom: 4px solid #000;
  }
  
  .hp16-scroll-container-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
  }
  
  .hp16-scroll-content-{{ section_id }} {
    display: inline-block;
    padding-left: 100%;
    animation: hp16-scroll-{{ section_id }} 15s linear infinite;
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: 3rem;
    font-weight: bold;
    text-transform: uppercase;
    color: {{ text_color }};
    -webkit-text-stroke: 1px #000;
    text-shadow: 3px 3px 0 #FF00FF;
  }
  
  .hp16-scroll-content-{{ section_id }} span {
    margin: 0 40px;
    color: #00FFFF;
  }
  
  @keyframes hp16-scroll-{{ section_id }} {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-100%, 0); }
  }
  
  @media (max-width: 768px) {
    .hp16-scroll-content-{{ section_id }} {
      font-size: 2rem;
    }
  }
</style>

<div class="hp16-scroll-container-{{ section_id }}">
  <div class="hp16-scroll-content-{{ section_id }}">
    {% for i in (1..6) %}
      {{ section.settings.text | default: 'TOTALLY OBSESSED' }}
      <span>❤</span>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP16 Scrolling Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFF00"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "TOTALLY OBSESSED"
    }
  ],
  "presets": [
    {
      "name": "HP16 Scrolling Text"
    }
  ]
}
{% endschema %}
