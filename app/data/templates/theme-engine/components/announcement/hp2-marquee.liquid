{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
  assign text_stroke_color = section.settings.text_stroke_color | default: '#000000'
  
  assign is_transparent = section.settings.is_transparent
  assign speed = section.settings.animation_speed | default: 20
  assign direction = section.settings.animation_direction
  
  assign font_size_desktop = section.settings.font_size_desktop
  assign font_size_mobile = section.settings.font_size_mobile
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp2-mq-bg: {{ bg_color }};
    --hp2-mq-text: {{ text_color }};
    --hp2-mq-stroke: {{ text_stroke_color }};
    --hp2-mq-speed: {{ speed }}s;
    
    --hp2-mq-font-desk: {{ font_size_desktop }}px;
    --hp2-mq-font-mob: {{ font_size_mobile }}px;
    
    --hp2-mq-pt-desk: {{ padding_top_desktop }}px;
    --hp2-mq-pb-desk: {{ padding_bottom_desktop }}px;
    --hp2-mq-pt-mob: {{ padding_top_mobile }}px;
    --hp2-mq-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp2-fashion-marquee-{{ section.id }} {
    padding-top: var(--hp2-mq-pt-desk);
    padding-bottom: var(--hp2-mq-pb-desk);
    background-color: var(--hp2-mq-bg);
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .hp2-mq-wrapper {
    display: flex;
    width: 100%;
    overflow: hidden;
    position: relative;
    user-select: none;
  }

  .hp2-mq-track {
    display: flex;
    white-space: nowrap;
    will-change: transform;
    {% if direction == 'left' %}
      animation: hp2MarqueeLeft var(--hp2-mq-speed) linear infinite;
    {% else %}
      animation: hp2MarqueeRight var(--hp2-mq-speed) linear infinite;
    {% endif %}
  }

  /* Core text styling */
  .hp2-mq-text {
    display: inline-block;
    padding-right: 50px; /* Gap between repeats */
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: var(--hp2-mq-font-desk);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: -2px;
    white-space: nowrap;
    
    {% if is_transparent %}
      /* Outline text effect */
      color: transparent;
      -webkit-text-stroke: 2px var(--hp2-mq-stroke);
      text-stroke: 2px var(--hp2-mq-stroke);
    {% else %}
      /* Solid text */
      color: var(--hp2-mq-text);
    {% endif %}
  }
  
  /* Optional hover effect on desktop */
  {% if is_transparent and section.settings.hover_fill %}
    .hp2-fashion-marquee-{{ section.id }}:hover .hp2-mq-text {
      color: var(--hp2-mq-text);
      -webkit-text-stroke: 0px transparent;
      transition: all 0.3s ease;
    }
    .hp2-mq-text { transition: all 0.3s ease; }
  {% endif %}

  @keyframes hp2MarqueeLeft {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  @keyframes hp2MarqueeRight {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(0); }
  }

  /* Responsive Adjustments */
  @media screen and (max-width: 768px) {
    .hp2-fashion-marquee-{{ section.id }} {
      padding-top: var(--hp2-mq-pt-mob);
      padding-bottom: var(--hp2-mq-pb-mob);
    }
    .hp2-mq-text {
      font-size: var(--hp2-mq-font-mob);
      padding-right: 30px;
      -webkit-text-stroke-width: 1px;
    }
  }

  /* Accessibility respect */
  @media (prefers-reduced-motion: reduce) {
    .hp2-mq-track {
      animation: none !important;
      transform: none !important;
    }
    .hp2-mq-wrapper {
      overflow-x: auto;
    }
  }
</style>

<section class="hp2-fashion-marquee-{{ section.id }}" aria-hidden="true">
  {%- comment -%} 
    Aria-hidden true because marquee text is purely decorative/branding. 
    If it contains important info (like 'Sale 50% Off'), it should not be hidden.
  {%- endcomment -%}
  <div class="hp2-mq-wrapper">
    
    {%- capture marquee_content -%}
      {%- if section.settings.text != blank -%}
        <span class="hp2-mq-text">{{ section.settings.text }}</span>
      {%- else -%}
        <span class="hp2-mq-text">HYPEWEAR COLLECTION FW26</span>
      {%- endif -%}
    {%- endcapture -%}

    {%- comment -%} Duplicate content to ensure smooth endless scroll {%- endcomment -%}
    <div class="hp2-mq-track">
      {{ marquee_content }}
      {{ marquee_content }}
      {{ marquee_content }}
      {{ marquee_content }}
      {{ marquee_content }}
      {{ marquee_content }}
      {{ marquee_content }}
      {{ marquee_content }}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP2 Oversized Marquee",
  "tag": "section",
  "class": "section-hp2-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Marquee Text",
      "default": "FW26 COLLECTION // NEW ARRIVALS // "
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "checkbox",
      "id": "is_transparent",
      "label": "Use Outline/Transparent Text Effect",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hover_fill",
      "label": "Fill outline on hover",
      "default": true,
      "info": "Only works if transparent text is enabled."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Solid Text / Hover Fill Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_stroke_color",
      "label": "Outline Stroke Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Typography Options"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "min": 40,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Font Size",
      "default": 140
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile Font Size",
      "default": 70
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "sec",
      "label": "Scroll Speed",
      "info": "Lower is faster.",
      "default": 20
    },
    {
      "type": "select",
      "id": "animation_direction",
      "label": "Scroll Direction",
      "options": [
        { "value": "left", "label": "Right to Left" },
        { "value": "right", "label": "Left to Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 40
    }
  ],
  "presets": [
    {
      "name": "HP2 Oversized Marquee (Advanced)",
      "category": "Text"
    }
  ]
}
{% endschema %}
