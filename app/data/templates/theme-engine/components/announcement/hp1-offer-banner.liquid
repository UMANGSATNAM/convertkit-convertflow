{%- liquid
  assign bg_color = section.settings.bg_color | default: '#e8e0d5'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
-%}

<section class="hp1-beauty-offer" style="background-color: {{ bg_color }}; color: {{ text_color }};" id="hp1-offer-{{ section.id }}">
  <div class="hp1-offer-inner">
    {%- if section.settings.image != blank -%}
      <div class="hp1-offer-bg">
        <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="" class="hp1-offer-img" loading="lazy">
        <div class="hp1-offer-overlay"></div>
      </div>
    {%- endif -%}

    <div class="hp1-offer-content">
      <div class="hp1-offer-box">
        {%- if section.settings.subheading != blank -%}
          <span class="hp1-offer-subheading">{{ section.settings.subheading }}</span>
        {%- endif -%}
        
        {%- if section.settings.heading != blank -%}
          <h2 class="hp1-offer-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.code != blank -%}
          <div class="hp1-offer-code-box">
            <span class="hp1-offer-code-label">Use Code:</span>
            <strong class="hp1-offer-code">{{ section.settings.code }}</strong>
          </div>
        {%- endif -%}
        
        {%- if section.settings.btn_label != blank and section.settings.btn_link != blank -%}
          <a href="{{ section.settings.btn_link }}" class="hp1-offer-btn">
            {{ section.settings.btn_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .hp1-beauty-offer {
    position: relative;
    padding: 100px 20px;
    font-family: 'Inter', sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .hp1-offer-inner {
    position: relative;
    z-index: 3;
    max-width: 800px;
    width: 100%;
    text-align: center;
  }
  .hp1-offer-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 1;
  }
  .hp1-offer-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hp1-offer-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(5px);
  }
  .hp1-offer-content {
    position: relative;
    z-index: 3;
  }
  .hp1-offer-box {
    background: rgba(255, 255, 255, 0.9);
    padding: 60px 40px;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.05);
    display: inline-block;
    max-width: 600px;
    width: 100%;
  }
  .hp1-offer-subheading {
    display: block;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8a7a6c;
    margin-bottom: 15px;
  }
  .hp1-offer-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400;
    margin: 0 0 30px;
    line-height: 1.2;
  }
  .hp1-offer-code-box {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px dashed {{ text_color }};
    padding: 10px 20px;
    border-radius: 4px;
    margin-bottom: 30px;
  }
  .hp1-offer-code-label {
    font-size: 14px;
  }
  .hp1-offer-code {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 1px;
  }
  .hp1-offer-btn {
    display: inline-block;
    padding: 14px 40px;
    background: {{ text_color }};
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 13px;
    border-radius: 30px;
    transition: all 0.3s ease;
    width: 100%;
    max-width: 300px;
  }
  .hp1-offer-btn:hover {
    background: #8a7a6c;
    transform: translateY(-2px);
  }

  @media (max-width: 767px) {
    .hp1-beauty-offer { padding: 60px 15px; }
    .hp1-offer-box { padding: 40px 20px; }
  }
</style>

{% schema %}
{
  "name": "HP1 Offer Banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Limited Time Offer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 20% Off Your First Order"
    },
    {
      "type": "text",
      "id": "code",
      "label": "Discount Code",
      "default": "GLOW20"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fallback Background",
      "default": "#e8e0d5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    }
  ],
  "presets": [
    {
      "name": "HP1 Offer Banner"
    }
  ]
}
{% endschema %}
