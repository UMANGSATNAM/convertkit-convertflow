<div class="banner-countdown w-full bg-[var(--color-text)] text-[var(--color-primary-text, #fff)] py-12 px-6">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8">
    
    <div class="text-center md:text-left">
      <h2 class="text-3xl md:text-4xl font-bold mb-2 uppercase tracking-wide">{{ section.settings.title }}</h2>
      <p class="text-lg opacity-80">{{ section.settings.text }}</p>
    </div>

    <!-- Countdown Timer -->
    <div class="flex items-center gap-4 text-center" id="countdown-{{ section.id }}" data-date="{{ section.settings.end_date }}">
      <div class="flex flex-col bg-[var(--color-background)]/10 rounded-lg p-3 min-w-[70px]">
        <span class="days text-3xl font-black">00</span>
        <span class="text-xs uppercase opacity-70">Days</span>
      </div>
      <div class="text-2xl font-bold opacity-50">:</div>
      <div class="flex flex-col bg-[var(--color-background)]/10 rounded-lg p-3 min-w-[70px]">
        <span class="hours text-3xl font-black">00</span>
        <span class="text-xs uppercase opacity-70">Hrs</span>
      </div>
      <div class="text-2xl font-bold opacity-50">:</div>
      <div class="flex flex-col bg-[var(--color-background)]/10 rounded-lg p-3 min-w-[70px]">
        <span class="minutes text-3xl font-black">00</span>
        <span class="text-xs uppercase opacity-70">Min</span>
      </div>
      <div class="text-2xl font-bold opacity-50">:</div>
      <div class="flex flex-col bg-[var(--color-accent, #ff0000)] rounded-lg p-3 min-w-[70px]">
        <span class="seconds text-3xl font-black">00</span>
        <span class="text-xs uppercase opacity-90">Sec</span>
      </div>
    </div>

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="px-8 py-4 bg-[var(--color-background)] text-[var(--color-text)] font-bold uppercase rounded hover:bg-neutral-200 transition-colors whitespace-nowrap">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}

  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const timerEl = document.getElementById('countdown-{{ section.id }}');
  if (!timerEl) return;

  // Expected format: YYYY-MM-DD
  const targetDateStr = timerEl.dataset.date;
  if (!targetDateStr) return;

  const targetDate = new Date(targetDateStr).getTime();

  const updateTimer = () => {
    const now = new Date().getTime();
    const distance = targetDate - now;

    if (distance < 0) {
      timerEl.innerHTML = '<span class="text-2xl font-bold">Offer Expired</span>';
      return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    timerEl.querySelector('.days').innerText = String(days).padStart(2, '0');
    timerEl.querySelector('.hours').innerText = String(hours).padStart(2, '0');
    timerEl.querySelector('.minutes').innerText = String(minutes).padStart(2, '0');
    timerEl.querySelector('.seconds').innerText = String(seconds).padStart(2, '0');
  };

  updateTimer();
  setInterval(updateTimer, 1000);
});
</script>

{% schema %}
{
  "name": "Countdown Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Flash Sale Ends Soon!"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subtext",
      "default": "Get 50% off everything before the timer runs out."
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End Date (YYYY-MM-DD)",
      "default": "2025-12-31",
      "info": "Format must be exactly YYYY-MM-DD"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Claim Offer"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Countdown Banner"
    }
  ]
}
{% endschema %}
