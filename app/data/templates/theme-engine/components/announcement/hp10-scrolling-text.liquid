{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#2A3B2C'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 0;
    overflow: hidden;
  }
  
  .hp10-st-container-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
  }
  
  .hp10-st-content-{{ section_id }} {
    display: flex;
    animation: hp10-st-scroll-{{ section_id }} 30s linear infinite;
  }
  
  .hp10-st-item-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 400;
    color: {{ text_color }};
    padding: 0 40px;
    display: inline-block;
  }
  
  .hp10-st-item-{{ section_id }} span {
    color: transparent;
    -webkit-text-stroke: 1px {{ text_color }};
  }

  @keyframes hp10-st-scroll-{{ section_id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

<div class="hp10-st-container-{{ section_id }}">
  <div class="hp10-st-content-{{ section_id }}">
    <!-- First set -->
    {% for i in (1..3) %}
      <div class="hp10-st-item-{{ section_id }}">
        NATURAL <span>BEAUTY</span> UNLEASHED
      </div>
    {% endfor %}
    <!-- Duplicate -->
    {% for i in (1..3) %}
      <div class="hp10-st-item-{{ section_id }}">
        NATURAL <span>BEAUTY</span> UNLEASHED
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP10 Scrolling Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2A3B2C"
    }
  ],
  "presets": [
    {
      "name": "HP10 Scrolling Text"
    }
  ]
}
{% endschema %}
