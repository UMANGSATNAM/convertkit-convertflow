<div class="announcement-bar-v2" style="background-color: {{ section.settings.bg_color | default: 'var(--primary)' }}; color: {{ section.settings.text_color | default: '#ffffff' }};">
  <div class="page-width">
    <div class="announcement-inner">
      <div class="announcement-offer">
        {{ section.settings.text | default: 'Free shipping on all orders over ₹999' }}
      </div>
      <div class="announcement-contact">
        {{ section.settings.contact_text | default: '24/7 Support | 1800-123-456' }}
      </div>
    </div>
  </div>
</div>

<style>
.announcement-bar-v2 {
  padding: var(--space-8) 0;
  font-family: var(--font-family);
  font-size: var(--text-12);
  font-weight: 500;
  letter-spacing: 0.5px;
}
.announcement-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.announcement-offer, .announcement-contact {
  display: flex;
  align-items: center;
  gap: var(--space-8);
}
@media (max-width: 749px) {
  .announcement-inner {
    justify-content: center;
    text-align: center;
  }
  .announcement-contact {
    display: none;
  }
}
</style>

{% schema %}
{
  "name": "Announcement Bar Commerce",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Offer Text"
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Contact Text"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    }
  ]
}
{% endschema %}
