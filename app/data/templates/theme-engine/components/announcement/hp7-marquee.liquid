{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#e8ecd6'
  assign text_color = section.settings.text_color | default: '#4a6741'
  assign speed = section.settings.speed | default: 30
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: 30px 0;
    overflow: hidden;
    position: relative;
    border-top: 1px solid rgba(74, 103, 65, 0.1);
    border-bottom: 1px solid rgba(74, 103, 65, 0.1);
  }
  
  .hp7-marquee-wrapper-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    position: relative;
  }
  
  .hp7-marquee-track-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: 60px;
    padding-right: 60px;
    animation: hp7BigMarquee {{ speed }}s linear infinite;
  }
  
  .hp7-marquee-text-{{ section_id }} {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    font-style: italic;
    letter-spacing: 1px;
    opacity: 0.9;
  }
  
  .hp7-marquee-separator-{{ section_id }} {
    width: 12px;
    height: 12px;
    background-color: {{ text_color }};
    border-radius: 50%;
    opacity: 0.5;
  }
  
  @keyframes hp7BigMarquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }
</style>

<div class="hp7-marquee-wrapper-{{ section_id }}">
  {%- for i in (1..3) -%}
    <div class="hp7-marquee-track-{{ section_id }}" aria-hidden="{% if forloop.index > 1 %}true{% else %}false{% endif %}">
      {%- for block in section.blocks -%}
        <div class="hp7-marquee-text-{{ section_id }}" {{ block.shopify_attributes }}>
          {{ block.settings.text }}
        </div>
        <div class="hp7-marquee-separator-{{ section_id }}"></div>
      {%- endfor -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP7 Soft Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#e8ecd6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4a6741"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Animation Speed",
      "min": 10,
      "max": 60,
      "step": 1,
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Carefully Crafted"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP7 Soft Marquee",
      "blocks": [
        { "type": "text", "settings": { "text": "Carefully Crafted" } },
        { "type": "text", "settings": { "text": "Responsibly Sourced" } },
        { "type": "text", "settings": { "text": "Designed for Longevity" } },
        { "type": "text", "settings": { "text": "Earth Conscious" } }
      ]
    }
  ]
}
{% endschema %}
