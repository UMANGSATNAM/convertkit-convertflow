{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: #000000;
    --border-color: #000000;
    
    --font-body: 'Space Mono', monospace;
    
    background-color: var(--bg-color);
    border-bottom: 4px solid var(--border-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  .hp32-marquee-wrapper {
    width: 100%;
    display: flex;
    overflow: hidden;
    position: relative;
    user-select: none;
    padding: 10px 0;
    border-top: 2px dashed var(--border-color);
    border-bottom: 2px dashed var(--border-color);
  }

  .hp32-marquee__content {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 40px;
    min-width: 100%;
    animation: hp32-scroll {{ section.settings.scroll_speed }}s linear infinite;
  }

  .hp32-marquee__item {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .hp32-marquee__text {
    font-family: var(--font-body);
    font-size: clamp(24px, 4vw, {{ section.settings.text_size }}px);
    font-weight: 700;
    color: var(--text-color);
    text-transform: uppercase;
    white-space: nowrap;
    margin: 0;
    letter-spacing: -1px;
  }

  .hp32-marquee__icon {
    width: clamp(24px, 4vw, {{ section.settings.text_size }}px);
    height: clamp(24px, 4vw, {{ section.settings.text_size }}px);
    color: var(--text-color);
    flex-shrink: 0;
  }

  /* Duplicate for seamless scrolling */
  .hp32-marquee__content--dup {
    /* handeled by html duplication */
  }

  @keyframes hp32-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  /* Reverse direction */
  .hp32-marquee-wrapper--reverse .hp32-marquee__content {
    animation-direction: reverse;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp32-marquee-wrapper {% if section.settings.reverse %}hp32-marquee-wrapper--reverse{% endif %}" id="HP32Marquee-{{ section.id }}">
  <div class="hp32-marquee__content">
    {%- for i in (1..4) -%}
      {%- for block in section.blocks -%}
        <div class="hp32-marquee__item">
          <span class="hp32-marquee__text">{{ block.settings.text }}</span>
          {%- if block.settings.show_icon -%}
            <svg class="hp32-marquee__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square">
              <path d="M12 2L22 12L12 22L2 12L12 2Z"/>
            </svg>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
  <div class="hp32-marquee__content" aria-hidden="true">
    {%- for i in (1..4) -%}
      {%- for block in section.blocks -%}
        <div class="hp32-marquee__item">
          <span class="hp32-marquee__text">{{ block.settings.text }}</span>
          {%- if block.settings.show_icon -%}
            <svg class="hp32-marquee__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square">
              <path d="M12 2L22 12L12 22L2 12L12 2Z"/>
            </svg>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP32 - Brutalist Marquee",
  "class": "section-hp32-marquee",
  "settings": [
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll Speed",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Reverse Direction",
      "default": false
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Text Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Hot Pink)",
      "default": "#ff00ff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "SYSTEM OVERRIDE"
        },
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "Show Icon Separator",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP32 - Brutalist Marquee",
      "blocks": [
        { "type": "text_block", "settings": { "text": "NO COMPROMISES" } },
        { "type": "text_block", "settings": { "text": "MAX PERFORMANCE" } },
        { "type": "text_block", "settings": { "text": "FREE SHIPPING > $100" } }
      ]
    }
  ]
}
{% endschema %}
