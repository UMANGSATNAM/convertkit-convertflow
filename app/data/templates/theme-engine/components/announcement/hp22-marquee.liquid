{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Lora', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    position: relative;
    border-top: 1px solid rgba(0,0,0,0.05);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Organic grain texture overlay */
  {% if section.settings.show_grain %}
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0.04;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
  {% endif %}

  .hp22-marquee-container {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
    position: relative;
    z-index: 2;
  }

  .hp22-marquee-track {
    display: flex;
    align-items: center;
    gap: {{ section.settings.item_gap }}px;
    animation: hp22Marquee {{ section.settings.speed }}s linear infinite;
  }
  
  {%- if section.settings.direction == 'right' -%}
  .hp22-marquee-track {
    animation-direction: reverse;
  }
  {%- endif -%}

  /* Pause on hover if setting enabled */
  {%- if section.settings.pause_on_hover -%}
  .hp22-marquee-container:hover .hp22-marquee-track {
    animation-play-state: paused;
  }
  {%- endif -%}

  .hp22-marquee-item {
    display: flex;
    align-items: center;
    gap: {{ section.settings.item_gap }}px;
  }

  .hp22-marquee-text {
    font-family: {% if section.settings.use_serif %}var(--font-heading){% else %}var(--font-body){% endif %};
    font-size: {{ section.settings.text_size }}px;
    font-weight: {% if section.settings.use_serif %}400{% else %}300{% endif %};
    color: var(--text-color);
    letter-spacing: {% if section.settings.use_serif %}1px{% else %}3px{% endif %};
    text-transform: {% if section.settings.use_serif %}none{% else %}uppercase{% endif %};
    {% if section.settings.use_italic %}font-style: italic;{% endif %}
  }

  .hp22-marquee-separator {
    color: var(--accent-color);
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.separator_size }}px;
    height: {{ section.settings.separator_size }}px;
  }

  .hp22-marquee-separator svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
    opacity: 0.7;
  }

  @keyframes hp22Marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp22-marquee-wrapper" id="HP22Marquee-{{ section.id }}">
  <div class="hp22-marquee-container">
    <div class="hp22-marquee-track">
      
      {%- capture separator_svg -%}
        {%- if section.settings.separator_style == 'leaf' -%}
          <svg viewBox="0 0 24 24"><path d="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 7,14 7,14C18,14 17,8 17,8Z"/></svg>
        {%- elsif section.settings.separator_style == 'flower' -%}
          <svg viewBox="0 0 24 24"><path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,19.5C7.86,19.5 4.5,16.14 4.5,12C4.5,7.86 7.86,4.5 12,4.5C16.14,4.5 19.5,7.86 19.5,12C19.5,16.14 16.14,19.5 12,19.5M12,7.5A4.5,4.5 0 0,0 7.5,12A4.5,4.5 0 0,0 12,16.5A4.5,4.5 0 0,0 16.5,12A4.5,4.5 0 0,0 12,7.5Z"/></svg>
        {%- elsif section.settings.separator_style == 'circle' -%}
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/></svg>
        {%- else -%}
          <svg viewBox="0 0 24 24"><path d="M12,2L14.8,9.2L22,12L14.8,14.8L12,22L9.2,14.8L2,12L9.2,9.2L12,2Z"/></svg>
        {%- endif -%}
      {%- endcapture -%}

      {%- for i in (1..10) -%}
        {%- for block in section.blocks -%}
          <div class="hp22-marquee-item">
            <span class="hp22-marquee-text">{{ block.settings.text | escape }}</span>
            <span class="hp22-marquee-separator">{{ separator_svg }}</span>
          </div>
        {%- endfor -%}
      {%- endfor -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP22 - Organic Marquee",
  "class": "section-hp22-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Marquee Settings"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Animation Speed",
      "info": "Lower is faster",
      "default": 30
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll Direction",
      "options": [
        { "value": "left", "label": "Right to Left" },
        { "value": "right", "label": "Left to Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap Between Items",
      "default": 40
    },
    {
      "type": "select",
      "id": "separator_style",
      "label": "Separator Icon",
      "options": [
        { "value": "leaf", "label": "Botanical Leaf" },
        { "value": "flower", "label": "Abstract Flower" },
        { "value": "circle", "label": "Solid Circle" },
        { "value": "star", "label": "Four-Point Star" },
        { "value": "none", "label": "None" }
      ],
      "default": "leaf"
    },
    {
      "type": "range",
      "id": "separator_size",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Separator Icon Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Text Size",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "use_serif",
      "label": "Use Serif Font (Lora)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "use_italic",
      "label": "Italicize Text",
      "default": true
    },
    {
      "type": "header",
      "content": "Organic Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3A3A3A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Separator Color",
      "default": "#8A9A86"
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Show subtle paper grain texture",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 30
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "100% Organic Ingredients"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP22 - Organic Marquee",
      "blocks": [
        { "type": "text", "settings": { "text": "Cruelty-Free & Vegan" } },
        { "type": "text", "settings": { "text": "Sustainable Packaging" } },
        { "type": "text", "settings": { "text": "Ethically Sourced" } }
      ]
    }
  ]
}
{% endschema %}
