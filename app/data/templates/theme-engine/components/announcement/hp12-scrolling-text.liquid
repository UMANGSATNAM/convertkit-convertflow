{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAFAFA'
  assign text_color = section.settings.text_color | default: '#333333'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 0;
    overflow: hidden;
    border-bottom: 1px solid #E5E5E5;
  }
  
  .hp12-scrolling-text-container-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
  }
  
  .hp12-scrolling-text-content-{{ section_id }} {
    display: flex;
    animation: hp12-scroll-text-{{ section_id }} 40s linear infinite;
  }
  
  .hp12-scrolling-text-item-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    color: {{ text_color }};
    text-transform: uppercase;
    letter-spacing: 4px;
    padding: 0 40px;
    line-height: 1;
    display: flex;
    align-items: center;
    opacity: 0.6;
  }
  
  .hp12-scrolling-text-item-{{ section_id }} span {
    font-size: 1rem;
    margin: 0 40px;
    opacity: 0.5;
  }

  @keyframes hp12-scroll-text-{{ section_id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

<div class="hp12-scrolling-text-container-{{ section_id }}">
  <div class="hp12-scrolling-text-content-{{ section_id }}">
    {% for i in (1..6) %}
      <div class="hp12-scrolling-text-item-{{ section_id }}">
        {{ section.settings.text | default: 'Quietly Crafted' }} <span>—</span>
      </div>
    {% endfor %}
    {% for i in (1..6) %}
      <div class="hp12-scrolling-text-item-{{ section_id }}">
        {{ section.settings.text | default: 'Quietly Crafted' }} <span>—</span>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP12 Scrolling Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Quietly Crafted"
    }
  ],
  "presets": [
    {
      "name": "HP12 Scrolling Text"
    }
  ]
}
{% endschema %}
