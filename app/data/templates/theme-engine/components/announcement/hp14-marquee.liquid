{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ddbea9'
  assign text_color = section.settings.text_color | default: '#ffffff'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 20px 0;
    overflow: hidden;
  }
  
  .hp14-marquee-container-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
  }
  
  .hp14-marquee-content-{{ section_id }} {
    display: flex;
    animation: hp14-scroll-{{ section_id }} 20s linear infinite;
  }
  
  .hp14-marquee-item-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: 1.5rem;
    font-style: italic;
    color: {{ text_color }};
    padding: 0 40px;
    display: flex;
    align-items: center;
  }
  
  .hp14-marquee-item-{{ section_id }} span {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: {{ text_color }};
    border-radius: 50%;
    margin: 0 40px;
    opacity: 0.5;
  }

  @keyframes hp14-scroll-{{ section_id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

@media screen and (max-width: 768px) {
  .hp14-marquee {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}

</style>

<div class="hp14-marquee-container-{{ section_id }}">
  <div class="hp14-marquee-content-{{ section_id }}">
    {% for i in (1..5) %}
      <div class="hp14-marquee-item-{{ section_id }}">
        {{ section.settings.text | default: '100% Cruelty Free & Vegan' }} <span></span>
      </div>
    {% endfor %}
    {% for i in (1..5) %}
      <div class="hp14-marquee-item-{{ section_id }}">
        {{ section.settings.text | default: '100% Cruelty Free & Vegan' }} <span></span>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP14 Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ddbea9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "100% Cruelty Free & Vegan"
    }
  ],
  "presets": [
    {
      "name": "HP14 Marquee"
    }
  ]
}
{% endschema %}
