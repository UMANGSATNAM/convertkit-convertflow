{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 20px 0;
    overflow: hidden;
  }
  
  .hp15-marquee-container-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
  }
  
  .hp15-marquee-content-{{ section_id }} {
    display: inline-block;
    padding-left: 100%;
    animation: hp15-marquee-{{ section_id }} 20s linear infinite;
    font-family: 'Didot', 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: {{ text_color }};
  }
  
  .hp15-marquee-content-{{ section_id }} span {
    margin: 0 40px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1rem;
    vertical-align: middle;
  }
  
  @keyframes hp15-marquee-{{ section_id }} {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-100%, 0); }
  }

@media screen and (max-width: 768px) {
  .hp15-marquee {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}

</style>

<div class="hp15-marquee-container-{{ section_id }}">
  <div class="hp15-marquee-content-{{ section_id }}">
    {% for i in (1..6) %}
      {{ section.settings.text | default: 'ELEVATE YOUR WARDROBE' }}
      <span>+</span>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP15 Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "ELEVATE YOUR WARDROBE"
    }
  ],
  "presets": [
    {
      "name": "HP15 Marquee"
    }
  ]
}
{% endschema %}
