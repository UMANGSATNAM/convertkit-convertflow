{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign link = section.settings.link
  assign text = section.settings.text | default: 'COMPLIMENTARY EXPRESS SHIPPING ON ALL ORDERS'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: 10px 0;
    position: relative;
    z-index: 100;
    text-align: center;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
  }
  
  .hp8-announcement-container-{{ section_id }} {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .hp8-announcement-content-{{ section_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
  }
  
  .hp8-announcement-text-{{ section_id }} {
    margin: 0;
  }
  
  .hp8-announcement-link-{{ section_id }} {
    color: {{ text_color }};
    text-decoration: none;
    position: relative;
    display: inline-block;
  }
  
  .hp8-announcement-link-{{ section_id }}::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: {{ text_color }};
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }
  
  .hp8-announcement-link-{{ section_id }}:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      font-size: 0.65rem;
      padding: 8px 0;
    }
  }
</style>

<div class="hp8-announcement-container-{{ section_id }}">
  <div class="hp8-announcement-content-{{ section_id }}">
    {% if link != blank %}
      <a href="{{ link }}" class="hp8-announcement-link-{{ section_id }}">
        <p class="hp8-announcement-text-{{ section_id }}">{{ text }}</p>
      </a>
    {% else %}
      <p class="hp8-announcement-text-{{ section_id }}">{{ text }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP8 Announcement Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "COMPLIMENTARY EXPRESS SHIPPING ON ALL ORDERS"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "HP8 Announcement Bar"
    }
  ]
}
{% endschema %}
