{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Shrikhand&family=DM+Sans:wght@400;500;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Shrikhand', cursive;
    --font-body: 'DM Sans', sans-serif;
    
    background-color: var(--bg-color);
    padding: 60px 20px;
  }

  .hp37-offer-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    background: var(--accent-color);
    border: 4px dashed var(--text-color);
    border-radius: 40px;
    padding: 80px 40px;
    text-align: center;
    position: relative;
    box-shadow: 10px 10px 0px var(--text-color);
    transform: rotate(-1deg);
  }

  @media screen and (max-width: 768px) {
    .hp37-offer-wrapper {
      padding: 60px 20px;
      border-radius: 20px;
      box-shadow: 6px 6px 0px var(--text-color);
    }
  }

  .hp37-offer__title {
    font-family: var(--font-heading);
    font-size: clamp(60px, 10vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: var(--bg-color);
    margin: 0 0 20px;
    text-shadow: 3px 3px 0px var(--text-color);
    transform: rotate(-3deg);
  }

  .hp37-offer__subtitle {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 40px;
    background: var(--bg-color);
    display: inline-block;
    padding: 10px 20px;
    border-radius: 50px;
    border: 2px solid var(--text-color);
  }

  .hp37-offer__btn {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    text-decoration: none;
    padding: 20px 50px;
    background-color: var(--text-color);
    color: var(--bg-color);
    border-radius: 50px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 4px 4px 0px var(--bg-color);
  }

  .hp37-offer__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--bg-color);
  }

  /* Decorative elements */
  .hp37-offer__star {
    position: absolute;
    width: 60px; height: 60px;
    color: var(--bg-color);
  }

  .hp37-offer__star--1 {
    top: -20px; left: -20px;
    transform: rotate(15deg);
  }

  .hp37-offer__star--2 {
    bottom: -20px; right: -20px;
    transform: rotate(-15deg);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp37-offer-wrapper" id="HP37Offer-{{ section.id }}">
  <svg class="hp37-offer__star hp37-offer__star--1" viewBox="0 0 24 24" fill="currentColor" stroke="var(--text-color)" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
  
  <h2 class="hp37-offer__title">{{ section.settings.title }}</h2>
  
  {%- if section.settings.subtitle != blank -%}
    <div class="hp37-offer__subtitle">{{ section.settings.subtitle }}</div>
  {%- endif -%}
  
  <br>
  
  {%- if section.settings.btn_label != blank -%}
    <a href="{{ section.settings.btn_link | default: '#' }}" class="hp37-offer__btn">
      {{ section.settings.btn_label }}
    </a>
  {%- endif -%}

  <svg class="hp37-offer__star hp37-offer__star--2" viewBox="0 0 24 24" fill="currentColor" stroke="var(--text-color)" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
</div>

{% schema %}
{
  "name": "HP37 - Retro Offer",
  "class": "section-hp37-offer-banner",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "SUMMER SALE!"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "USE CODE: SUNSHINE FOR 20% OFF"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Shop the Sale"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 180,
      "step": 5,
      "unit": "px",
      "label": "Heading Size",
      "default": 120
    },
    {
      "type": "header",
      "content": "Retro Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Page Background",
      "default": "#F4E3C5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Banner Background",
      "default": "#D96C4A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Border Color",
      "default": "#4A3219"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP37 - Retro Offer"
    }
  ]
}
{% endschema %}
