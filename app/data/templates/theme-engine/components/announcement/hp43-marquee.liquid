{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color | default: "#00F0FF" }};
    color: #080B10;
    padding: 16px 0;
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid {{ section.settings.border_color | default: "#00F0FF" }};
    border-bottom: 1px solid {{ section.settings.border_color | default: "#00F0FF" }};
  }

  .hp43-marquee__track {
    display: inline-flex;
    gap: 40px;
    animation: hp43-marquee-anim 22s linear infinite;
    font-family: 'Orbitron', sans-serif;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .hp43-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  @keyframes hp43-marquee-anim {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}

<div class="hp43-marquee__track">
  <div class="hp43-marquee__item">⚡ INTERNATIONAL EXPRESS SHIPPING ⚡</div>
  <div class="hp43-marquee__item">🛡️ 2-YEAR UNLIMITED WARRANTY 🛡️</div>
  <div class="hp43-marquee__item">💎 ZERO LATENCY ARCHITECTURE 💎</div>
  <div class="hp43-marquee__item">🔥 OVER 50,000 VERIFIED PRO USERS 🔥</div>
  <div class="hp43-marquee__item">⚡ INTERNATIONAL EXPRESS SHIPPING ⚡</div>
  <div class="hp43-marquee__item">🛡️ 2-YEAR UNLIMITED WARRANTY 🛡️</div>
  <div class="hp43-marquee__item">💎 ZERO LATENCY ARCHITECTURE 💎</div>
  <div class="hp43-marquee__item">🔥 OVER 50,000 VERIFIED PRO USERS 🔥</div>
</div>

{% schema %}
{
  "name": "HP43 - Cyber Marquee",
  "class": "section-hp43-marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#00F0FF"
    }
  ],
  "presets": [
    {
      "name": "HP43 - Cyber Marquee"
    }
  ]
}
{% endschema %}
