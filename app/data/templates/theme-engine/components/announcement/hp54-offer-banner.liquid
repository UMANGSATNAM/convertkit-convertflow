{%- style -%}
  #shopify-section-{{ section.id }} {
    background: linear-gradient(135deg, #1E3A5F 0%, #0A1628 100%);
    color: #FFFFFF;
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }
  .hp54-offer__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .hp54-offer__eyebrow { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #60A5FA; margin: 0 0 16px; }
  .hp54-offer__heading { font-family: 'Tenor Sans', serif; font-size: clamp(28px, 4vw, 48px); color: #FFFFFF; margin: 0 0 18px; line-height: 1.1; }
  .hp54-offer__desc { font-size: 15px; line-height: 1.7; color: #94A3B8; margin: 0 0 30px; }
  .hp54-offer__btn { display: inline-flex; align-items: center; gap: 10px; padding: 14px 30px; background: #3B82F6; color: #FFFFFF; font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 700; text-decoration: none; border-radius: 8px; box-shadow: 0 4px 16px rgba(59, 130, 246, 0.3); transition: all 0.3s ease; }
  .hp54-offer__btn:hover { box-shadow: 0 8px 25px rgba(59, 130, 246, 0.5); transform: translateY(-2px); }
  .hp54-offer__img-wrap { border-radius: 16px; overflow: hidden; height: 400px; border: 1px solid rgba(59, 130, 246, 0.2); }
  .hp54-offer__img { width: 100%; height: 100%; object-fit: cover; }
  @media screen and (max-width: 992px) { .hp54-offer__container { grid-template-columns: 1fr; text-align: center; } .hp54-offer__img-wrap { height: 300px; } }
{%- endstyle -%}
<div class="hp54-offer__container">
  <div>
    <p class="hp54-offer__eyebrow">{{ section.settings.eyebrow | default: '◆ LIMITED OFFER' }}</p>
    <h2 class="hp54-offer__heading">{{ section.settings.heading | default: 'Midnight Ritual Set' }}</h2>
    <p class="hp54-offer__desc">{{ section.settings.description | default: 'Save 25% on our deep-sea recovery trio — sapphire serum, blue tansy mask, and lunar moisturizer.' }}</p>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp54-offer__btn">{{ section.settings.btn_label | default: 'Shop Now' }} &rarr;</a>
  </div>
  <div class="hp54-offer__img-wrap">
    {%- if section.settings.image != blank -%}<img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" class="hp54-offer__img" alt="{{ section.settings.heading }}" loading="lazy">
    {%- else -%}{{ 'product-1' | placeholder_svg_tag: 'hp54-offer__img' }}{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "HP54 - Sapphire Offer",
  "class": "section-hp54-offer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◆ LIMITED OFFER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Midnight Ritual Set" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Save 25% on our deep-sea recovery trio." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Shop Now" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP54 - Sapphire Offer" }]
}
{% endschema %}
