{%- comment -%}
  Component: announcement-luxury-jewellery-v1
  Family: Luxury | Style: luxury
  Archetypes: luxury, premium
  v2.0 — StoreForge Component Library
{%- endcomment -%}
<div class="announcement-bar-niche announcement-bar--jewellery" 
     style="background-color: var(--color-text); color: var(--color-background); font-size: 0.85rem; padding: var(--space-8) var(--space-16); text-align: center; position: relative; letter-spacing: 0.1em; text-transform: uppercase;">
  
  <div class="announcement-bar-content">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="announcement-bar-link">
    {%- endif -%}

    <span>{{ section.settings.text | escape }}</span>

    {%- if section.settings.show_countdown and section.settings.countdown_date != blank -%}
      <span class="announcement-countdown" data-date="{{ section.settings.countdown_date }}" style="margin-left: var(--space-12); font-weight: bold; font-family: var(--font-body-family);">
        <span class="countdown-days">00</span>d : 
        <span class="countdown-hours">00</span>h : 
        <span class="countdown-minutes">00</span>m : 
        <span class="countdown-seconds">00</span>s
      </span>
    {%- endif -%}

    {%- if section.settings.link != blank -%}
      </a>
    {%- endif -%}
  </div>

  <button type="button" class="announcement-bar-close" aria-label="{{ 'sections.announcement_bar.close' | t }}" 
          onclick="this.parentNode.remove()" 
          style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; color: inherit; cursor: pointer; display: flex; align-items: center;">
    {% render 'icon-close' %}
  </button>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Free shipping on orders over $50"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement Link"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown",
      "default": false
    },
    {
      "type": "text",
      "id": "countdown_date",
      "label": "Countdown Date (ISO 8601)",
      "placeholder": "2026-12-31T23:59:59Z"
    }
  ]
}
{% endschema %}
