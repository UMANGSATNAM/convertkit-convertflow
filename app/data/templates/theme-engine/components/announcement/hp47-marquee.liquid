{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp47-marq-bg: {{ section.settings.bg_color | default: '#382E2B' }};
    --hp47-marq-text: {{ section.settings.text_color | default: '#FAF7F2' }};
    
    background: var(--hp47-marq-bg);
    color: var(--hp47-marq-text);
    padding: {{ section.settings.padding_vertical | default: 16 }}px 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .hp47-marquee__track {
    display: inline-flex;
    gap: 40px;
    animation: hp47-scroll {{ section.settings.speed | default: 22 }}s linear infinite;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .hp47-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  @keyframes hp47-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}

<div class="hp47-marquee__track">
  {%- if section.blocks.size > 0 -%}
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <div class="hp47-marquee__item" {{ block.shopify_attributes }}>
          <span>🌾</span>
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  {%- else -%}
    {%- for i in (1..2) -%}
      <div class="hp47-marquee__item"><span>🌾</span><span>COLD-EXTRACTED NORDIC OAT LIPIDS</span></div>
      <div class="hp47-marquee__item"><span>✦</span><span>100% SUSTAINABLE SCANDINAVIAN LINEN</span></div>
      <div class="hp47-marquee__item"><span>✈️</span><span>FREE EXPRESS AIR SHIPPING OVER $70</span></div>
      <div class="hp47-marquee__item"><span>🛡️</span><span>HYPOALLERGENIC DERMATOLOGIST FORMULA</span></div>
    {%- endfor -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP47 - Taupe Marquee",
  "class": "section-hp47-marquee",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#382E2B" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FAF7F2" },
    { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 2, "unit": "s", "label": "Scroll Duration", "default": 22 },
    { "type": "range", "id": "padding_vertical", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Padding Vertical", "default": 16 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ticker Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "COLD-EXTRACTED NORDIC OAT LIPIDS" }
      ]
    }
  ],
  "presets": [
    { "name": "HP47 - Taupe Marquee" }
  ]
}
{% endschema %}
