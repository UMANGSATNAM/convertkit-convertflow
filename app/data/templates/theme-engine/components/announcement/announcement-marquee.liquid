{% comment %}
  Announcement Marquee - Infinite Smooth Ticker
  Category: announcement
  Version: 2.0
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --marquee-bg: {{ section.settings.bg_color | default: '#0f172a' }};
    --marquee-text: {{ section.settings.text_color | default: '#ffffff' }};
    --marquee-speed: {{ section.settings.speed | default: 28 }}s;
    background-color: var(--marquee-bg);
    color: var(--marquee-text);
    overflow: hidden;
    position: relative;
    z-index: 40;
    font-family: inherit;
    font-size: {{ section.settings.font_size | default: 13 }}px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .cf-marquee-wrap {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
    padding: 10px 0;
  }

  .cf-marquee-track {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 40px;
    animation: cf-marquee-scroll var(--marquee-speed) linear infinite;
  }

  .cf-marquee-wrap:hover .cf-marquee-track {
    animation-play-state: {% if section.settings.pause_on_hover %}paused{% else %}running{% endif %};
  }

  .cf-marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .cf-marquee-item:hover {
    opacity: 0.85;
  }

  .cf-marquee-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    background: {{ section.settings.badge_bg | default: '#38bdf8' }};
    color: {{ section.settings.badge_text | default: '#0f172a' }};
    font-size: 11px;
    font-weight: 800;
  }

  .cf-marquee-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.4;
  }

  @keyframes cf-marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-100%); }
  }
{%- endstyle -%}

<div class="cf-marquee-wrap" role="region" aria-label="Announcement Ticker">
  {% for i in (1..3) %}
    <div class="cf-marquee-track" {% if forloop.index > 1 %}aria-hidden="true"{% endif %}>
      <a href="{{ section.settings.link_1 | default: '/collections/all' }}" class="cf-marquee-item">
        <span class="cf-marquee-badge">{{ section.settings.badge_1 | default: 'LIMITED TIME' }}</span>
        <span>{{ section.settings.text_1 | default: '⚡ FLASH SALE: UP TO 40% OFF STOREWIDE' }}</span>
      </a>
      <span class="cf-marquee-dot"></span>
      <a href="{{ section.settings.link_2 | default: '/collections/all' }}" class="cf-marquee-item">
        <span>{{ section.settings.text_2 | default: '✨ FREE EXPRESS SHIPPING OVER $50' }}</span>
      </a>
      <span class="cf-marquee-dot"></span>
      <a href="{{ section.settings.link_3 | default: '/collections/all' }}" class="cf-marquee-item">
        <span class="cf-marquee-badge">{{ section.settings.badge_3 | default: 'NEW' }}</span>
        <span>{{ section.settings.text_3 | default: '🌱 100% ETHICALLY SOURCED & ECO-FRIENDLY' }}</span>
      </a>
      <span class="cf-marquee-dot"></span>
      <a href="{{ section.settings.link_4 | default: '/collections/all' }}" class="cf-marquee-item">
        <span>{{ section.settings.text_4 | default: '⭐ 4.9/5 RATED BY 25,000+ HAPPY CUSTOMERS' }}</span>
      </a>
      <span class="cf-marquee-dot"></span>
    </div>
  {% endfor %}
</div>

