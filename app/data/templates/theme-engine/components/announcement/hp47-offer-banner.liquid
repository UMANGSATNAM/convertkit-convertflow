{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp47-offer-bg: {{ section.settings.bg_color | default: '#382E2B' }};
    --hp47-offer-text: {{ section.settings.text_color | default: '#FAF7F2' }};
    
    background: var(--hp47-offer-bg);
    color: var(--hp47-offer-text);
    padding-top: {{ section.settings.padding_top | default: 75 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 75 }}px;
    text-align: center;
  }

  .hp47-offer__box {
    max-width: {{ section.settings.container_width | default: 860 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp47-offer__pill {
    display: inline-block;
    padding: 6px 18px;
    background: rgba(250, 247, 242, 0.15);
    border: 1px solid rgba(250, 247, 242, 0.3);
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin-bottom: 20px;
  }

  .hp47-offer__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 600;
    line-height: 1.1;
    margin: 0 0 16px;
  }

  .hp47-offer__desc {
    font-size: 16px;
    line-height: 1.7;
    color: #D6CCC2;
    margin: 0 auto 30px;
    max-width: 580px;
  }

  .hp47-offer__code-wrap {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: rgba(250, 247, 242, 0.1);
    border: 1px dashed rgba(250, 247, 242, 0.4);
    padding: 10px 24px;
    border-radius: 50px;
    margin-bottom: 30px;
  }

  .hp47-offer__code {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .hp47-offer__btn {
    display: inline-flex;
    padding: 16px 36px;
    background: #FAF7F2;
    color: #382E2B;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    transition: all 0.25s ease;
  }

  .hp47-offer__btn:hover {
    background: #EAE3DA;
    transform: translateY(-2px);
  }
{%- endstyle -%}

<div class="hp47-offer__box">
  <span class="hp47-offer__pill">{{ section.settings.badge | default: 'HARVEST PRIVILEGE' }}</span>
  <h2 class="hp47-offer__title">{{ section.settings.heading | default: 'ENJOY 20% OFF YOUR FIRST LINEN RITUAL' }}</h2>
  <p class="hp47-offer__desc">
    {{ section.settings.description | default: 'Experience the restorative touch of Scandinavian organic oat and flax lipid skincare. Apply welcome privilege on your first order.' }}
  </p>

  <div class="hp47-offer__code-wrap">
    <span class="hp47-offer__code">CODE: {{ section.settings.promo_code | default: 'LINEN20' }}</span>
  </div>

  <div>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp47-offer__btn">
      {{ section.settings.btn_text | default: 'Claim Harvest Code &rarr;' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP47 - Taupe Offer",
  "class": "section-hp47-offer",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#382E2B" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FAF7F2" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "HARVEST PRIVILEGE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "ENJOY 20% OFF YOUR FIRST LINEN RITUAL" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Experience the restorative touch of Scandinavian organic oat and flax lipid skincare." },
    { "type": "text", "id": "promo_code", "label": "Promo Code", "default": "LINEN20" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Claim Harvest Code →" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Top", "default": 75 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 75 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 860 }
  ],
  "presets": [
    { "name": "HP47 - Taupe Offer" }
  ]
}
{% endschema %}
