<style>
@media screen and (max-width: 768px) {
  .hp63-marquee {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp63-marq-bg: {{ section.settings.bg_color | default: '#881337' }};
    --hp63-marq-text: {{ section.settings.text_color | default: '#FFFBEB' }};
    background: var(--hp63-marq-bg);
    overflow: hidden;
    padding: {{ section.settings.padding_vertical | default: 10 }}px 0;
  }
  .hp63-marquee__track {
    display: flex; gap: 50px;
    animation: hp63MarqueeScroll {{ section.settings.speed | default: 25 }}s linear infinite;
    width: max-content;
  }
  .hp63-marquee__item {
    display: flex; align-items: center; gap: 50px; white-space: nowrap;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: {{ section.settings.font_size | default: 13 }}px;
    font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--hp63-marq-text);
  }
  .hp63-marquee__dot {
    width: 6px; height: 6px;
    background: {{ section.settings.dot_color | default: '#F59E0B' }};
    border-radius: 50%; flex-shrink: 0;
  }
  @keyframes hp63MarqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}
<div class="hp63-marquee__track">
  {%- for i in (1..12) -%}
    <div class="hp63-marquee__item">
      <span>{{ section.settings.marquee_text | default: '🌹 MOROCCAN DAMASK ROSE 🏺 SPICED AMBER RESIN 🍊 NEROLI BLOSSOM ✨ DESERT ARGAN ELIXIR' }}</span>
      <span class="hp63-marquee__dot"></span>
    </div>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "HP63 Marquee",
  "class": "section-hp63-marquee",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#881337" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFBEB" },
    { "type": "color", "id": "dot_color", "label": "Dot Color", "default": "#F59E0B" },
    { "type": "text", "id": "marquee_text", "label": "Marquee Text", "default": "🌹 MOROCCAN DAMASK ROSE 🏺 SPICED AMBER RESIN 🍊 NEROLI BLOSSOM ✨ DESERT ARGAN ELIXIR" },
    { "type": "range", "id": "speed", "min": 10, "max": 50, "step": 5, "unit": "s", "label": "Speed", "default": 25 },
    { "type": "range", "id": "font_size", "min": 10, "max": 22, "step": 1, "unit": "px", "label": "Font Size", "default": 13 },
    { "type": "range", "id": "padding_vertical", "min": 4, "max": 24, "step": 2, "unit": "px", "label": "Padding", "default": 10 }
  ],
  "presets": [{ "name": "HP63 Marquee" }]
}
{% endschema %}
