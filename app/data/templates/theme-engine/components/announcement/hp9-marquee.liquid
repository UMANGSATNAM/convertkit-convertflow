{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#00ff88'
  assign text_color = section.settings.text_color | default: '#000000'
  assign speed = section.settings.speed | default: 15
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: 15px 0;
    overflow: hidden;
    position: relative;
  }
  
  .hp9-marquee-wrapper-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    position: relative;
    font-family: 'Space Mono', monospace;
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  
  .hp9-marquee-content-{{ section_id }} {
    display: flex;
    animation: hp9-marquee-scroll-{{ section_id }} {{ speed }}s linear infinite;
  }
  
  .hp9-marquee-item-{{ section_id }} {
    display: flex;
    align-items: center;
    padding: 0 30px;
  }
  
  .hp9-marquee-separator-{{ section_id }} {
    margin: 0 30px;
    font-weight: 900;
  }
  
  @keyframes hp9-marquee-scroll-{{ section_id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

@media screen and (max-width: 768px) {
  .hp9-marquee {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}

</style>

<div class="hp9-marquee-wrapper-{{ section_id }}">
  <!-- Output content multiple times for seamless loop -->
  {% for i in (1..3) %}
    <div class="hp9-marquee-content-{{ section_id }}">
      {% for block in section.blocks %}
        <div class="hp9-marquee-item-{{ section_id }}" {{ block.shopify_attributes }}>
          {{ block.settings.text }}
          <span class="hp9-marquee-separator-{{ section_id }}">///</span>
        </div>
      {% endfor %}
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP9 Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#00ff88"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "s",
      "label": "Animation Speed",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "SYSTEM PROTOCOL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP9 Marquee",
      "blocks": [
        { "type": "text", "settings": { "text": "NEW ARRIVALS" } },
        { "type": "text", "settings": { "text": "UPGRADE YOUR SETUP" } },
        { "type": "text", "settings": { "text": "MAXIMUM PERFORMANCE" } },
        { "type": "text", "settings": { "text": "SECURE CHECKOUT" } }
      ]
    }
  ]
}
{% endschema %}
