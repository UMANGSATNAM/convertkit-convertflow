{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp60-marq-bg: {{ section.settings.bg_color | default: '#3F6212' }};
    --hp60-marq-text: {{ section.settings.text_color | default: '#FEF9C3' }};
    background: var(--hp60-marq-bg);
    overflow: hidden;
    padding: {{ section.settings.padding_vertical | default: 10 }}px 0;
  }
  .hp60-marquee__track {
    display: flex; gap: 50px;
    animation: hp60MarqueeScroll {{ section.settings.speed | default: 25 }}s linear infinite;
    width: max-content;
  }
  .hp60-marquee__item {
    display: flex; align-items: center; gap: 50px; white-space: nowrap;
    font-family: 'Outfit', sans-serif;
    font-size: {{ section.settings.font_size | default: 13 }}px;
    font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--hp60-marq-text);
  }
  .hp60-marquee__dot {
    width: 6px; height: 6px;
    background: {{ section.settings.dot_color | default: '#D97706' }};
    border-radius: 50%; flex-shrink: 0;
  }
  @keyframes hp60MarqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}
<div class="hp60-marquee__track">
  {%- for i in (1..12) -%}
    <div class="hp60-marquee__item">
      <span>{{ section.settings.marquee_text | default: '🍋 CALABRIAN BERGAMOT 🌿 TUSCAN OLIVE LEAF 🏛️ TRAVERTINE APOTHECARY ☀️ MEDITERRANEAN HARVEST' }}</span>
      <span class="hp60-marquee__dot"></span>
    </div>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "HP60 Marquee",
  "class": "section-hp60-marquee",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#3F6212" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FEF9C3" },
    { "type": "color", "id": "dot_color", "label": "Dot Color", "default": "#D97706" },
    { "type": "text", "id": "marquee_text", "label": "Marquee Text", "default": "🍋 CALABRIAN BERGAMOT 🌿 TUSCAN OLIVE LEAF 🏛️ TRAVERTINE APOTHECARY ☀️ MEDITERRANEAN HARVEST" },
    { "type": "range", "id": "speed", "min": 10, "max": 50, "step": 5, "unit": "s", "label": "Speed", "default": 25 },
    { "type": "range", "id": "font_size", "min": 10, "max": 22, "step": 1, "unit": "px", "label": "Font Size", "default": 13 },
    { "type": "range", "id": "padding_vertical", "min": 4, "max": 24, "step": 2, "unit": "px", "label": "Padding", "default": 10 }
  ],
  "presets": [{ "name": "HP60 Marquee" }]
}
{% endschema %}
