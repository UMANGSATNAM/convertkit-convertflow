{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp45-marq-bg: {{ section.settings.bg_color | default: '#0A0A0A' }};
    --hp45-marq-text: {{ section.settings.text_color | default: '#F5F5F0' }};
    
    background: var(--hp45-marq-bg);
    color: var(--hp45-marq-text);
    padding: {{ section.settings.padding_vertical | default: 14 }}px 0;
    overflow: hidden;
    white-space: nowrap;
    border-bottom: 2px solid #0A0A0A;
  }

  .hp45-marquee__track {
    display: inline-flex;
    gap: 40px;
    animation: hp45-marquee-scroll {{ section.settings.speed | default: 18 }}s linear infinite;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .hp45-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  @keyframes hp45-marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}

<div class="hp45-marquee__track">
  {%- if section.blocks.size > 0 -%}
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <div class="hp45-marquee__item" {{ block.shopify_attributes }}>
          <span>// {{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  {%- else -%}
    {%- for i in (1..2) -%}
      <div class="hp45-marquee__item"><span>// ZERO SILICONES</span></div>
      <div class="hp45-marquee__item"><span>// 100% ACTIVE BIO-PEPTIDES</span></div>
      <div class="hp45-marquee__item"><span>// ARCHITECTURAL DOSAGE FORM</span></div>
      <div class="hp45-marquee__item"><span>// GLOBAL COURIER DDP PRE-PAID</span></div>
    {%- endfor -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP45 - Brutal Marquee",
  "class": "section-hp45-marquee",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0A0A0A" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#F5F5F0" },
    { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 2, "unit": "s", "label": "Scroll Duration", "default": 18 },
    { "type": "range", "id": "padding_vertical", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Vertical Padding", "default": 14 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ticker Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "ZERO SILICONES" }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP45 - Brutal Marquee",
      "blocks": [
        { "type": "item", "settings": { "text": "ZERO SILICONES" } },
        { "type": "item", "settings": { "text": "100% ACTIVE BIO-PEPTIDES" } },
        { "type": "item", "settings": { "text": "ARCHITECTURAL DOSAGE FORM" } },
        { "type": "item", "settings": { "text": "GLOBAL COURIER DDP PRE-PAID" } }
      ]
    }
  ]
}
{% endschema %}
