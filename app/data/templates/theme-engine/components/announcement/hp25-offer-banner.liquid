{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Outfit:wght@300;400;600;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-orange: {{ section.settings.accent_orange }};
    --accent-yellow: {{ section.settings.accent_yellow }};
    --font-heading: 'Fraunces', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    /* Subtle grainy texture */
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Decorative Retro Waves Background */
  .hp25-offer__bg-waves {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 200%;
    height: 200%;
    transform: translate(-50%, -50%);
    background: repeating-radial-gradient(
      circle at center,
      var(--accent-orange) 0,
      var(--accent-orange) 40px,
      var(--accent-yellow) 40px,
      var(--accent-yellow) 80px,
      var(--bg-color) 80px,
      var(--bg-color) 120px
    );
    opacity: 0.15;
    z-index: 0;
    pointer-events: none;
    animation: rotateWaves 60s linear infinite;
  }

  @keyframes rotateWaves {
    0% { transform: translate(-50%, -50%) rotate(0deg); }
    100% { transform: translate(-50%, -50%) rotate(360deg); }
  }

  .hp25-offer-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 768px) {
    .hp25-offer-wrapper {
      padding: 0 20px;
    }
  }

  .hp25-offer__container {
    background-color: var(--bg-color);
    border: 6px solid var(--text-color);
    border-radius: 40px;
    padding: 60px 40px;
    text-align: center;
    box-shadow: 15px 15px 0 var(--accent-orange);
    position: relative;
  }

  @media screen and (max-width: 768px) {
    .hp25-offer__container {
      padding: 40px 20px;
      border-radius: 20px;
      border-width: 4px;
      box-shadow: 8px 8px 0 var(--accent-orange);
    }
  }

  /* Starburst Badge */
  .hp25-offer__badge {
    position: absolute;
    top: -30px;
    right: -30px;
    width: 120px;
    height: 120px;
    background-color: var(--accent-yellow);
    border: 3px solid var(--text-color);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 900;
    font-style: italic;
    color: var(--text-color);
    line-height: 1;
    transform: rotate(15deg);
    /* Create starburst shape */
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    animation: pulseBadge 2s infinite alternate ease-in-out;
  }

  @media screen and (max-width: 768px) {
    .hp25-offer__badge {
      width: 90px;
      height: 90px;
      font-size: 14px;
      top: -20px;
      right: -10px;
    }
  }

  @keyframes pulseBadge {
    0% { transform: scale(1) rotate(15deg); }
    100% { transform: scale(1.1) rotate(20deg); }
  }

  .hp25-offer__subheading {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 800;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 15px;
    display: inline-block;
    padding: 5px 15px;
    background: var(--accent-yellow);
    border: 2px solid var(--text-color);
    border-radius: 50px;
  }

  .hp25-offer__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    font-style: italic;
    color: var(--text-color);
    line-height: 0.9;
    margin: 0 0 20px;
    text-transform: uppercase;
    /* Repeating shadow effect */
    text-shadow: 
      3px 3px 0 var(--bg-color), 
      4px 4px 0 var(--text-color),
      7px 7px 0 var(--accent-orange),
      8px 8px 0 var(--text-color);
  }

  .hp25-offer__text {
    font-family: var(--font-body);
    font-size: clamp(16px, 2vw, {{ section.settings.text_size }}px);
    color: var(--text-color);
    margin: 0 auto 40px;
    max-width: 600px;
    font-weight: 600;
    line-height: 1.5;
  }

  .hp25-offer__btn {
    display: inline-block;
    padding: 18px 50px;
    background-color: var(--accent-orange);
    color: var(--bg-color);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 50px;
    border: 3px solid var(--text-color);
    box-shadow: 6px 6px 0 var(--text-color);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .hp25-offer__btn:hover {
    transform: translate(3px, 3px);
    box-shadow: 3px 3px 0 var(--text-color);
    background-color: var(--text-color);
    color: var(--bg-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp25-offer-wrapper" id="HP25Offer-{{ section.id }}">
  <div class="hp25-offer__bg-waves"></div>
  
  <div class="hp25-offer__container">
    {%- if section.settings.badge_text != blank -%}
      <div class="hp25-offer__badge">
        <span>{{ section.settings.badge_text }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="hp25-offer__subheading">{{ section.settings.subheading }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="hp25-offer__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hp25-offer__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.btn_text != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp25-offer__btn">
        {{ section.settings.btn_text }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP25 - Retro Offer",
  "class": "section-hp25-offer-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "WOW!"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "LIMITED TIME"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SAVE 20%"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Catch the groove and save big on all vintage-inspired threads this weekend only.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SHOP THE SALE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1000
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 16,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 20
    },
    {
      "type": "header",
      "content": "Retro 70s Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#76834F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text / Border (Dark Brown)",
      "default": "#3E2723"
    },
    {
      "type": "color",
      "id": "accent_orange",
      "label": "Accent (Burnt Orange)",
      "default": "#D15F3C"
    },
    {
      "type": "color",
      "id": "accent_yellow",
      "label": "Accent (Mustard)",
      "default": "#E2B144"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP25 - Retro Offer"
    }
  ]
}
{% endschema %}
