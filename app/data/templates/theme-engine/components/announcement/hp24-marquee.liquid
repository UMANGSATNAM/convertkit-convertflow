{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Orbitron', sans-serif;
    --font-body: 'Share Tech Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--accent-color);
    border-bottom: 1px solid var(--accent-color);
    box-shadow: 0 0 10px rgba(var(--accent-color-rgb), 0.2);
  }

  /* Extract RGB for glow */
  {%- assign accent_hex = section.settings.accent_color | remove: '#' -%}
  {%- assign r = accent_hex | slice: 0, 2 -%}
  {%- assign g = accent_hex | slice: 2, 2 -%}
  {%- assign b = accent_hex | slice: 4, 2 -%}
  
  #shopify-section-{{ section.id }} {
    /* Rough approximation, usually requires JS or exact rgba input, but we'll use drop-shadow/box-shadow directly */
  }

  .hp24-marquee-wrapper {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
    position: relative;
  }

  /* Scanline effect over the marquee */
  .hp24-marquee-wrapper::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.3));
    background-size: 100% 4px;
    z-index: 10;
    pointer-events: none;
  }

  .hp24-marquee__track {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    animation: marqueeScroll {{ section.settings.speed }}s linear infinite;
    {%- if section.settings.direction == 'right' -%}
      animation-direction: reverse;
    {%- endif -%}
  }
  
  {%- if section.settings.pause_on_hover -%}
    .hp24-marquee-wrapper:hover .hp24-marquee__track {
      animation-play-state: paused;
    }
  {%- endif -%}

  @keyframes marqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .hp24-marquee__item {
    display: inline-flex;
    align-items: center;
    padding: 0 {{ section.settings.gap | divided_by: 2 }}px;
  }

  .hp24-marquee__text {
    font-family: var(--font-heading);
    font-size: clamp(16px, 3vw, {{ section.settings.text_size }}px);
    font-weight: 700;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 2px;
    text-shadow: 0 0 5px var(--accent-color), 0 0 10px var(--accent-color);
  }

  .hp24-marquee__icon {
    font-family: var(--font-body);
    font-size: clamp(16px, 3vw, {{ section.settings.text_size }}px);
    color: var(--accent-color);
    margin: 0 15px;
    font-weight: bold;
    text-shadow: 0 0 8px var(--accent-color);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* Glitch effect randomly on some items */
  .hp24-marquee__item:nth-child(3n) .hp24-marquee__text {
    animation: glitchText 3s infinite;
  }

  @keyframes glitchText {
    0%, 95% { transform: translate(0); opacity: 1; }
    96% { transform: translate(-2px, 2px); opacity: 0.8; }
    97% { transform: translate(2px, -2px); opacity: 0.9; }
    98% { transform: translate(-2px, -2px); opacity: 0.8; }
    99% { transform: translate(2px, 2px); opacity: 1; }
    100% { transform: translate(0); opacity: 1; }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp24-marquee-wrapper" id="HP24Marquee-{{ section.id }}">
  <div class="hp24-marquee__track">
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <div class="hp24-marquee__item" {{ block.shopify_attributes }}>
          {%- if block.settings.text != blank -%}
            <span class="hp24-marquee__text">{{ block.settings.text }}</span>
          {%- endif -%}
          
          <span class="hp24-marquee__icon">
            {%- if section.settings.separator == 'slashes' -%}//
            {%- elsif section.settings.separator == 'brackets' -%}[+]
            {%- elsif section.settings.separator == 'star' -%}*
            {%- else -%}|
            {%- endif -%}
          </span>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP24 - Cyberpunk Marquee",
  "class": "section-hp24-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Animation Speed",
      "default": 30
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Right to Left" },
        { "value": "right", "label": "Left to Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography & Style"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Space Between Items",
      "default": 40
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Separator Style",
      "options": [
        { "value": "slashes", "label": "//" },
        { "value": "brackets", "label": "[+]" },
        { "value": "star", "label": "*" },
        { "value": "pipe", "label": "|" }
      ],
      "default": "slashes"
    },
    {
      "type": "header",
      "content": "Cyberpunk Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Neon Glow Color",
      "default": "#00F3FF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 16
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "SYSTEM OVERRIDE DETECTED"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP24 - Cyberpunk Marquee",
      "blocks": [
        { "type": "text", "settings": { "text": "CYBERNETIC ENHANCEMENTS ONLINE" } },
        { "type": "text", "settings": { "text": "FREE SHIPPING SECTOR 7" } },
        { "type": "text", "settings": { "text": "INITIALIZE SEQUENCE" } },
        { "type": "text", "settings": { "text": "UPGRADE YOUR HARDWARE" } }
      ]
    }
  ]
}
{% endschema %}
