{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp47-test-bg: {{ section.settings.bg_color | default: '#F5F0EB' }};
    
    background-color: var(--hp47-test-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp47-test__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp47-test__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp47-test__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 4.5vw, 44px);
    font-weight: 600;
    color: #382E2B;
    margin: 0 0 8px;
  }

  .hp47-test__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp47-test__card {
    background: #FAF7F2;
    border: 1px solid #EAE3DA;
    border-radius: 24px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 30px rgba(56, 46, 43, 0.04);
  }

  .hp47-test__stars {
    color: #8C6D58;
    font-size: 18px;
    margin-bottom: 16px;
    letter-spacing: 2px;
  }

  .hp47-test__quote {
    font-size: 15px;
    line-height: 1.7;
    color: #382E2B;
    margin: 0 0 24px;
    font-style: italic;
  }

  .hp47-test__author-row {
    border-top: 1px solid #EAE3DA;
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp47-test__author {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #382E2B;
  }

  .hp47-test__verified {
    font-size: 11px;
    font-weight: 700;
    color: #8C6D58;
  }

  @media screen and (max-width: 992px) {
    .hp47-test__grid { grid-template-columns: 1fr; max-width: 500px; margin: 0 auto; }
  }
{%- endstyle -%}

<div class="hp47-test__wrap">
  <div class="hp47-test__header">
    <h2 class="hp47-test__heading">{{ section.settings.heading | default: 'Reflections from Our Patrons' }}</h2>
    <p style="font-size:14px; color:#6E5E58;">{{ section.settings.subheading | default: 'Pure testimonials on oat barrier restoration and calm skin.' }}</p>
  </div>

  <div class="hp47-test__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp47-test__card" {{ block.shopify_attributes }}>
          <div>
            <div class="hp47-test__stars">★★★★★</div>
            <p class="hp47-test__quote">"{{ block.settings.quote }}"</p>
          </div>
          <div class="hp47-test__author-row">
            <span class="hp47-test__author">{{ block.settings.author }}</span>
            <span class="hp47-test__verified">✓ Verified Patron</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp47-test__card">
        <div>
          <div class="hp47-test__stars">★★★★★</div>
          <p class="hp47-test__quote">"The Nordic oat barrier balm melted effortlessly and saved my rosacea-prone skin during the harsh dry winter."</p>
        </div>
        <div class="hp47-test__author-row">
          <span class="hp47-test__author">ELSA BERGSTRÖM</span>
          <span class="hp47-test__verified">✓ Verified</span>
        </div>
      </div>
      <div class="hp47-test__card">
        <div>
          <div class="hp47-test__stars">★★★★★</div>
          <p class="hp47-test__quote">"Pristine birch sap essence feels like pure morning dew. It absorbs completely with zero sticky residue."</p>
        </div>
        <div class="hp47-test__author-row">
          <span class="hp47-test__author">SOFIE NIELSEN</span>
          <span class="hp47-test__verified">✓ Verified</span>
        </div>
      </div>
      <div class="hp47-test__card">
        <div>
          <div class="hp47-test__stars">★★★★★</div>
          <p class="hp47-test__quote">"The heavy frosted glass vessels with wooden caps look gorgeous on my vanity. Fast 48-hr air courier."</p>
        </div>
        <div class="hp47-test__author-row">
          <span class="hp47-test__author">HANNAH HOLM</span>
          <span class="hp47-test__verified">✓ Verified</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP47 - Taupe Test",
  "class": "section-hp47-testimonials",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F0EB" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reflections from Our Patrons" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pure testimonials on oat barrier restoration and calm skin." },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Item",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The Nordic oat barrier balm saved my skin." },
        { "type": "text", "id": "author", "label": "Author Name", "default": "ELSA BERGSTRÖM" }
      ]
    }
  ],
  "presets": [
    { "name": "HP47 - Taupe Test" }
  ]
}
{% endschema %}
