{% comment %} Testimonials Marquee Luxury — Continuous CSS marquee loop with star rating bar and edge fades {% endcomment %}

<section class="sf-tm sf-tm-{{ section.id }}" id="sf-tm-{{ section.id }}">
  <div class="sf-tm-header sf-reveal">
    {% if section.settings.label != blank %}
      <span class="sf-section-label">{{ section.settings.label }}</span>
    {% endif %}
    {% if section.settings.title != blank %}
      <h2 class="sf-tm-title">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.subtitle != blank %}
      <p class="sf-tm-subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>

  {%- comment -%} Rating bar {%- endcomment -%}
  {% if section.settings.rating_text != blank %}
    <div class="sf-tm-rating-bar sf-reveal">
      <div class="sf-tm-stars" aria-hidden="true">
        {% for i in (1..5) %}<svg width="18" height="18" viewBox="0 0 18 18" fill="var(--color-accent)"><path d="M9 1L11.09 6.26L17 6.27L12.45 9.97L14.18 15.23L9 12L3.82 15.23L5.55 9.97L1 6.27L6.91 6.26L9 1Z"/></svg>{% endfor %}
      </div>
      <span class="sf-tm-rating-text">{{ section.settings.rating_text }}</span>
    </div>
  {% endif %}

  {%- comment -%} Marquee Row {%- endcomment -%}
  <div class="sf-tm-marquee-wrapper sf-reveal">
    <div class="sf-tm-marquee sf-tm-marquee-left">
      {%- comment -%} Two copies for seamless loop {%- endcomment -%}
      {% for pass in (1..2) %}
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <div class="sf-tm-card" {{ block.shopify_attributes }}>
              <div class="sf-tm-card-stars" aria-hidden="true">
                {% assign stars = block.settings.rating | default: 5 %}
                {% for i in (1..stars) %}<svg width="14" height="14" viewBox="0 0 18 18" fill="var(--color-accent)"><path d="M9 1L11.09 6.26L17 6.27L12.45 9.97L14.18 15.23L9 12L3.82 15.23L5.55 9.97L1 6.27L6.91 6.26L9 1Z"/></svg>{% endfor %}
              </div>
              {% if block.settings.text != blank %}
                <blockquote class="sf-tm-quote">&ldquo;{{ block.settings.text }}&rdquo;</blockquote>
              {% endif %}
              <div class="sf-tm-author">
                {% assign img_src = block.settings.avatar %}
                {% if img_src != blank %}
                  <img class="sf-tm-avatar" src="{{ img_src | image_url: width: 160, height: 160 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="44" height="44">
                {% else %}
                  <div class="sf-tm-avatar sf-tm-avatar-initials">{{ block.settings.name | slice: 0 | upcase }}</div>
                {% endif %}
                <div>
                  <strong class="sf-tm-name">{{ block.settings.name }}</strong>
                  {% if block.settings.location != blank %}
                    <span class="sf-tm-location">{{ block.settings.location }}</span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          {%- comment -%} Default placeholder cards {%- endcomment -%}
          {% assign default_reviews = 'The craftsmanship is extraordinary. Each piece feels like it was made just for you.~Elevated, elegant, and timeless design. The quality exceeded every expectation.~Exceptional attention to detail. Truly a statement piece that receives endless compliments.' | split: '~' %}
          {% assign default_names = 'Sophia Laurent|London, UK~Elena Vance|New York, USA~Camilla Rossi|Milan, Italy' | split: '~' %}
          {% for item in default_reviews %}
            {% assign name_parts = default_names[forloop.index0] | split: '|' %}
            <div class="sf-tm-card">
              <div class="sf-tm-card-stars" aria-hidden="true">{% for j in (1..5) %}<svg width="14" height="14" viewBox="0 0 18 18" fill="var(--color-accent)"><path d="M9 1L11.09 6.26L17 6.27L12.45 9.97L14.18 15.23L9 12L3.82 15.23L5.55 9.97L1 6.27L6.91 6.26L9 1Z"/></svg>{% endfor %}</div>
              <blockquote class="sf-tm-quote">&ldquo;{{ item }}&rdquo;</blockquote>
              <div class="sf-tm-author">
                <div class="sf-tm-avatar sf-tm-avatar-initials">{{ name_parts[0] | slice: 0 }}</div>
                <div>
                  <strong class="sf-tm-name">{{ name_parts[0] }}</strong>
                  <span class="sf-tm-location">{{ name_parts[1] }}</span>
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {%- comment -%} Fade edges {%- endcomment -%}
  <div class="sf-tm-fade-left" aria-hidden="true"></div>
  <div class="sf-tm-fade-right" aria-hidden="true"></div>
</section>

<style>
  .sf-tm-{{ section.id }} {
    padding: var(--space-64, 6rem) 0;
    background: var(--color-background);
    position: relative;
    overflow: hidden;
    color: var(--color-text);
  }
  .sf-tm-header {
    text-align: center;
    margin-bottom: var(--space-40, 2.5rem);
    padding: 0 var(--space-20, 20px);
  }
  .sf-section-label {
    display: block;
    font-family: var(--font-body-family, sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-secondary, var(--color-text));
    margin-bottom: var(--space-12, 0.75rem);
  }
  .sf-tm-title {
    font-family: var(--font-heading-family, serif);
    font-weight: 400;
    font-size: var(--font-h2, clamp(1.8rem, 3.5vw, 2.8rem));
    color: var(--color-text);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-12, 0.75rem);
  }
  .sf-tm-subtitle {
    color: var(--color-text-secondary, var(--color-text));
    font-family: var(--font-body-family, sans-serif);
    font-size: var(--font-body, 0.95rem);
    max-width: 480px;
    margin: 0 auto;
    line-height: var(--leading-body, 1.6);
  }
  .sf-tm-rating-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-12, 12px);
    margin-bottom: var(--space-48, 3rem);
  }
  .sf-tm-stars { display: flex; gap: 4px; }
  .sf-tm-rating-text {
    font-family: var(--font-body-family, sans-serif);
    font-size: var(--font-small, 0.8rem);
    color: var(--color-text-secondary, var(--color-text));
    letter-spacing: 0.04em;
  }
  .sf-tm-marquee-wrapper { overflow: hidden; }
  .sf-tm-marquee {
    display: flex;
    width: max-content;
    animation: sfMarqueeLeft 45s linear infinite;
  }
  .sf-tm-marquee:hover { animation-play-state: paused; }
  @keyframes sfMarqueeLeft {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .sf-tm-card {
    flex-shrink: 0;
    width: 360px;
    margin-right: var(--space-24, 1.5rem);
    padding: var(--space-32, 2rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius, 8px);
    transition: border-color 0.4s ease, box-shadow 0.4s ease;
  }
  .sf-tm-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 12px 24px color-mix(in srgb, var(--color-text) 5%, transparent);
  }
  .sf-tm-card-stars { display: flex; gap: 3px; margin-bottom: var(--space-16, 1rem); }
  .sf-tm-quote {
    font-family: var(--font-heading-family, serif);
    font-style: italic;
    font-size: 1rem;
    line-height: var(--leading-body, 1.7);
    color: var(--color-text);
    margin-bottom: var(--space-24, 1.5rem);
    border: none;
    padding: 0;
  }
  .sf-tm-author { display: flex; align-items: center; gap: 12px; }
  .sf-tm-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
    flex-shrink: 0;
  }
  .sf-tm-avatar-initials {
    background: var(--color-background);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading-family, serif);
    font-size: 1.1rem;
    color: var(--color-text);
  }
  .sf-tm-name {
    display: block;
    font-family: var(--font-body-family, sans-serif);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 2px;
  }
  .sf-tm-location {
    display: block;
    font-family: var(--font-body-family, sans-serif);
    font-size: 0.725rem;
    color: var(--color-text-secondary, var(--color-text));
    letter-spacing: 0.04em;
  }
  .sf-tm-fade-left, .sf-tm-fade-right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 140px;
    z-index: 2;
    pointer-events: none;
  }
  .sf-tm-fade-left {
    left: 0;
    background: linear-gradient(90deg, var(--color-background), transparent);
  }
  .sf-tm-fade-right {
    right: 0;
    background: linear-gradient(-90deg, var(--color-background), transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .sf-tm-marquee { animation: none !important; }
  }
</style>

{% schema %}
{
  "name": "Testimonials Marquee",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow Label", "default": "Client Stories" },
    { "type": "text", "id": "title", "label": "Title", "default": "Worn By The Discerning" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Discover why our clients cherish their signature creations across the globe." },
    { "type": "text", "id": "rating_text", "label": "Rating Summary", "default": "4.9 / 5 · Verified Client Reviews" }
  ],
  "blocks": [
    {
      "name": "Review",
      "type": "review",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Review Text", "default": "The craftsmanship is extraordinary. Each detail feels tailored and timeless." },
        { "type": "text", "id": "name", "label": "Customer Name", "default": "Sophia Laurent" },
        { "type": "text", "id": "location", "label": "Location", "default": "London, UK" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
        { "type": "image_picker", "id": "avatar", "label": "Customer Photo", "info": "Placeholder — replace with your own image" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "Testimonials Marquee", "category": "Testimonials" }]
}
{% endschema %}
