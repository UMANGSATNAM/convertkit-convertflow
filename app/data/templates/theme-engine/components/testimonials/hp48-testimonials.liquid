{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp48-test-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
    --hp48-gold: {{ section.settings.accent_gold | default: '#C59B27' }};
    
    background-color: var(--hp48-test-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp48-test__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp48-test__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp48-test__heading {
    font-family: 'Cinzel', serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 700;
    color: #1A1715;
    margin: 0 0 8px;
  }

  .hp48-test__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp48-test__card {
    background: #FFFFFF;
    border: 1px solid rgba(197, 155, 39, 0.3);
    border-radius: 8px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 30px rgba(26, 23, 21, 0.04);
  }

  .hp48-test__stars {
    color: var(--hp48-gold);
    font-size: 18px;
    margin-bottom: 16px;
    letter-spacing: 2px;
  }

  .hp48-test__quote {
    font-size: 14px;
    line-height: 1.8;
    color: #1A1715;
    margin: 0 0 24px;
    font-style: italic;
  }

  .hp48-test__author-row {
    border-top: 1px solid rgba(197, 155, 39, 0.2);
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp48-test__author {
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #1A1715;
    letter-spacing: 0.5px;
  }

  .hp48-test__verified {
    font-size: 11px;
    font-weight: 700;
    color: var(--hp48-gold);
    text-transform: uppercase;
  }

  @media screen and (max-width: 992px) {
    .hp48-test__grid { grid-template-columns: 1fr; max-width: 500px; margin: 0 auto; }
  }
{%- endstyle -%}

<div class="hp48-test__wrap">
  <div class="hp48-test__header">
    <h2 class="hp48-test__heading">{{ section.settings.heading | default: 'Patron Accolades & Testimonials' }}</h2>
    <p style="font-size:13px; color:#5C554E; letter-spacing:0.5px;">{{ section.settings.subheading | default: 'Unsolicited reflections from our global VIP clientele.' }}</p>
  </div>

  <div class="hp48-test__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp48-test__card" {{ block.shopify_attributes }}>
          <div>
            <div class="hp48-test__stars">★★★★★</div>
            <p class="hp48-test__quote">"{{ block.settings.quote }}"</p>
          </div>
          <div class="hp48-test__author-row">
            <span class="hp48-test__author">{{ block.settings.author }}</span>
            <span class="hp48-test__verified">✓ Sovereign Patron</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp48-test__card">
        <div>
          <div class="hp48-test__stars">★★★★★</div>
          <p class="hp48-test__quote">"The 24K gold cellular nectar transformed my skin tone within ten evenings. Luminous, firm, and radiant beyond expectations."</p>
        </div>
        <div class="hp48-test__author-row">
          <span class="hp48-test__author">LADY BEATRICE MONTAGUE</span>
          <span class="hp48-test__verified">✓ London</span>
        </div>
      </div>
      <div class="hp48-test__card">
        <div>
          <div class="hp48-test__stars">★★★★★</div>
          <p class="hp48-test__quote">"The white truffle and champagne pearl crème has replaced all other luxury jars on my dressing table. Remarkable texture."</p>
        </div>
        <div class="hp48-test__author-row">
          <span class="hp48-test__author">COUNTESS ELEONORA DE VAUD</span>
          <span class="hp48-test__verified">✓ Geneva</span>
        </div>
      </div>
      <div class="hp48-test__card">
        <div>
          <div class="hp48-test__stars">★★★★★</div>
          <p class="hp48-test__quote">"Impeccable gold-embossed packaging and seamless diplomatic courier delivery directly to our private villa in Dubai."</p>
        </div>
        <div class="hp48-test__author-row">
          <span class="hp48-test__author">AMIRA AL-SABAH</span>
          <span class="hp48-test__verified">✓ Dubai</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP48 - Royal Test",
  "class": "section-hp48-testimonials",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF8F5" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#C59B27" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Patron Accolades & Testimonials" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Unsolicited reflections from our global VIP clientele." },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Item",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The 24K gold cellular nectar transformed my skin." },
        { "type": "text", "id": "author", "label": "Author Name", "default": "LADY BEATRICE MONTAGUE" }
      ]
    }
  ],
  "presets": [
    { "name": "HP48 - Royal Test" }
  ]
}
{% endschema %}
