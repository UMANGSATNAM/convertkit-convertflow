{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: "#080B10" }};
    padding: 90px 20px;
  }

  .hp43-test__title {
    font-family: 'Orbitron', sans-serif;
    font-size: 32px;
    font-weight: 800;
    color: #F1F5F9;
    text-align: center;
    margin: 0 0 50px;
    text-transform: uppercase;
  }

  .hp43-test__grid {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .hp43-test__card {
    background: #101622;
    border: 1px solid #1E293B;
    border-radius: 6px;
    padding: 32px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .hp43-test__badge {
    display: inline-block;
    padding: 4px 10px;
    background: rgba(0, 240, 255, 0.1);
    border: 1px solid #00F0FF;
    color: #00F0FF;
    font-family: 'Rajdhani', sans-serif;
    font-size: 12px;
    font-weight: 700;
    border-radius: 3px;
    margin-bottom: 16px;
  }

  .hp43-test__quote {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: #F1F5F9;
    line-height: 1.6;
    margin: 0 0 24px;
  }

  .hp43-test__user {
    font-family: 'Orbitron', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #F1F5F9;
  }

  .hp43-test__meta {
    font-family: 'Rajdhani', sans-serif;
    font-size: 13px;
    color: #64748B;
  }

  @media screen and (max-width: 900px) {
    .hp43-test__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="hp43-test__title">VERIFIED PRO TRANSMISSIONS</div>

<div class="hp43-test__grid">
  <div class="hp43-test__card">
    <div class="hp43-test__badge">VERIFIED ESPORTS CAPTAIN</div>
    <p class="hp43-test__quote">"Switched our entire team to these boards. The tactile precision and latency response are unmatched in tournament play."</p>
    <div class="hp43-test__user">ALEX "VORTEX" KOVALEV</div>
    <div class="hp43-test__meta">PRO LEAGUE PLAYER // SEOUL</div>
  </div>

  <div class="hp43-test__card">
    <div class="hp43-test__badge">VERIFIED AUDIO ENGINEER</div>
    <p class="hp43-test__quote">"Frequency response is ruler-flat. Studio monitoring with ANC has never been this crisp during long mixing sessions."</p>
    <div class="hp43-test__user">MARCUS VANCE</div>
    <div class="hp43-test__meta">SOUND PRODUCER // LOS ANGELES</div>
  </div>

  <div class="hp43-test__card">
    <div class="hp43-test__badge">VERIFIED TACTICAL TRAVELER</div>
    <p class="hp43-test__quote">"Dispatched to Munich in 48 hours. Waterproof seal and internal shock pads kept my gear completely safe."</p>
    <div class="hp43-test__user">SARAH BENNETT</div>
    <div class="hp43-test__meta">GEAR ANALYST // LONDON</div>
  </div>
</div>

{% schema %}
{
  "name": "HP43 - Cyber Reviews",
  "class": "section-hp43-reviews",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#080B10"
    }
  ],
  "presets": [
    {
      "name": "HP43 - Cyber Reviews"
    }
  ]
}
{% endschema %}
