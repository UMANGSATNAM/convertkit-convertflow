{%- liquid
  assign bg_color = section.settings.bg_color | default: '#f9f6f0'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp4-test-bg: {{ bg_color }};
    --hp4-test-text: {{ text_color }};
    --hp4-test-accent: {{ accent_color }};
    
    --hp4-test-pt-desk: {{ padding_top_desktop }}px;
    --hp4-test-pb-desk: {{ padding_bottom_desktop }}px;
    --hp4-test-pt-mob: {{ padding_top_mobile }}px;
    --hp4-test-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp4-decor-test-{{ section.id }} {
    padding-top: var(--hp4-test-pt-desk);
    padding-bottom: var(--hp4-test-pb-desk);
    background-color: var(--hp4-test-bg);
    color: var(--hp4-test-text);
    font-family: 'Inter', sans-serif;
  }

  .hp4-test-inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
  }

  .hp4-test-header {
    margin-bottom: 60px;
  }

  .hp4-test-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400;
    margin: 0;
  }
  .hp4-test-title em { font-style: italic; }

  /* Carousel */
  .hp4-test-carousel-wrap {
    position: relative;
  }

  .hp4-test-carousel {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    gap: 40px;
  }
  .hp4-test-carousel::-webkit-scrollbar { display: none; }

  .hp4-test-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hp4-test-stars {
    display: flex;
    gap: 5px;
    color: var(--hp4-test-accent);
    margin-bottom: 30px;
  }
  .hp4-test-stars svg { width: 24px; height: 24px; fill: currentColor; }

  .hp4-test-quote {
    font-family: 'Playfair Display', serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
    font-style: italic;
    line-height: 1.4;
    margin: 0 0 40px 0;
  }

  .hp4-test-author {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .hp4-test-avatar {
    width: 60px; height: 60px;
    border-radius: 50%;
    background: #e8e3d8;
    overflow: hidden;
  }
  .hp4-test-avatar img {
    width: 100%; height: 100%; object-fit: cover;
  }

  .hp4-test-meta {
    text-align: left;
  }
  .hp4-test-name {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 2px 0;
  }
  .hp4-test-verified {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: rgba(44,44,44,0.5);
  }

  /* Nav Dots */
  .hp4-test-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 50px;
  }
  .hp4-test-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: rgba(44,44,44,0.2);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .hp4-test-dot.active {
    background: var(--hp4-test-text);
    transform: scale(1.2);
  }

  @media screen and (max-width: 768px) {
    .hp4-decor-test-{{ section.id }} {
      padding-top: var(--hp4-test-pt-mob);
      padding-bottom: var(--hp4-test-pb-mob);
    }
    .hp4-test-inner {
      padding: 0 20px;
    }
    .hp4-test-quote {
      font-size: 20px;
    }
    .hp4-test-stars svg { width: 20px; height: 20px; }
  }
</style>

<section class="hp4-decor-test-{{ section.id }}" aria-label="Testimonials">
  <div class="hp4-test-inner">
    
    {%- if section.settings.heading != blank -%}
      <div class="hp4-test-header">
        <h2 class="hp4-test-title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="hp4-test-carousel-wrap">
      <div class="hp4-test-carousel" id="hp4-test-carousel-{{ section.id }}">
        
        {%- for block in section.blocks -%}
          <div class="hp4-test-slide" {{ block.shopify_attributes }}>
            <div class="hp4-test-stars">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              {%- endfor -%}
            </div>
            
            <blockquote class="hp4-test-quote">
              "{{ block.settings.quote }}"
            </blockquote>
            
            <div class="hp4-test-author">
              {%- if block.settings.image != blank -%}
                <div class="hp4-test-avatar">
                  <img src="{{ block.settings.image | image_url: width: 120 }}" alt="{{ block.settings.author }}">
                </div>
              {%- endif -%}
              <div class="hp4-test-meta">
                <p class="hp4-test-name">{{ block.settings.author }}</p>
                <span class="hp4-test-verified">Verified Buyer</span>
              </div>
            </div>
          </div>
        {%- endfor -%}

        {%- if section.blocks.size == 0 -%}
          {%- for i in (1..3) -%}
            <div class="hp4-test-slide">
              <div class="hp4-test-stars">
                <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              </div>
              <blockquote class="hp4-test-quote">
                "The quality and craftsmanship of these pieces transformed my living room entirely. Truly an investment in beautiful living."
              </blockquote>
              <div class="hp4-test-author">
                <div class="hp4-test-meta">
                  <p class="hp4-test-name">Eleanor V.</p>
                  <span class="hp4-test-verified">Verified Buyer</span>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}

      </div>

      <div class="hp4-test-dots" id="hp4-test-dots-{{ section.id }}">
        {%- assign loop_count = section.blocks.size | default: 3 -%}
        {%- for i in (1..loop_count) -%}
          <button class="hp4-test-dot {% if forloop.first %}active{% endif %}" aria-label="Slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const carousel = document.getElementById('hp4-test-carousel-{{ section.id }}');
    const dots = document.querySelectorAll('#hp4-test-dots-{{ section.id }} .hp4-test-dot');
    
    if(carousel && dots.length) {
      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          const slideWidth = carousel.offsetWidth;
          carousel.scrollTo({ left: slideWidth * index, behavior: 'smooth' });
          dots.forEach(d => d.classList.remove('active'));
          dot.classList.add('active');
        });
      });
      
      carousel.addEventListener('scroll', () => {
        const index = Math.round(carousel.scrollLeft / carousel.offsetWidth);
        if(dots[index]) {
          dots.forEach(d => d.classList.remove('active'));
          dots[index].classList.add('active');
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP4 Decor Testimonials",
  "tag": "section",
  "class": "section-hp4-testimonials",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Words from our <em>Community</em>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f6f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Star Color",
      "default": "#d4af37"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The quality and craftsmanship of these pieces transformed my living room entirely."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Eleanor V."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author Photo (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP4 Decor Testimonials",
      "category": "Social Proof",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
