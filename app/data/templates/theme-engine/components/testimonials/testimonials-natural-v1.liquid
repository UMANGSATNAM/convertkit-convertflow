{%- comment -%}
  Component: testimonials-natural-home-v1
  Family: Home | Style: natural
  Archetypes: cozy, artisanal
  v2.0 — StoreForge Component Library
{%- endcomment -%}
<section class="testimonials testimonials--home-decor" style="padding: var(--space-80) 0; background-color: var(--color-surface); border-bottom: 1px solid var(--color-border); text-align: center;">
  <div class="container" style="max-width: 800px;">
    
    {%- if section.settings.title != blank -%}
    <h2 class="section-title" style="font-family: var(--font-heading-family); font-size: 2.5rem; font-weight: 500; margin-bottom: var(--space-48); color: var(--color-text);">
      {{ section.settings.title | escape }}
    </h2>
    {%- endif -%}

    <div class="testimonials-slider" style="display: flex; flex-direction: column; gap: var(--space-32);">
      {%- for block in section.blocks -%}
        <div class="testimonial-block" {{ block.shopify_attributes }} 
             style="border: 1px solid var(--color-border); border-radius: var(--card-radius); box-shadow: var(--card-shadow); background-color: var(--color-background); padding: var(--space-40); text-align: center;">
          
          <div class="testimonial-rating" style="display: flex; justify-content: center; gap: 6px; margin-bottom: var(--space-20); color: var(--color-sale-accent);">
            {%- assign rating = block.settings.rating -%}
            {%- for i in (1..5) -%}
              {%- if i <= rating -%}
                {%- render 'icon-star', filled: true -%}
              {%- else -%}
                {%- render 'icon-star', filled: false -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
          
          <blockquote class="testimonial-quote" style="font-family: var(--font-heading-family); font-size: 1.3rem; font-style: italic; line-height: 1.7; color: var(--color-text); margin: 0 0 var(--space-20) 0; font-weight: 400;">
            {{ block.settings.quote }}
          </blockquote>
          
          <cite class="testimonial-author" style="font-family: var(--font-body-family); font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent);">
            &mdash; {{ block.settings.author | escape }}
          </cite>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Customer Reviews"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Customer Name"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote Content",
          "default": "<p>A great experience with this store. Exceptional quality.</p>"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ]
}
{% endschema %}
