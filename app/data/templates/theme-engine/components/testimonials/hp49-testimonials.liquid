{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp49-test-bg: {{ section.settings.bg_color | default: '#F5F3FF' }};
    --hp49-accent: {{ section.settings.accent_color | default: '#7C3AED' }};
    
    background-color: var(--hp49-test-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp49-test__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp49-test__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp49-test__heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 800;
    color: #2E1065;
    margin: 0 0 8px;
  }

  .hp49-test__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp49-test__card {
    background: #FFFFFF;
    border: 1px solid rgba(124, 58, 237, 0.15);
    border-radius: 28px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 30px rgba(124, 58, 237, 0.05);
  }

  .hp49-test__stars {
    color: var(--hp49-accent);
    font-size: 18px;
    margin-bottom: 16px;
    letter-spacing: 2px;
  }

  .hp49-test__quote {
    font-size: 15px;
    line-height: 1.7;
    color: #2E1065;
    margin: 0 0 24px;
    font-style: italic;
  }

  .hp49-test__author-row {
    border-top: 1px solid rgba(124, 58, 237, 0.15);
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp49-test__author {
    font-family: 'Urbanist', sans-serif;
    font-size: 14px;
    font-weight: 800;
    color: #2E1065;
  }

  .hp49-test__verified {
    font-size: 12px;
    font-weight: 800;
    color: var(--hp49-accent);
  }

  @media screen and (max-width: 992px) {
    .hp49-test__grid { grid-template-columns: 1fr; max-width: 500px; margin: 0 auto; }
  }
{%- endstyle -%}

<div class="hp49-test__wrap">
  <div class="hp49-test__header">
    <h2 class="hp49-test__heading">{{ section.settings.heading | default: 'Stories from Our Dream Community' }}</h2>
    <p style="font-size:14px; color:#5B21B6; opacity:0.85;">{{ section.settings.subheading | default: 'Pure feedback on skin calming, soothing barrier relief, and restorative sleep.' }}</p>
  </div>

  <div class="hp49-test__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp49-test__card" {{ block.shopify_attributes }}>
          <div>
            <div class="hp49-test__stars">★★★★★</div>
            <p class="hp49-test__quote">"{{ block.settings.quote }}"</p>
          </div>
          <div class="hp49-test__author-row">
            <span class="hp49-test__author">{{ block.settings.author }}</span>
            <span class="hp49-test__verified">✓ Verified Dreamer</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp49-test__card">
        <div>
          <div class="hp49-test__stars">★★★★★</div>
          <p class="hp49-test__quote">"The alpine lavender cloud serum feels like silk floating onto tired skin. It immediately cooled my reactive redness."</p>
        </div>
        <div class="hp49-test__author-row">
          <span class="hp49-test__author">CAMILLE LAURENT</span>
          <span class="hp49-test__verified">✓ Verified</span>
        </div>
      </div>
      <div class="hp49-test__card">
        <div>
          <div class="hp49-test__stars">★★★★★</div>
          <p class="hp49-test__quote">"The cherry blossom mist is a staple on my work desk. A couple of fine cloud spritzes keeps my complexion dewy all day."</p>
        </div>
        <div class="hp49-test__author-row">
          <span class="hp49-test__author">AMÉLIE DUPONT</span>
          <span class="hp49-test__verified">✓ Verified</span>
        </div>
      </div>
      <div class="hp49-test__card">
        <div>
          <div class="hp49-test__stars">★★★★★</div>
          <p class="hp49-test__quote">"Sleeping with the lilac pillow mask is pure bliss. I wake up with soft, plump, radiant skin every single morning."</p>
        </div>
        <div class="hp49-test__author-row">
          <span class="hp49-test__author">CHLOÉ MOREAU</span>
          <span class="hp49-test__verified">✓ Verified</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP49 - Lavender Test",
  "class": "section-hp49-testimonials",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F3FF" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#7C3AED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories from Our Dream Community" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pure feedback on skin calming, soothing barrier relief, and restorative sleep." },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Item",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The alpine lavender cloud serum feels like silk." },
        { "type": "text", "id": "author", "label": "Author Name", "default": "CAMILLE LAURENT" }
      ]
    }
  ],
  "presets": [
    { "name": "HP49 - Lavender Test" }
  ]
}
{% endschema %}
