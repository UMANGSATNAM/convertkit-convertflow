{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
  assign card_bg = section.settings.card_bg | default: '#ffffff'
  assign border_color = section.settings.border_color | default: '#000000'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp2-test-bg: {{ bg_color }};
    --hp2-test-text: {{ text_color }};
    --hp2-test-card: {{ card_bg }};
    --hp2-test-border: {{ border_color }};
    
    --hp2-test-pt-desk: {{ padding_top_desktop }}px;
    --hp2-test-pb-desk: {{ padding_bottom_desktop }}px;
    --hp2-test-pt-mob: {{ padding_top_mobile }}px;
    --hp2-test-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp2-fashion-testimonials-{{ section.id }} {
    padding-top: var(--hp2-test-pt-desk);
    padding-bottom: var(--hp2-test-pb-desk);
    background-color: var(--hp2-test-bg);
    color: var(--hp2-test-text);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .hp2-test-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }
  
  .hp2-test-header {
    margin-bottom: 50px;
    text-align: center;
  }

  .hp2-test-title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -1px;
    margin: 0;
  }

  .hp2-test-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .hp2-test-card {
    background: var(--hp2-test-card);
    border: 2px solid var(--hp2-test-border);
    padding: 40px;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hp2-test-card:hover {
    transform: translateY(-5px);
    box-shadow: 8px 8px 0px var(--hp2-test-border);
  }

  .hp2-test-stars {
    display: flex;
    gap: 4px;
    margin-bottom: 20px;
    color: var(--hp2-test-text);
  }
  .hp2-test-stars svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .hp2-test-quote {
    font-size: 16px;
    line-height: 1.6;
    font-weight: 500;
    margin: 0 0 30px 0;
    flex-grow: 1;
  }

  .hp2-test-author-row {
    display: flex;
    align-items: center;
    gap: 15px;
    border-top: 1px solid var(--hp2-test-border);
    padding-top: 20px;
  }

  .hp2-test-author-img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--hp2-test-border);
  }
  .hp2-test-author-initial {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--hp2-test-text);
    color: var(--hp2-test-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 16px;
  }

  .hp2-test-author-info {
    display: flex;
    flex-direction: column;
  }

  .hp2-test-author-name {
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    margin: 0;
  }

  .hp2-test-author-verified {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.6;
  }

  @media screen and (max-width: 991px) {
    .hp2-test-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media screen and (max-width: 768px) {
    .hp2-fashion-testimonials-{{ section.id }} {
      padding-top: var(--hp2-test-pt-mob);
      padding-bottom: var(--hp2-test-pb-mob);
    }
    .hp2-test-inner { padding: 0 20px; }
    
    .hp2-test-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      margin: 0 -20px;
      padding: 0 20px 20px;
      gap: 15px;
    }
    .hp2-test-card {
      flex: 0 0 85%;
      scroll-snap-align: center;
      padding: 30px 20px;
    }
    /* disable hover state on mobile */
    .hp2-test-card:hover {
      transform: none;
      box-shadow: none;
    }
  }
</style>

<section class="hp2-fashion-testimonials-{{ section.id }}" aria-label="Customer Reviews">
  <div class="hp2-test-inner">
    
    {%- if section.settings.heading != blank -%}
      <div class="hp2-test-header">
        <h2 class="hp2-test-title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="hp2-test-grid">
      {%- for block in section.blocks -%}
        <div class="hp2-test-card" {{ block.shopify_attributes }}>
          
          <div class="hp2-test-stars" aria-label="{{ block.settings.stars }} out of 5 stars">
            {%- for i in (1..5) -%}
              {%- if i <= block.settings.stars -%}
                <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <p class="hp2-test-quote">"{{ block.settings.quote }}"</p>

          <div class="hp2-test-author-row">
            {%- if block.settings.image != blank -%}
              <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 80 }}" class="hp2-test-author-img" alt="{{ block.settings.author }}" loading="lazy">
            {%- else -%}
              <div class="hp2-test-author-initial">{{ block.settings.author | slice: 0, 1 | upcase }}</div>
            {%- endif -%}
            
            <div class="hp2-test-author-info">
              <span class="hp2-test-author-name">{{ block.settings.author }}</span>
              {%- if block.settings.verified -%}
                <span class="hp2-test-author-verified">Verified Buyer</span>
              {%- endif -%}
            </div>
          </div>

        </div>
      {%- endfor -%}
      
      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..3) -%}
          <div class="hp2-test-card">
            <div class="hp2-test-stars">
              {%- for j in (1..5) -%}<svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{%- endfor -%}
            </div>
            <p class="hp2-test-quote">"The quality and fit are unmatched. This is exactly what I've been looking for in modern streetwear."</p>
            <div class="hp2-test-author-row">
              <div class="hp2-test-author-initial">J</div>
              <div class="hp2-test-author-info">
                <span class="hp2-test-author-name">John Doe</span>
                <span class="hp2-test-author-verified">Verified Buyer</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP2 Testimonials",
  "tag": "section",
  "class": "section-hp2-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WORDS FROM THE STREET"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Stars Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border & Shadow Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Text",
          "default": "Incredible quality and fit."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Alex M."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author Photo (Optional)"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show 'Verified Buyer'",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP2 Testimonials (Advanced)",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
