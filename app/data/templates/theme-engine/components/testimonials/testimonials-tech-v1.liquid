{%- comment -%}
  Component: testimonials-tech-electronics-v1
  Family: Tech | Style: tech
  Archetypes: gaming, gadgets
  v2.0 — StoreForge Component Library
{%- endcomment -%}
<section class="testimonials testimonials--electronics" style="padding: var(--space-64) 0; background-color: var(--color-surface); border-bottom: 1px solid var(--color-border); text-align: center;">
  <div class="container" style="max-width: 800px;">
    
    {%- if section.settings.title != blank -%}
    <h2 class="section-title" style="font-family: var(--font-heading-family); font-size: 2.5rem; font-weight: 700; text-transform: uppercase; margin-bottom: var(--space-40); color: #fff;">
      {{ section.settings.title | escape }}
    </h2>
    {%- endif -%}

    <div class="testimonials-slider" style="display: flex; flex-direction: column; gap: var(--space-24);">
      {%- for block in section.blocks -%}
        <div class="testimonial-block" {{ block.shopify_attributes }} 
             style="border: 1px solid var(--color-border); border-radius: var(--card-radius); background-color: var(--color-background); padding: var(--space-32); text-align: left; box-shadow: var(--card-shadow);">
          
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-16); flex-wrap: wrap; gap: var(--space-8);">
            <cite class="testimonial-author" style="font-family: var(--font-heading-family); font-size: 1.15rem; font-weight: 700; text-transform: uppercase; color: var(--color-text);">
              {{ block.settings.author | escape }}
            </cite>
            <div class="testimonial-rating" style="display: flex; gap: 2px; color: var(--color-accent);">
              {%- assign rating = block.settings.rating -%}
              {%- for i in (1..5) -%}
                {%- if i <= rating -%}
                  {%- render 'icon-star', filled: true -%}
                {%- else -%}
                  {%- render 'icon-star', filled: false -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
          
          <blockquote class="testimonial-quote" style="font-family: var(--font-body-family); font-size: 0.95rem; line-height: 1.6; color: #94a3b8; margin: 0; font-weight: 400;">
            {{ block.settings.quote }}
          </blockquote>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Customer Reviews"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Customer Name"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote Content",
          "default": "<p>A great experience with this store. Exceptional quality.</p>"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ]
}
{% endschema %}
