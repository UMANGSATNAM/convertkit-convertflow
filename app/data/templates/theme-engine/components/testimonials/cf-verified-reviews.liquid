{% comment %}
  CF Verified Customer Reviews - High-Converting 3-Column Social Proof Grid
  Category: testimonials
  Version: 2.0 - Shopify 2.0 Dynamic Blocks with Fallback
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding: clamp(48px, 7vw, 96px) 20px;
    background: {{ section.settings.bg_color | default: '#f8fafc' }};
    font-family: inherit;
  }

  .cf-rev-inner {
    max-width: 1240px;
    margin: 0 auto;
  }

  .cf-rev-header {
    text-align: center;
    margin-bottom: clamp(36px, 5vw, 60px);
  }

  .cf-rev-rating-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 800;
    color: #0f172a;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    margin-bottom: 16px;
  }

  .cf-rev-stars {
    color: #f59e0b;
    letter-spacing: 2px;
    font-size: 14px;
  }

  .cf-rev-heading {
    font-size: clamp(26px, 4.5vw, 42px);
    font-weight: 850;
    color: #0f172a;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 12px 0;
  }

  .cf-rev-subheading {
    font-size: clamp(14px, 1.6vw, 16px);
    color: #64748b;
    max-width: 580px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Grid of Reviews */
  .cf-rev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 960px) {
    .cf-rev-grid {
      grid-template-columns: 1fr;
      max-width: 580px;
      margin: 0 auto;
    }
  }

  .cf-rev-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .cf-rev-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 35px -10px rgba(15, 23, 42, 0.09);
    border-color: #cbd5e1;
  }

  .cf-rev-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .cf-rev-card-stars {
    color: #f59e0b;
    font-size: 15px;
    letter-spacing: 1.5px;
  }

  .cf-rev-verified-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 800;
    color: #059669;
    background: #ecfdf5;
    border: 1px solid rgba(5, 150, 105, 0.2);
    padding: 3px 10px;
    border-radius: 999px;
  }

  .cf-rev-title {
    font-size: 16px;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 10px 0;
    line-height: 1.35;
  }

  .cf-rev-text {
    font-size: 14px;
    color: #475569;
    line-height: 1.6;
    margin: 0 0 24px 0;
  }

  .cf-rev-author-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 16px;
    border-top: 1px solid #f1f5f9;
  }

  .cf-rev-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    background: #e2e8f0;
    border: 2px solid #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .cf-rev-author-name {
    font-size: 14px;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 2px 0;
  }

  .cf-rev-author-location {
    font-size: 12px;
    color: #94a3b8;
    margin: 0;
    font-weight: 500;
  }
{%- endstyle -%}

<div class="cf-rev-inner">
  <div class="cf-rev-header">
    <div class="cf-rev-rating-badge">
      <span class="cf-rev-stars">★★★★★</span>
      <span>{{ section.settings.score_text | default: '4.92 / 5.0 (3,400+ Verified Buyers)' }}</span>
    </div>
    <h2 class="cf-rev-heading">{{ section.settings.heading | default: 'Real Stories, Real Results' }}</h2>
    <p class="cf-rev-subheading">{{ section.settings.subheading | default: 'See what daily users have to say about their real experiences.' }}</p>
  </div>

  <div class="cf-rev-grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <div class="cf-rev-card" {{ block.shopify_attributes }}>
          <div>
            <div class="cf-rev-card-top">
              <span class="cf-rev-card-stars">{{ block.settings.stars | default: '★★★★★' }}</span>
              <span class="cf-rev-verified-pill">✓ Verified Buyer</span>
            </div>
            <h3 class="cf-rev-title">{{ block.settings.title }}</h3>
            <p class="cf-rev-text">{{ block.settings.text }}</p>
          </div>
          <div class="cf-rev-author-row">
            <img src="{{ block.settings.avatar_url | default: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&q=80' }}" alt="{{ block.settings.author_name }}" class="cf-rev-avatar" width="44" height="44">
            <div>
              <h4 class="cf-rev-author-name">{{ block.settings.author_name }}</h4>
              <p class="cf-rev-author-location">{{ block.settings.author_location }} · Verified Purchase</p>
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <!-- Fallback Review 1 -->
      <div class="cf-rev-card">
        <div>
          <div class="cf-rev-card-top">
            <span class="cf-rev-card-stars">★★★★★</span>
            <span class="cf-rev-verified-pill">✓ Verified Buyer</span>
          </div>
          <h3 class="cf-rev-title">{{ section.settings.rev_1_title | default: 'Best addition to my routine in years!' }}</h3>
          <p class="cf-rev-text">{{ section.settings.rev_1_text | default: 'Within just 10 days, I noticed a dramatic shift in hydration and tone. My skin feels bouncy, radiant, and totally calm. Will never switch back!' }}</p>
        </div>
        <div class="cf-rev-author-row">
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&q=80" alt="Sarah M." class="cf-rev-avatar" width="44" height="44">
          <div>
            <h4 class="cf-rev-author-name">Sarah M.</h4>
            <p class="cf-rev-author-location">New York, NY · Verified Purchase</p>
          </div>
        </div>
      </div>

      <!-- Fallback Review 2 -->
      <div class="cf-rev-card">
        <div>
          <div class="cf-rev-card-top">
            <span class="cf-rev-card-stars">★★★★★</span>
            <span class="cf-rev-verified-pill">✓ Verified Buyer</span>
          </div>
          <h3 class="cf-rev-title">{{ section.settings.rev_2_title | default: 'Incredible texture and zero irritation.' }}</h3>
          <p class="cf-rev-text">{{ section.settings.rev_2_text | default: 'I was very skeptical because of my reactive, sensitive skin. It absorbed within seconds without any greasiness. The glow is real!' }}</p>
        </div>
        <div class="cf-rev-author-row">
          <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&q=80" alt="David K." class="cf-rev-avatar" width="44" height="44">
          <div>
            <h4 class="cf-rev-author-name">David K.</h4>
            <p class="cf-rev-author-location">Austin, TX · Verified Purchase</p>
          </div>
        </div>
      </div>

      <!-- Fallback Review 3 -->
      <div class="cf-rev-card">
        <div>
          <div class="cf-rev-card-top">
            <span class="cf-rev-card-stars">★★★★★</span>
            <span class="cf-rev-verified-pill">✓ Verified Buyer</span>
          </div>
          <h3 class="cf-rev-title">{{ section.settings.rev_3_title | default: 'Already ordering my third bottle!' }}</h3>
          <p class="cf-rev-text">{{ section.settings.rev_3_text | default: 'Shipping was super fast (2 days), packaging is 100% sustainable glass, and customer support answered my ingredient question in 5 minutes. 10/10.' }}</p>
        </div>
        <div class="cf-rev-author-row">
          <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=100&q=80" alt="Elena R." class="cf-rev-avatar" width="44" height="44">
          <div>
            <h4 class="cf-rev-author-name">Elena R.</h4>
            <p class="cf-rev-author-location">Seattle, WA · Verified Purchase</p>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

