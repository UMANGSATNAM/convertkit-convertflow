{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp56-test__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp56-test__header { text-align: center; margin-bottom: 50px; }
  .hp56-test__eyebrow { font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #0284C7; margin: 0 0 12px; }
  .hp56-test__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; color: #082F49; margin: 0; }
  .hp56-test__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 20px; }
  .hp56-test__card { background: #F0F9FF; border: 1px solid rgba(2, 132, 199, 0.12); border-radius: 14px; padding: 32px 24px; }
  .hp56-test__stars { color: #F59E0B; font-size: 16px; margin-bottom: 16px; letter-spacing: 2px; }
  .hp56-test__quote { font-size: 15px; line-height: 1.6; color: #1E293B; margin: 0 0 20px; font-weight: 500; }
  .hp56-test__author { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; color: #082F49; margin: 0; }
  .hp56-test__role { font-size: 11px; color: #0284C7; margin: 4px 0 0; letter-spacing: 1px; text-transform: uppercase; }
  @media screen and (max-width: 992px) { .hp56-test__grid { grid-template-columns: 1fr; max-width: 600px; margin: 0 auto; } }
{%- endstyle -%}
<div class="hp56-test__container">
  <div class="hp56-test__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp56-test__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp56-test__heading">{{ section.settings.heading | default: 'Nordic Clinical Praise' }}</h2>
  </div>
  <div class="hp56-test__grid">
    {%- for block in section.blocks -%}
      <div class="hp56-test__card" {{ block.shopify_attributes }}>
        <div class="hp56-test__stars">{{ block.settings.stars | default: '★★★★★' }}</div>
        <p class="hp56-test__quote">"{{ block.settings.quote | default: 'My chronic dry patches disappeared in 3 days. The cloudberry serum is revolutionary.' }}"</p>
        <p class="hp56-test__author">{{ block.settings.author | default: 'Astrid L.' }}</p>
        <p class="hp56-test__role">{{ block.settings.role | default: 'Stockholm, Sweden' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP56 Reviews",
  "class": "section-hp56-test",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "❄️ TESTIMONIALS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nordic Clinical Praise" },
    { "type": "range", "id": "columns", "min": 1, "max": 3, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "testimonial", "name": "Review", "settings": [
    { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "My chronic dry patches disappeared in 3 days." },
    { "type": "text", "id": "author", "label": "Author", "default": "Astrid L." },
    { "type": "text", "id": "role", "label": "Role", "default": "Stockholm, Sweden" }
  ]}],
  "presets": [{ "name": "HP56 Reviews", "blocks": [
    { "type": "testimonial" },
    { "type": "testimonial", "settings": { "quote": "Living in Oslo, winter ruins my skin. This Arctic line saved my barrier completely.", "author": "Freja N.", "role": "Oslo, Norway" } },
    { "type": "testimonial", "settings": { "quote": "The birch sap mist instantly calms redness and irritation. 10/10.", "author": "Elin K.", "role": "Helsinki, Finland" } }
  ]}]
}
{% endschema %}
