{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#030712' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp64-test__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp64-test__header { text-align: center; margin-bottom: 50px; }
  .hp64-test__eyebrow { font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #06B6D4; margin: 0 0 12px; }
  .hp64-test__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; color: #FFFFFF; margin: 0; }
  .hp64-test__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 20px; }
  .hp64-test__card { background: #090D16; border: 1px solid rgba(6, 182, 212, 0.25); border-radius: 6px; padding: 32px 24px; }
  .hp64-test__stars { color: #06B6D4; font-size: 16px; margin-bottom: 16px; letter-spacing: 2px; }
  .hp64-test__quote { font-size: 15px; line-height: 1.6; color: #E2E8F0; margin: 0 0 20px; font-family: 'Space Grotesk', sans-serif; }
  .hp64-test__author { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; color: #FFFFFF; margin: 0; }
  .hp64-test__role { font-size: 11px; color: #10B981; margin: 4px 0 0; letter-spacing: 1px; text-transform: uppercase; font-family: 'Space Grotesk', sans-serif; }
  @media screen and (max-width: 992px) { .hp64-test__grid { grid-template-columns: 1fr; max-width: 600px; margin: 0 auto; } }
{%- endstyle -%}
<div class="hp64-test__container">
  <div class="hp64-test__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp64-test__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp64-test__heading">{{ section.settings.heading | default: 'Bioluminescent Clinical Trials' }}</h2>
  </div>
  <div class="hp64-test__grid">
    {%- for block in section.blocks -%}
      <div class="hp64-test__card" {{ block.shopify_attributes }}>
        <div class="hp64-test__stars">{{ block.settings.stars | default: '★★★★★' }}</div>
        <p class="hp64-test__quote">"{{ block.settings.quote | default: 'The luciferin elixir restored mitochondrial brightness and erased years of blue-light screen fatigue.' }}"</p>
        <p class="hp64-test__author">{{ block.settings.author | default: 'Dr. Evelyn Vance' }}</p>
        <p class="hp64-test__role">{{ block.settings.role | default: 'Marine Biologist & Formulator' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP64 Reviews",
  "class": "section-hp64-test",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#030712" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🧬 CLINICAL REVIEWS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bioluminescent Clinical Trials" },
    { "type": "range", "id": "columns", "min": 1, "max": 3, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "testimonial", "name": "Review", "settings": [
    { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "The luciferin elixir restored brightness." },
    { "type": "text", "id": "author", "label": "Author", "default": "Dr. Evelyn Vance" },
    { "type": "text", "id": "role", "label": "Role", "default": "Marine Biologist" }
  ]}],
  "presets": [{ "name": "HP64 Reviews", "blocks": [
    { "type": "testimonial" },
    { "type": "testimonial", "settings": { "quote": "Immediate epidermal photon emission. Skin reflects light with an ethereal, healthy clarity.", "author": "Kaito Tanaka", "role": "Photobiology Researcher" } },
    { "type": "testimonial", "settings": { "quote": "The hydrothermal vent peptides repaired my depleted moisture barrier when nothing else worked.", "author": "Elena Rostova", "role": "Dermatology Specialist" } }
  ]}]
}
{% endschema %}
