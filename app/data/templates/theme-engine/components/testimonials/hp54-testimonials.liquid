{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0A1628' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp54-test__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp54-test__header { text-align: center; margin-bottom: 50px; }
  .hp54-test__eyebrow { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #60A5FA; margin: 0 0 12px; }
  .hp54-test__heading { font-family: 'Tenor Sans', serif; font-size: clamp(28px, 3.5vw, 42px); color: #FFFFFF; margin: 0; }
  .hp54-test__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 20px; }
  .hp54-test__card { background: #111D33; border: 1px solid rgba(59, 130, 246, 0.15); border-radius: 12px; padding: 30px 22px; }
  .hp54-test__stars { color: #3B82F6; font-size: 16px; margin-bottom: 16px; letter-spacing: 2px; }
  .hp54-test__quote { font-family: 'Tenor Sans', serif; font-size: 16px; font-style: italic; line-height: 1.6; color: #E0E7FF; margin: 0 0 20px; }
  .hp54-test__author { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 700; color: #FFFFFF; margin: 0; }
  .hp54-test__role { font-size: 11px; color: #60A5FA; margin: 4px 0 0; letter-spacing: 1px; text-transform: uppercase; }
  @media screen and (max-width: 992px) { .hp54-test__grid { grid-template-columns: 1fr; max-width: 600px; margin: 0 auto; } }
{%- endstyle -%}
<div class="hp54-test__container">
  <div class="hp54-test__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp54-test__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp54-test__heading">{{ section.settings.heading | default: 'Midnight Voices' }}</h2>
  </div>
  <div class="hp54-test__grid">
    {%- for block in section.blocks -%}
      <div class="hp54-test__card" {{ block.shopify_attributes }}>
        <div class="hp54-test__stars">{{ block.settings.stars | default: '★★★★★' }}</div>
        <p class="hp54-test__quote">"{{ block.settings.quote | default: 'The sapphire serum is liquid magic for tired skin.' }}"</p>
        <p class="hp54-test__author">{{ block.settings.author | default: 'Sarah L.' }}</p>
        <p class="hp54-test__role">{{ block.settings.role | default: 'Verified Buyer' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP54 - Sapphire Reviews",
  "class": "section-hp54-test",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A1628" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◆ TESTIMONIALS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Midnight Voices" },
    { "type": "range", "id": "columns", "min": 1, "max": 3, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "testimonial", "name": "Review", "settings": [
    { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "The sapphire serum is liquid magic." },
    { "type": "text", "id": "author", "label": "Author", "default": "Sarah L." },
    { "type": "text", "id": "role", "label": "Role", "default": "Verified Buyer" }
  ]}],
  "presets": [{ "name": "HP54 - Sapphire Reviews", "blocks": [
    { "type": "testimonial" },
    { "type": "testimonial", "settings": { "quote": "Woke up with glass skin after just one night.", "author": "Emma R." } },
    { "type": "testimonial", "settings": { "quote": "The blue tansy mask cleared my skin in days.", "author": "Priya K." } }
  ]}]
}
{% endschema %}
