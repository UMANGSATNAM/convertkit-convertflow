{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Syncopate:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Syncopate', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  /* Matrix / Terminal background */
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-image: radial-gradient(rgba(226, 226, 226, 0.05) 1px, transparent 1px);
    background-size: 30px 30px;
    pointer-events: none;
    z-index: 0;
  }

  .hp27-test-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp27-test-wrapper {
      padding: 0 20px;
    }
  }

  .hp27-test__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .hp27-test__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp27-test__slider {
    position: relative;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    gap: 20px;
    padding-bottom: 20px;
  }

  .hp27-test__slider::-webkit-scrollbar {
    display: none;
  }

  .hp27-test__item {
    flex: 0 0 calc(33.333% - 14px);
    scroll-snap-align: start;
    background: #111;
    border: 1px solid rgba(226, 226, 226, 0.1);
    padding: 40px 30px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.3s ease;
  }

  @media screen and (max-width: 992px) {
    .hp27-test__item {
      flex: 0 0 calc(50% - 10px);
    }
  }

  @media screen and (max-width: 600px) {
    .hp27-test__item {
      flex: 0 0 85%;
    }
  }

  .hp27-test__item:hover {
    border-color: rgba(226, 226, 226, 0.3);
    background: rgba(17, 17, 17, 0.8);
  }

  /* Technical top line indicator */
  .hp27-test__item::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 0; height: 2px;
    background: var(--accent-color);
    transition: width 0.4s ease;
  }

  .hp27-test__item:hover::before {
    width: 100%;
  }

  .hp27-test__rating {
    display: flex;
    gap: 4px;
    margin-bottom: 20px;
  }

  .hp27-test__rating span {
    width: 12px;
    height: 12px;
    background: var(--accent-color);
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
  }

  .hp27-test__quote {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0 0 30px;
    flex-grow: 1;
  }

  .hp27-test__meta {
    border-top: 1px solid rgba(226, 226, 226, 0.1);
    padding-top: 20px;
  }

  .hp27-test__author {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-color);
    margin: 0 0 5px;
    text-transform: uppercase;
  }

  .hp27-test__verified {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--accent-color);
    text-transform: uppercase;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp27-test-wrapper" id="HP27Test-{{ section.id }}">
  <div class="hp27-test__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp27-test__title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

  <div class="hp27-test__slider">
    {%- for block in section.blocks -%}
      <div class="hp27-test__item" {{ block.shopify_attributes }}>
        <div class="hp27-test__rating">
          <!-- Geometric rating blocks -->
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="hp27-test__quote">
          "{{ block.settings.quote }}"
        </div>
        <div class="hp27-test__meta">
          <div class="hp27-test__author">{{ block.settings.author }}</div>
          {%- if block.settings.verified -%}
            <div class="hp27-test__verified">VERIFIED STATUS</div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP27 - Eng Testimonials",
  "class": "section-hp27-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FIELD DATA LOGS"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Dark Engineered Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#E2E2E2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF2A2A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Unprecedented build quality. The precision is immediately noticeable upon unboxing."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "USER_ID: ALEX M."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show Verified Status",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP27 - Eng Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
