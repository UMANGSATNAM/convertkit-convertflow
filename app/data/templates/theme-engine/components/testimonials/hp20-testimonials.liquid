{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --border-thickness: {{ section.settings.border_thickness }}px;
    --shadow-color: {{ section.settings.shadow_color }};
    --shadow-offset: {{ section.settings.shadow_offset }}px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp20-testimonials-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
    overflow: hidden; /* Prevent shadow bleed on mobile */
  }

  .hp20-testimonials__header {
    text-align: {{ section.settings.header_alignment }};
    margin-bottom: {{ section.settings.header_margin }}px;
    border-bottom: var(--border-thickness) solid var(--border-color);
    padding-bottom: 24px;
  }

  .hp20-testimonials__title {
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: -1px;
    margin: 0;
  }

  .hp20-testimonials__grid {
    display: flex;
    gap: {{ section.settings.gap }}px;
    padding-bottom: 32px;
    margin-bottom: -32px;
    {% if section.settings.mobile_swipe %}
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    {% else %}
      flex-wrap: wrap;
    {% endif %}
  }

  {% if section.settings.mobile_swipe %}
  .hp20-testimonials__grid::-webkit-scrollbar {
    display: none;
  }
  {% endif %}

  .hp20-testimonials__card {
    background: {{ section.settings.card_bg }};
    border: var(--border-thickness) solid var(--border-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0px var(--shadow-color);
    padding: {{ section.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    position: relative;
    
    {% if section.settings.mobile_swipe %}
      flex: 0 0 calc(100% / {{ section.settings.desktop_columns }} - {{ section.settings.gap | times: section.settings.desktop_columns | minus: section.settings.gap | divided_by: section.settings.desktop_columns }}px);
      scroll-snap-align: start;
    {% else %}
      flex: 1 1 calc(100% / {{ section.settings.desktop_columns }} - {{ section.settings.gap }}px);
    {% endif %}
  }
  
  @media screen and (max-width: 992px) {
    .hp20-testimonials__card {
      {% if section.settings.mobile_swipe %}
        flex: 0 0 calc(100% / {{ section.settings.tablet_columns }} - {{ section.settings.gap | divided_by: 2 }}px);
      {% else %}
        flex: 1 1 calc(100% / {{ section.settings.tablet_columns }} - {{ section.settings.gap }}px);
      {% endif %}
    }
  }

  @media screen and (max-width: 768px) {
    .hp20-testimonials__card {
      {% if section.settings.mobile_swipe %}
        flex: 0 0 85vw;
      {% else %}
        flex: 1 1 100%;
      {% endif %}
    }
  }

  .hp20-testimonials__quote-icon {
    position: absolute;
    top: -20px;
    left: 24px;
    width: 40px;
    height: 40px;
    background: var(--text-color);
    color: var(--bg-color); /* assuming contrast */
    display: flex;
    align-items: center;
    justify-content: center;
    border: var(--border-thickness) solid var(--border-color);
    font-family: serif;
    font-size: 40px;
    line-height: 1;
    padding-top: 10px;
  }

  .hp20-testimonials__stars {
    display: flex;
    gap: 4px;
    margin-bottom: 24px;
    margin-top: 8px; /* account for quote icon */
    color: {{ section.settings.star_color }};
  }
  
  .hp20-testimonials__stars svg {
    width: 20px;
    height: 20px;
  }

  .hp20-testimonials__text {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.4;
    color: var(--text-color);
    text-transform: uppercase;
    margin: 0 0 32px;
    flex-grow: 1;
  }

  .hp20-testimonials__author {
    border-top: var(--border-thickness) dashed var(--border-color);
    padding-top: 24px;
  }

  .hp20-testimonials__author-name {
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: 16px;
    color: var(--text-color);
    text-transform: uppercase;
    margin: 0 0 4px;
  }

  .hp20-testimonials__author-role {
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 14px;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp20-testimonials-wrapper" id="HP20Testimonials-{{ section.id }}">
  
  {% if section.settings.title != blank %}
  <div class="hp20-testimonials__header">
    <h2 class="hp20-testimonials__title">{{ section.settings.title | escape }}</h2>
  </div>
  {% endif %}

  <div class="hp20-testimonials__grid">
    {%- for block in section.blocks -%}
      <div class="hp20-testimonials__card" {{ block.shopify_attributes }}>
        <div class="hp20-testimonials__quote-icon">"</div>
        
        <div class="hp20-testimonials__stars">
          {%- for i in (1..block.settings.rating) -%}
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {%- endfor -%}
        </div>
        
        <blockquote class="hp20-testimonials__text">
          {{ block.settings.text | escape }}
        </blockquote>
        
        <div class="hp20-testimonials__author">
          <p class="hp20-testimonials__author-name">{{ block.settings.author | escape }}</p>
          {%- if block.settings.role != blank -%}
            <p class="hp20-testimonials__author-role">{{ block.settings.role | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

</div>

{% schema %}
{
  "name": "HP20 - Brutalist Quotes",
  "class": "section-hp20-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "NO CAP. JUST REVIEWS."
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Desktop Columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Tablet Columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 32
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "mobile_swipe",
      "label": "Enable horizontal swipe on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Card Styling"
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Card Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Quote Text Size",
      "default": 24
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Outer Background",
      "default": "#E2FF00"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Thickness",
      "default": 3
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Hard Shadow Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "shadow_offset",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Shadow Offset",
      "default": 12
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Quote",
          "default": "THE QUALITY IS INSANE. I'VE NEVER SEEN ANYTHING LIKE IT BEFORE. ABSOLUTE FIRE."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "ALEX M."
        },
        {
          "type": "text",
          "id": "role",
          "label": "Author Info (Optional)",
          "default": "VERIFIED BUYER"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP20 - Brutalist Quotes",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
