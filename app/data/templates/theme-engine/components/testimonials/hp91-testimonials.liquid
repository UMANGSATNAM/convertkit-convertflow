{%- style -%}#shopify-section-{{ section.id }}{background:#F0FDFA;padding:50px 0}.hp91-t{max-width:1280px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:repeat(2,1fr);gap:14px}@media(max-width:800px){.hp91-t{grid-template-columns:1fr}}.hp91-card{background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:12px;padding:16px}.hp91-stars{color:#0D9488}{%- endstyle -%}<div class="hp91-t">{% for block in section.blocks %}<div class="hp91-card"><div class="hp91-stars">★★★★★</div><p style="font-weight:600">{{block.settings.text}}</p><small style="opacity:.6">— {{block.settings.author}}</small></div>{% else %}<div class="hp91-card"><div class="hp91-stars">★★★★★</div><p>Loved GROOMING!</p><small>— A. Sharma</small></div><div class="hp91-card"><div class="hp91-stars">★★★★★</div><p>Super fast.</p><small>— R. Mehta</small></div>{% if false %}<div class="hp91-card"><div class="hp91-stars">★★★★★</div><p>Will reorder!</p><small>— P. Rao</small></div>{% endif %}{% endfor %}</div>{% schema %}
{
  "name": "HP91 Testimonials",
  "blocks": [
    {
      "type": "t",
      "name": "T",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Great!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "A. Sharma"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP91 Testimonials"
    }
  ]
}
{% endschema %}