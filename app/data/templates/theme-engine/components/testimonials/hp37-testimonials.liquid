{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Shrikhand&family=DM+Sans:wght@400;500;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --card-bg: {{ section.settings.card_bg }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Shrikhand', cursive;
    --font-body: 'DM Sans', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp37-testi-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp37-testi-wrapper {
      padding: 0 20px;
    }
  }

  .hp37-testi__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp37-testi__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp37-testi__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp37-testi__card {
    background: var(--card-bg);
    border: 4px solid var(--text-color);
    border-radius: 40px 40px 0 40px; /* Speech bubble look */
    padding: 40px;
    box-shadow: 8px 8px 0px var(--accent-color);
    position: relative;
  }

  .hp37-testi__icon {
    position: absolute;
    top: -20px;
    right: -20px;
    width: 50px;
    height: 50px;
    background: var(--text-color);
    color: var(--bg-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 30px;
    line-height: 1;
    transform: rotate(10deg);
  }

  .hp37-testi__quote {
    font-family: var(--font-body);
    font-size: clamp(18px, 2vw, {{ section.settings.quote_size }}px);
    line-height: 1.4;
    color: var(--text-color);
    font-weight: 700;
    margin: 0 0 30px;
  }

  .hp37-testi__author {
    font-family: var(--font-heading);
    font-size: 20px;
    color: var(--accent-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp37-testi-wrapper" id="HP37Testimonials-{{ section.id }}">
  <div class="hp37-testi__grid">
    {%- for block in section.blocks limit: 3 -%}
      <div class="hp37-testi__card" {{ block.shopify_attributes }}>
        <div class="hp37-testi__icon">★</div>
        <div class="hp37-testi__quote">"{{ block.settings.quote }}"</div>
        <div class="hp37-testi__author">{{ block.settings.author }}</div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP37 - Retro Quotes",
  "class": "section-hp37-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "quote_size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Quote Size",
      "default": 24
    },
    {
      "type": "header",
      "content": "Retro Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4E3C5"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#F9F3EA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A3219"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D96C4A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The most comfortable boardshorts I've ever owned. Total game changer for summer!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Sunny D."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP37 - Retro Quotes",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial", "settings": { "quote": "Love the vintage vibes. Reminds me of the good old days catching waves in Malibu.", "author": "Duke K." } },
        { "type": "testimonial", "settings": { "quote": "Incredible quality and the colors are just perfect. Getting compliments everywhere.", "author": "Sandy B." } }
      ]
    }
  ]
}
{% endschema %}
