{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#F4F4F0'
  assign padding_top = section.settings.padding_top | default: 120
  assign padding_bottom = section.settings.padding_bottom | default: 120
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hp7-testimonials-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 4vw;
  }
  
  .hp7-testimonials__header {
    margin-bottom: 6rem;
    text-align: center;
  }
  
  .hp7-testimonials__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.1;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp7-testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4vw;
  }

  .hp7-testimonials__card {
    position: relative;
    padding: 3rem 0;
    border-top: 1px solid var(--text-color);
    display: flex;
    flex-direction: column;
  }

  .hp7-testimonials__quote-mark {
    font-family: 'Playfair Display', serif;
    font-size: 8rem;
    line-height: 0;
    color: var(--text-color);
    opacity: 0.2;
    position: absolute;
    top: 3rem;
    left: -1rem;
    pointer-events: none;
  }

  .hp7-testimonials__text {
    font-family: 'Inter', sans-serif;
    font-size: clamp(16px, 1.2vw, 20px);
    line-height: 1.6;
    margin-bottom: 2rem;
    position: relative;
    z-index: 2;
    font-style: italic;
  }

  .hp7-testimonials__author {
    font-family: 'Inter', monospace;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    margin-top: auto;
  }
  
  .hp7-testimonials__publication {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    opacity: 0.5;
    display: block;
    margin-top: 0.5rem;
  }

  @media screen and (max-width: 990px) {
    .hp7-testimonials__grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>

<section class="hp7-testimonials-{{ section_id }}">
  {%- if section.settings.title != blank -%}
    <div class="hp7-testimonials__header">
      <h2 class="hp7-testimonials__title">{{ section.settings.title }}</h2>
    </div>
  {%- endif -%}

  <div class="hp7-testimonials__grid">
    {%- for block in section.blocks -%}
      <div class="hp7-testimonials__card" {{ block.shopify_attributes }}>
        <span class="hp7-testimonials__quote-mark">&ldquo;</span>
        <div class="hp7-testimonials__text">
          {{ block.settings.text }}
        </div>
        <div class="hp7-testimonials__author">
          {{ block.settings.author | escape }}
          {%- if block.settings.publication != blank -%}
            <span class="hp7-testimonials__publication">{{ block.settings.publication | escape }}</span>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "HP7 Editorial Quotes",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Aesthetic: Editorial Brutalism"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "THE CONSENSUS"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F4F4F0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "limit": 3,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Quote Text",
          "default": "<p>A masterclass in restraint and brutalist tailoring. They have successfully stripped away the unnecessary.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "J. DOE"
        },
        {
          "type": "text",
          "id": "publication",
          "label": "Publication",
          "default": "FASHION CRITIC"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP7 Editorial Quotes",
      "blocks": [
        { "type": "quote" },
        { "type": "quote" },
        { "type": "quote" }
      ]
    }
  ]
}
{% endschema %}
