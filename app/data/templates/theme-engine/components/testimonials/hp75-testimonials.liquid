{%- style -%}#shopify-section-{{ section.id }}{background:#0B0B0D;padding:50px 0}.hp75-t{max-width:1280px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:repeat(3,1fr);gap:14px}@media(max-width:800px){.hp75-t{grid-template-columns:1fr}}.hp75-card{background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:12px;padding:16px}.hp75-stars{color:#E11D48}{%- endstyle -%}<div class="hp75-t">{% for block in section.blocks %}<div class="hp75-card"><div class="hp75-stars">★★★★★</div><p style="font-weight:600">{{block.settings.text}}</p><small style="opacity:.6">— {{block.settings.author}}</small></div>{% else %}<div class="hp75-card"><div class="hp75-stars">★★★★★</div><p>Loved STREETWEAR!</p><small>— A. Sharma</small></div><div class="hp75-card"><div class="hp75-stars">★★★★★</div><p>Super fast.</p><small>— R. Mehta</small></div>{% if true %}<div class="hp75-card"><div class="hp75-stars">★★★★★</div><p>Will reorder!</p><small>— P. Rao</small></div>{% endif %}{% endfor %}</div>{% schema %}
{
  "name": "HP75 Testimonials",
  "blocks": [
    {
      "type": "t",
      "name": "T",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Great!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "A. Sharma"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP75 Testimonials"
    }
  ]
}
{% endschema %}