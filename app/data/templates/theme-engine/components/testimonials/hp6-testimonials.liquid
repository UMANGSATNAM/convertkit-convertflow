{%- liquid
  assign bg_color = section.settings.bg_color | default: '#111111'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#ff4500'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp6-test-bg: {{ bg_color }};
    --hp6-test-text: {{ text_color }};
    --hp6-test-accent: {{ accent_color }};
    
    --hp6-test-pt-desk: {{ padding_top_desktop }}px;
    --hp6-test-pb-desk: {{ padding_bottom_desktop }}px;
    --hp6-test-pt-mob: {{ padding_top_mobile }}px;
    --hp6-test-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp6-sports-testimonials-{{ section.id }} {
    padding-top: var(--hp6-test-pt-desk);
    padding-bottom: var(--hp6-test-pb-desk);
    background-color: var(--hp6-test-bg);
    color: var(--hp6-test-text);
  }

  .hp6-test-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hp6-test-header {
    text-align: center;
    margin-bottom: 50px;
  }
  .hp6-test-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 700;
    text-transform: uppercase;
    margin: 0;
    letter-spacing: -1px;
  }
  .hp6-test-title span { color: var(--hp6-test-accent); }

  /* Carousel */
  .hp6-test-carousel {
    position: relative;
    width: 100%;
    max-width: 900px;
    overflow: hidden;
  }

  .hp6-test-track {
    display: flex;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hp6-test-slide {
    flex: 0 0 100%;
    min-width: 0;
    padding: 0 20px;
  }

  .hp6-test-card {
    background: #1a1a1a;
    border: 1px solid rgba(255,255,255,0.05);
    padding: 50px;
    text-align: center;
    border-radius: 8px;
    position: relative;
  }
  
  .hp6-test-quote-icon {
    position: absolute;
    top: 20px; left: 20px;
    color: var(--hp6-test-accent);
    opacity: 0.2;
    width: 60px; height: 60px;
  }
  .hp6-test-quote-icon svg { width: 100%; height: 100%; fill: currentColor; }

  .hp6-test-stars {
    display: flex;
    justify-content: center;
    gap: 5px;
    margin-bottom: 20px;
    color: var(--hp6-test-accent);
  }
  .hp6-test-stars svg { width: 24px; height: 24px; fill: currentColor; }

  .hp6-test-text {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(20px, 3vw, 28px);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.4;
    margin: 0 0 30px 0;
    position: relative;
    z-index: 2;
  }

  .hp6-test-author {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
  }
  .hp6-test-name {
    font-family: 'Oswald', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--hp6-test-text);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .hp6-test-sport {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: rgba(255,255,255,0.6);
    margin: 0;
  }

  /* Nav */
  .hp6-test-nav {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 40px;
  }
  .hp6-test-dot {
    width: 40px; height: 4px;
    background: rgba(255,255,255,0.2);
    border: none;
    cursor: pointer;
    transition: background 0.3s ease;
  }
  .hp6-test-dot.active {
    background: var(--hp6-test-accent);
  }

  @media screen and (max-width: 768px) {
    .hp6-sports-testimonials-{{ section.id }} {
      padding-top: var(--hp6-test-pt-mob);
      padding-bottom: var(--hp6-test-pb-mob);
    }
    .hp6-test-inner { padding: 0 20px; }
    .hp6-test-card { padding: 30px 20px; }
    .hp6-test-quote-icon { width: 40px; height: 40px; top: 10px; left: 10px; }
    .hp6-test-stars svg { width: 18px; height: 18px; }
  }
</style>

<section class="hp6-sports-testimonials-{{ section.id }}" aria-label="Testimonials">
  <div class="hp6-test-inner">
    
    <div class="hp6-test-header">
      <h2 class="hp6-test-title">{{ section.settings.heading | replace: 'HIGHLIGHT WORD', '<span>HIGHLIGHT WORD</span>' }}</h2>
    </div>

    <div class="hp6-test-carousel">
      <div class="hp6-test-track" id="hp6-test-track-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="hp6-test-slide" {{ block.shopify_attributes }}>
            <div class="hp6-test-card">
              <div class="hp6-test-quote-icon">
                <svg viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.714 4.026-9.609 9.983-9.609v3.391c-3.111 0-5.014 1.487-5.014 4.298h5.014v9.311h-9.983zm-14.017 0v-7.391c0-5.714 4.026-9.609 9.983-9.609v3.391c-3.111 0-5.014 1.487-5.014 4.298h5.014v9.311h-9.983z"/></svg>
              </div>
              
              <div class="hp6-test-stars">
                {%- for i in (1..5) -%}
                  <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                {%- endfor -%}
              </div>

              <blockquote class="hp6-test-text">"{{ block.settings.text }}"</blockquote>
              
              <div class="hp6-test-author">
                <span class="hp6-test-name">{{ block.settings.author }}</span>
                {%- if block.settings.sport != blank -%}
                  <span class="hp6-test-sport">{{ block.settings.sport }}</span>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="hp6-test-nav" id="hp6-test-nav-{{ section.id }}">
      {%- for block in section.blocks -%}
        <button class="hp6-test-dot {% if forloop.first %}active{% endif %}" aria-label="Go to slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const track = document.getElementById('hp6-test-track-{{ section.id }}');
    const dots = document.querySelectorAll('#hp6-test-nav-{{ section.id }} .hp6-test-dot');
    if(!track || dots.length === 0) return;

    let currentIndex = 0;

    function goToSlide(index) {
      currentIndex = index;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === currentIndex);
      });
    }

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => goToSlide(index));
    });
  });
</script>

{% schema %}
{
  "name": "HP6 Sports Testimonials",
  "tag": "section",
  "class": "section-hp6-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ATHLETE <span>VERIFIED</span>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff4500"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 50
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Quote",
          "default": "This gear changed how I train. The durability and fit are unmatched."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "MARK R."
        },
        {
          "type": "text",
          "id": "sport",
          "label": "Sport/Title",
          "default": "CrossFit Athlete"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP6 Sports Testimonials",
      "category": "Text",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
