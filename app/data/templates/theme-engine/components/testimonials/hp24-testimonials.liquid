{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-primary: {{ section.settings.accent_primary }};
    --accent-secondary: {{ section.settings.accent_secondary }};
    --font-heading: 'Orbitron', sans-serif;
    --font-body: 'Share Tech Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp24-test-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp24-test-wrapper {
      padding: 0 20px;
    }
  }

  .hp24-test__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp24-test__sys-text {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--accent-secondary);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .hp24-test__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-shadow: 0 0 10px rgba(0, 243, 255, 0.3);
  }

  .hp24-test__slider {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 30px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--accent-primary) rgba(255,255,255,0.1);
  }

  .hp24-test__slider::-webkit-scrollbar {
    height: 4px;
  }
  
  .hp24-test__slider::-webkit-scrollbar-track {
    background: rgba(255,255,255,0.05);
  }
  
  .hp24-test__slider::-webkit-scrollbar-thumb {
    background: var(--accent-primary);
  }

  /* The Review Terminal Box */
  .hp24-test-card {
    flex: 0 0 calc(100% / {{ section.settings.columns_desktop }} - 30px);
    min-width: 300px;
    scroll-snap-align: center;
    background: #000;
    border: 1px solid var(--accent-primary);
    padding: 30px;
    position: relative;
    box-shadow: 0 0 15px rgba(0, 243, 255, 0.1);
  }

  @media screen and (max-width: 992px) {
    .hp24-test-card {
      flex: 0 0 calc(50% - 15px);
    }
  }

  @media screen and (max-width: 600px) {
    .hp24-test-card {
      flex: 0 0 85%;
    }
  }

  /* Glitchy borders */
  .hp24-test-card::before {
    content: '';
    position: absolute;
    top: -1px; left: -1px;
    width: 20px; height: 20px;
    border-top: 2px solid var(--accent-secondary);
    border-left: 2px solid var(--accent-secondary);
  }

  .hp24-test-card::after {
    content: '';
    position: absolute;
    bottom: -1px; right: -1px;
    width: 20px; height: 20px;
    border-bottom: 2px solid var(--accent-secondary);
    border-right: 2px solid var(--accent-secondary);
  }

  .hp24-test-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed rgba(255,255,255,0.2);
    padding-bottom: 15px;
    margin-bottom: 20px;
  }

  .hp24-test-card__author {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: var(--accent-primary);
    text-transform: uppercase;
  }

  .hp24-test-card__verified {
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--bg-color);
    background: var(--accent-primary);
    padding: 2px 6px;
    text-transform: uppercase;
    border-radius: 2px;
  }

  .hp24-test-card__stars {
    color: var(--accent-secondary);
    font-size: 14px;
    letter-spacing: 2px;
    margin-bottom: 15px;
  }

  .hp24-test-card__text {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-color);
    line-height: 1.6;
    margin: 0;
    opacity: 0.9;
  }
  
  .hp24-test-card__text::before {
    content: '>';
    color: var(--accent-secondary);
    margin-right: 5px;
    animation: alertBlink 1s infinite;
  }

  .hp24-test-card__sys {
    font-family: var(--font-body);
    font-size: 10px;
    color: rgba(255,255,255,0.3);
    margin-top: 20px;
    text-align: right;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp24-test-wrapper" id="HP24Testimonials-{{ section.id }}">
  <div class="hp24-test__header">
    <div class="hp24-test__sys-text">DATA.LOG: SUBJECT FEEDBACK</div>
    {%- if section.settings.title != blank -%}
      <h2 class="hp24-test__title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

  <div class="hp24-test__slider">
    {%- for block in section.blocks -%}
      <div class="hp24-test-card" {{ block.shopify_attributes }}>
        
        <div class="hp24-test-card__header">
          <div class="hp24-test-card__author">{{ block.settings.author | default: 'UNKNOWN_USER' }}</div>
          {%- if block.settings.verified -%}
            <div class="hp24-test-card__verified">VERIFIED.SRC</div>
          {%- endif -%}
        </div>

        <div class="hp24-test-card__stars">
          {%- assign rating = block.settings.rating | plus: 0 -%}
          {%- for i in (1..5) -%}
            {%- if i <= rating -%}★{%- else -%}☆{%- endif -%}
          {%- endfor -%}
        </div>

        <div class="hp24-test-card__text">
          {{ block.settings.text }}
        </div>
        
        <div class="hp24-test-card__sys">
          LOG.ENTRY: 00{{ forloop.index }} // END
        </div>

      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP24 - Cyber Testimonials",
  "class": "section-hp24-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SUBJECT LOGS"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 50
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 3
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Cyberpunk Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_primary",
      "label": "Accent Primary (Neon Blue)",
      "default": "#00F3FF"
    },
    {
      "type": "color",
      "id": "accent_secondary",
      "label": "Accent Secondary (Neon Pink)",
      "default": "#FF00E6"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "USER_7749"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show Verified Badge",
          "default": true
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "Installation was flawless. System integration completed in under 2 minutes. Performance increased by 400%."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP24 - Cyber Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
