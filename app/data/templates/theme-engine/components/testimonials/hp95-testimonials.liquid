{%- style -%}#shopify-section-{{ section.id }}{background:#0B0B0D;padding:60px 24px}.hp95-test{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:18px}@media(max-width:768px){.hp95-test{grid-template-columns:1fr}}.hp95-t{background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:14px;padding:18px}.hp95-t__stars{color:#E11D48;letter-spacing:2px}{%- endstyle -%}<div class="hp95-test">{% for block in section.blocks %}<div class="hp95-t"><p class="hp95-t__stars">★★★★★</p><p style="font-weight:600;margin:8px 0">{{ block.settings.text }}</p><p style="opacity:.6;font-size:13px">— {{ block.settings.author }}</p></div>{% else %}<div class="hp95-t"><p class="hp95-t__stars">★★★★★</p><p>Love the streetwear quality!</p><p style="opacity:.6">— A. Sharma</p></div><div class="hp95-t"><p class="hp95-t__stars">★★★★★</p><p>Super fast delivery.</p><p style="opacity:.6">— R. Mehta</p></div><div class="hp95-t"><p class="hp95-t__stars">★★★★★</p><p>Will reorder!</p><p style="opacity:.6">— P. Rao</p></div>{% endfor %}</div>{% schema %}
{
  "name": "HP95 Testimonials",
  "blocks": [
    {
      "type": "t",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Great product!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "A. Sharma"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP95 Testimonials"
    }
  ]
}
{% endschema %}