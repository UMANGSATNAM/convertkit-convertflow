{%- comment -%}
  Component: testimonials-bold-lifestyle-v1
  Family: Lifestyle | Style: bold
  Archetypes: streetwear, hype
  v2.0 — StoreForge Component Library
{%- endcomment -%}
<section class="testimonials testimonials--streetwear" style="padding: var(--space-64) 0; background-color: var(--color-surface); border-bottom: 2px solid var(--color-border); text-align: center;">
  <div class="container" style="max-width: 900px;">
    
    {%- if section.settings.title != blank -%}
    <h2 class="section-title" style="font-family: var(--font-heading-family); font-size: 2.5rem; font-weight: 900; text-transform: uppercase; margin-bottom: var(--space-40); letter-spacing: -0.01em;">
      // VERIFIED CUSTOMERS //
    </h2>
    {%- endif -%}

    <div class="testimonials-slider" style="display: flex; flex-direction: column; gap: var(--space-32);">
      {%- for block in section.blocks -%}
        <div class="testimonial-block" {{ block.shopify_attributes }} 
             style="border: 2px solid var(--color-border); box-shadow: 4px 4px 0px var(--color-accent); background-color: #fff; padding: var(--space-24) var(--space-32); text-align: left; border-radius: var(--card-radius);">
          
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-12); flex-wrap: wrap; gap: var(--space-8);">
            <cite class="testimonial-author" style="font-family: var(--font-heading-family); font-size: 1.1rem; font-weight: 900; color: var(--color-text);">
              {{ block.settings.author | escape }}
            </cite>
            <div class="testimonial-rating" style="display: flex; gap: 2px; color: var(--color-text);">
              {%- assign rating = block.settings.rating -%}
              {%- for i in (1..5) -%}
                {%- if i <= rating -%}
                  {%- render 'icon-star', filled: true -%}
                {%- else -%}
                  {%- render 'icon-star', filled: false -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          <blockquote class="testimonial-quote" style="font-family: var(--font-body-family); font-size: 0.95rem; font-weight: 500; line-height: 1.5; color: #333; margin: 0;">
            {{ block.settings.quote }}
          </blockquote>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Customer Reviews"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Customer Name"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote Content",
          "default": "<p>A great experience with this store. Exceptional quality.</p>"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ]
}
{% endschema %}
