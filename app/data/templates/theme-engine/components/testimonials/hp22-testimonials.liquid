{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --card-bg: {{ section.settings.card_bg }};
    --font-heading: 'Lora', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Organic grain texture overlay */
  {% if section.settings.show_grain %}
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0.04;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
  {% endif %}

  .hp22-testi-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 768px) {
    .hp22-testi-wrapper {
      padding: 0 20px;
    }
  }

  .hp22-testi__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp22-testi__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--accent-color);
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .hp22-testi__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0;
    line-height: 1.2;
  }
  
  .hp22-testi__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp22-testi__slider-container {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
  }

  .hp22-testi__slides {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -webkit-overflow-scrolling: touch;
    gap: 40px;
    padding-bottom: 20px;
  }

  .hp22-testi__slides::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .hp22-testi__item {
    flex: 0 0 100%;
    scroll-snap-align: center;
    background: var(--card-bg);
    padding: 60px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    {% if section.settings.card_shape == 'blob' %}
      border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    {% elsif section.settings.card_shape == 'pill' %}
      border-radius: 200px;
    {% else %}
      border-radius: 24px;
    {% endif %}
    box-shadow: 0 20px 50px rgba(0,0,0,0.03);
    border: 1px solid rgba(0,0,0,0.02);
  }

  @media screen and (max-width: 768px) {
    .hp22-testi__item {
      padding: 40px 20px;
      {% if section.settings.card_shape == 'pill' %}
        border-radius: 40px; /* Soften pill on mobile */
      {% endif %}
    }
  }

  .hp22-testi__stars {
    color: #E2B254;
    display: flex;
    gap: 4px;
    margin-bottom: 24px;
  }

  .hp22-testi__stars svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .hp22-testi__quote {
    font-family: var(--font-heading);
    font-size: {{ section.settings.quote_size }}px;
    font-style: italic;
    color: var(--text-color);
    line-height: 1.4;
    margin: 0 0 32px;
    max-width: 700px;
  }

  .hp22-testi__author-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hp22-testi__author-img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    background: #EAE3D9;
  }

  .hp22-testi__author-info {
    text-align: left;
  }

  .hp22-testi__author-name {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    color: var(--text-color);
    margin: 0 0 4px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .hp22-testi__author-title {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--accent-color);
    margin: 0;
  }

  /* Decorative Quotes */
  .hp22-testi__deco-quote {
    position: absolute;
    top: 30px;
    left: 40px;
    font-family: var(--font-heading);
    font-size: 120px;
    color: var(--accent-color);
    opacity: 0.1;
    line-height: 1;
    pointer-events: none;
  }

  @media screen and (max-width: 768px) {
    .hp22-testi__deco-quote {
      font-size: 80px;
      top: 10px;
      left: 20px;
    }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp22-testi-wrapper" id="HP22Testimonials-{{ section.id }}">
  
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="hp22-testi__header">
      {%- if section.settings.subtitle != blank -%}
        <p class="hp22-testi__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="hp22-testi__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="hp22-testi__slider-container">
    <div class="hp22-testi__slides">
      {%- for block in section.blocks -%}
        <div class="hp22-testi__item" {{ block.shopify_attributes }}>
          <div class="hp22-testi__deco-quote">&ldquo;</div>
          
          <div class="hp22-testi__stars">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24"><path d="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"/></svg>
            {%- endfor -%}
          </div>

          <p class="hp22-testi__quote">"{{ block.settings.quote | escape }}"</p>

          <div class="hp22-testi__author-wrap">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 150 }}" alt="{{ block.settings.author | escape }}" class="hp22-testi__author-img" loading="lazy">
            {%- else -%}
              <div class="hp22-testi__author-img" style="display:flex;align-items:center;justify-content:center;color:#8A9A86;font-size:10px;">IMG</div>
            {%- endif -%}
            
            <div class="hp22-testi__author-info">
              <p class="hp22-testi__author-name">{{ block.settings.author | escape }}</p>
              {%- if block.settings.verified -%}
                <p class="hp22-testi__author-title">Verified Buyer</p>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

</div>

{% schema %}
{
  "name": "HP22 - Organic Reviews",
  "class": "section-hp22-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "WORDS OF LOVE"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>A Natural <em>Connection</em></p>"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 50
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "select",
      "id": "card_shape",
      "label": "Testimonial Card Shape",
      "options": [
        { "value": "blob", "label": "Organic Blob" },
        { "value": "pill", "label": "Pill (Fully Rounded)" },
        { "value": "soft", "label": "Soft Corners" }
      ],
      "default": "pill"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Section Heading Size",
      "default": 42
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Section Subtitle Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "quote_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Quote Size",
      "default": 28
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3A3A3A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8A9A86"
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Show subtle paper grain texture",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "This natural serum has completely transformed my daily ritual. My skin has never felt so balanced and radiant."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer Image"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Sarah M."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show 'Verified Buyer'",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP22 - Organic Reviews",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
