{%- liquid
  assign bg_color = section.settings.bg_color | default: '#0a0a0a'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ffcc'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp3-test-bg: {{ bg_color }};
    --hp3-test-text: {{ text_color }};
    --hp3-test-accent: {{ accent_color }};
    
    --hp3-test-pt-desk: {{ padding_top_desktop }}px;
    --hp3-test-pb-desk: {{ padding_bottom_desktop }}px;
    --hp3-test-pt-mob: {{ padding_top_mobile }}px;
    --hp3-test-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp3-tech-testimonials-{{ section.id }} {
    padding-top: var(--hp3-test-pt-desk);
    padding-bottom: var(--hp3-test-pb-desk);
    background-color: var(--hp3-test-bg);
    color: var(--hp3-test-text);
    font-family: 'Inter', sans-serif;
    position: relative;
  }

  .hp3-test-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp3-test-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 20px;
  }

  .hp3-test-title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -1px;
    margin: 0;
  }

  .hp3-test-controls {
    display: flex;
    gap: 15px;
  }

  .hp3-test-nav-btn {
    width: 40px; height: 40px;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 4px;
    color: var(--hp3-test-text);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .hp3-test-nav-btn:hover {
    background: var(--hp3-test-accent);
    color: #000;
    border-color: var(--hp3-test-accent);
  }
  .hp3-test-nav-btn svg { width: 16px; height: 16px; }

  /* Track */
  .hp3-test-track-container {
    overflow: hidden;
  }

  .hp3-test-track {
    display: flex;
    gap: 30px;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Card */
  .hp3-test-card {
    flex: 0 0 calc(33.333% - 20px);
    background: #111;
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 12px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.3s ease;
  }

  .hp3-test-card:hover {
    border-color: rgba(0,255,204,0.3);
    transform: translateY(-5px);
  }

  /* Cyber Quotes */
  .hp3-test-card::before {
    content: '"';
    position: absolute;
    top: 20px; right: 30px;
    font-size: 80px;
    font-weight: 900;
    font-family: serif;
    color: rgba(255,255,255,0.05);
    line-height: 1;
  }

  .hp3-test-stars {
    display: flex;
    gap: 5px;
    color: var(--hp3-test-accent);
    margin-bottom: 20px;
  }
  .hp3-test-stars svg { width: 16px; height: 16px; fill: currentColor; }

  .hp3-test-text {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255,255,255,0.8);
    margin-bottom: 30px;
    flex-grow: 1;
  }

  .hp3-test-author {
    display: flex;
    align-items: center;
    gap: 15px;
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 20px;
  }

  .hp3-test-author-img {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: #333;
    object-fit: cover;
  }

  .hp3-test-author-info {
    display: flex;
    flex-direction: column;
  }
  .hp3-test-author-name {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--hp3-test-text);
  }
  .hp3-test-author-role {
    font-size: 12px;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  @media screen and (max-width: 1024px) {
    .hp3-test-card { flex: 0 0 calc(50% - 15px); }
  }

  @media screen and (max-width: 768px) {
    .hp3-tech-testimonials-{{ section.id }} {
      padding-top: var(--hp3-test-pt-mob);
      padding-bottom: var(--hp3-test-pb-mob);
    }
    .hp3-test-inner {
      padding: 0 20px;
    }
    .hp3-test-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      border-bottom: none;
      padding-bottom: 0;
    }
    .hp3-test-track-container {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin: 0 -20px;
      padding: 0 20px;
    }
    .hp3-test-track-container::-webkit-scrollbar { display: none; }
    .hp3-test-track {
      transform: none !important;
    }
    .hp3-test-card {
      flex: 0 0 300px;
      scroll-snap-align: center;
      padding: 30px;
    }
    .hp3-test-controls {
      display: none; /* Rely on native swipe */
    }
  }
</style>

<section class="hp3-tech-testimonials-{{ section.id }}" aria-label="Customer Testimonials">
  <div class="hp3-test-inner">
    
    <div class="hp3-test-header">
      <h2 class="hp3-test-title">{{ section.settings.heading | default: 'USER FEEDBACK' }}</h2>
      <div class="hp3-test-controls">
        <button class="hp3-test-nav-btn prev" aria-label="Previous review">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        </button>
        <button class="hp3-test-nav-btn next" aria-label="Next review">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </button>
      </div>
    </div>

    <div class="hp3-test-track-container">
      <div class="hp3-test-track" id="test-track-{{ section.id }}">
        
        {%- for block in section.blocks -%}
          <div class="hp3-test-card" {{ block.shopify_attributes }}>
            <div class="hp3-test-stars">
              {%- for i in (1..block.settings.rating) -%}
                <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
              {%- endfor -%}
            </div>
            <div class="hp3-test-text">"{{ block.settings.text }}"</div>
            <div class="hp3-test-author">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 100 }}" class="hp3-test-author-img" alt="{{ block.settings.author }}">
              {%- else -%}
                <div class="hp3-test-author-img"></div>
              {%- endif -%}
              <div class="hp3-test-author-info">
                <span class="hp3-test-author-name">{{ block.settings.author }}</span>
                {%- if block.settings.role != blank -%}
                  <span class="hp3-test-author-role">{{ block.settings.role }}</span>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
        
        {%- if section.blocks.size == 0 -%}
          {%- for i in (1..3) -%}
            <div class="hp3-test-card">
              <div class="hp3-test-stars">
                <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
              </div>
              <div class="hp3-test-text">"Absolutely mind-blowing performance. Build quality is unmatched in this category."</div>
              <div class="hp3-test-author">
                <div class="hp3-test-author-img"></div>
                <div class="hp3-test-author-info">
                  <span class="hp3-test-author-name">Alex M.</span>
                  <span class="hp3-test-author-role">Verified Buyer</span>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}

      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if(window.innerWidth <= 768) return;

    const track = document.getElementById('test-track-{{ section.id }}');
    if(!track) return;
    
    const prevBtn = document.querySelector('.hp3-tech-testimonials-{{ section.id }} .prev');
    const nextBtn = document.querySelector('.hp3-tech-testimonials-{{ section.id }} .next');
    
    let currentIndex = 0;
    const cards = track.querySelectorAll('.hp3-test-card');
    if(cards.length === 0) return;
    
    const cardWidth = cards[0].offsetWidth;
    const gap = 30; // CSS gap
    
    function getVisibleItems() {
      return window.innerWidth > 1024 ? 3 : 2;
    }
    
    function updatePosition() {
      const moveAmount = currentIndex * (cardWidth + gap);
      track.style.transform = `translateX(-${moveAmount}px)`;
    }
    
    nextBtn.addEventListener('click', () => {
      const visible = getVisibleItems();
      if(currentIndex < cards.length - visible) {
        currentIndex++;
        updatePosition();
      }
    });
    
    prevBtn.addEventListener('click', () => {
      if(currentIndex > 0) {
        currentIndex--;
        updatePosition();
      }
    });
  });
</script>

{% schema %}
{
  "name": "HP3 Tech Testimonials",
  "tag": "section",
  "class": "section-hp3-test",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SYSTEM REVIEWS"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ffcc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1, "max": 5, "step": 1,
          "label": "Rating", "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "Best purchase I've made this year. High performance and sleek design."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author Image (Optional)"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "John D."
        },
        {
          "type": "text",
          "id": "role",
          "label": "Author Role",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP3 Tech Testimonials",
      "category": "Social",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
