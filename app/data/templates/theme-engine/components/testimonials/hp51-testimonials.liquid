{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp51-test-bg: {{ section.settings.bg_color | default: '#F2EFE9' }};
    --hp51-matcha: {{ section.settings.accent_matcha | default: '#2D5A3D' }};
    
    background-color: var(--hp51-test-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp51-test__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp51-test__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp51-test__heading {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(32px, 4.5vw, 44px);
    font-weight: 700;
    color: #1E3A2B;
    margin: 0 0 8px;
  }

  .hp51-test__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp51-test__card {
    background: #FAF8F5;
    border: 1px solid rgba(30, 58, 43, 0.12);
    border-radius: 16px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 30px rgba(30, 58, 43, 0.04);
  }

  .hp51-test__stars {
    color: #2D5A3D;
    font-size: 16px;
    margin-bottom: 16px;
    letter-spacing: 2px;
  }

  .hp51-test__quote {
    font-size: 15px;
    line-height: 1.8;
    color: #1E3A2B;
    margin: 0 0 24px;
    font-style: italic;
  }

  .hp51-test__author-row {
    border-top: 1px solid rgba(30, 58, 43, 0.1);
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp51-test__author {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #1E3A2B;
  }

  .hp51-test__verified {
    font-size: 11px;
    color: #2D5A3D;
  }

  @media screen and (max-width: 992px) {
    .hp51-test__grid { grid-template-columns: 1fr; max-width: 500px; margin: 0 auto; }
  }
{%- endstyle -%}

<div class="hp51-test__wrap">
  <div class="hp51-test__header">
    <h2 class="hp51-test__heading">{{ section.settings.heading | default: 'Reflections from Our Tea Ritualists' }}</h2>
    <p style="font-size:14px; color:#4A5B50;">{{ section.settings.subheading | default: 'Over 14,000 verified clients experiencing calm, luminous complexion.' }}</p>
  </div>

  <div class="hp51-test__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp51-test__card" {{ block.shopify_attributes }}>
          <div>
            <div class="hp51-test__stars">★★★★★</div>
            <p class="hp51-test__quote">"{{ block.settings.quote }}"</p>
          </div>
          <div class="hp51-test__author-row">
            <span class="hp51-test__author">{{ block.settings.author }}</span>
            <span class="hp51-test__verified">✓ Verified Tea Ritualist</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp51-test__card">
        <div>
          <div class="hp51-test__stars">★★★★★</div>
          <p class="hp51-test__quote">"My sensitive, reactive skin calmed down within three days of using the Ceremonial Matcha Serum. Unbelievably soothing."</p>
        </div>
        <div class="hp51-test__author-row">
          <span class="hp51-test__author">Aoi Tanaka</span>
          <span class="hp51-test__verified">✓ Verified Kyoto Client</span>
        </div>
      </div>
      <div class="hp51-test__card">
        <div>
          <div class="hp51-test__stars">★★★★★</div>
          <p class="hp51-test__quote">"The bamboo essence drenches the skin in lightweight hydration. No stickiness, just soft poreless calm."</p>
        </div>
        <div class="hp51-test__author-row">
          <span class="hp51-test__author">Claire Montgomery</span>
          <span class="hp51-test__verified">✓ Verified Client</span>
        </div>
      </div>
      <div class="hp51-test__card">
        <div>
          <div class="hp51-test__stars">★★★★★</div>
          <p class="hp51-test__quote">"The earthy green hue and fresh matcha aroma turn my morning skincare into a meditative tea ceremony."</p>
        </div>
        <div class="hp51-test__author-row">
          <span class="hp51-test__author">Elena Rostova</span>
          <span class="hp51-test__verified">✓ Verified Client</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP51 - Zen Test",
  "class": "section-hp51-testimonials",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F2EFE9" },
    { "type": "color", "id": "accent_matcha", "label": "Matcha Accent", "default": "#2D5A3D" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reflections from Our Tea Ritualists" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Over 14,000 verified clients experiencing calm, luminous complexion." },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Item",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "My sensitive, reactive skin calmed down within three days." },
        { "type": "text", "id": "author", "label": "Author Name", "default": "Aoi Tanaka" }
      ]
    }
  ],
  "presets": [
    { "name": "HP51 - Zen Test" }
  ]
}
{% endschema %}
