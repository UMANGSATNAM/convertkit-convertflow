{%- comment -%}
  sections/fb04-footer_streetwear.liquid

  CONVERSION PSYCHOLOGY (Frameblox Landing 04 Replica):
  1. DEEP CHARCOAL FINISH -- #282A2F dark background anchors bottom of page.
  2. 4-COLUMN STRUCTURE -- Brand mission, Menu links, Shop links, Social links.
  3. COPYRIGHT & LEGAL -- Terms and privacy links embedded cleanly.
{%- endcomment -%}

{%- liquid
  assign section_id = 'fb04-ftr-' | append: section.id
-%}

<style>
  #shopify-section-{{ section.id }} {
    --ftr-bg: {{ section.settings.bg_color | default: '#282A2F' }};
    --ftr-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    --ftr-muted: {{ section.settings.muted_color | default: '#9CA3AF' }};
    --ftr-primary: {{ section.settings.primary_color | default: '#0066FF' }};
    --ftr-border: rgba(255, 255, 255, 0.12);
  }

  .fb04-footer {
    background: var(--ftr-bg);
    color: var(--ftr-text);
    padding: 80px 0 36px;
  }

  .fb04-footer__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 3.75rem);
  }

  .fb04-footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 50px;
  }

  .fb04-footer__logo {
    font-family: 'Big Shoulders Display', var(--font-heading, sans-serif);
    font-weight: 800;
    font-size: 32px;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: #fff;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .fb04-footer__logo-dot {
    width: 8px;
    height: 8px;
    background: var(--ftr-primary);
    border-radius: 50%;
    display: inline-block;
  }

  .fb04-footer__about {
    font-family: var(--font-body, sans-serif);
    font-weight: 400;
    font-size: 14px;
    color: var(--ftr-muted);
    line-height: 1.65;
    max-width: 320px;
  }

  .fb04-footer__col-title {
    font-family: var(--font-body, sans-serif);
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #fff;
    margin-bottom: 22px;
  }

  .fb04-footer__nav {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
  }

  .fb04-footer__nav a {
    font-family: var(--font-body, sans-serif);
    font-size: 14px;
    color: var(--ftr-muted);
    transition: color 0.2s ease;
    text-decoration: none;
  }

  .fb04-footer__nav a:hover {
    color: #fff;
  }

  .fb04-footer__divider {
    border: none;
    border-top: 1px solid var(--ftr-border);
    margin-bottom: 28px;
  }

  .fb04-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    color: #6B7280;
  }

  .fb04-footer__socials {
    display: flex;
    gap: 16px;
  }

  .fb04-footer__link {
    color: var(--ftr-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .fb04-footer__link:hover {
    color: var(--ftr-primary);
  }

  @media (max-width: 809px) {
    .fb04-footer__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .fb04-footer__bottom {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
  }

  @media (min-width: 810px) and (max-width: 1199px) {
    .fb04-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<footer class="fb04-footer" id="{{ section_id }}">
  <div class="fb04-footer__container">

    <div class="fb04-footer__grid">
      <div>
        <div class="fb04-footer__logo">
          {{ section.settings.brand_name | default: 'RAWBLOX' }}
          <span class="fb04-footer__logo-dot"></span>
        </div>
        <p class="fb04-footer__about">
          {{ section.settings.about_text | default: 'Streetwear for the Bold, Built for the Movement. Inspired by the raw energy of the streets, we create statement pieces that blend style, attitude, and individuality.' }}
        </p>
      </div>

      <div>
        <h4 class="fb04-footer__col-title">Menu</h4>
        <ul class="fb04-footer__nav">
          <li><a href="#hero">Home</a></li>
          <li><a href="#drops">Shop</a></li>
          <li><a href="#story">About</a></li>
          <li><a href="#manifesto">Story</a></li>
          <li><a href="#trust">FAQ</a></li>
        </ul>
      </div>

      <div>
        <h4 class="fb04-footer__col-title">Shop</h4>
        <ul class="fb04-footer__nav">
          <li><a href="#drops">Collections</a></li>
          <li><a href="#drops">New Arrival</a></li>
          <li><a href="#categories">Men Collections</a></li>
          <li><a href="#categories">Women Collections</a></li>
          <li><a href="#featured">Accessories</a></li>
        </ul>
      </div>

      <div>
        <h4 class="fb04-footer__col-title">Social</h4>
        <ul class="fb04-footer__nav">
          <li><a href="https://instagram.com" target="_blank" rel="noopener">Instagram</a></li>
          <li><a href="https://tiktok.com" target="_blank" rel="noopener">TikTok</a></li>
          <li><a href="https://twitter.com" target="_blank" rel="noopener">Twitter</a></li>
          <li><a href="https://facebook.com" target="_blank" rel="noopener">Facebook</a></li>
          <li><a href="https://linkedin.com" target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
    </div>

    <hr class="fb04-footer__divider">

    <div class="fb04-footer__bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'RAWBLOX' }}. All rights reserved. Built with Frameblox 04 Style.</div>
      <div class="fb04-footer__socials">
        <a href="#" class="fb04-footer__link">Privacy Policy</a>
        <span>&bull;</span>
        <a href="#" class="fb04-footer__link">Terms of Service</a>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "FB04 Footer (Streetwear)",
  "tag": "section",
  "class": "section-fb04-footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "RAWBLOX"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About Text",
      "default": "Streetwear for the Bold, Built for the Movement. Inspired by the raw energy of the streets, we create statement pieces."
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#282A2F"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Accent",
      "default": "#0066FF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted Color",
      "default": "#9CA3AF"
    }
  ],
  "presets": [
    {
      "name": "FB04 Footer (Streetwear)",
      "settings": {
        "brand_name": "RAWBLOX"
      }
    }
  ]
}
{% endschema %}
