{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#F9F6F0'
  assign text_color = section.settings.text_color | default: '#2A3B2C'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
  }
  
  .hp10-cf-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
    background: #FFFFFF;
    border-radius: 40px;
    padding: 60px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.03);
  }
  
  .hp10-cf-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 40px;
  }
  
  .hp10-cf-heading-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: 2.5rem;
    font-weight: 400;
    margin: 0 0 15px 0;
  }
  
  .hp10-cf-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    color: rgba(42, 59, 44, 0.7);
  }
  
  .hp10-cf-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }
  
  .hp10-cf-input-{{ section_id }} {
    width: 100%;
    padding: 15px 20px;
    border: 1px solid rgba(42, 59, 44, 0.2);
    border-radius: 12px;
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: {{ text_color }};
    background: transparent;
    outline: none;
    box-sizing: border-box;
  }
  
  .hp10-cf-input-{{ section_id }}::placeholder {
    color: rgba(42, 59, 44, 0.4);
  }
  
  .hp10-cf-textarea-{{ section_id }} {
    grid-column: 1 / -1;
    min-height: 150px;
    resize: vertical;
  }
  
  .hp10-cf-btn-{{ section_id }} {
    width: 100%;
    padding: 16px;
    background: {{ text_color }};
    color: #FFFFFF;
    border: none;
    border-radius: 40px;
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }
  
  .hp10-cf-btn-{{ section_id }}:hover {
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .hp10-cf-container-{{ section_id }} {
      padding: 40px 20px;
    }
    .hp10-cf-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="hp10-cf-container-{{ section_id }}">
  <div class="hp10-cf-header-{{ section_id }}">
    <h2 class="hp10-cf-heading-{{ section_id }}">{{ section.settings.heading | default: 'Get in Touch' }}</h2>
    <p class="hp10-cf-text-{{ section_id }}">Have a question about our ingredients? We're here to help.</p>
  </div>
  
  <form action="#" method="post">
    <div class="hp10-cf-grid-{{ section_id }}">
      <input type="text" class="hp10-cf-input-{{ section_id }}" placeholder="First Name">
      <input type="text" class="hp10-cf-input-{{ section_id }}" placeholder="Last Name">
      <input type="email" class="hp10-cf-input-{{ section_id }}" placeholder="Email Address" style="grid-column: 1 / -1;">
      <textarea class="hp10-cf-input-{{ section_id }} hp10-cf-textarea-{{ section_id }}" placeholder="Your Message"></textarea>
    </div>
    <button type="submit" class="hp10-cf-btn-{{ section_id }}">Send Message</button>
  </form>
</div>

{% schema %}
{
  "name": "HP10 Contact Form",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F6F0"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    }
  ],
  "presets": [
    {
      "name": "HP10 Contact Form"
    }
  ]
}
{% endschema %}
