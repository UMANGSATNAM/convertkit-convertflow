{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FF00FF'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    border-bottom: 3px solid #000;
  }
  
  .hp11-contact-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
    background: #FFF;
    border: 4px solid #000;
    box-shadow: 12px 12px 0 #000;
    padding: 60px;
  }
  
  .hp11-contact-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 40px 0;
    color: #000;
  }
  
  .hp11-contact-form-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  
  .hp11-contact-input-{{ section_id }} {
    width: 100%;
    padding: 15px 20px;
    background: #F4F4F4;
    border: 3px solid #000;
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    outline: none;
    box-sizing: border-box;
  }
  
  .hp11-contact-input-{{ section_id }}:focus {
    background: #FFF;
    box-shadow: 4px 4px 0 #CCFF00;
  }
  
  .hp11-contact-btn-{{ section_id }} {
    width: 100%;
    padding: 20px;
    background: #000;
    color: #FFF;
    border: 3px solid #000;
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 900;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: 10px;
  }
  
  .hp11-contact-btn-{{ section_id }}:hover {
    background: #CCFF00;
    color: #000;
  }

  @media (max-width: 600px) {
    .hp11-contact-container-{{ section_id }} {
      padding: 30px;
    }
  }
</style>

<div class="hp11-contact-container-{{ section_id }}">
  <h2 class="hp11-contact-heading-{{ section_id }}">{{ section.settings.heading | default: 'HIT US UP' }}</h2>
  
  {% capture form_class %}hp11-contact-form-{{ section_id }}{% endcapture %}
        {% form 'contact', class: form_class %}
    <input type="text" name="contact[name]" class="hp11-contact-input-{{ section_id }}" placeholder="NAME" required>
    <input type="email" name="contact[email]" class="hp11-contact-input-{{ section_id }}" placeholder="EMAIL" required>
    <textarea name="contact[body]" rows="5" class="hp11-contact-input-{{ section_id }}" placeholder="MESSAGE" required></textarea>
    <button type="submit" class="hp11-contact-btn-{{ section_id }}">SEND IT</button>
  {% endform %}
</div>

{% schema %}
{
  "name": "HP11 Contact Form",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FF00FF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HIT US UP"
    }
  ],
  "presets": [
    {
      "name": "HP11 Contact Form"
    }
  ]
}
{% endschema %}
