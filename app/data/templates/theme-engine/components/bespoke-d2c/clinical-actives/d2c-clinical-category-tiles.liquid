{% comment %}
  D2C Clinical Actives Concern Grid
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<section class="d2c-clin-cats" id="d2c-ccats-{{ section.id }}">
  <div class="d2c-ccats-container">
    <div class="d2c-csec-header">
      <span class="d2c-c-badge">[LAB DIRECTORY]</span>
      <h2 class="d2c-c-title">{{ section.settings.title | default: "TARGET BY DERMATOLOGICAL CONCERN" }}</h2>
    </div>

    <div class="d2c-ccats-grid">
      <a href="/collections/acne-pores" class="d2c-ccat-card">
        <div class="d2c-ccat-thumb"><img src="https://images.unsplash.com/photo-1608248597359-2166946a482b?w=600&q=80" alt="Acne & Pores" /></div>
        <div class="d2c-ccat-info">
          <span class="d2c-ccat-act">SALICYLIC ACID • NIACINAMIDE</span>
          <h3 class="d2c-ccat-name">ACNE & ENLARGED PORES</h3>
          <span class="d2c-ccat-link">VIEW CLINICAL FORMULAS &rarr;</span>
        </div>
      </a>

      <a href="/collections/pigmentation" class="d2c-ccat-card">
        <div class="d2c-ccat-thumb"><img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=600&q=80" alt="Pigmentation" /></div>
        <div class="d2c-ccat-info">
          <span class="d2c-ccat-act">TRANEXAMIC • ALPHA ARBUTIN</span>
          <h3 class="d2c-ccat-name">PIGMENTATION & DARK SPOTS</h3>
          <span class="d2c-ccat-link">VIEW CLINICAL FORMULAS &rarr;</span>
        </div>
      </a>

      <a href="/collections/skin-barrier" class="d2c-ccat-card">
        <div class="d2c-ccat-thumb"><img src="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=600&q=80" alt="Skin Barrier" /></div>
        <div class="d2c-ccat-info">
          <span class="d2c-ccat-act">0.3% CERAMIDES • BISABOLOL</span>
          <h3 class="d2c-ccat-name">BARRIER REPAIR & RECOVERY</h3>
          <span class="d2c-ccat-link">VIEW CLINICAL FORMULAS &rarr;</span>
        </div>
      </a>

      <a href="/collections/anti-aging" class="d2c-ccat-card">
        <div class="d2c-ccat-thumb"><img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?w=600&q=80" alt="Anti Aging" /></div>
        <div class="d2c-ccat-info">
          <span class="d2c-ccat-act">GRANACTIVE RETINOID • PEPTIDES</span>
          <h3 class="d2c-ccat-name">FINE LINES & AGING</h3>
          <span class="d2c-ccat-link">VIEW CLINICAL FORMULAS &rarr;</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  #d2c-ccats-{{ section.id }} {
    background: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-ccats-container { max-width: 1320px; margin: 0 auto; }
  .d2c-csec-header { text-align: center; margin-bottom: 48px; }
  .d2c-c-badge { font-size: 11px; font-weight: 800; color: #0284c7; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 8px; display: block; font-family: monospace; }
  .d2c-c-title { font-size: clamp(26px, 3vw, 38px); font-weight: 900; color: #0f172a; letter-spacing: -0.5px; text-transform: uppercase; }
  .d2c-ccats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-ccat-card {
    background: #f8fafc;
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    border: 1px solid rgba(15, 23, 42, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.2s ease;
  }
  .d2c-ccat-card:hover { border-color: #0284c7; }
  .d2c-ccat-thumb { height: 260px; overflow: hidden; background: #e2e8f0; }
  .d2c-ccat-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-ccat-info { padding: 20px; display: flex; flex-direction: column; justify-content: space-between; flex-grow: 1; }
  .d2c-ccat-act { font-size: 10px; font-weight: 800; color: #0284c7; letter-spacing: 0.5px; margin-bottom: 6px; font-family: monospace; }
  .d2c-ccat-name { font-size: 14px; font-weight: 800; color: #0f172a; margin-bottom: 12px; }
  .d2c-ccat-link { font-size: 11px; font-weight: 800; color: #475569; }

  @media (max-width: 1024px) { .d2c-ccats-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-ccats-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Clinical Categories",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "TARGET BY DERMATOLOGICAL CONCERN"
    }
  ],
  "presets": [
    {
      "name": "Clinical Categories"
    }
  ]
}
{% endschema %}
