{% comment %}
  D2C Clinical Actives Hero Spotlight
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<section class="d2c-clin-spotlight" id="d2c-cspot-{{ section.id }}">
  <div class="d2c-cspot-container">
    <div class="d2c-cspot-card">
      <div class="d2c-cspot-media">
        <img src="https://images.unsplash.com/photo-1608248597359-2166946a482b?w=800&q=85" alt="10% Niacinamide + Zinc PCA" />
      </div>

      <div class="d2c-cspot-content">
        <span class="d2c-c-badge">[HERO ACTIVE]</span>
        <h2 class="d2c-cspot-title">{{ section.settings.title | default: "10% NIACINAMIDE + 1% ZINC PCA" }}</h2>
        <p class="d2c-cspot-desc">
          Formulated with pure Lonza Niacinamide (Vitamin B3) and Japanese Zinc PCA. Clinically proven to regulate excess sebum, minimize enlarged pores, and fade dark spots in 2 weeks.
        </p>

        <div class="d2c-cspot-matrix">
          <div class="d2c-cm-item"><span>PURITY:</span> <strong>Lonza Grade (99.5% Pure B3)</strong></div>
          <div class="d2c-cm-item"><span>FORMULATION pH:</span> <strong>5.5 - 6.0 (Skin Friendly)</strong></div>
          <div class="d2c-cm-item"><span>SAFETY:</span> <strong>Fragrance-Free • Non-Comedogenic</strong></div>
        </div>

        <div class="d2c-cspot-price-row">
          <span class="d2c-cspot-price">₹599</span>
          <span class="d2c-cspot-orig">₹699</span>
          <span class="d2c-cspot-tag">FREE SPF 50 MINI ON ₹799+</span>
        </div>

        <button class="d2c-cspot-btn">⚡ 1-CLICK FREE COD CHECKOUT &rarr;</button>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-cspot-{{ section.id }} {
    background: #f8fafc;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-cspot-container { max-width: 1320px; margin: 0 auto; }
  .d2c-cspot-card {
    background: #ffffff;
    border-radius: 8px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    align-items: center;
    border: 1px solid rgba(15, 23, 42, 0.08);
  }
  .d2c-cspot-media img { width: 100%; height: 460px; object-fit: cover; border-radius: 6px; }
  .d2c-cspot-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #0f172a; line-height: 1.15; margin: 10px 0 16px; text-transform: uppercase; }
  .d2c-cspot-desc { font-size: 15px; color: #475569; line-height: 1.6; margin-bottom: 24px; }
  .d2c-cspot-matrix {
    background: #f8fafc;
    border-radius: 6px;
    padding: 16px 20px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .d2c-cm-item { display: flex; justify-content: space-between; font-size: 12px; color: #475569; }
  .d2c-cm-item strong { color: #0f172a; }
  .d2c-cspot-price-row { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .d2c-cspot-price { font-size: 24px; font-weight: 900; color: #0f172a; font-family: monospace; }
  .d2c-cspot-orig { font-size: 14px; color: #94a3b8; text-decoration: line-through; }
  .d2c-cspot-tag { background: #dbeafe; color: #0284c7; font-size: 10px; font-weight: 800; padding: 4px 8px; border-radius: 4px; }
  .d2c-cspot-btn {
    width: 100%;
    background: #0f172a;
    color: #ffffff;
    border: none;
    padding: 16px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-cspot-btn:hover { background: #0284c7; }

  @media (max-width: 900px) {
    .d2c-cspot-card { grid-template-columns: 1fr; padding: 24px; }
    .d2c-cspot-media img { height: 300px; }
  }
</style>

{% schema %}
{
  "name": "Clinical Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "10% NIACINAMIDE + 1% ZINC PCA"
    }
  ],
  "presets": [
    {
      "name": "Clinical Spotlight"
    }
  ]
}
{% endschema %}
