{% comment %}
  D2C Clinical Actives Lab Footer
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<footer class="d2c-clin-footer" id="d2c-cfoot-{{ section.id }}">
  <div class="d2c-cfoot-container">
    <div class="d2c-cfoot-top">
      <div class="d2c-cfoot-brand">
        <h3 class="d2c-cfoot-logo">{{ section.settings.brand_name | default: "MINIMALIST LABS" }}</h3>
        <p class="d2c-cfoot-desc">Pioneering radical transparency in dermatology. High-purity active ingredients, optimal skin pH standards, and open published clinical trials.</p>
        <div class="d2c-cfoot-iso">🧪 ISO 22716 & GMP CERTIFIED LABS</div>
      </div>

      <div class="d2c-cfoot-col">
        <h4 class="d2c-ccol-title">ACTIVE CATEGORIES</h4>
        <ul class="d2c-ccol-links">
          <li><a href="/collections/niacinamide">Niacinamide 10% + Zinc</a></li>
          <li><a href="/collections/salicylic-acid">Salicylic Acid 2% (BHA)</a></li>
          <li><a href="/collections/ceramides">Ceramides 0.3% Barrier Cream</a></li>
          <li><a href="/collections/sunscreen">SPF 50 Multi-Vitamin Sunscreen</a></li>
          <li><a href="/pages/routine-builder">AM / PM Regimen Builder</a></li>
        </ul>
      </div>

      <div class="d2c-cfoot-col">
        <h4 class="d2c-ccol-title">CLINICAL SUPPORT</h4>
        <ul class="d2c-ccol-links">
          <li><a href="/pages/track-order">Track COD Delivery</a></li>
          <li><a href="/pages/returns">Easy Doorstep Returns</a></li>
          <li><a href="/pages/clinical-trials">Read Published Studies</a></li>
          <li><a href="/pages/ph-guide">Formulation pH Index</a></li>
          <li><a href="/pages/contact">WhatsApp Derm Support</a></li>
        </ul>
      </div>

      <div class="d2c-cfoot-col">
        <h4 class="d2c-ccol-title">TRANSPARENCY AUDIT</h4>
        <p class="d2c-cfoot-sub-desc">Every batch is tested for active assay purity, micro-biological safety, and pH stability prior to dispatch.</p>
      </div>
    </div>

    <div class="d2c-cfoot-bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: "MINIMALIST LABS PVT. LTD." }}. ALL RIGHTS RESERVED.</div>
      <div class="d2c-cfoot-legal">
        <a href="/policies/privacy-policy">Privacy Disclosure</a>
        <a href="/policies/terms-of-service">Terms of Supply</a>
        <a href="/policies/shipping-policy">COD Delivery Policy</a>
      </div>
    </div>
  </div>
</footer>

<style>
  #d2c-cfoot-{{ section.id }} {
    background: #0f172a;
    color: #94a3b8;
    padding: 70px 32px 30px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-cfoot-container { max-width: 1320px; margin: 0 auto; }
  .d2c-cfoot-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .d2c-cfoot-logo { font-size: 18px; font-weight: 900; color: #ffffff; letter-spacing: -0.5px; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-cfoot-desc { font-size: 13px; color: #94a3b8; line-height: 1.6; margin-bottom: 16px; max-width: 320px; }
  .d2c-cfoot-iso { font-size: 11px; font-weight: 800; color: #38bdf8; font-family: monospace; }
  .d2c-ccol-title { font-size: 12px; font-weight: 800; color: #ffffff; letter-spacing: 0.5px; margin-bottom: 16px; text-transform: uppercase; font-family: monospace; }
  .d2c-ccol-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .d2c-ccol-links a { color: #94a3b8; text-decoration: none; font-size: 13px; transition: color 0.15s ease; }
  .d2c-ccol-links a:hover { color: #38bdf8; }
  .d2c-cfoot-sub-desc { font-size: 13px; line-height: 1.6; }
  .d2c-cfoot-bottom {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
  }
  .d2c-cfoot-legal { display: flex; gap: 20px; }
  .d2c-cfoot-legal a { color: inherit; text-decoration: none; }
  .d2c-cfoot-legal a:hover { color: #ffffff; }

  @media (max-width: 1024px) { .d2c-cfoot-top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) {
    .d2c-cfoot-top { grid-template-columns: 1fr; }
    .d2c-cfoot-bottom { flex-direction: column; gap: 12px; text-align: center; }
  }
</style>

{% schema %}
{
  "name": "Clinical Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "MINIMALIST LABS"
    }
  ],
  "presets": [
    {
      "name": "Clinical Footer"
    }
  ]
}
{% endschema %}
