{% comment %}
  D2C Clinical Actives Real Results Wall
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<section class="d2c-clin-ugc" id="d2c-cugc-{{ section.id }}">
  <div class="d2c-cugc-container">
    <div class="d2c-csec-header">
      <span class="d2c-c-badge">[UNRETOUCHED RESULTS]</span>
      <h2 class="d2c-c-title">{{ section.settings.title | default: "OVER 2,500,000 VERIFIED PATIENTS" }}</h2>
    </div>

    <div class="d2c-cugc-grid">
      <div class="d2c-cugc-tile"><img src="https://images.unsplash.com/photo-1608248597359-2166946a482b?w=600&q=80" alt="Result 1" /><span>@rahul_skinlab · Day 28 Niacinamide</span></div>
      <div class="d2c-cugc-tile"><img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=600&q=80" alt="Result 2" /><span>@tanvi_derma · Week 3 Salicylic</span></div>
      <div class="d2c-cugc-tile"><img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?w=600&q=80" alt="Result 3" /><span>@ankit_barrier · Day 14 Ceramides</span></div>
      <div class="d2c-cugc-tile"><img src="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=600&q=80" alt="Result 4" /><span>@divya_glow · SPF 50 Routine</span></div>
    </div>
  </div>
</section>

<style>
  #d2c-cugc-{{ section.id }} {
    background: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-cugc-container { max-width: 1320px; margin: 0 auto; }
  .d2c-cugc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .d2c-cugc-tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: 6px;
    overflow: hidden;
    background: #f1f5f9;
    border: 1px solid rgba(15, 23, 42, 0.08);
  }
  .d2c-cugc-tile img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-cugc-tile span {
    position: absolute;
    bottom: 8px;
    left: 8px;
    right: 8px;
    background: rgba(15, 23, 42, 0.85);
    color: #f8fafc;
    font-size: 10px;
    font-weight: 700;
    padding: 6px;
    text-align: center;
    border-radius: 4px;
    font-family: monospace;
  }

  @media (max-width: 900px) { .d2c-cugc-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

{% schema %}
{
  "name": "Clinical Community",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "OVER 2,500,000 VERIFIED PATIENTS"
    }
  ],
  "presets": [
    {
      "name": "Clinical Community"
    }
  ]
}
{% endschema %}
