{% comment %}
  D2C Clinical Actives Announcement Bar
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<div class="d2c-clin-announcement" id="d2c-cann-{{ section.id }}">
  <div class="d2c-cann-inner">
    <span class="d2c-cann-tag">🧪 100% INGREDIENT TRANSPARENCY</span>
    <span class="d2c-cann-text">{{ section.settings.text | default: "FRAGRANCE-FREE • NON-COMEDOGENIC • FREE CASH ON DELIVERY NATIONWIDE" }}</span>
    <a href="/pages/clinical-trials" class="d2c-cann-link">VIEW LAB TRIALS &rarr;</a>
  </div>
</div>

<style>
  #d2c-cann-{{ section.id }} {
    background: #0f172a;
    color: #f8fafc;
    padding: 10px 16px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
    font-size: 12px;
    font-weight: 700;
    text-align: center;
  }
  .d2c-cann-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
  }
  .d2c-cann-tag { color: #38bdf8; font-weight: 800; }
  .d2c-cann-link { color: #38bdf8; text-decoration: underline; }
  @media (max-width: 768px) { #d2c-cann-{{ section.id }} { font-size: 11px; padding: 8px 12px; } .d2c-cann-link { display: none; } }
</style>

{% schema %}
{
  "name": "Clinical Announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "FRAGRANCE-FREE • NON-COMEDOGENIC • FREE CASH ON DELIVERY NATIONWIDE"
    }
  ],
  "presets": [
    {
      "name": "Clinical Announcement"
    }
  ]
}
{% endschema %}
