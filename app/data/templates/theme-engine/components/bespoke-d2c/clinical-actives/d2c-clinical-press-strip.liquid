{% comment %}
  D2C Clinical Actives Press Strip
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<section class="d2c-clin-press" id="d2c-cpress-{{ section.id }}">
  <div class="d2c-cpress-container">
    <span class="d2c-cpress-label">[SCIENCE CITATIONS & PRESS]</span>
    <div class="d2c-cpress-logos">
      <span class="d2c-cplogo">HEALTHLINE DERMA</span>
      <span class="d2c-cplogo">VOGUE BEAUTY LAB</span>
      <span class="d2c-cplogo">INDIAN DERMA JOURNAL</span>
      <span class="d2c-cplogo">COSMOPOLITAN SCI-BEAUTY</span>
      <span class="d2c-cplogo">THE ECONOMIC TIMES</span>
    </div>
  </div>
</section>

<style>
  #d2c-cpress-{{ section.id }} {
    background: #f8fafc;
    padding: 30px 32px;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-cpress-container {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .d2c-cpress-label { font-size: 11px; font-weight: 800; color: #0284c7; letter-spacing: 1px; font-family: monospace; }
  .d2c-cpress-logos { display: flex; gap: 36px; align-items: center; flex-wrap: wrap; }
  .d2c-cplogo { font-size: 13px; font-weight: 800; color: #475569; letter-spacing: 0.5px; }

  @media (max-width: 768px) {
    .d2c-cpress-container { justify-content: center; text-align: center; }
    .d2c-cpress-logos { justify-content: center; gap: 20px; }
  }
</style>

{% schema %}
{
  "name": "Clinical Press Strip",
  "settings": [],
  "presets": [
    {
      "name": "Clinical Press Strip"
    }
  ]
}
{% endschema %}
