{% comment %}
  D2C Clinical Actives Promo Banner
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<section class="d2c-clin-promo" id="d2c-cpromo-{{ section.id }}">
  <div class="d2c-cpromo-container">
    <div class="d2c-cpromo-card">
      <span class="d2c-c-badge" style="color: #38bdf8;">[LAB SAMPLING EVENT]</span>
      <h2 class="d2c-cpromo-title">{{ section.settings.title | default: "FREE FULL-SIZE SPF 50 SUNSCREEN ON ORDERS ABOVE ₹799" }}</h2>
      <p class="d2c-cpromo-desc">Ultra-lightweight invisible mineral fluid with zero white cast. Automatically added to your cart with zero coupon required.</p>
      <a href="/collections/all" class="d2c-cpromo-btn">CLAIM LAB GIFT &rarr;</a>
    </div>
  </div>
</section>

<style>
  #d2c-cpromo-{{ section.id }} {
    background: #ffffff;
    padding: 50px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-cpromo-container { max-width: 1320px; margin: 0 auto; }
  .d2c-cpromo-card {
    background: #0f172a;
    color: #ffffff;
    border-radius: 8px;
    padding: 56px 36px;
    text-align: center;
  }
  .d2c-cpromo-title { font-size: clamp(26px, 3.5vw, 40px); font-weight: 900; letter-spacing: -0.5px; margin: 10px 0 14px; text-transform: uppercase; }
  .d2c-cpromo-desc { font-size: 15px; color: #94a3b8; max-width: 580px; margin: 0 auto 28px; line-height: 1.6; }
  .d2c-cpromo-btn {
    display: inline-block;
    background: #0284c7;
    color: #ffffff;
    padding: 14px 32px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
  }
  .d2c-cpromo-btn:hover { background: #0369a1; }
</style>

{% schema %}
{
  "name": "Clinical Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FREE FULL-SIZE SPF 50 SUNSCREEN ON ORDERS ABOVE ₹799"
    }
  ],
  "presets": [
    {
      "name": "Clinical Promo Banner"
    }
  ]
}
{% endschema %}
