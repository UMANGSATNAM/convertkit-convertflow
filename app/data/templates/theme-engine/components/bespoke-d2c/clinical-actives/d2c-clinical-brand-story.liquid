{% comment %}
  D2C Clinical Actives Lab Story
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<section class="d2c-clin-story" id="d2c-cstory-{{ section.id }}">
  <div class="d2c-cstory-container">
    <div class="d2c-cstory-grid">
      <div class="d2c-cstory-content">
        <span class="d2c-c-badge">[THE SCIENTIFIC RATIONALE]</span>
        <h2 class="d2c-cstory-title">{{ section.settings.title | default: "RADICAL TRANSPARENCY OVER BEAUTY MARKETING" }}</h2>
        <p class="d2c-cstory-para">
          The traditional skincare industry thrived on secret fairy-tale ingredients, exotic marketing stories, and vague percentages.
        </p>
        <p class="d2c-cstory-para">
          We founded our laboratory on an uncompromising premise: show the exact active percentage, declare the global raw material suppliers, maintain skin physiological pH, and let peer-reviewed clinical trials speak for themselves.
        </p>
        <div class="d2c-cstory-stats">
          <div><span class="d2c-cst-num">100%</span><span class="d2c-cst-lbl">Declared Actives</span></div>
          <div><span class="d2c-cst-num">0%</span><span class="d2c-cst-lbl">Fragrance / Dyes</span></div>
          <div><span class="d2c-cst-num">4.9 ★</span><span class="d2c-cst-lbl">Clinical Efficacy</span></div>
        </div>
      </div>

      <div class="d2c-cstory-media">
        <img src="https://images.unsplash.com/photo-1608248597359-2166946a482b?w=800&q=80" alt="Laboratory Formulation" />
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-cstory-{{ section.id }} {
    background: #ffffff;
    padding: 80px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-cstory-container { max-width: 1320px; margin: 0 auto; }
  .d2c-cstory-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }
  .d2c-cstory-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 900; color: #0f172a; line-height: 1.15; margin: 10px 0 20px; text-transform: uppercase; }
  .d2c-cstory-para { font-size: 15px; color: #475569; line-height: 1.7; margin-bottom: 18px; }
  .d2c-cstory-stats {
    display: flex;
    gap: 36px;
    border-top: 1px solid rgba(15, 23, 42, 0.1);
    padding-top: 24px;
    margin-top: 28px;
  }
  .d2c-cst-num { font-size: 24px; font-weight: 900; color: #0284c7; display: block; font-family: monospace; }
  .d2c-cst-lbl { font-size: 11px; color: #64748b; font-weight: 700; text-transform: uppercase; }
  .d2c-cstory-media img { width: 100%; height: 440px; object-fit: cover; border-radius: 8px; border: 1px solid rgba(15, 23, 42, 0.08); }

  @media (max-width: 900px) {
    .d2c-cstory-grid { grid-template-columns: 1fr; }
    .d2c-cstory-media img { height: 320px; }
  }
</style>

{% schema %}
{
  "name": "Clinical Story",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "RADICAL TRANSPARENCY OVER BEAUTY MARKETING"
    }
  ],
  "presets": [
    {
      "name": "Clinical Story"
    }
  ]
}
{% endschema %}
