{% comment %}
  D2C Clinical Actives Science Newsletter
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<section class="d2c-clin-news" id="d2c-cnews-{{ section.id }}">
  <div class="d2c-cnews-container">
    <div class="d2c-cnews-card">
      <span class="d2c-c-badge">[THE DERMA BULLETIN]</span>
      <h2 class="d2c-cnews-title">{{ section.settings.title | default: "RECEIVE PEER-REVIEWED ACTIVE STUDIES" }}</h2>
      <p class="d2c-cnews-desc">Join 120,000+ conscious consumers receiving clinical research summaries and pH compatibility guides.</p>

      <form class="d2c-cnews-form">
        <input type="email" placeholder="Enter your email address" class="d2c-cnews-input" required />
        <button type="submit" class="d2c-cnews-btn">SUBSCRIBE &rarr;</button>
      </form>
      <div class="d2c-cnews-privacy">🔒 Zero marketing spam. Pure clinical data and release notes.</div>
    </div>
  </div>
</section>

<style>
  #d2c-cnews-{{ section.id }} {
    background: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-cnews-container { max-width: 860px; margin: 0 auto; }
  .d2c-cnews-card {
    background: #f8fafc;
    border-radius: 8px;
    padding: 48px 36px;
    text-align: center;
    border: 1px solid rgba(15, 23, 42, 0.08);
  }
  .d2c-cnews-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #0f172a; margin: 10px 0 12px; text-transform: uppercase; }
  .d2c-cnews-desc { font-size: 15px; color: #475569; margin-bottom: 28px; }
  .d2c-cnews-form { display: flex; gap: 10px; max-width: 480px; margin: 0 auto 14px; }
  .d2c-cnews-input {
    flex: 1;
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.15);
    padding: 14px 18px;
    border-radius: 4px;
    font-size: 14px;
    outline: none;
  }
  .d2c-cnews-input:focus { border-color: #0284c7; }
  .d2c-cnews-btn {
    background: #0f172a;
    color: #ffffff;
    border: none;
    padding: 14px 28px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-cnews-btn:hover { background: #0284c7; }
  .d2c-cnews-privacy { font-size: 12px; color: #94a3b8; }

  @media (max-width: 600px) {
    .d2c-cnews-form { flex-direction: column; }
    .d2c-cnews-card { padding: 32px 20px; }
  }
</style>

{% schema %}
{
  "name": "Clinical Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "RECEIVE PEER-REVIEWED ACTIVE STUDIES"
    }
  ],
  "presets": [
    {
      "name": "Clinical Newsletter"
    }
  ]
}
{% endschema %}
