{% comment %}
  D2C Clinical Actives Clinical Trial Reels
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<section class="d2c-clin-reels" id="d2c-creels-{{ section.id }}">
  <div class="d2c-creels-container">
    <div class="d2c-csec-header">
      <span class="d2c-c-badge">[LAB EVIDENCE]</span>
      <h2 class="d2c-c-title">{{ section.settings.title | default: "4-WEEK INDEPENDENT CLINICAL TRIALS" }}</h2>
    </div>

    <div class="d2c-creels-grid">
      <div class="d2c-creel-card">
        <img src="https://images.unsplash.com/photo-1608248597359-2166946a482b?w=600&q=80" alt="Niacinamide Trial" />
        <div class="d2c-creel-overlay">
          <span class="d2c-creel-stat">89% REDUCED PORES</span>
          <h4 class="d2c-creel-name">Week 4 · 10% Niacinamide Trial</h4>
          <span class="d2c-creel-pill">Niacinamide 10% · ₹599</span>
        </div>
      </div>

      <div class="d2c-creel-card">
        <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=600&q=80" alt="Salicylic Acid Trial" />
        <div class="d2c-creel-overlay">
          <span class="d2c-creel-stat">92% CLEARED BLACKHEADS</span>
          <h4 class="d2c-creel-name">Week 3 · 2% Salicylic Acid Trial</h4>
          <span class="d2c-creel-pill">Salicylic Acid 2% · ₹549</span>
        </div>
      </div>

      <div class="d2c-creel-card">
        <img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?w=600&q=80" alt="Ceramide Barrier Trial" />
        <div class="d2c-creel-overlay">
          <span class="d2c-creel-stat">97% BARRIER RECOVERY</span>
          <h4 class="d2c-creel-name">Day 14 · Ceramide 0.3% Trial</h4>
          <span class="d2c-creel-pill">Ceramide Cream · ₹599</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-creels-{{ section.id }} {
    background: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-creels-container { max-width: 1320px; margin: 0 auto; }
  .d2c-creels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .d2c-creel-card {
    position: relative;
    aspect-ratio: 9/16;
    border-radius: 8px;
    overflow: hidden;
    background: #f1f5f9;
    border: 1px solid rgba(15, 23, 42, 0.08);
    cursor: pointer;
  }
  .d2c-creel-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .d2c-creel-card:hover img { transform: scale(1.04); }
  .d2c-creel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15,23,42,0.92) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: #ffffff;
  }
  .d2c-creel-stat { font-size: 10px; font-weight: 800; color: #38bdf8; letter-spacing: 1px; margin-bottom: 4px; font-family: monospace; }
  .d2c-creel-name { font-size: 14px; font-weight: 800; margin-bottom: 12px; }
  .d2c-creel-pill {
    background: #ffffff;
    color: #0f172a;
    font-size: 11px;
    font-weight: 800;
    padding: 6px 12px;
    border-radius: 4px;
    display: inline-block;
    align-self: flex-start;
  }

  @media (max-width: 900px) { .d2c-creels-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Clinical Reels",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "4-WEEK INDEPENDENT CLINICAL TRIALS"
    }
  ],
  "presets": [
    {
      "name": "Clinical Reels"
    }
  ]
}
{% endschema %}
