{% comment %}
  D2C Clinical Actives Bestsellers Grid
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<section class="d2c-clin-best" id="d2c-cbest-{{ section.id }}">
  <div class="d2c-cbest-container">
    <div class="d2c-csec-header">
      <span class="d2c-c-badge">[PROVEN FORMULATIONS]</span>
      <h2 class="d2c-c-title">{{ section.settings.title | default: "CORE ACTIVE BENCHMARKS" }}</h2>
    </div>

    <div class="d2c-cprod-grid">
      <!-- Item 1 -->
      <div class="d2c-cprod-card">
        <div class="d2c-cprod-thumb">
          <span class="d2c-cprod-pill">pH 5.5 - 6.0</span>
          <img src="https://images.unsplash.com/photo-1608248597359-2166946a482b?w=600&q=80" alt="Niacinamide 10%" />
        </div>
        <div class="d2c-cprod-body">
          <span class="d2c-cprod-pct">10% NIACINAMIDE + 1% ZINC</span>
          <h3 class="d2c-cprod-title">Pore Refining & Oil Control Serum</h3>
          <div class="d2c-cprod-price">₹599 <span class="d2c-cprod-orig">₹699</span></div>
          <button class="d2c-catc-btn">+ ADD TO REGIMEN</button>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="d2c-cprod-card">
        <div class="d2c-cprod-thumb">
          <span class="d2c-cprod-pill">pH 3.5 - 4.0</span>
          <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=600&q=80" alt="Salicylic Acid 2%" />
        </div>
        <div class="d2c-cprod-body">
          <span class="d2c-cprod-pct">2% SALICYLIC ACID + LHA</span>
          <h3 class="d2c-cprod-title">Blackhead & Acne Exfoliating Serum</h3>
          <div class="d2c-cprod-price">₹549 <span class="d2c-cprod-orig">₹649</span></div>
          <button class="d2c-catc-btn">+ ADD TO REGIMEN</button>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="d2c-cprod-card">
        <div class="d2c-cprod-thumb">
          <span class="d2c-cprod-pill">PA++++ UVA/UVB</span>
          <img src="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=600&q=80" alt="SPF 50 Sunscreen" />
        </div>
        <div class="d2c-cprod-body">
          <span class="d2c-cprod-pct">SPF 50 INVISIBLE FLUID</span>
          <h3 class="d2c-cprod-title">Multi-Vitamin Lightweight Sunscreen</h3>
          <div class="d2c-cprod-price">₹499 <span class="d2c-cprod-orig">₹599</span></div>
          <button class="d2c-catc-btn">+ ADD TO REGIMEN</button>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="d2c-cprod-card">
        <div class="d2c-cprod-thumb">
          <span class="d2c-cprod-pill">5 ESSENTIAL CERAMIDES</span>
          <img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?w=600&q=80" alt="Ceramides 0.3%" />
        </div>
        <div class="d2c-cprod-body">
          <span class="d2c-cprod-pct">0.3% CERAMIDES + MADECASSOSIDE</span>
          <h3 class="d2c-cprod-title">Barrier Relief Deep Moisturizer</h3>
          <div class="d2c-cprod-price">₹599 <span class="d2c-cprod-orig">₹699</span></div>
          <button class="d2c-catc-btn">+ ADD TO REGIMEN</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-cbest-{{ section.id }} {
    background: #f8fafc;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-cbest-container { max-width: 1320px; margin: 0 auto; }
  .d2c-cprod-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .d2c-cprod-card {
    background: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .d2c-cprod-thumb { position: relative; aspect-ratio: 1; overflow: hidden; background: #f1f5f9; }
  .d2c-cprod-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-cprod-pill {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #0f172a;
    color: #38bdf8;
    font-size: 9px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
    font-family: monospace;
  }
  .d2c-cprod-body { padding: 18px; display: flex; flex-direction: column; flex-grow: 1; justify-content: space-between; }
  .d2c-cprod-pct { font-size: 10px; font-weight: 800; color: #0284c7; letter-spacing: 0.5px; margin-bottom: 4px; font-family: monospace; }
  .d2c-cprod-title { font-size: 14px; font-weight: 800; color: #0f172a; margin-bottom: 8px; }
  .d2c-cprod-price { font-size: 15px; font-weight: 900; color: #0f172a; margin-bottom: 14px; font-family: monospace; }
  .d2c-cprod-orig { font-size: 12px; color: #94a3b8; text-decoration: line-through; margin-left: 6px; }
  .d2c-catc-btn {
    width: 100%;
    background: #0f172a;
    color: #ffffff;
    border: none;
    padding: 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-catc-btn:hover { background: #0284c7; }

  @media (max-width: 1024px) { .d2c-cprod-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-cprod-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } .d2c-cprod-body { padding: 12px; } }
</style>

{% schema %}
{
  "name": "Clinical Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "CORE ACTIVE BENCHMARKS"
    }
  ],
  "presets": [
    {
      "name": "Clinical Bestsellers"
    }
  ]
}
{% endschema %}
