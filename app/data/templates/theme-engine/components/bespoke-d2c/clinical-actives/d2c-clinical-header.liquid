{% comment %}
  D2C Clinical Actives Lab Header
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<header class="d2c-clin-header" id="d2c-chead-{{ section.id }}">
  <div class="d2c-chead-container">
    <a href="/" class="d2c-chead-logo">
      <span class="d2c-clogo-bold">{{ section.settings.brand_name | default: "MINIMALIST LABS" }}</span>
      <span class="d2c-clogo-sub">[RADICAL TRANSPARENCY]</span>
    </a>

    <nav class="d2c-chead-nav">
      <a href="/collections/serums" class="d2c-cnav-link active">ACTIVE SERUMS</a>
      <a href="/collections/acne-solutions" class="d2c-cnav-link">ACNE & PORES</a>
      <a href="/collections/sunscreen" class="d2c-cnav-link">SUN PROTECTION</a>
      <a href="/collections/barrier-repair" class="d2c-cnav-link">CERAMIDES</a>
      <a href="/pages/routine-builder" class="d2c-cnav-link badge">AM/PM BUILDER</a>
    </nav>

    <div class="d2c-chead-actions">
      <a href="/account" class="d2c-chead-btn">LOGIN</a>
      <a href="/cart" class="d2c-chead-cart">CART ({{ cart.item_count | default: 0 }})</a>
    </div>
  </div>
</header>

<style>
  #d2c-chead-{{ section.id }} {
    background: #ffffff;
    border-bottom: 1px solid rgba(15, 23, 42, 0.1);
    padding: 16px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  .d2c-chead-container {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .d2c-chead-logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }
  .d2c-clogo-bold {
    font-size: 18px;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.5px;
    text-transform: uppercase;
  }
  .d2c-clogo-sub {
    font-size: 9px;
    color: #0284c7;
    font-weight: 800;
    letter-spacing: 1px;
  }
  .d2c-chead-nav { display: flex; gap: 24px; align-items: center; }
  .d2c-cnav-link {
    color: #475569;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .d2c-cnav-link:hover, .d2c-cnav-link.active { color: #0f172a; }
  .d2c-cnav-link.badge {
    background: #0f172a;
    color: #ffffff;
    padding: 5px 12px;
    border-radius: 4px;
    font-size: 11px;
  }
  .d2c-chead-actions { display: flex; gap: 16px; align-items: center; }
  .d2c-chead-btn { color: #475569; font-size: 12px; font-weight: 700; text-decoration: none; }
  .d2c-chead-cart {
    background: #0284c7;
    color: #ffffff;
    padding: 8px 16px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .d2c-chead-nav { display: none; }
    #d2c-chead-{{ section.id }} { padding: 12px 18px; }
  }
</style>

{% schema %}
{
  "name": "Clinical Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "MINIMALIST LABS"
    }
  ],
  "presets": [
    {
      "name": "Clinical Header"
    }
  ]
}
{% endschema %}
