{% comment %}
  D2C Clinical Actives Lab Split Hero
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<section class="d2c-clin-hero" id="d2c-chero-{{ section.id }}">
  <div class="d2c-chero-container">
    <div class="d2c-chero-grid">
      <div class="d2c-chero-text">
        <span class="d2c-chero-badge">🔬 DERMATOLOGIST PROVEN ACTIVES</span>
        <h1 class="d2c-chero-title">{{ section.settings.heading | default: "RADICAL INGREDIENT TRANSPARENCY" }}</h1>
        <p class="d2c-chero-desc">
          No marketing fluff, no exaggerated claims. High-purity active concentrations backed by published clinical trials. Formulated at optimal skin pH (5.5 - 6.0) for maximum bioavailability.
        </p>

        <div class="d2c-chero-actions">
          <a href="/collections/all" class="d2c-cbtn-primary">EXPLORE ACTIVE FORMULAS &rarr;</a>
          <a href="/pages/routine-builder" class="d2c-cbtn-secondary">BUILD YOUR AM/PM REGIMEN</a>
        </div>

        <div class="d2c-chero-actives-row">
          <div class="d2c-ca-box">
            <span class="d2c-ca-pct">10%</span>
            <span class="d2c-ca-name">Niacinamide + Zinc</span>
          </div>
          <div class="d2c-ca-box">
            <span class="d2c-ca-pct">2%</span>
            <span class="d2c-ca-name">Salicylic Acid (BHA)</span>
          </div>
          <div class="d2c-ca-box">
            <span class="d2c-ca-pct">0.3%</span>
            <span class="d2c-ca-name">Pure Retinol In Squalane</span>
          </div>
        </div>
      </div>

      <div class="d2c-chero-media">
        <img src="https://images.unsplash.com/photo-1608248597359-2166946a482b?w=900&q=85" alt="Clinical Skincare Bottle" />
        <div class="d2c-chero-labcard">
          <span class="d2c-clc-tag">CLINICALLY AUDITED</span>
          <h4 class="d2c-clc-title">10% Niacinamide + 1% Zinc PCA</h4>
          <p class="d2c-clc-res">89% saw reduced sebum and pore refinement in 14 days.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-chero-{{ section.id }} {
    background: #f8fafc;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-chero-container { max-width: 1320px; margin: 0 auto; }
  .d2c-chero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: center;
  }
  .d2c-chero-badge {
    font-size: 11px;
    font-weight: 800;
    color: #0284c7;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 16px;
    display: block;
    font-family: monospace;
  }
  .d2c-chero-title {
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 900;
    color: #0f172a;
    line-height: 1.1;
    letter-spacing: -1px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }
  .d2c-chero-desc {
    font-size: 16px;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 520px;
  }
  .d2c-chero-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }
  .d2c-cbtn-primary {
    background: #0f172a;
    color: #ffffff;
    padding: 16px 32px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    text-decoration: none;
  }
  .d2c-cbtn-secondary {
    background: transparent;
    border: 1px solid #0f172a;
    color: #0f172a;
    padding: 16px 28px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    text-decoration: none;
  }
  .d2c-chero-actives-row {
    display: flex;
    gap: 20px;
    border-top: 1px solid rgba(15, 23, 42, 0.1);
    padding-top: 24px;
  }
  .d2c-ca-box {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 6px;
    padding: 12px 16px;
    flex: 1;
  }
  .d2c-ca-pct { font-size: 20px; font-weight: 900; color: #0284c7; display: block; font-family: monospace; }
  .d2c-ca-name { font-size: 11px; font-weight: 700; color: #475569; }
  .d2c-chero-media {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
  }
  .d2c-chero-media img { width: 100%; height: 480px; object-fit: cover; }
  .d2c-chero-labcard {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(10px);
    padding: 18px 20px;
    border-radius: 8px;
    color: #ffffff;
  }
  .d2c-clc-tag { font-size: 10px; font-weight: 800; color: #38bdf8; letter-spacing: 1px; margin-bottom: 4px; display: block; font-family: monospace; }
  .d2c-clc-title { font-size: 14px; font-weight: 800; margin-bottom: 4px; }
  .d2c-clc-res { font-size: 12px; color: #cbd5e1; }

  @media (max-width: 900px) {
    .d2c-chero-grid { grid-template-columns: 1fr; }
    .d2c-chero-media img { height: 340px; }
    #d2c-chero-{{ section.id }} { padding: 40px 18px; }
  }
</style>

{% schema %}
{
  "name": "Clinical Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "RADICAL INGREDIENT TRANSPARENCY"
    }
  ],
  "presets": [
    {
      "name": "Clinical Hero"
    }
  ]
}
{% endschema %}
