{% comment %}
  D2C Clinical Actives AM / PM Regimen Grid
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<section class="d2c-clin-regimen" id="d2c-creg-{{ section.id }}">
  <div class="d2c-creg-container">
    <div class="d2c-csec-header">
      <span class="d2c-c-badge">[LAB PROTOCOLS]</span>
      <h2 class="d2c-c-title">{{ section.settings.title | default: "DERMATOLOGIST AM / PM LAYER ORDER" }}</h2>
    </div>

    <div class="d2c-creg-grid">
      <div class="d2c-creg-card large">
        <img src="https://images.unsplash.com/photo-1608248597359-2166946a482b?w=800&q=80" alt="AM Routine" />
        <div class="d2c-creg-overlay">
          <span class="d2c-creg-step">AM PROTOCOL // PROTECT</span>
          <h3 class="d2c-creg-name">VITAMIN C 10% + SPF 50 FLUID</h3>
          <span class="d2c-creg-link">VIEW AM PROTOCOL &rarr;</span>
        </div>
      </div>

      <div class="d2c-creg-card">
        <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=600&q=80" alt="PM Exfoliation" />
        <div class="d2c-creg-overlay">
          <span class="d2c-creg-step">PM MON/WED // UNCLOG</span>
          <h3 class="d2c-creg-name">2% SALICYLIC ACID PEEL</h3>
          <span class="d2c-creg-link">VIEW &rarr;</span>
        </div>
      </div>

      <div class="d2c-creg-card">
        <img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?w=600&q=80" alt="PM Repair" />
        <div class="d2c-creg-overlay">
          <span class="d2c-creg-step">PM DAILY // REPAIR</span>
          <h3 class="d2c-creg-name">0.3% CERAMIDE BARRIER CREAM</h3>
          <span class="d2c-creg-link">VIEW &rarr;</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-creg-{{ section.id }} {
    background: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-creg-container { max-width: 1320px; margin: 0 auto; }
  .d2c-creg-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 24px;
  }
  .d2c-creg-card {
    position: relative;
    height: 460px;
    border-radius: 8px;
    overflow: hidden;
    background: #f1f5f9;
    border: 1px solid rgba(15, 23, 42, 0.08);
  }
  .d2c-creg-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .d2c-creg-card:hover img { transform: scale(1.04); }
  .d2c-creg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15,23,42,0.92) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px;
    color: #ffffff;
  }
  .d2c-creg-step { font-size: 10px; font-weight: 800; color: #38bdf8; letter-spacing: 1px; margin-bottom: 4px; font-family: monospace; }
  .d2c-creg-name { font-size: 16px; font-weight: 800; margin-bottom: 8px; }
  .d2c-creg-link { font-size: 11px; font-weight: 800; color: #cbd5e1; }

  @media (max-width: 900px) {
    .d2c-creg-grid { grid-template-columns: 1fr; }
    .d2c-creg-card { height: 340px; }
  }
</style>

{% schema %}
{
  "name": "Clinical Regimen Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "DERMATOLOGIST AM / PM LAYER ORDER"
    }
  ],
  "presets": [
    {
      "name": "Clinical Regimen Grid"
    }
  ]
}
{% endschema %}
