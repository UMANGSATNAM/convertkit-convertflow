{% comment %}
  -----------------------------------------------------------------------------
  10X Bespoke D2C Architecture: Minimalist / The Derma Co - Fabric & Technical Matrix
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'd2c-clinical-fabric-tech'
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#0f172a'
  assign accent_color = section.settings.accent_color | default: '#0284c7'
  assign title = section.settings.title | default: 'MATERIAL & FABRIC SCIENCE'
  assign subtitle = section.settings.subtitle | default: 'BUILT TO OUTLAST 100+ WASHES'
-%}

<section id="d2c-tech-{{ sec_id }}" class="d2c-tech-wrap">
  <div class="d2c-tech-container">
    <div class="d2c-tech-header">
      <span class="d2c-tech-sub">{{ subtitle }}</span>
      <h2 class="d2c-tech-title">{{ title }}</h2>
    </div>

    <div class="d2c-tech-grid">
      
      <div class="d2c-tech-card">
        <div class="d2c-tech-icon">🔬</div>
        <h3 class="d2c-tech-card-title">100% Transparent Formula Disclosure</h3>
        <p class="d2c-tech-desc">Every active concentration and ingredient grade published openly.</p>
        <div class="d2c-tech-badge">SPEC GRADE 01</div>
      </div>
      
      <div class="d2c-tech-card">
        <div class="d2c-tech-icon">🧪</div>
        <h3 class="d2c-tech-card-title">Medical-Grade Stabilized Actives</h3>
        <p class="d2c-tech-desc">Sourced from premier bio-laboratories in Switzerland & Germany.</p>
        <div class="d2c-tech-badge">SPEC GRADE 02</div>
      </div>
      
      <div class="d2c-tech-card">
        <div class="d2c-tech-icon">📊</div>
        <h3 class="d2c-tech-card-title">pH Balanced for Optimal Skin Uptake</h3>
        <p class="d2c-tech-desc">Engineered at pH 5.0 - 5.5 to prevent irritation while maximizing efficacy.</p>
        <div class="d2c-tech-badge">SPEC GRADE 03</div>
      </div>
      
      <div class="d2c-tech-card">
        <div class="d2c-tech-icon">📋</div>
        <h3 class="d2c-tech-card-title">Dermatologist Approved Clinical Trials</h3>
        <p class="d2c-tech-desc">Double-blind clinical data confirming 89% reduction in dark spots.</p>
        <div class="d2c-tech-badge">SPEC GRADE 04</div>
      </div>
      
    </div>
  </div>
</section>

<style>
  #d2c-tech-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Inter', sans-serif;
    border-top: 1px solid rgba(2, 132, 199, 0.15);
    border-bottom: 1px solid rgba(2, 132, 199, 0.15);
  }
  #d2c-tech-{{ sec_id }} .d2c-tech-container { max-width: 1320px; margin: 0 auto; }
  #d2c-tech-{{ sec_id }} .d2c-tech-header { text-align: center; margin-bottom: 40px; }
  #d2c-tech-{{ sec_id }} .d2c-tech-sub { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #d2c-tech-{{ sec_id }} .d2c-tech-title { font-family: 'Space Grotesk', sans-serif; font-size: clamp(26px, 3.5vw, 40px); font-weight: 900; margin: 6px 0 0 0; }

  #d2c-tech-{{ sec_id }} .d2c-tech-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  #d2c-tech-{{ sec_id }} .d2c-tech-card {
    background: #f8fafc;
    border: 1px solid rgba(2, 132, 199, 0.15);
    border-radius: 14px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease;
  }
  #d2c-tech-{{ sec_id }} .d2c-tech-card:hover { transform: translateY(-4px); border-color: {{ accent_color }}; }
  #d2c-tech-{{ sec_id }} .d2c-tech-icon { font-size: 28px; margin-bottom: 14px; }
  #d2c-tech-{{ sec_id }} .d2c-tech-card-title { font-family: 'Space Grotesk', sans-serif; font-size: 16px; font-weight: 800; margin: 0 0 8px 0; color: {{ text_color }}; }
  #d2c-tech-{{ sec_id }} .d2c-tech-desc { font-size: 13px; line-height: 1.6; color: #475569; margin: 0 0 16px 0; flex-grow: 1; }
  #d2c-tech-{{ sec_id }} .d2c-tech-badge { font-size: 9px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 0.5px; }

  @media (max-width: 990px) {
    #d2c-tech-{{ sec_id }} .d2c-tech-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    #d2c-tech-{{ sec_id }} .d2c-tech-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Minimalist / The Derma Co Material Science",
  "tag": "section",
  "class": "d2c-tech-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Title", "default": "MATERIAL & FABRIC SCIENCE" },
    { "type": "text", "id": "subtitle", "label": "Subtitle Tag", "default": "BUILT TO OUTLAST 100+ WASHES" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#0f172a" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#0284c7" }
  ],
  "presets": [
    { "name": "Minimalist / The Derma Co Material Science" }
  ]
}
{% endschema %}
