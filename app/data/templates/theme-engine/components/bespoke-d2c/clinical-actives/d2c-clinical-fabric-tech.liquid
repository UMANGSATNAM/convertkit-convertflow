{% comment %}
  D2C Clinical Actives Science Matrix
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<section class="d2c-clin-matrix" id="d2c-cmat-{{ section.id }}">
  <div class="d2c-cmat-container">
    <div class="d2c-csec-header">
      <span class="d2c-c-badge">[TRANSPARENCY STANDARDS]</span>
      <h2 class="d2c-c-title">{{ section.settings.title | default: "FORMULATION PURITY & pH BENCHMARKS" }}</h2>
    </div>

    <div class="d2c-cmat-grid">
      <div class="d2c-cmat-card">
        <div class="d2c-cmat-pct">99.5%</div>
        <div class="d2c-cmat-name">ACTIVE PURITY GRADE</div>
        <p class="d2c-cmat-desc">We source only pharmaceutical grade actives directly from global leaders like Lonza, BASF, and DSM.</p>
      </div>

      <div class="d2c-cmat-card">
        <div class="d2c-cmat-pct">5.5 pH</div>
        <div class="d2c-cmat-name">PHYSIOLOGICAL BALANCE</div>
        <p class="d2c-cmat-desc">Buffered precisely to maintain the skin's natural acid mantle and prevent transepidermal water loss.</p>
      </div>

      <div class="d2c-cmat-card">
        <div class="d2c-cmat-pct">0%</div>
        <div class="d2c-cmat-name">SYNTHETIC FRAGRANCE</div>
        <p class="d2c-cmat-desc">100% free from masking agents, essential oils, and synthetic perfumes that trigger contact dermatitis.</p>
      </div>

      <div class="d2c-cmat-card">
        <div class="d2c-cmat-pct">100%</div>
        <div class="d2c-cmat-name">OPEN CLINICAL DATA</div>
        <p class="d2c-cmat-desc">All in-vivo and in-vitro clinical trial trial reports are published transparently on our website.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-cmat-{{ section.id }} {
    background: #f8fafc;
    padding: 70px 32px;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-cmat-container { max-width: 1320px; margin: 0 auto; }
  .d2c-cmat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-cmat-card {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 8px;
    padding: 32px 20px;
    text-align: center;
  }
  .d2c-cmat-pct { font-size: 32px; font-weight: 900; color: #0284c7; margin-bottom: 6px; font-family: monospace; }
  .d2c-cmat-name { font-size: 12px; font-weight: 800; color: #0f172a; letter-spacing: 0.5px; margin-bottom: 10px; }
  .d2c-cmat-desc { font-size: 13px; color: #475569; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-cmat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-cmat-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Clinical Science Matrix",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FORMULATION PURITY & pH BENCHMARKS"
    }
  ],
  "presets": [
    {
      "name": "Clinical Science Matrix"
    }
  ]
}
{% endschema %}
