{% comment %}
  D2C Clinical Actives 3-Step Regimen Box
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<section class="d2c-clin-bundle" id="d2c-cbundle-{{ section.id }}">
  <div class="d2c-cbundle-container">
    <div class="d2c-cbundle-box">
      <div class="d2c-cbundle-info">
        <span class="d2c-c-badge">[CUSTOM LAB REGIMEN]</span>
        <h2 class="d2c-cbundle-title">{{ section.settings.title | default: "THE 3-STEP ACNE & PORE CLEARING KIT" }}</h2>
        <p class="d2c-cbundle-desc">
          Complete clinical daily protocol: 2% Salicylic Cleanser + 10% Niacinamide Serum + SPF 50 Mineral Fluid. Packaged with a free precision dosing dropper and active guide.
        </p>
        <div class="d2c-cbundle-price">REGIMEN PRICE: ₹1,499 <span class="d2c-cb-orig">₹1,997</span> <span class="d2c-cb-save">SAVE ₹498</span></div>
        <button class="d2c-cb-btn">CLAIM 3-STEP ACTIVE KIT &rarr;</button>
      </div>

      <div class="d2c-cbundle-visual">
        <div class="d2c-cbi-card">
          <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=400&q=80" alt="BHA Cleanser" />
          <span>BHA Cleanser</span>
        </div>
        <span class="d2c-cbi-plus">+</span>
        <div class="d2c-cbi-card">
          <img src="https://images.unsplash.com/photo-1608248597359-2166946a482b?w=400&q=80" alt="Niacinamide" />
          <span>10% Niacinamide</span>
        </div>
        <span class="d2c-cbi-plus">+</span>
        <div class="d2c-cbi-card">
          <img src="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=400&q=80" alt="SPF 50" />
          <span>SPF 50 Fluid</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-cbundle-{{ section.id }} {
    background: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-cbundle-container { max-width: 1320px; margin: 0 auto; }
  .d2c-cbundle-box {
    background: #f8fafc;
    border-radius: 8px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    border: 1px solid rgba(15, 23, 42, 0.08);
  }
  .d2c-cbundle-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #0f172a; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-cbundle-desc { font-size: 15px; color: #475569; line-height: 1.6; margin-bottom: 24px; }
  .d2c-cbundle-price { font-size: 20px; font-weight: 900; color: #0f172a; margin-bottom: 28px; font-family: monospace; }
  .d2c-cb-orig { font-size: 14px; color: #94a3b8; text-decoration: line-through; margin-left: 6px; }
  .d2c-cb-save { background: #dcfce7; color: #15803d; font-size: 11px; font-weight: 800; padding: 4px 8px; border-radius: 4px; margin-left: 8px; }
  .d2c-cb-btn {
    background: #0f172a;
    color: #ffffff;
    border: none;
    padding: 16px 32px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-cb-btn:hover { background: #0284c7; }
  .d2c-cbundle-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .d2c-cbi-card {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 6px;
    overflow: hidden;
    text-align: center;
    padding: 8px;
    width: 120px;
  }
  .d2c-cbi-card img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; margin-bottom: 6px; }
  .d2c-cbi-card span { font-size: 10px; font-weight: 800; color: #0f172a; }
  .d2c-cbi-plus { font-size: 20px; font-weight: 800; color: #0284c7; }

  @media (max-width: 900px) {
    .d2c-cbundle-box { grid-template-columns: 1fr; padding: 24px; }
  }
</style>

{% schema %}
{
  "name": "Clinical Bundle Kit",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE 3-STEP ACNE & PORE CLEARING KIT"
    }
  ],
  "presets": [
    {
      "name": "Clinical Bundle Kit"
    }
  ]
}
{% endschema %}
