{% comment %}
  D2C Clinical Actives Trust Badges
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<section class="d2c-clin-trust" id="d2c-ctrust-{{ section.id }}">
  <div class="d2c-ctrust-container">
    <div class="d2c-ctrust-grid">
      <div class="d2c-ctrust-item">
        <div class="d2c-ctrust-icon">🧪</div>
        <h4 class="d2c-ctrust-title">RADICAL TRANSPARENCY</h4>
        <p class="d2c-ctrust-desc">Exact active percentages and raw material suppliers clearly printed on front labels.</p>
      </div>

      <div class="d2c-ctrust-item">
        <div class="d2c-ctrust-icon">🛡️</div>
        <h4 class="d2c-ctrust-title">FRAGRANCE-FREE STANDARDS</h4>
        <p class="d2c-ctrust-desc">Zero artificial fragrances, essential oils, or dyes that cause allergic dermatitis.</p>
      </div>

      <div class="d2c-ctrust-item">
        <div class="d2c-ctrust-icon">🔬</div>
        <h4 class="d2c-ctrust-title">NON-COMEDOGENIC TESTED</h4>
        <p class="d2c-ctrust-desc">Tested by independent clinical laboratories to ensure zero pore-clogging potential.</p>
      </div>

      <div class="d2c-ctrust-item">
        <div class="d2c-ctrust-icon">🚚</div>
        <h4 class="d2c-ctrust-title">FREE CASH ON DELIVERY</h4>
        <p class="d2c-ctrust-desc">Doorstep COD with cash or UPI across 24,000+ pincodes with zero extra surcharge.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-ctrust-{{ section.id }} {
    background: #0f172a;
    color: #ffffff;
    padding: 50px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-ctrust-container { max-width: 1320px; margin: 0 auto; }
  .d2c-ctrust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }
  .d2c-ctrust-item {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 6px;
    padding: 28px 18px;
  }
  .d2c-ctrust-icon { font-size: 24px; margin-bottom: 10px; }
  .d2c-ctrust-title { font-size: 12px; font-weight: 800; color: #38bdf8; letter-spacing: 0.5px; margin-bottom: 6px; text-transform: uppercase; font-family: monospace; }
  .d2c-ctrust-desc { font-size: 12px; color: #94a3b8; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-ctrust-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-ctrust-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Clinical Trust Badges",
  "settings": [],
  "presets": [
    {
      "name": "Clinical Trust Badges"
    }
  ]
}
{% endschema %}
