{% comment %}
  D2C Clinical Actives Lab Protocol Club
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<section class="d2c-clin-vip" id="d2c-cvip-{{ section.id }}">
  <div class="d2c-cvip-container">
    <div class="d2c-cvip-box">
      <div class="d2c-csec-header">
        <span class="d2c-c-badge">[LAB MEMBERSHIP]</span>
        <h2 class="d2c-c-title">{{ section.settings.title | default: "THE CLINICAL RESEARCH PASS" }}</h2>
        <p class="d2c-cvip-desc">Receive automated active refills, personalized dermatologist regimen adjustments, and lab sampling benefits.</p>
      </div>

      <div class="d2c-cvip-grid">
        <div class="d2c-cvip-card">
          <div class="d2c-cv-tag">TIER 1 // LAB MEMBER</div>
          <div class="d2c-cv-title">FLAT 10% ON ACTIVE REFILLS</div>
          <p class="d2c-cv-desc">Automatic discount across all serums, plus early access to newly published formulation drops.</p>
        </div>

        <div class="d2c-cvip-card popular">
          <span class="d2c-cv-pill">RECOMMENDED</span>
          <div class="d2c-cv-tag">TIER 2 // AUTO-REGIMEN</div>
          <div class="d2c-cv-title">FREE DERMATOLOGIST CHAT</div>
          <p class="d2c-cv-desc">Direct WhatsApp messaging with certified dermatologists for active pairing and skin audits.</p>
        </div>

        <div class="d2c-cvip-card">
          <div class="d2c-cv-tag">TIER 3 // LAB FELLOW</div>
          <div class="d2c-cv-title">PRE-LAUNCH TRIAL SAMPLES</div>
          <p class="d2c-cv-desc">Receive complimentary unreleased active formulations to participate in blind lab trials.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-cvip-{{ section.id }} {
    background: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-cvip-container { max-width: 1320px; margin: 0 auto; }
  .d2c-cvip-box {
    background: #f8fafc;
    border-radius: 8px;
    padding: 48px 36px;
    border: 1px solid rgba(15, 23, 42, 0.08);
  }
  .d2c-cvip-desc { font-size: 15px; color: #475569; max-width: 540px; margin: 8px auto 0; text-align: center; }
  .d2c-cvip-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .d2c-cvip-card {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 6px;
    padding: 32px 24px;
    text-align: center;
    position: relative;
  }
  .d2c-cvip-card.popular { border: 2px solid #0284c7; }
  .d2c-cv-pill {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #0284c7;
    color: #ffffff;
    font-size: 9px;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    font-family: monospace;
  }
  .d2c-cv-tag { font-size: 10px; font-weight: 800; color: #0284c7; letter-spacing: 1px; margin-bottom: 8px; font-family: monospace; }
  .d2c-cv-title { font-size: 14px; font-weight: 800; color: #0f172a; margin-bottom: 10px; }
  .d2c-cv-desc { font-size: 13px; color: #475569; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-cvip-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Clinical VIP Perks",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE CLINICAL RESEARCH PASS"
    }
  ],
  "presets": [
    {
      "name": "Clinical VIP Perks"
    }
  ]
}
{% endschema %}
