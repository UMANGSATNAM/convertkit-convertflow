{% comment %}
  D2C Clinical Actives AI Routine Diagnostic Modal
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<div class="d2c-clin-popup" id="d2c-cpop-{{ section.id }}" style="display: none;">
  <div class="d2c-cpop-overlay">
    <div class="d2c-cpop-card">
      <button class="d2c-cpop-close" onclick="document.getElementById('d2c-cpop-{{ section.id }}').style.display='none';">&times;</button>
      <span class="d2c-c-badge" style="color: #0284c7;">[AI SKIN ANALYSIS]</span>
      <h3 class="d2c-cpop-title">CALCULATE YOUR AM/PM ACTIVE DOSAGE</h3>
      <p class="d2c-cpop-desc">Enter your primary skin concern to receive a tailored active regimen + Flat ₹150 Off your first order.</p>

      <form class="d2c-cpop-form">
        <input type="text" placeholder="Your Name" class="d2c-cpop-input" required />
        <input type="email" placeholder="Your Email Address" class="d2c-cpop-input" required />
        <input type="tel" placeholder="WhatsApp Number for Instant Regimen PDF" class="d2c-cpop-input" required />
        <button type="submit" class="d2c-cpop-btn">GENERATE MY DERMA REGIMEN &rarr;</button>
      </form>
    </div>
  </div>
</div>

<style>
  .d2c-cpop-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-cpop-card {
    background: #ffffff;
    border-radius: 8px;
    padding: 44px 32px;
    max-width: 440px;
    width: 100%;
    text-align: center;
    position: relative;
    border: 2px solid #0f172a;
    box-shadow: 0 20px 45px -10px rgba(0,0,0,0.3);
  }
  .d2c-cpop-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: #64748b;
    font-size: 22px;
    cursor: pointer;
  }
  .d2c-cpop-title { font-size: 18px; font-weight: 900; color: #0f172a; margin: 8px 0 10px; text-transform: uppercase; }
  .d2c-cpop-desc { font-size: 14px; color: #475569; margin-bottom: 22px; }
  .d2c-cpop-form { display: flex; flex-direction: column; gap: 10px; }
  .d2c-cpop-input {
    background: #f8fafc;
    border: 1px solid rgba(15, 23, 42, 0.15);
    padding: 12px 16px;
    border-radius: 4px;
    font-size: 14px;
    outline: none;
  }
  .d2c-cpop-input:focus { border-color: #0284c7; }
  .d2c-cpop-btn {
    background: #0f172a;
    color: #ffffff;
    border: none;
    padding: 14px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    text-transform: uppercase;
    margin-top: 6px;
  }
  .d2c-cpop-btn:hover { background: #0284c7; }
</style>

{% schema %}
{
  "name": "Clinical Routine Popup",
  "settings": [],
  "presets": [
    {
      "name": "Clinical Routine Popup"
    }
  ]
}
{% endschema %}
