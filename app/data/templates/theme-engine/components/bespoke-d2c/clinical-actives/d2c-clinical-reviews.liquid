{% comment %}
  D2C Clinical Actives Verified Reviews
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<section class="d2c-clin-reviews" id="d2c-crev-{{ section.id }}">
  <div class="d2c-crev-container">
    <div class="d2c-csec-header">
      <span class="d2c-c-badge">[PEER REVIEWED EXPERIENCES]</span>
      <h2 class="d2c-c-title">{{ section.settings.title | default: "AUDITED BY 30,000+ VERIFIED PATIENTS" }}</h2>
    </div>

    <div class="d2c-crev-grid">
      <div class="d2c-crev-card">
        <div class="d2c-crev-stars">★★★★★</div>
        <p class="d2c-crev-quote">"As a practicing dermatologist, I regularly recommend their 10% Niacinamide and 2% Salicylic Acid. The formulation pH is always accurate and results are clinically reproducible."</p>
        <div class="d2c-crev-author">
          <span class="d2c-crev-name">Dr. Ananya Ray, MD</span>
          <span class="d2c-crev-loc">Consultant Dermatologist • Mumbai</span>
        </div>
      </div>

      <div class="d2c-crev-card">
        <div class="d2c-crev-stars">★★★★★</div>
        <p class="d2c-crev-quote">"Fixed my damaged skin barrier in 10 days flat. The Ceramide moisturizer doesn't clog my pores and calmed down all my redness from chemical peels."</p>
        <div class="d2c-crev-author">
          <span class="d2c-crev-name">Siddharth Rao</span>
          <span class="d2c-crev-loc">Verified Patient • Ceramide 0.3% Cream</span>
        </div>
      </div>

      <div class="d2c-crev-card">
        <div class="d2c-crev-stars">★★★★★</div>
        <p class="d2c-crev-quote">"The only sunscreen that doesn't leave a white cast or feel greasy under the hot Chennai sun. Tested it on long outdoor runs with zero sunburn."</p>
        <div class="d2c-crev-author">
          <span class="d2c-crev-name">Preeti Sundaram</span>
          <span class="d2c-crev-loc">Verified Patient • SPF 50 Mineral Fluid</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-crev-{{ section.id }} {
    background: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-crev-container { max-width: 1320px; margin: 0 auto; }
  .d2c-crev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .d2c-crev-card {
    background: #f8fafc;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 8px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .d2c-crev-stars { color: #0284c7; font-size: 16px; margin-bottom: 12px; }
  .d2c-crev-quote { font-size: 14px; color: #475569; line-height: 1.6; margin-bottom: 20px; }
  .d2c-crev-name { font-size: 14px; font-weight: 800; color: #0f172a; display: block; margin-bottom: 2px; }
  .d2c-crev-loc { font-size: 11px; color: #0284c7; font-family: monospace; }

  @media (max-width: 900px) { .d2c-crev-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Clinical Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "AUDITED BY 30,000+ VERIFIED PATIENTS"
    }
  ],
  "presets": [
    {
      "name": "Clinical Reviews"
    }
  ]
}
{% endschema %}
