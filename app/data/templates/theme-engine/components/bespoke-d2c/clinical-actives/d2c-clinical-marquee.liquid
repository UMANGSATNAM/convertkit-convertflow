{% comment %}
  D2C Clinical Actives Lab Ribbon Ticker
  Theme: Minimalist / The Derma Co Clinical Actives
{% endcomment %}

<div class="d2c-clin-ticker" id="d2c-ctick-{{ section.id }}">
  <div class="d2c-ctick-track">
    <div class="d2c-ctick-content">
      <span class="d2c-ctick-item">🧪 10% NIACINAMIDE + ZINC</span>
      <span class="d2c-ctick-sep">//</span>
      <span class="d2c-ctick-item">2% SALICYLIC ACID PORE PEEL</span>
      <span class="d2c-ctick-sep">//</span>
      <span class="d2c-ctick-item">0.3% RETINOL CELL TURNOVER</span>
      <span class="d2c-ctick-sep">//</span>
      <span class="d2c-ctick-item">100% FRAGRANCE & ESSENTIAL OIL FREE</span>
      <span class="d2c-ctick-sep">//</span>
      <span class="d2c-ctick-item">🧪 10% NIACINAMIDE + ZINC</span>
      <span class="d2c-ctick-sep">//</span>
      <span class="d2c-ctick-item">2% SALICYLIC ACID PORE PEEL</span>
      <span class="d2c-ctick-sep">//</span>
      <span class="d2c-ctick-item">0.3% RETINOL CELL TURNOVER</span>
      <span class="d2c-ctick-sep">//</span>
      <span class="d2c-ctick-item">100% FRAGRANCE & ESSENTIAL OIL FREE</span>
    </div>
  </div>
</div>

<style>
  #d2c-ctick-{{ section.id }} {
    background: #0f172a;
    color: #f8fafc;
    overflow: hidden;
    white-space: nowrap;
    padding: 12px 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .d2c-ctick-track { display: flex; overflow: hidden; }
  .d2c-ctick-content {
    display: flex;
    align-items: center;
    gap: 32px;
    animation: d2c-ctick-scroll 22s linear infinite;
  }
  .d2c-ctick-sep { color: #38bdf8; font-weight: 900; }
  @keyframes d2c-ctick-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
</style>

{% schema %}
{
  "name": "Clinical Ticker",
  "settings": [],
  "presets": [
    {
      "name": "Clinical Ticker"
    }
  ]
}
{% endschema %}
