{% comment %}
  D2C Artisan 925 Silver Welcome Gift Modal
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<div class="d2c-silver-popup" id="d2c-sipop-{{ section.id }}" style="display: none;">
  <div class="d2c-sipop-overlay">
    <div class="d2c-sipop-card">
      <button class="d2c-sipop-close" onclick="document.getElementById('d2c-sipop-{{ section.id }}').style.display='none';">&times;</button>
      <span class="d2c-si-badge">WELCOME CELEBRATION</span>
      <h3 class="d2c-sipop-title">CLAIM A FREE SILVER CARE KIT + ₹250 FIRST ORDER GIFT</h3>
      <p class="d2c-sipop-desc">Enter your details to receive an instant welcome gift voucher code via WhatsApp & SMS.</p>

      <form class="d2c-sipop-form">
        <input type="text" placeholder="Your Name" class="d2c-sipop-input" required />
        <input type="tel" placeholder="WhatsApp Phone Number" class="d2c-sipop-input" required />
        <button type="submit" class="d2c-sipop-btn">UNLOCK MY ₹250 GIFT CODE &rarr;</button>
      </form>
    </div>
  </div>
</div>

<style>
  .d2c-sipop-overlay {
    position: fixed;
    inset: 0;
    background: rgba(20, 18, 16, 0.85);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-sipop-card {
    background: #24201d;
    border-radius: 12px;
    padding: 44px 32px;
    max-width: 440px;
    width: 100%;
    text-align: center;
    position: relative;
    border: 2px solid #d6d3d1;
    box-shadow: 0 20px 45px -10px rgba(0,0,0,0.9);
  }
  .d2c-sipop-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: #a8a29e;
    font-size: 22px;
    cursor: pointer;
  }
  .d2c-sipop-title { font-size: 18px; font-weight: 900; color: #ffffff; margin: 8px 0 10px; text-transform: uppercase; line-height: 1.25; }
  .d2c-sipop-desc { font-size: 14px; color: #d6d3d1; margin-bottom: 22px; }
  .d2c-sipop-form { display: flex; flex-direction: column; gap: 10px; }
  .d2c-sipop-input {
    background: #141210;
    border: 1px solid rgba(214, 211, 209, 0.3);
    padding: 12px 16px;
    border-radius: 4px;
    font-size: 14px;
    color: #ffffff;
    outline: none;
  }
  .d2c-sipop-input:focus { border-color: #ffffff; }
  .d2c-sipop-btn {
    background: #ffffff;
    color: #1c1917;
    border: none;
    padding: 14px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
    margin-top: 6px;
  }
</style>

{% schema %}
{
  "name": "Silver Welcome Gift",
  "settings": [],
  "presets": [
    {
      "name": "Silver Welcome Gift"
    }
  ]
}
{% endschema %}
