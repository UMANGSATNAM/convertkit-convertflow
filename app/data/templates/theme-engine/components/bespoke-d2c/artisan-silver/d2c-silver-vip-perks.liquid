{% comment %}
  D2C Artisan 925 Silver VIP Club
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<section class="d2c-silver-vip" id="d2c-sivip-{{ section.id }}">
  <div class="d2c-silver-container">
    <div class="d2c-sivip-box">
      <div class="d2c-sisec-header">
        <span class="d2c-si-badge">SILVER CLUB REWARDS</span>
        <h2 class="d2c-si-title">{{ section.settings.title | default: "JOIN THE 925 SILVER CIRCLE" }}</h2>
        <p class="d2c-sivip-desc">Earn points with every piece, get a free silver charm on your birthday, and unlock 48-hour priority access to new collection drops.</p>
      </div>

      <div class="d2c-sivip-grid">
        <div class="d2c-sivip-card">
          <div class="d2c-siv-tag">TIER 1 // SILVER INSIDER</div>
          <div class="d2c-siv-title">10% CASHBACK IN COINS</div>
          <p class="d2c-siv-desc">Earn 10 coins on every ₹100 spent. Redeem instantly on your next silver jewelry piece.</p>
        </div>

        <div class="d2c-sivip-card popular">
          <span class="d2c-siv-pill">MOST POPULAR</span>
          <div class="d2c-siv-tag">TIER 2 // CELESTIAL CLUB</div>
          <div class="d2c-siv-title">FREE BIRTHDAY CHARM</div>
          <p class="d2c-siv-desc">Receive a complimentary 925 solid silver zodiac or birthstone charm during your birthday month.</p>
        </div>

        <div class="d2c-sivip-card">
          <div class="d2c-siv-tag">TIER 3 // ARTISAN CIRCLE</div>
          <div class="d2c-siv-title">LIFETIME FREE POLISHING</div>
          <p class="d2c-siv-desc">Drop off your pieces at any of our 150+ offline stores anytime for free ultrasonic spa cleaning.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-sivip-{{ section.id }} {
    background: #1c1917;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-silver-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sivip-box {
    background: #24201d;
    border-radius: 12px;
    padding: 48px 36px;
    border: 1px solid rgba(214, 211, 209, 0.2);
  }
  .d2c-sivip-desc { font-size: 15px; color: #d6d3d1; max-width: 540px; margin: 8px auto 0; text-align: center; }
  .d2c-sivip-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .d2c-sivip-card {
    background: #141210;
    border: 1px solid rgba(214, 211, 209, 0.15);
    border-radius: 8px;
    padding: 32px 24px;
    text-align: center;
    position: relative;
  }
  .d2c-sivip-card.popular { border: 2px solid #f5f5f4; }
  .d2c-siv-pill {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #ffffff;
    color: #1c1917;
    font-size: 9px;
    font-weight: 900;
    padding: 3px 10px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }
  .d2c-siv-tag { font-size: 10px; font-weight: 800; color: #a8a29e; letter-spacing: 1px; margin-bottom: 8px; font-family: monospace; }
  .d2c-siv-title { font-size: 14px; font-weight: 900; color: #ffffff; margin-bottom: 10px; }
  .d2c-siv-desc { font-size: 13px; color: #d6d3d1; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-sivip-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Silver VIP Perks",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "JOIN THE 925 SILVER CIRCLE"
    }
  ],
  "presets": [
    {
      "name": "Silver VIP Perks"
    }
  ]
}
{% endschema %}
