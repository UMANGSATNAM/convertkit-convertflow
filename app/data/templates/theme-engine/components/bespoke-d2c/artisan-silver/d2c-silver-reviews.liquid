{% comment %}
  D2C Artisan 925 Silver Verified Reviews
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<section class="d2c-silver-reviews" id="d2c-sirev-{{ section.id }}">
  <div class="d2c-silver-container">
    <div class="d2c-sisec-header">
      <span class="d2c-si-badge">GIFTING & DAILY WEAR REVIEWS</span>
      <h2 class="d2c-si-title">{{ section.settings.title | default: "TRUSTED BY 2,000,000+ GIFT GIVERS" }}</h2>
    </div>

    <div class="d2c-sirev-grid">
      <div class="d2c-sirev-card">
        <div class="d2c-sirev-stars">★★★★★</div>
        <p class="d2c-sirev-quote">"Gifted the Falling Dewdrop Earrings to my sister for her birthday. The unboxing packaging with the ribbon and warranty certificate looked so luxurious! She wears them to office every day."</p>
        <div class="d2c-sirev-author">
          <span class="d2c-sirev-name">Meghna Saraf</span>
          <span class="d2c-sirev-loc">Bengaluru • Dewdrop Earrings</span>
        </div>
      </div>

      <div class="d2c-sirev-card">
        <div class="d2c-sirev-stars">★★★★★</div>
        <p class="d2c-sirev-quote">"I was skeptical about silver tarnishing, but I've been wearing the Solitaire Pendant daily for 4 months even during workouts and showers. Zero black marks or discoloration!"</p>
        <div class="d2c-sirev-author">
          <span class="d2c-sirev-name">Deepika Nair</span>
          <span class="d2c-sirev-loc">Kochi • Solitaire Pendant</span>
        </div>
      </div>

      <div class="d2c-sirev-card">
        <div class="d2c-sirev-stars">★★★★★</div>
        <p class="d2c-sirev-quote">"The adjustable Princess Crown Ring fits perfectly on any finger. The Swiss Zirconia sparkle looks identical to real diamonds without the stress of carrying expensive jewelry."</p>
        <div class="d2c-sirev-author">
          <span class="d2c-sirev-name">Priyanka Ghosh</span>
          <span class="d2c-sirev-loc">Kolkata • Princess Crown Ring</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-sirev-{{ section.id }} {
    background: #141210;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-silver-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sirev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .d2c-sirev-card {
    background: #24201d;
    border: 1px solid rgba(214, 211, 209, 0.15);
    border-radius: 8px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .d2c-sirev-stars { color: #f5f5f4; font-size: 16px; margin-bottom: 12px; }
  .d2c-sirev-quote { font-size: 14px; color: #d6d3d1; line-height: 1.6; margin-bottom: 20px; }
  .d2c-sirev-name { font-size: 15px; font-weight: 800; color: #ffffff; display: block; margin-bottom: 2px; }
  .d2c-sirev-loc { font-size: 11px; color: #a8a29e; }

  @media (max-width: 900px) { .d2c-sirev-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Silver Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "TRUSTED BY 2,000,000+ GIFT GIVERS"
    }
  ],
  "presets": [
    {
      "name": "Silver Reviews"
    }
  ]
}
{% endschema %}
