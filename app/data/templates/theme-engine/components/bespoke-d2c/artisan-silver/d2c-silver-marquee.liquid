<style>
  #d2c-siribbon-{{ section.id }} {
    background: #e7e5e4;
    color: #1c1917;
    overflow: hidden;
    white-space: nowrap;
    padding: 12px 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .d2c-siribbon-track { display: flex; overflow: hidden; }
  .d2c-siribbon-content {
    display: flex;
    align-items: center;
    gap: 32px;
    animation: d2c-siribbon-scroll 22s linear infinite;
  }
  .d2c-siribbon-sep { font-size: 14px; color: #78716c; opacity: 0.8; }
  @keyframes d2c-siribbon-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
</style>

{% schema %}
{
  "name": "Silver Ribbon",
