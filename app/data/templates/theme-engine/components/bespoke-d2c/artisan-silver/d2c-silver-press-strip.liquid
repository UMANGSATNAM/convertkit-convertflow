{% comment %}
  D2C Artisan 925 Silver Press Mentions
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<section class="d2c-silver-press" id="d2c-sipress-{{ section.id }}">
  <div class="d2c-silver-container">
    <span class="d2c-sipress-label">FEATURED IN</span>
    <div class="d2c-sipress-logos">
      <span class="d2c-siplogo">COSMOPOLITAN INDIA</span>
      <span class="d2c-siplogo">GRAZIA FASHION</span>
      <span class="d2c-siplogo">LIFESTYLE ASIA</span>
      <span class="d2c-siplogo">MISSMALINI</span>
      <span class="d2c-siplogo">ELLE ACCESSORIES</span>
    </div>
  </div>
</section>

<style>
  #d2c-sipress-{{ section.id }} {
    background: #1c1917;
    padding: 30px 32px;
    border-bottom: 1px solid rgba(214, 211, 209, 0.2);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-silver-container {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .d2c-sipress-label { font-size: 11px; font-weight: 800; color: #d6d3d1; letter-spacing: 1px; text-transform: uppercase; }
  .d2c-sipress-logos { display: flex; gap: 36px; align-items: center; flex-wrap: wrap; }
  .d2c-siplogo { font-size: 14px; font-weight: 900; color: #f5f5f4; letter-spacing: 0.5px; opacity: 0.9; }

  @media (max-width: 768px) {
    .d2c-silver-container { justify-content: center; text-align: center; }
    .d2c-sipress-logos { justify-content: center; gap: 20px; }
  }
</style>

{% schema %}
{
  "name": "Silver Press Strip",
  "settings": [],
  "presets": [
    {
      "name": "Silver Press Strip"
    }
  ]
}
{% endschema %}
