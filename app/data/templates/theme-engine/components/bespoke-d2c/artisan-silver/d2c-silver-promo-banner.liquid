{% comment %}
  D2C Artisan 925 Silver Promo Banner
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<section class="d2c-silver-promo" id="d2c-sipromo-{{ section.id }}">
  <div class="d2c-sipromo-container">
    <div class="d2c-sipromo-card">
      <span class="d2c-si-badge" style="color: #d6d3d1;">LIMITED FESTIVE OFFER</span>
      <h2 class="d2c-sipromo-title">{{ section.settings.title | default: "BUY ANY 2 SILVER RINGS & GET 1 RING ABSOLUTELY FREE" }}</h2>
      <p class="d2c-sipromo-desc">Use code <span class="d2c-sipromo-code">FREERING</span> at checkout. Automatically applies to the lowest-priced ring in your cart + free gift box packaging.</p>
      <a href="/collections/silver-rings" class="d2c-sipromo-btn">SHOP SILVER RINGS &rarr;</a>
    </div>
  </div>
</section>

<style>
  #d2c-sipromo-{{ section.id }} {
    background: #1c1917;
    padding: 50px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-sipromo-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sipromo-card {
    background: linear-gradient(135deg, #2e2a26 0%, #141210 100%);
    border: 1px solid rgba(214, 211, 209, 0.3);
    border-radius: 12px;
    padding: 56px 36px;
    text-align: center;
    box-shadow: 0 20px 45px -10px rgba(0,0,0,0.8);
  }
  .d2c-sipromo-title { font-size: clamp(26px, 3.5vw, 40px); font-weight: 900; color: #ffffff; letter-spacing: -0.5px; margin: 10px 0 14px; text-transform: uppercase; }
  .d2c-sipromo-desc { font-size: 15px; color: #d6d3d1; max-width: 600px; margin: 0 auto 28px; line-height: 1.6; }
  .d2c-sipromo-code { background: rgba(255,255,255,0.15); color: #ffffff; padding: 3px 8px; border-radius: 4px; font-weight: 900; font-family: monospace; }
  .d2c-sipromo-btn {
    display: inline-block;
    background: #ffffff;
    color: #1c1917;
    padding: 14px 32px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
  }
  .d2c-sipromo-btn:hover { background: #e7e5e4; }
</style>

{% schema %}
{
  "name": "Silver Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "BUY ANY 2 SILVER RINGS & GET 1 RING ABSOLUTELY FREE"
    }
  ],
  "presets": [
    {
      "name": "Silver Promo Banner"
    }
  ]
}
{% endschema %}
