{% comment %}
  D2C Artisan 925 Silver Layering Lookbook
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<section class="d2c-silver-lookbook" id="d2c-silb-{{ section.id }}">
  <div class="d2c-silb-container">
    <div class="d2c-sisec-header">
      <span class="d2c-si-badge">SILVER LOOKBOOK</span>
      <h2 class="d2c-si-title">{{ section.settings.title | default: "HOW TO LAYER 925 SILVER FOR WORK & WEEKENDS" }}</h2>
    </div>

    <div class="d2c-silb-grid">
      <div class="d2c-silb-card large">
        <img src="https://images.unsplash.com/photo-1603561591411-07134e71a2a9?w=800&q=80" alt="Office Chic Silver" />
        <div class="d2c-silb-overlay">
          <span class="d2c-silb-tag">WORKWEAR MINIMALISM</span>
          <h3 class="d2c-silb-name">MINIMAL SOLITAIRE CHAIN + DEWDROP STUDS</h3>
          <span class="d2c-silb-link">VIEW CURATED LOOK &rarr;</span>
        </div>
      </div>

      <div class="d2c-silb-card">
        <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=600&q=80" alt="Ring Stacking" />
        <div class="d2c-silb-overlay">
          <span class="d2c-silb-tag">RING STACKING</span>
          <h3 class="d2c-silb-name">3-PIECE SILVER BAND TRIO</h3>
          <span class="d2c-silb-link">EXPLORE &rarr;</span>
        </div>
      </div>

      <div class="d2c-silb-card">
        <img src="https://images.unsplash.com/photo-1611591475152-478d1c582489?w=600&q=80" alt="Charm Wrist" />
        <div class="d2c-silb-overlay">
          <span class="d2c-silb-tag">WEEKEND BRUNCH</span>
          <h3 class="d2c-silb-name">NAZAR CHARM WRISTLET</h3>
          <span class="d2c-silb-link">EXPLORE &rarr;</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-silb-{{ section.id }} {
    background: #1c1917;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-silb-container { max-width: 1360px; margin: 0 auto; }
  .d2c-silb-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 24px;
  }
  .d2c-silb-card {
    position: relative;
    height: 480px;
    border-radius: 12px;
    overflow: hidden;
    background: #24201d;
    border: 1px solid rgba(214, 211, 209, 0.2);
  }
  .d2c-silb-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .d2c-silb-card:hover img { transform: scale(1.04); }
  .d2c-silb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(28,25,23,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px;
    color: #ffffff;
  }
  .d2c-silb-tag { font-size: 10px; font-weight: 800; color: #d6d3d1; letter-spacing: 1px; margin-bottom: 4px; }
  .d2c-silb-name { font-size: 16px; font-weight: 800; margin-bottom: 8px; }
  .d2c-silb-link { font-size: 11px; font-weight: 800; color: #a8a29e; }

  @media (max-width: 900px) {
    .d2c-silb-grid { grid-template-columns: 1fr; }
    .d2c-silb-card { height: 340px; }
  }
</style>

{% schema %}
{
  "name": "Silver Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HOW TO LAYER 925 SILVER FOR WORK & WEEKENDS"
    }
  ],
  "presets": [
    {
      "name": "Silver Lookbook"
    }
  ]
}
{% endschema %}
