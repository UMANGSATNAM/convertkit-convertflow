{% comment %}
  D2C Artisan 925 Silver Hero
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<section class="d2c-silver-hero" id="d2c-sihero-{{ section.id }}">
  <div class="d2c-sihero-container">
    <div class="d2c-sihero-grid">
      <div class="d2c-sihero-text">
        <span class="d2c-sihero-badge">🥈 925 STERLING SILVER • ANTI-TARNISH SEAL</span>
        <h1 class="d2c-sihero-title">{{ section.settings.heading | default: "TIMELESS 925 SILVER CRAFTED FOR DAILY ELEGANCE" }}</h1>
        <p class="d2c-sihero-desc">
          Plated with pure precious rhodium and protected by an invisible anti-tarnish barrier. 100% hypoallergenic, skin-safe, and comes with a 6-month warranty card + free unboxing gift box.
        </p>

        <div class="d2c-sihero-actions">
          <a href="/collections/all" class="d2c-sibtn-primary">EXPLORE SILVER EDIT &rarr;</a>
          <a href="/pages/gifting" class="d2c-sibtn-secondary">SEND A SURPRISE GIFT</a>
        </div>

        <div class="d2c-sihero-specs">
          <div class="d2c-sispec"><strong>925</strong> <span>BIS Hallmarked Silver</span></div>
          <div class="d2c-sispec"><strong>6 MONTHS</strong> <span>Anti-Tarnish Warranty</span></div>
          <div class="d2c-sispec"><strong>FREE</strong> <span>Luxury Gift Packaging</span></div>
        </div>
      </div>

      <div class="d2c-sihero-media">
        <div class="d2c-sihero-frame">
          <img src="https://images.unsplash.com/photo-1603561591411-07134e71a2a9?w=900&q=85" alt="925 Sterling Silver Ring" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-sihero-{{ section.id }} {
    background: #1c1917;
    color: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-sihero-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sihero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }
  .d2c-sihero-badge {
    font-size: 11px;
    font-weight: 800;
    color: #d6d3d1;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 16px;
    display: block;
  }
  .d2c-sihero-title {
    font-size: clamp(34px, 4vw, 50px);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.1;
    letter-spacing: -0.5px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }
  .d2c-sihero-desc {
    font-size: 16px;
    color: #e7e5e4;
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 540px;
  }
  .d2c-sihero-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }
  .d2c-sibtn-primary {
    background: #ffffff;
    color: #1c1917;
    padding: 16px 32px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
  }
  .d2c-sibtn-secondary {
    background: transparent;
    border: 1px solid #d6d3d1;
    color: #f5f5f4;
    padding: 16px 28px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
  }
  .d2c-sihero-specs {
    display: flex;
    gap: 36px;
    border-top: 1px solid rgba(214, 211, 209, 0.2);
    padding-top: 24px;
  }
  .d2c-sispec strong { font-size: 22px; font-weight: 900; color: #f5f5f4; display: block; }
  .d2c-sispec span { font-size: 12px; color: #a8a29e; }
  .d2c-sihero-frame {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(214, 211, 209, 0.3);
    box-shadow: 0 20px 45px -10px rgba(0,0,0,0.8);
  }
  .d2c-sihero-frame img { width: 100%; height: 500px; object-fit: cover; }

  @media (max-width: 900px) {
    .d2c-sihero-grid { grid-template-columns: 1fr; }
    .d2c-sihero-frame img { height: 360px; }
    #d2c-sihero-{{ section.id }} { padding: 40px 18px; }
  }
</style>

{% schema %}
{
  "name": "Silver Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TIMELESS 925 SILVER CRAFTED FOR DAILY ELEGANCE"
    }
  ],
  "presets": [
    {
      "name": "Silver Hero"
    }
  ]
}
{% endschema %}
