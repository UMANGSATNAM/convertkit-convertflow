{% comment %}
  D2C Artisan 925 Silver Newsletter
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<section class="d2c-silver-news" id="d2c-sinews-{{ section.id }}">
  <div class="d2c-silver-container">
    <div class="d2c-sinews-card">
      <span class="d2c-si-badge">PRIVATE VIP CLUB</span>
      <h2 class="d2c-sinews-title">{{ section.settings.title | default: "GET ₹300 OFF ON YOUR FIRST 925 SILVER PIECE" }}</h2>
      <p class="d2c-sinews-desc">Join 500,000+ members getting styling tips, celebrity collection drops, and secret birthday discounts.</p>

      <form class="d2c-sinews-form">
        <input type="email" placeholder="Enter your email address" class="d2c-sinews-input" required />
        <button type="submit" class="d2c-sinews-btn">CLAIM ₹300 VOUCHER &rarr;</button>
      </form>
      <div class="d2c-sinews-privacy">🔒 Zero spam. Instant coupon code on submission.</div>
    </div>
  </div>
</section>

<style>
  #d2c-sinews-{{ section.id }} {
    background: #1c1917;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-silver-container { max-width: 860px; margin: 0 auto; }
  .d2c-sinews-card {
    background: #24201d;
    border-radius: 12px;
    padding: 48px 36px;
    text-align: center;
    border: 1px solid rgba(214, 211, 209, 0.2);
  }
  .d2c-sinews-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #ffffff; margin: 10px 0 12px; text-transform: uppercase; }
  .d2c-sinews-desc { font-size: 15px; color: #d6d3d1; margin-bottom: 28px; }
  .d2c-sinews-form { display: flex; gap: 10px; max-width: 480px; margin: 0 auto 14px; }
  .d2c-sinews-input {
    flex: 1;
    background: #141210;
    border: 1px solid rgba(214, 211, 209, 0.3);
    padding: 14px 18px;
    border-radius: 4px;
    font-size: 14px;
    color: #ffffff;
    outline: none;
  }
  .d2c-sinews-input:focus { border-color: #ffffff; }
  .d2c-sinews-btn {
    background: #ffffff;
    color: #1c1917;
    border: none;
    padding: 14px 28px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-sinews-btn:hover { background: #e7e5e4; }
  .d2c-sinews-privacy { font-size: 12px; color: #a8a29e; }

  @media (max-width: 600px) {
    .d2c-sinews-form { flex-direction: column; }
    .d2c-sinews-card { padding: 32px 20px; }
  }
</style>

{% schema %}
{
  "name": "Silver Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "GET ₹300 OFF ON YOUR FIRST 925 SILVER PIECE"
    }
  ],
  "presets": [
    {
      "name": "Silver Newsletter"
    }
  ]
}
{% endschema %}
