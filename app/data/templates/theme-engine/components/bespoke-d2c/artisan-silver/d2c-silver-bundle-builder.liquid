{% comment %}
  D2C Artisan 925 Silver Gift Suite Box
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<section class="d2c-silver-bundle" id="d2c-sibundle-{{ section.id }}">
  <div class="d2c-sibundle-container">
    <div class="d2c-sibundle-box">
      <div class="d2c-sibundle-info">
        <span class="d2c-si-badge">GIFT BOX BUNDLE & SAVE</span>
        <h2 class="d2c-sibundle-title">{{ section.settings.title | default: "THE COMPLETE CELESTIAL SILVER GIFT BOX" }}</h2>
        <p class="d2c-sibundle-desc">
          The perfect ready-to-gift set: Falling Dewdrop Earrings + Solitaire Pendant + Princess Crown Ring. Includes a velvet unboxing keepsake box, silver polish cloth, and personalized gift message card.
        </p>
        <div class="d2c-sibundle-price">SET PRICE: ₹3,999 <span class="d2c-sib-orig">₹7,697</span> <span class="d2c-sib-save">SAVE ₹3,698</span></div>
        <button class="d2c-sib-btn">CLAIM 3-PIECE SILVER GIFT BOX &rarr;</button>
      </div>

      <div class="d2c-sibundle-visual">
        <div class="d2c-sibi-card">
          <img src="https://images.unsplash.com/photo-1603561591411-07134e71a2a9?w=400&q=80" alt="Earrings" />
          <span>Dewdrop Earrings</span>
        </div>
        <span class="d2c-sibi-plus">+</span>
        <div class="d2c-sibi-card">
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=400&q=80" alt="Pendant" />
          <span>Solitaire Pendant</span>
        </div>
        <span class="d2c-sibi-plus">+</span>
        <div class="d2c-sibi-card">
          <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=400&q=80" alt="Crown Ring" />
          <span>Princess Ring</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-sibundle-{{ section.id }} {
    background: #1c1917;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-sibundle-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sibundle-box {
    background: #24201d;
    border-radius: 12px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    border: 1px solid rgba(214, 211, 209, 0.2);
  }
  .d2c-sibundle-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #ffffff; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-sibundle-desc { font-size: 15px; color: #d6d3d1; line-height: 1.6; margin-bottom: 24px; }
  .d2c-sibundle-price { font-size: 20px; font-weight: 900; color: #ffffff; margin-bottom: 28px; font-family: monospace; }
  .d2c-sib-orig { font-size: 14px; color: #78716c; text-decoration: line-through; margin-left: 6px; }
  .d2c-sib-save { background: rgba(214, 211, 209, 0.15); color: #f5f5f4; font-size: 11px; font-weight: 800; padding: 4px 8px; border-radius: 4px; margin-left: 8px; border: 1px solid #d6d3d1; }
  .d2c-sib-btn {
    background: #ffffff;
    color: #1c1917;
    border: none;
    padding: 16px 32px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-sibundle-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .d2c-sibi-card {
    background: #1c1917;
    border: 1px solid rgba(214, 211, 209, 0.2);
    border-radius: 8px;
    overflow: hidden;
    text-align: center;
    padding: 8px;
    width: 120px;
  }
  .d2c-sibi-card img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; margin-bottom: 6px; }
  .d2c-sibi-card span { font-size: 10px; font-weight: 800; color: #ffffff; }
  .d2c-sibi-plus { font-size: 20px; font-weight: 800; color: #d6d3d1; }

  @media (max-width: 900px) {
    .d2c-sibundle-box { grid-template-columns: 1fr; padding: 24px; }
  }
</style>

{% schema %}
{
  "name": "Silver Bundle Box",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE COMPLETE CELESTIAL SILVER GIFT BOX"
    }
  ],
  "presets": [
    {
      "name": "Silver Bundle Box"
    }
  ]
}
{% endschema %}
