{% comment %}
  D2C Artisan 925 Silver Brand Story
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<section class="d2c-silver-story" id="d2c-sistory-{{ section.id }}">
  <div class="d2c-silver-container">
    <div class="d2c-sistory-grid">
      <div class="d2c-sistory-content">
        <span class="d2c-si-badge">OUR PHILOSOPHY</span>
        <h2 class="d2c-sistory-title">{{ section.settings.title | default: "FINE JEWELLERY THAT BELONGS TO YOUR EVERYDAY LIFE" }}</h2>
        <p class="d2c-sistory-para">
          Traditional gold jewelry was kept locked away in bank vaults, reserved only for weddings and rare celebrations.
        </p>
        <p class="d2c-sistory-para">
          We believe luxury should be lived in every single day. We handcraft authentic 925 sterling silver infused with anti-tarnish rhodium protection, so you can look and feel brilliant at college, work, coffee dates, and wherever life takes you.
        </p>
        <div class="d2c-sistory-stats">
          <div><span class="d2c-sist-num">92.5%</span><span class="d2c-sist-lbl">Solid Silver</span></div>
          <div><span class="d2c-sist-num">6-Mo</span><span class="d2c-sist-lbl">Warranty</span></div>
          <div><span class="d2c-sist-num">2M+</span><span class="d2c-sist-lbl">Happy Givers</span></div>
        </div>
      </div>

      <div class="d2c-sistory-media">
        <img src="https://images.unsplash.com/photo-1603561591411-07134e71a2a9?w=800&q=80" alt="Silver Workshop Design" />
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-sistory-{{ section.id }} {
    background: #1c1917;
    padding: 80px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-silver-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sistory-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }
  .d2c-sistory-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 900; color: #ffffff; line-height: 1.15; margin: 10px 0 20px; text-transform: uppercase; }
  .d2c-sistory-para { font-size: 15px; color: #d6d3d1; line-height: 1.7; margin-bottom: 18px; }
  .d2c-sistory-stats {
    display: flex;
    gap: 36px;
    border-top: 1px solid rgba(214, 211, 209, 0.2);
    padding-top: 24px;
    margin-top: 28px;
  }
  .d2c-sist-num { font-size: 26px; font-weight: 900; color: #f5f5f4; display: block; }
  .d2c-sist-lbl { font-size: 11px; color: #a8a29e; font-weight: 700; text-transform: uppercase; }
  .d2c-sistory-media img { width: 100%; height: 440px; object-fit: cover; border-radius: 12px; border: 1px solid rgba(214, 211, 209, 0.2); }

  @media (max-width: 900px) {
    .d2c-sistory-grid { grid-template-columns: 1fr; }
    .d2c-sistory-media img { height: 320px; }
  }
</style>

{% schema %}
{
  "name": "Silver Story",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FINE JEWELLERY THAT BELONGS TO YOUR EVERYDAY LIFE"
    }
  ],
  "presets": [
    {
      "name": "Silver Story"
    }
  ]
}
{% endschema %}
