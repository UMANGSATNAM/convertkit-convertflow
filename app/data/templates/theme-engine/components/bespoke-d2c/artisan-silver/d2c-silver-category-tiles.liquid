{% comment %}
  D2C Artisan 925 Silver Categories
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<section class="d2c-silver-cats" id="d2c-sicats-{{ section.id }}">
  <div class="d2c-sicats-container">
    <div class="d2c-sisec-header">
      <span class="d2c-si-badge">SILVER DIRECTORY</span>
      <h2 class="d2c-si-title">{{ section.settings.title | default: "HANDCRAFTED 925 SILVER SILHOUETTES" }}</h2>
    </div>

    <div class="d2c-sicats-grid">
      <a href="/collections/silver-rings" class="d2c-sicat-card">
        <img src="https://images.unsplash.com/photo-1603561591411-07134e71a2a9?w=600&q=80" alt="Silver Rings" />
        <div class="d2c-sicat-overlay">
          <span class="d2c-sicat-sub">ADJUSTABLE & ETERNITY</span>
          <h3 class="d2c-sicat-name">925 STERLING RINGS</h3>
          <span class="d2c-sicat-link">SHOP RINGS &rarr;</span>
        </div>
      </a>

      <a href="/collections/silver-earrings" class="d2c-sicat-card">
        <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=600&q=80" alt="Silver Earrings" />
        <div class="d2c-sicat-overlay">
          <span class="d2c-sicat-sub">STUDS, HOOPS & DROPS</span>
          <h3 class="d2c-sicat-name">FINE SILVER EARRINGS</h3>
          <span class="d2c-sicat-link">SHOP &rarr;</span>
        </div>
      </a>

      <a href="/collections/silver-pendants" class="d2c-sicat-card">
        <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Silver Pendants" />
        <div class="d2c-sicat-overlay">
          <span class="d2c-sicat-sub">SOLITAIRE & CHARM CHAINS</span>
          <h3 class="d2c-sicat-name">MINIMAL PENDANTS</h3>
          <span class="d2c-sicat-link">SHOP &rarr;</span>
        </div>
      </a>

      <a href="/collections/silver-bracelets" class="d2c-sicat-card">
        <img src="https://images.unsplash.com/photo-1611591475152-478d1c582489?w=600&q=80" alt="Silver Bracelets" />
        <div class="d2c-sicat-overlay">
          <span class="d2c-sicat-sub">CHARM & TENNIS CUFFS</span>
          <h3 class="d2c-sicat-name">SILVER BRACELETS</h3>
          <span class="d2c-sicat-link">SHOP &rarr;</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  #d2c-sicats-{{ section.id }} {
    background: #1c1917;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-sicats-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sisec-header { text-align: center; margin-bottom: 48px; }
  .d2c-si-badge { font-size: 11px; font-weight: 800; color: #d6d3d1; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px; display: block; }
  .d2c-si-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 900; color: #ffffff; letter-spacing: -0.5px; text-transform: uppercase; }
  .d2c-sicats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-sicat-card {
    position: relative;
    height: 420px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(214, 211, 209, 0.2);
    text-decoration: none;
    display: block;
  }
  .d2c-sicat-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .d2c-sicat-card:hover img { transform: scale(1.06); }
  .d2c-sicat-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(28,25,23,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: #ffffff;
    text-align: center;
  }
  .d2c-sicat-sub { font-size: 10px; font-weight: 800; color: #d6d3d1; letter-spacing: 1.5px; margin-bottom: 4px; }
  .d2c-sicat-name { font-size: 16px; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 6px; }
  .d2c-sicat-link { font-size: 11px; font-weight: 800; color: #a8a29e; }

  @media (max-width: 1024px) { .d2c-sicats-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-sicats-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Silver Categories",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HANDCRAFTED 925 SILVER SILHOUETTES"
    }
  ],
  "presets": [
    {
      "name": "Silver Categories"
    }
  ]
}
{% endschema %}
