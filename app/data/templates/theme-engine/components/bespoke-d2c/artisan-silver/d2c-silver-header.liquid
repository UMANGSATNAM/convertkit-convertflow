{% comment %}
  D2C Artisan 925 Silver Header
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<header class="d2c-silver-header" id="d2c-sihead-{{ section.id }}">
  <div class="d2c-sihead-container">
    <div class="d2c-sihead-left">
      <a href="/collections/silver-rings" class="d2c-sinav-link">RINGS</a>
      <a href="/collections/silver-earrings" class="d2c-sinav-link">EARRINGS</a>
      <a href="/collections/silver-pendants" class="d2c-sinav-link">PENDANTS</a>
      <a href="/collections/silver-bracelets" class="d2c-sinav-link">BRACELETS</a>
    </div>

    <div class="d2c-sihead-logo-box">
      <a href="/" class="d2c-sihead-logo">
        <span class="d2c-silogo-title">{{ section.settings.brand_name | default: "GIVA ARTISAN SILVER" }}</span>
        <span class="d2c-silogo-sub">925 STERLING SILVER • ANTI-TARNISH SEAL</span>
      </a>
    </div>

    <div class="d2c-sihead-right">
      <a href="/pages/gifting" class="d2c-sinav-link highlight">🎁 GIFT SUITE</a>
      <a href="/cart" class="d2c-sinav-link">BAG ({{ cart.item_count | default: 0 }})</a>
    </div>
  </div>
</header>

<style>
  #d2c-sihead-{{ section.id }} {
    background: #141210;
    border-bottom: 1px solid rgba(214, 211, 209, 0.2);
    padding: 18px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  .d2c-sihead-container {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr auto 1fr;
    align-items: center;
  }
  .d2c-sihead-left { display: flex; gap: 24px; }
  .d2c-sihead-right { display: flex; gap: 24px; justify-content: flex-end; align-items: center; }
  .d2c-sinav-link {
    color: #e7e5e4;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
  }
  .d2c-sinav-link.highlight {
    background: #f5f5f4;
    color: #1c1917;
    padding: 7px 16px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 900;
  }
  .d2c-sihead-logo {
    text-align: center;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .d2c-silogo-title {
    font-size: 22px;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .d2c-silogo-sub {
    font-size: 9px;
    color: #a8a29e;
    letter-spacing: 1.5px;
    margin-top: 2px;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .d2c-sihead-left { display: none; }
    .d2c-sihead-container { display: flex; justify-content: space-between; }
    #d2c-sihead-{{ section.id }} { padding: 14px 18px; }
  }
</style>

{% schema %}
{
  "name": "Silver Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "GIVA ARTISAN SILVER"
    }
  ],
  "presets": [
    {
      "name": "Silver Header"
    }
  ]
}
{% endschema %}
