{% comment %}
  D2C Artisan 925 Silver Spotlight
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<section class="d2c-silver-spotlight" id="d2c-sispot-{{ section.id }}">
  <div class="d2c-sispot-container">
    <div class="d2c-sispot-card">
      <div class="d2c-sispot-media">
        <img src="https://images.unsplash.com/photo-1603561591411-07134e71a2a9?w=800&q=85" alt="Rose Gold Dewdrop Earrings" />
      </div>

      <div class="d2c-sispot-content">
        <span class="d2c-si-badge">CELEBRITY EDIT SPOTLIGHT</span>
        <h2 class="d2c-sispot-title">{{ section.settings.title | default: "ROSE GOLD FALLING DEWDROP EARRINGS" }}</h2>
        <p class="d2c-sispot-desc">
          Crafted in 925 solid sterling silver and triple-plated in 18kt rose gold with an anti-tarnish protective e-coat. Studded with AAA+ Swiss Zirconia gems that catch light with every turn.
        </p>

        <div class="d2c-sispot-matrix">
          <div class="d2c-sim-item"><span>METAL SPEC:</span> <strong>925 Solid Sterling Silver (BIS Hallmarked)</strong></div>
          <div class="d2c-sim-item"><span>PLATING:</span> <strong>18KT Rose Gold + Anti-Tarnish E-Coat</strong></div>
          <div class="d2c-sim-item"><span>WARRANTY:</span> <strong>6-Month Free Replating Warranty</strong></div>
        </div>

        <div class="d2c-sispot-price-row">
          <span class="d2c-sispot-price">₹1,799</span>
          <span class="d2c-sispot-orig">₹2,999</span>
          <span class="d2c-sispot-tag">FREE LUXURY GIFT UNBOXING KIT</span>
        </div>

        <button class="d2c-sispot-btn">⚡ 1-CLICK FREE COD CHECKOUT &rarr;</button>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-sispot-{{ section.id }} {
    background: #141210;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-sispot-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sispot-card {
    background: #24201d;
    border-radius: 12px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    align-items: center;
    border: 1px solid rgba(214, 211, 209, 0.2);
  }
  .d2c-sispot-media img { width: 100%; height: 460px; object-fit: cover; border-radius: 8px; }
  .d2c-sispot-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #ffffff; line-height: 1.15; margin: 10px 0 16px; text-transform: uppercase; }
  .d2c-sispot-desc { font-size: 15px; color: #d6d3d1; line-height: 1.6; margin-bottom: 24px; }
  .d2c-sispot-matrix {
    background: #1c1917;
    border-radius: 6px;
    padding: 16px 20px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 1px solid rgba(214, 211, 209, 0.15);
  }
  .d2c-sim-item { display: flex; justify-content: space-between; font-size: 12px; color: #a8a29e; }
  .d2c-sim-item strong { color: #f5f5f4; }
  .d2c-sispot-price-row { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .d2c-sispot-price { font-size: 24px; font-weight: 900; color: #ffffff; }
  .d2c-sispot-orig { font-size: 14px; color: #78716c; text-decoration: line-through; }
  .d2c-sispot-tag { background: rgba(214, 211, 209, 0.15); color: #f5f5f4; font-size: 10px; font-weight: 800; padding: 4px 8px; border-radius: 4px; border: 1px solid #d6d3d1; }
  .d2c-sispot-btn {
    width: 100%;
    background: #ffffff;
    color: #1c1917;
    border: none;
    padding: 16px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .d2c-sispot-card { grid-template-columns: 1fr; padding: 24px; }
    .d2c-sispot-media img { height: 300px; }
  }
</style>

{% schema %}
{
  "name": "Silver Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ROSE GOLD FALLING DEWDROP EARRINGS"
    }
  ],
  "presets": [
    {
      "name": "Silver Spotlight"
    }
  ]
}
{% endschema %}
