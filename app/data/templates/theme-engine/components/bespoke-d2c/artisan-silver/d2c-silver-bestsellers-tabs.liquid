{% comment %}
  D2C Artisan 925 Silver Bestsellers
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<section class="d2c-silver-best" id="d2c-sibest-{{ section.id }}">
  <div class="d2c-sibest-container">
    <div class="d2c-sisec-header">
      <span class="d2c-si-badge">DAILY LUXE FAVORITES</span>
      <h2 class="d2c-si-title">{{ section.settings.title | default: "ICONIC 925 SILVER BESTSELLERS" }}</h2>
    </div>

    <div class="d2c-siprod-grid">
      <!-- Item 1 -->
      <div class="d2c-siprod-card">
        <div class="d2c-siprod-thumb">
          <span class="d2c-siprod-pill">ANUSHKA'S PICK</span>
          <img src="https://images.unsplash.com/photo-1603561591411-07134e71a2a9?w=600&q=80" alt="Rose Gold Drop Earrings" />
        </div>
        <div class="d2c-siprod-body">
          <span class="d2c-siprod-metal">925 SILVER • ROSE GOLD PLATED</span>
          <h3 class="d2c-siprod-title">Falling Dewdrop Zirconia Earrings</h3>
          <div class="d2c-siprod-price">₹1,799 <span class="d2c-siprod-orig">₹2,999</span></div>
          <button class="d2c-siatc-btn">+ ADD TO GIFT BOX</button>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="d2c-siprod-card">
        <div class="d2c-siprod-thumb">
          <span class="d2c-siprod-pill">FREE ENGRAVING</span>
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Silver Solitaire Pendant" />
        </div>
        <div class="d2c-siprod-body">
          <span class="d2c-siprod-metal">925 STERLING • RHODIUM SEAL</span>
          <h3 class="d2c-siprod-title">Classic Solitaire Zirconia Pendant</h3>
          <div class="d2c-siprod-price">₹1,499 <span class="d2c-siprod-orig">₹2,499</span></div>
          <button class="d2c-siatc-btn">+ ADD TO GIFT BOX</button>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="d2c-siprod-card">
        <div class="d2c-siprod-thumb">
          <span class="d2c-siprod-pill">ADJUSTABLE SIZE</span>
          <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=600&q=80" alt="Princess Crown Ring" />
        </div>
        <div class="d2c-siprod-body">
          <span class="d2c-siprod-metal">925 STERLING • SWISS ZIRCONIA</span>
          <h3 class="d2c-siprod-title">The Royal Princess Crown Ring</h3>
          <div class="d2c-siprod-price">₹1,299 <span class="d2c-siprod-orig">₹2,199</span></div>
          <button class="d2c-siatc-btn">+ ADD TO GIFT BOX</button>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="d2c-siprod-card">
        <div class="d2c-siprod-thumb">
          <span class="d2c-siprod-pill">EVIL EYE PROTECT</span>
          <img src="https://images.unsplash.com/photo-1611591475152-478d1c582489?w=600&q=80" alt="Silver Charm Bracelet" />
        </div>
        <div class="d2c-siprod-body">
          <span class="d2c-siprod-metal">925 STERLING • BLUE ENAMEL</span>
          <h3 class="d2c-siprod-title">Silver Blue Nazar Charm Bracelet</h3>
          <div class="d2c-siprod-price">₹1,899 <span class="d2c-siprod-orig">₹3,199</span></div>
          <button class="d2c-siatc-btn">+ ADD TO GIFT BOX</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-sibest-{{ section.id }} {
    background: #141210;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-sibest-container { max-width: 1360px; margin: 0 auto; }
  .d2c-siprod-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .d2c-siprod-card {
    background: #24201d;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(214, 211, 209, 0.15);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .d2c-siprod-thumb { position: relative; aspect-ratio: 1; overflow: hidden; background: #2e2a26; }
  .d2c-siprod-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-siprod-pill {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #f5f5f4;
    color: #1c1917;
    font-size: 9px;
    font-weight: 900;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }
  .d2c-siprod-body { padding: 18px; display: flex; flex-direction: column; flex-grow: 1; justify-content: space-between; }
  .d2c-siprod-metal { font-size: 10px; font-weight: 800; color: #a8a29e; letter-spacing: 0.5px; margin-bottom: 4px; }
  .d2c-siprod-title { font-size: 14px; font-weight: 800; color: #ffffff; margin-bottom: 10px; }
  .d2c-siprod-price { font-size: 16px; font-weight: 900; color: #ffffff; margin-bottom: 14px; }
  .d2c-siprod-orig { font-size: 12px; color: #78716c; text-decoration: line-through; margin-left: 6px; }
  .d2c-siatc-btn {
    width: 100%;
    background: #ffffff;
    color: #1c1917;
    border: none;
    padding: 12px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-siatc-btn:hover { background: #e7e5e4; }

  @media (max-width: 1024px) { .d2c-siprod-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-siprod-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } .d2c-siprod-body { padding: 12px; } }
</style>

{% schema %}
{
  "name": "Silver Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ICONIC 925 SILVER BESTSELLERS"
    }
  ],
  "presets": [
    {
      "name": "Silver Bestsellers"
    }
  ]
}
{% endschema %}
