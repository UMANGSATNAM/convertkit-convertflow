{% comment %}
  D2C Artisan 925 Silver Anti-Tarnish Test Reels
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<section class="d2c-silver-reels" id="d2c-sireels-{{ section.id }}">
  <div class="d2c-sireels-container">
    <div class="d2c-sisec-header">
      <span class="d2c-si-badge">ANTI-TARNISH STRESS TESTS</span>
      <h2 class="d2c-si-title">{{ section.settings.title | default: "REAL WATER, SWEAT & PERFUME TRIALS" }}</h2>
    </div>

    <div class="d2c-sireels-grid">
      <div class="d2c-sireel-card">
        <img src="https://images.unsplash.com/photo-1603561591411-07134e71a2a9?w=600&q=80" alt="Water Test" />
        <div class="d2c-sireel-overlay">
          <span class="d2c-sireel-tag">DAILY SHOWER SAFE</span>
          <h4 class="d2c-sireel-name">Zero Blackening After 30 Days of Daily Wear</h4>
          <span class="d2c-sireel-pill">Dewdrop Earrings · ₹1,799</span>
        </div>
      </div>

      <div class="d2c-sireel-card">
        <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Unboxing Reel" />
        <div class="d2c-sireel-overlay">
          <span class="d2c-sireel-tag">LUXURY GIFT UNBOXING</span>
          <h4 class="d2c-sireel-name">Free Velvet Box, Ribbon & Certificate</h4>
          <span class="d2c-sireel-pill">Solitaire Pendant · ₹1,499</span>
        </div>
      </div>

      <div class="d2c-sireel-card">
        <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=600&q=80" alt="Ring Styling" />
        <div class="d2c-sireel-overlay">
          <span class="d2c-sireel-tag">ADJUSTABLE FIT PROMISE</span>
          <h4 class="d2c-sireel-name">Comfortably Fits Any Finger Size</h4>
          <span class="d2c-sireel-pill">Princess Ring · ₹1,299</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-sireels-{{ section.id }} {
    background: #1c1917;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-sireels-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sireels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .d2c-sireel-card {
    position: relative;
    aspect-ratio: 9/16;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(214, 211, 209, 0.2);
    cursor: pointer;
  }
  .d2c-sireel-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .d2c-sireel-card:hover img { transform: scale(1.05); }
  .d2c-sireel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(28,25,23,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: #ffffff;
  }
  .d2c-sireel-tag { font-size: 10px; font-weight: 800; color: #d6d3d1; letter-spacing: 1px; margin-bottom: 4px; font-family: monospace; }
  .d2c-sireel-name { font-size: 15px; font-weight: 800; margin-bottom: 12px; }
  .d2c-sireel-pill {
    background: #ffffff;
    color: #1c1917;
    font-size: 11px;
    font-weight: 900;
    padding: 6px 14px;
    border-radius: 4px;
    display: inline-block;
    align-self: flex-start;
  }

  @media (max-width: 900px) { .d2c-sireels-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Silver Reels",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "REAL WATER, SWEAT & PERFUME TRIALS"
    }
  ],
  "presets": [
    {
      "name": "Silver Reels"
    }
  ]
}
{% endschema %}
