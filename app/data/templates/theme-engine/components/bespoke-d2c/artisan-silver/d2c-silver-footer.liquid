{% comment %}
  D2C Artisan 925 Silver Footer
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<footer class="d2c-silver-footer" id="d2c-sifoot-{{ section.id }}">
  <div class="d2c-silver-container">
    <div class="d2c-sifoot-top">
      <div class="d2c-sifoot-brand">
        <h3 class="d2c-sifoot-logo">{{ section.settings.brand_name | default: "GIVA ARTISAN SILVER" }}</h3>
        <p class="d2c-sifoot-desc">Authentic 925 sterling silver fine jewelry made for your everyday stories. Triple rhodium anti-tarnish plated with BIS hallmark certification.</p>
        <div class="d2c-sifoot-hallmark">🥈 100% BIS HALLMARKED 925 STERLING SILVER</div>
      </div>

      <div class="d2c-sifoot-col">
        <h4 class="d2c-sicol-title">SHOP CATEGORIES</h4>
        <ul class="d2c-sicol-links">
          <li><a href="/collections/silver-rings">925 Sterling Rings</a></li>
          <li><a href="/collections/silver-earrings">Dewdrop & Stud Earrings</a></li>
          <li><a href="/collections/silver-pendants">Minimal Solitaire Pendants</a></li>
          <li><a href="/collections/silver-bracelets">Charm & Tennis Bracelets</a></li>
          <li><a href="/collections/men-silver">Men's Silver Collection</a></li>
        </ul>
      </div>

      <div class="d2c-sifoot-col">
        <h4 class="d2c-sicol-title">CUSTOMER CARE</h4>
        <ul class="d2c-sicol-links">
          <li><a href="/pages/track-order">Track Insured Delivery</a></li>
          <li><a href="/pages/warranty">Claim 6-Month Warranty</a></li>
          <li><a href="/pages/ring-sizer">Free Ring Sizing Guide</a></li>
          <li><a href="/pages/stores">Find Store Near You</a></li>
          <li><a href="/pages/contact">WhatsApp Support (24/7)</a></li>
        </ul>
      </div>

      <div class="d2c-sifoot-col">
        <h4 class="d2c-sicol-title">GIFTING & PROMISES</h4>
        <p class="d2c-sifoot-sub-desc">Free signature unboxing gift packaging, complimentary silver polishing cloth, and 30-day money-back guarantee with zero deduction.</p>
      </div>
    </div>

    <div class="d2c-sifoot-bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: "GIVA ARTISAN SILVER JEWELLERY PVT. LTD." }}. ALL RIGHTS RESERVED.</div>
      <div class="d2c-sifoot-legal">
        <a href="/policies/privacy-policy">Privacy Disclosure</a>
        <a href="/policies/terms-of-service">Terms of Supply</a>
        <a href="/policies/shipping-policy">Shipping & COD Terms</a>
      </div>
    </div>
  </div>
</footer>

<style>
  #d2c-sifoot-{{ section.id }} {
    background: #141210;
    color: #d6d3d1;
    padding: 70px 32px 30px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    border-top: 1px solid rgba(214, 211, 209, 0.2);
  }
  .d2c-silver-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sifoot-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .d2c-sifoot-logo { font-size: 20px; font-weight: 900; color: #ffffff; letter-spacing: 1.5px; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-sifoot-desc { font-size: 13px; color: #a8a29e; line-height: 1.6; margin-bottom: 16px; max-width: 320px; }
  .d2c-sifoot-hallmark { font-size: 11px; font-weight: 800; color: #f5f5f4; }
  .d2c-sicol-title { font-size: 12px; font-weight: 900; color: #ffffff; letter-spacing: 1px; margin-bottom: 16px; text-transform: uppercase; }
  .d2c-sicol-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .d2c-sicol-links a { color: #d6d3d1; text-decoration: none; font-size: 13px; opacity: 0.85; transition: opacity 0.15s ease; }
  .d2c-sicol-links a:hover { opacity: 1; color: #ffffff; }
  .d2c-sifoot-sub-desc { font-size: 13px; line-height: 1.6; opacity: 0.85; }
  .d2c-sifoot-bottom {
    border-top: 1px solid rgba(214, 211, 209, 0.15);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
  }
  .d2c-sifoot-legal { display: flex; gap: 20px; }
  .d2c-sifoot-legal a { color: inherit; text-decoration: none; }
  .d2c-sifoot-legal a:hover { color: #ffffff; }

  @media (max-width: 1024px) { .d2c-sifoot-top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) {
    .d2c-sifoot-top { grid-template-columns: 1fr; }
    .d2c-sifoot-bottom { flex-direction: column; gap: 12px; text-align: center; }
  }
</style>

{% schema %}
{
  "name": "Silver Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "GIVA ARTISAN SILVER"
    }
  ],
  "presets": [
    {
      "name": "Silver Footer"
    }
  ]
}
{% endschema %}
