{% comment %}
  D2C Artisan 925 Silver Community Gallery
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<section class="d2c-silver-ugc" id="d2c-siugc-{{ section.id }}">
  <div class="d2c-siugc-container">
    <div class="d2c-sisec-header">
      <span class="d2c-si-badge">#GIVAFAMINDIA</span>
      <h2 class="d2c-si-title">{{ section.settings.title | default: "TAGGED BY 1,500,000+ SILVER LOVERS" }}</h2>
    </div>

    <div class="d2c-siugc-grid">
      <div class="d2c-siugc-tile"><img src="https://images.unsplash.com/photo-1603561591411-07134e71a2a9?w=600&q=80" alt="Silver UGC 1" /><span>@riya_styles · Dewdrop Earrings</span></div>
      <div class="d2c-siugc-tile"><img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Silver UGC 2" /><span>@ananya_daily · Solitaire Pendant</span></div>
      <div class="d2c-siugc-tile"><img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=600&q=80" alt="Silver UGC 3" /><span>@sneha_gift · Princess Ring</span></div>
      <div class="d2c-siugc-tile"><img src="https://images.unsplash.com/photo-1611591475152-478d1c582489?w=600&q=80" alt="Silver UGC 4" /><span>@tara_wrist · Blue Nazar Bracelet</span></div>
    </div>
  </div>
</section>

<style>
  #d2c-siugc-{{ section.id }} {
    background: #1c1917;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-siugc-container { max-width: 1360px; margin: 0 auto; }
  .d2c-siugc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .d2c-siugc-tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    background: #24201d;
    border: 1px solid rgba(214, 211, 209, 0.2);
  }
  .d2c-siugc-tile img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-siugc-tile span {
    position: absolute;
    bottom: 8px;
    left: 8px;
    right: 8px;
    background: rgba(28,25,23,0.85);
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    padding: 6px;
    text-align: center;
    border-radius: 4px;
  }

  @media (max-width: 900px) { .d2c-siugc-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

{% schema %}
{
  "name": "Silver Community",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "TAGGED BY 1,500,000+ SILVER LOVERS"
    }
  ],
  "presets": [
    {
      "name": "Silver Community"
    }
  ]
}
{% endschema %}
