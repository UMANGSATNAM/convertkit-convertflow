{% comment %}
  D2C Artisan 925 Silver Trust Badges
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<section class="d2c-silver-trust" id="d2c-sitrust-{{ section.id }}">
  <div class="d2c-silver-container">
    <div class="d2c-sitrust-grid">
      <div class="d2c-sitrust-item">
        <div class="d2c-sitrust-icon">🥈</div>
        <h4 class="d2c-sitrust-title">925 BIS HALLMARKED</h4>
        <p class="d2c-sitrust-desc">100% solid sterling silver stamped with the official 925 hallmark & authenticity certificate.</p>
      </div>

      <div class="d2c-sitrust-item">
        <div class="d2c-sitrust-icon">🛡️</div>
        <h4 class="d2c-sitrust-title">6-MONTH WARRANTY</h4>
        <p class="d2c-sitrust-desc">Free replating and repair warranty against tarnish or manufacturing defects.</p>
      </div>

      <div class="d2c-sitrust-item">
        <div class="d2c-sitrust-icon">🎁</div>
        <h4 class="d2c-sitrust-title">FREE LUXURY GIFT BOX</h4>
        <p class="d2c-sitrust-desc">Every piece arrives in our signature velvet unboxing box with a personalized card.</p>
      </div>

      <div class="d2c-sitrust-item">
        <div class="d2c-sitrust-icon">🚚</div>
        <h4 class="d2c-sitrust-title">FREE CASH ON DELIVERY</h4>
        <p class="d2c-sitrust-desc">Doorstep COD with zero handling fees across 24,000+ Indian pincodes.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-sitrust-{{ section.id }} {
    background: #141210;
    color: #ffffff;
    padding: 50px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-silver-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sitrust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }
  .d2c-sitrust-item {
    background: #24201d;
    border: 1px solid rgba(214, 211, 209, 0.15);
    border-radius: 8px;
    padding: 28px 18px;
  }
  .d2c-sitrust-icon { font-size: 26px; margin-bottom: 10px; }
  .d2c-sitrust-title { font-size: 12px; font-weight: 800; color: #f5f5f4; letter-spacing: 0.5px; margin-bottom: 6px; text-transform: uppercase; }
  .d2c-sitrust-desc { font-size: 12px; color: #a8a29e; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-sitrust-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-sitrust-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Silver Trust Badges",
  "settings": [],
  "presets": [
    {
      "name": "Silver Trust Badges"
    }
  ]
}
{% endschema %}
