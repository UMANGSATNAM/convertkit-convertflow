{% comment %}
  D2C Artisan 925 Silver Announcement Bar
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<div class="d2c-silver-announcement" id="d2c-siann-{{ section.id }}">
  <div class="d2c-siann-inner">
    <span>✨</span>
    <span class="d2c-siann-text">{{ section.settings.text | default: "925 SILVER FESTIVAL // BUY 2 GET 1 FREE + FREE LUXURY UNBOXING GIFT BOX" }}</span>
    <span class="d2c-siann-sep">✦</span>
    <span class="d2c-siann-sub">ANTI-TARNISH RHODIUM COATING</span>
  </div>
</div>

<style>
  #d2c-siann-{{ section.id }} {
    background: #1c1917;
    color: #f5f5f4;
    padding: 10px 16px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-align: center;
    border-bottom: 1px solid rgba(214, 211, 209, 0.3);
  }
  .d2c-siann-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }
  .d2c-siann-sub { color: #cbd5e1; font-weight: 900; }
  .d2c-siann-sep { opacity: 0.6; }
  @media (max-width: 768px) { #d2c-siann-{{ section.id }} { font-size: 11px; padding: 8px 12px; } .d2c-siann-sub { display: none; } }
</style>

{% schema %}
{
  "name": "Silver Announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "925 SILVER FESTIVAL // BUY 2 GET 1 FREE + FREE LUXURY UNBOXING GIFT BOX"
    }
  ],
  "presets": [
    {
      "name": "Silver Announcement"
    }
  ]
}
{% endschema %}
