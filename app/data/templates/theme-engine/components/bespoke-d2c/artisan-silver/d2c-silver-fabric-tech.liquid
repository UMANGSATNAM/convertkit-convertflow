{% comment %}
  D2C Artisan 925 Silver Craft & Anti-Tarnish Matrix
  Theme: GIVA / Shaya Handcrafted 925 Silver
{% endcomment %}

<section class="d2c-silver-matrix" id="d2c-simat-{{ section.id }}">
  <div class="d2c-simat-container">
    <div class="d2c-sisec-header">
      <span class="d2c-si-badge">PURITY & CRAFT MATRIX</span>
      <h2 class="d2c-si-title">{{ section.settings.title | default: "WHY OUR 925 SILVER NEVER LOSES ITS LUSTER" }}</h2>
    </div>

    <div class="d2c-simat-grid">
      <div class="d2c-simat-card">
        <div class="d2c-simat-val">92.5%</div>
        <div class="d2c-simat-name">PURE STERLING SILVER</div>
        <p class="d2c-simat-desc">925 hallmarked solid silver alloyed with pure copper for strength. Zero cheap brass or nickel fillers.</p>
      </div>

      <div class="d2c-simat-card">
        <div class="d2c-simat-val">0.5 MICRON</div>
        <div class="d2c-simat-name">RHODIUM SHIELD</div>
        <p class="d2c-simat-desc">Triple flash plated in precious platinum-family rhodium to create an impenetrable anti-oxidation barrier.</p>
      </div>

      <div class="d2c-simat-card">
        <div class="d2c-simat-val">100%</div>
        <div class="d2c-simat-name">HYPOALLERGENIC & LEAD-FREE</div>
        <p class="d2c-simat-desc">Certified 100% skin safe. Wear it all day through sweat and humidity without skin irritation or green marks.</p>
      </div>

      <div class="d2c-simat-card">
        <div class="d2c-simat-val">6 MONTHS</div>
        <div class="d2c-simat-name">REPLATING REPLACEMENT</div>
        <p class="d2c-simat-desc">Hassle-free 6-month warranty. If it ever loses shine, we replate or replace it for free.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-simat-{{ section.id }} {
    background: #141210;
    padding: 70px 32px;
    border-top: 1px solid rgba(214, 211, 209, 0.15);
    border-bottom: 1px solid rgba(214, 211, 209, 0.15);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-simat-container { max-width: 1360px; margin: 0 auto; }
  .d2c-simat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-simat-card {
    background: #24201d;
    border: 1px solid rgba(214, 211, 209, 0.15);
    border-radius: 8px;
    padding: 32px 20px;
    text-align: center;
  }
  .d2c-simat-val { font-size: 28px; font-weight: 900; color: #f5f5f4; margin-bottom: 6px; }
  .d2c-simat-name { font-size: 12px; font-weight: 800; color: #ffffff; letter-spacing: 0.5px; margin-bottom: 10px; }
  .d2c-simat-desc { font-size: 13px; color: #d6d3d1; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-simat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-simat-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Silver Craft Matrix",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "WHY OUR 925 SILVER NEVER LOSES ITS LUSTER"
    }
  ],
  "presets": [
    {
      "name": "Silver Craft Matrix"
    }
  ]
}
{% endschema %}
