{% comment %}
  D2C Minimal Menswear 3-Piece Capsule Builder
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-bundle" id="d2c-mbundle-{{ section.id }}">
  <div class="d2c-mbundle-container">
    <div class="d2c-mbundle-box">
      <div class="d2c-mbundle-info">
        <span class="d2c-m-badge">CAPSULE BUNDLE & SAVE</span>
        <h2 class="d2c-mbundle-title">{{ section.settings.title | default: "THE COMPLETE 3-PIECE WORK CAPSULE" }}</h2>
        <p class="d2c-mbundle-desc">
          Combine any 1 Tech Oxford Shirt, 1 Flex Chino, and 1 Supima Crew Tee. Unlock an instant ₹1,200 cart discount + Free Cash on Delivery.
        </p>
        <div class="d2c-mbundle-price">BUNDLE PRICE: ₹4,499 <span class="d2c-mb-orig">₹5,997</span> <span class="d2c-mb-tag">SAVE 25%</span></div>
        <button class="d2c-mb-btn">BUILD YOUR CUSTOM CAPSULE &rarr;</button>
      </div>

      <div class="d2c-mbundle-visual">
        <div class="d2c-mbi-card">
          <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=400&q=80" alt="Shirt" />
          <span>Tech Shirt</span>
        </div>
        <span class="d2c-mbi-plus">+</span>
        <div class="d2c-mbi-card">
          <img src="https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?w=400&q=80" alt="Chinos" />
          <span>Flex Chino</span>
        </div>
        <span class="d2c-mbi-plus">+</span>
        <div class="d2c-mbi-card">
          <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=400&q=80" alt="Tee" />
          <span>Supima Tee</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-mbundle-{{ section.id }} {
    background: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mbundle-container { max-width: 1320px; margin: 0 auto; }
  .d2c-mbundle-box {
    background: #f7f6f2;
    border-radius: 12px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    border: 1px solid rgba(0,0,0,0.06);
  }
  .d2c-mbundle-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #18181b; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-mbundle-desc { font-size: 15px; color: #52525b; line-height: 1.6; margin-bottom: 24px; }
  .d2c-mbundle-price { font-size: 20px; font-weight: 900; color: #18181b; margin-bottom: 28px; }
  .d2c-mb-orig { font-size: 14px; color: #a1a1aa; text-decoration: line-through; margin-left: 6px; }
  .d2c-mb-tag { background: #dcfce7; color: #15803d; font-size: 11px; font-weight: 800; padding: 4px 8px; border-radius: 4px; margin-left: 8px; }
  .d2c-mb-btn {
    background: #2d4a3e;
    color: #ffffff;
    border: none;
    padding: 16px 32px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-mbundle-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .d2c-mbi-card {
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 8px;
    overflow: hidden;
    text-align: center;
    padding: 8px;
    width: 120px;
  }
  .d2c-mbi-card img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; margin-bottom: 6px; }
  .d2c-mbi-card span { font-size: 11px; font-weight: 700; color: #18181b; }
  .d2c-mbi-plus { font-size: 20px; font-weight: 800; color: #2d4a3e; }

  @media (max-width: 900px) {
    .d2c-mbundle-box { grid-template-columns: 1fr; padding: 24px; }
  }
</style>

{% schema %}
{
  "name": "Minimal Capsule Builder",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE COMPLETE 3-PIECE WORK CAPSULE"
    }
  ],
  "presets": [
    {
      "name": "Minimal Capsule Builder"
    }
  ]
}
{% endschema %}
