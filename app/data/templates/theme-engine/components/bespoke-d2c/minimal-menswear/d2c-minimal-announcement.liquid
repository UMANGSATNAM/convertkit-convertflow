{% comment %}
  D2C Minimal Menswear Announcement Bar
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<div class="d2c-minimal-announcement" id="d2c-mann-{{ section.id }}">
  <div class="d2c-mann-inner">
    <span class="d2c-mann-text">{{ section.settings.text | default: "🌿 4-WAY STRETCH TECH-COTTON '26 // FREE CASH ON DELIVERY NATIONWIDE" }}</span>
    {% if section.settings.link_text != blank %}
      <a href="{{ section.settings.link_url | default: '/collections/all' }}" class="d2c-mann-link">{{ section.settings.link_text }} &rarr;</a>
    {% endif %}
  </div>
</div>

<style>
  #d2c-mann-{{ section.id }} {
    background: #18181b;
    color: #ffffff;
    padding: 10px 16px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-align: center;
  }
  .d2c-mann-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }
  .d2c-mann-link { color: #10b981; font-weight: 800; text-decoration: underline; }
  @media (max-width: 768px) { #d2c-mann-{{ section.id }} { font-size: 11px; padding: 8px 12px; } }
</style>

{% schema %}
{
  "name": "Minimal Announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "🌿 4-WAY STRETCH TECH-COTTON '26 // FREE CASH ON DELIVERY NATIONWIDE"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "EXPLORE CAPSULE"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "presets": [
    {
      "name": "Minimal Announcement"
    }
  ]
}
{% endschema %}
