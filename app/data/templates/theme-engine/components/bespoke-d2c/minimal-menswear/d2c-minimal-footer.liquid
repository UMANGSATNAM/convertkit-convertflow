{% comment %}
  D2C Minimal Menswear Clean Footer
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<footer class="d2c-minimal-footer" id="d2c-mfoot-{{ section.id }}">
  <div class="d2c-mfoot-container">
    <div class="d2c-mfoot-top">
      <div class="d2c-mfoot-brand">
        <h3 class="d2c-mfoot-logo">{{ section.settings.brand_name | default: "SNITCH & NORDIC" }}</h3>
        <p class="d2c-mfoot-desc">Modern engineered apparel designed for unrestricted everyday living. Premium thermo-regulating cottons and 4-way performance stretch fabrics.</p>
        <div class="d2c-mfoot-badge">🌿 100% GOTS CERTIFIED ORGANIC COTTON</div>
      </div>

      <div class="d2c-mfoot-col">
        <h4 class="d2c-mcol-title">SHOP ESSENTIALS</h4>
        <ul class="d2c-mcol-links">
          <li><a href="/collections/stretch-shirts">4-Way Tech Shirts</a></li>
          <li><a href="/collections/chinos">All-Day Flex Chinos</a></li>
          <li><a href="/collections/tees">Supima Heavy Tees</a></li>
          <li><a href="/collections/linen">Pure European Linen</a></li>
          <li><a href="/pages/capsule">3-Piece Capsule Bundles</a></li>
        </ul>
      </div>

      <div class="d2c-mfoot-col">
        <h4 class="d2c-mcol-title">CUSTOMER CARE</h4>
        <ul class="d2c-mcol-links">
          <li><a href="/pages/track-order">Track COD Delivery</a></li>
          <li><a href="/pages/returns">Instant Doorstep Exchanges</a></li>
          <li><a href="/pages/size-guide">Interactive Fit Guide</a></li>
          <li><a href="/pages/fabric-care">Wash & Fabric Guide</a></li>
          <li><a href="/pages/contact">WhatsApp Support (24/7)</a></li>
        </ul>
      </div>

      <div class="d2c-mfoot-col">
        <h4 class="d2c-mcol-title">SUSTAINABILITY</h4>
        <p class="d2c-mfoot-sub-desc">Zero harmful microplastics, zero toxic chemical washes, 100% recyclable paper packaging.</p>
      </div>
    </div>

    <div class="d2c-mfoot-bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: "SNITCH APPAREL PVT. LTD." }}. ALL RIGHTS RESERVED.</div>
      <div class="d2c-mfoot-legal">
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <a href="/policies/terms-of-service">Terms of Sale</a>
        <a href="/policies/shipping-policy">COD & Shipping Policy</a>
      </div>
    </div>
  </div>
</footer>

<style>
  #d2c-mfoot-{{ section.id }} {
    background: #18181b;
    color: #a1a1aa;
    padding: 70px 32px 30px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mfoot-container { max-width: 1320px; margin: 0 auto; }
  .d2c-mfoot-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .d2c-mfoot-logo { font-size: 18px; font-weight: 900; color: #ffffff; letter-spacing: -0.5px; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-mfoot-desc { font-size: 13px; color: #a1a1aa; line-height: 1.6; margin-bottom: 16px; max-width: 320px; }
  .d2c-mfoot-badge { font-size: 11px; font-weight: 800; color: #10b981; }
  .d2c-mcol-title { font-size: 12px; font-weight: 800; color: #ffffff; letter-spacing: 0.5px; margin-bottom: 16px; text-transform: uppercase; }
  .d2c-mcol-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .d2c-mcol-links a { color: #a1a1aa; text-decoration: none; font-size: 13px; transition: color 0.15s ease; }
  .d2c-mcol-links a:hover { color: #ffffff; }
  .d2c-mfoot-sub-desc { font-size: 13px; line-height: 1.6; }
  .d2c-mfoot-bottom {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
  }
  .d2c-mfoot-legal { display: flex; gap: 20px; }
  .d2c-mfoot-legal a { color: inherit; text-decoration: none; }
  .d2c-mfoot-legal a:hover { color: #ffffff; }

  @media (max-width: 1024px) { .d2c-mfoot-top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) {
    .d2c-mfoot-top { grid-template-columns: 1fr; }
    .d2c-mfoot-bottom { flex-direction: column; gap: 12px; text-align: center; }
  }
</style>

{% schema %}
{
  "name": "Minimal Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "SNITCH & NORDIC"
    }
  ],
  "presets": [
    {
      "name": "Minimal Footer"
    }
  ]
}
{% endschema %}
