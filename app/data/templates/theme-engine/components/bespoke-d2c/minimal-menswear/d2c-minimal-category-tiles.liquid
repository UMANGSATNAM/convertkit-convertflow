{% comment %}
  D2C Minimal Menswear Category Grid
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-cats" id="d2c-mcats-{{ section.id }}">
  <div class="d2c-mcats-container">
    <div class="d2c-msec-header">
      <span class="d2c-m-badge">THE ARCHITECTURE</span>
      <h2 class="d2c-m-title">{{ section.settings.title | default: "MODULAR EVERYDAY SILHOUETTES" }}</h2>
    </div>

    <div class="d2c-mcats-grid">
      <a href="/collections/stretch-shirts" class="d2c-mcat-card">
        <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=600&q=80" alt="Tech Oxford Shirts" />
        <div class="d2c-mcat-info">
          <h3 class="d2c-mcat-name">4-WAY TECH SHIRTS</h3>
          <span class="d2c-mcat-count">18 Essential Colorways</span>
        </div>
      </a>

      <a href="/collections/chinos" class="d2c-mcat-card">
        <img src="https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?w=600&q=80" alt="Flex Chinos" />
        <div class="d2c-mcat-info">
          <h3 class="d2c-mcat-name">ALL-DAY FLEX CHINOS</h3>
          <span class="d2c-mcat-count">12 Core Tones</span>
        </div>
      </a>

      <a href="/collections/tees" class="d2c-mcat-card">
        <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=600&q=80" alt="Supima Tees" />
        <div class="d2c-mcat-info">
          <h3 class="d2c-mcat-name">SUPIMA HEAVY TEES</h3>
          <span class="d2c-mcat-count">24 Relaxed Cuts</span>
        </div>
      </a>

      <a href="/collections/linen" class="d2c-mcat-card">
        <img src="https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=600&q=80" alt="European Linen" />
        <div class="d2c-mcat-info">
          <h3 class="d2c-mcat-name">PURE EUROPEAN LINEN</h3>
          <span class="d2c-mcat-count">10 Breathable Fits</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  #d2c-mcats-{{ section.id }} {
    background: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mcats-container { max-width: 1320px; margin: 0 auto; }
  .d2c-msec-header { text-align: center; margin-bottom: 48px; }
  .d2c-m-badge { font-size: 11px; font-weight: 800; color: #2d4a3e; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 8px; display: block; }
  .d2c-m-title { font-size: clamp(26px, 3vw, 38px); font-weight: 900; color: #18181b; letter-spacing: -0.5px; text-transform: uppercase; }
  .d2c-mcats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-mcat-card {
    background: #f7f6f2;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(0,0,0,0.06);
    transition: transform 0.2s ease;
  }
  .d2c-mcat-card:hover { transform: translateY(-4px); }
  .d2c-mcat-card img { width: 100%; height: 320px; object-fit: cover; }
  .d2c-mcat-info { padding: 18px; text-align: center; }
  .d2c-mcat-name { font-size: 14px; font-weight: 800; color: #18181b; margin-bottom: 4px; }
  .d2c-mcat-count { font-size: 12px; color: #71717a; }

  @media (max-width: 1024px) { .d2c-mcats-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-mcats-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Minimal Categories",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "MODULAR EVERYDAY SILHOUETTES"
    }
  ],
  "presets": [
    {
      "name": "Minimal Categories"
    }
  ]
}
{% endschema %}
