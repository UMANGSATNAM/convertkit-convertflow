{% comment %}
  D2C Minimal Menswear Verified Reviews
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-reviews" id="d2c-mrev-{{ section.id }}">
  <div class="d2c-mrev-container">
    <div class="d2c-msec-header">
      <span class="d2c-m-badge">VERIFIED BUYERS</span>
      <h2 class="d2c-m-title">{{ section.settings.title | default: "RATED 4.9/5 BY 40,000+ MEN" }}</h2>
    </div>

    <div class="d2c-mrev-grid">
      <div class="d2c-mrev-card">
        <div class="d2c-mrev-stars">★★★★★</div>
        <p class="d2c-mrev-quote">"The 4-way stretch on the chinos is insane. I wear them to back-to-back VC meetings in Bangalore, and they never get wrinkled or uncomfortable."</p>
        <div class="d2c-mrev-author">
          <span class="d2c-mrev-name">Aditya Sen</span>
          <span class="d2c-mrev-tag">Verified Buyer • All-Day Flex Chinos</span>
        </div>
      </div>

      <div class="d2c-mrev-card">
        <div class="d2c-mrev-stars">★★★★★</div>
        <p class="d2c-mrev-quote">"Best everyday work shirts I've ever owned. Zero iron needed after wash, perfectly tapered fit, and the Supima cotton feels 10x softer than standard retail brands."</p>
        <div class="d2c-mrev-author">
          <span class="d2c-mrev-name">Kunal Verma</span>
          <span class="d2c-mrev-tag">Verified Buyer • Tech Oxford Shirt</span>
        </div>
      </div>

      <div class="d2c-mrev-card">
        <div class="d2c-mrev-stars">★★★★★</div>
        <p class="d2c-mrev-quote">"The 3-pack capsule bundle transformed my wardrobe. I packed just 6 items for a 5-day client trip to Mumbai, and had fresh outfits every single day."</p>
        <div class="d2c-mrev-author">
          <span class="d2c-mrev-name">Varun Kapoor</span>
          <span class="d2c-mrev-tag">Verified Buyer • 3-Piece Capsule Set</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-mrev-{{ section.id }} {
    background: #f7f6f2;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mrev-container { max-width: 1320px; margin: 0 auto; }
  .d2c-mrev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .d2c-mrev-card {
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 10px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .d2c-mrev-stars { color: #f59e0b; font-size: 16px; margin-bottom: 12px; }
  .d2c-mrev-quote { font-size: 14px; color: #52525b; line-height: 1.6; margin-bottom: 20px; }
  .d2c-mrev-name { font-size: 14px; font-weight: 800; color: #18181b; display: block; margin-bottom: 2px; }
  .d2c-mrev-tag { font-size: 11px; color: #10b981; font-weight: 700; }

  @media (max-width: 900px) { .d2c-mrev-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Minimal Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "RATED 4.9/5 BY 40,000+ MEN"
    }
  ],
  "presets": [
    {
      "name": "Minimal Reviews"
    }
  ]
}
{% endschema %}
