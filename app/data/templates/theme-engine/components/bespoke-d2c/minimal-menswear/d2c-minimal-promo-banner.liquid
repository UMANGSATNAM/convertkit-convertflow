{% comment %}
  D2C Minimal Menswear Flash Promo Banner
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-promo" id="d2c-mpromo-{{ section.id }}">
  <div class="d2c-mpromo-container">
    <div class="d2c-mpromo-card">
      <span class="d2c-m-badge">WEEKEND RESTOCK EVENT</span>
      <h2 class="d2c-mpromo-title">{{ section.settings.title | default: "FLAT ₹500 OFF YOUR FIRST CAPSULE" }}</h2>
      <p class="d2c-mpromo-desc">Use coupon code <span class="d2c-mpromo-code">CAPSULE500</span> at checkout on orders above ₹2,499. Includes free shipping & zero-cost COD.</p>
      <a href="/collections/all" class="d2c-mpromo-btn">SHOP THE DROP &rarr;</a>
    </div>
  </div>
</section>

<style>
  #d2c-mpromo-{{ section.id }} {
    background: #ffffff;
    padding: 50px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mpromo-container { max-width: 1320px; margin: 0 auto; }
  .d2c-mpromo-card {
    background: #18181b;
    color: #ffffff;
    border-radius: 12px;
    padding: 56px 36px;
    text-align: center;
  }
  .d2c-mpromo-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 900; letter-spacing: -0.5px; margin: 10px 0 14px; text-transform: uppercase; }
  .d2c-mpromo-desc { font-size: 15px; color: #a1a1aa; max-width: 580px; margin: 0 auto 28px; line-height: 1.6; }
  .d2c-mpromo-code { background: #27272a; color: #10b981; padding: 3px 8px; border-radius: 4px; font-weight: 800; font-family: monospace; }
  .d2c-mpromo-btn {
    display: inline-block;
    background: #ffffff;
    color: #18181b;
    padding: 14px 32px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
  }
  .d2c-mpromo-btn:hover { background: #e4e4e7; }
</style>

{% schema %}
{
  "name": "Minimal Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FLAT ₹500 OFF YOUR FIRST CAPSULE"
    }
  ],
  "presets": [
    {
      "name": "Minimal Promo Banner"
    }
  ]
}
{% endschema %}
