{% comment %}
  D2C Minimal Menswear Real Fit Reels
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-reels" id="d2c-mreels-{{ section.id }}">
  <div class="d2c-mreels-container">
    <div class="d2c-msec-header">
      <span class="d2c-m-badge">REAL LIFE DRAPE</span>
      <h2 class="d2c-m-title">{{ section.settings.title | default: "WATCH THE FIT IN MOTION" }}</h2>
    </div>

    <div class="d2c-mreels-grid">
      <div class="d2c-mreel-card">
        <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=600&q=80" alt="Oxford Fit" />
        <div class="d2c-mreel-overlay">
          <div class="d2c-mreel-user">@nikhil.workfit</div>
          <div class="d2c-mreel-title">18-Hour airport travel test with Flex Chinos</div>
          <span class="d2c-mreel-pill">Flex Chinos · ₹2,499</span>
        </div>
      </div>

      <div class="d2c-mreel-card">
        <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=600&q=80" alt="Linen Drape" />
        <div class="d2c-mreel-overlay">
          <div class="d2c-mreel-user">@aditya_minimal</div>
          <div class="d2c-mreel-title">Goa weekend styling in Pure French Linen</div>
          <span class="d2c-mreel-pill">Linen Shirt · ₹2,899</span>
        </div>
      </div>

      <div class="d2c-mreel-card">
        <img src="https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?w=600&q=80" alt="Supima Tee" />
        <div class="d2c-mreel-overlay">
          <div class="d2c-mreel-user">@samarth.lifestyle</div>
          <div class="d2c-mreel-title">Why 240 GSM Supima beats ordinary tees</div>
          <span class="d2c-mreel-pill">Supima Tee · ₹999</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-mreels-{{ section.id }} {
    background: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mreels-container { max-width: 1320px; margin: 0 auto; }
  .d2c-mreels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .d2c-mreel-card {
    position: relative;
    aspect-ratio: 9/16;
    border-radius: 12px;
    overflow: hidden;
    background: #f7f6f2;
    cursor: pointer;
  }
  .d2c-mreel-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .d2c-mreel-card:hover img { transform: scale(1.05); }
  .d2c-mreel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(24,24,27,0.9) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: #ffffff;
  }
  .d2c-mreel-user { font-size: 11px; font-weight: 800; color: #10b981; margin-bottom: 4px; }
  .d2c-mreel-title { font-size: 14px; font-weight: 700; line-height: 1.3; margin-bottom: 12px; }
  .d2c-mreel-pill {
    background: #ffffff;
    color: #18181b;
    font-size: 11px;
    font-weight: 800;
    padding: 6px 12px;
    border-radius: 6px;
    display: inline-block;
    align-self: flex-start;
  }

  @media (max-width: 900px) { .d2c-mreels-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Minimal Reels",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "WATCH THE FIT IN MOTION"
    }
  ],
  "presets": [
    {
      "name": "Minimal Reels"
    }
  ]
}
{% endschema %}
