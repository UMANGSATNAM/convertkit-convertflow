{% comment %}
  D2C Minimal Menswear Capsule Club Perks
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-vip" id="d2c-mvip-{{ section.id }}">
  <div class="d2c-mvip-container">
    <div class="d2c-mvip-box">
      <div class="d2c-msec-header">
        <span class="d2c-m-badge">MEMBERSHIP PRIVILEGES</span>
        <h2 class="d2c-m-title">{{ section.settings.title | default: "THE CAPSULE REPLENISH CLUB" }}</h2>
        <p class="d2c-mvip-desc">Never run out of crisp essentials. Auto-deliver fresh Supima tees and shirts with VIP benefits.</p>
      </div>

      <div class="d2c-mvip-grid">
        <div class="d2c-mvip-card">
          <div class="d2c-mv-tier">TIER 1 // MEMBER</div>
          <div class="d2c-mv-title">FLAT 15% OFF ALL DROPS</div>
          <p class="d2c-mv-desc">Permanent discount across the full catalog with automatic free express shipping on every single order.</p>
        </div>

        <div class="d2c-mvip-card popular">
          <span class="d2c-mv-badge">MOST POPULAR</span>
          <div class="d2c-mv-tier">TIER 2 // AUTOPILOT</div>
          <div class="d2c-mv-title">QUARTERLY CAPSULE BOX</div>
          <p class="d2c-mv-desc">Receive 3 new season colorways every 90 days at 30% subscriber savings. Skip or swap anytime.</p>
        </div>

        <div class="d2c-mvip-card">
          <div class="d2c-mv-tier">TIER 3 // VIP BLACK</div>
          <div class="d2c-mv-title">EARLY ACCESS + FREE TAILORING</div>
          <p class="d2c-mv-desc">48-hour early drop access, complimentary custom pant hem tailoring, and dedicated style concierge.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-mvip-{{ section.id }} {
    background: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mvip-container { max-width: 1320px; margin: 0 auto; }
  .d2c-mvip-box {
    background: #f7f6f2;
    border-radius: 12px;
    padding: 48px 36px;
  }
  .d2c-mvip-desc { font-size: 15px; color: #52525b; max-width: 540px; margin: 8px auto 0; text-align: center; }
  .d2c-mvip-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .d2c-mvip-card {
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 8px;
    padding: 32px 24px;
    text-align: center;
    position: relative;
  }
  .d2c-mvip-card.popular { border: 2px solid #2d4a3e; }
  .d2c-mv-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #2d4a3e;
    color: #ffffff;
    font-size: 9px;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 99px;
    letter-spacing: 0.5px;
  }
  .d2c-mv-tier { font-size: 10px; font-weight: 800; color: #10b981; letter-spacing: 1px; margin-bottom: 8px; }
  .d2c-mv-title { font-size: 15px; font-weight: 800; color: #18181b; margin-bottom: 10px; }
  .d2c-mv-desc { font-size: 13px; color: #52525b; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-mvip-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Minimal VIP Perks",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE CAPSULE REPLENISH CLUB"
    }
  ],
  "presets": [
    {
      "name": "Minimal VIP Perks"
    }
  ]
}
{% endschema %}
