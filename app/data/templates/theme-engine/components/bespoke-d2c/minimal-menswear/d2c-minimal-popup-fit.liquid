{% comment %}
  D2C Minimal Menswear Sizing Advisor Popup
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<div class="d2c-minimal-popup" id="d2c-mpop-{{ section.id }}" style="display: none;">
  <div class="d2c-mpop-overlay">
    <div class="d2c-mpop-card">
      <button class="d2c-mpop-close" onclick="document.getElementById('d2c-mpop-{{ section.id }}').style.display='none';">&times;</button>
      <span class="d2c-m-badge">🌿 AI FIT CALCULATOR</span>
      <h3 class="d2c-mpop-title">UNLOCK FLAT 15% OFF YOUR FIRST ORDER</h3>
      <p class="d2c-mpop-desc">Enter your email and mobile number to receive your personal welcome discount code.</p>

      <form class="d2c-mpop-form">
        <input type="email" placeholder="Your work email" class="d2c-mpop-input" required />
        <input type="tel" placeholder="WhatsApp number for instant coupon" class="d2c-mpop-input" required />
        <button type="submit" class="d2c-mpop-btn">GET 15% DISCOUNT CODE &rarr;</button>
      </form>
    </div>
  </div>
</div>

<style>
  .d2c-mpop-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mpop-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 44px 32px;
    max-width: 440px;
    width: 100%;
    text-align: center;
    position: relative;
    box-shadow: 0 20px 45px -10px rgba(0,0,0,0.2);
  }
  .d2c-mpop-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: #71717a;
    font-size: 22px;
    cursor: pointer;
  }
  .d2c-mpop-title { font-size: 20px; font-weight: 900; color: #18181b; margin: 8px 0 10px; text-transform: uppercase; }
  .d2c-mpop-desc { font-size: 14px; color: #52525b; margin-bottom: 22px; }
  .d2c-mpop-form { display: flex; flex-direction: column; gap: 10px; }
  .d2c-mpop-input {
    background: #f7f6f2;
    border: 1px solid rgba(0,0,0,0.1);
    padding: 12px 16px;
    border-radius: 6px;
    font-size: 14px;
    outline: none;
  }
  .d2c-mpop-input:focus { border-color: #2d4a3e; }
  .d2c-mpop-btn {
    background: #2d4a3e;
    color: #ffffff;
    border: none;
    padding: 14px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    text-transform: uppercase;
    margin-top: 6px;
  }
</style>

{% schema %}
{
  "name": "Minimal Fit Popup",
  "settings": [],
  "presets": [
    {
      "name": "Minimal Fit Popup"
    }
  ]
}
{% endschema %}
