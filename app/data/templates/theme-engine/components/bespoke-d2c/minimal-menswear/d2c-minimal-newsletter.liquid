{% comment %}
  D2C Minimal Menswear Newsletter
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-news" id="d2c-mnews-{{ section.id }}">
  <div class="d2c-mnews-container">
    <div class="d2c-mnews-card">
      <span class="d2c-m-badge">THE WEEKLY DISPATCH</span>
      <h2 class="d2c-mnews-title">{{ section.settings.title | default: "RECEIVE NEW COLOR DROP ALERTS" }}</h2>
      <p class="d2c-mnews-desc">Join 60,000+ men getting early access to seasonal colorways and capsule styling guides.</p>

      <form class="d2c-mnews-form">
        <input type="email" placeholder="Enter your work email" class="d2c-mnews-input" required />
        <button type="submit" class="d2c-mnews-btn">JOIN &rarr;</button>
      </form>
      <div class="d2c-mnews-privacy">🔒 No spam ever. Unsubscribe with 1-click anytime.</div>
    </div>
  </div>
</section>

<style>
  #d2c-mnews-{{ section.id }} {
    background: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mnews-container { max-width: 860px; margin: 0 auto; }
  .d2c-mnews-card {
    background: #f7f6f2;
    border-radius: 12px;
    padding: 48px 36px;
    text-align: center;
    border: 1px solid rgba(0,0,0,0.06);
  }
  .d2c-mnews-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #18181b; margin: 10px 0 12px; text-transform: uppercase; }
  .d2c-mnews-desc { font-size: 15px; color: #52525b; margin-bottom: 28px; }
  .d2c-mnews-form { display: flex; gap: 10px; max-width: 480px; margin: 0 auto 14px; }
  .d2c-mnews-input {
    flex: 1;
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.12);
    padding: 14px 18px;
    border-radius: 6px;
    font-size: 14px;
    outline: none;
  }
  .d2c-mnews-input:focus { border-color: #2d4a3e; }
  .d2c-mnews-btn {
    background: #2d4a3e;
    color: #ffffff;
    border: none;
    padding: 14px 28px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
  }
  .d2c-mnews-privacy { font-size: 12px; color: #a1a1aa; }

  @media (max-width: 600px) {
    .d2c-mnews-form { flex-direction: column; }
    .d2c-mnews-card { padding: 32px 20px; }
  }
</style>

{% schema %}
{
  "name": "Minimal Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "RECEIVE NEW COLOR DROP ALERTS"
    }
  ],
  "presets": [
    {
      "name": "Minimal Newsletter"
    }
  ]
}
{% endschema %}
