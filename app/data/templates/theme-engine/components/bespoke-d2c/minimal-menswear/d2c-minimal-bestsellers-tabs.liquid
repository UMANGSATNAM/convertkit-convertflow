{% comment %}
  D2C Minimal Menswear Bestsellers with Quick Add
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-bestsellers" id="d2c-mbest-{{ section.id }}">
  <div class="d2c-mbest-container">
    <div class="d2c-msec-header">
      <span class="d2c-m-badge">COMMUNITY STAPLES</span>
      <h2 class="d2c-m-title">{{ section.settings.title | default: "CORE CAPSULE ESSENTIALS" }}</h2>
    </div>

    <div class="d2c-mprod-grid">
      <!-- Item 1 -->
      <div class="d2c-mprod-card">
        <div class="d2c-mprod-thumb">
          <span class="d2c-mprod-pill">4-WAY STRETCH</span>
          <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=600&q=80" alt="Tech Stretch Oxford Shirt" />
        </div>
        <div class="d2c-mprod-body">
          <span class="d2c-mprod-spec">SUPIMA + LYCRA</span>
          <h3 class="d2c-mprod-title">Tech Stretch Oxford Shirt</h3>
          <div class="d2c-mprod-price">₹1,999 <span class="d2c-mprod-orig">₹2,999</span></div>
          <div class="d2c-mprod-swatches">
            <span class="d2c-swatch active" style="background: #2d4a3e;"></span>
            <span class="d2c-swatch" style="background: #18181b;"></span>
            <span class="d2c-swatch" style="background: #ffffff; border: 1px solid #ccc;"></span>
            <span class="d2c-swatch" style="background: #3b82f6;"></span>
          </div>
          <button class="d2c-matc-btn">+ ADD TO BAG</button>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="d2c-mprod-card">
        <div class="d2c-mprod-thumb">
          <span class="d2c-mprod-pill">WRINKLE FREE</span>
          <img src="https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?w=600&q=80" alt="All-Day Flex Chinos" />
        </div>
        <div class="d2c-mprod-body">
          <span class="d2c-mprod-spec">ITALIAN TWILL</span>
          <h3 class="d2c-mprod-title">All-Day Flex Chinos</h3>
          <div class="d2c-mprod-price">₹2,499 <span class="d2c-mprod-orig">₹3,499</span></div>
          <div class="d2c-mprod-swatches">
            <span class="d2c-swatch active" style="background: #d4a373;"></span>
            <span class="d2c-swatch" style="background: #18181b;"></span>
            <span class="d2c-swatch" style="background: #4b5563;"></span>
          </div>
          <button class="d2c-matc-btn">+ ADD TO BAG</button>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="d2c-mprod-card">
        <div class="d2c-mprod-thumb">
          <span class="d2c-mprod-pill">HEAVYWEIGHT</span>
          <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=600&q=80" alt="Supima Heavy Crew Tee" />
        </div>
        <div class="d2c-mprod-body">
          <span class="d2c-mprod-spec">240 GSM COMBED</span>
          <h3 class="d2c-mprod-title">Supima Heavy Crew Tee</h3>
          <div class="d2c-mprod-price">₹999 <span class="d2c-mprod-orig">₹1,499</span></div>
          <div class="d2c-mprod-swatches">
            <span class="d2c-swatch active" style="background: #18181b;"></span>
            <span class="d2c-swatch" style="background: #ffffff; border: 1px solid #ccc;"></span>
            <span class="d2c-swatch" style="background: #2d4a3e;"></span>
          </div>
          <button class="d2c-matc-btn">+ ADD TO BAG</button>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="d2c-mprod-card">
        <div class="d2c-mprod-thumb">
          <span class="d2c-mprod-pill">100% PURE</span>
          <img src="https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=600&q=80" alt="Pure French Linen Shirt" />
        </div>
        <div class="d2c-mprod-body">
          <span class="d2c-mprod-spec">NORMANDY FLAX</span>
          <h3 class="d2c-mprod-title">Pure French Linen Shirt</h3>
          <div class="d2c-mprod-price">₹2,899 <span class="d2c-mprod-orig">₹3,999</span></div>
          <div class="d2c-mprod-swatches">
            <span class="d2c-swatch active" style="background: #fef08a;"></span>
            <span class="d2c-swatch" style="background: #ffffff; border: 1px solid #ccc;"></span>
            <span class="d2c-swatch" style="background: #bae6fd;"></span>
          </div>
          <button class="d2c-matc-btn">+ ADD TO BAG</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-mbest-{{ section.id }} {
    background: #f7f6f2;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mbest-container { max-width: 1320px; margin: 0 auto; }
  .d2c-mprod-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .d2c-mprod-card {
    background: #ffffff;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .d2c-mprod-thumb { position: relative; aspect-ratio: 1; overflow: hidden; background: #e5e5e5; }
  .d2c-mprod-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-mprod-pill {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #18181b;
    color: #ffffff;
    font-size: 9px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }
  .d2c-mprod-body { padding: 18px; display: flex; flex-direction: column; flex-grow: 1; justify-content: space-between; }
  .d2c-mprod-spec { font-size: 10px; font-weight: 800; color: #2d4a3e; letter-spacing: 1px; margin-bottom: 4px; }
  .d2c-mprod-title { font-size: 14px; font-weight: 800; color: #18181b; margin-bottom: 8px; }
  .d2c-mprod-price { font-size: 15px; font-weight: 900; color: #18181b; margin-bottom: 12px; }
  .d2c-mprod-orig { font-size: 12px; color: #a1a1aa; text-decoration: line-through; margin-left: 6px; }
  .d2c-mprod-swatches { display: flex; gap: 6px; margin-bottom: 14px; }
  .d2c-swatch { width: 14px; height: 14px; border-radius: 50%; display: inline-block; cursor: pointer; }
  .d2c-swatch.active { outline: 2px solid #18181b; outline-offset: 1px; }
  .d2c-matc-btn {
    width: 100%;
    background: #18181b;
    color: #ffffff;
    border: none;
    padding: 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
  }
  .d2c-matc-btn:hover { background: #2d4a3e; }

  @media (max-width: 1024px) { .d2c-mprod-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-mprod-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } .d2c-mprod-body { padding: 12px; } }
</style>

{% schema %}
{
  "name": "Minimal Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "CORE CAPSULE ESSENTIALS"
    }
  ],
  "presets": [
    {
      "name": "Minimal Bestsellers"
    }
  ]
}
{% endschema %}
