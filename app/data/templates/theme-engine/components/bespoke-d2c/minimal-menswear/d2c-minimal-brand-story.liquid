{% comment %}
  D2C Minimal Menswear Brand Story
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-story" id="d2c-mstory-{{ section.id }}">
  <div class="d2c-mstory-container">
    <div class="d2c-mstory-grid">
      <div class="d2c-mstory-content">
        <span class="d2c-m-badge">OUR MANIFESTO</span>
        <h2 class="d2c-mstory-title">{{ section.settings.title | default: "WHY WE RE-ENGINEERED MEN'S ESSENTIALS" }}</h2>
        <p class="d2c-mstory-para">
          Traditional men's clothing forced an impossible compromise: stiff, restrictive formalwear for the office or shapeless loungewear for comfort.
        </p>
        <p class="d2c-mstory-para">
          We rebuilt menswear from the fiber level up. By combining extra-long staple Supima cotton with advanced 4-way Lycra elasticity, we created apparel that moves freely with you from the morning commute to late-night dinners.
        </p>
        <div class="d2c-mstory-stats">
          <div><span class="d2c-mst-num">500,000+</span><span class="d2c-mst-lbl">Items Delivered</span></div>
          <div><span class="d2c-mst-num">98.4%</span><span class="d2c-mst-lbl">Retention Rate</span></div>
          <div><span class="d2c-mst-num">0%</span><span class="d2c-mst-lbl">Synthetic Toxins</span></div>
        </div>
      </div>

      <div class="d2c-mstory-media">
        <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=800&q=80" alt="Fabric Science" />
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-mstory-{{ section.id }} {
    background: #ffffff;
    padding: 80px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mstory-container { max-width: 1320px; margin: 0 auto; }
  .d2c-mstory-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }
  .d2c-mstory-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 900; color: #18181b; line-height: 1.15; margin: 10px 0 20px; text-transform: uppercase; }
  .d2c-mstory-para { font-size: 15px; color: #52525b; line-height: 1.7; margin-bottom: 18px; }
  .d2c-mstory-stats {
    display: flex;
    gap: 36px;
    border-top: 1px solid rgba(0,0,0,0.08);
    padding-top: 24px;
    margin-top: 28px;
  }
  .d2c-mst-num { font-size: 24px; font-weight: 900; color: #18181b; display: block; }
  .d2c-mst-lbl { font-size: 11px; color: #71717a; font-weight: 700; text-transform: uppercase; }
  .d2c-mstory-media img { width: 100%; height: 440px; object-fit: cover; border-radius: 10px; }

  @media (max-width: 900px) {
    .d2c-mstory-grid { grid-template-columns: 1fr; }
    .d2c-mstory-media img { height: 320px; }
  }
</style>

{% schema %}
{
  "name": "Minimal Brand Story",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "WHY WE RE-ENGINEERED MEN'S ESSENTIALS"
    }
  ],
  "presets": [
    {
      "name": "Minimal Brand Story"
    }
  ]
}
{% endschema %}
