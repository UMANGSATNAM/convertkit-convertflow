{% comment %}
  D2C Minimal Menswear Ticker Ribbon
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<div class="d2c-minimal-ticker" id="d2c-mtick-{{ section.id }}">
  <div class="d2c-mtick-track">
    <div class="d2c-mtick-content">
      <span class="d2c-mtick-item">🌿 100% GOTS ORGANIC CERTIFIED</span>
      <span class="d2c-mtick-sep">•</span>
      <span class="d2c-mtick-item">THERMO-REGULATING SUPIMA COTTON</span>
      <span class="d2c-mtick-sep">•</span>
      <span class="d2c-mtick-item">30-DAY RISK-FREE WEAR TEST</span>
      <span class="d2c-mtick-sep">•</span>
      <span class="d2c-mtick-item">FREE CASH ON DELIVERY ACROSS INDIA</span>
      <span class="d2c-mtick-sep">•</span>
      <span class="d2c-mtick-item">🌿 100% GOTS ORGANIC CERTIFIED</span>
      <span class="d2c-mtick-sep">•</span>
      <span class="d2c-mtick-item">THERMO-REGULATING SUPIMA COTTON</span>
      <span class="d2c-mtick-sep">•</span>
      <span class="d2c-mtick-item">30-DAY RISK-FREE WEAR TEST</span>
      <span class="d2c-mtick-sep">•</span>
      <span class="d2c-mtick-item">FREE CASH ON DELIVERY ACROSS INDIA</span>
    </div>
  </div>
</div>

<style>
  #d2c-mtick-{{ section.id }} {
    background: #ffffff;
    border-top: 1px solid rgba(0,0,0,0.08);
    border-bottom: 1px solid rgba(0,0,0,0.08);
    color: #18181b;
    overflow: hidden;
    white-space: nowrap;
    padding: 14px 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .d2c-mtick-track { display: flex; overflow: hidden; }
  .d2c-mtick-content {
    display: flex;
    align-items: center;
    gap: 32px;
    animation: d2c-mtick-scroll 24s linear infinite;
  }
  .d2c-mtick-sep { color: #2d4a3e; font-size: 18px; }
  @keyframes d2c-mtick-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
</style>

{% schema %}
{
  "name": "Minimal Ticker",
  "settings": [],
  "presets": [
    {
      "name": "Minimal Ticker"
    }
  ]
}
{% endschema %}
