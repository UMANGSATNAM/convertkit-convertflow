{% comment %}
  D2C Minimal Menswear Capsule Lookbook
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-lookbook" id="d2c-mlb-{{ section.id }}">
  <div class="d2c-mlb-container">
    <div class="d2c-msec-header">
      <span class="d2c-m-badge">THE CAPSULE GRID</span>
      <h2 class="d2c-m-title">{{ section.settings.title | default: "7 PIECES • 30+ UNIQUE OUTFITS" }}</h2>
    </div>

    <div class="d2c-mlb-grid">
      <div class="d2c-mlb-card large">
        <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=800&q=80" alt="Workwear Capsule" />
        <div class="d2c-mlb-info">
          <span class="d2c-mlb-tag">WORKWEAR CAPSULE</span>
          <h3 class="d2c-mlb-name">OXFORD + FLEX CHINO</h3>
          <span class="d2c-mlb-link">SHOP THE LOOK &rarr;</span>
        </div>
      </div>

      <div class="d2c-mlb-card">
        <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=600&q=80" alt="Casual Friday" />
        <div class="d2c-mlb-info">
          <span class="d2c-mlb-tag">CASUAL FRIDAY</span>
          <h3 class="d2c-mlb-name">HEAVY TEE + CHINOS</h3>
          <span class="d2c-mlb-link">SHOP &rarr;</span>
        </div>
      </div>

      <div class="d2c-mlb-card">
        <img src="https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=600&q=80" alt="Weekend Resort" />
        <div class="d2c-mlb-info">
          <span class="d2c-mlb-tag">WEEKEND RESORT</span>
          <h3 class="d2c-mlb-name">FRENCH LINEN SHIRT</h3>
          <span class="d2c-mlb-link">SHOP &rarr;</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-mlb-{{ section.id }} {
    background: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mlb-container { max-width: 1320px; margin: 0 auto; }
  .d2c-mlb-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 24px;
  }
  .d2c-mlb-card {
    position: relative;
    height: 480px;
    border-radius: 12px;
    overflow: hidden;
    background: #f7f6f2;
  }
  .d2c-mlb-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .d2c-mlb-card:hover img { transform: scale(1.04); }
  .d2c-mlb-info {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(24,24,27,0.85) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px 24px;
    color: #ffffff;
  }
  .d2c-mlb-tag { font-size: 10px; font-weight: 800; color: #10b981; letter-spacing: 1.5px; margin-bottom: 4px; }
  .d2c-mlb-name { font-size: 18px; font-weight: 800; margin-bottom: 6px; }
  .d2c-mlb-link { font-size: 12px; font-weight: 700; color: #d4d4d8; }

  @media (max-width: 900px) {
    .d2c-mlb-grid { grid-template-columns: 1fr; }
    .d2c-mlb-card { height: 360px; }
  }
</style>

{% schema %}
{
  "name": "Minimal Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "7 PIECES • 30+ UNIQUE OUTFITS"
    }
  ],
  "presets": [
    {
      "name": "Minimal Lookbook"
    }
  ]
}
{% endschema %}
