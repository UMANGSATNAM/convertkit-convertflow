{% comment %}
  D2C Minimal Menswear Spotlight
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-spotlight" id="d2c-mspot-{{ section.id }}">
  <div class="d2c-mspot-container">
    <div class="d2c-mspot-card">
      <div class="d2c-mspot-media">
        <img src="https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?w=800&q=85" alt="All-Day Flex Chinos" />
      </div>

      <div class="d2c-mspot-content">
        <span class="d2c-m-badge">THE WORKHORSE TROUSER</span>
        <h2 class="d2c-mspot-title">{{ section.settings.title | default: "THE ALL-DAY 4-WAY FLEX CHINO" }}</h2>
        <p class="d2c-mspot-desc">
          Structured like tailored Italian trousers, feels like your favorite sweatpants. Engineered with an invisible stretch waistband and stain-repellent nano-coating.
        </p>

        <div class="d2c-mspot-matrix">
          <div class="d2c-mm-row"><span>FABRIC:</span> <strong>96% Cotton / 4% Spandex Twill</strong></div>
          <div class="d2c-mm-row"><span>WAIST:</span> <strong>Auto-Flex Hidden Comfort Band</strong></div>
          <div class="d2c-mm-row"><span>POCKETS:</span> <strong>Hidden Zipper Passport Pocket</strong></div>
        </div>

        <div class="d2c-mspot-price-row">
          <span class="d2c-mspot-price">₹2,499</span>
          <span class="d2c-mspot-orig">₹3,499</span>
          <span class="d2c-mspot-save">SAVE ₹1,000</span>
        </div>

        <button class="d2c-mspot-btn">⚡ BUY WITH 1-CLICK COD &rarr;</button>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-mspot-{{ section.id }} {
    background: #f7f6f2;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mspot-container { max-width: 1320px; margin: 0 auto; }
  .d2c-mspot-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    align-items: center;
    border: 1px solid rgba(0,0,0,0.06);
  }
  .d2c-mspot-media img { width: 100%; height: 480px; object-fit: cover; border-radius: 8px; }
  .d2c-mspot-title { font-size: clamp(26px, 3vw, 38px); font-weight: 900; color: #18181b; line-height: 1.15; margin: 10px 0 16px; text-transform: uppercase; }
  .d2c-mspot-desc { font-size: 15px; color: #52525b; line-height: 1.6; margin-bottom: 24px; }
  .d2c-mspot-matrix {
    background: #f7f6f2;
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .d2c-mm-row { display: flex; justify-content: space-between; font-size: 12px; color: #71717a; }
  .d2c-mm-row strong { color: #18181b; }
  .d2c-mspot-price-row { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .d2c-mspot-price { font-size: 24px; font-weight: 900; color: #18181b; }
  .d2c-mspot-orig { font-size: 14px; color: #a1a1aa; text-decoration: line-through; }
  .d2c-mspot-save { background: #dcfce7; color: #15803d; font-size: 11px; font-weight: 800; padding: 4px 8px; border-radius: 4px; }
  .d2c-mspot-btn {
    width: 100%;
    background: #2d4a3e;
    color: #ffffff;
    border: none;
    padding: 16px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .d2c-mspot-card { grid-template-columns: 1fr; padding: 24px; }
    .d2c-mspot-media img { height: 320px; }
  }
</style>

{% schema %}
{
  "name": "Minimal Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE ALL-DAY 4-WAY FLEX CHINO"
    }
  ],
  "presets": [
    {
      "name": "Minimal Spotlight"
    }
  ]
}
{% endschema %}
