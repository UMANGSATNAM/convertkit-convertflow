{% comment %}
  D2C Minimal Menswear Sleek Header
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<header class="d2c-minimal-header" id="d2c-mhead-{{ section.id }}">
  <div class="d2c-mhead-container">
    <a href="/" class="d2c-mhead-logo">
      {{ section.settings.brand_name | default: "SNITCH & NORDIC" }}
    </a>

    <nav class="d2c-mhead-nav">
      <a href="/collections/stretch-shirts" class="d2c-m-link active">TECH SHIRTS</a>
      <a href="/collections/chinos" class="d2c-m-link">4-WAY CHINOS</a>
      <a href="/collections/tees" class="d2c-m-link">SUPIMA TEES</a>
      <a href="/collections/linen" class="d2c-m-link">EUROPEAN LINEN</a>
      <a href="/pages/capsule" class="d2c-m-link pill">CAPSULE BUILDER</a>
    </nav>

    <div class="d2c-mhead-actions">
      <a href="/account" class="d2c-mhead-btn">LOGIN</a>
      <a href="/cart" class="d2c-mhead-cart">BAG ({{ cart.item_count | default: 0 }})</a>
    </div>
  </div>
</header>

<style>
  #d2c-mhead-{{ section.id }} {
    background: #ffffff;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    padding: 18px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  .d2c-mhead-container {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .d2c-mhead-logo {
    font-size: 20px;
    font-weight: 800;
    color: #18181b;
    letter-spacing: -0.5px;
    text-decoration: none;
    text-transform: uppercase;
  }
  .d2c-mhead-nav { display: flex; gap: 28px; align-items: center; }
  .d2c-m-link {
    color: #52525b;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.5px;
    transition: color 0.15s ease;
  }
  .d2c-m-link:hover, .d2c-m-link.active { color: #18181b; }
  .d2c-m-link.pill {
    background: #2d4a3e;
    color: #ffffff;
    padding: 6px 14px;
    border-radius: 99px;
  }
  .d2c-mhead-actions { display: flex; gap: 18px; align-items: center; }
  .d2c-mhead-btn { color: #52525b; font-size: 13px; font-weight: 700; text-decoration: none; }
  .d2c-mhead-cart {
    background: #18181b;
    color: #ffffff;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .d2c-mhead-nav { display: none; }
    #d2c-mhead-{{ section.id }} { padding: 14px 18px; }
  }
</style>

{% schema %}
{
  "name": "Minimal Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "SNITCH & NORDIC"
    }
  ],
  "presets": [
    {
      "name": "Minimal Header"
    }
  ]
}
{% endschema %}
