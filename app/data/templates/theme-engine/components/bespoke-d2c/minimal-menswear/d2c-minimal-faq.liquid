{% comment %}
  D2C Minimal Menswear Sizing & Care FAQ
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-faq" id="d2c-mfaq-{{ section.id }}">
  <div class="d2c-mfaq-container">
    <div class="d2c-msec-header">
      <span class="d2c-m-badge">COMMON QUESTIONS</span>
      <h2 class="d2c-m-title">{{ section.settings.title | default: "FIT, FABRIC & DELIVERY ANSWERS" }}</h2>
    </div>

    <div class="d2c-mfaq-list">
      <details class="d2c-mfaq-item" open>
        <summary class="d2c-mfaq-q">
          <span>How does the 4-way stretch fabric hold up in washing machines?</span>
          <span class="d2c-mfaq-icon">+</span>
        </summary>
        <div class="d2c-mfaq-a">
          Our fabrics are pre-shrunk with zero shrinkage guarantee. Simply machine wash in cold water on gentle cycle and hang dry. No harsh detergents or hot tumble dry needed.
        </div>
      </details>

      <details class="d2c-mfaq-item">
        <summary class="d2c-mfaq-q">
          <span>What if the size or length isn't an exact fit?</span>
          <span class="d2c-mfaq-icon">+</span>
        </summary>
        <div class="d2c-mfaq-a">
          We offer 100% free doorstep exchanges within 15 days across all 24,000+ Indian pincodes. Our courier partner picks up the exchange and hands over your new size simultaneously.
        </div>
      </details>

      <details class="d2c-mfaq-item">
        <summary class="d2c-mfaq-q">
          <span>Is Cash on Delivery (COD) available for all pincodes?</span>
          <span class="d2c-mfaq-icon">+</span>
        </summary>
        <div class="d2c-mfaq-a">
          Yes. Free Cash on Delivery is available for all orders across India without any extra COD convenience fees. You can pay via Cash or UPI QR at your doorstep.
        </div>
      </details>

      <details class="d2c-mfaq-item">
        <summary class="d2c-mfaq-q">
          <span>Do your Oxford shirts require ironing?</span>
          <span class="d2c-mfaq-icon">+</span>
        </summary>
        <div class="d2c-mfaq-a">
          Our Tech Oxford Shirts are treated with an eco-certified wrinkle-release finish. Simply hang them after a cold wash, and natural gravity removes creases without ironing.
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  #d2c-mfaq-{{ section.id }} {
    background: #f7f6f2;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mfaq-container { max-width: 860px; margin: 0 auto; }
  .d2c-mfaq-list { display: flex; flex-direction: column; gap: 12px; margin-top: 36px; }
  .d2c-mfaq-item {
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 8px;
    overflow: hidden;
  }
  .d2c-mfaq-q {
    padding: 20px 24px;
    font-size: 15px;
    font-weight: 800;
    color: #18181b;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }
  .d2c-mfaq-q::-webkit-details-marker { display: none; }
  .d2c-mfaq-icon { font-size: 18px; font-weight: 700; color: #2d4a3e; }
  details[open] .d2c-mfaq-icon { transform: rotate(45deg); display: inline-block; }
  .d2c-mfaq-a {
    padding: 0 24px 20px;
    font-size: 14px;
    color: #52525b;
    line-height: 1.6;
  }
</style>

{% schema %}
{
  "name": "Minimal FAQ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FIT, FABRIC & DELIVERY ANSWERS"
    }
  ],
  "presets": [
    {
      "name": "Minimal FAQ"
    }
  ]
}
{% endschema %}
