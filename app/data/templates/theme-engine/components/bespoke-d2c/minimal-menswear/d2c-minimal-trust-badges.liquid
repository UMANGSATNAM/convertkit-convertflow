{% comment %}
  D2C Minimal Menswear Trust Badges
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-trust" id="d2c-mtrust-{{ section.id }}">
  <div class="d2c-mtrust-container">
    <div class="d2c-mtrust-grid">
      <div class="d2c-mtrust-item">
        <div class="d2c-mtrust-icon">🚚</div>
        <h4 class="d2c-mtrust-title">FREE CASH ON DELIVERY</h4>
        <p class="d2c-mtrust-desc">Pay at your doorstep with cash, UPI, or card across 24,000+ Indian pincodes.</p>
      </div>

      <div class="d2c-mtrust-item">
        <div class="d2c-mtrust-icon">🔄</div>
        <h4 class="d2c-mtrust-title">30-DAY RISK-FREE TRIAL</h4>
        <p class="d2c-mtrust-desc">Wear it, wash it. If you don't love the comfort, return it for a 100% full refund.</p>
      </div>

      <div class="d2c-mtrust-item">
        <div class="d2c-mtrust-icon">🌿</div>
        <h4 class="d2c-mtrust-title">GOTS ORGANIC CERTIFIED</h4>
        <p class="d2c-mtrust-desc">Sustainably harvested long-staple cotton dyed with zero toxic chemicals.</p>
      </div>

      <div class="d2c-mtrust-item">
        <div class="d2c-mtrust-icon">⚡</div>
        <h4 class="d2c-mtrust-title">EXPRESS 48-HR DISPATCH</h4>
        <p class="d2c-mtrust-desc">All warehouse orders are packed within 2 hours and shipped via air express.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-mtrust-{{ section.id }} {
    background: #f7f6f2;
    padding: 50px 32px;
    border-top: 1px solid rgba(0,0,0,0.06);
    border-bottom: 1px solid rgba(0,0,0,0.06);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mtrust-container { max-width: 1320px; margin: 0 auto; }
  .d2c-mtrust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }
  .d2c-mtrust-item {
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 8px;
    padding: 24px 18px;
  }
  .d2c-mtrust-icon { font-size: 24px; margin-bottom: 10px; }
  .d2c-mtrust-title { font-size: 12px; font-weight: 800; color: #18181b; letter-spacing: 0.5px; margin-bottom: 6px; }
  .d2c-mtrust-desc { font-size: 12px; color: #71717a; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-mtrust-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-mtrust-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Minimal Trust Badges",
  "settings": [],
  "presets": [
    {
      "name": "Minimal Trust Badges"
    }
  ]
}
{% endschema %}
