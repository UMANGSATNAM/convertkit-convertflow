{% comment %}
  D2C Minimal Menswear Press Strip
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-press" id="d2c-mpress-{{ section.id }}">
  <div class="d2c-mpress-container">
    <span class="d2c-mpress-label">AS FEATURED IN</span>
    <div class="d2c-mpress-logos">
      <span class="d2c-mplogo">FORBES INDIA</span>
      <span class="d2c-mplogo">GQ DAILY</span>
      <span class="d2c-mplogo">MENSXP</span>
      <span class="d2c-mplogo">MINT LOUNGE</span>
      <span class="d2c-mplogo">ECONOMIC TIMES</span>
    </div>
  </div>
</section>

<style>
  #d2c-mpress-{{ section.id }} {
    background: #ffffff;
    padding: 30px 32px;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mpress-container {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .d2c-mpress-label { font-size: 11px; font-weight: 800; color: #a1a1aa; letter-spacing: 1px; }
  .d2c-mpress-logos { display: flex; gap: 36px; align-items: center; flex-wrap: wrap; }
  .d2c-mplogo { font-size: 14px; font-weight: 800; color: #52525b; letter-spacing: 0.5px; }

  @media (max-width: 768px) {
    .d2c-mpress-container { justify-content: center; text-align: center; }
    .d2c-mpress-logos { justify-content: center; gap: 20px; }
  }
</style>

{% schema %}
{
  "name": "Minimal Press Strip",
  "settings": [],
  "presets": [
    {
      "name": "Minimal Press Strip"
    }
  ]
}
{% endschema %}
