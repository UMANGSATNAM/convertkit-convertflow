{% comment %}
  D2C Minimal Menswear Instagram Community Wall
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-ugc" id="d2c-mugc-{{ section.id }}">
  <div class="d2c-mugc-container">
    <div class="d2c-msec-header">
      <span class="d2c-m-badge">#MINIMALEVERYDAY</span>
      <h2 class="d2c-m-title">{{ section.settings.title | default: "WORN BY 85,000+ MODERN PROFESSIONALS" }}</h2>
    </div>

    <div class="d2c-mugc-grid">
      <div class="d2c-mugc-tile"><img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=600&q=80" alt="Community 1" /><span>@rahul_sharma · Bangalore</span></div>
      <div class="d2c-mugc-tile"><img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=600&q=80" alt="Community 2" /><span>@karan.mehta · Mumbai</span></div>
      <div class="d2c-mugc-tile"><img src="https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?w=600&q=80" alt="Community 3" /><span>@tanya_styled · Delhi</span></div>
      <div class="d2c-mugc-tile"><img src="https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=600&q=80" alt="Community 4" /><span>@arjun.creatives · Goa</span></div>
    </div>
  </div>
</section>

<style>
  #d2c-mugc-{{ section.id }} {
    background: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mugc-container { max-width: 1320px; margin: 0 auto; }
  .d2c-mugc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .d2c-mugc-tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: 10px;
    overflow: hidden;
    background: #f7f6f2;
  }
  .d2c-mugc-tile img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-mugc-tile span {
    position: absolute;
    bottom: 10px;
    left: 10px;
    right: 10px;
    background: rgba(24,24,27,0.8);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 6px;
    text-align: center;
    border-radius: 4px;
  }

  @media (max-width: 900px) { .d2c-mugc-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

{% schema %}
{
  "name": "Minimal Community",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "WORN BY 85,000+ MODERN PROFESSIONALS"
    }
  ],
  "presets": [
    {
      "name": "Minimal Community"
    }
  ]
}
{% endschema %}
