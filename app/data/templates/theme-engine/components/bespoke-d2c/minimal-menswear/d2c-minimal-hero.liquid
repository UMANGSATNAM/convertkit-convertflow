{% comment %}
  D2C Minimal Menswear Split Hero
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-hero" id="d2c-mhero-{{ section.id }}">
  <div class="d2c-mhero-container">
    <div class="d2c-mhero-grid">
      <div class="d2c-mhero-content">
        <span class="d2c-mhero-badge">🌿 4-WAY STRETCH TECH-COTTON</span>
        <h1 class="d2c-mhero-title">{{ section.settings.heading | default: "ENGINEERED FOR UNRESTRICTED MOTION" }}</h1>
        <p class="d2c-mhero-desc">
          Crafted from thermo-regulating long-staple Supima cotton infused with 4% Lycra elastane. Breathable, wrinkle-resistant, and tailored for effortless 18-hour comfort.
        </p>

        <div class="d2c-mhero-cta-row">
          <a href="/collections/all" class="d2c-mhero-btn-primary">EXPLORE CAPSULE '26 &rarr;</a>
          <a href="/pages/capsule" class="d2c-mhero-btn-secondary">BUILD CAPSULE WARDROBE</a>
        </div>

        <div class="d2c-mhero-features">
          <div class="d2c-mf-item"><span>✓</span> 360° Flex Elasticity</div>
          <div class="d2c-mf-item"><span>✓</span> Anti-Odor Silver Ions</div>
          <div class="d2c-mf-item"><span>✓</span> Zero-Iron Wrinkle Free</div>
        </div>
      </div>

      <div class="d2c-mhero-media">
        <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=900&q=85" alt="Minimal Menswear" />
        <div class="d2c-mhero-card">
          <div class="d2c-mc-tag">EVERYDAY BESTSELLER</div>
          <div class="d2c-mc-title">Supima Tech Oxford Shirt</div>
          <div class="d2c-mc-price">₹1,999 <span class="d2c-mc-save">4.9 ★ (12,400+ Reviews)</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-mhero-{{ section.id }} {
    background: #f7f6f2;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mhero-container { max-width: 1320px; margin: 0 auto; }
  .d2c-mhero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: center;
  }
  .d2c-mhero-badge {
    font-size: 11px;
    font-weight: 800;
    color: #2d4a3e;
    letter-spacing: 1px;
    margin-bottom: 16px;
    display: inline-block;
  }
  .d2c-mhero-title {
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 900;
    color: #18181b;
    line-height: 1.1;
    letter-spacing: -1px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }
  .d2c-mhero-desc {
    font-size: 16px;
    color: #52525b;
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 520px;
  }
  .d2c-mhero-cta-row {
    display: flex;
    gap: 16px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }
  .d2c-mhero-btn-primary {
    background: #2d4a3e;
    color: #ffffff;
    padding: 16px 32px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-decoration: none;
    text-transform: uppercase;
  }
  .d2c-mhero-btn-secondary {
    background: transparent;
    border: 1px solid #18181b;
    color: #18181b;
    padding: 16px 28px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }
  .d2c-mhero-features {
    display: flex;
    gap: 24px;
    font-size: 13px;
    font-weight: 700;
    color: #2d4a3e;
  }
  .d2c-mhero-media {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 20px 40px -10px rgba(0,0,0,0.08);
  }
  .d2c-mhero-media img { width: 100%; height: 500px; object-fit: cover; }
  .d2c-mhero-card {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(10px);
    padding: 18px 20px;
    border-radius: 8px;
    border: 1px solid rgba(0,0,0,0.06);
  }
  .d2c-mc-tag { font-size: 10px; font-weight: 800; color: #2d4a3e; letter-spacing: 1px; margin-bottom: 4px; }
  .d2c-mc-title { font-size: 15px; font-weight: 800; color: #18181b; margin-bottom: 4px; }
  .d2c-mc-price { font-size: 16px; font-weight: 900; color: #18181b; }
  .d2c-mc-save { font-size: 12px; color: #f59e0b; font-weight: 700; margin-left: 8px; }

  @media (max-width: 900px) {
    .d2c-mhero-grid { grid-template-columns: 1fr; }
    .d2c-mhero-media img { height: 380px; }
    #d2c-mhero-{{ section.id }} { padding: 40px 18px; }
  }
</style>

{% schema %}
{
  "name": "Minimal Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ENGINEERED FOR UNRESTRICTED MOTION"
    }
  ],
  "presets": [
    {
      "name": "Minimal Hero"
    }
  ]
}
{% endschema %}
