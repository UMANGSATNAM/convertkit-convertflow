{% comment %}
  D2C Minimal Menswear Fabric Tech Specs Matrix
  Theme: Snitch / Damensch Minimal Everyday Menswear
{% endcomment %}

<section class="d2c-minimal-tech" id="d2c-mtech-{{ section.id }}">
  <div class="d2c-mtech-container">
    <div class="d2c-msec-header">
      <span class="d2c-m-badge">THE TEXTILE SCIENCE</span>
      <h2 class="d2c-m-title">{{ section.settings.title | default: "ENGINEERED EVERYDAY PERFORMANCE" }}</h2>
    </div>

    <div class="d2c-mtech-grid">
      <div class="d2c-mtech-box">
        <div class="d2c-mt-icon">🌿</div>
        <h3 class="d2c-mt-title">SUPIMA COTTON</h3>
        <p class="d2c-mt-desc">Extra-long staple fibers offer 45% more tensile strength and 2x silkier touch than standard cotton.</p>
      </div>

      <div class="d2c-mtech-box">
        <div class="d2c-mt-icon">⚡</div>
        <h3 class="d2c-mt-title">4-WAY LYCRA STRETCH</h3>
        <p class="d2c-mt-desc">4% Lycra elastane blend provides full 360-degree flexibility without sagging or losing its tailored shape.</p>
      </div>

      <div class="d2c-mtech-box">
        <div class="d2c-mt-icon">🛡️</div>
        <h3 class="d2c-mt-title">ANTI-ODOR SILVER ION</h3>
        <p class="d2c-mt-desc">Natural silver-ion finish neutralizes odor-causing bacteria for up to 30 continuous wears between washes.</p>
      </div>

      <div class="d2c-mtech-box">
        <div class="d2c-mt-icon">💨</div>
        <h3 class="d2c-mt-title">THERMO-REGULATION</h3>
        <p class="d2c-mt-desc">Micro-porous weave naturally wicks moisture in summer humidity while retaining core warmth in winter ACs.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-mtech-{{ section.id }} {
    background: #f7f6f2;
    padding: 70px 32px;
    border-top: 1px solid rgba(0,0,0,0.06);
    border-bottom: 1px solid rgba(0,0,0,0.06);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-mtech-container { max-width: 1320px; margin: 0 auto; }
  .d2c-mtech-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-mtech-box {
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 10px;
    padding: 32px 24px;
    text-align: center;
  }
  .d2c-mt-icon { font-size: 28px; margin-bottom: 14px; }
  .d2c-mt-title { font-size: 14px; font-weight: 800; color: #18181b; letter-spacing: 0.5px; margin-bottom: 8px; }
  .d2c-mt-desc { font-size: 13px; color: #52525b; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-mtech-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-mtech-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Minimal Fabric Tech",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ENGINEERED EVERYDAY PERFORMANCE"
    }
  ],
  "presets": [
    {
      "name": "Minimal Fabric Tech"
    }
  ]
}
{% endschema %}
