{% comment %}
  D2C Streetwear Brand Story Manifesto
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-story" id="d2c-story-{{ section.id }}">
  <div class="d2c-story-container">
    <div class="d2c-story-grid">
      <div class="d2c-story-content">
        <span class="d2c-story-tag">THE MANIFESTO // EST. 2024</span>
        <h2 class="d2c-story-title">{{ section.settings.title | default: "BUILT FOR THE STREETS, NOT THE RUNWAY" }}</h2>
        <p class="d2c-story-text">
          We got tired of flimsy fast-fashion tees that shrink into dishcloths after one wash. We wanted heavy fabrics, drop shoulders, deep pockets, and zero corporate BS.
        </p>
        <p class="d2c-story-text">
          Every drop is engineered in small, limited batches of 300 units using 280 GSM French Terry and heavy combed cotton. Once a drop sells out, it’s archived into the vault forever.
        </p>
        <div class="d2c-story-pillars">
          <div class="d2c-pillar"><span class="d2c-p-dot"></span> NO FAST FASHION</div>
          <div class="d2c-pillar"><span class="d2c-p-dot"></span> LIMITED 300 UNIT DROPS</div>
          <div class="d2c-pillar"><span class="d2c-p-dot"></span> HEAVYWEIGHT 280 GSM ONLY</div>
        </div>
      </div>

      <div class="d2c-story-media">
        <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=800&q=80" alt="Streetwear Manifesto" />
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-story-{{ section.id }} {
    background: #09090b;
    padding: 70px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-story-container { max-width: 1320px; margin: 0 auto; }
  .d2c-story-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }
  .d2c-story-tag { font-size: 11px; font-weight: 900; color: #ff5500; letter-spacing: 1.5px; margin-bottom: 12px; display: block; }
  .d2c-story-title { font-size: clamp(28px, 3.5vw, 44px); font-weight: 900; color: #ffffff; line-height: 1.1; margin-bottom: 20px; letter-spacing: -0.5px; }
  .d2c-story-text { font-size: 15px; color: #a1a1aa; line-height: 1.7; margin-bottom: 16px; }
  .d2c-story-pillars { display: flex; flex-direction: column; gap: 10px; margin-top: 24px; }
  .d2c-pillar { font-size: 12px; font-weight: 900; color: #ffffff; display: flex; align-items: center; gap: 8px; letter-spacing: 1px; }
  .d2c-p-dot { width: 6px; height: 6px; background: #ff5500; border-radius: 50%; }
  .d2c-story-media {
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid #27272a;
  }
  .d2c-story-media img { width: 100%; height: 460px; object-fit: cover; }

  @media (max-width: 900px) {
    .d2c-story-grid { grid-template-columns: 1fr; gap: 36px; }
    .d2c-story-media img { height: 320px; }
  }
</style>

{% schema %}
{
  "name": "Streetwear Story",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "BUILT FOR THE STREETS, NOT THE RUNWAY"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Story"
    }
  ]
}
{% endschema %}
