{% comment %}
  D2C Streetwear Gamified Spin-to-Win Modal
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<div class="d2c-streetwear-popup" id="d2c-popup-{{ section.id }}" style="display: none;">
  <div class="d2c-popup-overlay">
    <div class="d2c-popup-card">
      <button class="d2c-popup-close" onclick="document.getElementById('d2c-popup-{{ section.id }}').style.display='none';">&times;</button>
      <div class="d2c-popup-tag">LUCKY STREET DROP</div>
      <h3 class="d2c-popup-title">SPIN TO UNLOCK UP TO 30% OFF</h3>
      <p class="d2c-popup-sub">Enter your email and test your luck for secret drop credits.</p>

      <div class="d2c-wheel-graphic">
        <div class="d2c-wheel-center">🎯</div>
      </div>

      <input type="email" placeholder="Enter email for spin credit" class="d2c-popup-input" />
      <button class="d2c-popup-btn">SPIN THE STREET WHEEL ⚡</button>
    </div>
  </div>
</div>

<style>
  .d2c-popup-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    backdrop-filter: blur(10px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-popup-card {
    background: #141418;
    border: 2px solid #ff5500;
    border-radius: 14px;
    padding: 40px 30px;
    max-width: 440px;
    width: 100%;
    text-align: center;
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(255, 85, 0, 0.4);
  }
  .d2c-popup-close {
    position: absolute;
    top: 14px;
    right: 14px;
    background: none;
    border: none;
    color: #71717a;
    font-size: 24px;
    cursor: pointer;
  }
  .d2c-popup-tag { font-size: 11px; font-weight: 900; color: #ff5500; letter-spacing: 1px; margin-bottom: 8px; }
  .d2c-popup-title { font-size: 22px; font-weight: 900; color: #ffffff; margin-bottom: 8px; line-height: 1.2; }
  .d2c-popup-sub { font-size: 13px; color: #a1a1aa; margin-bottom: 24px; }
  .d2c-wheel-graphic {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 4px dashed #ff5500;
    margin: 0 auto 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    animation: d2c-spin 10s linear infinite;
  }
  @keyframes d2c-spin { 100% { transform: rotate(360deg); } }
  .d2c-popup-input {
    width: 100%;
    background: #09090b;
    border: 2px solid #27272a;
    border-radius: 6px;
    padding: 14px;
    color: #ffffff;
    font-size: 14px;
    outline: none;
    margin-bottom: 12px;
    box-sizing: border-box;
  }
  .d2c-popup-btn {
    width: 100%;
    background: #ff5500;
    color: #ffffff;
    border: none;
    padding: 16px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 900;
    cursor: pointer;
  }
</style>

{% schema %}
{
  "name": "Streetwear Spin Popup",
  "settings": [],
  "presets": [
    {
      "name": "Streetwear Spin Popup"
    }
  ]
}
{% endschema %}
