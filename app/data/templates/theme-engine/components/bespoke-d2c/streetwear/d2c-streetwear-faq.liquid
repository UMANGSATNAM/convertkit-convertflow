{% comment %}
  D2C Streetwear FAQ Accordion
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-faq" id="d2c-faq-{{ section.id }}">
  <div class="d2c-faq-container">
    <div class="d2c-section-header">
      <span class="d2c-section-badge">NEED INTEL?</span>
      <h2 class="d2c-section-title">{{ section.settings.title | default: "FREQUENTLY ASKED QUESTIONS" }}</h2>
    </div>

    <div class="d2c-faq-list">
      <details class="d2c-faq-item" open>
        <summary class="d2c-faq-q">
          <span>How does the oversized sizing work?</span>
          <span class="d2c-faq-icon">+</span>
        </summary>
        <div class="d2c-faq-a">
          Our fits are intentionally engineered with a relaxed boxy cut and dropped shoulders. If you prefer a regular fit, order 1 size down. For the authentic oversized street drape, order your true size.
        </div>
      </details>

      <details class="d2c-faq-item">
        <summary class="d2c-faq-q">
          <span>Is Cash on Delivery (COD) available?</span>
          <span class="d2c-faq-icon">+</span>
        </summary>
        <div class="d2c-faq-a">
          Yes! COD is available across 19,000+ pincodes in India with zero hidden charges. You can pay via cash or UPI at the time of delivery.
        </div>
      </details>

      <details class="d2c-faq-item">
        <summary class="d2c-faq-q">
          <span>How do I wash my acid wash heavyweight hoodie?</span>
          <span class="d2c-faq-icon">+</span>
        </summary>
        <div class="d2c-faq-a">
          Machine wash cold inside-out with like colors. Tumble dry on low heat or hang dry in shade. Do not iron directly over high-density rubber prints.
        </div>
      </details>

      <details class="d2c-faq-item">
        <summary class="d2c-faq-q">
          <span>What is the 7-day exchange process?</span>
          <span class="d2c-faq-icon">+</span>
        </summary>
        <div class="d2c-faq-a">
          If the size doesn't fit you 100%, head to our self-serve Returns Portal. We arrange a doorstep pickup and dispatch your replacement size within 24 hours.
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  #d2c-faq-{{ section.id }} {
    background: #09090b;
    padding: 60px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-faq-container { max-width: 860px; margin: 0 auto; }
  .d2c-faq-list { display: flex; flex-direction: column; gap: 14px; margin-top: 36px; }
  .d2c-faq-item {
    background: #141418;
    border: 2px solid #27272a;
    border-radius: 8px;
    overflow: hidden;
  }
  .d2c-faq-q {
    padding: 20px 24px;
    font-size: 15px;
    font-weight: 800;
    color: #ffffff;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }
  .d2c-faq-q::-webkit-details-marker { display: none; }
  .d2c-faq-icon { color: #ff5500; font-size: 20px; font-weight: 900; }
  details[open] .d2c-faq-icon { transform: rotate(45deg); display: inline-block; }
  .d2c-faq-a {
    padding: 0 24px 20px;
    font-size: 14px;
    color: #a1a1aa;
    line-height: 1.6;
  }
</style>

{% schema %}
{
  "name": "Streetwear FAQ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    }
  ],
  "presets": [
    {
      "name": "Streetwear FAQ"
    }
  ]
}
{% endschema %}
