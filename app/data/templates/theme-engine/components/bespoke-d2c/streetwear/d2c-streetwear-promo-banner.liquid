{% comment %}
  D2C Streetwear Glitch Flash Promo Banner
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-promo" id="d2c-promo-{{ section.id }}">
  <div class="d2c-promo-container">
    <div class="d2c-promo-box">
      <div class="d2c-promo-tag">LIMITED VAULT ACCESS</div>
      <h2 class="d2c-promo-heading">{{ section.settings.heading | default: "FLAT 20% OFF FIRST ARCHIVE ORDER" }}</h2>
      <p class="d2c-promo-sub">Use coupon code <span class="d2c-code-pill">CYBER20</span> at checkout. Valid across all 280 GSM heavyweight drops.</p>
      <a href="/collections/all" class="d2c-promo-btn">CLAIM CODE & SHOP DROPS &rarr;</a>
    </div>
  </div>
</section>

<style>
  #d2c-promo-{{ section.id }} {
    background: #09090b;
    padding: 40px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-promo-container { max-width: 1320px; margin: 0 auto; }
  .d2c-promo-box {
    background: linear-gradient(135deg, #1c0b02 0%, #141418 100%);
    border: 2px solid #ff5500;
    border-radius: 14px;
    padding: 50px 30px;
    text-align: center;
    box-shadow: 0 20px 40px -15px rgba(255, 85, 0, 0.25);
  }
  .d2c-promo-tag {
    font-size: 11px;
    font-weight: 900;
    color: #ff5500;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
  }
  .d2c-promo-heading {
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -1px;
    margin-bottom: 14px;
  }
  .d2c-promo-sub {
    font-size: 16px;
    color: #a1a1aa;
    margin-bottom: 28px;
  }
  .d2c-code-pill {
    background: #ff5500;
    color: #ffffff;
    padding: 4px 10px;
    border-radius: 4px;
    font-weight: 900;
    letter-spacing: 1px;
  }
  .d2c-promo-btn {
    display: inline-block;
    background: #ff5500;
    color: #ffffff;
    padding: 16px 36px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 900;
    text-decoration: none;
    box-shadow: 0 10px 25px -5px rgba(255, 85, 0, 0.4);
  }

  @media (max-width: 768px) {
    .d2c-promo-box { padding: 32px 18px; }
  }
</style>

{% schema %}
{
  "name": "Streetwear Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FLAT 20% OFF FIRST ARCHIVE ORDER"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Promo Banner"
    }
  ]
}
{% endschema %}
