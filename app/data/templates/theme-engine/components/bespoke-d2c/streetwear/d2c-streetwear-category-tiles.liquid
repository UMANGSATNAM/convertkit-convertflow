{% comment %}
  D2C Streetwear Category Tiles
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-categories" id="d2c-categories-{{ section.id }}">
  <div class="d2c-cat-container">
    <div class="d2c-section-header">
      <span class="d2c-section-badge">COLLECTIONS</span>
      <h2 class="d2c-section-title">{{ section.settings.title | default: "SHOP BY ARCHIVE CATEGORY" }}</h2>
    </div>

    <div class="d2c-cat-grid">
      <a href="/collections/hoodies" class="d2c-cat-card">
        <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=600&q=80" alt="Heavyweight Hoodies" />
        <div class="d2c-cat-overlay">
          <span class="d2c-cat-count">24 PIECES</span>
          <h3 class="d2c-cat-name">HEAVYWEIGHT HOODIES</h3>
          <span class="d2c-cat-explore">EXPLORE DROP &rarr;</span>
        </div>
      </a>

      <a href="/collections/oversized-tees" class="d2c-cat-card">
        <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=600&q=80" alt="Oversized Acid Tees" />
        <div class="d2c-cat-overlay">
          <span class="d2c-cat-count">38 PIECES</span>
          <h3 class="d2c-cat-name">OVERSIZED ACID TEES</h3>
          <span class="d2c-cat-explore">EXPLORE DROP &rarr;</span>
        </div>
      </a>

      <a href="/collections/cargoes" class="d2c-cat-card">
        <img src="https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?w=600&q=80" alt="Modular Cargoes" />
        <div class="d2c-cat-overlay">
          <span class="d2c-cat-count">16 PIECES</span>
          <h3 class="d2c-cat-name">MODULAR CARGOES</h3>
          <span class="d2c-cat-explore">EXPLORE DROP &rarr;</span>
        </div>
      </a>

      <a href="/collections/headwear" class="d2c-cat-card">
        <img src="https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=600&q=80" alt="Street Headwear" />
        <div class="d2c-cat-overlay">
          <span class="d2c-cat-count">12 PIECES</span>
          <h3 class="d2c-cat-name">CAPS & HEADWEAR</h3>
          <span class="d2c-cat-explore">EXPLORE DROP &rarr;</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  #d2c-categories-{{ section.id }} {
    background: #09090b;
    padding: 60px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-cat-container { max-width: 1320px; margin: 0 auto; }
  .d2c-section-header { text-align: center; margin-bottom: 40px; }
  .d2c-section-badge {
    font-size: 11px;
    font-weight: 900;
    color: #ff5500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 8px;
  }
  .d2c-section-title {
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.5px;
    text-transform: uppercase;
  }
  .d2c-cat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .d2c-cat-card {
    position: relative;
    height: 380px;
    border-radius: 10px;
    overflow: hidden;
    border: 2px solid #27272a;
    text-decoration: none;
    display: block;
  }
  .d2c-cat-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .d2c-cat-card:hover img { transform: scale(1.06); }
  .d2c-cat-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(9,9,11,0.9) 0%, rgba(9,9,11,0.2) 60%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: #ffffff;
  }
  .d2c-cat-count {
    font-size: 11px;
    font-weight: 800;
    color: #ff5500;
    margin-bottom: 6px;
  }
  .d2c-cat-name {
    font-size: 18px;
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 10px;
  }
  .d2c-cat-explore {
    font-size: 12px;
    font-weight: 800;
    color: #a1a1aa;
    transition: color 0.15s ease;
  }
  .d2c-cat-card:hover .d2c-cat-explore { color: #ff5500; }

  @media (max-width: 1024px) {
    .d2c-cat-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .d2c-cat-grid { grid-template-columns: 1fr; }
    .d2c-cat-card { height: 300px; }
  }
</style>

{% schema %}
{
  "name": "Streetwear Categories",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SHOP BY ARCHIVE CATEGORY"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Categories"
    }
  ]
}
{% endschema %}
