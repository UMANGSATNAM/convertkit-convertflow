{% comment %}
  D2C Streetwear Featured Drop Spotlight
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-featureddrop" id="d2c-featureddrop-{{ section.id }}">
  <div class="d2c-feat-container">
    <div class="d2c-feat-card">
      <div class="d2c-feat-media">
        <span class="d2c-feat-badge">ARCHIVE DROP OF THE MONTH</span>
        <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=800&q=85" alt="Featured Streetwear Drop" />
      </div>

      <div class="d2c-feat-content">
        <div class="d2c-feat-tag">CYBER DIVISION // 004</div>
        <h2 class="d2c-feat-title">{{ section.settings.title | default: "HEAVYWEIGHT 280 GSM ACID WASH HOODIE" }}</h2>
        <p class="d2c-feat-desc">
          Crafted from custom-developed 100% combed cotton French Terry. Pre-shrunk with a double-layered structured hood and signature dropped shoulders for that oversized drape.
        </p>

        <div class="d2c-feat-specs-list">
          <div class="d2c-spec-row">
            <span class="d2c-spec-k">FABRIC:</span>
            <span class="d2c-spec-v">280 GSM Combed French Terry</span>
          </div>
          <div class="d2c-spec-row">
            <span class="d2c-spec-k">WASH:</span>
            <span class="d2c-spec-v">Hand Acid Mineral Wash (Unique Patterns)</span>
          </div>
          <div class="d2c-spec-row">
            <span class="d2c-spec-k">FIT:</span>
            <span class="d2c-spec-v">Boxy Oversized Drop-Shoulder</span>
          </div>
        </div>

        <div class="d2c-feat-price-wrap">
          <span class="d2c-feat-price">₹2,499</span>
          <span class="d2c-feat-compare">₹3,999</span>
          <span class="d2c-feat-save">SAVE ₹1,500</span>
        </div>

        <div class="d2c-feat-cta-row">
          <button class="d2c-feat-buy-btn">⚡ INSTANT BUY WITH COD</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-featureddrop-{{ section.id }} {
    background: #09090b;
    padding: 60px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-feat-container { max-width: 1320px; margin: 0 auto; }
  .d2c-feat-card {
    background: #141418;
    border: 2px solid #27272a;
    border-radius: 14px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    overflow: hidden;
    padding: 40px;
    align-items: center;
  }
  .d2c-feat-media {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #27272a;
  }
  .d2c-feat-media img { width: 100%; height: 480px; object-fit: cover; }
  .d2c-feat-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: #ff5500;
    color: #ffffff;
    font-size: 10px;
    font-weight: 900;
    padding: 6px 12px;
    border-radius: 4px;
    letter-spacing: 1px;
  }
  .d2c-feat-tag { font-size: 12px; font-weight: 900; color: #ff5500; letter-spacing: 1px; margin-bottom: 8px; }
  .d2c-feat-title { font-size: clamp(24px, 2.5vw, 34px); font-weight: 900; color: #ffffff; line-height: 1.15; margin-bottom: 16px; }
  .d2c-feat-desc { font-size: 14px; color: #a1a1aa; line-height: 1.6; margin-bottom: 24px; }
  .d2c-feat-specs-list {
    background: #1c1924;
    border: 1px solid #27272a;
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .d2c-spec-row { display: flex; justify-content: space-between; font-size: 12px; }
  .d2c-spec-k { font-weight: 800; color: #71717a; }
  .d2c-spec-v { font-weight: 700; color: #ffffff; }
  .d2c-feat-price-wrap { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .d2c-feat-price { font-size: 26px; font-weight: 900; color: #ff5500; }
  .d2c-feat-compare { font-size: 16px; color: #71717a; text-decoration: line-through; }
  .d2c-feat-save { background: rgba(34, 197, 94, 0.15); color: #22c55e; font-size: 11px; font-weight: 900; padding: 4px 8px; border-radius: 4px; }
  .d2c-feat-buy-btn {
    width: 100%;
    background: #ff5500;
    color: #ffffff;
    border: none;
    padding: 18px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.5px;
    cursor: pointer;
    box-shadow: 0 10px 25px -5px rgba(255, 85, 0, 0.4);
  }

  @media (max-width: 900px) {
    .d2c-feat-card { grid-template-columns: 1fr; padding: 24px 20px; gap: 28px; }
    .d2c-feat-media img { height: 320px; }
  }
</style>

{% schema %}
{
  "name": "Featured Drop Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HEAVYWEIGHT 280 GSM ACID WASH HOODIE"
    }
  ],
  "presets": [
    {
      "name": "Featured Drop Spotlight"
    }
  ]
}
{% endschema %}
