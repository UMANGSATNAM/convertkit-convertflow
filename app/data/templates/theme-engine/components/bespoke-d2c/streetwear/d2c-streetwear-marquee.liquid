{% comment %}
  D2C Streetwear Brutalist Marquee Ticker
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<div class="d2c-streetwear-marquee" id="d2c-marquee-{{ section.id }}">
  <div class="d2c-marquee-track">
    <div class="d2c-marquee-content">
      <span class="d2c-marquee-item">⚡ 280 GSM HEAVYWEIGHT TERRY</span>
      <span class="d2c-marquee-sep">✦</span>
      <span class="d2c-marquee-item">📦 COD AVAILABLE NATIONWIDE</span>
      <span class="d2c-marquee-sep">✦</span>
      <span class="d2c-marquee-item">🔥 OVERSIZED DROP 04 LIVE</span>
      <span class="d2c-marquee-sep">✦</span>
      <span class="d2c-marquee-item">🛡️ 7-DAY HASSLE FREE EXCHANGES</span>
      <span class="d2c-marquee-sep">✦</span>
      <span class="d2c-marquee-item">⚡ 280 GSM HEAVYWEIGHT TERRY</span>
      <span class="d2c-marquee-sep">✦</span>
      <span class="d2c-marquee-item">📦 COD AVAILABLE NATIONWIDE</span>
      <span class="d2c-marquee-sep">✦</span>
      <span class="d2c-marquee-item">🔥 OVERSIZED DROP 04 LIVE</span>
      <span class="d2c-marquee-sep">✦</span>
      <span class="d2c-marquee-item">🛡️ 7-DAY HASSLE FREE EXCHANGES</span>
    </div>
  </div>
</div>

<style>
  #d2c-marquee-{{ section.id }} {
    background: {{ section.settings.bg_color | default: "#ff5500" }};
    color: {{ section.settings.text_color | default: "#ffffff" }};
    overflow: hidden;
    white-space: nowrap;
    padding: 14px 0;
    border-top: 2px solid #000000;
    border-bottom: 2px solid #000000;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .d2c-marquee-track {
    display: flex;
    overflow: hidden;
  }
  .d2c-marquee-content {
    display: flex;
    align-items: center;
    gap: 24px;
    animation: d2c-marquee-scroll {{ section.settings.speed | default: 20 }}s linear infinite;
  }
  .d2c-marquee-sep {
    color: #000000;
    font-size: 16px;
  }
  @keyframes d2c-marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

{% schema %}
{
  "name": "Streetwear Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ff5500"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "s",
      "label": "Scroll Duration",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Streetwear Marquee"
    }
  ]
}
{% endschema %}
