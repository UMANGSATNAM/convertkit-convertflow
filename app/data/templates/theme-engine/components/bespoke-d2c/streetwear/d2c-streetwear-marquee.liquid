{% comment %}
  -----------------------------------------------------------------------------
  10X Bespoke D2C Architecture: Bewakoof / Urban Monkey - Continuous Marquee Ticker
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'd2c-streetwear-marquee'
  assign bg_color = section.settings.bg_color | default: '#141418'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#ff5500'
  assign marquee_text = section.settings.text | default: '★ 🔥 GEN-Z OVERSIZED DROPS • VAULT EDITION ★ 100% QUALITY BENCHMARK ★ 7-DAY DOORSTEP EXCHANGES ★ 45,000+ COMMITTED ENTHUSIASTS'
-%}

<div id="d2c-marquee-{{ sec_id }}" class="d2c-marquee-wrap">
  <div class="d2c-marquee-track">
    <div class="d2c-marquee-content">
      <span>{{ marquee_text }}</span>
      <span>{{ marquee_text }}</span>
      <span>{{ marquee_text }}</span>
      <span>{{ marquee_text }}</span>
    </div>
  </div>
</div>

<style>
  #d2c-marquee-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: 14px 0;
    overflow: hidden;
    border-top: 1px solid rgba(255, 85, 0, 0.25);
    border-bottom: 1px solid rgba(255, 85, 0, 0.25);
    font-family: 'Syne', -apple-system, sans-serif;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  #d2c-marquee-{{ sec_id }} .d2c-marquee-track { display: flex; width: 100%; overflow: hidden; white-space: nowrap; }
  #d2c-marquee-{{ sec_id }} .d2c-marquee-content { display: inline-flex; gap: 40px; animation: d2c-marquee-scroll 25s linear infinite; }
  #d2c-marquee-{{ sec_id }} .d2c-marquee-content span { color: {{ accent_color }}; }
  @keyframes d2c-marquee-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
</style>

{% schema %}
{
  "name": "Bewakoof / Urban Monkey Marquee Ticker",
  "tag": "section",
  "class": "d2c-marquee-section",
  "settings": [
    { "type": "text", "id": "text", "label": "Marquee String", "default": "★ 🔥 GEN-Z OVERSIZED DROPS • VAULT EDITION ★ 100% QUALITY BENCHMARK ★ 7-DAY DOORSTEP EXCHANGES" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#141418" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#ff5500" }
  ],
  "presets": [
    { "name": "Bewakoof / Urban Monkey Marquee Ticker" }
  ]
}
{% endschema %}
