{% comment %}
  D2C Streetwear VIP Club & Tier Privileges
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-vip" id="d2c-vip-{{ section.id }}">
  <div class="d2c-vip-container">
    <div class="d2c-vip-box">
      <div class="d2c-vip-header">
        <span class="d2c-vip-badge">MEMBER PRIVILEGES</span>
        <h2 class="d2c-vip-title">{{ section.settings.title | default: "JOIN THE CYBER STREETPASS VIP" }}</h2>
        <p class="d2c-vip-sub">Unlock 1-hour early drop access, member-only pricing, and automatic entry into quarterly sneaker raffles.</p>
      </div>

      <div class="d2c-vip-grid">
        <div class="d2c-vip-tier">
          <div class="d2c-tier-name">TIER 01 // ROOKIE</div>
          <div class="d2c-tier-perk">★ Free Cash on Delivery on all orders</div>
          <div class="d2c-tier-perk">★ 5% Cashback in StreetCoins</div>
        </div>

        <div class="d2c-vip-tier active">
          <div class="d2c-tier-badge">MOST POPULAR</div>
          <div class="d2c-tier-name">TIER 02 // CYBER VIP</div>
          <div class="d2c-tier-perk">★ 1-Hour Early Vault Drop Access</div>
          <div class="d2c-tier-perk">★ Flat 15% Off All Future Orders</div>
          <div class="d2c-tier-perk">★ Priority 24HR Air Dispatch</div>
        </div>

        <div class="d2c-vip-tier">
          <div class="d2c-tier-name">TIER 03 // INNER CIRCLE</div>
          <div class="d2c-tier-perk">★ Free 1-of-1 Friends & Family Piece</div>
          <div class="d2c-tier-perk">★ Dedicated VIP WhatsApp Concierge</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-vip-{{ section.id }} {
    background: #09090b;
    padding: 60px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-vip-container { max-width: 1320px; margin: 0 auto; }
  .d2c-vip-box {
    background: #141418;
    border: 2px solid #27272a;
    border-radius: 14px;
    padding: 48px 36px;
  }
  .d2c-vip-header { text-align: center; max-width: 700px; margin: 0 auto 40px; }
  .d2c-vip-badge { font-size: 11px; font-weight: 900; color: #ff5500; letter-spacing: 1.5px; }
  .d2c-vip-title { font-size: clamp(26px, 3vw, 38px); font-weight: 900; color: #ffffff; margin-top: 6px; margin-bottom: 12px; }
  .d2c-vip-sub { font-size: 15px; color: #a1a1aa; line-height: 1.6; }
  .d2c-vip-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .d2c-vip-tier {
    background: #09090b;
    border: 2px solid #27272a;
    border-radius: 10px;
    padding: 28px 24px;
    position: relative;
  }
  .d2c-vip-tier.active {
    border-color: #ff5500;
    box-shadow: 0 0 30px rgba(255, 85, 0, 0.15);
  }
  .d2c-tier-badge {
    position: absolute;
    top: -12px;
    left: 24px;
    background: #ff5500;
    color: #ffffff;
    font-size: 10px;
    font-weight: 900;
    padding: 2px 8px;
    border-radius: 4px;
  }
  .d2c-tier-name { font-size: 14px; font-weight: 900; color: #ffffff; margin-bottom: 16px; letter-spacing: 0.5px; }
  .d2c-tier-perk { font-size: 13px; color: #d4d4d8; margin-bottom: 10px; font-weight: 600; }

  @media (max-width: 900px) { .d2c-vip-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Streetwear VIP Perks",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "JOIN THE CYBER STREETPASS VIP"
    }
  ],
  "presets": [
    {
      "name": "Streetwear VIP Perks"
    }
  ]
}
{% endschema %}
