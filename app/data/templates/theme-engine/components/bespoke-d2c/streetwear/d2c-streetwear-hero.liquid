{% comment %}
  D2C Streetwear High-Octane Split Hero
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-hero" id="d2c-hero-{{ section.id }}">
  <div class="d2c-hero-container">
    <div class="d2c-hero-grid">
      <div class="d2c-hero-content">
        {% if section.settings.badge != blank %}
          <div class="d2c-hero-badge">
            <span class="d2c-badge-dot"></span>
            {{ section.settings.badge }}
          </div>
        {% endif %}

        <h1 class="d2c-hero-title">{{ section.settings.heading | default: "HEAVYWEIGHT STREET ARCHIVE '26" }}</h1>
        <p class="d2c-hero-sub">{{ section.settings.subheading | default: "Engineered 280 GSM French Terry cotton. Relaxed boxy silhouettes crafted for sub-zero urban style." }}</p>

        <div class="d2c-hero-countdown-box">
          <div class="d2c-timer-label">DROP 04 CLOSES IN:</div>
          <div class="d2c-timer-digits">
            <div class="d2c-digit-block"><span class="d2c-num">08</span><span class="d2c-lbl">HRS</span></div>
            <span class="d2c-sep">:</span>
            <div class="d2c-digit-block"><span class="d2c-num">42</span><span class="d2c-lbl">MIN</span></div>
            <span class="d2c-sep">:</span>
            <div class="d2c-digit-block"><span class="d2c-num">19</span><span class="d2c-lbl">SEC</span></div>
          </div>
        </div>

        <div class="d2c-hero-cta-row">
          <a href="{{ section.settings.btn_link | default: '/collections/all' }}" class="d2c-btn-primary">
            {{ section.settings.btn_text | default: "CLAIM EARLY DROP" }} &rarr;
          </a>
          <a href="/pages/lookbook" class="d2c-btn-secondary">
            VIEW LOOKBOOK
          </a>
        </div>

        <div class="d2c-hero-trust-micro">
          <span class="d2c-micro-tag">✓ 50,000+ Verfied Buyers</span>
          <span class="d2c-micro-tag">✓ Cash On Delivery</span>
          <span class="d2c-micro-tag">✓ 7-Day Easy Exchange</span>
        </div>
      </div>

      <div class="d2c-hero-media">
        <div class="d2c-hero-image-wrapper">
          {% if section.settings.image != blank %}
            <img src="{{ section.settings.image | img_url: '1000x' }}" alt="{{ section.settings.heading }}" class="d2c-hero-img" />
          {% else %}
            <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=900&q=85" alt="Streetwear Hero" class="d2c-hero-img" />
          {% endif %}
          <div class="d2c-hero-floating-card">
            <div class="d2c-floating-title">OVERSIZED ACID ACID HOODIE</div>
            <div class="d2c-floating-price">₹2,499 <span class="d2c-orig">₹3,999</span></div>
            <div class="d2c-stock-status">🔥 Only 14 Left in Batch 04</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-hero-{{ section.id }} {
    background: {{ section.settings.bg_color | default: "#09090b" }};
    color: {{ section.settings.text_color | default: "#ffffff" }};
    padding: {{ section.settings.padding_top | default: 60 }}px 24px {{ section.settings.padding_bottom | default: 60 }}px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    overflow: hidden;
  }
  .d2c-hero-container {
    max-width: 1320px;
    margin: 0 auto;
  }
  .d2c-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }
  .d2c-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 85, 0, 0.15);
    border: 1px solid #ff5500;
    color: #ff5500;
    font-size: 12px;
    font-weight: 900;
    padding: 6px 14px;
    border-radius: 4px;
    letter-spacing: 1px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }
  .d2c-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff5500;
    box-shadow: 0 0 10px #ff5500;
  }
  .d2c-hero-title {
    font-size: clamp(38px, 4.5vw, 62px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -1.5px;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  .d2c-hero-sub {
    font-size: 17px;
    color: #a1a1aa;
    line-height: 1.6;
    margin-bottom: 28px;
    max-width: 540px;
  }
  .d2c-hero-countdown-box {
    background: #141418;
    border: 1px solid #27272a;
    padding: 14px 20px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 32px;
  }
  .d2c-timer-label {
    font-size: 12px;
    font-weight: 800;
    color: #ff5500;
    letter-spacing: 1px;
  }
  .d2c-timer-digits {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .d2c-digit-block {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .d2c-num { font-size: 18px; font-weight: 900; font-family: monospace; }
  .d2c-lbl { font-size: 9px; color: #71717a; font-weight: 700; }
  .d2c-sep { font-size: 18px; font-weight: 900; color: #ff5500; }

  .d2c-hero-cta-row {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .d2c-btn-primary {
    background: #ff5500;
    color: #ffffff;
    padding: 16px 36px;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none;
    box-shadow: 0 10px 25px -5px rgba(255, 85, 0, 0.4);
    transition: transform 0.2s ease;
  }
  .d2c-btn-primary:hover { transform: translateY(-2px); }
  .d2c-btn-secondary {
    background: transparent;
    border: 2px solid #27272a;
    color: #ffffff;
    padding: 14px 28px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: none;
  }
  .d2c-btn-secondary:hover { border-color: #ff5500; color: #ff5500; }

  .d2c-hero-trust-micro {
    display: flex;
    gap: 20px;
    font-size: 12px;
    color: #71717a;
    font-weight: 700;
    flex-wrap: wrap;
  }
  .d2c-hero-image-wrapper {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid #27272a;
    background: #141418;
  }
  .d2c-hero-img {
    width: 100%;
    height: 520px;
    object-fit: cover;
  }
  .d2c-hero-floating-card {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: rgba(9, 9, 11, 0.9);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 85, 0, 0.3);
    padding: 16px 20px;
    border-radius: 8px;
  }
  .d2c-floating-title { font-size: 14px; font-weight: 900; margin-bottom: 4px; text-transform: uppercase; }
  .d2c-floating-price { font-size: 16px; font-weight: 900; color: #ff5500; margin-bottom: 4px; }
  .d2c-orig { font-size: 13px; color: #71717a; text-decoration: line-through; margin-left: 6px; }
  .d2c-stock-status { font-size: 11px; font-weight: 800; color: #ef4444; }

  @media (max-width: 900px) {
    .d2c-hero-grid { grid-template-columns: 1fr; gap: 36px; }
    .d2c-hero-title { font-size: 36px; }
    .d2c-hero-img { height: 380px; }
    #d2c-hero-{{ section.id }} { padding: 40px 16px; }
  }
</style>

{% schema %}
{
  "name": "Streetwear Hero",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "⚡ LIVE DROP 04: LIMITED 300 UNITS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HEAVYWEIGHT STREET ARCHIVE '26"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Engineered 280 GSM French Terry cotton. Relaxed boxy silhouettes crafted for sub-zero urban style."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Primary Button Text",
      "default": "CLAIM EARLY DROP"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Primary Button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#09090b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Streetwear Hero"
    }
  ]
}
{% endschema %}
