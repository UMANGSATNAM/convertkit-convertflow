{% comment %}
  D2C Streetwear Brutalist Mega Footer
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<footer class="d2c-streetwear-footer" id="d2c-footer-{{ section.id }}">
  <div class="d2c-footer-container">
    <div class="d2c-footer-top">
      <div class="d2c-footer-brand">
        <h3 class="d2c-footer-logo">{{ section.settings.logo_text | default: "CYBERSTREET" }}</h3>
        <p class="d2c-footer-tagline">Engineered 280 GSM heavyweight street silhouettes. Crafted for the underground, shipped across India.</p>
        <div class="d2c-footer-socials">
          <a href="#" class="d2c-soc-link">INSTAGRAM</a>
          <a href="#" class="d2c-soc-link">YOUTUBE</a>
          <a href="#" class="d2c-soc-link">DISCORD</a>
        </div>
      </div>

      <div class="d2c-footer-col">
        <h4 class="d2c-col-title">ARCHIVE DROPS</h4>
        <ul class="d2c-col-links">
          <li><a href="/collections/hoodies">Heavyweight Hoodies</a></li>
          <li><a href="/collections/oversized-tees">Acid Wash Tees</a></li>
          <li><a href="/collections/cargoes">Tactical Cargoes</a></li>
          <li><a href="/collections/headwear">Street Caps</a></li>
          <li><a href="/collections/all">All Vault Drops</a></li>
        </ul>
      </div>

      <div class="d2c-footer-col">
        <h4 class="d2c-col-title">CLIENT INTEL</h4>
        <ul class="d2c-col-links">
          <li><a href="/pages/track-order">Track COD Order</a></li>
          <li><a href="/pages/returns">7-Day Return Portal</a></li>
          <li><a href="/pages/sizing">Size Chart & Fit Guide</a></li>
          <li><a href="/pages/faq">Drop FAQs</a></li>
          <li><a href="/pages/contact">WhatsApp Support</a></li>
        </ul>
      </div>

      <div class="d2c-footer-col">
        <h4 class="d2c-col-title">PAYMENT SECURITY</h4>
        <p class="d2c-footer-pay-info">100% Encrypted 256-Bit SSL Checkout with Instant Cash on Delivery, UPI, Cards & NetBanking.</p>
        <div class="d2c-pay-badges">
          <span class="d2c-pay-chip">COD</span>
          <span class="d2c-pay-chip">UPI</span>
          <span class="d2c-pay-chip">VISA</span>
          <span class="d2c-pay-chip">MASTERCARD</span>
        </div>
      </div>
    </div>

    <div class="d2c-footer-bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: "CYBERSTREET ARCHIVE" }}. ALL RIGHTS RESERVED.</div>
      <div class="d2c-footer-legal">
        <a href="/policies/privacy-policy">PRIVACY</a>
        <a href="/policies/terms-of-service">TERMS</a>
        <a href="/policies/shipping-policy">SHIPPING</a>
      </div>
    </div>
  </div>
</footer>

<style>
  #d2c-footer-{{ section.id }} {
    background: #050507;
    border-top: 2px solid #27272a;
    padding: 70px 24px 30px;
    color: #71717a;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-footer-container { max-width: 1320px; margin: 0 auto; }
  .d2c-footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 40px;
    margin-bottom: 50px;
  }
  .d2c-footer-logo { font-size: 22px; font-weight: 900; color: #ffffff; letter-spacing: -0.5px; margin-bottom: 12px; text-transform: uppercase; }
  .d2c-footer-tagline { font-size: 13px; line-height: 1.6; color: #a1a1aa; margin-bottom: 20px; max-width: 320px; }
  .d2c-footer-socials { display: flex; gap: 16px; }
  .d2c-soc-link { font-size: 11px; font-weight: 900; color: #ff5500; text-decoration: none; letter-spacing: 0.5px; }
  .d2c-col-title { font-size: 13px; font-weight: 900; color: #ffffff; letter-spacing: 1px; margin-bottom: 18px; text-transform: uppercase; }
  .d2c-col-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .d2c-col-links a { color: #a1a1aa; text-decoration: none; font-size: 13px; font-weight: 600; transition: color 0.15s ease; }
  .d2c-col-links a:hover { color: #ff5500; }
  .d2c-footer-pay-info { font-size: 12px; line-height: 1.5; color: #a1a1aa; margin-bottom: 14px; }
  .d2c-pay-badges { display: flex; gap: 8px; flex-wrap: wrap; }
  .d2c-pay-chip { background: #141418; border: 1px solid #27272a; color: #ffffff; font-size: 10px; font-weight: 800; padding: 4px 8px; border-radius: 4px; }
  .d2c-footer-bottom {
    border-top: 1px solid #18181b;
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    font-weight: 700;
  }
  .d2c-footer-legal { display: flex; gap: 20px; }
  .d2c-footer-legal a { color: inherit; text-decoration: none; }
  .d2c-footer-legal a:hover { color: #ffffff; }

  @media (max-width: 1024px) {
    .d2c-footer-top { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .d2c-footer-top { grid-template-columns: 1fr; }
    .d2c-footer-bottom { flex-direction: column; gap: 12px; text-align: center; }
  }
</style>

{% schema %}
{
  "name": "Streetwear Footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "CYBERSTREET"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Footer"
    }
  ]
}
{% endschema %}
