{% comment %}
  D2C Streetwear Outfit Bundle & Save
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-bundle" id="d2c-bundle-{{ section.id }}">
  <div class="d2c-bundle-container">
    <div class="d2c-bundle-box">
      <div class="d2c-bundle-info">
        <span class="d2c-bundle-pill">⚡ ULTIMATE STREET DRIP BUNDLE</span>
        <h2 class="d2c-bundle-title">{{ section.settings.title | default: "HOODIE + CARGO + CAP COMBO" }}</h2>
        <p class="d2c-bundle-desc">Bundle any Heavyweight Hoodie with Tactical Cargoes and a Distressed Cap. Get an instant ₹1,500 checkout deduction + Free COD.</p>
        <div class="d2c-bundle-price-row">
          <span class="d2c-b-price">₹4,999</span>
          <span class="d2c-b-comp">₹7,897</span>
          <span class="d2c-b-tag">SAVE 36%</span>
        </div>
        <button class="d2c-b-btn">BUILD YOUR CUSTOM BUNDLE &rarr;</button>
      </div>

      <div class="d2c-bundle-visuals">
        <div class="d2c-b-item">
          <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=400&q=80" alt="Hoodie" />
          <span>Acid Hoodie</span>
        </div>
        <span class="d2c-b-plus">+</span>
        <div class="d2c-b-item">
          <img src="https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?w=400&q=80" alt="Cargo" />
          <span>Tactical Cargo</span>
        </div>
        <span class="d2c-b-plus">+</span>
        <div class="d2c-b-item">
          <img src="https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=400&q=80" alt="Cap" />
          <span>Cyber Cap</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-bundle-{{ section.id }} {
    background: #09090b;
    padding: 60px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-bundle-container { max-width: 1320px; margin: 0 auto; }
  .d2c-bundle-box {
    background: #141418;
    border: 2px dashed #ff5500;
    border-radius: 14px;
    padding: 40px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
  }
  .d2c-bundle-pill {
    font-size: 11px;
    font-weight: 900;
    color: #ff5500;
    letter-spacing: 1px;
    margin-bottom: 8px;
    display: block;
  }
  .d2c-bundle-title { font-size: clamp(24px, 2.5vw, 32px); font-weight: 900; color: #ffffff; margin-bottom: 12px; }
  .d2c-bundle-desc { font-size: 14px; color: #a1a1aa; line-height: 1.6; margin-bottom: 20px; }
  .d2c-bundle-price-row { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .d2c-b-price { font-size: 28px; font-weight: 900; color: #ff5500; }
  .d2c-b-comp { font-size: 16px; color: #71717a; text-decoration: line-through; }
  .d2c-b-tag { background: rgba(34, 197, 94, 0.15); color: #22c55e; font-size: 12px; font-weight: 900; padding: 4px 8px; border-radius: 4px; }
  .d2c-b-btn {
    background: #ff5500;
    color: #ffffff;
    border: none;
    padding: 16px 32px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 900;
    cursor: pointer;
    box-shadow: 0 10px 25px -5px rgba(255, 85, 0, 0.4);
  }
  .d2c-bundle-visuals {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .d2c-b-item {
    background: #09090b;
    border: 1px solid #27272a;
    border-radius: 8px;
    overflow: hidden;
    text-align: center;
    padding: 8px;
    width: 110px;
  }
  .d2c-b-item img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; margin-bottom: 6px; }
  .d2c-b-item span { font-size: 10px; font-weight: 800; color: #a1a1aa; }
  .d2c-b-plus { font-size: 18px; font-weight: 900; color: #ff5500; }

  @media (max-width: 900px) {
    .d2c-bundle-box { grid-template-columns: 1fr; padding: 24px 20px; }
  }
</style>

{% schema %}
{
  "name": "Streetwear Bundle",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HOODIE + CARGO + CAP COMBO"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Bundle"
    }
  ]
}
{% endschema %}
