{% comment %}
  D2C Streetwear Editorial Lookbook Grid
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-lookbook" id="d2c-lookbook-{{ section.id }}">
  <div class="d2c-lb-container">
    <div class="d2c-section-header">
      <span class="d2c-section-badge">EDITORIAL VAULT</span>
      <h2 class="d2c-section-title">{{ section.settings.title | default: "STREET LOOKBOOK // SEASON 04" }}</h2>
    </div>

    <div class="d2c-lb-grid">
      <div class="d2c-lb-card d2c-lb-large">
        <img src="https://images.unsplash.com/photo-1509631179647-0177331693ae?w=800&q=80" alt="Lookbook 01" />
        <div class="d2c-lb-overlay">
          <span class="d2c-lb-tag">LOOK 01</span>
          <h3 class="d2c-lb-title">NEO-TOKYO CYBER FIT</h3>
          <span class="d2c-lb-shop">SHOP FULL FIT &rarr;</span>
        </div>
      </div>

      <div class="d2c-lb-card">
        <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=600&q=80" alt="Lookbook 02" />
        <div class="d2c-lb-overlay">
          <span class="d2c-lb-tag">LOOK 02</span>
          <h3 class="d2c-lb-title">OVERSIZED MONOCHROME</h3>
          <span class="d2c-lb-shop">SHOP &rarr;</span>
        </div>
      </div>

      <div class="d2c-lb-card">
        <img src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=600&q=80" alt="Lookbook 03" />
        <div class="d2c-lb-overlay">
          <span class="d2c-lb-tag">LOOK 03</span>
          <h3 class="d2c-lb-title">TACTICAL CARGO STACK</h3>
          <span class="d2c-lb-shop">SHOP &rarr;</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-lookbook-{{ section.id }} {
    background: #09090b;
    padding: 60px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-lb-container { max-width: 1320px; margin: 0 auto; }
  .d2c-lb-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 20px;
  }
  .d2c-lb-card {
    position: relative;
    height: 480px;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid #27272a;
  }
  .d2c-lb-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .d2c-lb-card:hover img { transform: scale(1.05); }
  .d2c-lb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(9,9,11,0.9) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: #ffffff;
  }
  .d2c-lb-tag { font-size: 11px; font-weight: 900; color: #ff5500; margin-bottom: 4px; }
  .d2c-lb-title { font-size: 20px; font-weight: 900; margin-bottom: 8px; }
  .d2c-lb-shop { font-size: 12px; font-weight: 800; color: #a1a1aa; }
  .d2c-lb-card:hover .d2c-lb-shop { color: #ff5500; }

  @media (max-width: 900px) {
    .d2c-lb-grid { grid-template-columns: 1fr; }
    .d2c-lb-card { height: 360px; }
  }
</style>

{% schema %}
{
  "name": "Streetwear Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "STREET LOOKBOOK // SEASON 04"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Lookbook"
    }
  ]
}
{% endschema %}
