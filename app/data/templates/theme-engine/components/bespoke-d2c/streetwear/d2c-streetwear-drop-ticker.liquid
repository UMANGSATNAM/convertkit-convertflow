{% comment %}
  D2C Streetwear Drop Ticker & Live Stock Meter
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-drop-ticker" id="d2c-dropticker-{{ section.id }}">
  <div class="d2c-dropticker-container">
    <div class="d2c-dropticker-box">
      <div class="d2c-dropticker-left">
        <div class="d2c-drop-tag">LIMITED INVENTORY RELEASE</div>
        <h2 class="d2c-drop-heading">{{ section.settings.heading | default: "BATCH 04 // 300 UNITS TOTAL" }}</h2>
        <p class="d2c-drop-sub">Once 100% claimed, this colorway moves to the archive vault forever.</p>
      </div>

      <div class="d2c-dropticker-right">
        <div class="d2c-stock-meter-header">
          <span class="d2c-meter-label">CLAIMED STATUS</span>
          <span class="d2c-meter-percent">82% CLAIMED</span>
        </div>
        <div class="d2c-stock-bar-bg">
          <div class="d2c-stock-bar-fill" style="width: 82%;"></div>
        </div>
        <div class="d2c-meter-footer">
          <span>54 Units Remaining</span>
          <span class="d2c-live-dot">● Live Updating</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-dropticker-{{ section.id }} {
    background: #09090b;
    padding: 30px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-dropticker-container { max-width: 1320px; margin: 0 auto; }
  .d2c-dropticker-box {
    background: #141418;
    border: 2px solid #27272a;
    border-radius: 12px;
    padding: 32px 40px;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 40px;
    align-items: center;
  }
  .d2c-drop-tag {
    font-size: 11px;
    font-weight: 900;
    color: #ff5500;
    letter-spacing: 1px;
    margin-bottom: 6px;
  }
  .d2c-drop-heading {
    font-size: 24px;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.5px;
    margin-bottom: 6px;
  }
  .d2c-drop-sub {
    font-size: 14px;
    color: #a1a1aa;
  }
  .d2c-stock-meter-header {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 800;
    margin-bottom: 8px;
  }
  .d2c-meter-label { color: #71717a; }
  .d2c-meter-percent { color: #ff5500; }
  .d2c-stock-bar-bg {
    height: 12px;
    background: #27272a;
    border-radius: 99px;
    overflow: hidden;
    margin-bottom: 8px;
  }
  .d2c-stock-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #ff5500, #f59e0b);
    border-radius: 99px;
  }
  .d2c-meter-footer {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: #a1a1aa;
    font-weight: 700;
  }
  .d2c-live-dot { color: #22c55e; }

  @media (max-width: 800px) {
    .d2c-dropticker-box { grid-template-columns: 1fr; padding: 24px 20px; gap: 24px; }
  }
</style>

{% schema %}
{
  "name": "Streetwear Drop Ticker",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BATCH 04 // 300 UNITS TOTAL"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Drop Ticker"
    }
  ]
}
{% endschema %}
