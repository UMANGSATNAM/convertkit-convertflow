{% comment %}
  D2C Streetwear Fabric Tech & Specs Matrix
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-fabric" id="d2c-fabric-{{ section.id }}">
  <div class="d2c-fabric-container">
    <div class="d2c-section-header">
      <span class="d2c-section-badge">MATERIAL SCIENCE</span>
      <h2 class="d2c-section-title">{{ section.settings.title | default: "ENGINEERED STREETWEAR TECH" }}</h2>
    </div>

    <div class="d2c-fabric-grid">
      <div class="d2c-fabric-box">
        <div class="d2c-fabric-num">280</div>
        <div class="d2c-fabric-unit">GSM TERRY</div>
        <p class="d2c-fabric-desc">Ultra-dense heavyweight cotton woven with micro-loop back for zero sag and year-round structure.</p>
      </div>

      <div class="d2c-fabric-box">
        <div class="d2c-fabric-num">100%</div>
        <div class="d2c-fabric-unit">COMBED COTTON</div>
        <p class="d2c-fabric-desc">Long-staple combed cotton yarns eliminate pilling and deliver that ultra-smooth skin feel.</p>
      </div>

      <div class="d2c-fabric-box">
        <div class="d2c-fabric-num">0%</div>
        <div class="d2c-fabric-unit">PRE-SHRUNK</div>
        <p class="d2c-fabric-desc">Pre-washed and silicon treated. The oversized fit stays exactly as designed after 50+ machine washes.</p>
      </div>

      <div class="d2c-fabric-box">
        <div class="d2c-fabric-num">2X</div>
        <div class="d2c-fabric-unit">REINFORCED RIBS</div>
        <p class="d2c-fabric-desc">Double-stitched spandex-infused collar and cuffs that never bacon or lose their snug wrist grip.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-fabric-{{ section.id }} {
    background: #0c0c0e;
    padding: 60px 24px;
    border-top: 2px solid #27272a;
    border-bottom: 2px solid #27272a;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-fabric-container { max-width: 1320px; margin: 0 auto; }
  .d2c-fabric-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .d2c-fabric-box {
    background: #141418;
    border: 2px solid #27272a;
    border-radius: 10px;
    padding: 30px 24px;
    text-align: center;
    transition: border-color 0.2s ease;
  }
  .d2c-fabric-box:hover { border-color: #ff5500; }
  .d2c-fabric-num { font-size: 42px; font-weight: 900; color: #ff5500; line-height: 1; margin-bottom: 4px; }
  .d2c-fabric-unit { font-size: 12px; font-weight: 900; color: #ffffff; letter-spacing: 1px; margin-bottom: 12px; }
  .d2c-fabric-desc { font-size: 13px; color: #a1a1aa; line-height: 1.5; }

  @media (max-width: 900px) {
    .d2c-fabric-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 500px) {
    .d2c-fabric-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Streetwear Fabric Tech",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ENGINEERED STREETWEAR TECH"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Fabric Tech"
    }
  ]
}
{% endschema %}
