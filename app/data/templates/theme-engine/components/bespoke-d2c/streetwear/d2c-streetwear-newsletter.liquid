{% comment %}
  D2C Streetwear Secret Drop Newsletter Club
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-newsletter" id="d2c-news-{{ section.id }}">
  <div class="d2c-news-container">
    <div class="d2c-news-box">
      <span class="d2c-news-badge">SECRET DROP INTEL</span>
      <h2 class="d2c-news-title">{{ section.settings.title | default: "NEVER MISS A 300-UNIT DROP" }}</h2>
      <p class="d2c-news-sub">Sign up for exclusive SMS & email alerts 15 minutes before public drop launch.</p>

      <form class="d2c-news-form">
        <input type="email" placeholder="Enter your email address" class="d2c-news-input" required />
        <button type="submit" class="d2c-news-btn">GET EARLY ACCESS &rarr;</button>
      </form>
      <div class="d2c-news-note">🔒 Zero spam. Instant 1-click unsubscribe anytime.</div>
    </div>
  </div>
</section>

<style>
  #d2c-news-{{ section.id }} {
    background: #09090b;
    padding: 60px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-news-container { max-width: 860px; margin: 0 auto; }
  .d2c-news-box {
    background: #141418;
    border: 2px solid #27272a;
    border-radius: 14px;
    padding: 50px 30px;
    text-align: center;
  }
  .d2c-news-badge { font-size: 11px; font-weight: 900; color: #ff5500; letter-spacing: 1.5px; margin-bottom: 10px; display: block; }
  .d2c-news-title { font-size: clamp(26px, 3.5vw, 40px); font-weight: 900; color: #ffffff; margin-bottom: 12px; }
  .d2c-news-sub { font-size: 15px; color: #a1a1aa; margin-bottom: 28px; }
  .d2c-news-form { display: flex; gap: 12px; max-width: 520px; margin: 0 auto 16px; }
  .d2c-news-input {
    flex: 1;
    background: #09090b;
    border: 2px solid #27272a;
    border-radius: 6px;
    padding: 14px 18px;
    color: #ffffff;
    font-size: 14px;
    outline: none;
  }
  .d2c-news-input:focus { border-color: #ff5500; }
  .d2c-news-btn {
    background: #ff5500;
    color: #ffffff;
    border: none;
    padding: 14px 24px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 900;
    cursor: pointer;
  }
  .d2c-news-note { font-size: 11px; color: #71717a; font-weight: 600; }

  @media (max-width: 600px) {
    .d2c-news-form { flex-direction: column; }
    .d2c-news-box { padding: 32px 18px; }
  }
</style>

{% schema %}
{
  "name": "Streetwear Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "NEVER MISS A 300-UNIT DROP"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Newsletter"
    }
  ]
}
{% endschema %}
