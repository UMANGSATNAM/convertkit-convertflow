{% comment %}
  D2C Streetwear Verified Community Reviews
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-reviews" id="d2c-reviews-{{ section.id }}">
  <div class="d2c-rev-container">
    <div class="d2c-section-header">
      <span class="d2c-section-badge">VERIFIED BUYERS</span>
      <h2 class="d2c-section-title">{{ section.settings.title | default: "50,000+ FIVE-STAR STREET REVIEWS" }}</h2>
    </div>

    <div class="d2c-rev-grid">
      <div class="d2c-rev-card">
        <div class="d2c-rev-stars">★★★★★</div>
        <p class="d2c-rev-quote">"The 280 GSM weight is insane. Better drape and collar thickness than international brands charging 4x the price. Instant wardrobe staple."</p>
        <div class="d2c-rev-author-row">
          <div class="d2c-rev-avatar">RM</div>
          <div>
            <div class="d2c-rev-name">Rohan Malhotra</div>
            <div class="d2c-rev-meta">Verified Buyer • Mumbai • Acid Hoodie (L)</div>
          </div>
        </div>
      </div>

      <div class="d2c-rev-card">
        <div class="d2c-rev-stars">★★★★★</div>
        <p class="d2c-rev-quote">"Ordered on Tuesday, arrived on Thursday in Delhi via COD. The tactical cargo pockets actually hold phones and wallets without sagging."</p>
        <div class="d2c-rev-author-row">
          <div class="d2c-rev-avatar">SK</div>
          <div>
            <div class="d2c-rev-name">Sameer Khan</div>
            <div class="d2c-rev-meta">Verified Buyer • Delhi • Tactical Cargo (32)</div>
          </div>
        </div>
      </div>

      <div class="d2c-rev-card">
        <div class="d2c-rev-stars">★★★★★</div>
        <p class="d2c-rev-quote">"Washed this tee 10+ times already and zero shrinkage or collar baconing. The boxy cut is 100% on point."</p>
        <div class="d2c-rev-author-row">
          <div class="d2c-rev-avatar">TD</div>
          <div>
            <div class="d2c-rev-name">Tanvi Deshmukh</div>
            <div class="d2c-rev-meta">Verified Buyer • Bengaluru • Skull Tee (M)</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-reviews-{{ section.id }} {
    background: #09090b;
    padding: 60px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-rev-container { max-width: 1320px; margin: 0 auto; }
  .d2c-rev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .d2c-rev-card {
    background: #141418;
    border: 2px solid #27272a;
    border-radius: 12px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .d2c-rev-stars { color: #f59e0b; font-size: 16px; margin-bottom: 14px; letter-spacing: 2px; }
  .d2c-rev-quote { font-size: 14px; color: #d4d4d8; line-height: 1.6; margin-bottom: 24px; font-style: italic; }
  .d2c-rev-author-row { display: flex; align-items: center; gap: 12px; }
  .d2c-rev-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #ff5500;
    color: #ffffff;
    font-size: 12px;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .d2c-rev-name { font-size: 13px; font-weight: 800; color: #ffffff; }
  .d2c-rev-meta { font-size: 11px; color: #71717a; }

  @media (max-width: 900px) { .d2c-rev-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Streetwear Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "50,000+ FIVE-STAR STREET REVIEWS"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Reviews"
    }
  ]
}
{% endschema %}
