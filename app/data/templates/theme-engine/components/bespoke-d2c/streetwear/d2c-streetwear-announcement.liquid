{% comment %}
  D2C Streetwear Flash Drop Announcement Bar
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<div class="d2c-streetwear-announcement" id="d2c-announcement-{{ section.id }}">
  <div class="d2c-announcement-inner">
    {% if section.settings.show_badge %}
      <span class="d2c-announcement-badge">{{ section.settings.badge_text }}</span>
    {% endif %}
    <span class="d2c-announcement-text">{{ section.settings.text }}</span>
    {% if section.settings.link_text != blank %}
      <a href="{{ section.settings.link_url | default: '/collections/all' }}" class="d2c-announcement-link">
        {{ section.settings.link_text }} &rarr;
      </a>
    {% endif %}
  </div>
</div>

<style>
  #d2c-announcement-{{ section.id }} {
    background: {{ section.settings.bg_color | default: "#ff5500" }};
    color: {{ section.settings.text_color | default: "#ffffff" }};
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: {{ section.settings.font_size | default: 13 }}px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 10px 16px;
    text-transform: uppercase;
  }
  .d2c-announcement-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    text-align: center;
  }
  .d2c-announcement-badge {
    background: rgba(0, 0, 0, 0.3);
    padding: 2px 10px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
  }
  .d2c-announcement-link {
    text-decoration: underline;
    color: inherit;
    font-weight: 800;
  }
  @media (max-width: 768px) {
    #d2c-announcement-{{ section.id }} {
      font-size: 11px;
      padding: 8px 12px;
    }
    .d2c-announcement-inner {
      gap: 6px;
    }
  }
</style>

{% schema %}
{
  "name": "Streetwear Announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "⚡ DROP 04 LIVE: OVERSIZED ACID WASH HOODIES • FREE CASH ON DELIVERY"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "LIMITED DROP"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ff5500"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 13
    }
  ],
  "presets": [
    {
      "name": "Streetwear Announcement"
    }
  ]
}
{% endschema %}
