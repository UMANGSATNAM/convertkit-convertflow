{% comment %}
  D2C Streetwear Certified Trust Pillars
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-trust" id="d2c-trust-{{ section.id }}">
  <div class="d2c-trust-container">
    <div class="d2c-trust-grid">
      <div class="d2c-trust-item">
        <div class="d2c-trust-icon">📦</div>
        <h4 class="d2c-trust-title">CASH ON DELIVERY</h4>
        <p class="d2c-trust-desc">Pay at your doorstep across 19,000+ Indian pincodes.</p>
      </div>

      <div class="d2c-trust-item">
        <div class="d2c-trust-icon">⚡</div>
        <h4 class="d2c-trust-title">24-HOUR DISPATCH</h4>
        <p class="d2c-trust-desc">All confirmed orders ship via express air courier.</p>
      </div>

      <div class="d2c-trust-item">
        <div class="d2c-trust-icon">🔄</div>
        <h4 class="d2c-trust-title">7-DAY FREE EXCHANGES</h4>
        <p class="d2c-trust-desc">Doorstep size pickups with 1-click instant approval.</p>
      </div>

      <div class="d2c-trust-item">
        <div class="d2c-trust-icon">🛡️</div>
        <h4 class="d2c-trust-title">100% HEAVYWEIGHT GUARANTEE</h4>
        <p class="d2c-trust-desc">True 280 GSM combed cotton or 100% money back.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-trust-{{ section.id }} {
    background: #09090b;
    padding: 50px 24px;
    border-top: 1px solid #27272a;
    border-bottom: 1px solid #27272a;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-trust-container { max-width: 1320px; margin: 0 auto; }
  .d2c-trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }
  .d2c-trust-item {
    background: #141418;
    border: 1px solid #27272a;
    border-radius: 10px;
    padding: 28px 20px;
  }
  .d2c-trust-icon { font-size: 28px; margin-bottom: 12px; }
  .d2c-trust-title { font-size: 13px; font-weight: 900; color: #ffffff; letter-spacing: 0.5px; margin-bottom: 6px; }
  .d2c-trust-desc { font-size: 12px; color: #71717a; line-height: 1.4; }

  @media (max-width: 900px) { .d2c-trust-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-trust-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Streetwear Trust",
  "settings": [],
  "presets": [
    {
      "name": "Streetwear Trust"
    }
  ]
}
{% endschema %}
