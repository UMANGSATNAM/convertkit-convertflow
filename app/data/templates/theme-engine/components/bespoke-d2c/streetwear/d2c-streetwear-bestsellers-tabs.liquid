{% comment %}
  D2C Streetwear Bestsellers Tabs with Quick Size Add
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-bestsellers" id="d2c-bestsellers-{{ section.id }}">
  <div class="d2c-best-container">
    <div class="d2c-section-header">
      <span class="d2c-section-badge">COMMUNITY PICKS</span>
      <h2 class="d2c-section-title">{{ section.settings.title | default: "ICONIC STREET BESTSELLERS" }}</h2>
    </div>

    <div class="d2c-tabs-nav">
      <button class="d2c-tab-btn active">ALL DROPS</button>
      <button class="d2c-tab-btn">HEAVYWEIGHT</button>
      <button class="d2c-tab-btn">ACID WASH</button>
      <button class="d2c-tab-btn">LIMITED EDITIONS</button>
    </div>

    <div class="d2c-product-grid">
      <!-- Product 1 -->
      <div class="d2c-prod-card">
        <div class="d2c-prod-thumb">
          <span class="d2c-prod-badge">🔥 TOP RATED</span>
          <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=600&q=80" alt="Acid Wash Boxy Hoodie" />
        </div>
        <div class="d2c-prod-details">
          <div class="d2c-prod-meta">280 GSM • FRENCH TERRY</div>
          <h3 class="d2c-prod-title">Acid Wash Boxy Hoodie</h3>
          <div class="d2c-prod-price-row">
            <span class="d2c-price">₹2,499</span>
            <span class="d2c-compare">₹3,999</span>
            <span class="d2c-discount">37% OFF</span>
          </div>
          <div class="d2c-size-selector">
            <span class="d2c-size-chip">S</span>
            <span class="d2c-size-chip active">M</span>
            <span class="d2c-size-chip">L</span>
            <span class="d2c-size-chip">XL</span>
          </div>
          <button class="d2c-atc-btn">+ QUICK ADD TO BAG</button>
        </div>
      </div>

      <!-- Product 2 -->
      <div class="d2c-prod-card">
        <div class="d2c-prod-thumb">
          <span class="d2c-prod-badge">⚡ ONLY 9 LEFT</span>
          <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=600&q=80" alt="Cyber Skull Oversized Tee" />
        </div>
        <div class="d2c-prod-details">
          <div class="d2c-prod-meta">240 GSM • 100% COTTON</div>
          <h3 class="d2c-prod-title">Cyber Skull Oversized Tee</h3>
          <div class="d2c-prod-price-row">
            <span class="d2c-price">₹1,299</span>
            <span class="d2c-compare">₹1,999</span>
            <span class="d2c-discount">35% OFF</span>
          </div>
          <div class="d2c-size-selector">
            <span class="d2c-size-chip">S</span>
            <span class="d2c-size-chip">M</span>
            <span class="d2c-size-chip active">L</span>
            <span class="d2c-size-chip">XL</span>
          </div>
          <button class="d2c-atc-btn">+ QUICK ADD TO BAG</button>
        </div>
      </div>

      <!-- Product 3 -->
      <div class="d2c-prod-card">
        <div class="d2c-prod-thumb">
          <span class="d2c-prod-badge">★ VIRAL</span>
          <img src="https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?w=600&q=80" alt="Tactical 8-Pocket Cargo" />
        </div>
        <div class="d2c-prod-details">
          <div class="d2c-prod-meta">WATER-RESISTANT NYLON</div>
          <h3 class="d2c-prod-title">Tactical 8-Pocket Cargo</h3>
          <div class="d2c-prod-price-row">
            <span class="d2c-price">₹2,899</span>
            <span class="d2c-compare">₹4,499</span>
            <span class="d2c-discount">35% OFF</span>
          </div>
          <div class="d2c-size-selector">
            <span class="d2c-size-chip">30</span>
            <span class="d2c-size-chip active">32</span>
            <span class="d2c-size-chip">34</span>
            <span class="d2c-size-chip">36</span>
          </div>
          <button class="d2c-atc-btn">+ QUICK ADD TO BAG</button>
        </div>
      </div>

      <!-- Product 4 -->
      <div class="d2c-prod-card">
        <div class="d2c-prod-thumb">
          <span class="d2c-prod-badge">🔥 RESTOCKED</span>
          <img src="https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=600&q=80" alt="Distressed Cyber Dad Cap" />
        </div>
        <div class="d2c-prod-details">
          <div class="d2c-prod-meta">100% WASHED TWILL</div>
          <h3 class="d2c-prod-title">Distressed Cyber Dad Cap</h3>
          <div class="d2c-prod-price-row">
            <span class="d2c-price">₹899</span>
            <span class="d2c-compare">₹1,499</span>
            <span class="d2c-discount">40% OFF</span>
          </div>
          <div class="d2c-size-selector">
            <span class="d2c-size-chip active">ONE SIZE</span>
          </div>
          <button class="d2c-atc-btn">+ QUICK ADD TO BAG</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-bestsellers-{{ section.id }} {
    background: #09090b;
    padding: 60px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-best-container { max-width: 1320px; margin: 0 auto; }
  .d2c-tabs-nav {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }
  .d2c-tab-btn {
    background: #141418;
    border: 1px solid #27272a;
    color: #a1a1aa;
    font-size: 12px;
    font-weight: 800;
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }
  .d2c-tab-btn.active, .d2c-tab-btn:hover {
    background: #ff5500;
    border-color: #ff5500;
    color: #ffffff;
  }
  .d2c-product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .d2c-prod-card {
    background: #141418;
    border: 2px solid #27272a;
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .d2c-prod-card:hover {
    transform: translateY(-4px);
    border-color: #ff5500;
  }
  .d2c-prod-thumb {
    position: relative;
    aspect-ratio: 1;
    background: #1c1924;
    overflow: hidden;
  }
  .d2c-prod-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-prod-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #ff5500;
    color: #ffffff;
    font-size: 10px;
    font-weight: 900;
    padding: 4px 8px;
    border-radius: 4px;
  }
  .d2c-prod-details { padding: 18px; display: flex; flex-direction: column; flex-grow: 1; justify-content: space-between; }
  .d2c-prod-meta { font-size: 10px; font-weight: 800; color: #71717a; letter-spacing: 0.5px; margin-bottom: 6px; }
  .d2c-prod-title { font-size: 15px; font-weight: 800; color: #ffffff; margin-bottom: 10px; }
  .d2c-prod-price-row { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
  .d2c-price { font-size: 16px; font-weight: 900; color: #ff5500; }
  .d2c-compare { font-size: 13px; color: #71717a; text-decoration: line-through; }
  .d2c-discount { font-size: 11px; font-weight: 800; color: #22c55e; }
  .d2c-size-selector { display: flex; gap: 6px; margin-bottom: 14px; }
  .d2c-size-chip {
    padding: 4px 10px;
    background: #27272a;
    border: 1px solid #3f3f46;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 800;
    color: #ffffff;
    cursor: pointer;
  }
  .d2c-size-chip.active { background: #ff5500; border-color: #ff5500; }
  .d2c-atc-btn {
    width: 100%;
    background: #27272a;
    color: #ffffff;
    border: 1px solid #3f3f46;
    padding: 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 900;
    cursor: pointer;
    letter-spacing: 0.5px;
    transition: background 0.15s ease;
  }
  .d2c-atc-btn:hover { background: #ff5500; border-color: #ff5500; }

  @media (max-width: 1024px) {
    .d2c-product-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .d2c-product-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .d2c-prod-details { padding: 12px; }
    .d2c-prod-title { font-size: 13px; }
    .d2c-size-selector { display: none; }
  }
</style>

{% schema %}
{
  "name": "Streetwear Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ICONIC STREET BESTSELLERS"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Bestsellers"
    }
  ]
}
{% endschema %}
