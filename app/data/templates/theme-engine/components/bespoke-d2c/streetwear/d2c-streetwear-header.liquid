{% comment %}
  D2C Streetwear Brutalist Header Chrome
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<header class="d2c-streetwear-header" id="d2c-header-{{ section.id }}">
  <div class="d2c-header-container">
    <div class="d2c-header-left">
      <a href="/" class="d2c-header-logo">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | img_url: 'medium' }}" alt="{{ shop.name }}" />
        {% else %}
          <span class="d2c-logo-text">{{ section.settings.logo_text | default: shop.name | default: "CYBERSTREET" }}</span>
        {% endif %}
      </a>
    </div>

    <nav class="d2c-header-nav">
      <a href="/collections/all" class="d2c-nav-link active">ALL DROPS</a>
      <a href="/collections/hoodies" class="d2c-nav-link">HOODIES</a>
      <a href="/collections/oversized-tees" class="d2c-nav-link">OVERSIZED TEES</a>
      <a href="/collections/cargoes" class="d2c-nav-link">CARGOES</a>
      <a href="/pages/lookbook" class="d2c-nav-link highlight">LOOKBOOK 🔥</a>
    </nav>

    <div class="d2c-header-actions">
      <button class="d2c-header-icon-btn" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>
      <a href="/account" class="d2c-header-icon-btn" aria-label="Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </a>
      <a href="/cart" class="d2c-cart-pill">
        <span class="d2c-cart-label">CART</span>
        <span class="d2c-cart-count">{{ cart.item_count | default: 0 }}</span>
      </a>
    </div>
  </div>
</header>

<style>
  #d2c-header-{{ section.id }} {
    background: {{ section.settings.bg_color | default: "#09090b" }};
    border-bottom: 2px solid {{ section.settings.border_color | default: "#27272a" }};
    position: sticky;
    top: 0;
    z-index: 1000;
    padding: 14px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-header-container {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .d2c-logo-text {
    font-size: 24px;
    font-weight: 900;
    letter-spacing: -1px;
    color: {{ section.settings.text_color | default: "#ffffff" }};
    text-transform: uppercase;
  }
  .d2c-header-nav {
    display: flex;
    gap: 28px;
    align-items: center;
  }
  .d2c-nav-link {
    color: {{ section.settings.text_color | default: "#ffffff" }};
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .d2c-nav-link:hover, .d2c-nav-link.active {
    color: {{ section.settings.accent_color | default: "#ff5500" }};
  }
  .d2c-nav-link.highlight {
    background: rgba(255, 85, 0, 0.15);
    color: {{ section.settings.accent_color | default: "#ff5500" }};
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid {{ section.settings.accent_color | default: "#ff5500" }};
  }
  .d2c-header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .d2c-header-icon-btn {
    background: transparent;
    border: none;
    color: {{ section.settings.text_color | default: "#ffffff" }};
    cursor: pointer;
    display: flex;
    align-items: center;
  }
  .d2c-cart-pill {
    background: {{ section.settings.accent_color | default: "#ff5500" }};
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
  }
  .d2c-cart-count {
    background: #000000;
    color: #ffffff;
    font-size: 11px;
    padding: 2px 6px;
    border-radius: 99px;
  }
  @media (max-width: 900px) {
    .d2c-header-nav { display: none; }
    #d2c-header-{{ section.id }} { padding: 12px 16px; }
    .d2c-logo-text { font-size: 20px; }
  }
</style>

{% schema %}
{
  "name": "Streetwear Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "URBAN DROP"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Header Background",
      "default": "#09090b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#27272a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff5500"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Header"
    }
  ]
}
{% endschema %}
