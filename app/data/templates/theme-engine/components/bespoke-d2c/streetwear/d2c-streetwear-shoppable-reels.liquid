{% comment %}
  D2C Streetwear Shoppable UGC Reels
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-reels" id="d2c-reels-{{ section.id }}">
  <div class="d2c-reels-container">
    <div class="d2c-section-header">
      <span class="d2c-section-badge">COMMUNITY IN MOTION</span>
      <h2 class="d2c-section-title">{{ section.settings.title | default: "WATCH & SHOP THE REELS" }}</h2>
    </div>

    <div class="d2c-reels-grid">
      <!-- Reel 1 -->
      <div class="d2c-reel-card">
        <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=600&q=80" alt="Reel 1" class="d2c-reel-img" />
        <div class="d2c-reel-play-icon">▶</div>
        <div class="d2c-reel-overlay">
          <div class="d2c-reel-user">@rohit.fits</div>
          <div class="d2c-reel-caption">Styling the Drop 04 Acid Hoodie 🔥</div>
          <div class="d2c-reel-product-pill">
            <span class="d2c-pill-thumb">🛒</span>
            <span class="d2c-pill-info">Acid Hoodie · ₹2,499</span>
          </div>
        </div>
      </div>

      <!-- Reel 2 -->
      <div class="d2c-reel-card">
        <img src="https://images.unsplash.com/photo-1509631179647-0177331693ae?w=600&q=80" alt="Reel 2" class="d2c-reel-img" />
        <div class="d2c-reel-play-icon">▶</div>
        <div class="d2c-reel-overlay">
          <div class="d2c-reel-user">@street_vibes</div>
          <div class="d2c-reel-caption">Best oversized tee in India right now.</div>
          <div class="d2c-reel-product-pill">
            <span class="d2c-pill-thumb">🛒</span>
            <span class="d2c-pill-info">Skull Tee · ₹1,299</span>
          </div>
        </div>
      </div>

      <!-- Reel 3 -->
      <div class="d2c-reel-card">
        <img src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=600&q=80" alt="Reel 3" class="d2c-reel-img" />
        <div class="d2c-reel-play-icon">▶</div>
        <div class="d2c-reel-overlay">
          <div class="d2c-reel-user">@sam_kickz</div>
          <div class="d2c-reel-caption">8-Pocket Cargo fit check with Jordan 1s</div>
          <div class="d2c-reel-product-pill">
            <span class="d2c-pill-thumb">🛒</span>
            <span class="d2c-pill-info">Cargoes · ₹2,899</span>
          </div>
        </div>
      </div>

      <!-- Reel 4 -->
      <div class="d2c-reel-card">
        <img src="https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?w=600&q=80" alt="Reel 4" class="d2c-reel-img" />
        <div class="d2c-reel-play-icon">▶</div>
        <div class="d2c-reel-overlay">
          <div class="d2c-reel-user">@ananya_x</div>
          <div class="d2c-reel-caption">Unboxing Drop 04 vault package!</div>
          <div class="d2c-reel-product-pill">
            <span class="d2c-pill-thumb">🛒</span>
            <span class="d2c-pill-info">Cyber Cap · ₹899</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-reels-{{ section.id }} {
    background: #09090b;
    padding: 60px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-reels-container { max-width: 1320px; margin: 0 auto; }
  .d2c-reels-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .d2c-reel-card {
    position: relative;
    aspect-ratio: 9/16;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid #27272a;
    cursor: pointer;
  }
  .d2c-reel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .d2c-reel-card:hover .d2c-reel-img { transform: scale(1.05); }
  .d2c-reel-play-icon {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(8px);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 11px;
  }
  .d2c-reel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(9,9,11,0.95) 0%, rgba(9,9,11,0.2) 60%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 18px;
    color: #ffffff;
  }
  .d2c-reel-user { font-size: 11px; font-weight: 800; color: #ff5500; margin-bottom: 4px; }
  .d2c-reel-caption { font-size: 13px; font-weight: 700; line-height: 1.3; margin-bottom: 12px; }
  .d2c-reel-product-pill {
    background: rgba(255, 85, 0, 0.2);
    border: 1px solid #ff5500;
    padding: 6px 12px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 800;
    color: #ffffff;
  }

  @media (max-width: 1024px) {
    .d2c-reels-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .d2c-reels-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .d2c-reel-overlay { padding: 12px; }
    .d2c-reel-caption { font-size: 11px; }
    .d2c-reel-product-pill { font-size: 10px; padding: 4px 8px; }
  }
</style>

{% schema %}
{
  "name": "Streetwear Reels",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "WATCH & SHOP THE REELS"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Reels"
    }
  ]
}
{% endschema %}
