{% comment %}
  D2C Streetwear UGC Community Wall
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-ugc" id="d2c-ugc-{{ section.id }}">
  <div class="d2c-ugc-container">
    <div class="d2c-section-header">
      <span class="d2c-section-badge">#STREETCLUB // 50K+ STRONG</span>
      <h2 class="d2c-section-title">{{ section.settings.title | default: "TAGGED BY THE UNDERGROUND" }}</h2>
    </div>

    <div class="d2c-ugc-grid">
      <div class="d2c-ugc-tile"><img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=600&q=80" alt="UGC 1" /><span>@aryan.vibe</span></div>
      <div class="d2c-ugc-tile"><img src="https://images.unsplash.com/photo-1509631179647-0177331693ae?w=600&q=80" alt="UGC 2" /><span>@street_drip</span></div>
      <div class="d2c-ugc-tile"><img src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=600&q=80" alt="UGC 3" /><span>@kabir.raw</span></div>
      <div class="d2c-ugc-tile"><img src="https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?w=600&q=80" alt="UGC 4" /><span>@zoya_street</span></div>
      <div class="d2c-ugc-tile"><img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=600&q=80" alt="UGC 5" /><span>@kartik.fits</span></div>
      <div class="d2c-ugc-tile"><img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=600&q=80" alt="UGC 6" /><span>@neha_urban</span></div>
    </div>
  </div>
</section>

<style>
  #d2c-ugc-{{ section.id }} {
    background: #09090b;
    padding: 60px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-ugc-container { max-width: 1320px; margin: 0 auto; }
  .d2c-ugc-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
  }
  .d2c-ugc-tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #27272a;
  }
  .d2c-ugc-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .d2c-ugc-tile:hover img { transform: scale(1.08); }
  .d2c-ugc-tile span {
    position: absolute;
    bottom: 8px;
    left: 8px;
    background: rgba(0,0,0,0.7);
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 6px;
    border-radius: 4px;
  }

  @media (max-width: 1024px) { .d2c-ugc-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 500px) { .d2c-ugc-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

{% schema %}
{
  "name": "Streetwear UGC Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "TAGGED BY THE UNDERGROUND"
    }
  ],
  "presets": [
    {
      "name": "Streetwear UGC Grid"
    }
  ]
}
{% endschema %}
