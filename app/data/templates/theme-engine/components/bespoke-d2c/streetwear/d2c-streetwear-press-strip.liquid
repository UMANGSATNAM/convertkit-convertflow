{% comment %}
  D2C Streetwear Press Strip
  Theme: Bewakoof / Urban Monkey Cyber Streetwear
{% endcomment %}

<section class="d2c-streetwear-press" id="d2c-press-{{ section.id }}">
  <div class="d2c-press-container">
    <span class="d2c-press-label">AS SEEN IN</span>
    <div class="d2c-press-logos">
      <span class="d2c-logo-item">GQ INDIA</span>
      <span class="d2c-logo-item">ROLLING STONE</span>
      <span class="d2c-logo-item">SNEAKERNEWS</span>
      <span class="d2c-logo-item">COMPLEX</span>
      <span class="d2c-logo-item">GRAILED</span>
    </div>
  </div>
</section>

<style>
  #d2c-press-{{ section.id }} {
    background: #09090b;
    padding: 36px 24px;
    border-bottom: 1px solid #27272a;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-press-container {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .d2c-press-label { font-size: 11px; font-weight: 900; color: #71717a; letter-spacing: 1.5px; }
  .d2c-press-logos {
    display: flex;
    gap: 40px;
    align-items: center;
    flex-wrap: wrap;
  }
  .d2c-logo-item {
    font-size: 18px;
    font-weight: 900;
    color: #52525b;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }
  .d2c-logo-item:hover { color: #ffffff; }

  @media (max-width: 768px) {
    .d2c-press-container { justify-content: center; text-align: center; }
    .d2c-press-logos { justify-content: center; gap: 20px; }
  }
</style>

{% schema %}
{
  "name": "Streetwear Press Strip",
  "settings": [],
  "presets": [
    {
      "name": "Streetwear Press Strip"
    }
  ]
}
{% endschema %}
