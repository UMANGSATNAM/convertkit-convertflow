{% comment %}
  D2C Velvet Glam Announcement Bar
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<div class="d2c-glam-announcement" id="d2c-gann-{{ section.id }}">
  <div class="d2c-gann-inner">
    <span>💎</span>
    <span class="d2c-gann-text">{{ section.settings.text | default: "24HR TRANSFERPROOF VELVET GLAM '26 // BUY 2 GET FREE MATTE POUCH" }}</span>
    <span class="d2c-gann-sep">✦</span>
    <span class="d2c-gann-sub">FREE CASH ON DELIVERY</span>
  </div>
</div>

<style>
  #d2c-gann-{{ section.id }} {
    background: #180816;
    color: #fdf4ff;
    padding: 10px 16px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-align: center;
    border-bottom: 1px solid rgba(232, 121, 249, 0.3);
  }
  .d2c-gann-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }
  .d2c-gann-sub { color: #f472b6; font-weight: 900; }
  .d2c-gann-sep { opacity: 0.6; }
  @media (max-width: 768px) { #d2c-gann-{{ section.id }} { font-size: 11px; padding: 8px 12px; } .d2c-gann-sub { display: none; } }
</style>

{% schema %}
{
  "name": "Glam Announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "24HR TRANSFERPROOF VELVET GLAM '26 // BUY 2 GET FREE MATTE POUCH"
    }
  ],
  "presets": [
    {
      "name": "Glam Announcement"
    }
  ]
}
{% endschema %}
