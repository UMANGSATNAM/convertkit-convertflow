{% comment %}
  D2C Velvet Glam Category Showcase
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-cats" id="d2c-gcats-{{ section.id }}">
  <div class="d2c-gcats-container">
    <div class="d2c-gsec-header">
      <span class="d2c-g-badge">THE BEAUTY ARSENAL</span>
      <h2 class="d2c-g-title">{{ section.settings.title | default: "HIGH-PERFORMANCE GLAM ESSENTIALS" }}</h2>
    </div>

    <div class="d2c-gcats-grid">
      <a href="/collections/lipsticks" class="d2c-gcat-card">
        <img src="https://images.unsplash.com/photo-1586495777744-4413f21062fa?w=600&q=80" alt="Velvet Lipsticks" />
        <div class="d2c-gcat-overlay">
          <span class="d2c-gcat-sub">36 HIGH-PIGMENT SHADES</span>
          <h3 class="d2c-gcat-name">MATTE CRAYONS & LIQUIDS</h3>
          <span class="d2c-gcat-link">SHOP LIPS &rarr;</span>
        </div>
      </a>

      <a href="/collections/hd-foundation" class="d2c-gcat-card">
        <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=600&q=80" alt="HD Foundations" />
        <div class="d2c-gcat-overlay">
          <span class="d2c-gcat-sub">24HR WATERPROOF COVER</span>
          <h3 class="d2c-gcat-name">HD FOUNDATIONS & CONCEALER</h3>
          <span class="d2c-gcat-link">SHOP &rarr;</span>
        </div>
      </a>

      <a href="/collections/eyeliners" class="d2c-gcat-card">
        <img src="https://images.unsplash.com/photo-1596704017254-9b121068fb31?w=600&q=80" alt="Gel Eyeliners" />
        <div class="d2c-gcat-overlay">
          <span class="d2c-gcat-sub">JET BLACK SMUDGEPROOF</span>
          <h3 class="d2c-gcat-name">KOHL & GEL EYELINERS</h3>
          <span class="d2c-gcat-link">SHOP &rarr;</span>
        </div>
      </a>

      <a href="/collections/fragrances" class="d2c-gcat-card">
        <img src="https://images.unsplash.com/photo-1541643600914-78b084683601?w=600&q=80" alt="Haute Fragrance" />
        <div class="d2c-gcat-overlay">
          <span class="d2c-gcat-sub">EAU DE PARFUM INTENSE</span>
          <h3 class="d2c-gcat-name">HAUTE PERFUMERY</h3>
          <span class="d2c-gcat-link">SHOP &rarr;</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  #d2c-gcats-{{ section.id }} {
    background: #180816;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-gcats-container { max-width: 1360px; margin: 0 auto; }
  .d2c-gsec-header { text-align: center; margin-bottom: 48px; }
  .d2c-g-badge { font-size: 11px; font-weight: 800; color: #e879f9; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px; display: block; }
  .d2c-g-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 900; color: #ffffff; letter-spacing: -0.5px; text-transform: uppercase; }
  .d2c-gcats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-gcat-card {
    position: relative;
    height: 420px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(232, 121, 249, 0.3);
    text-decoration: none;
    display: block;
  }
  .d2c-gcat-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .d2c-gcat-card:hover img { transform: scale(1.06); }
  .d2c-gcat-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(24,8,22,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: #ffffff;
    text-align: center;
  }
  .d2c-gcat-sub { font-size: 10px; font-weight: 800; color: #f472b6; letter-spacing: 1.5px; margin-bottom: 4px; }
  .d2c-gcat-name { font-size: 16px; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 6px; }
  .d2c-gcat-link { font-size: 11px; font-weight: 800; color: #f5d0fe; }

  @media (max-width: 1024px) { .d2c-gcats-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-gcats-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Glam Categories",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HIGH-PERFORMANCE GLAM ESSENTIALS"
    }
  ],
  "presets": [
    {
      "name": "Glam Categories"
    }
  ]
}
{% endschema %}
