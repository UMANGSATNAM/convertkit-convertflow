{% comment %}
  D2C Velvet Glam Promo Banner
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-promo" id="d2c-gpromo-{{ section.id }}">
  <div class="d2c-gpromo-container">
    <div class="d2c-gpromo-card">
      <span class="d2c-g-badge" style="color: #f472b6;">FESTIVE GLAM DROP</span>
      <h2 class="d2c-gpromo-title">{{ section.settings.title | default: "BUY ANY 2 LIPSTICKS & GET FREE VELVET CLUTCH" }}</h2>
      <p class="d2c-gpromo-desc">Use coupon code <span class="d2c-gpromo-code">GLAMCLUTCH</span> at checkout. Includes complimentary German sharpener & Free Cash on Delivery.</p>
      <a href="/collections/lipsticks" class="d2c-gpromo-btn">SHOP THE LIP DROP &rarr;</a>
    </div>
  </div>
</section>

<style>
  #d2c-gpromo-{{ section.id }} {
    background: #180816;
    padding: 50px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-gpromo-container { max-width: 1360px; margin: 0 auto; }
  .d2c-gpromo-card {
    background: linear-gradient(135deg, #2a0b25 0%, #120410 100%);
    border: 1px solid rgba(232, 121, 249, 0.4);
    border-radius: 12px;
    padding: 56px 36px;
    text-align: center;
    box-shadow: 0 20px 45px -10px rgba(0,0,0,0.8);
  }
  .d2c-gpromo-title { font-size: clamp(26px, 3.5vw, 40px); font-weight: 900; color: #ffffff; letter-spacing: -0.5px; margin: 10px 0 14px; text-transform: uppercase; }
  .d2c-gpromo-desc { font-size: 15px; color: #f5d0fe; max-width: 600px; margin: 0 auto 28px; line-height: 1.6; }
  .d2c-gpromo-code { background: rgba(232, 121, 249, 0.2); color: #e879f9; padding: 3px 8px; border-radius: 4px; font-weight: 900; font-family: monospace; }
  .d2c-gpromo-btn {
    display: inline-block;
    background: linear-gradient(135deg, #e879f9 0%, #ec4899 100%);
    color: #ffffff;
    padding: 14px 32px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
  }
  .d2c-gpromo-btn:hover { opacity: 0.9; }
</style>

{% schema %}
{
  "name": "Glam Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "BUY ANY 2 LIPSTICKS & GET FREE VELVET CLUTCH"
    }
  ],
  "presets": [
    {
      "name": "Glam Promo Banner"
    }
  ]
}
{% endschema %}
