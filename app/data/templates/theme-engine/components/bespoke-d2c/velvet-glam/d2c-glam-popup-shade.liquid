{% comment %}
  D2C Velvet Glam Virtual Shade Match Popup
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<div class="d2c-glam-popup" id="d2c-gpop-{{ section.id }}" style="display: none;">
  <div class="d2c-gpop-overlay">
    <div class="d2c-gpop-card">
      <button class="d2c-gpop-close" onclick="document.getElementById('d2c-gpop-{{ section.id }}').style.display='none';">&times;</button>
      <span class="d2c-g-badge" style="color: #e879f9;">AI BEAUTY MATCHER</span>
      <h3 class="d2c-gpop-title">FIND YOUR EXACT LIP & FOUNDATION SHADE</h3>
      <p class="d2c-gpop-desc">Take the 30-second undertone test to get your tailored cosmetic profile + Flat ₹200 Off your first order.</p>

      <form class="d2c-gpop-form">
        <input type="text" placeholder="Your Name" class="d2c-gpop-input" required />
        <input type="email" placeholder="Your Email Address" class="d2c-gpop-input" required />
        <input type="tel" placeholder="WhatsApp Number for Instant Shade Chart" class="d2c-gpop-input" required />
        <button type="submit" class="d2c-gpop-btn">UNLOCK MY SHADE MATCH & ₹200 OFF &rarr;</button>
      </form>
    </div>
  </div>
</div>

<style>
  .d2c-gpop-overlay {
    position: fixed;
    inset: 0;
    background: rgba(18, 4, 16, 0.85);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-gpop-card {
    background: #1e091b;
    border-radius: 12px;
    padding: 44px 32px;
    max-width: 440px;
    width: 100%;
    text-align: center;
    position: relative;
    border: 2px solid #e879f9;
    box-shadow: 0 20px 45px -10px rgba(0,0,0,0.9);
  }
  .d2c-gpop-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: #f5d0fe;
    font-size: 22px;
    cursor: pointer;
  }
  .d2c-gpop-title { font-size: 18px; font-weight: 900; color: #ffffff; margin: 8px 0 10px; text-transform: uppercase; }
  .d2c-gpop-desc { font-size: 14px; color: #f5d0fe; margin-bottom: 22px; }
  .d2c-gpop-form { display: flex; flex-direction: column; gap: 10px; }
  .d2c-gpop-input {
    background: #120410;
    border: 1px solid rgba(232, 121, 249, 0.3);
    padding: 12px 16px;
    border-radius: 4px;
    font-size: 14px;
    color: #ffffff;
    outline: none;
  }
  .d2c-gpop-input:focus { border-color: #e879f9; }
  .d2c-gpop-btn {
    background: linear-gradient(135deg, #e879f9 0%, #ec4899 100%);
    color: #ffffff;
    border: none;
    padding: 14px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    text-transform: uppercase;
    margin-top: 6px;
  }
</style>

{% schema %}
{
  "name": "Glam Shade Popup",
  "settings": [],
  "presets": [
    {
      "name": "Glam Shade Popup"
    }
  ]
}
{% endschema %}
