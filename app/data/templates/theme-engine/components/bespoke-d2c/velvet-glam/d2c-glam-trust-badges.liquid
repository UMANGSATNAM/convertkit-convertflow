{% comment %}
  D2C Velvet Glam Trust Badges
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-trust" id="d2c-gtrust-{{ section.id }}">
  <div class="d2c-gtrust-container">
    <div class="d2c-gtrust-grid">
      <div class="d2c-gtrust-item">
        <div class="d2c-gtrust-icon">🐰</div>
        <h4 class="d2c-gtrust-title">100% CRUELTY FREE</h4>
        <p class="d2c-gtrust-desc">Certified by PETA. Never tested on animals, 100% vegetarian formulations.</p>
      </div>

      <div class="d2c-gtrust-item">
        <div class="d2c-gtrust-icon">🛡️</div>
        <h4 class="d2c-gtrust-title">0% PARABENS & TOXIC LEAD</h4>
        <p class="d2c-gtrust-desc">Tested for heavy metals and dermatologically verified for zero skin irritation.</p>
      </div>

      <div class="d2c-gtrust-item">
        <div class="d2c-gtrust-icon">🚚</div>
        <h4 class="d2c-gtrust-title">FREE CASH ON DELIVERY</h4>
        <p class="d2c-gtrust-desc">Doorstep delivery across 24,000+ Indian pincodes with zero extra COD charges.</p>
      </div>

      <div class="d2c-gtrust-item">
        <div class="d2c-gtrust-icon">💄</div>
        <h4 class="d2c-gtrust-title">100% SHADE MATCH GUARANTEE</h4>
        <p class="d2c-gtrust-desc">Not your exact shade match? Instant doorstep exchange within 15 days.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-gtrust-{{ section.id }} {
    background: #120410;
    color: #ffffff;
    padding: 50px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-gtrust-container { max-width: 1360px; margin: 0 auto; }
  .d2c-gtrust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }
  .d2c-gtrust-item {
    background: #1e091b;
    border: 1px solid rgba(232, 121, 249, 0.2);
    border-radius: 8px;
    padding: 28px 18px;
  }
  .d2c-gtrust-icon { font-size: 26px; margin-bottom: 10px; }
  .d2c-gtrust-title { font-size: 12px; font-weight: 900; color: #e879f9; letter-spacing: 0.5px; margin-bottom: 6px; text-transform: uppercase; }
  .d2c-gtrust-desc { font-size: 12px; color: #f5d0fe; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-gtrust-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-gtrust-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Glam Trust Badges",
  "settings": [],
  "presets": [
    {
      "name": "Glam Trust Badges"
    }
  ]
}
{% endschema %}
