{% comment %}
  D2C Velvet Glam 24HR Stress Test Reels
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-reels" id="d2c-greels-{{ section.id }}">
  <div class="d2c-greels-container">
    <div class="d2c-gsec-header">
      <span class="d2c-g-badge">LIVE WEAR TESTS</span>
      <h2 class="d2c-g-title">{{ section.settings.title | default: "WATCH THE 24HR TRANSFER-TEST" }}</h2>
    </div>

    <div class="d2c-greels-grid">
      <div class="d2c-greel-card">
        <img src="https://images.unsplash.com/photo-1586495777744-4413f21062fa?w=600&q=80" alt="Lipstick Test" />
        <div class="d2c-greel-overlay">
          <span class="d2c-greel-tag">HOT COFFEE & MASK TEST</span>
          <h4 class="d2c-greel-name">Zero Lip Transfer After 12 Hours</h4>
          <span class="d2c-greel-pill">Matte Crayon · ₹849</span>
        </div>
      </div>

      <div class="d2c-greel-card">
        <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=600&q=80" alt="Foundation Test" />
        <div class="d2c-greel-overlay">
          <span class="d2c-greel-tag">HUMIDITY & SWEAT PROOF</span>
          <h4 class="d2c-greel-name">Full Sangeet Dance Night Stress-Test</h4>
          <span class="d2c-greel-pill">HD Foundation · ₹1,199</span>
        </div>
      </div>

      <div class="d2c-greel-card">
        <img src="https://images.unsplash.com/photo-1596704017254-9b121068fb31?w=600&q=80" alt="Eyeliner Test" />
        <div class="d2c-greel-overlay">
          <span class="d2c-greel-tag">WATERPROOF RUB TEST</span>
          <h4 class="d2c-greel-name">Zero Smudge Under Heavy Water Splash</h4>
          <span class="d2c-greel-pill">Gel Eyeliner · ₹649</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-greels-{{ section.id }} {
    background: #180816;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-greels-container { max-width: 1360px; margin: 0 auto; }
  .d2c-greels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .d2c-greel-card {
    position: relative;
    aspect-ratio: 9/16;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(232, 121, 249, 0.3);
    cursor: pointer;
  }
  .d2c-greel-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .d2c-greel-card:hover img { transform: scale(1.05); }
  .d2c-greel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(24,8,22,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: #ffffff;
  }
  .d2c-greel-tag { font-size: 10px; font-weight: 800; color: #f472b6; letter-spacing: 1px; margin-bottom: 4px; }
  .d2c-greel-name { font-size: 15px; font-weight: 800; margin-bottom: 12px; }
  .d2c-greel-pill {
    background: #ffffff;
    color: #120410;
    font-size: 11px;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: 4px;
    display: inline-block;
    align-self: flex-start;
  }

  @media (max-width: 900px) { .d2c-greels-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Glam Reels",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "WATCH THE 24HR TRANSFER-TEST"
    }
  ],
  "presets": [
    {
      "name": "Glam Reels"
    }
  ]
}
{% endschema %}
