{% comment %}
  D2C Velvet Glam Beauty FAQ
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-faq" id="d2c-gfaq-{{ section.id }}">
  <div class="d2c-gfaq-container">
    <div class="d2c-gsec-header">
      <span class="d2c-g-badge">QUESTIONS & ANSWERS</span>
      <h2 class="d2c-g-title">{{ section.settings.title | default: "FREQUENTLY ASKED BEAUTY QUESTIONS" }}</h2>
    </div>

    <div class="d2c-gfaq-list">
      <details class="d2c-gfaq-item" open>
        <summary class="d2c-gfaq-q">
          <span>How do I remove 24HR waterproof matte lipstick & eyeliner?</span>
          <span class="d2c-gfaq-icon">+</span>
        </summary>
        <div class="d2c-gfaq-a">
          Because our formulas are 100% waterproof and transferproof, use an oil-based micellar cleanser or cleansing balm. Gently massage for 15 seconds to dissolve the micro-flex film without tugging.
        </div>
      </details>

      <details class="d2c-gfaq-item">
        <summary class="d2c-gfaq-q">
          <span>How do I find my exact HD Foundation shade match online?</span>
          <span class="d2c-gfaq-icon">+</span>
        </summary>
        <div class="d2c-gfaq-a">
          Use our AI Shade Finder tool in the header or chat with our beauty advisors on WhatsApp. If your delivered shade isn't an exact match, we offer free doorstep replacement within 15 days.
        </div>
      </details>

      <details class="d2c-gfaq-item">
        <summary class="d2c-gfaq-q">
          <span>Does the lip crayon dry out or settle into fine lip lines?</span>
          <span class="d2c-gfaq-icon">+</span>
        </summary>
        <div class="d2c-gfaq-a">
          Not at all. Our Matte As Hell lip crayons are enriched with avocado oil and Vitamin E to nourish lips while maintaining an ultra-matte, velvety finish throughout the day.
        </div>
      </details>

      <details class="d2c-gfaq-item">
        <summary class="d2c-gfaq-q">
          <span>Is Cash on Delivery (COD) available with open box verification?</span>
          <span class="d2c-gfaq-icon">+</span>
        </summary>
        <div class="d2c-gfaq-a">
          Yes! We offer 100% free Cash on Delivery across all 24,000+ Indian pincodes without any minimum order value or handling surcharge.
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  #d2c-gfaq-{{ section.id }} {
    background: #120410;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-gfaq-container { max-width: 860px; margin: 0 auto; }
  .d2c-gfaq-list { display: flex; flex-direction: column; gap: 12px; margin-top: 36px; }
  .d2c-gfaq-item {
    background: #1e091b;
    border: 1px solid rgba(232, 121, 249, 0.25);
    border-radius: 8px;
    overflow: hidden;
  }
  .d2c-gfaq-q {
    padding: 20px 24px;
    font-size: 15px;
    font-weight: 800;
    color: #ffffff;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }
  .d2c-gfaq-q::-webkit-details-marker { display: none; }
  .d2c-gfaq-icon { font-size: 20px; font-weight: 800; color: #e879f9; }
  details[open] .d2c-gfaq-icon { transform: rotate(45deg); display: inline-block; }
  .d2c-gfaq-a {
    padding: 0 24px 20px;
    font-size: 14px;
    color: #f5d0fe;
    line-height: 1.6;
  }
</style>

{% schema %}
{
  "name": "Glam FAQ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FREQUENTLY ASKED BEAUTY QUESTIONS"
    }
  ],
  "presets": [
    {
      "name": "Glam FAQ"
    }
  ]
}
{% endschema %}
