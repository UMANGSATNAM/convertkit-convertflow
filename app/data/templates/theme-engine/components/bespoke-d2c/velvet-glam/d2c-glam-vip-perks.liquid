{% comment %}
  D2C Velvet Glam VIP Club
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-vip" id="d2c-gvip-{{ section.id }}">
  <div class="d2c-gvip-container">
    <div class="d2c-gvip-box">
      <div class="d2c-gsec-header">
        <span class="d2c-g-badge">GLAM INSIDER CLUB</span>
        <h2 class="d2c-g-title">{{ section.settings.title | default: "JOIN THE GLAM CIRCLE" }}</h2>
        <p class="d2c-gvip-desc">Earn points on every purchase, unlock celebrity MUA masterclasses, and receive limited-edition anniversary vaults.</p>
      </div>

      <div class="d2c-gvip-grid">
        <div class="d2c-gvip-card">
          <div class="d2c-gv-tag">TIER 1 // GLAM PASSION</div>
          <div class="d2c-gv-title">10% OFF AUTO-REFILLS</div>
          <p class="d2c-gv-desc">Save on your holy grail lipsticks, kajals, and foundation refills plus birthday gifts.</p>
        </div>

        <div class="d2c-gvip-card popular">
          <span class="d2c-gv-pill">EXCLUSIVE</span>
          <div class="d2c-gv-tag">TIER 2 // GLAM STAR</div>
          <div class="d2c-gv-title">FREE MUA MASTERCLASSES</div>
          <p class="d2c-gv-desc">Monthly live 1-on-1 virtual bridal masterclasses with leading Bollywood makeup artists.</p>
        </div>

        <div class="d2c-gvip-card">
          <div class="d2c-gv-tag">TIER 3 // GLAM QUEEN</div>
          <div class="d2c-gv-title">VIP VAULT ACCESS</div>
          <p class="d2c-gv-desc">Early access to limited holiday beauty vaults 48 hours prior to public release.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-gvip-{{ section.id }} {
    background: #180816;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-gvip-container { max-width: 1360px; margin: 0 auto; }
  .d2c-gvip-box {
    background: #1e091b;
    border-radius: 12px;
    padding: 48px 36px;
    border: 1px solid rgba(232, 121, 249, 0.3);
  }
  .d2c-gvip-desc { font-size: 15px; color: #f5d0fe; max-width: 540px; margin: 8px auto 0; text-align: center; }
  .d2c-gvip-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .d2c-gvip-card {
    background: #120410;
    border: 1px solid rgba(232, 121, 249, 0.25);
    border-radius: 8px;
    padding: 32px 24px;
    text-align: center;
    position: relative;
  }
  .d2c-gvip-card.popular { border: 2px solid #e879f9; }
  .d2c-gv-pill {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #e879f9 0%, #ec4899 100%);
    color: #ffffff;
    font-size: 9px;
    font-weight: 900;
    padding: 3px 10px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }
  .d2c-gv-tag { font-size: 10px; font-weight: 800; color: #f472b6; letter-spacing: 1px; margin-bottom: 8px; }
  .d2c-gv-title { font-size: 14px; font-weight: 900; color: #ffffff; margin-bottom: 10px; }
  .d2c-gv-desc { font-size: 13px; color: #f5d0fe; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-gvip-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Glam VIP Perks",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "JOIN THE GLAM CIRCLE"
    }
  ],
  "presets": [
    {
      "name": "Glam VIP Perks"
    }
  ]
}
{% endschema %}
