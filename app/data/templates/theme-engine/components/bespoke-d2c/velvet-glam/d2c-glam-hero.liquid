{% comment %}
  D2C Velvet Glam Red Carpet Split Hero
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-hero" id="d2c-ghero-{{ section.id }}">
  <div class="d2c-ghero-container">
    <div class="d2c-ghero-grid">
      <div class="d2c-ghero-text">
        <span class="d2c-ghero-badge">💎 24HR WEAR • ZERO TRANSFER</span>
        <h1 class="d2c-ghero-title">{{ section.settings.heading | default: "INTENSE VELVET PIGMENTS THAT NEVER BUDGE" }}</h1>
        <p class="d2c-ghero-desc">
          Enriched with Marula Oil and Vitamin E for weightless 24-hour hydration. 100% waterproof, mask-proof, and kiss-proof formula designed for Indian festive heat and humidity.
        </p>

        <div class="d2c-ghero-actions">
          <a href="/collections/all" class="d2c-gbtn-primary">EXPLORE 36 SHADES &rarr;</a>
          <a href="/pages/shade-finder" class="d2c-gbtn-secondary">FIND MY UNDERTONE MATCH</a>
        </div>

        <div class="d2c-ghero-specs">
          <div class="d2c-gspec"><strong>24HR</strong> <span>Wear Tested</span></div>
          <div class="d2c-gspec"><strong>100%</strong> <span>Transferproof</span></div>
          <div class="d2c-gspec"><strong>36</strong> <span>Indian Undertones</span></div>
        </div>
      </div>

      <div class="d2c-ghero-media">
        <div class="d2c-ghero-frame">
          <img src="https://images.unsplash.com/photo-1586495777744-4413f21062fa?w=900&q=85" alt="Velvet Matte Lipstick" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-ghero-{{ section.id }} {
    background: #180816;
    color: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-ghero-container { max-width: 1360px; margin: 0 auto; }
  .d2c-ghero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }
  .d2c-ghero-badge {
    font-size: 11px;
    font-weight: 800;
    color: #e879f9;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 16px;
    display: block;
  }
  .d2c-ghero-title {
    font-size: clamp(34px, 4vw, 50px);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.1;
    letter-spacing: -0.5px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }
  .d2c-ghero-desc {
    font-size: 16px;
    color: #f5d0fe;
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 540px;
  }
  .d2c-ghero-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }
  .d2c-gbtn-primary {
    background: linear-gradient(135deg, #e879f9 0%, #ec4899 100%);
    color: #ffffff;
    padding: 16px 32px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
  }
  .d2c-gbtn-secondary {
    background: transparent;
    border: 1px solid #e879f9;
    color: #e879f9;
    padding: 16px 28px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
  }
  .d2c-ghero-specs {
    display: flex;
    gap: 36px;
    border-top: 1px solid rgba(232, 121, 249, 0.2);
    padding-top: 24px;
  }
  .d2c-gspec strong { font-size: 22px; font-weight: 900; color: #e879f9; display: block; }
  .d2c-gspec span { font-size: 12px; color: #f5d0fe; }
  .d2c-ghero-frame {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(232, 121, 249, 0.4);
    box-shadow: 0 20px 45px -10px rgba(0,0,0,0.8);
  }
  .d2c-ghero-frame img { width: 100%; height: 500px; object-fit: cover; }

  @media (max-width: 900px) {
    .d2c-ghero-grid { grid-template-columns: 1fr; }
    .d2c-ghero-frame img { height: 360px; }
    #d2c-ghero-{{ section.id }} { padding: 40px 18px; }
  }
</style>

{% schema %}
{
  "name": "Glam Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "INTENSE VELVET PIGMENTS THAT NEVER BUDGE"
    }
  ],
  "presets": [
    {
      "name": "Glam Hero"
    }
  ]
}
{% endschema %}
