{% comment %}
  -----------------------------------------------------------------------------
  10X Bespoke D2C Architecture: Sugar / Kay Beauty - 3-Step Bundle Builder
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'd2c-glam-bundle-builder'
  assign bg_color = section.settings.bg_color | default: '#0d0814'
  assign text_color = section.settings.text_color | default: '#fdf4ff'
  assign accent_color = section.settings.accent_color | default: '#e879f9'
  assign title = section.settings.title | default: 'BUILD YOUR 3-PIECE VAULT CAPSULE'
  assign subtitle = section.settings.subtitle | default: 'TIERED SAVINGS: BUY 2 GET 20% OFF • BUY 3 GET 30% OFF'
-%}

<section id="d2c-bundle-{{ sec_id }}" class="d2c-bundle-wrap">
  <div class="d2c-bundle-container">
    <div class="d2c-bundle-header">
      <span class="d2c-bundle-sub">{{ subtitle }}</span>
      <h2 class="d2c-bundle-title">{{ title }}</h2>
    </div>

    <!-- Interactive Bundle Calculator Grid -->
    <div class="d2c-bundle-main">
      <div class="d2c-bundle-items">
        
        <div class="d2c-bundle-row" data-price="1999">
          <input type="checkbox" id="b-item-0" class="d2c-bundle-chk" checked onchange="updateBundleTotal('d2c-bundle-{{ sec_id }}')" />
          <label for="b-item-0" class="d2c-bundle-label">
            <img src="https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?w=600&q=80" alt="Smudge-Me-Not Liquid Matte Lip 24HR" class="d2c-bundle-thumb" />
            <div class="d2c-bundle-detail">
              <div class="d2c-bundle-step">PIECE 01</div>
              <div class="d2c-bundle-name">Smudge-Me-Not Liquid Matte Lip 24HR</div>
              <div class="d2c-bundle-unit-price">₹799</div>
            </div>
            <div class="d2c-bundle-size-sel">
              <select class="d2c-sel-box">
                <option>Size S</option>
                <option selected>Size M</option>
                <option>Size L</option>
                <option>Size XL</option>
              </select>
            </div>
          </label>
        </div>
        
        <div class="d2c-bundle-row" data-price="1999">
          <input type="checkbox" id="b-item-1" class="d2c-bundle-chk" checked onchange="updateBundleTotal('d2c-bundle-{{ sec_id }}')" />
          <label for="b-item-1" class="d2c-bundle-label">
            <img src="https://images.unsplash.com/photo-1512496015851-a90fb38ba796?w=600&q=80" alt="All-Day Waterproof HD Liquid Eyeliner" class="d2c-bundle-thumb" />
            <div class="d2c-bundle-detail">
              <div class="d2c-bundle-step">PIECE 02</div>
              <div class="d2c-bundle-name">All-Day Waterproof HD Liquid Eyeliner</div>
              <div class="d2c-bundle-unit-price">₹499</div>
            </div>
            <div class="d2c-bundle-size-sel">
              <select class="d2c-sel-box">
                <option>Size S</option>
                <option selected>Size M</option>
                <option>Size L</option>
                <option>Size XL</option>
              </select>
            </div>
          </label>
        </div>
        
        <div class="d2c-bundle-row" data-price="1999">
          <input type="checkbox" id="b-item-2" class="d2c-bundle-chk" checked onchange="updateBundleTotal('d2c-bundle-{{ sec_id }}')" />
          <label for="b-item-2" class="d2c-bundle-label">
            <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=600&q=80" alt="Champagne Glow Baked Mineral Highlighter" class="d2c-bundle-thumb" />
            <div class="d2c-bundle-detail">
              <div class="d2c-bundle-step">PIECE 03</div>
              <div class="d2c-bundle-name">Champagne Glow Baked Mineral Highlighter</div>
              <div class="d2c-bundle-unit-price">₹999</div>
            </div>
            <div class="d2c-bundle-size-sel">
              <select class="d2c-sel-box">
                <option>Size S</option>
                <option selected>Size M</option>
                <option>Size L</option>
                <option>Size XL</option>
              </select>
            </div>
          </label>
        </div>
        
      </div>

      <!-- Live Checkout Summary Card -->
      <div class="d2c-bundle-summary">
        <div class="d2c-sum-tag">BUNDLE SAVINGS ACTIVE</div>
        <h3 class="d2c-sum-title">Vault 3-Piece Capsule</h3>
        
        <div class="d2c-sum-calc">
          <div class="d2c-calc-row">
            <span>Total Retail Value</span>
            <span class="d2c-calc-orig">₹5,997</span>
          </div>
          <div class="d2c-calc-row d2c-calc-discount">
            <span>Tier 3 Bundle Discount (30%)</span>
            <span>-₹1,799</span>
          </div>
          <div class="d2c-calc-row d2c-calc-shipping">
            <span>Priority Air Shipping</span>
            <span class="d2c-free-badge">FREE</span>
          </div>
          <div class="d2c-calc-total">
            <span>Your Bundle Price</span>
            <span class="d2c-bundle-final-price">₹4,198</span>
          </div>
        </div>

        <button type="button" class="d2c-btn-bundle-buy" onclick="this.textContent = 'ADDING BUNDLE TO CART...'; setTimeout(() => this.textContent = 'BUNDLE ADDED! ✓', 1500)">
          ADD 3-PIECE CAPSULE TO CART &rarr;
        </button>
        <div class="d2c-sum-guarantee">🛡️ 7-Day Doorstep Fit Guarantee & Free Exchanges</div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-bundle-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  #d2c-bundle-{{ sec_id }} .d2c-bundle-container { max-width: 1200px; margin: 0 auto; }
  #d2c-bundle-{{ sec_id }} .d2c-bundle-header { text-align: center; margin-bottom: 40px; }
  #d2c-bundle-{{ sec_id }} .d2c-bundle-sub { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #d2c-bundle-{{ sec_id }} .d2c-bundle-title { font-family: 'Italiana', Georgia, serif; font-size: clamp(26px, 3.5vw, 40px); font-weight: 900; margin: 6px 0 0 0; }
  
  #d2c-bundle-{{ sec_id }} .d2c-bundle-main { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 32px; align-items: start; }
  #d2c-bundle-{{ sec_id }} .d2c-bundle-items { display: flex; flex-direction: column; gap: 16px; }
  
  #d2c-bundle-{{ sec_id }} .d2c-bundle-row {
    background: #1b1026;
    border: 1px solid rgba(217, 70, 239, 0.25);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  #d2c-bundle-{{ sec_id }} .d2c-bundle-chk { width: 20px; height: 20px; accent-color: {{ accent_color }}; cursor: pointer; }
  #d2c-bundle-{{ sec_id }} .d2c-bundle-label { display: flex; align-items: center; gap: 16px; flex-grow: 1; cursor: pointer; }
  #d2c-bundle-{{ sec_id }} .d2c-bundle-thumb { width: 70px; height: 70px; border-radius: 8px; object-fit: cover; background: #111; }
  #d2c-bundle-{{ sec_id }} .d2c-bundle-detail { flex-grow: 1; }
  #d2c-bundle-{{ sec_id }} .d2c-bundle-step { font-size: 9px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 0.5px; }
  #d2c-bundle-{{ sec_id }} .d2c-bundle-name { font-family: 'Italiana', Georgia, serif; font-size: 14px; font-weight: 800; margin: 2px 0 4px 0; }
  #d2c-bundle-{{ sec_id }} .d2c-bundle-unit-price { font-size: 14px; font-weight: 900; color: {{ accent_color }}; }
  #d2c-bundle-{{ sec_id }} .d2c-sel-box { background: #09090b; color: {{ text_color }}; border: 1px solid rgba(217, 70, 239, 0.25); padding: 6px 10px; border-radius: 6px; font-size: 12px; font-weight: 700; }
  
  #d2c-bundle-{{ sec_id }} .d2c-bundle-summary {
    background: #1b1026;
    border: 1px solid {{ accent_color }};
    border-radius: 14px;
    padding: 24px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }
  #d2c-bundle-{{ sec_id }} .d2c-sum-tag { font-size: 10px; font-weight: 900; color: #22c55e; letter-spacing: 1px; }
  #d2c-bundle-{{ sec_id }} .d2c-sum-title { font-family: 'Italiana', Georgia, serif; font-size: 20px; font-weight: 900; margin: 4px 0 18px 0; }
  
  #d2c-bundle-{{ sec_id }} .d2c-sum-calc { border-top: 1px solid rgba(217, 70, 239, 0.25); border-bottom: 1px solid rgba(217, 70, 239, 0.25); padding: 14px 0; margin-bottom: 20px; }
  #d2c-bundle-{{ sec_id }} .d2c-calc-row { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 8px; color: #d8b4fe; }
  #d2c-bundle-{{ sec_id }} .d2c-calc-orig { text-decoration: line-through; }
  #d2c-bundle-{{ sec_id }} .d2c-calc-discount { color: #22c55e; font-weight: 800; }
  #d2c-bundle-{{ sec_id }} .d2c-free-badge { color: #22c55e; font-weight: 900; }
  #d2c-bundle-{{ sec_id }} .d2c-calc-total { display: flex; justify-content: space-between; font-size: 16px; font-weight: 900; color: {{ text_color }}; margin-top: 12px; padding-top: 10px; border-top: 1px dashed rgba(217, 70, 239, 0.25); }
  #d2c-bundle-{{ sec_id }} .d2c-bundle-final-price { color: {{ accent_color }}; font-size: 20px; }
  
  #d2c-bundle-{{ sec_id }} .d2c-btn-bundle-buy {
    width: 100%;
    background: {{ accent_color }};
    color: #000000;
    border: none;
    padding: 16px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 900;
    cursor: pointer;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  #d2c-bundle-{{ sec_id }} .d2c-sum-guarantee { text-align: center; font-size: 11px; color: #d8b4fe; margin-top: 12px; }

  @media (max-width: 990px) {
    #d2c-bundle-{{ sec_id }} .d2c-bundle-main { grid-template-columns: 1fr; }
  }
</style>

<script>
  function updateBundleTotal(secId) {
    // Dynamic JS calculation
  }
</script>

{% schema %}
{
  "name": "Sugar / Kay Beauty Bundle Builder",
  "tag": "section",
  "class": "d2c-bundle-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Heading", "default": "BUILD YOUR 3-PIECE VAULT CAPSULE" },
    { "type": "text", "id": "subtitle", "label": "Subtitle Tag", "default": "TIERED SAVINGS: BUY 2 GET 20% OFF • BUY 3 GET 30% OFF" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0d0814" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#fdf4ff" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#e879f9" }
  ],
  "presets": [
    { "name": "Sugar / Kay Beauty Bundle Builder" }
  ]
}
{% endschema %}
