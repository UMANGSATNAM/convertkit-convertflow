{% comment %}
  D2C Velvet Glam 3-Piece Red Carpet Box
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-bundle" id="d2c-gbundle-{{ section.id }}">
  <div class="d2c-gbundle-container">
    <div class="d2c-gbundle-box">
      <div class="d2c-gbundle-info">
        <span class="d2c-g-badge">CUSTOM GLAM BOX & SAVE</span>
        <h2 class="d2c-gbundle-title">{{ section.settings.title | default: "THE RED CARPET ESSENTIALS SUITE" }}</h2>
        <p class="d2c-gbundle-desc">
          Build your custom bridal & party makeup combo: 1 Matte Lip Crayon, 1 HD Stick Foundation, and 1 Gel Eyeliner. Includes a free velvet makeup pouch and sharpener.
        </p>
        <div class="d2c-gbundle-price">BUNDLE PRICE: ₹2,199 <span class="d2c-gb-orig">₹2,847</span> <span class="d2c-gb-save">SAVE ₹648</span></div>
        <button class="d2c-gb-btn">BUILD YOUR CUSTOM GLAM BOX &rarr;</button>
      </div>

      <div class="d2c-gbundle-visual">
        <div class="d2c-gbi-card">
          <img src="https://images.unsplash.com/photo-1586495777744-4413f21062fa?w=400&q=80" alt="Lip Crayon" />
          <span>Lip Crayon</span>
        </div>
        <span class="d2c-gbi-plus">+</span>
        <div class="d2c-gbi-card">
          <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=400&q=80" alt="HD Foundation" />
          <span>HD Foundation</span>
        </div>
        <span class="d2c-gbi-plus">+</span>
        <div class="d2c-gbi-card">
          <img src="https://images.unsplash.com/photo-1596704017254-9b121068fb31?w=400&q=80" alt="Gel Eyeliner" />
          <span>Gel Eyeliner</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-gbundle-{{ section.id }} {
    background: #180816;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-gbundle-container { max-width: 1360px; margin: 0 auto; }
  .d2c-gbundle-box {
    background: #1e091b;
    border-radius: 12px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    border: 1px solid rgba(232, 121, 249, 0.3);
  }
  .d2c-gbundle-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #ffffff; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-gbundle-desc { font-size: 15px; color: #f5d0fe; line-height: 1.6; margin-bottom: 24px; }
  .d2c-gbundle-price { font-size: 20px; font-weight: 900; color: #ffffff; margin-bottom: 28px; }
  .d2c-gb-orig { font-size: 14px; color: #a1a1aa; text-decoration: line-through; margin-left: 6px; }
  .d2c-gb-save { background: rgba(232, 121, 249, 0.2); color: #e879f9; font-size: 11px; font-weight: 800; padding: 4px 8px; border-radius: 4px; margin-left: 8px; border: 1px solid #e879f9; }
  .d2c-gb-btn {
    background: linear-gradient(135deg, #e879f9 0%, #ec4899 100%);
    color: #ffffff;
    border: none;
    padding: 16px 32px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-gbundle-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .d2c-gbi-card {
    background: #120410;
    border: 1px solid rgba(232, 121, 249, 0.25);
    border-radius: 8px;
    overflow: hidden;
    text-align: center;
    padding: 8px;
    width: 120px;
  }
  .d2c-gbi-card img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; margin-bottom: 6px; }
  .d2c-gbi-card span { font-size: 10px; font-weight: 800; color: #ffffff; }
  .d2c-gbi-plus { font-size: 20px; font-weight: 800; color: #e879f9; }

  @media (max-width: 900px) {
    .d2c-gbundle-box { grid-template-columns: 1fr; padding: 24px; }
  }
</style>

{% schema %}
{
  "name": "Glam Bundle Box",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE RED CARPET ESSENTIALS SUITE"
    }
  ],
  "presets": [
    {
      "name": "Glam Bundle Box"
    }
  ]
}
{% endschema %}
