{% comment %}
  D2C Velvet Glam Bestsellers with Shade Swatches
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-best" id="d2c-gbest-{{ section.id }}">
  <div class="d2c-gbest-container">
    <div class="d2c-gsec-header">
      <span class="d2c-g-badge">RED CARPET FAVORITES</span>
      <h2 class="d2c-g-title">{{ section.settings.title | default: "ICONIC 24HR GLAM FORMULAS" }}</h2>
    </div>

    <div class="d2c-gprod-grid">
      <!-- Item 1 -->
      <div class="d2c-gprod-card">
        <div class="d2c-gprod-thumb">
          <span class="d2c-gprod-pill">24HR WATERPROOF</span>
          <img src="https://images.unsplash.com/photo-1586495777744-4413f21062fa?w=600&q=80" alt="Matte As Hell Crayon Lipstick" />
        </div>
        <div class="d2c-gprod-body">
          <span class="d2c-gprod-shade">SHADE: 01 SCARLETT O'HARA</span>
          <h3 class="d2c-gprod-title">Matte As Hell Lip Crayon</h3>
          <div class="d2c-gprod-swatches">
            <span class="d2c-gswatch active" style="background: #991b1b;"></span>
            <span class="d2c-gswatch" style="background: #831843;"></span>
            <span class="d2c-gswatch" style="background: #9f1239;"></span>
            <span class="d2c-gswatch" style="background: #be123c;"></span>
          </div>
          <div class="d2c-gprod-price">₹849 <span class="d2c-gprod-orig">₹999</span></div>
          <button class="d2c-gatc-btn">+ ADD TO BAG</button>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="d2c-gprod-card">
        <div class="d2c-gprod-thumb">
          <span class="d2c-gprod-pill">TRANSFERPROOF</span>
          <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=600&q=80" alt="HD Liquid Foundation" />
        </div>
        <div class="d2c-gprod-body">
          <span class="d2c-gprod-shade">SHADE: 120 WARM CARAMEL</span>
          <h3 class="d2c-gprod-title">Ace of Face HD Stick Foundation</h3>
          <div class="d2c-gprod-swatches">
            <span class="d2c-gswatch active" style="background: #d4a373;"></span>
            <span class="d2c-gswatch" style="background: #c58f5e;"></span>
            <span class="d2c-gswatch" style="background: #a97142;"></span>
          </div>
          <div class="d2c-gprod-price">₹1,199 <span class="d2c-gprod-orig">₹1,499</span></div>
          <button class="d2c-gatc-btn">+ ADD TO BAG</button>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="d2c-gprod-card">
        <div class="d2c-gprod-thumb">
          <span class="d2c-gprod-pill">36HR JET BLACK</span>
          <img src="https://images.unsplash.com/photo-1596704017254-9b121068fb31?w=600&q=80" alt="Gel Eyeliner" />
        </div>
        <div class="d2c-gprod-body">
          <span class="d2c-gprod-shade">SHADE: 01 CARBON BLACK</span>
          <h3 class="d2c-gprod-title">Born To Wing Gel Eyeliner</h3>
          <div class="d2c-gprod-swatches">
            <span class="d2c-gswatch active" style="background: #000000;"></span>
            <span class="d2c-gswatch" style="background: #312e81;"></span>
          </div>
          <div class="d2c-gprod-price">₹649 <span class="d2c-gprod-orig">₹799</span></div>
          <button class="d2c-gatc-btn">+ ADD TO BAG</button>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="d2c-gprod-card">
        <div class="d2c-gprod-thumb">
          <span class="d2c-gprod-pill">EAU DE PARFUM</span>
          <img src="https://images.unsplash.com/photo-1541643600914-78b084683601?w=600&q=80" alt="Velvet Perfume" />
        </div>
        <div class="d2c-gprod-body">
          <span class="d2c-gprod-shade">NOTES: ROSE VELOUR & OUD</span>
          <h3 class="d2c-gprod-title">Velvet Noir Eau De Parfum (100ml)</h3>
          <div class="d2c-gprod-swatches">
            <span class="d2c-gswatch active" style="background: #581c87;"></span>
          </div>
          <div class="d2c-gprod-price">₹1,899 <span class="d2c-gprod-orig">₹2,499</span></div>
          <button class="d2c-gatc-btn">+ ADD TO BAG</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-gbest-{{ section.id }} {
    background: #120410;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-gbest-container { max-width: 1360px; margin: 0 auto; }
  .d2c-gprod-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .d2c-gprod-card {
    background: #1e091b;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(232, 121, 249, 0.2);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .d2c-gprod-thumb { position: relative; aspect-ratio: 1; overflow: hidden; background: #2a0c26; }
  .d2c-gprod-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-gprod-pill {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #e879f9;
    color: #120410;
    font-size: 9px;
    font-weight: 900;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }
  .d2c-gprod-body { padding: 18px; display: flex; flex-direction: column; flex-grow: 1; justify-content: space-between; }
  .d2c-gprod-shade { font-size: 10px; font-weight: 800; color: #f472b6; letter-spacing: 0.5px; margin-bottom: 4px; }
  .d2c-gprod-title { font-size: 14px; font-weight: 800; color: #ffffff; margin-bottom: 10px; }
  .d2c-gprod-swatches { display: flex; gap: 6px; margin-bottom: 12px; }
  .d2c-gswatch { width: 16px; height: 16px; border-radius: 50%; display: inline-block; cursor: pointer; }
  .d2c-gswatch.active { outline: 2px solid #e879f9; outline-offset: 1px; }
  .d2c-gprod-price { font-size: 16px; font-weight: 900; color: #ffffff; margin-bottom: 14px; }
  .d2c-gprod-orig { font-size: 12px; color: #a1a1aa; text-decoration: line-through; margin-left: 6px; }
  .d2c-gatc-btn {
    width: 100%;
    background: linear-gradient(135deg, #e879f9 0%, #ec4899 100%);
    color: #ffffff;
    border: none;
    padding: 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-gatc-btn:hover { opacity: 0.9; }

  @media (max-width: 1024px) { .d2c-gprod-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-gprod-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } .d2c-gprod-body { padding: 12px; } }
</style>

{% schema %}
{
  "name": "Glam Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ICONIC 24HR GLAM FORMULAS"
    }
  ],
  "presets": [
    {
      "name": "Glam Bestsellers"
    }
  ]
}
{% endschema %}
