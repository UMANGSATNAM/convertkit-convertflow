{% comment %}
  D2C Velvet Glam Lipstick Spotlight
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-spotlight" id="d2c-gspot-{{ section.id }}">
  <div class="d2c-gspot-container">
    <div class="d2c-gspot-card">
      <div class="d2c-gspot-media">
        <img src="https://images.unsplash.com/photo-1586495777744-4413f21062fa?w=800&q=85" alt="Matte As Hell Crayon" />
      </div>

      <div class="d2c-gspot-content">
        <span class="d2c-g-badge">THE CULT CLASSIC</span>
        <h2 class="d2c-gspot-title">{{ section.settings.title | default: "MATTE AS HELL LIP CRAYON // 01 SCARLETT" }}</h2>
        <p class="d2c-gspot-desc">
          Single-stroke opaque coverage with an ultra-matte velvet finish. Infused with rich avocado oil and antioxidant Vitamin C. Comes with its own specially engineered German sharpener.
        </p>

        <div class="d2c-gspot-matrix">
          <div class="d2c-gm-item"><span>FORMULATION:</span> <strong>Weightless Velvet Matte</strong></div>
          <div class="d2c-gm-item"><span>WEAR DURATION:</span> <strong>24HR Waterproof Transferproof</strong></div>
          <div class="d2c-gm-item"><span>ORIGIN:</span> <strong>Formulated in Germany</strong></div>
        </div>

        <div class="d2c-gspot-price-row">
          <span class="d2c-gspot-price">₹849</span>
          <span class="d2c-gspot-orig">₹999</span>
          <span class="d2c-gspot-tag">BUY 2 GET FREE MATTE POUCH</span>
        </div>

        <button class="d2c-gspot-btn">⚡ 1-CLICK FREE COD CHECKOUT &rarr;</button>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-gspot-{{ section.id }} {
    background: #120410;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-gspot-container { max-width: 1360px; margin: 0 auto; }
  .d2c-gspot-card {
    background: #1e091b;
    border-radius: 12px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    align-items: center;
    border: 1px solid rgba(232, 121, 249, 0.25);
  }
  .d2c-gspot-media img { width: 100%; height: 460px; object-fit: cover; border-radius: 8px; }
  .d2c-gspot-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #ffffff; line-height: 1.15; margin: 10px 0 16px; text-transform: uppercase; }
  .d2c-gspot-desc { font-size: 15px; color: #f5d0fe; line-height: 1.6; margin-bottom: 24px; }
  .d2c-gspot-matrix {
    background: #120410;
    border-radius: 6px;
    padding: 16px 20px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 1px solid rgba(232, 121, 249, 0.15);
  }
  .d2c-gm-item { display: flex; justify-content: space-between; font-size: 12px; color: #f5d0fe; }
  .d2c-gm-item strong { color: #ffffff; }
  .d2c-gspot-price-row { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .d2c-gspot-price { font-size: 24px; font-weight: 900; color: #ffffff; }
  .d2c-gspot-orig { font-size: 14px; color: #a1a1aa; text-decoration: line-through; }
  .d2c-gspot-tag { background: rgba(232, 121, 249, 0.2); color: #e879f9; font-size: 10px; font-weight: 800; padding: 4px 8px; border-radius: 4px; border: 1px solid #e879f9; }
  .d2c-gspot-btn {
    width: 100%;
    background: linear-gradient(135deg, #e879f9 0%, #ec4899 100%);
    color: #ffffff;
    border: none;
    padding: 16px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .d2c-gspot-card { grid-template-columns: 1fr; padding: 24px; }
    .d2c-gspot-media img { height: 300px; }
  }
</style>

{% schema %}
{
  "name": "Glam Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "MATTE AS HELL LIP CRAYON // 01 SCARLETT"
    }
  ],
  "presets": [
    {
      "name": "Glam Spotlight"
    }
  ]
}
{% endschema %}
