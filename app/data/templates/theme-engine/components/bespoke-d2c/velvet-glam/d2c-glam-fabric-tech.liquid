{% comment %}
  -----------------------------------------------------------------------------
  10X Bespoke D2C Architecture: Sugar / Kay Beauty - Fabric & Technical Matrix
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'd2c-glam-fabric-tech'
  assign bg_color = section.settings.bg_color | default: '#1b1026'
  assign text_color = section.settings.text_color | default: '#fdf4ff'
  assign accent_color = section.settings.accent_color | default: '#e879f9'
  assign title = section.settings.title | default: 'MATERIAL & FABRIC SCIENCE'
  assign subtitle = section.settings.subtitle | default: 'BUILT TO OUTLAST 100+ WASHES'
-%}

<section id="d2c-tech-{{ sec_id }}" class="d2c-tech-wrap">
  <div class="d2c-tech-container">
    <div class="d2c-tech-header">
      <span class="d2c-tech-sub">{{ subtitle }}</span>
      <h2 class="d2c-tech-title">{{ title }}</h2>
    </div>

    <div class="d2c-tech-grid">
      
      <div class="d2c-tech-card">
        <div class="d2c-tech-icon">💋</div>
        <h3 class="d2c-tech-card-title">24-Hour Zero-Transfer Technology</h3>
        <p class="d2c-tech-desc">Locks in vibrant color that withstands coffee, dining, and humidity.</p>
        <div class="d2c-tech-badge">SPEC GRADE 01</div>
      </div>
      
      <div class="d2c-tech-card">
        <div class="d2c-tech-icon">🎨</div>
        <h3 class="d2c-tech-card-title">Ultra-Fine Micronized Pigments</h3>
        <p class="d2c-tech-desc">One-swipe intense color payoff with featherlight cloud-like comfort.</p>
        <div class="d2c-tech-badge">SPEC GRADE 02</div>
      </div>
      
      <div class="d2c-tech-card">
        <div class="d2c-tech-icon">🐰</div>
        <h3 class="d2c-tech-card-title">100% Cruelty-Free & Vegan</h3>
        <p class="d2c-tech-desc">PETA-certified cruelty-free with zero animal-derived ingredients.</p>
        <div class="d2c-tech-badge">SPEC GRADE 03</div>
      </div>
      
      <div class="d2c-tech-card">
        <div class="d2c-tech-icon">💧</div>
        <h3 class="d2c-tech-card-title">Infused with Vitamin E & Jojoba</h3>
        <p class="d2c-tech-desc">Hydrates and nourishes lips to eliminate dryness and cracking.</p>
        <div class="d2c-tech-badge">SPEC GRADE 04</div>
      </div>
      
    </div>
  </div>
</section>

<style>
  #d2c-tech-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    border-top: 1px solid rgba(217, 70, 239, 0.25);
    border-bottom: 1px solid rgba(217, 70, 239, 0.25);
  }
  #d2c-tech-{{ sec_id }} .d2c-tech-container { max-width: 1320px; margin: 0 auto; }
  #d2c-tech-{{ sec_id }} .d2c-tech-header { text-align: center; margin-bottom: 40px; }
  #d2c-tech-{{ sec_id }} .d2c-tech-sub { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #d2c-tech-{{ sec_id }} .d2c-tech-title { font-family: 'Italiana', Georgia, serif; font-size: clamp(26px, 3.5vw, 40px); font-weight: 900; margin: 6px 0 0 0; }

  #d2c-tech-{{ sec_id }} .d2c-tech-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  #d2c-tech-{{ sec_id }} .d2c-tech-card {
    background: #0d0814;
    border: 1px solid rgba(217, 70, 239, 0.25);
    border-radius: 14px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease;
  }
  #d2c-tech-{{ sec_id }} .d2c-tech-card:hover { transform: translateY(-4px); border-color: {{ accent_color }}; }
  #d2c-tech-{{ sec_id }} .d2c-tech-icon { font-size: 28px; margin-bottom: 14px; }
  #d2c-tech-{{ sec_id }} .d2c-tech-card-title { font-family: 'Italiana', Georgia, serif; font-size: 16px; font-weight: 800; margin: 0 0 8px 0; color: {{ text_color }}; }
  #d2c-tech-{{ sec_id }} .d2c-tech-desc { font-size: 13px; line-height: 1.6; color: #d8b4fe; margin: 0 0 16px 0; flex-grow: 1; }
  #d2c-tech-{{ sec_id }} .d2c-tech-badge { font-size: 9px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 0.5px; }

  @media (max-width: 990px) {
    #d2c-tech-{{ sec_id }} .d2c-tech-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    #d2c-tech-{{ sec_id }} .d2c-tech-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Sugar / Kay Beauty Material Science",
  "tag": "section",
  "class": "d2c-tech-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Title", "default": "MATERIAL & FABRIC SCIENCE" },
    { "type": "text", "id": "subtitle", "label": "Subtitle Tag", "default": "BUILT TO OUTLAST 100+ WASHES" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1b1026" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#fdf4ff" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#e879f9" }
  ],
  "presets": [
    { "name": "Sugar / Kay Beauty Material Science" }
  ]
}
{% endschema %}
