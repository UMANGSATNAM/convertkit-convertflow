{% comment %}
  D2C Velvet Glam Performance Matrix
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-matrix" id="d2c-gmat-{{ section.id }}">
  <div class="d2c-gmat-container">
    <div class="d2c-gsec-header">
      <span class="d2c-g-badge">PERFORMANCE BENCHMARKS</span>
      <h2 class="d2c-g-title">{{ section.settings.title | default: "ENGINEERED FOR EXTREME INDIAN CONDITIONS" }}</h2>
    </div>

    <div class="d2c-gmat-grid">
      <div class="d2c-gmat-card">
        <div class="d2c-gmat-val">24HRS</div>
        <div class="d2c-gmat-name">TRANSFERPROOF WEAR</div>
        <p class="d2c-gmat-desc">Innovative micro-flex film formers ensure zero color transfer onto cups, collars, or masks.</p>
      </div>

      <div class="d2c-gmat-card">
        <div class="d2c-gmat-val">100%</div>
        <div class="d2c-gmat-name">WATER & SWEAT PROOF</div>
        <p class="d2c-gmat-desc">Engineered to withstand heavy wedding monsoon rains, humidity, and intense dance floors.</p>
      </div>

      <div class="d2c-gmat-card">
        <div class="d2c-gmat-val">2X PIGMENT</div>
        <div class="d2c-gmat-name">ONE-STROKE COVERAGE</div>
        <p class="d2c-gmat-desc">Triple-milled micronized pigments deliver complete opaque intensity with a single featherlight swipe.</p>
      </div>

      <div class="d2c-gmat-card">
        <div class="d2c-gmat-val">0% LEAD</div>
        <div class="d2c-gmat-name">CLEAN & CRUELTY FREE</div>
        <p class="d2c-gmat-desc">100% free from toxic heavy metals, parabens, and animal testing. Certified PETA compliant.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-gmat-{{ section.id }} {
    background: #120410;
    padding: 70px 32px;
    border-top: 1px solid rgba(232, 121, 249, 0.2);
    border-bottom: 1px solid rgba(232, 121, 249, 0.2);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-gmat-container { max-width: 1360px; margin: 0 auto; }
  .d2c-gmat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-gmat-card {
    background: #1e091b;
    border: 1px solid rgba(232, 121, 249, 0.2);
    border-radius: 8px;
    padding: 32px 20px;
    text-align: center;
  }
  .d2c-gmat-val { font-size: 32px; font-weight: 900; color: #e879f9; margin-bottom: 6px; }
  .d2c-gmat-name { font-size: 12px; font-weight: 800; color: #ffffff; letter-spacing: 0.5px; margin-bottom: 10px; }
  .d2c-gmat-desc { font-size: 13px; color: #f5d0fe; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-gmat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-gmat-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Glam Performance Matrix",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ENGINEERED FOR EXTREME INDIAN CONDITIONS"
    }
  ],
  "presets": [
    {
      "name": "Glam Performance Matrix"
    }
  ]
}
{% endschema %}
