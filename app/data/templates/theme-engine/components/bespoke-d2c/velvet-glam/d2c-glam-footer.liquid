{% comment %}
  D2C Velvet Glam Studio Footer
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<footer class="d2c-glam-footer" id="d2c-gfoot-{{ section.id }}">
  <div class="d2c-gfoot-container">
    <div class="d2c-gfoot-top">
      <div class="d2c-gfoot-brand">
        <h3 class="d2c-gfoot-logo">{{ section.settings.brand_name | default: "KAY GLAM STUDIO" }}</h3>
        <p class="d2c-gfoot-desc">High-performance 24HR longwear makeup engineered in Germany & Italy, tailored for 36 Indian skin undertones.</p>
        <div class="d2c-gfoot-peta">🐰 100% PETA VEGAN & CRUELTY FREE</div>
      </div>

      <div class="d2c-gfoot-col">
        <h4 class="d2c-gcol-title">BEAUTY COLLECTIONS</h4>
        <ul class="d2c-gcol-links">
          <li><a href="/collections/matte-lipsticks">Matte As Hell Lip Crayons</a></li>
          <li><a href="/collections/liquid-lipsticks">Smudge Me Not Liquids</a></li>
          <li><a href="/collections/hd-foundation">Ace of Face HD Foundations</a></li>
          <li><a href="/collections/eyeliners">Born To Wing Gel Liners</a></li>
          <li><a href="/collections/fragrances">Velvet Noir Perfumery</a></li>
        </ul>
      </div>

      <div class="d2c-gfoot-col">
        <h4 class="d2c-gcol-title">CUSTOMER SERVICES</h4>
        <ul class="d2c-gcol-links">
          <li><a href="/pages/track-order">Track COD Delivery</a></li>
          <li><a href="/pages/returns">15-Day Shade Exchange</a></li>
          <li><a href="/pages/shade-finder">AI Shade Finder</a></li>
          <li><a href="/pages/stores">Find Store Near You</a></li>
          <li><a href="/pages/contact">WhatsApp MUA Support</a></li>
        </ul>
      </div>

      <div class="d2c-gfoot-col">
        <h4 class="d2c-gcol-title">BEAUTY CONCIERGE</h4>
        <p class="d2c-gfoot-sub-desc">Need assistance picking your foundation undertone or bridal lip combo? Chat directly with our certified MUAs.</p>
      </div>
    </div>

    <div class="d2c-gfoot-bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: "KAY GLAM COSMETICS PVT. LTD." }}. ALL RIGHTS RESERVED.</div>
      <div class="d2c-gfoot-legal">
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <a href="/policies/terms-of-service">Terms of Supply</a>
        <a href="/policies/shipping-policy">COD Shipping Terms</a>
      </div>
    </div>
  </div>
</footer>

<style>
  #d2c-gfoot-{{ section.id }} {
    background: #120410;
    color: #f5d0fe;
    padding: 70px 32px 30px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    border-top: 1px solid rgba(232, 121, 249, 0.2);
  }
  .d2c-gfoot-container { max-width: 1360px; margin: 0 auto; }
  .d2c-gfoot-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .d2c-gfoot-logo { font-size: 20px; font-weight: 900; color: #ffffff; letter-spacing: 1px; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-gfoot-desc { font-size: 13px; color: #f5d0fe; line-height: 1.6; margin-bottom: 16px; max-width: 320px; }
  .d2c-gfoot-peta { font-size: 11px; font-weight: 800; color: #e879f9; }
  .d2c-gcol-title { font-size: 12px; font-weight: 900; color: #ffffff; letter-spacing: 1px; margin-bottom: 16px; text-transform: uppercase; }
  .d2c-gcol-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .d2c-gcol-links a { color: #f5d0fe; text-decoration: none; font-size: 13px; opacity: 0.85; transition: opacity 0.15s ease; }
  .d2c-gcol-links a:hover { opacity: 1; color: #e879f9; }
  .d2c-gfoot-sub-desc { font-size: 13px; line-height: 1.6; opacity: 0.85; }
  .d2c-gfoot-bottom {
    border-top: 1px solid rgba(232, 121, 249, 0.15);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
  }
  .d2c-gfoot-legal { display: flex; gap: 20px; }
  .d2c-gfoot-legal a { color: inherit; text-decoration: none; }
  .d2c-gfoot-legal a:hover { color: #ffffff; }

  @media (max-width: 1024px) { .d2c-gfoot-top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) {
    .d2c-gfoot-top { grid-template-columns: 1fr; }
    .d2c-gfoot-bottom { flex-direction: column; gap: 12px; text-align: center; }
  }
</style>

{% schema %}
{
  "name": "Glam Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "KAY GLAM STUDIO"
    }
  ],
  "presets": [
    {
      "name": "Glam Footer"
    }
  ]
}
{% endschema %}
