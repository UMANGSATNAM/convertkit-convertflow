{% comment %}
  D2C Velvet Glam Press Mentions
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-press" id="d2c-gpress-{{ section.id }}">
  <div class="d2c-gpress-container">
    <span class="d2c-gpress-label">CELEBRATED IN</span>
    <div class="d2c-gpress-logos">
      <span class="d2c-gplogo">ELLE BEAUTY AWARDS</span>
      <span class="d2c-gplogo">FEMINA GLAM</span>
      <span class="d2c-gplogo">GRAZIA INDIA</span>
      <span class="d2c-gplogo">HARPER'S BAZAAR</span>
      <span class="d2c-gplogo">COSMOPOLITAN</span>
    </div>
  </div>
</section>

<style>
  #d2c-gpress-{{ section.id }} {
    background: #180816;
    padding: 30px 32px;
    border-bottom: 1px solid rgba(232, 121, 249, 0.2);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-gpress-container {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .d2c-gpress-label { font-size: 11px; font-weight: 800; color: #e879f9; letter-spacing: 1px; text-transform: uppercase; }
  .d2c-gpress-logos { display: flex; gap: 36px; align-items: center; flex-wrap: wrap; }
  .d2c-gplogo { font-size: 14px; font-weight: 900; color: #f5d0fe; letter-spacing: 0.5px; opacity: 0.9; }

  @media (max-width: 768px) {
    .d2c-gpress-container { justify-content: center; text-align: center; }
    .d2c-gpress-logos { justify-content: center; gap: 20px; }
  }
</style>

{% schema %}
{
  "name": "Glam Press Strip",
  "settings": [],
  "presets": [
    {
      "name": "Glam Press Strip"
    }
  ]
}
{% endschema %}
