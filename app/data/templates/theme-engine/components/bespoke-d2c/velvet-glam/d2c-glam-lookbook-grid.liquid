{% comment %}
  D2C Velvet Glam Red Carpet Lookbook
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-lookbook" id="d2c-glb-{{ section.id }}">
  <div class="d2c-glb-container">
    <div class="d2c-gsec-header">
      <span class="d2c-g-badge">RED CARPET ARCHIVES</span>
      <h2 class="d2c-g-title">{{ section.settings.title | default: "CELEBRITY & FESTIVE GLAM EDITORIAL" }}</h2>
    </div>

    <div class="d2c-glb-grid">
      <div class="d2c-glb-card large">
        <img src="https://images.unsplash.com/photo-1586495777744-4413f21062fa?w=800&q=80" alt="Royal Crimson Bride" />
        <div class="d2c-glb-overlay">
          <span class="d2c-glb-tag">LOOK 01 // ROYAL BRIDAL</span>
          <h3 class="d2c-glb-name">SCARLETT RED MATTE + WINGED KOHL</h3>
          <span class="d2c-glb-link">GET THE FULL LOOK &rarr;</span>
        </div>
      </div>

      <div class="d2c-glb-card">
        <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=600&q=80" alt="Sunkissed Glam" />
        <div class="d2c-glb-overlay">
          <span class="d2c-glb-tag">LOOK 02 // SUNKISSED</span>
          <h3 class="d2c-glb-name">CARAMEL HD GLOW</h3>
          <span class="d2c-glb-link">SHOP &rarr;</span>
        </div>
      </div>

      <div class="d2c-glb-card">
        <img src="https://images.unsplash.com/photo-1596704017254-9b121068fb31?w=600&q=80" alt="Cocktail Smokey" />
        <div class="d2c-glb-overlay">
          <span class="d2c-glb-tag">LOOK 03 // COCKTAIL SMOKEY</span>
          <h3 class="d2c-glb-name">CARBON GEL WING</h3>
          <span class="d2c-glb-link">SHOP &rarr;</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-glb-{{ section.id }} {
    background: #180816;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-glb-container { max-width: 1360px; margin: 0 auto; }
  .d2c-glb-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 24px;
  }
  .d2c-glb-card {
    position: relative;
    height: 480px;
    border-radius: 12px;
    overflow: hidden;
    background: #1e091b;
    border: 1px solid rgba(232, 121, 249, 0.3);
  }
  .d2c-glb-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .d2c-glb-card:hover img { transform: scale(1.04); }
  .d2c-glb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(24,8,22,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px;
    color: #ffffff;
  }
  .d2c-glb-tag { font-size: 10px; font-weight: 800; color: #f472b6; letter-spacing: 1px; margin-bottom: 4px; }
  .d2c-glb-name { font-size: 16px; font-weight: 800; margin-bottom: 8px; }
  .d2c-glb-link { font-size: 11px; font-weight: 800; color: #f5d0fe; }

  @media (max-width: 900px) {
    .d2c-glb-grid { grid-template-columns: 1fr; }
    .d2c-glb-card { height: 340px; }
  }
</style>

{% schema %}
{
  "name": "Glam Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "CELEBRITY & FESTIVE GLAM EDITORIAL"
    }
  ],
  "presets": [
    {
      "name": "Glam Lookbook"
    }
  ]
}
{% endschema %}
