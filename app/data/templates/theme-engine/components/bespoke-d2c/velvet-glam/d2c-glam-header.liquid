{% comment %}
  D2C Velvet Glam Studio Header
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<header class="d2c-glam-header" id="d2c-ghead-{{ section.id }}">
  <div class="d2c-ghead-container">
    <div class="d2c-ghead-left">
      <a href="/collections/lipsticks" class="d2c-gnav-link">LIPS</a>
      <a href="/collections/eyes" class="d2c-gnav-link">EYES</a>
      <a href="/collections/face-hd" class="d2c-gnav-link">HD FACE</a>
    </div>

    <div class="d2c-ghead-logo-box">
      <a href="/" class="d2c-ghead-logo">
        <span class="d2c-glogo-title">{{ section.settings.brand_name | default: "KAY GLAM STUDIO" }}</span>
        <span class="d2c-glogo-sub">24HR LONGWEAR • BEAUTY THAT PERFORMS</span>
      </a>
    </div>

    <div class="d2c-ghead-right">
      <a href="/pages/shade-finder" class="d2c-gnav-link highlight">AI SHADE MATCH</a>
      <a href="/cart" class="d2c-gnav-link">BAG ({{ cart.item_count | default: 0 }})</a>
    </div>
  </div>
</header>

<style>
  #d2c-ghead-{{ section.id }} {
    background: #120410;
    border-bottom: 1px solid rgba(232, 121, 249, 0.2);
    padding: 18px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  .d2c-ghead-container {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .d2c-ghead-left { display: flex; gap: 28px; }
  .d2c-ghead-right { display: flex; gap: 28px; justify-content: flex-end; align-items: center; }
  .d2c-gnav-link {
    color: #f5d0fe;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
  }
  .d2c-gnav-link.highlight {
    background: linear-gradient(135deg, #e879f9 0%, #ec4899 100%);
    color: #ffffff;
    padding: 6px 16px;
    border-radius: 99px;
    font-size: 11px;
  }
  .d2c-ghead-logo {
    text-align: center;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .d2c-glogo-title {
    font-size: 22px;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .d2c-glogo-sub {
    font-size: 9px;
    color: #e879f9;
    letter-spacing: 1.5px;
    margin-top: 2px;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .d2c-ghead-left { display: none; }
    .d2c-ghead-container { display: flex; justify-content: space-between; }
    #d2c-ghead-{{ section.id }} { padding: 14px 18px; }
  }
</style>

{% schema %}
{
  "name": "Glam Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "KAY GLAM STUDIO"
    }
  ],
  "presets": [
    {
      "name": "Glam Header"
    }
  ]
}
{% endschema %}
