{% comment %}
  D2C Velvet Glam Ticker Ribbon
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<div class="d2c-glam-ribbon" id="d2c-gribbon-{{ section.id }}">
  <div class="d2c-gribbon-track">
    <div class="d2c-gribbon-content">
      <span class="d2c-gribbon-item">💎 24HR TRANSFERPROOF WEAR</span>
      <span class="d2c-gribbon-sep">✦</span>
      <span class="d2c-gribbon-item">100% WATERPROOF & SMUDGEPROOF</span>
      <span class="d2c-gribbon-sep">✦</span>
      <span class="d2c-gribbon-item">FORMULATED FOR ALL 36 INDIAN UNDERTONES</span>
      <span class="d2c-gribbon-sep">✦</span>
      <span class="d2c-gribbon-item">FREE CASH ON DELIVERY ACROSS INDIA</span>
      <span class="d2c-gribbon-sep">✦</span>
      <span class="d2c-gribbon-item">💎 24HR TRANSFERPROOF WEAR</span>
      <span class="d2c-gribbon-sep">✦</span>
      <span class="d2c-gribbon-item">100% WATERPROOF & SMUDGEPROOF</span>
      <span class="d2c-gribbon-sep">✦</span>
      <span class="d2c-gribbon-item">FORMULATED FOR ALL 36 INDIAN UNDERTONES</span>
      <span class="d2c-gribbon-sep">✦</span>
      <span class="d2c-gribbon-item">FREE CASH ON DELIVERY ACROSS INDIA</span>
    </div>
  </div>
</div>

<style>
  #d2c-gribbon-{{ section.id }} {
    background: linear-gradient(90deg, #e879f9 0%, #ec4899 100%);
    color: #ffffff;
    overflow: hidden;
    white-space: nowrap;
    padding: 12px 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .d2c-gribbon-track { display: flex; overflow: hidden; }
  .d2c-gribbon-content {
    display: flex;
    align-items: center;
    gap: 32px;
    animation: d2c-gribbon-scroll 22s linear infinite;
  }
  .d2c-gribbon-sep { font-size: 14px; color: #ffffff; opacity: 0.8; }
  @keyframes d2c-gribbon-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
</style>

{% schema %}
{
  "name": "Glam Ribbon",
  "settings": [],
  "presets": [
    {
      "name": "Glam Ribbon"
    }
  ]
}
{% endschema %}
