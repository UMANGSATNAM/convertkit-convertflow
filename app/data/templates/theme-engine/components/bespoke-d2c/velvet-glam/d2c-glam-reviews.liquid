{% comment %}
  -----------------------------------------------------------------------------
  10X Bespoke D2C Architecture: Sugar / Kay Beauty - Customer Reviews
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'd2c-glam-reviews'
  assign bg_color = section.settings.bg_color | default: '#0d0814'
  assign text_color = section.settings.text_color | default: '#fdf4ff'
  assign accent_color = section.settings.accent_color | default: '#e879f9'
  assign title = section.settings.title | default: 'VERIFIED PATRON REVIEWS'
  assign subtitle = section.settings.subtitle | default: '4.9/5 RATED ACROSS 45,000+ CLIENTS'
-%}

<section id="d2c-reviews-{{ sec_id }}" class="d2c-reviews-wrap">
  <div class="d2c-rev-container">
    <div class="d2c-rev-header">
      <span class="d2c-rev-sub">{{ subtitle }}</span>
      <h2 class="d2c-rev-title">{{ title }}</h2>
    </div>

    <div class="d2c-rev-grid">
      
      <div class="d2c-rev-card">
        <div class="d2c-rev-stars">★★★★★</div>
        <h3 class="d2c-rev-card-title">"Stayed 8 Hours at Wedding"</h3>
        <p class="d2c-rev-quote">Literally stayed intact through an 8-hour wedding dinner without a single smudge!</p>
        <div class="d2c-rev-author">
          <div class="d2c-rev-avatar">N</div>
          <div>
            <div class="d2c-rev-name">Natasha G. <span class="d2c-ver-badge">✓ Verified Buyer</span></div>
            <div class="d2c-rev-loc">Mumbai, India</div>
          </div>
        </div>
      </div>
      
      <div class="d2c-rev-card">
        <div class="d2c-rev-stars">★★★★★</div>
        <h3 class="d2c-rev-card-title">"Insane Pigment"</h3>
        <p class="d2c-rev-quote">The eyeshadow pigmentation is incredible. Smooth blendability and zero fallout.</p>
        <div class="d2c-rev-author">
          <div class="d2c-rev-avatar">S</div>
          <div>
            <div class="d2c-rev-name">Simran K. <span class="d2c-ver-badge">✓ Verified Buyer</span></div>
            <div class="d2c-rev-loc">Delhi, India</div>
          </div>
        </div>
      </div>
      
      <div class="d2c-rev-card">
        <div class="d2c-rev-stars">★★★★★</div>
        <h3 class="d2c-rev-card-title">"Never Budges"</h3>
        <p class="d2c-rev-quote">Best waterproof eyeliner I've ever owned. Crisp wings that never budge.</p>
        <div class="d2c-rev-author">
          <div class="d2c-rev-avatar">A</div>
          <div>
            <div class="d2c-rev-name">Alia D. <span class="d2c-ver-badge">✓ Verified Buyer</span></div>
            <div class="d2c-rev-loc">Goa, India</div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  #d2c-reviews-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  #d2c-reviews-{{ sec_id }} .d2c-rev-container { max-width: 1320px; margin: 0 auto; }
  #d2c-reviews-{{ sec_id }} .d2c-rev-header { text-align: center; margin-bottom: 36px; }
  #d2c-reviews-{{ sec_id }} .d2c-rev-sub { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #d2c-reviews-{{ sec_id }} .d2c-rev-title { font-family: 'Italiana', Georgia, serif; font-size: clamp(26px, 3.5vw, 40px); font-weight: 900; margin: 6px 0 0 0; }

  #d2c-reviews-{{ sec_id }} .d2c-rev-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  #d2c-reviews-{{ sec_id }} .d2c-rev-card {
    background: #1b1026;
    border: 1px solid rgba(217, 70, 239, 0.25);
    border-radius: 14px;
    padding: 24px;
    display: flex;
    flex-direction: column;
  }
  #d2c-reviews-{{ sec_id }} .d2c-rev-stars { color: #f59e0b; font-size: 13px; margin-bottom: 8px; }
  #d2c-reviews-{{ sec_id }} .d2c-rev-card-title { font-family: 'Italiana', Georgia, serif; font-size: 16px; font-weight: 800; margin: 0 0 8px 0; color: {{ text_color }}; }
  #d2c-reviews-{{ sec_id }} .d2c-rev-quote { font-size: 14px; line-height: 1.6; color: #d8b4fe; margin: 0 0 20px 0; flex-grow: 1; }
  
  #d2c-reviews-{{ sec_id }} .d2c-rev-author { display: flex; align-items: center; gap: 12px; }
  #d2c-reviews-{{ sec_id }} .d2c-rev-avatar { width: 38px; height: 38px; border-radius: 50%; background: {{ accent_color }}; color: #000; font-weight: 900; display: flex; align-items: center; justify-content: center; }
  #d2c-reviews-{{ sec_id }} .d2c-rev-name { font-size: 13px; font-weight: 800; color: {{ text_color }}; display: flex; align-items: center; gap: 6px; }
  #d2c-reviews-{{ sec_id }} .d2c-ver-badge { font-size: 10px; color: #22c55e; font-weight: 700; }
  #d2c-reviews-{{ sec_id }} .d2c-rev-loc { font-size: 11px; color: #d8b4fe; }

  @media (max-width: 990px) {
    #d2c-reviews-{{ sec_id }} .d2c-rev-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Sugar / Kay Beauty Reviews",
  "tag": "section",
  "class": "d2c-reviews-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Heading", "default": "VERIFIED PATRON REVIEWS" },
    { "type": "text", "id": "subtitle", "label": "Subtitle Tag", "default": "4.9/5 RATED ACROSS 45,000+ CLIENTS" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0d0814" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#fdf4ff" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#e879f9" }
  ],
  "presets": [
    { "name": "Sugar / Kay Beauty Reviews" }
  ]
}
{% endschema %}
