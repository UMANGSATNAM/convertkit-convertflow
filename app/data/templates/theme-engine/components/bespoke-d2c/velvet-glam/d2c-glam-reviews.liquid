{% comment %}
  D2C Velvet Glam Verified Creator Reviews
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-reviews" id="d2c-grev-{{ section.id }}">
  <div class="d2c-grev-container">
    <div class="d2c-gsec-header">
      <span class="d2c-g-badge">MUA & CELEB REVIEWS</span>
      <h2 class="d2c-g-title">{{ section.settings.title | default: "RECOMMENDED BY TOP BRIDAL ARTISTS" }}</h2>
    </div>

    <div class="d2c-grev-grid">
      <div class="d2c-grev-card">
        <div class="d2c-grev-stars">★★★★★</div>
        <p class="d2c-grev-quote">"The Matte As Hell Crayon in Scarlett O'Hara is in my bridal kit for every single North Indian wedding. It survives 8 hours of ceremonies, oily snacks, and photoshoots without a single touch-up."</p>
        <div class="d2c-grev-author">
          <span class="d2c-grev-name">Namrata Soni</span>
          <span class="d2c-grev-loc">Celebrity MUA • Matte Crayon</span>
        </div>
      </div>

      <div class="d2c-grev-card">
        <div class="d2c-grev-stars">★★★★★</div>
        <p class="d2c-grev-quote">"Finding a stick foundation that matches deep warm undertones without looking ashy used to be impossible. Shade 120 blends like silk and covers all redness."</p>
        <div class="d2c-grev-author">
          <span class="d2c-grev-name">Tanvi Chemburkar</span>
          <span class="d2c-grev-loc">Bridal Beauty Artist • Mumbai</span>
        </div>
      </div>

      <div class="d2c-grev-card">
        <div class="d2c-grev-stars">★★★★★</div>
        <p class="d2c-grev-quote">"The gel eyeliner is intensely pigmented black. Doesn't flake into watery eyes during emotional bidaai moments. An absolute kit essential."</p>
        <div class="d2c-grev-author">
          <span class="d2c-grev-name">Ojas Rajani</span>
          <span class="d2c-grev-loc">Haute Couture Makeup Artist</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-grev-{{ section.id }} {
    background: #120410;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-grev-container { max-width: 1360px; margin: 0 auto; }
  .d2c-grev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .d2c-grev-card {
    background: #1e091b;
    border: 1px solid rgba(232, 121, 249, 0.25);
    border-radius: 8px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .d2c-grev-stars { color: #e879f9; font-size: 16px; margin-bottom: 12px; }
  .d2c-grev-quote { font-size: 14px; color: #f5d0fe; line-height: 1.6; margin-bottom: 20px; }
  .d2c-grev-name { font-size: 15px; font-weight: 900; color: #ffffff; display: block; margin-bottom: 2px; }
  .d2c-grev-loc { font-size: 11px; color: #f472b6; font-weight: 700; }

  @media (max-width: 900px) { .d2c-grev-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Glam Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "RECOMMENDED BY TOP BRIDAL ARTISTS"
    }
  ],
  "presets": [
    {
      "name": "Glam Reviews"
    }
  ]
}
{% endschema %}
