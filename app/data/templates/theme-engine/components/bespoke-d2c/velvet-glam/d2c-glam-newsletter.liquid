{% comment %}
  D2C Velvet Glam Newsletter
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-news" id="d2c-gnews-{{ section.id }}">
  <div class="d2c-gnews-container">
    <div class="d2c-gnews-card">
      <span class="d2c-g-badge">JOIN 500,000+ BEAUTY ADDICTS</span>
      <h2 class="d2c-gnews-title">{{ section.settings.title | default: "UNLOCK ₹200 OFF YOUR FIRST GLAM ORDER" }}</h2>
      <p class="d2c-gnews-desc">Subscribe to receive secret shade drop alerts, masterclass tickets, and private sale codes.</p>

      <form class="d2c-gnews-form">
        <input type="email" placeholder="Enter your email address" class="d2c-gnews-input" required />
        <button type="submit" class="d2c-gnews-btn">CLAIM ₹200 OFF &rarr;</button>
      </form>
      <div class="d2c-gnews-privacy">🔒 No spam ever. Unsubscribe anytime with 1 click.</div>
    </div>
  </div>
</section>

<style>
  #d2c-gnews-{{ section.id }} {
    background: #180816;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-gnews-container { max-width: 860px; margin: 0 auto; }
  .d2c-gnews-card {
    background: #1e091b;
    border-radius: 12px;
    padding: 48px 36px;
    text-align: center;
    border: 1px solid rgba(232, 121, 249, 0.3);
  }
  .d2c-gnews-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #ffffff; margin: 10px 0 12px; text-transform: uppercase; }
  .d2c-gnews-desc { font-size: 15px; color: #f5d0fe; margin-bottom: 28px; }
  .d2c-gnews-form { display: flex; gap: 10px; max-width: 480px; margin: 0 auto 14px; }
  .d2c-gnews-input {
    flex: 1;
    background: #120410;
    border: 1px solid rgba(232, 121, 249, 0.3);
    padding: 14px 18px;
    border-radius: 4px;
    font-size: 14px;
    color: #ffffff;
    outline: none;
  }
  .d2c-gnews-input:focus { border-color: #e879f9; }
  .d2c-gnews-btn {
    background: linear-gradient(135deg, #e879f9 0%, #ec4899 100%);
    color: #ffffff;
    border: none;
    padding: 14px 28px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-gnews-btn:hover { opacity: 0.9; }
  .d2c-gnews-privacy { font-size: 12px; color: #f5d0fe; opacity: 0.7; }

  @media (max-width: 600px) {
    .d2c-gnews-form { flex-direction: column; }
    .d2c-gnews-card { padding: 32px 20px; }
  }
</style>

{% schema %}
{
  "name": "Glam Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "UNLOCK ₹200 OFF YOUR FIRST GLAM ORDER"
    }
  ],
  "presets": [
    {
      "name": "Glam Newsletter"
    }
  ]
}
{% endschema %}
