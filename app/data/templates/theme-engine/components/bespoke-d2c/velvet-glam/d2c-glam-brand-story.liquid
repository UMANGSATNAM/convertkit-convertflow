{% comment %}
  D2C Velvet Glam Brand Story
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-story" id="d2c-gstory-{{ section.id }}">
  <div class="d2c-gstory-container">
    <div class="d2c-gstory-grid">
      <div class="d2c-gstory-content">
        <span class="d2c-g-badge">THE PHILOSOPHY</span>
        <h2 class="d2c-gstory-title">{{ section.settings.title | default: "MAKEUP THAT PERFORMS AS HARD AS YOU DO" }}</h2>
        <p class="d2c-gstory-para">
          For decades, Indian women were handed Western cosmetic formulas that melted under humidity, turned gray on olive undertones, or washed away in 2 hours.
        </p>
        <p class="d2c-gstory-para">
          We set out to build high-glamour cosmetics that refuse to compromise: rich pigment payoffs engineered in Germany and Italy, tailored precisely for 36 Indian skin undertones, and tested to survive 24 hours of real-life celebrations.
        </p>
        <div class="d2c-gstory-stats">
          <div><span class="d2c-gst-num">36+</span><span class="d2c-gst-lbl">Undertones</span></div>
          <div><span class="d2c-gst-num">24HR</span><span class="d2c-gst-lbl">Wear Tested</span></div>
          <div><span class="d2c-gst-num">100%</span><span class="d2c-gst-lbl">Cruelty-Free</span></div>
        </div>
      </div>

      <div class="d2c-gstory-media">
        <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=800&q=80" alt="Makeup Studio Formulation" />
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-gstory-{{ section.id }} {
    background: #180816;
    padding: 80px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-gstory-container { max-width: 1360px; margin: 0 auto; }
  .d2c-gstory-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }
  .d2c-gstory-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 900; color: #ffffff; line-height: 1.15; margin: 10px 0 20px; text-transform: uppercase; }
  .d2c-gstory-para { font-size: 15px; color: #f5d0fe; line-height: 1.7; margin-bottom: 18px; }
  .d2c-gstory-stats {
    display: flex;
    gap: 36px;
    border-top: 1px solid rgba(232, 121, 249, 0.2);
    padding-top: 24px;
    margin-top: 28px;
  }
  .d2c-gst-num { font-size: 26px; font-weight: 900; color: #e879f9; display: block; }
  .d2c-gst-lbl { font-size: 11px; color: #f5d0fe; font-weight: 700; text-transform: uppercase; }
  .d2c-gstory-media img { width: 100%; height: 440px; object-fit: cover; border-radius: 12px; border: 1px solid rgba(232, 121, 249, 0.3); }

  @media (max-width: 900px) {
    .d2c-gstory-grid { grid-template-columns: 1fr; }
    .d2c-gstory-media img { height: 320px; }
  }
</style>

{% schema %}
{
  "name": "Glam Story",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "MAKEUP THAT PERFORMS AS HARD AS YOU DO"
    }
  ],
  "presets": [
    {
      "name": "Glam Story"
    }
  ]
}
{% endschema %}
