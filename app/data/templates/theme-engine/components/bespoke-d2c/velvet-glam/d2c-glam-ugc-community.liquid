{% comment %}
  D2C Velvet Glam Community Wall
  Theme: Sugar Cosmetics / Kay Beauty Velvet Glam
{% endcomment %}

<section class="d2c-glam-ugc" id="d2c-gugc-{{ section.id }}">
  <div class="d2c-gugc-container">
    <div class="d2c-gsec-header">
      <span class="d2c-g-badge">#GLAMFAMINDIA</span>
      <h2 class="d2c-g-title">{{ section.settings.title | default: "TAGGED BY 3,000,000+ GLAM QUEENS" }}</h2>
    </div>

    <div class="d2c-gugc-grid">
      <div class="d2c-gugc-tile"><img src="https://images.unsplash.com/photo-1586495777744-4413f21062fa?w=600&q=80" alt="Glam 1" /><span>@kriti_makeup · Scarlett 01</span></div>
      <div class="d2c-gugc-tile"><img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=600&q=80" alt="Glam 2" /><span>@tara_glam · Caramel HD</span></div>
      <div class="d2c-gugc-tile"><img src="https://images.unsplash.com/photo-1596704017254-9b121068fb31?w=600&q=80" alt="Glam 3" /><span>@ananya_wings · Carbon Kohl</span></div>
      <div class="d2c-gugc-tile"><img src="https://images.unsplash.com/photo-1541643600914-78b084683601?w=600&q=80" alt="Glam 4" /><span>@sneha_festive · Noir EDP</span></div>
    </div>
  </div>
</section>

<style>
  #d2c-gugc-{{ section.id }} {
    background: #180816;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-gugc-container { max-width: 1360px; margin: 0 auto; }
  .d2c-gugc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .d2c-gugc-tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    background: #1e091b;
    border: 1px solid rgba(232, 121, 249, 0.3);
  }
  .d2c-gugc-tile img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-gugc-tile span {
    position: absolute;
    bottom: 8px;
    left: 8px;
    right: 8px;
    background: rgba(24,8,22,0.85);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 6px;
    text-align: center;
    border-radius: 4px;
  }

  @media (max-width: 900px) { .d2c-gugc-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

{% schema %}
{
  "name": "Glam Community",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "TAGGED BY 3,000,000+ GLAM QUEENS"
    }
  ],
  "presets": [
    {
      "name": "Glam Community"
    }
  ]
}
{% endschema %}
