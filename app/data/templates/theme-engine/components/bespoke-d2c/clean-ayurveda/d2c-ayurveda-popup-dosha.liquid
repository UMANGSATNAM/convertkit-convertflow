{% comment %}
  D2C Clean Ayurveda Dosha Popup
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<div class="d2c-ayur-popup" id="d2c-apop-{{ section.id }}" style="display: none;">
  <div class="d2c-apop-overlay">
    <div class="d2c-apop-card">
      <button class="d2c-apop-close" onclick="document.getElementById('d2c-apop-{{ section.id }}').style.display='none';">&times;</button>
      <span class="d2c-a-badge">🍃 VEDIC SKIN DIAGNOSIS</span>
      <h3 class="d2c-apop-title">UNLOCK YOUR PERSONALIZED DOSHA RITUAL</h3>
      <p class="d2c-apop-desc">Enter your details to receive your customized herb chart + Flat 15% Welcome Gift Code.</p>

      <form class="d2c-apop-form">
        <input type="text" placeholder="Your Name" class="d2c-apop-input" required />
        <input type="email" placeholder="Your Email Address" class="d2c-apop-input" required />
        <input type="tel" placeholder="WhatsApp Number for Instant Guide" class="d2c-apop-input" required />
        <button type="submit" class="d2c-apop-btn">GET FREE DOSHA CHART & 15% OFF &rarr;</button>
      </form>
    </div>
  </div>
</div>

<style>
  .d2c-apop-overlay {
    position: fixed;
    inset: 0;
    background: rgba(21, 41, 30, 0.85);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-apop-card {
    background: #fbf9f4;
    border-radius: 12px;
    padding: 44px 32px;
    max-width: 440px;
    width: 100%;
    text-align: center;
    position: relative;
    border: 2px solid #2e5a44;
    box-shadow: 0 20px 45px -10px rgba(0,0,0,0.3);
  }
  .d2c-apop-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: #4a6356;
    font-size: 22px;
    cursor: pointer;
  }
  .d2c-apop-title { font-size: 20px; font-weight: 700; color: #1c3829; margin: 8px 0 10px; text-transform: uppercase; }
  .d2c-apop-desc { font-size: 14px; color: #4a6356; margin-bottom: 22px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-apop-form { display: flex; flex-direction: column; gap: 10px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-apop-input {
    background: #ffffff;
    border: 1px solid rgba(46, 90, 68, 0.25);
    padding: 12px 16px;
    border-radius: 4px;
    font-size: 14px;
    outline: none;
  }
  .d2c-apop-input:focus { border-color: #2e5a44; }
  .d2c-apop-btn {
    background: #2e5a44;
    color: #ffffff;
    border: none;
    padding: 14px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
    margin-top: 6px;
  }
</style>

