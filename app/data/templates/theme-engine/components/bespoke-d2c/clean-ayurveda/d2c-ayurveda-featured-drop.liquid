{% comment %}
  D2C Clean Ayurveda Serum Spotlight
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-spotlight" id="d2c-aspot-{{ section.id }}">
  <div class="d2c-aspot-container">
    <div class="d2c-aspot-card">
      <div class="d2c-aspot-media">
        <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=800&q=85" alt="Kumkumadi Miraculous Night Fluid" />
      </div>

      <div class="d2c-aspot-content">
        <span class="d2c-a-badge">CLINICALLY PROVEN AYURVEDA</span>
        <h2 class="d2c-aspot-title">{{ section.settings.title | default: "KUMKUMADI MIRACULOUS NIGHT FLUID" }}</h2>
        <p class="d2c-aspot-desc">
          An authentic classical formulation made with pure Kashmiri saffron (Crocus Sativus) soaked in cold-pressed sesame oil with 26 precious Himalayan herbs. Clinically tested to reduce pigmentation by 34% in 28 days.
        </p>

        <div class="d2c-aspot-matrix">
          <div class="d2c-am-item"><span>HERB PURITY:</span> <strong>100% Grade A Saffron Stigmas</strong></div>
          <div class="d2c-am-item"><span>CLINICAL TEST:</span> <strong>96% Saw Brighter Complexion</strong></div>
          <div class="d2c-am-item"><span>STANDARDS:</span> <strong>Ayush Certified • Dermatologist Tested</strong></div>
        </div>

        <div class="d2c-aspot-price-row">
          <span class="d2c-aspot-price">₹2,495</span>
          <span class="d2c-aspot-orig">₹3,200</span>
          <span class="d2c-aspot-tag">FREE BOTANICAL MIST WITH ORDER</span>
        </div>

        <button class="d2c-aspot-btn">⚡ BUY WITH 1-CLICK FREE COD &rarr;</button>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-aspot-{{ section.id }} {
    background: #f4ede2;
    padding: 70px 32px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-aspot-container { max-width: 1360px; margin: 0 auto; }
  .d2c-aspot-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    align-items: center;
    border: 1px solid rgba(46, 90, 68, 0.15);
  }
  .d2c-aspot-media img { width: 100%; height: 480px; object-fit: cover; border-radius: 8px; }
  .d2c-aspot-title { font-size: clamp(26px, 3.5vw, 38px); font-weight: 700; color: #1c3829; line-height: 1.15; margin: 10px 0 16px; text-transform: uppercase; }
  .d2c-aspot-desc { font-size: 15px; color: #4a6356; line-height: 1.6; margin-bottom: 24px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-aspot-matrix {
    background: #f4ede2;
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-am-item { display: flex; justify-content: space-between; font-size: 12px; color: #4a6356; }
  .d2c-am-item strong { color: #1c3829; }
  .d2c-aspot-price-row { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-aspot-price { font-size: 24px; font-weight: 800; color: #1c3829; }
  .d2c-aspot-orig { font-size: 14px; color: #9ca3af; text-decoration: line-through; }
  .d2c-aspot-tag { background: #dcfce7; color: #15803d; font-size: 10px; font-weight: 800; padding: 4px 8px; border-radius: 4px; }
  .d2c-aspot-btn {
    width: 100%;
    background: #2e5a44;
    color: #ffffff;
    border: none;
    padding: 16px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  @media (max-width: 900px) {
    .d2c-aspot-card { grid-template-columns: 1fr; padding: 24px; }
    .d2c-aspot-media img { height: 320px; }
  }
</style>

{% schema %}
{
  "name": "Ayurveda Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "KUMKUMADI MIRACULOUS NIGHT FLUID"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Spotlight"
    }
  ]
}
{% endschema %}
