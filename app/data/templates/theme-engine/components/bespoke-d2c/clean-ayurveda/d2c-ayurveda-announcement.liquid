{% comment %}
  D2C Clean Ayurveda Announcement Bar
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<div class="d2c-ayur-announcement" id="d2c-aann-{{ section.id }}">
  <div class="d2c-aann-inner">
    <span>🍃</span>
    <span class="d2c-aann-text">{{ section.settings.text | default: "100% TOXIN-FREE AYURVEDA // PLANT A TREE WITH EVERY ORDER" }}</span>
    <span class="d2c-aann-sep">✦</span>
    <span class="d2c-aann-sub">FREE KUMKUMADI MINI ON ₹999+</span>
  </div>
</div>

<style>
  #d2c-aann-{{ section.id }} {
    background: #1c3829;
    color: #e8f5e9;
    padding: 10px 16px;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 12px;
    letter-spacing: 1px;
    text-align: center;
  }
  .d2c-aann-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }
  .d2c-aann-sub { color: #86efac; font-weight: 700; }
  .d2c-aann-sep { opacity: 0.6; }
  @media (max-width: 768px) { #d2c-aann-{{ section.id }} { font-size: 11px; padding: 8px 12px; } .d2c-aann-sub { display: none; } }
</style>

{% schema %}
{
  "name": "Ayurveda Announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "100% TOXIN-FREE AYURVEDA // PLANT A TREE WITH EVERY ORDER"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Announcement"
    }
  ]
}
{% endschema %}
