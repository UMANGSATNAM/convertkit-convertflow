{% comment %}
  D2C Clean Ayurveda Ticker Ribbon
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<div class="d2c-ayur-ribbon" id="d2c-aribbon-{{ section.id }}">
  <div class="d2c-aribbon-track">
    <div class="d2c-aribbon-content">
      <span class="d2c-aribbon-item">🍃 100% TOXIN-FREE FORMULAS</span>
      <span class="d2c-aribbon-sep">✦</span>
      <span class="d2c-aribbon-item">CRUELTY FREE PETA CERTIFIED</span>
      <span class="d2c-aribbon-sep">✦</span>
      <span class="d2c-aribbon-item">AYUSH MINISTRY APPROVED</span>
      <span class="d2c-aribbon-sep">✦</span>
      <span class="d2c-aribbon-item">DERMATOLOGICALLY TESTED FOR INDIAN SKIN</span>
      <span class="d2c-aribbon-sep">✦</span>
      <span class="d2c-aribbon-item">🍃 100% TOXIN-FREE FORMULAS</span>
      <span class="d2c-aribbon-sep">✦</span>
      <span class="d2c-aribbon-item">CRUELTY FREE PETA CERTIFIED</span>
      <span class="d2c-aribbon-sep">✦</span>
      <span class="d2c-aribbon-item">AYUSH MINISTRY APPROVED</span>
      <span class="d2c-aribbon-sep">✦</span>
      <span class="d2c-aribbon-item">DERMATOLOGICALLY TESTED FOR INDIAN SKIN</span>
    </div>
  </div>
</div>

<style>
  #d2c-aribbon-{{ section.id }} {
    background: #2e5a44;
    color: #ffffff;
    overflow: hidden;
    white-space: nowrap;
    padding: 12px 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .d2c-aribbon-track { display: flex; overflow: hidden; }
  .d2c-aribbon-content {
    display: flex;
    align-items: center;
    gap: 32px;
    animation: d2c-aribbon-scroll 24s linear infinite;
  }
  .d2c-aribbon-sep { font-size: 14px; color: #86efac; }
  @keyframes d2c-aribbon-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
</style>

{% schema %}
{
  "name": "Ayurveda Ribbon",
  "settings": [],
  "presets": [
    {
      "name": "Ayurveda Ribbon"
    }
  ]
}
{% endschema %}
