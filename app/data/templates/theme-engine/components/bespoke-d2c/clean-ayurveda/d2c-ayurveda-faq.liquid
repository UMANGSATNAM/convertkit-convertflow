{% comment %}
  D2C Clean Ayurveda Skin & Dosha FAQ
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-faq" id="d2c-afaq-{{ section.id }}">
  <div class="d2c-afaq-container">
    <div class="d2c-asec-header">
      <span class="d2c-a-badge">BOTANICAL ANSWERS</span>
      <h2 class="d2c-a-title">{{ section.settings.title | default: "AYURVEDIC SKINCARE QUESTIONS" }}</h2>
    </div>

    <div class="d2c-afaq-list">
      <details class="d2c-afaq-item" open>
        <summary class="d2c-afaq-q">
          <span>Are your products suitable for acne-prone or sensitive skin?</span>
          <span class="d2c-afaq-icon">+</span>
        </summary>
        <div class="d2c-afaq-a">
          Yes. All formulations are non-comedogenic and free from mineral oils, synthetic fragrances, and pore-clogging silicones. They are dermatologically tested on sensitive Indian skin types.
        </div>
      </details>

      <details class="d2c-afaq-item">
        <summary class="d2c-afaq-q">
          <span>How soon can I expect visible skin brightening results?</span>
          <span class="d2c-afaq-icon">+</span>
        </summary>
        <div class="d2c-afaq-a">
          In clinical dermatological trials, 94% of users observed noticeably improved skin hydration and reduced dark spots within 21 to 28 days of consistent night application.
        </div>
      </details>

      <details class="d2c-afaq-item">
        <summary class="d2c-afaq-q">
          <span>What is your "Plant a Tree" promise?</span>
          <span class="d2c-afaq-icon">+</span>
        </summary>
        <div class="d2c-afaq-a">
          Through our partnership with SankalpTaru Foundation, we plant a verified fruit-bearing tree in rural India for every order placed. You receive the exact GPS coordinates and photo of your tree via email.
        </div>
      </details>

      <details class="d2c-afaq-item">
        <summary class="d2c-afaq-q">
          <span>Is free Cash on Delivery (COD) available nationwide?</span>
          <span class="d2c-afaq-icon">+</span>
        </summary>
        <div class="d2c-afaq-a">
          Yes. Free Cash on Delivery is available across 24,000+ Indian pincodes without any extra convenience surcharge. Pay easily via cash or UPI at your doorstep.
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  #d2c-afaq-{{ section.id }} {
    background: #f4ede2;
    padding: 70px 32px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-afaq-container { max-width: 860px; margin: 0 auto; }
  .d2c-afaq-list { display: flex; flex-direction: column; gap: 12px; margin-top: 36px; }
  .d2c-afaq-item {
    background: #ffffff;
    border: 1px solid rgba(46, 90, 68, 0.15);
    border-radius: 8px;
    overflow: hidden;
  }
  .d2c-afaq-q {
    padding: 20px 24px;
    font-size: 16px;
    font-weight: 700;
    color: #1c3829;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }
  .d2c-afaq-q::-webkit-details-marker { display: none; }
  .d2c-afaq-icon { font-size: 18px; font-weight: 700; color: #2e5a44; }
  details[open] .d2c-afaq-icon { transform: rotate(45deg); display: inline-block; }
  .d2c-afaq-a {
    padding: 0 24px 20px;
    font-size: 14px;
    color: #4a6356;
    line-height: 1.6;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
</style>

{% schema %}
{
  "name": "Ayurveda FAQ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "AYURVEDIC SKINCARE QUESTIONS"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda FAQ"
    }
  ]
}
{% endschema %}
