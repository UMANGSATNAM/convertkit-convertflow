{% comment %}
  D2C Clean Ayurveda Botanical Newsletter
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-news" id="d2c-anews-{{ section.id }}">
  <div class="d2c-anews-container">
    <div class="d2c-anews-card">
      <span class="d2c-a-badge">THE VEDIC GAZETTE</span>
      <h2 class="d2c-anews-title">{{ section.settings.title | default: "RECEIVE SEASONAL RITUAL GUIDES" }}</h2>
      <p class="d2c-anews-desc">Unlock classical Ayurvedic wellness recipes, seasonal skincare adjustments, and secret drop invitations.</p>

      <form class="d2c-anews-form">
        <input type="email" placeholder="Enter your email address" class="d2c-anews-input" required />
        <button type="submit" class="d2c-anews-btn">JOIN CIRCLE &rarr;</button>
      </form>
      <div class="d2c-anews-note">🔒 Pure privacy. We never spam or sell your personal data.</div>
    </div>
  </div>
</section>

<style>
  #d2c-anews-{{ section.id }} {
    background: #fbf9f4;
    padding: 70px 32px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-anews-container { max-width: 860px; margin: 0 auto; }
  .d2c-anews-card {
    background: #f4ede2;
    border-radius: 12px;
    padding: 48px 36px;
    text-align: center;
    border: 1px solid rgba(46, 90, 68, 0.2);
  }
  .d2c-anews-title { font-size: clamp(26px, 3.5vw, 38px); font-weight: 700; color: #1c3829; margin: 10px 0 12px; text-transform: uppercase; }
  .d2c-anews-desc { font-size: 15px; color: #4a6356; margin-bottom: 28px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-anews-form { display: flex; gap: 10px; max-width: 480px; margin: 0 auto 14px; }
  .d2c-anews-input {
    flex: 1;
    background: #ffffff;
    border: 1px solid rgba(46, 90, 68, 0.25);
    padding: 14px 18px;
    border-radius: 4px;
    font-size: 14px;
    outline: none;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-anews-input:focus { border-color: #2e5a44; }
  .d2c-anews-btn {
    background: #2e5a44;
    color: #ffffff;
    border: none;
    padding: 14px 28px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-anews-note { font-size: 12px; color: #6b7280; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }

  @media (max-width: 600px) {
    .d2c-anews-form { flex-direction: column; }
    .d2c-anews-card { padding: 32px 20px; }
  }
</style>

{% schema %}
{
  "name": "Ayurveda Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "RECEIVE SEASONAL RITUAL GUIDES"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Newsletter"
    }
  ]
}
{% endschema %}
