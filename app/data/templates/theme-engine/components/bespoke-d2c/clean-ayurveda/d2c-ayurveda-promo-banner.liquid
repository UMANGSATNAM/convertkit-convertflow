{% comment %}
  D2C Clean Ayurveda Promo Banner
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-promo" id="d2c-apromo-{{ section.id }}">
  <div class="d2c-apromo-container">
    <div class="d2c-apromo-card">
      <span class="d2c-a-badge" style="color: #86efac;">LIMITED BOTANICAL HARVEST</span>
      <h2 class="d2c-apromo-title">{{ section.settings.title | default: "COMPLIMENTARY KUMKUMADI MINI ON ALL ORDERS ABOVE ₹999" }}</h2>
      <p class="d2c-apromo-desc">Experience the transformative power of authentic Kashmiri Saffron. Automatically applied at checkout with zero promo code needed.</p>
      <a href="/collections/all" class="d2c-apromo-btn">CLAIM BOTANICAL GIFT &rarr;</a>
    </div>
  </div>
</section>

<style>
  #d2c-apromo-{{ section.id }} {
    background: #fbf9f4;
    padding: 50px 32px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-apromo-container { max-width: 1360px; margin: 0 auto; }
  .d2c-apromo-card {
    background: #1c3829;
    color: #ffffff;
    border-radius: 12px;
    padding: 60px 36px;
    text-align: center;
    border: 1px solid rgba(134, 239, 172, 0.3);
    box-shadow: 0 20px 45px -10px rgba(28,56,41,0.25);
  }
  .d2c-apromo-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; letter-spacing: 1px; margin: 12px 0 16px; text-transform: uppercase; }
  .d2c-apromo-desc { font-size: 15px; color: #e8f5e9; max-width: 620px; margin: 0 auto 28px; line-height: 1.6; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-apromo-btn {
    display: inline-block;
    background: #ffffff;
    color: #1c3829;
    padding: 16px 36px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-apromo-btn:hover { background: #e8f5e9; }
</style>

{% schema %}
{
  "name": "Ayurveda Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "COMPLIMENTARY KUMKUMADI MINI ON ALL ORDERS ABOVE ₹999"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Promo Banner"
    }
  ]
}
{% endschema %}
