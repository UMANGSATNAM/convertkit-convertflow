{% comment %}
  D2C Clean Ayurveda Verified Reviews
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-reviews" id="d2c-arev-{{ section.id }}">
  <div class="d2c-arev-container">
    <div class="d2c-asec-header">
      <span class="d2c-a-badge">VERIFIED EXPERIENCES</span>
      <h2 class="d2c-a-title">{{ section.settings.title | default: "TRUSTED BY OVER 1 MILLION RADIANT FACES" }}</h2>
    </div>

    <div class="d2c-arev-grid">
      <div class="d2c-arev-card">
        <div class="d2c-arev-stars">★★★★★</div>
        <p class="d2c-arev-quote">"The Kumkumadi Night Fluid cleared my stubborn post-acne marks in 3 weeks. It absorbs beautifully without leaving any sticky residue. Truly miraculous ayurvedic skincare."</p>
        <div class="d2c-arev-author">
          <span class="d2c-arev-name">Dr. Radhika Menon</span>
          <span class="d2c-arev-loc">Dermatologist • Kumkumadi Night Fluid</span>
        </div>
      </div>

      <div class="d2c-arev-card">
        <div class="d2c-arev-stars">★★★★★</div>
        <p class="d2c-arev-quote">"I stopped using chemical hair serums and switched to the Bhringraj Scalp Oil. My hair fall reduced drastically after 4 washes. Smells like authentic botanical wellness."</p>
        <div class="d2c-arev-author">
          <span class="d2c-arev-name">Meghna Sanyal</span>
          <span class="d2c-arev-loc">Verified Buyer • Bhringraj Hair Elixir</span>
        </div>
      </div>

      <div class="d2c-arev-card">
        <div class="d2c-arev-stars">★★★★★</div>
        <p class="d2c-arev-quote">"The 3-step radiance kit is my holy grail before any family function. Natural Kashmiri saffron glow that lasts all day without heavy makeup."</p>
        <div class="d2c-arev-author">
          <span class="d2c-arev-name">Sneha Kulkarni</span>
          <span class="d2c-arev-loc">Verified Buyer • 3-Step Glow Box</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-arev-{{ section.id }} {
    background: #fbf9f4;
    padding: 70px 32px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-arev-container { max-width: 1360px; margin: 0 auto; }
  .d2c-arev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .d2c-arev-card {
    background: #ffffff;
    border: 1px solid rgba(46, 90, 68, 0.15);
    border-radius: 8px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: center;
    box-shadow: 0 10px 25px -5px rgba(28,56,41,0.06);
  }
  .d2c-arev-stars { color: #f59e0b; font-size: 16px; margin-bottom: 16px; }
  .d2c-arev-quote { font-size: 15px; color: #4a6356; line-height: 1.6; font-style: italic; margin-bottom: 24px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-arev-name { font-size: 17px; font-weight: 700; color: #1c3829; display: block; margin-bottom: 4px; }
  .d2c-arev-loc { font-size: 11px; color: #2e5a44; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }

  @media (max-width: 900px) { .d2c-arev-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Ayurveda Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "TRUSTED BY OVER 1 MILLION RADIANT FACES"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Reviews"
    }
  ]
}
{% endschema %}
