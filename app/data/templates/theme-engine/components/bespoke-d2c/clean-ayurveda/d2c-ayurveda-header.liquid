{% comment %}
  D2C Clean Ayurveda Warm Botanical Header
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<header class="d2c-ayur-header" id="d2c-ahead-{{ section.id }}">
  <div class="d2c-ahead-container">
    <div class="d2c-ahead-left">
      <a href="/collections/kumkumadi" class="d2c-ahead-link">KUMKUMADI</a>
      <a href="/collections/hair-care" class="d2c-ahead-link">BHRINGRAJ HAIR</a>
      <a href="/collections/body-care" class="d2c-ahead-link">UBTAN GLOW</a>
    </div>

    <div class="d2c-ahead-logo-box">
      <a href="/" class="d2c-ahead-logo">
        <span class="d2c-alogo-title">{{ section.settings.brand_name | default: "VEDIC BOTANICS" }}</span>
        <span class="d2c-alogo-sub">PURE AYURVEDA • CLINICALLY PROVEN</span>
      </a>
    </div>

    <div class="d2c-ahead-right">
      <a href="/pages/dosha-quiz" class="d2c-ahead-link highlight">AI DOSHA TEST</a>
      <a href="/cart" class="d2c-ahead-link">BAG ({{ cart.item_count | default: 0 }})</a>
    </div>
  </div>
</header>

<style>
  #d2c-ahead-{{ section.id }} {
    background: #fbf9f4;
    border-bottom: 1px solid rgba(46, 90, 68, 0.15);
    padding: 18px 32px;
    font-family: 'Playfair Display', Georgia, serif;
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  .d2c-ahead-container {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .d2c-ahead-left { display: flex; gap: 28px; }
  .d2c-ahead-right { display: flex; gap: 28px; justify-content: flex-end; align-items: center; }
  .d2c-ahead-link {
    color: #2e5a44;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
  }
  .d2c-ahead-link.highlight {
    background: #2e5a44;
    color: #ffffff;
    padding: 6px 14px;
    border-radius: 99px;
    font-size: 11px;
  }
  .d2c-ahead-logo {
    text-align: center;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .d2c-alogo-title {
    font-size: 24px;
    font-weight: 700;
    color: #1c3829;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .d2c-alogo-sub {
    font-size: 9px;
    color: #2e5a44;
    letter-spacing: 2px;
    margin-top: 2px;
  }

  @media (max-width: 900px) {
    .d2c-ahead-left { display: none; }
    .d2c-ahead-container { display: flex; justify-content: space-between; }
    #d2c-ahead-{{ section.id }} { padding: 14px 18px; }
  }
</style>

{% schema %}
{
  "name": "Ayurveda Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "VEDIC BOTANICS"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Header"
    }
  ]
}
{% endschema %}
