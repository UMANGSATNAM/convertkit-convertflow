{% comment %}
  D2C Clean Ayurveda Press Strip
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-press" id="d2c-apress-{{ section.id }}">
  <div class="d2c-apress-container">
    <span class="d2c-apress-label">ACCLAIMED BY BEAUTY EDITORS</span>
    <div class="d2c-apress-logos">
      <span class="d2c-alogo-item">VOGUE BEAUTY</span>
      <span class="d2c-alogo-item">COSMOPOLITAN INDIA</span>
      <span class="d2c-alogo-item">FEMINA BEAUTY AWARDS</span>
      <span class="d2c-alogo-item">ELLE INDIA</span>
      <span class="d2c-alogo-item">GRAZIA CLEAN BEAUTY</span>
    </div>
  </div>
</section>

<style>
  #d2c-apress-{{ section.id }} {
    background: #f4ede2;
    padding: 32px 32px;
    border-bottom: 1px solid rgba(46, 90, 68, 0.15);
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-apress-container {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .d2c-apress-label { font-size: 11px; font-weight: 700; color: #2e5a44; letter-spacing: 1.5px; text-transform: uppercase; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-apress-logos { display: flex; gap: 36px; align-items: center; flex-wrap: wrap; }
  .d2c-alogo-item {
    font-size: 15px;
    font-weight: 700;
    color: #1c3829;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .d2c-apress-container { justify-content: center; text-align: center; }
    .d2c-apress-logos { justify-content: center; gap: 20px; }
  }
</style>

{% schema %}
{
  "name": "Ayurveda Press Strip",
  "settings": [],
  "presets": [
    {
      "name": "Ayurveda Press Strip"
    }
  ]
}
{% endschema %}
