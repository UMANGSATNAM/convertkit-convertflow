{% comment %}
  D2C Clean Ayurveda 10-Free Standard Matrix
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-standards" id="d2c-astand-{{ section.id }}">
  <div class="d2c-astand-container">
    <div class="d2c-asec-header">
      <span class="d2c-a-badge">THE TOXIN-FREE PLEDGE</span>
      <h2 class="d2c-a-title">{{ section.settings.title | default: "OUR 10-FREE CLEAN BEAUTY BENCHMARK" }}</h2>
    </div>

    <div class="d2c-astand-grid">
      <div class="d2c-astand-card">
        <div class="d2c-asc-val">0%</div>
        <div class="d2c-asc-name">SULFATES & SLS</div>
        <p class="d2c-asc-desc">Gentle plant-derived saponins protect your natural acid mantle barrier.</p>
      </div>

      <div class="d2c-astand-card">
        <div class="d2c-asc-val">0%</div>
        <div class="d2c-asc-name">SYNTHETIC PARABENS</div>
        <p class="d2c-asc-desc">Preserved naturally using pure neem, tea tree, and tocopherol extracts.</p>
      </div>

      <div class="d2c-astand-card">
        <div class="d2c-asc-val">0%</div>
        <div class="d2c-asc-name">MINERAL OILS</div>
        <p class="d2c-asc-desc">100% cold-pressed sesame, almond, and virgin coconut botanical carrier oils.</p>
      </div>

      <div class="d2c-astand-card">
        <div class="d2c-asc-val">100%</div>
        <div class="d2c-asc-name">CRUELTY FREE PETA</div>
        <p class="d2c-asc-desc">Never tested on animals. Tested exclusively on human dermatological panels.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-astand-{{ section.id }} {
    background: #f4ede2;
    padding: 70px 32px;
    border-top: 1px solid rgba(46, 90, 68, 0.15);
    border-bottom: 1px solid rgba(46, 90, 68, 0.15);
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-astand-container { max-width: 1360px; margin: 0 auto; }
  .d2c-astand-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-astand-card {
    background: #ffffff;
    border: 1px solid rgba(46, 90, 68, 0.15);
    border-radius: 8px;
    padding: 32px 20px;
    text-align: center;
  }
  .d2c-asc-val { font-size: 36px; font-weight: 800; color: #2e5a44; margin-bottom: 6px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-asc-name { font-size: 13px; font-weight: 700; color: #1c3829; letter-spacing: 1px; margin-bottom: 10px; }
  .d2c-asc-desc { font-size: 13px; color: #4a6356; line-height: 1.5; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }

  @media (max-width: 900px) { .d2c-astand-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-astand-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Ayurveda Standards",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "OUR 10-FREE CLEAN BEAUTY BENCHMARK"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Standards"
    }
  ]
}
{% endschema %}
