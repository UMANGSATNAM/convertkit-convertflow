{% comment %}
  D2C Clean Ayurveda Botanical Footer
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<footer class="d2c-ayur-footer" id="d2c-afoot-{{ section.id }}">
  <div class="d2c-afoot-container">
    <div class="d2c-afoot-top">
      <div class="d2c-afoot-brand">
        <h3 class="d2c-afoot-logo">{{ section.settings.brand_name | default: "VEDIC BOTANICS" }}</h3>
        <p class="d2c-afoot-desc">Pioneering clean Ayurvedic wellness by marrying authentic Vedic rasayanas with rigorous dermatological science. 100% toxin-free and plant positive.</p>
        <div class="d2c-afoot-initiative">🍃 1 PURCHASE = 1 GEO-TAGGED TREE PLANTED</div>
      </div>

      <div class="d2c-afoot-col">
        <h4 class="d2c-acol-title">VEDIC RITUALS</h4>
        <ul class="d2c-acol-links">
          <li><a href="/collections/kumkumadi">Kumkumadi Saffron Glow</a></li>
          <li><a href="/collections/hair-care">Bhringraj Scalp Oils</a></li>
          <li><a href="/collections/ubtan">Turmeric Brightening</a></li>
          <li><a href="/collections/rose-water">Pure Kannauj Rose Waters</a></li>
          <li><a href="/pages/dosha-quiz">Free AI Dosha Quiz</a></li>
        </ul>
      </div>

      <div class="d2c-afoot-col">
        <h4 class="d2c-acol-title">WELLNESS CARE</h4>
        <ul class="d2c-acol-links">
          <li><a href="/pages/track-order">Track COD Delivery</a></li>
          <li><a href="/pages/returns">Easy Doorstep Returns</a></li>
          <li><a href="/pages/ingredient-pledge">10-Free Clean Standard</a></li>
          <li><a href="/pages/tree-counter">View Live Forest Map</a></li>
          <li><a href="/pages/contact">WhatsApp Vaidya Support</a></li>
        </ul>
      </div>

      <div class="d2c-afoot-col">
        <h4 class="d2c-acol-title">AYUSH AUTHENTICITY</h4>
        <p class="d2c-afoot-sub-desc">Manufactured in GMP-certified Ayurvedic facilities under the guidance of traditional Vaidyas and certified biochemists.</p>
      </div>
    </div>

    <div class="d2c-afoot-bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: "VEDIC BOTANICS AYURVEDA PVT. LTD." }}. ALL RIGHTS RESERVED.</div>
      <div class="d2c-afoot-legal">
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <a href="/policies/terms-of-service">Terms of Wellness</a>
        <a href="/policies/shipping-policy">Shipping & COD</a>
      </div>
    </div>
  </div>
</footer>

<style>
  #d2c-afoot-{{ section.id }} {
    background: #15291e;
    color: #e8f5e9;
    padding: 70px 32px 30px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-afoot-container { max-width: 1360px; margin: 0 auto; }
  .d2c-afoot-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .d2c-afoot-logo { font-size: 20px; font-weight: 700; color: #86efac; letter-spacing: 1px; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-afoot-desc { font-size: 13px; color: #c8e6c9; line-height: 1.6; margin-bottom: 16px; max-width: 340px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-afoot-initiative { font-size: 11px; font-weight: 700; color: #86efac; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-acol-title { font-size: 13px; font-weight: 700; color: #ffffff; letter-spacing: 1px; margin-bottom: 16px; text-transform: uppercase; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-acol-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .d2c-acol-links a { color: #c8e6c9; text-decoration: none; font-size: 13px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; transition: color 0.15s ease; }
  .d2c-acol-links a:hover { color: #86efac; }
  .d2c-afoot-sub-desc { font-size: 13px; color: #c8e6c9; line-height: 1.6; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-afoot-bottom {
    border-top: 1px solid rgba(134, 239, 172, 0.2);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-afoot-legal { display: flex; gap: 20px; }
  .d2c-afoot-legal a { color: inherit; text-decoration: none; }
  .d2c-afoot-legal a:hover { color: #86efac; }

  @media (max-width: 1024px) { .d2c-afoot-top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) {
    .d2c-afoot-top { grid-template-columns: 1fr; }
    .d2c-afoot-bottom { flex-direction: column; gap: 12px; text-align: center; }
  }
</style>

{% schema %}
{
  "name": "Ayurveda Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "VEDIC BOTANICS"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Footer"
    }
  ]
}
{% endschema %}
