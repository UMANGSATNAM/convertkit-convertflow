{% comment %}
  D2C Clean Ayurveda Bestsellers Grid
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-best" id="d2c-abest-{{ section.id }}">
  <div class="d2c-abest-container">
    <div class="d2c-asec-header">
      <span class="d2c-a-badge">MOST LOVED FORMULAS</span>
      <h2 class="d2c-a-title">{{ section.settings.title | default: "ICONIC AYURVEDIC ELIXIRS" }}</h2>
    </div>

    <div class="d2c-aprod-grid">
      <!-- Item 1 -->
      <div class="d2c-aprod-card">
        <div class="d2c-aprod-thumb">
          <span class="d2c-aprod-pill">26 VEDIC HERBS</span>
          <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=600&q=80" alt="Kumkumadi Miraculous Night Serum" />
        </div>
        <div class="d2c-aprod-body">
          <div class="d2c-aprod-herb">KASHMIRI SAFFRON + LOTUS EXTRACT</div>
          <h3 class="d2c-aprod-title">Kumkumadi Night Fluid Serum</h3>
          <div class="d2c-aprod-rating">★★★★★ <span>(18,200+ Verified Reviews)</span></div>
          <div class="d2c-aprod-price">₹2,495 <span class="d2c-aprod-orig">₹3,200</span></div>
          <button class="d2c-aatc-btn">+ ADD TO BAG</button>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="d2c-aprod-card">
        <div class="d2c-aprod-thumb">
          <span class="d2c-aprod-pill">COLD PRESSED</span>
          <img src="https://images.unsplash.com/photo-1608248597359-2166946a482b?w=600&q=80" alt="Bhringraj Intensive Hair Oil" />
        </div>
        <div class="d2c-aprod-body">
          <div class="d2c-aprod-herb">BHRINGRAJ + AMLA + SESAME</div>
          <h3 class="d2c-aprod-title">Intensive Bhringraj Scalp Oil</h3>
          <div class="d2c-aprod-rating">★★★★★ <span>(14,900+ Verified Reviews)</span></div>
          <div class="d2c-aprod-price">₹1,475 <span class="d2c-aprod-orig">₹1,850</span></div>
          <button class="d2c-aatc-btn">+ ADD TO BAG</button>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="d2c-aprod-card">
        <div class="d2c-aprod-thumb">
          <span class="d2c-aprod-pill">STEAM DISTILLED</span>
          <img src="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=600&q=80" alt="Kannauj Pure Rose Mist" />
        </div>
        <div class="d2c-aprod-body">
          <div class="d2c-aprod-herb">100% INDIAN DESI GULAB</div>
          <h3 class="d2c-aprod-title">Pure Kannauj Rose Water Mist</h3>
          <div class="d2c-aprod-rating">★★★★★ <span>(22,100+ Verified Reviews)</span></div>
          <div class="d2c-aprod-price">₹895 <span class="d2c-aprod-orig">₹1,150</span></div>
          <button class="d2c-aatc-btn">+ ADD TO BAG</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-abest-{{ section.id }} {
    background: #f4ede2;
    padding: 70px 32px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-abest-container { max-width: 1360px; margin: 0 auto; }
  .d2c-aprod-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .d2c-aprod-card {
    background: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(46, 90, 68, 0.15);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 25px -5px rgba(28,56,41,0.06);
  }
  .d2c-aprod-thumb { position: relative; height: 360px; overflow: hidden; background: #e8ede7; }
  .d2c-aprod-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-aprod-pill {
    position: absolute;
    top: 14px;
    left: 14px;
    background: #1c3829;
    color: #86efac;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 4px 10px;
    border-radius: 4px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-aprod-body { padding: 24px 20px; display: flex; flex-direction: column; flex-grow: 1; justify-content: space-between; text-align: center; }
  .d2c-aprod-herb { font-size: 10px; font-weight: 700; color: #2e5a44; letter-spacing: 1.5px; margin-bottom: 6px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-aprod-title { font-size: 18px; font-weight: 700; color: #1c3829; margin-bottom: 8px; }
  .d2c-aprod-rating { font-size: 12px; color: #f59e0b; margin-bottom: 12px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-aprod-rating span { color: #6b7280; font-size: 11px; }
  .d2c-aprod-price { font-size: 18px; font-weight: 800; color: #1c3829; margin-bottom: 18px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-aprod-orig { font-size: 13px; color: #9ca3af; text-decoration: line-through; margin-left: 6px; }
  .d2c-aatc-btn {
    width: 100%;
    background: #2e5a44;
    color: #ffffff;
    border: none;
    padding: 14px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    border-radius: 4px;
    cursor: pointer;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-aatc-btn:hover { background: #1c3829; }

  @media (max-width: 900px) { .d2c-aprod-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Ayurveda Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ICONIC AYURVEDIC ELIXIRS"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Bestsellers"
    }
  ]
}
{% endschema %}
