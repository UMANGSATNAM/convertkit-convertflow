{% comment %}
  D2C Clean Ayurveda Community Glow Wall
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-ugc" id="d2c-augc-{{ section.id }}">
  <div class="d2c-augc-container">
    <div class="d2c-asec-header">
      <span class="d2c-a-badge">#VEDICGLOWJOURNEY</span>
      <h2 class="d2c-a-title">{{ section.settings.title | default: "OVER 1,200,000 HAPPY AYURVEDIC GLOWS" }}</h2>
    </div>

    <div class="d2c-augc-grid">
      <div class="d2c-augc-tile"><img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=600&q=80" alt="Glow 1" /><span>@ishita.botanicals · Bangalore</span></div>
      <div class="d2c-augc-tile"><img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?w=600&q=80" alt="Glow 2" /><span>@kavya_natural · Jaipur</span></div>
      <div class="d2c-augc-tile"><img src="https://images.unsplash.com/photo-1608248597359-2166946a482b?w=600&q=80" alt="Glow 3" /><span>@shreya.vedic · Mumbai</span></div>
      <div class="d2c-augc-tile"><img src="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=600&q=80" alt="Glow 4" /><span>@ritika_organics · Delhi</span></div>
    </div>
  </div>
</section>

<style>
  #d2c-augc-{{ section.id }} {
    background: #fbf9f4;
    padding: 70px 32px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-augc-container { max-width: 1360px; margin: 0 auto; }
  .d2c-augc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .d2c-augc-tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: 60px 60px 6px 6px;
    overflow: hidden;
    border: 1px solid rgba(46, 90, 68, 0.2);
  }
  .d2c-augc-tile img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-augc-tile span {
    position: absolute;
    bottom: 10px;
    left: 10px;
    right: 10px;
    background: rgba(28,56,41,0.85);
    color: #e8f5e9;
    font-size: 11px;
    font-weight: 700;
    padding: 6px;
    text-align: center;
    border-radius: 4px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  @media (max-width: 900px) { .d2c-augc-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

{% schema %}
{
  "name": "Ayurveda Community",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "OVER 1,200,000 HAPPY AYURVEDIC GLOWS"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Community"
    }
  ]
}
{% endschema %}
