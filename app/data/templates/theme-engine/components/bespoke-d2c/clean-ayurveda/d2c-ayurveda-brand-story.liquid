{% comment %}
  D2C Clean Ayurveda Heritage Brand Story
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-story" id="d2c-astory-{{ section.id }}">
  <div class="d2c-astory-container">
    <div class="d2c-astory-grid">
      <div class="d2c-astory-content">
        <span class="d2c-a-badge">OUR ROOTS & PURPOSE</span>
        <h2 class="d2c-astory-title">{{ section.settings.title | default: "BRIDGING ANCIENT CHARAKA SAMHITA WITH MODERN DERMATOLOGY" }}</h2>
        <p class="d2c-astory-para">
          We believe true beauty is an outward expression of balanced inner wellness. For centuries, classical Ayurvedic scriptures documented potent botanicals capable of skin rejuvenation.
        </p>
        <p class="d2c-astory-para">
          We source all our herbs directly from organic Himalayan tribal cooperatives, cold-press them at ambient temperatures to preserve active bio-compounds, and test every formulation under strict clinical protocols.
        </p>
        <div class="d2c-astory-stats">
          <div><span class="d2c-ast-num">1.2M+</span><span class="d2c-ast-lbl">Trees Planted</span></div>
          <div><span class="d2c-ast-num">100%</span><span class="d2c-ast-lbl">Plastic Positive</span></div>
          <div><span class="d2c-ast-num">26</span><span class="d2c-ast-lbl">Organic Farms</span></div>
        </div>
      </div>

      <div class="d2c-astory-media">
        <div class="d2c-astory-frame">
          <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=800&q=80" alt="Botanical Harvest" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-astory-{{ section.id }} {
    background: #fbf9f4;
    padding: 80px 32px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-astory-container { max-width: 1360px; margin: 0 auto; }
  .d2c-astory-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }
  .d2c-astory-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #1c3829; line-height: 1.2; margin: 10px 0 20px; text-transform: uppercase; }
  .d2c-astory-para { font-size: 16px; color: #4a6356; line-height: 1.7; margin-bottom: 18px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-astory-stats {
    display: flex;
    gap: 36px;
    border-top: 1px solid rgba(46, 90, 68, 0.2);
    padding-top: 24px;
    margin-top: 28px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-ast-num { font-size: 24px; font-weight: 800; color: #2e5a44; display: block; }
  .d2c-ast-lbl { font-size: 11px; color: #4a6356; font-weight: 700; text-transform: uppercase; }
  .d2c-astory-frame {
    border-radius: 160px 160px 8px 8px;
    overflow: hidden;
    border: 2px solid #2e5a44;
  }
  .d2c-astory-frame img { width: 100%; height: 480px; object-fit: cover; }

  @media (max-width: 900px) {
    .d2c-astory-grid { grid-template-columns: 1fr; }
    .d2c-astory-frame img { height: 340px; }
  }
</style>

{% schema %}
{
  "name": "Ayurveda Story",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "BRIDGING ANCIENT CHARAKA SAMHITA WITH MODERN DERMATOLOGY"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Story"
    }
  ]
}
{% endschema %}
