{% comment %}
  -----------------------------------------------------------------------------
  10X Bespoke D2C Architecture: Mamaearth / Forest Essentials - Founder's Manifesto
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'd2c-ayurveda-brand-story'
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#1f2937'
  assign accent_color = section.settings.accent_color | default: '#2e5a44'
-%}

<section id="d2c-story-{{ sec_id }}" class="d2c-story-wrap">
  <div class="d2c-story-container">
    <div class="d2c-story-grid">
      <div class="d2c-story-media">
        <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=900&q=85" alt="Artisanal Heritage" class="d2c-story-img" loading="lazy" />
      </div>
      <div class="d2c-story-content">
        <span class="d2c-story-sub">OUR FOUNDATIONAL MANIFESTO</span>
        <h2 class="d2c-story-title">Crafting Without Compromise</h2>
        <p class="d2c-story-p">We began with a singular conviction: that modern Indian consumers deserve world-class architectural silhouettes, uncompromised raw materials, and honest benchmark pricing.</p>
        <p class="d2c-story-p">Every single creation is tested across rigorous wear-and-tear cycles, ensuring that what arrives at your doorstep remains your favorite staple for years to come.</p>
        <div class="d2c-story-sig">
          <div class="d2c-sig-text">Mamaearth Atelier Team</div>
          <div class="d2c-sig-role">Master Design & Craftsmanship Guild</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-story-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    border-top: 1px solid rgba(46, 90, 68, 0.12);
    border-bottom: 1px solid rgba(46, 90, 68, 0.12);
  }
  #d2c-story-{{ sec_id }} .d2c-story-container { max-width: 1200px; margin: 0 auto; }
  #d2c-story-{{ sec_id }} .d2c-story-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  #d2c-story-{{ sec_id }} .d2c-story-media { border-radius: 16px; overflow: hidden; aspect-ratio: 4 / 5; border: 1px solid rgba(46, 90, 68, 0.12); }
  #d2c-story-{{ sec_id }} .d2c-story-img { width: 100%; height: 100%; object-fit: cover; }
  
  #d2c-story-{{ sec_id }} .d2c-story-sub { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #d2c-story-{{ sec_id }} .d2c-story-title { font-family: 'Italiana', Georgia, serif; font-size: clamp(26px, 3.5vw, 40px); font-weight: 900; margin: 6px 0 18px 0; }
  #d2c-story-{{ sec_id }} .d2c-story-p { font-size: 14px; line-height: 1.7; color: #6b7280; margin-bottom: 16px; }
  #d2c-story-{{ sec_id }} .d2c-story-sig { margin-top: 24px; border-top: 1px solid rgba(46, 90, 68, 0.12); padding-top: 16px; }
  #d2c-story-{{ sec_id }} .d2c-sig-text { font-family: 'Italiana', Georgia, serif; font-size: 18px; font-weight: 900; color: {{ accent_color }}; }
  #d2c-story-{{ sec_id }} .d2c-sig-role { font-size: 11px; color: #6b7280; margin-top: 2px; }

  @media (max-width: 990px) {
    #d2c-story-{{ sec_id }} .d2c-story-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Mamaearth / Forest Essentials Brand Story",
  "tag": "section",
  "class": "d2c-story-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1f2937" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#2e5a44" }
  ],
  "presets": [
    { "name": "Mamaearth / Forest Essentials Brand Story" }
  ]
}
{% endschema %}
