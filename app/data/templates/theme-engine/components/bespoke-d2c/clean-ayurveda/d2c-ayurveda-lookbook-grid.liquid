{% comment %}
  D2C Clean Ayurveda Ritual Grid
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-ritual" id="d2c-arit-{{ section.id }}">
  <div class="d2c-arit-container">
    <div class="d2c-asec-header">
      <span class="d2c-a-badge">THE DAILY VEDIC DISCIPLINE</span>
      <h2 class="d2c-a-title">{{ section.settings.title | default: "3-STEP DAILY GLOW RITUAL" }}</h2>
    </div>

    <div class="d2c-arit-grid">
      <div class="d2c-arit-card large">
        <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=800&q=80" alt="Morning Cleansing Ritual" />
        <div class="d2c-arit-overlay">
          <span class="d2c-arit-step">STEP 01 // PURIFY</span>
          <h3 class="d2c-arit-title">SAFFRON & TURMERIC UBTAN CLEANSER</h3>
          <span class="d2c-arit-link">SHOP CLEANSERS &rarr;</span>
        </div>
      </div>

      <div class="d2c-arit-card">
        <img src="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=600&q=80" alt="Hydration Mist" />
        <div class="d2c-arit-overlay">
          <span class="d2c-arit-step">STEP 02 // TONE</span>
          <h3 class="d2c-arit-title">PURE KANNAUJ ROSE WATER</h3>
          <span class="d2c-arit-link">SHOP &rarr;</span>
        </div>
      </div>

      <div class="d2c-arit-card">
        <img src="https://images.unsplash.com/photo-1608248597359-2166946a482b?w=600&q=80" alt="Night Elixir" />
        <div class="d2c-arit-overlay">
          <span class="d2c-arit-step">STEP 03 // NOURISH</span>
          <h3 class="d2c-arit-title">KUMKUMADI NIGHT FLUID</h3>
          <span class="d2c-arit-link">SHOP &rarr;</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-arit-{{ section.id }} {
    background: #fbf9f4;
    padding: 70px 32px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-arit-container { max-width: 1360px; margin: 0 auto; }
  .d2c-arit-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 24px;
  }
  .d2c-arit-card {
    position: relative;
    height: 460px;
    border-radius: 120px 120px 8px 8px;
    overflow: hidden;
    border: 1px solid rgba(46, 90, 68, 0.2);
  }
  .d2c-arit-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .d2c-arit-card:hover img { transform: scale(1.05); }
  .d2c-arit-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(28,56,41,0.9) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px;
    color: #ffffff;
    text-align: center;
  }
  .d2c-arit-step { font-size: 10px; font-weight: 700; color: #86efac; letter-spacing: 1.5px; margin-bottom: 4px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-arit-title { font-size: 18px; font-weight: 700; margin-bottom: 6px; }
  .d2c-arit-link { font-size: 11px; font-weight: 700; color: #e8f5e9; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }

  @media (max-width: 900px) {
    .d2c-arit-grid { grid-template-columns: 1fr; }
    .d2c-arit-card { height: 340px; }
  }
</style>

{% schema %}
{
  "name": "Ayurveda Ritual Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "3-STEP DAILY GLOW RITUAL"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Ritual Grid"
    }
  ]
}
{% endschema %}
