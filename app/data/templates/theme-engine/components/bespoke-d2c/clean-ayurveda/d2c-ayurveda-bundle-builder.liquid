{% comment %}
  D2C Clean Ayurveda 3-Step Ritual Bundle Box
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-bundle" id="d2c-abundle-{{ section.id }}">
  <div class="d2c-abundle-container">
    <div class="d2c-abundle-box">
      <div class="d2c-abundle-info">
        <span class="d2c-a-badge">RITUAL BOX & SAVE</span>
        <h2 class="d2c-abundle-title">{{ section.settings.title | default: "THE COMPLETE 3-STEP RADIANCE BOX" }}</h2>
        <p class="d2c-abundle-desc">
          Everything you need for luminous, even-toned skin: Ubtan Face Cleanser, Pure Kannauj Rose Water, and the iconic Kumkumadi Night Fluid. Housed in a biodegradable handcrafted wooden box.
        </p>
        <div class="d2c-abundle-price">RITUAL PRICE: ₹3,995 <span class="d2c-ab-orig">₹4,890</span> <span class="d2c-ab-save">SAVE ₹895</span></div>
        <button class="d2c-ab-btn">CLAIM 3-STEP RITUAL BOX &rarr;</button>
      </div>

      <div class="d2c-abundle-visual">
        <div class="d2c-abi-card">
          <img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?w=400&q=80" alt="Ubtan Cleanser" />
          <span>Ubtan Cleanser</span>
        </div>
        <span class="d2c-abi-plus">+</span>
        <div class="d2c-abi-card">
          <img src="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=400&q=80" alt="Rose Mist" />
          <span>Rose Mist</span>
        </div>
        <span class="d2c-abi-plus">+</span>
        <div class="d2c-abi-card">
          <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=400&q=80" alt="Kumkumadi Fluid" />
          <span>Kumkumadi Fluid</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-abundle-{{ section.id }} {
    background: #fbf9f4;
    padding: 70px 32px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-abundle-container { max-width: 1360px; margin: 0 auto; }
  .d2c-abundle-box {
    background: #f4ede2;
    border-radius: 12px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    border: 1px solid rgba(46, 90, 68, 0.2);
  }
  .d2c-abundle-title { font-size: clamp(26px, 3.5vw, 38px); font-weight: 700; color: #1c3829; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-abundle-desc { font-size: 15px; color: #4a6356; line-height: 1.6; margin-bottom: 24px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-abundle-price { font-size: 20px; font-weight: 800; color: #1c3829; margin-bottom: 28px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-ab-orig { font-size: 14px; color: #9ca3af; text-decoration: line-through; margin-left: 6px; }
  .d2c-ab-save { background: #dcfce7; color: #15803d; font-size: 11px; font-weight: 800; padding: 4px 8px; border-radius: 4px; margin-left: 8px; }
  .d2c-ab-btn {
    background: #2e5a44;
    color: #ffffff;
    border: none;
    padding: 16px 32px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-abundle-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .d2c-abi-card {
    background: #ffffff;
    border: 1px solid rgba(46, 90, 68, 0.2);
    border-radius: 8px;
    overflow: hidden;
    text-align: center;
    padding: 8px;
    width: 120px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-abi-card img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; margin-bottom: 6px; }
  .d2c-abi-card span { font-size: 10px; font-weight: 700; color: #1c3829; }
  .d2c-abi-plus { font-size: 20px; font-weight: 700; color: #2e5a44; }

  @media (max-width: 900px) {
    .d2c-abundle-box { grid-template-columns: 1fr; padding: 24px; }
  }
</style>

{% schema %}
{
  "name": "Ayurveda Bundle Box",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE COMPLETE 3-STEP RADIANCE BOX"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Bundle Box"
    }
  ]
}
{% endschema %}
