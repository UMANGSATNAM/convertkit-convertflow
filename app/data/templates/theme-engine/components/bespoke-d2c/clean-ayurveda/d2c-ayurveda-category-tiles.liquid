{% comment %}
  D2C Clean Ayurveda Category Tiles
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-cats" id="d2c-acats-{{ section.id }}">
  <div class="d2c-acats-container">
    <div class="d2c-asec-header">
      <span class="d2c-a-badge">VEDIC FORMULATIONS</span>
      <h2 class="d2c-a-title">{{ section.settings.title | default: "TIMELESS AYURVEDIC RITUALS" }}</h2>
    </div>

    <div class="d2c-acats-grid">
      <a href="/collections/kumkumadi" class="d2c-acat-card">
        <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=600&q=80" alt="Kumkumadi Glow" />
        <div class="d2c-acat-overlay">
          <span class="d2c-acat-sub">KASHMIRI SAFFRON</span>
          <h3 class="d2c-acat-name">KUMKUMADI GLOW</h3>
          <span class="d2c-acat-link">EXPLORE RITUAL &rarr;</span>
        </div>
      </a>

      <a href="/collections/hair-care" class="d2c-acat-card">
        <img src="https://images.unsplash.com/photo-1608248597359-2166946a482b?w=600&q=80" alt="Bhringraj Hair Care" />
        <div class="d2c-acat-overlay">
          <span class="d2c-acat-sub">ROOT STRENGTHENING</span>
          <h3 class="d2c-acat-name">BHRINGRAJ OIL & MASKS</h3>
          <span class="d2c-acat-link">EXPLORE RITUAL &rarr;</span>
        </div>
      </a>

      <a href="/collections/ubtan" class="d2c-acat-card">
        <img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?w=600&q=80" alt="Ubtan Brightening" />
        <div class="d2c-acat-overlay">
          <span class="d2c-acat-sub">TURMERIC & SAFFRON</span>
          <h3 class="d2c-acat-name">UBTAN BRIGHTENING</h3>
          <span class="d2c-acat-link">EXPLORE RITUAL &rarr;</span>
        </div>
      </a>

      <a href="/collections/rose-water" class="d2c-acat-card">
        <img src="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=600&q=80" alt="Kanooj Rose Mists" />
        <div class="d2c-acat-overlay">
          <span class="d2c-acat-sub">STEAM-DISTILLED</span>
          <h3 class="d2c-acat-name">KANNAUJ PURE ROSE WATER</h3>
          <span class="d2c-acat-link">EXPLORE RITUAL &rarr;</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  #d2c-acats-{{ section.id }} {
    background: #fbf9f4;
    padding: 70px 32px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-acats-container { max-width: 1360px; margin: 0 auto; }
  .d2c-asec-header { text-align: center; margin-bottom: 48px; }
  .d2c-a-badge { font-size: 11px; font-weight: 700; color: #2e5a44; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px; display: block; }
  .d2c-a-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #1c3829; letter-spacing: 1px; text-transform: uppercase; }
  .d2c-acats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-acat-card {
    position: relative;
    height: 420px;
    border-radius: 120px 120px 8px 8px;
    overflow: hidden;
    border: 1px solid rgba(46, 90, 68, 0.2);
    text-decoration: none;
    display: block;
  }
  .d2c-acat-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .d2c-acat-card:hover img { transform: scale(1.06); }
  .d2c-acat-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(28,56,41,0.9) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: #ffffff;
    text-align: center;
  }
  .d2c-acat-sub { font-size: 10px; font-weight: 700; color: #86efac; letter-spacing: 1.5px; margin-bottom: 4px; }
  .d2c-acat-name { font-size: 18px; font-weight: 700; letter-spacing: 1px; margin-bottom: 6px; }
  .d2c-acat-link { font-size: 11px; font-weight: 700; color: #e8f5e9; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }

  @media (max-width: 1024px) { .d2c-acats-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-acats-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Ayurveda Categories",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "TIMELESS AYURVEDIC RITUALS"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Categories"
    }
  ]
}
{% endschema %}
