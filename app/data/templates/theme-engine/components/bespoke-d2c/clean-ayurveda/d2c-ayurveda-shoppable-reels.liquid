{% comment %}
  D2C Clean Ayurveda Transformation Reels
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-reels" id="d2c-areels-{{ section.id }}">
  <div class="d2c-areels-container">
    <div class="d2c-asec-header">
      <span class="d2c-a-badge">REAL SKIN TRANSFORMATIONS</span>
      <h2 class="d2c-a-title">{{ section.settings.title | default: "21-DAY AYURVEDIC GLOW IN MOTION" }}</h2>
    </div>

    <div class="d2c-areels-grid">
      <div class="d2c-areel-card">
        <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=600&q=80" alt="Glow Transformation" />
        <div class="d2c-areel-overlay">
          <span class="d2c-areel-tag">21-DAY KUMKUMADI ROUTINE</span>
          <h4 class="d2c-areel-name">Pooja N. · Bangalore</h4>
          <span class="d2c-areel-pill">Kumkumadi Serum · ₹2,495</span>
        </div>
      </div>

      <div class="d2c-areel-card">
        <img src="https://images.unsplash.com/photo-1608248597359-2166946a482b?w=600&q=80" alt="Hair Oil Routine" />
        <div class="d2c-areel-overlay">
          <span class="d2c-areel-tag">BHRINGRAJ SCALP MASSAGE</span>
          <h4 class="d2c-areel-name">Simran K. · Delhi</h4>
          <span class="d2c-areel-pill">Bhringraj Oil · ₹1,475</span>
        </div>
      </div>

      <div class="d2c-areel-card">
        <img src="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=600&q=80" alt="Rose Mist Hydration" />
        <div class="d2c-areel-overlay">
          <span class="d2c-areel-tag">MORNING ROSE WATER MIST</span>
          <h4 class="d2c-areel-name">Ananya D. · Mumbai</h4>
          <span class="d2c-areel-pill">Kannauj Rose Mist · ₹895</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-areels-{{ section.id }} {
    background: #fbf9f4;
    padding: 70px 32px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-areels-container { max-width: 1360px; margin: 0 auto; }
  .d2c-areels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .d2c-areel-card {
    position: relative;
    aspect-ratio: 9/16;
    border-radius: 120px 120px 8px 8px;
    overflow: hidden;
    border: 1px solid rgba(46, 90, 68, 0.2);
    cursor: pointer;
  }
  .d2c-areel-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .d2c-areel-card:hover img { transform: scale(1.05); }
  .d2c-areel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(28,56,41,0.9) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px 20px;
    color: #ffffff;
    text-align: center;
  }
  .d2c-areel-tag { font-size: 10px; font-weight: 700; color: #86efac; letter-spacing: 1.5px; margin-bottom: 4px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-areel-name { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
  .d2c-areel-pill {
    background: #ffffff;
    color: #1c3829;
    font-size: 11px;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: 4px;
    display: inline-block;
    align-self: center;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  @media (max-width: 900px) { .d2c-areels-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Ayurveda Reels",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "21-DAY AYURVEDIC GLOW IN MOTION"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Reels"
    }
  ]
}
{% endschema %}
