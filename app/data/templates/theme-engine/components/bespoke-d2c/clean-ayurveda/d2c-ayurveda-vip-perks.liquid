{% comment %}
  D2C Clean Ayurveda Vedic Circle Loyalty
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-vip" id="d2c-avip-{{ section.id }}">
  <div class="d2c-avip-container">
    <div class="d2c-avip-box">
      <div class="d2c-asec-header">
        <span class="d2c-a-badge">THE BOTANICAL CIRCLE</span>
        <h2 class="d2c-a-title">{{ section.settings.title | default: "JOIN THE VEDIC WELLNESS COMMUNITY" }}</h2>
        <p class="d2c-avip-sub">Earn herbal rewards and plant verified trees with every clean skincare purchase.</p>
      </div>

      <div class="d2c-avip-grid">
        <div class="d2c-avip-card">
          <div class="d2c-av-tag">TIER 1 // SPROUT</div>
          <div class="d2c-av-title">5% CASHBACK ON ALL DROPS</div>
          <p class="d2c-av-desc">Instant wallet credit on every order plus complimentary birthday botanical deluxe mini.</p>
        </div>

        <div class="d2c-avip-card active">
          <span class="d2c-av-pill">MOST VALUED</span>
          <div class="d2c-av-tag">TIER 2 // BLOOM</div>
          <div class="d2c-av-title">FREE SHIPPING + 2 TREES PLANTED</div>
          <p class="d2c-av-desc">Zero shipping threshold, 10% lifetime member discount, and 2 trees planted per order.</p>
        </div>

        <div class="d2c-avip-card">
          <div class="d2c-av-tag">TIER 3 // HEIRLOOM</div>
          <div class="d2c-av-title">FREE AYURVEDIC DOCTOR CONSULT</div>
          <p class="d2c-av-desc">Direct 1-on-1 video consultations with certified Ayush Vaidyas for custom wellness diets.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-avip-{{ section.id }} {
    background: #fbf9f4;
    padding: 70px 32px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-avip-container { max-width: 1360px; margin: 0 auto; }
  .d2c-avip-box {
    background: #f4ede2;
    border-radius: 12px;
    padding: 48px 36px;
    border: 1px solid rgba(46, 90, 68, 0.2);
  }
  .d2c-avip-sub { font-size: 15px; color: #4a6356; max-width: 520px; margin: 8px auto 0; text-align: center; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .d2c-avip-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-avip-card {
    background: #ffffff;
    border: 1px solid rgba(46, 90, 68, 0.15);
    border-radius: 8px;
    padding: 32px 24px;
    text-align: center;
    position: relative;
  }
  .d2c-avip-card.active { border: 2px solid #2e5a44; }
  .d2c-av-pill {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #2e5a44;
    color: #ffffff;
    font-size: 9px;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 99px;
    letter-spacing: 0.5px;
  }
  .d2c-av-tag { font-size: 10px; font-weight: 800; color: #2e5a44; letter-spacing: 1px; margin-bottom: 8px; }
  .d2c-av-title { font-size: 15px; font-weight: 800; color: #1c3829; margin-bottom: 10px; }
  .d2c-av-desc { font-size: 13px; color: #4a6356; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-avip-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Ayurveda VIP Perks",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "JOIN THE VEDIC WELLNESS COMMUNITY"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda VIP Perks"
    }
  ]
}
{% endschema %}
