{% comment %}
  D2C Clean Ayurveda Botanical Glow Hero
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-hero" id="d2c-ahero-{{ section.id }}">
  <div class="d2c-ahero-container">
    <div class="d2c-ahero-grid">
      <div class="d2c-ahero-text">
        <span class="d2c-ahero-badge">🍃 100% PURE COLD-PRESSED BOTANICALS</span>
        <h1 class="d2c-ahero-title">{{ section.settings.heading | default: "ANCIENT VEDIC RITUALS FOR CLINICAL RADIANCE" }}</h1>
        <p class="d2c-ahero-desc">
          Formulated with Kashmiri saffron, 24kt gold bhasma, and cold-pressed botanical extracts. Zero sulfates, zero parabens, zero mineral oils. 100% certified Made Safe.
        </p>

        <div class="d2c-ahero-actions">
          <a href="/collections/all" class="d2c-abtn-primary">SHOP BOTANICAL GLOW &rarr;</a>
          <a href="/pages/dosha-quiz" class="d2c-abtn-secondary">TAKE 60-SEC DOSHA TEST</a>
        </div>

        <div class="d2c-ahero-stats">
          <div class="d2c-astat"><strong>26</strong> <span>Vedic Herbs</span></div>
          <div class="d2c-astat"><strong>10-Free</strong> <span>Toxin Standards</span></div>
          <div class="d2c-astat"><strong>1 Tree</strong> <span>Planted Per Order</span></div>
        </div>
      </div>

      <div class="d2c-ahero-media">
        <div class="d2c-ahero-frame">
          <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=900&q=85" alt="Clean Ayurvedic Skincare" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-ahero-{{ section.id }} {
    background: #f4ede2;
    padding: 70px 32px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-ahero-container { max-width: 1360px; margin: 0 auto; }
  .d2c-ahero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }
  .d2c-ahero-badge {
    font-size: 11px;
    font-weight: 700;
    color: #2e5a44;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 16px;
    display: block;
  }
  .d2c-ahero-title {
    font-size: clamp(34px, 4vw, 50px);
    font-weight: 700;
    color: #1c3829;
    line-height: 1.15;
    margin-bottom: 20px;
    text-transform: uppercase;
  }
  .d2c-ahero-desc {
    font-size: 17px;
    color: #4a6356;
    line-height: 1.7;
    margin-bottom: 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    max-width: 540px;
  }
  .d2c-ahero-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }
  .d2c-abtn-primary {
    background: #2e5a44;
    color: #ffffff;
    padding: 16px 32px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
  }
  .d2c-abtn-secondary {
    background: transparent;
    border: 1px solid #2e5a44;
    color: #2e5a44;
    padding: 16px 28px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
  }
  .d2c-ahero-stats {
    display: flex;
    gap: 36px;
    border-top: 1px solid rgba(46, 90, 68, 0.2);
    padding-top: 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-astat strong { font-size: 22px; font-weight: 800; color: #1c3829; display: block; }
  .d2c-astat span { font-size: 12px; color: #4a6356; }
  .d2c-ahero-frame {
    border-radius: 180px 180px 12px 12px;
    overflow: hidden;
    border: 2px solid #2e5a44;
    box-shadow: 0 20px 40px -10px rgba(28, 56, 41, 0.15);
  }
  .d2c-ahero-frame img { width: 100%; height: 500px; object-fit: cover; }

  @media (max-width: 900px) {
    .d2c-ahero-grid { grid-template-columns: 1fr; }
    .d2c-ahero-frame img { height: 360px; }
    #d2c-ahero-{{ section.id }} { padding: 40px 18px; }
  }
</style>

{% schema %}
{
  "name": "Ayurveda Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ANCIENT VEDIC RITUALS FOR CLINICAL RADIANCE"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Hero"
    }
  ]
}
{% endschema %}
