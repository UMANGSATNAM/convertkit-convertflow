{% comment %}
  D2C Clean Ayurveda Certified Trust Badges
  Theme: Mamaearth / Forest Essentials Clean Ayurveda
{% endcomment %}

<section class="d2c-ayur-trust" id="d2c-atrust-{{ section.id }}">
  <div class="d2c-atrust-container">
    <div class="d2c-atrust-grid">
      <div class="d2c-atrust-item">
        <div class="d2c-atrust-icon">🌿</div>
        <h4 class="d2c-atrust-title">AYUSH MINISTRY APPROVED</h4>
        <p class="d2c-atrust-desc">Government authenticated 100% genuine Ayurvedic medicinal formulas.</p>
      </div>

      <div class="d2c-atrust-item">
        <div class="d2c-atrust-icon">🛡️</div>
        <h4 class="d2c-atrust-title">100% MADE SAFE CERTIFIED</h4>
        <p class="d2c-atrust-desc">Guaranteed free from 8,000+ known endocrine and skin toxins.</p>
      </div>

      <div class="d2c-atrust-item">
        <div class="d2c-atrust-icon">🌱</div>
        <h4 class="d2c-atrust-title">PLANT GOODNESS INITIATIVE</h4>
        <p class="d2c-atrust-desc">We plant a geo-tagged fruit tree for every single purchase on our store.</p>
      </div>

      <div class="d2c-atrust-item">
        <div class="d2c-atrust-icon">🔬</div>
        <h4 class="d2c-atrust-title">CLINICALLY DERM TESTED</h4>
        <p class="d2c-atrust-desc">Tested by independent Indian dermatologists for sensitive skin safety.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-atrust-{{ section.id }} {
    background: #1c3829;
    color: #ffffff;
    padding: 50px 32px;
    font-family: 'Playfair Display', Georgia, serif;
  }
  .d2c-atrust-container { max-width: 1360px; margin: 0 auto; }
  .d2c-atrust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    text-align: center;
  }
  .d2c-atrust-item {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(134, 239, 172, 0.2);
    border-radius: 8px;
    padding: 28px 20px;
  }
  .d2c-atrust-icon { font-size: 26px; margin-bottom: 12px; }
  .d2c-atrust-title { font-size: 13px; font-weight: 700; color: #86efac; letter-spacing: 1px; margin-bottom: 6px; text-transform: uppercase; }
  .d2c-atrust-desc { font-size: 12px; color: #e8f5e9; line-height: 1.5; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }

  @media (max-width: 900px) { .d2c-atrust-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-atrust-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Ayurveda Trust Badges",
  "settings": [],
  "presets": [
    {
      "name": "Ayurveda Trust Badges"
    }
  ]
}
{% endschema %}
