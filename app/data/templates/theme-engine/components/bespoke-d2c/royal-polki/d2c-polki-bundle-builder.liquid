{% comment %}
  D2C Royal Polki Complete Trousseau Suite
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-bundle" id="d2c-pbundle-{{ section.id }}">
  <div class="d2c-pbundle-container">
    <div class="d2c-pbundle-box">
      <div class="d2c-pbundle-info">
        <span class="d2c-p-badge">BRIDAL TROUSSEAU VAULT</span>
        <h2 class="d2c-pbundle-title">{{ section.settings.title | default: "THE IMPERIAL 3-PIECE BRIDAL SET" }}</h2>
        <p class="d2c-pbundle-desc">
          The ultimate royal bridal ensemble: 22kt Jadau Choker + Grand 7-Row Raani Haar + Matching Chandbalis. Handcrafted in Jaipur with complimentary private locker delivery.
        </p>
        <div class="d2c-pbundle-price">SUITE VALUATION: ₹13,95,000 <span class="d2c-pb-orig">₹15,20,000</span> <span class="d2c-pb-save">SAVE ₹1,25,000</span></div>
        <button class="d2c-pb-btn">CLAIM BRIDAL TROUSSEAU SUITE &rarr;</button>
      </div>

      <div class="d2c-pbundle-visual">
        <div class="d2c-pbi-card">
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=400&q=80" alt="Polki Choker" />
          <span>Jadau Choker</span>
        </div>
        <span class="d2c-pbi-plus">+</span>
        <div class="d2c-pbi-card">
          <img src="https://images.unsplash.com/photo-1600003014755-ba31aa59c4b6?w=400&q=80" alt="Raani Haar" />
          <span>Raani Haar</span>
        </div>
        <span class="d2c-pbi-plus">+</span>
        <div class="d2c-pbi-card">
          <img src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=400&q=80" alt="Chandbalis" />
          <span>Chandbalis</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-pbundle-{{ section.id }} {
    background: #190e04;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-pbundle-container { max-width: 1360px; margin: 0 auto; }
  .d2c-pbundle-box {
    background: #201306;
    border-radius: 12px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    border: 1px solid rgba(234, 179, 8, 0.3);
  }
  .d2c-pbundle-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #fef08a; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-pbundle-desc { font-size: 15px; color: #fef9c3; line-height: 1.6; margin-bottom: 24px; }
  .d2c-pbundle-price { font-size: 20px; font-weight: 900; color: #ffffff; margin-bottom: 28px; }
  .d2c-pb-orig { font-size: 14px; color: #a1a1aa; text-decoration: line-through; margin-left: 6px; }
  .d2c-pb-save { background: rgba(234, 179, 8, 0.2); color: #fde047; font-size: 11px; font-weight: 800; padding: 4px 8px; border-radius: 4px; margin-left: 8px; border: 1px solid #eab308; }
  .d2c-pb-btn {
    background: linear-gradient(135deg, #eab308 0%, #ca8a04 100%);
    color: #190e04;
    border: none;
    padding: 16px 32px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.5px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-pbundle-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .d2c-pbi-card {
    background: #140b03;
    border: 1px solid rgba(234, 179, 8, 0.25);
    border-radius: 8px;
    overflow: hidden;
    text-align: center;
    padding: 8px;
    width: 120px;
  }
  .d2c-pbi-card img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; margin-bottom: 6px; }
  .d2c-pbi-card span { font-size: 10px; font-weight: 800; color: #fef08a; }
  .d2c-pbi-plus { font-size: 20px; font-weight: 800; color: #eab308; }

  @media (max-width: 900px) {
    .d2c-pbundle-box { grid-template-columns: 1fr; padding: 24px; }
  }
</style>

{% schema %}
{
  "name": "Polki Bundle Box",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE IMPERIAL 3-PIECE BRIDAL SET"
    }
  ],
  "presets": [
    {
      "name": "Polki Bundle Box"
    }
  ]
}
{% endschema %}
