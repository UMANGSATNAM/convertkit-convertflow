{% comment %}
  D2C Royal Polki Imperial Bridal Hero
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-hero" id="d2c-phero-{{ section.id }}">
  <div class="d2c-phero-container">
    <div class="d2c-phero-grid">
      <div class="d2c-phero-text">
        <span class="d2c-phero-badge">👑 BIS 916 HALLMARKED • 100% NATURAL POLKI</span>
        <h1 class="d2c-phero-title">{{ section.settings.heading | default: "HEIRLOOM RAJPUTANA BRIDAL MASTERPIECES" }}</h1>
        <p class="d2c-phero-desc">
          Handcrafted in Jaipur by master Karigars with uncut syndicate polki diamonds, Zambian emerald drops, and 24kt pure gold foil jadau settings. Handed down across generations.
        </p>

        <div class="d2c-phero-actions">
          <a href="/collections/all" class="d2c-pbtn-primary">EXPLORE THE BRIDAL VAULT &rarr;</a>
          <a href="/pages/book-appointment" class="d2c-pbtn-secondary">BOOK 1-ON-1 VIDEO SALON</a>
        </div>

        <div class="d2c-phero-specs">
          <div class="d2c-pspec"><strong>22KT</strong> <span>BIS Hallmarked Gold</span></div>
          <div class="d2c-pspec"><strong>100%</strong> <span>Natural Syndicate Polki</span></div>
          <div class="d2c-pspec"><strong>100%</strong> <span>Lifetime Buyback Value</span></div>
        </div>
      </div>

      <div class="d2c-phero-media">
        <div class="d2c-phero-frame">
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=900&q=85" alt="Royal Kundan Polki Choker" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-phero-{{ section.id }} {
    background: #190e04;
    color: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-phero-container { max-width: 1360px; margin: 0 auto; }
  .d2c-phero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }
  .d2c-phero-badge {
    font-size: 11px;
    font-weight: 800;
    color: #fde047;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 16px;
    display: block;
  }
  .d2c-phero-title {
    font-size: clamp(34px, 4vw, 50px);
    font-weight: 900;
    color: #fef08a;
    line-height: 1.15;
    letter-spacing: -0.5px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }
  .d2c-phero-desc {
    font-size: 16px;
    color: #fef9c3;
    line-height: 1.7;
    margin-bottom: 32px;
    max-width: 540px;
  }
  .d2c-phero-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }
  .d2c-pbtn-primary {
    background: linear-gradient(135deg, #eab308 0%, #ca8a04 100%);
    color: #190e04;
    padding: 16px 32px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
  }
  .d2c-pbtn-secondary {
    background: transparent;
    border: 1px solid #eab308;
    color: #fde047;
    padding: 16px 28px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
  }
  .d2c-phero-specs {
    display: flex;
    gap: 36px;
    border-top: 1px solid rgba(234, 179, 8, 0.25);
    padding-top: 24px;
  }
  .d2c-pspec strong { font-size: 22px; font-weight: 900; color: #fde047; display: block; }
  .d2c-pspec span { font-size: 12px; color: #fef9c3; }
  .d2c-phero-frame {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(234, 179, 8, 0.4);
    box-shadow: 0 20px 45px -10px rgba(0,0,0,0.9);
  }
  .d2c-phero-frame img { width: 100%; height: 500px; object-fit: cover; }

  @media (max-width: 900px) {
    .d2c-phero-grid { grid-template-columns: 1fr; }
    .d2c-phero-frame img { height: 360px; }
    #d2c-phero-{{ section.id }} { padding: 40px 18px; }
  }
</style>

{% schema %}
{
  "name": "Polki Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HEIRLOOM RAJPUTANA BRIDAL MASTERPIECES"
    }
  ],
  "presets": [
    {
      "name": "Polki Hero"
    }
  ]
}
{% endschema %}
