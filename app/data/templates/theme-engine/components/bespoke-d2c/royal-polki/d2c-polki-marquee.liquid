<style>
  #d2c-pribbon-{{ section.id }} {
    background: linear-gradient(90deg, #ca8a04 0%, #eab308 50%, #ca8a04 100%);
    color: #190e04;
    overflow: hidden;
    white-space: nowrap;
    padding: 12px 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .d2c-pribbon-track { display: flex; overflow: hidden; }
  .d2c-pribbon-content {
    display: flex;
    align-items: center;
    gap: 32px;
    animation: d2c-pribbon-scroll 22s linear infinite;
  }
  .d2c-pribbon-sep { font-size: 14px; color: #190e04; opacity: 0.7; }
  @keyframes d2c-pribbon-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
</style>

{% schema %}
{
  "name": "Polki Ribbon",
