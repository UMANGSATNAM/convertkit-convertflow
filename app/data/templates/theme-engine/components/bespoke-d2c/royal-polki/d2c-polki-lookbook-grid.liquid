{% comment %}
  D2C Royal Polki Lookbook Grid
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-lookbook" id="d2c-plb-{{ section.id }}">
  <div class="d2c-plb-container">
    <div class="d2c-psec-header">
      <span class="d2c-p-badge">ROYAL BRIDAL ARCHIVES</span>
      <h2 class="d2c-p-title">{{ section.settings.title | default: "PALACE WEDDING HEIRLOOM CHRONICLES" }}</h2>
    </div>

    <div class="d2c-plb-grid">
      <div class="d2c-plb-card large">
        <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=800&q=80" alt="Rajputana Bride" />
        <div class="d2c-plb-overlay">
          <span class="d2c-plb-tag">THE RAJGHARANA TROUSSEAU</span>
          <h3 class="d2c-plb-name">22KT JADAU CHOKER + CHANDBALIS</h3>
          <span class="d2c-plb-link">VIEW HEIRLOOM SET &rarr;</span>
        </div>
      </div>

      <div class="d2c-plb-card">
        <img src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=600&q=80" alt="Sangeet Polki" />
        <div class="d2c-plb-overlay">
          <span class="d2c-plb-tag">SANGEET EMERALD</span>
          <h3 class="d2c-plb-name">ZAMBIAN DROP BALIS</h3>
          <span class="d2c-plb-link">VIEW &rarr;</span>
        </div>
      </div>

      <div class="d2c-plb-card">
        <img src="https://images.unsplash.com/photo-1600003014755-ba31aa59c4b6?w=600&q=80" alt="Temple Haar" />
        <div class="d2c-plb-overlay">
          <span class="d2c-plb-tag">SOUTH TEMPLE NAKSHI</span>
          <h3 class="d2c-plb-name">ANTIQUE RAANI HAAR</h3>
          <span class="d2c-plb-link">VIEW &rarr;</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-plb-{{ section.id }} {
    background: #190e04;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-plb-container { max-width: 1360px; margin: 0 auto; }
  .d2c-plb-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 24px;
  }
  .d2c-plb-card {
    position: relative;
    height: 480px;
    border-radius: 12px;
    overflow: hidden;
    background: #201306;
    border: 1px solid rgba(234, 179, 8, 0.3);
  }
  .d2c-plb-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .d2c-plb-card:hover img { transform: scale(1.04); }
  .d2c-plb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(25,14,4,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px;
    color: #ffffff;
  }
  .d2c-plb-tag { font-size: 10px; font-weight: 800; color: #fde047; letter-spacing: 1px; margin-bottom: 4px; }
  .d2c-plb-name { font-size: 16px; font-weight: 900; margin-bottom: 8px; color: #fef08a; }
  .d2c-plb-link { font-size: 11px; font-weight: 800; color: #fef9c3; }

  @media (max-width: 900px) {
    .d2c-plb-grid { grid-template-columns: 1fr; }
    .d2c-plb-card { height: 340px; }
  }
</style>

{% schema %}
{
  "name": "Polki Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "PALACE WEDDING HEIRLOOM CHRONICLES"
    }
  ],
  "presets": [
    {
      "name": "Polki Lookbook"
    }
  ]
}
{% endschema %}
