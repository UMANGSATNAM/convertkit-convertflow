{% comment %}
  D2C Royal Polki Verified Heirloom Reviews
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-reviews" id="d2c-prev-{{ section.id }}">
  <div class="d2c-prev-container">
    <div class="d2c-psec-header">
      <span class="d2c-p-badge">PATRON TESTIMONIALS</span>
      <h2 class="d2c-p-title">{{ section.settings.title | default: "HEIRLOOMS CHERISHED ACROSS GENERATIONS" }}</h2>
    </div>

    <div class="d2c-prev-grid">
      <div class="d2c-prev-card">
        <div class="d2c-prev-stars">★★★★★</div>
        <p class="d2c-prev-quote">"The Phool-Mahal Jadau Choker was the centerpiece of my Udaipur palace wedding. The gold hallmarking, certificate of diamond origin, and private salon concierge service were truly royal."</p>
        <div class="d2c-prev-author">
          <span class="d2c-prev-name">Yuvrani Devika Rathore</span>
          <span class="d2c-prev-loc">Jaipur • Heirloom Polki Choker</span>
        </div>
      </div>

      <div class="d2c-prev-card">
        <div class="d2c-prev-stars">★★★★★</div>
        <p class="d2c-prev-quote">"Ordered the 7-row Basra Pearl Raani Haar with video consultation from London. Arrived via armored courier with tamper-proof seal. The Jadau setting is pure poetry."</p>
        <div class="d2c-prev-author">
          <span class="d2c-prev-name">Aarti Singhania</span>
          <span class="d2c-prev-loc">London / Delhi • Raani Haar</span>
        </div>
      </div>

      <div class="d2c-prev-card">
        <div class="d2c-prev-stars">★★★★★</div>
        <p class="d2c-prev-quote">"The craftsmanship of the Pacheli Kadas is indistinguishable from my grandmother's royal antique jewelry. The enamel work on the reverse is immaculate."</p>
        <div class="d2c-prev-author">
          <span class="d2c-prev-name">Gayatri Scindia</span>
          <span class="d2c-prev-loc">Gwalior • Jadau Pacheli Kada</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-prev-{{ section.id }} {
    background: #140b03;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-prev-container { max-width: 1360px; margin: 0 auto; }
  .d2c-prev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .d2c-prev-card {
    background: #201306;
    border: 1px solid rgba(234, 179, 8, 0.25);
    border-radius: 8px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .d2c-prev-stars { color: #fde047; font-size: 16px; margin-bottom: 12px; }
  .d2c-prev-quote { font-size: 14px; color: #fef9c3; line-height: 1.6; margin-bottom: 20px; }
  .d2c-prev-name { font-size: 15px; font-weight: 900; color: #fef08a; display: block; margin-bottom: 2px; }
  .d2c-prev-loc { font-size: 11px; color: #ca8a04; font-weight: 700; }

  @media (max-width: 900px) { .d2c-prev-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Polki Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HEIRLOOMS CHERISHED ACROSS GENERATIONS"
    }
  ],
  "presets": [
    {
      "name": "Polki Reviews"
    }
  ]
}
{% endschema %}
