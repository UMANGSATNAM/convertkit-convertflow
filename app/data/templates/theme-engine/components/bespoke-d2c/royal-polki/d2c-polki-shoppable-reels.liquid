{% comment %}
  D2C Royal Polki Atelier Craftsmanship Reels
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-reels" id="d2c-preels-{{ section.id }}">
  <div class="d2c-preels-container">
    <div class="d2c-psec-header">
      <span class="d2c-p-badge">ATELIER CHRONICLES</span>
      <h2 class="d2c-p-title">{{ section.settings.title | default: "WATCH THE JAIPUR MASTER CRAFTSMEN AT WORK" }}</h2>
    </div>

    <div class="d2c-preels-grid">
      <div class="d2c-preel-card">
        <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Jadau Setting Craft" />
        <div class="d2c-preel-overlay">
          <span class="d2c-preel-tag">24KT GOLD FOIL JADAU</span>
          <h4 class="d2c-preel-name">Hand-setting 18.5 cts Uncut Polki</h4>
          <span class="d2c-preel-pill">Padmavati Choker · ₹4,85,000</span>
        </div>
      </div>

      <div class="d2c-preel-card">
        <img src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=600&q=80" alt="Meenakari Enamel" />
        <div class="d2c-preel-overlay">
          <span class="d2c-preel-tag">ROYAL MEENAKARI</span>
          <h4 class="d2c-preel-name">Vibrant Reverse Enamel Artistry</h4>
          <span class="d2c-preel-pill">Jodha Chandbalis · ₹2,45,000</span>
        </div>
      </div>

      <div class="d2c-preel-card">
        <img src="https://images.unsplash.com/photo-1600003014755-ba31aa59c4b6?w=600&q=80" alt="Basra Pearl Stringing" />
        <div class="d2c-preel-overlay">
          <span class="d2c-preel-tag">NATURAL BASRA PEARLS</span>
          <h4 class="d2c-preel-name">7-Row Imperial Stringing Ceremony</h4>
          <span class="d2c-preel-pill">Raani Haar · ₹7,20,000</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-preels-{{ section.id }} {
    background: #190e04;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-preels-container { max-width: 1360px; margin: 0 auto; }
  .d2c-preels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .d2c-preel-card {
    position: relative;
    aspect-ratio: 9/16;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(234, 179, 8, 0.3);
    cursor: pointer;
  }
  .d2c-preel-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .d2c-preel-card:hover img { transform: scale(1.05); }
  .d2c-preel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(25,14,4,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: #ffffff;
  }
  .d2c-preel-tag { font-size: 10px; font-weight: 800; color: #fde047; letter-spacing: 1px; margin-bottom: 4px; }
  .d2c-preel-name { font-size: 15px; font-weight: 800; margin-bottom: 12px; color: #fef08a; }
  .d2c-preel-pill {
    background: #eab308;
    color: #190e04;
    font-size: 11px;
    font-weight: 900;
    padding: 6px 14px;
    border-radius: 4px;
    display: inline-block;
    align-self: flex-start;
  }

  @media (max-width: 900px) { .d2c-preels-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Polki Reels",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "WATCH THE JAIPUR MASTER CRAFTSMEN AT WORK"
    }
  ],
  "presets": [
    {
      "name": "Polki Reels"
    }
  ]
}
{% endschema %}
