{% comment %}
  D2C Royal Polki Brides Gallery
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-ugc" id="d2c-pugc-{{ section.id }}">
  <div class="d2c-pugc-container">
    <div class="d2c-psec-header">
      <span class="d2c-p-badge">#RAJGHARANABRIDES</span>
      <h2 class="d2c-p-title">{{ section.settings.title | default: "HEIRLOOM STORIES OF 20,000+ ROYAL BRIDES" }}</h2>
    </div>

    <div class="d2c-pugc-grid">
      <div class="d2c-pugc-tile"><img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Bride 1" /><span>@radhika_wedding · Phool-Mahal Choker</span></div>
      <div class="d2c-pugc-tile"><img src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=600&q=80" alt="Bride 2" /><span>@meera_heritage · Jodha Balis</span></div>
      <div class="d2c-pugc-tile"><img src="https://images.unsplash.com/photo-1611591475152-478d1c582489?w=600&q=80" alt="Bride 3" /><span>@ananya_royals · Pacheli Kada</span></div>
      <div class="d2c-pugc-tile"><img src="https://images.unsplash.com/photo-1600003014755-ba31aa59c4b6?w=600&q=80" alt="Bride 4" /><span>@ishita_palace · 7-Row Raani Haar</span></div>
    </div>
  </div>
</section>

<style>
  #d2c-pugc-{{ section.id }} {
    background: #190e04;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-pugc-container { max-width: 1360px; margin: 0 auto; }
  .d2c-pugc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .d2c-pugc-tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    background: #201306;
    border: 1px solid rgba(234, 179, 8, 0.3);
  }
  .d2c-pugc-tile img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-pugc-tile span {
    position: absolute;
    bottom: 8px;
    left: 8px;
    right: 8px;
    background: rgba(25,14,4,0.9);
    color: #fef08a;
    font-size: 11px;
    font-weight: 800;
    padding: 6px;
    text-align: center;
    border-radius: 4px;
  }

  @media (max-width: 900px) { .d2c-pugc-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

{% schema %}
{
  "name": "Polki Community",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HEIRLOOM STORIES OF 20,000+ ROYAL BRIDES"
    }
  ],
  "presets": [
    {
      "name": "Polki Community"
    }
  ]
}
{% endschema %}
