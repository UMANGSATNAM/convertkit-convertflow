{% comment %}
  D2C Royal Polki Announcement Bar
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<div class="d2c-polki-announcement" id="d2c-pann-{{ section.id }}">
  <div class="d2c-pann-inner">
    <span>👑</span>
    <span class="d2c-pann-text">{{ section.settings.text | default: "FESTIVE BRIDAL EDIT '26 // FLAT 25% OFF MAKING CHARGES ON POLKI SETS" }}</span>
    <span class="d2c-pann-sep">✦</span>
    <span class="d2c-pann-sub">100% BIS 916 HALLMARKED GOLD</span>
  </div>
</div>

<style>
  #d2c-pann-{{ section.id }} {
    background: #201306;
    color: #fef08a;
    padding: 10px 16px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-align: center;
    border-bottom: 1px solid rgba(234, 179, 8, 0.4);
  }
  .d2c-pann-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }
  .d2c-pann-sub { color: #fde047; font-weight: 900; }
  .d2c-pann-sep { opacity: 0.6; }
  @media (max-width: 768px) { #d2c-pann-{{ section.id }} { font-size: 11px; padding: 8px 12px; } .d2c-pann-sub { display: none; } }
</style>

{% schema %}
{
  "name": "Polki Announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "FESTIVE BRIDAL EDIT '26 // FLAT 25% OFF MAKING CHARGES ON POLKI SETS"
    }
  ],
  "presets": [
    {
      "name": "Polki Announcement"
    }
  ]
}
{% endschema %}
