{% comment %}
  D2C Royal Polki Connoisseur Club
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-vip" id="d2c-pvip-{{ section.id }}">
  <div class="d2c-pvip-container">
    <div class="d2c-pvip-box">
      <div class="d2c-psec-header">
        <span class="d2c-p-badge">PATRON PRIVILEGES</span>
        <h2 class="d2c-p-title">{{ section.settings.title | default: "THE IMPERIAL PATRON PRIVILEGE" }}</h2>
        <p class="d2c-pvip-desc">Exclusive invitations to private palace exhibitions, bespoke bridal consultations, and zero making charge privileges.</p>
      </div>

      <div class="d2c-pvip-grid">
        <div class="d2c-pvip-card">
          <div class="d2c-pv-tag">TIER 1 // RAJ PATRON</div>
          <div class="d2c-pv-title">LIFETIME FREE POLKI CLEANING</div>
          <p class="d2c-pv-desc">Complimentary annual ultrasonic cleaning, gold polishing, and silk dori re-stringing.</p>
        </div>

        <div class="d2c-pvip-card popular">
          <span class="d2c-pv-pill">ROYAL BRIDAL</span>
          <div class="d2c-pv-tag">TIER 2 // MAHARAJA CIRCLE</div>
          <div class="d2c-pv-title">HOME VAULT BRIDAL PREVIEW</div>
          <p class="d2c-pv-desc">High-security curated bridal suite brought directly to your home with senior jewelry stylists.</p>
        </div>

        <div class="d2c-pvip-card">
          <div class="d2c-pv-tag">TIER 3 // IMPERIAL GUILD</div>
          <div class="d2c-pv-title">CUSTOM 1-OF-1 ATELIER DESIGNS</div>
          <p class="d2c-pv-desc">Direct collaboration with Jaipur master designers to handcraft custom family crests and jewelry.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-pvip-{{ section.id }} {
    background: #190e04;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-pvip-container { max-width: 1360px; margin: 0 auto; }
  .d2c-pvip-box {
    background: #201306;
    border-radius: 12px;
    padding: 48px 36px;
    border: 1px solid rgba(234, 179, 8, 0.3);
  }
  .d2c-pvip-desc { font-size: 15px; color: #fef9c3; max-width: 540px; margin: 8px auto 0; text-align: center; }
  .d2c-pvip-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .d2c-pvip-card {
    background: #140b03;
    border: 1px solid rgba(234, 179, 8, 0.25);
    border-radius: 8px;
    padding: 32px 24px;
    text-align: center;
    position: relative;
  }
  .d2c-pvip-card.popular { border: 2px solid #eab308; }
  .d2c-pv-pill {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #eab308 0%, #ca8a04 100%);
    color: #190e04;
    font-size: 9px;
    font-weight: 900;
    padding: 3px 10px;
    border-radius: 4px;
    letter-spacing: 1px;
  }
  .d2c-pv-tag { font-size: 10px; font-weight: 800; color: #fde047; letter-spacing: 1px; margin-bottom: 8px; }
  .d2c-pv-title { font-size: 14px; font-weight: 900; color: #fef08a; margin-bottom: 10px; }
  .d2c-pv-desc { font-size: 13px; color: #fef9c3; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-pvip-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Polki VIP Perks",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE IMPERIAL PATRON PRIVILEGE"
    }
  ],
  "presets": [
    {
      "name": "Polki VIP Perks"
    }
  ]
}
{% endschema %}
