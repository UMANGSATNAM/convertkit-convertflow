{% comment %}
  D2C Royal Polki Atelier Header
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<header class="d2c-polki-header" id="d2c-phead-{{ section.id }}">
  <div class="d2c-phead-container">
    <div class="d2c-phead-left">
      <a href="/collections/polki-chokers" class="d2c-pnav-link">CHOKERS</a>
      <a href="/collections/jadau-jhumkas" class="d2c-pnav-link">JHUMKAS</a>
      <a href="/collections/temple-gold" class="d2c-pnav-link">TEMPLE GOLD</a>
    </div>

    <div class="d2c-phead-logo-box">
      <a href="/" class="d2c-phead-logo">
        <span class="d2c-plogo-title">{{ section.settings.brand_name | default: "AMRAPALI RAJGHARANA" }}</span>
        <span class="d2c-plogo-sub">ROYAL JAIPUR POLKI & 22KT GOLD SINCE 1904</span>
      </a>
    </div>

    <div class="d2c-phead-right">
      <div class="d2c-pgold-rate">👑 22KT: ₹6,840/g</div>
      <a href="/pages/book-appointment" class="d2c-pnav-link highlight">VIDEO CONSULT</a>
      <a href="/cart" class="d2c-pnav-link">VAULT ({{ cart.item_count | default: 0 }})</a>
    </div>
  </div>
</header>

<style>
  #d2c-phead-{{ section.id }} {
    background: #190e04;
    border-bottom: 1px solid rgba(234, 179, 8, 0.3);
    padding: 20px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  .d2c-phead-container {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1.2fr;
    align-items: center;
  }
  .d2c-phead-left { display: flex; gap: 28px; }
  .d2c-phead-right { display: flex; gap: 24px; justify-content: flex-end; align-items: center; }
  .d2c-pnav-link {
    color: #fef08a;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-decoration: none;
    text-transform: uppercase;
  }
  .d2c-pgold-rate {
    font-size: 11px;
    font-weight: 800;
    color: #fde047;
    background: rgba(234, 179, 8, 0.15);
    border: 1px solid rgba(234, 179, 8, 0.4);
    padding: 5px 12px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }
  .d2c-pnav-link.highlight {
    background: linear-gradient(135deg, #eab308 0%, #ca8a04 100%);
    color: #190e04;
    padding: 6px 16px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 900;
  }
  .d2c-phead-logo {
    text-align: center;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .d2c-plogo-title {
    font-size: 22px;
    font-weight: 900;
    color: #fef08a;
    letter-spacing: 3px;
    text-transform: uppercase;
  }
  .d2c-plogo-sub {
    font-size: 9px;
    color: #ca8a04;
    letter-spacing: 2px;
    margin-top: 2px;
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .d2c-phead-left, .d2c-pgold-rate { display: none; }
    .d2c-phead-container { display: flex; justify-content: space-between; }
    #d2c-phead-{{ section.id }} { padding: 14px 18px; }
  }
</style>

{% schema %}
{
  "name": "Polki Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "AMRAPALI RAJGHARANA"
    }
  ],
  "presets": [
    {
      "name": "Polki Header"
    }
  ]
}
{% endschema %}
