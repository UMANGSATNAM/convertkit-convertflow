{% comment %}
  D2C Royal Polki Atelier Footer
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<footer class="d2c-polki-footer" id="d2c-pfoot-{{ section.id }}">
  <div class="d2c-pfoot-container">
    <div class="d2c-pfoot-top">
      <div class="d2c-pfoot-brand">
        <h3 class="d2c-pfoot-logo">{{ section.settings.brand_name | default: "AMRAPALI RAJGHARANA" }}</h3>
        <p class="d2c-pfoot-desc">Preserving royal Indian heritage through 22kt BIS hallmarked gold, uncut syndicate polki diamonds, and timeless Jaipur Jadau karigari.</p>
        <div class="d2c-pfoot-huid">👑 100% BIS 916 HUID CERTIFIED ATELIER</div>
      </div>

      <div class="d2c-pfoot-col">
        <h4 class="d2c-pcol-title">JEWELLERY ATELIER</h4>
        <ul class="d2c-pcol-links">
          <li><a href="/collections/polki-chokers">Bridal Polki Chokers</a></li>
          <li><a href="/collections/temple-haar">Heritage Raani Haar</a></li>
          <li><a href="/collections/jadau-jhumkas">Royal Chandbalis & Jhumkas</a></li>
          <li><a href="/collections/polki-kadas">Pacheli & Antique Kadas</a></li>
          <li><a href="/collections/bridal-sets">Full Bridal Trousseau Sets</a></li>
        </ul>
      </div>

      <div class="d2c-pfoot-col">
        <h4 class="d2c-pcol-title">ROYAL CONCIERGE</h4>
        <ul class="d2c-pcol-links">
          <li><a href="/pages/track-order">Track Armored Delivery</a></li>
          <li><a href="/pages/book-appointment">Book Private Video Salon</a></li>
          <li><a href="/pages/purity-certificate">Verify BIS Hallmark HUID</a></li>
          <li><a href="/pages/stores">Locate Flagship Boutiques</a></li>
          <li><a href="/pages/contact">WhatsApp Jewellery Concierge</a></li>
        </ul>
      </div>

      <div class="d2c-pfoot-col">
        <h4 class="d2c-pcol-title">VALUATION & BUYBACK</h4>
        <p class="d2c-pfoot-sub-desc">100% lifetime buyback assurance on gold market value with complete transparency on gemstone weights and making charges.</p>
      </div>
    </div>

    <div class="d2c-pfoot-bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: "AMRAPALI RAJGHARANA JEWELLERS PVT. LTD." }}. ALL RIGHTS RESERVED.</div>
      <div class="d2c-pfoot-legal">
        <a href="/policies/privacy-policy">Privacy Disclosure</a>
        <a href="/policies/terms-of-service">Terms of Supply</a>
        <a href="/policies/shipping-policy">Armored Transit Terms</a>
      </div>
    </div>
  </div>
</footer>

<style>
  #d2c-pfoot-{{ section.id }} {
    background: #140b03;
    color: #fef9c3;
    padding: 70px 32px 30px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
    border-top: 1px solid rgba(234, 179, 8, 0.3);
  }
  .d2c-pfoot-container { max-width: 1360px; margin: 0 auto; }
  .d2c-pfoot-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .d2c-pfoot-logo { font-size: 20px; font-weight: 900; color: #fef08a; letter-spacing: 2px; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-pfoot-desc { font-size: 13px; color: #fef9c3; line-height: 1.6; margin-bottom: 16px; max-width: 320px; }
  .d2c-pfoot-huid { font-size: 11px; font-weight: 800; color: #fde047; }
  .d2c-pcol-title { font-size: 12px; font-weight: 900; color: #fef08a; letter-spacing: 1px; margin-bottom: 16px; text-transform: uppercase; }
  .d2c-pcol-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .d2c-pcol-links a { color: #fef9c3; text-decoration: none; font-size: 13px; opacity: 0.85; transition: opacity 0.15s ease; }
  .d2c-pcol-links a:hover { opacity: 1; color: #fde047; }
  .d2c-pfoot-sub-desc { font-size: 13px; line-height: 1.6; opacity: 0.85; }
  .d2c-pfoot-bottom {
    border-top: 1px solid rgba(234, 179, 8, 0.2);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
  }
  .d2c-pfoot-legal { display: flex; gap: 20px; }
  .d2c-pfoot-legal a { color: inherit; text-decoration: none; }
  .d2c-pfoot-legal a:hover { color: #fef08a; }

  @media (max-width: 1024px) { .d2c-pfoot-top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) {
    .d2c-pfoot-top { grid-template-columns: 1fr; }
    .d2c-pfoot-bottom { flex-direction: column; gap: 12px; text-align: center; }
  }
</style>

{% schema %}
{
  "name": "Polki Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "AMRAPALI RAJGHARANA"
    }
  ],
  "presets": [
    {
      "name": "Polki Footer"
    }
  ]
}
{% endschema %}
