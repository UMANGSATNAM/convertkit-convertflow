{% comment %}
  D2C Royal Polki Bestseller Vault
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-best" id="d2c-pbest-{{ section.id }}">
  <div class="d2c-pbest-container">
    <div class="d2c-psec-header">
      <span class="d2c-p-badge">MASTERPIECE VAULT</span>
      <h2 class="d2c-p-title">{{ section.settings.title | default: "ICONIC HEIRLOOM MASTERWORKS" }}</h2>
    </div>

    <div class="d2c-pprod-grid">
      <!-- Item 1 -->
      <div class="d2c-pprod-card">
        <div class="d2c-pprod-thumb">
          <span class="d2c-pprod-pill">22KT BIS HALLMARKED</span>
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Padmavati Polki Choker" />
        </div>
        <div class="d2c-pprod-body">
          <span class="d2c-pprod-metal">GOLD WT: 64.2g • POLKI: 18.5 cts</span>
          <h3 class="d2c-pprod-title">The Padmavati Jadau Polki Choker</h3>
          <div class="d2c-pprod-price">₹4,85,000 <span class="d2c-pprod-orig">₹5,20,000</span></div>
          <button class="d2c-patc-btn">VIEW ATELIER DETAILS</button>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="d2c-pprod-card">
        <div class="d2c-pprod-thumb">
          <span class="d2c-pprod-pill">COLOMBIAN EMERALD</span>
          <img src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=600&q=80" alt="Jadau Chandbalis" />
        </div>
        <div class="d2c-pprod-body">
          <span class="d2c-pprod-metal">GOLD WT: 32.8g • POLKI: 8.2 cts</span>
          <h3 class="d2c-pprod-title">Jodha Royal Jadau Chandbalis</h3>
          <div class="d2c-pprod-price">₹2,45,000 <span class="d2c-pprod-orig">₹2,75,000</span></div>
          <button class="d2c-patc-btn">VIEW ATELIER DETAILS</button>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="d2c-pprod-card">
        <div class="d2c-pprod-thumb">
          <span class="d2c-pprod-pill">24KT GOLD MEENAKARI</span>
          <img src="https://images.unsplash.com/photo-1611591475152-478d1c582489?w=600&q=80" alt="Pacheli Kada" />
        </div>
        <div class="d2c-pprod-body">
          <span class="d2c-pprod-metal">GOLD WT: 48.5g (PAIR) • POLKI: 12 cts</span>
          <h3 class="d2c-pprod-title">Jaipur Royal Pacheli Kada (Pair)</h3>
          <div class="d2c-pprod-price">₹3,95,000 <span class="d2c-pprod-orig">₹4,30,000</span></div>
          <button class="d2c-patc-btn">VIEW ATELIER DETAILS</button>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="d2c-pprod-card">
        <div class="d2c-pprod-thumb">
          <span class="d2c-pprod-pill">BASRA PEARLS</span>
          <img src="https://images.unsplash.com/photo-1600003014755-ba31aa59c4b6?w=600&q=80" alt="Raani Haar" />
        </div>
        <div class="d2c-pprod-body">
          <span class="d2c-pprod-metal">GOLD WT: 92.4g • POLKI: 28 cts</span>
          <h3 class="d2c-pprod-title">Imperial 7-Row Basra Pearl Raani Haar</h3>
          <div class="d2c-pprod-price">₹7,20,000 <span class="d2c-pprod-orig">₹7,80,000</span></div>
          <button class="d2c-patc-btn">VIEW ATELIER DETAILS</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-pbest-{{ section.id }} {
    background: #140b03;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-pbest-container { max-width: 1360px; margin: 0 auto; }
  .d2c-pprod-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .d2c-pprod-card {
    background: #201306;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(234, 179, 8, 0.25);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .d2c-pprod-thumb { position: relative; aspect-ratio: 1; overflow: hidden; background: #2d1b0a; }
  .d2c-pprod-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-pprod-pill {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #eab308;
    color: #190e04;
    font-size: 9px;
    font-weight: 900;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }
  .d2c-pprod-body { padding: 18px; display: flex; flex-direction: column; flex-grow: 1; justify-content: space-between; }
  .d2c-pprod-metal { font-size: 10px; font-weight: 800; color: #fde047; letter-spacing: 0.5px; margin-bottom: 4px; font-family: monospace; }
  .d2c-pprod-title { font-size: 14px; font-weight: 800; color: #fef08a; margin-bottom: 10px; }
  .d2c-pprod-price { font-size: 16px; font-weight: 900; color: #ffffff; margin-bottom: 14px; }
  .d2c-pprod-orig { font-size: 12px; color: #a1a1aa; text-decoration: line-through; margin-left: 6px; }
  .d2c-patc-btn {
    width: 100%;
    background: linear-gradient(135deg, #eab308 0%, #ca8a04 100%);
    color: #190e04;
    border: none;
    padding: 12px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-patc-btn:hover { opacity: 0.9; }

  @media (max-width: 1024px) { .d2c-pprod-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-pprod-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } .d2c-pprod-body { padding: 12px; } }
</style>

{% schema %}
{
  "name": "Polki Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ICONIC HEIRLOOM MASTERWORKS"
    }
  ],
  "presets": [
    {
      "name": "Polki Bestsellers"
    }
  ]
}
{% endschema %}
