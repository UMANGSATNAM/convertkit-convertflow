{% comment %}
  D2C Royal Polki Category Showcase
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-cats" id="d2c-pcats-{{ section.id }}">
  <div class="d2c-pcats-container">
    <div class="d2c-psec-header">
      <span class="d2c-p-badge">ATELIER COLLECTIONS</span>
      <h2 class="d2c-p-title">{{ section.settings.title | default: "HEIRLOOM BRIDAL TREASURY" }}</h2>
    </div>

    <div class="d2c-pcats-grid">
      <a href="/collections/polki-chokers" class="d2c-pcat-card">
        <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Bridal Chokers" />
        <div class="d2c-pcat-overlay">
          <span class="d2c-pcat-sub">JADAU & UNCUT DIAMOND</span>
          <h3 class="d2c-pcat-name">BRIDAL POLKI CHOKERS</h3>
          <span class="d2c-pcat-link">EXPLORE ATELIER &rarr;</span>
        </div>
      </a>

      <a href="/collections/jadau-jhumkas" class="d2c-pcat-card">
        <img src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=600&q=80" alt="Jadau Jhumkas" />
        <div class="d2c-pcat-overlay">
          <span class="d2c-pcat-sub">EMERALD & PEARL DROPS</span>
          <h3 class="d2c-pcat-name">ROYAL CHANDBALIS & JHUMKAS</h3>
          <span class="d2c-pcat-link">EXPLORE &rarr;</span>
        </div>
      </a>

      <a href="/collections/polki-kadas" class="d2c-pcat-card">
        <img src="https://images.unsplash.com/photo-1611591475152-478d1c582489?w=600&q=80" alt="Polki Kadas" />
        <div class="d2c-pcat-overlay">
          <span class="d2c-pcat-sub">22KT MEENAKARI INLAID</span>
          <h3 class="d2c-pcat-name">ANTIQUE PACHELI & KADAS</h3>
          <span class="d2c-pcat-link">EXPLORE &rarr;</span>
        </div>
      </a>

      <a href="/collections/temple-haar" class="d2c-pcat-card">
        <img src="https://images.unsplash.com/photo-1600003014755-ba31aa59c4b6?w=600&q=80" alt="Temple Gold Haar" />
        <div class="d2c-pcat-overlay">
          <span class="d2c-pcat-sub">NAKSHI & TEMPLE ARTISAN</span>
          <h3 class="d2c-pcat-name">GRAND RAANI HAAR SETS</h3>
          <span class="d2c-pcat-link">EXPLORE &rarr;</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  #d2c-pcats-{{ section.id }} {
    background: #190e04;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-pcats-container { max-width: 1360px; margin: 0 auto; }
  .d2c-psec-header { text-align: center; margin-bottom: 48px; }
  .d2c-p-badge { font-size: 11px; font-weight: 800; color: #fde047; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px; display: block; }
  .d2c-p-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 900; color: #fef08a; letter-spacing: -0.5px; text-transform: uppercase; }
  .d2c-pcats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-pcat-card {
    position: relative;
    height: 420px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(234, 179, 8, 0.3);
    text-decoration: none;
    display: block;
  }
  .d2c-pcat-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .d2c-pcat-card:hover img { transform: scale(1.06); }
  .d2c-pcat-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(25,14,4,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: #ffffff;
    text-align: center;
  }
  .d2c-pcat-sub { font-size: 10px; font-weight: 800; color: #fde047; letter-spacing: 1.5px; margin-bottom: 4px; }
  .d2c-pcat-name { font-size: 15px; font-weight: 900; letter-spacing: 0.5px; margin-bottom: 6px; color: #fef08a; }
  .d2c-pcat-link { font-size: 11px; font-weight: 800; color: #fef9c3; }

  @media (max-width: 1024px) { .d2c-pcats-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-pcats-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Polki Categories",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HEIRLOOM BRIDAL TREASURY"
    }
  ],
  "presets": [
    {
      "name": "Polki Categories"
    }
  ]
}
{% endschema %}
