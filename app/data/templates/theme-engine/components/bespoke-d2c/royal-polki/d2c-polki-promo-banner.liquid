{% comment %}
  D2C Royal Polki Promo Banner
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-promo" id="d2c-ppromo-{{ section.id }}">
  <div class="d2c-ppromo-container">
    <div class="d2c-ppromo-card">
      <span class="d2c-p-badge" style="color: #fde047;">FESTIVE BRIDAL AUSPICE</span>
      <h2 class="d2c-ppromo-title">{{ section.settings.title | default: "FLAT 25% OFF MAKING CHARGES ON ALL POLKI SETS" }}</h2>
      <p class="d2c-ppromo-desc">Book your bridal consultation this week and receive a complimentary 24kt pure gold coin + zero-cost insured transit.</p>
      <a href="/collections/all" class="d2c-ppromo-btn">EXPLORE BRIDAL EDIT &rarr;</a>
    </div>
  </div>
</section>

<style>
  #d2c-ppromo-{{ section.id }} {
    background: #140b03;
    padding: 50px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-ppromo-container { max-width: 1360px; margin: 0 auto; }
  .d2c-ppromo-card {
    background: linear-gradient(135deg, #2d1808 0%, #190e04 100%);
    border: 1px solid rgba(234, 179, 8, 0.4);
    border-radius: 12px;
    padding: 56px 36px;
    text-align: center;
    box-shadow: 0 20px 45px -10px rgba(0,0,0,0.9);
  }
  .d2c-ppromo-title { font-size: clamp(26px, 3.5vw, 40px); font-weight: 900; color: #fef08a; letter-spacing: -0.5px; margin: 10px 0 14px; text-transform: uppercase; }
  .d2c-ppromo-desc { font-size: 15px; color: #fef9c3; max-width: 600px; margin: 0 auto 28px; line-height: 1.6; }
  .d2c-ppromo-btn {
    display: inline-block;
    background: linear-gradient(135deg, #eab308 0%, #ca8a04 100%);
    color: #190e04;
    padding: 14px 32px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-decoration: none;
    text-transform: uppercase;
  }
  .d2c-ppromo-btn:hover { opacity: 0.9; }
</style>

{% schema %}
{
  "name": "Polki Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FLAT 25% OFF MAKING CHARGES ON ALL POLKI SETS"
    }
  ],
  "presets": [
    {
      "name": "Polki Promo Banner"
    }
  ]
}
{% endschema %}
