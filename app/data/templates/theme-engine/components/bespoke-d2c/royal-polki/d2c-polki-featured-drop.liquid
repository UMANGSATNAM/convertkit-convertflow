{% comment %}
  D2C Royal Polki Masterpiece Spotlight
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-spotlight" id="d2c-pspot-{{ section.id }}">
  <div class="d2c-pspot-container">
    <div class="d2c-pspot-card">
      <div class="d2c-pspot-media">
        <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=800&q=85" alt="Padmavati Polki Choker" />
      </div>

      <div class="d2c-pspot-content">
        <span class="d2c-p-badge">ATELIER MASTERPIECE 1-OF-1</span>
        <h2 class="d2c-pspot-title">{{ section.settings.title | default: "THE PHOOL-MAHAL 22KT JADAU POLKI CHOKER" }}</h2>
        <p class="d2c-pspot-desc">
          Crafted over 420 painstaking Karigari hours in Jaipur. Features 64.2 grams of 22kt hallmarked gold, 18.5 carats of natural syndicate polki diamonds, and cabochon Zambian emerald drops.
        </p>

        <div class="d2c-pspot-matrix">
          <div class="d2c-pm-item"><span>GOLD PURITY:</span> <strong>BIS 916 (22KT Hallmarked)</strong></div>
          <div class="d2c-pm-item"><span>DIAMOND SPEC:</span> <strong>100% Natural Syndicate Polki (18.5 cts)</strong></div>
          <div class="d2c-pm-item"><span>GEMSTONES:</span> <strong>Natural Zambian Emeralds & Basra Pearls</strong></div>
        </div>

        <div class="d2c-pspot-price-row">
          <span class="d2c-pspot-price">₹4,85,000</span>
          <span class="d2c-pspot-orig">₹5,20,000</span>
          <span class="d2c-pspot-tag">FLAT 25% OFF MAKING CHARGES</span>
        </div>

        <div class="d2c-pspot-btn-group">
          <button class="d2c-pspot-btn">⚡ RESERVE VIA PRIVATE CONCIERGE &rarr;</button>
          <button class="d2c-pspot-btn-outline">SCHEDULE VIDEO INSPECTION</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-pspot-{{ section.id }} {
    background: #140b03;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-pspot-container { max-width: 1360px; margin: 0 auto; }
  .d2c-pspot-card {
    background: #201306;
    border-radius: 12px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    align-items: center;
    border: 1px solid rgba(234, 179, 8, 0.3);
  }
  .d2c-pspot-media img { width: 100%; height: 480px; object-fit: cover; border-radius: 8px; }
  .d2c-pspot-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #fef08a; line-height: 1.15; margin: 10px 0 16px; text-transform: uppercase; }
  .d2c-pspot-desc { font-size: 15px; color: #fef9c3; line-height: 1.6; margin-bottom: 24px; }
  .d2c-pspot-matrix {
    background: #140b03;
    border-radius: 6px;
    padding: 16px 20px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 1px solid rgba(234, 179, 8, 0.2);
  }
  .d2c-pm-item { display: flex; justify-content: space-between; font-size: 12px; color: #fef9c3; }
  .d2c-pm-item strong { color: #fde047; }
  .d2c-pspot-price-row { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .d2c-pspot-price { font-size: 26px; font-weight: 900; color: #ffffff; }
  .d2c-pspot-orig { font-size: 15px; color: #a1a1aa; text-decoration: line-through; }
  .d2c-pspot-tag { background: rgba(234, 179, 8, 0.2); color: #fde047; font-size: 10px; font-weight: 800; padding: 4px 8px; border-radius: 4px; border: 1px solid #eab308; }
  .d2c-pspot-btn-group { display: flex; flex-direction: column; gap: 12px; }
  .d2c-pspot-btn {
    width: 100%;
    background: linear-gradient(135deg, #eab308 0%, #ca8a04 100%);
    color: #190e04;
    border: none;
    padding: 16px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.5px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-pspot-btn-outline {
    width: 100%;
    background: transparent;
    border: 1px solid #eab308;
    color: #fde047;
    padding: 14px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .d2c-pspot-card { grid-template-columns: 1fr; padding: 24px; }
    .d2c-pspot-media img { height: 300px; }
  }
</style>

{% schema %}
{
  "name": "Polki Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE PHOOL-MAHAL 22KT JADAU POLKI CHOKER"
    }
  ],
  "presets": [
    {
      "name": "Polki Spotlight"
    }
  ]
}
{% endschema %}
