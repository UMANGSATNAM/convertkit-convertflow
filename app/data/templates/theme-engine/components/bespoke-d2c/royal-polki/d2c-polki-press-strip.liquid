{% comment %}
  D2C Royal Polki Press Mentions
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-press" id="d2c-ppress-{{ section.id }}">
  <div class="d2c-ppress-container">
    <span class="d2c-ppress-label">ROYAL PATRONAGE</span>
    <div class="d2c-ppress-logos">
      <span class="d2c-pplogo">VOGUE WEDDING BOOK</span>
      <span class="d2c-pplogo">HARPER'S BAZAAR BRIDE</span>
      <span class="d2c-pplogo">ELLE LUXURY AWARDS</span>
      <span class="d2c-pplogo">VERVE HIGH JEWELLERY</span>
      <span class="d2c-pplogo">THE ECONOMIC TIMES LUXE</span>
    </div>
  </div>
</section>

<style>
  #d2c-ppress-{{ section.id }} {
    background: #190e04;
    padding: 30px 32px;
    border-bottom: 1px solid rgba(234, 179, 8, 0.2);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-ppress-container {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .d2c-ppress-label { font-size: 11px; font-weight: 800; color: #fde047; letter-spacing: 1.5px; text-transform: uppercase; }
  .d2c-ppress-logos { display: flex; gap: 36px; align-items: center; flex-wrap: wrap; }
  .d2c-pplogo { font-size: 13px; font-weight: 900; color: #fef08a; letter-spacing: 1px; opacity: 0.9; }

  @media (max-width: 768px) {
    .d2c-ppress-container { justify-content: center; text-align: center; }
    .d2c-ppress-logos { justify-content: center; gap: 20px; }
  }
</style>

{% schema %}
{
  "name": "Polki Press Strip",
  "settings": [],
  "presets": [
    {
      "name": "Polki Press Strip"
    }
  ]
}
{% endschema %}
