{% comment %}
  D2C Royal Polki Gazette Newsletter
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-news" id="d2c-pnews-{{ section.id }}">
  <div class="d2c-pnews-container">
    <div class="d2c-pnews-card">
      <span class="d2c-p-badge">THE ROYAL GAZETTE</span>
      <h2 class="d2c-pnews-title">{{ section.settings.title | default: "RECEIVE PRIVATE BRIDAL SALON INVITATIONS" }}</h2>
      <p class="d2c-pnews-desc">Join 80,000+ patrons receiving our seasonal heirloom jewelry gazette, preview invites, and gold market analyses.</p>

      <form class="d2c-pnews-form">
        <input type="email" placeholder="Enter your email address" class="d2c-pnews-input" required />
        <button type="submit" class="d2c-pnews-btn">REQUEST ACCESS &rarr;</button>
      </form>
      <div class="d2c-pnews-privacy">🔒 Strictly confidential. No marketing spam.</div>
    </div>
  </div>
</section>

<style>
  #d2c-pnews-{{ section.id }} {
    background: #190e04;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-pnews-container { max-width: 860px; margin: 0 auto; }
  .d2c-pnews-card {
    background: #201306;
    border-radius: 12px;
    padding: 48px 36px;
    text-align: center;
    border: 1px solid rgba(234, 179, 8, 0.3);
  }
  .d2c-pnews-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #fef08a; margin: 10px 0 12px; text-transform: uppercase; }
  .d2c-pnews-desc { font-size: 15px; color: #fef9c3; margin-bottom: 28px; }
  .d2c-pnews-form { display: flex; gap: 10px; max-width: 480px; margin: 0 auto 14px; }
  .d2c-pnews-input {
    flex: 1;
    background: #140b03;
    border: 1px solid rgba(234, 179, 8, 0.3);
    padding: 14px 18px;
    border-radius: 4px;
    font-size: 14px;
    color: #ffffff;
    outline: none;
  }
  .d2c-pnews-input:focus { border-color: #eab308; }
  .d2c-pnews-btn {
    background: linear-gradient(135deg, #eab308 0%, #ca8a04 100%);
    color: #190e04;
    border: none;
    padding: 14px 28px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-pnews-btn:hover { opacity: 0.9; }
  .d2c-pnews-privacy { font-size: 12px; color: #fde047; opacity: 0.7; }

  @media (max-width: 600px) {
    .d2c-pnews-form { flex-direction: column; }
    .d2c-pnews-card { padding: 32px 20px; }
  }
</style>

{% schema %}
{
  "name": "Polki Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "RECEIVE PRIVATE BRIDAL SALON INVITATIONS"
    }
  ],
  "presets": [
    {
      "name": "Polki Newsletter"
    }
  ]
}
{% endschema %}
