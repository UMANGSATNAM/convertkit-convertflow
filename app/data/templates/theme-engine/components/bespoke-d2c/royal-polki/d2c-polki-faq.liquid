{% comment %}
  D2C Royal Polki Atelier FAQ
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-faq" id="d2c-pfaq-{{ section.id }}">
  <div class="d2c-pfaq-container">
    <div class="d2c-psec-header">
      <span class="d2c-p-badge">ATELIER CONCIERGE</span>
      <h2 class="d2c-p-title">{{ section.settings.title | default: "ROYAL POLKI & GOLD INQUIRIES" }}</h2>
    </div>

    <div class="d2c-pfaq-list">
      <details class="d2c-pfaq-item" open>
        <summary class="d2c-pfaq-q">
          <span>How is the purity and weight of gold certified?</span>
          <span class="d2c-pfaq-icon">+</span>
        </summary>
        <div class="d2c-pfaq-a">
          Every piece carries a government-issued 6-digit BIS Hallmarking HUID laser inscription. Your certificate includes the exact gross gold weight, net gold weight, polki diamond caratage, and gemstone weights.
        </div>
      </details>

      <details class="d2c-pfaq-item">
        <summary class="d2c-pfaq-q">
          <span>Can I inspect high-value bridal jewelry over private video call?</span>
          <span class="d2c-pfaq-icon">+</span>
        </summary>
        <div class="d2c-pfaq-a">
          Yes. Our senior jewelry curators host private 1-on-1 HD video salon sessions where you can inspect choker draping, reverse meenakari craftsmanship, and stone luster in 4K resolution.
        </div>
      </details>

      <details class="d2c-pfaq-item">
        <summary class="d2c-pfaq-q">
          <span>How is high-value heirloom jewelry delivered safely?</span>
          <span class="d2c-pfaq-icon">+</span>
        </summary>
        <div class="d2c-pfaq-a">
          All orders are dispatched via armored logistics partners (Sequel / BVC Logistics) in tamper-evident sealed vaults with 100% transit insurance up to the full invoice value.
        </div>
      </details>

      <details class="d2c-pfaq-item">
        <summary class="d2c-pfaq-q">
          <span>What is your lifetime buyback and exchange policy?</span>
          <span class="d2c-pfaq-icon">+</span>
        </summary>
        <div class="d2c-pfaq-a">
          We guarantee 100% lifetime buyback on prevailing market gold rates and 90% valuation on natural syndicate polki diamonds across all our flagship boutiques nationwide.
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  #d2c-pfaq-{{ section.id }} {
    background: #140b03;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-pfaq-container { max-width: 860px; margin: 0 auto; }
  .d2c-pfaq-list { display: flex; flex-direction: column; gap: 12px; margin-top: 36px; }
  .d2c-pfaq-item {
    background: #201306;
    border: 1px solid rgba(234, 179, 8, 0.25);
    border-radius: 8px;
    overflow: hidden;
  }
  .d2c-pfaq-q {
    padding: 20px 24px;
    font-size: 15px;
    font-weight: 800;
    color: #fef08a;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }
  .d2c-pfaq-q::-webkit-details-marker { display: none; }
  .d2c-pfaq-icon { font-size: 20px; font-weight: 800; color: #fde047; }
  details[open] .d2c-pfaq-icon { transform: rotate(45deg); display: inline-block; }
  .d2c-pfaq-a {
    padding: 0 24px 20px;
    font-size: 14px;
    color: #fef9c3;
    line-height: 1.6;
  }
</style>

{% schema %}
{
  "name": "Polki FAQ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ROYAL POLKI & GOLD INQUIRIES"
    }
  ],
  "presets": [
    {
      "name": "Polki FAQ"
    }
  ]
}
{% endschema %}
