{% comment %}
  D2C Royal Polki Gold Purity & Hallmark Matrix
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-matrix" id="d2c-pmat-{{ section.id }}">
  <div class="d2c-pmat-container">
    <div class="d2c-psec-header">
      <span class="d2c-p-badge">PURITY & ASSAY ASSURANCE</span>
      <h2 class="d2c-p-title">{{ section.settings.title | default: "HEIRLOOM PURITY & VALUATION STANDARDS" }}</h2>
    </div>

    <div class="d2c-pmat-grid">
      <div class="d2c-pmat-card">
        <div class="d2c-pmat-val">BIS 916</div>
        <div class="d2c-pmat-name">GOVERNMENT HALLMARKED</div>
        <p class="d2c-pmat-desc">Every single gram of gold carries a unique 6-digit HUID code verified by the Bureau of Indian Standards.</p>
      </div>

      <div class="d2c-pmat-card">
        <div class="d2c-pmat-val">100%</div>
        <div class="d2c-pmat-name">NATURAL SYNDICATE POLKI</div>
        <p class="d2c-pmat-desc">Certified natural uncut diamonds sourced from certified mines. Zero synthetic or lab-grown stones.</p>
      </div>

      <div class="d2c-pmat-card">
        <div class="d2c-pmat-val">100%</div>
        <div class="d2c-pmat-name">LIFETIME BUYBACK GUARANTEE</div>
        <p class="d2c-pmat-desc">Guaranteed 100% buyback on prevailing gold value and 90% on polki diamonds across all stores nationwide.</p>
      </div>

      <div class="d2c-pmat-card">
        <div class="d2c-pmat-val">₹0 COST</div>
        <div class="d2c-pmat-name">FULLY INSURED TRANSIT</div>
        <p class="d2c-pmat-desc">Dispatched via high-security armored logistics with 100% transit insurance up to your doorstep.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-pmat-{{ section.id }} {
    background: #140b03;
    padding: 70px 32px;
    border-top: 1px solid rgba(234, 179, 8, 0.2);
    border-bottom: 1px solid rgba(234, 179, 8, 0.2);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-pmat-container { max-width: 1360px; margin: 0 auto; }
  .d2c-pmat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-pmat-card {
    background: #201306;
    border: 1px solid rgba(234, 179, 8, 0.25);
    border-radius: 8px;
    padding: 32px 20px;
    text-align: center;
  }
  .d2c-pmat-val { font-size: 28px; font-weight: 900; color: #fde047; margin-bottom: 6px; }
  .d2c-pmat-name { font-size: 12px; font-weight: 800; color: #fef08a; letter-spacing: 0.5px; margin-bottom: 10px; }
  .d2c-pmat-desc { font-size: 13px; color: #fef9c3; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-pmat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-pmat-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Polki Purity Matrix",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HEIRLOOM PURITY & VALUATION STANDARDS"
    }
  ],
  "presets": [
    {
      "name": "Polki Purity Matrix"
    }
  ]
}
{% endschema %}
