{% comment %}
  D2C Royal Polki Private Video Consultation Modal
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<div class="d2c-polki-popup" id="d2c-ppop-{{ section.id }}" style="display: none;">
  <div class="d2c-ppop-overlay">
    <div class="d2c-ppop-card">
      <button class="d2c-ppop-close" onclick="document.getElementById('d2c-ppop-{{ section.id }}').style.display='none';">&times;</button>
      <span class="d2c-p-badge" style="color: #fde047;">PRIVATE JEWELLERY SALON</span>
      <h3 class="d2c-ppop-title">SCHEDULE A 1-ON-1 HIGH JEWELLERY VIDEO INSPECTION</h3>
      <p class="d2c-ppop-desc">Inspect our Jaipur bridal masterpieces live on HD video with a senior gemstone curator + receive a ₹5,000 Bridal Voucher.</p>

      <form class="d2c-ppop-form">
        <input type="text" placeholder="Your Royal Name" class="d2c-ppop-input" required />
        <input type="email" placeholder="Your Email Address" class="d2c-ppop-input" required />
        <input type="tel" placeholder="WhatsApp Number for Video Call Link" class="d2c-ppop-input" required />
        <button type="submit" class="d2c-ppop-btn">RESERVE PRIVATE VIDEO SALON &rarr;</button>
      </form>
    </div>
  </div>
</div>

<style>
  .d2c-ppop-overlay {
    position: fixed;
    inset: 0;
    background: rgba(20, 11, 3, 0.85);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-ppop-card {
    background: #201306;
    border-radius: 12px;
    padding: 44px 32px;
    max-width: 460px;
    width: 100%;
    text-align: center;
    position: relative;
    border: 2px solid #eab308;
    box-shadow: 0 20px 45px -10px rgba(0,0,0,0.95);
  }
  .d2c-ppop-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: #fef08a;
    font-size: 22px;
    cursor: pointer;
  }
  .d2c-ppop-title { font-size: 17px; font-weight: 900; color: #fef08a; margin: 8px 0 10px; text-transform: uppercase; line-height: 1.25; }
  .d2c-ppop-desc { font-size: 14px; color: #fef9c3; margin-bottom: 22px; }
  .d2c-ppop-form { display: flex; flex-direction: column; gap: 10px; }
  .d2c-ppop-input {
    background: #140b03;
    border: 1px solid rgba(234, 179, 8, 0.3);
    padding: 12px 16px;
    border-radius: 4px;
    font-size: 14px;
    color: #ffffff;
    outline: none;
  }
  .d2c-ppop-input:focus { border-color: #eab308; }
  .d2c-ppop-btn {
    background: linear-gradient(135deg, #eab308 0%, #ca8a04 100%);
    color: #190e04;
    border: none;
    padding: 14px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
    margin-top: 6px;
  }
</style>

{% schema %}
{
  "name": "Polki Consultation Popup",
  "settings": [],
  "presets": [
    {
      "name": "Polki Consultation Popup"
    }
  ]
}
{% endschema %}
