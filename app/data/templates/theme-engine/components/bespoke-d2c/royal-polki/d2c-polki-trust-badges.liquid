{% comment %}
  D2C Royal Polki Trust Badges
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-trust" id="d2c-ptrust-{{ section.id }}">
  <div class="d2c-ptrust-container">
    <div class="d2c-ptrust-grid">
      <div class="d2c-ptrust-item">
        <div class="d2c-ptrust-icon">👑</div>
        <h4 class="d2c-ptrust-title">BIS 916 HALLMARKED</h4>
        <p class="d2c-ptrust-desc">100% certified 22kt pure gold with unique government HUID laser verification.</p>
      </div>

      <div class="d2c-ptrust-item">
        <div class="d2c-ptrust-icon">💎</div>
        <h4 class="d2c-ptrust-title">100% NATURAL POLKI</h4>
        <p class="d2c-ptrust-desc">Certified uncut syndicate polki diamonds graded for color, clarity, and luster.</p>
      </div>

      <div class="d2c-ptrust-item">
        <div class="d2c-ptrust-icon">🚚</div>
        <h4 class="d2c-ptrust-title">100% INSURED TRANSIT</h4>
        <p class="d2c-ptrust-desc">Armored security delivery with transit insurance up to full invoice valuation.</p>
      </div>

      <div class="d2c-ptrust-item">
        <div class="d2c-ptrust-icon">🔄</div>
        <h4 class="d2c-ptrust-title">LIFETIME BUYBACK</h4>
        <p class="d2c-ptrust-desc">Guaranteed buyback & exchange value across any of our boutiques nationwide.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-ptrust-{{ section.id }} {
    background: #140b03;
    color: #ffffff;
    padding: 50px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-ptrust-container { max-width: 1360px; margin: 0 auto; }
  .d2c-ptrust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }
  .d2c-ptrust-item {
    background: #201306;
    border: 1px solid rgba(234, 179, 8, 0.25);
    border-radius: 8px;
    padding: 28px 18px;
  }
  .d2c-ptrust-icon { font-size: 26px; margin-bottom: 10px; }
  .d2c-ptrust-title { font-size: 12px; font-weight: 900; color: #fde047; letter-spacing: 0.5px; margin-bottom: 6px; text-transform: uppercase; }
  .d2c-ptrust-desc { font-size: 12px; color: #fef9c3; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-ptrust-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-ptrust-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Polki Trust Badges",
  "settings": [],
  "presets": [
    {
      "name": "Polki Trust Badges"
    }
  ]
}
{% endschema %}
