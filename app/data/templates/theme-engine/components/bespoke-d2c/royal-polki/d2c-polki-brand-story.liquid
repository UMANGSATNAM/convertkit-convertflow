{% comment %}
  D2C Royal Polki Heritage Story
  Theme: Tanishq / Amrapali Royal Polki & Gold
{% endcomment %}

<section class="d2c-polki-story" id="d2c-pstory-{{ section.id }}">
  <div class="d2c-pstory-container">
    <div class="d2c-pstory-grid">
      <div class="d2c-pstory-content">
        <span class="d2c-p-badge">ATELIER HERITAGE</span>
        <h2 class="d2c-pstory-title">{{ section.settings.title | default: "CENTURIES OF ROYAL JAIPUR KARIGARI" }}</h2>
        <p class="d2c-pstory-para">
          Our atelier was established in the walled Pink City of Jaipur to preserve the centuries-old royal crafts of Kundan, Jadau, and Gulabi Meenakari.
        </p>
        <p class="d2c-pstory-para">
          Each heirloom creation is born from pure 24kt gold foil settings that envelop natural syndicate polki diamonds without modern glue or synthetics, creating fluid jewelry that moves seamlessly with the bride.
        </p>
        <div class="d2c-pstory-stats">
          <div><span class="d2c-pst-num">120+</span><span class="d2c-pst-lbl">Years Legacy</span></div>
          <div><span class="d2c-pst-num">400+</span><span class="d2c-pst-lbl">Master Karigars</span></div>
          <div><span class="d2c-pst-num">100%</span><span class="d2c-pst-lbl">BIS 916 Pure</span></div>
        </div>
      </div>

      <div class="d2c-pstory-media">
        <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=800&q=80" alt="Royal Jaipur Workshop" />
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-pstory-{{ section.id }} {
    background: #190e04;
    padding: 80px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cinzel", serif;
  }
  .d2c-pstory-container { max-width: 1360px; margin: 0 auto; }
  .d2c-pstory-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }
  .d2c-pstory-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 900; color: #fef08a; line-height: 1.15; margin: 10px 0 20px; text-transform: uppercase; }
  .d2c-pstory-para { font-size: 15px; color: #fef9c3; line-height: 1.7; margin-bottom: 18px; }
  .d2c-pstory-stats {
    display: flex;
    gap: 36px;
    border-top: 1px solid rgba(234, 179, 8, 0.25);
    padding-top: 24px;
    margin-top: 28px;
  }
  .d2c-pst-num { font-size: 26px; font-weight: 900; color: #fde047; display: block; }
  .d2c-pst-lbl { font-size: 11px; color: #ca8a04; font-weight: 700; text-transform: uppercase; }
  .d2c-pstory-media img { width: 100%; height: 440px; object-fit: cover; border-radius: 12px; border: 1px solid rgba(234, 179, 8, 0.3); }

  @media (max-width: 900px) {
    .d2c-pstory-grid { grid-template-columns: 1fr; }
    .d2c-pstory-media img { height: 320px; }
  }
</style>

{% schema %}
{
  "name": "Polki Story",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "CENTURIES OF ROYAL JAIPUR KARIGARI"
    }
  ],
  "presets": [
    {
      "name": "Polki Story"
    }
  ]
}
{% endschema %}
