{% comment %}
  D2C Modern Solitaire Footer
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<footer class="d2c-solitaire-footer" id="d2c-sfoot-{{ section.id }}">
  <div class="d2c-solitaire-container">
    <div class="d2c-sfoot-top">
      <div class="d2c-sfoot-brand">
        <h3 class="d2c-sfoot-logo">{{ section.settings.brand_name | default: "SOLITAIRE ATELIER" }}</h3>
        <p class="d2c-sfoot-desc">Modern fine diamond jewellery crafted in 18kt hallmarked gold and 950 platinum with certified IGI and GIA diamonds.</p>
        <div class="d2c-sfoot-cert">💎 100% IGI & GIA CERTIFIED SOLITAIRES</div>
      </div>

      <div class="d2c-sfoot-col">
        <h4 class="d2c-scol-title">DIAMOND COLLECTIONS</h4>
        <ul class="d2c-scol-links">
          <li><a href="/collections/solitaire-rings">Solitaire Engagement Rings</a></li>
          <li><a href="/collections/diamond-earrings">Daily Wear Diamond Studs</a></li>
          <li><a href="/collections/mangalsutras">Modern Infinity Mangalsutras</a></li>
          <li><a href="/collections/tennis-bracelets">Platinum Tennis Bracelets</a></li>
          <li><a href="/collections/couples-bands">Platinum Couple Bands</a></li>
        </ul>
      </div>

      <div class="d2c-sfoot-col">
        <h4 class="d2c-scol-title">TRY AT HOME & STORES</h4>
        <ul class="d2c-scol-links">
          <li><a href="/pages/try-at-home">Book Free Try At Home</a></li>
          <li><a href="/pages/track-order">Track Insured Delivery</a></li>
          <li><a href="/pages/ring-sizer">Request Free Ring Sizer</a></li>
          <li><a href="/pages/stores">Find Store Near You</a></li>
          <li><a href="/pages/contact">WhatsApp Diamond Expert</a></li>
        </ul>
      </div>

      <div class="d2c-sfoot-col">
        <h4 class="d2c-scol-title">BUYBACK & PROMISES</h4>
        <p class="d2c-sfoot-sub-desc">100% lifetime exchange and buyback assurance with complete transparency on diamond weights, gold value, and making charges.</p>
      </div>
    </div>

    <div class="d2c-sfoot-bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: "SOLITAIRE ATELIER JEWELLERY PVT. LTD." }}. ALL RIGHTS RESERVED.</div>
      <div class="d2c-sfoot-legal">
        <a href="/policies/privacy-policy">Privacy Disclosure</a>
        <a href="/policies/terms-of-service">Terms of Supply</a>
        <a href="/policies/shipping-policy">Insured Shipping Policy</a>
      </div>
    </div>
  </div>
</footer>

<style>
  #d2c-sfoot-{{ section.id }} {
    background: #060d16;
    color: #bae6fd;
    padding: 70px 32px 30px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    border-top: 1px solid rgba(14, 165, 233, 0.25);
  }
  .d2c-solitaire-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sfoot-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .d2c-sfoot-logo { font-size: 20px; font-weight: 900; color: #ffffff; letter-spacing: 1.5px; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-sfoot-desc { font-size: 13px; color: #bae6fd; line-height: 1.6; margin-bottom: 16px; max-width: 320px; }
  .d2c-sfoot-cert { font-size: 11px; font-weight: 800; color: #38bdf8; font-family: monospace; }
  .d2c-scol-title { font-size: 12px; font-weight: 900; color: #ffffff; letter-spacing: 1px; margin-bottom: 16px; text-transform: uppercase; }
  .d2c-scol-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .d2c-scol-links a { color: #bae6fd; text-decoration: none; font-size: 13px; opacity: 0.85; transition: opacity 0.15s ease; }
  .d2c-scol-links a:hover { opacity: 1; color: #38bdf8; }
  .d2c-sfoot-sub-desc { font-size: 13px; line-height: 1.6; opacity: 0.85; }
  .d2c-sfoot-bottom {
    border-top: 1px solid rgba(14, 165, 233, 0.15);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
  }
  .d2c-sfoot-legal { display: flex; gap: 20px; }
  .d2c-sfoot-legal a { color: inherit; text-decoration: none; }
  .d2c-sfoot-legal a:hover { color: #ffffff; }

  @media (max-width: 1024px) { .d2c-sfoot-top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) {
    .d2c-sfoot-top { grid-template-columns: 1fr; }
    .d2c-sfoot-bottom { flex-direction: column; gap: 12px; text-align: center; }
  }
</style>

{% schema %}
{
  "name": "Solitaire Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "SOLITAIRE ATELIER"
    }
  ],
  "presets": [
    {
      "name": "Solitaire Footer"
    }
  ]
}
{% endschema %}
