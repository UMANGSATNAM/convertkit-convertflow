{% comment %}
  D2C Modern Solitaire Brand Story
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-story" id="d2c-sstory-{{ section.id }}">
  <div class="d2c-solitaire-container">
    <div class="d2c-sstory-grid">
      <div class="d2c-sstory-content">
        <span class="d2c-s-badge">OUR MISSION</span>
        <h2 class="d2c-sstory-title">{{ section.settings.title | default: "MAKING LUXURY DIAMONDS ACCESSIBLE EVERY DAY" }}</h2>
        <p class="d2c-sstory-para">
          For generations, diamond shopping in India meant opaque pricing, inflated showroom overheads, and high making charges.
        </p>
        <p class="d2c-sstory-para">
          We transformed the fine jewelry experience: direct-to-consumer pricing, 100% transparent gold & diamond breakups, international IGI & GIA certifications, and the freedom to try rings at home before deciding.
        </p>
        <div class="d2c-sstory-stats">
          <div><span class="d2c-sst-num">100%</span><span class="d2c-sst-lbl">Transparent</span></div>
          <div><span class="d2c-sst-num">40+</span><span class="d2c-sst-lbl">Cities Try At Home</span></div>
          <div><span class="d2c-sst-num">4.9 ★</span><span class="d2c-sst-lbl">Customer Rating</span></div>
        </div>
      </div>

      <div class="d2c-sstory-media">
        <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=800&q=80" alt="Diamond Craftsmanship" />
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-sstory-{{ section.id }} {
    background: #09131f;
    padding: 80px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-solitaire-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sstory-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }
  .d2c-sstory-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 900; color: #ffffff; line-height: 1.15; margin: 10px 0 20px; text-transform: uppercase; }
  .d2c-sstory-para { font-size: 15px; color: #e0f2fe; line-height: 1.7; margin-bottom: 18px; }
  .d2c-sstory-stats {
    display: flex;
    gap: 36px;
    border-top: 1px solid rgba(14, 165, 233, 0.2);
    padding-top: 24px;
    margin-top: 28px;
  }
  .d2c-sst-num { font-size: 26px; font-weight: 900; color: #38bdf8; display: block; font-family: monospace; }
  .d2c-sst-lbl { font-size: 11px; color: #bae6fd; font-weight: 700; text-transform: uppercase; }
  .d2c-sstory-media img { width: 100%; height: 440px; object-fit: cover; border-radius: 12px; border: 1px solid rgba(14, 165, 233, 0.3); }

  @media (max-width: 900px) {
    .d2c-sstory-grid { grid-template-columns: 1fr; }
    .d2c-sstory-media img { height: 320px; }
  }
</style>

{% schema %}
{
  "name": "Solitaire Story",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "MAKING LUXURY DIAMONDS ACCESSIBLE EVERY DAY"
    }
  ],
  "presets": [
    {
      "name": "Solitaire Story"
    }
  ]
}
{% endschema %}
