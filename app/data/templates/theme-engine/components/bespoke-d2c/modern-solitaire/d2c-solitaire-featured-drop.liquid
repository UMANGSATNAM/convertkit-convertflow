{% comment %}
  D2C Modern Solitaire Diamond Ring Spotlight
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-spotlight" id="d2c-sspot-{{ section.id }}">
  <div class="d2c-sspot-container">
    <div class="d2c-sspot-card">
      <div class="d2c-sspot-media">
        <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=800&q=85" alt="1.5ct Solitaire Ring" />
      </div>

      <div class="d2c-sspot-content">
        <span class="d2c-s-badge">ICONIC SOLITAIRE ENGAGEMENT</span>
        <h2 class="d2c-sspot-title">{{ section.settings.title | default: "THE CROWN 1.50 CT SOLITAIRE RING" }}</h2>
        <p class="d2c-sspot-desc">
          Handset in 18kt hallmarked white gold with a raised 6-prong platinum gallery to maximize light refraction. Certified VVS1 Clarity with Triple Excellent Cut grade by IGI.
        </p>

        <div class="d2c-sspot-matrix">
          <div class="d2c-sm-item"><span>DIAMOND CARAT:</span> <strong>1.50 Carats (Certified IGI/GIA)</strong></div>
          <div class="d2c-sm-item"><span>CLARITY & COLOR:</span> <strong>VVS1 Clarity • E-F Colorless</strong></div>
          <div class="d2c-sm-item"><span>METAL SPEC:</span> <strong>18KT White Gold + 950 Platinum Prongs</strong></div>
        </div>

        <div class="d2c-sspot-price-row">
          <span class="d2c-sspot-price">₹2,15,000</span>
          <span class="d2c-sspot-orig">₹2,50,000</span>
          <span class="d2c-sspot-tag">FLAT 100% OFF MAKING CHARGES</span>
        </div>

        <div class="d2c-sspot-btn-group">
          <button class="d2c-sspot-btn">⚡ 1-CLICK COD / EASY EMI CHECKOUT &rarr;</button>
          <button class="d2c-sspot-btn-outline">🏠 BOOK FREE TRY AT HOME</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-sspot-{{ section.id }} {
    background: #060d16;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-sspot-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sspot-card {
    background: #0f1c2d;
    border-radius: 12px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    align-items: center;
    border: 1px solid rgba(14, 165, 233, 0.25);
  }
  .d2c-sspot-media img { width: 100%; height: 460px; object-fit: cover; border-radius: 8px; }
  .d2c-sspot-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #ffffff; line-height: 1.15; margin: 10px 0 16px; text-transform: uppercase; }
  .d2c-sspot-desc { font-size: 15px; color: #e0f2fe; line-height: 1.6; margin-bottom: 24px; }
  .d2c-sspot-matrix {
    background: #060d16;
    border-radius: 6px;
    padding: 16px 20px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 1px solid rgba(14, 165, 233, 0.2);
  }
  .d2c-sm-item { display: flex; justify-content: space-between; font-size: 12px; color: #bae6fd; font-family: monospace; }
  .d2c-sm-item strong { color: #ffffff; }
  .d2c-sspot-price-row { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .d2c-sspot-price { font-size: 26px; font-weight: 900; color: #ffffff; font-family: monospace; }
  .d2c-sspot-orig { font-size: 15px; color: #94a3b8; text-decoration: line-through; }
  .d2c-sspot-tag { background: rgba(14, 165, 233, 0.2); color: #38bdf8; font-size: 10px; font-weight: 800; padding: 4px 8px; border-radius: 4px; border: 1px solid #0ea5e9; }
  .d2c-sspot-btn-group { display: flex; flex-direction: column; gap: 12px; }
  .d2c-sspot-btn {
    width: 100%;
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    color: #ffffff;
    border: none;
    padding: 16px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-sspot-btn-outline {
    width: 100%;
    background: transparent;
    border: 1px solid #0ea5e9;
    color: #38bdf8;
    padding: 14px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .d2c-sspot-card { grid-template-columns: 1fr; padding: 24px; }
    .d2c-sspot-media img { height: 300px; }
  }
</style>

{% schema %}
{
  "name": "Solitaire Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE CROWN 1.50 CT SOLITAIRE RING"
    }
  ],
  "presets": [
    {
      "name": "Solitaire Spotlight"
    }
  ]
}
{% endschema %}
