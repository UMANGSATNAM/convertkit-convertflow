{% comment %}
  D2C Modern Solitaire Editorial Lookbook
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-lookbook" id="d2c-slb-{{ section.id }}">
  <div class="d2c-slb-container">
    <div class="d2c-ssec-header">
      <span class="d2c-s-badge">DIAMOND LOOKBOOK</span>
      <h2 class="d2c-s-title">{{ section.settings.title | default: "MODERN SOLITAIRE PROFILES" }}</h2>
    </div>

    <div class="d2c-slb-grid">
      <div class="d2c-slb-card large">
        <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=800&q=80" alt="Solitaire Engagement" />
        <div class="d2c-slb-overlay">
          <span class="d2c-slb-tag">THE FOREVER PROPOSAL</span>
          <h3 class="d2c-slb-name">1.50 CT SOLITAIRE + PLATINUM BAND</h3>
          <span class="d2c-slb-link">EXPLORE ENGAGEMENT EDIT &rarr;</span>
        </div>
      </div>

      <div class="d2c-slb-card">
        <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=600&q=80" alt="Daily Diamond Studs" />
        <div class="d2c-slb-overlay">
          <span class="d2c-slb-tag">EVERYDAY LUXE</span>
          <h3 class="d2c-slb-name">0.75 CT SOLITAIRE STUDS</h3>
          <span class="d2c-slb-link">EXPLORE &rarr;</span>
        </div>
      </div>

      <div class="d2c-slb-card">
        <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Modern Mangalsutra" />
        <div class="d2c-slb-overlay">
          <span class="d2c-slb-tag">SACRED MINIMALISM</span>
          <h3 class="d2c-slb-name">INFINITY DIAMOND THREAD</h3>
          <span class="d2c-slb-link">EXPLORE &rarr;</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-slb-{{ section.id }} {
    background: #09131f;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-slb-container { max-width: 1360px; margin: 0 auto; }
  .d2c-slb-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 24px;
  }
  .d2c-slb-card {
    position: relative;
    height: 480px;
    border-radius: 12px;
    overflow: hidden;
    background: #0f1c2d;
    border: 1px solid rgba(14, 165, 233, 0.3);
  }
  .d2c-slb-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .d2c-slb-card:hover img { transform: scale(1.04); }
  .d2c-slb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(9,19,31,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px;
    color: #ffffff;
  }
  .d2c-slb-tag { font-size: 10px; font-weight: 800; color: #38bdf8; letter-spacing: 1px; margin-bottom: 4px; font-family: monospace; }
  .d2c-slb-name { font-size: 16px; font-weight: 800; margin-bottom: 8px; }
  .d2c-slb-link { font-size: 11px; font-weight: 800; color: #bae6fd; }

  @media (max-width: 900px) {
    .d2c-slb-grid { grid-template-columns: 1fr; }
    .d2c-slb-card { height: 340px; }
  }
</style>

{% schema %}
{
  "name": "Solitaire Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "MODERN SOLITAIRE PROFILES"
    }
  ],
  "presets": [
    {
      "name": "Solitaire Lookbook"
    }
  ]
}
{% endschema %}
