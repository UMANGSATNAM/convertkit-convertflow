{% comment %}
  D2C Modern Solitaire Announcement Bar
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<div class="d2c-solitaire-announcement" id="d2c-sann-{{ section.id }}">
  <div class="d2c-sann-inner">
    <span>💎</span>
    <span class="d2c-sann-text">{{ section.settings.text | default: "SOLITAIRE FESTIVAL '26 // FLAT 100% OFF MAKING CHARGES ON CERTIFIED DIAMONDS" }}</span>
    <span class="d2c-sann-sep">✦</span>
    <span class="d2c-sann-sub">BOOK FREE TRY AT HOME IN 40+ CITIES</span>
  </div>
</div>

<style>
  #d2c-sann-{{ section.id }} {
    background: #09131f;
    color: #e0f2fe;
    padding: 10px 16px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-align: center;
    border-bottom: 1px solid rgba(14, 165, 233, 0.3);
  }
  .d2c-sann-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }
  .d2c-sann-sub { color: #38bdf8; font-weight: 900; }
  .d2c-sann-sep { opacity: 0.6; }
  @media (max-width: 768px) { #d2c-sann-{{ section.id }} { font-size: 11px; padding: 8px 12px; } .d2c-sann-sub { display: none; } }
</style>

{% schema %}
{
  "name": "Solitaire Announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "SOLITAIRE FESTIVAL '26 // FLAT 100% OFF MAKING CHARGES ON CERTIFIED DIAMONDS"
    }
  ],
  "presets": [
    {
      "name": "Solitaire Announcement"
    }
  ]
}
{% endschema %}
