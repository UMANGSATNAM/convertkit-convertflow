{% comment %}
  D2C Modern Solitaire Trust Badges
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-trust" id="d2c-strust-{{ section.id }}">
  <div class="d2c-strust-container">
    <div class="d2c-strust-grid">
      <div class="d2c-strust-item">
        <div class="d2c-strust-icon">💎</div>
        <h4 class="d2c-strust-title">100% IGI & GIA CERTIFIED</h4>
        <p class="d2c-strust-desc">Laser inscribed serial numbers on every diamond matching your laboratory grading report.</p>
      </div>

      <div class="d2c-strust-item">
        <div class="d2c-strust-icon">🏠</div>
        <h4 class="d2c-strust-title">FREE TRY AT HOME</h4>
        <p class="d2c-strust-desc">Select 5 designs to try in the comfort of your living room across 40+ Indian cities.</p>
      </div>

      <div class="d2c-strust-item">
        <div class="d2c-strust-icon">🔄</div>
        <h4 class="d2c-strust-title">100% LIFETIME BUYBACK</h4>
        <p class="d2c-strust-desc">Upgrade your solitaire carat or exchange for current market gold and diamond valuation.</p>
      </div>

      <div class="d2c-strust-item">
        <div class="d2c-strust-icon">🛡️</div>
        <h4 class="d2c-strust-title">15-DAY MONEY BACK</h4>
        <p class="d2c-strust-desc">100% full refund with zero deduction if you're not completely in love with your piece.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-strust-{{ section.id }} {
    background: #060d16;
    color: #ffffff;
    padding: 50px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-strust-container { max-width: 1360px; margin: 0 auto; }
  .d2c-strust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }
  .d2c-strust-item {
    background: #0f1c2d;
    border: 1px solid rgba(14, 165, 233, 0.2);
    border-radius: 8px;
    padding: 28px 18px;
  }
  .d2c-strust-icon { font-size: 26px; margin-bottom: 10px; }
  .d2c-strust-title { font-size: 12px; font-weight: 800; color: #38bdf8; letter-spacing: 0.5px; margin-bottom: 6px; text-transform: uppercase; font-family: monospace; }
  .d2c-strust-desc { font-size: 12px; color: #bae6fd; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-strust-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-strust-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Solitaire Trust Badges",
  "settings": [],
  "presets": [
    {
      "name": "Solitaire Trust Badges"
    }
  ]
}
{% endschema %}
