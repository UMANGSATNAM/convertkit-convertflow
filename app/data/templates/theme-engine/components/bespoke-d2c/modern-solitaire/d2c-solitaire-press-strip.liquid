{% comment %}
  D2C Modern Solitaire Press Strip
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-press" id="d2c-spress-{{ section.id }}">
  <div class="d2c-spress-container">
    <span class="d2c-spress-label">FEATURED IN LEADING MEDIA</span>
    <div class="d2c-spress-logos">
      <span class="d2c-splogo">FORBES INDIA</span>
      <span class="d2c-splogo">VOGUE DIAMOND REPORT</span>
      <span class="d2c-splogo">MINT LOUNGE</span>
      <span class="d2c-splogo">GRAZIA LUXURY</span>
      <span class="d2c-splogo">THE ECONOMIC TIMES</span>
    </div>
  </div>
</section>

<style>
  #d2c-spress-{{ section.id }} {
    background: #09131f;
    padding: 30px 32px;
    border-bottom: 1px solid rgba(14, 165, 233, 0.2);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-spress-container {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .d2c-spress-label { font-size: 11px; font-weight: 800; color: #38bdf8; letter-spacing: 1px; text-transform: uppercase; font-family: monospace; }
  .d2c-spress-logos { display: flex; gap: 36px; align-items: center; flex-wrap: wrap; }
  .d2c-splogo { font-size: 14px; font-weight: 900; color: #bae6fd; letter-spacing: 0.5px; opacity: 0.9; }

  @media (max-width: 768px) {
    .d2c-spress-container { justify-content: center; text-align: center; }
    .d2c-spress-logos { justify-content: center; gap: 20px; }
  }
</style>

{% schema %}
{
  "name": "Solitaire Press Strip",
  "settings": [],
  "presets": [
    {
      "name": "Solitaire Press Strip"
    }
  ]
}
{% endschema %}
