{% comment %}
  D2C Modern Solitaire Header
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<header class="d2c-solitaire-header" id="d2c-shead-{{ section.id }}">
  <div class="d2c-shead-container">
    <div class="d2c-shead-left">
      <a href="/collections/solitaire-rings" class="d2c-snav-link">RINGS</a>
      <a href="/collections/diamond-earrings" class="d2c-snav-link">EARRINGS</a>
      <a href="/collections/mangalsutras" class="d2c-snav-link">MANGALSUTRAS</a>
      <a href="/collections/tennis-bracelets" class="d2c-snav-link">BRACELETS</a>
    </div>

    <div class="d2c-shead-logo-box">
      <a href="/" class="d2c-shead-logo">
        <span class="d2c-slogo-title">{{ section.settings.brand_name | default: "SOLITAIRE ATELIER" }}</span>
        <span class="d2c-slogo-sub">IGI & GIA CERTIFIED NATURAL & LAB DIAMONDS</span>
      </a>
    </div>

    <div class="d2c-shead-right">
      <a href="/pages/try-at-home" class="d2c-snav-link highlight">🏠 TRY AT HOME</a>
      <a href="/cart" class="d2c-snav-link">BAG ({{ cart.item_count | default: 0 }})</a>
    </div>
  </div>
</header>

<style>
  #d2c-shead-{{ section.id }} {
    background: #060d16;
    border-bottom: 1px solid rgba(14, 165, 233, 0.25);
    padding: 18px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  .d2c-shead-container {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr auto 1fr;
    align-items: center;
  }
  .d2c-shead-left { display: flex; gap: 24px; }
  .d2c-shead-right { display: flex; gap: 24px; justify-content: flex-end; align-items: center; }
  .d2c-snav-link {
    color: #e0f2fe;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
  }
  .d2c-snav-link.highlight {
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    color: #ffffff;
    padding: 7px 16px;
    border-radius: 4px;
    font-size: 11px;
  }
  .d2c-shead-logo {
    text-align: center;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .d2c-slogo-title {
    font-size: 22px;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .d2c-slogo-sub {
    font-size: 9px;
    color: #38bdf8;
    letter-spacing: 1.5px;
    margin-top: 2px;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .d2c-shead-left { display: none; }
    .d2c-shead-container { display: flex; justify-content: space-between; }
    #d2c-shead-{{ section.id }} { padding: 14px 18px; }
  }
</style>

{% schema %}
{
  "name": "Solitaire Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "SOLITAIRE ATELIER"
    }
  ],
  "presets": [
    {
      "name": "Solitaire Header"
    }
  ]
}
{% endschema %}
