{% comment %}
  D2C Modern Solitaire Promo Banner
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-promo" id="d2c-spromo-{{ section.id }}">
  <div class="d2c-spromo-container">
    <div class="d2c-spromo-card">
      <span class="d2c-s-badge" style="color: #38bdf8;">FESTIVE SOLITAIRE CELEBRATION</span>
      <h2 class="d2c-spromo-title">{{ section.settings.title | default: "FLAT 100% OFF MAKING CHARGES ON ALL CERTIFIED SOLITAIRES" }}</h2>
      <p class="d2c-spromo-desc">Book your appointment this week and receive a complimentary 1gm 24kt gold coin + Free Doorstep Try At Home.</p>
      <a href="/collections/solitaire-rings" class="d2c-spromo-btn">SHOP SOLITAIRES &rarr;</a>
    </div>
  </div>
</section>

<style>
  #d2c-spromo-{{ section.id }} {
    background: #09131f;
    padding: 50px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-spromo-container { max-width: 1360px; margin: 0 auto; }
  .d2c-spromo-card {
    background: linear-gradient(135deg, #0f1c2d 0%, #060d16 100%);
    border: 1px solid rgba(14, 165, 233, 0.35);
    border-radius: 12px;
    padding: 56px 36px;
    text-align: center;
    box-shadow: 0 20px 45px -10px rgba(0,0,0,0.8);
  }
  .d2c-spromo-title { font-size: clamp(26px, 3.5vw, 40px); font-weight: 900; color: #ffffff; letter-spacing: -0.5px; margin: 10px 0 14px; text-transform: uppercase; }
  .d2c-spromo-desc { font-size: 15px; color: #bae6fd; max-width: 600px; margin: 0 auto 28px; line-height: 1.6; }
  .d2c-spromo-btn {
    display: inline-block;
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    color: #ffffff;
    padding: 14px 32px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
  }
  .d2c-spromo-btn:hover { opacity: 0.9; }
</style>

{% schema %}
{
  "name": "Solitaire Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FLAT 100% OFF MAKING CHARGES ON ALL CERTIFIED SOLITAIRES"
    }
  ],
  "presets": [
    {
      "name": "Solitaire Promo Banner"
    }
  ]
}
{% endschema %}
