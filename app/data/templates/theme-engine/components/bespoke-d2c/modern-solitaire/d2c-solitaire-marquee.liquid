    </div>
  </div>
</div>

<style>
  #d2c-sribbon-{{ section.id }} {
    background: linear-gradient(90deg, #0ea5e9 0%, #0284c7 100%);
    color: #ffffff;
    overflow: hidden;
    white-space: nowrap;
    padding: 12px 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .d2c-sribbon-track { display: flex; overflow: hidden; }
  .d2c-sribbon-content {
    display: flex;
    align-items: center;
    gap: 32px;
    animation: d2c-sribbon-scroll 22s linear infinite;
  }
  .d2c-sribbon-sep { font-size: 14px; color: #ffffff; opacity: 0.8; }
  @keyframes d2c-sribbon-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
</style>

