{% comment %}
  D2C Modern Solitaire VIP Club
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-vip" id="d2c-svip-{{ section.id }}">
  <div class="d2c-solitaire-container">
    <div class="d2c-svip-box">
      <div class="d2c-ssec-header">
        <span class="d2c-s-badge">SOLITAIRE PRIVILEGES</span>
        <h2 class="d2c-s-title">{{ section.settings.title | default: "THE SOLITAIRE ELITE CIRCLE" }}</h2>
        <p class="d2c-svip-desc">Earn diamond rewards, unlock 100% value carat upgrades, and receive annual ultrasonic spa cleaning.</p>
      </div>

      <div class="d2c-svip-grid">
        <div class="d2c-svip-card">
          <div class="d2c-sv-tag">TIER 1 // DIAMOND INSIDER</div>
          <div class="d2c-sv-title">LIFETIME FREE CLEANING & SPA</div>
          <p class="d2c-sv-desc">Complimentary yearly prong tightening, rhodium replating, and ultrasonic diamond polishing.</p>
        </div>

        <div class="d2c-svip-card popular">
          <span class="d2c-sv-pill">RECOMMENDED</span>
          <div class="d2c-sv-tag">TIER 2 // SOLITAIRE ELITE</div>
          <div class="d2c-sv-title">100% VALUE CARAT UPGRADE</div>
          <p class="d2c-sv-desc">Trade in your solitaire diamond anytime for a larger carat size at 100% original purchase credit.</p>
        </div>

        <div class="d2c-svip-card">
          <div class="d2c-sv-tag">TIER 3 // ATELIER GUILD</div>
          <div class="d2c-sv-title">CUSTOM 3D CAD DESIGN</div>
          <p class="d2c-sv-desc">Work with our master jewelry CAD artists to custom model your dream engagement ring from scratch.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-svip-{{ section.id }} {
    background: #09131f;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-solitaire-container { max-width: 1360px; margin: 0 auto; }
  .d2c-svip-box {
    background: #0f1c2d;
    border-radius: 12px;
    padding: 48px 36px;
    border: 1px solid rgba(14, 165, 233, 0.3);
  }
  .d2c-svip-desc { font-size: 15px; color: #bae6fd; max-width: 540px; margin: 8px auto 0; text-align: center; }
  .d2c-svip-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .d2c-svip-card {
    background: #060d16;
    border: 1px solid rgba(14, 165, 233, 0.2);
    border-radius: 8px;
    padding: 32px 24px;
    text-align: center;
    position: relative;
  }
  .d2c-svip-card.popular { border: 2px solid #0ea5e9; }
  .d2c-sv-pill {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    color: #ffffff;
    font-size: 9px;
    font-weight: 900;
    padding: 3px 10px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    font-family: monospace;
  }
  .d2c-sv-tag { font-size: 10px; font-weight: 800; color: #38bdf8; letter-spacing: 1px; margin-bottom: 8px; font-family: monospace; }
  .d2c-sv-title { font-size: 14px; font-weight: 900; color: #ffffff; margin-bottom: 10px; }
  .d2c-sv-desc { font-size: 13px; color: #bae6fd; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-svip-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Solitaire VIP Perks",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE SOLITAIRE ELITE CIRCLE"
    }
  ],
  "presets": [
    {
      "name": "Solitaire VIP Perks"
    }
  ]
}
{% endschema %}
