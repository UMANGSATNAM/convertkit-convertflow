{% comment %}
  D2C Modern Solitaire Proposals Gallery
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-ugc" id="d2c-sugc-{{ section.id }}">
  <div class="d2c-sugc-container">
    <div class="d2c-ssec-header">
      <span class="d2c-s-badge">#SOLITAIREPROPOSALS</span>
      <h2 class="d2c-s-title">{{ section.settings.title | default: "CELEBRATING 50,000+ 'YES' MOMENTS" }}</h2>
    </div>

    <div class="d2c-sugc-grid">
      <div class="d2c-sugc-tile"><img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=600&q=80" alt="Proposal 1" /><span>@rohit_ankita · 1.50 Ct Crown</span></div>
      <div class="d2c-sugc-tile"><img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=600&q=80" alt="Proposal 2" /><span>@karan_sneha · Solitaire Studs</span></div>
      <div class="d2c-sugc-tile"><img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Proposal 3" /><span>@rahul_simran · Mangalsutra</span></div>
      <div class="d2c-sugc-tile"><img src="https://images.unsplash.com/photo-1611591475152-478d1c582489?w=600&q=80" alt="Proposal 4" /><span>@vikram_tanya · Tennis Bracelet</span></div>
    </div>
  </div>
</section>

<style>
  #d2c-sugc-{{ section.id }} {
    background: #09131f;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-sugc-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sugc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .d2c-sugc-tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    background: #0f1c2d;
    border: 1px solid rgba(14, 165, 233, 0.3);
  }
  .d2c-sugc-tile img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-sugc-tile span {
    position: absolute;
    bottom: 8px;
    left: 8px;
    right: 8px;
    background: rgba(6,13,22,0.85);
    color: #bae6fd;
    font-size: 11px;
    font-weight: 800;
    padding: 6px;
    text-align: center;
    border-radius: 4px;
    font-family: monospace;
  }

  @media (max-width: 900px) { .d2c-sugc-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

{% schema %}
{
  "name": "Solitaire Community",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "CELEBRATING 50,000+ 'YES' MOMENTS"
    }
  ],
  "presets": [
    {
      "name": "Solitaire Community"
    }
  ]
}
{% endschema %}
