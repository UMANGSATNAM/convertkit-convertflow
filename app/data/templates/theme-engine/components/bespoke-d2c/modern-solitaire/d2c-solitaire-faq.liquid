{% comment %}
  -----------------------------------------------------------------------------
  10X Bespoke D2C Architecture: CaratLane / BlueStone - FAQ Accordion
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'd2c-solitaire-faq'
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#0f172a'
  assign accent_color = section.settings.accent_color | default: '#0ea5e9'
  assign title = section.settings.title | default: 'FREQUENTLY ASKED QUESTIONS'
  assign subtitle = section.settings.subtitle | default: 'CLEAR ANSWERS • ZERO AMBIGUITY'
-%}

<section id="d2c-faq-{{ sec_id }}" class="d2c-faq-wrap">
  <div class="d2c-faq-container">
    <div class="d2c-faq-header">
      <span class="d2c-faq-sub">{{ subtitle }}</span>
      <h2 class="d2c-faq-title">{{ title }}</h2>
    </div>

    <div class="d2c-faq-list">
      
      <details class="d2c-faq-item" open>
        <summary class="d2c-faq-question">
          <span>How does the 'Try At Home' appointment work?</span>
          <span class="d2c-faq-icon">+</span>
        </summary>
        <div class="d2c-faq-answer">
          <p>Book online, select 5 designs, and our certified consultant brings them to your doorstep with zero buying obligation.</p>
        </div>
      </details>
      
      <details class="d2c-faq-item" >
        <summary class="d2c-faq-question">
          <span>What diamond clarity and cut grades do you offer?</span>
          <span class="d2c-faq-icon">+</span>
        </summary>
        <div class="d2c-faq-answer">
          <p>We offer exclusively Triple Excellent cut diamonds with VVS and VS clarity grades.</p>
        </div>
      </details>
      
      <details class="d2c-faq-item" >
        <summary class="d2c-faq-question">
          <span>Can rings be resized after delivery?</span>
          <span class="d2c-faq-icon">+</span>
        </summary>
        <div class="d2c-faq-answer">
          <p>We provide free ring resizing within 30 days of purchase.</p>
        </div>
      </details>
      
      <details class="d2c-faq-item" >
        <summary class="d2c-faq-question">
          <span>Is the diamond certified by an independent laboratory?</span>
          <span class="d2c-faq-icon">+</span>
        </summary>
        <div class="d2c-faq-answer">
          <p>Yes, every diamond above 0.20ct comes with an authentic IGI or GIA certificate card.</p>
        </div>
      </details>
      
    </div>
  </div>
</section>

<style>
  #d2c-faq-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  #d2c-faq-{{ sec_id }} .d2c-faq-container { max-width: 860px; margin: 0 auto; }
  #d2c-faq-{{ sec_id }} .d2c-faq-header { text-align: center; margin-bottom: 36px; }
  #d2c-faq-{{ sec_id }} .d2c-faq-sub { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #d2c-faq-{{ sec_id }} .d2c-faq-title { font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(26px, 3.5vw, 38px); font-weight: 900; margin: 6px 0 0 0; }

  #d2c-faq-{{ sec_id }} .d2c-faq-list { display: flex; flex-direction: column; gap: 14px; }
  #d2c-faq-{{ sec_id }} .d2c-faq-item {
    background: #f8fafc;
    border: 1px solid rgba(14, 165, 233, 0.18);
    border-radius: 12px;
    overflow: hidden;
  }
  #d2c-faq-{{ sec_id }} .d2c-faq-question {
    padding: 18px 22px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 15px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
    color: {{ text_color }};
  }
  #d2c-faq-{{ sec_id }} .d2c-faq-icon { font-size: 18px; color: {{ accent_color }}; transition: transform 0.2s ease; }
  #d2c-faq-{{ sec_id }} details[open] .d2c-faq-icon { transform: rotate(45deg); }
  #d2c-faq-{{ sec_id }} .d2c-faq-answer { padding: 0 22px 18px 22px; font-size: 14px; line-height: 1.6; color: #475569; }
</style>

{% schema %}
{
  "name": "CaratLane / BlueStone FAQ",
  "tag": "section",
  "class": "d2c-faq-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Heading", "default": "FREQUENTLY ASKED QUESTIONS" },
    { "type": "text", "id": "subtitle", "label": "Subtitle Tag", "default": "CLEAR ANSWERS • ZERO AMBIGUITY" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#0f172a" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#0ea5e9" }
  ],
  "presets": [
    { "name": "CaratLane / BlueStone FAQ" }
  ]
}
{% endschema %}
