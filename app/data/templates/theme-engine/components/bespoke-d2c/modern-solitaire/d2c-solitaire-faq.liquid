{% comment %}
  D2C Modern Solitaire FAQ
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-faq" id="d2c-sfaq-{{ section.id }}">
  <div class="d2c-sfaq-container">
    <div class="d2c-ssec-header">
      <span class="d2c-s-badge">FREQUENTLY ASKED QUESTIONS</span>
      <h2 class="d2c-s-title">{{ section.settings.title | default: "SOLITAIRE & DIAMOND INQUIRIES" }}</h2>
    </div>

    <div class="d2c-sfaq-list">
      <details class="d2c-sfaq-item" open>
        <summary class="d2c-sfaq-q">
          <span>How does the free 'Try At Home' appointment work?</span>
          <span class="d2c-sfaq-icon">+</span>
        </summary>
        <div class="d2c-sfaq-a">
          Select up to 5 designs on our website. Our certified jewelry consultant brings the samples in a secure case to your home or office. Try them on, check ring sizing, and decide with zero purchase obligation.
        </div>
      </details>

      <details class="d2c-sfaq-item">
        <summary class="d2c-sfaq-q">
          <span>How do I verify the IGI / GIA Diamond Certificate?</span>
          <span class="d2c-sfaq-icon">+</span>
        </summary>
        <div class="d2c-sfaq-a">
          Every diamond over 0.30 cts is laser-inscribed with its unique certificate number on the girdle. You can verify the grading report instantly on the official IGI or GIA website or app.
        </div>
      </details>

      <details class="d2c-sfaq-item">
        <summary class="d2c-sfaq-q">
          <span>What if the ring size doesn't fit after delivery?</span>
          <span class="d2c-sfaq-icon">+</span>
        </summary>
        <div class="d2c-sfaq-a">
          We offer 100% free doorstep resizing within 30 days of purchase. We send a complimentary ring sizer and arrange insured pickup and return at zero extra cost.
        </div>
      </details>

      <details class="d2c-sfaq-item">
        <summary class="d2c-sfaq-q">
          <span>What is your lifetime buyback and exchange policy?</span>
          <span class="d2c-sfaq-icon">+</span>
        </summary>
        <div class="d2c-sfaq-a">
          We offer 100% exchange value on prevailing gold & platinum rates and 90% buyback on certified diamonds anytime across 200+ offline stores nationwide.
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  #d2c-sfaq-{{ section.id }} {
    background: #060d16;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-sfaq-container { max-width: 860px; margin: 0 auto; }
  .d2c-sfaq-list { display: flex; flex-direction: column; gap: 12px; margin-top: 36px; }
  .d2c-sfaq-item {
    background: #0f1c2d;
    border: 1px solid rgba(14, 165, 233, 0.2);
    border-radius: 8px;
    overflow: hidden;
  }
  .d2c-sfaq-q {
    padding: 20px 24px;
    font-size: 15px;
    font-weight: 800;
    color: #ffffff;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }
  .d2c-sfaq-q::-webkit-details-marker { display: none; }
  .d2c-sfaq-icon { font-size: 20px; font-weight: 800; color: #38bdf8; font-family: monospace; }
  details[open] .d2c-sfaq-icon { transform: rotate(45deg); display: inline-block; }
  .d2c-sfaq-a {
    padding: 0 24px 20px;
    font-size: 14px;
    color: #bae6fd;
    line-height: 1.6;
  }
</style>

{% schema %}
{
  "name": "Solitaire FAQ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SOLITAIRE & DIAMOND INQUIRIES"
    }
  ],
  "presets": [
    {
      "name": "Solitaire FAQ"
    }
  ]
}
{% endschema %}
