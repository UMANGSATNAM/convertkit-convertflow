{% comment %}
  D2C Modern Solitaire Bridal Trio Bundle
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-bundle" id="d2c-sbundle-{{ section.id }}">
  <div class="d2c-sbundle-container">
    <div class="d2c-sbundle-box">
      <div class="d2c-sbundle-info">
        <span class="d2c-s-badge">BRIDAL SOLITAIRE TRIO</span>
        <h2 class="d2c-sbundle-title">{{ section.settings.title | default: "THE MODERN BRIDAL SOLITAIRE SUITE" }}</h2>
        <p class="d2c-sbundle-desc">
          Complete your modern wedding diamond wardrobe: 1.0 Ct Crown Solitaire Ring + Infinity Diamond Mangalsutra + 0.50 Ct Solitaire Studs in 18kt Gold.
        </p>
        <div class="d2c-sbundle-price">TRIO BUNDLE: ₹2,45,000 <span class="d2c-sb-orig">₹2,92,000</span> <span class="d2c-sb-save">SAVE ₹47,000</span></div>
        <button class="d2c-sb-btn">CUSTOMIZE BRIDAL SOLITAIRE TRIO &rarr;</button>
      </div>

      <div class="d2c-sbundle-visual">
        <div class="d2c-sbi-card">
          <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=400&q=80" alt="Solitaire Ring" />
          <span>Solitaire Ring</span>
        </div>
        <span class="d2c-sbi-plus">+</span>
        <div class="d2c-sbi-card">
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=400&q=80" alt="Mangalsutra" />
          <span>Mangalsutra</span>
        </div>
        <span class="d2c-sbi-plus">+</span>
        <div class="d2c-sbi-card">
          <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=400&q=80" alt="Studs" />
          <span>Solitaire Studs</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-sbundle-{{ section.id }} {
    background: #09131f;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-sbundle-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sbundle-box {
    background: #0f1c2d;
    border-radius: 12px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    border: 1px solid rgba(14, 165, 233, 0.3);
  }
  .d2c-sbundle-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #ffffff; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-sbundle-desc { font-size: 15px; color: #e0f2fe; line-height: 1.6; margin-bottom: 24px; }
  .d2c-sbundle-price { font-size: 20px; font-weight: 900; color: #ffffff; margin-bottom: 28px; font-family: monospace; }
  .d2c-sb-orig { font-size: 14px; color: #94a3b8; text-decoration: line-through; margin-left: 6px; }
  .d2c-sb-save { background: rgba(14, 165, 233, 0.2); color: #38bdf8; font-size: 11px; font-weight: 800; padding: 4px 8px; border-radius: 4px; margin-left: 8px; border: 1px solid #0ea5e9; }
  .d2c-sb-btn {
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    color: #ffffff;
    border: none;
    padding: 16px 32px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-sbundle-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .d2c-sbi-card {
    background: #060d16;
    border: 1px solid rgba(14, 165, 233, 0.2);
    border-radius: 8px;
    overflow: hidden;
    text-align: center;
    padding: 8px;
    width: 120px;
  }
  .d2c-sbi-card img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; margin-bottom: 6px; }
  .d2c-sbi-card span { font-size: 10px; font-weight: 800; color: #ffffff; }
  .d2c-sbi-plus { font-size: 20px; font-weight: 800; color: #0ea5e9; }

  @media (max-width: 900px) {
    .d2c-sbundle-box { grid-template-columns: 1fr; padding: 24px; }
  }
</style>

{% schema %}
{
  "name": "Solitaire Bundle Box",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE MODERN BRIDAL SOLITAIRE SUITE"
    }
  ],
  "presets": [
    {
      "name": "Solitaire Bundle Box"
    }
  ]
}
{% endschema %}
