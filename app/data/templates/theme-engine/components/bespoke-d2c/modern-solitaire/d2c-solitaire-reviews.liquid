{% comment %}
  D2C Modern Solitaire Verified Reviews
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-reviews" id="d2c-srev-{{ section.id }}">
  <div class="d2c-solitaire-container">
    <div class="d2c-ssec-header">
      <span class="d2c-s-badge">VERIFIED REVIEWS</span>
      <h2 class="d2c-s-title">{{ section.settings.title | default: "LOVED BY 40,000+ MODERN COUPLES" }}</h2>
    </div>

    <div class="d2c-srev-grid">
      <div class="d2c-srev-card">
        <div class="d2c-srev-stars">★★★★★</div>
        <p class="d2c-srev-quote">"The Try At Home service blew my mind. They brought 5 solitaire ring designs to our apartment on a Sunday. My fiancé loved the 1.50 Ct Crown setting immediately!"</p>
        <div class="d2c-srev-author">
          <span class="d2c-srev-name">Aditya & Simran Kapoor</span>
          <span class="d2c-srev-loc">Bengaluru • Crown Solitaire Ring</span>
        </div>
      </div>

      <div class="d2c-srev-card">
        <div class="d2c-srev-stars">★★★★★</div>
        <p class="d2c-srev-quote">"IGI certification verified online with the exact serial number laser-etched on the diamond girdle. Complete peace of mind and significantly better value than legacy offline jewellers."</p>
        <div class="d2c-srev-author">
          <span class="d2c-srev-name">Nikhil Mehra</span>
          <span class="d2c-srev-loc">Mumbai • 1.0 Ct VVS1 Solitaire</span>
        </div>
      </div>

      <div class="d2c-srev-card">
        <div class="d2c-srev-stars">★★★★★</div>
        <p class="d2c-srev-quote">"The modern infinity mangalsutra is stunning. Sleek, lightweight, and modern enough to wear to my corporate office every single day without feeling too heavy."</p>
        <div class="d2c-srev-author">
          <span class="d2c-srev-name">Pooja Venkatesh</span>
          <span class="d2c-srev-loc">Hyderabad • Diamond Mangalsutra</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-srev-{{ section.id }} {
    background: #060d16;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-solitaire-container { max-width: 1360px; margin: 0 auto; }
  .d2c-srev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .d2c-srev-card {
    background: #0f1c2d;
    border: 1px solid rgba(14, 165, 233, 0.2);
    border-radius: 8px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .d2c-srev-stars { color: #38bdf8; font-size: 16px; margin-bottom: 12px; }
  .d2c-srev-quote { font-size: 14px; color: #e0f2fe; line-height: 1.6; margin-bottom: 20px; }
  .d2c-srev-name { font-size: 15px; font-weight: 800; color: #ffffff; display: block; margin-bottom: 2px; }
  .d2c-srev-loc { font-size: 11px; color: #38bdf8; font-family: monospace; }

  @media (max-width: 900px) { .d2c-srev-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Solitaire Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "LOVED BY 40,000+ MODERN COUPLES"
    }
  ],
  "presets": [
    {
      "name": "Solitaire Reviews"
    }
  ]
}
{% endschema %}
