{% comment %}
  D2C Modern Solitaire Video Reels
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-reels" id="d2c-sreels-{{ section.id }}">
  <div class="d2c-sreels-container">
    <div class="d2c-ssec-header">
      <span class="d2c-s-badge">360° SPARKLE & TRY AT HOME</span>
      <h2 class="d2c-s-title">{{ section.settings.title | default: "EXPERIENCE REAL DIAMOND SPARKLE IN MOTION" }}</h2>
    </div>

    <div class="d2c-sreels-grid">
      <div class="d2c-sreel-card">
        <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=600&q=80" alt="1.5ct Solitaire Ring" />
        <div class="d2c-sreel-overlay">
          <span class="d2c-sreel-tag">360° LIGHT REFRACTION</span>
          <h4 class="d2c-sreel-name">Crown Solitaire in Natural Sunlight</h4>
          <span class="d2c-sreel-pill">Crown Ring · ₹1,45,000</span>
        </div>
      </div>

      <div class="d2c-sreel-card">
        <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=600&q=80" alt="Try At Home Box" />
        <div class="d2c-sreel-overlay">
          <span class="d2c-sreel-tag">TRY AT HOME EXPERIENCE</span>
          <h4 class="d2c-sreel-name">Trying 5 Ring Designs with Family</h4>
          <span class="d2c-sreel-pill">Free Doorstep Try On</span>
        </div>
      </div>

      <div class="d2c-sreel-card">
        <img src="https://images.unsplash.com/photo-1611591475152-478d1c582489?w=600&q=80" alt="Tennis Bracelet Reel" />
        <div class="d2c-sreel-overlay">
          <span class="d2c-sreel-tag">PLATINUM 950 SETTING</span>
          <h4 class="d2c-sreel-name">Starlight Full Eternity Bracelet</h4>
          <span class="d2c-sreel-pill">Tennis Bracelet · ₹2,85,000</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-sreels-{{ section.id }} {
    background: #09131f;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-sreels-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sreels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .d2c-sreel-card {
    position: relative;
    aspect-ratio: 9/16;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(14, 165, 233, 0.3);
    cursor: pointer;
  }
  .d2c-sreel-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .d2c-sreel-card:hover img { transform: scale(1.05); }
  .d2c-sreel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(9,19,31,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: #ffffff;
  }
  .d2c-sreel-tag { font-size: 10px; font-weight: 800; color: #38bdf8; letter-spacing: 1px; margin-bottom: 4px; font-family: monospace; }
  .d2c-sreel-name { font-size: 15px; font-weight: 800; margin-bottom: 12px; }
  .d2c-sreel-pill {
    background: #0ea5e9;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: 4px;
    display: inline-block;
    align-self: flex-start;
  }

  @media (max-width: 900px) { .d2c-sreels-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Solitaire Reels",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "EXPERIENCE REAL DIAMOND SPARKLE IN MOTION"
    }
  ],
  "presets": [
    {
      "name": "Solitaire Reels"
    }
  ]
}
{% endschema %}
