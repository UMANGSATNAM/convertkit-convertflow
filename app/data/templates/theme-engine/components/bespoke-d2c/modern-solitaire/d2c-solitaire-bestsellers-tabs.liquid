{% comment %}
  D2C Modern Solitaire Bestseller Vault
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-best" id="d2c-sbest-{{ section.id }}">
  <div class="d2c-sbest-container">
    <div class="d2c-ssec-header">
      <span class="d2c-s-badge">POPULAR SOLITAIRES</span>
      <h2 class="d2c-s-title">{{ section.settings.title | default: "VERIFIED 4CS SOLITAIRE BENCHMARKS" }}</h2>
    </div>

    <div class="d2c-sprod-grid">
      <!-- Item 1 -->
      <div class="d2c-sprod-card">
        <div class="d2c-sprod-thumb">
          <span class="d2c-sprod-pill">1.0 CT • VVS-EF</span>
          <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=600&q=80" alt="Crown Solitaire Ring" />
        </div>
        <div class="d2c-sprod-body">
          <span class="d2c-sprod-spec">18KT WHITE GOLD • TRIPLE EXCELLENT</span>
          <h3 class="d2c-sprod-title">The Royal Crown Solitaire Ring</h3>
          <div class="d2c-sprod-price">₹1,45,000 <span class="d2c-sprod-orig">₹1,75,000</span></div>
          <button class="d2c-satc-btn">TRY AT HOME FOR FREE</button>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="d2c-sprod-card">
        <div class="d2c-sprod-thumb">
          <span class="d2c-sprod-pill">0.75 CT • VVS1</span>
          <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=600&q=80" alt="Solitaire Studs" />
        </div>
        <div class="d2c-sprod-body">
          <span class="d2c-sprod-spec">18KT YELLOW GOLD • 4-PRONG SET</span>
          <h3 class="d2c-sprod-title">Classic Round Solitaire Studs</h3>
          <div class="d2c-sprod-price">₹85,000 <span class="d2c-sprod-orig">₹1,05,000</span></div>
          <button class="d2c-satc-btn">TRY AT HOME FOR FREE</button>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="d2c-sprod-card">
        <div class="d2c-sprod-thumb">
          <span class="d2c-sprod-pill">0.50 CT • EF COLOR</span>
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Diamond Mangalsutra" />
        </div>
        <div class="d2c-sprod-body">
          <span class="d2c-sprod-spec">18KT ROSE GOLD • BLACK BEADS</span>
          <h3 class="d2c-sprod-title">Minimal Infinity Diamond Mangalsutra</h3>
          <div class="d2c-sprod-price">₹62,000 <span class="d2c-sprod-orig">₹78,000</span></div>
          <button class="d2c-satc-btn">TRY AT HOME FOR FREE</button>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="d2c-sprod-card">
        <div class="d2c-sprod-thumb">
          <span class="d2c-sprod-pill">3.50 CTS TOTAL</span>
          <img src="https://images.unsplash.com/photo-1611591475152-478d1c582489?w=600&q=80" alt="Tennis Bracelet" />
        </div>
        <div class="d2c-sprod-body">
          <span class="d2c-sprod-spec">PLATINUM 950 • FULL ETERNITY</span>
          <h3 class="d2c-sprod-title">Starlight Diamond Tennis Bracelet</h3>
          <div class="d2c-sprod-price">₹2,85,000 <span class="d2c-sprod-orig">₹3,40,000</span></div>
          <button class="d2c-satc-btn">TRY AT HOME FOR FREE</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-sbest-{{ section.id }} {
    background: #060d16;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-sbest-container { max-width: 1360px; margin: 0 auto; }
  .d2c-sprod-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .d2c-sprod-card {
    background: #0f1c2d;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(14, 165, 233, 0.2);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .d2c-sprod-thumb { position: relative; aspect-ratio: 1; overflow: hidden; background: #162438; }
  .d2c-sprod-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-sprod-pill {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #0ea5e9;
    color: #ffffff;
    font-size: 9px;
    font-weight: 900;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    font-family: monospace;
  }
  .d2c-sprod-body { padding: 18px; display: flex; flex-direction: column; flex-grow: 1; justify-content: space-between; }
  .d2c-sprod-spec { font-size: 10px; font-weight: 800; color: #38bdf8; letter-spacing: 0.5px; margin-bottom: 4px; font-family: monospace; }
  .d2c-sprod-title { font-size: 14px; font-weight: 800; color: #ffffff; margin-bottom: 10px; }
  .d2c-sprod-price { font-size: 16px; font-weight: 900; color: #ffffff; margin-bottom: 14px; }
  .d2c-sprod-orig { font-size: 12px; color: #94a3b8; text-decoration: line-through; margin-left: 6px; }
  .d2c-satc-btn {
    width: 100%;
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    color: #ffffff;
    border: none;
    padding: 12px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-satc-btn:hover { opacity: 0.9; }

  @media (max-width: 1024px) { .d2c-sprod-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-sprod-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } .d2c-sprod-body { padding: 12px; } }
</style>

{% schema %}
{
  "name": "Solitaire Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "VERIFIED 4CS SOLITAIRE BENCHMARKS"
    }
  ],
  "presets": [
    {
      "name": "Solitaire Bestsellers"
    }
  ]
}
{% endschema %}
