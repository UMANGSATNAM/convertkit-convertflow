{% comment %}
  D2C Modern Solitaire Newsletter
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-news" id="d2c-snews-{{ section.id }}">
  <div class="d2c-solitaire-container">
    <div class="d2c-snews-card">
      <span class="d2c-s-badge">THE DIAMOND DISPATCH</span>
      <h2 class="d2c-snews-title">{{ section.settings.title | default: "UNLOCK ₹3,000 OFF YOUR FIRST SOLITAIRE" }}</h2>
      <p class="d2c-snews-desc">Join 60,000+ diamond enthusiasts receiving monthly carat pricing trends, styling guides, and private invite-only sale access.</p>

      <form class="d2c-snews-form">
        <input type="email" placeholder="Enter your email address" class="d2c-snews-input" required />
        <button type="submit" class="d2c-snews-btn">CLAIM ₹3,000 VOUCHER &rarr;</button>
      </form>
      <div class="d2c-snews-privacy">🔒 Zero spam. Unsubscribe anytime with 1 click.</div>
    </div>
  </div>
</section>

<style>
  #d2c-snews-{{ section.id }} {
    background: #09131f;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-solitaire-container { max-width: 860px; margin: 0 auto; }
  .d2c-snews-card {
    background: #0f1c2d;
    border-radius: 12px;
    padding: 48px 36px;
    text-align: center;
    border: 1px solid rgba(14, 165, 233, 0.3);
  }
  .d2c-snews-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #ffffff; margin: 10px 0 12px; text-transform: uppercase; }
  .d2c-snews-desc { font-size: 15px; color: #bae6fd; margin-bottom: 28px; }
  .d2c-snews-form { display: flex; gap: 10px; max-width: 480px; margin: 0 auto 14px; }
  .d2c-snews-input {
    flex: 1;
    background: #060d16;
    border: 1px solid rgba(14, 165, 233, 0.3);
    padding: 14px 18px;
    border-radius: 4px;
    font-size: 14px;
    color: #ffffff;
    outline: none;
  }
  .d2c-snews-input:focus { border-color: #0ea5e9; }
  .d2c-snews-btn {
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    color: #ffffff;
    border: none;
    padding: 14px 28px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-snews-btn:hover { opacity: 0.9; }
  .d2c-snews-privacy { font-size: 12px; color: #94a3b8; }

  @media (max-width: 600px) {
    .d2c-snews-form { flex-direction: column; }
    .d2c-snews-card { padding: 32px 20px; }
  }
</style>

{% schema %}
{
  "name": "Solitaire Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "UNLOCK ₹3,000 OFF YOUR FIRST SOLITAIRE"
    }
  ],
  "presets": [
    {
      "name": "Solitaire Newsletter"
    }
  ]
}
{% endschema %}
