{% comment %}
  D2C Modern Solitaire Try At Home Booking Popup
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<div class="d2c-solitaire-popup" id="d2c-spop-{{ section.id }}" style="display: none;">
  <div class="d2c-spop-overlay">
    <div class="d2c-spop-card">
      <button class="d2c-spop-close" onclick="document.getElementById('d2c-spop-{{ section.id }}').style.display='none';">&times;</button>
      <span class="d2c-s-badge" style="color: #38bdf8;">DOORSTEP DIAMOND TRIAL</span>
      <h3 class="d2c-spop-title">TRY UP TO 5 SOLITAIRE DESIGNS AT HOME FOR FREE</h3>
      <p class="d2c-spop-desc">Our certified diamond consultant will visit your home with a secure collection box + Free Ring Sizer.</p>

      <form class="d2c-spop-form">
        <input type="text" placeholder="Your Full Name" class="d2c-spop-input" required />
        <input type="email" placeholder="Your Email Address" class="d2c-spop-input" required />
        <input type="tel" placeholder="Mobile Number for Appointment Confirmation" class="d2c-spop-input" required />
        <input type="text" placeholder="City & Pincode (e.g. Mumbai 400050)" class="d2c-spop-input" required />
        <button type="submit" class="d2c-spop-btn">SCHEDULE FREE DOORSTEP TRIAL &rarr;</button>
      </form>
    </div>
  </div>
</div>

<style>
  .d2c-spop-overlay {
    position: fixed;
    inset: 0;
    background: rgba(6, 13, 22, 0.85);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-spop-card {
    background: #0f1c2d;
    border-radius: 12px;
    padding: 44px 32px;
    max-width: 460px;
    width: 100%;
    text-align: center;
    position: relative;
    border: 2px solid #0ea5e9;
    box-shadow: 0 20px 45px -10px rgba(0,0,0,0.9);
  }
  .d2c-spop-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: #bae6fd;
    font-size: 22px;
    cursor: pointer;
  }
  .d2c-spop-title { font-size: 17px; font-weight: 900; color: #ffffff; margin: 8px 0 10px; text-transform: uppercase; line-height: 1.25; }
  .d2c-spop-desc { font-size: 14px; color: #bae6fd; margin-bottom: 22px; }
  .d2c-spop-form { display: flex; flex-direction: column; gap: 10px; }
  .d2c-spop-input {
    background: #060d16;
    border: 1px solid rgba(14, 165, 233, 0.3);
    padding: 12px 16px;
    border-radius: 4px;
    font-size: 14px;
    color: #ffffff;
    outline: none;
  }
  .d2c-spop-input:focus { border-color: #0ea5e9; }
  .d2c-spop-btn {
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    color: #ffffff;
    border: none;
    padding: 14px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
    margin-top: 6px;
  }
</style>

{% schema %}
{
  "name": "Solitaire Try At Home",
  "settings": [],
  "presets": [
    {
      "name": "Solitaire Try At Home"
    }
  ]
}
{% endschema %}
