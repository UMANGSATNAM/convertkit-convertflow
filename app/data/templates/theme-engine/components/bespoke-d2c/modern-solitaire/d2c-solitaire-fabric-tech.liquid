{% comment %}
  D2C Modern Solitaire 4Cs Diamond Matrix
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-matrix" id="d2c-smat-{{ section.id }}">
  <div class="d2c-smat-container">
    <div class="d2c-ssec-header">
      <span class="d2c-s-badge">THE 4CS BENCHMARK</span>
      <h2 class="d2c-s-title">{{ section.settings.title | default: "OUR UNCOMPROMISING DIAMOND STANDARDS" }}</h2>
    </div>

    <div class="d2c-smat-grid">
      <div class="d2c-smat-card">
        <div class="d2c-smat-val">3X EX</div>
        <div class="d2c-smat-name">TRIPLE EXCELLENT CUT</div>
        <p class="d2c-smat-desc">Cut, polish, and symmetry graded 'Excellent' by IGI for maximum light dispersion and fire.</p>
      </div>

      <div class="d2c-smat-card">
        <div class="d2c-smat-val">VVS-EF</div>
        <div class="d2c-smat-name">TOP COLOR & CLARITY</div>
        <p class="d2c-smat-desc">Completely eye-clean diamonds with zero visible inclusions and completely colorless hue.</p>
      </div>

      <div class="d2c-smat-card">
        <div class="d2c-smat-val">100%</div>
        <div class="d2c-smat-name">IGI & GIA CERTIFIED</div>
        <p class="d2c-smat-desc">Every diamond is laser-inscribed on the girdle with a unique certificate serial number.</p>
      </div>

      <div class="d2c-smat-card">
        <div class="d2c-smat-val">PT 950</div>
        <div class="d2c-smat-name">PLATINUM ALLOY STRENGTH</div>
        <p class="d2c-smat-desc">Prongs cast in dense 950 pure platinum to ensure zero diamond loosening over a lifetime.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-smat-{{ section.id }} {
    background: #060d16;
    padding: 70px 32px;
    border-top: 1px solid rgba(14, 165, 233, 0.2);
    border-bottom: 1px solid rgba(14, 165, 233, 0.2);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-smat-container { max-width: 1360px; margin: 0 auto; }
  .d2c-smat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-smat-card {
    background: #0f1c2d;
    border: 1px solid rgba(14, 165, 233, 0.2);
    border-radius: 8px;
    padding: 32px 20px;
    text-align: center;
  }
  .d2c-smat-val { font-size: 28px; font-weight: 900; color: #38bdf8; margin-bottom: 6px; font-family: monospace; }
  .d2c-smat-name { font-size: 12px; font-weight: 800; color: #ffffff; letter-spacing: 0.5px; margin-bottom: 10px; }
  .d2c-smat-desc { font-size: 13px; color: #e0f2fe; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-smat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-smat-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Solitaire 4Cs Matrix",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "OUR UNCOMPROMISING DIAMOND STANDARDS"
    }
  ],
  "presets": [
    {
      "name": "Solitaire 4Cs Matrix"
    }
  ]
}
{% endschema %}
