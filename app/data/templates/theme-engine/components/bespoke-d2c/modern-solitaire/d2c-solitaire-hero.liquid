{% comment %}
  D2C Modern Solitaire Engagement Ring Hero
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-hero" id="d2c-shero-{{ section.id }}">
  <div class="d2c-shero-container">
    <div class="d2c-shero-grid">
      <div class="d2c-shero-text">
        <span class="d2c-shero-badge">💎 IGI & GIA CERTIFIED • TRIPLE EXCELLENT CUT</span>
        <h1 class="d2c-shero-title">{{ section.settings.heading | default: "BRILLIANT SOLITAIRES DESIGNED FOR MODERN LOVE" }}</h1>
        <p class="d2c-shero-desc">
          Crafted in 18kt Hallmarked Gold and 950 Pure Platinum. Choose from hand-selected VVS-EF natural or sustainable lab-grown solitaires with laser-inscribed diamond certificates.
        </p>

        <div class="d2c-shero-actions">
          <a href="/collections/solitaire-rings" class="d2c-sbtn-primary">EXPLORE SOLITAIRES &rarr;</a>
          <a href="/pages/try-at-home" class="d2c-sbtn-secondary">BOOK FREE TRY AT HOME</a>
        </div>

        <div class="d2c-shero-specs">
          <div class="d2c-sspec"><strong>VVS-EF</strong> <span>Top Color & Clarity</span></div>
          <div class="d2c-sspec"><strong>100%</strong> <span>Certified By IGI/GIA</span></div>
          <div class="d2c-sspec"><strong>15 DAYS</strong> <span>100% Refund Guarantee</span></div>
        </div>
      </div>

      <div class="d2c-shero-media">
        <div class="d2c-shero-frame">
          <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=900&q=85" alt="Solitaire Diamond Ring" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-shero-{{ section.id }} {
    background: #09131f;
    color: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-shero-container { max-width: 1360px; margin: 0 auto; }
  .d2c-shero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }
  .d2c-shero-badge {
    font-size: 11px;
    font-weight: 800;
    color: #38bdf8;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 16px;
    display: block;
  }
  .d2c-shero-title {
    font-size: clamp(34px, 4vw, 50px);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.1;
    letter-spacing: -0.5px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }
  .d2c-shero-desc {
    font-size: 16px;
    color: #e0f2fe;
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 540px;
  }
  .d2c-shero-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }
  .d2c-sbtn-primary {
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    color: #ffffff;
    padding: 16px 32px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
  }
  .d2c-sbtn-secondary {
    background: transparent;
    border: 1px solid #0ea5e9;
    color: #38bdf8;
    padding: 16px 28px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
  }
  .d2c-shero-specs {
    display: flex;
    gap: 36px;
    border-top: 1px solid rgba(14, 165, 233, 0.25);
    padding-top: 24px;
  }
  .d2c-sspec strong { font-size: 22px; font-weight: 900; color: #38bdf8; display: block; }
  .d2c-sspec span { font-size: 12px; color: #bae6fd; }
  .d2c-shero-frame {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(14, 165, 233, 0.4);
    box-shadow: 0 20px 45px -10px rgba(0,0,0,0.8);
  }
  .d2c-shero-frame img { width: 100%; height: 500px; object-fit: cover; }

  @media (max-width: 900px) {
    .d2c-shero-grid { grid-template-columns: 1fr; }
    .d2c-shero-frame img { height: 360px; }
    #d2c-shero-{{ section.id }} { padding: 40px 18px; }
  }
</style>

{% schema %}
{
  "name": "Solitaire Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BRILLIANT SOLITAIRES DESIGNED FOR MODERN LOVE"
    }
  ],
  "presets": [
    {
      "name": "Solitaire Hero"
    }
  ]
}
{% endschema %}
