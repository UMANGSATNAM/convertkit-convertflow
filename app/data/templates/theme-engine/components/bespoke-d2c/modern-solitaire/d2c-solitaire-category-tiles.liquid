{% comment %}
  D2C Modern Solitaire Category Grid
  Theme: CaratLane / BlueStone Modern Solitaire Diamonds
{% endcomment %}

<section class="d2c-solitaire-cats" id="d2c-scats-{{ section.id }}">
  <div class="d2c-scats-container">
    <div class="d2c-ssec-header">
      <span class="d2c-s-badge">DIAMOND DIRECTORY</span>
      <h2 class="d2c-s-title">{{ section.settings.title | default: "FINE SOLITAIRES BY SILHOUETTE" }}</h2>
    </div>

    <div class="d2c-scats-grid">
      <a href="/collections/solitaire-rings" class="d2c-scat-card">
        <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=600&q=80" alt="Solitaire Rings" />
        <div class="d2c-scat-overlay">
          <span class="d2c-scat-sub">ENGAGEMENT & PROMISES</span>
          <h3 class="d2c-scat-name">SOLITAIRE RINGS</h3>
          <span class="d2c-scat-link">EXPLORE STYLES &rarr;</span>
        </div>
      </a>

      <a href="/collections/diamond-earrings" class="d2c-scat-card">
        <img src="https://images.unsplash.com/photo-1630019852942-f89202989a59?w=600&q=80" alt="Diamond Studs" />
        <div class="d2c-scat-overlay">
          <span class="d2c-scat-sub">DAILY WEAR ELEGANCE</span>
          <h3 class="d2c-scat-name">SOLITAIRE STUDS & HOOPS</h3>
          <span class="d2c-scat-link">EXPLORE &rarr;</span>
        </div>
      </a>

      <a href="/collections/mangalsutras" class="d2c-scat-card">
        <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Diamond Mangalsutras" />
        <div class="d2c-scat-overlay">
          <span class="d2c-scat-sub">MODERN SACRED THREADS</span>
          <h3 class="d2c-scat-name">DIAMOND MANGALSUTRAS</h3>
          <span class="d2c-scat-link">EXPLORE &rarr;</span>
        </div>
      </a>

      <a href="/collections/tennis-bracelets" class="d2c-scat-card">
        <img src="https://images.unsplash.com/photo-1611591475152-478d1c582489?w=600&q=80" alt="Tennis Bracelets" />
        <div class="d2c-scat-overlay">
          <span class="d2c-scat-sub">FULL ETERNITY WRISTWEAR</span>
          <h3 class="d2c-scat-name">TENNIS BRACELETS</h3>
          <span class="d2c-scat-link">EXPLORE &rarr;</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  #d2c-scats-{{ section.id }} {
    background: #09131f;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .d2c-scats-container { max-width: 1360px; margin: 0 auto; }
  .d2c-ssec-header { text-align: center; margin-bottom: 48px; }
  .d2c-s-badge { font-size: 11px; font-weight: 800; color: #38bdf8; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px; display: block; }
  .d2c-s-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 900; color: #ffffff; letter-spacing: -0.5px; text-transform: uppercase; }
  .d2c-scats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-scat-card {
    position: relative;
    height: 420px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(14, 165, 233, 0.3);
    text-decoration: none;
    display: block;
  }
  .d2c-scat-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .d2c-scat-card:hover img { transform: scale(1.06); }
  .d2c-scat-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(9,19,31,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: #ffffff;
    text-align: center;
  }
  .d2c-scat-sub { font-size: 10px; font-weight: 800; color: #38bdf8; letter-spacing: 1.5px; margin-bottom: 4px; }
  .d2c-scat-name { font-size: 16px; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 6px; }
  .d2c-scat-link { font-size: 11px; font-weight: 800; color: #bae6fd; }

  @media (max-width: 1024px) { .d2c-scats-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-scats-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Solitaire Categories",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FINE SOLITAIRES BY SILHOUETTE"
    }
  ],
  "presets": [
    {
      "name": "Solitaire Categories"
    }
  ]
}
{% endschema %}
