{% comment %}
  D2C Royal Heritage Private Salon Privileges
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-vip" id="d2c-rvip-{{ section.id }}">
  <div class="d2c-rvip-container">
    <div class="d2c-rvip-box">
      <div class="d2c-royal-sec-header">
        <span class="d2c-r-badge">HAUTE COUTURE CIRCLE</span>
        <h2 class="d2c-r-title">{{ section.settings.title | default: "THE IMPERIAL PATRON PRIVILEGES" }}</h2>
        <p class="d2c-rvip-sub">Dedicated to brides and families commissioning generational royal heirlooms.</p>
      </div>

      <div class="d2c-rvip-grid">
        <div class="d2c-rvip-card">
          <div class="d2c-rvip-title">SALON TRIAL // COMPLIMENTARY</div>
          <div class="d2c-rvip-desc">Private 2-hour salon suite with champagne service and personal bridal curator.</div>
        </div>

        <div class="d2c-rvip-card active">
          <div class="d2c-rvip-crest">👑 MOST REQUESTED</div>
          <div class="d2c-rvip-title">BESPOKE EMBROIDERY // 1-OF-1</div>
          <div class="d2c-rvip-desc">Hand-embroidered personal bridal vows and heirloom initials in 22kt bullion thread.</div>
        </div>

        <div class="d2c-rvip-card">
          <div class="d2c-rvip-title">ARMORED DOORSTEP // WORLDWIDE</div>
          <div class="d2c-rvip-desc">White-glove personal delivery inside a hand-carved cedar trunk with master fitter.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-rvip-{{ section.id }} {
    background: #180505;
    padding: 70px 32px;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rvip-container { max-width: 1360px; margin: 0 auto; }
  .d2c-rvip-box {
    background: #230808;
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 12px;
    padding: 50px 40px;
  }
  .d2c-rvip-sub { font-size: 16px; color: #dfc59e; font-style: italic; margin-top: 8px; }
  .d2c-rvip-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }
  .d2c-rvip-card {
    background: #180505;
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 8px;
    padding: 32px 24px;
    text-align: center;
    position: relative;
  }
  .d2c-rvip-card.active { border-color: #d4af37; box-shadow: 0 0 25px rgba(212, 175, 55, 0.15); }
  .d2c-rvip-crest {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #d4af37;
    color: #180505;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 12px;
    border-radius: 4px;
    letter-spacing: 1.5px;
  }
  .d2c-rvip-title { font-size: 16px; font-weight: 700; color: #d4af37; letter-spacing: 1.5px; margin-bottom: 12px; }
  .d2c-rvip-desc { font-size: 14px; color: #dfc59e; line-height: 1.6; font-style: italic; }

  @media (max-width: 900px) { .d2c-rvip-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Royal VIP Perks",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE IMPERIAL PATRON PRIVILEGES"
    }
  ],
  "presets": [
    {
      "name": "Royal VIP Perks"
    }
  ]
}
{% endschema %}
