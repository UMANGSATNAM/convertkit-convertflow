{% comment %}
  D2C Royal Heritage Bridal FAQ
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-faq" id="d2c-rfaq-{{ section.id }}">
  <div class="d2c-rfaq-container">
    <div class="d2c-royal-sec-header">
      <span class="d2c-r-badge">CONSULTATION INTEL</span>
      <h2 class="d2c-r-title">{{ section.settings.title | default: "BRIDAL ATELIER INQUIRIES" }}</h2>
    </div>

    <div class="d2c-rfaq-list">
      <details class="d2c-rfaq-item" open>
        <summary class="d2c-rfaq-q">
          <span>How far in advance should I commission my bridal lehenga?</span>
          <span class="d2c-rfaq-icon">✦</span>
        </summary>
        <div class="d2c-rfaq-a">
          We recommend scheduling your private salon consultation 4 to 6 months prior to your wedding ceremonies. This ensures adequate time for custom pattern making, 1,800+ needlework hours, and multiple personalized drape trials.
        </div>
      </details>

      <details class="d2c-rfaq-item">
        <summary class="d2c-rfaq-q">
          <span>How do international bridal trials and fittings work?</span>
          <span class="d2c-rfaq-icon">✦</span>
        </summary>
        <div class="d2c-rfaq-a">
          For our international brides across the US, UK, Canada, and the UAE, we dispatch personalized muslin toiles and arrange high-definition video fitting sessions with our head atelier masterjis.
        </div>
      </details>

      <details class="d2c-rfaq-item">
        <summary class="d2c-rfaq-q">
          <span>How should I preserve authentic 22kt gold and silver zari weaves?</span>
          <span class="d2c-rfaq-icon">✦</span>
        </summary>
        <div class="d2c-rfaq-a">
          Always wrap pure zari textiles in unbleached pure cotton or mulmul cloth. Store inside natural cedarwood boxes away from humidity, artificial deodorants, and direct sunlight.
        </div>
      </details>

      <details class="d2c-rfaq-item">
        <summary class="d2c-rfaq-q">
          <span>Are bridal orders delivered with full armored insurance?</span>
          <span class="d2c-rfaq-icon">✦</span>
        </summary>
        <div class="d2c-rfaq-a">
          Yes. All bridal heirloom deliveries are handled via temperature-controlled, tamper-evident armored courier partners with 100% full-value insurance protection.
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  #d2c-rfaq-{{ section.id }} {
    background: #180505;
    padding: 70px 32px;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rfaq-container { max-width: 900px; margin: 0 auto; }
  .d2c-rfaq-list { display: flex; flex-direction: column; gap: 16px; margin-top: 40px; }
  .d2c-rfaq-item {
    background: #230808;
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 6px;
    overflow: hidden;
  }
  .d2c-rfaq-q {
    padding: 22px 28px;
    font-size: 17px;
    font-weight: 700;
    color: #fff9eb;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }
  .d2c-rfaq-q::-webkit-details-marker { display: none; }
  .d2c-rfaq-icon { color: #d4af37; font-size: 16px; }
  details[open] .d2c-rfaq-icon { transform: rotate(45deg); display: inline-block; }
  .d2c-rfaq-a {
    padding: 0 28px 24px;
    font-size: 15px;
    color: #dfc59e;
    line-height: 1.7;
    font-style: italic;
  }
</style>

{% schema %}
{
  "name": "Royal FAQ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "BRIDAL ATELIER INQUIRIES"
    }
  ],
  "presets": [
    {
      "name": "Royal FAQ"
    }
  ]
}
{% endschema %}
