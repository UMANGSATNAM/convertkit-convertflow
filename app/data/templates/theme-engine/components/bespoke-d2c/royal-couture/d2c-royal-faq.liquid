{% comment %}
  -----------------------------------------------------------------------------
  10X Bespoke D2C Architecture: Sabyasachi / Raw Mango - FAQ Accordion
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign sec_id = section.id | default: 'd2c-royal-faq'
  assign bg_color = section.settings.bg_color | default: '#260b0b'
  assign text_color = section.settings.text_color | default: '#fff7ed'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
  assign title = section.settings.title | default: 'FREQUENTLY ASKED QUESTIONS'
  assign subtitle = section.settings.subtitle | default: 'CLEAR ANSWERS • ZERO AMBIGUITY'
-%}

<section id="d2c-faq-{{ sec_id }}" class="d2c-faq-wrap">
  <div class="d2c-faq-container">
    <div class="d2c-faq-header">
      <span class="d2c-faq-sub">{{ subtitle }}</span>
      <h2 class="d2c-faq-title">{{ title }}</h2>
    </div>

    <div class="d2c-faq-list">
      
      <details class="d2c-faq-item" open>
        <summary class="d2c-faq-question">
          <span>How can I verify the Silk Mark authenticity?</span>
          <span class="d2c-faq-icon">+</span>
        </summary>
        <div class="d2c-faq-answer">
          <p>Every creation is delivered with a tamper-evident holographic Silk Mark India certificate and unique QR code.</p>
        </div>
      </details>
      
      <details class="d2c-faq-item" >
        <summary class="d2c-faq-question">
          <span>Can custom blouse stitching and sizing be requested?</span>
          <span class="d2c-faq-icon">+</span>
        </summary>
        <div class="d2c-faq-answer">
          <p>Yes, our master atelier provides bespoke custom-fit tailoring and hand-stitched lining upon order confirmation.</p>
        </div>
      </details>
      
      <details class="d2c-faq-item" >
        <summary class="d2c-faq-question">
          <span>How should pure Zari heirlooms be preserved?</span>
          <span class="d2c-faq-icon">+</span>
        </summary>
        <div class="d2c-faq-answer">
          <p>Wrap in unbleached muslin cloth and store in a moisture-free cedar chest. Dry clean only.</p>
        </div>
      </details>
      
      <details class="d2c-faq-item" >
        <summary class="d2c-faq-question">
          <span>What is the lead time for bridal couture suites?</span>
          <span class="d2c-faq-icon">+</span>
        </summary>
        <div class="d2c-faq-answer">
          <p>Handcrafted bridal orders require 4 to 6 weeks of dedicated master weaving time.</p>
        </div>
      </details>
      
    </div>
  </div>
</section>

<style>
  #d2c-faq-{{ sec_id }} {
    background: {{ bg_color }};
    color: {{ text_color }};
    padding: clamp(48px, 6vw, 84px) 24px;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  #d2c-faq-{{ sec_id }} .d2c-faq-container { max-width: 860px; margin: 0 auto; }
  #d2c-faq-{{ sec_id }} .d2c-faq-header { text-align: center; margin-bottom: 36px; }
  #d2c-faq-{{ sec_id }} .d2c-faq-sub { font-size: 11px; font-weight: 800; color: {{ accent_color }}; letter-spacing: 1.5px; text-transform: uppercase; }
  #d2c-faq-{{ sec_id }} .d2c-faq-title { font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(26px, 3.5vw, 38px); font-weight: 900; margin: 6px 0 0 0; }

  #d2c-faq-{{ sec_id }} .d2c-faq-list { display: flex; flex-direction: column; gap: 14px; }
  #d2c-faq-{{ sec_id }} .d2c-faq-item {
    background: #180505;
    border: 1px solid rgba(212, 175, 55, 0.28);
    border-radius: 12px;
    overflow: hidden;
  }
  #d2c-faq-{{ sec_id }} .d2c-faq-question {
    padding: 18px 22px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 15px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
    color: {{ text_color }};
  }
  #d2c-faq-{{ sec_id }} .d2c-faq-icon { font-size: 18px; color: {{ accent_color }}; transition: transform 0.2s ease; }
  #d2c-faq-{{ sec_id }} details[open] .d2c-faq-icon { transform: rotate(45deg); }
  #d2c-faq-{{ sec_id }} .d2c-faq-answer { padding: 0 22px 18px 22px; font-size: 14px; line-height: 1.6; color: #e2d2ba; }
</style>

{% schema %}
{
  "name": "Sabyasachi / Raw Mango FAQ",
  "tag": "section",
  "class": "d2c-faq-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Heading", "default": "FREQUENTLY ASKED QUESTIONS" },
    { "type": "text", "id": "subtitle", "label": "Subtitle Tag", "default": "CLEAR ANSWERS • ZERO AMBIGUITY" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#260b0b" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#fff7ed" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [
    { "name": "Sabyasachi / Raw Mango FAQ" }
  ]
}
{% endschema %}
