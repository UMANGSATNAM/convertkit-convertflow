{% comment %}
  D2C Royal Heritage Grand Bridal Split Hero
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-hero" id="d2c-royal-hero-{{ section.id }}">
  <div class="d2c-royal-hero-container">
    <div class="d2c-royal-hero-grid">
      <div class="d2c-royal-hero-text">
        <div class="d2c-royal-badge">👑 100% REAL ZARI WEAVE</div>
        <h1 class="d2c-royal-hero-title">{{ section.settings.heading | default: "THE IMPERIAL BRIDAL HEIRLOOM '26" }}</h1>
        <p class="d2c-royal-hero-desc">
          Handcrafted over 1,800 karigar hours using antique hand-beaten bullion wire, real silver zari, and unstitched Banarasi katan silk weaves. An enduring testament to Indian heritage.
        </p>

        <div class="d2c-royal-hero-actions">
          <a href="{{ section.settings.btn_url | default: '/collections/bridal' }}" class="d2c-royal-btn-gold">
            EXPLORE THE BRIDAL ARCHIVE &rarr;
          </a>
          <a href="/pages/appointments" class="d2c-royal-btn-outline">
            BOOK SALON TRIAL
          </a>
        </div>

        <div class="d2c-royal-hero-meta-row">
          <div class="d2c-r-meta-item">
            <span class="d2c-r-num">1,800+</span>
            <span class="d2c-r-lbl">Karigar Hours</span>
          </div>
          <div class="d2c-r-meta-item">
            <span class="d2c-r-num">100%</span>
            <span class="d2c-r-lbl">Pure Katan Silk</span>
          </div>
          <div class="d2c-r-meta-item">
            <span class="d2c-r-num">1-of-1</span>
            <span class="d2c-r-lbl">Bespoke Heirlooms</span>
          </div>
        </div>
      </div>

      <div class="d2c-royal-hero-media">
        <div class="d2c-royal-arch-frame">
          <img src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=900&q=85" alt="Royal Bridal Couture" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-royal-hero-{{ section.id }} {
    background: #180505;
    color: #fff9eb;
    padding: 70px 32px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    position: relative;
    overflow: hidden;
  }
  .d2c-royal-hero-container { max-width: 1360px; margin: 0 auto; }
  .d2c-royal-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }
  .d2c-royal-badge {
    color: #d4af37;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .d2c-royal-hero-title {
    font-size: clamp(38px, 4.5vw, 60px);
    font-weight: 700;
    line-height: 1.1;
    color: #fff9eb;
    letter-spacing: 2px;
    margin-bottom: 24px;
    text-transform: uppercase;
  }
  .d2c-royal-hero-desc {
    font-size: 18px;
    color: #dfc59e;
    line-height: 1.7;
    margin-bottom: 36px;
    font-style: italic;
    max-width: 560px;
  }
  .d2c-royal-hero-actions {
    display: flex;
    gap: 20px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }
  .d2c-royal-btn-gold {
    background: #d4af37;
    color: #180505;
    padding: 16px 36px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .d2c-royal-btn-gold:hover { background: #e5c158; }
  .d2c-royal-btn-outline {
    background: transparent;
    border: 1px solid #d4af37;
    color: #d4af37;
    padding: 16px 32px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
  }
  .d2c-royal-hero-meta-row {
    display: flex;
    gap: 40px;
    border-top: 1px solid rgba(212, 175, 55, 0.25);
    padding-top: 24px;
  }
  .d2c-r-num { font-size: 24px; font-weight: 700; color: #d4af37; display: block; }
  .d2c-r-lbl { font-size: 12px; color: #dfc59e; letter-spacing: 1px; text-transform: uppercase; }

  .d2c-royal-arch-frame {
    border-radius: 200px 200px 12px 12px;
    overflow: hidden;
    border: 2px solid #d4af37;
    box-shadow: 0 20px 45px -10px rgba(0,0,0,0.8);
    position: relative;
  }
  .d2c-royal-arch-frame img { width: 100%; height: 560px; object-fit: cover; }

  @media (max-width: 900px) {
    .d2c-royal-hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .d2c-royal-arch-frame img { height: 400px; }
    #d2c-royal-hero-{{ section.id }} { padding: 40px 18px; }
  }
</style>

{% schema %}
{
  "name": "Royal Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE IMPERIAL BRIDAL HEIRLOOM '26"
    }
  ],
  "presets": [
    {
      "name": "Royal Hero"
    }
  ]
}
{% endschema %}
