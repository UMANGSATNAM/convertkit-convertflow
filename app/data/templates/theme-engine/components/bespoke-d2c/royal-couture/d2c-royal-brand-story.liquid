{% comment %}
  D2C Royal Heritage Master Weavers Story
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-story" id="d2c-rstory-{{ section.id }}">
  <div class="d2c-rstory-container">
    <div class="d2c-rstory-grid">
      <div class="d2c-rstory-text">
        <span class="d2c-r-badge">THE LIVING HERITAGE</span>
        <h2 class="d2c-rstory-title">{{ section.settings.title | default: "A HOMAGE TO INDIA'S ANCIENT MASTER WEAVERS" }}</h2>
        <p class="d2c-rstory-para">
          In a world consumed by rapid industrial mechanization, we preserve the meditative craft of traditional hand-thrown wooden shuttles, vegetable dye vats, and hand-embroidery needles.
        </p>
        <p class="d2c-rstory-para">
          Over 4,500 master weavers across Bengal, Varanasi, Kashmir, and Kanchipuram dedicate their lives to weaving historical tapestries that will endure for centuries.
        </p>
        <div class="d2c-rstory-stat-row">
          <div><span class="d2c-rst-num">4,500+</span><span class="d2c-rst-lbl">Hereditary Karigars</span></div>
          <div><span class="d2c-rst-num">14</span><span class="d2c-rst-lbl">Indigenous Weave Traditions</span></div>
          <div><span class="d2c-rst-num">100%</span><span class="d2c-rst-lbl">Ethical Fair Wages</span></div>
        </div>
      </div>

      <div class="d2c-rstory-media">
        <div class="d2c-rstory-arch">
          <img src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?w=800&q=80" alt="Master Weavers" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-rstory-{{ section.id }} {
    background: #180505;
    padding: 80px 32px;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rstory-container { max-width: 1360px; margin: 0 auto; }
  .d2c-rstory-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }
  .d2c-rstory-title { font-size: clamp(30px, 4vw, 46px); font-weight: 700; color: #fff9eb; letter-spacing: 1.5px; line-height: 1.15; margin: 12px 0 24px; text-transform: uppercase; }
  .d2c-rstory-para { font-size: 17px; color: #dfc59e; line-height: 1.7; font-style: italic; margin-bottom: 20px; }
  .d2c-rstory-stat-row {
    display: flex;
    gap: 36px;
    border-top: 1px solid rgba(212, 175, 55, 0.25);
    padding-top: 24px;
    margin-top: 32px;
  }
  .d2c-rst-num { font-size: 26px; font-weight: 700; color: #d4af37; display: block; }
  .d2c-rst-lbl { font-size: 11px; color: #dfc59e; letter-spacing: 1.5px; text-transform: uppercase; }
  .d2c-rstory-arch {
    border-radius: 180px 180px 8px 8px;
    overflow: hidden;
    border: 2px solid #d4af37;
  }
  .d2c-rstory-arch img { width: 100%; height: 500px; object-fit: cover; }

  @media (max-width: 900px) {
    .d2c-rstory-grid { grid-template-columns: 1fr; }
    .d2c-rstory-arch img { height: 360px; }
  }
</style>

{% schema %}
{
  "name": "Royal Story",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "A HOMAGE TO INDIA'S ANCIENT MASTER WEAVERS"
    }
  ],
  "presets": [
    {
      "name": "Royal Story"
    }
  ]
}
{% endschema %}
