{% comment %}
  D2C Royal Heritage Category Showcase
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-categories" id="d2c-rcat-{{ section.id }}">
  <div class="d2c-rcat-container">
    <div class="d2c-royal-sec-header">
      <span class="d2c-r-badge">THE ARCHIVES</span>
      <h2 class="d2c-r-title">{{ section.settings.title | default: "HEIRLOOM ATELIER CATEGORIES" }}</h2>
    </div>

    <div class="d2c-rcat-grid">
      <a href="/collections/bridal-lehengas" class="d2c-rcat-card">
        <img src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=700&q=80" alt="Bridal Lehengas" />
        <div class="d2c-rcat-overlay">
          <span class="d2c-rcat-k">THE ATELIER</span>
          <h3 class="d2c-rcat-name">BRIDAL LEHENGAS</h3>
          <span class="d2c-rcat-link">VIEW HEIRLOOMS &rarr;</span>
        </div>
      </a>

      <a href="/collections/handloom-sarees" class="d2c-rcat-card">
        <img src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?w=700&q=80" alt="Handloom Sarees" />
        <div class="d2c-rcat-overlay">
          <span class="d2c-rcat-k">VARANASI WEAVES</span>
          <h3 class="d2c-rcat-name">HANDLOOM SAREES</h3>
          <span class="d2c-rcat-link">VIEW HEIRLOOMS &rarr;</span>
        </div>
      </a>

      <a href="/collections/sherwanis" class="d2c-rcat-card">
        <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=700&q=80" alt="Imperial Sherwanis" />
        <div class="d2c-rcat-overlay">
          <span class="d2c-rcat-k">ROYAL MENSWEAR</span>
          <h3 class="d2c-rcat-name">IMPERIAL SHERWANIS</h3>
          <span class="d2c-rcat-link">VIEW HEIRLOOMS &rarr;</span>
        </div>
      </a>

      <a href="/collections/dupattas" class="d2c-rcat-card">
        <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=700&q=80" alt="Zardozi Dupattas" />
        <div class="d2c-rcat-overlay">
          <span class="d2c-rcat-k">PURE SILK ACCENTS</span>
          <h3 class="d2c-rcat-name">ZARDOZI DUPATTAS</h3>
          <span class="d2c-rcat-link">VIEW HEIRLOOMS &rarr;</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  #d2c-rcat-{{ section.id }} {
    background: #180505;
    padding: 70px 32px;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rcat-container { max-width: 1360px; margin: 0 auto; }
  .d2c-royal-sec-header { text-align: center; margin-bottom: 50px; }
  .d2c-r-badge { font-size: 13px; font-weight: 700; color: #d4af37; letter-spacing: 3px; text-transform: uppercase; display: block; margin-bottom: 8px; }
  .d2c-r-title { font-size: clamp(30px, 3.5vw, 44px); font-weight: 700; color: #fff9eb; letter-spacing: 2px; text-transform: uppercase; }
  .d2c-rcat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-rcat-card {
    position: relative;
    height: 440px;
    border-radius: 120px 120px 8px 8px;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.4);
    text-decoration: none;
    display: block;
  }
  .d2c-rcat-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .d2c-rcat-card:hover img { transform: scale(1.06); }
  .d2c-rcat-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(24,5,5,0.95) 0%, rgba(24,5,5,0.2) 60%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px 24px;
    color: #fff9eb;
    text-align: center;
  }
  .d2c-rcat-k { font-size: 11px; font-weight: 700; color: #d4af37; letter-spacing: 2px; margin-bottom: 4px; }
  .d2c-rcat-name { font-size: 20px; font-weight: 700; letter-spacing: 1.5px; margin-bottom: 8px; }
  .d2c-rcat-link { font-size: 11px; font-weight: 700; color: #dfc59e; letter-spacing: 1.5px; }

  @media (max-width: 1024px) { .d2c-rcat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .d2c-rcat-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Royal Categories",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HEIRLOOM ATELIER CATEGORIES"
    }
  ],
  "presets": [
    {
      "name": "Royal Categories"
    }
  ]
}
{% endschema %}
