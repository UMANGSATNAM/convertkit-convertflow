{% comment %}
  D2C Royal Heritage 1-of-1 Zardozi Spotlight
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-spotlight" id="d2c-rspot-{{ section.id }}">
  <div class="d2c-rspot-container">
    <div class="d2c-rspot-box">
      <div class="d2c-rspot-media">
        <img src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=900&q=85" alt="Master Karigar Bridal Piece" />
      </div>

      <div class="d2c-rspot-content">
        <span class="d2c-rspot-badge">1-OF-1 BESPOKE ATELIER CREATION</span>
        <h2 class="d2c-rspot-title">{{ section.settings.title | default: "THE EMPRESS MEHRAAB VELVET LEHENGA" }}</h2>
        <p class="d2c-rspot-text">
          Features intricately hand-embroidered Mughal floral lattice motifs using 22kt real gold bullion wire, seed pearls, and semi-precious emerald drops. Crafted by master craftsmen with lineages tracing back to the royal courts of Awadh.
        </p>

        <div class="d2c-rspot-specs">
          <div class="d2c-rs-item">
            <span class="d2c-rs-k">ATELIER TIME:</span>
            <span class="d2c-rs-v">1,840 Hours of Hand Needlework</span>
          </div>
          <div class="d2c-rs-item">
            <span class="d2c-rs-k">EMBROIDERY:</span>
            <span class="d2c-rs-v">Authentic Awadhi Zardozi & Vasli Work</span>
          </div>
          <div class="d2c-rs-item">
            <span class="d2c-rs-k">FABRIC BASE:</span>
            <span class="d2c-rs-v">Silk Velvet with Handloom Chanderi Dupatta</span>
          </div>
        </div>

        <div class="d2c-rspot-price">PRICE ON BESPOKE CONSULTATION</div>
        <a href="/pages/appointments" class="d2c-rspot-btn">REQUEST PRIVATE ATELIER VIEWING &rarr;</a>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-rspot-{{ section.id }} {
    background: #180505;
    padding: 70px 32px;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rspot-container { max-width: 1360px; margin: 0 auto; }
  .d2c-rspot-box {
    background: #230808;
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 12px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 60px;
    align-items: center;
  }
  .d2c-rspot-media {
    border-radius: 160px 160px 8px 8px;
    overflow: hidden;
    border: 2px solid #d4af37;
  }
  .d2c-rspot-media img { width: 100%; height: 500px; object-fit: cover; }
  .d2c-rspot-badge { font-size: 12px; font-weight: 700; color: #d4af37; letter-spacing: 2.5px; margin-bottom: 14px; display: block; }
  .d2c-rspot-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #fff9eb; line-height: 1.15; margin-bottom: 20px; text-transform: uppercase; }
  .d2c-rspot-text { font-size: 16px; color: #dfc59e; line-height: 1.7; font-style: italic; margin-bottom: 28px; }
  .d2c-rspot-specs {
    background: #180505;
    border: 1px solid rgba(212, 175, 55, 0.25);
    padding: 20px 24px;
    border-radius: 6px;
    margin-bottom: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .d2c-rs-item { display: flex; justify-content: space-between; font-size: 13px; }
  .d2c-rs-k { font-weight: 700; color: #d4af37; letter-spacing: 1px; }
  .d2c-rs-v { color: #fff9eb; }
  .d2c-rspot-price { font-size: 16px; font-weight: 700; color: #d4af37; letter-spacing: 2px; margin-bottom: 24px; }
  .d2c-rspot-btn {
    display: inline-block;
    background: #d4af37;
    color: #180505;
    padding: 16px 36px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .d2c-rspot-btn:hover { background: #e5c158; }

  @media (max-width: 900px) {
    .d2c-rspot-box { grid-template-columns: 1fr; padding: 24px; gap: 32px; }
    .d2c-rspot-media img { height: 360px; }
  }
</style>

{% schema %}
{
  "name": "Royal Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE EMPRESS MEHRAAB VELVET LEHENGA"
    }
  ],
  "presets": [
    {
      "name": "Royal Spotlight"
    }
  ]
}
{% endschema %}
