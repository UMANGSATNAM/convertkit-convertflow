{% comment %}
  D2C Royal Heritage Press Mentions
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-press" id="d2c-rpress-{{ section.id }}">
  <div class="d2c-rpress-container">
    <span class="d2c-rpress-label">CRITICALLY ACCLAIMED IN</span>
    <div class="d2c-rpress-logos">
      <span class="d2c-rlogo-item">VOGUE INDIA</span>
      <span class="d2c-rlogo-item">HARPER'S BAZAAR BRIDE</span>
      <span class="d2c-rlogo-item">ARCHITECTURAL DIGEST</span>
      <span class="d2c-rlogo-item">ELLE COUTURE</span>
      <span class="d2c-rlogo-item">THE NEW YORK TIMES</span>
    </div>
  </div>
</section>

<style>
  #d2c-rpress-{{ section.id }} {
    background: #180505;
    padding: 36px 32px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.25);
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rpress-container {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .d2c-rpress-label { font-size: 11px; font-weight: 700; color: #d4af37; letter-spacing: 2px; }
  .d2c-rpress-logos { display: flex; gap: 40px; align-items: center; flex-wrap: wrap; }
  .d2c-rlogo-item {
    font-size: 16px;
    font-weight: 700;
    color: #dfc59e;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.85;
  }

  @media (max-width: 768px) {
    .d2c-rpress-container { justify-content: center; text-align: center; }
    .d2c-rpress-logos { justify-content: center; gap: 20px; }
  }
</style>

{% schema %}
{
  "name": "Royal Press Strip",
  "settings": [],
  "presets": [
    {
      "name": "Royal Press Strip"
    }
  ]
}
{% endschema %}
