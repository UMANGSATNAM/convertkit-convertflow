    </div>
  </div>
</div>

<style>
  #d2c-ribbon-{{ section.id }} {
    background: #d4af37;
    color: #180505;
    overflow: hidden;
    white-space: nowrap;
    padding: 12px 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .d2c-ribbon-track { display: flex; overflow: hidden; }
  .d2c-ribbon-content {
    display: flex;
    align-items: center;
    gap: 32px;
    animation: d2c-ribbon-scroll 24s linear infinite;
  }
  .d2c-ribbon-sep { font-size: 14px; opacity: 0.7; }
  @keyframes d2c-ribbon-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
</style>

{% schema %}
{
  "name": "Royal Gold Ribbon",
