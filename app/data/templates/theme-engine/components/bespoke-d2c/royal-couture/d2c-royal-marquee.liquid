  <div class="d2c-ribbon-track">
    <div class="d2c-ribbon-content">
      <span class="d2c-ribbon-item">👑 100% PURE BANARASI KATAN SILK</span>
      <span class="d2c-ribbon-sep">✦</span>
      <span class="d2c-ribbon-item">AUTHENTIC 22KT GOLD ZARI EMBROIDERY</span>
      <span class="d2c-ribbon-sep">✦</span>
      <span class="d2c-ribbon-item">COMPLIMENTARY WORLDWIDE INSURED TRANSIT</span>
      <span class="d2c-ribbon-sep">✦</span>
      <span class="d2c-ribbon-item">MASTER WEAVERS OF BENGAL & VARANASI</span>
      <span class="d2c-ribbon-sep">✦</span>
      <span class="d2c-ribbon-item">👑 100% PURE BANARASI KATAN SILK</span>
      <span class="d2c-ribbon-sep">✦</span>
      <span class="d2c-ribbon-item">AUTHENTIC 22KT GOLD ZARI EMBROIDERY</span>
      <span class="d2c-ribbon-sep">✦</span>
      <span class="d2c-ribbon-item">COMPLIMENTARY WORLDWIDE INSURED TRANSIT</span>
