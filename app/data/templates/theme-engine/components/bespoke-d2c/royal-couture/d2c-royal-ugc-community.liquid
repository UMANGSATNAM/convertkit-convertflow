{% comment %}
  D2C Royal Heritage Brides & Grooms Gallery
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-brides" id="d2c-rbrides-{{ section.id }}">
  <div class="d2c-rbrides-container">
    <div class="d2c-royal-sec-header">
      <span class="d2c-r-badge">THE ROYAL REGISTRY</span>
      <h2 class="d2c-r-title">{{ section.settings.title | default: "HEIRLOOMS ACROSS GENERATIONS" }}</h2>
    </div>

    <div class="d2c-rbrides-grid">
      <div class="d2c-rbride-tile"><img src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=600&q=80" alt="Bride 1" /><span>Princess Gayatri • Lake Palace</span></div>
      <div class="d2c-rbride-tile"><img src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?w=600&q=80" alt="Bride 2" /><span>Mira Sethi • Rambagh Palace</span></div>
      <div class="d2c-rbride-tile"><img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=600&q=80" alt="Groom 3" /><span>Vikramaditya • Umaid Bhawan</span></div>
      <div class="d2c-rbride-tile"><img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600&q=80" alt="Bride 4" /><span>Tara Kapur • Falaknuma Palace</span></div>
    </div>
  </div>
</section>

<style>
  #d2c-rbrides-{{ section.id }} {
    background: #180505;
    padding: 70px 32px;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rbrides-container { max-width: 1360px; margin: 0 auto; }
  .d2c-rbrides-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .d2c-rbride-tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: 80px 80px 6px 6px;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.4);
  }
  .d2c-rbride-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .d2c-rbride-tile:hover img { transform: scale(1.06); }
  .d2c-rbride-tile span {
    position: absolute;
    bottom: 10px;
    left: 10px;
    right: 10px;
    background: rgba(24,5,5,0.85);
    color: #dfc59e;
    font-size: 11px;
    font-weight: 700;
    padding: 6px;
    text-align: center;
    border-radius: 4px;
    letter-spacing: 1px;
  }

  @media (max-width: 900px) { .d2c-rbrides-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

{% schema %}
{
  "name": "Royal Brides Gallery",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HEIRLOOMS ACROSS GENERATIONS"
    }
  ],
  "presets": [
    {
      "name": "Royal Brides Gallery"
    }
  ]
}
{% endschema %}
