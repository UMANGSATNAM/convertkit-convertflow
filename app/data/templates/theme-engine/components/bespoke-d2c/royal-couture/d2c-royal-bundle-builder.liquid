{% comment %}
  D2C Royal Bridal Trousseau 3-Piece Suite
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-trousseau" id="d2c-rtrou-{{ section.id }}">
  <div class="d2c-rtrou-container">
    <div class="d2c-rtrou-box">
      <div class="d2c-rtrou-info">
        <span class="d2c-r-badge">COMPLETE BRIDAL SUITE</span>
        <h2 class="d2c-rtrou-title">{{ section.settings.title | default: "THE IMPERIAL BRIDAL TROUSSEAU SET" }}</h2>
        <p class="d2c-rtrou-desc">
          A bespoke wedding curation comprising the Main Ceremony Lehenga, an unstitched Handloom Saree for the Sangeet, and a Hand-Embroidered Zardozi Veil. Housed in a brass-bound cedarwood keepsake trunk.
        </p>
        <div class="d2c-rtrou-price">COMPLETE 3-PIECE SUITE // ₹6,50,000</div>
        <a href="/pages/appointments" class="d2c-rtrou-btn">REQUEST BESPOKE TROUSSEAU CONSULTATION &rarr;</a>
      </div>

      <div class="d2c-rtrou-items">
        <div class="d2c-rti-card">
          <img src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=400&q=80" alt="Lehenga" />
          <span>Bridal Lehenga</span>
        </div>
        <span class="d2c-rti-plus">+</span>
        <div class="d2c-rti-card">
          <img src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?w=400&q=80" alt="Saree" />
          <span>Katan Saree</span>
        </div>
        <span class="d2c-rti-plus">+</span>
        <div class="d2c-rti-card">
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=400&q=80" alt="Dupatta" />
          <span>Zardozi Veil</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-rtrou-{{ section.id }} {
    background: #180505;
    padding: 70px 32px;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rtrou-container { max-width: 1360px; margin: 0 auto; }
  .d2c-rtrou-box {
    background: #230808;
    border: 2px solid #d4af37;
    border-radius: 12px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
  }
  .d2c-rtrou-title { font-size: clamp(28px, 3vw, 40px); font-weight: 700; color: #fff9eb; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-rtrou-desc { font-size: 16px; color: #dfc59e; line-height: 1.7; font-style: italic; margin-bottom: 24px; }
  .d2c-rtrou-price { font-size: 18px; font-weight: 700; color: #d4af37; letter-spacing: 2px; margin-bottom: 28px; }
  .d2c-rtrou-btn {
    display: inline-block;
    background: #d4af37;
    color: #180505;
    padding: 16px 36px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .d2c-rtrou-btn:hover { background: #e5c158; }
  .d2c-rtrou-items {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .d2c-rti-card {
    background: #180505;
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 60px 60px 6px 6px;
    overflow: hidden;
    text-align: center;
    padding: 8px;
    width: 120px;
  }
  .d2c-rti-card img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 50px 50px 4px 4px; margin-bottom: 6px; }
  .d2c-rti-card span { font-size: 11px; font-weight: 700; color: #dfc59e; letter-spacing: 1px; }
  .d2c-rti-plus { font-size: 20px; color: #d4af37; font-weight: 700; }

  @media (max-width: 900px) {
    .d2c-rtrou-box { grid-template-columns: 1fr; padding: 24px; }
  }
</style>

{% schema %}
{
  "name": "Royal Trousseau Set",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE IMPERIAL BRIDAL TROUSSEAU SET"
    }
  ],
  "presets": [
    {
      "name": "Royal Trousseau Set"
    }
  ]
}
{% endschema %}
