{% comment %}
  D2C Royal Heritage Journal Newsletter
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-journal" id="d2c-rjourn-{{ section.id }}">
  <div class="d2c-rjourn-container">
    <div class="d2c-rjourn-box">
      <span class="d2c-r-badge">THE HERITAGE GAZETTE</span>
      <h2 class="d2c-rjourn-title">{{ section.settings.title | default: "RECEIVE PRIVATE ATELIER INVITATIONS" }}</h2>
      <p class="d2c-rjourn-desc">Subscribe to receive exclusive access to unpublished bridal lookbooks and secret archival releases.</p>

      <form class="d2c-rjourn-form">
        <input type="email" placeholder="Enter your email address" class="d2c-rjourn-input" required />
        <button type="submit" class="d2c-rjourn-btn">REQUEST ACCESS &rarr;</button>
      </form>
      <div class="d2c-rjourn-note">🔒 Strictly confidential. No unsolicited communications.</div>
    </div>
  </div>
</section>

<style>
  #d2c-rjourn-{{ section.id }} {
    background: #180505;
    padding: 70px 32px;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rjourn-container { max-width: 900px; margin: 0 auto; }
  .d2c-rjourn-box {
    background: #230808;
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 12px;
    padding: 50px 36px;
    text-align: center;
  }
  .d2c-rjourn-title { font-size: clamp(28px, 3.5vw, 40px); font-weight: 700; color: #fff9eb; letter-spacing: 1.5px; margin: 10px 0 14px; text-transform: uppercase; }
  .d2c-rjourn-desc { font-size: 16px; color: #dfc59e; font-style: italic; margin-bottom: 32px; }
  .d2c-rjourn-form { display: flex; gap: 12px; max-width: 540px; margin: 0 auto 16px; }
  .d2c-rjourn-input {
    flex: 1;
    background: #180505;
    border: 1px solid #d4af37;
    padding: 14px 20px;
    color: #fff9eb;
    font-family: inherit;
    font-size: 15px;
    outline: none;
  }
  .d2c-rjourn-btn {
    background: #d4af37;
    color: #180505;
    border: none;
    padding: 14px 28px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
  }
  .d2c-rjourn-note { font-size: 12px; color: #dfc59e; font-style: italic; opacity: 0.8; }

  @media (max-width: 600px) {
    .d2c-rjourn-form { flex-direction: column; }
    .d2c-rjourn-box { padding: 32px 20px; }
  }
</style>

{% schema %}
{
  "name": "Royal Journal",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "RECEIVE PRIVATE ATELIER INVITATIONS"
    }
  ],
  "presets": [
    {
      "name": "Royal Journal"
    }
  ]
}
{% endschema %}
