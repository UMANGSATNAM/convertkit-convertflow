{% comment %}
  D2C Royal Heritage Private Salon Appointment Banner
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-promo" id="d2c-rpromo-{{ section.id }}">
  <div class="d2c-rpromo-container">
    <div class="d2c-rpromo-box">
      <span class="d2c-r-badge">ATELIER PRIVILEGE</span>
      <h2 class="d2c-rpromo-title">{{ section.settings.title | default: "PRIVATE BRIDAL SALON APPOINTMENTS" }}</h2>
      <p class="d2c-rpromo-desc">
        Experience a 1-on-1 private styling session with our senior bridal curators at our flagships in Mumbai, Delhi, London, and New York.
      </p>
      <a href="/pages/appointments" class="d2c-rpromo-btn">SCHEDULE YOUR APPOINTMENT &rarr;</a>
    </div>
  </div>
</section>

<style>
  #d2c-rpromo-{{ section.id }} {
    background: #180505;
    padding: 50px 32px;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rpromo-container { max-width: 1360px; margin: 0 auto; }
  .d2c-rpromo-box {
    background: linear-gradient(135deg, #2a0b0b 0%, #180505 100%);
    border: 1px solid #d4af37;
    border-radius: 12px;
    padding: 60px 30px;
    text-align: center;
    box-shadow: 0 20px 40px -10px rgba(0,0,0,0.6);
  }
  .d2c-rpromo-title { font-size: clamp(30px, 4vw, 46px); font-weight: 700; color: #fff9eb; letter-spacing: 2px; text-transform: uppercase; margin: 12px 0 16px; }
  .d2c-rpromo-desc { font-size: 17px; color: #dfc59e; font-style: italic; max-width: 680px; margin: 0 auto 32px; line-height: 1.6; }
  .d2c-rpromo-btn {
    display: inline-block;
    background: #d4af37;
    color: #180505;
    padding: 16px 36px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .d2c-rpromo-btn:hover { background: #e5c158; }
</style>

{% schema %}
{
  "name": "Royal Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "PRIVATE BRIDAL SALON APPOINTMENTS"
    }
  ],
  "presets": [
    {
      "name": "Royal Promo Banner"
    }
  ]
}
{% endschema %}
