{% comment %}
  D2C Royal Heritage Client Letters & Testimonials
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-reviews" id="d2c-rrev-{{ section.id }}">
  <div class="d2c-rrev-container">
    <div class="d2c-royal-sec-header">
      <span class="d2c-r-badge">WORDS OF ESTEEM</span>
      <h2 class="d2c-r-title">{{ section.settings.title | default: "HEIRLOOMS CHERISHED ACROSS GENERATIONS" }}</h2>
    </div>

    <div class="d2c-rrev-grid">
      <div class="d2c-rrev-card">
        <div class="d2c-rrev-stars">★★★★★</div>
        <p class="d2c-rrev-quote">"The weight of the pure gold zari drape, the deep crimson hue, and the intricate Vasli border work felt like stepping into an ancient Indian court painting. A masterpiece that will be passed to my daughter."</p>
        <div class="d2c-rrev-author">
          <span class="d2c-rrev-name">Maharani Divya Kumari</span>
          <span class="d2c-rrev-loc">Jaipur • Bespoke Bridal Atelier</span>
        </div>
      </div>

      <div class="d2c-rrev-card">
        <div class="d2c-rrev-stars">★★★★★</div>
        <p class="d2c-rrev-quote">"From the private London salon consultation to the handcrafted cedar trunk delivery, every single moment was pure royal poetry. The Shikargah weave is breathtaking."</p>
        <div class="d2c-rrev-author">
          <span class="d2c-rrev-name">Ayesha Singhania</span>
          <span class="d2c-rrev-loc">London • Varanasi Katan Saree</span>
        </div>
      </div>

      <div class="d2c-rrev-card">
        <div class="d2c-rrev-stars">★★★★★</div>
        <p class="d2c-rrev-quote">"The craftsmanship on the raw silk sherwani is incomparable. The antique silver buttons and mother-of-pearl detailing received endless compliments in Udaipur."</p>
        <div class="d2c-rrev-author">
          <span class="d2c-rrev-name">Suryaveer Rathore</span>
          <span class="d2c-rrev-loc">Udaipur • Marwar Royal Sherwani</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-rrev-{{ section.id }} {
    background: #180505;
    padding: 70px 32px;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rrev-container { max-width: 1360px; margin: 0 auto; }
  .d2c-rrev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .d2c-rrev-card {
    background: #230808;
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 8px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: center;
  }
  .d2c-rrev-stars { color: #d4af37; font-size: 16px; margin-bottom: 16px; letter-spacing: 2px; }
  .d2c-rrev-quote { font-size: 16px; color: #dfc59e; line-height: 1.7; font-style: italic; margin-bottom: 24px; }
  .d2c-rrev-name { font-size: 18px; font-weight: 700; color: #fff9eb; display: block; margin-bottom: 4px; }
  .d2c-rrev-loc { font-size: 12px; color: #d4af37; letter-spacing: 1px; }

  @media (max-width: 900px) { .d2c-rrev-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Royal Client Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HEIRLOOMS CHERISHED ACROSS GENERATIONS"
    }
  ],
  "presets": [
    {
      "name": "Royal Client Reviews"
    }
  ]
}
{% endschema %}
