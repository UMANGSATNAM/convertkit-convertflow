{% comment %}
  D2C Royal Heritage Certified Trust Seals
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-trust" id="d2c-rtrust-{{ section.id }}">
  <div class="d2c-rtrust-container">
    <div class="d2c-rtrust-grid">
      <div class="d2c-rtrust-item">
        <div class="d2c-rtrust-icon">🏛️</div>
        <h4 class="d2c-rtrust-title">SILK MARK CERTIFIED</h4>
        <p class="d2c-rtrust-desc">Government of India authenticated 100% natural pure mulberry silk.</p>
      </div>

      <div class="d2c-rtrust-item">
        <div class="d2c-rtrust-icon">👑</div>
        <h4 class="d2c-rtrust-title">22KT JARI VERIFICATION</h4>
        <p class="d2c-rtrust-desc">Independently certified bullion zari wire assay test certificate included.</p>
      </div>

      <div class="d2c-rtrust-item">
        <div class="d2c-rtrust-icon">📦</div>
        <h4 class="d2c-rtrust-title">INSURED GLOBAL ARMORED COURIER</h4>
        <p class="d2c-rtrust-desc">Doorstep tracked transit with 100% full value insurance guarantee.</p>
      </div>

      <div class="d2c-rtrust-item">
        <div class="d2c-rtrust-icon">✒️</div>
        <h4 class="d2c-rtrust-title">BESPOKE BRIDAL CONCIERGE</h4>
        <p class="d2c-rtrust-desc">Direct private line with our head bridal stylist and master masterji.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-rtrust-{{ section.id }} {
    background: #120303;
    padding: 50px 32px;
    border-top: 1px solid rgba(212, 175, 55, 0.25);
    border-bottom: 1px solid rgba(212, 175, 55, 0.25);
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rtrust-container { max-width: 1360px; margin: 0 auto; }
  .d2c-rtrust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    text-align: center;
  }
  .d2c-rtrust-item {
    background: #1a0505;
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 6px;
    padding: 28px 20px;
  }
  .d2c-rtrust-icon { font-size: 26px; margin-bottom: 12px; }
  .d2c-rtrust-title { font-size: 13px; font-weight: 700; color: #d4af37; letter-spacing: 1.5px; margin-bottom: 6px; text-transform: uppercase; }
  .d2c-rtrust-desc { font-size: 13px; color: #dfc59e; line-height: 1.5; font-style: italic; }

  @media (max-width: 900px) { .d2c-rtrust-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-rtrust-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Royal Trust Badges",
  "settings": [],
  "presets": [
    {
      "name": "Royal Trust Badges"
    }
  ]
}
{% endschema %}
