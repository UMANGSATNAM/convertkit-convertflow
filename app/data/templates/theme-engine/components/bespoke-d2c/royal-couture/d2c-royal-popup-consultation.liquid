{% comment %}
  D2C Royal Heritage Private Bridal Consultation Modal
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<div class="d2c-royal-popup" id="d2c-rpop-{{ section.id }}" style="display: none;">
  <div class="d2c-rpop-overlay">
    <div class="d2c-rpop-card">
      <button class="d2c-rpop-close" onclick="document.getElementById('d2c-rpop-{{ section.id }}').style.display='none';">&times;</button>
      <span class="d2c-r-badge">👑 PRIVATE ATELIER ACCESS</span>
      <h3 class="d2c-rpop-title">RESERVE A PRIVATE BRIDAL STYLIST</h3>
      <p class="d2c-rpop-desc">Enter your wedding date and preferred flagship salon for a curated bridal viewing suite.</p>

      <form class="d2c-rpop-form">
        <input type="text" placeholder="Bride / Groom Full Name" class="d2c-rpop-input" required />
        <input type="email" placeholder="Private Email Address" class="d2c-rpop-input" required />
        <input type="tel" placeholder="WhatsApp Number" class="d2c-rpop-input" required />
        <button type="submit" class="d2c-rpop-btn">REQUEST SALON SUITE RESERVATION &rarr;</button>
      </form>
    </div>
  </div>
</div>

<style>
  .d2c-rpop-overlay {
    position: fixed;
    inset: 0;
    background: rgba(10,2,2,0.9);
    backdrop-filter: blur(12px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rpop-card {
    background: #1e0707;
    border: 2px solid #d4af37;
    border-radius: 120px 120px 10px 10px;
    padding: 50px 36px;
    max-width: 480px;
    width: 100%;
    text-align: center;
    position: relative;
    box-shadow: 0 25px 50px -10px rgba(0,0,0,0.9);
  }
  .d2c-rpop-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    color: #dfc59e;
    font-size: 24px;
    cursor: pointer;
  }
  .d2c-rpop-title { font-size: 24px; font-weight: 700; color: #fff9eb; letter-spacing: 2px; margin: 10px 0 14px; }
  .d2c-rpop-desc { font-size: 15px; color: #dfc59e; font-style: italic; margin-bottom: 24px; }
  .d2c-rpop-form { display: flex; flex-direction: column; gap: 12px; }
  .d2c-rpop-input {
    background: #120303;
    border: 1px solid rgba(212, 175, 55, 0.4);
    padding: 14px 18px;
    color: #fff9eb;
    font-family: inherit;
    font-size: 15px;
    outline: none;
  }
  .d2c-rpop-input:focus { border-color: #d4af37; }
  .d2c-rpop-btn {
    background: #d4af37;
    color: #180505;
    border: none;
    padding: 16px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    margin-top: 8px;
  }
</style>

{% schema %}
{
  "name": "Royal Consultation Popup",
  "settings": [],
  "presets": [
    {
      "name": "Royal Consultation Popup"
    }
  ]
}
{% endschema %}
