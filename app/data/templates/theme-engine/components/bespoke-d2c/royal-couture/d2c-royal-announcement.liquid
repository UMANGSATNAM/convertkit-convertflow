{% comment %}
  D2C Royal Heritage Couture Announcement Bar
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<div class="d2c-royal-announcement" id="d2c-royal-announcement-{{ section.id }}">
  <div class="d2c-royal-announcement-inner">
    <span class="d2c-royal-crest">👑</span>
    <span class="d2c-royal-text">{{ section.settings.text | default: "THE ROYAL BRIDAL TROUSSEAU '26 // COMPLIMENTARY WORLDWIDE INSURED EXPRESS" }}</span>
    <span class="d2c-royal-crest">👑</span>
  </div>
</div>

<style>
  #d2c-royal-announcement-{{ section.id }} {
    background: #180505;
    color: #d4af37;
    border-bottom: 1px solid #d4af37;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 10px 16px;
    text-transform: uppercase;
    text-align: center;
  }
  .d2c-royal-announcement-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
  }
  .d2c-royal-crest { font-size: 14px; }
  @media (max-width: 768px) {
    #d2c-royal-announcement-{{ section.id }} { font-size: 11px; letter-spacing: 1px; padding: 8px 12px; }
  }
</style>

{% schema %}
{
  "name": "Royal Announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "THE ROYAL BRIDAL TROUSSEAU '26 // COMPLIMENTARY WORLDWIDE INSURED EXPRESS"
    }
  ],
  "presets": [
    {
      "name": "Royal Announcement"
    }
  ]
}
{% endschema %}
