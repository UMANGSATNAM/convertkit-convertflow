{% comment %}
  D2C Royal Heritage Imperial Footer
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<footer class="d2c-royal-footer" id="d2c-rfoot-{{ section.id }}">
  <div class="d2c-rfoot-container">
    <div class="d2c-rfoot-top">
      <div class="d2c-rfoot-brand">
        <h3 class="d2c-rfoot-logo">{{ section.settings.brand_name | default: "SABYASACHI & CO." }}</h3>
        <p class="d2c-rfoot-para">An Indian luxury heritage atelier dedicated to the preservation of ancient handloom weaving, gold bullion embroidery, and royal bridal couture.</p>
        <div class="d2c-rfoot-salons">
          <div>FLAGSHIPS: CALCUTTA • MUMBAI • NEW DELHI • LONDON • NEW YORK</div>
        </div>
      </div>

      <div class="d2c-rfoot-col">
        <h4 class="d2c-rcol-title">THE ATELIER</h4>
        <ul class="d2c-rcol-links">
          <li><a href="/collections/bridal-lehengas">Bridal Lehengas</a></li>
          <li><a href="/collections/handloom-sarees">Varanasi Katan Sarees</a></li>
          <li><a href="/collections/sherwanis">Heritage Sherwanis</a></li>
          <li><a href="/collections/dupattas">Zardozi Veils</a></li>
          <li><a href="/pages/appointments">Book Salon Trial</a></li>
        </ul>
      </div>

      <div class="d2c-rfoot-col">
        <h4 class="d2c-rcol-title">PATRON CARE</h4>
        <ul class="d2c-rcol-links">
          <li><a href="/pages/trousseau-care">Handloom Textile Preservation</a></li>
          <li><a href="/pages/bespoke-fittings">International Fitting Protocol</a></li>
          <li><a href="/pages/certificate">Silk Mark & Zari Verification</a></li>
          <li><a href="/pages/faq">Atelier FAQs</a></li>
          <li><a href="/pages/contact">Concierge WhatsApp</a></li>
        </ul>
      </div>

      <div class="d2c-rfoot-col">
        <h4 class="d2c-rcol-title">AUTHENTICITY ASSURED</h4>
        <p class="d2c-rfoot-auth-text">Every single bridal ensemble includes a signed certificate of origin, Silk Mark authentication, and master weaver lineage register.</p>
      </div>
    </div>

    <div class="d2c-rfoot-bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: "SABYASACHI COUTURE PVT. LTD." }}. ALL RIGHTS RESERVED.</div>
      <div class="d2c-rfoot-legal">
        <a href="/policies/privacy-policy">PRIVACY DISCLOSURE</a>
        <a href="/policies/terms-of-service">TERMS OF PATRONAGE</a>
        <a href="/policies/shipping-policy">INSURED TRANSIT POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  #d2c-rfoot-{{ section.id }} {
    background: #0d0202;
    border-top: 1px solid rgba(212, 175, 55, 0.4);
    padding: 70px 32px 30px;
    color: #dfc59e;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rfoot-container { max-width: 1360px; margin: 0 auto; }
  .d2c-rfoot-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 48px;
    margin-bottom: 50px;
  }
  .d2c-rfoot-logo { font-size: 22px; font-weight: 700; color: #d4af37; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 14px; }
  .d2c-rfoot-para { font-size: 14px; color: #dfc59e; line-height: 1.6; font-style: italic; margin-bottom: 20px; max-width: 340px; }
  .d2c-rfoot-salons { font-size: 11px; font-weight: 700; color: #d4af37; letter-spacing: 1.5px; }
  .d2c-rcol-title { font-size: 13px; font-weight: 700; color: #fff9eb; letter-spacing: 2px; margin-bottom: 18px; text-transform: uppercase; }
  .d2c-rcol-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .d2c-rcol-links a { color: #dfc59e; text-decoration: none; font-size: 14px; font-style: italic; transition: color 0.2s ease; }
  .d2c-rcol-links a:hover { color: #d4af37; }
  .d2c-rfoot-auth-text { font-size: 13px; color: #dfc59e; line-height: 1.6; font-style: italic; }
  .d2c-rfoot-bottom {
    border-top: 1px solid rgba(212, 175, 55, 0.2);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    letter-spacing: 1px;
  }
  .d2c-rfoot-legal { display: flex; gap: 24px; }
  .d2c-rfoot-legal a { color: inherit; text-decoration: none; }
  .d2c-rfoot-legal a:hover { color: #d4af37; }

  @media (max-width: 1024px) { .d2c-rfoot-top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) {
    .d2c-rfoot-top { grid-template-columns: 1fr; }
    .d2c-rfoot-bottom { flex-direction: column; gap: 14px; text-align: center; }
  }
</style>

{% schema %}
{
  "name": "Royal Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "SABYASACHI & CO."
    }
  ],
  "presets": [
    {
      "name": "Royal Footer"
    }
  ]
}
{% endschema %}
