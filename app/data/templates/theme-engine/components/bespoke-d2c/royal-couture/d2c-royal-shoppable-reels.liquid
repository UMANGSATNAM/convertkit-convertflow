{% comment %}
  D2C Royal Heritage Bridal UGC Reels
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-reels" id="d2c-rreels-{{ section.id }}">
  <div class="d2c-rreels-container">
    <div class="d2c-royal-sec-header">
      <span class="d2c-r-badge">CINEMATIC ARCHIVES</span>
      <h2 class="d2c-r-title">{{ section.settings.title | default: "ROYAL WEDDINGS IN MOTION" }}</h2>
    </div>

    <div class="d2c-rreels-grid">
      <div class="d2c-rreel-card">
        <img src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=600&q=80" alt="Palace Wedding Reel" />
        <div class="d2c-rreel-overlay">
          <span class="d2c-rreel-tag">UDAIPUR PALACE WEDDING</span>
          <h4 class="d2c-rreel-bride">Radhika & Dev</h4>
          <span class="d2c-rreel-piece">Crimson Velvet Lehenga</span>
        </div>
      </div>

      <div class="d2c-rreel-card">
        <img src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?w=600&q=80" alt="Heirloom Saree Reel" />
        <div class="d2c-rreel-overlay">
          <span class="d2c-rreel-tag">JAIPUR HAVELI CELEBRATION</span>
          <h4 class="d2c-rreel-bride">Ananya & Siddharth</h4>
          <span class="d2c-rreel-piece">Varanasi Katan Saree</span>
        </div>
      </div>

      <div class="d2c-rreel-card">
        <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=600&q=80" alt="Royal Groom Reel" />
        <div class="d2c-rreel-overlay">
          <span class="d2c-rreel-tag">HYDERABAD NIKAH</span>
          <h4 class="d2c-rreel-bride">Zoya & Farhan</h4>
          <span class="d2c-rreel-piece">Raw Silk Sherwani</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-rreels-{{ section.id }} {
    background: #180505;
    padding: 70px 32px;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rreels-container { max-width: 1360px; margin: 0 auto; }
  .d2c-rreels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .d2c-rreel-card {
    position: relative;
    aspect-ratio: 9/16;
    border-radius: 140px 140px 8px 8px;
    overflow: hidden;
    border: 1px solid #d4af37;
    cursor: pointer;
  }
  .d2c-rreel-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .d2c-rreel-card:hover img { transform: scale(1.05); }
  .d2c-rreel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(24,5,5,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 32px 24px;
    color: #fff9eb;
    text-align: center;
  }
  .d2c-rreel-tag { font-size: 11px; font-weight: 700; color: #d4af37; letter-spacing: 2px; margin-bottom: 6px; }
  .d2c-rreel-bride { font-size: 24px; font-weight: 700; margin-bottom: 4px; }
  .d2c-rreel-piece { font-size: 13px; color: #dfc59e; font-style: italic; }

  @media (max-width: 900px) { .d2c-rreels-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Royal Wedding Reels",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ROYAL WEDDINGS IN MOTION"
    }
  ],
  "presets": [
    {
      "name": "Royal Wedding Reels"
    }
  ]
}
{% endschema %}
