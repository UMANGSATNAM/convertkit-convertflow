{% comment %}
  D2C Royal Heritage Palace Lookbook
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-lookbook" id="d2c-rlb-{{ section.id }}">
  <div class="d2c-rlb-container">
    <div class="d2c-royal-sec-header">
      <span class="d2c-r-badge">PALACE EDITORIAL</span>
      <h2 class="d2c-r-title">{{ section.settings.title | default: "THE RAJPUTANA BRIDAL CHRONICLES" }}</h2>
    </div>

    <div class="d2c-rlb-grid">
      <div class="d2c-rlb-card large">
        <img src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=900&q=80" alt="Palace Bride" />
        <div class="d2c-rlb-overlay">
          <span class="d2c-rlb-num">LOOK 01</span>
          <h3 class="d2c-rlb-title">IMPERIAL CRIMSON VELVET</h3>
          <span class="d2c-rlb-link">VIEW EDITORIAL ARCHIVE &rarr;</span>
        </div>
      </div>

      <div class="d2c-rlb-card">
        <img src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?w=700&q=80" alt="Handloom Saree" />
        <div class="d2c-rlb-overlay">
          <span class="d2c-rlb-num">LOOK 02</span>
          <h3 class="d2c-rlb-title">JANGAL KATAN DRAPE</h3>
          <span class="d2c-rlb-link">VIEW &rarr;</span>
        </div>
      </div>

      <div class="d2c-rlb-card">
        <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=700&q=80" alt="Royal Groom" />
        <div class="d2c-rlb-overlay">
          <span class="d2c-rlb-num">LOOK 03</span>
          <h3 class="d2c-rlb-title">MARWAR TASSAR ENSEMBLE</h3>
          <span class="d2c-rlb-link">VIEW &rarr;</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-rlb-{{ section.id }} {
    background: #180505;
    padding: 70px 32px;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rlb-container { max-width: 1360px; margin: 0 auto; }
  .d2c-rlb-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 24px;
  }
  .d2c-rlb-card {
    position: relative;
    height: 500px;
    border-radius: 120px 120px 8px 8px;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.4);
  }
  .d2c-rlb-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .d2c-rlb-card:hover img { transform: scale(1.06); }
  .d2c-rlb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(24,5,5,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 32px 24px;
    color: #fff9eb;
    text-align: center;
  }
  .d2c-rlb-num { font-size: 11px; font-weight: 700; color: #d4af37; letter-spacing: 2px; margin-bottom: 6px; }
  .d2c-rlb-title { font-size: 22px; font-weight: 700; letter-spacing: 1px; margin-bottom: 8px; }
  .d2c-rlb-link { font-size: 11px; font-weight: 700; color: #dfc59e; letter-spacing: 1.5px; }

  @media (max-width: 900px) {
    .d2c-rlb-grid { grid-template-columns: 1fr; }
    .d2c-rlb-card { height: 380px; }
  }
</style>

{% schema %}
{
  "name": "Royal Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE RAJPUTANA BRIDAL CHRONICLES"
    }
  ],
  "presets": [
    {
      "name": "Royal Lookbook"
    }
  ]
}
{% endschema %}
