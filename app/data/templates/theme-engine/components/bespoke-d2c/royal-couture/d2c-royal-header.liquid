{% comment %}
  D2C Royal Heritage Couture Header
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<header class="d2c-royal-header" id="d2c-royal-header-{{ section.id }}">
  <div class="d2c-royal-header-container">
    <div class="d2c-royal-nav-left">
      <a href="/collections/bridal" class="d2c-royal-link">BRIDAL</a>
      <a href="/collections/handloom-sarees" class="d2c-royal-link">SAREES</a>
      <a href="/collections/sherwanis" class="d2c-royal-link">MENSWEAR</a>
    </div>

    <div class="d2c-royal-logo-box">
      <a href="/" class="d2c-royal-brand-name">
        <span class="d2c-royal-title">{{ section.settings.brand_name | default: "SABYASACHI & CO." }}</span>
        <span class="d2c-royal-sub-monogram">CALCUTTA • LONDON • NEW YORK</span>
      </a>
    </div>

    <div class="d2c-royal-nav-right">
      <a href="/pages/appointments" class="d2c-royal-link highlight">BOOK BRIDAL SALON</a>
      <a href="/cart" class="d2c-royal-link">BAG ({{ cart.item_count | default: 0 }})</a>
    </div>
  </div>
</header>

<style>
  #d2c-royal-header-{{ section.id }} {
    background: #180505;
    border-bottom: 1px solid rgba(212, 175, 55, 0.3);
    padding: 20px 32px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  .d2c-royal-header-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .d2c-royal-nav-left { display: flex; gap: 32px; }
  .d2c-royal-nav-right { display: flex; gap: 32px; justify-content: flex-end; align-items: center; }
  .d2c-royal-link {
    color: #dfc59e;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }
  .d2c-royal-link:hover { color: #d4af37; }
  .d2c-royal-link.highlight {
    color: #d4af37;
    border: 1px solid #d4af37;
    padding: 6px 14px;
    font-size: 12px;
  }
  .d2c-royal-brand-name {
    text-align: center;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .d2c-royal-title {
    font-size: 26px;
    font-weight: 700;
    color: #d4af37;
    letter-spacing: 3px;
    text-transform: uppercase;
  }
  .d2c-royal-sub-monogram {
    font-size: 9px;
    color: #dfc59e;
    letter-spacing: 3px;
    margin-top: 2px;
  }

  @media (max-width: 900px) {
    .d2c-royal-nav-left { display: none; }
    .d2c-royal-header-container { display: flex; justify-content: space-between; }
    .d2c-royal-title { font-size: 18px; }
    #d2c-royal-header-{{ section.id }} { padding: 14px 18px; }
  }
</style>

{% schema %}
{
  "name": "Royal Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "SABYASACHI & CO."
    }
  ],
  "presets": [
    {
      "name": "Royal Header"
    }
  ]
}
{% endschema %}
