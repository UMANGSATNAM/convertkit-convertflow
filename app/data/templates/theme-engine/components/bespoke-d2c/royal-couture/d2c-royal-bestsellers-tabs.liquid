{% comment %}
  D2C Royal Heritage Bridal Bestsellers
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-bestsellers" id="d2c-rbest-{{ section.id }}">
  <div class="d2c-rbest-container">
    <div class="d2c-royal-sec-header">
      <span class="d2c-r-badge">THE ARCHIVES</span>
      <h2 class="d2c-r-title">{{ section.settings.title | default: "ICONIC BRIDAL MASTERPIECES" }}</h2>
    </div>

    <div class="d2c-r-grid">
      <!-- Item 1 -->
      <div class="d2c-r-card">
        <div class="d2c-r-thumb">
          <span class="d2c-r-tag">1-OF-1 ATELIER</span>
          <img src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=600&q=80" alt="Mughal Crimson Zardozi Lehenga" />
        </div>
        <div class="d2c-r-details">
          <div class="d2c-r-craft">HAND-BEATEN GOLD BULLION • 1,400 HOURS</div>
          <h3 class="d2c-r-prod-title">Mughal Crimson Zardozi Lehenga</h3>
          <div class="d2c-r-price">₹4,85,000</div>
          <a href="/pages/appointments" class="d2c-r-btn">RESERVE PRIVATE SALON TRIAL</a>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="d2c-r-card">
        <div class="d2c-r-thumb">
          <span class="d2c-r-tag">HEIRLOOM WEAVE</span>
          <img src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?w=600&q=80" alt="Varanasi Shikargah Katan Saree" />
        </div>
        <div class="d2c-r-details">
          <div class="d2c-r-craft">REAL SILVER JARI • JANGAL WEAVE</div>
          <h3 class="d2c-r-prod-title">Varanasi Shikargah Katan Saree</h3>
          <div class="d2c-r-price">₹1,95,000</div>
          <a href="/pages/appointments" class="d2c-r-btn">RESERVE PRIVATE SALON TRIAL</a>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="d2c-r-card">
        <div class="d2c-r-thumb">
          <span class="d2c-r-tag">ROYAL MENSWEAR</span>
          <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=600&q=80" alt="Raw Silk Marwar Sherwani" />
        </div>
        <div class="d2c-r-details">
          <div class="d2c-r-craft">HANDWOVEN TASSAR SILK • MOTHER OF PEARL</div>
          <h3 class="d2c-r-prod-title">Raw Silk Marwar Sherwani</h3>
          <div class="d2c-r-price">₹2,40,000</div>
          <a href="/pages/appointments" class="d2c-r-btn">RESERVE PRIVATE SALON TRIAL</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-rbest-{{ section.id }} {
    background: #180505;
    padding: 70px 32px;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rbest-container { max-width: 1360px; margin: 0 auto; }
  .d2c-r-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .d2c-r-card {
    background: #230808;
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-align: center;
  }
  .d2c-r-thumb { position: relative; height: 420px; overflow: hidden; }
  .d2c-r-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-r-tag {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(24,5,5,0.85);
    border: 1px solid #d4af37;
    color: #d4af37;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 4px 10px;
  }
  .d2c-r-details { padding: 28px 20px; display: flex; flex-direction: column; justify-content: space-between; flex-grow: 1; }
  .d2c-r-craft { font-size: 11px; font-weight: 700; color: #d4af37; letter-spacing: 2px; margin-bottom: 8px; }
  .d2c-r-prod-title { font-size: 22px; font-weight: 700; color: #fff9eb; margin-bottom: 12px; }
  .d2c-r-price { font-size: 20px; font-weight: 700; color: #d4af37; margin-bottom: 20px; }
  .d2c-r-btn {
    background: transparent;
    border: 1px solid #d4af37;
    color: #d4af37;
    padding: 14px 20px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .d2c-r-btn:hover { background: #d4af37; color: #180505; }

  @media (max-width: 900px) { .d2c-r-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Royal Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ICONIC BRIDAL MASTERPIECES"
    }
  ],
  "presets": [
    {
      "name": "Royal Bestsellers"
    }
  ]
}
{% endschema %}
