{% comment %}
  D2C Royal Heritage Craft & Zari Purity Matrix
  Theme: Sabyasachi / Raw Mango Royal Couture
{% endcomment %}

<section class="d2c-royal-purity" id="d2c-rpurity-{{ section.id }}">
  <div class="d2c-rpurity-container">
    <div class="d2c-royal-sec-header">
      <span class="d2c-r-badge">HERITAGE STANDARDS</span>
      <h2 class="d2c-r-title">{{ section.settings.title | default: "HEIRLOOM PURITY & WEAVE BENCHMARKS" }}</h2>
    </div>

    <div class="d2c-rpurity-grid">
      <div class="d2c-rpurity-card">
        <div class="d2c-rpurity-val">22KT</div>
        <div class="d2c-rpurity-label">GENUINE GOLD ZARI</div>
        <p class="d2c-rpurity-desc">Drawn from solid silver wire electroplated with 24kt gold, hand-beaten by hereditary zari craftsmen.</p>
      </div>

      <div class="d2c-rpurity-card">
        <div class="d2c-rpurity-val">100%</div>
        <div class="d2c-rpurity-label">PURE KATAN SILK</div>
        <p class="d2c-rpurity-desc">Woven on traditional wooden pit looms with hand-twisted mulberry silk threads for generational durability.</p>
      </div>

      <div class="d2c-rpurity-card">
        <div class="d2c-rpurity-val">1,800+</div>
        <div class="d2c-rpurity-label">HOURS OF NEEDLEWORK</div>
        <p class="d2c-rpurity-desc">Each bridal ensemble undergoes meticulous single-needle zardozi stitching over 4-6 months.</p>
      </div>

      <div class="d2c-rpurity-card">
        <div class="d2c-rpurity-val">100 YRS</div>
        <div class="d2c-rpurity-label">HEIRLOOM GUARANTEE</div>
        <p class="d2c-rpurity-desc">Crafted with pure natural dyestuffs and corrosion-resistant alloys meant to be passed down across generations.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-rpurity-{{ section.id }} {
    background: #120303;
    padding: 70px 32px;
    border-top: 1px solid rgba(212, 175, 55, 0.3);
    border-bottom: 1px solid rgba(212, 175, 55, 0.3);
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .d2c-rpurity-container { max-width: 1360px; margin: 0 auto; }
  .d2c-rpurity-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-rpurity-card {
    background: #1e0707;
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 8px;
    padding: 36px 24px;
    text-align: center;
  }
  .d2c-rpurity-val { font-size: 38px; font-weight: 700; color: #d4af37; margin-bottom: 6px; }
  .d2c-rpurity-label { font-size: 12px; font-weight: 700; color: #fff9eb; letter-spacing: 2px; margin-bottom: 14px; }
  .d2c-rpurity-desc { font-size: 14px; color: #dfc59e; line-height: 1.6; font-style: italic; }

  @media (max-width: 900px) { .d2c-rpurity-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-rpurity-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Royal Purity Matrix",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HEIRLOOM PURITY & WEAVE BENCHMARKS"
    }
  ],
  "presets": [
    {
      "name": "Royal Purity Matrix"
    }
  ]
}
{% endschema %}
