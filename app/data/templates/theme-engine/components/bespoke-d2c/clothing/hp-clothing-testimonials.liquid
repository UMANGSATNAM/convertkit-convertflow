{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#09090b' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 60 }}px 16px {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .hp-clothing-rev {
    max-width: 1360px;
    margin: 0 auto;
  }

  .hp-clothing-rev__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .hp-clothing-rev__title {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
  }

  .hp-clothing-rev__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 900px) {
    .hp-clothing-rev__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp-clothing-rev-card {
    background: #18181b;
    border-radius: 16px;
    padding: 32px;
    border: 1px solid rgba(255,255,255,0.08);
  }

  .hp-clothing-rev-card__stars {
    color: {{ section.settings.accent_color | default: '#ff5500' }};
    font-size: 18px;
    margin-bottom: 16px;
  }

  .hp-clothing-rev-card__quote {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255,255,255,0.85);
    margin-bottom: 24px;
  }

  .hp-clothing-rev-card__author {
    font-size: 15px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .hp-clothing-rev-card__verified {
    font-size: 12px;
    color: {{ section.settings.accent_color | default: '#ff5500' }};
    font-weight: 700;
  }
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}">
  <div class="hp-clothing-rev">
    <div class="hp-clothing-rev__header">
      <h2 class="hp-clothing-rev__title">VERIFIED FIT & QUALITY REVIEWS</h2>
    </div>

    <div class="hp-clothing-rev__grid">
      <div class="hp-clothing-rev-card">
        <div class="hp-clothing-rev-card__stars">★★★★★</div>
        <div class="hp-clothing-rev-card__quote">"The weight of this hoodie is unbelievable. 450GSM loopback cotton holds its shape perfectly. Worth every dollar."</div>
        <div class="hp-clothing-rev-card__author">Marcus K.</div>
        <div class="hp-clothing-rev-card__verified">✓ VERIFIED BUYER • Size L</div>
      </div>

      <div class="hp-clothing-rev-card">
        <div class="hp-clothing-rev-card__stars">★★★★★</div>
        <div class="hp-clothing-rev-card__quote">"Best oversized tee I own. The collar doesn't stretch out after washing and the puff print detail is immaculate."</div>
        <div class="hp-clothing-rev-card__author">David L.</div>
        <div class="hp-clothing-rev-card__verified">✓ VERIFIED BUYER • Size M</div>
      </div>

      <div class="hp-clothing-rev-card">
        <div class="hp-clothing-rev-card__stars">★★★★★</div>
        <div class="hp-clothing-rev-card__quote">"Finally a brand that gets tactical cargo pants right. Adjustable ankle cuffs allow perfect sneaker pairing."</div>
        <div class="hp-clothing-rev-card__author">Alex R.</div>
        <div class="hp-clothing-rev-card__verified">✓ VERIFIED BUYER • Size 32</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clothing Reviews",
  "tag": "section",
  "class": "section-clothing-reviews",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#09090b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff5500"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Clothing Reviews"
    }
  ]
}
{% endschema %}
