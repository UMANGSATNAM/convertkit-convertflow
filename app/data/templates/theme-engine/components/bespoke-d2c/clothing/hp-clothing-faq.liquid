{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#09090b' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 60 }}px 16px {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .hp-clothing-faq {
    max-width: 900px;
    margin: 0 auto;
  }

  .hp-clothing-faq__title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 900;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 40px;
  }

  .hp-clothing-faq__item {
    background: #18181b;
    border-radius: 12px;
    margin-bottom: 16px;
    border: 1px solid rgba(255,255,255,0.08);
    overflow: hidden;
  }

  .hp-clothing-faq__question {
    padding: 20px 24px;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-transform: uppercase;
  }

  .hp-clothing-faq__answer {
    padding: 0 24px 20px;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255,255,255,0.7);
  }
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}">
  <div class="hp-clothing-faq">
    <h2 class="hp-clothing-faq__title">FREQUENTLY ASKED QUESTIONS</h2>

    <div class="hp-clothing-faq__item">
      <div class="hp-clothing-faq__question">How do your sizes fit? <span>+</span></div>
      <div class="hp-clothing-faq__answer"><p>All our garments feature an intentional oversized streetwear drop-shoulder fit. If you prefer a regular tailored fit, we recommend sizing down one size.</p></div>
    </div>

    <div class="hp-clothing-faq__item">
      <div class="hp-clothing-faq__question">What are the washing instructions? <span>+</span></div>
      <div class="hp-clothing-faq__answer"><p>Wash inside out on cold cycle with like colors. Hang dry recommended to preserve 450GSM fabric structure and puff print integrity.</p></div>
    </div>

    <div class="hp-clothing-faq__item">
      <div class="hp-clothing-faq__question">How fast is shipping? <span>+</span></div>
      <div class="hp-clothing-faq__answer"><p>Orders are processed within 24 hours. Express shipping delivers within 3-5 business days with full end-to-end tracking.</p></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clothing FAQ Accordion",
  "tag": "section",
  "class": "section-clothing-faq",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#09090b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff5500"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Clothing FAQ Accordion"
    }
  ]
}
{% endschema %}
