{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#09090b' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 60 }}px 16px {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .hp-clothing-news {
    max-width: 900px;
    margin: 0 auto;
    background: linear-gradient(135deg, #18181b 0%, #09090b 100%);
    border-radius: 24px;
    padding: 60px 32px;
    text-align: center;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .hp-clothing-news__badge {
    display: inline-block;
    color: {{ section.settings.accent_color | default: '#ff5500' }};
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .hp-clothing-news__title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .hp-clothing-news__text {
    font-size: 16px;
    color: rgba(255,255,255,0.7);
    max-width: 540px;
    margin: 0 auto 32px;
    line-height: 1.6;
  }

  .hp-clothing-news__form {
    display: flex;
    gap: 12px;
    max-width: 480px;
    margin: 0 auto;
  }

  @media (max-width: 500px) {
    .hp-clothing-news__form {
      flex-direction: column;
    }
  }

  .hp-clothing-news__input {
    flex-grow: 1;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 8px;
    padding: 16px 20px;
    color: #ffffff;
    font-size: 15px;
    outline: none;
  }

  .hp-clothing-news__input:focus {
    border-color: {{ section.settings.accent_color | default: '#ff5500' }};
  }

  .hp-clothing-news__btn {
    background: {{ section.settings.accent_color | default: '#ff5500' }};
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 16px 28px;
    font-weight: 900;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
  }
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}">
  <div class="hp-clothing-news">
    <div class="hp-clothing-news__badge">⚡ EARLY DROP PASS</div>
    <h2 class="hp-clothing-news__title">NEVER MISS A LIMITED RELEASE</h2>
    <p class="hp-clothing-news__text">Subscribe for priority early access pass to limited quantity streetwear drops, secret pop-ups, and subscriber discounts.</p>
    
    <form class="hp-clothing-news__form" onsubmit="event.preventDefault(); alert('VIP Drop Pass Unlocked!');">
      <input type="email" class="hp-clothing-news__input" placeholder="Enter your email..." required>
      <button type="submit" class="hp-clothing-news__btn">GET DROP PASS</button>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "Clothing VIP Newsletter",
  "tag": "section",
  "class": "section-clothing-newsletter",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#09090b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff5500"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Clothing VIP Newsletter"
    }
  ]
}
{% endschema %}
