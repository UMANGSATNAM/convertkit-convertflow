{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#09090b' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 60 }}px 16px {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .hp-clothing-specs {
    max-width: 1360px;
    margin: 0 auto;
    background: #18181b;
    border-radius: 20px;
    padding: 60px 40px;
    border: 1px solid rgba(255,255,255,0.08);
  }

  .hp-clothing-specs__header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px;
  }

  .hp-clothing-specs__sub {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    color: {{ section.settings.accent_color | default: '#ff5500' }};
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .hp-clothing-specs__title {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .hp-clothing-specs__desc {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255,255,255,0.7);
    margin: 0;
  }

  .hp-clothing-specs__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }

  @media (max-width: 1024px) {
    .hp-clothing-specs__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hp-clothing-specs__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp-clothing-spec-card {
    background: rgba(9, 9, 11, 0.6);
    padding: 32px 24px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.06);
    text-align: center;
  }

  .hp-clothing-spec-card__val {
    font-size: 42px;
    font-weight: 900;
    color: {{ section.settings.accent_color | default: '#ff5500' }};
    line-height: 1;
    margin-bottom: 8px;
  }

  .hp-clothing-spec-card__label {
    font-size: 15px;
    font-weight: 800;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .hp-clothing-spec-card__text {
    font-size: 13px;
    color: rgba(255,255,255,0.6);
    line-height: 1.5;
  }
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}">
  <div class="hp-clothing-specs">
    <div class="hp-clothing-specs__header">
      <div class="hp-clothing-specs__sub">FABRIC ARCHITECTURE</div>
      <h2 class="hp-clothing-specs__title">ENGINEERED FOR HEAVYWEIGHT LONGEVITY</h2>
      <p class="hp-clothing-specs__desc">We don't compromise on fabric weight. Every garment undergoes custom milling and pre-shrunk wash treatments to ensure structure that lasts years.</p>
    </div>

    <div class="hp-clothing-specs__grid">
      <div class="hp-clothing-spec-card">
        <div class="hp-clothing-spec-card__val">450 GSM</div>
        <div class="hp-clothing-spec-card__label">Heavyweight Fleece</div>
        <div class="hp-clothing-spec-card__text">Ultra-dense 100% loopback cotton milled specifically for structured hoodies.</div>
      </div>

      <div class="hp-clothing-spec-card">
        <div class="hp-clothing-spec-card__val">0% SHRINK</div>
        <div class="hp-clothing-spec-card__label">Pre-Shrunk Wash</div>
        <div class="hp-clothing-spec-card__text">Garment dyed & pre-washed to lock in exact fit straight out of the box.</div>
      </div>

      <div class="hp-clothing-spec-card">
        <div class="hp-clothing-spec-card__val">DOUBLE</div>
        <div class="hp-clothing-spec-card__label">Needle Stitching</div>
        <div class="hp-clothing-spec-card__text">Reinforced seams across shoulders, collar, and hem for zero distortion.</div>
      </div>

      <div class="hp-clothing-spec-card">
        <div class="hp-clothing-spec-card__val">100%</div>
        <div class="hp-clothing-spec-card__label">Combed Organic</div>
        <div class="hp-clothing-spec-card__text">Sustainably sourced GOTS certified organic cotton for smooth handfeel.</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clothing Fabric Specs",
  "tag": "section",
  "class": "section-clothing-specs",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#09090b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff5500"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Clothing Fabric Specs"
    }
  ]
}
{% endschema %}
