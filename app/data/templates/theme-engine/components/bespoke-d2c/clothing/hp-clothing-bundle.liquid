{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#09090b' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 60 }}px 16px {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .hp-clothing-bundle {
    max-width: 1200px;
    margin: 0 auto;
    background: #18181b;
    border-radius: 20px;
    padding: 40px;
    border: 1px solid rgba(255,255,255,0.08);
  }

  .hp-clothing-bundle__header {
    text-align: center;
    margin-bottom: 36px;
  }

  .hp-clothing-bundle__badge {
    display: inline-block;
    background: {{ section.settings.accent_color | default: '#ff5500' }};
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 99px;
    margin-bottom: 12px;
  }

  .hp-clothing-bundle__title {
    font-size: clamp(26px, 3.5vw, 40px);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
  }

  .hp-clothing-bundle__content {
    display: grid;
    grid-template-columns: 1fr 1fr auto 1fr 1fr;
    align-items: center;
    gap: 20px;
  }

  @media (max-width: 900px) {
    .hp-clothing-bundle__content {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }

  .hp-clothing-bundle__plus {
    font-size: 28px;
    font-weight: 900;
    color: {{ section.settings.accent_color | default: '#ff5500' }};
    text-align: center;
  }

  .hp-clothing-bundle__item {
    background: #09090b;
    border-radius: 12px;
    padding: 16px;
    border: 1px solid rgba(255,255,255,0.08);
  }

  .hp-clothing-bundle__img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 12px;
  }

  .hp-clothing-bundle__name {
    font-size: 15px;
    font-weight: 800;
    margin: 0 0 6px;
    color: #ffffff;
  }

  .hp-clothing-bundle__price {
    font-size: 16px;
    font-weight: 900;
    color: {{ section.settings.accent_color | default: '#ff5500' }};
  }

  .hp-clothing-bundle__action {
    grid-column: span 5;
    margin-top: 30px;
    text-align: center;
    background: rgba(9, 9, 11, 0.8);
    padding: 24px;
    border-radius: 12px;
  }

  @media (max-width: 900px) {
    .hp-clothing-bundle__action {
      grid-column: span 1;
    }
  }

  .hp-clothing-bundle__total {
    font-size: 24px;
    font-weight: 900;
    margin-bottom: 16px;
  }

  .hp-clothing-bundle__total span {
    color: {{ section.settings.accent_color | default: '#ff5500' }};
  }
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}">
  <div class="hp-clothing-bundle">
    <div class="hp-clothing-bundle__header">
      <div class="hp-clothing-bundle__badge">🔥 BUNDLE & SAVE 15%</div>
      <h2 class="hp-clothing-bundle__title">THE ESSENTIAL STREETWEAR UNIFORM</h2>
    </div>

    <div class="hp-clothing-bundle__content">
      <div class="hp-clothing-bundle__item">
        <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=500&q=80" alt="Acid Wash Hoodie" class="hp-clothing-bundle__img" loading="lazy">
        <h4 class="hp-clothing-bundle__name">Acid Wash 450GSM Hoodie</h4>
        <div class="hp-clothing-bundle__price">$98.00</div>
      </div>

      <div class="hp-clothing-bundle__plus">+</div>

      <div class="hp-clothing-bundle__item">
        <img src="https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?w=500&q=80" alt="Tactical Cargo Pants" class="hp-clothing-bundle__img" loading="lazy">
        <h4 class="hp-clothing-bundle__name">Tactical 8-Pocket Cargo</h4>
        <div class="hp-clothing-bundle__price">$110.00</div>
      </div>

      <div class="hp-clothing-bundle__action">
        <div class="hp-clothing-bundle__total">
          BUNDLE TOTAL: <span>$176.80</span> <s style="opacity:0.5; font-size:18px;">$208.00</s>
        </div>
        <a href="/cart/add" class="hp-clothing-btn-primary">ADD BUNDLE TO CART (SAVE $31.20)</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clothing Bundle Builder",
  "tag": "section",
  "class": "section-clothing-bundle",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#09090b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff5500"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Clothing Bundle Builder"
    }
  ]
}
{% endschema %}
