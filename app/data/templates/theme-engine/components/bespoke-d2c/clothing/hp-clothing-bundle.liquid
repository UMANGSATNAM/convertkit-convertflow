{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#09090b' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 60 }}px 16px {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .hp-clothing-bundle {
    max-width: 1200px;
    margin: 0 auto;
    background: #18181b;
    border-radius: 20px;
    padding: 40px;
    border: 1px solid rgba(255,255,255,0.08);
  }

  .hp-clothing-bundle__header {
    text-align: center;
    margin-bottom: 36px;
  }

  .hp-clothing-bundle__badge {
    display: inline-block;
    background: {{ section.settings.accent_color | default: '#ff5500' }};
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 99px;
    margin-bottom: 12px;
  }

  .hp-clothing-bundle__title {
    font-size: clamp(26px, 3.5vw, 40px);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
  }

  .hp-clothing-bundle__content {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }

  @media (max-width: 768px) {
    .hp-clothing-bundle__content {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }

  .hp-clothing-bundle__plus {
    font-size: 32px;
    font-weight: 900;
    color: {{ section.settings.accent_color | default: '#ff5500' }};
    text-align: center;
  }

  .hp-clothing-bundle__item {
    background: #09090b;
    border-radius: 12px;
    padding: 20px;
    border: 1px solid rgba(255,255,255,0.08);
    display: flex;
    flex-direction: column;
  }

  .hp-clothing-bundle__img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 16px;
  }

  .hp-clothing-bundle__name {
    font-size: 16px;
    font-weight: 800;
    margin: 0 0 6px;
    color: #ffffff;
  }

  .hp-clothing-bundle__price {
    font-size: 18px;
    font-weight: 900;
    color: {{ section.settings.accent_color | default: '#ff5500' }};
    margin-bottom: 12px;
  }

  .hp-clothing-bundle__select {
    width: 100%;
    background: #18181b;
    border: 1px solid rgba(255,255,255,0.2);
    color: #ffffff;
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    outline: none;
  }

  .hp-clothing-bundle__action {
    margin-top: 32px;
    text-align: center;
    background: rgba(9, 9, 11, 0.8);
    padding: 28px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.06);
  }

  .hp-clothing-bundle__total {
    font-size: 24px;
    font-weight: 900;
    margin-bottom: 16px;
  }

  .hp-clothing-bundle__total span {
    color: {{ section.settings.accent_color | default: '#ff5500' }};
  }

  .hp-clothing-bundle__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 42px;
    background: {{ section.settings.accent_color | default: '#ff5500' }};
    color: #ffffff;
    font-weight: 900;
    font-size: 16px;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(255, 85, 0, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hp-clothing-bundle__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(255, 85, 0, 0.5);
  }
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}">
  <div class="hp-clothing-bundle">
    <div class="hp-clothing-bundle__header">
      <div class="hp-clothing-bundle__badge">🔥 BUNDLE & SAVE 15%</div>
      <h2 class="hp-clothing-bundle__title">{{ section.settings.heading | default: section.settings.title | default: 'THE ESSENTIAL STREETWEAR UNIFORM' }}</h2>
    </div>

    {%- assign p1 = section.settings.product_1 -%}
    {%- assign p2 = section.settings.product_2 -%}

    <form action="/cart/add" method="post" enctype="multipart/form-data">
      <div class="hp-clothing-bundle__content">
        <div class="hp-clothing-bundle__item">
          {%- if p1 != blank and p1.featured_media -%}
            <img src="{{ p1.featured_media | image_url: width: 500 }}" alt="{{ p1.title | escape }}" class="hp-clothing-bundle__img" loading="lazy">
          {%- else -%}
            <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=500&q=80" alt="Acid Wash Hoodie" class="hp-clothing-bundle__img" loading="lazy">
          {%- endif -%}

          <h4 class="hp-clothing-bundle__name">{{ p1.title | default: 'Acid Wash 450GSM Hoodie' }}</h4>
          <div class="hp-clothing-bundle__price">{% if p1 != blank %}{{ p1.price | money }}{% else %}$98.00{% endif %}</div>

          {%- if p1 != blank and p1.variants.size > 0 -%}
            <select name="items[0][id]" class="hp-clothing-bundle__select">
              {%- for v in p1.variants -%}
                <option value="{{ v.id }}">{{ v.title }} - {{ v.price | money }}</option>
              {%- endfor -%}
            </select>
            <input type="hidden" name="items[0][quantity]" value="1">
          {%- else -%}
            <select class="hp-clothing-bundle__select"><option>Size S</option><option selected>Size M</option><option>Size L</option></select>
          {%- endif -%}
        </div>

        <div class="hp-clothing-bundle__plus">+</div>

        <div class="hp-clothing-bundle__item">
          {%- if p2 != blank and p2.featured_media -%}
            <img src="{{ p2.featured_media | image_url: width: 500 }}" alt="{{ p2.title | escape }}" class="hp-clothing-bundle__img" loading="lazy">
          {%- else -%}
            <img src="https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?w=500&q=80" alt="Tactical Cargo Pants" class="hp-clothing-bundle__img" loading="lazy">
          {%- endif -%}

          <h4 class="hp-clothing-bundle__name">{{ p2.title | default: 'Tactical 8-Pocket Cargo' }}</h4>
          <div class="hp-clothing-bundle__price">{% if p2 != blank %}{{ p2.price | money }}{% else %}$110.00{% endif %}</div>

          {%- if p2 != blank and p2.variants.size > 0 -%}
            <select name="items[1][id]" class="hp-clothing-bundle__select">
              {%- for v in p2.variants -%}
                <option value="{{ v.id }}">{{ v.title }} - {{ v.price | money }}</option>
              {%- endfor -%}
            </select>
            <input type="hidden" name="items[1][quantity]" value="1">
          {%- else -%}
            <select class="hp-clothing-bundle__select"><option>Size 30</option><option selected>Size 32</option><option>Size 34</option></select>
          {%- endif -%}
        </div>
      </div>

      <div class="hp-clothing-bundle__action">
        <div class="hp-clothing-bundle__total">
          BUNDLE TOTAL: <span>
            {%- if p1 != blank and p2 != blank -%}
              {{ p1.price | plus: p2.price | times: 0.85 | money }}
            {%- else -%}
              $176.80
            {%- endif -%}
          </span> 
          <s style="opacity:0.5; font-size:18px; margin-left:8px;">
            {%- if p1 != blank and p2 != blank -%}
              {{ p1.price | plus: p2.price | money }}
            {%- else -%}
              $208.00
            {%- endif -%}
          </s>
        </div>
        <button type="submit" class="hp-clothing-bundle__btn">ADD BUNDLE TO CART (SAVE 15%)</button>
      </div>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "Clothing Bundle Builder",
  "tag": "section",
  "class": "section-clothing-bundle",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE ESSENTIAL STREETWEAR UNIFORM"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title Alias",
      "default": "THE ESSENTIAL STREETWEAR UNIFORM"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Select Product 1 (Top)"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Select Product 2 (Bottom)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#09090b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff5500"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Clothing Bundle Builder"
    }
  ]
}
{% endschema %}
