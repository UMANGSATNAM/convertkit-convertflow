{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#09090b' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 60 }}px 16px {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .hp-clothing-best {
    max-width: 1360px;
    margin: 0 auto;
  }

  .hp-clothing-best__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .hp-clothing-best__title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
  }

  .hp-clothing-best__link {
    color: {{ section.settings.accent_color | default: '#ff5500' }};
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
  }

  .hp-clothing-best__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 1024px) {
    .hp-clothing-best__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hp-clothing-best__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp-clothing-card {
    background: #18181b;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    display: flex;
    flex-direction: column;
  }

  .hp-clothing-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    overflow: hidden;
  }

  .hp-clothing-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .hp-clothing-card:hover .hp-clothing-card__img {
    transform: scale(1.05);
  }

  .hp-clothing-card__tag {
    position: absolute;
    top: 12px; left: 12px;
    background: {{ section.settings.accent_color | default: '#ff5500' }};
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
  }

  .hp-clothing-card__sizes {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    display: flex;
    gap: 6px;
    justify-content: center;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease;
  }

  .hp-clothing-card:hover .hp-clothing-card__sizes {
    opacity: 1;
    transform: translateY(0);
  }

  .hp-clothing-size-pill {
    background: rgba(9, 9, 11, 0.9);
    color: #ffffff;
    border: 1px solid rgba(255,255,255,0.2);
    font-size: 11px;
    font-weight: 800;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: all 0.2s ease;
  }

  .hp-clothing-size-pill:hover {
    background: {{ section.settings.accent_color | default: '#ff5500' }};
    border-color: {{ section.settings.accent_color | default: '#ff5500' }};
  }

  .hp-clothing-card__content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .hp-clothing-card__title {
    font-size: 16px;
    font-weight: 800;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .hp-clothing-card__meta {
    font-size: 12px;
    color: rgba(255,255,255,0.6);
    margin-bottom: 12px;
  }

  .hp-clothing-card__price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  .hp-clothing-card__price {
    font-size: 18px;
    font-weight: 900;
    color: {{ section.settings.accent_color | default: '#ff5500' }};
  }

  .hp-clothing-card__compare {
    font-size: 13px;
    text-decoration: line-through;
    color: rgba(255,255,255,0.4);
    margin-left: 8px;
  }
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}">
