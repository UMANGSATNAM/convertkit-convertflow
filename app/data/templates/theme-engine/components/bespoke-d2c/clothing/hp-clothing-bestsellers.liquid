{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#09090b' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 60 }}px 16px {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .hp-clothing-best {
    max-width: 1360px;
    margin: 0 auto;
  }

  .hp-clothing-best__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .hp-clothing-best__title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
  }

  .hp-clothing-best__link {
    color: {{ section.settings.accent_color | default: '#ff5500' }};
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
  }

  .hp-clothing-best__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 1024px) {
    .hp-clothing-best__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hp-clothing-best__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp-clothing-card {
    background: #18181b;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    display: flex;
    flex-direction: column;
  }

  .hp-clothing-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    overflow: hidden;
    display: block;
  }

  .hp-clothing-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .hp-clothing-card:hover .hp-clothing-card__img {
    transform: scale(1.05);
  }

  .hp-clothing-card__tag {
    position: absolute;
    top: 12px; left: 12px;
    background: {{ section.settings.accent_color | default: '#ff5500' }};
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
  }

  .hp-clothing-card__sizes {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    display: flex;
    gap: 6px;
    justify-content: center;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease;
    z-index: 5;
  }

  .hp-clothing-card:hover .hp-clothing-card__sizes {
    opacity: 1;
    transform: translateY(0);
  }

  .hp-clothing-size-pill {
    background: rgba(9, 9, 11, 0.9);
    color: #ffffff;
    border: 1px solid rgba(255,255,255,0.2);
    font-size: 11px;
    font-weight: 800;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: all 0.2s ease;
  }

  .hp-clothing-size-pill:hover {
    background: {{ section.settings.accent_color | default: '#ff5500' }};
    border-color: {{ section.settings.accent_color | default: '#ff5500' }};
  }

  .hp-clothing-card__content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .hp-clothing-card__title {
    font-size: 16px;
    font-weight: 800;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .hp-clothing-card__meta {
    font-size: 12px;
    color: rgba(255,255,255,0.6);
    margin-bottom: 12px;
  }

  .hp-clothing-card__price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  .hp-clothing-card__price {
    font-size: 18px;
    font-weight: 900;
    color: {{ section.settings.accent_color | default: '#ff5500' }};
  }

  .hp-clothing-card__compare {
    font-size: 13px;
    text-decoration: line-through;
    color: rgba(255,255,255,0.4);
    margin-left: 8px;
  }
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}">
  <div class="hp-clothing-best">
    <div class="hp-clothing-best__header">
      <div>
        <h2 class="hp-clothing-best__title">
          {{ section.settings.heading | default: section.settings.title | default: 'SEASONAL BESTSELLERS' }}
        </h2>
      </div>
      <a href="{{ section.settings.collection.url | default: '/collections/all' }}" class="hp-clothing-best__link">VIEW ALL PRODUCTS →</a>
    </div>

    {%- assign featured_collection = section.settings.collection -%}
    {%- assign limit_count = section.settings.products_to_show | default: 4 -%}

    <div class="hp-clothing-best__grid">
      {%- if featured_collection != blank and featured_collection.products.size > 0 -%}
        {%- for product in featured_collection.products limit: limit_count -%}
          <div class="hp-clothing-card">
            <a href="{{ product.url }}" class="hp-clothing-card__media">
              {%- if product.featured_media -%}
                <img src="{{ product.featured_media | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="hp-clothing-card__img" loading="lazy">
              {%- else -%}
                <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=600&q=80" alt="{{ product.title | escape }}" class="hp-clothing-card__img" loading="lazy">
              {%- endif -%}

              {%- if product.compare_at_price > product.price -%}
                <span class="hp-clothing-card__tag">SALE</span>
              {%- endif -%}

              <div class="hp-clothing-card__sizes">
                {%- for variant in product.variants limit: 4 -%}
                  <form action="/cart/add" method="post" enctype="multipart/form-data" style="display:inline;">
                    <input type="hidden" name="id" value="{{ variant.id }}">
                    <button type="submit" class="hp-clothing-size-pill">{{ variant.title }}</button>
                  </form>
                {%- endfor -%}
              </div>
            </a>
            <div class="hp-clothing-card__content">
              <h3 class="hp-clothing-card__title">
                <a href="{{ product.url }}" style="color:inherit; text-decoration:none;">{{ product.title }}</a>
              </h3>
              <div class="hp-clothing-card__meta">{{ product.type | default: 'Heavyweight Collection' }}</div>
              <div class="hp-clothing-card__price-row">
                <div>
                  <span class="hp-clothing-card__price">{{ product.price | money }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    <span class="hp-clothing-card__compare">{{ product.compare_at_price | money }}</span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Fallback Demo Cards if no collection selected yet {%- endcomment -%}
        <div class="hp-clothing-card">
          <div class="hp-clothing-card__media">
            <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=800&q=80" alt="Acid Wash Oversized Hoodie" class="hp-clothing-card__img" loading="lazy">
            <span class="hp-clothing-card__tag">450GSM HEAVYWEIGHT</span>
            <div class="hp-clothing-card__sizes">
              <form action="/cart/add" method="post" style="display:inline;"><button type="submit" class="hp-clothing-size-pill">S</button></form>
              <form action="/cart/add" method="post" style="display:inline;"><button type="submit" class="hp-clothing-size-pill">M</button></form>
              <form action="/cart/add" method="post" style="display:inline;"><button type="submit" class="hp-clothing-size-pill">L</button></form>
              <form action="/cart/add" method="post" style="display:inline;"><button type="submit" class="hp-clothing-size-pill">XL</button></form>
            </div>
          </div>
          <div class="hp-clothing-card__content">
            <h3 class="hp-clothing-card__title">Acid Wash Oversized Hoodie</h3>
            <div class="hp-clothing-card__meta">100% Loopback French Terry • Charcoal</div>
            <div class="hp-clothing-card__price-row">
              <div>
                <span class="hp-clothing-card__price">$98.00</span>
                <span class="hp-clothing-card__compare">$120.00</span>
              </div>
            </div>
          </div>
        </div>

        <div class="hp-clothing-card">
          <div class="hp-clothing-card__media">
            <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=800&q=80" alt="Minimal Graphic Heavy Tee" class="hp-clothing-card__img" loading="lazy">
            <span class="hp-clothing-card__tag">280GSM ORGANIC</span>
            <div class="hp-clothing-card__sizes">
              <form action="/cart/add" method="post" style="display:inline;"><button type="submit" class="hp-clothing-size-pill">S</button></form>
              <form action="/cart/add" method="post" style="display:inline;"><button type="submit" class="hp-clothing-size-pill">M</button></form>
              <form action="/cart/add" method="post" style="display:inline;"><button type="submit" class="hp-clothing-size-pill">L</button></form>
              <form action="/cart/add" method="post" style="display:inline;"><button type="submit" class="hp-clothing-size-pill">XL</button></form>
            </div>
          </div>
          <div class="hp-clothing-card__content">
            <h3 class="hp-clothing-card__title">Minimal Graphic Heavy Tee</h3>
            <div class="hp-clothing-card__meta">Puff Print Detail • Off-White</div>
            <div class="hp-clothing-card__price-row">
              <div>
                <span class="hp-clothing-card__price">$58.00</span>
              </div>
            </div>
          </div>
        </div>

        <div class="hp-clothing-card">
          <div class="hp-clothing-card__media">
            <img src="https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?w=800&q=80" alt="Tactical 8-Pocket Cargo" class="hp-clothing-card__img" loading="lazy">
            <span class="hp-clothing-card__tag">RESTOCKED</span>
            <div class="hp-clothing-card__sizes">
              <form action="/cart/add" method="post" style="display:inline;"><button type="submit" class="hp-clothing-size-pill">30</button></form>
              <form action="/cart/add" method="post" style="display:inline;"><button type="submit" class="hp-clothing-size-pill">32</button></form>
              <form action="/cart/add" method="post" style="display:inline;"><button type="submit" class="hp-clothing-size-pill">34</button></form>
            </div>
          </div>
          <div class="hp-clothing-card__content">
            <h3 class="hp-clothing-card__title">Tactical 8-Pocket Cargo</h3>
            <div class="hp-clothing-card__meta">Adjustable Ankle Cuffs • Obsidian</div>
            <div class="hp-clothing-card__price-row">
              <div>
                <span class="hp-clothing-card__price">$110.00</span>
              </div>
            </div>
          </div>
        </div>

        <div class="hp-clothing-card">
          <div class="hp-clothing-card__media">
            <img src="https://images.unsplash.com/photo-1548883354-7622d03aca27?w=800&q=80" alt="Cropped Puffer Jacket" class="hp-clothing-card__img" loading="lazy">
            <span class="hp-clothing-card__tag">WINTER SHELL</span>
            <div class="hp-clothing-card__sizes">
              <form action="/cart/add" method="post" style="display:inline;"><button type="submit" class="hp-clothing-size-pill">S</button></form>
              <form action="/cart/add" method="post" style="display:inline;"><button type="submit" class="hp-clothing-size-pill">M</button></form>
              <form action="/cart/add" method="post" style="display:inline;"><button type="submit" class="hp-clothing-size-pill">L</button></form>
            </div>
          </div>
          <div class="hp-clothing-card__content">
            <h3 class="hp-clothing-card__title">Cropped Technical Puffer</h3>
            <div class="hp-clothing-card__meta">700 Down Fill • Matte Black</div>
            <div class="hp-clothing-card__price-row">
              <div>
                <span class="hp-clothing-card__price">$185.00</span>
                <span class="hp-clothing-card__compare">$220.00</span>
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clothing Bestsellers",
  "tag": "section",
  "class": "section-clothing-best",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SEASONAL BESTSELLERS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title Alias",
      "default": "SEASONAL BESTSELLERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Real Shopify Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#09090b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff5500"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Clothing Bestsellers"
    }
  ]
}
{% endschema %}
