{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color | default: '#09090b' }};
    --text-color: {{ section.settings.text_color | default: '#ffffff' }};
    --accent-color: {{ section.settings.accent_color | default: '#ff5500' }};
    --card-bg: {{ section.settings.card_bg | default: '#18181b' }};
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    overflow: hidden;
  }

  .hp-clothing-hero {
    position: relative;
    width: 100%;
    min-height: 82vh;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    overflow: hidden;
    margin: 0 auto;
    max-width: 1360px;
    padding: 0 16px;
  }

  .hp-clothing-hero__bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
    filter: brightness(0.65);
  }

  .hp-clothing-hero__overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(180deg, rgba(9,9,11,0.2) 0%, rgba(9,9,11,0.85) 100%);
    z-index: 2;
  }

  .hp-clothing-hero__content {
    position: relative;
    z-index: 3;
    max-width: 800px;
    text-align: center;
    padding: 40px 24px;
  }

  .hp-clothing-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    background: rgba(255, 85, 0, 0.15);
    border: 1px solid var(--accent-color);
    border-radius: 99px;
    color: var(--accent-color);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 24px;
    backdrop-filter: blur(8px);
  }

  .hp-clothing-hero__title {
    font-size: clamp(36px, 6.5vw, 72px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -1.5px;
    text-transform: uppercase;
    margin: 0 0 20px;
    color: var(--text-color);
  }

  .hp-clothing-hero__text {
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    max-width: 640px;
    margin: 0 auto 32px;
  }

  .hp-clothing-hero__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hp-clothing-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 36px;
    background: var(--accent-color);
    color: #ffffff;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 8px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 8px 24px rgba(255, 85, 0, 0.35);
  }

  .hp-clothing-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(255, 85, 0, 0.5);
  }

  .hp-clothing-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 36px;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.25);
    text-decoration: none;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }

  .hp-clothing-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
  }
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}">
  <div class="hp-clothing-hero">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1920 }}" alt="{{ section.settings.heading | escape }}" class="hp-clothing-hero__bg" loading="eager">
    {%- else -%}
      <img src="https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=1600&q=80" alt="Streetwear Hero" class="hp-clothing-hero__bg" loading="eager">
    {%- endif -%}
    
    <div class="hp-clothing-hero__overlay"></div>

    <div class="hp-clothing-hero__content">
      {%- if section.settings.badge != blank or section.settings.subheading != blank -%}
        <div class="hp-clothing-hero__badge">
          🔥 {{ section.settings.badge | default: section.settings.subheading | default: 'LIMITED STREETWEAR DROP' }}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank or section.settings.title != blank -%}
        <h1 class="hp-clothing-hero__title">
          {{ section.settings.heading | default: section.settings.title | default: 'HEAVYWEIGHT OVERSIZED ESSENTIALS' }}
        </h1>
      {%- endif -%}

      {%- if section.settings.text != blank or section.settings.description != blank -%}
        <p class="hp-clothing-hero__text">
          {{ section.settings.text | default: section.settings.description | default: 'Engineered from 450GSM French Terry cotton. Designed for maximum durability, relaxed fit, and modern streetwear aesthetic.' }}
        </p>
      {%- endif -%}

      <div class="hp-clothing-hero__actions">
        <a href="{{ section.settings.btn_link | default: section.settings.btn_url | default: '/collections/all' }}" class="hp-clothing-btn-primary">
          {{ section.settings.btn_label | default: section.settings.btn_text | default: 'SHOP THE DROP' }}
        </a>
        <a href="/collections/all" class="hp-clothing-btn-secondary">
          EXPLORE LOOKBOOK
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clothing Streetwear Hero",
  "tag": "section",
  "class": "section-clothing-hero",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Drop Badge",
      "default": "LIMITED STREETWEAR DROP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HEAVYWEIGHT OVERSIZED ESSENTIALS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title Alias",
      "default": "HEAVYWEIGHT OVERSIZED ESSENTIALS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "SPRING / SUMMER DROP"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Engineered from 450GSM French Terry cotton. Designed for maximum durability, relaxed fit, and modern streetwear aesthetic."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "SHOP THE DROP"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#09090b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff5500"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Clothing Streetwear Hero"
    }
  ]
}
{% endschema %}
