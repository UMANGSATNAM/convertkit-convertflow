{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#09090b' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 40 }}px 16px {{ section.settings.padding_bottom | default: 40 }}px;
    border-top: 1px solid rgba(255,255,255,0.08);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .hp-clothing-trust {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 900px) {
    .hp-clothing-trust {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .hp-clothing-trust {
      grid-template-columns: 1fr;
    }
  }

  .hp-clothing-trust__item {
    display: flex;
    align-items: center;
    gap: 16px;
    background: #18181b;
    padding: 20px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.06);
  }

  .hp-clothing-trust__icon {
    font-size: 28px;
    flex-shrink: 0;
  }

  .hp-clothing-trust__title {
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    margin: 0 0 4px;
  }

  .hp-clothing-trust__sub {
    font-size: 12px;
    color: rgba(255,255,255,0.6);
  }
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}">
  <div class="hp-clothing-trust">
    <div class="hp-clothing-trust__item">
      <div class="hp-clothing-trust__icon">🚚</div>
      <div>
        <div class="hp-clothing-trust__title">EXPRESS WORLDWIDE</div>
        <div class="hp-clothing-trust__sub">Tracked 3-5 day delivery</div>
      </div>
    </div>

    <div class="hp-clothing-trust__item">
      <div class="hp-clothing-trust__icon">🛡️</div>
      <div>
        <div class="hp-clothing-trust__title">30-DAY EASY RETURNS</div>
        <div class="hp-clothing-trust__sub">Hassle-free size exchange</div>
      </div>
    </div>

    <div class="hp-clothing-trust__item">
      <div class="hp-clothing-trust__icon">🧵</div>
      <div>
        <div class="hp-clothing-trust__title">HEAVYWEIGHT QUALITY</div>
        <div class="hp-clothing-trust__sub">450GSM pre-shrunk cotton</div>
      </div>
    </div>

    <div class="hp-clothing-trust__item">
      <div class="hp-clothing-trust__icon">🔒</div>
      <div>
        <div class="hp-clothing-trust__title">100% SECURE CHECKOUT</div>
        <div class="hp-clothing-trust__sub">Shopify Pay / Cards / UPI</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clothing Trust Badges",
  "tag": "section",
  "class": "section-clothing-trust",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#09090b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff5500"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Clothing Trust Badges"
    }
  ]
}
{% endschema %}
