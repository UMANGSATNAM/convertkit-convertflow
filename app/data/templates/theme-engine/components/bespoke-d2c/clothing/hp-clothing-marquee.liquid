{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#ff5500' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    padding: 14px 0;
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid rgba(255,255,255,0.15);
    border-bottom: 1px solid rgba(255,255,255,0.15);
  }

  .hp-clothing-marquee {
    display: flex;
    align-items: center;
    gap: 40px;
    animation: hpClothingMarqueeScroll {{ section.settings.speed | default: 25 }}s linear infinite;
  }

  .hp-clothing-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .hp-clothing-marquee__star {
    opacity: 0.7;
    font-size: 12px;
  }

  @keyframes hpClothingMarqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}">
  <div class="hp-clothing-marquee">
    {%- for i in (1..8) -%}
      <div class="hp-clothing-marquee__item">
        <span>⚡ 450GSM HEAVYWEIGHT COTTON</span>
        <span class="hp-clothing-marquee__star">★</span>
        <span>🚚 FREE EXPRESS WORLDWIDE SHIPPING OVER $99</span>
        <span class="hp-clothing-marquee__star">★</span>
        <span>🔥 LIMITED ARCHETYPE RUN</span>
        <span class="hp-clothing-marquee__star">★</span>
        <span>🛡️ 30-DAY EASY RETURNS & EXCHANGES</span>
        <span class="hp-clothing-marquee__star">★</span>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Clothing Marquee Ticker",
  "tag": "section",
  "class": "section-clothing-marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ff5500"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll Speed",
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Ticker Badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Badge Text",
          "default": "⚡ 450GSM HEAVYWEIGHT COTTON"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clothing Marquee Ticker"
    }
  ]
}
{% endschema %}
