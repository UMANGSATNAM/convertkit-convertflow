{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#09090b' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 60 }}px 16px {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .hp-clothing-lookbook {
    max-width: 1360px;
    margin: 0 auto;
  }

  .hp-clothing-lookbook__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .hp-clothing-lookbook__sub {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    color: {{ section.settings.accent_color | default: '#ff5500' }};
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .hp-clothing-lookbook__title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
  }

  .hp-clothing-lookbook__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 24px;
  }

  @media (max-width: 900px) {
    .hp-clothing-lookbook__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp-clothing-lookbook__main-card {
    position: relative;
    height: 580px;
    border-radius: 16px;
    overflow: hidden;
  }

  .hp-clothing-lookbook__side-grid {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 24px;
  }

  .hp-clothing-lookbook__card {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 275px;
    border-radius: 16px;
    overflow: hidden;
  }

  .hp-clothing-lookbook__img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: brightness(0.85);
    transition: transform 0.6s ease;
  }

  .hp-clothing-lookbook__main-card:hover .hp-clothing-lookbook__img,
  .hp-clothing-lookbook__card:hover .hp-clothing-lookbook__img {
    transform: scale(1.04);
  }

  .hp-clothing-hotspot {
    position: absolute;
    width: 24px; height: 24px;
    border-radius: 50%;
    background: {{ section.settings.accent_color | default: '#ff5500' }};
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 12px;
    cursor: pointer;
    box-shadow: 0 0 0 6px rgba(255, 85, 0, 0.3);
    animation: hpHotspotPulse 2s infinite;
    z-index: 4;
  }

  @keyframes hpHotspotPulse {
    0% { box-shadow: 0 0 0 0 rgba(255, 85, 0, 0.6); }
    70% { box-shadow: 0 0 0 12px rgba(255, 85, 0, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 85, 0, 0); }
  }

  .hp-clothing-hotspot__tooltip {
    position: absolute;
    bottom: 32px; left: 50%;
    transform: translateX(-50%);
    background: #18181b;
    border: 1px solid rgba(255,255,255,0.2);
    padding: 10px 16px;
    border-radius: 8px;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s ease;
    pointer-events: none;
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
  }

  .hp-clothing-hotspot:hover .hp-clothing-hotspot__tooltip {
    opacity: 1;
    visibility: visible;
    bottom: 36px;
  }

  .hp-clothing-hotspot__title {
    font-size: 13px;
    font-weight: 800;
    color: #ffffff;
  }

  .hp-clothing-hotspot__price {
    font-size: 12px;
    color: {{ section.settings.accent_color | default: '#ff5500' }};
    font-weight: 700;
  }
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}">
  <div class="hp-clothing-lookbook">
    <div class="hp-clothing-lookbook__header">
      <div class="hp-clothing-lookbook__sub">CURATED EDITORIAL</div>
      <h2 class="hp-clothing-lookbook__title">STREETWEAR LOOKBOOK VOL. 04</h2>
    </div>

    <div class="hp-clothing-lookbook__grid">
      <div class="hp-clothing-lookbook__main-card">
        <img src="https://images.unsplash.com/photo-1509631179647-0177331693ae?w=1000&q=80" alt="Lookbook Outfit 1" class="hp-clothing-lookbook__img" loading="lazy">
        
        <div class="hp-clothing-hotspot" style="top: 30%; left: 45%;">
          +
          <div class="hp-clothing-hotspot__tooltip">
            <div class="hp-clothing-hotspot__title">Heavyweight Acid Wash Jacket</div>
            <div class="hp-clothing-hotspot__price">$140.00</div>
          </div>
        </div>

        <div class="hp-clothing-hotspot" style="top: 70%; left: 55%;">
          +
          <div class="hp-clothing-hotspot__tooltip">
            <div class="hp-clothing-hotspot__title">Tactical Cargo Trouser</div>
            <div class="hp-clothing-hotspot__price">$110.00</div>
          </div>
        </div>
      </div>

      <div class="hp-clothing-lookbook__side-grid">
        <div class="hp-clothing-lookbook__card">
          <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=800&q=80" alt="Lookbook Outfit 2" class="hp-clothing-lookbook__img" loading="lazy">
          <div class="hp-clothing-hotspot" style="top: 40%; left: 50%;">
            +
            <div class="hp-clothing-hotspot__tooltip">
              <div class="hp-clothing-hotspot__title">Boxy Heavyweight Tee</div>
              <div class="hp-clothing-hotspot__price">$58.00</div>
            </div>
          </div>
        </div>

        <div class="hp-clothing-lookbook__card">
          <img src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?w=800&q=80" alt="Lookbook Outfit 3" class="hp-clothing-lookbook__img" loading="lazy">
          <div class="hp-clothing-hotspot" style="top: 35%; left: 48%;">
            +
            <div class="hp-clothing-hotspot__tooltip">
              <div class="hp-clothing-hotspot__title">Cropped Down Puffer</div>
              <div class="hp-clothing-hotspot__price">$185.00</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clothing Lookbook Grid",
  "tag": "section",
  "class": "section-clothing-lookbook",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#09090b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff5500"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Clothing Lookbook Grid"
    }
  ]
}
{% endschema %}
