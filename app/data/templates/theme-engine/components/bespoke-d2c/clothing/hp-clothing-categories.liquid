{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#09090b' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 60 }}px 16px {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .hp-clothing-cat {
    max-width: 1360px;
    margin: 0 auto;
  }

  .hp-clothing-cat__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp-clothing-cat__sub {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    color: {{ section.settings.accent_color | default: '#ff5500' }};
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .hp-clothing-cat__title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -1px;
    margin: 0;
  }

  .hp-clothing-cat__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  @media (max-width: 1024px) {
    .hp-clothing-cat__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hp-clothing-cat__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp-clothing-cat__card {
    position: relative;
    height: 420px;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    align-items: flex-end;
    padding: 24px;
    transition: transform 0.3s ease;
  }

  .hp-clothing-cat__card:hover {
    transform: translateY(-4px);
  }

  .hp-clothing-cat__img {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 0.5s ease, filter 0.3s ease;
  }

  .hp-clothing-cat__card:hover .hp-clothing-cat__img {
    transform: scale(1.06);
    filter: brightness(0.8);
  }

  .hp-clothing-cat__overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(9,9,11,0.95) 100%);
    z-index: 2;
  }

  .hp-clothing-cat__info {
    position: relative;
    z-index: 3;
  }

  .hp-clothing-cat__name {
    font-size: 24px;
    font-weight: 900;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 6px;
  }

  .hp-clothing-cat__count {
    font-size: 13px;
    font-weight: 700;
    color: rgba(255,255,255,0.7);
    letter-spacing: 1px;
    text-transform: uppercase;
  }
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}">
  <div class="hp-clothing-cat">
    <div class="hp-clothing-cat__header">
      <div class="hp-clothing-cat__sub">
        {{ section.settings.subheading | default: 'EXPLORE COLLECTIONS' }}
      </div>
      <h2 class="hp-clothing-cat__title">
        {{ section.settings.heading | default: section.settings.title | default: 'SELECT YOUR SILHOUETTE' }}
      </h2>
    </div>

    <div class="hp-clothing-cat__grid">
      {%- assign c1 = section.settings.collection_1 -%}
      <a href="{{ c1.url | default: '/collections/all' }}" class="hp-clothing-cat__card">
        {%- if section.settings.image_1 != blank -%}
          <img src="{{ section.settings.image_1 | image_url: width: 600 }}" alt="{{ section.settings.title_1 | default: c1.title | escape }}" class="hp-clothing-cat__img" loading="lazy">
        {%- elsif c1 != blank and c1.image != blank -%}
          <img src="{{ c1.image | image_url: width: 600 }}" alt="{{ c1.title | escape }}" class="hp-clothing-cat__img" loading="lazy">
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=800&q=80" alt="Heavyweight Hoodies" class="hp-clothing-cat__img" loading="lazy">
        {%- endif -%}
        <div class="hp-clothing-cat__overlay"></div>
        <div class="hp-clothing-cat__info">
          <h3 class="hp-clothing-cat__name">{{ section.settings.title_1 | default: c1.title | default: 'HEAVYWEIGHT HOODIES' }}</h3>
          <div class="hp-clothing-cat__count">{% if c1 != blank %}{{ c1.products_count }} Products{% else %}450GSM French Terry{% endif %}</div>
        </div>
      </a>

      {%- assign c2 = section.settings.collection_2 -%}
      <a href="{{ c2.url | default: '/collections/all' }}" class="hp-clothing-cat__card">
        {%- if section.settings.image_2 != blank -%}
          <img src="{{ section.settings.image_2 | image_url: width: 600 }}" alt="{{ section.settings.title_2 | default: c2.title | escape }}" class="hp-clothing-cat__img" loading="lazy">
        {%- elsif c2 != blank and c2.image != blank -%}
          <img src="{{ c2.image | image_url: width: 600 }}" alt="{{ c2.title | escape }}" class="hp-clothing-cat__img" loading="lazy">
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=800&q=80" alt="Oversized Boxy Tees" class="hp-clothing-cat__img" loading="lazy">
        {%- endif -%}
        <div class="hp-clothing-cat__overlay"></div>
        <div class="hp-clothing-cat__info">
          <h3 class="hp-clothing-cat__name">{{ section.settings.title_2 | default: c2.title | default: 'OVERSIZED TEES' }}</h3>
          <div class="hp-clothing-cat__count">{% if c2 != blank %}{{ c2.products_count }} Products{% else %}280GSM Organic Cotton{% endif %}</div>
        </div>
      </a>

      {%- assign c3 = section.settings.collection_3 -%}
      <a href="{{ c3.url | default: '/collections/all' }}" class="hp-clothing-cat__card">
        {%- if section.settings.image_3 != blank -%}
          <img src="{{ section.settings.image_3 | image_url: width: 600 }}" alt="{{ section.settings.title_3 | default: c3.title | escape }}" class="hp-clothing-cat__img" loading="lazy">
        {%- elsif c3 != blank and c3.image != blank -%}
          <img src="{{ c3.image | image_url: width: 600 }}" alt="{{ c3.title | escape }}" class="hp-clothing-cat__img" loading="lazy">
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?w=800&q=80" alt="Tactical Cargo Pants" class="hp-clothing-cat__img" loading="lazy">
        {%- endif -%}
        <div class="hp-clothing-cat__overlay"></div>
        <div class="hp-clothing-cat__info">
          <h3 class="hp-clothing-cat__name">{{ section.settings.title_3 | default: c3.title | default: 'CARGO PANTS' }}</h3>
          <div class="hp-clothing-cat__count">{% if c3 != blank %}{{ c3.products_count }} Products{% else %}Reinforced Ripstop{% endif %}</div>
        </div>
      </a>

      {%- assign c4 = section.settings.collection_4 -%}
      <a href="{{ c4.url | default: '/collections/all' }}" class="hp-clothing-cat__card">
        {%- if section.settings.image_4 != blank -%}
          <img src="{{ section.settings.image_4 | image_url: width: 600 }}" alt="{{ section.settings.title_4 | default: c4.title | escape }}" class="hp-clothing-cat__img" loading="lazy">
        {%- elsif c4 != blank and c4.image != blank -%}
          <img src="{{ c4.image | image_url: width: 600 }}" alt="{{ c4.title | escape }}" class="hp-clothing-cat__img" loading="lazy">
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1548883354-7622d03aca27?w=800&q=80" alt="Technical Outerwear" class="hp-clothing-cat__img" loading="lazy">
        {%- endif -%}
        <div class="hp-clothing-cat__overlay"></div>
        <div class="hp-clothing-cat__info">
          <h3 class="hp-clothing-cat__name">{{ section.settings.title_4 | default: c4.title | default: 'TECHNICAL OUTERWEAR' }}</h3>
          <div class="hp-clothing-cat__count">{% if c4 != blank %}{{ c4.products_count }} Products{% else %}Waterproof Shells{% endif %}</div>
        </div>
      </a>
    </div>
  </div>
</section>

