{% comment %}
  D2C Cyber Audio Tech Benchmark Matrix
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<section class="d2c-audio-matrix" id="d2c-aumat-{{ section.id }}">
  <div class="d2c-aumat-container">
    <div class="d2c-ausec-header">
      <span class="d2c-au-badge">HARDWARE ARCHITECTURE</span>
      <h2 class="d2c-au-title">{{ section.settings.title | default: "ENGINEERED FOR SUPREME ACOUSTIC PERFORMANCE" }}</h2>
    </div>

    <div class="d2c-aumat-grid">
      <div class="d2c-aumat-card">
        <div class="d2c-aumat-val">50 MM</div>
        <div class="d2c-aumat-name">TITANIUM DRIVERS</div>
        <p class="d2c-aumat-desc">Rigid titanium diaphragm for zero distortion at maximum volume and chest-thumping low frequencies.</p>
      </div>

      <div class="d2c-aumat-card">
        <div class="d2c-aumat-val">45 dB</div>
        <div class="d2c-aumat-name">HYBRID ANC SILENCE</div>
        <p class="d2c-aumat-desc">Feedforward and feedback microphones neutralize ambient noise up to 45dB instantly.</p>
      </div>

      <div class="d2c-aumat-card">
        <div class="d2c-aumat-val">40 MS</div>
        <div class="d2c-aumat-name">BEAST™ GAMING SPEED</div>
        <p class="d2c-aumat-desc">Ultra-low latency audio transmission so gunfire and footsteps sync perfectly with on-screen action.</p>
      </div>

      <div class="d2c-aumat-card">
        <div class="d2c-aumat-val">70 HRS</div>
        <div class="d2c-aumat-name">ASAP™ CHARGE BATTERY</div>
        <p class="d2c-aumat-desc">Play all week on a single charge. 10 minutes of Type-C juice delivers 10 hours of uninterrupted audio.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-aumat-{{ section.id }} {
    background: #000000;
    padding: 70px 32px;
    border-top: 1px solid #27272a;
    border-bottom: 1px solid #27272a;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-aumat-container { max-width: 1360px; margin: 0 auto; }
  .d2c-aumat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-aumat-card {
    background: #09090b;
    border: 1px solid #27272a;
    border-radius: 8px;
    padding: 32px 20px;
    text-align: center;
  }
  .d2c-aumat-val { font-size: 28px; font-weight: 900; color: #22c55e; margin-bottom: 6px; font-family: monospace; }
  .d2c-aumat-name { font-size: 12px; font-weight: 800; color: #ffffff; letter-spacing: 0.5px; margin-bottom: 10px; }
  .d2c-aumat-desc { font-size: 13px; color: #a1a1aa; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-aumat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-aumat-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Audio Tech Matrix",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ENGINEERED FOR SUPREME ACOUSTIC PERFORMANCE"
    }
  ],
  "presets": [
    {
      "name": "Audio Tech Matrix"
    }
  ]
}
{% endschema %}
