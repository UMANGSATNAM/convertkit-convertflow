{% comment %}
  D2C Cyber Audio Hero
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<section class="d2c-audio-hero" id="d2c-auhero-{{ section.id }}">
  <div class="d2c-auhero-container">
    <div class="d2c-auhero-grid">
      <div class="d2c-auhero-text">
        <span class="d2c-auhero-badge">⚡ FLAGSHIP WIRELESS DROP</span>
        <h1 class="d2c-auhero-title">{{ section.settings.heading | default: "HEAR THE FUTURE: 45DB HYBRID ANC & IMMERSIVE 3D BASS" }}</h1>
        <p class="d2c-auhero-desc">
          Engineered with 50mm dynamic titanium drivers, 70-hour marathon battery, and Beast™ 40ms ultra-low latency gaming mode. Silence the ambient world and drop into high-fidelity sound.
        </p>

        <div class="d2c-auhero-actions">
          <a href="/products/cyber-anc-flagship" class="d2c-aubtn-primary">BUY NOW • ₹3,499 &rarr;</a>
          <a href="/pages/anc-technology" class="d2c-aubtn-secondary">EXPERIENCE 45DB ANC DEMO</a>
        </div>

        <div class="d2c-auhero-specs">
          <div class="d2c-auspec"><strong>45 dB</strong> <span>Hybrid ANC Silence</span></div>
          <div class="d2c-auspec"><strong>70 HRS</strong> <span>Marathon Playtime</span></div>
          <div class="d2c-auspec"><strong>40 ms</strong> <span>Beast™ Gaming Latency</span></div>
        </div>
      </div>

      <div class="d2c-auhero-media">
        <div class="d2c-auhero-frame">
          <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=900&q=85" alt="Cyber ANC Wireless Headphones" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-auhero-{{ section.id }} {
    background: #000000;
    color: #ffffff;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-auhero-container { max-width: 1360px; margin: 0 auto; }
  .d2c-auhero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }
  .d2c-auhero-badge {
    font-size: 11px;
    font-weight: 800;
    color: #22c55e;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 16px;
    display: block;
  }
  .d2c-auhero-title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.1;
    letter-spacing: -0.5px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }
  .d2c-auhero-desc {
    font-size: 16px;
    color: #a1a1aa;
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 540px;
  }
  .d2c-auhero-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }
  .d2c-aubtn-primary {
    background: #22c55e;
    color: #000000;
    padding: 16px 32px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
  }
  .d2c-aubtn-secondary {
    background: transparent;
    border: 1px solid #27272a;
    color: #ffffff;
    padding: 16px 28px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
  }
  .d2c-auhero-specs {
    display: flex;
    gap: 36px;
    border-top: 1px solid #27272a;
    padding-top: 24px;
  }
  .d2c-auspec strong { font-size: 24px; font-weight: 900; color: #22c55e; display: block; }
  .d2c-auspec span { font-size: 11px; color: #71717a; text-transform: uppercase; }
  .d2c-auhero-frame {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(34, 197, 94, 0.3);
    box-shadow: 0 0 50px rgba(34, 197, 94, 0.15);
  }
  .d2c-auhero-frame img { width: 100%; height: 500px; object-fit: cover; }

  @media (max-width: 900px) {
    .d2c-auhero-grid { grid-template-columns: 1fr; }
    .d2c-auhero-frame img { height: 360px; }
    #d2c-auhero-{{ section.id }} { padding: 40px 18px; }
  }
</style>

{% schema %}
{
  "name": "Audio Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HEAR THE FUTURE: 45DB HYBRID ANC & IMMERSIVE 3D BASS"
    }
  ],
  "presets": [
    {
      "name": "Audio Hero"
    }
  ]
}
{% endschema %}
