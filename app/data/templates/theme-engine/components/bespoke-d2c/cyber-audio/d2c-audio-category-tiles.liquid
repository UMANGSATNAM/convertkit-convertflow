{% comment %}
  D2C Cyber Audio Category Tiles
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<section class="d2c-audio-cats" id="d2c-aucats-{{ section.id }}">
  <div class="d2c-aucats-container">
    <div class="d2c-ausec-header">
      <span class="d2c-au-badge">TECH DIRECTORY</span>
      <h2 class="d2c-au-title">{{ section.settings.title | default: "GEAR UP BY CATEGORY" }}</h2>
    </div>

    <div class="d2c-aucats-grid">
      <a href="/collections/wireless-headphones" class="d2c-aucat-card">
        <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&q=80" alt="ANC Headphones" />
        <div class="d2c-aucat-overlay">
          <span class="d2c-aucat-sub">OVER-EAR IMMERSION</span>
          <h3 class="d2c-aucat-name">ANC HEADPHONES</h3>
          <span class="d2c-aucat-link">EXPLORE TECH &rarr;</span>
        </div>
      </a>

      <a href="/collections/tws-earbuds" class="d2c-aucat-card">
        <img src="https://images.unsplash.com/photo-1590658268037-6bf12165a8df?w=600&q=80" alt="TWS Earbuds" />
        <div class="d2c-aucat-overlay">
          <span class="d2c-aucat-sub">POCKET TRUE WIRELESS</span>
          <h3 class="d2c-aucat-name">TWS EARBUDS</h3>
          <span class="d2c-aucat-link">EXPLORE TECH &rarr;</span>
        </div>
      </a>

      <a href="/collections/smartwatches" class="d2c-aucat-card">
        <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&q=80" alt="Smartwatches" />
        <div class="d2c-aucat-overlay">
          <span class="d2c-aucat-sub">AMOLED DISPLAY & BT CALLING</span>
          <h3 class="d2c-aucat-name">CYBER SMARTWATCHES</h3>
          <span class="d2c-aucat-link">EXPLORE TECH &rarr;</span>
        </div>
      </a>

      <a href="/collections/soundbars" class="d2c-aucat-card">
        <img src="https://images.unsplash.com/photo-1545454675-3531b543be5d?w=600&q=80" alt="Gaming Soundbars" />
        <div class="d2c-aucat-overlay">
          <span class="d2c-aucat-sub">DOLBY AUDIO CINEMA</span>
          <h3 class="d2c-aucat-name">PARTY SOUNDBARS</h3>
          <span class="d2c-aucat-link">EXPLORE TECH &rarr;</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  #d2c-aucats-{{ section.id }} {
    background: #09090b;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-aucats-container { max-width: 1360px; margin: 0 auto; }
  .d2c-ausec-header { text-align: center; margin-bottom: 48px; }
  .d2c-au-badge { font-size: 11px; font-weight: 800; color: #22c55e; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px; display: block; }
  .d2c-au-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 900; color: #ffffff; letter-spacing: -0.5px; text-transform: uppercase; }
  .d2c-aucats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .d2c-aucat-card {
    position: relative;
    height: 420px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #27272a;
    text-decoration: none;
    display: block;
    background: #18181b;
  }
  .d2c-aucat-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .d2c-aucat-card:hover img { transform: scale(1.06); }
  .d2c-aucat-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: #ffffff;
    text-align: center;
  }
  .d2c-aucat-sub { font-size: 10px; font-weight: 800; color: #22c55e; letter-spacing: 1.5px; margin-bottom: 4px; }
  .d2c-aucat-name { font-size: 16px; font-weight: 900; letter-spacing: 0.5px; margin-bottom: 6px; }
  .d2c-aucat-link { font-size: 11px; font-weight: 800; color: #a1a1aa; }

  @media (max-width: 1024px) { .d2c-aucats-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-aucats-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Audio Categories",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "GEAR UP BY CATEGORY"
    }
  ],
  "presets": [
    {
      "name": "Audio Categories"
    }
  ]
}
{% endschema %}
