{% comment %}
  D2C Cyber Audio Brand Story
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<section class="d2c-audio-story" id="d2c-austory-{{ section.id }}">
  <div class="d2c-audio-container">
    <div class="d2c-austory-grid">
      <div class="d2c-austory-content">
        <span class="d2c-au-badge">CYBER MANIFESTO</span>
        <h2 class="d2c-austory-title">{{ section.settings.title | default: "FUELING INDIA'S NEXT-GEN GAMERS & CREATORS" }}</h2>
        <p class="d2c-austory-para">
          We refused to accept overpriced foreign tech with mediocre bass that fails Indian music, workouts, and esports culture.
        </p>
        <p class="d2c-austory-para">
          We built aggressive acoustic architecture from the ground up: titanium drivers custom-tuned for deep sub-bass punch, military-grade sweat resistance, and zero-latency wireless transmission at prices everyone can own.
        </p>
        <div class="d2c-austory-stats">
          <div><span class="d2c-aust-num">10M+</span><span class="d2c-aust-lbl">Audio Clan</span></div>
          <div><span class="d2c-aust-num">45dB</span><span class="d2c-aust-lbl">Hybrid ANC</span></div>
          <div><span class="d2c-aust-num">40ms</span><span class="d2c-aust-lbl">Beast Mode</span></div>
        </div>
      </div>

      <div class="d2c-austory-media">
        <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&q=80" alt="Cyber Audio Engineering" />
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-austory-{{ section.id }} {
    background: #09090b;
    padding: 80px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-audio-container { max-width: 1360px; margin: 0 auto; }
  .d2c-austory-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }
  .d2c-austory-title { font-size: clamp(28px, 3.5vw, 42px); font-weight: 900; color: #ffffff; line-height: 1.15; margin: 10px 0 20px; text-transform: uppercase; }
  .d2c-austory-para { font-size: 15px; color: #a1a1aa; line-height: 1.7; margin-bottom: 18px; }
  .d2c-austory-stats {
    display: flex;
    gap: 36px;
    border-top: 1px solid #27272a;
    padding-top: 24px;
    margin-top: 28px;
  }
  .d2c-aust-num { font-size: 26px; font-weight: 900; color: #22c55e; display: block; font-family: monospace; }
  .d2c-aust-lbl { font-size: 11px; color: #71717a; font-weight: 700; text-transform: uppercase; }
  .d2c-austory-media img { width: 100%; height: 440px; object-fit: cover; border-radius: 12px; border: 1px solid rgba(34, 197, 94, 0.3); }

  @media (max-width: 900px) {
    .d2c-austory-grid { grid-template-columns: 1fr; }
    .d2c-austory-media img { height: 320px; }
  }
</style>

{% schema %}
{
  "name": "Audio Story",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FUELING INDIA'S NEXT-GEN GAMERS & CREATORS"
    }
  ],
  "presets": [
    {
      "name": "Audio Story"
    }
  ]
}
{% endschema %}
