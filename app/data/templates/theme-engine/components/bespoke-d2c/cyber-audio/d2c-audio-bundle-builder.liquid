{% comment %}
  D2C Cyber Audio Streamer & Gym Rig Bundle
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<section class="d2c-audio-bundle" id="d2c-aubundle-{{ section.id }}">
  <div class="d2c-aubundle-container">
    <div class="d2c-aubundle-box">
      <div class="d2c-aubundle-info">
        <span class="d2c-au-badge">PRO STREAMER & GYM RIG</span>
        <h2 class="d2c-aubundle-title">{{ section.settings.title | default: "THE COMPLETE CYBER BATTLESTATION TRIO" }}</h2>
        <p class="d2c-aubundle-desc">
          Everything you need for unstoppable performance: Immortal 1000 ANC Headphones + Wave Force AMOLED Smartwatch + Airdopes Cyber Gaming TWS.
        </p>
        <div class="d2c-aubundle-price">TRIO BUNDLE: ₹5,999 <span class="d2c-aub-orig">₹19,470</span> <span class="d2c-aub-save">SAVE 69%</span></div>
        <button class="d2c-aub-btn">CLAIM CYBER RIG BUNDLE &rarr;</button>
      </div>

      <div class="d2c-aubundle-visual">
        <div class="d2c-aubi-card">
          <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=400&q=80" alt="Headphones" />
          <span>ANC Headphones</span>
        </div>
        <span class="d2c-aubi-plus">+</span>
        <div class="d2c-aubi-card">
          <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400&q=80" alt="Smartwatch" />
          <span>AMOLED Watch</span>
        </div>
        <span class="d2c-aubi-plus">+</span>
        <div class="d2c-aubi-card">
          <img src="https://images.unsplash.com/photo-1590658268037-6bf12165a8df?w=400&q=80" alt="Earbuds" />
          <span>Gaming TWS</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-aubundle-{{ section.id }} {
    background: #09090b;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-aubundle-container { max-width: 1360px; margin: 0 auto; }
  .d2c-aubundle-box {
    background: #18181b;
    border-radius: 12px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }
  .d2c-aubundle-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #ffffff; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-aubundle-desc { font-size: 15px; color: #a1a1aa; line-height: 1.6; margin-bottom: 24px; }
  .d2c-aubundle-price { font-size: 20px; font-weight: 900; color: #22c55e; margin-bottom: 28px; font-family: monospace; }
  .d2c-aub-orig { font-size: 14px; color: #71717a; text-decoration: line-through; margin-left: 6px; }
  .d2c-aub-save { background: rgba(34, 197, 94, 0.15); color: #22c55e; font-size: 11px; font-weight: 900; padding: 4px 8px; border-radius: 4px; margin-left: 8px; border: 1px solid #22c55e; }
  .d2c-aub-btn {
    background: #22c55e;
    color: #000000;
    border: none;
    padding: 16px 32px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-aub-btn:hover { background: #16a34a; }
  .d2c-aubundle-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .d2c-aubi-card {
    background: #09090b;
    border: 1px solid #27272a;
    border-radius: 8px;
    overflow: hidden;
    text-align: center;
    padding: 8px;
    width: 120px;
  }
  .d2c-aubi-card img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; margin-bottom: 6px; }
  .d2c-aubi-card span { font-size: 10px; font-weight: 800; color: #ffffff; }
  .d2c-aubi-plus { font-size: 20px; font-weight: 900; color: #22c55e; }

  @media (max-width: 900px) {
    .d2c-aubundle-box { grid-template-columns: 1fr; padding: 24px; }
  }
</style>

{% schema %}
{
  "name": "Audio Bundle Box",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE COMPLETE CYBER BATTLESTATION TRIO"
    }
  ],
  "presets": [
    {
      "name": "Audio Bundle Box"
    }
  ]
}
{% endschema %}
