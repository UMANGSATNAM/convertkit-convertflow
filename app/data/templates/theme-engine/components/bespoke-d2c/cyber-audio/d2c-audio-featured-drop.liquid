{% comment %}
  D2C Cyber Audio Flagship Drop Spotlight
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<section class="d2c-audio-spotlight" id="d2c-auspot-{{ section.id }}">
  <div class="d2c-auspot-container">
    <div class="d2c-auspot-card">
      <div class="d2c-auspot-media">
        <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&q=85" alt="Immortal 1000 Flagship" />
      </div>

      <div class="d2c-auspot-content">
        <span class="d2c-au-badge">FLAGSHIP TECH DROP</span>
        <h2 class="d2c-auspot-title">{{ section.settings.title | default: "IMMORTAL 1000 ANC WIRELESS FLAGSHIP" }}</h2>
        <p class="d2c-auspot-desc">
          Engineered for esports champions and audiophiles. Features 45dB Active Hybrid Noise Cancellation, 50mm Titanium Drivers for punchy sub-bass, 70-hour battery life, and RGB dynamic breathing light rings.
        </p>

        <div class="d2c-auspot-matrix">
          <div class="d2c-aum-item"><span>DRIVER SPEC:</span> <strong>50mm Dynamic Titanium Sub-Bass Drivers</strong></div>
          <div class="d2c-aum-item"><span>ANC PERFORMANCE:</span> <strong>45dB Active Hybrid Noise Cancellation</strong></div>
          <div class="d2c-aum-item"><span>FAST CHARGE:</span> <strong>10 Mins Charge = 10 Hours Playtime</strong></div>
        </div>

        <div class="d2c-auspot-price-row">
          <span class="d2c-auspot-price">₹3,499</span>
          <span class="d2c-auspot-orig">₹7,990</span>
          <span class="d2c-auspot-tag">FLAT 56% OFF LAUNCH SPECIAL</span>
        </div>

        <div class="d2c-auspot-btn-group">
          <button class="d2c-auspot-btn">⚡ 1-CLICK FREE COD / UPI CHECKOUT &rarr;</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-auspot-{{ section.id }} {
    background: #000000;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-auspot-container { max-width: 1360px; margin: 0 auto; }
  .d2c-auspot-card {
    background: #09090b;
    border-radius: 12px;
    padding: 48px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    align-items: center;
    border: 1px solid rgba(34, 197, 94, 0.3);
    box-shadow: 0 0 50px rgba(34, 197, 94, 0.1);
  }
  .d2c-auspot-media img { width: 100%; height: 460px; object-fit: cover; border-radius: 8px; }
  .d2c-auspot-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #ffffff; line-height: 1.15; margin: 10px 0 16px; text-transform: uppercase; }
  .d2c-auspot-desc { font-size: 15px; color: #a1a1aa; line-height: 1.6; margin-bottom: 24px; }
  .d2c-auspot-matrix {
    background: #000000;
    border-radius: 6px;
    padding: 16px 20px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 1px solid #27272a;
  }
  .d2c-aum-item { display: flex; justify-content: space-between; font-size: 12px; color: #71717a; }
  .d2c-aum-item strong { color: #22c55e; }
  .d2c-auspot-price-row { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .d2c-auspot-price { font-size: 26px; font-weight: 900; color: #22c55e; font-family: monospace; }
  .d2c-auspot-orig { font-size: 14px; color: #71717a; text-decoration: line-through; }
  .d2c-auspot-tag { background: rgba(34, 197, 94, 0.15); color: #22c55e; font-size: 10px; font-weight: 900; padding: 4px 8px; border-radius: 4px; border: 1px solid #22c55e; }
  .d2c-auspot-btn {
    width: 100%;
    background: #22c55e;
    color: #000000;
    border: none;
    padding: 16px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-auspot-btn:hover { background: #16a34a; }

  @media (max-width: 900px) {
    .d2c-auspot-card { grid-template-columns: 1fr; padding: 24px; }
    .d2c-auspot-media img { height: 300px; }
  }
</style>

{% schema %}
{
  "name": "Audio Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "IMMORTAL 1000 ANC WIRELESS FLAGSHIP"
    }
  ],
  "presets": [
    {
      "name": "Audio Spotlight"
    }
  ]
}
{% endschema %}
