{% comment %}
  D2C Cyber Audio Newsletter
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<section class="d2c-audio-news" id="d2c-aunews-{{ section.id }}">
  <div class="d2c-audio-container">
    <div class="d2c-aunews-card">
      <span class="d2c-au-badge">CYBER DISPATCH PROTOCOL</span>
      <h2 class="d2c-aunews-title">{{ section.settings.title | default: "UNLOCK ₹500 OFF YOUR NEXT HARDWARE UPGRADE" }}</h2>
      <p class="d2c-aunews-desc">Join 1,000,000+ tech lovers receiving secret flash sales, unreleased firmware notes, and exclusive esports drops.</p>

      <form class="d2c-aunews-form">
        <input type="email" placeholder="Enter your email address" class="d2c-aunews-input" required />
        <button type="submit" class="d2c-aunews-btn">CLAIM ₹500 CODE &rarr;</button>
      </form>
      <div class="d2c-aunews-privacy">🔒 Zero spam. Instant discount code delivered to inbox.</div>
    </div>
  </div>
</section>

<style>
  #d2c-aunews-{{ section.id }} {
    background: #000000;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-audio-container { max-width: 860px; margin: 0 auto; }
  .d2c-aunews-card {
    background: #09090b;
    border-radius: 12px;
    padding: 48px 36px;
    text-align: center;
    border: 1px solid rgba(34, 197, 94, 0.3);
    box-shadow: 0 0 50px rgba(34, 197, 94, 0.1);
  }
  .d2c-aunews-title { font-size: clamp(26px, 3vw, 36px); font-weight: 900; color: #ffffff; margin: 10px 0 12px; text-transform: uppercase; }
  .d2c-aunews-desc { font-size: 15px; color: #a1a1aa; margin-bottom: 28px; }
  .d2c-aunews-form { display: flex; gap: 10px; max-width: 480px; margin: 0 auto 14px; }
  .d2c-aunews-input {
    flex: 1;
    background: #000000;
    border: 1px solid #27272a;
    padding: 14px 18px;
    border-radius: 4px;
    font-size: 14px;
    color: #ffffff;
    outline: none;
  }
  .d2c-aunews-input:focus { border-color: #22c55e; }
  .d2c-aunews-btn {
    background: #22c55e;
    color: #000000;
    border: none;
    padding: 14px 28px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-aunews-btn:hover { background: #16a34a; }
  .d2c-aunews-privacy { font-size: 12px; color: #71717a; }

  @media (max-width: 600px) {
    .d2c-aunews-form { flex-direction: column; }
    .d2c-aunews-card { padding: 32px 20px; }
  }
</style>

{% schema %}
{
  "name": "Audio Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "UNLOCK ₹500 OFF YOUR NEXT HARDWARE UPGRADE"
    }
  ],
  "presets": [
    {
      "name": "Audio Newsletter"
    }
  ]
}
{% endschema %}
