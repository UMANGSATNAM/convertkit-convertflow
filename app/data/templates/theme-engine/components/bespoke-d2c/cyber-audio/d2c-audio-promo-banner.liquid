{% comment %}
  D2C Cyber Audio Promo Banner
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<section class="d2c-audio-promo" id="d2c-aupromo-{{ section.id }}">
  <div class="d2c-aupromo-container">
    <div class="d2c-aupromo-card">
      <span class="d2c-au-badge">EXCLUSIVE CLAN DISCOUNT</span>
      <h2 class="d2c-aupromo-title">{{ section.settings.title | default: "FLAT ₹1,000 INSTANT OFF ON ALL HYBRID ANC HEADPHONES" }}</h2>
      <p class="d2c-aupromo-desc">Use coupon code <span class="d2c-aupromo-code">CYBER1000</span> during checkout. Includes 1-year doorstep replacement warranty and free fast shipping.</p>
      <a href="/collections/wireless-headphones" class="d2c-aupromo-btn">CLAIM ₹1,000 DISCOUNT &rarr;</a>
    </div>
  </div>
</section>

<style>
  #d2c-aupromo-{{ section.id }} {
    background: #000000;
    padding: 50px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-aupromo-container { max-width: 1360px; margin: 0 auto; }
  .d2c-aupromo-card {
    background: linear-gradient(135deg, #18181b 0%, #09090b 100%);
    border: 1px solid rgba(34, 197, 94, 0.4);
    border-radius: 12px;
    padding: 56px 36px;
    text-align: center;
    box-shadow: 0 0 50px rgba(34, 197, 94, 0.15);
  }
  .d2c-aupromo-title { font-size: clamp(26px, 3.5vw, 40px); font-weight: 900; color: #ffffff; letter-spacing: -0.5px; margin: 10px 0 14px; text-transform: uppercase; }
  .d2c-aupromo-desc { font-size: 15px; color: #a1a1aa; max-width: 600px; margin: 0 auto 28px; line-height: 1.6; }
  .d2c-aupromo-code { background: #22c55e; color: #000000; padding: 3px 8px; border-radius: 4px; font-weight: 900; font-family: monospace; }
  .d2c-aupromo-btn {
    display: inline-block;
    background: #22c55e;
    color: #000000;
    padding: 14px 32px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
  }
  .d2c-aupromo-btn:hover { background: #16a34a; }
</style>

{% schema %}
{
  "name": "Audio Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FLAT ₹1,000 INSTANT OFF ON ALL HYBRID ANC HEADPHONES"
    }
  ],
  "presets": [
    {
      "name": "Audio Promo Banner"
    }
  ]
}
{% endschema %}
