{% comment %}
  D2C Cyber Audio Verified Gamer Reviews
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<section class="d2c-audio-reviews" id="d2c-aurev-{{ section.id }}">
  <div class="d2c-audio-container">
    <div class="d2c-ausec-header">
      <span class="d2c-au-badge">VERIFIED GAMER FEEDBACK</span>
      <h2 class="d2c-au-title">{{ section.settings.title | default: "RATED 4.8 / 5 BY OVER 500,000+ AUDIOPHILES" }}</h2>
    </div>

    <div class="d2c-aurev-grid">
      <div class="d2c-aurev-card">
        <div class="d2c-aurev-stars">★★★★★</div>
        <p class="d2c-aurev-quote">"The 45dB ANC completely cuts out AC hum, street traffic, and metro rattle. The bass on the Immortal 1000 vibrates your jaw without muddying high vocals. Unbeatable at this price."</p>
        <div class="d2c-aurev-author">
          <span class="d2c-aurev-name">Aman Sharma</span>
          <span class="d2c-aurev-loc">Delhi • Immortal 1000 ANC</span>
        </div>
      </div>

      <div class="d2c-aurev-card">
        <div class="d2c-aurev-stars">★★★★★</div>
        <p class="d2c-aurev-quote">"Beast mode latency is genuinely 40ms. Playing BGMI & Valorant with these TWS earbuds feels identical to wired studio headphones. Footstep directionality is razor sharp."</p>
        <div class="d2c-aurev-author">
          <span class="d2c-aurev-name">Tanmay Bhattacharya</span>
          <span class="d2c-aurev-loc">Pune • Cyber Pro Gaming TWS</span>
        </div>
      </div>

      <div class="d2c-aurev-card">
        <div class="d2c-aurev-stars">★★★★★</div>
        <p class="d2c-aurev-quote">"The AMOLED screen on the Wave Force watch is so bright under direct harsh sunlight. Bluetooth calling speaker is crisp and the rugged shock casing handled a brutal gym drop."</p>
        <div class="d2c-aurev-author">
          <span class="d2c-aurev-name">Harish Rao</span>
          <span class="d2c-aurev-loc">Hyderabad • Wave AMOLED Watch</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-aurev-{{ section.id }} {
    background: #000000;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-audio-container { max-width: 1360px; margin: 0 auto; }
  .d2c-aurev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .d2c-aurev-card {
    background: #09090b;
    border: 1px solid #27272a;
    border-radius: 8px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .d2c-aurev-stars { color: #22c55e; font-size: 16px; margin-bottom: 12px; }
  .d2c-aurev-quote { font-size: 14px; color: #a1a1aa; line-height: 1.6; margin-bottom: 20px; }
  .d2c-aurev-name { font-size: 15px; font-weight: 900; color: #ffffff; display: block; margin-bottom: 2px; }
  .d2c-aurev-loc { font-size: 11px; color: #22c55e; }

  @media (max-width: 900px) { .d2c-aurev-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Audio Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "RATED 4.8 / 5 BY OVER 500,000+ AUDIOPHILES"
    }
  ],
  "presets": [
    {
      "name": "Audio Reviews"
    }
  ]
}
{% endschema %}
