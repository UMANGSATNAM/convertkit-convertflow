{% comment %}
  D2C Cyber Audio Welcome Drop Modal
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<div class="d2c-audio-popup" id="d2c-aupop-{{ section.id }}" style="display: none;">
  <div class="d2c-aupop-overlay">
    <div class="d2c-aupop-card">
      <button class="d2c-aupop-close" onclick="document.getElementById('d2c-aupop-{{ section.id }}').style.display='none';">&times;</button>
      <span class="d2c-au-badge">CYBER LOOT DROP</span>
      <h3 class="d2c-aupop-title">WIN FREE GAMING TWS OR FLAT ₹500 INSTANT CASH</h3>
      <p class="d2c-aupop-desc">Enter your mobile number to unlock your instant secret loot coupon code.</p>

      <form class="d2c-aupop-form">
        <input type="text" placeholder="Your Gamer Tag / Name" class="d2c-aupop-input" required />
        <input type="tel" placeholder="WhatsApp Number for Loot Drop" class="d2c-aupop-input" required />
        <button type="submit" class="d2c-aupop-btn">CLAIM MY LOOT CRATE &rarr;</button>
      </form>
    </div>
  </div>
</div>

<style>
  .d2c-aupop-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-aupop-card {
    background: #09090b;
    border-radius: 12px;
    padding: 44px 32px;
    max-width: 440px;
    width: 100%;
    text-align: center;
    position: relative;
    border: 2px solid #22c55e;
    box-shadow: 0 0 50px rgba(34, 197, 94, 0.3);
  }
  .d2c-aupop-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: #71717a;
    font-size: 22px;
    cursor: pointer;
  }
  .d2c-aupop-title { font-size: 18px; font-weight: 900; color: #ffffff; margin: 8px 0 10px; text-transform: uppercase; line-height: 1.25; }
  .d2c-aupop-desc { font-size: 14px; color: #a1a1aa; margin-bottom: 22px; }
  .d2c-aupop-form { display: flex; flex-direction: column; gap: 10px; }
  .d2c-aupop-input {
    background: #000000;
    border: 1px solid #27272a;
    padding: 12px 16px;
    border-radius: 4px;
    font-size: 14px;
    color: #ffffff;
    outline: none;
  }
  .d2c-aupop-input:focus { border-color: #22c55e; }
  .d2c-aupop-btn {
    background: #22c55e;
    color: #000000;
    border: none;
    padding: 14px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
    margin-top: 6px;
  }
  .d2c-aupop-btn:hover { background: #16a34a; }
</style>

{% schema %}
{
  "name": "Audio Loot Drop",
  "settings": [],
  "presets": [
    {
      "name": "Audio Loot Drop"
    }
  ]
}
{% endschema %}
