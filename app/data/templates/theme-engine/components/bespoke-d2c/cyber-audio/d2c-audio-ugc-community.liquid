{% comment %}
  D2C Cyber Audio Gamer Community
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<section class="d2c-audio-ugc" id="d2c-auugc-{{ section.id }}">
  <div class="d2c-auugc-container">
    <div class="d2c-ausec-header">
      <span class="d2c-au-badge">#CYBERCLANINDIA</span>
      <h2 class="d2c-au-title">{{ section.settings.title | default: "POWERING 10,000,000+ STREAMERS & GAMERS" }}</h2>
    </div>

    <div class="d2c-auugc-grid">
      <div class="d2c-auugc-tile"><img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&q=80" alt="Gamer Setup 1" /><span>@mortal_esports · Immortal 1000</span></div>
      <div class="d2c-auugc-tile"><img src="https://images.unsplash.com/photo-1590658268037-6bf12165a8df?w=600&q=80" alt="Gamer Setup 2" /><span>@scout_op · Cyber Pro TWS</span></div>
      <div class="d2c-auugc-tile"><img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&q=80" alt="Gamer Setup 3" /><span>@hydra_dynamo · Wave AMOLED</span></div>
      <div class="d2c-auugc-tile"><img src="https://images.unsplash.com/photo-1545454675-3531b543be5d?w=600&q=80" alt="Gamer Setup 4" /><span>@gamerfleet · 120W Soundbar</span></div>
    </div>
  </div>
</section>

<style>
  #d2c-auugc-{{ section.id }} {
    background: #09090b;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-auugc-container { max-width: 1360px; margin: 0 auto; }
  .d2c-auugc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .d2c-auugc-tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    background: #18181b;
    border: 1px solid #27272a;
  }
  .d2c-auugc-tile img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-auugc-tile span {
    position: absolute;
    bottom: 8px;
    left: 8px;
    right: 8px;
    background: rgba(0,0,0,0.85);
    color: #22c55e;
    font-size: 11px;
    font-weight: 800;
    padding: 6px;
    text-align: center;
    border-radius: 4px;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  @media (max-width: 900px) { .d2c-auugc-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

{% schema %}
{
  "name": "Audio Community",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "POWERING 10,000,000+ STREAMERS & GAMERS"
    }
  ],
  "presets": [
    {
      "name": "Audio Community"
    }
  ]
}
{% endschema %}
