{% comment %}
  D2C Cyber Audio Ticker Ribbon
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<div class="d2c-audio-ribbon" id="d2c-auribbon-{{ section.id }}">
  <div class="d2c-auribbon-track">
    <div class="d2c-auribbon-content">
      <span class="d2c-auribbon-item">⚡ 45DB HYBRID ACTIVE NOISE CANCELLATION</span>
      <span class="d2c-auribbon-sep">///</span>
      <span class="d2c-auribbon-item">70-HOUR PLAYTIME WITH ASAP™ FAST CHARGE</span>
      <span class="d2c-auribbon-sep">///</span>
      <span class="d2c-auribbon-item">BEAST™ MODE 40MS ULTRA LOW LATENCY</span>
      <span class="d2c-auribbon-sep">///</span>
      <span class="d2c-auribbon-item">IPX7 WATER & SWEAT RESISTANCE</span>
      <span class="d2c-auribbon-sep">///</span>
      <span class="d2c-auribbon-item">⚡ 45DB HYBRID ACTIVE NOISE CANCELLATION</span>
      <span class="d2c-auribbon-sep">///</span>
      <span class="d2c-auribbon-item">70-HOUR PLAYTIME WITH ASAP™ FAST CHARGE</span>
      <span class="d2c-auribbon-sep">///</span>
      <span class="d2c-auribbon-item">BEAST™ MODE 40MS ULTRA LOW LATENCY</span>
      <span class="d2c-auribbon-sep">///</span>
      <span class="d2c-auribbon-item">IPX7 WATER & SWEAT RESISTANCE</span>
    </div>
  </div>
</div>

<style>
  #d2c-auribbon-{{ section.id }} {
    background: #22c55e;
    color: #000000;
    overflow: hidden;
    white-space: nowrap;
    padding: 12px 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .d2c-auribbon-track { display: flex; overflow: hidden; }
  .d2c-auribbon-content {
    display: flex;
    align-items: center;
    gap: 32px;
    animation: d2c-auribbon-scroll 20s linear infinite;
  }
  .d2c-auribbon-sep { font-size: 14px; color: rgba(0,0,0,0.5); }
  @keyframes d2c-auribbon-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
</style>

{% schema %}
{
  "name": "Audio Ribbon",
  "settings": [],
  "presets": [
    {
      "name": "Audio Ribbon"
    }
  ]
}
{% endschema %}
