{% comment %}
  D2C Cyber Audio Tech Press Mentions
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<section class="d2c-audio-press" id="d2c-aupress-{{ section.id }}">
  <div class="d2c-audio-container">
    <span class="d2c-aupress-label">VERIFIED BY TECH EDITORS</span>
    <div class="d2c-aupress-logos">
      <span class="d2c-auplogo">TECHRADAR INDIA</span>
      <span class="d2c-auplogo">DIGIT.IN</span>
      <span class="d2c-auplogo">BEEBOM</span>
      <span class="d2c-auplogo">GADGETS 360</span>
      <span class="d2c-auplogo">INC42 TECH</span>
    </div>
  </div>
</section>

<style>
  #d2c-aupress-{{ section.id }} {
    background: #09090b;
    padding: 30px 32px;
    border-bottom: 1px solid #27272a;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-audio-container {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .d2c-aupress-label { font-size: 11px; font-weight: 800; color: #22c55e; letter-spacing: 1px; text-transform: uppercase; }
  .d2c-aupress-logos { display: flex; gap: 36px; align-items: center; flex-wrap: wrap; }
  .d2c-auplogo { font-size: 14px; font-weight: 900; color: #a1a1aa; letter-spacing: 0.5px; opacity: 0.9; }

  @media (max-width: 768px) {
    .d2c-audio-container { justify-content: center; text-align: center; }
    .d2c-aupress-logos { justify-content: center; gap: 20px; }
  }
</style>

{% schema %}
{
  "name": "Audio Press Strip",
  "settings": [],
  "presets": [
    {
      "name": "Audio Press Strip"
    }
  ]
}
{% endschema %}
