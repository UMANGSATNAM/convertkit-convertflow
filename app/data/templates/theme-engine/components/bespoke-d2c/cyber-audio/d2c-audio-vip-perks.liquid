{% comment %}
  D2C Cyber Audio Clan Perks
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<section class="d2c-audio-vip" id="d2c-auvip-{{ section.id }}">
  <div class="d2c-audio-container">
    <div class="d2c-auvip-box">
      <div class="d2c-ausec-header">
        <span class="d2c-au-badge">CYBER CLAN REWARDS</span>
        <h2 class="d2c-au-title">{{ section.settings.title | default: "JOIN THE CYBER AUDIO PRO CLAN" }}</h2>
        <p class="d2c-auvip-desc">Unlock 48-hour priority access on limited edition drops, free annual ear-cushion refreshes, and hardware trade-in bonuses.</p>
      </div>

      <div class="d2c-auvip-grid">
        <div class="d2c-auvip-card">
          <div class="d2c-auv-tag">TIER 1 // CADET</div>
          <div class="d2c-auv-title">10% CLAN CASHBACK</div>
          <p class="d2c-auv-desc">Earn reward credits on every hardware purchase to redeem against cables, cases & straps.</p>
        </div>

        <div class="d2c-auvip-card popular">
          <span class="d2c-auv-pill">RECOMMENDED</span>
          <div class="d2c-auv-tag">TIER 2 // COMMANDER</div>
          <div class="d2c-auv-title">FREE EAR-CUSHION REFRESH</div>
          <p class="d2c-auv-desc">Get 1 free set of memory foam cooling-gel ear cushions shipped to your door every year.</p>
        </div>

        <div class="d2c-auvip-card">
          <div class="d2c-auv-tag">TIER 3 // CYBER WARLORD</div>
          <div class="d2c-auv-title">50% TRADE-IN UPGRADE</div>
          <p class="d2c-auv-desc">Trade in any old headset for up to 50% credit toward our latest flagship ANC gear.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-auvip-{{ section.id }} {
    background: #09090b;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-audio-container { max-width: 1360px; margin: 0 auto; }
  .d2c-auvip-box {
    background: #18181b;
    border-radius: 12px;
    padding: 48px 36px;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }
  .d2c-auvip-desc { font-size: 15px; color: #a1a1aa; max-width: 540px; margin: 8px auto 0; text-align: center; }
  .d2c-auvip-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .d2c-auvip-card {
    background: #09090b;
    border: 1px solid #27272a;
    border-radius: 8px;
    padding: 32px 24px;
    text-align: center;
    position: relative;
  }
  .d2c-auvip-card.popular { border: 2px solid #22c55e; }
  .d2c-auv-pill {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #22c55e;
    color: #000000;
    font-size: 9px;
    font-weight: 900;
    padding: 3px 10px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }
  .d2c-auv-tag { font-size: 10px; font-weight: 800; color: #22c55e; letter-spacing: 1px; margin-bottom: 8px; font-family: monospace; }
  .d2c-auv-title { font-size: 14px; font-weight: 900; color: #ffffff; margin-bottom: 10px; }
  .d2c-auv-desc { font-size: 13px; color: #a1a1aa; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-auvip-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Audio VIP Perks",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "JOIN THE CYBER AUDIO PRO CLAN"
    }
  ],
  "presets": [
    {
      "name": "Audio VIP Perks"
    }
  ]
}
{% endschema %}
