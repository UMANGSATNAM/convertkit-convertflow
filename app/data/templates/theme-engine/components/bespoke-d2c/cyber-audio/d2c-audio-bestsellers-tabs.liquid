        </div>
      </div>

      <!-- Item 4 -->
      <div class="d2c-auprod-card">
        <div class="d2c-auprod-thumb">
          <span class="d2c-auprod-pill">120W DOLBY AUDIO</span>
          <img src="https://images.unsplash.com/photo-1545454675-3531b543be5d?w=600&q=80" alt="Cyber Soundbar" />
