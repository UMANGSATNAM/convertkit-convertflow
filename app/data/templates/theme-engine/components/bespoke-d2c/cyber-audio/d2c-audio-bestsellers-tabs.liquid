          <button class="d2c-auatc-btn">⚡ 1-CLICK INSTANT ORDER</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-aubest-{{ section.id }} {
    background: #000000;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-aubest-container { max-width: 1360px; margin: 0 auto; }
  .d2c-auprod-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .d2c-auprod-card {
    background: #09090b;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #27272a;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .d2c-auprod-thumb { position: relative; aspect-ratio: 1; overflow: hidden; background: #18181b; }
  .d2c-auprod-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .d2c-auprod-pill {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #22c55e;
    color: #000000;
    font-size: 9px;
    font-weight: 900;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }
  .d2c-auprod-body { padding: 18px; display: flex; flex-direction: column; flex-grow: 1; justify-content: space-between; }
  .d2c-auprod-tech { font-size: 10px; font-weight: 800; color: #22c55e; letter-spacing: 0.5px; margin-bottom: 4px; }
  .d2c-auprod-title { font-size: 14px; font-weight: 800; color: #ffffff; margin-bottom: 10px; }
  .d2c-auprod-price { font-size: 16px; font-weight: 900; color: #ffffff; margin-bottom: 14px; font-family: monospace; }
  .d2c-auprod-orig { font-size: 12px; color: #71717a; text-decoration: line-through; margin-left: 6px; }
  .d2c-auatc-btn {
    width: 100%;
    background: #22c55e;
    color: #000000;
    border: none;
    padding: 12px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .d2c-auatc-btn:hover { background: #16a34a; }

  @media (max-width: 1024px) { .d2c-auprod-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-auprod-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } .d2c-auprod-body { padding: 12px; } }
</style>

{% schema %}
{
  "name": "Audio Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HEAVY BASS & GAMING BESTSELLERS"
    }
  ],
  "presets": [
    {
      "name": "Audio Bestsellers"
    }
  ]
}
{% endschema %}
