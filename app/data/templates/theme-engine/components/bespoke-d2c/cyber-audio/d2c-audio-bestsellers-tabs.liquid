        </div>
      </div>

      <!-- Item 3 -->
      <div class="d2c-auprod-card">
        <div class="d2c-auprod-thumb">
          <span class="d2c-auprod-pill">1.96" AMOLED SCREEN</span>
          <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&q=80" alt="Cyber Smartwatch" />
        </div>
