{% comment %}
  D2C Cyber Audio Footer
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<footer class="d2c-audio-footer" id="d2c-aufoot-{{ section.id }}">
  <div class="d2c-audio-container">
    <div class="d2c-aufoot-top">
      <div class="d2c-aufoot-brand">
        <h3 class="d2c-aufoot-logo">{{ section.settings.brand_name | default: "CYBER AUDIO TECH" }}</h3>
        <p class="d2c-aufoot-desc">Pioneering heavy bass acoustics, active hybrid noise cancellation, and ultra-low latency esports audio for next-gen India.</p>
        <div class="d2c-aufoot-badge">⚡ 100% DESIGNED FOR PRO GAMERS & AUDIOPHILES</div>
      </div>

      <div class="d2c-aufoot-col">
        <h4 class="d2c-aucol-title">HARDWARE GEAR</h4>
        <ul class="d2c-aucol-links">
          <li><a href="/collections/wireless-headphones">ANC Wireless Headphones</a></li>
          <li><a href="/collections/tws-earbuds">Gaming TWS Earbuds</a></li>
          <li><a href="/collections/smartwatches">AMOLED Smartwatches</a></li>
          <li><a href="/collections/soundbars">Dolby Soundbars</a></li>
          <li><a href="/collections/accessories">Charging Cables & Cases</a></li>
        </ul>
      </div>

      <div class="d2c-aufoot-col">
        <h4 class="d2c-aucol-title">SUPPORT & RIG</h4>
        <ul class="d2c-aucol-links">
          <li><a href="/pages/track-order">Track Courier Delivery</a></li>
          <li><a href="/pages/warranty">Register 1-Year Warranty</a></li>
          <li><a href="/pages/firmware">Download Companion App</a></li>
          <li><a href="/pages/stores">Find Offline Experience Store</a></li>
          <li><a href="/pages/contact">WhatsApp Tech Support (24/7)</a></li>
        </ul>
      </div>

      <div class="d2c-aufoot-col">
        <h4 class="d2c-aucol-title">CLAN PROMISE</h4>
        <p class="d2c-aufoot-sub-desc">1-year free doorstep replacement, 7-day hassle-free returns, and 24-hour express courier dispatch across all 24,000+ Indian pincodes.</p>
      </div>
    </div>

    <div class="d2c-aufoot-bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: "CYBER AUDIO TECH ELECTRONICS PVT. LTD." }}. ALL RIGHTS RESERVED.</div>
      <div class="d2c-aufoot-legal">
        <a href="/policies/privacy-policy">Privacy Disclosure</a>
        <a href="/policies/terms-of-service">Terms of Operation</a>
        <a href="/policies/shipping-policy">Shipping & COD Rules</a>
      </div>
    </div>
  </div>
</footer>

<style>
  #d2c-aufoot-{{ section.id }} {
    background: #000000;
    color: #a1a1aa;
    padding: 70px 32px 30px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
    border-top: 1px solid rgba(34, 197, 94, 0.3);
  }
  .d2c-audio-container { max-width: 1360px; margin: 0 auto; }
  .d2c-aufoot-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .d2c-aufoot-logo { font-size: 20px; font-weight: 900; color: #ffffff; letter-spacing: 1.5px; margin-bottom: 14px; text-transform: uppercase; }
  .d2c-aufoot-desc { font-size: 13px; color: #71717a; line-height: 1.6; margin-bottom: 16px; max-width: 320px; }
  .d2c-aufoot-badge { font-size: 11px; font-weight: 800; color: #22c55e; }
  .d2c-aucol-title { font-size: 12px; font-weight: 900; color: #ffffff; letter-spacing: 1px; margin-bottom: 16px; text-transform: uppercase; }
  .d2c-aucol-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .d2c-aucol-links a { color: #a1a1aa; text-decoration: none; font-size: 13px; transition: color 0.15s ease; }
  .d2c-aucol-links a:hover { color: #22c55e; }
  .d2c-aufoot-sub-desc { font-size: 13px; line-height: 1.6; opacity: 0.85; }
  .d2c-aufoot-bottom {
    border-top: 1px solid #27272a;
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
  }
  .d2c-aufoot-legal { display: flex; gap: 20px; }
  .d2c-aufoot-legal a { color: inherit; text-decoration: none; }
  .d2c-aufoot-legal a:hover { color: #ffffff; }

  @media (max-width: 1024px) { .d2c-aufoot-top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) {
    .d2c-aufoot-top { grid-template-columns: 1fr; }
    .d2c-aufoot-bottom { flex-direction: column; gap: 12px; text-align: center; }
  }
</style>

{% schema %}
{
  "name": "Audio Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "CYBER AUDIO TECH"
    }
  ],
  "presets": [
    {
      "name": "Audio Footer"
    }
  ]
}
{% endschema %}
