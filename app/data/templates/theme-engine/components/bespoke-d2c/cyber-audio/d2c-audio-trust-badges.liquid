{% comment %}
  D2C Cyber Audio Trust Badges
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<section class="d2c-audio-trust" id="d2c-autrust-{{ section.id }}">
  <div class="d2c-audio-container">
    <div class="d2c-autrust-grid">
      <div class="d2c-autrust-item">
        <div class="d2c-autrust-icon">🛡️</div>
        <h4 class="d2c-autrust-title">1-YEAR DOORSTEP REPLACEMENT</h4>
        <p class="d2c-autrust-desc">Hassle-free replacement. If an issue occurs, our courier picks up and delivers a fresh unit at your door.</p>
      </div>

      <div class="d2c-autrust-item">
        <div class="d2c-autrust-icon">⚡</div>
        <h4 class="d2c-autrust-title">24-HOUR DISPATCH</h4>
        <p class="d2c-autrust-desc">Orders packed in priority bubble armor and dispatched within 24 hours via express air couriers.</p>
      </div>

      <div class="d2c-autrust-item">
        <div class="d2c-autrust-icon">🔒</div>
        <h4 class="d2c-autrust-title">100% GENUINE HARDWARE</h4>
        <p class="d2c-autrust-desc">Direct factory authentic hardware with unique QR verification seal on every box.</p>
      </div>

      <div class="d2c-autrust-item">
        <div class="d2c-autrust-icon">🚚</div>
        <h4 class="d2c-autrust-title">FREE CASH ON DELIVERY</h4>
        <p class="d2c-autrust-desc">Pay at your doorstep with Cash or UPI across 24,000+ Indian pincodes.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-autrust-{{ section.id }} {
    background: #000000;
    color: #ffffff;
    padding: 50px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-audio-container { max-width: 1360px; margin: 0 auto; }
  .d2c-autrust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }
  .d2c-autrust-item {
    background: #09090b;
    border: 1px solid #27272a;
    border-radius: 8px;
    padding: 28px 18px;
  }
  .d2c-autrust-icon { font-size: 26px; margin-bottom: 10px; }
  .d2c-autrust-title { font-size: 12px; font-weight: 900; color: #22c55e; letter-spacing: 0.5px; margin-bottom: 6px; text-transform: uppercase; }
  .d2c-autrust-desc { font-size: 12px; color: #a1a1aa; line-height: 1.5; }

  @media (max-width: 900px) { .d2c-autrust-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .d2c-autrust-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Audio Trust Badges",
  "settings": [],
  "presets": [
    {
      "name": "Audio Trust Badges"
    }
  ]
}
{% endschema %}
