{% comment %}
  D2C Cyber Audio Action Video Reels
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<section class="d2c-audio-reels" id="d2c-aureels-{{ section.id }}">
  <div class="d2c-aureels-container">
    <div class="d2c-ausec-header">
      <span class="d2c-au-badge">CLAN TRIALS IN ACTION</span>
      <h2 class="d2c-au-title">{{ section.settings.title | default: "WATCH EXTREME BASS & SWEAT PROOF TESTS" }}</h2>
    </div>

    <div class="d2c-aureels-grid">
      <div class="d2c-aureel-card">
        <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&q=80" alt="Bass Drop Test" />
        <div class="d2c-aureel-overlay">
          <span class="d2c-aureel-tag">50MM TITANIUM DRIVER BASS</span>
          <h4 class="d2c-aureel-name">Extreme Bass Drop Soundwave Reaction</h4>
          <span class="d2c-aureel-pill">Immortal 1000 · ₹3,499</span>
        </div>
      </div>

      <div class="d2c-aureel-card">
        <img src="https://images.unsplash.com/photo-1590658268037-6bf12165a8df?w=600&q=80" alt="Water Submersion" />
        <div class="d2c-aureel-overlay">
          <span class="d2c-aureel-tag">IPX7 WATERPROOF TRIAL</span>
          <h4 class="d2c-aureel-name">Submerged in Ice Water for 30 Mins</h4>
          <span class="d2c-aureel-pill">Gaming TWS · ₹1,799</span>
        </div>
      </div>

      <div class="d2c-aureel-card">
        <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&q=80" alt="Gym Workout" />
        <div class="d2c-aureel-overlay">
          <span class="d2c-aureel-tag">HEAVY GYM WORKOUT</span>
          <h4 class="d2c-aureel-name">100kg Deadlift & Zero Fall-out Grip</h4>
          <span class="d2c-aureel-pill">AMOLED Watch · ₹2,499</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-aureels-{{ section.id }} {
    background: #09090b;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-aureels-container { max-width: 1360px; margin: 0 auto; }
  .d2c-aureels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .d2c-aureel-card {
    position: relative;
    aspect-ratio: 9/16;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #27272a;
    cursor: pointer;
    background: #18181b;
  }
  .d2c-aureel-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .d2c-aureel-card:hover img { transform: scale(1.05); }
  .d2c-aureel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: #ffffff;
  }
  .d2c-aureel-tag { font-size: 10px; font-weight: 800; color: #22c55e; letter-spacing: 1px; margin-bottom: 4px; }
  .d2c-aureel-name { font-size: 15px; font-weight: 900; margin-bottom: 12px; }
  .d2c-aureel-pill {
    background: #22c55e;
    color: #000000;
    font-size: 11px;
    font-weight: 900;
    padding: 6px 14px;
    border-radius: 4px;
    display: inline-block;
    align-self: flex-start;
  }

  @media (max-width: 900px) { .d2c-aureels-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Audio Reels",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "WATCH EXTREME BASS & SWEAT PROOF TESTS"
    }
  ],
  "presets": [
    {
      "name": "Audio Reels"
    }
  ]
}
{% endschema %}
