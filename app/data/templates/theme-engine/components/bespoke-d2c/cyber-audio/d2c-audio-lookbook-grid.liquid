{% comment %}
  D2C Cyber Audio Lookbook
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<section class="d2c-audio-lookbook" id="d2c-aulb-{{ section.id }}">
  <div class="d2c-aulb-container">
    <div class="d2c-ausec-header">
      <span class="d2c-au-badge">AUDIO PROTOCOLS</span>
      <h2 class="d2c-au-title">{{ section.settings.title | default: "GEAR DESIGNED FOR INTENSE SCENARIOS" }}</h2>
    </div>

    <div class="d2c-aulb-grid">
      <div class="d2c-aulb-card large">
        <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&q=80" alt="Esports Gaming" />
        <div class="d2c-aulb-overlay">
          <span class="d2c-aulb-tag">ESPORTS RIG</span>
          <h3 class="d2c-aulb-name">40MS ZERO DELAY FOOTSTEP AUDIO</h3>
          <span class="d2c-aulb-link">EXPLORE GAMING GEAR &rarr;</span>
        </div>
      </div>

      <div class="d2c-aulb-card">
        <img src="https://images.unsplash.com/photo-1590658268037-6bf12165a8df?w=600&q=80" alt="Gym Workout" />
        <div class="d2c-aulb-overlay">
          <span class="d2c-aulb-tag">GYM & HEAVY SWEAT</span>
          <h3 class="d2c-aulb-name">IPX7 WATERPROOF TWS</h3>
          <span class="d2c-aulb-link">EXPLORE &rarr;</span>
        </div>
      </div>

      <div class="d2c-aulb-card">
        <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&q=80" alt="Commute & Work" />
        <div class="d2c-aulb-overlay">
          <span class="d2c-aulb-tag">FLIGHT & METRO ANC</span>
          <h3 class="d2c-aulb-name">45DB CABIN SILENCE</h3>
          <span class="d2c-aulb-link">EXPLORE &rarr;</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #d2c-aulb-{{ section.id }} {
    background: #09090b;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-aulb-container { max-width: 1360px; margin: 0 auto; }
  .d2c-aulb-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 24px;
  }
  .d2c-aulb-card {
    position: relative;
    height: 480px;
    border-radius: 12px;
    overflow: hidden;
    background: #18181b;
    border: 1px solid #27272a;
  }
  .d2c-aulb-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .d2c-aulb-card:hover img { transform: scale(1.04); }
  .d2c-aulb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px;
    color: #ffffff;
  }
  .d2c-aulb-tag { font-size: 10px; font-weight: 800; color: #22c55e; letter-spacing: 1px; margin-bottom: 4px; }
  .d2c-aulb-name { font-size: 16px; font-weight: 900; margin-bottom: 8px; }
  .d2c-aulb-link { font-size: 11px; font-weight: 800; color: #22c55e; }

  @media (max-width: 900px) {
    .d2c-aulb-grid { grid-template-columns: 1fr; }
    .d2c-aulb-card { height: 340px; }
  }
</style>

{% schema %}
{
  "name": "Audio Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "GEAR DESIGNED FOR INTENSE SCENARIOS"
    }
  ],
  "presets": [
    {
      "name": "Audio Lookbook"
    }
  ]
}
{% endschema %}
