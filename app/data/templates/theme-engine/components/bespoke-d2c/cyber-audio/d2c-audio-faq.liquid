{% comment %}
  D2C Cyber Audio FAQ
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<section class="d2c-audio-faq" id="d2c-aufaq-{{ section.id }}">
  <div class="d2c-audio-container">
    <div class="d2c-ausec-header">
      <span class="d2c-au-badge">HARDWARE & SHIPPING QUERIES</span>
      <h2 class="d2c-au-title">{{ section.settings.title | default: "FREQUENTLY ASKED QUESTIONS" }}</h2>
    </div>

    <div class="d2c-aufaq-list">
      <details class="d2c-aufaq-item" open>
        <summary class="d2c-aufaq-q">
          <span>How does the 1-Year Doorstep Replacement Warranty work?</span>
          <span class="d2c-aufaq-icon">+</span>
        </summary>
        <div class="d2c-aufaq-a">
          If your headphones or earbuds develop any hardware defect within 1 year, raise a request on our WhatsApp support. Our courier will pick up the device from your home and deliver a fresh brand-new replacement at zero cost.
        </div>
      </details>

      <details class="d2c-aufaq-item">
        <summary class="d2c-aufaq-q">
          <span>Is Beast™ 40ms Low Latency compatible with all smartphones & PCs?</span>
          <span class="d2c-aufaq-icon">+</span>
        </summary>
        <div class="d2c-aufaq-a">
          Yes! Beast™ Mode works seamlessly across Android, iOS, Windows, and Mac over Bluetooth 5.3. Simply triple-tap the earbud or press the dedicated gaming button on the headphones to activate.
        </div>
      </details>

      <details class="d2c-aufaq-item">
        <summary class="d2c-aufaq-q">
          <span>How long does ASAP™ Fast Charge take to give full battery?</span>
          <span class="d2c-aufaq-icon">+</span>
        </summary>
        <div class="d2c-aufaq-a">
          A brief 10-minute quick charge delivers up to 10 hours of uninterrupted playtime. A full 0 to 100% charge takes just 45 minutes using any standard Type-C charger.
        </div>
      </details>

      <details class="d2c-aufaq-item">
        <summary class="d2c-aufaq-q">
          <span>Can I inspect the package before paying Cash on Delivery?</span>
          <span class="d2c-aufaq-icon">+</span>
        </summary>
        <div class="d2c-aufaq-a">
          Yes, open delivery with doorstep OTP verification is enabled across major courier networks for total peace of mind.
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  #d2c-aufaq-{{ section.id }} {
    background: #000000;
    padding: 70px 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
  }
  .d2c-audio-container { max-width: 860px; margin: 0 auto; }
  .d2c-aufaq-list { display: flex; flex-direction: column; gap: 12px; margin-top: 36px; }
  .d2c-aufaq-item {
    background: #09090b;
    border: 1px solid #27272a;
    border-radius: 8px;
    overflow: hidden;
  }
  .d2c-aufaq-q {
    padding: 20px 24px;
    font-size: 15px;
    font-weight: 800;
    color: #ffffff;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }
  .d2c-aufaq-q::-webkit-details-marker { display: none; }
  .d2c-aufaq-icon { font-size: 20px; font-weight: 900; color: #22c55e; }
  details[open] .d2c-aufaq-icon { transform: rotate(45deg); display: inline-block; }
  .d2c-aufaq-a {
    padding: 0 24px 20px;
    font-size: 14px;
    color: #a1a1aa;
    line-height: 1.6;
  }
</style>

{% schema %}
{
  "name": "Audio FAQ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    }
  ],
  "presets": [
    {
      "name": "Audio FAQ"
    }
  ]
}
{% endschema %}
