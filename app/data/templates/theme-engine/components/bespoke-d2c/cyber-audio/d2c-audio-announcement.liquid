{% comment %}
  D2C Cyber Audio Announcement Bar
  Theme: boAt / Noise Cyber Dark Audio & Tech
{% endcomment %}

<div class="d2c-audio-announcement" id="d2c-auann-{{ section.id }}">
  <div class="d2c-auann-inner">
    <span class="d2c-auann-pulse">🔴 LIVE DROP</span>
    <span class="d2c-auann-text">{{ section.settings.text | default: "CYBER BASS FEST // EXTRA ₹500 OFF ON ANC HEADPHONES • USE CODE: CYBERBASS" }}</span>
    <span class="d2c-auann-sep">|</span>
    <span class="d2c-auann-sub">40MS BEAST™ GAMING LATENCY</span>
  </div>
</div>

<style>
  #d2c-auann-{{ section.id }} {
    background: #000000;
    color: #ffffff;
    padding: 10px 16px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-align: center;
    border-bottom: 1px solid #22c55e;
  }
  .d2c-auann-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }
  .d2c-auann-pulse {
    color: #ef4444;
    font-size: 10px;
    font-weight: 900;
    animation: d2c-au-blink 1s ease infinite alternate;
  }
  .d2c-auann-sub { color: #22c55e; font-weight: 900; }
  .d2c-auann-sep { opacity: 0.4; }
  @keyframes d2c-au-blink { from { opacity: 0.4; } to { opacity: 1; } }
  @media (max-width: 768px) { #d2c-auann-{{ section.id }} { font-size: 10px; padding: 8px 12px; } .d2c-auann-sub { display: none; } }
</style>

{% schema %}
{
  "name": "Audio Announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "CYBER BASS FEST // EXTRA ₹500 OFF ON ANC HEADPHONES • USE CODE: CYBERBASS"
    }
  ],
  "presets": [
    {
      "name": "Audio Announcement"
    }
  ]
}
{% endschema %}
