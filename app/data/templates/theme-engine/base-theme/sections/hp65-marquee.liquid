{%- style -%}#shopify-section-{{ section.id }}{background:#E11D48;color:#fff;padding:10px 0;overflow:hidden;white-space:nowrap}.hp65-mq{display:flex;gap:36px;animation:hp65m 18s linear infinite}@keyframes hp65m{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}.hp65-mq span{font-size:12px;letter-spacing:2px;text-transform:uppercase;font-weight:700}{%- endstyle -%}<div class="hp65-mq">{% for i in (1..2) %}{% for block in section.blocks %}<span>{{block.settings.text}} •</span>{% endfor %}{% if section.blocks.size==0 %}<span>STREETWEAR • FREE SHIPPING • v65 •</span>{% endif %}{% endfor %}</div>{% schema %}{"name":"HP65 Marquee","settings":[],"blocks":[{"type":"item","name":"Item","settings":[{"type":"text","id":"text","label":"Text","default":"Free Shipping"}]}]}{% endschema %}