{% assign section_id = 'sf-pwd-' | append: section.id %}

<style>
  #{{ section_id }} {
    background: var(--color-bg-password, var(--color-bg, #0a0a0a));
    color: var(--color-text-password, var(--color-text-inverted, #fff));
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-section-y, 80px) var(--spacing-section-x, 40px);
    text-align: center;
  }
  #{{ section_id }} .sf-pwd__logo {
    margin-bottom: 48px;
  }
  #{{ section_id }} .sf-pwd__badge {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.5;
    border: 1px solid currentColor;
    padding: 5px 12px;
    margin-bottom: 24px;
  }
  #{{ section_id }} .sf-pwd__title {
    font-family: var(--font-heading, inherit);
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    font-weight: 400;
    margin: 0 0 16px;
    max-width: 600px;
  }
  #{{ section_id }} .sf-pwd__subtitle {
    opacity: 0.65;
    line-height: 1.7;
    max-width: 480px;
    margin: 0 auto 40px;
    font-size: 0.95rem;
  }
  #{{ section_id }} .sf-pwd__form-wrapper {
    display: flex;
    gap: 0;
    width: 100%;
    max-width: 440px;
    margin: 0 auto 16px;
    border: 1px solid rgba(255,255,255,0.2);
  }
  #{{ section_id }} .sf-pwd__input {
    flex: 1;
    border: none;
    padding: 14px 16px;
    background: transparent;
    color: inherit;
    font-size: 0.95rem;
    outline: none;
  }
  #{{ section_id }} .sf-pwd__input::placeholder { opacity: 0.5; }
  #{{ section_id }} .sf-pwd__btn {
    border: none;
    border-left: 1px solid rgba(255,255,255,0.2);
    padding: 14px 24px;
    background: var(--color-primary, #fff);
    color: var(--color-bg, #0a0a0a);
    cursor: pointer;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: opacity 0.2s;
    white-space: nowrap;
  }
  #{{ section_id }} .sf-pwd__btn:hover { opacity: 0.8; }
  #{{ section_id }} .sf-pwd__note {
    font-size: 0.75rem;
    opacity: 0.4;
    letter-spacing: 0.05em;
    margin-bottom: 48px;
  }
  #{{ section_id }} .sf-pwd__login-link {
    font-size: 0.75rem;
    color: inherit;
    opacity: 0.5;
    text-decoration: underline;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }
  #{{ section_id }} .sf-pwd__login-link:hover { opacity: 1; }
  #{{ section_id }} .sf-pwd__modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }
  #{{ section_id }} .sf-pwd__modal-overlay.is-active { display: flex; }
  #{{ section_id }} .sf-pwd__modal-box {
    background: var(--color-bg-modal, #1a1a1a);
    color: var(--color-text-inverted, #fff);
    padding: 40px;
    max-width: 400px;
    width: 100%;
    position: relative;
  }
  #{{ section_id }} .sf-pwd__modal-close {
    position: absolute;
    top: 12px;
    right: 16px;
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    font-size: 1.2rem;
    opacity: 0.5;
  }
  #{{ section_id }} .sf-pwd__modal-title {
    font-family: var(--font-heading, inherit);
    font-size: 1.1rem;
    font-weight: 400;
    margin: 0 0 8px;
  }
  #{{ section_id }} .sf-pwd__modal-sub { opacity: 0.6; font-size: 0.9rem; margin: 0 0 24px; }
  #{{ section_id }} .sf-pwd__login-form { display: flex; flex-direction: column; gap: 12px; }
  #{{ section_id }} .sf-pwd__login-input {
    border: 1px solid rgba(255,255,255,0.2);
    background: transparent;
    color: inherit;
    padding: 12px;
    font-size: 0.95rem;
    outline: none;
  }
  #{{ section_id }} .sf-pwd__login-submit {
    border: none;
    padding: 12px;
    background: var(--color-primary, #fff);
    color: var(--color-bg, #0a0a0a);
    cursor: pointer;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: opacity 0.2s;
  }
  #{{ section_id }} .sf-pwd__login-submit:hover { opacity: 0.8; }
  #{{ section_id }} .sf-pwd__footer {
    margin-top: auto;
    padding-top: 48px;
    font-size: 0.75rem;
    opacity: 0.3;
  }
</style>

<div id="{{ section_id }}" data-section-id="{{ section.id }}" data-section-type="password">
  {%- if shop.brand.logo -%}
    <div class="sf-pwd__logo">
      <img src="{{ shop.brand.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="200" height="50" loading="eager">
    </div>
  {%- else -%}
    <div class="sf-pwd__logo">
      <span style="font-family: var(--font-heading, inherit); font-size: 1.5rem; letter-spacing: 0.1em;">{{ shop.name }}</span>
    </div>
  {%- endif -%}

  <div class="sf-pwd__badge">{{ section.settings.badge | default: "Coming Soon" }}</div>
  <h1 class="sf-pwd__title">{{ section.settings.heading | default: "Something New Is Coming" }}</h1>
  <p class="sf-pwd__subtitle">{{ section.settings.subtitle | default: "We are working on something great. Enter your email to be the first to know." }}</p>

  <div class="sf-pwd__form-wrapper">
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="prospect, newsletter">
      <input
        type="email"
        name="contact[email]"
        class="sf-pwd__input"
        placeholder="{{ section.settings.email_placeholder | default: 'Enter your email...' }}"
        required
        aria-label="{{ 'general.email' | t: default: 'Email' }}"
      >
      <button type="submit" class="sf-pwd__btn">
        {{ section.settings.submit_text | default: "Notify Me" }}
      </button>
    {% endform %}
  </div>

  <div class="sf-pwd__note">{{ section.settings.privacy_note | default: "No spam. Unsubscribe anytime." }}</div>

  <button type="button" class="sf-pwd__login-link" data-open-modal>
    {{ 'password_page.login_form.title' | t: default: 'Enter using password' }}
  </button>

  <footer class="sf-pwd__footer">
    &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.rights_reserved' | t: default: 'All Rights Reserved.' }}
  </footer>

  <div class="sf-pwd__modal-overlay" data-modal-overlay>
    <div class="sf-pwd__modal-box">
      <button type="button" class="sf-pwd__modal-close" data-close-modal aria-label="Close">&times;</button>
      <h2 class="sf-pwd__modal-title">{{ 'password_page.login_form.title' | t: default: 'Store Password' }}</h2>
      <p class="sf-pwd__modal-sub">{{ 'password_page.login_form.message' | t: default: 'Enter the password to preview this store.' }}</p>
      {% form 'storefront_password', class: 'sf-pwd__login-form' %}
        <input
          type="password"
          name="password"
          class="sf-pwd__login-input"
          placeholder="{{ 'password_page.login_form.password_placeholder' | t: default: 'Password' }}"
          required
          aria-label="{{ 'password_page.login_form.password_placeholder' | t: default: 'Password' }}"
        >
        <button type="submit" class="sf-pwd__login-submit">
          {{ 'password_page.login_form.submit' | t: default: 'Enter' }}
        </button>
        {%- if form.errors -%}
          <p style="color: #e44; font-size:0.85rem; margin-top:8px;">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</div>

<script>
  (function() {
    var root = document.getElementById('{{ section_id }}');
    if (!root) return;
    var openBtn = root.querySelector('[data-open-modal]');
    var closeBtn = root.querySelector('[data-close-modal]');
    var overlay = root.querySelector('[data-modal-overlay]');
    if (openBtn && overlay) {
      openBtn.addEventListener('click', function() {
        overlay.classList.add('is-active');
        var inp = overlay.querySelector('input[type="password"]');
        if (inp) setTimeout(function() { inp.focus(); }, 50);
      });
    }
    if (closeBtn && overlay) {
      closeBtn.addEventListener('click', function() { overlay.classList.remove('is-active'); });
    }
    if (overlay) {
      overlay.addEventListener('click', function(e) {
        if (e.target === overlay) overlay.classList.remove('is-active');
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "class": "section-password",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Coming Soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Something New Is Coming"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "We are working on something great. Enter your email to be the first to know."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Placeholder",
      "default": "Enter your email..."
    },
    {
      "type": "text",
      "id": "submit_text",
      "label": "Submit Button Text",
      "default": "Notify Me"
    },
    {
      "type": "text",
      "id": "privacy_note",
      "label": "Privacy Note",
      "default": "No spam. Unsubscribe anytime."
    }
  ],
  "presets": [
    {
      "name": "Password"
    }
  ]
}
{% endschema %}
