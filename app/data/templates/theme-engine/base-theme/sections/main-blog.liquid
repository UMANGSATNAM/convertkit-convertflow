<style>
  #shopify-section-{{ section.id }} .sf-blog {
    background: var(--color-bg, #fff);
    color: var(--color-text, #1a1a1a);
    padding: var(--spacing-section-y, 80px) var(--spacing-section-x, 40px);
  }
  #shopify-section-{{ section.id }} .sf-blog__header {
    max-width: 1200px;
    margin: 0 auto 48px;
    border-bottom: 1px solid var(--color-border, #e0e0e0);
    padding-bottom: 24px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  #shopify-section-{{ section.id }} .sf-blog__title {
    font-family: var(--font-heading, inherit);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 400;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .sf-blog__grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(var(--blog-cols, 3), 1fr);
    gap: 40px 32px;
  }
  @media (max-width: 900px) { #shopify-section-{{ section.id }} .sf-blog__grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 600px) { #shopify-section-{{ section.id }} .sf-blog__grid { grid-template-columns: 1fr; } }
  #shopify-section-{{ section.id }} .sf-blog__card-img-wrap {
    display: block;
    overflow: hidden;
    background: var(--color-bg-alt, #f5f5f5);
    aspect-ratio: 3 / 2;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .sf-blog__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  #shopify-section-{{ section.id }} .sf-blog__card-img-wrap:hover .sf-blog__card-img { transform: scale(1.04); }
  #shopify-section-{{ section.id }} .sf-blog__card-meta {
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted, #888);
    margin-bottom: 8px;
  }
  #shopify-section-{{ section.id }} .sf-blog__card-title {
    display: block;
    font-family: var(--font-heading, inherit);
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-text, #1a1a1a);
    text-decoration: none;
    margin-bottom: 12px;
    transition: opacity 0.2s;
  }
  #shopify-section-{{ section.id }} .sf-blog__card-title:hover { opacity: 0.65; }
  #shopify-section-{{ section.id }} .sf-blog__card-excerpt {
    font-size: 0.9rem;
    color: var(--color-text-muted, #888);
    line-height: 1.7;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .sf-blog__card-link {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary, #1a1a1a);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    transition: opacity 0.2s;
  }
  #shopify-section-{{ section.id }} .sf-blog__card-link:hover { opacity: 0.6; }
  #shopify-section-{{ section.id }} .sf-blog__pagination {
    max-width: 1200px;
    margin: 48px auto 0;
    text-align: center;
  }
</style>

<section
  id="shopify-section-{{ section.id }}"
  class="sf-blog"
  data-section-id="{{ section.id }}"
  data-section-type="main-blog">

  <div class="sf-blog__header">
    <h1 class="sf-blog__title">{{ blog.title | default: section.settings.title | default: 'Blog' }}</h1>
  </div>

  <div class="sf-blog__grid" style="--blog-cols: {{ section.settings.columns | default: 3 }}">
    {%- for article in blog.articles -%}
      <article class="sf-blog__card">
        <a href="{{ article.url }}" class="sf-blog__card-img-wrap" aria-label="{{ article.title | escape }}">
          {%- if article.image -%}
            <img
              class="sf-blog__card-img"
              src="{{ article.image | img_url: '800x533', crop: 'center' }}"
              alt="{{ article.image.alt | default: article.title | escape }}"
              loading="lazy"
              width="800"
              height="533"
            >
          {%- else -%}
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--color-text-muted,#888);font-size:0.8rem;">No Image</div>
          {%- endif -%}
        </a>

        <div class="sf-blog__card-meta">
          {{ article.published_at | date: "%B %d, %Y" }}
          {%- if article.author != blank %} &middot; {{ article.author }}{%- endif -%}
        </div>
        <a href="{{ article.url }}" class="sf-blog__card-title">{{ article.title }}</a>
        {%- if section.settings.show_excerpt and article.excerpt != blank -%}
          <p class="sf-blog__card-excerpt">{{ article.excerpt | strip_html | truncatewords: 24 }}</p>
        {%- endif -%}
        <a href="{{ article.url }}" class="sf-blog__card-link">{{ 'blogs.article.read_more' | t: default: 'Read More' }}</a>
      </article>
    {%- else -%}
      <p style="color:var(--color-text-muted,#888);">{{ 'blogs.list.no_articles' | t: default: 'No articles yet.' }}</p>
    {%- endfor -%}
  </div>

  {%- if paginate.pages > 1 -%}
    <div class="sf-blog__pagination">
      {{ paginate | default_pagination }}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Main Blog",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title (fallback if blog.title unavailable)",
      "default": "Blog"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show Article Excerpt",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Main Blog"
    }
  ]
}
{% endschema %}
