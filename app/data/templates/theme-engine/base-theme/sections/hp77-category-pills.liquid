<style>
@media screen and (max-width: 768px) {
  .hp77-category-pills {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}#shopify-section-{{ section.id }}{background:{{ section.settings.bg_color | default: '#fff' }};padding:24px 0}.hp77-pills{max-width:1280px;margin:0 auto;padding:0 24px;display:flex;gap:12px;overflow-x:auto;scrollbar-width:none}.hp77-pills::-webkit-scrollbar{display:none}.hp77-pill{flex:0 0 auto;padding:10px 18px;border-radius:999px;background:#fff;border:1px solid rgba(0,0,0,.1);font-size:13px;font-weight:600;text-decoration:none;color:inherit;white-space:nowrap} .hp77-pill--active{background:#EC4899;color:#fff;border-color:#EC4899}{%- endstyle -%}<div class="hp77-pills">{% for block in section.blocks %}<a href="{{ block.settings.url }}" class="hp77-pill">{{ block.settings.label }}</a>{% else %}{% for cat in collections limit:6 %}<a href="{{ cat.url }}" class="hp77-pill">{{ cat.title }}</a>{% endfor %}{% endfor %}</div>{% schema %}
{
  "name": "HP77 Pills",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "BG",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "All"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP77 Pills"
    }
  ]
}
{% endschema %}