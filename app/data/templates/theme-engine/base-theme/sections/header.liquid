{%- comment -%}
  Base theme header.

  The previous version was eighteen lines with inline styles, no logo, no mobile
  menu and an empty settings array — a merchant could not change a single thing
  about the most prominent element on their store.

  This one covers what a header has to do: a logo that falls back to the shop
  name, a menu with one level of dropdown, a real mobile drawer that traps focus
  and closes on Escape, and a cart count that updates when the drawer changes.

  Styles are scoped to `#shopify-section-{{ section.id }}` so two headers can
  never fight, and colours read from settings with the theme palette as the
  fallback — so a merchant who changes nothing still gets their own colours.
{%- endcomment -%}

{%- liquid
  assign menu = section.settings.menu | default: linklists['main-menu']
  if menu == blank
    assign menu = linklists['main-menu']
  endif
  assign sticky = section.settings.sticky
  assign logo = section.settings.logo
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hdr-bg: {{ section.settings.bg_color | default: 'var(--color-background, #ffffff)' }};
    --hdr-text: {{ section.settings.text_color | default: 'var(--color-text, #1a1a1a)' }};
    --hdr-accent: {{ section.settings.accent_color | default: 'var(--color-accent, #1a1a1a)' }};
    --hdr-border: {{ section.settings.border_color | default: 'var(--color-border, #e5e7eb)' }};
    --hdr-pad: {{ section.settings.padding | default: 16 }}px;
    --hdr-pad-mobile: {{ section.settings.padding_mobile | default: 12 }}px;
    --hdr-logo-w: {{ section.settings.logo_width | default: 130 }}px;
  }

  .cf-header {
    background: var(--hdr-bg);
    color: var(--hdr-text);
    border-bottom: 1px solid var(--hdr-border);
    {% if sticky %}position: sticky; top: 0; z-index: 100;{% endif %}
  }
  .cf-header__inner {
    max-width: var(--page-width, 1280px);
    margin: 0 auto;
    padding: var(--hdr-pad) 20px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
  }
  .cf-header__logo { display: inline-flex; align-items: center; text-decoration: none; color: inherit; }
  .cf-header__logo img { display: block; width: var(--hdr-logo-w); height: auto; }
  .cf-header__logo-text {
    font-family: var(--font-heading-family, inherit);
    font-size: 1.25rem; font-weight: 600; letter-spacing: 0.02em;
  }

  .cf-header__nav { display: flex; justify-content: center; gap: 28px; }
  .cf-header__item { position: relative; }
  .cf-header__link {
    display: inline-block; padding: 8px 0;
    color: inherit; text-decoration: none;
    font-size: 0.9375rem; line-height: 1;
  }
  .cf-header__link:hover, .cf-header__link:focus-visible { color: var(--hdr-accent); }
  .cf-header__link:focus-visible { outline: 2px solid var(--hdr-accent); outline-offset: 4px; }

  .cf-header__submenu {
    position: absolute; top: 100%; left: 0; min-width: 200px;
    background: var(--hdr-bg); border: 1px solid var(--hdr-border);
    border-radius: var(--card-radius, 8px);
    padding: 8px; margin: 0; list-style: none;
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity 150ms ease, transform 150ms ease, visibility 150ms;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08); z-index: 20;
  }
  .cf-header__item:hover > .cf-header__submenu,
  .cf-header__item:focus-within > .cf-header__submenu {
    opacity: 1; visibility: visible; transform: translateY(0);
  }
  .cf-header__submenu a { display: block; padding: 8px 12px; color: inherit; text-decoration: none; font-size: 0.875rem; }
  .cf-header__submenu a:hover { color: var(--hdr-accent); }

  .cf-header__actions { display: flex; align-items: center; gap: 4px; justify-self: end; }
  .cf-header__action {
    /* 44px keeps every control above the WCAG 2.5.5 touch target minimum. */
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 44px; min-height: 44px;
    background: none; border: 0; padding: 0; cursor: pointer;
    color: inherit; text-decoration: none; position: relative;
  }
  .cf-header__action:focus-visible { outline: 2px solid var(--hdr-accent); outline-offset: 2px; border-radius: 4px; }
  .cf-header__count {
    position: absolute; top: 6px; right: 4px;
    min-width: 17px; height: 17px; padding: 0 4px;
    border-radius: 9px; background: var(--hdr-accent); color: var(--hdr-bg);
    font-size: 10px; line-height: 17px; text-align: center; font-weight: 600;
  }

  .cf-header__burger { display: none; }

  /* ── Mobile ─────────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .cf-header__inner { padding: var(--hdr-pad-mobile) 16px; grid-template-columns: auto 1fr auto; }
    .cf-header__burger { display: inline-flex; order: -1; }
    .cf-header__nav {
      position: fixed; inset: 0 auto 0 0; width: min(84vw, 340px);
      background: var(--hdr-bg); border-right: 1px solid var(--hdr-border);
      flex-direction: column; justify-content: flex-start; align-items: stretch;
      gap: 0; padding: 76px 20px 20px; overflow-y: auto;
      transform: translateX(-100%); transition: transform 220ms ease;
      z-index: 120;
    }
    .cf-header[data-open="true"] .cf-header__nav { transform: translateX(0); }
    .cf-header__link { padding: 14px 0; font-size: 1rem; border-bottom: 1px solid var(--hdr-border); }
    .cf-header__submenu {
      position: static; opacity: 1; visibility: visible; transform: none;
      border: 0; box-shadow: none; padding: 0 0 8px 16px;
    }
    .cf-header__scrim {
      position: fixed; inset: 0; background: rgba(0,0,0,0.4);
      opacity: 0; visibility: hidden; transition: opacity 220ms ease, visibility 220ms;
      z-index: 110;
    }
    .cf-header[data-open="true"] .cf-header__scrim { opacity: 1; visibility: visible; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cf-header__nav, .cf-header__submenu, .cf-header__scrim { transition: none; }
  }
</style>

<header class="cf-header" data-open="false" data-cf-header>
  <div class="cf-header__scrim" data-cf-close hidden aria-hidden="true"></div>

  <div class="cf-header__inner">
    <button
      type="button"
      class="cf-header__action cf-header__burger"
      aria-expanded="false"
      aria-controls="cf-nav-{{ section.id }}"
      aria-label="{{ 'general.menu' | t: default: 'Menu' }}"
      data-cf-toggle>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"/>
      </svg>
    </button>

    <a href="{{ routes.root_url }}" class="cf-header__logo">
      {%- if logo != blank -%}
        <img src="{{ logo | image_url: width: 400 }}"
             alt="{{ shop.name | escape }}"
             width="{{ logo.width }}" height="{{ logo.height }}"
             fetchpriority="high">
      {%- else -%}
        <span class="cf-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="cf-header__nav" id="cf-nav-{{ section.id }}" aria-label="{{ 'general.primary_navigation' | t: default: 'Primary' }}">
      {%- for link in menu.links -%}
        <div class="cf-header__item">
          <a href="{{ link.url }}" class="cf-header__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
          {%- if link.links.size > 0 -%}
            <ul class="cf-header__submenu">
              {%- for child in link.links -%}
                <li><a href="{{ child.url }}">{{ child.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </nav>

    <div class="cf-header__actions">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" class="cf-header__action" aria-label="{{ 'general.search' | t: default: 'Search' }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5" stroke-linecap="round"/>
          </svg>
        </a>
      {%- endif -%}

      {%- if section.settings.show_account -%}
        <a href="{{ routes.account_url }}" class="cf-header__action" aria-label="{{ 'customer.account' | t: default: 'Account' }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0116 0" stroke-linecap="round"/>
          </svg>
        </a>
      {%- endif -%}

      {%- if section.settings.show_cart -%}
        <a href="{{ routes.cart_url }}" class="cf-header__action" data-cart-open
           aria-label="{{ 'general.cart' | t: default: 'Cart' }} ({{ cart.item_count }})">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 016 0" stroke-linecap="round"/>
          </svg>
          <span class="cf-header__count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</header>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root || !root.matches('[data-cf-header]')) root = document.querySelector('#shopify-section-{{ section.id }} [data-cf-header]');
    if (!root) return;

    var toggle = root.querySelector('[data-cf-toggle]');
    var scrim = root.querySelector('[data-cf-close]');
    var nav = root.querySelector('.cf-header__nav');
    var lastFocused = null;

    function setOpen(open) {
      root.dataset.open = open ? 'true' : 'false';
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      scrim.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';

      if (open) {
        lastFocused = document.activeElement;
        var first = nav.querySelector('a');
        if (first) first.focus();
      } else if (lastFocused) {
        lastFocused.focus();
      }
    }

    toggle.addEventListener('click', function () {
      setOpen(root.dataset.open !== 'true');
    });
    scrim.addEventListener('click', function () { setOpen(false); });

    // Escape closes the drawer, and focus returns to the button that opened it.
    // Without this a keyboard user who opens the menu has no way back out.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && root.dataset.open === 'true') setOpen(false);
    });

    // Resizing past the breakpoint leaves the drawer open but invisible, with
    // the body still locked, so reset it.
    var mq = window.matchMedia('(min-width: 901px)');
    (mq.addEventListener ? mq.addEventListener.bind(mq, 'change') : mq.addListener.bind(mq))(function (e) {
      if (e.matches && root.dataset.open === 'true') setOpen(false);
    });

    // The cart drawer dispatches this after every add or change; without it the
    // badge stays on the number the page was rendered with.
    document.addEventListener('cart:updated', function (e) {
      var count = e.detail && typeof e.detail.item_count === 'number' ? e.detail.item_count : null;
      if (count === null) return;
      var badge = root.querySelector('[data-cart-count]');
      if (!badge) return;
      badge.textContent = count;
      badge.hidden = count === 0;
    });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "cf-header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Leave empty to use your main menu."
    },
    { "type": "header", "content": "Brand" },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Your store name is shown when this is empty."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 280,
      "step": 10,
      "unit": "px",
      "default": 130
    },
    { "type": "header", "content": "Behaviour" },
    { "type": "checkbox", "id": "sticky", "label": "Stick to the top on scroll", "default": true },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "Show cart", "default": true },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#1A1A1A" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E5E7EB" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding", "label": "Padding", "min": 4, "max": 48, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_mobile", "label": "Mobile padding", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 12 }
  ],
  "presets": [{ "name": "Header" }]
}
{% endschema %}
