{%- style -%}#shopify-section-{{ section.id }}{background:#ECFEFF;padding:50px 0}.hp96-t{max-width:1280px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:repeat(2,1fr);gap:14px}@media(max-width:800px){.hp96-t{grid-template-columns:1fr}}.hp96-card{background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:12px;padding:16px}.hp96-stars{color:#06B6D4}{%- endstyle -%}<div class="hp96-t">{% for block in section.blocks %}<div class="hp96-card"><div class="hp96-stars">★★★★★</div><p style="font-weight:600">{{block.settings.text}}</p><small style="opacity:.6">— {{block.settings.author}}</small></div>{% else %}<div class="hp96-card"><div class="hp96-stars">★★★★★</div><p>Loved ACTIVEWEAR!</p><small>— A. Sharma</small></div><div class="hp96-card"><div class="hp96-stars">★★★★★</div><p>Super fast.</p><small>— R. Mehta</small></div>{% if false %}<div class="hp96-card"><div class="hp96-stars">★★★★★</div><p>Will reorder!</p><small>— P. Rao</small></div>{% endif %}{% endfor %}</div>{% schema %}{"name":"HP96 Testimonials","blocks":[{"type":"t","name":"T","settings":[{"type":"textarea","id":"text","label":"Text","default":"Great!"},{"type":"text","id":"author","label":"Author","default":"A. Sharma"}]}]}{% endschema %}