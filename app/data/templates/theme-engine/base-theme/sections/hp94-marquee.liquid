{%- style -%}#shopify-section-{{ section.id }}{background:#F97316;color:#fff;padding:10px 0;overflow:hidden;white-space:nowrap}.hp94-mq{display:flex;gap:36px;animation:hp94m 18s linear infinite}@keyframes hp94m{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}.hp94-mq span{font-size:12px;letter-spacing:2px;text-transform:uppercase;font-weight:700}{%- endstyle -%}<div class="hp94-mq">{% for i in (1..2) %}{% for block in section.blocks %}<span>{{block.settings.text}} •</span>{% endfor %}{% if section.blocks.size==0 %}<span>KIDS • FREE SHIPPING • v94 •</span>{% endif %}{% endfor %}</div>{% schema %}
{
  "name": "HP94 Marquee",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP94 Marquee"
    }
  ]
}
{% endschema %}