{{ 'cart.css' | asset_url | stylesheet_tag }}

{%- if settings.cart_type == 'drawer' -%}
  <script>
    window.location.replace("{{ routes.root_url }}?open_cart=true");
  </script>
{%- endif -%}

<div class="container main-cart-section-wrapper" data-section-id="{{ section.id }}">
  <h1 class="main-cart-title">{{ 'sections.cart.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart-form" class="main-cart-form">
      <table class="main-cart-table">
        <thead>
          <tr>
            <th colspan="2" class="text-left">Product</th>
            <th class="text-center">Quantity</th>
            <th class="text-right">Total</th>
          </tr>
        </thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr class="main-cart-item-row" data-key="{{ item.key }}">
              <!-- Item Image -->
              <td class="main-cart-item-image-col">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.image.alt | escape }}" class="main-cart-item-image" loading="lazy" width="120" height="120">
                {%- endif -%}
              </td>

              <!-- Item Info -->
              <td class="main-cart-item-details-col">
                <div class="main-cart-item-vendor">{{ item.vendor }}</div>
                <a href="{{ item.url }}" class="main-cart-item-title">{{ item.product.title | escape }}</a>
                
                {%- if item.product.has_only_default_variant == false -%}
                  <div class="main-cart-item-options">
                    {%- for option in item.options_with_values -%}
                      <span class="main-cart-item-option">{{ option.name }}: {{ option.value }}</span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                <div class="main-cart-item-actions-mobile hide-desktop">
                  <div class="quantity-stepper">
                    <button type="button" class="quantity-stepper-btn stepper-minus">{% render 'icon-minus' %}</button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="quantity-stepper-input" data-key="{{ item.key }}">
                    <button type="button" class="quantity-stepper-btn stepper-plus">{% render 'icon-plus' %}</button>
                  </div>
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="main-cart-remove-link">Remove</a>
                </div>
              </td>

              <!-- Quantity Column -->
              <td class="main-cart-item-quantity-col hide-mobile">
                <div class="quantity-stepper">
                  <button type="button" class="quantity-stepper-btn stepper-minus">{% render 'icon-minus' %}</button>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="quantity-stepper-input" data-key="{{ item.key }}">
                  <button type="button" class="quantity-stepper-btn stepper-plus">{% render 'icon-plus' %}</button>
                </div>
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="main-cart-remove-link">Remove</a>
              </td>

              <!-- Price Column -->
              <td class="main-cart-item-price-col text-right">
                {%- if item.original_line_price != item.final_line_price -%}
                  <s class="main-cart-item-price-compare">{{ item.original_line_price | money }}</s>
                  <span class="main-cart-item-price-final">{{ item.final_line_price | money }}</span>
                {%- else -%}
                  <span class="main-cart-item-price-final">{{ item.original_line_price | money }}</span>
                {%- endif -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      <footer class="main-cart-footer">
        <div class="main-cart-totals-wrapper">
          <div class="main-cart-subtotal-row">
            <span class="subtotal-label">{{ 'sections.cart.subtotal' | t }}</span>
            <span class="subtotal-value">{{ cart.total_price | money }}</span>
          </div>
          <p class="main-cart-taxes-note">{{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t }}</p>
          <div class="main-cart-actions">
            <button type="submit" name="update" class="button button--secondary main-cart-update-btn">Update Cart</button>
            <button type="submit" name="checkout" class="button button--primary main-cart-checkout-btn">
              {{ 'sections.cart.checkout' | t }}
            </button>
          </div>
        </div>
      </footer>
    </form>
  {%- else -%}
    <div class="main-cart-empty-state">
      <p class="main-cart-empty-message">{{ 'sections.cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
        {{ 'sections.cart.continue_shopping' | t }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart Page",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Your cart"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "checkbox",
      "id": "show_update",
      "label": "Show Update cart button",
      "default": true
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button",
      "default": "Checkout"
    },
    {
      "type": "header",
      "content": "Reassurance"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note under the total",
      "info": "Shipping and taxes are calculated at checkout.",
      "default": "Shipping and taxes calculated at checkout."
    },
    {
      "type": "checkbox",
      "id": "show_taxes_note",
      "label": "Show the note",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
