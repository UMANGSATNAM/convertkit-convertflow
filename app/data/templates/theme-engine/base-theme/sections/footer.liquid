{%- comment -%}
  Base theme footer.

  The previous version was three lines: a copyright notice and nothing else. No
  menus, no newsletter, no payment icons, and an empty settings array — so a
  merchant could neither change it nor add a single link.

  Menu columns are blocks, which means a merchant adds and reorders them in the
  theme editor rather than being stuck with a fixed number.
{%- endcomment -%}

{%- liquid
  assign show_news = section.settings.show_newsletter
  assign show_pay = section.settings.show_payment_icons
-%}

<style>
  #shopify-section-{{ section.id }} {
    --ftr-bg: {{ section.settings.bg_color | default: 'var(--color-surface, #f8fafc)' }};
    --ftr-text: {{ section.settings.text_color | default: 'var(--color-text, #1a1a1a)' }};
    --ftr-muted: {{ section.settings.muted_color | default: 'var(--color-text-muted, #64748b)' }};
    --ftr-accent: {{ section.settings.accent_color | default: 'var(--color-accent, #1a1a1a)' }};
    --ftr-border: {{ section.settings.border_color | default: 'var(--color-border, #e5e7eb)' }};
    --ftr-pad-top: {{ section.settings.padding_top | default: 56 }}px;
    --ftr-pad-bottom: {{ section.settings.padding_bottom | default: 32 }}px;
  }

  .cf-footer {
    background: var(--ftr-bg);
    color: var(--ftr-text);
    border-top: 1px solid var(--ftr-border);
    padding: var(--ftr-pad-top) 20px var(--ftr-pad-bottom);
  }
  .cf-footer__inner { max-width: var(--page-width, 1280px); margin: 0 auto; }

  .cf-footer__top {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 40px;
    padding-bottom: 40px;
  }

  .cf-footer__brand-name {
    font-family: var(--font-heading-family, inherit);
    font-size: 1.125rem; font-weight: 600; letter-spacing: 0.06em;
    text-transform: uppercase; margin: 0 0 10px;
  }
  .cf-footer__about { color: var(--ftr-muted); font-size: 0.9375rem; line-height: 1.6; margin: 0; max-width: 34ch; }
  .cf-footer__logo { display: block; height: auto; margin-bottom: 12px; }

  .cf-footer__title {
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em;
    text-transform: uppercase; margin: 0 0 14px;
  }
  .cf-footer__list { list-style: none; margin: 0; padding: 0; }
  .cf-footer__list li { margin-bottom: 10px; }
  .cf-footer__list a {
    color: var(--ftr-muted); text-decoration: none; font-size: 0.9375rem;
    /* Generous hit area without changing the visual rhythm. */
    display: inline-block; padding: 2px 0;
  }
  .cf-footer__list a:hover { color: var(--ftr-accent); }
  .cf-footer__list a:focus-visible { outline: 2px solid var(--ftr-accent); outline-offset: 3px; border-radius: 2px; }

  .cf-footer__form { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
  .cf-footer__input {
    flex: 1 1 180px; min-height: 44px; padding: 0 14px;
    border: 1px solid var(--ftr-border); border-radius: var(--button-radius, 6px);
    background: var(--color-background, #fff); color: var(--ftr-text); font-size: 0.9375rem;
  }
  .cf-footer__input:focus-visible { outline: 2px solid var(--ftr-accent); outline-offset: 1px; }
  .cf-footer__submit {
    min-height: 44px; padding: 0 20px; border: 0; cursor: pointer;
    border-radius: var(--button-radius, 6px);
    background: var(--ftr-accent); color: var(--ftr-bg);
    font-size: 0.9375rem; font-weight: 600;
  }
  .cf-footer__note { color: var(--ftr-muted); font-size: 0.8125rem; margin: 8px 0 0; }

  .cf-footer__social { display: flex; gap: 6px; margin-top: 16px; }
  .cf-footer__social a {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 40px; min-height: 40px; color: var(--ftr-muted);
    border: 1px solid var(--ftr-border); border-radius: 50%;
  }
  .cf-footer__social a:hover { color: var(--ftr-accent); border-color: var(--ftr-accent); }

  .cf-footer__bottom {
    border-top: 1px solid var(--ftr-border); padding-top: 24px;
    display: flex; justify-content: space-between; align-items: center;
    gap: 20px; flex-wrap: wrap;
  }
  .cf-footer__copy { color: var(--ftr-muted); font-size: 0.875rem; margin: 0; }
  .cf-footer__pay { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .cf-footer__pay svg { height: 24px; width: auto; }

  @media (max-width: 640px) {
    .cf-footer { padding-top: 40px; }
    .cf-footer__top { gap: 32px; }
    .cf-footer__bottom { flex-direction: column; align-items: flex-start; }
  }
</style>

<footer class="cf-footer">
  <div class="cf-footer__inner">
    <div class="cf-footer__top">

      <div>
        {%- if section.settings.logo != blank -%}
          <img class="cf-footer__logo"
               src="{{ section.settings.logo | image_url: width: 320 }}"
               alt="{{ shop.name | escape }}"
               width="{{ section.settings.logo.width }}"
               height="{{ section.settings.logo.height }}"
               style="width: {{ section.settings.logo_width | default: 140 }}px;"
               loading="lazy">
        {%- else -%}
          <p class="cf-footer__brand-name">{{ shop.name }}</p>
        {%- endif -%}
        {%- if section.settings.about != blank -%}
          <p class="cf-footer__about">{{ section.settings.about }}</p>
        {%- endif -%}

        {%- if section.settings.show_social -%}
          <div class="cf-footer__social">
            {%- assign socials = 'instagram,facebook,twitter,youtube' | split: ',' -%}
            {%- for name in socials -%}
              {%- assign key = name | append: '_url' -%}
              {%- assign url = section.settings[key] -%}
              {%- if url != blank -%}
                <a href="{{ url }}" target="_blank" rel="noopener" aria-label="{{ name | capitalize }}">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    {%- case name -%}
                      {%- when 'instagram' -%}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1" fill="currentColor" stroke="none"/>
                      {%- when 'facebook' -%}<path d="M14 8h3V4h-3a4 4 0 00-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8a1 1 0 011-1z" stroke-linejoin="round"/>
                      {%- when 'twitter' -%}<path d="M4 4l7 9-7 7h2l6-6 5 6h4l-7.5-9L21 4h-2l-5.5 5.5L9 4H4z" stroke-linejoin="round"/>
                      {%- else -%}<path d="M3 8a3 3 0 013-3h12a3 3 0 013 3v8a3 3 0 01-3 3H6a3 3 0 01-3-3V8z"/><path d="M10 9l5 3-5 3V9z" stroke-linejoin="round"/>
                    {%- endcase -%}
                  </svg>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          {%- assign list = linklists[block.settings.menu] -%}
          {%- if list.links.size > 0 -%}
            <div {{ block.shopify_attributes }}>
              <h2 class="cf-footer__title">{{ block.settings.title | default: list.title }}</h2>
              <ul class="cf-footer__list">
                {%- for link in list.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if show_news -%}
        <div>
          <h2 class="cf-footer__title">{{ section.settings.newsletter_title | default: 'Stay in the loop' }}</h2>
          <p class="cf-footer__about">{{ section.settings.newsletter_text }}</p>
          {%- form 'customer', class: 'cf-footer__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="cf-news-{{ section.id }}">Email</label>
            <input
              id="cf-news-{{ section.id }}"
              class="cf-footer__input"
              type="email"
              name="contact[email]"
              placeholder="{{ 'newsletter.email' | t: default: 'Your email' }}"
              autocomplete="email"
              required>
            <button type="submit" class="cf-footer__submit">
              {{ section.settings.newsletter_cta | default: 'Subscribe' }}
            </button>
            {%- if form.posted_successfully? -%}
              <p class="cf-footer__note">Thanks — check your inbox to confirm.</p>
            {%- elsif form.errors -%}
              <p class="cf-footer__note">{{ form.errors.messages.email }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

    </div>

    <div class="cf-footer__bottom">
      <p class="cf-footer__copy">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_note }}
      </p>

      {%- if show_pay and shop.enabled_payment_types.size > 0 -%}
        <div class="cf-footer__pay" role="list" aria-label="{{ 'general.payment_methods' | t: default: 'Payment methods' }}">
          {%- for type in shop.enabled_payment_types -%}
            <span role="listitem">{{ type | payment_type_svg_tag: class: 'cf-pay-icon' }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "cf-footer-section",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Your store name is shown when this is empty." },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 240, "step": 10, "unit": "px", "default": 140 },
    { "type": "textarea", "id": "about", "label": "About text", "default": "Made carefully, and meant to last." },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_title", "label": "Heading", "default": "Stay in the loop" },
    { "type": "text", "id": "newsletter_text", "label": "Text", "default": "New arrivals and early access. No noise." },
    { "type": "text", "id": "newsletter_cta", "label": "Button label", "default": "Subscribe" },
    { "type": "header", "content": "Social" },
    { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "url", "id": "twitter_url", "label": "X / Twitter" },
    { "type": "url", "id": "youtube_url", "label": "YouTube" },
    { "type": "header", "content": "Bottom bar" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "copyright_note", "label": "Copyright line", "default": "All rights reserved." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F8FAFC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "muted_color", "label": "Secondary text", "default": "#64748B" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#1A1A1A" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E5E7EB" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 16, "max": 96, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 16, "max": 96, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Footer",
      "blocks": [{ "type": "menu" }, { "type": "menu" }]
    }
  ]
}
{% endschema %}
