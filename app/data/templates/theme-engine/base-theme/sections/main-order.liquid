<style>
  #shopify-section-{{ section.id }} .sf-order {
    background: var(--color-bg, #fff);
    color: var(--color-text, #1a1a1a);
    padding: var(--spacing-section-y, 80px) var(--spacing-section-x, 40px);
    max-width: 1200px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .sf-order__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--color-border, #e0e0e0);
    padding-bottom: 24px;
    margin-bottom: 40px;
    flex-wrap: wrap;
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .sf-order__title {
    font-family: var(--font-heading, inherit);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .sf-order__back {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted, #888);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  #shopify-section-{{ section.id }} .sf-order__grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 48px;
  }
  @media (max-width: 768px) { #shopify-section-{{ section.id }} .sf-order__grid { grid-template-columns: 1fr; } }
  #shopify-section-{{ section.id }} h2 {
    font-family: var(--font-heading, inherit);
    font-size: 1.25rem;
    font-weight: 400;
    margin: 0 0 24px;
  }
  #shopify-section-{{ section.id }} table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  #shopify-section-{{ section.id }} th,
  #shopify-section-{{ section.id }} td {
    padding: 16px 12px;
    text-align: left;
    border-bottom: 1px solid var(--color-border, #e0e0e0);
  }
  #shopify-section-{{ section.id }} th {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted, #888);
    font-weight: 500;
  }
  #shopify-section-{{ section.id }} .sf-order__box {
    padding: 24px;
    border: 1px solid var(--color-border, #e0e0e0);
    line-height: 1.8;
    font-size: 0.95rem;
    margin-bottom: 32px;
  }
</style>

<section id="shopify-section-{{ section.id }}" class="sf-order" data-section-id="{{ section.id }}" data-section-type="main-order">
  <div class="sf-order__header">
    <h1 class="sf-order__title">{{ 'customer.order.title' | t: name: order.name | default: order.name }}</h1>
    <a href="{{ routes.account_url }}" class="sf-order__back">&larr; {{ 'customer.account.return' | t: default: 'Return to Account Details' }}</a>
  </div>

  <div class="sf-order__grid">
    <div>
      <p style="color:var(--color-text-muted,#888);margin-bottom:24px;">
        {{ 'customer.order.date' | t: date: order.created_at | date: "%B %d, %Y" }} &middot; 
        <strong>{{ order.financial_status_label }}</strong> / <strong>{{ order.fulfillment_status_label }}</strong>
      </p>

      <table>
        <thead>
          <tr>
            <th>{{ 'customer.order.product' | t: default: 'Product' }}</th>
            <th>{{ 'customer.order.sku' | t: default: 'SKU' }}</th>
            <th>{{ 'customer.order.price' | t: default: 'Price' }}</th>
            <th>{{ 'customer.order.quantity' | t: default: 'Quantity' }}</th>
            <th style="text-align:right;">{{ 'customer.order.total' | t: default: 'Total' }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr>
              <td>
                <a href="{{ line_item.product.url }}" style="color:var(--color-text,#1a1a1a);font-weight:500;text-decoration:none;">{{ line_item.title }}</a>
                {%- if line_item.fulfillment -%}
                  <div style="font-size:0.8rem;color:var(--color-text-muted,#888);margin-top:4px;">
                    {{ 'customer.order.fulfilled_at' | t: date: line_item.fulfillment.created_at | date: "%b %d, %Y" }}
                    {%- if line_item.fulfillment.tracking_number -%}
                      <br><a href="{{ line_item.fulfillment.tracking_url }}">{{ line_item.fulfillment.tracking_company }} #{{ line_item.fulfillment.tracking_number }}</a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </td>
              <td>{{ line_item.sku | default: '-' }}</td>
              <td>{{ line_item.price | money }}</td>
              <td>{{ line_item.quantity }}</td>
              <td style="text-align:right;">{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr>
            <td colspan="4" style="text-align:right;font-weight:500;">{{ 'customer.order.subtotal' | t: default: 'Subtotal' }}</td>
            <td style="text-align:right;">{{ order.subtotal_price | money }}</td>
          </tr>
          {%- for shipping_method in order.shipping_methods -%}
            <tr>
              <td colspan="4" style="text-align:right;color:var(--color-text-muted,#888);">{{ 'customer.order.shipping' | t: default: 'Shipping' }} ({{ shipping_method.title }})</td>
              <td style="text-align:right;">{{ shipping_method.price | money }}</td>
            </tr>
          {%- endfor -%}
          {%- for tax_line in order.tax_lines -%}
            <tr>
              <td colspan="4" style="text-align:right;color:var(--color-text-muted,#888);">{{ 'customer.order.tax' | t: default: 'Tax' }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</td>
              <td style="text-align:right;">{{ tax_line.price | money }}</td>
            </tr>
          {%- endfor -%}
          <tr>
            <td colspan="4" style="text-align:right;font-weight:700;font-size:1.1rem;">{{ 'customer.order.total' | t: default: 'Total' }}</td>
            <td style="text-align:right;font-weight:700;font-size:1.1rem;">{{ order.total_price | money }} {{ order.currency }}</td>
          </tr>
        </tfoot>
      </table>
    </div>

    <div>
      <h2>{{ 'customer.order.billing_address' | t: default: 'Billing Address' }}</h2>
      <div class="sf-order__box">
        <strong>{{ order.billing_address.name }}</strong><br>
        {{ order.billing_address | format_address }}
      </div>

      <h2>{{ 'customer.order.shipping_address' | t: default: 'Shipping Address' }}</h2>
      <div class="sf-order__box">
        <strong>{{ order.shipping_address.name }}</strong><br>
        {{ order.shipping_address | format_address }}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Order Main",
  "tag": "section",
  "class": "section-main-order",
  "settings": [],
  "presets": [
    {
      "name": "Order Main"
    }
  ]
}
{% endschema %}
