<div class="pdp-v10__card">
  <a href="{{ product.url }}" style="text-decoration:none; color:inherit; display:block;">
    {% if product.featured_media %}
      <img src="{{ product.featured_media | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy" style="width:100%; aspect-ratio:1; object-fit:cover; border-radius:8px; margin-bottom:12px; background:#F4F4F4;">
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
    <div class="pdp-v10__card-title" style="font-size:14px; font-weight:500; margin-bottom:6px; color:#212121;">{{ product.title | truncate: 35 }}</div>
    <div class="pdp-v10__card-price" style="font-weight:700; font-size:14px;">{{ product.price | money }}</div>
  </a>
</div>
