<style>
  #shopify-section-{{ section.id }} .sf-addresses {
    background: var(--color-bg, #fff);
    color: var(--color-text, #1a1a1a);
    padding: var(--spacing-section-y, 80px) var(--spacing-section-x, 40px);
    max-width: 1000px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .sf-addresses__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--color-border, #e0e0e0);
    padding-bottom: 24px;
    margin-bottom: 40px;
    flex-wrap: wrap;
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .sf-addresses__title {
    font-family: var(--font-heading, inherit);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .sf-addresses__back {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted, #888);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  #shopify-section-{{ section.id }} .sf-addresses__btn {
    border: none;
    background: var(--color-primary, #1a1a1a);
    color: var(--color-btn-text, #fff);
    padding: 12px 24px;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  #shopify-section-{{ section.id }} .sf-addresses__btn:hover { opacity: 0.8; }
  #shopify-section-{{ section.id }} .sf-addresses__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
  @media (max-width: 680px) { #shopify-section-{{ section.id }} .sf-addresses__grid { grid-template-columns: 1fr; } }
  #shopify-section-{{ section.id }} .sf-addresses__card {
    padding: 24px;
    border: 1px solid var(--color-border, #e0e0e0);
    position: relative;
    line-height: 1.8;
  }
  #shopify-section-{{ section.id }} .sf-addresses__badge {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--color-bg-alt, #f5f5f5);
    padding: 4px 8px;
    color: var(--color-text, #1a1a1a);
  }
  #shopify-section-{{ section.id }} .sf-addresses__actions {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border, #e0e0e0);
    display: flex;
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .sf-addresses__action-link {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted, #888);
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: color 0.2s;
  }
  #shopify-section-{{ section.id }} .sf-addresses__action-link:hover { color: var(--color-primary, #1a1a1a); }
  #shopify-section-{{ section.id }} .sf-addresses__form-wrapper {
    display: none;
    padding: 32px;
    border: 1px solid var(--color-border, #e0e0e0);
    margin-bottom: 40px;
    background: var(--color-bg-alt, #fafafa);
  }
  #shopify-section-{{ section.id }} .sf-addresses__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .sf-addresses__input,
  #shopify-section-{{ section.id }} .sf-addresses__select {
    border: 1px solid var(--color-border, #e0e0e0);
    padding: 12px;
    background: var(--color-bg, #fff);
    color: inherit;
    font-size: 0.95rem;
  }
</style>

<section id="shopify-section-{{ section.id }}" class="sf-addresses" data-section-id="{{ section.id }}" data-section-type="main-addresses">
  <div class="sf-addresses__header">
    <h1 class="sf-addresses__title">{{ 'customer.addresses.title' | t: default: 'Addresses' }}</h1>
    <div>
      <button type="button" class="sf-addresses__btn" onclick="document.getElementById('AddAddress').style.display='block';return false;">
        {{ 'customer.addresses.add_new' | t: default: 'Add a New Address' }}
      </button>
      <a href="{{ routes.account_url }}" class="sf-addresses__back" style="margin-left:16px;">&larr; {{ 'customer.account.return' | t: default: 'Return to Account' }}</a>
    </div>
  </div>

  <div id="AddAddress" class="sf-addresses__form-wrapper">
    <h2 style="font-family:var(--font-heading,inherit);font-size:1.2rem;margin:0 0 24px;">{{ 'customer.addresses.add_new' | t: default: 'Add a New Address' }}</h2>
    {% form 'customer_address', customer.new_address %}
      <div class="sf-addresses__field">
        <label for="AddressFirstNameNew">{{ 'customer.addresses.first_name' | t: default: 'First Name' }}</label>
        <input type="text" id="AddressFirstNameNew" name="address[first_name]" value="{{ form.first_name }}" class="sf-addresses__input">
      </div>
      <div class="sf-addresses__field">
        <label for="AddressLastNameNew">{{ 'customer.addresses.last_name' | t: default: 'Last Name' }}</label>
        <input type="text" id="AddressLastNameNew" name="address[last_name]" value="{{ form.last_name }}" class="sf-addresses__input">
      </div>
      <div class="sf-addresses__field">
        <label for="AddressAddress1New">{{ 'customer.addresses.address1' | t: default: 'Address 1' }}</label>
        <input type="text" id="AddressAddress1New" name="address[address1]" value="{{ form.address1 }}" class="sf-addresses__input">
      </div>
      <div class="sf-addresses__field">
        <label for="AddressCityNew">{{ 'customer.addresses.city' | t: default: 'City' }}</label>
        <input type="text" id="AddressCityNew" name="address[city]" value="{{ form.city }}" class="sf-addresses__input">
      </div>
      <div class="sf-addresses__field">
        <label for="AddressCountryNew">{{ 'customer.addresses.country' | t: default: 'Country' }}</label>
        <select id="AddressCountryNew" name="address[country]" data-default="{{ form.country }}" class="sf-addresses__select">{{ all_country_option_tags }}</select>
      </div>
      <div style="margin-top:24px;">
        <button type="submit" class="sf-addresses__btn">{{ 'customer.addresses.add' | t: default: 'Add Address' }}</button>
        <button type="button" class="sf-addresses__action-link" style="margin-left:16px;" onclick="document.getElementById('AddAddress').style.display='none';return false;">{{ 'customer.addresses.cancel' | t: default: 'Cancel' }}</button>
      </div>
    {% endform %}
  </div>

  <div class="sf-addresses__grid">
    {%- for address in customer.addresses -%}
      <div class="sf-addresses__card">
        {%- if address == customer.default_address -%}
          <span class="sf-addresses__badge">{{ 'customer.addresses.default' | t: default: 'Default' }}</span>
        {%- endif -%}
        <strong>{{ address.first_name }} {{ address.last_name }}</strong><br>
        {{ address | format_address }}

        <div class="sf-addresses__actions">
          <button type="button" class="sf-addresses__action-link" onclick="document.getElementById('EditAddress_{{ address.id }}').style.display='block';return false;">{{ 'customer.addresses.edit' | t: default: 'Edit' }}</button>
          <form class="address-delete-form" method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" style="display:inline;">
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="sf-addresses__action-link" onclick="return confirm('{{ 'customer.addresses.delete_confirm' | t: default: 'Are you sure you wish to delete this address?' }}');">{{ 'customer.addresses.delete' | t: default: 'Delete' }}</button>
          </form>
        </div>

        <div id="EditAddress_{{ address.id }}" class="sf-addresses__form-wrapper" style="margin-top:24px;margin-bottom:0;">
          <h3 style="font-family:var(--font-heading,inherit);font-size:1.1rem;margin:0 0 16px;">{{ 'customer.addresses.edit_address' | t: default: 'Edit Address' }}</h3>
          {% form 'customer_address', address %}
            <div class="sf-addresses__field">
              <label for="AddressFirstName_{{ form.id }}">{{ 'customer.addresses.first_name' | t: default: 'First Name' }}</label>
              <input type="text" id="AddressFirstName_{{ form.id }}" name="address[first_name]" value="{{ form.first_name }}" class="sf-addresses__input">
            </div>
            <div class="sf-addresses__field">
              <label for="AddressAddress1_{{ form.id }}">{{ 'customer.addresses.address1' | t: default: 'Address 1' }}</label>
              <input type="text" id="AddressAddress1_{{ form.id }}" name="address[address1]" value="{{ form.address1 }}" class="sf-addresses__input">
            </div>
            <div class="sf-addresses__field">
              <label for="AddressCity_{{ form.id }}">{{ 'customer.addresses.city' | t: default: 'City' }}</label>
              <input type="text" id="AddressCity_{{ form.id }}" name="address[city]" value="{{ form.city }}" class="sf-addresses__input">
            </div>
            <div style="margin-top:16px;">
              <button type="submit" class="sf-addresses__btn">{{ 'customer.addresses.update' | t: default: 'Update Address' }}</button>
              <button type="button" class="sf-addresses__action-link" style="margin-left:16px;" onclick="document.getElementById('EditAddress_{{ address.id }}').style.display='none';return false;">{{ 'customer.addresses.cancel' | t: default: 'Cancel' }}</button>
            </div>
          {% endform %}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Addresses Main",
  "tag": "section",
  "class": "section-main-addresses",
  "settings": [],
  "presets": [
    {
      "name": "Addresses Main"
    }
  ]
}
{% endschema %}
