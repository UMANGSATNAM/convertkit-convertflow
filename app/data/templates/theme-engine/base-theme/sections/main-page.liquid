<style>
  #shopify-section-{{ section.id }} .sf-page {
    background: var(--color-bg, #fff);
    color: var(--color-text, #1a1a1a);
    padding: var(--spacing-section-y, 80px) var(--spacing-section-x, 40px);
  }
  #shopify-section-{{ section.id }} .sf-page__layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 60px;
    max-width: 1200px;
    margin: 0 auto;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .sf-page__layout {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .sf-page__sidebar { display: none; }
  }
  #shopify-section-{{ section.id }} .sf-page__header {
    max-width: 1200px;
    margin: 0 auto 48px;
  }
  #shopify-section-{{ section.id }} .sf-page__subtitle {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted, #888);
    margin-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .sf-page__title {
    font-family: var(--font-heading, inherit);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .sf-page__sidebar {
    position: sticky;
    top: 100px;
    align-self: start;
    border-left: 1px solid var(--color-border, #e0e0e0);
    padding-left: 24px;
  }
  #shopify-section-{{ section.id }} .sf-page__sidebar-title {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted, #888);
    margin: 0 0 16px;
  }
  #shopify-section-{{ section.id }} .sf-page__toc-link {
    display: block;
    font-size: 0.85rem;
    color: var(--color-text-muted, #888);
    text-decoration: none;
    padding: 6px 0;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  #shopify-section-{{ section.id }} .sf-page__toc-link:hover,
  #shopify-section-{{ section.id }} .sf-page__toc-link.is-active {
    color: var(--color-primary, #000);
    border-bottom-color: var(--color-primary, #000);
  }
  #shopify-section-{{ section.id }} .sf-page__content {
    min-width: 0;
    line-height: 1.8;
    font-size: 1rem;
  }
  #shopify-section-{{ section.id }} .sf-page__content h2 {
    font-family: var(--font-heading, inherit);
    font-size: 1.3rem;
    font-weight: 500;
    margin: 2.5rem 0 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border, #e0e0e0);
  }
  #shopify-section-{{ section.id }} .sf-page__cta {
    margin-top: 48px;
    padding: 32px;
    border: 1px solid var(--color-border, #e0e0e0);
    text-align: center;
  }
  #shopify-section-{{ section.id }} .sf-page__cta-title {
    font-family: var(--font-heading, inherit);
    font-size: 1.3rem;
    font-weight: 400;
    margin: 0 0 12px;
  }
  #shopify-section-{{ section.id }} .sf-page__cta-desc {
    color: var(--color-text-muted, #888);
    margin: 0 0 24px;
    font-size: 0.95rem;
  }
  #shopify-section-{{ section.id }} .sf-page__cta-btn {
    display: inline-block;
    padding: 14px 32px;
    background: var(--color-primary, #1a1a1a);
    color: var(--color-btn-text, #fff);
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: opacity 0.2s;
  }
  #shopify-section-{{ section.id }} .sf-page__cta-btn:hover { opacity: 0.8; }
</style>

<section
  id="shopify-section-{{ section.id }}"
  class="sf-page"
  data-section-id="{{ section.id }}"
  data-section-type="main-page">

  <div class="sf-page__header">
    {%- if section.settings.subtitle != blank -%}
      <span class="sf-page__subtitle">{{ section.settings.subtitle }}</span>
    {%- endif -%}
    <h1 class="sf-page__title">{{ page.title }}</h1>
  </div>

  <div class="sf-page__layout">
    <aside class="sf-page__sidebar" aria-label="Table of Contents">
      <h2 class="sf-page__sidebar-title">Contents</h2>
      <ul data-toc-list style="list-style:none;padding:0;margin:0;">
        <li><a href="#section-top" class="sf-page__toc-link is-active">Overview</a></li>
      </ul>
    </aside>

    <div class="sf-page__content" id="section-top" data-editorial-body>
      {%- if page.content != blank -%}
        {{ page.content }}
      {%- else -%}
        <p>{{ 'pages.blank.content' | t: default: 'No content available for this page yet.' }}</p>
      {%- endif -%}

      {%- if section.settings.show_cta -%}
        <div class="sf-page__cta">
          <h3 class="sf-page__cta-title">{{ section.settings.cta_title }}</h3>
          <p class="sf-page__cta-desc">{{ section.settings.cta_desc }}</p>
          <a href="{{ section.settings.cta_link | default: '/contact' }}" class="sf-page__cta-btn">
            {{ section.settings.cta_btn_text | default: 'Contact Us' }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function() {
    var container = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!container) return;
    var tocList = container.querySelector('[data-toc-list]');
    var body = container.querySelector('[data-editorial-body]');
    if (!tocList || !body) return;
    var headings = body.querySelectorAll('h2, h3');
    if (headings.length > 0) {
      tocList.innerHTML = '';
      headings.forEach(function(h, i) {
        if (!h.id) h.id = 'sf-section-' + i;
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = '#' + h.id;
        a.className = 'sf-page__toc-link' + (i === 0 ? ' is-active' : '');
        a.textContent = (h.tagName === 'H2' ? '→ ' : '  · ') + h.textContent.trim();
        a.addEventListener('click', function(e) {
          e.preventDefault();
          document.getElementById(h.id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          tocList.querySelectorAll('.sf-page__toc-link').forEach(function(l) { l.classList.remove('is-active'); });
          a.classList.add('is-active');
        });
        li.appendChild(a);
        tocList.appendChild(li);
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Main Page",
  "tag": "section",
  "class": "section-main-page",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Header Subtitle",
      "default": ""
    },
    {
      "type": "header",
      "content": "Inline CTA"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show Footer CTA",
      "default": false
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "CTA Title",
      "default": "Have a question?"
    },
    {
      "type": "textarea",
      "id": "cta_desc",
      "label": "CTA Description",
      "default": "Our team is here to help."
    },
    {
      "type": "text",
      "id": "cta_btn_text",
      "label": "CTA Button Text",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    }
  ],
  "presets": [
    {
      "name": "Main Page"
    }
  ]
}
{% endschema %}
