<style>
  #shopify-section-{{ section.id }} .sf-collections {
    background: var(--color-bg, #fff);
    color: var(--color-text, #1a1a1a);
    padding: var(--spacing-section-y, 80px) var(--spacing-section-x, 40px);
  }
  #shopify-section-{{ section.id }} .sf-collections__header {
    max-width: 1200px;
    margin: 0 auto 48px;
  }
  #shopify-section-{{ section.id }} .sf-collections__title {
    font-family: var(--font-heading, inherit);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 400;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .sf-collections__grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), 1fr);
    gap: 32px 24px;
  }
  @media (max-width: 900px) { #shopify-section-{{ section.id }} .sf-collections__grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 540px) { #shopify-section-{{ section.id }} .sf-collections__grid { grid-template-columns: 1fr; } }
  #shopify-section-{{ section.id }} .sf-collections__item-link {
    display: block;
    text-decoration: none;
    color: var(--color-text, #1a1a1a);
  }
  #shopify-section-{{ section.id }} .sf-collections__img-wrap {
    overflow: hidden;
    background: var(--color-bg-alt, #f5f5f5);
    aspect-ratio: 4 / 3;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .sf-collections__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  #shopify-section-{{ section.id }} .sf-collections__item-link:hover .sf-collections__img { transform: scale(1.04); }
  #shopify-section-{{ section.id }} .sf-collections__item-title {
    font-family: var(--font-heading, inherit);
    font-size: 1rem;
    font-weight: 400;
    margin: 0 0 4px;
    transition: opacity 0.2s;
  }
  #shopify-section-{{ section.id }} .sf-collections__item-link:hover .sf-collections__item-title { opacity: 0.65; }
  #shopify-section-{{ section.id }} .sf-collections__item-count {
    font-size: 0.8rem;
    color: var(--color-text-muted, #888);
  }
</style>

<section
  id="shopify-section-{{ section.id }}"
  class="sf-collections"
  data-section-id="{{ section.id }}"
  data-section-type="list-collections">

  <div class="sf-collections__header">
    <h1 class="sf-collections__title">{{ section.settings.title | default: 'Collections' }}</h1>
  </div>

  <div class="sf-collections__grid" style="--cols: {{ section.settings.columns | default: 3 }}">
    {%- for collection in collections -%}
      <div class="sf-collections__item">
        <a href="{{ collection.url }}" class="sf-collections__item-link" aria-label="{{ collection.title | escape }}">
          <div class="sf-collections__img-wrap">
            {%- if collection.featured_image -%}
              <img
                class="sf-collections__img"
                src="{{ collection.featured_image | img_url: '800x600', crop: 'center' }}"
                alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                loading="lazy"
                width="800"
                height="600"
              >
            {%- else -%}
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--color-text-muted,#888);font-size:0.8rem;">
                {{ collection.title | truncatewords: 3 }}
              </div>
            {%- endif -%}
          </div>
          <h2 class="sf-collections__item-title">{{ collection.title }}</h2>
          {%- if section.settings.show_count -%}
            <span class="sf-collections__item-count">{{ collection.products_count }} {{ 'collections.general.items_count' | t: count: collection.products_count | default: 'products' }}</span>
          {%- endif -%}
        </a>
      </div>
    {%- else -%}
      <p style="color:var(--color-text-muted,#888);">{{ 'sections.collection_list.empty' | t: default: 'No collections available.' }}</p>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "List Collections",
  "tag": "section",
  "class": "section-list-collections",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Collections"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show Product Count",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "List Collections"
    }
  ]
}
{% endschema %}
