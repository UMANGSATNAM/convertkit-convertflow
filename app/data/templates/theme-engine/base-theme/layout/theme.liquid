<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_accent | default: '#2563EB' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags -%} &ndash; tagged "{{ current_tags | join: ', ' }}"{%- endif -%}
      {%- if current_page != 1 -%} &ndash; Page {{ current_page }}{%- endif -%}
      {%- unless page_title contains shop.name -%} &ndash; {{ shop.name }}{%- endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <!-- OpenGraph & Twitter Meta Tags -->
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="website">
    {% if page_description %}
      <meta property="og:description" content="{{ page_description | escape }}">
    {% endif %}

    <!-- Schema.org Organization JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ request.origin | append: page.url | json }}
      }
    </script>

    <!-- Global CSS Design Tokens & Theme Variables -->
    <style>
      :root {
        --color-primary: {{ settings.color_primary | default: '#111827' }};
        --color-secondary: {{ settings.color_secondary | default: '#4B5563' }};
        --color-accent: {{ settings.color_accent | default: '#2563EB' }};
        --color-bg: {{ settings.color_bg | default: '#FFFFFF' }};
        --color-bg-secondary: {{ settings.color_bg_secondary | default: '#F9FAFB' }};
        --color-surface: {{ settings.color_surface | default: '#FFFFFF' }};
        --color-text: {{ settings.color_text | default: '#111827' }};
        --color-text-muted: {{ settings.color_text_muted | default: '#6B7280' }};
        --color-border: {{ settings.color_border | default: '#E5E7EB' }};
        --color-sale: {{ settings.color_sale | default: '#DC2626' }};
        --color-star: {{ settings.color_star | default: '#F59E0B' }};

        --font-heading: {{ settings.font_heading.family | default: 'Inter' }}, sans-serif;
        --font-body: {{ settings.font_body.family | default: 'Inter' }}, sans-serif;
        --font-base-size: {{ settings.font_base_size | default: 15 }}px;

        --page-width: {{ settings.page_width | default: 1280 }}px;
        --radius-button: {{ settings.radius_button | default: 8 }}px;
        --radius-card: {{ settings.radius_card | default: 12 }}px;
        --radius-badge: {{ settings.radius_badge | default: 99 }}px;
      }
    </style>

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;700&display=swap">

    <!-- Structural Layout Styling -->
    {{ 'base-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'responsive.css' | asset_url | stylesheet_tag }}
    {{ 'predictive-search.css' | asset_url | stylesheet_tag }}

    <!-- Global JavaScript Engine & Utilities -->
    <script>
      window.ConvertFlow = window.ConvertFlow || {};
      window.ConvertFlow.shop = {{ shop.permanent_domain | json }};
      window.ConvertFlow.activePromo = {{ settings.active_promo_code | default: 'FIRST10' | json }};
      window.ConvertFlow.freeShippingThreshold = {{ settings.free_shipping_threshold | default: '999' | json }};
    </script>

    <!-- Shared behaviour modules. Deferred: they never block first paint. -->
    <script src="{{ 'utils.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'countdown.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="theme-layout-body">
    <a href="#MainContent" class="skip-to-content-link visually-hidden">Skip to content</a>

    <!-- Header Section Group -->
    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Footer Section Group -->
    {% sections 'footer-group' %}

    <!-- Optional Global App Elements -->
    {%- comment -%} ConvertFlow dynamic elements {%- endcomment -%}

    <!-- Global Wishlist Drawer -->
    {% render 'wishlist-drawer' %}

    <!-- Records the current product into the shared recently-viewed store -->
    {% render 'recently-viewed-track' %}

    <!-- Global Toast Notification Container -->
    <div id="cf-toast" class="cf-toast-notification" aria-live="polite"></div>

    <style>
      .cf-toast-notification {
        position: fixed; bottom: 24px; right: 24px; z-index: 99999;
        background: var(--color-primary, #111827); color: #FFFFFF;
        padding: 12px 20px; border-radius: var(--radius-button, 8px);
        font-size: 14px; font-weight: 600; box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        transform: translateY(100px); opacity: 0; transition: all 0.3s ease;
      }
      .cf-toast-notification.active { transform: translateY(0); opacity: 1; }
    </style>

    <script>
      // Global Event Bus & Toast System
      document.addEventListener('toast:show', function(e) {
        var toast = document.getElementById('cf-toast');
        if (!toast) return;
        toast.textContent = e.detail && e.detail.message ? e.detail.message : 'Action completed!';
        toast.classList.add('active');
        setTimeout(function() { toast.classList.remove('active'); }, 3000);
      });
    </script>
  </body>
</html>
