{% comment %}
  Universal Cart Drawer Item Snippet
  Accepts: item (Liquid cart item object)
{% endcomment %}

{% if item != blank %}
  <div class="cf-cart-item" data-key="{{ item.key }}" style="display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--color-border, #E5E7EB);">
    <a href="{{ item.url }}" class="cf-cart-item__media" style="width: 70px; height: 70px; flex-shrink: 0; border-radius: 8px; overflow: hidden; background: #F3F4F6;">
      {% if item.image %}
        <img height="{{ item.image.height }}" width="{{ item.image.width }}" src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
      {% endif %}
    </a>

    <div class="cf-cart-item__details" style="flex-grow: 1;">
      <a href="{{ item.url }}" style="font-size: 13px; font-weight: 600; color: var(--color-text, #111827); text-decoration: none; display: block;">{{ item.product.title }}</a>
      {% if item.variant.title != 'Default Title' %}
        <div style="font-size: 12px; color: var(--color-text-muted, #6B7280); margin-top: 2px;">{{ item.variant.title }}</div>
      {% endif %}

      <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 8px;">
        {% render 'quantity-input', quantity: item.quantity, input_name: 'updates[]' %}
        <div style="font-size: 14px; font-weight: 700; color: var(--color-text, #111827);">
          {{ item.final_line_price | money }}
        </div>
      </div>
    </div>
  </div>
{% endif %}
