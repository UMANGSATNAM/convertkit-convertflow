{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V66 — RETRO HANDHELD GAMING & HARDWARE D2C (ANALOGUE / MIYOO STYLE)
  Usage: {% render 'card-v66', product: product %}
  Design: Retro Gold (#D97706), Dark Cyber (#09090B), Bricolage Grotesque & Plus Jakarta Sans fonts, 8px card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .cv66-card {
    --cv66-bg: #FFFFFF;
    --cv66-text: #09090B;
    --cv66-muted: #D97706;
    --cv66-gold: #D97706;
    --cv66-dark: #09090B;
    --cv66-light: #FEF3C7;
    --cv66-border: #FDE68A;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cv66-bg);
    border: 1px solid var(--cv66-border);
    border-radius: 8px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv66-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv66-gold);
    box-shadow: 0 12px 24px -6px rgba(217, 119, 6, 0.25);
  }

  .cv66-card *, .cv66-card *::before, .cv66-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv66-card a { color: inherit; text-decoration: none; }
  .cv66-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv66-card img { max-width: 100%; display: block; }

  .cv66-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: #09090B;
    overflow: hidden;
  }
  .cv66-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv66-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv66-card:hover .cv66-img-pri { opacity: 0; }
  .cv66-card:hover .cv66-img-sec { opacity: 1; transform: scale(1.05); }

  /* Retro Tag Top Left */
  .cv66-badge-arcade {
    position: absolute; top: 10px; left: 10px;
    background: var(--cv66-gold); color: #09090B;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 9px; font-weight: 800; text-transform: uppercase;
    padding: 4px 9px; border-radius: 4px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv66-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #09090B; border: 1px solid var(--cv66-gold);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv66-gold); z-index: 3; transition: all 0.2s ease;
  }
  .cv66-wish:hover, .cv66-wish.active { background: var(--cv66-gold); color: #09090B; transform: scale(1.1); }

  /* Quick View Overlay */
  .cv66-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(217, 119, 6, 0.95); color: #09090B;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    text-align: center; border-radius: 4px; border: 1px solid var(--cv66-gold);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv66-card:hover .cv66-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv66-qv-overlay:hover { background: #09090B; color: #D97706; }

  .cv66-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: left; }
  .cv66-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv66-gold); font-weight: 800; font-family: 'Bricolage Grotesque', sans-serif; letter-spacing: 0.08em; }
  .cv66-title { font-family: 'Bricolage Grotesque', sans-serif; font-size: 16px; font-weight: 800; color: #09090B; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Gaming Specs Subtitle */
  .cv66-specs { font-size: 11px; color: #71717A; font-weight: 600; }

  /* Rating Row */
  .cv66-rating { display: flex; align-items: center; gap: 4px; font-size: 11px; color: #D97706; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv66-price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv66-price { font-family: 'Bricolage Grotesque', sans-serif; font-size: 17px; font-weight: 800; color: #09090B; }
  .cv66-cmp { font-size: 13px; color: #A1A1AA; text-decoration: line-through; }
  .cv66-disc { font-size: 10px; font-weight: 800; color: #09090B; background: var(--cv66-light); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--cv66-border); }

  /* Shell Color Swatches */
  .cv66-swatches { display: flex; gap: 6px; align-items: center; margin-top: 4px; }
  .cv66-swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--cv66-border); cursor: pointer; }
  .cv66-swatch.active { transform: scale(1.25); border-color: var(--cv66-gold); }

  /* Bottom Button */
  .cv66-action-box { padding: 0 14px 14px; }
  .cv66-atc-btn {
    width: 100%; padding: 11px;
    background: #09090B; color: #D97706;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 4px; border: 1px solid #D97706; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(217, 119, 6, 0.25);
  }
  .cv66-atc-btn:hover { background: #D97706; color: #09090B; transform: scale(1.01); }
  .cv66-atc-btn:disabled { background: #E4E4E7; color: #A1A1AA; border-color: #D4D4D8; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv66-card" data-product-id="{{ card_prod.id }}">
    <span class="cv66-badge-arcade">FPGA RETRO HARDWARE 🕹️</span>

    <button type="button" class="cv66-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv66-media">
      {% if card_prod.featured_image %}
        <img src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv66-img cv66-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv66-img cv66-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-6' | placeholder_svg_tag: 'cv66-img' }}
      {% endif %}

      <button type="button" class="cv66-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv66-content">
      {% if card_prod.vendor != blank %}<span class="cv66-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv66-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv66-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv66-specs">Plays Game Boy, GBA, NES | 6-Hour Battery</span>

      <div class="cv66-rating">
        <span>★ 4.9</span> <span>(6,400 reviews)</span>
      </div>

      <div class="cv66-price-row">
        <span class="cv66-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv66-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv66-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      {% if card_prod.variants.size > 1 %}
        <div class="cv66-swatches">
          {% for variant in card_prod.variants limit: 3 %}
            <span class="cv66-swatch {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}" style="background: {% cycle '#D97706', '#8B5CF6', '#E2E8F0' %};"></span>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="cv66-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv66-atc-btn" data-add-cart="{{ cur_var.id }}">INSERT COIN & PLAY</button>
      {% else %}
        <button type="button" class="cv66-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv66-card">
    <div class="cv66-media">{{ 'product-6' | placeholder_svg_tag: 'cv66-img' }}</div>
    <div class="cv66-content">
      <span class="cv66-vendor">RETRO GAMING D2C</span>
      <div class="cv66-title">Pocket Retro Handheld Console w/ 3.5" IPS Screen</div>

      {% if card_r_show != false %}
      <div class="cv66-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv66-specs">Plays Game Boy, GBA, NES | 6-Hour Battery</span>
      <div class="cv66-price-row"><span class="cv66-price">₹ 12,999</span><span class="cv66-cmp">₹ 15,999</span><span class="cv66-disc">18% OFF</span></div>
    </div>
  </div>
{% endif %}
