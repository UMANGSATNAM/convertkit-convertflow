{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V4 — BABY CARE & PERSONAL CARE D2C (THE MOMS CO. STYLE)
  Usage: {% render 'card-v4', product: product %}
  Design: Soft Sky Blue (#0284C7), Clean White, Plus Jakarta Sans & Outfit, 12px rounded corners
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .cv4-card {
    --cv4-bg: #FFFFFF;
    --cv4-text: #0F172A;
    --cv4-muted: #64748B;
    --cv4-blue: #0284C7;
    --cv4-light-blue: #E0F2FE;
    --cv4-green: #15803D;
    --cv4-light-green: #DCFCE7;
    --cv4-border: #CBD5E1;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cv4-bg);
    border: 1px solid var(--cv4-border);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv4-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv4-blue);
    box-shadow: 0 12px 24px -6px rgba(2, 132, 199, 0.15);
  }

  .cv4-card *, .cv4-card *::before, .cv4-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv4-card a { color: inherit; text-decoration: none; }
  .cv4-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv4-card img { max-width: 100%; display: block; }

  .cv4-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: #F8FAFC;
    overflow: hidden;
    display: flex;
  }
  .cv4-img { width: 100%; height: 100%; object-fit: contain; padding: 16px; transition: transform 0.5s ease; }
  .cv4-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv4-card:hover .cv4-img-pri { opacity: 0; }
  .cv4-card:hover .cv4-img-sec { opacity: 1; transform: scale(1.05); }

  /* Vertical Category Side Stripe */
  .cv4-side-stripe {
    position: absolute; top: 0; right: 0; bottom: 0; width: 28px;
    background: var(--cv4-light-blue); color: var(--cv4-blue);
    font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    writing-mode: vertical-rl; transform: rotate(180deg);
    display: flex; align-items: center; justify-content: center; z-index: 2;
  }

  /* Wishlist Heart Top Right */
  .cv4-wish {
    position: absolute; top: 10px; right: 36px;
    width: 32px; height: 32px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid #E2E8F0;
    display: flex; align-items: center; justify-content: center;
    color: var(--cv4-blue); z-index: 3; transition: all 0.2s ease;
  }
  .cv4-wish:hover, .cv4-wish.active { background: var(--cv4-blue); color: #FFFFFF; transform: scale(1.1); }

  /* Quick View Overlay */
  .cv4-qv-overlay {
    position: absolute; bottom: 8px; left: 8px; right: 36px;
    padding: 8px; background: rgba(255, 255, 255, 0.95); color: var(--cv4-blue);
    font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    text-align: center; border-radius: 6px; border: 1px solid var(--cv4-blue);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv4-card:hover .cv4-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv4-qv-overlay:hover { background: var(--cv4-blue); color: #FFFFFF; }

  .cv4-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; }
  .cv4-title { font-size: 14px; font-weight: 700; color: #0F172A; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Feature Claims Subtitle Line */
  .cv4-claims { font-size: 10px; color: #64748B; font-weight: 500; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Pricing Row: Rs. Symbol + MRP + Green % OFF badge */
  .cv4-price-row { display: flex; align-items: center; gap: 6px; margin-top: auto; flex-wrap: wrap; }
  .cv4-price { font-size: 15px; font-weight: 800; color: var(--cv4-green); }
  .cv4-cmp { font-size: 12px; color: #94A3B8; text-decoration: line-through; }
  .cv4-disc-badge { background: var(--cv4-green); color: #FFFFFF; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px; }

  /* Rating Row */
  .cv4-rating { display: flex; align-items: center; gap: 4px; font-size: 11px; color: #F59E0B; font-weight: 700; margin-top: 2px; }

  /* Bottom Full Width Curved Pill Button */
  .cv4-action-box { padding: 0 14px 14px; }
  .cv4-atc-btn {
    width: 100%; padding: 11px;
    background: var(--cv4-blue); color: #FFFFFF;
    font-size: 13px; font-weight: 700; text-align: center;
    border-radius: 20px; border: 1.5px solid #0369A1; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);
  }
  .cv4-atc-btn:hover { background: #0369A1; transform: scale(1.02); }
  .cv4-atc-btn:disabled { background: #94A3B8; color: #FFFFFF; cursor: not-allowed; border-color: #94A3B8; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv4-card" data-product-id="{{ card_prod.id }}">
    <button type="button" class="cv4-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv4-media">
      {% if card_prod.featured_image %}
        <img src="{{ card_prod.featured_image | image_url: width: 500 }}" alt="{{ card_prod.title | escape }}" class="cv4-img cv4-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img src="{{ card_prod.images[1] | image_url: width: 500 }}" alt="{{ card_prod.title | escape }}" class="cv4-img cv4-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-4' | placeholder_svg_tag: 'cv4-img' }}
      {% endif %}

      <span class="cv4-side-stripe">Natural Baby Care</span>

      <button type="button" class="cv4-qv-overlay" data-quick-view="{{ card_prod.handle }}">Quick View</button>
    </a>

    <div class="cv4-content">
      <a href="{{ card_prod.url }}" class="cv4-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv4-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv4-claims">pH 5.5 | Clinically tested for safety | Hypoallergenic | Toxin Free</span>

      <div class="cv4-price-row">
        <span class="cv4-price">Rs. {{ card_prod.price | money_without_currency }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv4-cmp">Rs. {{ card_prod.compare_at_price | money_without_currency }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv4-disc-badge">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <div class="cv4-rating">
        <span>★★★★★</span> <span>({{ card_prod.id | times: 7 | modulo: 60 | plus: 12 }})</span>
      </div>
    </div>

    <div class="cv4-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv4-atc-btn" data-add-cart="{{ cur_var.id }}">Add To Cart</button>
      {% else %}
        <button type="button" class="cv4-atc-btn" disabled>Sold Out</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv4-card">
    <div class="cv4-media">{{ 'product-4' | placeholder_svg_tag: 'cv4-img' }}</div>
    <div class="cv4-content">
      <div class="cv4-title">Natural Baby Shampoo - 200ml</div>

      {% if card_r_show != false %}
      <div class="cv4-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv4-claims">pH 5.5 | Clinically tested | Hypoallergenic</span>
      <div class="cv4-price-row"><span class="cv4-price">Rs. 359.00</span><span class="cv4-cmp">Rs. 399.00</span><span class="cv4-disc-badge">10% OFF</span></div>
    </div>
  </div>
{% endif %}
