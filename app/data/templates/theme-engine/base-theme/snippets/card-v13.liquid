{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V13 — PREMIUM AUDIO & SMART WEARABLES D2C (BOAT / NOISE STYLE)
  Usage: {% render 'card-v13', product: product %}
  Design: High-Tech Charcoal (#111827), Electric Red (#EF4444), Montserrat & Inter fonts, 8px sharp corners
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@700;800&display=swap');

  .cv13-card {
    --cv13-bg: #FFFFFF;
    --cv13-text: #111827;
    --cv13-muted: #6B7280;
    --cv13-red: #EF4444;
    --cv13-light-red: #FEE2E2;
    --cv13-border: #E5E7EB;
    font-family: 'Inter', sans-serif;
    background: var(--cv13-bg);
    border: 1px solid var(--cv13-border);
    border-radius: 8px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv13-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv13-red);
    box-shadow: 0 12px 24px -6px rgba(239, 68, 68, 0.2);
  }

  .cv13-card *, .cv13-card *::before, .cv13-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv13-card a { color: inherit; text-decoration: none; }
  .cv13-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv13-card img { max-width: 100%; display: block; }

  .cv13-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: #F9FAFB;
    overflow: hidden;
  }
  .cv13-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv13-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv13-card:hover .cv13-img-pri { opacity: 0; }
  .cv13-card:hover .cv13-img-sec { opacity: 1; transform: scale(1.05); }

  /* Audio Tag Top Left */
  .cv13-badge-audio {
    position: absolute; top: 10px; left: 10px;
    background: #111827; color: var(--cv13-red);
    font-family: 'Montserrat', sans-serif; font-size: 9px; font-weight: 800; text-transform: uppercase;
    padding: 4px 9px; border-radius: 4px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv13-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid #E5E7EB;
    display: flex; align-items: center; justify-content: center;
    color: var(--cv13-red); z-index: 3; transition: all 0.2s ease;
  }
  .cv13-wish:hover, .cv13-wish.active { background: var(--cv13-red); color: #FFFFFF; border-color: var(--cv13-red); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv13-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(17, 24, 39, 0.95); color: #FFFFFF;
    font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    text-align: center; border-radius: 6px; border: 1px solid var(--cv13-red);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv13-card:hover .cv13-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv13-qv-overlay:hover { background: var(--cv13-red); color: #FFFFFF; }

  .cv13-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; }
  .cv13-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv13-red); font-weight: 800; font-family: 'Montserrat', sans-serif; letter-spacing: 0.08em; }
  .cv13-title { font-family: 'Montserrat', sans-serif; font-size: 15px; font-weight: 800; color: #111827; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Tech Spec Subtitle */
  .cv13-specs { font-size: 11px; color: var(--cv13-muted); font-weight: 500; }

  /* Rating Row */
  .cv13-rating { display: flex; align-items: center; gap: 4px; font-size: 11px; color: #EF4444; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv13-price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv13-price { font-family: 'Montserrat', sans-serif; font-size: 17px; font-weight: 800; color: #111827; }
  .cv13-cmp { font-size: 13px; color: #9CA3AF; text-decoration: line-through; }
  .cv13-disc { font-size: 10px; font-weight: 800; color: var(--cv13-red); background: var(--cv13-light-red); padding: 2px 6px; border-radius: 4px; }

  /* Color Swatches */
  .cv13-swatches { display: flex; gap: 6px; align-items: center; margin-top: 4px; }
  .cv13-swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid #E5E7EB; cursor: pointer; }
  .cv13-swatch.active { transform: scale(1.25); border-color: var(--cv13-red); }

  /* Bottom Button */
  .cv13-action-box { padding: 0 14px 14px; }
  .cv13-atc-btn {
    width: 100%; padding: 11px;
    background: var(--cv13-red); color: #FFFFFF;
    font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 6px; border: none; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.35);
  }
  .cv13-atc-btn:hover { background: #DC2626; transform: scale(1.01); }
  .cv13-atc-btn:disabled { background: #E5E7EB; color: #9CA3AF; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv13-card" data-product-id="{{ card_prod.id }}">
    <span class="cv13-badge-audio">40 HRS PLAYBACK 🎧</span>

    <button type="button" class="cv13-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv13-media">
      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv13-img cv13-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img height="{{ card_prod.images[1].height }}" width="{{ card_prod.images[1].width }}" src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv13-img cv13-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-5' | placeholder_svg_tag: 'cv13-img' }}
      {% endif %}

      <button type="button" class="cv13-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv13-content">
      {% if card_prod.vendor != blank %}<span class="cv13-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv13-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv13-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv13-specs">ENx™ Tech Clarity | Beast™ Mode Low Latency</span>

      <div class="cv13-rating">
        <span>★ 4.8</span> <span>(12,400 reviews)</span>
      </div>

      <div class="cv13-price-row">
        <span class="cv13-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv13-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv13-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      {% if card_prod.variants.size > 1 %}
        <div class="cv13-swatches">
          {% for variant in card_prod.variants limit: 4 %}
            <span class="cv13-swatch {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}" style="background: {% cycle '#111827', '#1E40AF', '#F3F4F6', '#EF4444' %};"></span>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="cv13-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv13-atc-btn" data-add-cart="{{ cur_var.id }}">CLAIM YOUR AUDIO</button>
      {% else %}
        <button type="button" class="cv13-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv13-card">
    <div class="cv13-media">{{ 'product-5' | placeholder_svg_tag: 'cv13-img' }}</div>
    <div class="cv13-content">
      <span class="cv13-vendor">AUDIO TECH D2C</span>
      <div class="cv13-title">Airdopes 141 ANC TWS Earbuds w/ 32dB ANC</div>

      {% if card_r_show != false %}
      <div class="cv13-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv13-specs">ENx™ Tech Clarity | Beast™ Mode Low Latency</span>
      <div class="cv13-price-row"><span class="cv13-price">₹ 1,499</span><span class="cv13-cmp">₹ 4,490</span><span class="cv13-disc">66% OFF</span></div>
    </div>
  </div>
{% endif %}
