{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V1 — ETHNIC WOMEN'S FASHION D2C (HOUSE OF CHIKANKARI / KURTA STYLE)
  Usage: {% render 'card-v1', product: product %}
  Design: Soft Rose Cream (#FFF5F5), Teal Accent (#3DA298), Playfair Display & Outfit fonts, 12px rounded corners
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap');

  .cv1-card {
    --cv1-bg: #FFFFFF;
    --cv1-text: #222222;
    --cv1-muted: #777777;
    --cv1-teal: #3DA298;
    --cv1-teal-hover: #2E8179;
    --cv1-red: #D94638;
    --cv1-border: #EEEEEE;
    font-family: 'Outfit', sans-serif;
    background: var(--cv1-bg);
    border: 1px solid var(--cv1-border);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv1-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -6px rgba(0, 0, 0, 0.1);
  }

  .cv1-card *, .cv1-card *::before, .cv1-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv1-card a { color: inherit; text-decoration: none; }
  .cv1-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv1-card img { max-width: 100%; display: block; }

  /* Media & Image Container */
  .cv1-media {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    background: #FDF4F4;
    overflow: hidden;
  }
  .cv1-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .cv1-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv1-card:hover .cv1-img-pri { opacity: 0; }
  .cv1-card:hover .cv1-img-sec { opacity: 1; transform: scale(1.05); }

  /* Floating Heart Top Left */
  .cv1-wish {
    position: absolute; top: 12px; left: 12px;
    width: 36px; height: 36px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid #E5E5E5;
    display: flex; align-items: center; justify-content: center;
    color: #444; z-index: 3; box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    transition: all 0.2s ease;
  }
  .cv1-wish:hover, .cv1-wish.active { background: #FFF0F0; color: var(--cv1-red); border-color: var(--cv1-red); transform: scale(1.1); }

  /* Hover Quick View Overlay at bottom of image */
  .cv1-qv-overlay {
    position: absolute; bottom: 12px; left: 12px; right: 12px;
    padding: 10px; background: rgba(255, 255, 255, 0.7);
    color: #333333; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    text-align: center; border-radius: 4px; backdrop-filter: blur(6px);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4; border: 1px solid rgba(255,255,255,0.8);
  }
  .cv1-card:hover .cv1-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv1-qv-overlay:hover { background: rgba(255, 255, 255, 0.95); color: var(--cv1-teal); }

  /* Card Content Details */
  .cv1-content { padding: 14px 14px 10px; display: flex; flex-direction: column; gap: 8px; flex-grow: 1; }
  .cv1-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv1-teal); font-weight: 700; letter-spacing: 0.08em; }
  .cv1-title { font-family: 'Outfit', sans-serif; font-size: 14px; font-weight: 500; color: #222222; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Price Row: ₹ Rupee Symbol + Strike MRP + % off */
  .cv1-price-row { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; margin-top: 2px; }
  .cv1-price { font-size: 16px; font-weight: 700; color: #222222; }
  .cv1-cmp { font-size: 13px; color: #888888; text-decoration: line-through; }
  .cv1-disc { font-size: 12px; font-weight: 600; color: var(--cv1-red); }

  /* Size Selector Pills */
  .cv1-size-box { display: flex; flex-direction: column; gap: 4px; margin-top: 4px; }
  .cv1-size-lbl { font-size: 12px; color: #555555; font-weight: 500; }
  .cv1-size-pills { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 2px; }
  .cv1-size-pill {
    font-size: 11px; font-weight: 500; padding: 4px 14px; border-radius: 20px;
    border: 1px solid #D1D5DB; color: #333333; background: #FFFFFF; cursor: pointer; transition: all 0.2s ease;
  }
  .cv1-size-pill.active, .cv1-size-pill:hover { border-color: #222222; background: #222222; color: #FFFFFF; }

  /* Bottom Add to Cart Button */
  .cv1-action-box { padding: 0 14px 14px; }
  .cv1-atc-btn {
    width: 100%; padding: 12px;
    background: var(--cv1-teal); color: #FFFFFF;
    font-size: 14px; font-weight: 600; text-align: center;
    border-radius: 8px; border: none; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(61, 162, 152, 0.25);
  }
  .cv1-atc-btn:hover { background: var(--cv1-teal-hover); transform: scale(1.01); }
  .cv1-atc-btn:disabled { background: #CCCCCC; color: #777777; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv1-card" data-product-id="{{ card_prod.id }}">
    <!-- Top Left Floating Heart -->
    <button type="button" class="cv1-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <!-- Media / Image Section -->
    <a href="{{ card_prod.url }}" class="cv1-media">
      {% if card_prod.featured_image %}
        <img src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv1-img cv1-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv1-img cv1-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'cv1-img' }}
      {% endif %}

      <button type="button" class="cv1-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <!-- Details Content -->
    <div class="cv1-content">
      {% if card_prod.vendor != blank %}<span class="cv1-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv1-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv1-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}

      <!-- Pricing Row (INR format) -->
      <div class="cv1-price-row">
        <span class="cv1-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv1-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv1-disc">{{ save_pct }}% off</span>
        {% endif %}
      </div>

      <!-- Size Selector -->
      <div class="cv1-size-box">
        <span class="cv1-size-lbl">Size</span>
        <div class="cv1-size-pills">
          {% for variant in card_prod.variants limit: 5 %}
            <button type="button" class="cv1-size-pill {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- Bottom Add to Cart -->
    <div class="cv1-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv1-atc-btn" data-add-cart="{{ cur_var.id }}">Add to cart</button>
      {% else %}
        <button type="button" class="cv1-atc-btn" disabled>Sold Out</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv1-card">
    <button type="button" class="cv1-wish" aria-label="Add to wishlist">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>
    <div class="cv1-media">
      {{ 'product-1' | placeholder_svg_tag: 'cv1-img' }}
      <button type="button" class="cv1-qv-overlay">QUICK VIEW</button>
    </div>
    <div class="cv1-content">
      <span class="cv1-vendor">GLOSSIER CLEAN BEAUTY</span>
      <div class="cv1-title">Ultra-Hydrating Botanical Dew Drops Serum</div>

      {% if card_r_show != false %}
      <div class="cv1-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <div class="cv1-price-row">
        <span class="cv1-price">₹ 1,850</span>
        <span class="cv1-cmp">₹ 2,400</span>
        <span class="cv1-disc">23% off</span>
      </div>
      <div class="cv1-size-box">
        <span class="cv1-size-lbl">Size</span>
        <div class="cv1-size-pills">
          <button type="button" class="cv1-size-pill active">30ml</button>
          <button type="button" class="cv1-size-pill">50ml</button>
          <button type="button" class="cv1-size-pill">100ml</button>
        </div>
      </div>
    </div>
    <div class="cv1-action-box">
      <button type="button" class="cv1-atc-btn">ADD TO GLOW BAG</button>
    </div>
  </div>
{% endif %}
