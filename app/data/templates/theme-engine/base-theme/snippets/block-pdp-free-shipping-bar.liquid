<div class="sf-pdp-free-shipping sf-stagger-item" {{ block.shopify_attributes }}>
                  <div class="sf-free-shipping-text">Add <strong id="sf-free-ship-remaining-{{ section.id }}">{{ 50000 | minus: current_variant.price | money }}</strong> more for <strong>FREE shipping</strong></div>
                  <div class="sf-urgency-progress"><div class="sf-urgency-fill" id="sf-free-ship-bar-{{ section.id }}" style="width: {{ current_variant.price | times: 100 | divided_by: 50000 }}%;"></div></div>
                </div>
