{% comment %}
  Universal Media Gallery Snippet
  Accepts: product (Liquid product object)
{% endcomment %}

{% assign gallery_prod = product %}

<div class="cf-media-gallery" style="display: flex; flex-direction: column; gap: 12px;">
  {% if gallery_prod != blank and gallery_prod.featured_image != blank %}
    <div class="cf-media-gallery__main" style="width: 100%; aspect-ratio: 4/5; border-radius: var(--radius-card, 12px); overflow: hidden; background: #F3F4F6;">
      <img id="CFMainProductImage" src="{{ gallery_prod.featured_image | image_url: width: 800 }}" alt="{{ gallery_prod.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
    </div>

    {% if gallery_prod.images.size > 1 %}
      <div class="cf-media-gallery__thumbs" style="display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px;">
        {% for img in gallery_prod.images limit: 6 %}
          <button type="button" onclick="document.getElementById('CFMainProductImage').src = '{{ img | image_url: width: 800 }}'" style="width: 60px; height: 60px; border-radius: 8px; overflow: hidden; border: 1px solid #E5E7EB; background: #F3F4F6; cursor: pointer; flex-shrink: 0; padding: 0;">
            <img src="{{ img | image_url: width: 120 }}" alt="Thumbnail" style="width: 100%; height: 100%; object-fit: cover;">
          </button>
        {% endfor %}
      </div>
    {% endif %}

  {% else %}

    <div class="cf-media-gallery__main" style="width: 100%; aspect-ratio: 4/5; border-radius: var(--radius-card, 12px); overflow: hidden; background: #F3F4F6;">
      {{ 'product-1' | placeholder_svg_tag: 'cf-media-placeholder' }}
    </div>

  {% endif %}
</div>
