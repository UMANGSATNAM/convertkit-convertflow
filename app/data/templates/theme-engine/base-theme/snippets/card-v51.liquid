{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V51 — INSTANT GOURMET RAMEN & NOODLE BOWLS D2C (IMMI RAMEN / FLY BY JING STYLE)
  Usage: {% render 'card-v51', product: product %}
  Design: Neon Pink (#FF0055), Cyber Yellow (#FFD600), Space Grotesk & Orbitron fonts, 4px card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@800;900&family=Space+Grotesk:wght@500;600;700&display=swap');

  .cv51-card {
    --cv51-bg: #0D0D11;
    --cv51-card-bg: #16161E;
    --cv51-text: #FFFFFF;
    --cv51-pink: #FF0055;
    --cv51-yellow: #FFD600;
    --cv51-border: #FF0055;
    font-family: 'Space Grotesk', sans-serif;
    background: var(--cv51-card-bg);
    border: 2px solid var(--cv51-border);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv51-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 20px rgba(255, 0, 85, 0.4);
  }

  .cv51-card *, .cv51-card *::before, .cv51-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv51-card a { color: inherit; text-decoration: none; }
  .cv51-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv51-card img { max-width: 100%; display: block; }

  .cv51-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: #09090C;
    overflow: hidden;
    border-bottom: 2px solid var(--cv51-border);
  }
  .cv51-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv51-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv51-card:hover .cv51-img-pri { opacity: 0; }
  .cv51-card:hover .cv51-img-sec { opacity: 1; transform: scale(1.06); }

  /* Cyber Tag Top Left */
  .cv51-badge-ramen {
    position: absolute; top: 10px; left: 10px;
    background: var(--cv51-yellow); color: #0D0D11;
    font-family: 'Orbitron', sans-serif; font-size: 9px; font-weight: 900; text-transform: uppercase;
    padding: 4px 8px; border-radius: 2px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv51-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #0D0D11; border: 2px solid var(--cv51-pink);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv51-pink); z-index: 3; transition: all 0.2s ease;
  }
  .cv51-wish:hover, .cv51-wish.active { background: var(--cv51-pink); color: #FFFFFF; transform: scale(1.1); }

  /* Quick View Overlay */
  .cv51-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(255, 0, 85, 0.95); color: #FFFFFF;
    font-family: 'Orbitron', sans-serif; font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em;
    text-align: center; border-radius: 2px; border: 1px solid var(--cv51-yellow);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv51-card:hover .cv51-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv51-qv-overlay:hover { background: var(--cv51-yellow); color: #0D0D11; }

  .cv51-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: left; }
  .cv51-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv51-yellow); font-weight: 700; font-family: 'Orbitron', sans-serif; letter-spacing: 0.08em; }
  .cv51-title { font-family: 'Space Grotesk', sans-serif; font-size: 16px; font-weight: 700; color: #FFFFFF; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Noodle Specs Subtitle */
  .cv51-specs { font-size: 11px; color: #9CA3AF; font-weight: 500; }

  /* Rating Row */
  .cv51-rating { display: flex; align-items: center; gap: 4px; font-size: 11px; color: var(--cv51-yellow); font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv51-price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv51-price { font-family: 'Orbitron', sans-serif; font-size: 17px; font-weight: 800; color: #FFFFFF; }
  .cv51-cmp { font-size: 13px; color: #6B7280; text-decoration: line-through; }
  .cv51-disc { font-size: 10px; font-weight: 900; color: #0D0D11; background: var(--cv51-yellow); padding: 2px 6px; border-radius: 2px; }

  /* Spice Level Selector */
  .cv51-sizes { display: flex; gap: 6px; overflow-x: auto; margin-top: 4px; }
  .cv51-size-btn {
    font-size: 10px; font-weight: 700; padding: 4px 8px; border-radius: 2px;
    border: 1px solid var(--cv51-pink); background: #0D0D11; color: #FFFFFF; cursor: pointer; transition: all 0.2s ease;
  }
  .cv51-size-btn.active, .cv51-size-btn:hover { background: #FF0055; color: #FFFFFF; }

  /* Bottom Button */
  .cv51-action-box { padding: 0 14px 14px; }
  .cv51-atc-btn {
    width: 100%; padding: 11px;
    background: var(--cv51-pink); color: #FFFFFF;
    font-family: 'Orbitron', sans-serif; font-size: 11px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em;
    border-radius: 2px; border: none; transition: all 0.2s ease;
    box-shadow: 0 0 12px rgba(255, 0, 85, 0.4);
  }
  .cv51-atc-btn:hover { background: var(--cv51-yellow); color: #0D0D11; transform: scale(1.01); }
  .cv51-atc-btn:disabled { background: #374151; color: #9CA3AF; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv51-card" data-product-id="{{ card_prod.id }}">
    <span class="cv51-badge-ramen">INSTANT GOURMET RAMEN 🍜</span>

    <button type="button" class="cv51-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv51-media">
      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv51-img cv51-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img height="{{ card_prod.images[1].height }}" width="{{ card_prod.images[1].width }}" src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv51-img cv51-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-5' | placeholder_svg_tag: 'cv51-img' }}
      {% endif %}

      <button type="button" class="cv51-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv51-content">
      {% if card_prod.vendor != blank %}<span class="cv51-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv51-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv51-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv51-specs">Air-Dried Non-Fried | 21g Protein</span>

      <div class="cv51-rating">
        <span>★ 4.9</span> <span>(5,200 reviews)</span>
      </div>

      <div class="cv51-price-row">
        <span class="cv51-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv51-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv51-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Spice Variant Selector -->
      <div class="cv51-sizes">
        {% for variant in card_prod.variants limit: 3 %}
          <button type="button" class="cv51-size-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv51-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv51-atc-btn" data-add-cart="{{ cur_var.id }}">SLURP UP RAMEN</button>
      {% else %}
        <button type="button" class="cv51-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv51-card">
    <div class="cv51-media">{{ 'product-5' | placeholder_svg_tag: 'cv51-img' }}</div>
    <div class="cv51-content">
      <span class="cv51-vendor">CYBER GOURMET RAMEN D2C</span>
      <div class="cv51-title">Spicy Sichuan Chili Oil Instant Ramen Noodles</div>

      {% if card_r_show != false %}
      <div class="cv51-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv51-specs">Air-Dried Non-Fried | 21g Protein</span>
      <div class="cv51-price-row"><span class="cv51-price">₹ 799</span><span class="cv51-cmp">₹ 999</span><span class="cv51-disc">20% OFF</span></div>
    </div>
  </div>
{% endif %}
