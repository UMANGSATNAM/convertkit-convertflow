{% comment %}
  Universal Price Snippet
  Accepts: product (Liquid product object)
{% endcomment %}

{% assign price_prod = product %}

{% if price_prod != blank %}
  {% assign target_var = price_prod.selected_or_first_available_variant %}
  {% assign cur_price = target_var.price %}
  {% assign cmp_price = target_var.compare_at_price %}
  
  <div class="cf-price-box" style="display: flex; align-items: center; gap: 6px; font-size: 14px; margin: 4px 0;">
    <span class="cf-price-main" style="font-weight: 700; color: var(--color-text, #111827);">
      {{ cur_price | money }}
    </span>

    {% if cmp_price > cur_price %}
      <span class="cf-price-cmp" style="font-size: 12px; text-decoration: line-through; color: var(--color-text-muted, #9CA3AF);">
        {{ cmp_price | money }}
      </span>

      {% assign save_pct = cmp_price | minus: cur_price | times: 100.0 | divided_by: cmp_price | round %}
      <span class="cf-price-save" style="font-size: 11px; font-weight: 700; color: var(--color-sale, #DC2626); background: rgba(220, 38, 38, 0.08); padding: 2px 6px; border-radius: 4px;">
        {{ save_pct }}% OFF
      </span>
    {% endif %}
  </div>

{% else %}

  <div class="cf-price-box" style="display: flex; align-items: center; gap: 6px; font-size: 14px; margin: 4px 0;">
    <span class="cf-price-main" style="font-weight: 700; color: #111827;">₹ 1,499</span>
    <span class="cf-price-cmp" style="font-size: 12px; text-decoration: line-through; color: #9CA3AF;">₹ 1,999</span>
    <span class="cf-price-save" style="font-size: 11px; font-weight: 700; color: #DC2626; background: rgba(220, 38, 38, 0.08); padding: 2px 6px; border-radius: 4px;">25% OFF</span>
  </div>

{% endif %}
