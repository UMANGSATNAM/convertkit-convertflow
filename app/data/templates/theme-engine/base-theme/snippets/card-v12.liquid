{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V12 — LUXURY DEMI-FINE JEWELRY D2C (GIVA / CARATLANE STYLE)
  Usage: {% render 'card-v12', product: product %}
  Design: Rose Gold Blush (#FFF5F5), Champagne Gold (#D4AF37), Cormorant Garamond & Plus Jakarta Sans, 8px soft elegant border
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .cv12-card {
    --cv12-bg: #FFFFFF;
    --cv12-text: #3D2B29;
    --cv12-muted: #8C6D68;
    --cv12-gold: #D4AF37;
    --cv12-rose: #E8A598;
    --cv12-border: #F7E4E1;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cv12-bg);
    border: 1px solid var(--cv12-border);
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv12-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv12-rose);
    box-shadow: 0 12px 24px -6px rgba(232, 165, 152, 0.25);
  }

  .cv12-card *, .cv12-card *::before, .cv12-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv12-card a { color: inherit; text-decoration: none; }
  .cv12-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv12-card img { max-width: 100%; display: block; }

  .cv12-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: #FFF8F7;
    overflow: hidden;
  }
  .cv12-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv12-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv12-card:hover .cv12-img-pri { opacity: 0; }
  .cv12-card:hover .cv12-img-sec { opacity: 1; transform: scale(1.05); }

  /* Silver Tag Top Left */
  .cv12-badge-jewelry {
    position: absolute; top: 10px; left: 10px;
    background: #3D2B29; color: var(--cv12-rose);
    font-family: 'Cormorant Garamond', serif; font-size: 10px; font-weight: 700; text-transform: uppercase;
    padding: 3px 9px; border-radius: 4px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv12-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid var(--cv12-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv12-rose); z-index: 3; transition: all 0.2s ease;
  }
  .cv12-wish:hover, .cv12-wish.active { background: var(--cv12-rose); color: #FFFFFF; border-color: var(--cv12-rose); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv12-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(61, 43, 41, 0.95); color: var(--cv12-rose);
    font-family: 'Cormorant Garamond', serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    text-align: center; border-radius: 6px; border: 1px solid var(--cv12-rose);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv12-card:hover .cv12-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv12-qv-overlay:hover { background: var(--cv12-rose); color: #3D2B29; }

  .cv12-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }
  .cv12-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv12-rose); font-weight: 700; font-family: 'Cormorant Garamond', serif; letter-spacing: 0.1em; }
  .cv12-title { font-family: 'Cormorant Garamond', serif; font-size: 17px; font-weight: 700; color: #3D2B29; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Hallmark Subtitle */
  .cv12-hallmark { font-size: 11px; color: var(--cv12-muted); font-style: italic; }

  /* Rating Row */
  .cv12-rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; color: var(--cv12-gold); font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Save Pill */
  .cv12-price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv12-price { font-family: 'Cormorant Garamond', serif; font-size: 18px; font-weight: 700; color: #3D2B29; }
  .cv12-cmp { font-size: 13px; color: #A89593; text-decoration: line-through; }
  .cv12-save-pill { background: #FFF0EE; color: #3D2B29; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px; border: 1px solid var(--cv12-rose); }

  /* Metal Swatches */
  .cv12-swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .cv12-swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--cv12-border); cursor: pointer; }
  .cv12-swatch.active { transform: scale(1.25); border-color: var(--cv12-rose); }

  /* Bottom Button */
  .cv12-action-box { padding: 0 14px 14px; }
  .cv12-atc-btn {
    width: 100%; padding: 11px;
    background: linear-gradient(135deg, #E8A598 0%, #D48C7F 100%); color: #FFFFFF;
    font-family: 'Cormorant Garamond', serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 6px; border: none; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(232, 165, 152, 0.3);
  }
  .cv12-atc-btn:hover { background: #3D2B29; color: var(--cv12-rose); transform: scale(1.01); }
  .cv12-atc-btn:disabled { background: #E2E8F0; color: #94A3B8; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv12-card" data-product-id="{{ card_prod.id }}">
    <span class="cv12-badge-jewelry">925 STERLING SILVER ✨</span>

    <button type="button" class="cv12-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv12-media">
      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv12-img cv12-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img height="{{ card_prod.images[1].height }}" width="{{ card_prod.images[1].width }}" src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv12-img cv12-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-2' | placeholder_svg_tag: 'cv12-img' }}
      {% endif %}

      <button type="button" class="cv12-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv12-content">
      {% if card_prod.vendor != blank %}<span class="cv12-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv12-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv12-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv12-hallmark">Anti-Tarnish Coating | Lifetime Plating Warranty</span>

      <div class="cv12-rating">
        <span>★ 4.9</span> <span>(1,850 reviews)</span>
      </div>

      <div class="cv12-price-row">
        <span class="cv12-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv12-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_amt = card_prod.compare_at_price | minus: card_prod.price | money %}
          <span class="cv12-save-pill">Save {{ save_amt }}</span>
        {% endif %}
      </div>

      {% if card_prod.variants.size > 1 %}
        <div class="cv12-swatches">
          {% for variant in card_prod.variants limit: 3 %}
            <span class="cv12-swatch {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}" style="background: {% cycle '#E8A598', '#D4AF37', '#E0E0E0' %};"></span>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="cv12-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv12-atc-btn" data-add-cart="{{ cur_var.id }}">ADD TO JEWELRY BOX</button>
      {% else %}
        <button type="button" class="cv12-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv12-card">
    <div class="cv12-media">{{ 'product-2' | placeholder_svg_tag: 'cv12-img' }}</div>
    <div class="cv12-content">
      <span class="cv12-vendor">FINE JEWELRY D2C</span>
      <div class="cv12-title">Anushka Sharma Rose Gold Solitaire Ring</div>

      {% if card_r_show != false %}
      <div class="cv12-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv12-hallmark">Anti-Tarnish Coating | Lifetime Plating Warranty</span>
      <div class="cv12-price-row"><span class="cv12-price">₹ 2,299</span><span class="cv12-cmp">₹ 3,499</span><span class="cv12-save-pill">Save ₹1,200</span></div>
    </div>
  </div>
{% endif %}
