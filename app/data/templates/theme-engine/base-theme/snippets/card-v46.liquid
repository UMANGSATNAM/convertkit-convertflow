{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V46 — RETRO GROOVY 70S LIFESTYLE D2C (CHAMBERLAIN COFFEE / PARKS PROJECT STYLE)
  Usage: {% render 'card-v46', product: product %}
  Design: Mustard Orange (#E07A5F), Warm Sand (#F4F1DE), Bricolage Grotesque & Plus Jakarta Sans fonts, 16px card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap');

  .cv46-card {
    --cv46-bg: #FFFFFF;
    --cv46-text: #3D405B;
    --cv46-muted: #E07A5F;
    --cv46-orange: #E07A5F;
    --cv46-sand: #F4F1DE;
    --cv46-border: #F2CC8F;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cv46-bg);
    border: 2px solid var(--cv46-border);
    border-radius: 16px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv46-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv46-orange);
    box-shadow: 0 12px 24px -6px rgba(224, 122, 95, 0.25);
  }

  .cv46-card *, .cv46-card *::before, .cv46-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv46-card a { color: inherit; text-decoration: none; }
  .cv46-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv46-card img { max-width: 100%; display: block; }

  .cv46-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: var(--cv46-sand);
    overflow: hidden;
  }
  .cv46-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv46-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv46-card:hover .cv46-img-pri { opacity: 0; }
  .cv46-card:hover .cv46-img-sec { opacity: 1; transform: scale(1.05); }

  /* Groovy Tag Top Left */
  .cv46-badge-groovy {
    position: absolute; top: 10px; left: 10px;
    background: #E07A5F; color: #FFFFFF;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 9px; font-weight: 800; text-transform: uppercase;
    padding: 4px 9px; border-radius: 20px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv46-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 2px solid var(--cv46-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv46-orange); z-index: 3; transition: all 0.2s ease;
  }
  .cv46-wish:hover, .cv46-wish.active { background: var(--cv46-orange); color: #FFFFFF; border-color: var(--cv46-orange); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv46-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(224, 122, 95, 0.95); color: #FFFFFF;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    text-align: center; border-radius: 10px; border: 1px solid var(--cv46-orange);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv46-card:hover .cv46-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv46-qv-overlay:hover { background: #FFFFFF; color: #E07A5F; }

  .cv46-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }
  .cv46-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv46-orange); font-weight: 800; font-family: 'Bricolage Grotesque', sans-serif; letter-spacing: 0.08em; }
  .cv46-title { font-family: 'Bricolage Grotesque', sans-serif; font-size: 16px; font-weight: 800; color: #3D405B; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Retro Specs Subtitle */
  .cv46-specs { font-size: 11px; color: #81B29A; font-weight: 700; }

  /* Rating Row */
  .cv46-rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; color: #E07A5F; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv46-price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv46-price { font-family: 'Bricolage Grotesque', sans-serif; font-size: 17px; font-weight: 800; color: #3D405B; }
  .cv46-cmp { font-size: 13px; color: #9CA3AF; text-decoration: line-through; }
  .cv46-disc { font-size: 10px; font-weight: 800; color: #3D405B; background: var(--cv46-sand); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--cv46-border); }

  /* Retro Color Swatches */
  .cv46-swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .cv46-swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--cv46-border); cursor: pointer; }
  .cv46-swatch.active { transform: scale(1.25); border-color: var(--cv46-orange); }

  /* Bottom Button */
  .cv46-action-box { padding: 0 14px 14px; }
  .cv46-atc-btn {
    width: 100%; padding: 11px;
    background: #E07A5F; color: #FFFFFF;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 10px; border: none; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(224, 122, 95, 0.3);
  }
  .cv46-atc-btn:hover { background: #3D405B; transform: scale(1.01); }
  .cv46-atc-btn:disabled { background: #E5E7EB; color: #9CA3AF; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv46-card" data-product-id="{{ card_prod.id }}">
    <span class="cv46-badge-groovy">100% ORGANIC VIBES ✌️</span>

    <button type="button" class="cv46-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv46-media">
      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv46-img cv46-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img height="{{ card_prod.images[1].height }}" width="{{ card_prod.images[1].width }}" src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv46-img cv46-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-5' | placeholder_svg_tag: 'cv46-img' }}
      {% endif %}

      <button type="button" class="cv46-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv46-content">
      {% if card_prod.vendor != blank %}<span class="cv46-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv46-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv46-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv46-specs">Double-Wall Vacuum | BPA Free</span>

      <div class="cv46-rating">
        <span>★ 4.8</span> <span>(2,650 reviews)</span>
      </div>

      <div class="cv46-price-row">
        <span class="cv46-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv46-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv46-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      {% if card_prod.variants.size > 1 %}
        <div class="cv46-swatches">
          {% for variant in card_prod.variants limit: 3 %}
            <span class="cv46-swatch {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}" style="background: {% cycle '#E07A5F', '#81B29A', '#F2CC8F' %};"></span>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="cv46-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv46-atc-btn" data-add-cart="{{ cur_var.id }}">FEELS SO GROOVY</button>
      {% else %}
        <button type="button" class="cv46-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv46-card">
    <div class="cv46-media">{{ 'product-5' | placeholder_svg_tag: 'cv46-img' }}</div>
    <div class="cv46-content">
      <span class="cv46-vendor">GROOVY LIFESTYLE D2C</span>
      <div class="cv46-title">Flower Power Stainless Steel Tumbler</div>

      {% if card_r_show != false %}
      <div class="cv46-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv46-specs">Double-Wall Vacuum | BPA Free</span>
      <div class="cv46-price-row"><span class="cv46-price">₹ 1,499</span><span class="cv46-cmp">₹ 1,999</span><span class="cv46-disc">25% OFF</span></div>
    </div>
  </div>
{% endif %}
