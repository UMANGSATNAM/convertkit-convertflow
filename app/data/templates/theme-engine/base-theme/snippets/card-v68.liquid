{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V68 — ARCHITECTURAL SMART LIGHTING & DECOR D2C (GOVEE / NANOLEAF STYLE)
  Usage: {% render 'card-v68', product: product %}
  Design: Matte Dark (#18181B), Ambient Amber (#F59E0B), Plus Jakarta Sans & Cormorant Garamond fonts, 8px card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .cv68-card {
    --cv68-bg: #FFFFFF;
    --cv68-text: #18181B;
    --cv68-muted: #D97706;
    --cv68-dark: #18181B;
    --cv68-amber: #F59E0B;
    --cv68-light: #FFFBEB;
    --cv68-border: #FDE68A;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cv68-bg);
    border: 1px solid var(--cv68-border);
    border-radius: 8px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv68-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv68-amber);
    box-shadow: 0 12px 24px -6px rgba(245, 158, 11, 0.25);
  }

  .cv68-card *, .cv68-card *::before, .cv68-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv68-card a { color: inherit; text-decoration: none; }
  .cv68-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv68-card img { max-width: 100%; display: block; }

  .cv68-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: #18181B;
    overflow: hidden;
  }
  .cv68-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv68-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv68-card:hover .cv68-img-pri { opacity: 0; }
  .cv68-card:hover .cv68-img-sec { opacity: 1; transform: scale(1.05); }

  /* Smart Tag Top Left */
  .cv68-badge-light {
    position: absolute; top: 10px; left: 10px;
    background: var(--cv68-amber); color: #18181B;
    font-family: 'Cormorant Garamond', serif; font-size: 10px; font-weight: 700; text-transform: uppercase;
    padding: 3px 8px; border-radius: 4px; z-index: 3; letter-spacing: 0.08em;
  }

  /* Wishlist Heart Top Right */
  .cv68-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #18181B; border: 1px solid var(--cv68-amber);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv68-amber); z-index: 3; transition: all 0.2s ease;
  }
  .cv68-wish:hover, .cv68-wish.active { background: var(--cv68-amber); color: #18181B; transform: scale(1.1); }

  /* Quick View Overlay */
  .cv68-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(245, 158, 11, 0.95); color: #18181B;
    font-family: 'Cormorant Garamond', serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    text-align: center; border-radius: 4px; border: 1px solid var(--cv68-amber);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv68-card:hover .cv68-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv68-qv-overlay:hover { background: #18181B; color: #F59E0B; }

  .cv68-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }
  .cv68-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv68-muted); font-weight: 700; font-family: 'Cormorant Garamond', serif; letter-spacing: 0.1em; }
  .cv68-title { font-family: 'Cormorant Garamond', serif; font-size: 17px; font-weight: 700; color: #18181B; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Lighting Specs Subtitle */
  .cv68-specs { font-size: 11px; color: #71717A; font-style: italic; }

  /* Rating Row */
  .cv68-rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; color: #D97706; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv68-price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv68-price { font-family: 'Cormorant Garamond', serif; font-size: 18px; font-weight: 700; color: #18181B; }
  .cv68-cmp { font-size: 13px; color: #A1A1AA; text-decoration: line-through; }
  .cv68-disc { font-size: 10px; font-weight: 700; color: #18181B; background: var(--cv68-light); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--cv68-border); }

  /* Color Finish Swatches */
  .cv68-swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .cv68-swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--cv68-border); cursor: pointer; }
  .cv68-swatch.active { transform: scale(1.25); border-color: var(--cv68-amber); }

  /* Bottom Button */
  .cv68-action-box { padding: 0 14px 14px; }
  .cv68-atc-btn {
    width: 100%; padding: 11px;
    background: #18181B; color: #F59E0B;
    font-family: 'Cormorant Garamond', serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    border-radius: 4px; border: 1px solid #F59E0B; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.25);
  }
  .cv68-atc-btn:hover { background: #F59E0B; color: #18181B; transform: scale(1.01); }
  .cv68-atc-btn:disabled { background: #E4E4E7; color: #A1A1AA; border-color: #D4D4D8; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv68-card" data-product-id="{{ card_prod.id }}">
    <span class="cv68-badge-light">MATTER & APPLE HOME 💡</span>

    <button type="button" class="cv68-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv68-media">
      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv68-img cv68-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img height="{{ card_prod.images[1].height }}" width="{{ card_prod.images[1].width }}" src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv68-img cv68-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'cv68-img' }}
      {% endif %}

      <button type="button" class="cv68-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv68-content">
      {% if card_prod.vendor != blank %}<span class="cv68-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv68-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv68-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv68-specs">1,500 Lumens | 16M Colors</span>

      <div class="cv68-rating">
        <span>★ 4.9</span> <span>(3,800 reviews)</span>
      </div>

      <div class="cv68-price-row">
        <span class="cv68-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv68-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv68-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      {% if card_prod.variants.size > 1 %}
        <div class="cv68-swatches">
          {% for variant in card_prod.variants limit: 3 %}
            <span class="cv68-swatch {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}" style="background: {% cycle '#18181B', '#CBD5E1', '#D97706' %};"></span>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="cv68-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv68-atc-btn" data-add-cart="{{ cur_var.id }}">ILLUMINATE YOUR SPACE</button>
      {% else %}
        <button type="button" class="cv68-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv68-card">
    <div class="cv68-media">{{ 'product-1' | placeholder_svg_tag: 'cv68-img' }}</div>
    <div class="cv68-content">
      <span class="cv68-vendor">SMART LIGHTING D2C</span>
      <div class="cv68-title">Architectural Smart LED Floor Lamp w/ Dynamic RGBIC</div>

      {% if card_r_show != false %}
      <div class="cv68-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv68-specs">1,500 Lumens | 16M Colors</span>
      <div class="cv68-price-row"><span class="cv68-price">₹ 8,999</span><span class="cv68-cmp">₹ 11,499</span><span class="cv68-disc">21% OFF</span></div>
    </div>
  </div>
{% endif %}
