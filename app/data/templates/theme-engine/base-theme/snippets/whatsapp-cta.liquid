{%- comment -%}
  =============================================================================
  STOREFORGE SHARED INDIA-FIRST SNIPPET: WHATSAPP VIP CONCIERGE CTA
  =============================================================================
  Psychological Conversion Framework:
  1. High-Touch Trust Bridge: Indian buyers buying premium D2C goods require human validation. A 1-on-1 direct line to a senior brand stylist eliminates purchase hesitation.
  2. Reduced Cognitive Load (Fogg Model): Instead of asking the user to type a question from scratch, provides pre-formulated one-click inquiry pills (Video Request, Custom Sizing, Urgent Dispatch).
  3. Dynamic Product Contextualization: Automatically appends the current product title and URL to the outgoing WhatsApp chat payload.
  
  Design Aesthetics & Rules:
  - 0% Emoji Policy: Clean ASCII brackets [ CONCIERGE ASSISTANCE ] and SVG speech iconography.
  - Universal Theme Heritage: Works across all 5 archetypes by inheriting global button and border tokens.
  =============================================================================
{%- endcomment -%}

{%- if settings.enable_whatsapp_cta == false or settings.whatsapp_number == blank -%}
  {%- break -%}
{%- endif -%}

{%- assign wa_num = settings.whatsapp_number | default: "919876543210" | remove: " " | remove: "+" | remove: "-" -%}
{%- assign product_title = product.title | default: "Featured Piece" -%}
{%- assign shop_name = shop.name | default: "StoreForge" -%}

<div class="sf-wa-concierge" data-wa-concierge data-wa-num="{{ wa_num }}" data-product-title="{{ product_title | escape }}">
  <style>
    .sf-wa-concierge {
      margin: 1rem 0;
      font-family: var(--font-body-family, sans-serif);
    }

    .sf-wa__trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 0.85rem 1.25rem;
      background-color: var(--color-background, #ffffff);
      border: 1px solid var(--color-border, rgba(0, 0, 0, 0.2));
      color: var(--color-text, #111111);
      cursor: pointer;
      text-decoration: none;
      transition: border-color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease;
    }

    .sf-wa__trigger:hover {
      border-color: #15803d;
      background-color: rgba(21, 128, 61, 0.03);
      box-shadow: 0 4px 12px rgba(21, 128, 61, 0.08);
    }

    .sf-wa__left {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .sf-wa__icon-box {
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #15803d;
      color: #ffffff;
      border-radius: 2px;
      flex-shrink: 0;
    }

    .sf-wa__icon {
      width: 15px;
      height: 15px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .sf-wa__text {
      display: flex;
      flex-direction: column;
      text-align: left;
    }

    .sf-wa__title {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-text, #111111);
    }

    .sf-wa__sub {
      font-size: 0.65rem;
      color: var(--color-text-muted, #666666);
    }

    .sf-wa__arrow {
      font-size: 0.8rem;
      font-weight: 700;
      color: #15803d;
      letter-spacing: 0.05em;
    }

    /* Interactive Inquiry Pills Drawer */
    .sf-wa__drawer {
      display: none;
      margin-top: 0.5rem;
      padding: 1rem;
      border: 1px solid var(--color-border, rgba(0, 0, 0, 0.12));
      background-color: var(--color-background-secondary, rgba(0, 0, 0, 0.015));
      animation: sfWaSlideDown 0.25s ease forwards;
    }

    .sf-wa__drawer.is-active {
      display: block;
    }

    @keyframes sfWaSlideDown {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .sf-wa__drawer-label {
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-muted, #666666);
      margin-bottom: 0.75rem;
    }

    .sf-wa__pills {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .sf-wa__pill {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.65rem 0.85rem;
      font-size: 0.75rem;
      font-family: inherit;
      color: var(--color-text, #111111);
      background-color: var(--color-background, #ffffff);
      border: 1px solid var(--color-border, rgba(0, 0, 0, 0.15));
      cursor: pointer;
      text-align: left;
      transition: border-color 0.2s ease, background-color 0.2s ease;
    }

    .sf-wa__pill:hover {
      border-color: #15803d;
      background-color: rgba(21, 128, 61, 0.05);
      color: #15803d;
      font-weight: 600;
    }

    .sf-wa__pill-action {
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #15803d;
      font-weight: 700;
    }
  </style>

  <button type="button" class="sf-wa__trigger" data-wa-toggle aria-expanded="false" aria-label="Open WhatsApp Advisor options">
    <div class="sf-wa__left">
      <div class="sf-wa__icon-box">
        <svg class="sf-wa__icon" viewBox="0 0 24 24">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
      </div>
      <div class="sf-wa__text">
        <span class="sf-wa__title">[ CHAT WITH PRIVATE ADVISOR ]</span>
        <span class="sf-wa__sub">Real video inspection, sizing & priority dispatch</span>
      </div>
    </div>
    <span class="sf-wa__arrow">[ OPEN ]</span>
  </button>

  <div class="sf-wa__drawer" data-wa-drawer>
    <div class="sf-wa__drawer-label">[ SELECT CONCIERGE INQUIRY TOPIC ]</div>
    <div class="sf-wa__pills">
      <button type="button" class="sf-wa__pill" data-wa-msg="Hello! I would like to request a real video / live photo inspection of: {{ product_title }}.">
        <span>[ REQUEST LIVE VIDEO / HD PHOTO ]</span>
        <span class="sf-wa__pill-action">SEND &rarr;</span>
      </button>
      <button type="button" class="sf-wa__pill" data-wa-msg="Hello! I need custom sizing / fit guidance before purchasing: {{ product_title }}.">
        <span>[ CONFIRM CUSTOM SIZING & FIT ]</span>
        <span class="sf-wa__pill-action">SEND &rarr;</span>
      </button>
      <button type="button" class="sf-wa__pill" data-wa-msg="Hello! Can this order be dispatched for express same-day / next-day delivery? Item: {{ product_title }}.">
        <span>[ EXPRESS URGENT DISPATCH INQUIRY ]</span>
        <span class="sf-wa__pill-action">SEND &rarr;</span>
      </button>
      <button type="button" class="sf-wa__pill" data-wa-msg="Hello! I would like to inquire about corporate gifting / multi-piece ordering for: {{ product_title }}.">
        <span>[ CORPORATE & BESPOKE ORDERING ]</span>
        <span class="sf-wa__pill-action">SEND &rarr;</span>
      </button>
    </div>
  </div>

  <script>
    (function() {
      const container = document.querySelector('[data-wa-concierge]');
      if (!container) return;

      const toggleBtn = container.querySelector('[data-wa-toggle]');
      const drawer = container.querySelector('[data-wa-drawer]');
      const pills = container.querySelectorAll('[data-wa-msg]');
      const waNum = container.getAttribute('data-wa-num') || '919876543210';

      if (toggleBtn && drawer) {
        toggleBtn.addEventListener('click', function() {
          const isActive = drawer.classList.contains('is-active');
          if (isActive) {
            drawer.classList.remove('is-active');
            toggleBtn.querySelector('.sf-wa__arrow').textContent = '[ OPEN ]';
            toggleBtn.setAttribute('aria-expanded', 'false');
          } else {
            drawer.classList.add('is-active');
            toggleBtn.querySelector('.sf-wa__arrow').textContent = '[ CLOSE ]';
            toggleBtn.setAttribute('aria-expanded', 'true');
          }
        });
      }

      pills.forEach(function(pill) {
        pill.addEventListener('click', function() {
          const msg = pill.getAttribute('data-wa-msg') || 'Hello!';
          const encodedMsg = encodeURIComponent(msg);
          const url = 'https://wa.me/' + waNum + '?text=' + encodedMsg;
          window.open(url, '_blank', 'noopener,noreferrer');
        });
      });
    })();
  </script>
</div>
