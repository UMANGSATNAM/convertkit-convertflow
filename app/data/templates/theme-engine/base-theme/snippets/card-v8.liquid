{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V8 — SPECIALTY ARTISANAL COFFEE D2C (BLUE TOKAI / SLEEPY OWL STYLE)
  Usage: {% render 'card-v8', product: product %}
  Design: Warm Coffee Espresso (#1F140E), Roasted Amber (#D48C46), Cabinet Grotesk & Outfit fonts, 10px rounded corners
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cabinet+Grotesk:wght@700;800&family=Outfit:wght@400;500;600;700&display=swap');

  .cv8-card {
    --cv8-bg: #FFFFFF;
    --cv8-text: #1F140E;
    --cv8-muted: #8C6D58;
    --cv8-amber: #D48C46;
    --cv8-dark: #1F140E;
    --cv8-border: #E8DFD8;
    font-family: 'Outfit', sans-serif;
    background: var(--cv8-bg);
    border: 1px solid var(--cv8-border);
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv8-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv8-amber);
    box-shadow: 0 12px 24px -6px rgba(31, 20, 14, 0.15);
  }

  .cv8-card *, .cv8-card *::before, .cv8-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv8-card a { color: inherit; text-decoration: none; }
  .cv8-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv8-card img { max-width: 100%; display: block; }

  .cv8-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: #FAF6F0;
    overflow: hidden;
  }
  .cv8-img { width: 100%; height: 100%; object-fit: contain; padding: 16px; transition: transform 0.5s ease; }
  .cv8-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv8-card:hover .cv8-img-pri { opacity: 0; }
  .cv8-card:hover .cv8-img-sec { opacity: 1; transform: scale(1.05); }

  /* Roast Tag Top Left */
  .cv8-badge-roast {
    position: absolute; top: 10px; left: 10px;
    background: var(--cv8-dark); color: var(--cv8-amber);
    font-family: 'Cabinet Grotesk', sans-serif; font-size: 10px; font-weight: 800; text-transform: uppercase;
    padding: 4px 9px; border-radius: 4px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv8-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid #E8DFD8;
    display: flex; align-items: center; justify-content: center;
    color: var(--cv8-dark); z-index: 3; transition: all 0.2s ease;
  }
  .cv8-wish:hover, .cv8-wish.active { background: var(--cv8-amber); color: #FFFFFF; border-color: var(--cv8-amber); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv8-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(31, 20, 14, 0.95); color: var(--cv8-amber);
    font-family: 'Cabinet Grotesk', sans-serif; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    text-align: center; border-radius: 6px; border: 1px solid var(--cv8-amber);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv8-card:hover .cv8-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv8-qv-overlay:hover { background: var(--cv8-amber); color: #1F140E; }

  .cv8-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; }
  .cv8-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv8-amber); font-weight: 800; font-family: 'Cabinet Grotesk', sans-serif; letter-spacing: 0.1em; }
  .cv8-title { font-family: 'Cabinet Grotesk', sans-serif; font-size: 16px; font-weight: 800; color: #1F140E; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Coffee Tasting Notes */
  .cv8-notes { font-size: 11px; color: var(--cv8-muted); font-weight: 500; }

  /* Rating Row */
  .cv8-rating { display: flex; align-items: center; gap: 4px; font-size: 11px; color: var(--cv8-amber); font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv8-price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv8-price { font-family: 'Cabinet Grotesk', sans-serif; font-size: 17px; font-weight: 800; color: #1F140E; }
  .cv8-cmp { font-size: 13px; color: #9CA3AF; text-decoration: line-through; }
  .cv8-disc { font-size: 10px; font-weight: 800; color: #1F140E; background: #FDE8D0; padding: 2px 6px; border-radius: 4px; border: 1px solid var(--cv8-amber); }

  /* Grind Type Variant Pills */
  .cv8-grinds { display: flex; gap: 6px; overflow-x: auto; margin-top: 4px; }
  .cv8-grind-btn {
    font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 4px;
    border: 1px solid #E8DFD8; background: #FFFFFF; color: #1F140E; cursor: pointer; transition: all 0.2s ease;
  }
  .cv8-grind-btn.active, .cv8-grind-btn:hover { background: #1F140E; color: var(--cv8-amber); border-color: #1F140E; }

  /* Bottom Button */
  .cv8-action-box { padding: 0 14px 14px; }
  .cv8-atc-btn {
    width: 100%; padding: 11px;
    background: var(--cv8-amber); color: #1F140E;
    font-family: 'Cabinet Grotesk', sans-serif; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 6px; border: none; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(212, 140, 70, 0.3);
  }
  .cv8-atc-btn:hover { background: #1F140E; color: var(--cv8-amber); transform: scale(1.01); }
  .cv8-atc-btn:disabled { background: #CBD5E1; color: #64748B; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv8-card" data-product-id="{{ card_prod.id }}">
    <span class="cv8-badge-roast">FRESH ROAST ☕</span>

    <button type="button" class="cv8-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv8-media">
      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv8-img cv8-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img height="{{ card_prod.images[1].height }}" width="{{ card_prod.images[1].width }}" src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv8-img cv8-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-2' | placeholder_svg_tag: 'cv8-img' }}
      {% endif %}

      <button type="button" class="cv8-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv8-content">
      {% if card_prod.vendor != blank %}<span class="cv8-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv8-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv8-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv8-notes">Notes of Dark Chocolate & Figs | 100% Arabica</span>

      <div class="cv8-rating">
        <span>★ 4.9</span> <span>(1,150 reviews)</span>
      </div>

      <div class="cv8-price-row">
        <span class="cv8-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv8-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv8-disc">Save {{ save_pct }}%</span>
        {% endif %}
      </div>

      <!-- Grind Variant Selector -->
      <div class="cv8-grinds">
        {% for variant in card_prod.variants limit: 4 %}
          <button type="button" class="cv8-grind-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv8-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv8-atc-btn" data-add-cart="{{ cur_var.id }}">BREW FRESH COFFEE</button>
      {% else %}
        <button type="button" class="cv8-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv8-card">
    <div class="cv8-media">{{ 'product-2' | placeholder_svg_tag: 'cv8-img' }}</div>
    <div class="cv8-content">
      <span class="cv8-vendor">ARTISANAL COFFEE</span>
      <div class="cv8-title">Attikan Estate Dark Roast Single Origin Coffee</div>

      {% if card_r_show != false %}
      <div class="cv8-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv8-notes">Notes of Dark Chocolate & Figs | 100% Arabica</span>
      <div class="cv8-price-row"><span class="cv8-price">₹ 480</span><span class="cv8-cmp">₹ 560</span><span class="cv8-disc">Save 14%</span></div>
    </div>
  </div>
{% endif %}
