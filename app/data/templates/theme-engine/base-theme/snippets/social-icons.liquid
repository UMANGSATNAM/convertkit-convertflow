<ul class="social-icons-list" role="list">
  {%- if settings.social_twitter_link != blank -%}
    <li class="social-icons-item">
      <a href="{{ settings.social_twitter_link | escape }}" class="social-icons-link" aria-describedby="a11y-external-message">
        {%- render 'icon-twitter' -%}
        <span class="visually-hidden">Twitter</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_facebook_link != blank -%}
    <li class="social-icons-item">
      <a href="{{ settings.social_facebook_link | escape }}" class="social-icons-link" aria-describedby="a11y-external-message">
        {%- render 'icon-facebook' -%}
        <span class="visually-hidden">Facebook</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_instagram_link != blank -%}
    <li class="social-icons-item">
      <a href="{{ settings.social_instagram_link | escape }}" class="social-icons-link" aria-describedby="a11y-external-message">
        {%- render 'icon-instagram' -%}
        <span class="visually-hidden">Instagram</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_tiktok_link != blank -%}
    <li class="social-icons-item">
      <a href="{{ settings.social_tiktok_link | escape }}" class="social-icons-link" aria-describedby="a11y-external-message">
        {%- render 'icon-tiktok' -%}
        <span class="visually-hidden">TikTok</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_pinterest_link != blank -%}
    <li class="social-icons-item">
      <a href="{{ settings.social_pinterest_link | escape }}" class="social-icons-link" aria-describedby="a11y-external-message">
        {%- render 'icon-pinterest' -%}
        <span class="visually-hidden">Pinterest</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_youtube_link != blank -%}
    <li class="social-icons-item">
      <a href="{{ settings.social_youtube_link | escape }}" class="social-icons-link" aria-describedby="a11y-external-message">
        {%- render 'icon-youtube' -%}
        <span class="visually-hidden">YouTube</span>
      </a>
    </li>
  {%- endif -%}
</ul>
