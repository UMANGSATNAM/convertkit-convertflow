{% comment %}
  Universal Section Heading Snippet
  Accepts: title, subheading, alignment ('left' | 'center'), view_all_url, view_all_text
{% endcomment %}

{% assign head_align = alignment | default: 'left' %}

{% if title != blank or subheading != blank %}
  <div class="cf-section-heading" style="display: flex; align-items: flex-end; justify-content: {% if head_align == 'center' %}center{% else %}space-between{% endif %}; text-align: {{ head_align }}; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
    <div>
      {% if title != blank %}
        <h2 style="font-size: 28px; font-weight: 700; color: var(--color-text, #111827); margin: 0; font-family: var(--font-heading);">{{ title }}</h2>
      {% endif %}
      {% if subheading != blank %}
        <p style="font-size: 15px; color: var(--color-text-muted, #6B7280); margin: 6px 0 0;">{{ subheading }}</p>
      {% endif %}
    </div>

    {% if view_all_url != blank and head_align != 'center' %}
      <a href="{{ view_all_url }}" style="font-size: 14px; font-weight: 600; color: var(--color-accent, #2563EB); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
        {{ view_all_text | default: 'View all' }} &rarr;
      </a>
    {% endif %}
  </div>
{% endif %}
