{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V2 — ACTIVEWEAR & GYMWEAR D2C (BLISSCLUB STYLE)
  Usage: {% render 'card-v2', product: product %}
  Design: Sleek Studio Charcoal (#111827), Neon Yellow Discount (#FACC15), Space Grotesk & Outfit
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&family=Space+Grotesk:wght@600;700&display=swap');

  .cv2-card {
    --cv2-bg: #FFFFFF;
    --cv2-text: #111827;
    --cv2-muted: #6B7280;
    --cv2-yellow: #FACC15;
    --cv2-border: #E5E7EB;
    font-family: 'Space Grotesk', sans-serif;
    background: var(--cv2-bg);
    border: 1px solid var(--cv2-border);
    border-radius: 8px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv2-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 28px -6px rgba(0, 0, 0, 0.12);
  }

  .cv2-card *, .cv2-card *::before, .cv2-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv2-card a { color: inherit; text-decoration: none; }
  .cv2-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv2-card img { max-width: 100%; display: block; }

  .cv2-media {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    background: #F3F4F6;
    overflow: hidden;
  }
  .cv2-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .cv2-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv2-card:hover .cv2-img-pri { opacity: 0; }
  .cv2-card:hover .cv2-img-sec { opacity: 1; transform: scale(1.05); }

  /* Bestseller Badge Top Left */
  .cv2-badge-best {
    position: absolute; top: 10px; left: 10px;
    background: #000000; color: #FFFFFF;
    font-size: 10px; font-weight: 700; text-transform: capitalize;
    padding: 3px 8px; border-radius: 4px; z-index: 3; letter-spacing: 0.02em;
  }

  /* Wishlist Heart Top Right */
  .cv2-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid #E5E7EB;
    display: flex; align-items: center; justify-content: center;
    color: #111827; z-index: 3; transition: all 0.2s ease;
  }
  .cv2-wish:hover, .cv2-wish.active { background: #111827; color: #FFFFFF; transform: scale(1.1); }

  /* Quick View Overlay */
  .cv2-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(0, 0, 0, 0.8); color: #FFFFFF;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    text-align: center; border-radius: 4px; opacity: 0; transform: translateY(10px);
    transition: all 0.3s ease; z-index: 4;
  }
  .cv2-card:hover .cv2-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv2-qv-overlay:hover { background: #000000; color: var(--cv2-yellow); }

  .cv2-content { padding: 14px 14px 10px; display: flex; flex-direction: column; gap: 8px; flex-grow: 1; }
  .cv2-vendor { font-size: 10px; text-transform: uppercase; color: #6B7280; font-weight: 700; letter-spacing: 0.08em; }
  .cv2-title { font-size: 13px; font-weight: 700; color: #111827; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Price Row: ₹ Rupee + MRP + Bright Yellow % OFF Badge */
  .cv2-price-row { display: flex; align-items: center; gap: 8px; margin-top: auto; }
  .cv2-price { font-size: 16px; font-weight: 800; color: #111827; }
  .cv2-cmp { font-size: 13px; color: #9CA3AF; text-decoration: line-through; }
  .cv2-disc-badge {
    background: var(--cv2-yellow); color: #111827;
    font-size: 11px; font-weight: 800; padding: 2px 6px; border-radius: 2px;
  }

  /* Bottom Solid Black Add to Cart Button */
  .cv2-action-box { padding: 0 14px 14px; }
  .cv2-atc-btn {
    width: 100%; padding: 12px;
    background: #000000; color: #FFFFFF;
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 4px; border: none; transition: all 0.2s ease;
  }
  .cv2-atc-btn:hover { background: #374151; }
  .cv2-atc-btn:disabled { background: #9CA3AF; cursor: not-allowed; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv2-card" data-product-id="{{ card_prod.id }}">
    <span class="cv2-badge-best">Bestseller</span>

    <button type="button" class="cv2-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv2-media">
      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv2-img cv2-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img height="{{ card_prod.images[1].height }}" width="{{ card_prod.images[1].width }}" src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv2-img cv2-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-2' | placeholder_svg_tag: 'cv2-img' }}
      {% endif %}

      <button type="button" class="cv2-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv2-content">
      {% if card_prod.vendor != blank %}<span class="cv2-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv2-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv2-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}

      <!-- Star Rating Row -->
      <div class="cv2-rating" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">4.9</span>
        <span style="font-size: 11px; color: #6B7280;">(128)</span>
      </div>

      <div class="cv2-price-row">
        <span class="cv2-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv2-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv2-disc-badge">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>
    </div>

    <div class="cv2-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv2-atc-btn" data-add-cart="{{ cur_var.id }}">ADD TO CART</button>
      {% else %}
        <button type="button" class="cv2-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv2-card">
    <div class="cv2-media">{{ 'product-2' | placeholder_svg_tag: 'cv2-img' }}</div>
    <div class="cv2-content">
      <span class="cv2-vendor">BLISSCLUB ACTIVE</span>
      <div class="cv2-title">Wide Leg Pants With Pockets - Black</div>

      {% if card_r_show != false %}
      <div class="cv2-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}

      <!-- Star Rating Row -->
      <div class="cv2-rating" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">4.9</span>
        <span style="font-size: 11px; color: #6B7280;">(128)</span>
      </div>
      <div class="cv2-price-row"><span class="cv2-price">₹ 1,399</span><span class="cv2-cmp">₹ 1,999</span><span class="cv2-disc-badge">30% OFF</span></div>
    </div>
  </div>
{% endif %}
