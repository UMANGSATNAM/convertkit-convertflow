{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V22 — PREMIUM COOKWARE & MODERN CULINARY D2C (WONDERCHEF / INDUS VALLEY STYLE)
  Usage: {% render 'card-v22', product: product %}
  Design: Warm Copper (#B85A3C), Creamy Off-White (#FAF7F2), Playfair Display & Outfit fonts, 10px rounded card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap');

  .cv22-card {
    --cv22-bg: #FFFFFF;
    --cv22-text: #3D2219;
    --cv22-muted: #8C5B4C;
    --cv22-copper: #B85A3C;
    --cv22-cream: #FAF7F2;
    --cv22-border: #E8DDD6;
    font-family: 'Outfit', sans-serif;
    background: var(--cv22-bg);
    border: 1px solid var(--cv22-border);
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv22-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv22-copper);
    box-shadow: 0 12px 24px -6px rgba(184, 90, 60, 0.2);
  }

  .cv22-card *, .cv22-card *::before, .cv22-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv22-card a { color: inherit; text-decoration: none; }
  .cv22-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv22-card img { max-width: 100%; display: block; }

  .cv22-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: var(--cv22-cream);
    overflow: hidden;
  }
  .cv22-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv22-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv22-card:hover .cv22-img-pri { opacity: 0; }
  .cv22-card:hover .cv22-img-sec { opacity: 1; transform: scale(1.05); }

  /* Cookware Tag Top Left */
  .cv22-badge-cook {
    position: absolute; top: 10px; left: 10px;
    background: #3D2219; color: var(--cv22-copper);
    font-family: 'Playfair Display', serif; font-size: 10px; font-weight: 700; text-transform: uppercase;
    padding: 3px 9px; border-radius: 4px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv22-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid var(--cv22-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv22-copper); z-index: 3; transition: all 0.2s ease;
  }
  .cv22-wish:hover, .cv22-wish.active { background: var(--cv22-copper); color: #FFFFFF; border-color: var(--cv22-copper); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv22-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(61, 34, 25, 0.95); color: var(--cv22-copper);
    font-family: 'Playfair Display', serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    text-align: center; border-radius: 6px; border: 1px solid var(--cv22-copper);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv22-card:hover .cv22-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv22-qv-overlay:hover { background: var(--cv22-copper); color: #FFFFFF; }

  .cv22-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }
  .cv22-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv22-copper); font-weight: 700; font-family: 'Playfair Display', serif; letter-spacing: 0.1em; }
  .cv22-title { font-family: 'Playfair Display', serif; font-size: 16px; font-weight: 700; color: #3D2219; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Subtitle Cookware Specs */
  .cv22-specs { font-size: 11px; color: var(--cv22-muted); font-style: italic; }

  /* Rating Row */
  .cv22-rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; color: var(--cv22-copper); font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv22-price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv22-price { font-family: 'Playfair Display', serif; font-size: 17px; font-weight: 700; color: #3D2219; }
  .cv22-cmp { font-size: 13px; color: #8C5B4C; text-decoration: line-through; }
  .cv22-disc { font-size: 10px; font-weight: 700; color: #FFFFFF; background: var(--cv22-copper); padding: 2px 6px; border-radius: 4px; }

  /* Finish Color Swatches */
  .cv22-swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .cv22-swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--cv22-border); cursor: pointer; }
  .cv22-swatch.active { transform: scale(1.25); border-color: var(--cv22-copper); }

  /* Bottom Button */
  .cv22-action-box { padding: 0 14px 14px; }
  .cv22-atc-btn {
    width: 100%; padding: 11px;
    background: var(--cv22-copper); color: #FFFFFF;
    font-family: 'Playfair Display', serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 6px; border: none; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(184, 90, 60, 0.3);
  }
  .cv22-atc-btn:hover { background: #3D2219; color: var(--cv22-copper); transform: scale(1.01); }
  .cv22-atc-btn:disabled { background: #E8DDD6; color: #8C5B4C; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv22-card" data-product-id="{{ card_prod.id }}">
    <span class="cv22-badge-cook">PRE-SEASONED CAST IRON 🍳</span>

    <button type="button" class="cv22-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv22-media">
      {% if card_prod.featured_image %}
        <img src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv22-img cv22-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv22-img cv22-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-3' | placeholder_svg_tag: 'cv22-img' }}
      {% endif %}

      <button type="button" class="cv22-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv22-content">
      {% if card_prod.vendor != blank %}<span class="cv22-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv22-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv22-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv22-specs">100% Toxin-Free | Induction & Oven Safe</span>

      <div class="cv22-rating">
        <span>★ 4.8</span> <span>(1,250 reviews)</span>
      </div>

      <div class="cv22-price-row">
        <span class="cv22-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv22-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv22-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      {% if card_prod.variants.size > 1 %}
        <div class="cv22-swatches">
          {% for variant in card_prod.variants limit: 3 %}
            <span class="cv22-swatch {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}" style="background: {% cycle '#B85A3C', '#262626', '#354F52' %};"></span>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="cv22-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv22-atc-btn" data-add-cart="{{ cur_var.id }}">COOK WITH PASSION</button>
      {% else %}
        <button type="button" class="cv22-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv22-card">
    <div class="cv22-media">{{ 'product-3' | placeholder_svg_tag: 'cv22-img' }}</div>
    <div class="cv22-content">
      <span class="cv22-vendor">COOKWARE D2C</span>
      <div class="cv22-title">Pre-Seasoned Cast Iron Dutch Oven (4.5L)</div>

      {% if card_r_show != false %}
      <div class="cv22-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv22-specs">100% Toxin-Free | Induction & Oven Safe</span>
      <div class="cv22-price-row"><span class="cv22-price">₹ 3,299</span><span class="cv22-cmp">₹ 4,499</span><span class="cv22-disc">26% OFF</span></div>
    </div>
  </div>
{% endif %}
