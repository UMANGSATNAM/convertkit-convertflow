{% comment %}
  Universal Quantity Input Snippet
  Accepts: quantity (number), line_item_index (optional), input_name (optional)
{% endcomment %}

{% assign qty_val = quantity | default: 1 %}
{% assign name_attr = input_name | default: 'quantity' %}

<div class="cf-quantity-box" style="display: inline-flex; align-items: center; border: 1px solid var(--color-border, #E5E7EB); border-radius: var(--radius-button, 8px); overflow: hidden; background: #FFFFFF;">
  <button type="button" class="cf-qty-btn cf-qty-btn--minus" aria-label="Decrease quantity" style="padding: 8px 12px; background: transparent; border: none; font-size: 16px; font-weight: 600; cursor: pointer; color: var(--color-text, #111827);">-</button>
  <input type="number" name="{{ name_attr }}" value="{{ qty_val }}" min="1" aria-label="Quantity" class="cf-qty-input" style="width: 40px; text-align: center; border: none; font-size: 14px; font-weight: 600; color: var(--color-text, #111827); -moz-appearance: textfield;">
  <button type="button" class="cf-qty-btn cf-qty-btn--plus" aria-label="Increase quantity" style="padding: 8px 12px; background: transparent; border: none; font-size: 16px; font-weight: 600; cursor: pointer; color: var(--color-text, #111827);">+</button>
</div>
