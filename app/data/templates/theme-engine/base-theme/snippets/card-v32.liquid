{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V32 — HIGH-PERFORMANCE ATHLETIC SOCKS & COMPRESSION D2C (BOMBAS / BALEGA STYLE)
  Usage: {% render 'card-v32', product: product %}
  Design: Athletic Cobalt Blue (#2563EB), Neon Coral (#FF4D6D), Plus Jakarta Sans & Bricolage Grotesque fonts, 12px card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .cv32-card {
    --cv32-bg: #FFFFFF;
    --cv32-text: #1E40AF;
    --cv32-muted: #2563EB;
    --cv32-cobalt: #2563EB;
    --cv32-coral: #FF4D6D;
    --cv32-light-blue: #EFF6FF;
    --cv32-border: #BFDBFE;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cv32-bg);
    border: 1px solid var(--cv32-border);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv32-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv32-cobalt);
    box-shadow: 0 12px 24px -6px rgba(37, 99, 235, 0.25);
  }

  .cv32-card *, .cv32-card *::before, .cv32-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv32-card a { color: inherit; text-decoration: none; }
  .cv32-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv32-card img { max-width: 100%; display: block; }

  .cv32-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: var(--cv32-light-blue);
    overflow: hidden;
  }
  .cv32-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv32-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv32-card:hover .cv32-img-pri { opacity: 0; }
  .cv32-card:hover .cv32-img-sec { opacity: 1; transform: scale(1.05); }

  /* Sock Tag Top Left */
  .cv32-badge-sock {
    position: absolute; top: 10px; left: 10px;
    background: var(--cv32-cobalt); color: #FFFFFF;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 9px; font-weight: 800; text-transform: uppercase;
    padding: 4px 9px; border-radius: 20px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv32-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid var(--cv32-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv32-cobalt); z-index: 3; transition: all 0.2s ease;
  }
  .cv32-wish:hover, .cv32-wish.active { background: var(--cv32-cobalt); color: #FFFFFF; border-color: var(--cv32-cobalt); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv32-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(37, 99, 235, 0.95); color: #FFFFFF;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    text-align: center; border-radius: 6px; border: 1px solid var(--cv32-cobalt);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv32-card:hover .cv32-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv32-qv-overlay:hover { background: #FFFFFF; color: #2563EB; }

  .cv32-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }
  .cv32-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv32-cobalt); font-weight: 800; font-family: 'Bricolage Grotesque', sans-serif; letter-spacing: 0.08em; }
  .cv32-title { font-family: 'Bricolage Grotesque', sans-serif; font-size: 16px; font-weight: 800; color: #1E40AF; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Sock Specs Subtitle */
  .cv32-specs { font-size: 11px; color: var(--cv32-muted); font-weight: 600; }

  /* Rating Row */
  .cv32-rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; color: #2563EB; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv32-price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv32-price { font-family: 'Bricolage Grotesque', sans-serif; font-size: 17px; font-weight: 800; color: #1E40AF; }
  .cv32-cmp { font-size: 13px; color: #9CA3AF; text-decoration: line-through; }
  .cv32-disc { font-size: 10px; font-weight: 800; color: #FFFFFF; background: var(--cv32-coral); padding: 2px 6px; border-radius: 4px; }

  /* Pack Size Variant Selector */
  .cv32-sizes { display: flex; gap: 6px; overflow-x: auto; justify-content: center; margin-top: 4px; }
  .cv32-size-btn {
    font-size: 10px; font-weight: 700; padding: 4px 9px; border-radius: 6px;
    border: 1px solid var(--cv32-border); background: #FFFFFF; color: #1E40AF; cursor: pointer; transition: all 0.2s ease;
  }
  .cv32-size-btn.active, .cv32-size-btn:hover { background: #2563EB; color: #FFFFFF; border-color: #2563EB; }

  /* Bottom Button */
  .cv32-action-box { padding: 0 14px 14px; }
  .cv32-atc-btn {
    width: 100%; padding: 11px;
    background: var(--cv32-cobalt); color: #FFFFFF;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 8px; border: none; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
  }
  .cv32-atc-btn:hover { background: #1E40AF; transform: scale(1.01); }
  .cv32-atc-btn:disabled { background: #E5E7EB; color: #9CA3AF; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv32-card" data-product-id="{{ card_prod.id }}">
    <span class="cv32-badge-sock">BLISTER FREE GUARANTEE 🧦</span>

    <button type="button" class="cv32-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv32-media">
      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv32-img cv32-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img height="{{ card_prod.images[1].height }}" width="{{ card_prod.images[1].width }}" src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv32-img cv32-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-2' | placeholder_svg_tag: 'cv32-img' }}
      {% endif %}

      <button type="button" class="cv32-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv32-content">
      {% if card_prod.vendor != blank %}<span class="cv32-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv32-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv32-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv32-specs">Seamless Toe | Honeycomb Cushioning</span>

      <div class="cv32-rating">
        <span>★ 4.9</span> <span>(4,200 reviews)</span>
      </div>

      <div class="cv32-price-row">
        <span class="cv32-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv32-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv32-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Pack Size Variant Selector -->
      <div class="cv32-sizes">
        {% for variant in card_prod.variants limit: 3 %}
          <button type="button" class="cv32-size-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv32-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv32-atc-btn" data-add-cart="{{ cur_var.id }}">STEP UP YOUR GAME</button>
      {% else %}
        <button type="button" class="cv32-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv32-card">
    <div class="cv32-media">{{ 'product-2' | placeholder_svg_tag: 'cv32-img' }}</div>
    <div class="cv32-content">
      <span class="cv32-vendor">ATHLETIC GEAR D2C</span>
      <div class="cv32-title">Performance Running Socks w/ Hex Compression</div>

      {% if card_r_show != false %}
      <div class="cv32-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv32-specs">Seamless Toe | Honeycomb Cushioning</span>
      <div class="cv32-price-row"><span class="cv32-price">₹ 499</span><span class="cv32-cmp">₹ 699</span><span class="cv32-disc">28% OFF</span></div>
    </div>
  </div>
{% endif %}
