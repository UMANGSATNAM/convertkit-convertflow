{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_cards.issued.title_html' | t: value: gift_card.initial_value, shop: shop.name }}</title>
    
    {{ 'base-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'responsive.css' | asset_url | stylesheet_tag }}
    
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    
    <style>
      body {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        background-color: var(--color-background);
        color: var(--color-text);
        font-family: var(--font-body-family), sans-serif;
        margin: 0;
        padding: var(--space-32) var(--space-16);
      }
      .gift-card-wrapper {
        background-color: var(--color-background-elevated, #fff);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        padding: var(--space-48) var(--space-32);
        max-width: 500px;
        width: 100%;
        text-align: center;
      }
      .gift-card__title {
        font-family: var(--font-heading-family);
        font-size: 2rem;
        margin-bottom: var(--space-16);
      }
      .gift-card__value {
        font-size: 3rem;
        font-weight: bold;
        color: var(--color-accent, var(--color-text));
        margin-bottom: var(--space-32);
      }
      .gift-card__image {
        max-width: 100%;
        border-radius: 8px;
        margin-bottom: var(--space-32);
      }
      .gift-card__code-container {
        background-color: var(--color-background-alt, #f5f5f5);
        border: 2px dashed var(--color-border, #e0e0e0);
        padding: var(--space-20);
        border-radius: 8px;
        margin-bottom: var(--space-24);
      }
      .gift-card__code {
        font-family: monospace;
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: 2px;
        margin: 0;
      }
      .gift-card__qr-code {
        display: flex;
        justify-content: center;
        margin-bottom: var(--space-32);
      }
      .gift-card__qr-code img {
        border-radius: 8px;
      }
      .button {
        display: inline-block;
        background-color: var(--color-button, #000);
        color: var(--color-button-text, #fff);
        padding: var(--space-16) var(--space-32);
        text-decoration: none;
        border-radius: 4px;
        font-weight: bold;
        transition: opacity var(--transition-fast);
      }
      .button:hover {
        opacity: 0.8;
      }
      .apple-wallet {
        margin-top: var(--space-20);
        display: inline-block;
      }
    </style>
  </head>
  <body>
    <div class="gift-card-wrapper">
      <h1 class="gift-card__title">{{ shop.name }}</h1>
      <div class="gift-card__value">
        {% if gift_card.balance != gift_card.initial_value %}
          <span class="gift-card__label">{{ 'gift_cards.issued.remaining_html' | t: balance: gift_card.balance | money }}</span>
        {% else %}
          {{ gift_card.initial_value | money }}
        {% endif %}
      </div>
      
      <img src="{{ 'gift-card/card.svg' | shopify_asset_url }}" alt="" class="gift-card__image" height="300" width="450" loading="eager">
      
      <div class="gift-card__code-container">
        <p class="gift-card__code" id="GiftCardDigits">{{ gift_card.code | format_code }}</p>
      </div>
      
      <div class="gift-card__qr-code" data-identifier="{{ gift_card.qr_identifier }}"></div>
      
      <a href="{{ shop.url }}" class="button" target="_blank" rel="noopener" aria-describedby="a11y-new-window-message">
        {{ 'gift_cards.issued.shop_link' | t }}
      </a>
      
      {%- if gift_card.pass_url -%}
        <div class="apple-wallet">
          <a href="{{ gift_card.pass_url }}">
            <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" loading="lazy">
          </a>
        </div>
      {%- endif -%}
    </div>
    
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var qrCodeContainer = document.querySelector('.gift-card__qr-code');
        if (qrCodeContainer) {
          new QRCode(qrCodeContainer, {
            text: qrCodeContainer.dataset.identifier,
            width: 120,
            height: 120
          });
        }
      });
    </script>
  </body>
</html>
