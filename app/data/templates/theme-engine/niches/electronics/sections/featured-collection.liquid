<section class="featured-collection featured-collection--electronics" style="padding: var(--space-64) 0; background-color: var(--color-background);">
  <div class="container">
    
    <header class="section-header text-center" style="margin-bottom: var(--space-48);">
      <h2 class="section-title" style="font-family: var(--font-heading-family); font-size: 2.5rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 var(--space-8) 0; color: #fff;">
        {{ section.settings.title | escape }}
      </h2>
      <div style="width: 40px; height: 3px; background-color: var(--color-accent); margin: 0 auto;"></div>
    </header>

    {%- liquid
      assign collection_obj = collections[section.settings.collection]
      assign limit = section.settings.products_to_show
      assign cols = section.settings.columns_desktop
    -%}

    <div class="grid grid-cols-1 grid-cols-md-2 grid-cols-lg-{{ cols }}" style="--grid-spacing: var(--space-24);">
      {%- if collection_obj != blank and collection_obj.products_count > 0 -%}
        {%- for product in collection_obj.products limit: limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <div class="product-card product-card--electronics product-card--placeholder" style="border: 1px solid var(--color-border); border-radius: var(--card-radius); background-color: var(--color-surface); overflow: hidden; display: flex; flex-direction: column;">
            <div style="aspect-ratio: 1.25; background-color: #0d1527; display: flex; align-items: center; justify-content: center; border-bottom: 1px solid var(--color-border);">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div style="padding: var(--space-16); flex-grow: 1;">
              <h3 class="product-card-title" style="font-family: var(--font-heading-family); font-size: 1.15rem; margin: 0 0 var(--space-8) 0; font-weight: 700; text-transform: uppercase;">
                HARDWARE MODULE {{ i }}
              </h3>
              <div class="price-container">
                <span class="price-item price-item--regular" style="color: var(--color-accent); font-weight: bold;">$149.00</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "SYSTEM RELEASES"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns Desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor name",
      "default": false
    }
  ]
}
{% endschema %}
