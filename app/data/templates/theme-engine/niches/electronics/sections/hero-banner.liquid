<section class="hero-banner hero-banner--electronics" style="position: relative; overflow: hidden; background-color: #05080f; color: #fff; min-height: 75vh; display: flex; align-items: center; justify-content: center; text-align: center; border-bottom: 1px solid var(--color-border);">
  
  <!-- Media background -->
  <div class="hero-banner-media-container" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;">
    {%- if section.settings.show_video and section.settings.video_url != blank -%}
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.video_url.id }}&controls=0&showinfo=0" 
                style="width: 100%; height: 100%; border: none; object-fit: cover;" allow="autoplay; encrypted-media" allowfullscreen></iframe>
      {%- else -%}
        <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&muted=1&loop=1&background=1" 
                style="width: 100%; height: 100%; border: none; object-fit: cover;" allow="autoplay; fullscreen"></iframe>
      {%- endif -%}
    {%- elsif section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1920 }}" 
           alt="{{ section.settings.image.alt | escape }}" 
           loading="eager"
           style="width: 100%; height: 100%; object-fit: cover; opacity: 0.5;">
    {%- else -%}
      <!-- Futuristic tech mesh backdrop mockup -->
      <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #0b0f19 0%, #030508 100%); opacity: 0.95;"></div>
    {%- endif -%}
  </div>

  <!-- Content -->
  <div class="container" style="position: relative; z-index: 2; max-width: 800px; padding: var(--space-48) var(--space-16);">
    <span style="font-family: var(--font-heading-family); color: var(--color-accent); font-size: 1.1rem; font-weight: 700; letter-spacing: 0.25em; text-transform: uppercase; display: inline-block; margin-bottom: var(--space-16); text-shadow: 0 0 10px rgba(0, 240, 255, 0.4);">
      // NEXT GEN GEAR //
    </span>
    
    <h2 class="hero-banner-heading" style="font-family: var(--font-heading-family); font-size: calc(2rem + 2.5vw); font-weight: 700; line-height: 1.1; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 var(--space-16) 0;">
      {{ section.settings.heading | escape }}
    </h2>
    
    {%- if section.settings.subheading != blank -%}
      <p class="hero-banner-subheading" style="font-size: 1rem; font-family: var(--font-body-family); font-weight: 400; letter-spacing: 0.02em; max-width: 600px; margin: 0 auto var(--space-32) auto; line-height: 1.6; color: #94a3b8;">
        {{ section.settings.subheading | escape }}
      </p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="button button--primary hero-banner-cta">
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>

</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "UPGRADE YOUR SET"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Engineered premium accessories built for computational speed and absolute utility."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP HARDWARE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_video",
      "label": "Enable background video",
      "default": false
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"]
    }
  ]
}
{% endschema %}
