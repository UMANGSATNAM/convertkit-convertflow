<section class="product-pdp product-pdp--electronics container" style="padding: var(--space-48) 0; background-color: var(--color-background);" data-section="{{ section.id }}">
  <div class="grid grid-cols-1 grid-cols-md-2" style="--grid-spacing: var(--space-48); align-items: start;">
    
    <!-- Gallery -->
    <div class="product-gallery-container" style="display: flex; flex-direction: column; gap: var(--space-16); position: sticky; top: var(--space-24);">
      <div class="product-gallery-featured" style="border: 1px solid var(--color-border); border-radius: var(--card-radius); overflow: hidden; background-color: #0b111e; display: flex; align-items: center; justify-content: center; aspect-ratio: 1.25;">
        <img id="FeaturedMedia-{{ section.id }}" 
             src="{{ product.featured_image | image_url: width: 1000 }}" 
             alt="{{ product.featured_image.alt | escape }}" 
             loading="eager"
             style="max-width: 90%; max-height: 90%; object-fit: contain;">
      </div>

      {%- if product.images.size > 1 -%}
        <div class="product-gallery-thumbnails" style="display: flex; gap: var(--space-12); overflow-x: auto; padding-bottom: var(--space-8);">
          {%- for img in product.images -%}
            <button type="button" class="gallery-thumbnail-btn" 
                    onclick="document.getElementById('FeaturedMedia-{{ section.id }}').src = '{{ img | image_url: width: 1000 }}'"
                    style="flex: 0 0 80px; border: 1px solid var(--color-border); border-radius: 4px; padding: 4px; background-color: var(--color-surface); cursor: pointer; aspect-ratio: 1.25; overflow: hidden; display: flex; align-items: center; justify-content: center;">
              <img src="{{ img | image_url: width: 160 }}" alt="{{ img.alt | escape }}" style="max-height: 100%; max-width: 100%; object-fit: contain;">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Buying Info -->
    <div class="product-info-container {% if section.settings.enable_sticky_info %}sticky-info{% endif %}" style="display: flex; flex-direction: column; gap: var(--space-20);">
      
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <div class="product-info-title-vendor" {{ block.shopify_attributes }}>
              <div class="product-vendor" style="text-transform: uppercase; font-size: 0.8rem; font-weight: bold; color: var(--color-accent); margin-bottom: var(--space-4); letter-spacing: 0.1em;">
                {{ product.vendor }}
              </div>
              <h1 class="product-title" style="font-family: var(--font-heading-family); font-size: 2.5rem; font-weight: 700; text-transform: uppercase; line-height: 1.1; margin: 0 0 var(--space-8) 0; color: #fff;">
                {{ product.title }}
              </h1>
            </div>

          {%- when 'price' -%}
            <div id="price-{{ section.id }}" class="product-info-price" {{ block.shopify_attributes }} style="font-family: var(--font-heading-family); font-size: 1.6rem; color: var(--color-accent);">
              {% render 'price', product: product, use_variant: false %}
            </div>

          {%- when 'variant_picker' -%}
            <div class="product-info-variants" {{ block.shopify_attributes }}>
              {%- unless product.has_only_default_variant -%}
                <variant-selects class="no-js-hidden" data-section="{{ section.id }}" data-url="{{ product.url }}">
                  {%- for option in product.options_with_values -%}
                    <div class="product-form-option" style="margin-bottom: var(--space-16);">
                      <label class="form-option-label" style="display: block; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; margin-bottom: var(--space-8); color: var(--color-accent); font-family: var(--font-heading-family);">
                        {{ option.name }}
                      </label>
                      <select name="options[{{ option.name | escape }}]" 
                              class="product-option-selector select__select"
                              style="width: 100%; padding: 12px 16px; border: 1px solid var(--color-border); background-color: var(--color-surface); font-family: var(--font-body-family); font-size: 0.95rem; border-radius: var(--button-radius); appearance: none; color: #fff; outline: none;">
                        {%- for value in option.values -%}
                          <option value="{{ value | escape }}" {% if option.selected_value == value %}selected="selected"{% endif %}>
                            {{ value }}
                          </option>
                        {%- endfor -%}
                      </select>
                    </div>
                  {%- endfor -%}
                  <script type="application/json">
                    {{ product.variants | json }}
                  </script>
                </variant-selects>
              {%- endunless -%}
            </div>

          {%- when 'quantity_selector' -%}
            <div class="product-info-quantity" {{ block.shopify_attributes }}>
              <label class="form-option-label" style="display: block; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; margin-bottom: var(--space-8); color: var(--color-accent); font-family: var(--font-heading-family);">
                {{ 'products.product.quantity' | t }}
              </label>
              <div class="quantity-stepper" style="border-color: var(--color-border); background-color: var(--color-surface);">
                <button type="button" class="quantity-stepper-btn stepper-minus" style="color: #fff;">{% render 'icon-minus' %}</button>
                <input type="number" name="quantity" value="1" min="1" class="quantity-stepper-input" style="color: #fff;">
                <button type="button" class="quantity-stepper-btn stepper-plus" style="color: #fff;">{% render 'icon-plus' %}</button>
              </div>
            </div>

          {%- when 'buy_buttons' -%}
            <div class="product-info-buy-buttons" {{ block.shopify_attributes }}>
              <form action="/cart/add" method="post" id="product-form-{{ section.id }}" class="product-form">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                
                <div class="product-form-ctas" style="display: flex; flex-direction: column; gap: var(--space-12); margin-top: var(--space-12);">
                  <button type="submit" name="add" class="product-form-main-submit button button--primary width-100" 
                          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
                          onclick="event.preventDefault(); window.PubSub.publish('cart:add', { id: this.form.id.value, quantity: this.form.quantity ? this.form.quantity.value : 1 })">
                    <span>
                      {%- if product.selected_or_first_available_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>
                  {{ form | payment_button }}
                </div>
              </form>
            </div>

          {%- when 'trust_badges' -%}
            <div class="product-info-trust-badges" {{ block.shopify_attributes }} 
                 style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: var(--space-16) 0; margin-top: var(--space-12); display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; gap: var(--space-8);">
              <div class="trust-badge-item">
                <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" width="28" height="28" style="color: var(--color-accent); margin: 0 auto var(--space-4) auto; display: block;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <span style="font-size: 0.75rem; text-transform: uppercase; font-family: var(--font-heading-family); font-weight: bold; color: #fff;">Turbo Charged</span>
              </div>
              <div class="trust-badge-item">
                <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" width="28" height="28" style="color: var(--color-accent); margin: 0 auto var(--space-4) auto; display: block;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span style="font-size: 0.75rem; text-transform: uppercase; font-family: var(--font-heading-family); font-weight: bold; color: #fff;">2 Year Warranty</span>
              </div>
              <div class="trust-badge-item">
                <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" width="28" height="28" style="color: var(--color-accent); margin: 0 auto var(--space-4) auto; display: block;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
                </svg>
                <span style="font-size: 0.75rem; text-transform: uppercase; font-family: var(--font-heading-family); font-weight: bold; color: #fff;">Cloud Sync</span>
              </div>
            </div>

          {%- when 'description' -%}
            <div class="product-info-accordions theme-accordion" data-single-expand="true" {{ block.shopify_attributes }} style="margin-top: var(--space-16);">
              <div class="accordion-item" style="border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-12); margin-bottom: var(--space-12);">
                <button type="button" class="accordion-trigger" aria-expanded="true" 
                        style="width: 100%; display: flex; justify-content: space-between; align-items: center; border: none; background: none; text-align: left; padding: var(--space-8) 0; font-family: var(--font-heading-family); font-size: 1.15rem; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em; color: #fff; font-weight: 700;">
                  <span>Hardware Specifications</span>
                  {% render 'icon-chevron' %}
                </button>
                <div class="accordion-content accordion-content--open rte" style="font-family: var(--font-body-family); font-size: 0.9rem; line-height: 1.6; color: #94a3b8; padding-top: var(--space-8);">
                  {{ product.description }}
                </div>
              </div>
            </div>

        {%- endcase -%}
      {%- endfor -%}

    </div>

  </div>
</section>

<!-- Sticky Add to Cart -->
<div class="sticky-atc-bar hide-mobile" aria-hidden="true" style="position: fixed; bottom: 0; left: 0; width: 100%; background-color: var(--color-surface); border-top: 1px solid var(--color-border); padding: var(--space-12) 0; z-index: var(--z-header); transform: translateY(100%); transition: transform var(--transition-normal);">
  <div class="container" style="display: flex; align-items: center; justify-content: space-between;">
    <div style="display: flex; align-items: center; gap: var(--space-16);">
      <img src="{{ product.featured_image | image_url: width: 100 }}" alt="{{ product.title }}" style="width: 48px; height: 48px; object-fit: contain; border-radius: 4px; background-color: #0b111e; padding: 2px;">
      <div>
        <h4 style="font-family: var(--font-heading-family); font-size: 1rem; font-weight: bold; color: #fff; margin: 0;">{{ product.title }}</h4>
        {% render 'price', product: product, use_variant: false %}
      </div>
    </div>
    <div style="display: flex; align-items: center; gap: var(--space-16);">
      {%- unless product.has_only_default_variant -%}
        <select class="sticky-atc-variant-select" style="padding: 8px 16px; border: 1px solid var(--color-border); background-color: var(--color-background); font-family: var(--font-body-family); font-size: 0.85rem; color: #fff;">
          {%- for variant in product.variants -%}
            <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected="selected"{% endif %}>
              {{ variant.title }}
            </option>
          {%- endfor -%}
        </select>
      {%- endunless -%}
      <button type="button" class="sticky-atc-submit button button--primary button--small" style="font-size: 0.8rem; padding: 8px 20px;">Add</button>
    </div>
  </div>
</div>

<style>
  .sticky-atc-bar--visible {
    transform: translateY(0) !important;
  }
</style>

{% schema %}
{
  "name": "Product Details",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "Enable sticky info column",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Enable image zoom modal",
      "default": true
    }
  ],
  "blocks": [
    { "type": "title", "name": "Product Title", "limit": 1 },
    { "type": "price", "name": "Product Price", "limit": 1 },
    { "type": "variant_picker", "name": "Variant Selector", "limit": 1 },
    { "type": "quantity_selector", "name": "Quantity Selector", "limit": 1 },
    { "type": "buy_buttons", "name": "Buy Button triggers", "limit": 1 },
    { "type": "description", "name": "Description Accordion", "limit": 1 },
    { "type": "trust_badges", "name": "Trust Badges Matrix", "limit": 1 }
  ]
}
{% endschema %}
