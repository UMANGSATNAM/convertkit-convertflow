<section class="newsletter newsletter--electronics" style="padding: var(--space-64) 0; background-color: var(--color-background); text-align: center;">
  <div class="container" style="max-width: 650px;">
    
    <div style="border: 1px solid var(--color-border); border-radius: var(--card-radius); box-shadow: var(--card-shadow); padding: var(--space-40) var(--space-24); background-color: var(--color-surface);">
      <h2 class="newsletter-heading" style="font-family: var(--font-heading-family); font-size: 2.2rem; font-weight: 700; text-transform: uppercase; margin: 0 0 var(--space-12) 0; color: #fff; text-shadow: 0 0 8px rgba(0, 240, 255, 0.2);">
        {{ section.settings.heading | escape }}
      </h2>

      {%- if section.settings.subtext != blank -%}
        <div class="newsletter-subtext" style="font-family: var(--font-body-family); font-size: 0.9rem; line-height: 1.6; color: #94a3b8; margin-bottom: var(--space-24);">
          {{ section.settings.subtext }}
        </div>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        <div class="newsletter-form-fields" style="display: flex; flex-direction: column; gap: var(--space-12); align-items: stretch; width: 100%;">
          <input type="email" 
                 name="contact[email]" 
                 class="newsletter-email-input" 
                 value="{{ form.email }}" 
                 placeholder="your.email@example.com" 
                 required 
                 aria-label="Email address"
                 style="width: 100%; padding: 12px 16px; border: 1px solid var(--color-border); background-color: var(--color-background); color: var(--color-text); font-family: var(--font-body-family); font-size: 0.95rem; border-radius: var(--button-radius); outline: none; transition: border-color var(--transition-fast);">
          
          <button type="submit" class="button button--primary newsletter-submit-btn" style="padding: 12px 0;">
            SUBSCRIBE TO FEED
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <p class="newsletter-success-msg" style="color: var(--color-accent); font-size: 0.9rem; margin-top: var(--space-16); font-weight: bold;">
            CONNECTION INITIATED. INBOX FEED SECURED.
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <p class="newsletter-error-msg" style="color: var(--color-sale-accent); font-size: 0.9rem; margin-top: var(--space-16);">
            ERROR: {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>

  </div>
</section>

<style>
  .newsletter-email-input:focus {
    border-color: var(--color-accent) !important;
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HARDWARE FIRMWARE LOGS"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Sign up to secure early beta firmware keys, product logs, and limited launch alerts.</p>"
    }
  ]
}
{% endschema %}
