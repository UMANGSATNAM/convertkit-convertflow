<section class="newsletter newsletter--streetwear" style="padding: var(--space-64) 0; background-color: var(--color-background); border-bottom: 2px solid var(--color-border); text-align: center;">
  <div class="container" style="max-width: 700px;">
    
    <div style="border: 3px solid var(--color-border); box-shadow: var(--card-shadow); padding: var(--space-40) var(--space-24); background-color: #fff; border-radius: var(--card-radius);">
      <h2 class="newsletter-heading" style="font-family: var(--font-heading-family); font-size: 2.5rem; font-weight: 900; line-height: 1; margin: 0 0 var(--space-12) 0;">
        {{ section.settings.heading | escape }}
      </h2>

      {%- if section.settings.subtext != blank -%}
        <div class="newsletter-subtext" style="font-family: var(--font-body-family); font-size: 0.9rem; font-weight: 600; color: #666; margin-bottom: var(--space-24); text-transform: uppercase;">
          {{ section.settings.subtext }}
        </div>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        <div class="newsletter-form-fields" style="display: flex; flex-direction: column; gap: var(--space-16); align-items: stretch; width: 100%;">
          <input type="email" 
                 name="contact[email]" 
                 class="newsletter-email-input" 
                 value="{{ form.email }}" 
                 placeholder="ENTER EMAIL ADDRESS FOR ACCESS" 
                 required 
                 aria-label="Email address"
                 style="width: 100%; padding: 14px 16px; border: 2px solid var(--color-border); background-color: var(--color-surface); color: var(--color-text); font-family: var(--font-body-family); font-weight: 700; font-size: 0.95rem; border-radius: var(--button-radius); outline: none;">
          
          <button type="submit" class="button button--primary newsletter-submit-btn" style="box-shadow: 3px 3px 0px var(--color-accent); border: 2px solid #000; padding: 14px 0;">
            SUBSCRIBE
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <p class="newsletter-success-msg" style="color: var(--color-accent); font-size: 0.9rem; margin-top: var(--space-16); font-weight: 800;">
            ACCESS CODE SENT TO EMAIL.
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <p class="newsletter-error-msg" style="color: var(--color-sale-accent); font-size: 0.9rem; margin-top: var(--space-16); font-weight: 800;">
            ERROR: {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SYSTEM ACCESS"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Sign up to receive early passwords for drops and exclusive system access.</p>"
    }
  ]
}
{% endschema %}
