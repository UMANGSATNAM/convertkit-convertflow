<header class="header header--streetwear" style="background-color: var(--color-background); border-bottom: 2px solid var(--color-border); padding: var(--space-20) 0;">
  <div class="container" style="display: flex; align-items: center; justify-content: space-between; position: relative;">
    
    <!-- Logo (Left) -->
    <div class="header-logo-container">
      <a href="/" class="header-logo-link" style="display: block;">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" style="max-height: 40px; width: auto;" loading="eager">
        {%- else -%}
          <span style="font-family: var(--font-heading-family); font-size: 2.2rem; font-weight: 900; letter-spacing: -0.05em; text-transform: uppercase;">
            {{ shop.name }}
          </span>
        {%- endif -%}
      </a>
    </div>

    <!-- Navigation (Center) -->
    <nav class="header-nav hide-mobile" role="navigation">
      <ul style="display: flex; list-style: none; gap: var(--space-24); margin: 0; padding: 0;">
        {%- for link in linklists[section.settings.menu].links -%}
          <li>
            <a href="{{ link.url }}" class="header-nav-link" style="font-family: var(--font-heading-family); font-size: 0.95rem; font-weight: 800; letter-spacing: 0.05em; padding: 4px 8px; transition: color var(--transition-fast);">
              {{ link.title }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <!-- Mobile Trigger -->
    <button type="button" class="header-mobile-trigger hide-desktop" data-disclosure-btn aria-expanded="false" aria-controls="mobile-menu-streetwear" style="background: none; border: 2px solid var(--color-border); padding: var(--space-8); cursor: pointer; border-radius: var(--button-radius);">
      <svg class="icon icon-menu" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="24" height="24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Actions (Right) -->
    <div class="header-actions" style="display: flex; align-items: center; gap: var(--space-12);">
      {%- if section.settings.show_search -%}
        <button type="button" class="js-search-trigger header-action-btn" aria-label="Search" style="background: none; border: 2px solid var(--color-border); padding: 8px; cursor: pointer; border-radius: var(--button-radius); display: flex; align-items: center; justify-content: center;">
          {% render 'icon-search' %}
        </button>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
        <a href="{% if customer %}/account{% else %}/account/login{% endif %}" class="header-action-btn" aria-label="Account" style="border: 2px solid var(--color-border); padding: 8px; border-radius: var(--button-radius); display: flex; align-items: center; justify-content: center;">
          {% render 'icon-account' %}
        </a>
      {%- endif -%}

      <button type="button" class="header-action-btn" aria-label="Cart" onclick="window.Cart.open()" 
              style="background: none; border: 2px solid var(--color-border); padding: 8px; cursor: pointer; border-radius: var(--button-radius); display: flex; align-items: center; justify-content: center; position: relative;">
        {% render 'icon-cart' %}
        <span class="cart-count-bubble {% if cart.item_count == 0 %}visually-hidden{% endif %}" 
              style="position: absolute; top: -5px; right: -5px; background-color: var(--color-accent); color: #fff; border: 2px solid var(--color-border); font-size: 0.7rem; font-weight: 900; width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
          {{ cart.item_count }}
        </span>
      </button>
    </div>

  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div id="mobile-menu-streetwear" class="mobile-navigation-drawer hide-desktop" style="position: fixed; top: 80px; left: 0; width: 100%; height: calc(100vh - 80px); background-color: var(--color-background); z-index: var(--z-drawer); transform: translateX(-100%); transition: transform var(--transition-normal); border-top: 2px solid var(--color-border);">
  <nav style="padding: var(--space-32);">
    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-20);">
      {%- for link in linklists[section.settings.menu].links -%}
        <li>
          <a href="{{ link.url }}" style="font-family: var(--font-heading-family); font-size: 1.5rem; font-weight: 900; text-transform: uppercase; display: block;">
            // {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</div>

<style>
  #mobile-menu-streetwear.drawer-open {
    transform: translateX(0) !important;
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search trigger",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show customer account trigger",
      "default": true
    }
  ]
}
{% endschema %}
