<section class="product-pdp product-pdp--streetwear container" style="padding: var(--space-48) 0; background-color: var(--color-background);" data-section="{{ section.id }}">
  <div class="grid grid-cols-1 grid-cols-md-2" style="--grid-spacing: var(--space-48); align-items: start;">
    
    <!-- Gallery -->
    <div class="product-gallery-container" style="display: flex; flex-direction: column; gap: var(--space-16); position: sticky; top: var(--space-24);">
      <div class="product-gallery-featured" style="border: 2px solid var(--color-border); box-shadow: 4px 4px 0px #000; overflow: hidden; background-color: #fff;">
        <img id="FeaturedMedia-{{ section.id }}" 
             src="{{ product.featured_image | image_url: width: 1000 }}" 
             alt="{{ product.featured_image.alt | escape }}" 
             loading="eager"
             style="width: 100%; aspect-ratio: 0.8; object-fit: cover;">
      </div>

      {%- if product.images.size > 1 -%}
        <div class="product-gallery-thumbnails" style="display: flex; gap: var(--space-12); overflow-x: auto; padding-bottom: var(--space-8);">
          {%- for img in product.images -%}
            <button type="button" class="gallery-thumbnail-btn" 
                    onclick="document.getElementById('FeaturedMedia-{{ section.id }}').src = '{{ img | image_url: width: 1000 }}'"
                    style="flex: 0 0 80px; border: 2px solid var(--color-border); padding: 4px; background-color: #fff; cursor: pointer; aspect-ratio: 0.8; overflow: hidden; display: flex; align-items: center; justify-content: center; box-shadow: 2px 2px 0px #000;">
              <img src="{{ img | image_url: width: 160 }}" alt="{{ img.alt | escape }}" style="max-height: 100%; max-width: 100%; object-fit: cover;">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Details -->
    <div class="product-info-container {% if section.settings.enable_sticky_info %}sticky-info{% endif %}" style="display: flex; flex-direction: column; gap: var(--space-20);">
      
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <div class="product-info-title-vendor" {{ block.shopify_attributes }}>
              <div class="product-vendor" style="text-transform: uppercase; font-size: 0.8rem; font-weight: 800; color: var(--color-accent); margin-bottom: var(--space-4);">
                {{ product.vendor }}
              </div>
              <h1 class="product-title" style="font-family: var(--font-heading-family); font-size: 2.5rem; font-weight: 900; line-height: 1; margin: 0 0 var(--space-8) 0; letter-spacing: -0.01em;">
                {{ product.title }}
              </h1>
            </div>

          {%- when 'price' -%}
            <div id="price-{{ section.id }}" class="product-info-price" {{ block.shopify_attributes }} style="font-size: 1.5rem; font-weight: 900; font-family: var(--font-heading-family);">
              {% render 'price', product: product, use_variant: false %}
            </div>

          {%- when 'variant_picker' -%}
            <div class="product-info-variants" {{ block.shopify_attributes }}>
              {%- unless product.has_only_default_variant -%}
                <variant-selects class="no-js-hidden" data-section="{{ section.id }}" data-url="{{ product.url }}">
                  {%- for option in product.options_with_values -%}
                    <div class="product-form-option" style="margin-bottom: var(--space-16);">
                      <label class="form-option-label" style="display: block; font-size: 0.85rem; font-weight: 900; margin-bottom: var(--space-8);">
                        SELECT {{ option.name | uppercase }}
                      </label>
                      <select name="options[{{ option.name | escape }}]" 
                              class="product-option-selector select__select"
                              style="width: 100%; padding: 12px 16px; border: 2px solid var(--color-border); background-color: var(--color-surface); font-family: var(--font-body-family); font-weight: 700; font-size: 0.95rem; border-radius: var(--button-radius); appearance: none; outline: none;">
                        {%- for value in option.values -%}
                          <option value="{{ value | escape }}" {% if option.selected_value == value %}selected="selected"{% endif %}>
                            {{ value }}
                          </option>
                        {%- endfor -%}
                      </select>
                    </div>
                  {%- endfor -%}
                  <script type="application/json">
                    {{ product.variants | json }}
                  </script>
                </variant-selects>
              {%- endunless -%}
            </div>

          {%- when 'quantity_selector' -%}
            <div class="product-info-quantity" {{ block.shopify_attributes }}>
              <label class="form-option-label" style="display: block; font-size: 0.85rem; font-weight: 900; margin-bottom: var(--space-8);">
                QUANTITY
              </label>
              <div class="quantity-stepper" style="border: 2px solid var(--color-border);">
                <button type="button" class="quantity-stepper-btn stepper-minus">{% render 'icon-minus' %}</button>
                <input type="number" name="quantity" value="1" min="1" class="quantity-stepper-input" style="font-weight: bold;">
                <button type="button" class="quantity-stepper-btn stepper-plus">{% render 'icon-plus' %}</button>
              </div>
            </div>

          {%- when 'buy_buttons' -%}
            <div class="product-info-buy-buttons" {{ block.shopify_attributes }}>
              <form action="/cart/add" method="post" id="product-form-{{ section.id }}" class="product-form">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                
                <div class="product-form-ctas" style="display: flex; flex-direction: column; gap: var(--space-12); margin-top: var(--space-12);">
                  <button type="submit" name="add" class="product-form-main-submit button button--primary width-100" 
                          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
                          style="box-shadow: 4px 4px 0px var(--color-accent); border: 2px solid #000; padding: 16px 0; font-size: 1rem;"
                          onclick="event.preventDefault(); window.PubSub.publish('cart:add', { id: this.form.id.value, quantity: this.form.quantity ? this.form.quantity.value : 1 })">
                    <span>
                      {%- if product.selected_or_first_available_variant.available -%}
                        ADD TO CART
                      {%- else -%}
                        SOLD OUT
                      {%- endif -%}
                    </span>
                  </button>
                  {{ form | payment_button }}
                </div>
              </form>
            </div>

          {%- when 'trust_badges' -%}
            <div class="product-info-trust-badges" {{ block.shopify_attributes }} 
                 style="border: 2px solid var(--color-border); box-shadow: 4px 4px 0px var(--color-accent); border-radius: var(--card-radius); padding: var(--space-20); margin-top: var(--space-12); background-color: #fff;">
              <div style="font-family: var(--font-heading-family); font-size: 1.1rem; font-weight: 900; margin-bottom: var(--space-12); border-bottom: 2px solid var(--color-border); padding-bottom: 4px;">
                // SPECS & DETAILS //
              </div>
              <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-8); font-family: var(--font-body-family); font-size: 0.85rem; font-weight: 700;">
                <li>Heavyweight 320GSM Loopback Cotton</li>
                <li>Preshrunk & Pigment Dyed for Vintage Wash</li>
                <li>Made in Portugal</li>
              </ul>
            </div>

          {%- when 'description' -%}
            <div class="product-info-accordions theme-accordion" data-single-expand="true" {{ block.shopify_attributes }} style="margin-top: var(--space-16);">
              <div class="accordion-item" style="border: 2px solid var(--color-border); margin-bottom: var(--space-12); background-color: #fff; border-radius: var(--card-radius); overflow: hidden; box-shadow: 2px 2px 0px #000;">
                <button type="button" class="accordion-trigger" aria-expanded="true" 
                        style="width: 100%; display: flex; justify-content: space-between; align-items: center; border: none; border-bottom: 2px solid var(--color-border); background: none; text-align: left; padding: var(--space-16); font-family: var(--font-heading-family); font-size: 1.1rem; cursor: pointer; font-weight: 900;">
                  <span>DETAILS</span>
                  {% render 'icon-chevron' %}
                </button>
                <div class="accordion-content accordion-content--open rte" style="font-family: var(--font-body-family); font-size: 0.9rem; line-height: 1.6; padding: var(--space-16); color: #333;">
                  {{ product.description }}
                </div>
              </div>
            </div>

        {%- endcase -%}
      {%- endfor -%}

    </div>

  </div>
</section>

<!-- Sticky Add to Cart -->
<div class="sticky-atc-bar hide-mobile" aria-hidden="true" style="position: fixed; bottom: 0; left: 0; width: 100%; background-color: var(--color-background); border-top: 2px solid var(--color-border); padding: var(--space-12) 0; z-index: var(--z-header); transform: translateY(100%); transition: transform var(--transition-normal);">
  <div class="container" style="display: flex; align-items: center; justify-content: space-between;">
    <div style="display: flex; align-items: center; gap: var(--space-16);">
      <img src="{{ product.featured_image | image_url: width: 100 }}" alt="{{ product.title }}" style="width: 48px; height: 48px; object-fit: cover; border: 1px solid var(--color-border);">
      <div>
        <h4 style="font-family: var(--font-heading-family); font-size: 1rem; font-weight: 900; margin: 0;">{{ product.title }}</h4>
        {% render 'price', product: product, use_variant: false %}
      </div>
    </div>
    <div style="display: flex; align-items: center; gap: var(--space-16);">
      {%- unless product.has_only_default_variant -%}
        <select class="sticky-atc-variant-select" style="padding: 8px 16px; border: 2px solid var(--color-border); background-color: var(--color-surface); font-family: var(--font-body-family); font-weight: bold; font-size: 0.85rem;">
          {%- for variant in product.variants -%}
            <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected="selected"{% endif %}>
              {{ variant.title }}
            </option>
          {%- endfor -%}
        </select>
      {%- endunless -%}
      <button type="button" class="sticky-atc-submit button button--primary button--small" style="box-shadow: 2px 2px 0px #000; font-size: 0.8rem; padding: 8px 16px;">ADD</button>
    </div>
  </div>
</div>

<style>
  .sticky-atc-bar--visible {
    transform: translateY(0) !important;
  }
</style>

{% schema %}
{
  "name": "Product Details",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "Enable sticky info column",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Enable image zoom modal",
      "default": true
    }
  ],
  "blocks": [
    { "type": "title", "name": "Product Title", "limit": 1 },
    { "type": "price", "name": "Product Price", "limit": 1 },
    { "type": "variant_picker", "name": "Variant Selector", "limit": 1 },
    { "type": "quantity_selector", "name": "Quantity Selector", "limit": 1 },
    { "type": "buy_buttons", "name": "Buy Button triggers", "limit": 1 },
    { "type": "description", "name": "Description Accordion", "limit": 1 },
    { "type": "trust_badges", "name": "Trust Badges Matrix", "limit": 1 }
  ]
}
{% endschema %}
