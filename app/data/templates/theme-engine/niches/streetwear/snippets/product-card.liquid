{%- liquid
  assign ratio = 0.8
  assign featured_image = product.featured_image
  assign second_image = product.images[1]
-%}

<div class="product-card product-card--streetwear" style="border: 2px solid var(--color-border); border-radius: var(--card-radius); box-shadow: var(--card-shadow); background-color: #fff; overflow: hidden; display: flex; flex-direction: column;">
  <div class="product-card-media-wrapper" style="position: relative; overflow: hidden; aspect-ratio: {{ ratio }}; border-bottom: 2px solid var(--color-border);">
    
    <!-- Wishlist Toggle -->
    <button type="button" class="js-wishlist-toggle wishlist-toggle-btn" data-product-handle="{{ product.handle }}" aria-label="Add to wishlist" 
            style="position: absolute; right: 12px; top: 12px; z-index: 10; background-color: #fff; border: 2px solid var(--color-border); border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 2px 2px 0px #000;">
      {% render 'icon-heart', filled: false %}
    </button>

    <a href="{{ product.url }}" class="product-card-image-link" style="display: block; width: 100%; height: 100%;">
      <img src="{{ featured_image | image_url: width: 480 }}" 
           alt="{{ featured_image.alt | escape }}" 
           class="product-card-image main-image" 
           loading="lazy" 
           style="width: 100%; height: 100%; object-fit: cover;">
      
      {%- if second_image != blank and settings.product_card_swap_image_on_hover -%}
        <img src="{{ second_image | image_url: width: 480 }}" 
             alt="{{ second_image.alt | escape }}" 
             class="product-card-image hover-image" 
             loading="lazy" 
             style="width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; opacity: 0; transition: opacity var(--transition-fast);">
      {%- endif -%}
    </a>
  </div>

  <div class="product-card-info" style="padding: var(--space-16); flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; text-align: left; background-color: #fff;">
    <div>
      {%- if settings.product_card_show_vendor -%}
        <div class="product-card-vendor" style="font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; color: var(--color-accent); margin-bottom: var(--space-4);">
          {{ product.vendor }}
        </div>
      {%- endif -%}
      
      <h3 class="product-card-title" style="font-size: 1.15rem; font-family: var(--font-heading-family); margin: 0 0 var(--space-8) 0; line-height: 1.1;">
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h3>
    </div>

    <div>
      {% render 'price', product: product, use_variant: false %}

      <div class="product-card-actions" style="margin-top: var(--space-12);">
        <button type="button" class="button button--primary width-100 product-card-quick-add" style="padding: 10px 0; font-size: 0.8rem; box-shadow: 2px 2px 0px var(--color-border);" onclick="window.PubSub.publish('cart:add', { id: {{ product.selected_or_first_available_variant.id }} })">
          ADD TO CART
        </button>
      </div>
    </div>
  </div>
</div>
