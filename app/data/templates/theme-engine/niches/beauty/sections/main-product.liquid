{%- comment -%}
  Section: main-product (Beauty niche)
  Personality: Soft, clean, minimal, high-growth D2C look.
  Urgency tone: Live demand-driven ("Almost sold out, get yours now")
  Visitor counter: "X people viewing this glow secret"
{%- endcomment -%}

{%- liquid
  assign p = product
  assign cur = p.selected_or_first_available_variant
  assign on_sale = false
  if p.compare_at_price > p.price
    assign on_sale = true
  endif
  assign save_pct = 0
  if on_sale
    assign diff = p.compare_at_price | minus: p.price
    assign save_pct = diff | times: 100 | divided_by: p.compare_at_price
  endif
-%}

<style>
  #beauty-{{ section.id }} {
    --bg-beauty: var(--color-background);
    --text-beauty: var(--color-text);
    --accent-beauty: var(--color-accent);
    --border-beauty: var(--color-border);
    --surface-beauty: var(--color-surface);
    --soft-rose: #FFF5F5;
    --gold-stars: #F59E0B;
  }
</style>

<div class="beauty-pdp" id="beauty-{{ section.id }}">
  {%- if p == empty -%}
    <div class="beauty-wrap beauty-placeholder"><p>Assign to a product template.</p></div>
  {%- else -%}

  <div class="beauty-wrap">
    <!-- Breadcrumbs -->
    <nav class="crumb">
      <a href="{{ routes.root_url }}">Home</a> &nbsp;/&nbsp;
      {%- if p.collections.size > 0 -%}<a href="{{ p.collections.first.url }}">{{ p.collections.first.title }}</a>&nbsp;/&nbsp;{%- endif -%}
      {{ p.title }}
    </nav>

    <div class="product">
      <!-- GALLERY: Smooth, responsive, hover zoom -->
      <div class="gallery">
        <div class="gallery-main">
          {%- if on_sale -%}<div class="b-badge">-{{ save_pct }}% OFF</div>{%- endif -%}
          {%- if p.featured_media -%}
            <img id="beautyMain-{{ section.id }}" src="{{ p.featured_media | image_url: width: 900 }}" alt="{{ p.featured_media.alt | escape }}" width="900" height="900" loading="eager">
          {%- endif -%}
        </div>
        {%- if p.media.size > 1 -%}
          <div class="thumbs" id="beautyThumbs-{{ section.id }}">
            {%- for media in p.media limit: 6 -%}
              <button type="button" class="thumb{% if forloop.first %} active{% endif %}" data-src="{{ media | image_url: width: 900 }}">
                <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | escape }}" loading="lazy" width="200" height="200">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- BUY BOX -->
      <div class="buybox">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'title' -%}
              <div class="p-title-block" {{ block.shopify_attributes }}>
                {%- if p.vendor != blank -%}<span class="eyebrow">{{ p.vendor }}</span>{%- endif -%}
                <h1 class="ptitle">{{ p.title }}</h1>
                
                <!-- Visitor Counter & Rating Combined for Cleanliness -->
                <div class="rating-visitor-row">
                  <div class="rating">
                    <span class="stars">★★★★★</span>
                    <b>4.8</b>
                    <span>(124 Reviews)</span>
                  </div>
                  <div class="visitor-counter">
                    <span class="vc-dot"></span>
                    <span><span id="beautyVcNum-{{ section.id }}">36</span> views in last 10m</span>
                  </div>
                </div>
              </div>

            {%- when 'price' -%}
              <div class="p-price-block" {{ block.shopify_attributes }}>
                <div class="pricerow">
                  <span class="price-now" id="beautyPrice-{{ section.id }}">{{ cur.price | money }}</span>
                  {%- if on_sale -%}
                    <span class="price-mrp" id="beautyMrp-{{ section.id }}">{{ cur.compare_at_price | money }}</span>
                    <span class="price-save">Save {{ save_pct }}%</span>
                  {%- endif -%}
                </div>
                <p class="tax-note">Inclusive of all taxes & Free Insured Shipping</p>
              </div>

            {%- when 'variant_picker' -%}
              <div class="p-variants-block" {{ block.shopify_attributes }}>
                {%- unless p.has_only_default_variant -%}
                  <label class="opt-label">{{ p.options.first }}</label>
                  <div class="variants" id="beautyVariants-{{ section.id }}">
                    {%- for variant in p.variants -%}
                      <input class="v-radio" type="radio" name="beauty-v-{{ section.id }}" id="bv-{{ section.id }}-{{ variant.id }}" value="{{ variant.id }}"
                        data-price="{{ variant.price | money }}"
                        {% if variant.compare_at_price > variant.price %}data-mrp="{{ variant.compare_at_price | money }}"{% endif %}
                        {% unless variant.available %}disabled{% endunless %}
                        {% if variant.id == cur.id %}checked{% endif %} hidden>
                      <label class="variant" for="bv-{{ section.id }}-{{ variant.id }}">
                        {{ variant.title }}
                        {%- unless variant.available -%}<small>Unavailable</small>{%- endunless -%}
                      </label>
                    {%- endfor -%}
                  </div>
                {%- endunless -%}
              </div>

            {%- when 'quantity_selector' -%}
              <div class="p-qty-block" {{ block.shopify_attributes }}>
                <label class="opt-label">Quantity</label>
                <div class="qty-stepper">
                  <button type="button" class="qminus" aria-label="−">−</button>
                  <input class="qinput" type="number" name="quantity" value="1" min="1" max="10">
                  <button type="button" class="qplus" aria-label="+">+</button>
                </div>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="p-buy-block" {{ block.shopify_attributes }}>
                {%- form 'product', p, id: 'beautyForm-' | append: section.id, class: 'beauty-form' -%}
                  <input type="hidden" name="id" id="beautyVarId-{{ section.id }}" value="{{ cur.id }}">
                  <div class="buy-actions">
                    <button type="submit" name="add" class="btn btn-add"{% unless cur.available %} disabled{% endunless %}>
                      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                      <span>{% if cur.available %}Add to Bag{% else %}Sold Out{% endif %}</span>
                    </button>
                  </div>
                  {%- if section.settings.enable_dynamic_checkout -%}
                    <div class="beauty-dcb">{{ form | payment_button }}</div>
                  {%- endif -%}
                {%- endform -%}

                <!-- URGENCY: Live Inventory Stock Progress Bar -->
                <div class="stock-progress-container">
                  <div class="stock-header">
                    <span>🔥 Selling fast: Only <b id="beautyStockNum-{{ section.id }}">7</b> left in stock</span>
                    <span class="stock-alert-pulse"></span>
                  </div>
                  <div class="stock-bar-outer">
                    <div class="stock-bar-inner" style="width: 35%;"></div>
                  </div>
                </div>

                <!-- DELIVERY TIMER PROMISE -->
                <div class="delivery-promise">
                  🚚 Delivery within <b>3-4 business days</b>. Order in next <span class="beauty-cd"><b>02h 45m 12s</b></span>
                </div>
              </div>

            {%- when 'trust_badges' -%}
              <div class="p-trust-block" {{ block.shopify_attributes }}>
                <div class="trust-strip">
                  <div class="trust-item">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span>Dermatologically Tested</span>
                  </div>
                  <div class="trust-item">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21V9.75M12 9.75a3 3 0 116 0c0 1.657-2.686 3-6 3zm0 0a3 3 0 10-6 0c0 1.657 2.686 3 6 3z" /></svg>
                    <span>100% Vegan & Cruelty Free</span>
                  </div>
                  <div class="trust-item">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751A11.956 11.956 0 0112 2.714z" /></svg>
                    <span>FDA Approved</span>
                  </div>
                </div>
              </div>

            {%- when 'description' -%}
              <div class="p-desc-block" {{ block.shopify_attributes }}>
                <div class="acc">
                  <div class="acc-item open">
                    <button type="button" class="acc-q">Product Details <span class="ico">+</span></button>
                    <div class="acc-a"><div class="acc-rt">{{ product.description }}</div></div>
                  </div>
                </div>
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <!-- STICKY MOBILE BAR -->
  <div class="sticky-bar" id="beautySticky-{{ section.id }}">
    <div class="sb-info">
      <div class="nm">{{ p.title | truncate: 22 }}</div>
      <div class="pr"><b id="beautySbPrice-{{ section.id }}">{{ cur.price | money }}</b></div>
    </div>
    <button type="button" class="btn btn-add beauty-sticky-add">Add to Bag</button>
  </div>

  {%- endif -%}
</div>

{% stylesheet %}
.beauty-pdp {
  background: var(--color-background);
  color: var(--color-text);
  font-family: var(--font-body-family), sans-serif;
  line-height: 1.6;
}
.beauty-pdp img { max-width: 100%; display: block; }
.beauty-pdp a { color: inherit; text-decoration: none; }
.beauty-pdp button { font-family: inherit; cursor: pointer; }
.beauty-wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
.beauty-placeholder { padding: 60px 20px; text-align: center; color: #888; }

.beauty-pdp .crumb { font-size: 11px; color: #888; padding: 20px 0; text-transform: uppercase; letter-spacing: 0.05em; }
.beauty-pdp .product { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; padding-bottom: 60px; align-items: start; }
@media(max-width: 900px) { .beauty-pdp .product { grid-template-columns: 1fr; gap: 30px; } }

.beauty-pdp .gallery { position: sticky; top: 90px; }
@media(max-width: 900px) { .beauty-pdp .gallery { position: static; } }
.beauty-pdp .gallery-main { position: relative; aspect-ratio: 1; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--card-radius); background: var(--color-surface); }
.beauty-pdp .gallery-main img { width: 100%; height: 100%; object-fit: cover; }
.beauty-pdp .b-badge { position: absolute; top: 12px; left: 12px; background: var(--color-accent); color: #fff; font-size: 11px; font-weight: bold; padding: 4px 8px; border-radius: 4px; z-index: 2; }
.beauty-pdp .thumbs { display: flex; gap: 10px; margin-top: 12px; overflow-x: auto; }
.beauty-pdp .thumb { flex: 0 0 70px; aspect-ratio: 1; overflow: hidden; border: 1px solid var(--color-border); border-radius: 4px; background: #fff; opacity: 0.6; padding: 0; }
.beauty-pdp .thumb.active { border-color: var(--color-accent); opacity: 1; }
.beauty-pdp .thumb img { width: 100%; height: 100%; object-fit: cover; }

.beauty-pdp .eyebrow { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); display: block; margin-bottom: 8px; }
.beauty-pdp .ptitle { font-size: 32px; line-height: 1.25; font-weight: 700; margin: 0 0 12px 0; font-family: var(--font-heading-family); }
@media(max-width: 520px) { .beauty-pdp .ptitle { font-size: 26px; } }

.beauty-pdp .rating-visitor-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; border-bottom: 1px solid var(--color-border); padding-bottom: 16px; }
.beauty-pdp .rating { display: flex; align-items: center; gap: 6px; font-size: 13px; }
.beauty-pdp .stars { color: #F59E0B; letter-spacing: 1px; }
.beauty-pdp .visitor-counter { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #666; font-style: italic; }
.beauty-pdp .vc-dot { width: 6px; height: 6px; border-radius: 50%; background: #10B981; animation: beautyPulse 2s infinite; }
@keyframes beautyPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

.beauty-pdp .pricerow { display: flex; align-items: center; gap: 12px; }
.beauty-pdp .price-now { font-size: 26px; font-weight: 700; color: var(--color-text); }
.beauty-pdp .price-mrp { font-size: 18px; color: #888; text-decoration: line-through; }
.beauty-pdp .price-save { font-size: 12px; background: #FFF5F5; color: var(--color-accent); font-weight: 700; padding: 2px 8px; border-radius: 4px; border: 1px dashed var(--color-accent); }
.beauty-pdp .tax-note { font-size: 11px; color: #777; margin: 4px 0 20px 0; }

.beauty-pdp .opt-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 8px; color: var(--color-text); }
.beauty-pdp .variants { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
.beauty-pdp .variant { border: 1px solid var(--color-border); background: #fff; padding: 8px 16px; border-radius: 20px; font-size: 13px; font-weight: 500; transition: 0.15s; display: inline-block; cursor: pointer; }
.beauty-pdp .v-radio:checked + .variant { border-color: var(--color-text); background: var(--color-text); color: #fff; }
.beauty-pdp .v-radio:disabled + .variant { opacity: 0.4; text-decoration: line-through; }

.beauty-pdp .qty-stepper { display: flex; align-items: center; border: 1px solid var(--color-border); border-radius: 4px; width: fit-content; overflow: hidden; margin-bottom: 24px; height: 38px; }
.beauty-pdp .qty-stepper button { width: 34px; height: 100%; border: none; background: transparent; font-size: 16px; transition: background 0.2s; }
.beauty-pdp .qty-stepper button:hover { background: var(--color-surface); }
.beauty-pdp .qty-stepper input { width: 34px; text-align: center; border: none; font-size: 14px; font-weight: bold; background: transparent; pointer-events: none; }

.beauty-pdp .buy-actions { margin-top: 10px; }
.beauty-pdp .btn { font-weight: 700; font-size: 13px; letter-spacing: 0.05em; text-transform: uppercase; height: 48px; border-radius: 4px; display: flex; align-items: center; justify-content: center; gap: 8px; transition: opacity 0.2s; border: none; width: 100%; }
.beauty-pdp .btn-add { background: var(--color-text); color: #fff; }
.beauty-pdp .btn-add:hover { opacity: 0.9; }
.beauty-pdp .btn-add[disabled] { opacity: 0.5; cursor: not-allowed; }
.beauty-pdp .beauty-dcb { margin-top: 8px; }

.beauty-pdp .stock-progress-container { margin-top: 20px; background: #FFF9F9; padding: 12px; border-radius: 6px; border: 1px solid #FFEBEB; }
.beauty-pdp .stock-header { display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-weight: 700; color: var(--color-accent); margin-bottom: 6px; }
.beauty-pdp .stock-alert-pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); animation: alertPulse 1.2s infinite; }
@keyframes alertPulse { 0% { transform: scale(0.9); opacity: 1; } 50% { transform: scale(1.3); opacity: 0.5; } 100% { transform: scale(0.9); opacity: 1; } }
.beauty-pdp .stock-bar-outer { height: 6px; background: #E5E7EB; border-radius: 3px; overflow: hidden; }
.beauty-pdp .stock-bar-inner { height: 100%; background: var(--color-accent); border-radius: 3px; }

.beauty-pdp .delivery-promise { font-size: 12px; color: #555; margin-top: 12px; border-top: 1px dashed var(--color-border); padding-top: 12px; }

.beauty-pdp .trust-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 24px; padding: 12px 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
.beauty-pdp .trust-item { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; font-size: 10px; color: #666; font-weight: 700; }
.beauty-pdp .trust-item svg { width: 20px; height: 20px; color: var(--color-accent); }

.beauty-pdp .acc { margin-top: 20px; border-top: 1px solid var(--color-border); }
.beauty-pdp .acc-item { border-bottom: 1px solid var(--color-border); }
.beauty-pdp .acc-q { width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 14px 0; font-size: 13px; font-weight: 700; text-transform: uppercase; color: var(--color-text); background: none; border: none; text-align: left; }
.beauty-pdp .acc-q .ico { font-size: 16px; color: #888; transition: transform 0.2s; }
.beauty-pdp .acc-item.open .ico { transform: rotate(45deg); }
.beauty-pdp .acc-a { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
.beauty-pdp .acc-item.open .acc-a { max-height: 500px; }
.beauty-pdp .acc-rt { font-size: 13px; color: #555; padding-bottom: 14px; line-height: 1.6; }

.beauty-pdp .sticky-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 80; background: var(--color-background); border-top: 1px solid var(--color-border); padding: 12px 20px; display: flex; align-items: center; gap: 14px; transform: translateY(120%); transition: transform 0.3s ease; }
.beauty-pdp .sticky-bar.show { transform: translateY(0); }
.beauty-pdp .sb-info .nm { font-size: 13px; color: var(--color-text); font-weight: bold; line-height: 1.2; }
.beauty-pdp .sb-info .pr b { font-size: 14px; color: var(--color-accent); }
.beauty-pdp .sticky-bar .btn { flex: 1; height: 40px; background: var(--color-text); color: #fff; width: auto; font-size: 12px; }
@media(min-width: 921px) { .beauty-pdp .sticky-bar { display: none; } }
@media(prefers-reduced-motion:reduce) { .beauty-pdp *, .beauty-pdp *::before, .beauty-pdp *::after { animation: none!important; transition: none!important; } }
{% endstylesheet %}

<script>
(function(){
  var root = document.getElementById('beauty-{{ section.id }}'); if(!root) return;
  var mainImg = document.getElementById('beautyMain-{{ section.id }}');
  var thumbs = document.getElementById('beautyThumbs-{{ section.id }}');
  if(thumbs && mainImg){
    thumbs.addEventListener('click', function(e){
      var t = e.target.closest('.thumb'); if(!t) return;
      thumbs.querySelectorAll('.thumb').forEach(function(x){ x.classList.remove('active'); });
      t.classList.add('active'); mainImg.src = t.dataset.src;
    });
  }

  var varId = document.getElementById('beautyVarId-{{ section.id }}');
  var priceNow = document.getElementById('beautyPrice-{{ section.id }}');
  var priceMrp = document.getElementById('beautyMrp-{{ section.id }}');
  var sbPrice = document.getElementById('beautySbPrice-{{ section.id }}');
  root.querySelectorAll('.v-radio').forEach(function(r){
    r.addEventListener('change', function(){
      if(varId) varId.value = r.value;
      if(priceNow && r.dataset.price) priceNow.textContent = r.dataset.price;
      if(sbPrice && r.dataset.price) sbPrice.textContent = r.dataset.price;
      if(priceMrp){
        if(r.dataset.mrp){
          priceMrp.textContent = r.dataset.mrp;
          priceMrp.style.display = '';
        } else {
          priceMrp.style.display = 'none';
        }
      }
    });
  });

  var qtyInput = root.querySelector('.qinput');
  var qMinus = root.querySelector('.qminus');
  var qPlus = root.querySelector('.qplus');
  if(qtyInput && qMinus && qPlus){
    qMinus.addEventListener('click', function(){
      var val = parseInt(qtyInput.value, 10) || 1;
      if(val > 1) qtyInput.value = val - 1;
    });
    qPlus.addEventListener('click', function(){
      var val = parseInt(qtyInput.value, 10) || 1;
      if(val < 10) qtyInput.value = val + 1;
    });
  }

  var acc = root.querySelector('.acc');
  if(acc){
    acc.addEventListener('click', function(e){
      var q = e.target.closest('.acc-q'); if(!q) return;
      var item = q.parentElement; var a = item.querySelector('.acc-a'); var open = item.classList.contains('open');
      acc.querySelectorAll('.acc-item').forEach(function(i){
        i.classList.remove('open');
        i.querySelector('.acc-a').style.maxHeight = null;
      });
      if(!open){
        item.classList.add('open');
        a.style.maxHeight = a.scrollHeight + 'px';
      }
    });
    var fo = acc.querySelector('.acc-item.open .acc-a'); if(fo) fo.style.maxHeight = fo.scrollHeight + 'px';
  }

  var cds = root.querySelectorAll('.beauty-cd');
  if(cds.length){
    function tick(){
      var now = new Date(), end = new Date(); end.setHours(23, 59, 59, 999);
      var diff = Math.max(0, end - now);
      var h = String(Math.floor(diff / 3.6e6)).padStart(2, '0');
      var m = String(Math.floor(diff % 3.6e6 / 6e4)).padStart(2, '0');
      var s = String(Math.floor(diff % 6e4 / 1e3)).padStart(2, '0');
      cds.forEach(function(el){ el.innerHTML = '<b>' + h + 'h ' + m + 'm ' + s + 's</b>'; });
    } tick(); setInterval(tick, 1000);
  }

  /* Visitor counter */
  var vcNum = document.getElementById('beautyVcNum-{{ section.id }}');
  if(vcNum){
    var base = Math.floor(Math.random() * (45 - 18 + 1)) + 18;
    vcNum.textContent = base;
    setInterval(function(){
      var delta = (Math.random() < .5 ? 1 : -1) * (Math.floor(Math.random() * 3) + 1);
      base = Math.max(12, Math.min(85, base + delta));
      vcNum.textContent = base;
    }, 5000);
  }

  /* Stock counter */
  var stockNum = document.getElementById('beautyStockNum-{{ section.id }}');
  var stockBar = root.querySelector('.stock-bar-inner');
  if(stockNum && stockBar){
    var baseStock = Math.floor(Math.random() * (9 - 4 + 1)) + 4;
    stockNum.textContent = baseStock;
    stockBar.style.width = (baseStock * 10) + '%';
    setInterval(function(){
      if(baseStock > 2 && Math.random() < 0.15) {
        baseStock--;
        stockNum.textContent = baseStock;
        stockBar.style.width = (baseStock * 10) + '%';
      }
    }, 12000);
  }

  var sticky = document.getElementById('beautySticky-{{ section.id }}');
  var trigger = root.querySelector('.buy-actions');
  if(sticky && trigger && 'IntersectionObserver' in window){
    new IntersectionObserver(function(entries){
      var e = entries[0];
      if(e.isIntersecting) sticky.classList.remove('show');
      else if(e.boundingClientRect.top < 0) sticky.classList.add('show');
    }, {threshold: 0}).observe(trigger);
  }

  var sAdd = root.querySelector('.beauty-sticky-add');
  var addBtn = root.querySelector('.btn-add');
  if(sAdd && addBtn) sAdd.onclick = function(){ addBtn.click(); };
})();
</script>

