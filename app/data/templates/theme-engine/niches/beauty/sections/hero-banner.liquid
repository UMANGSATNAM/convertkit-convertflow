<section class="hero-banner hero-banner--beauty" style="position: relative; overflow: hidden; background-color: #f7ede2; color: var(--color-text); min-height: 70vh; display: flex; align-items: center; padding: var(--space-48) 0; text-align: left; border-bottom: 1px solid var(--color-border);">
  
  <!-- Media background -->
  <div class="hero-banner-media-container" style="position: absolute; top: 0; right: 0; width: 100%; height: 100%; z-index: 1;">
    {%- if section.settings.show_video and section.settings.video_url != blank -%}
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.video_url.id }}&controls=0&showinfo=0" 
                style="width: 100%; height: 100%; border: none; object-fit: cover;" allow="autoplay; encrypted-media" allowfullscreen></iframe>
      {%- else -%}
        <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&muted=1&loop=1&background=1" 
                style="width: 100%; height: 100%; border: none; object-fit: cover;" allow="autoplay; fullscreen"></iframe>
      {%- endif -%}
    {%- elsif section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1920 }}" 
           alt="{{ section.settings.image.alt | escape }}" 
           loading="eager"
           style="width: 100%; height: 100%; object-fit: cover; opacity: 0.85;">
    {%- else -%}
      <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #f7efe2 0%, #fae6e0 100%);"></div>
    {%- endif -%}
  </div>

  <!-- Content (Middle Left Overlayed) -->
  <div class="container" style="position: relative; z-index: 2; width: 100%;">
    <div style="max-width: 550px; background-color: rgba(255, 255, 255, 0.9); padding: var(--space-40); border-radius: var(--card-radius); box-shadow: var(--card-shadow); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.6);">
      
      <h2 class="hero-banner-heading" style="font-family: var(--font-heading-family); font-size: calc(1.8rem + 1.5vw); font-weight: 600; line-height: 1.25; margin: 0 0 var(--space-16) 0;">
        {{ section.settings.heading | escape }}
      </h2>
      
      {%- if section.settings.subheading != blank -%}
        <p class="hero-banner-subheading" style="font-size: 0.95rem; font-family: var(--font-body-family); font-weight: 400; line-height: 1.6; color: #5a5450; margin: 0 0 var(--space-24) 0;">
          {{ section.settings.subheading | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--primary hero-banner-cta" style="background-color: var(--color-text); color: #fff; padding: 12px 32px; border-radius: var(--button-radius);">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}

    </div>
  </div>

</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pure & Organic"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Nourish your skin with clean ingredients sourced directly from nature."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Skincare"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_video",
      "label": "Enable background video",
      "default": false
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"]
    }
  ]
}
{% endschema %}
