{%- liquid
  assign ratio = 1
  assign featured_image = product.featured_image
  assign second_image = product.images[1]
-%}

<div class="product-card product-card--jewellery text-center">
  <div class="product-card-media-wrapper" style="position: relative; overflow: hidden; aspect-ratio: {{ ratio }};">
    
    <!-- Wishlist Trigger -->
    <button type="button" class="js-wishlist-toggle wishlist-toggle-btn" data-product-handle="{{ product.handle }}" aria-label="Add to wishlist" style="position: absolute; right: 10px; top: 10px; z-index: 10; background: none; border: none; cursor: pointer;">
      {% render 'icon-heart', filled: false %}
    </button>

    <a href="{{ product.url }}" class="product-card-image-link" style="display: block; width: 100%; height: 100%;">
      <img src="{{ featured_image | image_url: width: 480 }}" 
           alt="{{ featured_image.alt | escape }}" 
           class="product-card-image main-image" 
           loading="lazy" 
           style="width: 100%; height: 100%; object-fit: cover; transition: opacity var(--transition-normal);">
      
      {%- if second_image != blank and settings.product_card_swap_image_on_hover -%}
        <img src="{{ second_image | image_url: width: 480 }}" 
             alt="{{ second_image.alt | escape }}" 
             class="product-card-image hover-image" 
             loading="lazy" 
             style="width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; opacity: 0; transition: opacity var(--transition-normal);">
      {%- endif -%}
    </a>
  </div>

  <div class="product-card-info" style="padding: var(--space-12) 0;">
    {%- if settings.product_card_show_vendor -%}
      <div class="product-card-vendor" style="font-size: 0.8rem; text-transform: uppercase; color: var(--color-accent); margin-bottom: var(--space-4);">
        {{ product.vendor }}
      </div>
    {%- endif -%}
    
    <h3 class="product-card-title" style="font-size: 1.1rem; font-family: var(--font-heading-family); margin-bottom: var(--space-4);">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    {% render 'price', product: product, use_variant: false %}

    <div class="product-card-rating" style="margin-top: var(--space-8); display: flex; justify-content: center; gap: 2px;">
      {%- render 'icon-star', filled: true -%}
      {%- render 'icon-star', filled: true -%}
      {%- render 'icon-star', filled: true -%}
      {%- render 'icon-star', filled: true -%}
      {%- render 'icon-star', filled: false -%}
    </div>

    <div class="product-card-actions" style="margin-top: var(--space-12);">
      <button type="button" class="button button--secondary button--small product-card-quick-add" onclick="window.PubSub.publish('cart:add', { id: {{ product.selected_or_first_available_variant.id }} })">
        Quick Buy
      </button>
    </div>
  </div>
</div>
