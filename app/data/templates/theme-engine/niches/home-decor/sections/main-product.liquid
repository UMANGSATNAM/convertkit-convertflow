<section class="product-pdp product-pdp--home-decor container" style="padding: var(--space-64) 0; background-color: var(--color-background);" data-section="{{ section.id }}">
  <div class="grid grid-cols-1 grid-cols-md-2" style="--grid-spacing: var(--space-64); align-items: start;">
    
    <!-- Gallery -->
    <div class="product-gallery-container" style="display: flex; flex-direction: column; gap: var(--space-20); position: sticky; top: var(--space-24);">
      <div class="product-gallery-featured" style="border: 1px solid var(--color-border); border-radius: var(--card-radius); overflow: hidden; background-color: var(--color-surface);">
        <img id="FeaturedMedia-{{ section.id }}" 
             src="{{ product.featured_image | image_url: width: 1000 }}" 
             alt="{{ product.featured_image.alt | escape }}" 
             loading="eager"
             style="width: 100%; aspect-ratio: 1; object-fit: cover;">
      </div>

      {%- if product.images.size > 1 -%}
        <div class="product-gallery-thumbnails" style="display: flex; gap: var(--space-16); overflow-x: auto; padding-bottom: var(--space-8);">
          {%- for img in product.images -%}
            <button type="button" class="gallery-thumbnail-btn" 
                     onclick="document.getElementById('FeaturedMedia-{{ section.id }}').src = '{{ img | image_url: width: 1000 }}'"
                     style="flex: 0 0 80px; border: 1px solid var(--color-border); border-radius: 4px; padding: 4px; background-color: #fff; cursor: pointer; aspect-ratio: 1; overflow: hidden; display: flex; align-items: center; justify-content: center;">
              <img src="{{ img | image_url: width: 160 }}" alt="{{ img.alt | escape }}" style="max-height: 100%; max-width: 100%; object-fit: cover;">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Buying Info -->
    <div class="product-info-container {% if section.settings.enable_sticky_info %}sticky-info{% endif %}" style="display: flex; flex-direction: column; gap: var(--space-24);">
      
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <div class="product-info-title-vendor" {{ block.shopify_attributes }}>
              <div class="product-vendor" style="font-size: 0.8rem; letter-spacing: 0.1em; color: var(--color-accent); text-transform: uppercase; font-family: var(--font-body-family); font-weight: 700; margin-bottom: var(--space-8);">
                {{ product.vendor }}
              </div>
              <h1 class="product-title" style="font-family: var(--font-heading-family); font-size: 2.6rem; font-weight: 500; line-height: 1.25; margin: 0 0 var(--space-12) 0; color: var(--color-text);">
                {{ product.title }}
              </h1>
            </div>

          {%- when 'price' -%}
            <div id="price-{{ section.id }}" class="product-info-price" {{ block.shopify_attributes }}>
              {% render 'price', product: product, use_variant: false %}
            </div>

          {%- when 'variant_picker' -%}
            <div class="product-info-variants" {{ block.shopify_attributes }}>
              {%- unless product.has_only_default_variant -%}
                <variant-radios class="no-js-hidden" data-section="{{ section.id }}" data-url="{{ product.url }}">
                  {%- for option in product.options_with_values -%}
                    <fieldset class="product-form-option" style="margin-bottom: var(--space-20); border: none; padding: 0; margin: 0 0 var(--space-20) 0;">
                      <legend class="form-option-label" style="display: block; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-12); color: var(--color-text);">
                        {{ option.name }}
                      </legend>
                      <div style="display: flex; flex-wrap: wrap; gap: var(--space-12);">
                        {%- for value in option.values -%}
                          <label style="cursor: pointer;">
                            <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} class="visually-hidden">
                            <span class="variant-radio-btn" style="display: inline-block; padding: 10px 20px; border: 1px solid var(--color-border); border-radius: var(--button-radius); font-size: 0.85rem; font-family: var(--font-body-family); font-weight: 600; transition: background-color var(--transition-fast), border-color var(--transition-fast);">
                              {{ value }}
                            </span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  <script type="application/json">
                    {{ product.variants | json }}
                  </script>
                </variant-radios>
              {%- endunless -%}
            </div>

            <style>
              variant-radios input[type="radio"]:checked + .variant-radio-btn {
                background-color: var(--color-text);
                color: #fff;
                border-color: var(--color-text);
              }
            </style>

          {%- when 'quantity_selector' -%}
            <div class="product-info-quantity" {{ block.shopify_attributes }}>
              <label class="form-option-label" style="display: block; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-12); color: var(--color-text);">
                {{ 'products.product.quantity' | t }}
              </label>
              <div class="quantity-stepper">
                <button type="button" class="quantity-stepper-btn stepper-minus">{% render 'icon-minus' %}</button>
                <input type="number" name="quantity" value="1" min="1" class="quantity-stepper-input">
                <button type="button" class="quantity-stepper-btn stepper-plus">{% render 'icon-plus' %}</button>
              </div>
            </div>

          {%- when 'buy_buttons' -%}
            <div class="product-info-buy-buttons" {{ block.shopify_attributes }}>
              <form action="/cart/add" method="post" id="product-form-{{ section.id }}" class="product-form">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                
                <div class="product-form-ctas" style="display: flex; flex-direction: column; gap: var(--space-16); margin-top: var(--space-16);">
                  <button type="submit" name="add" class="product-form-main-submit button button--primary width-100" 
                          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
                          onclick="event.preventDefault(); window.PubSub.publish('cart:add', { id: this.form.id.value, quantity: this.form.quantity ? this.form.quantity.value : 1 })">
                    <span>
                      {%- if product.selected_or_first_available_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>
                  {{ form | payment_button }}
                </div>
              </form>
            </div>

          {%- when 'trust_badges' -%}
            <div class="product-info-trust-badges" {{ block.shopify_attributes }} 
                 style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: var(--space-20) 0; margin-top: var(--space-16); display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; gap: var(--space-12);">
              <div class="trust-badge-item">
                <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" width="28" height="28" style="color: var(--color-sale-accent); margin: 0 auto var(--space-8) auto; display: block;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span style="font-size: 0.75rem; text-transform: uppercase; font-family: var(--font-body-family); font-weight: 700; letter-spacing: 0.05em; color: var(--color-text);">Sustainably Made</span>
              </div>
              <div class="trust-badge-item">
                <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" width="28" height="28" style="color: var(--color-sale-accent); margin: 0 auto var(--space-8) auto; display: block;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                </svg>
                <span style="font-size: 0.75rem; text-transform: uppercase; font-family: var(--font-body-family); font-weight: 700; letter-spacing: 0.05em; color: var(--color-text);">Lifetime Guarantee</span>
              </div>
              <div class="trust-badge-item">
                <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" width="28" height="28" style="color: var(--color-sale-accent); margin: 0 auto var(--space-8) auto; display: block;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                </svg>
                <span style="font-size: 0.75rem; text-transform: uppercase; font-family: var(--font-body-family); font-weight: 700; letter-spacing: 0.05em; color: var(--color-text);">Natural Finishes</span>
              </div>
            </div>

          {%- when 'description' -%}
            <div class="product-info-accordions theme-accordion" data-single-expand="true" {{ block.shopify_attributes }} style="margin-top: var(--space-20);">
              <div class="accordion-item" style="border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-16); margin-bottom: var(--space-16);">
                <button type="button" class="accordion-trigger" aria-expanded="true" 
                        style="width: 100%; display: flex; justify-content: space-between; align-items: center; border: none; background: none; text-align: left; padding: var(--space-12) 0; font-family: var(--font-heading-family); font-size: 1.15rem; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">
                  <span>Product Editorial & Dimensions</span>
                  {% render 'icon-chevron' %}
                </button>
                <div class="accordion-content accordion-content--open rte" style="font-family: var(--font-body-family); font-size: 0.9rem; line-height: 1.7; color: var(--color-text); opacity: 0.85; padding-top: var(--space-12);">
                  {{ product.description }}
                </div>
              </div>
            </div>

        {%- endcase -%}
      {%- endfor -%}

    </div>

  </div>
</section>

<!-- Sticky Add to Cart -->
<div class="sticky-atc-bar hide-mobile" aria-hidden="true" style="position: fixed; bottom: 0; left: 0; width: 100%; background-color: var(--color-background); border-top: 1px solid var(--color-border); padding: var(--space-16) 0; z-index: var(--z-header); transform: translateY(100%); transition: transform var(--transition-normal);">
  <div class="container" style="display: flex; align-items: center; justify-content: space-between;">
    <div style="display: flex; align-items: center; gap: var(--space-20);">
      <img src="{{ product.featured_image | image_url: width: 100 }}" alt="{{ product.title }}" style="width: 56px; height: 56px; object-fit: cover; border-radius: 4px; border: 1px solid var(--color-border);">
      <div>
        <h4 style="font-family: var(--font-heading-family); font-size: 1.05rem; font-weight: 600; margin: 0 0 var(--space-4) 0; color: var(--color-text);">{{ product.title }}</h4>
        {% render 'price', product: product, use_variant: false %}
      </div>
    </div>
    <div style="display: flex; align-items: center; gap: var(--space-20);">
      {%- unless product.has_only_default_variant -%}
        <select class="sticky-atc-variant-select" style="padding: 10px 20px; border: 1px solid var(--color-border); background-color: var(--color-surface); font-family: var(--font-body-family); font-size: 0.85rem; border-radius: var(--button-radius); outline: none;">
          {%- for variant in product.variants -%}
            <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected="selected"{% endif %}>
              {{ variant.title }}
            </option>
          {%- endfor -%}
        </select>
      {%- endunless -%}
      <button type="button" class="sticky-atc-submit button button--primary button--small" style="font-size: 0.85rem; padding: 10px 24px; border-radius: var(--button-radius);">Add to Cart</button>
    </div>
  </div>
</div>

<style>
  .sticky-atc-bar--visible {
    transform: translateY(0) !important;
  }
</style>

{% schema %}
{
  "name": "Product Details",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "Enable sticky info column",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Enable image zoom modal",
      "default": true
    }
  ],
  "blocks": [
    { "type": "title", "name": "Product Title", "limit": 1 },
    { "type": "price", "name": "Product Price", "limit": 1 },
    { "type": "variant_picker", "name": "Variant Selector", "limit": 1 },
    { "type": "quantity_selector", "name": "Quantity Selector", "limit": 1 },
    { "type": "buy_buttons", "name": "Buy Button triggers", "limit": 1 },
    { "type": "description", "name": "Description Accordion", "limit": 1 },
    { "type": "trust_badges", "name": "Trust Badges Matrix", "limit": 1 }
  ]
}
{% endschema %}
