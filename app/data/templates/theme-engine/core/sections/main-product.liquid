{%- comment -%}
  Section: main-product
  Universal Premium Product Page (Glow Framework)
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
  assign save_pct = 0
  if on_sale
    assign diff = product.compare_at_price | minus: product.price
    assign save_pct = diff | times: 100 | divided_by: product.compare_at_price
  endif
-%}

<div class="pdp-universal" id="pdp-{{ section.id }}">
  {%- if product == empty -%}
    <div class="pdp-wrap pdp-placeholder"><p>Assign to a product template.</p></div>
  {%- else -%}

  <div class="pdp-wrap">
    <!-- Breadcrumbs -->
    <nav class="crumb">
      <a href="{{ routes.root_url }}">Home</a> &nbsp;/&nbsp;
      {%- if product.collections.size > 0 -%}<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>&nbsp;/&nbsp;{%- endif -%}
      {{ product.title }}
    </nav>

    <div class="product">
      <!-- GALLERY: Smooth, responsive, hover zoom -->
      <div class="gallery">
        <div class="gallery-main">
          {%- if on_sale -%}<div class="b-badge">-{{ save_pct }}% OFF</div>{%- endif -%}
          {%- if product.featured_media -%}
            <img id="pdpMain-{{ section.id }}" src="{{ product.featured_media | image_url: width: 900 }}" alt="{{ product.featured_media.alt | escape }}" width="900" height="900" loading="eager">
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="thumbs" id="pdpThumbs-{{ section.id }}">
            {%- for media in product.media limit: 6 -%}
              <button type="button" class="thumb{% if forloop.first %} active{% endif %}" data-src="{{ media | image_url: width: 900 }}">
                <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | escape }}" loading="lazy" width="200" height="200">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- BUY BOX -->
      <div class="buybox">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'title' -%}
              <div class="p-title-block" {{ block.shopify_attributes }}>
                {%- if product.vendor != blank -%}<span class="eyebrow">{{ product.vendor }}</span>{%- endif -%}
                <h1 class="ptitle">{{ product.title }}</h1>
                
                <div class="rating-visitor-row">
                  {% render 'pdp-reviews-rating' %}
                  <div class="visitor-counter">
                    <span class="vc-dot"></span>
                    <span><span id="pdpVcNum-{{ section.id }}">36</span> views in last 10m</span>
                  </div>
                </div>
              </div>

            {%- when 'price' -%}
              <div class="p-price-block" {{ block.shopify_attributes }}>
                <div class="pricerow">
                  <span class="price-now" id="pdpPrice-{{ section.id }}">{{ current_variant.price | money }}</span>
                  {%- if on_sale -%}
                    <span class="price-mrp" id="pdpMrp-{{ section.id }}">{{ current_variant.compare_at_price | money }}</span>
                    <span class="price-save">Save {{ save_pct }}%</span>
                  {%- endif -%}
                </div>
                <p class="tax-note">Inclusive of all taxes & Free Insured Shipping</p>
              </div>

            {%- when 'variant_picker' -%}
              <div class="p-variants-block" {{ block.shopify_attributes }}>
                {% render 'pdp-variant-selector', product: product, current_variant: current_variant %}
              </div>

            {%- when 'quantity_selector' -%}
              <div class="p-qty-block" {{ block.shopify_attributes }}>
                {% render 'pdp-quantity-selector' %}
              </div>

            {%- when 'buy_buttons' -%}
              <div class="p-buy-block" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: 'pdpForm-' | append: section.id, class: 'pdp-form' -%}
                  <input type="hidden" name="id" id="pdpVarId-{{ section.id }}" value="{{ current_variant.id }}">
                  <div class="buy-actions">
                    <button type="submit" name="add" class="btn btn-add"{% unless current_variant.available %} disabled{% endunless %}>
                      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                      <span>{% if current_variant.available %}Add to Bag{% else %}Sold Out{% endif %}</span>
                    </button>
                  </div>
                  {%- if section.settings.enable_dynamic_checkout -%}
                    <div class="pdp-dcb">{{ form | payment_button }}</div>
                  {%- endif -%}
                {%- endform -%}

                {% render 'pdp-urgency-components' %}
                {% render 'pdp-delivery-checker' %}
              </div>

            {%- when 'trust_badges' -%}
              <div class="p-trust-block" {{ block.shopify_attributes }}>
                {% render 'pdp-trust-badges' %}
              </div>

            {%- when 'description' -%}
              <div class="p-desc-block" {{ block.shopify_attributes }}>
                {% render 'pdp-faq-accordion', product: product %}
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {% render 'pdp-sticky-cart', product: product, current_variant: current_variant %}

  {%- endif -%}
</div>

{% stylesheet %}
.pdp-universal {
  background: var(--color-background);
  color: var(--color-text);
  font-family: var(--font-body-family), sans-serif;
  line-height: 1.6;
}
.pdp-universal img { max-width: 100%; display: block; }
.pdp-universal a { color: inherit; text-decoration: none; }
.pdp-universal button { font-family: inherit; cursor: pointer; }
.pdp-wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
.pdp-placeholder { padding: 60px 20px; text-align: center; color: #888; }

.pdp-universal .crumb { font-size: 11px; color: #888; padding: 20px 0; text-transform: uppercase; letter-spacing: 0.05em; }
.pdp-universal .product { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; padding-bottom: 60px; align-items: start; }
@media(max-width: 900px) { .pdp-universal .product { grid-template-columns: 1fr; gap: 30px; } }

.pdp-universal .gallery { position: sticky; top: 90px; }
@media(max-width: 900px) { .pdp-universal .gallery { position: static; } }
.pdp-universal .gallery-main { position: relative; aspect-ratio: 1; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--card-radius); background: var(--color-surface); }
.pdp-universal .gallery-main img { width: 100%; height: 100%; object-fit: cover; }
.pdp-universal .b-badge { position: absolute; top: 12px; left: 12px; background: var(--color-accent); color: #fff; font-size: 11px; font-weight: bold; padding: 4px 8px; border-radius: 4px; z-index: 2; }
.pdp-universal .thumbs { display: flex; gap: 10px; margin-top: 12px; overflow-x: auto; }
.pdp-universal .thumb { flex: 0 0 70px; aspect-ratio: 1; overflow: hidden; border: 1px solid var(--color-border); border-radius: 4px; background: #fff; opacity: 0.6; padding: 0; }
.pdp-universal .thumb.active { border-color: var(--color-accent); opacity: 1; }
.pdp-universal .thumb img { width: 100%; height: 100%; object-fit: cover; }

.pdp-universal .eyebrow { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); display: block; margin-bottom: 8px; }
.pdp-universal .ptitle { font-size: 32px; line-height: 1.25; font-weight: 700; margin: 0 0 12px 0; font-family: var(--font-heading-family); }
@media(max-width: 520px) { .pdp-universal .ptitle { font-size: 26px; } }

.pdp-universal .rating-visitor-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; border-bottom: 1px solid var(--color-border); padding-bottom: 16px; }
.pdp-universal .rating { display: flex; align-items: center; gap: 6px; font-size: 13px; }
.pdp-universal .stars { color: #F59E0B; letter-spacing: 1px; }
.pdp-universal .visitor-counter { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #666; font-style: italic; }
.pdp-universal .vc-dot { width: 6px; height: 6px; border-radius: 50%; background: #10B981; animation: pdpPulse 2s infinite; }
@keyframes pdpPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

.pdp-universal .pricerow { display: flex; align-items: center; gap: 12px; }
.pdp-universal .price-now { font-size: 26px; font-weight: 700; color: var(--color-text); }
.pdp-universal .price-mrp { font-size: 18px; color: #888; text-decoration: line-through; }
.pdp-universal .price-save { font-size: 12px; background: #FFF5F5; color: var(--color-accent); font-weight: 700; padding: 2px 8px; border-radius: 4px; border: 1px dashed var(--color-accent); }
.pdp-universal .tax-note { font-size: 11px; color: #777; margin: 4px 0 20px 0; }

.pdp-universal .opt-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 8px; color: var(--color-text); }
.pdp-universal .variants { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
.pdp-universal .variant { border: 1px solid var(--color-border); background: #fff; padding: 8px 16px; border-radius: 20px; font-size: 13px; font-weight: 500; transition: 0.15s; display: inline-block; cursor: pointer; }
.pdp-universal .v-radio:checked + .variant { border-color: var(--color-text); background: var(--color-text); color: #fff; }
.pdp-universal .v-radio:disabled + .variant { opacity: 0.4; text-decoration: line-through; }

.pdp-universal .qty-stepper { display: flex; align-items: center; border: 1px solid var(--color-border); border-radius: 4px; width: fit-content; overflow: hidden; margin-bottom: 24px; height: 38px; }
.pdp-universal .qty-stepper button { width: 34px; height: 100%; border: none; background: transparent; font-size: 16px; transition: background 0.2s; }
.pdp-universal .qty-stepper button:hover { background: var(--color-surface); }
.pdp-universal .qty-stepper input { width: 34px; text-align: center; border: none; font-size: 14px; font-weight: bold; background: transparent; pointer-events: none; }

.pdp-universal .buy-actions { margin-top: 10px; }
.pdp-universal .btn { font-weight: 700; font-size: 13px; letter-spacing: 0.05em; text-transform: uppercase; height: 48px; border-radius: 4px; display: flex; align-items: center; justify-content: center; gap: 8px; transition: opacity 0.2s; border: none; width: 100%; }
.pdp-universal .btn-add { background: var(--color-text); color: #fff; }
.pdp-universal .btn-add:hover { opacity: 0.9; }
.pdp-universal .btn-add[disabled] { opacity: 0.5; cursor: not-allowed; }
.pdp-universal .pdp-dcb { margin-top: 8px; }

.pdp-universal .stock-progress-container { margin-top: 20px; background: #FFF9F9; padding: 12px; border-radius: 6px; border: 1px solid #FFEBEB; }
.pdp-universal .stock-header { display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-weight: 700; color: var(--color-accent); margin-bottom: 6px; }
.pdp-universal .stock-alert-pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); animation: alertPulse 1.2s infinite; }
@keyframes alertPulse { 0% { transform: scale(0.9); opacity: 1; } 50% { transform: scale(1.3); opacity: 0.5; } 100% { transform: scale(0.9); opacity: 1; } }
.pdp-universal .stock-bar-outer { height: 6px; background: #E5E7EB; border-radius: 3px; overflow: hidden; }
.pdp-universal .stock-bar-inner { height: 100%; background: var(--color-accent); border-radius: 3px; }

.pdp-universal .delivery-promise { font-size: 12px; color: #555; margin-top: 12px; border-top: 1px dashed var(--color-border); padding-top: 12px; }

.pdp-universal .trust-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 24px; padding: 12px 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
.pdp-universal .trust-item { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; font-size: 10px; color: #666; font-weight: 700; }
.pdp-universal .trust-item svg { width: 20px; height: 20px; color: var(--color-accent); }

.pdp-universal .acc { margin-top: 20px; border-top: 1px solid var(--color-border); }
.pdp-universal .acc-item { border-bottom: 1px solid var(--color-border); }
.pdp-universal .acc-q { width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 14px 0; font-size: 13px; font-weight: 700; text-transform: uppercase; color: var(--color-text); background: none; border: none; text-align: left; }
.pdp-universal .acc-q .ico { font-size: 16px; color: #888; transition: transform 0.2s; }
.pdp-universal .acc-item.open .ico { transform: rotate(45deg); }
.pdp-universal .acc-a { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
.pdp-universal .acc-item.open .acc-a { max-height: 500px; }
.pdp-universal .acc-rt { font-size: 13px; color: #555; padding-bottom: 14px; line-height: 1.6; }

.pdp-universal .sticky-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 80; background: var(--color-background); border-top: 1px solid var(--color-border); padding: 12px 20px; display: flex; align-items: center; gap: 14px; transform: translateY(120%); transition: transform 0.3s ease; }
.pdp-universal .sticky-bar.show { transform: translateY(0); }
.pdp-universal .sb-info .nm { font-size: 13px; color: var(--color-text); font-weight: bold; line-height: 1.2; }
.pdp-universal .sb-info .pr b { font-size: 14px; color: var(--color-accent); }
.pdp-universal .sticky-bar .btn { flex: 1; height: 40px; background: var(--color-text); color: #fff; width: auto; font-size: 12px; }
@media(min-width: 921px) { .pdp-universal .sticky-bar { display: none; } }
@media(prefers-reduced-motion:reduce) { .pdp-universal *, .pdp-universal *::before, .pdp-universal *::after { animation: none!important; transition: none!important; } }
{% endstylesheet %}

<script>
(function(){
  var root = document.getElementById('pdp-{{ section.id }}'); if(!root) return;
  var mainImg = document.getElementById('pdpMain-{{ section.id }}');
  var thumbs = document.getElementById('pdpThumbs-{{ section.id }}');
  if(thumbs && mainImg){
    thumbs.addEventListener('click', function(e){
      var t = e.target.closest('.thumb'); if(!t) return;
      thumbs.querySelectorAll('.thumb').forEach(function(x){ x.classList.remove('active'); });
      t.classList.add('active'); mainImg.src = t.dataset.src;
    });
  }

  var varId = document.getElementById('pdpVarId-{{ section.id }}');
  var priceNow = document.getElementById('pdpPrice-{{ section.id }}');
  var priceMrp = document.getElementById('pdpMrp-{{ section.id }}');
  var sbPrice = document.getElementById('pdpSbPrice-{{ section.id }}');
  root.querySelectorAll('.v-radio').forEach(function(r){
    r.addEventListener('change', function(){
      if(varId) varId.value = r.value;
      if(priceNow && r.dataset.price) priceNow.textContent = r.dataset.price;
      if(sbPrice && r.dataset.price) sbPrice.textContent = r.dataset.price;
      if(priceMrp){
        if(r.dataset.mrp){
          priceMrp.textContent = r.dataset.mrp;
          priceMrp.style.display = '';
        } else {
          priceMrp.style.display = 'none';
        }
      }
    });
  });

  var qtyInput = root.querySelector('.qinput');
  var qMinus = root.querySelector('.qminus');
  var qPlus = root.querySelector('.qplus');
  if(qtyInput && qMinus && qPlus){
    qMinus.addEventListener('click', function(){
      var val = parseInt(qtyInput.value, 10) || 1;
      if(val > 1) qtyInput.value = val - 1;
    });
    qPlus.addEventListener('click', function(){
      var val = parseInt(qtyInput.value, 10) || 1;
      if(val < 10) qtyInput.value = val + 1;
    });
  }

  var acc = root.querySelector('.acc');
  if(acc){
    acc.addEventListener('click', function(e){
      var q = e.target.closest('.acc-q'); if(!q) return;
      var item = q.parentElement; var a = item.querySelector('.acc-a'); var open = item.classList.contains('open');
      acc.querySelectorAll('.acc-item').forEach(function(i){
        i.classList.remove('open');
        i.querySelector('.acc-a').style.maxHeight = null;
      });
      if(!open){
        item.classList.add('open');
        a.style.maxHeight = a.scrollHeight + 'px';
      }
    });
    var fo = acc.querySelector('.acc-item.open .acc-a'); if(fo) fo.style.maxHeight = fo.scrollHeight + 'px';
  }

  var cds = root.querySelectorAll('.pdp-cd');
  if(cds.length){
    function tick(){
      var now = new Date(), end = new Date(); end.setHours(23, 59, 59, 999);
      var diff = Math.max(0, end - now);
      var h = String(Math.floor(diff / 3.6e6)).padStart(2, '0');
      var m = String(Math.floor(diff % 3.6e6 / 6e4)).padStart(2, '0');
      var s = String(Math.floor(diff % 6e4 / 1e3)).padStart(2, '0');
      cds.forEach(function(el){ el.innerHTML = '<b>' + h + 'h ' + m + 'm ' + s + 's</b>'; });
    } tick(); setInterval(tick, 1000);
  }

  /* Visitor counter */
  var vcNum = document.getElementById('pdpVcNum-{{ section.id }}');
  if(vcNum){
    var base = Math.floor(Math.random() * (45 - 18 + 1)) + 18;
    vcNum.textContent = base;
    setInterval(function(){
      var delta = (Math.random() < .5 ? 1 : -1) * (Math.floor(Math.random() * 3) + 1);
      base = Math.max(12, Math.min(85, base + delta));
      vcNum.textContent = base;
    }, 5000);
  }

  /* Stock counter */
  var stockNum = document.getElementById('pdpStockNum-{{ section.id }}');
  var stockBar = root.querySelector('.stock-bar-inner');
  if(stockNum && stockBar){
    var baseStock = Math.floor(Math.random() * (9 - 4 + 1)) + 4;
    stockNum.textContent = baseStock;
    stockBar.style.width = (baseStock * 10) + '%';
    setInterval(function(){
      if(baseStock > 2 && Math.random() < 0.15) {
        baseStock--;
        stockNum.textContent = baseStock;
        stockBar.style.width = (baseStock * 10) + '%';
      }
    }, 12000);
  }

  var sticky = document.getElementById('pdpSticky-{{ section.id }}');
  var trigger = root.querySelector('.buy-actions');
  if(sticky && trigger && 'IntersectionObserver' in window){
    new IntersectionObserver(function(entries){
      var e = entries[0];
      if(e.isIntersecting) sticky.classList.remove('show');
      else if(e.boundingClientRect.top < 0) sticky.classList.add('show');
    }, {threshold: 0}).observe(trigger);
  }

  var sAdd = root.querySelector('.pdp-sticky-add');
  var addBtn = root.querySelector('.btn-add');
  if(sAdd && addBtn) sAdd.onclick = function(){ addBtn.click(); };
})();
</script>

{% schema %}
{
  "name": "Product - Universal",
  "tag": "section",
  "class": "pdp-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_dynamic_checkout",
      "label": "Enable Dynamic Checkout",
      "default": true
    }
  ],
  "blocks": [
    { "type": "title", "name": "Product Title", "limit": 1 },
    { "type": "price", "name": "Product Price", "limit": 1 },
    { "type": "variant_picker", "name": "Variant Selector", "limit": 1 },
    { "type": "quantity_selector", "name": "Quantity Selector", "limit": 1 },
    { "type": "buy_buttons", "name": "Buy Buttons", "limit": 1 },
    { "type": "trust_badges", "name": "Trust Badges", "limit": 1 },
    { "type": "description", "name": "Description Tab", "limit": 1 }
  ],
  "presets": [
    {
      "name": "Product — Universal Premium"
    }
  ]
}
{% endschema %}
