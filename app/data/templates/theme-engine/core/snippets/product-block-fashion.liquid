{%- comment -%}
  Fashion intelligence block. Added conditionally by the Engine.
{%- endcomment -%}
<div class="sf-product-block sf-fashion-block py-6 border-t border-[var(--color-border)]" style="content-visibility: auto;">
  <div class="grid grid-cols-2 gap-4">
    <div class="bg-[var(--color-surface)] p-4 rounded-[var(--radius-card)] text-center">
      <svg class="w-6 h-6 mx-auto mb-2 text-[var(--color-text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
      <span class="block text-sm font-medium text-[var(--color-text)]">True to Size</span>
    </div>
    <div class="bg-[var(--color-surface)] p-4 rounded-[var(--radius-card)] text-center">
      <svg class="w-6 h-6 mx-auto mb-2 text-[var(--color-text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
      <span class="block text-sm font-medium text-[var(--color-text)]">Premium Fabric</span>
    </div>
  </div>
  <button type="button" class="mt-4 text-sm underline text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] w-full text-center">
    View Size Guide
  </button>
</div>
