<style>
  .gs-pgallery {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  @media (min-width: 768px) {
    .gs-pgallery {
      gap: 20px;
    }
  }
  .gs-pgallery__item {
    width: 100%;
    background-color: #f4f4f4;
  }
  .gs-pgallery__img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>

<div class="gs-pgallery">
  {% for media in product.media %}
    <div class="gs-pgallery__item">
      {% case media.media_type %}
        {% when 'image' %}
          <img class="gs-pgallery__img" src="{{ media | image_url: width: 1200 }}" alt="{{ media.alt | escape }}">
        {% when 'video' %}
          {{ media | video_tag: controls: true, class: 'gs-pgallery__img' }}
      {% endcase %}
    </div>
  {% else %}
    <div class="gs-pgallery__item" style="padding: 100px; text-align: center;">No Images</div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "GS Product Gallery",
  "tag": "section",
  "settings": [],
  "templates": ["product"],
  "presets": [
    {
      "name": "GS Product Gallery"
    }
  ]
}
{% endschema %}
