<style>
  .gs-featured { padding: 100px 0; background: #111; border-top: 1px solid #222; }
  .gs-featured__container { max-width: 1400px; margin: 0 auto; padding: 0 40px; }
  .gs-featured__header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 60px; }
  .gs-featured__title { font-family: 'Oswald', sans-serif; font-size: 40px; font-weight: 700; color: #fff; text-transform: uppercase; margin: 0; }
  .gs-featured__link { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 600; color: {{ section.settings.accent_color }}; text-decoration: none; text-transform: uppercase; letter-spacing: 2px; display: flex; align-items: center; gap: 8px; }
  .gs-featured__link:hover { color: #fff; }
  .gs-featured__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; }
  @media (max-width: 1024px) { .gs-featured__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .gs-featured__grid { grid-template-columns: 1fr; } }
  .gs-prod-card { background: #1a1a1a; display: flex; flex-direction: column; text-decoration: none; transition: transform 0.3s; border: 1px solid #333; position: relative; }
  .gs-prod-card:hover { transform: translateY(-5px); border-color: {{ section.settings.accent_color }}; }
  .gs-prod-card__img-wrapper { aspect-ratio: 1; overflow: hidden; background: #0a0a0a; position: relative; padding: 20px; }
  .gs-prod-card__img { width: 100%; height: 100%; object-fit: contain; transition: transform 0.5s; filter: drop-shadow(0 10px 15px rgba(0,0,0,0.5)); }
  .gs-prod-card:hover .gs-prod-card__img { transform: scale(1.05); }
  .gs-prod-card__badge { position: absolute; top: 15px; left: 15px; background: {{ section.settings.accent_color }}; color: #000; font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; padding: 4px 10px; text-transform: uppercase; letter-spacing: 1px; z-index: 2; }
  .gs-prod-card__info { padding: 25px; display: flex; flex-direction: column; flex: 1; }
  .gs-prod-card__vendor { font-family: 'Inter', sans-serif; font-size: 12px; color: #718096; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 8px; font-weight: 500; }
  .gs-prod-card__name { font-family: 'Oswald', sans-serif; font-size: 20px; font-weight: 500; color: #fff; margin-bottom: 15px; text-transform: uppercase; line-height: 1.3; }
  .gs-prod-card__bottom { display: flex; justify-content: space-between; align-items: center; margin-top: auto; }
  .gs-prod-card__price { font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 400; color: #fff; }
  .gs-prod-card__add { background: transparent; border: 1px solid #444; color: #fff; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s; }
  .gs-prod-card:hover .gs-prod-card__add { background: {{ section.settings.accent_color }}; border-color: {{ section.settings.accent_color }}; color: #000; }
</style>
<section class="gs-featured">
  <div class="gs-featured__container">
    <div class="gs-featured__header">
      <h2 class="gs-featured__title">{{ section.settings.title }}</h2>
      <a href="/collections/all" class="gs-featured__link">Explore All →</a>
    </div>
    <div class="gs-featured__grid">
      {% assign col = collections[section.settings.collection] %}
      {% for product in col.products limit: section.settings.limit %}
        <a href="{{ product.url }}" class="gs-prod-card">
          <div class="gs-prod-card__img-wrapper">
            {% if product.compare_at_price > product.price %}<div class="gs-prod-card__badge">Sale</div>{% endif %}
            {% if product.featured_image %}<img class="gs-prod-card__img" src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">{% endif %}
          </div>
          <div class="gs-prod-card__info">
            <div class="gs-prod-card__vendor">{{ product.vendor }}</div>
            <h3 class="gs-prod-card__name">{{ product.title }}</h3>
            <div class="gs-prod-card__bottom">
              <div class="gs-prod-card__price">{{ product.price | money }}</div>
              <div class="gs-prod-card__add"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></div>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "GS Featured Products", "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Top Tier Tools" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 12, "step": 4, "default": 4 },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [{ "name": "GS Featured Products" }]
}
{% endschema %}
