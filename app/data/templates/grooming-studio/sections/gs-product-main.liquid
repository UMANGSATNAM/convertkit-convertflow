<style>
  .gs-prod-main { padding: 40px 0; background: #111; }
  .gs-prod-main__container { max-width: 1400px; margin: 0 auto; padding: 0 40px; display: flex; flex-direction: column; gap: 15px; }
  .gs-prod-main__img-wrap { width: 100%; aspect-ratio: 1; background: #0a0a0a; border: 1px solid #222; overflow: hidden; position: relative; }
  .gs-prod-main__img-wrap img { width: 100%; height: 100%; object-fit: contain; }
  .gs-prod-main__thumbs { display: flex; gap: 15px; overflow-x: auto; padding-bottom: 10px; }
  .gs-prod-main__thumbs::-webkit-scrollbar { height: 4px; }
  .gs-prod-main__thumbs::-webkit-scrollbar-thumb { background: #333; }
  .gs-prod-main__thumb { width: 100px; height: 100px; flex-shrink: 0; background: #0a0a0a; cursor: pointer; border: 1px solid #333; transition: border-color 0.3s; opacity: 0.6; }
  .gs-prod-main__thumb:hover, .gs-prod-main__thumb.active { border-color: #d4af37; opacity: 1; }
  .gs-prod-main__thumb img { width: 100%; height: 100%; object-fit: contain; }
</style>
<section class="gs-prod-main">
  <div class="gs-prod-main__container">
    <div class="gs-prod-main__img-wrap">
      <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" id="gs-main-img">
    </div>
    <div class="gs-prod-main__thumbs">
      {% for image in product.images %}
        <div class="gs-prod-main__thumb {% if forloop.first %}active{% endif %}" onclick="document.getElementById('gs-main-img').src='{{ image | image_url: width: 1200 }}'; document.querySelectorAll('.gs-prod-main__thumb').forEach(t=>t.classList.remove('active')); this.classList.add('active');"><img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | escape }}" loading="lazy"></div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{ "name": "GS Product Main", "tag": "section", "settings": [], "presets": [{ "name": "GS Product Main" }] }
{% endschema %}
