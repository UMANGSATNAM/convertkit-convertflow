<style>
  .gs-sidebar { padding: 60px 40px 60px 0; border-right: 1px solid #222; }
  .gs-sidebar__group { margin-bottom: 40px; }
  .gs-sidebar__title { font-family: 'Oswald', sans-serif; font-size: 18px; font-weight: 500; color: #fff; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 1px; }
  .gs-sidebar__list { list-style: none; padding: 0; margin: 0; }
  .gs-sidebar__item { margin-bottom: 12px; }
  .gs-sidebar__label { display: flex; align-items: center; gap: 12px; font-family: 'Inter', sans-serif; font-size: 14px; color: #a0aec0; cursor: pointer; transition: color 0.3s; text-transform: uppercase; letter-spacing: 1px; }
  .gs-sidebar__label:hover { color: #d4af37; }
  .gs-sidebar__checkbox { appearance: none; width: 16px; height: 16px; border: 1px solid #444; outline: none; cursor: pointer; transition: all 0.2s; position: relative; background: #111; }
  .gs-sidebar__checkbox:checked { background: #d4af37; border-color: #d4af37; }
  .gs-sidebar__checkbox:checked::after { content: ''; position: absolute; top: 1px; left: 4px; width: 4px; height: 8px; border: solid #000; border-width: 0 2px 2px 0; transform: rotate(45deg); }
</style>
<aside class="gs-sidebar">
  <div class="gs-sidebar__group">
    <div class="gs-sidebar__title">Categories</div>
    <ul class="gs-sidebar__list">
      <li class="gs-sidebar__item"><label class="gs-sidebar__label"><input type="checkbox" class="gs-sidebar__checkbox"> Beard Care</label></li>
      <li class="gs-sidebar__item"><label class="gs-sidebar__label"><input type="checkbox" class="gs-sidebar__checkbox"> Hair Styling</label></li>
      <li class="gs-sidebar__item"><label class="gs-sidebar__label"><input type="checkbox" class="gs-sidebar__checkbox"> Skincare</label></li>
      <li class="gs-sidebar__item"><label class="gs-sidebar__label"><input type="checkbox" class="gs-sidebar__checkbox"> Tools</label></li>
    </ul>
  </div>
  <div class="gs-sidebar__group">
    <div class="gs-sidebar__title">Hair Type</div>
    <ul class="gs-sidebar__list">
      <li class="gs-sidebar__item"><label class="gs-sidebar__label"><input type="checkbox" class="gs-sidebar__checkbox"> Straight</label></li>
      <li class="gs-sidebar__item"><label class="gs-sidebar__label"><input type="checkbox" class="gs-sidebar__checkbox"> Wavy</label></li>
      <li class="gs-sidebar__item"><label class="gs-sidebar__label"><input type="checkbox" class="gs-sidebar__checkbox"> Curly</label></li>
    </ul>
  </div>
</aside>
{% schema %}
{ "name": "GS Filter Sidebar", "tag": "section", "settings": [], "presets": [{ "name": "GS Filter Sidebar" }] }
{% endschema %}
