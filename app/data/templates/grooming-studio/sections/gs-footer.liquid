<style>
  .gs-footer {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 60px 5%;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }
  .gs-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .gs-footer__inner {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .gs-footer__heading {
    font-family: 'Georgia', serif;
    font-size: 16px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 20px;
  }
  .gs-footer__text {
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .gs-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .gs-footer__links li {
    margin-bottom: 10px;
  }
  .gs-footer__links a {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    font-size: 14px;
    transition: opacity 0.3s;
  }
  .gs-footer__links a:hover {
    opacity: 0.7;
  }
  .gs-footer__bottom {
    margin-top: 60px;
    padding-top: 20px;
    border-top: 1px solid rgba(0,0,0,0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
  }
  @media (min-width: 768px) {
    .gs-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>

<footer class="gs-footer">
  <div class="gs-footer__inner">
    {% for block in section.blocks %}
      <div class="gs-footer__column">
        {% if block.settings.heading != blank %}
          <div class="gs-footer__heading">{{ block.settings.heading }}</div>
        {% endif %}
        
        {% case block.type %}
          {% when 'text' %}
            <div class="gs-footer__text">{{ block.settings.text }}</div>
          
          {% when 'link_list' %}
            <ul class="gs-footer__links">
              {% for link in linklists[block.settings.menu].links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
        {% endcase %}
      </div>
    {% endfor %}
  </div>

  <div class="gs-footer__bottom">
    <div class="gs-footer__copyright">
      &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "GS Footer",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About Us"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Share store details, promotions, or brand content with your customers."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GS Footer",
      "blocks": [
        { "type": "link_list" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
