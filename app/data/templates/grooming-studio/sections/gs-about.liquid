<style>
  .gs-about { padding: 120px 0; background: #0a0a0a; color: #fff; }
  .gs-about__container { max-width: 1200px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
  @media (max-width: 900px) { .gs-about__container { grid-template-columns: 1fr; gap: 50px; } }
  .gs-about__img-wrap { position: relative; }
  .gs-about__img-wrap::before { content: ''; position: absolute; top: -20px; left: -20px; width: 100%; height: 100%; border: 1px solid #333; z-index: 0; }
  .gs-about__img { width: 100%; height: auto; position: relative; z-index: 1; filter: grayscale(100%); transition: filter 0.5s; }
  .gs-about__img-wrap:hover .gs-about__img { filter: grayscale(0%); }
  .gs-about__eyebrow { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 3px; color: {{ section.settings.accent_color }}; margin-bottom: 20px; display: block; }
  .gs-about__title { font-family: 'Oswald', sans-serif; font-size: 48px; font-weight: 700; color: #fff; text-transform: uppercase; margin-bottom: 30px; line-height: 1.1; }
  .gs-about__text { font-family: 'Inter', sans-serif; font-size: 16px; color: #a0aec0; line-height: 1.7; margin-bottom: 40px; font-weight: 300; }
  .gs-about__stats { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; border-top: 1px solid #222; padding-top: 40px; }
  .gs-about__stat-num { font-family: 'Oswald', sans-serif; font-size: 36px; font-weight: 700; color: {{ section.settings.accent_color }}; margin-bottom: 5px; }
  .gs-about__stat-label { font-family: 'Inter', sans-serif; font-size: 13px; color: #718096; text-transform: uppercase; letter-spacing: 1px; }
</style>
<section class="gs-about">
  <div class="gs-about__container">
    <div class="gs-about__img-wrap">
      {% if section.settings.image %}<img class="gs-about__img" src="{{ section.settings.image | image_url: width: 800 }}" alt="About" loading="lazy">{% else %}<div class="gs-about__img" style="background:#222; aspect-ratio:3/4;"></div>{% endif %}
    </div>
    <div class="gs-about__content">
      <span class="gs-about__eyebrow">{{ section.settings.subtitle }}</span>
      <h2 class="gs-about__title">{{ section.settings.title }}</h2>
      <div class="gs-about__text">{{ section.settings.text }}</div>
      <div class="gs-about__stats">
        <div class="gs-about__stat">
          <div class="gs-about__stat-num">2018</div>
          <div class="gs-about__stat-label">Established</div>
        </div>
        <div class="gs-about__stat">
          <div class="gs-about__stat-num">50k+</div>
          <div class="gs-about__stat-label">Happy Clients</div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "GS About", "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "The Heritage" },
    { "type": "text", "id": "title", "label": "Heading", "default": "A Return to Classic Grooming" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We believe grooming is a ritual, not a chore. Built on the foundation of traditional barbering, our products are engineered for the modern man who respects quality.</p>" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [{ "name": "GS About" }]
}
{% endschema %}
