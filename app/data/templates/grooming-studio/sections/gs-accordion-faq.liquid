<style>.gs-faq{max-width:800px;margin:80px auto;padding:0 20px}.gs-faq h2{text-align:center;font-size:36px;margin-bottom:40px}.gs-faq-item{border-bottom:1px solid #ddd}.gs-faq-btn{width:100%;padding:20px 0;display:flex;justify-content:space-between;align-items:center;background:none;border:none;font-size:18px;font-weight:500;cursor:pointer;text-align:left}.gs-faq-content{padding-bottom:20px;font-size:15px;line-height:1.6;color:#555;display:none}</style><section class="gs-faq"><h2>{{ section.settings.title }}</h2>{% for block in section.blocks %}<div class="gs-faq-item"><button class="gs-faq-btn" onclick="this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'block' ? 'none' : 'block'">{{ block.settings.question }} <span>+</span></button><div class="gs-faq-content">{{ block.settings.answer }}</div></div>{% endfor %}</section>{% schema %}{"name":"Accordion FAQ","settings":[{"type":"text","id":"title","label":"Heading","default":"Frequently Asked Questions"}],"blocks":[{"type":"faq","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"How does shipping work?"},{"type":"textarea","id":"answer","label":"Answer","default":"We ship globally within 3-5 business days."}]}],"presets":[{"name":"Accordion FAQ"}]}{% endschema %}