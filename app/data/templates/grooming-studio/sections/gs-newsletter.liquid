<style>
  .gs-newsletter { padding: 100px 0; background: #000; border-top: 1px solid #222; text-align: center; }
  .gs-newsletter__container { max-width: 600px; margin: 0 auto; padding: 0 40px; }
  .gs-newsletter__title { font-family: 'Oswald', sans-serif; font-size: 36px; font-weight: 700; color: #fff; text-transform: uppercase; margin-bottom: 20px; letter-spacing: 1px; }
  .gs-newsletter__text { font-family: 'Inter', sans-serif; font-size: 16px; color: #a0aec0; margin-bottom: 40px; font-weight: 300; }
  .gs-newsletter__form { display: flex; gap: 0; border: 1px solid #333; }
  @media (max-width: 600px) { .gs-newsletter__form { flex-direction: column; border: none; gap: 15px; } }
  .gs-newsletter__input { flex: 1; padding: 18px 24px; border: none; background: #111; font-family: 'Inter', sans-serif; font-size: 14px; color: #fff; outline: none; text-transform: uppercase; letter-spacing: 1px; }
  @media (max-width: 600px) { .gs-newsletter__input { border: 1px solid #333; } }
  .gs-newsletter__input::placeholder { color: #555; }
  .gs-newsletter__btn { padding: 18px 40px; background: {{ section.settings.accent_color }}; color: #000; border: none; font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: background 0.3s; }
  .gs-newsletter__btn:hover { background: #fff; }
</style>
<section class="gs-newsletter">
  <div class="gs-newsletter__container">
    <h2 class="gs-newsletter__title">{{ section.settings.title }}</h2>
    <div class="gs-newsletter__text">{{ section.settings.text }}</div>
    {% form 'customer' %}
      <div class="gs-newsletter__form">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" class="gs-newsletter__input" placeholder="{{ section.settings.placeholder }}" required>
        <button type="submit" class="gs-newsletter__btn">{{ section.settings.btn_label }}</button>
      </div>
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "GS Newsletter", "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Join the Club" },
    { "type": "richtext", "id": "text", "label": "Body", "default": "<p>Subscribe for exclusive drops, grooming tips, and 10% off your first order.</p>" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Enter email address" },
    { "type": "text", "id": "btn_label", "label": "Button", "default": "Subscribe" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [{ "name": "GS Newsletter" }]
}
{% endschema %}
