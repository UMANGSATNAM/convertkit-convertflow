<style>
  .gs-ing { padding: 100px 0; background: #111; border-top: 1px solid #222; }
  .gs-ing__container { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
  .gs-ing__header { text-align: center; margin-bottom: 60px; }
  .gs-ing__eyebrow { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 3px; color: {{ section.settings.accent_color }}; margin-bottom: 15px; display: block; }
  .gs-ing__title { font-family: 'Oswald', sans-serif; font-size: 40px; font-weight: 700; color: #fff; text-transform: uppercase; margin-bottom: 20px; }
  .gs-ing__desc { font-family: 'Inter', sans-serif; font-size: 16px; color: #a0aec0; max-width: 600px; margin: 0 auto; font-weight: 300; }
  .gs-ing__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; }
  @media (max-width: 900px) { .gs-ing__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .gs-ing__grid { grid-template-columns: 1fr; } }
  .gs-ing-card { background: #1a1a1a; padding: 30px; text-align: center; border: 1px solid #333; transition: transform 0.3s, border-color 0.3s; }
  .gs-ing-card:hover { transform: translateY(-5px); border-color: {{ section.settings.accent_color }}; }
  .gs-ing-card__icon { width: 50px; height: 50px; margin: 0 auto 20px; display: flex; align-items: center; justify-content: center; background: #222; border-radius: 50%; color: {{ section.settings.accent_color }}; font-size: 24px; }
  .gs-ing-card__title { font-family: 'Oswald', sans-serif; font-size: 20px; font-weight: 500; color: #fff; text-transform: uppercase; margin-bottom: 15px; letter-spacing: 1px; }
  .gs-ing-card__text { font-family: 'Inter', sans-serif; font-size: 14px; color: #718096; line-height: 1.6; }
</style>
<section class="gs-ing">
  <div class="gs-ing__container">
    <div class="gs-ing__header">
      <span class="gs-ing__eyebrow">{{ section.settings.subtitle }}</span>
      <h2 class="gs-ing__title">{{ section.settings.title }}</h2>
      <p class="gs-ing__desc">{{ section.settings.desc }}</p>
    </div>
    <div class="gs-ing__grid">
      {% for block in section.blocks %}
        <div class="gs-ing-card" {{ block.shopify_attributes }}>
          <div class="gs-ing-card__icon">{{ block.settings.icon }}</div>
          <h3 class="gs-ing-card__title">{{ block.settings.title }}</h3>
          <p class="gs-ing-card__text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "GS Ingredients", "tag": "section",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "The Formulation" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Premium Ingredients" },
    { "type": "text", "id": "desc", "label": "Description", "default": "No fillers. No synthetic nonsense. Just high-performance components that get the job done." },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "blocks": [{ "type": "ingredient", "name": "Ingredient", "settings": [
    { "type": "text", "id": "icon", "label": "Emoji Icon", "default": "💧" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Argan Oil" },
    { "type": "text", "id": "text", "label": "Text", "default": "Hydrates and softens." }
  ]}],
  "presets": [{ "name": "GS Ingredients", "blocks": [
    { "type": "ingredient", "settings": { "icon": "🌿", "title": "Tea Tree", "text": "Cleanses and invigorates." }},
    { "type": "ingredient", "settings": { "icon": "🌰", "title": "Shea Butter", "text": "Deep conditioning." }},
    { "type": "ingredient", "settings": { "icon": "🪵", "title": "Sandalwood", "text": "Classic masculine scent." }},
    { "type": "ingredient", "settings": { "icon": "☕", "title": "Caffeine", "text": "Stimulates hair follicles." }}
  ]}]
}
{% endschema %}
