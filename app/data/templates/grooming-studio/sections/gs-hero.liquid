<style>
  .gs-hero { width: 100%; min-height: 90vh; display: flex; align-items: center; position: relative; overflow: hidden; background: #000; }
  .gs-hero__bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.6; z-index: 1; }
  .gs-hero__overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to right, rgba(17,17,17,1) 0%, rgba(17,17,17,0.4) 100%); z-index: 2; }
  .gs-hero__container { max-width: 1200px; margin: 0 auto; padding: 40px; position: relative; z-index: 3; width: 100%; }
  .gs-hero__content { max-width: 600px; }
  .gs-hero__badge { display: inline-flex; align-items: center; gap: 10px; font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 3px; color: {{ section.settings.accent_color }}; margin-bottom: 25px; }
  .gs-hero__badge::before { content: ''; display: block; width: 30px; height: 1px; background: {{ section.settings.accent_color }}; }
  .gs-hero__title { font-family: 'Oswald', sans-serif; font-size: clamp(50px, 8vw, 80px); font-weight: 700; color: #fff; line-height: 1.05; margin-bottom: 25px; text-transform: uppercase; }
  .gs-hero__desc { font-family: 'Inter', sans-serif; font-size: 18px; color: #a0aec0; line-height: 1.6; margin-bottom: 40px; font-weight: 300; }
  .gs-hero__cta { display: inline-flex; align-items: center; justify-content: center; background: {{ section.settings.accent_color }}; color: #000; padding: 18px 40px; font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; text-decoration: none; transition: background 0.3s, transform 0.2s; }
  .gs-hero__cta:hover { background: #fff; transform: translateY(-2px); }
</style>
<section class="gs-hero">
  {% if section.settings.bg_image %}<img class="gs-hero__bg" src="{{ section.settings.bg_image | image_url: width: 2000 }}" alt="" loading="eager">{% else %}<div class="gs-hero__bg" style="background: url('https://images.unsplash.com/photo-1503951914875-452162b0f3f1?w=2000&q=80') center/cover;"></div>{% endif %}
  <div class="gs-hero__overlay"></div>
  <div class="gs-hero__container">
    <div class="gs-hero__content">
      <div class="gs-hero__badge">{{ section.settings.badge }}</div>
      <h1 class="gs-hero__title">{{ section.settings.title }}</h1>
      <p class="gs-hero__desc">{{ section.settings.desc }}</p>
      {% if section.settings.btn_label != blank %}<a href="{{ section.settings.btn_link }}" class="gs-hero__cta">{{ section.settings.btn_label }}</a>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "GS Hero", "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "text", "id": "badge", "label": "Badge Text", "default": "Premium Care" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Refine Your Routine" },
    { "type": "text", "id": "desc", "label": "Description", "default": "Professional grade grooming essentials built for the modern man. Precision, quality, and performance." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Shop Collection" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [{ "name": "GS Hero" }]
}
{% endschema %}
