<style>
  .fp-coll-grid { padding: 80px 0; background: #000; border-top: 1px solid #222; }
  .fp-coll-grid__container { max-width: 1400px; margin: 0 auto; padding: 0 30px; }
  .fp-coll-grid__header { margin-bottom: 40px; border-bottom: 1px solid #222; padding-bottom: 20px; }
  .fp-coll-grid__title { font-family: 'Inter', sans-serif; font-size: 48px; font-weight: 900; color: #fff; text-transform: uppercase; margin: 0 0 10px 0; letter-spacing: -2px; }
  .fp-coll-grid__count { font-family: 'Inter', sans-serif; font-size: 14px; color: #ff2a2a; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; }
  .fp-coll-grid__products { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
  @media (max-width: 900px) { .fp-coll-grid__products { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .fp-coll-grid__products { grid-template-columns: 1fr; } }
  .fp-cg-card { text-decoration: none; display: block; background: #0a0a0a; border: 1px solid #222; transition: all 0.3s; position: relative; }
  .fp-cg-card:hover { border-color: #ff2a2a; transform: translateY(-5px); }
  .fp-cg-card__img { aspect-ratio: 4/5; overflow: hidden; background: #111; position: relative; }
  .fp-cg-card__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; opacity: 0.8; }
  .fp-cg-card:hover .fp-cg-card__img img { transform: scale(1.1); opacity: 1; }
  .fp-cg-card__info { padding: 20px; }
  .fp-cg-card__name { font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 800; color: #fff; text-transform: uppercase; margin: 0 0 10px 0; letter-spacing: -0.5px; }
  .fp-cg-card__price { font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 600; color: #aaa; }
</style>
<section class="fp-coll-grid">
  <div class="fp-coll-grid__container">
    <div class="fp-coll-grid__header">
      <h1 class="fp-coll-grid__title">{{ collection.title }}</h1>
      <div class="fp-coll-grid__count">{{ collection.products_count }} items</div>
    </div>
    <div class="fp-coll-grid__products">
      {% paginate collection.products by 12 %}
        {% for product in collection.products %}
          <a href="{{ product.url }}" class="fp-cg-card">
            <div class="fp-cg-card__img">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">{% endif %}</div>
            <div class="fp-cg-card__info">
              <div class="fp-cg-card__name">{{ product.title }}</div>
              <div class="fp-cg-card__price">{{ product.price | money }}</div>
            </div>
          </a>
        {% endfor %}
        {% if paginate.pages > 1 %}<div style="text-align:center;margin-top:50px;">{{ paginate | default_pagination }}</div>{% endif %}
      {% endpaginate %}
    </div>
  </div>
</section>
{% schema %}
{ "name": "FP Collection Grid", "tag": "section", "settings": [], "presets": [{ "name": "FP Collection Grid" }] }
{% endschema %}
