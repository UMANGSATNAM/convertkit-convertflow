<style>
  .fp-brand { padding: 120px 0; background: #000; border-top: 1px solid #222; }
  .fp-brand__container { max-width: 1400px; margin: 0 auto; padding: 0 30px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  @media (max-width: 900px) { .fp-brand__container { grid-template-columns: 1fr; } }
  .fp-brand__image-wrapper { position: relative; }
  .fp-brand__image-wrapper::before { content: ''; position: absolute; top: -20px; left: -20px; width: 100%; height: 100%; border: 2px solid {{ section.settings.accent_color }}; z-index: 0; }
  .fp-brand__image { width: 100%; aspect-ratio: 4/5; object-fit: cover; position: relative; z-index: 1; filter: contrast(1.2) grayscale(0.2); }
  .fp-brand__eyebrow { font-family: 'Inter', sans-serif; font-size: 14px; color: {{ section.settings.accent_color }}; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 15px; display: inline-block; }
  .fp-brand__title { font-family: 'Inter', sans-serif; font-size: clamp(36px, 5vw, 60px); font-weight: 900; color: #fff; text-transform: uppercase; line-height: 1; margin-bottom: 30px; letter-spacing: -2px; }
  .fp-brand__text { font-family: 'Inter', sans-serif; font-size: 16px; line-height: 1.6; color: #aaa; margin-bottom: 40px; }
  .fp-brand__btn { display: inline-flex; align-items: center; justify-content: center; background: transparent; color: {{ section.settings.accent_color }}; border: 2px solid {{ section.settings.accent_color }}; padding: 16px 40px; font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; text-decoration: none; transition: all 0.3s; clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%); }
  .fp-brand__btn:hover { background: {{ section.settings.accent_color }}; color: #fff; }
</style>
<section class="fp-brand">
  <div class="fp-brand__container" style="{% if section.settings.image_position == 'right' %}direction: rtl;{% endif %}">
    <div class="fp-brand__image-wrapper" style="direction: ltr;">
      {% if section.settings.image %}<img class="fp-brand__image" src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" loading="lazy">{% else %}<div class="fp-brand__image" style="background: #111;"></div>{% endif %}
    </div>
    <div style="direction: ltr;">
      <span class="fp-brand__eyebrow">{{ section.settings.label }}</span>
      <h2 class="fp-brand__title">{{ section.settings.title }}</h2>
      <div class="fp-brand__text">{{ section.settings.text }}</div>
      {% if section.settings.btn_label != blank %}<a href="{{ section.settings.btn_link }}" class="fp-brand__btn">{{ section.settings.btn_label }}</a>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FP Brand Story", "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image Position", "options": [{"value":"left","label":"Left"},{"value":"right","label":"Right"}], "default": "left" },
    { "type": "text", "id": "label", "label": "Label", "default": "Our Mission" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Built for the Grind" },
    { "type": "richtext", "id": "text", "label": "Body", "default": "<p>We create uncompromised gear for athletes who push boundaries. No shortcuts, no excuses.</p>" },
    { "type": "text", "id": "btn_label", "label": "Button", "default": "Read Our Story" },
    { "type": "url", "id": "btn_link", "label": "Link" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ff2a2a" }
  ],
  "presets": [{ "name": "FP Brand Story" }]
}
{% endschema %}
