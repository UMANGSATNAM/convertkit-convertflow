<style>
  .fp-accordion { padding: 50px 0; background: #000; border-top: 1px solid #222; }
  .fp-accordion__container { max-width: 900px; margin: 0 auto; padding: 0 30px; }
  .fp-accordion__title { font-family: 'Inter', sans-serif; font-size: 32px; font-weight: 900; color: #fff; text-transform: uppercase; margin-bottom: 40px; letter-spacing: -1px; }
  .fp-accordion__item { border-bottom: 1px solid #333; }
  .fp-accordion__trigger { width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 25px 0; background: none; border: none; cursor: pointer; font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 800; color: #fff; text-transform: uppercase; letter-spacing: 1px; transition: color 0.3s; }
  .fp-accordion__trigger:hover { color: #ff2a2a; }
  .fp-accordion__icon { font-size: 24px; color: #ff2a2a; transition: transform 0.3s; font-weight: 400; }
  .fp-accordion__item.active .fp-accordion__icon { transform: rotate(45deg); }
  .fp-accordion__content { max-height: 0; overflow: hidden; transition: max-height 0.4s ease; }
  .fp-accordion__item.active .fp-accordion__content { max-height: 800px; }
  .fp-accordion__body { padding: 0 0 30px; font-family: 'Inter', sans-serif; font-size: 15px; line-height: 1.7; color: #aaa; font-weight: 500; }
</style>
<section class="fp-accordion">
  <div class="fp-accordion__container">
    <h2 class="fp-accordion__title">{{ section.settings.title }}</h2>
    {% for block in section.blocks %}
      <div class="fp-accordion__item" {{ block.shopify_attributes }}>
        <button class="fp-accordion__trigger" onclick="this.parentElement.classList.toggle('active')">{{ block.settings.heading }}<span class="fp-accordion__icon">+</span></button>
        <div class="fp-accordion__content"><div class="fp-accordion__body">{{ block.settings.body }}</div></div>
      </div>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "FP Accordion Details", "tag": "section",
  "settings": [{ "type": "text", "id": "title", "label": "Heading", "default": "The Details" }],
  "blocks": [{ "type": "accordion", "name": "Item", "settings": [
    { "type": "text", "id": "heading", "label": "Question", "default": "Features" },
    { "type": "richtext", "id": "body", "label": "Answer", "default": "<p>Engineered for maximum performance.</p>" }
  ]}],
  "presets": [{ "name": "FP Accordion Details", "blocks": [
    { "type": "accordion", "settings": { "heading": "Features" }},
    { "type": "accordion", "settings": { "heading": "Sizing & Fit" }},
    { "type": "accordion", "settings": { "heading": "Shipping" }}
  ]}]
}
{% endschema %}
