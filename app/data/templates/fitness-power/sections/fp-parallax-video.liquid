<style>
  .fp-parallax-sec {
    position: relative;
    height: 80vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    clip-path: inset(0);
  }
  .fp-parallax-vid {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: -1;
    pointer-events: none;
  }
  .fp-parallax-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
  }
  .fp-parallax-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    font-family: var(--fp-font-sans, sans-serif);
  }
  .fp-parallax-title {
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 800;
    margin-bottom: 20px;
    letter-spacing: -2px;
  }
  .fp-parallax-btn {
    display: inline-block;
    padding: 16px 40px;
    background: #ff4500;
    color: #000;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 1px;
    border-radius: 4px;
    transition: transform 0.3s;
  }
  .fp-parallax-btn:hover {
    transform: scale(1.05);
  }
</style>

<section class="fp-parallax-sec">
  <video class="fp-parallax-vid" autoplay muted loop playsinline>
    <source src="{{ section.settings.video_url | default: 'https://cdn.shopify.com/videos/c/o/v/02d0ec7849e742c3809cbceb7405e5d3.mp4' }}" type="video/mp4">
  </video>
  <div class="fp-parallax-overlay"></div>
  <div class="fp-parallax-content">
    <h2 class="fp-parallax-title">{{ section.settings.title | default: 'Feel the Motion' }}</h2>
    <a href="#" class="fp-parallax-btn">{{ section.settings.btn | default: 'Discover More' }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Parallax Video",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "video_url", "label": "Video URL" },
    { "type": "text", "id": "title", "label": "Heading" }
  ],
  "presets": [{ "name": "Parallax Video" }]
}
{% endschema %}
