<style>
  .fp-buybox { position: sticky; top: 80px; padding: 40px; background: #0a0a0a; border: 1px solid #222; }
  .fp-buybox__vendor { font-family: 'Inter', sans-serif; font-size: 13px; color: {{ section.settings.accent_color }}; text-transform: uppercase; letter-spacing: 3px; font-weight: 800; margin-bottom: 10px; }
  .fp-buybox__title { font-family: 'Inter', sans-serif; font-size: 36px; font-weight: 900; color: #fff; text-transform: uppercase; line-height: 1; margin-bottom: 15px; letter-spacing: -1px; }
  .fp-buybox__price { font-family: 'Inter', sans-serif; font-size: 28px; font-weight: 900; color: #fff; margin-bottom: 10px; display: flex; align-items: center; gap: 15px; }
  .fp-buybox__compare { color: #555; text-decoration: line-through; font-size: 20px; }
  .fp-buybox__rating { margin-bottom: 25px; color: {{ section.settings.accent_color }}; font-size: 16px; letter-spacing: 2px; }
  .fp-buybox__variants { margin-bottom: 30px; }
  .fp-buybox__variant-label { font-family: 'Inter', sans-serif; font-size: 13px; color: #888; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; display: block; }
  .fp-buybox__variant-select { width: 100%; padding: 15px 20px; background: #000; border: 1px solid #333; color: #fff; font-family: 'Inter', sans-serif; font-size: 15px; text-transform: uppercase; font-weight: 600; cursor: pointer; outline: none; transition: border-color 0.3s; }
  .fp-buybox__variant-select:focus { border-color: {{ section.settings.accent_color }}; }
  .fp-buybox__add-btn { width: 100%; padding: 20px; background: {{ section.settings.accent_color }}; color: #fff; border: none; font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 900; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: all 0.3s; clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%); margin-bottom: 15px; }
  .fp-buybox__add-btn:hover { background: #fff; color: #000; transform: scale(1.02); }
  .fp-buybox__meta { margin-top: 30px; padding-top: 20px; border-top: 1px solid #222; }
  .fp-buybox__meta-item { font-family: 'Inter', sans-serif; font-size: 13px; color: #aaa; margin-bottom: 8px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; gap: 10px; }
  .fp-buybox__meta-icon { color: {{ section.settings.accent_color }}; }
</style>
<div class="fp-buybox">
  <div class="fp-buybox__vendor">{{ product.vendor }}</div>
  <h1 class="fp-buybox__title">{{ product.title }}</h1>
  <div class="fp-buybox__rating">★★★★★ <span style="color:#666;font-size:12px;">(128 Reviews)</span></div>
  <div class="fp-buybox__price">{{ product.selected_or_first_available_variant.price | money }}{% if product.compare_at_price > product.price %}<span class="fp-buybox__compare">{{ product.compare_at_price | money }}</span>{% endif %}</div>
  {% form 'product', product %}
    {% unless product.has_only_default_variant %}
      <div class="fp-buybox__variants">
        {% for option in product.options_with_values %}
          <label class="fp-buybox__variant-label">{{ option.name }}</label>
          <select name="id" class="fp-buybox__variant-select">
            {% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title }} - {{ variant.price | money }}</option>{% endfor %}
          </select>
        {% endfor %}
      </div>
    {% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}
    <button type="submit" class="fp-buybox__add-btn" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to Cart{% else %}Sold Out{% endif %}</button>
  {% endform %}
  <div class="fp-buybox__meta">
    <div class="fp-buybox__meta-item"><span class="fp-buybox__meta-icon">⚡</span> High Performance</div>
    <div class="fp-buybox__meta-item"><span class="fp-buybox__meta-icon">🛡️</span> Heavy Duty Tested</div>
    <div class="fp-buybox__meta-item"><span class="fp-buybox__meta-icon">📦</span> Fast Shipping</div>
  </div>
</div>
{% schema %}
{ "name": "FP Sticky Buybox", "tag": "section", "settings": [{ "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#ff2a2a" }], "presets": [{ "name": "FP Sticky Buybox" }] }
{% endschema %}
