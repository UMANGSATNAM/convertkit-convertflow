<style>
  .fp-footer { background: #000; padding: 100px 0 30px; border-top: 2px solid #222; }
  .fp-footer__container { max-width: 1400px; margin: 0 auto; padding: 0 30px; }
  .fp-footer__grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 50px; margin-bottom: 80px; }
  @media (max-width: 900px) { .fp-footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .fp-footer__grid { grid-template-columns: 1fr; } }
  .fp-footer__logo { font-family: 'Inter', sans-serif; font-size: 32px; color: #fff; text-decoration: none; font-weight: 900; text-transform: uppercase; letter-spacing: -1px; display: block; margin-bottom: 20px; }
  .fp-footer__logo span { color: {{ section.settings.accent_color }}; }
  .fp-footer__desc { font-family: 'Inter', sans-serif; font-size: 15px; color: #888; line-height: 1.6; max-width: 350px; font-weight: 500; }
  .fp-footer__title { font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 900; color: #fff; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 30px; }
  .fp-footer__links { list-style: none; padding: 0; margin: 0; }
  .fp-footer__links li { margin-bottom: 15px; }
  .fp-footer__links a { font-family: 'Inter', sans-serif; font-size: 14px; color: #888; text-decoration: none; transition: color 0.3s; font-weight: 600; text-transform: uppercase; }
  .fp-footer__links a:hover { color: {{ section.settings.accent_color }}; }
  .fp-footer__bottom { padding-top: 30px; border-top: 1px solid #222; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; }
  .fp-footer__copy { font-family: 'Inter', sans-serif; font-size: 14px; color: #666; font-weight: 600; text-transform: uppercase; }
  .fp-footer__socials { display: flex; gap: 20px; }
  .fp-footer__social { width: 45px; height: 45px; background: #111; color: #fff; display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 18px; transition: all 0.3s; clip-path: polygon(5px 0, 100% 0, calc(100% - 5px) 100%, 0 100%); }
  .fp-footer__social:hover { background: {{ section.settings.accent_color }}; }
</style>
<footer class="fp-footer">
  <div class="fp-footer__container">
    <div class="fp-footer__grid">
      <div>
        <a href="/" class="fp-footer__logo">{{ section.settings.logo_text | split: ' ' | first }} <span>{{ section.settings.logo_text | split: ' ' | last }}</span></a>
        <p class="fp-footer__desc">{{ section.settings.description }}</p>
      </div>
      {% for block in section.blocks %}
        <div>
          <h4 class="fp-footer__title">{{ block.settings.title }}</h4>
          <ul class="fp-footer__links">
            {% assign links = block.settings.menu | default: linklists.footer-menu %}
            {% if block.settings.menu != blank %}
              {% for link in linklists[block.settings.menu].links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
            {% endif %}
          </ul>
        </div>
      {% endfor %}
    </div>
    <div class="fp-footer__bottom">
      <span class="fp-footer__copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}. ALL RIGHTS RESERVED.</span>
      <div class="fp-footer__socials">
        {% if section.settings.instagram != blank %}<a href="{{ section.settings.instagram }}" class="fp-footer__social" target="_blank">IG</a>{% endif %}
        {% if section.settings.youtube != blank %}<a href="{{ section.settings.youtube }}" class="fp-footer__social" target="_blank">YT</a>{% endif %}
      </div>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "FP Footer", "tag": "section",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo Text", "default": "FITNESS POWER" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Premium gear built for maximum performance." },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "youtube", "label": "YouTube" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#ff2a2a" }
  ],
  "blocks": [{ "type": "column", "name": "Link Column", "settings": [
    { "type": "text", "id": "title", "label": "Column Title", "default": "Shop" },
    { "type": "link_list", "id": "menu", "label": "Menu" }
  ]}],
  "presets": [{ "name": "FP Footer", "blocks": [{ "type": "column", "settings": { "title": "Gear" }}, { "type": "column", "settings": { "title": "Info" }}, { "type": "column", "settings": { "title": "Support" }}] }]
}
{% endschema %}
