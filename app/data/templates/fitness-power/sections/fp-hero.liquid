<style>
  .fp-hero { position: relative; width: 100%; height: 90vh; min-height: 600px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #000; text-align: center; }
  .fp-hero__image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.6; z-index: 1; transform: scale(1.05); animation: fpZoom 20s infinite alternate; }
  @keyframes fpZoom { from { transform: scale(1); } to { transform: scale(1.1); } }
  .fp-hero__overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(0deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.8) 100%); z-index: 2; }
  .fp-hero__content { position: relative; z-index: 3; max-width: 800px; padding: 0 30px; }
  .fp-hero__eyebrow { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 800; letter-spacing: 4px; text-transform: uppercase; color: {{ section.settings.accent_color }}; margin-bottom: 20px; display: inline-block; border-bottom: 2px solid {{ section.settings.accent_color }}; padding-bottom: 5px; }
  .fp-hero__title { font-family: 'Inter', sans-serif; font-size: clamp(40px, 8vw, 90px); font-weight: 900; line-height: 1; color: #fff; text-transform: uppercase; margin-bottom: 20px; letter-spacing: -2px; text-shadow: 0 10px 30px rgba(0,0,0,0.8); }
  .fp-hero__desc { font-family: 'Inter', sans-serif; font-size: 16px; line-height: 1.6; color: #ccc; margin-bottom: 40px; font-weight: 500; max-width: 500px; margin-left: auto; margin-right: auto; }
  .fp-hero__cta { display: inline-flex; align-items: center; justify-content: center; background: {{ section.settings.accent_color }}; color: #fff; padding: 18px 45px; font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; text-decoration: none; transition: all 0.3s; clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%); }
  .fp-hero__cta:hover { background: #fff; color: #000; transform: scale(1.05); }
</style>
<section class="fp-hero">
  {% if section.settings.image %}<img class="fp-hero__image" src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.title | escape }}" loading="eager">{% endif %}
  <div class="fp-hero__overlay"></div>
  <div class="fp-hero__content">
    {% if section.settings.eyebrow != blank %}<div class="fp-hero__eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
    {% if section.settings.title != blank %}<h1 class="fp-hero__title">{{ section.settings.title }}</h1>{% endif %}
    {% if section.settings.desc != blank %}<p class="fp-hero__desc">{{ section.settings.desc }}</p>{% endif %}
    {% if section.settings.btn_label != blank %}<a href="{{ section.settings.btn_link }}" class="fp-hero__cta">{{ section.settings.btn_label }}</a>{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "FP Hero", "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Text", "default": "Push Your Limits" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Defy Average" },
    { "type": "text", "id": "desc", "label": "Description", "default": "Premium gear and supplements designed for those who refuse to settle." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Shop Gear" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#ff2a2a" }
  ],
  "presets": [{ "name": "FP Hero" }]
}
{% endschema %}
