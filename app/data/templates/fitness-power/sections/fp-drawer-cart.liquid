<style>
  .fp-drawer-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 999; opacity: 0; visibility: hidden; transition: all 0.3s ease; }
  .fp-drawer-overlay.active { opacity: 1; visibility: visible; }
  .fp-drawer { position: fixed; top: 0; right: -420px; width: 400px; max-width: 90vw; height: 100%; background: #0a0a0a; border-left: 2px solid #222; z-index: 1000; transition: right 0.4s cubic-bezier(0.16, 1, 0.3, 1); display: flex; flex-direction: column; }
  .fp-drawer.active { right: 0; }
  .fp-drawer__header { display: flex; justify-content: space-between; align-items: center; padding: 30px; border-bottom: 1px solid #222; background: #000; }
  .fp-drawer__title { font-family: 'Inter', sans-serif; font-size: 24px; font-weight: 900; color: #fff; text-transform: uppercase; margin: 0; letter-spacing: -1px; }
  .fp-drawer__close { background: none; border: none; color: #ff2a2a; width: 30px; height: 30px; cursor: pointer; font-size: 24px; display: flex; align-items: center; justify-content: center; font-weight: 900; transition: transform 0.3s; }
  .fp-drawer__close:hover { transform: rotate(90deg); color: #fff; }
  .fp-drawer__body { flex: 1; overflow-y: auto; padding: 30px; }
  .fp-drawer__empty { text-align: center; padding: 60px 20px; color: #666; font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 600; text-transform: uppercase; }
  .fp-drawer__item { display: flex; gap: 20px; padding: 20px 0; border-bottom: 1px solid #222; }
  .fp-drawer__item-img { width: 90px; height: 110px; object-fit: cover; background: #111; border: 1px solid #333; }
  .fp-drawer__item-info { flex: 1; }
  .fp-drawer__item-name { font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 800; color: #fff; text-transform: uppercase; margin-bottom: 5px; }
  .fp-drawer__item-price { font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 700; color: #ff2a2a; margin-bottom: 10px; }
  .fp-drawer__item-qty { display: flex; align-items: center; background: #000; border: 1px solid #333; width: fit-content; }
  .fp-drawer__qty-btn { width: 30px; height: 30px; background: none; border: none; color: #888; cursor: pointer; font-size: 16px; font-weight: 700; display: flex; align-items: center; justify-content: center; transition: color 0.3s; }
  .fp-drawer__qty-btn:hover { color: #fff; }
  .fp-drawer__qty-val { font-family: 'Inter', sans-serif; font-size: 14px; color: #fff; font-weight: 700; min-width: 30px; text-align: center; }
  .fp-drawer__footer { padding: 30px; background: #000; border-top: 1px solid #222; }
  .fp-drawer__total { display: flex; justify-content: space-between; margin-bottom: 25px; }
  .fp-drawer__total-label { font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 800; color: #fff; text-transform: uppercase; }
  .fp-drawer__total-value { font-family: 'Inter', sans-serif; font-size: 22px; font-weight: 900; color: #ff2a2a; }
  .fp-drawer__checkout { display: block; width: 100%; padding: 20px; background: #ff2a2a; color: #fff; border: none; font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 900; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; text-align: center; text-decoration: none; transition: all 0.3s; clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%); }
  .fp-drawer__checkout:hover { background: #fff; color: #000; transform: scale(1.02); }
</style>
<div class="fp-drawer-overlay" id="fp-cart-overlay" onclick="document.getElementById('fp-cart-drawer').classList.remove('active'); this.classList.remove('active');"></div>
<aside class="fp-drawer" id="fp-cart-drawer">
  <div class="fp-drawer__header">
    <h3 class="fp-drawer__title">Your Gear</h3>
    <button class="fp-drawer__close" onclick="document.getElementById('fp-cart-drawer').classList.remove('active'); document.getElementById('fp-cart-overlay').classList.remove('active');">✕</button>
  </div>
  <div class="fp-drawer__body">
    {% if cart.item_count == 0 %}
      <div class="fp-drawer__empty">Your bag is empty. Time to load up.</div>
    {% else %}
      {% for item in cart.items %}
        <div class="fp-drawer__item">
          <img class="fp-drawer__item-img" src="{{ item.image | image_url: width: 180 }}" alt="{{ item.title | escape }}">
          <div class="fp-drawer__item-info">
            <div class="fp-drawer__item-name">{{ item.product.title }}</div>
            <div class="fp-drawer__item-price">{{ item.final_line_price | money }}</div>
            <div class="fp-drawer__item-qty">
              <button class="fp-drawer__qty-btn">−</button>
              <span class="fp-drawer__qty-val">{{ item.quantity }}</span>
              <button class="fp-drawer__qty-btn">+</button>
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
  {% if cart.item_count > 0 %}
    <div class="fp-drawer__footer">
      <div class="fp-drawer__total">
        <span class="fp-drawer__total-label">Subtotal</span>
        <span class="fp-drawer__total-value">{{ cart.total_price | money }}</span>
      </div>
      <a href="/checkout" class="fp-drawer__checkout">Secure Checkout</a>
    </div>
  {% endif %}
</aside>
{% schema %}
{ "name": "FP Drawer Cart", "tag": "section", "settings": [], "presets": [{ "name": "FP Drawer Cart" }] }
{% endschema %}
