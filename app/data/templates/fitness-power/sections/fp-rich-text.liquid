<style>.fp-rt{max-width:700px;margin:100px auto;text-align:center;padding:0 20px}.fp-rt h2{font-family:var(--fp-font-serif,serif);font-size:42px;margin-bottom:30px;line-height:1.2}.fp-rt p{font-size:18px;line-height:1.8;color:#555;margin-bottom:40px}</style><section class="fp-rt"><h2>{{ section.settings.title }}</h2><p>{{ section.settings.text }}</p>{% if section.settings.btn_label != blank %}<a href="{{ section.settings.btn_link }}" style="display:inline-block;padding:15px 40px;background:#000;color:#fff;text-decoration:none;text-transform:uppercase;letter-spacing:1px;font-size:13px;">{{ section.settings.btn_label }}</a>{% endif %}</section>{% schema %}{"name":"Editorial Rich Text","settings":[{"type":"text","id":"title","label":"Heading","default":"Our Philosophy"},{"type":"textarea","id":"text","label":"Text","default":"We believe in crafting timeless pieces that elevate your everyday."},{"type":"text","id":"btn_label","label":"Button Label","default":"Read More"},{"type":"url","id":"btn_link","label":"Button Link"}],"presets":[{"name":"Editorial Rich Text"}]}{% endschema %}