<style>
  .fp-gallery { padding: 40px 0; background: #000; }
  .fp-gallery__container { max-width: 1400px; margin: 0 auto; padding: 0 30px; }
  .fp-gallery__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 15px; }
  .fp-gallery__item { aspect-ratio: 4/5; overflow: hidden; background: #111; cursor: pointer; border: 1px solid #222; }
  .fp-gallery__item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; opacity: 0.8; filter: contrast(1.1); }
  .fp-gallery__item:hover img { transform: scale(1.05); opacity: 1; }
</style>
<section class="fp-gallery">
  <div class="fp-gallery__container">
    <div class="fp-gallery__grid">
      {% for image in product.images %}
        <div class="fp-gallery__item"><img src="{{ image | image_url: width: 600 }}" alt="{{ image.alt | escape }}" loading="lazy"></div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{ "name": "FP Product Gallery", "tag": "section", "settings": [], "presets": [{ "name": "FP Product Gallery" }] }
{% endschema %}
