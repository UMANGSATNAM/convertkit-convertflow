<style>
  .jl-craft { padding: 120px 0; background: #0a0a0a; border-top: 1px solid #1a1a1a; }
  .jl-craft__container { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
  .jl-craft__header { text-align: center; margin-bottom: 80px; }
  .jl-craft__eyebrow { font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 400; text-transform: uppercase; letter-spacing: 4px; color: {{ section.settings.accent_color }}; margin-bottom: 15px; display: block; }
  .jl-craft__title { font-family: 'Cinzel', serif; font-size: 36px; font-weight: 400; color: #fff; }
  .jl-craft__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 60px; }
  @media (max-width: 900px) { .jl-craft__grid { grid-template-columns: 1fr; gap: 40px; } }
  .jl-craft__item { text-align: center; }
  .jl-craft__icon { width: 60px; height: 60px; margin: 0 auto 25px; border: 1px solid {{ section.settings.accent_color }}; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: {{ section.settings.accent_color }}; font-size: 24px; }
  .jl-craft__item-title { font-family: 'Cinzel', serif; font-size: 18px; font-weight: 400; color: #fff; margin-bottom: 15px; letter-spacing: 1px; }
  .jl-craft__item-text { font-family: 'Montserrat', sans-serif; font-size: 13px; color: #999; line-height: 1.8; font-weight: 300; }
</style>
<section class="jl-craft">
  <div class="jl-craft__container">
    <div class="jl-craft__header">
      <span class="jl-craft__eyebrow">{{ section.settings.subtitle }}</span>
      <h2 class="jl-craft__title">{{ section.settings.title }}</h2>
    </div>
    <div class="jl-craft__grid">
      {% for block in section.blocks %}
        <div class="jl-craft__item" {{ block.shopify_attributes }}>
          <div class="jl-craft__icon">✦</div>
          <h3 class="jl-craft__item-title">{{ block.settings.title }}</h3>
          <p class="jl-craft__item-text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "JL Craftsmanship", "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "The Art of Creation" },
    { "type": "text", "id": "subtitle", "label": "Eyebrow", "default": "Our Standards" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "blocks": [{ "type": "feature", "name": "Feature", "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Ethical Sourcing" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every gemstone is conflict-free and traceable to its origin." }
  ]}],
  "presets": [{ "name": "JL Craftsmanship", "blocks": [
    { "type": "feature", "settings": { "title": "Ethical Sourcing", "text": "Every gemstone is conflict-free and traceable to its origin, ensuring peace of mind with every purchase." }},
    { "type": "feature", "settings": { "title": "Master Artisans", "text": "Our pieces are handcrafted by jewelers with decades of experience in high jewelry." }},
    { "type": "feature", "settings": { "title": "Lifetime Warranty", "text": "We stand behind the quality of our work with a comprehensive lifetime guarantee." }}
  ]}]
}
{% endschema %}
