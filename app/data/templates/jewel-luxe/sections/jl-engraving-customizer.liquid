<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap');

  .jl-engrave {
    --ivory: #f7f3ec;
    --paper: #fdfbf7;
    --ink: #1c1a17;
    --gold: #a8884f;
    --gold-soft: #c9b489;
    --line: #e4ddd0;
    --muted: #8b8479;

    padding: 80px 5%;
    background-color: var(--paper);
    color: var(--ink);
    font-family: 'Jost', sans-serif;
  }
  .jl-engrave__container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 768px) {
    .jl-engrave__container {
      grid-template-columns: 1.2fr 1fr;
      gap: 60px;
    }
  }
  .jl-engrave__preview-box {
    background-color: var(--ivory);
    border: 1px solid var(--line);
    padding: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 350px;
    transition: all 0.4s ease;
  }
  .jl-engrave__mockup-wrapper {
    position: relative;
    width: 250px;
    height: 250px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .jl-engrave__mockup-ring {
    width: 100%;
    height: 100%;
    stroke: var(--gold);
    fill: none;
    stroke-width: 1.5;
  }
  .jl-engrave__preview-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: 'Cormorant Garamond', serif;
    font-size: 14px;
    font-style: italic;
    font-weight: 500;
    color: var(--gold);
    letter-spacing: 1px;
    text-align: center;
    max-width: 120px;
    pointer-events: none;
    text-transform: uppercase;
    word-break: break-all;
  }
  .jl-engrave__form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .jl-engrave__subtitle {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--gold);
    font-weight: 500;
    display: block;
    margin-bottom: 8px;
  }
  .jl-engrave__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 400;
    color: var(--ink);
    margin: 0 0 16px 0;
    line-height: 1.2;
  }
  .jl-engrave__desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 24px;
  }
  .jl-engrave__input-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .jl-engrave__label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--ink);
    font-weight: 500;
  }
  .jl-engrave__input {
    width: 100%;
    padding: 12px 16px;
    background-color: var(--paper);
    border: 1px solid var(--line);
    color: var(--ink);
    font-family: inherit;
    font-size: 14px;
    outline: none;
    transition: border-color 0.3s ease;
  }
  .jl-engrave__input:focus {
    border-color: var(--gold);
  }
  .jl-engrave__char-count {
    font-size: 11px;
    color: var(--muted);
    text-align: right;
  }
  .jl-engrave__cta {
    background-color: var(--ink);
    color: #ffffff;
    border: none;
    padding: 14px 28px;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.3s ease;
    align-self: flex-start;
  }
  .jl-engrave__cta:hover {
    background-color: var(--gold);
  }
</style>

<section class="jl-engrave" id="jl-engrave-{{ section.id }}">
  <div class="jl-engrave__container">
    <div class="jl-engrave__preview-box">
      <div class="jl-engrave__mockup-wrapper">
        <!-- Elegant Golden Ring SVG Vector -->
        <svg class="jl-engrave__mockup-ring" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="38" stroke="#a8884f" stroke-width="1.5" />
          <circle cx="50" cy="50" r="32" stroke="#caa15a" stroke-width="0.8" stroke-dasharray="2 1" />
          <!-- Small diamond detail at top of ring -->
          <polygon points="50,6 53,10 50,14 47,10" fill="#fdfbf7" stroke="#a8884f" stroke-width="0.8" />
        </svg>
        <div class="jl-engrave__preview-text" id="engraving-preview-{{ section.id }}">YOUR TEXT</div>
      </div>
    </div>
    
    <div class="jl-engrave__form">
      <div>
        <span class="jl-engrave__subtitle">{{ section.settings.subtitle }}</span>
        <h2 class="jl-engrave__title">{{ section.settings.title }}</h2>
        <p class="jl-engrave__desc">{{ section.settings.description }}</p>
      </div>

      <div class="jl-engrave__input-wrapper">
        <label class="jl-engrave__label" for="engraving-input-{{ section.id }}">Inscription (Max 12 Characters)</label>
        <input 
          type="text" 
          id="engraving-input-{{ section.id }}" 
          class="jl-engrave__input" 
          placeholder="e.g. FOREVER" 
          maxlength="12"
          value=""
        >
        <div class="jl-engrave__char-count"><span id="char-count-val-{{ section.id }}">0</span>/12</div>
      </div>

      <button type="button" class="jl-engrave__cta">Save Customization</button>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const input = document.getElementById("engraving-input-{{ section.id }}");
    const preview = document.getElementById("engraving-preview-{{ section.id }}");
    const charCount = document.getElementById("char-count-val-{{ section.id }}");

    if (input && preview) {
      input.addEventListener("input", function() {
        const text = input.value.trim();
        preview.textContent = text ? text : "YOUR TEXT";
        charCount.textContent = input.value.length;
      });
    }
  });
</script>

{% schema %}
{
  "name": "Engraving Customizer",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Personalise Your Heirloom"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Complimentary Engraving"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Add a date, name, or message inside the band to make it uniquely yours. Crafted slowly, to be inherited."
    }
  ],
  "presets": [
    {
      "name": "Engraving Customizer"
    }
  ]
}
{% endschema %}
