<style>
  .jl-story { padding: 120px 0; background: #0a0a0a; border-top: 1px solid #1a1a1a; display: flex; align-items: center; }
  .jl-story__container { max-width: 1200px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
  @media (max-width: 900px) { .jl-story__container { grid-template-columns: 1fr; gap: 40px; text-align: center; } }
  .jl-story__image-wrapper { position: relative; width: 100%; aspect-ratio: 3/4; overflow: hidden; background: #111; }
  .jl-story__image-wrapper::before { content: ''; position: absolute; top: -10px; left: -10px; right: 10px; bottom: 10px; border: 1px solid {{ section.settings.accent_color }}; opacity: 0.3; z-index: 0; }
  .jl-story__image { width: 100%; height: 100%; object-fit: cover; position: relative; z-index: 1; filter: grayscale(20%); }
  .jl-story__content { position: relative; z-index: 2; }
  .jl-story__eyebrow { font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 400; text-transform: uppercase; letter-spacing: 4px; color: {{ section.settings.accent_color }}; margin-bottom: 20px; display: block; }
  .jl-story__title { font-family: 'Cinzel', serif; font-size: 42px; font-weight: 400; color: #fff; margin-bottom: 30px; line-height: 1.2; }
  .jl-story__desc { font-family: 'Montserrat', sans-serif; font-size: 15px; color: #ccc; line-height: 1.9; margin-bottom: 40px; font-weight: 300; }
  .jl-story__signature { font-family: 'Cinzel', serif; font-size: 20px; color: #fff; font-style: italic; }
</style>
<section class="jl-story">
  <div class="jl-story__container">
    <div class="jl-story__image-wrapper">
      {% if section.settings.image %}<img class="jl-story__image" src="{{ section.settings.image | image_url: width: 800 }}" alt="Brand Story" loading="lazy">{% else %}<div style="width:100%;height:100%;background:#222;"></div>{% endif %}
    </div>
    <div class="jl-story__content">
      <span class="jl-story__eyebrow">{{ section.settings.subtitle }}</span>
      <h2 class="jl-story__title">{{ section.settings.title }}</h2>
      <div class="jl-story__desc">{{ section.settings.text }}</div>
      {% if section.settings.signature != blank %}<div class="jl-story__signature">{{ section.settings.signature }}</div>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "JL Brand Story", "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "subtitle", "label": "Eyebrow", "default": "Our Heritage" },
    { "type": "text", "id": "title", "label": "Heading", "default": "A Legacy of Perfection" },
    { "type": "richtext", "id": "text", "label": "Body", "default": "<p>Since 1924, our master artisans have been meticulously crafting pieces that transcend time. We believe true luxury is found in the details—the flawless cut of a diamond, the warm glow of ethically sourced gold, and the precise movement of a mechanical caliber.</p>" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "The Founders" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [{ "name": "JL Brand Story" }]
}
{% endschema %}
