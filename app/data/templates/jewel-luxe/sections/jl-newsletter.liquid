<style>
  .jl-newsletter { padding: 100px 0; background: #050505; text-align: center; border-top: 1px solid #1a1a1a; }
  .jl-newsletter__container { max-width: 600px; margin: 0 auto; padding: 0 40px; }
  .jl-newsletter__eyebrow { font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 400; text-transform: uppercase; letter-spacing: 4px; color: {{ section.settings.accent_color }}; margin-bottom: 20px; display: block; }
  .jl-newsletter__title { font-family: 'Cinzel', serif; font-size: 32px; font-weight: 400; color: #fff; margin-bottom: 20px; }
  .jl-newsletter__text { font-family: 'Montserrat', sans-serif; font-size: 14px; color: #999; margin-bottom: 40px; line-height: 1.6; }
  .jl-newsletter__form { display: flex; border: 1px solid #333; transition: border-color 0.3s; }
  .jl-newsletter__form:focus-within { border-color: {{ section.settings.accent_color }}; }
  .jl-newsletter__input { flex: 1; padding: 15px 20px; background: transparent; border: none; color: #fff; font-family: 'Montserrat', sans-serif; font-size: 14px; outline: none; }
  .jl-newsletter__input::placeholder { color: #555; }
  .jl-newsletter__btn { padding: 0 30px; background: {{ section.settings.accent_color }}; color: #000; border: none; font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: opacity 0.3s; }
  .jl-newsletter__btn:hover { opacity: 0.8; }
</style>
<section class="jl-newsletter">
  <div class="jl-newsletter__container">
    <span class="jl-newsletter__eyebrow">{{ section.settings.subtitle }}</span>
    <h2 class="jl-newsletter__title">{{ section.settings.title }}</h2>
    <div class="jl-newsletter__text">{{ section.settings.text }}</div>
    {% form 'customer' %}
      <div class="jl-newsletter__form">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" class="jl-newsletter__input" placeholder="{{ section.settings.placeholder }}" required>
        <button type="submit" class="jl-newsletter__btn">{{ section.settings.btn_label }}</button>
      </div>
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "JL Newsletter", "tag": "section",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Eyebrow", "default": "Private Client" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Join The Registry" },
    { "type": "richtext", "id": "text", "label": "Body", "default": "<p>Subscribe to receive exclusive invitations and early access to our rarest pieces.</p>" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Email Address" },
    { "type": "text", "id": "btn_label", "label": "Button", "default": "Subscribe" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#d4af37" }
  ],
  "presets": [{ "name": "JL Newsletter" }]
}
{% endschema %}
