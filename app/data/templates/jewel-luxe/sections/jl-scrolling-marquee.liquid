<style>.jl-marquee{background:{{section.settings.bg_color}};color:{{section.settings.text_color}};padding:15px 0;overflow:hidden;white-space:nowrap;display:flex}.jl-marquee-inner{display:flex;animation:jl-marquee-scroll 15s linear infinite}.jl-marquee span{font-size:14px;font-weight:600;text-transform:uppercase;letter-spacing:2px;padding:0 50px}@keyframes jl-marquee-scroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}</style><section class="jl-marquee"><div class="jl-marquee-inner">{% for i in (1..10) %}<span>{{ section.settings.text }}</span>{% endfor %}</div></section>{% schema %}{"name":"Scrolling Marquee","settings":[{"type":"text","id":"text","label":"Text","default":"FREE SHIPPING ON ORDERS OVER $100"},{"type":"color","id":"bg_color","label":"Background","default":"#000"},{"type":"color","id":"text_color","label":"Text","default":"#fff"}],"presets":[{"name":"Scrolling Marquee"}]}{% endschema %}