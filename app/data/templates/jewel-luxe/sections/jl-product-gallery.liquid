<style>
  .jl-gallery { padding: 40px 0; background: #0a0a0a; }
  .jl-gallery__container { max-width: 1400px; margin: 0 auto; padding: 0 40px; display: flex; gap: 20px; }
  .jl-gallery__thumbs { width: 100px; display: flex; flex-direction: column; gap: 20px; }
  .jl-gallery__thumb { width: 100%; aspect-ratio: 1; background: #111; cursor: pointer; border: 1px solid transparent; transition: border-color 0.3s; opacity: 0.6; }
  .jl-gallery__thumb:hover, .jl-gallery__thumb.active { border-color: #d4af37; opacity: 1; }
  .jl-gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .jl-gallery__main { flex: 1; aspect-ratio: 1; background: #111; position: relative; }
  .jl-gallery__main img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 900px) {
    .jl-gallery__container { flex-direction: column; }
    .jl-gallery__thumbs { width: 100%; flex-direction: row; overflow-x: auto; }
    .jl-gallery__thumb { width: 80px; flex-shrink: 0; }
  }
</style>
<section class="jl-gallery">
  <div class="jl-gallery__container">
    <div class="jl-gallery__thumbs">
      {% for image in product.images %}
        <div class="jl-gallery__thumb {% if forloop.first %}active{% endif %}" onclick="document.getElementById('jl-main-img').src='{{ image | image_url: width: 1200 }}'; document.querySelectorAll('.jl-gallery__thumb').forEach(t=>t.classList.remove('active')); this.classList.add('active');"><img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | escape }}" loading="lazy"></div>
      {% endfor %}
    </div>
    <div class="jl-gallery__main">
      <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" id="jl-main-img">
    </div>
  </div>
</section>
{% schema %}
{ "name": "JL Product Gallery", "tag": "section", "settings": [], "presets": [{ "name": "JL Product Gallery" }] }
{% endschema %}
