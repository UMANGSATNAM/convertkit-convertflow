<style>
  :root {
    --jl-font-serif: 'Playfair Display', serif;
    --jl-font-sans: 'Inter', sans-serif;
    --jl-color-bg: #ffffff;
    --jl-color-text: #000000;
    --jl-color-subdued: #666666;
    --jl-color-border: #eeeeee;
    --jl-color-accent: #f5f5f5;
    --jl-transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  body {
    font-family: var(--jl-font-sans);
    color: var(--jl-color-text);
    background: var(--jl-color-bg);
    margin: 0;
    -webkit-font-smoothing: antialiased;
  }

  /* Fade-in Animation Classes */
  .jl-animate-fade-up {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .jl-animate-fade-up.jl-in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Marquee Announcement Bar */
  .jl-announcement {
    background: #000;
    color: #fff;
    padding: 10px 0;
    overflow: hidden;
    position: relative;
    z-index: 1000;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 500;
  }
  .jl-announcement__track {
    display: flex;
    white-space: nowrap;
    animation: jl-marquee 20s linear infinite;
  }
  .jl-announcement__track:hover {
    animation-play-state: paused;
  }
  .jl-announcement__item {
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  @keyframes jl-marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* Glassmorphism Header */
  .jl-header-wrapper {
    position: sticky;
    top: 0;
    z-index: 900;
    transition: var(--jl-transition);
  }
  .jl-header {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0,0,0,0.05);
    transition: var(--jl-transition);
  }
  .jl-header.jl-scrolled {
    padding: 10px 0;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
  }
  .jl-header__container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 20px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: var(--jl-transition);
  }
  .jl-header.jl-scrolled .jl-header__container {
    padding: 10px 40px;
  }
  .jl-nav {
    display: flex;
    gap: 40px;
  }
  .jl-nav a {
    text-decoration: none;
    color: var(--jl-color-text);
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    position: relative;
    padding-bottom: 4px;
    font-weight: 500;
  }
  .jl-nav a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: #000;
    transition: var(--jl-transition);
  }
  .jl-nav a:hover::after {
    width: 100%;
  }
  .jl-logo {
    font-family: var(--jl-font-serif);
    font-size: 28px;
    font-weight: 400;
    text-decoration: none;
    color: #000;
    letter-spacing: -0.5px;
  }
  .jl-icons {
    display: flex;
    gap: 24px;
    align-items: center;
  }
  .jl-icon-btn {
    background: none;
    border: none;
    cursor: pointer;
    position: relative;
    padding: 0;
    display: flex;
    align-items: center;
    color: #000;
    transition: transform 0.3s ease;
  }
  .jl-icon-btn:hover {
    transform: scale(1.1);
  }
  .jl-cart-count {
    position: absolute;
    top: -8px;
    right: -10px;
    background: #000;
    color: #fff;
    font-size: 10px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .jl-nav { display: none; }
    .jl-header__container { padding: 15px 20px; }
  }
</style>

<div class="jl-header-wrapper">
  <!-- Announcement Bar -->
  <div class="jl-announcement">
    <div class="jl-announcement__track">
      <div class="jl-announcement__item">✨ Free Worldwide Shipping Over $150</div>
      <div class="jl-announcement__item">🖤 30-Day Free Returns</div>
      <div class="jl-announcement__item">🏆 10,000+ Five Star Reviews</div>
      <!-- Duplicate for infinite scroll -->
      <div class="jl-announcement__item">✨ Free Worldwide Shipping Over $150</div>
      <div class="jl-announcement__item">🖤 30-Day Free Returns</div>
      <div class="jl-announcement__item">🏆 10,000+ Five Star Reviews</div>
    </div>
  </div>

  <header class="jl-header" id="jl-header">
    <div class="jl-header__container">
      <nav class="jl-nav">
        {% for link in linklists.main-menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </nav>
      
      <a href="/" class="jl-logo">{{ section.settings.logo_text | default: "ATELIER" }}</a>
      
      <div class="jl-icons">
        <button class="jl-icon-btn" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>
        <button class="jl-icon-btn" aria-label="Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </button>
        <button class="jl-icon-btn" onclick="document.getElementById('jl-cart-drawer').classList.add('active'); document.getElementById('jl-cart-overlay').classList.add('active');">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          <span class="jl-cart-count">{{ cart.item_count }}</span>
        </button>
      </div>
    </div>
  </header>
</div>

<script>
  window.addEventListener('scroll', () => {
    const header = document.getElementById('jl-header');
    if (window.scrollY > 50) {
      header.classList.add('jl-scrolled');
    } else {
      header.classList.remove('jl-scrolled');
    }

    // Scroll Animations
    const elements = document.querySelectorAll('.jl-animate-fade-up');
    elements.forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight - 50) {
        el.classList.add('jl-in-view');
      }
    });
  });
</script>

{% schema %}
{
  "name": "Premium Header",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo Text", "default": "ATELIER" }
  ]
}
{% endschema %}
