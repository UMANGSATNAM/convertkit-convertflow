<style>
  .jl-header { position: absolute; top: 0; width: 100%; z-index: 500; padding: 20px 0; border-bottom: 1px solid rgba(255,255,255,0.1); }
  .jl-header__container { max-width: 1400px; margin: 0 auto; padding: 0 40px; display: flex; align-items: center; justify-content: space-between; }
  .jl-header__nav { display: flex; gap: 40px; }
  @media (max-width: 900px) { .jl-header__nav { display: none; } }
  .jl-header__nav a { font-family: 'Montserrat', sans-serif; font-size: 11px; font-weight: 500; color: #fff; text-decoration: none; text-transform: uppercase; letter-spacing: 3px; transition: color 0.3s; }
  .jl-header__nav a:hover { color: #d4af37; }
  .jl-header__logo { font-family: 'Cinzel', serif; font-size: 28px; color: #fff; text-decoration: none; font-weight: 400; letter-spacing: 4px; text-transform: uppercase; }
  .jl-header__icons { display: flex; align-items: center; gap: 25px; }
  .jl-header__icon { background: none; border: none; color: #fff; font-size: 18px; cursor: pointer; transition: color 0.3s; text-decoration: none; display: flex; align-items: center; }
  .jl-header__icon:hover { color: #d4af37; }
  .jl-header__cart-btn { display: flex; align-items: center; gap: 8px; font-family: 'Montserrat', sans-serif; font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 2px; color: #fff; background: none; border: none; cursor: pointer; transition: color 0.3s; }
  .jl-header__cart-btn:hover { color: #d4af37; }
  .jl-header__cart-count { color: #d4af37; }
</style>
<header class="jl-header">
  <div class="jl-header__container">
    <nav class="jl-header__nav">
      {% for link in linklists.main-menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </nav>
    <a href="/" class="jl-header__logo">{{ section.settings.logo_text }}</a>
    <div class="jl-header__icons">
      <a href="/search" class="jl-header__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></a>
      <a href="/account" class="jl-header__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></a>
      <button class="jl-header__cart-btn" onclick="document.getElementById('jl-cart-drawer').classList.add('active'); document.getElementById('jl-cart-overlay').classList.add('active');">
        Bag <span class="jl-header__cart-count">({{ cart.item_count }})</span>
      </button>
    </div>
  </div>
</header>
{% schema %}
{ "name": "JL Header", "tag": "section", "settings": [{ "type": "text", "id": "logo_text", "label": "Logo Text", "default": "LUXE" }], "presets": [{ "name": "JL Header" }] }
{% endschema %}
