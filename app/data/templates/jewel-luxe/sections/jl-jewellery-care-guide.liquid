<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600&family=Jost:wght@300;400;500&display=swap');

  .jl-care {
    --ivory: #f7f3ec;
    --paper: #fdfbf7;
    --ink: #1c1a17;
    --gold: #a8884f;
    --gold-soft: #c9b489;
    --line: #e4ddd0;
    --muted: #8b8479;

    padding: 85px 5%;
    background-color: var(--paper);
    color: var(--ink);
    font-family: 'Jost', sans-serif;
  }
  .jl-care__container {
    max-width: 800px;
    margin: 0 auto;
  }
  .jl-care__header {
    text-align: center;
    margin-bottom: 48px;
  }
  .jl-care__subtitle {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--gold);
    font-weight: 500;
    display: block;
    margin-bottom: 8px;
  }
  .jl-care__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(30px, 5vw, 40px);
    font-weight: 400;
    margin: 0;
  }
  .jl-care__accordion {
    border-top: 1px solid var(--line);
  }
  .jl-care__item {
    border-bottom: 1px solid var(--line);
  }
  .jl-care__trigger {
    width: 100%;
    padding: 24px 0;
    background: none;
    border: none;
    text-align: left;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    color: var(--ink);
  }
  .jl-care__item-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 500;
    margin: 0;
  }
  .jl-care__icon {
    width: 18px;
    height: 18px;
    position: relative;
    transition: transform 0.4s ease;
  }
  .jl-care__icon::before,
  .jl-care__icon::after {
    content: '';
    position: absolute;
    background-color: var(--gold);
    transition: transform 0.4s ease;
  }
  .jl-care__icon::before {
    top: 8px;
    left: 0;
    width: 18px;
    height: 1.5px;
  }
  .jl-care__icon::after {
    top: 0;
    left: 8px;
    width: 1.5px;
    height: 18px;
  }
  .jl-care__item.is-active .jl-care__icon {
    transform: rotate(135deg);
  }
  .jl-care__content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .jl-care__content-inner {
    padding-bottom: 24px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }
  .jl-care__content-inner p {
    margin: 0 0 12px 0;
  }
  .jl-care__content-inner p:last-child {
    margin-bottom: 0;
  }
</style>

<section class="jl-care" id="jl-care-{{ section.id }}">
  <div class="jl-care__container">
    <div class="jl-care__header">
      <span class="jl-care__subtitle">{{ section.settings.subtitle }}</span>
      <h2 class="jl-care__title">{{ section.settings.title }}</h2>
    </div>

    <div class="jl-care__accordion">
      <div class="jl-care__item">
        <button class="jl-care__trigger" type="button" aria-expanded="false">
          <h3 class="jl-care__item-title">Gold & Precious Metals</h3>
          <span class="jl-care__icon"></span>
        </button>
        <div class="jl-care__content">
          <div class="jl-care__content-inner">
            <p>To preserve the warm glow of gold, clean it gently with warm water, mild soap, and a soft-bristled brush. Avoid exposing your gold jewellery to harsh chemicals, chlorine, and bleach.</p>
            <p>Store your pieces in separate compartments or lint-free pouches to prevent scratches and friction.</p>
          </div>
        </div>
      </div>

      <div class="jl-care__item">
        <button class="jl-care__trigger" type="button" aria-expanded="false">
          <h3 class="jl-care__item-title">Diamond Brilliance</h3>
          <span class="jl-care__icon"></span>
        </button>
        <div class="jl-care__content">
          <div class="jl-care__content-inner">
            <p>While diamonds are the hardest natural substance, they can still collect dust and oils. Clean them using a solution of warm water and ammonia-free dish detergent to restore their fire.</p>
            <p>We recommend getting your diamond settings professionally inspected every six months to ensure the prongs remain secure.</p>
          </div>
        </div>
      </div>

      <div class="jl-care__item">
        <button class="jl-care__trigger" type="button" aria-expanded="false">
          <h3 class="jl-care__item-title">Delicate Gemstones</h3>
          <span class="jl-care__icon"></span>
        </button>
        <div class="jl-care__content">
          <div class="jl-care__content-inner">
            <p>Gemstones like emeralds, pearls, and tanzanites are organic and porous. Never submerge them in water or place them in ultrasonic cleaners.</p>
            <p>Simply wipe them down with a dry or lightly damp lint-free cloth after wear, and keep them away from perfumes, hairsprays, and cosmetics.</p>
          </div>
        </div>
      </div>

      <div class="jl-care__item">
        <button class="jl-care__trigger" type="button" aria-expanded="false">
          <h3 class="jl-care__item-title">Lifetime Care & Hallmarks</h3>
          <span class="jl-care__icon"></span>
        </button>
        <div class="jl-care__content">
          <div class="jl-care__content-inner">
            <p>Every piece is certified and BIS hallmarked. We offer complimentary inspection, resizing, and ultrasonic cleaning services for all our heirloom designs.</p>
            <p>Please contact our concierge desk to arrange a secure pick-up for resizing or detailing work.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const items = document.querySelectorAll(".jl-care__item");

    items.forEach(item => {
      const trigger = item.querySelector(".jl-care__trigger");
      const content = item.querySelector(".jl-care__content");

      if (trigger && content) {
        trigger.addEventListener("click", () => {
          const isActive = item.classList.contains("is-active");

          // Close all open items
          items.forEach(otherItem => {
            otherItem.classList.remove("is-active");
            otherItem.querySelector(".jl-care__trigger").setAttribute("aria-expanded", "false");
            otherItem.querySelector(".jl-care__content").style.maxHeight = null;
          });

          // Toggle current
          if (!isActive) {
            item.classList.add("is-active");
            trigger.setAttribute("aria-expanded", "true");
            content.style.maxHeight = content.scrollHeight + "px";
          }
        });
      }
    });
  });
</script>

{% schema %}
{
  "name": "Jewellery Care Guide",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Preserving Eternal Beauty"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Jewellery Care Guide"
    }
  ],
  "presets": [
    {
      "name": "Jewellery Care Guide"
    }
  ]
}
{% endschema %}
