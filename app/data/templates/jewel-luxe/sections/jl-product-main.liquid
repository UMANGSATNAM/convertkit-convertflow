<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600&family=Jost:wght@300;400;500;600&display=swap');

  .jl-product-section {
    --ivory: #f7f3ec;
    --paper: #fdfbf7;
    --ink: #1c1a17;
    --gold: #a8884f;
    --gold-soft: #c9b489;
    --line: #e4ddd0;
    --muted: #8b8479;

    background-color: var(--paper);
    color: var(--ink);
    font-family: 'Jost', sans-serif;
    padding: 60px 0;
  }
  .jl-product-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 5%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 992px) {
    .jl-product-container {
      grid-template-columns: 1.1fr 1fr;
      gap: 70px;
    }
  }

  /* Left Side: Gallery */
  .jl-gallery {
    position: sticky;
    top: 40px;
    height: max-content;
  }
  .jl-gallery__main-wrapper {
    position: relative;
    border: 1px solid var(--line);
    background-color: var(--ivory);
    overflow: hidden;
    margin-bottom: 16px;
    cursor: zoom-in;
  }
  .jl-gallery__main-image {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.5s ease;
  }
  .jl-gallery__main-image:hover {
    transform: scale(1.06);
  }
  .jl-gallery__thumbnails {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .jl-gallery__thumb {
    border: 1px solid var(--line);
    background-color: var(--ivory);
    cursor: pointer;
    padding: 4px;
    transition: border-color 0.3s ease;
  }
  .jl-gallery__thumb.is-active,
  .jl-gallery__thumb:hover {
    border-color: var(--gold);
  }
  .jl-gallery__thumb img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* Right Side: Product Details */
  .jl-info {
    display: flex;
    flex-direction: column;
  }
  .jl-info__vendor {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--gold);
    font-weight: 500;
    margin-bottom: 12px;
  }
  .jl-info__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 16px 0;
  }
  .jl-info__price-box {
    margin-bottom: 24px;
  }
  .jl-info__price {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 4px;
  }
  .jl-info__price s {
    font-size: 18px;
    color: var(--muted);
  }
  .jl-info__tax-note {
    font-size: 12px;
    color: var(--muted);
    font-style: italic;
  }
  
  /* Variant Swatches & Selectors */
  .jl-option {
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 20px;
  }
  .jl-option__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .jl-option__label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 500;
  }
  .jl-option__value {
    font-size: 13px;
    color: var(--muted);
  }
  .jl-option__sizeguide {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--gold);
    text-decoration: underline;
    cursor: pointer;
  }
  
  /* Metal Round Swatches */
  .jl-swatches {
    display: flex;
    gap: 12px;
  }
  .jl-swatch {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    border: 2px solid transparent;
    padding: 2px;
    transition: all 0.3s ease;
  }
  .jl-swatch.is-selected {
    border-color: var(--gold);
  }
  .jl-swatch__inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }
  
  /* Size Grid Buttons */
  .jl-sizes {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }
  .jl-size-btn {
    background-color: var(--paper);
    border: 1px solid var(--line);
    padding: 10px 0;
    text-align: center;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .jl-size-btn:hover,
  .jl-size-btn.is-selected {
    border-color: var(--gold);
  }
  .jl-size-btn.is-selected {
    outline: 1px solid var(--gold);
    background-color: var(--ivory);
  }
  
  /* Actions */
  .jl-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 32px;
  }
  .jl-actions__buttons {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 12px;
  }
  .jl-btn {
    padding: 14px 20px;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 0;
  }
  .jl-btn--primary {
    background-color: var(--ink);
    color: #ffffff;
    border: none;
  }
  .jl-btn--primary:hover {
    background-color: var(--gold);
  }
  .jl-btn--whatsapp {
    background-color: var(--paper);
    border: 1px solid var(--gold);
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .jl-btn--whatsapp:hover {
    background-color: var(--ivory);
  }
  .jl-btn--whatsapp svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }
  .jl-actions__cod-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--gold);
    font-weight: 500;
    letter-spacing: 0.5px;
  }
  .jl-actions__cod-badge svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  /* Pincode Serviceability Checker */
  .jl-pincode {
    border: 1px solid var(--line);
    background-color: var(--ivory);
    padding: 20px;
    margin-bottom: 32px;
  }
  .jl-pincode__title {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 500;
    margin: 0 0 10px 0;
  }
  .jl-pincode__form {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
  }
  .jl-pincode__input {
    flex-grow: 1;
    padding: 10px 12px;
    background-color: var(--paper);
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 13px;
    outline: none;
  }
  .jl-pincode__input:focus {
    border-color: var(--gold);
  }
  .jl-pincode__btn {
    background-color: var(--ink);
    color: #ffffff;
    border: none;
    padding: 0 20px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }
  .jl-pincode__btn:hover {
    background-color: var(--gold);
  }
  .jl-pincode__result {
    font-size: 12px;
    line-height: 1.4;
    display: none;
  }
  .jl-pincode__result.is-success {
    color: #2e7d32;
  }
  .jl-pincode__result.is-error {
    color: #c62828;
  }

  /* GIA/BIS Trust Badges */
  .jl-trust {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 32px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 20px 0;
  }
  .jl-trust__item {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .jl-trust__icon {
    width: 24px;
    height: 24px;
    margin-bottom: 8px;
    color: var(--gold);
  }
  .jl-trust__icon svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
  }
  .jl-trust__text {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 500;
  }

  /* Accordion Details */
  .jl-accordion {
    border-top: 1px solid var(--line);
  }
  .jl-accordion__item {
    border-bottom: 1px solid var(--line);
  }
  .jl-accordion__trigger {
    width: 100%;
    padding: 16px 0;
    background: none;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-family: inherit;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 500;
    color: var(--ink);
  }
  .jl-accordion__icon {
    width: 12px;
    height: 12px;
    position: relative;
    transition: transform 0.3s ease;
  }
  .jl-accordion__icon::before,
  .jl-accordion__icon::after {
    content: '';
    position: absolute;
    background-color: var(--gold);
  }
  .jl-accordion__icon::before {
    top: 5px;
    left: 0;
    width: 12px;
    height: 1.5px;
  }
  .jl-accordion__icon::after {
    top: 0;
    left: 5px;
    width: 1.5px;
    height: 12px;
    transition: transform 0.3s ease;
  }
  .jl-accordion__item.is-active .jl-accordion__icon::after {
    transform: scaleY(0);
  }
  .jl-accordion__content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
  }
  .jl-accordion__content-inner {
    padding-bottom: 16px;
  }
</style>

<section class="jl-product-section" id="jl-product-{{ section.id }}">
  <div class="jl-product-container">
    <!-- LEFT: Gallery -->
    <div class="jl-gallery">
      <div class="jl-gallery__main-wrapper">
        {% if product.featured_image %}
          <img class="jl-gallery__main-image" id="main-image-{{ section.id }}" src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.title }}">
        {% else %}
          <div style="width:100%; aspect-ratio:1; background-color:var(--ivory); display:flex; align-items:center; justify-content:center;">
            <span style="font-size:12px; text-transform:uppercase; letter-spacing:2px; color:var(--gold);">Lumière Studio</span>
          </div>
        {% endif %}
      </div>
      
      {% if product.images.size > 1 %}
        <div class="jl-gallery__thumbnails">
          {% for image in product.images limit: 4 %}
            <div class="jl-gallery__thumb {% if forloop.first %}is-active{% endif %}" data-src="{{ image | img_url: '800x' }}">
              <img src="{{ image | img_url: '200x' }}" alt="{{ product.title }}">
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- RIGHT: Info Details -->
    <div class="jl-info">
      <span class="jl-info__vendor">{{ product.vendor | default: "Lumière Atelier" }}</span>
      <h1 class="jl-info__title">{{ product.title | default: "The Solitaire Diamond Ring" }}</h1>
      
      <div class="jl-info__price-box">
        <div class="jl-info__price">
          {% if product %}
            {{ product.selected_or_first_available_variant.price | money }}
            {% if product.compare_at_price > product.price %}
              <s>{{ product.compare_at_price | money }}</s>
            {% endif %}
          {% else %}
            ₹1,45,000 s<s>₹1,75,000</s>
          {% endif %}
        </div>
        <span class="jl-info__tax-note">Inclusive of all GST & domestic duties</span>
      </div>

      <!-- Metal Customization swatch -->
      <div class="jl-option">
        <div class="jl-option__header">
          <span class="jl-option__label">Metal Finish</span>
          <span class="jl-option__value" id="selected-metal-{{ section.id }}">18k Yellow Gold</span>
        </div>
        <div class="jl-swatches">
          <div class="jl-swatch is-selected" data-metal="18k Yellow Gold">
            <div class="jl-swatch__inner" style="background-color: #e6c9a8;"></div>
          </div>
          <div class="jl-swatch" data-metal="18k Rose Gold">
            <div class="jl-swatch__inner" style="background-color: #eab49f;"></div>
          </div>
          <div class="jl-swatch" data-metal="18k White Gold">
            <div class="jl-swatch__inner" style="background-color: #e2e4e1;"></div>
          </div>
        </div>
      </div>

      <!-- Ring Size Button Grid -->
      <div class="jl-option">
        <div class="jl-option__header">
          <span class="jl-option__label">Ring Size (UK)</span>
          <span class="jl-option__sizeguide">Size Guide</span>
        </div>
        <div class="jl-sizes">
          <div class="jl-size-btn is-selected" data-size="9">9</div>
          <div class="jl-size-btn" data-size="10">10</div>
          <div class="jl-size-btn" data-size="11">11</div>
          <div class="jl-size-btn" data-size="12">12</div>
          <div class="jl-size-btn" data-size="13">13</div>
        </div>
      </div>

      <!-- Buy & Share Actions -->
      <div class="jl-actions">
        <div class="jl-actions__buttons">
          <button type="button" class="jl-btn jl-btn--primary">Add to Bag</button>
          
          <a href="https://wa.me/919999999999?text=Hi,%20I'm%20interested%20in%20the%20Lumiere%20Fine%20Jewellery%20Solitaire%20Ring" class="jl-btn jl-btn--whatsapp" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24">
              <path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984a9.96 9.96 0 0 0 1.333 4.982L2 22l5.233-1.371a9.924 9.924 0 0 0 4.777 1.22h.005c5.507 0 9.991-4.478 9.992-9.986 0-2.67-1.037-5.178-2.924-7.065A9.925 9.925 0 0 0 12.012 2zm5.834 14.17c-.254.715-1.472 1.393-2.015 1.482-.49.08-1.129.138-3.239-.743-2.697-1.125-4.417-3.87-4.551-4.05-.134-.18-1.002-1.34-1.002-2.553 0-1.213.623-1.81.846-2.055.223-.246.49-.308.654-.308.163 0 .326.002.468.008.148.006.347-.056.543.418.2.484.686 1.674.747 1.797.06.123.1.267.018.43-.082.163-.123.267-.245.41-.122.143-.258.32-.367.43-.123.123-.25.257-.107.502.143.245.635 1.05 1.363 1.697.937.834 1.728 1.093 1.973 1.216.246.123.388.102.532-.061.144-.163.623-.728.788-.973.165-.246.33-.205.556-.123.227.082 1.436.677 1.681.8.246.123.41.184.47.287.06.102.06.594-.194 1.309z"/>
            </svg>
            Enquire
          </a>
        </div>
        
        <div class="jl-actions__cod-badge">
          <svg viewBox="0 0 24 24"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM11 7h2v6h-2V7zm0 8h2v2h-2v-2z"/></svg>
          Cash on Delivery (COD) Available
        </div>
      </div>

      <!-- PINcode Serviceability Checker -->
      <div class="jl-pincode">
        <h3 class="jl-pincode__title">Check Delivery Serviceability</h3>
        <div class="jl-pincode__form">
          <input type="text" class="jl-pincode__input" id="pincode-input-{{ section.id }}" placeholder="Enter 6-digit Pincode" maxlength="6">
          <button type="button" class="jl-pincode__btn" id="pincode-btn-{{ section.id }}">Check</button>
        </div>
        <div class="jl-pincode__result" id="pincode-result-{{ section.id }}"></div>
      </div>

      <!-- Trust Badges -->
      <div class="jl-trust">
        <div class="jl-trust__item">
          <div class="jl-trust__icon">
            <svg viewBox="0 0 24 24" stroke-width="1.5"><polygon points="12 2 15 8.5 22 9.5 17 14 18.5 21 12 17.5 5.5 21 7 14 2 9.5 9 8.5 12 2"/></svg>
          </div>
          <span class="jl-trust__text">GIA Certified</span>
        </div>
        
        <div class="jl-trust__item">
          <div class="jl-trust__icon">
            <svg viewBox="0 0 24 24" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <span class="jl-trust__text">BIS Hallmarked</span>
        </div>
        
        <div class="jl-trust__item">
          <div class="jl-trust__icon">
            <svg viewBox="0 0 24 24" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <span class="jl-trust__text">Lifetime Care</span>
        </div>
      </div>

      <!-- Product Description / Details / Returns Accordion -->
      <div class="jl-accordion">
        <div class="jl-accordion__item">
          <button class="jl-accordion__trigger" type="button">
            <span>The Details</span>
            <span class="jl-accordion__icon"></span>
          </button>
          <div class="jl-accordion__content">
            <div class="jl-accordion__content-inner">
              <p>Carat Weight: 1.05ct · Color Grade: F · Clarity: VVS1. Certified conflict-free natural diamond. Set in BIS-hallmarked 18k solid gold.</p>
            </div>
          </div>
        </div>

        <div class="jl-accordion__item">
          <button class="jl-accordion__trigger" type="button">
            <span>Shipping & Insured Transit</span>
            <span class="jl-accordion__icon"></span>
          </button>
          <div class="jl-accordion__content">
            <div class="jl-accordion__content-inner">
              <p>Complimentary fully-insured express shipping across India. Every parcel is hand-delivered in a secure tamper-proof metal box wrapper.</p>
            </div>
          </div>
        </div>

        <div class="jl-accordion__item">
          <button class="jl-accordion__trigger" type="button">
            <span>Returns & Lifetime Care</span>
            <span class="jl-accordion__icon"></span>
          </button>
          <div class="jl-accordion__content">
            <div class="jl-accordion__content-inner">
              <p>14-day complimentary returns. We offer a lifetime buyback and exchange policy along with free annual polishing, resizing, and detailing services.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const mainImg = document.getElementById("main-image-{{ section.id }}");
    const thumbs = document.querySelectorAll("#jl-product-{{ section.id }} .jl-gallery__thumb");
    const swatches = document.querySelectorAll("#jl-product-{{ section.id }} .jl-swatch");
    const selectedMetalText = document.getElementById("selected-metal-{{ section.id }}");
    const sizeBtns = document.querySelectorAll("#jl-product-{{ section.id }} .jl-size-btn");
    
    // Thumbnail Swapping
    thumbs.forEach(thumb => {
      thumb.addEventListener("click", () => {
        thumbs.forEach(x => x.classList.remove("is-active"));
        thumb.classList.add("is-active");
        if (mainImg) {
          mainImg.src = thumb.getAttribute("data-src");
        }
      });
    });

    // Metal Swatch Selection
    swatches.forEach(swatch => {
      swatch.addEventListener("click", () => {
        swatches.forEach(x => x.classList.remove("is-selected"));
        swatch.classList.add("is-selected");
        const metal = swatch.getAttribute("data-metal");
        if (selectedMetalText) {
          selectedMetalText.textContent = metal;
        }
      });
    });

    // Size Selection
    sizeBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        sizeBtns.forEach(x => x.classList.remove("is-selected"));
        btn.classList.add("is-selected");
      });
    });

    // Pincode Checker JS logic
    const pinBtn = document.getElementById("pincode-btn-{{ section.id }}");
    const pinInput = document.getElementById("pincode-input-{{ section.id }}");
    const pinResult = document.getElementById("pincode-result-{{ section.id }}");

    if (pinBtn && pinInput && pinResult) {
      pinBtn.addEventListener("click", () => {
        const val = pinInput.value.trim();
        if (/^\d{6}$/.test(val)) {
          pinResult.style.display = "block";
          pinResult.className = "jl-pincode__result is-success";
          pinResult.innerHTML = "✓ Delivery available in 2-4 days (COD Available)";
        } else {
          pinResult.style.display = "block";
          pinResult.className = "jl-pincode__result is-error";
          pinResult.innerHTML = "Please enter a valid 6-digit Pincode.";
        }
      });
    }

    // Collapsible Accordions
    const accordionTriggers = document.querySelectorAll("#jl-product-{{ section.id }} .jl-accordion__trigger");
    accordionTriggers.forEach(trigger => {
      trigger.addEventListener("click", () => {
        const item = trigger.closest(".jl-accordion__item");
        const content = item.querySelector(".jl-accordion__content");
        const isOpen = item.classList.contains("is-active");

        // Close all
        document.querySelectorAll("#jl-product-{{ section.id }} .jl-accordion__item").forEach(otherItem => {
          otherItem.classList.remove("is-active");
          otherItem.querySelector(".jl-accordion__content").style.maxHeight = null;
        });

        // Toggle current
        if (!isOpen) {
          item.classList.add("is-active");
          content.style.maxHeight = content.scrollHeight + "px";
        }
      });
    });
  });
</script>

