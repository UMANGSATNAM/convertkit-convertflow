<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600&family=Jost:wght@300;400;500&display=swap');

  .jl-booking {
    --ivory: #f7f3ec;
    --paper: #fdfbf7;
    --ink: #1c1a17;
    --gold: #a8884f;
    --gold-soft: #c9b489;
    --line: #e4ddd0;
    --muted: #8b8479;

    padding: 85px 5%;
    background-color: var(--paper);
    color: var(--ink);
    font-family: 'Jost', sans-serif;
  }
  .jl-booking__container {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 768px) {
    .jl-booking__container {
      grid-template-columns: 1fr 1.2fr;
      gap: 60px;
    }
  }
  .jl-booking__details {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .jl-booking__subtitle {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--gold);
    font-weight: 500;
    display: block;
    margin-bottom: 8px;
  }
  .jl-booking__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 400;
    margin: 0 0 16px 0;
    line-height: 1.2;
  }
  .jl-booking__desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 24px;
  }
  .jl-booking__card {
    background-color: var(--ivory);
    border: 1px solid var(--line);
    padding: 32px;
  }
  .jl-booking__step-title {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 500;
    margin-bottom: 12px;
    display: block;
    color: var(--ink);
  }
  .jl-booking__dates {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 24px;
  }
  .jl-booking__date-btn {
    background-color: var(--paper);
    border: 1px solid var(--line);
    padding: 12px 6px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .jl-booking__date-btn:hover,
  .jl-booking__date-btn.is-selected {
    border-color: var(--gold);
    background-color: var(--ivory);
  }
  .jl-booking__date-btn.is-selected {
    outline: 1px solid var(--gold);
  }
  .jl-booking__date-day {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--muted);
    display: block;
    margin-bottom: 4px;
  }
  .jl-booking__date-num {
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
  }
  .jl-booking__slots {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 32px;
  }
  .jl-booking__slot-btn {
    background-color: var(--paper);
    border: 1px solid var(--line);
    padding: 12px;
    font-size: 13px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: var(--ink);
  }
  .jl-booking__slot-btn:hover,
  .jl-booking__slot-btn.is-selected {
    border-color: var(--gold);
  }
  .jl-booking__slot-btn.is-selected {
    outline: 1px solid var(--gold);
    background-color: var(--ivory);
  }
  .jl-booking__action {
    width: 100%;
    background-color: var(--ink);
    color: #ffffff;
    border: none;
    padding: 14px 0;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .jl-booking__action:hover {
    background-color: var(--gold);
  }
  .jl-booking__success {
    display: none;
    text-align: center;
    padding: 40px 0;
  }
  .jl-booking__success-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    margin-bottom: 12px;
    color: var(--gold);
  }
  .jl-booking__success-desc {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
  }
</style>

<section class="jl-booking" id="jl-booking-{{ section.id }}">
  <div class="jl-booking__container">
    <div class="jl-booking__details">
      <span class="jl-booking__subtitle">{{ section.settings.subtitle }}</span>
      <h2 class="jl-booking__title">{{ section.settings.title }}</h2>
      <p class="jl-booking__desc">{{ section.settings.description }}</p>
    </div>

    <div class="jl-booking__card">
      <div id="booking-form-{{ section.id }}">
        <span class="jl-booking__step-title">1. Select Date</span>
        <div class="jl-booking__dates">
          <div class="jl-booking__date-btn is-selected" data-date="June 10">
            <span class="jl-booking__date-day">Wed</span>
            <span class="jl-booking__date-num">10</span>
          </div>
          <div class="jl-booking__date-btn" data-date="June 11">
            <span class="jl-booking__date-day">Thu</span>
            <span class="jl-booking__date-num">11</span>
          </div>
          <div class="jl-booking__date-btn" data-date="June 12">
            <span class="jl-booking__date-day">Fri</span>
            <span class="jl-booking__date-num">12</span>
          </div>
          <div class="jl-booking__date-btn" data-date="June 13">
            <span class="jl-booking__date-day">Sat</span>
            <span class="jl-booking__date-num">13</span>
          </div>
        </div>

        <span class="jl-booking__step-title">2. Select Slot</span>
        <div class="jl-booking__slots">
          <div class="jl-booking__slot-btn is-selected" data-time="11:00 AM">11:00 AM - 12:00 PM</div>
          <div class="jl-booking__slot-btn" data-time="2:00 PM">02:00 PM - 03:00 PM</div>
          <div class="jl-booking__slot-btn" data-time="4:00 PM">04:00 PM - 05:00 PM</div>
          <div class="jl-booking__slot-btn" data-time="6:00 PM">06:00 PM - 07:00 PM</div>
        </div>

        <button type="button" class="jl-booking__action" id="book-btn-{{ section.id }}">Book Virtual Try-On</button>
      </div>

      <div class="jl-booking__success" id="booking-success-{{ section.id }}">
        <div class="jl-booking__success-title">Concierge Try-on Reserved</div>
        <p class="jl-booking__success-desc">
          Your appointment is scheduled for <strong id="summary-date-{{ section.id }}">June 10</strong> at <strong id="summary-time-{{ section.id }}">11:00 AM</strong>. A secure luxury virtual consultation invite link has been sent to your email.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const dates = document.querySelectorAll("#jl-booking-{{ section.id }} .jl-booking__date-btn");
    const slots = document.querySelectorAll("#jl-booking-{{ section.id }} .jl-booking__slot-btn");
    const bookBtn = document.getElementById("book-btn-{{ section.id }}");
    const form = document.getElementById("booking-form-{{ section.id }}");
    const success = document.getElementById("booking-success-{{ section.id }}");
    
    const summaryDate = document.getElementById("summary-date-{{ section.id }}");
    const summaryTime = document.getElementById("summary-time-{{ section.id }}");

    let selectedDate = "June 10";
    let selectedTime = "11:00 AM";

    dates.forEach(d => {
      d.addEventListener("click", () => {
        dates.forEach(x => x.classList.remove("is-selected"));
        d.classList.add("is-selected");
        selectedDate = d.getAttribute("data-date");
      });
    });

    slots.forEach(s => {
      s.addEventListener("click", () => {
        slots.forEach(x => x.classList.remove("is-selected"));
        s.classList.add("is-selected");
        selectedTime = s.getAttribute("data-time");
      });
    });

    if (bookBtn) {
      bookBtn.addEventListener("click", () => {
        summaryDate.textContent = selectedDate;
        summaryTime.textContent = selectedTime;
        form.style.display = "none";
        success.style.display = "block";
      });
    }
  });
</script>

{% schema %}
{
  "name": "Appointment Booking",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Book a Virtual Try-On"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Concierge Try-on"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Consult with a quiet-luxury design specialist from the comfort of your home. View live detail macro shots, discuss diamond clarity configurations, and find your perfect ring sizing."
    }
  ],
  "presets": [
    {
      "name": "Appointment Booking"
    }
  ]
}
{% endschema %}
