<style>
  .jl-sidebar { padding: 60px 40px 60px 0; border-right: 1px solid #1a1a1a; }
  .jl-sidebar__group { margin-bottom: 40px; }
  .jl-sidebar__title { font-family: 'Cinzel', serif; font-size: 16px; font-weight: 400; color: #fff; margin-bottom: 20px; letter-spacing: 1px; }
  .jl-sidebar__list { list-style: none; padding: 0; margin: 0; }
  .jl-sidebar__item { margin-bottom: 15px; }
  .jl-sidebar__label { display: flex; align-items: center; gap: 15px; font-family: 'Montserrat', sans-serif; font-size: 13px; color: #999; cursor: pointer; transition: color 0.3s; }
  .jl-sidebar__label:hover { color: #d4af37; }
  .jl-sidebar__checkbox { appearance: none; width: 14px; height: 14px; border: 1px solid #444; background: #000; outline: none; cursor: pointer; transition: all 0.3s; position: relative; border-radius: 50%; }
  .jl-sidebar__checkbox:checked { border-color: #d4af37; }
  .jl-sidebar__checkbox:checked::after { content: ''; position: absolute; top: 3px; left: 3px; width: 6px; height: 6px; background: #d4af37; border-radius: 50%; }
</style>
<aside class="jl-sidebar">
  <div class="jl-sidebar__group">
    <div class="jl-sidebar__title">Metal</div>
    <ul class="jl-sidebar__list">
      <li class="jl-sidebar__item"><label class="jl-sidebar__label"><input type="checkbox" class="jl-sidebar__checkbox"> Yellow Gold</label></li>
      <li class="jl-sidebar__item"><label class="jl-sidebar__label"><input type="checkbox" class="jl-sidebar__checkbox"> White Gold</label></li>
      <li class="jl-sidebar__item"><label class="jl-sidebar__label"><input type="checkbox" class="jl-sidebar__checkbox"> Rose Gold</label></li>
      <li class="jl-sidebar__item"><label class="jl-sidebar__label"><input type="checkbox" class="jl-sidebar__checkbox"> Platinum</label></li>
    </ul>
  </div>
  <div class="jl-sidebar__group">
    <div class="jl-sidebar__title">Gemstone</div>
    <ul class="jl-sidebar__list">
      <li class="jl-sidebar__item"><label class="jl-sidebar__label"><input type="checkbox" class="jl-sidebar__checkbox"> Diamond</label></li>
      <li class="jl-sidebar__item"><label class="jl-sidebar__label"><input type="checkbox" class="jl-sidebar__checkbox"> Sapphire</label></li>
      <li class="jl-sidebar__item"><label class="jl-sidebar__label"><input type="checkbox" class="jl-sidebar__checkbox"> Ruby</label></li>
      <li class="jl-sidebar__item"><label class="jl-sidebar__label"><input type="checkbox" class="jl-sidebar__checkbox"> Emerald</label></li>
    </ul>
  </div>
</aside>
{% schema %}
{ "name": "JL Filter Sidebar", "tag": "section", "settings": [], "presets": [{ "name": "JL Filter Sidebar" }] }
{% endschema %}
