<style>
  .jl-drawer-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(5, 5, 5, 0.9); z-index: 999; opacity: 0; visibility: hidden; transition: all 0.4s ease; backdrop-filter: blur(10px); }
  .jl-drawer-overlay.active { opacity: 1; visibility: visible; }
  .jl-drawer { position: fixed; top: 0; right: -450px; width: 450px; max-width: 100vw; height: 100%; background: #0a0a0a; border-left: 1px solid #1a1a1a; z-index: 1000; transition: right 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); display: flex; flex-direction: column; }
  .jl-drawer.active { right: 0; }
  .jl-drawer__header { display: flex; justify-content: space-between; align-items: center; padding: 40px; border-bottom: 1px solid #1a1a1a; }
  .jl-drawer__title { font-family: 'Cinzel', serif; font-size: 20px; font-weight: 400; color: #fff; margin: 0; letter-spacing: 2px; }
  .jl-drawer__close { background: none; border: none; color: #666; width: 30px; height: 30px; cursor: pointer; font-size: 24px; display: flex; align-items: center; justify-content: center; font-weight: 300; transition: color 0.3s; }
  .jl-drawer__close:hover { color: #d4af37; }
  .jl-drawer__body { flex: 1; overflow-y: auto; padding: 40px; }
  .jl-drawer__empty { text-align: center; padding: 80px 20px; color: #666; font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 400; text-transform: uppercase; letter-spacing: 3px; }
  .jl-drawer__item { display: flex; gap: 20px; padding: 25px 0; border-bottom: 1px solid #111; }
  .jl-drawer__item-img { width: 80px; height: 80px; object-fit: cover; background: #111; border: 1px solid #222; }
  .jl-drawer__item-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
  .jl-drawer__item-name { font-family: 'Cinzel', serif; font-size: 14px; font-weight: 400; color: #fff; margin-bottom: 5px; }
  .jl-drawer__item-price { font-family: 'Montserrat', sans-serif; font-size: 13px; font-weight: 300; color: #d4af37; margin-bottom: 15px; }
  .jl-drawer__item-qty { display: flex; align-items: center; border: 1px solid #222; width: fit-content; }
  .jl-drawer__qty-btn { width: 25px; height: 25px; background: none; border: none; color: #999; cursor: pointer; font-size: 14px; display: flex; align-items: center; justify-content: center; transition: color 0.3s; }
  .jl-drawer__qty-btn:hover { color: #fff; }
  .jl-drawer__qty-val { font-family: 'Montserrat', sans-serif; font-size: 12px; color: #fff; min-width: 25px; text-align: center; }
  .jl-drawer__footer { padding: 40px; background: #050505; border-top: 1px solid #1a1a1a; }
  .jl-drawer__total { display: flex; justify-content: space-between; margin-bottom: 30px; align-items: center; }
  .jl-drawer__total-label { font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 500; color: #999; text-transform: uppercase; letter-spacing: 2px; }
  .jl-drawer__total-value { font-family: 'Cinzel', serif; font-size: 24px; font-weight: 400; color: #fff; }
  .jl-drawer__checkout { display: block; width: 100%; padding: 20px; background: #d4af37; color: #000; border: none; font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 3px; cursor: pointer; text-align: center; text-decoration: none; transition: opacity 0.3s; }
  .jl-drawer__checkout:hover { opacity: 0.9; }
</style>
<div class="jl-drawer-overlay" id="jl-cart-overlay" onclick="document.getElementById('jl-cart-drawer').classList.remove('active'); this.classList.remove('active');"></div>
<aside class="jl-drawer" id="jl-cart-drawer">
  <div class="jl-drawer__header">
    <h3 class="jl-drawer__title">Shopping Bag</h3>
    <button class="jl-drawer__close" onclick="document.getElementById('jl-cart-drawer').classList.remove('active'); document.getElementById('jl-cart-overlay').classList.remove('active');">✕</button>
  </div>
  <div class="jl-drawer__body">
    {% if cart.item_count == 0 %}
      <div class="jl-drawer__empty">Your bag is empty.</div>
    {% else %}
      {% for item in cart.items %}
        <div class="jl-drawer__item">
          <img class="jl-drawer__item-img" src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}">
          <div class="jl-drawer__item-info">
            <div>
              <div class="jl-drawer__item-name">{{ item.product.title }}</div>
              <div class="jl-drawer__item-price">{{ item.final_line_price | money }}</div>
            </div>
            <div class="jl-drawer__item-qty">
              <button class="jl-drawer__qty-btn">−</button>
              <span class="jl-drawer__qty-val">{{ item.quantity }}</span>
              <button class="jl-drawer__qty-btn">+</button>
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
  {% if cart.item_count > 0 %}
    <div class="jl-drawer__footer">
      <div class="jl-drawer__total">
        <span class="jl-drawer__total-label">Subtotal</span>
        <span class="jl-drawer__total-value">{{ cart.total_price | money }}</span>
      </div>
      <a href="/checkout" class="jl-drawer__checkout">Secure Checkout</a>
    </div>
  {% endif %}
</aside>
{% schema %}
{ "name": "JL Drawer Cart", "tag": "section", "settings": [], "presets": [{ "name": "JL Drawer Cart" }] }
{% endschema %}
