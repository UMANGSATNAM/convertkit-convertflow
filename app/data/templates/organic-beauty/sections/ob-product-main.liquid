<script>
  document.addEventListener("DOMContentLoaded", function() {
    const pdp = document.getElementById("ob-pdp-{{ section.id }}");
    if (!pdp) return;

    // Gallery switching
    const mainImage = pdp.querySelector("#main-image-{{ section.id }}");
    const thumbs = pdp.querySelectorAll(".ob-pdp__thumb");

    thumbs.forEach(thumb => {
      thumb.addEventListener("click", () => {
        const url = thumb.getAttribute("data-url");
        thumbs.forEach(t => t.classList.remove("is-active"));
        thumb.classList.add("is-active");

        if (url && url !== "mock-1" && url !== "mock-2" && url !== "mock-3") {
          mainImage.src = url;
        }
      });
    });

    // Variant pricing updates
    const sizePills = pdp.querySelectorAll(".ob-pdp__size-pill");
    const priceVal = pdp.getElementById("pdp-price-val-{{ section.id }}");
    const compareVal = pdp.getElementById("pdp-compare-val-{{ section.id }}");
    const otPriceDisplay = pdp.getElementById("ot-price-display-{{ section.id }}");
    const recPriceDisplay = pdp.getElementById("rec-price-display-{{ section.id }}");

    let currentBasePrice = 1250;
    let currentComparePrice = 1490;
    let isSubscribed = false;

    function updatePriceUI() {
      let activePrice = currentBasePrice;
      if (isSubscribed) {
        activePrice = Math.round(currentBasePrice * 0.85); // 15% discount
      }

      priceVal.textContent = `₹${activePrice.toLocaleString("en-IN")}`;
      compareVal.textContent = `₹${currentComparePrice.toLocaleString("en-IN")}`;
      
      // Update radio pricing rows
      otPriceDisplay.textContent = `₹${currentBasePrice.toLocaleString("en-IN")}`;
      recPriceDisplay.textContent = `₹${Math.round(currentBasePrice * 0.85).toLocaleString("en-IN")}`;
    }

    sizePills.forEach(pill => {
      pill.addEventListener("click", () => {
        sizePills.forEach(p => p.classList.remove("is-active"));
        pill.classList.add("is-active");

        currentBasePrice = parseFloat(pill.getAttribute("data-price"));
        currentComparePrice = parseFloat(pill.getAttribute("data-compare"));

        updatePriceUI();
      });
    });

    // Subscriptions logic
    const optionOt = pdp.getElementById("sub-one-time-{{ section.id }}");
    const optionRec = pdp.getElementById("sub-recurring-{{ section.id }}");
    const radioOt = pdp.getElementById("radio-ot-{{ section.id }}");
    const radioRec = pdp.getElementById("radio-rec-{{ section.id }}");

    function selectPurchaseType(subscribe) {
      isSubscribed = subscribe;
      if (subscribe) {
        optionOt.classList.remove("is-active");
        optionRec.classList.add("is-active");
        radioOt.checked = false;
        radioRec.checked = true;
      } else {
        optionOt.classList.add("is-active");
        optionRec.classList.remove("is-active");
        radioOt.checked = true;
        radioRec.checked = false;
      }
      updatePriceUI();
    }

    optionOt.addEventListener("click", () => selectPurchaseType(false));
    optionRec.addEventListener("click", () => selectPurchaseType(true));

    // Pincode Checker logic
    const pinBtn = pdp.getElementById("pincode-btn-{{ section.id }}");
    const pinInput = pdp.getElementById("pincode-input-{{ section.id }}");
    const pinResult = pdp.getElementById("pincode-result-{{ section.id }}");

    if (pinBtn && pinInput && pinResult) {
      pinBtn.addEventListener("click", () => {
        const pin = pinInput.value.trim();
        if (/^\d{6}$/.test(pin)) {
          // Indian metros mock
          const prefix = pin.substring(0, 3);
          if (["110", "400", "560", "600", "700", "500"].includes(prefix)) {
            pinResult.className = "ob-pdp__pincode-result is-success";
            pinResult.innerHTML = `
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" style="vertical-align:text-bottom;margin-right:4px;">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
              Express Metro Delivery (2 Days) - COD Available
            `;
          } else {
            pinResult.className = "ob-pdp__pincode-result is-success";
            pinResult.innerHTML = `
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" style="vertical-align:text-bottom;margin-right:4px;">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
              Standard Delivery (4-5 Days) - COD Available
            `;
          }
        } else {
          pinResult.className = "ob-pdp__pincode-result is-error";
          pinResult.textContent = "Please enter a valid 6-digit Pincode.";
        }
      });
    }

    // Accordions
    const accordionBtns = pdp.querySelectorAll(".ob-pdp__accordion-btn");
    accordionBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const content = btn.nextElementSibling;
        const isActive = btn.classList.contains("is-active");

        // Close all
        accordionBtns.forEach(b => {
          b.classList.remove("is-active");
          b.nextElementSibling.style.display = "none";
        });

        // Toggle clicked
        if (!isActive) {
          btn.classList.add("is-active");
          content.style.display = "block";
        }
      });
    });
  });
</script>

