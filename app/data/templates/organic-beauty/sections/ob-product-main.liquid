<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500;600&display=swap');

  .ob-pdp {
    --bg-cream: #f4efe6;
    --brand-sage: #8a9a7b;
    --brand-sage-dark: #707f63;
    --surface-light: #faf8f5;
    --surface-sand: #e9e3d5;
    --text-charcoal: #2d302b;
    --text-muted: #6e726b;
    --border-soft: #dfd8cb;
    --color-error: #c85a54;
    --color-success: #5f8066;

    background-color: var(--bg-cream);
    color: var(--text-charcoal);
    font-family: 'Jost', sans-serif;
    padding: 60px 5%;
  }

  .ob-pdp__container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 768px) {
    .ob-pdp__container {
      grid-template-columns: 1.12fr 1fr;
      gap: 60px;
    }
  }

  /* Gallery CSS */
  .ob-pdp__gallery {
    position: sticky;
    top: 30px;
  }

  .ob-pdp__main-image-wrapper {
    background-color: var(--surface-light);
    border-radius: 24px;
    border: 1px solid var(--border-soft);
    padding: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .ob-pdp__main-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .ob-pdp__thumbnails {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 16px;
  }

  .ob-pdp__thumb {
    background-color: var(--surface-light);
    border-radius: 12px;
    border: 1px solid var(--border-soft);
    padding: 10px;
    cursor: pointer;
    aspect-ratio: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: border-color 0.3s ease;
  }

  .ob-pdp__thumb:hover, .ob-pdp__thumb.is-active {
    border-color: var(--brand-sage);
  }

  .ob-pdp__thumb img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* Info/Buy-Box CSS */
  .ob-pdp__info {
    display: flex;
    flex-direction: column;
  }

  .ob-pdp__vendor {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--brand-sage-dark);
    font-weight: 600;
    margin-bottom: 8px;
  }

  .ob-pdp__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(30px, 4vw, 40px);
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 12px 0;
  }

  /* Ratings */
  .ob-pdp__rating-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    font-size: 13.5px;
    color: var(--text-muted);
  }

  .ob-pdp__stars {
    display: flex;
    gap: 2px;
    color: #caa15a;
  }

  .ob-pdp__stars svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* Price Area */
  .ob-pdp__price-area {
    margin-bottom: 30px;
  }

  .ob-pdp__price-container {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .ob-pdp__price {
    font-size: 26px;
    font-weight: 600;
    color: var(--text-charcoal);
  }

  .ob-pdp__compare-price {
    font-size: 18px;
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .ob-pdp__tax-notice {
    font-size: 12px;
    color: var(--brand-sage-dark);
    margin-top: 4px;
    font-weight: 500;
    letter-spacing: 0.5px;
  }

  /* Variant Size Pills */
  .ob-pdp__option-group {
    margin-bottom: 24px;
  }

  .ob-pdp__option-title {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 600;
    color: var(--text-charcoal);
    margin-bottom: 12px;
    display: block;
  }

  .ob-pdp__size-grid {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .ob-pdp__size-pill {
    background-color: var(--surface-light);
    border: 1.5px solid var(--border-soft);
    padding: 10px 24px;
    font-size: 13.5px;
    font-weight: 500;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ob-pdp__size-pill:hover {
    border-color: var(--brand-sage);
  }

  .ob-pdp__size-pill.is-active {
    background-color: var(--brand-sage);
    color: #ffffff;
    border-color: var(--brand-sage);
  }

  /* Subscribe & Save Panel */
  .ob-pdp__subscription-panel {
    border: 1px solid var(--border-soft);
    border-radius: 20px;
    overflow: hidden;
    background-color: var(--surface-light);
    margin-bottom: 30px;
  }

  .ob-pdp__sub-option {
    padding: 18px 20px;
    display: flex;
    align-items: start;
    gap: 12px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ob-pdp__sub-option:not(:last-child) {
    border-bottom: 1px solid var(--border-soft);
  }

  .ob-pdp__sub-option:hover {
    background-color: var(--surface-sand);
  }

  .ob-pdp__sub-option.is-active {
    background-color: var(--bg-cream);
  }

  .ob-pdp__radio-wrapper {
    margin-top: 2px;
  }

  .ob-pdp__radio {
    appearance: none;
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    border: 1.5px solid var(--border-soft);
    border-radius: 50%;
    outline: none;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
    cursor: pointer;
  }

  .ob-pdp__radio:checked {
    border-color: var(--brand-sage);
  }

  .ob-pdp__radio:checked::after {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--brand-sage);
    display: block;
  }

  .ob-pdp__sub-details {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ob-pdp__sub-label-row {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    font-weight: 500;
  }

  .ob-pdp__sub-discount-text {
    font-size: 12px;
    color: var(--brand-sage-dark);
    font-weight: 600;
    margin-top: 4px;
  }

  .ob-pdp__sub-frequency {
    margin-top: 10px;
    display: none;
  }

  .ob-pdp__sub-option.is-active .ob-pdp__sub-frequency {
    display: block;
  }

  .ob-pdp__sub-select {
    padding: 8px 12px;
    border-radius: 20px;
    border: 1px solid var(--border-soft);
    background-color: var(--surface-light);
    font-size: 12px;
    color: var(--text-charcoal);
    outline: none;
    width: 100%;
    max-width: 220px;
  }

  /* CTAs & Badges */
  .ob-pdp__btn-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 30px;
  }

  .ob-pdp__atc {
    background-color: var(--brand-sage-dark);
    color: #ffffff;
    border: none;
    padding: 16px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .ob-pdp__atc:hover {
    background-color: var(--brand-sage);
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(112, 127, 99, 0.2);
  }

  .ob-pdp__whatsapp {
    background-color: var(--surface-light);
    color: var(--brand-sage-dark);
    border: 1.5px solid var(--brand-sage-dark);
    padding: 14px;
    border-radius: 30px;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
  }

  .ob-pdp__whatsapp:hover {
    background-color: var(--surface-sand);
  }

  .ob-pdp__whatsapp svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  /* COD Badge */
  .ob-pdp__cod-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--surface-sand);
    color: var(--brand-sage-dark);
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    align-self: flex-start;
    margin-bottom: 24px;
    border: 1px solid var(--border-soft);
  }

  .ob-pdp__cod-badge svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* Pincode Checker */
  .ob-pdp__pincode-card {
    border: 1px solid var(--border-soft);
    background-color: var(--surface-light);
    border-radius: 20px;
    padding: 24px;
    margin-bottom: 30px;
  }

  .ob-pdp__pincode-title {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
    color: var(--text-charcoal);
    margin-bottom: 12px;
    display: block;
  }

  .ob-pdp__pincode-form {
    display: flex;
    gap: 10px;
  }

  .ob-pdp__pincode-input {
    flex-grow: 1;
    padding: 10px 16px;
    border-radius: 20px;
    border: 1px solid var(--border-soft);
    background-color: var(--bg-cream);
    font-size: 13.5px;
    outline: none;
    color: var(--text-charcoal);
    transition: border-color 0.3s ease;
  }

  .ob-pdp__pincode-input:focus {
    border-color: var(--brand-sage);
  }

  .ob-pdp__pincode-btn {
    background-color: var(--brand-sage-dark);
    color: #ffffff;
    border: none;
    padding: 10px 24px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ob-pdp__pincode-btn:hover {
    background-color: var(--brand-sage);
  }

  .ob-pdp__pincode-result {
    font-size: 13px;
    margin-top: 10px;
    display: none;
    font-weight: 500;
    animation: ob-fade-in 0.3s ease forwards;
  }

  .ob-pdp__pincode-result.is-success {
    display: block;
    color: var(--color-success);
  }

  .ob-pdp__pincode-result.is-error {
    display: block;
    color: var(--color-error);
  }

  /* Accordion details */
  .ob-pdp__accordion {
    border-top: 1px solid var(--border-soft);
  }

  .ob-pdp__accordion-item {
    border-bottom: 1px solid var(--border-soft);
  }

  .ob-pdp__accordion-btn {
    width: 100%;
    padding: 18px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: none;
    border: none;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    cursor: pointer;
    color: var(--text-charcoal);
  }

  .ob-pdp__accordion-btn svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
    transition: transform 0.3s ease;
  }

  .ob-pdp__accordion-btn.is-active svg {
    transform: rotate(180deg);
  }

  .ob-pdp__accordion-content {
    display: none;
    padding-bottom: 20px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
  }
</style>

<section class="ob-pdp" id="ob-pdp-{{ section.id }}">
  <div class="ob-pdp__container">
    
    <!-- LEFT COLUMN: Image Gallery -->
    <div class="ob-pdp__gallery">
      <div class="ob-pdp__main-image-wrapper">
        {% if product.featured_image %}
          <img class="ob-pdp__main-image" id="main-image-{{ section.id }}" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}">
        {% else %}
          <!-- Standard placeholder SVG for quiet luxury skincare bottle -->
          <svg class="ob-pdp__main-image" id="main-image-{{ section.id }}" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
            <rect width="100" height="100" fill="#faf8f5" />
            <path d="M50 20c-5.5 0-10 4.5-10 10v6h20v-6c0-5.5-4.5-10-10-10zm-14 16v44c0 4.4 3.6 8 8 8h12c4.4 0 8-3.6 8-8V36H36z" fill="#8a9a7b" opacity="0.4"/>
            <circle cx="50" cy="58" r="8" fill="#e9e3d5" />
          </svg>
        {% endif %}
      </div>

      <div class="ob-pdp__thumbnails">
        {% if product.images.size > 1 %}
          {% for image in product.images limit: 4 %}
            <div class="ob-pdp__thumb {% if forloop.first %}is-active{% endif %}" data-url="{{ image | image_url: width: 800 }}">
              <img src="{{ image | image_url: width: 150 }}" alt="{{ product.title | escape }}">
            </div>
          {% endfor %}
        {% else %}
          <!-- Static Mock Thumbnails -->
          <div class="ob-pdp__thumb is-active" data-url="mock-1">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM6 17c0-2.48 2.02-4.5 4.5-4.5h3c2.48 0 4.5 2.02 4.5 4.5H6z"/></svg>
          </div>
          <div class="ob-pdp__thumb" data-url="mock-2">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17.93c-3.95-.49-7-3.85-7-7.93s3.05-7.44 7-7.93v15.86z"/></svg>
          </div>
          <div class="ob-pdp__thumb" data-url="mock-3">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 19.4c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0l1.9-1.9C9.07 19.58 10.47 20 12 20c4.97 0 9-4.03 9-9s-4.03-9-9-9z"/></svg>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- RIGHT COLUMN: Buy-Box details -->
    <div class="ob-pdp__info">
      <span class="ob-pdp__vendor">{{ product.vendor | default: "Dewdrop Atelier" }}</span>
      <h1 class="ob-pdp__title">{{ product.title | default: "Dewy Glow Antioxidant Serum" }}</h1>

      <!-- Review Stars -->
      <div class="ob-pdp__rating-row">
        <div class="ob-pdp__stars">
          <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        </div>
        <span>(89 Verified Reviews)</span>
      </div>

      <!-- Pricing -->
      <div class="ob-pdp__price-area">
        <div class="ob-pdp__price-container">
          <span class="ob-pdp__price" id="pdp-price-val-{{ section.id }}">
            {% if product %}
              {{ product.selected_or_first_available_variant.price | money }}
            {% else %}
              ₹1,250
            {% endif %}
          </span>
          <span class="ob-pdp__compare-price" id="pdp-compare-val-{{ section.id }}">
            {% if product.compare_at_price > product.price %}
              {{ product.compare_at_price | money }}
            {% else %}
              ₹1,490
            {% endif %}
          </span>
        </div>
        <div class="ob-pdp__tax-notice">Inclusive of all taxes (GST Invoice Available)</div>
      </div>

      <!-- COD Badge -->
      <div class="ob-pdp__cod-badge">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-14 9c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm11-9h2.25L21 11.25V13h-4V8zm-2 9c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/>
        </svg>
        Cash on Delivery (COD) Available
      </div>

      {% form 'product', product, class: 'ob-pdp__form' %}
        <!-- Size Variants as Card Pills -->
        <div class="ob-pdp__option-group">
          <span class="ob-pdp__option-title">Select Volume</span>
          <div class="ob-pdp__size-grid">
            <button type="button" class="ob-pdp__size-pill is-active" data-price="1250" data-compare="1490">50 ml</button>
            <button type="button" class="ob-pdp__size-pill" data-price="2150" data-compare="2590">100 ml</button>
            <button type="button" class="ob-pdp__size-pill" data-price="3800" data-compare="4500">200 ml</button>
          </div>
          <!-- Hidden inputs for form submit -->
          <input type="hidden" name="id" id="variant-id-{{ section.id }}" value="{{ product.selected_or_first_available_variant.id | default: '12345678' }}">
        </div>

        <!-- Subscribe & Save Options Panel -->
        <div class="ob-pdp__subscription-panel">
          
          <!-- Option A: One Time -->
          <div class="ob-pdp__sub-option is-active" id="sub-one-time-{{ section.id }}">
            <div class="ob-pdp__radio-wrapper">
              <input type="radio" name="purchase_type" class="ob-pdp__radio" checked id="radio-ot-{{ section.id }}">
            </div>
            <div class="ob-pdp__sub-details">
              <div class="ob-pdp__sub-label-row">
                <span>One-time purchase</span>
                <span class="ob-pdp__sub-price" id="ot-price-display-{{ section.id }}">₹1,250</span>
              </div>
            </div>
          </div>

          <!-- Option B: Subscribe -->
          <div class="ob-pdp__sub-option" id="sub-recurring-{{ section.id }}">
            <div class="ob-pdp__radio-wrapper">
              <input type="radio" name="purchase_type" class="ob-pdp__radio" id="radio-rec-{{ section.id }}">
            </div>
            <div class="ob-pdp__sub-details">
              <div class="ob-pdp__sub-label-row">
                <span>Subscribe & Auto-ship</span>
                <span class="ob-pdp__sub-price" id="rec-price-display-{{ section.id }}">₹1,062</span>
              </div>
              <span class="ob-pdp__sub-discount-text">Save 15% on all recurring orders</span>
              
              <!-- Frequency Dropdown -->
              <div class="ob-pdp__sub-frequency">
                <select class="ob-pdp__sub-select">
                  <option>Deliver every 30 days (Recommended)</option>
                  <option>Deliver every 45 days</option>
                  <option>Deliver every 60 days</option>
                </select>
              </div>
            </div>
          </div>

        </div>

        <!-- CTA Buttons -->
        <div class="ob-pdp__btn-group">
          <button type="submit" class="ob-pdp__atc" id="ob-atc-btn-{{ section.id }}">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M19 6h-2c0-2.76-2.24-5-5-5S7 3.24 7 6H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-7-3c1.66 0 3 1.34 3 3H9c0-1.66 1.34-3 3-3zm7 17H5V8h14v12z"/>
            </svg>
            Add to Bag
          </button>
          
          <!-- Styled WhatsApp enquiry with WhatsApp icon -->
          <a href="https://wa.me/919999999999?text=Hi!%20I%20have%20an%20enquiry%20about%20your%20Dewy%20Glow%20Antioxidant%20Serum." target="_blank" class="ob-pdp__whatsapp">
            <svg viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg">
              <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L3.2 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
