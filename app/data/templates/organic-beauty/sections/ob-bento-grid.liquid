<style>
  .ob-bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: minmax(200px, auto);
    gap: 20px;
    padding: 60px 40px;
    max-width: 1440px;
    margin: 0 auto;
    font-family: var(--ob-font-sans, 'Inter', sans-serif);
  }
  .ob-bento-item {
    background: #111;
    border-radius: 24px;
    padding: 40px;
    position: relative;
    overflow: hidden;
    color: #fff;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s;
    border: 1px solid rgba(255,255,255,0.05);
  }
  .ob-bento-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    border-color: #8fbc8f;
  }
  .ob-bento-item--large { grid-column: span 8; grid-row: span 2; }
  .ob-bento-item--medium { grid-column: span 4; grid-row: span 2; }
  .ob-bento-item--small { grid-column: span 4; grid-row: span 1; }
  
  .ob-bento-title {
    font-size: clamp(24px, 3vw, 42px);
    font-weight: 700;
    margin-bottom: 15px;
    z-index: 2;
    position: relative;
    letter-spacing: -1px;
  }
  .ob-bento-text {
    font-size: 16px;
    opacity: 0.8;
    z-index: 2;
    position: relative;
    max-width: 80%;
  }
  .ob-bento-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.4;
    transition: transform 0.6s;
  }
  .ob-bento-item:hover .ob-bento-bg {
    transform: scale(1.05);
  }
  @media (max-width: 900px) {
    .ob-bento-item { grid-column: span 12 !important; grid-row: auto !important; min-height: 300px; }
  }
</style>

<section class="ob-bento">
  <div class="ob-bento-item ob-bento-item--large">
    <img src="https://images.unsplash.com/photo-1618220179428-22790b46a015?w=1000&q=80" class="ob-bento-bg" alt="Hero Feature">
    <h3 class="ob-bento-title">{{ section.settings.title_1 | default: 'Next-Gen Performance' }}</h3>
    <p class="ob-bento-text">{{ section.settings.text_1 | default: 'Experience unparalleled power and seamless integration in one beautiful package.' }}</p>
  </div>
  <div class="ob-bento-item ob-bento-item--medium">
    <h3 class="ob-bento-title" style="color: #8fbc8f;">{{ section.settings.title_2 | default: 'Eco-Friendly' }}</h3>
    <p class="ob-bento-text">{{ section.settings.text_2 | default: 'Built with sustainable materials without compromising quality.' }}</p>
  </div>
  <div class="ob-bento-item ob-bento-item--small">
    <h3 class="ob-bento-title">{{ section.settings.title_3 | default: '24/7 Support' }}</h3>
  </div>
  <div class="ob-bento-item ob-bento-item--small" style="background: #8fbc8f; color: #000;">
    <h3 class="ob-bento-title" style="color: #000;">{{ section.settings.title_4 | default: 'Free Shipping' }}</h3>
  </div>
</section>

{% schema %}
{
  "name": "Premium Bento Grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title_1", "label": "Block 1 Title" },
    { "type": "textarea", "id": "text_1", "label": "Block 1 Text" }
  ],
  "presets": [{ "name": "Premium Bento Grid" }]
}
{% endschema %}
