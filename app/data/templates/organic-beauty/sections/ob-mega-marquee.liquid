<style>
  .ob-marquee-wrapper {
    overflow: hidden;
    padding: 80px 0;
    background: var(--ob-color-bg, #0a0a0a);
    color: var(--ob-color-text, #fff);
    border-top: 1px solid rgba(255,255,255,0.05);
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .ob-marquee {
    display: flex;
    white-space: nowrap;
    animation: ob-marquee-scroll 30s linear infinite;
  }
  .ob-marquee:hover {
    animation-play-state: paused;
  }
  .ob-marquee-text {
    font-family: var(--ob-font-sans, sans-serif);
    font-size: clamp(60px, 8vw, 120px);
    font-weight: 900;
    text-transform: uppercase;
    padding: 0 40px;
    letter-spacing: -2px;
    -webkit-text-stroke: 1px rgba(255,255,255,0.2);
    color: transparent;
    transition: all 0.3s ease;
    cursor: default;
  }
  .ob-marquee-text:hover {
    color: #8fbc8f;
    -webkit-text-stroke: 0;
    text-shadow: 0 0 40px #8fbc8f80;
  }
  @keyframes ob-marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

<div class="ob-marquee-wrapper">
  <div class="ob-marquee">
    <div class="ob-marquee-text">{{ section.settings.text | default: 'UNCOMPROMISING QUALITY • INNOVATIVE DESIGN • EXCEPTIONAL EXPERIENCE •' }}</div>
    <div class="ob-marquee-text">{{ section.settings.text | default: 'UNCOMPROMISING QUALITY • INNOVATIVE DESIGN • EXCEPTIONAL EXPERIENCE •' }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Mega Marquee",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "text", "label": "Marquee Text" }
  ],
  "presets": [{ "name": "Mega Marquee" }]
}
{% endschema %}
