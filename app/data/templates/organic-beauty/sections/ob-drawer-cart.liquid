<style>
  .ob-drawer {
    position: fixed;
    top: 0;
    right: -450px;
    width: 100%;
    max-width: 450px;
    height: 100vh;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    z-index: 2000;
    box-shadow: -10px 0 30px rgba(0,0,0,0.08);
    transition: right 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    font-family: var(--ob-font-sans, 'Inter', sans-serif);
  }
  .ob-drawer.active {
    right: 0;
  }
  .ob-drawer__overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    z-index: 1999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }
  .ob-drawer__overlay.active {
    opacity: 1;
    pointer-events: auto;
  }
  .ob-drawer__header {
    padding: 25px 30px;
    border-bottom: 1px solid rgba(0,0,0,0.05);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .ob-drawer__title {
    font-family: var(--ob-font-serif, 'Georgia', serif);
    font-size: 24px;
    margin: 0;
    font-weight: 400;
  }
  .ob-drawer__close {
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    font-weight: 300;
    transition: transform 0.3s ease;
  }
  .ob-drawer__close:hover {
    transform: rotate(90deg);
  }
  
  /* Shipping Progress */
  .ob-shipping-bar-container {
    padding: 20px 30px;
    background: #fdfdfd;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  .ob-shipping-msg {
    font-size: 13px;
    text-align: center;
    margin-bottom: 10px;
    font-weight: 500;
  }
  .ob-progress-bg {
    height: 6px;
    background: #eee;
    border-radius: 4px;
    overflow: hidden;
  }
  .ob-progress-fill {
    height: 100%;
    background: #000;
    width: 60%; /* dynamic based on cart */
    transition: width 0.5s ease;
  }

  .ob-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 30px;
  }
  .ob-drawer__item {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
    position: relative;
  }
  .ob-drawer__item-img {
    width: 90px;
    height: 120px;
    object-fit: cover;
    border-radius: 2px;
  }
  .ob-drawer__item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .ob-drawer__item-title {
    font-size: 14px;
    margin-bottom: 5px;
    font-weight: 500;
  }
  .ob-drawer__item-price {
    font-size: 14px;
    font-weight: 600;
  }
  .ob-qty-selector {
    display: flex;
    border: 1px solid #ddd;
    width: 90px;
    border-radius: 2px;
  }
  .ob-qty-btn {
    background: none; border: none; width: 30px; cursor: pointer; font-size: 16px;
  }
  .ob-qty-input {
    width: 30px; border: none; text-align: center; font-size: 13px;
  }

  /* Upsells */
  .ob-upsell-block {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px dashed rgba(0,0,0,0.1);
  }
  .ob-upsell-title {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 15px;
    font-weight: 600;
    color: #666;
  }
  .ob-upsell-item {
    display: flex;
    gap: 15px;
    align-items: center;
    background: #f9f9f9;
    padding: 10px;
    border-radius: 4px;
  }
  .ob-upsell-img { width: 50px; height: 50px; object-fit: cover; }
  .ob-upsell-add {
    margin-left: auto;
    background: #000; color: #fff; border: none; padding: 6px 12px; font-size: 11px; cursor: pointer; text-transform: uppercase;
  }

  .ob-drawer__footer {
    padding: 30px;
    background: #fff;
    box-shadow: 0 -10px 20px rgba(0,0,0,0.03);
  }
  .ob-drawer__subtotal {
    display: flex;
    justify-content: space-between;
    font-size: 18px;
    font-weight: 500;
    margin-bottom: 20px;
  }
  .ob-drawer__checkout-btn {
    width: 100%;
    padding: 18px;
    background: #000;
    color: #fff;
    border: none;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    transition: background 0.3s ease;
  }
  .ob-drawer__checkout-btn:hover {
    background: #333;
  }
  .ob-drawer-trust {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 15px;
    opacity: 0.5;
  }
  .ob-drawer-trust svg { width: 30px; height: auto; }
</style>

<div class="ob-drawer__overlay" id="ob-cart-overlay" onclick="document.getElementById('ob-cart-drawer').classList.remove('active'); this.classList.remove('active');"></div>

<div class="ob-drawer" id="ob-cart-drawer">
  <div class="ob-drawer__header">
    <h2 class="ob-drawer__title">Bag ({{ cart.item_count }})</h2>
    <button class="ob-drawer__close" onclick="document.getElementById('ob-cart-drawer').classList.remove('active'); document.getElementById('ob-cart-overlay').classList.remove('active');">&times;</button>
  </div>
  
  {% assign threshold = 15000 %}
  {% assign current_total = cart.total_price %}
  {% assign percentage = current_total | times: 100 | divided_by: threshold %}
  {% if percentage > 100 %}{% assign percentage = 100 %}{% endif %}

  <div class="ob-shipping-bar-container">
    {% if current_total >= threshold %}
      <div class="ob-shipping-msg">🎉 You've unlocked <strong>Free Worldwide Shipping</strong>!</div>
    {% else %}
      {% assign remaining = threshold | minus: current_total | money %}
      <div class="ob-shipping-msg">You're <strong>{{ remaining }}</strong> away from Free Shipping.</div>
    {% endif %}
    <div class="ob-progress-bg">
      <div class="ob-progress-fill" style="width: {{ percentage }}%;"></div>
    </div>
  </div>

  <div class="ob-drawer__body">
    {% if cart.item_count > 0 %}
      {% for item in cart.items %}
        <div class="ob-drawer__item">
          <img class="ob-drawer__item-img" src="{{ item.image | image_url }}" alt="{{ item.title | escape }}">
          <div class="ob-drawer__item-details">
            <div>
              <div class="ob-drawer__item-title">{{ item.product.title }}</div>
              <div style="font-size:12px; color:#888;">{{ item.variant.title }}</div>
            </div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top: 15px;">
              <div class="ob-qty-selector">
                <button class="ob-qty-btn">-</button>
                <input class="ob-qty-input" type="text" value="{{ item.quantity }}" readonly>
                <button class="ob-qty-btn">+</button>
              </div>
              <div class="ob-drawer__item-price">{{ item.final_line_price | money }}</div>
            </div>
          </div>
        </div>
      {% endfor %}

      <!-- Faux Upsell Block -->
      <div class="ob-upsell-block">
        <div class="ob-upsell-title">Complete The Look</div>
        <div class="ob-upsell-item">
          <div style="width: 50px; height: 50px; background: #eee;"></div>
          <div>
            <div style="font-size: 13px; font-weight: 500;">Signature Tote</div>
            <div style="font-size: 12px; color: #666;">$45.00</div>
          </div>
          <button class="ob-upsell-add">Add</button>
        </div>
      </div>
      
    {% else %}
      <div style="text-align:center; padding: 60px 0; display:flex; flex-direction:column; align-items:center; gap:20px;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        <p style="color: #666;">Your bag is empty.</p>
        <button style="background:#000; color:#fff; padding:12px 30px; border:none; cursor:pointer;" onclick="document.getElementById('ob-cart-drawer').classList.remove('active'); document.getElementById('ob-cart-overlay').classList.remove('active');">Continue Shopping</button>
      </div>
    {% endif %}
  </div>

  {% if cart.item_count > 0 %}
    <div class="ob-drawer__footer">
      <div class="ob-drawer__subtotal">
        <span>Subtotal</span>
        <span>{{ cart.total_price | money }}</span>
      </div>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="ob-drawer__checkout-btn">Secure Checkout</button>
      </form>
      <div class="ob-drawer-trust">
        <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg"><path d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z" fill="#000"/><path d="M19.1 11.4c0-1.6.8-3.1 2.2-3.9-1-1-2.4-1.3-3.1-1.3-1.3-.1-2.6.8-3.3.8-.7 0-1.7-.8-2.8-.8-1.4 0-2.8.8-3.5 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.6 2.2 2.7 2.1 1.1-.1 1.5-.7 2.8-.7 1.3 0 1.7.7 2.8.7 1.2.1 1.9-1 2.6-2.1.9-1.3 1.2-2.5 1.2-2.6-.1 0-2.2-.8-2.2-3.3zm-1.8-5c.6-.7 1-1.7.9-2.7-.8.1-1.9.6-2.5 1.4-.5.6-1 1.6-.9 2.6.9.1 1.9-.5 2.5-1.3z" fill="#FFF"/></svg>
        <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg"><path d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32" fill="#1434CB"/><path d="M28.3 5.9l-1.4 8.6h-2.7l1.4-8.6h2.7zm-9.3 0h-2.2c-.4 0-.8.2-1 .6l-3.1 7.4-1.5-7.4c-.1-.3-.2-.5-.5-.6H8.1l2.4 8.6h2.8l3.6-8.6zm13.1 8.6l-1.3-6.2c-.1-.4-.5-.6-.9-.6h-3.1c-.2 0-.4.1-.5.3l-2.4 6.5h2.8l.5-1.5h3.5l.3 1.5h1.1zm-3.5-3.6l1-3 1 3h-2zm-11.4 3.6h2.7l1.7-8.6h-2.7l-1.7 8.6z" fill="#FFF"/></svg>
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Premium Drawer Cart",
  "tag": "section",
  "settings": []
}
{% endschema %}
