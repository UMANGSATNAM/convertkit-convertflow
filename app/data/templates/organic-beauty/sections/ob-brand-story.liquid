<style>
  .ob-brand { padding: 100px 0; background: {{ section.settings.bg_color }}; }
  .ob-brand__container { max-width: 1200px; margin: 0 auto; padding: 0 30px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  @media (max-width: 768px) { .ob-brand__container { grid-template-columns: 1fr; } }
  .ob-brand__image { width: 100%; border-radius: 20px; aspect-ratio: 4/5; object-fit: cover; }
  .ob-brand__eyebrow { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 4px; text-transform: uppercase; color: {{ section.settings.accent_color }}; margin-bottom: 15px; }
  .ob-brand__title { font-family: 'Georgia', serif; font-size: 36px; color: #2d2a24; line-height: 1.2; margin-bottom: 20px; }
  .ob-brand__text { font-family: 'Inter', sans-serif; font-size: 15px; line-height: 1.8; color: #8b7355; margin-bottom: 30px; }
  .ob-brand__btn { display: inline-block; background: transparent; border: 2px solid {{ section.settings.accent_color }}; color: {{ section.settings.accent_color }}; padding: 12px 35px; border-radius: 30px; font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600; text-decoration: none; transition: all 0.3s; }
  .ob-brand__btn:hover { background: {{ section.settings.accent_color }}; color: #fff; }
</style>
<section class="ob-brand">
  <div class="ob-brand__container" style="{% if section.settings.image_position == 'right' %}direction: rtl;{% endif %}">
    <div style="direction: ltr;">
      {% if section.settings.image %}<img class="ob-brand__image" src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" loading="lazy">{% else %}<div class="ob-brand__image" style="background: linear-gradient(135deg, #f0e8dc, #e8ddd0);"></div>{% endif %}
    </div>
    <div style="direction: ltr;">
      <div class="ob-brand__eyebrow">{{ section.settings.label }}</div>
      <h2 class="ob-brand__title">{{ section.settings.title }}</h2>
      <div class="ob-brand__text">{{ section.settings.text }}</div>
      {% if section.settings.btn_label != blank %}<a href="{{ section.settings.btn_link }}" class="ob-brand__btn">{{ section.settings.btn_label }}</a>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "OB Brand Story", "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image Position", "options": [{"value":"left","label":"Left"},{"value":"right","label":"Right"}], "default": "left" },
    { "type": "text", "id": "label", "label": "Label", "default": "Our Story" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Rooted in Nature" },
    { "type": "richtext", "id": "text", "label": "Body", "default": "<p>Every ingredient is ethically sourced, cruelty-free, and chosen for its proven benefits. We believe beauty should be kind—to you and the earth.</p>" },
    { "type": "text", "id": "btn_label", "label": "Button", "default": "Our Philosophy" },
    { "type": "url", "id": "btn_link", "label": "Link" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf5ef" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#c9a96e" }
  ],
  "presets": [{ "name": "OB Brand Story" }]
}
{% endschema %}
