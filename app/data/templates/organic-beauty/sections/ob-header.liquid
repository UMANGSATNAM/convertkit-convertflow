<style>
  .ob-header { position: sticky; top: 0; width: 100%; background: rgba(250, 245, 239, 0.95); backdrop-filter: blur(10px); z-index: 500; border-bottom: 1px solid rgba(201, 169, 110, 0.2); }
  .ob-header__container { max-width: 1400px; margin: 0 auto; padding: 0 30px; height: 80px; display: flex; align-items: center; justify-content: space-between; }
  .ob-header__nav { display: flex; gap: 30px; }
  @media (max-width: 768px) { .ob-header__nav { display: none; } }
  .ob-header__nav a { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 500; color: #2d2a24; text-decoration: none; text-transform: uppercase; letter-spacing: 1px; transition: color 0.3s; }
  .ob-header__nav a:hover { color: #c9a96e; }
  .ob-header__logo { font-family: 'Georgia', serif; font-size: 24px; color: #2d2a24; text-decoration: none; font-weight: normal; letter-spacing: 2px; }
  .ob-header__logo span { color: #c9a96e; }
  .ob-header__icons { display: flex; align-items: center; gap: 20px; }
  .ob-header__icon { background: none; border: none; color: #2d2a24; font-size: 20px; cursor: pointer; transition: color 0.3s; text-decoration: none; }
  .ob-header__icon:hover { color: #c9a96e; }
  .ob-header__cart-count { background: #c9a96e; color: #fff; font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 10px; vertical-align: top; margin-left: -5px; }
</style>
<header class="ob-header">
  <div class="ob-header__container">
    <nav class="ob-header__nav">
      {% for link in linklists.main-menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </nav>
    <a href="/" class="ob-header__logo">{{ section.settings.logo_text | split: ' ' | first }} <span>{{ section.settings.logo_text | split: ' ' | last }}</span></a>
    <div class="ob-header__icons">
      <a href="/search" class="ob-header__icon">🔍</a>
      <a href="/account" class="ob-header__icon">👤</a>
      <button class="ob-header__icon" onclick="document.getElementById('ob-cart-drawer').classList.add('active'); document.getElementById('ob-cart-overlay').classList.add('active');">
        🛍️<span class="ob-header__cart-count">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>
{% schema %}
{ "name": "OB Header", "tag": "section", "settings": [{ "type": "text", "id": "logo_text", "label": "Logo Text", "default": "Organic Beauty" }], "presets": [{ "name": "OB Header" }] }
{% endschema %}
