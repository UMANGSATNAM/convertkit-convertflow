<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500;600&display=swap');

  .ob-ritual {
    --bg-cream: #f4efe6;
    --brand-sage: #8a9a7b;
    --brand-sage-dark: #707f63;
    --surface-light: #faf8f5;
    --surface-sand: #e9e3d5;
    --text-charcoal: #2d302b;
    --text-muted: #6e726b;
    --border-soft: #dfd8cb;

    padding: 80px 5%;
    background-color: var(--bg-cream);
    color: var(--text-charcoal);
    font-family: 'Jost', sans-serif;
  }

  .ob-ritual__container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .ob-ritual__subtitle {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--brand-sage-dark);
    font-weight: 600;
    display: block;
    margin-bottom: 12px;
  }

  .ob-ritual__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 4vw, 42px);
    font-weight: 400;
    margin: 0 auto 30px auto;
    max-width: 700px;
    line-height: 1.25;
  }

  /* Interactive Tab Switcher */
  .ob-ritual__tabs-wrapper {
    display: inline-flex;
    background-color: var(--surface-sand);
    padding: 6px;
    border-radius: 40px;
    margin-bottom: 50px;
    border: 1px solid var(--border-soft);
  }

  .ob-ritual__tab-btn {
    background: none;
    border: none;
    padding: 12px 32px;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    border-radius: 30px;
    cursor: pointer;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ob-ritual__tab-btn svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
    transition: transform 0.4s ease;
  }

  .ob-ritual__tab-btn:hover svg {
    transform: scale(1.1);
  }

  .ob-ritual__tab-btn.is-active {
    background-color: var(--surface-light);
    color: var(--brand-sage-dark);
    box-shadow: 0 4px 15px rgba(138, 154, 123, 0.1);
  }

  /* Routine Content Sections */
  .ob-ritual__routine-panel {
    display: none;
    animation: ob-fade-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .ob-ritual__routine-panel.is-active {
    display: block;
  }

  .ob-ritual__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }

  @media (min-width: 768px) {
    .ob-ritual__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .ob-ritual__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 40px;
    }
  }

  /* Steps Cards */
  .ob-ritual__card {
    background-color: var(--surface-light);
    border-radius: 24px;
    padding: 40px 30px;
    border: 1px solid var(--border-soft);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease;
  }

  .ob-ritual__card:hover {
    transform: translateY(-8px);
    border-color: var(--brand-sage);
    box-shadow: 0 12px 30px rgba(138, 154, 123, 0.08);
  }

  .ob-ritual__step-badge {
    position: absolute;
    top: 24px;
    left: 24px;
    background-color: var(--surface-sand);
    color: var(--brand-sage-dark);
    font-size: 11px;
    font-weight: 600;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ob-ritual__icon-container {
    width: 70px;
    height: 70px;
    background-color: var(--bg-cream);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-sage);
    margin-bottom: 24px;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .ob-ritual__card:hover .ob-ritual__icon-container {
    background-color: var(--brand-sage);
    color: #ffffff;
  }

  .ob-ritual__icon-container svg {
    width: 32px;
    height: 32px;
    fill: currentColor;
  }

  .ob-ritual__step-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 500;
    margin: 0 0 10px 0;
    color: var(--text-charcoal);
  }

  .ob-ritual__step-concern {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--brand-sage-dark);
    font-weight: 600;
    margin-bottom: 14px;
  }

  .ob-ritual__step-desc {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  /* Fade-in keyframes */
  @keyframes ob-fade-in {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<section class="ob-ritual" id="ob-ritual-{{ section.id }}">
  <div class="ob-ritual__container">
    <span class="ob-ritual__subtitle">{{ section.settings.subtitle }}</span>
    <h2 class="ob-ritual__title">{{ section.settings.title }}</h2>

    <!-- Tabs Wrapper -->
    <div class="ob-ritual__tabs-wrapper">
      <button type="button" class="ob-ritual__tab-btn is-active" data-tab="am-{{ section.id }}">
        <!-- Inline Sun SVG -->
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zm0-5c.55 0 1 .45 1 1v2c0 .55-.45 1-1 1s-1-.45-1-1V3c0-.55.45-1 1-1zm0 14c.55 0 1 .45 1 1v2c0 .55-.45 1-1 1s-1-.45-1-1v-2c0-.55.45-1 1-1zM5.22 6.64c.39-.39 1.02-.39 1.41 0l1.41 1.41c.39.39.39 1.02 0 1.41s-1.02.39-1.41 0L5.22 8.05c-.39-.39-.39-1.02 0-1.41zm10.74 10.74c.39-.39 1.02-.39 1.41 0l1.41 1.41c.39.39.39 1.02 0 1.41s-1.02.39-1.41 0l-1.41-1.41c-.39-.39-.39-1.02 0-1.41zM2 12c0-.55.45-1 1-1h2c.55 0 1 .45 1 1s-.45 1-1 1H3c-.55 0-1-.45-1-1zm14 0c0-.55.45-1 1-1h2c.55 0 1 .45 1 1s-.45 1-1 1h-2c-.55 0-1-.45-1-1zM6.64 18.78c-.39-.39-.39-1.02 0-1.41l1.41-1.41c.39-.39 1.02-.39 1.41 0s.39 1.02 0 1.41l-1.41 1.41c-.39.39-1.02.39-1.41 0zm10.74-10.74c-.39-.39-.39-1.02 0-1.41l1.41-1.41c.39-.39 1.02-.39 1.41 0s.39 1.02 0 1.41l-1.41 1.41c-.39.39-1.02.39-1.41 0z"/>
        </svg>
        AM Ritual
      </button>
      <button type="button" class="ob-ritual__tab-btn" data-tab="pm-{{ section.id }}">
        <!-- Inline Moon/Stars SVG -->
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12.3 22c-5.4 0-9.8-4.4-9.8-9.8 0-4.1 2.5-7.7 6.4-9.1.5-.2.9.2.8.7-.3 1.5-.1 3.1.6 4.6 1.4 3 4.2 4.9 7.4 4.9 1 0 2-.2 2.9-.6.5-.2.9.2.7.7-1.4 3.9-5 6.4-9 6.4zm-.2-17.5c-3.7.8-6.3 4.1-6.3 7.9 0 4.5 3.7 8.2 8.2 8.2 3.8 0 7.1-2.6 7.9-6.3-1 .4-2 .6-3.1.6-4.2 0-7.8-2.6-9.1-6.4-.6-1.5-.7-3.1-.6-4z"/>
        </svg>
        PM Ritual
      </button>
    </div>

    <!-- AM Routine Panel -->
    <div class="ob-ritual__routine-panel is-active" id="am-{{ section.id }}">
      <div class="ob-ritual__grid">
        <!-- Step 1 -->
        <div class="ob-ritual__card">
          <span class="ob-ritual__step-badge">1</span>
          <div class="ob-ritual__icon-container">
            <!-- Gentle Bottle/Mist SVG -->
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M19 8h-1V5c0-1.65-1.35-3-3-3H9C7.35 2 6 3.35 6 5v3H5c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM8 5c0-.55.45-1 1-1h6c.55 0 1 .45 1 1v3H8V5zm11 15H5V10h14v10zM12 11c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
            </svg>
          </div>
          <h3 class="ob-ritual__step-title">Cleanse & Prep</h3>
          <span class="ob-ritual__step-concern">Gentle Purifying Cleanser</span>
          <p class="ob-ritual__step-desc">Wash away overnight impurities without stripping your skin barrier, laying a clean foundation for active hydration.</p>
        </div>

        <!-- Step 2 -->
        <div class="ob-ritual__card">
          <span class="ob-ritual__step-badge">2</span>
          <div class="ob-ritual__icon-container">
            <!-- Spray Mist SVG -->
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17.93c-3.95-.49-7-3.85-7-7.93s3.05-7.44 7-7.93v15.86zm2-15.86c3.95.49 7 3.85 7 7.93s-3.05 7.44-7 7.93V4.07z"/>
            </svg>
          </div>
          <h3 class="ob-ritual__step-title">Tone & Balance</h3>
          <span class="ob-ritual__step-concern">Hydrating Treatment Mist</span>
          <p class="ob-ritual__step-desc">Mist liberally onto skin to balance pH levels and instantly saturate skin with calming botanical extracts.</p>
        </div>

        <!-- Step 3 -->
        <div class="ob-ritual__card">
          <span class="ob-ritual__step-badge">3</span>
          <div class="ob-ritual__icon-container">
            <!-- Dropper/Target SVG -->
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 15c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6zm1-10h-2v3H8v2h3v3h2v-3h3v-2h-3V8z"/>
            </svg>
          </div>
          <h3 class="ob-ritual__step-title">Target & Plump</h3>
          <span class="ob-ritual__step-concern">Hyaluronic Acid Serum</span>
          <p class="ob-ritual__step-desc">Apply 3-4 drops of serum on damp skin to draw moisture deep into skin layers, visibly smoothing fine lines.</p>
        </div>

        <!-- Step 4 -->
        <div class="ob-ritual__card">
          <span class="ob-ritual__step-badge">4</span>
          <div class="ob-ritual__icon-container">
            <!-- Shield/Sunscreen SVG -->
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
            </svg>
          </div>
          <h3 class="ob-ritual__step-title">Seal & Protect</h3>
          <span class="ob-ritual__step-concern">Barrier Cream + SPF</span>
          <p class="ob-ritual__step-desc">Lock in moisture with a lightweight cream, followed by broad-spectrum sunscreen to defend against daily UV rays.</p>
        </div>
      </div>
    </div>

    <!-- PM Routine Panel -->
    <div class="ob-ritual__routine-panel" id="pm-{{ section.id }}">
      <div class="ob-ritual__grid">
        <!-- Step 1 -->
        <div class="ob-ritual__card">
          <span class="ob-ritual__step-badge">1</span>
          <div class="ob-ritual__icon-container">
            <!-- Double Cleanse / Water drop SVG -->
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0zM12 20a6 6 0 1 0-4.24-1.76L12 20zm0-15.17l-3.54 3.54a4 4 0 1 0 7.07 0L12 4.83z"/>
            </svg>
          </div>
          <h3 class="ob-ritual__step-title">Double Cleanse</h3>
          <span class="ob-ritual__step-concern">Oil Cleanser + Foam Cleanser</span>
          <p class="ob-ritual__step-desc">Dissolve makeup, sebum, and pollutants with an oil-based balm, then follow up with water cleanser for pristine skin.</p>
        </div>

        <!-- Step 2 -->
        <div class="ob-ritual__card">
          <span class="ob-ritual__step-badge">2</span>
          <div class="ob-ritual__icon-container">
            <!-- Exfoliate / Dropper/Stars SVG -->
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 11.75c-.69 0-1.25.56-1.25 1.25s.56 1.25 1.25 1.25 1.25-.56 1.25-1.25-.56-1.25-1.25-1.25zm6 0c-.69 0-1.25.56-1.25 1.25s.56 1.25 1.25 1.25 1.25-.56 1.25-1.25-.56-1.25-1.25-1.25zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
            </svg>
          </div>
          <h3 class="ob-ritual__step-title">Resurface & Refine</h3>
          <span class="ob-ritual__step-concern">AHA/BHA Treatment Serum</span>
          <p class="ob-ritual__step-desc">Apply chemical exfoliant 2-3 times a week to remove dead skin cells and support cellular regeneration overnight.</p>
        </div>

        <!-- Step 3 -->
        <div class="ob-ritual__card">
          <span class="ob-ritual__step-badge">3</span>
          <div class="ob-ritual__icon-container">
            <!-- Deep Hydrate / Flower SVG -->
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 19.4c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0l1.9-1.9C9.07 19.58 10.47 20 12 20c4.97 0 9-4.03 9-9s-4.03-9-9-9zm0 15c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6z"/>
            </svg>
          </div>
          <h3 class="ob-ritual__step-title">Intense Hydration</h3>
          <span class="ob-ritual__step-concern">Rosehip Recovery Oil</span>
          <p class="ob-ritual__step-desc">Massage 2-3 drops of pure botanical oil into the face to nourish compromised skin and rebuild lipid levels.</p>
        </div>

        <!-- Step 4 -->
        <div class="ob-ritual__card">
          <span class="ob-ritual__step-badge">4</span>
          <div class="ob-ritual__icon-container">
            <!-- Sleep mask/Lock SVG -->
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
            </svg>
          </div>
          <h3 class="ob-ritual__step-title">Overnight Rest</h3>
          <span class="ob-ritual__step-concern">Sleeping Mask Creams</span>
          <p class="ob-ritual__step-desc">Seal everything in with an ultra-thick overnight barrier moisturizer to prevent moisture loss as you sleep.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const section = document.getElementById("ob-ritual-{{ section.id }}");
    if (!section) return;

    const tabs = section.querySelectorAll(".ob-ritual__tab-btn");
    const panels = section.querySelectorAll(".ob-ritual__routine-panel");

    tabs.forEach(tab => {
      tab.addEventListener("click", () => {
        const targetId = tab.getAttribute("data-tab");

        // Toggle active tabs
        tabs.forEach(t => t.classList.remove("is-active"));
        tab.classList.add("is-active");

        // Toggle active panels
        panels.forEach(panel => {
          if (panel.id === targetId) {
            panel.classList.add("is-active");
          } else {
            panel.classList.remove("is-active");
          }
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Skincare Ritual Steps",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Your Daily Skincare Ritual"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "AM & PM Routine Guide"
    }
  ],
  "presets": [
    {
      "name": "Skincare Ritual Steps"
    }
  ]
}
{% endschema %}
