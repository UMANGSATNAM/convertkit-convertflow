<script>
  document.addEventListener("DOMContentLoaded", function() {
    const container = document.getElementById("ob-bundle-{{ section.id }}");
    if (!container) return;

    const tabButtons = container.querySelectorAll(".ob-bundle__tab-btn");
    const productWrappers = container.querySelectorAll(".ob-bundle__products-wrapper");
    const qtyText = container.getElementById("bundle-qty-{{ section.id }}");
    const subtotalText = container.getElementById("bundle-subtotal-{{ section.id }}");
    const discountText = container.getElementById("bundle-discount-{{ section.id }}");
    const totalText = container.getElementById("bundle-total-{{ section.id }}");
    const ctaButton = container.getElementById("bundle-cta-{{ section.id }}");
    const successMsg = container.getElementById("bundle-success-{{ section.id }}");

    function updateSummary() {
      // Find the currently active panel
      const activePanel = container.querySelector(".ob-bundle__products-wrapper.is-active");
      if (!activePanel) return;

      const checkboxes = activePanel.querySelectorAll(".ob-bundle__checkbox");
      let count = 0;
      let totalCount = checkboxes.length;
      let subtotal = 0;

      checkboxes.forEach(cb => {
        if (cb.checked) {
          count++;
          subtotal += parseFloat(cb.getAttribute("data-price"));
        }
      });

      const discount = Math.round(subtotal * 0.15);
      const total = subtotal - discount;

      qtyText.textContent = `${count} of ${totalCount}`;
      subtotalText.textContent = `₹${subtotal.toLocaleString("en-IN")}`;
      discountText.textContent = `-₹${discount.toLocaleString("en-IN")}`;
      totalText.textContent = `₹${total.toLocaleString("en-IN")}`;

      if (count === 0) {
        ctaButton.disabled = true;
        totalText.textContent = "₹0";
      } else {
        ctaButton.disabled = false;
      }
    }

    // Toggle Panels
    tabButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        const concern = btn.getAttribute("data-concern");

        tabButtons.forEach(b => b.classList.remove("is-active"));
        btn.classList.add("is-active");

        productWrappers.forEach(wrap => {
          if (wrap.id === concern) {
            wrap.classList.add("is-active");
          } else {
            wrap.classList.remove("is-active");
          }
        });

        // Hide success message on switch
        successMsg.style.display = "none";

        updateSummary();
      });
    });

    // Handle checkboxes
    container.addEventListener("change", function(e) {
      if (e.target && e.target.classList.contains("ob-bundle__checkbox")) {
        updateSummary();
      }
    });

    // Add to Cart Simulation
    ctaButton.addEventListener("click", () => {
      ctaButton.disabled = true;
      const originalText = ctaButton.innerHTML;
      ctaButton.textContent = "Adding...";

      setTimeout(() => {
        ctaButton.disabled = false;
        ctaButton.innerHTML = originalText;
        successMsg.style.display = "block";
      }, 800);
    });

    // Initial update
    updateSummary();
  });
</script>
{% schema %}
{
