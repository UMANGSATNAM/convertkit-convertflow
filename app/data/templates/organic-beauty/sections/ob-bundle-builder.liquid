  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Build Your Skincare Routine"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Tailored to Your Skin Concern"
    }
  ],
  "presets": [
    {
      "name": "Skincare Bundle Builder"
    }
  ]
}
{% endschema %}
