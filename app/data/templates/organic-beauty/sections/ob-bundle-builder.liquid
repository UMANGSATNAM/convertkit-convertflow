<style>
  .ob-bundle {
    --bg-cream: #f4efe6;
    --brand-sage: #8a9a7b;
    --brand-sage-dark: #707f63;
    --surface-light: #faf8f5;
    --surface-sand: #e9e3d5;
    --text-charcoal: #2d302b;
    --text-muted: #6e726b;
    --border-soft: #dfd8cb;
    --gold: #c9a96e;

    padding: 80px 5%;
    background-color: var(--surface-light);
    color: var(--text-charcoal);
    font-family: 'Jost', sans-serif;
  }

  .ob-bundle__container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .ob-bundle__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .ob-bundle__subtitle {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--brand-sage-dark);
    font-weight: 600;
    display: block;
    margin-bottom: 12px;
  }

  .ob-bundle__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 4vw, 42px);
    font-weight: 400;
    margin: 0;
    line-height: 1.2;
  }

  /* Skin Type Tabs */
  .ob-bundle__tabs {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .ob-bundle__tab-btn {
    background-color: var(--bg-cream);
    border: 1px solid var(--border-soft);
    padding: 10px 24px;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 30px;
    cursor: pointer;
    color: var(--text-muted);
    transition: all 0.3s ease;
  }

  .ob-bundle__tab-btn:hover {
    border-color: var(--brand-sage);
    color: var(--brand-sage-dark);
  }

  .ob-bundle__tab-btn.is-active {
    background-color: var(--brand-sage);
    color: #ffffff;
    border-color: var(--brand-sage);
  }

  /* Bundle Builder Layout */
  .ob-bundle__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 992px) {
    .ob-bundle__layout {
      grid-template-columns: 1.8fr 1.2fr;
      gap: 50px;
    }
  }

  /* Products Grid */
  .ob-bundle__products-wrapper {
    display: none;
  }

  .ob-bundle__products-wrapper.is-active {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ob-bundle__item {
    background-color: var(--bg-cream);
    border-radius: 20px;
    border: 1px solid var(--border-soft);
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 20px;
    position: relative;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .ob-bundle__item:hover {
    border-color: var(--brand-sage);
  }

  .ob-bundle__item-checkbox-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ob-bundle__checkbox {
    appearance: none;
    -webkit-appearance: none;
    width: 24px;
    height: 24px;
    border: 1.5px solid var(--border-soft);
    border-radius: 50%;
    outline: none;
    cursor: pointer;
    transition: all 0.2s ease;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ob-bundle__checkbox:checked {
    background-color: var(--brand-sage);
    border-color: var(--brand-sage);
  }

  .ob-bundle__checkbox:checked::after {
    content: "";
    width: 8px;
    height: 4px;
    border-left: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    transform: rotate(-45deg) translate(1px, -1px);
    display: block;
  }

  .ob-bundle__item-img-container {
    width: 70px;
    height: 70px;
    border-radius: 12px;
    background-color: var(--surface-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-sage-dark);
    border: 1px solid var(--border-soft);
    flex-shrink: 0;
  }

  .ob-bundle__item-img-container svg {
    width: 32px;
    height: 32px;
    fill: currentColor;
  }

  .ob-bundle__item-details {
    flex-grow: 1;
  }

  .ob-bundle__item-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    font-weight: 500;
    margin: 0 0 4px 0;
  }

  .ob-bundle__item-price {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--brand-sage-dark);
  }

  /* Summary Card */
  .ob-bundle__summary {
    background-color: var(--bg-cream);
    border-radius: 24px;
    border: 1px solid var(--border-soft);
    padding: 35px 30px;
    position: sticky;
    top: 40px;
  }

  .ob-bundle__summary-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-weight: 500;
    margin: 0 0 20px 0;
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 15px;
  }

  .ob-bundle__summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .ob-bundle__summary-row.is-discount {
    color: var(--brand-sage-dark);
    font-weight: 500;
  }

  .ob-bundle__summary-row.is-total {
    border-top: 1px solid var(--border-soft);
    padding-top: 15px;
    margin-top: 15px;
    font-size: 18px;
    color: var(--text-charcoal);
    font-weight: 600;
  }

  .ob-bundle__cta {
    width: 100%;
    background-color: var(--brand-sage-dark);
    color: #ffffff;
    border: none;
    padding: 16px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .ob-bundle__cta:hover {
    background-color: var(--brand-sage);
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(112, 127, 99, 0.24);
  }

  .ob-bundle__cta:disabled {
    background-color: var(--border-soft);
    color: var(--text-muted);
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .ob-bundle__success-msg {
    margin-top: 15px;
    font-size: 13px;
    color: var(--brand-sage-dark);
    text-align: center;
    display: none;
    animation: ob-fade-in 0.4s ease forwards;
  }
</style>

