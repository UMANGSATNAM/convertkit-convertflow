<style>
  .ob-highlights { padding: 80px 0; background: {{ section.settings.bg_color }}; }
  .ob-highlights__container { max-width: 1200px; margin: 0 auto; padding: 0 30px; }
  .ob-highlights__header { text-align: center; margin-bottom: 50px; }
  .ob-highlights__title { font-family: 'Georgia', serif; font-size: 32px; color: #2d2a24; margin-bottom: 8px; }
  .ob-highlights__subtitle { font-family: 'Inter', sans-serif; font-size: 14px; color: #8b7355; }
  .ob-highlights__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 25px; }
  @media (max-width: 1024px) { .ob-highlights__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .ob-highlights__grid { grid-template-columns: 1fr; } }
  .ob-prod-card { text-decoration: none; display: block; }
  .ob-prod-card__img { aspect-ratio: 3/4; border-radius: 12px; overflow: hidden; margin-bottom: 15px; background: #f0e8dc; }
  .ob-prod-card__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .ob-prod-card:hover .ob-prod-card__img img { transform: scale(1.05); }
  .ob-prod-card__vendor { font-family: 'Inter', sans-serif; font-size: 11px; color: #c9a96e; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 4px; }
  .ob-prod-card__name { font-family: 'Georgia', serif; font-size: 16px; color: #2d2a24; margin-bottom: 8px; line-height: 1.3; }
  .ob-prod-card__price { font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 600; color: #2d2a24; }
  .ob-prod-card__compare { color: #bbb; text-decoration: line-through; margin-left: 6px; font-size: 13px; }
</style>
<section class="ob-highlights">
  <div class="ob-highlights__container">
    <div class="ob-highlights__header">
      <h2 class="ob-highlights__title">{{ section.settings.title }}</h2>
      <p class="ob-highlights__subtitle">{{ section.settings.subtitle }}</p>
    </div>
    <div class="ob-highlights__grid">
      {% assign col = collections[section.settings.collection] %}
      {% for product in col.products limit: section.settings.limit %}
        <a href="{{ product.url }}" class="ob-prod-card">
          <div class="ob-prod-card__img">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
            {% endif %}
          </div>
          <div class="ob-prod-card__vendor">{{ product.vendor }}</div>
          <h3 class="ob-prod-card__name">{{ product.title }}</h3>
          <div class="ob-prod-card__price">{{ product.price | money }}{% if product.compare_at_price > product.price %}<span class="ob-prod-card__compare">{{ product.compare_at_price | money }}</span>{% endif %}</div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "OB Product Highlights", "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Bestsellers" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Loved by thousands" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" }
  ],
  "presets": [{ "name": "OB Product Highlights" }]
}
{% endschema %}
