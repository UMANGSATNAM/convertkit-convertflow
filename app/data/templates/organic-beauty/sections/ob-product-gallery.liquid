<style>
  .ob-gallery { padding: 40px 0; background: #faf5ef; }
  .ob-gallery__container { max-width: 1200px; margin: 0 auto; padding: 0 30px; }
  .ob-gallery__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
  .ob-gallery__item { aspect-ratio: 1; overflow: hidden; border-radius: 12px; cursor: pointer; }
  .ob-gallery__item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .ob-gallery__item:hover img { transform: scale(1.06); }
</style>
<section class="ob-gallery">
  <div class="ob-gallery__container">
    <div class="ob-gallery__grid">
      {% for image in product.images %}
        <div class="ob-gallery__item"><img src="{{ image | image_url: width: 500 }}" alt="{{ image.alt | escape }}" loading="lazy"></div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{ "name": "OB Product Gallery", "tag": "section", "settings": [], "presets": [{ "name": "OB Product Gallery" }] }
{% endschema %}
