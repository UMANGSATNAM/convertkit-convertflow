<style>
  .ob-hero {
    position: relative;
    width: 100%;
    height: 85vh;
    min-height: 550px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #faf5ef;
  }
  .ob-hero__image {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .ob-hero__overlay {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, rgba(250,245,239,0.9) 0%, rgba(250,245,239,0.4) 60%, transparent 100%);
    z-index: 2;
  }
  .ob-hero__content {
    position: relative;
    z-index: 3;
    max-width: 550px;
    padding: 0 60px;
  }
  .ob-hero__eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 20px;
  }
  .ob-hero__title {
    font-family: 'Georgia', 'Times New Roman', serif;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: normal;
    line-height: 1.15;
    color: #2d2a24;
    margin-bottom: 20px;
  }
  .ob-hero__desc {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.8;
    color: #8b7355;
    margin-bottom: 35px;
  }
  .ob-hero__cta {
    display: inline-block;
    background: {{ section.settings.accent_color }};
    color: #ffffff;
    padding: 14px 40px;
    border-radius: 30px;
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }
  .ob-hero__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px {{ section.settings.accent_color }}30;
  }
</style>

<section class="ob-hero">
  {% if section.settings.image %}
    <img class="ob-hero__image" src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.title | escape }}" loading="eager">
  {% endif %}
  <div class="ob-hero__overlay"></div>
  <div class="ob-hero__content">
    {% if section.settings.eyebrow != blank %}
      <div class="ob-hero__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}
    {% if section.settings.title != blank %}
      <h1 class="ob-hero__title">{{ section.settings.title }}</h1>
    {% endif %}
    {% if section.settings.desc != blank %}
      <p class="ob-hero__desc">{{ section.settings.desc }}</p>
    {% endif %}
    {% if section.settings.btn_label != blank %}
      <a href="{{ section.settings.btn_link }}" class="ob-hero__cta">{{ section.settings.btn_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "OB Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Text", "default": "New Arrival" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Nourish Your Natural Glow" },
    { "type": "text", "id": "desc", "label": "Description", "default": "Clean, plant-based skincare crafted with love for your skin and the planet." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Shop the Collection" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#c9a96e" }
  ],
  "presets": [{ "name": "OB Hero" }]
}
{% endschema %}
