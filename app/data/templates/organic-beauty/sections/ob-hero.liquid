<style>
  .ob-hero {
    position: relative;
    width: 100%;
    height: 90vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .ob-hero__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 120%; /* For parallax */
    object-fit: cover;
    z-index: 1;
    transform: translateY(0);
    transition: transform 0.1s linear;
  }
  .ob-hero__video {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    z-index: 1;
    transform: translate(-50%, -50%);
    object-fit: cover;
  }
  .ob-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.4));
    z-index: 2;
  }
  .ob-hero__content {
    position: relative;
    z-index: 3;
    text-align: center;
    color: {{ section.settings.text_color }};
    max-width: 900px;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .ob-hero__subtitle {
    font-family: var(--ob-font-sans, 'Inter', sans-serif);
    font-size: 14px;
    letter-spacing: 4px;
    text-transform: uppercase;
    margin-bottom: 20px;
    font-weight: 500;
    opacity: 0;
    transform: translateY(20px);
    animation: ob-hero-fade 1s forwards 0.3s;
  }
  .ob-hero__title {
    font-family: var(--ob-font-serif, 'Georgia', serif);
    font-size: clamp(48px, 8vw, 96px);
    font-weight: 400;
    line-height: 1.05;
    margin: 0 0 40px 0;
    letter-spacing: -1px;
    opacity: 0;
    transform: translateY(20px);
    animation: ob-hero-fade 1s forwards 0.5s;
  }
  .ob-hero__btn {
    display: inline-block;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    padding: 18px 50px;
    text-decoration: none;
    font-family: var(--ob-font-sans, 'Inter', sans-serif);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 500;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0;
    transform: translateY(20px);
    animation: ob-hero-fade 1s forwards 0.7s;
  }
  .ob-hero__btn:hover {
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.btn_bg_color }};
  }

  @keyframes ob-hero-fade {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<section class="ob-hero" id="ob-hero-{{ section.id }}">
  {% if section.settings.video_url != blank %}
    <video class="ob-hero__video" autoplay muted loop playsinline>
      <source src="{{ section.settings.video_url }}" type="video/mp4">
    </video>
  {% elsif section.settings.image %}
    <img class="ob-hero__media ob-hero-parallax" src="{{ section.settings.image | image_url }}" alt="{{ section.settings.title | escape }}">
  {% else %}
    <div class="ob-hero__media" style="background-color: #222;"></div>
  {% endif %}
  
  <div class="ob-hero__overlay"></div>
  
  <div class="ob-hero__content">
    {% if section.settings.subtitle != blank %}
      <div class="ob-hero__subtitle">{{ section.settings.subtitle }}</div>
    {% endif %}
    {% if section.settings.title != blank %}
      <h1 class="ob-hero__title">{{ section.settings.title }}</h1>
    {% endif %}
    {% if section.settings.btn_label != blank and section.settings.btn_link != blank %}
      <a href="{{ section.settings.btn_link }}" class="ob-hero__btn">{{ section.settings.btn_label }}</a>
    {% endif %}
  </div>
</section>

<script>
  // Simple Parallax Effect
  window.addEventListener('scroll', () => {
    const parallaxImages = document.querySelectorAll('.ob-hero-parallax');
    const scrollPosition = window.pageYOffset;
    parallaxImages.forEach(img => {
      img.style.transform = `translateY(${scrollPosition * 0.4}px)`;
    });
  });
</script>

{% schema %}
{
  "name": "Premium Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Background Video URL (MP4)",
      "info": "Overrides image if provided."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The New Standard"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Elevate Your Aesthetic"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Premium Hero"
    }
  ]
}
{% endschema %}
