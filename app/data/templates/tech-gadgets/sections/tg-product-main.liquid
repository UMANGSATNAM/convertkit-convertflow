<style>
  .tg-product-main {
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px 20px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    background: #0a0a0a;
    color: #ffffff;
    font-family: var(--tg-font-sans, 'Inter', sans-serif);
  }
  
  /* Gallery Side (Left) */
  .tg-product-gallery {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: sticky;
    top: 100px;
    height: max-content;
  }
  .tg-product-gallery__main {
    border: 1px solid #333;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    background: #111111;
    box-shadow: 0 0 15px rgba(0, 255, 255, 0.1);
  }
  .tg-product-gallery__main img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .tg-product-gallery__main:hover img {
    transform: scale(1.03);
  }
  .tg-product-gallery__thumbnails {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
  }
  .tg-product-gallery__thumbnails img {
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 2px;
    cursor: pointer;
    border: 1px solid #333;
    background: #111111;
    transition: all 0.3s;
  }
  .tg-product-gallery__thumbnails img:hover,
  .tg-product-gallery__thumbnails img.is-active {
    border-color: #00ffff;
    box-shadow: 0 0 8px rgba(0, 255, 255, 0.4);
  }

  /* Info Side (Right) */
  .tg-product-info {
    display: flex;
    flex-direction: column;
  }
  .tg-product-vendor {
    font-size: 12px;
    color: #00ffff;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 12px;
    font-weight: 700;
    text-shadow: 0 0 5px rgba(0, 255, 255, 0.3);
  }
  .tg-product-title {
    font-size: clamp(28px, 3.5vw, 42px);
    line-height: 1.15;
    margin: 0 0 15px 0;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .tg-product-rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 25px;
    font-size: 13px;
    color: #888;
  }
  .tg-product-rating svg {
    width: 14px;
    height: 14px;
    fill: #00ffff;
    filter: drop-shadow(0 0 3px rgba(0, 255, 255, 0.4));
  }
  .tg-product-price-container {
    margin-bottom: 30px;
  }
  .tg-product-price {
    font-size: 28px;
    font-weight: 700;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 15px;
  }
  .tg-product-price s {
    color: #666;
    font-size: 20px;
    font-weight: 400;
  }
  .tg-product-tax-notice {
    font-size: 12px;
    color: #888;
    margin-top: 5px;
  }
  
  /* Variant Selection as Buttons */
  .tg-product-form {
    margin-bottom: 35px;
  }
  .tg-variant-group {
    margin-bottom: 25px;
  }
  .tg-variant-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #888;
  }
  .tg-variant-options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .tg-variant-btn {
    padding: 12px 20px;
    background: #111111;
    border: 1px solid #333;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 2px;
    text-transform: uppercase;
  }
  .tg-variant-btn:hover {
    border-color: #00ffff;
    box-shadow: 0 0 5px rgba(0, 255, 255, 0.2);
  }
  .tg-variant-btn.is-active {
    background: rgba(0, 255, 255, 0.05);
    border-color: #00ffff;
    color: #00ffff;
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.3);
  }
  .tg-variant-btn.is-disabled {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: line-through;
    border-color: #222;
  }

  /* Subscribe & Save Block */
  .tg-sub-card {
    border: 1px solid #333;
    background: #111111;
    padding: 20px;
    border-radius: 4px;
    margin-bottom: 30px;
  }
  .tg-sub-title {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 15px;
    color: #00ffff;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .tg-sub-badge {
    background: #00ffff;
    color: #0a0a0a;
    font-size: 10px;
    padding: 2px 6px;
    font-weight: 800;
    border-radius: 2px;
  }
  .tg-sub-options {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .tg-sub-option {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    padding: 10px;
    border: 1px solid #222;
    border-radius: 2px;
    transition: all 0.2s;
  }
  .tg-sub-option:hover {
    border-color: #444;
  }
  .tg-sub-option.is-selected {
    border-color: #00ffff;
    background: rgba(0, 255, 255, 0.02);
  }
  .tg-sub-option input[type="radio"] {
    accent-color: #00ffff;
    cursor: pointer;
  }
  .tg-sub-details {
    display: flex;
    flex-direction: column;
    font-size: 13px;
  }
  .tg-sub-label {
    font-weight: 600;
  }
  .tg-sub-desc {
    font-size: 11px;
    color: #666;
    margin-top: 2px;
  }

  /* Add to Cart CTA */
  .tg-atc-wrapper {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 15px;
    margin-bottom: 25px;
  }
  .tg-qty-input {
    width: 100%;
    height: 54px;
    background: #111111;
    border: 1px solid #333;
    color: #ffffff;
    text-align: center;
    font-size: 16px;
    font-weight: 600;
    border-radius: 2px;
    outline: none;
    transition: border-color 0.3s;
  }
  .tg-qty-input:focus {
    border-color: #00ffff;
  }
  .tg-add-to-cart {
    height: 54px;
    background: #00ffff;
    color: #0a0a0a;
    border: none;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 2px;
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.2);
  }
  .tg-add-to-cart:hover {
    background: #00bfff;
    box-shadow: 0 0 15px rgba(0, 255, 255, 0.4);
  }
  .tg-add-to-cart:disabled {
    background: #333;
    color: #666;
    cursor: not-allowed;
    box-shadow: none;
  }

  /* Cash on Delivery Badge */
  .tg-cod-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 15px;
    border: 1px dashed rgba(0, 255, 255, 0.3);
    background: rgba(0, 255, 255, 0.02);
    border-radius: 4px;
    margin-bottom: 30px;
  }
  .tg-cod-icon {
    width: 24px;
    height: 24px;
    fill: #00ffff;
  }
  .tg-cod-text {
    font-size: 13px;
    font-weight: 600;
    color: #ffffff;
  }
  .tg-cod-sub {
    font-size: 11px;
    color: #888;
    margin-top: 2px;
  }

  /* Pincode Estimator */
  .tg-pincode {
    border: 1px solid #333;
    background: #111111;
    padding: 20px;
    border-radius: 4px;
    margin-bottom: 30px;
  }
  .tg-pincode__title {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 15px 0;
    color: #888;
  }
  .tg-pincode__form {
    display: flex;
    gap: 10px;
  }
  .tg-pincode__input {
    flex: 1;
    height: 44px;
    background: #0a0a0a;
    border: 1px solid #333;
    color: #ffffff;
    padding: 0 15px;
    font-size: 14px;
    border-radius: 2px;
    outline: none;
  }
  .tg-pincode__input:focus {
    border-color: #00ffff;
  }
  .tg-pincode__btn {
    height: 44px;
    padding: 0 20px;
    background: #111111;
    border: 1px solid #333;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 2px;
    transition: all 0.3s;
  }
  .tg-pincode__btn:hover {
    border-color: #00ffff;
    color: #00ffff;
  }
  .tg-pincode__result {
    margin-top: 12px;
    font-size: 13px;
    display: none;
  }
  .tg-pincode__result.is-success {
    color: #00ffff;
    display: block;
  }
  .tg-pincode__result.is-error {
    color: #ff4444;
    display: block;
  }

  /* WhatsApp Inquiry */
  .tg-whatsapp-inquiry {
    margin-bottom: 35px;
  }
  .tg-btn--whatsapp {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 15px;
    border: 1px solid #25d366;
    background: rgba(37, 211, 102, 0.05);
    color: #25d366;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.3s;
  }
  .tg-btn--whatsapp:hover {
    background: #25d366;
    color: #0a0a0a;
    box-shadow: 0 0 10px rgba(37, 211, 102, 0.3);
  }
  .tg-btn--whatsapp svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Accordion Details */
  .tg-product-accordion {
    border-top: 1px solid #222;
  }
  .tg-accordion-item {
    border-bottom: 1px solid #222;
  }
  .tg-accordion-btn {
    width: 100%;
    padding: 20px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: none;
    border: none;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    cursor: pointer;
    transition: color 0.3s;
  }
  .tg-accordion-btn:hover {
    color: #00ffff;
  }
  .tg-accordion-content {
    padding-bottom: 20px;
    font-size: 13px;
    line-height: 1.6;
    color: #bbb;
    display: none;
  }
  .tg-accordion-content table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }
  .tg-accordion-content td {
    padding: 8px 0;
    border-bottom: 1px solid #1a1a1a;
  }
  .tg-accordion-content td:first-child {
    font-weight: 600;
    color: #888;
    width: 40%;
  }

  @media (max-width: 900px) {
    .tg-product-main {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 30px 15px;
    }
    .tg-product-gallery {
      position: static;
    }
  }
</style>

<div class="tg-product-main">
  <!-- LEFT: Gallery -->
  <div class="tg-product-gallery">
    <div class="tg-product-gallery__main">
      {% if product.featured_image %}
        <img id="tg-main-img" src="{{ product.featured_image | img_url: '1000x' }}" alt="{{ product.title }}">
      {% else %}
        <div style="width:100%; aspect-ratio:1; background:#111; display:flex; align-items:center; justify-content:center; border:1px solid #333;">NO IMAGE DEPLOYED</div>
      {% endif %}
    </div>
    {% if product.images.size > 1 %}
      <div class="tg-product-gallery__thumbnails">
        {% for image in product.images limit: 4 %}
          <img src="{{ image | img_url: '200x' }}" alt="{{ product.title }}" class="tg-thumb {% if forloop.first %}is-active{% endif %}" onclick="changeMainImage('{{ image | img_url: '1000x' }}', this)">
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <!-- RIGHT: Info -->
  <div class="tg-product-info">
    <div class="tg-product-vendor">{{ product.vendor | default: "CIRCUIT LABS" }}</div>
    <h1 class="tg-product-title">{{ product.title | default: "CYBER AUDIO PRO HEADPHONES" }}</h1>
    
    <div class="tg-product-rating">
      <div style="display:flex;gap:3px;">
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
      </div>
      <span>(312 TELEMETRY REVIEWS)</span>
    </div>

    <div class="tg-product-price-container">
      <div class="tg-product-price">
        {% if product %}
          {{ product.selected_or_first_available_variant.price | money }}
          {% if product.compare_at_price > product.price %}
            <s>{{ product.compare_at_price | money }}</s>
          {% endif %}
        {% else %}
          ₹18,999.00 <s>₹24,999.00</s>
        {% endif %}
      </div>
      <div class="tg-product-tax-notice">Inclusive of all GST and duties.</div>
    </div>

    <div class="tg-product-form">
      {% if product %}
        {% form 'product', product %}
          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              <div class="tg-variant-group">
                <label class="tg-variant-label">{{ option.name }}</label>
                <div class="tg-variant-options">
                  {% for value in option.values %}
                    <button type="button" class="tg-variant-btn {% if option.selected_value == value %}is-active{% endif %}" onclick="selectVariantValue('{{ option.name }}', '{{ value }}', this)">
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
            <input type="hidden" name="id" id="tg-variant-id-input" value="{{ product.selected_or_first_available_variant.id }}">
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endunless %}

          <!-- Subscribe & Save Card -->
          <div class="tg-sub-card">
            <div class="tg-sub-title">
              PURCHASE OPTIONS
              <span class="tg-sub-badge">15% SAVINGS DEPLOYED</span>
            </div>
            <div class="tg-sub-options">
              <label class="tg-sub-option is-selected" onclick="toggleSubscribeOption(this)">
                <input type="radio" name="purchase_type" value="one_time" checked>
                <div class="tg-sub-details">
                  <span class="tg-sub-label">One-Time Purchase</span>
                  <span class="tg-sub-desc">Standard checkout order</span>
                </div>
              </label>
              <label class="tg-sub-option" onclick="toggleSubscribeOption(this)">
                <input type="radio" name="purchase_type" value="subscription">
                <div class="tg-sub-details">
                  <span class="tg-sub-label">Auto-Deliver & Save (15% Off)</span>
                  <span class="tg-sub-desc">Deliver every 30 days automatically</span>
                </div>
              </label>
            </div>
          </div>

          <div class="tg-atc-wrapper">
            <input type="number" name="quantity" value="1" min="1" class="tg-qty-input">
            <button type="submit" class="tg-add-to-cart" {% unless product.available %}disabled{% endunless %}>
              {% if product.available %}ADD TO TERMINAL{% else %}OUT OF TELEMETRY{% endif %}
            </button>
          </div>
        {% endform %}
      {% else %}
        <!-- Demo Form for static builders -->
        <div class="tg-variant-group">
          <label class="tg-variant-label">Storage Capacity</label>
          <div class="tg-variant-options">
            <button type="button" class="tg-variant-btn is-active">128 GB</button>
            <button type="button" class="tg-variant-btn">256 GB</button>
            <button type="button" class="tg-variant-btn is-disabled" disabled>512 GB (SOLD OUT)</button>
          </div>
        </div>
        
        <div class="tg-sub-card">
          <div class="tg-sub-title">
            PURCHASE OPTIONS
            <span class="tg-sub-badge">15% SAVINGS DEPLOYED</span>
          </div>
          <div class="tg-sub-options">
            <label class="tg-sub-option is-selected" onclick="toggleSubscribeOption(this)">
              <input type="radio" name="purchase_type_demo" value="one_time" checked>
              <div class="tg-sub-details">
                <span class="tg-sub-label">One-Time Purchase</span>
                <span class="tg-sub-desc">Standard checkout order</span>
              </div>
            </label>
            <label class="tg-sub-option" onclick="toggleSubscribeOption(this)">
              <input type="radio" name="purchase_type_demo" value="subscription">
              <div class="tg-sub-details">
                <span class="tg-sub-label">Auto-Deliver & Save (15% Off)</span>
                <span class="tg-sub-desc">Deliver every 30 days automatically</span>
              </div>
            </label>
          </div>
        </div>

        <div class="tg-atc-wrapper">
          <input type="number" value="1" min="1" class="tg-qty-input">
          <button type="button" class="tg-add-to-cart">ADD TO TERMINAL</button>
        </div>
      {% endif %}
    </div>

    <!-- COD availability badge -->
    <div class="tg-cod-badge">
      <svg class="tg-cod-icon" viewBox="0 0 24 24">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.04-.42 1.99-1.07 2.75z"/>
      </svg>
      <div>
        <div class="tg-cod-text">Cash on Delivery (COD) Available</div>
        <div class="tg-cod-sub">Verify pincode below for exact logistics timelines.</div>
      </div>
    </div>

    <!-- Pincode Estimator -->
    <div class="tg-pincode">
      <h3 class="tg-pincode__title">LOGISTICS SERVICEABILITY CHECKER</h3>
      <div class="tg-pincode__form">
        <input type="text" class="tg-pincode__input" id="pincode-input-{{ section.id }}" placeholder="Enter 6-digit Pincode" maxlength="6">
        <button type="button" class="tg-pincode__btn" id="pincode-btn-{{ section.id }}">CHECK STATUS</button>
      </div>
      <div class="tg-pincode__result" id="pincode-result-{{ section.id }}"></div>
    </div>

    <!-- WhatsApp Enquiry -->
    <div class="tg-whatsapp-inquiry">
      <a href="https://wa.me/919999999999?text=Hi,%20I'm%20interested%20in%20the%20Circuit%20Consumer%20Electronics%20product." class="tg-btn--whatsapp" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.734-1.456L0 24h.057zM6.578 5.891c-.22-.489-.452-.498-.661-.507-.172-.008-.37-.008-.567-.008-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.15-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.075-.149-.661-1.597-.908-2.185z"/>
        </svg>
        Connect with our Tech Desk
      </a>
    </div>

    <!-- Accordion Details -->
    <div class="tg-product-accordion">
      <div class="tg-accordion-item">
        <button class="tg-accordion-btn" onclick="toggleAccordion(this)">
          Technical Specifications <span>+</span>
        </button>
        <div class="tg-accordion-content">
          <table>
            <tr>
              <td>Chipset</td>
              <td>Custom 5nm Octa-Core Processor</td>
            </tr>
            <tr>
              <td>Thermal Output</td>
              <td>Dual Liquid-Vapor Chambers</td>
            </tr>
            <tr>
              <td>Battery Capacity</td>
              <td>48 Hours Active (Continuous Telemetry)</td>
            </tr>
            <tr>
              <td>GaN Input</td>
              <td>100W Fast Charge Compatible</td>
            </tr>
            <tr>
              <td>Alloy Shell</td>
              <td>CNC Machined Aluminum</td>
            </tr>
          </table>
        </div>
      </div>
      <div class="tg-accordion-item">
        <button class="tg-accordion-btn" onclick="toggleAccordion(this)">
          Shipping & Logistics <span>+</span>
        </button>
        <div class="tg-accordion-content">
          We offer dispatch within 24 hours from our warehouses. Free standard shipping applies to all orders over ₹4,999. Logistics validation is done instantly.
        </div>
      </div>
      <div class="tg-accordion-item">
        <button class="tg-accordion-btn" onclick="toggleAccordion(this)">
          Warranty & Repairs <span>+</span>
        </button>
        <div class="tg-accordion-content">
          Includes an official 2-year on-site replacement warranty across India. Telemetry logs must be provided for direct verification processing.
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  function changeMainImage(src, element) {
    document.getElementById('tg-main-img').src = src;
    document.querySelectorAll('.tg-thumb').forEach(thumb => {
      thumb.classList.remove('is-active');
    });
    element.classList.add('is-active');
  }

  function toggleSubscribeOption(element) {
    document.querySelectorAll('.tg-sub-option').forEach(opt => {
      opt.classList.remove('is-selected');
    });
    element.classList.add('is-selected');
    const radio = element.querySelector('input[type="radio"]');
    if (radio) radio.checked = true;
  }

  function toggleAccordion(element) {
    const content = element.nextElementSibling;
    const isVisible = content.style.display === 'block';
    content.style.display = isVisible ? 'none' : 'block';
    element.querySelector('span').innerText = isVisible ? '+' : '-';
  }

  // Simple dynamic variant selector placeholder
  function selectVariantValue(optionName, value, element) {
    const group = element.closest('.tg-variant-options');
    group.querySelectorAll('.tg-variant-btn').forEach(btn => {
      btn.classList.remove('is-active');
    });
    element.classList.add('is-active');
  }

  // Local Pincode Checker JS
  document.addEventListener('DOMContentLoaded', () => {
    const pinBtn = document.getElementById("pincode-btn-{{ section.id }}");
    const pinInput = document.getElementById("pincode-input-{{ section.id }}");
    const pinResult = document.getElementById("pincode-result-{{ section.id }}");

    if (pinBtn && pinInput && pinResult) {
      pinBtn.addEventListener("click", () => {
        const pin = pinInput.value.trim();
        if (/^\d{6}$/.test(pin)) {
          pinResult.innerText = "✓ Serviceable: Delivered within 3-5 business days. Cash on Delivery (COD) is available.";
          pinResult.className = "tg-pincode__result is-success";
        } else {
          pinResult.innerText = "✗ Invalid Pincode: Please enter a valid 6-digit Indian pincode.";
          pinResult.className = "tg-pincode__result is-error";
        }
      });
    }
  });
</script>

