<style>
  .tg-marquee-section {
    background: {{ section.settings.bg_color | default: '#0a0a0a' }};
    border-top: 1px solid #222;
    border-bottom: 1px solid #222;
    padding: 15px 0;
    overflow: hidden;
    position: relative;
    user-select: none;
  }
  .tg-marquee-track {
    display: flex;
    white-space: nowrap;
    width: max-content;
    animation: tg-marquee-scroll 25s linear infinite;
  }
  .tg-marquee-item {
    font-family: var(--tg-font-sans, 'Inter', sans-serif);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
    color: {{ section.settings.text_color | default: '#00ffff' }};
    padding: 0 40px;
    text-transform: uppercase;
    display: inline-block;
    text-shadow: 0 0 8px rgba(0, 255, 255, 0.4);
  }
  
  @keyframes tg-marquee-scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tg-marquee-track {
      animation-play-state: paused;
    }
  }
</style>

<section class="tg-marquee-section">
  <div class="tg-marquee-track">
    {% for i in (1..6) %}
      <div class="tg-marquee-item">
        {{ section.settings.text | default: "NEXT-GEN INTEGRATION // ULTRA-PERFORMANCE // 100% SECURE CHECKOUT // INR ₹ CURRENCY SUPPORTED // CASH ON DELIVERY AVAILABLE" }}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Features Marquee",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Marquee Text",
      "default": "NEXT-GEN INTEGRATION // ULTRA-PERFORMANCE // 100% SECURE CHECKOUT // INR ₹ CURRENCY SUPPORTED // CASH ON DELIVERY AVAILABLE"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#00ffff"
    }
  ],
  "presets": [
    {
      "name": "Features Marquee"
    }
  ]
}
{% endschema %}
