<style>
  .tg-complementary {
    padding: 60px 0;
    background: #0d0d16;
  }
  .tg-complementary__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 30px;
  }
  .tg-complementary__title {
    font-family: 'Inter', sans-serif;
    font-size: 22px;
    font-weight: 800;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 30px;
    text-align: center;
  }
  .tg-complementary__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  @media (max-width: 768px) {
    .tg-complementary__grid { grid-template-columns: repeat(2, 1fr); }
  }
  .tg-comp-card {
    background: #111122;
    border: 1px solid rgba(0,240,255,0.05);
    text-decoration: none;
    display: block;
    transition: all 0.3s ease;
  }
  .tg-comp-card:hover {
    border-color: rgba(0,240,255,0.2);
    transform: translateY(-3px);
  }
  .tg-comp-card__img {
    aspect-ratio: 1;
    overflow: hidden;
    background: #0a0a15;
  }
  .tg-comp-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .tg-comp-card:hover .tg-comp-card__img img { transform: scale(1.05); }
  .tg-comp-card__info { padding: 14px; }
  .tg-comp-card__name {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #ccc;
    margin-bottom: 6px;
    line-height: 1.3;
  }
  .tg-comp-card__price {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #fff;
  }
</style>

<section class="tg-complementary">
  <div class="tg-complementary__container">
    <h2 class="tg-complementary__title">{{ section.settings.title }}</h2>
    <div class="tg-complementary__grid">
      {% assign rec = recommendations.products %}
      {% if rec.size > 0 %}
        {% for product in rec limit: 4 %}
          <a href="{{ product.url }}" class="tg-comp-card">
            <div class="tg-comp-card__img">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
              {% endif %}
            </div>
            <div class="tg-comp-card__info">
              <div class="tg-comp-card__name">{{ product.title }}</div>
              <div class="tg-comp-card__price">{{ product.price | money }}</div>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TG Complementary Products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "You Might Also Like" }
  ],
  "presets": [{ "name": "TG Complementary Products" }]
}
{% endschema %}
