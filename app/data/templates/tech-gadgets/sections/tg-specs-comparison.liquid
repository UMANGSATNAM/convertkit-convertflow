<style>
  .tg-specs-comp-section {
    background: {{ section.settings.bg_color | default: '#0a0a0a' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    padding: 60px 20px;
    font-family: var(--tg-font-sans, 'Inter', sans-serif);
  }
  .tg-specs-comp-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .tg-specs-comp-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .tg-specs-comp-subtitle {
    color: #00ffff;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 10px;
  }
  .tg-specs-comp-title {
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 700;
    letter-spacing: 1px;
    margin: 0;
    text-transform: uppercase;
  }
  .tg-specs-comp-table-wrapper {
    overflow-x: auto;
    border: 1px solid #333;
    border-radius: 4px;
    background: #111111;
  }
  .tg-specs-comp-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 600px;
  }
  .tg-specs-comp-table th, 
  .tg-specs-comp-table td {
    padding: 20px;
    border-bottom: 1px solid #222;
  }
  .tg-specs-comp-table th {
    background: #161616;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 600;
    color: #888;
  }
  .tg-specs-comp-table th.tg-specs-comp-highlight {
    color: #00ffff;
    border-left: 1px solid #00ffff;
    border-right: 1px solid #00ffff;
    background: rgba(0, 255, 255, 0.05);
  }
  .tg-specs-comp-table td.tg-specs-comp-highlight {
    border-left: 1px solid #00ffff;
    border-right: 1px solid #00ffff;
    background: rgba(0, 255, 255, 0.03);
    font-weight: 500;
  }
  .tg-specs-comp-table tr:last-child td {
    border-bottom: none;
  }
  .tg-specs-comp-table tr:last-child td.tg-specs-comp-highlight {
    border-bottom: 1px solid #00ffff;
  }
  .tg-specs-comp-table tr:first-child th.tg-specs-comp-highlight {
    border-top: 1px solid #00ffff;
  }
  .tg-specs-comp-icon {
    width: 20px;
    height: 20px;
    vertical-align: middle;
  }
  .tg-specs-comp-icon--check {
    fill: #00ffff;
  }
  .tg-specs-comp-icon--cross {
    fill: #ff4444;
  }
  .tg-specs-comp-label {
    font-weight: 500;
    color: #bbb;
  }
</style>

<section class="tg-specs-comp-section">
  <div class="tg-specs-comp-container">
    <div class="tg-specs-comp-header">
      <div class="tg-specs-comp-subtitle">{{ section.settings.subtitle | default: "HARDWARE VERIFICATION" }}</div>
      <h2 class="tg-specs-comp-title">{{ section.settings.title | default: "SPECIFICATION COMPARISON" }}</h2>
    </div>

    <div class="tg-specs-comp-table-wrapper">
      <table class="tg-specs-comp-table">
        <thead>
          <tr>
            <th>FEATURE PARAMETER</th>
            <th class="tg-specs-comp-highlight">OUR DEVICE</th>
            <th>TRADITIONAL BRANDS</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="tg-specs-comp-label">Processing Chipset</td>
            <td class="tg-specs-comp-highlight">5nm Custom Octa-Core API-V2</td>
            <td>12nm Standard Dual-Core</td>
          </tr>
          <tr>
            <td class="tg-specs-comp-label">Active Thermal Cooling</td>
            <td class="tg-specs-comp-highlight">
              <svg class="tg-specs-comp-icon tg-specs-comp-icon--check" viewBox="0 0 20 20">
                <path d="M0 11l2-2 5 5L18 3l2 2L7 18z"/>
              </svg>
              Dual Liquid Vapor
            </td>
            <td>
              <svg class="tg-specs-comp-icon tg-specs-comp-icon--cross" viewBox="0 0 20 20">
                <path d="M10 8.586L2.929 1.515 1.515 2.929 8.586 10l-7.071 7.071 1.414 1.414L10 11.414l7.071 7.071 1.414-1.414L11.414 10l7.071-7.071-1.414-1.414L10 8.586z"/>
              </svg>
              Passive Heat Spreading
            </td>
          </tr>
          <tr>
            <td class="tg-specs-comp-label">Battery Endurance</td>
            <td class="tg-specs-comp-highlight">Up to 48 Hours Active</td>
            <td>8 - 10 Hours Max</td>
          </tr>
          <tr>
            <td class="tg-specs-comp-label">Charging Input</td>
            <td class="tg-specs-comp-highlight">100W GaN Fast Charging</td>
            <td>18W Standard Charging</td>
          </tr>
          <tr>
            <td class="tg-specs-comp-label">Outer Chassis Shell</td>
            <td class="tg-specs-comp-highlight">Aerospace-Grade Alloy</td>
            <td>Standard Grade ABS Plastic</td>
          </tr>
          <tr>
            <td class="tg-specs-comp-label">Official India Warranty</td>
            <td class="tg-specs-comp-highlight">
              <svg class="tg-specs-comp-icon tg-specs-comp-icon--check" viewBox="0 0 20 20">
                <path d="M0 11l2-2 5 5L18 3l2 2L7 18z"/>
              </svg>
              2 Years On-Site Replacement
            </td>
            <td>1 Year Carry-In Service</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Specs Comparison Grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SPECIFICATION COMPARISON"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "HARDWARE VERIFICATION"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Specs Comparison Grid"
    }
  ]
}
{% endschema %}
