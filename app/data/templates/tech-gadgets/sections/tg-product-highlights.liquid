<style>
  .tg-highlights {
    padding: 80px 0;
    background-color: {{ section.settings.bg_color }};
  }
  .tg-highlights__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 30px;
  }
  .tg-highlights__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
    border-bottom: 1px solid rgba(0,240,255,0.1);
    padding-bottom: 20px;
  }
  .tg-highlights__title {
    font-family: 'Inter', sans-serif;
    font-size: 32px;
    font-weight: 800;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .tg-highlights__link {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: {{ section.settings.accent_color }};
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: opacity 0.3s;
  }
  .tg-highlights__link:hover { opacity: 0.7; }
  .tg-highlights__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  @media (max-width: 1024px) {
    .tg-highlights__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .tg-highlights__grid { grid-template-columns: 1fr; }
  }
  .tg-product-card {
    background: #111122;
    border: 1px solid rgba(0,240,255,0.08);
    transition: all 0.4s ease;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .tg-product-card:hover {
    border-color: {{ section.settings.accent_color }};
    transform: translateY(-4px);
    box-shadow: 0 10px 40px rgba(0,240,255,0.1);
  }
  .tg-product-card__image-wrap {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #0d0d1a;
  }
  .tg-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .tg-product-card:hover .tg-product-card__image {
    transform: scale(1.08);
  }
  .tg-product-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: {{ section.settings.accent_color }};
    color: #0a0a0a;
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 10px;
  }
  .tg-product-card__info {
    padding: 20px;
  }
  .tg-product-card__vendor {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    color: {{ section.settings.accent_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 6px;
  }
  .tg-product-card__name {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 10px;
    line-height: 1.3;
  }
  .tg-product-card__price {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 800;
    color: #ffffff;
  }
  .tg-product-card__compare {
    font-size: 13px;
    color: #666;
    text-decoration: line-through;
    margin-left: 8px;
  }
</style>

<section class="tg-highlights">
  <div class="tg-highlights__container">
    <div class="tg-highlights__header">
      <h2 class="tg-highlights__title">{{ section.settings.title }}</h2>
      {% if section.settings.collection != blank %}
        <a href="{{ collections[section.settings.collection].url }}" class="tg-highlights__link">View All →</a>
      {% endif %}
    </div>
    <div class="tg-highlights__grid">
      {% assign col = collections[section.settings.collection] %}
      {% assign limit = section.settings.limit | default: 4 %}
      {% for product in col.products limit: limit %}
        <a href="{{ product.url }}" class="tg-product-card">
          <div class="tg-product-card__image-wrap">
            {% if product.featured_image %}
              <img class="tg-product-card__image" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
            {% endif %}
            {% if product.compare_at_price > product.price %}
              <span class="tg-product-card__badge">Sale</span>
            {% endif %}
          </div>
          <div class="tg-product-card__info">
            <div class="tg-product-card__vendor">{{ product.vendor }}</div>
            <h3 class="tg-product-card__name">{{ product.title }}</h3>
            <div class="tg-product-card__price">
              {{ product.price | money }}
              {% if product.compare_at_price > product.price %}
                <span class="tg-product-card__compare">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TG Product Highlights",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Featured Gear" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to Show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0d0d16" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#00f0ff" }
  ],
  "presets": [{ "name": "TG Product Highlights" }]
}
{% endschema %}
