<style>
  .tg-gallery {
    padding: 60px 0;
    background: #0a0a0a;
  }
  .tg-gallery__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 30px;
  }
  .tg-gallery__title {
    font-family: 'Inter', sans-serif;
    font-size: 28px;
    font-weight: 800;
    color: #fff;
    text-transform: uppercase;
    text-align: center;
    margin-bottom: 40px;
  }
  .tg-gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 4px;
  }
  .tg-gallery__item {
    aspect-ratio: 1;
    overflow: hidden;
    position: relative;
    cursor: pointer;
  }
  .tg-gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.4s ease;
    filter: brightness(0.8);
  }
  .tg-gallery__item:hover img {
    transform: scale(1.1);
    filter: brightness(1);
  }
</style>

<section class="tg-gallery">
  <div class="tg-gallery__container">
    {% if section.settings.title != blank %}
      <h2 class="tg-gallery__title">{{ section.settings.title }}</h2>
    {% endif %}
    <div class="tg-gallery__grid">
      {% for image in product.images %}
        <div class="tg-gallery__item">
          <img src="{{ image | image_url: width: 400 }}" alt="{{ image.alt | escape }}" loading="lazy">
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TG Product Gallery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Product Gallery" }
  ],
  "presets": [{ "name": "TG Product Gallery" }]
}
{% endschema %}
