<style>
  .tg-header {
    position: fixed;
    top: 0; left: 0;
    width: 100%;
    z-index: 100;
    background: rgba(10,10,10,0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(0,240,255,0.08);
    transition: background 0.3s;
  }
  .tg-header__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 70px;
  }
  .tg-header__logo {
    font-family: 'Inter', sans-serif;
    font-size: 22px;
    font-weight: 900;
    color: #ffffff;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 3px;
  }
  .tg-header__logo span {
    color: {{ section.settings.accent_color }};
  }
  .tg-header__nav {
    display: flex;
    align-items: center;
    gap: 35px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 768px) {
    .tg-header__nav { display: none; }
  }
  .tg-header__nav-link {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: #999;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: color 0.3s;
  }
  .tg-header__nav-link:hover { color: {{ section.settings.accent_color }}; }
  .tg-header__actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .tg-header__action {
    background: none;
    border: none;
    color: #999;
    font-size: 20px;
    cursor: pointer;
    transition: color 0.3s;
    text-decoration: none;
    position: relative;
  }
  .tg-header__action:hover { color: {{ section.settings.accent_color }}; }
  .tg-header__cart-count {
    position: absolute;
    top: -6px;
    right: -8px;
    background: {{ section.settings.accent_color }};
    color: #0a0a0a;
    font-family: 'Inter', sans-serif;
    font-size: 9px;
    font-weight: 800;
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tg-header__mobile-toggle {
    display: none;
    background: none;
    border: none;
    color: #fff;
    font-size: 24px;
    cursor: pointer;
  }
  @media (max-width: 768px) {
    .tg-header__mobile-toggle { display: block; }
  }
</style>

<header class="tg-header">
  <div class="tg-header__container">
    <a href="/" class="tg-header__logo">
      {{ section.settings.logo_text }}<span>.</span>
    </a>
    <nav>
      <ul class="tg-header__nav">
        {% for block in section.blocks %}
          <li>
            <a href="{{ block.settings.link }}" class="tg-header__nav-link">{{ block.settings.label }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
    <div class="tg-header__actions">
      <a href="/search" class="tg-header__action">🔍</a>
      <a href="/account" class="tg-header__action">👤</a>
      <button class="tg-header__action" onclick="document.getElementById('tg-cart-drawer').classList.add('active'); document.getElementById('tg-cart-overlay').classList.add('active');">
        🛒
        {% if cart.item_count > 0 %}
          <span class="tg-header__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </button>
      <button class="tg-header__mobile-toggle" onclick="document.querySelector('.tg-header__nav').style.display = document.querySelector('.tg-header__nav').style.display === 'flex' ? 'none' : 'flex'">☰</button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "TG Header",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo Text", "default": "TechStore" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#00f0ff" }
  ],
  "blocks": [
    {
      "type": "nav_item",
      "name": "Nav Item",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{
    "name": "TG Header",
    "blocks": [
      { "type": "nav_item", "settings": { "label": "Shop", "link": "/collections/all" }},
      { "type": "nav_item", "settings": { "label": "New Arrivals", "link": "/collections/new" }},
      { "type": "nav_item", "settings": { "label": "Deals", "link": "/collections/sale" }},
      { "type": "nav_item", "settings": { "label": "About", "link": "/pages/about" }}
    ]
  }]
}
{% endschema %}
