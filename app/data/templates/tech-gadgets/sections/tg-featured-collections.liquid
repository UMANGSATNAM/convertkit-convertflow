<style>
  .tg-collections {
    padding: 80px 0;
    background-color: {{ section.settings.bg_color }};
  }
  .tg-collections__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 30px;
  }
  .tg-collections__header {
    text-align: center;
    margin-bottom: 60px;
  }
  .tg-collections__title {
    font-family: 'Inter', sans-serif;
    font-size: 36px;
    font-weight: 800;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 10px;
  }
  .tg-collections__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #666;
    letter-spacing: 1px;
  }
  .tg-collections__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 768px) {
    .tg-collections__grid {
      grid-template-columns: 1fr;
    }
  }
  .tg-collection-card {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4/5;
    border: 1px solid rgba(0,240,255,0.1);
    transition: all 0.4s ease;
  }
  .tg-collection-card:hover {
    border-color: {{ section.settings.accent_color }};
    box-shadow: 0 0 30px {{ section.settings.accent_color }}20;
  }
  .tg-collection-card:hover .tg-collection-card__image {
    transform: scale(1.05);
    filter: brightness(0.5);
  }
  .tg-collection-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.6);
    transition: all 0.6s ease;
  }
  .tg-collection-card__content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 30px;
    background: linear-gradient(transparent, rgba(10,10,10,0.95));
  }
  .tg-collection-card__name {
    font-family: 'Inter', sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .tg-collection-card__count {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: {{ section.settings.accent_color }};
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .tg-collection-card__arrow {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255,255,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 18px;
    transition: all 0.3s ease;
    opacity: 0;
  }
  .tg-collection-card:hover .tg-collection-card__arrow {
    opacity: 1;
    border-color: {{ section.settings.accent_color }};
    color: {{ section.settings.accent_color }};
  }
</style>

<section class="tg-collections">
  <div class="tg-collections__container">
    <div class="tg-collections__header">
      <h2 class="tg-collections__title">{{ section.settings.title }}</h2>
      <p class="tg-collections__subtitle">{{ section.settings.subtitle }}</p>
    </div>
    <div class="tg-collections__grid">
      {% for block in section.blocks %}
        {% assign col = collections[block.settings.collection] %}
        <a href="{{ col.url | default: '#' }}" class="tg-collection-card" {{ block.shopify_attributes }}>
          {% if col.image %}
            <img class="tg-collection-card__image" src="{{ col.image | image_url: width: 800 }}" alt="{{ col.title | escape }}" loading="lazy">
          {% else %}
            <div class="tg-collection-card__image" style="background: linear-gradient(135deg, #1a1a2e, #0a0a0a);"></div>
          {% endif %}
          <div class="tg-collection-card__content">
            <h3 class="tg-collection-card__name">{{ block.settings.title | default: col.title | default: 'Collection' }}</h3>
            <span class="tg-collection-card__count">{{ col.products_count | default: 0 }} Products</span>
          </div>
          <div class="tg-collection-card__arrow">→</div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TG Featured Collections",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop Categories" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Browse our tech lineup" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0a0a0a" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#00f0ff" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Override Title" }
      ]
    }
  ],
  "presets": [{ "name": "TG Featured Collections" }]
}
{% endschema %}
