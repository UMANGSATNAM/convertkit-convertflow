<style>.tg-logos{padding:60px 20px;text-align:center;border-top:1px solid #eee;border-bottom:1px solid #eee}.tg-logos p{font-size:12px;text-transform:uppercase;letter-spacing:3px;color:#888;margin-bottom:30px}.tg-logos-grid{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:50px;max-width:1000px;margin:0 auto}.tg-logo-item{width:120px;opacity:0.5;filter:grayscale(100%);transition:all 0.3s}.tg-logo-item:hover{opacity:1;filter:grayscale(0%)}</style><section class="tg-logos"><p>{{ section.settings.title }}</p><div class="tg-logos-grid">{% for block in section.blocks %}<img class="tg-logo-item" src="{{ block.settings.image | image_url }}" alt="Logo">{% endfor %}</div></section>{% schema %}{"name":"Logo List","settings":[{"type":"text","id":"title","label":"Heading","default":"Featured In"}],"blocks":[{"type":"logo","name":"Logo","settings":[{"type":"image_picker","id":"image","label":"Image"}]}],"presets":[{"name":"Logo List"}]}{% endschema %}