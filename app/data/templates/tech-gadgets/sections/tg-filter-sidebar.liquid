<style>
  .tg-sidebar {
    padding-right: 40px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }
  .tg-sidebar__title {
    font-family: 'Georgia', serif;
    font-size: 20px;
    margin-bottom: 20px;
  }
  .tg-filter-group {
    margin-bottom: 25px;
    border-bottom: 1px solid #eaeaea;
    padding-bottom: 20px;
  }
  .tg-filter-group__title {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 15px;
    font-weight: bold;
  }
  .tg-filter-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tg-filter-list li {
    margin-bottom: 10px;
  }
  .tg-filter-list label {
    display: flex;
    align-items: center;
    font-size: 14px;
    cursor: pointer;
  }
  .tg-filter-list input {
    margin-right: 10px;
  }
</style>

<div class="tg-sidebar">
  <h2 class="tg-sidebar__title">Filters</h2>
  
  <form id="CollectionFiltersForm">
    {% for filter in collection.filters %}
      <div class="tg-filter-group">
        <div class="tg-filter-group__title">{{ filter.label }}</div>
        
        {% case filter.type %}
          {% when 'list' %}
            <ul class="tg-filter-list">
              {% for value in filter.values %}
                <li>
                  <label>
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      {% if value.count == 0 and value.active == false %}disabled{% endif %}
                    >
                    {{ value.label }} ({{ value.count }})
                  </label>
                </li>
              {% endfor %}
            </ul>
          {% when 'price_range' %}
            <div style="display:flex; gap:10px; align-items:center;">
              <input type="number" name="{{ filter.min_value.param_name }}" placeholder="Min" style="width:100%; padding:8px; border:1px solid #eaeaea;">
              <span>-</span>
              <input type="number" name="{{ filter.max_value.param_name }}" placeholder="Max" style="width:100%; padding:8px; border:1px solid #eaeaea;">
            </div>
        {% endcase %}
      </div>
    {% endfor %}
    
    <button type="submit" style="width:100%; padding: 12px; background:#000; color:#fff; border:none; text-transform:uppercase; letter-spacing:1px; cursor:pointer;">Apply Filters</button>
  </form>
</div>

{% schema %}
{
  "name": "TG Filter Sidebar",
  "tag": "section",
  "settings": [],
  "templates": ["collection"],
  "presets": [
    {
      "name": "TG Filter Sidebar"
    }
  ]
}
{% endschema %}
