<style>
  .pj-size-guide { padding: 80px 0; background: #fff; }
  .pj-size-guide__container { max-width: 1000px; margin: 0 auto; padding: 0 30px; text-align: center; }
  .pj-size-guide__title { font-family: 'Nunito', sans-serif; font-size: 32px; font-weight: 900; color: #333; margin-bottom: 40px; }
  .pj-size-guide__table-wrapper { background: #fdf8f5; border-radius: 30px; padding: 30px; overflow-x: auto; box-shadow: 0 10px 30px rgba(0,0,0,0.03); border: 2px dashed #eee; }
  .pj-size-guide__table { width: 100%; border-collapse: collapse; min-width: 600px; }
  .pj-size-guide__table th, .pj-size-guide__table td { padding: 15px; text-align: left; font-family: 'Nunito', sans-serif; border-bottom: 1px solid #eee; }
  .pj-size-guide__table th { font-size: 18px; font-weight: 900; color: {{ section.settings.accent_color }}; }
  .pj-size-guide__table td { font-size: 16px; font-weight: 700; color: #666; }
  .pj-size-guide__table tr:last-child td { border-bottom: none; }
  .pj-size-guide__icon { font-size: 24px; margin-right: 10px; vertical-align: middle; }
</style>
<section class="pj-size-guide">
  <div class="pj-size-guide__container">
    <h2 class="pj-size-guide__title">{{ section.settings.title }} 📏</h2>
    <div class="pj-size-guide__table-wrapper">
      <table class="pj-size-guide__table">
        <thead>
          <tr>
            <th>Size</th>
            <th>Weight Range</th>
            <th>Typical Breeds</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><span class="pj-size-guide__icon">🐕</span> Small</td>
            <td>Up to 15 lbs</td>
            <td>Chihuahua, Pomeranian, Yorkie</td>
          </tr>
          <tr>
            <td><span class="pj-size-guide__icon">🐩</span> Medium</td>
            <td>16 - 40 lbs</td>
            <td>Beagle, French Bulldog, Corgi</td>
          </tr>
          <tr>
            <td><span class="pj-size-guide__icon">🦮</span> Large</td>
            <td>41 - 80 lbs</td>
            <td>Labrador, Golden Retriever, Boxer</td>
          </tr>
          <tr>
            <td><span class="pj-size-guide__icon">🐎</span> X-Large</td>
            <td>Over 80 lbs</td>
            <td>Great Dane, Mastiff, Saint Bernard</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "PJ Pet Size Guide", "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Find the Perfect Fit" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#ff9f1c" }
  ],
  "presets": [{ "name": "PJ Pet Size Guide" }]
}
{% endschema %}
