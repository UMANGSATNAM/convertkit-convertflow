<style>.pj-ig{max-width:1400px;margin:80px auto;padding:0 20px;text-align:center}.pj-ig p{font-size:12px;text-transform:uppercase;letter-spacing:3px;color:#888;margin-bottom:10px}.pj-ig h2{font-size:36px;margin-bottom:40px}.pj-ig-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:15px}.pj-ig-item{aspect-ratio:1;background:#eee;position:relative;overflow:hidden}.pj-ig-item img{width:100%;height:100%;object-fit:cover;transition:transform 0.4s}.pj-ig-item:hover img{transform:scale(1.1)}@media(max-width:768px){.pj-ig-grid{grid-template-columns:repeat(2,1fr)}}</style><section class="pj-ig"><p>Follow Us</p><h2>{{ section.settings.title }}</h2><div class="pj-ig-grid">{% for block in section.blocks %}<div class="pj-ig-item"><img src="{{ block.settings.image | img_url: '500x' }}" alt="Instagram Post"></div>{% endfor %}</div></section>{% schema %}{"name":"Instagram Feed Mockup","settings":[{"type":"text","id":"title","label":"Heading","default":"@YourBrandName"}],"blocks":[{"type":"post","name":"IG Post","settings":[{"type":"image_picker","id":"image","label":"Image"}]}],"presets":[{"name":"Instagram Feed Mockup"}]}{% endschema %}