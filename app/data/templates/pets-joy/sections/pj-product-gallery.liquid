<style>
  .pj-gallery { padding: 40px 0; background: #fff; }
  .pj-gallery__container { max-width: 1200px; margin: 0 auto; padding: 0 30px; }
  .pj-gallery__main { width: 100%; aspect-ratio: 1; border-radius: 30px; overflow: hidden; background: #fdf8f5; margin-bottom: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); }
  .pj-gallery__main img { width: 100%; height: 100%; object-fit: cover; }
  .pj-gallery__thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); gap: 15px; }
  .pj-gallery__thumb { aspect-ratio: 1; border-radius: 16px; overflow: hidden; background: #fdf8f5; cursor: pointer; border: 2px solid transparent; transition: border-color 0.3s; }
  .pj-gallery__thumb:hover { border-color: #ff9f1c; }
  .pj-gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }
</style>
<section class="pj-gallery">
  <div class="pj-gallery__container">
    <div class="pj-gallery__main">
      <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" id="pj-main-img">
    </div>
    <div class="pj-gallery__thumbs">
      {% for image in product.images %}
        <div class="pj-gallery__thumb" onclick="document.getElementById('pj-main-img').src='{{ image | image_url: width: 800 }}'"><img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | escape }}" loading="lazy"></div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{ "name": "PJ Product Gallery", "tag": "section", "settings": [], "presets": [{ "name": "PJ Product Gallery" }] }
{% endschema %}
