<style>
  .pj-showcase {
    padding: 80px 5%;
    background-color: {{ section.settings.bg_color }};
  }
  .pj-showcase__header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 50px auto;
  }
  .pj-showcase__subtitle {
    font-family: var(--pj-font-sans, 'Inter', sans-serif);
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #ff9f1c;
    font-weight: 700;
    margin-bottom: 12px;
    display: block;
  }
  .pj-showcase__title {
    font-family: var(--pj-font-serif, 'Georgia', serif);
    font-size: clamp(28px, 5vw, 42px);
    font-weight: 400;
    line-height: 1.2;
    color: #333333;
    margin: 0;
  }
  .pj-showcase__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    max-width: 1300px;
    margin: 0 auto;
  }
  @media (min-width: 600px) {
    .pj-showcase__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .pj-showcase__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1440px) {
    .pj-showcase__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .pj-feature-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 24px;
    background-color: #ffffff;
    border: 2px solid #ffe3c1;
    border-radius: 20px;
    color: #333333;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    opacity: 0;
    transform: translateY(20px);
  }
  .pj-feature-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .pj-feature-card:hover {
    transform: translateY(-6px) scale(1.03);
    border-color: #ff9f1c;
    box-shadow: 0 12px 24px rgba(255, 159, 28, 0.08);
  }
  .pj-feature-card:nth-child(even):hover {
    border-color: #2ec4b6;
    box-shadow: 0 12px 24px rgba(46, 196, 182, 0.08);
  }
  .pj-feature-card__icon-container {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #fff6eb;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ff9f1c;
    transition: all 0.3s ease;
  }
  .pj-feature-card:nth-child(even) .pj-feature-card__icon-container {
    background-color: #eafbf9;
    color: #2ec4b6;
  }
  .pj-feature-card:hover .pj-feature-card__icon-container {
    background-color: #ff9f1c;
    color: #ffffff;
  }
  .pj-feature-card:nth-child(even):hover .pj-feature-card__icon-container {
    background-color: #2ec4b6;
    color: #ffffff;
  }
  .pj-feature-card__icon-container svg {
    width: 22px;
    height: 22px;
    stroke: currentColor;
    fill: none;
  }
  .pj-feature-card__text {
    font-family: var(--pj-font-sans, 'Inter', sans-serif);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: #333333;
  }
</style>

<section class="pj-showcase">
  <div class="pj-showcase__header">
    {% if section.settings.subtitle != blank %}
      <span class="pj-showcase__subtitle">{{ section.settings.subtitle }}</span>
    {% endif %}
    {% if section.settings.title != blank %}
      <h2 class="pj-showcase__title">{{ section.settings.title }}</h2>
    {% endif %}
  </div>

  <div class="pj-showcase__grid">
    {% for block in section.blocks %}
      <div class="pj-feature-card pj-scroll-reveal" {{ block.shopify_attributes }}>
        <div class="pj-feature-card__icon-container">
          {% case block.settings.icon %}
            {% when 'adjustments' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            {% when 'sun-moon' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
            {% when 'layout' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path></svg>
            {% when 'shopify' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            {% when 'paintbrush' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="M7.5 10.5c.828 0 1.5-.672 1.5-1.5s-.672-1.5-1.5-1.5-1.5.672-1.5 1.5.672 1.5 1.5 1.5z"></path><path d="M11.5 7.5c.828 0 1.5-.672 1.5-1.5S12.328 4.5 11.5 4.5 10 5.172 10 6s.672 1.5 1.5 1.5z"></path><path d="M16.5 9.5c.828 0 1.5-.672 1.5-1.5s-.672-1.5-1.5-1.5-1.5.672-1.5 1.5.672 1.5 1.5 1.5z"></path><path d="M6 14c0-2 2-3 4-3 2.5 0 4.5 1.5 4.5 4 0 2.5-2 4-4.5 4-2.5 0-4-2-4-5z"></path></svg>
            {% when 'trending-up' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
            {% when 'package' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
            {% when 'smartphone' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
            {% when 'refresh' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
            {% when 'tag' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"></path><path d="M6 8h.01"></path></svg>
            {% when 'cursor' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 3 7.07 16.97 2.51-7.39 7.39-2.51L3 3Z"></path><path d="m13 13 6 6"></path></svg>
            {% when 'cart' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
            {% when 'shield' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            {% when 'bell' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9Z"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
            {% when 'disc' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="3"></circle></svg>
            {% when 'envelope' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
            {% when 'heart' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
            {% when 'clock' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            {% when 'star' %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            {% else %}
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          {% endcase %}
        </div>
        <div class="pj-feature-card__text">{{ block.settings.title }}</div>
      </div>
    {% endfor %}
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const reveals = document.querySelectorAll('.pj-scroll-reveal');
    
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry, idx) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.add('is-visible');
          }, idx * 65);
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.1
    });

    reveals.forEach(el => revealObserver.observe(el));
  });
</script>

{% schema %}
{
  "name": "Features Showcase",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Only Shopify Theme Your D2C Brand Will Ever Need"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Optimised & Dynamic"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdf8f5"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Feature Name"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "adjustments", "label": "Sliders / Settings" },
            { "value": "sun-moon", "label": "Sun & Moon" },
            { "value": "layout", "label": "Block Layout" },
            { "value": "shopify", "label": "Shopify Store" },
            { "value": "paintbrush", "label": "Paint Palette" },
            { "value": "trending-up", "label": "Trending Up" },
            { "value": "package", "label": "Package Box" },
            { "value": "smartphone", "label": "Smartphone" },
            { "value": "refresh", "label": "Refresh" },
            { "value": "tag", "label": "Tag" },
            { "value": "cursor", "label": "Pointer Cursor" },
            { "value": "cart", "label": "Shopping Cart" },
            { "value": "shield", "label": "Shield Check" },
            { "value": "bell", "label": "Notification Bell" },
            { "value": "disc", "label": "Target / Spin Disc" },
            { "value": "envelope", "label": "Envelope Mail" },
            { "value": "heart", "label": "Heart Wishlist" },
            { "value": "clock", "label": "Clock Urgency" },
            { "value": "star", "label": "Review Star" }
          ],
          "default": "adjustments"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features Showcase",
      "blocks": [
        { "type": "feature", "settings": { "title": "Color & Font Controls", "icon": "adjustments" } },
        { "type": "feature", "settings": { "title": "One-Click Dark/Light Mode", "icon": "sun-moon" } },
        { "type": "feature", "settings": { "title": "Block Level Paddings", "icon": "layout" } },
        { "type": "feature", "settings": { "title": "Shopify 2.0 Architecture", "icon": "shopify" } },
        { "type": "feature", "settings": { "title": "Granular Customisation", "icon": "adjustments" } },
        { "type": "feature", "settings": { "title": "Global Color System", "icon": "paintbrush" } },
        { "type": "feature", "settings": { "title": "Flexible Section Layouts", "icon": "layout" } },
        { "type": "feature", "settings": { "title": "Beginner Friendly to Use", "icon": "star" } },
        { "type": "feature", "settings": { "title": "Higher AOV Orders", "icon": "trending-up" } },
        { "type": "feature", "settings": { "title": "Customisable Bundles", "icon": "package" } },
        { "type": "feature", "settings": { "title": "Optimised for Mobile", "icon": "smartphone" } },
        { "type": "feature", "settings": { "title": "Live Total Price Updates", "icon": "refresh" } },
        { "type": "feature", "settings": { "title": "Automatic Codes Support", "icon": "tag" } },
        { "type": "feature", "settings": { "title": "Intuitive Interface", "icon": "cursor" } },
        { "type": "feature", "settings": { "title": "One-Click Add to Cart", "icon": "cart" } },
        { "type": "feature", "settings": { "title": "No External App Needed", "icon": "shield" } },
        { "type": "feature", "settings": { "title": "Smart Cart/Cross Upsells", "icon": "cart" } },
        { "type": "feature", "settings": { "title": "Social Proof Notifications", "icon": "bell" } },
        { "type": "feature", "settings": { "title": "Spin the Wheel Popup", "icon": "disc" } },
        { "type": "feature", "settings": { "title": "Newsletter Popup", "icon": "envelope" } },
        { "type": "feature", "settings": { "title": "Built-In Wishlists", "icon": "heart" } },
        { "type": "feature", "settings": { "title": "Stock Urgency Indicators", "icon": "clock" } },
