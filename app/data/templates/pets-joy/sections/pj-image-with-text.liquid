<style>.pj-iwt{display:grid;grid-template-columns:1fr 1fr;align-items:center;max-width:1400px;margin:80px auto;gap:60px;padding:0 20px}.pj-iwt img{width:100%;height:100%;object-fit:cover;border-radius:4px}.pj-iwt-content{padding:40px 0}.pj-iwt-content h2{font-size:42px;margin-bottom:20px;font-family:var(--pj-font-serif,serif)}.pj-iwt-content p{font-size:16px;color:#555;line-height:1.7;margin-bottom:30px}@media(max-width:768px){.pj-iwt{grid-template-columns:1fr;gap:30px}}</style><section class="pj-iwt"><div style="order:{{ section.settings.image_position }}"><img src="{{ section.settings.image | image_url }}" alt=""></div><div class="pj-iwt-content"><h2>{{ section.settings.title }}</h2><p>{{ section.settings.text }}</p><a href="{{ section.settings.btn_link }}" style="display:inline-block;padding:15px 40px;background:#000;color:#fff;text-decoration:none;text-transform:uppercase;letter-spacing:1px;font-size:13px;">{{ section.settings.btn_label }}</a></div></section>{% schema %}{"name":"Image with Text","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"image_position","label":"Image Position","options":[{"value":"0","label":"Left"},{"value":"2","label":"Right"}],"default":"0"},{"type":"text","id":"title","label":"Heading","default":"Craftsmanship"},{"type":"textarea","id":"text","label":"Text","default":"Detailing our unique process and materials."},{"type":"text","id":"btn_label","label":"Button Label","default":"Discover"},{"type":"url","id":"btn_link","label":"Button Link"}],"presets":[{"name":"Image with Text"}]}{% endschema %}