<style>
  .pj-sidebar { padding: 40px 30px 40px 0; }
  .pj-sidebar__title { font-family: 'Nunito', sans-serif; font-size: 20px; font-weight: 900; color: #333; margin-bottom: 25px; display: flex; align-items: center; gap: 10px; }
  .pj-sidebar__group { margin-bottom: 30px; }
  .pj-sidebar__group-title { font-family: 'Nunito', sans-serif; font-size: 16px; font-weight: 800; color: #333; margin-bottom: 15px; }
  .pj-sidebar__list { list-style: none; padding: 0; margin: 0; }
  .pj-sidebar__item { margin-bottom: 12px; }
  .pj-sidebar__label { display: flex; align-items: center; gap: 12px; font-family: 'Nunito', sans-serif; font-size: 15px; color: #666; cursor: pointer; font-weight: 600; }
  .pj-sidebar__checkbox { appearance: none; width: 22px; height: 22px; border: 2px solid #ddd; border-radius: 6px; outline: none; cursor: pointer; transition: all 0.2s; position: relative; }
  .pj-sidebar__checkbox:checked { background: #ff9f1c; border-color: #ff9f1c; }
  .pj-sidebar__checkbox:checked::after { content: '✓'; position: absolute; color: #fff; font-size: 14px; top: 50%; left: 50%; transform: translate(-50%, -50%); font-weight: 900; }
</style>
<aside class="pj-sidebar">
  <div class="pj-sidebar__title"><span>🔍</span> Filter By</div>
  <div class="pj-sidebar__group">
    <div class="pj-sidebar__group-title">Pet Type</div>
    <ul class="pj-sidebar__list">
      <li class="pj-sidebar__item"><label class="pj-sidebar__label"><input type="checkbox" class="pj-sidebar__checkbox"> Dogs 🐶</label></li>
      <li class="pj-sidebar__item"><label class="pj-sidebar__label"><input type="checkbox" class="pj-sidebar__checkbox"> Cats 🐱</label></li>
      <li class="pj-sidebar__item"><label class="pj-sidebar__label"><input type="checkbox" class="pj-sidebar__checkbox"> Small Pets 🐹</label></li>
    </ul>
  </div>
  <div class="pj-sidebar__group">
    <div class="pj-sidebar__group-title">Price Range</div>
    <ul class="pj-sidebar__list">
      <li class="pj-sidebar__item"><label class="pj-sidebar__label"><input type="checkbox" class="pj-sidebar__checkbox"> Under $25</label></li>
      <li class="pj-sidebar__item"><label class="pj-sidebar__label"><input type="checkbox" class="pj-sidebar__checkbox"> $25 - $50</label></li>
      <li class="pj-sidebar__item"><label class="pj-sidebar__label"><input type="checkbox" class="pj-sidebar__checkbox"> Over $50</label></li>
    </ul>
  </div>
</aside>
{% schema %}
{ "name": "PJ Filter Sidebar", "tag": "section", "settings": [], "presets": [{ "name": "PJ Filter Sidebar" }] }
{% endschema %}
