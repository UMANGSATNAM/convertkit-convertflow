<style>
  .hd-buybox { position: sticky; top: 100px; padding: 40px; background: #fff; }
  .hd-buybox__vendor { font-family: 'Inter', sans-serif; font-size: 11px; color: #999; text-transform: uppercase; letter-spacing: 2px; font-weight: 500; margin-bottom: 15px; }
  .hd-buybox__title { font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 400; color: #2c2c2c; line-height: 1.2; margin-bottom: 20px; }
  .hd-buybox__price { font-family: 'Inter', sans-serif; font-size: 20px; font-weight: 400; color: #2c2c2c; margin-bottom: 30px; display: flex; align-items: center; gap: 15px; }
  .hd-buybox__compare { color: #aaa; text-decoration: line-through; font-size: 16px; }
  .hd-buybox__variants { margin-bottom: 30px; border-top: 1px solid #eee; padding-top: 30px; }
  .hd-buybox__variant-label { font-family: 'Inter', sans-serif; font-size: 12px; color: #555; font-weight: 500; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; display: block; }
  .hd-buybox__variant-select { width: 100%; padding: 15px; background: transparent; border: 1px solid #ddd; color: #2c2c2c; font-family: 'Inter', sans-serif; font-size: 14px; cursor: pointer; outline: none; transition: border-color 0.3s; margin-bottom: 20px; }
  .hd-buybox__variant-select:focus { border-color: #2c2c2c; }
  .hd-buybox__add-btn { width: 100%; padding: 18px; background: #2c2c2c; color: #fff; border: 1px solid #2c2c2c; font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 500; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: all 0.4s; }
  .hd-buybox__add-btn:hover { background: #fff; color: #2c2c2c; }
  .hd-buybox__meta { margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee; display: flex; flex-direction: column; gap: 10px; }
  .hd-buybox__meta-item { font-family: 'Inter', sans-serif; font-size: 13px; color: #666; display: flex; align-items: center; gap: 10px; }
  .hd-buybox__meta-icon { font-size: 16px; color: #2c2c2c; }
</style>
<div class="hd-buybox">
  <div class="hd-buybox__vendor">{{ product.vendor }}</div>
  <h1 class="hd-buybox__title">{{ product.title }}</h1>
  <div class="hd-buybox__price">{{ product.selected_or_first_available_variant.price | money }}{% if product.compare_at_price > product.price %}<span class="hd-buybox__compare">{{ product.compare_at_price | money }}</span>{% endif %}</div>
  {% form 'product', product %}
    {% unless product.has_only_default_variant %}
      <div class="hd-buybox__variants">
        {% for option in product.options_with_values %}
          <label class="hd-buybox__variant-label">{{ option.name }}</label>
          <select name="id" class="hd-buybox__variant-select">
            {% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title }} - {{ variant.price | money }}</option>{% endfor %}
          </select>
        {% endfor %}
      </div>
    {% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}
    <button type="submit" class="hd-buybox__add-btn" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to Cart{% else %}Out of Stock{% endif %}</button>
  {% endform %}
  <div class="hd-buybox__meta">
    <div class="hd-buybox__meta-item"><span class="hd-buybox__meta-icon">✓</span> Free standard shipping over $150</div>
    <div class="hd-buybox__meta-item"><span class="hd-buybox__meta-icon">✓</span> 30-day complimentary returns</div>
  </div>
</div>
{% schema %}
{ "name": "HD Sticky Buybox", "tag": "section", "settings": [], "presets": [{ "name": "HD Sticky Buybox" }] }
{% endschema %}
