<style>
  .hd-highlights { padding: 100px 0; background: #ffffff; }
  .hd-highlights__container { max-width: 1400px; margin: 0 auto; padding: 0 40px; }
  .hd-highlights__header { text-align: center; margin-bottom: 60px; }
  .hd-highlights__eyebrow { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 4px; color: {{ section.settings.accent_color }}; margin-bottom: 15px; display: block; }
  .hd-highlights__title { font-family: 'Playfair Display', serif; font-size: 36px; font-weight: 400; color: #2c2c2c; }
  .hd-highlights__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; }
  @media (max-width: 1024px) { .hd-highlights__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .hd-highlights__grid { grid-template-columns: 1fr; } }
  .hd-prod-card { display: block; text-decoration: none; position: relative; }
  .hd-prod-card__img-wrapper { aspect-ratio: 4/5; overflow: hidden; background: #f5f5f5; margin-bottom: 20px; position: relative; }
  .hd-prod-card__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s ease; }
  .hd-prod-card:hover .hd-prod-card__img { transform: scale(1.05); }
  .hd-prod-card__badge { position: absolute; top: 15px; left: 15px; background: #fff; color: #2c2c2c; font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 1px; padding: 6px 12px; }
  .hd-prod-card__info { display: flex; justify-content: space-between; align-items: flex-start; }
  .hd-prod-card__name { font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 400; color: #2c2c2c; margin-bottom: 5px; }
  .hd-prod-card__price { font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 500; color: #2c2c2c; }
  .hd-prod-card__compare { color: #999; text-decoration: line-through; font-size: 13px; margin-right: 8px; }
</style>
<section class="hd-highlights">
  <div class="hd-highlights__container">
    <div class="hd-highlights__header">
      <span class="hd-highlights__eyebrow">{{ section.settings.subtitle }}</span>
      <h2 class="hd-highlights__title">{{ section.settings.title }}</h2>
    </div>
    <div class="hd-highlights__grid">
      {% assign col = collections[section.settings.collection] %}
      {% for product in col.products limit: section.settings.limit %}
        <a href="{{ product.url }}" class="hd-prod-card">
          <div class="hd-prod-card__img-wrapper">
            {% if product.compare_at_price > product.price %}<div class="hd-prod-card__badge">Sale</div>{% endif %}
            {% if product.featured_image %}<img class="hd-prod-card__img" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">{% endif %}
          </div>
          <div class="hd-prod-card__info">
            <h3 class="hd-prod-card__name">{{ product.title }}</h3>
            <div class="hd-prod-card__price">{% if product.compare_at_price > product.price %}<span class="hd-prod-card__compare">{{ product.compare_at_price | money }}</span>{% endif %}{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "HD Product Highlights", "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Signature Pieces" },
    { "type": "text", "id": "subtitle", "label": "Eyebrow", "default": "Trending Now" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 12, "step": 4, "default": 4 },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#8c7a6b" }
  ],
  "presets": [{ "name": "HD Product Highlights" }]
}
{% endschema %}
