<style>
  .hd-footer { background: #faf9f8; padding: 100px 0 40px; border-top: 1px solid #eee; margin-top: 60px; }
  .hd-footer__container { max-width: 1400px; margin: 0 auto; padding: 0 40px; }
  .hd-footer__grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 60px; margin-bottom: 80px; }
  @media (max-width: 900px) { .hd-footer__grid { grid-template-columns: 1fr 1fr; gap: 40px; } }
  @media (max-width: 600px) { .hd-footer__grid { grid-template-columns: 1fr; } }
  .hd-footer__logo { font-family: 'Playfair Display', serif; font-size: 28px; color: #2c2c2c; text-decoration: none; font-weight: 400; letter-spacing: 1px; display: block; margin-bottom: 20px; }
  .hd-footer__desc { font-family: 'Inter', sans-serif; font-size: 14px; color: #666; line-height: 1.8; max-width: 300px; font-weight: 300; }
  .hd-footer__title { font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 2px; color: #2c2c2c; margin-bottom: 25px; }
  .hd-footer__links { list-style: none; padding: 0; margin: 0; }
  .hd-footer__links li { margin-bottom: 12px; }
  .hd-footer__links a { font-family: 'Inter', sans-serif; font-size: 14px; color: #666; text-decoration: none; transition: color 0.3s; font-weight: 300; }
  .hd-footer__links a:hover { color: {{ section.settings.accent_color }}; }
  .hd-footer__bottom { padding-top: 40px; border-top: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; }
  .hd-footer__copy { font-family: 'Inter', sans-serif; font-size: 12px; color: #999; text-transform: uppercase; letter-spacing: 1px; }
  .hd-footer__socials { display: flex; gap: 20px; }
  .hd-footer__social { color: #666; text-decoration: none; font-family: 'Inter', sans-serif; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; transition: color 0.3s; }
  .hd-footer__social:hover { color: {{ section.settings.accent_color }}; }
</style>
<footer class="hd-footer">
  <div class="hd-footer__container">
    <div class="hd-footer__grid">
      <div>
        <a href="/" class="hd-footer__logo">{{ section.settings.logo_text }}</a>
        <p class="hd-footer__desc">{{ section.settings.description }}</p>
      </div>
      {% for block in section.blocks %}
        <div>
          <h4 class="hd-footer__title">{{ block.settings.title }}</h4>
          <ul class="hd-footer__links">
            {% assign links = block.settings.menu | default: linklists.footer-menu %}
            {% if block.settings.menu != blank %}
              {% for link in linklists[block.settings.menu].links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
            {% endif %}
          </ul>
        </div>
      {% endfor %}
    </div>
    <div class="hd-footer__bottom">
      <span class="hd-footer__copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <div class="hd-footer__socials">
        {% if section.settings.instagram != blank %}<a href="{{ section.settings.instagram }}" class="hd-footer__social" target="_blank">Instagram</a>{% endif %}
        {% if section.settings.pinterest != blank %}<a href="{{ section.settings.pinterest }}" class="hd-footer__social" target="_blank">Pinterest</a>{% endif %}
      </div>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "HD Footer", "tag": "section",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo Text", "default": "HOME ELEGANCE" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Curating spaces that inspire quiet beauty and everyday elegance." },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "pinterest", "label": "Pinterest" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#8c7a6b" }
  ],
  "blocks": [{ "type": "column", "name": "Link Column", "settings": [
    { "type": "text", "id": "title", "label": "Column Title", "default": "Shop" },
    { "type": "link_list", "id": "menu", "label": "Menu" }
  ]}],
  "presets": [{ "name": "HD Footer", "blocks": [{ "type": "column", "settings": { "title": "Collection" }}, { "type": "column", "settings": { "title": "Company" }}, { "type": "column", "settings": { "title": "Customer Care" }}] }]
}
{% endschema %}
