<style>
  .hd-story { padding: 120px 0; background: {{ section.settings.bg_color }}; }
  .hd-story__container { max-width: 1400px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
  @media (max-width: 900px) { .hd-story__container { grid-template-columns: 1fr; gap: 50px; } }
  .hd-story__image-wrapper { width: 100%; aspect-ratio: 4/5; overflow: hidden; }
  .hd-story__image { width: 100%; height: 100%; object-fit: cover; }
  .hd-story__content { padding: 40px 0; }
  .hd-story__eyebrow { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 4px; color: {{ section.settings.accent_color }}; margin-bottom: 20px; display: block; }
  .hd-story__title { font-family: 'Playfair Display', serif; font-size: 42px; font-weight: 400; color: #2c2c2c; line-height: 1.2; margin-bottom: 30px; }
  .hd-story__text { font-family: 'Inter', sans-serif; font-size: 16px; color: #555; line-height: 1.8; margin-bottom: 40px; font-weight: 300; }
  .hd-story__link { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 2px; color: #2c2c2c; text-decoration: none; position: relative; padding-bottom: 5px; }
  .hd-story__link::after { content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 1px; background: #2c2c2c; transition: width 0.3s; }
  .hd-story__link:hover::after { width: 0; }
</style>
<section class="hd-story">
  <div class="hd-story__container" style="{% if section.settings.image_position == 'right' %}direction: rtl;{% endif %}">
    <div class="hd-story__image-wrapper" style="direction: ltr;">
      {% if section.settings.image %}<img class="hd-story__image" src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" loading="lazy">{% else %}<div class="hd-story__image" style="background:#eee;"></div>{% endif %}
    </div>
    <div class="hd-story__content" style="direction: ltr;">
      <span class="hd-story__eyebrow">{{ section.settings.label }}</span>
      <h2 class="hd-story__title">{{ section.settings.title }}</h2>
      <div class="hd-story__text">{{ section.settings.text }}</div>
      {% if section.settings.btn_label != blank %}<a href="{{ section.settings.btn_link }}" class="hd-story__link">{{ section.settings.btn_label }}</a>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "HD Brand Story", "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image Position", "options": [{"value":"left","label":"Left"},{"value":"right","label":"Right"}], "default": "left" },
    { "type": "text", "id": "label", "label": "Eyebrow", "default": "Our Philosophy" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Less, But Better" },
    { "type": "richtext", "id": "text", "label": "Body", "default": "<p>We believe in the power of simplicity. Every piece in our collection is carefully selected for its enduring quality, timeless design, and ability to bring quiet beauty to your daily life.</p>" },
    { "type": "text", "id": "btn_label", "label": "Link Label", "default": "Read Our Story" },
    { "type": "url", "id": "btn_link", "label": "Link" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf9f8" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#8c7a6b" }
  ],
  "presets": [{ "name": "HD Brand Story" }]
}
{% endschema %}
