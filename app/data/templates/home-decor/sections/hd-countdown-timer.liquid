<style>.hd-flash{background:#000;color:#fff;padding:40px 20px;text-align:center}.hd-flash h2{font-size:28px;margin-bottom:20px;color:#fff}.hd-timer{display:flex;justify-content:center;gap:20px}.hd-timer-box{display:flex;flex-direction:column;align-items:center}.hd-timer-num{font-size:40px;font-weight:700;line-height:1}.hd-timer-label{font-size:11px;text-transform:uppercase;letter-spacing:2px;margin-top:5px;color:#aaa}</style><section class="hd-flash"><h2>{{ section.settings.title }}</h2><div class="hd-timer"><div class="hd-timer-box"><span class="hd-timer-num">02</span><span class="hd-timer-label">Days</span></div><div class="hd-timer-box"><span class="hd-timer-num">14</span><span class="hd-timer-label">Hours</span></div><div class="hd-timer-box"><span class="hd-timer-num">45</span><span class="hd-timer-label">Mins</span></div><div class="hd-timer-box"><span class="hd-timer-num">30</span><span class="hd-timer-label">Secs</span></div></div></section>{% schema %}{"name":"Flash Sale Timer","settings":[{"type":"text","id":"title","label":"Heading","default":"Flash Sale Ends In"}],"presets":[{"name":"Flash Sale Timer"}]}{% endschema %}