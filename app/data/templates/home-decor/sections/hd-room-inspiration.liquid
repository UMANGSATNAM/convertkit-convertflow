<style>
  .hd-room { padding: 100px 0; background: #ffffff; }
  .hd-room__container { max-width: 1400px; margin: 0 auto; padding: 0 40px; }
  .hd-room__header { text-align: center; margin-bottom: 60px; }
  .hd-room__eyebrow { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 4px; color: {{ section.settings.accent_color }}; margin-bottom: 15px; display: block; }
  .hd-room__title { font-family: 'Playfair Display', serif; font-size: 36px; font-weight: 400; color: #2c2c2c; }
  .hd-room__grid { display: grid; grid-template-columns: 2fr 1fr; gap: 30px; height: 600px; }
  @media (max-width: 900px) { .hd-room__grid { grid-template-columns: 1fr; height: auto; display: flex; flex-direction: column; } }
  .hd-room__main { position: relative; width: 100%; height: 100%; background: #eee; }
  @media (max-width: 900px) { .hd-room__main { aspect-ratio: 4/3; } }
  .hd-room__main img { width: 100%; height: 100%; object-fit: cover; }
  .hd-room__side { display: flex; flex-direction: column; gap: 30px; }
  .hd-room__product { display: flex; gap: 20px; text-decoration: none; align-items: center; background: #faf9f8; padding: 20px; transition: background 0.3s; }
  .hd-room__product:hover { background: #f0ebe1; }
  .hd-room__prod-img { width: 80px; height: 100px; object-fit: cover; }
  .hd-room__prod-info { flex: 1; }
  .hd-room__prod-name { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 500; color: #2c2c2c; margin-bottom: 5px; }
  .hd-room__prod-price { font-family: 'Inter', sans-serif; font-size: 14px; color: #666; }
</style>
<section class="hd-room">
  <div class="hd-room__container">
    <div class="hd-room__header">
      <span class="hd-room__eyebrow">{{ section.settings.subtitle }}</span>
      <h2 class="hd-room__title">{{ section.settings.title }}</h2>
    </div>
    <div class="hd-room__grid">
      <div class="hd-room__main">
        {% if section.settings.image %}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="Room Inspiration" loading="lazy">{% else %}<div style="width:100%;height:100%;background:#eee;"></div>{% endif %}
      </div>
      <div class="hd-room__side">
        {% for block in section.blocks %}
          {% assign prod = all_products[block.settings.product] %}
          {% if prod != blank %}
            <a href="{{ prod.url }}" class="hd-room__product" {{ block.shopify_attributes }}>
              <img class="hd-room__prod-img" src="{{ prod.featured_image | image_url: width: 200 }}" alt="{{ prod.title | escape }}" loading="lazy">
              <div class="hd-room__prod-info">
                <div class="hd-room__prod-name">{{ prod.title }}</div>
                <div class="hd-room__prod-price">{{ prod.price | money }}</div>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "HD Room Inspiration", "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Room Image" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop The Look" },
    { "type": "text", "id": "subtitle", "label": "Eyebrow", "default": "Inspiration" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#8c7a6b" }
  ],
  "blocks": [{ "type": "product", "name": "Product", "settings": [{ "type": "product", "id": "product", "label": "Product" }] }],
  "presets": [{ "name": "HD Room Inspiration" }]
}
{% endschema %}
