<style>
  .hd-product-main {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }
  
  /* Gallery Side (Left) */
  .hd-product-gallery {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: sticky;
    top: 100px;
    height: max-content;
  }
  .hd-product-gallery__main img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    object-fit: cover;
    background: #f8f8f8;
  }
  .hd-product-gallery__thumbnails {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }
  .hd-product-gallery__thumbnails img {
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 4px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .hd-product-gallery__thumbnails img:hover {
    border-color: #000;
  }

  /* Info Side (Right) */
  .hd-product-info {
    display: flex;
    flex-direction: column;
  }
  .hd-product-vendor {
    font-family: var(--hd-font-sans, 'Inter', sans-serif);
    font-size: 13px;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 10px;
  }
  .hd-product-title {
    font-family: var(--hd-font-serif, 'Georgia', serif);
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.1;
    margin: 0 0 15px 0;
    font-weight: 400;
  }
  .hd-product-rating {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 25px;
    font-size: 14px;
    color: #222;
  }
  .hd-product-rating svg {
    width: 16px;
    fill: #000;
  }
  .hd-product-price {
    font-family: var(--hd-font-sans, 'Inter', sans-serif);
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 30px;
    display: flex;
    align-items: center;
    gap: 15px;
  }
  .hd-product-price s {
    color: #999;
    font-size: 18px;
    font-weight: 400;
  }
  
  /* Add to Cart Area */
  .hd-product-form {
    margin-bottom: 40px;
  }
  .hd-product-variants {
    margin-bottom: 25px;
  }
  .hd-product-variant-label {
    display: block;
    font-family: var(--hd-font-sans, 'Inter', sans-serif);
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .hd-product-variant-select {
    width: 100%;
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 2px;
    font-family: var(--hd-font-sans, 'Inter', sans-serif);
    font-size: 14px;
    background: #fff;
    cursor: pointer;
  }
  .hd-add-to-cart {
    width: 100%;
    padding: 18px;
    background: #000;
    color: #fff;
    border: none;
    font-family: var(--hd-font-sans, 'Inter', sans-serif);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.3s;
    border-radius: 2px;
  }
  .hd-add-to-cart:hover {
    background: #333;
  }
  
  /* Trust Badges & Urgency */
  .hd-product-trust {
    margin-top: 15px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .hd-product-badges {
    display: flex;
    gap: 15px;
    opacity: 0.5;
  }
  .hd-product-badges svg {
    height: 24px;
    width: auto;
  }
  .hd-product-urgency {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--hd-font-sans, 'Inter', sans-serif);
    font-size: 13px;
    color: #d93025;
    font-weight: 500;
  }
  .hd-product-urgency-dot {
    width: 8px;
    height: 8px;
    background: #d93025;
    border-radius: 50%;
    animation: hd-pulse 2s infinite;
  }
  
  /* Accordion Details */
  .hd-product-accordion {
    border-top: 1px solid #eee;
  }
  .hd-accordion-item {
    border-bottom: 1px solid #eee;
  }
  .hd-accordion-btn {
    width: 100%;
    padding: 20px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: none;
    border: none;
    font-family: var(--hd-font-sans, 'Inter', sans-serif);
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
  }
  .hd-accordion-content {
    padding-bottom: 20px;
    font-family: var(--hd-font-sans, 'Inter', sans-serif);
    font-size: 14px;
    line-height: 1.6;
    color: #555;
    display: none;
  }

  @media (max-width: 900px) {
    .hd-product-main {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 20px;
    }
    .hd-product-gallery {
      position: static;
    }
  }
</style>

<div class="hd-product-main">
  <!-- LEFT: Gallery -->
  <div class="hd-product-gallery">
    <div class="hd-product-gallery__main">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | img_url: '1000x' }}" alt="{{ product.title }}">
      {% else %}
        <div style="width:100%; aspect-ratio:3/4; background:#eee; display:flex; align-items:center; justify-content:center;">Product Image</div>
      {% endif %}
    </div>
    {% if product.images.size > 1 %}
      <div class="hd-product-gallery__thumbnails">
        {% for image in product.images limit: 4 %}
          <img src="{{ image | img_url: '200x' }}" alt="{{ product.title }}">
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <!-- RIGHT: Info -->
  <div class="hd-product-info">
    <div class="hd-product-vendor">{{ product.vendor | default: "Premium Brand" }}</div>
    <h1 class="hd-product-title">{{ product.title | default: "Premium Product Name" }}</h1>
    
    <div class="hd-product-rating">
      <div style="display:flex;gap:2px;">
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
      </div>
      <span>(128 Reviews)</span>
    </div>

    <div class="hd-product-price">
      {% if product %}
        {{ product.selected_or_first_available_variant.price | money }}
        {% if product.compare_at_price > product.price %}
          <s>{{ product.compare_at_price | money }}</s>
        {% endif %}
      {% else %}
        $120.00 <s>$150.00</s>
      {% endif %}
    </div>

    <div class="hd-product-form">
      {% if product %}
        {% form 'product', product %}
          {% unless product.has_only_default_variant %}
            <div class="hd-product-variants">
              {% for option in product.options_with_values %}
                <label class="hd-product-variant-label">{{ option.name }}</label>
                <select name="id" class="hd-product-variant-select">
                  {% for variant in product.variants %}
                    <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
                      {{ variant.title }} - {{ variant.price | money }}
                    </option>
                  {% endfor %}
                </select>
              {% endfor %}
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endunless %}
          <button type="submit" class="hd-add-to-cart" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}Add to Bag{% else %}Sold Out{% endif %}
          </button>
        {% endform %}
      {% else %}
        <button type="button" class="hd-add-to-cart">Add to Bag</button>
      {% endif %}

      <div class="hd-product-trust">
        <div class="hd-product-urgency">
          <span class="hd-product-urgency-dot"></span>
          Selling fast! Only <span id="hd-inventory-count">4</span> left in stock.
        </div>
        <div class="hd-product-badges">
          <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg"><path d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z" fill="#FFF" opacity=".2"/><path d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32" fill="#1434CB"/><path d="M28.3 5.9l-1.4 8.6h-2.7l1.4-8.6h2.7zm-9.3 0h-2.2c-.4 0-.8.2-1 .6l-3.1 7.4-1.5-7.4c-.1-.3-.2-.5-.5-.6H8.1l2.4 8.6h2.8l3.6-8.6zm13.1 8.6l-1.3-6.2c-.1-.4-.5-.6-.9-.6h-3.1c-.2 0-.4.1-.5.3l-2.4 6.5h2.8l.5-1.5h3.5l.3 1.5h1.1zm-3.5-3.6l1-3 1 3h-2zm-11.4 3.6h2.7l1.7-8.6h-2.7l-1.7 8.6z" fill="#FFF"/></svg>
          <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg"><path d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z" fill="#1A1F71"/><path d="M22 12c0-2.4-1.2-4.5-3-5.7-1.8 1.3-3 3.4-3 5.7s1.2 4.5 3 5.7c1.8-1.3 3-3.4 3-5.7z" fill="#FF5F00"/><path d="M14.5 17.7c-2.4 0-4.5-1.2-5.7-3 1.3-1.8 3.4-3 5.7-3s4.5 1.2 5.7 3c-1.3 1.8-3.4 3-5.7 3z" fill="#EB001B"/><path d="M29.5 17.7c-2.4 0-4.5-1.2-5.7-3 1.3-1.8 3.4-3 5.7-3s4.5 1.2 5.7 3c-1.3 1.8-3.4 3-5.7 3z" fill="#F79E1B"/></svg>
          <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg"><path d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z" fill="#000"/><path d="M19.1 11.4c0-1.6.8-3.1 2.2-3.9-1-1-2.4-1.3-3.1-1.3-1.3-.1-2.6.8-3.3.8-.7 0-1.7-.8-2.8-.8-1.4 0-2.8.8-3.5 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.6 2.2 2.7 2.1 1.1-.1 1.5-.7 2.8-.7 1.3 0 1.7.7 2.8.7 1.2.1 1.9-1 2.6-2.1.9-1.3 1.2-2.5 1.2-2.6-.1 0-2.2-.8-2.2-3.3zm-1.8-5c.6-.7 1-1.7.9-2.7-.8.1-1.9.6-2.5 1.4-.5.6-1 1.6-.9 2.6.9.1 1.9-.5 2.5-1.3z" fill="#FFF"/></svg>
        </div>
      </div>
    </div>

    <div class="hd-product-accordion">
      <div class="hd-accordion-item">
        <button class="hd-accordion-btn" onclick="this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'block' ? 'none' : 'block'">
          Product Description <span>+</span>
        </button>
        <div class="hd-accordion-content" style="display:block;">
          {{ product.description | default: "Premium quality materials engineered for excellence. Experience true luxury with our signature design." }}
        </div>
      </div>
      <div class="hd-accordion-item">
        <button class="hd-accordion-btn" onclick="this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'block' ? 'none' : 'block'">
          Shipping & Returns <span>+</span>
        </button>
        <div class="hd-accordion-content">
          Free standard shipping on orders over $150. Returns accepted within 14 days of delivery.
        </div>
      </div>
      <div class="hd-accordion-item">
        <button class="hd-accordion-btn" onclick="this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'block' ? 'none' : 'block'">
          Materials & Care <span>+</span>
        </button>
        <div class="hd-accordion-content">
          Handle with care. Wipe clean with a soft, dry cloth. Store in the provided dust bag when not in use.
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  // Simple Scarcity Generator
  document.addEventListener('DOMContentLoaded', () => {
    const el = document.getElementById('hd-inventory-count');
    if (el) {
      el.innerText = Math.floor(Math.random() * 5) + 2;
    }
  });
</script>

{% schema %}
{
  "name": "Premium Product Main",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "Premium Product Main"
    }
  ]
}
{% endschema %}
