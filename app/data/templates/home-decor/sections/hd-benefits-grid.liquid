<style>.hd-bene{background:#fdfdfd;padding:80px 20px}.hd-bene-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:40px;max-width:1200px;margin:0 auto;text-align:center}.hd-bene-icon{font-size:32px;margin-bottom:20px}.hd-bene-title{font-size:16px;font-weight:600;margin-bottom:10px;text-transform:uppercase;letter-spacing:1px}.hd-bene-text{font-size:14px;color:#666;line-height:1.5}@media(max-width:768px){.hd-bene-grid{grid-template-columns:1fr 1fr}}</style><section class="hd-bene"><div class="hd-bene-grid">{% for block in section.blocks %}<div class="hd-bene-item"><div class="hd-bene-icon">{{ block.settings.icon }}</div><h3 class="hd-bene-title">{{ block.settings.title }}</h3><p class="hd-bene-text">{{ block.settings.text }}</p></div>{% endfor %}</div></section>{% schema %}{"name":"Value Props Grid","settings":[],"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"icon","label":"Icon (Emoji/SVG)","default":"✨"},{"type":"text","id":"title","label":"Title","default":"Premium Quality"},{"type":"textarea","id":"text","label":"Text","default":"Made with the finest materials."}]}],"presets":[{"name":"Value Props Grid","blocks":[{"type":"benefit"},{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}]}]}{% endschema %}