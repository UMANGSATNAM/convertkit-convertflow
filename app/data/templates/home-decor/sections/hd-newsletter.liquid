<style>
  .hd-newsletter {
    background-color: {{ section.settings.bg_color }};
    padding: 100px 5%;
    text-align: center;
  }
  .hd-nl__inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .hd-nl__title {
    font-family: 'Georgia', serif;
    font-size: 36px;
    font-weight: normal;
    color: {{ section.settings.text_color }};
    margin-bottom: 15px;
  }
  .hd-nl__text {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 15px;
    color: {{ section.settings.text_color }};
    margin-bottom: 40px;
  }
  .hd-nl__form {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  @media (min-width: 600px) {
    .hd-nl__form {
      flex-direction: row;
      border-bottom: 1px solid {{ section.settings.text_color }};
      gap: 0;
      padding-bottom: 5px;
    }
  }
  .hd-nl__input {
    flex: 1;
    border: 1px solid {{ section.settings.text_color }};
    background: transparent;
    padding: 15px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    color: {{ section.settings.text_color }};
  }
  @media (min-width: 600px) {
    .hd-nl__input {
      border: none;
      padding: 10px 0;
    }
    .hd-nl__input:focus {
      outline: none;
    }
  }
  .hd-nl__btn {
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.bg_color }};
    border: none;
    padding: 15px 30px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: opacity 0.3s;
  }
  .hd-nl__btn:hover {
    opacity: 0.8;
  }
  @media (min-width: 600px) {
    .hd-nl__btn {
      background-color: transparent;
      color: {{ section.settings.text_color }};
      padding: 10px 20px;
    }
    .hd-nl__btn:hover {
      opacity: 0.5;
    }
  }
</style>

<section class="hd-newsletter">
  <div class="hd-nl__inner">
    <h2 class="hd-nl__title">{{ section.settings.title }}</h2>
    <div class="hd-nl__text">{{ section.settings.text }}</div>
    
    {% form 'customer', class: 'hd-nl__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" class="hd-nl__input" placeholder="Your email address" required>
      <button type="submit" class="hd-nl__btn">Subscribe</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "HD Newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Join the List"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sign up to get the latest on sales, new releases and more.</p>"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "HD Newsletter"
    }
  ]
}
{% endschema %}
