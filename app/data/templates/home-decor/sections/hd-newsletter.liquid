<style>
  .hd-newsletter { padding: 120px 0; background: #2c2c2c; position: relative; }
  .hd-newsletter__container { max-width: 800px; margin: 0 auto; padding: 0 40px; text-align: center; }
  .hd-newsletter__eyebrow { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 4px; color: {{ section.settings.accent_color }}; margin-bottom: 20px; display: block; }
  .hd-newsletter__title { font-family: 'Playfair Display', serif; font-size: 36px; font-weight: 400; color: #fff; margin-bottom: 20px; }
  .hd-newsletter__text { font-family: 'Inter', sans-serif; font-size: 15px; color: #aaa; margin-bottom: 40px; font-weight: 300; }
  .hd-newsletter__form { display: flex; max-width: 500px; margin: 0 auto; border-bottom: 1px solid #555; padding-bottom: 10px; transition: border-color 0.3s; }
  .hd-newsletter__form:focus-within { border-color: {{ section.settings.accent_color }}; }
  .hd-newsletter__input { flex: 1; padding: 10px 0; border: none; background: transparent; font-family: 'Inter', sans-serif; font-size: 15px; color: #fff; outline: none; font-weight: 300; }
  .hd-newsletter__input::placeholder { color: #666; }
  .hd-newsletter__btn { padding: 10px 20px; background: transparent; color: #fff; border: none; font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: color 0.3s; }
  .hd-newsletter__btn:hover { color: {{ section.settings.accent_color }}; }
</style>
<section class="hd-newsletter">
  <div class="hd-newsletter__container">
    <span class="hd-newsletter__eyebrow">{{ section.settings.subtitle }}</span>
    <h2 class="hd-newsletter__title">{{ section.settings.title }}</h2>
    <div class="hd-newsletter__text">{{ section.settings.text }}</div>
    {% form 'customer' %}
      <div class="hd-newsletter__form">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" class="hd-newsletter__input" placeholder="{{ section.settings.placeholder }}" required>
        <button type="submit" class="hd-newsletter__btn">{{ section.settings.btn_label }}</button>
      </div>
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "HD Newsletter", "tag": "section",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Eyebrow", "default": "Join The Inner Circle" },
    { "type": "text", "id": "title", "label": "Heading", "default": "A Curated Inbox" },
    { "type": "richtext", "id": "text", "label": "Body", "default": "<p>Sign up to receive early access to new collections and exclusive editorial content.</p>" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Your email address" },
    { "type": "text", "id": "btn_label", "label": "Button", "default": "Subscribe" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#8c7a6b" }
  ],
  "presets": [{ "name": "HD Newsletter" }]
}
{% endschema %}
