<style>
  .hd-hero { position: relative; width: 100%; height: 85vh; min-height: 600px; display: flex; align-items: center; background: {{ section.settings.bg_color }}; overflow: hidden; }
  .hd-hero__image-wrapper { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; }
  .hd-hero__image-wrapper::after { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to right, rgba(250, 249, 248, 0.9) 0%, rgba(250, 249, 248, 0.4) 50%, rgba(250, 249, 248, 0.1) 100%); }
  .hd-hero__image { width: 100%; height: 100%; object-fit: cover; }
  .hd-hero__container { max-width: 1400px; margin: 0 auto; padding: 0 40px; width: 100%; position: relative; z-index: 2; }
  .hd-hero__content { max-width: 600px; }
  .hd-hero__eyebrow { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 4px; color: {{ section.settings.accent_color }}; margin-bottom: 20px; display: block; }
  .hd-hero__title { font-family: 'Playfair Display', serif; font-size: clamp(40px, 6vw, 72px); font-weight: 400; color: #2c2c2c; line-height: 1.1; margin-bottom: 30px; }
  .hd-hero__desc { font-family: 'Inter', sans-serif; font-size: 16px; color: #555; line-height: 1.8; margin-bottom: 40px; font-weight: 300; }
  .hd-hero__cta { display: inline-block; background: {{ section.settings.accent_color }}; color: #fff; padding: 18px 40px; font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 500; text-transform: uppercase; letter-spacing: 2px; text-decoration: none; transition: all 0.4s; border: 1px solid {{ section.settings.accent_color }}; }
  .hd-hero__cta:hover { background: transparent; color: {{ section.settings.accent_color }}; }
</style>
<section class="hd-hero">
  <div class="hd-hero__image-wrapper">
    {% if section.settings.image %}<img class="hd-hero__image" src="{{ section.settings.image | image_url: width: 1800 }}" alt="{{ section.settings.title | escape }}" loading="eager">{% else %}<div class="hd-hero__image" style="background:#ddd;"></div>{% endif %}
  </div>
  <div class="hd-hero__container">
    <div class="hd-hero__content">
      {% if section.settings.eyebrow != blank %}<span class="hd-hero__eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h1 class="hd-hero__title">{{ section.settings.title }}</h1>
      <p class="hd-hero__desc">{{ section.settings.desc }}</p>
      {% if section.settings.btn_label != blank %}<a href="{{ section.settings.btn_link }}" class="hd-hero__cta">{{ section.settings.btn_label }}</a>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "HD Hero", "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New Collection" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Elevate Your Space" },
    { "type": "text", "id": "desc", "label": "Description", "default": "Discover curated pieces that bring warmth, elegance, and modern minimalism to every room." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Explore Collection" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#8c7a6b" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#faf9f8" }
  ],
  "presets": [{ "name": "HD Hero" }]
}
{% endschema %}
