<style>
  .hd-header { position: sticky; top: 0; width: 100%; background: rgba(255, 255, 255, 0.95); z-index: 500; border-bottom: 1px solid #eee; backdrop-filter: blur(10px); }
  .hd-header__container { max-width: 1400px; margin: 0 auto; padding: 0 40px; height: 80px; display: flex; align-items: center; justify-content: space-between; }
  .hd-header__nav { display: flex; gap: 40px; }
  @media (max-width: 900px) { .hd-header__nav { display: none; } }
  .hd-header__nav a { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 500; color: #555; text-decoration: none; text-transform: uppercase; letter-spacing: 2px; transition: color 0.3s; position: relative; padding-bottom: 5px; }
  .hd-header__nav a:hover { color: #2c2c2c; }
  .hd-header__nav a::after { content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 1px; background: #2c2c2c; transition: width 0.3s; }
  .hd-header__nav a:hover::after { width: 100%; }
  .hd-header__logo { font-family: 'Playfair Display', serif; font-size: 28px; color: #2c2c2c; text-decoration: none; font-weight: 400; letter-spacing: 1px; }
  .hd-header__icons { display: flex; align-items: center; gap: 25px; }
  .hd-header__icon { background: none; border: none; color: #2c2c2c; font-size: 18px; cursor: pointer; transition: opacity 0.3s; text-decoration: none; opacity: 0.7; }
  .hd-header__icon:hover { opacity: 1; }
  .hd-header__cart-btn { position: relative; display: flex; align-items: center; gap: 5px; font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 1px; color: #2c2c2c; background: none; border: none; cursor: pointer; }
  .hd-header__cart-count { background: #2c2c2c; color: #fff; font-size: 10px; width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
</style>
<header class="hd-header">
  <div class="hd-header__container">
    <nav class="hd-header__nav">
      {% for link in linklists.main-menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </nav>
    <a href="/" class="hd-header__logo">{{ section.settings.logo_text }}</a>
    <div class="hd-header__icons">
      <a href="/search" class="hd-header__icon">Search</a>
      <a href="/account" class="hd-header__icon">Account</a>
      <button class="hd-header__cart-btn" onclick="document.getElementById('hd-cart-drawer').classList.add('active'); document.getElementById('hd-cart-overlay').classList.add('active');">
        Cart <span class="hd-header__cart-count">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>
{% schema %}
{ "name": "HD Header", "tag": "section", "settings": [{ "type": "text", "id": "logo_text", "label": "Logo Text", "default": "HOME ELEGANCE" }], "presets": [{ "name": "HD Header" }] }
{% endschema %}
