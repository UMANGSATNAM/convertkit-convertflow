<style>
  .hd-drawer-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(250, 249, 248, 0.9); z-index: 999; opacity: 0; visibility: hidden; transition: all 0.4s ease; backdrop-filter: blur(5px); }
  .hd-drawer-overlay.active { opacity: 1; visibility: visible; }
  .hd-drawer { position: fixed; top: 0; right: -420px; width: 400px; max-width: 90vw; height: 100%; background: #fff; border-left: 1px solid #eee; z-index: 1000; transition: right 0.5s cubic-bezier(0.16, 1, 0.3, 1); display: flex; flex-direction: column; }
  .hd-drawer.active { right: 0; }
  .hd-drawer__header { display: flex; justify-content: space-between; align-items: center; padding: 40px; border-bottom: 1px solid #eee; }
  .hd-drawer__title { font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 400; color: #2c2c2c; margin: 0; }
  .hd-drawer__close { background: none; border: none; color: #999; width: 30px; height: 30px; cursor: pointer; font-size: 24px; display: flex; align-items: center; justify-content: center; font-weight: 300; transition: color 0.3s; }
  .hd-drawer__close:hover { color: #2c2c2c; }
  .hd-drawer__body { flex: 1; overflow-y: auto; padding: 40px; }
  .hd-drawer__empty { text-align: center; padding: 80px 20px; color: #999; font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 400; text-transform: uppercase; letter-spacing: 2px; }
  .hd-drawer__item { display: flex; gap: 25px; padding: 25px 0; border-bottom: 1px solid #f5f5f5; }
  .hd-drawer__item-img { width: 90px; height: 120px; object-fit: cover; background: #faf9f8; }
  .hd-drawer__item-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
  .hd-drawer__item-name { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 400; color: #2c2c2c; margin-bottom: 5px; }
  .hd-drawer__item-price { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 500; color: #666; margin-bottom: 15px; }
  .hd-drawer__item-qty { display: flex; align-items: center; border: 1px solid #eee; width: fit-content; }
  .hd-drawer__qty-btn { width: 30px; height: 30px; background: none; border: none; color: #999; cursor: pointer; font-size: 16px; font-weight: 300; display: flex; align-items: center; justify-content: center; transition: color 0.3s; }
  .hd-drawer__qty-btn:hover { color: #2c2c2c; }
  .hd-drawer__qty-val { font-family: 'Inter', sans-serif; font-size: 13px; color: #2c2c2c; min-width: 30px; text-align: center; }
  .hd-drawer__footer { padding: 40px; background: #faf9f8; }
  .hd-drawer__total { display: flex; justify-content: space-between; margin-bottom: 30px; }
  .hd-drawer__total-label { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 500; color: #666; text-transform: uppercase; letter-spacing: 2px; }
  .hd-drawer__total-value { font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 400; color: #2c2c2c; }
  .hd-drawer__checkout { display: block; width: 100%; padding: 20px; background: #2c2c2c; color: #fff; border: 1px solid #2c2c2c; font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 500; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; text-align: center; text-decoration: none; transition: all 0.4s; }
  .hd-drawer__checkout:hover { background: #fff; color: #2c2c2c; }
</style>
<div class="hd-drawer-overlay" id="hd-cart-overlay" onclick="document.getElementById('hd-cart-drawer').classList.remove('active'); this.classList.remove('active');"></div>
<aside class="hd-drawer" id="hd-cart-drawer">
  <div class="hd-drawer__header">
    <h3 class="hd-drawer__title">Your Selection</h3>
    <button class="hd-drawer__close" onclick="document.getElementById('hd-cart-drawer').classList.remove('active'); document.getElementById('hd-cart-overlay').classList.remove('active');">✕</button>
  </div>
  <div class="hd-drawer__body">
    {% if cart.item_count == 0 %}
      <div class="hd-drawer__empty">Your cart is empty.</div>
    {% else %}
      {% for item in cart.items %}
        <div class="hd-drawer__item">
          <img class="hd-drawer__item-img" src="{{ item.image | image_url: width: 180 }}" alt="{{ item.title | escape }}">
          <div class="hd-drawer__item-info">
            <div>
              <div class="hd-drawer__item-name">{{ item.product.title }}</div>
              <div class="hd-drawer__item-price">{{ item.final_line_price | money }}</div>
            </div>
            <div class="hd-drawer__item-qty">
              <button class="hd-drawer__qty-btn">−</button>
              <span class="hd-drawer__qty-val">{{ item.quantity }}</span>
              <button class="hd-drawer__qty-btn">+</button>
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
  {% if cart.item_count > 0 %}
    <div class="hd-drawer__footer">
      <div class="hd-drawer__total">
        <span class="hd-drawer__total-label">Subtotal</span>
        <span class="hd-drawer__total-value">{{ cart.total_price | money }}</span>
      </div>
      <a href="/checkout" class="hd-drawer__checkout">Checkout</a>
    </div>
  {% endif %}
</aside>
{% schema %}
{ "name": "HD Drawer Cart", "tag": "section", "settings": [], "presets": [{ "name": "HD Drawer Cart" }] }
{% endschema %}
