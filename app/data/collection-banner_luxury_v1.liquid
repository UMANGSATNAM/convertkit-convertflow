{%- comment -%}
  sections/collection-banner_luxury_v1.liquid
  
  CONVERSION PSYCHOLOGY & ARCHITECTURE:
  1. ATMOSPHERIC IMMERSION & VISUAL ANCHOR -- When a visitor enters a luxury
     collection archive, an immersive cinematic introduction sets the emotional
     stage and justifies premium price points before individual product browsing.
  2. COGNITIVE EASE VIA CURATOR'S PILL BAR -- Instead of clunky traditional
     dropdown filters that obstruct content, we embed horizontal category pills
     directly within the banner footer for immediate, frictionless curation.
  3. ARCHIVAL SCARCITY & PROVENANCE STATS -- Highlighting parameters such as
     "[ 24 PIECES IN ARCHIVE ]" and "[ 100% BIS HALLMARKED ]" primes the buyer
     with exclusivity and institutional trust right before they see pricing.
  4. ZERO EMOJI POLICY -- Strict editorial ASCII typography [ LIKE THIS ] for all
     filter triggers, breadcrumbs, and archival badges.
{%- endcomment -%}

<style>
  .lx-banner {
    position: relative;
    background: var(--banner-bg, #080808);
    color: var(--banner-color, #fff);
    font-family: var(--font-body, sans-serif);
    border-bottom: 1px solid rgba(201, 169, 110, 0.2);
    overflow: hidden;
  }

  /* Full-Bleed Background Imagery with Slow Zoom */
  .lx-banner__bg-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .lx-banner__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(35%) contrast(110%);
    animation: lxBannerZoom 20s infinite alternate ease-in-out;
  }

  @keyframes lxBannerZoom {
    0% { transform: scale(1); }
    100% { transform: scale(1.08); }
  }

  /* Content Overlay Container */
  .lx-banner__content {
    position: relative;
    z-index: 2;
    max-width: var(--max-width, 1400px);
    margin: 0 auto;
    padding: clamp(5rem, 10vw, 9rem) 2rem clamp(3rem, 5vw, 4.5rem) 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(380px, 45vh, 550px);
  }

  /* Top Breadcrumb & Archival Stats Row */
  .lx-banner__meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    padding-bottom: 1.25rem;
    margin-bottom: 3rem;
  }

  .lx-banner__breadcrumb {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .lx-banner__breadcrumb a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .lx-banner__breadcrumb a:hover {
    color: #c9a96e;
  }

  .lx-banner__breadcrumb span {
    color: #c9a96e;
    margin: 0 0.5rem;
  }

  .lx-banner__stats {
    display: flex;
    gap: 1.5rem;
  }

  .lx-banner__stat-badge {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c9a96e;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(201, 169, 110, 0.3);
    padding: 0.4rem 0.85rem;
  }

  /* Center Prose Block */
  .lx-banner__prose {
    max-width: 850px;
    margin: 0 0 4rem 0;
  }

  .lx-banner__subtitle {
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #c9a96e;
    margin-bottom: 1rem;
    display: block;
  }

  .lx-banner__title {
    font-family: var(--font-heading, serif);
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    font-weight: 400;
    margin: 0 0 1.5rem 0;
    line-height: 1.1;
    color: #fff;
  }

  .lx-banner__desc {
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
    max-width: 700px;
  }

  /* Footer: Curator's Horizontal Quick-Filter Pills */
  .lx-banner__curator-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .lx-banner__filter-label {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .lx-banner__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .lx-banner__pill {
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.75);
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.6rem 1.25rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .lx-banner__pill:hover,
  .lx-banner__pill.is-active {
    background: #c9a96e;
    color: #080808;
    border-color: #c9a96e;
    font-weight: 600;
  }

  .lx-banner__sort-trigger {
    background: transparent;
    border: none;
    color: #c9a96e;
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 0.5rem 0;
    transition: color 0.2s ease;
  }

  .lx-banner__sort-trigger:hover {
    color: #fff;
  }
</style>

<section
  class="lx-banner"
  data-section-id="{{ section.id }}"
  data-section-type="collection-banner">
  
  {%- comment -%} Background Image {%- endcomment -%}
  <div class="lx-banner__bg-wrapper">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url }}" alt="{{ collection.title | escape }}" class="lx-banner__bg-img" loading="eager">
    {%- elsif collection.image != blank -%}
      <img src="{{ collection.image | image_url }}" alt="{{ collection.title | escape }}" class="lx-banner__bg-img" loading="eager">
    {%- else -%}
      <img src="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?q=80&w=2000&auto=format&fit=crop" alt="Luxury Jewelry Collection" class="lx-banner__bg-img" loading="eager">
    {%- endif -%}
  </div>

  {%- comment -%} Overlay Content {%- endcomment -%}
  <div class="lx-banner__content">
    
    {%- comment -%} Top Row: Breadcrumb & Provenance Stats {%- endcomment -%}
    <div class="lx-banner__meta-row">
      <nav class="lx-banner__breadcrumb" aria-label="Breadcrumb">
        <a href="/">HOME</a>
        <span>/</span>
        <a href="/collections">ARCHIVES</a>
        <span>/</span>
        <strong>{{ collection.title | default: "SOVEREIGN ARCHIVE" | upcase }}</strong>
      </nav>

      <div class="lx-banner__stats">
        <span class="lx-banner__stat-badge">[ {{ collection.all_products_count | default: "24" }} PIECES IN ARCHIVE ]</span>
        <span class="lx-banner__stat-badge">[ 100% BIS HALLMARKED ]</span>
      </div>
    </div>

    {%- comment -%} Center Row: Editorial Title & Description {%- endcomment -%}
    <div class="lx-banner__prose">
      <span class="lx-banner__subtitle">{{ section.settings.subtitle | default: "[ CURATED HERITAGE ARCHIVE ]" }}</span>
      <h1 class="lx-banner__title">{{ collection.title | default: "Sovereign High Jewelry" }}</h1>
      <div class="lx-banner__desc">
        {%- if collection.description != blank -%}
          {{ collection.description }}
        {%- else -%}
          {{ section.settings.description | default: "An exclusive compendium of heirloom creations, where centuries-old Indian metallurgical artistry converges with rare, conflict-free solitaires. Each piece in this archive is sculpted in limited edition and inscribed with an independent HUID sovereign stamp." }}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Bottom Row: Curator's Horizontal Pills & Sorting {%- endcomment -%}
    <div class="lx-banner__curator-bar">
      <div style="display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;">
        <span class="lx-banner__filter-label">[ ARCHIVE CURATION: ]</span>
        <div class="lx-banner__pills">
          <a href="{{ collection.url }}" class="lx-banner__pill is-active">[ ALL CREATIONS ]</a>
          
          {%- comment -%} Dynamically output collection tags as luxury filter pills {%- endcomment -%}
          {%- if collection.all_tags.size > 0 -%}
            {%- for tag in collection.all_tags limit: 5 -%}
              <a href="{{ collection.url }}/{{ tag | handle }}" class="lx-banner__pill">[ {{ tag | upcase }} ]</a>
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} Fallback luxury tags if none present {%- endcomment -%}
            <a href="#" class="lx-banner__pill">[ BRIDAL TROUSSEAU ]</a>
            <a href="#" class="lx-banner__pill">[ 22K SOVEREIGN GOLD ]</a>
            <a href="#" class="lx-banner__pill">[ SOLITAIRE DIAMONDS ]</a>
            <a href="#" class="lx-banner__pill">[ HERITAGE POLKI ]</a>
          {%- endif -%}
        </div>
      </div>

      <div>
        <button type="button" class="lx-banner__sort-trigger" data-action="toggle-sort">
          [ SORT ARCHIVE: FEATURED -&gt; ]
        </button>
      </div>
    </div>

  </div>
</section>

<script>
  (function() {
    const container = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!container) return;

    const pills = container.querySelectorAll('.lx-banner__pill');
    pills.forEach(pill => {
      pill.addEventListener('click', function(e) {
        if (pill.getAttribute('href') === '#') {
          e.preventDefault();
          pills.forEach(p => p.classList.remove('is-active'));
          pill.classList.add('is-active');
        }
      });
    });

    const sortBtn = container.querySelector('[data-action="toggle-sort"]');
    if (sortBtn) {
      const sortOptions = ['FEATURED ->', 'PRICE: HIGH TO LOW ->', 'PRICE: LOW TO HIGH ->', 'LATEST ARCHIVALS ->'];
      let idx = 0;
      sortBtn.addEventListener('click', function() {
        idx = (idx + 1) % sortOptions.length;
        sortBtn.textContent = '[ SORT ARCHIVE: ' + sortOptions[idx] + ' ]';
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Collection Banner (Lux)",
  "tag": "section",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "[ CURATED HERITAGE ARCHIVE ]"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Fallback Description",
      "default": "An exclusive compendium of heirloom creations, where centuries-old Indian metallurgical artistry converges with rare, conflict-free solitaires. Each piece in this archive is sculpted in limited edition and inscribed with an independent HUID sovereign stamp."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom Background Image (Overrides Collection Image)"
    }
  ],
  "presets": [
    {
      "name": "Collection Banner (Lux)"
    }
  ]
}
{% endschema %}
