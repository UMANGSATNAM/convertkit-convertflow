{%- comment -%}
  sections/warranty-badge_electronics.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (360+ lines):
  1. RISK ANNIHILATION & RELIABILITY ASSURANCE (Cialdini's Authority): High-ticket consumer hardware carries intense anxiety regarding battery longevity and silicon failure. An unconditional 2-Year Express Replacement Accord shifts 100% of financial risk from buyer to brand.
  2. INTERACTIVE PROTECTION TIER MATRIX: Giving visitors the ability to toggle between [ STANDARD 2-YEAR ACCORD ] and [ PRO-CARE 3-YEAR + ACCIDENTAL ] establishes perceived high value and encourages protection add-ons.
  3. INSTANT CLAIM PROTOCOL DEMONSTRATION: Demystifies warranty red tape by visualizing a 3-step express claim sequence ([ 01. AUTO-DIAGNOSE ] -> [ 02. ADVANCE DISPATCH ] -> [ 03. DOORSTEP EXCHANGE ]).
  4. INDIA D2C & GLOBAL SERVICE NETWORK: Reassures buyers with explicit promises of 24-hour advance dispatch and doorstep pickup across 19,000+ Indian pincodes and international service hubs.
  5. ZERO EMOJI GUARANTEE: Uses cyber-precision ASCII brackets [ HARDWARE ACCORD ], [ ADVANCE DISPATCH ], and monospace terminal aesthetics.
{%- endcomment -%}

{%- assign section_id = 'el-warr-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --el-bg: {{ section.settings.bg_color | default: '#0d1117' }};
    --el-card: #161b22;
    --el-border: #30363d;
    --el-text: #c9d1d9;
    --el-heading: #ffffff;
    --el-green: #3fb950;
    --el-blue: #58a6ff;
    --el-accent: #f85149;

    background-color: var(--el-bg);
    color: var(--el-text);
    padding: clamp(3rem, 6vw, 5.5rem) clamp(1.2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--el-border);
    border-bottom: 1px solid var(--el-border);
    font-family: var(--font-body, 'Courier New', monospace);
    position: relative;
    overflow: hidden;
  }

  #{{ section_id }} .el-warr__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Header Ribbon */
  #{{ section_id }} .el-warr__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--el-border);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  #{{ section_id }} .el-warr__sys-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--el-green);
    background: rgba(63, 185, 80, 0.1);
    border: 1px solid rgba(63, 185, 80, 0.4);
    padding: 0.35rem 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  #{{ section_id }} .el-warr__title {
    font-size: clamp(1.4rem, 2.8vw, 2.2rem);
    font-weight: 800;
    color: var(--el-heading);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  #{{ section_id }} .el-warr__sub {
    font-size: 0.88rem;
    color: #8b949e;
    line-height: 1.6;
    max-width: 700px;
    margin: 0.5rem 0 2.5rem 0;
  }

  #{{ section_id }} .el-warr__sub strong {
    color: var(--el-heading);
  }

  /* Interactive Warranty Tiers Matrix */
  #{{ section_id }} .el-warr__tiers {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    #{{ section_id }} .el-warr__tiers {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  #{{ section_id }} .el-warr__tier {
    background: var(--el-card);
    border: 1px solid var(--el-border);
    padding: 1.8rem;
    transition: all 0.3s ease;
    cursor: pointer;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  #{{ section_id }} .el-warr__tier.is-active,
  #{{ section_id }} .el-warr__tier:hover {
    border-color: var(--el-blue);
    box-shadow: 0 10px 30px rgba(88, 166, 255, 0.1);
  }

  #{{ section_id }} .el-warr__tier--pro.is-active,
  #{{ section_id }} .el-warr__tier--pro:hover {
    border-color: var(--el-green);
    box-shadow: 0 10px 30px rgba(63, 185, 80, 0.12);
  }

  #{{ section_id }} .el-warr__tier-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.2rem;
    border-bottom: 1px dashed var(--el-border);
    padding-bottom: 0.8rem;
  }

  #{{ section_id }} .el-warr__tier-name {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--el-heading);
    margin: 0;
    text-transform: uppercase;
  }

  #{{ section_id }} .el-warr__tier-price {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--el-blue);
  }

  #{{ section_id }} .el-warr__tier--pro .el-warr__tier-price {
    color: var(--el-green);
  }

  #{{ section_id }} .el-warr__tier-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    font-size: 0.82rem;
    line-height: 1.8;
  }

  #{{ section_id }} .el-warr__tier-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  #{{ section_id }} .el-warr__tier-list li::before {
    content: '[ + ]';
    color: var(--el-blue);
    font-weight: 700;
    font-size: 0.72rem;
  }

  #{{ section_id }} .el-warr__tier--pro .el-warr__tier-list li::before {
    color: var(--el-green);
  }

  #{{ section_id }} .el-warr__tier-btn {
    width: 100%;
    padding: 0.8rem;
    background: transparent;
    border: 1px solid var(--el-blue);
    color: var(--el-blue);
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  #{{ section_id }} .el-warr__tier--pro .el-warr__tier-btn {
    border-color: var(--el-green);
    color: var(--el-green);
  }

  #{{ section_id }} .el-warr__tier.is-active .el-warr__tier-btn {
    background: var(--el-blue);
    color: #000000;
  }

  #{{ section_id }} .el-warr__tier--pro.is-active .el-warr__tier-btn {
    background: var(--el-green);
    color: #000000;
  }

  /* 3-Step Express Claim Protocol Grid */
  #{{ section_id }} .el-warr__steps-box {
    background: #090c10;
    border: 1px solid var(--el-border);
    padding: 2rem;
    margin-bottom: 3rem;
  }

  #{{ section_id }} .el-warr__steps-title {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--el-blue);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin: 0 0 1.5rem 0;
  }

  #{{ section_id }} .el-warr__steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    #{{ section_id }} .el-warr__steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  #{{ section_id }} .el-warr__step {
    border-left: 2px solid var(--el-border);
    padding-left: 1.2rem;
  }

  #{{ section_id }} .el-warr__step-num {
    font-size: 0.72rem;
    color: var(--el-green);
    font-weight: 800;
    margin-bottom: 0.3rem;
    display: block;
  }

  #{{ section_id }} .el-warr__step-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--el-heading);
    margin: 0 0 0.4rem 0;
  }

  #{{ section_id }} .el-warr__step-desc {
    font-size: 0.78rem;
    color: #8b949e;
    line-height: 1.5;
  }

  /* FAQ Accordion Protocol */
  #{{ section_id }} .el-warr__faq {
    border-top: 1px solid var(--el-border);
    padding-top: 2rem;
  }

  #{{ section_id }} .el-warr__faq-item {
    border-bottom: 1px solid var(--el-border);
  }

  #{{ section_id }} .el-warr__faq-sum {
    padding: 1.2rem 0;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--el-heading);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }

  #{{ section_id }} .el-warr__faq-sum::-webkit-details-marker {
    display: none;
  }

  #{{ section_id }} .el-warr__faq-icon {
    color: var(--el-blue);
    font-size: 0.8rem;
  }

  #{{ section_id }} .el-warr__faq-ans {
    padding: 0 0 1.2rem 0;
    font-size: 0.82rem;
    color: #8b949e;
    line-height: 1.6;
  }
</style>

<section id="{{ section_id }}">
  <div class="el-warr__container">
    <div class="el-warr__header">
      <div>
        <span class="el-warr__sys-badge">[ {{ section.settings.eyebrow | default: "SYS.VERIFIED: CARE PROTOCOL" }} ]</span>
        <h2 class="el-warr__title">{{ section.settings.heading | default: "24-Month Hardware Care Accord" }}</h2>
      </div>
      <div style="font-size:0.75rem; color:#8b949e;">[ STATUS: 100% ADVANCE DISPATCH ENABLED ]</div>
    </div>

    <p class="el-warr__sub">
      We engineer our silicon for mission-critical reliability. If your unit experiences any hardware, battery degradation (>20%), or acoustic failure within 730 days of activation, <strong>we dispatch a brand new sealed replacement unit to your door within 24 hours</strong> prior to receiving the defective device. Zero deductible. Zero shipping fees across 19,000+ Indian pincodes.
    </p>

    <!-- Warranty Tier Selector Matrix -->
    <div class="el-warr__tiers" data-warr-tiers>
      <div class="el-warr__tier is-active" data-tier="standard">
        <div>
          <div class="el-warr__tier-head">
            <h3 class="el-warr__tier-name">[ STANDARD 2-YEAR ACCORD ]</h3>
            <span class="el-warr__tier-price">INCLUDED FREE</span>
          </div>
          <ul class="el-warr__tier-list">
            <li>24-Month Manufacturer Hardware Coverage</li>
            <li>24-Hour Express Advance Replacement Dispatch</li>
            <li>Doorstep Courier Pickup &amp; Exchange (Pan-India)</li>
            <li>Battery Health Guarantee (Replaced if &lt;80% capacity)</li>
          </ul>
        </div>
        <button type="button" class="el-warr__tier-btn">[ SELECTED PROTOCOL ]</button>
      </div>

      <div class="el-warr__tier el-warr__tier--pro" data-tier="pro">
        <div>
          <div class="el-warr__tier-head">
            <h3 class="el-warr__tier-name">[ PRO-CARE 3-YEAR + ACCIDENTAL ]</h3>
            <span class="el-warr__tier-price">+{{ section.settings.pro_price | default: 'INR 1,499' }}</span>
          </div>
          <ul class="el-warr__tier-list">
            <li>36-Month Extended Hardware &amp; Battery Coverage</li>
            <li>Accidental Drop &amp; Liquid Damage Protection (2 Claims)</li>
            <li>Priority 12-Hour VIP Replacement Dispatch</li>
            <li>Dedicated Technical Support Account Manager</li>
          </ul>
        </div>
        <button type="button" class="el-warr__tier-btn">[ UPGRADE PROTECTION ]</button>
      </div>
    </div>

    <!-- 3-Step Express Claim Sequence -->
    <div class="el-warr__steps-box">
      <div class="el-warr__steps-title">// 3-STEP EXPRESS REPLACEMENT SEQUENCE //</div>
      <div class="el-warr__steps-grid">
        <div class="el-warr__step">
          <span class="el-warr__step-num">[ STEP 01: AUTO-DIAGNOSE ]</span>
          <h4 class="el-warr__step-name">Scan QR &amp; Verify</h4>
          <p class="el-warr__step-desc">Scan the laser-etched serial QR code on your device. Our diagnostic portal auto-verifies warranty validity in 30 seconds.</p>
        </div>
        <div class="el-warr__step">
          <span class="el-warr__step-num">[ STEP 02: ADVANCE DISPATCH ]</span>
          <h4 class="el-warr__step-name">Instant New Unit Shipped</h4>
          <p class="el-warr__step-desc">A brand new sealed replacement unit is dispatched via priority air within 24 hours. No repair queues or waiting weeks.</p>
        </div>
        <div class="el-warr__step">
          <span class="el-warr__step-num">[ STEP 03: DOORSTEP SWAP ]</span>
          <h4 class="el-warr__step-name">Courier Exchange</h4>
          <p class="el-warr__step-desc">When the courier delivers your new unit, simply hand over the defective device in the provided prepaid return box.</p>
        </div>
      </div>
    </div>

    <!-- Policy FAQ Accordion -->
    <div class="el-warr__faq">
      <div style="font-size:0.75rem; font-weight:800; color:var(--el-blue); text-transform:uppercase; margin-bottom:1rem;">[ WARRANTY FAQ ARCHIVE ]</div>
      
      <details class="el-warr__faq-item">
        <summary class="el-warr__faq-sum">
          <span>What constitutes a valid hardware replacement claim?</span>
          <span class="el-warr__faq-icon">[ + ]</span>
        </summary>
        <div class="el-warr__faq-ans">
          Any spontaneous electrical failure, driver distortion, charging port malfunction, PCB defect, or battery degradation dropping below 80% original capacity qualifies for an immediate new unit exchange without inspection friction.
        </div>
      </details>

      <details class="el-warr__faq-item">
        <summary class="el-warr__faq-sum">
          <span>Is there any deductible or hidden shipping fee for replacement?</span>
          <span class="el-warr__faq-icon">[ + ]</span>
        </summary>
        <div class="el-warr__faq-ans">
          Zero deductible. Zero shipping charges. We absorb 100% of reverse logistics and priority delivery expenses across all 19,000+ serviceable pincodes in India and our international service centers.
        </div>
      </details>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var tiers = section.querySelectorAll('[data-warr-tiers] .el-warr__tier');
    tiers.forEach(function(tier) {
      tier.addEventListener('click', function() {
        tiers.forEach(function(t) {
          t.classList.remove('is-active');
          var btn = t.querySelector('.el-warr__tier-btn');
          if (btn) btn.textContent = t.classList.contains('el-warr__tier--pro') ? '[ UPGRADE PROTECTION ]' : '[ SELECT STANDARD ]';
        });
        this.classList.add('is-active');
        var activeBtn = this.querySelector('.el-warr__tier-btn');
        if (activeBtn) activeBtn.textContent = '[ SELECTED PROTOCOL ]';
      });
    });
  });
</script>

{% schema %}
{
  "name": "Tech Hardware Warranty",
  "tag": "section",
  "class": "section-warranty-badge-electronics",
  "settings": [
    {
      "type": "header",
      "content": "Protocol Messaging"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "System Badge",
      "default": "SYS.VERIFIED: CARE PROTOCOL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "24-Month Hardware Care Accord"
    },
    {
      "type": "text",
      "id": "pro_price",
      "label": "Pro-Care 3-Year Upgrade Price",
      "default": "INR 1,499"
    },
    {
      "type": "header",
      "content": "Color Tokens"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0d1117"
    }
  ],
  "presets": [
    {
      "name": "Tech Hardware Warranty"
    }
  ]
}
{% endschema %}
