<div class="ck-try-at-home" style="background-color: {{ section.settings.bg_color }};">
  <div class="ck-try-container">
    <div class="ck-try-image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: '800x800', crop: 'center' }}" alt="Try at home">
      {% else %}
        <div class="ck-placeholder-img"></div>
      {% endif %}
    </div>
    <div class="ck-try-content">
      <h2 class="ck-try-title" style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
      <p class="ck-try-text" style="color: {{ section.settings.text_color }};">{{ section.settings.text }}</p>
      
      <ul class="ck-try-features" style="color: {{ section.settings.text_color }};">
        {% for block in section.blocks %}
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.accent_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            {{ block.settings.feature }}
          </li>
        {% endfor %}
      </ul>
      
      {% if section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="ck-try-btn" style="background-color: {{ section.settings.accent_color }}; color: #fff;">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .ck-try-at-home {
    padding: 60px 20px;
  }
  .ck-try-container {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0,0,0,0.08);
  }
  .ck-try-image {
    flex: 1;
    min-height: 400px;
    background-color: #f4f4f4;
  }
  .ck-try-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ck-try-content {
    flex: 1;
    padding: 50px;
  }
  .ck-try-title {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    margin: 0 0 15px 0;
  }
  .ck-try-text {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 30px 0;
    opacity: 0.9;
  }
  .ck-try-features {
    list-style: none;
    padding: 0;
    margin: 0 0 30px 0;
  }
  .ck-try-features li {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
  }
  .ck-try-features svg {
    width: 20px;
    height: 20px;
    margin-right: 12px;
    flex-shrink: 0;
  }
  .ck-try-btn {
    display: inline-block;
    padding: 14px 32px;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: opacity 0.3s ease;
  }
  .ck-try-btn:hover {
    opacity: 0.9;
  }
  .ck-placeholder-img {
    width: 100%;
    height: 100%;
  }
  
  @media (max-width: 768px) {
    .ck-try-container {
      flex-direction: column;
    }
    .ck-try-image {
      width: 100%;
      min-height: 250px;
    }
    .ck-try-content {
      padding: 30px 20px;
    }
    .ck-try-title {
      font-size: 26px;
    }
  }
</style>

{% schema %}
{
  "name": "CK Try at Home",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Try at Home for Free"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Book a free appointment to try on our beautiful jewellery in the comfort of your own home, with absolutely no obligation to buy."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Book Appointment"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#fdf7f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#7D3C98"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature Text",
          "default": "Free trial with zero obligation to buy"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CK Try at Home",
      "blocks": [
        { "type": "feature", "settings": { "feature": "Free trial with zero obligation to buy" } },
        { "type": "feature", "settings": { "feature": "100% certified and sanitized jewellery" } },
        { "type": "feature", "settings": { "feature": "Expert assistance at your doorstep" } }
      ]
    }
  ]
}
{% endschema %}
