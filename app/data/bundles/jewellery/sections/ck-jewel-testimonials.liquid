<div class="ck-testimonials" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_y }}px 20px;">
  <div class="ck-container">
    <h2 class="ck-section-title" style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
    
    <div class="ck-testimonials-grid">
      {% for block in section.blocks %}
        <div class="ck-testimonial-card">
          <div class="ck-stars" style="color: {{ section.settings.accent_color }};">
            {% for i in (1..5) %}
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
            {% endfor %}
          </div>
          <p class="ck-review-text" style="color: {{ section.settings.text_color }};">"{{ block.settings.review }}"</p>
          <div class="ck-reviewer-info">
            <span class="ck-reviewer-name" style="color: {{ section.settings.text_color }};">{{ block.settings.author }}</span>
            {% if block.settings.location != blank %}
              <span class="ck-reviewer-loc">{{ block.settings.location }}</span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .ck-testimonials .ck-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .ck-testimonials .ck-section-title {
    text-align: center;
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    margin-bottom: 40px;
  }
  .ck-testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  .ck-testimonial-card {
    background: #fff;
    padding: 30px;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.04);
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .ck-stars {
    margin-bottom: 15px;
  }
  .ck-stars svg {
    width: 18px;
    height: 18px;
    margin: 0 2px;
  }
  .ck-review-text {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    font-style: italic;
    margin: 0 0 20px 0;
    flex-grow: 1;
  }
  .ck-reviewer-name {
    display: block;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 5px;
  }
  .ck-reviewer-loc {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: #888;
  }
  
  @media (max-width: 900px) {
    .ck-testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .ck-testimonials-grid {
      grid-template-columns: 1fr;
    }
    .ck-testimonials .ck-section-title {
      font-size: 26px;
    }
  }
</style>

{% schema %}
{
  "name": "CK Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What Our Customers Say"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fafafa"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Star Color",
      "default": "#F5B041"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "review",
          "label": "Review",
          "default": "Absolutely stunning piece of jewellery. The craftsmanship is flawless and the delivery was super fast!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Priya S."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Mumbai"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CK Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
