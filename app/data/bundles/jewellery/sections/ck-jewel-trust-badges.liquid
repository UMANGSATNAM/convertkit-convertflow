<div class="ck-trust-badges" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_y }}px 20px;">
  <div class="ck-trust-container">
    {% for block in section.blocks %}
      <div class="ck-trust-item">
        <div class="ck-trust-icon" style="color: {{ section.settings.icon_color }};">
          {% if block.settings.icon_svg != blank %}
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="{{ block.settings.icon_svg }}"></path>
            </svg>
          {% else %}
            <!-- Default check icon -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          {% endif %}
        </div>
        <span class="ck-trust-text" style="color: {{ section.settings.text_color }};">{{ block.settings.text }}</span>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .ck-trust-badges {
    border-top: 1px solid #eaeaea;
    border-bottom: 1px solid #eaeaea;
  }
  .ck-trust-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .ck-trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
    min-width: 150px;
  }
  .ck-trust-icon {
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ck-trust-icon svg {
    width: 32px;
    height: 32px;
  }
  .ck-trust-text {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
  }
  @media (max-width: 768px) {
    .ck-trust-container {
      grid-template-columns: repeat(2, 1fr);
      display: grid;
    }
    .ck-trust-item {
      min-width: unset;
    }
  }
</style>

{% schema %}
{
  "name": "CK Trust Badges",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fafafa"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#7D3C98"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon_svg",
          "label": "Icon SVG Path (d attribute)",
          "info": "Paste the 'd' attribute of an SVG path."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "100% Certified"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CK Trust Badges",
      "blocks": [
        { "type": "badge", "settings": { "text": "100% Certified" } },
        { "type": "badge", "settings": { "text": "15-Day Returns" } },
        { "type": "badge", "settings": { "text": "Lifetime Exchange" } },
        { "type": "badge", "settings": { "text": "Insured Shipping" } }
      ]
    }
  ]
}
{% endschema %}
