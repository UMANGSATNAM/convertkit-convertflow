<div class="ck-shop-price" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_y }}px 20px;">
  <div class="ck-container">
    <h2 class="ck-section-title" style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
    
    <div class="ck-price-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="ck-price-item">
          <div class="ck-price-image-wrap">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '400x400', crop: 'center' }}" alt="{{ block.settings.title }}">
            {% else %}
              <div class="ck-placeholder-img"></div>
            {% endif %}
            <div class="ck-price-overlay">
              <span>{{ block.settings.title }}</span>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .ck-shop-price .ck-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .ck-shop-price .ck-section-title {
    text-align: center;
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    margin-bottom: 40px;
  }
  .ck-price-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .ck-price-item {
    display: block;
    text-decoration: none;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .ck-price-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  }
  .ck-price-image-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    position: relative;
    background-color: #f9f9f9;
  }
  .ck-price-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .ck-price-item:hover .ck-price-image-wrap img {
    transform: scale(1.05);
  }
  .ck-price-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 100%);
    padding: 20px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 50%;
  }
  .ck-price-overlay span {
    color: #ffffff;
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 600;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  }
  .ck-placeholder-img {
    width: 100%;
    height: 100%;
    background-color: #eee;
  }
  
  @media (max-width: 768px) {
    .ck-price-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
    .ck-shop-price .ck-section-title {
      font-size: 24px;
      margin-bottom: 25px;
    }
    .ck-price-overlay span {
      font-size: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "CK Shop by Price",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shop By Price"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "price_range",
      "name": "Price Range",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Range Text",
          "default": "Under ₹10k"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CK Shop by Price",
      "blocks": [
        { "type": "price_range", "settings": { "title": "Under ₹10k" } },
        { "type": "price_range", "settings": { "title": "₹10k - ₹20k" } },
        { "type": "price_range", "settings": { "title": "₹20k - ₹40k" } },
        { "type": "price_range", "settings": { "title": "Above ₹40k" } }
      ]
    }
  ]
}
{% endschema %}
