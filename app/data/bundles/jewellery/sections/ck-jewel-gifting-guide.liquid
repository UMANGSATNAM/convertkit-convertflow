<div class="ck-gifting-guide" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_y }}px 20px;">
  <div class="ck-container">
    <div class="ck-gifting-header text-center">
      <h2 class="ck-section-title" style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
      <p class="ck-section-subtitle" style="color: {{ section.settings.text_color }};">{{ section.settings.subtitle }}</p>
    </div>
    
    <div class="ck-gifting-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="ck-gift-card">
          <div class="ck-gift-image">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '600x600', crop: 'center' }}" alt="{{ block.settings.title }}">
            {% else %}
              <div class="ck-placeholder-img"></div>
            {% endif %}
          </div>
          <div class="ck-gift-content">
            <h3 class="ck-gift-title">{{ block.settings.title }}</h3>
            <span class="ck-gift-btn" style="color: {{ section.settings.accent_color }};">Shop Now</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .ck-gifting-guide .ck-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .ck-gifting-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .ck-gifting-guide .ck-section-title {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    margin: 0 0 10px 0;
  }
  .ck-gifting-guide .ck-section-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    opacity: 0.8;
    margin: 0;
  }
  .ck-gifting-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  .ck-gift-card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.3s ease;
  }
  .ck-gift-card:hover {
    transform: translateY(-5px);
  }
  .ck-gift-image {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 20px;
    background-color: #f0f0f0;
  }
  .ck-gift-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .ck-gift-card:hover .ck-gift-image img {
    transform: scale(1.05);
  }
  .ck-gift-content {
    text-align: center;
  }
  .ck-gift-title {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    color: #333;
    margin: 0 0 10px 0;
  }
  .ck-gift-btn {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    position: relative;
  }
  .ck-gift-btn::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    transform: scaleX(0);
    transition: transform 0.3s ease;
    transform-origin: right;
  }
  .ck-gift-card:hover .ck-gift-btn::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .ck-placeholder-img {
    width: 100%;
    height: 100%;
    background-color: #eee;
  }
  
  @media (max-width: 900px) {
    .ck-gifting-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }
  @media (max-width: 600px) {
    .ck-gifting-guide .ck-section-title {
      font-size: 26px;
    }
    .ck-gifting-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .ck-gift-image {
      aspect-ratio: 16 / 9;
    }
  }
</style>

{% schema %}
{
  "name": "CK Gifting Guide",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Gifts of Love"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Find the perfect jewellery for the ones you cherish."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdf7f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#B76E79"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "gift_category",
      "name": "Gift Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "For Mom"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CK Gifting Guide",
      "blocks": [
        { "type": "gift_category", "settings": { "title": "For Her" } },
        { "type": "gift_category", "settings": { "title": "For Mom" } },
        { "type": "gift_category", "settings": { "title": "For Sister" } }
      ]
    }
  ]
}
{% endschema %}
