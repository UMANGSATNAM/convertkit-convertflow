<div class="ck-new-arrivals" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_y }}px 20px;">
  <div class="ck-container">
    <div class="ck-header">
      <h2 class="ck-section-title" style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
      <p class="ck-section-subtitle" style="color: {{ section.settings.text_color }};">{{ section.settings.subtitle }}</p>
    </div>
    
    <div class="ck-arrivals-grid">
      {% assign collection = collections[section.settings.collection] %}
      {% if collection != blank and collection.products_count > 0 %}
        {% for product in collection.products limit: 4 %}
          <div class="ck-arrival-card">
            <a href="{{ product.url }}" class="ck-arrival-img">
              <img src="{{ product.featured_image | img_url: '600x800', crop: 'center' }}" alt="{{ product.title }}">
              <div class="ck-quick-view" style="background-color: {{ section.settings.accent_color }};">View Details</div>
            </a>
            <div class="ck-arrival-info">
              <h3 class="ck-product-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <span class="ck-price">{{ product.price | money }}</span>
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="ck-arrival-card ck-placeholder">
            <div class="ck-arrival-img" style="background-color: #f0f0f0;"></div>
            <div class="ck-arrival-info">
              <h3 class="ck-product-title">Elegant Diamond Ring</h3>
              <span class="ck-price">$499.00</span>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
    
    {% if section.settings.view_all_link != blank %}
      <div class="ck-view-all-wrapper">
        <a href="{{ section.settings.view_all_link }}" class="ck-view-all-btn" style="border-color: {{ section.settings.accent_color }}; color: {{ section.settings.accent_color }};">
          {{ section.settings.view_all_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

<style>
  .ck-new-arrivals .ck-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .ck-new-arrivals .ck-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .ck-new-arrivals .ck-section-title {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    margin: 0 0 10px 0;
  }
  .ck-new-arrivals .ck-section-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    opacity: 0.8;
    margin: 0;
  }
  .ck-arrivals-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }
  .ck-arrival-card {
    text-align: center;
  }
  .ck-arrival-img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    position: relative;
    overflow: hidden;
    margin-bottom: 15px;
    background-color: #f9f9f9;
  }
  .ck-arrival-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }
  .ck-arrival-card:hover .ck-arrival-img img {
    transform: scale(1.05);
  }
  .ck-quick-view {
    position: absolute;
    bottom: -50px;
    left: 0;
    width: 100%;
    padding: 12px;
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    transition: bottom 0.3s ease;
  }
  .ck-arrival-card:hover .ck-quick-view {
    bottom: 0;
  }
  .ck-product-title {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 400;
    margin: 0 0 8px 0;
  }
  .ck-product-title a {
    color: #333;
    text-decoration: none;
  }
  .ck-price {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    color: #333;
  }
  .ck-view-all-wrapper {
    text-align: center;
  }
  .ck-view-all-btn {
    display: inline-block;
    padding: 12px 30px;
    border: 1px solid;
    background: transparent;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }
  .ck-view-all-btn:hover {
    background: #B76E79;
    color: #fff !important;
  }
  
  @media (max-width: 900px) {
    .ck-arrivals-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .ck-new-arrivals .ck-section-title {
      font-size: 26px;
    }
  }
</style>

{% schema %}
{
  "name": "CK New Arrivals Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover the latest additions to our exquisite collection."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "Button Text",
      "default": "Explore All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#B76E79"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "CK New Arrivals Grid"
    }
  ]
}
{% endschema %}
