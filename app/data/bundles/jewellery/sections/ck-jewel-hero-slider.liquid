<div class="ck-jewel-hero" style="background-color: {{ section.settings.bg_color }};">
  <div class="ck-hero-content">
    <h1 style="color: {{ section.settings.text_color }}; font-family: 'Playfair Display', serif;">{{ section.settings.headline }}</h1>
    <p style="color: {{ section.settings.text_color }}; font-family: 'Inter', sans-serif;">{{ section.settings.subheadline }}</p>
    {% if section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}" class="ck-hero-btn" style="background-color: {{ section.settings.btn_color }}; color: #fff;">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>

<style>
  .ck-jewel-hero {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 80px 20px;
    background-size: cover;
    background-position: center;
  }
  .ck-hero-content {
    max-width: 600px;
    margin: 0 auto;
  }
  .ck-hero-content h1 {
    font-size: 42px;
    margin-bottom: 15px;
    font-weight: 600;
    line-height: 1.2;
  }
  .ck-hero-content p {
    font-size: 18px;
    margin-bottom: 30px;
    opacity: 0.9;
  }
  .ck-hero-btn {
    display: inline-block;
    padding: 12px 32px;
    text-decoration: none;
    font-weight: 500;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: opacity 0.3s ease;
  }
  .ck-hero-btn:hover {
    opacity: 0.8;
  }
  @media (max-width: 768px) {
    .ck-jewel-hero {
      padding: 60px 20px;
    }
    .ck-hero-content h1 {
      font-size: 32px;
    }
  }
</style>

{% schema %}
{
  "name": "CK Jewel Hero",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "The Perfect Gift for Her"
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Discover our new Diamond Collection, crafted with love."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdf7f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button Color",
      "default": "#B76E79"
    }
  ],
  "presets": [
    {
      "name": "CK Jewel Hero"
    }
  ]
}
{% endschema %}
