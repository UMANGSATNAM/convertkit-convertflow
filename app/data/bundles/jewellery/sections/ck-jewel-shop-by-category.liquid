<div class="ck-shop-category" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_y }}px 20px;">
  <div class="ck-container">
    <h2 class="ck-section-title" style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
    
    <div class="ck-category-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="ck-category-item">
          <div class="ck-category-image-wrap">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '400x400', crop: 'center' }}" alt="{{ block.settings.title }}">
            {% else %}
              <div class="ck-placeholder-img"></div>
            {% endif %}
          </div>
          <span class="ck-category-title" style="color: {{ section.settings.text_color }};">{{ block.settings.title }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .ck-shop-category .ck-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .ck-section-title {
    text-align: center;
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    margin-bottom: 40px;
  }
  .ck-category-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .ck-category-item {
    text-align: center;
    text-decoration: none;
    display: block;
    transition: transform 0.3s ease;
  }
  .ck-category-item:hover {
    transform: translateY(-5px);
  }
  .ck-category-image-wrap {
    border-radius: 50%;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 1 / 1;
    margin-bottom: 15px;
    background-color: #f4f4f4;
    border: 2px solid transparent;
    transition: border-color 0.3s ease;
  }
  .ck-category-item:hover .ck-category-image-wrap {
    border-color: #B76E79;
  }
  .ck-category-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ck-placeholder-img {
    width: 100%;
    height: 100%;
    background-color: #eee;
  }
  .ck-category-title {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 500;
  }
  
  @media (max-width: 768px) {
    .ck-category-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
    .ck-section-title {
      font-size: 24px;
      margin-bottom: 25px;
    }
  }
</style>

{% schema %}
{
  "name": "CK Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shop By Category"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Rings"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CK Shop by Category",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
