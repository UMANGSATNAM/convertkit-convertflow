<div class="ck-store-locator" style="background-color: {{ section.settings.bg_color }};">
  <div class="ck-store-container">
    <div class="ck-store-content text-center">
      <div class="ck-store-icon" style="color: {{ section.settings.accent_color }};">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
      </div>
      <h2 class="ck-store-title" style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
      <p class="ck-store-text" style="color: {{ section.settings.text_color }};">{{ section.settings.text }}</p>
      
      {% if section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="ck-store-btn" style="background-color: {{ section.settings.accent_color }}; color: #fff;">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .ck-store-locator {
    padding: 60px 20px;
    border-top: 1px solid #eaeaea;
    border-bottom: 1px solid #eaeaea;
  }
  .ck-store-container {
    max-width: 800px;
    margin: 0 auto;
  }
  .ck-store-content {
    text-align: center;
  }
  .ck-store-icon {
    margin-bottom: 20px;
    display: inline-block;
  }
  .ck-store-icon svg {
    width: 48px;
    height: 48px;
  }
  .ck-store-title {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    margin: 0 0 15px 0;
  }
  .ck-store-text {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    opacity: 0.8;
    margin: 0 0 30px 0;
  }
  .ck-store-btn {
    display: inline-block;
    padding: 12px 30px;
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 4px;
    transition: opacity 0.3s ease;
  }
  .ck-store-btn:hover {
    opacity: 0.9;
  }
  
  @media (max-width: 600px) {
    .ck-store-title {
      font-size: 26px;
    }
  }
</style>

{% schema %}
{
  "name": "CK Store Locator",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Find a Store Near You"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Experience our jewellery in person. Visit one of our 100+ stores across the country to try on your favorite designs."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Locate Store"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#7D3C98"
    }
  ],
  "presets": [
    {
      "name": "CK Store Locator"
    }
  ]
}
{% endschema %}
