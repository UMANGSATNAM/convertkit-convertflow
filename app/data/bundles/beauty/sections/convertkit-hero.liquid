<div class="convertkit-hero" style="padding: 40px; text-align: center; background: #fdfaf6;">
  <h1>{{ section.settings.title }}</h1>
  <p>{{ section.settings.subtitle }}</p>
</div>

{% schema %}
{
  "name": "ConvertKit Hero",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Welcome"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Subtitle text"
    }
  ],
  "presets": [
    {
      "name": "ConvertKit Hero"
    }
  ]
}
{% endschema %}
