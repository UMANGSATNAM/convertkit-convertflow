<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var tabs = section.querySelectorAll('.auth__tab');
    var contents = section.querySelectorAll('.auth__content');
    var presetBtns = section.querySelectorAll('.auth__preset-btn');

    var serialInput = section.querySelector('[data-serial-input]');
    var serialSubmit = section.querySelector('[data-serial-submit]');
    var serialTitle = section.querySelector('[data-serial-title]');
    var serialStatus = section.querySelector('[data-serial-status]');
    var hashVal = section.querySelector('[data-hash-val]');

    var modalOpen = section.querySelector('[data-modal-open]');
    var modalBox = section.querySelector('[data-modal-box]');
    var modalClose = section.querySelector('[data-modal-close]');

    var hashes = {
      'SF-HOOD-0042': '8f9a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e',
      'SF-TEE-0188': '1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f',
      'SF-JKT-0019': '9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d'
    };

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('is-active'); });
        this.classList.add('is-active');
        var target = this.getAttribute('data-target') || 'nfc';

        contents.forEach(function(c) {
          var cTarget = c.getAttribute('data-content') || 'nfc';
          if (cTarget === target) {
            c.classList.add('is-active');
          } else {
            c.classList.remove('is-active');
          }
        });
      });
    });

    function updateSerial(serial) {
      if (serialTitle) serialTitle.textContent = '[ ARCHIVE SERIAL: #' + serial.toUpperCase() + ' ]';
      if (serialStatus) serialStatus.textContent = '[ NFC VERIFIED: GENUINE ]';
      if (serialInput) serialInput.value = serial.toUpperCase();
      if (hashVal) {
        hashVal.textContent = hashes[serial.toUpperCase()] || '7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b';
      }
    }

    presetBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        presetBtns.forEach(function(b) { b.classList.remove('is-active'); });
        this.classList.add('is-active');
        var s = this.getAttribute('data-serial') || 'SF-HOOD-0042';
        updateSerial(s);
      });
    });

    if (serialSubmit && serialInput) {
      serialSubmit.addEventListener('click', function() {
        var val = serialInput.value.trim() || 'SF-HOOD-0042';
        serialSubmit.textContent = '[ DECRYPTING... ]';
        setTimeout(function() {
          updateSerial(val);
          serialSubmit.textContent = '[ DECRYPT HASH -> ]';
        }, 500);
      });
    }

    if (modalOpen) {
      modalOpen.addEventListener('click', function() {
        if (modalBox) {
          modalBox.style.display = 'block';
          modalBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    }

    if (modalClose) {
      modalClose.addEventListener('click', function() {
        if (modalBox) modalBox.style.display = 'none';
      });
    }
  });
</script>

