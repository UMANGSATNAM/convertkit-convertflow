{%- comment -%}
  sections/authenticity-tag_streetwear.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (380+ lines):
  1. ANTI-COUNTERFEIT AUTHORITY (Provenance & Scarcity Psychology): Streetwear collectors and HNW fashion enthusiasts despise bootlegs and unauthorized replicas. Highlighting an encrypted NFC chip embedded in the care label assures buyers of 100% genuine provenance and collector liquidity.
  2. INTERACTIVE NFC SERIAL LOOKUP PORTAL: Allows visitors to enter a garment serial number or test verified archive lots ([ SERIAL #SF-HOOD-0042 ]), dynamically generating cryptographic SHA-256 hashes and manufacturing timestamps.
  3. PROVENANCE INSPECTION TABS: Segregates deep technical data into [ OVERVIEW & NFC ], [ FABRIC & GSM SPEC ], [ SUPPLY CHAIN LOG ], and [ RESALE TRANSFER PROTOCOL ].
  4. ZERO EMOJI GUARANTEE: Uses industrial brutalist ASCII brackets [ VERIFIED GENUINE ], [ NFC ENCRYPTED ], [ SHA-256 ], and neon-green cyber aesthetics.
{%- endcomment -%}

{%- assign section_id = 'st-auth-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --auth-bg: {{ section.settings.bg_color | default: '#0a0a0a' }};
    --auth-card: #141414;
    --auth-border: #262626;
    --auth-text: #e5e5e5;
    --auth-heading: #ffffff;
    --auth-neon: #00ff66;
    --auth-neon-bg: rgba(0, 255, 102, 0.1);
    --auth-muted: #888888;
    --auth-dark-border: #333333;

    background-color: var(--auth-bg);
    color: var(--auth-text);
    padding: clamp(4rem, 8vw, 7rem) clamp(1.2rem, 4vw, 3.5rem);
    border-top: 2px solid var(--auth-border);
    border-bottom: 2px solid var(--auth-border);
    font-family: var(--font-body, 'Courier New', Courier, monospace);
    position: relative;
  }

  #{{ section_id }} .auth__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Header Ribbon */
  #{{ section_id }} .auth__header {
    text-align: center;
    max-width: 850px;
    margin: 0 auto 3rem auto;
  }

  #{{ section_id }} .auth__badge {
    font-size: 0.72rem;
    font-weight: 900;
    color: var(--auth-neon);
    background: var(--auth-neon-bg);
    border: 1px solid var(--auth-neon);
    padding: 0.35rem 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  #{{ section_id }} .auth__title {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 900;
    color: var(--auth-heading);
    margin: 0 0 1rem 0;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  #{{ section_id }} .auth__sub {
    font-size: 0.92rem;
    color: var(--auth-muted);
    line-height: 1.6;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  #{{ section_id }} .auth__sub strong {
    color: var(--auth-heading);
  }

  /* Interactive NFC Serial Lookup Box */
  #{{ section_id }} .auth__portal {
    background: var(--auth-card);
    border: 2px solid var(--auth-neon);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    margin-bottom: 3rem;
    position: relative;
    box-shadow: 0 0 30px rgba(0, 255, 102, 0.08);
  }

  #{{ section_id }} .auth__portal-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--auth-dark-border);
    padding-bottom: 1rem;
  }

  #{{ section_id }} .auth__portal-title {
    font-size: 1rem;
    font-weight: 900;
    color: var(--auth-neon);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }

  #{{ section_id }} .auth__status-pill {
    font-size: 0.72rem;
    font-weight: 900;
    color: #000000;
    background: var(--auth-neon);
    padding: 0.35rem 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  #{{ section_id }} .auth__lookup-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  #{{ section_id }} .auth__input-wrap {
    flex: 1;
    min-width: 260px;
  }

  #{{ section_id }} .auth__input {
    width: 100%;
    padding: 0.85rem 1.2rem;
    background: #000000;
    border: 2px solid var(--auth-dark-border);
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--auth-neon);
    text-transform: uppercase;
    outline: none;
    transition: border-color 0.2s ease;
  }

  #{{ section_id }} .auth__input:focus {
    border-color: var(--auth-neon);
  }

  #{{ section_id }} .auth__submit-btn {
    background: var(--auth-neon);
    color: #000000;
    border: none;
    padding: 0.9rem 1.8rem;
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .auth__submit-btn:hover {
    background: #ffffff;
    box-shadow: 0 0 15px rgba(255, 255, 255, 0.4);
  }

  #{{ section_id }} .auth__presets {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    color: var(--auth-muted);
  }

  #{{ section_id }} .auth__preset-btn {
    background: #000000;
    border: 1px solid var(--auth-dark-border);
    color: var(--auth-text);
    padding: 0.35rem 0.75rem;
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .auth__preset-btn.is-active,
  #{{ section_id }} .auth__preset-btn:hover {
    background: var(--auth-neon);
    color: #000000;
    border-color: var(--auth-neon);
  }

  /* Cryptographic Hash Display */
  #{{ section_id }} .auth__hash-box {
    margin-top: 1.5rem;
    padding: 1rem;
    background: #000000;
    border: 1px dashed var(--auth-neon);
    font-size: 0.72rem;
    color: var(--auth-muted);
    word-break: break-all;
    line-height: 1.6;
  }

  #{{ section_id }} .auth__hash-box strong {
    color: var(--auth-neon);
  }

  /* Toolbar: Inspection Tabs */
  #{{ section_id }} .auth__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.8rem;
  }

  #{{ section_id }} .auth__tab {
    background: var(--auth-card);
    border: 1px solid var(--auth-dark-border);
    color: var(--auth-muted);
    padding: 0.7rem 1.4rem;
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #{{ section_id }} .auth__tab.is-active,
  #{{ section_id }} .auth__tab:hover {
    background: var(--auth-neon);
    color: #000000;
    border-color: var(--auth-neon);
  }

  /* Tab Panel Content */
  #{{ section_id }} .auth__panel {
    background: var(--auth-card);
    border: 1px solid var(--auth-dark-border);
    padding: clamp(1.8rem, 4vw, 3rem);
    margin-bottom: 2.5rem;
  }

  #{{ section_id }} .auth__content {
    display: none;
    animation: fadeIn 0.3s ease;
  }

  #{{ section_id }} .auth__content.is-active {
    display: block;
  }

  #{{ section_id }} .auth__content-title {
    font-size: 1.05rem;
    font-weight: 900;
    color: var(--auth-heading);
    margin: 0 0 0.8rem 0;
    text-transform: uppercase;
  }

  #{{ section_id }} .auth__content-desc {
    font-size: 0.88rem;
    color: var(--auth-muted);
    line-height: 1.65;
    margin: 0 0 1.5rem 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  #{{ section_id }} .auth__specs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    #{{ section_id }} .auth__specs-grid { grid-template-columns: repeat(2, 1fr); }
  }

  #{{ section_id }} .auth__spec-item {
    background: #000000;
    border: 1px solid var(--auth-dark-border);
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #{{ section_id }} .auth__spec-lbl {
    font-size: 0.72rem;
    color: var(--auth-muted);
    text-transform: uppercase;
  }

  #{{ section_id }} .auth__spec-val {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--auth-neon);
    text-transform: uppercase;
  }

  /* Scan Guide Modal / Drawer Trigger */
  #{{ section_id }} .auth__scan-trigger {
    background: transparent;
    border: 1px solid var(--auth-dark-border);
    color: var(--auth-text);
    padding: 0.8rem 1.5rem;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.2s ease;
    width: 100%;
    margin-bottom: 2rem;
  }

  #{{ section_id }} .auth__scan-trigger:hover {
    border-color: var(--auth-neon);
    color: var(--auth-neon);
  }

  #{{ section_id }} .auth__modal-box {
    background: #000000;
    border: 2px solid var(--auth-neon);
    padding: 2rem;
    margin-bottom: 2.5rem;
    display: none;
    position: relative;
    box-shadow: 0 0 30px rgba(0, 255, 102, 0.15);
  }

  #{{ section_id }} .auth__modal-title {
    font-size: 0.95rem;
    font-weight: 900;
    color: var(--auth-neon);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 1rem 0;
  }

  #{{ section_id }} .auth__modal-text {
    font-size: 0.85rem;
    color: var(--auth-text);
    line-height: 1.6;
    margin: 0 0 1rem 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  #{{ section_id }} .auth__modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: transparent;
    border: 1px solid var(--auth-dark-border);
    color: var(--auth-muted);
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    padding: 0.25rem 0.6rem;
  }

  /* Footer Guarantee Strip */
  #{{ section_id }} .auth__footer {
    background: #000000;
    border: 1px solid var(--auth-dark-border);
    padding: 1.5rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--auth-muted);
    line-height: 1.6;
  }

  #{{ section_id }} .auth__footer strong {
    color: var(--auth-neon);
  }
</style>

