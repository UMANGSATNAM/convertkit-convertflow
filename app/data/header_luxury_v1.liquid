    gap: 0.8rem;
    margin: 0 auto;
  }

  #{{ section_id }} .hd__t-btn {
    background: transparent;
    border: none;
    color: var(--hd-gold);
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 900;
    padding: 0 0.4rem;
  }

  #{{ section_id }} .hd__ticker-text {
    text-align: center;
