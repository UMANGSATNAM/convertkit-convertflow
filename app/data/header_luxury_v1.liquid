<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    // Ticker Logic
    var tickerDisp = section.querySelector('[data-ticker-disp]');
    var prevBtn = section.querySelector('[data-t-prev]');
    var nextBtn = section.querySelector('[data-t-next]');
    var msgs = [
      '[ VAULT ALLOCATION: <strong>ONLY 4 SOVEREIGN CHRONOGRAPHS</strong> IN STOCK ]',
      '[ COMPLIMENTARY <strong>LLOYD\'S ARMORED COURIER</strong> ON ALL ACQUISITIONS ]',
      '[ PRIVATE CONCIERGE LINE ACTIVE: <strong>+41 22 819 0011</strong> (GENEVA) ]',
      '[ 100% ETHICAL <strong>KIMBERLEY PROCESS</strong> CERTIFIED GEMSTONES ]'
    ];
    var mIdx = 0;

    function updateTicker() {
      if (tickerDisp) tickerDisp.innerHTML = msgs[mIdx];
    }

    if (prevBtn && nextBtn) {
      prevBtn.addEventListener('click', function() {
        mIdx = (mIdx - 1 + msgs.length) % msgs.length;
        updateTicker();
      });
      nextBtn.addEventListener('click', function() {
        mIdx = (mIdx + 1) % msgs.length;
        updateTicker();
      });
      setInterval(function() {
        mIdx = (mIdx + 1) % msgs.length;
        updateTicker();
      }, 6000);
    }

    // Mega Menu Trigger Logic
    var triggers = section.querySelectorAll('[data-mega-trigger]');
    var panels = section.querySelectorAll('[data-mega-panel]');

    triggers.forEach(function(trig) {
      trig.addEventListener('click', function(e) {
        e.preventDefault();
        var target = this.getAttribute('data-mega-trigger');
        
        var isOpen = false;
        panels.forEach(function(p) {
          if (p.getAttribute('data-mega-panel') === target) {
            isOpen = p.classList.contains('is-open');
          }
          p.classList.remove('is-open');
        });

        if (!isOpen) {
          var targetPanel = section.querySelector('[data-mega-panel="' + target + '"]');
          if (targetPanel) targetPanel.classList.add('is-open');
          this.classList.add('is-active');
        } else {
          this.classList.remove('is-active');
        }
      });
    });

    document.addEventListener('click', function(e) {
      if (!section.contains(e.target)) {
        panels.forEach(function(p) { p.classList.remove('is-open'); });
        triggers.forEach(function(t) { t.classList.remove('is-active'); });
      }
    });

    // Search Drawer Modal Logic
    var openSearchBtn = section.querySelector('[data-open-search]');
    var searchModal = section.querySelector('[data-search-modal]');
    var closeSearchBtn = section.querySelector('[data-close-search]');
    var searchInput = section.querySelector('[data-s-input]');
    var searchSubmit = section.querySelector('[data-s-btn]');
    var searchTags = section.querySelectorAll('[data-q]');

    if (openSearchBtn && searchModal) {
      openSearchBtn.addEventListener('click', function() {
        searchModal.classList.add('is-open');
        if (searchInput) searchInput.focus();
      });
    }

    if (closeSearchBtn && searchModal) {
      closeSearchBtn.addEventListener('click', function() {
        searchModal.classList.remove('is-open');
      });
      searchModal.addEventListener('click', function(e) {
        if (e.target === searchModal) searchModal.classList.remove('is-open');
      });
    }

    if (searchSubmit && searchInput) {
      searchSubmit.addEventListener('click', function() {
        var q = searchInput.value.trim();
        if (!q) return;
        alert('[ ARCHIVE SEARCH ]\n\nSearching Geneva & Florence vault inventory for: "' + q + '"...\n\nDisplaying 3 available matching masterpieces.');
        if (searchModal) searchModal.classList.remove('is-open');
      });
    }

    searchTags.forEach(function(tag) {
      tag.addEventListener('click', function() {
        var q = this.getAttribute('data-q');
        if (searchInput) {
          searchInput.value = q;
          if (searchSubmit) searchSubmit.click();
        }
      });
    });

    var currSelect = section.querySelector('[data-hd-curr]');
    if (currSelect) {
      currSelect.addEventListener('change', function() {
        alert('[ SETTLEMENT SHIFT ] Valuation currency shifted to ' + this.value + '.');
      });
    }
  });
</script>

