{%- comment -%}
  sections/gift-packaging_luxury.liquid
  
  CONVERSION PSYCHOLOGY & ARCHITECTURE:
  1. UNBOXING ANTICIPATION & ENDOWMENT EFFECT -- In high-ticket e-commerce,
     the physical presentation represents up to 50% of the perceived brand value
     (Cartier Red Box, Tiffany Blue Box). By detailing the multi-layered unboxing
     ritual, we trigger sensory anticipation and emotional ownership before purchase.
  2. GIFTING CONVERSION TRIGGER -- Over 40% of fine jewelry purchases are gifts.
     Offering complimentary handwritten calligraphy notes and discreet shipping
     removes the two biggest anxieties of online gift buyers: presentation quality
     and premature surprise ruin.
  3. INTERACTIVE PRESENTATION SUITE -- A clean toggle between "Signature Heirloom"
     and "Discreet Eco-Luxury" empowers customer choice while reinforcing status.
  4. ZERO EMOJI POLICY -- Strict editorial ASCII typography [ LIKE THIS ] for all
     packaging tiers and features.
{%- endcomment -%}

<style>
  .lx-gift {
    background: var(--gift-bg, #0a0a0a);
    color: var(--gift-color, #fff);
    padding: clamp(4rem, 8vw, 7rem) 1.5rem;
    font-family: var(--font-body, sans-serif);
    border-bottom: 1px solid rgba(201, 169, 110, 0.15);
  }

  .lx-gift__inner {
    max-width: var(--max-width, 1300px);
    margin: 0 auto;
  }

  /* Header Section */
  .lx-gift__header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 3.5rem auto;
  }

  .lx-gift__subtitle {
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #c9a96e;
    margin-bottom: 0.75rem;
    display: block;
  }

  .lx-gift__title {
    font-family: var(--font-heading, serif);
    font-size: clamp(2rem, 3.8vw, 3.25rem);
    font-weight: 400;
    margin: 0 0 1.25rem 0;
    line-height: 1.2;
  }

  .lx-gift__desc {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.98rem;
    line-height: 1.7;
    margin: 0;
  }

  /* Interactive Toggle Bar */
  .lx-gift__toggle-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 3.5rem;
  }

  .lx-gift__toggle {
    display: inline-flex;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(201, 169, 110, 0.3);
    padding: 0.3rem;
  }

  .lx-gift__toggle-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 0.8rem 1.75rem;
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .lx-gift__toggle-btn.is-active {
    background: #c9a96e;
    color: #080808;
    font-weight: 600;
  }

  /* Content Display Panels */
  .lx-gift__panel {
    display: none;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
    animation: lxGiftFadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .lx-gift__panel.is-active {
    display: grid;
  }

  @media (max-width: 968px) {
    .lx-gift__panel.is-active {
      grid-template-columns: 1fr;
    }
  }

  @keyframes lxGiftFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Visual Column */
  .lx-gift__img-container {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }

  .lx-gift__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(105%) brightness(95%);
    transition: transform 0.8s ease;
  }

  .lx-gift__img-container:hover .lx-gift__img {
    transform: scale(1.03);
  }

  .lx-gift__badge {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    background: #0a0a0a;
    border: 1px solid #c9a96e;
    padding: 0.5rem 1rem;
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9a96e;
  }

  /* Details Column */
  .lx-gift__details {
    display: flex;
    flex-direction: column;
  }

  .lx-gift__panel-title {
    font-family: var(--font-heading, serif);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 400;
    margin: 0 0 1rem 0;
    color: #fff;
  }

  .lx-gift__panel-desc {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0 0 2rem 0;
  }

  .lx-gift__features {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .lx-gift__feature-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    align-items: baseline;
  }

  .lx-gift__feature-icon {
    font-size: 0.75rem;
    color: #c9a96e;
    font-family: monospace;
    font-weight: 600;
  }

  .lx-gift__feature-title {
    color: #fff;
    font-size: 0.9rem;
    font-weight: 500;
    margin: 0 0 0.25rem 0;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .lx-gift__feature-text {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Calligraphy Note Highlight Box */
  .lx-gift__note-box {
    background: rgba(201, 169, 110, 0.04);
    border-left: 2px solid #c9a96e;
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .lx-gift__note-text {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.05em;
  }

  .lx-gift__note-tag {
    font-size: 0.7rem;
    color: #c9a96e;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
  }
</style>

<section
  class="lx-gift"
  data-section-id="{{ section.id }}"
  data-section-type="gift-packaging">
  
  <div class="lx-gift__inner">
    {%- comment -%} Header {%- endcomment -%}
    <div class="lx-gift__header">
      <span class="lx-gift__subtitle">{{ section.settings.subtitle | default: "[ THE UNBOXING RITUAL ]" }}</span>
      <h2 class="lx-gift__title">{{ section.settings.title | default: "Signature Heirloom Presentation" }}</h2>
      <p class="lx-gift__desc">
        {{ section.settings.description | default: "A jewel of extraordinary provenance deserves a presentation of equal distinction. Every order is encased in our signature velvet suite, designed to preserve your heirloom for generations." }}
      </p>
    </div>

    {%- comment -%} Toggle Controls {%- endcomment -%}
    <div class="lx-gift__toggle-wrapper">
      <div class="lx-gift__toggle" role="tablist">
        <button type="button" class="lx-gift__toggle-btn is-active" data-target="signature" role="tab" aria-selected="true">
          [ SIGNATURE VELVET SUITE ]
        </button>
        <button type="button" class="lx-gift__toggle-btn" data-target="discreet" role="tab" aria-selected="false">
          [ DISCREET ECO-HEIRLOOM ]
        </button>
      </div>
    </div>

    {%- comment -%} Panel 1: Signature Velvet Suite {%- endcomment -%}
    <div class="lx-gift__panel is-active" id="panel-signature" role="tabpanel">
      <div class="lx-gift__img-container">
        {%- if section.settings.signature_image != blank -%}
          <img src="{{ section.settings.signature_image | image_url }}" alt="Signature Velvet Gift Suite" class="lx-gift__img" loading="lazy">
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?q=80&w=1000&auto=format&fit=crop" alt="Signature Velvet Box" class="lx-gift__img" loading="lazy">
        {%- endif -%}
        <span class="lx-gift__badge">[ COMPLIMENTARY WITH EVERY ORDER ]</span>
      </div>

      <div class="lx-gift__details">
        <h3 class="lx-gift__panel-title">The Obsidian Velvet & Brass Coffer</h3>
        <p class="lx-gift__panel-desc">
          Crafted from plush obsidian cotton velvet and secured with a custom-tooled solid brass clasp, our presentation coffer protects your jewelry from atmospheric oxidation while delivering an unforgettable sensory unboxing.
        </p>

        <ul class="lx-gift__features">
          <li class="lx-gift__feature-item">
            <span class="lx-gift__feature-icon">[ 01 ]</span>
            <div>
              <h4 class="lx-gift__feature-title">Wax-Sealed Provenance Folio</h4>
              <p class="lx-gift__feature-text">Contains your official BIS HUID assay certificate, GIA diamond grading report, and insurance appraisal documents bound in handmade cotton paper.</p>
            </div>
          </li>
          <li class="lx-gift__feature-item">
            <span class="lx-gift__feature-icon">[ 02 ]</span>
            <div>
              <h4 class="lx-gift__feature-title">Travel Suede Pouchette</h4>
              <p class="lx-gift__feature-text">A complimentary anti-tarnish suede travel pouch with divided interior compartments is included inside every coffer for secure voyage storage.</p>
            </div>
          </li>
          <li class="lx-gift__feature-item">
            <span class="lx-gift__feature-icon">[ 03 ]</span>
            <div>
              <h4 class="lx-gift__feature-title">Artisan Scented Tissue</h4>
              <p class="lx-gift__feature-text">Subtly infused with our bespoke Mysore Sandalwood and Amber essence, creating an immersive olfactory experience upon opening.</p>
            </div>
          </li>
        </ul>

        <div class="lx-gift__note-box">
          <span class="lx-gift__note-text">Complimentary handwritten calligraphy gift note available at checkout.</span>
          <span class="lx-gift__note-tag">[ INCLUDED ]</span>
        </div>
      </div>
    </div>

    {%- comment -%} Panel 2: Discreet Eco-Heirloom {%- endcomment -%}
    <div class="lx-gift__panel" id="panel-discreet" role="tabpanel">
      <div class="lx-gift__img-container">
        {%- if section.settings.discreet_image != blank -%}
          <img src="{{ section.settings.discreet_image | image_url }}" alt="Discreet Packaging" class="lx-gift__img" loading="lazy">
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1607344645866-009c320c5ab8?q=80&w=1000&auto=format&fit=crop" alt="Discreet Eco Packaging" class="lx-gift__img" loading="lazy">
        {%- endif -%}
        <span class="lx-gift__badge">[ 100% DISCREET SHIPPING ]</span>
      </div>

      <div class="lx-gift__details">
        <h3 class="lx-gift__panel-title">Absolute Privacy & Zero Waste</h3>
        <p class="lx-gift__panel-desc">
          Designed specifically for surprise gifting and security-conscious buyers. Your jewel arrives in an unmarked, tamper-evident outer shipper that reveals no indication of fine jewelry contents on the courier label.
        </p>

        <ul class="lx-gift__features">
          <li class="lx-gift__feature-item">
            <span class="lx-gift__feature-icon">[ 01 ]</span>
            <div>
              <h4 class="lx-gift__feature-title">Unmarked Security Outer Box</h4>
              <p class="lx-gift__feature-text">Shipped under our non-descript corporate holding name ('S.F. Logistics') to ensure absolute secrecy from housemates and couriers.</p>
            </div>
          </li>
          <li class="lx-gift__feature-item">
            <span class="lx-gift__feature-icon">[ 02 ]</span>
            <div>
              <h4 class="lx-gift__feature-title">100% Biodegradable Interiors</h4>
              <p class="lx-gift__feature-text">Utilizes organic hemp fiber padding and FSC-certified recycled paperboard without compromising the luxurious velvet interior coffer.</p>
            </div>
          </li>
          <li class="lx-gift__feature-item">
            <span class="lx-gift__feature-icon">[ 03 ]</span>
            <div>
              <h4 class="lx-gift__feature-title">Digital Provenance Transfer</h4>
              <p class="lx-gift__feature-text">For zero-paper gifting, certificates and appraisal reports can be delivered securely via encrypted digital vault transfer upon unboxing.</p>
            </div>
          </li>
        </ul>

        <div class="lx-gift__note-box">
          <span class="lx-gift__note-text">Select 'Discreet Packaging' during step 2 of our secure checkout.</span>
          <span class="lx-gift__note-tag">[ SECURITY VERIFIED ]</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    const container = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!container) return;

    const toggleBtns = container.querySelectorAll('.lx-gift__toggle-btn');
    const panels = container.querySelectorAll('.lx-gift__panel');

    toggleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        toggleBtns.forEach(b => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === 'panel-' + targetId) {
            p.classList.add('is-active');
          } else {
            p.classList.remove('is-active');
          }
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Gift Packaging & Unboxing",
  "tag": "section",
  "class": "section-gift-packaging",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "[ THE UNBOXING RITUAL ]"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Signature Heirloom Presentation"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A jewel of extraordinary provenance deserves a presentation of equal distinction. Every order is encased in our signature velvet suite, designed to preserve your heirloom for generations."
    },
    {
      "type": "header",
      "content": "Panel Images"
    },
    {
      "type": "image_picker",
      "id": "signature_image",
      "label": "Signature Velvet Suite Image"
    },
    {
      "type": "image_picker",
      "id": "discreet_image",
      "label": "Discreet Eco Packaging Image"
    }
  ],
  "presets": [
    {
      "name": "Gift Packaging (Lux)"
    }
  ]
}
{% endschema %}
