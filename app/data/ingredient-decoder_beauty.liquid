{%- comment -%}
  =============================================================================
  STOREFORGE BEAUTY NICHE KILLER: SCIENCE-BACKED INGREDIENT DECODER
  =============================================================================
  Psychological Conversion Framework:
  1. Transparency & Authority: Modern beauty shoppers inspect ingredient lists for actives (Niacinamide, Hyaluronic Acid, Retinol). Decoding technical INCI names into clear biological benefits establishes supreme product authority.
  2. Safety Assurance: Explicitly listing what is NOT in the formula (No Parabens, No Sulfates, No Fragrance) eliminates health-conscious purchase friction.
  
  Design Aesthetics & Rules:
  - 0% Emoji Policy: Clean ASCII brackets, clinical typography, and accordion expandable drawers.
  - Scoped CSS: Clinical beauty aesthetic.
  =============================================================================
{%- endcomment -%}

<div class="sf-bt-ing" data-beauty-ing>
  <style>
    .sf-bt-ing {
      margin: 1.5rem 0;
      border: 1px solid #e2ded6;
      background-color: #ffffff;
      font-family: var(--font-body-family, sans-serif);
      color: #2b2b2b;
    }

    .sf-bt-ing__header {
      padding: 1rem 1.25rem;
      background-color: #faf9f6;
      border-bottom: 1px solid #e2ded6;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .sf-bt-ing__title {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #1a1a1a;
    }

    .sf-bt-ing__badge {
      font-size: 0.65rem;
      font-weight: 600;
      color: #2e6b4d;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .sf-bt-ing__item {
      border-bottom: 1px solid #f0ebe1;
    }

    .sf-bt-ing__item:last-child {
      border-bottom: none;
    }

    .sf-bt-ing__trigger {
      width: 100%;
      padding: 1rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: transparent;
      border: none;
      cursor: pointer;
      text-align: left;
      font-family: inherit;
      transition: background 0.15s ease;
    }

    .sf-bt-ing__trigger:hover {
      background-color: #faf9f6;
    }

    .sf-bt-ing__name-box {
      display: flex;
      flex-direction: column;
    }

    .sf-bt-ing__common {
      font-size: 0.82rem;
      font-weight: 700;
      color: #1a1a1a;
      letter-spacing: 0.03em;
    }

    .sf-bt-ing__inci {
      font-size: 0.7rem;
      color: #777777;
      font-style: italic;
    }

    .sf-bt-ing__conc {
      font-size: 0.75rem;
      font-weight: 700;
      color: #2e6b4d;
      background-color: #e8f3ec;
      padding: 0.2rem 0.6rem;
    }

    .sf-bt-ing__content {
      display: none;
      padding: 0 1.25rem 1.25rem 1.25rem;
      font-size: 0.75rem;
      line-height: 1.5;
      color: #555555;
      background-color: #faf9f6;
    }

    .sf-bt-ing__item.is-open .sf-bt-ing__content {
      display: block;
    }

    .sf-bt-ing__study {
      margin-top: 0.5rem;
      padding-top: 0.5rem;
      border-top: 1px dashed #dcd8d0;
      font-size: 0.68rem;
      color: #2e6b4d;
      font-weight: 600;
    }

    .sf-bt-ing__footer {
      padding: 0.75rem 1.25rem;
      background-color: #1a1a1a;
      color: #ffffff;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-align: center;
    }
  </style>

  <div class="sf-bt-ing__header">
    <span class="sf-bt-ing__title">[ CLINICAL ACTIVE INGREDIENTS ]</span>
    <span class="sf-bt-ing__badge">100% TRANSPARENT INCI</span>
  </div>

  <div class="sf-bt-ing__item" data-ing-item>
    <button type="button" class="sf-bt-ing__trigger" data-ing-toggle>
      <div class="sf-bt-ing__name-box">
        <span class="sf-bt-ing__common">1. Niacinamide (Vitamin B3)</span>
        <span class="sf-bt-ing__inci">INCI: Nicotinamide</span>
      </div>
      <span class="sf-bt-ing__conc">10.0% CONCENTRATION</span>
    </button>
    <div class="sf-bt-ing__content">
      Biologically active amide of Vitamin B3 that regulates sebum secretion, shrinks appearance of enlarged pores, and strengthens lipid barrier integrity.
      <div class="sf-bt-ing__study">[ CLINICAL STUDY ] 88% reduction in sebum oxidation after 28 days of twice-daily application.</div>
    </div>
  </div>

  <div class="sf-bt-ing__item" data-ing-item>
    <button type="button" class="sf-bt-ing__trigger" data-ing-toggle>
      <div class="sf-bt-ing__name-box">
        <span class="sf-bt-ing__common">2. Multi-Molecular Hyaluronic Acid</span>
        <span class="sf-bt-ing__inci">INCI: Sodium Hyaluronate Crosspolymer</span>
      </div>
      <span class="sf-bt-ing__conc">2.0% CONCENTRATION</span>
    </button>
    <div class="sf-bt-ing__content">
      Combines high, medium, and low molecular weight hyaluronic acid to hydrate both surface strata and deep dermal layers simultaneously without stickiness.
      <div class="sf-bt-ing__study">[ CLINICAL STUDY ] +142% immediate epidermal hydration retention within 30 minutes.</div>
    </div>
  </div>

  <div class="sf-bt-ing__item" data-ing-item>
    <button type="button" class="sf-bt-ing__trigger" data-ing-toggle>
      <div class="sf-bt-ing__name-box">
        <span class="sf-bt-ing__common">3. Bio-Retinol (Bakuchiol)</span>
        <span class="sf-bt-ing__inci">INCI: Psoralea Corylifolia Seed Extract</span>
      </div>
      <span class="sf-bt-ing__conc">1.5% CONCENTRATION</span>
    </button>
    <div class="sf-bt-ing__content">
      A 100% plant-derived retinol alternative that accelerates cellular turnover and collagen synthesis without causing erythema, peeling, or sun sensitivity.
      <div class="sf-bt-ing__study">[ CLINICAL STUDY ] Equal wrinkle reduction to 0.5% retinol with zero irritation reported.</div>
    </div>
  </div>

  <div class="sf-bt-ing__footer">
    // FORMULATED WITHOUT: PARABENS &middot; SULFATES &middot; PHTHALATES &middot; ARTIFICIAL FRAGRANCE //
  </div>

  <script>
    (function() {
      const container = document.querySelector('[data-beauty-ing]');
      if (!container) return;

      const items = container.querySelectorAll('[data-ing-item]');
      items.forEach(function(item) {
        const btn = item.querySelector('[data-ing-toggle]');
        if (btn) {
          btn.addEventListener('click', function() {
            const isOpen = item.classList.contains('is-open');
            items.forEach(i => i.classList.remove('is-open'));
            if (!isOpen) item.classList.add('is-open');
          });
        }
      });
    })();
  </script>
</div>
