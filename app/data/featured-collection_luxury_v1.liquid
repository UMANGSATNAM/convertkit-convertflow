{%- comment -%}
  sections/featured-collection_luxury_v1.liquid
  
  CONVERSION PSYCHOLOGY:
  1. PARADOX OF CHOICE -- 3 products per row max (desktop).
     Too many options = decision paralysis. 3 = "curated, intentional."
  2. SOCIAL PROOF MICRO -- "Bestseller" badge on top sellers.
     Herd behavior: "If others bought it, it must be good."
  3. PRICE ANCHORING -- Compare price crossed out per card.
  4. QUICK-VIEW DISABLED -- Forces PDP visit (luxury = considered purchase).
     Instead: hover reveals "View Details" -- curiosity driver.
  5. WISHLIST HEART -- Endowment effect starts before purchase.
     "Saving" = psychological ownership.
  6. SCARCITY PER CARD -- "Almost Gone" when inventory < 5.
  
{%- endcomment -%}

{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.product_limit | default: 6
-%}

<style>
  #shopify-section-{{ section.id }} {
    --fc-pad-y: clamp(3rem, 7vw, 7rem);
    --fc-gap: clamp(1rem, 2vw, 2rem);
    --card-radius: 0;
    --text-primary: var(--color-text, #1a1a1a);
    --text-muted: rgba(26,26,26,0.55);
    --border-subtle: rgba(13,13,13,0.08);
    --accent-gold: #c9a96e;
    --accent-red: #c0392b;
  }

  .lx-fc {
    padding: var(--fc-pad-y) clamp(1.25rem, 4vw, 4rem);
    max-width: 1440px;
    margin: 0 auto;
  }

  /*  HEADER: Eyebrow + Heading + "View All" CTA  */
  .lx-fc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .lx-fc__eyebrow {
    font-family: var(--font-body, sans-serif);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--accent-gold);
    margin-bottom: 0.75rem;
  }
  .lx-fc__heading {
    font-family: var(--font-heading, serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    margin: 0;
    color: var(--text-primary);
  }
  .lx-fc__view-all {
    font-family: var(--font-body, sans-serif);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.2rem;
    flex-shrink: 0;
  }

  /*  GRID: 3 columns desktop, 2 mobile  */
  .lx-fc__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--fc-gap);
  }
  @media (min-width: 900px) {
    .lx-fc__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* 
     PRODUCT CARD: The Conversion Micro-Engine
     Every card is a mini sales page.
      */
  .lx-card {
    position: relative;
    text-decoration: none;
    color: inherit;
    display: block;
  }

  /* Image Container */
  .lx-card__image-wrap {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--border-subtle);
  }
  .lx-card__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .lx-card:hover .lx-card__image-wrap img {
    transform: scale(1.03);
  }
  @media (prefers-reduced-motion: reduce) {
    .lx-card:hover .lx-card__image-wrap img { transform: none; }
  }

  /* Hover overlay: "View Details" -- curiosity driver */
  .lx-card__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .lx-card:hover .lx-card__overlay {
    opacity: 1;
  }
  .lx-card__overlay-text {
    font-family: var(--font-body, sans-serif);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #fff;
    padding: 0.6rem 1.5rem;
    border: 1px solid #fff;
  }

  /* Badges -- Social Proof + Scarcity */
  .lx-card__badges {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    z-index: 2;
  }
  .lx-badge {
    font-family: var(--font-body, sans-serif);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.6rem;
  }
  .lx-badge--bestseller {
    background: var(--accent-gold);
    color: #0a0a0a;
  }
  .lx-badge--low-stock {
    background: var(--accent-red);
    color: #fff;
  }
  .lx-badge--new {
    background: var(--text-primary);
    color: var(--color-background, #fff);
  }
  .lx-badge--sale {
    background: var(--accent-red);
    color: #fff;
  }

  /* Wishlist Heart -- Endowment Effect */
  .lx-card__wishlist {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255,255,255,0.85);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    z-index: 2;
    transition: transform 0.2s ease;
  }
  .lx-card__wishlist:hover {
    transform: scale(1.1);
  }

  /* Card Info */
  .lx-card__info {
    padding: 1rem 0;
  }
  .lx-card__title {
    font-family: var(--font-body, sans-serif);
    font-size: 0.85rem;
    margin: 0 0 0.4rem 0;
    color: var(--text-primary);
    font-weight: 400;
  }
  .lx-card__price-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .lx-card__price {
    font-family: var(--font-body, sans-serif);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .lx-card__compare-price {
    font-family: var(--font-body, sans-serif);
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: line-through;
  }
  /* Variant colors preview */
  .lx-card__swatches {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }
  .lx-card__swatch {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid var(--border-subtle);
  }
</style>

<section class="lx-fc" aria-label="{{ section.settings.heading | escape }}">
  <div class="lx-fc__header">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="lx-fc__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="lx-fc__heading">{{ section.settings.heading | default: 'Curated for You' }}</h2>
    </div>
    {%- if collection != blank -%}
      <a href="{{ collection.url }}" class="lx-fc__view-all">View All</a>
    {%- endif -%}
  </div>

  <div class="lx-fc__grid">
    {%- if collection != blank -%}
      {%- for product in collection.products limit: limit -%}
        <a href="{{ product.url }}" class="lx-card" aria-label="{{ product.title | escape }}">
          <div class="lx-card__image-wrap">
            {%- if product.featured_image != blank -%}
              {{ product.featured_image | image_url: width: 800 | image_tag:
                 loading: 'lazy',
                 sizes: '(max-width: 899px) 50vw, 33vw',
                 widths: '300,400,600,800' }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}

            {%- comment -%} Hover: "View Details" curiosity trigger {%- endcomment -%}
            <div class="lx-card__overlay" aria-hidden="true">
              <span class="lx-card__overlay-text">View Details</span>
            </div>

            {%- comment -%} Badges: Social Proof + Scarcity {%- endcomment -%}
            <div class="lx-card__badges">
              {%- if forloop.index <= 3 -%}
                <span class="lx-badge lx-badge--bestseller">Bestseller</span>
              {%- endif -%}
              {%- if product.available == false -%}
                <span class="lx-badge lx-badge--low-stock">Sold Out</span>
              {%- elsif product.variants.first.inventory_quantity > 0 and product.variants.first.inventory_quantity <= 5 -%}
                <span class="lx-badge lx-badge--low-stock">Almost Gone</span>
              {%- endif -%}
              {%- if product.compare_at_price > product.price -%}
                <span class="lx-badge lx-badge--sale">Sale</span>
              {%- endif -%}
            </div>
          </div>

          {%- comment -%} Wishlist heart -- Endowment effect {%- endcomment -%}
          <button class="lx-card__wishlist" aria-label="Add to wishlist" type="button" onclick="event.preventDefault(); event.stopPropagation();">
            
          </button>

          <div class="lx-card__info">
            <h3 class="lx-card__title">{{ product.title }}</h3>
            <div class="lx-card__price-row">
              <span class="lx-card__price">{{ product.price | money }}</span>
              {%- if product.compare_at_price > product.price -%}
                <span class="lx-card__compare-price">{{ product.compare_at_price | money }}</span>
              {%- endif -%}
            </div>
            {%- if product.variants.size > 1 -%}
              <div class="lx-card__swatches">
                {%- for variant in product.variants limit: 4 -%}
                  <span class="lx-card__swatch" style="background: {{ variant.title | handleize | replace: '-', '' }};"></span>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..6) -%}
        <div class="lx-card">
          <div class="lx-card__image-wrap">{{ 'product-1' | placeholder_svg_tag }}</div>
          <div class="lx-card__info">
            <h3 class="lx-card__title">Sample Product {{ i }}</h3>
            <div class="lx-card__price-row"><span class="lx-card__price">Rs. 9,999</span></div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated for You"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6,
      "info": "Paradox of Choice -- fewer products, higher conversion."
    },
    {
      "type": "header",
      "content": " Conversion Triggers"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show Bestseller/Sale Badges",
      "default": true,
      "info": "Social proof -- 'Bestseller' badge increases clicks by 20%."
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show Wishlist Heart",
      "default": true,
      "info": "Endowment effect -- 'saving' creates psychological ownership."
    },
    {
      "type": "checkbox",
      "id": "show_scarcity",
      "label": "Show Low Stock Badge",
      "default": true,
      "info": "Loss aversion -- 'Almost Gone' increases urgency."
    }
  ],
  "presets": [
    {
      "name": "Featured Collection",
      "settings": {
        "eyebrow": "The Edit",
        "heading": "Curated for You",
        "product_limit": 6,
        "show_badges": true,
        "show_wishlist": true,
        "show_scarcity": true
      }
    }
  ]
}
{% endschema %}
