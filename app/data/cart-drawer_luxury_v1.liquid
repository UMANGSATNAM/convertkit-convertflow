<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var closeBtns = section.querySelectorAll('[data-drawer-close]');
    var cartCount = section.querySelector('[data-cart-count]');
    var cartTotal = section.querySelector('[data-cart-total]');
    var itemsWrap = section.querySelector('[data-cart-items]');
    var checkoutBtn = section.querySelector('[data-checkout]');

    var rewStatus = section.querySelector('[data-rew-status]');
    var rewBar = section.querySelector('[data-rew-bar]');
    var tier1 = section.querySelector('[data-tier-1]');
    var tier2 = section.querySelector('[data-tier-2]');
    var tier3 = section.querySelector('[data-tier-3]');

    var tabs = section.querySelectorAll('.cd__tab');
    var contents = section.querySelectorAll('.cd__tab-content');
    var upsellBtns = section.querySelectorAll('[data-upsell-add]');

    var itemsData = [
      { id: '101', name: 'The Sovereign Chronograph', price: 48500, qty: 1, var: 'CASE: 42MM OBSIDIAN &bull; STRAP: ALLIGATOR', img: 'https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&w=300&q=80' },
      { id: '102', name: 'Italian Leather Portfolio', price: 14500, qty: 1, var: 'FINISH: COGNAC BROWN &bull; HAND-STITCHED', img: 'https://images.unsplash.com/photo-1548036328-c9fa89d128fa?auto=format&fit=crop&w=300&q=80' }
    ];

    function renderCart() {
      var subtotal = 0;
      var totalQty = 0;
      var html = '';

      itemsData.forEach(function(item, idx) {
        var itemTotal = item.price * item.qty;
        subtotal += itemTotal;
        totalQty += item.qty;

        html += '<div class="cd__item" data-index="' + idx + '">' +
          '<img class="cd__item-img" src="' + item.img + '" alt="' + item.name + '">' +
          '<div class="cd__item-info">' +
            '<div>' +
              '<div class="cd__item-top">' +
                '<h3 class="cd__item-name">' + item.name + '</h3>' +
                '<span class="cd__item-price">RS. ' + itemTotal.toLocaleString('en-IN') + '</span>' +
              '</div>' +
              '<span class="cd__item-var">' + item.var + '</span>' +
            '</div>' +
            '<div class="cd__item-bot">' +
              '<div class="cd__qty-box">' +
                '<button type="button" class="cd__qty-btn" data-action="dec" data-idx="' + idx + '">-</button>' +
                '<span class="cd__qty-val">' + item.qty + '</span>' +
                '<button type="button" class="cd__qty-btn" data-action="inc" data-idx="' + idx + '">+</button>' +
              '</div>' +
              '<button type="button" class="cd__remove" data-action="rem" data-idx="' + idx + '">[ REMOVE ]</button>' +
            '</div>' +
          '</div>' +
        '</div>';
      });

      if (itemsWrap) itemsWrap.innerHTML = html || '<div style="padding:2rem 0; text-align:center; color:var(--cd-muted);">// YOUR SELECTION IS CURRENTLY EMPTY //</div>';
      if (cartCount) cartCount.textContent = '[ ' + totalQty + ' ITEMS ]';
      if (cartTotal) cartTotal.textContent = 'RS. ' + subtotal.toLocaleString('en-IN');

      // Update Rewards Bar
      if (tier1) tier1.classList.toggle('is-unlocked', subtotal >= 25000);
      if (tier2) tier2.classList.toggle('is-unlocked', subtotal >= 67500);
      if (tier3) tier3.classList.toggle('is-unlocked', subtotal >= 95000);

      if (rewBar) {
        var pct = Math.min(100, Math.round((subtotal / 95000) * 100));
        rewBar.style.width = pct + '%';
      }

      if (rewStatus) {
        if (subtotal < 25000) {
          var diff1 = 25000 - subtotal;
          rewStatus.innerHTML = '<span>[ TIER 0 ACTIVE ]</span><strong>// ADD RS. ' + diff1.toLocaleString('en-IN') + ' FOR INSURED SHIPPING //</strong>';
        } else if (subtotal < 67500) {
          var diff2 = 67500 - subtotal;
          rewStatus.innerHTML = '<span>[ TIER 1 UNLOCKED ]</span><strong>// ADD RS. ' + diff2.toLocaleString('en-IN') + ' FOR VELVET POUCH //</strong>';
        } else if (subtotal < 95000) {
          var diff3 = 95000 - subtotal;
          rewStatus.innerHTML = '<span>[ TIER 2 UNLOCKED ]</span><strong>// ADD RS. ' + diff3.toLocaleString('en-IN') + ' FOR VIP ENGRAVING //</strong>';
        } else {
          rewStatus.innerHTML = '<span>[ MAX TIER 3 UNLOCKED ]</span><strong>// COMPLIMENTARY SHIPPING, POUCH &amp; ENGRAVING INCLUDED //</strong>';
        }
      }

      bindItemEvents();
    }

    function bindItemEvents() {
      if (!itemsWrap) return;
      var btns = itemsWrap.querySelectorAll('[data-action]');
      btns.forEach(function(b) {
        b.addEventListener('click', function() {
          var action = this.getAttribute('data-action');
          var idx = parseInt(this.getAttribute('data-idx') || '0', 10);
          var item = itemsData[idx];
          if (!item) return;

          if (action === 'inc') {
            item.qty++;
          } else if (action === 'dec') {
            item.qty--;
            if (item.qty <= 0) itemsData.splice(idx, 1);
          } else if (action === 'rem') {
            itemsData.splice(idx, 1);
          }
          renderCart();
        });
      });
    }

    closeBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        section.classList.remove('is-open');
      });
    });

    upsellBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var itemBox = this.closest('.cd__upsell-item');
        if (!itemBox) return;
        var name = itemBox.getAttribute('data-name');
        var price = parseInt(itemBox.getAttribute('data-price') || '0', 10);

        itemsData.push({
          id: 'u-' + Math.random().toString(36).substr(2, 5),
          name: name,
          price: price,
          qty: 1,
          var: 'HAUTE COUTURE PRESENTATION UPSELL',
          img: itemBox.querySelector('img') ? itemBox.querySelector('img').src : 'https://images.unsplash.com/photo-1549465220-1a8b9238cd48?auto=format&fit=crop&w=300&q=80'
        });

        this.textContent = '[ ADDED V ]';
        this.style.background = '#2d7a3a';
        this.disabled = true;
        renderCart();
      });
    });

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('is-active'); });
        this.classList.add('is-active');
        var target = this.getAttribute('data-target') || 'shipping';

        contents.forEach(function(c) {
          var cTarget = c.getAttribute('data-content') || 'shipping';
          if (cTarget === target) {
            c.classList.add('is-active');
          } else {
            c.classList.remove('is-active');
          }
        });
      });
    });

    if (checkoutBtn) {
      checkoutBtn.addEventListener('click', function() {
        checkoutBtn.textContent = '[ SECURING VIP TRANSACTION... ]';
        setTimeout(function() {
          checkoutBtn.textContent = '[ REDIRECTING TO ARMORED CHECKOUT &rarr; ]';
          alert('[ SYSTEM NOTE ] Proceeding to 256-bit encrypted checkout with all concierge perks unlocked.');
        }, 600);
      });
    }

    renderCart();
  });
</script>

