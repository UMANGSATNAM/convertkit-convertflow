{%- comment -%}
  sections/fb04-marquee_streetwear.liquid

  CONVERSION PSYCHOLOGY (Frameblox Landing 04 Replica):
  1. INFINITE SCROLL CAROUSEL -- Continuous horizontal movement triggers active search mode.
  2. PAUSE-ON-HOVER -- Giving users control over motion satisfies autonomy need.
  3. EDGE FADE GRADIENTS -- White to transparent masks on left/right edges create depth illusion.
  4. SQUARE ASPECT RATIO (1:1) -- Maximizes visual impact in constrained horizontal space.
  5. 3x ITEM DUPLICATION -- Items repeat 3 times for mathematically seamless infinite scroll.
{%- endcomment -%}

{%- liquid
  assign section_id = 'fb04-marq-' | append: section.id
  assign speed = section.settings.speed | default: 40
-%}

<style>
  #shopify-section-{{ section.id }} {
    --fq-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --fq-text-dark: {{ section.settings.text_dark | default: '#282A2F' }};
    --fq-text-body: {{ section.settings.text_body | default: '#7B818E' }};
    --fq-card-bg: {{ section.settings.card_bg | default: '#F3F4F5' }};
  }

  .fb04-marquee {
    background: var(--fq-bg);
    overflow: hidden;
    padding: clamp(3rem, 7vw, 5.6rem) 0;
  }

  .fb04-marquee__header {
    max-width: 1200px;
    margin: 0 auto 40px;
    padding: 0 clamp(1rem, 4vw, 3.75rem);
  }

  .fb04-marquee__title {
    font-family: 'Big Shoulders Display', var(--font-heading, sans-serif);
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 2.75rem);
    text-transform: uppercase;
    color: var(--fq-text-dark);
    margin-bottom: 8px;
  }

  .fb04-marquee__desc {
    font-family: var(--font-body, sans-serif);
    font-weight: 400;
    font-size: 16px;
    color: var(--fq-text-body);
    max-width: 580px;
    line-height: 1.6;
  }

  .fb04-marquee__viewport {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .fb04-marquee__viewport::before,
  .fb04-marquee__viewport::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 80px;
    z-index: 2;
    pointer-events: none;
  }
  .fb04-marquee__viewport::before {
    left: 0;
    background: linear-gradient(to right, var(--fq-bg), transparent);
  }
  .fb04-marquee__viewport::after {
    right: 0;
    background: linear-gradient(to left, var(--fq-bg), transparent);
  }

  .fb04-marquee__track {
    display: flex;
    gap: 24px;
    width: max-content;
    animation: fb04MarqueeScroll {{ speed }}s linear infinite;
  }

  .fb04-marquee__track:hover {
    animation-play-state: paused;
  }

  @keyframes fb04MarqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.333333%); }
  }

  .fb04-marquee__item {
    flex-shrink: 0;
    width: 280px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    text-decoration: none;
    color: inherit;
  }
  .fb04-marquee__item:hover {
    transform: translateY(-4px);
  }

  .fb04-marquee__img-wrap {
    width: 280px;
    height: 280px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--fq-card-bg);
    margin-bottom: 16px;
  }

  .fb04-marquee__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .fb04-marquee__item:hover .fb04-marquee__img-wrap img {
    transform: scale(1.08);
  }

  .fb04-marquee__item-title {
    font-family: var(--font-body, sans-serif);
    font-weight: 700;
    font-size: 17px;
    color: var(--fq-text-dark);
    margin-bottom: 6px;
  }

  .fb04-marquee__item-desc {
    font-family: var(--font-body, sans-serif);
    font-weight: 400;
    font-size: 13px;
    color: var(--fq-text-body);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<section class="fb04-marquee" id="{{ section_id }}">
  {%- if section.settings.heading != blank -%}
    <div class="fb04-marquee__header">
      <h2 class="fb04-marquee__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="fb04-marquee__desc">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="fb04-marquee__viewport">
    <div class="fb04-marquee__track">
      {%- for cycle in (1..3) -%}
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" class="fb04-marquee__item" {{ block.shopify_attributes }}>
            <div class="fb04-marquee__img-wrap">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="600"
                  height="600">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <p class="fb04-marquee__item-title">{{ block.settings.title }}</p>
            <p class="fb04-marquee__item-desc">{{ block.settings.description }}</p>
          </a>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FB04 Marquee (Streetwear)",
  "tag": "section",
  "class": "section-fb04-marquee",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Drops: Stand Out, Stay Ahead"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Exclusive designs, premium materials, and street-ready vibes—these must-have pieces are setting the trend."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll Speed (seconds)",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 40,
      "unit": "s"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_dark",
      "label": "Heading Color",
      "default": "#282A2F"
    },
    {
      "type": "color",
      "id": "text_body",
      "label": "Body Color",
      "default": "#7B818E"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#F3F4F5"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Marquee Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Sleek iPhone Case"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Durable and slim, offering stylish protection against drops and scratches."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FB04 Marquee (Streetwear)",
      "blocks": [
        { "type": "item", "settings": { "title": "Sleek iPhone Case", "description": "Durable and slim, the SleekGuard iPhone Case offers stylish protection." } },
        { "type": "item", "settings": { "title": "Spring Jacket", "description": "Lightweight and versatile, combines comfort and modern street utility." } },
        { "type": "item", "settings": { "title": "Summer Cap", "description": "Stay cool with breathable cotton and custom embroidery." } },
        { "type": "item", "settings": { "title": "White Summer Tee", "description": "Lightweight and breathable, keeps you cool and fresh all day long." } },
        { "type": "item", "settings": { "title": "Black Summer Tee", "description": "Stay stylish in the CoolCore Black Summer Tee, crafted from 280GSM organic cotton." } }
      ]
    }
  ]
}
{% endschema %}
