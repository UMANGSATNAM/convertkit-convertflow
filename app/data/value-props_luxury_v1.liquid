{%- comment -%}
  sections/value-props_luxury_v1.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (380+ lines):
  1. RISK REVERSAL & FOGG BEHAVIOR MODEL: High-ticket purchases experience severe anxiety at the point of decision. Offering transparent guarantees (Complimentary Shipping, 30-Day No-Questions Returns, Quality Assurance Certification) eliminates cognitive friction.
  2. INTERACTIVE POLICY DRAWER: Instead of static text, clicking any trust pillar opens an embedded interactive drawer/modal with comprehensive policy details, insurance terms, and concierge contact options.
  3. INDIA-FIRST TRUST STRIP: Addresses India D2C specifics (100% Insured Transit via Bluedart/DHL, Doorstep Verification, WhatsApp Concierge Support) directly within the visual hierarchy.
  4. SPATIAL ISOLATION & EDITORIAL RHYTHM: Uses ample whitespace and architectural dividing lines to force the brain to process each trust marker individually without visual clutter.
  5. ZERO EMOJI GUARANTEE: Uses ASCII brackets [ CERTIFIED PURITY ], [ EXPLORE GUARANTEE ] and SVG iconography.
{%- endcomment -%}

{%- assign section_id = 'lx-vp-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --lx-bg: {{ section.settings.bg_color | default: '#fdfbf9' }};
    --lx-text: {{ section.settings.text_color | default: '#1a1a1a' }};
    --lx-gold: {{ section.settings.gold_accent | default: '#c9a96e' }};
    --lx-muted: rgba(26, 26, 26, 0.6);
    --lx-border: rgba(26, 26, 26, 0.1);
    --lx-card-bg: #ffffff;
    
    background-color: var(--lx-bg);
    color: var(--lx-text);
    padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 5vw, 4rem);
    border-top: 1px solid var(--lx-border);
    border-bottom: 1px solid var(--lx-border);
    position: relative;
    overflow: hidden;
  }

  #{{ section_id }} .lx-vp__header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem auto;
  }

  #{{ section_id }} .lx-vp__badge {
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--lx-gold);
    margin-bottom: 0.6rem;
    display: inline-block;
    padding: 0.35rem 1.2rem;
    border: 1px solid rgba(201, 169, 110, 0.3);
    background: rgba(201, 169, 110, 0.04);
  }

  #{{ section_id }} .lx-vp__title {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    margin: 0 0 1rem 0;
    line-height: 1.15;
  }

  #{{ section_id }} .lx-vp__sub {
    font-family: var(--font-body, sans-serif);
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    color: var(--lx-muted);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
    font-weight: 300;
  }

  /* Grid Architecture */
  #{{ section_id }} .lx-vp__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;
    max-width: 1350px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    #{{ section_id }} .lx-vp__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    #{{ section_id }} .lx-vp__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  #{{ section_id }} .lx-vp__card {
    background: var(--lx-card-bg);
    border: 1px solid rgba(0, 0, 0, 0.06);
    padding: 2.5rem 1.8rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    cursor: pointer;
  }

  #{{ section_id }} .lx-vp__card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
    border-color: var(--lx-gold);
  }

  #{{ section_id }} .lx-vp__card-num {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: 0.85rem;
    color: var(--lx-gold);
    letter-spacing: 0.15em;
    margin-bottom: 1.2rem;
  }

  #{{ section_id }} .lx-vp__card-title {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: 1.35rem;
    font-weight: 400;
    margin: 0 0 0.8rem 0;
    color: var(--lx-text);
  }

  #{{ section_id }} .lx-vp__card-text {
    font-family: var(--font-body, sans-serif);
    font-size: 0.85rem;
    color: var(--lx-muted);
    line-height: 1.6;
    margin: 0 0 1.8rem 0;
    flex: 1;
  }

  #{{ section_id }} .lx-vp__card-action {
    font-family: var(--font-body, sans-serif);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--lx-text);
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  #{{ section_id }} .lx-vp__card:hover .lx-vp__card-action {
    color: var(--lx-gold);
  }

  /* India Trust Strip Footer Bar */
  #{{ section_id }} .lx-vp__strip {
    max-width: 1100px;
    margin: 3.5rem auto 0 auto;
    padding: 1.5rem 2rem;
    background: #1a1a1a;
    color: #ffffff;
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    text-align: center;
  }

  @media (max-width: 640px) {
    #{{ section_id }} .lx-vp__strip {
      flex-direction: column;
      gap: 1rem;
    }
  }

  #{{ section_id }} .lx-vp__strip-item {
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #ffffff;
  }

  #{{ section_id }} .lx-vp__strip-item span {
    color: var(--lx-gold);
    margin-right: 0.5rem;
  }

  /* Embedded Policy Drawer / Modal */
  #{{ section_id }} .lx-vp__modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.85);
    z-index: 100;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    backdrop-filter: blur(8px);
  }

  #{{ section_id }} .lx-vp__modal.is-active {
    display: flex;
  }

  #{{ section_id }} .lx-vp__modal-box {
    background: #ffffff;
    color: #1a1a1a;
    border: 1px solid var(--lx-gold);
    max-width: 520px;
    width: 100%;
    padding: 3rem 2.5rem;
    text-align: center;
    position: relative;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
  }

  #{{ section_id }} .lx-vp__modal-close {
    position: absolute;
    top: 1rem;
    right: 1.2rem;
    background: transparent;
    border: none;
    color: rgba(0, 0, 0, 0.4);
    font-size: 1.2rem;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  #{{ section_id }} .lx-vp__modal-close:hover {
    color: var(--lx-gold);
  }

  #{{ section_id }} .lx-vp__modal-title {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: 1.8rem;
    margin: 0 0 1rem 0;
  }

  #{{ section_id }} .lx-vp__modal-body {
    font-family: var(--font-body, sans-serif);
    font-size: 0.9rem;
    color: var(--lx-muted);
    line-height: 1.7;
    margin: 0 0 2.2rem 0;
    text-align: left;
  }

  #{{ section_id }} .lx-vp__modal-btn {
    padding: 1rem 2rem;
    background: #1a1a1a;
    color: #ffffff;
    border: none;
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    cursor: pointer;
    transition: background 0.25s ease;
  }

  #{{ section_id }} .lx-vp__modal-btn:hover {
    background: var(--lx-gold);
    color: #000000;
  }
</style>

<section id="{{ section_id }}">
  <div class="lx-vp__header">
    <span class="lx-vp__badge">[ {{ section.settings.eyebrow | default: "UNCOMPROMISING STANDARDS" }} ]</span>
    <h2 class="lx-vp__title">{{ section.settings.heading | default: "The Excellence Guarantee" }}</h2>
    <p class="lx-vp__sub">{{ section.settings.subheading | default: "Every acquisition is protected by our comprehensive assurance charter, designed to offer absolute peace of mind to discerning clients worldwide." }}</p>
  </div>

  <div class="lx-vp__grid">
    {%- for block in section.blocks -%}
      <div 
        class="lx-vp__card" 
        data-vp-card 
        data-title="{{ block.settings.title | escape }}" 
        data-body="{{ block.settings.detail_text | default: 'We adhere to the highest international standards of quality, purity, and logistical security for every creation.' | escape }}"
        {{ block.shopify_attributes }}
      >
        <div class="lx-vp__card-num">[ 0{{ forloop.index }} ]</div>
        <h3 class="lx-vp__card-title">{{ block.settings.title }}</h3>
        <p class="lx-vp__card-text">{{ block.settings.subtitle }}</p>
        <span class="lx-vp__card-action">[ EXPLORE GUARANTEE ]</span>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.show_strip -%}
    <div class="lx-vp__strip">
      <div class="lx-vp__strip-item"><span>&bull;</span> {{ section.settings.strip_item_1 | default: "100% INSURED EXPRESS TRANSIT" }}</div>
      <div class="lx-vp__strip-item"><span>&bull;</span> {{ section.settings.strip_item_2 | default: "VERIFIED QUALITY &amp; AUTHENTICITY" }}</div>
      <div class="lx-vp__strip-item"><span>&bull;</span> {{ section.settings.strip_item_3 | default: "INSTANT CONCIERGE ASSISTANCE" }}</div>
    </div>
  {%- endif -%}

  <!-- Interactive Policy Modal -->
  <div class="lx-vp__modal" data-modal-overlay>
    <div class="lx-vp__modal-box">
      <button type="button" class="lx-vp__modal-close" aria-label="Close modal" data-close-modal>[ &times; ]</button>
      <h3 class="lx-vp__modal-title" data-modal-title>Guarantee Charter</h3>
      <div class="lx-vp__modal-body" data-modal-body>
        Detailed policy terms and assurance information will appear here.
      </div>
      <button type="button" class="lx-vp__modal-btn" data-close-modal>[ ACKNOWLEDGE CHARTER ]</button>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.getElementById('{{ section_id }}');
    if (!section) return;

    var modalOverlay = section.querySelector('[data-modal-overlay]');
    var modalTitle = section.querySelector('[data-modal-title]');
    var modalBody = section.querySelector('[data-modal-body]');
    var cards = section.querySelectorAll('[data-vp-card]');
    var closeButtons = section.querySelectorAll('[data-close-modal]');

    if (!modalOverlay || !modalTitle || !modalBody) return;

    function openModal(title, body) {
      modalTitle.textContent = title || 'Guarantee Charter';
      modalBody.textContent = body || 'Detailed policy terms.';
      modalOverlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modalOverlay.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    cards.forEach(function(card) {
      card.addEventListener('click', function() {
        var title = this.getAttribute('data-title');
        var body = this.getAttribute('data-body');
        openModal(title, body);
      });
    });

    closeButtons.forEach(function(btn) {
      btn.addEventListener('click', closeModal);
    });

    modalOverlay.addEventListener('click', function(e) {
      if (e.target === modalOverlay) {
        closeModal();
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modalOverlay.classList.contains('is-open')) {
        closeModal();
      }
    });
  });
</script>

