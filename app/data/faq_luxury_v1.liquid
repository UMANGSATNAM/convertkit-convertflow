{%- comment -%}
  sections/faq_luxury_v1.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (400+ lines):
  1. PRE-EMPTIVE OBJECTION ANNIHILATION: FAQs dismantle buyer skepticism immediately prior to checkout. Unanswered logistical anxieties account for up to 12% of cart abandonments (Baymard Institute).
  2. PROGRESSIVE DISCLOSURE & CATEGORY FILTERING: Structuring answers into intuitive category tabs ([ ALL ], [ LOGISTICS ], [ PROVENANCE ], [ RETURNS ]) prevents cognitive overload and speeds up answer discovery.
  3. REAL-TIME QUESTION MATCHING: An embedded live search bar allows instant filtering of questions, creating frictionless cognitive ease.
  4. VIP CONCIERGE ESCALATION MODAL: When a question falls outside standard FAQs, an interactive trigger ([ SPEAK WITH CONCIERGE ]) opens a bespoke private consultation drawer.
  5. ZERO EMOJI GUARANTEE: Uses ASCII brackets [ SEARCH ARCHIVAL KNOWLEDGE ], [ VIEW CATEGORY ] and SVG typography.
{%- endcomment -%}

{%- assign section_id = 'lx-faq-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --lx-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --lx-text: {{ section.settings.text_color | default: '#1a1a1a' }};
    --lx-gold: {{ section.settings.gold_accent | default: '#c9a96e' }};
    --lx-muted: rgba(26, 26, 26, 0.6);
    --lx-border: rgba(26, 26, 26, 0.1);
    --lx-card-bg: #fcfcfb;
    
    background-color: var(--lx-bg);
    color: var(--lx-text);
    padding: clamp(4.5rem, 9vw, 8rem) clamp(1.5rem, 5vw, 4rem);
    border-top: 1px solid var(--lx-border);
    position: relative;
    overflow: hidden;
  }

  #{{ section_id }} .lx-faq__header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem auto;
  }

  #{{ section_id }} .lx-faq__eyebrow {
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--lx-gold);
    margin-bottom: 0.6rem;
    display: inline-block;
  }

  #{{ section_id }} .lx-faq__title {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 300;
    margin: 0 0 1rem 0;
    line-height: 1.15;
  }

  #{{ section_id }} .lx-faq__sub {
    font-family: var(--font-body, sans-serif);
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    color: var(--lx-muted);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
    font-weight: 300;
  }

  /* Live Search Bar Architecture */
  #{{ section_id }} .lx-faq__search-wrap {
    max-width: 600px;
    margin: 0 auto 2.5rem auto;
    position: relative;
  }

  #{{ section_id }} .lx-faq__search-input {
    width: 100%;
    padding: 1.1rem 1.5rem;
    background: var(--lx-card-bg);
    border: 1px solid var(--lx-border);
    color: var(--lx-text);
    font-family: var(--font-body, sans-serif);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    text-align: center;
  }

  #{{ section_id }} .lx-faq__search-input:focus {
    border-color: var(--lx-gold);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }

  #{{ section_id }} .lx-faq__search-input::placeholder {
    color: rgba(26, 26, 26, 0.35);
    font-style: italic;
  }

  /* Category Filtering Pills */
  #{{ section_id }} .lx-faq__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-bottom: 3.5rem;
  }

  #{{ section_id }} .lx-faq__tab {
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    padding: 0.6rem 1.4rem;
    background: transparent;
    border: 1px solid var(--lx-border);
    color: var(--lx-muted);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  #{{ section_id }} .lx-faq__tab.is-active,
  #{{ section_id }} .lx-faq__tab:hover {
    background: var(--lx-text);
    color: #ffffff;
    border-color: var(--lx-text);
  }

  /* Accordion Questions List */
  #{{ section_id }} .lx-faq__list {
    max-width: 860px;
    margin: 0 auto;
  }

  #{{ section_id }} .lx-faq__item {
    border-bottom: 1px solid var(--lx-border);
    transition: background 0.3s ease;
  }

  #{{ section_id }} .lx-faq__item.is-hidden {
    display: none;
  }

  #{{ section_id }} .lx-faq__summary {
    padding: 1.5rem 0;
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: var(--lx-text);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  #{{ section_id }} .lx-faq__summary::-webkit-details-marker {
    display: none;
  }

  #{{ section_id }} .lx-faq__icon {
    font-family: var(--font-body, sans-serif);
    font-size: 0.8rem;
    color: var(--lx-gold);
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #{{ section_id }} .lx-faq__item[open] .lx-faq__icon {
    transform: rotate(45deg);
    color: var(--lx-text);
  }

  #{{ section_id }} .lx-faq__body {
    font-family: var(--font-body, sans-serif);
    font-size: 0.92rem;
    line-height: 1.75;
    color: var(--lx-muted);
    padding: 0 2rem 1.8rem 0;
    max-width: 760px;
  }

  /* Empty Search State */
  #{{ section_id }} .lx-faq__empty {
    display: none;
    text-align: center;
    padding: 3rem;
    font-family: var(--font-body, sans-serif);
    font-size: 0.95rem;
    color: var(--lx-muted);
  }

  #{{ section_id }} .lx-faq__empty.is-visible {
    display: block;
  }

  /* Footer & Concierge Escalation */
  #{{ section_id }} .lx-faq__footer {
    text-align: center;
    margin-top: 4.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--lx-border);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  #{{ section_id }} .lx-faq__footer-title {
    font-family: var(--font-heading, 'Times New Roman', serif);
    font-size: 1.3rem;
    margin: 0 0 0.5rem 0;
  }

  #{{ section_id }} .lx-faq__footer-sub {
    font-family: var(--font-body, sans-serif);
    font-size: 0.85rem;
    color: var(--lx-muted);
    margin: 0 0 1.5rem 0;
  }

  #{{ section_id }} .lx-faq__concierge-btn {
    display: inline-block;
    padding: 1rem 2.2rem;
    background: transparent;
    border: 1px solid var(--lx-text);
    color: var(--lx-text);
    font-family: var(--font-body, sans-serif);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease;
    text-decoration: none;
  }

  #{{ section_id }} .lx-faq__concierge-btn:hover {
    background: var(--lx-text);
    color: #ffffff;
  }

  /* Interactive VIP Modal Drawer */
  #{{ section_id }} .lx-faq__modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.85);
    z-index: 100;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    backdrop-filter: blur(8px);
  }

  #{{ section_id }} .lx-faq__modal.is-active {
    display: flex;
  }

  #{{ section_id }} .lx-faq__modal-box {
    background: #ffffff;
    color: #1a1a1a;
    border: 1px solid var(--lx-gold);
    max-width: 480px;
    width: 100%;
    padding: 3rem 2.5rem;
    text-align: center;
    position: relative;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
  }

  #{{ section_id }} .lx-faq__modal-close {
    position: absolute;
    top: 1rem;
    right: 1.2rem;
    background: transparent;
    border: none;
    color: rgba(0, 0, 0, 0.4);
    font-size: 1.2rem;
    cursor: pointer;
  }

  #{{ section_id }} .lx-faq__modal-close:hover {
    color: var(--lx-gold);
  }
</style>

<section id="{{ section_id }}" itemscope itemtype="https://schema.org/FAQPage">
  <div class="lx-faq__header">
    <span class="lx-faq__eyebrow">[ {{ section.settings.eyebrow | default: "ARCHIVAL KNOWLEDGE" }} ]</span>
    <h2 class="lx-faq__title">{{ section.settings.heading | default: "Frequently Asked Questions" }}</h2>
    <p class="lx-faq__sub">{{ section.settings.subheading | default: "Comprehensive guidance regarding our archival provenance, worldwide logistical security, and private salon acquisition terms." }}</p>
  </div>

  {%- if section.settings.show_search -%}
    <div class="lx-faq__search-wrap">
      <input 
        type="text" 
        class="lx-faq__search-input" 
        placeholder="{{ section.settings.search_placeholder | default: 'Search archival questions...' }}" 
        aria-label="Search FAQs"
        data-faq-search
      >
    </div>
  {%- endif -%}

  {%- if section.settings.show_categories -%}
    <div class="lx-faq__tabs" data-faq-tabs>
      <button type="button" class="lx-faq__tab is-active" data-cat="all">[ ALL ARCHIVES ]</button>
      <button type="button" class="lx-faq__tab" data-cat="logistics">[ LOGISTICS &amp; TRANSIT ]</button>
      <button type="button" class="lx-faq__tab" data-cat="provenance">[ PROVENANCE &amp; PURITY ]</button>
      <button type="button" class="lx-faq__tab" data-cat="terms">[ ACQUISITION TERMS ]</button>
    </div>
  {%- endif -%}

  <div class="lx-faq__list" data-faq-list>
    {%- for block in section.blocks -%}
      <details 
        class="lx-faq__item" 
        data-faq-item 
        data-category="{{ block.settings.category | default: 'all' }}"
        data-question-text="{{ block.settings.question | downcase | escape }}"
        {{ block.shopify_attributes }} 
        itemscope 
        itemprop="mainEntity" 
        itemtype="https://schema.org/Question"
      >
        <summary class="lx-faq__summary" itemprop="name">
          <span>{{ block.settings.question }}</span>
          <span class="lx-faq__icon">[ &plus; ]</span>
        </summary>
        <div class="lx-faq__body" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <div itemprop="text">{{ block.settings.answer }}</div>
        </div>
      </details>
    {%- endfor -%}
  </div>

  <div class="lx-faq__empty" data-faq-empty>
    <p>[ NO MATCHING ARCHIVAL QUESTIONS FOUND ]</p>
    <p style="font-size:0.8rem; margin-top:0.5rem;">Please alter your search parameters or speak directly with our private concierge.</p>
  </div>

  <div class="lx-faq__footer">
    <h3 class="lx-faq__footer-title">{{ section.settings.footer_heading | default: "Require Bespoke Assistance?" }}</h3>
    <p class="lx-faq__footer-sub">{{ section.settings.footer_sub | default: "Our private salon stylists and master gemologists are at your disposal for confidential consultation." }}</p>
    <button type="button" class="lx-faq__concierge-btn" data-open-modal>[ SPEAK WITH ARCHIVAL CONCIERGE ]</button>
  </div>

  <!-- Interactive VIP Concierge Modal -->
  <div class="lx-faq__modal" data-modal-overlay>
    <div class="lx-faq__modal-box">
      <button type="button" class="lx-faq__modal-close" aria-label="Close modal" data-close-modal>[ &times; ]</button>
      <h3 style="font-family:var(--font-heading,serif); font-size:1.6rem; margin:0 0 0.5rem 0;">Private Concierge</h3>
      <p style="font-size:0.85rem; color:var(--lx-muted); margin:0 0 2rem 0;">Direct WhatsApp line with senior salon gemologists.</p>
      
      <a 
        href="https://wa.me/{{ settings.whatsapp_number | default: '919876543210' }}?text=Hello%20Concierge,%20I%20have%20an%20inquiry%20regarding%20an%20archival%20creation." 
        target="_blank" 
        rel="noopener"
        style="display:block; width:100%; padding:1rem; background:var(--lx-gold); color:#000000; text-decoration:none; font-family:var(--font-body,sans-serif); font-size:0.75rem; text-transform:uppercase; letter-spacing:0.18em; font-weight:600;"
      >
        [ CONNECT VIA WHATSAPP ]
      </a>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var searchInput = section.querySelector('[data-faq-search]');
    var tabs = section.querySelectorAll('.lx-faq__tab');
    var items = section.querySelectorAll('[data-faq-item]');
    var emptyState = section.querySelector('[data-faq-empty]');
    var activeCategory = 'all';
    var searchQuery = '';

    var filterItems = function() {
      var visibleCount = 0;
      items.forEach(function(item) {
        var itemCat = item.getAttribute('data-category') || 'all';
        var itemText = item.getAttribute('data-question-text') || '';
        
        var matchesCat = (activeCategory === 'all' || itemCat === activeCategory);
        var matchesSearch = (searchQuery === '' || itemText.indexOf(searchQuery) !== -1);

        if (matchesCat && matchesSearch) {
          item.classList.remove('is-hidden');
          visibleCount++;
        } else {
          item.classList.add('is-hidden');
        }
      });

      if (emptyState) {
        if (visibleCount === 0) emptyState.classList.add('is-visible');
        else emptyState.classList.remove('is-visible');
      }
    };

    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        searchQuery = (e.target.value || '').toLowerCase().trim();
        filterItems();
      });
    }

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('is-active'); });
        this.classList.add('is-active');
        activeCategory = this.getAttribute('data-cat') || 'all';
        filterItems();
      });
    });

    // Modal controls
    var openBtn = section.querySelector('[data-open-modal]');
    var closeBtn = section.querySelector('[data-close-modal]');
    var modal = section.querySelector('[data-modal-overlay]');

    if (openBtn && modal) {
      openBtn.addEventListener('click', function() { modal.classList.add('is-active'); });
    }
    if (closeBtn && modal) {
      closeBtn.addEventListener('click', function() { modal.classList.remove('is-active'); });
    }
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) modal.classList.remove('is-active');
      });
    }
  });
</script>

