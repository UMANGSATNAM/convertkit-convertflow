{%- comment -%}
  sections/size-guide_luxury.liquid
  
  CONVERSION PSYCHOLOGY & ARCHITECTURE:
  1. RISK REVERSAL & ABILITY (FOGG BEHAVIOR MODEL) -- Sizing uncertainty is the #1
     driver of D2C returns and cart abandonment in luxury jewellery & fashion.
     Providing precise, multi-regional tables (US, UK, India) eliminates hesitation.
  2. INTERACTIVE TABBED VISUALIZATION -- Cognitive ease through segmentation:
     Rings, Necklaces, and Bracelets are cleanly separated into tabs so buyers
     are not overwhelmed by data.
  3. BESPOKE SERVICE ANCHORING -- Includes an explicit guarantee: "Complimentary
     artisan sizing adjustments within 30 days of purchase." This turns a technical
     table into a high-touch luxury service touchpoint.
  4. ZERO EMOJI POLICY -- Strict editorial ASCII typography [ LIKE THIS ] for all
     tabs, buttons, and badges.
{%- endcomment -%}

<style>
  .lx-size-guide {
    background: var(--size-guide-bg, #0a0a0a);
    color: var(--size-guide-color, #fff);
    padding: clamp(3rem, 6vw, 6rem) 1.5rem;
    font-family: var(--font-body, sans-serif);
    border-top: 1px solid rgba(201, 169, 110, 0.15);
    border-bottom: 1px solid rgba(201, 169, 110, 0.15);
  }

  .lx-size-guide__inner {
    max-width: var(--max-width, 1000px);
    margin: 0 auto;
  }

  /* Header Section */
  .lx-size-guide__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .lx-size-guide__subtitle {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9a96e;
    margin-bottom: 0.75rem;
    display: block;
  }

  .lx-size-guide__title {
    font-family: var(--font-heading, serif);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 400;
    margin: 0 0 1rem 0;
  }

  .lx-size-guide__desc {
    color: rgba(255, 255, 255, 0.7);
    max-width: 600px;
    margin: 0 auto;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Interactive Tabs */
  .lx-size-guide__tabs {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 1rem;
    flex-wrap: wrap;
  }

  .lx-size-guide__tab-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    font-family: var(--font-body, sans-serif);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.6rem 1.25rem;
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease;
    border: 1px solid transparent;
  }

  .lx-size-guide__tab-btn:hover {
    color: #fff;
  }

  .lx-size-guide__tab-btn.is-active {
    color: #c9a96e;
    border-color: rgba(201, 169, 110, 0.4);
    background: rgba(201, 169, 110, 0.05);
  }

  /* Tab Content Panels */
  .lx-size-guide__panel {
    display: none;
    animation: lxPanelFadeIn 0.4s ease forwards;
  }

  .lx-size-guide__panel.is-active {
    display: block;
  }

  @keyframes lxPanelFadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Tables */
  .lx-size-guide__table-wrapper {
    overflow-x: auto;
    margin-bottom: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .lx-size-guide__table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-variant-numeric: tabular-nums;
  }

  .lx-size-guide__table th,
  .lx-size-guide__table td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.9rem;
  }

  .lx-size-guide__table th {
    background: rgba(255, 255, 255, 0.03);
    color: #c9a96e;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .lx-size-guide__table tr:last-child td {
    border-bottom: none;
  }

  .lx-size-guide__table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  /* Fit Instructions & Bespoke Guarantee */
  .lx-size-guide__footer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 3rem;
  }

  @media (max-width: 768px) {
    .lx-size-guide__footer-grid {
      grid-template-columns: 1fr;
    }
  }

  .lx-size-guide__box {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(201, 169, 110, 0.2);
    padding: 2rem;
  }

  .lx-size-guide__box-title {
    font-family: var(--font-heading, serif);
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    color: #fff;
  }

  .lx-size-guide__box-list {
    list-style: none;
    padding: 0;
    margin: 0;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .lx-size-guide__box-list li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .lx-size-guide__box-list li::before {
    content: "*";
    position: absolute;
    left: 0;
    color: #c9a96e;
  }

  .lx-size-guide__guarantee {
    text-align: center;
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px dashed rgba(201, 169, 110, 0.4);
    background: rgba(201, 169, 110, 0.03);
  }

  .lx-size-guide__guarantee-text {
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c9a96e;
  }
</style>

<section
  class="lx-size-guide"
  data-section-id="{{ section.id }}"
  data-section-type="size-guide">
  
  <div class="lx-size-guide__inner">
    {%- comment -%} Header {%- endcomment -%}
    <div class="lx-size-guide__header">
      <span class="lx-size-guide__subtitle">{{ section.settings.subtitle | default: "[ MEASUREMENT & FIT ]" }}</span>
      <h2 class="lx-size-guide__title">{{ section.settings.title | default: "Bespoke Size Guide" }}</h2>
      <p class="lx-size-guide__desc">
        {{ section.settings.description | default: "To ensure an exquisite fit, reference our global conversion charts below. Every creation is crafted to adhere to rigorous international sizing standards." }}
      </p>
    </div>

    {%- comment -%} Interactive Tabs {%- endcomment -%}
    <div class="lx-size-guide__tabs" role="tablist">
      <button type="button" class="lx-size-guide__tab-btn is-active" data-target="rings" role="tab" aria-selected="true">
        [ RINGS & SIGNETS ]
      </button>
      <button type="button" class="lx-size-guide__tab-btn" data-target="necklaces" role="tab" aria-selected="false">
        [ NECKLACES & CHAINS ]
      </button>
      <button type="button" class="lx-size-guide__tab-btn" data-target="bracelets" role="tab" aria-selected="false">
        [ BANGLES & BRACELETS ]
      </button>
    </div>

    {%- comment -%} Panel 1: Rings {%- endcomment -%}
    <div class="lx-size-guide__panel is-active" id="panel-rings" role="tabpanel">
      <div class="lx-size-guide__table-wrapper">
        <table class="lx-size-guide__table">
          <thead>
            <tr>
              <th>India / Asia Standard</th>
              <th>US / Canada</th>
              <th>UK / Australia</th>
              <th>Inside Diameter (mm)</th>
              <th>Inside Circumference (mm)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Size 8</td><td>4.5</td><td>I 1/2</td><td>15.3 mm</td><td>48.0 mm</td></tr>
            <tr><td>Size 10</td><td>5.25</td><td>K</td><td>15.9 mm</td><td>50.0 mm</td></tr>
            <tr><td>Size 12</td><td>6.0</td><td>L 1/2</td><td>16.5 mm</td><td>51.8 mm</td></tr>
            <tr><td>Size 14</td><td>7.0</td><td>N 1/2</td><td>17.3 mm</td><td>54.4 mm</td></tr>
            <tr><td>Size 16</td><td>7.75</td><td>P</td><td>18.1 mm</td><td>56.9 mm</td></tr>
            <tr><td>Size 18</td><td>8.5</td><td>Q 1/2</td><td>18.9 mm</td><td>59.5 mm</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    {%- comment -%} Panel 2: Necklaces {%- endcomment -%}
    <div class="lx-size-guide__panel" id="panel-necklaces" role="tabpanel">
      <div class="lx-size-guide__table-wrapper">
        <table class="lx-size-guide__table">
          <thead>
            <tr>
              <th>Length (Inches / CM)</th>
              <th>Classical Style Name</th>
              <th>Resting Position on Body</th>
              <th>Recommended Styling</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>14" -- 16" (35-40 cm)</td><td>Choker / Collar</td><td>Base of the neck</td><td>High necklines, off-shoulder evening wear</td></tr>
            <tr><td>18" (45 cm)</td><td>Princess Length</td><td>On the collarbone</td><td>Classic pendants, versatile daily wear</td></tr>
            <tr><td>20" -- 24" (50-60 cm)</td><td>Matinee Length</td><td>Between collarbone and bust</td><td>Layering over high necklines or business attire</td></tr>
            <tr><td>28" -- 32" (70-80 cm)</td><td>Opera Length</td><td>Below the bust / sternum</td><td>Dramatic evening styling, can be doubled over</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    {%- comment -%} Panel 3: Bracelets & Bangles (Indian Standard Included) {%- endcomment -%}
    <div class="lx-size-guide__panel" id="panel-bracelets" role="tabpanel">
      <div class="lx-size-guide__table-wrapper">
        <table class="lx-size-guide__table">
          <thead>
            <tr>
              <th>Indian Bangle Size</th>
              <th>Inside Diameter (mm / Inches)</th>
              <th>Inside Circumference</th>
              <th>Fit Profile</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>2 - 2 (2.125")</td><td>54.0 mm / 2.12"</td><td>169.6 mm</td><td>Petite / Small Wrist</td></tr>
            <tr><td>2 - 4 (2.250")</td><td>57.2 mm / 2.25"</td><td>179.6 mm</td><td>Standard Medium Fit</td></tr>
            <tr><td>2 - 6 (2.375")</td><td>60.3 mm / 2.37"</td><td>189.5 mm</td><td>Medium-Large / Relaxed Fit</td></tr>
            <tr><td>2 - 8 (2.500")</td><td>63.5 mm / 2.50"</td><td>199.4 mm</td><td>Large / Statement Cuff Fit</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    {%- comment -%} Measurement Advice & Bespoke Guarantee {%- endcomment -%}
    <div class="lx-size-guide__footer-grid">
      <div class="lx-size-guide__box">
        <h3 class="lx-size-guide__box-title">How to Measure at Home</h3>
        <ul class="lx-size-guide__box-list">
          <li>Wrap a thin strip of paper or ribbon around the base of your finger or wrist.</li>
          <li>Mark the exact point where the ends meet without pulling too tightly.</li>
          <li>Measure the length against a millimeter ruler to determine your circumference.</li>
          <li>For wide band rings or stacking bangles, we recommend selecting one size larger for effortless comfort.</li>
        </ul>
      </div>

      <div class="lx-size-guide__box">
        <h3 class="lx-size-guide__box-title">The Master Artisan Sizing Note</h3>
        <ul class="lx-size-guide__box-list">
          <li>Every creation is hand-finished in our ateliers to exact millimeter tolerances.</li>
          <li>Should your jewel require a subtle fit refinement, our master goldsmiths perform complimentary sizing within 30 days of acquisition.</li>
          <li>For bespoke consultations or private sizing assistance, connect with our concierge team.</li>
        </ul>
      </div>
    </div>

    <div class="lx-size-guide__guarantee">
      <div class="lx-size-guide__guarantee-text">
        [ COMPLIMENTARY ARTISAN RESIZING & WHITE-GLOVE EXCHANGES ON ALL CREATIONS ]
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    const container = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!container) return;

    const tabBtns = container.querySelectorAll('.lx-size-guide__tab-btn');
    const panels = container.querySelectorAll('.lx-size-guide__panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        tabBtns.forEach(b => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === 'panel-' + targetId) {
            p.classList.add('is-active');
          } else {
            p.classList.remove('is-active');
          }
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Size Guide (Luxury)",
  "tag": "section",
  "class": "section-size-guide",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "[ MEASUREMENT & FIT ]"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Bespoke Size Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "To ensure an exquisite fit, reference our global conversion charts below. Every creation is crafted to adhere to rigorous international sizing standards."
    }
  ],
  "presets": [
    {
      "name": "Size Guide (Luxury)"
    }
  ]
}
{% endschema %}
