    align-items: center;
    gap: 0.4rem;
  }

  #{{ section_id }} .sub__price-box {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }

  #{{ section_id }} .sub__price-lbl {
    font-size: 0.88rem;
