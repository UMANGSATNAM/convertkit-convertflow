    background: #f1f5f9;
    border: 1px solid var(--sub-border);
    padding: 1rem;
    font-family: monospace;
    font-size: 0.78rem;
    color: var(--sub-heading);
    margin-bottom: 1rem;
  }

  #{{ section_id }} .sub__modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: transparent;
    border: 1px solid var(--sub-border);
    color: var(--sub-muted);
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 700;
