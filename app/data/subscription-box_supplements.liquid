    font-weight: 800;
    color: var(--sub-green);
    margin-top: 0.5rem;
    text-transform: uppercase;
  }

  /* Right Column: Real-Time VIP Summary Panel */
  #{{ section_id }} .sub__panel {
    background: var(--sub-card);
    border: 2px solid var(--sub-blue);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    position: sticky;
    top: 2rem;
    box-shadow: 0 25px 50px rgba(15, 45, 92, 0.12);
  }

  #{{ section_id }} .sub__panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--sub-blue);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }

  #{{ section_id }} .sub__panel-title {
    font-size: 1rem;
    font-weight: 800;
    color: var(--sub-blue);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }

