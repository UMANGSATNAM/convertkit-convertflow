<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var formulaBtns = section.querySelectorAll('[data-opt-group="formula"] .sub__opt-btn');
    var flavorBtns = section.querySelectorAll('[data-opt-group="flavor"] .sub__opt-btn');
    var freqBtns = section.querySelectorAll('[data-opt-group="freq"] .sub__opt-btn');

    var sumFormula = section.querySelector('[data-sum-formula]');
    var sumFlavor = section.querySelector('[data-sum-flavor]');
    var sumFreq = section.querySelector('[data-sum-freq]');
    var oldPriceEl = section.querySelector('[data-old-price]');
    var newPriceEl = section.querySelector('[data-new-price]');
    var checkoutBtn = section.querySelector('[data-checkout-btn]');

    var smsTrigger = section.querySelector('[data-sms-trigger]');
    var smsBox = section.querySelector('[data-sms-box]');
    var smsClose = section.querySelector('[data-sms-close]');

    function updateSelection(groupBtns, callback) {
      groupBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          groupBtns.forEach(function(b) { b.classList.remove('is-active'); });
          this.classList.add('is-active');
          callback(this);
        });
      });
    }

    updateSelection(formulaBtns, function(btn) {
      var val = btn.getAttribute('data-val') || 'Cellular ATP';
      var oldP = btn.getAttribute('data-price') || '4499';
      var newP = btn.getAttribute('data-save') || '3374';

      if (sumFormula) sumFormula.textContent = '[ ' + val.toUpperCase() + ' ]';
      if (oldPriceEl) oldPriceEl.textContent = 'RS. ' + oldP;
      if (newPriceEl) newPriceEl.textContent = 'RS. ' + newP;
    });

    updateSelection(flavorBtns, function(btn) {
      var val = btn.getAttribute('data-val') || 'Blue Raspberry';
      if (sumFlavor) sumFlavor.textContent = '[ ' + val.toUpperCase() + ' ]';
    });

    updateSelection(freqBtns, function(btn) {
      var val = btn.getAttribute('data-val') || '30 Days';
      if (sumFreq) sumFreq.textContent = '[ EVERY ' + val.toUpperCase() + ' ]';
    });

    if (checkoutBtn) {
      checkoutBtn.addEventListener('click', function() {
        checkoutBtn.textContent = '[ PROCESSING VIP DISPATCH... ]';
        setTimeout(function() {
          checkoutBtn.textContent = '[ LOCK IN 25% SAVINGS * START PROTOCOL ]';
          alert('[ SYSTEM NOTE ] VIP Wellness Box successfully configured. Proceeding to Shopify checkout with 25% discount applied.');
        }, 600);
      });
    }

    if (smsTrigger) {
      smsTrigger.addEventListener('click', function() {
        if (smsBox) {
          smsBox.style.display = 'block';
          smsBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    }

    if (smsClose) {
      smsClose.addEventListener('click', function() {
        if (smsBox) smsBox.style.display = 'none';
      });
    }
  });
</script>

