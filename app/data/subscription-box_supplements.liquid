    margin-right: 0.5rem;
  }

  #{{ section_id }} .sub__new-price {
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--sub-blue);
  }

  #{{ section_id }} .sub__checkout-btn {
    width: 100%;
    background: var(--sub-blue);
    color: #ffffff;
    border: none;
