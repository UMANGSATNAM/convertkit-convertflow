{%- comment -%}
  sections/subscription-box_supplements.liquid
  CONVERSION PSYCHOLOGY & ARCHITECTURE (440+ lines):
  1. CUSTOMIZATION & THE OWNERSHIP EFFECT: Allowing health consumers to customize their subscription box across 3 distinct steps (Formula Selection, Flavor Profile, Delivery Frequency) creates psychological attachment and perceived personal tailoring before checkout.
  2. RECURRING VALUE ANNIHILATION OF FRICTION: Explicitly highlighting automatic 25% savings, complimentary VIP gift additions ([ FREE BPA-FREE SHAKER ], [ FREE EXPEDITED COURIER ]), and lock-in price guarantees removes purchase resistance.
  3. SMS ONE-CLICK CONTROL GUARANTEE: The greatest fear in subscription commerce is being trapped in difficult cancellation loops. Showing an interactive SMS control preview where users simply text [ PAUSE ], [ SWAP ], or [ CANCEL ] builds radical transparency and unbreakable trust.
  4. ZERO EMOJI GUARANTEE: Uses clinical-grade ASCII brackets [ SUB & SAVE - 25% OFF ], [ STEP 1 ], [ VERIFIED VIP ], and pharmaceutical laboratory aesthetics.
{%- endcomment -%}

{%- assign section_id = 'sp-sub-' | append: section.id -%}

<style>
  #{{ section_id }} {
    --sub-bg: {{ section.settings.bg_color | default: '#f8fafc' }};
    --sub-card: #ffffff;
    --sub-border: #cbd5e1;
    --sub-text: #1e293b;
    --sub-heading: #0f172a;
    --sub-blue: #0f2d5c;
    --sub-accent: #0284c7;
    --sub-green: #166534;
    --sub-green-bg: #dcfce7;
    --sub-muted: #64748b;

    background-color: var(--sub-bg);
    color: var(--sub-text);
    padding: clamp(4rem, 8vw, 7rem) clamp(1.2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--sub-border);
    border-bottom: 1px solid var(--sub-border);
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    position: relative;
  }

  #{{ section_id }} .sub__container {
    max-width: 1250px;
    margin: 0 auto;
  }

  /* Header Ribbon */
  #{{ section_id }} .sub__header {
    text-align: center;
    max-width: 850px;
    margin: 0 auto 3.5rem auto;
  }

  #{{ section_id }} .sub__badge {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--sub-blue);
    background: #e2e8f0;
    border: 1px solid var(--sub-border);
    padding: 0.35rem 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  #{{ section_id }} .sub__title {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 800;
    color: var(--sub-heading);
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }

  #{{ section_id }} .sub__sub {
    font-size: 0.95rem;
    color: var(--sub-muted);
    line-height: 1.6;
  }

  #{{ section_id }} .sub__sub strong {
    color: var(--sub-heading);
  }

  /* Main Builder Layout */
  #{{ section_id }} .sub__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: flex-start;
  }

  @media (min-width: 992px) {
    #{{ section_id }} .sub__layout {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  /* Left Column: Interactive Multi-Step Builder */
  #{{ section_id }} .sub__builder {
    background: var(--sub-card);
    border: 2px solid var(--sub-blue);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: 0 20px 40px rgba(15, 45, 92, 0.08);
  }

  #{{ section_id }} .sub__step {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--sub-border);
  }

  #{{ section_id }} .sub__step:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  #{{ section_id }} .sub__step-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
  }

  #{{ section_id }} .sub__step-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--sub-blue);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }

  #{{ section_id }} .sub__step-tag {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--sub-accent);
    background: #f0f9ff;
    padding: 0.25rem 0.6rem;
    text-transform: uppercase;
  }

  #{{ section_id }} .sub__options {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
  }

  @media (min-width: 600px) {
    #{{ section_id }} .sub__options {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  #{{ section_id }} .sub__opt-btn {
    background: var(--sub-card);
    border: 1px solid var(--sub-border);
    padding: 1rem;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 90px;
  }

  #{{ section_id }} .sub__opt-btn:hover {
    border-color: var(--sub-blue);
  }

  #{{ section_id }} .sub__opt-btn.is-active {
    background: #f0f9ff;
    border: 2px solid var(--sub-blue);
    box-shadow: 0 4px 12px rgba(15, 45, 92, 0.1);
  }

  #{{ section_id }} .sub__opt-name {
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--sub-heading);
    text-transform: uppercase;
    margin-bottom: 0.3rem;
  }

  #{{ section_id }} .sub__opt-desc {
    font-size: 0.72rem;
    color: var(--sub-muted);
    line-height: 1.4;
  }

  #{{ section_id }} .sub__opt-badge {
