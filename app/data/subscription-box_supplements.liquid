  /* SMS Control Drawer / Modal Box */
  #{{ section_id }} .sub__modal-box {
    background: #ffffff;
    border: 2px solid var(--sub-accent);
    padding: 2rem;
    margin-top: 2rem;
    display: none;
    position: relative;
    box-shadow: 0 15px 30px rgba(2, 132, 199, 0.1);
