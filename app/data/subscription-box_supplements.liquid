  }

  #{{ section_id }} .sub__checkout-btn:hover {
    background: #0a1e3f;
  }

  #{{ section_id }} .sub__sms-trigger {
    background: transparent;
    border: none;
    width: 100%;
    color: var(--sub-accent);
    font-family: inherit;
    font-size: 0.75rem;
