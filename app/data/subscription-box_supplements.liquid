  #{{ section_id }} .sub__modal-title {
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--sub-accent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 0.8rem 0;
