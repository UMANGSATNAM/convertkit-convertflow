    padding: 0.25rem 0.6rem;
  }

  /* Footer Trust Guarantee */
  #{{ section_id }} .sub__footer {
    margin-top: 3.5rem;
    background: #e2e8f0;
    border: 1px solid var(--sub-border);
    padding: 1.5rem;
    text-align: center;
    font-size: 0.78rem;
    color: var(--sub-muted);
    line-height: 1.6;
  }

  #{{ section_id }} .sub__footer strong {
    color: var(--sub-blue);
  }
</style>

