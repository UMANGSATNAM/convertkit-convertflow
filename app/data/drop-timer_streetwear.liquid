          <div class="dt__grid-item">
            <span class="dt__grid-lbl">CART RESERVE:</span>
            <span class="dt__grid-val">10 MINUTES HOLD ONCE ADDED</span>
          </div>
          <div class="dt__grid-item">
            <span class="dt__grid-lbl">PAYMENT GATEWAY:</span>
            <span class="dt__grid-val">3D SECURE ENCRYPTED ONLY</span>
          </div>
          <div class="dt__grid-item">
            <span class="dt__grid-lbl">OVERBUY POLICY:</span>
