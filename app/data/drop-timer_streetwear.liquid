            <span class="dt__grid-lbl">OUTLET RELEASE:</span>
            <span class="dt__grid-val">STRICTLY PROHIBITED</span>
          </div>
          <div class="dt__grid-item">
            <span class="dt__grid-lbl">COLLECTION VALUE:</span>
            <span class="dt__grid-val">IMMEDIATE SCARCITY PREMIUM</span>
          </div>
          <div class="dt__grid-item">
            <span class="dt__grid-lbl">ARCHIVE STATUS:</span>
            <span class="dt__grid-val">SEALED AT TIMER ZERO</span>
          </div>
        </div>
      </div>
    </div>

    <button type="button" class="dt__priority-btn" data-priority-open>[ HOW DOES THE FAST-TRACK SYNDICATE PRIORITY QUEUE WORK? ]</button>

    <!-- Priority Queue Modal -->
    <div class="dt__modal-box" data-priority-box>
      <button type="button" class="dt__modal-close" data-priority-close>[ X ] CLOSE</button>
      <div class="dt__modal-title">[ SYNDICATE PRIORITY QUEUE PROTOCOL ]</div>
      <p class="dt__modal-text">
        Verified StoreForge Syndicate members who own an active NFC collector garment from a previous drop receive a <strong>5-minute early checkout bypass token</strong> via SMS before the public countdown timer reaches zero.<br><br>
        To activate your priority queue pass, simply log in with your verified phone number during checkout. Your allocation of 2 pieces will be guaranteed for 10 minutes.
      </p>
      <div style="font-size:0.75rem; color:var(--dt-muted);">
        // Priority queue access is tied directly to your cryptographic NFC garment collection history. //
      </div>
    </div>

    <!-- Footer Guarantee -->
    <div class="dt__footer">
      // <strong>THE FAIR DROP GUARANTEE:</strong> We never reserve inventory for influencers or VIP resellers. Every single unit is released to verified human customers on a strict first-come, first-served basis. //
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var section = document.querySelector('#{{ section_id }}');
    if (!section) return;

    var tabs = section.querySelectorAll('.dt__tab');
    var contents = section.querySelectorAll('.dt__content');
    var stageBtns = section.querySelectorAll('.dt__stage-btn');
    var statusText = section.querySelector('[data-drop-status]');

    var daysEl = section.querySelector('[data-val-days]');
    var hoursEl = section.querySelector('[data-val-hours]');
    var minsEl = section.querySelector('[data-val-mins]');
    var secsEl = section.querySelector('[data-val-secs]');

    var priorityOpen = section.querySelector('[data-priority-open]');
    var priorityBox = section.querySelector('[data-priority-box]');
    var priorityClose = section.querySelector('[data-priority-close]');

    // Countdown logic
    var target = new Date();
    target.setHours(target.getHours() + 4);
    target.setMinutes(target.getMinutes() + 22);
    target.setSeconds(target.getSeconds() + 18);

    var timerInterval = setInterval(function() {
      var now = new Date();
      var diff = target - now;

      if (diff <= 0) {
        if (daysEl) daysEl.textContent = '00';
        if (hoursEl) hoursEl.textContent = '00';
        if (minsEl) minsEl.textContent = '00';
        if (secsEl) secsEl.textContent = '00';
        if (statusText) statusText.textContent = '[ STATUS: STAGE 3 &bull; VAULT SEALED &bull; SOLD OUT ]';
        return;
      }

      var d = Math.floor(diff / (1000 * 60 * 60 * 24));
      var h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      var m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      var s = Math.floor((diff % (1000 * 60)) / 1000);

      if (daysEl) daysEl.textContent = String(d).padStart(2, '0');
      if (hoursEl) hoursEl.textContent = String(h).padStart(2, '0');
      if (minsEl) minsEl.textContent = String(m).padStart(2, '0');
      if (secsEl) secsEl.textContent = String(s).padStart(2, '0');
    }, 1000);

    // Stage simulation override
    stageBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        stageBtns.forEach(function(b) { b.classList.remove('is-active'); });
        this.classList.add('is-active');
        var st = this.getAttribute('data-stage') || '1';

        if (st === '1') {
          if (statusText) statusText.textContent = '[ STATUS: STAGE 1 &bull; DROP LIVE &bull; VAULT OPEN ]';
          if (hoursEl) hoursEl.textContent = '04';
          if (minsEl) minsEl.textContent = '22';
        } else if (st === '2') {
          if (statusText) statusText.textContent = '[ STATUS: STAGE 2 &bull; CRITICAL WARNING: 15 MIN LEFT ]';
          if (hoursEl) hoursEl.textContent = '00';
          if (minsEl) minsEl.textContent = '14';
        } else if (st === '3') {
          if (statusText) statusText.textContent = '[ STATUS: STAGE 3 &bull; VAULT SEALED &bull; SOLD OUT ]';
          if (hoursEl) hoursEl.textContent = '00';
          if (minsEl) minsEl.textContent = '00';
          if (secsEl) secsEl.textContent = '00';
        }
      });
    });

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('is-active'); });
        this.classList.add('is-active');
        var target = this.getAttribute('data-target') || 'rules';

        contents.forEach(function(c) {
          var cTarget = c.getAttribute('data-content') || 'rules';
          if (cTarget === target) {
            c.classList.add('is-active');
          } else {
            c.classList.remove('is-active');
          }
        });
      });
    });

    if (priorityOpen) {
      priorityOpen.addEventListener('click', function() {
        if (priorityBox) {
          priorityBox.style.display = 'block';
          priorityBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    }

    if (priorityClose) {
      priorityClose.addEventListener('click', function() {
        if (priorityBox) priorityBox.style.display = 'none';
      });
    }
  });
</script>

