            <span class="dt__grid-lbl">CAPTCHA TYPE:</span>
            <span class="dt__grid-val">INVISIBLE IN-LINE CHALLENGE</span>
          </div>
          <div class="dt__grid-item">
            <span class="dt__grid-lbl">SUCCESS RATE:</span>
            <span class="dt__grid-val">99.8% HUMAN CHECKOUTS</span>
          </div>
        </div>
      </div>

      <!-- Content 4: Archive -->
      <div class="dt__content" data-content="archive">
        <h3 class="dt__content-title">[ PERMANENT PRODUCTION CLOSURE ]</h3>
        <p class="dt__content-desc">
          When this timer expires, any unsold inventory is transferred to our physical Tokyo archive museum. It will never be discounted, sold in outlet stores, or made available online again under any circumstances.
        </p>
        <div class="dt__grid">
          <div class="dt__grid-item">
            <span class="dt__grid-lbl">RESTOCK CHANCE:</span>
            <span class="dt__grid-val">0.0% &bull; PERMANENTLY CLOSED</span>
          </div>
