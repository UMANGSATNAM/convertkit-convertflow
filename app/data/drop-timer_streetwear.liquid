    <!-- Toolbar: Drop Tabs -->
    <div class="dt__toolbar" data-dt-tabs>
      <button type="button" class="dt__tab is-active" data-target="rules">[ 01: DROP ALLOCATION RULES ]</button>
      <button type="button" class="dt__tab" data-target="ship">[ 02: DISPATCH &amp; COURIER ]</button>
      <button type="button" class="dt__tab" data-target="security">[ 03: ANTI-BOT SECURITY ]</button>
      <button type="button" class="dt__tab" data-target="archive">[ 04: COLLECTOR VALUE ]</button>
