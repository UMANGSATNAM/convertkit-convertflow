{% comment %}
  =============================================================================
  DEWIA · NEW-AGE BEAUTY & CELLULAR GLASS SKIN LANDING PAGE
  Shopify OS 2.0 Complete Single-File Section
  -----------------------------------------------------------------------------
  A globally reusable, 100% working, and fully customizable beauty landing page
  inspired by Rhode Skin, Glossier, and Summer Fridays.

  EVERY SECTION IS WORKING & FULLY CHANGEABLE IN THE THEME CUSTOMIZER:
  - Top Announcement Marquee (Customizable ticker text, speed, background color)
  - Editorial Sticky Header (Brand name, navigation anchors, live bag drawer trigger)
  - Hero Masthead (Headlines, subtitle, live rating, dual CTAs, macro floating pills)
  - Clinical Results Strip (3 empirical percentage counters with lab attribution)
  - Interactive 3-Step Routine Bundle Builder (Step cards with toggle checkboxes,
    real-time price & savings calculator, 1-click Add to Bag engine)
  - Interactive 14-Day Before / After Glow Slider (Draggable split-screen proof)
  - Interactive Shade / Tint Swatch Selector (4 customizable color swatches)
  - Bioactive Ingredients Macro Breakdown (Molecule cards with clinical function)
  - Filterable UGC Community Wall (Customer reviews filterable by skin concern)
  - Collapsible Clinical FAQ Accordion (Smooth expand/collapse accordion)
  - Slide-out Cart Drawer & Bottom Sticky Add-To-Bag Conversion Dock
  =============================================================================
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --dew-bg-milk: {{ section.settings.color_bg_milk | default: '#faf8f5' }};
    --dew-bg-card: #ffffff;
    --dew-bg-warm: {{ section.settings.color_bg_warm | default: '#f4ede4' }};
    --dew-bg-surface: {{ section.settings.color_bg_surface | default: '#efe6dc' }};
    --dew-border-subtle: {{ section.settings.color_border | default: '#e6ded3' }};
    --dew-border-strong: #d4c8ba;

    --dew-accent-peach: {{ section.settings.color_accent | default: '#c87d65' }};
    --dew-accent-hover: {{ section.settings.color_accent_hover | default: '#b56a52' }};
    --dew-accent-glow: rgba(200, 125, 101, 0.22);
    --dew-accent-soft: #faeee9;

    --dew-amber-glow: #de8f75;
    --dew-botanical-sage: {{ section.settings.color_sage | default: '#4e7259' }};
    --dew-sage-soft: #eaf1ec;

    --dew-text-main: {{ section.settings.color_text | default: '#1c1917' }};
    --dew-text-muted: {{ section.settings.color_text_muted | default: '#6b635b' }};
    --dew-text-light: #948b81;

    --dew-font-editorial: 'Instrument Serif', 'Playfair Display', Georgia, serif;
    --dew-font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

    --dew-shadow-subtle: 0 4px 20px rgba(28, 25, 23, 0.04);
    --dew-shadow-card: 0 10px 30px rgba(28, 25, 23, 0.06);
    --dew-shadow-elevated: 0 20px 45px rgba(28, 25, 23, 0.1);
    --dew-shadow-peach: 0 10px 25px rgba(200, 125, 101, 0.25);
    --dew-glass: rgba(250, 248, 245, 0.88);

    --dew-radius-sm: 6px;
    --dew-radius-md: 12px;
    --dew-radius-lg: 20px;
    --dew-radius-pill: 9999px;

    --dew-transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    --container-max: 1200px;

    font-family: var(--dew-font-sans);
    background-color: var(--dew-bg-milk);
    color: var(--dew-text-main);
    line-height: 1.6;
    position: relative;
    overflow-x: hidden;
  }

  #shopify-section-{{ section.id }} * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
    transition: var(--dew-transition);
  }

  #shopify-section-{{ section.id }} button {
    cursor: pointer;
    font-family: inherit;
    border: none;
    background: none;
  }

  #shopify-section-{{ section.id }} img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  #shopify-section-{{ section.id }} .dew-container {
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  #shopify-section-{{ section.id }} .dew-serif {
    font-family: var(--dew-font-editorial);
  }

  /* Buttons & Badges */
  #shopify-section-{{ section.id }} .dew-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.95rem 1.8rem;
    font-size: 0.92rem;
    font-weight: 600;
    border-radius: var(--dew-radius-pill);
    transition: var(--dew-transition);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .dew-btn-primary {
    background-color: var(--dew-accent-peach);
    color: #ffffff;
    box-shadow: var(--dew-shadow-peach);
  }

  #shopify-section-{{ section.id }} .dew-btn-primary:hover {
    background-color: var(--dew-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 14px 28px rgba(200, 125, 101, 0.35);
  }

  #shopify-section-{{ section.id }} .dew-btn-secondary {
    background-color: transparent;
    color: var(--dew-text-main);
    border: 1px solid var(--dew-border-strong);
  }

  #shopify-section-{{ section.id }} .dew-btn-secondary:hover {
    background-color: var(--dew-bg-warm);
    border-color: var(--dew-text-main);
  }

  #shopify-section-{{ section.id }} .dew-btn-sm {
    padding: 0.6rem 1.2rem;
    font-size: 0.82rem;
  }

  #shopify-section-{{ section.id }} .dew-btn-lg {
    padding: 1.15rem 2.2rem;
    font-size: 1rem;
  }

  #shopify-section-{{ section.id }} .dew-btn-block {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .dew-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: var(--dew-radius-pill);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .dew-badge-peach {
    background-color: var(--dew-accent-soft);
    color: var(--dew-accent-peach);
    border: 1px solid rgba(200, 125, 101, 0.25);
  }

  #shopify-section-{{ section.id }} .dew-badge-sage {
    background-color: var(--dew-sage-soft);
    color: var(--dew-botanical-sage);
  }

  /* Marquee Announcement */
  #shopify-section-{{ section.id }} .dew-announcement {
    background-color: var(--dew-text-main);
    color: #ffffff;
    padding: 0.65rem 0;
    overflow: hidden;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  #shopify-section-{{ section.id }} .dew-marquee-track {
    display: flex;
    width: max-content;
    gap: 3rem;
    animation: dewMarqueeAnimation 26s linear infinite;
  }

  #shopify-section-{{ section.id }} .dew-marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .dew-marquee-divider {
    color: var(--dew-accent-peach);
    font-size: 0.65rem;
  }

  @keyframes dewMarqueeAnimation {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* Header */
  #shopify-section-{{ section.id }} .dew-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--dew-glass);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(230, 222, 211, 0.65);
    transition: var(--dew-transition);
  }

  #shopify-section-{{ section.id }} .dew-header.scrolled {
    background: rgba(250, 248, 245, 0.95);
    box-shadow: var(--dew-shadow-subtle);
  }

  #shopify-section-{{ section.id }} .dew-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
  }

  #shopify-section-{{ section.id }} .dew-brand-box {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .dew-brand-name {
    font-family: var(--dew-font-sans);
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--dew-text-main);
  }

  #shopify-section-{{ section.id }} .dew-brand-tag {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dew-text-muted);
    font-weight: 600;
    margin-top: -3px;
  }

  #shopify-section-{{ section.id }} .dew-main-nav .dew-nav-list {
    display: flex;
    gap: 2.2rem;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .dew-nav-link {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--dew-text-muted);
    position: relative;
  }

  #shopify-section-{{ section.id }} .dew-nav-link:hover {
    color: var(--dew-text-main);
  }

  #shopify-section-{{ section.id }} .dew-bag-trigger {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--dew-bg-warm);
    color: var(--dew-text-main);
    transition: var(--dew-transition);
  }

  #shopify-section-{{ section.id }} .dew-bag-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: var(--dew-accent-peach);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Hero Section */
  #shopify-section-{{ section.id }} .dew-hero-section {
    padding: 4.5rem 0 5rem;
    background: radial-gradient(circle at 80% 20%, rgba(244, 237, 228, 0.7) 0%, rgba(250, 248, 245, 1) 70%);
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .dew-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: 4rem;
  }

  #shopify-section-{{ section.id }} .dew-hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  #shopify-section-{{ section.id }} .dew-hero-rating-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background-color: #ffffff;
    border: 1px solid var(--dew-border-subtle);
    padding: 0.4rem 0.95rem;
    border-radius: var(--dew-radius-pill);
    box-shadow: var(--dew-shadow-subtle);
    width: fit-content;
  }

  #shopify-section-{{ section.id }} .dew-stars {
    color: #d88969;
    font-size: 0.85rem;
  }

  #shopify-section-{{ section.id }} .dew-hero-headline {
    font-family: var(--dew-font-editorial);
    font-size: 3.8rem;
    line-height: 1.08;
    font-weight: 400;
    color: var(--dew-text-main);
    letter-spacing: -0.01em;
  }

  #shopify-section-{{ section.id }} .dew-hero-headline em {
    font-style: italic;
    color: var(--dew-accent-peach);
  }

  #shopify-section-{{ section.id }} .dew-hero-desc {
    font-size: 1.1rem;
    color: var(--dew-text-muted);
    line-height: 1.7;
    max-width: 520px;
  }

  #shopify-section-{{ section.id }} .dew-hero-cta-box {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .dew-hero-price-tag {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .dew-price-main {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--dew-text-main);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .dew-price-strike {
    font-size: 0.95rem;
    color: var(--dew-text-light);
    text-decoration: line-through;
    margin-left: 0.4rem;
  }

  #shopify-section-{{ section.id }} .dew-price-save {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--dew-botanical-sage);
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .dew-hero-pledges {
    display: flex;
    gap: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--dew-border-subtle);
    margin-top: 1rem;
  }

  #shopify-section-{{ section.id }} .dew-pledge-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--dew-text-muted);
  }

  /* Hero Media Canvas */
  #shopify-section-{{ section.id }} .dew-canvas-main-wrap {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: var(--dew-radius-lg);
    overflow: hidden;
    box-shadow: var(--dew-shadow-card);
    background: var(--dew-bg-warm);
  }

  #shopify-section-{{ section.id }} .dew-hero-img-main {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  #shopify-section-{{ section.id }} .dew-floating-glass-pill {
    position: absolute;
    bottom: 2rem;
    left: -2rem;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    padding: 1rem 1.4rem;
    border-radius: var(--dew-radius-md);
    box-shadow: var(--dew-shadow-elevated);
    display: flex;
    align-items: center;
    gap: 1rem;
    animation: dewFloatMotion 4s ease-in-out infinite alternate;
  }

  @keyframes dewFloatMotion {
    0% { transform: translateY(0); }
    100% { transform: translateY(-8px); }
  }

  #shopify-section-{{ section.id }} .dew-pill-icon {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--dew-accent-soft);
    color: var(--dew-accent-peach);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
  }

  #shopify-section-{{ section.id }} .dew-floating-texture-orb {
    position: absolute;
    top: 2rem;
    right: -2rem;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    overflow: hidden;
    border: 4px solid #ffffff;
    box-shadow: var(--dew-shadow-elevated);
  }

  #shopify-section-{{ section.id }} .dew-floating-texture-orb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Clinical Strip */
  #shopify-section-{{ section.id }} .dew-clinical-strip {
    background-color: var(--dew-bg-warm);
    border-top: 1px solid var(--dew-border-subtle);
    border-bottom: 1px solid var(--dew-border-subtle);
    padding: 3.5rem 0;
  }

  #shopify-section-{{ section.id }} .dew-clinical-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .dew-clinical-num {
    font-family: var(--dew-font-editorial);
    font-size: 4rem;
    font-weight: 400;
    color: var(--dew-accent-peach);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .dew-clinical-headline {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--dew-text-main);
    margin-top: 0.35rem;
  }

  #shopify-section-{{ section.id }} .dew-clinical-sub {
    font-size: 0.88rem;
    color: var(--dew-text-muted);
    max-width: 280px;
    margin: 0.35rem auto 0;
  }

  /* Routine Section */
  #shopify-section-{{ section.id }} .dew-routine-section {
    padding: 6.5rem 0;
    background-color: var(--dew-bg-milk);
  }

  #shopify-section-{{ section.id }} .dew-section-head {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .dew-section-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--dew-accent-peach);
  }

  #shopify-section-{{ section.id }} .dew-section-title {
    font-family: var(--dew-font-editorial);
    font-size: 3rem;
    line-height: 1.15;
    color: var(--dew-text-main);
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .dew-routine-builder-box {
    background-color: #ffffff;
    border: 1px solid var(--dew-border-subtle);
    border-radius: var(--dew-radius-lg);
    padding: 2.5rem;
    box-shadow: var(--dew-shadow-card);
  }

  #shopify-section-{{ section.id }} .dew-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 3rem;
  }

  #shopify-section-{{ section.id }} .dew-step-card {
    position: relative;
    background-color: var(--dew-bg-milk);
    border: 1px solid var(--dew-border-subtle);
    border-radius: var(--dew-radius-md);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    transition: var(--dew-transition);
  }

  #shopify-section-{{ section.id }} .dew-step-card.active {
    border-color: var(--dew-accent-peach);
    box-shadow: 0 8px 24px rgba(200, 125, 101, 0.12);
    background-color: #ffffff;
  }

  #shopify-section-{{ section.id }} .dew-step-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  #shopify-section-{{ section.id }} .dew-step-checkbox {
    appearance: none;
    width: 20px;
    height: 20px;
    border: 2px solid var(--dew-border-strong);
    border-radius: 4px;
    cursor: pointer;
    position: relative;
    transition: var(--dew-transition);
  }

  #shopify-section-{{ section.id }} .dew-step-checkbox:checked {
    background-color: var(--dew-accent-peach);
    border-color: var(--dew-accent-peach);
  }

  #shopify-section-{{ section.id }} .dew-step-checkbox:checked::after {
    content: '✓';
    position: absolute;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  #shopify-section-{{ section.id }} .dew-step-media {
    aspect-ratio: 1/1;
    border-radius: var(--dew-radius-sm);
    overflow: hidden;
    background: var(--dew-bg-warm);
    margin-bottom: 1.25rem;
  }

  #shopify-section-{{ section.id }} .dew-step-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .dew-bundle-bar {
    background: var(--dew-bg-warm);
    border-radius: var(--dew-radius-md);
    padding: 1.75rem 2.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  #shopify-section-{{ section.id }} .dew-calc-final {
    font-size: 2rem;
    font-weight: 800;
    color: var(--dew-text-main);
  }

  /* Slider Section */
  #shopify-section-{{ section.id }} .dew-proof-section {
    padding: 6.5rem 0;
    background-color: var(--dew-bg-warm);
  }

  #shopify-section-{{ section.id }} .dew-slider-card {
    max-width: 960px;
    margin: 0 auto;
    background-color: #ffffff;
    border-radius: var(--dew-radius-lg);
    overflow: hidden;
    box-shadow: var(--dew-shadow-card);
    display: grid;
    grid-template-columns: 1.15fr 1fr;
  }

  #shopify-section-{{ section.id }} .dew-slider-pane {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    user-select: none;
  }

  #shopify-section-{{ section.id }} .dew-slider-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
  }

  #shopify-section-{{ section.id }} .dew-before-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    overflow: hidden;
    border-right: 2px solid #ffffff;
    z-index: 2;
    box-shadow: 2px 0 10px rgba(0, 0, 0, 0.2);
  }

  #shopify-section-{{ section.id }} .dew-before-wrap .dew-slider-img {
    width: 960px;
    max-width: none;
  }

  #shopify-section-{{ section.id }} .dew-slider-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #ffffff;
    color: var(--dew-text-main);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    cursor: ew-resize;
    border: 3px solid var(--dew-accent-peach);
  }

  /* Tint Switcher Section */
  #shopify-section-{{ section.id }} .dew-tint-section {
    padding: 6.5rem 0;
    background-color: var(--dew-bg-milk);
  }

  #shopify-section-{{ section.id }} .dew-tint-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 4rem;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .dew-swatches-group {
    display: flex;
    gap: 1rem;
    margin: 1rem 0;
  }

  #shopify-section-{{ section.id }} .dew-swatch-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

