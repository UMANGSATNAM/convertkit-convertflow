<!-- Interactive Script Engine -->
<script>
  (function() {
    const sectionId = "{{ section.id }}";
    const header = document.getElementById('dewHeader-' + sectionId);
    const stickyDock = document.getElementById('dewStickyDock-' + sectionId);
    
    // Header & Dock Scroll
    window.addEventListener('scroll', function() {
      if (header) {
        if (window.scrollY > 40) header.classList.add('scrolled');
        else header.classList.remove('scrolled');
      }
      if (stickyDock) {
        if (window.scrollY > 550) stickyDock.classList.add('visible');
        else stickyDock.classList.remove('visible');
      }
    });

    // 3-Step Routine Bundle Calculator
    const checkboxes = document.querySelectorAll('#shopify-section-' + sectionId + ' .dew-step-checkbox');
    const badge = document.getElementById('dewCalcBadge-' + sectionId);
    const countText = document.getElementById('dewCalcItemsText-' + sectionId);
    const savingsText = document.getElementById('dewCalcSavingsText-' + sectionId);
    const compPrice = document.getElementById('dewCalcComparePrice-' + sectionId);
    const finalPrice = document.getElementById('dewCalcFinalPrice-' + sectionId);
    const addBtn = document.getElementById('dewAddBundleBtn-' + sectionId);

    function updateCalc() {
      let count = 0;
      let sum = 0;

      checkboxes.forEach(function(cb) {
        const step = cb.getAttribute('data-step');
        const price = parseFloat(cb.getAttribute('data-price')) || 0;
        const card = document.getElementById('dewStepCard-' + sectionId + '-' + step);

        if (cb.checked) {
          count++;
          sum += price;
          if (card) card.classList.add('active');
        } else {
          if (card) card.classList.remove('active');
        }
      });

      let finalVal = sum;
      if (count === 3) {
        finalVal = 78;
        if (badge) badge.textContent = "FULL 3-STEP ROUTINE (30% OFF)";
        if (savingsText) savingsText.textContent = "You're saving $32.00 with the Routine Bundle!";
        if (compPrice) {
          compPrice.style.display = "inline";
          compPrice.textContent = "$" + sum.toFixed(2);
        }
        if (addBtn) addBtn.textContent = "Add Complete Routine to Bag";
      } else if (count === 2) {
        finalVal = Math.round(sum * 0.85);
        if (badge) badge.textContent = "DUO ROUTINE (15% OFF)";
        if (savingsText) savingsText.textContent = "You're saving $" + (sum - finalVal).toFixed(2) + " with Duo discount!";
        if (compPrice) {
          compPrice.style.display = "inline";
          compPrice.textContent = "$" + sum.toFixed(2);
        }
        if (addBtn) addBtn.textContent = "Add Custom Routine to Bag";
      } else if (count === 1) {
        if (badge) badge.textContent = "INDIVIDUAL PRODUCT";
        if (savingsText) savingsText.textContent = "";
        if (compPrice) compPrice.style.display = "none";
        if (addBtn) addBtn.textContent = "Add Selected Product to Bag";
      } else {
        if (badge) badge.textContent = "SELECT AT LEAST 1 STEP";
        if (savingsText) savingsText.textContent = "";
        if (compPrice) compPrice.style.display = "none";
        if (addBtn) addBtn.textContent = "Select Products Above";
      }

      if (countText) countText.textContent = count + " Product" + (count === 1 ? "" : "s") + " Selected";
      if (finalPrice) finalPrice.textContent = "$" + finalVal.toFixed(2);
    }

    checkboxes.forEach(function(cb) {
      cb.addEventListener('change', updateCalc);
    });

    if (addBtn) {
      addBtn.addEventListener('click', function() {
        alert('Added custom routine bundle to your Shopify bag!');
      });
    }

    // Draggable Glow Slider
    const sliderPane = document.getElementById('dewSliderPane-' + sectionId);
    const beforeWrap = document.getElementById('dewBeforeWrap-' + sectionId);
    const handle = document.getElementById('dewSliderHandle-' + sectionId);

    if (sliderPane && beforeWrap && handle) {
      let isSliding = false;
      function setPos(clientX) {
        const rect = sliderPane.getBoundingClientRect();
        let pct = ((clientX - rect.left) / rect.width) * 100;
        if (pct < 0) pct = 0;
        if (pct > 100) pct = 100;
        beforeWrap.style.width = pct + '%';
        handle.style.left = pct + '%';
      }

      sliderPane.addEventListener('mousedown', function(e) { isSliding = true; setPos(e.clientX); });
      window.addEventListener('mousemove', function(e) { if (isSliding) setPos(e.clientX); });
      window.addEventListener('mouseup', function() { isSliding = false; });

      sliderPane.addEventListener('touchstart', function(e) { isSliding = true; if (e.touches[0]) setPos(e.touches[0].clientX); }, { passive: true });
      window.addEventListener('touchmove', function(e) { if (isSliding && e.touches[0]) setPos(e.touches[0].clientX); }, { passive: true });
      window.addEventListener('touchend', function() { isSliding = false; });
    }

    // Swatches Switcher
    const swatches = document.querySelectorAll('#shopify-section-' + sectionId + ' .dew-swatch-btn');
    const tintImg = document.getElementById('dewTintImg-' + sectionId);
    const tintTitle = document.getElementById('dewTintTitle-' + sectionId);
    const tintDesc = document.getElementById('dewTintDesc-' + sectionId);

    swatches.forEach(function(btn) {
      btn.addEventListener('click', function() {
        swatches.forEach(function(s) { s.classList.remove('active'); });
        btn.classList.add('active');

        const name = btn.getAttribute('data-name');
        const img = btn.getAttribute('data-img');
        const desc = btn.getAttribute('data-desc');

        if (tintTitle) tintTitle.textContent = name;
        if (tintDesc) tintDesc.textContent = desc;
        if (tintImg && img) {
          tintImg.style.opacity = '0.3';
          setTimeout(function() {
            tintImg.src = img;
            tintImg.style.opacity = '1';
          }, 150);
        }
      });
    });

    // FAQ Accordion
    const faqHeaders = document.querySelectorAll('#shopify-section-' + sectionId + ' .dew-faq-header');
    faqHeaders.forEach(function(h) {
      h.addEventListener('click', function() {
        const item = h.parentElement;
        const isActive = item.classList.contains('active');

        document.querySelectorAll('#shopify-section-' + sectionId + ' .dew-faq-item').forEach(function(el) {
          el.classList.remove('active');
          const icon = el.querySelector('span:last-child');
          if (icon) icon.textContent = '+';
        });

        if (!isActive) {
          item.classList.add('active');
          const icon = item.querySelector('span:last-child');
          if (icon) icon.textContent = '×';
        }
      });
    });
  })();
</script>

