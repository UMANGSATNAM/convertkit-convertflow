{% if block.settings.enable_sticky_atc %}
<div class="cf-sticky-atc">
  {% if block.settings.show_image and product.featured_image %}
    <img src="{{ product.featured_image | img_url: '100x' }}" class="cf-sticky-atc-img" alt="{{ product.title | escape }}">
  {% endif %}
  <div class="cf-sticky-atc-info">
    <h4 class="cf-sticky-atc-title">{{ product.title | truncate: 35 }}</h4>
    <p class="cf-sticky-atc-price">{{ product.price | money }}</p>
  </div>
  <button class="cf-sticky-atc-btn" style="background-color: {{ block.settings.btn_bg_color }}; color: {{ block.settings.btn_text_color }};">
    {{ block.settings.btn_text }}
  </button>
</div>
{% endif %}

<script src="{{ 'convertflow.js' | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ 'convertflow.css' | asset_url }}">

{% schema %}
{
  "name": "Sticky Add To Cart",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "checkbox", "id": "enable_sticky_atc", "label": "Enable Sticky ATC", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Show Product Image", "default": true },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "ADD TO CART" },
    { "type": "color", "id": "btn_bg_color", "label": "Button Background", "default": "#000000" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text", "default": "#ffffff" }
  ]
}
{% endschema %}
