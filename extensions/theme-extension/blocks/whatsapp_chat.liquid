{% if block.settings.enable_whatsapp %}
{% assign wa_message = block.settings.default_message | url_encode %}
<a href="https://wa.me/{{ block.settings.whatsapp_number }}?text={{ wa_message }}" target="_blank" class="cf-whatsapp-widget" style="background-color: {{ block.settings.bg_color }};">
