    <path d="M17.487 14.288c-.302-.15-1.786-.88-2.062-.98-.276-.1-.476-.15-.678.15-.202.302-.78 1.01-.956 1.22-.176.21-.352.236-.654.086-1.834-.916-3.155-2.03-4.32-3.956-.176-.302-.018-.466.132-.616.136-.136.302-.352.454-.528.15-.176.202-.302.302-.502.1-.2.05-.376-.026-.526-.076-.15-.678-1.636-.928-2.24-.246-.59-.496-.51-.678-.52-.176-.008-.376-.008-.578-.008-.2 0-.528.076-.804.376-.276.302-1.054 1.03-1.054 2.514 0 1.484 1.08 2.918 1.23 3.12.15.2 2.128 3.25 5.152 4.554.72.31 1.28.496 1.718.636.72.23 1.376.196 1.888.12.576-.086 1.786-.73 2.038-1.436.252-.706.252-1.312.176-1.436-.076-.126-.276-.202-.578-.352z"/>
  </svg>
</a>
{% endif %}

<link rel="stylesheet" href="{{ 'convertflow.css' | asset_url }}">

{% schema %}
{
  "name": "WhatsApp Chat Widget",
  "target": "section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    { "type": "checkbox", "id": "enable_whatsapp", "label": "Enable WhatsApp Widget", "default": true },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp Number (with Country Code)", "default": "919876543210" },
    { "type": "text", "id": "default_message", "label": "Default Message", "default": "Hi! I need some help with my order." },
    { "type": "color", "id": "bg_color", "label": "Widget Color", "default": "#25D366" }
  ]
}
{% endschema %}
