{% if block.settings.enable_reviews %}
<div class="cf-reviews-widget" style="margin-top: 20px;">
  <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 15px;">
    <h3 style="margin: 0; font-size: 18px;">Customer Reviews</h3>
    <div style="display:flex; color: #FFC107;">
      <svg width="20" height="20" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor"/></svg>
      <svg width="20" height="20" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor"/></svg>
      <svg width="20" height="20" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor"/></svg>
      <svg width="20" height="20" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor"/></svg>
      <svg width="20" height="20" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor"/></svg>
    </div>
    <span style="font-size: 14px; color: #666;">(4.9/5 based on 124 reviews)</span>
  </div>

  <div class="cf-reviews-list" style="display: grid; gap: 15px;">
    <!-- Dummy Review 1 -->
    <div style="background: #f9f9f9; padding: 15px; border-radius: 8px;">
      <div style="display:flex; justify-content: space-between; align-items:center; margin-bottom: 8px;">
        <strong style="font-size: 15px;">Rahul S.</strong>
        <span style="font-size: 12px; color: #888;">2 days ago</span>
      </div>
      <div style="display:flex; color: #FFC107; width: 14px; height: 14px; margin-bottom: 8px;">
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor"/></svg>
      </div>
      <p style="margin: 0; font-size: 14px; color: #444;">Excellent product quality! The delivery was super fast and exactly as described in the pictures.</p>
    </div>

    <!-- Dummy Review 2 -->
    <div style="background: #f9f9f9; padding: 15px; border-radius: 8px;">
      <div style="display:flex; justify-content: space-between; align-items:center; margin-bottom: 8px;">
        <strong style="font-size: 15px;">Priya M.</strong>
        <span style="font-size: 12px; color: #888;">1 week ago</span>
      </div>
      <div style="display:flex; color: #FFC107; width: 14px; height: 14px; margin-bottom: 8px;">
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="currentColor"/></svg>
      </div>
      <p style="margin: 0; font-size: 14px; color: #444;">Really impressed with the packaging. Will definitely buy again.</p>
    </div>
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Reviews Widget",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "checkbox", "id": "enable_reviews", "label": "Enable Reviews Widget", "default": true }
  ]
}
{% endschema %}
