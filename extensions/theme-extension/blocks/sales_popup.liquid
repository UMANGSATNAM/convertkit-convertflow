{% if block.settings.enable_sales_popup %}
<div class="cf-sales-popup" data-delay="{{ block.settings.popup_delay }}">
  <img src="https://cdn.shopify.com/s/images/admin/no-image-large.gif" class="cf-sales-popup-img" alt="Product Image">
  <div class="cf-sales-popup-content">
    <p style="margin:0;"><strong>Someone from {{ block.settings.demo_city }}</strong></p>
    <p style="margin:0; color:#555;">Purchased a product {{ block.settings.demo_time }}</p>
  </div>
</div>
{% endif %}

<script src="{{ 'convertflow.js' | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ 'convertflow.css' | asset_url }}">

{% schema %}
{
  "name": "Sales Popup Notification",
  "target": "section",
  "enabled_on": {
    "templates": ["product", "index"]
  },
  "settings": [
    { "type": "checkbox", "id": "enable_sales_popup", "label": "Enable Sales Popup", "default": true },
    { "type": "number", "id": "popup_delay", "label": "Delay before showing (ms)", "default": 3000 },
    { "type": "text", "id": "demo_city", "label": "Fallback City", "default": "Mumbai" },
    { "type": "text", "id": "demo_time", "label": "Fallback Time", "default": "15 minutes ago" }
  ]
}
{% endschema %}
