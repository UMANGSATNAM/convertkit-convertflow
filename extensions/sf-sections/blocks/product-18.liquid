{%- assign product = all_products[section.settings.product] | default: product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  /* Bold Brutalism Aesthetic */
  .sf-pdp-{{ section.id }} {
    --primary-color: {{ section.settings.primary_color }};
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --heading-color: {{ section.settings.heading_color }};
    --border-color: #000000;
    --border-width: 4px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    color: var(--text-color);
    background: var(--bg-color);
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }
  .sf-pdp-{{ section.id }} * { box-sizing: inherit; }
  .sf-pdp-container { max-width: 1400px; margin: 0 auto; border: var(--border-width) solid var(--border-color); background: #fff; box-shadow: 12px 12px 0 0 var(--border-color); }
  
  .sf-pdp-grid { display: grid; grid-template-columns: 1fr; }
  @media(min-width: 900px) {
    .sf-pdp-grid { grid-template-columns: 1.2fr 1fr; }
  }

  /* Media */
  .sf-media-wrapper { border-bottom: var(--border-width) solid var(--border-color); }
  @media(min-width: 900px) { .sf-media-wrapper { border-right: var(--border-width) solid var(--border-color); border-bottom: none; } }
  
  .sf-gallery-main { width: 100%; height: 100%; }
  .sf-gallery-main img { width: 100%; height: 100%; display: block; object-fit: cover; min-height: 500px; }
  
  .sf-gallery-thumbs { display: grid; grid-template-columns: repeat(4, 1fr); border-top: var(--border-width) solid var(--border-color); }
  .sf-thumb-item { cursor: pointer; border-right: var(--border-width) solid var(--border-color); transition: filter 0.2s; filter: grayscale(100%); }
  .sf-thumb-item:last-child { border-right: none; }
  .sf-thumb-item.active, .sf-thumb-item:hover { filter: grayscale(0%); }
  .sf-thumb-item img { width: 100%; height: 100%; object-fit: cover; display: block; aspect-ratio: 1/1; }

  /* Details */
  .sf-details-wrapper { padding: 40px; display: flex; flex-direction: column; background: {{ section.settings.bg_color }}; }
  
  .sf-pdp-vendor { font-size: 1rem; font-weight: 700; text-transform: uppercase; color: var(--heading-color); border-bottom: var(--border-width) solid var(--border-color); padding-bottom: 12px; margin-bottom: 24px; display: inline-block; }
  .sf-pdp-title { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; font-size: 3.5rem; font-weight: 900; color: var(--heading-color); margin: 0 0 24px 0; line-height: 1; text-transform: uppercase; }
  
  .sf-pdp-price-wrapper { display: flex; align-items: baseline; gap: 16px; margin-bottom: 40px; background: var(--primary-color); padding: 12px 24px; border: var(--border-width) solid var(--border-color); transform: rotate(-2deg); width: max-content; }
  .sf-pdp-price { font-size: 2.5rem; font-weight: 900; color: #000; }
  .sf-pdp-compare-price { font-size: 1.25rem; color: #000; text-decoration: line-through; font-weight: 700; opacity: 0.7; }

  /* Description */
  .sf-description { font-size: 1.1rem; line-height: 1.6; color: var(--text-color); margin-bottom: 40px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-weight: 600; }
  
  /* Form */
  .sf-variant-group { margin-bottom: 32px; }
  .sf-variant-label { display: block; margin-bottom: 12px; font-size: 1.1rem; font-weight: 800; text-transform: uppercase; color: var(--heading-color); }
  .sf-variant-options { display: flex; flex-wrap: wrap; gap: 16px; }
  .sf-variant-option { padding: 12px 24px; border: var(--border-width) solid var(--border-color); background: #fff; cursor: pointer; font-size: 1rem; font-weight: 800; color: var(--text-color); transition: all 0.1s; text-transform: uppercase; }
  .sf-variant-option:hover { transform: translate(-4px, -4px); box-shadow: 4px 4px 0 0 var(--border-color); }
  .sf-variant-option.selected { background: var(--border-color); color: #fff; }
  
  .sf-action-group { display: flex; gap: 24px; margin-bottom: 24px; margin-top: auto; }
  .sf-quantity-selector { display: flex; align-items: center; border: var(--border-width) solid var(--border-color); width: 140px; background: #fff; }
  .sf-qty-btn { width: 40px; height: 100%; background: none; border: none; font-size: 1.5rem; font-weight: 900; cursor: pointer; color: var(--text-color); }
  .sf-qty-input { flex: 1; border: none; text-align: center; font-size: 1.25rem; font-weight: 900; appearance: textfield; padding: 0; }
  .sf-qty-input::-webkit-inner-spin-button { display: none; }
  
  .sf-add-to-cart { flex: 1; background: var(--primary-color); color: #000; border: var(--border-width) solid var(--border-color); font-size: 1.5rem; font-weight: 900; text-transform: uppercase; cursor: pointer; transition: all 0.1s; height: 70px; font-family: ui-monospace, SFMono-Regular, monospace; }
  .sf-add-to-cart:hover { transform: translate(-6px, -6px); box-shadow: 6px 6px 0 0 var(--border-color); }

  /* Recently Viewed */
  .sf-recently-viewed { margin-top: 80px; padding: 40px; border-top: var(--border-width) solid var(--border-color); background: #fff; }
  .sf-rv-title { font-size: 2.5rem; font-weight: 900; text-transform: uppercase; margin-bottom: 40px; color: var(--heading-color); display: inline-block; background: var(--primary-color); padding: 8px 16px; border: var(--border-width) solid var(--border-color); }
  .sf-rv-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  @media(min-width: 768px) { .sf-rv-grid { grid-template-columns: repeat(4, 1fr); } }
  .sf-rv-card { display: flex; flex-direction: column; text-decoration: none; color: inherit; border: var(--border-width) solid var(--border-color); transition: all 0.1s; background: {{ section.settings.bg_color }}; }
  .sf-rv-card:hover { transform: translate(-8px, -8px); box-shadow: 8px 8px 0 0 var(--border-color); }
  .sf-rv-card img { width: 100%; aspect-ratio: 1/1; object-fit: cover; border-bottom: var(--border-width) solid var(--border-color); }
  .sf-rv-card-info { padding: 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .sf-rv-card-title { font-family: -apple-system, sans-serif; font-size: 1rem; font-weight: 900; margin: 0; color: var(--heading-color); text-transform: uppercase; }
  .sf-rv-card-price { font-size: 1.1rem; font-weight: 900; color: #000; background: var(--primary-color); padding: 4px 8px; width: max-content; border: 2px solid #000; }
</style>

<div class="sf-pdp-{{ section.id }}">
  <div class="sf-pdp-container">
    {% if product != blank %}
      <div class="sf-pdp-grid">
        
        <!-- Media Gallery -->
        <div class="sf-media-wrapper">
          <div class="sf-gallery-main" id="sf-main-image-{{ section.id }}">
            <img src="{{ current_variant.featured_image | default: product.featured_image | img_url: '1200x' }}" alt="{{ product.title | escape }}" id="sf-image-el-{{ section.id }}">
          </div>
          {% if product.images.size > 1 %}
            <div class="sf-gallery-thumbs">
              {% for image in product.images limit:4 %}
                <div class="sf-thumb-item {% if forloop.first %}active{% endif %}" data-img-url="{{ image | img_url: '1200x' }}" onclick="sfSwitchImage('{{ section.id }}', this)">
                  <img src="{{ image | img_url: '400x400', crop: 'center' }}" alt="{{ image.alt | escape }}">
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        <!-- Product Details -->
        <div class="sf-details-wrapper">
          <div class="sf-pdp-vendor">{{ product.vendor }}</div>
          <h1 class="sf-pdp-title">{{ product.title }}</h1>
          
          <div class="sf-pdp-price-wrapper">
            <span class="sf-pdp-price" id="sf-price-{{ section.id }}">{{ current_variant.price | money }}</span>
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="sf-pdp-compare-price" id="sf-compare-price-{{ section.id }}">{{ current_variant.compare_at_price | money }}</span>
            {% endif %}
          </div>

          <div class="sf-description">
            {{ product.description | strip_html | truncatewords: 50 }}
          </div>

          <form method="post" action="/cart/add" id="sf-form-{{ section.id }}" accept-charset="UTF-8" enctype="multipart/form-data">
            <input type="hidden" name="form_type" value="product">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="id" id="sf-variant-id-{{ section.id }}" value="{{ current_variant.id }}">

            {% unless product.has_only_default_variant %}
              <div class="sf-variants-container">
                {% for option in product.options_with_values %}
                  <div class="sf-variant-group">
                    <span class="sf-variant-label">{{ option.name }}</span>
                    <div class="sf-variant-options" data-option-index="option{{ forloop.index }}">
                      {% for value in option.values %}
                        <div class="sf-variant-option {% if option.selected_value == value %}selected{% endif %}" 
                             data-value="{{ value | escape }}"
                             onclick="sfSelectOption('{{ section.id }}', this)">
                          {{ value }}
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endunless %}

            <div class="sf-action-group">
              <div class="sf-quantity-selector">
                <button type="button" class="sf-qty-btn" onclick="sfUpdateQty('{{ section.id }}', -1)">−</button>
                <input type="number" class="sf-qty-input" name="quantity" id="sf-qty-{{ section.id }}" value="1" min="1">
                <button type="button" class="sf-qty-btn" onclick="sfUpdateQty('{{ section.id }}', 1)">+</button>
              </div>
              <button type="submit" class="sf-add-to-cart" id="sf-atc-{{ section.id }}" {% unless current_variant.available %}disabled{% endunless %}>
                {% if current_variant.available %}Add To Cart{% else %}Sold Out{% endif %}
              </button>
            </div>
          </form>

        </div>
      </div>
      
      <!-- Recently Viewed Section -->
      {% if section.settings.show_recently_viewed %}
      <div class="sf-recently-viewed" id="sf-rv-{{ section.id }}" style="display: none;">
        <h3 class="sf-rv-title">{{ section.settings.rv_title }}</h3>
        <div class="sf-rv-grid" id="sf-rv-grid-{{ section.id }}"></div>
      </div>
      
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          if (typeof window.sfTrackRecentlyViewed === 'function') {
            window.sfTrackRecentlyViewed('{{ product.handle }}');
            window.sfRenderRecentlyViewed('{{ section.id }}', '{{ product.handle }}', '{{ cart.currency.symbol }}');
          }
        });
      </script>
      {% endif %}

      <script>
        window.sfVariants_{{ section.id | replace: '-', '_' }} = [
          {% for variant in product.variants %}
            {
              id: {{ variant.id }},
              title: {{ variant.title | json }},
              option1: {{ variant.option1 | json }},
              option2: {{ variant.option2 | json }},
              option3: {{ variant.option3 | json }},
              price: '{{ variant.price | money }}',
              compare_at_price: {% if variant.compare_at_price %}'{{ variant.compare_at_price | money }}'{% else %}null{% endif %},
              available: {{ variant.available }},
              featured_image: {% if variant.featured_image %}'{{ variant.featured_image | img_url: "1200x" }}'{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ];
      </script>

    {% else %}
      <div style="text-align: center; padding: 100px 20px;">
        <p style="font-size: 1.5rem; font-weight: 900; text-transform: uppercase;">Select a product in the theme editor.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product Block 18",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Select Product" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#f4f4f0" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#000000" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#000000" },
    { "type": "color", "id": "primary_color", "label": "Primary Accent Color", "default": "#ffff00" },
    { "type": "header", "content": "Recently Viewed" },
    { "type": "checkbox", "id": "show_recently_viewed", "label": "Enable Recently Viewed", "default": true },
    { "type": "text", "id": "rv_title", "label": "Recently Viewed Title", "default": "You Also Looked At" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 60 },
    { "type": "range", "id": "padding_horizontal", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Horizontal", "default": 20 }
  ]
}
{% endschema %}
