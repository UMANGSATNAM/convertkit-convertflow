{%- assign product = all_products[section.settings.product] | default: product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  .sf-pdp-{{ section.id }} {
    --primary-color: {{ section.settings.primary_color }};
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --heading-color: {{ section.settings.heading_color }};
    --border-color: #cbd5e1;
    --star-color: #fbbf24;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--text-color);
    background: var(--bg-color);
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }
  .sf-pdp-{{ section.id }} * { box-sizing: inherit; }
  .sf-pdp-container { max-width: 1400px; margin: 0 auto; }
  
  .sf-pdp-grid { display: grid; grid-template-columns: 1fr; gap: 40px; }
  @media(min-width: 900px) {
    .sf-pdp-grid { grid-template-columns: 1fr 1fr; gap: 60px; }
  }

  /* Media */
  .sf-media-wrapper { display: flex; flex-direction: column; gap: 16px; }
  .sf-gallery-main { width: 100%; border-radius: 8px; overflow: hidden; background: #f8fafc; }
  .sf-gallery-main img { width: 100%; height: auto; display: block; object-fit: cover; }
  .sf-gallery-thumbs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .sf-thumb-item { border-radius: 4px; overflow: hidden; cursor: pointer; border: 2px solid transparent; transition: all 0.2s ease; }
  .sf-thumb-item.active { border-color: var(--primary-color); }
  .sf-thumb-item img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 1/1; }

  /* Details */
  .sf-rating-stars { color: var(--star-color); display: flex; align-items: center; gap: 4px; font-size: 1.1rem; margin-bottom: 12px; }
  .sf-rating-stars svg { width: 18px; height: 18px; fill: currentColor; }
  .sf-rating-text { color: var(--heading-color); font-size: 0.9rem; margin-left: 8px; font-weight: 500; text-decoration: underline; cursor: pointer; }

  .sf-pdp-title { font-size: 2.5rem; font-weight: 700; color: var(--heading-color); margin: 0 0 16px 0; line-height: 1.1; }
  .sf-pdp-price-wrapper { display: flex; align-items: center; gap: 12px; margin-bottom: 32px; }
  .sf-pdp-price { font-size: 1.5rem; font-weight: 700; color: var(--heading-color); }
  .sf-pdp-compare-price { font-size: 1.125rem; color: #94a3b8; text-decoration: line-through; }

  /* Social Proof Highlight Box */
  .sf-review-highlight {
    background: #f8fafc;
    border-left: 4px solid var(--star-color);
    padding: 20px 24px;
    margin-bottom: 32px;
    border-radius: 0 8px 8px 0;
  }
  .sf-rh-text { font-size: 1rem; font-style: italic; color: var(--heading-color); margin-bottom: 8px; line-height: 1.5; }
  .sf-rh-author { font-size: 0.9rem; color: #64748b; font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .sf-rh-author-badge { background: #10b981; color: #fff; padding: 2px 6px; border-radius: 4px; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em; }

  /* Form */
  .sf-variant-group { margin-bottom: 24px; }
  .sf-variant-label { display: block; font-weight: 600; margin-bottom: 12px; font-size: 0.95rem; }
  .sf-variant-options { display: flex; flex-wrap: wrap; gap: 10px; }
  .sf-variant-option { padding: 10px 20px; border: 1px solid var(--border-color); border-radius: 4px; background: #fff; cursor: pointer; font-size: 0.95rem; transition: all 0.2s; }
  .sf-variant-option.selected { border-color: var(--primary-color); background: var(--primary-color); color: #fff; }
  
  .sf-action-group { display: flex; gap: 16px; margin-bottom: 32px; height: 56px; }
  .sf-quantity-selector { display: flex; align-items: center; border: 1px solid var(--border-color); border-radius: 4px; width: 120px; }
  .sf-qty-btn { width: 40px; height: 100%; background: none; border: none; font-size: 1.25rem; cursor: pointer; color: var(--text-color); }
  .sf-qty-input { flex: 1; height: 100%; border: none; text-align: center; font-size: 1rem; appearance: textfield; padding: 0; }
  .sf-qty-input::-webkit-inner-spin-button { display: none; }
  
  .sf-add-to-cart { flex: 1; background: var(--primary-color); color: #fff; border: none; border-radius: 4px; font-size: 1.125rem; font-weight: 600; cursor: pointer; transition: background 0.2s; }
  .sf-add-to-cart:hover { opacity: 0.9; }

  /* Fake live viewing */
  .sf-live-viewers { display: flex; align-items: center; gap: 8px; font-size: 0.9rem; color: #ef4444; font-weight: 600; margin-bottom: 16px; }
  .sf-live-dot { width: 8px; height: 8px; background: #ef4444; border-radius: 50%; animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); } 70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); } 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); } }
</style>

<div class="sf-pdp-{{ section.id }}">
  <div class="sf-pdp-container">
    {% if product != blank %}
      <div class="sf-pdp-grid">
        
        <!-- Media Gallery -->
        <div class="sf-media-wrapper">
          <div class="sf-gallery-main" id="sf-main-image-{{ section.id }}">
            <img src="{{ current_variant.featured_image | default: product.featured_image | img_url: '1000x' }}" alt="{{ product.title | escape }}" id="sf-image-el-{{ section.id }}">
          </div>
          {% if product.images.size > 1 %}
            <div class="sf-gallery-thumbs">
              {% for image in product.images limit:4 %}
                <div class="sf-thumb-item {% if forloop.first %}active{% endif %}" data-img-url="{{ image | img_url: '1000x' }}" onclick="sfSwitchImage('{{ section.id }}', this)">
                  <img src="{{ image | img_url: '150x150', crop: 'center' }}" alt="{{ image.alt | escape }}">
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        <!-- Product Details -->
        <div class="sf-details-wrapper">
          
          <div class="sf-rating-stars">
            <svg viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
            <svg viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
            <svg viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
            <svg viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
            <svg viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
            <span class="sf-rating-text">4.9/5 (128 Reviews)</span>
          </div>

          <h1 class="sf-pdp-title">{{ product.title }}</h1>
          
          <div class="sf-live-viewers">
            <div class="sf-live-dot"></div>
            <span>12 people are looking at this right now</span>
          </div>

          <div class="sf-pdp-price-wrapper">
            <span class="sf-pdp-price" id="sf-price-{{ section.id }}">{{ current_variant.price | money }}</span>
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="sf-pdp-compare-price" id="sf-compare-price-{{ section.id }}">{{ current_variant.compare_at_price | money }}</span>
            {% endif %}
          </div>

          <!-- Social Proof Review Box -->
          <div class="sf-review-highlight">
            <p class="sf-rh-text">"Absolutely transformed my daily routine. The quality is unmatched and shipping was incredibly fast. Highly recommended!"</p>
            <div class="sf-rh-author">
              Sarah M. <span class="sf-rh-author-badge">Verified Buyer</span>
            </div>
          </div>

          <form method="post" action="/cart/add" id="sf-form-{{ section.id }}" accept-charset="UTF-8" enctype="multipart/form-data">
            <input type="hidden" name="form_type" value="product">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="id" id="sf-variant-id-{{ section.id }}" value="{{ current_variant.id }}">

            {% unless product.has_only_default_variant %}
              <div class="sf-variants-container">
                {% for option in product.options_with_values %}
                  <div class="sf-variant-group">
                    <span class="sf-variant-label">{{ option.name }}</span>
                    <div class="sf-variant-options" data-option-index="option{{ forloop.index }}">
                      {% for value in option.values %}
                        <div class="sf-variant-option {% if option.selected_value == value %}selected{% endif %}" 
                             data-value="{{ value | escape }}"
                             onclick="sfSelectOption('{{ section.id }}', this)">
                          {{ value }}
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endunless %}

            <div class="sf-action-group">
              <div class="sf-quantity-selector">
                <button type="button" class="sf-qty-btn" onclick="sfUpdateQty('{{ section.id }}', -1)">−</button>
                <input type="number" class="sf-qty-input" name="quantity" id="sf-qty-{{ section.id }}" value="1" min="1">
                <button type="button" class="sf-qty-btn" onclick="sfUpdateQty('{{ section.id }}', 1)">+</button>
              </div>
              <button type="submit" class="sf-add-to-cart" id="sf-atc-{{ section.id }}" {% unless current_variant.available %}disabled{% endunless %}>
                {% if current_variant.available %}Add to Cart{% else %}Out of Stock{% endif %}
              </button>
            </div>
          </form>

          <div style="font-size: 1rem; color: #475569; line-height: 1.6;">
            {{ product.description }}
          </div>
        </div>
      </div>
      
      <script>
        window.sfVariants_{{ section.id | replace: '-', '_' }} = [
          {% for variant in product.variants %}
            {
              id: {{ variant.id }},
              title: {{ variant.title | json }},
              option1: {{ variant.option1 | json }},
              option2: {{ variant.option2 | json }},
              option3: {{ variant.option3 | json }},
              price: '{{ variant.price | money }}',
              compare_at_price: {% if variant.compare_at_price %}'{{ variant.compare_at_price | money }}'{% else %}null{% endif %},
              available: {{ variant.available }},
              featured_image: {% if variant.featured_image %}'{{ variant.featured_image | img_url: "1000x" }}'{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ];
      </script>

    {% else %}
      <div style="text-align: center; padding: 100px 20px; border: 1px dashed var(--border-color);">
        <p style="font-size: 1.25rem; color: #64748b;">Select a product in the theme editor.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product Social Proof",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Select Product" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#334155" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#0f172a" },
    { "type": "color", "id": "primary_color", "label": "Primary Button Color", "default": "#2563eb" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 60 },
    { "type": "range", "id": "padding_horizontal", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Horizontal", "default": 20 }
  ]
}
{% endschema %}
