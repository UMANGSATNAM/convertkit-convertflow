{%- assign product = all_products[section.settings.product] | default: product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  .sf-pdp-{{ section.id }} {
    --primary-color: {{ section.settings.primary_color }};
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --heading-color: {{ section.settings.heading_color }};
    --border-color: #e5e5e5;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--text-color);
    background: var(--bg-color);
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }
  .sf-pdp-{{ section.id }} * { box-sizing: inherit; }
  .sf-pdp-container { max-width: 1600px; margin: 0 auto; }
  
  /* Lookbook Layout: Masonry left, Details sticky right */
  .sf-pdp-grid { display: grid; grid-template-columns: 1fr; gap: 40px; }
  @media(min-width: 992px) {
    .sf-pdp-grid { grid-template-columns: 1.6fr 1fr; gap: 80px; align-items: start; }
    .sf-details-wrapper { position: sticky; top: 40px; }
  }

  /* Masonry Gallery */
  .sf-gallery-main {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .sf-gallery-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 4px;
    background: #f9fafb;
  }
  .sf-gallery-main img:first-child { grid-column: 1 / -1; aspect-ratio: 16/9; }
  .sf-gallery-main img:not(:first-child) { aspect-ratio: 4/5; }
  .sf-gallery-thumbs { display: none; }

  /* Details */
  .sf-pdp-vendor { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.15em; color: #6b7280; margin-bottom: 16px; }
  .sf-pdp-title { font-size: 2.5rem; font-weight: 300; color: var(--heading-color); margin: 0 0 16px 0; letter-spacing: -0.02em; }
  .sf-pdp-price-wrapper { display: flex; align-items: center; gap: 16px; margin-bottom: 32px; padding-bottom: 32px; border-bottom: 1px solid var(--border-color); }
  .sf-pdp-price { font-size: 1.5rem; font-weight: 500; color: var(--heading-color); }
  .sf-pdp-compare-price { font-size: 1.125rem; color: #9ca3af; text-decoration: line-through; }

  /* Form */
  .sf-variant-group { margin-bottom: 32px; }
  .sf-variant-label { display: flex; justify-content: space-between; font-weight: 500; margin-bottom: 12px; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .sf-variant-options { display: flex; flex-wrap: wrap; gap: 12px; }
  .sf-variant-option { padding: 12px 24px; border: 1px solid var(--border-color); background: transparent; cursor: pointer; font-size: 0.95rem; transition: all 0.2s; }
  .sf-variant-option.selected { border-color: var(--heading-color); background: var(--heading-color); color: #fff; }
  
  .sf-action-group { display: flex; flex-direction: column; gap: 16px; margin-bottom: 40px; margin-top: 40px; }
  .sf-quantity-selector { display: none; /* Hide quantity for lookbook elegance */ }
  .sf-add-to-cart { width: 100%; background: var(--primary-color); color: #fff; border: none; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.1em; cursor: pointer; transition: opacity 0.3s; height: 60px; }
  .sf-add-to-cart:hover { opacity: 0.8; }

  /* Minimal Description */
  .sf-desc-text { font-size: 1rem; line-height: 1.8; color: #4b5563; margin-bottom: 32px; font-weight: 300; }

  /* Recently Viewed */
  .sf-recently-viewed { margin-top: 100px; padding-top: 60px; border-top: 1px solid var(--border-color); }
  .sf-rv-title { font-size: 1.5rem; text-transform: uppercase; letter-spacing: 0.1em; text-align: center; margin-bottom: 60px; font-weight: 300; }
  .sf-rv-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media(min-width: 768px) { .sf-rv-grid { grid-template-columns: repeat(4, 1fr); gap: 32px; } }
  .sf-rv-card { display: block; text-decoration: none; color: inherit; transition: opacity 0.3s; }
  .sf-rv-card:hover { opacity: 0.7; }
  .sf-rv-card img { width: 100%; aspect-ratio: 3/4; object-fit: cover; margin-bottom: 16px; }
  .sf-rv-card-title { font-size: 0.9rem; margin: 0 0 8px; color: var(--heading-color); font-weight: 400; }
  .sf-rv-card-price { font-weight: 400; font-size: 0.9rem; color: #6b7280; }
</style>

<div class="sf-pdp-{{ section.id }}">
  <div class="sf-pdp-container">
    {% if product != blank %}
      <div class="sf-pdp-grid">
        
        <!-- Media Masonry -->
        <div class="sf-media-wrapper">
          <div class="sf-gallery-main" id="sf-main-image-{{ section.id }}">
            {% for image in product.images limit:5 %}
              <img src="{{ image | img_url: '1200x' }}" alt="{{ image.alt | escape }}" {% if forloop.first %}id="sf-image-el-{{ section.id }}"{% endif %}>
            {% endfor %}
          </div>
        </div>

        <!-- Details -->
        <div class="sf-details-wrapper">
          <div class="sf-pdp-vendor">{{ product.vendor }}</div>
          <h1 class="sf-pdp-title">{{ product.title }}</h1>
          
          <div class="sf-pdp-price-wrapper">
            <span class="sf-pdp-price" id="sf-price-{{ section.id }}">{{ current_variant.price | money }}</span>
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="sf-pdp-compare-price" id="sf-compare-price-{{ section.id }}">{{ current_variant.compare_at_price | money }}</span>
            {% endif %}
          </div>

          <div class="sf-desc-text">
            {{ product.description | strip_html | truncatewords: 40 }}
          </div>

          <form method="post" action="/cart/add" id="sf-form-{{ section.id }}" accept-charset="UTF-8" enctype="multipart/form-data">
            <input type="hidden" name="form_type" value="product">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="id" id="sf-variant-id-{{ section.id }}" value="{{ current_variant.id }}">
            <input type="hidden" name="quantity" value="1">

            {% unless product.has_only_default_variant %}
              <div class="sf-variants-container">
                {% for option in product.options_with_values %}
                  <div class="sf-variant-group">
                    <div class="sf-variant-label">
                      <span>{{ option.name }}</span>
                    </div>
                    <div class="sf-variant-options" data-option-index="option{{ forloop.index }}">
                      {% for value in option.values %}
                        <div class="sf-variant-option {% if option.selected_value == value %}selected{% endif %}" 
                             data-value="{{ value | escape }}"
                             onclick="sfSelectOption('{{ section.id }}', this)">
                          {{ value }}
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endunless %}

            <div class="sf-action-group">
              <button type="submit" class="sf-add-to-cart" id="sf-atc-{{ section.id }}" {% unless current_variant.available %}disabled{% endunless %}>
                {% if current_variant.available %}Add to Bag{% else %}Out of Stock{% endif %}
              </button>
            </div>
          </form>

          {% if section.settings.shipping_info != blank %}
            <div style="margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--border-color);">
              <span style="display:block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--heading-color); margin-bottom: 8px;">Delivery & Returns</span>
              <p style="font-size: 0.95rem; color: #6b7280; line-height: 1.6; margin: 0;">{{ section.settings.shipping_info }}</p>
            </div>
          {% endif %}
        </div>
      </div>
      
      <!-- Recently Viewed Section -->
      {% if section.settings.show_recently_viewed %}
      <div class="sf-recently-viewed" id="sf-rv-{{ section.id }}" style="display: none;">
        <h3 class="sf-rv-title">{{ section.settings.rv_title }}</h3>
        <div class="sf-rv-grid" id="sf-rv-grid-{{ section.id }}"></div>
      </div>
      
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          if (typeof window.sfTrackRecentlyViewed === 'function') {
            window.sfTrackRecentlyViewed('{{ product.handle }}');
            window.sfRenderRecentlyViewed('{{ section.id }}', '{{ product.handle }}', '{{ cart.currency.symbol }}');
          }
        });
      </script>
      {% endif %}

      <script>
        window.sfVariants_{{ section.id | replace: '-', '_' }} = [
          {% for variant in product.variants %}
            {
              id: {{ variant.id }},
              title: {{ variant.title | json }},
              option1: {{ variant.option1 | json }},
              option2: {{ variant.option2 | json }},
              option3: {{ variant.option3 | json }},
              price: '{{ variant.price | money }}',
              compare_at_price: {% if variant.compare_at_price %}'{{ variant.compare_at_price | money }}'{% else %}null{% endif %},
              available: {{ variant.available }},
              featured_image: {% if variant.featured_image %}'{{ variant.featured_image | img_url: "1200x" }}'{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ];
      </script>

    {% else %}
      <div style="text-align: center; padding: 100px 20px;">
        <p style="font-size: 1.25rem; color: #6b7280; font-weight: 300;">Select a product in the theme editor.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product Lookbook",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Select Product" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#374151" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#111827" },
    { "type": "color", "id": "primary_color", "label": "Primary Color", "default": "#000000" },
    { "type": "header", "content": "Information Settings" },
    { "type": "text", "id": "shipping_info", "label": "Shipping Info", "default": "Free worldwide shipping on orders over $150." },
    { "type": "header", "content": "Recently Viewed" },
    { "type": "checkbox", "id": "show_recently_viewed", "label": "Enable Recently Viewed", "default": true },
    { "type": "text", "id": "rv_title", "label": "Recently Viewed Title", "default": "Curated For You" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "padding_horizontal", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Horizontal", "default": 40 }
  ]
}
{% endschema %}
