{%- assign product = all_products[section.settings.product] | default: product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  .sf-pdp-{{ section.id }} {
    --primary-color: {{ section.settings.primary_color }};
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --heading-color: {{ section.settings.heading_color }};
    --border-color: #e5e5e5;
    --radius: 0px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--text-color);
    background: var(--bg-color);
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }
  .sf-pdp-{{ section.id }} * { box-sizing: inherit; }
  .sf-pdp-container { max-width: 1600px; margin: 0 auto; }
  
  /* Collection Grid Layout (Thumbnails on Left) */
  .sf-pdp-grid { display: grid; grid-template-columns: 1fr; gap: 40px; }
  @media(min-width: 900px) {
    .sf-pdp-grid { grid-template-columns: 1.5fr 1fr; gap: 80px; align-items: start; }
  }

  /* Gallery (Thumbs Left, Main Right) */
  .sf-media-wrapper {
    display: flex;
    gap: 20px;
    flex-direction: column-reverse;
  }
  @media(min-width: 768px) {
    .sf-media-wrapper { flex-direction: row; }
  }
  
  .sf-gallery-thumbs {
    display: flex;
    flex-direction: row;
    gap: 12px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  @media(min-width: 768px) {
    .sf-gallery-thumbs {
      flex-direction: column;
      flex: 0 0 100px;
      overflow-y: auto;
      max-height: 700px;
    }
  }
  .sf-gallery-thumbs::-webkit-scrollbar { display: none; }
  
  .sf-thumb-item {
    flex: 0 0 80px;
    height: 100px;
    cursor: pointer;
    border: 1px solid var(--border-color);
    transition: border-color 0.2s;
  }
  .sf-thumb-item.active { border-color: var(--primary-color); border-width: 2px; }
  .sf-thumb-item img { width: 100%; height: 100%; object-fit: cover; }

  .sf-gallery-main {
    flex: 1;
    background: #f9fafb;
    border: 1px solid var(--border-color);
  }
  .sf-gallery-main img { width: 100%; height: auto; display: block; object-fit: cover; }

  /* Details */
  .sf-pdp-vendor { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: #6b7280; margin-bottom: 8px; }
  .sf-pdp-title { font-size: 2.25rem; font-weight: 400; color: var(--heading-color); margin: 0 0 16px 0; }
  .sf-pdp-price-wrapper { display: flex; align-items: center; gap: 12px; margin-bottom: 32px; }
  .sf-pdp-price { font-size: 1.5rem; font-weight: 500; color: var(--heading-color); }
  .sf-pdp-compare-price { font-size: 1.125rem; color: #9ca3af; text-decoration: line-through; }
  .sf-badge { background: #000; color: #fff; padding: 4px 8px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }

  /* Form */
  .sf-variant-group { margin-bottom: 24px; }
  .sf-variant-label { display: block; font-weight: 500; margin-bottom: 12px; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .sf-variant-options { display: flex; flex-wrap: wrap; gap: 10px; }
  .sf-variant-option { padding: 12px 16px; border: 1px solid var(--border-color); background: #fff; cursor: pointer; font-size: 0.9rem; transition: all 0.2s; }
  .sf-variant-option.selected { border-color: var(--heading-color); background: var(--heading-color); color: #fff; }
  
  .sf-action-group { display: flex; gap: 16px; margin-bottom: 32px; height: 56px; }
  .sf-quantity-selector { display: flex; align-items: center; border: 1px solid var(--border-color); width: 120px; }
  .sf-qty-btn { width: 40px; height: 100%; background: none; border: none; font-size: 1.25rem; cursor: pointer; color: var(--text-color); }
  .sf-qty-input { flex: 1; height: 100%; border: none; text-align: center; font-size: 1rem; appearance: textfield; padding: 0; }
  .sf-qty-input::-webkit-inner-spin-button { display: none; }
  .sf-add-to-cart { flex: 1; background: var(--primary-color); color: #fff; border: none; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; cursor: pointer; transition: opacity 0.2s; }
  .sf-add-to-cart:hover { opacity: 0.9; }

  /* Accordions */
  .sf-accordion { border-top: 1px solid var(--border-color); }
  .sf-accordion-item { border-bottom: 1px solid var(--border-color); }
  .sf-accordion-header { width: 100%; padding: 20px 0; display: flex; justify-content: space-between; align-items: center; background: none; border: none; cursor: pointer; font-size: 1rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; color: var(--heading-color); }
  .sf-accordion-icon { font-size: 1.5rem; line-height: 1; font-weight: 300; transition: transform 0.3s; }
  .sf-accordion-header.active .sf-accordion-icon { transform: rotate(45deg); }
  .sf-accordion-content { max-height: 0; overflow: hidden; transition: max-height 0.3s ease, padding 0.3s ease; font-size: 0.95rem; line-height: 1.6; color: #4b5563; }
  .sf-accordion-header.active + .sf-accordion-content { max-height: 2000px; padding-bottom: 20px; }

  /* Recently Viewed */
  .sf-recently-viewed { margin-top: 80px; padding-top: 60px; border-top: 1px solid var(--border-color); }
  .sf-rv-title { font-size: 1.5rem; text-transform: uppercase; letter-spacing: 0.05em; text-align: center; margin-bottom: 40px; font-weight: 400; }
  .sf-rv-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; background: var(--border-color); border: 1px solid var(--border-color); }
  @media(min-width: 768px) { .sf-rv-grid { grid-template-columns: repeat(4, 1fr); } }
  .sf-rv-card { display: block; text-decoration: none; color: inherit; background: var(--bg-color); padding: 16px; transition: background 0.2s; }
  .sf-rv-card:hover { background: #f9fafb; }
  .sf-rv-card img { width: 100%; aspect-ratio: 1/1; object-fit: cover; margin-bottom: 12px; }
  .sf-rv-card-title { font-size: 0.9rem; margin: 0 0 4px; color: var(--heading-color); }
  .sf-rv-card-price { font-weight: 500; font-size: 0.9rem; color: var(--primary-color); }
</style>

<div class="sf-pdp-{{ section.id }}">
  <div class="sf-pdp-container">
    {% if product != blank %}
      <div class="sf-pdp-grid">
        
        <!-- Media Gallery -->
        <div class="sf-media-wrapper">
          {% if product.images.size > 1 %}
            <div class="sf-gallery-thumbs">
              {% for image in product.images %}
                <div class="sf-thumb-item {% if forloop.first %}active{% endif %}" data-img-url="{{ image | img_url: '1000x' }}" onclick="sfSwitchImage('{{ section.id }}', this)">
                  <img src="{{ image | img_url: '150x150', crop: 'center' }}" alt="{{ image.alt | escape }}">
                </div>
              {% endfor %}
            </div>
          {% endif %}
          <div class="sf-gallery-main" id="sf-main-image-{{ section.id }}">
            <img src="{{ current_variant.featured_image | default: product.featured_image | img_url: '1000x' }}" alt="{{ product.title | escape }}" id="sf-image-el-{{ section.id }}">
          </div>
        </div>

        <!-- Product Details -->
        <div class="sf-details-wrapper">
          <div class="sf-pdp-vendor">{{ product.vendor }}</div>
          <h1 class="sf-pdp-title">{{ product.title }}</h1>
          
          <div class="sf-pdp-price-wrapper">
            <span class="sf-pdp-price" id="sf-price-{{ section.id }}">{{ current_variant.price | money }}</span>
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="sf-pdp-compare-price" id="sf-compare-price-{{ section.id }}">{{ current_variant.compare_at_price | money }}</span>
              <span class="sf-badge" id="sf-sale-badge-{{ section.id }}">Sale</span>
            {% endif %}
          </div>

          <form method="post" action="/cart/add" id="sf-form-{{ section.id }}" accept-charset="UTF-8" enctype="multipart/form-data">
            <input type="hidden" name="form_type" value="product">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="id" id="sf-variant-id-{{ section.id }}" value="{{ current_variant.id }}">

            {% unless product.has_only_default_variant %}
              <div class="sf-variants-container">
                {% for option in product.options_with_values %}
                  <div class="sf-variant-group">
                    <span class="sf-variant-label">{{ option.name }}</span>
                    <div class="sf-variant-options" data-option-index="option{{ forloop.index }}">
                      {% for value in option.values %}
                        <div class="sf-variant-option {% if option.selected_value == value %}selected{% endif %}" 
                             data-value="{{ value | escape }}"
                             onclick="sfSelectOption('{{ section.id }}', this)">
                          {{ value }}
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endunless %}

            <div class="sf-action-group">
              <div class="sf-quantity-selector">
                <button type="button" class="sf-qty-btn" onclick="sfUpdateQty('{{ section.id }}', -1)">−</button>
                <input type="number" class="sf-qty-input" name="quantity" id="sf-qty-{{ section.id }}" value="1" min="1">
                <button type="button" class="sf-qty-btn" onclick="sfUpdateQty('{{ section.id }}', 1)">+</button>
              </div>
              <button type="submit" class="sf-add-to-cart" id="sf-atc-{{ section.id }}" {% unless current_variant.available %}disabled{% endunless %}>
                {% if current_variant.available %}Add to Bag{% else %}Sold Out{% endif %}
              </button>
            </div>
          </form>

          <!-- Accordions -->
          <div class="sf-accordion">
            <div class="sf-accordion-item">
              <button class="sf-accordion-header active" onclick="sfToggleAccordion(this)">
                <span>Details</span>
                <span class="sf-accordion-icon">+</span>
              </button>
              <div class="sf-accordion-content" style="max-height: 2000px; padding-bottom: 20px;">
                {{ product.description }}
              </div>
            </div>
            {% if section.settings.shipping_info != blank %}
            <div class="sf-accordion-item">
              <button class="sf-accordion-header" onclick="sfToggleAccordion(this)">
                <span>Delivery</span>
                <span class="sf-accordion-icon">+</span>
              </button>
              <div class="sf-accordion-content">
                {{ section.settings.shipping_info }}
              </div>
            </div>
            {% endif %}
          </div>
          
        </div>
      </div>
      
      <!-- Recently Viewed Section -->
      {% if section.settings.show_recently_viewed %}
      <div class="sf-recently-viewed" id="sf-rv-{{ section.id }}" style="display: none;">
        <h3 class="sf-rv-title">{{ section.settings.rv_title }}</h3>
        <div class="sf-rv-grid" id="sf-rv-grid-{{ section.id }}"></div>
      </div>
      
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          if (typeof window.sfTrackRecentlyViewed === 'function') {
            window.sfTrackRecentlyViewed('{{ product.handle }}');
            window.sfRenderRecentlyViewed('{{ section.id }}', '{{ product.handle }}', '{{ cart.currency.symbol }}');
          }
        });
      </script>
      {% endif %}

      <script>
        window.sfVariants_{{ section.id | replace: '-', '_' }} = [
          {% for variant in product.variants %}
            {
              id: {{ variant.id }},
              title: {{ variant.title | json }},
              option1: {{ variant.option1 | json }},
              option2: {{ variant.option2 | json }},
              option3: {{ variant.option3 | json }},
              price: '{{ variant.price | money }}',
              compare_at_price: {% if variant.compare_at_price %}'{{ variant.compare_at_price | money }}'{% else %}null{% endif %},
              available: {{ variant.available }},
              featured_image: {% if variant.featured_image %}'{{ variant.featured_image | img_url: "1000x" }}'{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ];
      </script>

    {% else %}
      <div style="text-align: center; padding: 100px 20px; border: 1px solid var(--border-color);">
        <p style="font-size: 1.25rem; color: #64748b;">Select a product in the theme editor.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product Collection Grid",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Select Product" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1f2937" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#111827" },
    { "type": "color", "id": "primary_color", "label": "Primary Button Color", "default": "#000000" },
    { "type": "header", "content": "Information Settings" },
    { "type": "richtext", "id": "shipping_info", "label": "Shipping & Returns Info", "default": "<p>Standard shipping: 3-5 business days.</p>" },
    { "type": "header", "content": "Recently Viewed" },
    { "type": "checkbox", "id": "show_recently_viewed", "label": "Enable Recently Viewed", "default": true },
    { "type": "text", "id": "rv_title", "label": "Recently Viewed Title", "default": "More Like This" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 60 },
    { "type": "range", "id": "padding_horizontal", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Horizontal", "default": 20 }
  ]
}
{% endschema %}
