<div class="sf-conversion-section" id="conversion-14" style="padding: 60px 20px; text-align: center; background-color: {{ section.settings.bg_color }};">
  <h2 style="color: {{ section.settings.heading_color }}; font-size: 2rem; margin-bottom: 20px;">{{ section.settings.title }}</h2>
  <p style="color: {{ section.settings.text_color }}; max-width: 800px; margin: 0 auto; line-height: 1.6;">
    This is a generated premium component for the Conversion Component 14. It features highly optimized CSS and structural layout tailored for high-converting e-commerce experiences.
  </p>
</div>

{% schema %}
{
  "name": "Conversion Component 14",
  "target": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Headline", "default": "Conversion Component 14" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#444444" }
  ]
}
{% endschema %}
