{%- assign product = all_products[section.settings.product] | default: product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  .sf-pdp-{{ section.id }} {
    --primary-color: {{ section.settings.primary_color }};
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --heading-color: {{ section.settings.heading_color }};
    --border-color: #cbd5e1;
    --radius: 8px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--text-color);
    background: var(--bg-color);
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }
  .sf-pdp-{{ section.id }} * { box-sizing: inherit; }
  .sf-pdp-container { max-width: 1200px; margin: 0 auto; }
  
  .sf-pdp-grid { display: grid; grid-template-columns: 1fr; gap: 40px; }
  @media(min-width: 900px) {
    .sf-pdp-grid { grid-template-columns: 1fr 1.1fr; gap: 60px; }
  }

  /* Gallery */
  .sf-gallery-main { border-radius: var(--radius); overflow: hidden; margin-bottom: 16px; background: #f8fafc; border: 1px solid var(--border-color); }
  .sf-gallery-main img { width: 100%; height: auto; display: block; object-fit: cover; }
  .sf-gallery-thumbs { display: flex; gap: 12px; overflow-x: auto; scrollbar-width: none; }
  .sf-gallery-thumbs::-webkit-scrollbar { display: none; }
  .sf-thumb-item { flex: 0 0 calc(25% - 10px); border-radius: 4px; overflow: hidden; cursor: pointer; border: 2px solid transparent; opacity: 0.6; transition: all 0.2s ease; }
  .sf-thumb-item.active, .sf-thumb-item:hover { opacity: 1; border-color: var(--primary-color); }
  .sf-thumb-item img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 1/1; }

  /* Details */
  .sf-pdp-title { font-size: 2.25rem; line-height: 1.2; color: var(--heading-color); margin: 0 0 12px 0; font-weight: 700; }
  .sf-pdp-price-wrapper { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .sf-pdp-price { font-size: 1.5rem; font-weight: 700; color: var(--primary-color); }
  .sf-pdp-compare-price { font-size: 1.125rem; color: #94a3b8; text-decoration: line-through; }

  /* Subscription UI */
  .sf-sub-container {
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 32px;
  }
  .sf-sub-option {
    display: flex;
    align-items: center;
    padding: 16px 20px;
    background: #fff;
    cursor: pointer;
    transition: background 0.2s;
  }
  .sf-sub-option:not(:last-child) {
    border-bottom: 1px solid var(--border-color);
  }
  .sf-sub-option.selected {
    background: #f8fafc;
  }
  .sf-sub-radio {
    width: 20px;
    height: 20px;
    border: 2px solid var(--border-color);
    border-radius: 50%;
    margin-right: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sf-sub-option.selected .sf-sub-radio { border-color: var(--primary-color); }
  .sf-sub-option.selected .sf-sub-radio::after {
    content: ''; width: 10px; height: 10px; background: var(--primary-color); border-radius: 50%;
  }
  .sf-sub-details { flex: 1; }
  .sf-sub-title { font-weight: 700; color: var(--heading-color); font-size: 1rem; display: flex; justify-content: space-between; margin-bottom: 4px; }
  .sf-sub-desc { font-size: 0.85rem; color: #64748b; }
  .sf-sub-badge { background: var(--heading-color); color: #fff; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; font-weight: 700; margin-left: 8px; text-transform: uppercase; }
  
  .sf-sub-frequencies {
    padding: 12px 20px 20px 56px;
    background: #f8fafc;
    display: none;
  }
  .sf-sub-option.selected + .sf-sub-frequencies {
    display: block;
    border-bottom: 1px solid var(--border-color);
  }
  .sf-sub-select {
    width: 100%;
    padding: 10px;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    font-size: 0.9rem;
    color: var(--heading-color);
  }

  /* Form & CTA */
  .sf-variant-group { margin-bottom: 24px; }
  .sf-variant-label { display: block; font-weight: 600; margin-bottom: 8px; font-size: 0.95rem; }
  .sf-variant-options { display: flex; flex-wrap: wrap; gap: 8px; }
  .sf-variant-option { padding: 8px 16px; border: 1px solid var(--border-color); border-radius: 4px; background: #fff; cursor: pointer; font-size: 0.95rem; }
  .sf-variant-option.selected { border-color: var(--heading-color); background: var(--heading-color); color: #fff; }

  .sf-action-group { display: flex; gap: 16px; margin-bottom: 32px; height: 56px; }
  .sf-quantity-selector { display: flex; align-items: center; border: 1px solid var(--border-color); border-radius: var(--radius); width: 120px; background: #fff; }
  .sf-qty-btn { width: 40px; height: 100%; background: none; border: none; font-size: 1.25rem; cursor: pointer; color: var(--text-color); }
  .sf-qty-input { flex: 1; height: 100%; border: none; text-align: center; font-size: 1rem; appearance: textfield; padding: 0; }
  .sf-qty-input::-webkit-inner-spin-button { display: none; }
  
  .sf-add-to-cart { flex: 1; background: var(--primary-color); color: #fff; border: none; border-radius: var(--radius); font-size: 1.125rem; font-weight: 700; cursor: pointer; transition: background 0.2s; }
  .sf-add-to-cart:hover { opacity: 0.9; }

  /* Perks */
  .sf-perks { display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px; padding: 20px; background: #f1f5f9; border-radius: var(--radius); }
  .sf-perk-item { display: flex; align-items: center; gap: 12px; font-size: 0.9rem; font-weight: 500; color: var(--heading-color); }
  .sf-perk-icon { color: var(--primary-color); }
</style>

<div class="sf-pdp-{{ section.id }}">
  <div class="sf-pdp-container">
    {% if product != blank %}
      <div class="sf-pdp-grid">
        
        <!-- Media Gallery -->
        <div class="sf-media-wrapper">
          <div class="sf-gallery-main" id="sf-main-image-{{ section.id }}">
            <img src="{{ current_variant.featured_image | default: product.featured_image | img_url: '1000x' }}" alt="{{ product.title | escape }}" id="sf-image-el-{{ section.id }}">
          </div>
          {% if product.images.size > 1 %}
            <div class="sf-gallery-thumbs">
              {% for image in product.images %}
                <div class="sf-thumb-item {% if forloop.first %}active{% endif %}" data-img-url="{{ image | img_url: '1000x' }}" onclick="sfSwitchImage('{{ section.id }}', this)">
                  <img src="{{ image | img_url: '150x150', crop: 'center' }}" alt="{{ image.alt | escape }}">
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        <!-- Product Details -->
        <div class="sf-details-wrapper">
          <h1 class="sf-pdp-title">{{ product.title }}</h1>
          
          <div class="sf-pdp-price-wrapper">
            <span class="sf-pdp-price" id="sf-price-{{ section.id }}">{{ current_variant.price | money }}</span>
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="sf-pdp-compare-price" id="sf-compare-price-{{ section.id }}">{{ current_variant.compare_at_price | money }}</span>
            {% endif %}
          </div>

          <div style="font-size: 1rem; color: #475569; line-height: 1.6; margin-bottom: 24px;">
            {{ product.description | strip_html | truncatewords: 30 }}
          </div>

          <form method="post" action="/cart/add" id="sf-form-{{ section.id }}" accept-charset="UTF-8" enctype="multipart/form-data">
            <input type="hidden" name="form_type" value="product">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="id" id="sf-variant-id-{{ section.id }}" value="{{ current_variant.id }}">
            <input type="hidden" name="selling_plan" id="sf-selling-plan-{{ section.id }}" value="">

            {% unless product.has_only_default_variant %}
              <div class="sf-variants-container">
                {% for option in product.options_with_values %}
                  <div class="sf-variant-group">
                    <span class="sf-variant-label">{{ option.name }}</span>
                    <div class="sf-variant-options" data-option-index="option{{ forloop.index }}">
                      {% for value in option.values %}
                        <div class="sf-variant-option {% if option.selected_value == value %}selected{% endif %}" 
                             data-value="{{ value | escape }}"
                             onclick="sfSelectOption('{{ section.id }}', this)">
                          {{ value }}
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endunless %}

            <!-- Subscription UI (Mock implementation for visual design) -->
            <div class="sf-sub-container">
              <div class="sf-sub-option selected" id="sf-sub-opt-subscribe-{{ section.id }}" onclick="sfToggleSubscription('{{ section.id }}', 'subscribe')">
                <div class="sf-sub-radio"></div>
                <div class="sf-sub-details">
                  <div class="sf-sub-title">Subscribe & Save <span class="sf-sub-badge">Save 15%</span></div>
                  <div class="sf-sub-desc">Auto-delivered. Cancel anytime.</div>
                </div>
              </div>
              <div class="sf-sub-frequencies" id="sf-sub-freq-{{ section.id }}" style="display:block;">
                <label style="display:block; margin-bottom:6px; font-size:0.85rem; font-weight:600;">Delivery Frequency</label>
                <select class="sf-sub-select">
                  <option value="1_month">Every 1 Month</option>
                  <option value="2_months">Every 2 Months</option>
                  <option value="3_months">Every 3 Months</option>
                </select>
              </div>
              
              <div class="sf-sub-option" id="sf-sub-opt-onetime-{{ section.id }}" onclick="sfToggleSubscription('{{ section.id }}', 'onetime')">
                <div class="sf-sub-radio"></div>
                <div class="sf-sub-details">
                  <div class="sf-sub-title">One-time purchase</div>
                  <div class="sf-sub-desc">Standard price</div>
                </div>
              </div>
            </div>

            <div class="sf-action-group">
              <div class="sf-quantity-selector">
                <button type="button" class="sf-qty-btn" onclick="sfUpdateQty('{{ section.id }}', -1)">−</button>
                <input type="number" class="sf-qty-input" name="quantity" id="sf-qty-{{ section.id }}" value="1" min="1">
                <button type="button" class="sf-qty-btn" onclick="sfUpdateQty('{{ section.id }}', 1)">+</button>
              </div>
              <button type="submit" class="sf-add-to-cart" id="sf-atc-{{ section.id }}" {% unless current_variant.available %}disabled{% endunless %}>
                {% if current_variant.available %}Add to Cart{% else %}Sold Out{% endif %}
              </button>
            </div>
            
            <div class="sf-perks">
              <div class="sf-perk-item">
                <svg class="sf-perk-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                Cancel or pause subscription anytime
              </div>
              <div class="sf-perk-item">
                <svg class="sf-perk-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                Secure 1-Click Checkout
              </div>
            </div>
          </form>
        </div>
      </div>

      <script>
        window.sfVariants_{{ section.id | replace: '-', '_' }} = [
          {% for variant in product.variants %}
            {
              id: {{ variant.id }},
              title: {{ variant.title | json }},
              option1: {{ variant.option1 | json }},
              option2: {{ variant.option2 | json }},
              option3: {{ variant.option3 | json }},
              price: '{{ variant.price | money }}',
              compare_at_price: {% if variant.compare_at_price %}'{{ variant.compare_at_price | money }}'{% else %}null{% endif %},
              available: {{ variant.available }},
              featured_image: {% if variant.featured_image %}'{{ variant.featured_image | img_url: "1000x" }}'{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ];

        function sfToggleSubscription(sectionId, type) {
          var subOpt = document.getElementById('sf-sub-opt-subscribe-' + sectionId);
          var oneOpt = document.getElementById('sf-sub-opt-onetime-' + sectionId);
          var freqDiv = document.getElementById('sf-sub-freq-' + sectionId);
          
          if(type === 'subscribe') {
            subOpt.classList.add('selected');
            oneOpt.classList.remove('selected');
            freqDiv.style.display = 'block';
            // In a real app, set the selling_plan ID here
          } else {
            subOpt.classList.remove('selected');
            oneOpt.classList.add('selected');
            freqDiv.style.display = 'none';
            document.getElementById('sf-selling-plan-' + sectionId).value = '';
          }
        }
      </script>

    {% else %}
      <div style="text-align: center; padding: 100px 20px; border: 1px dashed var(--border-color);">
        <p style="font-size: 1.25rem; color: #64748b;">Select a product in the theme editor.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product Subscription Hero",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Select Product" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#334155" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#0f172a" },
    { "type": "color", "id": "primary_color", "label": "Primary Button Color", "default": "#000000" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 60 },
    { "type": "range", "id": "padding_horizontal", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Horizontal", "default": 20 }
  ]
}
{% endschema %}
