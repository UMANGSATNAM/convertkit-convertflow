<div class="sf-hero" style="background-color: {{ section.settings.bg_color }}">
  <h1>{{ section.settings.headline }}</h1>
  <p>{{ section.settings.subheadline }}</p>
  <a href="{{ section.settings.link }}" class="sf-btn">{{ section.settings.button_text }}</a>
</div>

{% schema %}
{
  "name": "Festive Hero",
  "target": "section",
  "settings": [
    { "type": "text", "id": "headline", "label": "Headline", "default": "Festive Sale is Live!" },
    { "type": "text", "id": "subheadline", "label": "Sub-headline", "default": "Up to 50% off." },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Shop Now" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" }
  ]
}
{% endschema %}
