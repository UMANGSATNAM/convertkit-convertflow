{%- assign product = all_products[section.settings.product] | default: product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  .sf-pdp-{{ section.id }} {
    --primary-color: {{ section.settings.primary_color }};
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --heading-color: {{ section.settings.heading_color }};
    --highlight: {{ section.settings.highlight_color }};
    --border-color: #e5e7eb;
    --radius: 16px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--text-color);
    background: var(--bg-color);
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }
  .sf-pdp-{{ section.id }} * {
    box-sizing: inherit;
  }
  .sf-pdp-container {
    max-width: 1400px;
    margin: 0 auto;
  }
  /* Detail Highlight Layout (Split Screen) */
  .sf-pdp-grid {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  @media(min-width: 992px) {
    .sf-pdp-grid {
      flex-direction: row;
      gap: 0;
      background: #fff;
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: 0 20px 40px -10px rgba(0,0,0,0.08);
      border: 1px solid var(--border-color);
    }
    .sf-media-wrapper {
      flex: 1.2;
      background: var(--highlight);
      padding: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .sf-details-wrapper {
      flex: 1;
      padding: 60px;
    }
  }

  /* Gallery */
  .sf-gallery-main {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 24px;
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
  }
  .sf-gallery-main img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .sf-gallery-thumbs {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: none;
    justify-content: center;
  }
  .sf-gallery-thumbs::-webkit-scrollbar {
    display: none;
  }
  .sf-thumb-item {
    flex: 0 0 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    cursor: pointer;
    border: 3px solid transparent;
    opacity: 0.6;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
  }
  .sf-thumb-item.active, .sf-thumb-item:hover {
    opacity: 1;
    border-color: var(--primary-color);
    transform: scale(1.1);
  }
  .sf-thumb-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Product Meta */
  .sf-pdp-vendor {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--primary-color);
    margin-bottom: 12px;
    font-weight: 700;
  }
  .sf-pdp-title {
    font-size: 2.75rem;
    line-height: 1.1;
    color: var(--heading-color);
    margin: 0 0 20px 0;
    font-weight: 800;
  }
  .sf-pdp-price-wrapper {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
  }
  .sf-pdp-price {
    font-size: 2rem;
    font-weight: 800;
    color: var(--heading-color);
  }
  .sf-pdp-compare-price {
    font-size: 1.25rem;
    color: #9ca3af;
    text-decoration: line-through;
  }
  .sf-badge {
    background: #10b981;
    color: white;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    box-shadow: 0 4px 6px -1px rgba(16, 185, 129, 0.3);
  }

  /* Form & Variants */
  .sf-variant-group {
    margin-bottom: 28px;
  }
  .sf-variant-label {
    display: block;
    font-weight: 700;
    margin-bottom: 12px;
    font-size: 1rem;
    color: var(--heading-color);
  }
  .sf-variant-options {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .sf-variant-option {
    padding: 12px 20px;
    border: 2px solid var(--border-color);
    border-radius: 8px;
    background: #f9fafb;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    transition: all 0.2s;
    user-select: none;
    color: #4b5563;
  }
  .sf-variant-option.selected {
    border-color: var(--primary-color);
    background: var(--primary-color);
    color: #fff;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }
  .sf-variant-option.disabled {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  /* Quantity & CTA */
  .sf-action-group {
    display: flex;
    gap: 20px;
    margin-bottom: 40px;
    align-items: stretch;
  }
  .sf-quantity-selector {
    display: flex;
    align-items: center;
    border: 2px solid var(--border-color);
    border-radius: 8px;
    background: #f9fafb;
    height: 60px;
  }
  .sf-qty-btn {
    width: 48px;
    height: 100%;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--heading-color);
  }
  .sf-qty-input {
    width: 50px;
    height: 100%;
    border: none;
    text-align: center;
    font-size: 1.125rem;
    font-weight: 700;
    appearance: textfield;
    padding: 0;
    background: transparent;
  }
  .sf-qty-input::-webkit-inner-spin-button {
    display: none;
  }
  .sf-add-to-cart {
    flex: 1;
    background: var(--primary-color);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 1.25rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 60px;
    box-shadow: 0 10px 20px -5px rgba(0,0,0,0.2);
  }
  .sf-add-to-cart:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 25px -5px rgba(0,0,0,0.3);
  }
  .sf-add-to-cart:disabled {
    background: #cbd5e1;
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
  }

  /* Description highlight */
  .sf-desc-highlight {
    background: #f8fafc;
    border-left: 4px solid var(--primary-color);
    padding: 24px;
    border-radius: 0 8px 8px 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: #334155;
    margin-bottom: 32px;
  }

  /* Recently Viewed */
  .sf-recently-viewed {
    margin-top: 100px;
  }
  .sf-rv-title {
    font-size: 2rem;
    font-weight: 800;
    text-align: center;
    margin-bottom: 48px;
  }
  .sf-rv-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }
  @media(min-width: 768px) {
    .sf-rv-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .sf-rv-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s;
  }
  .sf-rv-card:hover {
    transform: translateY(-8px);
  }
  .sf-rv-card img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    border-radius: 50%;
    margin-bottom: 20px;
    box-shadow: 0 10px 20px -5px rgba(0,0,0,0.1);
  }
  .sf-rv-card-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0 0 8px;
    color: var(--heading-color);
  }
  .sf-rv-card-price {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--primary-color);
  }
</style>

<div class="sf-pdp-{{ section.id }}">
  <div class="sf-pdp-container">
    {% if product != blank %}
      <div class="sf-pdp-grid">
        
        <!-- Media Gallery -->
        <div class="sf-media-wrapper">
          <div style="width:100%; max-width:600px;">
            <div class="sf-gallery-main" id="sf-main-image-{{ section.id }}">
              <img src="{{ current_variant.featured_image | default: product.featured_image | img_url: '1000x' }}" alt="{{ product.title | escape }}" id="sf-image-el-{{ section.id }}">
            </div>
            {% if product.images.size > 1 %}
              <div class="sf-gallery-thumbs">
                {% for image in product.images %}
                  <div class="sf-thumb-item {% if forloop.first %}active{% endif %}" data-img-url="{{ image | img_url: '1000x' }}" onclick="sfSwitchImage('{{ section.id }}', this)">
                    <img src="{{ image | img_url: '150x150', crop: 'center' }}" alt="{{ image.alt | escape }}">
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>

        <!-- Product Details -->
        <div class="sf-details-wrapper">
          <div class="sf-pdp-vendor">{{ product.vendor }}</div>
          <h1 class="sf-pdp-title">{{ product.title }}</h1>
          
          <div class="sf-pdp-price-wrapper">
            <span class="sf-pdp-price" id="sf-price-{{ section.id }}">{{ current_variant.price | money }}</span>
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="sf-pdp-compare-price" id="sf-compare-price-{{ section.id }}">{{ current_variant.compare_at_price | money }}</span>
              <span class="sf-badge" id="sf-sale-badge-{{ section.id }}">Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}</span>
            {% endif %}
          </div>

          <div class="sf-desc-highlight">
            {{ product.description | strip_html | truncatewords: 35 }}
          </div>

          <form method="post" action="/cart/add" id="sf-form-{{ section.id }}" accept-charset="UTF-8" enctype="multipart/form-data">
            <input type="hidden" name="form_type" value="product">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="id" id="sf-variant-id-{{ section.id }}" value="{{ current_variant.id }}">

            {% unless product.has_only_default_variant %}
              <div class="sf-variants-container">
                {% for option in product.options_with_values %}
                  <div class="sf-variant-group">
                    <span class="sf-variant-label">{{ option.name }}</span>
                    <div class="sf-variant-options" data-option-index="option{{ forloop.index }}">
                      {% for value in option.values %}
                        <div class="sf-variant-option {% if option.selected_value == value %}selected{% endif %}" 
                             data-value="{{ value | escape }}"
                             onclick="sfSelectOption('{{ section.id }}', this)">
                          {{ value }}
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endunless %}

            <div class="sf-action-group">
              <div class="sf-quantity-selector">
                <button type="button" class="sf-qty-btn" onclick="sfUpdateQty('{{ section.id }}', -1)">−</button>
                <input type="number" class="sf-qty-input" name="quantity" id="sf-qty-{{ section.id }}" value="1" min="1">
                <button type="button" class="sf-qty-btn" onclick="sfUpdateQty('{{ section.id }}', 1)">+</button>
              </div>
              <button type="submit" class="sf-add-to-cart" id="sf-atc-{{ section.id }}" {% unless current_variant.available %}disabled{% endunless %}>
                {% if current_variant.available %}Add to Cart - {{ current_variant.price | money }}{% else %}Sold Out{% endif %}
              </button>
            </div>
          </form>

          {% if section.settings.shipping_info != blank %}
            <p style="font-size: 0.95rem; color: #64748b; margin-top: 20px; display: flex; align-items: center; gap: 8px;">
              <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
              {{ section.settings.shipping_info }}
            </p>
          {% endif %}
          
        </div>
      </div>
      
      <!-- Recently Viewed Section -->
      {% if section.settings.show_recently_viewed %}
      <div class="sf-recently-viewed" id="sf-rv-{{ section.id }}" style="display: none;">
        <h3 class="sf-rv-title">{{ section.settings.rv_title }}</h3>
        <div class="sf-rv-grid" id="sf-rv-grid-{{ section.id }}">
          <!-- Hydrated by JS -->
        </div>
      </div>
      
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          if (typeof window.sfTrackRecentlyViewed === 'function') {
            window.sfTrackRecentlyViewed('{{ product.handle }}');
            window.sfRenderRecentlyViewed('{{ section.id }}', '{{ product.handle }}', '{{ cart.currency.symbol }}');
          }
        });
      </script>
      {% endif %}

      <script>
        // Store product variants data for dynamic switching
        window.sfVariants_{{ section.id | replace: '-', '_' }} = [
          {% for variant in product.variants %}
            {
              id: {{ variant.id }},
              title: {{ variant.title | json }},
              option1: {{ variant.option1 | json }},
              option2: {{ variant.option2 | json }},
              option3: {{ variant.option3 | json }},
              price: '{{ variant.price | money }}',
              compare_at_price: {% if variant.compare_at_price %}'{{ variant.compare_at_price | money }}'{% else %}null{% endif %},
              available: {{ variant.available }},
              featured_image: {% if variant.featured_image %}'{{ variant.featured_image | img_url: "1000x" }}'{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ];
      </script>

    {% else %}
      <div style="text-align: center; padding: 100px 20px; background: #fff; border-radius: var(--radius);">
        <p style="font-size: 1.25rem; color: #64748b;">Select a product in the theme editor.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product Detail Highlight",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Select Product" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Page Background", "default": "#f4f4f5" },
    { "type": "color", "id": "highlight_color", "label": "Image Background Highlight", "default": "#fef3c7" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#374151" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#111827" },
    { "type": "color", "id": "primary_color", "label": "Primary Accent Color", "default": "#4f46e5" },
    { "type": "header", "content": "Information Settings" },
    { "type": "text", "id": "shipping_info", "label": "Shipping Info Text", "default": "Free express shipping & returns on all orders." },
    { "type": "header", "content": "Recently Viewed" },
    { "type": "checkbox", "id": "show_recently_viewed", "label": "Enable Recently Viewed", "default": true },
    { "type": "text", "id": "rv_title", "label": "Recently Viewed Title", "default": "People Also Bought" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 60 },
    { "type": "range", "id": "padding_horizontal", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Padding Horizontal", "default": 20 }
  ]
}
{% endschema %}
