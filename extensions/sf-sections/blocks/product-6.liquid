{%- assign product = all_products[section.settings.product] | default: product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  .sf-pdp-{{ section.id }} {
    --primary-color: {{ section.settings.primary_color }};
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --heading-color: {{ section.settings.heading_color }};
    --border-color: rgba(0,0,0,0.1);
    --radius: 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--text-color);
    background: var(--bg-color);
    box-sizing: border-box;
    position: relative;
  }
  .sf-pdp-{{ section.id }} * {
    box-sizing: inherit;
  }
  
  /* Large Imagery Layout (Full Bleed Background Image) */
  .sf-pdp-hero {
    position: relative;
    width: 100%;
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .sf-pdp-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.2) 100%);
    z-index: 1;
  }

  /* Product Details Floating Card */
  .sf-details-card {
    position: relative;
    z-index: 2;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-radius: var(--radius);
    padding: 40px;
    width: 100%;
    max-width: 500px;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
  }

  /* Product Meta */
  .sf-pdp-vendor {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #64748b;
    margin-bottom: 8px;
  }
  .sf-pdp-title {
    font-size: 2.5rem;
    line-height: 1.1;
    color: var(--heading-color);
    margin: 0 0 16px 0;
    font-weight: 800;
  }
  .sf-pdp-price-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }
  .sf-pdp-price {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--primary-color);
  }
  .sf-pdp-compare-price {
    font-size: 1.125rem;
    color: #94a3b8;
    text-decoration: line-through;
  }
  .sf-badge {
    background: var(--heading-color);
    color: white;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  /* Form & Variants */
  .sf-variant-group {
    margin-bottom: 20px;
  }
  .sf-variant-label {
    display: block;
    font-weight: 600;
    margin-bottom: 8px;
    font-size: 0.95rem;
    color: var(--heading-color);
  }
  .sf-variant-options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sf-variant-option {
    padding: 10px 20px;
    border: 2px solid #e2e8f0;
    border-radius: 40px;
    background: transparent;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.2s;
    user-select: none;
    color: var(--heading-color);
  }
  .sf-variant-option.selected {
    border-color: var(--primary-color);
    background: var(--primary-color);
    color: #fff;
  }
  .sf-variant-option.disabled {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  /* Quantity & CTA */
  .sf-action-group {
    display: flex;
    gap: 16px;
    margin-top: 32px;
    margin-bottom: 32px;
    align-items: stretch;
  }
  .sf-quantity-selector {
    display: flex;
    align-items: center;
    border: 2px solid #e2e8f0;
    border-radius: var(--radius);
    background: #fff;
    height: 56px;
  }
  .sf-qty-btn {
    width: 44px;
    height: 100%;
    background: none;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    color: var(--heading-color);
  }
  .sf-qty-input {
    width: 40px;
    height: 100%;
    border: none;
    text-align: center;
    font-size: 1.1rem;
    font-weight: 700;
    appearance: textfield;
    padding: 0;
    color: var(--heading-color);
  }
  .sf-qty-input::-webkit-inner-spin-button {
    display: none;
  }
  .sf-add-to-cart {
    flex: 1;
    background: var(--primary-color);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    font-size: 1.125rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
  }
  .sf-add-to-cart:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 25px -5px rgba(0,0,0,0.2);
  }
  .sf-add-to-cart:disabled {
    background: #cbd5e1;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  /* Description Card */
  .sf-desc-card {
    font-size: 1rem;
    line-height: 1.6;
    color: #475569;
  }

  /* Gallery Thumbs inside card */
  .sf-gallery-thumbs {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    margin-bottom: 24px;
    padding-bottom: 10px;
    scrollbar-width: none;
  }
  .sf-gallery-thumbs::-webkit-scrollbar { display: none; }
  .sf-thumb-item {
    flex: 0 0 70px;
    height: 70px;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.2s;
  }
  .sf-thumb-item.active {
    border-color: var(--primary-color);
  }
  .sf-thumb-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Recently Viewed below hero */
  .sf-rv-wrapper {
    background: var(--bg-color);
    padding: 60px 40px;
  }
  .sf-recently-viewed {
    max-width: 1400px;
    margin: 0 auto;
  }
  .sf-rv-title {
    font-size: 1.75rem;
    font-weight: 800;
    margin-bottom: 40px;
    color: var(--heading-color);
  }
  .sf-rv-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  @media(min-width: 768px) {
    .sf-rv-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .sf-rv-card {
    display: block;
    text-decoration: none;
    background: #fff;
    border-radius: var(--radius);
    padding: 16px;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
    transition: transform 0.2s;
  }
  .sf-rv-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
  }
  .sf-rv-card img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 16px;
  }
  .sf-rv-card-title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 8px;
    color: var(--heading-color);
  }
  .sf-rv-card-price {
    font-weight: 700;
    color: var(--primary-color);
  }
</style>

<div class="sf-pdp-{{ section.id }}">
  {% if product != blank %}
    
    <!-- Hero Section with Full Bleed Background -->
    <div class="sf-pdp-hero" id="sf-hero-{{ section.id }}" style="background-image: url('{{ current_variant.featured_image | default: product.featured_image | img_url: 'master' }}');">
      
      <!-- Card Overlay -->
      <div class="sf-details-card">
        <div class="sf-pdp-vendor">{{ product.vendor }}</div>
        <h1 class="sf-pdp-title">{{ product.title }}</h1>
        
        <div class="sf-pdp-price-wrapper">
          <span class="sf-pdp-price" id="sf-price-{{ section.id }}">{{ current_variant.price | money }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="sf-pdp-compare-price" id="sf-compare-price-{{ section.id }}">{{ current_variant.compare_at_price | money }}</span>
            <span class="sf-badge" id="sf-sale-badge-{{ section.id }}">Sale</span>
          {% endif %}
        </div>

        {% if product.images.size > 1 %}
          <div class="sf-gallery-thumbs">
            {% for image in product.images %}
              <div class="sf-thumb-item {% if forloop.first %}active{% endif %}" data-img-url="{{ image | img_url: 'master' }}" onclick="sfSwitchBackgroundImage('{{ section.id }}', this)">
                <img src="{{ image | img_url: '150x150', crop: 'center' }}" alt="{{ image.alt | escape }}">
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <form method="post" action="/cart/add" id="sf-form-{{ section.id }}" accept-charset="UTF-8" enctype="multipart/form-data">
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="id" id="sf-variant-id-{{ section.id }}" value="{{ current_variant.id }}">

          {% unless product.has_only_default_variant %}
            <div class="sf-variants-container">
              {% for option in product.options_with_values %}
                <div class="sf-variant-group">
                  <span class="sf-variant-label">{{ option.name }}</span>
                  <div class="sf-variant-options" data-option-index="option{{ forloop.index }}">
                    {% for value in option.values %}
                      <div class="sf-variant-option {% if option.selected_value == value %}selected{% endif %}" 
                           data-value="{{ value | escape }}"
                           onclick="sfSelectOption('{{ section.id }}', this)">
                        {{ value }}
                      </div>
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endunless %}

          <div class="sf-action-group">
            <div class="sf-quantity-selector">
              <button type="button" class="sf-qty-btn" onclick="sfUpdateQty('{{ section.id }}', -1)">−</button>
              <input type="number" class="sf-qty-input" name="quantity" id="sf-qty-{{ section.id }}" value="1" min="1">
              <button type="button" class="sf-qty-btn" onclick="sfUpdateQty('{{ section.id }}', 1)">+</button>
            </div>
            <button type="submit" class="sf-add-to-cart" id="sf-atc-{{ section.id }}" {% unless current_variant.available %}disabled{% endunless %}>
              {% if current_variant.available %}Add to Cart{% else %}Sold Out{% endif %}
            </button>
          </div>
        </form>

        <div class="sf-desc-card">
          {{ product.description | truncatewords: 40 }}
        </div>
      </div>
    </div>
    
    <!-- Recently Viewed Section -->
    {% if section.settings.show_recently_viewed %}
    <div class="sf-rv-wrapper">
      <div class="sf-recently-viewed" id="sf-rv-{{ section.id }}" style="display: none;">
        <h3 class="sf-rv-title">{{ section.settings.rv_title }}</h3>
        <div class="sf-rv-grid" id="sf-rv-grid-{{ section.id }}">
          <!-- Hydrated by JS -->
        </div>
      </div>
    </div>
    
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        if (typeof window.sfTrackRecentlyViewed === 'function') {
          window.sfTrackRecentlyViewed('{{ product.handle }}');
          window.sfRenderRecentlyViewed('{{ section.id }}', '{{ product.handle }}', '{{ cart.currency.symbol }}');
        }
      });

      function sfSwitchBackgroundImage(sectionId, element) {
        var newUrl = element.getAttribute('data-img-url');
        var hero = document.getElementById('sf-hero-' + sectionId);
        if (hero) {
          hero.style.backgroundImage = "url('" + newUrl + "')";
        }
        var thumbs = element.parentNode.children;
        for (var i=0; i<thumbs.length; i++) {
          thumbs[i].classList.remove('active');
        }
        element.classList.add('active');
      }
    </script>
    {% endif %}

    <script>
      // Store product variants data for dynamic switching
      window.sfVariants_{{ section.id | replace: '-', '_' }} = [
        {% for variant in product.variants %}
          {
            id: {{ variant.id }},
            title: {{ variant.title | json }},
            option1: {{ variant.option1 | json }},
            option2: {{ variant.option2 | json }},
            option3: {{ variant.option3 | json }},
            price: '{{ variant.price | money }}',
            compare_at_price: {% if variant.compare_at_price %}'{{ variant.compare_at_price | money }}'{% else %}null{% endif %},
            available: {{ variant.available }},
            featured_image: {% if variant.featured_image %}'{{ variant.featured_image | img_url: "master" }}'{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ];
    </script>

  {% else %}
    <div style="text-align: center; padding: 100px 20px; border: 2px dashed #cbd5e1;">
      <p style="font-size: 1.25rem; color: #64748b;">Select a product in the theme editor to view Large Imagery layout.</p>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product Large Imagery",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Select Product" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background Color Below Hero", "default": "#f8fafc" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1e293b" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#0f172a" },
    { "type": "color", "id": "primary_color", "label": "Primary Button Color", "default": "#3b82f6" },
    { "type": "header", "content": "Recently Viewed" },
    { "type": "checkbox", "id": "show_recently_viewed", "label": "Enable Recently Viewed", "default": true },
    { "type": "text", "id": "rv_title", "label": "Recently Viewed Title", "default": "Discover More" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 10, "unit": "px", "label": "Hero Padding Top", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 10, "unit": "px", "label": "Hero Padding Bottom", "default": 100 },
    { "type": "range", "id": "padding_horizontal", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Hero Padding Horizontal", "default": 40 }
  ]
}
{% endschema %}
