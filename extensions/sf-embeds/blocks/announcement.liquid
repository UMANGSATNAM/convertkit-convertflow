{% if block.settings.enabled %}
<div class="sf-announcement" style="background-color: {{ block.settings.bg_color }}; color: {{ block.settings.text_color }}; text-align: center; padding: 10px; font-size: 14px; width: 100%; position: relative; z-index: 1000;">
  {% if block.settings.link != blank %}
    <a href="{{ block.settings.link }}" style="color: inherit; text-decoration: none;">
  {% endif %}
  
  {{ block.settings.message }}
  
  {% if block.settings.link != blank %}
    </a>
  {% endif %}
</div>
{% endif %}

{% schema %}
{
  "name": "Smart Announcement",
  "target": "section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable", "default": true },
    { "type": "text", "id": "message", "label": "Message", "default": "Free shipping on orders over $50!" },
    { "type": "url", "id": "link", "label": "Link (optional)" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" }
  ]
}
{% endschema %}
