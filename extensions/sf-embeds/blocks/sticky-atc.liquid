{% if block.settings.enabled %}
<div class="sf-sticky-atc" style="position: fixed; bottom: 0; width: 100%; background: #fff; z-index: 999; display: flex; justify-content: space-between; padding: 10px;">
  <div>
    <strong>{{ product.title }}</strong>
    <span>{{ product.price | money }}</span>
  </div>
  <button onclick="document.querySelector('form[action=\'/cart/add\']').submit()">
    Add to Cart
  </button>
</div>
{% endif %}

{% schema %}
{
  "name": "Sticky ATC",
  "target": "body",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable Sticky ATC", "default": true }
  ]
}
{% endschema %}
