{% if block.settings.enabled %}
<div class="sf-trust-badges" style="text-align: center; margin: 15px 0;">
  {% if block.settings.title != blank %}
    <p style="font-size: 0.9em; color: #666; margin-bottom: 8px;">{{ block.settings.title }}</p>
  {% endif %}
  <div style="display: flex; justify-content: center; gap: 10px; flex-wrap: wrap;">
    {% if block.settings.show_visa %}
      <img src="https://cdn.shopify.com/s/assets/payment_icons/visa-319d545c6fd255c9aad5eeaad21fd6f7f7b4f5931cb3ea8c222287bc46e60e94.svg" alt="Visa" width="40" height="25" loading="lazy">
    {% endif %}
    {% if block.settings.show_mastercard %}
      <img src="https://cdn.shopify.com/s/assets/payment_icons/master-173035bc8124581983d4efa50cf8626e8553c2b311353fbf67485f9c1a2b88d1.svg" alt="Mastercard" width="40" height="25" loading="lazy">
    {% endif %}
    {% if block.settings.show_amex %}
      <img src="https://cdn.shopify.com/s/assets/payment_icons/american_express-2264c9b8b57b23b0b0831827e90cd7bcda2836adc42a4b21ca8b424a8fb553b5.svg" alt="Amex" width="40" height="25" loading="lazy">
    {% endif %}
    {% if block.settings.show_paypal %}
      <img src="https://cdn.shopify.com/s/assets/payment_icons/paypal-49e4c1e03244b6d2de0d270ca0d22dd15da6e92cc7266e93eb43762df5aa355d.svg" alt="PayPal" width="40" height="25" loading="lazy">
    {% endif %}
    {% if block.settings.show_apple_pay %}
      <img src="https://cdn.shopify.com/s/assets/payment_icons/apple_pay-f6db0077dc7c325b436fcbc100aee509bc43076aae81b0f940ae64814d20362f.svg" alt="Apple Pay" width="40" height="25" loading="lazy">
    {% endif %}
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Trust Badges",
  "target": "section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable", "default": true },
    { "type": "text", "id": "title", "label": "Title", "default": "Guaranteed Safe Checkout" },
    { "type": "checkbox", "id": "show_visa", "label": "Show Visa", "default": true },
    { "type": "checkbox", "id": "show_mastercard", "label": "Show Mastercard", "default": true },
    { "type": "checkbox", "id": "show_amex", "label": "Show Amex", "default": true },
    { "type": "checkbox", "id": "show_paypal", "label": "Show PayPal", "default": true },
    { "type": "checkbox", "id": "show_apple_pay", "label": "Show Apple Pay", "default": true }
  ]
}
{% endschema %}
