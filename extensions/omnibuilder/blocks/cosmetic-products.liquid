<div class="omni-cosmetic-products" style="background-color: {{ block.settings.bg_color }}; padding: {{ block.settings.padding_y }}px 20px;">
  <div class="omni-cp-header">
    <h2 class="omni-cp-title" style="color: {{ block.settings.text_color }}">{{ block.settings.heading }}</h2>
    {% if block.settings.button_text != blank %}
      <a href="{{ block.settings.button_link }}" class="omni-cp-view-all" style="color: {{ block.settings.text_color }}">{{ block.settings.button_text }}</a>
    {% endif %}
  </div>
  
  <div class="omni-cp-grid">
    {% for product in block.settings.collection.products limit: block.settings.limit %}
      <a href="{{ product.url }}" class="omni-cp-item">
        <div class="omni-cp-image-wrapper">
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="omni-cp-image" loading="lazy">
        </div>
        <div class="omni-cp-info">
          <h3 class="omni-cp-product-title" style="color: {{ block.settings.text_color }}">{{ product.title }}</h3>
          <p class="omni-cp-price" style="color: {{ block.settings.text_color }}">{{ product.price | money }}</p>
        </div>
      </a>
    {% else %}
      {% for i in (1..4) %}
        <div class="omni-cp-item">
          <div class="omni-cp-image-wrapper" style="background: #f4f4f4;"></div>
          <div class="omni-cp-info">
            <h3 class="omni-cp-product-title" style="color: {{ block.settings.text_color }}">Example Product</h3>
            <p class="omni-cp-price" style="color: {{ block.settings.text_color }}">$49.00</p>
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

<style>
  .omni-cosmetic-products {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }
  .omni-cp-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    padding: 0 20px;
  }
  .omni-cp-title {
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 300;
    margin: 0;
    font-family: {{ block.settings.heading_font.family }}, serif;
  }
  .omni-cp-view-all {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: underline;
  }
  .omni-cp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 30px;
    padding: 0 20px;
  }
  .omni-cp-item {
    text-decoration: none;
    display: block;
    group: hover;
  }
  .omni-cp-image-wrapper {
    width: 100%;
    aspect-ratio: 3/4;
    overflow: hidden;
    margin-bottom: 15px;
    background: #f9f9f9;
  }
  .omni-cp-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .omni-cp-item:hover .omni-cp-image {
    transform: scale(1.05);
  }
  .omni-cp-info {
    text-align: center;
  }
  .omni-cp-product-title {
    font-size: 15px;
    font-weight: 400;
    margin: 0 0 8px 0;
  }
  .omni-cp-price {
    font-size: 14px;
    margin: 0;
    opacity: 0.8;
  }
</style>

{% schema %}
{
  "name": "Cosmetic Products",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Bestsellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Product Limit",
      "default": 4
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "View All Text",
      "default": "View Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "View All Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 40,
      "max": 120,
      "step": 10,
      "label": "Vertical Padding",
      "default": 80
    }
  ]
}
{% endschema %}
