<div class="omni-cosmetic-hero" style="background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}'); background-color: {{ block.settings.background_color }};">
  <div class="omni-hero-overlay" style="background: rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by: 100.0 }});"></div>
  <div class="omni-hero-content omni-align-{{ block.settings.alignment }}">
    {% if block.settings.subheading != blank %}
      <p class="omni-hero-subheading" style="color: {{ block.settings.text_color }}">{{ block.settings.subheading }}</p>
    {% endif %}
    {% if block.settings.title != blank %}
      <h1 class="omni-hero-title" style="color: {{ block.settings.text_color }}">{{ block.settings.title }}</h1>
    {% endif %}
    {% if block.settings.button_text != blank %}
      <a href="{{ block.settings.button_link }}" class="omni-hero-button" style="background-color: {{ block.settings.button_color }}; color: {{ block.settings.button_text_color }};">
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>

<style>
  .omni-cosmetic-hero {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.height }}px;
    background-size: cover;
    background-position: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40px 20px;
  }
  .omni-hero-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 1;
  }
  .omni-hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
  }
  .omni-align-center { text-align: center; }
  .omni-align-left { text-align: left; }
  .omni-align-right { text-align: right; }
  
  .omni-hero-subheading {
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 15px;
    font-weight: 500;
  }
  .omni-hero-title {
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.1;
    margin-bottom: 30px;
    font-family: {{ block.settings.title_font.family }}, serif;
    font-weight: 300;
  }
  .omni-hero-button {
    display: inline-block;
    padding: 16px 36px;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  .omni-hero-button:hover {
    opacity: 0.8;
  }
</style>

{% schema %}
{
  "name": "Cosmetic Hero",
  "target": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fallback Color",
      "default": "#f4ede8"
    },
    {
      "type": "range",
      "id": "height",
      "min": 400,
      "max": 1000,
      "step": 50,
      "label": "Height (px)",
      "default": 600
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Overlay Opacity %",
      "default": 20
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Glow Collection"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
