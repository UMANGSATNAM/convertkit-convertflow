<div class="omni-cosmetic-image-text omni-layout-{{ block.settings.layout }}" style="background-color: {{ block.settings.bg_color }};">
  <div class="omni-it-image-wrapper">
    {% if block.settings.image %}
      <img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.heading }}" class="omni-it-image" loading="lazy">
    {% else %}
      <div class="omni-it-placeholder"></div>
    {% endif %}
  </div>
  <div class="omni-it-content-wrapper">
    <div class="omni-it-content" style="text-align: {{ block.settings.alignment }};">
      <h2 class="omni-it-heading" style="color: {{ block.settings.text_color }}">{{ block.settings.heading }}</h2>
      <div class="omni-it-text" style="color: {{ block.settings.text_color }}; opacity: 0.8;">{{ block.settings.text }}</div>
      {% if block.settings.button_text != blank %}
        <a href="{{ block.settings.button_link }}" class="omni-it-button" style="background-color: {{ block.settings.button_bg }}; color: {{ block.settings.button_color }};">{{ block.settings.button_text }}</a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .omni-cosmetic-image-text {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
  }
  .omni-layout-image_right {
    flex-direction: row-reverse;
  }
  .omni-it-image-wrapper, .omni-it-content-wrapper {
    flex: 1 1 50%;
    min-width: 300px;
  }
  .omni-it-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    min-height: 500px;
  }
  .omni-it-placeholder {
    width: 100%;
    height: 100%;
    min-height: 500px;
    background: #f0f0f0;
  }
  .omni-it-content-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 40px;
  }
  .omni-it-content {
    max-width: 500px;
  }
  .omni-it-heading {
    font-size: clamp(28px, 4vw, 42px);
    margin-bottom: 24px;
    font-weight: 300;
    line-height: 1.2;
    font-family: {{ block.settings.heading_font.family }}, serif;
  }
  .omni-it-text {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 32px;
  }
  .omni-it-button {
    display: inline-block;
    padding: 14px 32px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 13px;
    text-decoration: none;
    transition: opacity 0.3s;
  }
  .omni-it-button:hover {
    opacity: 0.8;
  }
  @media (max-width: 768px) {
    .omni-it-image-wrapper, .omni-it-content-wrapper {
      flex: 1 1 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Cosmetic Image w/ Text",
  "target": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Layout",
      "options": [
        { "value": "image_left", "label": "Image Left" },
        { "value": "image_right", "label": "Image Right" }
      ],
      "default": "image_left"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean & Conscious"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Our formulas are created with sensitive skin in mind. We use only the highest quality botanical extracts and active ingredients to ensure maximum efficacy without irritation."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Discover Our Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
