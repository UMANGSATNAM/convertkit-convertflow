{% comment %}
  ConvertFlow — Jewellery Heritage Collection Page
  Clean grid with gold accents and elegant typography.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Lato:wght@300;400;700&display=swap');

  :root {
    --jh-primary: {{ section.settings.color_primary | default: '#D4AF37' }};
    --jh-bg: {{ section.settings.color_bg | default: '#FFFFFF' }};
    --jh-surface: {{ section.settings.color_surface | default: '#FAFAFA' }};
    --jh-border: rgba(212, 175, 55, 0.3);
    --jh-text: {{ section.settings.color_text | default: '#222222' }};
    --jh-font-heading: 'Playfair Display', serif;
    --jh-font-body: 'Lato', sans-serif;
  }

  .cf-jh-c * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-jh-c { font-family: var(--jh-font-body); background: var(--jh-bg); color: var(--jh-text); }
  
  .cf-jh-c-header { text-align: center; padding: 80px 5%; background: var(--jh-surface); border-bottom: 1px solid #eaeaea; }
  .cf-jh-c-header h1 { font-family: var(--jh-font-heading); font-size: clamp(40px, 5vw, 56px); font-weight: 400; margin-bottom: 16px; position: relative; display: inline-block; padding-bottom: 15px; }
  .cf-jh-c-header h1::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 40px; height: 1px; background: var(--jh-primary); }
  .cf-jh-c-header p { color: #666; font-size: 15px; max-width: 600px; margin: 20px auto 0; font-weight: 300; line-height: 1.8; }
  
  .cf-jh-c-main { max-width: 1400px; margin: 0 auto; padding: 60px 5%; }
  
  .cf-jh-c-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: #666; border-bottom: 1px solid #eaeaea; padding-bottom: 20px; }
  .cf-jh-c-filters { display: flex; gap: 30px; }
  .cf-jh-c-filter { cursor: pointer; transition: color 0.3s; }
  .cf-jh-c-filter:hover, .cf-jh-c-filter.active { color: var(--jh-primary); }
  
  .cf-jh-c-sort select { border: none; background: transparent; font-family: inherit; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--jh-text); outline: none; cursor: pointer; }
  
  .cf-jh-c-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px 30px; }
  .cf-jh-prod { text-decoration: none; color: var(--jh-text); text-align: center; group; display: block; }
  .cf-jh-prod-img { aspect-ratio: 1; background: #fff; border: 1px solid #eaeaea; padding: 20px; margin-bottom: 20px; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .cf-jh-prod-img img { max-width: 100%; max-height: 100%; object-fit: contain; transition: transform 0.8s ease; }
  .cf-jh-prod:hover .cf-jh-prod-img img { transform: scale(1.05); }
  .cf-jh-prod-img::after { content: ''; position: absolute; inset: 10px; border: 1px solid transparent; transition: border-color 0.4s ease; }
  .cf-jh-prod:hover .cf-jh-prod-img::after { border-color: var(--jh-border); }
  
  .cf-jh-prod-title { font-family: var(--jh-font-heading); font-size: 18px; margin-bottom: 8px; color: var(--jh-text); }
  .cf-jh-prod-price { font-size: 14px; color: #666; font-weight: 300; }

  @media(max-width: 1024px) {
    .cf-jh-c-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media(max-width: 768px) {
    .cf-jh-c-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .cf-jh-c-toolbar { flex-direction: column; gap: 20px; }
  }
{% endstyle %}

<div class="cf-jh-c">
  <div class="cf-jh-c-header">
    <h1>{{ collection.title | default: 'The Bridal Collection' }}</h1>
    {% if collection.description != blank %}
      <p>{{ collection.description | strip_html | truncate: 150 }}</p>
    {% endif %}
  </div>
  
  <div class="cf-jh-c-main">
    <div class="cf-jh-c-toolbar">
      <div class="cf-jh-c-filters">
        <span class="cf-jh-c-filter active">All Categories</span>
        <span class="cf-jh-c-filter">Rings</span>
        <span class="cf-jh-c-filter">Necklaces</span>
        <span class="cf-jh-c-filter">Earrings</span>
      </div>
      <div class="cf-jh-c-sort">
        <select>
          <option>Sort By: Featured</option>
          <option>Price: Low to High</option>
          <option>Price: High to Low</option>
        </select>
      </div>
    </div>
    
    <div class="cf-jh-c-grid">
      {% if collection.products.size > 0 %}
        {% for product in collection.products %}
          <a href="{{ product.url }}" class="cf-jh-prod">
            <div class="cf-jh-prod-img">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}">
              {% endif %}
            </div>
            <div class="cf-jh-prod-title">{{ product.title }}</div>
            <div class="cf-jh-prod-price">{{ product.price | money }}</div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..8) %}
          <a href="#" class="cf-jh-prod">
            <div class="cf-jh-prod-img"><div style="width:60%; height:60%; background:#f5f5f5; border-radius:50%;"></div></div>
            <div class="cf-jh-prod-title">Heritage Piece 0{{ i }}</div>
            <div class="cf-jh-prod-price">$1,200.00</div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CF Jewellery Collection",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Gold Accent", "default": "#D4AF37" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_surface", "label": "Surface", "default": "#FAFAFA" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#222222" }
  ],
  "presets": [
    { "name": "CF Jewellery Collection" }
  ]
}
{% endschema %}