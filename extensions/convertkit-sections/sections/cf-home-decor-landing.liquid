{% comment %}ConvertFlow - Home Decor Landing | AURA style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Montserrat:wght@200;300;400;500&display=swap" rel="stylesheet">
<style>
.cfhd *{box-sizing:border-box;margin:0;padding:0}
.cfhd{font-family:'Montserrat',sans-serif;font-size:14px;color:#2C2C2A;background:#FDFBF7;-webkit-font-smoothing:antialiased;font-weight:300;line-height:1.6}
.cfhd h1,.cfhd h2,.cfhd h3,.cfhd h4{font-family:'Cormorant Garamond',serif}
/* HERO */
.cfhd-hero{height:100vh;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#000}
.cfhd-hero-bg{position:absolute;inset:0;background:linear-gradient(rgba(0,0,0,.2),rgba(0,0,0,.4)),linear-gradient(135deg,#C2A894,#8F9779);opacity:.85}
.cfhd-hero-content{position:relative;z-index:2;text-align:center;color:#fff;max-width:800px;padding:0 40px}
.cfhd-hero-sub{font-size:12px;text-transform:uppercase;letter-spacing:4px;margin-bottom:20px;display:block;font-weight:400}
.cfhd-hero h1{font-size:clamp(60px,8vw,100px);font-weight:400;line-height:1;margin-bottom:40px}
.cfhd-hero h1 em{font-style:italic;color:#E8E5DF;font-weight:300}
.cfhd-btn-outline{border:1px solid #fff;color:#fff;background:transparent;padding:18px 48px;font-size:12px;text-transform:uppercase;letter-spacing:2px;cursor:pointer;transition:all .4s;font-family:'Montserrat',sans-serif}
.cfhd-btn-outline:hover{background:#fff;color:#2C2C2A}
/* COLLECTION */
.cfhd-collection{padding:120px 60px;max-width:1600px;margin:0 auto}
.cfhd-col-header{text-align:center;margin-bottom:80px}
.cfhd-col-header h2{font-size:48px;font-weight:300;margin-bottom:16px}
.cfhd-col-header p{font-size:14px;max-width:500px;margin:0 auto;color:#666}
.cfhd-masonry{display:grid;grid-template-columns:repeat(3,1fr);gap:40px}
.cfhd-item{position:relative;text-decoration:none;color:#2C2C2A;display:block;margin-bottom:40px}
.cfhd-item.large{grid-row:span 2}
.cfhd-img-wrap{position:relative;overflow:hidden;background:#F2EFE9;margin-bottom:20px}
.cfhd-img-placeholder{width:100%;display:block;transition:transform .8s}
.cfhd-item:hover .cfhd-img-placeholder{transform:scale(1.03)}
.cfhd-action{position:absolute;bottom:20px;left:50%;transform:translateX(-50%) translateY(20px);opacity:0;background:#fff;padding:14px 32px;border-radius:40px;font-size:11px;text-transform:uppercase;letter-spacing:2px;box-shadow:0 10px 30px rgba(0,0,0,.05);transition:all .4s;display:flex;align-items:center;gap:8px;white-space:nowrap}
.cfhd-item:hover .cfhd-action{transform:translateX(-50%) translateY(0);opacity:1}
.cfhd-m-title{font-size:18px;font-weight:400;margin-bottom:6px;text-align:center}
.cfhd-m-price{font-size:13px;color:#777;font-weight:300;text-align:center}
/* LOOKBOOK */
.cfhd-lookbook{display:grid;grid-template-columns:1fr 1fr;height:80vh;margin:60px 0}
.cfhd-lb-img{background:#8F9779;display:flex;align-items:center;justify-content:center}
.cfhd-lb-img svg{width:120px;height:120px;color:rgba(255,255,255,.5)}
.cfhd-lb-content{padding:100px;display:flex;flex-direction:column;justify-content:center;background:#FAF9F6}
.cfhd-lb-content h2{font-size:56px;font-weight:300;margin-bottom:24px;line-height:1.1}
.cfhd-lb-content p{font-size:15px;margin-bottom:40px;max-width:400px;line-height:1.8;color:#555}
.cfhd-link-ul{text-decoration:none;color:#2C2C2A;font-size:11px;text-transform:uppercase;letter-spacing:2px;position:relative;padding-bottom:4px;display:inline-block}
.cfhd-link-ul::after{content:'';position:absolute;bottom:0;left:0;width:100%;height:1px;background:currentColor;transform:scaleX(0);transform-origin:right;transition:transform .4s}
.cfhd-link-ul:hover::after{transform:scaleX(1);transform-origin:left}
/* FEATURES BAND */
.cfhd-features{border-top:1px solid #E8E5DF;border-bottom:1px solid #E8E5DF;padding:80px 0;background:#fff}
.cfhd-features-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);text-align:center;gap:60px}
.cfhd-feature{display:flex;flex-direction:column;align-items:center}
.cfhd-f-icon{width:32px;height:32px;margin-bottom:20px;color:#C2A894}
.cfhd-feature h4{font-size:20px;font-weight:400;margin-bottom:12px}
.cfhd-feature p{font-size:13px;color:#666;max-width:240px}
/* FOOTER */
.cfhd-footer{padding:100px 60px 40px;background:#2C2C2A;color:#FAF9F6}
.cfhd-footer-top{max-width:1600px;margin:0 auto;display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:100px}
.cfhd-footer-logo{font-family:'Cormorant Garamond',serif;font-size:40px;font-weight:500;color:#FAF9F6;margin-bottom:24px;letter-spacing:2px;display:block}
.cfhd-footer-brand p{font-size:13px;opacity:.6;max-width:300px;line-height:1.8}
.cfhd-footer-nav{display:grid;grid-template-columns:repeat(3,1fr);gap:80px}
.cfhd-footer-col h5{font-family:'Montserrat',sans-serif;font-size:10px;text-transform:uppercase;letter-spacing:2px;margin-bottom:30px;opacity:.5;font-weight:400}
.cfhd-footer-col ul{list-style:none}
.cfhd-footer-col li{margin-bottom:16px}
.cfhd-footer-col a{color:#FAF9F6;text-decoration:none;font-size:13px;opacity:.8;transition:opacity .3s;font-weight:300}
.cfhd-footer-col a:hover{opacity:1}
.cfhd-footer-bottom{border-top:1px solid rgba(255,255,255,.1);padding-top:30px;display:flex;justify-content:space-between;align-items:center;font-size:11px;opacity:.5;text-transform:uppercase;letter-spacing:1px;max-width:1600px;margin:0 auto}
@media(max-width:1024px){.cfhd-masonry{grid-template-columns:repeat(2,1fr)}.cfhd-lookbook{grid-template-columns:1fr;height:auto}.cfhd-lb-img{height:400px}.cfhd-lb-content{padding:60px 40px}.cfhd-footer-top{flex-direction:column;gap:60px}}
@media(max-width:768px){.cfhd-hero h1{font-size:50px}.cfhd-collection{padding:80px 20px}.cfhd-masonry{grid-template-columns:1fr;gap:20px}.cfhd-item.large{grid-row:auto}.cfhd-features-inner{grid-template-columns:1fr;gap:40px;padding:0 40px}.cfhd-footer-nav{grid-template-columns:1fr 1fr;gap:40px}}
</style>

<div class="cfhd">
  <section class="cfhd-hero">
    <div class="cfhd-hero-bg"></div>
    <div class="cfhd-hero-content">
      <span class="cfhd-hero-sub">{{ section.settings.hero_sub }}</span>
      <h1>{{ section.settings.hero_heading }} <em>{{ section.settings.hero_heading_em }}</em></h1>
      <button class="cfhd-btn-outline">{{ section.settings.hero_cta }}</button>
    </div>
  </section>

  <section class="cfhd-collection">
    <div class="cfhd-col-header">
      <h2>{{ section.settings.collection_heading }}</h2>
      <p>{{ section.settings.collection_subtext }}</p>
    </div>
    <div class="cfhd-masonry">
      {% for block in section.blocks %}
        {% if block.type == 'collection_item' %}
        <a href="{{ block.settings.link }}" class="cfhd-item{% if block.settings.large %} large{% endif %}" {{ block.shopify_attributes }}>
          <div class="cfhd-img-wrap" style="aspect-ratio:{% if block.settings.large %}3/4{% else %}1{% endif %}">
            {% if block.settings.image %}
              <img class="cfhd-img-placeholder" src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title }}" style="height:100%;object-fit:cover">
            {% else %}
              <div class="cfhd-img-placeholder" style="background:{{ block.settings.bg_color }};min-height:200px"></div>
            {% endif %}
            <div class="cfhd-action">View Details <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></div>
          </div>
          <h3 class="cfhd-m-title">{{ block.settings.title }}</h3>
          <p class="cfhd-m-price">{{ block.settings.price }}</p>
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  {% if section.settings.show_lookbook %}
  <section class="cfhd-lookbook">
    <div class="cfhd-lb-img">
      {% if section.settings.lookbook_image %}
        <img src="{{ section.settings.lookbook_image | image_url: width: 800 }}" alt="{{ section.settings.lookbook_heading }}" style="width:100%;height:100%;object-fit:cover">
      {% else %}
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      {% endif %}
    </div>
    <div class="cfhd-lb-content">
      <h2>{{ section.settings.lookbook_heading }}</h2>
      <p>{{ section.settings.lookbook_text }}</p>
      <a href="{{ section.settings.lookbook_link }}" class="cfhd-link-ul">{{ section.settings.lookbook_cta }}</a>
    </div>
  </section>
  {% endif %}

  {% if section.settings.show_features %}
  <div class="cfhd-features">
    <div class="cfhd-features-inner">
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
        <div class="cfhd-feature" {{ block.shopify_attributes }}>
          <svg class="cfhd-f-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          <h4>{{ block.settings.title }}</h4>
          <p>{{ block.settings.text }}</p>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <footer class="cfhd-footer">
    <div class="cfhd-footer-top">
      <div class="cfhd-footer-brand">
        <span class="cfhd-footer-logo">{{ section.settings.brand_name }}</span>
        <p>{{ section.settings.brand_desc }}</p>
      </div>
      <div class="cfhd-footer-nav">
        <div class="cfhd-footer-col"><h5>Shop</h5><ul><li><a href="#">Furniture</a></li><li><a href="#">Lighting</a></li><li><a href="#">Decor</a></li><li><a href="#">Textiles</a></li></ul></div>
        <div class="cfhd-footer-col"><h5>Assistance</h5><ul><li><a href="#">Shipping & Returns</a></li><li><a href="#">Care Guide</a></li><li><a href="#">FAQ</a></li><li><a href="#">Contact Us</a></li></ul></div>
        <div class="cfhd-footer-col"><h5>Company</h5><ul><li><a href="#">About Aura</a></li><li><a href="#">Journal</a></li><li><a href="#">Design Services</a></li><li><a href="#">Trade Program</a></li></ul></div>
      </div>
    </div>
    <div class="cfhd-footer-bottom"><span>{{ section.settings.copyright }}</span><span style="display:flex;gap:20px"><a href="#" style="color:inherit;text-decoration:none">Privacy</a><a href="#" style="color:inherit;text-decoration:none">Terms</a></span></div>
  </footer>
</div>

{% schema %}
{
  "name": "CF Home Decor",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "text", "id": "brand_name", "label": "Brand Name", "default": "AURA" },
    { "type": "textarea", "id": "brand_desc", "label": "Brand Description", "default": "Curating exceptional spaces with furniture and decor that inspires tranquility and purpose in everyday life." },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© 2025 Aura Home Inc." },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero Background Image" },
    { "type": "text", "id": "hero_sub", "label": "Hero Eyebrow Text", "default": "The Spring Collection" },
    { "type": "text", "id": "hero_heading", "label": "Hero Heading", "default": "Elevate Your" },
    { "type": "text", "id": "hero_heading_em", "label": "Hero Heading Italic", "default": "Sanctuary" },
    { "type": "text", "id": "hero_cta", "label": "Hero CTA Text", "default": "Explore Collection" },
    { "type": "header", "content": "Collection Section" },
    { "type": "text", "id": "collection_heading", "label": "Collection Heading", "default": "Curated Pieces" },
    { "type": "textarea", "id": "collection_subtext", "label": "Collection Subtext", "default": "Discover our meticulously crafted furniture and decor items, designed to bring warmth and understated luxury to your living spaces." },
    { "type": "header", "content": "Lookbook Section" },
    { "type": "checkbox", "id": "show_lookbook", "label": "Show Lookbook Section", "default": true },
    { "type": "image_picker", "id": "lookbook_image", "label": "Lookbook Image" },
    { "type": "text", "id": "lookbook_heading", "label": "Lookbook Heading", "default": "Organic Forms & Natural Textures" },
    { "type": "textarea", "id": "lookbook_text", "label": "Lookbook Text", "default": "Our philosophy embraces imperfection, using natural materials that age gracefully over time. Every piece tells a story of craftsmanship and mindfulness." },
    { "type": "text", "id": "lookbook_cta", "label": "Lookbook CTA Text", "default": "Read Our Story" },
    { "type": "url", "id": "lookbook_link", "label": "Lookbook CTA Link" },
    { "type": "header", "content": "Features Band" },
    { "type": "checkbox", "id": "show_features", "label": "Show Features Band", "default": true }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product Image" },
        { "type": "color", "id": "bg_color", "label": "Fallback Background Color", "default": "#E8E5DF" },
        { "type": "checkbox", "id": "large", "label": "Large (spans 2 rows)", "default": false },
        { "type": "text", "id": "title", "label": "Product Title", "default": "The Artisan Lounge Chair" },
        { "type": "text", "id": "price", "label": "Price", "default": "$1,295" },
        { "type": "url", "id": "link", "label": "Product Link" }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Feature Title", "default": "Sustainable Sourcing" },
        { "type": "text", "id": "text", "label": "Feature Text", "default": "We partner with artisans who use ethically harvested materials." }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF Home Decor",
      "blocks": [
        { "type": "collection_item", "settings": { "large": true, "bg_color": "#E8E5DF", "title": "The Artisan Lounge Chair", "price": "$1,295" } },
        { "type": "collection_item", "settings": { "large": false, "bg_color": "#8F9779", "title": "Ceramic Ribbed Vase", "price": "$145" } },
        { "type": "collection_item", "settings": { "large": false, "bg_color": "#C2A894", "title": "Fluted Console Table", "price": "$895" } },
        { "type": "collection_item", "settings": { "large": true, "bg_color": "#5A5A5A", "title": "Bouclé Accent Sofa", "price": "$2,450" } },
        { "type": "feature", "settings": { "title": "Sustainable Sourcing", "text": "We partner with artisans who use ethically harvested materials." } },
        { "type": "feature", "settings": { "title": "Timeless Design", "text": "Creating pieces that transcend seasonal trends to become future heirlooms." } },
        { "type": "feature", "settings": { "title": "White Glove Delivery", "text": "Complimentary assembly and placement in your room of choice." } }
      ]
    }
  ]
}
{% endschema %}