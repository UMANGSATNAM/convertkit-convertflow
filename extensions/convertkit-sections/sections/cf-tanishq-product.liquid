{% comment %}
  ConvertFlow — Tanishq-Style Premium Jewellery Product Page
  Self-contained luxury PDP with gallery, variant picker, trust badges, accordion
  Injects into templates/product.json
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap');

  .cfj-pdp * { margin: 0; padding: 0; box-sizing: border-box; }
  .cfj-pdp {
    font-family: 'DM Sans', 'Segoe UI', sans-serif;
    color: #2C1810;
    -webkit-font-smoothing: antialiased;
    background: #FFFCF5;
  }
  .cfj-pdp h1, .cfj-pdp h2, .cfj-pdp h3, .cfj-pdp h4 {
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
  }

  /* ── Breadcrumb ── */
  .cfj-pdp-breadcrumb {
    background: #FAF5ED;
    padding: 14px 48px;
    font-size: 13px;
    color: #8B7355;
    border-bottom: 1px solid rgba(212,175,55,0.1);
  }
  .cfj-pdp-breadcrumb a { color: #8B7355; text-decoration: none; }
  .cfj-pdp-breadcrumb a:hover { color: #D4AF37; }
  .cfj-pdp-breadcrumb span { margin: 0 10px; color: #d4af37; }

  /* ── Main Layout ── */
  .cfj-pdp-main {
    max-width: 1320px;
    margin: 0 auto;
    padding: 56px 48px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  /* ── Gallery ── */
  .cfj-pdp-gallery {}
  .cfj-pdp-main-img {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: #FAF5ED;
    margin-bottom: 16px;
    position: relative;
    border: 1px solid rgba(212,175,55,0.1);
  }
  .cfj-pdp-main-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .cfj-pdp-main-img:hover img { transform: scale(1.03); }
  .cfj-pdp-badges {
    position: absolute;
    top: 20px;
    left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cfj-pdp-badge {
    padding: 6px 16px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #2C1810;
    background: #D4AF37;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-pdp-badge.certified { background: #FFFCF5; border: 1px solid #D4AF37; }
  .cfj-pdp-badge.sale { background: #8B2252; color: #fff; }
  .cfj-pdp-zoom-hint {
    position: absolute;
    bottom: 16px;
    right: 16px;
    background: rgba(44,24,16,0.7);
    color: #FFFCF5;
    padding: 8px 16px;
    font-size: 11px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.5px;
  }
  .cfj-pdp-thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .cfj-pdp-thumb {
    aspect-ratio: 1;
    overflow: hidden;
    border: 2px solid transparent;
    cursor: pointer;
    background: #FAF5ED;
    transition: border-color 0.3s;
  }
  .cfj-pdp-thumb.active { border-color: #D4AF37; }
  .cfj-pdp-thumb:hover { border-color: rgba(212,175,55,0.5); }
  .cfj-pdp-thumb img { width: 100%; height: 100%; object-fit: cover; }

  /* ── Product Info ── */
  .cfj-pdp-info {}
  .cfj-pdp-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .cfj-pdp-category {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #D4AF37;
    display: block;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-pdp-sku {
    font-size: 11px;
    color: #8B7355;
    letter-spacing: 0.5px;
  }
  .cfj-pdp-title {
    font-size: 34px;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 18px;
    letter-spacing: -0.3px;
    color: #2C1810;
  }

  /* Rating */
  .cfj-pdp-rating-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(212,175,55,0.1);
  }
  .cfj-pdp-stars { display: flex; gap: 3px; }
  .cfj-pdp-rating-num { font-size: 15px; font-weight: 800; color: #2C1810; }
  .cfj-pdp-rating-count { font-size: 13px; color: #8B7355; }
  .cfj-pdp-reviews-link { font-size: 13px; color: #D4AF37; text-decoration: underline; cursor: pointer; }

  /* Price */
  .cfj-pdp-price-wrap { margin-bottom: 28px; }
  .cfj-pdp-price-row {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 8px;
  }
  .cfj-pdp-price-current {
    font-size: 38px;
    font-weight: 800;
    color: #2C1810;
    font-family: 'Playfair Display', serif;
  }
  .cfj-pdp-price-original {
    font-size: 20px;
    color: #bbb;
    text-decoration: line-through;
  }
  .cfj-pdp-price-save {
    background: linear-gradient(135deg, #D4AF37, #F5D060);
    color: #2C1810;
    padding: 4px 14px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-pdp-price-note {
    font-size: 12px;
    color: #8B7355;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Metal / Purity Details */
  .cfj-pdp-specs {
    background: #FAF5ED;
    border: 1px solid rgba(212,175,55,0.1);
    padding: 20px 24px;
    margin-bottom: 28px;
  }
  .cfj-pdp-spec-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .cfj-pdp-spec {
    text-align: center;
    padding: 8px 0;
  }
  .cfj-pdp-spec-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #D4AF37;
    margin-bottom: 4px;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-pdp-spec-val {
    font-size: 15px;
    font-weight: 800;
    color: #2C1810;
    font-family: 'Playfair Display', serif;
  }

  /* ── Variant Selector (Size) ── */
  .cfj-pdp-size-label {
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 10px;
    color: #2C1810;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-pdp-sizes {
    display: flex;
    gap: 10px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  .cfj-pdp-size-btn {
    min-width: 52px;
    height: 44px;
    border: 1.5px solid #e0d5c9;
    background: #FFFCF5;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    color: #2C1810;
    padding: 0 16px;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-pdp-size-btn:hover { border-color: #D4AF37; }
  .cfj-pdp-size-btn.active {
    border-color: #D4AF37;
    background: linear-gradient(135deg, #D4AF37, #F5D060);
    color: #2C1810;
    font-weight: 800;
  }

  /* Quantity */
  .cfj-pdp-qty-label {
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 10px;
    color: #2C1810;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-pdp-qty-row {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 24px;
  }
  .cfj-pdp-qty {
    display: flex;
    align-items: center;
    border: 1.5px solid #e0d5c9;
    overflow: hidden;
  }
  .cfj-pdp-qty button {
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    font-size: 18px;
    cursor: pointer;
    color: #2C1810;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }
  .cfj-pdp-qty button:hover { background: #FAF5ED; }
  .cfj-pdp-qty span {
    width: 48px;
    text-align: center;
    font-size: 15px;
    font-weight: 700;
    border-left: 1.5px solid #e0d5c9;
    border-right: 1.5px solid #e0d5c9;
    line-height: 44px;
  }

  /* CTA Buttons */
  .cfj-pdp-atc {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 20px;
    background: #2C1810;
    color: #D4AF37;
    border: none;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.3s ease;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 12px;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-pdp-atc:hover {
    background: #1a0f0a;
    box-shadow: 0 8px 30px rgba(44,24,16,0.2);
    transform: translateY(-1px);
  }
  .cfj-pdp-buy {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 20px;
    background: linear-gradient(135deg, #D4AF37, #C5A028);
    color: #2C1810;
    border: none;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.3s ease;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 24px;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-pdp-buy:hover {
    background: linear-gradient(135deg, #E5C040, #D4AF37);
    box-shadow: 0 8px 30px rgba(212,175,55,0.3);
  }

  /* Trust */
  .cfj-pdp-trust {
    display: flex;
    gap: 20px;
    padding: 20px 0;
    border-top: 1px solid rgba(212,175,55,0.1);
    border-bottom: 1px solid rgba(212,175,55,0.1);
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  .cfj-pdp-trust-item {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: #5a4a3c;
    font-weight: 600;
    min-width: 120px;
  }
  .cfj-pdp-trust-icon { color: #D4AF37; flex-shrink: 0; }

  /* Accordion */
  .cfj-pdp-accordion { margin-top: 8px; }
  .cfj-pdp-acc-item {
    border-bottom: 1px solid rgba(212,175,55,0.1);
  }
  .cfj-pdp-acc-trigger {
    width: 100%;
    background: none;
    border: none;
    padding: 18px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    color: #2C1810;
    text-align: left;
    font-family: 'DM Sans', sans-serif;
    letter-spacing: 0.5px;
  }
  .cfj-pdp-acc-icon {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    color: #D4AF37;
  }
  .cfj-pdp-acc-item.open .cfj-pdp-acc-icon { transform: rotate(180deg); }
  .cfj-pdp-acc-content {
    display: none;
    padding: 0 0 18px;
    font-size: 14px;
    line-height: 1.9;
    color: #5a4a3c;
  }
  .cfj-pdp-acc-item.open .cfj-pdp-acc-content { display: block; }

  /* ── Craftsmanship Steps ── */
  .cfj-pdp-craft {
    background: #FAF5ED;
    padding: 70px 48px;
  }
  .cfj-pdp-craft-inner { max-width: 1320px; margin: 0 auto; }
  .cfj-pdp-craft-head {
    text-align: center;
    margin-bottom: 48px;
  }
  .cfj-pdp-craft-overline {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #D4AF37;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-pdp-craft-overline::before,
  .cfj-pdp-craft-overline::after {
    content: '';
    width: 40px;
    height: 1px;
    background: #D4AF37;
  }
  .cfj-pdp-craft-head h2 {
    font-size: 32px;
    font-weight: 700;
    color: #2C1810;
  }
  .cfj-pdp-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .cfj-pdp-step {
    text-align: center;
    padding: 32px 20px;
    background: #FFFCF5;
    border: 1px solid rgba(212,175,55,0.1);
    position: relative;
  }
  .cfj-pdp-step::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 40px;
    height: 2px;
    background: #D4AF37;
  }
  .cfj-pdp-step-num {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #D4AF37, #F5D060);
    color: #2C1810;
    font-size: 16px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    font-family: 'Playfair Display', serif;
  }
  .cfj-pdp-step h4 { font-size: 15px; font-weight: 700; margin-bottom: 8px; color: #2C1810; }
  .cfj-pdp-step p { font-size: 12px; color: #8B7355; line-height: 1.6; }

  /* ── Reviews ── */
  .cfj-pdp-reviews {
    padding: 70px 48px;
    background: #FFFCF5;
  }
  .cfj-pdp-reviews-inner { max-width: 1320px; margin: 0 auto; }
  .cfj-pdp-rev-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 36px;
  }
  .cfj-pdp-rev-header h2 { font-size: 30px; font-weight: 700; color: #2C1810; }
  .cfj-pdp-rev-avg {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .cfj-pdp-rev-avg-num {
    font-size: 52px;
    font-weight: 800;
    color: #D4AF37;
    font-family: 'Playfair Display', serif;
  }
  .cfj-pdp-rev-avg-meta { display: flex; flex-direction: column; gap: 4px; }
  .cfj-pdp-rev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .cfj-pdp-rev-card {
    background: #FAF5ED;
    padding: 28px;
    border: 1px solid rgba(212,175,55,0.1);
    position: relative;
  }
  .cfj-pdp-rev-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #D4AF37, #F5D060);
  }
  .cfj-pdp-rev-stars { display: flex; gap: 2px; margin-bottom: 14px; }
  .cfj-pdp-rev-text { font-size: 14px; color: #5a4a3c; line-height: 1.8; margin-bottom: 18px; font-style: italic; }
  .cfj-pdp-rev-author-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .cfj-pdp-rev-author { font-size: 13px; font-weight: 700; color: #2C1810; }
  .cfj-pdp-rev-verified {
    font-size: 11px;
    color: #D4AF37;
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .cfj-pdp-main { grid-template-columns: 1fr; padding: 24px 20px; gap: 36px; }
    .cfj-pdp-breadcrumb { padding: 12px 20px; }
    .cfj-pdp-title { font-size: 26px; }
    .cfj-pdp-price-current { font-size: 28px; }
    .cfj-pdp-spec-grid { grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
    .cfj-pdp-steps { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .cfj-pdp-rev-grid { grid-template-columns: 1fr; }
    .cfj-pdp-craft, .cfj-pdp-reviews { padding: 48px 20px; }
    .cfj-pdp-trust { flex-direction: column; gap: 12px; }
    .cfj-pdp-rev-header { flex-direction: column; gap: 16px; align-items: flex-start; }
  }
{% endstyle %}

<div class="cfj-pdp">
  {%- assign current_product = product -%}

  <!-- Breadcrumb -->
  <div class="cfj-pdp-breadcrumb">
    <a href="/">Home</a>
    <span>›</span>
    {%- if current_product.collections.first -%}
      <a href="{{ current_product.collections.first.url }}">{{ current_product.collections.first.title }}</a>
      <span>›</span>
    {%- endif -%}
    <span style="color:#2C1810;font-weight:600;">{{ current_product.title }}</span>
  </div>

  <!-- Main Product -->
  <div class="cfj-pdp-main">

    <!-- Gallery -->
    <div class="cfj-pdp-gallery">
      <div class="cfj-pdp-main-img" id="cfj-main-img">
        {%- if current_product.featured_image -%}
          <img src="{{ current_product.featured_image | image_url: width: 900 }}" alt="{{ current_product.title }}" id="cfj-main-img-el" loading="eager">
        {%- else -%}
          <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#FAF5ED;">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="0.8"><path d="M12 2L2 7l10 5 10-5-10-5Z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
        {%- endif -%}
        <div class="cfj-pdp-badges">
          {%- if current_product.compare_at_price > current_product.price -%}
            {%- assign save_pct = current_product.compare_at_price | minus: current_product.price | times: 100 | divided_by: current_product.compare_at_price -%}
            <span class="cfj-pdp-badge sale">{{ save_pct }}% OFF</span>
          {%- endif -%}
          <span class="cfj-pdp-badge certified">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2.5" style="margin-right:4px;display:inline"><polyline points="20 6 9 17 4 12"/></svg>
            BIS HALLMARKED
          </span>
        </div>
        <div class="cfj-pdp-zoom-hint">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6M8 11h6"/></svg>
          Hover to zoom
        </div>
      </div>
      {%- if current_product.images.size > 1 -%}
        <div class="cfj-pdp-thumbs">
          {%- for img in current_product.images limit: 4 -%}
            <div class="cfj-pdp-thumb {% if forloop.first %}active{% endif %}" onclick="cfjSwitchImg('{{ img | image_url: width: 900 }}', this)">
              <img src="{{ img | image_url: width: 200 }}" alt="{{ current_product.title }}" loading="lazy">
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Info -->
    <div class="cfj-pdp-info">
      <div class="cfj-pdp-meta">
        <span class="cfj-pdp-category">{{ section.settings.product_type_label | default: current_product.type | default: 'Gold Jewellery' }}</span>
        {%- if current_product.variants.first.sku != blank -%}
          <span class="cfj-pdp-sku">SKU: {{ current_product.variants.first.sku }}</span>
        {%- endif -%}
      </div>
      <h1 class="cfj-pdp-title">{{ current_product.title }}</h1>

      <!-- Rating -->
      <div class="cfj-pdp-rating-row">
        <div class="cfj-pdp-stars">
          {%- for i in (1..5) -%}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#D4AF37" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          {%- endfor -%}
        </div>
        <span class="cfj-pdp-rating-num">{{ section.settings.avg_rating | default: '4.9' }}</span>
        <span class="cfj-pdp-rating-count">({{ section.settings.review_total | default: '1,247' }} Reviews)</span>
        <a class="cfj-pdp-reviews-link" href="#cfj-reviews">Read reviews</a>
      </div>

      <!-- Price -->
      <div class="cfj-pdp-price-wrap">
        <div class="cfj-pdp-price-row">
          <span class="cfj-pdp-price-current">{{ current_product.price | money }}</span>
          {%- if current_product.compare_at_price > current_product.price -%}
            <span class="cfj-pdp-price-original">{{ current_product.compare_at_price | money }}</span>
            <span class="cfj-pdp-price-save">Save {{ save_pct | default: 0 }}%</span>
          {%- endif -%}
        </div>
        <div class="cfj-pdp-price-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          Inclusive of all taxes. Making charges waived.
        </div>
      </div>

      <!-- Metal Specs -->
      <div class="cfj-pdp-specs">
        <div class="cfj-pdp-spec-grid">
          <div class="cfj-pdp-spec">
            <div class="cfj-pdp-spec-label">Metal</div>
            <div class="cfj-pdp-spec-val">{{ section.settings.metal_type | default: '22KT Gold' }}</div>
          </div>
          <div class="cfj-pdp-spec">
            <div class="cfj-pdp-spec-label">Gross Wt.</div>
            <div class="cfj-pdp-spec-val">{{ section.settings.gross_weight | default: '8.25g' }}</div>
          </div>
          <div class="cfj-pdp-spec">
            <div class="cfj-pdp-spec-label">Purity</div>
            <div class="cfj-pdp-spec-val">{{ section.settings.purity | default: '916 HM' }}</div>
          </div>
        </div>
      </div>

      <!-- Size Selector -->
      {%- if current_product.variants.size > 1 -%}
        <p class="cfj-pdp-size-label">Select Size</p>
        <div class="cfj-pdp-sizes">
          {%- for variant in current_product.variants -%}
            <button type="button"
              class="cfj-pdp-size-btn {% if forloop.first %}active{% endif %}"
              onclick="cfjSelectVariant({{ variant.id }}, this)"
              {% unless variant.available %}disabled style="opacity:0.4;"{% endunless %}>
              {{ variant.title }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Quantity -->
      <p class="cfj-pdp-qty-label">Quantity</p>
      <div class="cfj-pdp-qty-row">
        <div class="cfj-pdp-qty">
          <button type="button" onclick="cfjQty(-1)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <span id="cfj-qty-val">1</span>
          <button type="button" onclick="cfjQty(1)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
        </div>
        <input type="number" name="quantity" id="cfj-qty-input" value="1" min="1" style="display:none">
        {%- if current_product.available -%}
          <span style="font-size:12px;color:#D4AF37;font-weight:700;display:flex;align-items:center;gap:6px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#D4AF37"><circle cx="12" cy="12" r="5"/></svg> In Stock
          </span>
        {%- else -%}
          <span style="font-size:12px;color:#8B2252;font-weight:700;">Out of Stock</span>
        {%- endif -%}
      </div>

      <!-- Add to Cart -->
      {%- form 'product', current_product, id: 'cfj-product-form' -%}
        <input type="hidden" name="id" id="cfj-variant-id" value="{{ current_product.selected_or_first_available_variant.id }}">
        <button type="submit" name="add" class="cfj-pdp-atc" {% unless current_product.available %}disabled{% endunless %}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          {% if current_product.available %}Add to Cart{% else %}Sold Out{% endif %}
        </button>
      {%- endform -%}

      <button class="cfj-pdp-buy" onclick="document.getElementById('cfj-product-form').submit()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        Buy It Now
      </button>

      <!-- Trust -->
      <div class="cfj-pdp-trust">
        <div class="cfj-pdp-trust-item">
          <svg class="cfj-pdp-trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          BIS Hallmarked
        </div>
        <div class="cfj-pdp-trust-item">
          <svg class="cfj-pdp-trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          Insured Shipping
        </div>
        <div class="cfj-pdp-trust-item">
          <svg class="cfj-pdp-trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Lifetime Exchange
        </div>
      </div>

      <!-- Accordion -->
      <div class="cfj-pdp-accordion">
        <div class="cfj-pdp-acc-item open">
          <button class="cfj-pdp-acc-trigger" onclick="cfjToggleAcc(this)">
            Product Description
            <svg class="cfj-pdp-acc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="cfj-pdp-acc-content">{{ current_product.description }}</div>
        </div>
        <div class="cfj-pdp-acc-item">
          <button class="cfj-pdp-acc-trigger" onclick="cfjToggleAcc(this)">
            Metal & Stone Details
            <svg class="cfj-pdp-acc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="cfj-pdp-acc-content">{{ section.settings.metal_details | default: 'Metal: 22KT Yellow Gold (916 Hallmark). Gross Weight: 8.25g. Net Weight: 7.80g. Stone: Natural Diamond, SI/GH, 0.45ct. Setting: Prong. Certification: BIS Hallmark, IGI Certified.' }}</div>
        </div>
        <div class="cfj-pdp-acc-item">
          <button class="cfj-pdp-acc-trigger" onclick="cfjToggleAcc(this)">
            Shipping & Returns
            <svg class="cfj-pdp-acc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="cfj-pdp-acc-content">{{ section.settings.shipping_info | default: 'Free insured shipping on all orders. Delivered in tamper-proof packaging within 5-7 business days. 15-day hassle-free return policy. Lifetime exchange at full value against new purchase. All products are fully insured during transit.' }}</div>
        </div>
        <div class="cfj-pdp-acc-item">
          <button class="cfj-pdp-acc-trigger" onclick="cfjToggleAcc(this)">
            Certifications
            <svg class="cfj-pdp-acc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="cfj-pdp-acc-content">{{ section.settings.certification_info | default: 'Every piece comes with a BIS Hallmark certificate guaranteeing metal purity. Diamond jewellery includes an IGI/GIA certificate. Our quality assurance process includes 68 individual checks by master craftsmen before dispatch.' }}</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Craftsmanship Steps -->
  <div class="cfj-pdp-craft">
    <div class="cfj-pdp-craft-inner">
      <div class="cfj-pdp-craft-head">
        <span class="cfj-pdp-craft-overline">Craftsmanship</span>
        <h2>{{ section.settings.craft_title | default: 'The Art Behind Every Piece' }}</h2>
      </div>
      <div class="cfj-pdp-steps">
        {%- for block in section.blocks -%}
          {%- if block.type == 'craft_step' -%}
            <div class="cfj-pdp-step">
              <div class="cfj-pdp-step-num">{{ forloop.index }}</div>
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.desc }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- if section.blocks == empty -%}
          <div class="cfj-pdp-step"><div class="cfj-pdp-step-num">1</div><h4>Design</h4><p>Master artisans sketch every curve and detail by hand</p></div>
          <div class="cfj-pdp-step"><div class="cfj-pdp-step-num">2</div><h4>Craft</h4><p>Skilled karigars shape molten gold with decades of expertise</p></div>
          <div class="cfj-pdp-step"><div class="cfj-pdp-step-num">3</div><h4>Set</h4><p>Precious stones are placed with micro-precision</p></div>
          <div class="cfj-pdp-step"><div class="cfj-pdp-step-num">4</div><h4>Certify</h4><p>68 quality checks and BIS hallmark verification</p></div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <!-- Reviews -->
  <div class="cfj-pdp-reviews" id="cfj-reviews">
    <div class="cfj-pdp-reviews-inner">
      <div class="cfj-pdp-rev-header">
        <h2>Customer Reviews</h2>
        <div class="cfj-pdp-rev-avg">
          <span class="cfj-pdp-rev-avg-num">{{ section.settings.avg_rating | default: '4.9' }}</span>
          <div class="cfj-pdp-rev-avg-meta">
            <div style="display:flex;gap:3px;">
              {%- for i in (1..5) -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#D4AF37" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {%- endfor -%}
            </div>
            <span style="font-size:12px;color:#8B7355;">Based on {{ section.settings.review_total | default: '1,247' }} reviews</span>
          </div>
        </div>
      </div>
      <div class="cfj-pdp-rev-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="cfj-pdp-rev-card">
              <div class="cfj-pdp-rev-stars">
                {%- for i in (1..block.settings.rating) -%}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="#D4AF37" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- endfor -%}
              </div>
              <p class="cfj-pdp-rev-text">"{{ block.settings.text }}"</p>
              <div class="cfj-pdp-rev-author-row">
                <span class="cfj-pdp-rev-author">{{ block.settings.name }}</span>
                <span class="cfj-pdp-rev-verified">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                  Verified
                </span>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  // Image switcher
  function cfjSwitchImg(src, thumb) {
    document.getElementById('cfj-main-img-el').src = src;
    document.querySelectorAll('.cfj-pdp-thumb').forEach(function(t) { t.classList.remove('active'); });
    thumb.classList.add('active');
  }

  // Quantity stepper
  var cfjQtyVal = 1;
  function cfjQty(delta) {
    cfjQtyVal = Math.max(1, cfjQtyVal + delta);
    document.getElementById('cfj-qty-val').textContent = cfjQtyVal;
    document.getElementById('cfj-qty-input').value = cfjQtyVal;
  }

  // Variant selector
  function cfjSelectVariant(variantId, btn) {
    document.getElementById('cfj-variant-id').value = variantId;
    document.querySelectorAll('.cfj-pdp-size-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
  }

  // Accordion
  function cfjToggleAcc(btn) {
    var item = btn.parentElement;
    item.classList.toggle('open');
  }
</script>

{% schema %}
{
  "name": "CF: Jewellery Product Page",
  "tag": "section",
  "class": "convertflow-jewellery-product",
  "settings": [
    { "type": "header", "content": "Product Info" },
    { "type": "text", "id": "product_type_label", "label": "Product Type Label", "default": "Gold Jewellery" },
    { "type": "text", "id": "avg_rating", "label": "Average Rating", "default": "4.9" },
    { "type": "text", "id": "review_total", "label": "Total Reviews", "default": "1,247" },
    { "type": "header", "content": "Metal Specifications" },
    { "type": "text", "id": "metal_type", "label": "Metal Type", "default": "22KT Gold" },
    { "type": "text", "id": "gross_weight", "label": "Gross Weight", "default": "8.25g" },
    { "type": "text", "id": "purity", "label": "Purity", "default": "916 HM" },
    { "type": "header", "content": "Content" },
    { "type": "textarea", "id": "metal_details", "label": "Metal & Stone Details" },
    { "type": "textarea", "id": "shipping_info", "label": "Shipping & Returns Info" },
    { "type": "textarea", "id": "certification_info", "label": "Certification Info" },
    { "type": "header", "content": "Craftsmanship Section" },
    { "type": "text", "id": "craft_title", "label": "Title", "default": "The Art Behind Every Piece" }
  ],
  "blocks": [
    {
      "type": "craft_step",
      "name": "Craftsmanship Step",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Step Title", "default": "Design" },
        { "type": "text", "id": "desc", "label": "Step Description", "default": "Master artisans sketch every curve and detail by hand" }
      ]
    },
    {
      "type": "review",
      "name": "Customer Review",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "name", "label": "Customer Name", "default": "Ananya S." },
        { "type": "textarea", "id": "text", "label": "Review Text", "default": "The craftsmanship is exceptional. Every detail is perfect." },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF: Jewellery Product Page",
      "blocks": [
        { "type": "craft_step", "settings": { "title": "Design", "desc": "Master artisans sketch every curve and detail by hand" } },
        { "type": "craft_step", "settings": { "title": "Craft", "desc": "Skilled karigars shape molten gold with decades of expertise" } },
        { "type": "craft_step", "settings": { "title": "Set", "desc": "Precious stones are placed with micro-precision and care" } },
        { "type": "craft_step", "settings": { "title": "Certify", "desc": "68 quality checks and BIS hallmark verification" } },
        { "type": "review", "settings": { "name": "Ananya S.", "text": "The craftsmanship is exceptional. Every detail is perfect and the gold purity is exactly as promised. A true heirloom piece.", "rating": 5 } },
        { "type": "review", "settings": { "name": "Priya M.", "text": "Bought my wedding set from here. The diamond quality is outstanding and it arrived in the most luxurious packaging.", "rating": 5 } },
        { "type": "review", "settings": { "name": "Kavitha R.", "text": "Beautiful gold necklace with impeccable finishing. The hallmark certificate gives complete confidence. Will buy again.", "rating": 5 } }
      ]
    }
  ]
}
{% endschema %}
