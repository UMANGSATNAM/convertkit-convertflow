// sections/cf-shared-features.liquid
// Features / USP Bar — with blocks so each feature is addable/removable

<style>
.cf-feat-sec { background: #fff; border-top: 1px solid #eee; border-bottom: 1px solid #eee; }
.cf-feat-inner { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); max-width: 1400px; margin: 0 auto; }
.cf-feat-item { padding: 36px 28px; display: flex; align-items: flex-start; gap: 16px; border-right: 1px solid #eee; }
.cf-feat-item:last-child { border-right: none; }
.cf-feat-icon { width: 44px; height: 44px; background: color-mix(in srgb, var(--cf-accent, #000) 10%, #fff); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: var(--cf-accent, #000); font-size: 20px; }
.cf-feat-t { font-size: 14px; font-weight: 700; margin-bottom: 4px; color: #1a1a1a; }
.cf-feat-s { font-size: 12px; color: #888; line-height: 1.5; }
@media(max-width:768px) { .cf-feat-inner { grid-template-columns: 1fr 1fr; } .cf-feat-item { border-right: none; border-bottom: 1px solid #eee; } }
</style>

{% if section.blocks.size > 0 %}
<div class="cf-feat-sec">
  <div class="cf-feat-inner">
    {% for block in section.blocks %}
      {% if block.type == 'feature' %}
      <div class="cf-feat-item" {{ block.shopify_attributes }}>
        <div class="cf-feat-icon">{{ block.settings.icon | default: '✓' }}</div>
        <div>
          <div class="cf-feat-t">{{ block.settings.title | default: 'Feature' }}</div>
          <div class="cf-feat-s">{{ block.settings.subtitle }}</div>
        </div>
      </div>
      {% endif %}
    {% endfor %}
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "CF Features Bar",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji or symbol)", "default": "✓" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free Delivery" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "On orders above Rs.999" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF Features Bar",
      "blocks": [
        { "type": "feature", "settings": { "icon": "✓", "title": "Free Delivery", "subtitle": "On orders above Rs.999" } },
        { "type": "feature", "settings": { "icon": "↩", "title": "Easy Returns", "subtitle": "30-day hassle-free" } },
        { "type": "feature", "settings": { "icon": "★", "title": "100% Authentic", "subtitle": "Certified genuine products" } },
        { "type": "feature", "settings": { "icon": "⚡", "title": "Secure Checkout", "subtitle": "SSL encrypted payment" } }
      ]
    }
  ]
}
{% endschema %}
