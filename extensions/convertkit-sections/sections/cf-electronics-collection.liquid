{% comment %}
  ConvertFlow — Electronics Collection Page
  High-tech grid with filter sidebar.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Inter:wght@400;500&display=swap');

  :root {
    --el-primary: {{ section.settings.color_primary | default: '#00F0FF' }};
    --el-bg: {{ section.settings.color_bg | default: '#030508' }};
    --el-surface: {{ section.settings.color_surface | default: '#0C121E' }};
    --el-border: rgba(0, 240, 255, 0.15);
    --el-text: {{ section.settings.color_text | default: '#FFFFFF' }};
    --el-font-heading: 'Rajdhani', sans-serif;
    --el-font-body: 'Inter', sans-serif;
  }

  .cf-el-c * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-el-c { font-family: var(--el-font-body); background: var(--el-bg); color: var(--el-text); border-top: 1px solid var(--el-border); }
  
  .cf-el-c-header { padding: 60px 5%; background: radial-gradient(circle at top right, rgba(0,240,255,0.1), transparent 50%); border-bottom: 1px solid var(--el-border); }
  .cf-el-c-header h1 { font-family: var(--el-font-heading); font-size: clamp(40px, 6vw, 64px); font-weight: 700; text-transform: uppercase; margin-bottom: 10px; text-shadow: 0 0 20px rgba(0,240,255,0.2); }
  .cf-el-c-header p { color: #8B9BB4; max-width: 600px; font-size: 15px; }
  
  .cf-el-c-wrap { display: grid; grid-template-columns: 250px 1fr; max-width: 1400px; margin: 0 auto; min-height: 70vh; }
  
  /* Sidebar */
  .cf-el-c-sidebar { border-right: 1px solid var(--el-border); padding: 40px 30px; background: var(--el-surface); }
  .cf-el-c-filter-group { margin-bottom: 30px; }
  .cf-el-c-filter-title { font-family: var(--el-font-heading); font-size: 18px; font-weight: 600; text-transform: uppercase; color: var(--el-primary); margin-bottom: 16px; letter-spacing: 1px; }
  .cf-el-c-filter-list { list-style: none; }
  .cf-el-c-filter-list li { margin-bottom: 10px; font-size: 14px; color: #8B9BB4; cursor: pointer; transition: color 0.2s; display: flex; align-items: center; gap: 10px; }
  .cf-el-c-filter-list li:hover, .cf-el-c-filter-list li.active { color: var(--el-text); }
  .cf-el-c-filter-list li::before { content: ''; display: inline-block; width: 12px; height: 12px; border: 1px solid var(--el-border); }
  .cf-el-c-filter-list li.active::before { background: var(--el-primary); box-shadow: 0 0 10px var(--el-primary); border-color: var(--el-primary); }
  
  /* Grid */
  .cf-el-c-main { padding: 40px; }
  .cf-el-c-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 1px solid var(--el-border); }
  .cf-el-c-toolbar-count { font-family: var(--el-font-heading); font-size: 16px; font-weight: 600; color: #8B9BB4; text-transform: uppercase; }
  .cf-el-c-sort select { background: var(--el-surface); color: var(--el-primary); border: 1px solid var(--el-primary); padding: 10px 16px; font-family: var(--el-font-heading); font-size: 14px; font-weight: 600; text-transform: uppercase; outline: none; cursor: pointer; }
  
  .cf-el-c-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 30px; }
  .cf-el-prod { background: var(--el-surface); border: 1px solid var(--el-border); padding: 20px; text-decoration: none; transition: all 0.3s; position: relative; display: flex; flex-direction: column; }
  .cf-el-prod:hover { border-color: var(--el-primary); box-shadow: 0 0 20px rgba(0,240,255,0.1); transform: translateY(-3px); }
  
  .cf-el-prod-img { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at center, #111a28 0%, #030508 100%); margin-bottom: 20px; padding: 20px; }
  .cf-el-prod-img img { max-width: 100%; max-height: 100%; object-fit: contain; filter: drop-shadow(0 5px 15px rgba(0,0,0,0.5)); transition: transform 0.5s; }
  .cf-el-prod:hover .cf-el-prod-img img { transform: scale(1.05); }
  
  .cf-el-prod-tag { position: absolute; top: 10px; right: 10px; font-family: var(--el-font-heading); font-size: 12px; font-weight: 600; color: #000; background: var(--el-primary); padding: 2px 8px; text-transform: uppercase; z-index: 2; }
  
  .cf-el-prod-title { font-family: var(--el-font-heading); font-size: 20px; font-weight: 600; color: #fff; margin-bottom: 8px; text-transform: uppercase; }
  .cf-el-prod-price { color: var(--el-primary); font-family: var(--el-font-heading); font-size: 22px; font-weight: 700; margin-top: auto; }

  @media(max-width: 1024px) {
    .cf-el-c-wrap { grid-template-columns: 1fr; }
    .cf-el-c-sidebar { border-right: none; border-bottom: 1px solid var(--el-border); display: flex; gap: 40px; overflow-x: auto; }
  }
{% endstyle %}

<div class="cf-el-c">
  <div class="cf-el-c-header">
    <h1>{{ collection.title | default: 'Hardware Catalog' }}</h1>
    {% if collection.description != blank %}
      <p>{{ collection.description | strip_html | truncate: 150 }}</p>
    {% endif %}
  </div>
  
  <div class="cf-el-c-wrap">
    <div class="cf-el-c-sidebar">
      <div class="cf-el-c-filter-group">
        <div class="cf-el-c-filter-title">Category</div>
        <ul class="cf-el-c-filter-list">
          <li class="active">All Devices</li>
          <li>Processing Units</li>
          <li>Display Tech</li>
          <li>Audio Systems</li>
        </ul>
      </div>
      <div class="cf-el-c-filter-group">
        <div class="cf-el-c-filter-title">Status</div>
        <ul class="cf-el-c-filter-list">
          <li>In Stock</li>
          <li>Pre-order</li>
          <li>New Releases</li>
        </ul>
      </div>
    </div>
    
    <div class="cf-el-c-main">
      <div class="cf-el-c-toolbar">
        <div class="cf-el-c-toolbar-count">{{ collection.products_count | default: '0' }} Modules Found</div>
        <div class="cf-el-c-sort">
          <select>
            <option>Sort: Default Configuration</option>
            <option>Sort: Price (Ascending)</option>
            <option>Sort: Price (Descending)</option>
          </select>
        </div>
      </div>
      
      <div class="cf-el-c-grid">
        {% if collection.products.size > 0 %}
          {% for product in collection.products %}
            <a href="{{ product.url }}" class="cf-el-prod">
              {% if product.available == false %}
                <div class="cf-el-prod-tag" style="background:#555; color:#fff;">Offline</div>
              {% elsif product.compare_at_price > product.price %}
                <div class="cf-el-prod-tag">Upgrade Offer</div>
              {% endif %}
              
              <div class="cf-el-prod-img">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}">
                {% endif %}
              </div>
              <div class="cf-el-prod-title">{{ product.title }}</div>
              <div class="cf-el-prod-price">{{ product.price | money }}</div>
            </a>
          {% endfor %}
        {% else %}
          {% for i in (1..6) %}
            <a href="#" class="cf-el-prod">
              <div class="cf-el-prod-img"><div style="width:100px; height:100px; background:rgba(255,255,255,0.05);"></div></div>
              <div class="cf-el-prod-title">System Module 0{{ i }}</div>
              <div class="cf-el-prod-price">$499.00</div>
            </a>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CF Electronics Collection",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Primary Accent (Neon)", "default": "#00F0FF" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#030508" },
    { "type": "color", "id": "color_surface", "label": "Surface", "default": "#0C121E" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "CF Electronics Collection" }
  ]
}
{% endschema %}