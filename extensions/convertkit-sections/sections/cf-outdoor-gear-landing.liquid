{% comment %}ConvertFlow - Outdoor Gear Landing | SUMMIT style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
.cfog{--pr:#2C4C3B;--prd:#1E3629;--ac:#E65100;--bg:#F4F4F0;--sf:#fff;--text:#212121;--mu:#757575;--bd:#DCDCD5;}
.cfog *{box-sizing:border-box;margin:0;padding:0;}
.cfog{background:var(--bg);color:var(--text);font-family:'Roboto',sans-serif;font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased;}
.cfog h1,.cfog h2,.cfog h3{font-family:'Oswald',sans-serif;text-transform:uppercase;}
.cfog-topbar{background:var(--text);color:#fff;padding:6px 40px;display:flex;justify-content:space-between;font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;}
.cfog-header{background:var(--pr);padding:20px 40px;display:grid;grid-template-columns:auto 1fr auto;gap:40px;align-items:center;border-bottom:4px solid var(--text);}
.cfog-brand{font-family:'Oswald',sans-serif;font-size:36px;font-weight:700;color:#fff;text-decoration:none;letter-spacing:2px;}
.cfog-brand span{color:var(--ac);}
.cfog-search{display:flex;height:48px;border:3px solid var(--text);border-radius:4px;overflow:hidden;background:#fff;box-shadow:4px 4px 0px var(--text);}
.cfog-search input{flex-grow:1;border:none;padding:0 16px;font-size:16px;font-family:'Roboto',sans-serif;font-weight:500;outline:none;}
.cfog-search button{background:var(--text);color:#fff;border:none;padding:0 24px;font-family:'Oswald',sans-serif;font-size:16px;font-weight:600;letter-spacing:1px;cursor:pointer;transition:background .2s;}
.cfog-search button:hover{background:var(--ac);}
.cfog-hact{display:flex;gap:24px;align-items:center;}
.cfog-hlink{color:#fff;text-decoration:none;font-family:'Oswald',sans-serif;font-size:16px;letter-spacing:1px;display:flex;align-items:center;gap:8px;transition:color .2s;}
.cfog-hlink:hover{color:var(--ac);}
.cfog-hero{background:linear-gradient(135deg,var(--prd) 0%,var(--pr) 100%);min-height:85vh;display:grid;grid-template-columns:1fr 1fr;padding:0 60px;align-items:center;gap:60px;position:relative;overflow:hidden;}
.cfog-hero::before{content:'SUMMIT';position:absolute;right:-40px;top:50%;transform:translateY(-50%) rotate(90deg);font-family:'Oswald',sans-serif;font-size:200px;font-weight:700;color:rgba(255,255,255,.04);letter-spacing:10px;white-space:nowrap;}
.cfog-h-badge{display:inline-flex;align-items:center;gap:8px;background:var(--ac);color:#fff;padding:6px 16px;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:20px;}
.cfog-hero h1{font-size:72px;line-height:.95;color:#fff;margin-bottom:24px;}
.cfog-hero h1 span{color:var(--ac);}
.cfog-hero>div>p{font-size:17px;color:rgba(255,255,255,.65);line-height:1.8;max-width:440px;margin-bottom:40px;}
.cfog-btns{display:flex;gap:12px;}
.cfog-btn-ac{background:var(--ac);color:#fff;padding:18px 40px;font-family:'Oswald',sans-serif;font-size:16px;font-weight:700;letter-spacing:2px;text-transform:uppercase;text-decoration:none;border:3px solid var(--ac);transition:all .2s;box-shadow:4px 4px 0px rgba(0,0,0,.5);}
.cfog-btn-ac:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0px rgba(0,0,0,.5);}
.cfog-btn-out{background:transparent;color:#fff;border:3px solid rgba(255,255,255,.4);padding:16px 40px;font-family:'Oswald',sans-serif;font-size:16px;font-weight:700;letter-spacing:2px;text-transform:uppercase;text-decoration:none;transition:all .2s;}
.cfog-btn-out:hover{border-color:#fff;}
.cfog-hero-stats{display:flex;gap:40px;margin-top:48px;padding-top:40px;border-top:1px solid rgba(255,255,255,.15);}
.cfog-stat strong{display:block;font-family:'Oswald',sans-serif;font-size:32px;color:var(--ac);}
.cfog-stat span{font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.5);}
.cfog-hero-vis{display:flex;align-items:center;justify-content:center;position:relative;z-index:1;}
.cfog-vis-frame{width:420px;height:480px;background:rgba(255,255,255,.05);border:2px solid rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;position:relative;}
.cfog-vis-frame::before{content:'';position:absolute;inset:16px;border:1px solid rgba(230,81,0,.3);}
.cfog-vis-frame svg{width:50%;color:rgba(230,81,0,.4);}
.cfog-cats{background:var(--text);padding:0;}
.cfog-cat-row{display:grid;grid-template-columns:repeat(5,1fr);}
.cfog-cat{padding:32px 20px;text-align:center;border-right:1px solid rgba(255,255,255,.08);text-decoration:none;color:#fff;transition:background .2s;}
.cfog-cat:last-child{border-right:none;}
.cfog-cat:hover{background:var(--ac);}
.cfog-cat-label{font-family:'Oswald',sans-serif;font-size:16px;letter-spacing:2px;display:block;margin-bottom:4px;}
.cfog-cat-count{font-size:11px;color:rgba(255,255,255,.5);letter-spacing:1px;text-transform:uppercase;}
.cfog-prods{padding:80px 60px;max-width:1400px;margin:0 auto;}
.cfog-ph{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:48px;}
.cfog-ph h2{font-size:52px;color:var(--text);}
.cfog-ph a{font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--pr);text-decoration:none;border-bottom:2px solid var(--pr);padding-bottom:2px;}
.cfog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;}
.cfog-card{background:var(--sf);border:2px solid var(--bd);transition:all .3s;position:relative;}
.cfog-card:hover{border-color:var(--ac);box-shadow:6px 6px 0px var(--text);transform:translate(-3px,-3px);}
.cfog-card-img{aspect-ratio:4/3;background:#e8ede8;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.cfog-card-img img{width:100%;height:100%;object-fit:cover;}
.cfog-card-img svg{width:35%;color:var(--pr);opacity:.3;}
.cfog-card-badge{position:absolute;top:0;left:0;background:var(--ac);color:#fff;font-family:'Oswald',sans-serif;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:6px 14px;}
.cfog-card-body{padding:24px;}
.cfog-card-cat{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--pr);margin-bottom:8px;}
.cfog-card-name{font-family:'Oswald',sans-serif;font-size:22px;margin-bottom:8px;color:var(--text);}
.cfog-card-spec{font-size:13px;color:var(--mu);margin-bottom:16px;}
.cfog-card-foot{display:flex;justify-content:space-between;align-items:center;border-top:2px solid var(--bd);padding-top:16px;}
.cfog-card-price{font-family:'Oswald',sans-serif;font-size:24px;color:var(--text);}
.cfog-card-old{font-size:14px;color:var(--mu);text-decoration:line-through;margin-left:8px;}
.cfog-atc{background:var(--pr);color:#fff;border:none;padding:12px 24px;font-family:'Oswald',sans-serif;font-size:14px;font-weight:700;letter-spacing:1px;text-transform:uppercase;cursor:pointer;transition:background .2s;}
.cfog-atc:hover{background:var(--ac);}
.cfog-trust{background:var(--pr);padding:60px;display:grid;grid-template-columns:repeat(4,1fr);gap:40px;}
.cfog-ti{text-align:center;color:#fff;}
.cfog-ti-icon{width:60px;height:60px;border:2px solid rgba(255,255,255,.3);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;}
.cfog-ti strong{font-family:'Oswald',sans-serif;font-size:18px;letter-spacing:1px;display:block;margin-bottom:6px;}
.cfog-ti span{font-size:13px;color:rgba(255,255,255,.6);}
.cfog-footer{background:var(--text);padding:80px 60px 40px;}
.cfog-fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;padding-bottom:60px;border-bottom:1px solid rgba(255,255,255,.08);}
.cfog-fb a{font-family:'Oswald',sans-serif;font-size:28px;font-weight:700;color:#fff;text-decoration:none;display:block;margin-bottom:16px;letter-spacing:2px;}
.cfog-fb a span{color:var(--ac);}
.cfog-fb p{font-size:13px;color:rgba(255,255,255,.4);line-height:1.9;max-width:260px;}
.cfog-fc h4{font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:2px;color:rgba(255,255,255,.4);margin-bottom:20px;}
.cfog-fc ul{list-style:none;}
.cfog-fc li{margin-bottom:10px;}
.cfog-fc a{color:rgba(255,255,255,.5);text-decoration:none;font-size:14px;transition:color .2s;}
.cfog-fc a:hover{color:var(--ac);}
.cfog-fbot{display:flex;justify-content:space-between;padding-top:28px;font-size:11px;color:rgba(255,255,255,.2);letter-spacing:1px;}
@media(max-width:1024px){.cfog-hero{grid-template-columns:1fr;min-height:auto}.cfog-hero-vis{display:none}.cfog-grid{grid-template-columns:repeat(2,1fr)}.cfog-trust{grid-template-columns:repeat(2,1fr)}.cfog-fg{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cfog-topbar,.cfog-search{display:none}.cfog-header{grid-template-columns:1fr auto;padding:16px 20px;gap:16px}.cfog-hero{padding:60px 20px}.cfog-hero h1{font-size:48px}.cfog-cat-row{grid-template-columns:repeat(3,1fr)}.cfog-prods{padding:60px 20px}.cfog-grid{grid-template-columns:1fr}.cfog-trust{grid-template-columns:1fr;padding:40px 20px}.cfog-fg{grid-template-columns:1fr;gap:40px}.cfog-footer{padding:60px 20px 30px}}
</style>
<div class="cfog">
  <div class="cfog-topbar"><span>{{ section.settings.promo_left | default: 'Free Shipping on orders ₹999+' }}</span><span>{{ section.settings.promo_right | default: '30-Day Return Policy · Lifetime Warranty on Gear' }}</span></div>
  <header class="cfog-header">
    <a href="{{ routes.root_url }}" class="cfog-brand">{{ section.settings.brand_name | default: 'SUM' }}<span>MIT</span></a>
    <div class="cfog-search"><input type="text" placeholder="Search gear, clothing, footwear..."><button>SEARCH</button></div>
    <div class="cfog-hact"><a href="{{ routes.cart_url }}" class="cfog-hlink"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" width="20"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>Cart ({{ cart.item_count }})</a></div>
  </header>
  <section class="cfog-hero">
    <div>
      <div class="cfog-h-badge">{{ section.settings.hero_badge | default: 'NEW SEASON DROPS' }}</div>
      <h1>{{ section.settings.hero_h1 | default: 'Gear Up. <span>Go Further.</span>' }}</h1>
      <p>{{ section.settings.hero_sub | default: 'Precision outdoor equipment engineered for the toughest terrain. From base camp to summit — trust Summit to get you there.' }}</p>
      <div class="cfog-btns">
        <a href="{{ section.settings.cta1_url | default: routes.collections_url }}" class="cfog-btn-ac">{{ section.settings.cta1_text | default: 'Shop Gear' }}</a>
        <a href="{{ section.settings.cta2_url | default: '#' }}" class="cfog-btn-out">{{ section.settings.cta2_text | default: 'View Catalog' }}</a>
      </div>
      <div class="cfog-hero-stats">
        <div class="cfog-stat"><strong>15K+</strong><span>Expeditions Equipped</span></div>
        <div class="cfog-stat"><strong>8★</strong><span>Avg Product Rating</span></div>
        <div class="cfog-stat"><strong>Free</strong><span>Shipping ₹999+</span></div>
      </div>
    </div>
    <div class="cfog-hero-vis"><div class="cfog-vis-frame"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.8"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg></div></div>
  </section>
  <div class="cfog-cats">
    <div class="cfog-cat-row">
      <a href="#" class="cfog-cat"><span class="cfog-cat-label">Tents</span><span class="cfog-cat-count">40+ styles</span></a>
      <a href="#" class="cfog-cat"><span class="cfog-cat-label">Backpacks</span><span class="cfog-cat-count">60+ styles</span></a>
      <a href="#" class="cfog-cat"><span class="cfog-cat-label">Footwear</span><span class="cfog-cat-count">80+ styles</span></a>
      <a href="#" class="cfog-cat"><span class="cfog-cat-label">Climbing</span><span class="cfog-cat-count">50+ items</span></a>
      <a href="#" class="cfog-cat"><span class="cfog-cat-label">Navigation</span><span class="cfog-cat-count">30+ items</span></a>
    </div>
  </div>
  <section class="cfog-prods">
    <div class="cfog-ph"><h2>Top Gear</h2><a href="{{ routes.collections_url }}">Full Catalog →</a></div>
    <div class="cfog-grid">
      {% assign col = collections[section.settings.featured_collection] %}
      {% if col and col.products.size > 0 %}
        {% for p in col.products limit: 3 %}
          <div class="cfog-card">
            <div class="cfog-card-img">{% if p.featured_image %}<img src="{{ p.featured_image | img_url: '600x' }}" alt="{{ p.title }}">{% else %}<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path d="M8 3H5a2 2 0 0 0-2 2v3"/></svg>{% endif %}{% if p.compare_at_price > p.price %}<span class="cfog-card-badge">Sale</span>{% endif %}</div>
            <div class="cfog-card-body"><div class="cfog-card-cat">{{ p.type | default: 'Outdoor Gear' }}</div><div class="cfog-card-name">{{ p.title }}</div><div class="cfog-card-spec">{{ p.metafields.custom.spec | default: 'High-Performance · Weatherproof' }}</div><div class="cfog-card-foot"><div class="cfog-card-price">{{ p.price | money }}{% if p.compare_at_price > p.price %}<span class="cfog-card-old">{{ p.compare_at_price | money }}</span>{% endif %}</div><button class="cfog-atc" data-variant-id="{{ p.variants.first.id }}">Add to Cart</button></div></div>
          </div>
        {% endfor %}
      {% else %}
        <div class="cfog-card"><div class="cfog-card-img" style="background:#cfd8dc;"><span class="cfog-card-badge">New</span><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.8" width="80" opacity="0.4"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></div><div class="cfog-card-body"><div class="cfog-card-cat">Tents</div><div class="cfog-card-name">Alpine Pro 3 Tent</div><div class="cfog-card-spec">3-Season · Ultralight · 4000mm HH</div><div class="cfog-card-foot"><div class="cfog-card-price">&#8377;24,999<span class="cfog-card-old">&#8377;29,999</span></div><button class="cfog-atc">Add to Cart</button></div></div></div>
        <div class="cfog-card"><div class="cfog-card-img" style="background:#b0bec5;"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.8" width="80" opacity="0.4"><path d="M20 9H4l1 12h14z"/><path d="M8 9V6a4 4 0 0 1 8 0v3"/></svg></div><div class="cfog-card-body"><div class="cfog-card-cat">Backpacks</div><div class="cfog-card-name">Trailblazer 55L Pack</div><div class="cfog-card-spec">55L · HDPE Frame · Hip Belt</div><div class="cfog-card-foot"><div class="cfog-card-price">&#8377;8,999</div><button class="cfog-atc">Add to Cart</button></div></div></div>
        <div class="cfog-card"><div class="cfog-card-img" style="background:#a5d6a7;"><span class="cfog-card-badge">Sale</span><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.8" width="80" opacity="0.4"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15 15 0 0 1 4 10 15 15 0 0 1-4 10"/></svg></div><div class="cfog-card-body"><div class="cfog-card-cat">Navigation</div><div class="cfog-card-name">TrailNav GPS Watch</div><div class="cfog-card-spec">Topographic Maps · 30hr Battery</div><div class="cfog-card-foot"><div class="cfog-card-price">&#8377;18,999<span class="cfog-card-old">&#8377;24,999</span></div><button class="cfog-atc">Add to Cart</button></div></div></div>
      {% endif %}
    </div>
  </section>
  <div class="cfog-trust">
    <div class="cfog-ti"><div class="cfog-ti-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" width="28"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><strong>Lifetime Warranty</strong><span>On all hardshell gear</span></div>
    <div class="cfog-ti"><div class="cfog-ti-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" width="28"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></div><strong>Field Tested</strong><span>By professional mountaineers</span></div>
    <div class="cfog-ti"><div class="cfog-ti-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" width="28"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/></svg></div><strong>Free Shipping</strong><span>On orders above ₹999</span></div>
    <div class="cfog-ti"><div class="cfog-ti-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" width="28"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg></div><strong>30-Day Returns</strong><span>No questions asked</span></div>
  </div>
  <footer class="cfog-footer">
    <div class="cfog-fg">
      <div class="cfog-fb"><a href="{{ routes.root_url }}">{{ section.settings.brand_name | default: 'SUM' }}<span>MIT</span></a><p>Precision outdoor equipment for those who demand the best from their gear and themselves.</p></div>
      <div class="cfog-fc"><h4>Shop</h4><ul><li><a href="#">Tents</a></li><li><a href="#">Backpacks</a></li><li><a href="#">Footwear</a></li><li><a href="#">Climbing</a></li></ul></div>
      <div class="cfog-fc"><h4>Company</h4><ul><li><a href="#">Our Story</a></li><li><a href="#">Field Blog</a></li><li><a href="#">Athletes</a></li></ul></div>
      <div class="cfog-fc"><h4>Support</h4><ul><li><a href="#">Track Order</a></li><li><a href="#">Returns</a></li><li><a href="#">Warranty</a></li><li><a href="#">Contact</a></li></ul></div>
    </div>
    <div class="cfog-fbot"><span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'Summit' }} Outdoor Gear.</span><span>Privacy &middot; Terms</span></div>
  </footer>
</div>
{% schema %}
{
  "name": "Outdoor Gear Landing",
  "settings": [
    {"type":"text","id":"brand_name","label":"Brand Name","default":"SUMMIT"},
    {"type":"text","id":"promo_left","label":"Topbar Left Text","default":"Free Shipping on orders ₹999+"},
    {"type":"text","id":"promo_right","label":"Topbar Right Text","default":"30-Day Return Policy · Lifetime Warranty on Gear"},
    {"type":"text","id":"hero_badge","label":"Hero Badge","default":"NEW SEASON DROPS"},
    {"type":"textarea","id":"hero_h1","label":"Hero Heading","default":"Gear Up. Go Further."},
    {"type":"textarea","id":"hero_sub","label":"Hero Subtext","default":"Precision outdoor equipment engineered for the toughest terrain."},
    {"type":"text","id":"cta1_text","label":"CTA 1 Text","default":"Shop Gear"},
    {"type":"url","id":"cta1_url","label":"CTA 1 URL"},
    {"type":"text","id":"cta2_text","label":"CTA 2 Text","default":"View Catalog"},
    {"type":"url","id":"cta2_url","label":"CTA 2 URL"},
    {"type":"collection","id":"featured_collection","label":"Featured Collection"}
  ],
  "presets": [{"name":"Outdoor Gear Landing"}]
}
{% endschema %}