    <div style="background:#fff;border:1px solid #eee;padding:32px"><p style="font-size:14px;line-height:1.8;color:#555;font-style:italic;margin-bottom:20px">&ldquo;{{ section.settings.t2_text }}&rdquo;</p><div style="font-size:13px;font-weight:700;color:var(--cf-accent,#E07B2A)">{{ section.settings.t2_auth }}</div></div>
    <div style="background:#fff;border:1px solid #eee;padding:32px"><p style="font-size:14px;line-height:1.8;color:#555;font-style:italic;margin-bottom:20px">&ldquo;{{ section.settings.t3_text }}&rdquo;</p><div style="font-size:13px;font-weight:700;color:var(--cf-accent,#E07B2A)">{{ section.settings.t3_auth }}</div></div>
