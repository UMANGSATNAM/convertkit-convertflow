{% comment %}ConvertFlow - Ayurveda Wellness Landing | AYURVA style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Yatra+One&family=Hind:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
.cfaw *{box-sizing:border-box;margin:0;padding:0}
.cfaw{font-family:'Hind',sans-serif;font-size:16px;color:#2A2018;background:#FBF6EF;-webkit-font-smoothing:antialiased}
.cfaw h1,.cfaw h2,.cfaw h3{font-family:'Yatra One',cursive;font-weight:400}
/* ANNOUNCE */
.cfaw-ann{background:#2E4B35;color:#fff;text-align:center;padding:10px;font-size:12px;letter-spacing:2px}
/* HERO */
.cfaw-hero{min-height:90vh;background:linear-gradient(135deg,#FDF8F0 0%,#F5EDE0 100%);display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:0 60px;position:relative;overflow:hidden}
.cfaw-hero::before{content:'';position:absolute;right:-100px;top:50%;transform:translateY(-50%);width:700px;height:700px;border-radius:50%;border:1px solid rgba(201,168,76,.15)}
.cfaw-label{font-size:12px;font-weight:600;letter-spacing:4px;text-transform:uppercase;color:#E07B2A;margin-bottom:20px;display:block}
.cfaw-hero h1{font-size:72px;line-height:1.05;color:#2E4B35;margin-bottom:24px}
.cfaw-hero p{font-size:17px;color:#7A6A58;line-height:1.9;max-width:440px;margin-bottom:40px}
.cfaw-btns{display:flex;gap:16px}
.cfaw-btn-forest{background:#2E4B35;color:#fff;padding:16px 40px;font-family:'Hind',sans-serif;font-size:13px;font-weight:600;letter-spacing:1px;text-decoration:none;transition:background .2s;display:inline-block}
.cfaw-btn-forest:hover{background:#E07B2A}
.cfaw-btn-gold{background:transparent;border:1.5px solid #C9A84C;color:#C9A84C;padding:15px 40px;font-family:'Hind',sans-serif;font-size:13px;font-weight:600;letter-spacing:1px;text-decoration:none;transition:all .2s;display:inline-block}
.cfaw-btn-gold:hover{background:#C9A84C;color:#fff}
.cfaw-visual{display:flex;align-items:center;justify-content:center;position:relative;z-index:1}
.cfaw-ring{position:absolute;width:500px;height:500px;border-radius:50%;border:1px dashed rgba(201,168,76,.3)}
.cfaw-orb{width:60%;aspect-ratio:1;background:radial-gradient(circle,rgba(201,168,76,.15),transparent 70%);border-radius:50%;display:flex;align-items:center;justify-content:center}
.cfaw-orb svg{width:50%;color:#2E4B35;opacity:.3}
/* BENEFITS */
.cfaw-benefits{display:grid;grid-template-columns:repeat(4,1fr);border-top:2px solid #E8DDD0;border-bottom:2px solid #E8DDD0}
.cfaw-benefit{padding:40px 32px;text-align:center;border-right:1px solid #E8DDD0}
.cfaw-benefit:last-child{border-right:none}
.cfaw-b-icon{width:52px;height:52px;border-radius:50%;background:rgba(46,75,53,.1);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;color:#2E4B35}
.cfaw-b-icon svg{width:26px;stroke-width:1.5}
.cfaw-b-title{font-family:'Yatra One',cursive;font-size:18px;color:#2E4B35;margin-bottom:8px}
.cfaw-b-text{font-size:13px;color:#7A6A58;line-height:1.7}
/* PRODUCTS */
.cfaw-shop{padding:100px 60px;max-width:1400px;margin:0 auto}
.cfaw-sec-label{text-align:center;margin-bottom:60px}
.cfaw-sec-label span{font-size:11px;font-weight:600;letter-spacing:4px;text-transform:uppercase;color:#E07B2A;display:block;margin-bottom:12px}
.cfaw-sec-label h2{font-size:48px;color:#2E4B35}
.cfaw-sec-label p{font-size:16px;color:#7A6A58;max-width:500px;margin:12px auto 0}
.cfaw-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:28px}
.cfaw-card{background:#fff;border:1px solid #E8DDD0;overflow:hidden;transition:all .3s}
.cfaw-card:hover{box-shadow:0 12px 40px rgba(46,75,53,.08);transform:translateY(-4px)}
.cfaw-ci{aspect-ratio:1;background:linear-gradient(135deg,#FDF8F0,#F0E8D8);display:flex;align-items:center;justify-content:center;position:relative}
.cfaw-ci svg{width:40%;color:#2E4B35;opacity:.4}
.cfaw-ci-badge{position:absolute;top:14px;right:14px;background:#2E4B35;color:#fff;padding:4px 12px;font-size:9px;font-weight:600;letter-spacing:2px;text-transform:uppercase}
.cfaw-cb{padding:20px}
.cfaw-concern{font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:#E07B2A;margin-bottom:6px}
.cfaw-name{font-family:'Yatra One',cursive;font-size:20px;color:#2E4B35;margin-bottom:8px;line-height:1.2}
.cfaw-ing{font-size:12px;color:#7A6A58;font-style:italic;margin-bottom:16px}
.cfaw-foot{display:flex;justify-content:space-between;align-items:center}
.cfaw-price strong{font-size:20px;font-weight:700;color:#2E4B35}
.cfaw-price small{font-size:12px;color:#7A6A58;text-decoration:line-through;margin-left:6px}
.cfaw-atc{background:#2E4B35;color:#fff;border:none;padding:10px 20px;font-family:'Hind',sans-serif;font-size:12px;font-weight:600;cursor:pointer;transition:background .2s}
.cfaw-atc:hover{background:#E07B2A}
/* INGREDIENTS */
.cfaw-ing-section{padding:100px 60px;background:#2E4B35;text-align:center}
.cfaw-ing-title{font-size:48px;color:#fff;margin-bottom:16px}
.cfaw-ing-sub{font-size:15px;color:rgba(255,255,255,.5);max-width:500px;margin:0 auto 60px}
.cfaw-ing-grid{display:flex;gap:40px;justify-content:center;flex-wrap:wrap;max-width:1000px;margin:0 auto}
.cfaw-ing-item{display:flex;flex-direction:column;align-items:center;gap:14px}
.cfaw-ing-circle{width:100px;height:100px;border-radius:50%;border:1.5px solid rgba(201,168,76,.4);display:flex;align-items:center;justify-content:center;position:relative}
.cfaw-ing-circle svg{width:40%;color:#C9A84C;stroke-width:1}
.cfaw-ing-name{font-family:'Yatra One',cursive;font-size:16px;color:#fff}
.cfaw-ing-bene{font-size:11px;color:rgba(255,255,255,.4);text-align:center;max-width:80px;line-height:1.5}
/* FOOTER */
.cfaw-footer{background:#1E2E21;padding:80px 60px 40px}
.cfaw-fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;padding-bottom:60px;border-bottom:1px solid rgba(255,255,255,.1)}
.cfaw-fb-brand{font-family:'Yatra One',cursive;font-size:28px;color:#C9A84C;margin-bottom:16px}
.cfaw-fb-text{font-size:13px;color:rgba(255,255,255,.35);line-height:1.9;max-width:280px}
.cfaw-fc h4{font-size:11px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:#C9A84C;margin-bottom:20px}
.cfaw-fc ul{list-style:none}
.cfaw-fc li{margin-bottom:10px}
.cfaw-fc a{color:rgba(255,255,255,.4);text-decoration:none;font-size:14px;transition:color .2s}
.cfaw-fc a:hover{color:#C9A84C}
.cfaw-fbot{display:flex;justify-content:space-between;padding-top:28px;font-size:11px;color:rgba(255,255,255,.2);letter-spacing:1px}
@media(max-width:1024px){.cfaw-hero{grid-template-columns:1fr;min-height:auto;padding:80px 40px}.cfaw-visual{display:none}.cfaw-grid{grid-template-columns:repeat(2,1fr)}.cfaw-benefits{grid-template-columns:1fr 1fr}.cfaw-fg{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cfaw-shop{padding:60px 20px}.cfaw-ing-section{padding:60px 20px}.cfaw-fg{grid-template-columns:1fr}.cfaw-footer{padding:60px 20px 30px}}
</style>

<div class="cfaw">
  <div class="cfaw-ann">{{ section.settings.announce_text }}</div>

  <section class="cfaw-hero">
    <div>
      <span class="cfaw-label">{{ section.settings.hero_label }}</span>
      <h1>{{ section.settings.hero_heading }}</h1>
      <p>{{ section.settings.hero_subtext }}</p>
      <div class="cfaw-btns">
        <a href="{{ section.settings.cta1_link }}" class="cfaw-btn-forest">{{ section.settings.cta1_text }}</a>
        <a href="{{ section.settings.cta2_link }}" class="cfaw-btn-gold">{{ section.settings.cta2_text }}</a>
      </div>
    </div>
    <div class="cfaw-visual">
      <div class="cfaw-ring"></div>
      <div class="cfaw-orb">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75"/></svg>
      </div>
    </div>
  </section>

  {% if section.settings.show_benefits %}
  <div class="cfaw-benefits">
    {% for block in section.blocks %}
      {% if block.type == 'benefit' %}
      <div class="cfaw-benefit" {{ block.shopify_attributes }}>
        <div class="cfaw-b-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg></div>
        <div class="cfaw-b-title">{{ block.settings.title }}</div>
        <div class="cfaw-b-text">{{ block.settings.text }}</div>
      </div>
      {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  <section class="cfaw-shop">
    <div class="cfaw-sec-label">
      <span>{{ section.settings.products_label }}</span>
      <h2>{{ section.settings.products_heading }}</h2>
      <p>{{ section.settings.products_subtext }}</p>
    </div>
    <div class="cfaw-grid">
      {% for block in section.blocks %}
        {% if block.type == 'product' %}
        <div class="cfaw-card" {{ block.shopify_attributes }}>
          <div class="cfaw-ci">
            {% if block.settings.image %}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name }}" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0">{% else %}<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3"/></svg>{% endif %}
            {% if block.settings.badge != blank %}<span class="cfaw-ci-badge">{{ block.settings.badge }}</span>{% endif %}
          </div>
          <div class="cfaw-cb">
            <div class="cfaw-concern">{{ block.settings.concern }}</div>
            <div class="cfaw-name">{{ block.settings.name }}</div>
            <div class="cfaw-ing">{{ block.settings.ingredients }}</div>
            <div class="cfaw-foot">
              <div class="cfaw-price"><strong>{{ block.settings.price }}</strong>{% if block.settings.old_price != blank %}<small>{{ block.settings.old_price }}</small>{% endif %}</div>
              <button class="cfaw-atc">Add to Cart</button>
            </div>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  {% if section.settings.show_ingredients %}
  <div class="cfaw-ing-section">
    <h2 class="cfaw-ing-title">{{ section.settings.ing_heading }}</h2>
    <p class="cfaw-ing-sub">{{ section.settings.ing_subtext }}</p>
    <div class="cfaw-ing-grid">
      {% for block in section.blocks %}
        {% if block.type == 'ingredient' %}
        <div class="cfaw-ing-item" {{ block.shopify_attributes }}>
          <div class="cfaw-ing-circle"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3"/></svg></div>
          <div class="cfaw-ing-name">{{ block.settings.name }}</div>
          <div class="cfaw-ing-bene">{{ block.settings.benefit }}</div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <footer class="cfaw-footer">
    <div class="cfaw-fg">
      <div><div class="cfaw-fb-brand">{{ section.settings.brand_name }}</div><p class="cfaw-fb-text">{{ section.settings.brand_desc }}</p></div>
      <div class="cfaw-fc"><h4>Products</h4><ul><li><a href="#">Skincare</a></li><li><a href="#">Hair Care</a></li><li><a href="#">Wellness</a></li><li><a href="#">Nutrition</a></li></ul></div>
      <div class="cfaw-fc"><h4>Know More</h4><ul><li><a href="#">Dosha Quiz</a></li><li><a href="#">Ingredient Glossary</a></li><li><a href="#">Blog</a></li><li><a href="#">Consult Vaidya</a></li></ul></div>
      <div class="cfaw-fc"><h4>Support</h4><ul><li><a href="#">FAQ</a></li><li><a href="#">Shipping</a></li><li><a href="#">Returns</a></li><li><a href="#">Contact</a></li></ul></div>
    </div>
    <div class="cfaw-fbot"><span>{{ section.settings.copyright }}</span><span>Privacy &middot; Terms</span></div>
  </footer>
</div>

{% schema %}
{
  "name": "CF Ayurveda Wellness",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "text", "id": "brand_name", "label": "Brand Name", "default": "AYURVA" },
    { "type": "textarea", "id": "brand_desc", "label": "Brand Description", "default": "Bridging 5000 years of Ayurvedic wisdom with modern formulation science. Certified, tested, and loved." },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© 2025 Ayurva Wellness Pvt. Ltd." },
    { "type": "header", "content": "Announce Bar" },
    { "type": "text", "id": "announce_text", "label": "Announce Bar Text", "default": "Ancient Wisdom. Modern Science. Free consultation with every order above ₹999." },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_label", "label": "Hero Overline", "default": "5000 Years of Healing Wisdom" },
    { "type": "text", "id": "hero_heading", "label": "Hero Heading", "default": "Heal from the Root" },
    { "type": "textarea", "id": "hero_subtext", "label": "Hero Subtext", "default": "Formulated with authentic Ayurvedic herbs, cold-pressed oils, and sustainably sourced botanicals. Every product is Ayush-certified and DCCL-approved." },
    { "type": "text", "id": "cta1_text", "label": "Primary CTA Text", "default": "Explore Products" },
    { "type": "url", "id": "cta1_link", "label": "Primary CTA Link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary CTA Text", "default": "Free Quiz: Find Your Dosha" },
    { "type": "url", "id": "cta2_link", "label": "Secondary CTA Link" },
    { "type": "header", "content": "Benefits Strip" },
    { "type": "checkbox", "id": "show_benefits", "label": "Show Benefits Strip", "default": true },
    { "type": "header", "content": "Products Section" },
    { "type": "text", "id": "products_label", "label": "Section Label", "default": "Bestsellers" },
    { "type": "text", "id": "products_heading", "label": "Section Heading", "default": "Most Loved Formulas" },
    { "type": "text", "id": "products_subtext", "label": "Section Subtext", "default": "Trusted by over 2 lakh customers across India for daily wellness rituals." },
    { "type": "header", "content": "Ingredients Section" },
    { "type": "checkbox", "id": "show_ingredients", "label": "Show Ingredients Section", "default": true },
    { "type": "text", "id": "ing_heading", "label": "Ingredients Heading", "default": "Sacred Botanicals" },
    { "type": "textarea", "id": "ing_subtext", "label": "Ingredients Subtext", "default": "We source our herbs directly from Himalayan farms and Kerala spice estates — traceable and certified." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Ayush Certified" },
        { "type": "text", "id": "text", "label": "Text", "default": "Government-licensed AYUSH formulations" }
      ]
    },
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product Image" },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "default": "Top Seller" },
        { "type": "text", "id": "concern", "label": "Concern Category", "default": "Hair Care" },
        { "type": "text", "id": "name", "label": "Product Name", "default": "Brahmi Bhringraj Hair Oil" },
        { "type": "text", "id": "ingredients", "label": "Key Ingredients", "default": "Brahmi · Bhringraj · Coconut · Neem" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹599" },
        { "type": "text", "id": "old_price", "label": "Original Price (optional)", "default": "₹799" }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Ingredient Name", "default": "Brahmi" },
        { "type": "text", "id": "benefit", "label": "Benefit", "default": "Memory & Clarity" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF Ayurveda Wellness",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Ayush Certified", "text": "Government-licensed AYUSH formulations" } },
        { "type": "benefit", "settings": { "title": "100% Natural", "text": "No parabens, sulphates or mineral oils" } },
        { "type": "benefit", "settings": { "title": "Cruelty Free", "text": "Vegan & never tested on animals" } },
        { "type": "benefit", "settings": { "title": "Results in 21 Days", "text": "Clinically tested with measurable outcomes" } },
        { "type": "product", "settings": { "badge": "Top Seller", "concern": "Hair Care", "name": "Brahmi Bhringraj Hair Oil", "ingredients": "Brahmi · Bhringraj · Coconut · Neem", "price": "₹599", "old_price": "₹799" } },
        { "type": "product", "settings": { "badge": "", "concern": "Skincare", "name": "Kumkumadi Face Oil", "ingredients": "Kumkumadi · Saffron · Sandalwood", "price": "₹899", "old_price": "" } },
        { "type": "product", "settings": { "badge": "New", "concern": "Wellness", "name": "Ashwagandha Shilajit Gummies", "ingredients": "Ashwagandha KSM-66 · Pure Shilajit", "price": "₹799", "old_price": "₹999" } },
        { "type": "product", "settings": { "badge": "", "concern": "Body Care", "name": "Nalpamaradi Ubtan Scrub", "ingredients": "Turmeric · Neem · Chickpea · Rose", "price": "₹449", "old_price": "" } },
        { "type": "ingredient", "settings": { "name": "Brahmi", "benefit": "Memory & Clarity" } },
        { "type": "ingredient", "settings": { "name": "Ashwagandha", "benefit": "Stress Relief" } },
        { "type": "ingredient", "settings": { "name": "Saffron", "benefit": "Radiance & Glow" } },
        { "type": "ingredient", "settings": { "name": "Turmeric", "benefit": "Anti-Inflammatory" } },
        { "type": "ingredient", "settings": { "name": "Neem", "benefit": "Purifying Detox" } }
      ]
    }
  ]
}
{% endschema %}