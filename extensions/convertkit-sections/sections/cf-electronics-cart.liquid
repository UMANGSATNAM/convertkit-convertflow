{% comment %}
  ConvertFlow — Electronics Cart Page
  Cyberpunk cart with warranty upsell and glowing neon highlights.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Inter:wght@400;500&display=swap');

  :root {
    --el-primary: {{ section.settings.color_primary | default: '#00F0FF' }};
    --el-bg: {{ section.settings.color_bg | default: '#030508' }};
    --el-surface: {{ section.settings.color_surface | default: '#0C121E' }};
    --el-border: rgba(0, 240, 255, 0.15);
    --el-text: {{ section.settings.color_text | default: '#FFFFFF' }};
    --el-font-heading: 'Rajdhani', sans-serif;
    --el-font-body: 'Inter', sans-serif;
  }

  .cf-el-cart * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-el-cart { font-family: var(--el-font-body); background: var(--el-bg); color: var(--el-text); min-height: 80vh; border-top: 1px solid var(--el-border); }
  
  .cf-el-cart-wrap { max-width: 1200px; margin: 0 auto; padding: 60px 5%; display: grid; grid-template-columns: 1fr 380px; gap: 40px; }
  
  .cf-el-cart-h1 { font-family: var(--el-font-heading); font-size: 48px; font-weight: 700; text-transform: uppercase; margin-bottom: 30px; text-shadow: 0 0 20px rgba(0,240,255,0.2); }
  
  /* Items */
  .cf-el-c-items { background: var(--el-surface); border: 1px solid var(--el-border); }
  .cf-el-c-item { display: grid; grid-template-columns: 120px 1fr auto; gap: 20px; padding: 24px; border-bottom: 1px solid var(--el-border); align-items: center; }
  .cf-el-c-item:last-child { border-bottom: none; }
  
  .cf-el-c-img { aspect-ratio: 1; background: radial-gradient(circle, #111a28 0%, #030508 100%); display: flex; align-items: center; justify-content: center; padding: 10px; }
  .cf-el-c-img img { max-width: 100%; max-height: 100%; object-fit: contain; }
  
  .cf-el-c-info h3 { font-family: var(--el-font-heading); font-size: 20px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px; }
  .cf-el-c-var { font-size: 13px; color: #8B9BB4; margin-bottom: 12px; }
  
  .cf-el-c-qty { display: inline-flex; border: 1px solid var(--el-border); align-items: center; }
  .cf-el-c-qty button { background: transparent; border: none; color: var(--el-primary); width: 30px; height: 30px; font-size: 18px; cursor: pointer; }
  .cf-el-c-qty span { font-size: 14px; width: 30px; text-align: center; }
  
  .cf-el-c-remove { font-size: 12px; color: #8B9BB4; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; text-decoration: none; margin-top: 10px; display: inline-block; transition: color 0.2s; }
  .cf-el-c-remove:hover { color: #ff3366; }
  
  .cf-el-c-price { font-family: var(--el-font-heading); font-size: 24px; color: var(--el-primary); font-weight: 700; }
  
  /* Warranty Upsell */
  .cf-el-c-warranty { margin-top: 30px; background: rgba(0,240,255,0.05); border: 1px solid var(--el-primary); padding: 20px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .cf-el-c-warranty-text h4 { font-family: var(--el-font-heading); font-size: 18px; text-transform: uppercase; margin-bottom: 4px; color: var(--el-primary); }
  .cf-el-c-warranty-text p { font-size: 13px; color: #8B9BB4; }
  .cf-el-btn-sm { background: var(--el-primary); color: #000; border: none; padding: 8px 16px; font-family: var(--el-font-heading); font-weight: 700; text-transform: uppercase; cursor: pointer; }
  
  /* Summary Box */
  .cf-el-c-sum { background: var(--el-surface); border: 1px solid var(--el-border); padding: 30px; position: sticky; top: 40px; }
  .cf-el-c-sum h2 { font-family: var(--el-font-heading); font-size: 24px; text-transform: uppercase; margin-bottom: 24px; border-bottom: 1px solid var(--el-border); padding-bottom: 16px; color: var(--el-primary); }
  .cf-el-c-row { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 16px; color: #8B9BB4; text-transform: uppercase; }
  .cf-el-c-total { display: flex; justify-content: space-between; font-size: 18px; font-weight: 700; color: #fff; margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--el-border); text-transform: uppercase; }
  .cf-el-c-total span:last-child { font-family: var(--el-font-heading); font-size: 32px; color: var(--el-primary); }
  
  .cf-el-btn-checkout {
    display: block; width: 100%; text-align: center; margin-top: 30px;
    background: transparent; color: var(--el-primary); border: 1px solid var(--el-primary);
    padding: 16px; font-family: var(--el-font-heading); font-size: 18px; font-weight: 700; text-transform: uppercase;
    text-decoration: none; cursor: pointer;
    box-shadow: inset 0 0 10px rgba(0,240,255,0.1);
    transition: all 0.3s;
  }
  .cf-el-btn-checkout:hover { background: var(--el-primary); color: #000; box-shadow: 0 0 20px rgba(0,240,255,0.3); }

  .cf-el-c-empty { grid-column: 1 / -1; text-align: center; padding: 100px 20px; border: 1px solid var(--el-border); background: var(--el-surface); }
  .cf-el-c-empty h2 { font-size: 32px; margin-bottom: 20px; color: var(--el-primary); }

  @media(max-width: 900px) {
    .cf-el-cart-wrap { grid-template-columns: 1fr; }
    .cf-el-c-item { grid-template-columns: 80px 1fr; }
    .cf-el-c-price { grid-column: 1 / -1; text-align: right; }
    .cf-el-c-warranty { flex-direction: column; text-align: center; }
  }
{% endstyle %}

<div class="cf-el-cart">
  <div class="cf-el-cart-wrap">
    {% if cart.item_count == 0 %}
      <div class="cf-el-c-empty">
        <h2>SYSTEM_EMPTY</h2>
        <p style="color:#8B9BB4; margin-bottom: 20px;">No hardware modules detected in your cart.</p>
        <a href="/collections/all" class="cf-el-btn-checkout" style="display:inline-block; width:auto; padding: 12px 30px;">Initialize Catalog</a>
      </div>
    {% else %}
      <div>
        <h1 class="cf-el-cart-h1">Active Hardware</h1>
        <div class="cf-el-c-items">
          {% for item in cart.items %}
            <div class="cf-el-c-item">
              <div class="cf-el-c-img">
                {% if item.image %}
                  <img src="{{ item.image | img_url: '200x' }}" alt="{{ item.title }}">
                {% endif %}
              </div>
              <div class="cf-el-c-info">
                <h3>{{ item.product.title }}</h3>
                {% unless item.variant.title contains 'Default' %}
                  <div class="cf-el-c-var">CONFIG: {{ item.variant.title }}</div>
                {% endunless %}
                <div class="cf-el-c-qty">
                  <button>-</button><span>{{ item.quantity }}</span><button>+</button>
                </div>
                <br>
                <a href="{{ item.url_to_remove }}" class="cf-el-c-remove">Deactivate</a>
              </div>
              <div class="cf-el-c-price">{{ item.final_line_price | money }}</div>
            </div>
          {% endfor %}
        </div>
        
        <div class="cf-el-c-warranty">
          <div class="cf-el-c-warranty-text">
            <h4>Protect Your Hardware</h4>
            <p>Add 3-Year Extended System Warranty for $99.00.</p>
          </div>
          <button class="cf-el-btn-sm">+ ADD PROTECTION</button>
        </div>
      </div>
      
      <div class="cf-el-c-sum">
        <h2>Order Summary</h2>
        <div class="cf-el-c-row"><span>Hardware Subtotal</span> <span>{{ cart.total_price | money }}</span></div>
        <div class="cf-el-c-row"><span>Logistics</span> <span>Calculated next step</span></div>
        <div class="cf-el-c-total"><span>Total Configuration</span> <span>{{ cart.total_price | money }}</span></div>
        <a href="/checkout" class="cf-el-btn-checkout">Proceed to Secure Checkout</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "CF Electronics Cart",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Primary Accent (Neon)", "default": "#00F0FF" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#030508" },
    { "type": "color", "id": "color_surface", "label": "Surface", "default": "#0C121E" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "CF Electronics Cart" }
  ]
}
{% endschema %}