{% comment %} ConvertFlow — Luxury Watches Landing | Always-Visible Cinematic Layout {% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Montserrat:wght@300;400;600&display=swap');
  .cf-lw*{box-sizing:border-box;margin:0;padding:0}
  .cf-lw{font-family:'Montserrat',sans-serif;background:#0A0A0A;color:#E5E4E2;overflow-x:hidden}

  :root{
    --lw-gold:{{ section.settings.color_accent | default: '#D4AF37' }};
    --lw-silver:#E5E4E2;
  }

  /* ═══ HERO ═══ */
  .cf-lw-hero{position:relative;height:100vh;display:flex;align-items:center;justify-content:center;text-align:center}
  .cf-lw-hero-bg{position:absolute;inset:0}
  .cf-lw-hero-bg img{width:100%;height:100%;object-fit:cover;opacity:.6}
  .cf-lw-hero-bg::after{content:'';position:absolute;inset:0;background:radial-gradient(circle at center, transparent 0%, #0A0A0A 100%)}
  .cf-lw-hero-inner{position:relative;z-index:2;max-width:800px;padding:0 20px}
  .cf-lw-sub{font-size:12px;letter-spacing:6px;text-transform:uppercase;color:var(--lw-gold);margin-bottom:24px}
  .cf-lw-h1{font-family:'Cinzel',serif;font-size:clamp(48px,8vw,90px);font-weight:400;color:#fff;line-height:1;margin-bottom:30px;letter-spacing:2px}
  .cf-lw-btn{display:inline-block;padding:16px 48px;font-size:12px;letter-spacing:4px;text-transform:uppercase;color:#fff;border:1px solid rgba(255,255,255,.3);text-decoration:none;transition:all .5s;background:rgba(0,0,0,.3);backdrop-filter:blur(4px)}
  .cf-lw-btn:hover{background:var(--lw-gold);border-color:var(--lw-gold);color:#0A0A0A}

  /* ═══ FEATURE STRIP ═══ */
  .cf-lw-feats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid rgba(255,255,255,.1);border-bottom:1px solid rgba(255,255,255,.1);background:#111}
  .cf-lw-feat{padding:40px 20px;text-align:center;border-right:1px solid rgba(255,255,255,.05)}
  .cf-lw-feat:last-child{border-right:none}
  .cf-lw-feat-title{font-family:'Cinzel',serif;font-size:18px;color:var(--lw-gold);margin-bottom:8px}
  .cf-lw-feat-desc{font-size:12px;color:#888;line-height:1.6}

  /* ═══ SHOWCASE MASONRY ═══ */
  .cf-lw-showcase{padding:120px 5%}
  .cf-lw-head{text-align:center;margin-bottom:80px}
  .cf-lw-head h2{font-family:'Cinzel',serif;font-size:clamp(32px,4vw,48px);color:#fff;font-weight:400;margin-bottom:16px}
  .cf-lw-head p{color:#888;font-size:14px;max-width:500px;margin:0 auto}
  
  .cf-lw-grid{display:grid;grid-template-columns:1fr 1fr;gap:2px;background:rgba(255,255,255,.1)}
  .cf-lw-box{position:relative;background:#0A0A0A;overflow:hidden;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center}
  .cf-lw-box:first-child{grid-column:span 2;aspect-ratio:21/9}
  .cf-lw-box img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.7;transition:transform 1.5s ease, opacity .5s}
  .cf-lw-box:hover img{transform:scale(1.03);opacity:.4}
  .cf-lw-box-content{position:relative;z-index:2;text-align:center;opacity:0;transform:translateY(20px);transition:all .5s}
  .cf-lw-box:hover .cf-lw-box-content{opacity:1;transform:translateY(0)}
  .cf-lw-box-title{font-family:'Cinzel',serif;font-size:24px;color:#fff;margin-bottom:12px;letter-spacing:2px}
  .cf-lw-box-link{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--lw-gold);text-decoration:none;border-bottom:1px solid var(--lw-gold);padding-bottom:4px}

  /* ═══ PRODUCTS ═══ */
  .cf-lw-products{padding:120px 5%;background:#111}
  .cf-lw-prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:40px}
  .cf-lw-card{text-decoration:none;color:var(--lw-silver);text-align:center;display:block}
  .cf-lw-card-img{aspect-ratio:3/4;background:#0A0A0A;padding:20px;position:relative;margin-bottom:24px;display:flex;align-items:center;justify-content:center}
  .cf-lw-card-img::before{content:'';position:absolute;inset:0;border:1px solid rgba(255,255,255,.05);transition:border-color .5s}
  .cf-lw-card:hover .cf-lw-card-img::before{border-color:var(--lw-gold)}
  .cf-lw-card-img img{width:100%;height:100%;object-fit:cover;transition:transform .8s;filter:drop-shadow(0 10px 20px rgba(0,0,0,.5))}
  .cf-lw-card:hover .cf-lw-card-img img{transform:scale(1.05)}
  .cf-lw-card-title{font-family:'Cinzel',serif;font-size:16px;margin-bottom:8px;color:#fff;letter-spacing:1px}
  .cf-lw-card-price{font-size:14px;color:#888}

  @media(max-width:900px){
    .cf-lw-feats{grid-template-columns:1fr}
    .cf-lw-grid{grid-template-columns:1fr}
    .cf-lw-box:first-child{grid-column:span 1;aspect-ratio:16/9}
    .cf-lw-prod-grid{grid-template-columns:repeat(2,1fr);gap:20px}
  }
{% endstyle %}

<div class="cf-lw">
  <section class="cf-lw-hero">
    <div class="cf-lw-hero-bg">
      {% if section.settings.hero_image != blank %}
        <img src="{{ section.settings.hero_image | img_url: 'master' }}" alt="Watches">
      {% else %}
        <img src="https://images.unsplash.com/photo-1523170335258-f5ed11844a49?w=1600&auto=format&fit=crop" alt="">
      {% endif %}
    </div>
    <div class="cf-lw-hero-inner">
      <div class="cf-lw-sub">{{ section.settings.hero_sub | default: 'Maison D\'Horlogerie' }}</div>
      <h1 class="cf-lw-h1">{{ section.settings.hero_headline | default: 'Masters of Time' }}</h1>
      <a href="{{ section.settings.hero_btn_url | default: '/collections/all' }}" class="cf-lw-btn">{{ section.settings.hero_btn_text | default: 'Explore Collections' }}</a>
    </div>
  </section>

  <div class="cf-lw-feats">
    <div class="cf-lw-feat">
      <div class="cf-lw-feat-title">Swiss Movement</div><div class="cf-lw-feat-desc">Precision engineering passed down through generations.</div>
    </div>
    <div class="cf-lw-feat">
      <div class="cf-lw-feat-title">Sapphire Crystal</div><div class="cf-lw-feat-desc">Scratch-resistant clarity for uncompromising visibility.</div>
    </div>
    <div class="cf-lw-feat">
      <div class="cf-lw-feat-title">Lifetime Guarantee</div><div class="cf-lw-feat-desc">A legacy of quality backed by our master watchmakers.</div>
    </div>
  </div>

  <section class="cf-lw-showcase">
    <div class="cf-lw-head">
      <h2>{{ section.settings.colls_heading | default: 'The Archives' }}</h2>
      <p>Discover our meticulously curated collections, each telling a unique story of craftsmanship and heritage.</p>
    </div>
    <div class="cf-lw-grid">
      <a href="/collections/chronograph" class="cf-lw-box">
        <img src="https://images.unsplash.com/photo-1548171915-e7af50a04918?w=1200&auto=format&fit=crop" alt="">
        <div class="cf-lw-box-content">
          <div class="cf-lw-box-title">The Chronograph Series</div>
          <div class="cf-lw-box-link">Discover →</div>
        </div>
      </a>
      <a href="/collections/automatic" class="cf-lw-box">
        <img src="https://images.unsplash.com/photo-1524805444758-089113d48a6d?w=800&auto=format&fit=crop" alt="">
        <div class="cf-lw-box-content">
          <div class="cf-lw-box-title">Automatic Calibre</div>
          <div class="cf-lw-box-link">Discover →</div>
        </div>
      </a>
      <a href="/collections/dive" class="cf-lw-box">
        <img src="https://images.unsplash.com/photo-1547996160-81dfa63595aa?w=800&auto=format&fit=crop" alt="">
        <div class="cf-lw-box-content">
          <div class="cf-lw-box-title">Deep Sea Exploration</div>
          <div class="cf-lw-box-link">Discover →</div>
        </div>
      </a>
    </div>
  </section>

  <section class="cf-lw-products">
    <div class="cf-lw-head">
      <h2>{{ section.settings.prods_heading | default: 'Exceptional Timepieces' }}</h2>
    </div>
    <div class="cf-lw-prod-grid">
      {% assign coll = section.settings.featured_collection %}
      {% if coll != blank and coll.products_count > 0 %}
        {% for p in coll.products limit: 4 %}
          <a href="{{ p.url }}" class="cf-lw-card">
            <div class="cf-lw-card-img">
              {% if p.featured_image %}<img src="{{ p.featured_image | img_url: '600x' }}" alt="{{ p.title }}">{% endif %}
            </div>
            <div class="cf-lw-card-title">{{ p.title }}</div>
            <div class="cf-lw-card-price">{{ p.price | money }}</div>
          </a>
        {% endfor %}
      {% else %}
        {% assign lw_demo = 'Oyster Perpetual 41,Speedmaster Professional,Royal Oak Offshore,Nautilus Rose Gold' | split: ',' %}
        {% for name in lw_demo %}
          <a href="/collections/all" class="cf-lw-card">
            <div class="cf-lw-card-img">
              <div style="width:50%;height:50%;border-radius:50%;background:radial-gradient(circle at center,#333,#0A0A0A)"></div>
            </div>
            <div class="cf-lw-card-title">{{ name }}</div>
            <div class="cf-lw-card-price">₹{{ forloop.index | times: 150000 | plus: 500000 }}</div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "CF Luxury Watches Landing",
  "settings": [
    { "type": "color", "id": "color_accent", "label": "Gold Accent", "default": "#D4AF37" },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero Background" },
    { "type": "text", "id": "hero_sub", "label": "Subheadline", "default": "Maison D'Horlogerie" },
    { "type": "text", "id": "hero_headline", "label": "Headline", "default": "Masters of Time" },
    { "type": "text", "id": "hero_btn_text", "label": "Button Text", "default": "Explore Collections" },
    { "type": "url", "id": "hero_btn_url", "label": "Button Link" },
    { "type": "header", "content": "Sections" },
    { "type": "text", "id": "colls_heading", "label": "Collections Heading", "default": "The Archives" },
    { "type": "text", "id": "prods_heading", "label": "Products Heading", "default": "Exceptional Timepieces" },
    { "type": "collection", "id": "featured_collection", "label": "Featured Collection" }
  ],
  "presets": [{ "name": "CF Luxury Watches Landing" }]
}
{% endschema %}