{% comment %}ConvertFlow - Luxury Watches Landing | CHRONOS style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
<style>
.cflw{--bg:#050505;--text:#F2F2F2;--mu:#999;--gold:#D4AF37;--gold2:#AA8C2C;--surf:#111;--bd:#333;}
.cflw *{box-sizing:border-box;margin:0;padding:0;}
.cflw{background:var(--bg);color:var(--text);font-family:'Lato',sans-serif;font-size:14px;-webkit-font-smoothing:antialiased;letter-spacing:.5px;}
.cflw h1,.cflw h2,.cflw h3{font-family:'Cinzel',serif;font-weight:400;}
.cflw-header{display:flex;align-items:center;justify-content:space-between;padding:40px 60px;position:relative;}
.cflw-brand{font-family:'Cinzel',serif;font-size:28px;letter-spacing:6px;color:#fff;text-decoration:none;position:absolute;left:50%;transform:translateX(-50%);}
.cflw-nav-actions{display:flex;gap:30px;}
.cflw-alink{color:#fff;text-decoration:none;font-size:11px;text-transform:uppercase;letter-spacing:2px;transition:color .3s;}
.cflw-alink:hover{color:var(--gold);}
.cflw-menu{display:flex;flex-direction:column;gap:5px;cursor:pointer;}
.cflw-menu span{display:block;height:1px;width:30px;background:#fff;transition:.3s;}
.cflw-menu:hover span{background:var(--gold);}
.cflw-hero{height:100vh;position:relative;display:flex;align-items:center;padding-left:10vw;overflow:hidden;}
.cflw-hero-bg{position:absolute;inset:0;background:radial-gradient(circle at 70% 50%,rgba(212,175,55,.15) 0%,transparent 60%);}
.cflw-hero-vis{position:absolute;top:0;right:-10vw;width:60%;height:100%;background:radial-gradient(circle at center,#1A1A1A 0%,#050505 100%);display:flex;align-items:center;justify-content:center;opacity:.6;}
.cflw-hero-content{position:relative;z-index:2;max-width:600px;}
.cflw-kicker{font-size:11px;color:var(--gold);letter-spacing:4px;text-transform:uppercase;margin-bottom:24px;display:block;}
.cflw-hero h1{font-size:64px;line-height:1.1;margin-bottom:30px;}
.cflw-hero p{font-size:16px;color:var(--mu);line-height:1.8;margin-bottom:50px;font-weight:300;max-width:480px;}
.cflw-btn-gold{padding:16px 48px;border:1px solid var(--gold);background:transparent;color:var(--gold);font-family:'Lato',sans-serif;font-size:11px;text-transform:uppercase;letter-spacing:3px;cursor:pointer;transition:all .4s;text-decoration:none;display:inline-block;}
.cflw-btn-gold:hover{background:var(--gold);color:#000;box-shadow:0 0 20px rgba(212,175,55,.3);}
.cflw-collection{padding:120px 60px;max-width:1600px;margin:0 auto;}
.cflw-sec-title{text-align:center;margin-bottom:80px;}
.cflw-sec-title h2{font-size:36px;letter-spacing:4px;margin-bottom:16px;}
.cflw-sec-title p{font-size:13px;color:var(--mu);letter-spacing:2px;text-transform:uppercase;}
.cflw-pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;}
.cflw-pcard{position:relative;background:var(--surf);height:600px;display:flex;align-items:center;justify-content:center;overflow:hidden;cursor:crosshair;}
.cflw-pcard::before{content:'';position:absolute;inset:0;border:1px solid var(--bd);transition:border-color .6s;z-index:1;pointer-events:none;}
.cflw-pcard:hover::before{border-color:rgba(212,175,55,.5);}
.cflw-pc-img{width:100%;height:100%;position:absolute;top:0;left:0;transition:transform 1s cubic-bezier(.2,1,.3,1);background:radial-gradient(circle at center,#1A1A1A 0%,#050505 100%);display:flex;align-items:center;justify-content:center;}
.cflw-pcard:hover .cflw-pc-img{transform:scale(1.05);}
.cflw-pc-overlay{position:absolute;bottom:0;left:0;width:100%;background:linear-gradient(to top,rgba(0,0,0,.9) 0%,transparent 100%);padding:40px;display:flex;flex-direction:column;justify-content:flex-end;z-index:2;opacity:0;transform:translateY(20px);transition:all .6s cubic-bezier(.2,1,.3,1);height:55%;}
.cflw-pcard:hover .cflw-pc-overlay{opacity:1;transform:translateY(0);}
.cflw-pname{font-family:'Cinzel',serif;font-size:22px;letter-spacing:2px;color:#fff;margin-bottom:8px;}
.cflw-pspecs{font-size:12px;color:var(--mu);margin-bottom:20px;font-weight:300;}
.cflw-pspecs span{margin-right:12px;}
.cflw-prow{display:flex;justify-content:space-between;align-items:center;border-top:1px solid rgba(255,255,255,.1);padding-top:20px;}
.cflw-pprice{font-size:14px;letter-spacing:2px;color:var(--gold);}
.cflw-btn-con{background:rgba(255,255,255,.1);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.2);color:#fff;padding:10px 20px;font-size:10px;text-transform:uppercase;letter-spacing:2px;cursor:pointer;transition:all .3s;font-family:'Lato',sans-serif;}
.cflw-btn-con:hover{background:#fff;color:#000;}
.cflw-horology{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--bd);border-bottom:1px solid var(--bd);}
.cflw-htext{padding:120px 10vw;display:flex;flex-direction:column;justify-content:center;border-right:1px solid var(--bd);}
.cflw-himg{background:#111;display:flex;align-items:center;justify-content:center;min-height:500px;}
.cflw-htitle{font-size:40px;margin-bottom:30px;letter-spacing:2px;}
.cflw-hdesc{font-weight:300;color:var(--mu);line-height:2;margin-bottom:40px;font-size:15px;}
.cflw-footer{padding:80px 60px;max-width:1600px;margin:0 auto;text-align:center;}
.cflw-flogo{font-family:'Cinzel',serif;font-size:24px;letter-spacing:8px;color:#fff;text-decoration:none;display:block;margin-bottom:40px;}
.cflw-flinks{display:flex;justify-content:center;gap:40px;margin-bottom:60px;}
.cflw-flinks a{color:var(--mu);text-decoration:none;font-size:11px;text-transform:uppercase;letter-spacing:3px;transition:color .3s;}
.cflw-flinks a:hover{color:var(--gold);}
.cflw-flegal{font-size:10px;color:#555;text-transform:uppercase;letter-spacing:2px;}
@media(max-width:1024px){.cflw-pgrid{grid-template-columns:repeat(2,1fr)}.cflw-horology{grid-template-columns:1fr}.cflw-htext{border-right:none;border-bottom:1px solid var(--bd);padding:80px 40px}.cflw-himg{height:400px}.cflw-hero-vis{opacity:.2;right:0;width:100%}}
@media(max-width:768px){.cflw-header{padding:20px}.cflw-hero{padding:40px}.cflw-hero h1{font-size:44px}.cflw-pgrid{grid-template-columns:1fr}.cflw-collection{padding:80px 20px}.cflw-flinks{flex-direction:column;gap:20px}}
</style>
<div class="cflw">
  <header class="cflw-header">
    <div class="cflw-menu"><span></span><span></span><span></span></div>
    <a href="{{ routes.root_url }}" class="cflw-brand">{{ section.settings.brand_name | default: 'CHRONOS' }}</a>
    <div class="cflw-nav-actions">
      <a href="#" class="cflw-alink">Boutiques</a>
      <a href="{{ routes.cart_url }}" class="cflw-alink">Concierge</a>
    </div>
  </header>

  <section class="cflw-hero">
    <div class="cflw-hero-bg"></div>
    <div class="cflw-hero-vis"><svg fill="none" viewBox="0 0 100 100" width="300" stroke="#D4AF37" stroke-width="0.3" opacity="0.4"><circle cx="50" cy="50" r="40"/><circle cx="50" cy="50" r="30"/><circle cx="50" cy="50" r="20"/><path d="M50 10 v40 l20 20"/></svg></div>
    <div class="cflw-hero-content">
      <span class="cflw-kicker">{{ section.settings.hero_kicker | default: 'The Masterpiece Collection' }}</span>
      <h1>{{ section.settings.hero_heading | default: 'Eternity, Captured.' }}</h1>
      <p>{{ section.settings.hero_sub | default: 'Discover timepieces crafted with unparalleled precision. Merging centuries-old Swiss watchmaking traditions with avant-garde aesthetics.' }}</p>
      <a href="#cflw-collection" class="cflw-btn-gold">{{ section.settings.cta_text | default: 'Discover the Collection' }}</a>
    </div>
  </section>

  <section class="cflw-collection" id="cflw-collection">
    <div class="cflw-sec-title"><h2>Exceptional Timepieces</h2><p>Excellence Without Compromise</p></div>
    <div class="cflw-pgrid">
      {% assign col = collections[section.settings.featured_collection] %}
      {% if col and col.products.size > 0 %}
        {% for p in col.products limit: 3 %}
          <div class="cflw-pcard">
            <div class="cflw-pc-img">
              {% if p.featured_image %}<img src="{{ p.featured_image | img_url: '800x' }}" alt="{{ p.title }}" style="width:100%;height:100%;object-fit:cover;">
              {% else %}<svg fill="none" viewBox="0 0 100 100" width="200" stroke="#fff" stroke-width="1" opacity="0.5"><circle cx="50" cy="50" r="30"/><circle cx="50" cy="50" r="28" stroke="#D4AF37" stroke-width=".5"/><path d="M50 20 v30 l15 15"/></svg>{% endif %}
            </div>
            <div class="cflw-pc-overlay">
              <h3 class="cflw-pname">{{ p.title }}</h3>
              <div class="cflw-pspecs"><span>{{ p.metafields.custom.diameter | default: '42mm' }}</span><span>{{ p.metafields.custom.material | default: 'Premium' }}</span><span>{{ p.type }}</span></div>
              <div class="cflw-prow"><span class="cflw-pprice">{{ p.price | money }}</span><button class="cflw-btn-con" data-variant-id="{{ p.variants.first.id }}">Add to Cart</button></div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="cflw-pcard"><div class="cflw-pc-img"><svg fill="none" viewBox="0 0 100 100" width="200" stroke="#fff" stroke-width="1" opacity="0.5"><circle cx="50" cy="50" r="30"/><circle cx="50" cy="50" r="28" stroke="#D4AF37" stroke-width=".5"/><path d="M50 20 v30 l15 15"/></svg></div><div class="cflw-pc-overlay"><h3 class="cflw-pname">Tourbillon Grand Complication</h3><div class="cflw-pspecs"><span>42mm</span><span>Platinum 950</span><span>Manual-Winding</span></div><div class="cflw-prow"><span class="cflw-pprice">Price Upon Request</span><button class="cflw-btn-con">Contact Concierge</button></div></div></div>
        <div class="cflw-pcard"><div class="cflw-pc-img"><svg fill="none" viewBox="0 0 100 100" width="200" stroke="#AA8C2C" stroke-width="2" opacity="0.6"><circle cx="50" cy="50" r="32"/><circle cx="50" cy="50" r="28" stroke="#fff" stroke-width=".5"/><path d="M50 20 v30 l-10 10"/></svg></div><div class="cflw-pc-overlay"><h3 class="cflw-pname">Perpetual Calendar</h3><div class="cflw-pspecs"><span>40mm</span><span>18K Rose Gold</span><span>Automatic</span></div><div class="cflw-prow"><span class="cflw-pprice">$84,500</span><button class="cflw-btn-con">Contact Concierge</button></div></div></div>
        <div class="cflw-pcard"><div class="cflw-pc-img"><svg fill="none" viewBox="0 0 100 100" width="200" stroke="#fff" stroke-width="1" opacity="0.5"><circle cx="50" cy="50" r="30"/><path d="M50 20 v30 l15 -5"/><circle cx="35" cy="50" r="5" stroke="#D4AF37" stroke-width=".5"/></svg></div><div class="cflw-pc-overlay"><h3 class="cflw-pname">Chronograph Skeleton</h3><div class="cflw-pspecs"><span>44mm</span><span>Titanium</span><span>Manual-Winding</span></div><div class="cflw-prow"><span class="cflw-pprice">$62,000</span><button class="cflw-btn-con">Contact Concierge</button></div></div></div>
      {% endif %}
    </div>
  </section>

  <section class="cflw-horology">
    <div class="cflw-htext">
      <h2 class="cflw-htitle">The Art of Precision</h2>
      <p class="cflw-hdesc">{{ section.settings.craft_text | default: 'Each timepiece is the result of hundreds of hours of meticulous hand-craftsmanship. From the initial sketches to the final polishing of microscopic components, our master watchmakers pour their soul into creating instruments that transcend time itself.' }}</p>
      <a href="#" class="cflw-btn-gold" style="width:max-content;">Explore Our Manufacture</a>
    </div>
    <div class="cflw-himg"><svg fill="none" viewBox="0 0 100 100" width="300" stroke="#AA8C2C" stroke-width="0.5" opacity="0.5"><circle cx="30" cy="40" r="20"/><circle cx="70" cy="60" r="25"/><circle cx="50" cy="20" r="10"/><path d="M30 40 L70 60 L50 20 Z" fill="rgba(212,175,55,.05)"/></svg></div>
  </section>

  <footer class="cflw-footer">
    <a href="{{ routes.root_url }}" class="cflw-flogo">{{ section.settings.brand_name | default: 'CHRONOS' }}</a>
    <div class="cflw-flinks"><a href="#">The Collection</a><a href="#">Manufacture</a><a href="#">Boutiques</a><a href="#">Client Services</a><a href="#">Press</a></div>
    <p class="cflw-flegal">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'Chronos' }} High Horology. Terms of Service &middot; Privacy Policy</p>
  </footer>
</div>
{% schema %}
{
  "name": "Luxury Watches Landing",
  "settings": [
    {"type":"text","id":"brand_name","label":"Brand Name","default":"CHRONOS"},
    {"type":"text","id":"hero_kicker","label":"Hero Kicker","default":"The Masterpiece Collection"},
    {"type":"textarea","id":"hero_heading","label":"Hero Heading","default":"Eternity, Captured."},
    {"type":"textarea","id":"hero_sub","label":"Hero Subtext","default":"Discover timepieces crafted with unparalleled precision."},
    {"type":"text","id":"cta_text","label":"CTA Text","default":"Discover the Collection"},
    {"type":"collection","id":"featured_collection","label":"Featured Collection"},
    {"type":"textarea","id":"craft_text","label":"Craft Section Text","default":"Each timepiece is the result of hundreds of hours of meticulous hand-craftsmanship."}
  ],
  "presets": [{"name":"Luxury Watches Landing"}]
}
{% endschema %}