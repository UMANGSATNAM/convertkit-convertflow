{% comment %}
  ConvertFlow — Fashion Clothing Product Page
  Elegant sticky layout, muted tones, serif headings.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

  :root {
    --fc-primary: {{ section.settings.color_primary | default: '#0A0A0A' }};
    --fc-bg: {{ section.settings.color_bg | default: '#F5F3EF' }};
    --fc-surface: {{ section.settings.color_surface | default: '#FFFFFF' }};
    --fc-text: {{ section.settings.color_text | default: '#1a1a1a' }};
    --fc-border: rgba(0, 0, 0, 0.08);
    --fc-font-heading: 'Playfair Display', serif;
    --fc-font-body: 'Inter', sans-serif;
  }

  .cf-fc-p * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-fc-p { font-family: var(--fc-font-body); background: var(--fc-bg); color: var(--fc-text); line-height: 1.6; }
  
  .cf-fc-p-wrap { max-width: 1300px; margin: 0 auto; display: grid; grid-template-columns: 1.3fr 1fr; gap: 80px; padding: 60px 5%; align-items: start; }
  
  /* Gallery */
  .cf-fc-p-gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .cf-fc-p-img { background: #e0dcd3; aspect-ratio: 3/4; }
  .cf-fc-p-img:first-child { grid-column: 1 / -1; aspect-ratio: 4/5; }
  .cf-fc-p-img img { width: 100%; height: 100%; object-fit: cover; }
  
  /* Info */
  .cf-fc-p-info { position: sticky; top: 60px; }
  .cf-fc-p-vendor { font-size: 11px; text-transform: uppercase; letter-spacing: 2px; color: #888; margin-bottom: 12px; }
  .cf-fc-p-title { font-family: var(--fc-font-heading); font-size: clamp(32px, 4vw, 48px); font-weight: 400; margin-bottom: 16px; line-height: 1.1; }
  .cf-fc-p-price { font-size: 20px; color: var(--fc-primary); margin-bottom: 30px; display: flex; gap: 12px; align-items: center; }
  .cf-fc-p-compare { color: #888; text-decoration: line-through; font-size: 16px; }
  
  /* Options */
  .cf-fc-p-opt { margin-bottom: 30px; }
  .cf-fc-p-opt-header { display: flex; justify-content: space-between; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px; color: #555; }
  .cf-fc-p-vals { display: flex; flex-wrap: wrap; gap: 12px; }
  .cf-fc-p-val { padding: 12px 20px; border: 1px solid var(--fc-border); background: transparent; cursor: pointer; font-size: 13px; transition: all 0.2s; }
  .cf-fc-p-val:hover, .cf-fc-p-val.active { border-color: var(--fc-primary); background: var(--fc-primary); color: #fff; }
  
  /* Actions */
  .cf-fc-p-actions { display: grid; grid-template-columns: 100px 1fr; gap: 16px; margin-bottom: 40px; }
  .cf-fc-p-qty { display: flex; align-items: center; justify-content: space-between; border: 1px solid var(--fc-border); padding: 0 16px; }
  .cf-fc-p-qty button { background: none; border: none; font-size: 18px; cursor: pointer; color: var(--fc-text); }
  .cf-fc-p-add { background: var(--fc-primary); color: #fff; border: 1px solid var(--fc-primary); padding: 16px; font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: all 0.3s; }
  .cf-fc-p-add:hover { background: transparent; color: var(--fc-primary); }
  
  /* Details Tabs */
  .cf-fc-p-tabs { margin-top: 20px; border-top: 1px solid var(--fc-border); }
  .cf-fc-p-tab-nav { display: flex; gap: 30px; border-bottom: 1px solid var(--fc-border); margin-bottom: 24px; }
  .cf-fc-p-tab-btn { background: none; border: none; padding: 16px 0; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; color: #888; cursor: pointer; border-bottom: 1px solid transparent; margin-bottom: -1px; transition: all 0.2s; }
  .cf-fc-p-tab-btn.active { color: var(--fc-primary); border-bottom-color: var(--fc-primary); }
  .cf-fc-p-tab-content { display: none; font-size: 14px; color: #555; line-height: 1.8; }
  .cf-fc-p-tab-content.active { display: block; }
  .cf-fc-p-tab-content ul { padding-left: 20px; margin-top: 12px; }

  @media(max-width: 900px) {
    .cf-fc-p-wrap { grid-template-columns: 1fr; gap: 40px; }
    .cf-fc-p-info { position: static; }
  }
{% endstyle %}

<div class="cf-fc-p">
  <div class="cf-fc-p-wrap">
    
    <div class="cf-fc-p-gallery">
      {% for image in product.images %}
        <div class="cf-fc-p-img">
          <img src="{{ image | img_url: 'master' }}" alt="{{ product.title }}">
        </div>
      {% else %}
        <div class="cf-fc-p-img"></div>
        <div class="cf-fc-p-img"></div>
        <div class="cf-fc-p-img"></div>
      {% endfor %}
    </div>
    
    <div class="cf-fc-p-info">
      <div class="cf-fc-p-vendor">{{ product.vendor | default: section.settings.vendor_text }}</div>
      <h1 class="cf-fc-p-title">{{ product.title | default: 'The Effortless Silk Shirt' }}</h1>
      <div class="cf-fc-p-price">
        {{ product.price | money | default: '$145.00' }}
        {% if product.compare_at_price > product.price %}
          <span class="cf-fc-p-compare">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>
      
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="cf-fc-p-opt">
            <div class="cf-fc-p-opt-header">
              <span>{{ option.name }}</span>
              <span style="text-decoration:underline; cursor:pointer;">Size Guide</span>
            </div>
            <div class="cf-fc-p-vals">
              {% for value in option.values %}
                <button class="cf-fc-p-val {% if forloop.first %}active{% endif %}">{{ value }}</button>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      {% endunless %}
      
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <div class="cf-fc-p-actions">
          <div class="cf-fc-p-qty">
            <button type="button">-</button>
            <span>1</span>
            <button type="button">+</button>
          </div>
          <button type="submit" class="cf-fc-p-add">Add to Bag</button>
        </div>
      {% endform %}
      
      <div class="cf-fc-p-tabs">
        <div class="cf-fc-p-tab-nav">
          <button class="cf-fc-p-tab-btn active" onclick="fct(this, 1)">Details</button>
          <button class="cf-fc-p-tab-btn" onclick="fct(this, 2)">Material & Care</button>
          <button class="cf-fc-p-tab-btn" onclick="fct(this, 3)">Shipping</button>
        </div>
        <div class="cf-fc-p-tab-content active" id="fct-1">
          {{ product.description | default: 'A timeless silhouette crafted from lightweight silk. Designed with a relaxed fit, mother-of-pearl buttons, and a classic collar. Perfect for layering or wearing on its own.' }}
        </div>
        <div class="cf-fc-p-tab-content" id="fct-2">
          <ul>
            <li>100% Mulberry Silk</li>
            <li>Dry clean only</li>
            <li>Cool iron on reverse if needed</li>
            <li>Designed in Paris</li>
          </ul>
        </div>
        <div class="cf-fc-p-tab-content" id="fct-3">
          <p>Complimentary standard shipping on orders over $200. Express delivery available.</p>
          <p>Returns accepted within 14 days of delivery. Items must be in unworn condition with tags attached.</p>
        </div>
      </div>
      
    </div>
  </div>
</div>

<script>
  function fct(btn, id) {
    var p = btn.parentElement.parentElement;
    p.querySelectorAll('.cf-fc-p-tab-btn').forEach(b => b.classList.remove('active'));
    p.querySelectorAll('.cf-fc-p-tab-content').forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    p.querySelector('#fct-'+id).classList.add('active');
  }
</script>

{% schema %}
{
  "name": "CF Fashion PDP",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Primary Color", "default": "#0A0A0A" },
    { "type": "color", "id": "color_bg", "label": "Background Color", "default": "#F5F3EF" },
    { "type": "color", "id": "color_surface", "label": "Surface Color", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text Color", "default": "#1a1a1a" },
    { "type": "text", "id": "vendor_text", "label": "Default Vendor", "default": "VÅŒLT" }
  ],
  "presets": [
    { "name": "CF Fashion PDP" }
  ]
}
{% endschema %}