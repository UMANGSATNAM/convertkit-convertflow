{% comment %}
  ConvertFlow — Streetwear Product Page
  Brutalist, high-contrast, technical details, hype-driven UX.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap');

  :root {
    --sw-primary: {{ section.settings.color_primary | default: '#FF3366' }};
    --sw-bg: {{ section.settings.color_bg | default: '#0A0A0A' }};
    --sw-surface: {{ section.settings.color_surface | default: '#121212' }};
    --sw-text: {{ section.settings.color_text | default: '#FFFFFF' }};
    --sw-border: rgba(255, 255, 255, 0.15);
    --sw-font-heading: 'Space Grotesk', sans-serif;
    --sw-font-mono: 'Space Mono', monospace;
  }

  .cf-sw-p * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-sw-p { font-family: var(--sw-font-heading); background: var(--sw-bg); color: var(--sw-text); line-height: 1.6; border-top: 1px solid var(--sw-border); }
  
  .cf-sw-p-wrap { max-width: 1440px; margin: 0 auto; display: grid; grid-template-columns: 1fr 500px; min-height: 90vh; }
  
  /* Gallery */
  .cf-sw-p-gallery { border-right: 1px solid var(--sw-border); display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: min-content; }
  .cf-sw-p-img { border-bottom: 1px solid var(--sw-border); border-right: 1px solid var(--sw-border); background: #111; aspect-ratio: 4/5; }
  .cf-sw-p-img:nth-child(even) { border-right: none; }
  .cf-sw-p-img img { width: 100%; height: 100%; object-fit: cover; }
  
  /* Info sidebar */
  .cf-sw-p-info { padding: 40px; position: sticky; top: 0; height: 100vh; overflow-y: auto; scrollbar-width: none; }
  .cf-sw-p-info::-webkit-scrollbar { display: none; }
  
  .cf-sw-p-meta { display: flex; justify-content: space-between; font-family: var(--sw-font-mono); font-size: 12px; color: #888; margin-bottom: 24px; text-transform: uppercase; }
  .cf-sw-p-title { font-size: 36px; font-weight: 700; text-transform: uppercase; line-height: 1.1; margin-bottom: 16px; }
  .cf-sw-p-price { font-family: var(--sw-font-mono); font-size: 24px; color: var(--sw-primary); margin-bottom: 30px; font-weight: 700; }
  
  .cf-sw-p-desc { font-size: 15px; color: #aaa; margin-bottom: 40px; }
  
  /* Hype Banner */
  .cf-sw-p-hype { background: var(--sw-surface); border: 1px solid var(--sw-border); padding: 12px 16px; font-family: var(--sw-font-mono); font-size: 12px; font-weight: 700; color: var(--sw-text); display: flex; align-items: center; gap: 10px; margin-bottom: 30px; text-transform: uppercase; }
  .cf-sw-p-hype span { display: inline-block; width: 8px; height: 8px; background: var(--sw-primary); border-radius: 50%; animation: pulse 1.5s infinite; }
  @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.3; } 100% { opacity: 1; } }
  
  /* Options */
  .cf-sw-p-opt { margin-bottom: 30px; }
  .cf-sw-p-opt-header { display: flex; justify-content: space-between; font-family: var(--sw-font-mono); font-size: 12px; margin-bottom: 12px; text-transform: uppercase; color: #888; }
  .cf-sw-p-vals { display: grid; grid-template-columns: repeat(auto-fill, minmax(60px, 1fr)); gap: 10px; }
  .cf-sw-p-val { background: var(--sw-bg); border: 1px solid var(--sw-border); color: var(--sw-text); padding: 12px; font-family: var(--sw-font-mono); font-weight: 700; cursor: pointer; transition: all 0.2s; text-align: center; }
  .cf-sw-p-val:hover, .cf-sw-p-val.active { background: var(--sw-text); color: var(--sw-bg); }
  
  /* Actions */
  .cf-sw-p-actions { margin-bottom: 40px; }
  .cf-sw-p-add { width: 100%; padding: 20px; background: var(--sw-text); color: var(--sw-bg); border: none; font-family: var(--sw-font-heading); font-size: 18px; font-weight: 700; text-transform: uppercase; cursor: pointer; transition: all 0.2s; margin-bottom: 12px; }
  .cf-sw-p-add:hover { background: var(--sw-primary); color: #000; }
  .cf-sw-p-buy { width: 100%; padding: 20px; background: transparent; border: 1px solid var(--sw-border); color: var(--sw-text); font-family: var(--sw-font-heading); font-size: 18px; font-weight: 700; text-transform: uppercase; cursor: pointer; transition: all 0.2s; }
  .cf-sw-p-buy:hover { border-color: var(--sw-text); }
  
  /* Accordion */
  .cf-sw-p-acc { border-top: 1px solid var(--sw-border); }
  .cf-sw-p-acc-item { border-bottom: 1px solid var(--sw-border); }
  .cf-sw-p-acc-btn { width: 100%; background: transparent; border: none; padding: 20px 0; color: var(--sw-text); font-family: var(--sw-font-mono); font-size: 13px; font-weight: 700; text-transform: uppercase; text-align: left; cursor: pointer; display: flex; justify-content: space-between; }
  .cf-sw-p-acc-body { max-height: 0; overflow: hidden; transition: max-height 0.3s; color: #888; font-size: 14px; }
  .cf-sw-p-acc-body.open { max-height: 300px; padding-bottom: 20px; }

  @media(max-width: 900px) {
    .cf-sw-p-wrap { grid-template-columns: 1fr; }
    .cf-sw-p-gallery { border-right: none; }
    .cf-sw-p-info { position: static; height: auto; border-top: 1px solid var(--sw-border); }
  }
{% endstyle %}

<div class="cf-sw-p">
  <div class="cf-sw-p-wrap">
    
    <div class="cf-sw-p-gallery">
      {% for image in product.images %}
        <div class="cf-sw-p-img">
          <img src="{{ image | img_url: 'master' }}" alt="{{ product.title }}">
        </div>
      {% else %}
        <div class="cf-sw-p-img"><div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-family:monospace; color:#333;">IMG_01</div></div>
        <div class="cf-sw-p-img"><div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-family:monospace; color:#333;">IMG_02</div></div>
        <div class="cf-sw-p-img"><div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-family:monospace; color:#333;">IMG_03</div></div>
        <div class="cf-sw-p-img"><div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-family:monospace; color:#333;">IMG_04</div></div>
      {% endfor %}
    </div>
    
    <div class="cf-sw-p-info">
      <div class="cf-sw-p-meta">
        <span>ID: {{ product.id | default: '8492018' }}</span>
        <span>{{ product.vendor | default: 'SYSTEM' }}</span>
      </div>
      
      <h1 class="cf-sw-p-title">{{ product.title | default: 'Heavyweight Utility Jacket' }}</h1>
      <div class="cf-sw-p-price">{{ product.price | money | default: '$180.00' }}</div>
      
      <div class="cf-sw-p-hype">
        <span></span> {{ section.settings.hype_text | default: 'HIGH DEMAND. SELLING FAST.' }}
      </div>
      
      <p class="cf-sw-p-desc">{{ product.description | strip_html | truncate: 200 | default: 'Constructed from heavy-duty ripstop cotton. Features multiple utility pockets, matte black hardware, and an oversized drop-shoulder fit.' }}</p>
      
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="cf-sw-p-opt">
            <div class="cf-sw-p-opt-header">
              <span>{{ option.name }}</span>
              <span style="text-decoration:underline; cursor:pointer;">Size Guide</span>
            </div>
            <div class="cf-sw-p-vals">
              {% for value in option.values %}
                <button class="cf-sw-p-val {% if forloop.first %}active{% endif %}">{{ value }}</button>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      {% endunless %}
      
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <div class="cf-sw-p-actions">
          <button type="submit" class="cf-sw-p-add">Add To Cart // +</button>
          <button type="button" class="cf-sw-p-buy">Buy Now // &rarr;</button>
        </div>
      {% endform %}
      
      <div class="cf-sw-p-acc">
        <div class="cf-sw-p-acc-item">
          <button class="cf-sw-p-acc-btn" onclick="this.nextElementSibling.classList.toggle('open')">
            Technical Specs <span>[+]</span>
          </button>
          <div class="cf-sw-p-acc-body open">
            {{ section.settings.specs_text | default: '100% Cotton Ripstop. Water-resistant finish. YKK Zippers. Adjustable cuffs and hem.' }}
          </div>
        </div>
        <div class="cf-sw-p-acc-item">
          <button class="cf-sw-p-acc-btn" onclick="this.nextElementSibling.classList.toggle('open')">
            Shipping & Returns <span>[+]</span>
          </button>
          <div class="cf-sw-p-acc-body">
            Ships within 24 hours. Free returns within 14 days of delivery. Original condition required.
          </div>
        </div>
      </div>
      
    </div>
  </div>
</div>

</div>

</div>

{% schema %}
{
  "name": "CF Streetwear PDP",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Accent Color", "default": "#FF3366" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#0A0A0A" },
    { "type": "color", "id": "color_surface", "label": "Surface", "default": "#121212" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#FFFFFF" },
    { "type": "text", "id": "hype_text", "label": "Hype Banner Text", "default": "HIGH DEMAND. SELLING FAST." }
  ],
  "presets": [
    { "name": "CF Streetwear PDP" }
  ]
}
{% endschema %}


