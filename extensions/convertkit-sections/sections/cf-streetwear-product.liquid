{% comment %}ConvertFlow — URBNCO Streetwear · Product Page{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
:root{--cf-accent:{{ section.settings.color_accent | default: '#E63946' }};--cf-bg:{{ section.settings.color_bg | default: '#0A0A0A' }};--cf-mid:#141414;--cf-border:#2a2a2a;--cf-txt:#FAFAFA;}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Barlow',sans-serif;background:var(--cf-bg);color:var(--cf-txt);-webkit-font-smoothing:antialiased}
.cfp-crumb{padding:14px 60px;font-size:12px;color:#666;background:var(--cf-mid);border-bottom:1px solid var(--cf-border)}
.cfp-crumb a{color:#666;text-decoration:none}
.cfp-wrap{max-width:1300px;margin:0 auto;padding:60px;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}
.cfp-main-img{background:#1e1e1e;aspect-ratio:1;display:flex;align-items:center;justify-content:center;margin-bottom:16px;overflow:hidden}
.cfp-main-img img{width:100%;height:100%;object-fit:cover}
.cfp-thumbs{display:flex;gap:10px}
.cfp-thumb{width:80px;aspect-ratio:1;background:#1e1e1e;border:2px solid transparent;cursor:pointer;overflow:hidden;background-size:cover;background-position:center}
.cfp-thumb.active,.cfp-thumb:hover{border-color:var(--cf-accent)}
.cfp-vendor{font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--cf-accent);margin-bottom:12px;display:block}
.cfp-name{font-family:'Bebas Neue',sans-serif;font-size:52px;letter-spacing:2px;line-height:1;margin-bottom:16px}
.cfp-rating{display:flex;align-items:center;gap:8px;margin-bottom:20px;color:#666;font-size:13px}
.cfp-stars{color:#F59E0B;letter-spacing:2px}
.cfp-price-row{display:flex;align-items:center;gap:16px;margin-bottom:24px;padding-bottom:24px;border-bottom:1px solid var(--cf-border)}
.cfp-price{font-size:32px;font-weight:700}
.cfp-compare{font-size:20px;color:#444;text-decoration:line-through}
.cfp-save{background:var(--cf-accent);color:#fff;padding:4px 12px;font-size:12px;font-weight:700}
.cfp-desc{font-size:15px;color:#aaa;line-height:1.8;margin-bottom:28px}
.cfp-label{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:10px;color:#888}
.cfp-variants{display:flex;gap:8px;margin-bottom:24px;flex-wrap:wrap}
.cfp-var{padding:8px 18px;border:1.5px solid var(--cf-border);background:#1e1e1e;font-size:13px;font-weight:600;cursor:pointer;transition:all .2s;color:var(--cf-txt);font-family:inherit}
.cfp-var:hover,.cfp-var.active{border-color:var(--cf-accent);background:var(--cf-accent);color:#fff}
.cfp-qty-row{display:flex;gap:12px;margin-bottom:12px}
.cfp-qty{display:flex;align-items:center;border:1.5px solid var(--cf-border);overflow:hidden}
.cfp-qty button{width:40px;height:52px;background:#1e1e1e;border:none;font-size:20px;cursor:pointer;color:var(--cf-txt)}
.cfp-qty span{width:40px;text-align:center;font-size:16px;font-weight:700;color:var(--cf-txt)}
.cfp-atc{flex:1;background:var(--cf-accent);color:#fff;border:none;padding:16px 32px;font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:2px;cursor:pointer;transition:opacity .2s}
.cfp-atc:hover{opacity:.9}
.cfp-buy-now{display:block;width:100%;background:#fff;color:var(--cf-bg);border:none;padding:14px;font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:2px;cursor:pointer;margin-top:8px;transition:opacity .2s}
.cfp-buy-now:hover{opacity:.85}
.cfp-trust{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:24px;padding-top:24px;border-top:1px solid var(--cf-border)}
.cfp-trust-item{display:flex;align-items:center;gap:8px;font-size:12px;color:#666}
.cfp-trust-icon{color:var(--cf-accent)}
.cfp-tabs{background:var(--cf-mid);border-top:1px solid var(--cf-border);padding:60px}
.cfp-tabs-inner{max-width:1300px;margin:0 auto}
.cfp-tab-nav{display:flex;border-bottom:2px solid var(--cf-border);margin-bottom:40px}
.cfp-tab-btn{padding:14px 28px;font-size:14px;font-weight:600;cursor:pointer;border:none;background:none;color:#666;border-bottom:2px solid transparent;margin-bottom:-2px;font-family:inherit}
.cfp-tab-btn.active{color:var(--cf-accent);border-bottom-color:var(--cf-accent)}
.cfp-tab-content{display:none;font-size:15px;color:#aaa;line-height:1.9}
.cfp-tab-content.active{display:block}
.cfp-related{padding:80px 60px;background:var(--cf-mid);border-top:1px solid var(--cf-border)}
.cfp-related-inner{max-width:1300px;margin:0 auto}
.cfp-related h2{font-family:'Bebas Neue',sans-serif;font-size:40px;letter-spacing:2px;margin-bottom:36px;text-align:center}
.cfp-related-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
.cfp-rel-card{background:#1e1e1e;text-decoration:none;color:var(--cf-txt);display:block;transition:all .3s;overflow:hidden}
.cfp-rel-card:hover{transform:translateY(-4px)}
.cfp-rel-img{aspect-ratio:1;background:#262626;overflow:hidden}
.cfp-rel-img img{width:100%;height:100%;object-fit:cover}
.cfp-rel-info{padding:16px}
.cfp-rel-name{font-size:14px;font-weight:500;margin-bottom:6px;color:#ccc}
.cfp-rel-price{font-size:18px;font-weight:700;color:var(--cf-accent)}
@media(max-width:1024px){.cfp-wrap{grid-template-columns:1fr;padding:30px 20px;gap:30px}.cfp-tabs,.cfp-related{padding:40px 20px}.cfp-related-grid{grid-template-columns:repeat(2,1fr)}}
</style>

{% if section.settings.show_breadcrumb %}
<div class="cfp-crumb"><a href="/">Home</a> › <a href="/collections/{{ product.type | handleize }}">{{ product.type | default: 'Streetwear' }}</a> › {{ product.title }}</div>
{% endif %}

<div class="cfp-wrap">
  <div>
    <div class="cfp-main-img" id="cfpMainImg">
      {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title }}" id="cfpMainImgEl">{% endif %}
    </div>
    <div class="cfp-thumbs">
      {% for image in product.images limit: 5 %}
        <div class="cfp-thumb {% if forloop.first %}active{% endif %}" onclick="document.getElementById('cfpMainImgEl').src='{{ image | image_url: width: 800 }}';document.querySelectorAll('.cfp-thumb').forEach(t=>t.classList.remove('active'));this.classList.add('active')" style="background-image:url('{{ image | image_url: width: 200 }}')"></div>
      {% endfor %}
    </div>
  </div>
  <div>
    {% if section.settings.show_vendor %}<span class="cfp-vendor">{{ product.vendor }}</span>{% endif %}
    <h1 class="cfp-name">{{ product.title }}</h1>
    {% if section.settings.show_rating %}
    <div class="cfp-rating"><span class="cfp-stars">★★★★★</span> 4.9 · {{ section.settings.review_count }}</div>
    {% endif %}
    <div class="cfp-price-row">
      <div class="cfp-price">{{ product.price | money }}</div>
      {% if product.compare_at_price > product.price %}
        <div class="cfp-compare">{{ product.compare_at_price | money }}</div>
        <span class="cfp-save">{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round }}% OFF</span>
      {% endif %}
    </div>
    <p class="cfp-desc">{{ product.description | strip_html | truncate: 280 }}</p>
    {% unless product.has_only_default_variant %}
      {% for option in product.options_with_values %}
        <div class="cfp-label">{{ option.name }}</div>
        <div class="cfp-variants">{% for value in option.values %}<button class="cfp-var{% if forloop.first %} active{% endif %}">{{ value }}</button>{% endfor %}</div>
      {% endfor %}
    {% endunless %}
    <div class="cfp-qty-row">
      <div class="cfp-qty">
        <button onclick="var s=this.nextElementSibling;s.textContent=Math.max(1,+s.textContent-1)">−</button>
        <span>1</span>
        <button onclick="var s=this.previousElementSibling;s.textContent=+s.textContent+1">+</button>
      </div>
      <button class="cfp-atc">{{ section.settings.atc_text }}</button>
    </div>
    {% if section.settings.show_buy_now %}<button class="cfp-buy-now">{{ section.settings.buy_now_text }}</button>{% endif %}
    <div class="cfp-trust">
      <div class="cfp-trust-item"><span class="cfp-trust-icon"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>{{ section.settings.trust_1 }}</div>
      <div class="cfp-trust-item"><span class="cfp-trust-icon"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg></span>{{ section.settings.trust_2 }}</div>
    </div>
  </div>
</div>

<div class="cfp-tabs">
  <div class="cfp-tabs-inner">
    <div class="cfp-tab-nav">
      <button class="cfp-tab-btn active" onclick="cfpTab(this,'Desc')">Description</button>
      <button class="cfp-tab-btn" onclick="cfpTab(this,'Specs')">Specs</button>
      <button class="cfp-tab-btn" onclick="cfpTab(this,'Ship')">Shipping</button>
    </div>
    <div id="cfpDesc" class="cfp-tab-content active">{{ product.description }}</div>
    <div id="cfpSpecs" class="cfp-tab-content">
      <table style="width:100%;border-collapse:collapse">
        <tr style="border-bottom:1px solid var(--cf-border)"><td style="padding:12px 0;color:#666;width:40%">Type</td><td>{{ product.type }}</td></tr>
        <tr style="border-bottom:1px solid var(--cf-border)"><td style="padding:12px 0;color:#666">Vendor</td><td>{{ product.vendor }}</td></tr>
        <tr><td style="padding:12px 0;color:#666">Availability</td><td>{% if product.available %}In Stock{% else %}Out of Stock{% endif %}</td></tr>
      </table>
    </div>
    <div id="cfpShip" class="cfp-tab-content"><p>Free standard delivery on orders above ₹999. Easy 30-day returns.</p></div>
  </div>
</div>

{% if section.settings.show_related and section.settings.related_collection != blank %}
<div class="cfp-related">
  <div class="cfp-related-inner">
    <h2>{{ section.settings.related_heading }}</h2>
    <div class="cfp-related-grid">
      {% for p in section.settings.related_collection.products limit: 4 %}
        <a href="{{ p.url }}" class="cfp-rel-card">
          <div class="cfp-rel-img">{% if p.featured_image %}<img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.title }}" loading="lazy">{% endif %}</div>
          <div class="cfp-rel-info"><div class="cfp-rel-name">{{ p.title | truncate: 50 }}</div><div class="cfp-rel-price">{{ p.price | money }}</div></div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>
{% endif %}

<script>function cfpTab(btn,id){document.querySelectorAll('.cfp-tab-btn').forEach(b=>b.classList.remove('active'));document.querySelectorAll('.cfp-tab-content').forEach(c=>c.classList.remove('active'));btn.classList.add('active');document.getElementById('cfp'+id).classList.add('active');}</script>

{% schema %}
{
  "name": "CF URBNCO PDP",
  "settings": [
    {"type":"header","content":"Brand Colors"},
    {"type":"color","id":"color_accent","label":"Accent Color","default":"#E63946"},
    {"type":"color","id":"color_bg","label":"Background","default":"#0A0A0A"},
    {"type":"header","content":"Product Page"},
    {"type":"checkbox","id":"show_breadcrumb","label":"Show Breadcrumb","default":true},
    {"type":"checkbox","id":"show_vendor","label":"Show Vendor","default":true},
    {"type":"checkbox","id":"show_rating","label":"Show Rating","default":true},
    {"type":"text","id":"review_count","label":"Review Count Text","default":"3,412 reviews"},
    {"type":"header","content":"Buttons"},
    {"type":"text","id":"atc_text","label":"Add to Cart Text","default":"Add to Cart"},
    {"type":"checkbox","id":"show_buy_now","label":"Show Buy Now","default":true},
    {"type":"text","id":"buy_now_text","label":"Buy Now Text","default":"Buy Now"},
    {"type":"header","content":"Trust Badges"},
    {"type":"text","id":"trust_1","label":"Badge 1","default":"100% Authentic"},
    {"type":"text","id":"trust_2","label":"Badge 2","default":"Easy Returns"},
    {"type":"header","content":"Related Products"},
    {"type":"checkbox","id":"show_related","label":"Show Related","default":true},
    {"type":"text","id":"related_heading","label":"Heading","default":"You Might Also Cop"},
    {"type":"collection","id":"related_collection","label":"Related Collection"}
  ],
  "presets":[{"name":"CF URBNCO PDP"}]
}
{% endschema %}
