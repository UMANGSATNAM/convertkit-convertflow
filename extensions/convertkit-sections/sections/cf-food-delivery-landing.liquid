{% comment %}ConvertFlow - Food Delivery Landing | Veda Eats style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
.cfd *{box-sizing:border-box;margin:0;padding:0}
.cfd{font-family:'Poppins',sans-serif;font-size:15px;color:{{ section.settings.color_text }};background:{{ section.settings.color_bg }};-webkit-font-smoothing:antialiased}
.cfd a{text-decoration:none}
/* TOP BAR */
.cfd-top{background:{{ section.settings.color_accent }};color:#fff;text-align:center;padding:9px;font-size:12px;font-weight:600;letter-spacing:.5px}
/* HERO */
.cfd-hero{background:linear-gradient(120deg,#1A0A00 0%,#3A1A00 60%,#2A0E00 100%);min-height:88vh;display:grid;grid-template-columns:1fr 1fr;padding:0 60px;align-items:center;gap:60px;position:relative;overflow:hidden}
.cfd-hero::before{content:'';position:absolute;top:-100px;right:-100px;width:500px;height:500px;border-radius:50%;background:rgba(255,87,34,.08)}
.cfd-hero::after{content:'';position:absolute;bottom:-100px;left:20%;width:400px;height:400px;border-radius:50%;background:rgba(255,193,7,.05)}
.cfd-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(255,87,34,.2);border:1px solid rgba(255,87,34,.3);color:{{ section.settings.color_accent }};padding:8px 18px;border-radius:100px;font-size:12px;font-weight:600;margin-bottom:20px}
.cfd-h1{font-size:68px;font-weight:800;line-height:1.05;color:#fff;margin-bottom:20px}
.cfd-h1 span{color:{{ section.settings.color_accent }}}
.cfd-sub{font-size:17px;color:rgba(255,255,255,.5);line-height:1.8;max-width:440px;margin-bottom:40px}
.cfd-loc{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:16px;padding:20px 24px;display:flex;align-items:center;gap:16px;max-width:500px;margin-bottom:14px}
.cfd-loc svg{width:20px;color:{{ section.settings.color_accent }};flex-shrink:0}
.cfd-loc input{background:transparent;border:none;outline:none;font-family:'Poppins',sans-serif;font-size:15px;color:#fff;flex:1}
.cfd-loc input::placeholder{color:rgba(255,255,255,.3)}
.cfd-loc-btn{background:{{ section.settings.color_accent }};color:#fff;border:none;padding:12px 24px;border-radius:12px;font-family:'Poppins',sans-serif;font-size:13px;font-weight:700;cursor:pointer;white-space:nowrap}
.cfd-delivery{font-size:13px;color:rgba(255,255,255,.35);font-weight:500}
.cfd-visual{position:relative;z-index:1;display:flex;align-items:center;justify-content:center}
.cfd-float{width:100%;max-width:420px;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(255,87,34,.15),rgba(255,87,34,.03));display:flex;align-items:center;justify-content:center;border:1px dashed rgba(255,87,34,.2)}
.cfd-float svg{width:50%;color:{{ section.settings.color_accent }};opacity:.3}
/* CUISINE TABS */
.cfd-cuisine{background:#fff;padding:30px 60px;border-bottom:1px solid #F0E4D8}
.cfd-cuisine-inner{display:flex;gap:12px;overflow-x:auto;padding-bottom:4px}
.cfd-chip{display:flex;align-items:center;gap:8px;padding:12px 20px;border-radius:100px;border:1.5px solid #F0E4D8;background:transparent;font-family:'Poppins',sans-serif;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap;color:#2A1A0E;transition:all .2s}
.cfd-chip:hover,.cfd-chip.active{border-color:{{ section.settings.color_accent }};color:{{ section.settings.color_accent }};background:rgba(255,87,34,.06)}
/* MENU GRID */
.cfd-menu{padding:80px 60px;max-width:1400px;margin:0 auto}
.cfd-menu-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:48px}
.cfd-menu-head h2{font-size:36px;font-weight:800;color:#2A1A0E}
.cfd-menu-head a{font-size:13px;font-weight:600;color:{{ section.settings.color_accent }}}
.cfd-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.cfd-card{background:#fff;border-radius:20px;overflow:hidden;border:1px solid #F0E4D8;transition:all .3s;cursor:pointer}
.cfd-card:hover{box-shadow:0 12px 40px rgba(255,87,34,.08);transform:translateY(-4px)}
.cfd-mc-img{aspect-ratio:16/9;background:linear-gradient(135deg,#FFF0E0,#FFE0C0);display:flex;align-items:center;justify-content:center;position:relative}
.cfd-mc-img svg{width:35%;color:{{ section.settings.color_accent }};opacity:.4;transition:opacity .3s,transform .4s}
.cfd-card:hover .cfd-mc-img svg{opacity:.7;transform:scale(1.06)}
.cfd-mc-badge{position:absolute;top:14px;left:14px;background:{{ section.settings.color_accent }};color:#fff;padding:5px 14px;border-radius:100px;font-size:10px;font-weight:700;letter-spacing:.5px}
.cfd-mc-badge.veg{background:#27AE60}
.cfd-mc-time{position:absolute;top:14px;right:14px;background:rgba(0,0,0,.5);color:#fff;padding:4px 12px;border-radius:100px;font-size:11px;font-weight:600}
.cfd-mc-body{padding:20px}
.cfd-mc-kitchen{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:{{ section.settings.color_accent }};margin-bottom:6px}
.cfd-mc-name{font-size:18px;font-weight:700;margin-bottom:6px;color:#2A1A0E}
.cfd-mc-desc{font-size:13px;color:#8A7060;line-height:1.6;margin-bottom:16px}
.cfd-mc-foot{display:flex;justify-content:space-between;align-items:center}
.cfd-mc-price strong{font-size:22px;font-weight:800;color:#2A1A0E}
.cfd-mc-off{font-size:12px;color:#27AE60;font-weight:700;margin-left:6px}
.cfd-mc-atc{background:{{ section.settings.color_accent }};color:#fff;border:none;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:22px;font-weight:700;flex-shrink:0}
/* TRUST */
.cfd-trust{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #F0E4D8;border-bottom:1px solid #F0E4D8}
.cfd-t-item{padding:40px 32px;text-align:center;border-right:1px solid #F0E4D8}
.cfd-t-item:last-child{border-right:none}
.cfd-t-icon{font-size:36px;margin-bottom:12px}
.cfd-t-num{font-size:28px;font-weight:800;color:{{ section.settings.color_accent }};margin-bottom:4px}
.cfd-t-label{font-size:12px;color:#8A7060;font-weight:500}
/* FOOTER */
.cfd-footer{background:#1A0A00;padding:70px 60px 36px}
.cfd-fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;padding-bottom:60px;border-bottom:1px solid rgba(255,255,255,.08)}
.cfd-fb-brand{font-size:22px;font-weight:800;color:#fff;margin-bottom:16px;display:flex;align-items:center;gap:8px}
.cfd-fb-brand span{width:32px;height:32px;background:{{ section.settings.color_accent }};border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:16px}
.cfd-fb p{font-size:13px;color:rgba(255,255,255,.35);line-height:1.9;max-width:260px}
.cfd-fc h4{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:{{ section.settings.color_accent }};margin-bottom:20px}
.cfd-fc ul{list-style:none}
.cfd-fc li{margin-bottom:10px}
.cfd-fc a{color:rgba(255,255,255,.4);font-size:14px;text-decoration:none;transition:color .2s}
.cfd-fc a:hover{color:#fff}
.cfd-fbot{display:flex;justify-content:space-between;padding-top:28px;font-size:11px;color:rgba(255,255,255,.2)}
@media(max-width:1024px){.cfd-hero{grid-template-columns:1fr;padding:60px 40px;min-height:auto}.cfd-visual{display:none}.cfd-grid{grid-template-columns:repeat(2,1fr)}.cfd-trust{grid-template-columns:1fr 1fr}.cfd-fg{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cfd-hero{padding:60px 20px}.cfd-h1{font-size:44px}.cfd-cuisine{padding:20px}.cfd-menu{padding:60px 20px}.cfd-grid{grid-template-columns:1fr}.cfd-trust{grid-template-columns:1fr 1fr}.cfd-fg{grid-template-columns:1fr;gap:40px}.cfd-footer{padding:60px 20px 30px}}
</style>

<div class="cfd">
  {% if section.settings.top_bar_text != blank %}
  <div class="cfd-top">{{ section.settings.top_bar_text }}</div>
  {% endif %}

  <section class="cfd-hero">
    <div>
      {% if section.settings.hero_badge != blank %}
      <div class="cfd-badge">{{ section.settings.hero_badge }}</div>
      {% endif %}
      <h1 class="cfd-h1">{{ section.settings.hero_heading | newline_to_br }}</h1>
      <p class="cfd-sub">{{ section.settings.hero_subtext }}</p>
      <div class="cfd-loc">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <input type="text" placeholder="{{ section.settings.location_placeholder }}">
        <button class="cfd-loc-btn">{{ section.settings.cta_text }}</button>
      </div>
      <div class="cfd-delivery">{{ section.settings.delivery_cities }}</div>
    </div>
    <div class="cfd-visual">
      <div class="cfd-float">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path d="M3 11l19-9-9 19-2-8-8-2z"/></svg>
      </div>
    </div>
  </section>

  {% if section.settings.show_cuisine_tabs %}
  <div class="cfd-cuisine">
    <div class="cfd-cuisine-inner">
      {% for block in section.blocks %}
        {% if block.type == 'cuisine_tab' %}
        <button class="cfd-chip{% if forloop.first %} active{% endif %}" {{ block.shopify_attributes }}>
          <span>{{ block.settings.icon }}</span>{{ block.settings.label }}
        </button>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <section class="cfd-menu">
    <div class="cfd-menu-head">
      <h2>{{ section.settings.menu_heading }}</h2>
      <a href="{{ section.settings.menu_link }}">{{ section.settings.menu_link_text }}</a>
    </div>
    <div class="cfd-grid">
      {% for block in section.blocks %}
        {% if block.type == 'menu_item' %}
        <div class="cfd-card" {{ block.shopify_attributes }}>
          <div class="cfd-mc-img">
            {% if block.settings.badge != blank %}<span class="cfd-mc-badge{% if block.settings.badge_style == 'veg' %} veg{% endif %}">{{ block.settings.badge }}</span>{% endif %}
            {% if block.settings.delivery_time != blank %}<span class="cfd-mc-time">⏱ {{ block.settings.delivery_time }}</span>{% endif %}
            {% if block.settings.image %}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name }}" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0">
            {% else %}
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path d="M16 11l-4-8-4 8a7.07 7.07 0 000 2c.75 3.86 3.07 7 4 7s3.25-3.14 4-7a7.07 7.07 0 000-2z"/></svg>
            {% endif %}
          </div>
          <div class="cfd-mc-body">
            <div class="cfd-mc-kitchen">{{ block.settings.kitchen_name }}</div>
            <div class="cfd-mc-name">{{ block.settings.name }}</div>
            <div class="cfd-mc-desc">{{ block.settings.description }}</div>
            <div class="cfd-mc-foot">
              <div class="cfd-mc-price">
                <strong>{{ block.settings.price }}</strong>
                {% if block.settings.discount != blank %}<span class="cfd-mc-off">{{ block.settings.discount }}</span>{% endif %}
              </div>
              <button class="cfd-mc-atc">+</button>
            </div>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  {% if section.settings.show_trust %}
  <div class="cfd-trust">
    {% for block in section.blocks %}
      {% if block.type == 'trust_stat' %}
      <div class="cfd-t-item" {{ block.shopify_attributes }}>
        <div class="cfd-t-icon">{{ block.settings.icon }}</div>
        <div class="cfd-t-num">{{ block.settings.value }}</div>
        <div class="cfd-t-label">{{ block.settings.label }}</div>
      </div>
      {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  <footer class="cfd-footer">
    <div class="cfd-fg">
      <div class="cfd-fb">
        <div class="cfd-fb-brand"><span>{{ section.settings.brand_icon }}</span>{{ section.settings.brand_name }}</div>
        <p>{{ section.settings.brand_desc }}</p>
      </div>
      <div class="cfd-fc"><h4>Explore</h4><ul>
        <li><a href="#">Full Menu</a></li>
        <li><a href="#">Cuisines</a></li>
        <li><a href="#">Offers</a></li>
        <li><a href="#">Combos</a></li>
      </ul></div>
      <div class="cfd-fc"><h4>Company</h4><ul>
        <li><a href="#">About Us</a></li>
        <li><a href="#">List Your Kitchen</a></li>
        <li><a href="#">Careers</a></li>
        <li><a href="#">Blog</a></li>
      </ul></div>
      <div class="cfd-fc"><h4>Help</h4><ul>
        <li><a href="#">Track Order</a></li>
        <li><a href="#">Refund Policy</a></li>
        <li><a href="#">FAQ</a></li>
        <li><a href="#">Contact</a></li>
      </ul></div>
    </div>
    <div class="cfd-fbot">
      <span>{{ section.settings.copyright }}</span>
      <span>Privacy &middot; Terms</span>
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "CF Food Delivery",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "text", "id": "brand_name", "label": "Brand Name", "default": "VEDA EATS" },
    { "type": "text", "id": "brand_icon", "label": "Brand Icon (emoji)", "default": "🍛" },
    { "type": "textarea", "id": "brand_desc", "label": "Brand Description", "default": "Bringing chef-quality meals from the best cloud kitchens to your doorstep, every single day." },
    { "type": "text", "id": "copyright", "label": "Copyright Text", "default": "© 2025 Veda Eats. FSSAI Lic. No. 12345678." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_accent", "label": "Accent Color", "default": "#FF5722" },
    { "type": "color", "id": "color_bg", "label": "Page Background", "default": "#FFF7F0" },
    { "type": "color", "id": "color_text", "label": "Body Text Color", "default": "#2A1A0E" },
    { "type": "header", "content": "Top Bar" },
    { "type": "text", "id": "top_bar_text", "label": "Top Bar Message", "default": "🛵 30-minute delivery guaranteed or your next order is FREE!" },
    { "type": "header", "content": "Hero Section" },
    { "type": "text", "id": "hero_badge", "label": "Hero Badge", "default": "🔥 400+ Daily Orders — 4.8★ Rating" },
    { "type": "textarea", "id": "hero_heading", "label": "Hero Heading (use newlines)", "default": "Restaurant\nQuality\nAt Home." },
    { "type": "textarea", "id": "hero_subtext", "label": "Hero Subtext", "default": "Chef-crafted meals from top cloud kitchens, delivered fresh to your door in under 30 minutes." },
    { "type": "text", "id": "location_placeholder", "label": "Location Input Placeholder", "default": "Enter your delivery address..." },
    { "type": "text", "id": "cta_text", "label": "CTA Button Text", "default": "Find Food" },
    { "type": "text", "id": "delivery_cities", "label": "Delivery Cities Text", "default": "📍 Currently delivering in Bangalore, Mumbai & Delhi" },
    { "type": "header", "content": "Cuisine Tabs" },
    { "type": "checkbox", "id": "show_cuisine_tabs", "label": "Show Cuisine Tabs", "default": true },
    { "type": "header", "content": "Menu Section" },
    { "type": "text", "id": "menu_heading", "label": "Menu Section Heading", "default": "🔥 Popular Right Now" },
    { "type": "text", "id": "menu_link_text", "label": "Menu Link Text", "default": "See full menu" },
    { "type": "url", "id": "menu_link", "label": "Menu Link URL" },
    { "type": "header", "content": "Trust Strip" },
    { "type": "checkbox", "id": "show_trust", "label": "Show Trust Stats Strip", "default": true }
  ],
  "blocks": [
    {
      "type": "cuisine_tab",
      "name": "Cuisine Tab",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🍽️" },
        { "type": "text", "id": "label", "label": "Tab Label", "default": "All" }
      ]
    },
    {
      "type": "menu_item",
      "name": "Menu Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Food Image" },
        { "type": "text", "id": "badge", "label": "Badge Text", "default": "Bestseller" },
        { "type": "select", "id": "badge_style", "label": "Badge Style", "options": [{ "value": "normal", "label": "Orange" }, { "value": "veg", "label": "Green (Veg)" }], "default": "normal" },
        { "type": "text", "id": "delivery_time", "label": "Delivery Time", "default": "22 min" },
        { "type": "text", "id": "kitchen_name", "label": "Kitchen Name", "default": "Punjabi Kitchen" },
        { "type": "text", "id": "name", "label": "Dish Name", "default": "Dal Makhani + Naan Combo" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Slow-cooked black lentils in a rich tomato & cream gravy. Served with 2 butter naan." },
        { "type": "text", "id": "price", "label": "Price", "default": "₹199" },
        { "type": "text", "id": "discount", "label": "Discount Label (optional)", "default": "20% OFF" }
      ]
    },
    {
      "type": "trust_stat",
      "name": "Trust Stat",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "⏱" },
        { "type": "text", "id": "value", "label": "Value", "default": "28 min" },
        { "type": "text", "id": "label", "label": "Label", "default": "Avg Delivery Time" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF Food Delivery",
      "blocks": [
        { "type": "cuisine_tab", "settings": { "icon": "🍽️", "label": "All" } },
        { "type": "cuisine_tab", "settings": { "icon": "🍜", "label": "North Indian" } },
        { "type": "cuisine_tab", "settings": { "icon": "🥘", "label": "South Indian" } },
        { "type": "cuisine_tab", "settings": { "icon": "🍕", "label": "Italian" } },
        { "type": "cuisine_tab", "settings": { "icon": "🍣", "label": "Asian" } },
        { "type": "cuisine_tab", "settings": { "icon": "🥗", "label": "Healthy" } },
        { "type": "menu_item", "settings": { "badge": "Bestseller", "delivery_time": "22 min", "kitchen_name": "Punjabi Kitchen", "name": "Dal Makhani + Naan Combo", "description": "Slow-cooked black lentils in a rich tomato & cream gravy. Served with 2 butter naan.", "price": "₹199", "discount": "20% OFF" } },
        { "type": "menu_item", "settings": { "badge": "Veg", "badge_style": "veg", "delivery_time": "18 min", "kitchen_name": "South Bites", "name": "Masala Dosa & Filter Coffee", "description": "Crispy golden dosa with spiced potato filling, sambar, 2 chutneys, and filter coffee.", "price": "₹149", "discount": "" } },
        { "type": "menu_item", "settings": { "badge": "Chef's Pick", "delivery_time": "25 min", "kitchen_name": "Fusion Fire", "name": "Butter Chicken Pasta", "description": "A fusion of creamy butter chicken sauce tossed with penne pasta. Topped with fresh cream.", "price": "₹259", "discount": "10% OFF" } },
        { "type": "trust_stat", "settings": { "icon": "⏱", "value": "28 min", "label": "Avg Delivery Time" } },
        { "type": "trust_stat", "settings": { "icon": "🍽️", "value": "50+", "label": "Cloud Kitchens" } },
        { "type": "trust_stat", "settings": { "icon": "⭐", "value": "4.8", "label": "Average Rating" } },
        { "type": "trust_stat", "settings": { "icon": "😊", "value": "2L+", "label": "Happy Customers" } }
      ]
    }
  ]
}
{% endschema %}