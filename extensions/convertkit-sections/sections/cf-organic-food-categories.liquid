<style>
.cf-org-cat-wrap {
  background: var(--bg, #FFFFFF);
  color: var(--text, #2C3E35);
  font-family: 'Public Sans', sans-serif;
  -webkit-font-smoothing: antialiased;
}
.cat-circles { display: flex; justify-content: center; gap: 40px; padding: 40px 60px; max-width: 1400px; margin: 0 auto; overflow-x: auto; }
.cat-circle { display: flex; flex-direction: column; align-items: center; gap: 12px; text-decoration: none; color: inherit; }
.cat-img { width: 100px; height: 100px; border-radius: 50%; background: var(--primary-light, #E9F2EC); display: flex; align-items: center; justify-content: center; border: 2px solid transparent; transition: all 0.3s; overflow: hidden; position: relative; }
.cat-img svg { width: 40px; height: 40px; color: var(--primary, #4A7C59); position: relative; z-index: 1; }
.cat-img img { width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; z-index: 10; }
.cat-circle:hover .cat-img { border-color: var(--primary, #4A7C59); background: #fff; transform: translateY(-4px); box-shadow: 0 10px 20px rgba(74, 124, 89, 0.15); }
.cat-circle span { font-weight: 600; font-size: 14px; }
@media(max-width: 768px) { .cat-circles { gap: 20px; padding: 20px; justify-content: flex-start; } .cat-img { width: 80px; height: 80px; } }
</style>

<div class="cf-org-cat-wrap">
  <div class="cat-circles">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link | default: '#' }}" class="cat-circle" {{ block.shopify_attributes }}>
        <div class="cat-img">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 200 }}" alt="{{ block.settings.title }}">
          {% else %}
            <!-- Default placeholder icon -->
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"></path></svg>
          {% endif %}
        </div>
        <span>{{ block.settings.title }}</span>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Organic Food Categories",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Category Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Vegetables" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Organic Food Categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Vegetables" } },
        { "type": "category", "settings": { "title": "Fruits" } },
        { "type": "category", "settings": { "title": "Dairy & Eggs" } },
        { "type": "category", "settings": { "title": "Bakery" } },
        { "type": "category", "settings": { "title": "Vegan" } }
      ]
    }
  ]
}
{% endschema %}
