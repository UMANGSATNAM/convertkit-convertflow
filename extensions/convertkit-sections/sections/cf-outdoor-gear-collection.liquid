{% schema %}
{
  "name": "CF Outdoor Gear Coll",
  "settings": [
    {
      "type": "header",
      "content": "Brand Colors"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent Color",
      "default": "#2A4B2A"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Background",
      "default": "#dbe8db"
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "checkbox",
      "id": "show_banner",
