{% comment %}ConvertFlow - Footwear Landing | SOLERA style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
.cfw *{box-sizing:border-box;margin:0;padding:0}
.cfw{font-family:'Inter',sans-serif;font-size:15px;color:#2A2018;background:#fff;-webkit-font-smoothing:antialiased}
.cfw h1,.cfw h2,.cfw h3{font-family:'Syne',sans-serif}
/* TOP BAR */
.cfw-top{background:#C65D2A;color:#fff;text-align:center;padding:10px;font-size:12px;font-weight:600;letter-spacing:2px;text-transform:uppercase}
/* HERO */
.cfw-hero{min-height:92vh;background:#F0E6D3;display:grid;grid-template-columns:1fr 1fr;overflow:hidden}
.cfw-hero-l{padding:100px 80px;display:flex;flex-direction:column;justify-content:center}
.cfw-overline{font-size:11px;font-weight:600;letter-spacing:4px;text-transform:uppercase;color:#C65D2A;margin-bottom:24px;display:block}
.cfw-hero-l h1{font-size:80px;line-height:1;font-weight:800;color:#1C1510;margin-bottom:28px}
.cfw-hero-l h1 em{font-style:italic;color:#C65D2A}
.cfw-hero-l p{font-size:17px;color:#8A7A6A;line-height:1.8;max-width:420px;margin-bottom:48px;font-weight:300}
.cfw-btns{display:flex;gap:16px}
.cfw-btn-rust{background:#C65D2A;color:#fff;padding:18px 44px;font-family:'Syne',sans-serif;font-size:13px;font-weight:700;letter-spacing:1px;text-decoration:none;display:inline-block;transition:opacity .2s}
.cfw-btn-rust:hover{opacity:.9}
.cfw-btn-ghost{background:transparent;color:#1C1510;border:1.5px solid #1C1510;padding:17px 44px;font-family:'Syne',sans-serif;font-size:13px;font-weight:700;letter-spacing:1px;text-decoration:none;display:inline-block;transition:all .2s}
.cfw-btn-ghost:hover{background:#1C1510;color:#fff}
.cfw-hero-r{background:#1C1510;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.cfw-hero-r::after{content:'';position:absolute;width:400px;height:400px;border-radius:50%;border:1px solid rgba(255,255,255,.05);top:50%;left:50%;transform:translate(-50%,-50%)}
.cfw-hero-r svg{width:60%;color:rgba(198,93,42,.3)}
/* FILTER TABS */
.cfw-tabs{display:flex;gap:4px;padding:24px 60px;border-bottom:1px solid #E0D4C0;background:#fafaf8}
.cfw-tab{padding:10px 24px;font-family:'Syne',sans-serif;font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;border:1.5px solid #E0D4C0;background:transparent;cursor:pointer;transition:all .2s;color:#8A7A6A}
.cfw-tab.active,.cfw-tab:hover{background:#1C1510;color:#fff;border-color:#1C1510}
/* PRODUCTS */
.cfw-shop{padding:80px 60px;max-width:1400px;margin:0 auto}
.cfw-shop-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:50px}
.cfw-shop-head h2{font-size:48px;font-weight:800;color:#1C1510}
.cfw-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px}
.cfw-card{position:relative;border:1px solid #E0D4C0;transition:all .35s;overflow:hidden}
.cfw-card:hover{box-shadow:0 16px 40px rgba(198,93,42,.08);transform:translateY(-4px)}
.cfw-card-img{aspect-ratio:1;background:#F0E6D3;display:flex;align-items:center;justify-content:center;position:relative}
.cfw-card-img svg{width:40%;color:#8A7A6A;opacity:.5;transition:transform .4s}
.cfw-card:hover .cfw-card-img svg{transform:scale(1.06);color:#C65D2A;opacity:.8}
.cfw-badge{position:absolute;top:18px;left:18px;background:#C65D2A;color:#fff;padding:5px 14px;font-family:'Syne',sans-serif;font-size:10px;font-weight:700;letter-spacing:1px}
.cfw-card-body{padding:24px}
.cfw-cat{font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:#C65D2A;margin-bottom:8px}
.cfw-cname{font-family:'Syne',sans-serif;font-size:20px;font-weight:700;margin-bottom:6px;color:#1C1510}
.cfw-cdesc{font-size:13px;color:#8A7A6A;margin-bottom:16px;line-height:1.6}
.cfw-sizes{display:flex;gap:6px;margin-bottom:18px;flex-wrap:wrap}
.cfw-sz{width:32px;height:32px;border:1px solid #E0D4C0;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;cursor:pointer;transition:all .2s}
.cfw-sz:hover{border-color:#C65D2A;color:#C65D2A}
.cfw-card-foot{display:flex;justify-content:space-between;align-items:center}
.cfw-price{font-family:'Syne',sans-serif;font-size:22px;font-weight:800;color:#1C1510}
.cfw-old{font-size:14px;color:#8A7A6A;text-decoration:line-through;margin-left:8px;font-weight:400}
.cfw-atc{background:#1C1510;color:#fff;border:none;padding:12px 24px;font-family:'Syne',sans-serif;font-size:11px;font-weight:700;letter-spacing:1px;cursor:pointer;transition:background .2s}
.cfw-atc:hover{background:#C65D2A}
/* SUSTAIN */
.cfw-sustain{background:#1C1510;padding:100px 60px;display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:center}
.cfw-s-overline{font-size:11px;font-weight:600;letter-spacing:4px;text-transform:uppercase;color:#C65D2A;margin-bottom:20px;display:block}
.cfw-s-text h2{font-size:52px;font-weight:800;color:#fff;margin-bottom:24px;line-height:1.1}
.cfw-s-text p{font-size:16px;color:rgba(255,255,255,.5);line-height:1.9;margin-bottom:36px}
.cfw-s-pillars{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.cfw-s-pillar{border:1px solid rgba(255,255,255,.1);padding:24px}
.cfw-s-pillar h4{font-family:'Syne',sans-serif;font-size:16px;color:#fff;margin-bottom:8px}
.cfw-s-pillar p{font-size:13px;color:rgba(255,255,255,.4)}
/* FOOTER */
.cfw-footer{background:#F0E6D3;padding:80px 60px 40px}
.cfw-fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;padding-bottom:60px;border-bottom:1px solid #E0D4C0}
.cfw-fb-name{font-family:'Syne',sans-serif;font-size:28px;font-weight:800;color:#1C1510;letter-spacing:4px;margin-bottom:16px}
.cfw-fb p{font-size:14px;color:#8A7A6A;line-height:1.8;max-width:260px}
.cfw-fc h4{font-family:'Syne',sans-serif;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#8A7A6A;margin-bottom:20px}
.cfw-fc ul{list-style:none}
.cfw-fc li{margin-bottom:10px}
.cfw-fc a{color:#2A2018;text-decoration:none;font-size:14px;transition:color .2s}
.cfw-fc a:hover{color:#C65D2A}
.cfw-fbot{display:flex;justify-content:space-between;padding-top:30px;font-size:12px;color:#8A7A6A}
@media(max-width:1024px){.cfw-hero{grid-template-columns:1fr;min-height:auto}.cfw-hero-r{display:none}.cfw-grid{grid-template-columns:repeat(2,1fr)}.cfw-sustain{grid-template-columns:1fr}.cfw-s-pillars{grid-template-columns:1fr}.cfw-fg{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cfw-hero-l{padding:60px 20px}.cfw-hero-l h1{font-size:52px}.cfw-shop{padding:60px 20px}.cfw-grid{grid-template-columns:1fr}.cfw-tabs{padding:16px 20px;overflow-x:auto}.cfw-fg{grid-template-columns:1fr;gap:40px}}
</style>

<div class="cfw">
  <div class="cfw-top">{{ section.settings.top_bar_text }}</div>

  <section class="cfw-hero">
    <div class="cfw-hero-l">
      <span class="cfw-overline">{{ section.settings.hero_overline }}</span>
      <h1>{{ section.settings.hero_heading_line1 }} <em>{{ section.settings.hero_heading_em }}</em></h1>
      <p>{{ section.settings.hero_subtext }}</p>
      <div class="cfw-btns">
        <a href="{{ section.settings.cta1_link }}" class="cfw-btn-rust">{{ section.settings.cta1_text }}</a>
        <a href="{{ section.settings.cta2_link }}" class="cfw-btn-ghost">{{ section.settings.cta2_text }}</a>
      </div>
    </div>
    <div class="cfw-hero-r">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width=".8"><path d="M21.5 15.5c-1.1 1.1-3.1 1.5-5.5 1.5H4a2 2 0 01-2-2v-1c0-.6.1-1.2.4-1.7L6 7.5V7a2 2 0 012-2h2.5L14 9l2-1.5 2.5 1 1.5 3.5-1 1.5 2.5 2z"/></svg>
    </div>
  </section>

  {% if section.settings.show_tabs %}
  <div class="cfw-tabs">
    {% for block in section.blocks %}
      {% if block.type == 'filter_tab' %}
      <button class="cfw-tab{% if forloop.first %} active{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
      {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  <section class="cfw-shop">
    <div class="cfw-shop-head"><h2>{{ section.settings.products_heading }}</h2></div>
    <div class="cfw-grid">
      {% for block in section.blocks %}
        {% if block.type == 'product' %}
        <div class="cfw-card" {{ block.shopify_attributes }}>
          <div class="cfw-card-img">
            {% if block.settings.badge != blank %}<span class="cfw-badge">{{ block.settings.badge }}</span>{% endif %}
            {% if block.settings.image %}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name }}" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0">{% else %}<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path d="M21.5 15.5c-1.1 1.1-3.1 1.5-5.5 1.5H4a2 2 0 01-2-2v-1c0-.6.1-1.2.4-1.7L6 7.5V7a2 2 0 012-2h2.5L14 9l2-1.5 2.5 1 1.5 3.5-1 1.5 2.5 2z"/></svg>{% endif %}
          </div>
          <div class="cfw-card-body">
            <div class="cfw-cat">{{ block.settings.category }}</div>
            <div class="cfw-cname">{{ block.settings.name }}</div>
            <div class="cfw-cdesc">{{ block.settings.description }}</div>
            {% if block.settings.sizes != blank %}
            <div class="cfw-sizes">
              {% assign size_arr = block.settings.sizes | split: ',' %}
              {% for sz in size_arr %}<div class="cfw-sz">{{ sz | strip }}</div>{% endfor %}
            </div>
            {% endif %}
            <div class="cfw-card-foot">
              <div><span class="cfw-price">{{ block.settings.price }}</span>{% if block.settings.old_price != blank %}<span class="cfw-old">{{ block.settings.old_price }}</span>{% endif %}</div>
              <button class="cfw-atc">Add to Cart</button>
            </div>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  {% if section.settings.show_sustain %}
  <div class="cfw-sustain">
    <div class="cfw-s-text">
      <span class="cfw-s-overline">{{ section.settings.sustain_overline }}</span>
      <h2>{{ section.settings.sustain_heading }}</h2>
      <p>{{ section.settings.sustain_text }}</p>
      <a href="{{ section.settings.sustain_link }}" class="cfw-btn-rust">{{ section.settings.sustain_cta }}</a>
    </div>
    <div class="cfw-s-pillars">
      {% for block in section.blocks %}
        {% if block.type == 'pillar' %}
        <div class="cfw-s-pillar" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.title }}</h4>
          <p>{{ block.settings.text }}</p>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <footer class="cfw-footer">
    <div class="cfw-fg">
      <div class="cfw-fb"><div class="cfw-fb-name">{{ section.settings.brand_name }}</div><p>{{ section.settings.brand_desc }}</p></div>
      <div class="cfw-fc"><h4>Shop</h4><ul><li><a href="#">Sneakers</a></li><li><a href="#">Formal</a></li><li><a href="#">Boots</a></li><li><a href="#">Sandals</a></li></ul></div>
      <div class="cfw-fc"><h4>About</h4><ul><li><a href="#">Our Story</a></li><li><a href="#">Sustainability</a></li><li><a href="#">Artisans</a></li></ul></div>
      <div class="cfw-fc"><h4>Help</h4><ul><li><a href="#">Size Chart</a></li><li><a href="#">Care Guide</a></li><li><a href="#">Returns</a></li><li><a href="#">Contact</a></li></ul></div>
    </div>
    <div class="cfw-fbot"><span>{{ section.settings.copyright }}</span><span>Privacy &middot; Terms</span></div>
  </footer>
</div>

{% schema %}
{
  "name": "CF Footwear",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "text", "id": "brand_name", "label": "Brand Name", "default": "SOLERA" },
    { "type": "textarea", "id": "brand_desc", "label": "Brand Description", "default": "Footwear designed for the discerning walker. Handcrafted in India with ethically sourced leathers." },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© 2025 Solera Footwear" },
    { "type": "header", "content": "Top Bar" },
    { "type": "text", "id": "top_bar_text", "label": "Top Bar Text", "default": "Free shipping on orders above ₹2,999 | Easy 30-day returns" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_overline", "label": "Hero Overline", "default": "SS 2025 — The Ground Collection" },
    { "type": "text", "id": "hero_heading_line1", "label": "Hero Heading", "default": "Walk with" },
    { "type": "text", "id": "hero_heading_em", "label": "Hero Heading Italic Word", "default": "Purpose" },
    { "type": "textarea", "id": "hero_subtext", "label": "Hero Subtext", "default": "Footwear built for the unscripted journey. Premium leather, handcrafted soles, and silhouettes that age beautifully." },
    { "type": "text", "id": "cta1_text", "label": "Primary CTA Text", "default": "Shop Collection" },
    { "type": "url", "id": "cta1_link", "label": "Primary CTA Link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary CTA Text", "default": "Find Your Size" },
    { "type": "url", "id": "cta2_link", "label": "Secondary CTA Link" },
    { "type": "header", "content": "Filter Tabs" },
    { "type": "checkbox", "id": "show_tabs", "label": "Show Filter Tabs", "default": true },
    { "type": "header", "content": "Products" },
    { "type": "text", "id": "products_heading", "label": "Products Heading", "default": "Our Collection" },
    { "type": "header", "content": "Sustainability Section" },
    { "type": "checkbox", "id": "show_sustain", "label": "Show Sustainability Section", "default": true },
    { "type": "text", "id": "sustain_overline", "label": "Section Overline", "default": "Our Commitment" },
    { "type": "text", "id": "sustain_heading", "label": "Section Heading", "default": "Crafted to Last, Not to Waste" },
    { "type": "textarea", "id": "sustain_text", "label": "Section Text", "default": "Every pair is built with materials that improve with age and processes that respect the planet." },
    { "type": "text", "id": "sustain_cta", "label": "CTA Text", "default": "Our Story" },
    { "type": "url", "id": "sustain_link", "label": "CTA Link" }
  ],
  "blocks": [
    {
      "type": "filter_tab",
      "name": "Filter Tab",
      "settings": [{ "type": "text", "id": "label", "label": "Tab Label", "default": "All" }]
    },
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product Image" },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "default": "Bestseller" },
        { "type": "text", "id": "category", "label": "Category", "default": "Sneakers" },
        { "type": "text", "id": "name", "label": "Product Name", "default": "Terra Runner Pro" },
        { "type": "text", "id": "description", "label": "Description", "default": "Full-grain leather upper with memory foam insole." },
        { "type": "text", "id": "sizes", "label": "Available Sizes (comma-separated)", "default": "6, 7, 8, 9, 10" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹7,499" },
        { "type": "text", "id": "old_price", "label": "Original Price (optional)", "default": "" }
      ]
    },
    {
      "type": "pillar",
      "name": "Sustainability Pillar",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Vegetable Tanned Leather" },
        { "type": "text", "id": "text", "label": "Text", "default": "Using traditional tanneries in Kanpur, free from heavy metals." }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF Footwear",
      "blocks": [
        { "type": "filter_tab", "settings": { "label": "All" } },
        { "type": "filter_tab", "settings": { "label": "Sneakers" } },
        { "type": "filter_tab", "settings": { "label": "Formal" } },
        { "type": "filter_tab", "settings": { "label": "Sandals" } },
        { "type": "filter_tab", "settings": { "label": "Boots" } },
        { "type": "product", "settings": { "badge": "Bestseller", "category": "Sneakers", "name": "Terra Runner Pro", "description": "Full-grain leather upper with memory foam insole.", "sizes": "6, 7, 8, 9, 10", "price": "₹7,499", "old_price": "" } },
        { "type": "product", "settings": { "badge": "New", "category": "Formal", "name": "Oxford Classic II", "description": "Italian leather brogue with Goodyear welted construction.", "sizes": "7, 8, 9, 10, 11", "price": "₹12,999", "old_price": "₹15,999" } },
        { "type": "product", "settings": { "badge": "", "category": "Boots", "name": "Canyon Chelsea Boot", "description": "Chelsea silhouette in burnished calfskin with elastic gussets.", "sizes": "7, 8, 9, 10", "price": "₹9,999", "old_price": "" } },
        { "type": "pillar", "settings": { "title": "Vegetable Tanned Leather", "text": "Using traditional tanneries in Kanpur, free from heavy metals." } },
        { "type": "pillar", "settings": { "title": "Recycled Packaging", "text": "100% recycled & FSC-certified shoe boxes and tissue paper." } },
        { "type": "pillar", "settings": { "title": "Resoleable Design", "text": "All formal range can be resoled, extending life by years." } },
        { "type": "pillar", "settings": { "title": "Fair Wages", "text": "Living wages guaranteed across our entire artisan network." } }
      ]
    }
  ]
}
{% endschema %}