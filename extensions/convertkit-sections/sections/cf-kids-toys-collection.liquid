{% comment %} ConvertFlow — Kids Toys Collection Page {% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Fredoka+One&family=Varela+Round&display=swap');
  .cf-kids-c*{box-sizing:border-box;margin:0;padding:0}
  .cf-kids-c{font-family:'Varela Round',sans-serif;background:#F0F8FF;color:#333;padding-bottom:80px}
  
  .cf-kids-c-head{background:{{ section.settings.color_blue | default: '#4D94FF' }};color:#fff;text-align:center;padding:80px 5% 120px;position:relative}
  .cf-kids-c-h1{font-family:'Fredoka One',cursive;font-size:clamp(40px,6vw,64px);margin-bottom:16px;text-shadow:3px 3px 0px rgba(0,0,0,.1)}
  .cf-kids-c-p{font-size:18px;max-width:600px;margin:0 auto;font-weight:600}
  
  .cf-kids-c-wave{position:absolute;bottom:0;left:0;width:100%;height:60px;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 1200 120' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V95.8C59.71,118.08,130.83,119.56,193,101.44Z' fill='%23F0F8FF'/%3E%3C/svg%3E");background-size:cover;background-position:center;z-index:3}

  .cf-kids-c-wrap{max-width:1400px;margin:-40px auto 0;padding:0 5%;position:relative;z-index:4}
  
  .cf-kids-c-filters{display:flex;gap:16px;margin-bottom:40px;flex-wrap:wrap}
  .cf-kids-c-filter{background:#fff;border-radius:30px;padding:12px 24px;font-family:'Fredoka One',cursive;font-size:16px;color:#333;text-decoration:none;box-shadow:0 6px 0px rgba(0,0,0,.05);transition:all .2s;border:4px solid transparent}
  .cf-kids-c-filter:hover,.cf-kids-c-filter.active{transform:translateY(4px);box-shadow:0 2px 0px rgba(0,0,0,.05);border-color:{{ section.settings.color_yellow | default: '#FFD11A' }}}
  
  .cf-kids-prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:30px}
  .cf-kids-card{background:#fff;border-radius:24px;padding:20px;text-decoration:none;color:#333;position:relative;border:4px solid transparent;transition:all .3s;box-shadow:0 10px 20px rgba(0,0,0,.04)}
  .cf-kids-card:hover{border-color:{{ section.settings.color_red | default: '#FF4D4D' }};transform:translateY(-8px)}
  .cf-kids-card-img{aspect-ratio:1;background:#F0F8FF;border-radius:16px;margin-bottom:20px;display:flex;align-items:center;justify-content:center;padding:16px}
  .cf-kids-card-img img{max-width:100%;max-height:100%;object-fit:contain}
  .cf-kids-card-title{font-family:'Fredoka One',cursive;font-size:20px;margin-bottom:8px;line-height:1.2}
  .cf-kids-card-price{font-size:24px;font-weight:700;color:{{ section.settings.color_red | default: '#FF4D4D' }}}

  @media(max-width:900px){
    .cf-kids-prod-grid{grid-template-columns:repeat(2,1fr)}
  }
{% endstyle %}

<div class="cf-kids-c">
  <div class="cf-kids-c-head">
    <h1 class="cf-kids-c-h1">{{ collection.title | default: 'All Awesome Toys!' }}</h1>
    <p class="cf-kids-c-p">{{ collection.description | strip_html | truncate: 120 | default: 'Find the perfect toy to make them smile today.' }}</p>
    <div class="cf-kids-c-wave"></div>
  </div>
  
  <div class="cf-kids-c-wrap">
    <div class="cf-kids-c-filters">
      <a href="#" class="cf-kids-c-filter active">All Toys</a>
      <a href="#" class="cf-kids-c-filter">Action Figures</a>
      <a href="#" class="cf-kids-c-filter">Educational</a>
      <a href="#" class="cf-kids-c-filter">Plushies</a>
      <a href="#" class="cf-kids-c-filter">Puzzles</a>
    </div>
    
    <div class="cf-kids-prod-grid">
      {% if collection.products.size > 0 %}
        {% for product in collection.products %}
          <a href="{{ product.url }}" class="cf-kids-card">
            <div class="cf-kids-card-img">
              {% if product.featured_image %}<img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}">{% endif %}
            </div>
            <div class="cf-kids-card-title">{{ product.title }}</div>
            <div class="cf-kids-card-price">{{ product.price | money }}</div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..8) %}
          <a href="#" class="cf-kids-card">
            <div class="cf-kids-card-img"><div style="font-size:60px">🧸</div></div>
            <div class="cf-kids-card-title">Awesome Toy {{ i }}</div>
            <div class="cf-kids-card-price">${{ i | times: 10 }}.99</div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CF Kids Toys Collection",
  "settings": [
    { "type": "color", "id": "color_red", "label": "Red", "default": "#FF4D4D" },
    { "type": "color", "id": "color_blue", "label": "Blue", "default": "#4D94FF" },
    { "type": "color", "id": "color_yellow", "label": "Yellow", "default": "#FFD11A" }
  ],
  "presets": [{ "name": "CF Kids Toys Collection" }]
}
{% endschema %}