{% comment %}ConvertFlow - Mobile Accessories Landing | TechCase style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
.cfma{--bg:#0A0A0A;--mid:#111;--neon:#00F0C8;--text:#E8E8E8;--mu:#888;--bd:#222;}
.cfma *{box-sizing:border-box;margin:0;padding:0;}
.cfma{background:var(--bg);color:var(--text);font-family:'Space Grotesk',sans-serif;-webkit-font-smoothing:antialiased;}
.cfma-hdr{padding:20px 60px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--bd);}
.cfma-brand{font-size:22px;font-weight:700;color:#fff;text-decoration:none;letter-spacing:2px;}
.cfma-brand span{color:var(--neon);}
.cfma-nav{display:flex;gap:28px;list-style:none;}
.cfma-nav a{font-size:13px;font-weight:500;color:var(--mu);text-decoration:none;transition:color .2s;}
.cfma-nav a:hover{color:var(--neon);}
.cfma-hbadge{background:var(--neon);color:#000;padding:10px 20px;font-size:12px;font-weight:700;text-decoration:none;transition:opacity .2s;}
.cfma-hbadge:hover{opacity:.85;}
.cfma-hero{min-height:90vh;display:grid;grid-template-columns:1fr 1fr;padding:0 60px;align-items:center;gap:60px;border-bottom:1px solid var(--bd);}
.cfma-htag{font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--neon);margin-bottom:20px;display:inline-flex;align-items:center;gap:10px;}
.cfma-htag::before{content:'';width:24px;height:1px;background:var(--neon);}
.cfma-hero h1{font-size:84px;font-weight:700;line-height:.95;margin-bottom:28px;color:#fff;}
.cfma-hero h1 span{color:var(--neon);}
.cfma-hero>div>p{font-size:16px;color:var(--mu);line-height:1.8;max-width:420px;margin-bottom:40px;}
.cfma-ctas{display:flex;gap:12px;}
.cfma-btn-neon{background:var(--neon);color:#000;padding:16px 36px;font-size:13px;font-weight:700;letter-spacing:1px;text-decoration:none;transition:opacity .2s;}
.cfma-btn-neon:hover{opacity:.85;}
.cfma-btn-ghost{background:transparent;color:var(--text);border:1px solid var(--bd);padding:15px 36px;font-size:13px;font-weight:600;text-decoration:none;transition:border-color .2s;}
.cfma-btn-ghost:hover{border-color:var(--neon);color:var(--neon);}
.cfma-hvisual{height:500px;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:12px;}
.cfma-hvc{border:1px solid var(--bd);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.cfma-hvc:first-child{grid-row:1/3;background:radial-gradient(circle at 30% 70%,rgba(0,240,200,.08),transparent 60%);}
.cfma-hvc svg{width:40%;color:var(--neon);opacity:.3;}
.cfma-hvc-lbl{position:absolute;bottom:16px;left:16px;font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--neon);}
.cfma-prods{padding:80px 60px;max-width:1400px;margin:0 auto;}
.cfma-ph{display:flex;justify-content:space-between;align-items:center;margin-bottom:48px;}
.cfma-ph h2{font-size:48px;font-weight:700;color:#fff;}
.cfma-ph a{font-size:12px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--neon);text-decoration:none;}
.cfma-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.cfma-card{background:var(--mid);border:1px solid var(--bd);transition:all .3s;overflow:hidden;}
.cfma-card:hover{border-color:var(--neon);transform:translateY(-4px);}
.cfma-card-img{aspect-ratio:1;display:flex;align-items:center;justify-content:center;position:relative;background:#0f0f0f;}
.cfma-card-img img{width:100%;height:100%;object-fit:cover;}
.cfma-card-img svg{width:40%;color:var(--neon);opacity:.25;}
.cfma-card-badge{position:absolute;top:12px;left:12px;background:var(--neon);color:#000;font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:4px 10px;}
.cfma-card-body{padding:20px;}
.cfma-card-cat{font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--neon);margin-bottom:6px;}
.cfma-card-name{font-size:15px;font-weight:600;color:#fff;margin-bottom:14px;line-height:1.4;}
.cfma-card-foot{display:flex;justify-content:space-between;align-items:center;}
.cfma-card-price{font-size:18px;font-weight:700;color:#fff;}
.cfma-card-old{font-size:12px;color:var(--mu);text-decoration:line-through;margin-left:6px;}
.cfma-atc{background:transparent;border:1px solid rgba(0,240,200,.3);color:var(--neon);padding:8px 16px;font-size:11px;font-weight:700;letter-spacing:1px;cursor:pointer;font-family:'Space Grotesk',sans-serif;transition:all .2s;}
.cfma-atc:hover{background:var(--neon);color:#000;}
.cfma-features{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--bd);}
.cfma-feat{padding:40px;border-right:1px solid var(--bd);}
.cfma-feat:last-child{border-right:none;}
.cfma-feat-icon{color:var(--neon);margin-bottom:16px;}
.cfma-feat-t{font-size:15px;font-weight:700;color:#fff;margin-bottom:8px;}
.cfma-feat-s{font-size:13px;color:var(--mu);line-height:1.7;}
.cfma-footer{background:var(--mid);border-top:1px solid var(--bd);padding:80px 60px 40px;}
.cfma-fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;padding-bottom:60px;border-bottom:1px solid var(--bd);}
.cfma-fb .cfma-brand{display:block;margin-bottom:16px;font-size:22px;}
.cfma-fb p{font-size:13px;color:var(--mu);line-height:1.9;max-width:260px;}
.cfma-fc h4{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--mu);margin-bottom:20px;}
.cfma-fc ul{list-style:none;}
.cfma-fc li{margin-bottom:10px;}
.cfma-fc a{color:var(--mu);text-decoration:none;font-size:13px;transition:color .2s;}
.cfma-fc a:hover{color:var(--neon);}
.cfma-fbot{display:flex;justify-content:space-between;padding-top:28px;font-size:11px;color:var(--mu);}
@media(max-width:1024px){.cfma-hero{grid-template-columns:1fr;min-height:auto}.cfma-hvisual{display:none}.cfma-grid{grid-template-columns:repeat(2,1fr)}.cfma-features{grid-template-columns:1fr 1fr}.cfma-fg{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cfma-hdr{padding:16px 20px}.cfma-nav{display:none}.cfma-hero{padding:60px 20px}.cfma-hero h1{font-size:52px}.cfma-prods{padding:60px 20px}.cfma-grid{grid-template-columns:1fr}.cfma-features{grid-template-columns:1fr}.cfma-feat{border-right:none;border-bottom:1px solid var(--bd)}.cfma-footer{padding:60px 20px 30px}.cfma-fg{grid-template-columns:1fr;gap:40px}}
</style>
<div class="cfma">
  <header class="cfma-hdr">
    <a href="{{ routes.root_url }}" class="cfma-brand">{{ section.settings.brand_name | default: 'TECH' }}<span>CASE</span></a>
    <ul class="cfma-nav"><li><a href="#">Cases</a></li><li><a href="#">Chargers</a></li><li><a href="#">Audio</a></li><li><a href="#">Bundles</a></li></ul>
    <a href="{{ routes.cart_url }}" class="cfma-hbadge">Cart ({{ cart.item_count }})</a>
  </header>
  <section class="cfma-hero">
    <div>
      <div class="cfma-htag">{{ section.settings.hero_tag | default: 'New Collection' }}</div>
      <h1>{{ section.settings.hero_h1 | default: 'Protect. <span>Power.</span> Play.' }}</h1>
      <p>{{ section.settings.hero_sub | default: 'Premium mobile accessories engineered for modern life. Military-grade protection meets refined aesthetic.' }}</p>
      <div class="cfma-ctas">
        <a href="{{ section.settings.cta1_url | default: routes.collections_url }}" class="cfma-btn-neon">{{ section.settings.cta1_text | default: 'Shop Now' }}</a>
        <a href="{{ section.settings.cta2_url | default: '#' }}" class="cfma-btn-ghost">{{ section.settings.cta2_text | default: 'View All' }}</a>
      </div>
    </div>
    <div class="cfma-hvisual">
      <div class="cfma-hvc"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg><span class="cfma-hvc-lbl">Cases</span></div>
      <div class="cfma-hvc"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path d="M5 18H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3.19M15 6h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-3.19"/><line x1="23" y1="13" x2="23" y2="11"/><polyline points="11 6 7 12 13 12 9 18"/></svg><span class="cfma-hvc-lbl">Chargers</span></div>
      <div class="cfma-hvc"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg><span class="cfma-hvc-lbl">Audio</span></div>
    </div>
  </section>
  <section class="cfma-prods">
    <div class="cfma-ph"><h2>Bestsellers</h2><a href="{{ routes.collections_url }}">View All &rarr;</a></div>
    <div class="cfma-grid">
      {% assign col = collections[section.settings.featured_collection] %}
      {% if col and col.products.size > 0 %}
        {% for p in col.products limit: 4 %}
          <div class="cfma-card">
            <div class="cfma-card-img">{% if p.featured_image %}<img src="{{ p.featured_image | img_url: '400x' }}" alt="{{ p.title }}">{% else %}<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><rect x="5" y="2" width="14" height="20" rx="2"/></svg>{% endif %}{% if p.compare_at_price > p.price %}<span class="cfma-card-badge">Sale</span>{% endif %}</div>
            <div class="cfma-card-body"><div class="cfma-card-cat">{{ p.type | default: 'Accessory' }}</div><div class="cfma-card-name">{{ p.title }}</div><div class="cfma-card-foot"><div class="cfma-card-price">{{ p.price | money }}{% if p.compare_at_price > p.price %}<span class="cfma-card-old">{{ p.compare_at_price | money }}</span>{% endif %}</div><button class="cfma-atc" data-variant-id="{{ p.variants.first.id }}">Add</button></div></div>
          </div>
        {% endfor %}
      {% else %}
        <div class="cfma-card"><div class="cfma-card-img"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><rect x="5" y="2" width="14" height="20" rx="2"/></svg><span class="cfma-card-badge">New</span></div><div class="cfma-card-body"><div class="cfma-card-cat">Phone Cases</div><div class="cfma-card-name">MagSafe Armor Case Pro</div><div class="cfma-card-foot"><div class="cfma-card-price">&#8377;1,299</div><button class="cfma-atc">Add</button></div></div></div>
        <div class="cfma-card"><div class="cfma-card-img"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path d="M5 18H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3.19M15 6h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-3.19"/></svg><span class="cfma-card-badge">Sale</span></div><div class="cfma-card-body"><div class="cfma-card-cat">Chargers</div><div class="cfma-card-name">65W GaN Fast Charger</div><div class="cfma-card-foot"><div class="cfma-card-price">&#8377;2,499<span class="cfma-card-old">&#8377;3,499</span></div><button class="cfma-atc">Add</button></div></div></div>
        <div class="cfma-card"><div class="cfma-card-img"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/></svg></div><div class="cfma-card-body"><div class="cfma-card-cat">Audio</div><div class="cfma-card-name">ActivePods X Pro — ANC Earbuds</div><div class="cfma-card-foot"><div class="cfma-card-price">&#8377;4,999<span class="cfma-card-old">&#8377;6,999</span></div><button class="cfma-atc">Add</button></div></div></div>
        <div class="cfma-card"><div class="cfma-card-img"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><circle cx="12" cy="12" r="4"/><line x1="1.05" y1="12" x2="7" y2="12"/><line x1="17.01" y1="12" x2="22.96" y2="12"/></svg><span class="cfma-card-badge">Hot</span></div><div class="cfma-card-body"><div class="cfma-card-cat">Wireless</div><div class="cfma-card-name">15W Magnetic Wireless Pad</div><div class="cfma-card-foot"><div class="cfma-card-price">&#8377;1,799</div><button class="cfma-atc">Add</button></div></div></div>
      {% endif %}
    </div>
  </section>
  <div class="cfma-features">
    <div class="cfma-feat"><div class="cfma-feat-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" width="28"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><div class="cfma-feat-t">Military Grade</div><div class="cfma-feat-s">MIL-STD-810G certified drop protection up to 3 meters.</div></div>
    <div class="cfma-feat"><div class="cfma-feat-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" width="28"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></div><div class="cfma-feat-t">Fast Charging</div><div class="cfma-feat-s">0 to 80% in 35 minutes with our 65W GaN technology.</div></div>
    <div class="cfma-feat"><div class="cfma-feat-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" width="28"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div><div class="cfma-feat-t">Free Delivery</div><div class="cfma-feat-s">Free shipping on all orders above &#8377;499 across India.</div></div>
    <div class="cfma-feat"><div class="cfma-feat-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" width="28"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg></div><div class="cfma-feat-t">Easy Returns</div><div class="cfma-feat-s">No-questions-asked 30-day return and replacement policy.</div></div>
  </div>
  <footer class="cfma-footer">
    <div class="cfma-fg">
      <div class="cfma-fb"><a href="{{ routes.root_url }}" class="cfma-brand">{{ section.settings.brand_name | default: 'TECH' }}<span>CASE</span></a><p>Premium mobile accessories for every device. Engineered to protect, power and connect.</p></div>
      <div class="cfma-fc"><h4>Products</h4><ul><li><a href="#">Phone Cases</a></li><li><a href="#">Chargers</a></li><li><a href="#">Earbuds</a></li><li><a href="#">Screen Guards</a></li></ul></div>
      <div class="cfma-fc"><h4>Company</h4><ul><li><a href="#">About Us</a></li><li><a href="#">Blog</a></li><li><a href="#">Careers</a></li></ul></div>
      <div class="cfma-fc"><h4>Support</h4><ul><li><a href="#">Track Order</a></li><li><a href="#">Returns</a></li><li><a href="#">Warranty</a></li><li><a href="#">Contact</a></li></ul></div>
    </div>
    <div class="cfma-fbot"><span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'TechCase' }}.</span><span>Privacy &middot; Terms</span></div>
  </footer>
</div>
{% schema %}
{
  "name": "Mobile Accessories Landing",
  "settings": [
    {"type":"text","id":"brand_name","label":"Brand Name","default":"TECHCASE"},
    {"type":"text","id":"hero_tag","label":"Hero Tag","default":"New Collection"},
    {"type":"textarea","id":"hero_h1","label":"Hero Heading","default":"Protect. Power. Play."},
    {"type":"textarea","id":"hero_sub","label":"Hero Subtext","default":"Premium mobile accessories engineered for modern life."},
    {"type":"text","id":"cta1_text","label":"CTA 1 Text","default":"Shop Now"},
    {"type":"url","id":"cta1_url","label":"CTA 1 URL"},
    {"type":"text","id":"cta2_text","label":"CTA 2 Text","default":"View All"},
    {"type":"url","id":"cta2_url","label":"CTA 2 URL"},
    {"type":"collection","id":"featured_collection","label":"Featured Collection"}
  ],
  "presets": [{"name":"Mobile Accessories Landing"}]
}
{% endschema %}