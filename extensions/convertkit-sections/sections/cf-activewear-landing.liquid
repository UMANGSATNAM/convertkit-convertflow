{% comment %} ConvertFlow — Activewear Landing | Always-Visible, No Blocks Required {% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Teko:wght@400;600;700&family=Inter:wght@400;600;800&display=swap');
  .cf-aw*{box-sizing:border-box;margin:0;padding:0}
  .cf-aw{font-family:'Inter',sans-serif;background:#050505;color:#fff;overflow-x:hidden}

  /* ═══ HERO ═══ */
  .cf-aw-hero{position:relative;min-height:92vh;display:flex;align-items:center;padding:0 6%}
  .cf-aw-hero-bg{position:absolute;inset:0}
  .cf-aw-hero-bg img{width:100%;height:100%;object-fit:cover;opacity:.55}
  .cf-aw-hero-bg::after{content:'';position:absolute;inset:0;background:linear-gradient(105deg,rgba(5,5,5,.96) 40%,rgba(5,5,5,.2) 100%)}
  .cf-aw-hero-inner{position:relative;z-index:2;max-width:740px}
  .cf-aw-tag{display:inline-block;background:#E2FE16;color:#000;font-family:'Teko',sans-serif;font-size:15px;font-weight:700;letter-spacing:3px;text-transform:uppercase;padding:4px 14px;margin-bottom:24px}
  .cf-aw-h1{font-family:'Teko',sans-serif;font-size:clamp(64px,10vw,130px);line-height:.95;text-transform:uppercase;color:#fff;margin-bottom:20px}
  .cf-aw-h1 em{font-style:normal;color:#E2FE16;display:block}
  .cf-aw-p{font-size:18px;color:#bbb;margin-bottom:40px;max-width:500px;line-height:1.6}
  .cf-aw-cta-row{display:flex;gap:16px;flex-wrap:wrap}
  .cf-aw-btn{display:inline-flex;align-items:center;gap:8px;padding:16px 36px;font-family:'Teko',sans-serif;font-size:20px;font-weight:700;letter-spacing:1px;text-transform:uppercase;text-decoration:none;cursor:pointer;border:none;clip-path:polygon(8px 0,100% 0,100% calc(100% - 8px),calc(100% - 8px) 100%,0 100%,0 8px);transition:all .3s}
  .cf-aw-btn-fill{background:#E2FE16;color:#000}
  .cf-aw-btn-fill:hover{transform:translateY(-4px);box-shadow:0 12px 30px rgba(226,254,22,.35)}
  .cf-aw-btn-ghost{background:transparent;color:#E2FE16;border:2px solid #E2FE16}
  .cf-aw-btn-ghost:hover{background:#E2FE16;color:#000}

  /* ═══ TICKER ═══ */
  .cf-aw-ticker{background:#E2FE16;overflow:hidden;padding:10px 0;white-space:nowrap}
  .cf-aw-ticker-track{display:inline-flex;animation:aw-ticker 28s linear infinite;gap:0}
  .cf-aw-ticker-track span{font-family:'Teko',sans-serif;font-size:18px;font-weight:700;color:#000;letter-spacing:2px;text-transform:uppercase;padding:0 40px}
  .cf-aw-ticker-track span::after{content:'//';margin-left:40px;color:rgba(0,0,0,.3)}
  @keyframes aw-ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  /* ═══ STATS ═══ */
  .cf-aw-stats{display:grid;grid-template-columns:repeat(4,1fr);background:#0F0F0F;border-top:1px solid #222;border-bottom:1px solid #222}
  .cf-aw-stat{padding:40px 24px;text-align:center;border-right:1px solid #222}
  .cf-aw-stat:last-child{border-right:none}
  .cf-aw-stat-num{font-family:'Teko',sans-serif;font-size:56px;font-weight:700;color:#E2FE16;line-height:1}
  .cf-aw-stat-label{font-size:13px;text-transform:uppercase;letter-spacing:2px;color:#666;margin-top:8px}

  /* ═══ PRODUCT CARDS ═══ */
  .cf-aw-products{padding:80px 6%}
  .cf-aw-products-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:50px}
  .cf-aw-products-head h2{font-family:'Teko',sans-serif;font-size:clamp(40px,5vw,60px);text-transform:uppercase;line-height:1}
  .cf-aw-products-head a{color:#E2FE16;font-size:13px;letter-spacing:2px;text-transform:uppercase;text-decoration:none;border-bottom:1px solid #E2FE16;padding-bottom:2px}
  .cf-aw-prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2px}
  
  /* Activewear card: dark, angular, badge-heavy */
  .cf-aw-card{position:relative;background:#111;overflow:hidden;text-decoration:none;color:#fff;display:block}
  .cf-aw-card-img{aspect-ratio:3/4;overflow:hidden;position:relative}
  .cf-aw-card-img img{width:100%;height:100%;object-fit:cover;transition:transform .7s ease}
  .cf-aw-card:hover .cf-aw-card-img img{transform:scale(1.08)}
  .cf-aw-card-badge{position:absolute;top:12px;left:0;background:#E2FE16;color:#000;font-family:'Teko',sans-serif;font-weight:700;font-size:14px;letter-spacing:1px;padding:4px 12px;text-transform:uppercase;z-index:2}
  .cf-aw-card-quick{position:absolute;bottom:0;left:0;right:0;background:#E2FE16;color:#000;font-family:'Teko',sans-serif;font-weight:700;font-size:18px;letter-spacing:2px;text-transform:uppercase;padding:12px;text-align:center;transform:translateY(100%);transition:transform .3s ease;z-index:3}
  .cf-aw-card:hover .cf-aw-card-quick{transform:translateY(0)}
  .cf-aw-card-info{padding:16px}
  .cf-aw-card-title{font-family:'Teko',sans-serif;font-size:22px;font-weight:600;text-transform:uppercase;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .cf-aw-card-price{font-size:16px;color:#E2FE16;font-weight:700}

  /* ═══ FEATURES ═══ */
  .cf-aw-features{background:#0F0F0F;padding:80px 6%}
  .cf-aw-features-grid{display:grid;grid-template-columns:1fr 1fr;gap:4px;max-width:1400px;margin:80px auto 0}
  .cf-aw-feat{position:relative;overflow:hidden;aspect-ratio:16/9}
  .cf-aw-feat:first-child{grid-column:span 2;aspect-ratio:21/9}
  .cf-aw-feat img{width:100%;height:100%;object-fit:cover;transition:transform .8s;opacity:.7}
  .cf-aw-feat:hover img{transform:scale(1.04)}
  .cf-aw-feat::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.9),transparent 50%)}
  .cf-aw-feat-text{position:absolute;bottom:30px;left:30px;z-index:2}
  .cf-aw-feat-cat{font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#E2FE16;margin-bottom:8px}
  .cf-aw-feat-title{font-family:'Teko',sans-serif;font-size:36px;font-weight:700;text-transform:uppercase}

  /* ═══ SECTION HEAD ═══ */
  .cf-aw-section-head{text-align:center;max-width:700px;margin:0 auto}
  .cf-aw-section-head .sub{font-size:13px;letter-spacing:3px;text-transform:uppercase;color:#E2FE16;margin-bottom:12px}
  .cf-aw-section-head h2{font-family:'Teko',sans-serif;font-size:clamp(40px,5vw,64px);text-transform:uppercase}

  /* ═══ CTA BANNER ═══ */
  .cf-aw-cta-banner{background:#E2FE16;padding:80px 6%;text-align:center}
  .cf-aw-cta-banner h2{font-family:'Teko',sans-serif;font-size:clamp(48px,7vw,90px);font-weight:700;text-transform:uppercase;color:#000;line-height:1;margin-bottom:30px}
  .cf-aw-cta-banner p{font-size:18px;color:#333;margin-bottom:40px;max-width:600px;margin-left:auto;margin-right:auto}
  .cf-aw-cta-banner .cf-aw-btn-fill{background:#000;color:#E2FE16}

  @media(max-width:900px){
    .cf-aw-stats{grid-template-columns:repeat(2,1fr)}
    .cf-aw-prod-grid{grid-template-columns:repeat(2,1fr)}
    .cf-aw-features-grid{grid-template-columns:1fr}
    .cf-aw-feat:first-child{grid-column:span 1;aspect-ratio:16/9}
    .cf-aw-products-head{flex-direction:column;gap:20px;align-items:flex-start}
  }
{% endstyle %}

<div class="cf-aw">

  {%- comment -%} HERO {%- endcomment -%}
  <section class="cf-aw-hero">
    <div class="cf-aw-hero-bg">
      {% if section.settings.hero_image != blank %}
        <img src="{{ section.settings.hero_image | img_url: 'master' }}" alt="Activewear Hero">
      {% else %}
        <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1600&auto=format&fit=crop" alt="Activewear">
      {% endif %}
    </div>
    <div class="cf-aw-hero-inner">
      <div class="cf-aw-tag">{{ section.settings.hero_tag | default: 'New Season Drop' }}</div>
      <h1 class="cf-aw-h1">
        {{ section.settings.hero_headline | default: 'Built For' }}
        <em>{{ section.settings.hero_subline | default: 'Champions' }}</em>
      </h1>
      <p class="cf-aw-p">{{ section.settings.hero_text | default: 'Performance gear engineered to push every limit. Train harder, move faster, recover smarter.' }}</p>
      <div class="cf-aw-cta-row">
        <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="cf-aw-btn cf-aw-btn-fill">{{ section.settings.btn1_text | default: 'Shop Collection' }}</a>
        <a href="{{ section.settings.btn2_url | default: '/pages/lookbook' }}" class="cf-aw-btn cf-aw-btn-ghost">{{ section.settings.btn2_text | default: 'View Lookbook' }}</a>
      </div>
    </div>
  </section>

  {%- comment -%} TICKER {%- endcomment -%}
  <div class="cf-aw-ticker">
    <div class="cf-aw-ticker-track">
      {% assign t = 'Free Shipping on Orders Over ₹999 // New Drop: AeroFlex Pro // 30-Day Returns // Athlete-Tested Gear // Free Shipping on Orders Over ₹999 // New Drop: AeroFlex Pro // 30-Day Returns // Athlete-Tested Gear //' %}
      {% assign tparts = t | split: '//' %}
      {% for i in (1..2) %}{% for part in tparts %}<span>{{ part | strip }}</span>{% endfor %}{% endfor %}
    </div>
  </div>

  {%- comment -%} STATS {%- endcomment -%}
  <div class="cf-aw-stats">
    <div class="cf-aw-stat"><div class="cf-aw-stat-num">2M+</div><div class="cf-aw-stat-label">Athletes Trust Us</div></div>
    <div class="cf-aw-stat"><div class="cf-aw-stat-num">150+</div><div class="cf-aw-stat-label">Performance Styles</div></div>
    <div class="cf-aw-stat"><div class="cf-aw-stat-num">48h</div><div class="cf-aw-stat-label">Fast Dispatch</div></div>
    <div class="cf-aw-stat"><div class="cf-aw-stat-num">4.9★</div><div class="cf-aw-stat-label">Avg. Rating</div></div>
  </div>

  {%- comment -%} PRODUCTS {%- endcomment -%}
  <section class="cf-aw-products">
    <div class="cf-aw-products-head">
      <h2>{{ section.settings.prods_heading | default: 'Top Performers' }}</h2>
      <a href="{{ section.settings.prods_link | default: '/collections/all' }}">View All →</a>
    </div>
    <div class="cf-aw-prod-grid">
      {% assign coll = section.settings.featured_collection %}
      {% if coll != blank and coll.products_count > 0 %}
        {% for p in coll.products limit: 4 %}
          <a href="{{ p.url }}" class="cf-aw-card">
            <div class="cf-aw-card-img">
              {% if p.featured_image %}<img src="{{ p.featured_image | img_url: '600x' }}" alt="{{ p.title }}">{% endif %}
              {% if p.compare_at_price > p.price %}<span class="cf-aw-card-badge">Sale</span>{% endif %}
              <div class="cf-aw-card-quick">Quick Add +</div>
            </div>
            <div class="cf-aw-card-info">
              <div class="cf-aw-card-title">{{ p.title }}</div>
              <div class="cf-aw-card-price">{{ p.price | money }}</div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% assign demo = 'AeroFlex Training Tee,ProGrid Shorts,Compression Leggings,Elite Performance Jacket' | split: ',' %}
        {% for name in demo %}
          <a href="/collections/all" class="cf-aw-card">
            <div class="cf-aw-card-img">
              <div style="width:100%;height:100%;background:linear-gradient(135deg,#111 0%,#1a1a1a 100%)"></div>
              {% if forloop.first %}<span class="cf-aw-card-badge">Bestseller</span>{% endif %}
              <div class="cf-aw-card-quick">Quick Add +</div>
            </div>
            <div class="cf-aw-card-info">
              <div class="cf-aw-card-title">{{ name }}</div>
              <div class="cf-aw-card-price">₹{{ forloop.index | times: 599 | plus: 1999 }}</div>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </section>

  {%- comment -%} FEATURES GRID {%- endcomment -%}
  <section class="cf-aw-features">
    <div class="cf-aw-section-head">
      <div class="sub">Collections</div>
      <h2>{{ section.settings.feat_heading | default: 'Train Every Discipline' }}</h2>
    </div>
    <div class="cf-aw-features-grid">
      <div class="cf-aw-feat">
        {% if section.settings.feat_img1 != blank %}
          <img src="{{ section.settings.feat_img1 | img_url: 'master' }}" alt="">
        {% else %}
          <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=1200&auto=format&fit=crop" alt="">
        {% endif %}
        <div class="cf-aw-feat-text"><div class="cf-aw-feat-cat">Running</div><div class="cf-aw-feat-title">Speed & Endurance Gear</div></div>
      </div>
      <div class="cf-aw-feat">
        {% if section.settings.feat_img2 != blank %}
          <img src="{{ section.settings.feat_img2 | img_url: 'master' }}" alt="">
        {% else %}
          <img src="https://images.unsplash.com/photo-1583454110551-21f2fa2afe61?w=800&auto=format&fit=crop" alt="">
        {% endif %}
        <div class="cf-aw-feat-text"><div class="cf-aw-feat-cat">Strength</div><div class="cf-aw-feat-title">Gym & Lifting</div></div>
      </div>
      <div class="cf-aw-feat">
        {% if section.settings.feat_img3 != blank %}
          <img src="{{ section.settings.feat_img3 | img_url: 'master' }}" alt="">
        {% else %}
          <img src="https://images.unsplash.com/photo-1518611012118-696072aa579a?w=800&auto=format&fit=crop" alt="">
        {% endif %}
        <div class="cf-aw-feat-text"><div class="cf-aw-feat-cat">Yoga</div><div class="cf-aw-feat-title">Flow & Flexibility</div></div>
      </div>
    </div>
  </section>

  {%- comment -%} CTA BANNER {%- endcomment -%}
  <section class="cf-aw-cta-banner">
    <h2>{{ section.settings.cta_heading | default: 'Your Best Performance Starts Here' }}</h2>
    <p>{{ section.settings.cta_text | default: 'Join 2 million athletes who trust our gear for every training session.' }}</p>
    <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="cf-aw-btn cf-aw-btn-fill">{{ section.settings.cta_btn | default: 'Shop Now' }}</a>
  </section>

</div>

{% schema %}
{
  "name": "CF Activewear Landing",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero Background Image" },
    { "type": "text", "id": "hero_tag", "label": "Badge Text", "default": "New Season Drop" },
    { "type": "text", "id": "hero_headline", "label": "Headline Line 1", "default": "Built For" },
    { "type": "text", "id": "hero_subline", "label": "Headline Line 2 (Accent)", "default": "Champions" },
    { "type": "textarea", "id": "hero_text", "label": "Hero Paragraph", "default": "Performance gear engineered to push every limit." },
    { "type": "text", "id": "btn1_text", "label": "Button 1 Text", "default": "Shop Collection" },
    { "type": "url", "id": "btn1_url", "label": "Button 1 Link" },
    { "type": "text", "id": "btn2_text", "label": "Button 2 Text", "default": "View Lookbook" },
    { "type": "url", "id": "btn2_url", "label": "Button 2 Link" },
    { "type": "header", "content": "Products" },
    { "type": "text", "id": "prods_heading", "label": "Products Heading", "default": "Top Performers" },
    { "type": "url", "id": "prods_link", "label": "View All Link" },
    { "type": "collection", "id": "featured_collection", "label": "Featured Collection" },
    { "type": "header", "content": "Features Grid" },
    { "type": "text", "id": "feat_heading", "label": "Features Heading", "default": "Train Every Discipline" },
    { "type": "image_picker", "id": "feat_img1", "label": "Feature Image 1" },
    { "type": "image_picker", "id": "feat_img2", "label": "Feature Image 2" },
    { "type": "image_picker", "id": "feat_img3", "label": "Feature Image 3" },
    { "type": "header", "content": "CTA Banner" },
    { "type": "text", "id": "cta_heading", "label": "CTA Heading", "default": "Your Best Performance Starts Here" },
    { "type": "textarea", "id": "cta_text", "label": "CTA Text", "default": "Join 2 million athletes who trust our gear." },
    { "type": "text", "id": "cta_btn", "label": "CTA Button Text", "default": "Shop Now" },
    { "type": "url", "id": "cta_url", "label": "CTA Button Link" }
  ],
  "presets": [{ "name": "CF Activewear Landing" }]
}
{% endschema %}
