{% comment %}ConvertFlow - Activewear Landing | BloomFit style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
.cfaw{--iv:#FDF8F2;--dk:#1E1E1E;--tc:#D4734A;--bl:#F5D5C8;--sg:#8FA68B;--gy:#7A7A7A;--bd:#ECDDD4;--lb:#FAF3EC;}
.cfaw *{box-sizing:border-box;margin:0;padding:0;}
.cfaw{background:var(--iv);color:var(--dk);font-family:'Outfit',sans-serif;font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;}
.cfaw h1,.cfaw h2,.cfaw h3{font-family:'Playfair Display',serif;}
.cfaw-promo{background:var(--tc);color:#fff;overflow:hidden;padding:10px 0;}
.cfaw-promo-inner{display:flex;gap:0;animation:cfaw-slide 18s linear infinite;white-space:nowrap;}
@keyframes cfaw-slide{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.cfaw-promo-item{padding:0 60px;font-size:13px;font-weight:500;letter-spacing:.06em;}
.cfaw-nav{background:var(--iv);border-bottom:1px solid var(--bd);padding:16px 60px;display:flex;align-items:center;justify-content:space-between;}
.cfaw-logo{font-family:'Playfair Display',serif;font-size:24px;font-weight:700;color:var(--dk);text-decoration:none;}
.cfaw-logo span{color:var(--tc);}
.cfaw-nav-links{display:flex;gap:28px;list-style:none;}
.cfaw-nav-links a{color:var(--dk);text-decoration:none;font-size:14px;font-weight:400;opacity:.65;transition:opacity .2s;}
.cfaw-nav-links a:hover{opacity:1;}
.cfaw-nav-right{display:flex;align-items:center;gap:14px;}
.cfaw-nav-right a{color:var(--dk);text-decoration:none;font-size:13px;opacity:.65;transition:opacity .2s;}
.cfaw-nav-right a:hover{opacity:1;}
.cfaw-hero{background:linear-gradient(135deg,var(--iv) 60%,var(--bl) 100%);display:grid;grid-template-columns:1fr 1fr;min-height:90vh;padding:0 60px;align-items:center;gap:80px;border-bottom:1px solid var(--bd);}
.cfaw-h-tag{display:inline-flex;align-items:center;gap:8px;background:var(--bl);color:var(--tc);padding:6px 18px;border-radius:100px;font-size:12px;font-weight:600;letter-spacing:.5px;margin-bottom:20px;}
.cfaw-hero h1{font-size:clamp(52px,5vw,72px);line-height:1.1;color:var(--dk);margin-bottom:24px;}
.cfaw-hero h1 em{font-style:italic;color:var(--tc);}
.cfaw-hero>div>p{font-size:17px;color:var(--gy);line-height:1.8;max-width:440px;margin-bottom:40px;font-weight:300;}
.cfaw-btns{display:flex;gap:14px;flex-wrap:wrap;}
.cfaw-btn-tc{background:var(--tc);color:#fff;padding:16px 40px;border-radius:4px;font-size:14px;font-weight:600;text-decoration:none;transition:background .2s;}
.cfaw-btn-tc:hover{background:#b5613b;}
.cfaw-btn-out{background:transparent;color:var(--dk);border:1.5px solid var(--bd);padding:15px 40px;border-radius:4px;font-size:14px;font-weight:600;text-decoration:none;transition:border-color .2s;}
.cfaw-btn-out:hover{border-color:var(--tc);color:var(--tc);}
.cfaw-usp-tags{display:flex;gap:10px;flex-wrap:wrap;margin-top:36px;}
.cfaw-utag{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--gy);font-weight:500;}
.cfaw-utag::before{content:'✓';color:var(--sg);font-weight:700;}
.cfaw-hero-vis{display:flex;align-items:center;justify-content:center;position:relative;}
.cfaw-vis-main{width:440px;height:540px;background:linear-gradient(135deg,var(--bl),#e8c4b0);border-radius:220px 220px 160px 160px;display:flex;align-items:center;justify-content:center;position:relative;}
.cfaw-vis-main svg{width:45%;color:var(--tc);opacity:.25;}
.cfaw-vis-badge{position:absolute;bottom:-20px;right:-20px;background:var(--tc);color:#fff;padding:20px 24px;border-radius:4px;text-align:center;}
.cfaw-vis-badge strong{font-family:'Playfair Display',serif;font-size:28px;font-weight:700;display:block;}
.cfaw-vis-badge span{font-size:10px;letter-spacing:2px;text-transform:uppercase;opacity:.75;display:block;margin-top:2px;}
.cfaw-cats{padding:80px 60px;max-width:1400px;margin:0 auto;}
.cfaw-sh{text-align:center;margin-bottom:50px;}
.cfaw-sh h2{font-size:44px;margin-bottom:12px;}
.cfaw-sh p{font-size:16px;color:var(--gy);max-width:480px;margin:0 auto;}
.cfaw-cat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.cfaw-cat{background:var(--lb);border:1px solid var(--bd);border-radius:12px;padding:28px 20px;text-align:center;text-decoration:none;color:var(--dk);transition:all .3s;}
.cfaw-cat:hover{border-color:var(--tc);transform:translateY(-4px);}
.cfaw-cat-emoji{font-size:36px;display:block;margin-bottom:12px;}
.cfaw-cat-name{font-family:'Playfair Display',serif;font-size:18px;font-weight:600;margin-bottom:4px;}
.cfaw-cat-count{font-size:12px;color:var(--gy);}
.cfaw-prods{padding:0 60px 80px;max-width:1400px;margin:0 auto;}
.cfaw-ph{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:40px;}
.cfaw-ph h2{font-size:40px;}
.cfaw-ph a{font-size:13px;font-weight:600;color:var(--tc);text-decoration:none;border-bottom:1px solid var(--tc);padding-bottom:2px;}
.cfaw-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;}
.cfaw-card{background:var(--iv);border:1px solid var(--bd);border-radius:8px;overflow:hidden;transition:all .3s;}
.cfaw-card:hover{box-shadow:0 16px 48px rgba(212,115,74,.12);transform:translateY(-4px);}
.cfaw-card-img{aspect-ratio:3/4;background:linear-gradient(135deg,var(--lb),var(--bl));display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.cfaw-card-img img{width:100%;height:100%;object-fit:cover;}
.cfaw-card-img svg{width:30%;color:var(--tc);opacity:.2;}
.cfaw-card-badge{position:absolute;top:12px;left:12px;background:var(--tc);color:#fff;font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase;padding:5px 12px;border-radius:2px;}
.cfaw-card-body{padding:24px;}
.cfaw-card-cat{font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--sg);margin-bottom:6px;}
.cfaw-card-name{font-family:'Playfair Display',serif;font-size:20px;margin-bottom:6px;color:var(--dk);}
.cfaw-card-sub{font-size:13px;color:var(--gy);margin-bottom:18px;}
.cfaw-card-foot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--bd);padding-top:18px;}
.cfaw-card-price{font-family:'Playfair Display',serif;font-size:22px;font-weight:600;}
.cfaw-card-old{font-size:14px;color:var(--gy);text-decoration:line-through;margin-left:8px;}
.cfaw-atc{background:var(--tc);color:#fff;border:none;padding:11px 24px;border-radius:4px;font-size:12px;font-weight:600;cursor:pointer;font-family:'Outfit',sans-serif;letter-spacing:.5px;transition:background .2s;}
.cfaw-atc:hover{background:#b5613b;}
.cfaw-features{background:var(--lb);padding:80px 60px;border-top:1px solid var(--bd);}
.cfaw-feat-inner{max-width:1400px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:48px;}
.cfaw-feat{text-align:center;}
.cfaw-feat-icon{font-size:40px;margin-bottom:16px;display:block;}
.cfaw-feat h3{font-size:20px;margin-bottom:10px;}
.cfaw-feat p{font-size:14px;color:var(--gy);line-height:1.8;}
.cfaw-footer{padding:80px 60px 40px;border-top:1px solid var(--bd);}
.cfaw-fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;padding-bottom:60px;border-bottom:1px solid var(--bd);}
.cfaw-fb h3{font-family:'Playfair Display',serif;font-size:24px;color:var(--tc);margin-bottom:16px;}
.cfaw-fb p{font-size:13px;color:var(--gy);line-height:1.9;max-width:260px;}
.cfaw-fc h4{font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--gy);margin-bottom:20px;}
.cfaw-fc ul{list-style:none;}
.cfaw-fc li{margin-bottom:10px;}
.cfaw-fc a{color:var(--dk);text-decoration:none;font-size:14px;opacity:.65;transition:opacity .2s;}
.cfaw-fc a:hover{opacity:1;color:var(--tc);}
.cfaw-fbot{display:flex;justify-content:space-between;padding-top:28px;font-size:11px;color:var(--gy);}
@media(max-width:1024px){.cfaw-hero{grid-template-columns:1fr;min-height:auto}.cfaw-hero-vis{display:none}.cfaw-cat-grid{grid-template-columns:repeat(2,1fr)}.cfaw-grid{grid-template-columns:repeat(2,1fr)}.cfaw-feat-inner{grid-template-columns:1fr}.cfaw-fg{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cfaw-nav{padding:16px 20px}.cfaw-nav-links{display:none}.cfaw-hero{padding:60px 20px}.cfaw-hero h1{font-size:44px}.cfaw-cats,.cfaw-prods{padding:60px 20px}.cfaw-grid{grid-template-columns:1fr}.cfaw-features{padding:60px 20px}.cfaw-fg{grid-template-columns:1fr;gap:40px}.cfaw-footer{padding:60px 20px 30px}}
</style>
<div class="cfaw">
  <div class="cfaw-promo"><div class="cfaw-promo-inner">{% assign p_items = 'Free shipping on orders above ₹799 · New drops every Monday · Sustainable fabrics · 30-day free returns · Free shipping on orders above ₹799 · New drops every Monday · Sustainable fabrics · 30-day free returns' | split: ' · ' %}{% for pi in p_items %}<span class="cfaw-promo-item">{{ pi }} &nbsp;·</span>{% endfor %}</div></div>
  <nav class="cfaw-nav">
    <a href="{{ routes.root_url }}" class="cfaw-logo">{{ section.settings.brand_name | default: 'Bloom' }}<span>Fit</span></a>
    <ul class="cfaw-nav-links"><li><a href="#">New In</a></li><li><a href="#">Leggings</a></li><li><a href="#">Sports Bras</a></li><li><a href="#">Sets</a></li><li><a href="#">Sale</a></li></ul>
    <div class="cfaw-nav-right"><a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a></div>
  </nav>
  <section class="cfaw-hero">
    <div>
      <div class="cfaw-h-tag">🌸 {{ section.settings.hero_tag | default: 'New SS25 Collection' }}</div>
      <h1>{{ section.settings.hero_h1 | default: 'Move With <em>Grace.</em> Train With Fire.' }}</h1>
      <p>{{ section.settings.hero_sub | default: 'Activewear designed for the modern woman. High-performance fabrics that move with you — from yoga mat to street.' }}</p>
      <div class="cfaw-btns">
        <a href="{{ section.settings.cta1_url | default: routes.collections_url }}" class="cfaw-btn-tc">{{ section.settings.cta1_text | default: 'Shop New In' }}</a>
        <a href="{{ section.settings.cta2_url | default: '#' }}" class="cfaw-btn-out">{{ section.settings.cta2_text | default: 'View Collections' }}</a>
      </div>
      <div class="cfaw-usp-tags"><span class="cfaw-utag">Squat-proof fabrics</span><span class="cfaw-utag">4-way stretch</span><span class="cfaw-utag">Moisture-wicking</span><span class="cfaw-utag">Sustainable</span></div>
    </div>
    <div class="cfaw-hero-vis">
      <div class="cfaw-vis-main"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.8"><path d="M12 2a10 10 0 0 1 10 10"/></svg></div>
      <div class="cfaw-vis-badge"><strong>4.9★</strong><span>20K+ Reviews</span></div>
    </div>
  </section>
  <section class="cfaw-cats">
    <div class="cfaw-sh"><h2>Shop the Edit</h2><p>Curated activewear for every type of movement.</p></div>
    <div class="cfaw-cat-grid">
      <a href="#" class="cfaw-cat"><span class="cfaw-cat-emoji">🧘</span><div class="cfaw-cat-name">Yoga &amp; Pilates</div><div class="cfaw-cat-count">80+ styles</div></a>
      <a href="#" class="cfaw-cat"><span class="cfaw-cat-emoji">🏃</span><div class="cfaw-cat-name">Running</div><div class="cfaw-cat-count">60+ styles</div></a>
      <a href="#" class="cfaw-cat"><span class="cfaw-cat-emoji">💪</span><div class="cfaw-cat-name">Training</div><div class="cfaw-cat-count">70+ styles</div></a>
      <a href="#" class="cfaw-cat"><span class="cfaw-cat-emoji">🌊</span><div class="cfaw-cat-name">Swim &amp; Lounge</div><div class="cfaw-cat-count">40+ styles</div></a>
    </div>
  </section>
  <section class="cfaw-prods">
    <div class="cfaw-ph"><h2>New Arrivals</h2><a href="{{ routes.collections_url }}">View All</a></div>
    <div class="cfaw-grid">
      {% assign col = collections[section.settings.featured_collection] %}
      {% if col and col.products.size > 0 %}
        {% for p in col.products limit: 3 %}
          <div class="cfaw-card">
            <div class="cfaw-card-img">{% if p.featured_image %}<img src="{{ p.featured_image | img_url: '600x' }}" alt="{{ p.title }}">{% else %}<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.8"><path d="M12 2a10 10 0 0 1 10 10"/></svg>{% endif %}{% if p.compare_at_price > p.price %}<span class="cfaw-card-badge">Sale</span>{% endif %}</div>
            <div class="cfaw-card-body"><div class="cfaw-card-cat">{{ p.type | default: 'Activewear' }}</div><div class="cfaw-card-name">{{ p.title }}</div><div class="cfaw-card-sub">{{ p.metafields.custom.fabric | default: 'High-Stretch · Moisture-Wicking' }}</div><div class="cfaw-card-foot"><div class="cfaw-card-price">{{ p.price | money }}{% if p.compare_at_price > p.price %}<span class="cfaw-card-old">{{ p.compare_at_price | money }}</span>{% endif %}</div><button class="cfaw-atc" data-variant-id="{{ p.variants.first.id }}">Add to Cart</button></div></div>
          </div>
        {% endfor %}
      {% else %}
        <div class="cfaw-card"><div class="cfaw-card-img"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.8"><path d="M12 2a10 10 0 0 1 10 10"/></svg><span class="cfaw-card-badge">New In</span></div><div class="cfaw-card-body"><div class="cfaw-card-cat">Leggings</div><div class="cfaw-card-name">Sunrise High-Waist Legging</div><div class="cfaw-card-sub">Squat-Proof · 4-Way Stretch</div><div class="cfaw-card-foot"><div class="cfaw-card-price">&#8377;1,999<span class="cfaw-card-old">&#8377;2,499</span></div><button class="cfaw-atc">Add to Cart</button></div></div></div>
        <div class="cfaw-card"><div class="cfaw-card-img"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.8"><path d="M12 2a10 10 0 0 1 10 10"/></svg></div><div class="cfaw-card-body"><div class="cfaw-card-cat">Sports Bras</div><div class="cfaw-card-name">Flow Medium-Support Sports Bra</div><div class="cfaw-card-sub">Moisture-Wicking · Removable Pads</div><div class="cfaw-card-foot"><div class="cfaw-card-price">&#8377;1,499</div><button class="cfaw-atc">Add to Cart</button></div></div></div>
        <div class="cfaw-card"><div class="cfaw-card-img"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.8"><path d="M12 2a10 10 0 0 1 10 10"/></svg><span class="cfaw-card-badge">Bundle</span></div><div class="cfaw-card-body"><div class="cfaw-card-cat">Co-ord Set</div><div class="cfaw-card-name">Bloom Studio Set — Terracotta</div><div class="cfaw-card-sub">Legging + Bra · Save 20%</div><div class="cfaw-card-foot"><div class="cfaw-card-price">&#8377;2,999<span class="cfaw-card-old">&#8377;3,799</span></div><button class="cfaw-atc">Add to Cart</button></div></div></div>
      {% endif %}
    </div>
  </section>
  <section class="cfaw-features">
    <div class="cfaw-feat-inner">
      <div class="cfaw-feat"><span class="cfaw-feat-icon">♻️</span><h3>Sustainably Made</h3><p>Crafted from recycled materials and sustainable fabrics. Good for you, better for the planet.</p></div>
      <div class="cfaw-feat"><span class="cfaw-feat-icon">💧</span><h3>High-Performance Fabric</h3><p>4-way stretch, moisture-wicking, and squat-proof technology for peak performance in every session.</p></div>
      <div class="cfaw-feat"><span class="cfaw-feat-icon">📦</span><h3>Free Returns</h3><p>Not the right fit? Return or exchange for free within 30 days. No questions asked.</p></div>
    </div>
  </section>
  <footer class="cfaw-footer">
    <div class="cfaw-fg">
      <div class="cfaw-fb"><h3>{{ section.settings.brand_name | default: 'BloomFit' }}</h3><p>Activewear designed for the modern woman. Move with grace. Train with fire.</p></div>
      <div class="cfaw-fc"><h4>Shop</h4><ul><li><a href="#">New In</a></li><li><a href="#">Leggings</a></li><li><a href="#">Sports Bras</a></li><li><a href="#">Sets</a></li></ul></div>
      <div class="cfaw-fc"><h4>Brand</h4><ul><li><a href="#">Our Story</a></li><li><a href="#">Sustainability</a></li><li><a href="#">Blog</a></li></ul></div>
      <div class="cfaw-fc"><h4>Support</h4><ul><li><a href="#">Size Guide</a></li><li><a href="#">Returns</a></li><li><a href="#">Track Order</a></li><li><a href="#">Contact</a></li></ul></div>
    </div>
    <div class="cfaw-fbot"><span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'BloomFit' }}.</span><span>Privacy &middot; Terms</span></div>
  </footer>
</div>
{% schema %}
{
  "name": "Activewear Landing",
  "settings": [
    {"type":"text","id":"brand_name","label":"Brand Name","default":"BloomFit"},
    {"type":"text","id":"hero_tag","label":"Hero Tag","default":"New SS25 Collection"},
    {"type":"textarea","id":"hero_h1","label":"Hero Heading","default":"Move With Grace. Train With Fire."},
    {"type":"textarea","id":"hero_sub","label":"Hero Subtext","default":"Activewear designed for the modern woman. High-performance fabrics that move with you."},
    {"type":"text","id":"cta1_text","label":"CTA 1 Text","default":"Shop New In"},
    {"type":"url","id":"cta1_url","label":"CTA 1 URL"},
    {"type":"text","id":"cta2_text","label":"CTA 2 Text","default":"View Collections"},
    {"type":"url","id":"cta2_url","label":"CTA 2 URL"},
    {"type":"collection","id":"featured_collection","label":"Featured Collection"}
  ],
  "presets": [{"name":"Activewear Landing"}]
}
{% endschema %}
