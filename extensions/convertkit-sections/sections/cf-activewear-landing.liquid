{% comment %}
  ConvertFlow — Activewear Landing Page
  High-energy, fitness-oriented layout with Video Hero, Performance Specs, and Dynamic Grids.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Teko:wght@400;600;700&family=Inter:wght@400;600;800&display=swap');

  :root {
    --aw-primary: {{ section.settings.color_primary | default: '#E2FE16' }}; /* Neon Yellow */
    --aw-bg: {{ section.settings.color_bg | default: '#050505' }};
    --aw-surface: {{ section.settings.color_surface | default: '#111111' }};
    --aw-text: {{ section.settings.color_text | default: '#FFFFFF' }};
    --aw-text-dim: #A1A1AA;
    --aw-font-heading: 'Teko', sans-serif;
    --aw-font-body: 'Inter', sans-serif;
  }

  .cf-aw * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-aw { font-family: var(--aw-font-body); background: var(--aw-bg); color: var(--aw-text); overflow-x: hidden; }
  .cf-aw h1, .cf-aw h2, .cf-aw h3 { font-family: var(--aw-font-heading); text-transform: uppercase; line-height: 1.1; }
  
  /* Buttons */
  .cf-aw-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    background: var(--aw-primary); color: #000;
    padding: 16px 32px; font-size: 16px; font-weight: 800; text-transform: uppercase;
    text-decoration: none; border: none; cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    letter-spacing: 1px;
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
  }
  .cf-aw-btn:hover { transform: translateY(-4px); box-shadow: 0 10px 20px rgba(226, 254, 22, 0.2); }
  .cf-aw-btn-outline { background: transparent; color: var(--aw-primary); border: 2px solid var(--aw-primary); }
  .cf-aw-btn-outline:hover { background: var(--aw-primary); color: #000; }

  /* ── Blocks ── */
  
  /* Hero Video/Image */
  .cf-aw-hero { position: relative; min-height: 90vh; display: flex; align-items: center; padding: 5%; overflow: hidden; }
  .cf-aw-hero-bg { position: absolute; inset: 0; z-index: 1; }
  .cf-aw-hero-bg img, .cf-aw-hero-bg video { width: 100%; height: 100%; object-fit: cover; opacity: 0.7; }
  .cf-aw-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.3) 100%); z-index: 2; }
  .cf-aw-hero-content { position: relative; z-index: 3; max-width: 800px; }
  .cf-aw-hero-tag { display: inline-block; background: var(--aw-primary); color: #000; padding: 4px 12px; font-weight: 800; font-size: 14px; text-transform: uppercase; margin-bottom: 24px; letter-spacing: 2px; }
  .cf-aw-hero-title { font-size: clamp(60px, 10vw, 120px); font-weight: 700; margin-bottom: 20px; color: #fff; text-shadow: 2px 2px 0px rgba(226, 254, 22, 0.3); }
  .cf-aw-hero-title span { color: var(--aw-primary); }
  .cf-aw-hero-text { font-size: clamp(16px, 2vw, 20px); color: #ddd; margin-bottom: 40px; max-width: 600px; line-height: 1.6; }
  .cf-aw-hero-actions { display: flex; gap: 20px; flex-wrap: wrap; }

  /* Performance Specs */
  .cf-aw-specs { padding: 80px 5%; background: var(--aw-surface); border-top: 1px solid rgba(255,255,255,0.05); }
  .cf-aw-specs-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 40px; max-width: 1400px; margin: 0 auto; }
  .cf-aw-spec-item { display: flex; gap: 20px; align-items: flex-start; }
  .cf-aw-spec-icon { width: 60px; height: 60px; background: rgba(226, 254, 22, 0.1); color: var(--aw-primary); display: flex; align-items: center; justify-content: center; border-radius: 12px; flex-shrink: 0; font-size: 24px; }
  .cf-aw-spec-info h3 { font-size: 28px; margin-bottom: 8px; letter-spacing: 1px; }
  .cf-aw-spec-info p { color: var(--aw-text-dim); font-size: 15px; line-height: 1.6; }

  /* Grid Categories */
  .cf-aw-cats { padding: 100px 5%; }
  .cf-aw-section-header { text-align: center; margin-bottom: 60px; }
  .cf-aw-section-header h2 { font-size: clamp(40px, 6vw, 64px); letter-spacing: 2px; }
  .cf-aw-section-header p { color: var(--aw-primary); font-family: var(--aw-font-heading); font-size: 24px; text-transform: uppercase; letter-spacing: 4px; }
  .cf-aw-cats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; max-width: 1400px; margin: 0 auto; }
  .cf-aw-cat-card { position: relative; aspect-ratio: 4/5; overflow: hidden; text-decoration: none; group; display: block; }
  .cf-aw-cat-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s ease; opacity: 0.8; }
  .cf-aw-cat-card:hover img { transform: scale(1.1); opacity: 0.5; }
  .cf-aw-cat-content { position: absolute; inset: 0; padding: 40px; display: flex; flex-direction: column; justify-content: flex-end; background: linear-gradient(0deg, rgba(0,0,0,0.9) 0%, transparent 60%); }
  .cf-aw-cat-content h3 { font-size: 48px; color: #fff; margin-bottom: 10px; transform: translateY(20px); transition: transform 0.4s ease; }
  .cf-aw-cat-content span { color: var(--aw-primary); font-weight: 800; font-size: 14px; text-transform: uppercase; letter-spacing: 2px; opacity: 0; transform: translateY(20px); transition: all 0.4s ease; }
  .cf-aw-cat-card:hover .cf-aw-cat-content h3 { transform: translateY(0); }
  .cf-aw-cat-card:hover .cf-aw-cat-content span { opacity: 1; transform: translateY(0); }

  /* Featured Products Slider (CSS Scroll) */
  .cf-aw-prods { padding: 100px 0; background: var(--aw-surface); overflow: hidden; }
  .cf-aw-prods-inner { max-width: 1400px; margin: 0 auto; padding: 0 5%; }
  .cf-aw-prods-scroll { display: flex; gap: 30px; overflow-x: auto; padding-bottom: 40px; scroll-snap-type: x mandatory; scrollbar-color: var(--aw-primary) #222; scrollbar-width: thin; }
  .cf-aw-prod-card { flex: 0 0 clamp(280px, 30vw, 350px); scroll-snap-align: start; background: var(--aw-bg); border: 1px solid rgba(255,255,255,0.05); transition: border-color 0.3s; }
  .cf-aw-prod-card:hover { border-color: var(--aw-primary); }
  .cf-aw-prod-img { aspect-ratio: 3/4; background: #111; position: relative; overflow: hidden; }
  .cf-aw-prod-img img { width: 100%; height: 100%; object-fit: cover; }
  .cf-aw-prod-badge { position: absolute; top: 16px; left: 16px; background: var(--aw-primary); color: #000; padding: 4px 12px; font-size: 12px; font-weight: 800; text-transform: uppercase; }
  .cf-aw-prod-info { padding: 24px; }
  .cf-aw-prod-title { font-size: 20px; font-weight: 600; margin-bottom: 8px; color: #fff; }
  .cf-aw-prod-price { font-size: 24px; font-family: var(--aw-font-heading); color: var(--aw-primary); margin-bottom: 16px; }
  .cf-aw-prod-btn { width: 100%; padding: 12px; background: rgba(255,255,255,0.05); color: #fff; border: 1px solid rgba(255,255,255,0.1); font-weight: 800; text-transform: uppercase; cursor: pointer; transition: all 0.3s; font-size: 14px; letter-spacing: 1px; }
  .cf-aw-prod-card:hover .cf-aw-prod-btn { background: var(--aw-primary); color: #000; border-color: var(--aw-primary); }

  /* Motivation Banner */
  .cf-aw-banner { padding: 120px 5%; background: var(--aw-primary); color: #000; text-align: center; position: relative; overflow: hidden; }
  .cf-aw-banner h2 { font-size: clamp(60px, 12vw, 150px); line-height: 0.9; margin-bottom: 30px; mix-blend-mode: overlay; opacity: 0.8; }
  .cf-aw-banner p { font-size: clamp(18px, 3vw, 24px); font-weight: 800; text-transform: uppercase; max-width: 800px; margin: 0 auto 40px; }

  @media (max-width: 1024px) {
    .cf-aw-cats-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .cf-aw-cats-grid { grid-template-columns: 1fr; }
    .cf-aw-hero-actions { flex-direction: column; }
    .cf-aw-btn { width: 100%; }
  }
{% endstyle %}

<div class="cf-aw">
  {% for block in section.blocks %}
    {% case block.type %}
      
      {% when 'hero' %}
        <section class="cf-aw-hero">
          <div class="cf-aw-hero-bg">
            {% if block.settings.video_url != blank %}
              <video src="{{ block.settings.video_url }}" autoplay loop muted playsinline></video>
            {% elsif block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: 'master' }}" alt="Hero">
            {% else %}
              <img src="https://cdn.shopify.com/s/files/1/0533/2089/files/activewear-hero-bg.jpg" alt="Activewear">
            {% endif %}
          </div>
          <div class="cf-aw-hero-overlay"></div>
          <div class="cf-aw-hero-content">
            {% if block.settings.tag != blank %}
              <div class="cf-aw-hero-tag">{{ block.settings.tag }}</div>
            {% endif %}
            <h1 class="cf-aw-hero-title">{{ block.settings.title }}</h1>
            <p class="cf-aw-hero-text">{{ block.settings.text }}</p>
            <div class="cf-aw-hero-actions">
              <a href="{{ block.settings.btn_1_url }}" class="cf-aw-btn">{{ block.settings.btn_1_text }} <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
              {% if block.settings.btn_2_text != blank %}
                <a href="{{ block.settings.btn_2_url }}" class="cf-aw-btn cf-aw-btn-outline">{{ block.settings.btn_2_text }}</a>
              {% endif %}
            </div>
          </div>
        </section>

      {% when 'specs' %}
        <section class="cf-aw-specs">
          <div class="cf-aw-specs-grid">
            <div class="cf-aw-spec-item">
              <div class="cf-aw-spec-icon">
                <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </div>
              <div class="cf-aw-spec-info">
                <h3>{{ block.settings.spec_1_title }}</h3>
                <p>{{ block.settings.spec_1_text }}</p>
              </div>
            </div>
            <div class="cf-aw-spec-item">
              <div class="cf-aw-spec-icon">
                <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/></svg>
              </div>
              <div class="cf-aw-spec-info">
                <h3>{{ block.settings.spec_2_title }}</h3>
                <p>{{ block.settings.spec_2_text }}</p>
              </div>
            </div>
            <div class="cf-aw-spec-item">
              <div class="cf-aw-spec-icon">
                <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
              </div>
              <div class="cf-aw-spec-info">
                <h3>{{ block.settings.spec_3_title }}</h3>
                <p>{{ block.settings.spec_3_text }}</p>
              </div>
            </div>
          </div>
        </section>

      {% when 'categories' %}
        <section class="cf-aw-cats">
          <div class="cf-aw-section-header">
            <p>Gear Up</p>
            <h2>{{ block.settings.heading }}</h2>
          </div>
          <div class="cf-aw-cats-grid">
            {% for i in (1..3) %}
              {% capture title %}cat_{{ i }}_title{% endcapture %}
              {% capture img %}cat_{{ i }}_img{% endcapture %}
              {% capture link %}cat_{{ i }}_url{% endcapture %}
              
              <a href="{{ block.settings[link] }}" class="cf-aw-cat-card">
                {% if block.settings[img] != blank %}
                  <img src="{{ block.settings[img] | img_url: '800x' }}" alt="{{ block.settings[title] }}">
                {% else %}
                  <div style="width:100%; height:100%; background:#222; display:flex; align-items:center; justify-content:center;">Placeholder</div>
                {% endif %}
                <div class="cf-aw-cat-content">
                  <h3>{{ block.settings[title] }}</h3>
                  <span>Shop Collection &rarr;</span>
                </div>
              </a>
            {% endfor %}
          </div>
        </section>

      {% when 'products' %}
        <section class="cf-aw-prods">
          <div class="cf-aw-prods-inner">
            <div class="cf-aw-section-header">
              <p>Top Rated</p>
              <h2>{{ block.settings.heading }}</h2>
            </div>
            <div class="cf-aw-prods-scroll">
              {% assign collection = block.settings.collection %}
              {% if collection != blank and collection.products_count > 0 %}
                {% for product in collection.products limit: block.settings.limit %}
                  <div class="cf-aw-prod-card">
                    <a href="{{ product.url }}" class="cf-aw-prod-img" style="display:block;">
                      {% if product.featured_image %}
                        <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title }}">
                      {% endif %}
                      {% if product.compare_at_price > product.price %}
                        <span class="cf-aw-prod-badge">Sale</span>
                      {% endif %}
                    </a>
                    <div class="cf-aw-prod-info">
                      <div class="cf-aw-prod-title">{{ product.title }}</div>
                      <div class="cf-aw-prod-price">{{ product.price | money }}</div>
                      <button class="cf-aw-prod-btn">Quick Add</button>
                    </div>
                  </div>
                {% endfor %}
              {% else %}
                {% for i in (1..5) %}
                  <div class="cf-aw-prod-card">
                    <div class="cf-aw-prod-img"><div style="width:100%; height:100%; background:#222;"></div></div>
                    <div class="cf-aw-prod-info">
                      <div class="cf-aw-prod-title">Performance Tee {{ i }}</div>
                      <div class="cf-aw-prod-price">$45.00</div>
                      <button class="cf-aw-prod-btn">Quick Add</button>
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </div>
        </section>

      {% when 'banner' %}
        <section class="cf-aw-banner">
          <h2>{{ block.settings.bg_text }}</h2>
          <p>{{ block.settings.heading }}</p>
          <a href="{{ block.settings.btn_url }}" class="cf-aw-btn cf-aw-btn-outline" style="border-color:#000; color:#000;">{{ block.settings.btn_text }}</a>
        </section>

    {% endcase %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "CF Activewear Landing",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Primary Color (Neon)", "default": "#E2FE16" },
    { "type": "color", "id": "color_bg", "label": "Background Color", "default": "#050505" },
    { "type": "color", "id": "color_surface", "label": "Surface Color", "default": "#111111" },
    { "type": "color", "id": "color_text", "label": "Text Color", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "hero",
      "name": "Hero Section",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "tag", "label": "Badge Text", "default": "New Collection" },
        { "type": "textarea", "id": "title", "label": "Headline", "default": "Push Your <span>Limits</span>" },
        { "type": "textarea", "id": "text", "label": "Subheading", "default": "Engineered for maximum performance and durability." },
        { "type": "text", "id": "video_url", "label": "Background Video URL (.mp4)" },
        { "type": "image_picker", "id": "image", "label": "Fallback Image" },
        { "type": "text", "id": "btn_1_text", "label": "Button 1 Text", "default": "Shop Men" },
        { "type": "url", "id": "btn_1_url", "label": "Button 1 Link" },
        { "type": "text", "id": "btn_2_text", "label": "Button 2 Text", "default": "Shop Women" },
        { "type": "url", "id": "btn_2_url", "label": "Button 2 Link" }
      ]
    },
    {
      "type": "specs",
      "name": "Performance Specs",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "spec_1_title", "label": "Spec 1 Title", "default": "Sweat-Wicking Tech" },
        { "type": "textarea", "id": "spec_1_text", "label": "Spec 1 Text", "default": "Stays dry during intense sessions." },
        { "type": "text", "id": "spec_2_title", "label": "Spec 2 Title", "default": "Four-Way Stretch" },
        { "type": "textarea", "id": "spec_2_text", "label": "Spec 2 Text", "default": "Moves with your body perfectly." },
        { "type": "text", "id": "spec_3_title", "label": "Spec 3 Title", "default": "Odor Resistant" },
        { "type": "textarea", "id": "spec_3_text", "label": "Spec 3 Text", "default": "Anti-microbial fabric finish." }
      ]
    },
    {
      "type": "categories",
      "name": "Category Grid",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop By Activity" },
        { "type": "image_picker", "id": "cat_1_img", "label": "Category 1 Image" },
        { "type": "text", "id": "cat_1_title", "label": "Category 1 Title", "default": "Running" },
        { "type": "url", "id": "cat_1_url", "label": "Category 1 Link" },
        { "type": "image_picker", "id": "cat_2_img", "label": "Category 2 Image" },
        { "type": "text", "id": "cat_2_title", "label": "Category 2 Title", "default": "Training" },
        { "type": "url", "id": "cat_2_url", "label": "Category 2 Link" },
        { "type": "image_picker", "id": "cat_3_img", "label": "Category 3 Image" },
        { "type": "text", "id": "cat_3_title", "label": "Category 3 Title", "default": "Yoga" },
        { "type": "url", "id": "cat_3_url", "label": "Category 3 Link" }
      ]
    },
    {
      "type": "products",
      "name": "Featured Products",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "range", "id": "limit", "label": "Product Limit", "min": 4, "max": 12, "step": 1, "default": 6 }
      ]
    },
    {
      "type": "banner",
      "name": "Motivation Banner",
      "settings": [
        { "type": "text", "id": "bg_text", "label": "Background Big Text", "default": "NO EXCUSES" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "Join the elite club of athletes pushing their boundaries daily." },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Join Community" },
        { "type": "url", "id": "btn_url", "label": "Button Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF Activewear Landing",
      "blocks": [
        { "type": "hero" },
        { "type": "specs" },
        { "type": "categories" },
        { "type": "products" },
        { "type": "banner" }
      ]
    }
  ]
}
{% endschema %}
