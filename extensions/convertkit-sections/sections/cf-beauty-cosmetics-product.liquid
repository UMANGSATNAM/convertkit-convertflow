<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --cf-accent: {{ section.settings.color_accent | default: '#D4BBA5' }};
  --cf-bg: {{ section.settings.color_bg | default: '#f8f3f0' }};
