{% comment %} ConvertFlow — Kids Toys Product Page {% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Fredoka+One&family=Varela+Round&display=swap');
  .cf-kids-p*{box-sizing:border-box;margin:0;padding:0}
  .cf-kids-p{font-family:'Varela Round',sans-serif;background:#F0F8FF;color:#333;padding:40px 5%}

  .cf-kids-p-wrap{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:40px;background:#fff;border-radius:40px;padding:40px;box-shadow:0 20px 40px rgba(0,0,0,.05)}
  
  .cf-kids-p-img{background:#F0F8FF;border-radius:24px;padding:40px;display:flex;align-items:center;justify-content:center;aspect-ratio:1}
  .cf-kids-p-img img{max-width:100%;max-height:100%;object-fit:contain}
  
  .cf-kids-p-info{display:flex;flex-direction:column;justify-content:center}
  .cf-kids-p-title{font-family:'Fredoka One',cursive;font-size:40px;line-height:1.1;margin-bottom:16px;color:#333}
  .cf-kids-p-price{font-family:'Fredoka One',cursive;font-size:32px;color:{{ section.settings.color_red | default: '#FF4D4D' }};margin-bottom:24px}
  .cf-kids-p-desc{font-size:18px;color:#666;line-height:1.6;margin-bottom:30px}
  
  .cf-kids-p-form{display:flex;gap:20px;align-items:center;margin-bottom:30px}
  .cf-kids-p-qty{display:flex;align-items:center;background:#F0F8FF;border-radius:50px;padding:8px 16px;font-family:'Fredoka One',cursive;font-size:20px}
  .cf-kids-p-qty button{background:none;border:none;font-size:24px;cursor:pointer;color:{{ section.settings.color_blue | default: '#4D94FF' }}}
  .cf-kids-p-qty span{margin:0 16px}
  
  .cf-kids-p-btn{flex:1;background:{{ section.settings.color_red | default: '#FF4D4D' }};color:#fff;border:none;border-radius:50px;padding:16px;font-family:'Fredoka One',cursive;font-size:20px;cursor:pointer;box-shadow:0 6px 0px #CC0000;transition:all .2s;text-transform:uppercase}
  .cf-kids-p-btn:hover{transform:translateY(2px);box-shadow:0 4px 0px #CC0000}
  
  .cf-kids-p-trust{display:flex;gap:16px;margin-top:20px}
  .cf-kids-p-badge{background:#F0F8FF;padding:12px;border-radius:16px;flex:1;text-align:center;font-weight:700;font-size:14px;color:{{ section.settings.color_blue | default: '#4D94FF' }}}

  @media(max-width:900px){
    .cf-kids-p-wrap{grid-template-columns:1fr;padding:20px}
  }
{% endstyle %}

<div class="cf-kids-p">
  <div class="cf-kids-p-wrap">
    <div class="cf-kids-p-img">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title }}">
      {% else %}
        <div style="font-size:80px">🧸</div>
      {% endif %}
    </div>
    <div class="cf-kids-p-info">
      <h1 class="cf-kids-p-title">{{ product.title | default: 'Super Awesome Toy' }}</h1>
      <div class="cf-kids-p-price">{{ product.price | money | default: '$29.99' }}</div>
      <div class="cf-kids-p-desc">
        {{ product.description | strip_html | truncate: 150 | default: 'This toy brings hours of fun, sparks creativity, and is perfectly safe for kids. Let the adventure begin!' }}
      </div>
      
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <div class="cf-kids-p-form">
          <div class="cf-kids-p-qty">
            <button type="button">-</button><span>1</span><button type="button">+</button>
          </div>
          <button type="submit" class="cf-kids-p-btn">Add to Cart!</button>
        </div>
      {% endform %}
      
      <div class="cf-kids-p-trust">
        <div class="cf-kids-p-badge">🛡️ 100% Safe</div>
        <div class="cf-kids-p-badge">🎁 Gift Wrap</div>
        <div class="cf-kids-p-badge">🚚 Fast Ship</div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CF Kids Toys PDP",
  "settings": [
    { "type": "color", "id": "color_red", "label": "Red", "default": "#FF4D4D" },
    { "type": "color", "id": "color_blue", "label": "Blue", "default": "#4D94FF" }
  ],
  "presets": [{ "name": "CF Kids Toys PDP" }]
}
{% endschema %}