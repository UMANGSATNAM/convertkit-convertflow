{% comment %}
  ConvertFlow — CaratLane Clone Collection Page
  Features: Sidebar filters, advanced product cards, responsive 4-col grid.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap');

  :root {
    --cf-primary: {{ section.settings.color_primary }};
    --cf-accent: {{ section.settings.color_accent }};
    --cf-bg: {{ section.settings.color_bg }};
    --cf-text: {{ section.settings.color_text }};
    --cf-light-bg: #F6EFFB;
    --cf-border-radius: {{ section.settings.border_radius }}px;
    --cf-font-heading: 'Playfair Display', serif;
    --cf-font-body: 'Inter', sans-serif;
  }

  .cf-cl-c * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-cl-c {
    font-family: var(--cf-font-body);
    color: var(--cf-text);
    background: var(--cf-bg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    padding: 20px 40px;
    max-width: 1440px;
    margin: 0 auto;
  }
  .cf-cl-c a { text-decoration: none; color: inherit; }

  /* ── Page Header & Utilities ── */
  .cf-cl-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #eee;
    padding-bottom: 16px;
    margin-bottom: 24px;
  }
  .cf-cl-active-tags {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .cf-cl-filters-label { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #444; }
  .cf-cl-tag {
    border: 1px solid #ccc;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }
  .cf-cl-tag:hover { border-color: var(--cf-primary); }
  .cf-cl-clear { font-size: 12px; color: #E83E8C; font-weight: 600; cursor: pointer; }
  
  .cf-cl-sort { font-size: 13px; color: #666; display: flex; align-items: center; gap: 8px; }
  .cf-cl-sort select {
    border: none;
    font-family: var(--cf-font-body);
    font-size: 13px;
    font-weight: 600;
    color: var(--cf-primary);
    background: transparent;
    cursor: pointer;
    outline: none;
  }

  /* ── Layout Grid ── */
  .cf-cl-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 40px;
    align-items: start;
  }

  /* ── Sidebar Filters ── */
  .cf-cl-sidebar { border-right: 1px solid #eee; padding-right: 20px; }
  .cf-cl-filter-group { margin-bottom: 30px; }
  .cf-cl-filter-title { font-size: 14px; font-weight: 600; color: #333; margin-bottom: 16px; }
  .cf-cl-filter-list { display: flex; flex-direction: column; gap: 12px; }
  .cf-cl-filter-item { display: flex; align-items: center; gap: 10px; font-size: 13px; color: #555; cursor: pointer; }
  .cf-cl-filter-item input[type="checkbox"] {
    appearance: none; width: 16px; height: 16px; border: 1px solid #ccc; border-radius: 3px; cursor: pointer; position: relative;
  }
  .cf-cl-filter-item input[type="checkbox"]:checked {
    background: var(--cf-primary); border-color: var(--cf-primary);
  }
  .cf-cl-filter-item input[type="checkbox"]:checked::after {
    content: '✓'; position: absolute; color: white; font-size: 10px; left: 3px; top: 1px;
  }
  .cf-cl-filter-item.active { color: var(--cf-primary); font-weight: 600; }
  .cf-cl-filter-count { color: #999; font-size: 11px; margin-left: 4px; }
  .cf-cl-filter-more { color: var(--cf-primary); font-size: 12px; font-weight: 600; margin-top: 10px; cursor: pointer; display: flex; align-items: center; gap: 4px; }

  /* ── Product Grid ── */
  .cf-cl-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  /* ── Product Card ── */
  .cf-cl-card {
    background: #fff;
    border-radius: var(--cf-border-radius);
    padding: 16px;
    border: 1px solid transparent;
    transition: box-shadow 0.2s, border-color 0.2s;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .cf-cl-card:hover {
    box-shadow: 0 4px 15px rgba(0,0,0,0.06);
    border-color: #f0e6ea;
  }
  .cf-cl-card-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    background: #fdfdfd;
    border-radius: calc(var(--cf-border-radius) - 4px);
    overflow: hidden;
    margin-bottom: 16px;
  }
  .cf-cl-card-img-wrap img { width: 100%; height: 100%; object-fit: contain; }
  
  .cf-cl-badge {
    position: absolute;
    top: 10px; left: 10px;
    background: #FFB300;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }

  .cf-cl-img-nav {
    position: absolute;
    top: 50%; width: 100%;
    display: flex; justify-content: space-between;
    transform: translateY(-50%);
    opacity: 0; padding: 0 5px;
    transition: opacity 0.2s;
  }
  .cf-cl-card:hover .cf-cl-img-nav { opacity: 1; }
  .cf-cl-img-nav span {
    width: 24px; height: 24px; background: #fff; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 5px rgba(0,0,0,0.1); cursor: pointer; color: #666;
  }

  .cf-cl-view-similar {
    position: absolute;
    bottom: 10px; right: 10px;
    background: #fff;
    border: 1px solid #f0e6ea;
    border-radius: 20px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 600;
    color: #E83E8C;
    display: flex; align-items: center; gap: 4px;
    opacity: 0; transition: opacity 0.2s; cursor: pointer;
  }
  .cf-cl-card:hover .cf-cl-view-similar { opacity: 1; }

  .cf-cl-card-info { flex: 1; display: flex; flex-direction: column; }
  .cf-cl-card-price-row { display: flex; align-items: baseline; gap: 8px; margin-bottom: 4px; }
  .cf-cl-card-price { font-size: 18px; font-weight: 700; color: var(--cf-primary); }
  .cf-cl-card-compare { font-size: 12px; color: #999; text-decoration: line-through; }
  
  .cf-cl-delivery { font-size: 11px; font-weight: 600; color: var(--cf-primary); margin-bottom: 6px; cursor: pointer; }
  .cf-cl-delivery:hover { text-decoration: underline; }
  
  .cf-cl-card-title { font-size: 12px; color: #666; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }


  @media (max-width: 1200px) {
    .cf-cl-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .cf-cl-layout { grid-template-columns: 1fr; }
    .cf-cl-sidebar { display: none; /* In reality would be a drawer */ }
    .cf-cl-top { flex-direction: column; align-items: flex-start; gap: 16px; }
  }
  @media (max-width: 600px) {
    .cf-cl-c { padding: 16px; }
    .cf-cl-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .cf-cl-card { padding: 10px; }
    .cf-cl-card-price { font-size: 15px; }
  }
{% endstyle %}

<div class="cf-cl-c">
  
  <!-- TOP UTILITIES -->
  <div class="cf-cl-top">
    <div class="cf-cl-active-tags">
      <span class="cf-cl-filters-label">FILTERS</span>
      <span class="cf-cl-clear">CLEAR ALL</span>
      <div class="cf-cl-tag">
        {{ collection.title | default: section.settings.fallback_col_title }}
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </div>
    </div>
    
    <div class="cf-cl-sort">
      Sort By:
      <select>
        <option>Featured</option>
        <option>Price: Low to High</option>
        <option>Price: High to Low</option>
        <option>Newest Arrivals</option>
      </select>
    </div>
  </div>

  <!-- MAIN LAYOUT -->
  <div class="cf-cl-layout">
    
    <!-- SIDEBAR -->
    {% if section.settings.show_sidebar %}
    <aside class="cf-cl-sidebar">
      
      <div class="cf-cl-filter-group">
        <div class="cf-cl-filter-title">Price</div>
        <div class="cf-cl-filter-list">
          <label class="cf-cl-filter-item"><input type="checkbox"> ₹10,001 - ₹15,000 <span class="cf-cl-filter-count">(298)</span></label>
          <label class="cf-cl-filter-item"><input type="checkbox"> ₹20,001 - ₹30,000 <span class="cf-cl-filter-count">(379)</span></label>
          <label class="cf-cl-filter-item"><input type="checkbox"> Under ₹5,000 <span class="cf-cl-filter-count">(1)</span></label>
          <label class="cf-cl-filter-item"><input type="checkbox"> ₹5,001 - ₹10,000 <span class="cf-cl-filter-count">(119)</span></label>
          <div class="cf-cl-filter-more">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            10 More
          </div>
        </div>
      </div>

      <div class="cf-cl-filter-group">
        <div class="cf-cl-filter-title">Discounts</div>
        <div class="cf-cl-filter-list">
          <label class="cf-cl-filter-item"><input type="checkbox"> Flat 25% off on Making Charges <span class="cf-cl-filter-count">(402)</span></label>
          <label class="cf-cl-filter-item"><input type="checkbox"> Flat 30% off on Making Charges <span class="cf-cl-filter-count">(1)</span></label>
          <label class="cf-cl-filter-item"><input type="checkbox"> 50% Off on Making + 15% Off on Diamond <span class="cf-cl-filter-count">(2533)</span></label>
          <label class="cf-cl-filter-item"><input type="checkbox"> Flat 10% off on Making Charges <span class="cf-cl-filter-count">(426)</span></label>
          <div class="cf-cl-filter-more">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            2 More
          </div>
        </div>
      </div>

      <div class="cf-cl-filter-group">
        <div class="cf-cl-filter-title">Product Type</div>
        <div class="cf-cl-filter-list">
          <label class="cf-cl-filter-item active"><input type="checkbox" checked> Earrings <span class="cf-cl-filter-count">(3464)</span></label>
          <label class="cf-cl-filter-item"><input type="checkbox"> Rings <span class="cf-cl-filter-count">(2937)</span></label>
          <label class="cf-cl-filter-item"><input type="checkbox"> Necklaces <span class="cf-cl-filter-count">(1014)</span></label>
        </div>
      </div>

    </aside>
    {% endif %}

    <!-- PRODUCT GRID -->
    {% paginate collection.products by section.settings.products_per_page %}
    <div class="cf-cl-grid">
      {% for product in collection.products %}
        <a href="{{ product.url }}" class="cf-cl-card">
          <div class="cf-cl-card-img-wrap">
            {% if forloop.index == 4 %}
              <div class="cf-cl-badge">LATEST</div>
            {% endif %}
            
            <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}">
            
            <div class="cf-cl-img-nav">
              <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg></span>
              <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
            </div>
            
            <div class="cf-cl-view-similar">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
              View Similar
            </div>
          </div>
          
          <div class="cf-cl-card-info">
            <div class="cf-cl-card-price-row">
              <span class="cf-cl-card-price">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="cf-cl-card-compare">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
            <div class="cf-cl-delivery">Check Delivery Date</div>
            <div class="cf-cl-card-title">{{ product.title }}</div>
          </div>
        </a>
      {% else %}
        <!-- Fallbacks for App Dashboard Preview -->
        {% for i in (1..8) %}
        <a href="#" class="cf-cl-card">
          <div class="cf-cl-card-img-wrap">
            {% if i == 6 %}<div class="cf-cl-badge">LATEST</div>{% endif %}
            <img src="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-product-{{ i | modulo: 6 | plus: 1 }}.png" alt="Fallback">
            <div class="cf-cl-img-nav">
              <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg></span>
              <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
            </div>
            <div class="cf-cl-view-similar">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
              View Similar
            </div>
          </div>
          <div class="cf-cl-card-info">
            <div class="cf-cl-card-price-row">
              <span class="cf-cl-card-price">₹19,453</span>
              <span class="cf-cl-card-compare">₹24,431</span>
            </div>
            <div class="cf-cl-delivery">Check Delivery Date</div>
            <div class="cf-cl-card-title">Sparkling Daisy Diamond Stud Earrings</div>
          </div>
        </a>
        {% endfor %}
      {% endfor %}
    </div>
    {% endpaginate %}
    
  </div>

</div>

{% schema %}
{
  "name": "CaratLane Collection",
  "settings": [
    {
      "type": "header",
      "content": "Theme Colors"
    },
    {
      "type": "color",
      "id": "color_primary",
      "label": "Primary Brand Color",
      "default": "#493161"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent Color",
      "default": "#DEBB43"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner Radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Collection Settings"
    },
    {
      "type": "text",
      "id": "fallback_col_title",
      "label": "Fallback Collection Title",
      "default": "Earrings"
    },
    {
      "type": "checkbox",
      "id": "show_sidebar",
      "label": "Show Filter Sidebar",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products Per Page",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "CaratLane Collection"
    }
  ]
}
{% endschema %}
