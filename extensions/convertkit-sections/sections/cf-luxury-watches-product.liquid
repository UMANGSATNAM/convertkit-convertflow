{% comment %} ConvertFlow — Luxury Watches Product Page {% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Montserrat:wght@300;400;600&display=swap');
  .cf-lw-p*{box-sizing:border-box;margin:0;padding:0}
  .cf-lw-p{font-family:'Montserrat',sans-serif;background:#0A0A0A;color:#E5E4E2;padding:60px 5%}

  .cf-lw-p-wrap{max-width:1400px;margin:0 auto;display:grid;grid-template-columns:1.2fr 1fr;gap:60px;align-items:center}
  
  .cf-lw-p-gallery{display:flex;gap:20px}
  .cf-lw-p-thumbs{display:flex;flex-direction:column;gap:12px;width:80px}
  .cf-lw-p-thumb{aspect-ratio:3/4;background:#111;border:1px solid rgba(255,255,255,.05);cursor:pointer;display:flex;align-items:center;justify-content:center}
  .cf-lw-p-thumb:hover,.cf-lw-p-thumb.active{border-color:{{ section.settings.color_accent | default: '#D4AF37' }}}
  .cf-lw-p-thumb img{width:100%;height:100%;object-fit:cover}
  
  .cf-lw-p-main{flex:1;aspect-ratio:3/4;background:#111;border:1px solid rgba(255,255,255,.05);display:flex;align-items:center;justify-content:center;position:relative}
  .cf-lw-p-main img{width:100%;height:100%;object-fit:cover;filter:drop-shadow(0 20px 40px rgba(0,0,0,.8))}
  
  .cf-lw-p-info{padding:40px 0}
  .cf-lw-p-brand{font-size:11px;letter-spacing:6px;text-transform:uppercase;color:{{ section.settings.color_accent | default: '#D4AF37' }};margin-bottom:16px}
  .cf-lw-p-title{font-family:'Cinzel',serif;font-size:clamp(32px,4vw,48px);font-weight:400;color:#fff;line-height:1.1;margin-bottom:20px;letter-spacing:1px}
  .cf-lw-p-price{font-size:24px;font-weight:300;color:#E5E4E2;margin-bottom:40px}
  
  .cf-lw-p-desc{font-size:14px;color:#888;line-height:1.8;margin-bottom:40px}
  
  .cf-lw-p-specs{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:40px;padding-bottom:40px;border-bottom:1px solid rgba(255,255,255,.1)}
  .cf-lw-p-spec-label{font-size:10px;text-transform:uppercase;letter-spacing:3px;color:#666;margin-bottom:4px}
  .cf-lw-p-spec-val{font-size:13px;color:#E5E4E2}
  
  .cf-lw-p-actions{display:flex;gap:20px;align-items:center}
  .cf-lw-p-btn{flex:1;background:rgba(255,255,255,.05);color:#fff;border:1px solid rgba(255,255,255,.2);padding:20px;font-family:'Cinzel',serif;font-size:14px;letter-spacing:3px;text-transform:uppercase;cursor:pointer;transition:all .5s;backdrop-filter:blur(4px)}
  .cf-lw-p-btn:hover{background:{{ section.settings.color_accent | default: '#D4AF37' }};border-color:{{ section.settings.color_accent | default: '#D4AF37' }};color:#0A0A0A}

  @media(max-width:900px){
    .cf-lw-p-wrap{grid-template-columns:1fr}
    .cf-lw-p-gallery{flex-direction:column-reverse}
    .cf-lw-p-thumbs{flex-direction:row;width:100%}
  }
{% endstyle %}

<div class="cf-lw-p">
  <div class="cf-lw-p-wrap">
    
    <div class="cf-lw-p-gallery">
      <div class="cf-lw-p-thumbs">
        {% for image in product.images limit:4 %}
          <div class="cf-lw-p-thumb {% if forloop.first %}active{% endif %}">
            <img src="{{ image | img_url: '150x' }}" alt="{{ product.title }}">
          </div>
        {% endfor %}
      </div>
      <div class="cf-lw-p-main">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title }}">
        {% else %}
          <div style="width:50%;height:50%;border-radius:50%;background:radial-gradient(circle at center,#333,#0A0A0A)"></div>
        {% endif %}
      </div>
    </div>
    
    <div class="cf-lw-p-info">
      <div class="cf-lw-p-brand">{{ product.vendor | default: 'Maison D\'Horlogerie' }}</div>
      <h1 class="cf-lw-p-title">{{ product.title | default: 'The Chronograph Prestige' }}</h1>
      <div class="cf-lw-p-price">{{ product.price | money | default: '$24,500.00' }}</div>
      
      <div class="cf-lw-p-desc">
        {{ product.description | strip_html | truncate: 300 | default: 'A masterpiece of horological engineering. Features a self-winding mechanical movement, scratch-resistant sapphire crystal, and an exquisite hand-finished dial that reflects light with unparalleled brilliance.' }}
      </div>
      
      <div class="cf-lw-p-specs">
        <div><div class="cf-lw-p-spec-label">Calibre</div><div class="cf-lw-p-spec-val">Automatic 3255</div></div>
        <div><div class="cf-lw-p-spec-label">Power Reserve</div><div class="cf-lw-p-spec-val">70 Hours</div></div>
        <div><div class="cf-lw-p-spec-label">Case Material</div><div class="cf-lw-p-spec-val">18ct White Gold</div></div>
        <div><div class="cf-lw-p-spec-label">Water Res.</div><div class="cf-lw-p-spec-val">100 Metres / 330 Feet</div></div>
      </div>
      
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <div class="cf-lw-p-actions">
          <button type="submit" class="cf-lw-p-btn">Acquire Timepiece</button>
        </div>
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CF Luxury Watches PDP",
  "settings": [
    { "type": "color", "id": "color_accent", "label": "Gold Accent", "default": "#D4AF37" }
  ],
  "presets": [{ "name": "CF Luxury Watches PDP" }]
}
{% endschema %}