<style>
.cf-org-footer-wrap {
  font-family: 'Public Sans', sans-serif;
  -webkit-font-smoothing: antialiased;
}
.cf-org-footer { background: #F2F7F4; padding: 80px 60px 40px; margin-top: 60px; color: var(--text, #2C3E35); }
.footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 60px; max-width: 1400px; margin: 0 auto 60px; }
.f-brand .brand { display: flex; align-items: center; gap: 8px; font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 600; color: var(--primary, #4A7C59); text-decoration: none; margin-bottom: 20px; }
.f-brand .brand svg { width: 32px; height: 32px; color: var(--secondary, #F4A261); }
.f-desc { color: var(--text-muted, #6B7D73); font-size: 14px; max-width: 300px; margin-bottom: 24px; line-height: 1.6; }
.socials { display: flex; gap: 16px; }
.socials a { width: 40px; height: 40px; border-radius: 50%; background: #fff; color: var(--primary, #4A7C59); display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
.socials a:hover { background: var(--primary, #4A7C59); color: #fff; }

.f-col h4 { font-size: 16px; font-weight: 700; color: var(--text, #2C3E35); margin-bottom: 24px; }
.f-col ul { list-style: none; padding: 0; margin: 0; }
.f-col li { margin-bottom: 12px; }
.f-col a { color: var(--text-muted, #6B7D73); text-decoration: none; font-size: 14px; transition: color 0.2s; }
.f-col a:hover { color: var(--primary, #4A7C59); }

.f-bottom { max-width: 1400px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border, #E2E8E4); padding-top: 30px; font-size: 13px; color: var(--text-muted, #6B7D73); flex-wrap: wrap; gap: 20px; }

@media(max-width: 1024px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
@media(max-width: 768px) { .cf-org-footer { padding: 60px 20px 30px; margin-top: 40px; } .footer-grid { grid-template-columns: 1fr; gap: 40px; } .f-bottom { flex-direction: column; text-align: center; } }
</style>

<div class="cf-org-footer-wrap">
  <footer class="cf-org-footer">
    <div class="footer-grid">
      <div class="f-brand">
        <a href="/" class="brand">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
          {{ shop.name }}
        </a>
        <p class="f-desc">{{ section.settings.about_text | default: "Delivering the season's finest organic produce and responsibly sourced groceries right to your doorstep." }}</p>
        <div class="socials">
          {% if section.settings.facebook != blank %}<a href="{{ section.settings.facebook }}" target="_blank"><svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557a9.83 9.83 0 01-2.828.775 4.932 4.932 0 002.165-2.724 9.864 9.864 0 01-3.127 1.195 4.916 4.916 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.902 4.902 0 001.523 6.574 4.903 4.903 0 01-2.229-.616c-.054 2.281 1.581 4.415 3.949 4.89a4.935 4.935 0 01-2.224.084 4.928 4.928 0 004.6 3.419A9.9 9.9 0 010 19.54a13.94 13.94 0 007.548 2.212c9.057 0 14.01-7.502 14.01-14.01 0-.213-.005-.425-.014-.636A10.025 10.025 0 0024 4.557z"/></svg></a>{% endif %}
          {% if section.settings.instagram != blank %}<a href="{{ section.settings.instagram }}" target="_blank"><svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg></a>{% endif %}
        </div>
      </div>
      
      {% for block in section.blocks %}
        {% if block.type == 'link_list' %}
        <div class="f-col" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.title }}</h4>
          <ul>
            {% for link in linklists[block.settings.menu].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% else %}
              <li><a href="#">Link Example 1</a></li>
              <li><a href="#">Link Example 2</a></li>
              <li><a href="#">Link Example 3</a></li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
      {% endfor %}
    </div>
    
    <div class="f-bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All Rights Reserved.</p>
      <div style="display:flex;gap:20px;">
        <a href="/policies/privacy-policy" style="color:var(--text-muted, #6B7D73);text-decoration:none">Privacy Policy</a>
        <a href="/policies/terms-of-service" style="color:var(--text-muted, #6B7D73);text-decoration:none">Terms & Conditions</a>
      </div>
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "Organic Food Footer",
  "settings": [
    { "type": "textarea", "id": "about_text", "label": "About Text", "default": "Delivering the season's finest organic produce and responsibly sourced groceries right to your doorstep." },
    { "type": "url", "id": "facebook", "label": "Facebook URL" },
    { "type": "url", "id": "instagram", "label": "Instagram URL" }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu Column",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Support" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Organic Food Footer",
      "blocks": [
        { "type": "link_list", "settings": { "title": "Dietary Paths" } },
        { "type": "link_list", "settings": { "title": "Our Farms" } },
        { "type": "link_list", "settings": { "title": "Support" } }
      ]
    }
  ]
}
{% endschema %}
