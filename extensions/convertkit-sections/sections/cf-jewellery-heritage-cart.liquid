{% comment %}
  ConvertFlow — Jewellery Heritage Cart Page
  Minimalist luxury cart with secure checkout badges.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Lato:wght@300;400;700&display=swap');

  :root {
    --jh-primary: {{ section.settings.color_primary | default: '#D4AF37' }};
    --jh-bg: {{ section.settings.color_bg | default: '#FFFFFF' }};
    --jh-surface: {{ section.settings.color_surface | default: '#FAFAFA' }};
    --jh-border: rgba(212, 175, 55, 0.3);
    --jh-text: {{ section.settings.color_text | default: '#222222' }};
    --jh-font-heading: 'Playfair Display', serif;
    --jh-font-body: 'Lato', sans-serif;
  }

  .cf-jh-cart * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-jh-cart { font-family: var(--jh-font-body); background: var(--jh-bg); color: var(--jh-text); min-height: 80vh; padding: 80px 5%; }
  
  .cf-jh-cart-wrap { max-width: 1000px; margin: 0 auto; }
  
  .cf-jh-cart-h1 { font-family: var(--jh-font-heading); font-size: 48px; font-weight: 400; margin-bottom: 40px; text-align: center; }
  .cf-jh-cart-h1::after { content: ''; display: block; width: 60px; height: 1px; background: var(--jh-primary); margin: 20px auto 0; }
  
  /* Items */
  .cf-jh-c-items { border-top: 1px solid #eaeaea; }
  .cf-jh-c-item { display: grid; grid-template-columns: 120px 1fr auto; gap: 30px; padding: 40px 0; border-bottom: 1px solid #eaeaea; align-items: center; }
  
  .cf-jh-c-img { aspect-ratio: 1; border: 1px solid #eaeaea; padding: 10px; display: flex; align-items: center; justify-content: center; }
  .cf-jh-c-img img { max-width: 100%; max-height: 100%; object-fit: contain; }
  
  .cf-jh-c-info h3 { font-family: var(--jh-font-heading); font-size: 22px; font-weight: 400; margin-bottom: 8px; color: var(--jh-text); }
  .cf-jh-c-var { font-size: 13px; color: #666; margin-bottom: 16px; font-weight: 300; }
  
  .cf-jh-c-actions { display: flex; align-items: center; gap: 24px; }
  .cf-jh-c-qty { display: flex; align-items: center; border: 1px solid #eaeaea; padding: 4px 16px; }
  .cf-jh-c-qty button { background: none; border: none; font-size: 16px; cursor: pointer; color: var(--jh-text); }
  .cf-jh-c-qty span { font-size: 14px; margin: 0 16px; }
  .cf-jh-c-remove { font-size: 11px; color: #888; text-transform: uppercase; letter-spacing: 2px; text-decoration: none; transition: color 0.3s; }
  .cf-jh-c-remove:hover { color: var(--jh-primary); }
  
  .cf-jh-c-price { font-family: var(--jh-font-heading); font-size: 20px; color: var(--jh-primary); }
  
  /* Summary */
  .cf-jh-cart-footer { max-width: 400px; margin-left: auto; margin-top: 40px; }
  .cf-jh-c-row { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 16px; color: #666; }
  .cf-jh-c-total { display: flex; justify-content: space-between; font-size: 20px; font-weight: 400; color: var(--jh-text); font-family: var(--jh-font-heading); border-top: 1px solid #eaeaea; padding-top: 20px; margin-top: 10px; margin-bottom: 30px; }
  
  .cf-jh-btn-checkout {
    display: block; width: 100%; text-align: center;
    background: var(--jh-primary); color: #fff; border: none;
    padding: 18px; font-size: 12px; text-transform: uppercase; letter-spacing: 2px;
    text-decoration: none; cursor: pointer; transition: background 0.4s ease;
  }
  .cf-jh-btn-checkout:hover { background: var(--jh-text); }
  
  .cf-jh-c-secure { text-align: center; margin-top: 20px; font-size: 11px; color: #888; text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; justify-content: center; gap: 8px; }
  .cf-jh-c-secure svg { width: 14px; height: 14px; color: var(--jh-primary); }

  .cf-jh-c-empty { text-align: center; padding: 60px 0; }
  .cf-jh-c-empty a { display: inline-block; padding: 14px 40px; border: 1px solid var(--jh-primary); color: var(--jh-text); text-decoration: none; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; margin-top: 20px; transition: all 0.3s; }
  .cf-jh-c-empty a:hover { background: var(--jh-primary); color: #fff; }

  @media(max-width: 768px) {
    .cf-jh-c-item { grid-template-columns: 80px 1fr; gap: 20px; position: relative; padding: 30px 0; }
    .cf-jh-c-price { position: absolute; top: 30px; right: 0; }
    .cf-jh-cart-footer { max-width: 100%; }
  }
{% endstyle %}

<div class="cf-jh-cart">
  <div class="cf-jh-cart-wrap">
    <h1 class="cf-jh-cart-h1">Your Selection</h1>
    
    {% if cart.item_count == 0 %}
      <div class="cf-jh-c-empty">
        <p style="color:#666; margin-bottom:20px; font-size:15px; font-weight:300;">Your exquisite collection is currently empty.</p>
        <a href="/collections/all">Discover Pieces</a>
      </div>
    {% else %}
      <div class="cf-jh-c-items">
        {% for item in cart.items %}
          <div class="cf-jh-c-item">
            <div class="cf-jh-c-img">
              {% if item.image %}
                <img src="{{ item.image | img_url: '200x' }}" alt="{{ item.title }}">
              {% endif %}
            </div>
            <div class="cf-jh-c-info">
              <h3>{{ item.product.title }}</h3>
              {% unless item.variant.title contains 'Default' %}
                <div class="cf-jh-c-var">{{ item.variant.title }}</div>
              {% endunless %}
              <div class="cf-jh-c-actions">
                <div class="cf-jh-c-qty">
                  <button>-</button><span>{{ item.quantity }}</span><button>+</button>
                </div>
                <a href="{{ item.url_to_remove }}" class="cf-jh-c-remove">Remove</a>
              </div>
            </div>
            <div class="cf-jh-c-price">{{ item.final_line_price | money }}</div>
          </div>
        {% endfor %}
      </div>
      
      <div class="cf-jh-cart-footer">
        <div class="cf-jh-c-row"><span>Subtotal</span> <span>{{ cart.total_price | money }}</span></div>
        <div class="cf-jh-c-row"><span>Insured Shipping</span> <span>Complimentary</span></div>
        <div class="cf-jh-c-total"><span>Total</span> <span>{{ cart.total_price | money }}</span></div>
        
        <a href="/checkout" class="cf-jh-btn-checkout">Secure Checkout</a>
        <div class="cf-jh-c-secure">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          256-Bit SSL Encrypted
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "CF Jewellery Cart",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Gold Accent", "default": "#D4AF37" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_surface", "label": "Surface", "default": "#FAFAFA" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#222222" }
  ],
  "presets": [
    { "name": "CF Jewellery Cart" }
  ]
}
{% endschema %}