<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">
<style>
.cfpc{--cr:#FAF8F4;--bk:#1A1A1A;--gd:#B8903A;--gdl:#E8C97A;--gy:#6B6B6B;--bd:#E8E3DA;}
.cfpc *{box-sizing:border-box;margin:0;padding:0;}
.cfpc{background:var(--cr);color:var(--bk);font-family:'DM Sans',sans-serif;font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;}
.cfpc h1,.cfpc h2,.cfpc h3{font-family:'Cormorant Garamond',serif;}
.cfpc-ann{background:var(--bk);color:var(--cr);text-align:center;padding:10px 16px;font-size:13px;letter-spacing:.08em;}
.cfpc-ann span{color:var(--gdl);}
.cfpc-nav{background:var(--cr);border-bottom:1px solid var(--bd);padding:18px 60px;display:flex;align-items:center;justify-content:space-between;}
.cfpc-logo{font-family:'Cormorant Garamond',serif;font-size:26px;font-weight:600;color:var(--bk);text-decoration:none;letter-spacing:2px;}
.cfpc-logo span{color:var(--gd);}
.cfpc-nav-links{display:flex;gap:32px;list-style:none;}
.cfpc-nav-links a{font-size:13px;font-weight:400;color:var(--gy);text-decoration:none;letter-spacing:.5px;transition:color .2s;}
.cfpc-nav-links a:hover{color:var(--bk);}
.cfpc-nav-right{display:flex;gap:20px;align-items:center;}
.cfpc-nav-right a{font-size:13px;color:var(--gy);text-decoration:none;transition:color .2s;}
.cfpc-nav-right a:hover{color:var(--gd);}
.cfpc-hero{display:grid;grid-template-columns:1fr 1fr;min-height:88vh;padding:0 60px;align-items:center;gap:80px;border-bottom:1px solid var(--bd);}
.cfpc-h-kicker{font-size:11px;font-weight:500;letter-spacing:4px;text-transform:uppercase;color:var(--gd);margin-bottom:24px;display:flex;align-items:center;gap:12px;}
.cfpc-h-kicker::before{content:'';width:32px;height:1px;background:var(--gd);}
.cfpc-hero h1{font-size:64px;font-weight:300;line-height:1.1;margin-bottom:24px;color:var(--bk);}
.cfpc-hero h1 em{font-style:italic;color:var(--gd);}
.cfpc-hero>div>p{font-size:17px;color:var(--gy);line-height:1.8;max-width:440px;margin-bottom:40px;font-weight:300;}
.cfpc-btns{display:flex;gap:16px;align-items:center;}
.cfpc-btn-bk{background:var(--bk);color:var(--cr);padding:16px 40px;font-size:13px;font-weight:500;letter-spacing:2px;text-transform:uppercase;text-decoration:none;transition:background .2s;}
.cfpc-btn-bk:hover{background:var(--gd);}
.cfpc-btn-out{color:var(--bk);font-size:13px;font-weight:500;letter-spacing:1px;text-decoration:none;border-bottom:1px solid var(--bk);padding-bottom:2px;transition:border-color .2s;}
.cfpc-btn-out:hover{border-color:var(--gd);color:var(--gd);}
.cfpc-trust{display:flex;gap:20px;margin-top:40px;flex-wrap:wrap;}
.cfpc-tb{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--gy);letter-spacing:.5px;}
.cfpc-tb::before{content:'✓';color:var(--gd);font-weight:700;}
.cfpc-hero-vis{display:flex;align-items:center;justify-content:center;}
.cfpc-product-showcase{width:100%;height:520px;background:linear-gradient(135deg,#F0EBE0 0%,#E8DDD0 100%);display:flex;align-items:center;justify-content:center;position:relative;border-radius:4px;}
.cfpc-product-showcase svg{width:35%;color:var(--gd);opacity:.25;}
.cfpc-showcase-badge{position:absolute;bottom:32px;right:32px;background:var(--bk);color:var(--cr);padding:20px 24px;text-align:center;}
.cfpc-showcase-badge strong{font-family:'Cormorant Garamond',serif;font-size:28px;display:block;color:var(--gdl);}
.cfpc-showcase-badge span{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:rgba(250,248,244,.5);}
.cfpc-ingredients{background:var(--bk);padding:80px 60px;}
.cfpc-ig-inner{max-width:1400px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;}
.cfpc-ig-left h2{font-size:52px;font-weight:300;color:#fff;margin-bottom:24px;line-height:1.1;}
.cfpc-ig-left h2 em{font-style:italic;color:var(--gdl);}
.cfpc-ig-left p{font-size:16px;color:rgba(250,248,244,.5);line-height:1.9;margin-bottom:40px;}
.cfpc-btn-gold{background:transparent;border:1px solid var(--gd);color:var(--gd);padding:16px 40px;font-size:12px;letter-spacing:3px;text-transform:uppercase;text-decoration:none;transition:all .3s;}
.cfpc-btn-gold:hover{background:var(--gd);color:var(--bk);}
.cfpc-ig-pills{display:flex;flex-wrap:wrap;gap:10px;}
.cfpc-pill{background:rgba(184,144,58,.12);border:1px solid rgba(184,144,58,.3);color:var(--gdl);padding:10px 20px;font-size:12px;letter-spacing:1px;text-transform:uppercase;transition:background .2s;}
.cfpc-pill:hover{background:rgba(184,144,58,.2);}
.cfpc-prods{padding:100px 60px;max-width:1400px;margin:0 auto;}
.cfpc-ph{text-align:center;margin-bottom:70px;}
.cfpc-ph h2{font-size:52px;font-weight:300;margin-bottom:12px;}
.cfpc-ph p{font-size:16px;color:var(--gy);}
.cfpc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;}
.cfpc-card{background:var(--cr);border:1px solid var(--bd);overflow:hidden;transition:all .3s;}
.cfpc-card:hover{box-shadow:0 20px 60px rgba(0,0,0,.08);}
.cfpc-card-img{aspect-ratio:3/4;background:linear-gradient(135deg,#F0EBE0,#E8DDD0);display:flex;align-items:center;justify-content:center;position:relative;}
.cfpc-card-img img{width:100%;height:100%;object-fit:cover;}
.cfpc-card-img svg{width:35%;color:var(--gd);opacity:.2;}
.cfpc-card-tag{position:absolute;top:16px;left:16px;background:var(--bk);color:var(--cr);font-size:9px;letter-spacing:2px;text-transform:uppercase;padding:5px 12px;}
.cfpc-card-body{padding:28px;}
.cfpc-card-cat{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gd);margin-bottom:8px;}
.cfpc-card-name{font-family:'Cormorant Garamond',serif;font-size:22px;margin-bottom:8px;color:var(--bk);line-height:1.2;}
.cfpc-card-desc{font-size:13px;color:var(--gy);margin-bottom:20px;line-height:1.7;}
.cfpc-card-foot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--bd);padding-top:20px;}
.cfpc-card-price{font-family:'Cormorant Garamond',serif;font-size:26px;font-weight:400;}
.cfpc-card-old{font-size:14px;color:var(--gy);text-decoration:line-through;margin-left:8px;}
.cfpc-atc{background:var(--bk);color:var(--cr);border:none;padding:12px 24px;font-size:11px;letter-spacing:2px;text-transform:uppercase;cursor:pointer;font-family:'DM Sans',sans-serif;transition:background .2s;}
.cfpc-atc:hover{background:var(--gd);}
.cfpc-footer{background:var(--bk);padding:80px 60px 40px;}
.cfpc-fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;padding-bottom:60px;border-bottom:1px solid rgba(255,255,255,.08);}
.cfpc-fb h3{font-family:'Cormorant Garamond',serif;font-size:26px;color:var(--gdl);letter-spacing:2px;margin-bottom:16px;}
.cfpc-fb p{font-size:13px;color:rgba(250,248,244,.4);line-height:1.9;max-width:260px;}
.cfpc-fc h4{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:rgba(250,248,244,.35);margin-bottom:20px;}
.cfpc-fc ul{list-style:none;}
.cfpc-fc li{margin-bottom:10px;}
.cfpc-fc a{color:rgba(250,248,244,.45);text-decoration:none;font-size:13px;transition:color .2s;}
.cfpc-fc a:hover{color:var(--gdl);}
.cfpc-fbot{display:flex;justify-content:space-between;padding-top:28px;font-size:11px;color:rgba(250,248,244,.2);letter-spacing:1px;}
@media(max-width:1024px){.cfpc-hero{grid-template-columns:1fr;min-height:auto}.cfpc-hero-vis{display:none}.cfpc-ig-inner{grid-template-columns:1fr}.cfpc-grid{grid-template-columns:repeat(2,1fr)}.cfpc-fg{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cfpc-nav{padding:16px 20px}.cfpc-nav-links{display:none}.cfpc-hero{padding:60px 20px}.cfpc-hero h1{font-size:44px}.cfpc-ingredients{padding:60px 20px}.cfpc-prods{padding:70px 20px}.cfpc-grid{grid-template-columns:1fr}.cfpc-footer{padding:60px 20px 30px}.cfpc-fg{grid-template-columns:1fr;gap:40px}}
</style>

<div class="cfpc">
  <div class="cfpc-ann">{{ section.settings.promo_text | default: 'Launching in India — <span>Zero Harmful Chemicals. Clinically Tested.</span>' }}</div>
  <nav class="cfpc-nav">
    <a href="{{ routes.root_url }}" class="cfpc-logo">{{ section.settings.brand_name | default: 'PURE' }}<span>BODY</span></a>
    <ul class="cfpc-nav-links"><li><a href="#">Shop</a></li><li><a href="#">Ingredients</a></li><li><a href="#">Science</a></li><li><a href="#">Reviews</a></li></ul>
    <div class="cfpc-nav-right"><a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a></div>
  </nav>

{% comment %}ConvertFlow — PureBody Personal Care · Product Page{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">
<style>
:root{--cf-accent:{{ section.settings.color_accent | default: '#B8956A' }};--cf-bg:{{ section.settings.color_bg | default: '#FDFAF6' }};--cf-dark:#1A1710;}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
body{font-family:'DM Sans',sans-serif;background:var(--cf-bg);color:var(--cf-dark);-webkit-font-smoothing:antialiased}
.cfp-crumb{padding:14px 60px;font-size:12px;color:#999;background:#fff;border-bottom:1px solid #ede8e0}
.cfp-crumb a{color:#999;text-decoration:none}
.cfp-wrap{max-width:1300px;margin:0 auto;padding:60px;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}
.cfp-main-img{background:#f5ede4;aspect-ratio:1;display:flex;align-items:center;justify-content:center;margin-bottom:16px;overflow:hidden}
.cfp-main-img img{width:100%;height:100%;object-fit:cover}
.cfp-thumbs{display:flex;gap:10px}
.cfp-thumb{width:80px;aspect-ratio:1;background:#f0e8de;border:2px solid transparent;cursor:pointer;overflow:hidden;background-size:cover;background-position:center}
.cfp-thumb.active,.cfp-thumb:hover{border-color:var(--cf-accent)}
.cfp-vendor{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--cf-accent);margin-bottom:12px;display:block}
.cfp-name{font-family:'Cormorant Garamond',serif;font-size:38px;font-weight:300;line-height:1.2;margin-bottom:16px;font-style:italic}
.cfp-rating{display:flex;align-items:center;gap:8px;margin-bottom:20px;color:#aaa;font-size:13px}
.cfp-stars{color:#D4A96A;letter-spacing:2px}
.cfp-price-row{display:flex;align-items:center;gap:16px;margin-bottom:24px;padding-bottom:24px;border-bottom:1px solid #ede8e0}
.cfp-price{font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:400}
.cfp-compare{font-size:20px;color:#ccc;text-decoration:line-through}
.cfp-save{background:#f0f7f0;color:#2d6a4f;padding:4px 12px;font-size:12px;font-weight:600}
.cfp-desc{font-size:15px;color:#777;line-height:1.9;margin-bottom:28px}
.cfp-label{font-size:10px;font-weight:500;letter-spacing:2px;text-transform:uppercase;margin-bottom:10px;color:#aaa}
.cfp-variants{display:flex;gap:8px;margin-bottom:24px;flex-wrap:wrap}
.cfp-var{padding:8px 20px;border:1px solid #ddd6cc;background:#fff;font-size:13px;cursor:pointer;transition:all .2s;font-family:inherit;font-weight:400}
.cfp-var:hover,.cfp-var.active{border-color:var(--cf-accent);background:var(--cf-accent);color:#fff}
.cfp-qty-row{display:flex;gap:12px;margin-bottom:12px}
.cfp-qty{display:flex;align-items:center;border:1px solid #ddd6cc;overflow:hidden}
.cfp-qty button{width:40px;height:52px;background:#fff;border:none;font-size:20px;cursor:pointer;color:var(--cf-dark)}
.cfp-qty span{width:40px;text-align:center;font-size:16px}
.cfp-atc{flex:1;background:var(--cf-dark);color:#fff;border:none;padding:16px 32px;font-size:12px;font-weight:500;letter-spacing:3px;text-transform:uppercase;cursor:pointer;transition:opacity .2s;font-family:inherit}
.cfp-atc:hover{opacity:.85}
.cfp-buy-now{display:block;width:100%;background:transparent;color:var(--cf-dark);border:1px solid #ddd6cc;padding:14px;font-size:12px;font-weight:500;letter-spacing:3px;text-transform:uppercase;cursor:pointer;margin-top:8px;transition:all .2s;font-family:inherit}
.cfp-buy-now:hover{background:var(--cf-dark);color:#fff;border-color:var(--cf-dark)}
.cfp-trust{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:24px;padding-top:24px;border-top:1px solid #ede8e0}
.cfp-trust-item{display:flex;align-items:center;gap:8px;font-size:12px;color:#aaa}
.cfp-trust-icon{color:var(--cf-accent)}
.cfp-tabs{background:#fff;border-top:1px solid #ede8e0;padding:60px}
.cfp-tabs-inner{max-width:1300px;margin:0 auto}
.cfp-tab-nav{display:flex;border-bottom:1px solid #ede8e0;margin-bottom:40px}
.cfp-tab-btn{padding:14px 28px;font-size:13px;font-weight:400;letter-spacing:1px;cursor:pointer;border:none;background:none;color:#aaa;border-bottom:2px solid transparent;margin-bottom:-1px;font-family:inherit;text-transform:uppercase}
.cfp-tab-btn.active{color:var(--cf-accent);border-bottom-color:var(--cf-accent)}
.cfp-tab-content{display:none;font-size:15px;color:#777;line-height:1.9}
.cfp-tab-content.active{display:block}
.cfp-related{padding:80px 60px;background:var(--cf-bg);border-top:1px solid #ede8e0}
.cfp-related-inner{max-width:1300px;margin:0 auto}
.cfp-related h2{font-family:'Cormorant Garamond',serif;font-size:34px;font-weight:300;font-style:italic;margin-bottom:36px;text-align:center}
.cfp-related-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
.cfp-rel-card{background:#fff;text-decoration:none;color:var(--cf-dark);display:block;transition:all .3s;overflow:hidden;border:1px solid #ede8e0}
.cfp-rel-card:hover{transform:translateY(-4px);box-shadow:0 8px 30px rgba(0,0,0,.06)}
.cfp-rel-img{aspect-ratio:1;background:#f5ede4;overflow:hidden}
.cfp-rel-img img{width:100%;height:100%;object-fit:cover}
.cfp-rel-info{padding:16px}
.cfp-rel-name{font-size:14px;margin-bottom:6px;color:#555}
.cfp-rel-price{font-family:'Cormorant Garamond',serif;font-size:20px;color:var(--cf-accent)}
@media(max-width:1024px){.cfp-wrap{grid-template-columns:1fr;padding:30px 20px;gap:30px}.cfp-tabs,.cfp-related{padding:40px 20px}.cfp-related-grid{grid-template-columns:repeat(2,1fr)}}
</style>

{% if section.settings.show_breadcrumb %}
<div class="cfp-crumb"><a href="/">Home</a> › <a href="/collections/{{ product.type | handleize }}">{{ product.type | default: 'Skincare' }}</a> › {{ product.title }}</div>
{% endif %}

<div class="cfp-wrap">
  <div>
    <div class="cfp-main-img" id="cfpMainImg">
      {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title }}" id="cfpMainImgEl">{% endif %}
    </div>
    <div class="cfp-thumbs">
      {% for image in product.images limit: 5 %}
        <div class="cfp-thumb {% if forloop.first %}active{% endif %}" onclick="document.getElementById('cfpMainImgEl').src='{{ image | image_url: width: 800 }}';document.querySelectorAll('.cfp-thumb').forEach(t=>t.classList.remove('active'));this.classList.add('active')" style="background-image:url('{{ image | image_url: width: 200 }}')"></div>
      {% endfor %}
    </div>
  </div>
  <div>
    {% if section.settings.show_vendor %}<span class="cfp-vendor">{{ product.vendor }}</span>{% endif %}
    <h1 class="cfp-name">{{ product.title }}</h1>
    {% if section.settings.show_rating %}
    <div class="cfp-rating"><span class="cfp-stars">★★★★★</span> 4.9 · {{ section.settings.review_count }}</div>
    {% endif %}
    <div class="cfp-price-row">
      <div class="cfp-price">{{ product.price | money }}</div>
      {% if product.compare_at_price > product.price %}
        <div class="cfp-compare">{{ product.compare_at_price | money }}</div>
        <span class="cfp-save">{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round }}% OFF</span>
      {% endif %}
    </div>
    <p class="cfp-desc">{{ product.description | strip_html | truncate: 280 }}</p>
    {% unless product.has_only_default_variant %}
      {% for option in product.options_with_values %}
        <div class="cfp-label">{{ option.name }}</div>
        <div class="cfp-variants">{% for value in option.values %}<button class="cfp-var{% if forloop.first %} active{% endif %}">{{ value }}</button>{% endfor %}</div>
      {% endfor %}
    {% endunless %}
    <div class="cfp-qty-row">
      <div class="cfp-qty">
        <button onclick="var s=this.nextElementSibling;s.textContent=Math.max(1,+s.textContent-1)">−</button>
        <span>1</span>
        <button onclick="var s=this.previousElementSibling;s.textContent=+s.textContent+1">+</button>
      </div>
      <button class="cfp-atc">{{ section.settings.atc_text }}</button>
    </div>
    {% if section.settings.show_buy_now %}<button class="cfp-buy-now">{{ section.settings.buy_now_text }}</button>{% endif %}
    <div class="cfp-trust">
      <div class="cfp-trust-item"><span class="cfp-trust-icon"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>{{ section.settings.trust_1 }}</div>
      <div class="cfp-trust-item"><span class="cfp-trust-icon"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg></span>{{ section.settings.trust_2 }}</div>
      <div class="cfp-trust-item"><span class="cfp-trust-icon"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg></span>{{ section.settings.trust_3 }}</div>
      <div class="cfp-trust-item"><span class="cfp-trust-icon"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></span>{{ section.settings.trust_4 }}</div>
    </div>
  </div>
</div>

<div class="cfp-tabs">
  <div class="cfp-tabs-inner">
    <div class="cfp-tab-nav">
      <button class="cfp-tab-btn active" onclick="cfpTab(this,'Desc')">Description</button>
      <button class="cfp-tab-btn" onclick="cfpTab(this,'Ingr')">Ingredients</button>
      <button class="cfp-tab-btn" onclick="cfpTab(this,'Ship')">Shipping & Returns</button>
    </div>
    <div id="cfpDesc" class="cfp-tab-content active">{{ product.description }}</div>
    <div id="cfpIngr" class="cfp-tab-content"><p>{{ section.settings.ingredients_text }}</p></div>
    <div id="cfpShip" class="cfp-tab-content"><p>Free standard delivery on orders above ₹999. Easy 30-day returns on all products.</p></div>
  </div>
</div>

{% if section.settings.show_related and section.settings.related_collection != blank %}
<div class="cfp-related">
  <div class="cfp-related-inner">
    <h2>{{ section.settings.related_heading }}</h2>
    <div class="cfp-related-grid">
      {% for p in section.settings.related_collection.products limit: 4 %}
        <a href="{{ p.url }}" class="cfp-rel-card">
          <div class="cfp-rel-img">{% if p.featured_image %}<img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.title }}" loading="lazy">{% endif %}</div>
          <div class="cfp-rel-info"><div class="cfp-rel-name">{{ p.title | truncate: 50 }}</div><div class="cfp-rel-price">{{ p.price | money }}</div></div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>
{% endif %}

<script>function cfpTab(btn,id){document.querySelectorAll('.cfp-tab-btn').forEach(b=>b.classList.remove('active'));document.querySelectorAll('.cfp-tab-content').forEach(c=>c.classList.remove('active'));btn.classList.add('active');document.getElementById('cfp'+id).classList.add('active');}</script>

<footer class="cfpc-footer">
    <div class="cfpc-fg">
      <div class="cfpc-fb"><h3>{{ section.settings.brand_name | default: 'PUREBODY' }}</h3><p>Clean personal care formulated for the Indian climate. No compromises, no harmful chemicals.</p></div>
      <div class="cfpc-fc"><h4>Shop</h4><ul><li><a href="#">Deodorants</a></li><li><a href="#">Face Care</a></li><li><a href="#">Body Care</a></li><li><a href="#">Bundles</a></li></ul></div>
      <div class="cfpc-fc"><h4>Company</h4><ul><li><a href="#">Our Story</a></li><li><a href="#">Ingredients</a></li><li><a href="#">Science</a></li></ul></div>
