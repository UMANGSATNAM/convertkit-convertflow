{% comment %}ConvertFlow - Fitness Supplements Landing | IronCore style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Teko:wght@400;600;700;800&family=Barlow:wght@400;600;800&display=swap" rel="stylesheet">
<style>
.cfs *{box-sizing:border-box;margin:0;padding:0}
.cfs{font-family:'Barlow',sans-serif;font-size:16px;color:#fff;background:#0A0A0A;-webkit-font-smoothing:antialiased;text-transform:uppercase}
.cfs h1,.cfs h2,.cfs h3,.cfs-brand{font-family:'Teko',sans-serif;letter-spacing:1px}
/* PROMO BAR */
.cfs-promo{background:{{ section.settings.color_accent }};color:#000;padding:6px;text-align:center;font-weight:800;font-size:14px;letter-spacing:2px}
/* HERO */
.cfs-hero{min-height:calc(100vh - 120px);display:flex;align-items:center;position:relative;padding:0 80px;overflow:hidden;background:linear-gradient(90deg,rgba(10,10,10,1) 0%,rgba(10,10,10,.4) 100%),#171717}
.cfs-hero::after{content:'';position:absolute;right:-5vw;top:0;width:40vw;height:100%;background:{{ section.settings.color_accent }};transform:skewX(-15deg);z-index:1;opacity:.1}
.cfs-hero-content{position:relative;z-index:2;max-width:700px}
.cfs-hero-tag{display:inline-block;border:2px solid {{ section.settings.color_accent }};color:{{ section.settings.color_accent }};font-weight:800;padding:4px 12px;margin-bottom:20px;transform:skewX(-10deg)}
.cfs-hero-tag span{display:block;transform:skewX(10deg)}
.cfs-hero h1{font-size:110px;line-height:.85;margin-bottom:30px;color:#fff}
.cfs-hero h1 em{font-style:normal;-webkit-text-stroke:2px {{ section.settings.color_accent }};color:transparent}
.cfs-hero p{font-size:18px;font-weight:600;color:#888;margin-bottom:40px;max-width:500px;text-transform:none}
.cfs-btn-hero{background:{{ section.settings.color_accent }};color:#000;font-family:'Teko',sans-serif;font-size:32px;font-weight:700;padding:12px 48px;border:none;cursor:pointer;display:inline-block;transform:skewX(-10deg);box-shadow:-8px 8px 0 rgba(212,255,0,.3);transition:all .2s;text-decoration:none}
.cfs-btn-hero:hover{box-shadow:-4px 4px 0 rgba(212,255,0,.5);transform:skewX(-10deg) translate(-4px,4px);background:#fff}
.cfs-btn-hero span{display:block;transform:skewX(10deg)}
/* TICKER */
.cfs-ticker{background:{{ section.settings.color_accent }};color:#000;padding:16px 0;overflow:hidden;white-space:nowrap;border-top:4px solid #fff;border-bottom:4px solid #fff}
.cfs-ticker-inner{display:inline-block;animation:cfs-scroll 20s linear infinite;font-family:'Teko',sans-serif;font-size:28px;font-weight:700;letter-spacing:2px}
@keyframes cfs-scroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
/* PRODUCT GRID */
.cfs-section{padding:100px 40px;max-width:1600px;margin:0 auto}
.cfs-sec-title{font-size:64px;text-align:center;margin-bottom:60px;line-height:1}
.cfs-sec-title span{color:{{ section.settings.color_accent }}}
.cfs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px}
.cfs-card{background:#171717;position:relative;padding:30px;border:2px solid #333;clip-path:polygon(0 0,100% 0,100% calc(100% - 30px),calc(100% - 30px) 100%,0 100%);transition:all .3s;display:flex;flex-direction:column}
.cfs-card::after{content:'';position:absolute;bottom:0;right:0;width:30px;height:30px;background:{{ section.settings.color_accent }};transition:all .3s}
.cfs-card:hover{border-color:{{ section.settings.color_accent }};transform:translateY(-10px)}
.cfs-card-badge{position:absolute;top:16px;left:-10px;background:#fff;color:#000;font-weight:800;font-size:14px;padding:4px 16px;font-family:'Teko',sans-serif;letter-spacing:1px;z-index:2;box-shadow:4px 4px 0 {{ section.settings.color_accent }}}
.cfs-card-img{width:100%;aspect-ratio:1;background:#0A0A0A;margin-bottom:24px;display:flex;align-items:center;justify-content:center}
.cfs-card-img svg{width:50%;opacity:.8;color:{{ section.settings.color_accent }};filter:drop-shadow(0 0 10px rgba(212,255,0,.5))}
.cfs-card-name{font-size:32px;font-family:'Teko',sans-serif;line-height:1;margin-bottom:8px}
.cfs-card-desc{font-size:12px;color:#888;font-weight:600;margin-bottom:24px;letter-spacing:1px;text-transform:none}
.cfs-card-bottom{display:flex;justify-content:space-between;align-items:flex-end;margin-top:auto;border-top:2px solid #333;padding-top:20px}
.cfs-price{font-family:'Teko',sans-serif;font-size:36px;line-height:1;color:{{ section.settings.color_accent }};font-weight:600}
.cfs-old-price{font-size:18px;color:#888;text-decoration:line-through;font-family:'Teko',sans-serif;display:block;margin-bottom:-4px}
.cfs-btn-add{background:#fff;color:#000;border:none;padding:12px 24px;font-family:'Barlow',sans-serif;font-weight:800;font-size:14px;cursor:pointer;transition:all .2s;transform:skewX(-10deg)}
.cfs-btn-add:hover{background:{{ section.settings.color_accent }}}
.cfs-btn-add span{display:block;transform:skewX(10deg)}
/* STATS */
.cfs-stats{display:flex;background:#171717;border-top:2px solid #333;border-bottom:2px solid #333}
.cfs-stat{flex:1;padding:40px;text-align:center;border-right:2px solid #333}
.cfs-stat:last-child{border-right:none}
.cfs-stat-val{font-family:'Teko',sans-serif;font-size:64px;color:{{ section.settings.color_accent }};line-height:1;margin-bottom:8px}
.cfs-stat-lbl{font-size:14px;font-weight:800;letter-spacing:2px}
/* FOOTER */
.cfs-footer{padding:80px 40px 40px;background:#000;border-top:4px solid {{ section.settings.color_accent }}}
.cfs-f-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1.5fr;gap:60px;max-width:1600px;margin:0 auto}
.cfs-f-brand h2{font-size:56px;line-height:1;margin-bottom:20px;transform:skewX(-10deg)}
.cfs-f-brand h2 span{color:{{ section.settings.color_accent }}}
.cfs-f-desc{text-transform:none;color:#888;font-weight:600;max-width:300px;margin-bottom:30px}
.cfs-f-col h4{font-family:'Teko',sans-serif;font-size:28px;margin-bottom:20px;color:{{ section.settings.color_accent }}}
.cfs-f-col ul{list-style:none}
.cfs-f-col li{margin-bottom:12px}
.cfs-f-col a{color:#fff;text-decoration:none;font-weight:800;letter-spacing:1px;transition:color .2s}
.cfs-f-col a:hover{color:{{ section.settings.color_accent }}}
.cfs-vip-box{border:2px solid {{ section.settings.color_accent }};padding:30px;clip-path:polygon(0 0,100% 0,100% calc(100% - 20px),calc(100% - 20px) 100%,0 100%)}
.cfs-vip-box h4{font-family:'Teko',sans-serif;font-size:28px;margin-bottom:10px;color:{{ section.settings.color_accent }}}
.cfs-vip-box p{text-transform:none;color:#888;font-size:14px;margin-bottom:20px;font-weight:600}
.cfs-vip-input{width:100%;background:transparent;border:2px solid #333;color:#fff;padding:12px;font-family:'Barlow',sans-serif;font-weight:700;margin-bottom:12px;outline:none}
.cfs-vip-btn{width:100%;background:{{ section.settings.color_accent }};color:#000;border:none;padding:12px;font-family:'Barlow',sans-serif;font-weight:800;font-size:16px;cursor:pointer}
.cfs-f-bottom{max-width:1600px;margin:40px auto 0;padding-top:20px;border-top:2px solid #333;display:flex;justify-content:space-between;font-size:12px;font-weight:800;color:#888}
@media(max-width:1200px){.cfs-grid{grid-template-columns:repeat(2,1fr)}.cfs-f-grid{grid-template-columns:1fr 1fr}}
@media(max-width:900px){.cfs-hero{padding:80px 40px}.cfs-hero h1{font-size:80px}.cfs-stats{flex-direction:column}.cfs-stat{border-right:none;border-bottom:2px solid #333}}
@media(max-width:600px){.cfs-hero{padding:60px 20px;text-align:center}.cfs-hero-content{display:flex;flex-direction:column;align-items:center}.cfs-hero h1{font-size:60px}.cfs-grid{grid-template-columns:1fr}.cfs-f-grid{grid-template-columns:1fr}}
</style>

<div class="cfs">
  <div class="cfs-promo">{{ section.settings.promo_bar_text }}</div>

  <section class="cfs-hero">
    <div class="cfs-hero-content">
      {% if section.settings.hero_tag != blank %}
      <div class="cfs-hero-tag"><span>{{ section.settings.hero_tag }}</span></div>
      {% endif %}
      <h1>{{ section.settings.hero_line1 }}<br>{{ section.settings.hero_line2 }} <em>{{ section.settings.hero_line2_accent }}</em><br>{{ section.settings.hero_line3 }}</h1>
      <p>{{ section.settings.hero_subtext }}</p>
      <a href="{{ section.settings.hero_cta_link }}" class="cfs-btn-hero"><span>{{ section.settings.hero_cta_text }}</span></a>
    </div>
  </section>

  <div class="cfs-ticker">
    <div class="cfs-ticker-inner">{{ section.settings.ticker_text }} &nbsp;&nbsp;&nbsp; {{ section.settings.ticker_text }} &nbsp;&nbsp;&nbsp;</div>
  </div>

  <section class="cfs-section">
    <h2 class="cfs-sec-title">{{ section.settings.products_heading_line1 }} <span>{{ section.settings.products_heading_line2 }}</span></h2>
    <div class="cfs-grid">
      {% for block in section.blocks %}
        {% if block.type == 'product_card' %}
        <div class="cfs-card" {{ block.shopify_attributes }}>
          {% if block.settings.badge != blank %}<div class="cfs-card-badge">{{ block.settings.badge }}</div>{% endif %}
          <div class="cfs-card-img">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name }}" style="width:100%;height:100%;object-fit:cover">
            {% else %}
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
            {% endif %}
          </div>
          <div>
            <h3 class="cfs-card-name">{{ block.settings.name }}</h3>
            <p class="cfs-card-desc">{{ block.settings.description }}</p>
            <div class="cfs-card-bottom">
              <div>
                {% if block.settings.old_price != blank %}<span class="cfs-old-price">{{ block.settings.old_price }}</span>{% endif %}
                <div class="cfs-price">{{ block.settings.price }}</div>
              </div>
              <button class="cfs-btn-add"><span>ADD TO CART</span></button>
            </div>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  {% if section.settings.show_stats %}
  <div class="cfs-stats">
    {% for block in section.blocks %}
      {% if block.type == 'stat' %}
      <div class="cfs-stat" {{ block.shopify_attributes }}>
        <div class="cfs-stat-val">{{ block.settings.value }}</div>
        <div class="cfs-stat-lbl">{{ block.settings.label }}</div>
      </div>
      {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  <footer class="cfs-footer">
    <div class="cfs-f-grid">
      <div class="cfs-f-brand">
        <h2>{{ section.settings.brand_line1 }}<span>{{ section.settings.brand_line2 }}</span></h2>
        <p class="cfs-f-desc">{{ section.settings.brand_desc }}</p>
      </div>
      <div class="cfs-f-col"><h4>SHOP</h4><ul>
        <li><a href="#">ALL PRODUCTS</a></li>
        <li><a href="#">PRE-WORKOUTS</a></li>
        <li><a href="#">PROTEINS</a></li>
        <li><a href="#">FAT BURNERS</a></li>
      </ul></div>
      <div class="cfs-f-col"><h4>SUPPORT</h4><ul>
        <li><a href="#">FAQ</a></li>
        <li><a href="#">SHIPPING</a></li>
        <li><a href="#">RETURNS</a></li>
        <li><a href="#">CONTACT</a></li>
      </ul></div>
      <div class="cfs-vip-box">
        <h4>{{ section.settings.newsletter_heading }}</h4>
        <p>{{ section.settings.newsletter_text }}</p>
        <input type="email" class="cfs-vip-input" placeholder="EMAIL ADDRESS">
        <button class="cfs-vip-btn">{{ section.settings.newsletter_btn }}</button>
      </div>
    </div>
    <div class="cfs-f-bottom">
      <div>{{ section.settings.copyright }}</div>
      <div style="display:flex;gap:20px"><a href="#" style="color:#888;text-decoration:none">PRIVACY POLICY</a><a href="#" style="color:#888;text-decoration:none">TERMS OF SERVICE</a></div>
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "CF Fitness Supplements",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "text", "id": "brand_line1", "label": "Brand Name Line 1", "default": "IRON" },
    { "type": "text", "id": "brand_line2", "label": "Brand Name Line 2 (accent)", "default": "CORE" },
    { "type": "textarea", "id": "brand_desc", "label": "Brand Description", "default": "We don't do compromises. We engineer the highest quality supplements for those who demand more from their bodies." },
    { "type": "text", "id": "copyright", "label": "Copyright Text", "default": "© 2025 IRONCORE SUPPS. ALL RIGHTS RESERVED." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_accent", "label": "Accent Color (Neon)", "default": "#D4FF00" },
    { "type": "header", "content": "Promo Bar" },
    { "type": "text", "id": "promo_bar_text", "label": "Promo Bar Text", "default": "FREE SHIPPING ON ORDERS OVER $99 + GET A FREE SHAKER" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_tag", "label": "Hero Tag", "default": "CLINICALLY DOSED" },
    { "type": "text", "id": "hero_line1", "label": "Hero Line 1", "default": "Unleash" },
    { "type": "text", "id": "hero_line2", "label": "Hero Line 2", "default": "Your" },
    { "type": "text", "id": "hero_line2_accent", "label": "Hero Line 2 Accent (outline)", "default": "True" },
    { "type": "text", "id": "hero_line3", "label": "Hero Line 3", "default": "Potential" },
    { "type": "textarea", "id": "hero_subtext", "label": "Hero Subtext", "default": "No proprietary blends. No fillers. Just scientifically formulated supplements designed to push your limits and shatter plateaus." },
    { "type": "text", "id": "hero_cta_text", "label": "CTA Button Text", "default": "SHOP THE STACK" },
    { "type": "url", "id": "hero_cta_link", "label": "CTA Button Link" },
    { "type": "header", "content": "Ticker" },
    { "type": "text", "id": "ticker_text", "label": "Ticker Text (repeats)", "default": "/// 0% FILLERS /// 100% TRANSPARENCY /// CLINICAL DOSAGES /// GMP CERTIFIED /// BANNED SUBSTANCE TESTED" },
    { "type": "header", "content": "Products Section" },
    { "type": "text", "id": "products_heading_line1", "label": "Products Heading Line 1", "default": "ELITE" },
    { "type": "text", "id": "products_heading_line2", "label": "Products Heading Line 2 (accent)", "default": "ARSENAL" },
    { "type": "header", "content": "Stats Strip" },
    { "type": "checkbox", "id": "show_stats", "label": "Show Stats Strip", "default": true },
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter Heading", "default": "UNLOCK VIP PRICING" },
    { "type": "textarea", "id": "newsletter_text", "label": "Newsletter Text", "default": "Subscribe for 15% off your first order, exclusive drops, and workout guides." },
    { "type": "text", "id": "newsletter_btn", "label": "Newsletter Button Text", "default": "GET 15% OFF" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product Image" },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "default": "#1 PRE-WORKOUT" },
        { "type": "text", "id": "name", "label": "Product Name", "default": "OBLITERATE X3" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "High-stimulant pre-workout designed for explosive energy, laser focus, and skin-tearing pumps. 400mg Caffeine." },
        { "type": "text", "id": "old_price", "label": "Original Price (optional)", "default": "$49.99" },
        { "type": "text", "id": "price", "label": "Sale Price", "default": "$39.99" }
      ]
    },
    {
      "type": "stat",
      "name": "Stat Item",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "100%" },
        { "type": "text", "id": "label", "label": "Label", "default": "LABEL TRANSPARENCY" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF Fitness Supplements",
      "blocks": [
        { "type": "product_card", "settings": { "badge": "#1 PRE-WORKOUT", "name": "OBLITERATE X3", "description": "High-stimulant pre-workout for explosive energy, laser focus, and skin-tearing pumps. 400mg Caffeine.", "old_price": "$49.99", "price": "$39.99" } },
        { "type": "product_card", "settings": { "badge": "", "name": "ISOLATE PRO", "description": "100% Hydrolyzed Whey Protein Isolate. 25g Protein, 0g Sugar, rapid absorption for ultimate muscle recovery.", "old_price": "$64.99", "price": "$54.99" } },
        { "type": "product_card", "settings": { "badge": "", "name": "AMINO RECOVER R", "description": "Intra-workout EAA + BCAA complex with hydration matrix. Prevent catabolism during grueling sessions.", "old_price": "$39.99", "price": "$29.99" } },
        { "type": "stat", "settings": { "value": "100%", "label": "LABEL TRANSPARENCY" } },
        { "type": "stat", "settings": { "value": "3RD", "label": "PARTY TESTED" } },
        { "type": "stat", "settings": { "value": "PRO", "label": "ATHLETE APPROVED" } }
      ]
    }
  ]
}
{% endschema %}