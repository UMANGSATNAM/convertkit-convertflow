<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
<style>
:root {
  --primary: {{ section.settings.accent_color | default: '#4A7C59' }};
  --primary-light: #E9F2EC;
  --secondary: {{ section.settings.secondary_color | default: '#F4A261' }};
  --bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
  --surface: #F9FDF9;
  --text: {{ section.settings.text_color | default: '#2C3E35' }};
  --text-muted: #6B7D73;
  --border: #E2E8E4;
}
.cf-organic-hero-wrap {
  background: var(--bg);
  color: var(--text);
  font-family: 'Public Sans', sans-serif;
  font-size: 15px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
.cf-organic-hero-wrap * { margin: 0; padding: 0; box-sizing: border-box; }
.cf-organic-hero-wrap .serif { font-family: 'Playfair Display', serif; }

.hero { padding: 60px; max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
.hero-content { background: var(--surface); padding: 60px; border-radius: 40px; border: 1px solid var(--border); }
.h-tag { display: inline-block; background: var(--primary-light); color: var(--primary); font-size: 12px; font-weight: 600; padding: 6px 12px; border-radius: 20px; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 1px; }
.hero h1 { font-size: 52px; line-height: 1.1; margin-bottom: 20px; color: var(--primary); }
.hero h1 span { font-style: italic; color: var(--secondary); }
.hero p { font-size: 16px; color: var(--text-muted); margin-bottom: 32px; max-width: 400px; }
.btn-primary { background: var(--primary); color: #fff; padding: 16px 32px; border-radius: 40px; text-decoration: none; font-weight: 600; transition: background 0.2s, transform 0.2s; display: inline-flex; align-items: center; gap: 8px; border: none; cursor: pointer; }
.btn-primary:hover { opacity: 0.9; transform: translateY(-2px); }

.hero-visual { position: relative; aspect-ratio: 4/3; background: #DAEEDF; border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.hero-visual > svg { width: 50%; color: var(--primary); opacity: 0.5; }
.floating-badge { position: absolute; bottom: 40px; left: -20px; background: #fff; padding: 16px 24px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); display: flex; align-items: center; gap: 12px; z-index: 20; }
.fb-icon { width: 40px; height: 40px; background: var(--secondary); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; }

@media(max-width: 1200px) { .hero { gap: 40px; padding: 40px; } }
@media(max-width: 1024px) {
  .hero { grid-template-columns: 1fr; text-align: center; }
  .hero-content { padding: 40px; }
  .hero p { margin: 0 auto 32px; }
}
@media(max-width: 768px) {
  .hero { padding: 20px; }
  .hero h1 { font-size: 40px; }
  .floating-badge { left: 10px; bottom: 10px; padding: 10px 16px; }
}
</style>

<div class="cf-organic-hero-wrap">
  <div class="hero">
    <div class="hero-content">
      <div class="h-tag">{{ section.settings.eyebrow_tag | default: 'Directly from Local Farms' }}</div>
      <h1 class="serif">{{ section.settings.headline_start }}<br><span>{{ section.settings.headline_italic }}</span></h1>
      <p>{{ section.settings.subheading }}</p>
      <a href="{{ section.settings.cta_url }}" class="btn-primary">{{ section.settings.cta_text }} <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg></a>
    </div>
    <div class="hero-visual">
      {% if section.settings.hero_image != blank %}
        <img src="{{ section.settings.hero_image | image_url: width: 1400 }}" alt="Hero" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;z-index:10;border-radius:inherit;">
      {% endif %}
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      
      {% if section.settings.show_badge %}
      <div class="floating-badge">
        <div class="fb-icon">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
        </div>
        <div style="text-align:left;">
          <div style="font-weight:700; color:var(--text)">{{ section.settings.badge_title }}</div>
          <div style="font-size:12px; color:var(--text-muted)">{{ section.settings.badge_subtitle }}</div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Organic Food Hero",
  "settings": [
    { "type": "header", "content": "Brand & Colors" },
    { "type": "color", "id": "accent_color", "label": "Primary Accent", "default": "#4A7C59" },
    { "type": "color", "id": "secondary_color", "label": "Secondary Accent", "default": "#F4A261" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#2C3E35" },
    { "type": "header", "content": "Hero Content" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero Image" },
    { "type": "text", "id": "eyebrow_tag", "label": "Eyebrow Tag", "default": "Directly from Local Farms" },
    { "type": "text", "id": "headline_start", "label": "Headline Start", "default": "Eat Better." },
    { "type": "text", "id": "headline_italic", "label": "Headline Italic (Highlight)", "default": "Feel Better." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "100% certified organic produce and groceries delivered to your door within 12 hours of harvest. Pure, unadulterated nature." },
    { "type": "text", "id": "cta_text", "label": "CTA Text", "default": "Shop This Week's Harvest" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "header", "content": "Floating Badge" },
    { "type": "checkbox", "id": "show_badge", "label": "Show Floating Badge", "default": true },
    { "type": "text", "id": "badge_title", "label": "Badge Title", "default": "Certified USDA" },
    { "type": "text", "id": "badge_subtitle", "label": "Badge Subtitle", "default": "100% Organic Origin" }
  ],
  "presets": [{ "name": "Organic Food Hero" }]
}
{% endschema %}
