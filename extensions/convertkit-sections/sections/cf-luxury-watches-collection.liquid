{% comment %} ConvertFlow — Luxury Watches Collection Page {% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Montserrat:wght@300;400;600&display=swap');
  .cf-lw-c*{box-sizing:border-box;margin:0;padding:0}
  .cf-lw-c{font-family:'Montserrat',sans-serif;background:#0A0A0A;color:#E5E4E2;padding-bottom:100px}
  
  .cf-lw-c-head{text-align:center;padding:120px 5% 80px;border-bottom:1px solid rgba(255,255,255,.05)}
  .cf-lw-c-sub{font-size:11px;letter-spacing:6px;text-transform:uppercase;color:{{ section.settings.color_accent | default: '#D4AF37' }};margin-bottom:20px}
  .cf-lw-c-h1{font-family:'Cinzel',serif;font-size:clamp(40px,5vw,64px);color:#fff;margin-bottom:24px;font-weight:400;letter-spacing:2px}
  .cf-lw-c-p{font-size:14px;color:#888;max-width:600px;margin:0 auto;line-height:1.6}
  
  .cf-lw-c-wrap{max-width:1400px;margin:0 auto;padding:60px 5%}
  
  .cf-lw-c-toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:60px;padding-bottom:20px;border-bottom:1px solid rgba(255,255,255,.05);flex-wrap:wrap;gap:20px}
  .cf-lw-c-filters{display:flex;gap:30px;overflow-x:auto}
  .cf-lw-c-filter{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#888;text-decoration:none;transition:color .3s;white-space:nowrap}
  .cf-lw-c-filter:hover,.cf-lw-c-filter.active{color:{{ section.settings.color_accent | default: '#D4AF37' }}}
  
  .cf-lw-prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:40px}
  .cf-lw-card{text-decoration:none;color:#E5E4E2;text-align:center;display:block}
  .cf-lw-card-img{aspect-ratio:3/4;background:#111;padding:20px;position:relative;margin-bottom:24px;display:flex;align-items:center;justify-content:center}
  .cf-lw-card-img::before{content:'';position:absolute;inset:0;border:1px solid rgba(255,255,255,.05);transition:border-color .5s}
  .cf-lw-card:hover .cf-lw-card-img::before{border-color:{{ section.settings.color_accent | default: '#D4AF37' }}}
  .cf-lw-card-img img{width:100%;height:100%;object-fit:cover;transition:transform .8s;filter:drop-shadow(0 10px 20px rgba(0,0,0,.5))}
  .cf-lw-card:hover .cf-lw-card-img img{transform:scale(1.05)}
  
  .cf-lw-card-title{font-family:'Cinzel',serif;font-size:16px;margin-bottom:8px;color:#fff;letter-spacing:1px}
  .cf-lw-card-price{font-size:14px;color:#888}

  @media(max-width:1024px){
    .cf-lw-prod-grid{grid-template-columns:repeat(3,1fr)}
  }
  @media(max-width:768px){
    .cf-lw-prod-grid{grid-template-columns:repeat(2,1fr)}
  }
{% endstyle %}

<div class="cf-lw-c">
  <div class="cf-lw-c-head">
    <div class="cf-lw-c-sub">The Collection</div>
    <h1 class="cf-lw-c-h1">{{ collection.title | default: 'All Timepieces' }}</h1>
    <p class="cf-lw-c-p">{{ collection.description | strip_html | truncate: 150 | default: 'Discover our complete range of horological masterpieces.' }}</p>
  </div>
  
  <div class="cf-lw-c-wrap">
    <div class="cf-lw-c-toolbar">
      <div class="cf-lw-c-filters">
        <a href="#" class="cf-lw-c-filter active">All Models</a>
        <a href="#" class="cf-lw-c-filter">Chronograph</a>
        <a href="#" class="cf-lw-c-filter">Diving</a>
        <a href="#" class="cf-lw-c-filter">Dress</a>
        <a href="#" class="cf-lw-c-filter">Complications</a>
      </div>
      <div style="font-size:11px;letter-spacing:2px;color:#666;text-transform:uppercase">
        {{ collection.products_count | default: '12' }} Timepieces Found
      </div>
    </div>
    
    <div class="cf-lw-prod-grid">
      {% if collection.products.size > 0 %}
        {% for product in collection.products %}
          <a href="{{ product.url }}" class="cf-lw-card">
            <div class="cf-lw-card-img">
              {% if product.featured_image %}<img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title }}">{% endif %}
            </div>
            <div class="cf-lw-card-title">{{ product.title }}</div>
            <div class="cf-lw-card-price">{{ product.price | money }}</div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..8) %}
          <a href="#" class="cf-lw-card">
            <div class="cf-lw-card-img">
              <div style="width:50%;height:50%;border-radius:50%;background:radial-gradient(circle at center,#333,#0A0A0A)"></div>
            </div>
            <div class="cf-lw-card-title">Exquisite Timepiece {{ i }}</div>
            <div class="cf-lw-card-price">${{ i | times: 10000 | plus: 5000 | money_without_currency }}</div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CF Luxury Watches Coll",
  "settings": [
    { "type": "color", "id": "color_accent", "label": "Gold Accent", "default": "#D4AF37" }
  ],
  "presets": [{ "name": "CF Luxury Watches Coll" }]
}
{% endschema %}