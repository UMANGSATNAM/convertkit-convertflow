{% comment %}
  ConvertFlow — Streetwear Cart Page
  Brutalist receipt-style cart layout.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap');

  :root {
    --sw-primary: {{ section.settings.color_primary | default: '#FF3366' }};
    --sw-bg: {{ section.settings.color_bg | default: '#0A0A0A' }};
    --sw-surface: {{ section.settings.color_surface | default: '#121212' }};
    --sw-text: {{ section.settings.color_text | default: '#FFFFFF' }};
    --sw-border: rgba(255, 255, 255, 0.15);
    --sw-font-heading: 'Space Grotesk', sans-serif;
    --sw-font-mono: 'Space Mono', monospace;
  }

  .cf-sw-cart * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-sw-cart { font-family: var(--sw-font-heading); background: var(--sw-bg); color: var(--sw-text); min-height: 80vh; border-top: 1px solid var(--sw-border); }
  
  .cf-sw-cart-header { padding: 40px 5%; border-bottom: 1px solid var(--sw-border); }
  .cf-sw-cart-header h1 { font-size: clamp(40px, 6vw, 80px); font-weight: 700; text-transform: uppercase; margin-bottom: 10px; }
  .cf-sw-cart-header p { font-family: var(--sw-font-mono); font-size: 12px; color: #888; text-transform: uppercase; }
  
  .cf-sw-cart-grid { display: grid; grid-template-columns: 1fr 400px; }
  
  /* Items */
  .cf-sw-c-items { border-right: 1px solid var(--sw-border); }
  .cf-sw-c-item { display: grid; grid-template-columns: 120px 1fr auto; padding: 30px 5%; border-bottom: 1px solid var(--sw-border); align-items: start; gap: 30px; }
  .cf-sw-c-item:last-child { border-bottom: none; }
  
  .cf-sw-c-img { aspect-ratio: 4/5; background: #111; overflow: hidden; border: 1px solid var(--sw-border); }
  .cf-sw-c-img img { width: 100%; height: 100%; object-fit: cover; }
  
  .cf-sw-c-info { display: flex; flex-direction: column; gap: 10px; }
  .cf-sw-c-title { font-size: 20px; font-weight: 700; text-transform: uppercase; }
  .cf-sw-c-var { font-family: var(--sw-font-mono); font-size: 12px; color: #888; text-transform: uppercase; }
  
  .cf-sw-c-qty { display: inline-flex; border: 1px solid var(--sw-border); align-items: center; width: fit-content; margin-top: 10px; }
  .cf-sw-c-qty button { background: var(--sw-surface); border: none; color: var(--sw-text); width: 32px; height: 32px; font-size: 16px; cursor: pointer; }
  .cf-sw-c-qty span { font-family: var(--sw-font-mono); font-size: 12px; width: 32px; text-align: center; }
  
  .cf-sw-c-price { font-family: var(--sw-font-mono); font-size: 20px; color: var(--sw-primary); font-weight: 700; text-align: right; }
  .cf-sw-c-remove { display: block; font-family: var(--sw-font-mono); font-size: 10px; color: #888; text-transform: uppercase; text-decoration: none; margin-top: 20px; text-align: right; cursor: pointer; }
  .cf-sw-c-remove:hover { color: var(--sw-primary); }
  
  /* Summary */
  .cf-sw-c-sum { padding: 40px; position: sticky; top: 0; background: var(--sw-bg); }
  .cf-sw-c-sum h2 { font-size: 24px; font-weight: 700; text-transform: uppercase; margin-bottom: 30px; }
  
  .cf-sw-c-row { display: flex; justify-content: space-between; font-family: var(--sw-font-mono); font-size: 13px; color: #888; margin-bottom: 16px; text-transform: uppercase; border-bottom: 1px dashed var(--sw-border); padding-bottom: 8px; }
  .cf-sw-c-total { display: flex; justify-content: space-between; font-size: 18px; font-weight: 700; color: #fff; margin-top: 30px; margin-bottom: 30px; text-transform: uppercase; }
  .cf-sw-c-total span:last-child { font-family: var(--sw-font-mono); color: var(--sw-primary); font-size: 24px; }
  
  .cf-sw-btn-checkout { display: block; width: 100%; padding: 20px; background: var(--sw-text); color: var(--sw-bg); font-family: var(--sw-font-heading); font-size: 18px; font-weight: 700; text-transform: uppercase; text-align: center; text-decoration: none; transition: background 0.2s; border: none; cursor: pointer; }
  .cf-sw-btn-checkout:hover { background: var(--sw-primary); color: #000; }
  
  .cf-sw-c-empty { padding: 100px 5%; text-align: center; grid-column: 1 / -1; border-bottom: 1px solid var(--sw-border); }
  .cf-sw-c-empty h2 { font-size: 40px; text-transform: uppercase; margin-bottom: 20px; }
  .cf-sw-c-empty a { display: inline-block; padding: 16px 32px; border: 1px solid var(--sw-text); color: var(--sw-text); font-family: var(--sw-font-mono); font-size: 12px; font-weight: 700; text-transform: uppercase; text-decoration: none; margin-top: 20px; }
  .cf-sw-c-empty a:hover { background: var(--sw-text); color: var(--sw-bg); }

  @media(max-width: 1024px) {
    .cf-sw-cart-grid { grid-template-columns: 1fr; }
    .cf-sw-c-items { border-right: none; border-bottom: 1px solid var(--sw-border); }
  }
  @media(max-width: 600px) {
    .cf-sw-c-item { grid-template-columns: 80px 1fr; gap: 20px; }
    .cf-sw-c-price-col { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }
    .cf-sw-c-remove { margin-top: 0; }
  }
{% endstyle %}

<div class="cf-sw-cart">
  <div class="cf-sw-cart-header">
    <h1>CART [{{ cart.item_count | default: '0' }}]</h1>
    <p>SESSION ID: {{ section.id | default: 'SW-89420' }}</p>
  </div>
  
  <div class="cf-sw-cart-grid">
    {% if cart.item_count == 0 %}
      <div class="cf-sw-c-empty">
        <h2>NO ITEMS FOUND</h2>
        <a href="/collections/all">RETURN TO SHOP</a>
      </div>
    {% else %}
      <div class="cf-sw-c-items">
        {% for item in cart.items %}
          <div class="cf-sw-c-item">
            <div class="cf-sw-c-img">
              {% if item.image %}
                <img src="{{ item.image | img_url: '300x' }}" alt="{{ item.title }}">
              {% endif %}
            </div>
            <div class="cf-sw-c-info">
              <div class="cf-sw-c-title">{{ item.product.title }}</div>
              {% unless item.variant.title contains 'Default' %}
                <div class="cf-sw-c-var">VARIANT: {{ item.variant.title }}</div>
              {% endunless %}
              <div class="cf-sw-c-var">SKU: {{ item.sku | default: 'N/A' }}</div>
              <div class="cf-sw-c-qty">
                <button>-</button><span>{{ item.quantity }}</span><button>+</button>
              </div>
            </div>
            <div class="cf-sw-c-price-col">
              <div class="cf-sw-c-price">{{ item.final_line_price | money }}</div>
              <a href="{{ item.url_to_remove }}" class="cf-sw-c-remove">[REMOVE]</a>
            </div>
          </div>
        {% endfor %}
      </div>
      
      <div class="cf-sw-c-sum">
        <h2>ORDER_SUMMARY</h2>
        <div class="cf-sw-c-row"><span>SUBTOTAL</span> <span>{{ cart.total_price | money }}</span></div>
        <div class="cf-sw-c-row"><span>SHIPPING</span> <span>TBD</span></div>
        <div class="cf-sw-c-row"><span>TAXES</span> <span>INCLUDED</span></div>
        <div class="cf-sw-c-total"><span>TOTAL</span> <span>{{ cart.total_price | money }}</span></div>
        <a href="/checkout" class="cf-sw-btn-checkout">INITIATE CHECKOUT</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "CF Streetwear Cart",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Accent Color", "default": "#FF3366" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#0A0A0A" },
    { "type": "color", "id": "color_surface", "label": "Surface", "default": "#121212" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "CF Streetwear Cart" }
  ]
}
{% endschema %}
