// sections/cf-shared-testimonials.liquid
// Testimonials Section — each review is a block (add/remove/reorder from sidebar)

<style>
.cf-testi-sec { padding: 80px 60px; background: #fafafa; }
.cf-testi-hd { text-align: center; margin-bottom: 48px; }
.cf-testi-hd h2 { font-size: 36px; font-weight: 800; margin: 0; }
.cf-testi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; max-width: 1400px; margin: 0 auto; }
.cf-testi-card { background: #fff; border: 1px solid #eee; padding: 32px; display: flex; flex-direction: column; gap: 16px; }
.cf-testi-stars { color: var(--cf-accent, #f59e0b); font-size: 16px; letter-spacing: 2px; }
.cf-testi-text { font-size: 14px; line-height: 1.8; color: #555; font-style: italic; flex: 1; }
.cf-testi-author { font-size: 13px; font-weight: 700; color: var(--cf-accent, #000); }
.cf-testi-meta { font-size: 11px; color: #aaa; }
@media(max-width:768px) { .cf-testi-sec { padding: 50px 20px; } .cf-testi-grid { grid-template-columns: 1fr; } }
</style>

{% if section.settings.show_section %}
<div class="cf-testi-sec">
  <div class="cf-testi-hd">
    <h2>{{ section.settings.heading | default: 'What Our Customers Say' }}</h2>
  </div>
  <div class="cf-testi-grid">
    {% for block in section.blocks %}
      {% if block.type == 'review' %}
      <div class="cf-testi-card" {{ block.shopify_attributes }}>
        <div class="cf-testi-stars">
          {% assign stars = block.settings.rating | default: 5 %}
          {% for i in (1..stars) %}★{% endfor %}
        </div>
        <p class="cf-testi-text">&ldquo;{{ block.settings.text }}&rdquo;</p>
        <div>
          <div class="cf-testi-author">{{ block.settings.author }}</div>
          {% if block.settings.meta != blank %}
          <div class="cf-testi-meta">{{ block.settings.meta }}</div>
          {% endif %}
        </div>
      </div>
      {% endif %}
    {% endfor %}
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "CF Testimonials",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show Testimonials", "default": true },
    { "type": "text", "id": "heading", "label": "Section Heading", "default": "What Our Customers Say" }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Star Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review Text", "default": "Absolutely love the quality! Will definitely order again." },
        { "type": "text", "id": "author", "label": "Customer Name", "default": "Priya S." },
        { "type": "text", "id": "meta", "label": "Location / Tag (optional)", "default": "Verified Buyer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF Testimonials",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "text": "Absolutely love the quality! Will definitely order again.", "author": "Priya S.", "meta": "Verified Buyer" } },
        { "type": "review", "settings": { "rating": 5, "text": "Fast shipping and beautiful packaging. Exceeded all my expectations!", "author": "Rahul M.", "meta": "Verified Buyer" } },
        { "type": "review", "settings": { "rating": 5, "text": "Best purchase I have made this year. Highly recommended!", "author": "Ananya K.", "meta": "Verified Buyer" } }
      ]
    }
  ]
}
{% endschema %}
