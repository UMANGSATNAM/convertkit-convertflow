{% comment %}ConvertFlow - Organic Food Landing | FarmFresh style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
<style>
.cfof{--pr:#4A7C59;--prl:#E9F2EC;--sc:#F4A261;--bg:#fff;--sf:#F9FDF9;--text:#2C3E35;--mu:#6B7D73;--bd:#E2E8E4;}
.cfof *{box-sizing:border-box;margin:0;padding:0;}
.cfof{background:var(--bg);color:var(--text);font-family:'Public Sans',sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased;}
.cfof h1,.cfof h2,.cfof h3{font-family:'Playfair Display',serif;}
.cfof-promo{background:var(--pr);color:#fff;padding:8px 20px;text-align:center;font-size:13px;font-weight:500;}
.cfof-promo strong{color:#FFE082;}
.cfof-hdr{padding:20px 60px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--bd);}
.cfof-brand{font-family:'Playfair Display',serif;font-size:32px;font-weight:600;color:var(--pr);text-decoration:none;}
.cfof-search{display:flex;align-items:center;background:var(--sf);border:1px solid var(--bd);border-radius:40px;padding:6px 6px 6px 20px;width:400px;}
.cfof-search input{border:none;background:transparent;outline:none;flex-grow:1;font-family:'Public Sans',sans-serif;color:var(--text);}
.cfof-search button{background:var(--pr);color:#fff;border:none;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;}
.cfof-hact{display:flex;gap:24px;align-items:center;}
.cfof-hact a{display:flex;flex-direction:column;align-items:center;color:var(--text);text-decoration:none;font-size:12px;font-weight:500;transition:color .2s;}
.cfof-hact a:hover{color:var(--pr);}
.cfof-hact a svg{width:22px;height:22px;margin-bottom:4px;}
.cfof-hero{background:linear-gradient(to right,var(--sf) 60%,var(--prl) 100%);display:grid;grid-template-columns:1fr 1fr;min-height:80vh;padding:0 60px;align-items:center;gap:60px;border-bottom:1px solid var(--bd);}
.cfof-h-tag{display:inline-flex;align-items:center;gap:8px;background:var(--prl);color:var(--pr);padding:6px 16px;border-radius:100px;font-size:12px;font-weight:700;letter-spacing:.5px;margin-bottom:20px;}
.cfof-hero h1{font-size:60px;line-height:1.1;color:var(--text);margin-bottom:20px;}
.cfof-hero h1 em{font-style:italic;color:var(--pr);}
.cfof-hero>div>p{font-size:17px;color:var(--mu);line-height:1.8;max-width:440px;margin-bottom:36px;}
.cfof-btns{display:flex;gap:12px;}
.cfof-btn-pr{background:var(--pr);color:#fff;padding:16px 36px;border-radius:8px;font-size:14px;font-weight:700;text-decoration:none;transition:background .2s;}
.cfof-btn-pr:hover{background:#3B6B48;}
.cfof-btn-out{background:transparent;color:var(--pr);border:2px solid var(--pr);padding:14px 36px;border-radius:8px;font-size:14px;font-weight:700;text-decoration:none;transition:all .2s;}
.cfof-btn-out:hover{background:var(--pr);color:#fff;}
.cfof-trust{display:flex;gap:24px;margin-top:36px;}
.cfof-tb{display:flex;align-items:center;gap:8px;background:var(--prl);padding:8px 16px;border-radius:100px;font-size:12px;font-weight:600;color:var(--pr);}
.cfof-hero-img{display:flex;align-items:center;justify-content:center;position:relative;}
.cfof-hero-circle{width:420px;height:420px;border-radius:50%;background:linear-gradient(135deg,#c8e6d0,#a8d5b5);display:flex;align-items:center;justify-content:center;}
.cfof-hero-circle svg{width:55%;color:var(--pr);opacity:.4;}
.cfof-cats{padding:80px 60px;max-width:1400px;margin:0 auto;}
.cfof-sh{text-align:center;margin-bottom:50px;}
.cfof-sh h2{font-size:44px;color:var(--text);margin-bottom:12px;}
.cfof-sh p{font-size:16px;color:var(--mu);max-width:480px;margin:0 auto;}
.cfof-cat-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:20px;}
.cfof-cat{background:var(--sf);border:1px solid var(--bd);border-radius:16px;padding:28px 20px;text-align:center;text-decoration:none;color:var(--text);transition:all .3s;}
.cfof-cat:hover{border-color:var(--pr);transform:translateY(-4px);}
.cfof-cat-emoji{font-size:40px;margin-bottom:12px;display:block;}
.cfof-cat-name{font-family:'Playfair Display',serif;font-size:16px;font-weight:600;margin-bottom:4px;}
.cfof-cat-count{font-size:12px;color:var(--mu);}
.cfof-prods{padding:0 60px 80px;max-width:1400px;margin:0 auto;}
.cfof-ph{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:40px;}
.cfof-ph h2{font-size:40px;color:var(--text);}
.cfof-ph a{font-size:13px;font-weight:700;color:var(--pr);text-decoration:none;}
.cfof-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}
.cfof-card{background:var(--sf);border:1px solid var(--bd);border-radius:16px;overflow:hidden;transition:all .3s;}
.cfof-card:hover{box-shadow:0 12px 40px rgba(74,124,89,.1);transform:translateY(-4px);}
.cfof-card-img{aspect-ratio:1;background:var(--prl);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.cfof-card-img img{width:100%;height:100%;object-fit:cover;}
.cfof-card-img svg{width:40%;color:var(--pr);opacity:.3;}
.cfof-organic-badge{position:absolute;top:12px;left:12px;background:var(--pr);color:#fff;font-size:9px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:4px 10px;border-radius:100px;}
.cfof-card-body{padding:20px;}
.cfof-card-cat{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--pr);margin-bottom:6px;}
.cfof-card-name{font-family:'Playfair Display',serif;font-size:18px;font-weight:600;margin-bottom:8px;color:var(--text);}
.cfof-card-origin{font-size:12px;color:var(--mu);margin-bottom:14px;}
.cfof-card-foot{display:flex;justify-content:space-between;align-items:center;}
.cfof-card-price{font-size:20px;font-weight:700;color:var(--text);}
.cfof-card-old{font-size:13px;color:var(--mu);text-decoration:line-through;margin-left:6px;}
.cfof-atc{background:var(--pr);color:#fff;border:none;padding:10px 20px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;font-family:'Public Sans',sans-serif;transition:background .2s;}
.cfof-atc:hover{background:#3B6B48;}
.cfof-banner{background:var(--pr);padding:80px 60px;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;}
.cfof-banner h2{font-size:44px;color:#fff;margin-bottom:20px;}
.cfof-banner p{font-size:16px;color:rgba(255,255,255,.7);line-height:1.8;margin-bottom:36px;}
.cfof-btn-wh{background:#fff;color:var(--pr);padding:16px 36px;font-size:14px;font-weight:700;border-radius:8px;text-decoration:none;transition:all .2s;}
.cfof-btn-wh:hover{background:var(--prl);}
.cfof-banner-right{background:rgba(255,255,255,.1);border-radius:16px;padding:40px;border:1px solid rgba(255,255,255,.2);}
.cfof-banner-right h3{font-size:22px;color:#fff;margin-bottom:20px;}
.cfof-form{display:flex;flex-direction:column;gap:12px;}
.cfof-form input{border:none;padding:14px 20px;border-radius:8px;font-family:'Public Sans',sans-serif;font-size:15px;outline:none;}
.cfof-form button{background:var(--sc);color:#fff;border:none;padding:16px;border-radius:8px;font-family:'Public Sans',sans-serif;font-size:14px;font-weight:700;cursor:pointer;transition:opacity .2s;}
.cfof-form button:hover{opacity:.85;}
.cfof-footer{padding:80px 60px 40px;border-top:1px solid var(--bd);}
.cfof-fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;padding-bottom:60px;border-bottom:1px solid var(--bd);}
.cfof-fb h3{font-family:'Playfair Display',serif;font-size:28px;color:var(--pr);margin-bottom:16px;}
.cfof-fb p{font-size:13px;color:var(--mu);line-height:1.9;max-width:260px;}
.cfof-fc h4{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--mu);margin-bottom:20px;}
.cfof-fc ul{list-style:none;}
.cfof-fc li{margin-bottom:10px;}
.cfof-fc a{color:var(--text);text-decoration:none;font-size:14px;transition:color .2s;}
.cfof-fc a:hover{color:var(--pr);}
.cfof-fbot{display:flex;justify-content:space-between;padding-top:28px;font-size:11px;color:var(--mu);}
@media(max-width:1024px){.cfof-hero{grid-template-columns:1fr;min-height:auto}.cfof-hero-img{display:none}.cfof-cat-grid{grid-template-columns:repeat(3,1fr)}.cfof-grid{grid-template-columns:repeat(2,1fr)}.cfof-banner{grid-template-columns:1fr}.cfof-fg{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cfof-hdr{padding:16px 20px}.cfof-search{display:none}.cfof-hero{padding:60px 20px}.cfof-hero h1{font-size:40px}.cfof-cats,.cfof-prods{padding:60px 20px}.cfof-cat-grid{grid-template-columns:repeat(2,1fr)}.cfof-grid{grid-template-columns:1fr}.cfof-banner{padding:60px 20px}.cfof-fg{grid-template-columns:1fr;gap:40px}.cfof-footer{padding:60px 20px 30px}}
</style>
<div class="cfof">
  <div class="cfof-promo">{{ section.settings.promo_text | default: '🌿 Free delivery on orders above ₹499 &nbsp;·&nbsp; <strong>Use ORGANIC10 for 10% off!</strong>' }}</div>
  <header class="cfof-hdr">
    <a href="{{ routes.root_url }}" class="cfof-brand">{{ section.settings.brand_name | default: 'FarmFresh' }}</a>
    <div class="cfof-search"><input type="text" placeholder="Search organic products..."><button><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="16"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button></div>
    <div class="cfof-hact"><a href="{{ routes.cart_url }}"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>Cart</a></div>
  </header>
  <section class="cfof-hero">
    <div>
      <div class="cfof-h-tag">🌱 {{ section.settings.hero_tag | default: '100% Certified Organic' }}</div>
      <h1>{{ section.settings.hero_h1 | default: 'Fresh from <em>Farm to Table</em>' }}</h1>
      <p>{{ section.settings.hero_sub | default: 'Premium organic groceries sourced directly from certified farms. No pesticides. No preservatives. Just pure goodness delivered to your door.' }}</p>
      <div class="cfof-btns">
        <a href="{{ section.settings.cta1_url | default: routes.collections_url }}" class="cfof-btn-pr">{{ section.settings.cta1_text | default: 'Shop Fresh Now' }}</a>
        <a href="{{ section.settings.cta2_url | default: '#' }}" class="cfof-btn-out">{{ section.settings.cta2_text | default: 'View Categories' }}</a>
      </div>
      <div class="cfof-trust"><span class="cfof-tb">✓ FSSAI Certified</span><span class="cfof-tb">✓ Farm Fresh</span><span class="cfof-tb">✓ No Chemicals</span></div>
    </div>
    <div class="cfof-hero-img"><div class="cfof-hero-circle"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.8"><path d="M12 2a10 10 0 0 1 10 10 10 10 0 0 1-10 10A10 10 0 0 1 2 12 10 10 0 0 1 12 2z"/><path d="M12 6v6l4 2"/></svg></div></div>
  </section>
  <section class="cfof-cats">
    <div class="cfof-sh"><h2>Shop by Category</h2><p>Explore our wide range of certified organic products.</p></div>
    <div class="cfof-cat-grid">
      <a href="#" class="cfof-cat"><span class="cfof-cat-emoji">🥦</span><div class="cfof-cat-name">Vegetables</div><div class="cfof-cat-count">80+ items</div></a>
      <a href="#" class="cfof-cat"><span class="cfof-cat-emoji">🍎</span><div class="cfof-cat-name">Fruits</div><div class="cfof-cat-count">60+ items</div></a>
      <a href="#" class="cfof-cat"><span class="cfof-cat-emoji">🌾</span><div class="cfof-cat-name">Grains & Pulses</div><div class="cfof-cat-count">100+ items</div></a>
      <a href="#" class="cfof-cat"><span class="cfof-cat-emoji">🥛</span><div class="cfof-cat-name">Dairy & Eggs</div><div class="cfof-cat-count">30+ items</div></a>
      <a href="#" class="cfof-cat"><span class="cfof-cat-emoji">🍵</span><div class="cfof-cat-name">Teas & Spices</div><div class="cfof-cat-count">50+ items</div></a>
    </div>
  </section>
  <section class="cfof-prods">
    <div class="cfof-ph"><h2>Today's Fresh Picks</h2><a href="{{ routes.collections_url }}">View All →</a></div>
    <div class="cfof-grid">
      {% assign col = collections[section.settings.featured_collection] %}
      {% if col and col.products.size > 0 %}
        {% for p in col.products limit: 4 %}
          <div class="cfof-card">
            <div class="cfof-card-img">{% if p.featured_image %}<img src="{{ p.featured_image | img_url: '400x' }}" alt="{{ p.title }}">{% else %}<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1" opacity="0.4"><path d="M12 2a10 10 0 0 1 10 10"/></svg>{% endif %}<span class="cfof-organic-badge">Organic</span></div>
            <div class="cfof-card-body"><div class="cfof-card-cat">{{ p.type | default: 'Fresh' }}</div><div class="cfof-card-name">{{ p.title }}</div><div class="cfof-card-origin">{{ p.vendor | default: 'Certified Farm' }}</div><div class="cfof-card-foot"><div class="cfof-card-price">{{ p.price | money }}{% if p.compare_at_price > p.price %}<span class="cfof-card-old">{{ p.compare_at_price | money }}</span>{% endif %}</div><button class="cfof-atc" data-variant-id="{{ p.variants.first.id }}">Add to Cart</button></div></div>
          </div>
        {% endfor %}
      {% else %}
        <div class="cfof-card"><div class="cfof-card-img" style="background:#dcedc8;"><span class="cfof-organic-badge">Organic</span></div><div class="cfof-card-body"><div class="cfof-card-cat">Vegetables</div><div class="cfof-card-name">Baby Spinach — Farm Fresh</div><div class="cfof-card-origin">✓ Gujarat Certified Farm</div><div class="cfof-card-foot"><div class="cfof-card-price">&#8377;149<span class="cfof-card-old">&#8377;199</span></div><button class="cfof-atc">Add to Cart</button></div></div></div>
        <div class="cfof-card"><div class="cfof-card-img" style="background:#fff9c4;"><span class="cfof-organic-badge">Organic</span></div><div class="cfof-card-body"><div class="cfof-card-cat">Fruits</div><div class="cfof-card-name">Alphonso Mangoes (1kg)</div><div class="cfof-card-origin">✓ Ratnagiri Certified Farm</div><div class="cfof-card-foot"><div class="cfof-card-price">&#8377;399</div><button class="cfof-atc">Add to Cart</button></div></div></div>
        <div class="cfof-card"><div class="cfof-card-img" style="background:#ffe0b2;"><span class="cfof-organic-badge">Organic</span></div><div class="cfof-card-body"><div class="cfof-card-cat">Grains</div><div class="cfof-card-name">Brown Basmati Rice (5kg)</div><div class="cfof-card-origin">✓ Punjab Certified Farm</div><div class="cfof-card-foot"><div class="cfof-card-price">&#8377;699<span class="cfof-card-old">&#8377;849</span></div><button class="cfof-atc">Add to Cart</button></div></div></div>
        <div class="cfof-card"><div class="cfof-card-img" style="background:#f3e5f5;"><span class="cfof-organic-badge">Organic</span></div><div class="cfof-card-body"><div class="cfof-card-cat">Dairy</div><div class="cfof-card-name">A2 Cow Ghee — Small Batch</div><div class="cfof-card-origin">✓ Rajasthan Certified Farm</div><div class="cfof-card-foot"><div class="cfof-card-price">&#8377;1,299</div><button class="cfof-atc">Add to Cart</button></div></div></div>
      {% endif %}
    </div>
  </section>
  <div class="cfof-banner">
    <div>
      <h2>Subscribe &amp; Save 15%</h2>
      <p>{{ section.settings.sub_text | default: 'Get weekly deliveries of your favourite organic produce at a special subscription rate. Cancel anytime.' }}</p>
      <a href="#" class="cfof-btn-wh">Start Your Subscription</a>
    </div>
    <div class="cfof-banner-right">
      <h3>Join Our Newsletter</h3>
      <form class="cfof-form"><input type="email" placeholder="Your email address"><button type="submit">Get Fresh Updates</button></form>
    </div>
  </div>
  <footer class="cfof-footer">
    <div class="cfof-fg">
      <div class="cfof-fb"><h3>{{ section.settings.brand_name | default: 'FarmFresh' }}</h3><p>Bringing certified organic goodness from farm to your table since 2018.</p></div>
      <div class="cfof-fc"><h4>Shop</h4><ul><li><a href="#">Vegetables</a></li><li><a href="#">Fruits</a></li><li><a href="#">Grains</a></li><li><a href="#">Dairy</a></li></ul></div>
      <div class="cfof-fc"><h4>Company</h4><ul><li><a href="#">Our Farms</a></li><li><a href="#">Certifications</a></li><li><a href="#">Blog</a></li></ul></div>
      <div class="cfof-fc"><h4>Support</h4><ul><li><a href="#">Track Order</a></li><li><a href="#">Returns</a></li><li><a href="#">FAQ</a></li><li><a href="#">Contact</a></li></ul></div>
    </div>
    <div class="cfof-fbot"><span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'FarmFresh' }}.</span><span>Privacy &middot; Terms</span></div>
  </footer>
</div>
{% schema %}
{
  "name": "Organic Food Landing",
  "settings": [
    {"type":"text","id":"brand_name","label":"Brand Name","default":"FarmFresh"},
    {"type":"text","id":"promo_text","label":"Promo Bar","default":"🌿 Free delivery on orders above ₹499 · Use ORGANIC10 for 10% off!"},
    {"type":"text","id":"hero_tag","label":"Hero Tag","default":"100% Certified Organic"},
    {"type":"textarea","id":"hero_h1","label":"Hero Heading","default":"Fresh from Farm to Table"},
    {"type":"textarea","id":"hero_sub","label":"Hero Subtext","default":"Premium organic groceries sourced directly from certified farms."},
    {"type":"text","id":"cta1_text","label":"CTA 1 Text","default":"Shop Fresh Now"},
    {"type":"url","id":"cta1_url","label":"CTA 1 URL"},
    {"type":"text","id":"cta2_text","label":"CTA 2 Text","default":"View Categories"},
    {"type":"url","id":"cta2_url","label":"CTA 2 URL"},
    {"type":"collection","id":"featured_collection","label":"Featured Collection"},
    {"type":"textarea","id":"sub_text","label":"Subscription Section Text","default":"Get weekly deliveries of your favourite organic produce at a special subscription rate."}
  ],
  "presets": [{"name":"Organic Food Landing"}]
}
{% endschema %}