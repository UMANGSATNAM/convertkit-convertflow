{% schema %}
{
  "name": "CF Baby Apparel Coll",
  "settings": [
    {
      "type": "header",
      "content": "Brand Colors"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent Color",
      "default": "#F6A8B6"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Background",
      "default": "#fcedef"
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show Collection Banner",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Background Image"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "grid_cols",
      "label": "Products per Row (Desktop)",
      "min": 2,
