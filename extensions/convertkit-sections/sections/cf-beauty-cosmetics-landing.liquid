{% comment %}ConvertFlow - Beauty Cosmetics Landing | AURA style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Tenor+Sans&display=swap" rel="stylesheet">
<style>
.cfbc{--pr:#544941;--sc:#D4BBA5;--bg:#FAFAF8;--sf:#fff;--text:#333;--mu:#8A8582;--bd:#E8E5E1;--sh1:#F5EAE1;--sh2:#E1CABB;--sh3:#C29A83;--sh4:#8C5C41;}
.cfbc *{box-sizing:border-box;margin:0;padding:0;}
.cfbc{background:var(--bg);color:var(--text);font-family:'Jost',sans-serif;font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased;}
.cfbc h1,.cfbc h2,.cfbc h3,.cfbc-logo{font-family:'Tenor Sans',sans-serif;font-weight:normal;}
.cfbc-promo{background:var(--pr);color:#fff;text-align:center;padding:12px;font-size:12px;letter-spacing:2px;text-transform:uppercase;}
.cfbc-header{background:rgba(250,250,248,.9);backdrop-filter:blur(10px);padding:20px 60px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid rgba(232,229,225,.5);position:sticky;top:0;z-index:100;}
.cfbc-nav-left{display:flex;gap:32px;list-style:none;}
.cfbc-nav-left a{font-size:13px;font-weight:400;color:var(--mu);text-decoration:none;letter-spacing:.5px;transition:color .2s;}
.cfbc-nav-left a:hover{color:var(--text);}
.cfbc-logo{font-size:24px;letter-spacing:6px;text-align:center;text-decoration:none;color:var(--text);}
.cfbc-nav-right{display:flex;gap:20px;justify-content:flex-end;align-items:center;}
.cfbc-nav-right a{font-size:13px;color:var(--mu);text-decoration:none;letter-spacing:.5px;transition:color .2s;}
.cfbc-nav-right a:hover{color:var(--text);}
.cfbc-hero{display:grid;grid-template-columns:1fr 1fr;min-height:90vh;border-bottom:1px solid var(--bd);}
.cfbc-hl{padding:80px 60px;display:flex;flex-direction:column;justify-content:center;border-right:1px solid var(--bd);}
.cfbc-h-kicker{font-size:11px;letter-spacing:4px;text-transform:uppercase;color:var(--mu);margin-bottom:30px;display:flex;align-items:center;gap:12px;}
.cfbc-h-kicker::before{content:'';width:40px;height:1px;background:var(--sc);}
.cfbc-hero h1{font-size:clamp(52px,5vw,72px);line-height:1.1;margin-bottom:28px;color:var(--text);}
.cfbc-hero h1 em{font-style:italic;color:var(--sh4);}
.cfbc-hero>div>p{font-size:16px;color:var(--mu);line-height:1.9;max-width:440px;margin-bottom:44px;font-weight:300;}
.cfbc-btns{display:flex;gap:16px;align-items:center;}
.cfbc-btn-pr{background:var(--pr);color:#fff;padding:16px 44px;font-size:12px;font-weight:500;letter-spacing:3px;text-transform:uppercase;text-decoration:none;transition:background .3s;}
.cfbc-btn-pr:hover{background:var(--sh4);}
.cfbc-btn-out{color:var(--text);font-size:12px;letter-spacing:2px;text-transform:uppercase;text-decoration:none;border-bottom:1px solid var(--bd);padding-bottom:2px;transition:border-color .2s;}
.cfbc-btn-out:hover{border-color:var(--pr);}
.cfbc-hero-stats{display:flex;gap:40px;margin-top:52px;padding-top:40px;border-top:1px solid var(--bd);}
.cfbc-stat strong{font-family:'Tenor Sans',sans-serif;font-size:28px;display:block;color:var(--text);}
.cfbc-stat span{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--mu);display:block;margin-top:4px;}
.cfbc-hr{background:var(--sh1);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.cfbc-hr-circle{width:420px;height:520px;border-radius:50% 50% 40% 40%;background:linear-gradient(180deg,var(--sh2) 0%,var(--sh3) 100%);display:flex;align-items:center;justify-content:center;}
.cfbc-hr-circle svg{width:45%;color:var(--pr);opacity:.15;}
.cfbc-shade-strip{background:linear-gradient(to right,var(--sh1),var(--sh2),var(--sh3),var(--sh4),var(--pr));padding:20px 60px;display:flex;align-items:center;justify-content:space-between;}
.cfbc-shade-label{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#fff;}
.cfbc-shade-dots{display:flex;gap:12px;}
.cfbc-dot{width:36px;height:36px;border-radius:50%;border:2px solid rgba(255,255,255,.5);cursor:pointer;transition:transform .2s;}
.cfbc-dot:hover{transform:scale(1.15);}
.cfbc-cats{padding:80px 60px;max-width:1400px;margin:0 auto;}
.cfbc-sh{text-align:center;margin-bottom:60px;}
.cfbc-sh h2{font-size:44px;margin-bottom:12px;}
.cfbc-sh p{font-size:16px;color:var(--mu);max-width:480px;margin:0 auto;}
.cfbc-cat-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:20px;}
.cfbc-cat{background:var(--sf);border:1px solid var(--bd);padding:28px 20px;text-align:center;text-decoration:none;color:var(--text);transition:all .3s;}
.cfbc-cat:hover{border-color:var(--pr);background:var(--sh1);}
.cfbc-cat-icon{font-size:32px;display:block;margin-bottom:14px;}
.cfbc-cat-name{font-family:'Tenor Sans',sans-serif;font-size:16px;margin-bottom:4px;}
.cfbc-cat-count{font-size:12px;color:var(--mu);}
.cfbc-prods{padding:0 60px 100px;max-width:1400px;margin:0 auto;}
.cfbc-ph{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:50px;border-bottom:1px solid var(--bd);padding-bottom:20px;}
.cfbc-ph h2{font-size:44px;}
.cfbc-ph a{font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--pr);text-decoration:none;}
.cfbc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;}
.cfbc-card{background:var(--sf);border:1px solid var(--bd);overflow:hidden;transition:all .3s;}
.cfbc-card:hover{box-shadow:0 20px 60px rgba(84,73,65,.1);}
.cfbc-card-img{aspect-ratio:3/4;background:var(--sh1);display:flex;align-items:center;justify-content:center;position:relative;}
.cfbc-card-img img{width:100%;height:100%;object-fit:cover;}
.cfbc-card-img svg{width:35%;color:var(--sh4);opacity:.2;}
.cfbc-card-shade{position:absolute;bottom:0;left:0;right:0;height:4px;background:linear-gradient(to right,var(--sh2),var(--sh4));}
.cfbc-card-tag{position:absolute;top:12px;left:12px;background:var(--pr);color:#fff;font-size:9px;letter-spacing:2px;text-transform:uppercase;padding:5px 12px;}
.cfbc-card-body{padding:24px;}
.cfbc-card-cat{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--sh4);margin-bottom:8px;font-weight:500;}
.cfbc-card-name{font-family:'Tenor Sans',sans-serif;font-size:20px;margin-bottom:6px;color:var(--text);}
.cfbc-card-desc{font-size:13px;color:var(--mu);margin-bottom:20px;line-height:1.7;}
.cfbc-card-foot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--bd);padding-top:18px;}
.cfbc-card-price{font-family:'Tenor Sans',sans-serif;font-size:22px;}
.cfbc-card-old{font-size:13px;color:var(--mu);text-decoration:line-through;margin-left:8px;}
.cfbc-atc{background:var(--pr);color:#fff;border:none;padding:12px 24px;font-size:11px;letter-spacing:2px;text-transform:uppercase;cursor:pointer;font-family:'Jost',sans-serif;transition:background .2s;}
.cfbc-atc:hover{background:var(--sh4);}
.cfbc-story{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--bd);border-bottom:1px solid var(--bd);}
.cfbc-st-text{padding:100px 60px;display:flex;flex-direction:column;justify-content:center;}
.cfbc-st-text h2{font-size:48px;margin-bottom:24px;line-height:1.1;}
.cfbc-st-text h2 em{font-style:italic;color:var(--sh4);}
.cfbc-st-text p{font-size:16px;color:var(--mu);line-height:1.9;margin-bottom:36px;font-weight:300;max-width:440px;}
.cfbc-st-img{background:var(--sh1);border-left:1px solid var(--bd);display:flex;align-items:center;justify-content:center;}
.cfbc-st-img svg{width:35%;color:var(--sh4);opacity:.2;}
.cfbc-footer{padding:80px 60px 40px;border-top:1px solid var(--bd);}
.cfbc-fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;padding-bottom:60px;border-bottom:1px solid var(--bd);}
.cfbc-fb h3{font-family:'Tenor Sans',sans-serif;font-size:24px;letter-spacing:4px;color:var(--pr);margin-bottom:16px;}
.cfbc-fb p{font-size:13px;color:var(--mu);line-height:1.9;max-width:260px;}
.cfbc-fc h4{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--mu);margin-bottom:20px;font-weight:500;}
.cfbc-fc ul{list-style:none;}
.cfbc-fc li{margin-bottom:10px;}
.cfbc-fc a{color:var(--text);text-decoration:none;font-size:13px;opacity:.65;transition:opacity .2s;}
.cfbc-fc a:hover{opacity:1;color:var(--pr);}
.cfbc-fbot{display:flex;justify-content:space-between;padding-top:28px;font-size:11px;color:var(--mu);letter-spacing:1px;}
@media(max-width:1024px){.cfbc-header{grid-template-columns:auto 1fr}.cfbc-nav-left{display:none}.cfbc-logo{text-align:left}.cfbc-hero{grid-template-columns:1fr}.cfbc-hr{display:none}.cfbc-cat-grid{grid-template-columns:repeat(3,1fr)}.cfbc-grid{grid-template-columns:repeat(2,1fr)}.cfbc-story{grid-template-columns:1fr}.cfbc-st-img{display:none}.cfbc-fg{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cfbc-header{padding:16px 20px}.cfbc-hl{padding:60px 20px}.cfbc-hero h1{font-size:44px}.cfbc-cats,.cfbc-prods{padding:60px 20px}.cfbc-cat-grid{grid-template-columns:repeat(2,1fr)}.cfbc-grid{grid-template-columns:1fr}.cfbc-shade-strip{padding:20px}.cfbc-st-text{padding:60px 20px}.cfbc-fg{grid-template-columns:1fr;gap:40px}.cfbc-footer{padding:60px 20px 30px}}
</style>
<div class="cfbc">
  <div class="cfbc-promo">{{ section.settings.promo_text | default: 'Complimentary gift wrapping on all orders · Free shipping above ₹799' }}</div>
  <header class="cfbc-header">
    <ul class="cfbc-nav-left"><li><a href="#">Collections</a></li><li><a href="#">Ingredients</a></li><li><a href="#">Rituals</a></li></ul>
    <a href="{{ routes.root_url }}" class="cfbc-logo">{{ section.settings.brand_name | default: 'AURA' }}</a>
    <div class="cfbc-nav-right"><a href="#">Stores</a><a href="{{ routes.cart_url }}">Bag ({{ cart.item_count }})</a></div>
  </header>
  <section class="cfbc-hero">
    <div class="cfbc-hl">
      <div class="cfbc-h-kicker">{{ section.settings.hero_kicker | default: 'Conscious Beauty' }}</div>
      <h1>{{ section.settings.hero_h1 | default: 'Beauty in its <em>Purest</em> Form.' }}</h1>
      <p>{{ section.settings.hero_sub | default: 'Conscious cosmetics crafted for every skin tone. Clean ingredients, luxurious textures, and shades that celebrate your unique beauty.' }}</p>
      <div class="cfbc-btns">
        <a href="{{ section.settings.cta1_url | default: routes.collections_url }}" class="cfbc-btn-pr">{{ section.settings.cta1_text | default: 'Explore Collection' }}</a>
        <a href="{{ section.settings.cta2_url | default: '#' }}" class="cfbc-btn-out">{{ section.settings.cta2_text | default: 'Find Your Shade' }}</a>
      </div>
      <div class="cfbc-hero-stats">
        <div class="cfbc-stat"><strong>50+</strong><span>Shade Range</span></div>
        <div class="cfbc-stat"><strong>100%</strong><span>Clean Formula</span></div>
        <div class="cfbc-stat"><strong>4.9★</strong><span>Avg Rating</span></div>
      </div>
    </div>
    <div class="cfbc-hr"><div class="cfbc-hr-circle"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div></div>
  </section>
  <div class="cfbc-shade-strip">
    <span class="cfbc-shade-label">Explore Our Shades</span>
    <div class="cfbc-shade-dots">
      <div class="cfbc-dot" style="background:var(--sh1);"></div>
      <div class="cfbc-dot" style="background:var(--sh2);"></div>
      <div class="cfbc-dot" style="background:var(--sh3);"></div>
      <div class="cfbc-dot" style="background:var(--sh4);"></div>
      <div class="cfbc-dot" style="background:var(--pr);"></div>
    </div>
    <a href="#" style="font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#fff;text-decoration:none;">Find Your Shade &rarr;</a>
  </div>
  <section class="cfbc-cats">
    <div class="cfbc-sh"><h2>Shop by Category</h2><p>From skincare to colour — beauty for every ritual.</p></div>
    <div class="cfbc-cat-grid">
      <a href="#" class="cfbc-cat"><span class="cfbc-cat-icon">💄</span><div class="cfbc-cat-name">Lip</div><div class="cfbc-cat-count">60+ shades</div></a>
      <a href="#" class="cfbc-cat"><span class="cfbc-cat-icon">👁</span><div class="cfbc-cat-name">Eyes</div><div class="cfbc-cat-count">80+ products</div></a>
      <a href="#" class="cfbc-cat"><span class="cfbc-cat-icon">✨</span><div class="cfbc-cat-name">Foundation</div><div class="cfbc-cat-count">50+ shades</div></a>
      <a href="#" class="cfbc-cat"><span class="cfbc-cat-icon">🌿</span><div class="cfbc-cat-name">Skincare</div><div class="cfbc-cat-count">40+ products</div></a>
      <a href="#" class="cfbc-cat"><span class="cfbc-cat-icon">🎁</span><div class="cfbc-cat-name">Gift Sets</div><div class="cfbc-cat-count">20+ sets</div></a>
    </div>
  </section>
  <section class="cfbc-prods">
    <div class="cfbc-ph"><h2>Bestsellers</h2><a href="{{ routes.collections_url }}">View All &rarr;</a></div>
    <div class="cfbc-grid">
      {% assign col = collections[section.settings.featured_collection] %}
      {% if col and col.products.size > 0 %}
        {% for p in col.products limit: 4 %}
          <div class="cfbc-card">
            <div class="cfbc-card-img">{% if p.featured_image %}<img src="{{ p.featured_image | img_url: '600x' }}" alt="{{ p.title }}">{% else %}<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.5"><circle cx="12" cy="12" r="10"/></svg>{% endif %}<div class="cfbc-card-shade"></div>{% if p.compare_at_price > p.price %}<span class="cfbc-card-tag">Sale</span>{% endif %}</div>
            <div class="cfbc-card-body"><div class="cfbc-card-cat">{{ p.type | default: 'Beauty' }}</div><div class="cfbc-card-name">{{ p.title }}</div><div class="cfbc-card-desc">{{ p.description | strip_html | truncate: 70 }}</div><div class="cfbc-card-foot"><div class="cfbc-card-price">{{ p.price | money }}{% if p.compare_at_price > p.price %}<span class="cfbc-card-old">{{ p.compare_at_price | money }}</span>{% endif %}</div><button class="cfbc-atc" data-variant-id="{{ p.variants.first.id }}">Add to Bag</button></div></div>
          </div>
        {% endfor %}
      {% else %}
        <div class="cfbc-card"><div class="cfbc-card-img" style="background:var(--sh1);"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.5"><circle cx="12" cy="12" r="10"/></svg><div class="cfbc-card-shade"></div><span class="cfbc-card-tag">Bestseller</span></div><div class="cfbc-card-body"><div class="cfbc-card-cat">Foundation</div><div class="cfbc-card-name">Skin Veil Serum Foundation</div><div class="cfbc-card-desc">Buildable coverage. 50 shades. Breathable, skin-loving finish.</div><div class="cfbc-card-foot"><div class="cfbc-card-price">&#8377;1,899<span class="cfbc-card-old">&#8377;2,499</span></div><button class="cfbc-atc">Add to Bag</button></div></div></div>
        <div class="cfbc-card"><div class="cfbc-card-img" style="background:var(--sh2);"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.5"><path d="M12 2a7 7 0 0 1 7 7"/></svg><div class="cfbc-card-shade"></div></div><div class="cfbc-card-body"><div class="cfbc-card-cat">Lip</div><div class="cfbc-card-name">Velvet Matte Liquid Lip</div><div class="cfbc-card-desc">Long-wear, non-drying formula in 40 curated shades.</div><div class="cfbc-card-foot"><div class="cfbc-card-price">&#8377;999</div><button class="cfbc-atc">Add to Bag</button></div></div></div>
        <div class="cfbc-card"><div class="cfbc-card-img" style="background:var(--sh1);"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.5"><rect x="3" y="3" width="18" height="18" rx="2"/></svg><div class="cfbc-card-shade"></div></div><div class="cfbc-card-body"><div class="cfbc-card-cat">Eyes</div><div class="cfbc-card-name">Radiance Eyeshadow Palette</div><div class="cfbc-card-desc">20 neutral-warm shades with matte, shimmer &amp; foil finishes.</div><div class="cfbc-card-foot"><div class="cfbc-card-price">&#8377;2,499<span class="cfbc-card-old">&#8377;2,999</span></div><button class="cfbc-atc">Add to Bag</button></div></div></div>
        <div class="cfbc-card"><div class="cfbc-card-img" style="background:var(--sh1);"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.5"><circle cx="12" cy="12" r="10"/></svg><div class="cfbc-card-shade"></div><span class="cfbc-card-tag">New</span></div><div class="cfbc-card-body"><div class="cfbc-card-cat">Skincare</div><div class="cfbc-card-name">Bakuchiol Youth Renewal Serum</div><div class="cfbc-card-desc">Natural retinol alternative. Clinically proven to reduce fine lines.</div><div class="cfbc-card-foot"><div class="cfbc-card-price">&#8377;1,699</div><button class="cfbc-atc">Add to Bag</button></div></div></div>
      {% endif %}
    </div>
  </section>
  <section class="cfbc-story">
    <div class="cfbc-st-text">
      <h2>Conscious Beauty,<br><em>Consciously Made.</em></h2>
      <p>{{ section.settings.story_text | default: 'We believe beauty should be clean, inclusive, and kind to the planet. Every AURA formula is crafted with non-toxic ingredients, ethically sourced, and rigorously tested without harm to animals.' }}</p>
      <a href="#" class="cfbc-btn-pr" style="width:max-content;">Our Conscious Commitment</a>
    </div>
    <div class="cfbc-st-img"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.4" width="200" opacity="0.3"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="4"/></svg></div>
  </section>
  <footer class="cfbc-footer">
    <div class="cfbc-fg">
      <div class="cfbc-fb"><h3>{{ section.settings.brand_name | default: 'AURA' }}</h3><p>Conscious cosmetics celebrating every shade, every skin. Clean beauty for real people.</p></div>
      <div class="cfbc-fc"><h4>Shop</h4><ul><li><a href="#">Foundation</a></li><li><a href="#">Lip</a></li><li><a href="#">Eyes</a></li><li><a href="#">Skincare</a></li></ul></div>
      <div class="cfbc-fc"><h4>Brand</h4><ul><li><a href="#">Our Story</a></li><li><a href="#">Ingredients</a></li><li><a href="#">Sustainability</a></li></ul></div>
      <div class="cfbc-fc"><h4>Support</h4><ul><li><a href="#">Shade Finder</a></li><li><a href="#">Returns</a></li><li><a href="#">Track Order</a></li><li><a href="#">Contact</a></li></ul></div>
    </div>
    <div class="cfbc-fbot"><span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'AURA' }} Conscious Beauty.</span><span>Privacy &middot; Terms</span></div>
  </footer>
</div>
{% schema %}
{
  "name": "Beauty Cosmetics Landing",
  "settings": [
    {"type":"text","id":"brand_name","label":"Brand Name","default":"AURA"},
    {"type":"text","id":"promo_text","label":"Promo Bar","default":"Complimentary gift wrapping on all orders · Free shipping above ₹799"},
    {"type":"text","id":"hero_kicker","label":"Hero Kicker","default":"Conscious Beauty"},
    {"type":"textarea","id":"hero_h1","label":"Hero Heading","default":"Beauty in its Purest Form."},
    {"type":"textarea","id":"hero_sub","label":"Hero Subtext","default":"Conscious cosmetics crafted for every skin tone. Clean ingredients, luxurious textures."},
    {"type":"text","id":"cta1_text","label":"CTA 1 Text","default":"Explore Collection"},
    {"type":"url","id":"cta1_url","label":"CTA 1 URL"},
    {"type":"text","id":"cta2_text","label":"CTA 2 Text","default":"Find Your Shade"},
    {"type":"url","id":"cta2_url","label":"CTA 2 URL"},
    {"type":"collection","id":"featured_collection","label":"Featured Collection"},
    {"type":"textarea","id":"story_text","label":"Brand Story Text","default":"We believe beauty should be clean, inclusive, and kind to the planet."}
  ],
  "presets": [{"name":"Beauty Cosmetics Landing"}]
}
{% endschema %}