<style>
.cf-org-banner-wrap {
  background: var(--bg, #FFFFFF);
  color: var(--text, #2C3E35);
  font-family: 'Public Sans', sans-serif;
  -webkit-font-smoothing: antialiased;
}
.cf-org-banner-wrap .serif { font-family: 'Playfair Display', serif; }

.farm-banner { background: var(--surface, #F9FDF9); margin: 40px auto; max-width: 1400px; border-radius: 40px; padding: 80px 60px; display: grid; grid-template-columns: 2fr 1fr; gap: 60px; align-items: center; border: 1px solid var(--border, #E2E8E4); }
.fb-content h2 { font-size: 40px; color: var(--primary, #4A7C59); margin-bottom: 20px; line-height: 1.2; }
.fb-content p { color: var(--text-muted, #6B7D73); font-size: 16px; margin-bottom: 30px; max-width: 500px; line-height: 1.6; }
.btn-outline { display: inline-flex; background: #fff; color: var(--primary, #4A7C59); border: 2px solid var(--primary, #4A7C59); padding: 16px 32px; border-radius: 40px; text-decoration: none; font-weight: 600; transition: all 0.2s; }
.btn-outline:hover { background: var(--primary, #4A7C59); color: #fff; }

.cert-logos { display: flex; gap: 24px; flex-wrap: wrap; }
.cert-logo { width: 64px; height: 64px; border-radius: 50%; background: #fff; border: 1px solid var(--border, #E2E8E4); display: flex; align-items: center; justify-content: center; }
.cert-logo svg { width: 32px; color: var(--primary, #4A7C59); }

@media(max-width: 1024px) {
  .farm-banner { grid-template-columns: 1fr; text-align: center; padding: 60px 40px; margin: 40px 20px; }
  .fb-content p { margin: 0 auto 30px; }
  .cert-logos { justify-content: center; }
}
@media(max-width: 768px) {
  .farm-banner { padding: 40px 20px; border-radius: 24px; }
  .fb-content h2 { font-size: 32px; }
}
</style>

<div class="cf-org-banner-wrap">
  <div class="farm-banner" style="{% if section.settings.bg_image != blank %}background-image:url('{{ section.settings.bg_image | image_url: width: 1400 }}');background-size:cover;background-position:center;border:none;{% endif %}">
    <div class="fb-content" {% if section.settings.bg_image != blank %}style="background:rgba(255,255,255,0.9);padding:40px;border-radius:24px;"{% endif %}>
      <h2 class="serif">{{ section.settings.heading | default: '100% Traceable. Farm to Table.' }}</h2>
      <p>{{ section.settings.text | default: 'Every product we carry can be traced back to the exact farm and field where it was grown.' }}</p>
      {% if section.settings.btn_text != blank %}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="btn-outline">{{ section.settings.btn_text }}</a>
      {% endif %}
    </div>
    <div class="cert-logos">
      {% for block in section.blocks %}
        <div class="cert-logo" title="{{ block.settings.title }}" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <img src="{{ block.settings.icon | image_url: width: 100 }}" style="width:32px;height:32px;object-fit:contain;" alt="{{ block.settings.title }}">
          {% else %}
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Organic Food Banner",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Optional Background Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "100% Traceable. Farm to Table." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every product we carry can be traced back to the exact farm and field where it was grown." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Read Our Sourcing Promise" },
    { "type": "url", "id": "btn_link", "label": "Button Link" }
  ],
  "blocks": [
    {
      "type": "certification",
      "name": "Certification Logo",
      "settings": [
        { "type": "text", "id": "title", "label": "Tooltip Title", "default": "Certified" },
        { "type": "image_picker", "id": "icon", "label": "Icon/Logo Image (Upload PNG)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Organic Food Banner",
      "blocks": [
        { "type": "certification", "settings": { "title": "USDA Organic" } },
        { "type": "certification", "settings": { "title": "Non-GMO Project" } },
        { "type": "certification", "settings": { "title": "Fair Trade" } }
      ]
    }
  ]
}
{% endschema %}
