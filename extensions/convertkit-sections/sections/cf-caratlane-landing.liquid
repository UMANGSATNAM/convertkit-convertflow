    },
    {
      "type": "text",
      "id": "feature_2",
      "label": "Feature 2",
      "default": "15 Day Money Back"
    },
    {
      "type": "text",
      "id": "feature_3",
      "label": "Feature 3",
      "default": "Lifetime Exchange"
    },
    {
      "type": "header",
      "content": "Categories & Products"
    },
    {
      "type": "text",
      "id": "cat_heading",
      "label": "Categories Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "prod_heading",
      "label": "Products Heading",
      "default": "Bestsellers"
    },
    {
      "type": "collection",
      "id": "prod_collection",
      "label": "Bestseller Collection"
    },
    {
      "type": "header",
      "content": "Footer Settings"
    },
    {
      "type": "textarea",
      "id": "footer_text",
      "label": "Footer Description",
      "default": "Crafting beautiful stories in gold and diamonds for everyday wear."
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation Link",
      "limit": 8,
      "settings": [
        {
