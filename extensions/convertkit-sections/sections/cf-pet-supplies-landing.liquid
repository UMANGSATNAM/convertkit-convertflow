{% comment %} ConvertFlow — Pet Supplies Landing | Always-Visible Playful Layout {% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Quicksand:wght@500;600;700;800&display=swap');
  .cf-pet*{box-sizing:border-box;margin:0;padding:0}
  .cf-pet{font-family:'Nunito',sans-serif;background:#FFF8F0;color:#2B2D42;overflow-x:hidden}

  :root{
    --pet-prim:{{ section.settings.color_primary | default: '#FF6B35' }};
    --pet-sec:{{ section.settings.color_secondary | default: '#FFD166' }};
  }

  /* ═══ HERO ═══ */
  .cf-pet-hero{position:relative;padding:80px 5% 120px;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;max-width:1400px;margin:0 auto;min-height:85vh}
  .cf-pet-hero-text{position:relative;z-index:2}
  .cf-pet-h1{font-family:'Quicksand',sans-serif;font-size:clamp(48px,7vw,80px);font-weight:800;line-height:1.1;color:var(--pet-prim);margin-bottom:24px}
  .cf-pet-p{font-size:20px;color:#555;font-weight:600;margin-bottom:40px;line-height:1.6}
  
  .cf-pet-btn{display:inline-block;padding:18px 40px;background:var(--pet-prim);color:#fff;font-family:'Quicksand',sans-serif;font-size:20px;font-weight:700;text-decoration:none;border-radius:50px;box-shadow:0 10px 20px rgba(255,107,53,.3);transition:all .3s}
  .cf-pet-btn:hover{transform:translateY(-4px);box-shadow:0 15px 30px rgba(255,107,53,.4)}

  .cf-pet-hero-img{position:relative}
  .cf-pet-hero-blob{aspect-ratio:1;background:var(--pet-sec);border-radius:30% 70% 70% 30% / 30% 30% 70% 70%;overflow:hidden;animation:pet-blob 8s ease-in-out infinite;box-shadow:0 20px 40px rgba(0,0,0,.05);position:relative;z-index:2}
  .cf-pet-hero-blob img{width:100%;height:100%;object-fit:cover}
  @keyframes pet-blob{0%,100%{border-radius:30% 70% 70% 30% / 30% 30% 70% 70%}50%{border-radius:70% 30% 30% 70% / 70% 70% 30% 30%}}

  .cf-pet-paw{position:absolute;color:var(--pet-prim);opacity:.15;width:80px;height:80px;z-index:1}
  .cf-pet-paw.p1{top:-30px;left:-30px;transform:rotate(-20deg)}
  .cf-pet-paw.p2{bottom:-40px;right:-40px;transform:rotate(15deg);width:120px;height:120px}

  /* ═══ VALUE BAR ═══ */
  .cf-pet-values{background:#fff;padding:60px 5%;margin:-60px auto 0;border-radius:40px;position:relative;z-index:3;max-width:1200px;box-shadow:0 10px 40px rgba(0,0,0,.04);display:flex;justify-content:space-around;flex-wrap:wrap;gap:30px}
  .cf-pet-val{display:flex;align-items:center;gap:16px}
  .cf-pet-val-icon{width:64px;height:64px;background:#FFF0EB;color:var(--pet-prim);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px}
  .cf-pet-val-text h3{font-family:'Quicksand',sans-serif;font-size:18px;font-weight:700;margin-bottom:4px}
  .cf-pet-val-text p{font-size:14px;color:#666;font-weight:600}

  /* ═══ CATEGORIES ═══ */
  .cf-pet-cats{padding:100px 5%;text-align:center}
  .cf-pet-head{margin-bottom:60px}
  .cf-pet-head h2{font-family:'Quicksand',sans-serif;font-size:clamp(36px,5vw,52px);font-weight:800;color:var(--pet-prim)}
  .cf-pet-cat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:40px;max-width:1200px;margin:0 auto}
  .cf-pet-cat{text-decoration:none;color:#2B2D42;display:block}
  .cf-pet-cat-img{aspect-ratio:1;background:#fff;border-radius:50%;padding:30px;box-shadow:0 10px 30px rgba(0,0,0,.03);margin-bottom:20px;transition:all .3s;border:4px solid transparent;overflow:hidden;position:relative}
  .cf-pet-cat-img img{width:100%;height:100%;object-fit:cover;transition:transform .4s}
  .cf-pet-cat:hover .cf-pet-cat-img{border-color:var(--pet-sec);transform:translateY(-10px);box-shadow:0 20px 40px rgba(255,209,102,.3)}
  .cf-pet-cat:hover .cf-pet-cat-img img{transform:scale(1.1)}
  .cf-pet-cat h3{font-family:'Quicksand',sans-serif;font-size:24px;font-weight:700;transition:color .3s}
  .cf-pet-cat:hover h3{color:var(--pet-prim)}

  /* ═══ PRODUCTS ═══ */
  .cf-pet-prods{padding:100px 5%;background:#fff;border-radius:60px 60px 0 0}
  .cf-pet-prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:30px;max-width:1400px;margin:0 auto}
  .cf-pet-card{background:var(--pet-bg);border-radius:30px;padding:24px;text-decoration:none;color:#2B2D42;position:relative;transition:all .3s}
  .cf-pet-card:hover{transform:translateY(-8px);box-shadow:0 20px 40px rgba(0,0,0,.06)}
  .cf-pet-card-badge{position:absolute;top:16px;left:16px;background:var(--pet-sec);font-family:'Quicksand',sans-serif;font-weight:800;font-size:13px;padding:6px 14px;border-radius:20px;z-index:2}
  .cf-pet-card-img{aspect-ratio:1;background:#fff;border-radius:20px;margin-bottom:20px;padding:20px;display:flex;align-items:center;justify-content:center}
  .cf-pet-card-img img{max-width:100%;max-height:100%;object-fit:contain}
  .cf-pet-card-title{font-family:'Nunito',sans-serif;font-size:18px;font-weight:700;margin-bottom:8px}
  .cf-pet-card-price{font-family:'Quicksand',sans-serif;font-size:24px;font-weight:800;color:var(--pet-prim)}

  @media(max-width:900px){
    .cf-pet-hero{grid-template-columns:1fr;text-align:center;padding-top:40px}
    .cf-pet-hero-text p{margin-left:auto;margin-right:auto}
    .cf-pet-values{margin-top:0;border-radius:0}
    .cf-pet-cat-grid{grid-template-columns:repeat(2,1fr);gap:20px}
    .cf-pet-prod-grid{grid-template-columns:repeat(2,1fr)}
  }
{% endstyle %}

<div class="cf-pet">

  {%- comment -%} HERO {%- endcomment -%}
  <section class="cf-pet-hero">
    <div class="cf-pet-hero-text">
      <h1 class="cf-pet-h1">{{ section.settings.hero_headline | default: 'Healthy Pets, Happy Hearts' }}</h1>
      <p class="cf-pet-p">{{ section.settings.hero_text | default: 'Premium nutrition, cozy beds, and durable toys for your furry best friends.' }}</p>
      <a href="{{ section.settings.hero_btn_url | default: '/collections/all' }}" class="cf-pet-btn">{{ section.settings.hero_btn_text | default: 'Shop Now 🐾' }}</a>
    </div>
    <div class="cf-pet-hero-img">
      <svg class="cf-pet-paw p1" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.5c-4 0-7-2.5-7-6s3-4 7-4 7 .5 7 4-3 6-7 6zm-5-10c-1.5 0-3-1.5-3-3.5s1.5-3.5 3-3.5 3 1.5 3 3.5-1.5 3.5-3 3.5zm10 0c-1.5 0-3-1.5-3-3.5s1.5-3.5 3-3.5 3 1.5 3 3.5-1.5 3.5-3 3.5zm-5-2c-1.5 0-2.5-1-2.5-2.5s1-2.5 2.5-2.5 2.5 1 2.5 2.5-1 2.5-2.5 2.5z"/></svg>
      <svg class="cf-pet-paw p2" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.5c-4 0-7-2.5-7-6s3-4 7-4 7 .5 7 4-3 6-7 6zm-5-10c-1.5 0-3-1.5-3-3.5s1.5-3.5 3-3.5 3 1.5 3 3.5-1.5 3.5-3 3.5zm10 0c-1.5 0-3-1.5-3-3.5s1.5-3.5 3-3.5 3 1.5 3 3.5-1.5 3.5-3 3.5zm-5-2c-1.5 0-2.5-1-2.5-2.5s1-2.5 2.5-2.5 2.5 1 2.5 2.5-1 2.5-2.5 2.5z"/></svg>
      <div class="cf-pet-hero-blob">
        {% if section.settings.hero_image != blank %}
          <img src="{{ section.settings.hero_image | img_url: 'master' }}" alt="Happy Pet">
        {% else %}
          <img src="https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=800&auto=format&fit=crop" alt="">
        {% endif %}
      </div>
    </div>
  </section>

  {%- comment -%} VALUE BAR {%- endcomment -%}
  <div class="cf-pet-values">
    <div class="cf-pet-val">
      <div class="cf-pet-val-icon">🩺</div>
      <div class="cf-pet-val-text">
        <h3>Vet Approved</h3><p>Safe & healthy formulas</p>
      </div>
    </div>
    <div class="cf-pet-val">
      <div class="cf-pet-val-icon">🍃</div>
      <div class="cf-pet-val-text">
        <h3>Natural Ingredients</h3><p>No artificial fillers</p>
      </div>
    </div>
    <div class="cf-pet-val">
      <div class="cf-pet-val-icon">🚚</div>
      <div class="cf-pet-val-text">
        <h3>Same Day Ship</h3><p>Order before 2 PM</p>
      </div>
    </div>
  </div>

  {%- comment -%} CATEGORIES {%- endcomment -%}
  <section class="cf-pet-cats">
    <div class="cf-pet-head">
      <h2>{{ section.settings.cats_heading | default: 'Shop by Pet' }}</h2>
    </div>
    <div class="cf-pet-cat-grid">
      <a href="/collections/dogs" class="cf-pet-cat">
        <div class="cf-pet-cat-img"><img src="https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?w=600&auto=format&fit=crop" alt="Dogs"></div>
        <h3>For Dogs</h3>
      </a>
      <a href="/collections/cats" class="cf-pet-cat">
        <div class="cf-pet-cat-img"><img src="https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=600&auto=format&fit=crop" alt="Cats"></div>
        <h3>For Cats</h3>
      </a>
      <a href="/collections/birds" class="cf-pet-cat">
        <div class="cf-pet-cat-img"><img src="https://images.unsplash.com/photo-1552728089-57105a2524d0?w=600&auto=format&fit=crop" alt="Birds"></div>
        <h3>For Birds</h3>
      </a>
      <a href="/collections/small-pets" class="cf-pet-cat">
        <div class="cf-pet-cat-img"><img src="https://images.unsplash.com/photo-1425082661705-1834bfd09dca?w=600&auto=format&fit=crop" alt="Small Pets"></div>
        <h3>Small Pets</h3>
      </a>
    </div>
  </section>

  {%- comment -%} PRODUCTS {%- endcomment -%}
  <section class="cf-pet-prods">
    <div class="cf-pet-head" style="text-align:center">
      <h2>{{ section.settings.prods_heading | default: 'Pawsome Picks' }}</h2>
    </div>
    <div class="cf-pet-prod-grid">
      {% assign coll = section.settings.featured_collection %}
      {% if coll != blank and coll.products_count > 0 %}
        {% for p in coll.products limit: 4 %}
          <a href="{{ p.url }}" class="cf-pet-card">
            <div class="cf-pet-card-badge">Top Rated</div>
            <div class="cf-pet-card-img">
              {% if p.featured_image %}<img src="{{ p.featured_image | img_url: '600x' }}" alt="{{ p.title }}">{% endif %}
            </div>
            <div class="cf-pet-card-title">{{ p.title }}</div>
            <div class="cf-pet-card-price">{{ p.price | money }}</div>
          </a>
        {% endfor %}
      {% else %}
        {% assign pet_demo = 'Premium Salmon Kibble,Interactive Puzzle Toy,Orthopedic Dog Bed,Catnip Mouse Toy' | split: ',' %}
        {% for name in pet_demo %}
          <a href="/collections/all" class="cf-pet-card">
            <div class="cf-pet-card-badge">Top Rated</div>
            <div class="cf-pet-card-img">
              <div style="width:70%;height:70%;background:#FFF0EB;border-radius:20px"></div>
            </div>
            <div class="cf-pet-card-title">{{ name }}</div>
            <div class="cf-pet-card-price">₹{{ forloop.index | times: 400 | plus: 899 }}</div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </section>

</div>

{% schema %}
{
  "name": "CF Pet Landing",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Primary Orange", "default": "#FF6B35" },
    { "type": "color", "id": "color_secondary", "label": "Secondary Yellow", "default": "#FFD166" },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero Image (Blob)" },
    { "type": "text", "id": "hero_headline", "label": "Headline", "default": "Healthy Pets, Happy Hearts" },
    { "type": "textarea", "id": "hero_text", "label": "Hero Text" },
    { "type": "text", "id": "hero_btn_text", "label": "Button Text", "default": "Shop Now 🐾" },
    { "type": "url", "id": "hero_btn_url", "label": "Button Link" },
    { "type": "header", "content": "Categories" },
    { "type": "text", "id": "cats_heading", "label": "Heading", "default": "Shop by Pet" },
    { "type": "header", "content": "Products" },
    { "type": "text", "id": "prods_heading", "label": "Products Heading", "default": "Pawsome Picks" },
    { "type": "collection", "id": "featured_collection", "label": "Featured Collection" }
  ],
  "presets": [{ "name": "CF Pet Landing" }]
}
{% endschema %}