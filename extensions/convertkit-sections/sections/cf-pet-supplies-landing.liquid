  --cf-accent:{{ section.settings.accent | default: '#D35400' }};
  --cf-bg:{{ section.settings.bg | default: '#f9e0d1' }};
  --cf-text:{{ section.settings.text_col | default: '#1a1a1a' }};
}
body{background:var(--cf-bg);color:var(--cf-text);}
</style>

