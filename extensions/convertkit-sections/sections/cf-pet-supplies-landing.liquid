{% schema %}
{
  "name": "CF Pet Supplies LP",
  "settings": [
    {
      "type": "header",
      "content": "Brand & Colors"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent Color",
      "default": "#D35400"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f9e0d1"
    },
    {
      "type": "color",
      "id": "text_col",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Announcement Bar"
