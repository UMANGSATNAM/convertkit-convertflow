{% comment %}
  ConvertFlow — Pet Supplies Landing Page
  Playful, rounded corners, warm colors, friendly aesthetic.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Quicksand:wght@500;600;700&display=swap');

  :root {
    --pet-primary: {{ section.settings.color_primary | default: '#FF6B35' }};
    --pet-secondary: {{ section.settings.color_secondary | default: '#FFD166' }};
    --pet-bg: {{ section.settings.color_bg | default: '#FFF8F0' }};
    --pet-surface: {{ section.settings.color_surface | default: '#FFFFFF' }};
    --pet-text: {{ section.settings.color_text | default: '#2B2D42' }};
    --pet-font-heading: 'Quicksand', sans-serif;
    --pet-font-body: 'Nunito', sans-serif;
  }

  .cf-pet * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-pet { font-family: var(--pet-font-body); background: var(--pet-bg); color: var(--pet-text); line-height: 1.6; }
  .cf-pet h1, .cf-pet h2, .cf-pet h3 { font-family: var(--pet-font-heading); font-weight: 700; color: var(--pet-text); }

  /* Buttons */
  .cf-pet-btn {
    display: inline-block; padding: 16px 36px;
    background: var(--pet-primary); color: #fff;
    font-family: var(--pet-font-heading); font-size: 18px; font-weight: 700;
    text-decoration: none; border-radius: 50px;
    box-shadow: 0 8px 20px rgba(255, 107, 53, 0.3);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .cf-pet-btn:hover { transform: translateY(-3px); box-shadow: 0 12px 24px rgba(255, 107, 53, 0.4); }

  /* Hero */
  .cf-pet-hero { padding: 60px 5% 100px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; max-width: 1400px; margin: 0 auto; min-height: 80vh; }
  .cf-pet-hero-text h1 { font-size: clamp(48px, 6vw, 72px); line-height: 1.1; margin-bottom: 24px; color: var(--pet-primary); }
  .cf-pet-hero-text p { font-size: 20px; color: #555; margin-bottom: 40px; font-weight: 600; max-width: 500px; }
  
  .cf-pet-hero-img { position: relative; }
  .cf-pet-hero-img-inner { aspect-ratio: 1; background: var(--pet-secondary); border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; overflow: hidden; animation: blobMorph 8s ease-in-out infinite; box-shadow: 0 20px 40px rgba(0,0,0,0.05); }
  @keyframes blobMorph { 0%, 100% { border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; } 50% { border-radius: 70% 30% 30% 70% / 70% 70% 30% 30%; } }
  .cf-pet-hero-img img { width: 100%; height: 100%; object-fit: cover; }
  
  .cf-pet-paw { position: absolute; width: 60px; height: 60px; color: var(--pet-primary); opacity: 0.2; transform: rotate(15deg); }
  .cf-pet-paw.p1 { top: -20px; left: -20px; }
  .cf-pet-paw.p2 { bottom: -20px; right: -20px; transform: rotate(-15deg); width: 80px; height: 80px; }

  /* Value Banner */
  .cf-pet-values { background: var(--pet-surface); padding: 60px 5%; margin-top: -40px; border-radius: 40px; position: relative; z-index: 2; box-shadow: 0 10px 30px rgba(0,0,0,0.02); max-width: 1200px; margin-left: auto; margin-right: auto; display: flex; justify-content: space-around; flex-wrap: wrap; gap: 30px; }
  .cf-pet-val { display: flex; align-items: center; gap: 16px; }
  .cf-pet-val-icon { width: 60px; height: 60px; background: #fff0eb; color: var(--pet-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .cf-pet-val-text h3 { font-size: 18px; margin-bottom: 4px; }
  .cf-pet-val-text p { font-size: 14px; color: #666; font-weight: 600; }

  /* Categories */
  .cf-pet-cats { padding: 100px 5%; text-align: center; }
  .cf-pet-section-title { font-size: 40px; margin-bottom: 16px; }
  .cf-pet-section-sub { font-size: 18px; color: #666; margin-bottom: 60px; font-weight: 600; }
  
  .cf-pet-cat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; max-width: 1200px; margin: 0 auto; }
  .cf-pet-cat { text-decoration: none; color: var(--pet-text); group; }
  .cf-pet-cat-img { aspect-ratio: 1; background: var(--pet-surface); border-radius: 50%; margin-bottom: 20px; padding: 20px; transition: all 0.3s; box-shadow: 0 10px 20px rgba(0,0,0,0.02); overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .cf-pet-cat-img img { max-width: 100%; max-height: 100%; object-fit: contain; transition: transform 0.3s; }
  .cf-pet-cat:hover .cf-pet-cat-img { transform: translateY(-10px); box-shadow: 0 15px 30px rgba(255, 107, 53, 0.15); border: 2px solid var(--pet-primary); }
  .cf-pet-cat:hover .cf-pet-cat-img img { transform: scale(1.1); }
  .cf-pet-cat h3 { font-size: 20px; transition: color 0.3s; }
  .cf-pet-cat:hover h3 { color: var(--pet-primary); }

  /* Pawsome Products */
  .cf-pet-prods { padding: 100px 0; background: var(--pet-surface); border-radius: 60px 60px 0 0; }
  .cf-pet-prods-inner { max-width: 1400px; margin: 0 auto; padding: 0 5%; }
  .cf-pet-prod-track { display: flex; gap: 30px; overflow-x: auto; padding-bottom: 40px; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .cf-pet-prod-track::-webkit-scrollbar { display: none; }
  
  .cf-pet-prod-card { flex: 0 0 clamp(280px, 25vw, 320px); scroll-snap-align: start; background: var(--pet-bg); border-radius: 24px; padding: 20px; text-decoration: none; transition: transform 0.3s; position: relative; }
  .cf-pet-prod-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.05); }
  .cf-pet-prod-img { aspect-ratio: 1; background: #fff; border-radius: 16px; margin-bottom: 20px; display: flex; align-items: center; justify-content: center; padding: 20px; }
  .cf-pet-prod-img img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .cf-pet-prod-badge { position: absolute; top: 10px; left: 10px; background: var(--pet-secondary); color: var(--pet-text); font-family: var(--pet-font-heading); font-weight: 700; font-size: 13px; padding: 4px 12px; border-radius: 20px; z-index: 2; }
  
  .cf-pet-prod-title { font-size: 18px; margin-bottom: 8px; color: var(--pet-text); }
  .cf-pet-prod-price { font-size: 20px; color: var(--pet-primary); font-family: var(--pet-font-heading); font-weight: 800; }

  @media (max-width: 900px) {
    .cf-pet-hero { grid-template-columns: 1fr; text-align: center; padding-top: 40px; }
    .cf-pet-hero-text p { margin: 0 auto 40px; }
    .cf-pet-values { margin-top: 0; border-radius: 0; }
    .cf-pet-cat-grid { grid-template-columns: repeat(2, 1fr); }
  }
{% endstyle %}

<div class="cf-pet">
  {% for block in section.blocks %}
    {% case block.type %}
      
      {% when 'hero' %}
        <section class="cf-pet-hero">
          <div class="cf-pet-hero-text">
            <h1>{{ block.settings.title | default: 'Healthy Pets, Happy Hearts' }}</h1>
            <p>{{ block.settings.text | default: 'Premium nutrition and accessories for your furry best friends.' }}</p>
            <a href="{{ block.settings.btn_url }}" class="cf-pet-btn">{{ block.settings.btn_text | default: 'Shop Now' }}</a>
          </div>
          <div class="cf-pet-hero-img">
            <!-- SVG Paws -->
            <svg class="cf-pet-paw p1" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.5c-4 0-7-2.5-7-6s3-4 7-4 7 .5 7 4-3 6-7 6zm-5-10c-1.5 0-3-1.5-3-3.5s1.5-3.5 3-3.5 3 1.5 3 3.5-1.5 3.5-3 3.5zm10 0c-1.5 0-3-1.5-3-3.5s1.5-3.5 3-3.5 3 1.5 3 3.5-1.5 3.5-3 3.5zm-5-2c-1.5 0-2.5-1-2.5-2.5s1-2.5 2.5-2.5 2.5 1 2.5 2.5-1 2.5-2.5 2.5z"/></svg>
            <svg class="cf-pet-paw p2" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.5c-4 0-7-2.5-7-6s3-4 7-4 7 .5 7 4-3 6-7 6zm-5-10c-1.5 0-3-1.5-3-3.5s1.5-3.5 3-3.5 3 1.5 3 3.5-1.5 3.5-3 3.5zm10 0c-1.5 0-3-1.5-3-3.5s1.5-3.5 3-3.5 3 1.5 3 3.5-1.5 3.5-3 3.5zm-5-2c-1.5 0-2.5-1-2.5-2.5s1-2.5 2.5-2.5 2.5 1 2.5 2.5-1 2.5-2.5 2.5z"/></svg>
            
            <div class="cf-pet-hero-img-inner">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | img_url: 'master' }}" alt="Happy Dog">
              {% else %}
                <div style="width:100%; height:100%; background:rgba(255, 107, 53, 0.2);"></div>
              {% endif %}
            </div>
          </div>
        </section>

      {% when 'values' %}
        <section class="cf-pet-values">
          <div class="cf-pet-val">
            <div class="cf-pet-val-icon"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg></div>
            <div class="cf-pet-val-text">
              <h3>Veterinarian Approved</h3>
              <p>Safe & healthy formulas</p>
            </div>
          </div>
          <div class="cf-pet-val">
            <div class="cf-pet-val-icon"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg></div>
            <div class="cf-pet-val-text">
              <h3>Natural Ingredients</h3>
              <p>No artificial fillers</p>
            </div>
          </div>
          <div class="cf-pet-val">
            <div class="cf-pet-val-icon"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg></div>
            <div class="cf-pet-val-text">
              <h3>Same Day Shipping</h3>
              <p>Order before 2 PM</p>
            </div>
          </div>
        </section>

      {% when 'categories' %}
        <section class="cf-pet-cats">
          <h2 class="cf-pet-section-title">{{ block.settings.heading | default: 'Shop by Pet' }}</h2>
          <p class="cf-pet-section-sub">{{ block.settings.text | default: 'Find exactly what your furry friend needs.' }}</p>
          <div class="cf-pet-cat-grid">
            {% for i in (1..4) %}
              <a href="#" class="cf-pet-cat">
                <div class="cf-pet-cat-img">
                  <div style="width:100px; height:100px; background:#fff; border-radius:50%;"></div>
                </div>
                <h3>Category {{ i }}</h3>
              </a>
            {% endfor %}
          </div>
        </section>

      {% when 'products' %}
        <section class="cf-pet-prods">
          <div class="cf-pet-prods-inner">
            <div style="text-align: center; margin-bottom: 50px;">
              <h2 class="cf-pet-section-title">{{ block.settings.heading | default: 'Pawsome Picks' }}</h2>
            </div>
            <div class="cf-pet-prod-track">
              {% assign collection = block.settings.collection %}
              {% if collection != blank and collection.products_count > 0 %}
                {% for product in collection.products limit: 6 %}
                  <a href="{{ product.url }}" class="cf-pet-prod-card">
                    {% if product.tags contains 'bestseller' %}
                      <div class="cf-pet-prod-badge">Top Rated</div>
                    {% endif %}
                    <div class="cf-pet-prod-img">
                      {% if product.featured_image %}
                        <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}">
                      {% endif %}
                    </div>
                    <div class="cf-pet-prod-title">{{ product.title }}</div>
                    <div class="cf-pet-prod-price">{{ product.price | money }}</div>
                  </a>
                {% endfor %}
              {% else %}
                {% for i in (1..6) %}
                  <a href="#" class="cf-pet-prod-card">
                    <div class="cf-pet-prod-badge">Top Rated</div>
                    <div class="cf-pet-prod-img"><div style="width:80%; height:80%; background:#f0f0f0; border-radius:12px;"></div></div>
                    <div class="cf-pet-prod-title">Premium Kibble {{ i }}</div>
                    <div class="cf-pet-prod-price">$35.00</div>
                  </a>
                {% endfor %}
              {% endif %}
            </div>
          </div>
        </section>

    {% endcase %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "CF Pet Supplies Landing",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Primary Accent", "default": "#FF6B35" },
    { "type": "color", "id": "color_secondary", "label": "Secondary Accent", "default": "#FFD166" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#FFF8F0" },
    { "type": "color", "id": "color_surface", "label": "Surface", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#2B2D42" }
  ],
  "blocks": [
    {
      "type": "hero",
      "name": "Hero Section",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "title", "label": "Headline", "default": "Healthy Pets, Happy Hearts" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Premium nutrition and accessories." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Shop Now" },
        { "type": "url", "id": "btn_url", "label": "Button Link" }
      ]
    },
    {
      "type": "values",
      "name": "Value Proposition",
      "limit": 1
    },
    {
      "type": "categories",
      "name": "Category Grid",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Pet" },
        { "type": "text", "id": "text", "label": "Subheading", "default": "Find exactly what your furry friend needs." }
      ]
    },
    {
      "type": "products",
      "name": "Product Slider",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Pawsome Picks" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF Pet Supplies Landing",
      "blocks": [
        { "type": "hero" },
        { "type": "values" },
        { "type": "categories" },
        { "type": "products" }
      ]
    }
  ]
}
{% endschema %}