{% comment %}ConvertFlow - Pet Supplies Landing | HappyPaws style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
<style>
.cfps{--pr:#3E8ED0;--sc:#FF8F3D;--bg:#F0F8FF;--sf:#fff;--text:#2D3748;--mu:#718096;--bd:#E2E8F0;--gr:#48BB78;}
.cfps *{box-sizing:border-box;margin:0;padding:0;}
.cfps{background:var(--bg);color:var(--text);font-family:'Nunito',sans-serif;font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased;}
.cfps h1,.cfps h2,.cfps h3{font-family:'Quicksand',sans-serif;}
.cfps-top{background:var(--pr);color:#fff;text-align:center;padding:10px;font-size:13px;font-weight:700;letter-spacing:.5px;}
.cfps-hdr{padding:16px 60px;background:var(--sf);display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid var(--bd);box-shadow:0 2px 20px rgba(0,0,0,.04);}
.cfps-brand{font-family:'Quicksand',sans-serif;font-size:28px;font-weight:700;color:var(--pr);text-decoration:none;display:flex;align-items:center;gap:6px;}
.cfps-brand span{color:var(--sc);}
.cfps-nav{display:flex;gap:28px;list-style:none;}
.cfps-nav a{font-size:14px;font-weight:600;color:var(--text);text-decoration:none;transition:color .2s;}
.cfps-nav a:hover{color:var(--pr);}
.cfps-hbtn{background:var(--sc);color:#fff;padding:12px 24px;border-radius:100px;font-family:'Quicksand',sans-serif;font-size:14px;font-weight:700;text-decoration:none;transition:opacity .2s;}
.cfps-hbtn:hover{opacity:.88;}
.cfps-hero{background:linear-gradient(135deg,#E8F4FD 0%,#FFF5EE 100%);display:grid;grid-template-columns:1fr 1fr;min-height:85vh;padding:0 60px;align-items:center;gap:60px;}
.cfps-h-badge{display:inline-flex;align-items:center;gap:8px;background:var(--pr);color:#fff;padding:6px 16px;border-radius:100px;font-size:12px;font-weight:800;margin-bottom:20px;}
.cfps-hero h1{font-size:60px;font-weight:700;line-height:1.1;margin-bottom:20px;color:var(--text);}
.cfps-hero h1 span{color:var(--sc);}
.cfps-hero>div>p{font-size:17px;color:var(--mu);line-height:1.8;max-width:440px;margin-bottom:36px;}
.cfps-btns{display:flex;gap:12px;}
.cfps-btn-pr{background:var(--pr);color:#fff;padding:16px 36px;border-radius:100px;font-family:'Quicksand',sans-serif;font-size:15px;font-weight:700;text-decoration:none;box-shadow:0 6px 20px rgba(62,142,208,.3);transition:all .2s;}
.cfps-btn-pr:hover{transform:translateY(-2px);}
.cfps-btn-sc{background:transparent;color:var(--sc);border:2px solid var(--sc);padding:14px 36px;border-radius:100px;font-family:'Quicksand',sans-serif;font-size:15px;font-weight:700;text-decoration:none;transition:all .2s;}
.cfps-btn-sc:hover{background:var(--sc);color:#fff;}
.cfps-pet-badges{display:flex;gap:10px;margin-top:28px;}
.cfps-pb{padding:8px 20px;border-radius:100px;font-size:12px;font-weight:800;background:var(--sf);border:2px solid var(--bd);}
.cfps-hero-vis{display:flex;align-items:center;justify-content:center;}
.cfps-paw-blob{width:400px;height:400px;border-radius:50% 40% 60% 40%;background:linear-gradient(135deg,#BEE3F8,#90CDF4);display:flex;align-items:center;justify-content:center;animation:cfps-blob 6s ease-in-out infinite;}
@keyframes cfps-blob{0%,100%{border-radius:50% 40% 60% 40%}50%{border-radius:40% 60% 40% 60%}}
.cfps-paw-blob svg{width:55%;color:#fff;opacity:.6;}
.cfps-cats{padding:70px 60px;max-width:1400px;margin:0 auto;}
.cfps-sh{text-align:center;margin-bottom:50px;}
.cfps-sh h2{font-size:40px;font-weight:700;color:var(--text);}
.cfps-sh p{font-size:16px;color:var(--mu);margin-top:8px;}
.cfps-cat-tabs{display:flex;gap:12px;justify-content:center;margin-bottom:40px;flex-wrap:wrap;}
.cfps-ctab{background:var(--sf);border:2px solid var(--bd);padding:10px 24px;border-radius:100px;font-family:'Quicksand',sans-serif;font-size:14px;font-weight:700;cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:8px;}
.cfps-ctab.active,.cfps-ctab:hover{border-color:var(--pr);color:var(--pr);}
.cfps-cat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.cfps-cat-card{background:var(--sf);border:2px solid var(--bd);border-radius:20px;padding:28px 20px;text-align:center;text-decoration:none;color:var(--text);transition:all .3s;}
.cfps-cat-card:hover{border-color:var(--pr);transform:translateY(-4px);}
.cfps-cat-emoji{font-size:40px;margin-bottom:12px;display:block;}
.cfps-cat-name{font-family:'Quicksand',sans-serif;font-size:16px;font-weight:700;margin-bottom:4px;}
.cfps-cat-count{font-size:12px;color:var(--mu);}
.cfps-prods{padding:0 60px 80px;max-width:1400px;margin:0 auto;}
.cfps-ph{display:flex;justify-content:space-between;align-items:center;margin-bottom:40px;}
.cfps-ph h2{font-size:36px;font-weight:700;}
.cfps-ph a{font-size:13px;font-weight:700;color:var(--pr);text-decoration:none;}
.cfps-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}
.cfps-card{background:var(--sf);border-radius:20px;overflow:hidden;border:2px solid var(--bd);transition:all .3s;}
.cfps-card:hover{border-color:var(--sc);box-shadow:0 12px 40px rgba(0,0,0,.07);transform:translateY(-4px);}
.cfps-card-img{aspect-ratio:1;background:linear-gradient(135deg,#E8F4FD,#FFF5EE);display:flex;align-items:center;justify-content:center;position:relative;}
.cfps-card-img img{width:100%;height:100%;object-fit:cover;}
.cfps-card-img svg{width:40%;opacity:.3;color:var(--pr);}
.cfps-card-badge{position:absolute;top:12px;left:12px;background:var(--sc);color:#fff;padding:4px 10px;border-radius:100px;font-size:9px;font-weight:800;letter-spacing:1px;}
.cfps-card-body{padding:20px;}
.cfps-card-type{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--pr);margin-bottom:6px;}
.cfps-card-name{font-family:'Quicksand',sans-serif;font-size:16px;font-weight:700;margin-bottom:6px;line-height:1.3;}
.cfps-card-pet{font-size:12px;color:var(--mu);margin-bottom:14px;}
.cfps-card-foot{display:flex;justify-content:space-between;align-items:center;}
.cfps-card-price{font-size:20px;font-weight:800;}
.cfps-card-old{font-size:13px;color:var(--mu);text-decoration:line-through;margin-left:6px;}
.cfps-atc{background:var(--pr);color:#fff;border:none;padding:10px 18px;border-radius:100px;font-size:12px;font-weight:700;cursor:pointer;font-family:'Nunito',sans-serif;transition:background .2s;}
.cfps-atc:hover{background:#2c7ab8;}
.cfps-trust{background:var(--pr);padding:60px;display:flex;align-items:center;justify-content:center;gap:80px;flex-wrap:wrap;}
.cfps-ti{display:flex;flex-direction:column;align-items:center;gap:12px;color:#fff;text-align:center;}
.cfps-ti-icon{width:60px;height:60px;border-radius:50%;border:2px solid rgba(255,255,255,.3);display:flex;align-items:center;justify-content:center;}
.cfps-ti strong{font-family:'Quicksand',sans-serif;font-size:16px;}
.cfps-ti span{font-size:12px;color:rgba(255,255,255,.6);max-width:120px;}
.cfps-footer{background:var(--text);padding:80px 60px 40px;}
.cfps-fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;padding-bottom:60px;border-bottom:1px solid rgba(255,255,255,.08);}
.cfps-fb a{font-family:'Quicksand',sans-serif;font-size:26px;font-weight:700;color:var(--sc);text-decoration:none;display:block;margin-bottom:16px;}
.cfps-fb p{font-size:13px;color:rgba(255,255,255,.4);line-height:1.9;max-width:260px;}
.cfps-fc h4{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.4);margin-bottom:20px;}
.cfps-fc ul{list-style:none;}
.cfps-fc li{margin-bottom:10px;}
.cfps-fc a{color:rgba(255,255,255,.5);text-decoration:none;font-size:14px;transition:color .2s;}
.cfps-fc a:hover{color:var(--sc);}
.cfps-fbot{display:flex;justify-content:space-between;padding-top:28px;font-size:11px;color:rgba(255,255,255,.2);}
@media(max-width:1024px){.cfps-hero{grid-template-columns:1fr;min-height:auto}.cfps-paw-blob{display:none}.cfps-cat-grid{grid-template-columns:repeat(2,1fr)}.cfps-grid{grid-template-columns:repeat(2,1fr)}.cfps-fg{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cfps-hdr{padding:16px 20px}.cfps-nav{display:none}.cfps-hero{padding:60px 20px}.cfps-hero h1{font-size:40px}.cfps-cats,.cfps-prods{padding:60px 20px}.cfps-grid{grid-template-columns:1fr}.cfps-trust{gap:40px;padding:40px 20px}.cfps-fg{grid-template-columns:1fr;gap:40px}.cfps-footer{padding:60px 20px 30px}}
</style>
<div class="cfps">
  <div class="cfps-top">🐾 {{ section.settings.promo_text | default: 'Free delivery on pet orders above ₹599! Tails are wagging.' }}</div>
  <header class="cfps-hdr">
    <a href="{{ routes.root_url }}" class="cfps-brand">Happy<span>Paws</span> 🐾</a>
    <ul class="cfps-nav"><li><a href="#">Dogs</a></li><li><a href="#">Cats</a></li><li><a href="#">Food</a></li><li><a href="#">Toys</a></li><li><a href="#">Grooming</a></li></ul>
    <a href="{{ routes.cart_url }}" class="cfps-hbtn">🛒 Cart ({{ cart.item_count }})</a>
  </header>
  <section class="cfps-hero">
    <div>
      <div class="cfps-h-badge">⭐ {{ section.settings.hero_badge | default: '4.8 — Trusted by 50K+ Pet Parents' }}</div>
      <h1>Because They <span>Deserve</span> the Best.</h1>
      <p>{{ section.settings.hero_sub | default: 'Natural, vet-approved pet supplies for dogs and cats. From nutrition to grooming — everything your furry family needs.' }}</p>
      <div class="cfps-btns">
        <a href="{{ section.settings.cta1_url | default: routes.collections_url }}" class="cfps-btn-pr">{{ section.settings.cta1_text | default: 'Shop for Dogs' }}</a>
        <a href="{{ section.settings.cta2_url | default: '#' }}" class="cfps-btn-sc">{{ section.settings.cta2_text | default: 'Shop for Cats' }}</a>
      </div>
      <div class="cfps-pet-badges"><span class="cfps-pb">🐕 Dogs</span><span class="cfps-pb">🐈 Cats</span><span class="cfps-pb">🐰 Small Pets</span></div>
    </div>
    <div class="cfps-hero-vis">
      <div class="cfps-paw-blob"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg></div>
    </div>
  </section>
  <section class="cfps-cats">
    <div class="cfps-sh"><h2>Shop by Category</h2><p>Everything your pet needs, all in one place.</p></div>
    <div class="cfps-cat-grid">
      <a href="#" class="cfps-cat-card"><span class="cfps-cat-emoji">🦴</span><div class="cfps-cat-name">Dog Food</div><div class="cfps-cat-count">120+ products</div></a>
      <a href="#" class="cfps-cat-card"><span class="cfps-cat-emoji">🐟</span><div class="cfps-cat-name">Cat Food</div><div class="cfps-cat-count">80+ products</div></a>
      <a href="#" class="cfps-cat-card"><span class="cfps-cat-emoji">🎾</span><div class="cfps-cat-name">Toys</div><div class="cfps-cat-count">60+ items</div></a>
      <a href="#" class="cfps-cat-card"><span class="cfps-cat-emoji">✂️</span><div class="cfps-cat-name">Grooming</div><div class="cfps-cat-count">45+ products</div></a>
    </div>
  </section>
  <section class="cfps-prods">
    <div class="cfps-ph"><h2>🐾 Top Picks</h2><a href="{{ routes.collections_url }}">See all →</a></div>
    <div class="cfps-grid">
      {% assign col = collections[section.settings.featured_collection] %}
      {% if col and col.products.size > 0 %}
        {% for p in col.products limit: 4 %}
          <div class="cfps-card">
            <div class="cfps-card-img">{% if p.featured_image %}<img src="{{ p.featured_image | img_url: '400x' }}" alt="{{ p.title }}">{% else %}<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>{% endif %}{% if p.compare_at_price > p.price %}<span class="cfps-card-badge">Sale</span>{% endif %}</div>
            <div class="cfps-card-body"><div class="cfps-card-type">{{ p.type | default: 'Pet Supply' }}</div><div class="cfps-card-name">{{ p.title }}</div><div class="cfps-card-pet">{{ p.vendor | default: 'For Dogs &amp; Cats' }}</div><div class="cfps-card-foot"><div class="cfps-card-price">{{ p.price | money }}{% if p.compare_at_price > p.price %}<span class="cfps-card-old">{{ p.compare_at_price | money }}</span>{% endif %}</div><button class="cfps-atc" data-variant-id="{{ p.variants.first.id }}">Add to Cart</button></div></div>
          </div>
        {% endfor %}
      {% else %}
        <div class="cfps-card"><div class="cfps-card-img"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg><span class="cfps-card-badge">Bestseller</span></div><div class="cfps-card-body"><div class="cfps-card-type">Dog Food</div><div class="cfps-card-name">Grain-Free Chicken &amp; Rice Adult Dog Food</div><div class="cfps-card-pet">🐕 For Dogs · All Breeds</div><div class="cfps-card-foot"><div class="cfps-card-price">&#8377;1,299<span class="cfps-card-old">&#8377;1,699</span></div><button class="cfps-atc">Add to Cart</button></div></div></div>
        <div class="cfps-card"><div class="cfps-card-img"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><circle cx="12" cy="12" r="10"/></svg></div><div class="cfps-card-body"><div class="cfps-card-type">Cat Food</div><div class="cfps-card-name">Tuna &amp; Salmon Wet Cat Food (Pack of 12)</div><div class="cfps-card-pet">🐈 For Cats · All Ages</div><div class="cfps-card-foot"><div class="cfps-card-price">&#8377;899</div><button class="cfps-atc">Add to Cart</button></div></div></div>
        <div class="cfps-card"><div class="cfps-card-img"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg><span class="cfps-card-badge">New</span></div><div class="cfps-card-body"><div class="cfps-card-type">Toys</div><div class="cfps-card-name">Interactive Puzzle Feeder Ball</div><div class="cfps-card-pet">🐕🐈 For Dogs &amp; Cats</div><div class="cfps-card-foot"><div class="cfps-card-price">&#8377;549</div><button class="cfps-atc">Add to Cart</button></div></div></div>
        <div class="cfps-card"><div class="cfps-card-img"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path d="M12 2a10 10 0 0 1 10 10"/></svg></div><div class="cfps-card-body"><div class="cfps-card-type">Grooming</div><div class="cfps-card-name">Natural Pet Shampoo — Tick &amp; Flea Guard</div><div class="cfps-card-pet">🐕 For Dogs</div><div class="cfps-card-foot"><div class="cfps-card-price">&#8377;449<span class="cfps-card-old">&#8377;599</span></div><button class="cfps-atc">Add to Cart</button></div></div></div>
      {% endif %}
    </div>
  </section>
  <div class="cfps-trust">
    <div class="cfps-ti"><div class="cfps-ti-icon"><svg fill="none" stroke="#fff" viewBox="0 0 24 24" stroke-width="1.5" width="28"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><strong>Vet Approved</strong><span>Formulated with vets</span></div>
    <div class="cfps-ti"><div class="cfps-ti-icon"><svg fill="none" stroke="#fff" viewBox="0 0 24 24" stroke-width="1.5" width="28"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66L7 19.7"/></svg></div><strong>Natural Ingredients</strong><span>No harmful chemicals</span></div>
    <div class="cfps-ti"><div class="cfps-ti-icon"><svg fill="none" stroke="#fff" viewBox="0 0 24 24" stroke-width="1.5" width="28"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/></svg></div><strong>Fast Delivery</strong><span>Delivered in 2–3 days</span></div>
    <div class="cfps-ti"><div class="cfps-ti-icon"><svg fill="none" stroke="#fff" viewBox="0 0 24 24" stroke-width="1.5" width="28"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg></div><strong>Easy Returns</strong><span>30-day hassle-free returns</span></div>
  </div>
  <footer class="cfps-footer">
    <div class="cfps-fg">
      <div class="cfps-fb"><a href="{{ routes.root_url }}">{{ section.settings.brand_name | default: 'HappyPaws' }} 🐾</a><p>Natural pet supplies for happy, healthy dogs and cats. Because every paw deserves the best.</p></div>
      <div class="cfps-fc"><h4>Shop</h4><ul><li><a href="#">Dog Food</a></li><li><a href="#">Cat Food</a></li><li><a href="#">Toys</a></li><li><a href="#">Grooming</a></li></ul></div>
      <div class="cfps-fc"><h4>Company</h4><ul><li><a href="#">About Us</a></li><li><a href="#">Vet Team</a></li><li><a href="#">Pet Blog</a></li></ul></div>
      <div class="cfps-fc"><h4>Support</h4><ul><li><a href="#">Track Order</a></li><li><a href="#">Returns</a></li><li><a href="#">FAQ</a></li><li><a href="#">Contact</a></li></ul></div>
    </div>
    <div class="cfps-fbot"><span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'HappyPaws' }}.</span><span>Privacy &middot; Terms</span></div>
  </footer>
</div>
{% schema %}
{
  "name": "Pet Supplies Landing",
  "settings": [
    {"type":"text","id":"brand_name","label":"Brand Name","default":"HappyPaws"},
    {"type":"text","id":"promo_text","label":"Promo Bar","default":"Free delivery on pet orders above ₹599! Tails are wagging."},
    {"type":"text","id":"hero_badge","label":"Hero Badge","default":"4.8 — Trusted by 50K+ Pet Parents"},
    {"type":"textarea","id":"hero_sub","label":"Hero Subtext","default":"Natural, vet-approved pet supplies for dogs and cats."},
    {"type":"text","id":"cta1_text","label":"CTA 1 Text","default":"Shop for Dogs"},
    {"type":"url","id":"cta1_url","label":"CTA 1 URL"},
    {"type":"text","id":"cta2_text","label":"CTA 2 Text","default":"Shop for Cats"},
    {"type":"url","id":"cta2_url","label":"CTA 2 URL"},
    {"type":"collection","id":"featured_collection","label":"Featured Collection"}
  ],
  "presets": [{"name":"Pet Supplies Landing"}]
}
{% endschema %}