{% comment %}ConvertFlow - Mens Grooming Landing | BRUT Co. style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&display=swap" rel="stylesheet">
<style>
.cfmg{--b:#080808;--b2:#141414;--b3:#1E1E1E;--cu:#B87333;--cu2:#D4956A;--cr:#F5EDE0;--sm:#888;--wh:#fff;}
.cfmg *{box-sizing:border-box;margin:0;padding:0;}
.cfmg{font-family:'Space Grotesk',sans-serif;background:var(--b);color:var(--cr);-webkit-font-smoothing:antialiased;}
.cfmg h1,.cfmg h2,.cfmg h3{font-family:'Cormorant Garamond',serif;}
.cfmg-nav{display:flex;align-items:center;justify-content:space-between;padding:20px 40px;background:rgba(8,8,8,.92);backdrop-filter:blur(12px);border-bottom:1px solid rgba(184,115,51,.15);}
.cfmg-nav-left{display:flex;gap:28px;}
.cfmg-nav-left a,.cfmg-nav-right a{font-size:12px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--sm);text-decoration:none;transition:color .2s;}
.cfmg-nav-left a:hover,.cfmg-nav-right a:hover{color:var(--cu);}
.cfmg-logo{font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:600;letter-spacing:4px;color:var(--wh);text-decoration:none;}
.cfmg-logo span{color:var(--cu);}
.cfmg-nav-right{display:flex;gap:20px;align-items:center;}
.cfmg-hero{display:grid;grid-template-columns:55% 45%;min-height:100vh;}
.cfmg-hl{background:var(--b);padding:100px 60px;display:flex;flex-direction:column;justify-content:center;}
.cfmg-eyebrow{display:flex;align-items:center;gap:12px;margin-bottom:28px;}
.cfmg-eyebrow-line{width:40px;height:1px;background:var(--cu);}
.cfmg-eyebrow span{font-size:11px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:var(--cu);}
.cfmg-hl h1{font-size:clamp(52px,6vw,88px);font-weight:600;line-height:1;margin-bottom:20px;color:var(--wh);}
.cfmg-hl h1 em{font-style:italic;color:var(--cu);}
.cfmg-sub{font-size:15px;color:var(--sm);line-height:1.8;max-width:420px;margin-bottom:44px;}
.cfmg-btns{display:flex;gap:16px;flex-wrap:wrap;}
.cfmg-btn-cu{background:var(--cu);color:var(--b);padding:15px 36px;font-size:12px;font-weight:700;letter-spacing:3px;text-transform:uppercase;text-decoration:none;transition:all .25s;border:2px solid var(--cu);}
.cfmg-btn-cu:hover{background:transparent;color:var(--cu);}
.cfmg-btn-ghost{border:1px solid rgba(255,255,255,.2);color:var(--cr);padding:15px 36px;font-size:12px;font-weight:700;letter-spacing:3px;text-transform:uppercase;text-decoration:none;transition:all .25s;}
.cfmg-btn-ghost:hover{border-color:var(--cu);color:var(--cu);}
.cfmg-stats{display:flex;gap:40px;margin-top:52px;padding-top:40px;border-top:1px solid rgba(255,255,255,.08);}
.cfmg-stat-n{font-family:'Cormorant Garamond',serif;font-size:36px;font-weight:600;color:var(--cu);display:block;}
.cfmg-stat-l{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--sm);display:block;margin-top:4px;}
.cfmg-hr{background:var(--b3);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.cfmg-hr-bg{position:absolute;inset:0;background:linear-gradient(135deg,#1a0e06 0%,#0d0d0d 60%,#1a0e06 100%);}
.cfmg-badge{position:absolute;bottom:40px;right:40px;background:var(--cu);color:var(--b);padding:16px 20px;text-align:center;}
.cfmg-badge-n{font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:600;display:block;}
.cfmg-badge-l{font-size:9px;letter-spacing:2px;text-transform:uppercase;display:block;margin-top:2px;}
.cfmg-marquee{background:var(--cu);padding:14px 0;overflow:hidden;white-space:nowrap;}
.cfmg-track{display:inline-flex;gap:48px;animation:cfmg-scroll 20s linear infinite;}
@keyframes cfmg-scroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
.cfmg-item{font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--b);}
.cfmg-prods{padding:100px 40px;background:var(--b);}
.cfmg-ph{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:60px;}
.cfmg-ph h2{font-size:clamp(36px,4vw,58px);font-weight:600;color:var(--wh);}
.cfmg-ph h2 em{color:var(--cu);font-style:italic;}
.cfmg-ph a{font-size:12px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--cu);text-decoration:none;}
.cfmg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
.cfmg-card{background:var(--b2);overflow:hidden;transition:transform .3s;}
.cfmg-card:hover{transform:translateY(-4px);}
.cfmg-card-img{aspect-ratio:4/3;background:linear-gradient(135deg,#1a0e06,#0d0d0d);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.cfmg-card-img img{width:100%;height:100%;object-fit:cover;}
.cfmg-badge2{position:absolute;top:16px;left:16px;background:var(--cu);color:var(--b);font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:5px 12px;}
.cfmg-card-body{padding:24px;}
.cfmg-card-cat{font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--cu);margin-bottom:8px;}
.cfmg-card-name{font-size:18px;font-weight:600;color:var(--wh);margin-bottom:16px;line-height:1.3;}
.cfmg-card-price{display:flex;align-items:center;gap:12px;margin-bottom:16px;}
.cfmg-card-price strong{font-family:'Cormorant Garamond',serif;font-size:24px;color:var(--cu);}
.cfmg-card-price del{font-size:14px;color:var(--sm);}
.cfmg-card-save{font-size:10px;font-weight:700;color:#4ade80;letter-spacing:1px;}
.cfmg-atc{background:transparent;border:1px solid rgba(255,255,255,.12);color:var(--cr);padding:12px;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;cursor:pointer;font-family:'Space Grotesk',sans-serif;transition:all .2s;width:100%;}
.cfmg-atc:hover{background:var(--cu);border-color:var(--cu);color:var(--b);}
.cfmg-testi{padding:100px 40px;background:var(--b2);}
.cfmg-th{text-align:center;margin-bottom:60px;}
.cfmg-th h2{font-size:clamp(36px,4vw,58px);font-weight:600;color:var(--wh);}
.cfmg-tgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;}
.cfmg-tc{background:var(--b3);padding:44px;display:flex;flex-direction:column;gap:24px;}
.cfmg-stars{color:var(--cu);font-size:18px;letter-spacing:2px;}
.cfmg-ttext{font-family:'Cormorant Garamond',serif;font-size:20px;font-style:italic;color:var(--cr);line-height:1.7;}
.cfmg-tauthor{display:flex;align-items:center;gap:16px;padding-top:24px;border-top:1px solid rgba(255,255,255,.07);}
.cfmg-avt{width:44px;height:44px;background:var(--cu);display:flex;align-items:center;justify-content:center;font-family:'Cormorant Garamond',serif;font-size:18px;color:var(--b);font-weight:600;}
.cfmg-tname{font-size:13px;font-weight:700;color:var(--wh);}
.cfmg-thandle{font-size:11px;color:var(--sm);margin-top:2px;}
.cfmg-cta{padding:120px 40px;background:var(--cu);text-align:center;position:relative;overflow:hidden;}
.cfmg-cta::before{content:'BRUT';font-family:'Cormorant Garamond',serif;font-size:300px;font-weight:600;color:rgba(0,0,0,.08);position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none;letter-spacing:20px;}
.cfmg-cta h2{font-size:clamp(40px,5vw,72px);font-weight:600;color:var(--b);margin-bottom:16px;position:relative;}
.cfmg-cta p{font-size:16px;color:rgba(0,0,0,.65);margin-bottom:44px;position:relative;}
.cfmg-btn-dark{background:var(--b);color:var(--cu);padding:18px 48px;font-size:12px;font-weight:700;letter-spacing:3px;text-transform:uppercase;text-decoration:none;transition:all .25s;border:2px solid var(--b);position:relative;}
.cfmg-btn-dark:hover{background:transparent;color:var(--b);border-color:var(--b);}
.cfmg-footer{background:var(--b);border-top:1px solid rgba(255,255,255,.05);padding:80px 40px 40px;}
.cfmg-fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;margin-bottom:60px;padding-bottom:60px;border-bottom:1px solid rgba(255,255,255,.07);}
.cfmg-fb h3{font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:600;color:var(--wh);letter-spacing:4px;text-transform:uppercase;}
.cfmg-fb h3 span{color:var(--cu);}
.cfmg-fb-tag{font-family:'Cormorant Garamond',serif;font-size:13px;font-style:italic;color:var(--cu);margin-bottom:20px;display:block;}
.cfmg-fb p{font-size:13px;color:var(--sm);line-height:1.9;max-width:280px;}
.cfmg-fc h4{font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--cu);margin-bottom:24px;}
.cfmg-fc ul{list-style:none;display:flex;flex-direction:column;gap:12px;}
.cfmg-fc a{font-size:13px;color:var(--sm);text-decoration:none;transition:color .2s;}
.cfmg-fc a:hover{color:var(--cr);}
.cfmg-fbot{display:flex;justify-content:space-between;align-items:center;}
.cfmg-fcopy{font-size:12px;color:var(--sm);}
.cfmg-fpay{display:flex;gap:8px;}
.cfmg-fpay span{background:var(--b3);border:1px solid rgba(255,255,255,.08);padding:4px 12px;font-size:10px;font-weight:700;letter-spacing:1px;color:var(--sm);}
@media(max-width:1024px){.cfmg-hero{grid-template-columns:1fr}.cfmg-hr{display:none}.cfmg-grid{grid-template-columns:repeat(2,1fr)}.cfmg-tgrid{grid-template-columns:1fr}.cfmg-fg{grid-template-columns:1fr 1fr;gap:40px}}
@media(max-width:768px){.cfmg-nav{padding:16px 20px}.cfmg-nav-left{display:none}.cfmg-hl{padding:80px 20px}.cfmg-prods,.cfmg-testi{padding:70px 20px}.cfmg-grid{grid-template-columns:1fr}.cfmg-fg{grid-template-columns:1fr}.cfmg-footer{padding:60px 20px 30px}.cfmg-fbot{flex-direction:column;gap:16px}}
</style>
<div class="cfmg">
  <nav class="cfmg-nav">
    <div class="cfmg-nav-left"><a href="#">Shop</a><a href="#">Kits</a><a href="#">About</a></div>
    <a href="{{ routes.root_url }}" class="cfmg-logo">{{ section.settings.brand_name | default: 'BRUT' }}<span>.</span></a>
    <div class="cfmg-nav-right"><a href="#">Rituals</a><a href="{{ routes.cart_url }}"><svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></a></div>
  </nav>
  <section class="cfmg-hero">
    <div class="cfmg-hl">
      <div class="cfmg-eyebrow"><div class="cfmg-eyebrow-line"></div><span>{{ section.settings.hero_eyebrow | default: "The Gentleman's Arsenal" }}</span></div>
      <h1>{{ section.settings.hero_h1 | default: 'Crafted for <em>Real Men.</em>' }}</h1>
      <p class="cfmg-sub">{{ section.settings.hero_sub | default: 'Premium grooming rituals engineered for performance. From precision beard oils to science-backed skincare — results without compromise.' }}</p>
      <div class="cfmg-btns">
        <a href="{{ section.settings.cta1_url | default: routes.collections_url }}" class="cfmg-btn-cu">{{ section.settings.cta1_text | default: 'Shop the Range' }}</a>
        <a href="{{ section.settings.cta2_url | default: '#' }}" class="cfmg-btn-ghost">{{ section.settings.cta2_text | default: 'View Rituals' }}</a>
      </div>
      <div class="cfmg-stats">
        <div><span class="cfmg-stat-n">40K+</span><span class="cfmg-stat-l">Men Grooming Daily</span></div>
        <div><span class="cfmg-stat-n">4.9★</span><span class="cfmg-stat-l">Average Rating</span></div>
        <div><span class="cfmg-stat-n">Zero</span><span class="cfmg-stat-l">Compromise Formula</span></div>
      </div>
    </div>
    <div class="cfmg-hr">
      <div class="cfmg-hr-bg"></div>
      <svg fill="none" stroke="#B87333" viewBox="0 0 24 24" stroke-width="1" width="120" opacity="0.3"><path d="M12 2a7 7 0 0 1 7 7c0 5.25-7 13-7 13S5 14.25 5 9a7 7 0 0 1 7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
      <div class="cfmg-badge"><span class="cfmg-badge-n">100%</span><span class="cfmg-badge-l">Natural Formula</span></div>
    </div>
  </section>
  <div class="cfmg-marquee"><div class="cfmg-track">{% assign items = 'PREMIUM GROOMING,ZERO COMPROMISE,SCIENCE-BACKED,NATURAL FORMULA,MEN WHO DEMAND RESULTS,PREMIUM GROOMING,ZERO COMPROMISE,SCIENCE-BACKED,NATURAL FORMULA,MEN WHO DEMAND RESULTS' | split: ',' %}{% for i in items %}<span class="cfmg-item">{{ i }}</span>{% endfor %}</div></div>
  <section class="cfmg-prods">
    <div class="cfmg-ph"><h2>The <em>Essential</em> Grooming Kit</h2><a href="{{ routes.collections_url }}">Shop All &rarr;</a></div>
    <div class="cfmg-grid">
      {% assign col = collections[section.settings.featured_collection] %}
      {% if col and col.products.size > 0 %}
        {% for p in col.products limit: 3 %}
          <div class="cfmg-card">
            <div class="cfmg-card-img">{% if p.featured_image %}<img src="{{ p.featured_image | img_url: '600x' }}" alt="{{ p.title }}">{% else %}<svg fill="none" stroke="#B87333" viewBox="0 0 24 24" stroke-width="1" width="80" opacity="0.3"><path d="M12 2a7 7 0 0 1 7 7c0 5.25-7 13-7 13S5 14.25 5 9a7 7 0 0 1 7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>{% endif %}{% if p.compare_at_price > p.price %}<span class="cfmg-badge2">Sale</span>{% endif %}</div>
            <div class="cfmg-card-body"><div class="cfmg-card-cat">{{ p.type | default: 'Grooming' }}</div><div class="cfmg-card-name">{{ p.title }}</div><div class="cfmg-card-price"><strong>{{ p.price | money }}</strong>{% if p.compare_at_price > p.price %}<del>{{ p.compare_at_price | money }}</del>{% endif %}</div><button class="cfmg-atc" data-variant-id="{{ p.variants.first.id }}">Add to Arsenal</button></div>
          </div>
        {% endfor %}
      {% else %}
        <div class="cfmg-card"><div class="cfmg-card-img"><svg fill="none" stroke="#B87333" viewBox="0 0 24 24" stroke-width="1" width="80" opacity="0.3"><path d="M12 2a7 7 0 0 1 7 7c0 5.25-7 13-7 13S5 14.25 5 9a7 7 0 0 1 7-7z"/><circle cx="12" cy="9" r="2.5"/></svg><span class="cfmg-badge2">Best Seller</span></div><div class="cfmg-card-body"><div class="cfmg-card-cat">Beard Care</div><div class="cfmg-card-name">Cedarwood &amp; Black Pepper Beard Oil</div><div class="cfmg-card-price"><strong>&#8377;799</strong><del>&#8377;1,199</del><span class="cfmg-card-save">33% OFF</span></div><button class="cfmg-atc">Add to Arsenal</button></div></div>
        <div class="cfmg-card"><div class="cfmg-card-img"><svg fill="none" stroke="#B87333" viewBox="0 0 24 24" stroke-width="1" width="80" opacity="0.3"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg><span class="cfmg-badge2">New Drop</span></div><div class="cfmg-card-body"><div class="cfmg-card-cat">Face Care</div><div class="cfmg-card-name">Charcoal Deep Cleanse Face Wash</div><div class="cfmg-card-price"><strong>&#8377;549</strong><del>&#8377;799</del><span class="cfmg-card-save">31% OFF</span></div><button class="cfmg-atc">Add to Arsenal</button></div></div>
        <div class="cfmg-card"><div class="cfmg-card-img"><svg fill="none" stroke="#B87333" viewBox="0 0 24 24" stroke-width="1" width="80" opacity="0.3"><rect x="2" y="3" width="20" height="14" rx="2"/></svg><span class="cfmg-badge2">Bundle</span></div><div class="cfmg-card-body"><div class="cfmg-card-cat">Grooming Kit</div><div class="cfmg-card-name">The Starter Ritual Bundle</div><div class="cfmg-card-price"><strong>&#8377;1,499</strong><del>&#8377;2,199</del><span class="cfmg-card-save">32% OFF</span></div><button class="cfmg-atc">Add to Arsenal</button></div></div>
      {% endif %}
    </div>
  </section>
  <section class="cfmg-testi">
    <div class="cfmg-th"><h2>From the <em style="font-style:italic;color:var(--cu)">Brotherhood</em></h2></div>
    <div class="cfmg-tgrid">
      <div class="cfmg-tc"><div class="cfmg-stars">★★★★★</div><p class="cfmg-ttext">"The Cedarwood Beard Oil is the real deal. My beard has never looked this healthy — and my wife can't stop complimenting the scent."</p><div class="cfmg-tauthor"><div class="cfmg-avt">A</div><div><div class="cfmg-tname">Arjun Mehta</div><div class="cfmg-thandle">Verified Buyer · Mumbai</div></div></div></div>
      <div class="cfmg-tc"><div class="cfmg-stars">★★★★★</div><p class="cfmg-ttext">"Finally a men's grooming brand that doesn't treat me like I don't know what I'm doing. The Starter Bundle was exactly what I needed."</p><div class="cfmg-tauthor"><div class="cfmg-avt">R</div><div><div class="cfmg-tname">Rahul Singh</div><div class="cfmg-thandle">Verified Buyer · Delhi</div></div></div></div>
      <div class="cfmg-tc"><div class="cfmg-stars">★★★★★</div><p class="cfmg-ttext">"The Charcoal Face Wash cleared my skin in 2 weeks. No marketing BS — just results. Switched from a premium brand and never looking back."</p><div class="cfmg-tauthor"><div class="cfmg-avt">K</div><div><div class="cfmg-tname">Karan Verma</div><div class="cfmg-thandle">Verified Buyer · Bangalore</div></div></div></div>
    </div>
  </section>
  <section class="cfmg-cta">
    <h2>Own Your Ritual.<br>Build Your Brand.</h2>
    <p>{{ section.settings.cta_sub | default: 'Premium grooming. Zero compromise. Built for the daily ritual.' }}</p>
    <a href="{{ section.settings.cta_url | default: routes.collections_url }}" class="cfmg-btn-dark">{{ section.settings.cta_btn | default: 'Shop the Range' }}</a>
  </section>
  <footer class="cfmg-footer">
    <div class="cfmg-fg">
      <div class="cfmg-fb"><h3>{{ section.settings.brand_name | default: 'BRUT' }}<span>.</span></h3><span class="cfmg-fb-tag">For the Modern Gentleman.</span><p>Premium grooming formulated for real men who demand results. Science-backed. Zero compromises.</p></div>
      <div class="cfmg-fc"><h4>Shop</h4><ul><li><a href="#">Beard Care</a></li><li><a href="#">Face Care</a></li><li><a href="#">Hair Styling</a></li><li><a href="#">Grooming Kits</a></li></ul></div>
      <div class="cfmg-fc"><h4>Company</h4><ul><li><a href="#">Our Story</a></li><li><a href="#">Ingredients</a></li><li><a href="#">Rituals Blog</a></li><li><a href="#">Sustainability</a></li></ul></div>
      <div class="cfmg-fc"><h4>Support</h4><ul><li><a href="#">Track Order</a></li><li><a href="#">Returns Policy</a></li><li><a href="#">Shipping Info</a></li><li><a href="#">FAQ</a></li></ul></div>
    </div>
    <div class="cfmg-fbot"><div class="cfmg-fcopy">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'BRUT' }} Co. All rights reserved.</div><div class="cfmg-fpay"><span>VISA</span><span>MASTERCARD</span><span>UPI</span><span>COD</span></div></div>
  </footer>
</div>
{% schema %}
{
  "name": "Mens Grooming Landing",
  "settings": [
    {"type":"text","id":"brand_name","label":"Brand Name","default":"BRUT"},
    {"type":"text","id":"hero_eyebrow","label":"Hero Eyebrow","default":"The Gentleman's Arsenal"},
    {"type":"textarea","id":"hero_h1","label":"Hero Heading","default":"Crafted for Real Men."},
    {"type":"textarea","id":"hero_sub","label":"Hero Subtext","default":"Premium grooming rituals engineered for performance."},
    {"type":"text","id":"cta1_text","label":"CTA 1 Text","default":"Shop the Range"},
    {"type":"url","id":"cta1_url","label":"CTA 1 URL"},
    {"type":"text","id":"cta2_text","label":"CTA 2 Text","default":"View Rituals"},
    {"type":"url","id":"cta2_url","label":"CTA 2 URL"},
    {"type":"collection","id":"featured_collection","label":"Featured Collection"},
    {"type":"text","id":"cta_btn","label":"CTA Banner Button","default":"Shop the Range"},
    {"type":"url","id":"cta_url","label":"CTA Banner URL"},
    {"type":"text","id":"cta_sub","label":"CTA Banner Subtext","default":"Premium grooming. Zero compromise. Built for the daily ritual."}
  ],
  "presets": [{"name":"Mens Grooming Landing"}]
}
{% endschema %}