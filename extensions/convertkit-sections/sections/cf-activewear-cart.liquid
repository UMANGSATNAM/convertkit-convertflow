{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Teko:wght@400;600;700&family=Inter:wght@400;600;800&display=swap');
  .cf-aw*{box-sizing:border-box;margin:0;padding:0}
  .cf-aw{font-family:'Inter',sans-serif;background:#050505;color:#fff;overflow-x:hidden}

  /* ═══ HERO ═══ */
  .cf-aw-hero{position:relative;min-height:92vh;display:flex;align-items:center;padding:0 6%}
  .cf-aw-hero-bg{position:absolute;inset:0}
  .cf-aw-hero-bg img{width:100%;height:100%;object-fit:cover;opacity:.55}
  .cf-aw-hero-bg::after{content:'';position:absolute;inset:0;background:linear-gradient(105deg,rgba(5,5,5,.96) 40%,rgba(5,5,5,.2) 100%)}
  .cf-aw-hero-inner{position:relative;z-index:2;max-width:740px}
  .cf-aw-tag{display:inline-block;background:#E2FE16;color:#000;font-family:'Teko',sans-serif;font-size:15px;font-weight:700;letter-spacing:3px;text-transform:uppercase;padding:4px 14px;margin-bottom:24px}
  .cf-aw-h1{font-family:'Teko',sans-serif;font-size:clamp(64px,10vw,130px);line-height:.95;text-transform:uppercase;color:#fff;margin-bottom:20px}
  .cf-aw-h1 em{font-style:normal;color:#E2FE16;display:block}
  .cf-aw-p{font-size:18px;color:#bbb;margin-bottom:40px;max-width:500px;line-height:1.6}
  .cf-aw-cta-row{display:flex;gap:16px;flex-wrap:wrap}
  .cf-aw-btn{display:inline-flex;align-items:center;gap:8px;padding:16px 36px;font-family:'Teko',sans-serif;font-size:20px;font-weight:700;letter-spacing:1px;text-transform:uppercase;text-decoration:none;cursor:pointer;border:none;clip-path:polygon(8px 0,100% 0,100% calc(100% - 8px),calc(100% - 8px) 100%,0 100%,0 8px);transition:all .3s}
  .cf-aw-btn-fill{background:#E2FE16;color:#000}
  .cf-aw-btn-fill:hover{transform:translateY(-4px);box-shadow:0 12px 30px rgba(226,254,22,.35)}
  .cf-aw-btn-ghost{background:transparent;color:#E2FE16;border:2px solid #E2FE16}
  .cf-aw-btn-ghost:hover{background:#E2FE16;color:#000}

  /* ═══ TICKER ═══ */
  .cf-aw-ticker{background:#E2FE16;overflow:hidden;padding:10px 0;white-space:nowrap}
  .cf-aw-ticker-track{display:inline-flex;animation:aw-ticker 28s linear infinite;gap:0}
  .cf-aw-ticker-track span{font-family:'Teko',sans-serif;font-size:18px;font-weight:700;color:#000;letter-spacing:2px;text-transform:uppercase;padding:0 40px}
  .cf-aw-ticker-track span::after{content:'//';margin-left:40px;color:rgba(0,0,0,.3)}
  @keyframes aw-ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  /* ═══ STATS ═══ */
  .cf-aw-stats{display:grid;grid-template-columns:repeat(4,1fr);background:#0F0F0F;border-top:1px solid #222;border-bottom:1px solid #222}
  .cf-aw-stat{padding:40px 24px;text-align:center;border-right:1px solid #222}
  .cf-aw-stat:last-child{border-right:none}
  .cf-aw-stat-num{font-family:'Teko',sans-serif;font-size:56px;font-weight:700;color:#E2FE16;line-height:1}
  .cf-aw-stat-label{font-size:13px;text-transform:uppercase;letter-spacing:2px;color:#666;margin-top:8px}

  /* ═══ PRODUCT CARDS ═══ */
  .cf-aw-products{padding:80px 6%}
  .cf-aw-products-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:50px}
  .cf-aw-products-head h2{font-family:'Teko',sans-serif;font-size:clamp(40px,5vw,60px);text-transform:uppercase;line-height:1}
  .cf-aw-products-head a{color:#E2FE16;font-size:13px;letter-spacing:2px;text-transform:uppercase;text-decoration:none;border-bottom:1px solid #E2FE16;padding-bottom:2px}
  .cf-aw-prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2px}
  
  /* Activewear card: dark, angular, badge-heavy */
  .cf-aw-card{position:relative;background:#111;overflow:hidden;text-decoration:none;color:#fff;display:block}
  .cf-aw-card-img{aspect-ratio:3/4;overflow:hidden;position:relative}
  .cf-aw-card-img img{width:100%;height:100%;object-fit:cover;transition:transform .7s ease}
  .cf-aw-card:hover .cf-aw-card-img img{transform:scale(1.08)}
  .cf-aw-card-badge{position:absolute;top:12px;left:0;background:#E2FE16;color:#000;font-family:'Teko',sans-serif;font-weight:700;font-size:14px;letter-spacing:1px;padding:4px 12px;text-transform:uppercase;z-index:2}
  .cf-aw-card-quick{position:absolute;bottom:0;left:0;right:0;background:#E2FE16;color:#000;font-family:'Teko',sans-serif;font-weight:700;font-size:18px;letter-spacing:2px;text-transform:uppercase;padding:12px;text-align:center;transform:translateY(100%);transition:transform .3s ease;z-index:3}
  .cf-aw-card:hover .cf-aw-card-quick{transform:translateY(0)}
  .cf-aw-card-info{padding:16px}
  .cf-aw-card-title{font-family:'Teko',sans-serif;font-size:22px;font-weight:600;text-transform:uppercase;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .cf-aw-card-price{font-size:16px;color:#E2FE16;font-weight:700}

  /* ═══ FEATURES ═══ */
  .cf-aw-features{background:#0F0F0F;padding:80px 6%}
  .cf-aw-features-grid{display:grid;grid-template-columns:1fr 1fr;gap:4px;max-width:1400px;margin:80px auto 0}
  .cf-aw-feat{position:relative;overflow:hidden;aspect-ratio:16/9}
  .cf-aw-feat:first-child{grid-column:span 2;aspect-ratio:21/9}
  .cf-aw-feat img{width:100%;height:100%;object-fit:cover;transition:transform .8s;opacity:.7}
  .cf-aw-feat:hover img{transform:scale(1.04)}
  .cf-aw-feat::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.9),transparent 50%)}
  .cf-aw-feat-text{position:absolute;bottom:30px;left:30px;z-index:2}
  .cf-aw-feat-cat{font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#E2FE16;margin-bottom:8px}
  .cf-aw-feat-title{font-family:'Teko',sans-serif;font-size:36px;font-weight:700;text-transform:uppercase}

  /* ═══ SECTION HEAD ═══ */
  .cf-aw-section-head{text-align:center;max-width:700px;margin:0 auto}
  .cf-aw-section-head .sub{font-size:13px;letter-spacing:3px;text-transform:uppercase;color:#E2FE16;margin-bottom:12px}
  .cf-aw-section-head h2{font-family:'Teko',sans-serif;font-size:clamp(40px,5vw,64px);text-transform:uppercase}

  /* ═══ CTA BANNER ═══ */
  .cf-aw-cta-banner{background:#E2FE16;padding:80px 6%;text-align:center}
  .cf-aw-cta-banner h2{font-family:'Teko',sans-serif;font-size:clamp(48px,7vw,90px);font-weight:700;text-transform:uppercase;color:#000;line-height:1;margin-bottom:30px}
  .cf-aw-cta-banner p{font-size:18px;color:#333;margin-bottom:40px;max-width:600px;margin-left:auto;margin-right:auto}
  .cf-aw-cta-banner .cf-aw-btn-fill{background:#000;color:#E2FE16}

  @media(max-width:900px){
    .cf-aw-stats{grid-template-columns:repeat(2,1fr)}
    .cf-aw-prod-grid{grid-template-columns:repeat(2,1fr)}
    .cf-aw-features-grid{grid-template-columns:1fr}
    .cf-aw-feat:first-child{grid-column:span 1;aspect-ratio:16/9}
    .cf-aw-products-head{flex-direction:column;gap:20px;align-items:flex-start}
  }
{% endstyle %}

<div class="cf-aw">

  {%- comment -%} HERO {%- endcomment -%}

{% comment %}
  ConvertFlow — Activewear Cart Page
  Bold checkout experience with free shipping progress and upsells.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Teko:wght@400;600;700&family=Inter:wght@400;600;800&display=swap');

  :root {
    --aw-primary: {{ section.settings.color_primary | default: '#E2FE16' }};
    --aw-bg: {{ section.settings.color_bg | default: '#050505' }};
    --aw-surface: {{ section.settings.color_surface | default: '#111111' }};
    --aw-border: rgba(255, 255, 255, 0.1);
    --aw-text: {{ section.settings.color_text | default: '#FFFFFF' }};
    --aw-font-heading: 'Teko', sans-serif;
    --aw-font-body: 'Inter', sans-serif;
  }

  .cf-aw-cart * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-aw-cart { font-family: var(--aw-font-body); background: var(--aw-bg); color: var(--aw-text); min-height: 80vh; }
  
  .cf-aw-cart-wrap { max-width: 1200px; margin: 0 auto; padding: 60px 5%; display: grid; grid-template-columns: 1fr 380px; gap: 40px; align-items: start; }
  
  .cf-aw-cart-h1 { font-family: var(--aw-font-heading); font-size: 48px; text-transform: uppercase; margin-bottom: 30px; letter-spacing: 1px; }
  
  /* Free Shipping Bar */
  .cf-aw-fs { background: var(--aw-surface); padding: 20px; border: 1px solid var(--aw-border); margin-bottom: 30px; }
  .cf-aw-fs-text { font-size: 14px; font-weight: 600; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 1px; }
  .cf-aw-fs-text strong { color: var(--aw-primary); }
  .cf-aw-fs-bar { height: 8px; background: rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden; }
  .cf-aw-fs-progress { height: 100%; background: var(--aw-primary); width: 75%; transition: width 0.3s; }
  
  /* Cart Items */
  .cf-aw-c-items { background: var(--aw-surface); border: 1px solid var(--aw-border); }
  .cf-aw-c-item { display: grid; grid-template-columns: 100px 1fr auto; gap: 20px; padding: 24px; border-bottom: 1px solid var(--aw-border); align-items: center; }
  .cf-aw-c-item:last-child { border-bottom: none; }
  .cf-aw-c-img { aspect-ratio: 3/4; background: #222; }
  .cf-aw-c-img img { width: 100%; height: 100%; object-fit: cover; }
  .cf-aw-c-info h3 { font-size: 16px; font-weight: 600; margin-bottom: 8px; }
  .cf-aw-c-var { font-size: 13px; color: #A1A1AA; margin-bottom: 12px; }
  .cf-aw-c-qty { display: inline-flex; border: 1px solid var(--aw-border); align-items: center; }
  .cf-aw-c-qty button { background: transparent; border: none; color: var(--aw-text); width: 32px; height: 32px; font-size: 18px; cursor: pointer; }
  .cf-aw-c-qty span { font-size: 14px; font-weight: 600; width: 32px; text-align: center; }
  .cf-aw-c-remove { font-size: 12px; color: #A1A1AA; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; text-decoration: underline; margin-top: 10px; display: inline-block; }
  .cf-aw-c-price { font-family: var(--aw-font-heading); font-size: 24px; color: var(--aw-primary); }
  
  /* Summary Box */
  .cf-aw-c-sum { background: var(--aw-surface); border: 1px solid var(--aw-border); padding: 30px; position: sticky; top: 40px; }
  .cf-aw-c-sum h2 { font-family: var(--aw-font-heading); font-size: 32px; text-transform: uppercase; margin-bottom: 24px; border-bottom: 1px solid var(--aw-border); padding-bottom: 16px; }
  .cf-aw-c-row { display: flex; justify-content: space-between; font-size: 15px; margin-bottom: 16px; color: #A1A1AA; }
  .cf-aw-c-total { display: flex; justify-content: space-between; font-size: 20px; font-weight: 800; color: #fff; margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--aw-border); }
  .cf-aw-c-total span:last-child { font-family: var(--aw-font-heading); font-size: 32px; color: var(--aw-primary); }
  
  .cf-aw-btn-checkout {
    display: block; width: 100%; text-align: center;
    background: var(--aw-primary); color: #000; border: none;
    padding: 18px; font-size: 18px; font-weight: 800; text-transform: uppercase;
    letter-spacing: 1px; cursor: pointer; margin-top: 30px; text-decoration: none;
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
    transition: transform 0.2s;
  }
  .cf-aw-btn-checkout:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(226, 254, 22, 0.2); }
  
  .cf-aw-c-empty { text-align: center; padding: 100px 20px; grid-column: 1 / -1; }
  .cf-aw-c-empty h2 { font-family: var(--aw-font-heading); font-size: 48px; color: var(--aw-primary); margin-bottom: 20px; }
  .cf-aw-c-empty a { display: inline-block; padding: 14px 32px; background: #fff; color: #000; font-weight: 800; text-transform: uppercase; text-decoration: none; margin-top: 20px; }

  @media(max-width: 900px) {
    .cf-aw-cart-wrap { grid-template-columns: 1fr; }
    .cf-aw-c-item { grid-template-columns: 80px 1fr; }
    .cf-aw-c-price { grid-column: 1 / -1; text-align: right; }
  }
{% endstyle %}

<div class="cf-aw-cart">
  <div class="cf-aw-cart-wrap">
    {% if cart.item_count == 0 %}
      <div class="cf-aw-c-empty">
        <h2>Your Gear Bag is Empty</h2>
        <p>Looks like you haven't added any performance gear yet.</p>
        <a href="/collections/all">Shop Now</a>
      </div>
    {% else %}
      <div>
        <h1 class="cf-aw-cart-h1">Your Gear Bag</h1>
        
        <div class="cf-aw-fs">
          <div class="cf-aw-fs-text">You are <strong>$25.00</strong> away from <strong>FREE SHIPPING</strong></div>
          <div class="cf-aw-fs-bar"><div class="cf-aw-fs-progress"></div></div>
        </div>
        
        <div class="cf-aw-c-items">
          {% for item in cart.items %}
            <div class="cf-aw-c-item">
              <div class="cf-aw-c-img">
                {% if item.image %}
                  <img src="{{ item.image | img_url: '200x' }}" alt="{{ item.title }}">
                {% endif %}
              </div>
              <div class="cf-aw-c-info">
                <h3>{{ item.product.title }}</h3>
                {% unless item.variant.title contains 'Default' %}
                  <div class="cf-aw-c-var">{{ item.variant.title }}</div>
                {% endunless %}
                <div class="cf-aw-c-qty">
                  <button>-</button><span>{{ item.quantity }}</span><button>+</button>
                </div>
                <br>
                <a href="{{ item.url_to_remove }}" class="cf-aw-c-remove">Remove</a>
              </div>
              <div class="cf-aw-c-price">{{ item.final_line_price | money }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
      
      <div class="cf-aw-c-sum">
        <h2>Summary</h2>
        <div class="cf-aw-c-row"><span>Subtotal</span> <span>{{ cart.total_price | money }}</span></div>
        <div class="cf-aw-c-row"><span>Shipping</span> <span>Calculated at checkout</span></div>
        <div class="cf-aw-c-total"><span>Total</span> <span>{{ cart.total_price | money }}</span></div>
        <a href="/checkout" class="cf-aw-btn-checkout">Checkout &rarr;</a>
      </div>
    {% endif %}
  </div>
</div>

</div>

{% schema %}
{
  "name": "CF Activewear Cart",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Primary Color (Neon)", "default": "#E2FE16" },
    { "type": "color", "id": "color_bg", "label": "Background Color", "default": "#050505" },
    { "type": "color", "id": "color_surface", "label": "Surface Color", "default": "#111111" },
    { "type": "color", "id": "color_text", "label": "Text Color", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "CF Activewear Cart" }
  ]
}
{% endschema %}

