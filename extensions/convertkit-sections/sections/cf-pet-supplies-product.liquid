{% comment %}
  ConvertFlow — Pet Supplies Product Page
  Playful product layout with rounded corners and warm tones.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Quicksand:wght@500;600;700&display=swap');

  :root {
    --pet-primary: {{ section.settings.color_primary | default: '#FF6B35' }};
    --pet-secondary: {{ section.settings.color_secondary | default: '#FFD166' }};
    --pet-bg: {{ section.settings.color_bg | default: '#FFF8F0' }};
    --pet-surface: {{ section.settings.color_surface | default: '#FFFFFF' }};
    --pet-text: {{ section.settings.color_text | default: '#2B2D42' }};
    --pet-font-heading: 'Quicksand', sans-serif;
    --pet-font-body: 'Nunito', sans-serif;
  }

  .cf-pet-p * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-pet-p { font-family: var(--pet-font-body); background: var(--pet-bg); color: var(--pet-text); line-height: 1.6; padding-top: 40px; padding-bottom: 80px; }
  
  .cf-pet-p-wrap { max-width: 1300px; margin: 0 auto; display: grid; grid-template-columns: 1.1fr 1fr; gap: 60px; padding: 0 5%; align-items: start; }
  
  /* Gallery */
  .cf-pet-p-gallery { display: flex; flex-direction: column; gap: 20px; }
  .cf-pet-p-img-main { background: var(--pet-surface); border-radius: 30px; padding: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); aspect-ratio: 1; display: flex; align-items: center; justify-content: center; }
  .cf-pet-p-img-main img { width: 100%; height: 100%; object-fit: contain; }
  .cf-pet-p-thumbs { display: flex; gap: 16px; overflow-x: auto; padding-bottom: 10px; }
  .cf-pet-p-thumb { flex: 0 0 100px; aspect-ratio: 1; background: var(--pet-surface); border-radius: 16px; padding: 10px; cursor: pointer; border: 2px solid transparent; transition: all 0.2s; box-shadow: 0 4px 10px rgba(0,0,0,0.02); }
  .cf-pet-p-thumb:hover, .cf-pet-p-thumb.active { border-color: var(--pet-primary); transform: translateY(-3px); }
  .cf-pet-p-thumb img { width: 100%; height: 100%; object-fit: contain; }
  
  /* Info */
  .cf-pet-p-info { padding: 40px; background: var(--pet-surface); border-radius: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); position: sticky; top: 40px; }
  .cf-pet-p-vendor { font-family: var(--pet-font-heading); font-size: 14px; font-weight: 700; color: var(--pet-primary); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 12px; }
  .cf-pet-p-title { font-family: var(--pet-font-heading); font-size: clamp(32px, 4vw, 42px); font-weight: 700; line-height: 1.2; margin-bottom: 16px; }
  
  .cf-pet-p-reviews { display: flex; align-items: center; gap: 8px; margin-bottom: 24px; font-weight: 600; font-size: 14px; color: #666; }
  .cf-pet-p-stars { color: var(--pet-secondary); display: flex; }
  .cf-pet-p-stars svg { width: 18px; height: 18px; fill: currentColor; }
  
  .cf-pet-p-price { font-family: var(--pet-font-heading); font-size: 32px; font-weight: 800; color: var(--pet-primary); margin-bottom: 30px; }
  
  .cf-pet-p-desc { font-size: 16px; color: #555; margin-bottom: 30px; font-weight: 600; line-height: 1.7; }
  
  /* Options */
  .cf-pet-p-opt { margin-bottom: 24px; }
  .cf-pet-p-opt-header { font-family: var(--pet-font-heading); font-size: 16px; font-weight: 700; margin-bottom: 12px; display: flex; justify-content: space-between; }
  .cf-pet-p-vals { display: flex; flex-wrap: wrap; gap: 12px; }
  .cf-pet-p-val { padding: 12px 24px; border-radius: 20px; border: 2px solid #eee; background: #fff; font-family: var(--pet-font-heading); font-weight: 700; font-size: 15px; cursor: pointer; transition: all 0.2s; color: var(--pet-text); }
  .cf-pet-p-val:hover, .cf-pet-p-val.active { border-color: var(--pet-primary); background: #fff0eb; color: var(--pet-primary); }
  
  /* Actions */
  .cf-pet-p-actions { display: grid; grid-template-columns: 120px 1fr; gap: 16px; margin-top: 30px; }
  .cf-pet-p-qty { display: flex; align-items: center; justify-content: space-between; border: 2px solid #eee; border-radius: 50px; padding: 0 20px; font-weight: 700; font-size: 18px; }
  .cf-pet-p-qty button { background: none; border: none; font-size: 20px; cursor: pointer; color: var(--pet-primary); font-weight: 700; }
  .cf-pet-p-add { background: var(--pet-primary); color: #fff; border: none; border-radius: 50px; font-family: var(--pet-font-heading); font-size: 18px; font-weight: 700; padding: 16px; cursor: pointer; box-shadow: 0 8px 20px rgba(255, 107, 53, 0.3); transition: all 0.3s; }
  .cf-pet-p-add:hover { transform: translateY(-3px); box-shadow: 0 12px 24px rgba(255, 107, 53, 0.4); }
  
  /* Perks */
  .cf-pet-p-perks { margin-top: 40px; padding-top: 30px; border-top: 2px dashed #eee; display: flex; flex-direction: column; gap: 16px; }
  .cf-pet-p-perk { display: flex; align-items: center; gap: 12px; font-weight: 700; font-size: 14px; color: #555; }
  .cf-pet-p-perk svg { color: var(--pet-primary); width: 20px; height: 20px; }

  @media(max-width: 900px) {
    .cf-pet-p-wrap { grid-template-columns: 1fr; gap: 40px; }
    .cf-pet-p-info { position: static; padding: 30px 20px; }
    .cf-pet-p-actions { grid-template-columns: 1fr; }
    .cf-pet-p-qty { padding: 14px 20px; width: 150px; margin: 0 auto; }
  }
{% endstyle %}

<div class="cf-pet-p">
  <div class="cf-pet-p-wrap">
    
    <div class="cf-pet-p-gallery">
      <div class="cf-pet-p-img-main">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title }}">
        {% else %}
          <div style="width:200px; height:200px; background:#fff0eb; border-radius:50%; display:flex; align-items:center; justify-content:center;">
            <svg width="60" height="60" style="color:var(--pet-primary);" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.5c-4 0-7-2.5-7-6s3-4 7-4 7 .5 7 4-3 6-7 6zm-5-10c-1.5 0-3-1.5-3-3.5s1.5-3.5 3-3.5 3 1.5 3 3.5-1.5 3.5-3 3.5zm10 0c-1.5 0-3-1.5-3-3.5s1.5-3.5 3-3.5 3 1.5 3 3.5-1.5 3.5-3 3.5zm-5-2c-1.5 0-2.5-1-2.5-2.5s1-2.5 2.5-2.5 2.5 1 2.5 2.5-1 2.5-2.5 2.5z"/></svg>
          </div>
        {% endif %}
      </div>
      <div class="cf-pet-p-thumbs">
        {% for image in product.images limit:5 %}
          <div class="cf-pet-p-thumb {% if forloop.first %}active{% endif %}">
            <img src="{{ image | img_url: '150x' }}" alt="{{ product.title }}">
          </div>
        {% endfor %}
      </div>
    </div>
    
    <div class="cf-pet-p-info">
      <div class="cf-pet-p-vendor">{{ product.vendor | default: 'Happy Paws Co.' }}</div>
      <h1 class="cf-pet-p-title">{{ product.title | default: 'Premium Salmon Kibble' }}</h1>
      
      <div class="cf-pet-p-reviews">
        <div class="cf-pet-p-stars">
          <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        </div>
        <span>(128 Reviews)</span>
      </div>
      
      <div class="cf-pet-p-price">{{ product.price | money | default: '$34.99' }}</div>
      
      <div class="cf-pet-p-desc">
        {{ product.description | strip_html | truncate: 200 | default: 'Packed with essential Omega-3s and real salmon as the first ingredient. Keep your furry friends coat shiny, joints healthy, and tummy happy!' }}
      </div>
      
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="cf-pet-p-opt">
            <div class="cf-pet-p-opt-header">
              <span>Select {{ option.name }}</span>
            </div>
            <div class="cf-pet-p-vals">
              {% for value in option.values %}
                <button class="cf-pet-p-val {% if forloop.first %}active{% endif %}">{{ value }}</button>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      {% endunless %}
      
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <div class="cf-pet-p-actions">
          <div class="cf-pet-p-qty">
            <button type="button">-</button>
            <span>1</span>
            <button type="button">+</button>
          </div>
          <button type="submit" class="cf-pet-p-add">Add to Cart</button>
        </div>
      {% endform %}
      
      <div class="cf-pet-p-perks">
        <div class="cf-pet-p-perk">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
          <span>Free shipping on orders over $50</span>
        </div>
        <div class="cf-pet-p-perk">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Subscribe & Save 10% Every Month</span>
        </div>
        <div class="cf-pet-p-perk">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          <span>Veterinarian Approved Formula</span>
        </div>
      </div>
      
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CF Pet Supplies PDP",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Primary Accent", "default": "#FF6B35" },
    { "type": "color", "id": "color_secondary", "label": "Secondary Accent", "default": "#FFD166" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#FFF8F0" },
    { "type": "color", "id": "color_surface", "label": "Surface", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#2B2D42" }
  ],
  "presets": [
    { "name": "CF Pet Supplies PDP" }
  ]
}
{% endschema %}