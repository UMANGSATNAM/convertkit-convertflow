  --cf-font: 'Inter', sans-serif;
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
body{font-family:var(--cf-font),'Inter',sans-serif;background:var(--cf-bg);color:var(--cf-text);-webkit-font-smoothing:antialiased}
