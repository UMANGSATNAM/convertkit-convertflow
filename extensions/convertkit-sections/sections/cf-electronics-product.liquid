{% comment %}
  ConvertFlow — Electronics Product Page
  Technical layout with full specs table and glowing accents.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Inter:wght@400;500&display=swap');

  :root {
    --el-primary: {{ section.settings.color_primary | default: '#00F0FF' }};
    --el-bg: {{ section.settings.color_bg | default: '#030508' }};
    --el-surface: {{ section.settings.color_surface | default: '#0C121E' }};
    --el-border: rgba(0, 240, 255, 0.15);
    --el-text: {{ section.settings.color_text | default: '#FFFFFF' }};
    --el-font-heading: 'Rajdhani', sans-serif;
    --el-font-body: 'Inter', sans-serif;
  }

  .cf-el-p * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-el-p { font-family: var(--el-font-body); background: var(--el-bg); color: var(--el-text); line-height: 1.6; }
  
  .cf-el-p-container { max-width: 1400px; margin: 0 auto; padding: 40px 5%; display: grid; grid-template-columns: 1fr 450px; gap: 60px; }
  
  /* Gallery */
  .cf-el-p-gallery { display: flex; flex-direction: column; gap: 20px; }
  .cf-el-p-img-main { background: radial-gradient(circle at center, var(--el-surface) 0%, var(--el-bg) 100%); border: 1px solid var(--el-border); aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; padding: 40px; box-shadow: inset 0 0 50px rgba(0,240,255,0.02); }
  .cf-el-p-img-main img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5)); }
  .cf-el-p-thumbs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .cf-el-p-thumb { aspect-ratio: 1; border: 1px solid var(--el-border); background: var(--el-surface); padding: 10px; cursor: pointer; transition: all 0.3s; }
  .cf-el-p-thumb:hover, .cf-el-p-thumb.active { border-color: var(--el-primary); box-shadow: inset 0 0 10px rgba(0,240,255,0.2); }
  .cf-el-p-thumb img { width: 100%; height: 100%; object-fit: contain; }
  
  /* Info sidebar */
  .cf-el-p-info { padding: 40px; background: var(--el-surface); border: 1px solid var(--el-border); height: fit-content; position: sticky; top: 40px; }
  .cf-el-p-badge { font-family: var(--el-font-heading); font-size: 14px; font-weight: 700; color: var(--el-primary); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 12px; }
  .cf-el-p-title { font-family: var(--el-font-heading); font-size: 36px; font-weight: 700; text-transform: uppercase; line-height: 1.1; margin-bottom: 16px; text-shadow: 0 0 10px rgba(255,255,255,0.1); }
  .cf-el-p-price { font-family: var(--el-font-heading); font-size: 32px; color: var(--el-primary); font-weight: 700; margin-bottom: 30px; display: flex; align-items: center; gap: 16px; }
  
  .cf-el-p-specs-mini { margin-bottom: 30px; border-bottom: 1px solid var(--el-border); padding-bottom: 30px; }
  .cf-el-p-spec-row { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 8px; color: #8B9BB4; }
  .cf-el-p-spec-row span:last-child { color: var(--el-text); font-family: var(--el-font-heading); font-weight: 600; letter-spacing: 1px; }
  
  /* Options */
  .cf-el-p-opt { margin-bottom: 30px; }
  .cf-el-p-opt-name { font-size: 13px; font-weight: 500; text-transform: uppercase; color: #8B9BB4; margin-bottom: 12px; }
  .cf-el-p-vals { display: flex; flex-wrap: wrap; gap: 12px; }
  .cf-el-p-val { background: transparent; border: 1px solid var(--el-border); color: var(--el-text); padding: 12px 20px; font-family: var(--el-font-heading); font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
  .cf-el-p-val:hover, .cf-el-p-val.active { border-color: var(--el-primary); background: rgba(0,240,255,0.1); color: var(--el-primary); }
  
  /* Add to Cart */
  .cf-el-p-add { width: 100%; padding: 18px; background: transparent; color: var(--el-primary); border: 1px solid var(--el-primary); font-family: var(--el-font-heading); font-size: 18px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: all 0.3s; margin-top: 10px; box-shadow: inset 0 0 10px rgba(0,240,255,0.1); }
  .cf-el-p-add:hover { background: var(--el-primary); color: #000; box-shadow: 0 0 20px rgba(0,240,255,0.3); }
  
  /* Tech Specs Table */
  .cf-el-p-tech { margin-top: 60px; background: var(--el-surface); border: 1px solid var(--el-border); }
  .cf-el-p-tech-head { padding: 20px 30px; border-bottom: 1px solid var(--el-border); font-family: var(--el-font-heading); font-size: 24px; font-weight: 600; text-transform: uppercase; color: var(--el-primary); }
  .cf-el-p-tech-row { display: grid; grid-template-columns: 200px 1fr; border-bottom: 1px solid var(--el-border); }
  .cf-el-p-tech-row:last-child { border-bottom: none; }
  .cf-el-p-tech-col { padding: 20px 30px; font-size: 14px; }
  .cf-el-p-tech-col:first-child { border-right: 1px solid var(--el-border); color: #8B9BB4; font-weight: 500; }

  @media(max-width: 1024px) {
    .cf-el-p-container { grid-template-columns: 1fr; }
    .cf-el-p-info { position: static; }
    .cf-el-p-tech-row { grid-template-columns: 1fr; }
    .cf-el-p-tech-col:first-child { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 10px; }
  }
{% endstyle %}

<div class="cf-el-p">
  <div class="cf-el-p-container">
    
    <div class="cf-el-p-gallery">
      <div class="cf-el-p-img-main">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title }}">
        {% else %}
          <div style="font-family:monospace; color:#888;">// DEVICE_IMG_RENDER</div>
        {% endif %}
      </div>
      <div class="cf-el-p-thumbs">
        {% for image in product.images limit:4 %}
          <div class="cf-el-p-thumb {% if forloop.first %}active{% endif %}">
            <img src="{{ image | img_url: '200x' }}" alt="{{ product.title }}">
          </div>
        {% endfor %}
      </div>
      
      <div class="cf-el-p-tech">
        <div class="cf-el-p-tech-head">Hardware Specifications</div>
        <div class="cf-el-p-tech-row"><div class="cf-el-p-tech-col">Processor</div><div class="cf-el-p-tech-col">{{ section.settings.spec_cpu | default: '12-core Next-Gen Neural Processor' }}</div></div>
        <div class="cf-el-p-tech-row"><div class="cf-el-p-tech-col">Memory</div><div class="cf-el-p-tech-col">{{ section.settings.spec_ram | default: '32GB LPDDR5X Unified Memory' }}</div></div>
        <div class="cf-el-p-tech-row"><div class="cf-el-p-tech-col">Storage</div><div class="cf-el-p-tech-col">{{ section.settings.spec_storage | default: '1TB NVMe Gen4 SSD' }}</div></div>
        <div class="cf-el-p-tech-row"><div class="cf-el-p-tech-col">Connectivity</div><div class="cf-el-p-tech-col">{{ section.settings.spec_conn | default: 'Wi-Fi 7, Bluetooth 5.4, 2x Thunderbolt 4' }}</div></div>
      </div>
    </div>
    
    <div class="cf-el-p-info">
      <div class="cf-el-p-badge">{{ product.vendor | default: 'SYSTEM_CORE' }}</div>
      <h1 class="cf-el-p-title">{{ product.title | default: 'Cyber Deck Pro Series X' }}</h1>
      <div class="cf-el-p-price">
        {{ product.price | money | default: '$2,499.00' }}
      </div>
      
      <div class="cf-el-p-specs-mini">
        <div class="cf-el-p-spec-row"><span>Status</span> <span style="color:#00FF66;">IN STOCK</span></div>
        <div class="cf-el-p-spec-row"><span>SKU</span> <span>{{ product.variants.first.sku | default: 'NX-99201' }}</span></div>
        <div class="cf-el-p-spec-row"><span>Warranty</span> <span>2 Years Hardware</span></div>
      </div>
      
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="cf-el-p-opt">
            <div class="cf-el-p-opt-name">{{ option.name }}</div>
            <div class="cf-el-p-vals">
              {% for value in option.values %}
                <button class="cf-el-p-val {% if forloop.first %}active{% endif %}">{{ value }}</button>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      {% endunless %}
      
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="cf-el-p-add">Initialize Order // +</button>
      {% endform %}
      
      <div style="margin-top: 30px; font-size: 14px; color: #8B9BB4; line-height: 1.6;">
        {{ product.description | strip_html | truncate: 300 | default: 'Designed for the future of computational work. Features unprecedented thermal management, quantum-level encryption hardware, and a fully programmable tactile matrix.' }}
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "CF Electronics PDP",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Primary Accent (Neon)", "default": "#00F0FF" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#030508" },
    { "type": "color", "id": "color_surface", "label": "Surface", "default": "#0C121E" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#FFFFFF" },
    { "type": "text", "id": "spec_cpu", "label": "Spec: CPU", "default": "12-core Next-Gen Neural Processor" },
    { "type": "text", "id": "spec_ram", "label": "Spec: RAM", "default": "32GB LPDDR5X Unified Memory" },
    { "type": "text", "id": "spec_storage", "label": "Spec: Storage", "default": "1TB NVMe Gen4 SSD" },
    { "type": "text", "id": "spec_conn", "label": "Spec: Connectivity", "default": "Wi-Fi 7, Bluetooth 5.4" }
  ],
  "presets": [
    { "name": "CF Electronics PDP" }
  ]
}
{% endschema %}