{% comment %}
  ConvertFlow — Fashion Clothing Cart Page
  Minimalist, elegant cart layout.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

  :root {
    --fc-primary: {{ section.settings.color_primary | default: '#0A0A0A' }};
    --fc-bg: {{ section.settings.color_bg | default: '#F5F3EF' }};
    --fc-surface: {{ section.settings.color_surface | default: '#FFFFFF' }};
    --fc-text: {{ section.settings.color_text | default: '#1a1a1a' }};
    --fc-border: rgba(0, 0, 0, 0.08);
    --fc-font-heading: 'Playfair Display', serif;
    --fc-font-body: 'Inter', sans-serif;
  }

  .cf-fc-cart * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-fc-cart { font-family: var(--fc-font-body); background: var(--fc-surface); color: var(--fc-text); min-height: 70vh; padding: 80px 5%; }
  
  .cf-fc-cart-inner { max-width: 900px; margin: 0 auto; }
  .cf-fc-cart h1 { font-family: var(--fc-font-heading); font-size: 48px; font-weight: 400; margin-bottom: 40px; text-align: center; }
  
  .cf-fc-cart-empty { text-align: center; padding: 60px 0; }
  .cf-fc-cart-empty p { color: #666; margin-bottom: 30px; font-size: 15px; }
  .cf-fc-btn-shop { display: inline-block; padding: 14px 40px; border: 1px solid var(--fc-primary); color: var(--fc-primary); font-size: 12px; text-transform: uppercase; letter-spacing: 2px; text-decoration: none; transition: all 0.3s; }
  .cf-fc-btn-shop:hover { background: var(--fc-primary); color: #fff; }
  
  .cf-fc-cart-items { border-top: 1px solid var(--fc-border); margin-bottom: 60px; }
  .cf-fc-c-item { display: grid; grid-template-columns: 100px 1fr auto; gap: 30px; padding: 30px 0; border-bottom: 1px solid var(--fc-border); align-items: center; }
  .cf-fc-c-img { aspect-ratio: 3/4; background: #f0ece6; }
  .cf-fc-c-img img { width: 100%; height: 100%; object-fit: cover; }
  
  .cf-fc-c-info h3 { font-family: var(--fc-font-body); font-size: 16px; font-weight: 500; margin-bottom: 8px; }
  .cf-fc-c-var { font-size: 13px; color: #888; margin-bottom: 16px; }
  .cf-fc-c-actions { display: flex; align-items: center; gap: 24px; }
  .cf-fc-c-qty { display: flex; align-items: center; border: 1px solid var(--fc-border); padding: 4px 12px; }
  .cf-fc-c-qty button { background: none; border: none; font-size: 16px; cursor: pointer; color: var(--fc-text); }
  .cf-fc-c-qty span { font-size: 13px; margin: 0 12px; }
  .cf-fc-c-remove { font-size: 12px; color: #888; text-decoration: underline; cursor: pointer; text-transform: uppercase; letter-spacing: 1px; }
  
  .cf-fc-c-price { font-size: 16px; font-weight: 500; }
  
  .cf-fc-cart-footer { max-width: 400px; margin-left: auto; }
  .cf-fc-c-subtotal { display: flex; justify-content: space-between; font-size: 16px; margin-bottom: 12px; }
  .cf-fc-c-note { font-size: 13px; color: #888; margin-bottom: 24px; line-height: 1.6; }
  .cf-fc-btn-checkout { display: block; width: 100%; padding: 18px; background: var(--fc-primary); color: #fff; font-size: 13px; text-transform: uppercase; letter-spacing: 2px; border: none; cursor: pointer; transition: opacity 0.3s; text-align: center; text-decoration: none; }
  .cf-fc-btn-checkout:hover { opacity: 0.9; }

  @media(max-width: 600px) {
    .cf-fc-c-item { grid-template-columns: 80px 1fr; gap: 20px; position: relative; }
    .cf-fc-c-price { position: absolute; top: 30px; right: 0; }
    .cf-fc-cart-footer { max-width: 100%; margin-top: 40px; }
  }
{% endstyle %}

<div class="cf-fc-cart">
  <div class="cf-fc-cart-inner">
    <h1>Your Bag</h1>
    
    {% if cart.item_count == 0 %}
      <div class="cf-fc-cart-empty">
        <p>Your shopping bag is currently empty.</p>
        <a href="/collections/all" class="cf-fc-btn-shop">Continue Shopping</a>
      </div>
    {% else %}
      <div class="cf-fc-cart-items">
        {% for item in cart.items %}
          <div class="cf-fc-c-item">
            <div class="cf-fc-c-img">
              {% if item.image %}
                <img src="{{ item.image | img_url: '200x' }}" alt="{{ item.title }}">
              {% endif %}
            </div>
            <div class="cf-fc-c-info">
              <h3>{{ item.product.title }}</h3>
              {% unless item.variant.title contains 'Default' %}
                <div class="cf-fc-c-var">{{ item.variant.title }}</div>
              {% endunless %}
              <div class="cf-fc-c-actions">
                <div class="cf-fc-c-qty">
                  <button>-</button><span>{{ item.quantity }}</span><button>+</button>
                </div>
                <a href="{{ item.url_to_remove }}" class="cf-fc-c-remove">Remove</a>
              </div>
            </div>
            <div class="cf-fc-c-price">{{ item.final_line_price | money }}</div>
          </div>
        {% endfor %}
      </div>
      
      <div class="cf-fc-cart-footer">
        <div class="cf-fc-c-subtotal">
          <span>Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="cf-fc-c-note">Taxes and shipping calculated at checkout.</p>
        <a href="/checkout" class="cf-fc-btn-checkout">Proceed to Checkout</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "CF Fashion Cart",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Primary Color", "default": "#0A0A0A" },
    { "type": "color", "id": "color_bg", "label": "Background Color", "default": "#F5F3EF" },
    { "type": "color", "id": "color_surface", "label": "Surface Color", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text Color", "default": "#1a1a1a" }
  ],
  "presets": [
    { "name": "CF Fashion Cart" }
  ]
}
{% endschema %}