{% comment %}ConvertFlow: Coffee Roasters — Landing Page{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,600;0,700;1,400&family=Karla:wght@400;500;700&display=swap" rel="stylesheet">

<style>
:root{--cf-a:{{ section.settings.accent | default: '#3E2723' }};--cf-bg:{{ section.settings.bg | default: '#efebe9' }};--cf-t:{{ section.settings.text_col | default: '#1a1a1a' }};--cf-f:'Playfair Display', serif;}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
body{font-family:var(--cf-f),'Inter',sans-serif;background:var(--cf-bg);color:var(--cf-t);-webkit-font-smoothing:antialiased}
.cf-ann{background:{{ section.settings.ann_bg | default: '#3E2723' }};color:{{ section.settings.ann_color | default: '#fff' }};text-align:center;padding:10px 20px;font-size:13px;font-weight:600;letter-spacing:.3px}
.cf-nav{background:#fff;padding:16px 60px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #eee;position:sticky;top:0;z-index:100}
.cf-logo{font-size:22px;font-weight:800;color:var(--cf-t);text-decoration:none}
.cf-nav-links{display:flex;gap:28px;list-style:none}
.cf-nav-links a{font-size:13px;font-weight:600;color:#555;text-decoration:none;transition:color .2s}
.cf-nav-links a:hover{color:var(--cf-a)}
.cf-nav-actions{display:flex;gap:16px;align-items:center}
.cf-nav-icon{width:38px;height:38px;display:flex;align-items:center;justify-content:center;color:#555;cursor:pointer;transition:color .2s;text-decoration:none}
.cf-nav-icon:hover{color:var(--cf-a)}
.cf-hero{min-height:88vh;display:grid;grid-template-columns:1fr 1fr;align-items:center;overflow:hidden}
.cf-hero-text{padding:80px 60px;display:flex;flex-direction:column;justify-content:center}
.cf-hero-tag{display:inline-block;background:var(--cf-a);color:#fff;font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;padding:6px 16px;margin-bottom:24px;width:fit-content}
.cf-hero-h1{font-size:clamp(36px,4vw,62px);font-weight:900;line-height:1.1;margin-bottom:20px}
.cf-hero-sub{font-size:16px;color:#666;line-height:1.8;margin-bottom:36px;max-width:460px}
.cf-hero-btns{display:flex;gap:16px;flex-wrap:wrap}
.cf-btn-p{display:inline-block;background:var(--cf-a);color:#fff;padding:16px 36px;font-size:14px;font-weight:700;text-decoration:none;letter-spacing:.5px;transition:opacity .2s}
.cf-btn-p:hover{opacity:.88}
.cf-btn-s{display:inline-block;border:2px solid var(--cf-a);color:var(--cf-a);padding:14px 34px;font-size:14px;font-weight:700;text-decoration:none;transition:all .2s}
.cf-btn-s:hover{background:var(--cf-a);color:#fff}
.cf-hero-img{height:88vh;overflow:hidden;position:relative}
.cf-hero-img img{width:100%;height:100%;object-fit:cover}
.cf-hero-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,var(--cf-a) 12%,var(--cf-bg))}
.cf-hero-ph svg{width:80px;opacity:.25;color:var(--cf-a)}
.cf-stats{display:grid;grid-template-columns:repeat(4,1fr);background:var(--cf-a);color:#fff;text-align:center}
.cf-stat{padding:32px 20px;border-right:1px solid rgba(255,255,255,.2)}
.cf-stat:last-child{border-right:none}
.cf-stat-n{font-size:32px;font-weight:900;margin-bottom:6px}
.cf-stat-l{font-size:11px;font-weight:700;opacity:.85;text-transform:uppercase;letter-spacing:1.5px}
.cf-sec{padding:80px 60px;max-width:1400px;margin:0 auto}
.cf-sec-hd{text-align:center;margin-bottom:48px}
.cf-sec-hd h2{font-size:36px;font-weight:800;margin-bottom:10px}
.cf-sec-hd p{font-size:15px;color:#888}
.cf-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.cf-card{background:#fff;border:1px solid #eee;text-decoration:none;color:var(--cf-t);display:block;transition:all .3s;overflow:hidden}
.cf-card:hover{transform:translateY(-4px);box-shadow:0 12px 40px rgba(0,0,0,.08)}
.cf-card-img{aspect-ratio:1;background:color-mix(in srgb,var(--cf-a) 8%,#fff);display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative}
.cf-card-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.cf-card:hover .cf-card-img img{transform:scale(1.05)}
.cf-card-img svg{width:30%;color:var(--cf-a);opacity:.25}
.cf-badge{position:absolute;top:12px;left:12px;background:var(--cf-a);color:#fff;font-size:9px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:4px 10px}
.cf-card-body{padding:18px}
.cf-card-vendor{font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--cf-a);margin-bottom:4px}
.cf-card-title{font-size:15px;font-weight:600;margin-bottom:10px;line-height:1.4}
.cf-card-price{display:flex;align-items:center;gap:10px}
.cf-card-price strong{font-size:18px;font-weight:800}
.cf-card-price del{font-size:13px;color:#aaa}
.cf-card-atc{display:block;width:calc(100% - 36px);margin:0 18px 18px;background:var(--cf-a);color:#fff;border:none;padding:12px;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;letter-spacing:.5px;transition:opacity .2s}
.cf-card-atc:hover{opacity:.88}
.cf-feats{background:#fff;border-top:1px solid #eee;border-bottom:1px solid #eee}
.cf-feats-inner{display:grid;grid-template-columns:repeat(4,1fr);max-width:1400px;margin:0 auto}
.cf-feat{padding:36px 32px;display:flex;align-items:flex-start;gap:16px;border-right:1px solid #eee}
.cf-feat:last-child{border-right:none}
.cf-feat-icon{width:44px;height:44px;background:color-mix(in srgb,var(--cf-a) 12%,#fff);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--cf-a)}
.cf-feat-t{font-size:14px;font-weight:700;margin-bottom:4px}
.cf-feat-s{font-size:12px;color:#888}
.cf-testi{padding:80px 60px;background:#fafafa;border-top:1px solid #eee}
.cf-testi-inner{max-width:1400px;margin:0 auto}
.cf-testi-hd{text-align:center;margin-bottom:48px;font-size:36px;font-weight:800}
.cf-testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.cf-testi-card{background:#fff;border:1px solid #eee;padding:36px;display:flex;flex-direction:column;gap:20px}
.cf-testi-text{font-size:15px;line-height:1.8;color:#555;font-style:italic;flex:1}
.cf-testi-auth{font-size:13px;font-weight:700;color:var(--cf-a)}
.cf-nl{background:var(--cf-a);padding:80px 60px;text-align:center;color:#fff}
.cf-nl h2{font-size:36px;font-weight:800;margin-bottom:12px}
.cf-nl p{font-size:15px;opacity:.85;margin-bottom:36px;max-width:500px;margin-left:auto;margin-right:auto}
.cf-nl-form{display:flex;max-width:480px;margin:0 auto}
.cf-nl-input{flex:1;padding:16px 20px;border:none;font-size:14px;outline:none;font-family:inherit}
.cf-nl-btn{padding:16px 28px;background:#1a1a1a;color:#fff;border:none;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;transition:opacity .2s}
.cf-nl-btn:hover{opacity:.85}
.cf-footer{background:#1a1a1a;color:#fff;padding:40px 60px;display:flex;justify-content:space-between;align-items:center}
.cf-footer-brand{font-size:20px;font-weight:800}
.cf-footer-links{display:flex;gap:24px;list-style:none}
.cf-footer-links a{color:#aaa;text-decoration:none;font-size:13px;transition:color .2s}
.cf-footer-links a:hover{color:#fff}
.cf-footer-copy{font-size:12px;color:#666}
@media(max-width:1024px){
  .cf-hero{grid-template-columns:1fr}
  .cf-hero-text{padding:60px 24px}
  .cf-hero-img{height:60vw}
  .cf-stats{grid-template-columns:repeat(2,1fr)}
  .cf-grid{grid-template-columns:repeat(2,1fr)}
  .cf-feats-inner{grid-template-columns:repeat(2,1fr)}
  .cf-testi-grid{grid-template-columns:1fr}
  .cf-sec,.cf-testi,.cf-nl{padding:60px 24px}
  .cf-footer{flex-direction:column;gap:20px;text-align:center;padding:40px 24px}
  .cf-nav{padding:16px 24px}
}
</style>

{% if section.settings.show_ann %}<div class="cf-ann">{{ section.settings.ann_text }}</div>{% endif %}
<nav class="cf-nav">
  <a href="/" class="cf-logo">{{ shop.name }}</a>
  <ul class="cf-nav-links">
    <li><a href="/collections/all">Shop</a></li>
    <li><a href="/collections">Collections</a></li>
    <li><a href="/pages/about">About</a></li>
    <li><a href="/pages/contact">Contact</a></li>
  </ul>
  <div class="cf-nav-actions">
    <a href="/account" class="cf-nav-icon" aria-label="Account"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></a>
    <a href="/cart" class="cf-nav-icon" aria-label="Cart"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg></a>
  </div>
</nav>
<section class="cf-hero">
  <div class="cf-hero-text">
    <span class="cf-hero-tag">{{ section.settings.hero_tag }}</span>
    <h1 class="cf-hero-h1">{{ section.settings.hero_h1 }}</h1>
    <p class="cf-hero-sub">{{ section.settings.hero_sub }}</p>
    <div class="cf-hero-btns">
      <a href="{{ section.settings.hero_url | default: '/collections/all' }}" class="cf-btn-p">{{ section.settings.hero_cta }}</a>
      {% if section.settings.hero_cta2 != blank %}<a href="{{ section.settings.hero_url2 | default: '/collections' }}" class="cf-btn-s">{{ section.settings.hero_cta2 }}</a>{% endif %}
    </div>
  </div>
  <div class="cf-hero-img">
    {% if section.settings.hero_img != blank %}
      <img src="{{ section.settings.hero_img | image_url: width: 1200 }}" alt="{{ section.settings.hero_h1 }}" loading="eager">
    {% else %}
      <div class="cf-hero-ph"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>
    {% endif %}
  </div>
</section>
{% if section.settings.show_stats %}
<div class="cf-stats">
  <div class="cf-stat"><div class="cf-stat-n">{{ section.settings.stat1_n }}</div><div class="cf-stat-l">{{ section.settings.stat1_l }}</div></div>
  <div class="cf-stat"><div class="cf-stat-n">{{ section.settings.stat2_n }}</div><div class="cf-stat-l">{{ section.settings.stat2_l }}</div></div>
  <div class="cf-stat"><div class="cf-stat-n">{{ section.settings.stat3_n }}</div><div class="cf-stat-l">{{ section.settings.stat3_l }}</div></div>
  <div class="cf-stat"><div class="cf-stat-n">{{ section.settings.stat4_n }}</div><div class="cf-stat-l">{{ section.settings.stat4_l }}</div></div>
</div>
{% endif %}
{% if section.settings.show_feats %}
<div class="cf-feats"><div class="cf-feats-inner">
  <div class="cf-feat"><div class="cf-feat-icon"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div><div><div class="cf-feat-t">{{ section.settings.feat1_t }}</div><div class="cf-feat-s">{{ section.settings.feat1_s }}</div></div></div>
  <div class="cf-feat"><div class="cf-feat-icon"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg></div><div><div class="cf-feat-t">{{ section.settings.feat2_t }}</div><div class="cf-feat-s">{{ section.settings.feat2_s }}</div></div></div>
  <div class="cf-feat"><div class="cf-feat-icon"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg></div><div><div class="cf-feat-t">{{ section.settings.feat3_t }}</div><div class="cf-feat-s">{{ section.settings.feat3_s }}</div></div></div>
  <div class="cf-feat"><div class="cf-feat-icon"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg></div><div><div class="cf-feat-t">{{ section.settings.feat4_t }}</div><div class="cf-feat-s">{{ section.settings.feat4_s }}</div></div></div>
</div></div>
{% endif %}
{% if section.settings.show_products and section.settings.prod_col != blank %}
<div style="background:var(--cf-bg)"><div class="cf-sec">
  <div class="cf-sec-hd"><h2>{{ section.settings.prod_heading }}</h2><p>{{ section.settings.prod_sub }}</p></div>
  <div class="cf-grid">
    {% for p in section.settings.prod_col.products limit: section.settings.prod_count %}
    <a href="{{ p.url }}" class="cf-card">
      <div class="cf-card-img">
        {% if p.featured_image %}<img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.title }}" loading="lazy">
        {% else %}<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path d="M20 7H4l1 12h14z"/><path d="M8 7V5a4 4 0 018 0v2"/></svg>{% endif %}
        {% if p.available == false %}<span class="cf-badge">Sold Out</span>{% elsif p.compare_at_price > p.price %}<span class="cf-badge">Sale</span>{% endif %}
      </div>
      <div class="cf-card-body">
        <div class="cf-card-vendor">{{ p.vendor }}</div>
        <div class="cf-card-title">{{ p.title | truncate: 55 }}</div>
        <div class="cf-card-price"><strong>{{ p.price | money }}</strong>{% if p.compare_at_price > p.price %}<del>{{ p.compare_at_price | money }}</del>{% endif %}</div>
      </div>
      <button class="cf-card-atc">Add to Cart</button>
    </a>
    {% endfor %}
  </div>
</div></div>
{% endif %}
{% if section.settings.show_testi %}
<div class="cf-testi"><div class="cf-testi-inner">
  <h2 class="cf-testi-hd">{{ section.settings.testi_h }}</h2>
  <div class="cf-testi-grid">
    <div class="cf-testi-card"><p class="cf-testi-text">{{ section.settings.t1_text }}</p><div class="cf-testi-auth">{{ section.settings.t1_auth }}</div></div>
    <div class="cf-testi-card"><p class="cf-testi-text">{{ section.settings.t2_text }}</p><div class="cf-testi-auth">{{ section.settings.t2_auth }}</div></div>
    <div class="cf-testi-card"><p class="cf-testi-text">{{ section.settings.t3_text }}</p><div class="cf-testi-auth">{{ section.settings.t3_auth }}</div></div>
  </div>
</div></div>
{% endif %}
{% if section.settings.show_nl %}
<div class="cf-nl">
  <h2>{{ section.settings.nl_h }}</h2>
  <p>{{ section.settings.nl_sub }}</p>
  <form class="cf-nl-form" action="/contact#contact_form" method="post">
    <input type="hidden" name="form_type" value="customer"><input type="hidden" name="utf8" value="&#x2713;">
    <input class="cf-nl-input" type="email" name="contact[email]" placeholder="{{ section.settings.nl_placeholder }}" required>
    <button class="cf-nl-btn" type="submit">{{ section.settings.nl_btn }}</button>
  </form>
</div>
{% endif %}
<footer class="cf-footer">
  <div class="cf-footer-brand">{{ shop.name }}</div>
  <ul class="cf-footer-links">
    <li><a href="/policies/privacy-policy">Privacy</a></li>
    <li><a href="/policies/refund-policy">Returns</a></li>
    <li><a href="/policies/shipping-policy">Shipping</a></li>
    <li><a href="/pages/contact">Contact</a></li>
  </ul>
  <div class="cf-footer-copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</div>
</footer>
{% schema %}
