{% comment %}ConvertFlow - Coffee Roasters Landing | Onyx style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,600;0,700;1,400&family=Karla:wght@400;500;700&display=swap" rel="stylesheet">
<style>
.cfcr{--primary:#3E2723;--secondary:#D84315;--bg:#F5EFEB;--surface:#fff;--text:#2D2725;--muted:#79716E;--border:#E8DDCD;}
.cfcr *{box-sizing:border-box;margin:0;padding:0;}
.cfcr{background:var(--bg);color:var(--text);font-family:'Karla',sans-serif;font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;}
.cfcr h1,.cfcr h2,.cfcr h3,.cfcr h4{font-family:'Bitter',serif;color:var(--primary);}
.cfcr-promo{background:var(--secondary);color:#fff;text-align:center;padding:10px;font-weight:700;font-size:13px;letter-spacing:1px;text-transform:uppercase;}
.cfcr-header{padding:30px 60px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid var(--border);background:var(--bg);}
.cfcr-nav{display:flex;gap:30px;list-style:none;}
.cfcr-nav a{color:var(--primary);text-decoration:none;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1px;transition:color .2s;position:relative;}
.cfcr-nav a::after{content:'';position:absolute;bottom:-4px;left:0;width:100%;height:2px;background:var(--secondary);transform:scaleX(0);transition:transform .2s;transform-origin:left;}
.cfcr-nav a:hover::after{transform:scaleX(1);}
.cfcr-brand{font-family:'Bitter',serif;font-size:32px;font-weight:700;text-decoration:none;text-align:center;letter-spacing:2px;text-transform:uppercase;color:var(--primary);}
.cfcr-actions{display:flex;gap:24px;justify-content:flex-end;align-items:center;}
.cfcr-action{color:var(--primary);text-decoration:none;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:1px;transition:color .2s;}
.cfcr-action:hover{color:var(--secondary);}
.cfcr-hero{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--border);}
.cfcr-hero-content{padding:100px 80px;display:flex;flex-direction:column;justify-content:center;}
.cfcr-htag{font-size:12px;font-weight:700;color:var(--secondary);text-transform:uppercase;letter-spacing:2px;margin-bottom:20px;}
.cfcr-hero-content h1{font-size:64px;line-height:1.1;margin-bottom:24px;}
.cfcr-hero-content>p{font-size:18px;color:var(--muted);margin-bottom:40px;max-width:450px;}
.cfcr-btn-primary{background:var(--primary);color:#fff;padding:16px 32px;font-family:'Karla',sans-serif;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1px;text-decoration:none;display:inline-block;transition:background .2s;border:1px solid var(--primary);}
.cfcr-btn-primary:hover{background:#5c3a34;}
.cfcr-hero-img{background:#e3d5ca;position:relative;border-left:1px solid var(--border);overflow:hidden;display:flex;align-items:center;justify-content:center;min-height:500px;}
.cfcr-taste-band{display:flex;background:var(--surface);border-bottom:1px solid var(--border);}
.cfcr-taste-item{flex:1;padding:40px;text-align:center;border-right:1px solid var(--border);}
.cfcr-taste-item:last-child{border-right:none;}
.cfcr-taste-comp{font-family:'Bitter',serif;font-size:20px;color:var(--primary);margin-bottom:8px;}
.cfcr-taste-desc{font-size:14px;color:var(--muted);}
.cfcr-shop{padding:100px 60px;max-width:1400px;margin:0 auto;}
.cfcr-shop-hd{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:60px;}
.cfcr-shop-hd h2{font-size:40px;}
.cfcr-shop-hd p{color:var(--muted);font-size:18px;max-width:400px;margin-top:10px;}
.cfcr-shop-link{color:var(--secondary);font-weight:700;text-decoration:none;text-transform:uppercase;letter-spacing:1px;font-size:14px;border-bottom:1px solid var(--secondary);padding-bottom:4px;}
.cfcr-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;}
.cfcr-card{background:var(--surface);padding:40px 30px;border:1px solid var(--border);position:relative;transition:transform .3s,box-shadow .3s;display:flex;flex-direction:column;}
.cfcr-card:hover{transform:translateY(-8px);box-shadow:0 20px 40px rgba(62,39,35,.08);}
.cfcr-img-box{aspect-ratio:3/4;background:var(--bg);margin-bottom:30px;display:flex;align-items:center;justify-content:center;border:1px solid var(--border);position:relative;overflow:hidden;}
.cfcr-img-box img{width:100%;height:100%;object-fit:cover;}
.cfcr-origin{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:var(--secondary);margin-bottom:8px;display:block;}
.cfcr-title{font-size:24px;margin-bottom:12px;line-height:1.2;}
.cfcr-notes{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px;}
.cfcr-note{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;border:1px solid var(--border);padding:4px 10px;color:var(--muted);}
.cfcr-grind{width:100%;border:1px solid var(--border);background:transparent;padding:12px;font-family:'Karla',sans-serif;font-size:14px;color:var(--text);outline:none;margin-bottom:24px;cursor:pointer;}
.cfcr-grind:focus{border-color:var(--primary);}
.cfcr-footer-row{display:flex;justify-content:space-between;align-items:center;margin-top:auto;}
.cfcr-price{font-family:'Bitter',serif;font-size:24px;color:var(--primary);}
.cfcr-btn-add{background:transparent;color:var(--primary);border:1px solid var(--primary);padding:10px 24px;font-family:'Karla',sans-serif;font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:1px;cursor:pointer;transition:all .2s;}
.cfcr-btn-add:hover{background:var(--primary);color:#fff;}
.cfcr-roastery{display:grid;grid-template-columns:1fr 1fr;background:var(--primary);color:#fff;margin:0 40px;border-radius:4px;overflow:hidden;}
.cfcr-r-img{background:#2c1c19;position:relative;min-height:400px;display:flex;align-items:center;justify-content:center;}
.cfcr-r-content{padding:80px;display:flex;flex-direction:column;justify-content:center;}
.cfcr-r-content h2{color:#fff;font-size:40px;margin-bottom:24px;}
.cfcr-r-content p{font-size:16px;color:rgba(255,255,255,.7);margin-bottom:40px;line-height:1.8;}
.cfcr-btn-sec{background:transparent;border:1px solid #fff;color:#fff;padding:14px 32px;font-weight:700;text-transform:uppercase;letter-spacing:1px;text-decoration:none;transition:all .2s;font-size:13px;}
.cfcr-btn-sec:hover{background:#fff;color:var(--primary);}
.cfcr-club{text-align:center;padding:100px 20px;max-width:600px;margin:0 auto;}
.cfcr-club h2{font-size:36px;margin-bottom:16px;}
.cfcr-club p{color:var(--muted);margin-bottom:30px;}
.cfcr-form{display:flex;gap:10px;}
.cfcr-input{flex-grow:1;border:1px solid var(--primary);background:transparent;padding:14px 20px;font-family:'Karla',sans-serif;font-size:15px;outline:none;}
.cfcr-submit{background:var(--secondary);color:#fff;border:1px solid var(--secondary);padding:0 30px;font-family:'Karla',sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:1px;cursor:pointer;transition:background .2s;}
.cfcr-submit:hover{background:#bf3810;}
.cfcr-footer{background:var(--surface);padding:80px 60px 40px;border-top:1px solid var(--border);}
.cfcr-fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;max-width:1400px;margin:0 auto;}
.cfcr-fb p{color:var(--muted);font-size:15px;margin-top:24px;max-width:300px;}
.cfcr-fc h4{font-family:'Karla',sans-serif;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:2px;margin-bottom:24px;color:var(--text);}
.cfcr-fc ul{list-style:none;}
.cfcr-fc li{margin-bottom:12px;}
.cfcr-fc a{color:var(--muted);text-decoration:none;font-size:15px;transition:color .2s;}
.cfcr-fc a:hover{color:var(--secondary);}
.cfcr-fbot{max-width:1400px;margin:60px auto 0;padding-top:30px;border-top:1px solid var(--border);display:flex;justify-content:space-between;font-size:13px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;font-weight:700;}
@media(max-width:1200px){.cfcr-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:1024px){.cfcr-hero,.cfcr-roastery{grid-template-columns:1fr}.cfcr-hero-content{padding:60px;text-align:center;align-items:center}.cfcr-hero-img{display:none}.cfcr-taste-band{flex-wrap:wrap}.cfcr-taste-item{min-width:50%;border-bottom:1px solid var(--border)}.cfcr-r-content{padding:60px 40px}.cfcr-fg{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cfcr-header{grid-template-columns:1fr auto;padding:20px}.cfcr-nav{display:none}.cfcr-hero-content h1{font-size:48px}.cfcr-shop{padding:60px 20px}.cfcr-grid{grid-template-columns:1fr}.cfcr-roastery{margin:0 20px}.cfcr-form{flex-direction:column}.cfcr-fg{grid-template-columns:1fr}.cfcr-footer{padding:60px 20px 30px}}
</style>

<div class="cfcr">
  <div class="cfcr-promo">{{ section.settings.promo_text | default: 'Complimentary shipping on whole bean orders over $50' }}</div>
  <header class="cfcr-header">
    <ul class="cfcr-nav"><li><a href="#">Shop Coffee</a></li><li><a href="#">Brew Gear</a></li><li><a href="#">Subscriptions</a></li></ul>
    <a href="{{ routes.root_url }}" class="cfcr-brand">{{ section.settings.brand_name | default: 'Onyx' }}</a>
    <div class="cfcr-actions"><a href="{{ routes.account_url }}" class="cfcr-action">Log In</a><a href="{{ routes.cart_url }}" class="cfcr-action">Cart [{{ cart.item_count }}]</a></div>
  </header>

  <section class="cfcr-hero">
    <div class="cfcr-hero-content">
      <span class="cfcr-htag">{{ section.settings.hero_tag | default: 'Current Harvest' }}</span>
      <h1>{{ section.settings.hero_heading | default: 'Fincas of Antioquia.' }}</h1>
      <p>{{ section.settings.hero_subtext | default: 'A strictly high-grown Colombian micro-lot featuring vibrant notes of red currant, brown sugar, and a delicate floral finish. Roasted to order in small batches.' }}</p>
      <a href="#cfcr-shop" class="cfcr-btn-primary">{{ section.settings.cta_text | default: 'Shop This Micro-Lot' }}</a>
    </div>
    <div class="cfcr-hero-img">
      <svg fill="none" stroke="#3E2723" viewBox="0 0 24 24" stroke-width="0.8" width="200" height="200" opacity="0.1"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
    </div>
  </section>

  <div class="cfcr-taste-band">
    <div class="cfcr-taste-item"><div class="cfcr-taste-comp">Fruity &amp; Floral</div><div class="cfcr-taste-desc">Vibrant acidity with berry undertones.</div></div>
    <div class="cfcr-taste-item"><div class="cfcr-taste-comp">Chocolate &amp; Nut</div><div class="cfcr-taste-desc">Rich cocoa depth with toasted almond.</div></div>
    <div class="cfcr-taste-item"><div class="cfcr-taste-comp">Sweet &amp; Sugary</div><div class="cfcr-taste-desc">Caramelized sugar and honeyed sweetness.</div></div>
    <div class="cfcr-taste-item"><div class="cfcr-taste-comp">Roast Profile</div><div class="cfcr-taste-desc">From gentle light to robust dark roasts.</div></div>
  </div>

  <section class="cfcr-shop" id="cfcr-shop">
    <div class="cfcr-shop-hd">
      <div><h2>Single Origin Offerings</h2><p>Sourced from sustainable farms across the coffee belt. We roast to highlight the innate characteristics of each bean.</p></div>
      <a href="{{ routes.collections_url }}" class="cfcr-shop-link">View Full Catalog</a>
    </div>
    <div class="cfcr-grid">
      {% assign col = collections[section.settings.featured_collection] %}
      {% if col and col.products.size > 0 %}
        {% for p in col.products limit: 3 %}
          <div class="cfcr-card">
            <div class="cfcr-img-box">{% if p.featured_image %}<img src="{{ p.featured_image | img_url: '600x' }}" alt="{{ p.title }}">{% endif %}</div>
            <span class="cfcr-origin">{{ p.vendor }} &middot; {{ p.type | default: 'Washed' }}</span>
            <h3 class="cfcr-title">{{ p.title }}</h3>
            <div class="cfcr-notes"><span class="cfcr-note">{{ p.tags.first | default: 'Specialty' }}</span></div>
            <select class="cfcr-grind">{% for v in p.variants %}<option>{{ v.title }}</option>{% endfor %}</select>
            <div class="cfcr-footer-row"><div class="cfcr-price">{{ p.price | money }}</div><button class="cfcr-btn-add" data-variant-id="{{ p.variants.first.id }}">Add to Bag</button></div>
          </div>
        {% endfor %}
      {% else %}
        <div class="cfcr-card"><div class="cfcr-img-box"><svg fill="none" stroke="#3E2723" viewBox="0 0 24 24" stroke-width="1.5" width="80" height="80" opacity="0.5"><rect x="5" y="4" width="14" height="16" rx="2"/><circle cx="12" cy="12" r="3"/></svg></div><span class="cfcr-origin">Ethiopia &middot; Washed</span><h3 class="cfcr-title">Yirgacheffe Kochere</h3><div class="cfcr-notes"><span class="cfcr-note">Jasmine</span><span class="cfcr-note">Peach</span><span class="cfcr-note">Black Tea</span></div><select class="cfcr-grind"><option>Whole Bean</option><option>French Press</option><option>Drip / Maker</option><option>Espresso</option></select><div class="cfcr-footer-row"><div class="cfcr-price">$22.00</div><button class="cfcr-btn-add">Add to Bag</button></div></div>
        <div class="cfcr-card"><div class="cfcr-img-box" style="background:#e8ecef;"><svg fill="none" stroke="#3E2723" viewBox="0 0 24 24" stroke-width="1.5" width="80" height="80" opacity="0.5"><rect x="5" y="4" width="14" height="16" rx="2"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="16" y2="14"/></svg></div><span class="cfcr-origin">Colombia &middot; Natural</span><h3 class="cfcr-title">Finca El Paraiso</h3><div class="cfcr-notes"><span class="cfcr-note">Strawberry</span><span class="cfcr-note">Cacao</span><span class="cfcr-note">Wine</span></div><select class="cfcr-grind"><option>Whole Bean</option><option>French Press</option><option>Espresso</option></select><div class="cfcr-footer-row"><div class="cfcr-price">$24.00</div><button class="cfcr-btn-add">Add to Bag</button></div></div>
        <div class="cfcr-card"><div class="cfcr-img-box" style="background:#EFEBE8;"><svg fill="none" stroke="#3E2723" viewBox="0 0 24 24" stroke-width="1.5" width="80" height="80" opacity="0.5"><rect x="5" y="4" width="14" height="16" rx="2"/><path d="M12 9l3 3-3 3"/><path d="M9 12h6"/></svg></div><span class="cfcr-origin">Guatemala &middot; Washed</span><h3 class="cfcr-title">Antigua La Flor</h3><div class="cfcr-notes"><span class="cfcr-note">Milk Choc</span><span class="cfcr-note">Orange</span><span class="cfcr-note">Almond</span></div><select class="cfcr-grind"><option>Whole Bean</option><option>French Press</option><option>Espresso</option></select><div class="cfcr-footer-row"><div class="cfcr-price">$20.00</div><button class="cfcr-btn-add">Add to Bag</button></div></div>
      {% endif %}
    </div>
  </section>

  <div class="cfcr-roastery">
    <div class="cfcr-r-img"><svg fill="none" viewBox="0 0 100 100" stroke="#D84315" stroke-width="0.5" width="200" opacity="0.6"><circle cx="50" cy="50" r="30"/><circle cx="50" cy="50" r="20"/><path d="M50 20L50 80M20 50L80 50"/></svg></div>
    <div class="cfcr-r-content">
      <h2>The Roastery</h2>
      <p>{{ section.settings.roastery_text | default: 'Every small batch is roasted on our vintage Probat. We use careful data logging combined with sensory intuition to develop a roast profile that respects the hard work of the producers. No cutting corners, just beautiful coffee.' }}</p>
      <a href="#" class="cfcr-btn-sec">Learn Our Process</a>
    </div>
  </div>

  <div class="cfcr-club">
    <h2>The Coffee Club</h2>
    <p>Join our newsletter. No spam, just updates on fresh harvests, brewing guides, and exclusive subscriber-only micro-lots.</p>
    <form class="cfcr-form"><input type="email" class="cfcr-input" placeholder="Enter your email address"><button type="submit" class="cfcr-submit">Subscribe</button></form>
  </div>

  <footer class="cfcr-footer">
    <div class="cfcr-fg">
      <div class="cfcr-fb"><a href="{{ routes.root_url }}" class="cfcr-brand">{{ section.settings.brand_name | default: 'Onyx' }}</a><p>Independent coffee roasters dedicated to transparency, quality, and community.</p></div>
      <div class="cfcr-fc"><h4>Shop</h4><ul><li><a href="#">All Coffee</a></li><li><a href="#">Subscriptions</a></li><li><a href="#">Brewing Equipment</a></li><li><a href="#">Merchandise</a></li></ul></div>
      <div class="cfcr-fc"><h4>Learn</h4><ul><li><a href="#">Brew Guides</a></li><li><a href="#">Our Sourcing</a></li><li><a href="#">The Roastery</a></li><li><a href="#">Journal</a></li></ul></div>
      <div class="cfcr-fc"><h4>Support</h4><ul><li><a href="#">Contact Us</a></li><li><a href="#">Shipping Policy</a></li><li><a href="#">Wholesale</a></li><li><a href="#">FAQ</a></li></ul></div>
    </div>
    <div class="cfcr-fbot"><span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'Onyx' }} Coffee Roasters.</span><span>Privacy &middot; Terms</span></div>
  </footer>
</div>

{% schema %}
{
  "name": "Coffee Roasters Landing",
  "settings": [
    {"type":"text","id":"promo_text","label":"Promo Bar Text","default":"Complimentary shipping on whole bean orders over $50"},
    {"type":"text","id":"brand_name","label":"Brand Name","default":"Onyx"},
    {"type":"text","id":"hero_tag","label":"Hero Tag","default":"Current Harvest"},
    {"type":"textarea","id":"hero_heading","label":"Hero Heading","default":"Fincas of Antioquia."},
    {"type":"textarea","id":"hero_subtext","label":"Hero Subtext","default":"A strictly high-grown Colombian micro-lot featuring vibrant notes of red currant, brown sugar, and a delicate floral finish."},
    {"type":"text","id":"cta_text","label":"CTA Text","default":"Shop This Micro-Lot"},
    {"type":"collection","id":"featured_collection","label":"Featured Collection"},
    {"type":"textarea","id":"roastery_text","label":"Roastery Section Text","default":"Every small batch is roasted on our vintage Probat in Portland, Oregon. We use careful data logging combined with sensory intuition."}
  ],
  "presets": [{"name":"Coffee Roasters Landing"}]
}
{% endschema %}