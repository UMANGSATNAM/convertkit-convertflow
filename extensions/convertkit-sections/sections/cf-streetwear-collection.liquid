  {%- comment -%} TOP BAR {%- endcomment -%}
  <div class="cf-sw-top">
    <div>SYSTEM.ON // SS-{{ 'now' | date: '%Y' }}</div>
    <div class="cf-sw-top-ticker">
      <span>FREE SHIPPING ₹999+</span>
      <span>LIMITED DROPS ONLY</span>
      <span>NEW COLLAB LIVE NOW</span>
