{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Barlow+Condensed:wght@400;700;900&display=swap');
  .cf-sw*{box-sizing:border-box;margin:0;padding:0}
  .cf-sw{font-family:'Space Mono',monospace;background:#0A0A0A;color:#F0F0F0;overflow-x:hidden}

  /* ═══ TOP BAR ═══ */
  .cf-sw-top{background:#F0F0F0;color:#0A0A0A;padding:8px 5%;display:flex;justify-content:space-between;align-items:center;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase}
  .cf-sw-top-ticker{display:flex;gap:40px;overflow:hidden}
  
  /* ═══ HERO BENTO ═══ */
  .cf-sw-bento{display:grid;grid-template-columns:1fr 360px;grid-template-rows:70vh 30vh;gap:3px;background:#333}
  
  /* Main hero cell */
  .cf-sw-bento-main{grid-row:span 2;position:relative;overflow:hidden;background:#111}
  .cf-sw-bento-main img{width:100%;height:100%;object-fit:cover;opacity:.7;transition:transform 8s linear}
  .cf-sw-bento-main:hover img{transform:scale(1.05)}
  .cf-sw-bento-main::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.95) 0%,rgba(0,0,0,0) 60%)}
  .cf-sw-bento-main-content{position:absolute;bottom:0;left:0;right:0;padding:40px;z-index:2}
  .cf-sw-season{font-size:10px;letter-spacing:4px;text-transform:uppercase;color:#888;margin-bottom:16px}
  .cf-sw-h1{font-family:'Barlow Condensed',sans-serif;font-size:clamp(64px,8vw,110px);font-weight:900;text-transform:uppercase;line-height:.9;margin-bottom:24px}
  .cf-sw-h1 span{color:#F0F0F0}
  .cf-sw-h1 em{font-style:normal;color:transparent;-webkit-text-stroke:2px #F0F0F0;display:block}
  .cf-sw-drop-info{display:flex;gap:30px;align-items:center;flex-wrap:wrap}
  .cf-sw-drop-count{font-size:11px;letter-spacing:2px;color:#999;text-transform:uppercase}
  .cf-sw-drop-count strong{color:#F0F0F0;display:block;font-size:24px;letter-spacing:0}
  .cf-sw-btn{display:inline-block;padding:14px 30px;font-family:'Space Mono',monospace;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:1px;text-decoration:none;border:2px solid #F0F0F0;color:#F0F0F0;transition:all .25s;cursor:pointer;background:transparent}
  .cf-sw-btn:hover,.cf-sw-btn-fill{background:#F0F0F0;color:#0A0A0A}
  .cf-sw-btn-fill:hover{background:transparent;color:#F0F0F0}

  /* Side cells */
  .cf-sw-bento-top{background:#111;position:relative;overflow:hidden;padding:30px}
  .cf-sw-bento-top img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.5}
  .cf-sw-bento-top-content{position:relative;z-index:2}
  .cf-sw-bento-label{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:#888;margin-bottom:8px}
  .cf-sw-bento-title{font-family:'Barlow Condensed',sans-serif;font-size:32px;font-weight:900;text-transform:uppercase;line-height:1}
  .cf-sw-bento-price{font-size:14px;font-weight:700;margin-top:8px;color:#F0F0F0}
  
  .cf-sw-bento-bottom{background:#F0F0F0;color:#0A0A0A;padding:30px;display:flex;flex-direction:column;justify-content:space-between}
  .cf-sw-bento-bottom h3{font-family:'Barlow Condensed',sans-serif;font-size:28px;font-weight:900;text-transform:uppercase}
  .cf-sw-count-badge{background:#0A0A0A;color:#F0F0F0;font-size:11px;font-weight:700;letter-spacing:2px;padding:6px 14px;text-transform:uppercase;display:inline-block}

  /* ═══ MARQUEE ═══ */
  .cf-sw-marquee{border-top:2px solid #F0F0F0;border-bottom:2px solid #F0F0F0;overflow:hidden;padding:14px 0;margin:0}
  .cf-sw-marquee-track{display:inline-flex;animation:sw-marquee 25s linear infinite;white-space:nowrap}
  .cf-sw-marquee-track span{font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:700;text-transform:uppercase;letter-spacing:3px;padding:0 50px;color:#F0F0F0}
  .cf-sw-marquee-track span::after{content:'★';margin-left:50px;color:#555}
  @keyframes sw-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  /* ═══ PRODUCT CARDS ═══ */
  .cf-sw-products{padding:60px 4%}
  .cf-sw-prod-header{display:grid;grid-template-columns:1fr auto;align-items:center;margin-bottom:40px;border-bottom:2px solid #F0F0F0;padding-bottom:20px}
  .cf-sw-prod-header h2{font-family:'Barlow Condensed',sans-serif;font-size:48px;font-weight:900;text-transform:uppercase;letter-spacing:2px}
  .cf-sw-prod-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;background:#333}

  /* Streetwear card: border-heavy, mono font, numbered */
  .cf-sw-card{background:#111;text-decoration:none;color:#F0F0F0;position:relative;display:flex;flex-direction:column;overflow:hidden}
  .cf-sw-card-img{aspect-ratio:4/5;overflow:hidden;position:relative}
  .cf-sw-card-img img{width:100%;height:100%;object-fit:cover;filter:grayscale(20%);transition:filter .4s,transform .6s}
  .cf-sw-card:hover .cf-sw-card-img img{filter:grayscale(0%);transform:scale(1.04)}
  .cf-sw-card-num{position:absolute;top:12px;left:12px;font-family:'Space Mono',monospace;font-size:11px;font-weight:700;color:#888;letter-spacing:2px;z-index:2}
  .cf-sw-card-sold{position:absolute;top:12px;right:12px;background:#F0F0F0;color:#0A0A0A;font-family:'Space Mono',monospace;font-size:10px;font-weight:700;padding:3px 8px;letter-spacing:1px;z-index:2;text-transform:uppercase}
  .cf-sw-card-info{padding:16px;border-top:2px solid #222}
  .cf-sw-card-brand{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:#555;margin-bottom:6px}
  .cf-sw-card-title{font-family:'Barlow Condensed',sans-serif;font-size:24px;font-weight:900;text-transform:uppercase;line-height:1;margin-bottom:10px}
  .cf-sw-card-footer{display:flex;justify-content:space-between;align-items:center}
  .cf-sw-card-price{font-size:16px;font-weight:700;letter-spacing:1px}
  .cf-sw-card-add{background:#F0F0F0;color:#0A0A0A;border:none;padding:6px 14px;font-family:'Space Mono',monospace;font-size:11px;font-weight:700;cursor:pointer;text-transform:uppercase;letter-spacing:1px;transition:all .2s}
  .cf-sw-card-add:hover{background:#0A0A0A;color:#F0F0F0;outline:1px solid #F0F0F0}

  /* ═══ EDITORIAL STRIP ═══ */
  .cf-sw-editorial{display:grid;grid-template-columns:1fr 1fr;border-top:2px solid #222;border-bottom:2px solid #222}
  .cf-sw-editorial-text{padding:80px 60px;display:flex;flex-direction:column;justify-content:center}
  .cf-sw-editorial-text .sub{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#555;margin-bottom:20px}
  .cf-sw-editorial-text h2{font-family:'Barlow Condensed',sans-serif;font-size:clamp(48px,6vw,80px);font-weight:900;text-transform:uppercase;line-height:1;margin-bottom:24px}
  .cf-sw-editorial-text p{font-size:14px;color:#888;line-height:1.8;max-width:400px;margin-bottom:30px}
  .cf-sw-editorial-img{background:#111;overflow:hidden;min-height:500px}
  .cf-sw-editorial-img img{width:100%;height:100%;object-fit:cover;opacity:.8;transition:transform .8s ease}
  .cf-sw-editorial:hover .cf-sw-editorial-img img{transform:scale(1.04)}

  @media(max-width:900px){
    .cf-sw-bento{grid-template-columns:1fr;grid-template-rows:80vh auto auto}
    .cf-sw-bento-main{grid-row:1}
    .cf-sw-prod-grid{grid-template-columns:repeat(2,1fr)}
    .cf-sw-editorial{grid-template-columns:1fr}
    .cf-sw-editorial-img{min-height:300px}
    .cf-sw-editorial-text{padding:40px 30px}
  }
{% endstyle %}

