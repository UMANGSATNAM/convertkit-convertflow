{% comment %}
  ConvertFlow — Streetwear Collection Page
  Grid layout with heavy borders, monochrome aesthetic.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap');

  :root {
    --sw-primary: {{ section.settings.color_primary | default: '#FF3366' }};
    --sw-bg: {{ section.settings.color_bg | default: '#0A0A0A' }};
    --sw-surface: {{ section.settings.color_surface | default: '#121212' }};
    --sw-text: {{ section.settings.color_text | default: '#FFFFFF' }};
    --sw-border: rgba(255, 255, 255, 0.15);
    --sw-font-heading: 'Space Grotesk', sans-serif;
    --sw-font-mono: 'Space Mono', monospace;
  }

  .cf-sw-c * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-sw-c { font-family: var(--sw-font-heading); background: var(--sw-bg); color: var(--sw-text); border-top: 1px solid var(--sw-border); }
  
  .cf-sw-c-header { padding: 60px 5%; border-bottom: 1px solid var(--sw-border); display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px; }
  .cf-sw-c-header h1 { font-size: clamp(40px, 6vw, 80px); font-weight: 700; text-transform: uppercase; line-height: 1; margin-bottom: 10px; }
  .cf-sw-c-header p { font-family: var(--sw-font-mono); font-size: 14px; color: #888; max-width: 400px; }
  
  .cf-sw-c-meta { font-family: var(--sw-font-mono); font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--sw-primary); }
  
  /* Toolbar */
  .cf-sw-c-toolbar { display: flex; border-bottom: 1px solid var(--sw-border); }
  .cf-sw-c-filter-group { display: flex; overflow-x: auto; flex: 1; border-right: 1px solid var(--sw-border); }
  .cf-sw-c-filter { padding: 16px 24px; font-family: var(--sw-font-mono); font-size: 12px; font-weight: 700; color: #888; text-transform: uppercase; cursor: pointer; border-right: 1px solid var(--sw-border); white-space: nowrap; transition: all 0.2s; }
  .cf-sw-c-filter:hover, .cf-sw-c-filter.active { color: var(--sw-text); background: var(--sw-surface); }
  .cf-sw-c-sort { padding: 16px 24px; font-family: var(--sw-font-mono); font-size: 12px; font-weight: 700; color: var(--sw-text); background: transparent; border: none; text-transform: uppercase; outline: none; cursor: pointer; }
  
  /* Grid */
  .cf-sw-c-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  
  .cf-sw-prod { border-right: 1px solid var(--sw-border); border-bottom: 1px solid var(--sw-border); display: flex; flex-direction: column; text-decoration: none; color: var(--sw-text); transition: background 0.3s; position: relative; }
  .cf-sw-prod:hover { background: var(--sw-surface); }
  .cf-sw-prod:nth-child(4n) { border-right: none; }
  
  .cf-sw-prod-img { aspect-ratio: 4/5; border-bottom: 1px solid var(--sw-border); overflow: hidden; position: relative; }
  .cf-sw-prod-img img { width: 100%; height: 100%; object-fit: cover; }
  .cf-sw-prod-badge { position: absolute; top: 12px; left: 12px; background: var(--sw-text); color: var(--sw-bg); font-family: var(--sw-font-mono); font-size: 10px; font-weight: 700; padding: 4px 8px; text-transform: uppercase; }
  
  .cf-sw-prod-info { padding: 20px; display: flex; flex-direction: column; justify-content: space-between; flex: 1; }
  .cf-sw-prod-title { font-size: 16px; font-weight: 700; text-transform: uppercase; margin-bottom: 8px; }
  .cf-sw-prod-price { font-family: var(--sw-font-mono); font-size: 14px; color: var(--sw-primary); }
  
  .cf-sw-c-empty { padding: 100px 20px; text-align: center; color: #888; grid-column: 1 / -1; font-family: var(--sw-font-mono); font-size: 14px; text-transform: uppercase; }

  @media(max-width: 1200px) {
    .cf-sw-c-grid { grid-template-columns: repeat(3, 1fr); }
    .cf-sw-prod:nth-child(4n) { border-right: 1px solid var(--sw-border); }
    .cf-sw-prod:nth-child(3n) { border-right: none; }
  }
  @media(max-width: 900px) {
    .cf-sw-c-grid { grid-template-columns: repeat(2, 1fr); }
    .cf-sw-prod:nth-child(3n) { border-right: 1px solid var(--sw-border); }
    .cf-sw-prod:nth-child(2n) { border-right: none; }
  }
  @media(max-width: 600px) {
    .cf-sw-c-grid { grid-template-columns: 1fr; }
    .cf-sw-prod { border-right: none !important; }
  }
{% endstyle %}

<div class="cf-sw-c">
  <div class="cf-sw-c-header">
    <div>
      <h1>{{ collection.title | default: 'COLLECTION [01]' }}</h1>
      {% if collection.description != blank %}
        <p>{{ collection.description | strip_html | truncate: 150 }}</p>
      {% endif %}
    </div>
    <div class="cf-sw-c-meta">ITEMS: {{ collection.products_count | default: 'XX' }}</div>
  </div>
  
  <div class="cf-sw-c-toolbar">
    <div class="cf-sw-c-filter-group">
      <div class="cf-sw-c-filter active">ALL</div>
      <div class="cf-sw-c-filter">T-SHIRTS</div>
      <div class="cf-sw-c-filter">HOODIES</div>
      <div class="cf-sw-c-filter">CARGO</div>
      <div class="cf-sw-c-filter">ACCESSORIES</div>
    </div>
    <select class="cf-sw-c-sort">
      <option>SORT: LATEST</option>
      <option>SORT: PRICE ASC</option>
      <option>SORT: PRICE DESC</option>
    </select>
  </div>
  
  <div class="cf-sw-c-grid">
    {% if collection.products.size > 0 %}
      {% for product in collection.products %}
        <a href="{{ product.url }}" class="cf-sw-prod">
          <div class="cf-sw-prod-img">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title }}">
            {% else %}
              <div style="background:#222; width:100%; height:100%;"></div>
            {% endif %}
            
            {% if product.available == false %}
              <span class="cf-sw-prod-badge" style="background:#444; color:#fff;">SOLD OUT</span>
            {% elsif product.compare_at_price > product.price %}
              <span class="cf-sw-prod-badge">SALE</span>
            {% endif %}
          </div>
          <div class="cf-sw-prod-info">
            <div class="cf-sw-prod-title">{{ product.title }}</div>
            <div class="cf-sw-prod-price">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..8) %}
        <a href="#" class="cf-sw-prod">
          <div class="cf-sw-prod-img"><div style="background:#1a1a1a; width:100%; height:100%;"></div></div>
          <div class="cf-sw-prod-info">
            <div class="cf-sw-prod-title">Graphic Tee 0{{ i }}</div>
            <div class="cf-sw-prod-price">$45.00</div>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

</div>

</div>

{% schema %}
{
  "name": "CF Streetwear Collection",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Accent Color", "default": "#FF3366" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#0A0A0A" },
    { "type": "color", "id": "color_surface", "label": "Surface", "default": "#121212" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "CF Streetwear Collection" }
  ]
}
{% endschema %}


