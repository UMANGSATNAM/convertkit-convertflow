{% comment %}ConvertFlow - Home Furniture Landing | HAVEN style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Manrope:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
.cfhf{--oak:#B5834A;--smoke:#F0EDE8;--dark:#1E1A16;--text:#2D2720;--muted:#7D7068;--border:#E0D8CC;--light:#FAF8F5;}
.cfhf *{box-sizing:border-box;margin:0;padding:0;}
.cfhf{font-family:'Manrope',sans-serif;font-size:15px;color:var(--text);background:var(--light);-webkit-font-smoothing:antialiased;}
.cfhf h1,.cfhf h2,.cfhf h3,.cfhf h4{font-family:'Libre Baskerville',serif;}
.cfhf-promo{background:var(--dark);color:rgba(255,255,255,.6);text-align:center;padding:10px;font-size:12px;letter-spacing:2px;text-transform:uppercase;}
.cfhf-header{padding:24px 60px;background:var(--light);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);}
.cfhf-brand{font-family:'Libre Baskerville',serif;font-size:26px;color:var(--dark);text-decoration:none;letter-spacing:1px;display:flex;flex-direction:column;}
.cfhf-brand-tag{font-size:9px;letter-spacing:4px;text-transform:uppercase;color:var(--oak);font-family:'Manrope',sans-serif;font-weight:600;}
.cfhf-nav{display:flex;gap:32px;list-style:none;}
.cfhf-nav a{font-size:13px;font-weight:500;color:var(--text);text-decoration:none;transition:color .2s;}
.cfhf-nav a:hover{color:var(--oak);}
.cfhf-hright{display:flex;gap:16px;align-items:center;}
.cfhf-hcta{background:var(--dark);color:#fff;padding:12px 28px;font-size:12px;font-weight:700;letter-spacing:1px;text-decoration:none;transition:background .2s;}
.cfhf-hcta:hover{background:var(--oak);}
.cfhf-hero{display:grid;grid-template-columns:1fr 1fr;min-height:90vh;border-bottom:1px solid var(--border);}
.cfhf-hero-left{padding:100px 80px;display:flex;flex-direction:column;justify-content:center;}
.cfhf-overline{font-size:11px;font-weight:600;letter-spacing:4px;text-transform:uppercase;color:var(--oak);margin-bottom:24px;}
.cfhf-hero-left h1{font-size:68px;line-height:1.05;margin-bottom:28px;color:var(--dark);}
.cfhf-hero-left h1 em{font-style:italic;color:var(--oak);}
.cfhf-hero-left>p{font-size:17px;color:var(--muted);line-height:1.9;max-width:420px;margin-bottom:44px;}
.cfhf-actions{display:flex;flex-direction:column;gap:16px;max-width:260px;}
.cfhf-btn-dark{background:var(--dark);color:#fff;padding:18px 40px;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;text-decoration:none;text-align:center;transition:background .2s;}
.cfhf-btn-dark:hover{background:var(--oak);}
.cfhf-btn-oak{background:transparent;color:var(--oak);border:1.5px solid var(--oak);padding:16px 40px;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;text-decoration:none;text-align:center;transition:all .2s;}
.cfhf-btn-oak:hover{background:var(--oak);color:#fff;}
.cfhf-stats{display:flex;gap:40px;margin-top:60px;padding-top:40px;border-top:1px solid var(--border);}
.cfhf-stat strong{display:block;font-family:'Libre Baskerville',serif;font-size:28px;color:var(--dark);}
.cfhf-stat span{font-size:11px;text-transform:uppercase;letter-spacing:2px;color:var(--muted);}
.cfhf-hero-right{background:var(--smoke);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.cfhf-hero-right::before{content:'';position:absolute;width:500px;height:500px;border-radius:50%;border:1px solid rgba(181,131,74,.15);top:50%;left:50%;transform:translate(-50%,-50%);}
.cfhf-rooms{padding:100px 60px;max-width:1400px;margin:0 auto;}
.cfhf-sh{text-align:center;margin-bottom:60px;}
.cfhf-sh h2{font-size:44px;color:var(--dark);margin-bottom:12px;}
.cfhf-sh p{font-size:16px;color:var(--muted);max-width:480px;margin:0 auto;}
.cfhf-room-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
.cfhf-room-card{position:relative;overflow:hidden;text-decoration:none;color:#fff;display:block;aspect-ratio:1;}
.cfhf-room-card:first-child{grid-column:span 2;aspect-ratio:16/9;}
.cfhf-rc-bg{width:100%;height:100%;transition:transform .8s ease;}
.cfhf-room-card:hover .cfhf-rc-bg{transform:scale(1.04);}
.cfhf-rc-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.55) 0%,transparent 50%);display:flex;flex-direction:column;justify-content:flex-end;padding:28px;}
.cfhf-rc-label{font-family:'Libre Baskerville',serif;font-size:20px;margin-bottom:4px;}
.cfhf-rc-cta{font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.7);}
.cfhf-products{padding:0 60px 100px;max-width:1400px;margin:0 auto;}
.cfhf-ph{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:50px;}
.cfhf-ph h2{font-size:44px;color:var(--dark);}
.cfhf-ph a{font-size:12px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--oak);text-decoration:none;border-bottom:1px solid var(--oak);padding-bottom:3px;}
.cfhf-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;}
.cfhf-prod-card{background:#fff;border:1px solid var(--border);transition:all .35s;overflow:hidden;}
.cfhf-prod-card:hover{box-shadow:0 16px 48px rgba(30,26,22,.06);transform:translateY(-6px);}
.cfhf-pc-img{aspect-ratio:1;background:var(--smoke);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.cfhf-pc-img img{width:100%;height:100%;object-fit:cover;}
.cfhf-pc-badge{position:absolute;top:16px;left:16px;font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:5px 14px;}
.cfhf-badge-new{background:var(--dark);color:#fff;}
.cfhf-badge-sale{background:var(--oak);color:#fff;}
.cfhf-pc-info{padding:24px;}
.cfhf-pc-cat{font-size:10px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--oak);margin-bottom:8px;}
.cfhf-pc-name{font-family:'Libre Baskerville',serif;font-size:20px;margin-bottom:6px;color:var(--dark);}
.cfhf-pc-mat{font-size:13px;color:var(--muted);font-style:italic;margin-bottom:16px;}
.cfhf-pc-footer{display:flex;justify-content:space-between;align-items:center;padding-top:16px;border-top:1px solid var(--border);}
.cfhf-pc-price{font-family:'Libre Baskerville',serif;font-size:22px;color:var(--dark);}
.cfhf-pc-old{font-size:13px;color:var(--muted);text-decoration:line-through;margin-left:8px;}
.cfhf-pc-atc{background:transparent;color:var(--dark);border:1px solid var(--dark);padding:10px 20px;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;cursor:pointer;font-family:'Manrope',sans-serif;transition:all .2s;}
.cfhf-pc-atc:hover{background:var(--dark);color:#fff;}
.cfhf-hiw{background:var(--dark);padding:100px 60px;}
.cfhf-hiw-inner{max-width:1000px;margin:0 auto;text-align:center;}
.cfhf-hiw h2{font-size:44px;color:#fff;margin-bottom:16px;}
.cfhf-hiw-sub{font-size:16px;color:rgba(255,255,255,.4);margin-bottom:70px;}
.cfhf-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:60px;}
.cfhf-step-num{width:80px;height:80px;border-radius:50%;border:1px solid rgba(181,131,74,.4);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-family:'Libre Baskerville',serif;font-size:28px;color:var(--oak);}
.cfhf-step h4{font-family:'Libre Baskerville',serif;font-size:18px;color:#fff;margin-bottom:10px;}
.cfhf-step p{font-size:14px;color:rgba(255,255,255,.4);line-height:1.8;}
.cfhf-footer{padding:80px 60px 40px;background:var(--light);border-top:1px solid var(--border);}
.cfhf-fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;padding-bottom:60px;border-bottom:1px solid var(--border);}
.cfhf-fb p{font-size:13px;color:var(--muted);line-height:1.9;max-width:270px;margin-top:16px;}
.cfhf-fc h4{font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--muted);margin-bottom:20px;}
.cfhf-fc ul{list-style:none;}
.cfhf-fc li{margin-bottom:10px;}
.cfhf-fc a{color:var(--text);text-decoration:none;font-size:14px;transition:color .2s;}
.cfhf-fc a:hover{color:var(--oak);}
.cfhf-fbot{display:flex;justify-content:space-between;padding-top:28px;font-size:11px;color:var(--muted);letter-spacing:1px;}
@media(max-width:1024px){.cfhf-hero{grid-template-columns:1fr;min-height:auto}.cfhf-hero-right{display:none}.cfhf-grid,.cfhf-room-grid{grid-template-columns:1fr 1fr}.cfhf-room-card:first-child{grid-column:span 2}.cfhf-fg{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cfhf-header{padding:16px 20px}.cfhf-nav{display:none}.cfhf-hero-left{padding:60px 20px}.cfhf-hero-left h1{font-size:44px}.cfhf-rooms,.cfhf-products{padding:60px 20px}.cfhf-grid,.cfhf-room-grid{grid-template-columns:1fr}.cfhf-room-card:first-child{grid-column:span 1}.cfhf-hiw{padding:60px 20px}.cfhf-steps{grid-template-columns:1fr;gap:40px}.cfhf-fg{grid-template-columns:1fr;gap:40px}.cfhf-footer{padding:60px 20px 30px}}
</style>

<div class="cfhf">
  <div class="cfhf-promo">{{ section.settings.promo_text | default: 'Complimentary white-glove delivery and assembly on all furniture orders.' }}</div>
  <header class="cfhf-header">
    <a href="{{ routes.root_url }}" class="cfhf-brand">{{ section.settings.brand_name | default: 'HAVEN' }}<span class="cfhf-brand-tag">{{ section.settings.brand_tagline | default: 'Premium Furniture & Living' }}</span></a>
    <ul class="cfhf-nav"><li><a href="#">Living Room</a></li><li><a href="#">Bedroom</a></li><li><a href="#">Dining</a></li><li><a href="#">Home Office</a></li><li><a href="#">Outdoor</a></li></ul>
    <div class="cfhf-hright"><a href="{{ routes.cart_url }}" class="cfhf-hcta">View Cart</a></div>
  </header>

  <section class="cfhf-hero">
    <div class="cfhf-hero-left">
      <span class="cfhf-overline">{{ section.settings.hero_overline | default: '2025 — The Natural Edit' }}</span>
      <h1>{{ section.settings.hero_heading | default: 'Rooms That Feel Like <em>Home</em>' }}</h1>
      <p>{{ section.settings.hero_subtext | default: 'Solid wood furniture crafted by eighth-generation artisans in Jodhpur. Designed to age gracefully and tell a story with every scratch.' }}</p>
      <div class="cfhf-actions">
        <a href="{{ section.settings.cta1_url | default: routes.collections_url }}" class="cfhf-btn-dark">{{ section.settings.cta1_text | default: 'Explore Collections' }}</a>
        <a href="{{ section.settings.cta2_url | default: '#' }}" class="cfhf-btn-oak">{{ section.settings.cta2_text | default: 'Book Free Design Call' }}</a>
      </div>
      <div class="cfhf-stats">
        <div class="cfhf-stat"><strong>18+</strong><span>Year Legacy</span></div>
        <div class="cfhf-stat"><strong>40K+</strong><span>Happy Homes</span></div>
        <div class="cfhf-stat"><strong>100%</strong><span>Solid Wood</span></div>
      </div>
    </div>
    <div class="cfhf-hero-right">
      <svg width="260" height="260" fill="none" stroke="#B5834A" stroke-width="0.5" viewBox="0 0 24 24" opacity="0.15"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    </div>
  </section>

  <section class="cfhf-rooms">
    <div class="cfhf-sh"><h2>Shop the Look</h2><p>Curated room aesthetics to inspire your next transformation.</p></div>
    <div class="cfhf-room-grid">
      <div class="cfhf-room-card"><div class="cfhf-rc-bg" style="background:linear-gradient(135deg,#2D2720,#4A3828);height:100%;"></div><div class="cfhf-rc-overlay"><div class="cfhf-rc-label">The Walnut Living Room</div><div class="cfhf-rc-cta">Shop This Look &rarr;</div></div></div>
      <div class="cfhf-room-card"><div class="cfhf-rc-bg" style="background:linear-gradient(135deg,#3D3028,#5A4030);height:100%;"></div><div class="cfhf-rc-overlay"><div class="cfhf-rc-label">Calm Bedroom</div><div class="cfhf-rc-cta">Shop This Look &rarr;</div></div></div>
      <div class="cfhf-room-card"><div class="cfhf-rc-bg" style="background:linear-gradient(135deg,#28302D,#3A4A40);height:100%;"></div><div class="cfhf-rc-overlay"><div class="cfhf-rc-label">Home Office</div><div class="cfhf-rc-cta">Shop This Look &rarr;</div></div></div>
    </div>
  </section>

  <section class="cfhf-products">
    <div class="cfhf-ph"><h2>Featured Pieces</h2><a href="{{ routes.collections_url }}">View All &rarr;</a></div>
    <div class="cfhf-grid">
      {% assign col = collections[section.settings.featured_collection] %}
      {% if col and col.products.size > 0 %}
        {% for p in col.products limit: 3 %}
          <div class="cfhf-prod-card">
            <div class="cfhf-pc-img">
              {% if p.featured_image %}<img src="{{ p.featured_image | img_url: '600x' }}" alt="{{ p.title }}">{% else %}<svg width="80" height="80" fill="none" stroke="#B5834A" stroke-width="0.8" viewBox="0 0 24 24" opacity="0.4"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>{% endif %}
              {% if p.compare_at_price > p.price %}<span class="cfhf-pc-badge cfhf-badge-sale">Sale</span>{% else %}<span class="cfhf-pc-badge cfhf-badge-new">New</span>{% endif %}
            </div>
            <div class="cfhf-pc-info">
              <div class="cfhf-pc-cat">{{ p.type | default: 'Furniture' }}</div>
              <div class="cfhf-pc-name">{{ p.title }}</div>
              <div class="cfhf-pc-mat">{{ p.metafields.custom.material | default: 'Solid Wood · Handcrafted' }}</div>
              <div class="cfhf-pc-footer"><div class="cfhf-pc-price">{{ p.price | money }}{% if p.compare_at_price > p.price %}<span class="cfhf-pc-old">{{ p.compare_at_price | money }}</span>{% endif %}</div><button class="cfhf-pc-atc" data-variant-id="{{ p.variants.first.id }}">Add to Cart</button></div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="cfhf-prod-card"><div class="cfhf-pc-img"><span class="cfhf-pc-badge cfhf-badge-new">New</span><svg width="80" height="80" fill="none" stroke="#B5834A" stroke-width="0.8" viewBox="0 0 24 24" opacity="0.35"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div><div class="cfhf-pc-info"><div class="cfhf-pc-cat">Sofas &amp; Seating</div><div class="cfhf-pc-name">Ashwood Three-Seater</div><div class="cfhf-pc-mat">Solid Ash wood &middot; Organic linen &middot; Brass legs</div><div class="cfhf-pc-footer"><div class="cfhf-pc-price">&#8377;89,000<span class="cfhf-pc-old">&#8377;1,05,000</span></div><button class="cfhf-pc-atc">Add to Cart</button></div></div></div>
        <div class="cfhf-prod-card"><div class="cfhf-pc-img" style="background:#E8E2D5;"><span class="cfhf-pc-badge cfhf-badge-sale">Sale</span><svg width="80" height="80" fill="none" stroke="#B5834A" stroke-width="0.8" viewBox="0 0 24 24" opacity="0.35"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg></div><div class="cfhf-pc-info"><div class="cfhf-pc-cat">Dining</div><div class="cfhf-pc-name">Mango Wood Dining Set</div><div class="cfhf-pc-mat">Recycled Mango wood &middot; 6-seat &middot; Hand-carved</div><div class="cfhf-pc-footer"><div class="cfhf-pc-price">&#8377;1,24,000<span class="cfhf-pc-old">&#8377;1,45,000</span></div><button class="cfhf-pc-atc">Add to Cart</button></div></div></div>
        <div class="cfhf-prod-card"><div class="cfhf-pc-img" style="background:#EDE8E0;"><svg width="80" height="80" fill="none" stroke="#B5834A" stroke-width="0.8" viewBox="0 0 24 24" opacity="0.35"><path d="M20 9H4l1 12h14z"/><path d="M8 9V6a4 4 0 018 0v3"/></svg></div><div class="cfhf-pc-info"><div class="cfhf-pc-cat">Storage</div><div class="cfhf-pc-name">Heritage Teak Wardrobe</div><div class="cfhf-pc-mat">Grade-A Teak &middot; Soft-close hinges &middot; 4-door</div><div class="cfhf-pc-footer"><div class="cfhf-pc-price">&#8377;2,10,000</div><button class="cfhf-pc-atc">Add to Cart</button></div></div></div>
      {% endif %}
    </div>
  </section>

  <div class="cfhf-hiw">
    <div class="cfhf-hiw-inner">
      <h2>Your Journey to a Beautiful Home</h2>
      <p class="cfhf-hiw-sub">Simple, personal, and delivered to your doorstep.</p>
      <div class="cfhf-steps">
        <div class="cfhf-step"><div class="cfhf-step-num">01</div><h4>Design Consultation</h4><p>Book a free 30-minute call with our in-house interior designer to discuss your vision and space.</p></div>
        <div class="cfhf-step"><div class="cfhf-step-num">02</div><h4>Custom Crafting</h4><p>Your piece is handcrafted to order by our master carpenters in Jodhpur, India &mdash; delivered in 4&ndash;6 weeks.</p></div>
        <div class="cfhf-step"><div class="cfhf-step-num">03</div><h4>White-Glove Delivery</h4><p>We handle delivery, assembly, and removal of packaging. You just sit back and enjoy your beautiful new home.</p></div>
      </div>
    </div>
  </div>

  <footer class="cfhf-footer">
    <div class="cfhf-fg">
      <div class="cfhf-fb"><a href="{{ routes.root_url }}" class="cfhf-brand">{{ section.settings.brand_name | default: 'HAVEN' }}<span class="cfhf-brand-tag">{{ section.settings.brand_tagline | default: 'Premium Furniture & Living' }}</span></a><p>Premium Indian craftsmanship meeting global design standards. Heirloom furniture for the modern family.</p></div>
      <div class="cfhf-fc"><h4>Collections</h4><ul><li><a href="#">Living Room</a></li><li><a href="#">Bedroom</a></li><li><a href="#">Dining</a></li><li><a href="#">Home Office</a></li></ul></div>
      <div class="cfhf-fc"><h4>Services</h4><ul><li><a href="#">Design Consultation</a></li><li><a href="#">Customisation</a></li><li><a href="#">Assembly</a></li></ul></div>
      <div class="cfhf-fc"><h4>Support</h4><ul><li><a href="#">Care Guide</a></li><li><a href="#">Shipping</a></li><li><a href="#">Returns</a></li><li><a href="#">Contact</a></li></ul></div>
    </div>
    <div class="cfhf-fbot"><span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'Haven Furniture' }} Pvt. Ltd.</span><span>Privacy &middot; Terms</span></div>
  </footer>
</div>

{% schema %}
{
  "name": "Home Furniture Landing",
  "settings": [
    {"type":"text","id":"promo_text","label":"Promo Bar Text","default":"Complimentary white-glove delivery and assembly on all furniture orders."},
    {"type":"text","id":"brand_name","label":"Brand Name","default":"HAVEN"},
    {"type":"text","id":"brand_tagline","label":"Brand Tagline","default":"Premium Furniture & Living"},
    {"type":"text","id":"hero_overline","label":"Hero Overline","default":"2025 — The Natural Edit"},
    {"type":"textarea","id":"hero_heading","label":"Hero Heading","default":"Rooms That Feel Like Home"},
    {"type":"textarea","id":"hero_subtext","label":"Hero Subtext","default":"Solid wood furniture crafted by eighth-generation artisans in Jodhpur."},
    {"type":"text","id":"cta1_text","label":"CTA 1 Text","default":"Explore Collections"},
    {"type":"url","id":"cta1_url","label":"CTA 1 URL"},
    {"type":"text","id":"cta2_text","label":"CTA 2 Text","default":"Book Free Design Call"},
    {"type":"url","id":"cta2_url","label":"CTA 2 URL"},
    {"type":"collection","id":"featured_collection","label":"Featured Collection"}
  ],
  "presets": [{"name":"Home Furniture Landing"}]
}
{% endschema %}