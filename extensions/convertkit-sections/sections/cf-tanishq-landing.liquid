{% comment %}
  ConvertFlow — Tanishq-Style Jewellery Landing Page
  Premium luxury jewellery section inspired by tanishq.co.in
  Self-contained with all CSS/JS — inject into any Shopify theme.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap');

  /* ── Reset & Base ── */
  .cf-jewel * { margin: 0; padding: 0; box-sizing: border-box; }
  .cf-jewel {
    font-family: 'DM Sans', 'Segoe UI', sans-serif;
    color: #2C1810;
    line-height: 1.6;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    background: #FFFCF5;
  }
  .cf-jewel h1, .cf-jewel h2, .cf-jewel h3 {
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
  }

  /* ── Topmost Info Strip ── */
  .cfj-info-strip {
    background: {{ section.settings.strip_bg | default: '#2C1810' }};
    color: #D4AF37;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 40px;
    padding: 8px 16px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .cfj-info-strip-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cfj-info-strip-item svg { flex-shrink: 0; }
  .cfj-info-strip-divider {
    width: 1px;
    height: 14px;
    background: rgba(212,175,55,0.3);
  }

  /* ── Announcement Bar ── */
  .cfj-announce {
    background: linear-gradient(90deg, #D4AF37 0%, #F5D060 50%, #D4AF37 100%);
    color: #2C1810;
    text-align: center;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .cfj-announce a {
    color: #2C1810;
    text-decoration: underline;
    font-weight: 800;
  }

  /* ── Hero Banner ── */
  .cfj-hero {
    position: relative;
    width: 100%;
    min-height: 600px;
    background: {{ section.settings.hero_bg | default: 'linear-gradient(135deg, #1a0f0a 0%, #2C1810 40%, #3d2317 100%)' }};
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .cfj-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 70% 50%, rgba(212,175,55,0.08) 0%, transparent 60%);
    pointer-events: none;
  }
  .cfj-hero-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 80px 48px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    width: 100%;
    position: relative;
    z-index: 1;
  }
  .cfj-hero-overline {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #D4AF37;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
    margin-bottom: 20px;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-hero-overline::before,
  .cfj-hero-overline::after {
    content: '';
    width: 32px;
    height: 1px;
    background: #D4AF37;
  }
  .cfj-hero h1 {
    font-size: 54px;
    font-weight: 700;
    line-height: 1.15;
    color: #FFFCF5;
    margin-bottom: 20px;
    letter-spacing: -0.5px;
  }
  .cfj-hero h1 span {
    color: #D4AF37;
    font-style: italic;
  }
  .cfj-hero-sub {
    font-size: 17px;
    color: rgba(255,252,245,0.7);
    margin-bottom: 36px;
    max-width: 460px;
    line-height: 1.8;
  }
  .cfj-hero-ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .cfj-hero-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, #D4AF37, #C5A028);
    color: #2C1810;
    padding: 18px 40px;
    border-radius: 0;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-hero-cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(212,175,55,0.3);
    background: linear-gradient(135deg, #E5C040, #D4AF37);
  }
  .cfj-hero-cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    color: #D4AF37;
    padding: 17px 40px;
    border: 1.5px solid #D4AF37;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-hero-cta-secondary:hover {
    background: rgba(212,175,55,0.1);
  }
  .cfj-hero-img-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .cfj-hero-img-wrap img {
    width: 100%;
    max-width: 520px;
    height: auto;
    border-radius: 0;
    object-fit: cover;
  }
  .cfj-hero-float {
    position: absolute;
    background: rgba(255,252,245,0.95);
    backdrop-filter: blur(10px);
    padding: 16px 24px;
    box-shadow: 0 8px 40px rgba(0,0,0,0.15);
    font-size: 13px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 14px;
    animation: cfj-float 4s ease-in-out infinite;
    border: 1px solid rgba(212,175,55,0.15);
  }
  .cfj-hero-float.top-right { top: 30px; right: -20px; }
  .cfj-hero-float.bottom-left { bottom: 40px; left: -20px; animation-delay: 2s; }
  .cfj-float-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #D4AF37, #F5D060);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2C1810;
  }
  .cfj-float-label { font-size: 11px; color: #999; letter-spacing: 0.5px; }
  .cfj-float-val { font-weight: 800; color: #2C1810; font-size: 15px; }

  @keyframes cfj-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  /* ── Trust Bar ── */
  .cfj-trust-bar {
    background: #FFFCF5;
    border-top: 1px solid rgba(212,175,55,0.15);
    border-bottom: 1px solid rgba(212,175,55,0.15);
    padding: 20px 24px;
  }
  .cfj-trust-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .cfj-trust-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    font-weight: 600;
    color: #2C1810;
    letter-spacing: 0.3px;
  }
  .cfj-trust-icon {
    color: #D4AF37;
    display: flex;
    align-items: center;
  }

  /* ── Section Headings ── */
  .cfj-section-head {
    text-align: center;
    margin-bottom: 56px;
  }
  .cfj-section-head .cfj-overline {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #D4AF37;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-section-head .cfj-overline::before,
  .cfj-section-head .cfj-overline::after {
    content: '';
    width: 40px;
    height: 1px;
    background: #D4AF37;
  }
  .cfj-section-head h2 {
    font-size: 40px;
    font-weight: 700;
    color: #2C1810;
    margin-bottom: 14px;
    letter-spacing: -0.3px;
    line-height: 1.2;
  }
  .cfj-section-head p {
    font-size: 16px;
    color: #8B7355;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ── Collections Grid ── */
  .cfj-collections {
    padding: 90px 48px;
    max-width: 1320px;
    margin: 0 auto;
  }
  .cfj-coll-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .cfj-coll-card {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3/4;
    cursor: pointer;
    text-decoration: none;
    color: #fff;
    display: block;
    background: #f5efe6;
  }
  .cfj-coll-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  .cfj-coll-card:hover img { transform: scale(1.06); }
  .cfj-coll-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(44,24,16,0.75) 0%, rgba(44,24,16,0.1) 50%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px;
    transition: background 0.4s ease;
  }
  .cfj-coll-card:hover .cfj-coll-overlay {
    background: linear-gradient(to top, rgba(44,24,16,0.85) 0%, rgba(44,24,16,0.2) 50%, transparent 100%);
  }
  .cfj-coll-overlay h3 {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 4px;
    letter-spacing: 0.3px;
  }
  .cfj-coll-overlay span {
    font-size: 12px;
    opacity: 0.8;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-coll-shine {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 36px;
    height: 36px;
    background: rgba(212,175,55,0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .cfj-coll-card:hover .cfj-coll-shine { opacity: 1; }

  /* ── Bestseller Products ── */
  .cfj-products {
    padding: 90px 48px;
    background: #FAF5ED;
  }
  .cfj-products-inner {
    max-width: 1320px;
    margin: 0 auto;
  }
  .cfj-prod-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .cfj-prod-card {
    background: #FFFCF5;
    overflow: hidden;
    border: 1px solid rgba(212,175,55,0.1);
    transition: all 0.4s ease;
    text-decoration: none;
    color: #2C1810;
    display: block;
    position: relative;
  }
  .cfj-prod-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(44,24,16,0.1);
    border-color: rgba(212,175,55,0.3);
  }
  .cfj-prod-img {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #f5efe6;
  }
  .cfj-prod-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .cfj-prod-card:hover .cfj-prod-img img { transform: scale(1.05); }
  .cfj-prod-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    color: #fff;
    padding: 5px 14px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-prod-badge.bestseller { background: #D4AF37; color: #2C1810; }
  .cfj-prod-badge.new { background: #2C1810; }
  .cfj-prod-badge.exclusive { background: #8B2252; }
  .cfj-prod-wishlist {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    background: rgba(255,252,245,0.9);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #2C1810;
    transition: all 0.2s ease;
  }
  .cfj-prod-wishlist:hover { background: #D4AF37; color: #fff; }
  .cfj-prod-info {
    padding: 22px;
    text-align: center;
  }
  .cfj-prod-type {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #D4AF37;
    margin-bottom: 6px;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-prod-name {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    margin-bottom: 10px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cfj-prod-price {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .cfj-prod-price .cfj-current {
    font-size: 18px;
    font-weight: 800;
    color: #2C1810;
    font-family: 'Playfair Display', serif;
  }
  .cfj-prod-price .cfj-original {
    font-size: 13px;
    color: #aaa;
    text-decoration: line-through;
  }
  .cfj-prod-price .cfj-discount {
    font-size: 11px;
    font-weight: 700;
    color: #8B2252;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-prod-atc {
    display: block;
    width: 100%;
    margin-top: 16px;
    padding: 13px;
    background: #2C1810;
    color: #D4AF37;
    border: none;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-prod-atc:hover { background: #D4AF37; color: #2C1810; }

  /* ── Occasion / Banner Strip ── */
  .cfj-occasions {
    padding: 90px 48px;
    background: #FFFCF5;
  }
  .cfj-occasions-inner { max-width: 1320px; margin: 0 auto; }
  .cfj-occ-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .cfj-occ-card {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16/9;
    display: block;
    text-decoration: none;
    color: #fff;
    background: #f5efe6;
  }
  .cfj-occ-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .cfj-occ-card:hover img { transform: scale(1.05); }
  .cfj-occ-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(44,24,16,0.7) 0%, transparent 70%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 32px;
  }
  .cfj-occ-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #D4AF37;
    margin-bottom: 8px;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-occ-overlay h3 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .cfj-occ-overlay span {
    font-size: 13px;
    opacity: 0.8;
  }

  /* ── Craftsmanship / Brand Story ── */
  .cfj-story {
    padding: 100px 48px;
    background: linear-gradient(135deg, #2C1810 0%, #1a0f0a 100%);
    color: #FFFCF5;
  }
  .cfj-story-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    align-items: center;
  }
  .cfj-story-overline {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #D4AF37;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-story-overline::after {
    content: '';
    width: 40px;
    height: 1px;
    background: #D4AF37;
  }
  .cfj-story h2 {
    font-size: 42px;
    font-weight: 700;
    margin-bottom: 24px;
    line-height: 1.2;
    letter-spacing: -0.3px;
  }
  .cfj-story h2 span { color: #D4AF37; font-style: italic; }
  .cfj-story p {
    font-size: 16px;
    line-height: 1.9;
    color: rgba(255,252,245,0.65);
    margin-bottom: 40px;
  }
  .cfj-story-stats {
    display: flex;
    gap: 48px;
  }
  .cfj-story-stat {
    position: relative;
    padding-right: 48px;
  }
  .cfj-story-stat:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(212,175,55,0.2);
  }
  .cfj-story-stat h3 {
    font-size: 36px;
    font-weight: 800;
    color: #D4AF37;
    margin-bottom: 4px;
  }
  .cfj-story-stat span {
    font-size: 12px;
    color: rgba(255,252,245,0.5);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-story-visual {
    position: relative;
  }
  .cfj-story-visual img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .cfj-story-visual-placeholder {
    width: 100%;
    aspect-ratio: 4/3;
    background: linear-gradient(135deg, #3d2317, #5a3828);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(212,175,55,0.4);
  }
  .cfj-story-accent {
    position: absolute;
    bottom: -20px;
    right: -20px;
    width: 120px;
    height: 120px;
    border: 2px solid rgba(212,175,55,0.2);
    z-index: -1;
  }

  /* ── Testimonials ── */
  .cfj-reviews {
    padding: 90px 48px;
    background: #FFFCF5;
  }
  .cfj-reviews-inner { max-width: 1320px; margin: 0 auto; }
  .cfj-rev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .cfj-rev-card {
    background: #FAF5ED;
    padding: 36px;
    border: 1px solid rgba(212,175,55,0.1);
    position: relative;
  }
  .cfj-rev-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #D4AF37, #F5D060, #D4AF37);
  }
  .cfj-rev-quote {
    color: #D4AF37;
    font-size: 40px;
    font-family: 'Playfair Display', serif;
    line-height: 1;
    margin-bottom: 16px;
  }
  .cfj-rev-stars {
    color: #D4AF37;
    margin-bottom: 16px;
    display: flex;
    gap: 3px;
  }
  .cfj-rev-text {
    font-size: 15px;
    color: #5a4a3c;
    line-height: 1.8;
    margin-bottom: 24px;
    font-style: italic;
  }
  .cfj-rev-author {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .cfj-rev-avatar {
    width: 48px;
    height: 48px;
    background: #D4AF37;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2C1810;
    font-weight: 800;
    font-size: 18px;
    font-family: 'Playfair Display', serif;
  }
  .cfj-rev-name {
    font-size: 14px;
    font-weight: 700;
    color: #2C1810;
  }
  .cfj-rev-location {
    font-size: 11px;
    color: #8B7355;
    letter-spacing: 0.5px;
  }

  /* ── Value Propositions ── */
  .cfj-values {
    padding: 70px 48px;
    background: #FAF5ED;
    border-top: 1px solid rgba(212,175,55,0.1);
  }
  .cfj-values-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .cfj-val-item {
    text-align: center;
    padding: 32px 16px;
  }
  .cfj-val-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #D4AF37;
    border: 1px solid rgba(212,175,55,0.2);
  }
  .cfj-val-item h4 {
    font-size: 14px;
    font-weight: 700;
    color: #2C1810;
    margin-bottom: 6px;
    font-family: 'Playfair Display', serif;
    letter-spacing: 0.3px;
  }
  .cfj-val-item p {
    font-size: 12px;
    color: #8B7355;
    line-height: 1.6;
  }

  /* ── Newsletter ── */
  .cfj-newsletter {
    padding: 90px 48px;
    background: linear-gradient(135deg, #2C1810 0%, #3d2317 100%);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .cfj-newsletter::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(212,175,55,0.06) 0%, transparent 60%);
    pointer-events: none;
  }
  .cfj-newsletter-inner {
    max-width: 560px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .cfj-newsletter h2 {
    font-size: 34px;
    font-weight: 700;
    margin-bottom: 14px;
    color: #FFFCF5;
  }
  .cfj-newsletter p {
    font-size: 15px;
    color: rgba(255,252,245,0.6);
    margin-bottom: 32px;
    line-height: 1.7;
  }
  .cfj-newsletter-form {
    display: flex;
    gap: 0;
    max-width: 480px;
    margin: 0 auto;
  }
  .cfj-newsletter-input {
    flex: 1;
    padding: 18px 24px;
    border: 1px solid rgba(212,175,55,0.3);
    border-right: none;
    font-size: 14px;
    outline: none;
    background: rgba(255,252,245,0.05);
    color: #FFFCF5;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-newsletter-input::placeholder { color: rgba(255,252,245,0.3); }
  .cfj-newsletter-input:focus { border-color: #D4AF37; }
  .cfj-newsletter-btn {
    padding: 18px 32px;
    background: #D4AF37;
    color: #2C1810;
    border: 1px solid #D4AF37;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-family: 'DM Sans', sans-serif;
    white-space: nowrap;
    transition: all 0.3s ease;
  }
  .cfj-newsletter-btn:hover { background: #E5C040; }

  /* ── Footer ── */
  .cfj-footer {
    background: #1a0f0a;
    color: #bbb;
    padding: 70px 48px 30px;
  }
  .cfj-footer-inner { max-width: 1320px; margin: 0 auto; }
  .cfj-footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .cfj-footer-brand h3 {
    font-size: 28px;
    font-weight: 700;
    color: #D4AF37;
    margin-bottom: 14px;
    font-family: 'Playfair Display', serif;
  }
  .cfj-footer-brand p {
    font-size: 13px;
    line-height: 1.8;
    color: #8B7355;
  }
  .cfj-footer h4 {
    font-size: 12px;
    font-weight: 700;
    color: #D4AF37;
    margin-bottom: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-family: 'DM Sans', sans-serif;
  }
  .cfj-footer ul { list-style: none; }
  .cfj-footer li { margin-bottom: 10px; }
  .cfj-footer a {
    color: #8B7355;
    text-decoration: none;
    font-size: 13px;
    transition: color 0.2s ease;
  }
  .cfj-footer a:hover { color: #D4AF37; }
  .cfj-footer-bottom {
    border-top: 1px solid rgba(212,175,55,0.1);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: #5a4a3c;
  }
  .cfj-footer-payments {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .cfj-footer-pay-icon {
    width: 40px;
    height: 26px;
    background: rgba(212,175,55,0.08);
    border: 1px solid rgba(212,175,55,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 8px;
    font-weight: 700;
    color: #D4AF37;
    letter-spacing: 0.5px;
  }

  /* ── Mobile Responsive ── */
  @media (max-width: 768px) {
    .cfj-info-strip { flex-wrap: wrap; gap: 12px; padding: 10px 12px; }
    .cfj-info-strip-divider { display: none; }
    .cfj-hero-inner { grid-template-columns: 1fr; padding: 48px 20px; gap: 36px; }
    .cfj-hero h1 { font-size: 34px; }
    .cfj-hero-img-wrap { display: none; }
    .cfj-hero-ctas { flex-direction: column; }
    .cfj-coll-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .cfj-prod-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .cfj-occ-grid { grid-template-columns: 1fr; }
    .cfj-story-inner { grid-template-columns: 1fr; gap: 48px; }
    .cfj-rev-grid { grid-template-columns: 1fr; }
    .cfj-values-inner { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .cfj-footer-grid { grid-template-columns: 1fr 1fr; }
    .cfj-trust-inner { justify-content: center; }
    .cfj-newsletter-form { flex-direction: column; }
    .cfj-newsletter-input { border-right: 1px solid rgba(212,175,55,0.3); }
    .cfj-collections, .cfj-products, .cfj-occasions, .cfj-story, .cfj-reviews, .cfj-newsletter, .cfj-values {
      padding: 56px 20px;
    }
    .cfj-section-head h2 { font-size: 28px; }
    .cfj-story h2 { font-size: 30px; }
  }
{% endstyle %}


<div class="cf-jewel">
  <!-- ── Info Strip ── -->
  <div class="cfj-info-strip">
    <div class="cfj-info-strip-item">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
      BIS Hallmarked
    </div>
    <div class="cfj-info-strip-divider"></div>
    <div class="cfj-info-strip-item">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
      Certified Diamonds
    </div>
    <div class="cfj-info-strip-divider"></div>
    <div class="cfj-info-strip-item">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      Free Insured Shipping
    </div>
    <div class="cfj-info-strip-divider"></div>
    <div class="cfj-info-strip-item">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      Lifetime Exchange
    </div>
  </div>

  <!-- ── Announcement Bar ── -->
  <div class="cfj-announce">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
    <span>{{ section.settings.announce_text | default: 'Making Charges Waived — Limited Period Offer' }}</span>
    <a href="{{ section.settings.announce_link | default: '#' }}">{{ section.settings.announce_cta | default: 'Shop Now →' }}</a>
  </div>

  <!-- ── Hero Banner ── -->
  <div class="cfj-hero">
    <div class="cfj-hero-inner">
      <div>
        <span class="cfj-hero-overline">{{ section.settings.hero_overline | default: 'New Arrivals' }}</span>
        <h1>
          {{ section.settings.hero_title_1 | default: 'Timeless' }}
          <br>
          <span>{{ section.settings.hero_title_accent | default: 'Elegance' }}</span>
          {{ section.settings.hero_title_2 | default: 'Redefined' }}
        </h1>
        <p class="cfj-hero-sub">
          {{ section.settings.hero_subtitle | default: 'Handcrafted jewellery that celebrates the art of Indian craftsmanship. Every piece tells a story of heritage, precision, and timeless beauty.' }}
        </p>
        <div class="cfj-hero-ctas">
          <a href="{{ section.settings.hero_cta_link | default: '/collections/all' }}" class="cfj-hero-cta-primary">
            {{ section.settings.hero_cta_text | default: 'Explore Collection' }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="{{ section.settings.hero_cta2_link | default: '/pages/about' }}" class="cfj-hero-cta-secondary">
            {{ section.settings.hero_cta2_text | default: 'Our Heritage' }}
          </a>
        </div>
      </div>
      <div class="cfj-hero-img-wrap">
        {% if section.settings.hero_image %}
          <img src="{{ section.settings.hero_image | image_url: width: 800 }}" alt="Hero jewellery" loading="eager">
        {% else %}
          <div style="width:100%;max-width:520px;aspect-ratio:4/5;background:linear-gradient(135deg,#3d2317,#5a3828);display:flex;align-items:center;justify-content:center;">
            <svg width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="rgba(212,175,55,0.3)" stroke-width="0.8">
              <path d="M12 2L2 7l10 5 10-5-10-5Z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
        {% endif %}
        <div class="cfj-hero-float top-right">
          <div class="cfj-float-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <div>
            <div class="cfj-float-label">Rating</div>
            <div class="cfj-float-val">4.9 / 5.0</div>
          </div>
        </div>
        <div class="cfj-hero-float bottom-left">
          <div class="cfj-float-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <div>
            <div class="cfj-float-label">Loved by</div>
            <div class="cfj-float-val">10L+ Customers</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Trust Bar ── -->
  <div class="cfj-trust-bar">
    <div class="cfj-trust-inner">
      <div class="cfj-trust-item">
        <span class="cfj-trust-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg></span>
        100% BIS Hallmarked
      </div>
      <div class="cfj-trust-item">
        <span class="cfj-trust-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
        Lifetime Exchange
      </div>
      <div class="cfj-trust-item">
        <span class="cfj-trust-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></span>
        Free Insured Delivery
      </div>
      <div class="cfj-trust-item">
        <span class="cfj-trust-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></span>
        Transparent Pricing
      </div>
      <div class="cfj-trust-item">
        <span class="cfj-trust-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5Z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg></span>
        Certified Diamonds
      </div>
    </div>
  </div>

  <!-- ── Shop By Collection ── -->
  <div class="cfj-collections">
    <div class="cfj-section-head">
      <span class="cfj-overline">Collections</span>
      <h2>{{ section.settings.coll_title | default: 'Shop by Collection' }}</h2>
      <p>{{ section.settings.coll_desc | default: 'Discover curated collections for every occasion and every woman' }}</p>
    </div>
    <div class="cfj-coll-grid">
      {% for block in section.blocks %}
        {% if block.type == 'collection' %}
          {%- assign coll = block.settings.collection -%}
          {%- assign coll_label = block.settings.custom_title | default: coll.title | default: 'Collection' -%}
          {%- assign coll_url = coll.url | default: block.settings.custom_link | default: '#' -%}
          {%- assign coll_tagline = block.settings.tagline | default: 'Explore' -%}
          <a href="{{ coll_url }}" class="cfj-coll-card">
            {%- if block.settings.custom_image -%}
              <img src="{{ block.settings.custom_image | image_url: width: 600 }}" alt="{{ coll_label }}" loading="lazy">
            {%- elsif coll.image -%}
              <img src="{{ coll.image | image_url: width: 600 }}" alt="{{ coll_label }}" loading="lazy">
            {%- else -%}
              <div style="width:100%;height:100%;background:linear-gradient(135deg,#e8d5c4,#d4a574);"></div>
            {%- endif -%}
            <div class="cfj-coll-overlay">
              <h3>{{ coll_label }}</h3>
              <span>{{ coll_tagline }}</span>
            </div>
            <div class="cfj-coll-shine">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- ── Bestselling Products ── -->
  <div class="cfj-products">
    <div class="cfj-products-inner">
      <div class="cfj-section-head">
        <span class="cfj-overline">Most Loved</span>
        <h2>{{ section.settings.prod_title | default: 'Bestselling Jewellery' }}</h2>
        <p>{{ section.settings.prod_desc | default: 'Loved by millions, these are our most coveted designs' }}</p>
      </div>
      <div class="cfj-prod-grid">
        {% for block in section.blocks %}
          {% if block.type == 'product' %}
            {%- assign prd = block.settings.product -%}
            {%- assign prd_title = block.settings.custom_title | default: prd.title | default: 'Jewellery Piece' -%}
            {%- assign prd_url = prd.url | default: '#' -%}
            {%- assign prd_img = block.settings.custom_image | default: prd.featured_image -%}
            {%- assign prd_price = prd.price | money_without_trailing_zeros -%}
            {%- assign prd_compare = prd.compare_at_price | money_without_trailing_zeros -%}
            <a href="{{ prd_url }}" class="cfj-prod-card">
              <div class="cfj-prod-img">
                {%- if prd_img -%}
                  <img src="{{ prd_img | image_url: width: 500 }}" alt="{{ prd_title }}" loading="lazy">
                {%- else -%}
                  <div style="width:100%;height:100%;background:#f5efe6;display:flex;align-items:center;justify-content:center;">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="0.8"><path d="M12 2L2 7l10 5 10-5-10-5Z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                  </div>
                {%- endif -%}
                {%- if block.settings.badge != blank -%}
                  <span class="cfj-prod-badge {{ block.settings.badge_style }}">{{ block.settings.badge }}</span>
                {%- endif -%}
                <button class="cfj-prod-wishlist" onclick="event.preventDefault();">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                </button>
              </div>
              <div class="cfj-prod-info">
                <div class="cfj-prod-type">{{ block.settings.product_type | default: 'Gold Jewellery' }}</div>
                <div class="cfj-prod-name">{{ prd_title }}</div>
                <div class="cfj-prod-price">
                  {%- if prd.price -%}
                    <span class="cfj-current">{{ prd_price }}</span>
                    {%- if prd.compare_at_price > prd.price -%}
                      <span class="cfj-original">{{ prd_compare }}</span>
                      {%- assign save_pct = prd.compare_at_price | minus: prd.price | times: 100 | divided_by: prd.compare_at_price -%}
                      <span class="cfj-discount">{{ save_pct }}% OFF</span>
                    {%- endif -%}
                  {%- else -%}
                    <span class="cfj-current">{{ block.settings.custom_price | default: '₹24,999' }}</span>
                  {%- endif -%}
                </div>
                <button class="cfj-prod-atc">Add to Cart</button>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- ── Shop by Occasion ── -->
  <div class="cfj-occasions">
    <div class="cfj-occasions-inner">
      <div class="cfj-section-head">
        <span class="cfj-overline">Occasions</span>
        <h2>{{ section.settings.occ_title | default: 'Shop by Occasion' }}</h2>
        <p>{{ section.settings.occ_desc | default: 'Find the perfect piece for every celebration' }}</p>
      </div>
      <div class="cfj-occ-grid">
        {% for block in section.blocks %}
          {% if block.type == 'occasion' %}
            <a href="{{ block.settings.link | default: '#' }}" class="cfj-occ-card">
              {%- if block.settings.image -%}
                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title }}" loading="lazy">
              {%- else -%}
                <div style="width:100%;height:100%;background:linear-gradient(135deg,#3d2317,#5a3828);"></div>
              {%- endif -%}
              <div class="cfj-occ-overlay">
                <span class="cfj-occ-tag">{{ block.settings.tag | default: 'Collection' }}</span>
                <h3>{{ block.settings.title | default: 'Wedding' }}</h3>
                <span>{{ block.settings.subtitle | default: 'Shop Now →' }}</span>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- ── Craftsmanship Story ── -->
  <div class="cfj-story">
    <div class="cfj-story-inner">
      <div>
        <span class="cfj-story-overline">{{ section.settings.story_overline | default: 'Our Legacy' }}</span>
        <h2>
          {{ section.settings.story_title_1 | default: 'Crafted with' }}
          <span>{{ section.settings.story_title_accent | default: 'Passion' }}</span><br>
          {{ section.settings.story_title_2 | default: '& Precision' }}
        </h2>
        <p>{{ section.settings.story_text | default: 'For over eight decades, our master artisans have perfected the art of jewellery making. Each piece passes through 68 quality checks before it reaches you — a testament to our uncompromising standards and deep love for the craft.' }}</p>
        <div class="cfj-story-stats">
          <div class="cfj-story-stat">
            <h3>{{ section.settings.stat_1_num | default: '85+' }}</h3>
            <span>{{ section.settings.stat_1_label | default: 'Years of Heritage' }}</span>
          </div>
          <div class="cfj-story-stat">
            <h3>{{ section.settings.stat_2_num | default: '5000+' }}</h3>
            <span>{{ section.settings.stat_2_label | default: 'Unique Designs' }}</span>
          </div>
          <div class="cfj-story-stat">
            <h3>{{ section.settings.stat_3_num | default: '68' }}</h3>
            <span>{{ section.settings.stat_3_label | default: 'Quality Checks' }}</span>
          </div>
        </div>
      </div>
      <div class="cfj-story-visual">
        {% if section.settings.story_image %}
          <img src="{{ section.settings.story_image | image_url: width: 700 }}" alt="Craftsmanship" loading="lazy">
        {% else %}
          <div class="cfj-story-visual-placeholder">
            <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.6">
              <path d="M12 2L2 7l10 5 10-5-10-5Z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
        {% endif %}
        <div class="cfj-story-accent"></div>
      </div>
    </div>
  </div>

  <!-- ── Testimonials ── -->
  <div class="cfj-reviews">
    <div class="cfj-reviews-inner">
      <div class="cfj-section-head">
        <span class="cfj-overline">Testimonials</span>
        <h2>{{ section.settings.rev_title | default: 'What Our Customers Say' }}</h2>
      </div>
      <div class="cfj-rev-grid">
        {% for block in section.blocks %}
          {% if block.type == 'review' %}
            <div class="cfj-rev-card">
              <div class="cfj-rev-quote">"</div>
              <div class="cfj-rev-stars">
                {%- for i in (1..block.settings.rating) -%}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="#D4AF37" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- endfor -%}
              </div>
              <p class="cfj-rev-text">"{{ block.settings.text }}"</p>
              <div class="cfj-rev-author">
                <div class="cfj-rev-avatar">{{ block.settings.name | slice: 0 }}</div>
                <div>
                  <div class="cfj-rev-name">{{ block.settings.name }}</div>
                  <div class="cfj-rev-location">{{ block.settings.location | default: 'Verified Buyer' }}</div>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- ── Value Props ── -->
  <div class="cfj-values">
    <div class="cfj-values-inner">
      <div class="cfj-val-item">
        <div class="cfj-val-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        </div>
        <h4>Purity Guaranteed</h4>
        <p>Every piece is BIS Hallmarked with certified purity assurance</p>
      </div>
      <div class="cfj-val-item">
        <div class="cfj-val-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h4>Lifetime Exchange</h4>
        <p>Exchange your old jewellery at full value, anytime</p>
      </div>
      <div class="cfj-val-item">
        <div class="cfj-val-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </div>
        <h4>Insured Delivery</h4>
        <p>Free, fully insured doorstep delivery pan India</p>
      </div>
      <div class="cfj-val-item">
        <div class="cfj-val-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5Z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <h4>Certified Diamonds</h4>
        <p>Every diamond is certified by leading international labs</p>
      </div>
    </div>
  </div>

  <!-- ── Newsletter ── -->
  <div class="cfj-newsletter">
    <div class="cfj-newsletter-inner">
      <h2>{{ section.settings.news_title | default: 'Be the First to Know' }}</h2>
      <p>{{ section.settings.news_desc | default: 'Subscribe for exclusive previews, early access to new collections, and members-only offers.' }}</p>
      <div class="cfj-newsletter-form">
        <input type="email" class="cfj-newsletter-input" placeholder="Enter your email address">
        <button class="cfj-newsletter-btn">Subscribe</button>
      </div>
    </div>
  </div>

  <!-- ── Footer ── -->
  <div class="cfj-footer">
    <div class="cfj-footer-inner">
      <div class="cfj-footer-grid">
        <div class="cfj-footer-brand">
          <h3>{{ section.settings.footer_brand | default: shop.name }}</h3>
          <p>{{ section.settings.footer_desc | default: 'A legacy of trust, craftsmanship, and timeless beauty. Every piece of jewellery we create is a celebration of Indian artistry and modern elegance.' }}</p>
        </div>
        <div>
          <h4>Collections</h4>
          <ul>
            <li><a href="#">Gold Jewellery</a></li>
            <li><a href="#">Diamond Jewellery</a></li>
            <li><a href="#">Wedding Collection</a></li>
            <li><a href="#">Daily Wear</a></li>
            <li><a href="#">Platinum</a></li>
          </ul>
        </div>
        <div>
          <h4>Customer Care</h4>
          <ul>
            <li><a href="#">Track Order</a></li>
            <li><a href="#">Return & Exchange</a></li>
            <li><a href="#">Store Locator</a></li>
            <li><a href="#">FAQs</a></li>
            <li><a href="#">Contact Us</a></li>
          </ul>
        </div>
        <div>
          <h4>About</h4>
          <ul>
            <li><a href="#">Our Heritage</a></li>
            <li><a href="#">Craftsmanship</a></li>
            <li><a href="#">Certifications</a></li>
            <li><a href="#">Careers</a></li>
            <li><a href="#">Press</a></li>
          </ul>
        </div>
      </div>
      <div class="cfj-footer-bottom">
        <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
        <div class="cfj-footer-payments">
          <div class="cfj-footer-pay-icon">VISA</div>
          <div class="cfj-footer-pay-icon">MC</div>
          <div class="cfj-footer-pay-icon">UPI</div>
          <div class="cfj-footer-pay-icon">EMI</div>
        </div>
      </div>
    </div>
  </div>
</div>


