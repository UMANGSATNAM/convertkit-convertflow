{% comment %}
  ConvertFlow — Streetwear Landing Page
  Brutalist, Bento Grid layout, Monospace fonts, and Heavy Borders.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap');

  :root {
    --sw-primary: {{ section.settings.color_primary | default: '#FF3366' }};
    --sw-bg: {{ section.settings.color_bg | default: '#0A0A0A' }};
    --sw-surface: {{ section.settings.color_surface | default: '#121212' }};
    --sw-text: {{ section.settings.color_text | default: '#FFFFFF' }};
    --sw-border: rgba(255, 255, 255, 0.15);
    --sw-font-heading: 'Space Grotesk', sans-serif;
    --sw-font-mono: 'Space Mono', monospace;
  }

  .cf-sw * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-sw { font-family: var(--sw-font-heading); background: var(--sw-bg); color: var(--sw-text); border-top: 1px solid var(--sw-border); }
  
  /* Marquee */
  .cf-sw-marquee { background: var(--sw-primary); color: #000; padding: 12px 0; overflow: hidden; display: flex; white-space: nowrap; border-bottom: 2px solid #000; }
  .cf-sw-marquee-inner { display: flex; animation: cfSwScroll 20s linear infinite; }
  .cf-sw-marquee-item { font-family: var(--sw-font-mono); font-weight: 700; font-size: 14px; text-transform: uppercase; padding: 0 40px; display: flex; align-items: center; gap: 40px; }
  .cf-sw-marquee-item::after { content: "++"; opacity: 0.5; }
  @keyframes cfSwScroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

  /* Hero */
  .cf-sw-hero { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--sw-border); min-height: 85vh; }
  .cf-sw-hero-text { padding: 80px 5%; display: flex; flex-direction: column; justify-content: center; border-right: 1px solid var(--sw-border); position: relative; }
  .cf-sw-hero-badge { position: absolute; top: 40px; left: 5%; font-family: var(--sw-font-mono); font-size: 12px; font-weight: 700; background: var(--sw-surface); border: 1px solid var(--sw-border); padding: 6px 12px; letter-spacing: 2px; }
  .cf-sw-hero h1 { font-size: clamp(60px, 8vw, 140px); font-weight: 700; line-height: 0.9; margin-bottom: 30px; text-transform: uppercase; }
  .cf-sw-hero p { font-family: var(--sw-font-mono); font-size: 16px; color: #888; max-width: 400px; margin-bottom: 40px; line-height: 1.6; }
  
  .cf-sw-btn { display: inline-flex; align-items: center; gap: 12px; background: var(--sw-text); color: var(--sw-bg); padding: 18px 40px; font-family: var(--sw-font-mono); font-weight: 700; font-size: 14px; text-transform: uppercase; text-decoration: none; transition: all 0.2s; border: 2px solid transparent; width: fit-content; }
  .cf-sw-btn:hover { background: transparent; color: var(--sw-text); border-color: var(--sw-text); }
  
  .cf-sw-hero-img { background: #111; position: relative; overflow: hidden; }
  .cf-sw-hero-img img { width: 100%; height: 100%; object-fit: cover; }
  .cf-sw-hero-timer { position: absolute; bottom: 40px; left: 40px; background: rgba(0,0,0,0.8); backdrop-filter: blur(10px); border: 1px solid var(--sw-border); padding: 20px; font-family: var(--sw-font-mono); display: flex; gap: 20px; }
  .cf-sw-timer-block { display: flex; flex-direction: column; align-items: center; }
  .cf-sw-timer-num { font-size: 24px; font-weight: 700; color: var(--sw-primary); }
  .cf-sw-timer-label { font-size: 10px; color: #888; text-transform: uppercase; }

  /* Bento Grid */
  .cf-sw-bento { padding: 80px 5%; border-bottom: 1px solid var(--sw-border); }
  .cf-sw-section-title { font-size: clamp(32px, 5vw, 64px); font-weight: 700; text-transform: uppercase; margin-bottom: 40px; }
  .cf-sw-bento-grid { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 300px; gap: 20px; }
  .cf-sw-bento-item { position: relative; border: 1px solid var(--sw-border); background: var(--sw-surface); overflow: hidden; text-decoration: none; display: flex; flex-direction: column; justify-content: flex-end; padding: 30px; transition: border-color 0.3s; }
  .cf-sw-bento-item:hover { border-color: var(--sw-primary); }
  .cf-sw-bento-item img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.6; transition: opacity 0.3s, transform 3s linear; }
  .cf-sw-bento-item:hover img { opacity: 0.3; transform: scale(1.05); }
  .cf-sw-bento-content { position: relative; z-index: 2; }
  .cf-sw-bento-title { font-size: 24px; font-weight: 700; color: #fff; text-transform: uppercase; margin-bottom: 10px; }
  .cf-sw-bento-link { font-family: var(--sw-font-mono); font-size: 12px; color: var(--sw-primary); font-weight: 700; text-transform: uppercase; }
  
  .cf-sw-bento-item.large { grid-column: span 2; grid-row: span 2; }
  .cf-sw-bento-item.wide { grid-column: span 2; }

  /* Hype Products */
  .cf-sw-hype { border-bottom: 1px solid var(--sw-border); display: grid; grid-template-columns: 300px 1fr; }
  .cf-sw-hype-sidebar { padding: 60px 40px; border-right: 1px solid var(--sw-border); display: flex; flex-direction: column; justify-content: space-between; }
  .cf-sw-hype-sidebar h2 { font-size: 48px; text-transform: uppercase; line-height: 1; }
  .cf-sw-hype-sidebar p { font-family: var(--sw-font-mono); color: #888; font-size: 14px; margin-top: 20px; }
  
  .cf-sw-hype-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .cf-sw-prod { border-right: 1px solid var(--sw-border); display: flex; flex-direction: column; text-decoration: none; color: var(--sw-text); transition: background 0.3s; }
  .cf-sw-prod:hover { background: var(--sw-surface); }
  .cf-sw-prod:last-child { border-right: none; }
  .cf-sw-prod-img { aspect-ratio: 1; border-bottom: 1px solid var(--sw-border); overflow: hidden; }
  .cf-sw-prod-img img { width: 100%; height: 100%; object-fit: cover; }
  .cf-sw-prod-info { padding: 24px; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
  .cf-sw-prod-title { font-size: 18px; font-weight: 700; text-transform: uppercase; margin-bottom: 10px; }
  .cf-sw-prod-price { font-family: var(--sw-font-mono); font-size: 16px; color: var(--sw-primary); }

  /* Image Banner */
  .cf-sw-banner { position: relative; height: 60vh; display: flex; align-items: center; justify-content: center; overflow: hidden; border-bottom: 1px solid var(--sw-border); }
  .cf-sw-banner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.5; }
  .cf-sw-banner-text { position: relative; z-index: 2; font-size: clamp(40px, 8vw, 120px); font-weight: 700; text-transform: uppercase; color: #fff; mix-blend-mode: overlay; pointer-events: none; text-align: center; }

  @media (max-width: 1024px) {
    .cf-sw-bento-grid { grid-template-columns: repeat(2, 1fr); }
    .cf-sw-hype { grid-template-columns: 1fr; }
    .cf-sw-hype-sidebar { border-right: none; border-bottom: 1px solid var(--sw-border); }
    .cf-sw-hype-grid { grid-template-columns: repeat(2, 1fr); }
    .cf-sw-prod:nth-child(2) { border-right: none; }
    .cf-sw-prod:nth-child(3) { border-top: 1px solid var(--sw-border); grid-column: span 2; }
  }
  @media (max-width: 768px) {
    .cf-sw-hero { grid-template-columns: 1fr; }
    .cf-sw-hero-text { border-right: none; border-bottom: 1px solid var(--sw-border); padding: 120px 5% 60px; }
    .cf-sw-bento-item.large, .cf-sw-bento-item.wide { grid-column: span 1; grid-row: span 1; }
    .cf-sw-bento-grid { grid-template-columns: 1fr; }
    .cf-sw-hype-grid { grid-template-columns: 1fr; }
    .cf-sw-prod { border-right: none !important; border-bottom: 1px solid var(--sw-border); }
  }
{% endstyle %}

<div class="cf-sw">
  
  <div class="cf-sw-marquee">
    <div class="cf-sw-marquee-inner">
      {% for i in (1..8) %}
        <span class="cf-sw-marquee-item">{{ section.settings.marquee_text | default: "LATEST DROP [01]" }}</span>
      {% endfor %}
    </div>
  </div>

  {% for block in section.blocks %}
    {% case block.type %}
      
      {% when 'hero' %}
        <section class="cf-sw-hero">
          <div class="cf-sw-hero-text">
            <div class="cf-sw-hero-badge">{{ block.settings.badge | default: 'SYSTEM.ON' }}</div>
            <h1>{{ block.settings.title | default: 'Core<br>Collection' }}</h1>
            <p>{{ block.settings.text | default: 'Engineered for the urban environment. Utilitarian aesthetics combined with maximum functionality.' }}</p>
            <a href="{{ block.settings.btn_url }}" class="cf-sw-btn">{{ block.settings.btn_text | default: 'Explore Drop' }} &rarr;</a>
          </div>
          <div class="cf-sw-hero-img">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: 'master' }}" alt="Streetwear Hero">
            {% else %}
              <div style="width:100%; height:100%; background:#222; display:flex; align-items:center; justify-content:center; color:#444; font-family:monospace;">HERO_IMG</div>
            {% endif %}
            
            {% if block.settings.show_timer %}
              <div class="cf-sw-hero-timer">
                <div class="cf-sw-timer-block"><span class="cf-sw-timer-num">48</span><span class="cf-sw-timer-label">HRS</span></div>
                <div class="cf-sw-timer-block"><span class="cf-sw-timer-num">22</span><span class="cf-sw-timer-label">MIN</span></div>
                <div class="cf-sw-timer-block"><span class="cf-sw-timer-num">10</span><span class="cf-sw-timer-label">SEC</span></div>
              </div>
            {% endif %}
          </div>
        </section>

      {% when 'bento' %}
        <section class="cf-sw-bento">
          <h2 class="cf-sw-section-title">{{ block.settings.heading | default: 'Aesthetics' }}</h2>
          <div class="cf-sw-bento-grid">
            <a href="#" class="cf-sw-bento-item large">
              <div style="background:#1a1a1a; position:absolute; inset:0;"></div>
              <div class="cf-sw-bento-content">
                <h3 class="cf-sw-bento-title">Outerwear</h3>
                <span class="cf-sw-bento-link">[VIEW]</span>
              </div>
            </a>
            <a href="#" class="cf-sw-bento-item">
              <div style="background:#222; position:absolute; inset:0;"></div>
              <div class="cf-sw-bento-content">
                <h3 class="cf-sw-bento-title">Cargo</h3>
                <span class="cf-sw-bento-link">[VIEW]</span>
              </div>
            </a>
            <a href="#" class="cf-sw-bento-item">
              <div style="background:#2a2a2a; position:absolute; inset:0;"></div>
              <div class="cf-sw-bento-content">
                <h3 class="cf-sw-bento-title">Graphic</h3>
                <span class="cf-sw-bento-link">[VIEW]</span>
              </div>
            </a>
            <a href="#" class="cf-sw-bento-item wide">
              <div style="background:#151515; position:absolute; inset:0;"></div>
              <div class="cf-sw-bento-content">
                <h3 class="cf-sw-bento-title">Accessories</h3>
                <span class="cf-sw-bento-link">[VIEW]</span>
              </div>
            </a>
          </div>
        </section>

      {% when 'hype_products' %}
        <section class="cf-sw-hype">
          <div class="cf-sw-hype-sidebar">
            <h2>{{ block.settings.heading | default: 'Archive' }}</h2>
            <p>{{ block.settings.text | default: 'Limited runs. No restocks. Secure your pieces before they vanish.' }}</p>
            <a href="{{ block.settings.btn_url }}" class="cf-sw-btn" style="padding: 12px 24px; font-size:12px;">{{ block.settings.btn_text | default: 'View All' }}</a>
          </div>
          <div class="cf-sw-hype-grid">
            {% assign collection = block.settings.collection %}
            {% if collection != blank and collection.products_count > 0 %}
              {% for product in collection.products limit: 3 %}
                <a href="{{ product.url }}" class="cf-sw-prod">
                  <div class="cf-sw-prod-img">
                    {% if product.featured_image %}
                      <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title }}">
                    {% endif %}
                  </div>
                  <div class="cf-sw-prod-info">
                    <div class="cf-sw-prod-title">{{ product.title }}</div>
                    <div class="cf-sw-prod-price">{{ product.price | money }}</div>
                  </div>
                </a>
              {% endfor %}
            {% else %}
              {% for i in (1..3) %}
                <a href="#" class="cf-sw-prod">
                  <div class="cf-sw-prod-img"><div style="background:#222; width:100%; height:100%;"></div></div>
                  <div class="cf-sw-prod-info">
                    <div class="cf-sw-prod-title">Utility Jacket 0{{ i }}</div>
                    <div class="cf-sw-prod-price">$120.00</div>
                  </div>
                </a>
              {% endfor %}
            {% endif %}
          </div>
        </section>

      {% when 'banner' %}
        <section class="cf-sw-banner">
          <div style="background:#111; position:absolute; inset:0;"></div>
          <div class="cf-sw-banner-text">{{ block.settings.text | default: 'NO RESTOCKS' }}</div>
        </section>

    {% endcase %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "CF Streetwear Landing",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Accent Color", "default": "#FF3366" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#0A0A0A" },
    { "type": "color", "id": "color_surface", "label": "Surface", "default": "#121212" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#FFFFFF" },
    { "type": "text", "id": "marquee_text", "label": "Marquee Text", "default": "LATEST DROP [01]" }
  ],
  "blocks": [
    {
      "type": "hero",
      "name": "Hero Section",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "badge", "label": "Badge Text", "default": "SYSTEM.ON" },
        { "type": "textarea", "id": "title", "label": "Headline", "default": "Core<br>Collection" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Engineered for the urban environment." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "checkbox", "id": "show_timer", "label": "Show Countdown", "default": true },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Explore Drop" },
        { "type": "url", "id": "btn_url", "label": "Button Link" }
      ]
    },
    {
      "type": "bento",
      "name": "Bento Grid",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Aesthetics" }
      ]
    },
    {
      "type": "hype_products",
      "name": "Hype Products",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Archive" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Limited runs. No restocks." },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "View All" },
        { "type": "url", "id": "btn_url", "label": "Button Link" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    },
    {
      "type": "banner",
      "name": "Image Banner",
      "settings": [
        { "type": "text", "id": "text", "label": "Big Text", "default": "NO RESTOCKS" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF Streetwear Landing",
      "blocks": [
        { "type": "hero" },
        { "type": "bento" },
        { "type": "hype_products" },
        { "type": "banner" }
      ]
    }
  ]
}
{% endschema %}
