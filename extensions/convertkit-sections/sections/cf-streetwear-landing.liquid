{% comment %}ConvertFlow - Streetwear Landing | URBNCO style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:ital,wght@0,300;0,400;0,600;1,400;1,600&family=Barlow:wght@300;400;500&display=swap" rel="stylesheet">
<style>
.cfsw{--bk:#080808;--wh:#F5F5F0;--rd:#E8292B;--gy:#888;--bd:rgba(255,255,255,.1);}
.cfsw *{box-sizing:border-box;margin:0;padding:0;}
.cfsw{background:var(--bk);color:var(--wh);font-family:'Barlow',sans-serif;font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased;}
.cfsw h1,.cfsw h2,.cfsw h3{font-family:'Bebas Neue',sans-serif;letter-spacing:.06em;}
.cfsw-ticker{background:var(--rd);padding:9px 0;overflow:hidden;white-space:nowrap;}
.cfsw-ticker-inner{display:inline-flex;gap:0;animation:cfsw-tick 20s linear infinite;}
@keyframes cfsw-tick{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.cfsw-ticker-item{display:inline-flex;align-items:center;padding:0 40px;font-family:'Barlow Condensed',sans-serif;font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;}
.cfsw-ticker-dot{width:5px;height:5px;background:rgba(255,255,255,.5);border-radius:50%;margin-right:40px;}
.cfsw-nav{background:var(--bk);border-bottom:1px solid var(--bd);padding:18px 60px;display:flex;align-items:center;justify-content:space-between;}
.cfsw-logo{font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:.12em;color:var(--wh);text-decoration:none;}
.cfsw-logo span{color:var(--rd);}
.cfsw-nav-links{display:flex;gap:36px;list-style:none;}
.cfsw-nav-links a{color:rgba(255,255,255,.55);text-decoration:none;font-family:'Barlow Condensed',sans-serif;font-size:15px;letter-spacing:.1em;text-transform:uppercase;transition:color .2s;}
.cfsw-nav-links a:hover{color:var(--wh);}
.cfsw-nav-right{display:flex;align-items:center;gap:20px;}
.cfsw-nav-icon{color:rgba(255,255,255,.6);font-size:13px;cursor:pointer;font-family:'Barlow Condensed',sans-serif;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;transition:color .2s;}
.cfsw-nav-icon:hover{color:var(--wh);}
.cfsw-hero{min-height:92vh;display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--bd);}
.cfsw-hl{padding:80px 60px;display:flex;flex-direction:column;justify-content:center;border-right:1px solid var(--bd);}
.cfsw-eyebrow{font-family:'Barlow Condensed',sans-serif;font-size:13px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--rd);margin-bottom:20px;}
.cfsw-hero h1{font-size:clamp(72px,8vw,120px);line-height:.9;margin-bottom:32px;}
.cfsw-hero h1 span{color:var(--rd);}
.cfsw-hero-sub{font-size:16px;color:var(--gy);line-height:1.8;max-width:420px;margin-bottom:44px;font-weight:300;}
.cfsw-btns{display:flex;gap:12px;flex-wrap:wrap;}
.cfsw-btn-rd{background:var(--rd);color:#fff;padding:18px 48px;font-family:'Barlow Condensed',sans-serif;font-size:18px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;transition:opacity .2s;}
.cfsw-btn-rd:hover{opacity:.85;}
.cfsw-btn-out{background:transparent;color:var(--wh);border:1px solid var(--bd);padding:17px 48px;font-family:'Barlow Condensed',sans-serif;font-size:18px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;transition:border-color .2s;}
.cfsw-btn-out:hover{border-color:var(--wh);}
.cfsw-hero-meta{display:flex;gap:40px;margin-top:60px;padding-top:40px;border-top:1px solid var(--bd);}
.cfsw-meta-n{font-family:'Bebas Neue',sans-serif;font-size:36px;color:var(--wh);display:block;}
.cfsw-meta-l{font-family:'Barlow Condensed',sans-serif;font-size:12px;letter-spacing:.15em;text-transform:uppercase;color:var(--gy);display:block;margin-top:4px;}
.cfsw-hr{background:#0f0f0f;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.cfsw-hr::before{content:'URBNCO';font-family:'Bebas Neue',sans-serif;font-size:180px;color:rgba(255,255,255,.025);letter-spacing:10px;position:absolute;text-align:center;}
.cfsw-drop-badge{position:absolute;bottom:40px;right:40px;background:var(--rd);padding:20px 24px;text-align:center;}
.cfsw-drop-n{font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:.1em;display:block;}
.cfsw-drop-l{font-family:'Barlow Condensed',sans-serif;font-size:10px;letter-spacing:.15em;text-transform:uppercase;display:block;opacity:.7;margin-top:2px;}
.cfsw-cats{display:flex;border-top:1px solid var(--bd);border-bottom:1px solid var(--bd);}
.cfsw-cat{flex:1;padding:24px 40px;border-right:1px solid var(--bd);text-align:center;text-decoration:none;color:var(--wh);transition:background .2s;}
.cfsw-cat:last-child{border-right:none;}
.cfsw-cat:hover{background:var(--rd);}
.cfsw-cat-name{font-family:'Barlow Condensed',sans-serif;font-size:18px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;display:block;}
.cfsw-cat-count{font-family:'Barlow Condensed',sans-serif;font-size:12px;letter-spacing:.1em;color:rgba(255,255,255,.4);display:block;margin-top:4px;}
.cfsw-prods{padding:80px 60px;max-width:1400px;margin:0 auto;}
.cfsw-ph{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:48px;}
.cfsw-ph h2{font-size:72px;line-height:.9;}
.cfsw-ph a{font-family:'Barlow Condensed',sans-serif;font-size:14px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;color:var(--rd);text-decoration:none;}
.cfsw-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;}
.cfsw-card{background:#0d0d0d;overflow:hidden;transition:transform .3s;position:relative;}
.cfsw-card:hover{transform:scale(.99);}
.cfsw-card-img{aspect-ratio:3/4;background:#111;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.cfsw-card-img img{width:100%;height:100%;object-fit:cover;transition:transform .6s;}
.cfsw-card:hover .cfsw-card-img img{transform:scale(1.04);}
.cfsw-card-img svg{width:30%;color:rgba(255,255,255,.1);}
.cfsw-card-tag{position:absolute;top:0;left:0;background:var(--rd);color:#fff;font-family:'Barlow Condensed',sans-serif;font-size:11px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;padding:6px 14px;}
.cfsw-card-body{padding:24px;}
.cfsw-card-cat{font-family:'Barlow Condensed',sans-serif;font-size:11px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;color:var(--rd);margin-bottom:6px;}
.cfsw-card-name{font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:600;letter-spacing:.05em;color:var(--wh);margin-bottom:16px;line-height:1.2;}
.cfsw-card-foot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--bd);padding-top:16px;}
.cfsw-card-price{font-family:'Bebas Neue',sans-serif;font-size:24px;color:var(--wh);}
.cfsw-card-old{font-family:'Barlow Condensed',sans-serif;font-size:14px;color:var(--gy);text-decoration:line-through;margin-left:8px;}
.cfsw-atc{background:transparent;border:1px solid var(--bd);color:var(--wh);padding:10px 20px;font-family:'Barlow Condensed',sans-serif;font-size:13px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;transition:all .2s;}
.cfsw-atc:hover{background:var(--rd);border-color:var(--rd);}
.cfsw-cta{background:var(--rd);padding:100px 60px;text-align:center;position:relative;overflow:hidden;}
.cfsw-cta::before{content:'DROP';font-family:'Bebas Neue',sans-serif;font-size:400px;color:rgba(0,0,0,.1);position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);letter-spacing:20px;pointer-events:none;}
.cfsw-cta h2{font-size:clamp(60px,8vw,100px);margin-bottom:20px;position:relative;}
.cfsw-cta p{font-size:18px;color:rgba(255,255,255,.7);margin-bottom:48px;position:relative;}
.cfsw-btn-wh{background:var(--wh);color:var(--bk);padding:20px 60px;font-family:'Barlow Condensed',sans-serif;font-size:18px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;text-decoration:none;transition:opacity .2s;position:relative;}
.cfsw-btn-wh:hover{opacity:.9;}
.cfsw-footer{background:#050505;border-top:1px solid var(--bd);padding:80px 60px 40px;}
.cfsw-fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;padding-bottom:60px;border-bottom:1px solid var(--bd);}
.cfsw-fb a{font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:.12em;color:var(--wh);text-decoration:none;display:block;margin-bottom:16px;}
.cfsw-fb a span{color:var(--rd);}
.cfsw-fb p{font-size:13px;color:var(--gy);line-height:1.9;max-width:260px;}
.cfsw-fc h4{font-family:'Barlow Condensed',sans-serif;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--gy);margin-bottom:20px;}
.cfsw-fc ul{list-style:none;}
.cfsw-fc li{margin-bottom:10px;}
.cfsw-fc a{color:rgba(255,255,255,.45);text-decoration:none;font-family:'Barlow Condensed',sans-serif;font-size:15px;letter-spacing:.05em;transition:color .2s;}
.cfsw-fc a:hover{color:var(--wh);}
.cfsw-fbot{display:flex;justify-content:space-between;padding-top:28px;font-family:'Barlow Condensed',sans-serif;font-size:12px;color:var(--gy);letter-spacing:.1em;}
@media(max-width:1024px){.cfsw-hero{grid-template-columns:1fr}.cfsw-hr{display:none}.cfsw-grid{grid-template-columns:repeat(2,1fr)}.cfsw-fg{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cfsw-nav{padding:16px 20px}.cfsw-nav-links{display:none}.cfsw-hl{padding:60px 20px}.cfsw-hero h1{font-size:80px}.cfsw-cats{flex-direction:column}.cfsw-cat{border-right:none;border-bottom:1px solid var(--bd)}.cfsw-prods{padding:60px 20px}.cfsw-grid{grid-template-columns:1fr}.cfsw-cta{padding:80px 20px}.cfsw-fg{grid-template-columns:1fr;gap:40px}.cfsw-footer{padding:60px 20px 30px}}
</style>
<div class="cfsw">
  <div class="cfsw-ticker"><div class="cfsw-ticker-inner">{% assign tick_items = 'NEW DROP: MARGA RELAXED PANTS,FREE SHIP OVER ₹1499,LIMITED EDITION PIECES,NEW DROP: MARGA RELAXED PANTS,FREE SHIP OVER ₹1499,LIMITED EDITION PIECES' | split: ',' %}{% for t in tick_items %}<span class="cfsw-ticker-item"><span class="cfsw-ticker-dot"></span>{{ t }}</span>{% endfor %}</div></div>
  <nav class="cfsw-nav">
    <a href="{{ routes.root_url }}" class="cfsw-logo">{{ section.settings.brand_name | default: 'URBN' }}<span>CO</span></a>
    <ul class="cfsw-nav-links"><li><a href="#">New Drops</a></li><li><a href="#">Hoodies</a></li><li><a href="#">Bottoms</a></li><li><a href="#">Accessories</a></li><li><a href="#">Sale</a></li></ul>
    <div class="cfsw-nav-right"><a href="{{ routes.cart_url }}" class="cfsw-nav-icon">Cart ({{ cart.item_count }})</a></div>
  </nav>
  <section class="cfsw-hero">
    <div class="cfsw-hl">
      <div class="cfsw-eyebrow">{{ section.settings.hero_eyebrow | default: 'New Drop — SS25' }}</div>
      <h1>{{ section.settings.hero_h1 | default: 'DRESS THE <span>STREETS.</span>' }}</h1>
      <p class="cfsw-hero-sub">{{ section.settings.hero_sub | default: 'Limited drops. Unlimited style. Streetwear built for those who move different — unapologetically.' }}</p>
      <div class="cfsw-btns">
        <a href="{{ section.settings.cta1_url | default: routes.collections_url }}" class="cfsw-btn-rd">{{ section.settings.cta1_text | default: 'Shop the Drop' }}</a>
        <a href="{{ section.settings.cta2_url | default: '#' }}" class="cfsw-btn-out">{{ section.settings.cta2_text | default: 'View Lookbook' }}</a>
      </div>
      <div class="cfsw-hero-meta">
        <div><span class="cfsw-meta-n">SS25</span><span class="cfsw-meta-l">Current Season</span></div>
        <div><span class="cfsw-meta-n">48H</span><span class="cfsw-meta-l">Drop Window</span></div>
        <div><span class="cfsw-meta-n">4.8★</span><span class="cfsw-meta-l">Avg Rating</span></div>
      </div>
    </div>
    <div class="cfsw-hr">
      <svg fill="none" stroke="rgba(255,255,255,0.05)" viewBox="0 0 100 100" width="400"><circle cx="50" cy="50" r="45"/><circle cx="50" cy="50" r="35"/><circle cx="50" cy="50" r="25"/></svg>
      <div class="cfsw-drop-badge"><span class="cfsw-drop-n">NEW DROP</span><span class="cfsw-drop-l">Limited Pieces</span></div>
    </div>
  </section>
  <div class="cfsw-cats">
    <a href="#" class="cfsw-cat"><span class="cfsw-cat-name">Hoodies</span><span class="cfsw-cat-count">24 pieces</span></a>
    <a href="#" class="cfsw-cat"><span class="cfsw-cat-name">Tees</span><span class="cfsw-cat-count">36 pieces</span></a>
    <a href="#" class="cfsw-cat"><span class="cfsw-cat-name">Bottoms</span><span class="cfsw-cat-count">18 pieces</span></a>
    <a href="#" class="cfsw-cat"><span class="cfsw-cat-name">Caps</span><span class="cfsw-cat-count">12 pieces</span></a>
    <a href="#" class="cfsw-cat"><span class="cfsw-cat-name">Sale</span><span class="cfsw-cat-count">40% Off</span></a>
  </div>
  <section class="cfsw-prods">
    <div class="cfsw-ph"><h2>THIS WEEK'S DROP</h2><a href="{{ routes.collections_url }}">View All →</a></div>
    <div class="cfsw-grid">
      {% assign col = collections[section.settings.featured_collection] %}
      {% if col and col.products.size > 0 %}
        {% for p in col.products limit: 3 %}
          <div class="cfsw-card">
            <div class="cfsw-card-img">{% if p.featured_image %}<img src="{{ p.featured_image | img_url: '800x' }}" alt="{{ p.title }}">{% else %}<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.8"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>{% endif %}{% if p.compare_at_price > p.price %}<span class="cfsw-card-tag">Sale</span>{% elsif p.created_at > 'now' | date: '%s' | minus: 604800 %}<span class="cfsw-card-tag">New Drop</span>{% endif %}</div>
            <div class="cfsw-card-body"><div class="cfsw-card-cat">{{ p.type | default: 'Streetwear' }}</div><div class="cfsw-card-name">{{ p.title }}</div><div class="cfsw-card-foot"><div class="cfsw-card-price">{{ p.price | money }}{% if p.compare_at_price > p.price %}<span class="cfsw-card-old">{{ p.compare_at_price | money }}</span>{% endif %}</div><button class="cfsw-atc" data-variant-id="{{ p.variants.first.id }}">Add to Cart</button></div></div>
          </div>
        {% endfor %}
      {% else %}
        <div class="cfsw-card"><div class="cfsw-card-img"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.8"><rect x="3" y="3" width="18" height="18" rx="2"/></svg><span class="cfsw-card-tag">New Drop</span></div><div class="cfsw-card-body"><div class="cfsw-card-cat">Bottoms</div><div class="cfsw-card-name">MARGA Relaxed Pants — Slate</div><div class="cfsw-card-foot"><div class="cfsw-card-price">&#8377;2,499</div><button class="cfsw-atc">Add to Cart</button></div></div></div>
        <div class="cfsw-card"><div class="cfsw-card-img"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.8"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div><div class="cfsw-card-body"><div class="cfsw-card-cat">Hoodies</div><div class="cfsw-card-name">CORE Heavyweight Hoodie — Washed Black</div><div class="cfsw-card-foot"><div class="cfsw-card-price">&#8377;3,499<span class="cfsw-card-old">&#8377;4,499</span></div><button class="cfsw-atc">Add to Cart</button></div></div></div>
        <div class="cfsw-card"><div class="cfsw-card-img"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.8"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div><div class="cfsw-card-body"><div class="cfsw-card-cat">Tees</div><div class="cfsw-card-name">BLOC Graphic Tee — Off White</div><div class="cfsw-card-foot"><div class="cfsw-card-price">&#8377;1,299</div><button class="cfsw-atc">Add to Cart</button></div></div></div>
      {% endif %}
    </div>
  </section>
  <section class="cfsw-cta">
    <h2>NEXT DROP DROPPING SOON.</h2>
    <p>{{ section.settings.cta_sub | default: 'Subscribe to get early access, exclusive drops, and 10% off your first order.' }}</p>
    <a href="{{ section.settings.cta_url | default: routes.collections_url }}" class="cfsw-btn-wh">{{ section.settings.cta_btn | default: 'Shop All Drops' }}</a>
  </section>
  <footer class="cfsw-footer">
    <div class="cfsw-fg">
      <div class="cfsw-fb"><a href="{{ routes.root_url }}">{{ section.settings.brand_name | default: 'URBN' }}<span>CO</span></a><p>Limited streetwear drops for those who dress different. Unapologetically urban since 2020.</p></div>
      <div class="cfsw-fc"><h4>Shop</h4><ul><li><a href="#">New Drops</a></li><li><a href="#">Hoodies</a></li><li><a href="#">Bottoms</a></li><li><a href="#">Tees</a></li></ul></div>
      <div class="cfsw-fc"><h4>Brand</h4><ul><li><a href="#">Lookbook</a></li><li><a href="#">About</a></li><li><a href="#">Collabs</a></li></ul></div>
      <div class="cfsw-fc"><h4>Support</h4><ul><li><a href="#">Track Order</a></li><li><a href="#">Returns</a></li><li><a href="#">Size Guide</a></li><li><a href="#">Contact</a></li></ul></div>
    </div>
    <div class="cfsw-fbot"><span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'URBNCO' }}.</span><span>Privacy &middot; Terms</span></div>
  </footer>
</div>
{% schema %}
{
  "name": "Streetwear Landing",
  "settings": [
    {"type":"text","id":"brand_name","label":"Brand Name","default":"URBNCO"},
    {"type":"text","id":"hero_eyebrow","label":"Hero Eyebrow","default":"New Drop — SS25"},
    {"type":"textarea","id":"hero_h1","label":"Hero Heading","default":"DRESS THE STREETS."},
    {"type":"textarea","id":"hero_sub","label":"Hero Subtext","default":"Limited drops. Unlimited style. Streetwear built for those who move different."},
    {"type":"text","id":"cta1_text","label":"CTA 1 Text","default":"Shop the Drop"},
    {"type":"url","id":"cta1_url","label":"CTA 1 URL"},
    {"type":"text","id":"cta2_text","label":"CTA 2 Text","default":"View Lookbook"},
    {"type":"url","id":"cta2_url","label":"CTA 2 URL"},
    {"type":"collection","id":"featured_collection","label":"Featured Collection"},
    {"type":"text","id":"cta_btn","label":"CTA Banner Button","default":"Shop All Drops"},
    {"type":"url","id":"cta_url","label":"CTA Banner URL"},
    {"type":"textarea","id":"cta_sub","label":"CTA Banner Subtext","default":"Subscribe to get early access, exclusive drops, and 10% off your first order."}
  ],
  "presets": [{"name":"Streetwear Landing"}]
}
{% endschema %}
