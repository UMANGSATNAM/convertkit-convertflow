{% schema %}
{
  "name": "CF Pet Supplies Coll",
  "settings": [
    {
      "type": "header",
      "content": "Brand Colors"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent Color",
      "default": "#D35400"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Background",
      "default": "#f9e0d1"
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show Collection Banner",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Background Image"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
