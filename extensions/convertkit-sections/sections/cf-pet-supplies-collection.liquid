{% comment %}
  ConvertFlow — Pet Supplies Collection Page
  Playful rounded grid with soft pill-shaped filters.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Quicksand:wght@500;600;700&display=swap');

  :root {
    --pet-primary: {{ section.settings.color_primary | default: '#FF6B35' }};
    --pet-secondary: {{ section.settings.color_secondary | default: '#FFD166' }};
    --pet-bg: {{ section.settings.color_bg | default: '#FFF8F0' }};
    --pet-surface: {{ section.settings.color_surface | default: '#FFFFFF' }};
    --pet-text: {{ section.settings.color_text | default: '#2B2D42' }};
    --pet-font-heading: 'Quicksand', sans-serif;
    --pet-font-body: 'Nunito', sans-serif;
  }

  .cf-pet-c * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-pet-c { font-family: var(--pet-font-body); background: var(--pet-bg); color: var(--pet-text); }
  
  .cf-pet-c-header { background: var(--pet-surface); text-align: center; padding: 60px 5%; border-bottom-left-radius: 60px; border-bottom-right-radius: 60px; box-shadow: 0 10px 30px rgba(0,0,0,0.02); margin-bottom: 40px; position: relative; }
  .cf-pet-c-header h1 { font-family: var(--pet-font-heading); font-size: clamp(36px, 5vw, 48px); font-weight: 700; color: var(--pet-text); margin-bottom: 12px; }
  .cf-pet-c-header p { font-size: 16px; color: #666; max-width: 500px; margin: 0 auto; font-weight: 600; }
  
  .cf-pet-c-main { max-width: 1400px; margin: 0 auto; padding: 0 5% 80px; }
  
  .cf-pet-c-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; }
  .cf-pet-c-filters { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 10px; }
  .cf-pet-c-filters::-webkit-scrollbar { display: none; }
  .cf-pet-c-filter { padding: 10px 24px; background: var(--pet-surface); border: 2px solid #eee; border-radius: 50px; font-family: var(--pet-font-heading); font-weight: 700; font-size: 15px; color: var(--pet-text); cursor: pointer; white-space: nowrap; transition: all 0.3s; }
  .cf-pet-c-filter:hover, .cf-pet-c-filter.active { border-color: var(--pet-primary); background: var(--pet-primary); color: #fff; box-shadow: 0 5px 15px rgba(255, 107, 53, 0.2); transform: translateY(-2px); }
  
  .cf-pet-c-sort select { border: 2px solid #eee; border-radius: 50px; padding: 10px 20px; font-family: var(--pet-font-heading); font-weight: 700; font-size: 15px; color: var(--pet-text); background: var(--pet-surface); outline: none; cursor: pointer; }
  
  .cf-pet-c-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; }
  .cf-pet-prod { text-decoration: none; color: var(--pet-text); background: var(--pet-surface); border-radius: 24px; padding: 20px; transition: transform 0.3s, box-shadow 0.3s; position: relative; }
  .cf-pet-prod:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.05); border-bottom: 4px solid var(--pet-primary); margin-bottom: -4px; }
  
  .cf-pet-prod-img { aspect-ratio: 1; background: #FFF8F0; border-radius: 16px; margin-bottom: 20px; display: flex; align-items: center; justify-content: center; padding: 20px; }
  .cf-pet-prod-img img { max-width: 100%; max-height: 100%; object-fit: contain; transition: transform 0.3s; }
  .cf-pet-prod:hover .cf-pet-prod-img img { transform: scale(1.08); }
  
  .cf-pet-prod-tag { position: absolute; top: 10px; left: 10px; background: var(--pet-secondary); color: var(--pet-text); font-family: var(--pet-font-heading); font-weight: 700; font-size: 12px; padding: 4px 12px; border-radius: 20px; z-index: 2; }
  
  .cf-pet-prod-title { font-family: var(--pet-font-body); font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--pet-text); }
  .cf-pet-prod-price { font-family: var(--pet-font-heading); font-size: 20px; color: var(--pet-primary); font-weight: 800; }

  @media(max-width: 1024px) {
    .cf-pet-c-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media(max-width: 768px) {
    .cf-pet-c-header { border-bottom-left-radius: 40px; border-bottom-right-radius: 40px; }
    .cf-pet-c-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .cf-pet-c-toolbar { flex-direction: column; gap: 20px; align-items: stretch; }
  }
{% endstyle %}

<div class="cf-pet-c">
  <div class="cf-pet-c-header">
    <h1>{{ collection.title | default: 'All Pet Products' }}</h1>
    {% if collection.description != blank %}
      <p>{{ collection.description | strip_html | truncate: 150 }}</p>
    {% endif %}
  </div>
  
  <div class="cf-pet-c-main">
    <div class="cf-pet-c-toolbar">
      <div class="cf-pet-c-filters">
        <div class="cf-pet-c-filter active">All Supplies</div>
        <div class="cf-pet-c-filter">Dogs</div>
        <div class="cf-pet-c-filter">Cats</div>
        <div class="cf-pet-c-filter">Toys</div>
        <div class="cf-pet-c-filter">Food & Treats</div>
      </div>
      <div class="cf-pet-c-sort">
        <select>
          <option>Sort By: Best Selling</option>
          <option>Price: Low to High</option>
          <option>Price: High to Low</option>
        </select>
      </div>
    </div>
    
    <div class="cf-pet-c-grid">
      {% if collection.products.size > 0 %}
        {% for product in collection.products %}
          <a href="{{ product.url }}" class="cf-pet-prod">
            {% if product.tags contains 'new' %}
              <div class="cf-pet-prod-tag" style="background:var(--pet-primary); color:#fff;">New Arrival</div>
            {% endif %}
            <div class="cf-pet-prod-img">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}">
              {% endif %}
            </div>
            <div class="cf-pet-prod-title">{{ product.title }}</div>
            <div class="cf-pet-prod-price">{{ product.price | money }}</div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..8) %}
          <a href="#" class="cf-pet-prod">
            <div class="cf-pet-prod-tag">Best Seller</div>
            <div class="cf-pet-prod-img"><div style="width:80%; height:80%; background:#f0f0f0; border-radius:50%;"></div></div>
            <div class="cf-pet-prod-title">Yummy Treats {{ i }}</div>
            <div class="cf-pet-prod-price">$14.99</div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CF Pet Supplies Collection",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Primary Accent", "default": "#FF6B35" },
    { "type": "color", "id": "color_secondary", "label": "Secondary Accent", "default": "#FFD166" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#FFF8F0" },
    { "type": "color", "id": "color_surface", "label": "Surface", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#2B2D42" }
  ],
  "presets": [
    { "name": "CF Pet Supplies Collection" }
  ]
}
{% endschema %}