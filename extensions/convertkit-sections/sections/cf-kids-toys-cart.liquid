{% comment %} ConvertFlow — Kids Toys Cart Page {% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Fredoka+One&family=Varela+Round&display=swap');
  .cf-kids-cart*{box-sizing:border-box;margin:0;padding:0}
  .cf-kids-cart{font-family:'Varela Round',sans-serif;background:#F0F8FF;color:#333;padding:80px 5%;min-height:80vh}
  
  .cf-kids-cart-wrap{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 380px;gap:40px}
  
  .cf-kids-cart-h1{font-family:'Fredoka One',cursive;font-size:48px;margin-bottom:30px;color:{{ section.settings.color_blue | default: '#4D94FF' }}}
  
  .cf-kids-c-items{background:#fff;border-radius:40px;padding:30px;box-shadow:0 20px 40px rgba(0,0,0,.05)}
  .cf-kids-c-item{display:grid;grid-template-columns:100px 1fr auto;gap:24px;padding:24px 0;border-bottom:4px dotted #F0F8FF;align-items:center}
  .cf-kids-c-item:last-child{border-bottom:none;padding-bottom:0}
  .cf-kids-c-item:first-child{padding-top:0}
  
  .cf-kids-c-img{aspect-ratio:1;background:#F0F8FF;border-radius:20px;padding:10px;display:flex;align-items:center;justify-content:center}
  .cf-kids-c-img img{max-width:100%;max-height:100%;object-fit:contain}
  
  .cf-kids-c-info h3{font-family:'Fredoka One',cursive;font-size:20px;margin-bottom:8px}
  
  .cf-kids-c-qty{display:inline-flex;background:#F0F8FF;border-radius:50px;align-items:center;padding:4px 16px;font-family:'Fredoka One',cursive}
  .cf-kids-c-qty button{background:none;border:none;font-size:20px;color:{{ section.settings.color_blue | default: '#4D94FF' }};cursor:pointer}
  .cf-kids-c-qty span{margin:0 12px;font-size:18px}
  
  .cf-kids-c-remove{margin-left:20px;color:{{ section.settings.color_red | default: '#FF4D4D' }};text-decoration:none;font-weight:700}
  
  .cf-kids-c-price{font-family:'Fredoka One',cursive;font-size:24px;color:{{ section.settings.color_red | default: '#FF4D4D' }}}
  
  .cf-kids-c-sum{background:#fff;border-radius:40px;padding:30px;box-shadow:0 20px 40px rgba(0,0,0,.05);position:sticky;top:40px}
  .cf-kids-c-sum h2{font-family:'Fredoka One',cursive;font-size:28px;margin-bottom:24px;color:{{ section.settings.color_blue | default: '#4D94FF' }}}
  .cf-kids-c-row{display:flex;justify-content:space-between;font-size:18px;font-weight:600;margin-bottom:16px;color:#666}
  .cf-kids-c-total{display:flex;justify-content:space-between;font-size:24px;font-weight:700;color:#333;margin-top:24px;padding-top:24px;border-top:4px dotted #F0F8FF;font-family:'Fredoka One',cursive}
  .cf-kids-c-total span:last-child{color:{{ section.settings.color_red | default: '#FF4D4D' }};font-size:32px}
  
  .cf-kids-c-btn{display:block;width:100%;text-align:center;margin-top:30px;background:{{ section.settings.color_yellow | default: '#FFD11A' }};color:#333;border:none;border-radius:50px;padding:20px;font-family:'Fredoka One',cursive;font-size:24px;text-decoration:none;cursor:pointer;box-shadow:0 8px 0px rgba(200,160,0,1);transition:all .2s;text-transform:uppercase}
  .cf-kids-c-btn:hover{transform:translateY(4px);box-shadow:0 4px 0px rgba(200,160,0,1)}

  .cf-kids-empty{grid-column:1/-1;text-align:center;padding:80px;background:#fff;border-radius:40px}
  .cf-kids-empty h2{font-family:'Fredoka One',cursive;font-size:40px;margin-bottom:20px;color:{{ section.settings.color_blue | default: '#4D94FF' }}}

  @media(max-width:900px){
    .cf-kids-cart-wrap{grid-template-columns:1fr}
    .cf-kids-c-item{grid-template-columns:80px 1fr;position:relative}
    .cf-kids-c-price{position:absolute;top:24px;right:0}
  }
{% endstyle %}

<div class="cf-kids-cart">
  <div class="cf-kids-cart-wrap">
    {% if cart.item_count == 0 %}
      <div class="cf-kids-empty">
        <h2>Your Toy Box is Empty! 🎈</h2>
        <p style="font-size:20px;color:#666;margin-bottom:30px;font-weight:600">Let's find some fun toys to play with.</p>
        <a href="/collections/all" class="cf-kids-c-btn" style="display:inline-block;width:auto;padding:16px 40px">Explore Toys</a>
      </div>
    {% else %}
      <div>
        <h1 class="cf-kids-cart-h1">Toy Box 🎁</h1>
        <div class="cf-kids-c-items">
          {% for item in cart.items %}
            <div class="cf-kids-c-item">
              <div class="cf-kids-c-img">
                {% if item.image %}<img src="{{ item.image | img_url: '200x' }}" alt="{{ item.title }}">{% endif %}
              </div>
              <div class="cf-kids-c-info">
                <h3>{{ item.product.title }}</h3>
                <div class="cf-kids-c-qty">
                  <button>-</button><span>{{ item.quantity }}</span><button>+</button>
                </div>
                <a href="{{ item.url_to_remove }}" class="cf-kids-c-remove">Remove</a>
              </div>
              <div class="cf-kids-c-price">{{ item.final_line_price | money }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
      
      <div class="cf-kids-c-sum">
        <h2>Order Summary</h2>
        <div class="cf-kids-c-row"><span>Subtotal</span> <span>{{ cart.total_price | money }}</span></div>
        <div class="cf-kids-c-total"><span>Total</span> <span>{{ cart.total_price | money }}</span></div>
        <a href="/checkout" class="cf-kids-c-btn">Checkout Now!</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "CF Kids Toys Cart",
  "settings": [
    { "type": "color", "id": "color_red", "label": "Red", "default": "#FF4D4D" },
    { "type": "color", "id": "color_blue", "label": "Blue", "default": "#4D94FF" },
    { "type": "color", "id": "color_yellow", "label": "Yellow", "default": "#FFD11A" }
  ],
  "presets": [{ "name": "CF Kids Toys Cart" }]
}
{% endschema %}