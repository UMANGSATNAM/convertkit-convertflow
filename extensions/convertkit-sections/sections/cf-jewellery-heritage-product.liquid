{% comment %}
  ConvertFlow — Jewellery Heritage Product Page
  Elegant layout with certified diamond badges and gold accents.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Lato:wght@300;400;700&display=swap');

  :root {
    --jh-primary: {{ section.settings.color_primary | default: '#D4AF37' }};
    --jh-bg: {{ section.settings.color_bg | default: '#FFFFFF' }};
    --jh-surface: {{ section.settings.color_surface | default: '#FAFAFA' }};
    --jh-border: rgba(212, 175, 55, 0.3);
    --jh-text: {{ section.settings.color_text | default: '#222222' }};
    --jh-font-heading: 'Playfair Display', serif;
    --jh-font-body: 'Lato', sans-serif;
  }

  .cf-jh-p * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-jh-p { font-family: var(--jh-font-body); background: var(--jh-bg); color: var(--jh-text); line-height: 1.6; }
  
  .cf-jh-p-wrap { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1.2fr 1fr; gap: 80px; padding: 60px 5%; align-items: center; }
  
  /* Gallery */
  .cf-jh-p-gallery { display: grid; grid-template-columns: 80px 1fr; gap: 20px; }
  .cf-jh-p-thumbs { display: flex; flex-direction: column; gap: 10px; }
  .cf-jh-p-thumb { aspect-ratio: 1; border: 1px solid #eaeaea; cursor: pointer; transition: border-color 0.3s; padding: 5px; }
  .cf-jh-p-thumb:hover, .cf-jh-p-thumb.active { border-color: var(--jh-primary); }
  .cf-jh-p-thumb img { width: 100%; height: 100%; object-fit: contain; }
  
  .cf-jh-p-main-img { border: 1px solid #eaeaea; aspect-ratio: 1; padding: 40px; display: flex; align-items: center; justify-content: center; }
  .cf-jh-p-main-img img { width: 100%; height: 100%; object-fit: contain; }
  
  /* Info */
  .cf-jh-p-info { max-width: 500px; }
  .cf-jh-p-vendor { font-size: 11px; text-transform: uppercase; letter-spacing: 3px; color: #888; margin-bottom: 12px; }
  .cf-jh-p-title { font-family: var(--jh-font-heading); font-size: 36px; font-weight: 400; margin-bottom: 16px; line-height: 1.2; color: var(--jh-text); }
  .cf-jh-p-price { font-size: 24px; color: var(--jh-primary); margin-bottom: 30px; font-family: var(--jh-font-heading); }
  
  .cf-jh-p-desc { font-size: 14px; color: #555; margin-bottom: 40px; font-weight: 300; line-height: 1.8; }
  
  /* Options */
  .cf-jh-p-opt { margin-bottom: 30px; }
  .cf-jh-p-opt-header { display: flex; justify-content: space-between; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px; color: #222; }
  .cf-jh-p-vals { display: flex; flex-wrap: wrap; gap: 10px; }
  .cf-jh-p-val { padding: 10px 20px; border: 1px solid #eaeaea; background: #fff; color: var(--jh-text); font-size: 13px; cursor: pointer; transition: all 0.3s; }
  .cf-jh-p-val:hover, .cf-jh-p-val.active { border-color: var(--jh-primary); color: var(--jh-primary); }
  
  /* Actions */
  .cf-jh-p-actions { margin-bottom: 40px; }
  .cf-jh-p-add { width: 100%; padding: 18px; background: var(--jh-primary); color: #fff; border: 1px solid var(--jh-primary); font-size: 13px; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: all 0.4s ease; margin-bottom: 12px; }
  .cf-jh-p-add:hover { background: #fff; color: var(--jh-primary); }
  .cf-jh-p-buy { width: 100%; padding: 18px; background: transparent; border: 1px solid var(--jh-text); color: var(--jh-text); font-size: 13px; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: all 0.4s ease; }
  .cf-jh-p-buy:hover { background: var(--jh-text); color: #fff; }
  
  /* Trust Badges */
  .cf-jh-p-trust { display: flex; gap: 20px; justify-content: space-between; border-top: 1px solid #eaeaea; padding-top: 30px; }
  .cf-jh-p-trust-item { text-align: center; flex: 1; }
  .cf-jh-p-trust-item svg { color: var(--jh-primary); margin-bottom: 8px; width: 24px; height: 24px; }
  .cf-jh-p-trust-item span { display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: #666; }

  @media(max-width: 900px) {
    .cf-jh-p-wrap { grid-template-columns: 1fr; gap: 40px; }
    .cf-jh-p-gallery { grid-template-columns: 1fr; }
    .cf-jh-p-thumbs { flex-direction: row; order: 2; overflow-x: auto; }
    .cf-jh-p-thumb { flex: 0 0 80px; }
  }
{% endstyle %}

<div class="cf-jh-p">
  <div class="cf-jh-p-wrap">
    
    <div class="cf-jh-p-gallery">
      <div class="cf-jh-p-thumbs">
        {% for image in product.images limit:4 %}
          <div class="cf-jh-p-thumb {% if forloop.first %}active{% endif %}">
            <img src="{{ image | img_url: '150x' }}" alt="{{ product.title }}">
          </div>
        {% endfor %}
      </div>
      <div class="cf-jh-p-main-img">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title }}">
        {% else %}
          <div style="width:100px; height:100px; background:rgba(212,175,55,0.1); border-radius:50%;"></div>
        {% endif %}
      </div>
    </div>
    
    <div class="cf-jh-p-info">
      <div class="cf-jh-p-vendor">{{ product.vendor | default: 'Heritage Collection' }}</div>
      <h1 class="cf-jh-p-title">{{ product.title | default: 'Diamond Solitaire Pendant' }}</h1>
      <div class="cf-jh-p-price">{{ product.price | money | default: '$1,850.00' }}</div>
      
      <div class="cf-jh-p-desc">
        {{ product.description | strip_html | truncate: 250 | default: 'A timeless classic. This exquisite piece features a brilliant-cut diamond set in 18k solid gold. Handcrafted by master artisans to ensure a lifetime of brilliance and elegance.' }}
      </div>
      
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="cf-jh-p-opt">
            <div class="cf-jh-p-opt-header">
              <span>{{ option.name }}</span>
              {% if option.name contains 'Size' or option.name contains 'size' %}
                <span style="text-decoration:underline; cursor:pointer; color:var(--jh-primary);">Ring Size Guide</span>
              {% endif %}
            </div>
            <div class="cf-jh-p-vals">
              {% for value in option.values %}
                <button class="cf-jh-p-val {% if forloop.first %}active{% endif %}">{{ value }}</button>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      {% endunless %}
      
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <div class="cf-jh-p-actions">
          <button type="submit" class="cf-jh-p-add">Add to Bag</button>
          <button type="button" class="cf-jh-p-buy">Buy It Now</button>
        </div>
      {% endform %}
      
      <div class="cf-jh-p-trust">
        <div class="cf-jh-p-trust-item">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path d="M12 2l3 6 6 1-4.5 4.5 1.5 6-6-3.5L6 19.5l1.5-6L3 9l6-1 3-6z"/></svg>
          <span>Authentic</span>
        </div>
        <div class="cf-jh-p-trust-item">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Certified</span>
        </div>
        <div class="cf-jh-p-trust-item">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          <span>Insured</span>
        </div>
      </div>
      
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CF Jewellery PDP",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Gold Accent", "default": "#D4AF37" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_surface", "label": "Surface", "default": "#FAFAFA" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#222222" }
  ],
  "presets": [
    { "name": "CF Jewellery PDP" }
  ]
}
{% endschema %}