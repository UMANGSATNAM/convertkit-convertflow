{% schema %}
{
  "name": "CF Clean Cosmetics Cart",
  "settings": [
    {
      "type": "header",
      "content": "Brand Colors"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent Color",
      "default": "#D4BBA5"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Background",
      "default": "#f8f3f0"
    },
    {
      "type": "header",
      "content": "Cart Settings"
    },
    {
      "type": "text",
      "id": "checkout_text",
      "label": "Checkout Button Text",
      "default": "Proceed to Checkout Ã¢â€ â€™"
    },
    {
      "type": "checkbox",
