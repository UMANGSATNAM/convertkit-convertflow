{% comment %}ConvertFlow - Baby Apparel Landing | Little Cloud style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600&family=Nunito:wght@400;600;700&family=Pacifico&display=swap" rel="stylesheet">
<style>
.cfba{--bl:#94C5CC;--pk:#F6A8B6;--ac:#F9DAA8;--bg:#FDFBEE;--sf:#fff;--text:#4A4A4A;--mu:#8E8E8E;--bd:#F0EAE1;}
.cfba *{box-sizing:border-box;margin:0;padding:0;}
.cfba{background:var(--bg);color:var(--text);font-family:'Nunito',sans-serif;font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;}
.cfba h1,.cfba h2,.cfba h3{font-family:'Fredoka',sans-serif;}
.cfba-top{background:var(--bl);color:#fff;text-align:center;padding:10px;font-size:14px;font-weight:600;letter-spacing:.5px;}
.cfba-hdr{padding:24px 60px;display:flex;align-items:center;justify-content:space-between;border-bottom:2px dashed var(--bd);}
.cfba-brand{font-family:'Fredoka',sans-serif;font-size:32px;font-weight:600;color:var(--text);text-decoration:none;display:flex;align-items:center;gap:8px;}
.cfba-brand-dot{width:10px;height:10px;background:var(--bl);border-radius:50%;display:inline-block;}
.cfba-nav{display:flex;gap:24px;list-style:none;}
.cfba-nav a{font-size:14px;font-weight:600;color:var(--text);text-decoration:none;transition:color .2s;}
.cfba-nav a:hover{color:var(--bl);}
.cfba-hbtn{background:var(--pk);color:#fff;padding:12px 24px;border-radius:100px;font-family:'Fredoka',sans-serif;font-size:15px;font-weight:600;text-decoration:none;transition:opacity .2s;}
.cfba-hbtn:hover{opacity:.85;}
.cfba-hero{background:linear-gradient(135deg,#EEF8FA 0%,#FEF3F6 50%,#FFFBF0 100%);display:grid;grid-template-columns:1fr 1fr;min-height:85vh;padding:0 60px;align-items:center;gap:60px;border-bottom:1px solid var(--bd);position:relative;overflow:hidden;}
.cfba-hero::before{content:'☁️';position:absolute;top:40px;right:80px;font-size:80px;opacity:.15;}
.cfba-hero::after{content:'⭐';position:absolute;bottom:60px;left:80px;font-size:60px;opacity:.15;}
.cfba-h-badge{display:inline-flex;align-items:center;gap:8px;background:var(--ac);color:#5A4A00;padding:6px 18px;border-radius:100px;font-size:12px;font-weight:700;letter-spacing:.5px;margin-bottom:20px;}
.cfba-hero h1{font-size:clamp(48px,5vw,68px);font-weight:600;line-height:1.15;margin-bottom:20px;color:#3A3A3A;}
.cfba-hero h1 span{font-family:'Pacifico',cursive;color:var(--pk);font-weight:400;font-size:.9em;}
.cfba-hero>div>p{font-size:17px;color:var(--mu);line-height:1.8;max-width:440px;margin-bottom:36px;}
.cfba-btns{display:flex;gap:12px;flex-wrap:wrap;}
.cfba-btn-bl{background:var(--bl);color:#fff;padding:16px 36px;border-radius:100px;font-family:'Fredoka',sans-serif;font-size:16px;font-weight:600;text-decoration:none;box-shadow:0 6px 20px rgba(148,197,204,.4);transition:all .2s;}
.cfba-btn-bl:hover{transform:translateY(-2px);}
.cfba-btn-pk{background:transparent;color:var(--pk);border:2px solid var(--pk);padding:14px 36px;border-radius:100px;font-family:'Fredoka',sans-serif;font-size:16px;font-weight:600;text-decoration:none;transition:all .2s;}
.cfba-btn-pk:hover{background:var(--pk);color:#fff;}
.cfba-age-badges{display:flex;gap:10px;margin-top:28px;}
.cfba-ab{padding:6px 18px;border-radius:100px;font-size:12px;font-weight:700;}
.cfba-ab1{background:#EEF8FA;color:#3A8F96;}
.cfba-ab2{background:#FEF0F4;color:#C06080;}
.cfba-ab3{background:#FFFAED;color:#A07820;}
.cfba-hero-vis{display:flex;align-items:center;justify-content:center;}
.cfba-cloud-blob{width:400px;height:400px;border-radius:50% 40% 55% 45%;background:linear-gradient(135deg,#BEE9EF,#F6D0DC);display:flex;align-items:center;justify-content:center;animation:cfba-blob 8s ease-in-out infinite;}
@keyframes cfba-blob{0%,100%{border-radius:50% 40% 55% 45%}50%{border-radius:40% 55% 45% 50%}}
.cfba-cloud-blob svg{width:55%;color:#fff;opacity:.5;}
.cfba-categories{padding:70px 60px;max-width:1400px;margin:0 auto;}
.cfba-sh{text-align:center;margin-bottom:50px;}
.cfba-sh h2{font-size:40px;font-weight:600;color:#3A3A3A;}
.cfba-sh p{font-size:16px;color:var(--mu);margin-top:8px;}
.cfba-cat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.cfba-cat{background:var(--sf);border:2px solid var(--bd);border-radius:20px;padding:28px 20px;text-align:center;text-decoration:none;color:var(--text);transition:all .3s;}
.cfba-cat:hover{border-color:var(--bl);transform:translateY(-4px);}
.cfba-cat:nth-child(2){border-color:var(--pk);}
.cfba-cat:nth-child(3){border-color:var(--ac);}
.cfba-cat-emoji{font-size:40px;display:block;margin-bottom:12px;}
.cfba-cat-name{font-family:'Fredoka',sans-serif;font-size:18px;font-weight:600;margin-bottom:4px;}
.cfba-cat-count{font-size:12px;color:var(--mu);}
.cfba-prods{padding:0 60px 80px;max-width:1400px;margin:0 auto;}
.cfba-ph{display:flex;justify-content:space-between;align-items:center;margin-bottom:40px;}
.cfba-ph h2{font-size:36px;font-weight:600;}
.cfba-ph a{font-size:13px;font-weight:700;color:var(--bl);text-decoration:none;}
.cfba-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}
.cfba-card{background:var(--sf);border-radius:20px;overflow:hidden;border:2px solid var(--bd);transition:all .3s;}
.cfba-card:hover{border-color:var(--bl);box-shadow:0 10px 40px rgba(0,0,0,.07);transform:translateY(-4px);}
.cfba-card-img{aspect-ratio:1;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.cfba-card-img img{width:100%;height:100%;object-fit:cover;}
.cfba-card-img svg{width:40%;opacity:.2;color:var(--bl);}
.cfba-card-badge{position:absolute;top:12px;left:12px;padding:4px 12px;border-radius:100px;font-size:10px;font-weight:700;}
.cfba-card-badge-bl{background:#EEF8FA;color:#3A8F96;}
.cfba-card-badge-pk{background:#FEF0F4;color:#C06080;}
.cfba-card-body{padding:18px;}
.cfba-card-type{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--bl);margin-bottom:6px;}
.cfba-card-name{font-family:'Fredoka',sans-serif;font-size:17px;font-weight:600;margin-bottom:4px;line-height:1.3;}
.cfba-card-age{font-size:12px;color:var(--mu);margin-bottom:14px;}
.cfba-card-foot{display:flex;justify-content:space-between;align-items:center;}
.cfba-card-price{font-family:'Fredoka',sans-serif;font-size:20px;font-weight:600;}
.cfba-card-old{font-size:13px;color:var(--mu);text-decoration:line-through;margin-left:6px;}
.cfba-atc{background:var(--bl);color:#fff;border:none;padding:10px 18px;border-radius:100px;font-size:12px;font-weight:700;cursor:pointer;font-family:'Nunito',sans-serif;transition:background .2s;}
.cfba-atc:hover{background:#7ab3ba;}
.cfba-safety{background:linear-gradient(135deg,#EEF8FA,#FEF3F6);padding:70px 60px;border-top:1px solid var(--bd);border-bottom:1px solid var(--bd);}
.cfba-safety-inner{max-width:1400px;margin:0 auto;}
.cfba-safety h2{font-family:'Fredoka',sans-serif;font-size:40px;font-weight:600;text-align:center;margin-bottom:50px;color:#3A3A3A;}
.cfba-safety-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;}
.cfba-si{text-align:center;}
.cfba-si-icon{font-size:40px;display:block;margin-bottom:16px;}
.cfba-si strong{font-family:'Fredoka',sans-serif;font-size:18px;display:block;margin-bottom:6px;}
.cfba-si span{font-size:13px;color:var(--mu);}
.cfba-footer{padding:80px 60px 40px;border-top:1px solid var(--bd);}
.cfba-fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;padding-bottom:60px;border-bottom:1px solid var(--bd);}
.cfba-fb h3{font-family:'Fredoka',sans-serif;font-size:28px;font-weight:600;color:var(--bl);margin-bottom:16px;}
.cfba-fb p{font-size:13px;color:var(--mu);line-height:1.9;max-width:260px;}
.cfba-fc h4{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--mu);margin-bottom:20px;}
.cfba-fc ul{list-style:none;}
.cfba-fc li{margin-bottom:10px;}
.cfba-fc a{color:var(--text);text-decoration:none;font-size:14px;opacity:.65;transition:opacity .2s;}
.cfba-fc a:hover{opacity:1;color:var(--bl);}
.cfba-fbot{display:flex;justify-content:space-between;padding-top:28px;font-size:11px;color:var(--mu);}
@media(max-width:1024px){.cfba-hero{grid-template-columns:1fr;min-height:auto}.cfba-cloud-blob{display:none}.cfba-cat-grid{grid-template-columns:repeat(2,1fr)}.cfba-grid{grid-template-columns:repeat(2,1fr)}.cfba-safety-grid{grid-template-columns:repeat(2,1fr)}.cfba-fg{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cfba-hdr{padding:16px 20px}.cfba-nav{display:none}.cfba-hero{padding:60px 20px}.cfba-hero h1{font-size:44px}.cfba-categories,.cfba-prods{padding:60px 20px}.cfba-grid{grid-template-columns:1fr}.cfba-safety{padding:60px 20px}.cfba-fg{grid-template-columns:1fr;gap:40px}.cfba-footer{padding:60px 20px 30px}}
</style>
<div class="cfba">
  <div class="cfba-top">☁️ {{ section.settings.promo_text | default: 'Free delivery on all baby orders above ₹499 · 100% Organic Cotton' }}</div>
  <header class="cfba-hdr">
    <a href="{{ routes.root_url }}" class="cfba-brand">Little <span class="cfba-brand-dot"></span> Cloud</a>
    <ul class="cfba-nav"><li><a href="#">Newborn</a></li><li><a href="#">0–12 Months</a></li><li><a href="#">1–3 Years</a></li><li><a href="#">Gift Sets</a></li></ul>
    <a href="{{ routes.cart_url }}" class="cfba-hbtn">🛒 Cart ({{ cart.item_count }})</a>
  </header>
  <section class="cfba-hero">
    <div>
      <div class="cfba-h-badge">🌿 {{ section.settings.hero_badge | default: '100% GOTS Certified Organic Cotton' }}</div>
      <h1>Soft as a Cloud,<br><span>Pure</span> as Love.</h1>
      <p>{{ section.settings.hero_sub | default: 'Organic baby apparel crafted with love. Gentle on delicate skin, free from harmful chemicals, and kind to the planet.' }}</p>
      <div class="cfba-btns">
        <a href="{{ section.settings.cta1_url | default: routes.collections_url }}" class="cfba-btn-bl">{{ section.settings.cta1_text | default: 'Shop Newborn' }}</a>
        <a href="{{ section.settings.cta2_url | default: '#' }}" class="cfba-btn-pk">{{ section.settings.cta2_text | default: 'Gift Guide ☁️' }}</a>
      </div>
      <div class="cfba-age-badges"><span class="cfba-ab cfba-ab1">0–3 Months</span><span class="cfba-ab cfba-ab2">3–12 Months</span><span class="cfba-ab cfba-ab3">1–3 Years</span></div>
    </div>
    <div class="cfba-hero-vis">
      <div class="cfba-cloud-blob"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.8"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg></div>
    </div>
  </section>
  <section class="cfba-categories">
    <div class="cfba-sh"><h2>Shop by Age</h2><p>Perfectly sized clothing for every precious milestone.</p></div>
    <div class="cfba-cat-grid">
      <a href="#" class="cfba-cat"><span class="cfba-cat-emoji">🍼</span><div class="cfba-cat-name">Newborn (0–3M)</div><div class="cfba-cat-count">60+ styles</div></a>
      <a href="#" class="cfba-cat"><span class="cfba-cat-emoji">🌸</span><div class="cfba-cat-name">Baby (3–12M)</div><div class="cfba-cat-count">100+ styles</div></a>
      <a href="#" class="cfba-cat"><span class="cfba-cat-emoji">🌈</span><div class="cfba-cat-name">Toddler (1–3Y)</div><div class="cfba-cat-count">80+ styles</div></a>
      <a href="#" class="cfba-cat"><span class="cfba-cat-emoji">🎁</span><div class="cfba-cat-name">Gift Sets</div><div class="cfba-cat-count">30+ sets</div></a>
    </div>
  </section>
  <section class="cfba-prods">
    <div class="cfba-ph"><h2>☁️ New Arrivals</h2><a href="{{ routes.collections_url }}">See all →</a></div>
    <div class="cfba-grid">
      {% assign col = collections[section.settings.featured_collection] %}
      {% if col and col.products.size > 0 %}
        {% for p in col.products limit: 4 %}
          <div class="cfba-card">
            <div class="cfba-card-img" style="background:#EEF8FA;">{% if p.featured_image %}<img src="{{ p.featured_image | img_url: '400x' }}" alt="{{ p.title }}">{% else %}<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.8"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>{% endif %}<span class="cfba-card-badge cfba-card-badge-bl">Organic</span></div>
            <div class="cfba-card-body"><div class="cfba-card-type">{{ p.type | default: 'Baby Apparel' }}</div><div class="cfba-card-name">{{ p.title }}</div><div class="cfba-card-age">{{ p.metafields.custom.age_range | default: '0–12 Months' }}</div><div class="cfba-card-foot"><div class="cfba-card-price">{{ p.price | money }}{% if p.compare_at_price > p.price %}<span class="cfba-card-old">{{ p.compare_at_price | money }}</span>{% endif %}</div><button class="cfba-atc" data-variant-id="{{ p.variants.first.id }}">Add to Cart</button></div></div>
          </div>
        {% endfor %}
      {% else %}
        <div class="cfba-card"><div class="cfba-card-img" style="background:#EEF8FA;"><span class="cfba-card-badge cfba-card-badge-bl">Organic</span><svg fill="none" stroke="#94C5CC" viewBox="0 0 24 24" stroke-width="0.8" width="60%" opacity="0.4"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg></div><div class="cfba-card-body"><div class="cfba-card-type">Bodysuits</div><div class="cfba-card-name">Cloud Soft Organic Bodysuit Set (3pc)</div><div class="cfba-card-age">0–6 Months</div><div class="cfba-card-foot"><div class="cfba-card-price">&#8377;1,299<span class="cfba-card-old">&#8377;1,599</span></div><button class="cfba-atc">Add to Cart</button></div></div></div>
        <div class="cfba-card"><div class="cfba-card-img" style="background:#FEF3F6;"><span class="cfba-card-badge cfba-card-badge-pk">New</span><svg fill="none" stroke="#F6A8B6" viewBox="0 0 24 24" stroke-width="0.8" width="60%" opacity="0.4"><circle cx="12" cy="12" r="10"/></svg></div><div class="cfba-card-body"><div class="cfba-card-type">Sleepwear</div><div class="cfba-card-name">Dream Little Sleepsuit — Blossom Print</div><div class="cfba-card-age">6–12 Months</div><div class="cfba-card-foot"><div class="cfba-card-price">&#8377;999</div><button class="cfba-atc">Add to Cart</button></div></div></div>
        <div class="cfba-card"><div class="cfba-card-img" style="background:#FFFAED;"><span class="cfba-card-badge cfba-card-badge-bl">Bestseller</span><svg fill="none" stroke="#F9DAA8" viewBox="0 0 24 24" stroke-width="0.8" width="60%" opacity="0.4"><rect x="3" y="3" width="18" height="18" rx="9"/></svg></div><div class="cfba-card-body"><div class="cfba-card-type">Sets</div><div class="cfba-card-name">Rainbow Days Outfit Set (Top + Bottom)</div><div class="cfba-card-age">1–2 Years</div><div class="cfba-card-foot"><div class="cfba-card-price">&#8377;1,599<span class="cfba-card-old">&#8377;1,999</span></div><button class="cfba-atc">Add to Cart</button></div></div></div>
        <div class="cfba-card"><div class="cfba-card-img" style="background:#F0F9EF;"><svg fill="none" stroke="#8FA68B" viewBox="0 0 24 24" stroke-width="0.8" width="60%" opacity="0.4"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><div class="cfba-card-body"><div class="cfba-card-type">Gift Set</div><div class="cfba-card-name">Welcome Baby Gift Hamper</div><div class="cfba-card-age">0–3 Months</div><div class="cfba-card-foot"><div class="cfba-card-price">&#8377;2,499</div><button class="cfba-atc">Add to Cart</button></div></div></div>
      {% endif %}
    </div>
  </section>
  <section class="cfba-safety">
    <div class="cfba-safety-inner">
      <h2>Safe for Every Little One 🌿</h2>
      <div class="cfba-safety-grid">
        <div class="cfba-si"><span class="cfba-si-icon">🌱</span><strong>GOTS Certified Organic</strong><span>Certified global organic textile standard. No harmful chemicals.</span></div>
        <div class="cfba-si"><span class="cfba-si-icon">💧</span><strong>Azo-Free Dyes</strong><span>Gentle, non-toxic dyes safe for delicate newborn skin.</span></div>
        <div class="cfba-si"><span class="cfba-si-icon">🧸</span><strong>Oeko-Tex Certified</strong><span>Every fabric tested for over 100 harmful substances.</span></div>
        <div class="cfba-si"><span class="cfba-si-icon">♻️</span><strong>Eco Packaging</strong><span>100% plastic-free, biodegradable packaging on every order.</span></div>
      </div>
    </div>
  </section>
  <footer class="cfba-footer">
    <div class="cfba-fg">
      <div class="cfba-fb"><h3>Little Cloud ☁️</h3><p>Organic baby apparel crafted with love. Gentle on delicate skin, and kind to our planet.</p></div>
      <div class="cfba-fc"><h4>Shop</h4><ul><li><a href="#">Newborn</a></li><li><a href="#">Baby</a></li><li><a href="#">Toddler</a></li><li><a href="#">Gift Sets</a></li></ul></div>
      <div class="cfba-fc"><h4>Our Story</h4><ul><li><a href="#">About Us</a></li><li><a href="#">Certifications</a></li><li><a href="#">Sustainability</a></li></ul></div>
      <div class="cfba-fc"><h4>Support</h4><ul><li><a href="#">Size Guide</a></li><li><a href="#">Returns</a></li><li><a href="#">Track Order</a></li><li><a href="#">Contact</a></li></ul></div>
    </div>
    <div class="cfba-fbot"><span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'Little Cloud' }}.</span><span>Privacy &middot; Terms</span></div>
  </footer>
</div>
{% schema %}
{
  "name": "Baby Apparel Landing",
  "settings": [
    {"type":"text","id":"brand_name","label":"Brand Name","default":"Little Cloud"},
    {"type":"text","id":"promo_text","label":"Promo Bar","default":"Free delivery on all baby orders above ₹499 · 100% Organic Cotton"},
    {"type":"text","id":"hero_badge","label":"Hero Badge","default":"100% GOTS Certified Organic Cotton"},
    {"type":"textarea","id":"hero_sub","label":"Hero Subtext","default":"Organic baby apparel crafted with love. Gentle on delicate skin, free from harmful chemicals."},
    {"type":"text","id":"cta1_text","label":"CTA 1 Text","default":"Shop Newborn"},
    {"type":"url","id":"cta1_url","label":"CTA 1 URL"},
    {"type":"text","id":"cta2_text","label":"CTA 2 Text","default":"Gift Guide"},
    {"type":"url","id":"cta2_url","label":"CTA 2 URL"},
    {"type":"collection","id":"featured_collection","label":"Featured Collection"}
  ],
  "presets": [{"name":"Baby Apparel Landing"}]
}
{% endschema %}