{% comment %} ConvertFlow — Luxury Watches Cart Page {% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Montserrat:wght@300;400;600&display=swap');
  .cf-lw-cart*{box-sizing:border-box;margin:0;padding:0}
  .cf-lw-cart{font-family:'Montserrat',sans-serif;background:#0A0A0A;color:#E5E4E2;padding:80px 5%;min-height:80vh}
  
  .cf-lw-cart-wrap{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 400px;gap:60px}
  
  .cf-lw-cart-h1{font-family:'Cinzel',serif;font-size:36px;font-weight:400;color:#fff;margin-bottom:40px;letter-spacing:2px;border-bottom:1px solid rgba(255,255,255,.1);padding-bottom:20px}
  
  .cf-lw-c-items{display:flex;flex-direction:column;gap:30px}
  .cf-lw-c-item{display:grid;grid-template-columns:120px 1fr auto;gap:30px;align-items:center;padding-bottom:30px;border-bottom:1px solid rgba(255,255,255,.05)}
  
  .cf-lw-c-img{aspect-ratio:3/4;background:#111;padding:10px;border:1px solid rgba(255,255,255,.05);display:flex;align-items:center;justify-content:center}
  .cf-lw-c-img img{max-width:100%;max-height:100%;object-fit:cover;filter:drop-shadow(0 10px 20px rgba(0,0,0,.5))}
  
  .cf-lw-c-info h3{font-family:'Cinzel',serif;font-size:18px;margin-bottom:12px;color:#fff;letter-spacing:1px}
  
  .cf-lw-c-qty{display:inline-flex;align-items:center;border:1px solid rgba(255,255,255,.2);padding:8px 16px}
  .cf-lw-c-qty button{background:none;border:none;color:#fff;cursor:pointer;font-size:16px}
  .cf-lw-c-qty span{margin:0 16px;font-size:14px;color:#E5E4E2}
  
  .cf-lw-c-remove{margin-left:24px;color:#666;text-decoration:none;font-size:11px;letter-spacing:2px;text-transform:uppercase;transition:color .3s}
  .cf-lw-c-remove:hover{color:{{ section.settings.color_accent | default: '#D4AF37' }}}
  
  .cf-lw-c-price{font-size:18px;font-weight:300;color:#E5E4E2}
  
  .cf-lw-c-sum{background:#111;padding:40px;border:1px solid rgba(255,255,255,.05)}
  .cf-lw-c-sum h2{font-family:'Cinzel',serif;font-size:20px;color:#fff;margin-bottom:30px;letter-spacing:2px}
  .cf-lw-c-row{display:flex;justify-content:space-between;font-size:13px;margin-bottom:20px;color:#888}
  .cf-lw-c-total{display:flex;justify-content:space-between;font-size:18px;color:#fff;margin-top:30px;padding-top:30px;border-top:1px solid rgba(255,255,255,.1)}
  .cf-lw-c-total span:last-child{color:{{ section.settings.color_accent | default: '#D4AF37' }}}
  
  .cf-lw-c-btn{display:block;width:100%;text-align:center;margin-top:40px;background:rgba(255,255,255,.05);color:#fff;border:1px solid rgba(255,255,255,.2);padding:20px;font-family:'Cinzel',serif;font-size:12px;letter-spacing:4px;text-transform:uppercase;text-decoration:none;transition:all .5s;backdrop-filter:blur(4px)}
  .cf-lw-c-btn:hover{background:{{ section.settings.color_accent | default: '#D4AF37' }};border-color:{{ section.settings.color_accent | default: '#D4AF37' }};color:#0A0A0A}

  .cf-lw-empty{grid-column:1/-1;text-align:center;padding:100px 20px}
  .cf-lw-empty h2{font-family:'Cinzel',serif;font-size:32px;color:#fff;margin-bottom:24px;letter-spacing:2px}

  @media(max-width:900px){
    .cf-lw-cart-wrap{grid-template-columns:1fr}
    .cf-lw-c-item{grid-template-columns:80px 1fr;position:relative}
    .cf-lw-c-price{position:absolute;top:0;right:0}
  }
{% endstyle %}

<div class="cf-lw-cart">
  <div class="cf-lw-cart-wrap">
    {% if cart.item_count == 0 %}
      <div class="cf-lw-empty">
        <h2>Your Selection is Empty</h2>
        <p style="color:#888;font-size:14px;margin-bottom:40px;line-height:1.8">You have not yet selected a timepiece for your collection.</p>
        <a href="/collections/all" class="cf-lw-c-btn" style="display:inline-block;width:auto;padding:16px 48px">View Collections</a>
      </div>
    {% else %}
      <div>
        <h1 class="cf-lw-cart-h1">Your Selection</h1>
        <div class="cf-lw-c-items">
          {% for item in cart.items %}
            <div class="cf-lw-c-item">
              <div class="cf-lw-c-img">
                {% if item.image %}<img src="{{ item.image | img_url: '200x' }}" alt="{{ item.title }}">{% endif %}
              </div>
              <div class="cf-lw-c-info">
                <h3>{{ item.product.title }}</h3>
                <div style="display:flex;align-items:center;margin-top:20px">
                  <div class="cf-lw-c-qty">
                    <button>-</button><span>{{ item.quantity }}</span><button>+</button>
                  </div>
                  <a href="{{ item.url_to_remove }}" class="cf-lw-c-remove">Remove</a>
                </div>
              </div>
              <div class="cf-lw-c-price">{{ item.final_line_price | money }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
      
      <div class="cf-lw-c-sum">
        <h2>Acquisition Summary</h2>
        <div class="cf-lw-c-row"><span>Subtotal</span> <span>{{ cart.total_price | money }}</span></div>
        <div class="cf-lw-c-row"><span>Complimentary Shipping</span> <span style="color:#D4AF37">Included</span></div>
        <div class="cf-lw-c-total"><span>Total</span> <span>{{ cart.total_price | money }}</span></div>
        <a href="/checkout" class="cf-lw-c-btn">Proceed Securely</a>
        <div style="text-align:center;margin-top:24px;font-size:10px;letter-spacing:2px;color:#666;text-transform:uppercase">
          Encrypted Secure Checkout
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "CF Luxury Watches Cart",
  "settings": [
    { "type": "color", "id": "color_accent", "label": "Gold Accent", "default": "#D4AF37" }
  ],
  "presets": [{ "name": "CF Luxury Watches Cart" }]
}
{% endschema %}