{% comment %}
  ConvertFlow — Pet Supplies Cart Page
  Friendly cart layout with rounded elements and treats upsell.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Quicksand:wght@500;600;700&display=swap');

  :root {
    --pet-primary: {{ section.settings.color_primary | default: '#FF6B35' }};
    --pet-secondary: {{ section.settings.color_secondary | default: '#FFD166' }};
    --pet-bg: {{ section.settings.color_bg | default: '#FFF8F0' }};
    --pet-surface: {{ section.settings.color_surface | default: '#FFFFFF' }};
    --pet-text: {{ section.settings.color_text | default: '#2B2D42' }};
    --pet-font-heading: 'Quicksand', sans-serif;
    --pet-font-body: 'Nunito', sans-serif;
  }

  .cf-pet-cart * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-pet-cart { font-family: var(--pet-font-body); background: var(--pet-bg); color: var(--pet-text); min-height: 80vh; padding: 60px 5%; }
  
  .cf-pet-cart-wrap { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 380px; gap: 40px; }
  
  .cf-pet-cart-h1 { font-family: var(--pet-font-heading); font-size: 40px; font-weight: 700; margin-bottom: 30px; display: flex; align-items: center; gap: 12px; }
  .cf-pet-cart-h1 svg { color: var(--pet-primary); width: 32px; height: 32px; }
  
  /* Items List */
  .cf-pet-c-items { background: var(--pet-surface); border-radius: 30px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); }
  .cf-pet-c-item { display: grid; grid-template-columns: 100px 1fr auto; gap: 24px; padding: 24px 0; border-bottom: 2px dashed #eee; align-items: center; }
  .cf-pet-c-item:last-child { border-bottom: none; padding-bottom: 0; }
  .cf-pet-c-item:first-child { padding-top: 0; }
  
  .cf-pet-c-img { aspect-ratio: 1; background: #fff0eb; border-radius: 16px; padding: 10px; display: flex; align-items: center; justify-content: center; }
  .cf-pet-c-img img { max-width: 100%; max-height: 100%; object-fit: contain; }
  
  .cf-pet-c-info h3 { font-family: var(--pet-font-heading); font-size: 18px; font-weight: 700; margin-bottom: 6px; }
  .cf-pet-c-var { font-size: 14px; color: #666; margin-bottom: 12px; font-weight: 600; }
  
  .cf-pet-c-actions { display: flex; align-items: center; gap: 20px; }
  .cf-pet-c-qty { display: inline-flex; border: 2px solid #eee; border-radius: 50px; align-items: center; padding: 0 12px; }
  .cf-pet-c-qty button { background: none; border: none; font-size: 18px; font-weight: 700; color: var(--pet-primary); cursor: pointer; width: 24px; height: 32px; }
  .cf-pet-c-qty span { font-size: 15px; font-weight: 700; margin: 0 10px; }
  
  .cf-pet-c-remove { width: 32px; height: 32px; background: #ffece6; color: #ff3366; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none; transition: background 0.2s; }
  .cf-pet-c-remove:hover { background: #ff3366; color: #fff; }
  
  .cf-pet-c-price { font-family: var(--pet-font-heading); font-size: 20px; font-weight: 800; color: var(--pet-primary); }
  
  /* Upsell */
  .cf-pet-c-upsell { background: var(--pet-secondary); border-radius: 20px; padding: 20px; margin-top: 30px; display: flex; align-items: center; gap: 20px; }
  .cf-pet-c-upsell-img { width: 60px; height: 60px; background: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .cf-pet-c-upsell-info h4 { font-family: var(--pet-font-heading); font-size: 16px; margin-bottom: 4px; }
  .cf-pet-c-upsell-info p { font-size: 13px; font-weight: 600; color: #555; }
  .cf-pet-c-upsell-btn { margin-left: auto; background: #fff; color: var(--pet-text); border: none; border-radius: 50px; padding: 8px 16px; font-family: var(--pet-font-heading); font-weight: 700; cursor: pointer; font-size: 13px; }
  
  /* Summary */
  .cf-pet-c-sum { background: var(--pet-surface); border-radius: 30px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); position: sticky; top: 40px; }
  .cf-pet-c-sum h2 { font-family: var(--pet-font-heading); font-size: 24px; margin-bottom: 24px; border-bottom: 2px dashed #eee; padding-bottom: 16px; }
  .cf-pet-c-row { display: flex; justify-content: space-between; font-size: 15px; font-weight: 600; margin-bottom: 16px; color: #555; }
  .cf-pet-c-total { display: flex; justify-content: space-between; font-size: 20px; font-weight: 800; color: var(--pet-text); margin-top: 24px; padding-top: 24px; border-top: 2px dashed #eee; font-family: var(--pet-font-heading); }
  .cf-pet-c-total span:last-child { color: var(--pet-primary); font-size: 28px; }
  
  .cf-pet-btn-checkout {
    display: block; width: 100%; text-align: center; margin-top: 30px;
    background: var(--pet-primary); color: #fff; border: none; border-radius: 50px;
    padding: 18px; font-family: var(--pet-font-heading); font-size: 18px; font-weight: 700;
    text-decoration: none; cursor: pointer;
    box-shadow: 0 8px 20px rgba(255, 107, 53, 0.3);
    transition: all 0.3s;
  }
  .cf-pet-btn-checkout:hover { transform: translateY(-3px); box-shadow: 0 12px 24px rgba(255, 107, 53, 0.4); }

  .cf-pet-c-empty { grid-column: 1 / -1; text-align: center; padding: 80px 20px; background: var(--pet-surface); border-radius: 30px; }
  .cf-pet-c-empty h2 { font-size: 28px; margin-bottom: 16px; color: var(--pet-primary); }

  @media(max-width: 900px) {
    .cf-pet-cart-wrap { grid-template-columns: 1fr; }
    .cf-pet-c-item { grid-template-columns: 80px 1fr; position: relative; }
    .cf-pet-c-price { position: absolute; top: 24px; right: 0; }
    .cf-pet-c-upsell { flex-direction: column; text-align: center; }
    .cf-pet-c-upsell-btn { margin-left: 0; margin-top: 10px; width: 100%; }
  }
{% endstyle %}

<div class="cf-pet-cart">
  <div class="cf-pet-cart-wrap">
    {% if cart.item_count == 0 %}
      <div class="cf-pet-c-empty">
        <h2>Your bowl is empty!</h2>
        <p style="color:#666; font-weight:600; margin-bottom: 30px;">Looks like you haven't added any treats or toys yet.</p>
        <a href="/collections/all" class="cf-pet-btn-checkout" style="display:inline-block; width:auto; padding: 14px 40px;">Fetch Some Goodies</a>
      </div>
    {% else %}
      <div>
        <h1 class="cf-pet-cart-h1">
          Your Cart
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.5c-4 0-7-2.5-7-6s3-4 7-4 7 .5 7 4-3 6-7 6zm-5-10c-1.5 0-3-1.5-3-3.5s1.5-3.5 3-3.5 3 1.5 3 3.5-1.5 3.5-3 3.5zm10 0c-1.5 0-3-1.5-3-3.5s1.5-3.5 3-3.5 3 1.5 3 3.5-1.5 3.5-3 3.5zm-5-2c-1.5 0-2.5-1-2.5-2.5s1-2.5 2.5-2.5 2.5 1 2.5 2.5-1 2.5-2.5 2.5z"/></svg>
        </h1>
        
        <div class="cf-pet-c-items">
          {% for item in cart.items %}
            <div class="cf-pet-c-item">
              <div class="cf-pet-c-img">
                {% if item.image %}
                  <img src="{{ item.image | img_url: '200x' }}" alt="{{ item.title }}">
                {% endif %}
              </div>
              <div class="cf-pet-c-info">
                <h3>{{ item.product.title }}</h3>
                {% unless item.variant.title contains 'Default' %}
                  <div class="cf-pet-c-var">Size/Flavor: {{ item.variant.title }}</div>
                {% endunless %}
                <div class="cf-pet-c-actions">
                  <div class="cf-pet-c-qty">
                    <button>-</button><span>{{ item.quantity }}</span><button>+</button>
                  </div>
                  <a href="{{ item.url_to_remove }}" class="cf-pet-c-remove">✕</a>
                </div>
              </div>
              <div class="cf-pet-c-price">{{ item.final_line_price | money }}</div>
            </div>
          {% endfor %}
        </div>
        
        <div class="cf-pet-c-upsell">
          <div class="cf-pet-c-upsell-img">🍖</div>
          <div class="cf-pet-c-upsell-info">
            <h4>Add Daily Dental Chews</h4>
            <p>Keep their breath fresh! Only $9.99</p>
          </div>
          <button class="cf-pet-c-upsell-btn">+ Add to Cart</button>
        </div>
      </div>
      
      <div class="cf-pet-c-sum">
        <h2>Order Summary</h2>
        <div class="cf-pet-c-row"><span>Subtotal</span> <span>{{ cart.total_price | money }}</span></div>
        <div class="cf-pet-c-row"><span>Shipping</span> <span style="color:#00C853;">Free</span></div>
        <div class="cf-pet-c-total"><span>Total</span> <span>{{ cart.total_price | money }}</span></div>
        <a href="/checkout" class="cf-pet-btn-checkout">Go to Checkout</a>
        <p style="text-align:center; font-size:13px; font-weight:600; color:#888; margin-top:20px;">
          🔒 Secure checkout by Stripe
        </p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "CF Pet Supplies Cart",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Primary Accent", "default": "#FF6B35" },
    { "type": "color", "id": "color_secondary", "label": "Secondary Accent", "default": "#FFD166" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#FFF8F0" },
    { "type": "color", "id": "color_surface", "label": "Surface", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#2B2D42" }
  ],
  "presets": [
    { "name": "CF Pet Supplies Cart" }
  ]
}
{% endschema %}