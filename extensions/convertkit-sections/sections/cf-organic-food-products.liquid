<style>
.cf-org-prod-wrap {
  background: var(--bg, #FFFFFF);
  color: var(--text, #2C3E35);
  font-family: 'Public Sans', sans-serif;
  -webkit-font-smoothing: antialiased;
}
.cf-org-prod-wrap .serif { font-family: 'Playfair Display', serif; }

.section { padding: 60px; max-width: 1400px; margin: 0 auto; }
.sec-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 40px; }
.sec-header h2 { font-size: 32px; color: var(--primary, #4A7C59); }
.sec-header a { color: var(--secondary, #F4A261); font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 4px; }

.grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; }
.card { background: #fff; border: 1px solid var(--border, #E2E8E4); border-radius: 30px; padding: 24px; position: relative; transition: all 0.3s; display: flex; flex-direction: column; text-decoration: none; color: inherit; }
.card:hover { border-color: var(--primary-light, #E9F2EC); box-shadow: 0 15px 40px rgba(0,0,0,0.04); transform: translateY(-4px); }

.card-tags { position: absolute; top: 20px; left: 20px; display: flex; flex-direction: column; gap: 8px; z-index: 2; }
.tag-org { background: #E8F5E9; color: #2E7D32; font-size: 10px; font-weight: 700; padding: 4px 10px; border-radius: 12px; text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; gap: 4px; }
.tag-org svg { width: 12px; height: 12px; }
.tag-sale { background: #FFF3E0; color: #E65100; font-size: 10px; font-weight: 700; padding: 4px 10px; border-radius: 12px; text-transform: uppercase; letter-spacing: 1px; }

.c-img { aspect-ratio: 1; margin-bottom: 20px; border-radius: 50%; background: var(--surface, #F9FDF9); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
.c-img img { width: 100%; height: 100%; object-fit: cover; }
.c-img svg { width: 50%; color: var(--primary, #4A7C59); opacity: 0.6; }
.fav-btn { position: absolute; top: 20px; right: 20px; background: #fff; border: 1px solid var(--border, #E2E8E4); width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--text-muted, #6B7D73); cursor: pointer; transition: all 0.2s; z-index: 5; }
.fav-btn:hover { color: #E53E3E; border-color: #E53E3E; }

.c-price { font-size: 20px; font-weight: 700; color: var(--primary, #4A7C59); margin-bottom: 4px; display: flex; align-items: baseline; gap: 8px; }
.c-price-old { font-size: 14px; text-decoration: line-through; color: var(--text-muted, #6B7D73); font-weight: 400; }
.c-name { font-size: 16px; font-weight: 600; margin-bottom: 4px; flex-grow: 1; }
.c-unit { font-size: 13px; color: var(--text-muted, #6B7D73); margin-bottom: 20px; }

.add-btn { background: var(--primary, #4A7C59); color: #fff; border: none; padding: 12px 20px; border-radius: 20px; font-weight: 600; cursor: pointer; font-family: inherit; transition: background 0.2s; display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; margin-top: auto; }
.add-btn:hover { opacity: 0.9; }

@media(max-width: 1200px) { .grid { grid-template-columns: repeat(3, 1fr); } }
@media(max-width: 1024px) { .grid { grid-template-columns: repeat(2, 1fr); } }
@media(max-width: 768px) { .section { padding: 40px 20px; } .grid { grid-template-columns: 1fr; } }
</style>

<div class="cf-org-prod-wrap">
  <section class="section">
    <div class="sec-header">
      <h2 class="serif">{{ section.settings.heading | default: 'Bestsellers This Week' }}</h2>
      {% if section.settings.collection != blank %}
      <a href="{{ section.settings.collection.url }}">See All Products &rarr;</a>
      {% endif %}
    </div>
    
    <div class="grid">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.products_count %}
        <a href="{{ product.url }}" class="card">
          <div class="card-tags">
            <span class="tag-org"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg> {{ section.settings.badge_text | default: 'Organic' }}</span>
            {% if product.compare_at_price > product.price %}
              <span class="tag-sale">Sale</span>
            {% endif %}
          </div>
          <button class="fav-btn" aria-label="Favorite" onclick="event.preventDefault(); this.style.color='#E53E3E'; this.style.borderColor='#E53E3E';"><svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg></button>
          
          <div class="c-img">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" loading="lazy">
            {% else %}
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            {% endif %}
          </div>
          
          <div class="c-price">
            {{ product.price | money }}
            {% if product.compare_at_price > product.price %}
              <span class="c-price-old">{{ product.compare_at_price | money }}</span>
            {% endif %}
          </div>
          <div class="c-name">{{ product.title | truncate: 55 }}</div>
          <div class="c-unit">{{ product.vendor }}</div>
          
          <button class="add-btn" onclick="event.preventDefault();">Add to Cart <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg></button>
        </a>
        {% endfor %}
      {% else %}
        <!-- Placeholders -->
        {% for i in (1..4) %}
        <div class="card">
          <div class="card-tags">
            <span class="tag-org"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg> Organic</span>
          </div>
          <div class="c-img">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div class="c-price">$4.99</div>
          <div class="c-name">Example Farm Product</div>
          <div class="c-unit">Local Farm</div>
          <button class="add-btn">Add to Cart</button>
        </div>
        {% endfor %}
      {% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Organic Food Products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section Heading", "default": "Bestsellers This Week" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_count", "label": "Number of Products", "min": 4, "max": 12, "step": 4, "default": 4 },
    { "type": "text", "id": "badge_text", "label": "Green Badge Text", "default": "Organic" }
  ],
  "presets": [{ "name": "Organic Food Products" }]
}
{% endschema %}
