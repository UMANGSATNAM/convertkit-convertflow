{% comment %}ConvertFlow — Pilgrim Beauty | Premium Collection Page{% endcomment %}
{% paginate collection.products by section.settings.products_per_page %}

{% style %}
.pfc *{box-sizing:border-box;margin:0;padding:0}
.pfc{font-family:'DM Sans','Segoe UI',sans-serif;color:#1a1a1a;background:#fff;-webkit-font-smoothing:antialiased}

/* Collection Hero */
.pfc-hero{background:linear-gradient(135deg,#FFF5EE 0%,#FAEBD7 100%);padding:60px 40px;text-align:center;border-bottom:1px solid #f0ebe5}
.pfc-hero-overline{font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#C17F5E;margin-bottom:12px;display:block}
.pfc-hero h1{font-size:42px;font-weight:800;color:#1a1a1a;margin-bottom:12px;letter-spacing:-0.5px}
.pfc-hero p{font-size:16px;color:#777;max-width:520px;margin:0 auto 20px;line-height:1.7}
.pfc-hero-count{font-size:13px;color:#999;font-weight:500}

/* Breadcrumb */
.pfc-breadcrumb{padding:14px 40px;font-size:13px;color:#999;border-bottom:1px solid #f0ebe5;background:#fff}
.pfc-breadcrumb a{color:#999;text-decoration:none;transition:color .2s}
.pfc-breadcrumb a:hover{color:#C17F5E}
.pfc-breadcrumb span{margin:0 8px}

/* Main Layout */
.pfc-main{max-width:1400px;margin:0 auto;padding:40px;display:grid;grid-template-columns:260px 1fr;gap:40px;align-items:start}

/* Sidebar Filters */
.pfc-sidebar{position:sticky;top:20px}
.pfc-filter-title{font-size:16px;font-weight:800;margin-bottom:24px;padding-bottom:16px;border-bottom:2px solid #1a1a1a;display:flex;justify-content:space-between;align-items:center}
.pfc-filter-clear{font-size:12px;font-weight:600;color:#C17F5E;cursor:pointer;background:none;border:none;padding:0}
.pfc-filter-group{margin-bottom:28px;padding-bottom:28px;border-bottom:1px solid #f0ebe5}
.pfc-filter-group:last-child{border-bottom:none}
.pfc-filter-group-title{font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#555;margin-bottom:16px;display:flex;justify-content:space-between;align-items:center;cursor:pointer}
.pfc-filter-opts{display:flex;flex-direction:column;gap:10px}
.pfc-filter-opt{display:flex;align-items:center;gap:10px;cursor:pointer;font-size:14px;color:#333;transition:color .2s}
.pfc-filter-opt:hover{color:#C17F5E}
.pfc-filter-opt input{accent-color:#C17F5E;width:16px;height:16px;cursor:pointer}
.pfc-filter-price{display:flex;gap:10px;margin-top:4px}
.pfc-filter-price input{flex:1;padding:10px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;outline:none;transition:border-color .2s}
.pfc-filter-price input:focus{border-color:#C17F5E}

/* Toolbar */
.pfc-toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px;padding-bottom:20px;border-bottom:1px solid #f0ebe5}
.pfc-toolbar-left{font-size:14px;color:#888}
.pfc-toolbar-left strong{color:#1a1a1a}
.pfc-sort-wrap{display:flex;align-items:center;gap:10px;font-size:13px;color:#555;font-weight:600}
.pfc-sort{padding:10px 16px;border:1.5px solid #e5e7eb;border-radius:10px;font-size:13px;font-family:'DM Sans','Segoe UI',sans-serif;outline:none;cursor:pointer;background:#fff;color:#1a1a1a;transition:border-color .2s}
.pfc-sort:focus{border-color:#C17F5E}
.pfc-view-btns{display:flex;gap:6px}
.pfc-view-btn{width:36px;height:36px;border:1.5px solid #e5e7eb;border-radius:8px;background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#888;transition:all .2s}
.pfc-view-btn.active{border-color:#C17F5E;color:#C17F5E;background:#fff9f6}

/* Product Grid */
.pfc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.pfc-grid.list-view{grid-template-columns:1fr}

/* Product Card */
.pfc-card{background:#fff;border-radius:16px;overflow:hidden;border:1px solid #f0ebe5;transition:all .3s ease;text-decoration:none;color:#1a1a1a;display:block}
.pfc-card:hover{transform:translateY(-4px);box-shadow:0 12px 40px rgba(0,0,0,.08)}
.pfc-card-img{position:relative;aspect-ratio:1;overflow:hidden;background:#faf7f2}
.pfc-card-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease}
.pfc-card:hover .pfc-card-img img{transform:scale(1.05)}
.pfc-card-badge{position:absolute;top:12px;left:12px;padding:4px 12px;border-radius:20px;font-size:10px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:#fff}
.pfc-card-badge.bestseller{background:#E67E22}
.pfc-card-badge.sale{background:#E74C3C}
.pfc-card-badge.new{background:#27ae60}
.pfc-card-wishlist{position:absolute;top:12px;right:12px;width:34px;height:34px;background:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;border:none;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.1);color:#999;transition:all .2s}
.pfc-card-wishlist:hover{color:#E74C3C}
.pfc-card-quick{position:absolute;bottom:0;left:0;right:0;background:#1a1a1a;color:#fff;padding:12px;text-align:center;font-size:12px;font-weight:700;letter-spacing:.5px;transform:translateY(100%);transition:transform .3s ease;border:none;cursor:pointer;width:100%}
.pfc-card:hover .pfc-card-quick{transform:translateY(0)}
.pfc-card-body{padding:18px}
.pfc-card-name{font-size:14px;font-weight:600;line-height:1.4;margin-bottom:6px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.pfc-card-rating{display:flex;align-items:center;gap:4px;margin-bottom:10px;font-size:12px;color:#999}
.pfc-card-stars{color:#F5A623;font-size:13px}
.pfc-card-price{display:flex;align-items:center;gap:8px}
.pfc-card-price .cur{font-size:18px;font-weight:800;color:#1a1a1a}
.pfc-card-price .orig{font-size:13px;color:#aaa;text-decoration:line-through}
.pfc-card-price .save{font-size:11px;font-weight:700;color:#27ae60;background:#f0faf4;padding:2px 8px;border-radius:20px}
.pfc-card-atc{display:block;width:100%;margin-top:14px;padding:11px;background:#1a1a1a;color:#fff;border:none;border-radius:10px;font-size:12px;font-weight:700;cursor:pointer;transition:all .2s;letter-spacing:.5px;text-align:center}
.pfc-card-atc:hover{background:#C17F5E}

/* List View Card */
.list-view .pfc-card{display:grid;grid-template-columns:200px 1fr;border-radius:14px}
.list-view .pfc-card-img{aspect-ratio:1;border-radius:14px 0 0 14px}
.list-view .pfc-card-body{padding:24px}

/* Empty State */
.pfc-empty{text-align:center;padding:80px 40px;grid-column:1/-1}
.pfc-empty svg{color:#e0d5cc;margin-bottom:20px}
.pfc-empty h3{font-size:22px;font-weight:700;margin-bottom:8px}
.pfc-empty p{font-size:14px;color:#888;margin-bottom:24px}
.pfc-empty a{display:inline-flex;align-items:center;gap:8px;padding:14px 32px;background:#1a1a1a;color:#fff;border-radius:12px;text-decoration:none;font-weight:700;font-size:14px;transition:background .2s}
.pfc-empty a:hover{background:#C17F5E}

/* Pagination */
.pfc-pagination{display:flex;justify-content:center;align-items:center;gap:8px;padding:48px 0 20px;grid-column:1/-1}
.pfc-page-btn{width:40px;height:40px;border-radius:10px;border:1.5px solid #e5e7eb;background:#fff;font-size:14px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;text-decoration:none;color:#1a1a1a;transition:all .2s}
.pfc-page-btn:hover,.pfc-page-btn.active{border-color:#C17F5E;color:#C17F5E;background:#fff9f6}
.pfc-page-btn.prev-next{width:auto;padding:0 16px;gap:6px}

/* Active Filters */
.pfc-active-filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px}
.pfc-active-tag{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;background:#fff0e8;border:1px solid #f0c9ad;border-radius:20px;font-size:12px;font-weight:600;color:#C17F5E}
.pfc-active-tag button{background:none;border:none;cursor:pointer;color:#C17F5E;font-size:14px;line-height:1;padding:0}

/* Mobile */
.pfc-mobile-filter-btn{display:none;width:100%;padding:14px;background:#1a1a1a;color:#fff;border:none;border-radius:12px;font-size:14px;font-weight:700;cursor:pointer;align-items:center;justify-content:center;gap:8px;margin-bottom:20px}
.pfc-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200}
.pfc-sidebar-drawer{position:fixed;left:0;top:0;bottom:0;width:300px;background:#fff;z-index:201;padding:24px;overflow-y:auto;transform:translateX(-100%);transition:transform .3s ease}
.pfc-sidebar-drawer.open{transform:translateX(0)}
.pfc-drawer-close{position:absolute;top:16px;right:16px;background:none;border:none;font-size:24px;cursor:pointer;color:#555}

@media(max-width:1024px){.pfc-main{grid-template-columns:1fr;padding:20px}.pfc-sidebar{display:none}.pfc-mobile-filter-btn{display:flex}.pfc-grid{grid-template-columns:repeat(2,1fr);gap:16px}}
@media(max-width:600px){.pfc-hero{padding:40px 20px}.pfc-hero h1{font-size:28px}.pfc-grid{grid-template-columns:repeat(2,1fr);gap:12px}.pfc-breadcrumb{padding:12px 20px}}
{% endstyle %}

<div class="pfc">

  {%- if section.settings.show_hero -%}
  <div class="pfc-hero">
    <span class="pfc-hero-overline">{{ section.settings.hero_overline | default: 'Our Collection' }}</span>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p>{{ collection.description }}</p>
    {%- endif -%}
    <span class="pfc-hero-count">{{ collection.products_count }} Products</span>
  </div>
  {%- endif -%}

  <div class="pfc-breadcrumb">
    <a href="/">Home</a><span>›</span>
    <a href="/collections">Collections</a><span>›</span>
    <span style="color:#1a1a1a;font-weight:600">{{ collection.title }}</span>
  </div>

  <div class="pfc-main">

    <!-- Sidebar -->
    <aside class="pfc-sidebar" id="pfc-sidebar">
      <div class="pfc-filter-title">
        Filters
        <button class="pfc-filter-clear" onclick="pfcClearFilters()">Clear All</button>
      </div>

      {%- if section.settings.show_filter_availability -%}
      <div class="pfc-filter-group">
        <div class="pfc-filter-group-title">Availability</div>
        <div class="pfc-filter-opts">
          <label class="pfc-filter-opt"><input type="checkbox" onchange="pfcFilter()"> In Stock</label>
        </div>
      </div>
      {%- endif -%}

      {%- if section.settings.show_filter_price -%}
      <div class="pfc-filter-group">
        <div class="pfc-filter-group-title">Price Range</div>
        <div class="pfc-filter-price">
          <input type="number" placeholder="Min" id="pfc-min-price">
          <input type="number" placeholder="Max" id="pfc-max-price">
        </div>
      </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'filter_group' -%}
        <div class="pfc-filter-group">
          <div class="pfc-filter-group-title">{{ block.settings.title }}</div>
          <div class="pfc-filter-opts">
            {%- assign opts = block.settings.options | split: ',' -%}
            {%- for opt in opts -%}
              <label class="pfc-filter-opt">
                <input type="checkbox" value="{{ opt | strip }}" onchange="pfcFilter()">
                {{ opt | strip }}
              </label>
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </aside>

    <!-- Content -->
    <div>
      <button class="pfc-mobile-filter-btn" onclick="pfcOpenDrawer()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="20" y2="12"/><line x1="12" y1="18" x2="20" y2="18"/></svg>
        Filters & Sort
      </button>

      <!-- Toolbar -->
      <div class="pfc-toolbar">
        <div class="pfc-toolbar-left">
          Showing <strong>{{ collection.products_count }}</strong> products
        </div>
        <div style="display:flex;align-items:center;gap:16px">
          <div class="pfc-sort-wrap">
            Sort by
            <select class="pfc-sort" id="pfc-sort" onchange="pfcSort(this.value)">
              <option value="manual">Featured</option>
              <option value="best-selling">Best Selling</option>
              <option value="price-ascending">Price: Low to High</option>
              <option value="price-descending">Price: High to Low</option>
              <option value="created-descending">Newest</option>
              <option value="title-ascending">A–Z</option>
            </select>
          </div>
          <div class="pfc-view-btns">
            <button class="pfc-view-btn active" id="pfc-grid-btn" onclick="pfcView('grid')" title="Grid view">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            </button>
            <button class="pfc-view-btn" id="pfc-list-btn" onclick="pfcView('list')" title="List view">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Product Grid -->
      {%- if collection.products.size > 0 -%}
      <div class="pfc-grid" id="pfc-grid">
        {%- for product in collection.products -%}
          {%- assign save_pct = 0 -%}
          {%- if product.compare_at_price > product.price -%}
            {%- assign save_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
          {%- endif -%}
          <a href="{{ product.url }}" class="pfc-card">
            <div class="pfc-card-img">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title }}" loading="lazy">
              {%- else -%}
                <div style="width:100%;height:100%;background:#faf7f2;display:flex;align-items:center;justify-content:center;font-size:48px">🧴</div>
              {%- endif -%}
              {%- if product.tags contains 'bestseller' -%}
                <span class="pfc-card-badge bestseller">Bestseller</span>
              {%- elsif save_pct > 0 -%}
                <span class="pfc-card-badge sale">{{ save_pct }}% OFF</span>
              {%- elsif product.tags contains 'new' -%}
                <span class="pfc-card-badge new">New</span>
              {%- endif -%}
              <button class="pfc-card-wishlist" onclick="event.preventDefault()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              </button>
              <button class="pfc-card-quick" onclick="pfcQuickAdd(event, {{ product.variants.first.id }})">QUICK ADD</button>
            </div>
            <div class="pfc-card-body">
              <div class="pfc-card-name">{{ product.title }}</div>
              <div class="pfc-card-rating">
                <span class="pfc-card-stars">★★★★★</span>
                <span>{{ section.settings.default_review_count | default: '(2.4k)' }}</span>
              </div>
              <div class="pfc-card-price">
                <span class="cur">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="orig">{{ product.compare_at_price | money }}</span>
                  <span class="save">Save {{ save_pct }}%</span>
                {%- endif -%}
              </div>
              {%- unless product.available -%}
                <div style="font-size:12px;color:#E74C3C;font-weight:600;margin-top:8px">Out of Stock</div>
              {%- endunless -%}
            </div>
          </a>
        {%- endfor -%}
      </div>

      <!-- Pagination -->
      {%- if paginate.pages > 1 -%}
      <div class="pfc-pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="pfc-page-btn prev-next">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            Prev
          </a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="pfc-page-btn">{{ part.title }}</a>
          {%- else -%}
            {%- if part.title == paginate.current_page -%}
              <span class="pfc-page-btn active">{{ part.title }}</span>
            {%- else -%}
              <span class="pfc-page-btn" style="border:none;cursor:default">{{ part.title }}</span>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="pfc-page-btn prev-next">
            Next
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        {%- endif -%}
      </div>
      {%- endif -%}

      {%- else -%}
      <div class="pfc-empty">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <h3>No products found</h3>
        <p>Try adjusting your filters or browse our full collection.</p>
        <a href="/collections/all">View All Products</a>
      </div>
      {%- endif -%}
    </div>
  </div>

</div>

<!-- Mobile Drawer -->
<div class="pfc-overlay" id="pfc-overlay" onclick="pfcCloseDrawer()"></div>
<div class="pfc-sidebar-drawer" id="pfc-drawer">
  <button class="pfc-drawer-close" onclick="pfcCloseDrawer()">×</button>
  <div style="margin-top:24px" id="pfc-drawer-content"></div>
</div>

<script>
function pfcSort(val){
  var url=new URL(window.location.href);
  url.searchParams.set('sort_by',val);
  window.location.href=url.toString();
}
function pfcView(v){
  var grid=document.getElementById('pfc-grid');
  var gb=document.getElementById('pfc-grid-btn');
  var lb=document.getElementById('pfc-list-btn');
  if(v==='list'){grid.classList.add('list-view');lb.classList.add('active');gb.classList.remove('active')}
  else{grid.classList.remove('list-view');gb.classList.add('active');lb.classList.remove('active')}
}
function pfcClearFilters(){
  document.querySelectorAll('.pfc-filter-opt input').forEach(function(i){i.checked=false});
  var mn=document.getElementById('pfc-min-price');
  var mx=document.getElementById('pfc-max-price');
  if(mn)mn.value='';
  if(mx)mx.value='';
}
function pfcFilter(){console.log('Filter applied')}
function pfcQuickAdd(e,id){
  e.preventDefault();e.stopPropagation();
  fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id,quantity:1})})
    .then(function(){window.location.href='/cart'});
}
function pfcOpenDrawer(){
  var sb=document.getElementById('pfc-sidebar');
  var dr=document.getElementById('pfc-drawer');
  var ov=document.getElementById('pfc-overlay');
  var dc=document.getElementById('pfc-drawer-content');
  dc.innerHTML=sb.innerHTML;
  dr.classList.add('open');
  ov.style.display='block';
}
function pfcCloseDrawer(){
  document.getElementById('pfc-drawer').classList.remove('open');
  document.getElementById('pfc-overlay').style.display='none';
}
// Restore sort from URL
(function(){
  var url=new URL(window.location.href);
  var s=url.searchParams.get('sort_by');
  if(s){var el=document.getElementById('pfc-sort');if(el)el.value=s;}
})();
</script>

{% endpaginate %}

</div>

{% schema %}
{
  "name": "CF Pilgrim Collection",
  "settings": [
    {"type":"header","content":"🖼️ Collection Hero"},
    {"type":"checkbox","id":"show_hero","label":"Show Collection Hero","default":true},
    {"type":"text","id":"hero_overline","label":"Hero Overline Text","default":"Our Collection"},
    {"type":"header","content":"📦 Products"},
    {"type":"range","id":"products_per_page","min":12,"max":48,"step":4,"label":"Products Per Page","default":24},
    {"type":"text","id":"default_review_count","label":"Default Review Count","default":"(2.4k)"},
    {"type":"header","content":"🔍 Filters"},
    {"type":"checkbox","id":"show_filter_availability","label":"Show Availability Filter","default":true},
    {"type":"checkbox","id":"show_filter_price","label":"Show Price Range Filter","default":true},
    {"type":"header","content":"🎨 Colors"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#C17F5E"},
    {"type":"color","id":"bg_color","label":"Hero Background","default":"#FFF5EE"}
  ],
  "blocks": [
    {
      "type":"filter_group",
      "name":"Filter Group",
      "settings": [
        {"type":"text","id":"title","label":"Filter Group Title","default":"Skin Type"},
        {"type":"textarea","id":"options","label":"Options (comma separated)","default":"Oily, Dry, Combination, Normal, Sensitive"}
      ]
    },
    {
      "type":"product",
      "name":"Featured Product",
      "settings": [
        {"type":"product","id":"product","label":"Product"}
      ]
    }
  ],
  "presets": [
    {"name":"CF Pilgrim Collection","blocks":[
      {"type":"filter_group","settings":{"title":"Skin Type","options":"Oily, Dry, Combination, Normal, Sensitive"}},
      {"type":"filter_group","settings":{"title":"Concern","options":"Acne, Dark Spots, Anti-Aging, Hydration, Brightening"}},
      {"type":"filter_group","settings":{"title":"Product Type","options":"Serum, Moisturiser, Cleanser, Toner, Sunscreen, Mask"}}
    ]}
  ]
}
{% endschema %}
