{% comment %}
  ConvertFlow — Activewear Product Page
  High-performance design with sticky cart, dynamic sizing guide, and material specs.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Teko:wght@400;600;700&family=Inter:wght@400;600;800&display=swap');

  :root {
    --aw-primary: {{ section.settings.color_primary | default: '#E2FE16' }};
    --aw-bg: {{ section.settings.color_bg | default: '#050505' }};
    --aw-surface: {{ section.settings.color_surface | default: '#111111' }};
    --aw-border: rgba(255, 255, 255, 0.1);
    --aw-text: {{ section.settings.color_text | default: '#FFFFFF' }};
    --aw-text-dim: #A1A1AA;
    --aw-font-heading: 'Teko', sans-serif;
    --aw-font-body: 'Inter', sans-serif;
  }

  .cf-aw-p * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-aw-p { font-family: var(--aw-font-body); background: var(--aw-bg); color: var(--aw-text); line-height: 1.6; }
  .cf-aw-p h1, .cf-aw-p h2 { font-family: var(--aw-font-heading); text-transform: uppercase; line-height: 1.1; margin: 0; }
  
  .cf-aw-p-container { max-width: 1400px; margin: 0 auto; padding: 40px 5%; display: grid; grid-template-columns: 1.2fr 1fr; gap: 60px; align-items: start; }
  
  /* Gallery */
  .cf-aw-p-gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; position: sticky; top: 40px; }
  .cf-aw-p-img { background: var(--aw-surface); aspect-ratio: 4/5; overflow: hidden; position: relative; }
  .cf-aw-p-img img { width: 100%; height: 100%; object-fit: cover; }
  .cf-aw-p-img:first-child { grid-column: 1 / -1; }
  
  /* Info */
  .cf-aw-p-info { padding-bottom: 80px; }
  .cf-aw-p-vendor { color: var(--aw-primary); font-weight: 800; font-size: 14px; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 12px; }
  .cf-aw-p-title { font-size: clamp(40px, 5vw, 64px); font-weight: 700; margin-bottom: 20px; text-shadow: 2px 2px 0px rgba(226,254,22,0.1); }
  
  .cf-aw-p-price-row { display: flex; align-items: baseline; gap: 16px; margin-bottom: 30px; border-bottom: 1px solid var(--aw-border); padding-bottom: 24px; }
  .cf-aw-p-price { font-size: 36px; font-family: var(--aw-font-heading); color: var(--aw-primary); }
  .cf-aw-p-compare { font-size: 20px; color: var(--aw-text-dim); text-decoration: line-through; }
  
  .cf-aw-p-desc { font-size: 16px; color: var(--aw-text-dim); margin-bottom: 40px; }
  
  /* Variants */
  .cf-aw-p-option { margin-bottom: 30px; }
  .cf-aw-p-option-name { font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 12px; display: flex; justify-content: space-between; }
  .cf-aw-p-size-guide { color: var(--aw-text-dim); text-decoration: underline; cursor: pointer; font-weight: 600; text-transform: none; font-size: 13px; }
  .cf-aw-p-values { display: flex; flex-wrap: wrap; gap: 10px; }
  .cf-aw-p-val { padding: 12px 24px; background: transparent; border: 2px solid var(--aw-border); color: var(--aw-text); font-weight: 800; cursor: pointer; transition: all 0.2s; font-size: 14px; }
  .cf-aw-p-val:hover, .cf-aw-p-val.active { border-color: var(--aw-primary); color: var(--aw-primary); }
  
  /* Actions */
  .cf-aw-p-actions { display: grid; grid-template-columns: 120px 1fr; gap: 16px; margin-bottom: 40px; }
  .cf-aw-p-qty { display: flex; align-items: center; border: 2px solid var(--aw-border); }
  .cf-aw-p-qty button { background: transparent; border: none; color: var(--aw-text); width: 40px; height: 56px; font-size: 20px; cursor: pointer; }
  .cf-aw-p-qty span { flex: 1; text-align: center; font-weight: 800; font-size: 16px; }
  
  .cf-aw-p-add { 
    background: var(--aw-primary); color: #000; border: none; font-size: 16px; font-weight: 800; 
    text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: all 0.3s;
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
  }
  .cf-aw-p-add:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(226, 254, 22, 0.2); }
  
  .cf-aw-p-buy { grid-column: 1 / -1; padding: 20px; background: #fff; color: #000; border: none; font-size: 16px; font-weight: 800; text-transform: uppercase; cursor: pointer; }
  .cf-aw-p-buy:hover { background: #eee; }
  
  /* Features Accordion */
  .cf-aw-p-acc { border-top: 1px solid var(--aw-border); }
  .cf-aw-p-acc-item { border-bottom: 1px solid var(--aw-border); }
  .cf-aw-p-acc-btn { width: 100%; background: transparent; border: none; color: var(--aw-text); padding: 20px 0; font-size: 16px; font-weight: 800; text-transform: uppercase; text-align: left; cursor: pointer; display: flex; justify-content: space-between; font-family: var(--aw-font-body); }
  .cf-aw-p-acc-body { max-height: 0; overflow: hidden; transition: max-height 0.3s; color: var(--aw-text-dim); font-size: 15px; }
  .cf-aw-p-acc-body.open { max-height: 400px; padding-bottom: 20px; }
  
  /* Specs Block */
  .cf-aw-p-specs { display: flex; gap: 40px; margin-top: 20px; }
  .cf-aw-p-spec { display: flex; align-items: center; gap: 12px; font-size: 14px; font-weight: 600; }
  .cf-aw-p-spec svg { color: var(--aw-primary); }

  @media(max-width: 900px) {
    .cf-aw-p-container { grid-template-columns: 1fr; }
    .cf-aw-p-gallery { position: static; grid-template-columns: 1fr; }
    .cf-aw-p-img:not(:first-child) { display: none; } /* Only show first image on mobile, maybe add a slider later */
  }
{% endstyle %}

<div class="cf-aw-p">
  <div class="cf-aw-p-container">
    
    <div class="cf-aw-p-gallery">
      {% for image in product.images limit: 5 %}
        <div class="cf-aw-p-img">
          <img src="{{ image | img_url: 'master' }}" alt="{{ product.title }}">
        </div>
      {% else %}
        <div class="cf-aw-p-img"><div style="width:100%; height:100%; background:#222;"></div></div>
        <div class="cf-aw-p-img"><div style="width:100%; height:100%; background:#222;"></div></div>
        <div class="cf-aw-p-img"><div style="width:100%; height:100%; background:#222;"></div></div>
      {% endfor %}
    </div>
    
    <div class="cf-aw-p-info">
      <div class="cf-aw-p-vendor">{{ product.vendor | default: section.settings.vendor_text }}</div>
      <h1 class="cf-aw-p-title">{{ product.title | default: 'Performance Elite Tee' }}</h1>
      
      <div class="cf-aw-p-price-row">
        <span class="cf-aw-p-price">{{ product.price | money | default: '$45.00' }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="cf-aw-p-compare">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>
      
      <p class="cf-aw-p-desc">{{ product.description | strip_html | truncate: 250 | default: 'Engineered with our signature sweat-wicking technology. This lightweight performance tee is designed to move with you during your most intense workouts.' }}</p>
      
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="cf-aw-p-option">
            <div class="cf-aw-p-option-name">
              {{ option.name }}
              {% if option.name == 'Size' or option.name == 'size' %}
                <span class="cf-aw-p-size-guide">Size Guide</span>
              {% endif %}
            </div>
            <div class="cf-aw-p-values">
              {% for value in option.values %}
                <button class="cf-aw-p-val {% if forloop.first %}active{% endif %}">{{ value }}</button>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      {% endunless %}
      
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        
        <div class="cf-aw-p-actions">
          <div class="cf-aw-p-qty">
            <button type="button" onclick="var s=this.nextElementSibling;s.textContent=Math.max(1,+s.textContent-1)">-</button>
            <span>1</span>
            <button type="button" onclick="var s=this.previousElementSibling;s.textContent=+s.textContent+1">+</button>
          </div>
          <button type="submit" class="cf-aw-p-add">Add to Cart</button>
          <button type="button" class="cf-aw-p-buy">Buy It Now</button>
        </div>
      {% endform %}
      
      <div class="cf-aw-p-acc">
        <div class="cf-aw-p-acc-item">
          <button class="cf-aw-p-acc-btn" onclick="this.nextElementSibling.classList.toggle('open')">
            Performance Details <span>+</span>
          </button>
          <div class="cf-aw-p-acc-body open">
            {{ section.settings.details_text }}
            <div class="cf-aw-p-specs">
              <div class="cf-aw-p-spec">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                Sweat-wicking
              </div>
              <div class="cf-aw-p-spec">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/></svg>
                Four-way stretch
              </div>
            </div>
          </div>
        </div>
        <div class="cf-aw-p-acc-item">
          <button class="cf-aw-p-acc-btn" onclick="this.nextElementSibling.classList.toggle('open')">
            Material & Care <span>+</span>
          </button>
          <div class="cf-aw-p-acc-body">
            <ul style="padding-left: 20px; line-height: 2;">
              <li>85% Nylon, 15% Elastane</li>
              <li>Machine wash cold with like colors</li>
              <li>Do not bleach or use fabric softeners</li>
              <li>Tumble dry low</li>
            </ul>
          </div>
        </div>
        <div class="cf-aw-p-acc-item">
          <button class="cf-aw-p-acc-btn" onclick="this.nextElementSibling.classList.toggle('open')">
            Shipping & Returns <span>+</span>
          </button>
          <div class="cf-aw-p-acc-body">
            <p>Free standard shipping on all orders over $75. Expedited shipping available at checkout.</p>
            <p>Returns accepted within 30 days of purchase. Items must be unworn and in original condition.</p>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CF Activewear PDP",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Primary Color (Neon)", "default": "#E2FE16" },
    { "type": "color", "id": "color_bg", "label": "Background Color", "default": "#050505" },
    { "type": "color", "id": "color_surface", "label": "Surface Color", "default": "#111111" },
    { "type": "color", "id": "color_text", "label": "Text Color", "default": "#FFFFFF" },
    { "type": "text", "id": "vendor_text", "label": "Default Vendor", "default": "AW Elite" },
    { "type": "textarea", "id": "details_text", "label": "Performance Details Text", "default": "Built from our proprietary compression fabric, this piece provides unmatched support without sacrificing breathability." }
  ],
  "presets": [
    { "name": "CF Activewear PDP" }
  ]
}
{% endschema %}
