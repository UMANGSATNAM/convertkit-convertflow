{% comment %}ConvertFlow - Fashion Clothing Landing | VOLT style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
.cffc{--ink:#0A0A0A;--paper:#F5F3EF;--accent:#E8D5B0;--mid:#888;--border:#E0DDD8;}
.cffc *{box-sizing:border-box;margin:0;padding:0;}
.cffc{background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif;font-size:15px;-webkit-font-smoothing:antialiased;}
.cffc h1,.cffc h2,.cffc h3{font-family:'Bebas Neue',sans-serif;font-weight:400;letter-spacing:2px;}
.cffc-promo{background:var(--ink);color:#fff;text-align:center;padding:11px;font-size:12px;letter-spacing:3px;text-transform:uppercase;}
.cffc-promo a{color:var(--accent);text-decoration:none;}
.cffc-header{background:var(--paper);padding:20px 60px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);}
.cffc-brand{font-family:'Bebas Neue',sans-serif;font-size:36px;letter-spacing:6px;color:var(--ink);text-decoration:none;}
.cffc-nav{display:flex;gap:36px;list-style:none;}
.cffc-nav a{font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--ink);text-decoration:none;transition:color .2s;}
.cffc-nav a:hover{color:var(--mid);}
.cffc-hact{display:flex;align-items:center;gap:20px;}
.cffc-hbtn{background:var(--ink);color:#fff;padding:10px 24px;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;border:none;cursor:pointer;text-decoration:none;transition:opacity .2s;}
.cffc-hbtn:hover{opacity:.8;}
.cffc-hero{display:grid;grid-template-columns:1.1fr .9fr;height:92vh;border-bottom:1px solid var(--border);}
.cffc-hero-visual{background:#1A1A1A;display:flex;align-items:flex-end;padding:60px;position:relative;overflow:hidden;}
.cffc-hero-visual::before{content:'COLLECTION';position:absolute;top:50%;left:-80px;transform:translateY(-50%) rotate(-90deg);font-family:'Bebas Neue',sans-serif;font-size:200px;color:rgba(255,255,255,.04);letter-spacing:10px;white-space:nowrap;}
.cffc-hero-tag{display:inline-flex;align-items:center;gap:12px;color:var(--accent);font-size:11px;font-weight:700;letter-spacing:4px;text-transform:uppercase;}
.cffc-hero-tag::before{content:'';width:32px;height:1px;background:var(--accent);}
.cffc-hero-content{padding:80px 80px 80px 70px;display:flex;flex-direction:column;justify-content:center;position:relative;}
.cffc-hero-content h1{font-size:110px;line-height:.92;margin:20px 0 30px;color:var(--ink);}
.cffc-hero-content>p{font-size:17px;color:var(--mid);line-height:1.8;max-width:380px;margin-bottom:48px;font-weight:300;}
.cffc-cta-group{display:flex;gap:16px;}
.cffc-btn-dark{background:var(--ink);color:#fff;padding:18px 40px;font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;text-decoration:none;transition:opacity .2s;}
.cffc-btn-dark:hover{opacity:.8;}
.cffc-btn-outline{background:transparent;color:var(--ink);border:1px solid var(--ink);padding:17px 40px;font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;text-decoration:none;transition:all .2s;}
.cffc-btn-outline:hover{background:var(--ink);color:#fff;}
.cffc-scroll{position:absolute;bottom:40px;right:60px;display:flex;align-items:center;gap:12px;font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--mid);}
.cffc-scroll::after{content:'';width:40px;height:1px;background:var(--mid);}
.cffc-cats{display:flex;border-bottom:1px solid var(--border);}
.cffc-cat{flex:1;padding:32px;text-align:center;border-right:1px solid var(--border);text-decoration:none;color:var(--ink);transition:background .2s;position:relative;overflow:hidden;}
.cffc-cat:last-child{border-right:none;}
.cffc-cat:hover{background:var(--ink);}
.cffc-cat:hover .cffc-cat-label,.cffc-cat:hover .cffc-cat-count{color:#fff;}
.cffc-cat-label{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:2px;display:block;margin-bottom:4px;transition:color .2s;}
.cffc-cat-count{font-size:11px;color:var(--mid);letter-spacing:2px;text-transform:uppercase;transition:color .2s;}
.cffc-shop{padding:100px 60px;max-width:1400px;margin:0 auto;}
.cffc-sec-hd{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:60px;}
.cffc-sec-hd h2{font-size:64px;color:var(--ink);}
.cffc-view-all{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--mid);text-decoration:none;border-bottom:1px solid var(--mid);padding-bottom:4px;}
.cffc-view-all:hover{color:var(--ink);border-color:var(--ink);}
.cffc-prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}
.cffc-prod-card{position:relative;cursor:pointer;}
.cffc-pc-img{aspect-ratio:3/4;background:#E8E4DC;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;margin-bottom:18px;}
.cffc-pc-img:hover .cffc-pc-overlay{opacity:1;}
.cffc-pc-img img{width:100%;height:100%;object-fit:cover;transition:transform .6s;}
.cffc-prod-card:hover .cffc-pc-img img{transform:scale(1.05);}
.cffc-pc-overlay{position:absolute;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .3s;}
.cffc-pc-overlay-btn{background:#fff;color:var(--ink);padding:12px 28px;font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;border:none;cursor:pointer;}
.cffc-pc-badge{position:absolute;top:16px;left:16px;background:var(--ink);color:#fff;padding:5px 12px;font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;z-index:2;}
.cffc-pc-badge.sale{background:#C0392B;}
.cffc-pc-name{font-weight:700;font-size:14px;margin-bottom:4px;}
.cffc-pc-type{font-size:12px;color:var(--mid);margin-bottom:8px;letter-spacing:1px;}
.cffc-pc-prices{display:flex;gap:10px;align-items:center;}
.cffc-pc-price{font-size:15px;font-weight:700;}
.cffc-pc-old{font-size:13px;color:var(--mid);text-decoration:line-through;}
.cffc-editorial{display:grid;grid-template-columns:1fr 1fr;height:600px;margin:40px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
.cffc-ed-left{background:#1a1a1a;display:flex;flex-direction:column;justify-content:flex-end;padding:60px;position:relative;overflow:hidden;}
.cffc-ed-left::before{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.7) 0%,transparent 60%);}
.cffc-ed-left-c{position:relative;z-index:1;}
.cffc-ed-left h2{font-size:72px;color:#fff;margin-bottom:16px;}
.cffc-ed-left p{font-size:15px;color:rgba(255,255,255,.6);margin-bottom:30px;max-width:360px;line-height:1.8;}
.cffc-ed-right{display:grid;grid-template-rows:1fr 1fr;}
.cffc-ed-item{background:#2A2A2A;display:flex;flex-direction:column;justify-content:flex-end;padding:40px;border-bottom:1px solid rgba(255,255,255,.05);}
.cffc-ed-item:last-child{border-bottom:none;background:#F0EBE0;}
.cffc-ed-item h3{font-family:'Bebas Neue',sans-serif;font-size:32px;color:#fff;letter-spacing:2px;margin-bottom:8px;}
.cffc-ed-item:last-child h3{color:var(--ink);}
.cffc-ed-item p{font-size:13px;color:rgba(255,255,255,.5);letter-spacing:1px;}
.cffc-ed-item:last-child p{color:var(--mid);}
.cffc-size-band{background:var(--ink);color:#fff;padding:40px 60px;display:flex;align-items:center;justify-content:space-between;gap:40px;}
.cffc-sb-text h3{font-size:32px;margin-bottom:8px;}
.cffc-sb-text p{font-size:14px;color:rgba(255,255,255,.5);}
.cffc-sb-sizes{display:flex;gap:16px;}
.cffc-sz{width:52px;height:52px;border:1px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;cursor:pointer;transition:all .2s;}
.cffc-sz:hover,.cffc-sz.active{background:#fff;color:var(--ink);}
.cffc-sb-btn{background:#fff;color:var(--ink);padding:16px 32px;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;border:none;cursor:pointer;white-space:nowrap;transition:opacity .2s;}
.cffc-sb-btn:hover{opacity:.85;}
.cffc-footer{background:var(--ink);padding:80px 60px 40px;}
.cffc-ft{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;padding-bottom:60px;border-bottom:1px solid rgba(255,255,255,.1);}
.cffc-fb a{font-family:'Bebas Neue',sans-serif;font-size:40px;letter-spacing:6px;color:#fff;text-decoration:none;display:block;margin-bottom:20px;}
.cffc-fb p{font-size:13px;color:rgba(255,255,255,.4);line-height:1.9;max-width:280px;}
.cffc-fc h4{font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,.4);margin-bottom:24px;}
.cffc-fc ul{list-style:none;}
.cffc-fc li{margin-bottom:12px;}
.cffc-fc a{color:rgba(255,255,255,.6);text-decoration:none;font-size:14px;transition:color .2s;}
.cffc-fc a:hover{color:#fff;}
.cffc-fbot{display:flex;justify-content:space-between;padding-top:30px;font-size:11px;color:rgba(255,255,255,.25);letter-spacing:1px;}
@media(max-width:1024px){.cffc-hero{grid-template-columns:1fr;height:auto}.cffc-hero-content{padding:60px 40px}.cffc-hero-content h1{font-size:72px}.cffc-prod-grid{grid-template-columns:repeat(2,1fr)}.cffc-editorial{grid-template-columns:1fr;height:auto}.cffc-ft{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cffc-header{padding:16px 20px}.cffc-nav{display:none}.cffc-shop{padding:60px 20px}.cffc-cats{flex-wrap:wrap}.cffc-cat{min-width:50%}.cffc-size-band{flex-direction:column;padding:40px 20px}.cffc-ft{grid-template-columns:1fr;gap:40px}.cffc-footer{padding:60px 20px 30px}}
</style>

<div class="cffc">
  <div class="cffc-promo">{{ section.settings.promo_text | default: 'New Season Drop — Extra 15% off with code VOLT15' }} &nbsp;<a href="#">Shop Now &rarr;</a></div>
  <header class="cffc-header">
    <a href="{{ routes.root_url }}" class="cffc-brand">{{ section.settings.brand_name | default: 'VŌLT' }}</a>
    <ul class="cffc-nav"><li><a href="#">New In</a></li><li><a href="#">Women</a></li><li><a href="#">Men</a></li><li><a href="#">Denim</a></li><li><a href="#">Sale</a></li></ul>
    <div class="cffc-hact"><a href="{{ routes.cart_url }}" class="cffc-hbtn">Bag ({{ cart.item_count }})</a></div>
  </header>

  <section class="cffc-hero">
    <div class="cffc-hero-visual"><div class="cffc-hero-tag">{{ section.settings.hero_season | default: 'SS 2025 Collection' }}</div></div>
    <div class="cffc-hero-content">
      <h1>{{ section.settings.hero_heading | default: 'DRESSED FOR THE FUTURE' }}</h1>
      <p>{{ section.settings.hero_subtext | default: 'Premium essentials engineered for people who move with intention. Every stitch, deliberate. Every fabric, chosen for life.' }}</p>
      <div class="cffc-cta-group">
        <a href="{{ section.settings.cta1_url | default: routes.collections_url }}" class="cffc-btn-dark">{{ section.settings.cta1_text | default: 'Shop Women' }}</a>
        <a href="{{ section.settings.cta2_url | default: routes.collections_url }}" class="cffc-btn-outline">{{ section.settings.cta2_text | default: 'Shop Men' }}</a>
      </div>
      <div class="cffc-scroll">Scroll</div>
    </div>
  </section>

  <div class="cffc-cats">
    <a href="#" class="cffc-cat"><span class="cffc-cat-label">Outerwear</span><span class="cffc-cat-count">48 Styles</span></a>
    <a href="#" class="cffc-cat"><span class="cffc-cat-label">Denim</span><span class="cffc-cat-count">36 Styles</span></a>
    <a href="#" class="cffc-cat"><span class="cffc-cat-label">Knitwear</span><span class="cffc-cat-count">52 Styles</span></a>
    <a href="#" class="cffc-cat"><span class="cffc-cat-label">Accessories</span><span class="cffc-cat-count">24 Styles</span></a>
  </div>

  <section class="cffc-shop">
    <div class="cffc-sec-hd"><h2>NEW IN</h2><a href="{{ routes.collections_url }}" class="cffc-view-all">View All &rarr;</a></div>
    <div class="cffc-prod-grid">
      {% assign col = collections[section.settings.featured_collection] %}
      {% if col and col.products.size > 0 %}
        {% for p in col.products limit: 4 %}
          <div class="cffc-prod-card">
            <div class="cffc-pc-img">
              {% if p.featured_image %}<img src="{{ p.featured_image | img_url: '600x' }}" alt="{{ p.title }}">{% endif %}
              {% if p.compare_at_price > p.price %}<span class="cffc-pc-badge sale">Sale</span>{% else %}<span class="cffc-pc-badge">New</span>{% endif %}
              <div class="cffc-pc-overlay"><button class="cffc-pc-overlay-btn">Quick View</button></div>
            </div>
            <div class="cffc-pc-name">{{ p.title }}</div>
            <div class="cffc-pc-type">{{ p.type }}</div>
            <div class="cffc-pc-prices"><span class="cffc-pc-price">{{ p.price | money }}</span>{% if p.compare_at_price > p.price %}<span class="cffc-pc-old">{{ p.compare_at_price | money }}</span>{% endif %}</div>
          </div>
        {% endfor %}
      {% else %}
        <div class="cffc-prod-card"><div class="cffc-pc-img"><span class="cffc-pc-badge">New</span><div class="cffc-pc-overlay"><button class="cffc-pc-overlay-btn">Quick View</button></div></div><div class="cffc-pc-name">Oversized Wool Blazer</div><div class="cffc-pc-type">Women's Outerwear</div><div class="cffc-pc-prices"><span class="cffc-pc-price">&#8377;8,999</span></div></div>
        <div class="cffc-prod-card"><div class="cffc-pc-img" style="background:#1A1A1A;"><span class="cffc-pc-badge sale">Sale</span><div class="cffc-pc-overlay"><button class="cffc-pc-overlay-btn">Quick View</button></div></div><div class="cffc-pc-name">Classic Slim Denim</div><div class="cffc-pc-type">Men's Bottoms</div><div class="cffc-pc-prices"><span class="cffc-pc-price">&#8377;3,499</span><span class="cffc-pc-old">&#8377;4,999</span></div></div>
        <div class="cffc-prod-card"><div class="cffc-pc-img" style="background:#D4CFC6;"><div class="cffc-pc-overlay"><button class="cffc-pc-overlay-btn">Quick View</button></div></div><div class="cffc-pc-name">Fine Knit Crew Neck</div><div class="cffc-pc-type">Women's Knitwear</div><div class="cffc-pc-prices"><span class="cffc-pc-price">&#8377;5,499</span></div></div>
        <div class="cffc-prod-card"><div class="cffc-pc-img" style="background:#2C2C2C;"><span class="cffc-pc-badge">Trending</span><div class="cffc-pc-overlay"><button class="cffc-pc-overlay-btn">Quick View</button></div></div><div class="cffc-pc-name">Structured Tote Bag</div><div class="cffc-pc-type">Accessories</div><div class="cffc-pc-prices"><span class="cffc-pc-price">&#8377;6,299</span></div></div>
      {% endif %}
    </div>
  </section>

  <div class="cffc-editorial">
    <div class="cffc-ed-left"><div class="cffc-ed-left-c"><h2>THE DENIM STORY</h2><p>Raw, tumbled, and washed to perfection. Our denim is built to break in beautifully and last a lifetime.</p><a href="#" class="cffc-btn-dark">Shop Denim</a></div></div>
    <div class="cffc-ed-right">
      <div class="cffc-ed-item"><h3>New Arrivals Daily</h3><p>Fresh styles every Monday &amp; Thursday</p></div>
      <div class="cffc-ed-item"><h3>The Essentials Edit</h3><p>Build a wardrobe that works forever</p></div>
    </div>
  </div>

  <div class="cffc-size-band">
    <div class="cffc-sb-text"><h3>FIND YOUR FIT</h3><p>Our extended size range covers XS to 4XL across all categories.</p></div>
    <div class="cffc-sb-sizes">
      <div class="cffc-sz">XS</div><div class="cffc-sz active">S</div><div class="cffc-sz">M</div><div class="cffc-sz">L</div><div class="cffc-sz">XL</div><div class="cffc-sz">2XL</div>
    </div>
    <button class="cffc-sb-btn">Size Guide</button>
  </div>

  <footer class="cffc-footer">
    <div class="cffc-ft">
      <div class="cffc-fb"><a href="{{ routes.root_url }}">{{ section.settings.brand_name | default: 'VŌLT' }}</a><p>Premium fashion engineered for modern life. Thoughtfully designed, responsibly made, built to last.</p></div>
      <div class="cffc-fc"><h4>Shop</h4><ul><li><a href="#">Women</a></li><li><a href="#">Men</a></li><li><a href="#">Accessories</a></li><li><a href="#">Sale</a></li></ul></div>
      <div class="cffc-fc"><h4>Company</h4><ul><li><a href="#">About</a></li><li><a href="#">Sustainability</a></li><li><a href="#">Careers</a></li><li><a href="#">Press</a></li></ul></div>
      <div class="cffc-fc"><h4>Support</h4><ul><li><a href="#">Size Guide</a></li><li><a href="#">Returns</a></li><li><a href="#">Shipping</a></li><li><a href="#">Contact</a></li></ul></div>
    </div>
    <div class="cffc-fbot"><span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'VŌLT' }} Fashion.</span><span>Privacy &middot; Terms</span></div>
  </footer>
</div>

{% schema %}
{
  "name": "Fashion Clothing Landing",
  "settings": [
    {"type":"text","id":"promo_text","label":"Promo Bar Text","default":"New Season Drop — Extra 15% off with code VOLT15"},
    {"type":"text","id":"brand_name","label":"Brand Name","default":"VŌLT"},
    {"type":"text","id":"hero_season","label":"Hero Season Tag","default":"SS 2025 Collection"},
    {"type":"textarea","id":"hero_heading","label":"Hero Heading","default":"DRESSED FOR THE FUTURE"},
    {"type":"textarea","id":"hero_subtext","label":"Hero Subtext","default":"Premium essentials engineered for people who move with intention."},
    {"type":"text","id":"cta1_text","label":"CTA 1 Text","default":"Shop Women"},
    {"type":"url","id":"cta1_url","label":"CTA 1 URL"},
    {"type":"text","id":"cta2_text","label":"CTA 2 Text","default":"Shop Men"},
    {"type":"url","id":"cta2_url","label":"CTA 2 URL"},
    {"type":"collection","id":"featured_collection","label":"Featured Collection"}
  ],
  "presets": [{"name":"Fashion Clothing Landing"}]
}
{% endschema %}