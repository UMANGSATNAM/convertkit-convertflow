{% comment %}
  ConvertFlow — Fashion Clothing Landing Page
  Elegant lookbook, soft aesthetics, masonry grid, serif typography.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

  :root {
    --fc-primary: {{ section.settings.color_primary | default: '#0A0A0A' }};
    --fc-bg: {{ section.settings.color_bg | default: '#F5F3EF' }};
    --fc-surface: {{ section.settings.color_surface | default: '#FFFFFF' }};
    --fc-text: {{ section.settings.color_text | default: '#1a1a1a' }};
    --fc-border: rgba(0, 0, 0, 0.08);
    --fc-font-heading: 'Playfair Display', serif;
    --fc-font-body: 'Inter', sans-serif;
  }

  .cf-fc * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-fc { font-family: var(--fc-font-body); background: var(--fc-bg); color: var(--fc-text); line-height: 1.6; }
  .cf-fc h1, .cf-fc h2, .cf-fc h3 { font-family: var(--fc-font-heading); font-weight: 400; color: var(--fc-primary); }

  /* Buttons */
  .cf-fc-btn { display: inline-block; padding: 16px 40px; background: var(--fc-primary); color: #fff; font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 2px; text-decoration: none; transition: all 0.4s ease; border: 1px solid var(--fc-primary); }
  .cf-fc-btn:hover { background: transparent; color: var(--fc-primary); }
  
  /* Hero Split */
  .cf-fc-hero { display: grid; grid-template-columns: 1fr 1fr; min-height: 90vh; }
  .cf-fc-hero-img { background: #e0dcd3; position: relative; }
  .cf-fc-hero-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cf-fc-hero-text { display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 10%; }
  .cf-fc-hero-text h1 { font-size: clamp(48px, 6vw, 80px); line-height: 1.1; margin-bottom: 24px; }
  .cf-fc-hero-text h1 i { color: #888; font-style: italic; }
  .cf-fc-hero-text p { font-size: 16px; color: #555; margin-bottom: 40px; max-width: 400px; }

  /* Lookbook / Masonry */
  .cf-fc-lookbook { padding: 100px 5%; background: var(--fc-surface); }
  .cf-fc-section-title { text-align: center; font-size: clamp(36px, 5vw, 56px); margin-bottom: 60px; }
  
  .cf-fc-masonry { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; max-width: 1400px; margin: 0 auto; }
  .cf-fc-masonry-item { position: relative; overflow: hidden; display: block; text-decoration: none; color: var(--fc-text); }
  .cf-fc-masonry-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s ease; }
  .cf-fc-masonry-item:hover img { transform: scale(1.05); }
  .cf-fc-masonry-item:nth-child(1) { grid-row: span 2; aspect-ratio: 3/4; }
  .cf-fc-masonry-item:nth-child(2) { aspect-ratio: 4/3; }
  .cf-fc-masonry-item:nth-child(3) { grid-row: span 2; aspect-ratio: 3/4; }
  .cf-fc-masonry-item:nth-child(4) { aspect-ratio: 4/5; }
  
  .cf-fc-masonry-text { position: absolute; bottom: 30px; left: 30px; background: rgba(255,255,255,0.9); padding: 16px 24px; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; font-weight: 500; opacity: 0; transform: translateY(10px); transition: all 0.4s ease; }
  .cf-fc-masonry-item:hover .cf-fc-masonry-text { opacity: 1; transform: translateY(0); }

  /* Featured Editorial */
  .cf-fc-editorial { padding: 120px 5%; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; max-width: 1400px; margin: 0 auto; }
  .cf-fc-edit-img { aspect-ratio: 4/5; background: #e0dcd3; overflow: hidden; }
  .cf-fc-edit-img img { width: 100%; height: 100%; object-fit: cover; }
  .cf-fc-edit-content { max-width: 500px; }
  .cf-fc-edit-content h2 { font-size: 48px; margin-bottom: 30px; line-height: 1.2; }
  .cf-fc-edit-content p { font-size: 16px; color: #666; margin-bottom: 40px; font-weight: 300; }

  /* Collection Slider */
  .cf-fc-slider { padding: 100px 0; background: var(--fc-surface); border-top: 1px solid var(--fc-border); overflow: hidden; }
  .cf-fc-slider-header { text-align: center; margin-bottom: 60px; }
  .cf-fc-slider-header h2 { font-size: 40px; }
  .cf-fc-slider-track { display: flex; gap: 30px; padding: 0 5% 40px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .cf-fc-slider-track::-webkit-scrollbar { display: none; }
  
  .cf-fc-slide { flex: 0 0 clamp(280px, 25vw, 350px); scroll-snap-align: start; text-decoration: none; color: var(--fc-text); }
  .cf-fc-slide-img { aspect-ratio: 3/4; background: #f0ece6; margin-bottom: 20px; overflow: hidden; }
  .cf-fc-slide-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .cf-fc-slide:hover .cf-fc-slide-img img { transform: scale(1.05); }
  .cf-fc-slide-info { text-align: center; }
  .cf-fc-slide-title { font-size: 15px; margin-bottom: 6px; font-weight: 500; }
  .cf-fc-slide-price { font-size: 14px; color: #666; }

  @media (max-width: 900px) {
    .cf-fc-hero { grid-template-columns: 1fr; grid-template-rows: 50vh auto; }
    .cf-fc-masonry { grid-template-columns: 1fr 1fr; }
    .cf-fc-editorial { grid-template-columns: 1fr; }
    .cf-fc-edit-content { order: -1; text-align: center; margin: 0 auto; }
  }
  @media (max-width: 600px) {
    .cf-fc-masonry { grid-template-columns: 1fr; }
    .cf-fc-masonry-item:nth-child(n) { grid-row: auto; aspect-ratio: 4/5; }
  }
{% endstyle %}

<div class="cf-fc">
  {% for block in section.blocks %}
    {% case block.type %}
      
      {% when 'hero' %}
        <section class="cf-fc-hero">
          <div class="cf-fc-hero-img">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: 'master' }}" alt="Hero">
            {% else %}
              <div style="width:100%; height:100%; background:#dcd4ca;"></div>
            {% endif %}
          </div>
          <div class="cf-fc-hero-text">
            <h1>{{ block.settings.title | default: 'The <i>Spring</i><br>Collection' }}</h1>
            <p>{{ block.settings.text | default: 'Embrace effortless elegance with our carefully curated pieces for the new season.' }}</p>
            <a href="{{ block.settings.btn_url }}" class="cf-fc-btn">{{ block.settings.btn_text | default: 'Discover Now' }}</a>
          </div>
        </section>

      {% when 'lookbook' %}
        <section class="cf-fc-lookbook">
          <h2 class="cf-fc-section-title">{{ block.settings.heading | default: 'Curated Looks' }}</h2>
          <div class="cf-fc-masonry">
            {% for i in (1..4) %}
              <a href="#" class="cf-fc-masonry-item">
                <div style="width:100%; height:100%; background:#{{ i | times: 111 | plus: 111111 }};"></div>
                <div class="cf-fc-masonry-text">Shop Look 0{{ i }}</div>
              </a>
            {% endfor %}
          </div>
        </section>

      {% when 'editorial' %}
        <section class="cf-fc-editorial">
          <div class="cf-fc-edit-content">
            <h2>{{ block.settings.heading | default: 'A Return to Tailoring' }}</h2>
            <p>{{ block.settings.text | default: 'Our latest collection focuses on precise cuts, premium fabrics, and silhouettes that stand the test of time. Quality over quantity, always.' }}</p>
            <a href="{{ block.settings.btn_url }}" class="cf-fc-btn" style="padding: 14px 30px;">{{ block.settings.btn_text | default: 'Read The Journal' }}</a>
          </div>
          <div class="cf-fc-edit-img">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '800x' }}" alt="Editorial">
            {% else %}
              <div style="width:100%; height:100%; background:#dcd4ca;"></div>
            {% endif %}
          </div>
        </section>

      {% when 'products' %}
        <section class="cf-fc-slider">
          <div class="cf-fc-slider-header">
            <h2>{{ block.settings.heading | default: 'New Arrivals' }}</h2>
          </div>
          <div class="cf-fc-slider-track">
            {% assign collection = block.settings.collection %}
            {% if collection != blank and collection.products_count > 0 %}
              {% for product in collection.products limit: 6 %}
                <a href="{{ product.url }}" class="cf-fc-slide">
                  <div class="cf-fc-slide-img">
                    {% if product.featured_image %}
                      <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title }}">
                    {% endif %}
                  </div>
                  <div class="cf-fc-slide-info">
                    <div class="cf-fc-slide-title">{{ product.title }}</div>
                    <div class="cf-fc-slide-price">{{ product.price | money }}</div>
                  </div>
                </a>
              {% endfor %}
            {% else %}
              {% for i in (1..5) %}
                <a href="#" class="cf-fc-slide">
                  <div class="cf-fc-slide-img"><div style="background:#f0ece6; width:100%; height:100%;"></div></div>
                  <div class="cf-fc-slide-info">
                    <div class="cf-fc-slide-title">Silk Blend Dress</div>
                    <div class="cf-fc-slide-price">$120.00</div>
                  </div>
                </a>
              {% endfor %}
            {% endif %}
          </div>
        </section>

    {% endcase %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "CF Fashion Landing",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Primary Color", "default": "#0A0A0A" },
    { "type": "color", "id": "color_bg", "label": "Background Color", "default": "#F5F3EF" },
    { "type": "color", "id": "color_surface", "label": "Surface Color", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text Color", "default": "#1a1a1a" }
  ],
  "blocks": [
    {
      "type": "hero",
      "name": "Hero Section",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "title", "label": "Headline", "default": "The <i>Spring</i><br>Collection" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Embrace effortless elegance." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Discover Now" },
        { "type": "url", "id": "btn_url", "label": "Button Link" }
      ]
    },
    {
      "type": "lookbook",
      "name": "Lookbook Grid",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Curated Looks" }
      ]
    },
    {
      "type": "editorial",
      "name": "Editorial Block",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "A Return to Tailoring" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Quality over quantity, always." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Read The Journal" },
        { "type": "url", "id": "btn_url", "label": "Button Link" }
      ]
    },
    {
      "type": "products",
      "name": "Featured Products",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF Fashion Landing",
      "blocks": [
        { "type": "hero" },
        { "type": "lookbook" },
        { "type": "editorial" },
        { "type": "products" }
      ]
    }
  ]
}
{% endschema %}