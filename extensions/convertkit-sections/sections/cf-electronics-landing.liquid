{% schema %}
{
  "name": "CF Tech & Electronics LP",
  "settings": [
    {
      "type": "header",
      "content": "Brand & Colors"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent Color",
      "default": "#5735db"
