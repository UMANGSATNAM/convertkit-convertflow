{% comment %}ConvertFlow - Electronics Landing | TechVault style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
.cfe *{box-sizing:border-box;margin:0;padding:0}
.cfe{font-family:'Inter',sans-serif;font-size:15px;color:#F8FAFC;background:#0B0F19;-webkit-font-smoothing:antialiased}
.cfe h1,.cfe h2,.cfe h3,.cfe-logo{font-family:'Space Grotesk',sans-serif}
/* PROMO */
.cfe-promo{background:{{ section.settings.color_primary }};color:#fff;padding:10px 0;text-align:center;font-size:13px;font-weight:600;letter-spacing:1px;text-transform:uppercase}
/* HERO */
.cfe-hero{min-height:90vh;display:flex;align-items:center;position:relative;overflow:hidden;padding:0 60px}
.cfe-hero-glow{position:absolute;top:50%;left:80%;transform:translate(-50%,-50%);width:800px;height:800px;background:radial-gradient(circle,rgba(59,130,246,.5) 0%,transparent 60%);opacity:.15;z-index:0;pointer-events:none}
.cfe-hero-content{position:relative;z-index:1;max-width:600px}
.cfe-hero-badge{display:inline-flex;align-items:center;gap:8px;background:#131B2C;border:1px solid #1E293B;padding:6px 16px;border-radius:100px;font-size:12px;font-weight:600;color:#10B981;margin-bottom:24px;letter-spacing:1px;text-transform:uppercase}
.cfe-hero h1{font-size:80px;line-height:1.1;margin-bottom:24px;font-weight:700;letter-spacing:-2px}
.cfe-hero h1 span{color:{{ section.settings.color_primary }}}
.cfe-hero p{font-size:18px;color:#94A3B8;margin-bottom:40px;line-height:1.6;max-width:500px}
.cfe-btn-primary{background:#F8FAFC;color:#0B0F19;padding:16px 32px;font-size:15px;font-weight:600;font-family:'Inter',sans-serif;cursor:pointer;border:none;border-radius:4px;transition:transform .2s,box-shadow .2s;display:inline-flex;align-items:center;gap:8px}
.cfe-btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 20px rgba(255,255,255,.1)}
.cfe-btn-secondary{background:transparent;color:#F8FAFC;padding:16px 32px;font-size:15px;font-weight:600;font-family:'Inter',sans-serif;cursor:pointer;border:1px solid #1E293B;border-radius:4px;transition:background .2s;display:inline-flex;align-items:center;gap:8px;margin-left:16px}
.cfe-btn-secondary:hover{background:#131B2C}
/* TRUST STATS */
.cfe-trust{display:flex;gap:60px;margin-top:60px;border-top:1px solid #1E293B;padding-top:40px}
.cfe-trust-item h4{font-size:32px;font-weight:700;color:#fff;margin-bottom:4px;font-family:'Space Grotesk',sans-serif}
.cfe-trust-item p{font-size:13px;color:#94A3B8;text-transform:uppercase;letter-spacing:1px}
/* PRODUCTS */
.cfe-section{padding:100px 60px;max-width:1400px;margin:0 auto}
.cfe-section-hd{margin-bottom:60px;text-align:center}
.cfe-section-hd h2{font-size:40px;font-weight:700;margin-bottom:16px;letter-spacing:-1px}
.cfe-section-hd p{color:#94A3B8;font-size:16px;max-width:500px;margin:0 auto}
.cfe-product-list{display:flex;flex-direction:column;gap:24px}
.cfe-product-row{display:grid;grid-template-columns:240px 1fr 300px;gap:40px;background:#131B2C;border:1px solid #1E293B;border-radius:8px;padding:24px;align-items:center;transition:border-color .2s;cursor:pointer}
.cfe-product-row:hover{border-color:{{ section.settings.color_primary }}}
.cfe-p-image{width:100%;aspect-ratio:1;background:#000;border-radius:8px;display:flex;align-items:center;justify-content:center}
.cfe-p-image svg{width:64px;height:64px;color:{{ section.settings.color_primary }}}
.cfe-p-info h3{font-size:24px;font-weight:600;margin-bottom:12px;font-family:'Space Grotesk',sans-serif}
.cfe-p-desc{color:#94A3B8;font-size:14px;margin-bottom:24px;line-height:1.5}
.cfe-p-specs{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.cfe-spec-box{background:#0B0F19;padding:10px;border-radius:4px;border:1px solid #1E293B}
.cfe-spec-lbl{font-size:11px;color:#94A3B8;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px}
.cfe-spec-val{font-size:14px;font-weight:600;color:#fff}
.cfe-p-action{text-align:right;display:flex;flex-direction:column;justify-content:center;align-items:flex-end}
.cfe-p-price{font-size:32px;font-family:'Space Grotesk',sans-serif;font-weight:700;margin-bottom:8px}
.cfe-p-price-old{color:#94A3B8;text-decoration:line-through;font-size:16px;margin-bottom:24px;display:block}
.cfe-btn-mono{width:100%;background:#F8FAFC;color:#0B0F19;padding:14px 20px;font-weight:600;border:none;border-radius:4px;cursor:pointer;font-size:14px;font-family:'Inter',sans-serif;transition:opacity .2s}
.cfe-btn-mono:hover{opacity:.9}
/* FEATURES */
.cfe-features{padding:100px 60px;max-width:1400px;margin:0 auto;background:#131B2C;border-top:1px solid #1E293B;border-bottom:1px solid #1E293B}
.cfe-features-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px}
.cfe-feature-card{padding:40px;border:1px solid #1E293B;border-radius:8px;text-align:center}
.cfe-feature-icon{width:64px;height:64px;background:rgba(59,130,246,.1);color:{{ section.settings.color_primary }};border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 24px}
.cfe-feature-icon svg{width:32px;height:32px}
.cfe-feature-card h3{font-size:20px;font-weight:600;margin-bottom:12px;font-family:'Space Grotesk',sans-serif}
.cfe-feature-card p{color:#94A3B8;font-size:14px;line-height:1.6}
/* FOOTER */
.cfe-footer{background:#131B2C;border-top:1px solid #1E293B;padding:80px 60px 40px}
.cfe-footer-grid{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:60px;max-width:1400px;margin:0 auto 60px}
.cfe-fb h4{font-family:'Space Grotesk',sans-serif;font-size:24px;color:#fff;margin-bottom:16px}
.cfe-fb p{color:#94A3B8;font-size:14px;line-height:1.6;max-width:300px;margin-bottom:24px}
.cfe-fl h5{color:#fff;font-size:13px;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:24px}
.cfe-fl ul{list-style:none}
.cfe-fl li{margin-bottom:12px}
.cfe-fl a{color:#94A3B8;text-decoration:none;font-size:14px;transition:color .2s}
.cfe-fl a:hover{color:{{ section.settings.color_primary }}}
.cfe-footer-bottom{max-width:1400px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;padding-top:40px;border-top:1px solid #1E293B;font-size:13px;color:#94A3B8}
@media(max-width:1024px){.cfe-hero h1{font-size:60px}.cfe-product-row{grid-template-columns:1fr;gap:24px}.cfe-p-action{text-align:left;align-items:flex-start}.cfe-features-grid{grid-template-columns:1fr}.cfe-footer-grid{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cfe-hero{padding:60px 24px;text-align:center}.cfe-hero h1{font-size:40px}.cfe-hero p{margin:0 auto 32px}.cfe-trust{flex-direction:column;gap:24px;align-items:center}.cfe-section{padding:60px 24px}.cfe-btn-secondary{margin-left:0;margin-top:16px}}
</style>

<div class="cfe">
  <div class="cfe-promo">{{ section.settings.promo_text }}</div>

  <section class="cfe-hero">
    <div class="cfe-hero-glow"></div>
    <div class="cfe-hero-content">
      {% if section.settings.hero_badge != blank %}
      <div class="cfe-hero-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
        {{ section.settings.hero_badge }}
      </div>
      {% endif %}
      <h1>{{ section.settings.hero_heading }}<br><span>{{ section.settings.hero_heading_accent }}</span></h1>
      <p>{{ section.settings.hero_subtext }}</p>
      <div>
        <button class="cfe-btn-primary">{{ section.settings.hero_cta_text }} <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></button>
        <button class="cfe-btn-secondary">{{ section.settings.hero_cta2_text }}</button>
      </div>
      {% if section.settings.show_hero_stats %}
      <div class="cfe-trust">
        {% for block in section.blocks %}
          {% if block.type == 'hero_stat' %}
          <div class="cfe-trust-item" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.value }}</h4>
            <p>{{ block.settings.label }}</p>
          </div>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </section>

  <section class="cfe-section">
    <div class="cfe-section-hd">
      <h2>{{ section.settings.products_heading }}</h2>
      <p>{{ section.settings.products_subheading }}</p>
    </div>
    <div class="cfe-product-list">
      {% for block in section.blocks %}
        {% if block.type == 'product_row' %}
        <div class="cfe-product-row" {{ block.shopify_attributes }}>
          <div class="cfe-p-image">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 480 }}" alt="{{ block.settings.name }}" style="width:100%;height:100%;object-fit:cover;border-radius:8px">
            {% else %}
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            {% endif %}
          </div>
          <div class="cfe-p-info">
            <h3>{{ block.settings.name }}{% if block.settings.is_new %} <span style="font-size:12px;background:{{ section.settings.color_primary }};color:#fff;padding:2px 8px;border-radius:4px;vertical-align:middle;margin-left:8px;font-family:'Inter',sans-serif">NEW</span>{% endif %}</h3>
            <p class="cfe-p-desc">{{ block.settings.description }}</p>
            <div class="cfe-p-specs">
              {% if block.settings.spec1_label != blank %}<div class="cfe-spec-box"><div class="cfe-spec-lbl">{{ block.settings.spec1_label }}</div><div class="cfe-spec-val">{{ block.settings.spec1_value }}</div></div>{% endif %}
              {% if block.settings.spec2_label != blank %}<div class="cfe-spec-box"><div class="cfe-spec-lbl">{{ block.settings.spec2_label }}</div><div class="cfe-spec-val">{{ block.settings.spec2_value }}</div></div>{% endif %}
              {% if block.settings.spec3_label != blank %}<div class="cfe-spec-box"><div class="cfe-spec-lbl">{{ block.settings.spec3_label }}</div><div class="cfe-spec-val">{{ block.settings.spec3_value }}</div></div>{% endif %}
            </div>
          </div>
          <div class="cfe-p-action">
            <span class="cfe-p-price">{{ block.settings.price }}</span>
            {% if block.settings.old_price != blank %}<span class="cfe-p-price-old">{{ block.settings.old_price }}</span>{% endif %}
            <button class="cfe-btn-mono">Add to Cart</button>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  {% if section.settings.show_features %}
  <div class="cfe-features">
    <div class="cfe-section-hd" style="margin-bottom:60px">
      <h2>{{ section.settings.features_heading }}</h2>
      <p>{{ section.settings.features_subheading }}</p>
    </div>
    <div class="cfe-features-grid">
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
        <div class="cfe-feature-card" {{ block.shopify_attributes }}>
          <div class="cfe-feature-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.description }}</p>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <footer class="cfe-footer">
    <div class="cfe-footer-grid">
      <div class="cfe-fb">
        <h4>{{ section.settings.brand_name }}</h4>
        <p>{{ section.settings.brand_desc }}</p>
      </div>
      <div class="cfe-fl"><h5>Products</h5><ul><li><a href="#">Headphones</a></li><li><a href="#">Earbuds</a></li><li><a href="#">Speakers</a></li><li><a href="#">Accessories</a></li></ul></div>
      <div class="cfe-fl"><h5>Support</h5><ul><li><a href="#">Help Center</a></li><li><a href="#">Track Order</a></li><li><a href="#">Warranty</a></li><li><a href="#">Returns</a></li></ul></div>
      <div class="cfe-fl"><h5>About</h5><ul><li><a href="#">Our Story</a></li><li><a href="#">Careers</a></li><li><a href="#">Press</a></li><li><a href="#">Contact</a></li></ul></div>
    </div>
    <div class="cfe-footer-bottom">
      <p>{{ section.settings.copyright }}</p>
      <div style="display:flex;gap:16px"><a href="#" style="color:#94A3B8;text-decoration:none">Privacy Policy</a><a href="#" style="color:#94A3B8;text-decoration:none">Terms of Service</a></div>
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "CF Electronics",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "text", "id": "brand_name", "label": "Brand Name", "default": "TechVault" },
    { "type": "textarea", "id": "brand_desc", "label": "Brand Description", "default": "Pushing the boundaries of acoustics and electronics. Designing the future of sound since 2018." },
    { "type": "text", "id": "copyright", "label": "Copyright Text", "default": "© 2025 TechVault Inc. All rights reserved." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_primary", "label": "Primary Color (Blue)", "default": "#3B82F6" },
    { "type": "header", "content": "Promo Bar" },
    { "type": "text", "id": "promo_text", "label": "Promo Bar Text", "default": "Free Express Shipping on orders over $150" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_badge", "label": "Hero Badge", "default": "Next-Gen Audio Experience" },
    { "type": "text", "id": "hero_heading", "label": "Hero Heading Line 1", "default": "Hear the Unseen." },
    { "type": "text", "id": "hero_heading_accent", "label": "Hero Heading Line 2 (accent)", "default": "Vertex Pro Max." },
    { "type": "textarea", "id": "hero_subtext", "label": "Hero Subtext", "default": "Engineered with dual-driver precision, adaptive ANC, and 40-hour battery life. The pinnacle of wireless audio has arrived." },
    { "type": "text", "id": "hero_cta_text", "label": "Primary CTA Text", "default": "Pre-order Now" },
    { "type": "text", "id": "hero_cta2_text", "label": "Secondary CTA Text", "default": "View Specs" },
    { "type": "checkbox", "id": "show_hero_stats", "label": "Show Hero Stats", "default": true },
    { "type": "header", "content": "Products Section" },
    { "type": "text", "id": "products_heading", "label": "Products Heading", "default": "Elite Collection" },
    { "type": "text", "id": "products_subheading", "label": "Products Subheading", "default": "Compare specifications across our flagship devices to find your perfect match." },
    { "type": "header", "content": "Features Section" },
    { "type": "checkbox", "id": "show_features", "label": "Show Features Section", "default": true },
    { "type": "text", "id": "features_heading", "label": "Features Heading", "default": "Why TechVault?" },
    { "type": "text", "id": "features_subheading", "label": "Features Subheading", "default": "Engineered for the discerning. Built to outlast." }
  ],
  "blocks": [
    {
      "type": "hero_stat",
      "name": "Hero Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "40h" },
        { "type": "text", "id": "label", "label": "Label", "default": "Playback Time" }
      ]
    },
    {
      "type": "product_row",
      "name": "Product Row",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product Image" },
        { "type": "checkbox", "id": "is_new", "label": "Show NEW badge", "default": false },
        { "type": "text", "id": "name", "label": "Product Name", "default": "Vertex Pro Max" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Flagship over-ear headphones featuring dual-driver acoustics and adaptive active noise cancelation." },
        { "type": "text", "id": "spec1_label", "label": "Spec 1 Label", "default": "Battery" },
        { "type": "text", "id": "spec1_value", "label": "Spec 1 Value", "default": "40 Hours" },
        { "type": "text", "id": "spec2_label", "label": "Spec 2 Label", "default": "Weight" },
        { "type": "text", "id": "spec2_value", "label": "Spec 2 Value", "default": "245g" },
        { "type": "text", "id": "spec3_label", "label": "Spec 3 Label", "default": "Bluetooth" },
        { "type": "text", "id": "spec3_value", "label": "Spec 3 Value", "default": "5.3 Multipoint" },
        { "type": "text", "id": "price", "label": "Price", "default": "$349.00" },
        { "type": "text", "id": "old_price", "label": "Original Price (optional)", "default": "" }
      ]
    },
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Feature Title", "default": "3-Year Global Warranty" },
        { "type": "textarea", "id": "description", "label": "Feature Description", "default": "Every product is backed by our comprehensive warranty, ensuring your investment is protected worldwide." }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF Electronics",
      "blocks": [
        { "type": "hero_stat", "settings": { "value": "40h", "label": "Playback Time" } },
        { "type": "hero_stat", "settings": { "value": "50dB", "label": "Noise Cancelation" } },
        { "type": "hero_stat", "settings": { "value": "Hi-Res", "label": "Audio Certified" } },
        { "type": "product_row", "settings": { "is_new": true, "name": "Vertex Pro Max", "description": "Flagship over-ear headphones featuring dual-driver acoustics and adaptive ANC for ultimate immersion.", "spec1_label": "Battery", "spec1_value": "40 Hours", "spec2_label": "Weight", "spec2_value": "245g", "spec3_label": "Bluetooth", "spec3_value": "5.3 Multipoint", "price": "$349.00", "old_price": "" } },
        { "type": "product_row", "settings": { "name": "Vertex Pulse Buds", "description": "Ultra-compact true wireless earbuds with spatial audio capabilities and transparent mode.", "spec1_label": "Battery", "spec1_value": "24h (with case)", "spec2_label": "Weight", "spec2_value": "4.5g/earbud", "spec3_label": "Waterproof", "spec3_value": "IPX5", "price": "$199.00", "old_price": "$229.00" } },
        { "type": "product_row", "settings": { "name": "Sonic Studio Monitors", "description": "Professional-grade desktop monitors engineered for sound engineers requiring uncolored sound.", "spec1_label": "Response", "spec1_value": "42Hz - 20kHz", "spec2_label": "Amplifier", "spec2_value": "Class-D (80W)", "spec3_label": "Input", "spec3_value": "Balanced XLR", "price": "$499.00", "old_price": "" } },
        { "type": "feature", "settings": { "title": "3-Year Global Warranty", "description": "Every product is backed by our comprehensive warranty, ensuring your investment is protected worldwide." } },
        { "type": "feature", "settings": { "title": "Next-Day Delivery", "description": "Order before 4 PM in major metro areas and receive your audio gear the very next morning." } },
        { "type": "feature", "settings": { "title": "30-Day Audition", "description": "We know audio is personal. Audition our gear for 30 days. If it's not perfect, returns are completely free." } }
      ]
    }
  ]
}
{% endschema %}