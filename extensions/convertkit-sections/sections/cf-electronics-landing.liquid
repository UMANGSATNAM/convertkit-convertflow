{% comment %} ConvertFlow — Electronics Landing | Always-Visible Tech Grid {% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Rajdhani:wght@500;600;700&display=swap');
  .cf-el*{box-sizing:border-box;margin:0;padding:0}
  .cf-el{font-family:'Inter',sans-serif;background:#030508;color:#E2E8F0;overflow-x:hidden}

  /* ═══ GLOW EFFECTS ═══ */
  :root{--el-glow:{{ section.settings.color_accent | default: '#00F0FF' }};}

  /* ═══ HERO ═══ */
  .cf-el-hero{position:relative;min-height:90vh;display:flex;align-items:center;padding:0 5%}
  .cf-el-hero-bg{position:absolute;inset:0;background:radial-gradient(circle at center,rgba(0,240,255,.05) 0%,#030508 70%)}
  .cf-el-hero-bg img{width:100%;height:100%;object-fit:cover;opacity:.4;mix-blend-mode:luminosity}
  .cf-el-hero-inner{position:relative;z-index:2;max-width:800px;margin:0 auto;text-align:center}
  
  .cf-el-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(0,240,255,.1);border:1px solid var(--el-glow);color:var(--el-glow);font-family:'Rajdhani',sans-serif;font-size:14px;font-weight:600;letter-spacing:2px;text-transform:uppercase;padding:6px 16px;border-radius:100px;margin-bottom:30px}
  .cf-el-badge::before{content:'';width:8px;height:8px;background:var(--el-glow);border-radius:50%;box-shadow:0 0 10px var(--el-glow)}
  
  .cf-el-h1{font-family:'Rajdhani',sans-serif;font-size:clamp(48px,8vw,90px);font-weight:700;line-height:1;color:#fff;margin-bottom:24px;text-transform:uppercase;letter-spacing:1px}
  .cf-el-h1 span{color:var(--el-glow);text-shadow:0 0 20px rgba(0,240,255,.4)}
  .cf-el-p{font-size:18px;color:#94A3B8;margin-bottom:40px;line-height:1.6;max-width:600px;margin-left:auto;margin-right:auto}
  
  .cf-el-btn{display:inline-flex;align-items:center;justify-content:center;padding:16px 36px;font-family:'Rajdhani',sans-serif;font-size:18px;font-weight:700;letter-spacing:2px;text-transform:uppercase;text-decoration:none;border-radius:4px;transition:all .3s}
  .cf-el-btn-primary{background:var(--el-glow);color:#030508;box-shadow:0 0 20px rgba(0,240,255,.2)}
  .cf-el-btn-primary:hover{box-shadow:0 0 30px rgba(0,240,255,.5);transform:translateY(-2px)}
  .cf-el-btn-outline{background:transparent;color:var(--el-glow);border:1px solid var(--el-glow)}
  .cf-el-btn-outline:hover{background:rgba(0,240,255,.1)}

  /* ═══ TECH SPECS ═══ */
  .cf-el-specs{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(0,240,255,.1);border-top:1px solid rgba(0,240,255,.2);border-bottom:1px solid rgba(0,240,255,.2)}
  .cf-el-spec{background:#030508;padding:30px 20px;text-align:center}
  .cf-el-spec-icon{color:var(--el-glow);margin-bottom:12px;display:inline-block}
  .cf-el-spec-title{font-family:'Rajdhani',sans-serif;font-size:20px;font-weight:700;color:#fff;text-transform:uppercase}
  .cf-el-spec-desc{font-size:13px;color:#64748B;margin-top:6px}

  /* ═══ PRODUCTS GRID ═══ */
  .cf-el-products{padding:100px 5%}
  .cf-el-section-head{text-align:center;margin-bottom:60px}
  .cf-el-section-head h2{font-family:'Rajdhani',sans-serif;font-size:clamp(36px,5vw,56px);font-weight:700;color:#fff;text-transform:uppercase}
  
  .cf-el-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:30px}
  .cf-el-card{background:#0B1120;border:1px solid #1E293B;border-radius:8px;padding:20px;text-decoration:none;color:#E2E8F0;position:relative;transition:all .3s;overflow:hidden}
  .cf-el-card:hover{border-color:var(--el-glow);box-shadow:0 10px 30px rgba(0,240,255,.05),inset 0 0 20px rgba(0,240,255,.02);transform:translateY(-5px)}
  
  .cf-el-card-img{aspect-ratio:1;background:#030508;border-radius:4px;margin-bottom:20px;padding:20px;display:flex;align-items:center;justify-content:center;position:relative}
  .cf-el-card-img img{max-width:100%;max-height:100%;object-fit:contain;transition:transform .4s}
  .cf-el-card:hover .cf-el-card-img img{transform:scale(1.1)}
  
  .cf-el-card-badge{position:absolute;top:10px;left:10px;background:rgba(0,240,255,.1);color:var(--el-glow);font-size:11px;font-weight:600;padding:4px 8px;border-radius:4px;text-transform:uppercase}
  
  .cf-el-card-title{font-family:'Rajdhani',sans-serif;font-size:20px;font-weight:600;color:#fff;margin-bottom:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .cf-el-card-price{font-size:18px;font-weight:700;color:var(--el-glow)}
  
  .cf-el-card-btn{width:100%;background:rgba(255,255,255,.05);color:#fff;border:none;padding:12px;border-radius:4px;font-family:'Rajdhani',sans-serif;font-size:16px;font-weight:600;margin-top:16px;cursor:pointer;transition:all .2s;text-transform:uppercase;letter-spacing:1px}
  .cf-el-card:hover .cf-el-card-btn{background:var(--el-glow);color:#030508}

  @media(max-width:1024px){
    .cf-el-specs{grid-template-columns:repeat(2,1fr)}
    .cf-el-grid{grid-template-columns:repeat(2,1fr)}
  }
  @media(max-width:600px){
    .cf-el-grid{grid-template-columns:1fr}
    .cf-el-btn{width:100%}
  }
{% endstyle %}

<div class="cf-el">

  {%- comment -%} HERO {%- endcomment -%}
  <section class="cf-el-hero">
    <div class="cf-el-hero-bg">
      {% if section.settings.hero_image != blank %}
        <img src="{{ section.settings.hero_image | img_url: 'master' }}" alt="Tech Hero">
      {% else %}
        <img src="https://images.unsplash.com/photo-1550009158-9ebf69173e03?w=1600&auto=format&fit=crop" alt="Electronics">
      {% endif %}
    </div>
    <div class="cf-el-hero-inner">
      <div class="cf-el-badge">{{ section.settings.hero_badge | default: 'SYSTEM.ONLINE' }}</div>
      <h1 class="cf-el-h1">
        {{ section.settings.hero_headline | default: 'Next-Gen' }}<br>
        <span>{{ section.settings.hero_subline | default: 'Hardware' }}</span>
      </h1>
      <p class="cf-el-p">{{ section.settings.hero_text | default: 'Experience extreme performance with our latest quantum-engineered components. Built for creators and professionals.' }}</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap">
        <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="cf-el-btn cf-el-btn-primary">{{ section.settings.btn1_text | default: 'Shop Components' }}</a>
        <a href="{{ section.settings.btn2_url | default: '/collections/all' }}" class="cf-el-btn cf-el-btn-outline">{{ section.settings.btn2_text | default: 'View Specs' }}</a>
      </div>
    </div>
  </section>

  {%- comment -%} SPECS GRID {%- endcomment -%}
  <div class="cf-el-specs">
    <div class="cf-el-spec">
      <div class="cf-el-spec-icon">⚡</div>
      <div class="cf-el-spec-title">Ultra Fast</div><div class="cf-el-spec-desc">Gen 4 Architecture</div>
    </div>
    <div class="cf-el-spec">
      <div class="cf-el-spec-icon">❄️</div>
      <div class="cf-el-spec-title">Cryo Cooling</div><div class="cf-el-spec-desc">Liquid Thermal System</div>
    </div>
    <div class="cf-el-spec">
      <div class="cf-el-spec-icon">🛡️</div>
      <div class="cf-el-spec-title">3-Year Warranty</div><div class="cf-el-spec-desc">Global Hardware Support</div>
    </div>
    <div class="cf-el-spec">
      <div class="cf-el-spec-icon">🎮</div>
      <div class="cf-el-spec-title">Ray Tracing</div><div class="cf-el-spec-desc">True Real-time Graphics</div>
    </div>
  </div>

  {%- comment -%} PRODUCTS {%- endcomment -%}
  <section class="cf-el-products">
    <div class="cf-el-section-head">
      <h2>{{ section.settings.prods_heading | default: 'Featured Hardware' }}</h2>
    </div>
    <div class="cf-el-grid">
      {% assign coll = section.settings.featured_collection %}
      {% if coll != blank and coll.products_count > 0 %}
        {% for p in coll.products limit: 4 %}
          <a href="{{ p.url }}" class="cf-el-card">
            <div class="cf-el-card-img">
              {% if p.featured_image %}<img src="{{ p.featured_image | img_url: '600x' }}" alt="{{ p.title }}">{% endif %}
              <div class="cf-el-card-badge">IN STOCK</div>
            </div>
            <div class="cf-el-card-title">{{ p.title }}</div>
            <div class="cf-el-card-price">{{ p.price | money }}</div>
            <button class="cf-el-card-btn">Add to Build</button>
          </a>
        {% endfor %}
      {% else %}
        {% assign tech_demo = 'Quantum RTX 5090,AeroCool Liquid CPU Cooler,HyperCore 64GB DDR5,Nova Pro Wireless Headset' | split: ',' %}
        {% for name in tech_demo %}
          <a href="/collections/all" class="cf-el-card">
            <div class="cf-el-card-img">
              <div style="width:80%;height:80%;background:#0B1120;border-radius:4px;box-shadow:0 0 20px rgba(0,0,0,1)"></div>
              <div class="cf-el-card-badge">IN STOCK</div>
            </div>
            <div class="cf-el-card-title">{{ name }}</div>
            <div class="cf-el-card-price">₹{{ forloop.index | times: 5000 | plus: 15999 }}</div>
            <button class="cf-el-card-btn">Add to Build</button>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </section>

</div>

{% schema %}
{
  "name": "CF Electronics Landing",
  "settings": [
    { "type": "color", "id": "color_accent", "label": "Neon Accent Color", "default": "#00F0FF" },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero Background Image" },
    { "type": "text", "id": "hero_badge", "label": "Badge Text", "default": "SYSTEM.ONLINE" },
    { "type": "text", "id": "hero_headline", "label": "Headline Line 1", "default": "Next-Gen" },
    { "type": "text", "id": "hero_subline", "label": "Headline Line 2 (Glow)", "default": "Hardware" },
    { "type": "textarea", "id": "hero_text", "label": "Hero Text" },
    { "type": "text", "id": "btn1_text", "label": "Primary Button Text", "default": "Shop Components" },
    { "type": "url", "id": "btn1_url", "label": "Primary Button Link" },
    { "type": "text", "id": "btn2_text", "label": "Secondary Button Text", "default": "View Specs" },
    { "type": "url", "id": "btn2_url", "label": "Secondary Button Link" },
    { "type": "header", "content": "Products" },
    { "type": "text", "id": "prods_heading", "label": "Products Heading", "default": "Featured Hardware" },
    { "type": "collection", "id": "featured_collection", "label": "Featured Collection" }
  ],
  "presets": [{ "name": "CF Electronics Landing" }]
}
{% endschema %}