{% comment %}
  ConvertFlow — Electronics Landing Page
  High-tech, dark mode, glowing accents, cyber aesthetic.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Inter:wght@400;500&display=swap');

  :root {
    --el-primary: {{ section.settings.color_primary | default: '#00F0FF' }};
    --el-bg: {{ section.settings.color_bg | default: '#030508' }};
    --el-surface: {{ section.settings.color_surface | default: '#0C121E' }};
    --el-border: rgba(0, 240, 255, 0.15);
    --el-text: {{ section.settings.color_text | default: '#FFFFFF' }};
    --el-text-dim: #8B9BB4;
    --el-font-heading: 'Rajdhani', sans-serif;
    --el-font-body: 'Inter', sans-serif;
  }

  .cf-el * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-el { font-family: var(--el-font-body); background: var(--el-bg); color: var(--el-text); line-height: 1.6; }
  .cf-el h1, .cf-el h2, .cf-el h3 { font-family: var(--el-font-heading); text-transform: uppercase; line-height: 1.1; }

  /* Buttons */
  .cf-el-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    background: transparent; color: var(--el-primary);
    border: 1px solid var(--el-primary);
    padding: 14px 32px; font-family: var(--el-font-heading); font-size: 16px; font-weight: 600; text-transform: uppercase;
    text-decoration: none; cursor: pointer;
    box-shadow: 0 0 10px rgba(0,240,255,0.1), inset 0 0 10px rgba(0,240,255,0.1);
    transition: all 0.3s ease; letter-spacing: 1px;
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
  }
  .cf-el-btn:hover { background: var(--el-primary); color: #000; box-shadow: 0 0 20px rgba(0,240,255,0.4); }

  /* Hero */
  .cf-el-hero { position: relative; padding: 120px 5%; min-height: 85vh; display: flex; align-items: center; overflow: hidden; }
  .cf-el-hero-glow { position: absolute; top: -20%; right: -10%; width: 600px; height: 600px; background: radial-gradient(circle, var(--el-primary) 0%, transparent 60%); opacity: 0.1; filter: blur(60px); z-index: 1; }
  .cf-el-hero-grid { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; position: relative; z-index: 2; align-items: center; }
  .cf-el-hero-tag { font-family: var(--el-font-heading); color: var(--el-primary); font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 4px; margin-bottom: 20px; display: inline-block; padding: 4px 12px; border: 1px solid var(--el-border); background: rgba(0,240,255,0.05); }
  .cf-el-hero h1 { font-size: clamp(48px, 6vw, 80px); margin-bottom: 24px; font-weight: 700; text-shadow: 0 0 20px rgba(0,240,255,0.2); }
  .cf-el-hero p { color: var(--el-text-dim); font-size: 18px; margin-bottom: 40px; max-width: 500px; }
  .cf-el-hero-img { position: relative; }
  .cf-el-hero-img::before { content: ''; position: absolute; inset: -20px; border: 1px solid var(--el-border); clip-path: polygon(20px 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%, 0 20px); z-index: 0; }
  .cf-el-hero-img img { position: relative; z-index: 1; width: 100%; height: auto; display: block; filter: drop-shadow(0 0 30px rgba(0,240,255,0.2)); }

  /* Spec Highlight */
  .cf-el-specs { background: var(--el-surface); padding: 80px 5%; border-top: 1px solid var(--el-border); border-bottom: 1px solid var(--el-border); }
  .cf-el-specs-inner { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; }
  .cf-el-spec { text-align: center; padding: 30px; border: 1px solid rgba(255,255,255,0.05); background: rgba(0,0,0,0.2); transition: all 0.3s; }
  .cf-el-spec:hover { border-color: var(--el-primary); box-shadow: 0 0 15px rgba(0,240,255,0.05); transform: translateY(-5px); }
  .cf-el-spec h3 { font-size: 32px; color: var(--el-primary); margin-bottom: 10px; }
  .cf-el-spec p { font-size: 14px; color: var(--el-text-dim); font-family: var(--el-font-heading); text-transform: uppercase; letter-spacing: 1px; }

  /* Feature Grid */
  .cf-el-feat { padding: 100px 5%; }
  .cf-el-section-head { text-align: center; margin-bottom: 60px; }
  .cf-el-section-head h2 { font-size: clamp(36px, 5vw, 56px); }
  .cf-el-section-head p { color: var(--el-primary); font-family: var(--el-font-heading); font-size: 16px; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 12px; }
  
  .cf-el-feat-grid { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
  .cf-el-feat-card { display: flex; flex-direction: column; background: var(--el-surface); border: 1px solid var(--el-border); position: relative; overflow: hidden; padding: 40px; text-decoration: none; color: var(--el-text); transition: all 0.3s; }
  .cf-el-feat-card:hover { border-color: var(--el-primary); box-shadow: inset 0 0 20px rgba(0,240,255,0.05); }
  .cf-el-feat-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 2px; background: linear-gradient(90deg, transparent, var(--el-primary), transparent); opacity: 0; transition: opacity 0.3s; }
  .cf-el-feat-card:hover::before { opacity: 1; }
  .cf-el-feat-img { height: 250px; display: flex; align-items: center; justify-content: center; margin-bottom: 30px; }
  .cf-el-feat-img img { max-height: 100%; object-fit: contain; filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5)); transition: transform 0.5s ease; }
  .cf-el-feat-card:hover .cf-el-feat-img img { transform: scale(1.05) translateY(-10px); }
  .cf-el-feat-card h3 { font-size: 28px; margin-bottom: 12px; }
  .cf-el-feat-card p { color: var(--el-text-dim); font-size: 15px; }

  /* New Arrivals Slider */
  .cf-el-arr { background: var(--el-surface); padding: 100px 0; border-top: 1px solid var(--el-border); overflow: hidden; }
  .cf-el-arr-track { display: flex; gap: 30px; padding: 0 5% 40px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .cf-el-arr-track::-webkit-scrollbar { display: none; }
  .cf-el-prod { flex: 0 0 clamp(280px, 25vw, 320px); scroll-snap-align: start; background: var(--el-bg); border: 1px solid var(--el-border); padding: 20px; text-decoration: none; transition: border-color 0.3s; position: relative; }
  .cf-el-prod:hover { border-color: var(--el-primary); }
  .cf-el-prod-img { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at center, #111a28 0%, #030508 100%); margin-bottom: 20px; }
  .cf-el-prod-img img { max-width: 80%; max-height: 80%; object-fit: contain; }
  .cf-el-prod-title { font-family: var(--el-font-heading); font-size: 20px; font-weight: 600; color: #fff; margin-bottom: 8px; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cf-el-prod-price { color: var(--el-primary); font-family: var(--el-font-heading); font-size: 22px; font-weight: 700; }
  .cf-el-prod-tag { position: absolute; top: 10px; right: 10px; font-family: var(--el-font-heading); font-size: 12px; font-weight: 600; color: var(--el-bg); background: var(--el-primary); padding: 2px 8px; text-transform: uppercase; }

  @media (max-width: 1024px) {
    .cf-el-hero-grid { grid-template-columns: 1fr; text-align: center; }
    .cf-el-hero-tag { margin: 0 auto 20px; }
    .cf-el-hero p { margin: 0 auto 40px; }
    .cf-el-specs-inner { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .cf-el-feat-grid { grid-template-columns: 1fr; }
  }
{% endstyle %}

<div class="cf-el">
  {% for block in section.blocks %}
    {% case block.type %}
      
      {% when 'hero' %}
        <section class="cf-el-hero">
          <div class="cf-el-hero-glow"></div>
          <div class="cf-el-hero-grid">
            <div>
              <div class="cf-el-hero-tag">{{ block.settings.tag | default: 'NEXT GEN ARCHITECTURE' }}</div>
              <h1>{{ block.settings.title | default: 'Quantum<br>Processing' }}</h1>
              <p>{{ block.settings.text | default: 'Experience unprecedented computational power with our latest silicon architecture.' }}</p>
              <a href="{{ block.settings.btn_url }}" class="cf-el-btn">{{ block.settings.btn_text | default: 'Explore Hardware' }}</a>
            </div>
            <div class="cf-el-hero-img">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | img_url: 'master' }}" alt="Tech Hero">
              {% else %}
                <div style="width:100%; padding-top:100%; background:rgba(0,240,255,0.05); border: 1px dashed var(--el-border);"></div>
              {% endif %}
            </div>
          </div>
        </section>

      {% when 'specs' %}
        <section class="cf-el-specs">
          <div class="cf-el-specs-inner">
            <div class="cf-el-spec">
              <h3>{{ block.settings.spec_1_val | default: '5.2 GHz' }}</h3>
              <p>{{ block.settings.spec_1_label | default: 'Max Clock Speed' }}</p>
            </div>
            <div class="cf-el-spec">
              <h3>{{ block.settings.spec_2_val | default: '24 GB' }}</h3>
              <p>{{ block.settings.spec_2_label | default: 'Unified Memory' }}</p>
            </div>
            <div class="cf-el-spec">
              <h3>{{ block.settings.spec_3_val | default: '8K' }}</h3>
              <p>{{ block.settings.spec_3_label | default: 'Resolution Support' }}</p>
            </div>
            <div class="cf-el-spec">
              <h3>{{ block.settings.spec_4_val | default: 'Wi-Fi 7' }}</h3>
              <p>{{ block.settings.spec_4_label | default: 'Connectivity' }}</p>
            </div>
          </div>
        </section>

      {% when 'features' %}
        <section class="cf-el-feat">
          <div class="cf-el-section-head">
            <p>{{ block.settings.subheading | default: 'ECOSYSTEM' }}</p>
            <h2>{{ block.settings.heading | default: 'Seamless Integration' }}</h2>
          </div>
          <div class="cf-el-feat-grid">
            <a href="#" class="cf-el-feat-card">
              <div class="cf-el-feat-img">
                {% if block.settings.img_1 %}
                  <img src="{{ block.settings.img_1 | img_url: '600x' }}" alt="Audio">
                {% else %}
                  <div style="width:150px; height:150px; background:rgba(0,240,255,0.05); border-radius:50%;"></div>
                {% endif %}
              </div>
              <h3>Spatial Audio</h3>
              <p>Immersive 360-degree sound engineering powered by AI algorithms.</p>
            </a>
            <a href="#" class="cf-el-feat-card">
              <div class="cf-el-feat-img">
                {% if block.settings.img_2 %}
                  <img src="{{ block.settings.img_2 | img_url: '600x' }}" alt="Display">
                {% else %}
                  <div style="width:200px; height:150px; background:rgba(0,240,255,0.05); border-radius:10px;"></div>
                {% endif %}
              </div>
              <h3>Neural Engine</h3>
              <p>Accelerate machine learning tasks with dedicated hardware cores.</p>
            </a>
          </div>
        </section>

      {% when 'products' %}
        <section class="cf-el-arr">
          <div class="cf-el-section-head">
            <p>LATEST HARDWARE</p>
            <h2>{{ block.settings.heading | default: 'New Releases' }}</h2>
          </div>
          <div class="cf-el-arr-track">
            {% assign collection = block.settings.collection %}
            {% if collection != blank and collection.products_count > 0 %}
              {% for product in collection.products limit: 6 %}
                <a href="{{ product.url }}" class="cf-el-prod">
                  <div class="cf-el-prod-tag">NEW</div>
                  <div class="cf-el-prod-img">
                    {% if product.featured_image %}
                      <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}">
                    {% endif %}
                  </div>
                  <div class="cf-el-prod-title">{{ product.title }}</div>
                  <div class="cf-el-prod-price">{{ product.price | money }}</div>
                </a>
              {% endfor %}
            {% else %}
              {% for i in (1..5) %}
                <a href="#" class="cf-el-prod">
                  <div class="cf-el-prod-tag">NEW</div>
                  <div class="cf-el-prod-img"><div style="width:100px; height:100px; background:rgba(255,255,255,0.1);"></div></div>
                  <div class="cf-el-prod-title">Cyber Deck Pro {{ i }}</div>
                  <div class="cf-el-prod-price">$1,299.00</div>
                </a>
              {% endfor %}
            {% endif %}
          </div>
        </section>

    {% endcase %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "CF Electronics Landing",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Primary Accent (Neon)", "default": "#00F0FF" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#030508" },
    { "type": "color", "id": "color_surface", "label": "Surface", "default": "#0C121E" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "hero",
      "name": "Hero Section",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "tag", "label": "Badge", "default": "NEXT GEN ARCHITECTURE" },
        { "type": "textarea", "id": "title", "label": "Headline", "default": "Quantum<br>Processing" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Experience unprecedented computational power." },
        { "type": "image_picker", "id": "image", "label": "Product Image" },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Explore Hardware" },
        { "type": "url", "id": "btn_url", "label": "Button Link" }
      ]
    },
    {
      "type": "specs",
      "name": "Specs Highlight",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "spec_1_val", "default": "5.2 GHz" },
        { "type": "text", "id": "spec_1_label", "default": "Max Clock" },
        { "type": "text", "id": "spec_2_val", "default": "24 GB" },
        { "type": "text", "id": "spec_2_label", "default": "Memory" },
        { "type": "text", "id": "spec_3_val", "default": "8K" },
        { "type": "text", "id": "spec_3_label", "default": "Display" },
        { "type": "text", "id": "spec_4_val", "default": "Wi-Fi 7" },
        { "type": "text", "id": "spec_4_label", "default": "Network" }
      ]
    },
    {
      "type": "features",
      "name": "Feature Grid",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Seamless Integration" },
        { "type": "image_picker", "id": "img_1", "label": "Feature 1 Image" },
        { "type": "image_picker", "id": "img_2", "label": "Feature 2 Image" }
      ]
    },
    {
      "type": "products",
      "name": "Product Slider",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "New Releases" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF Electronics Landing",
      "blocks": [
        { "type": "hero" },
        { "type": "specs" },
        { "type": "features" },
        { "type": "products" }
      ]
    }
  ]
}
{% endschema %}