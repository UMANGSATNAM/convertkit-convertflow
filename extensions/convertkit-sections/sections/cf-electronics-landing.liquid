      </ul>
    </div>
  </div>
  <div style="padding-top:20px;display:flex;justify-content:space-between;font-size:11px;color:#555">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
    <span>Powered by ConvertFlow</span>
  </div>
</footer>
