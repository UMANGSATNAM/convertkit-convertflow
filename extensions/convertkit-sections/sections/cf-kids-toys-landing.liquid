{% comment %} ConvertFlow — Kids Toys Landing | Always-Visible Playful Layout {% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Fredoka+One&family=Varela+Round&display=swap');
  .cf-kids*{box-sizing:border-box;margin:0;padding:0}
  .cf-kids{font-family:'Varela Round',sans-serif;background:#F0F8FF;color:#333;overflow-x:hidden}

  :root{
    --kids-red:{{ section.settings.color_red | default: '#FF4D4D' }};
    --kids-blue:{{ section.settings.color_blue | default: '#4D94FF' }};
    --kids-yellow:{{ section.settings.color_yellow | default: '#FFD11A' }};
  }

  /* ═══ HERO ═══ */
  .cf-kids-hero{position:relative;background:var(--kids-blue);padding:80px 5% 150px;text-align:center;color:#fff}
  .cf-kids-hero-bg{position:absolute;inset:0;opacity:.1;background-image:radial-gradient(circle at 20px 20px, #ffffff 2px, transparent 0);background-size:40px 40px}
  .cf-kids-hero-inner{position:relative;z-index:2;max-width:900px;margin:0 auto}
  .cf-kids-badge{display:inline-block;background:var(--kids-yellow);color:#333;font-family:'Fredoka One',cursive;font-size:16px;padding:8px 20px;border-radius:30px;transform:rotate(-3deg);margin-bottom:24px;box-shadow:0 4px 0px rgba(0,0,0,.1)}
  .cf-kids-h1{font-family:'Fredoka One',cursive;font-size:clamp(48px,8vw,80px);line-height:1.1;margin-bottom:24px;text-shadow:4px 4px 0px rgba(0,0,0,.15)}
  .cf-kids-p{font-size:20px;font-weight:600;margin-bottom:40px;opacity:.9}
  .cf-kids-btn{display:inline-block;background:var(--kids-red);color:#fff;font-family:'Fredoka One',cursive;font-size:24px;padding:16px 48px;border-radius:50px;text-decoration:none;box-shadow:0 8px 0px #CC0000;transition:all .2s;text-transform:uppercase;letter-spacing:1px}
  .cf-kids-btn:hover{transform:translateY(4px);box-shadow:0 4px 0px #CC0000}
  .cf-kids-btn:active{transform:translateY(8px);box-shadow:0 0px 0px #CC0000}

  .cf-kids-wave{position:absolute;bottom:0;left:0;width:100%;height:80px;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 1200 120' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V95.8C59.71,118.08,130.83,119.56,193,101.44Z' fill='%23F0F8FF'/%3E%3C/svg%3E");background-size:cover;background-position:center;z-index:3}

  /* ═══ AGE CATEGORIES ═══ */
  .cf-kids-ages{padding:60px 5%;text-align:center}
  .cf-kids-head{font-family:'Fredoka One',cursive;font-size:clamp(36px,5vw,48px);color:#333;margin-bottom:40px}
  .cf-kids-age-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;max-width:1200px;margin:0 auto}
  .cf-kids-age-card{background:#fff;border-radius:30px;padding:40px 20px;text-decoration:none;color:#333;box-shadow:0 10px 20px rgba(0,0,0,.05);border:4px solid transparent;transition:all .3s}
  .cf-kids-age-card:nth-child(1){border-color:var(--kids-red)}
  .cf-kids-age-card:nth-child(2){border-color:var(--kids-yellow)}
  .cf-kids-age-card:nth-child(3){border-color:var(--kids-blue)}
  .cf-kids-age-card:nth-child(4){border-color:#4CAF50}
  .cf-kids-age-card:hover{transform:translateY(-10px);box-shadow:0 15px 30px rgba(0,0,0,.1)}
  .cf-kids-age-icon{font-size:64px;margin-bottom:16px}
  .cf-kids-age-title{font-family:'Fredoka One',cursive;font-size:24px}

  /* ═══ PRODUCTS ═══ */
  .cf-kids-products{padding:80px 5%;background:#fff}
  .cf-kids-prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:30px;max-width:1400px;margin:0 auto}
  .cf-kids-card{background:#F0F8FF;border-radius:24px;padding:20px;text-decoration:none;color:#333;position:relative;border:4px solid transparent;transition:all .3s}
  .cf-kids-card:hover{border-color:var(--kids-yellow);transform:rotate(2deg)}
  .cf-kids-card-img{aspect-ratio:1;background:#fff;border-radius:16px;margin-bottom:20px;display:flex;align-items:center;justify-content:center;padding:16px}
  .cf-kids-card-img img{max-width:100%;max-height:100%;object-fit:contain}
  .cf-kids-card-title{font-family:'Fredoka One',cursive;font-size:20px;margin-bottom:8px;line-height:1.2}
  .cf-kids-card-price{font-size:24px;font-weight:700;color:var(--kids-red)}

  @media(max-width:900px){
    .cf-kids-age-grid{grid-template-columns:repeat(2,1fr)}
    .cf-kids-prod-grid{grid-template-columns:repeat(2,1fr)}
  }
{% endstyle %}

<div class="cf-kids">
  <section class="cf-kids-hero">
    <div class="cf-kids-hero-bg"></div>
    <div class="cf-kids-hero-inner">
      <div class="cf-kids-badge">{{ section.settings.badge | default: '🎈 Fun Awaits!' }}</div>
      <h1 class="cf-kids-h1">{{ section.settings.headline | default: 'Play, Learn & Grow' }}</h1>
      <p class="cf-kids-p">{{ section.settings.subhead | default: 'Discover toys that spark imagination and bring endless joy.' }}</p>
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="cf-kids-btn">{{ section.settings.btn_text | default: 'Shop Toys!' }}</a>
    </div>
    <div class="cf-kids-wave"></div>
  </section>

  <section class="cf-kids-ages">
    <h2 class="cf-kids-head">{{ section.settings.age_heading | default: 'Shop by Age' }}</h2>
    <div class="cf-kids-age-grid">
      <a href="#" class="cf-kids-age-card">
        <div class="cf-kids-age-icon">🍼</div>
        <div class="cf-kids-age-title">0-2 Years</div>
      </a>
      <a href="#" class="cf-kids-age-card">
        <div class="cf-kids-age-icon">🧸</div>
        <div class="cf-kids-age-title">3-5 Years</div>
      </a>
      <a href="#" class="cf-kids-age-card">
        <div class="cf-kids-age-icon">🧩</div>
        <div class="cf-kids-age-title">6-8 Years</div>
      </a>
      <a href="#" class="cf-kids-age-card">
        <div class="cf-kids-age-icon">🚀</div>
        <div class="cf-kids-age-title">9+ Years</div>
      </a>
    </div>
  </section>

  <section class="cf-kids-products">
    <div style="text-align:center">
      <h2 class="cf-kids-head">{{ section.settings.prods_heading | default: 'Most Loved Toys' }}</h2>
    </div>
    <div class="cf-kids-prod-grid">
      {% assign coll = section.settings.featured_collection %}
      {% if coll != blank and coll.products_count > 0 %}
        {% for p in coll.products limit: 4 %}
          <a href="{{ p.url }}" class="cf-kids-card">
            <div class="cf-kids-card-img">
              {% if p.featured_image %}<img src="{{ p.featured_image | img_url: '400x' }}" alt="{{ p.title }}">{% endif %}
            </div>
            <div class="cf-kids-card-title">{{ p.title }}</div>
            <div class="cf-kids-card-price">{{ p.price | money }}</div>
          </a>
        {% endfor %}
      {% else %}
        {% assign kids_demo = 'Magic Building Blocks,Talking Teddy Bear,Speed Racing Track,Astronaut Helmet' | split: ',' %}
        {% for name in kids_demo %}
          <a href="/collections/all" class="cf-kids-card">
            <div class="cf-kids-card-img">
              <div style="width:70%;height:70%;background:#FFD11A;border-radius:50%"></div>
            </div>
            <div class="cf-kids-card-title">{{ name }}</div>
            <div class="cf-kids-card-price">₹{{ forloop.index | times: 300 | plus: 599 }}</div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "CF Kids Toys Landing",
  "settings": [
    { "type": "color", "id": "color_red", "label": "Red", "default": "#FF4D4D" },
    { "type": "color", "id": "color_blue", "label": "Blue", "default": "#4D94FF" },
    { "type": "color", "id": "color_yellow", "label": "Yellow", "default": "#FFD11A" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "🎈 Fun Awaits!" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Play, Learn & Grow" },
    { "type": "text", "id": "subhead", "label": "Subheadline", "default": "Discover toys that spark imagination." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Shop Toys!" },
    { "type": "url", "id": "btn_url", "label": "Button Link" },
    { "type": "text", "id": "age_heading", "label": "Age Heading", "default": "Shop by Age" },
    { "type": "text", "id": "prods_heading", "label": "Products Heading", "default": "Most Loved Toys" },
    { "type": "collection", "id": "featured_collection", "label": "Featured Collection" }
  ],
  "presets": [{ "name": "CF Kids Toys Landing" }]
}
{% endschema %}