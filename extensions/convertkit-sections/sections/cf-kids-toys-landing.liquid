{% comment %}ConvertFlow - Kids Toys Landing | PLAYBOX style{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
<style>
.cfkt{--y:#F9C22E;--b:#2D6BE4;--r:#E83A3A;--t:#1ABFA1;--bg:#FFFEF8;--text:#1A1A2E;--mu:#6B6B80;--bd:#EAE8F0;}
.cfkt *{box-sizing:border-box;margin:0;padding:0;}
.cfkt{background:var(--bg);color:var(--text);font-family:'Nunito',sans-serif;font-size:15px;-webkit-font-smoothing:antialiased;}
.cfkt h1,.cfkt h2,.cfkt h3{font-family:'Baloo 2',cursive;}
.cfkt-top{background:var(--y);color:#000;text-align:center;padding:10px;font-size:13px;font-weight:700;letter-spacing:.5px;}
.cfkt-hdr{padding:16px 60px;background:#fff;display:flex;align-items:center;justify-content:space-between;border-bottom:3px solid var(--y);box-shadow:0 2px 20px rgba(0,0,0,.04);}
.cfkt-brand{font-family:'Baloo 2',cursive;font-size:30px;font-weight:800;color:var(--b);text-decoration:none;}
.cfkt-nav{display:flex;gap:28px;list-style:none;}
.cfkt-nav a{font-size:14px;font-weight:700;color:var(--text);text-decoration:none;transition:color .2s;}
.cfkt-nav a:hover{color:var(--b);}
.cfkt-hbtn{background:var(--b);color:#fff;padding:12px 24px;border-radius:100px;font-family:'Baloo 2',cursive;font-size:14px;font-weight:700;text-decoration:none;transition:opacity .2s;}
.cfkt-hbtn:hover{opacity:.88;}
.cfkt-hero{background:linear-gradient(135deg,#EEF4FF 0%,#FFF8E8 100%);display:grid;grid-template-columns:1fr 1fr;min-height:88vh;padding:0 60px;align-items:center;gap:60px;overflow:hidden;position:relative;}
.cfkt-hero::before{content:'';position:absolute;top:-60px;right:-60px;width:300px;height:300px;border-radius:50%;background:rgba(249,194,46,.15);}
.cfkt-badge{display:inline-flex;align-items:center;gap:8px;background:var(--y);color:#000;padding:6px 16px;border-radius:100px;font-size:12px;font-weight:800;letter-spacing:.5px;margin-bottom:20px;}
.cfkt-hero h1{font-size:64px;font-weight:800;line-height:1.1;margin-bottom:20px;}
.cfkt-hero h1 span{color:var(--b);}
.cfkt-hero>div>p{font-size:17px;color:var(--mu);line-height:1.8;max-width:440px;margin-bottom:36px;}
.cfkt-btns{display:flex;gap:12px;}
.cfkt-btn-blue{background:var(--b);color:#fff;padding:16px 40px;border-radius:100px;font-family:'Baloo 2',cursive;font-size:16px;font-weight:700;text-decoration:none;transition:all .2s;box-shadow:0 6px 20px rgba(45,107,228,.3);}
.cfkt-btn-blue:hover{transform:translateY(-2px);}
.cfkt-btn-out{background:transparent;color:var(--b);border:2px solid var(--b);padding:14px 40px;border-radius:100px;font-family:'Baloo 2',cursive;font-size:16px;font-weight:700;text-decoration:none;transition:all .2s;}
.cfkt-btn-out:hover{background:var(--b);color:#fff;}
.cfkt-blob{width:100%;max-width:460px;aspect-ratio:1;border-radius:40% 60% 60% 40%/60% 40% 60% 40%;background:linear-gradient(135deg,#FFE8A3,#FFD166);display:flex;align-items:center;justify-content:center;animation:cfkt-blob 6s ease-in-out infinite;margin:auto;}
@keyframes cfkt-blob{0%,100%{border-radius:40% 60% 60% 40%/60% 40% 60% 40%}50%{border-radius:60% 40% 40% 60%/40% 60% 40% 60%}}
.cfkt-age-badges{display:flex;gap:8px;margin-top:32px;}
.cfkt-ab{padding:6px 16px;border-radius:100px;font-size:12px;font-weight:800;}
.cfkt-ab1{background:#FFE8E8;color:#E83A3A;}
.cfkt-ab2{background:#E8F0FF;color:#2D6BE4;}
.cfkt-ab3{background:#E8FAF7;color:#1ABFA1;}
.cfkt-cats{padding:70px 60px;max-width:1400px;margin:0 auto;}
.cfkt-sh{text-align:center;margin-bottom:50px;}
.cfkt-sh h2{font-size:44px;font-weight:800;}
.cfkt-sh p{font-size:16px;color:var(--mu);margin-top:8px;}
.cfkt-cat-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;}
.cfkt-cat{border-radius:24px;padding:28px 20px;text-align:center;text-decoration:none;color:var(--text);transition:all .3s;}
.cfkt-cat:hover{transform:translateY(-6px);}
.cfkt-cat:nth-child(1){background:#FFF0E0;}
.cfkt-cat:nth-child(2){background:#E8F0FF;}
.cfkt-cat:nth-child(3){background:#E8FAF7;}
.cfkt-cat:nth-child(4){background:#FFF0F0;}
.cfkt-cat:nth-child(5){background:#F0EAFF;}
.cfkt-cat-name{font-family:'Baloo 2',cursive;font-size:16px;font-weight:700;margin-bottom:4px;}
.cfkt-cat-count{font-size:12px;color:var(--mu);}
.cfkt-prods{padding:0 60px 80px;max-width:1400px;margin:0 auto;}
.cfkt-ph{display:flex;justify-content:space-between;align-items:center;margin-bottom:40px;}
.cfkt-ph h2{font-size:40px;font-weight:800;}
.cfkt-ph a{font-size:13px;font-weight:700;color:var(--b);text-decoration:none;}
.cfkt-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}
.cfkt-card{background:#fff;border-radius:24px;overflow:hidden;border:2px solid var(--bd);transition:all .3s;}
.cfkt-card:hover{border-color:var(--y);box-shadow:0 12px 40px rgba(0,0,0,.07);transform:translateY(-4px);}
.cfkt-pc-img{aspect-ratio:1;display:flex;align-items:center;justify-content:center;position:relative;}
.cfkt-pc-age{position:absolute;top:14px;left:14px;background:var(--y);color:#000;padding:5px 12px;border-radius:100px;font-size:9px;font-weight:800;letter-spacing:1px;}
.cfkt-pc-body{padding:20px;}
.cfkt-pc-type{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--b);margin-bottom:6px;}
.cfkt-pc-name{font-family:'Baloo 2',cursive;font-size:17px;font-weight:700;margin-bottom:14px;line-height:1.3;}
.cfkt-pc-foot{display:flex;justify-content:space-between;align-items:center;}
.cfkt-pc-price{font-size:20px;font-weight:800;}
.cfkt-pc-old{font-size:13px;color:var(--mu);text-decoration:line-through;margin-left:6px;}
.cfkt-btn-add{background:var(--b);color:#fff;border:none;padding:10px 18px;border-radius:100px;font-family:'Nunito',sans-serif;font-size:12px;font-weight:700;cursor:pointer;transition:all .2s;}
.cfkt-btn-add:hover{background:#1d54c4;}
.cfkt-safety{background:var(--b);padding:70px 60px;display:flex;align-items:center;justify-content:center;gap:80px;flex-wrap:wrap;}
.cfkt-si{display:flex;flex-direction:column;align-items:center;gap:12px;color:#fff;text-align:center;}
.cfkt-si-icon{width:60px;height:60px;border-radius:50%;border:2px solid rgba(255,255,255,.3);display:flex;align-items:center;justify-content:center;}
.cfkt-si strong{font-family:'Baloo 2',cursive;font-size:16px;}
.cfkt-si span{font-size:12px;color:rgba(255,255,255,.6);max-width:120px;}
.cfkt-footer{background:var(--text);padding:80px 60px 40px;}
.cfkt-fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;padding-bottom:60px;border-bottom:1px solid rgba(255,255,255,.08);}
.cfkt-fb a{font-family:'Baloo 2',cursive;font-size:26px;font-weight:800;color:var(--y);text-decoration:none;display:block;margin-bottom:16px;}
.cfkt-fb p{font-size:13px;color:rgba(255,255,255,.4);line-height:1.9;max-width:260px;}
.cfkt-fc h4{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.4);margin-bottom:20px;}
.cfkt-fc ul{list-style:none;}
.cfkt-fc li{margin-bottom:10px;}
.cfkt-fc a{color:rgba(255,255,255,.5);text-decoration:none;font-size:14px;transition:color .2s;}
.cfkt-fc a:hover{color:var(--y);}
.cfkt-fbot{display:flex;justify-content:space-between;padding-top:28px;font-size:11px;color:rgba(255,255,255,.2);letter-spacing:1px;}
@media(max-width:1024px){.cfkt-hero{grid-template-columns:1fr;min-height:auto;padding:80px 40px}.cfkt-blob{display:none}.cfkt-cat-grid{grid-template-columns:repeat(3,1fr)}.cfkt-grid{grid-template-columns:repeat(2,1fr)}.cfkt-fg{grid-template-columns:1fr 1fr}}
@media(max-width:768px){.cfkt-hdr{padding:16px 20px}.cfkt-nav{display:none}.cfkt-hero{padding:60px 20px}.cfkt-hero h1{font-size:44px}.cfkt-cats,.cfkt-prods{padding:60px 20px}.cfkt-cat-grid{grid-template-columns:repeat(2,1fr)}.cfkt-safety{gap:40px;padding:60px 20px}.cfkt-fg{grid-template-columns:1fr;gap:40px}.cfkt-footer{padding:60px 20px 30px}}
</style>
<div class="cfkt">
  <div class="cfkt-top">🎁 {{ section.settings.promo_text | default: 'Free gift-wrapping on all orders! Use code GIFTED at checkout.' }}</div>
  <header class="cfkt-hdr">
    <a href="{{ routes.root_url }}" class="cfkt-brand">{{ section.settings.brand_name | default: 'PLAYBOX' }}</a>
    <ul class="cfkt-nav"><li><a href="#">Toys</a></li><li><a href="#">Learning</a></li><li><a href="#">Outdoor</a></li><li><a href="#">Arts &amp; Crafts</a></li><li><a href="#">Gift Sets</a></li></ul>
    <a href="{{ routes.cart_url }}" class="cfkt-hbtn">🛒 Cart ({{ cart.item_count }})</a>
  </header>
  <section class="cfkt-hero">
    <div>
      <div class="cfkt-badge">⭐ {{ section.settings.hero_badge | default: '4.9 — Trusted by 1L+ Families' }}</div>
      <h1>{{ section.settings.hero_h1 | default: 'Play. <span>Learn.</span> Grow Together.' }}</h1>
      <p>{{ section.settings.hero_sub | default: 'Award-winning educational toys and games that spark curiosity, develop skills, and create lifelong memories. BIS-certified and BPA-free.' }}</p>
      <div class="cfkt-btns">
        <a href="{{ section.settings.cta1_url | default: routes.collections_url }}" class="cfkt-btn-blue">{{ section.settings.cta1_text | default: 'Shop by Age' }}</a>
        <a href="{{ section.settings.cta2_url | default: '#' }}" class="cfkt-btn-out">{{ section.settings.cta2_text | default: 'Gift Guide →' }}</a>
      </div>
      <div class="cfkt-age-badges"><span class="cfkt-ab cfkt-ab1">0–2 Years</span><span class="cfkt-ab cfkt-ab2">3–6 Years</span><span class="cfkt-ab cfkt-ab3">7–12 Years</span></div>
    </div>
    <div class="cfkt-blob"><svg fill="none" stroke="#2D6BE4" viewBox="0 0 24 24" stroke-width="1.5" width="55%" opacity="0.5"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg></div>
  </section>
  <section class="cfkt-cats">
    <div class="cfkt-sh"><h2>Shop by Category</h2><p>Curated for every age, interest, and milestone.</p></div>
    <div class="cfkt-cat-grid">
      <a href="#" class="cfkt-cat"><div class="cfkt-cat-name">Building &amp; STEM</div><div class="cfkt-cat-count">120+ toys</div></a>
      <a href="#" class="cfkt-cat"><div class="cfkt-cat-name">Board Games</div><div class="cfkt-cat-count">80+ games</div></a>
      <a href="#" class="cfkt-cat"><div class="cfkt-cat-name">Outdoor Play</div><div class="cfkt-cat-count">60+ items</div></a>
      <a href="#" class="cfkt-cat"><div class="cfkt-cat-name">Arts &amp; Crafts</div><div class="cfkt-cat-count">95+ kits</div></a>
      <a href="#" class="cfkt-cat"><div class="cfkt-cat-name">Gift Sets</div><div class="cfkt-cat-count">45+ sets</div></a>
    </div>
  </section>
  <section class="cfkt-prods">
    <div class="cfkt-ph"><h2>🔥 Trending Picks</h2><a href="{{ routes.collections_url }}">See all →</a></div>
    <div class="cfkt-grid">
      {% assign col = collections[section.settings.featured_collection] %}
      {% if col and col.products.size > 0 %}
        {% for p in col.products limit: 4 %}
          <div class="cfkt-card">
            <div class="cfkt-pc-img" style="background:#FFF0E0;">
              <span class="cfkt-pc-age">Ages 3+</span>
              {% if p.featured_image %}<img src="{{ p.featured_image | img_url: '400x' }}" alt="{{ p.title }}" style="width:80%;object-fit:contain;">{% endif %}
            </div>
            <div class="cfkt-pc-body">
              <div class="cfkt-pc-type">{{ p.type | default: 'Educational Toy' }}</div>
              <div class="cfkt-pc-name">{{ p.title }}</div>
              <div class="cfkt-pc-foot"><div class="cfkt-pc-price">{{ p.price | money }}{% if p.compare_at_price > p.price %}<span class="cfkt-pc-old">{{ p.compare_at_price | money }}</span>{% endif %}</div><button class="cfkt-btn-add" data-variant-id="{{ p.variants.first.id }}">Add to Cart</button></div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="cfkt-card"><div class="cfkt-pc-img" style="background:#FFF0E0;"><span class="cfkt-pc-age">Ages 5–10</span><svg fill="none" stroke="#E07B2A" viewBox="0 0 24 24" stroke-width="1.5" width="40%" opacity="0.6"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg></div><div class="cfkt-pc-body"><div class="cfkt-pc-type">STEM Toys</div><div class="cfkt-pc-name">GearBot Jr. Robot Builder Kit</div><div class="cfkt-pc-foot"><div class="cfkt-pc-price">&#8377;1,299<span class="cfkt-pc-old">&#8377;1,699</span></div><button class="cfkt-btn-add">Add to Cart</button></div></div></div>
        <div class="cfkt-card"><div class="cfkt-pc-img" style="background:#E8F0FF;"><span class="cfkt-pc-age">Ages 3–8</span><svg fill="none" stroke="#2D6BE4" viewBox="0 0 24 24" stroke-width="1.5" width="40%" opacity="0.6"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v7a2 2 0 01-2 2H7a2 2 0 01-2-2v-7"/></svg></div><div class="cfkt-pc-body"><div class="cfkt-pc-type">Board Games</div><div class="cfkt-pc-name">Colour &amp; Shape Family Game</div><div class="cfkt-pc-foot"><div class="cfkt-pc-price">&#8377;899</div><button class="cfkt-btn-add">Add to Cart</button></div></div></div>
        <div class="cfkt-card"><div class="cfkt-pc-img" style="background:#E8FAF7;"><span class="cfkt-pc-age">Ages 2–5</span><svg fill="none" stroke="#1ABFA1" viewBox="0 0 24 24" stroke-width="1.5" width="40%" opacity="0.6"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg></div><div class="cfkt-pc-body"><div class="cfkt-pc-type">Soft Toys</div><div class="cfkt-pc-name">Cuddly Zoo Animal Set (6pc)</div><div class="cfkt-pc-foot"><div class="cfkt-pc-price">&#8377;1,499<span class="cfkt-pc-old">&#8377;1,799</span></div><button class="cfkt-btn-add">Add to Cart</button></div></div></div>
        <div class="cfkt-card"><div class="cfkt-pc-img" style="background:#FFF0F0;"><span class="cfkt-pc-age">Ages 6–12</span><svg fill="none" stroke="#E83A3A" viewBox="0 0 24 24" stroke-width="1.5" width="40%" opacity="0.6"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg></div><div class="cfkt-pc-body"><div class="cfkt-pc-type">Arts &amp; Crafts</div><div class="cfkt-pc-name">SuperArtist Deluxe Kit (180pc)</div><div class="cfkt-pc-foot"><div class="cfkt-pc-price">&#8377;2,199</div><button class="cfkt-btn-add">Add to Cart</button></div></div></div>
      {% endif %}
    </div>
  </section>
  <div class="cfkt-safety">
    <div class="cfkt-si"><div class="cfkt-si-icon"><svg fill="none" stroke="#fff" viewBox="0 0 24 24" width="28" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg></div><strong>BIS Certified</strong><span>All toys meet Indian safety standards</span></div>
    <div class="cfkt-si"><div class="cfkt-si-icon"><svg fill="none" stroke="#fff" viewBox="0 0 24 24" width="28" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg></div><strong>BPA-Free</strong><span>Non-toxic, child-friendly materials</span></div>
    <div class="cfkt-si"><div class="cfkt-si-icon"><svg fill="none" stroke="#fff" viewBox="0 0 24 24" width="28" stroke-width="1.5"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66L7 19.7c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5"/></svg></div><strong>Eco-Friendly</strong><span>Sustainable &amp; recycled materials</span></div>
    <div class="cfkt-si"><div class="cfkt-si-icon"><svg fill="none" stroke="#fff" viewBox="0 0 24 24" width="28" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div><strong>Free Delivery</strong><span>On all orders above &#8377;499</span></div>
  </div>
  <footer class="cfkt-footer">
    <div class="cfkt-fg">
      <div class="cfkt-fb"><a href="{{ routes.root_url }}">{{ section.settings.brand_name | default: 'PLAYBOX' }} 🎲</a><p>Making childhood magical through play that educates, inspires, and connects families.</p></div>
      <div class="cfkt-fc"><h4>Shop</h4><ul><li><a href="#">0-2 Years</a></li><li><a href="#">3-6 Years</a></li><li><a href="#">7-12 Years</a></li><li><a href="#">Gift Sets</a></li></ul></div>
      <div class="cfkt-fc"><h4>Learn</h4><ul><li><a href="#">Blog</a></li><li><a href="#">Age Guide</a></li><li><a href="#">Reviews</a></li></ul></div>
      <div class="cfkt-fc"><h4>Support</h4><ul><li><a href="#">FAQ</a></li><li><a href="#">Returns</a></li><li><a href="#">Shipping</a></li><li><a href="#">Contact</a></li></ul></div>
    </div>
    <div class="cfkt-fbot"><span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'Playbox' }}.</span><span>Privacy &middot; Terms</span></div>
  </footer>
</div>
{% schema %}
{
  "name": "Kids Toys Landing",
  "settings": [
    {"type":"text","id":"promo_text","label":"Promo Bar","default":"Free gift-wrapping on all orders! Use code GIFTED at checkout."},
    {"type":"text","id":"brand_name","label":"Brand Name","default":"PLAYBOX"},
    {"type":"text","id":"hero_badge","label":"Hero Badge","default":"4.9 — Trusted by 1L+ Families"},
    {"type":"textarea","id":"hero_h1","label":"Hero Heading","default":"Play. Learn. Grow Together."},
    {"type":"textarea","id":"hero_sub","label":"Hero Subtext","default":"Award-winning educational toys and games that spark curiosity and develop skills."},
    {"type":"text","id":"cta1_text","label":"CTA 1 Text","default":"Shop by Age"},
    {"type":"url","id":"cta1_url","label":"CTA 1 URL"},
    {"type":"text","id":"cta2_text","label":"CTA 2 Text","default":"Gift Guide →"},
    {"type":"url","id":"cta2_url","label":"CTA 2 URL"},
    {"type":"collection","id":"featured_collection","label":"Featured Collection"}
  ],
  "presets": [{"name":"Kids Toys Landing"}]
}
{% endschema %}