{% comment %}
  ConvertFlow — Fashion Clothing Collection Page
  Clean, elegant grid layout.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

  :root {
    --fc-primary: {{ section.settings.color_primary | default: '#0A0A0A' }};
    --fc-bg: {{ section.settings.color_bg | default: '#F5F3EF' }};
    --fc-surface: {{ section.settings.color_surface | default: '#FFFFFF' }};
    --fc-text: {{ section.settings.color_text | default: '#1a1a1a' }};
    --fc-border: rgba(0, 0, 0, 0.08);
    --fc-font-heading: 'Playfair Display', serif;
    --fc-font-body: 'Inter', sans-serif;
  }

  .cf-fc-c * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-fc-c { font-family: var(--fc-font-body); background: var(--fc-surface); color: var(--fc-text); }
  
  .cf-fc-c-head { text-align: center; padding: 80px 5%; background: var(--fc-bg); }
  .cf-fc-c-head h1 { font-family: var(--fc-font-heading); font-size: clamp(40px, 5vw, 64px); font-weight: 400; margin-bottom: 16px; }
  .cf-fc-c-head p { color: #666; font-size: 15px; max-width: 500px; margin: 0 auto; }
  
  .cf-fc-c-main { max-width: 1400px; margin: 0 auto; padding: 60px 5%; }
  
  .cf-fc-c-tools { display: flex; justify-content: space-between; margin-bottom: 40px; border-bottom: 1px solid var(--fc-border); padding-bottom: 20px; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; color: #555; }
  .cf-fc-c-filters span { margin-right: 20px; cursor: pointer; transition: color 0.2s; }
  .cf-fc-c-filters span:hover, .cf-fc-c-filters span.active { color: var(--fc-primary); font-weight: 500; }
  .cf-fc-c-sort select { border: none; background: transparent; font-family: inherit; font-size: 13px; text-transform: uppercase; color: var(--fc-text); outline: none; cursor: pointer; }
  
  .cf-fc-c-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .cf-fc-prod { text-decoration: none; color: var(--fc-text); group; }
  .cf-fc-prod-img { aspect-ratio: 3/4; background: #e0dcd3; margin-bottom: 20px; position: relative; overflow: hidden; }
  .cf-fc-prod-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s ease; }
  .cf-fc-prod:hover .cf-fc-prod-img img { transform: scale(1.05); }
  
  .cf-fc-prod-info { text-align: center; }
  .cf-fc-prod-title { font-size: 15px; font-weight: 500; margin-bottom: 6px; letter-spacing: 0.5px; }
  .cf-fc-prod-price { font-size: 14px; color: #666; }

  @media(max-width: 900px) {
    .cf-fc-c-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .cf-fc-c-tools { flex-direction: column; gap: 20px; align-items: center; }
  }
{% endstyle %}

<div class="cf-fc-c">
  <div class="cf-fc-c-head">
    <h1>{{ collection.title | default: 'New Arrivals' }}</h1>
    {% if collection.description != blank %}
      <p>{{ collection.description | strip_html | truncate: 150 }}</p>
    {% endif %}
  </div>
  
  <div class="cf-fc-c-main">
    <div class="cf-fc-c-tools">
      <div class="cf-fc-c-filters">
        <span class="active">All</span>
        <span>Dresses</span>
        <span>Tops</span>
        <span>Outerwear</span>
      </div>
      <div class="cf-fc-c-sort">
        <select>
          <option>Sort By: Recommended</option>
          <option>Price: Low to High</option>
          <option>Price: High to Low</option>
        </select>
      </div>
    </div>
    
    <div class="cf-fc-c-grid">
      {% if collection.products.size > 0 %}
        {% for product in collection.products %}
          <a href="{{ product.url }}" class="cf-fc-prod">
            <div class="cf-fc-prod-img">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title }}">
              {% endif %}
            </div>
            <div class="cf-fc-prod-info">
              <div class="cf-fc-prod-title">{{ product.title }}</div>
              <div class="cf-fc-prod-price">{{ product.price | money }}</div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..6) %}
          <a href="#" class="cf-fc-prod">
            <div class="cf-fc-prod-img"></div>
            <div class="cf-fc-prod-info">
              <div class="cf-fc-prod-title">Essential Silk Top</div>
              <div class="cf-fc-prod-price">$120.00</div>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CF Fashion Collection",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Primary Color", "default": "#0A0A0A" },
    { "type": "color", "id": "color_bg", "label": "Background Color", "default": "#F5F3EF" },
    { "type": "color", "id": "color_surface", "label": "Surface Color", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text Color", "default": "#1a1a1a" }
  ],
  "presets": [
    { "name": "CF Fashion Collection" }
  ]
}
{% endschema %}