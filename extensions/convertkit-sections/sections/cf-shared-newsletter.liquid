// sections/cf-shared-newsletter.liquid
// Newsletter / Email CTA Section

<style>
.cf-nl-sec { padding: 80px 60px; text-align: center; }
.cf-nl-sec h2 { font-size: 36px; font-weight: 800; margin: 0 0 12px; }
.cf-nl-sec p { font-size: 15px; opacity: .85; margin: 0 0 36px; max-width: 500px; margin-left: auto; margin-right: auto; }
.cf-nl-form { display: flex; max-width: 480px; margin: 0 auto; box-shadow: 0 4px 20px rgba(0,0,0,.15); }
.cf-nl-input { flex: 1; padding: 16px 20px; border: none; font-size: 14px; outline: none; font-family: inherit; }
.cf-nl-btn { padding: 16px 28px; background: #1a1a1a; color: #fff; border: none; font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit; transition: opacity .2s; white-space: nowrap; }
.cf-nl-btn:hover { opacity: .85; }
.cf-nl-note { font-size: 11px; margin-top: 12px; opacity: .6; }
@media(max-width:768px) { .cf-nl-sec { padding: 50px 20px; } .cf-nl-form { flex-direction: column; } .cf-nl-btn { padding: 14px; } }
</style>

{% if section.settings.show_section %}
<div class="cf-nl-sec" style="background:{{ section.settings.bg_color | default: '#000' }};color:{{ section.settings.text_color | default: '#fff' }}">
  <h2>{{ section.settings.heading | default: 'Join Our Community' }}</h2>
  <p>{{ section.settings.subtext | default: 'Subscribe for exclusive offers, new arrivals and insider updates.' }}</p>
  {% form 'customer', id: 'cf-nl-form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="cf-nl-form">
      <input class="cf-nl-input" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}" required>
      <button class="cf-nl-btn" type="submit">{{ section.settings.button_text | default: 'Subscribe' }}</button>
    </div>
    {% if form.posted_successfully? %}
      <p style="margin-top:16px;color:#4ade80;font-weight:600">Thank you for subscribing!</p>
    {% endif %}
  {% endform %}
  <p class="cf-nl-note">{{ section.settings.note | default: 'No spam. Unsubscribe anytime.' }}</p>
</div>
{% endif %}

{% schema %}
{
  "name": "CF Newsletter",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show Newsletter Section", "default": true },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#1a1a1a" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join Our Community" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Subscribe for exclusive offers, new arrivals and insider updates." },
    { "type": "text", "id": "placeholder", "label": "Email Placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Subscribe" },
    { "type": "text", "id": "note", "label": "Fine Print", "default": "No spam. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "CF Newsletter" }]
}
{% endschema %}
