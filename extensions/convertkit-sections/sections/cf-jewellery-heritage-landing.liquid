{% comment %}
  ConvertFlow — Jewellery Heritage Landing Page
  Luxury, elegant, serif typography, and gold accents.
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Lato:wght@300;400;700&display=swap');

  :root {
    --jh-primary: {{ section.settings.color_primary | default: '#D4AF37' }}; /* Gold */
    --jh-bg: {{ section.settings.color_bg | default: '#FFFFFF' }};
    --jh-surface: {{ section.settings.color_surface | default: '#FAFAFA' }};
    --jh-border: rgba(212, 175, 55, 0.3);
    --jh-text: {{ section.settings.color_text | default: '#222222' }};
    --jh-font-heading: 'Playfair Display', serif;
    --jh-font-body: 'Lato', sans-serif;
  }

  .cf-jh * { box-sizing: border-box; margin: 0; padding: 0; }
  .cf-jh { font-family: var(--jh-font-body); background: var(--jh-bg); color: var(--jh-text); line-height: 1.6; }
  .cf-jh h1, .cf-jh h2, .cf-jh h3 { font-family: var(--jh-font-heading); font-weight: 400; color: var(--jh-text); }

  /* Buttons */
  .cf-jh-btn {
    display: inline-block; padding: 14px 40px;
    background: transparent; color: var(--jh-text);
    border: 1px solid var(--jh-primary);
    font-size: 12px; font-weight: 400; text-transform: uppercase; letter-spacing: 2px;
    text-decoration: none; transition: all 0.4s ease;
  }
  .cf-jh-btn:hover { background: var(--jh-primary); color: #fff; }

  /* Hero */
  .cf-jh-hero { position: relative; height: 90vh; display: flex; align-items: center; justify-content: center; text-align: center; }
  .cf-jh-hero-img { position: absolute; inset: 0; }
  .cf-jh-hero-img img { width: 100%; height: 100%; object-fit: cover; }
  .cf-jh-hero-img::after { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,0.3); }
  .cf-jh-hero-content { position: relative; z-index: 2; padding: 40px; border: 1px solid rgba(255,255,255,0.4); background: rgba(255,255,255,0.1); backdrop-filter: blur(5px); color: #fff; max-width: 600px; }
  .cf-jh-hero-sub { font-size: 13px; text-transform: uppercase; letter-spacing: 3px; margin-bottom: 20px; font-family: var(--jh-font-body); }
  .cf-jh-hero-title { font-size: clamp(48px, 6vw, 72px); line-height: 1.1; margin-bottom: 30px; color: #fff; font-style: italic; }
  
  .cf-jh-hero-btn { display: inline-block; padding: 16px 40px; background: #fff; color: #000; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; text-decoration: none; transition: all 0.4s ease; }
  .cf-jh-hero-btn:hover { background: var(--jh-primary); color: #fff; }

  /* Feature Band */
  .cf-jh-band { display: flex; justify-content: space-around; padding: 40px 5%; background: var(--jh-surface); border-bottom: 1px solid var(--jh-border); text-align: center; flex-wrap: wrap; gap: 20px; }
  .cf-jh-band-item { display: flex; flex-direction: column; align-items: center; }
  .cf-jh-band-icon { color: var(--jh-primary); margin-bottom: 12px; }
  .cf-jh-band-text { font-family: var(--jh-font-heading); font-size: 16px; font-weight: 600; color: var(--jh-text); }

  /* Categories Masonry */
  .cf-jh-cats { padding: 100px 5%; max-width: 1400px; margin: 0 auto; }
  .cf-jh-section-title { text-align: center; margin-bottom: 60px; }
  .cf-jh-section-title h2 { font-size: 48px; position: relative; display: inline-block; padding-bottom: 15px; }
  .cf-jh-section-title h2::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 60px; height: 1px; background: var(--jh-primary); }

  .cf-jh-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .cf-jh-cat { position: relative; overflow: hidden; text-decoration: none; color: #fff; display: block; aspect-ratio: 4/5; }
  .cf-jh-cat:nth-child(1) { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; }
  .cf-jh-cat img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s ease; }
  .cf-jh-cat::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.6), transparent); }
  .cf-jh-cat:hover img { transform: scale(1.05); }
  .cf-jh-cat-content { position: absolute; bottom: 30px; left: 30px; z-index: 2; }
  .cf-jh-cat-title { font-family: var(--jh-font-heading); font-size: 32px; font-weight: 400; margin-bottom: 8px; }
  .cf-jh-cat-link { font-size: 12px; text-transform: uppercase; letter-spacing: 2px; border-bottom: 1px solid var(--jh-primary); padding-bottom: 4px; }

  /* Featured Slider */
  .cf-jh-featured { padding: 100px 0; background: var(--jh-surface); }
  .cf-jh-slider { display: flex; gap: 30px; overflow-x: auto; padding: 0 5% 40px; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .cf-jh-slider::-webkit-scrollbar { display: none; }
  .cf-jh-slide { flex: 0 0 clamp(280px, 25vw, 320px); scroll-snap-align: start; text-decoration: none; color: var(--jh-text); text-align: center; }
  .cf-jh-slide-img { aspect-ratio: 1; background: #fff; border: 1px solid #eaeaea; margin-bottom: 20px; overflow: hidden; display: flex; align-items: center; justify-content: center; padding: 20px; }
  .cf-jh-slide-img img { max-width: 100%; max-height: 100%; object-fit: contain; transition: transform 0.6s ease; }
  .cf-jh-slide:hover .cf-jh-slide-img img { transform: scale(1.08); }
  .cf-jh-slide-title { font-family: var(--jh-font-heading); font-size: 18px; margin-bottom: 8px; }
  .cf-jh-slide-price { font-size: 15px; color: #666; font-family: var(--jh-font-body); }

  @media (max-width: 900px) {
    .cf-jh-grid { grid-template-columns: 1fr; }
    .cf-jh-cat:nth-child(1) { grid-column: span 1; grid-row: span 1; aspect-ratio: 4/5; }
    .cf-jh-hero-content { margin: 0 20px; padding: 30px 20px; }
  }
{% endstyle %}

<div class="cf-jh">
  {% for block in section.blocks %}
    {% case block.type %}
      
      {% when 'hero' %}
        <section class="cf-jh-hero">
          <div class="cf-jh-hero-img">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: 'master' }}" alt="Heritage Hero">
            {% else %}
              <div style="width:100%; height:100%; background:#e8e4db;"></div>
            {% endif %}
          </div>
          <div class="cf-jh-hero-content">
            <div class="cf-jh-hero-sub">{{ block.settings.tag | default: 'The Wedding Edit' }}</div>
            <h1 class="cf-jh-hero-title">{{ block.settings.title | default: 'Elegance Redefined' }}</h1>
            <a href="{{ block.settings.btn_url }}" class="cf-jh-hero-btn">{{ block.settings.btn_text | default: 'Explore Collection' }}</a>
          </div>
        </section>

      {% when 'trust' %}
        <section class="cf-jh-band">
          <div class="cf-jh-band-item">
            <div class="cf-jh-band-icon"><svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path d="M12 2l3 6 6 1-4.5 4.5 1.5 6-6-3.5L6 19.5l1.5-6L3 9l6-1 3-6z"/></svg></div>
            <div class="cf-jh-band-text">Lifetime Warranty</div>
          </div>
          <div class="cf-jh-band-item">
            <div class="cf-jh-band-icon"><svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg></div>
            <div class="cf-jh-band-text">Secure Shipping</div>
          </div>
          <div class="cf-jh-band-item">
            <div class="cf-jh-band-icon"><svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg></div>
            <div class="cf-jh-band-text">Certified Diamonds</div>
          </div>
        </section>

      {% when 'categories' %}
        <section class="cf-jh-cats">
          <div class="cf-jh-section-title">
            <h2>{{ block.settings.heading | default: 'Curated Categories' }}</h2>
          </div>
          <div class="cf-jh-grid">
            <a href="#" class="cf-jh-cat">
              <div style="background:#d4c4b7; position:absolute; inset:0;"></div>
              <div class="cf-jh-cat-content">
                <div class="cf-jh-cat-title">Bridal Sets</div>
                <span class="cf-jh-cat-link">Discover</span>
              </div>
            </a>
            <a href="#" class="cf-jh-cat">
              <div style="background:#b7c4d4; position:absolute; inset:0;"></div>
              <div class="cf-jh-cat-content">
                <div class="cf-jh-cat-title">Earrings</div>
                <span class="cf-jh-cat-link">Discover</span>
              </div>
            </a>
            <a href="#" class="cf-jh-cat">
              <div style="background:#c4b7d4; position:absolute; inset:0;"></div>
              <div class="cf-jh-cat-content">
                <div class="cf-jh-cat-title">Necklaces</div>
                <span class="cf-jh-cat-link">Discover</span>
              </div>
            </a>
          </div>
        </section>

      {% when 'products' %}
        <section class="cf-jh-featured">
          <div class="cf-jh-section-title">
            <h2>{{ block.settings.heading | default: 'Signature Pieces' }}</h2>
          </div>
          <div class="cf-jh-slider">
            {% assign collection = block.settings.collection %}
            {% if collection != blank and collection.products_count > 0 %}
              {% for product in collection.products limit: 6 %}
                <a href="{{ product.url }}" class="cf-jh-slide">
                  <div class="cf-jh-slide-img">
                    {% if product.featured_image %}
                      <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}">
                    {% endif %}
                  </div>
                  <div class="cf-jh-slide-title">{{ product.title }}</div>
                  <div class="cf-jh-slide-price">{{ product.price | money }}</div>
                </a>
              {% endfor %}
            {% else %}
              {% for i in (1..5) %}
                <a href="#" class="cf-jh-slide">
                  <div class="cf-jh-slide-img"><div style="width:50%; height:50%; background:#f5f5f5; border-radius:50%;"></div></div>
                  <div class="cf-jh-slide-title">Heritage Ring 0{{ i }}</div>
                  <div class="cf-jh-slide-price">$1,200.00</div>
                </a>
              {% endfor %}
            {% endif %}
          </div>
        </section>

    {% endcase %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "CF Jewellery Landing",
  "settings": [
    { "type": "color", "id": "color_primary", "label": "Gold Accent", "default": "#D4AF37" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_surface", "label": "Surface", "default": "#FAFAFA" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#222222" }
  ],
  "blocks": [
    {
      "type": "hero",
      "name": "Hero Section",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "tag", "label": "Subheading", "default": "The Wedding Edit" },
        { "type": "textarea", "id": "title", "label": "Headline", "default": "Elegance Redefined" },
        { "type": "image_picker", "id": "image", "label": "Background Image" },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Explore Collection" },
        { "type": "url", "id": "btn_url", "label": "Button Link" }
      ]
    },
    {
      "type": "trust",
      "name": "Trust Band",
      "limit": 1
    },
    {
      "type": "categories",
      "name": "Categories Masonry",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Curated Categories" }
      ]
    },
    {
      "type": "products",
      "name": "Featured Products",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Signature Pieces" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF Jewellery Landing",
      "blocks": [
        { "type": "hero" },
        { "type": "trust" },
        { "type": "categories" },
        { "type": "products" }
      ]
    }
  ]
}
{% endschema %}