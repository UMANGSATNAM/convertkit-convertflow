{% comment %} ConvertFlow — Jewellery Heritage Landing | Always-Visible Luxury Layout {% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Cardo:ital,wght@0,400;0,700;1,400&display=swap');
  .cf-jh*{box-sizing:border-box;margin:0;padding:0}
  .cf-jh{font-family:'Cardo',serif;background:#FFFDFC;color:#2C1E16;overflow-x:hidden}

  /* ═══ GLOBALS ═══ */
  :root{--jh-gold:{{ section.settings.color_accent | default: '#CFB53B' }}; --jh-burgundy:#800020;}

  /* ═══ HERO ═══ */
  .cf-jh-hero{position:relative;min-height:90vh;display:flex;align-items:center;justify-content:center;padding:5%;text-align:center;border-bottom:8px solid var(--jh-gold)}
  .cf-jh-hero-bg{position:absolute;inset:0}
  .cf-jh-hero-bg img{width:100%;height:100%;object-fit:cover;opacity:.8}
  .cf-jh-hero-bg::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(44,30,22,.8) 0%,rgba(44,30,22,.3) 100%)}
  .cf-jh-hero-inner{position:relative;z-index:2;color:#FFFDFC;max-width:800px;border:1px solid rgba(207,181,59,.4);padding:60px 40px;background:rgba(44,30,22,.4);backdrop-filter:blur(4px)}
  
  .cf-jh-sub{font-size:14px;letter-spacing:4px;text-transform:uppercase;color:var(--jh-gold);margin-bottom:20px;display:flex;align-items:center;justify-content:center;gap:12px}
  .cf-jh-sub::before,.cf-jh-sub::after{content:'';width:40px;height:1px;background:var(--jh-gold)}
  
  .cf-jh-h1{font-family:'Cinzel Decorative',serif;font-size:clamp(40px,6vw,72px);font-weight:400;line-height:1.1;margin-bottom:24px}
  .cf-jh-p{font-size:18px;font-style:italic;color:#E5E4E2;margin-bottom:40px;line-height:1.6}
  
  .cf-jh-btn{display:inline-block;padding:16px 40px;font-family:'Cinzel Decorative',serif;font-size:14px;letter-spacing:3px;text-transform:uppercase;text-decoration:none;transition:all .4s;border:1px solid var(--jh-gold)}
  .cf-jh-btn-primary{background:var(--jh-gold);color:#2C1E16}
  .cf-jh-btn-primary:hover{background:transparent;color:var(--jh-gold)}

  /* ═══ TRUST STRIP ═══ */
  .cf-jh-trust{background:#2C1E16;color:var(--jh-gold);padding:30px 5%;display:flex;justify-content:space-around;flex-wrap:wrap;gap:20px;text-align:center}
  .cf-jh-trust-item{font-size:12px;letter-spacing:3px;text-transform:uppercase;display:flex;flex-direction:column;align-items:center;gap:12px}
  .cf-jh-trust-icon{font-size:24px}

  /* ═══ COLLECTIONS MASONRY ═══ */
  .cf-jh-colls{padding:100px 5%}
  .cf-jh-head{text-align:center;margin-bottom:60px}
  .cf-jh-head h2{font-family:'Cinzel Decorative',serif;font-size:clamp(32px,4vw,48px);color:var(--jh-burgundy);margin-bottom:16px}
  .cf-jh-grid{display:grid;grid-template-columns:1fr 1fr;gap:2px;background:var(--jh-gold)}
  .cf-jh-cat{position:relative;background:#FFFDFC;overflow:hidden;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center}
  .cf-jh-cat:first-child{grid-column:span 2;aspect-ratio:21/9}
  .cf-jh-cat img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1s;opacity:.9}
  .cf-jh-cat:hover img{transform:scale(1.05)}
  .cf-jh-cat::after{content:'';position:absolute;inset:0;background:rgba(44,30,22,.4)}
  .cf-jh-cat-content{position:relative;z-index:2;text-align:center;color:#FFFDFC;border:1px solid rgba(255,253,252,.3);padding:40px;width:80%;max-width:400px;background:rgba(44,30,22,.2)}
  .cf-jh-cat-title{font-family:'Cinzel Decorative',serif;font-size:32px;margin-bottom:12px}
  .cf-jh-cat-link{font-size:12px;letter-spacing:3px;text-transform:uppercase;color:var(--jh-gold);text-decoration:none;border-bottom:1px solid var(--jh-gold);padding-bottom:4px}

  /* ═══ PRODUCTS ═══ */
  .cf-jh-products{padding:100px 5%;background:#FDFBF7}
  .cf-jh-prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:40px}
  .cf-jh-card{text-decoration:none;color:#2C1E16;text-align:center;display:block}
  .cf-jh-card-img{aspect-ratio:1;background:#fff;padding:20px;position:relative;border:1px solid #EAE3D9;transition:all .4s;margin-bottom:24px}
  .cf-jh-card-img::before{content:'';position:absolute;inset:10px;border:1px dashed #EAE3D9;opacity:0;transition:opacity .4s}
  .cf-jh-card:hover .cf-jh-card-img{border-color:var(--jh-gold)}
  .cf-jh-card:hover .cf-jh-card-img::before{opacity:1;border-color:var(--jh-gold)}
  .cf-jh-card-img img{width:100%;height:100%;object-fit:contain;transition:transform .6s}
  .cf-jh-card:hover .cf-jh-card-img img{transform:scale(1.08)}
  .cf-jh-card-title{font-family:'Cinzel Decorative',serif;font-size:18px;margin-bottom:8px}
  .cf-jh-card-price{font-size:16px;color:var(--jh-burgundy)}

  @media(max-width:900px){
    .cf-jh-grid{grid-template-columns:1fr}
    .cf-jh-cat:first-child{grid-column:span 1;aspect-ratio:4/3}
    .cf-jh-prod-grid{grid-template-columns:repeat(2,1fr);gap:20px}
    .cf-jh-hero-inner{padding:40px 20px}
  }
{% endstyle %}

<div class="cf-jh">

  {%- comment -%} HERO {%- endcomment -%}
  <section class="cf-jh-hero">
    <div class="cf-jh-hero-bg">
      {% if section.settings.hero_image != blank %}
        <img src="{{ section.settings.hero_image | img_url: 'master' }}" alt="Jewellery Hero">
      {% else %}
        <img src="https://images.unsplash.com/photo-1515562141207-7a8efd18d4df?w=1600&auto=format&fit=crop" alt="">
      {% endif %}
    </div>
    <div class="cf-jh-hero-inner">
      <div class="cf-jh-sub">{{ section.settings.hero_sub | default: 'Est. 1924' }}</div>
      <h1 class="cf-jh-h1">{{ section.settings.hero_headline | default: 'The Royal Bridal Collection' }}</h1>
      <p class="cf-jh-p">{{ section.settings.hero_text | default: 'Handcrafted masterpieces that transcend time, designed for the modern royalty.' }}</p>
      <a href="{{ section.settings.hero_btn_url | default: '/collections/all' }}" class="cf-jh-btn cf-jh-btn-primary">{{ section.settings.hero_btn_text | default: 'Discover the Collection' }}</a>
    </div>
  </section>

  {%- comment -%} TRUST STRIP {%- endcomment -%}
  <div class="cf-jh-trust">
    <div class="cf-jh-trust-item"><span class="cf-jh-trust-icon">✧</span> 100% Certified Diamonds</div>
    <div class="cf-jh-trust-item"><span class="cf-jh-trust-icon">✧</span> Lifetime Exchange</div>
    <div class="cf-jh-trust-item"><span class="cf-jh-trust-icon">✧</span> Insured Secure Shipping</div>
    <div class="cf-jh-trust-item"><span class="cf-jh-trust-icon">✧</span> BIS Hallmarked Gold</div>
  </div>

  {%- comment -%} COLLECTIONS {%- endcomment -%}
  <section class="cf-jh-colls">
    <div class="cf-jh-head">
      <div class="cf-jh-sub" style="color:var(--jh-burgundy);justify-content:center">Curated For You</div>
      <h2>{{ section.settings.coll_heading | default: 'Shop By Category' }}</h2>
    </div>
    <div class="cf-jh-grid">
      <a href="/collections/bridal" class="cf-jh-cat">
        <img src="https://images.unsplash.com/photo-1599643478514-4a11b63cc84e?w=1200&auto=format&fit=crop" alt="">
        <div class="cf-jh-cat-content">
          <div class="cf-jh-cat-title">The Bridal Edit</div>
          <div class="cf-jh-cat-link">Explore →</div>
        </div>
      </a>
      <a href="/collections/necklaces" class="cf-jh-cat">
        <img src="https://images.unsplash.com/photo-1599643477877-530eb83abc8e?w=800&auto=format&fit=crop" alt="">
        <div class="cf-jh-cat-content">
          <div class="cf-jh-cat-title">Necklaces</div>
          <div class="cf-jh-cat-link">Explore →</div>
        </div>
      </a>
      <a href="/collections/rings" class="cf-jh-cat">
        <img src="https://images.unsplash.com/photo-1605100804763-247f679f4178?w=800&auto=format&fit=crop" alt="">
        <div class="cf-jh-cat-content">
          <div class="cf-jh-cat-title">Rings</div>
          <div class="cf-jh-cat-link">Explore →</div>
        </div>
      </a>
    </div>
  </section>

  {%- comment -%} PRODUCTS {%- endcomment -%}
  <section class="cf-jh-products">
    <div class="cf-jh-head">
      <div class="cf-jh-sub" style="color:var(--jh-burgundy);justify-content:center">Heritage Pieces</div>
      <h2>{{ section.settings.prods_heading | default: 'Bestselling Masterpieces' }}</h2>
    </div>
    <div class="cf-jh-prod-grid">
      {% assign coll = section.settings.featured_collection %}
      {% if coll != blank and coll.products_count > 0 %}
        {% for p in coll.products limit: 4 %}
          <a href="{{ p.url }}" class="cf-jh-card">
            <div class="cf-jh-card-img">
              {% if p.featured_image %}<img src="{{ p.featured_image | img_url: '600x' }}" alt="{{ p.title }}">{% endif %}
            </div>
            <div class="cf-jh-card-title">{{ p.title }}</div>
            <div class="cf-jh-card-price">{{ p.price | money }}</div>
          </a>
        {% endfor %}
      {% else %}
        {% assign jh_demo = '22k Gold Temple Necklace,Polki Diamond Choker,Emerald & Gold Bangles,Solitaire Platinum Ring' | split: ',' %}
        {% for name in jh_demo %}
          <a href="/collections/all" class="cf-jh-card">
            <div class="cf-jh-card-img">
              <div style="width:60%;height:60%;margin:20%;background:#FDFBF7;border-radius:50%;box-shadow:inset 0 0 20px rgba(0,0,0,.05)"></div>
            </div>
            <div class="cf-jh-card-title">{{ name }}</div>
            <div class="cf-jh-card-price">₹{{ forloop.index | times: 25000 | plus: 150000 }}</div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </section>

</div>

{% schema %}
{
  "name": "CF Jewellery Landing",
  "settings": [
    { "type": "color", "id": "color_accent", "label": "Gold Accent Color", "default": "#CFB53B" },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero Image" },
    { "type": "text", "id": "hero_sub", "label": "Eyebrow Text", "default": "Est. 1924" },
    { "type": "text", "id": "hero_headline", "label": "Headline", "default": "The Royal Bridal Collection" },
    { "type": "textarea", "id": "hero_text", "label": "Text" },
    { "type": "text", "id": "hero_btn_text", "label": "Button Text", "default": "Discover the Collection" },
    { "type": "url", "id": "hero_btn_url", "label": "Button Link" },
    { "type": "header", "content": "Collections Grid" },
    { "type": "text", "id": "coll_heading", "label": "Heading", "default": "Shop By Category" },
    { "type": "header", "content": "Products" },
    { "type": "text", "id": "prods_heading", "label": "Products Heading", "default": "Bestselling Masterpieces" },
    { "type": "collection", "id": "featured_collection", "label": "Featured Collection" }
  ],
  "presets": [{ "name": "CF Jewellery Landing" }]
}
{% endschema %}