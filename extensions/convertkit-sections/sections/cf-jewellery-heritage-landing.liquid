    <a data-href="#">Earrings</a>
    <a data-href="#">Bangles & Kadas</a>
    <a data-href="#">Bridal Sets</a>
    <a data-href="#">Men's</a>
    <a data-href="#">Our Story</a>
  </nav>
</header>

<section class="hero">
  <div class="hero-left">
    <div class="hero-frame"></div>
