{% comment %}ConvertFlow — PureBody Personal Care · Cart Page{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">
<style>
:root{--cf-accent:{{ section.settings.color_accent | default: '#B8956A' }};--cf-bg:{{ section.settings.color_bg | default: '#FDFAF6' }};--cf-dark:#1A1710;}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
body{font-family:'DM Sans',sans-serif;background:var(--cf-bg);color:var(--cf-dark);-webkit-font-smoothing:antialiased}
.cfc-wrap{max-width:1200px;margin:0 auto;padding:60px;display:grid;grid-template-columns:1fr 380px;gap:60px;align-items:start}
.cfc-title{font-family:'Cormorant Garamond',serif;font-size:42px;font-weight:300;letter-spacing:1px;margin-bottom:32px;color:var(--cf-dark);font-style:italic}
.cfc-empty{text-align:center;padding:80px 20px;color:#888}
.cfc-empty p{font-family:'Cormorant Garamond',serif;font-size:22px;font-style:italic;margin-bottom:8px}
.cfc-empty a{display:inline-block;margin-top:24px;background:var(--cf-dark);color:#fff;padding:14px 36px;font-size:13px;font-weight:500;letter-spacing:2px;text-transform:uppercase;text-decoration:none}
.cfc-items{display:flex;flex-direction:column;background:#fff;border:1px solid #e8ddd2}
.cfc-item{display:grid;grid-template-columns:90px 1fr auto;gap:20px;padding:24px;align-items:center;border-bottom:1px solid #f5ede4}
.cfc-item:last-child{border-bottom:none}
.cfc-item-img{width:90px;height:90px;background:#f5ede4;overflow:hidden}
.cfc-item-img img{width:100%;height:100%;object-fit:cover}
.cfc-item-vendor{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--cf-accent);margin-bottom:4px}
.cfc-item-name{font-family:'Cormorant Garamond',serif;font-size:16px;font-weight:400;margin-bottom:4px}
.cfc-item-props{font-size:12px;color:#999;margin-bottom:12px}
.cfc-item-qty{display:flex;align-items:center;gap:12px}
.cfc-item-qty button{width:28px;height:28px;border:1px solid #e8ddd2;background:#fff;font-size:16px;cursor:pointer;color:var(--cf-dark)}
.cfc-item-qty span{font-size:14px;font-weight:500;min-width:20px;text-align:center}
.cfc-item-remove{font-size:11px;color:#bbb;text-decoration:underline;cursor:pointer}
.cfc-item-remove:hover{color:#e53e3e}
.cfc-item-price{font-size:17px;font-weight:500;white-space:nowrap}
.cfc-summary{background:#fff;border:1px solid #e8ddd2;padding:32px;position:sticky;top:24px}
.cfc-summary h2{font-family:'Cormorant Garamond',serif;font-size:26px;font-weight:400;font-style:italic;margin-bottom:24px}
.cfc-row{display:flex;justify-content:space-between;font-size:14px;color:#888;margin-bottom:12px}
.cfc-row.total{font-size:17px;font-weight:600;color:var(--cf-dark);padding-top:16px;margin-top:8px;border-top:1px solid #e8ddd2}
.cfc-promo{display:flex;border:1px solid #e8ddd2;overflow:hidden;margin:20px 0}
.cfc-promo input{flex:1;border:none;padding:12px 16px;font-size:13px;outline:none;font-family:inherit;background:#fdfaf6;color:var(--cf-dark)}
.cfc-promo button{background:var(--cf-accent);color:#fff;border:none;padding:12px 20px;font-size:11px;font-weight:600;letter-spacing:1px;text-transform:uppercase;cursor:pointer}
.cfc-checkout{display:block;width:100%;background:var(--cf-dark);color:#fff;border:none;padding:17px;font-size:12px;font-weight:500;letter-spacing:3px;text-transform:uppercase;cursor:pointer;text-align:center;transition:opacity .2s;text-decoration:none;font-family:inherit}
.cfc-checkout:hover{opacity:.85}
.cfc-trust{display:flex;flex-direction:column;gap:8px;margin-top:20px}
.cfc-trust-i{display:flex;align-items:center;gap:8px;font-size:11px;color:#aaa}
.cfc-trust-i svg{flex-shrink:0;color:var(--cf-accent)}
@media(max-width:1024px){.cfc-wrap{grid-template-columns:1fr;padding:30px 20px;gap:30px}}
</style>

<div class="cfc-wrap">
  <div>
    <h1 class="cfc-title">Your Cart ({{ cart.item_count }})</h1>
    {% if cart.item_count == 0 %}
      <div class="cfc-empty">
        <p>Your cart is empty</p>
        <span>Discover our curated skincare collection.</span>
        <a href="/collections/all">Explore Products</a>
      </div>
    {% else %}
      <div class="cfc-items">
        {% for item in cart.items %}
          <div class="cfc-item">
            <div class="cfc-item-img">
              {% if item.image %}<img src="{{ item.image | image_url: width: 180 }}" alt="{{ item.title }}">{% endif %}
            </div>
            <div>
              <div class="cfc-item-vendor">{{ item.vendor }}</div>
              <div class="cfc-item-name">{{ item.product_title }}</div>
              <div class="cfc-item-props">{{ item.variant_title }}</div>
              <div class="cfc-item-qty">
                <button>−</button><span>{{ item.quantity }}</span><button>+</button>
                <span class="cfc-item-remove">Remove</span>
              </div>
            </div>
            <div class="cfc-item-price">{{ item.final_line_price | money }}</div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
  <div class="cfc-summary">
    <h2>Order Summary</h2>
    <div class="cfc-row"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
    <div class="cfc-row"><span>Shipping</span><span>Calculated at checkout</span></div>
    {% if cart.total_discount > 0 %}<div class="cfc-row" style="color:#16A34A"><span>Discount</span><span>−{{ cart.total_discount | money }}</span></div>{% endif %}
    <div class="cfc-row total"><span>Total</span><span>{{ cart.total_price | money }}</span></div>
    <div class="cfc-promo"><input type="text" placeholder="Discount code"><button>Apply</button></div>
    <a href="/checkout" class="cfc-checkout">{{ section.settings.checkout_text }}</a>
    {% if section.settings.show_trust %}
    <div class="cfc-trust">
      <div class="cfc-trust-i"><svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>{{ section.settings.trust_1 }}</div>
      <div class="cfc-trust-i"><svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>{{ section.settings.trust_2 }}</div>
      <div class="cfc-trust-i"><svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>{{ section.settings.trust_3 }}</div>
    </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "CF PureBody Cart",
  "settings": [
    {"type":"header","content":"Brand Colors"},
    {"type":"color","id":"color_accent","label":"Accent Color","default":"#B8956A"},
    {"type":"color","id":"color_bg","label":"Background","default":"#FDFAF6"},
    {"type":"header","content":"Cart Settings"},
    {"type":"text","id":"checkout_text","label":"Checkout Button Text","default":"Secure Checkout"},
    {"type":"header","content":"Trust Signals"},
    {"type":"checkbox","id":"show_trust","label":"Show Trust Badges","default":true},
    {"type":"text","id":"trust_1","label":"Trust Badge 1","default":"Secure SSL Checkout"},
    {"type":"text","id":"trust_2","label":"Trust Badge 2","default":"Clean Ingredient Guarantee"},
    {"type":"text","id":"trust_3","label":"Trust Badge 3","default":"Free Returns within 30 Days"}
  ],
  "presets":[{"name":"CF PureBody Cart"}]
}
{% endschema %}
