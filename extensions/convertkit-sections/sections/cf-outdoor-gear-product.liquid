<div class="cfp-wrap">
  <div class="cfp-gallery">
    <div class="cfp-main-img" id="cfpMainImg">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title }}" id="cfpMainImgEl">
