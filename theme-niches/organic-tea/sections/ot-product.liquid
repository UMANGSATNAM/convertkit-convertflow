<div style="padding:48px 20px 80px;background:var(--ot-paper)"><div style="max-width:1320px;margin:0 auto">
  <nav style="font-size:13px;color:var(--ot-muted);font-family:'Lora',serif;margin-bottom:32px" aria-label="Breadcrumb"><a href="/" style="color:var(--ot-muted)">Home</a> / <a href="{{ product.collections.first.url }}" style="color:var(--ot-muted)">{{ product.collections.first.title }}</a> / <span style="color:var(--ot-dark)">{{ product.title }}</span></nav>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start">
    <div data-gallery>
      <div style="border-radius:8px;overflow:hidden;background:#fff;border:1px solid var(--ot-border);aspect-ratio:1;margin-bottom:12px;cursor:zoom-in"><img id="MainProductImg" data-main-img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" style="width:100%;height:100%;object-fit:cover"></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">{%- for img in product.images limit: 6 -%}<div data-thumb data-src="{{ img | image_url: width: 900 }}" style="width:72px;height:72px;border-radius:4px;overflow:hidden;cursor:pointer;border:2px solid {% if forloop.first %}var(--ot-matcha){% else %}transparent{% endif %};transition:border-color .2s"><img src="{{ img | image_url: width: 144 }}" alt="" width="72" height="72" style="width:100%;height:100%;object-fit:cover"></div>{%- endfor -%}</div>
    </div>
    <div>
      <span class="ot-eyebrow" style="margin-bottom:8px">{{ product.vendor }}</span>
      <h1 style="font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:400;color:var(--ot-dark);margin-bottom:12px">{{ product.title }}</h1>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px"><span style="color:var(--ot-sage);font-size:15px;letter-spacing:2px">★★★★★</span><span style="font-size:13px;color:var(--ot-muted)">({{ product.metafields.reviews.rating_count | default: '144' }} bowls)</span></div>
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--ot-border)">
        <span style="font-size:28px;font-weight:600;color:var(--ot-dark)" data-price>{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}<span style="font-size:18px;color:var(--ot-muted);text-decoration:line-through" data-compare-price>{{ product.compare_at_price | money }}</span>{%- endif -%}
      </div>
      <!-- Tea Details Grid -->
      <div style="display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap"><span style="padding:6px 14px;background:#fff;border:1px solid var(--ot-border);border-radius:8px;font-size:12px;font-weight:600;color:var(--ot-dark)">Uji shade-grown</span><span style="padding:6px 14px;background:#fff;border:1px solid var(--ot-border);border-radius:8px;font-size:12px;font-weight:600;color:var(--ot-dark)">Granite ground</span><span style="padding:6px 14px;background:#fff;border:1px solid var(--ot-border);border-radius:8px;font-size:12px;font-weight:600;color:var(--ot-dark)">Organic Certified</span></div>
      <form action="{{ routes.cart_add_url }}" method="post" id="ProductForm">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- unless product.has_only_default_variant -%}{%- for option in product.options_with_values -%}<div style="margin-bottom:20px"><label style="font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:700;display:block;margin-bottom:10px;color:var(--ot-dark)">{{ option.name }}</label><div style="display:flex;gap:8px;flex-wrap:wrap" data-swatches>{%- for value in option.values -%}<button type="button" data-swatch="{{ value }}" style="padding:10px 20px;border:1px solid {% if option.selected_value == value %}var(--ot-matcha){% else %}var(--ot-border){% endif %};background:{% if option.selected_value == value %}var(--ot-matcha){% else %}#fff{% endif %};color:{% if option.selected_value == value %}#fff{% else %}var(--ot-dark){% endif %};font-size:13px;font-weight:600;cursor:pointer;border-radius:8px;transition:all .2s">{{ value }}</button>{%- endfor -%}</div></div>{%- endfor -%}<select name="id" data-variant-select style="display:none">{%- for variant in product.variants -%}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</option>{%- endfor -%}</select>{%- endunless -%}
        <div style="display:flex;gap:12px;margin-bottom:12px">
          <div style="display:flex;align-items:center;border:1px solid var(--ot-border);border-radius:8px;background:#fff;overflow:hidden"><button type="button" data-dir="down" style="width:44px;height:52px;background:none;border:none;font-size:20px;cursor:pointer">−</button><input type="number" name="quantity" value="1" min="1" style="width:48px;height:52px;text-align:center;border:none;font-size:16px;font-weight:600"><button type="button" data-dir="up" style="width:44px;height:52px;background:none;border:none;font-size:20px;cursor:pointer">+</button></div>
          <button type="submit" class="ot-btn" data-atc style="flex:1;justify-content:center" {% unless product.available %}disabled{% endunless %}>{%- if product.available -%}ACQUIRE TEA{%- else -%}OUT OF STOCK{%- endif -%}</button>
        </div>
      </form>
      <!-- Trust List -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:20px 0">
        <div style="display:flex;align-items:center;gap:8px;padding:10px;background:#fff;border-radius:8px;font-size:12px;color:var(--ot-dark);border:1px solid var(--ot-border)"><span style="color:var(--ot-matcha)">✓</span> shade-grown verification</div>
        <div style="display:flex;align-items:center;gap:8px;padding:10px;background:#fff;border-radius:8px;font-size:12px;color:var(--ot-dark);border:1px solid var(--ot-border)"><span style="color:var(--ot-matcha)">✓</span> Uji direct shipping</div>
      </div>
      <div style="font-family:'Lora',serif;font-size:15px;line-height:1.8;color:var(--ot-muted)">{{ product.description }}</div>
    </div>
  </div>
</div></div>
{% schema %}
{"name":"Tea Product","settings":[],"presets":[{"name":"Tea Product"}]}
{% endschema %}
