<div style="padding:80px 20px;background:var(--ot-dark)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="ot-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,4vw,48px);font-weight:300;color:var(--ot-paper);margin-bottom:20px;line-height:1.15">{{ section.settings.heading }}</h2>
    <p style="font-family:'Lora',serif;font-size:16px;color:var(--ot-sage);line-height:1.8;max-width:440px">{{ section.settings.body }}</p>
    <div class="ot-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="ot-stat" style="border-color:rgba(221,229,220,0.15);background:rgba(255,255,255,0.02)" {{ block.shopify_attributes }}><div class="ot-stat__num" style="color:var(--ot-sage)">{{ block.settings.number }}</div><div class="ot-stat__label" style="color:var(--ot-paper)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:8px;object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:4/5;background:var(--ot-matcha);border-radius:8px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Tea Story","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ORGANIC ANCESTRY"},{"type":"text","id":"heading","label":"Heading","default":"Shade grown for 20 days."},{"type":"textarea","id":"body","label":"Body","default":"Our tea bushes are covered with black screens to block out 90% of sunlight before harvesting. This forces the plant to push amino acids and sweet L-theanine into the leaves, yielding sweet, vivid green ceremonial matcha."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"100%"},{"type":"text","id":"label","label":"Label","default":"Shade Grown"}]}],"presets":[{"name":"Tea Story","blocks":[{"type":"stat","settings":{"number":"20 Days","label":"Shade Grown"}},{"type":"stat","settings":{"number":"100%","label":"Stone Ground"}},{"type":"stat","settings":{"number":"Uji","label":"Direct Origin"}},{"type":"stat","settings":{"number":"Zero","label":"Pesticide Rating"}}]}]}
{% endschema %}
