<div style="padding:80px 20px;background:#fff;border-bottom:1px solid var(--ot-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="ot-section-header"><span class="ot-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="ot-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="ot-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--ot-matcha)"></div>{%- endif -%}<div class="ot-col-card__overlay"><span class="ot-col-card__title">{{ block.settings.title }}</span><span class="ot-col-card__cta">Explore Garden →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Tea Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"GARDEN VARIETIES"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Category"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Ceremonial Matcha"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Tea Collections","blocks":[{"type":"col","settings":{"title":"Ceremonial Matcha"}},{"type":"col","settings":{"title":"Loose Leaf Oolong"}},{"type":"col","settings":{"title":"Botanical Herbal Infusions"}}]}]}
{% endschema %}
