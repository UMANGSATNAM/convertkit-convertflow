<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="ot-section-header"><span class="ot-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="ot-review-grid">{%- for block in section.blocks -%}<div class="ot-review-card" {{ block.shopify_attributes }}><div class="ot-review-card__stars">★★★★★</div><div class="ot-review-card__text">"{{ block.settings.quote }}"</div><div class="ot-review-card__author">{{ block.settings.name }}</div><div class="ot-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Tea Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CEREMONIAL OPINIONS"},{"type":"text","id":"heading","label":"Heading","default":"Testimonials of Taste"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Tea Reviews","blocks":[{"type":"review","settings":{"quote":"The Uji matcha is incredibly smooth. Very minimal bitterness with an intense umami sweet finish.","name":"Hana Y.","product":"Ceremonial Uji Matcha"}},{"type":"review","settings":{"quote":"Vibrant jade green color. You can instantly tell it is stone ground and fresh.","name":"Liam D.","product":"Premium Matcha Whisk Set"}},{"type":"review","settings":{"quote":"Excellent clean energy. I replaced my morning espresso with this loose leaf Oolong.","name":"Elena B.","product":"Loose Leaf High Mountain Oolong"}}]}]}
{% endschema %}
