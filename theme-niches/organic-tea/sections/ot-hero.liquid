<div class="ot-hero">
  <div class="ot-hero__content">
    <span class="ot-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="ot-hero__title">{{ section.settings.heading }}</h1>
    <p class="ot-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="ot-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="ot-btn ot-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="ot-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--ot-matcha)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Tea Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ZEN GARDEN FLAVORS"},{"type":"text","id":"heading","label":"Ceremonial Stone Ground Matcha"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Hand-harvested Uji green tea leaves shade-grown for 20 days and ground by granite stone mills."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"SHOP MATCHA"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"OUR GARDEN"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Tea Hero"}]}
{% endschema %}
