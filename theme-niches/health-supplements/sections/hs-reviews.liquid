<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="hs-section-header"><span class="hs-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="hs-review-grid">{%- for block in section.blocks -%}<div class="hs-review-card" {{ block.shopify_attributes }}><div class="hs-review-card__stars">★★★★★</div><div class="hs-review-card__text">"{{ block.settings.quote }}"</div><div class="hs-review-card__author">{{ block.settings.name }}</div><div class="hs-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Supplements Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PATIENT REPORTS"},{"type":"text","id":"heading","label":"Heading","default":"Verified Clinical Reviews"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Supplements Reviews","blocks":[{"type":"review","settings":{"quote":"Excellent clean focus. I noticed a distinct improvement in my morning memory retention within 7 days.","name":"Clara M.","product":"Cognitive Nootropic Stack"}},{"type":"review","settings":{"quote":"Sleep quality has improved dramatically. Waking up actually rested without grogginess.","name":"Liam P.","product":"Magnesium Recovery Blend"}},{"type":"review","settings":{"quote":"Very clean formula. Zero bloating or artificial sweetener aftertaste. Highly recommended.","name":"Elena V.","product":"Bio-Whey Protein Isolate"}}]}]}
{% endschema %}
