<div style="padding:80px 20px;background:#fff;border-bottom:1px solid var(--hs-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="hs-section-header"><span class="hs-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="hs-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="hs-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--hs-teal)"></div>{%- endif -%}<div class="hs-col-card__overlay"><span class="hs-col-card__title">{{ block.settings.title }}</span><span class="hs-col-card__cta">Explore Formulas →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Supplements Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FORMULA CATEGORIES"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Health Goal"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Cognitive Nootropics"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Supplements Collections","blocks":[{"type":"col","settings":{"title":"Cognitive Nootropics"}},{"type":"col","settings":{"title":"Metabolic Longevity"}},{"type":"col","settings":{"title":"Sleep & Recovery"}}]}]}
{% endschema %}
