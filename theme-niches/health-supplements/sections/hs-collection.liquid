<div style="padding:60px 20px 0;background:var(--hs-clinical)"><div style="max-width:1320px;margin:0 auto;text-align:center;padding-bottom:56px;border-bottom:1px solid var(--hs-border)"><span class="hs-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</span><h1 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(32px,5vw,52px);font-weight:700;color:var(--hs-dark);margin-bottom:12px;letter-spacing:-0.02em">{{ collection.title }}</h1>{%- if collection.description != blank -%}<p style="font-family:'Inter',sans-serif;font-size:15px;color:var(--hs-muted);max-width:560px;margin:0 auto;line-height:1.7">{{ collection.description }}</p>{%- endif -%}</div></div>
<div style="padding:0 20px 100px;background:var(--hs-clinical)"><div style="max-width:1320px;margin:0 auto"><div style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid var(--hs-border);margin-bottom:40px"><div style="font-family:'Inter',sans-serif;font-size:14px;color:var(--hs-muted)">{{ collection.products_count }} formulas</div><select style="padding:10px 20px;border:1px solid var(--hs-border);border-radius:6px;background:#fff;color:var(--hs-dark);font-family:'Space Grotesk',sans-serif;font-size:12px;font-weight:700;cursor:pointer"><option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Newest</option></select></div><div class="hs-prod-grid">{%- for product in collection.products -%}<a href="{{ product.url }}" class="hs-prod-card"><div class="hs-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--hs-clinical)"></div>{%- endif -%}</div><div class="hs-prod-card__name">{{ product.title }}</div><div class="hs-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div></div></div>
{% schema %}
{"name":"Supplements Collection","settings":[],"presets":[{"name":"Supplements Collection"}]}
{% endschema %}
