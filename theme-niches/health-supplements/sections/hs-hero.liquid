<div class="hs-hero">
  <div class="hs-hero__content">
    <span class="hs-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="hs-hero__title">{{ section.settings.heading }}</h1>
    <p class="hs-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="hs-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/science' }}" class="hs-btn hs-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="hs-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--hs-teal)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Supplements Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CLINICALLY VERIFIED"},{"type":"text","id":"heading","label":"Bio-Available Cellular Health"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Third-party lab tested compounds synthesized for maximum cellular absorption and cognitive vitality."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"EXPLORE FORMULAS"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"LAB REPORTS"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Supplements Hero"}]}
{% endschema %}
