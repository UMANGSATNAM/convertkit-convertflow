<div style="padding:80px 20px;background:var(--hs-slate)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="hs-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(28px,4vw,48px);font-weight:700;color:var(--hs-clinical);margin-bottom:20px;line-height:1.1;letter-spacing:-0.02em">{{ section.settings.heading }}</h2>
    <p style="font-family:'Inter',sans-serif;font-size:16px;color:var(--hs-muted);line-height:1.7;max-width:440px">{{ section.settings.body }}</p>
    <div class="hs-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="hs-stat" style="border-color:rgba(225,230,235,0.15);background:rgba(255,255,255,0.02)" {{ block.shopify_attributes }}><div class="hs-stat__num" style="color:var(--hs-green)">{{ block.settings.number }}</div><div class="hs-stat__label" style="color:var(--hs-clinical)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:6px;object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:4/5;background:var(--hs-teal);border-radius:6px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Supplements Story","settings":[{"type":"text","id":"eyebrow","label":"SCIENCE BACKED"},{"type":"text","id":"heading","label":"Heading","default":"Third-Party Lab Verified."},{"type":"textarea","id":"body","label":"Body","default":"Every batch is analyzed by independent ISO-certified labs to verify ingredient purity, heavy metals clearance, and correct active dosage levels."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"100%"},{"type":"text","id":"label","label":"Label","default":"Purity"}]}],"presets":[{"name":"Supplements Story","blocks":[{"type":"stat","settings":{"number":"100%","label":"Lab Pure"}},{"type":"stat","settings":{"number":"99.2%","label":"Absorption"}},{"type":"stat","settings":{"number":"Zero","label":"Fillers"}},{"type":"stat","settings":{"number":"ISO","label":"US Certified"}}]}]}
{% endschema %}
