<div style="padding:80px 20px;background:var(--el-charcoal)"><div style="max-width:1320px;margin:0 auto">
  <div class="el-section-header"><span class="el-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="el-review-grid">{%- for block in section.blocks -%}<div class="el-review-card" {{ block.shopify_attributes }}><div class="el-review-card__stars">★★★★★</div><div class="el-review-card__text">"{{ block.settings.quote }}"</div><div class="el-review-card__author">{{ block.settings.name }}</div><div class="el-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Electronics Reviews","settings":[{"type":"text","id":"eyebrow","label":"HARDWARE FEEDBACK"},{"type":"text","id":"heading","label":"Heading","default":"Verified Developer Reviews"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Electronics Reviews","blocks":[{"type":"review","settings":{"quote":"Exceptional low latency. I use it for tracking synths directly without experiencing buffer delay.","name":"Aaron G.","product":"Studio Synth Pro Engine"}},{"type":"review","settings":{"quote":"The spatial profiling is outstanding. You can hear exactly where each element sits in the master mix.","name":"Marcus L.","product":"Spatial Sound Stage Headset"}},{"type":"review","settings":{"quote":"Incredible build quality. Metal enclosures feel extremely road-ready. Interface connectivity is instant.","name":"Tariq P.","product":"Modular MIDI Control Rig"}}]}]}
{% endschema %}
