<div style="background:#000000; padding:120px 24px; border-top:1px solid rgba(255,255,255,0.05);">
  <div style="max-width:1000px; margin:0 auto; text-align:center;">
    
    <div style="margin-bottom:80px;">
      <h2 style="font-family:'Space Grotesk', sans-serif; font-size:clamp(32px, 4vw, 48px); font-weight:700; color:#FFFFFF; margin:0 0 16px 0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-family:'Inter', sans-serif; font-size:18px; color:#9CA3AF; margin:0;">Compare models to find the right device for you.</p>
    </div>

    <div class="te-comp-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">
      
      <!-- Model 1 -->
      <div style="background:#0F0F0F; padding:40px; border-radius:16px; border:1px solid rgba(255,255,255,0.05); display:flex; flex-direction:column;">
        <div style="margin-bottom:32px;">
          <h3 style="font-family:'Space Grotesk', sans-serif; font-size:24px; font-weight:700; color:#FFFFFF; margin:0 0 8px 0;">Proxima</h3>
          <div style="font-family:'Inter', sans-serif; font-size:18px; color:#9CA3AF;">From $199</div>
        </div>
        
        <div style="flex-grow:1; display:flex; flex-direction:column; gap:20px; text-align:left; margin-bottom:40px;">
          <div style="border-bottom:1px solid rgba(255,255,255,0.05); padding-bottom:12px;">
            <div style="font-family:'Inter', sans-serif; font-size:14px; font-weight:500; color:#FFFFFF; margin-bottom:4px;">Audio</div>
            <div style="font-family:'Inter', sans-serif; font-size:14px; color:#9CA3AF;">Standard Sound</div>
          </div>
          <div style="border-bottom:1px solid rgba(255,255,255,0.05); padding-bottom:12px;">
            <div style="font-family:'Inter', sans-serif; font-size:14px; font-weight:500; color:#FFFFFF; margin-bottom:4px;">Noise Cancellation</div>
            <div style="font-family:'Inter', sans-serif; font-size:14px; color:#9CA3AF;">Passive</div>
          </div>
          <div style="border-bottom:1px solid rgba(255,255,255,0.05); padding-bottom:12px;">
            <div style="font-family:'Inter', sans-serif; font-size:14px; font-weight:500; color:#FFFFFF; margin-bottom:4px;">Battery Life</div>
            <div style="font-family:'Inter', sans-serif; font-size:14px; color:#9CA3AF;">Up to 20 hours</div>
          </div>
          <div style="padding-bottom:12px;">
            <div style="font-family:'Inter', sans-serif; font-size:14px; font-weight:500; color:#FFFFFF; margin-bottom:4px;">Material</div>
            <div style="font-family:'Inter', sans-serif; font-size:14px; color:#9CA3AF;">Recycled Plastic</div>
          </div>
        </div>
        
        <a href="#" style="display:block; text-align:center; background:rgba(255,255,255,0.1); color:#FFFFFF; font-family:'Space Grotesk', sans-serif; font-size:14px; font-weight:600; padding:16px; border-radius:30px; text-decoration:none; transition:all 0.3s ease;" class="te-btn-secondary">
          BUY PROXIMA
        </a>
      </div>
      
      <!-- Model 2 -->
      <div style="background:linear-gradient(145deg, #1A1A1A 0%, #0F0F0F 100%); padding:40px; border-radius:16px; border:1px solid rgba(59,130,246,0.3); display:flex; flex-direction:column; position:relative;">
        <div style="position:absolute; top:-12px; left:50%; transform:translateX(-50%); background:#3B82F6; color:#FFFFFF; font-family:'Space Grotesk', sans-serif; font-size:10px; font-weight:700; padding:4px 12px; border-radius:12px; letter-spacing:1px; text-transform:uppercase;">
          PRO MODEL
        </div>
        
        <div style="margin-bottom:32px;">
          <h3 style="font-family:'Space Grotesk', sans-serif; font-size:24px; font-weight:700; color:#FFFFFF; margin:0 0 8px 0;">Proxima Max</h3>
          <div style="font-family:'Inter', sans-serif; font-size:18px; color:#3B82F6;">From $299</div>
        </div>
        
        <div style="flex-grow:1; display:flex; flex-direction:column; gap:20px; text-align:left; margin-bottom:40px;">
          <div style="border-bottom:1px solid rgba(255,255,255,0.05); padding-bottom:12px;">
            <div style="font-family:'Inter', sans-serif; font-size:14px; font-weight:500; color:#FFFFFF; margin-bottom:4px;">Audio</div>
            <div style="font-family:'Inter', sans-serif; font-size:14px; color:#9CA3AF;">Spatial Audio with dynamic head tracking</div>
          </div>
          <div style="border-bottom:1px solid rgba(255,255,255,0.05); padding-bottom:12px;">
            <div style="font-family:'Inter', sans-serif; font-size:14px; font-weight:500; color:#FFFFFF; margin-bottom:4px;">Noise Cancellation</div>
            <div style="font-family:'Inter', sans-serif; font-size:14px; color:#9CA3AF;">Active Noise Cancellation</div>
          </div>
          <div style="border-bottom:1px solid rgba(255,255,255,0.05); padding-bottom:12px;">
            <div style="font-family:'Inter', sans-serif; font-size:14px; font-weight:500; color:#FFFFFF; margin-bottom:4px;">Battery Life</div>
            <div style="font-family:'Inter', sans-serif; font-size:14px; color:#9CA3AF;">Up to 30 hours</div>
          </div>
          <div style="padding-bottom:12px;">
            <div style="font-family:'Inter', sans-serif; font-size:14px; font-weight:500; color:#FFFFFF; margin-bottom:4px;">Material</div>
            <div style="font-family:'Inter', sans-serif; font-size:14px; color:#9CA3AF;">Aerospace-grade Aluminum</div>
          </div>
        </div>
        
        <a href="#" style="display:block; text-align:center; background:#3B82F6; color:#FFFFFF; font-family:'Space Grotesk', sans-serif; font-size:14px; font-weight:600; padding:16px; border-radius:30px; text-decoration:none; transition:all 0.3s ease;" class="te-btn-primary">
          BUY PROXIMA MAX
        </a>
      </div>
      
    </div>
  </div>

  <style>
    .te-btn-primary:hover { background: #FFFFFF; color: #000000; }
    .te-btn-secondary:hover { background: rgba(255,255,255,0.2); }
    
    @media (max-width: 768px) {
      .te-comp-grid { grid-template-columns: 1fr; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Tech Comparison",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Fit"
    }
  ],
  "presets": [
    {
      "name": "Tech Comparison"
    }
  ]
}
{% endschema %}
