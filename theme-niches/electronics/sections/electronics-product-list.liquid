{% style %}
.product-list {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.product-row {
  display: grid;
  grid-template-columns: 240px 1fr 300px;
  gap: 40px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 24px;
  align-items: center;
  transition: border-color 0.2s;
}
.product-row:hover {
  border-color: var(--primary);
}
.p-image {
  width: 100%;
  aspect-ratio: 1;
  background: #000;
  border-radius: 8px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.p-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.p-info h3 {
  font-size: 24px;
  font-weight: 600;
  margin-bottom: 12px;
}
.p-desc {
  color: var(--text-muted);
  font-size: 14px;
  margin-bottom: 24px;
  line-height: 1.5;
}
.p-specs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.spec-box {
  background: var(--bg);
  padding: 10px;
  border-radius: 4px;
  border: 1px solid var(--border);
}
.spec-lbl {
  font-size: 11px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 4px;
}
.spec-val {
  font-size: 14px;
  font-weight: 600;
  color: #fff;
}
.p-action {
  text-align: right;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
}
.p-price {
  font-size: 32px;
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700;
  margin-bottom: 8px;
}
.p-price-old {
  color: var(--text-muted);
  text-decoration: line-through;
  font-size: 16px;
  margin-bottom: 24px;
  display: block;
}
.btn-mono {
  width: 100%;
  background: var(--text);
  color: var(--bg);
  padding: 14px 20px;
  font-weight: 600;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 14px;
  transition: opacity 0.2s;
}
.btn-mono:hover { opacity: 0.9; }

@media(max-width: 1024px) {
  .product-row { grid-template-columns: 1fr; gap: 24px; }
  .p-action { text-align: left; align-items: flex-start; margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--border); }
  .p-image { aspect-ratio: 2/1; }
}
@media(max-width: 768px) {
  .p-specs { grid-template-columns: 1fr; }
}
{% endstyle %}

<section class="section" id="products">
  <div class="section-header">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
  </div>
  <div class="product-list">
    {%- for block in section.blocks -%}
      <div class="product-row">
        <div class="p-image">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title }}" loading="lazy">
          {%- else -%}
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:64px;height:64px;color:var(--primary);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
          {%- endif -%}
        </div>
        <div class="p-info">
          <h3>{{ block.settings.title }}
            {%- if block.settings.badge != blank -%}
              <span style="font-size:12px; background:var(--primary); color:#fff; padding:2px 8px; border-radius:4px; vertical-align:middle; margin-left:8px;">{{ block.settings.badge }}</span>
            {%- endif -%}
          </h3>
          <p class="p-desc">{{ block.settings.description }}</p>
          <div class="p-specs">
            <div class="spec-box"><div class="spec-lbl">{{ block.settings.s1_lbl }}</div><div class="spec-val">{{ block.settings.s1_val }}</div></div>
            <div class="spec-box"><div class="spec-lbl">{{ block.settings.s2_lbl }}</div><div class="spec-val">{{ block.settings.s2_val }}</div></div>
            <div class="spec-box"><div class="spec-lbl">{{ block.settings.s3_lbl }}</div><div class="spec-val">{{ block.settings.s3_val }}</div></div>
          </div>
        </div>
        <div class="p-action">
          <span class="p-price">{{ block.settings.price }}</span>
          {%- if block.settings.compare_price != blank -%}
            <span class="p-price-old">{{ block.settings.compare_price }}</span>
          {%- endif -%}
          <button class="btn-mono">Add to Cart</button>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Electronics Products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Elite Collection" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Compare specifications across our flagship audio devices to find your perfect match." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Row",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "price", "label": "Price", "default": "$299.00" },
        { "type": "text", "id": "compare_price", "label": "Compare Price" },
        { "type": "text", "id": "s1_lbl", "label": "Spec 1 Label" },
        { "type": "text", "id": "s1_val", "label": "Spec 1 Value" },
        { "type": "text", "id": "s2_lbl", "label": "Spec 2 Label" },
        { "type": "text", "id": "s2_val", "label": "Spec 2 Value" },
        { "type": "text", "id": "s3_lbl", "label": "Spec 3 Label" },
        { "type": "text", "id": "s3_val", "label": "Spec 3 Value" }
      ]
    }
  ],
  "presets": [{ "name": "Electronics Products" }]
}
{% endschema %}
