<div style="padding:80px 20px;background:var(--el-bg);border-bottom:1px solid var(--el-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="el-section-header"><span class="el-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="el-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="el-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--el-cyan)"></div>{%- endif -%}<div class="el-col-card__overlay"><span class="el-col-card__title">{{ block.settings.title }}</span><span class="el-col-card__cta">Explore Devices →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Electronics Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"HARDWARE STACK"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Category"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Studio Synthesizers"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Electronics Collections","blocks":[{"type":"col","settings":{"title":"Studio Synthesizers"}},{"type":"col","settings":{"title":"Wireless Sound Stage"}},{"type":"col","settings":{"title":"Modular MIDI Rigs"}}]}]}
{% endschema %}
