<div style="background:#0F0F0F; padding:120px 40px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Space Grotesk', sans-serif; font-size:clamp(32px, 4vw, 48px); font-weight:700; color:#FFFFFF; margin:0 0 16px 0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="te-cat-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:24px;">
      
      {%- for block in section.blocks -%}
        <a href="#" class="te-cat-card" style="display:block; text-decoration:none; position:relative; overflow:hidden; border-radius:16px; background:#1A1A1A; border:1px solid rgba(255,255,255,0.05); transition:all 0.4s ease; group">
          
          <div style="position:relative; padding-bottom:100%;">
            {%- assign idx = forloop.index | modulo: 4 -%}
            {%- assign img_url = 'https://images.unsplash.com/photo-1622286342621-4bd786c2447c?auto=format&fit=crop&w=600&q=80' -%}
            {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1622286342621-4bd786c2447c?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1618366712010-f4ae9c647dcb?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1546868871-7041f2a55e12?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1558089687-f282ffcbc126?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            
            <img src="{{ img_url }}" alt="{{ block.settings.title }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.6; transition:all 0.5s ease; filter:grayscale(100%) contrast(1.2);" class="te-cat-img" loading="lazy">
            
            <!-- Tech grid overlay -->
            <div style="position:absolute; inset:0; background-image:linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size:20px 20px; z-index:1;"></div>
            <div style="position:absolute; inset:0; background:linear-gradient(to top, #1A1A1A 0%, transparent 100%); z-index:2;"></div>
          </div>
          
          <div style="position:absolute; bottom:24px; left:24px; right:24px; z-index:3; display:flex; justify-content:space-between; align-items:flex-end;">
            <h3 style="font-family:'Space Grotesk', sans-serif; font-size:18px; font-weight:600; color:#FFFFFF; margin:0; transition:color 0.3s ease;" class="te-cat-title">
              {{ block.settings.title }}
            </h3>
            <div style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.1); display:flex; align-items:center; justify-content:center; transition:all 0.3s ease;" class="te-cat-arrow">
              <svg style="width:16px; height:16px; fill:none; stroke:#FFFFFF; stroke-width:2;" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </div>
          
        </a>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .te-cat-card:hover { border-color: rgba(59,130,246,0.5); transform: translateY(-5px); box-shadow: 0 10px 30px rgba(59,130,246,0.15); }
    .te-cat-card:hover .te-cat-img { transform: scale(1.05); filter: grayscale(0%) contrast(1); opacity: 0.8; }
    .te-cat-card:hover .te-cat-title { color: #3B82F6; }
    .te-cat-card:hover .te-cat-arrow { background: #3B82F6; transform: translateX(5px); }
    
    @media (max-width: 1024px) {
      .te-cat-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .te-cat-grid { grid-template-columns: 1fr; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Tech Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore the Ecosystem"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Spatial Computing"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tech Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
