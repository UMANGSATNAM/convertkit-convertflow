<div style="background:#050505; padding:120px 24px; position:relative; overflow:hidden;">
  
  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    <div class="te-featured-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
      
      <!-- Content -->
      <div style="order:2;">
        <div style="display:inline-block; font-family:'Space Grotesk', sans-serif; font-size:12px; font-weight:600; letter-spacing:4px; text-transform:uppercase; color:#3B82F6; margin-bottom:24px;">
          {{ section.settings.eyebrow }}
        </div>
        
        <h2 style="font-family:'Space Grotesk', sans-serif; font-size:clamp(40px, 5vw, 64px); font-weight:700; line-height:1.1; color:#FFFFFF; margin:0 0 24px 0; letter-spacing:-2px;">
          {{ section.settings.heading }}
        </h2>
        
        <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:300; line-height:1.6; color:#9CA3AF; margin:0 0 40px 0;">
          Immerse yourself in high-fidelity audio with our custom-built acoustic architecture. The new Proxima series delivers crystal-clear highs, deep bass, and industry-leading active noise cancellation.
        </p>
        
        <div style="display:flex; flex-direction:column; gap:24px; margin-bottom:48px;">
          <div style="display:flex; align-items:flex-start; gap:16px;">
            <div style="color:#3B82F6; font-size:24px; line-height:1;">✨</div>
            <div>
              <h4 style="font-family:'Inter', sans-serif; font-size:16px; font-weight:500; color:#FFFFFF; margin:0 0 4px 0;">Adaptive EQ</h4>
              <p style="font-family:'Inter', sans-serif; font-size:14px; font-weight:300; color:#6B7280; margin:0;">Automatically tunes music to the shape of your ear.</p>
            </div>
          </div>
          <div style="display:flex; align-items:flex-start; gap:16px;">
            <div style="color:#3B82F6; font-size:24px; line-height:1;">🔋</div>
            <div>
              <h4 style="font-family:'Inter', sans-serif; font-size:16px; font-weight:500; color:#FFFFFF; margin:0 0 4px 0;">All-Day Battery</h4>
              <p style="font-family:'Inter', sans-serif; font-size:14px; font-weight:300; color:#6B7280; margin:0;">Up to 30 hours of listening time with ANC enabled.</p>
            </div>
          </div>
        </div>
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/products/headphones' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#3B82F6; color:#FFFFFF; font-family:'Space Grotesk', sans-serif; font-size:14px; font-weight:600; letter-spacing:1px; text-transform:uppercase; text-decoration:none; padding:18px 40px; border-radius:30px; transition:all 0.3s ease;" class="te-btn-primary">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
      
      <!-- Visuals -->
      <div style="position:relative; min-height:600px; display:flex; justify-content:center; align-items:center; order:1;" class="te-featured-visual">
        <div style="position:absolute; width:100%; height:100%; background:radial-gradient(circle, rgba(59,130,246,0.1) 0%, transparent 60%); z-index:1;"></div>
        
        <img src="https://images.unsplash.com/photo-1546868871-7041f2a55e12?auto=format&fit=crop&w=800&q=80" alt="Headphones" style="width:90%; height:90%; object-fit:contain; position:relative; z-index:2; filter:drop-shadow(0 30px 40px rgba(0,0,0,0.5)); transition:transform 0.5s ease;" class="te-featured-img" loading="lazy">
      </div>
      
    </div>
  </div>

  <style>
    .te-btn-primary:hover { background: #FFFFFF; color: #000000; box-shadow: 0 0 20px rgba(255,255,255,0.3); }
    .te-featured-img:hover { transform: scale(1.05); }
    
    @media (max-width: 990px) {
      .te-featured-grid { grid-template-columns: 1fr; gap: 60px; text-align: center; }
      .te-featured-grid > div.te-featured-visual { order: 1; min-height:400px; }
      .te-featured-grid > div:not(.te-featured-visual) { order: 2; max-width: 600px; margin: 0 auto; }
      .te-featured-grid > div:not(.te-featured-visual) > div { justify-content: center; text-align: left; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Tech Featured",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PRO AUDIO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sound, Re-engineered."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "BUY NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Tech Featured"
    }
  ]
}
{% endschema %}
