<div style="padding:80px 20px;background:var(--el-dark)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="el-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(28px,4vw,48px);font-weight:700;color:var(--el-white);margin-bottom:20px;line-height:1.1;letter-spacing:-0.02em;text-transform:uppercase">{{ section.settings.heading }}</h2>
    <p style="font-family:'Inter',sans-serif;font-size:15px;color:var(--el-muted);line-height:1.7;max-width:440px;font-weight:500">{{ section.settings.body }}</p>
    <div class="el-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="el-stat" style="border-color:rgba(0,240,255,0.15);background:rgba(255,255,255,0.01)" {{ block.shopify_attributes }}><div class="el-stat__num" style="color:var(--el-cyan)">{{ block.settings.number }}</div><div class="el-stat__label" style="color:var(--el-muted)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:8px;border:1px solid var(--el-border);object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:1.1;background:var(--el-border);border-radius:8px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Electronics Specs","settings":[{"type":"text","id":"eyebrow","label":"SPECIFICATIONS"},{"type":"text","id":"heading","label":"Heading","default":"Extreme Audio Processing."},{"type":"textarea","id":"body","label":"Body","default":"Integrated 24-bit dual-engine DSP chips process high-fidelity spatial configurations with minimal signal jitter."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"24-bit"},{"type":"text","id":"label","label":"Label","default":"Resolution"}]}],"presets":[{"name":"Electronics Specs","blocks":[{"type":"stat","settings":{"number":"24-bit","label":"DSP Engine"}},{"type":"stat","settings":{"number":"< 1.2ms","label":"Latency"}},{"type":"stat","settings":{"number":"112dB","label":"Signal Snr"}},{"type":"stat","settings":{"number":"LDAC","label":"Wireless Codec"}}]}]}
{% endschema %}
