<div style="background:#0F0F0F; padding:120px 24px; position:relative;">
  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Space Grotesk', sans-serif; font-size:clamp(32px, 4vw, 48px); font-weight:700; color:#FFFFFF; margin:0 0 16px 0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="te-features-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:24px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#1A1A1A; padding:40px; border-radius:16px; border:1px solid rgba(255,255,255,0.05); text-align:left; transition:all 0.3s ease;" class="te-feature-card">
          
          <div style="width:56px; height:56px; border-radius:12px; background:rgba(59,130,246,0.1); display:flex; align-items:center; justify-content:center; margin-bottom:32px; color:#3B82F6;">
            <svg style="width:28px; height:28px; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24">
              {% if forloop.index == 1 %}
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" stroke-linecap="round" stroke-linejoin="round"/>
              {% elsif forloop.index == 2 %}
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke-linecap="round" stroke-linejoin="round"/>
              {% else %}
                <path d="M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9H3m9 9a9 9 0 0 1-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 0 1 9-9" stroke-linecap="round" stroke-linejoin="round"/>
              {% endif %}
            </svg>
          </div>
          
          <h3 style="font-family:'Space Grotesk', sans-serif; font-size:20px; font-weight:600; color:#FFFFFF; margin:0 0 12px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Inter', sans-serif; font-size:15px; font-weight:300; color:#9CA3AF; line-height:1.6; margin:0;">
            {{ block.settings.desc }}
          </p>
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .te-feature-card:hover { border-color: rgba(59,130,246,0.3); transform: translateY(-5px); background: #222222; box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
    
    @media (max-width: 990px) {
      .te-features-grid { grid-template-columns: 1fr; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Tech Features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered for Excellence"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Active Noise Cancellation"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Block out the world with industry-leading ANC."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tech Features",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
