<div style="background:var(--tech-bg);padding:100px 60px;position:relative;overflow:hidden">
  
  <div style="position:absolute;top:0;left:0;width:100%;height:1px;background:linear-gradient(90deg, transparent, var(--tech-accent), transparent);opacity:0.5"></div>
  
  <div style="max-width:1400px;margin:0 auto;position:relative;z-index:2">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:60px">
      <div>
        <div class="tech-spec" style="margin-bottom:12px;color:var(--tech-accent)">{{ collection.products_count | default: '24' }} PROTOCOLS DETECTED</div>
        <h2 class="tech-head" style="font-size:48px">{{ collection.title | default: 'Neural Network Hardware' }}</h2>
      </div>
      <div style="display:flex;gap:16px">
        <select style="background:var(--tech-surface);border:1px solid var(--tech-border);color:#FFF;padding:12px 24px;border-radius:8px;font-family:var(--font-mono);font-size:12px;outline:none;cursor:pointer">
          <option>SORT: OPTIMAL</option>
          <option>SORT: LOWEST PRICE</option>
          <option>SORT: HIGHEST PRICE</option>
        </select>
      </div>
    </div>
    
    <div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:24px">
      {%- for product in collection.products limit: 12 -%}
      <a href="{{ product.url }}" class="tech-card">
        <div class="image-wrapper">
          {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- else -%}
          <div style="width:100%;height:100%;background:rgba(255,255,255,0.05);border-radius:8px"></div>
          {%- endif -%}
        </div>
        <div class="specs-list">
          <span class="spec-tag">v.2.0.4</span>
          <span class="spec-tag">QUANTUM</span>
        </div>
        <div class="title">{{ product.title }}</div>
        <div class="price">{{ product.price | money }}</div>
        
        <div class="tech-btn" style="width:100%;margin-top:20px;padding:10px;font-size:12px">INITIALIZE CART</div>
      </a>
      {%- else -%}
      <!-- Demo State -->
      {%- for i in (1..8) -%}
      <a href="#" class="tech-card">
        <div class="image-wrapper">
          <div style="width:100%;height:100%;background:rgba(255,255,255,0.05);border-radius:8px"></div>
        </div>
        <div class="specs-list">
          <span class="spec-tag">v.2.0.{{i}}</span>
          <span class="spec-tag">QUANTUM</span>
        </div>
        <div class="title">Neuro-Link Headset V{{i}}</div>
        <div class="price">₹14,999</div>
        
        <div class="tech-btn" style="width:100%;margin-top:20px;padding:10px;font-size:12px">INITIALIZE CART</div>
      </a>
      {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Electronics Tech Grid",
  "settings": [],
  "presets": [
    {
      "name": "Electronics Tech Grid"
    }
  ]
}
{% endschema %}
