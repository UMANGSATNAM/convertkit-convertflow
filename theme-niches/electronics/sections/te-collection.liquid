<div style="background:#000000; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px; flex-wrap:wrap; gap:24px;">
      <div>
        <h2 style="font-family:'Space Grotesk', sans-serif; font-size:clamp(32px, 4vw, 48px); font-weight:700; color:#FFFFFF; margin:0; letter-spacing:-1px;">
          {{ section.settings.heading }}
        </h2>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Space Grotesk', sans-serif; font-size:14px; font-weight:600; color:#FFFFFF; text-decoration:none; display:flex; align-items:center; gap:8px; letter-spacing:1px; text-transform:uppercase; transition:color 0.3s ease;" class="te-link-btn">
          {{ section.settings.cta_label }}
          <svg style="width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="te-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:24px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1618366712010-f4ae9c647dcb?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1618366712010-f4ae9c647dcb?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1546868871-7041f2a55e12?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1558089687-f282ffcbc126?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="te-product-card" style="background:#0F0F0F; border-radius:12px; overflow:hidden; border:1px solid rgba(255,255,255,0.05); transition:all 0.3s ease; position:relative; display:flex; flex-direction:column; height:100%;">
          
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:100%; background:#1A1A1A;">
            <img src="{{ img_url }}" alt="Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease; filter:brightness(0.9);" class="te-product-img" loading="lazy">
            
            {% if idx == 1 %}
              <div style="position:absolute; top:12px; left:12px; background:#3B82F6; color:#FFFFFF; font-family:'Space Grotesk', sans-serif; font-size:10px; font-weight:700; padding:4px 8px; border-radius:4px; letter-spacing:1px; text-transform:uppercase;">
                NEW
              </div>
            {% endif %}
          </a>
          
          <div style="padding:24px; display:flex; flex-direction:column; flex-grow:1;">
            <div style="font-family:'Space Grotesk', sans-serif; font-size:12px; font-weight:600; color:#3B82F6; margin-bottom:8px; text-transform:uppercase; letter-spacing:1px;">
              {% if idx == 1 %}Audio{% elsif idx == 2 %}Wearables{% elsif idx == 3 %}Smart Home{% else %}Accessories{% endif %}
            </div>
            
            <h3 style="font-family:'Inter', sans-serif; font-size:18px; font-weight:500; color:#FFFFFF; margin:0 0 16px 0; flex-grow:1;">
              {% if idx == 1 %}Proxima Wireless Headphones{% elsif idx == 2 %}Titan Smartwatch Series 7{% elsif idx == 3 %}Nexus Home Assistant{% else %}Aura Soundbar Pro{% endif %}
            </h3>
            
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:auto;">
              <div style="font-family:'Space Grotesk', sans-serif; font-size:18px; font-weight:600; color:#FFFFFF;">
                {% if idx == 1 %}$299.00{% elsif idx == 2 %}$449.00{% elsif idx == 3 %}$129.00{% else %}$199.00{% endif %}
              </div>
              <button style="width:36px; height:36px; background:transparent; border:1px solid rgba(255,255,255,0.2); border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all 0.3s ease; color:#FFFFFF;" class="te-add-btn">
                <svg style="width:16px; height:16px; fill:currentColor;" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
              </button>
            </div>
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .te-link-btn:hover { color: #3B82F6; }
    .te-product-card:hover { border-color: rgba(59,130,246,0.3); transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    .te-product-card:hover .te-product-img { transform: scale(1.05); filter: brightness(1); }
    .te-add-btn:hover { background: #FFFFFF; color: #000000; border-color: #FFFFFF; }
    
    @media (max-width: 1024px) {
      .te-product-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
    @media (max-width: 640px) {
      .te-product-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Tech Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Devices"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Tech Collection"
    }
  ]
}
{% endschema %}
