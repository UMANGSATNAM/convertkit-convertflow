{% style %}
.elec-hero {
  min-height: 90vh;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  padding: 0 40px;
}
.elec-hero-bg {
  position: absolute;
  top: 50%;
  left: 80%;
  transform: translate(-50%, -50%);
  width: 800px;
  height: 800px;
  background: radial-gradient(circle, var(--primary-glow) 0%, transparent 60%);
  opacity: 0.15;
  z-index: 0;
  pointer-events: none;
}
.elec-hero-content {
  position: relative;
  z-index: 1;
  max-width: 600px;
}
.elec-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--surface);
  border: 1px solid var(--border);
  padding: 6px 16px;
  border-radius: 100px;
  font-size: 12px;
  font-weight: 600;
  color: var(--accent);
  margin-bottom: 24px;
  letter-spacing: 1px;
  text-transform: uppercase;
}
.elec-hero h1 {
  font-size: 80px;
  line-height: 1.1;
  margin-bottom: 24px;
  font-weight: 700;
  letter-spacing: -2px;
}
.elec-hero h1 span { color: var(--primary); }
.elec-hero p {
  font-size: 18px;
  color: var(--text-muted);
  margin-bottom: 40px;
  line-height: 1.6;
  max-width: 500px;
}
.elec-trust-stats {
  display: flex;
  gap: 60px;
  margin-top: 60px;
  border-top: 1px solid var(--border);
  padding-top: 40px;
}
.stat-item h4 { font-size: 32px; font-weight: 700; color: #fff; margin-bottom: 4px; }
.stat-item p { font-size: 13px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; }

@media(max-width: 1024px) {
  .elec-hero h1 { font-size: 60px; }
}
@media(max-width: 768px) {
  .elec-hero { padding: 40px 20px; text-align: center; justify-content: center; }
  .elec-hero-bg { left: 50%; }
  .elec-hero h1 { font-size: 40px; }
  .elec-hero p { margin: 0 auto 32px; }
  .elec-trust-stats { flex-direction: column; gap: 24px; align-items: center; }
  .btn-secondary { margin-left: 0; margin-top: 16px; width: 100%; justify-content: center; }
}
{% endstyle %}

<section class="elec-hero">
  <div class="elec-hero-bg"></div>
  <div class="elec-hero-content">
    {%- if section.settings.badge != blank -%}
      <div class="elec-hero-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg>
        {{ section.settings.badge }}
      </div>
    {%- endif -%}
    
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    
    <div>
      {%- if section.settings.btn1_text != blank -%}
        <a href="{{ section.settings.btn1_url }}" class="btn-primary">{{ section.settings.btn1_text }}</a>
      {%- endif -%}
      {%- if section.settings.btn2_text != blank -%}
        <a href="{{ section.settings.btn2_url }}" class="btn-secondary">{{ section.settings.btn2_text }}</a>
      {%- endif -%}
    </div>
    
    <div class="elec-trust-stats">
      {%- for block in section.blocks -%}
        <div class="stat-item">
          <h4>{{ block.settings.val }}</h4>
          <p>{{ block.settings.label }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Electronics Hero",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge Text", "default": "Next-Gen Audio Experience" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Hear the Unseen.<br><span>Vertex Pro Max.</span>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Engineered with dual-driver precision, adaptive ANC, and 40-hour battery life. The pinnacle of wireless audio has arrived." },
    { "type": "text", "id": "btn1_text", "label": "Primary Button", "default": "Pre-order Now" },
    { "type": "url", "id": "btn1_url", "label": "Primary URL" },
    { "type": "text", "id": "btn2_text", "label": "Secondary Button", "default": "View Specs" },
    { "type": "url", "id": "btn2_url", "label": "Secondary URL" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "val", "label": "Value" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [{ "name": "Electronics Hero" }]
}
{% endschema %}
