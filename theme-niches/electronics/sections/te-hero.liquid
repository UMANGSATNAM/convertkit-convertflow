<div style="background:#0F0F0F; color:#FFFFFF; position:relative; min-height:100vh; display:flex; align-items:center; overflow:hidden;">
  
  <!-- Glowing background elements -->
  <div style="position:absolute; top:-20%; left:-10%; width:50vw; height:50vw; background:radial-gradient(circle, rgba(59,130,246,0.15) 0%, rgba(15,15,15,0) 70%); z-index:1;"></div>
  <div style="position:absolute; bottom:-20%; right:-10%; width:50vw; height:50vw; background:radial-gradient(circle, rgba(139,92,246,0.15) 0%, rgba(15,15,15,0) 70%); z-index:1;"></div>

  <div style="max-width:1440px; margin:0 auto; width:100%; padding:40px 24px; position:relative; z-index:2; display:flex; flex-direction:column; align-items:center; text-align:center;">
    
    <div style="font-family:'Space Grotesk', sans-serif; font-size:12px; font-weight:600; letter-spacing:4px; text-transform:uppercase; color:#3B82F6; margin-bottom:24px; background:rgba(59,130,246,0.1); padding:8px 24px; border-radius:30px; border:1px solid rgba(59,130,246,0.2);">
      {{ section.settings.eyebrow }}
    </div>

    <h1 style="font-family:'Space Grotesk', sans-serif; font-size:clamp(48px, 8vw, 96px); font-weight:700; line-height:1; color:#FFFFFF; margin:0 0 24px 0; letter-spacing:-2px; text-shadow:0 0 40px rgba(255,255,255,0.1);">
      {{ section.settings.heading }}
    </h1>
    
    <p style="font-family:'Inter', sans-serif; font-size:clamp(18px, 2vw, 24px); font-weight:300; color:#9CA3AF; line-height:1.6; margin:0 0 48px 0; max-width:600px;">
      {{ section.settings.subheading }}
    </p>

    <div style="display:flex; gap:20px; align-items:center; justify-content:center; margin-bottom:80px;" class="te-hero-actions">
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#FFFFFF; color:#0F0F0F; font-family:'Space Grotesk', sans-serif; font-size:14px; font-weight:600; letter-spacing:1px; text-transform:uppercase; text-decoration:none; padding:18px 40px; border-radius:30px; transition:all 0.3s ease;" class="te-btn-primary">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
      
      {%- if section.settings.cta_label_2 != blank -%}
        <a href="{{ section.settings.cta_url_2 | default: '/pages/watch' }}" style="display:inline-flex; align-items:center; justify-content:center; background:transparent; color:#FFFFFF; font-family:'Space Grotesk', sans-serif; font-size:14px; font-weight:600; letter-spacing:1px; text-transform:uppercase; text-decoration:none; padding:18px 40px; border-radius:30px; border:1px solid rgba(255,255,255,0.2); transition:all 0.3s ease; gap:8px;" class="te-btn-secondary">
          <svg style="width:16px; height:16px; fill:currentColor;" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          {{ section.settings.cta_label_2 }}
        </a>
      {%- endif -%}
    </div>
    
    <!-- Hero Product Visual -->
    <div style="position:relative; width:100%; max-width:800px; padding-bottom:50%;">
      <img src="https://images.unsplash.com/photo-1622286342621-4bd786c2447c?auto=format&fit=crop&w=1200&q=80" alt="VR Headset" style="position:absolute; inset:0; width:100%; height:100%; object-fit:contain; filter:drop-shadow(0 20px 40px rgba(59,130,246,0.2));" loading="eager">
    </div>

  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Space+Grotesk:wght@500;600;700&display=swap');
    
    .te-btn-primary:hover { background: #3B82F6; color: #FFFFFF; box-shadow: 0 0 20px rgba(59,130,246,0.5); }
    .te-btn-secondary:hover { border-color: #FFFFFF; background: rgba(255,255,255,0.1); }
    
    @media (max-width: 640px) {
      .te-hero-actions { flex-direction: column; width: 100%; align-items: stretch; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Tech Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NEXT GENERATION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Beyond Reality"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Experience the future with our most advanced spatial computing headset yet."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary Button Label",
      "default": "PRE-ORDER NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "cta_label_2",
      "label": "Secondary Button Label",
      "default": "WATCH FILM"
    },
    {
      "type": "url",
      "id": "cta_url_2",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Tech Hero"
    }
  ]
}
{% endschema %}
