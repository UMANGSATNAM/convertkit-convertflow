<div style="background:#0F0F0F; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto; text-align:center;">
    
    <div style="margin-bottom:80px;">
      <h2 style="font-family:'Space Grotesk', sans-serif; font-size:clamp(32px, 4vw, 48px); font-weight:700; color:#FFFFFF; margin:0 0 16px 0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="te-reviews-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:24px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#1A1A1A; padding:40px; border-radius:16px; border:1px solid rgba(255,255,255,0.05); text-align:left; position:relative;">
          
          <div style="display:flex; gap:4px; margin-bottom:24px; color:#3B82F6; font-size:20px;">
            ★ ★ ★ ★ ★
          </div>
          
          <p style="font-family:'Space Grotesk', sans-serif; font-size:18px; font-weight:500; line-height:1.6; color:#FFFFFF; margin:0 0 32px 0;">
            "{{ block.settings.quote }}"
          </p>
          
          <div style="display:flex; align-items:center; gap:16px; border-top:1px solid rgba(255,255,255,0.05); padding-top:24px;">
            <div style="font-family:'Space Grotesk', sans-serif; font-size:14px; font-weight:700; color:#9CA3AF; text-transform:uppercase; letter-spacing:1px;">
              {{ block.settings.author }}
            </div>
          </div>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    @media (max-width: 990px) {
      .te-reviews-grid { grid-template-columns: 1fr; gap: 24px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Tech Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What the Experts Say"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "A monumental leap forward in consumer technology."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "TechRadar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tech Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
