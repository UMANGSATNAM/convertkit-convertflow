<div style="padding:60px 20px 100px;background:var(--el-bg);min-height:60vh;border-bottom:1px solid var(--el-border)"><div style="max-width:960px;margin:0 auto">
  <h1 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(28px,4vw,40px);font-weight:700;color:var(--el-white);text-align:center;margin-bottom:56px;letter-spacing:-0.02em;text-transform:uppercase">Hardware Rack</h1>
  {%- if cart.item_count == 0 -%}<div style="text-align:center;padding:80px 20px"><div style="font-size:40px;margin-bottom:24px;filter:grayscale(1)">🖥️</div><h2 style="font-family:'Space Grotesk',sans-serif;font-size:28px;font-weight:700;color:var(--el-white);margin-bottom:12px;letter-spacing:-0.02em;text-transform:uppercase">Your rack is empty</h2><p style="font-family:'Space Grotesk',sans-serif;color:var(--el-muted);margin-bottom:36px;font-weight:500">Add studio synthesizers, wireless soundstages, and modular MIDI rigs to your order.</p><a href="/collections/all" class="el-btn">EXPLORE DEVICES</a></div>
  {%- else -%}
  <div style="display:grid;grid-template-columns:1fr 380px;gap:48px;align-items:start">
    <div>{%- for item in cart.items -%}<div style="display:flex;gap:24px;padding:28px 0;border-bottom:1px solid var(--el-border);align-items:center"><a href="{{ item.url }}" style="flex-shrink:0"><img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="100" style="object-fit:contain;background:var(--el-charcoal);padding:10px;border:1px solid var(--el-border);border-radius:4px"></a><div style="flex:1;min-width:0"><a href="{{ item.url }}" style="text-decoration:none;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:16px;color:var(--el-white);display:block;margin-bottom:4px;text-transform:uppercase">{{ item.product.title }}</a>{%- unless item.variant.title == 'Default Title' -%}<div style="font-family:'Space Grotesk',sans-serif;font-size:12px;color:var(--el-muted);margin-bottom:12px;font-weight:500">{{ item.variant.title }}</div>{%- endunless -%}<div style="display:flex;align-items:center;gap:16px"><div style="display:flex;align-items:center;border:1px solid var(--el-border);overflow:hidden;background:var(--el-charcoal);border-radius:4px"><button type="button" style="width:32px;height:36px;background:none;border:none;color:#fff;cursor:pointer;font-size:16px">−</button><span style="width:32px;text-align:center;font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:700;color:#fff">{{ item.quantity }}</span><button type="button" style="width:32px;height:36px;background:none;border:none;color:#fff;cursor:pointer;font-size:16px">+</button></div><a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" style="font-family:'Space Grotesk',sans-serif;font-size:11px;color:var(--el-muted);text-transform:uppercase;letter-spacing:0.05em;text-decoration:underline;font-weight:700">Remove</a></div></div><div style="font-family:'Space Grotesk',sans-serif;font-size:16px;font-weight:700;color:var(--el-cyan)">{{ item.final_line_price | money }}</div></div>{%- endfor -%}</div>
    <div style="background:var(--el-charcoal);padding:40px;border:1px solid var(--el-border);border-radius:4px;position:sticky;top:120px">
      <h3 style="font-family:'Space Grotesk',sans-serif;font-size:18px;font-weight:900;color:var(--el-white);margin-bottom:28px;text-transform:uppercase">Rack Summary</h3>
      <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-family:'Space Grotesk',sans-serif;font-size:14px;font-weight:500"><span style="color:var(--el-muted)">Subtotal</span><span style="font-weight:700;color:var(--el-white)">{{ cart.total_price | money }}</span></div>
      <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-family:'Space Grotesk',sans-serif;font-size:14px;font-weight:500"><span style="color:var(--el-muted)">Secure Tech Dispatch</span><span style="font-weight:700;color:var(--el-cyan)">Free</span></div>
      <div style="padding-top:20px;border-top:1px solid var(--el-border);margin-top:20px;display:flex;justify-content:space-between;margin-bottom:32px"><span style="font-family:'Space Grotesk',sans-serif;font-size:18px;font-weight:900;color:var(--el-white);text-transform:uppercase">Total</span><span style="font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:900;color:var(--el-cyan)">{{ cart.total_price | money }}</span></div>
      <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="el-btn" style="width:100%;justify-content:center">CHECKOUT</button></form>
      <div style="display:flex;flex-direction:column;gap:8px;margin-top:24px;text-align:center"><span style="font-size:11px;font-family:'Space Grotesk',sans-serif;font-weight:800;color:var(--el-muted)">✓ raw hardware calibration guarantee</span><span style="font-size:11px;font-family:'Space Grotesk',sans-serif;font-weight:800;color:var(--el-muted)">🚚 carbon neutral express secure dispatch</span></div>
    </div>
  </div>{%- endif -%}
</div></div>
{% schema %}
{"name":"Electronics Cart","settings":[],"presets":[{"name":"Electronics Cart"}]}
{% endschema %}
