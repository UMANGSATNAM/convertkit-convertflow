<div style="position:relative;background:var(--tech-bg);min-height:90vh;display:flex;align-items:center;padding:80px 60px;overflow:hidden">
  
  <!-- Glowing Background Orbs -->
  <div style="position:absolute;top:20%;right:10%;width:400px;height:400px;background:var(--tech-accent);filter:blur(150px);opacity:0.15;border-radius:50%;z-index:0"></div>
  <div style="position:absolute;bottom:-10%;left:5%;width:500px;height:500px;background:#8A2BE2;filter:blur(200px);opacity:0.1;border-radius:50%;z-index:0"></div>

  <div style="max-width:1400px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;position:relative;z-index:2">
    <div>
      <div class="tech-spec" style="margin-bottom:16px"><span style="display:inline-block;width:8px;height:8px;background:var(--tech-accent);border-radius:50%;margin-right:8px;box-shadow:0 0 10px var(--tech-accent)"></span> {{ section.settings.overline | default: 'SYSTEM.ONLINE // V2.0' }}</div>
      <h1 class="tech-head" style="font-size:clamp(40px, 5vw, 72px);margin-bottom:24px;line-height:1.1">
        {{ section.settings.heading | default: 'Next-Gen<br>Performance.' }}
      </h1>
      <p style="font-size:18px;line-height:1.6;color:var(--tech-muted);margin-bottom:48px;max-width:480px">
        {{ section.settings.text | default: 'Engineered for ultimate fidelity. Experience zero-latency connectivity with our newest quantum core processors.' }}
      </p>
      <div style="display:flex;gap:24px">
        <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="tech-btn">{{ section.settings.btn1_text | default: 'INITIALIZE PURCHASE' }}</a>
      </div>
      
      <!-- Tech Stats -->
      <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:24px;margin-top:60px;padding-top:40px;border-top:1px solid var(--tech-border)">
        <div>
          <div class="tech-spec" style="color:#FFF;font-size:24px;margin-bottom:4px">0.1ms</div>
          <div style="font-size:12px;color:var(--tech-muted)">Latency</div>
        </div>
        <div>
          <div class="tech-spec" style="color:#FFF;font-size:24px;margin-bottom:4px">120Hz</div>
          <div style="font-size:12px;color:var(--tech-muted)">Refresh Rate</div>
        </div>
        <div>
          <div class="tech-spec" style="color:#FFF;font-size:24px;margin-bottom:4px">4K</div>
          <div style="font-size:12px;color:var(--tech-muted)">Resolution</div>
        </div>
      </div>
    </div>
    
    <div class="tech-glass-panel" style="padding:40px;position:relative">
      <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/tech-hero.png?v=1717283400" alt="Tech Device" style="width:100%;height:auto;filter:drop-shadow(0 20px 40px rgba(0,0,0,0.5))">
      
      <!-- Floating Glass Tags -->
      <div class="tech-glass-panel" style="position:absolute;top:20px;left:-30px;padding:12px 20px;display:flex;align-items:center;gap:12px">
        <div style="width:12px;height:12px;border:2px solid var(--tech-accent);border-radius:50%"></div>
        <div>
          <div class="tech-spec" style="font-size:10px;color:var(--tech-muted)">PROCESSOR</div>
          <div class="tech-head" style="font-size:14px;color:#FFF">M4 Neural Core</div>
        </div>
      </div>
      
      <div class="tech-glass-panel" style="position:absolute;bottom:40px;right:-30px;padding:12px 20px;display:flex;align-items:center;gap:12px">
        <div style="width:12px;height:12px;border:2px solid #8A2BE2;border-radius:50%"></div>
        <div>
          <div class="tech-spec" style="font-size:10px;color:var(--tech-muted)">BATTERY</div>
          <div class="tech-head" style="font-size:14px;color:#FFF">48H Active</div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Electronics Tech Hero",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline Text",
      "default": "SYSTEM.ONLINE // V2.0"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Next-Gen<br>Performance."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Engineered for ultimate fidelity."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button Text",
      "default": "INITIALIZE PURCHASE"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Electronics Tech Hero"
    }
  ]
}
{% endschema %}
