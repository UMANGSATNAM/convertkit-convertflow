<div style="background:#000000; padding:100px 24px; border-top:1px solid rgba(255,255,255,0.05); border-bottom:1px solid rgba(255,255,255,0.05);">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Space Grotesk', sans-serif; font-size:clamp(32px, 4vw, 48px); font-weight:700; color:#FFFFFF; margin:0 0 16px 0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="te-specs-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 4 }}, 1fr); gap:1px; background:rgba(255,255,255,0.05);">
      
      {%- for block in section.blocks -%}
        <div style="background:#0F0F0F; padding:40px; text-align:center; position:relative; overflow:hidden;" class="te-spec-card">
          
          <!-- Subtle glow on hover -->
          <div style="position:absolute; inset:0; background:radial-gradient(circle at center, rgba(59,130,246,0.1) 0%, transparent 70%); opacity:0; transition:opacity 0.3s ease;" class="te-spec-glow"></div>
          
          <div style="position:relative; z-index:2;">
            <div style="color:#3B82F6; font-size:32px; margin-bottom:24px;">
              {%- assign idx = forloop.index | modulo: 4 -%}
              {% if idx == 1 %}🖥️{% elsif idx == 2 %}⚡{% elsif idx == 3 %}🔊{% else %}⚖️{% endif %}
            </div>
            
            <h3 style="font-family:'Space Grotesk', sans-serif; font-size:16px; font-weight:600; color:#FFFFFF; margin:0 0 8px 0; text-transform:uppercase; letter-spacing:1px;">
              {{ block.settings.title }}
            </h3>
            
            <p style="font-family:'Inter', sans-serif; font-size:16px; font-weight:300; color:#9CA3AF; margin:0;">
              {{ block.settings.desc }}
            </p>
          </div>
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .te-spec-card:hover .te-spec-glow { opacity: 1; }
    
    @media (max-width: 990px) {
      .te-specs-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .te-specs-grid { grid-template-columns: 1fr; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Tech Specs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Technical Specifications"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Specification",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Display"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Description",
          "default": "Micro-OLED 4K per eye"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tech Specs",
      "blocks": [
        { "type": "spec" },
        { "type": "spec" },
        { "type": "spec" },
        { "type": "spec" }
      ]
    }
  ]
}
{% endschema %}
