<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="cu-section-header"><span class="cu-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="cu-review-grid">{%- for block in section.blocks -%}<div class="cu-review-card" {{ block.shopify_attributes }}><div class="cu-review-card__stars">★★★★★</div><div class="cu-review-card__text">"{{ block.settings.quote }}"</div><div class="cu-review-card__author">{{ block.settings.name }}</div><div class="cu-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Clay Reviews","settings":[{"type":"text","id":"eyebrow","label":"HERITAGE REVIEWS"},{"type":"text","id":"heading","label":"Heading","default":"Artesian Reviews"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Clay Reviews","blocks":[{"type":"review","settings":{"quote":"Cooking biryani in this terracotta pot is a completely different experience. Flavor retention is spectacular.","name":"Aman K.","product":"Terracotta Cooking Pot"}},{"type":"review","settings":{"quote":"The water pitcher keeps water beautifully cool naturally. The earthy aroma is wonderful.","name":"Priya R.","product":"Traditional Water Pitcher"}},{"type":"review","settings":{"quote":"Stunning organic finish. Very sturdy and looks gorgeous as a center bowl on our dining table.","name":"David H.","product":"Artisanal Serving Bowl"}}]}]}
{% endschema %}
