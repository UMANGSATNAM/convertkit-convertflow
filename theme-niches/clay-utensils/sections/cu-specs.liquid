<div style="padding:80px 20px;background:var(--cu-dark)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="cu-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,4vw,48px);font-weight:400;color:var(--cu-sand);margin-bottom:20px;line-height:1.1;font-style:italic">{{ section.settings.heading }}</h2>
    <p style="font-family:'Outfit',sans-serif;font-size:15px;color:var(--cu-muted);line-height:1.7;max-width:440px;font-weight:400">{{ section.settings.body }}</p>
    <div class="cu-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="cu-stat" style="border-color:rgba(210,125,45,0.15);background:rgba(255,255,255,0.01)" {{ block.shopify_attributes }}><div class="cu-stat__num" style="color:var(--cu-clay)">{{ block.settings.number }}</div><div class="cu-stat__label" style="color:var(--cu-muted)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:8px;object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:1;background:var(--cu-muted);border-radius:8px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Clay Specs","settings":[{"type":"text","id":"eyebrow","label":"HERITAGE CRAFT"},{"type":"text","id":"heading","label":"Heading","default":"Slow Clay Baking."},{"type":"textarea","id":"body","label":"Body","default":"Traditional terracotta clay bake locks moisture and distributes heat evenly, balancing pH levels in organic alkaline cookery."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"8.0"},{"type":"text","id":"label","label":"Label","default":"pH Balance"}]}],"presets":[{"name":"Clay Specs","blocks":[{"type":"stat","settings":{"number":"8.0","label":"Alkaline pH"}},{"type":"stat","settings":{"number":"100%","label":"Natural Clay"}},{"type":"stat","settings":{"number":"850°C","label":"Kiln Fired"}},{"type":"stat","settings":{"number":"Lead","label":"Free Certified"}}]}]}
{% endschema %}
