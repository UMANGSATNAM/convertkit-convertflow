<div style="background:#FAF6F0; padding:100px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:60px;">
      <h2 style="font-family:'Georgia', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#2C3E2D; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      <div style="width:60px; height:2px; background:#8B9A84; margin:0 auto;"></div>
    </div>

    <div class="aw-category-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:30px;">
      
      {%- for block in section.blocks -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1608248593842-8021c64790bd?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1608248593842-8021c64790bd?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1596755389378-c31d21fd1273?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1615397323287-e25f778912eb?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <a href="{{ block.settings.link | default: '#' }}" class="aw-cat-card" style="display:block; text-decoration:none; text-align:center; group">
          <div style="position:relative; overflow:hidden; border-radius:200px 200px 0 0; padding-bottom:130%; margin-bottom:24px; background:#e8e1d7;">
            <img src="{{ block.settings.image | image_url: width: 600 | default: img_url }}" alt="{{ block.settings.title }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.8s ease; filter:sepia(20%) contrast(90%);" class="aw-cat-img" loading="lazy">
          </div>
          
          <h3 style="font-family:'Georgia', serif; font-size:20px; font-weight:400; color:#2C3E2D; margin:0; transition:color 0.3s ease;" class="aw-cat-title">
            {{ block.settings.title }}
          </h3>
        </a>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .aw-cat-card:hover .aw-cat-img { transform: scale(1.05); }
    .aw-cat-card:hover .aw-cat-title { color: #8B9A84; }
    
    @media (max-width: 990px) {
      .aw-category-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Ayurveda Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Holistic Care"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
