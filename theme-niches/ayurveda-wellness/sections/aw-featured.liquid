<div style="background:#FAF6F0; padding:100px 24px; position:relative;">
  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div class="aw-featured-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center;">
      
      <!-- Visuals -->
      <div style="position:relative; min-height:500px;">
        <div style="position:absolute; width:80%; height:80%; right:0; bottom:0; border:2px solid #8B9A84; border-radius:200px 200px 0 0; z-index:1;"></div>
        <img src="https://images.unsplash.com/photo-1629198688000-71f23e745b6e?auto=format&fit=crop&w=800&q=80" alt="Featured Product" style="position:absolute; width:80%; height:90%; left:0; top:0; object-fit:cover; border-radius:200px 200px 0 0; z-index:2; filter:sepia(10%); box-shadow:0 30px 60px rgba(44,62,45,0.1);" loading="lazy">
        
        <div style="position:absolute; bottom:40px; right:-20px; background:#2C3E2D; color:#FAF6F0; padding:24px; z-index:3; text-align:center; border-radius:50%; width:140px; height:140px; display:flex; flex-direction:column; justify-content:center; align-items:center;">
          <div style="font-family:'Georgia', serif; font-size:24px; font-weight:400; line-height:1;">100%</div>
          <div style="font-family:'Inter', sans-serif; font-size:10px; font-weight:600; letter-spacing:1px; text-transform:uppercase;">Natural</div>
        </div>
      </div>
      
      <!-- Content -->
      <div style="padding-left:40px;">
        <div style="display:inline-block; font-family:'Inter', sans-serif; font-size:12px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:#8B9A84; margin-bottom:24px;">
          {{ section.settings.eyebrow }}
        </div>
        
        <h2 style="font-family:'Georgia', serif; font-size:clamp(40px, 5vw, 64px); font-weight:400; line-height:1.1; color:#2C3E2D; margin:0 0 24px 0;">
          {{ section.settings.heading }}
        </h2>
        
        <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:400; line-height:1.8; color:#4a5c4b; margin-bottom:40px;">
          Our most potent formulation yet. A synergy of 12 wild-harvested botanicals designed to restore balance, enhance luminosity, and deeply nourish the skin barrier. 
        </p>
        
        <div style="display:flex; flex-direction:column; gap:16px; margin-bottom:40px; padding-bottom:40px; border-bottom:1px solid rgba(44,62,45,0.1);">
          <div style="display:flex; align-items:center; gap:12px;">
            <svg style="width:20px; height:20px; fill:#8B9A84;" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
            <span style="font-family:'Inter', sans-serif; font-size:15px; color:#2C3E2D;">Reduces inflammation and redness</span>
          </div>
          <div style="display:flex; align-items:center; gap:12px;">
            <svg style="width:20px; height:20px; fill:#8B9A84;" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
            <span style="font-family:'Inter', sans-serif; font-size:15px; color:#2C3E2D;">Restores natural lipid barrier</span>
          </div>
          <div style="display:flex; align-items:center; gap:12px;">
            <svg style="width:20px; height:20px; fill:#8B9A84;" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
            <span style="font-family:'Inter', sans-serif; font-size:15px; color:#2C3E2D;">Sourced from ethical artisan farms</span>
          </div>
        </div>
        
        <div style="display:flex; align-items:center; gap:32px;">
          <div style="font-family:'Georgia', serif; font-size:32px; font-weight:400; color:#2C3E2D;">$68.00</div>
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_url | default: '/products/radiance-nectar' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#2C3E2D; color:#FAF6F0; font-family:'Inter', sans-serif; font-size:13px; font-weight:500; letter-spacing:2px; text-transform:uppercase; text-decoration:none; padding:16px 40px; transition:all 0.4s ease;" class="aw-btn-primary">
              {{ section.settings.cta_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
      
    </div>
  </div>

  <style>
    .aw-btn-primary:hover { background: #4a5c4b; }
    
    @media (max-width: 990px) {
      .aw-featured-grid { grid-template-columns: 1fr; gap: 60px; }
      .aw-featured-grid > div:last-child { padding-left: 0; }
      .aw-featured-grid > div:first-child { max-width: 500px; margin: 0 auto; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Featured Wellness",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "AWARD WINNING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Radiance Nectar"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "ADD TO RITUAL"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Featured Wellness"
    }
  ]
}
{% endschema %}
