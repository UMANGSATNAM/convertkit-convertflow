<div style="background:#FAF6F0; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px;">
      <div>
        <div style="display:inline-block; font-family:'Inter', sans-serif; font-size:12px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:#8B9A84; margin-bottom:16px;">
          {{ section.settings.eyebrow }}
        </div>
        <h2 style="font-family:'Georgia', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#2C3E2D; margin:0; line-height:1;">
          {{ section.settings.heading }}
        </h2>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Inter', sans-serif; font-size:13px; font-weight:600; color:#2C3E2D; text-decoration:none; text-transform:uppercase; letter-spacing:2px; display:flex; align-items:center; gap:8px; border-bottom:1px solid #2C3E2D; padding-bottom:4px; transition:color 0.3s, border-color 0.3s;" class="aw-link-hover">
          {{ section.settings.cta_label }}
          <svg style="width:16px; height:16px; fill:currentColor;" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="square" fill="none"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="aw-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:40px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1629198688000-71f23e745b6e?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1629198688000-71f23e745b6e?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1615397323287-e25f778912eb?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1570194065650-d99fb4b8ccb0?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="aw-product-card" style="text-align:center; group">
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; border-radius:200px 200px 0 0; padding-bottom:130%; margin-bottom:24px; background:#e8e1d7;">
            <img src="{{ img_url }}" alt="Ayurva Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.8s ease;" class="aw-product-img" loading="lazy">
            <div style="position:absolute; bottom:0; left:0; width:100%; padding:16px; background:linear-gradient(to top, rgba(44,62,45,0.6), transparent); opacity:0; transition:opacity 0.3s ease;" class="aw-product-quickadd">
              <div style="background:#FAF6F0; color:#2C3E2D; font-family:'Inter', sans-serif; font-size:12px; font-weight:600; letter-spacing:1px; text-transform:uppercase; padding:12px; border-radius:4px;">Quick Add</div>
            </div>
          </a>
          
          <h3 style="font-family:'Georgia', serif; font-size:18px; font-weight:400; color:#2C3E2D; margin:0 0 8px 0;">
            {% if idx == 1 %}Radiance Nectar{% elsif idx == 2 %}Calming Bath Soak{% elsif idx == 3 %}Purifying Clay Mask{% else %}Adaptogen Blend{% endif %}
          </h3>
          <div style="font-family:'Inter', sans-serif; font-size:13px; font-weight:400; color:#8B9A84; margin-bottom:12px;">
            {% if idx == 1 %}Face Oil{% elsif idx == 2 %}Body Care{% elsif idx == 3 %}Skincare{% else %}Supplement{% endif %}
          </div>
          <div style="font-family:'Inter', sans-serif; font-size:15px; font-weight:500; color:#2C3E2D;">
            {% if idx == 1 %}$68.00{% elsif idx == 2 %}$34.00{% elsif idx == 3 %}$42.00{% else %}$55.00{% endif %}
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .aw-product-card:hover .aw-product-img { transform: scale(1.05); }
    .aw-product-card:hover .aw-product-quickadd { opacity: 1; }
    .aw-link-hover:hover { color: #8B9A84; border-color: #8B9A84; }
    
    @media (max-width: 1024px) {
      .aw-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px 20px !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Ayurveda Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "RITUAL ESSENTIALS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bestsellers"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP ALL RITUALS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Collection"
    }
  ]
}
{% endschema %}
