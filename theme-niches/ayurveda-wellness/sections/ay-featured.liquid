<div style="padding:80px 20px;background:var(--ay-warm-white)"><div style="max-width:1320px;margin:0 auto">
  <div class="ay-section-header"><p class="ay-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
  {%- assign col = collections[section.settings.collection] -%}
  <div class="ay-prod-grid">{%- for product in col.products limit: section.settings.count -%}<a href="{{ product.url }}" class="ay-prod-card"><div class="ay-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--ay-sage)"></div>{%- endif -%}</div><div class="ay-prod-card__name">{{ product.title }}</div><div class="ay-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div>
  <div style="text-align:center;margin-top:48px"><a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="ay-btn ay-btn--outline">{{ section.settings.cta_label }}</a></div>
</div></div>
{% schema %}
{"name":"AY Featured","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ORGANIC REMEDIES"},{"type":"text","id":"heading","label":"Heading","default":"Best Selling Elixirs"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"count","label":"Products","min":4,"max":12,"step":4,"default":8},{"type":"text","id":"cta_label","label":"CTA","default":"VIEW ALL FORMULAS"},{"type":"url","id":"cta_url","label":"CTA URL"}],"presets":[{"name":"AY Featured"}]}
{% endschema %}
