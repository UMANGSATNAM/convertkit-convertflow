<div style="background:#2C3E2D; color:#FAF6F0; padding:120px 24px; position:relative; overflow:hidden;">
  
  <svg style="position:absolute; width:150%; height:150%; top:-25%; left:-25%; fill:#8B9A84; opacity:0.05; z-index:1; animation:aw-spin-reverse 80s linear infinite;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
    <path d="M44.7,-76.4C58.8,-69.2,71.8,-59.1,81.3,-46.3C90.8,-33.5,96.8,-18.1,96.5,-2.8C96.2,12.5,89.5,27.6,80.1,40.7C70.6,53.8,58.3,64.9,44.5,73.1C30.7,81.3,15.3,86.6,0.3,86.1C-14.7,85.6,-29.4,79.3,-42.6,70.6C-55.8,61.9,-67.4,50.8,-75.7,37.6C-84,24.4,-89,9.1,-87.3,-5.4C-85.6,-19.9,-77.2,-33.6,-66.3,-44.6C-55.4,-55.6,-42,-63.9,-28.4,-71.4C-14.8,-78.9,-1,-85.6,13.1,-82.9C27.1,-80.2,40.8,-68.2,44.7,-76.4Z" transform="translate(100 100)" />
  </svg>

  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div class="aw-story-grid" style="display:grid; grid-template-columns:1fr 1.2fr; gap:80px; align-items:center;">
      
      <!-- Content -->
      <div style="padding-right:40px;">
        <div style="display:inline-block; font-family:'Inter', sans-serif; font-size:12px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:#8B9A84; margin-bottom:24px;">
          {{ section.settings.eyebrow }}
        </div>
        
        <h2 style="font-family:'Georgia', serif; font-size:clamp(40px, 5vw, 64px); font-weight:400; line-height:1.1; margin:0 0 32px 0;">
          {{ section.settings.heading }}
        </h2>
        
        <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:400; line-height:1.8; color:#cbd5e1; margin-bottom:48px;">
          {{ section.settings.body }}
        </p>
        
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:32px; margin-bottom:48px;">
          <div>
            <div style="font-family:'Georgia', serif; font-size:32px; color:#8B9A84; font-weight:400; margin-bottom:8px;">5,000+</div>
            <div style="font-family:'Inter', sans-serif; font-size:14px; text-transform:uppercase; letter-spacing:1px; color:#cbd5e1;">Years of Wisdom</div>
          </div>
          <div>
            <div style="font-family:'Georgia', serif; font-size:32px; color:#8B9A84; font-weight:400; margin-bottom:8px;">100%</div>
            <div style="font-family:'Inter', sans-serif; font-size:14px; text-transform:uppercase; letter-spacing:1px; color:#cbd5e1;">Wild Harvested</div>
          </div>
        </div>
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/pages/about' }}" style="display:inline-flex; align-items:center; justify-content:center; background:transparent; color:#FAF6F0; font-family:'Inter', sans-serif; font-size:13px; font-weight:500; letter-spacing:2px; text-transform:uppercase; text-decoration:none; padding:16px 40px; border:1px solid #FAF6F0; transition:all 0.4s ease;" class="aw-btn-outline">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
      
      <!-- Visuals -->
      <div style="position:relative; min-height:600px;">
        <div style="position:absolute; top:0; left:0; width:70%; height:70%; border-radius:200px 200px 0 0; overflow:hidden;">
          <img src="https://images.unsplash.com/photo-1596755389378-c31d21fd1273?auto=format&fit=crop&w=600&q=80" alt="Botanical Ingredients" style="width:100%; height:100%; object-fit:cover; filter:sepia(20%) contrast(90%);" loading="lazy">
        </div>
        <div style="position:absolute; bottom:0; right:0; width:60%; height:60%; border-radius:50%; overflow:hidden; border:8px solid #2C3E2D;">
          <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=600&q=80" alt="Ayurvedic Preparation" style="width:100%; height:100%; object-fit:cover; filter:sepia(20%) contrast(90%);" loading="lazy">
        </div>
      </div>
      
    </div>
  </div>

  <style>
    .aw-btn-outline:hover { background: #FAF6F0; color: #2C3E2D; }
    @keyframes aw-spin-reverse { 100% { transform: rotate(-360deg); } }
    
    @media (max-width: 990px) {
      .aw-story-grid { grid-template-columns: 1fr; gap: 60px; }
      .aw-story-grid > div:first-child { padding-right: 0; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Ayurveda Story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR HERITAGE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rooted in Tradition"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body Content",
      "default": "Born from 5,000 years of Ayurvedic wisdom, our formulations bridge the gap between ancient healing sciences and modern botanical chemistry. Every product is a testament to the healing power of nature."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "READ OUR STORY"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Story"
    }
  ]
}
{% endschema %}
