<div style="background:#e8e1d7; padding:120px 24px; position:relative;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div class="aw-routine-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
      
      <!-- Visuals -->
      <div style="position:relative; min-height:600px; display:flex; justify-content:center; align-items:center;">
        <div style="position:absolute; width:100%; height:100%; max-width:500px; background:#FAF6F0; border-radius:200px 200px 0 0; z-index:1;"></div>
        
        <img src="https://images.unsplash.com/photo-1515377905703-c4788e51af15?auto=format&fit=crop&w=800&q=80" alt="Morning Ritual" style="width:80%; height:auto; aspect-ratio:3/4; object-fit:cover; border-radius:200px 200px 0 0; position:relative; z-index:2; filter:sepia(10%); box-shadow:0 30px 60px rgba(44,62,45,0.1);" loading="lazy">
        
        <img src="https://images.unsplash.com/photo-1608248593842-8021c64790bd?auto=format&fit=crop&w=400&q=80" alt="Product Detail" style="position:absolute; bottom:40px; right:0; width:40%; aspect-ratio:1/1; object-fit:cover; border-radius:50%; z-index:3; border:8px solid #e8e1d7; box-shadow:0 20px 40px rgba(44,62,45,0.1);" loading="lazy">
      </div>
      
      <!-- Content -->
      <div>
        <div style="display:inline-block; font-family:'Inter', sans-serif; font-size:12px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:#8B9A84; margin-bottom:24px;">
          {{ section.settings.eyebrow }}
        </div>
        
        <h2 style="font-family:'Georgia', serif; font-size:clamp(40px, 5vw, 64px); font-weight:400; line-height:1.1; color:#2C3E2D; margin:0 0 32px 0;">
          {{ section.settings.heading }}
        </h2>
        
        <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:400; line-height:1.8; color:#4a5c4b; margin-bottom:48px;">
          {{ section.settings.body }}
        </p>
        
        <div style="display:flex; flex-direction:column; gap:32px; margin-bottom:48px;">
          
          <div style="display:flex; gap:24px;">
            <div style="font-family:'Georgia', serif; font-size:32px; color:#8B9A84; font-weight:400; line-height:1;">01</div>
            <div>
              <h4 style="font-family:'Georgia', serif; font-size:20px; font-weight:400; color:#2C3E2D; margin:0 0 8px 0;">Cleanse & Purify</h4>
              <p style="font-family:'Inter', sans-serif; font-size:15px; font-weight:400; color:#4a5c4b; line-height:1.6; margin:0;">Gently remove impurities with our botanically-infused cleansing balm, preparing the canvas for deep nourishment.</p>
            </div>
          </div>
          
          <div style="display:flex; gap:24px;">
            <div style="font-family:'Georgia', serif; font-size:32px; color:#8B9A84; font-weight:400; line-height:1;">02</div>
            <div>
              <h4 style="font-family:'Georgia', serif; font-size:20px; font-weight:400; color:#2C3E2D; margin:0 0 8px 0;">Nourish & Restore</h4>
              <p style="font-family:'Inter', sans-serif; font-size:15px; font-weight:400; color:#4a5c4b; line-height:1.6; margin:0;">Press 3-5 drops of Radiance Nectar into damp skin, allowing the wild-harvested oils to penetrate deeply.</p>
            </div>
          </div>
          
          <div style="display:flex; gap:24px;">
            <div style="font-family:'Georgia', serif; font-size:32px; color:#8B9A84; font-weight:400; line-height:1;">03</div>
            <div>
              <h4 style="font-family:'Georgia', serif; font-size:20px; font-weight:400; color:#2C3E2D; margin:0 0 8px 0;">Ground & Center</h4>
              <p style="font-family:'Inter', sans-serif; font-size:15px; font-weight:400; color:#4a5c4b; line-height:1.6; margin:0;">Complete the ritual with two drops of Adaptogen Elixir under the tongue to calm the nervous system.</p>
            </div>
          </div>
          
        </div>
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/collections/kits' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#2C3E2D; color:#FAF6F0; font-family:'Inter', sans-serif; font-size:13px; font-weight:500; letter-spacing:2px; text-transform:uppercase; text-decoration:none; padding:16px 40px; transition:all 0.4s ease;" class="aw-btn-primary">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
      
    </div>
  </div>

  <style>
    .aw-btn-primary:hover { background: #4a5c4b; }
    
    @media (max-width: 990px) {
      .aw-routine-grid { grid-template-columns: 1fr; gap: 60px; }
      .aw-routine-grid > div:first-child { min-height: 400px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Ayurveda Routine",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE AYURVA METHOD"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Morning Ritual"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body Content",
      "default": "A three-step Ayurvedic sequence to awaken the senses, purify the skin, and ground your energy for the day ahead."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "EXPLORE RITUALS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Routine"
    }
  ]
}
{% endschema %}
