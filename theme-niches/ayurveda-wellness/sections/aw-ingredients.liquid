<div style="background:#2C3E2D; padding:120px 24px; position:relative; overflow:hidden;">
  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div style="text-align:center; margin-bottom:80px; color:#FAF6F0;">
      <div style="display:inline-block; font-family:'Inter', sans-serif; font-size:12px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:#8B9A84; margin-bottom:24px;">
        {{ section.settings.eyebrow }}
      </div>
      <h2 style="font-family:'Georgia', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; margin:0;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="aw-ingredients-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:40px;">
      
      {%- for block in section.blocks -%}
        {%- assign idx = forloop.index | modulo: 3 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1611078512217-1510e9f16802?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1611078512217-1510e9f16802?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1596541571168-98f5b497edfe?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1515585868285-1d480e6113b2?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div style="text-align:center;" class="aw-ingredient-card">
          <div style="position:relative; width:200px; height:200px; margin:0 auto 32px auto; border-radius:50%; overflow:hidden; border:2px solid #8B9A84;">
            <img src="{{ img_url }}" alt="{{ block.settings.title }}" style="width:100%; height:100%; object-fit:cover; transition:transform 0.8s ease;" class="aw-ingredient-img" loading="lazy">
          </div>
          
          <h3 style="font-family:'Georgia', serif; font-size:24px; font-weight:400; color:#FAF6F0; margin:0 0 16px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Inter', sans-serif; font-size:15px; font-weight:400; color:#cbd5e1; line-height:1.6; margin:0 auto; max-width:300px;">
            {{ block.settings.desc }}
          </p>
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .aw-ingredient-card:hover .aw-ingredient-img { transform: scale(1.1); }
    
    @media (max-width: 990px) {
      .aw-ingredients-grid { grid-template-columns: 1fr; gap: 60px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Ayurveda Ingredients",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WILD HARVESTED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Potent Botanicals"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Ashwagandha"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "An adaptogenic herb that helps the body manage stress and restores natural balance."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Ingredients",
      "blocks": [
        { "type": "ingredient" },
        { "type": "ingredient" },
        { "type": "ingredient" }
      ]
    }
  ]
}
{% endschema %}
