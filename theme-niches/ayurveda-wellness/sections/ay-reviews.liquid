<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="ay-section-header"><p class="ay-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
  <div class="ay-review-grid">{%- for block in section.blocks -%}<div class="ay-review-card" {{ block.shopify_attributes }}><div class="ay-review-card__stars">{%- for i in (1..block.settings.rating) -%}★{%- endfor -%}</div><div class="ay-review-card__text">"{{ block.settings.quote }}"</div><div class="ay-review-card__author">{{ block.settings.name }}</div><div class="ay-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"AY Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"TESTIMONIALS"},{"type":"text","id":"heading","label":"Heading","default":"Stories of Healing"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"AY Reviews","blocks":[{"type":"review","settings":{"rating":5,"quote":"The Ashwagandha capsules restored my sleep and reduced daily stress remarkably. Pure magic.","name":"Sunita D.","product":"Ashwagandha KSM-66"}},{"type":"review","settings":{"rating":5,"quote":"Incredible taste and aroma. My daily tea routine is complete. Feels completely holistic.","name":"Devendra K.","product":"Tejas Herbal Tea"}},{"type":"review","settings":{"rating":5,"quote":"Amazing facial serum. My skin texture has completely cleared up in 3 weeks.","name":"Mira S.","product":"Kumkumadi Oil"}}]}]}
{% endschema %}
