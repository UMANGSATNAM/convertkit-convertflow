<div class="ay-hero">
  <div class="ay-hero__content">
    <p class="ay-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="ay-hero__title">{{ section.settings.heading }}</h1>
    <p class="ay-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="ay-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="ay-btn ay-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="ay-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--ay-sage)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"AY Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ANCIENT WISDOM"},{"type":"text","id":"heading","label":"Heading","default":"Balance Body & Mind"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Authentic Ayurvedic formulations scientifically refined for contemporary wellness. Sourced from organic herbs."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"SHOP ELIXIRS"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"OUR HERITAGE"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"AY Hero"}]}
{% endschema %}
