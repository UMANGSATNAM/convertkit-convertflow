<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="ay-section-header"><p class="ay-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
  <div class="ay-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="ay-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--ay-sage)"></div>{%- endif -%}<div class="ay-col-card__overlay"><span class="ay-col-card__title">{{ block.settings.title }}</span><span class="ay-col-card__cta">Explore →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"AY Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"HOLISTIC SOLUTIONS"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Health Goal"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Immunity Boosters"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"AY Collections","blocks":[{"type":"col","settings":{"title":"Immunity & Wellness"}},{"type":"col","settings":{"title":"Herbal Teas & Infusions"}},{"type":"col","settings":{"title":"Skincare & Elixirs"}}]}]}
{% endschema %}
