<div style="padding:80px 20px;background:var(--ay-forest)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <p class="ay-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 style="font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,48px);font-weight:400;color:var(--ay-ivory);margin-bottom:20px;line-height:1.15">{{ section.settings.heading }}</h2>
    <p style="font-size:16px;color:var(--ay-sage);line-height:1.8;max-width:440px">{{ section.settings.body }}</p>
    <div class="ay-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="ay-stat" style="border-color:rgba(226,219,208,0.15);background:rgba(255,255,255,0.03)" {{ block.shopify_attributes }}><div class="ay-stat__num" style="color:var(--ay-accent)">{{ block.settings.number }}</div><div class="ay-stat__label" style="color:var(--ay-sage)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:24px;object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:4/5;background:var(--ay-dark);border-radius:24px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"AY Process","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"OUR METHOD"},{"type":"text","id":"heading","label":"Heading","default":"Ethically Sourced, Purely Crafted"},{"type":"textarea","id":"body","label":"Body","default":"We source native botanicals at their peak potency from chemical-free organic farms in India, utilizing traditional extraction processes to protect therapeutic benefits."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"100%"},{"type":"text","id":"label","label":"Label","default":"Organic"}]}],"presets":[{"name":"AY Process","blocks":[{"type":"stat","settings":{"number":"100%","label":"Organic"}},{"type":"stat","settings":{"number":"5000yr","label":"Heritage"}},{"type":"stat","settings":{"number":"Lab","label":"Tested"}},{"type":"stat","settings":{"number":"Zero","label":"Chemicals"}}]}]}
{% endschema %}
