<div style="background:#e8e1d7; padding:120px 24px; position:relative;">
  <div style="max-width:1440px; margin:0 auto; text-align:center;">
    
    <div style="margin-bottom:60px;">
      <h2 style="font-family:'Georgia', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#2C3E2D; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      <div style="width:60px; height:2px; background:#8B9A84; margin:0 auto;"></div>
    </div>

    <div class="aw-reviews-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:40px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#FAF6F0; padding:48px 32px; border-radius:16px; position:relative; box-shadow:0 10px 30px rgba(44,62,45,0.05); text-align:left;">
          
          <svg style="width:40px; height:40px; fill:#8B9A84; opacity:0.3; margin-bottom:24px;" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
          
          <p style="font-family:'Georgia', serif; font-size:18px; line-height:1.6; color:#2C3E2D; margin:0 0 32px 0; font-style:italic;">
            "{{ block.settings.quote }}"
          </p>
          
          <div style="display:flex; align-items:center; gap:16px;">
            <div style="width:40px; height:40px; background:#2C3E2D; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#FAF6F0; font-family:'Inter', sans-serif; font-weight:600; font-size:14px;">
              {{ block.settings.name | slice: 0, 1 }}
            </div>
            <div>
              <div style="font-family:'Inter', sans-serif; font-size:14px; font-weight:600; color:#2C3E2D; letter-spacing:1px; text-transform:uppercase;">
                {{ block.settings.name }}
              </div>
              <div style="display:flex; gap:2px; margin-top:4px;">
                <svg style="width:12px; height:12px; fill:#8B9A84;" viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
                <svg style="width:12px; height:12px; fill:#8B9A84;" viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
                <svg style="width:12px; height:12px; fill:#8B9A84;" viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
                <svg style="width:12px; height:12px; fill:#8B9A84;" viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
                <svg style="width:12px; height:12px; fill:#8B9A84;" viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
              </div>
            </div>
          </div>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    @media (max-width: 990px) {
      .aw-reviews-grid { grid-template-columns: 1fr; gap: 30px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Ayurveda Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Community Voices"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The Radiance Nectar transformed my skin. It's not just skincare, it's a grounding morning ritual."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "ELENA S."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
