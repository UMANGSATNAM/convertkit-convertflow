<div style="background:#FAF6F0; position:relative; overflow:hidden; min-height:85vh; display:flex; align-items:center;">
  
  <div style="max-width:1440px; margin:0 auto; width:100%; padding:40px 24px; position:relative; z-index:2;">
    <div class="aw-hero-grid" style="display:grid; grid-template-columns:1.2fr 1fr; gap:60px; align-items:center;">
      
      <!-- Content -->
      <div style="padding-right:40px;">
        <div style="display:inline-block; font-family:'Inter', sans-serif; font-size:12px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:#8B9A84; margin-bottom:24px;">
          {{ section.settings.eyebrow }}
        </div>

        <h1 style="font-family:'Georgia', serif; font-size:clamp(48px, 6vw, 80px); font-weight:400; line-height:1.1; color:#2C3E2D; margin:0 0 24px 0;">
          {{ section.settings.heading }}
        </h1>
        
        <p style="font-family:'Inter', sans-serif; font-size:clamp(16px, 2vw, 18px); font-weight:400; color:#4a5c4b; line-height:1.8; margin:0 0 40px 0; max-width:480px;">
          {{ section.settings.subheading }}
        </p>

        <div class="aw-hero-actions" style="display:flex; gap:20px; align-items:center;">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#2C3E2D; color:#FAF6F0; font-family:'Inter', sans-serif; font-size:13px; font-weight:500; letter-spacing:2px; text-transform:uppercase; text-decoration:none; padding:16px 40px; transition:all 0.4s ease;" class="aw-btn-primary">
              {{ section.settings.cta_label }}
            </a>
          {%- endif -%}
          
          {%- if section.settings.cta_label_2 != blank -%}
            <a href="{{ section.settings.cta_url_2 | default: '/pages/quiz' }}" style="display:inline-flex; align-items:center; justify-content:center; background:transparent; color:#2C3E2D; font-family:'Inter', sans-serif; font-size:13px; font-weight:500; letter-spacing:2px; text-transform:uppercase; text-decoration:none; padding:16px 40px; border:1px solid #2C3E2D; transition:all 0.4s ease;" class="aw-btn-secondary">
              {{ section.settings.cta_label_2 }}
            </a>
          {%- endif -%}
        </div>
      </div>
      
      <!-- Visuals -->
      <div style="position:relative; height:100%; min-height:600px; display:flex; justify-content:flex-end; align-items:center;">
        
        <!-- Background organic shape -->
        <svg style="position:absolute; width:120%; height:120%; top:-10%; left:-10%; fill:#8B9A84; opacity:0.1; z-index:1; animation:aw-spin 60s linear infinite;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
          <path d="M44.7,-76.4C58.8,-69.2,71.8,-59.1,81.3,-46.3C90.8,-33.5,96.8,-18.1,96.5,-2.8C96.2,12.5,89.5,27.6,80.1,40.7C70.6,53.8,58.3,64.9,44.5,73.1C30.7,81.3,15.3,86.6,0.3,86.1C-14.7,85.6,-29.4,79.3,-42.6,70.6C-55.8,61.9,-67.4,50.8,-75.7,37.6C-84,24.4,-89,9.1,-87.3,-5.4C-85.6,-19.9,-77.2,-33.6,-66.3,-44.6C-55.4,-55.6,-42,-63.9,-28.4,-71.4C-14.8,-78.9,-1,-85.6,13.1,-82.9C27.1,-80.2,40.8,-68.2,44.7,-76.4Z" transform="translate(100 100)" />
        </svg>

        <div style="position:relative; z-index:2; width:85%; aspect-ratio:4/5; overflow:hidden; border-radius:200px 200px 0 0;">
          <img src="https://images.unsplash.com/photo-1598440947619-2ce65f90fff1?auto=format&fit=crop&w=800&q=80" alt="Ayurvedic Wellness" style="width:100%; height:100%; object-fit:cover; filter:sepia(10%) contrast(90%);" class="aw-hero-img" loading="eager">
        </div>
        
        <div style="position:absolute; z-index:3; bottom:40px; left:0; background:#FAF6F0; padding:24px; box-shadow:0 20px 40px rgba(44,62,45,0.08); max-width:240px;">
          <div style="font-family:'Inter', sans-serif; font-size:10px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:#8B9A84; margin-bottom:8px;">PURE INGREDIENTS</div>
          <div style="font-family:'Georgia', serif; font-size:16px; color:#2C3E2D; line-height:1.4;">Wild-harvested botanicals sourced ethically from artisan farmers.</div>
        </div>
      </div>
      
    </div>
  </div>

  <style>
    .aw-btn-primary:hover { background: #4a5c4b; }
    .aw-btn-secondary:hover { background: #2C3E2D; color: #FAF6F0; }
    @keyframes aw-spin { 100% { transform: rotate(360deg); } }
    
    @media (max-width: 990px) {
      .aw-hero-grid { grid-template-columns: 1fr; gap: 40px; text-align: center; }
      .aw-hero-grid > div:first-child { padding-right: 0; }
      .aw-hero-actions { justify-content: center; }
      .aw-hero-grid > div:last-child { min-height: 400px; justify-content: center; }
    }
    @media (max-width: 640px) {
      .aw-hero-actions { flex-direction: column; width: 100%; align-items: stretch; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Ayurveda Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ANCIENT WISDOM, MODERN WELLNESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Return to Balance"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Holistic Ayurvedic formulations crafted from wild-harvested botanicals to harmonize mind, body, and spirit."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary Button Label",
      "default": "SHOP THE APOTHECARY"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "cta_label_2",
      "label": "Secondary Button Label",
      "default": "DISCOVER YOUR DOSHA"
    },
    {
      "type": "url",
      "id": "cta_url_2",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Ayurveda Hero"
    }
  ]
}
{% endschema %}
