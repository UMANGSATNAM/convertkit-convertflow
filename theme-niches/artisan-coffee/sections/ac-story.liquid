<div style="background:#EADCC8; color:#3E2723; padding:120px 24px;">
  <div style="max-width:1400px; margin:0 auto; display:grid; grid-template-columns:1.2fr 1fr; gap:80px; align-items:center;">
    
    <!-- Content -->
    <div style="order:2;">
      <div style="font-family:'Inter', sans-serif; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:2px; color:#D84315; margin-bottom:24px;">
        Origin
      </div>
      <h2 style="font-family:'Georgia', serif; font-size:clamp(36px, 5vw, 56px); font-weight:400; color:#3E2723; margin:0 0 32px 0; line-height:1.2;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:400; color:rgba(62,39,35,0.8); line-height:1.8; margin:0 0 40px 0; max-width:500px;">
        {{ section.settings.subheading }}
      </p>
      
      <a href="/pages/sourcing" style="display:inline-flex; align-items:center; justify-content:center; border:2px solid #3E2723; color:#3E2723; font-family:'Inter', sans-serif; font-size:14px; font-weight:600; text-transform:uppercase; letter-spacing:1px; padding:16px 32px; text-decoration:none; transition:all 0.3s ease; border-radius:4px;" class="ac-outline-btn">
        Learn More
      </a>
    </div>

    <!-- Image Grid -->
    <div style="order:1; display:grid; grid-template-columns:1fr 1fr; gap:20px;">
      <div style="display:flex; flex-direction:column; gap:20px; transform:translateY(40px);">
        <img src="https://images.unsplash.com/photo-1524350876685-274059332603?auto=format&fit=crop&w=600&q=80" alt="Farm" style="width:100%; aspect-ratio:3/4; object-fit:cover; border-radius:8px; filter:sepia(20%) contrast(1.1);" loading="lazy">
      </div>
      <div style="display:flex; flex-direction:column; gap:20px;">
        <img src="https://images.unsplash.com/photo-1611162458324-aae1eb4129a4?auto=format&fit=crop&w=600&q=80" alt="Process" style="width:100%; aspect-ratio:3/4; object-fit:cover; border-radius:8px; filter:sepia(20%) contrast(1.1);" loading="lazy">
      </div>
    </div>
    
  </div>

  <style>
    .ac-outline-btn:hover { background: #3E2723; color: #FAF6F0; }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1.2fr 1fr"] { grid-template-columns: 1fr; gap: 60px; }
      div[style*="order:2;"] { order: 1 !important; text-align: center; }
      div[style*="margin:0 0 40px 0; max-width:500px;"] { margin-left: auto; margin-right: auto; }
      div[style*="order:1; display:grid"] { order: 2 !important; }
      div[style*="transform:translateY(40px);"] { transform: translateY(0) !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Artisan Story",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sourced with Care"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Direct relationships with farmers ensure fair compensation and exceptional quality. We travel the world to find the best beans, so you can enjoy the best cup."
    }
  ],
  "presets": [
    {
      "name": "Artisan Story"
    }
  ]
}
{% endschema %}
