<div style="background:#FAF6F0; padding:120px 24px;">
  <div style="max-width:1400px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px; flex-wrap:wrap; gap:24px;">
      <div>
        <h2 style="font-family:'Georgia', serif; font-size:clamp(36px, 4vw, 48px); font-weight:400; color:#3E2723; margin:0 0 16px 0;">
          {{ section.settings.heading }}
        </h2>
        <p style="font-family:'Inter', sans-serif; font-size:16px; color:rgba(62,39,35,0.7); margin:0; max-width:400px;">
          Explore our current seasonal offerings, roasted to highlight their unique origin characteristics.
        </p>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Inter', sans-serif; font-size:14px; font-weight:600; text-transform:uppercase; letter-spacing:1px; color:#D84315; text-decoration:none; border-bottom:2px solid #D84315; padding-bottom:4px; transition:color 0.3s ease;" class="ac-link-btn">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="ac-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:32px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1559525839-b184a4d698c7?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1587049352847-81a56d773c1c?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1611162458324-aae1eb4129a4?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1559525839-b184a4d698c7?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1587049352847-81a56d773c1c?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="ac-product-card" style="display:flex; flex-direction:column; group; text-decoration:none;">
          
          <div style="position:relative; aspect-ratio:3/4; overflow:hidden; border-radius:8px; margin-bottom:24px; background:#F2EBE1;">
            <img src="{{ img_url }}" alt="Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.6s ease; mix-blend-mode:multiply;" class="ac-product-img" loading="lazy">
            <div style="position:absolute; top:16px; left:16px; background:#D84315; color:#FAF6F0; font-family:'Inter', sans-serif; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:1px; padding:4px 8px; border-radius:2px;">
              {% if idx == 1 %}Light Roast{% elsif idx == 2 %}Medium Roast{% elsif idx == 3 %}Dark Roast{% else %}Espresso{% endif %}
            </div>
            
            <div style="position:absolute; bottom:0; left:0; width:100%; background:rgba(62,39,35,0.9); padding:16px; transform:translateY(100%); transition:transform 0.3s ease; display:flex; justify-content:center;" class="ac-quick-add">
              <button style="background:transparent; border:none; color:#FAF6F0; font-family:'Inter', sans-serif; font-size:14px; font-weight:600; text-transform:uppercase; letter-spacing:1px; cursor:pointer;">Quick Add - $22</button>
            </div>
          </div>
          
          <h3 style="font-family:'Georgia', serif; font-size:24px; font-weight:400; color:#3E2723; margin:0 0 8px 0;">
            {% if idx == 1 %}Ethiopia Yirgacheffe{% elsif idx == 2 %}Colombia Supremo{% elsif idx == 3 %}Sumatra Mandheling{% else %}House Blend{% endif %}
          </h3>
          
          <div style="font-family:'Inter', sans-serif; font-size:14px; color:rgba(62,39,35,0.6); margin-bottom:12px;">
            {% if idx == 1 %}Jasmine, Peach, Black Tea{% elsif idx == 2 %}Chocolate, Caramel, Apple{% elsif idx == 3 %}Earthy, Cedar, Dark Chocolate{% else %}Balanced, Cocoa, Nutty{% endif %}
          </div>
          
          <div style="font-family:'Inter', sans-serif; font-size:16px; font-weight:600; color:#3E2723;">
            $22.00
          </div>
          
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .ac-product-card:hover .ac-product-img { transform: scale(1.05); }
    .ac-product-card:hover .ac-quick-add { transform: translateY(0); }
    .ac-link-btn:hover { color: #5C3A21; border-color: #5C3A21; }
    
    @media (max-width: 1024px) {
      .ac-product-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
    @media (max-width: 640px) {
      .ac-product-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Artisan Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Current Offerings"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL COFFEE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Artisan Collection"
    }
  ]
}
{% endschema %}
