<div style="background:#FAF6F0; color:#3E2723; position:relative; overflow:hidden;">
  
  <!-- Subtle texture overlay -->
  <div style="position:absolute; inset:0; background-image:url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22 opacity=%220.05%22/%3E%3C/svg%3E'); z-index:1; pointer-events:none;"></div>

  <div style="max-width:1400px; margin:0 auto; padding:80px 24px; display:grid; grid-template-columns:1fr 1fr; gap:60px; min-height:90vh; align-items:center; position:relative; z-index:2;">
    
    <!-- Content -->
    <div style="padding-right:40px;">
      <div style="font-family:'Inter', sans-serif; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:2px; color:#D84315; margin-bottom:24px; display:inline-flex; align-items:center; gap:12px;">
        <span style="width:30px; height:2px; background:#D84315;"></span>
        Small Batch Roastery
      </div>
      
      <h1 style="font-family:'Georgia', serif; font-size:clamp(48px, 6vw, 80px); font-weight:400; color:#3E2723; margin:0 0 32px 0; line-height:1.1; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h1>
      
      <p style="font-family:'Inter', sans-serif; font-size:clamp(16px, 2vw, 20px); font-weight:400; color:rgba(62,39,35,0.8); line-height:1.6; margin:0 0 48px 0; max-width:480px;">
        {{ section.settings.subheading }}
      </p>
      
      {%- if section.settings.cta_label != blank -%}
        <div style="display:flex; gap:24px; align-items:center; flex-wrap:wrap;">
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#3E2723; color:#FAF6F0; font-family:'Inter', sans-serif; font-size:14px; font-weight:600; text-transform:uppercase; letter-spacing:1px; padding:18px 40px; text-decoration:none; transition:all 0.3s ease; border-radius:4px;" class="ac-btn-primary">
            {{ section.settings.cta_label }}
          </a>
          <a href="#story" style="font-family:'Inter', sans-serif; font-size:14px; font-weight:600; text-transform:uppercase; letter-spacing:1px; color:#3E2723; text-decoration:none; border-bottom:2px solid #D84315; padding-bottom:4px; transition:all 0.3s ease;" class="ac-btn-secondary">
            Our Story
          </a>
        </div>
      {%- endif -%}
    </div>

    <!-- Image composition -->
    <div style="position:relative; height:100%; min-height:600px; display:flex; align-items:center; justify-content:center;">
      
      <!-- Organic shape background -->
      <div style="position:absolute; width:80%; height:80%; background:#EADCC8; border-radius:40% 60% 70% 30% / 40% 50% 60% 50%; z-index:1; animation:morph 8s ease-in-out infinite;"></div>
      
      <!-- Main image -->
      <div style="position:relative; z-index:2; width:70%; aspect-ratio:3/4; border-radius:200px 200px 0 0; overflow:hidden; box-shadow:0 30px 60px rgba(62,39,35,0.15);">
        <img src="https://images.unsplash.com/photo-1611162458324-aae1eb4129a4?auto=format&fit=crop&w=800&q=80" alt="Pour over coffee" style="width:100%; height:100%; object-fit:cover; filter:sepia(20%) contrast(1.1);" loading="eager" class="ac-hero-img">
      </div>
      
      <!-- Small accent image -->
      <div style="position:absolute; bottom:10%; right:10%; z-index:3; width:35%; aspect-ratio:1/1; border-radius:50%; overflow:hidden; border:8px solid #FAF6F0; box-shadow:0 20px 40px rgba(62,39,35,0.1);">
        <img src="https://images.unsplash.com/photo-1559525839-b184a4d698c7?auto=format&fit=crop&w=400&q=80" alt="Coffee beans" style="width:100%; height:100%; object-fit:cover;">
      </div>
      
    </div>
    
  </div>

  <style>
    .ac-btn-primary:hover { background: #5C3A21; transform: translateY(-2px); }
    .ac-btn-secondary:hover { color: #D84315; }
    .ac-hero-img { transition: transform 6s ease; }
    .ac-hero-img:hover { transform: scale(1.05); }
    
    @keyframes morph {
      0%, 100% { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; }
      34% { border-radius: 70% 30% 50% 50% / 30% 30% 70% 70%; }
      67% { border-radius: 100% 60% 60% 100% / 100% 100% 60% 60%; }
    }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; gap: 40px; text-align: center; }
      div[style*="padding-right:40px"] { padding-right: 0; }
      div[style*="margin:0 0 48px 0; max-width:480px"] { margin-left: auto; margin-right: auto; }
      div[style*="display:flex; gap:24px; align-items:center; flex-wrap:wrap;"] { justify-content: center; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Artisan Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Roasted with intention."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Ethically sourced, carefully roasted, and delivered fresh to your door."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP COFFEE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Artisan Hero"
    }
  ]
}
{% endschema %}
