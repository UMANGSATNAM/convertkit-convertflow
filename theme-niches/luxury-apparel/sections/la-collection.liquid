<div style="padding:80px 20px 0;background:var(--la-ivory)"><div style="max-width:1320px;margin:0 auto;text-align:center;padding-bottom:72px;border-bottom:1px solid var(--la-border)"><span class="la-eyebrow" style="margin-bottom:12px">{{ collection.title | upcase }}</span><h1 style="font-family:'Playfair Display',serif;font-size:clamp(32px,5vw,56px);font-weight:400;color:var(--la-dark);margin-bottom:16px;letter-spacing:-0.02em">{{ collection.title }}</h1>{%- if collection.description != blank -%}<p style="font-family:'Inter',sans-serif;font-size:14px;color:var(--la-muted);max-width:520px;margin:0 auto;line-height:1.7">{{ collection.description }}</p>{%- endif -%}</div></div>
<div style="padding:0 20px 100px;background:var(--la-ivory)"><div style="max-width:1320px;margin:0 auto"><div style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid var(--la-border);margin-bottom:48px"><div style="font-family:'Inter',sans-serif;font-size:12px;font-weight:600;letter-spacing:0.05em;color:var(--la-dark);text-transform:uppercase">{{ collection.products_count }} garments</div><select style="padding:10px 20px;border:1px solid var(--la-border);border-radius:0px;background:#fff;color:var(--la-dark);font-family:'Inter',sans-serif;font-size:12px;font-weight:600;letter-spacing:0.05em;cursor:pointer"><option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Newest</option></select></div><div class="la-prod-grid">{%- for product in collection.products -%}<a href="{{ product.url }}" class="la-prod-card"><div class="la-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--la-ivory)"></div>{%- endif -%}</div><div class="la-prod-card__name">{{ product.title }}</div><div class="la-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div></div></div>
{% schema %}
{"name":"Apparel Collection","settings":[],"presets":[{"name":"Apparel Collection"}]}
{% endschema %}
