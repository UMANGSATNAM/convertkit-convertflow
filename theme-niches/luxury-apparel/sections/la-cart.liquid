<div style="padding:60px 20px 100px;background:var(--la-ivory);min-height:60vh;border-bottom:1px solid var(--la-border)"><div style="max-width:960px;margin:0 auto">
  <h1 style="font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,40px);font-weight:400;color:var(--la-dark);text-align:center;margin-bottom:56px;letter-spacing:-0.01em">Your Wardrobe Drawer</h1>
  {%- if cart.item_count == 0 -%}<div style="text-align:center;padding:80px 20px"><div style="font-size:40px;margin-bottom:24px;filter:grayscale(1)">🧥</div><h2 style="font-family:'Playfair Display',serif;font-size:28px;font-weight:400;color:var(--la-dark);margin-bottom:12px">Your wardrobe drawer is empty</h2><p style="font-family:'Inter',sans-serif;color:var(--la-muted);margin-bottom:36px;font-size:14px">Baby cashmere coats, heavyweight silk blouses, and wool trousers await.</p><a href="/collections/all" class="la-btn">EXPLORE COUTURE</a></div>
  {%- else -%}
  <div style="display:grid;grid-template-columns:1fr 380px;gap:48px;align-items:start">
    <div>{%- for item in cart.items -%}<div style="display:flex;gap:24px;padding:28px 0;border-bottom:1px solid var(--la-border);align-items:center"><a href="{{ item.url }}" style="flex-shrink:0"><img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="133" style="object-fit:cover;background:#fff;padding:10px;border-radius:0;border:1px solid var(--la-border)"></a><div style="flex:1;min-width:0"><a href="{{ item.url }}" style="text-decoration:none;font-family:'Playfair Display',serif;font-size:16px;color:var(--la-dark);display:block;margin-bottom:4px">{{ item.product.title }}</a>{%- unless item.variant.title == 'Default Title' -%}<div style="font-family:'Inter',sans-serif;font-size:11px;color:var(--la-muted);margin-bottom:12px;text-transform:uppercase;letter-spacing:0.05em">{{ item.variant.title }}</div>{%- endunless -%}<div style="display:flex;align-items:center;gap:16px"><div style="display:flex;align-items:center;border:1px solid var(--la-border);overflow:hidden;border-radius:0px;background:#fff"><button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px">−</button><span style="width:32px;text-align:center;font-family:'Inter',sans-serif;font-size:13px;font-weight:700">{{ item.quantity }}</span><button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px">+</button></div><a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" style="font-family:'Inter',sans-serif;font-size:11px;color:var(--la-muted);text-transform:uppercase;letter-spacing:0.05em;text-decoration:underline;font-weight:600">Remove</a></div></div><div style="font-family:'Inter',sans-serif;font-size:15px;font-weight:600;color:var(--la-gold)">{{ item.final_line_price | money }}</div></div>{%- endfor -%}</div>
    <div style="background:#fff;padding:40px;border:1px solid var(--la-border);border-radius:0px;position:sticky;top:120px">
      <h3 style="font-family:'Playfair Display',serif;font-size:18px;font-weight:400;color:var(--la-dark);margin-bottom:28px">Wardrobe Summary</h3>
      <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-family:'Inter',sans-serif;font-size:13px;font-weight:600;letter-spacing:0.05em;text-transform:uppercase"><span style="color:var(--la-muted)">Subtotal</span><span style="color:var(--la-dark)">{{ cart.total_price | money }}</span></div>
      <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-family:'Inter',sans-serif;font-size:13px;font-weight:600;letter-spacing:0.05em;text-transform:uppercase"><span style="color:var(--la-muted)">Couture Delivery</span><span style="color:var(--la-gold)">Free</span></div>
      <div style="padding-top:20px;border-top:1px solid var(--la-border);margin-top:20px;display:flex;justify-content:space-between;margin-bottom:32px"><span style="font-family:'Playfair Display',serif;font-size:18px;color:var(--la-dark)">Total</span><span style="font-family:'Inter',sans-serif;font-size:18px;font-weight:600;color:var(--la-gold)">{{ cart.total_price | money }}</span></div>
      <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="la-btn" style="width:100%;justify-content:center">CHECKOUT</button></form>
      <div style="display:flex;flex-direction:column;gap:8px;margin-top:24px;text-align:center"><span style="font-size:11px;font-family:'Inter',sans-serif;font-weight:600;color:var(--la-muted);letter-spacing:0.05em;text-transform:uppercase">✓ complimentary white glove courier</span><span style="font-size:11px;font-family:'Inter',sans-serif;font-weight:600;color:var(--la-muted);letter-spacing:0.05em;text-transform:uppercase">🚚 carbon neutral couture shipping</span></div>
    </div>
  </div>{%- endif -%}
</div></div>
{% schema %}
{"name":"Apparel Cart","settings":[],"presets":[{"name":"Apparel Cart"}]}
{% endschema %}
