<div style="padding:100px 20px;background:var(--la-ivory);border-bottom:1px solid var(--la-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="la-section-header"><span class="la-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  {%- assign col = collections[section.settings.collection] -%}
  <div class="la-prod-grid">{%- for product in col.products limit: section.settings.count -%}<a href="{{ product.url }}" class="la-prod-card"><div class="la-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--la-ivory)"></div>{%- endif -%}</div><div class="la-prod-card__name">{{ product.title }}</div><div class="la-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div>
  <div style="text-align:center;margin-top:56px"><a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="la-btn la-btn--outline">{{ section.settings.cta_label }}</a></div>
</div></div>
{% schema %}
{"name":"Apparel Featured","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CURATED EDITS"},{"type":"text","id":"heading","label":"Heading","default":"Seasonal Staples"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"count","label":"Products","min":4,"max":12,"step":4,"default":8},{"type":"text","id":"cta_label","label":"CTA","default":"VIEW ALL COUTURE"},{"type":"url","id":"cta_url","label":"CTA URL"}],"presets":[{"name":"Apparel Featured"}]}
{% endschema %}
