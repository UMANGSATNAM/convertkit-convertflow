<div style="padding:100px 20px;background:#fff;border-bottom:1px solid var(--la-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="la-section-header"><span class="la-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="la-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="la-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--la-navy)"></div>{%- endif -%}<div class="la-col-card__overlay"><span class="la-col-card__title">{{ block.settings.title }}</span><span class="la-col-card__cta">Explore Collection</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Apparel Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE EDIT"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Silhouette"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Sartorial Coats"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Apparel Collections","blocks":[{"type":"col","settings":{"title":"Sartorial Overcoats"}},{"type":"col","settings":{"title":"Mongolian Knitwear"}},{"type":"col","settings":{"title":"Architectural Trousers"}}]}]}
{% endschema %}
