<div class="la-hero">
  <div class="la-hero__content">
    <span class="la-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="la-hero__title">{{ section.settings.heading }}</h1>
    <p class="la-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:16px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="la-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/heritage' }}" class="la-btn la-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="la-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image.alt | escape }}" width="1400" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:600px;background:var(--la-dark)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Apparel Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"AUTUMN / WINTER 2026"},{"type":"text","id":"heading","label":"The Cashmere Silhouette"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Hand-tailored coats spun from rare Mongolian baby cashmere. Designed for effortless architectural structure."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"THE COLLECTION"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"OUR HERITAGE"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Apparel Hero"}]}
{% endschema %}
