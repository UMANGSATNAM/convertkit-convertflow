<div style="padding:100px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="la-section-header"><span class="la-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="la-review-grid">{%- for block in section.blocks -%}<div class="la-review-card" {{ block.shopify_attributes }}><div class="la-review-card__stars">★★★★★</div><div class="la-review-card__text">"{{ block.settings.quote }}"</div><div class="la-review-card__author">{{ block.settings.name }}</div><div class="la-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Apparel Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CLIENT DIARIES"},{"type":"text","id":"heading","label":"Heading","default":"Testimonials of Sartorial Wear"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Apparel Reviews","blocks":[{"type":"review","settings":{"quote":"Beautiful drape. The cashmere overcoat feels incredibly soft yet holds its architectural structure perfectly.","name":"Alistair C.","product":"Baby Cashmere Overcoat"}},{"type":"review","settings":{"quote":"Heavyweight silk that moves with absolute grace. A stunning addition to my wardrobe.","name":"Marlowe V.","product":"Italian Silk Twill Blouse"}},{"type":"review","settings":{"quote":"Superb tailoring. The trousers fit like bespoke and the wool quality is outstanding.","name":"Julian K.","product":"Architectural Wool Trousers"}}]}]}
{% endschema %}
