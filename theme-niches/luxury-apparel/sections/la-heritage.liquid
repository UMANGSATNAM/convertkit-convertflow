<div style="padding:100px 20px;background:var(--la-navy)"><div style="max-width:1120px;margin:0 auto;display:grid;grid-template-columns:1fr 1.1fr;gap:80px;align-items:center">
  <div>
    <span class="la-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Playfair Display',serif;font-size:clamp(30px,4.5vw,52px);font-weight:400;color:var(--la-ivory);margin-bottom:28px;line-height:1.1">{{ section.settings.heading }}</h2>
    <p style="font-family:'Inter',sans-serif;font-size:14px;color:var(--la-muted);line-height:1.8;max-width:440px;margin-bottom:36px;letter-spacing:0.01em">{{ section.settings.body }}</p>
    <div class="la-stat-grid" style="background:rgba(255,255,255,0.08)">{%- for block in section.blocks -%}<div class="la-stat" style="background:var(--la-navy)" {{ block.shopify_attributes }}><div class="la-stat__num" style="color:var(--la-gold)">{{ block.settings.number }}</div><div class="la-stat__label" style="color:var(--la-muted)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" width="900" style="width:100%;object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:3/4;background:rgba(255,255,255,0.03)"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Apparel Heritage","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CRAFT INTEGRITY"},{"type":"text","id":"heading","label":"Slow Spun. Deep Comfort."},{"type":"textarea","id":"body","label":"Body","default":"Spun on heritage wooden spindles in Inner Mongolia, our baby cashmere has an exceptionally long fiber length (38mm) that naturally resists pilling and drapes with heavy liquidity."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"38mm"},{"type":"text","id":"label","label":"Label","default":"Fiber Length"}]}],"presets":[{"name":"Apparel Heritage","blocks":[{"type":"stat","settings":{"number":"38mm","label":"Cashmere Fiber"}},{"type":"stat","settings":{"number":"12 Ply","label":"Heavy Knit"}},{"type":"stat","settings":{"number":"Como","label":"Silk Weaving"}},{"type":"stat","settings":{"number":"Zero","label":"Nylon Blends"}}]}]}
{% endschema %}
