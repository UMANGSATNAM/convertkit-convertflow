<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="pet-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Outfit',sans-serif;font-size:clamp(28px,4vw,44px);font-weight:800;color:var(--pet-dark);margin-bottom:20px;line-height:1.2">{{ section.settings.heading }}</h2>
    <p style="font-family:'Fredoka',sans-serif;font-size:16px;color:var(--pet-muted);line-height:1.7;max-width:440px">{{ section.settings.body }}</p>
    <div class="pet-stat-grid">{%- for block in section.blocks -%}<div class="pet-stat" {{ block.shopify_attributes }}><div class="pet-stat__num">{{ block.settings.number }}</div><div class="pet-stat__label">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:24px;border:2px solid var(--pet-border)" loading="lazy">{%- else -%}<div style="aspect-ratio:4/3;background:var(--pet-cream);border-radius:24px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Pet Story","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CRAFTED WITH CARE"},{"type":"text","id":"heading","label":"Heading","default":"We Only Serve Real Food"},{"type":"textarea","id":"body","label":"Body","default":"No fillers, no artificial colors, no grains. Just raw, freeze-dried and pasture-raised ingredients slow-cooked to seal flavor and active nutrients."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"100%"},{"type":"text","id":"label","label":"Label","default":"Organic"}]}],"presets":[{"name":"Pet Story","blocks":[{"type":"stat","settings":{"number":"100%","label":"Human Grade"}},{"type":"stat","settings":{"number":"Grain","label":"Free Recipes"}},{"type":"stat","settings":{"number":"10K+","label":"Happy Pups"}},{"type":"stat","settings":{"number":"Vet","label":"Recommended"}}]}]}
{% endschema %}
