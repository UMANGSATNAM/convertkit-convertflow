<div style="padding:80px 20px;background:var(--pet-cream)"><div style="max-width:1320px;margin:0 auto">
  <div class="pet-section-header"><span class="pet-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="pet-review-grid">{%- for block in section.blocks -%}<div class="pet-review-card" {{ block.shopify_attributes }}><div class="pet-review-card__stars">★★★★★</div><div class="pet-review-card__text">"{{ block.settings.quote }}"</div><div class="pet-review-card__author">{{ block.settings.name }}</div><div class="pet-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Pet Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PARENTS VOICE"},{"type":"text","id":"heading","label":"Heading","default":"Approved by Real Pups"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Pet Reviews","blocks":[{"type":"review","settings":{"quote":"My golden retriever has a sensitive stomach, but this dehydrated raw food changed everything. Shiny coat!","name":"Sarah & Bella","product":"Dehydrated Beef Grub"}},{"type":"review","settings":{"quote":"The memory foam bed is fantastic. Rex doesn't sleep on our couch anymore. Highly recommend.","name":"David & Rex","product":"Orthopedic Bed"}},{"type":"review","settings":{"quote":"Super durable toys. Usually my pitbull destroys everything in minutes, but this rubber bone survived.","name":"Amit & Rocky","product":"Indestructible Toy"}}]}]}
{% endschema %}
