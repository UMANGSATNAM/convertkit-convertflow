<div class="pet-hero">
  <div class="pet-hero__content">
    <span class="pet-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="pet-hero__title">{{ section.settings.heading }}</h1>
    <p class="pet-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:14px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="pet-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="pet-btn pet-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="pet-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt | escape }}" width="1000" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:480px;background:var(--pet-yellow)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Pet Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"HEALTHY PETS, HAPPY HOMES"},{"type":"text","id":"heading","label":"Cozy Comfort For Paws"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Premium organic food, orthopedic beds, and non-toxic toys crafted for your best friend's wellness."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"SHOP DOG & CAT"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"OUR RECIPES"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Pet Hero"}]}
{% endschema %}
