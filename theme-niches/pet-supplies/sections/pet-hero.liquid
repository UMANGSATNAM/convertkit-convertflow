<div style="background:var(--pet-bg);min-height:90vh;display:flex;align-items:center;padding:80px 40px;position:relative;overflow:hidden">
  
  <div style="position:absolute;bottom:-10%;right:-5%;width:600px;height:600px;background:var(--pet-accent);border-radius:50%;opacity:0.1;z-index:0"></div>

  <div style="max-width:1200px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;position:relative;z-index:2">
    
    <div>
      <div class="pet-label" style="margin-bottom:16px">{{ section.settings.overline | default: '🐾 Happy Pets, Happy Homes' }}</div>
      <h1 class="pet-head" style="font-size:clamp(48px, 6vw, 72px);margin-bottom:24px;line-height:1.1">
        {{ section.settings.heading | default: 'Spoil Your<br>Best Friend.' }}
      </h1>
      <p style="font-size:18px;line-height:1.6;color:var(--pet-muted);margin-bottom:48px;max-width:480px">
        {{ section.settings.text | default: 'Premium nutrition, durable toys, and cozy beds designed for the health and happiness of your pets.' }}
      </p>
      <div style="display:flex;gap:24px;align-items:center">
        <a href="{{ section.settings.btn1_url | default: '/collections/dogs' }}" class="pet-btn">{{ section.settings.btn1_text | default: 'Shop Dogs' }}</a>
        <a href="{{ section.settings.btn2_url | default: '/collections/cats' }}" class="pet-btn" style="background:var(--pet-accent-alt);border-color:var(--pet-accent-alt);color:#FFF;box-shadow:0 8px 0px rgba(72, 209, 204, 0.3)">{{ section.settings.btn2_text | default: 'Shop Cats' }}</a>
      </div>
    </div>
    
    <div style="position:relative">
      <div style="background:#FFF8E7;border-radius:100px;padding:40px;box-shadow:0 20px 40px rgba(0,0,0,0.05);border:4px solid var(--pet-accent)">
        <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/pet-hero.png?v=1717283400" alt="Happy Pet" style="width:100%;height:auto;border-radius:60px">
      </div>
      
      <!-- Floating Badge -->
      <div style="position:absolute;top:20px;right:-20px;background:var(--pet-surface);padding:16px 24px;border-radius:100px;box-shadow:0 10px 30px rgba(0,0,0,0.1);display:flex;align-items:center;gap:12px;border:2px solid var(--pet-border)">
        <div style="width:16px;height:16px;background:var(--pet-accent-alt);border-radius:50%"></div>
        <div style="font-family:var(--font-h);font-weight:700;font-size:16px;color:var(--pet-text)">Vet Approved</div>
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Pet Supplies Hero",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline Text",
      "default": "🐾 Happy Pets, Happy Homes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Spoil Your<br>Best Friend."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Premium nutrition, durable toys, and cozy beds."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 Text",
      "default": "Shop Dogs"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 Text",
      "default": "Shop Cats"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Button 2 Link"
    }
  ],
  "presets": [
    {
      "name": "Pet Supplies Hero"
    }
  ]
}
{% endschema %}
