<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="pet-section-header"><span class="pet-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="pet-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="pet-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.title | escape }}" width="150" height="150" loading="lazy">{%- else -%}<div style="width:120px;height:120px;margin:0 auto 16px;background:var(--pet-cream);border-radius:50%"></div>{%- endif -%}<span class="pet-col-card__title">{{ block.settings.title }}</span><span class="pet-col-card__cta">Shop Now →</span></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Pet Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CATEGORIES"},{"type":"text","id":"heading","label":"Heading","default":"Curated Pet Care"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Dog Food"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Pet Collections","blocks":[{"type":"col","settings":{"title":"Nutritious Treats"}},{"type":"col","settings":{"title":"Orthopedic Beds"}},{"type":"col","settings":{"title":"Chew & Play Toys"}}]}]}
{% endschema %}
