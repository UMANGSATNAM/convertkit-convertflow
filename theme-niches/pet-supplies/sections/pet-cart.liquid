<div style="padding:48px 20px 80px;background:var(--pet-cream);min-height:60vh"><div style="max-width:960px;margin:0 auto">
  <h1 style="font-family:'Outfit',sans-serif;font-size:clamp(28px,4vw,44px);font-weight:800;color:var(--pet-dark);text-align:center;margin-bottom:48px">Your Box</h1>
  {%- if cart.item_count == 0 -%}<div style="text-align:center;padding:80px 20px"><div style="font-size:48px;margin-bottom:20px">📦</div><h2 style="font-family:'Outfit',sans-serif;font-size:28px;font-weight:800;color:var(--pet-dark);margin-bottom:12px">Box is empty</h2><p style="color:var(--pet-muted);margin-bottom:32px">Let's find some treats or toys for your furry friend</p><a href="/collections/all" class="pet-btn">SHOP REMEDIES</a></div>
  {%- else -%}
  <div style="display:grid;grid-template-columns:1fr 380px;gap:48px;align-items:start">
    <div>{%- for item in cart.items -%}<div style="display:flex;gap:20px;padding:24px 0;border-bottom:2px solid var(--pet-border);align-items:center"><a href="{{ item.url }}" style="flex-shrink:0"><img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="100" style="border-radius:12px;object-fit:cover"></a><div style="flex:1;min-width:0"><a href="{{ item.url }}" style="text-decoration:none;font-family:'Outfit',sans-serif;font-size:15px;font-weight:700;color:var(--pet-dark);display:block;margin-bottom:4px">{{ item.product.title }}</a>{%- unless item.variant.title == 'Default Title' -%}<div style="font-size:13px;color:var(--pet-muted);margin-bottom:8px">{{ item.variant.title }}</div>{%- endunless -%}<div style="display:flex;align-items:center;gap:12px"><div style="display:flex;align-items:center;border:2px solid var(--pet-dark);border-radius:12px;background:#fff;overflow:hidden"><button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px">−</button><span style="width:32px;text-align:center;font-size:14px;font-weight:700">{{ item.quantity }}</span><button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px">+</button></div><a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" style="font-size:12px;color:var(--pet-muted);text-decoration:underline">Remove</a></div></div><div style="font-size:16px;font-weight:700;color:var(--pet-orange)">{{ item.final_line_price | money }}</div></div>{%- endfor -%}</div>
    <div style="background:#fff;border-radius:24px;padding:32px;border:2px solid var(--pet-border);position:sticky;top:120px;box-shadow:0 8px 0 var(--pet-dark)">
      <h3 style="font-family:'Outfit',sans-serif;font-size:16px;font-weight:800;color:var(--pet-dark);margin-bottom:24px">Box Summary</h3>
      <div style="display:flex;justify-content:space-between;margin-bottom:12px;font-size:14px"><span style="color:var(--pet-muted)">Subtotal</span><span style="font-weight:700">{{ cart.total_price | money }}</span></div>
      <div style="display:flex;justify-content:space-between;margin-bottom:12px;font-size:14px"><span style="color:var(--pet-muted)">Shipping</span><span style="font-weight:700;color:var(--pet-green)">Free</span></div>
      <div style="padding-top:16px;border-top:2px solid var(--pet-border);margin-top:16px;display:flex;justify-content:space-between;margin-bottom:24px"><span style="font-size:16px;font-weight:800">Total</span><span style="font-size:20px;font-weight:800;color:var(--pet-dark)">{{ cart.total_price | money }}</span></div>
      <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="pet-btn" style="width:100%;justify-content:center">CHECKOUT</button></form>
      <div style="display:flex;justify-content:center;gap:14px;margin-top:16px"><span style="font-size:11px;color:var(--pet-muted)">✓ 100% Organic</span><span style="font-size:11px;color:var(--pet-muted)">🚚 Free Ship</span><span style="font-size:11px;color:var(--pet-muted)">↩ Eco Safe</span></div>
    </div>
  </div>{%- endif -%}
</div></div>
{% schema %}
{"name":"Pet Cart","settings":[],"presets":[{"name":"Pet Cart"}]}
{% endschema %}
