<div style="background:#FF6B6B; padding:120px 24px; position:relative; overflow:hidden;">
  
  <!-- Decorative background -->
  <div style="position:absolute; top:0; left:0; width:100%; height:100%; opacity:0.05; background-image:url('data:image/svg+xml;utf8,<svg viewBox=\"0 0 24 24\" fill=\"%23FFFFFF\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M12 8.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 3.5 12 3.5s2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5zM6.5 11c-1.38 0-2.5-1.12-2.5-2.5S5.12 6 6.5 6 9 7.12 9 8.5 7.88 11 6.5 11zm11 0c-1.38 0-2.5-1.12-2.5-2.5S16.12 6 17.5 6 20 7.12 20 8.5 18.88 11 17.5 11zM12 21c-3.5 0-6-2.5-6-5.5 0-2.5 1.5-4 4-5.5 1.5-1 4-1 4 0 2.5 1.5 4 3 4 5.5 0 3-2.5 5.5-6 5.5z\"/></svg>'); background-size:80px 80px; z-index:1;"></div>

  <div style="max-width:1440px; margin:0 auto; text-align:center; position:relative; z-index:2;">
    
    <div style="margin-bottom:80px;">
      <h2 style="font-family:'Nunito', sans-serif; font-size:clamp(36px, 5vw, 56px); font-weight:900; color:#FFFFFF; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="ps-reviews-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:30px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#FFFFFF; padding:40px; border-radius:30px; text-align:left; box-shadow:0 20px 40px rgba(0,0,0,0.1); position:relative; transition:transform 0.3s ease; border:4px solid #FFF9E6;" class="ps-review-card">
          
          <div style="display:flex; gap:4px; margin-bottom:24px; color:#FFD166; font-size:20px;">
            ★ ★ ★ ★ ★
          </div>
          
          <p style="font-family:'Quicksand', sans-serif; font-size:18px; font-weight:600; line-height:1.6; color:#333333; margin:0 0 32px 0;">
            "{{ block.settings.quote }}"
          </p>
          
          <div style="display:flex; align-items:center; gap:16px;">
            <div style="width:50px; height:50px; background:#FFEDD5; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#FF6B6B; font-family:'Nunito', sans-serif; font-weight:800; font-size:24px;">
              {{ block.settings.author | slice: 0, 1 }}
            </div>
            <div>
              <div style="font-family:'Nunito', sans-serif; font-size:16px; font-weight:800; color:#333333;">
                {{ block.settings.author }}
              </div>
              <div style="font-family:'Quicksand', sans-serif; font-size:14px; font-weight:600; color:#555555;">
                Verified Pet Parent
              </div>
            </div>
          </div>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .ps-review-card:hover { transform: translateY(-10px); }
    @media (max-width: 990px) {
      .ps-reviews-grid { grid-template-columns: 1fr; gap: 40px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Pet Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Happy Tails & Tales"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "My golden retriever absolutely loves the chew toys. They are incredibly durable!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Sarah & Max"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pet Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
