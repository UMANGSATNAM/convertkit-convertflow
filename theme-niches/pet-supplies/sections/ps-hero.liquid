<div style="background:#FFF9E6; position:relative; overflow:hidden; padding:80px 24px;">
  
  <!-- Decorative Paws Background -->
  <div style="position:absolute; inset:0; opacity:0.05; background-image:url('data:image/svg+xml;utf8,<svg viewBox=\"0 0 24 24\" fill=\"%23333333\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M12 8.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 3.5 12 3.5s2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5zM6.5 11c-1.38 0-2.5-1.12-2.5-2.5S5.12 6 6.5 6 9 7.12 9 8.5 7.88 11 6.5 11zm11 0c-1.38 0-2.5-1.12-2.5-2.5S16.12 6 17.5 6 20 7.12 20 8.5 18.88 11 17.5 11zM12 21c-3.5 0-6-2.5-6-5.5 0-2.5 1.5-4 4-5.5 1.5-1 4-1 4 0 2.5 1.5 4 3 4 5.5 0 3-2.5 5.5-6 5.5z\"/></svg>'); background-size:100px 100px; z-index:1;"></div>

  <div style="max-width:1440px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center; position:relative; z-index:2;">
    
    <!-- Content -->
    <div style="padding-right:40px;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:#FFEDD5; color:#EA580C; font-family:'Nunito', sans-serif; font-size:14px; font-weight:800; padding:8px 20px; border-radius:30px; text-transform:uppercase; letter-spacing:1px; margin-bottom:24px;">
        <svg style="width:16px; height:16px; fill:currentColor;" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        {{ section.settings.eyebrow }}
      </div>
      
      <h1 style="font-family:'Nunito', sans-serif; font-size:clamp(48px, 6vw, 72px); font-weight:900; line-height:1.1; color:#333333; margin:0 0 24px 0;">
        {{ section.settings.heading }}
      </h1>
      
      <p style="font-family:'Quicksand', sans-serif; font-size:20px; font-weight:500; color:#555555; line-height:1.6; margin:0 0 40px 0;">
        {{ section.settings.subheading }}
      </p>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#FF6B6B; color:#FFFFFF; font-family:'Nunito', sans-serif; font-size:18px; font-weight:800; padding:18px 48px; border-radius:50px; text-decoration:none; box-shadow:0 10px 20px rgba(255,107,107,0.3); transition:all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);" class="ps-btn-primary">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
      
      <div style="display:flex; align-items:center; gap:16px; margin-top:40px;">
        <div style="display:flex;">
          <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=100&q=80" style="width:40px; height:40px; border-radius:50%; border:2px solid #FFF9E6; object-fit:cover;">
          <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=100&q=80" style="width:40px; height:40px; border-radius:50%; border:2px solid #FFF9E6; object-fit:cover; margin-left:-15px;">
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80" style="width:40px; height:40px; border-radius:50%; border:2px solid #FFF9E6; object-fit:cover; margin-left:-15px;">
        </div>
        <div style="font-family:'Quicksand', sans-serif; font-size:14px; font-weight:600; color:#555555;">
          Loved by 10,000+ Happy Pets
        </div>
      </div>
    </div>
    
    <!-- Visual -->
    <div style="position:relative;">
      <!-- Organic shape blob -->
      <div style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); width:110%; height:110%; background:#FFD166; border-radius:40% 60% 70% 30% / 40% 50% 60% 50%; z-index:1; animation:ps-blob 8s ease-in-out infinite alternate;"></div>
      
      <div style="position:relative; z-index:2; border-radius:30px; overflow:hidden; border:8px solid #FFFFFF; box-shadow:0 20px 40px rgba(0,0,0,0.1); transform:rotate(3deg);">
        <img src="https://images.unsplash.com/photo-1583337130417-3346a1be7dee?auto=format&fit=crop&w=1000&q=80" alt="Happy Dog" style="width:100%; height:auto; display:block;" loading="eager">
      </div>
      
      <!-- Floating Elements -->
      <div style="position:absolute; top:-20px; right:-20px; background:#FFFFFF; padding:12px; border-radius:50%; box-shadow:0 10px 20px rgba(0,0,0,0.1); z-index:3; font-size:32px; animation:ps-float 3s ease-in-out infinite;">
        🦴
      </div>
      <div style="position:absolute; bottom:20px; left:-30px; background:#FFFFFF; padding:12px; border-radius:50%; box-shadow:0 10px 20px rgba(0,0,0,0.1); z-index:3; font-size:32px; animation:ps-float 4s ease-in-out infinite 1s;">
        🎾
      </div>
    </div>
    
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@700;800;900&family=Quicksand:wght@500;600;700&display=swap');
    
    .ps-btn-primary:hover { transform: translateY(-5px) scale(1.05); box-shadow: 0 15px 30px rgba(255,107,107,0.4); }
    
    @keyframes ps-blob { 0% { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; } 100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; } }
    @keyframes ps-float { 0% { transform: translateY(0); } 50% { transform: translateY(-15px); } 100% { transform: translateY(0); } }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; text-align: center; }
      div[style*="padding-right:40px"] { padding-right: 0; }
      div[style*="justify-content:center"] { margin: 0 auto; }
      div[style*="display:flex; align-items:center; gap:16px; margin-top:40px"] { justify-content: center; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Pet Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SPOIL YOUR FURRY FRIENDS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Only the Best for Your Best Friend."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium toys, organic treats, and cozy beds designed for happy, healthy pets."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Pet Hero"
    }
  ]
}
{% endschema %}
