<div style="background:#FF6B6B; padding:100px 24px; position:relative; overflow:hidden;">
  
  <div style="position:absolute; top:-50px; left:-50px; width:200px; height:200px; background:rgba(255,255,255,0.1); border-radius:50%;"></div>
  <div style="position:absolute; bottom:-50px; right:-50px; width:300px; height:300px; background:rgba(255,255,255,0.1); border-radius:50%;"></div>

  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Nunito', sans-serif; font-size:clamp(32px, 4vw, 48px); font-weight:900; color:#FFFFFF; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="ps-features-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:30px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#FFFFFF; padding:40px; border-radius:30px; text-align:center; box-shadow:0 15px 30px rgba(0,0,0,0.1); transition:transform 0.3s ease;" class="ps-feature-card">
          
          <div style="width:80px; height:80px; border-radius:50%; background:#FFF9E6; display:flex; align-items:center; justify-content:center; margin:0 auto 24px auto; font-size:40px; color:#FF6B6B;">
            {% if forloop.index == 1 %}🩺{% elsif forloop.index == 2 %}🌿{% else %}🚚{% endif %}
          </div>
          
          <h3 style="font-family:'Nunito', sans-serif; font-size:24px; font-weight:800; color:#333333; margin:0 0 16px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Quicksand', sans-serif; font-size:16px; font-weight:500; color:#555555; line-height:1.6; margin:0;">
            {{ block.settings.desc }}
          </p>
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .ps-feature-card:hover { transform: translateY(-10px); }
    
    @media (max-width: 990px) {
      .ps-features-grid { grid-template-columns: 1fr; gap: 40px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Pet Features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Pet Parents Love Us"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Vet Approved"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "All products are tested and approved by certified veterinarians."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pet Features",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
