<div style="background:#FFF9E6; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px; flex-wrap:wrap; gap:24px;">
      <div>
        <h2 style="font-family:'Nunito', sans-serif; font-size:clamp(32px, 4vw, 48px); font-weight:900; color:#333333; margin:0 0 16px 0;">
          {{ section.settings.heading }}
        </h2>
        <div style="width:60px; height:6px; background:#FF6B6B; border-radius:3px;"></div>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Nunito', sans-serif; font-size:16px; font-weight:800; color:#FF6B6B; text-decoration:none; display:flex; align-items:center; gap:8px; padding:12px 24px; background:#FFFFFF; border-radius:30px; box-shadow:0 4px 10px rgba(0,0,0,0.05); transition:all 0.3s ease;" class="ps-link-btn">
          {{ section.settings.cta_label }}
          <svg style="width:20px; height:20px; fill:currentColor;" viewBox="0 0 24 24"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="ps-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:30px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1576201836106-db1758fd1c97?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1576201836106-db1758fd1c97?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1591946614720-90a587da4a36?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1583337130417-3346a1be7dee?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1525253013412-55c1a69a5738?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="ps-product-card" style="background:#FFFFFF; border-radius:30px; overflow:hidden; box-shadow:0 10px 20px rgba(0,0,0,0.05); transition:all 0.3s ease; position:relative; display:flex; flex-direction:column; height:100%; border:4px solid transparent;">
          
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:100%; background:#FFEDD5; border-radius:24px 24px 0 0;">
            <img src="{{ img_url }}" alt="Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease;" class="ps-product-img" loading="lazy">
            
            {% if idx == 1 or idx == 3 %}
              <div style="position:absolute; top:16px; left:16px; background:#FF6B6B; color:#FFFFFF; font-family:'Nunito', sans-serif; font-size:12px; font-weight:800; padding:6px 16px; border-radius:20px; letter-spacing:1px; text-transform:uppercase;">
                Best Seller
              </div>
            {% endif %}
          </a>
          
          <div style="padding:24px; display:flex; flex-direction:column; flex-grow:1; text-align:center;">
            
            <h3 style="font-family:'Nunito', sans-serif; font-size:20px; font-weight:800; color:#333333; margin:0 0 8px 0; flex-grow:1;">
              {% if idx == 1 %}Interactive Puzzle Toy{% elsif idx == 2 %}Organic Beef Treats{% elsif idx == 3 %}Orthopedic Cloud Bed{% else %}Adjustable Harness{% endif %}
            </h3>
            
            <div style="display:flex; justify-content:center; gap:4px; margin-bottom:16px; color:#FFD166; font-size:16px;">
              ★ ★ ★ ★ ★
            </div>
            
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:auto;">
              <div style="font-family:'Nunito', sans-serif; font-size:24px; font-weight:900; color:#FF6B6B;">
                {% if idx == 1 %}$24.99{% elsif idx == 2 %}$14.50{% elsif idx == 3 %}$89.00{% else %}$35.00{% endif %}
              </div>
              <button style="width:48px; height:48px; background:#FFEDD5; color:#FF6B6B; border-radius:50%; display:flex; align-items:center; justify-content:center; border:none; cursor:pointer; transition:all 0.3s ease; font-size:24px;" class="ps-add-btn">
                +
              </button>
            </div>
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .ps-link-btn:hover { background: #FF6B6B; color: #FFFFFF; }
    .ps-product-card:hover { border-color: #FF6B6B; transform: translateY(-10px); box-shadow: 0 20px 40px rgba(255,107,107,0.15); }
    .ps-product-card:hover .ps-product-img { transform: scale(1.05); }
    .ps-add-btn:hover { background: #FF6B6B; color: #FFFFFF; transform: rotate(90deg); }
    
    @media (max-width: 1024px) {
      .ps-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px 20px !important; }
    }
    @media (max-width: 640px) {
      .ps-product-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Pet Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Top Rated Essentials"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Pet Collection"
    }
  ]
}
{% endschema %}
