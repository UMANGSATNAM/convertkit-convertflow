<div style="background:var(--pet-bg);padding:100px 40px">
  <div style="max-width:1200px;margin:0 auto">
    
    <div style="text-align:center;margin-bottom:60px">
      <div style="display:flex;justify-content:center;gap:8px;margin-bottom:16px">
        <span style="font-size:24px">🦴</span>
        <span style="font-size:24px">🎾</span>
        <span style="font-size:24px">🐟</span>
      </div>
      <h2 class="pet-head" style="font-size:40px;margin-bottom:16px">{{ collection.title | default: 'Top Picks for Pals' }}</h2>
    </div>
    
    <div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:32px">
      {%- for product in collection.products limit: 8 -%}
      <a href="{{ product.url }}" class="pet-card">
        <div class="image-wrapper">
          {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- else -%}
          <div style="width:100%;height:100%;background:#FFF8E7"></div>
          {%- endif -%}
        </div>
        <div class="title">{{ product.title }}</div>
        <div class="price">{{ product.price | money }}</div>
      </a>
      {%- else -%}
      <!-- Demo State -->
      {%- for i in (1..8) -%}
      <a href="#" class="pet-card">
        <div class="image-wrapper">
          <div style="width:100%;height:100%;background:#FFF8E7"></div>
        </div>
        <div class="title">Premium Kibble V{{i}}</div>
        <div class="price">₹1,499</div>
      </a>
      {%- endfor -%}
      {%- endfor -%}
    </div>
    
    <div style="text-align:center;margin-top:60px">
      <a href="/collections/all" class="pet-btn">See All Goodies</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pet Supplies Grid",
  "settings": [],
  "presets": [
    {
      "name": "Pet Supplies Grid"
    }
  ]
}
{% endschema %}
