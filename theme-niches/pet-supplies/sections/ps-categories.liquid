<div style="background:#FFFFFF; padding:100px 40px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Nunito', sans-serif; font-size:clamp(36px, 5vw, 48px); font-weight:900; color:#333333; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      <div style="width:60px; height:6px; background:#FF6B6B; border-radius:3px; margin:0 auto;"></div>
    </div>

    <div class="ps-cat-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:40px;">
      
      {%- for block in section.blocks -%}
        <a href="#" class="ps-cat-card" style="display:flex; flex-direction:column; align-items:center; text-decoration:none; group">
          
          <div style="position:relative; width:100%; max-width:240px; aspect-ratio:1/1; border-radius:50%; margin-bottom:24px; padding:8px; background:linear-gradient(135deg, #FFEDD5 0%, #FFF9E6 100%); transition:transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);">
            <div style="width:100%; height:100%; border-radius:50%; overflow:hidden; border:4px solid #FFFFFF; box-shadow:0 10px 20px rgba(0,0,0,0.05); position:relative;">
              {%- assign idx = forloop.index | modulo: 4 -%}
              {%- assign img_url = 'https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=400&q=80' -%}
              {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=400&q=80' -%}{%- endif -%}
              {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?auto=format&fit=crop&w=400&q=80' -%}{%- endif -%}
              {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1548767797-d8c844163c4c?auto=format&fit=crop&w=400&q=80' -%}{%- endif -%}
              {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1552728089-571ebd49e5d4?auto=format&fit=crop&w=400&q=80' -%}{%- endif -%}
              
              <img src="{{ img_url }}" alt="{{ block.settings.title }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease;" class="ps-cat-img" loading="lazy">
            </div>
            
            <!-- Hover Paw Icon -->
            <div style="position:absolute; bottom:0; right:10px; width:48px; height:48px; background:#FF6B6B; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#FFFFFF; font-size:24px; border:4px solid #FFFFFF; opacity:0; transform:scale(0.5); transition:all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);" class="ps-cat-icon">
              🐾
            </div>
          </div>
          
          <h3 style="font-family:'Nunito', sans-serif; font-size:24px; font-weight:800; color:#333333; margin:0; transition:color 0.3s ease;" class="ps-cat-title">
            {{ block.settings.title }}
          </h3>
          
        </a>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .ps-cat-card:hover > div { transform: translateY(-10px); }
    .ps-cat-card:hover .ps-cat-img { transform: scale(1.1); }
    .ps-cat-card:hover .ps-cat-icon { opacity: 1; transform: scale(1); }
    .ps-cat-card:hover .ps-cat-title { color: #FF6B6B; }
    
    @media (max-width: 1024px) {
      .ps-cat-grid { grid-template-columns: repeat(2, 1fr); gap: 60px 40px; }
    }
    @media (max-width: 640px) {
      .ps-cat-grid { grid-template-columns: repeat(2, 1fr); gap: 40px 20px; }
      .ps-cat-card > div { max-width: 160px; }
      .ps-cat-card h3 { font-size: 18px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Pet Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Pet"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "For Dogs"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pet Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
