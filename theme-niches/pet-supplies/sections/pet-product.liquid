<div style="padding:48px 20px 80px;background:var(--pet-cream)"><div style="max-width:1320px;margin:0 auto">
  <nav style="font-size:13px;color:var(--pet-muted);font-family:'Fredoka',sans-serif;margin-bottom:32px" aria-label="Breadcrumb"><a href="/" style="color:var(--pet-muted)">Home</a> / <a href="{{ product.collections.first.url }}" style="color:var(--pet-muted)">{{ product.collections.first.title }}</a> / <span style="color:var(--pet-dark)">{{ product.title }}</span></nav>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start">
    <div data-gallery>
      <div style="border-radius:24px;overflow:hidden;background:#fff;border:2px solid var(--pet-border);aspect-ratio:1;margin-bottom:12px;cursor:zoom-in"><img id="MainProductImg" data-main-img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" width="800" style="width:100%;height:100%;object-fit:contain;padding:20px"></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">{%- for img in product.images limit: 6 -%}<div data-thumb data-src="{{ img | image_url: width: 800 }}" style="width:72px;height:72px;border-radius:12px;overflow:hidden;cursor:pointer;border:2px solid {% if forloop.first %}var(--pet-orange){% else %}transparent{% endif %};transition:border-color .2s"><img src="{{ img | image_url: width: 144 }}" alt="" width="72" height="72" style="width:100%;height:100%;object-fit:cover"></div>{%- endfor -%}</div>
    </div>
    <div>
      <span class="pet-eyebrow" style="margin-bottom:8px">{{ product.vendor }}</span>
      <h1 style="font-family:'Outfit',sans-serif;font-size:32px;font-weight:800;color:var(--pet-dark);margin-bottom:12px">{{ product.title }}</h1>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px"><span style="color:var(--pet-yellow);font-size:16px">★★★★★</span><span style="font-size:13px;color:var(--pet-muted);font-family:'Fredoka',sans-serif">({{ product.metafields.reviews.rating_count | default: '1.2k' }} tails wagging)</span></div>
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;padding-bottom:20px;border-bottom:2px solid var(--pet-border)">
        <span style="font-size:28px;font-weight:800;color:var(--pet-orange);font-family:'Fredoka',sans-serif" data-price>{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}<span style="font-size:18px;color:var(--pet-muted);text-decoration:line-through;font-family:'Fredoka',sans-serif" data-compare-price>{{ product.compare_at_price | money }}</span>{%- endif -%}
      </div>
      <!-- Toy/Beds Specs Tag -->
      <div style="display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap"><span style="padding:6px 14px;background:#fff;border:2px solid var(--pet-border);border-radius:12px;font-size:12px;font-family:'Fredoka',sans-serif;font-weight:600;color:var(--pet-dark)">🐾 Grain-Free</span><span style="padding:6px 14px;background:#fff;border:2px solid var(--pet-border);border-radius:12px;font-size:12px;font-family:'Fredoka',sans-serif;font-weight:600;color:var(--pet-dark)">🦷 Dental Health</span><span style="padding:6px 14px;background:#fff;border:2px solid var(--pet-border);border-radius:12px;font-size:12px;font-family:'Fredoka',sans-serif;font-weight:600;color:var(--pet-dark)">✓ 100% Non-Toxic</span></div>
      <form action="{{ routes.cart_add_url }}" method="post" id="ProductForm">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- unless product.has_only_default_variant -%}{%- for option in product.options_with_values -%}<div style="margin-bottom:20px"><label style="font-family:'Outfit',sans-serif;font-size:13px;font-weight:800;display:block;margin-bottom:10px;color:var(--pet-dark)">{{ option.name }}</label><div style="display:flex;gap:8px;flex-wrap:wrap" data-swatches>{%- for value in option.values -%}<button type="button" data-swatch="{{ value }}" style="padding:10px 20px;border:2px solid {% if option.selected_value == value %}var(--pet-dark){% else %}var(--pet-border){% endif %};background:{% if option.selected_value == value %}var(--pet-yellow){% else %}#fff{% endif %};color:var(--pet-dark);font-family:'Outfit',sans-serif;font-size:13px;font-weight:700;cursor:pointer;border-radius:12px;transition:all .2s">{{ value }}</button>{%- endfor -%}</div></div>{%- endfor -%}<select name="id" data-variant-select style="display:none">{%- for variant in product.variants -%}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</option>{%- endfor -%}</select>{%- endunless -%}
        <div style="display:flex;gap:12px;margin-bottom:12px">
          <div style="display:flex;align-items:center;border:2px solid var(--pet-dark);border-radius:12px;background:#fff;overflow:hidden"><button type="button" data-dir="down" style="width:40px;height:48px;background:none;border:none;font-size:20px;cursor:pointer">−</button><input type="number" name="quantity" value="1" min="1" style="width:40px;height:48px;text-align:center;border:none;font-size:15px;font-weight:700"><button type="button" data-dir="up" style="width:40px;height:48px;background:none;border:none;font-size:20px;cursor:pointer">+</button></div>
          <button type="submit" class="pet-btn" data-atc style="flex:1;justify-content:center" {% unless product.available %}disabled{% endunless %}>{%- if product.available -%}ADD TO BOX{%- else -%}OUT OF GRUB{%- endif -%}</button>
        </div>
      </form>
      <!-- Trust badges -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:20px 0">
        <div style="display:flex;align-items:center;gap:8px;padding:10px;background:#fff;border-radius:12px;font-size:12px;color:var(--pet-dark);border:2px solid var(--pet-border)">🛡️ 100% Safe</div>
        <div style="display:flex;align-items:center;gap:8px;padding:10px;background:#fff;border-radius:12px;font-size:12px;color:var(--pet-dark);border:2px solid var(--pet-border)">📦 Eco Packaging</div>
      </div>
      <div style="font-family:'Fredoka',sans-serif;font-size:15px;line-height:1.7;color:var(--pet-muted)">{{ product.description }}</div>
    </div>
  </div>
</div></div>
{% schema %}
{"name":"Pet Product","settings":[],"presets":[{"name":"Pet Product"}]}
{% endschema %}
