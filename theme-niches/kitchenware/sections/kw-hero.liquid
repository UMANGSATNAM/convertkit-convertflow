<div style="background:var(--kw-bg);min-height:90vh;display:flex;align-items:center;padding:80px 60px;position:relative;border-bottom:4px solid var(--kw-border)">
  
  <div style="position:absolute;top:0;right:0;width:40%;height:100%;background:#111;z-index:0;border-left:4px solid var(--kw-border)"></div>

  <div style="max-width:1400px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;position:relative;z-index:2">
    
    <div>
      <div style="font-family:var(--font-b);font-weight:700;color:var(--kw-accent);text-transform:uppercase;letter-spacing:0.2em;margin-bottom:24px">
        {{ section.settings.overline | default: 'PROFESSIONAL GRADE' }}
      </div>
      <h1 class="kw-head" style="font-size:clamp(60px, 8vw, 90px);margin-bottom:32px;line-height:1">
        {{ section.settings.heading | default: 'BUILT TO<br>LAST.' }}
      </h1>
      <p style="font-size:18px;line-height:1.6;color:var(--kw-muted);margin-bottom:48px;max-width:480px">
        {{ section.settings.text | default: 'Heavy-duty carbon steel and pure copper cookware engineered for the demands of a professional kitchen.' }}
      </p>
      <div style="display:flex;gap:24px">
        <a href="{{ section.settings.btn1_url | default: '/collections/cookware' }}" class="kw-btn">{{ section.settings.btn1_text | default: 'SHOP COOKWARE' }}</a>
      </div>
    </div>
    
    <div style="position:relative;padding:40px;background:var(--kw-surface);border:4px solid var(--kw-border)">
      <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/kitchen-hero.png?v=1717283400" alt="Professional Pan" style="width:100%;height:auto;filter:drop-shadow(20px 20px 30px rgba(0,0,0,0.8))">
      
      <!-- Rivet details -->
      <div style="position:absolute;top:16px;left:16px;width:12px;height:12px;background:var(--kw-accent);border-radius:50%;box-shadow:inset -2px -2px 4px rgba(0,0,0,0.5)"></div>
      <div style="position:absolute;top:16px;right:16px;width:12px;height:12px;background:var(--kw-accent);border-radius:50%;box-shadow:inset -2px -2px 4px rgba(0,0,0,0.5)"></div>
      <div style="position:absolute;bottom:16px;left:16px;width:12px;height:12px;background:var(--kw-accent);border-radius:50%;box-shadow:inset -2px -2px 4px rgba(0,0,0,0.5)"></div>
      <div style="position:absolute;bottom:16px;right:16px;width:12px;height:12px;background:var(--kw-accent);border-radius:50%;box-shadow:inset -2px -2px 4px rgba(0,0,0,0.5)"></div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Kitchenware Hero",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline Text",
      "default": "PROFESSIONAL GRADE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BUILT TO<br>LAST."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Heavy-duty carbon steel and pure copper cookware."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button Text",
      "default": "SHOP COOKWARE"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Kitchenware Hero"
    }
  ]
}
{% endschema %}
