<div style="background:var(--kw-bg);padding:100px 60px">
  <div style="max-width:1400px;margin:0 auto">
    
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:60px;border-bottom:4px solid var(--kw-border);padding-bottom:24px">
      <h2 class="kw-head" style="font-size:48px">{{ collection.title | default: 'THE ARSENAL' }}</h2>
      <div style="font-family:var(--font-b);font-weight:700;color:var(--kw-accent);text-transform:uppercase;letter-spacing:0.1em">
        {{ collection.products_count | default: '24' }} TOOLS
      </div>
    </div>
    
    <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:40px">
      {%- for product in collection.products limit: 9 -%}
      <a href="{{ product.url }}" class="kw-card">
        <div class="image-wrapper">
          {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- else -%}
          <div style="width:100%;height:100%;background:#111"></div>
          {%- endif -%}
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center">
          <div class="title" style="margin:0">{{ product.title }}</div>
          <div class="price">{{ product.price | money }}</div>
        </div>
      </a>
      {%- else -%}
      <!-- Demo State -->
      {%- for i in (1..6) -%}
      <a href="#" class="kw-card">
        <div class="image-wrapper">
          <div style="width:100%;height:100%;background:#111"></div>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center">
          <div class="title" style="margin:0">CARBON STEEL SKILLET V{{i}}</div>
          <div class="price">₹4,999</div>
        </div>
      </a>
      {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kitchenware Grid",
  "settings": [],
  "presets": [
    {
      "name": "Kitchenware Grid"
    }
  ]
}
{% endschema %}
