<div style="padding:100px 20px;background:var(--ap-black);border-bottom:1px solid var(--ap-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="ap-section-header"><span class="ap-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="ap-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="ap-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:#16120E"></div>{%- endif -%}<div class="ap-col-card__overlay"><span class="ap-col-card__title">{{ block.settings.title }}</span><span class="ap-col-card__cta">Explore Decanters</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Perfume Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"OLFACTORY WINGS"},{"type":"text","id":"heading","label":"Heading","default":"The Perfumer's Cabinet"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Pure Oudh"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Perfume Collections","blocks":[{"type":"col","settings":{"title":"Imperial Oudh Elixirs"}},{"type":"col","settings":{"title":"Damascus Rose Blends"}},{"type":"col","settings":{"title":"Warm Amber Concentrates"}}]}]}
{% endschema %}
