<div style="padding:100px 20px;background:var(--ap-black)"><div style="max-width:1320px;margin:0 auto">
  <div class="ap-section-header"><span class="ap-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="ap-review-grid">{%- for block in section.blocks -%}<div class="ap-review-card" {{ block.shopify_attributes }}><div class="ap-review-card__stars">★★★★★</div><div class="ap-review-card__text">"{{ block.settings.quote }}"</div><div class="ap-review-card__author">{{ block.settings.name }}</div><div class="ap-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Perfume Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PATRONS OF OUDH"},{"type":"text","id":"heading","label":"Heading","default":"Olfactory Testimonials"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Perfume Reviews","blocks":[{"type":"review","settings":{"quote":"The longevity of the Royal Amber is legendary. Easily lasts 24 hours on silk layers.","name":"Tariq A.","product":"Royal Amber Decanter"}},{"type":"review","settings":{"quote":"Deeply peppery, sweet, and majestic. It creates an incredible sillage. Highly recommend.","name":"Farah H.","product":"Damascus Rose & Oudh"}},{"type":"review","settings":{"quote":"Impeccable gold flacon presentation. The agarwood content is rich and completely authentic.","name":"Omar F.","product":"Imperial Agarwood Oil"}}]}]}
{% endschema %}
