<div class="ap-hero">
  <div class="ap-hero__content">
    <span class="ap-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="ap-hero__title">{{ section.settings.heading }}</h1>
    <p class="ap-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:16px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="ap-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="ap-btn ap-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="ap-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image.alt | escape }}" width="1400" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:600px;background:#15110E"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Perfume Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"MAJESTIC ESCAPE"},{"type":"text","id":"heading","label":"Heading","default":"The Royal Oudh Collection"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Rare botanical oils, pure agarwood essence, and Damascus rose slow-infused inside golden decanters."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"EXPLORE DECANTERS"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"THE OLFACTORY"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Perfume Hero"}]}
{% endschema %}
