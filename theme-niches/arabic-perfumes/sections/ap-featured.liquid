<div style="padding:100px 20px;background:var(--ap-black);border-bottom:1px solid var(--ap-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="ap-section-header"><span class="ap-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  {%- assign col = collections[section.settings.collection] -%}
  <div class="ap-prod-grid">{%- for product in col.products limit: section.settings.count -%}<a href="{{ product.url }}" class="ap-prod-card"><div class="ap-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" width="700" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:#1C1612"></div>{%- endif -%}</div><div class="ap-prod-card__name">{{ product.title }}</div><div class="ap-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div>
  <div style="text-align:center;margin-top:60px"><a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="ap-btn ap-btn--outline">{{ section.settings.cta_label }}</a></div>
</div></div>
{% schema %}
{"name":"Perfume Featured","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"EXQUISITE RELEASES"},{"type":"text","id":"heading","label":"Heading","default":"Olfactory Masterpieces"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"count","label":"Products","min":4,"max":12,"step":4,"default":8},{"type":"text","id":"cta_label","label":"CTA","default":"VIEW CABINET"},{"type":"url","id":"cta_url","label":"CTA URL"}],"presets":[{"name":"Perfume Featured"}]}
{% endschema %}
