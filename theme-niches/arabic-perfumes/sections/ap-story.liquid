<div style="padding:100px 20px;background:var(--ap-black)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center">
  <div>
    <span class="ap-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Playfair Display',serif;font-size:clamp(30px,4.5vw,52px);font-weight:300;color:var(--ap-white);margin-bottom:24px;line-height:1.1;letter-spacing:0.04em">{{ section.settings.heading }}</h2>
    <p style="font-family:'Montserrat',sans-serif;font-size:14px;color:var(--ap-muted);line-height:1.9;max-width:440px;letter-spacing:0.02em">{{ section.settings.body }}</p>
    <div class="ap-stat-grid">{%- for block in section.blocks -%}<div class="ap-stat" {{ block.shopify_attributes }}><div class="ap-stat__num">{{ block.settings.number }}</div><div class="ap-stat__label">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" width="900" style="width:100%;object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:3/4;background:#15110E"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Perfume Story","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE AGARWOOD ATELIER"},{"type":"text","id":"heading","label":"Heading","default":"Slow Distilled. Golden Aged."},{"type":"textarea","id":"body","label":"Body","default":"Our oudh is slowly extracted from 30-year mature Aquilaria trees, then aged for 24 months in dark glass vessels to achieve unrivaled olfactory depth."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"30 Years"},{"type":"text","id":"label","label":"Label","default":"Aquilaria Aging"}]}],"presets":[{"name":"Perfume Story","blocks":[{"type":"stat","settings":{"number":"30 Yrs","label":"Mature Agarwood"}},{"type":"stat","settings":{"number":"100%","label":"Damascus Petals"}},{"type":"stat","settings":{"number":"24 Mths","label":"Vessel Matured"}},{"type":"stat","settings":{"number":"Pure","label":"Oudh Concentrates"}}]}]}
{% endschema %}
