<div style="background:#F9EEF0; padding:100px 0;">
  <div class="page-width" style="max-width:1440px; margin:0 auto; padding:0 24px;">
    
    <div style="text-align:center; margin-bottom:60px;">
      {%- if section.settings.eyebrow != blank -%}
        <div style="font-family:'Cinzel', serif; font-size:12px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:#C89B72; margin-bottom:16px; display:flex; align-items:center; justify-content:center; gap:16px;">
          <span style="width:40px; height:1px; background:#C89B72;"></span>
          {{ section.settings.eyebrow }}
          <span style="width:40px; height:1px; background:#C89B72;"></span>
        </div>
      {%- endif -%}
      <h2 style="font-family:'Cinzel', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#8B1A2C; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p style="font-size:16px; color:#555; max-width:600px; margin:0 auto;">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="jh-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:30px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1599643478514-4a420410d8dc?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1599643478514-4a420410d8dc?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1601121141461-9d6647bca1ed?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1515562141207-7a8efbfc3473?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="jh-product-card" style="text-align:center; group">
          <a href="#" style="display:block; text-decoration:none; margin-bottom:20px; position:relative; padding-bottom:120%; background:#fff; border:1px solid rgba(200, 155, 114, 0.15); overflow:hidden;">
            <img src="{{ img_url }}" alt="Jewellery Piece" style="position:absolute; top:0; left:0; width:100%; height:100%; object-fit:contain; padding:20px; transition:transform 0.5s ease;" class="jh-product-img" loading="lazy">
            <div class="jh-quick-add" style="position:absolute; bottom:0; left:0; width:100%; padding:15px; background:rgba(255,255,255,0.9); border-top:1px solid rgba(200, 155, 114, 0.2); transform:translateY(100%); transition:transform 0.3s ease; display:flex; justify-content:center;">
              <span style="font-family:'Cinzel', serif; font-size:12px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:#8B1A2C;">Quick View</span>
            </div>
          </a>
          <div>
            <h3 style="font-family:'Cinzel', serif; font-size:16px; font-weight:400; color:#8B1A2C; margin:0 0 8px 0;">
              {% if idx == 1 %}Polki Diamond Choker{% elsif idx == 2 %}Kundan Bridal Set{% elsif idx == 3 %}Antique Gold Jhumkas{% else %}Temple Pendant{% endif %}
            </h3>
            <div style="font-size:15px; color:#555; margin-bottom:12px;">
              {% if idx == 1 %}₹ 1,45,000{% elsif idx == 2 %}₹ 2,80,000{% elsif idx == 3 %}₹ 85,000{% else %}₹ 1,15,000{% endif %}
            </div>
            <div style="font-size:11px; font-weight:600; letter-spacing:1px; text-transform:uppercase; color:#C89B72;">22K Gold &bull; Handcrafted</div>
          </div>
        </div>
      {%- endfor -%}
      
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div style="text-align:center; margin-top:60px;">
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="jh-btn-outline" style="display:inline-block; padding:14px 40px; font-family:'Cinzel', serif; font-size:13px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:#8B1A2C; text-decoration:none; border:1px solid #8B1A2C; transition:all 0.3s ease;">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}
  </div>

  <style>
    .jh-product-card:hover .jh-product-img { transform: scale(1.05); }
    .jh-product-card:hover .jh-quick-add { transform: translateY(0); }
    .jh-btn-outline:hover { background: #8B1A2C; color: #F9EEF0 !important; }
    
    @media (max-width: 1024px) {
      .jh-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px 20px !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Heritage Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "SIGNATURE PIECES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Heritage Collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Timeless artistry meticulously handcrafted in 22K Gold."
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products to show",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "View Entire Collection"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Heritage Collection"
    }
  ]
}
{% endschema %}
