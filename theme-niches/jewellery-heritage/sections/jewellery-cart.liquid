<div style="padding:60px 20px 100px;background:var(--cream);min-height:60vh;border-bottom:1px solid var(--border)"><div style="max-width:960px;margin:0 auto">
  <h1 style="font-family:'Cinzel',serif;font-size:clamp(28px,4vw,40px);font-weight:600;color:var(--crimson);text-align:center;margin-bottom:56px;letter-spacing:1px">TREASURE CHEST</h1>
  {%- if cart.item_count == 0 -%}<div style="text-align:center;padding:80px 20px"><div style="font-size:40px;margin-bottom:24px;filter:grayscale(1)">👑</div><h2 style="font-family:'Cinzel',serif;font-size:28px;font-weight:600;color:var(--crimson);margin-bottom:12px;letter-spacing:1px">Your chest is empty</h2><p style="font-family:'Raleway',sans-serif;color:var(--text-muted);margin-bottom:36px;font-weight:500">Rani haar polkis, kundan chokers, and jadau bangle sets are waiting.</p><a href="/collections/all" class="btn-primary">EXPLORE HEIRLOOMS</a></div>
  {%- else -%}
  <div style="display:grid;grid-template-columns:1fr 380px;gap:48px;align-items:start">
    <div>{%- for item in cart.items -%}<div style="display:flex;gap:24px;padding:28px 0;border-bottom:1px solid var(--border);align-items:center"><a href="{{ item.url }}" style="flex-shrink:0"><img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="100" style="object-fit:contain;background:#fff;padding:10px;border:1px solid var(--border);border-radius:0px"></a><div style="flex:1;min-width:0"><a href="{{ item.url }}" style="text-decoration:none;font-family:'Cinzel',serif;font-weight:600;font-size:20px;color:var(--crimson);display:block;margin-bottom:4px;letter-spacing:0.5px">{{ item.product.title }}</a>{%- unless item.variant.title == 'Default Title' -%}<div style="font-family:'Raleway',sans-serif;font-size:12px;color:var(--text-muted);margin-bottom:12px;font-weight:600">{{ item.variant.title }}</div>{%- endunless -%}<div style="display:flex;align-items:center;gap:16px"><div style="display:flex;align-items:center;border:1px solid var(--border);overflow:hidden;background:#fff;border-radius:0px"><button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px">−</button><span style="width:32px;text-align:center;font-family:'Raleway',sans-serif;font-size:13px;font-weight:700;color:var(--text)">{{ item.quantity }}</span><button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px">+</button></div><a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" style="font-family:'Raleway',sans-serif;font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;text-decoration:underline;font-weight:700">Remove</a></div></div><div style="font-family:'Raleway',sans-serif;font-size:16px;font-weight:700;color:var(--crimson)">{{ item.final_line_price | money }}</div></div>{%- endfor -%}</div>
    <div style="background:#fff;padding:40px;border:1px solid var(--border);border-radius:0px;position:sticky;top:120px">
      <h3 style="font-family:'Raleway',sans-serif;font-size:18px;font-weight:700;color:var(--crimson);margin-bottom:28px;text-transform:uppercase;letter-spacing:1px">Chest Summary</h3>
      <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-family:'Raleway',sans-serif;font-size:14px;font-weight:500"><span style="color:var(--text-muted)">Subtotal</span><span style="font-weight:700;color:var(--crimson)">{{ cart.total_price | money }}</span></div>
      <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-family:'Raleway',sans-serif;font-size:14px;font-weight:500"><span style="color:var(--text-muted)">Armored Car Transit</span><span style="font-weight:700;color:var(--rose-gold)">Free</span></div>
      <div style="padding-top:20px;border-top:1px solid var(--border);margin-top:20px;display:flex;justify-content:space-between;margin-bottom:32px"><span style="font-family:'Raleway',sans-serif;font-size:18px;font-weight:700;color:var(--crimson);text-transform:uppercase;letter-spacing:1px">Total</span><span style="font-family:'Raleway',sans-serif;font-size:20px;font-weight:700;color:var(--crimson)">{{ cart.total_price | money }}</span></div>
      <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="btn-primary" style="width:100%;justify-content:center;border-radius:0px">CHECKOUT</button></form>
      <div style="display:flex;flex-direction:column;gap:8px;margin-top:24px;text-align:center"><span style="font-size:11px;font-family:'Raleway',sans-serif;font-weight:700;color:var(--text-muted)">✓ lifetime purity and gold buyback guarantee</span><span style="font-size:11px;font-family:'Raleway',sans-serif;font-weight:700;color:var(--text-muted)">🚚 carbon neutral secure armored shipping in velvet casket</span></div>
    </div>
  </div>{%- endif -%}
</div></div>
{% schema %}
{"name":"Jewellery Cart","settings":[],"presets":[{"name":"Jewellery Cart"}]}
{% endschema %}
