<div style="background:#1a0508; padding:80px 0;">
  <div class="page-width" style="max-width:1440px; margin:0 auto; padding:0 24px;">
    
    <div style="text-align:center; margin-bottom:60px;">
      {%- if section.settings.eyebrow != blank -%}
        <div style="font-family:'Cinzel', serif; font-size:12px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:#C89B72; margin-bottom:16px; display:flex; align-items:center; justify-content:center; gap:16px;">
          <span style="width:40px; height:1px; background:#C89B72;"></span>
          {{ section.settings.eyebrow }}
          <span style="width:40px; height:1px; background:#C89B72;"></span>
        </div>
      {%- endif -%}
      <h2 style="font-family:'Cinzel', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#F9EEF0; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p style="font-size:15px; color:#A89B9E; max-width:600px; margin:0 auto;">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="jh-category-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 4 }}, 1fr); gap:20px;">
      
      {%- for block in section.blocks -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1599643478514-4a420410d8dc?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1599643478514-4a420410d8dc?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1601121141461-9d6647bca1ed?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1515562141207-7a8efbfc3473?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <a href="{{ block.settings.link | default: '#' }}" class="jh-cat-card" style="display:block; text-decoration:none; text-align:center; group">
          <div style="position:relative; padding-bottom:120%; overflow:hidden; border:1px solid rgba(200, 155, 114, 0.2); transition:border-color 0.4s ease; margin-bottom:20px;">
            <img src="{{ block.settings.image | image_url: width: 600 | default: img_url }}" alt="{{ block.settings.title }}" style="position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; transition:transform 0.8s ease;" class="jh-cat-img" loading="lazy">
            <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(26,5,8,0.8) 0%, rgba(26,5,8,0) 50%); z-index:1;"></div>
          </div>
          <div style="padding:0 10px;">
            <h3 style="font-family:'Cinzel', serif; font-size:18px; font-weight:400; color:#F9EEF0; margin:0 0 4px 0; transition:color 0.3s ease;" class="jh-cat-title">
              {{ block.settings.title }}
            </h3>
            <span style="font-size:13px; color:#C89B72; letter-spacing:1px; text-transform:uppercase;">
              {{ block.settings.subtitle }}
            </span>
          </div>
        </a>
      {%- else -%}
        <!-- Fallback if no blocks -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .jh-cat-card:hover .jh-cat-img { transform: scale(1.05); }
    .jh-cat-card:hover > div:first-child { border-color: #C89B72; }
    .jh-cat-card:hover .jh-cat-title { color: #C89B72; }
    
    @media (max-width: 990px) {
      .jh-category-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 30px 20px !important; }
    }
    @media (max-width: 480px) {
      .jh-category-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Heritage Categories",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "CURATED MASTERPIECES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Occasion"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Adornments for your most cherished moments"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category Name"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Subtitle text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heritage Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
