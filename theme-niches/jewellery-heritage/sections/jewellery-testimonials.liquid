<div style="background:#F9EEF0; padding:100px 0; border-top:1px solid rgba(200,155,114,0.2);">
  <div class="page-width" style="max-width:1440px; margin:0 auto; padding:0 24px;">
    
    <div style="text-align:center; margin-bottom:60px;">
      {%- if section.settings.eyebrow != blank -%}
        <div style="font-family:'Cinzel', serif; font-size:12px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:#C89B72; margin-bottom:16px; display:flex; align-items:center; justify-content:center; gap:16px;">
          <span style="width:40px; height:1px; background:#C89B72;"></span>
          {{ section.settings.eyebrow }}
          <span style="width:40px; height:1px; background:#C89B72;"></span>
        </div>
      {%- endif -%}
      <h2 style="font-family:'Cinzel', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#8B1A2C; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="jh-testi-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:40px;">
      
      {%- for block in section.blocks -%}
        <div style="text-align:center; padding:40px; background:#fff; border:1px solid rgba(200, 155, 114, 0.2); position:relative;">
          
          <div style="color:#C89B72; margin-bottom:20px;">
            {%- for i in (1..block.settings.rating) -%}
              <svg style="width:18px; height:18px; fill:currentColor;" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            {%- endfor -%}
          </div>
          
          <p style="font-size:16px; font-style:italic; line-height:1.8; color:#555; margin-bottom:24px;">
            "{{ block.settings.quote }}"
          </p>
          
          <div style="font-family:'Cinzel', serif; font-weight:600; color:#8B1A2C; font-size:15px; margin-bottom:4px;">
            {{ block.settings.name }}
          </div>
          <div style="font-size:12px; color:#A89B9E; text-transform:uppercase; letter-spacing:1px;">
            {{ block.settings.location }}
          </div>
        </div>
      {%- else -%}
        <!-- Fallback if no blocks -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    @media (max-width: 990px) {
      .jh-testi-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Heritage Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "CLIENT DIARIES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Generations of Trust"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The craftsmanship is exquisite. Truly heirloom pieces."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Client Name"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "City"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heritage Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
