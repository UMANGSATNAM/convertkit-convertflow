{% style %}
.jewel-testi { padding: 120px 0; background: var(--cream); position: relative; overflow: hidden; }
.jewel-testi::before { content: ''; position: absolute; top: -100px; right: -100px; width: 400px; height: 400px; border-radius: 50%; border: 1px solid var(--border); pointer-events: none; }
.jewel-testi::after { content: ''; position: absolute; bottom: -100px; left: -100px; width: 300px; height: 300px; border-radius: 50%; border: 1px solid var(--border); pointer-events: none; }

.testi-header { text-align: center; margin-bottom: 60px; position: relative; z-index: 2; }
.testi-header h2 { font-size: 36px; color: var(--crimson); margin-top: 16px; }

.testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; position: relative; z-index: 2; }
.testi-card { background: #fff; padding: 40px; border: 1px solid var(--border); position: relative; }
.testi-card::before { content: '”'; position: absolute; top: 10px; right: 20px; font-family: 'Cinzel', serif; font-size: 80px; color: var(--ivory); line-height: 1; pointer-events: none; }
.testi-stars { color: var(--rose-gold); margin-bottom: 24px; font-size: 14px; letter-spacing: 2px; }
.testi-quote { font-size: 15px; color: var(--text); line-height: 1.8; margin-bottom: 30px; font-style: italic; }
.testi-author { display: flex; align-items: center; gap: 16px; border-top: 1px solid var(--border); padding-top: 24px; }
.ta-initial { width: 48px; height: 48px; background: var(--ivory); color: var(--crimson); font-family: 'Cinzel', serif; font-size: 20px; display: flex; align-items: center; justify-content: center; border-radius: 50%; border: 1px dashed var(--rose-gold); }
.ta-info strong { display: block; font-size: 13px; color: var(--text); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 4px; }
.ta-info span { font-size: 11px; color: var(--text-muted); font-family: 'Cinzel', serif; }

@media(max-width: 1024px) {
  .testi-grid { grid-template-columns: 1fr; max-width: 600px; margin: 0 auto; }
}
{% endstyle %}

<section class="jewel-testi">
  <div class="container">
    <div class="testi-header">
      <div class="ornament"><span>✦</span></div>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    
    <div class="testi-grid">
      {%- for block in section.blocks -%}
        <div class="testi-card">
          <div class="testi-stars">★★★★★</div>
          <p class="testi-quote">"{{ block.settings.quote }}"</p>
          <div class="testi-author">
            <div class="ta-initial">{{ block.settings.author | slice: 0, 1 }}</div>
            <div class="ta-info">
              <strong>{{ block.settings.author }}</strong>
              <span>{{ block.settings.location }}</span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Jewellery Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Words of Legacy" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 3,
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "text", "id": "location", "label": "Location / Event" }
      ]
    }
  ],
  "presets": [{ "name": "Jewellery Testimonials" }]
}
{% endschema %}
