<div style="background:#F9EEF0; position:relative; overflow:hidden;">
  <div class="page-width" style="max-width:1440px; margin:0 auto;">
    <div class="jh-hero-grid" style="display:grid; grid-template-columns:1fr 1fr; min-height:85vh; align-items:center;">
      
      <div class="jh-hero-content" style="padding:60px 80px; z-index:2; position:relative;">
        <div style="position:absolute; top:20px; left:20px; right:20px; bottom:20px; border:1px solid rgba(200, 155, 114, 0.3); pointer-events:none;"></div>
        
        {%- if section.settings.eyebrow != blank -%}
          <span style="font-family:'Cinzel', serif; font-size:13px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:#C89B72; margin-bottom:20px; display:flex; align-items:center; gap:12px;">
            <span style="width:30px; height:1px; background:#C89B72;"></span>
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}
        
        <h1 style="font-family:'Cinzel', serif; font-size:clamp(40px, 5vw, 64px); font-weight:400; color:#8B1A2C; line-height:1.15; margin-bottom:24px;">
          {{ section.settings.heading | replace: '<em>', '<i style="font-style:italic; color:#C89B72;">' | replace: '</em>', '</i>' }}
        </h1>
        
        <p style="font-size:16px; line-height:1.8; color:#555; max-width:480px; margin-bottom:48px;">
          {{ section.settings.subheading }}
        </p>
        
        <div class="jh-hero-ctas" style="display:flex; gap:20px;">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="jh-btn-primary" style="display:inline-flex; align-items:center; justify-content:center; background:#8B1A2C; color:#F9EEF0; padding:16px 36px; font-family:'Cinzel', serif; font-size:13px; font-weight:600; letter-spacing:2px; text-transform:uppercase; text-decoration:none; transition:all 0.3s ease; border:1px solid #8B1A2C;">
              {{ section.settings.cta_label }}
            </a>
          {%- endif -%}
          
          {%- if section.settings.cta_label_2 != blank -%}
            <a href="{{ section.settings.cta_url_2 | default: '/pages/book-consultation' }}" class="jh-btn-secondary" style="display:inline-flex; align-items:center; justify-content:center; background:transparent; color:#8B1A2C; padding:16px 36px; font-family:'Cinzel', serif; font-size:13px; font-weight:600; letter-spacing:2px; text-transform:uppercase; text-decoration:none; border:1px solid #C89B72; transition:all 0.3s ease;">
              {{ section.settings.cta_label_2 }}
            </a>
          {%- endif -%}
        </div>
      </div>
      
      <div class="jh-hero-visual" style="position:relative; height:100%; min-height:500px;">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'eager', style: 'width:100%; height:100%; object-fit:cover; position:absolute; inset:0;' }}
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1611591437281-460bfbe1220a?auto=format&fit=crop&w=1000&q=80" alt="Meenakshi Jewellers Bridal" style="width:100%; height:100%; object-fit:cover; position:absolute; inset:0;" loading="eager">
        {%- endif -%}
      </div>
      
    </div>
  </div>

  <style>
    .jh-btn-primary:hover {
      background: #681120 !important;
      border-color: #681120 !important;
    }
    .jh-btn-secondary:hover {
      background: rgba(200, 155, 114, 0.1) !important;
    }
    @media (max-width: 990px) {
      .jh-hero-grid { grid-template-columns: 1fr !important; }
      .jh-hero-content { padding: 60px 24px !important; text-align: center; }
      .jh-hero-content > span { justify-content: center; }
      .jh-hero-content p { margin: 0 auto 40px; }
      .jh-hero-ctas { justify-content: center; }
    }
    @media (max-width: 480px) {
      .jh-hero-ctas { flex-direction: column; width: 100%; }
      .jh-hero-ctas a { width: 100%; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Heritage Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "THE ROYAL COLLECTION"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted for Generations"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover heirloom pieces that carry the legacy of Indian craftsmanship. Every design tells a story of royal heritage."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary Button Label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "cta_label_2",
      "label": "Secondary Button Label",
      "default": "Book Consultation"
    },
    {
      "type": "url",
      "id": "cta_url_2",
      "label": "Secondary Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Heritage Hero"
    }
  ]
}
{% endschema %}
