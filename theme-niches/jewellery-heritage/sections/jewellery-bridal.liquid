<div style="background:#8B1A2C; position:relative; padding:120px 0; overflow:hidden;">
  <div style="position:absolute; inset:0; background:url('https://images.unsplash.com/photo-1596704017254-9b121068fb31?auto=format&fit=crop&w=2000&q=80') center/cover; opacity:0.1; mix-blend-mode:luminosity;"></div>
  
  <div class="page-width" style="max-width:1000px; margin:0 auto; padding:0 24px; position:relative; z-index:2; text-align:center;">
    
    {%- if section.settings.eyebrow != blank -%}
      <div style="font-family:'Cinzel', serif; font-size:12px; font-weight:600; letter-spacing:3px; text-transform:uppercase; color:#C89B72; margin-bottom:24px; display:flex; align-items:center; justify-content:center; gap:16px;">
        <span style="width:40px; height:1px; background:#C89B72;"></span>
        {{ section.settings.eyebrow }}
        <span style="width:40px; height:1px; background:#C89B72;"></span>
      </div>
    {%- endif -%}
    
    <h2 style="font-family:'Cinzel', serif; font-size:clamp(36px, 5vw, 64px); font-weight:400; color:#F9EEF0; margin:0 0 24px 0; line-height:1.1;">
      {{ section.settings.heading }}
    </h2>
    
    <p style="font-size:18px; color:#F9EEF0; opacity:0.8; max-width:700px; margin:0 auto 48px auto; line-height:1.6;">
      {{ section.settings.subheading }}
    </p>
    
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '/pages/bridal' }}" class="jh-btn-gold" style="display:inline-block; padding:18px 48px; background:#C89B72; color:#1a0508; font-family:'Cinzel', serif; font-size:14px; font-weight:600; letter-spacing:2px; text-transform:uppercase; text-decoration:none; transition:all 0.3s ease;">
        {{ section.settings.cta_label }}
      </a>
    {%- endif -%}
    
  </div>

  <style>
    .jh-btn-gold:hover { background: #F9EEF0; }
  </style>
</div>

{% schema %}
{
  "name": "Bridal Consultation",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "PERSONALIZED SERVICE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bridal Consultation"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your wedding day deserves jewellery as unique as your love story. Book a one-on-one session with our bridal stylists to curate your dream trousseau."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "Book an Appointment"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Bridal Consultation"
    }
  ]
}
{% endschema %}
