<div style="background:var(--sup-surface);min-height:90vh;display:flex;align-items:center;padding:80px 40px;position:relative;overflow:hidden">
  
  <div style="position:absolute;top:-20%;right:-10%;width:800px;height:800px;background:#EFF6FF;border-radius:50%;z-index:0"></div>

  <div style="max-width:1200px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;position:relative;z-index:2">
    
    <div>
      <div style="display:flex;gap:12px;margin-bottom:24px">
        <span class="sup-tag">Clinically Studied</span>
        <span class="sup-tag">Third-Party Tested</span>
      </div>
      
      <h1 class="sup-head" style="font-size:clamp(48px, 6vw, 72px);margin-bottom:24px;line-height:1.1">
        {{ section.settings.heading | default: 'Science-Backed<br>Vitality.' }}
      </h1>
      
      <p style="font-size:18px;line-height:1.6;color:var(--sup-muted);margin-bottom:48px;max-width:480px">
        {{ section.settings.text | default: 'Optimized formulations designed to bridge the gap in your daily nutrition. Transparent, pure, and effective.' }}
      </p>
      
      <div style="display:flex;gap:24px;align-items:center">
        <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="sup-btn">{{ section.settings.btn1_text | default: 'Shop Formulations' }}</a>
        <div style="display:flex;align-items:center;gap:12px">
          <div style="display:flex;gap:4px">
            <span style="color:#F59E0B">★</span><span style="color:#F59E0B">★</span><span style="color:#F59E0B">★</span><span style="color:#F59E0B">★</span><span style="color:#F59E0B">★</span>
          </div>
          <span style="font-size:12px;font-weight:600">10,000+ Reviews</span>
        </div>
      </div>
    </div>
    
    <div style="position:relative;display:flex;justify-content:center">
      <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/supplements-hero.png?v=1717283400" alt="Supplement Product" style="width:100%;max-width:500px;height:auto;filter:drop-shadow(0 30px 60px rgba(0, 85, 255, 0.15))">
      
      <!-- Scientific Callout -->
      <div style="position:absolute;bottom:40px;left:-20px;background:#FFF;padding:20px;border-radius:16px;box-shadow:0 20px 40px rgba(0,0,0,0.08);border:1px solid var(--sup-border)">
        <div style="font-size:12px;color:var(--sup-muted);margin-bottom:4px">BIOAVAILABILITY</div>
        <div class="sup-head" style="font-size:24px;color:var(--sup-accent)">98.5%</div>
        <div style="font-size:10px;color:var(--sup-muted);margin-top:4px">Max Absorption Rate</div>
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Supplements Clinical Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Science-Backed<br>Vitality."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Optimized formulations designed to bridge the gap."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button Text",
      "default": "Shop Formulations"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Supplements Clinical Hero"
    }
  ]
}
{% endschema %}
