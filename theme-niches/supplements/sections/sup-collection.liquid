<div style="background:var(--sup-bg);padding:100px 40px">
  <div style="max-width:1400px;margin:0 auto">
    
    <div style="text-align:center;margin-bottom:80px">
      <h2 class="sup-head" style="font-size:40px;margin-bottom:16px">{{ collection.title | default: 'Core Formulations' }}</h2>
      <p style="color:var(--sup-muted);max-width:600px;margin:0 auto">Targeted solutions designed by clinicians to optimize your health, performance, and recovery.</p>
    </div>
    
    <div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:32px">
      {%- for product in collection.products limit: 8 -%}
      <a href="{{ product.url }}" class="sup-card">
        <div class="image-wrapper">
          {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- else -%}
          <div style="width:100%;height:100%;background:#F1F5F9;border-radius:12px"></div>
          {%- endif -%}
        </div>
        <div class="title">{{ product.title }}</div>
        <div class="price">{{ product.price | money }}</div>
        <div class="sup-benefits">
          <div>Supports Energy</div>
          <div>Immune Defense</div>
        </div>
      </a>
      {%- else -%}
      <!-- Demo State -->
      {%- for i in (1..8) -%}
      <a href="#" class="sup-card">
        <div class="image-wrapper">
          <div style="width:100%;height:100%;background:#F1F5F9;border-radius:12px"></div>
        </div>
        <div class="title">Essential Multi V{{i}}</div>
        <div class="price">₹2,499</div>
        <div class="sup-benefits">
          <div>Daily Vitality</div>
          <div>Cellular Health</div>
        </div>
      </a>
      {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Supplements Grid",
  "settings": [],
  "presets": [
    {
      "name": "Supplements Grid"
    }
  ]
}
{% endschema %}
