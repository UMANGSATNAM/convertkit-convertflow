<div style="background:#FAF6F2; padding:100px 5%;">
  <div class="page-width" style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; max-width:600px; margin:0 auto 60px;">
      {%- if section.settings.eyebrow != blank -%}
        <div style="display:inline-flex; background:rgba(193, 127, 94, 0.15); color:#C17F5E; padding:8px 16px; border-radius:30px; font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; margin-bottom:24px;">
          {{ section.settings.eyebrow }}
        </div>
      {%- endif -%}
      <h2 style="font-size:clamp(32px, 4vw, 48px); font-weight:800; line-height:1.1; margin-bottom:16px; letter-spacing:-1px; color:#2A2522;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-size:16px; color:rgba(42,37,34,0.7); line-height:1.6;">
        {{ section.settings.subheading }}
      </p>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:30px;">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.url | default: '/collections/all' }}" style="display:block; position:relative; aspect-ratio:3/4; border-radius:24px; overflow:hidden; text-decoration:none; group;" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', style: 'width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease;', class: 'pg-cat-img' }}
          {%- else -%}
            <div class="pg-cat-img" style="width:100%; height:100%; background:linear-gradient(135deg, #E8D8CD, #C17F5E); transition:transform 0.5s ease;"></div>
          {%- endif -%}
          
          <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(42,37,34,0.8) 0%, rgba(42,37,34,0) 60%); display:flex; flex-direction:column; justify-content:flex-end; padding:30px;">
            <span style="display:block; font-size:24px; font-weight:700; color:#fff; margin-bottom:4px; letter-spacing:-0.5px;">{{ block.settings.title }}</span>
            <span style="display:block; font-size:13px; font-weight:600; color:rgba(255,255,255,0.7); text-transform:uppercase; letter-spacing:1px;">{{ block.settings.count }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>

  <style>
    .pg-cat-img:hover {
      transform: scale(1.05);
    }
  </style>
</div>

{% schema %}
{
  "name": "Pilgrim Categories",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"SHOP BY CONCERN"},
    {"type":"text","id":"heading","label":"Heading","default":"Find Your Ritual"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Targeted solutions for every skin & hair concern"}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {"type":"text","id":"title","label":"Title","default":"Anti-Aging"},
        {"type":"text","id":"count","label":"Subtitle","default":"24 Products"},
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"url","id":"url","label":"URL"}
      ]
    }
  ],
  "presets": [{
    "name": "Pilgrim Categories",
    "blocks": [
      {"type":"category","settings":{"title":"Anti-Aging","count":"24 Products"}},
      {"type":"category","settings":{"title":"Hydration","count":"18 Products"}},
      {"type":"category","settings":{"title":"Brightening","count":"16 Products"}},
      {"type":"category","settings":{"title":"Hair Care","count":"22 Products"}}
    ]
  }]
}
{% endschema %}
