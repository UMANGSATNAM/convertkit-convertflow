<div class="pilgrim-categories">
  <div class="pilgrim-section-header">
    <p class="pilgrim-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>
  <div class="pilgrim-cat-grid">
    {%- for block in section.blocks -%}
    <a href="{{ block.settings.url | default: '/collections/all' }}" class="pilgrim-cat-card" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
      <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" width="600" loading="lazy">
      {%- else -%}
      <div style="width:100%;height:100%;background:linear-gradient(135deg, var(--pilgrim-blush), var(--pilgrim-sand))"></div>
      {%- endif -%}
      <div class="pilgrim-cat-card__overlay">
        <span class="pilgrim-cat-card__title">{{ block.settings.title }}</span>
        <span class="pilgrim-cat-card__count">{{ block.settings.count }}</span>
      </div>
    </a>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Pilgrim Categories",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"SHOP BY CONCERN"},
    {"type":"text","id":"heading","label":"Heading","default":"Find Your Ritual"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Targeted solutions for every skin & hair concern"}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {"type":"text","id":"title","label":"Title","default":"Anti-Aging"},
        {"type":"text","id":"count","label":"Subtitle","default":"24 Products"},
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"url","id":"url","label":"URL"}
      ]
    }
  ],
  "presets": [{
    "name": "Pilgrim Categories",
    "blocks": [
      {"type":"category","settings":{"title":"Anti-Aging","count":"24 Products"}},
      {"type":"category","settings":{"title":"Hydration","count":"18 Products"}},
      {"type":"category","settings":{"title":"Brightening","count":"16 Products"}},
      {"type":"category","settings":{"title":"Hair Care","count":"22 Products"}}
    ]
  }]
}
{% endschema %}
