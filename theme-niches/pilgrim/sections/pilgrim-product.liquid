<div class="product-page page-width" style="padding-top:48px;padding-bottom:80px">
  <nav style="font-size:13px;color:var(--pilgrim-muted);margin-bottom:32px;font-family:'DM Sans',sans-serif" aria-label="Breadcrumb">
    <a href="/" style="color:var(--pilgrim-muted)">Home</a> /
    <a href="{{ product.collections.first.url }}" style="color:var(--pilgrim-muted)">{{ product.collections.first.title }}</a> /
    <span style="color:var(--pilgrim-espresso)">{{ product.title }}</span>
  </nav>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start">
    <!-- Gallery -->
    <div data-gallery>
      <div style="border-radius:20px;overflow:hidden;background:var(--pilgrim-cream);aspect-ratio:1;margin-bottom:12px;cursor:zoom-in" {% if settings.enable_image_zoom %}data-zoom{% endif %}>
        <img id="MainProductImg" data-main-img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" height="900" style="width:100%;height:100%;object-fit:cover">
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        {%- for img in product.images limit: 6 -%}
        <div data-thumb data-src="{{ img | image_url: width: 900 }}" class="{% if forloop.first %}active{% endif %}" style="width:72px;height:72px;border-radius:10px;overflow:hidden;cursor:pointer;border:2px solid {% if forloop.first %}var(--pilgrim-terracotta){% else %}transparent{% endif %};transition:border-color .2s">
          <img src="{{ img | image_url: width: 144 }}" alt="" width="72" height="72" style="width:100%;height:100%;object-fit:cover">
        </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- Product Info -->
    <div>
      <p class="pilgrim-eyebrow" style="margin-bottom:10px">{{ product.vendor }}</p>
      <h1 style="font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:400;color:var(--pilgrim-espresso);margin-bottom:16px;line-height:1.2">{{ product.title }}</h1>

      <!-- Rating placeholder -->
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
        <span style="color:var(--pilgrim-gold);font-size:16px;letter-spacing:2px">★★★★★</span>
        <span style="font-size:13px;color:var(--pilgrim-muted)">({{ product.metafields.reviews.rating_count | default: '2.4k' }} reviews)</span>
      </div>

      <!-- Price -->
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;padding-bottom:24px;border-bottom:1px solid var(--pilgrim-border)">
        <span style="font-size:28px;font-weight:700;color:var(--pilgrim-terracotta)" data-price>{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
        <span style="font-size:18px;color:var(--pilgrim-muted);text-decoration:line-through" data-compare-price>{{ product.compare_at_price | money }}</span>
        <span style="background:rgba(193,127,94,0.12);color:var(--pilgrim-terracotta);padding:4px 12px;font-size:12px;font-weight:700;border-radius:100px">{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round }}% OFF</span>
        {%- endif -%}
      </div>

      <!-- Key Benefits -->
      <div style="display:flex;gap:16px;margin-bottom:24px;flex-wrap:wrap">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
          <div style="display:flex;align-items:center;gap:6px;font-size:13px;color:var(--pilgrim-olive);font-weight:600" {{ block.shopify_attributes }}>
            <span style="font-size:16px">{{ block.settings.icon }}</span>
            {{ block.settings.text }}
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- Stock -->
      {%- if settings.show_stock_counter and product.available -%}
        {%- assign qty = product.selected_or_first_available_variant.inventory_quantity -%}
        {%- if qty > 0 and qty < settings.stock_threshold -%}
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;font-size:13px;color:#DC2626;font-weight:600">
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
          Only {{ qty }} left — selling fast!
        </div>
        {%- endif -%}
      {%- endif -%}

      <!-- Variants -->
      <form action="{{ routes.cart_add_url }}" method="post" id="ProductForm">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
          <div style="margin-bottom:20px">
            <label style="font-size:13px;font-weight:600;letter-spacing:1px;text-transform:uppercase;display:block;margin-bottom:10px;color:var(--pilgrim-espresso)">{{ option.name }}</label>
            <div style="display:flex;gap:8px;flex-wrap:wrap" data-swatches>
              {%- for value in option.values -%}
              <button type="button" data-swatch="{{ value }}" style="padding:10px 20px;border:2px solid {% if option.selected_value == value %}var(--pilgrim-terracotta){% else %}var(--pilgrim-border){% endif %};background:{% if option.selected_value == value %}var(--pilgrim-terracotta){% else %}#fff{% endif %};color:{% if option.selected_value == value %}#fff{% else %}var(--pilgrim-espresso){% endif %};font-size:13px;font-weight:500;cursor:pointer;border-radius:100px;transition:all .2s;font-family:'DM Sans',sans-serif">{{ value }}</button>
              {%- endfor -%}
            </div>
          </div>
          {%- endfor -%}
          <select name="id" data-variant-select style="display:none">
            {%- for variant in product.variants -%}
            <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</option>
            {%- endfor -%}
          </select>
        {%- endunless -%}

        <!-- Quantity + ATC -->
        <div style="display:flex;gap:12px;margin-bottom:12px">
          <div style="display:flex;align-items:center;border:1.5px solid var(--pilgrim-border);border-radius:100px;overflow:hidden">
            <button type="button" class="qty-selector__btn" data-dir="down" style="width:44px;height:52px;background:none;border:none;font-size:20px;cursor:pointer;color:var(--pilgrim-espresso)">−</button>
            <input type="number" name="quantity" value="1" min="1" style="width:48px;height:52px;text-align:center;border:none;font-size:16px;font-weight:600;font-family:'DM Sans',sans-serif">
            <button type="button" class="qty-selector__btn" data-dir="up" style="width:44px;height:52px;background:none;border:none;font-size:20px;cursor:pointer;color:var(--pilgrim-espresso)">+</button>
          </div>
          <button type="submit" class="pilgrim-btn" data-atc style="flex:1;justify-content:center;font-size:15px" {% unless product.available %}disabled{% endunless %}>
            {%- if product.available -%}{{ section.settings.atc_text }}{%- else -%}Sold Out{%- endif -%}
          </button>
        </div>
        {%- if section.settings.show_buy_now and product.available -%}
        <a href="{{ product.selected_or_first_available_variant.url | append: '?action=buy_now' }}" class="pilgrim-btn pilgrim-btn--outline" style="width:100%;display:flex;justify-content:center;margin-bottom:20px">{{ section.settings.buy_now_text }}</a>
        {%- endif -%}
      </form>

      <!-- Trust Badges -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:24px;padding:20px;background:var(--pilgrim-sand);border-radius:16px">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_badge' -%}
          <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--pilgrim-muted)" {{ block.shopify_attributes }}>
            <span style="color:var(--pilgrim-terracotta)">{{ block.settings.icon }}</span>
            {{ block.settings.text }}
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- Description -->
      <div style="font-family:'DM Sans',sans-serif;font-size:15px;line-height:1.8;color:var(--pilgrim-muted)">{{ product.description }}</div>

      <!-- Share -->
      <div style="margin-top:24px;padding-top:24px;border-top:1px solid var(--pilgrim-border);display:flex;align-items:center;gap:12px">
        <span style="font-size:13px;color:var(--pilgrim-muted)">Share:</span>
        <a href="https://www.facebook.com/sharer.php?u={{ shop.url }}{{ product.url }}" target="_blank" rel="noopener" style="color:var(--pilgrim-muted);font-size:13px">Facebook</a>
        <a href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ product.url }}&text={{ product.title | url_encode }}" target="_blank" rel="noopener" style="color:var(--pilgrim-muted);font-size:13px">Twitter</a>
        <a href="whatsapp://send?text={{ product.title | url_encode }}%20{{ shop.url }}{{ product.url }}" style="color:var(--pilgrim-muted);font-size:13px">WhatsApp</a>
      </div>
    </div>
  </div>
</div>

{%- if settings.sticky_atc -%}
<div class="sticky-atc" id="StickyATC" style="opacity:0;transition:opacity .3s;background:var(--pilgrim-cream);border-top:1px solid var(--pilgrim-border)">
  <img src="{{ product.featured_image | image_url: width: 80 }}" alt="" width="40" height="40" style="border-radius:10px;object-fit:cover">
  <div style="flex:1;min-width:0"><div style="font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--pilgrim-espresso)">{{ product.title }}</div><div style="font-size:14px;color:var(--pilgrim-terracotta);font-weight:700">{{ product.price | money }}</div></div>
  <button class="pilgrim-btn" data-atc onclick="document.getElementById('ProductForm').requestSubmit()">{{ section.settings.atc_text }}</button>
</div>
<script>
const sa=document.getElementById('StickyATC');const pf=document.getElementById('ProductForm');
window.addEventListener('scroll',()=>{sa.style.opacity=pf.getBoundingClientRect().bottom<0?'1':'0';},{passive:true});
</script>
{%- endif -%}

{% schema %}
{
  "name":"Pilgrim Product",
  "settings":[
    {"type":"text","id":"atc_text","label":"Add to Cart Text","default":"Add to Ritual"},
    {"type":"checkbox","id":"show_buy_now","label":"Show Buy Now","default":true},
    {"type":"text","id":"buy_now_text","label":"Buy Now Text","default":"Buy Now"}
  ],
  "blocks":[
    {"type":"trust_badge","name":"Trust Badge","limit":6,"settings":[
      {"type":"text","id":"icon","label":"Icon","default":"✓"},
      {"type":"text","id":"text","label":"Text","default":"Free Delivery"}
    ]},
    {"type":"benefit","name":"Product Benefit","limit":4,"settings":[
      {"type":"text","id":"icon","label":"Icon","default":"🌿"},
      {"type":"text","id":"text","label":"Text","default":"100% Vegan"}
    ]}
  ],
  "presets":[{"name":"Pilgrim Product","blocks":[
    {"type":"benefit","settings":{"icon":"🌿","text":"100% Vegan"}},
    {"type":"benefit","settings":{"icon":"🧪","text":"Dermat Tested"}},
    {"type":"benefit","settings":{"icon":"🐰","text":"Cruelty Free"}},
    {"type":"trust_badge","settings":{"icon":"🔒","text":"Secure Checkout"}},
    {"type":"trust_badge","settings":{"icon":"🚚","text":"Free Shipping ₹499+"}},
    {"type":"trust_badge","settings":{"icon":"↩️","text":"Easy Returns"}},
    {"type":"trust_badge","settings":{"icon":"✓","text":"Authentic Products"}}
  ]}]
}
{% endschema %}
