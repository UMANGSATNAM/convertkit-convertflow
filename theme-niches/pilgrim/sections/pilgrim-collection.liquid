<div style="background:var(--pil-bg);padding:100px 40px;position:relative">
  <div style="max-width:1400px;margin:0 auto">
    
    <div style="text-align:center;margin-bottom:80px">
      <h2 class="pil-head" style="font-size:48px;margin-bottom:16px">{{ collection.title | default: 'Bestselling Rituals' }}</h2>
      <p style="font-size:16px;color:var(--pil-muted);max-width:500px;margin:0 auto">Curated formulations designed to elevate your daily self-care routine with nature's purest ingredients.</p>
    </div>
    
    <div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:40px 32px">
      {%- for product in collection.products limit: 8 -%}
      <a href="{{ product.url }}" class="pil-card">
        <div class="image-wrapper">
          <div class="pil-badge">BESTSELLER</div>
          {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- else -%}
          <div style="width:100%;height:100%;background:var(--pil-soft);border-radius:180px 180px 10px 10px"></div>
          {%- endif -%}
        </div>
        <div class="title">{{ product.title }}</div>
        <div class="price">{{ product.price | money }}</div>
      </a>
      {%- else -%}
      <!-- Demo State -->
      {%- for i in (1..4) -%}
      <a href="#" class="pil-card">
        <div class="image-wrapper">
          <div class="pil-badge">VEGAN</div>
          <div style="width:100%;height:100%;background:var(--pil-soft);border-radius:180px 180px 10px 10px"></div>
        </div>
        <div class="title">Volcanic Clay Mask V{{i}}</div>
        <div class="price">₹550</div>
      </a>
      {%- endfor -%}
      {%- endfor -%}
    </div>
    
    <div style="text-align:center;margin-top:80px">
      <a href="/collections/all" class="pil-btn">View All Products</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pilgrim Organic Grid",
  "settings": [],
  "presets": [
    {
      "name": "Pilgrim Organic Grid"
    }
  ]
}
{% endschema %}
