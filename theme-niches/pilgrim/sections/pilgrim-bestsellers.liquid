<div style="background:#fff; padding:100px 5%;">
  <div class="page-width" style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; max-width:600px; margin:0 auto 60px;">
      {%- if section.settings.eyebrow != blank -%}
        <div style="display:inline-flex; background:rgba(193, 127, 94, 0.15); color:#C17F5E; padding:8px 16px; border-radius:30px; font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; margin-bottom:24px;">
          {{ section.settings.eyebrow }}
        </div>
      {%- endif -%}
      <h2 style="font-size:clamp(32px, 4vw, 48px); font-weight:800; line-height:1.1; margin-bottom:16px; letter-spacing:-1px; color:#2A2522;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-size:16px; color:rgba(42,37,34,0.7); line-height:1.6;">
        {{ section.settings.subheading }}
      </p>
    </div>

    {%- assign col = collections[section.settings.collection] -%}
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:40px 24px;">
      {%- for product in col.products limit: section.settings.count -%}
        <div style="position:relative; group;">
          <a href="{{ product.url }}" style="display:block; text-decoration:none;">
            <div style="position:relative; aspect-ratio:4/5; border-radius:20px; overflow:hidden; background:#FAF6F2; margin-bottom:20px;">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', style: 'width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease;', class: 'pg-prod-img' }}
              {%- else -%}
                <div class="pg-prod-img" style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:rgba(42,37,34,0.2);">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                </div>
              {%- endif -%}
              
              {%- if product.tags contains 'bestseller' -%}
                <div style="position:absolute; top:16px; left:16px; background:#C17F5E; color:#fff; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; padding:6px 12px; border-radius:20px;">
                  Bestseller
                </div>
              {%- elsif product.tags contains 'new' -%}
                <div style="position:absolute; top:16px; left:16px; background:#2A2522; color:#fff; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; padding:6px 12px; border-radius:20px;">
                  New
                </div>
              {%- endif -%}
              
              <!-- Quick Add Hover Button -->
              <div class="pg-quick-add" style="position:absolute; bottom:16px; left:16px; right:16px; opacity:0; transform:translateY(10px); transition:all 0.3s ease;">
                <button type="button" style="width:100%; background:rgba(255,255,255,0.9); backdrop-filter:blur(10px); color:#2A2522; border:none; padding:14px; border-radius:12px; font-size:13px; font-weight:700; cursor:pointer;">
                  Quick Add
                </button>
              </div>
            </div>
            
            <div style="text-align:center;">
              <h3 style="font-size:16px; font-weight:700; color:#2A2522; margin-bottom:8px; line-height:1.4;">{{ product.title | default: 'Example Product Title' }}</h3>
              <p style="font-size:15px; font-weight:600; color:#C17F5E; margin:0;">{{ product.price | money | default: '₹599.00' }}</p>
            </div>
          </a>
        </div>
      {%- else -%}
        <!-- Dummy Placeholders for Previews -->
        {%- for i in (1..section.settings.count) -%}
          <div style="position:relative; group;">
            <div style="position:relative; aspect-ratio:4/5; border-radius:20px; overflow:hidden; background:#FAF6F2; margin-bottom:20px;">
              <div class="pg-prod-img" style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:rgba(42,37,34,0.2);">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </div>
            </div>
            <div style="text-align:center;">
              <h3 style="font-size:16px; font-weight:700; color:#2A2522; margin-bottom:8px; line-height:1.4;">Example Skincare Product</h3>
              <p style="font-size:15px; font-weight:600; color:#C17F5E; margin:0;">₹599.00</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    <div style="text-align:center; margin-top:60px;">
      <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="pg-btn-outline" style="display:inline-flex; align-items:center; justify-content:center; padding:16px 40px; border:2px solid #2A2522; border-radius:50px; color:#2A2522; font-size:14px; font-weight:700; text-decoration:none; transition:all 0.3s ease;">
        {{ section.settings.cta_label }}
      </a>
    </div>
  </div>

  <style>
    .pg-prod-img:hover {
      transform: scale(1.05);
    }
    div[style*="group"]:hover .pg-quick-add {
      opacity: 1;
      transform: translateY(0);
    }
    .pg-btn-outline:hover {
      background: #2A2522;
      color: #fff !important;
    }
  </style>
</div>

{% schema %}
{
  "name": "Pilgrim Bestsellers",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"COMMUNITY FAVORITES"},
    {"type":"text","id":"heading","label":"Heading","default":"Bestsellers You'll Love"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Tried, tested, and adored by thousands"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"count","label":"Products to show","min":4,"max":12,"step":4,"default":8},
    {"type":"text","id":"cta_label","label":"Button Label","default":"View All Bestsellers"},
    {"type":"url","id":"cta_url","label":"Button URL"}
  ],
  "presets":[{"name":"Pilgrim Bestsellers"}]
}
{% endschema %}
