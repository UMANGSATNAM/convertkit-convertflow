<div class="pilgrim-bestsellers">
  <div class="pilgrim-section-header">
    <p class="pilgrim-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>
  {%- assign col = collections[section.settings.collection] -%}
  <div class="pilgrim-prod-grid">
    {%- for product in col.products limit: section.settings.count -%}
    <a href="{{ product.url }}" class="pilgrim-prod-card" style="text-decoration:none">
      <div class="pilgrim-prod-card__img">
        {%- if product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">
        {%- else -%}
        <div style="width:100%;height:100%;background:var(--pilgrim-cream);display:flex;align-items:center;justify-content:center">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--pilgrim-border)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
        {%- endif -%}
      </div>
      <div class="pilgrim-prod-card__info">
        {%- if product.tags contains 'bestseller' -%}
        <span class="pilgrim-prod-card__tag">Bestseller</span>
        {%- elsif product.tags contains 'new' -%}
        <span class="pilgrim-prod-card__tag">New</span>
        {%- endif -%}
        <div class="pilgrim-prod-card__name">{{ product.title }}</div>
        <div class="pilgrim-prod-card__price">{{ product.price | money }}</div>
      </div>
    </a>
    {%- endfor -%}
  </div>
  <div style="text-align:center;margin-top:48px">
    <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="pilgrim-btn">{{ section.settings.cta_label }}</a>
  </div>
</div>
{% schema %}
{
  "name": "Pilgrim Bestsellers",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"COMMUNITY FAVORITES"},
    {"type":"text","id":"heading","label":"Heading","default":"Bestsellers You'll Love"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Tried, tested, and adored by thousands"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"count","label":"Products to show","min":4,"max":12,"step":4,"default":8},
    {"type":"text","id":"cta_label","label":"Button Label","default":"View All Bestsellers"},
    {"type":"url","id":"cta_url","label":"Button URL"}
  ],
  "presets":[{"name":"Pilgrim Bestsellers"}]
}
{% endschema %}
