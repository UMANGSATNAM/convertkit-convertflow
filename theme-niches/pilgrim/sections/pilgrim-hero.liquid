<div class="pilgrim-hero">
  <div class="pilgrim-hero__content">
    <p class="pilgrim-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="pilgrim-hero__title">{{ section.settings.heading }}</h1>
    <p class="pilgrim-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:14px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="pilgrim-btn">
        {{ section.settings.cta_label }}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      {%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}
      <a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="pilgrim-btn pilgrim-btn--outline">{{ section.settings.cta_label_2 }}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="pilgrim-hero__visual">
    {%- if section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">
    {%- else -%}
    <div style="width:100%;height:100%;min-height:500px;background:linear-gradient(135deg,#E8C4B8,#C17F5E);display:flex;align-items:center;justify-content:center">
      <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
    </div>
    {%- endif -%}
    <div class="pilgrim-hero__badge">
      <div style="display:flex;align-items:center;gap:10px">
        <span style="font-size:24px">🌿</span>
        <div>
          <div style="font-weight:700;font-size:14px;color:#2C1810">100% Clean Beauty</div>
          <div style="font-size:12px;color:#8B7355">Cruelty-free · Vegan · Paraben-free</div>
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Pilgrim Hero",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"KOREAN BEAUTY × INDIAN RITUALS"},
    {"type":"text","id":"heading","label":"Heading","default":"Beauty That Travels the World for You"},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Pilgrim brings the best of global beauty secrets — from Jeju Island volcanos to Amazonian clays — straight to your skin."},
    {"type":"image_picker","id":"image","label":"Hero Image"},
    {"type":"text","id":"cta_label","label":"CTA Label","default":"Explore Collection"},
    {"type":"url","id":"cta_url","label":"CTA URL"},
    {"type":"text","id":"cta_label_2","label":"Secondary CTA","default":"Our Story"},
    {"type":"url","id":"cta_url_2","label":"Secondary URL"}
  ],
  "presets":[{"name":"Pilgrim Hero"}]
}
{% endschema %}
