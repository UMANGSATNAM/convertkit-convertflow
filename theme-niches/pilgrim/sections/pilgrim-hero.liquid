<div class="pg-hero-wrapper" style="position:relative; min-height:85vh; display:flex; align-items:center; overflow:hidden; background:linear-gradient(135deg, #FFF0E5 0%, #FAF6F2 100%);">
  <style>
    .pg-hero-grid {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 60px;
      align-items: center;
      position: relative;
      z-index: 2;
    }
    .pg-badge {
      display: inline-flex;
      background: rgba(193, 127, 94, 0.15);
      color: #C17F5E;
      padding: 8px 16px;
      border-radius: 30px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 24px;
    }
    .pg-hero-h1 {
      font-size: clamp(40px, 6vw, 72px);
      font-weight: 800;
      line-height: 1.05;
      margin-bottom: 24px;
      letter-spacing: -1.5px;
      color: #2A2522;
      font-family: inherit;
    }
    .pg-hero-h1 i {
      font-style: italic;
      color: #C17F5E;
      font-weight: 400;
    }
    .pg-hero-p {
      font-size: clamp(16px, 2vw, 18px);
      color: rgba(42, 37, 34, 0.7);
      margin-bottom: 40px;
      max-width: 480px;
    }
    .pg-cta {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: #2A2522;
      color: #fff;
      padding: 18px 40px;
      border-radius: 50px;
      font-size: 15px;
      font-weight: 700;
      text-decoration: none;
      transition: transform 0.3s, background 0.3s;
    }
    .pg-cta:hover {
      transform: translateY(-2px);
      background: #C17F5E;
    }
    .pg-hero-visual {
      position: relative;
      width: 100%;
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .pg-circle-1 {
      position: absolute;
      width: 80%;
      height: 80%;
      border-radius: 50%;
      background: #E8D8CD;
      top: 5%;
      right: 0;
      filter: blur(40px);
      opacity: 0.6;
    }
    .pg-circle-2 {
      position: absolute;
      width: 60%;
      height: 60%;
      border-radius: 50%;
      background: #C17F5E;
      bottom: 10%;
      left: 5%;
      filter: blur(60px);
      opacity: 0.2;
    }
    .pg-img-mask {
      position: relative;
      width: 85%;
      height: 95%;
      border-radius: 200px 200px 24px 24px;
      overflow: hidden;
      background: #fff;
      border: 4px solid #FAF6F2;
      box-shadow: 0 30px 60px rgba(193, 127, 94, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .pg-img-mask img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .pg-floating-card {
      position: absolute;
      bottom: 10%;
      left: -5%;
      background: rgba(255,255,255,0.9);
      backdrop-filter: blur(10px);
      padding: 16px 24px;
      border-radius: 20px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.08);
      display: flex;
      align-items: center;
      gap: 12px;
      border: 1px solid rgba(255,255,255,0.4);
    }
    .pg-floating-card p {
      margin: 0;
      font-size: 12px;
      font-weight: 700;
      color: #2A2522;
      line-height: 1.2;
    }
    .pg-floating-card span {
      font-size: 11px;
      color: #C17F5E;
      font-weight: 600;
    }
    @media (max-width: 1024px) {
      .pg-hero-grid {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 40px;
        padding-top: 40px;
      }
      .pg-hero-p {
        margin: 0 auto 40px;
      }
      .pg-floating-card {
        display: none;
      }
      .pg-img-mask {
        border-radius: 120px 120px 24px 24px;
      }
    }
    @media (max-width: 640px) {
      .pg-hero-wrapper {
        min-height: auto;
        padding-bottom: 60px;
      }
    }
  </style>

  <div class="page-width pg-hero-grid" style="max-width: 1440px; margin: 0 auto; width: 100%; padding: 0 5%;">
    <div>
      {% if section.settings.eyebrow != blank %}
        <div class="pg-badge">{{ section.settings.eyebrow }}</div>
      {% endif %}
      
      <h1 class="pg-hero-h1">
        {{ section.settings.heading | replace: '<em>', '<i>' | replace: '</em>', '</i>' }}
      </h1>
      
      {% if section.settings.subheading != blank %}
        <p class="pg-hero-p">{{ section.settings.subheading }}</p>
      {% endif %}
      
      <div style="display:flex; gap:16px; align-items:center; flex-wrap:wrap;">
        {% if section.settings.cta_label != blank %}
          <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="pg-cta">
            {{ section.settings.cta_label }}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {% endif %}
        
        {% if section.settings.cta_label_2 != blank %}
          <a href="{{ section.settings.cta_link_2 | default: '/pages/about' }}" style="font-size:14px; font-weight:600; color:#2A2522; text-decoration:underline; text-underline-offset:4px;">
            {{ section.settings.cta_label_2 }}
          </a>
        {% endif %}
      </div>
    </div>
    
    <div class="pg-hero-visual">
      <div class="pg-circle-1"></div>
      <div class="pg-circle-2"></div>
      <div class="pg-img-mask">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', sizes: '(min-width: 1024px) 50vw, 100vw', style: 'width: 100%; height: 100%; object-fit: cover;' }}
        {% else %}
          <img src="https://images.unsplash.com/photo-1615397323237-77fb270fb759?q=80&w=800&auto=format&fit=crop" alt="Skincare Model" style="width: 100%; height: 100%; object-fit: cover;" loading="eager">
        {% endif %}
      </div>
      
      {% if section.settings.show_floating_badge %}
        <div class="pg-floating-card">
          <div style="padding: 6px; background: #fff; border-radius: 50%; color: #C17F5E; display: flex;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          </div>
          <div>
            <p>{{ section.settings.badge_title | default: 'FDA Approved' }}</p>
            <span>{{ section.settings.badge_subtitle | default: 'Dermatologically Tested' }}</span>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pilgrim Wabi-Sabi Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "KOREAN BEAUTY × INDIAN RITUALS"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Ancient Beauty,<br><em>Modern Science.</em>",
      "info": "Use <em> tags to highlight text in Rosewood color."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover potent skincare formulations crafted with pure global ingredients. Unlock the secret to radiant, healthy skin."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary Button Label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "cta_label_2",
      "label": "Secondary Link Label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "cta_link_2",
      "label": "Secondary Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "header",
      "content": "Floating Trust Badge"
    },
    {
      "type": "checkbox",
      "id": "show_floating_badge",
      "label": "Show floating badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_title",
      "label": "Badge Title",
      "default": "FDA Approved"
    },
    {
      "type": "text",
      "id": "badge_subtitle",
      "label": "Badge Subtitle",
      "default": "Dermatologically Tested"
    }
  ],
  "presets": [
    {
      "name": "Pilgrim Wabi-Sabi Hero"
    }
  ]
}
{% endschema %}
