<div style="background:var(--pil-bg);min-height:90vh;display:flex;align-items:center;padding:80px 40px;position:relative;overflow:hidden">
  
  <!-- Soft Background Blobs -->
  <div style="position:absolute;top:-10%;left:-5%;width:600px;height:600px;background:var(--pil-soft);filter:blur(100px);opacity:0.6;border-radius:50%;z-index:0"></div>
  <div style="position:absolute;bottom:0;right:0;width:500px;height:500px;background:#F5E6E8;filter:blur(120px);opacity:0.5;border-radius:50%;z-index:0"></div>

  <div style="max-width:1400px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;position:relative;z-index:2">
    <div style="padding-right:40px">
      <div class="pil-overline" style="margin-bottom:24px">{{ section.settings.overline | default: 'Pure Origin Ingredients' }}</div>
      <h1 class="pil-head" style="font-size:clamp(50px, 6vw, 80px);line-height:1.1;margin-bottom:32px">
        {{ section.settings.heading | default: 'Nature’s Best,<br>Unbottled.' }}
      </h1>
      <p style="font-size:17px;line-height:1.7;color:var(--pil-muted);margin-bottom:48px;max-width:440px">
        {{ section.settings.text | default: 'Discover our new Jeju Island Volcanic Collection. Crafted with ethically sourced botanicals for a natural, radiant glow.' }}
      </p>
      <div style="display:flex;gap:20px;align-items:center">
        <a href="{{ section.settings.btn1_url | default: '/collections/skincare' }}" class="pil-btn">{{ section.settings.btn1_text | default: 'Explore Skincare' }}</a>
        <a href="{{ section.settings.btn2_url | default: '/pages/our-story' }}" style="font-family:var(--font-b);font-size:14px;text-transform:uppercase;letter-spacing:0.05em;color:var(--pil-text);text-decoration:underline;font-weight:500;padding:16px">{{ section.settings.btn2_text | default: 'Our Story' }}</a>
      </div>
    </div>
    
    <div style="position:relative">
      <div class="pil-organic-mask" style="width:100%;aspect-ratio:4/5;position:relative">
        <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/beauty-hero.jpg?v=1717283400" alt="Beauty Hero" style="width:100%;height:100%;object-fit:cover">
      </div>
      
      <!-- Floating Benefit Tag -->
      <div style="position:absolute;bottom:40px;left:-40px;background:#FFF;padding:20px 32px;border-radius:100px;box-shadow:0 20px 40px rgba(0,0,0,0.05);display:flex;align-items:center;gap:16px;animation:float 6s ease-in-out infinite">
        <div style="width:40px;height:40px;background:var(--pil-soft);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--pil-accent)">✨</div>
        <div>
          <div class="pil-head" style="font-size:18px;margin-bottom:2px">100% Vegan</div>
          <div style="font-size:12px;color:var(--pil-muted)">Cruelty-Free Certified</div>
        </div>
      </div>
      <style>
        @keyframes float {
          0% { transform: translateY(0px); }
          50% { transform: translateY(-15px); }
          100% { transform: translateY(0px); }
        }
      </style>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pilgrim Organic Hero",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline Text",
      "default": "Pure Origin Ingredients"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nature’s Best,<br>Unbottled."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Discover our new Jeju Island Volcanic Collection."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Primary Button",
      "default": "Explore Skincare"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Primary Link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Secondary Text",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Secondary Link"
    }
  ],
  "presets": [
    {
      "name": "Pilgrim Organic Hero"
    }
  ]
}
{% endschema %}
