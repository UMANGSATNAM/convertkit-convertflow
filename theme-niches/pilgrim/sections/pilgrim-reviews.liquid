<div style="background:#fff; padding:100px 5%;">
  <div class="page-width" style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; max-width:600px; margin:0 auto 60px;">
      {%- if section.settings.eyebrow != blank -%}
        <div style="display:inline-flex; background:rgba(193, 127, 94, 0.15); color:#C17F5E; padding:8px 16px; border-radius:30px; font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; margin-bottom:24px;">
          {{ section.settings.eyebrow }}
        </div>
      {%- endif -%}
      <h2 style="font-size:clamp(32px, 4vw, 48px); font-weight:800; line-height:1.1; margin-bottom:16px; letter-spacing:-1px; color:#2A2522;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-size:16px; color:rgba(42,37,34,0.7); line-height:1.6;">
        {{ section.settings.subheading }}
      </p>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:30px;">
      {%- for block in section.blocks -%}
        <div style="background:#FAF6F2; padding:40px; border-radius:24px; position:relative; display:flex; flex-direction:column; justify-content:space-between;" {{ block.shopify_attributes }}>
          <div>
            <div style="color:#C17F5E; font-size:18px; margin-bottom:24px; letter-spacing:2px;">
              {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
              {%- assign empty = 5 | minus: block.settings.rating -%}
              {%- for i in (1..empty) -%}<span style="opacity:0.3">★</span>{%- endfor -%}
            </div>
            <p style="font-size:18px; color:#2A2522; line-height:1.6; margin-bottom:32px; font-weight:500;">
              "{{ block.settings.quote }}"
            </p>
          </div>
          <div style="display:flex; align-items:center; gap:16px;">
            <div style="width:48px; height:48px; border-radius:50%; background:#E8D8CD; display:flex; align-items:center; justify-content:center; color:#C17F5E; font-weight:700; font-size:16px;">
              {{ block.settings.name | slice: 0, 1 }}
            </div>
            <div>
              <div style="font-size:15px; font-weight:700; color:#2A2522;">{{ block.settings.name }}</div>
              <div style="font-size:13px; color:rgba(42,37,34,0.6); display:flex; align-items:center; gap:6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                Verified · {{ block.settings.product }}
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Pilgrim Reviews",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"REAL REVIEWS"},
    {"type":"text","id":"heading","label":"Heading","default":"Loved by 5 Lakh+ Customers"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Don't just take our word for it — hear from our community"}
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},
        {"type":"textarea","id":"quote","label":"Quote","default":"My skin has never felt this good. The Vitamin C serum is a game-changer!"},
        {"type":"text","id":"name","label":"Name","default":"Sneha P."},
        {"type":"text","id":"product","label":"Product","default":"Vitamin C Face Serum"},
        {"type":"text","id":"location","label":"Location","default":"Mumbai"}
      ]
    }
  ],
  "presets": [{
    "name": "Pilgrim Reviews",
    "blocks": [
      {"type":"review","settings":{"rating":5,"quote":"My skin has never felt this good. The Vitamin C serum is a game-changer — visible glow in just 2 weeks!","name":"Sneha P.","product":"Vitamin C Serum","location":"Mumbai"}},
      {"type":"review","settings":{"rating":5,"quote":"I've tried so many shampoos but Pilgrim's Argan Oil one actually stopped my hair fall. Absolutely love it.","name":"Priya K.","product":"Argan Shampoo","location":"Delhi"}},
      {"type":"review","settings":{"rating":5,"quote":"The Jeju face wash leaves my skin so clean without drying it out. Perfect for my oily skin. Repurchased 3 times!","name":"Arjun M.","product":"Jeju Volcanic Face Wash","location":"Bangalore"}}
    ]
  }]
}
{% endschema %}
