<div style="padding:80px 20px;background:var(--pilgrim-sand)">
  <div style="max-width:1320px;margin:0 auto">
    <div class="pilgrim-section-header">
      <p class="pilgrim-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <!-- Frequently Bought Together Bundle -->
    <div style="background:#fff;border-radius:20px;padding:36px;margin-bottom:48px;border:1px solid var(--pilgrim-border)">
      <div style="display:flex;align-items:center;gap:24px;flex-wrap:wrap;justify-content:center;margin-bottom:32px">
        <!-- Current product -->
        <div style="text-align:center;flex:0 0 160px">
          <div style="width:140px;height:140px;border-radius:16px;overflow:hidden;margin:0 auto 12px;background:var(--pilgrim-cream)">
            <img src="{{ product.featured_image | image_url: width: 280 }}" alt="{{ product.title | escape }}" width="140" style="width:100%;height:100%;object-fit:cover">
          </div>
          <div style="font-size:13px;font-weight:600;color:var(--pilgrim-espresso)">{{ product.title | truncate: 30 }}</div>
          <div style="font-size:14px;font-weight:700;color:var(--pilgrim-terracotta)">{{ product.price | money }}</div>
        </div>

        {%- for block in section.blocks -%}
          {%- if block.type == 'bundle_product' -%}
          {%- assign bp = all_products[block.settings.product] -%}
          {%- if bp != blank -%}
          <div style="font-size:28px;color:var(--pilgrim-border)">+</div>
          <div style="text-align:center;flex:0 0 160px" {{ block.shopify_attributes }}>
            <div style="width:140px;height:140px;border-radius:16px;overflow:hidden;margin:0 auto 12px;background:var(--pilgrim-cream)">
              <img src="{{ bp.featured_image | image_url: width: 280 }}" alt="{{ bp.title | escape }}" width="140" style="width:100%;height:100%;object-fit:cover">
            </div>
            <div style="font-size:13px;font-weight:600;color:var(--pilgrim-espresso)">{{ bp.title | truncate: 30 }}</div>
            <div style="font-size:14px;font-weight:700;color:var(--pilgrim-terracotta)">{{ bp.price | money }}</div>
          </div>
          {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div style="text-align:center;padding-top:24px;border-top:1px solid var(--pilgrim-border)">
        <div style="font-size:13px;color:var(--pilgrim-muted);margin-bottom:8px">Bundle price</div>
        <div style="font-size:24px;font-weight:700;color:var(--pilgrim-terracotta);margin-bottom:16px">Save up to 15% on this ritual</div>
        <a href="/cart" class="pilgrim-btn" style="font-size:14px">Add Complete Ritual to Cart</a>
      </div>
    </div>

    <!-- Cross-sell / Recommendations Grid -->
    <h3 style="font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:400;color:var(--pilgrim-espresso);text-align:center;margin-bottom:32px">{{ section.settings.cross_sell_heading }}</h3>
    {%- assign rec_col = collections[section.settings.recommendation_collection] -%}
    <div class="pilgrim-prod-grid">
      {%- for p in rec_col.products limit: 4 -%}
        {%- if p.handle != product.handle -%}
        <a href="{{ p.url }}" class="pilgrim-prod-card" style="text-decoration:none">
          <div class="pilgrim-prod-card__img">
            {%- if p.featured_image != blank -%}
            <img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.title | escape }}" width="600" loading="lazy">
            {%- else -%}
            <div style="width:100%;height:100%;background:var(--pilgrim-cream)"></div>
            {%- endif -%}
          </div>
          <div class="pilgrim-prod-card__info">
            <div class="pilgrim-prod-card__name">{{ p.title }}</div>
            <div class="pilgrim-prod-card__price">{{ p.price | money }}</div>
          </div>
        </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name":"Pilgrim Cross-Sell",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"COMPLETE YOUR RITUAL"},
    {"type":"text","id":"heading","label":"Heading","default":"Better Together"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Pair these products for maximum results"},
    {"type":"text","id":"cross_sell_heading","label":"Cross-sell Heading","default":"You May Also Love"},
    {"type":"collection","id":"recommendation_collection","label":"Recommendation Collection"}
  ],
  "blocks":[
    {"type":"bundle_product","name":"Bundle Product","limit":3,"settings":[
      {"type":"product","id":"product","label":"Product"}
    ]}
  ],
  "presets":[{"name":"Pilgrim Cross-Sell"}]
}
{% endschema %}
