<div class="pilgrim-trust">
  <div class="pilgrim-trust__grid">
    {%- for block in section.blocks -%}
    <div class="pilgrim-trust__item" {{ block.shopify_attributes }}>
      <div class="pilgrim-trust__icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          {%- case block.settings.icon -%}
            {%- when 'leaf' -%}<path d="M17 8C8 10 5.9 16.17 3.82 21.34M17 8V2m0 6h6M3.82 21.34A5.82 5.82 0 0 0 9 24c3.31 0 6-2 7.7-4.88"/>{%- when 'shield' -%}<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>{%- when 'truck' -%}<rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>{%- when 'heart' -%}<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>{%- else -%}<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>{%- endcase -%}
        </svg>
      </div>
      <div class="pilgrim-trust__title">{{ block.settings.title }}</div>
      <div class="pilgrim-trust__desc">{{ block.settings.desc }}</div>
    </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Pilgrim Trust",
  "settings": [],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {"type":"select","id":"icon","label":"Icon","options":[{"value":"leaf","label":"Leaf (Natural)"},{"value":"shield","label":"Shield (Safe)"},{"value":"truck","label":"Truck (Shipping)"},{"value":"heart","label":"Heart (Love)"},{"value":"check","label":"Checkmark"}],"default":"leaf"},
        {"type":"text","id":"title","label":"Title","default":"100% Vegan"},
        {"type":"text","id":"desc","label":"Description","default":"No animal-derived ingredients ever"}
      ]
    }
  ],
  "presets": [{
    "name": "Pilgrim Trust",
    "blocks": [
      {"type":"badge","settings":{"icon":"leaf","title":"100% Vegan","desc":"No animal-derived ingredients ever"}},
      {"type":"badge","settings":{"icon":"shield","title":"Dermat Tested","desc":"Clinically validated for all skin types"}},
      {"type":"badge","settings":{"icon":"truck","title":"Free Shipping","desc":"On orders above ₹499"}},
      {"type":"badge","settings":{"icon":"heart","title":"Cruelty-Free","desc":"Never tested on animals — certified"}}
    ]
  }]
}
{% endschema %}
