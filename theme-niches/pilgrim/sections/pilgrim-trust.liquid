<div style="background:#fff; padding:60px 5%; border-top:1px solid #FAF6F2; border-bottom:1px solid #FAF6F2;">
  <div class="page-width" style="max-width:1200px; margin:0 auto;">
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:40px; text-align:center;">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <div style="width:64px; height:64px; background:#FAF6F2; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 20px; color:#C17F5E;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              {%- case block.settings.icon -%}
                {%- when 'leaf' -%}
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM12 20c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/><path d="M11 7h2v6h-2zm0 8h2v2h-2z"/>
                {%- when 'shield' -%}
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                {%- when 'truck' -%}
                  <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                {%- when 'heart' -%}
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                {%- else -%}
                  <circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>
              {%- endcase -%}
            </svg>
          </div>
          <h3 style="font-size:16px; font-weight:700; color:#2A2522; margin-bottom:8px; letter-spacing:0.5px;">{{ block.settings.title }}</h3>
          <p style="font-size:14px; color:rgba(42,37,34,0.7); line-height:1.5;">{{ block.settings.desc }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pilgrim Trust",
  "settings": [],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type":"select",
          "id":"icon",
          "label":"Icon",
          "options":[
            {"value":"leaf","label":"Leaf (Natural)"},
            {"value":"shield","label":"Shield (Safe)"},
            {"value":"truck","label":"Truck (Shipping)"},
            {"value":"heart","label":"Heart (Love)"},
            {"value":"check","label":"Checkmark"}
          ],
          "default":"leaf"
        },
        {"type":"text","id":"title","label":"Title","default":"100% Vegan"},
        {"type":"text","id":"desc","label":"Description","default":"No animal-derived ingredients ever"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Pilgrim Trust",
      "blocks": [
        {"type":"badge","settings":{"icon":"leaf","title":"100% Vegan","desc":"No animal-derived ingredients ever"}},
        {"type":"badge","settings":{"icon":"shield","title":"Dermat Tested","desc":"Clinically validated for all skin types"}},
        {"type":"badge","settings":{"icon":"truck","title":"Free Shipping","desc":"On orders above ₹499"}},
        {"type":"badge","settings":{"icon":"heart","title":"Cruelty-Free","desc":"Never tested on animals — certified"}}
      ]
    }
  ]
}
{% endschema %}
