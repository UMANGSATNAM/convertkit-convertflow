<div class="pilgrim-science">
  <div class="pilgrim-science__grid">
    <div>
      <p class="pilgrim-eyebrow" style="color:var(--pilgrim-gold)">{{ section.settings.eyebrow }}</p>
      <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,4vw,48px);font-weight:400;color:var(--pilgrim-cream);margin-bottom:20px;line-height:1.2">{{ section.settings.heading }}</h2>
      <p style="font-size:16px;color:rgba(245,237,227,0.65);line-height:1.8;margin-bottom:40px;max-width:460px">{{ section.settings.body }}</p>
      {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '/pages/ingredients' }}" class="pilgrim-btn" style="background:var(--pilgrim-terracotta)">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
    <div class="pilgrim-ingredient-list">
      {%- for block in section.blocks -%}
      <div class="pilgrim-ingredient" {{ block.shopify_attributes }}>
        <div class="pilgrim-ingredient__icon">{{ block.settings.icon }}</div>
        <div class="pilgrim-ingredient__name">{{ block.settings.title }}</div>
        <div class="pilgrim-ingredient__desc">{{ block.settings.desc }}</div>
      </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Pilgrim Science",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE SCIENCE OF BEAUTY"},
    {"type":"text","id":"heading","label":"Heading","default":"Global Ingredients, Indian Roots"},
    {"type":"textarea","id":"body","label":"Body","default":"We travel the world to discover time-tested beauty rituals and bring them home with the purest, clinically-proven ingredients."},
    {"type":"text","id":"cta_label","label":"CTA Label","default":"Explore Ingredients"},
    {"type":"url","id":"cta_url","label":"CTA URL"}
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {"type":"text","id":"icon","label":"Icon/Emoji","default":"🌋"},
        {"type":"text","id":"title","label":"Title","default":"Jeju Volcanic Ash"},
        {"type":"text","id":"desc","label":"Description","default":"Deep-cleanses pores & absorbs excess sebum for matte, clear skin."}
      ]
    }
  ],
  "presets": [{
    "name": "Pilgrim Science",
    "blocks": [
      {"type":"ingredient","settings":{"icon":"🌋","title":"Jeju Volcanic Ash","desc":"Deep-cleanses pores & absorbs excess sebum for matte, clear skin."}},
      {"type":"ingredient","settings":{"icon":"🫒","title":"Argan Oil","desc":"Rich in Vitamin E, deeply nourishes and repairs damaged hair."}},
      {"type":"ingredient","settings":{"icon":"🍊","title":"Vitamin C","desc":"Brightens skin, fades dark spots, and boosts collagen synthesis."}},
      {"type":"ingredient","settings":{"icon":"🧴","title":"Retinol","desc":"Clinically proven to reduce fine lines and improve skin texture."}}
    ]
  }]
}
{% endschema %}
