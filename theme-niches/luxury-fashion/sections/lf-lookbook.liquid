<div style="background:#FFFFFF; padding:160px 40px; position:relative;">
  
  <div style="max-width:1600px; margin:0 auto; display:grid; grid-template-columns:5fr 7fr; gap:80px; align-items:center;">
    
    <!-- Text area -->
    <div>
      <div style="font-family:'Inter', sans-serif; font-size:11px; font-weight:400; text-transform:uppercase; letter-spacing:4px; color:#D4AF37; margin-bottom:24px;">
        {{ section.settings.heading }}
      </div>
      <h2 style="font-family:'Playfair Display', serif; font-size:clamp(48px, 6vw, 80px); font-weight:400; color:#0A0A0A; margin:0 0 40px 0; line-height:1.1; font-style:italic;">
        Symmetry &<br>Silhouette.
      </h2>
      <p style="font-family:'Inter', sans-serif; font-size:16px; font-weight:300; line-height:1.8; color:rgba(10,10,10,0.7); max-width:400px; margin:0;">
        A visual exploration of form and texture. The interplay of light and shadow highlights the intricate construction of each garment, revealing the artistry woven into every seam.
      </p>
    </div>

    <!-- Asymmetrical Image Collage -->
    <div style="position:relative; height:800px;">
      
      <!-- Image 1: Main vertical -->
      <div style="position:absolute; top:0; right:10%; width:50%; height:80%; z-index:2; border:1px solid #EAEAEA;">
        <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=800&q=80" alt="Lookbook 1" style="width:100%; height:100%; object-fit:cover; filter:grayscale(20%); transition:all 0.8s ease;" class="lf-look-img" loading="lazy">
      </div>
      
      <!-- Image 2: Small offset -->
      <div style="position:absolute; bottom:5%; left:0; width:45%; height:45%; z-index:3; border:10px solid #FFFFFF; box-shadow:0 20px 40px rgba(0,0,0,0.1);">
        <img src="https://images.unsplash.com/photo-1485230895905-31d986b245dd?auto=format&fit=crop&w=600&q=80" alt="Lookbook 2" style="width:100%; height:100%; object-fit:cover; filter:grayscale(50%); transition:all 0.8s ease;" class="lf-look-img" loading="lazy">
        <div style="position:absolute; bottom:-30px; right:-20px; font-family:'Inter', sans-serif; font-size:10px; font-weight:400; text-transform:uppercase; letter-spacing:2px; color:#0A0A0A;">FIG. 01</div>
      </div>
      
      <!-- Accent line -->
      <div style="position:absolute; top:20%; left:20%; width:1px; height:60%; background:#D4AF37; z-index:1;"></div>
      
    </div>
    
  </div>

  <style>
    .lf-look-img:hover { filter: grayscale(0%); transform: scale(1.02); }
    
    @media (max-width: 1024px) {
      div[style*="display:grid; grid-template-columns:5fr 7fr"] { grid-template-columns: 1fr; gap: 60px; }
      div[style*="height:800px"] { height: 600px; }
    }
    @media (max-width: 640px) {
      div[style*="height:800px"] { height: 500px; }
      div[style*="padding:160px 40px"] { padding: 80px 24px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Luxury Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Editorial"
    }
  ],
  "presets": [
    {
      "name": "Luxury Lookbook"
    }
  ]
}
{% endschema %}
