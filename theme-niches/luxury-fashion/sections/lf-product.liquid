<div style="padding:48px 20px 80px;background:var(--lf-black)"><div style="max-width:1320px;margin:0 auto">
  <nav style="font-size:12px;font-family:'Montserrat',sans-serif;color:var(--lf-muted);margin-bottom:32px;letter-spacing:0.1em;text-transform:uppercase" aria-label="Breadcrumb"><a href="/" style="color:var(--lf-muted)">Home</a> / <a href="{{ product.collections.first.url }}" style="color:var(--lf-muted)">{{ product.collections.first.title }}</a> / <span style="color:var(--lf-white)">{{ product.title }}</span></nav>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start">
    <div data-gallery>
      <div style="overflow:hidden;background:#111;aspect-ratio:3/4;margin-bottom:12px;cursor:zoom-in"><img id="MainProductImg" data-main-img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}" width="1000" style="width:100%;height:100%;object-fit:cover"></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">{%- for img in product.images limit: 6 -%}<div data-thumb data-src="{{ img | image_url: width: 1000 }}" style="width:72px;height:96px;overflow:hidden;cursor:pointer;border:1px solid {% if forloop.first %}var(--lf-gold){% else %}transparent{% endif %};transition:border-color .2s"><img src="{{ img | image_url: width: 144 }}" alt="" width="72" height="96" style="width:100%;height:100%;object-fit:cover"></div>{%- endfor -%}</div>
    </div>
    <div>
      <span class="lf-eyebrow" style="margin-bottom:8px">{{ product.vendor }}</span>
      <h1 style="font-family:'Playfair Display',serif;font-size:36px;font-weight:300;color:var(--lf-white);margin-bottom:12px;letter-spacing:0.02em;text-transform:uppercase">{{ product.title }}</h1>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px"><span style="color:var(--lf-gold);font-size:12px;letter-spacing:2px">★★★★★</span><span style="font-size:11px;color:var(--lf-muted);font-family:'Montserrat',sans-serif;letter-spacing:0.05em">({{ product.metafields.reviews.rating_count | default: '280' }} JOURNALS)</span></div>
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid var(--lf-border)">
        <span style="font-family:'Montserrat',sans-serif;font-size:26px;font-weight:500;color:var(--lf-gold);letter-spacing:0.05em" data-price>{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}<span style="font-family:'Montserrat',sans-serif;font-size:18px;color:var(--lf-muted);text-decoration:line-through" data-compare-price>{{ product.compare_at_price | money }}</span>{%- endif -%}
      </div>
      <!-- Swatches -->
      <form action="{{ routes.cart_add_url }}" method="post" id="ProductForm">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- unless product.has_only_default_variant -%}{%- for option in product.options_with_values -%}<div style="margin-bottom:24px"><label style="font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.15em;color:var(--lf-white);display:block;margin-bottom:10px">{{ option.name }}</label><div style="display:flex;gap:10px;flex-wrap:wrap" data-swatches>{%- for value in option.values -%}<button type="button" data-swatch="{{ value }}" style="padding:12px 24px;border:1px solid {% if option.selected_value == value %}var(--lf-gold){% else %}var(--lf-border){% endif %};background:{% if option.selected_value == value %}var(--lf-gold){% else %}transparent{% endif %};color:{% if option.selected_value == value %}var(--lf-black){% else %}var(--lf-white){% endif %};font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600;letter-spacing:0.1em;cursor:pointer;border-radius:0px;transition:all .2s">{{ value }}</button>{%- endfor -%}</div></div>{%- endfor -%}<select name="id" data-variant-select style="display:none">{%- for variant in product.variants -%}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</option>{%- endfor -%}</select>{%- endunless -%}
        <div style="display:flex;gap:12px;margin-bottom:16px">
          <div style="display:flex;align-items:center;border:1px solid var(--lf-border);border-radius:0px;background:transparent;overflow:hidden"><button type="button" data-dir="down" style="width:48px;height:54px;background:none;border:none;font-size:18px;color:#fff;cursor:pointer">−</button><input type="number" name="quantity" value="1" min="1" style="width:48px;height:54px;text-align:center;border:none;background:transparent;color:#fff;font-size:14px;font-weight:500"><button type="button" data-dir="up" style="width:48px;height:54px;background:none;border:none;font-size:18px;color:#fff;cursor:pointer">+</button></div>
          <button type="submit" class="lf-btn" data-atc style="flex:1;justify-content:center" {% unless product.available %}disabled{% endunless %}>{%- if product.available -%}ACQUIRE PIECE{%- else -%}OUT OF STOCK{%- endif -%}</button>
        </div>
      </form>
      <!-- Trust List -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:24px 0">
        <div style="display:flex;align-items:center;gap:8px;padding:12px;border:1px solid var(--lf-border);font-size:10px;font-family:'Montserrat',sans-serif;text-transform:uppercase;letter-spacing:0.1em;color:var(--lf-gold)">✓ Milan Atelier</div>
        <div style="display:flex;align-items:center;gap:8px;padding:12px;border:1px solid var(--lf-border);font-size:10px;font-family:'Montserrat',sans-serif;text-transform:uppercase;letter-spacing:0.1em;color:var(--lf-gold)">✓ Mulberry Silks</div>
        <div style="display:flex;align-items:center;gap:8px;padding:12px;border:1px solid var(--lf-border);font-size:10px;font-family:'Montserrat',sans-serif;text-transform:uppercase;letter-spacing:0.1em;color:var(--lf-white)">🚚 Secure Courier</div>
        <div style="display:flex;align-items:center;gap:8px;padding:12px;border:1px solid var(--lf-border);font-size:10px;font-family:'Montserrat',sans-serif;text-transform:uppercase;letter-spacing:0.1em;color:var(--lf-white)">↩ Compl. Return</div>
      </div>
      <div style="font-family:'Montserrat',sans-serif;font-size:13px;line-height:1.9;color:var(--lf-muted);letter-spacing:0.02em">{{ product.description }}</div>
    </div>
  </div>
</div></div>
{% schema %}
{"name":"LF Product","settings":[],"presets":[{"name":"LF Product"}]}
{% endschema %}
