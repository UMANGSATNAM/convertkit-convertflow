<div style="background:var(--lf-bg);min-height:95vh;display:flex;align-items:center;padding:100px 60px;position:relative">
  <div style="max-width:1600px;margin:0 auto;width:100%;display:grid;grid-template-columns:5fr 4fr;gap:120px;align-items:center">
    
    <div style="position:relative;z-index:2">
      <div class="lf-meta" style="margin-bottom:40px">{{ section.settings.overline | default: 'FALL / WINTER 2026' }}</div>
      <h1 class="lf-head" style="font-size:clamp(60px, 8vw, 140px);margin-bottom:48px;margin-left:-5px">
        {{ section.settings.heading | default: 'LA<br>MODE.' }}
      </h1>
      <p style="font-size:14px;line-height:1.8;color:var(--lf-muted);margin-bottom:60px;max-width:400px;font-weight:300">
        {{ section.settings.text | default: 'An exploration of silhouette and shadow. Discover the new avant-garde collection designed for the modern muse.' }}
      </p>
      <a href="{{ section.settings.btn1_url | default: '/collections/editorial' }}" class="lf-btn">{{ section.settings.btn1_text | default: 'View Lookbook' }}</a>
    </div>
    
    <div style="position:relative;height:85vh">
      <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/fashion-hero.jpg?v=1717283400" alt="Fashion Editorial" style="width:100%;height:100%;object-fit:cover;filter:grayscale(100%) contrast(1.1)">
      
      <!-- Asymmetrical floating image -->
      <div style="position:absolute;bottom:-40px;left:-80px;width:240px;aspect-ratio:3/4;background:#F8F8F8;box-shadow:0 30px 60px rgba(0,0,0,0.1)">
         <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/fashion-detail.jpg?v=1717283400" alt="Fashion Detail" style="width:100%;height:100%;object-fit:cover;filter:grayscale(100%)">
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Luxury Fashion Hero",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline Text",
      "default": "FALL / WINTER 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LA<br>MODE."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "An exploration of silhouette and shadow."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button Text",
      "default": "View Lookbook"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Luxury Fashion Hero"
    }
  ]
}
{% endschema %}
