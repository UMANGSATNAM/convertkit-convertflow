<div style="background:#0A0A0A; color:#FFFFFF; position:relative; min-height:100vh; display:flex; align-items:center; overflow:hidden;">
  
  <div style="max-width:1600px; margin:0 auto; width:100%; display:flex; flex-wrap:wrap; position:relative; z-index:2;">
    
    <!-- Image Area -->
    <div style="flex:1; min-width:300px; position:relative; height:100vh;">
      <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1200&q=80" alt="Editorial Fashion" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:contrast(1.1) brightness(0.8);" class="lf-hero-img" loading="eager">
    </div>

    <!-- Content Area (Asymmetrical overlap) -->
    <div style="flex:1; min-width:300px; display:flex; align-items:center; padding:80px; position:relative;">
      
      <!-- Overlapping background box -->
      <div style="position:absolute; top:15%; bottom:15%; left:-10%; right:10%; background:#0A0A0A; z-index:-1; border:1px solid rgba(212,175,55,0.2);"></div>
      
      <div style="position:relative; z-index:2;">
        <div style="font-family:'Inter', sans-serif; font-size:11px; font-weight:400; text-transform:uppercase; letter-spacing:4px; color:#D4AF37; margin-bottom:32px; display:flex; align-items:center; gap:16px;">
          <span style="width:40px; height:1px; background:#D4AF37;"></span>
          Spring/Summer 2026
        </div>
        
        <h1 style="font-family:'Playfair Display', serif; font-size:clamp(48px, 6vw, 88px); font-weight:400; font-style:italic; line-height:1; margin:0 0 40px 0; letter-spacing:-1px;">
          {{ section.settings.heading }}
        </h1>
        
        <p style="font-family:'Inter', sans-serif; font-size:16px; font-weight:300; line-height:1.8; color:rgba(255,255,255,0.7); max-width:400px; margin:0 0 56px 0;">
          {{ section.settings.subheading }}
        </p>
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-block; font-family:'Inter', sans-serif; font-size:12px; font-weight:400; text-transform:uppercase; letter-spacing:2px; color:#FFFFFF; text-decoration:none; padding-bottom:8px; border-bottom:1px solid #D4AF37; transition:all 0.4s ease;" class="lf-hero-btn">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
      
    </div>
    
  </div>

  <!-- Ambient glowing element -->
  <div style="position:absolute; top:20%; right:10%; width:300px; height:300px; background:radial-gradient(circle, rgba(212,175,55,0.1) 0%, rgba(10,10,10,0) 70%); z-index:1;"></div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap');
    
    .lf-hero-img { transition: transform 10s ease; }
    .lf-hero-img:hover { transform: scale(1.03); }
    .lf-hero-btn:hover { color: #D4AF37; padding-bottom: 12px; }
    
    @media (max-width: 990px) {
      div[style*="height:100vh"] { height: 60vh; }
      div[style*="top:15%; bottom:15%; left:-10%; right:10%"] { left: 5%; right: 5%; top: -10%; bottom: 5%; }
      div[style*="padding:80px"] { padding: 40px 24px; margin-top: -60px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Luxury Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "L'Élégance Redéfinie."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover the Spring/Summer Collection. A study in modern tailoring."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "EXPLORE THE CAMPAIGN"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Luxury Hero"
    }
  ]
}
{% endschema %}
