<div class="lf-hero">
  <div class="lf-hero__content">
    <span class="lf-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="lf-hero__title">{{ section.settings.heading }}</h1>
    <p class="lf-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:16px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="lf-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="lf-btn lf-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="lf-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image.alt | escape }}" width="1400" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:600px;background:#111"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"LF Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"HAUTE COUTURE"},{"type":"text","id":"heading","label":"Heading","default":"The Art Of Draping"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Designed with rigorous structural discipline and crafted from rare archives of Italian silk and premium wool."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"EXPLORE RUNWAY"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"COLLECTIONS"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"LF Hero"}]}
{% endschema %}
