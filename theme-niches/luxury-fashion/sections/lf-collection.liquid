<div style="background:var(--lf-bg);padding:140px 60px">
  <div style="max-width:1600px;margin:0 auto">
    
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:100px;border-bottom:1px solid var(--lf-border);padding-bottom:40px">
      <h2 class="lf-head" style="font-size:72px">{{ collection.title | default: 'The Edit' }}</h2>
      <div class="lf-meta" style="padding-bottom:16px">{{ collection.products_count | default: '24' }} PIECES</div>
    </div>
    
    <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:80px 40px">
      {%- for product in collection.products limit: 6 -%}
      <!-- Apply asymmetrical offset to middle column -->
      <a href="{{ product.url }}" class="lf-card {% if forloop.index == 2 or forloop.index == 5 %}lf-offset-left{% endif %}">
        <div class="image-wrapper">
          {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" style="filter:grayscale(100%)">
          {%- else -%}
          <div style="width:100%;height:100%;background:#F8F8F8"></div>
          {%- endif -%}
        </div>
        <div class="info">
          <div class="title">{{ product.title }}</div>
          <div class="price">{{ product.price | money }}</div>
        </div>
      </a>
      {%- else -%}
      <!-- Demo State -->
      {%- for i in (1..6) -%}
      <a href="#" class="lf-card {% if i == 2 or i == 5 %}lf-offset-left{% endif %}">
        <div class="image-wrapper">
          <div style="width:100%;height:100%;background:#F8F8F8"></div>
        </div>
        <div class="info">
          <div class="title">Structure Coat V{{i}}</div>
          <div class="price">₹12,500</div>
        </div>
      </a>
      {%- endfor -%}
      {%- endfor -%}
    </div>
    
    <div style="text-align:center;margin-top:120px">
      <a href="/collections/all" class="lf-btn">Discover All</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Luxury Fashion Grid",
  "settings": [],
  "presets": [
    {
      "name": "Luxury Fashion Grid"
    }
  ]
}
{% endschema %}
