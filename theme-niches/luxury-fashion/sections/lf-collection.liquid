<div style="padding:60px 20px 0;background:var(--lf-black)"><div style="max-width:1320px;margin:0 auto;text-align:center;padding-bottom:56px"><span class="lf-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</span><h1 style="font-family:'Playfair Display',serif;font-size:clamp(32px,5vw,56px);font-weight:300;color:var(--lf-white);margin-bottom:12px;text-transform:uppercase;letter-spacing:0.04em">{{ collection.title }}</h1>{%- if collection.description != blank -%}<p style="font-family:'Montserrat',sans-serif;font-size:13px;color:var(--lf-muted);max-width:560px;margin:0 auto;letter-spacing:0.05em">{{ collection.description }}</p>{%- endif -%}</div></div>
<div style="padding:0 20px 100px;background:var(--lf-black)"><div style="max-width:1320px;margin:0 auto"><div style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid var(--lf-border);margin-bottom:40px"><div style="font-family:'Montserrat',sans-serif;font-size:12px;color:var(--lf-muted);letter-spacing:0.1em;text-transform:uppercase">{{ collection.products_count }} garments</div><select style="padding:10px 20px;border:1px solid var(--lf-border);border-radius:0px;background:transparent;color:#fff;font-family:'Montserrat',sans-serif;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer"><option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Newest</option></select></div><div class="lf-prod-grid">{%- for product in collection.products -%}<a href="{{ product.url }}" class="lf-prod-card"><div class="lf-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" width="700" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:#161616"></div>{%- endif -%}</div><div class="lf-prod-card__name">{{ product.title }}</div><div class="lf-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div></div></div>
{% schema %}
{"name":"LF Collection","settings":[],"presets":[{"name":"LF Collection"}]}
{% endschema %}
