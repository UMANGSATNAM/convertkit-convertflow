<div style="background:#0A0A0A; padding:160px 40px;">
  <div style="max-width:1600px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:100px; flex-wrap:wrap; gap:40px;">
      <div>
        <div style="font-family:'Inter', sans-serif; font-size:11px; font-weight:400; text-transform:uppercase; letter-spacing:4px; color:#D4AF37; margin-bottom:16px;">
          The New Standard
        </div>
        <h2 style="font-family:'Playfair Display', serif; font-size:clamp(36px, 4vw, 56px); font-weight:400; color:#FFFFFF; margin:0; font-style:italic;">
          {{ section.settings.heading }}
        </h2>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Inter', sans-serif; font-size:11px; font-weight:400; color:#FFFFFF; text-decoration:none; text-transform:uppercase; letter-spacing:2px; display:inline-flex; align-items:center; gap:12px; padding-bottom:8px; border-bottom:1px solid rgba(255,255,255,0.2); transition:border-color 0.4s ease;" class="lf-link-btn">
          {{ section.settings.cta_label }}
          <span style="display:inline-block; width:24px; height:1px; background:#FFFFFF; transition:width 0.4s ease;" class="lf-link-line"></span>
        </a>
      {%- endif -%}
    </div>

    <div class="lf-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:2px; background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.1);">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1550614000-4b95dd012eee?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1596815064285-45ed8a9c0463?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1584273143981-41c073dfe8f8?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="lf-product-card" style="position:relative; display:flex; flex-direction:column; background:#0A0A0A; padding:40px; transition:background 0.5s ease; group">
          
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:140%; margin-bottom:32px;">
            <img src="{{ img_url }}" alt="Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.8s ease; filter:grayscale(80%);" class="lf-product-img" loading="lazy">
            
            <div style="position:absolute; inset:0; background:rgba(0,0,0,0.2); opacity:0; transition:opacity 0.4s ease; display:flex; align-items:center; justify-content:center;" class="lf-quick-add">
              <span style="font-family:'Inter', sans-serif; font-size:10px; font-weight:400; text-transform:uppercase; letter-spacing:2px; color:#FFFFFF; border:1px solid #FFFFFF; padding:12px 24px;">Discover</span>
            </div>
          </a>
          
          <div style="text-align:center;">
            <h3 style="font-family:'Playfair Display', serif; font-size:18px; font-weight:400; color:#FFFFFF; margin:0 0 12px 0; letter-spacing:1px;">
              {% if idx == 1 %}Silk Organza Blouse{% elsif idx == 2 %}Tailored Wool Coat{% elsif idx == 3 %}Leather Envelope Clutch{% else %}Structured Crepe Trousers{% endif %}
            </h3>
            
            <div style="font-family:'Inter', sans-serif; font-size:12px; font-weight:300; color:rgba(255,255,255,0.6);">
              {% if idx == 1 %}$890{% elsif idx == 2 %}$2,450{% elsif idx == 3 %}$1,200{% else %}$950{% endif %}
            </div>
          </div>
          
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .lf-link-btn:hover { border-color: #D4AF37; color: #D4AF37; }
    .lf-link-btn:hover .lf-link-line { width: 40px; background: #D4AF37; }
    
    .lf-product-card:hover { background: #111111; }
    .lf-product-card:hover .lf-product-img { transform: scale(1.05); filter: grayscale(0%); }
    .lf-product-card:hover .lf-quick-add { opacity: 1; }
    
    @media (max-width: 1024px) {
      .lf-product-grid { grid-template-columns: repeat(2, 1fr) !important; }
      div[style*="padding:40px"] { padding: 20px !important; }
    }
    @media (max-width: 640px) {
      .lf-product-grid { grid-template-columns: 1fr !important; }
      div[style*="padding:160px 40px"] { padding: 80px 24px !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Luxury Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated Selection"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Luxury Collection"
    }
  ]
}
{% endschema %}
