<div style="padding:100px 20px;background:var(--lf-black)"><div style="max-width:1320px;margin:0 auto">
  <div class="lf-section-header"><span class="lf-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="lf-review-grid">{%- for block in section.blocks -%}<div class="lf-review-card" {{ block.shopify_attributes }}><div class="lf-review-card__stars">★★★★★</div><div class="lf-review-card__text">"{{ block.settings.quote }}"</div><div class="lf-review-card__author">{{ block.settings.name }}</div><div class="lf-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"LF Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CLIENT JOURNALS"},{"type":"text","id":"heading","label":"Heading","default":"Atelier Testimonials"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"LF Reviews","blocks":[{"type":"review","settings":{"quote":"The drape of the gold series silk trench is incredible. Truly haute couture.","name":"Gisele B.","product":"Mulberry Silk Trench"}},{"type":"review","settings":{"quote":"Impeccable structural definition. Feels lightweight yet incredibly structured. Absolute art.","name":"Clara V.","product":"Atelier Blazer"}},{"type":"review","settings":{"quote":"The fabric quality is beyond comparison. Highly recommended for capsule curation.","name":"Adrian D.","product":"Cashmere Ribbed Knit"}}]}]}
{% endschema %}
