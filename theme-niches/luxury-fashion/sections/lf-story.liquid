<div style="padding:100px 20px;background:var(--lf-black)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center">
  <div>
    <span class="lf-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Playfair Display',serif;font-size:clamp(30px,4.5vw,52px);font-weight:300;color:var(--lf-white);margin-bottom:24px;line-height:1.1">{{ section.settings.heading }}</h2>
    <p style="font-family:'Montserrat',sans-serif;font-size:14px;color:var(--lf-muted);line-height:1.9;max-width:440px">{{ section.settings.body }}</p>
    <div class="lf-stat-grid">{%- for block in section.blocks -%}<div class="lf-stat" {{ block.shopify_attributes }}><div class="lf-stat__num">{{ block.settings.number }}</div><div class="lf-stat__label">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" width="900" style="width:100%;object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:3/4;background:#111"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"LF Story","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE ATELIER STORY"},{"type":"text","id":"heading","label":"Heading","default":"Rigorous Craftsmanship."},{"type":"textarea","id":"body","label":"Body","default":"Every garment represents 48 hours of hand-guided drafting and structural assembly inside our Milanese atelier, using certified mulberry silks."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"01."},{"type":"text","id":"label","label":"Label","default":"Atelier Hand"}]}],"presets":[{"name":"LF Story","blocks":[{"type":"stat","settings":{"number":"01.","label":"Milan Atelier"}},{"type":"stat","settings":{"number":"100%","label":"Mulberry Silk"}},{"type":"stat","settings":{"number":"48hr","label":"Tailor Draft"}},{"type":"stat","settings":{"number":"Limit","label":"Numbered Runs"}}]}]}
{% endschema %}
