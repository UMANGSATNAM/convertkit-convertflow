<div style="background:#0A0A0A; color:#FFFFFF; position:relative; padding:160px 40px; border-top:1px solid rgba(255,255,255,0.1);">
  
  <div style="max-width:1600px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
    
    <!-- Image -->
    <div style="position:relative;">
      <div style="position:relative; padding-bottom:120%; overflow:hidden; border:1px solid rgba(212,175,55,0.3);">
        <img src="https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=1000&q=80" alt="Craftsmanship" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:grayscale(30%); transition:transform 10s ease;" class="lf-ed-img" loading="lazy">
      </div>
      <!-- Floating quote box -->
      <div style="position:absolute; bottom:-40px; right:-40px; background:#FFFFFF; color:#0A0A0A; padding:40px; max-width:300px; z-index:2; box-shadow:0 20px 40px rgba(0,0,0,0.5);">
        <div style="font-family:'Inter', sans-serif; font-size:40px; color:#D4AF37; line-height:1; margin-bottom:16px;">"</div>
        <p style="font-family:'Playfair Display', serif; font-size:18px; font-style:italic; line-height:1.6; margin:0;">
          True luxury is the marriage of exceptional materials and meticulous execution.
        </p>
      </div>
    </div>

    <!-- Content -->
    <div style="padding-left:40px;" class="lf-ed-content">
      <div style="font-family:'Inter', sans-serif; font-size:11px; font-weight:400; text-transform:uppercase; letter-spacing:4px; color:#D4AF37; margin-bottom:24px;">
        Atelier
      </div>
      <h2 style="font-family:'Playfair Display', serif; font-size:clamp(40px, 5vw, 64px); font-weight:400; margin:0 0 40px 0; line-height:1.1; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-family:'Inter', sans-serif; font-size:16px; font-weight:300; line-height:1.8; color:rgba(255,255,255,0.7); max-width:480px; margin:0 0 48px 0;">
        {{ section.settings.subheading }}
      </p>
      
      <a href="/pages/atelier" style="display:inline-flex; align-items:center; gap:16px; font-family:'Inter', sans-serif; font-size:11px; font-weight:400; text-transform:uppercase; letter-spacing:2px; color:#FFFFFF; text-decoration:none; transition:all 0.3s ease;" class="lf-ed-link">
        <span style="width:40px; height:1px; background:#D4AF37; display:inline-block; transition:width 0.3s ease;" class="lf-ed-line"></span>
        DISCOVER THE PROCESS
      </a>
    </div>
    
  </div>

  <style>
    .lf-ed-img:hover { transform: scale(1.05); }
    .lf-ed-link:hover { color: #D4AF37; }
    .lf-ed-link:hover .lf-ed-line { width: 60px; }
    
    @media (max-width: 1024px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; gap: 100px; }
      .lf-ed-content { padding-left: 0 !important; }
      div[style*="bottom:-40px; right:-40px"] { bottom: -20px; right: 0; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Luxury Editorial",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Art of Craft"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every piece is constructed with uncompromising attention to detail, honoring traditional techniques while embracing contemporary silhouettes."
    }
  ],
  "presets": [
    {
      "name": "Luxury Editorial"
    }
  ]
}
{% endschema %}
