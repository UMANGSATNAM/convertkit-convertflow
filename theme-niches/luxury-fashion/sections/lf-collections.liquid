<div style="padding:100px 20px;background:var(--lf-black);border-bottom:1px solid var(--lf-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="lf-section-header"><span class="lf-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="lf-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="lf-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:#111"></div>{%- endif -%}<div class="lf-col-card__overlay"><span class="lf-col-card__title">{{ block.settings.title }}</span><span class="lf-col-card__cta">Discover</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"LF Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ARCHIVES"},{"type":"text","id":"heading","label":"Heading","default":"The Seasonal Edits"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Runway Pieces"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"LF Collections","blocks":[{"type":"col","settings":{"title":"L'Autunno Edit"}},{"type":"col","settings":{"title":"Silk Outerwear"}},{"type":"col","settings":{"title":"The Gold Series"}}]}]}
{% endschema %}
