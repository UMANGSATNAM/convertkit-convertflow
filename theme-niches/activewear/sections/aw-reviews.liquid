<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto"><div class="aw-section-header"><p class="aw-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div><div class="aw-review-grid">{%- for block in section.blocks -%}<div class="aw-review-card" {{ block.shopify_attributes }}><div class="aw-review-card__stars">{%- for i in (1..block.settings.rating) -%}★{%- endfor -%}</div><div class="aw-review-card__text">"{{ block.settings.quote }}"</div><div class="aw-review-card__author">{{ block.settings.name }}</div><div class="aw-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div></div></div>
{% schema %}
{"name":"AW Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"COMMUNITY"},{"type":"text","id":"heading","label":"Heading","default":"Athletes Love Us"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"AW Reviews","blocks":[{"type":"review","settings":{"rating":5,"quote":"Best gym leggings I've ever owned. Zero see-through, perfect compression.","name":"Ananya R.","product":"Power Leggings"}},{"type":"review","settings":{"rating":5,"quote":"The dry-fit tee is incredible. Ran a half marathon and stayed bone dry.","name":"Vivek S.","product":"DryFit Training Tee"}},{"type":"review","settings":{"rating":5,"quote":"Squat-proof, stylish, and affordable. Replaced all my Nike gear.","name":"Priya M.","product":"Flex Shorts"}}]}]}
{% endschema %}
