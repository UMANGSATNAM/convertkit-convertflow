<div style="position:relative;background:var(--act-bg);min-height:85vh;display:flex;align-items:center;padding:80px 40px;overflow:hidden" class="act-skew-panel">
  <div class="act-speed-lines"></div>

  <div style="max-width:1400px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;position:relative;z-index:2">
    <div>
      <h1 class="act-head" style="font-size:clamp(60px, 8vw, 100px);margin-bottom:16px;color:#FFF;text-transform:uppercase">
        {{ section.settings.heading | default: 'DEFY<br><span style="color:var(--act-accent)">GRAVITY.</span>' }}
      </h1>
      <p style="font-size:18px;line-height:1.6;color:var(--act-muted);margin-bottom:48px;max-width:480px;font-style:italic">
        {{ section.settings.text | default: 'Engineered for maximum velocity. Our new seamless compression gear moves exactly how you move.' }}
      </p>
      <a href="{{ section.settings.btn1_url | default: '/collections/mens' }}" class="act-btn"><span>{{ section.settings.btn1_text | default: 'SHOP MENS' }}</span></a>
      <a href="{{ section.settings.btn2_url | default: '/collections/womens' }}" class="act-btn" style="background:transparent;border:2px solid var(--act-accent);color:var(--act-accent);margin-left:16px"><span>{{ section.settings.btn2_text | default: 'SHOP WOMENS' }}</span></a>
    </div>
    
    <div style="position:relative;height:70vh">
      <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/active-hero.jpg?v=1717283400" alt="Activewear Hero" style="width:100%;height:100%;object-fit:cover;clip-path:polygon(10% 0, 100% 0, 90% 100%, 0% 100%)">
      
      <!-- Floating Stat -->
      <div style="position:absolute;bottom:20%;left:-20px;background:var(--act-accent);color:#FFF;padding:24px;transform:skewX(-15deg)">
        <div style="transform:skewX(15deg)">
          <div class="act-head" style="font-size:32px">4-WAY</div>
          <div style="font-weight:700;font-size:14px;text-transform:uppercase">Stretch Fabric</div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Activewear Kinetic Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "DEFY<br><span style=\"color:var(--act-accent)\">GRAVITY.</span>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Engineered for maximum velocity."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 Text",
      "default": "SHOP MENS"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 Text",
      "default": "SHOP WOMENS"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Button 2 Link"
    }
  ],
  "presets": [
    {
      "name": "Activewear Kinetic Hero"
    }
  ]
}
{% endschema %}
