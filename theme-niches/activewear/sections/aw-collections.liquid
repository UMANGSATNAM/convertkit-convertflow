<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto"><div class="aw-section-header"><p class="aw-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div><div class="aw-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="aw-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--aw-grey)"></div>{%- endif -%}<div class="aw-col-card__overlay"><span class="aw-col-card__title">{{ block.settings.title }}</span><span class="aw-col-card__cta">Shop →</span></div></a>{%- endfor -%}</div></div></div>
{% schema %}
{"name":"AW Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"TRAIN YOUR WAY"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Activity"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Running"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"AW Collections","blocks":[{"type":"col","settings":{"title":"Running"}},{"type":"col","settings":{"title":"Training"}},{"type":"col","settings":{"title":"Yoga & Recovery"}}]}]}
{% endschema %}
