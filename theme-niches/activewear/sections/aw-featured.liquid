<div style="padding:80px 20px;background:var(--aw-grey)"><div style="max-width:1320px;margin:0 auto"><div class="aw-section-header"><p class="aw-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>{%- assign col = collections[section.settings.collection] -%}<div class="aw-prod-grid">{%- for product in col.products limit: section.settings.count -%}<a href="{{ product.url }}" class="aw-prod-card"><div class="aw-prod-card__img">{%- if product.tags contains 'new' -%}<span class="aw-prod-card__tag">New</span>{%- endif -%}{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--aw-grey)"></div>{%- endif -%}</div><div class="aw-prod-card__name">{{ product.title }}</div><div class="aw-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div><div style="text-align:center;margin-top:48px"><a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="aw-btn aw-btn--outline">{{ section.settings.cta_label }}</a></div></div></div>
{% schema %}
{"name":"AW Featured","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"TRENDING"},{"type":"text","id":"heading","label":"Heading","default":"Best Performers"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"count","label":"Count","min":4,"max":12,"step":4,"default":8},{"type":"text","id":"cta_label","label":"CTA","default":"VIEW ALL"},{"type":"url","id":"cta_url","label":"CTA URL"}],"presets":[{"name":"AW Featured"}]}
{% endschema %}
