<div style="background:#CCFF00; padding:120px 24px; position:relative; overflow:hidden;">
  
  <!-- Slanted background element -->
  <div style="position:absolute; top:0; bottom:0; left:50%; right:0; background:#111111; clip-path:polygon(10% 0, 100% 0, 100% 100%, 0 100%); z-index:1;" class="aw-banner-bg"></div>

  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2; display:grid; grid-template-columns:1fr 1fr; align-items:center;">
    
    <!-- Text Content -->
    <div style="padding-right:40px;" class="aw-banner-content">
      <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(48px, 6vw, 80px); font-weight:700; font-style:italic; color:#111111; margin:0 0 24px 0; text-transform:uppercase; line-height:1;">
        {{ section.settings.heading | replace: ' ', '<br>' }}
      </h2>
      <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:600; color:#111111; margin:0 0 40px 0; max-width:400px;">
        {{ section.settings.subheading }}
      </p>
    </div>
    
    <!-- CTA Area -->
    <div style="display:flex; justify-content:center; padding-left:40px;" class="aw-banner-cta-wrap">
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#FFFFFF; color:#111111; font-family:'Oswald', sans-serif; font-size:24px; font-weight:700; font-style:italic; text-transform:uppercase; letter-spacing:1px; padding:24px 64px; text-decoration:none; transition:all 0.3s ease; transform:skewX(-10deg); box-shadow:8px 8px 0px #CCFF00;" class="aw-banner-btn">
          <span style="transform:skewX(10deg);">{{ section.settings.cta_label }}</span>
        </a>
      {%- endif -%}
    </div>
    
  </div>

  <style>
    .aw-banner-btn:hover { background: #111111; color: #CCFF00; box-shadow: 8px 8px 0px rgba(17,17,17,0.5); transform: skewX(-10deg) translateY(-4px); }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; gap: 60px; text-align: center; }
      .aw-banner-bg { display: none; }
      div[style*="background:#CCFF00"] { background: #111111 !important; }
      .aw-banner-content h2 { color: #CCFF00 !important; }
      .aw-banner-content p { color: #FFFFFF !important; margin: 0 auto 40px auto !important; }
      .aw-banner-content { padding-right: 0 !important; }
      .aw-banner-cta-wrap { padding-left: 0 !important; }
      .aw-banner-btn { background: #CCFF00 !important; color: #111111 !important; box-shadow: 8px 8px 0px rgba(255,255,255,0.2) !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Active Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JOIN THE MOVEMENT."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Gear up and get ready to dominate your next workout."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP ALL GEAR"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Active Banner"
    }
  ]
}
{% endschema %}
