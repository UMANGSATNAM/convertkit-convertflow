<div style="background:#111111; padding:0; display:flex; flex-wrap:wrap; min-height:80vh;">
  
  <!-- Left Side -->
  <div style="flex:1; min-width:300px; position:relative; overflow:hidden; display:flex; align-items:center; justify-content:center; padding:80px 40px; group" class="aw-split-pane">
    <img src="https://images.unsplash.com/photo-1581009146145-b5ef050c2e1e?auto=format&fit=crop&w=1000&q=80" alt="Men's Collection" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; mix-blend-mode:luminosity; opacity:0.6; transition:all 0.5s ease;" class="aw-split-img" loading="lazy">
    <div style="position:absolute; inset:0; background:linear-gradient(0deg, rgba(17,17,17,0.8) 0%, rgba(17,17,17,0.2) 100%);"></div>
    
    <div style="position:relative; z-index:2; text-align:center;">
      <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(48px, 6vw, 80px); font-weight:700; font-style:italic; color:#FFFFFF; margin:0 0 24px 0; text-transform:uppercase; line-height:1; transition:transform 0.3s ease;" class="aw-split-title">
        Men's Gear
      </h2>
      <a href="/collections/mens" style="display:inline-block; font-family:'Inter', sans-serif; font-size:16px; font-weight:600; color:#CCFF00; text-decoration:none; text-transform:uppercase; letter-spacing:2px; padding-bottom:4px; border-bottom:2px solid transparent; transition:border-color 0.3s ease;" class="aw-split-link">
        Shop Men
      </a>
    </div>
  </div>
  
  <!-- Right Side -->
  <div style="flex:1; min-width:300px; position:relative; overflow:hidden; display:flex; align-items:center; justify-content:center; padding:80px 40px; group" class="aw-split-pane">
    <img src="https://images.unsplash.com/photo-1518459031867-a89b944bffe4?auto=format&fit=crop&w=1000&q=80" alt="Women's Collection" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; mix-blend-mode:luminosity; opacity:0.6; transition:all 0.5s ease;" class="aw-split-img" loading="lazy">
    <div style="position:absolute; inset:0; background:linear-gradient(0deg, rgba(17,17,17,0.8) 0%, rgba(17,17,17,0.2) 100%);"></div>
    
    <div style="position:relative; z-index:2; text-align:center;">
      <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(48px, 6vw, 80px); font-weight:700; font-style:italic; color:#FFFFFF; margin:0 0 24px 0; text-transform:uppercase; line-height:1; transition:transform 0.3s ease;" class="aw-split-title">
        Women's Gear
      </h2>
      <a href="/collections/womens" style="display:inline-block; font-family:'Inter', sans-serif; font-size:16px; font-weight:600; color:#CCFF00; text-decoration:none; text-transform:uppercase; letter-spacing:2px; padding-bottom:4px; border-bottom:2px solid transparent; transition:border-color 0.3s ease;" class="aw-split-link">
        Shop Women
      </a>
    </div>
  </div>

  <style>
    .aw-split-pane:hover .aw-split-img { opacity: 0.9; mix-blend-mode: normal; transform: scale(1.05); }
    .aw-split-pane:hover .aw-split-title { transform: translateY(-10px); }
    .aw-split-pane:hover .aw-split-link { border-color: #CCFF00; }
  </style>
</div>

{% schema %}
{
  "name": "Active Split",
  "settings": [],
  "presets": [
    {
      "name": "Active Split"
    }
  ]
}
{% endschema %}
