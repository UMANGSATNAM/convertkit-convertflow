<div class="aw-hero"><div class="aw-hero__content"><p class="aw-eyebrow">{{ section.settings.eyebrow }}</p><h1 class="aw-hero__title">{{ section.settings.heading }}</h1><p class="aw-hero__sub">{{ section.settings.subheading }}</p><div style="display:flex;gap:12px;flex-wrap:wrap">{%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="aw-btn">{{ section.settings.cta_label }}</a>{%- endif -%}{%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="aw-btn aw-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}</div></div><div class="aw-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--aw-grey)"></div>{%- endif -%}</div></div>
{% schema %}
{"name":"AW Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"NEW SEASON"},{"type":"text","id":"heading","label":"Heading","default":"Move Without Limits"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Performance-engineered activewear that moves with you. From the gym to the street."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"SHOP NOW"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"NEW ARRIVALS"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"AW Hero"}]}
{% endschema %}
