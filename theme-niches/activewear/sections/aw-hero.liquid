<div style="background:#111111; position:relative; overflow:hidden; min-height:90vh; display:flex; align-items:center;">
  
  <!-- Dynamic background image -->
  <div style="position:absolute; inset:0; z-index:1;">
    <img src="https://images.unsplash.com/photo-1517836357463-d25dfeac3438?auto=format&fit=crop&w=2000&q=80" alt="Activewear" style="width:100%; height:100%; object-fit:cover; opacity:0.4; mix-blend-mode:luminosity;" loading="eager">
    <!-- Gradient overlay for readability -->
    <div style="position:absolute; inset:0; background:linear-gradient(90deg, #111111 0%, rgba(17,17,17,0.7) 50%, transparent 100%);"></div>
  </div>
  
  <!-- Slanted accent elements -->
  <div style="position:absolute; top:0; right:10%; width:100px; height:200%; background:#CCFF00; transform:rotate(15deg) translateY(-25%); z-index:2; opacity:0.9; mix-blend-mode:screen;" class="aw-hero-slant"></div>
  <div style="position:absolute; top:0; right:5%; width:2px; height:200%; background:#CCFF00; transform:rotate(15deg) translateY(-25%); z-index:2; opacity:0.5;" class="aw-hero-slant"></div>

  <div style="max-width:1440px; margin:0 auto; padding:0 40px; width:100%; position:relative; z-index:3;">
    
    <div style="max-width:700px;">
      
      <!-- Glitch effect / bold typography -->
      <h1 style="font-family:'Oswald', sans-serif; font-size:clamp(60px, 8vw, 120px); font-weight:700; font-style:italic; color:#FFFFFF; line-height:0.9; margin:0 0 24px 0; text-transform:uppercase; letter-spacing:-2px; text-shadow:4px 4px 0px rgba(204,255,0,0.5);">
        {{ section.settings.heading | replace: ' ', '<br>' }}
      </h1>
      
      <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:500; color:#FFFFFF; line-height:1.6; margin:0 0 40px 0; max-width:480px;">
        {{ section.settings.subheading }}
      </p>
      
      {%- if section.settings.cta_label != blank -%}
        <div>
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#CCFF00; color:#111111; font-family:'Oswald', sans-serif; font-size:18px; font-weight:700; font-style:italic; text-transform:uppercase; letter-spacing:1px; padding:18px 48px; text-decoration:none; transition:all 0.3s ease; transform:skewX(-10deg);" class="aw-btn-primary">
            <span style="transform:skewX(10deg); display:flex; align-items:center; gap:8px;">
              {{ section.settings.cta_label }}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </a>
        </div>
      {%- endif -%}
    </div>
    
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:ital,wght@0,400;0,600;0,700;1,700&display=swap');
    
    .aw-btn-primary:hover { background: #FFFFFF; transform: skewX(-10deg) scale(1.05); }
    
    @media (max-width: 768px) {
      .aw-hero-slant { display: none; }
      div[style*="background:linear-gradient"] { background: linear-gradient(0deg, #111111 0%, rgba(17,17,17,0.8) 100%); }
    }
  </style>
</div>

{% schema %}
{
  "name": "Active Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PUSH YOUR LIMITS."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Next-generation activewear engineered for peak performance. Do more. Be more."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP NEW ARRIVALS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Active Hero"
    }
  ]
}
{% endschema %}
