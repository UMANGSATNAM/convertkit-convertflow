<div style="background:var(--act-bg);padding:100px 40px;position:relative">
  <div style="max-width:1400px;margin:0 auto">
    
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:60px;border-bottom:2px solid var(--act-border);padding-bottom:24px">
      <div>
        <h2 class="act-head" style="font-size:64px;color:#FFF;margin-bottom:8px">{{ collection.title | default: 'PRO GEAR' }}</h2>
        <div style="font-style:italic;color:var(--act-muted);font-weight:700;text-transform:uppercase">{{ collection.products_count | default: '32' }} ITEMS</div>
      </div>
      <div>
        <select style="background:transparent;border:2px solid var(--act-border);color:#FFF;padding:12px 24px;font-family:var(--font-b);font-weight:700;font-style:italic;text-transform:uppercase;outline:none;cursor:pointer">
          <option>SORT: FEATURED</option>
          <option>SORT: NEWEST</option>
        </select>
      </div>
    </div>
    
    <div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:40px 24px">
      {%- for product in collection.products limit: 8 -%}
      <a href="{{ product.url }}" class="act-card">
        <div class="image-wrapper">
          {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- else -%}
          <div style="width:100%;height:100%;background:#18181B"></div>
          {%- endif -%}
        </div>
        <div style="display:flex;justify-content:space-between;align-items:flex-start">
          <div class="title">{{ product.title }}</div>
          <div class="price">{{ product.price | money }}</div>
        </div>
      </a>
      {%- else -%}
      <!-- Demo State -->
      {%- for i in (1..8) -%}
      <a href="#" class="act-card">
        <div class="image-wrapper">
          <div style="width:100%;height:100%;background:#18181B"></div>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:flex-start">
          <div class="title">Aero-Form Tight V{{i}}</div>
          <div class="price">₹2,499</div>
        </div>
      </a>
      {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Activewear Kinetic Grid",
  "settings": [],
  "presets": [
    {
      "name": "Activewear Kinetic Grid"
    }
  ]
}
{% endschema %}
