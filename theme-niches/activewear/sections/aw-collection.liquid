<div style="background:#111111; padding:100px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px; flex-wrap:wrap; gap:24px;">
      <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(40px, 5vw, 64px); font-weight:700; font-style:italic; color:#FFFFFF; margin:0; text-transform:uppercase; line-height:1;">
        {{ section.settings.heading }}
      </h2>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Oswald', sans-serif; font-size:16px; font-weight:600; font-style:italic; color:#111111; background:#CCFF00; text-decoration:none; text-transform:uppercase; letter-spacing:1px; padding:12px 32px; transform:skewX(-10deg); display:inline-block; transition:all 0.3s ease;" class="aw-link-btn">
          <span style="transform:skewX(10deg); display:block;">{{ section.settings.cta_label }}</span>
        </a>
      {%- endif -%}
    </div>

    <div class="aw-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:30px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1518459031867-a89b944bffe4?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1556817411-31ae72fa3ea0?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1608248593842-8021c64e03f0?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="aw-product-card" style="position:relative; display:flex; flex-direction:column; group">
          
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:125%; background:#1A1A1A; margin-bottom:20px; clip-path:polygon(0 0, 100% 0, 100% 95%, 0 100%); transition:clip-path 0.3s ease;" class="aw-product-img-wrap">
            <img src="{{ img_url }}" alt="Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease; opacity:0.9;" class="aw-product-img" loading="lazy">
            
            {% if idx == 1 or idx == 3 %}
              <div style="position:absolute; top:16px; right:16px; background:#CCFF00; color:#111111; font-family:'Oswald', sans-serif; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:1px; padding:6px 12px; transform:skewX(-10deg);">
                <span style="transform:skewX(10deg); display:block;">{% if idx == 1 %}New{% else %}Bestseller{% endif %}</span>
              </div>
            {% endif %}
            
            <div style="position:absolute; bottom:-50px; left:0; width:100%; background:rgba(17,17,17,0.9); padding:16px; text-align:center; transition:bottom 0.3s ease;" class="aw-quick-add">
              <span style="color:#CCFF00; font-family:'Oswald', sans-serif; font-size:14px; font-weight:600; text-transform:uppercase; letter-spacing:1px;">+ Quick Add</span>
            </div>
          </a>
          
          <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px;">
            <div>
              <div style="font-family:'Inter', sans-serif; font-size:12px; font-weight:600; color:#888888; text-transform:uppercase; letter-spacing:1px; margin-bottom:4px;">
                {% if idx == 1 %}Men's Training{% elsif idx == 2 %}Women's Running{% elsif idx == 3 %}Accessories{% else %}Men's Running{% endif %}
              </div>
              <h3 style="font-family:'Oswald', sans-serif; font-size:20px; font-weight:600; font-style:italic; color:#FFFFFF; margin:0; text-transform:uppercase;">
                {% if idx == 1 %}Apex Pro Tee{% elsif idx == 2 %}Velocity Leggings{% elsif idx == 3 %}Aero Cap{% else %}Pace Shorts{% endif %}
              </h3>
            </div>
            <div style="font-family:'Inter', sans-serif; font-size:16px; font-weight:600; color:#FFFFFF;">
              {% if idx == 1 %}$45{% elsif idx == 2 %}$85{% elsif idx == 3 %}$25{% else %}$55{% endif %}
            </div>
          </div>
          
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .aw-link-btn:hover { background: #FFFFFF; color: #111111; }
    .aw-product-card:hover .aw-product-img { transform: scale(1.05); opacity: 1; }
    .aw-product-card:hover .aw-quick-add { bottom: 0; }
    .aw-product-card:hover .aw-product-img-wrap { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); }
    
    @media (max-width: 1024px) {
      .aw-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px 20px !important; }
    }
    @media (max-width: 640px) {
      .aw-product-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Active Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest Gear"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Active Collection"
    }
  ]
}
{% endschema %}
