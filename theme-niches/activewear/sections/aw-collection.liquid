<div style="padding:48px 20px 0;background:var(--aw-grey)"><div style="max-width:1320px;margin:0 auto;text-align:center;padding-bottom:48px"><p class="aw-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</p><h1 style="font-family:'Outfit',sans-serif;font-size:clamp(32px,5vw,56px);font-weight:900;color:var(--aw-black);margin-bottom:12px">{{ collection.title }}</h1>{%- if collection.description != blank -%}<p style="font-size:16px;color:var(--aw-muted);max-width:560px;margin:0 auto">{{ collection.description }}</p>{%- endif -%}</div></div>
<div style="padding:0 20px 80px;background:#fff"><div style="max-width:1320px;margin:0 auto"><div style="display:flex;justify-content:space-between;align-items:center;padding:20px 0;border-bottom:1px solid var(--aw-border);margin-bottom:32px"><div style="font-size:14px;color:var(--aw-muted)">{{ collection.products_count }} styles</div><select style="padding:8px 16px;border:1px solid var(--aw-border);border-radius:100px;font-size:13px;cursor:pointer"><option>Featured</option><option>Price: Low</option><option>Price: High</option><option>Newest</option></select></div><div class="aw-prod-grid">{%- for product in collection.products -%}<a href="{{ product.url }}" class="aw-prod-card"><div class="aw-prod-card__img">{%- if product.tags contains 'new' -%}<span class="aw-prod-card__tag">New</span>{%- endif -%}{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--aw-grey)"></div>{%- endif -%}</div><div class="aw-prod-card__name">{{ product.title }}</div><div class="aw-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div></div></div>
{% schema %}
{"name":"AW Collection","settings":[],"presets":[{"name":"AW Collection"}]}
{% endschema %}
