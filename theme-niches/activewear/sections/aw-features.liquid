<div style="background:#0A0A0A; padding:100px 24px; position:relative; overflow:hidden;">
  
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px; flex-wrap:wrap; gap:24px;">
      <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(48px, 6vw, 80px); font-weight:700; font-style:italic; color:#FFFFFF; margin:0; text-transform:uppercase; line-height:1;">
        {{ section.settings.heading }}
      </h2>
      <div style="display:flex; gap:8px;">
        <div style="width:16px; height:8px; background:#CCFF00; transform:skewX(-20deg);"></div>
        <div style="width:16px; height:8px; background:#CCFF00; transform:skewX(-20deg);"></div>
        <div style="width:16px; height:8px; background:#CCFF00; transform:skewX(-20deg);"></div>
      </div>
    </div>

    <div class="aw-feat-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 4 }}, 1fr); gap:20px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#111111; padding:40px 32px; border-left:4px solid transparent; transition:all 0.3s ease;" class="aw-feat-card">
          
          <div style="font-family:'Oswald', sans-serif; font-size:48px; font-weight:700; color:#1A1A1A; margin-bottom:16px; -webkit-text-stroke:1px #333333;" class="aw-feat-num">
            0{{ forloop.index }}
          </div>
          
          <h3 style="font-family:'Oswald', sans-serif; font-size:24px; font-weight:600; font-style:italic; color:#FFFFFF; margin:0 0 12px 0; text-transform:uppercase;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Inter', sans-serif; font-size:16px; font-weight:400; color:#AAAAAA; margin:0; line-height:1.5;">
            {{ block.settings.desc }}
          </p>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .aw-feat-card:hover { background: #151515; border-left-color: #CCFF00; transform: translateX(10px); }
    .aw-feat-card:hover .aw-feat-num { color: #CCFF00; -webkit-text-stroke: 0; }
    
    @media (max-width: 1024px) {
      .aw-feat-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .aw-feat-grid { grid-template-columns: 1fr; }
      .aw-feat-card:hover { transform: translateX(5px); }
    }
  </style>
</div>

{% schema %}
{
  "name": "Active Features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built to Perform"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "AeroTech™"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Ultra-breathable fabric."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Active Features",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
