<div style="padding:80px 20px;background:var(--aw-black)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center"><div><p class="aw-eyebrow">{{ section.settings.eyebrow }}</p><h2 style="font-family:'Outfit',sans-serif;font-size:clamp(28px,4vw,48px);font-weight:900;color:var(--aw-white);margin-bottom:20px;line-height:0.95">{{ section.settings.heading }}</h2><p style="font-size:16px;color:var(--aw-muted);line-height:1.8;max-width:440px">{{ section.settings.body }}</p><div class="aw-stat-grid">{%- for block in section.blocks -%}<div class="aw-stat" style="border-color:rgba(255,255,255,0.1)" {{ block.shopify_attributes }}><div class="aw-stat__num" style="color:var(--aw-electric)">{{ block.settings.number }}</div><div class="aw-stat__label">{{ block.settings.label }}</div></div>{%- endfor -%}</div></div><div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:16px;object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:4/5;background:var(--aw-dark);border-radius:16px"></div>{%- endif -%}</div></div></div>
{% schema %}
{"name":"AW Performance","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ENGINEERED"},{"type":"text","id":"heading","label":"Heading","default":"Built for Performance"},{"type":"textarea","id":"body","label":"Body","default":"4-way stretch fabric, moisture-wicking technology, and flatlock seams. Every piece is tested by athletes."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number"},{"type":"text","id":"label","label":"Label"}]}],"presets":[{"name":"AW Performance","blocks":[{"type":"stat","settings":{"number":"100K+","label":"Athletes"}},{"type":"stat","settings":{"number":"4-Way","label":"Stretch"}},{"type":"stat","settings":{"number":"50+","label":"Styles"}},{"type":"stat","settings":{"number":"4.9★","label":"Rating"}}]}]}
{% endschema %}
