<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="cr-section-header"><p class="cr-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
  <div class="cr-review-grid">{%- for block in section.blocks -%}<div class="cr-review-card" {{ block.shopify_attributes }}><div class="cr-review-card__stars">{%- for i in (1..block.settings.rating) -%}★{%- endfor -%}</div><div class="cr-review-card__text">"{{ block.settings.quote }}"</div><div class="cr-review-card__author">{{ block.settings.name }}</div><div class="cr-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"CR Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"BREW NOTES"},{"type":"text","id":"heading","label":"Heading","default":"What Brewers Say"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"CR Reviews","blocks":[{"type":"review","settings":{"rating":5,"quote":"The Ethiopia Yirgacheffe has the most incredible blueberry notes. Changed how I think about coffee.","name":"Priya K.","product":"Ethiopia Yirgacheffe"}},{"type":"review","settings":{"rating":5,"quote":"Subscription is worth every rupee. Fresh beans every 2 weeks, perfectly roasted.","name":"Vikram S.","product":"Monthly Subscription"}},{"type":"review","settings":{"rating":5,"quote":"Best pour-over I've ever made at home. The Colombia Huila is liquid gold.","name":"Meera R.","product":"Colombia Huila"}}]}]}
{% endschema %}
