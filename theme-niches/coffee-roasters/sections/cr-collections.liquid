<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="cr-section-header"><p class="cr-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
  <div class="cr-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="cr-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--cr-warm)"></div>{%- endif -%}<div class="cr-col-card__overlay"><span class="cr-col-card__title">{{ block.settings.title }}</span><span class="cr-col-card__cta">Explore →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"CR Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ORIGINS"},{"type":"text","id":"heading","label":"Heading","default":"Browse by Origin"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Ethiopia"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"CR Collections","blocks":[{"type":"col","settings":{"title":"Ethiopia Yirgacheffe"}},{"type":"col","settings":{"title":"Colombia Huila"}},{"type":"col","settings":{"title":"Guatemala Antigua"}}]}]}
{% endschema %}
