<div style="padding:48px 20px 0;background:var(--cr-cream)"><div style="max-width:1320px;margin:0 auto;text-align:center;padding-bottom:48px">
  <p class="cr-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</p>
  <h1 style="font-family:'Playfair Display',serif;font-size:clamp(32px,5vw,52px);font-weight:400;color:var(--cr-espresso);margin-bottom:12px">{{ collection.title }}</h1>
  {%- if collection.description != blank -%}<p style="font-size:16px;color:var(--cr-muted);max-width:560px;margin:0 auto">{{ collection.description }}</p>{%- endif -%}
</div></div>
<div style="padding:0 20px 80px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div style="display:flex;justify-content:space-between;align-items:center;padding:20px 0;border-bottom:1px solid var(--cr-border);margin-bottom:32px">
    <div style="font-size:14px;color:var(--cr-muted)">{{ collection.products_count }} coffees</div>
    <select style="padding:8px 16px;border:1px solid var(--cr-border);border-radius:4px;font-size:13px;cursor:pointer"><option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Newest</option></select>
  </div>
  <div class="cr-prod-grid">{%- for product in collection.products -%}<a href="{{ product.url }}" class="cr-prod-card"><div class="cr-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--cr-warm)"></div>{%- endif -%}</div><div class="cr-prod-card__name">{{ product.title }}</div><div class="cr-prod-card__price">{{ product.price | money }}</div><div class="cr-prod-card__meta">{{ product.type }}</div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"CR Collection","settings":[],"presets":[{"name":"CR Collection"}]}
{% endschema %}
