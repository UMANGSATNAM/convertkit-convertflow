<div style="background:#FAF0E6; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px; flex-wrap:wrap; gap:24px;">
      <div>
        <h2 style="font-family:'Playfair Display', serif; font-size:clamp(36px, 5vw, 48px); font-weight:700; color:#3E2723; margin:0 0 16px 0;">
          {{ section.settings.heading }}
        </h2>
        <div style="width:60px; height:2px; background:#8B4513;"></div>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Lato', sans-serif; font-size:14px; font-weight:700; color:#3E2723; text-decoration:none; display:flex; align-items:center; gap:8px; text-transform:uppercase; letter-spacing:2px; padding-bottom:4px; border-bottom:1px solid #3E2723; transition:color 0.3s ease;" class="cr-link-btn">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="cr-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:40px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1559525839-b184a4d698c7?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1611162458324-aae1eb4129a4?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1495474472205-51f7b11c08d9?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1606760227091-3dd870d97f1d?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="cr-product-card" style="background:#FFFFFF; padding:24px; border:1px solid #EAE0D5; transition:all 0.4s ease; position:relative; display:flex; flex-direction:column; height:100%;">
          
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:120%; background:#FAF0E6; margin-bottom:24px;">
            <img src="{{ img_url }}" alt="Coffee Bag" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; mix-blend-mode:multiply; transition:transform 0.6s ease;" class="cr-product-img" loading="lazy">
            
            {% if idx == 1 or idx == 3 %}
              <div style="position:absolute; top:16px; right:16px; background:#3E2723; color:#FAF0E6; font-family:'Lato', sans-serif; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; padding:6px 12px;">
                {% if idx == 1 %}New Crop{% else %}Bestseller{% endif %}
              </div>
            {% endif %}
          </a>
          
          <div style="display:flex; flex-direction:column; flex-grow:1; text-align:center;">
            
            <div style="font-family:'Lato', sans-serif; font-size:12px; font-weight:700; color:#8B4513; text-transform:uppercase; letter-spacing:2px; margin-bottom:8px;">
              {% if idx == 1 %}Ethiopia Yirgacheffe{% elsif idx == 2 %}Colombia Supremo{% elsif idx == 3 %}Midnight Blend{% else %}Guatemala Antigua{% endif %}
            </div>
            
            <h3 style="font-family:'Playfair Display', serif; font-size:24px; font-weight:700; color:#3E2723; margin:0 0 12px 0; font-style:italic;">
              {% if idx == 1 %}Floral & Bright{% elsif idx == 2 %}Caramel & Nutty{% elsif idx == 3 %}Dark & Smoky{% else %}Cocoa & Spice{% endif %}
            </h3>
            
            <div style="width:30px; height:1px; background:#D2B48C; margin:0 auto 16px auto;"></div>
            
            <div style="font-family:'Lato', sans-serif; font-size:16px; font-weight:400; color:#5D4037; margin-bottom:24px;">
              {% if idx == 1 %}$22.00{% elsif idx == 2 %}$19.00{% elsif idx == 3 %}$20.00{% else %}$21.00{% endif %}
            </div>
            
            <button style="width:100%; background:transparent; color:#3E2723; border:1px solid #3E2723; font-family:'Lato', sans-serif; font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:2px; padding:16px; cursor:pointer; transition:all 0.3s ease; margin-top:auto;" class="cr-add-btn">
              Add to Cart
            </button>
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .cr-link-btn:hover { border-color: transparent; }
    .cr-product-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(62,39,35,0.05); }
    .cr-product-card:hover .cr-product-img { transform: scale(1.05); }
    .cr-add-btn:hover { background: #3E2723; color: #FAF0E6; }
    
    @media (max-width: 1024px) {
      .cr-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px 20px !important; }
    }
    @media (max-width: 640px) {
      .cr-product-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Coffee Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Freshly Roasted"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL ROASTS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Coffee Collection"
    }
  ]
}
{% endschema %}
