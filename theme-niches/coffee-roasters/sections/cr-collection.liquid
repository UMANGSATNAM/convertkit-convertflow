<div style="background:var(--cof-bg);padding:100px 40px">
  <div style="max-width:1200px;margin:0 auto">
    
    <div style="text-align:center;margin-bottom:80px">
      <div class="cof-stamp" style="margin-bottom:24px">FRESHLY ROASTED</div>
      <h2 class="cof-head" style="font-size:48px;margin-bottom:16px">{{ collection.title | default: 'Our Coffees' }}</h2>
      <p style="font-size:16px;color:var(--cof-muted);max-width:600px;margin:0 auto">From bright, floral African coffees to rich, chocolatey South American lots. Roasted to order and shipped within 24 hours.</p>
    </div>
    
    <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:40px">
      {%- for product in collection.products limit: 9 -%}
      <a href="{{ product.url }}" class="cof-card">
        <div class="image-wrapper">
          {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- else -%}
          <div style="width:100%;height:100%;background:#EAE0D5"></div>
          {%- endif -%}
        </div>
        <div class="origin">{{ product.vendor | default: 'Blend' }}</div>
        <div style="display:flex;justify-content:space-between;align-items:flex-start">
          <div class="title">{{ product.title }}</div>
          <div class="price">{{ product.price | money }}</div>
        </div>
        
        <div style="border-top:1px dashed var(--cof-border);margin-top:16px;padding-top:16px;display:flex;justify-content:space-between;align-items:center">
          <span style="font-size:12px;color:var(--cof-muted)">Notes: Caramel, Nut</span>
          <span style="font-family:var(--font-h);font-weight:700;color:var(--cof-accent);font-size:24px">+</span>
        </div>
      </a>
      {%- else -%}
      <!-- Demo State -->
      {%- for i in (1..6) -%}
      <a href="#" class="cof-card">
        <div class="image-wrapper">
          <div style="width:100%;height:100%;background:#EAE0D5"></div>
        </div>
        <div class="origin">COLOMBIA</div>
        <div style="display:flex;justify-content:space-between;align-items:flex-start">
          <div class="title">Finca El Paraiso V{{i}}</div>
          <div class="price">₹1,200</div>
        </div>
        <div style="border-top:1px dashed var(--cof-border);margin-top:16px;padding-top:16px;display:flex;justify-content:space-between;align-items:center">
          <span style="font-size:12px;color:var(--cof-muted)">Notes: Strawberry, Cocoa</span>
          <span style="font-family:var(--font-h);font-weight:700;color:var(--cof-accent);font-size:24px">+</span>
        </div>
      </a>
      {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Coffee Artisanal Grid",
  "settings": [],
  "presets": [
    {
      "name": "Coffee Artisanal Grid"
    }
  ]
}
{% endschema %}
