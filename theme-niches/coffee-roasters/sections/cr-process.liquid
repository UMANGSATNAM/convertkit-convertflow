<div style="background:#3E2723; padding:120px 24px; color:#FAF0E6; position:relative; overflow:hidden;">
  
  <!-- Subtle texture -->
  <div style="position:absolute; inset:0; background-image:url('data:image/svg+xml;utf8,<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\"><filter id=\"noiseFilter\"><feTurbulence type=\"fractalNoise\" baseFrequency=\"0.8\" numOctaves=\"3\" stitchTiles=\"stitch\"/></filter><rect width=\"100%\" height=\"100%\" filter=\"url(%23noiseFilter)\" opacity=\"0.08\"/></svg>'); z-index:1; pointer-events:none;"></div>
  
  <div style="max-width:1200px; margin:0 auto; position:relative; z-index:2;">
    
    <div style="text-align:center; margin-bottom:80px; max-width:600px; margin-left:auto; margin-right:auto;">
      <h2 style="font-family:'Playfair Display', serif; font-size:clamp(36px, 5vw, 48px); font-weight:700; color:#FAF0E6; margin:0 0 24px 0;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-family:'Lato', sans-serif; font-size:18px; color:#D2B48C; line-height:1.6; margin:0;">
        {{ section.settings.subheading }}
      </p>
    </div>

    <div class="cr-proc-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:60px; position:relative;">
      
      <!-- Connecting line for desktop -->
      <div style="position:absolute; top:40px; left:15%; right:15%; height:1px; background:rgba(210,180,140,0.3); z-index:1;" class="cr-proc-line"></div>
      
      {%- for block in section.blocks -%}
        <div style="text-align:center; position:relative; z-index:2;">
          
          <div style="width:80px; height:80px; border-radius:50%; background:#2A1A17; border:1px solid #D2B48C; display:flex; align-items:center; justify-content:center; margin:0 auto 32px auto; font-family:'Playfair Display', serif; font-size:28px; font-weight:700; color:#FAF0E6; font-style:italic;">
            0{{ forloop.index }}
          </div>
          
          <h3 style="font-family:'Lato', sans-serif; font-size:16px; font-weight:700; color:#FAF0E6; text-transform:uppercase; letter-spacing:2px; margin:0 0 16px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Lato', sans-serif; font-size:16px; font-weight:400; line-height:1.6; color:#D2B48C; margin:0 auto; max-width:280px;">
            {{ block.settings.desc }}
          </p>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    @media (max-width: 990px) {
      .cr-proc-grid { grid-template-columns: 1fr; gap: 60px; }
      .cr-proc-line { display: none; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Coffee Process",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Roasting Philosophy"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We believe great coffee starts at the farm and ends with a perfect roast."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ethical Sourcing"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Direct trade with farmers."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coffee Process",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
