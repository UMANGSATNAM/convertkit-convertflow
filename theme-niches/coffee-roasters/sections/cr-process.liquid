<div style="padding:80px 20px;background:var(--cr-dark)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <p class="cr-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 style="font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,48px);font-weight:400;color:var(--cr-cream);margin-bottom:20px;line-height:1.15">{{ section.settings.heading }}</h2>
    <p style="font-size:16px;color:var(--cr-muted);line-height:1.8;max-width:440px">{{ section.settings.body }}</p>
    <div class="cr-stat-grid">{%- for block in section.blocks -%}<div class="cr-stat" style="border-color:rgba(232,220,200,0.15)" {{ block.shopify_attributes }}><div class="cr-stat__num" style="color:var(--cr-caramel)">{{ block.settings.number }}</div><div class="cr-stat__label" style="color:var(--cr-muted)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:8px;object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:4/5;background:var(--cr-espresso);border-radius:8px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"CR Process","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE PROCESS"},{"type":"text","id":"heading","label":"Heading","default":"Roasted with Intent"},{"type":"textarea","id":"body","label":"Body","default":"We source directly from farming cooperatives and roast in small batches weekly — ensuring maximum freshness and flavor in every bag."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"12"},{"type":"text","id":"label","label":"Label","default":"Origins"}]}],"presets":[{"name":"CR Process","blocks":[{"type":"stat","settings":{"number":"12","label":"Origins"}},{"type":"stat","settings":{"number":"72hr","label":"Farm to Roast"}},{"type":"stat","settings":{"number":"100%","label":"Specialty Grade"}},{"type":"stat","settings":{"number":"5K+","label":"Happy Brewers"}}]}]}
{% endschema %}
