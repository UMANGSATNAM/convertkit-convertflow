<div style="padding:48px 20px 80px;background:var(--cr-cream)"><div style="max-width:1320px;margin:0 auto">
  <nav style="font-size:13px;color:var(--cr-muted);margin-bottom:32px" aria-label="Breadcrumb"><a href="/" style="color:var(--cr-muted)">Home</a> / <a href="{{ product.collections.first.url }}" style="color:var(--cr-muted)">{{ product.collections.first.title }}</a> / <span style="color:var(--cr-espresso)">{{ product.title }}</span></nav>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start">
    <div data-gallery>
      <div style="border-radius:8px;overflow:hidden;background:var(--cr-warm);aspect-ratio:1;margin-bottom:12px;cursor:zoom-in"><img id="MainProductImg" data-main-img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" style="width:100%;height:100%;object-fit:cover"></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">{%- for img in product.images limit: 6 -%}<div data-thumb data-src="{{ img | image_url: width: 900 }}" style="width:72px;height:72px;border-radius:6px;overflow:hidden;cursor:pointer;border:2px solid {% if forloop.first %}var(--cr-caramel){% else %}transparent{% endif %};transition:border-color .2s"><img src="{{ img | image_url: width: 144 }}" alt="" width="72" height="72" style="width:100%;height:100%;object-fit:cover"></div>{%- endfor -%}</div>
    </div>
    <div>
      <p class="cr-eyebrow" style="margin-bottom:8px">{{ product.vendor }}</p>
      <h1 style="font-family:'Playfair Display',serif;font-size:30px;font-weight:400;color:var(--cr-espresso);margin-bottom:12px">{{ product.title }}</h1>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px"><span style="color:var(--cr-caramel);font-size:15px;letter-spacing:2px">★★★★★</span><span style="font-size:13px;color:var(--cr-muted)">({{ product.metafields.reviews.rating_count | default: '980' }})</span></div>
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--cr-border)">
        <span style="font-size:28px;font-weight:700;color:var(--cr-espresso)" data-price>{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}<span style="font-size:18px;color:var(--cr-muted);text-decoration:line-through" data-compare-price>{{ product.compare_at_price | money }}</span>{%- endif -%}
      </div>
      <!-- Roast Profile -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:24px">
        {%- for block in section.blocks -%}{%- if block.type == 'profile' -%}
        <div style="padding:10px 14px;background:var(--cr-warm);border-radius:6px;font-size:12px" {{ block.shopify_attributes }}>
          <div style="color:var(--cr-muted);margin-bottom:2px;text-transform:uppercase;font-size:10px;letter-spacing:0.06em;font-weight:700">{{ block.settings.label }}</div>
          <div style="color:var(--cr-espresso);font-weight:600">{{ block.settings.value }}</div>
        </div>
        {%- endif -%}{%- endfor -%}
      </div>
      <!-- Subscription Banner -->
      <div style="background:var(--cr-warm);border-radius:6px;padding:14px;margin-bottom:20px;font-size:13px;color:var(--cr-espresso);border:1px solid var(--cr-border)">
        ☕ <strong>Subscribe & Save 15%</strong> — Fresh roasted beans delivered every 2 weeks
      </div>
      <form action="{{ routes.cart_add_url }}" method="post" id="ProductForm">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- unless product.has_only_default_variant -%}{%- for option in product.options_with_values -%}<div style="margin-bottom:20px"><label style="font-size:13px;font-weight:600;display:block;margin-bottom:10px;color:var(--cr-espresso)">{{ option.name }}</label><div style="display:flex;gap:8px;flex-wrap:wrap" data-swatches>{%- for value in option.values -%}<button type="button" data-swatch="{{ value }}" style="padding:10px 20px;border:2px solid {% if option.selected_value == value %}var(--cr-caramel){% else %}var(--cr-border){% endif %};background:{% if option.selected_value == value %}var(--cr-caramel){% else %}#fff{% endif %};color:{% if option.selected_value == value %}#fff{% else %}var(--cr-espresso){% endif %};font-size:13px;font-weight:500;cursor:pointer;border-radius:4px;transition:all .2s">{{ value }}</button>{%- endfor -%}</div></div>{%- endfor -%}<select name="id" data-variant-select style="display:none">{%- for variant in product.variants -%}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</option>{%- endfor -%}</select>{%- endunless -%}
        <div style="display:flex;gap:12px;margin-bottom:12px">
          <div style="display:flex;align-items:center;border:1.5px solid var(--cr-border);border-radius:4px;overflow:hidden"><button type="button" data-dir="down" style="width:44px;height:52px;background:none;border:none;font-size:20px;cursor:pointer">−</button><input type="number" name="quantity" value="1" min="1" style="width:48px;height:52px;text-align:center;border:none;font-size:16px;font-weight:600"><button type="button" data-dir="up" style="width:44px;height:52px;background:none;border:none;font-size:20px;cursor:pointer">+</button></div>
          <button type="submit" class="cr-btn" data-atc style="flex:1;justify-content:center" {% unless product.available %}disabled{% endunless %}>{%- if product.available -%}ADD TO BAG{%- else -%}SOLD OUT{%- endif -%}</button>
        </div>
      </form>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:20px 0">
        <div style="display:flex;align-items:center;gap:8px;padding:10px;background:var(--cr-warm);border-radius:6px;font-size:12px;color:var(--cr-espresso)"><span style="color:var(--cr-green)">✓</span> Freshly Roasted</div>
        <div style="display:flex;align-items:center;gap:8px;padding:10px;background:var(--cr-warm);border-radius:6px;font-size:12px;color:var(--cr-espresso)"><span style="color:var(--cr-green)">✓</span> Direct Trade</div>
        <div style="display:flex;align-items:center;gap:8px;padding:10px;background:var(--cr-warm);border-radius:6px;font-size:12px;color:var(--cr-espresso)"><span style="color:var(--cr-green)">🚚</span> Free Shipping ₹499+</div>
        <div style="display:flex;align-items:center;gap:8px;padding:10px;background:var(--cr-warm);border-radius:6px;font-size:12px;color:var(--cr-espresso)"><span style="color:var(--cr-green)">↩</span> Freshness Guaranteed</div>
      </div>
      <div style="font-size:15px;line-height:1.8;color:var(--cr-muted)">{{ product.description }}</div>
    </div>
  </div>
</div></div>
{% schema %}
{"name":"CR Product","settings":[],"blocks":[{"type":"profile","name":"Roast Profile","limit":6,"settings":[{"type":"text","id":"label","label":"Label","default":"Origin"},{"type":"text","id":"value","label":"Value","default":"Ethiopia"}]}],"presets":[{"name":"CR Product","blocks":[{"type":"profile","settings":{"label":"Origin","value":"Ethiopia Yirgacheffe"}},{"type":"profile","settings":{"label":"Roast","value":"Medium-Light"}},{"type":"profile","settings":{"label":"Process","value":"Washed"}},{"type":"profile","settings":{"label":"Altitude","value":"1,800-2,200m"}},{"type":"profile","settings":{"label":"Flavor","value":"Blueberry, Citrus, Jasmine"}},{"type":"profile","settings":{"label":"SCA Score","value":"87+"}}]}]}
{% endschema %}
