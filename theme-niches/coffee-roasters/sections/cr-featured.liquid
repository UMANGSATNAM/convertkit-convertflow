<div style="background:#3E2723; padding:0; position:relative; overflow:hidden;">
  
  <div style="max-width:1440px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; align-items:stretch;">
    
    <!-- Visual -->
    <div style="position:relative; min-height:600px;">
      <img src="https://images.unsplash.com/photo-1559525839-b184a4d698c7?auto=format&fit=crop&w=1000&q=80" alt="Coffee Subscription" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; mix-blend-mode:luminosity; opacity:0.8;" loading="lazy">
      <div style="position:absolute; inset:0; background:linear-gradient(to right, transparent 0%, #3E2723 100%);"></div>
    </div>
    
    <!-- Content -->
    <div style="padding:120px 80px 120px 40px; display:flex; flex-direction:column; justify-content:center; position:relative; z-index:2;">
      <div style="font-family:'Lato', sans-serif; font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:4px; color:#D2B48C; margin-bottom:24px; display:flex; align-items:center; gap:16px;">
        <span style="width:40px; height:1px; background:#D2B48C;"></span>
        {{ section.settings.eyebrow }}
      </div>
      
      <h2 style="font-family:'Playfair Display', serif; font-size:clamp(40px, 5vw, 56px); font-weight:700; color:#FAF0E6; margin:0 0 24px 0; line-height:1.1; font-style:italic;">
        {{ section.settings.heading }}
      </h2>
      
      <p style="font-family:'Lato', sans-serif; font-size:18px; font-weight:400; line-height:1.8; color:#D2B48C; margin:0 0 48px 0; max-width:480px;">
        {{ section.settings.subheading }}
      </p>
      
      <ul style="list-style:none; padding:0; margin:0 0 48px 0; display:flex; flex-direction:column; gap:16px;">
        <li style="display:flex; align-items:flex-start; gap:16px; font-family:'Lato', sans-serif; font-size:16px; color:#FAF0E6;">
          <span style="color:#D2B48C; font-size:20px;">✓</span> Free shipping on every order
        </li>
        <li style="display:flex; align-items:flex-start; gap:16px; font-family:'Lato', sans-serif; font-size:16px; color:#FAF0E6;">
          <span style="color:#D2B48C; font-size:20px;">✓</span> Pause or cancel anytime
        </li>
        <li style="display:flex; align-items:flex-start; gap:16px; font-family:'Lato', sans-serif; font-size:16px; color:#FAF0E6;">
          <span style="color:#D2B48C; font-size:20px;">✓</span> 10% off retail price
        </li>
      </ul>
      
      {%- if section.settings.cta_label != blank -%}
        <div>
          <a href="{{ section.settings.cta_url | default: '/products/subscription' }}" style="display:inline-block; background:#FAF0E6; color:#3E2723; font-family:'Lato', sans-serif; font-size:14px; font-weight:700; text-transform:uppercase; letter-spacing:2px; padding:20px 48px; text-decoration:none; transition:all 0.4s ease;" class="cr-btn-secondary">
            {{ section.settings.cta_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
    
  </div>

  <style>
    .cr-btn-secondary:hover { background: #D2B48C; color: #3E2723; }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; }
      div[style*="padding:120px 80px 120px 40px"] { padding: 60px 24px; }
      div[style*="background:linear-gradient(to right, transparent 0%, #3E2723 100%)"] { background: linear-gradient(to top, #3E2723 0%, transparent 100%); }
    }
  </style>
</div>

{% schema %}
{
  "name": "Coffee Featured",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NEVER RUN OUT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Roaster's Choice Subscription"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Let our head roaster select a new, exciting single origin for you every month. Freshly roasted and delivered to your door."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SUBSCRIBE & SAVE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Coffee Featured"
    }
  ]
}
{% endschema %}
