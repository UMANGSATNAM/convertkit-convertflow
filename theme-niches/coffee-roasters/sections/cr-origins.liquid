<div style="background:#F5F5DC; padding:120px 24px; position:relative;">
  
  <!-- Subtle texture -->
  <div style="position:absolute; inset:0; background-image:url('data:image/svg+xml;utf8,<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\"><filter id=\"noiseFilter\"><feTurbulence type=\"fractalNoise\" baseFrequency=\"0.8\" numOctaves=\"3\" stitchTiles=\"stitch\"/></filter><rect width=\"100%\" height=\"100%\" filter=\"url(%23noiseFilter)\" opacity=\"0.03\"/></svg>'); z-index:1; pointer-events:none;"></div>
  
  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Playfair Display', serif; font-size:clamp(36px, 5vw, 48px); font-weight:700; color:#3E2723; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      <div style="width:60px; height:2px; background:#8B4513; margin:0 auto;"></div>
    </div>

    <div class="cr-orig-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:30px;">
      
      {%- for block in section.blocks -%}
        <a href="#" class="cr-orig-card" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:140%; background:#3E2723; group">
          
          {%- assign img_url = 'https://images.unsplash.com/photo-1559525839-b184a4d698c7?auto=format&fit=crop&w=600&q=80' -%}
          {%- if forloop.index == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1611162458324-aae1eb4129a4?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
          {%- if forloop.index == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
          {%- if forloop.index == 4 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1495474472205-51f7b11c08d9?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
          
          <img src="{{ img_url }}" alt="{{ block.settings.title }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.8s ease; opacity:0.8;" class="cr-orig-img" loading="lazy">
          
          <!-- Gradient overlay -->
          <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(62,39,35,0.9) 0%, rgba(62,39,35,0.2) 50%, transparent 100%); transition:background 0.4s ease;" class="cr-orig-overlay"></div>
          
          <div style="position:absolute; bottom:0; left:0; width:100%; padding:32px; text-align:center;">
            <div style="font-family:'Playfair Display', serif; font-size:28px; font-weight:700; color:#FAF0E6; margin-bottom:8px; font-style:italic;">
              {{ block.settings.title }}
            </div>
            <div style="font-family:'Lato', sans-serif; font-size:14px; font-weight:400; color:#D2B48C; letter-spacing:1px; text-transform:uppercase;">
              {{ block.settings.desc }}
            </div>
            
            <div style="width:0; height:1px; background:#D2B48C; margin:16px auto 0 auto; transition:width 0.4s ease;" class="cr-orig-line"></div>
          </div>
          
        </a>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .cr-orig-card:hover .cr-orig-img { transform: scale(1.05); opacity: 0.6; }
    .cr-orig-card:hover .cr-orig-overlay { background: linear-gradient(to top, rgba(62,39,35,0.95) 0%, rgba(62,39,35,0.4) 100%); }
    .cr-orig-card:hover .cr-orig-line { width: 40px; }
    
    @media (max-width: 990px) {
      .cr-orig-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    }
    @media (max-width: 640px) {
      .cr-orig-grid { grid-template-columns: 1fr; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Coffee Origins",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore by Category"
    }
  ],
  "blocks": [
    {
      "type": "origin",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Single Origin"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Description",
          "default": "Distinct regional profiles"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coffee Origins",
      "blocks": [
        { "type": "origin" },
        { "type": "origin" },
        { "type": "origin" },
        { "type": "origin" }
      ]
    }
  ]
}
{% endschema %}
