<div style="background:#FAF0E6; padding:120px 24px; border-top:1px solid #EAE0D5;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px; max-width:600px; margin-left:auto; margin-right:auto;">
      <h2 style="font-family:'Playfair Display', serif; font-size:clamp(36px, 5vw, 48px); font-weight:700; color:#3E2723; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-family:'Lato', sans-serif; font-size:18px; color:#8B4513; margin:0;">
        {{ section.settings.subheading }}
      </p>
    </div>

    <div class="cr-brew-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:40px;">
      
      {%- for block in section.blocks -%}
        <div class="cr-brew-card" style="text-align:center; padding:48px 32px; background:#FFFFFF; border:1px solid #EAE0D5; transition:all 0.4s ease; cursor:pointer; position:relative;">
          
          <!-- Decorative corner -->
          <div style="position:absolute; top:0; left:0; width:30px; height:30px; border-top:2px solid #3E2723; border-left:2px solid #3E2723; opacity:0; transition:all 0.4s ease;" class="cr-brew-corner"></div>
          <div style="position:absolute; bottom:0; right:0; width:30px; height:30px; border-bottom:2px solid #3E2723; border-right:2px solid #3E2723; opacity:0; transition:all 0.4s ease;" class="cr-brew-corner"></div>
          
          <div style="width:100px; height:100px; margin:0 auto 32px auto; display:flex; align-items:center; justify-content:center;">
            {% if forloop.index == 1 %}
              <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#3E2723" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v2"/><path d="M12 12v2"/><path d="M8 4h8l-2 6H10z"/><path d="M7 16h10l-1 6H8z"/><path d="M10 10l-1 6"/><path d="M14 10l1 6"/></svg>
            {% elsif forloop.index == 2 %}
              <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#3E2723" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M6 4h10v16H6z"/><path d="M11 2v2"/><path d="M6 10h10"/><path d="M6 14h10"/></svg>
            {% else %}
              <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#3E2723" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v2"/><path d="M12 2v2"/><path d="M16 2v2"/><path d="M4 10h16v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6z"/><path d="M6 6h12v4H6z"/><path d="M9 18v4"/><path d="M15 18v4"/><path d="M6 22h12"/></svg>
            {% endif %}
          </div>
          
          <h3 style="font-family:'Playfair Display', serif; font-size:24px; font-weight:700; color:#3E2723; margin:0 0 16px 0; font-style:italic;">
            {{ block.settings.title }}
          </h3>
          
          <div style="font-family:'Lato', sans-serif; font-size:14px; font-weight:700; color:#8B4513; text-transform:uppercase; letter-spacing:2px; display:inline-flex; align-items:center; gap:8px;">
            Read Guide <span style="font-size:18px; transition:transform 0.3s ease;" class="cr-brew-arrow">&rarr;</span>
          </div>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .cr-brew-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(62,39,35,0.05); border-color: #3E2723; }
    .cr-brew-card:hover .cr-brew-corner { opacity: 1; }
    .cr-brew-card:hover .cr-brew-arrow { transform: translateX(5px); }
    
    @media (max-width: 990px) {
      .cr-brew-grid { grid-template-columns: 1fr; gap: 30px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Coffee Brewing",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brewing Guides"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Master the art of the perfect cup."
    }
  ],
  "blocks": [
    {
      "type": "guide",
      "name": "Guide",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pour Over"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coffee Brewing",
      "blocks": [
        { "type": "guide" },
        { "type": "guide" },
        { "type": "guide" }
      ]
    }
  ]
}
{% endschema %}
