<div class="cr-hero">
  <div class="cr-hero__content">
    <p class="cr-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="cr-hero__title">{{ section.settings.heading }}</h1>
    <p class="cr-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="cr-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="cr-btn cr-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="cr-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--cr-warm)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"CR Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SINGLE ORIGIN"},{"type":"text","id":"heading","label":"Heading","default":"From Bean to Cup"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Ethically sourced, small-batch roasted. Every cup tells the story of its origin."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"SHOP BEANS"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"OUR PROCESS"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"CR Hero"}]}
{% endschema %}
