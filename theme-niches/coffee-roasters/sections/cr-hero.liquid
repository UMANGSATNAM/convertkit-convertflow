<div style="background:var(--cof-bg);min-height:85vh;display:flex;align-items:center;padding:60px 40px;position:relative">
  <div style="max-width:1200px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center">
    
    <div style="position:relative">
      <!-- Stamp offset -->
      <div style="position:absolute;top:-30px;left:-20px;z-index:2">
        <div class="cof-stamp">EST. 2026</div>
      </div>
      
      <div style="border:1px solid var(--cof-border);padding:40px;background:#FFF;border-radius:4px">
        <div class="cof-label" style="margin-bottom:16px">{{ section.settings.overline | default: 'Single Origin Series' }}</div>
        <h1 class="cof-head" style="font-size:clamp(48px, 6vw, 72px);margin-bottom:24px;line-height:1.1">
          {{ section.settings.heading | default: 'Roasted to<br>Perfection.' }}
        </h1>
        <p style="font-size:16px;line-height:1.7;color:var(--cof-muted);margin-bottom:40px">
          {{ section.settings.text | default: 'We source micro-lots directly from farmers and roast them in small batches to highlight their unique tasting notes.' }}
        </p>
        <div style="display:flex;gap:20px;align-items:center">
          <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="cof-btn">{{ section.settings.btn1_text | default: 'Shop Fresh Roasts' }}</a>
        </div>
      </div>
    </div>
    
    <div style="position:relative;height:70vh">
      <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/coffee-hero.jpg?v=1717283400" alt="Coffee Hero" style="width:100%;height:100%;object-fit:cover;border-radius:4px;border:1px solid var(--cof-border)">
      
      <!-- Tasting Notes Hover Card -->
      <div style="position:absolute;bottom:40px;right:-30px;background:var(--cof-text);color:var(--cof-bg);padding:24px;border-radius:4px;box-shadow:0 20px 40px rgba(0,0,0,0.2);width:240px">
        <div class="cof-label" style="color:var(--cof-accent);margin-bottom:8px">CURRENT BATCH</div>
        <div class="cof-head" style="font-size:20px;margin-bottom:12px;color:#FFF">Ethiopia Yirgacheffe</div>
        <ul style="list-style:none;padding:0;margin:0;font-size:13px;color:#CCC">
          <li style="margin-bottom:4px;display:flex;justify-content:space-between"><span>Notes:</span> <span style="font-weight:700;color:#FFF">Jasmine, Peach</span></li>
          <li style="margin-bottom:4px;display:flex;justify-content:space-between"><span>Process:</span> <span style="font-weight:700;color:#FFF">Washed</span></li>
          <li style="display:flex;justify-content:space-between"><span>Roast:</span> <span style="font-weight:700;color:#FFF">Light</span></li>
        </ul>
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Coffee Artisanal Hero",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline Text",
      "default": "Single Origin Series"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Roasted to<br>Perfection."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "We source micro-lots directly from farmers."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button Text",
      "default": "Shop Fresh Roasts"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Coffee Artisanal Hero"
    }
  ]
}
{% endschema %}
