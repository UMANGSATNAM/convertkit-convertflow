<div style="background:#FAF0E6; position:relative; overflow:hidden;">
  
  <div style="max-width:1440px; margin:0 auto; min-height:90vh; display:grid; grid-template-columns:1fr 1fr; align-items:center;">
    
    <!-- Content -->
    <div style="padding:80px 40px 80px 60px; position:relative; z-index:2;">
      <div style="font-family:'Lato', sans-serif; font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:4px; color:#8B4513; margin-bottom:24px; display:flex; align-items:center; gap:16px;">
        <span style="width:40px; height:1px; background:#8B4513;"></span>
        {{ section.settings.eyebrow }}
      </div>
      
      <h1 style="font-family:'Playfair Display', serif; font-size:clamp(48px, 6vw, 80px); font-style:italic; font-weight:700; color:#3E2723; line-height:1.05; margin:0 0 32px 0;">
        {{ section.settings.heading }}
      </h1>
      
      <p style="font-family:'Lato', sans-serif; font-size:18px; font-weight:400; color:#5D4037; line-height:1.8; margin:0 0 48px 0; max-width:480px;">
        {{ section.settings.subheading }}
      </p>
      
      {%- if section.settings.cta_label != blank -%}
        <div style="display:flex; gap:24px; align-items:center;">
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-block; background:#3E2723; color:#FAF0E6; font-family:'Lato', sans-serif; font-size:14px; font-weight:700; text-transform:uppercase; letter-spacing:2px; padding:20px 48px; text-decoration:none; transition:all 0.4s ease; border:1px solid #3E2723;" class="cr-btn-primary">
            {{ section.settings.cta_label }}
          </a>
          <a href="/pages/our-story" style="display:inline-block; color:#3E2723; font-family:'Lato', sans-serif; font-size:14px; font-weight:700; text-transform:uppercase; letter-spacing:2px; text-decoration:none; position:relative;" class="cr-link-underline">
            Our Story
          </a>
        </div>
      {%- endif -%}
    </div>
    
    <!-- Visual -->
    <div style="position:relative; height:100%; width:100%; overflow:hidden; min-height:600px;">
      <!-- Subtle texture overlay -->
      <div style="position:absolute; inset:0; background-image:url('data:image/svg+xml;utf8,<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\"><filter id=\"noiseFilter\"><feTurbulence type=\"fractalNoise\" baseFrequency=\"0.8\" numOctaves=\"3\" stitchTiles=\"stitch\"/></filter><rect width=\"100%\" height=\"100%\" filter=\"url(%23noiseFilter)\" opacity=\"0.05\"/></svg>'); z-index:2; pointer-events:none;"></div>
      
      <img src="https://images.unsplash.com/photo-1497935586351-b67a49e012bf?auto=format&fit=crop&w=1200&q=80" alt="Pouring coffee" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;" loading="eager">
      
      <!-- Gradient overlay for text readability on mobile -->
      <div style="position:absolute; inset:0; background:linear-gradient(to right, #FAF0E6 0%, transparent 100%); z-index:1;" class="cr-hero-gradient"></div>
    </div>
    
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap');
    
    .cr-btn-primary:hover { background: transparent; color: #3E2723; }
    
    .cr-link-underline::after { content: ''; position: absolute; bottom: -4px; left: 0; width: 0%; height: 1px; background: #3E2723; transition: width 0.3s ease; }
    .cr-link-underline:hover::after { width: 100%; }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; }
      div[style*="padding:80px 40px 80px 60px"] { padding: 60px 24px; background: #FAF0E6; }
      .cr-hero-gradient { display: none; }
      div[style*="min-height:600px"] { min-height: 400px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Coffee Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ROASTED THIS MORNING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Awaken Your Senses"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Artisanal, small-batch coffee roasted with precision and passion. Taste the difference in every cup."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP COFFEE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Coffee Hero"
    }
  ]
}
{% endschema %}
