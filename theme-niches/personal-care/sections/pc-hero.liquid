<div class="pc-hero">
  <div class="pc-hero__content">
    <span class="pc-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="pc-hero__title">{{ section.settings.heading }}</h1>
    <p class="pc-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="pc-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/apothecary' }}" class="pc-btn pc-btn--outline" style="border-radius:30px">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="pc-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--pc-sage)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Personal Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"100% VEGAN BOTANICAL EXTRACTS"},{"type":"text","id":"heading","label":"Clean Botanical Personal Care"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Formulated with therapeutic cold-pressed essential oils. Free from synthetic sulfates, parabens, and artificial fragrances."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"SHOP BOTANICALS"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"OUR PROCESS"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Personal Hero"}]}
{% endschema %}
