<div style="background:#FAF7F2; position:relative; overflow:hidden; min-height:90vh; display:flex; align-items:center;">
  
  <!-- Soft abstract shapes -->
  <div style="position:absolute; top:-10%; left:-5%; width:40%; padding-bottom:40%; background:#D3C1B5; border-radius:40% 60% 70% 30% / 40% 50% 60% 50%; opacity:0.15; filter:blur(40px); z-index:1;"></div>
  <div style="position:absolute; bottom:-10%; right:-5%; width:50%; padding-bottom:50%; background:#B5C1B5; border-radius:60% 40% 30% 70% / 60% 30% 70% 40%; opacity:0.15; filter:blur(60px); z-index:1;"></div>
  
  <div style="max-width:1440px; margin:0 auto; padding:80px 40px; width:100%; position:relative; z-index:2; display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center;">
    
    <!-- Content -->
    <div style="max-width:560px;">
      <h1 style="font-family:'Lora', serif; font-size:clamp(48px, 6vw, 72px); font-weight:400; color:#4A4A4A; line-height:1.15; margin:0 0 24px 0;">
        {{ section.settings.heading }}
      </h1>
      
      <p style="font-family:'Nunito', sans-serif; font-size:18px; font-weight:300; color:#8B7355; line-height:1.7; margin:0 0 48px 0;">
        {{ section.settings.subheading }}
      </p>
      
      {%- if section.settings.cta_label != blank -%}
        <div>
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#4A4A4A; color:#FAF7F2; font-family:'Nunito', sans-serif; font-size:14px; font-weight:600; text-transform:uppercase; letter-spacing:2px; padding:18px 40px; border-radius:30px; text-decoration:none; transition:all 0.3s ease; box-shadow:0 10px 20px rgba(74,74,74,0.1);" class="pc-btn">
            {{ section.settings.cta_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
    
    <!-- Visual -->
    <div style="position:relative;">
      <!-- Arch frame -->
      <div style="position:relative; width:85%; margin:0 auto; padding-bottom:110%; overflow:hidden; border-radius:200px 200px 0 0; background:#EAE4D9; box-shadow:0 20px 40px rgba(139,115,85,0.08);">
        <img src="https://images.unsplash.com/photo-1616683693504-3ea7e9ad6fec?auto=format&fit=crop&w=1000&q=80" alt="Personal Care" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 10s ease;" class="pc-hero-img" loading="eager">
      </div>
      
      <!-- Floating accent element -->
      <div style="position:absolute; bottom:10%; right:0; background:#FFFFFF; padding:24px 32px; border-radius:16px; box-shadow:0 15px 30px rgba(139,115,85,0.1); display:flex; align-items:center; gap:16px;">
        <div style="width:40px; height:40px; background:#F0EBE1; border-radius:50%; display:flex; align-items:center; justify-content:center;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8B7355" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div>
          <div style="font-family:'Lora', serif; font-size:16px; font-weight:500; color:#4A4A4A;">100% Natural</div>
          <div style="font-family:'Nunito', sans-serif; font-size:12px; color:#8B7355;">Plant-based ingredients</div>
        </div>
      </div>
    </div>
    
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito:wght@300;400;600&display=swap');
    
    .pc-btn:hover { background: #8B7355; transform: translateY(-2px); box-shadow: 0 15px 25px rgba(139,115,85,0.2); }
    .pc-hero-img:hover { transform: scale(1.05); }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; text-align: center; }
      div[style*="max-width:560px"] { margin: 0 auto; }
      div[style*="position:absolute; bottom:10%; right:0"] { display: none; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Care Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nurture Your True Nature."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Plant-based personal care designed to restore balance and harmony to your daily routine."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP ESSENTIALS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Care Hero"
    }
  ]
}
{% endschema %}
