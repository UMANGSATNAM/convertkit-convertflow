<div style="background:#EAE4D9; padding:0; position:relative; overflow:hidden;">
  
  <div style="max-width:1440px; margin:0 auto; display:flex; flex-wrap:wrap; align-items:stretch;">
    
    <!-- Visual -->
    <div style="flex:1; min-width:400px; position:relative; min-height:600px;">
      <!-- Soft shape mask -->
      <div style="position:absolute; inset:20px; overflow:hidden; border-radius:300px 300px 0 0; background:#D3C1B5;">
        <img src="https://images.unsplash.com/photo-1556228578-0d85b1a4d571?auto=format&fit=crop&w=1000&q=80" alt="Botanical Ingredients" style="width:100%; height:100%; object-fit:cover; opacity:0.9;" loading="lazy">
      </div>
      
      <!-- Floating ingredient labels -->
      <div style="position:absolute; top:30%; left:10%; background:#FFFFFF; padding:12px 24px; border-radius:30px; font-family:'Nunito', sans-serif; font-size:12px; font-weight:600; color:#4A4A4A; box-shadow:0 10px 20px rgba(139,115,85,0.1); animation:float 6s ease-in-out infinite;">Aloe Vera</div>
      <div style="position:absolute; bottom:30%; right:10%; background:#FFFFFF; padding:12px 24px; border-radius:30px; font-family:'Nunito', sans-serif; font-size:12px; font-weight:600; color:#4A4A4A; box-shadow:0 10px 20px rgba(139,115,85,0.1); animation:float 8s ease-in-out infinite reverse;">Chamomile</div>
    </div>

    <!-- Content -->
    <div style="flex:1; min-width:400px; padding:120px 80px 120px 40px; display:flex; flex-direction:column; justify-content:center;">
      <h2 style="font-family:'Lora', serif; font-size:clamp(40px, 5vw, 64px); font-weight:400; color:#4A4A4A; margin:0 0 24px 0; line-height:1.15;">
        {{ section.settings.heading }}
      </h2>
      
      <p style="font-family:'Nunito', sans-serif; font-size:18px; font-weight:300; line-height:1.7; color:#8B7355; margin:0 0 48px 0; max-width:480px;">
        {{ section.settings.subheading }}
      </p>
      
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:32px;">
        
        <div>
          <div style="font-family:'Lora', serif; font-size:48px; font-weight:400; color:#D3C1B5; margin-bottom:8px; line-height:1;">0%</div>
          <div style="font-family:'Nunito', sans-serif; font-size:14px; font-weight:600; color:#4A4A4A; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Toxins</div>
          <div style="font-family:'Nunito', sans-serif; font-size:14px; font-weight:300; color:#8B7355;">No parabens, sulfates, or artificial fragrances.</div>
        </div>
        
        <div>
          <div style="font-family:'Lora', serif; font-size:48px; font-weight:400; color:#D3C1B5; margin-bottom:8px; line-height:1;">100%</div>
          <div style="font-family:'Nunito', sans-serif; font-size:14px; font-weight:600; color:#4A4A4A; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Transparency</div>
          <div style="font-family:'Nunito', sans-serif; font-size:14px; font-weight:300; color:#8B7355;">We list every single ingredient on our labels.</div>
        </div>
        
      </div>
      
    </div>
    
  </div>

  <style>
    @keyframes float {
      0% { transform: translateY(0px); }
      50% { transform: translateY(-15px); }
      100% { transform: translateY(0px); }
    }
    
    @media (max-width: 990px) {
      div[style*="display:flex; flex-wrap:wrap"] { flex-direction: column; }
      div[style*="padding:120px 80px 120px 40px"] { padding: 60px 24px; }
      div[style*="aspect-ratio:1"] { min-height: 400px; }
      div[style*="inset:20px"] { border-radius: 150px 150px 0 0; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Care Ingredients",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sourced from Nature"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We believe in the healing power of botanicals. Our formulas use only the purest ingredients."
    }
  ],
  "presets": [
    {
      "name": "Care Ingredients"
    }
  ]
}
{% endschema %}
