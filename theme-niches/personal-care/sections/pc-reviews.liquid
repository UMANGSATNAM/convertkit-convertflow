<div style="padding:80px 20px;background:#FAF8F5;border-bottom:1px solid var(--pc-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="pc-section-header"><span class="pc-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="pc-review-grid">{%- for block in section.blocks -%}<div class="pc-review-card" {{ block.shopify_attributes }}><div class="pc-review-card__stars">★★★★★</div><div class="pc-review-card__text">"{{ block.settings.quote }}"</div><div class="pc-review-card__author">{{ block.settings.name }}</div><div class="pc-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Personal Reviews","settings":[{"type":"text","id":"eyebrow","label":"HERBAL FEEDBACK"},{"type":"text","id":"heading","label":"Heading","default":"Stories from Clear Skin"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Personal Reviews","blocks":[{"type":"review","settings":{"quote":"Incredibly gentle on my sensitive skin. The botanical aroma is calming and doesn't trigger any redness.","name":"Karishma S.","product":"Gentle Sage Cleanser"}},{"type":"review","settings":{"quote":"Delightful eucalyptus body polish. Leaves my skin feeling amazingly smooth, moisturized, and refreshed.","name":"Pooja R.","product":"Eucalyptus Body Scrub"}},{"type":"review","settings":{"quote":"The hydrating lip balm is wonderful. Pure almond oil base keeps dry patches away for hours. Highly recommend.","name":"Anjali M.","product":"Hydrating Lip Balm"}}]}]}
{% endschema %}
