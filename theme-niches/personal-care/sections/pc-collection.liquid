<div style="background:#FAF7F2; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:80px; flex-wrap:wrap; gap:24px;">
      <h2 style="font-family:'Lora', serif; font-size:clamp(40px, 5vw, 56px); font-weight:400; color:#4A4A4A; margin:0;">
        {{ section.settings.heading }}
      </h2>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Nunito', sans-serif; font-size:14px; font-weight:600; color:#8B7355; text-decoration:none; text-transform:uppercase; letter-spacing:2px; display:inline-flex; align-items:center; gap:8px; padding-bottom:4px; border-bottom:1px solid #D3C1B5; transition:border-color 0.3s ease;" class="pc-link-btn">
          {{ section.settings.cta_label }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="pc-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:40px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1629198688000-71f23e745b6e?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1615397323628-912563f8859f?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1616683693504-3ea7e9ad6fec?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="pc-product-card" style="position:relative; display:flex; flex-direction:column; group">
          
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:125%; background:#F0EBE1; border-radius:120px 120px 0 0; margin-bottom:24px;">
            <img src="{{ img_url }}" alt="Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.8s ease;" class="pc-product-img" loading="lazy">
            
            {% if idx == 1 or idx == 3 %}
              <div style="position:absolute; top:20px; right:20px; background:#FFFFFF; color:#8B7355; font-family:'Nunito', sans-serif; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; padding:6px 16px; border-radius:20px;">
                {% if idx == 1 %}Best Seller{% else %}New{% endif %}
              </div>
            {% endif %}
            
            <button style="position:absolute; bottom:20px; left:50%; transform:translate(-50%, 20px); opacity:0; background:#4A4A4A; color:#FFFFFF; border:none; border-radius:30px; font-family:'Nunito', sans-serif; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:1px; padding:12px 32px; cursor:pointer; transition:all 0.3s ease; white-space:nowrap; box-shadow:0 10px 20px rgba(74,74,74,0.1);" class="pc-quick-add">
              Add to Bag - {% if idx == 1 %}$32{% elsif idx == 2 %}$28{% elsif idx == 3 %}$45{% else %}$24{% endif %}
            </button>
          </a>
          
          <div style="text-align:center;">
            <h3 style="font-family:'Lora', serif; font-size:20px; font-weight:500; color:#4A4A4A; margin:0 0 8px 0;">
              {% if idx == 1 %}Nourishing Body Wash{% elsif idx == 2 %}Botanical Deodorant{% elsif idx == 3 %}Hydrating Lotion{% else %}Hand Cream{% endif %}
            </h3>
            
            <div style="font-family:'Nunito', sans-serif; font-size:14px; font-weight:400; color:#8B7355;">
              {% if idx == 1 %}$32.00{% elsif idx == 2 %}$28.00{% elsif idx == 3 %}$45.00{% else %}$24.00{% endif %}
            </div>
          </div>
          
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .pc-link-btn:hover { border-color: #4A4A4A; color: #4A4A4A; }
    .pc-product-card:hover .pc-product-img { transform: scale(1.05); }
    .pc-product-card:hover .pc-quick-add { opacity: 1; transform: translate(-50%, 0); }
    .pc-quick-add:hover { background: #8B7355; }
    
    @media (max-width: 1024px) {
      .pc-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px 20px !important; }
    }
    @media (max-width: 640px) {
      .pc-product-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Care Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everyday Essentials"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Care Collection"
    }
  ]
}
{% endschema %}
