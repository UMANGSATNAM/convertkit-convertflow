<div style="background:#FFFFFF; padding:120px 24px; position:relative;">
  
  <div style="max-width:1200px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px; max-width:600px; margin-left:auto; margin-right:auto;">
      <h2 style="font-family:'Lora', serif; font-size:clamp(36px, 5vw, 48px); font-weight:400; color:#4A4A4A; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-family:'Nunito', sans-serif; font-size:18px; font-weight:300; color:#8B7355; margin:0;">
        {{ section.settings.subheading }}
      </p>
    </div>

    <div class="pc-rout-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:60px; position:relative;">
      
      <!-- Wavy connecting line for desktop -->
      <div style="position:absolute; top:40px; left:15%; right:15%; height:20px; background:transparent; z-index:1; border-bottom:1px dashed #D3C1B5;" class="pc-rout-line"></div>
      
      {%- for block in section.blocks -%}
        <div style="text-align:center; position:relative; z-index:2;">
          
          <div style="width:80px; height:80px; margin:0 auto 32px auto; background:#FAF7F2; border-radius:40% 60% 70% 30% / 40% 50% 60% 50%; display:flex; align-items:center; justify-content:center; font-family:'Lora', serif; font-size:24px; font-weight:400; color:#4A4A4A; box-shadow:0 10px 20px rgba(139,115,85,0.05); transition:all 0.4s ease;" class="pc-rout-num">
            {{ forloop.index }}
          </div>
          
          <h3 style="font-family:'Lora', serif; font-size:22px; font-weight:500; color:#4A4A4A; margin:0 0 12px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Nunito', sans-serif; font-size:15px; font-weight:300; line-height:1.6; color:#8B7355; margin:0 auto; max-width:240px;">
            {{ block.settings.desc }}
          </p>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .pc-rout-num:hover { transform: scale(1.1) rotate(10deg); background: #D3C1B5; color: #FFFFFF; }
    
    @media (max-width: 990px) {
      .pc-rout-grid { grid-template-columns: 1fr; gap: 40px; }
      .pc-rout-line { display: none; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Care Routine",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Daily Ritual"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A moment of calm in your busy day."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cleanse"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Gently remove impurities."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Care Routine",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
