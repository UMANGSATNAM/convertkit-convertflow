<div style="padding:80px 20px;background:#2B332D;border-bottom:1px solid var(--pc-border)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="pc-eyebrow" style="color:var(--pc-eucalyptus)">BOTANICAL RATING</span>
    <h2 style="font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,48px);font-weight:700;color:var(--pc-white);margin-bottom:20px;line-height:1.1;letter-spacing:-0.01em">{{ section.settings.heading }}</h2>
    <p style="font-family:'Outfit',sans-serif;font-size:15px;color:var(--pc-eucalyptus);line-height:1.7;max-width:440px;font-weight:500;opacity:0.8">{{ section.settings.body }}</p>
    <div class="pc-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="pc-stat" style="border-color:var(--pc-sage);background:rgba(78,110,88,0.1)" {{ block.shopify_attributes }}><div class="pc-stat__num" style="color:var(--pc-eucalyptus)">{{ block.settings.number }}</div><div class="pc-stat__label" style="color:var(--pc-white)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:12px;border:1px solid var(--pc-sage);object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:1.1;background:rgba(255,255,255,0.02);border-radius:12px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Personal Specs","settings":[{"type":"text","id":"eyebrow","label":"BOTANICAL PURITY"},{"type":"text","id":"heading","label":"Heading","default":"Sulfate-Free Cleanses."},{"type":"textarea","id":"body","label":"Body","default":"Every herbal batch is checked for pH compatibility, ensuring skin tolerance and complete absence of drying chemicals."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"0%"},{"type":"text","id":"label","label":"Label","default":"Chemicals"}]}],"presets":[{"name":"Personal Specs","blocks":[{"type":"stat","settings":{"number":"100%","label":"Plant Extracts"}},{"type":"stat","settings":{"number":"0%","label":"Parabens"}},{"type":"stat","settings":{"number":"pH 5.5","label":"Balanced Skin"}},{"type":"stat","settings":{"number":"Local","label":"Herbs"}}]}]}
{% endschema %}
