<div style="background:#FFFFFF; padding:120px 24px; position:relative; overflow:hidden;">
  
  <div style="max-width:1200px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <div style="display:inline-block; margin-bottom:16px;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D3C1B5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      </div>
      <h2 style="font-family:'Lora', serif; font-size:clamp(36px, 5vw, 48px); font-weight:400; color:#4A4A4A; margin:0;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="pc-feat-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:40px;">
      
      {%- for block in section.blocks -%}
        <div style="text-align:center; padding:40px 24px; background:#FAF7F2; border-radius:120px 120px 24px 24px; transition:transform 0.4s ease;" class="pc-feat-card">
          
          <div style="width:80px; height:80px; margin:0 auto 24px auto; background:#FFFFFF; border-radius:50%; display:flex; align-items:center; justify-content:center; box-shadow:0 10px 20px rgba(139,115,85,0.05);">
            {% if forloop.index == 1 %}
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#8B7355" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            {% elsif forloop.index == 2 %}
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#8B7355" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
            {% else %}
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#8B7355" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            {% endif %}
          </div>
          
          <h3 style="font-family:'Lora', serif; font-size:22px; font-weight:500; color:#4A4A4A; margin:0 0 12px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Nunito', sans-serif; font-size:15px; font-weight:300; color:#8B7355; margin:0 auto; line-height:1.6; max-width:240px;">
            {{ block.settings.desc }}
          </p>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .pc-feat-card:hover { transform: translateY(-10px); }
    
    @media (max-width: 990px) {
      .pc-feat-grid { grid-template-columns: 1fr; gap: 30px; }
      .pc-feat-card { border-radius: 60px 60px 24px 24px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Care Features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pure. Simple. Effective."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% Vegan"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Plant-derived ingredients only."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Care Features",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
