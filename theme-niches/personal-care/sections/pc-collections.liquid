<div style="padding:80px 20px;background:var(--pc-almond);border-bottom:1px solid var(--pc-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="pc-section-header"><span class="pc-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="pc-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="pc-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--pc-sage)"></div>{%- endif -%}<div class="pc-col-card__overlay"><span class="pc-col-card__title">{{ block.settings.title }}</span><span class="pc-col-card__cta">Explore Apothecary →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Personal Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"APOTHECARY SHELVES"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Apothecary Category"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Gentle Cleansers"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Personal Collections","blocks":[{"type":"col","settings":{"title":"Gentle Cleansers"}},{"type":"col","settings":{"title":"Eucalyptus Scrubs"}},{"type":"col","settings":{"title":"Hydrating Balms"}}]}]}
{% endschema %}
