<div style="padding:48px 20px 80px;background:var(--sw-black)">
  <div style="max-width:1320px;margin:0 auto">
    <nav style="font-size:12px;color:var(--sw-muted);margin-bottom:32px;font-family:'Inter',sans-serif" aria-label="Breadcrumb">
      <a href="/" style="color:var(--sw-muted)">Home</a> / <a href="{{ product.collections.first.url }}" style="color:var(--sw-muted)">{{ product.collections.first.title }}</a> / <span style="color:var(--sw-white)">{{ product.title }}</span>
    </nav>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start">
      <div data-gallery>
        <div style="overflow:hidden;background:var(--sw-grey);aspect-ratio:3/4;margin-bottom:12px;cursor:zoom-in">
          <img id="MainProductImg" data-main-img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" style="width:100%;height:100%;object-fit:cover">
        </div>
        <div style="display:flex;gap:6px;flex-wrap:wrap">
          {%- for img in product.images limit: 6 -%}
          <div data-thumb data-src="{{ img | image_url: width: 900 }}" style="width:72px;height:72px;overflow:hidden;cursor:pointer;border:2px solid {% if forloop.first %}var(--sw-neon){% else %}transparent{% endif %};transition:border-color .2s">
            <img src="{{ img | image_url: width: 144 }}" alt="" width="72" height="72" style="width:100%;height:100%;object-fit:cover">
          </div>
          {%- endfor -%}
        </div>
      </div>
      <div>
        {%- if product.tags contains 'limited' -%}<span style="display:inline-block;background:var(--sw-neon);color:var(--sw-black);font-family:'Oswald',sans-serif;font-size:11px;font-weight:700;padding:4px 12px;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:12px">LIMITED DROP</span>{%- endif -%}
        <p class="sw-eyebrow" style="margin-bottom:8px">{{ product.vendor }}</p>
        <h1 style="font-family:'Oswald',sans-serif;font-size:32px;font-weight:900;text-transform:uppercase;color:var(--sw-white);margin-bottom:16px;line-height:1">{{ product.title }}</h1>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
          <span style="color:var(--sw-neon);font-size:15px;letter-spacing:2px">★★★★★</span>
          <span style="font-size:13px;color:var(--sw-muted)">({{ product.metafields.reviews.rating_count | default: '1.8k' }})</span>
        </div>
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;padding-bottom:24px;border-bottom:1px solid var(--sw-border)">
          <span style="font-size:28px;font-weight:900;color:var(--sw-neon);font-family:'Oswald',sans-serif" data-price>{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
          <span style="font-size:18px;color:var(--sw-muted);text-decoration:line-through" data-compare-price>{{ product.compare_at_price | money }}</span>
          {%- endif -%}
        </div>
        <form action="{{ routes.cart_add_url }}" method="post" id="ProductForm">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
            <div style="margin-bottom:20px">
              <label style="font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;display:block;margin-bottom:10px;color:var(--sw-white);font-family:'Oswald',sans-serif">{{ option.name }}</label>
              <div style="display:flex;gap:8px;flex-wrap:wrap" data-swatches>
                {%- for value in option.values -%}
                <button type="button" data-swatch="{{ value }}" style="padding:10px 20px;border:2px solid {% if option.selected_value == value %}var(--sw-neon){% else %}var(--sw-border){% endif %};background:{% if option.selected_value == value %}var(--sw-neon){% else %}transparent{% endif %};color:{% if option.selected_value == value %}var(--sw-black){% else %}var(--sw-white){% endif %};font-size:13px;font-weight:700;cursor:pointer;transition:all .2s;font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:0.06em">{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
            {%- endfor -%}
            <select name="id" data-variant-select style="display:none">{%- for variant in product.variants -%}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</option>{%- endfor -%}</select>
          {%- endunless -%}
          <div style="display:flex;gap:12px;margin-bottom:12px">
            <div style="display:flex;align-items:center;border:2px solid var(--sw-border)">
              <button type="button" data-dir="down" style="width:44px;height:52px;background:none;border:none;font-size:20px;cursor:pointer;color:var(--sw-white)">−</button>
              <input type="number" name="quantity" value="1" min="1" style="width:48px;height:52px;text-align:center;border:none;font-size:16px;font-weight:700;font-family:'Oswald',sans-serif;background:transparent;color:var(--sw-white)">
              <button type="button" data-dir="up" style="width:44px;height:52px;background:none;border:none;font-size:20px;cursor:pointer;color:var(--sw-white)">+</button>
            </div>
            <button type="submit" class="sw-btn" data-atc style="flex:1;justify-content:center" {% unless product.available %}disabled{% endunless %}>{%- if product.available -%}ADD TO BAG{%- else -%}SOLD OUT{%- endif -%}</button>
          </div>
        </form>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:24px 0">
          <div style="display:flex;align-items:center;gap:8px;padding:12px;border:1px solid var(--sw-border);font-size:12px;color:var(--sw-muted)"><span style="color:var(--sw-neon)">✓</span> Free Shipping</div>
          <div style="display:flex;align-items:center;gap:8px;padding:12px;border:1px solid var(--sw-border);font-size:12px;color:var(--sw-muted)"><span style="color:var(--sw-neon)">↩</span> Easy Returns</div>
          <div style="display:flex;align-items:center;gap:8px;padding:12px;border:1px solid var(--sw-border);font-size:12px;color:var(--sw-muted)"><span style="color:var(--sw-neon)">🔒</span> Secure Pay</div>
          <div style="display:flex;align-items:center;gap:8px;padding:12px;border:1px solid var(--sw-border);font-size:12px;color:var(--sw-muted)"><span style="color:var(--sw-neon)">⚡</span> Fast Dispatch</div>
        </div>
        <div style="font-family:'Inter',sans-serif;font-size:15px;line-height:1.8;color:var(--sw-muted)">{{ product.description }}</div>
      </div>
    </div>
  </div>
</div>
{% schema %}
{"name":"SW Product","settings":[],"presets":[{"name":"SW Product"}]}
{% endschema %}
