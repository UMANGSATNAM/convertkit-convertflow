<div style="padding:48px 20px 0;background:var(--sw-black)">
  <div style="max-width:1320px;margin:0 auto;text-align:center;padding-bottom:48px">
    <p class="sw-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</p>
    <h1 style="font-family:'Oswald',sans-serif;font-size:clamp(36px,6vw,72px);font-weight:900;text-transform:uppercase;color:var(--sw-white);margin-bottom:12px;line-height:0.95">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<p style="font-size:16px;color:var(--sw-muted);max-width:560px;margin:0 auto">{{ collection.description }}</p>{%- endif -%}
  </div>
</div>
<div style="padding:0 20px 80px;background:var(--sw-black)">
  <div style="max-width:1320px;margin:0 auto">
    <div style="display:flex;justify-content:space-between;align-items:center;padding:20px 0;border-bottom:1px solid var(--sw-border);margin-bottom:32px">
      <div style="font-size:13px;color:var(--sw-muted);font-family:'Inter',sans-serif">{{ collection.products_count }} pieces</div>
      <select style="padding:8px 16px;border:1px solid var(--sw-border);font-size:12px;font-family:'Oswald',sans-serif;text-transform:uppercase;cursor:pointer;background:transparent;color:var(--sw-white);letter-spacing:0.08em">
        <option>FEATURED</option><option>PRICE: LOW</option><option>PRICE: HIGH</option><option>NEWEST</option>
      </select>
    </div>
    <div class="sw-prod-grid">
      {%- for product in collection.products -%}
      <a href="{{ product.url }}" class="sw-prod-card">
        <div class="sw-prod-card__img">
          {%- if product.tags contains 'limited' -%}<span class="sw-prod-card__tag">Limited</span>{%- endif -%}
          {%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--sw-grey)"></div>{%- endif -%}
        </div>
        <div class="sw-prod-card__name">{{ product.title }}</div>
        <div class="sw-prod-card__price">{{ product.price | money }}</div>
      </a>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{"name":"SW Collection","settings":[],"presets":[{"name":"SW Collection"}]}
{% endschema %}
