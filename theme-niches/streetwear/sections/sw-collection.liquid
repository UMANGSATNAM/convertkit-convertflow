<div style="background:var(--sw-bg);padding:100px 60px;border-bottom:2px solid var(--sw-border)">
  <div style="max-width:1600px;margin:0 auto">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:60px;border-bottom:2px solid var(--sw-border);padding-bottom:24px">
      <div>
        <div class="mono-tag" style="margin-bottom:12px">/// ALL GEAR</div>
        <h2 class="sw-head" style="font-size:80px;color:var(--sw-text);line-height:0.9">{{ collection.title | default: 'THE ARCHIVE' }}</h2>
      </div>
      <div style="font-family:var(--font-mono);font-size:14px;color:var(--sw-accent)">
        [{{ collection.products_count | default: '42' }} ITEMS DETECTED]
      </div>
    </div>
    
    <div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:24px">
      {%- for product in collection.products limit: 12 -%}
      <a href="{{ product.url }}" class="sw-card" style="display:block;text-decoration:none">
        {%- if product.compare_at_price > product.price -%}
        <div class="badge">SALE</div>
        {%- endif -%}
        <div class="glitch-hover" style="aspect-ratio:3/4;margin-bottom:24px;display:flex;align-items:center;justify-content:center">
          {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- else -%}
          <div style="font-family:var(--font-mono);color:var(--sw-muted);text-transform:uppercase">NO_IMG_FOUND</div>
          {%- endif -%}
        </div>
        <div style="display:flex;justify-content:space-between;align-items:flex-start">
          <div class="sw-head" style="font-size:24px;color:var(--sw-text);max-width:70%">{{ product.title }}</div>
          <div style="text-align:right">
            <div style="font-family:var(--font-mono);font-size:18px;font-weight:700;color:var(--sw-accent)">{{ product.price | money }}</div>
            {%- if product.compare_at_price > product.price -%}
            <div style="font-family:var(--font-mono);font-size:12px;color:var(--sw-muted);text-decoration:line-through">{{ product.compare_at_price | money }}</div>
            {%- endif -%}
          </div>
        </div>
        <button class="sw-btn" style="width:100%;margin-top:24px;padding:12px">QUICK_ADD +</button>
      </a>
      {%- else -%}
      <!-- Demo State -->
      {%- for i in (1..8) -%}
      <div class="sw-card">
        <div class="glitch-hover" style="aspect-ratio:3/4;margin-bottom:24px;background:#111"></div>
        <div style="display:flex;justify-content:space-between;align-items:flex-start">
          <div class="sw-head" style="font-size:24px;color:var(--sw-text)">TACTICAL VEST V.{{i}}</div>
          <div style="font-family:var(--font-mono);font-size:18px;font-weight:700;color:var(--sw-accent)">₹8,999</div>
        </div>
        <button class="sw-btn" style="width:100%;margin-top:24px;padding:12px">QUICK_ADD +</button>
      </div>
      {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Streetwear Brutalist Grid",
  "settings": [],
  "presets": [
    {
      "name": "Streetwear Brutalist Grid"
    }
  ]
}
{% endschema %}
