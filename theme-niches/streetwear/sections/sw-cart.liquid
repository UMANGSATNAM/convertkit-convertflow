<div style="padding:48px 20px 80px;background:var(--sw-black);min-height:60vh">
  <div style="max-width:960px;margin:0 auto">
    <h1 style="font-family:'Oswald',sans-serif;font-size:clamp(32px,5vw,56px);font-weight:900;text-transform:uppercase;color:var(--sw-white);text-align:center;margin-bottom:48px">YOUR BAG</h1>
    {%- if cart.item_count == 0 -%}
    <div style="text-align:center;padding:80px 20px">
      <div style="font-size:48px;margin-bottom:20px">🔥</div>
      <h2 style="font-family:'Oswald',sans-serif;font-size:28px;font-weight:900;text-transform:uppercase;color:var(--sw-white);margin-bottom:12px">EMPTY BAG</h2>
      <p style="color:var(--sw-muted);margin-bottom:32px">Time to cop some heat</p>
      <a href="/collections/all" class="sw-btn">SHOP DROPS</a>
    </div>
    {%- else -%}
    <div style="display:grid;grid-template-columns:1fr 380px;gap:48px;align-items:start">
      <div>
        {%- for item in cart.items -%}
        <div style="display:flex;gap:20px;padding:24px 0;border-bottom:1px solid var(--sw-border);align-items:center">
          <a href="{{ item.url }}" style="flex-shrink:0"><img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="120" style="object-fit:cover"></a>
          <div style="flex:1;min-width:0">
            <a href="{{ item.url }}" style="text-decoration:none;font-family:'Oswald',sans-serif;font-size:15px;font-weight:700;color:var(--sw-white);text-transform:uppercase;display:block;margin-bottom:4px">{{ item.product.title }}</a>
            {%- unless item.variant.title == 'Default Title' -%}<div style="font-size:13px;color:var(--sw-muted);margin-bottom:8px">{{ item.variant.title }}</div>{%- endunless -%}
            <div style="display:flex;align-items:center;gap:12px">
              <div style="display:flex;align-items:center;border:1px solid var(--sw-border)">
                <button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px;color:var(--sw-white)">−</button>
                <span style="width:32px;text-align:center;font-size:14px;font-weight:700;color:var(--sw-white)">{{ item.quantity }}</span>
                <button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px;color:var(--sw-white)">+</button>
              </div>
              <a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" style="font-size:12px;color:var(--sw-muted);text-decoration:underline">Remove</a>
            </div>
          </div>
          <div style="font-size:16px;font-weight:900;color:var(--sw-neon);font-family:'Oswald',sans-serif">{{ item.final_line_price | money }}</div>
        </div>
        {%- endfor -%}
      </div>
      <div style="background:var(--sw-grey);padding:32px;border:1px solid var(--sw-border);position:sticky;top:120px">
        <h3 style="font-family:'Oswald',sans-serif;font-size:14px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--sw-white);margin-bottom:24px">ORDER SUMMARY</h3>
        <div style="display:flex;justify-content:space-between;margin-bottom:12px;font-size:14px"><span style="color:var(--sw-muted)">Subtotal</span><span style="font-weight:700;color:var(--sw-white)">{{ cart.total_price | money }}</span></div>
        <div style="display:flex;justify-content:space-between;margin-bottom:12px;font-size:14px"><span style="color:var(--sw-muted)">Shipping</span><span style="font-weight:700;color:var(--sw-neon)">FREE</span></div>
        <div style="margin:16px 0;padding:12px;border:1px solid var(--sw-neon);font-size:13px;color:var(--sw-neon);text-align:center;font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:0.1em">⚡ Express dispatch — ships within 24hrs</div>
        <div style="padding-top:16px;border-top:1px solid var(--sw-border);margin-top:16px;display:flex;justify-content:space-between;margin-bottom:24px">
          <span style="font-family:'Oswald',sans-serif;font-size:16px;font-weight:900;text-transform:uppercase;color:var(--sw-white)">Total</span>
          <span style="font-size:20px;font-weight:900;color:var(--sw-neon);font-family:'Oswald',sans-serif">{{ cart.total_price | money }}</span>
        </div>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="sw-btn" style="width:100%;justify-content:center">CHECKOUT</button>
        </form>
      </div>
    </div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{"name":"SW Cart","settings":[],"presets":[{"name":"SW Cart"}]}
{% endschema %}
