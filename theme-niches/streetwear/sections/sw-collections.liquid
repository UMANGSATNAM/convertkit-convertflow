<div style="padding:80px 20px;background:var(--sw-black)">
  <div style="max-width:1320px;margin:0 auto">
    <div class="sw-section-header"><p class="sw-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
    <div class="sw-col-grid">
      {%- for block in section.blocks -%}
      <a href="{{ block.settings.url | default: '/collections/all' }}" class="sw-col-card" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">
        {%- else -%}<div style="width:100%;height:100%;background:var(--sw-grey)"></div>{%- endif -%}
        <div class="sw-col-card__overlay"><span class="sw-col-card__title">{{ block.settings.title }}</span><span class="sw-col-card__cta">Shop Drop →</span></div>
      </a>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{"name":"SW Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CATEGORIES"},{"type":"text","id":"heading","label":"Heading","default":"SHOP BY VIBE"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Hoodies"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"SW Collections","blocks":[{"type":"col","settings":{"title":"HOODIES"}},{"type":"col","settings":{"title":"TEES & TANKS"}},{"type":"col","settings":{"title":"SNEAKERS"}}]}]}
{% endschema %}
