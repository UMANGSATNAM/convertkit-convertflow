<div style="padding:80px 20px;background:var(--sw-black)">
  <div style="max-width:1320px;margin:0 auto">
    <div class="sw-section-header"><p class="sw-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
    <div class="sw-review-grid">
      {%- for block in section.blocks -%}
      <div class="sw-review-card" {{ block.shopify_attributes }}>
        <div class="sw-review-card__stars">{%- for i in (1..block.settings.rating) -%}★{%- endfor -%}</div>
        <div class="sw-review-card__text">"{{ block.settings.quote }}"</div>
        <div class="sw-review-card__author">{{ block.settings.name }}</div>
        <div class="sw-review-card__meta">{{ block.settings.product }}</div>
      </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{"name":"SW Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"COMMUNITY"},{"type":"text","id":"heading","label":"Heading","default":"STREET TALK"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"SW Reviews","blocks":[{"type":"review","settings":{"rating":5,"quote":"The oversized fit is absolutely insane. Quality fabric, not fast fashion garbage.","name":"RAHUL M.","product":"Oversized Hoodie"}},{"type":"review","settings":{"rating":5,"quote":"Copped the limited tee — sold out in 3 mins. Best drop this year.","name":"ANIKA S.","product":"Limited Drop Tee"}},{"type":"review","settings":{"rating":5,"quote":"Street cred level 100. Everyone asks where I got these. Quality is unmatched.","name":"DEV P.","product":"Cargo Joggers"}}]}]}
{% endschema %}
