<div style="background:#FF3300; padding:20px 0; overflow:hidden; border-top:4px solid #000000; border-bottom:4px solid #000000; white-space:nowrap; position:relative; display:flex;">
  
  <div class="sw-marquee-content" style="display:inline-block; font-family:'Space Grotesk', sans-serif; font-size:32px; font-weight:700; color:#000000; text-transform:uppercase; letter-spacing:2px; animation:sw-marquee 20s linear infinite;">
    {{ section.settings.text }}&nbsp;{{ section.settings.text }}&nbsp;{{ section.settings.text }}&nbsp;{{ section.settings.text }}&nbsp;
  </div>
  <!-- Duplicate for seamless loop -->
  <div class="sw-marquee-content" style="display:inline-block; font-family:'Space Grotesk', sans-serif; font-size:32px; font-weight:700; color:#000000; text-transform:uppercase; letter-spacing:2px; animation:sw-marquee 20s linear infinite;">
    {{ section.settings.text }}&nbsp;{{ section.settings.text }}&nbsp;{{ section.settings.text }}&nbsp;{{ section.settings.text }}&nbsp;
  </div>

  <style>
    @keyframes sw-marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-100%); }
    }
  </style>
</div>

{% schema %}
{
  "name": "Streetwear Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "WARNING: HIGH VOLTAGE // PROCEED WITH CAUTION //"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Marquee"
    }
  ]
}
{% endschema %}
