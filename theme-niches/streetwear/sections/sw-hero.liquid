<div style="position:relative;background:var(--sw-bg);min-height:90vh;display:flex;flex-direction:column;border-bottom:2px solid var(--sw-border)">
  <div style="flex:1;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;padding:40px 60px;max-width:1600px;margin:0 auto;width:100%">
    <div style="padding-right:40px">
      <div class="mono-tag" style="margin-bottom:24px">{{ section.settings.overline | default: '/// SS26 SEASON ZERO' }}</div>
      <h1 class="sw-head" style="font-size:clamp(60px, 8vw, 120px);color:var(--sw-text);margin-bottom:32px;text-transform:uppercase;word-wrap:break-word;hyphens:auto">{{ section.settings.heading | default: 'SYSTEM<br>OVERLOAD' }}</h1>
      <p style="font-family:var(--font-mono);font-size:16px;line-height:1.6;color:var(--sw-muted);margin-bottom:48px;max-width:480px">{{ section.settings.text | default: 'High-visibility technical garments for the concrete grid. Limited run. No restocks.' }}</p>
      <div style="display:flex;gap:24px">
        <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="sw-btn">{{ section.settings.btn1_text | default: 'SHOP DROP 01' }}</a>
        <a href="{{ section.settings.btn2_url | default: '/collections/lookbook' }}" class="sw-btn sw-btn-outline">{{ section.settings.btn2_text | default: 'VIEW ARCHIVE' }}</a>
      </div>
    </div>
    <div class="glitch-hover" style="height:70vh;width:100%;background:#111">
      <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/hero-sw.jpg?v=1717283400" alt="Streetwear Hero" style="width:100%;height:100%;object-fit:cover;mix-blend-mode:luminosity">
      <!-- Asymmetrical Badge -->
      <div style="position:absolute;bottom:30px;left:-30px;background:var(--sw-text);color:#000;font-family:var(--font-mono);font-weight:700;padding:12px 24px;font-size:14px;border:2px solid #000;transform:rotate(-5deg)">LIMITED EDITION</div>
    </div>
  </div>
  
  <!-- Infinite Marquee Bottom -->
  <div class="marquee-wrapper">
    <div class="marquee-content">
      <span style="padding:0 40px">/// WARNING: HIGH VOLTAGE APPAREL /// FREE SHIPPING ON ORDERS OVER $200 /// NO RESTOCKS ///</span>
      <span style="padding:0 40px">/// WARNING: HIGH VOLTAGE APPAREL /// FREE SHIPPING ON ORDERS OVER $200 /// NO RESTOCKS ///</span>
      <span style="padding:0 40px">/// WARNING: HIGH VOLTAGE APPAREL /// FREE SHIPPING ON ORDERS OVER $200 /// NO RESTOCKS ///</span>
      <span style="padding:0 40px">/// WARNING: HIGH VOLTAGE APPAREL /// FREE SHIPPING ON ORDERS OVER $200 /// NO RESTOCKS ///</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Streetwear Brutalist Hero",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline Text",
      "default": "/// SS26 SEASON ZERO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SYSTEM<br>OVERLOAD"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "High-visibility technical garments for the concrete grid. Limited run. No restocks."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 Text",
      "default": "SHOP DROP 01"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 Text",
      "default": "VIEW ARCHIVE"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Button 2 Link"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Brutalist Hero"
    }
  ]
}
{% endschema %}
