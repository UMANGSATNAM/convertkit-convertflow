<div class="sw-hero">
  <div class="sw-hero__content">
    <p class="sw-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="sw-hero__title">{{ section.settings.heading }}</h1>
    <p class="sw-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="sw-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="sw-btn sw-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="sw-hero__visual">
    {%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">
    {%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--sw-grey)"></div>{%- endif -%}
  </div>
</div>
{% schema %}
{"name":"SW Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"NEW DROP"},{"type":"text","id":"heading","label":"Heading","default":"WEAR THE CULTURE"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Limited drops. Bold silhouettes. Street-tested, culture-approved."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"SHOP NOW"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"NEW ARRIVALS"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"SW Hero"}]}
{% endschema %}
