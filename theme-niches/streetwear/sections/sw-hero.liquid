<div style="background:#E5E5E5; position:relative; overflow:hidden; min-height:100vh; display:flex; align-items:center; border-bottom:4px solid #000000;">
  
  <!-- Grid background -->
  <div style="position:absolute; inset:0; background-image:linear-gradient(#000000 1px, transparent 1px), linear-gradient(90deg, #000000 1px, transparent 1px); background-size:40px 40px; opacity:0.1; z-index:1;"></div>
  
  <div style="max-width:1440px; margin:0 auto; padding:0 24px; width:100%; position:relative; z-index:2; display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center;">
    
    <!-- Content -->
    <div style="position:relative; z-index:3;">
      <div style="display:inline-block; background:#000000; color:#FFFFFF; font-family:'Space Grotesk', sans-serif; font-size:14px; font-weight:700; text-transform:uppercase; letter-spacing:2px; padding:8px 16px; margin-bottom:24px; border:2px solid #000000;">
        {{ section.settings.subheading }}
      </div>
      
      <h1 style="font-family:'Space Grotesk', sans-serif; font-size:clamp(80px, 10vw, 160px); font-weight:700; color:#000000; line-height:0.85; margin:0 0 40px 0; text-transform:uppercase; letter-spacing:-4px;">
        {{ section.settings.heading | replace: '<br>', '<br>' }}
      </h1>
      
      {%- if section.settings.cta_label != blank -%}
        <div>
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#FF3300; color:#000000; font-family:'Space Grotesk', sans-serif; font-size:20px; font-weight:700; text-transform:uppercase; letter-spacing:1px; padding:20px 40px; text-decoration:none; border:4px solid #000000; box-shadow:8px 8px 0px #000000; transition:all 0.2s ease;" class="sw-btn">
            {{ section.settings.cta_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
    
    <!-- Visual (Brutalist composition) -->
    <div style="position:relative; height:700px; display:flex; align-items:center; justify-content:center;">
      
      <div style="position:absolute; top:10%; right:10%; width:70%; height:80%; border:4px solid #000000; background:#FFFFFF; z-index:1; transform:rotate(5deg);"></div>
      
      <div style="position:absolute; top:20%; left:10%; width:80%; height:70%; border:4px solid #000000; background:#FF3300; z-index:2; overflow:hidden;">
        <img src="https://images.unsplash.com/photo-1523398002811-999aa8d9f1ab?auto=format&fit=crop&w=1000&q=80" alt="Streetwear" style="width:100%; height:100%; object-fit:cover; mix-blend-mode:luminosity; opacity:0.8;" loading="eager">
      </div>
      
      <!-- Graphic elements -->
      <div style="position:absolute; bottom:10%; right:0; background:#000000; color:#FFFFFF; font-family:'Space Grotesk', sans-serif; font-size:48px; font-weight:700; padding:10px 20px; z-index:3; transform:rotate(-10deg);">
        XXX
      </div>
      <div style="position:absolute; top:5%; left:0; width:100px; height:100px; border-radius:50%; border:4px dashed #000000; z-index:3; animation:spin 10s linear infinite;"></div>
      
    </div>
    
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');
    
    @keyframes spin { 100% { transform: rotate(360deg); } }
    
    .sw-btn:hover { background: #000000; color: #FFFFFF; transform: translate(4px, 4px); box-shadow: 4px 4px 0px #FF3300; border-color: #FF3300; }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; }
      div[style*="height:700px"] { height: 500px; }
      h1 { font-size: clamp(60px, 12vw, 100px) !important; letter-spacing: -2px !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Streetwear Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SUBVERT<br>THE SYSTEM"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "LATEST DROP // COLLECTION 004"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "ENTER NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Hero"
    }
  ]
}
{% endschema %}
