<div style="padding:80px 20px;background:var(--sw-grey)">
  <div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
    <div>
      <p class="sw-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 style="font-family:'Oswald',sans-serif;font-size:clamp(28px,4vw,48px);font-weight:900;text-transform:uppercase;color:var(--sw-white);margin-bottom:20px;line-height:0.95">{{ section.settings.heading }}</h2>
      <p style="font-size:16px;color:var(--sw-muted);line-height:1.8;max-width:440px;font-family:'Inter',sans-serif">{{ section.settings.body }}</p>
      <div class="sw-stat-grid">
        {%- for block in section.blocks -%}
        <div class="sw-stat" {{ block.shopify_attributes }}><div class="sw-stat__num">{{ block.settings.number }}</div><div class="sw-stat__label">{{ block.settings.label }}</div></div>
        {%- endfor -%}
      </div>
    </div>
    <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:1;background:var(--sw-black)"></div>{%- endif -%}</div>
  </div>
</div>
{% schema %}
{"name":"SW Culture","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE MOVEMENT"},{"type":"text","id":"heading","label":"Heading","default":"BORN ON THE STREETS"},{"type":"textarea","id":"body","label":"Body","default":"Every piece is designed for the culture — from underground skate parks to global fashion weeks. No compromise."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"50K+"},{"type":"text","id":"label","label":"Label","default":"Community"}]}],"presets":[{"name":"SW Culture","blocks":[{"type":"stat","settings":{"number":"50K+","label":"Community"}},{"type":"stat","settings":{"number":"200+","label":"Drops"}},{"type":"stat","settings":{"number":"15","label":"Countries"}},{"type":"stat","settings":{"number":"100%","label":"Authentic"}}]}]}
{% endschema %}
