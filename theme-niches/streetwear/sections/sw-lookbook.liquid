<div style="background:#000000; padding:120px 24px; border-top:4px solid #FF3300; position:relative;">
  
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:80px; border-bottom:4px solid #333333; padding-bottom:24px;">
      <h2 style="font-family:'Space Grotesk', sans-serif; font-size:clamp(40px, 6vw, 80px); font-weight:700; color:#FFFFFF; margin:0; text-transform:uppercase; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
      <div style="font-family:'Space Grotesk', sans-serif; font-size:24px; font-weight:700; color:#FF3300;">
        [VOL. 1]
      </div>
    </div>

    <!-- Editorial Layout -->
    <div style="display:grid; grid-template-columns:repeat(12, 1fr); gap:20px; align-items:center;">
      
      <!-- Large Image -->
      <div style="grid-column:1 / 8; position:relative; overflow:hidden; border:4px solid #333333; aspect-ratio:4/3;" class="sw-lb-img-wrap">
        <img src="https://images.unsplash.com/photo-1550614000-4b95dd012eee?auto=format&fit=crop&w=1200&q=80" alt="Lookbook 1" style="width:100%; height:100%; object-fit:cover; filter:contrast(120%) grayscale(50%); transition:all 0.5s ease;" class="sw-lb-img" loading="lazy">
        <div style="position:absolute; top:20px; left:20px; background:#FF3300; color:#000000; font-family:'Space Grotesk', sans-serif; font-size:16px; font-weight:700; padding:8px 16px;">FIG. 01</div>
      </div>
      
      <!-- Small Images -->
      <div style="grid-column:8 / 13; display:grid; grid-template-rows:repeat(2, 1fr); gap:20px; height:100%;">
        
        <div style="position:relative; overflow:hidden; border:4px solid #333333;" class="sw-lb-img-wrap">
          <img src="https://images.unsplash.com/photo-1576566588028-4147f3842f27?auto=format&fit=crop&w=800&q=80" alt="Lookbook 2" style="width:100%; height:100%; object-fit:cover; filter:contrast(120%) grayscale(50%); transition:all 0.5s ease;" class="sw-lb-img" loading="lazy">
          <div style="position:absolute; top:20px; right:20px; background:#FFFFFF; color:#000000; font-family:'Space Grotesk', sans-serif; font-size:14px; font-weight:700; padding:4px 8px;">FIG. 02</div>
        </div>
        
        <div style="position:relative; overflow:hidden; border:4px solid #333333;" class="sw-lb-img-wrap">
          <img src="https://images.unsplash.com/photo-1523398002811-999aa8d9f1ab?auto=format&fit=crop&w=800&q=80" alt="Lookbook 3" style="width:100%; height:100%; object-fit:cover; filter:contrast(120%) grayscale(50%); transition:all 0.5s ease;" class="sw-lb-img" loading="lazy">
          <div style="position:absolute; bottom:20px; left:20px; background:#FFFFFF; color:#000000; font-family:'Space Grotesk', sans-serif; font-size:14px; font-weight:700; padding:4px 8px;">FIG. 03</div>
        </div>
        
      </div>
      
    </div>

  </div>

  <style>
    .sw-lb-img-wrap:hover { border-color: #FF3300; }
    .sw-lb-img-wrap:hover .sw-lb-img { filter: contrast(100%) grayscale(0%); transform: scale(1.05); }
    
    @media (max-width: 990px) {
      div[style*="grid-template-columns:repeat(12, 1fr)"] { display: flex !important; flex-direction: column !important; }
      div[style*="grid-column:1 / 8"] { width: 100% !important; margin-bottom: 20px; }
      div[style*="grid-column:8 / 13"] { width: 100% !important; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr; height: auto !important; aspect-ratio: 2/1; }
    }
    @media (max-width: 640px) {
      div[style*="grid-column:8 / 13"] { display: flex !important; flex-direction: column !important; aspect-ratio: auto; }
      div[style*="grid-column:8 / 13"] > div { aspect-ratio: 1; margin-bottom: 20px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Streetwear Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "EDITORIAL_01"
    }
  ],
  "presets": [
    {
      "name": "Streetwear Lookbook"
    }
  ]
}
{% endschema %}
