<div style="background:#0f172a; padding:100px 24px; border-top:1px solid rgba(255,255,255,0.05);">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px;">
      <div>
        <div style="display:inline-block; font-family:'Inter', sans-serif; font-size:14px; font-weight:800; letter-spacing:2px; text-transform:uppercase; color:#38bdf8; margin-bottom:16px;">
          {{ section.settings.eyebrow }}
        </div>
        <h2 style="font-family:'Inter', sans-serif; font-size:clamp(32px, 5vw, 48px); font-weight:900; color:#f8fafc; margin:0; line-height:1; letter-spacing:-1px; text-transform:uppercase;">
          {{ section.settings.heading }}
        </h2>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Inter', sans-serif; font-size:14px; font-weight:800; color:#38bdf8; text-decoration:none; text-transform:uppercase; letter-spacing:1px; display:flex; align-items:center; gap:8px;" class="fw-link-accent">
          {{ section.settings.cta_label }}
          <svg style="width:20px; height:20px; fill:currentColor;" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="square" fill="none"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="fw-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:24px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1608231387042-66d1773070a5?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1606107557195-0e29a4b5b4aa?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1551107696-a4b0c5a0d9a2?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="fw-product-card" style="position:relative; background:#1e293b; border-radius:8px; padding:20px; transition:transform 0.3s ease, box-shadow 0.3s ease;">
          <a href="#" style="display:block; text-decoration:none; position:relative; margin-bottom:20px;">
            <div style="background:#0f172a; border-radius:8px; padding:30px; position:relative; overflow:hidden; display:flex; align-items:center; justify-content:center; aspect-ratio:1/1;">
              <div style="position:absolute; width:150px; height:150px; background:rgba(56,189,248,0.1); border-radius:50%; filter:blur(20px);"></div>
              <img src="{{ img_url }}" alt="Solera Product" style="position:relative; width:100%; height:auto; object-fit:contain; transform:rotate(-15deg); transition:transform 0.5s ease;" class="fw-product-img" loading="lazy">
            </div>
            
            <div style="position:absolute; top:12px; left:12px; background:rgba(15,23,42,0.8); color:#38bdf8; font-family:'Inter', sans-serif; font-size:11px; font-weight:800; padding:4px 8px; border-radius:4px; border:1px solid rgba(56,189,248,0.3); text-transform:uppercase; backdrop-filter:blur(4px);">
              NEW COLORWAY
            </div>
          </a>
          
          <div>
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
              <h3 style="font-family:'Inter', sans-serif; font-size:18px; font-weight:900; color:#f8fafc; margin:0; text-transform:uppercase;">
                {% if idx == 1 %}DEFT 2.0 / CRIMSON{% elsif idx == 2 %}AERO ELITE{% elsif idx == 3 %}TRAIL BLAZER X{% else %}VELOCITY FLY{% endif %}
              </h3>
              <div style="font-family:'Inter', sans-serif; font-size:18px; font-weight:800; color:#38bdf8;">
                {% if idx == 1 %}$180{% elsif idx == 2 %}$220{% elsif idx == 3 %}$160{% else %}$150{% endif %}
              </div>
            </div>
            <div style="font-family:'Inter', sans-serif; font-size:14px; font-weight:500; color:#94a3b8; margin-bottom:16px;">
              {% if idx == 1 %}Men's Running Shoe{% elsif idx == 2 %}Men's Training Shoe{% elsif idx == 3 %}Trail Running Shoe{% else %}Unisex Racing Shoe{% endif %}
            </div>
            
            <div style="display:flex; gap:8px;">
              <div style="width:24px; height:24px; border-radius:50%; background:#ef4444; border:2px solid #f8fafc; cursor:pointer;"></div>
              <div style="width:24px; height:24px; border-radius:50%; background:#10b981; cursor:pointer;"></div>
              <div style="width:24px; height:24px; border-radius:50%; background:#3b82f6; cursor:pointer;"></div>
              <div style="font-family:'Inter', sans-serif; font-size:12px; font-weight:800; color:#94a3b8; display:flex; align-items:center; margin-left:4px;">+2</div>
            </div>
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .fw-product-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.5), 0 0 0 1px rgba(56,189,248,0.3); }
    .fw-product-card:hover .fw-product-img { transform: rotate(0deg) scale(1.1); }
    .fw-link-accent:hover { text-shadow: 0 0 10px rgba(56,189,248,0.5); }
    
    @media (max-width: 1024px) {
      .fw-product-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
    @media (max-width: 640px) {
      .fw-product-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Footwear Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LATEST DROPS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP NEW RELEASES"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Footwear Collection"
    }
  ]
}
{% endschema %}
