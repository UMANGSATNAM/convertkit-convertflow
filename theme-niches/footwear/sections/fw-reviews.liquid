<div style="background:#1e293b; padding:100px 24px; position:relative;">
  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div style="text-align:center; margin-bottom:60px;">
      <h2 style="font-family:'Inter', sans-serif; font-size:clamp(32px, 5vw, 48px); font-weight:900; color:#f8fafc; margin:0; line-height:1; letter-spacing:-1px; text-transform:uppercase;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="fw-reviews-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:24px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#0f172a; padding:40px; border-radius:8px; border:1px solid rgba(56,189,248,0.1); position:relative; transition:transform 0.3s ease;">
          
          <div style="display:flex; gap:4px; margin-bottom:24px;">
            <svg style="width:20px; height:20px; fill:#38bdf8;" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg style="width:20px; height:20px; fill:#38bdf8;" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg style="width:20px; height:20px; fill:#38bdf8;" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg style="width:20px; height:20px; fill:#38bdf8;" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg style="width:20px; height:20px; fill:#38bdf8;" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          </div>
          
          <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:500; line-height:1.6; color:#f8fafc; margin-bottom:32px;">
            "{{ block.settings.quote }}"
          </p>
          
          <div style="display:flex; align-items:center; gap:16px;">
            <div style="width:48px; height:48px; border-radius:50%; background:#38bdf8; display:flex; align-items:center; justify-content:center; font-family:'Inter', sans-serif; font-weight:900; color:#0f172a;">
              {{ block.settings.name | slice: 0 }}
            </div>
            <div>
              <div style="font-family:'Inter', sans-serif; font-size:14px; font-weight:800; color:#f8fafc; text-transform:uppercase;">{{ block.settings.name }}</div>
              <div style="font-family:'Inter', sans-serif; font-size:12px; font-weight:500; color:#94a3b8;">{{ block.settings.title }}</div>
            </div>
          </div>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .fw-reviews-grid > div:hover { transform: translateY(-5px); border-color: rgba(56,189,248,0.5); box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    @media (max-width: 990px) {
      .fw-reviews-grid { grid-template-columns: 1fr; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Athlete Feedback",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ATHLETE FEEDBACK"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The energy return is incredible."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "SARAH JENKINS"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Marathoner"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Athlete Feedback",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
