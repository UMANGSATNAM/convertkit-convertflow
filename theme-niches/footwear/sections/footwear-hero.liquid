{% style %}
.footwear-hero {
  min-height: 92vh;
  background: #F0E6D3;
  display: grid;
  grid-template-columns: 1fr 1fr;
  overflow: hidden;
}
.footwear-hero__left {
  padding: 100px 80px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.footwear-hero__overline {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: #C65D2A;
  margin-bottom: 24px;
}
.footwear-hero__heading {
  font-size: clamp(40px, 5vw, 80px);
  line-height: 1;
  font-weight: 800;
  color: #1C1510;
  margin-bottom: 28px;
  font-family: var(--f-heading);
}
.footwear-hero__heading em {
  font-style: italic;
  color: #C65D2A;
}
.footwear-hero__text {
  font-size: 17px;
  color: #8A7A6A;
  line-height: 1.8;
  max-width: 420px;
  margin-bottom: 48px;
  font-weight: 300;
}
.footwear-hero__btns {
  display: flex;
  gap: 16px;
}
.footwear-hero__btn-primary {
  background: #C65D2A;
  color: #fff;
  padding: 18px 44px;
  font-family: var(--f-heading);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 1px;
  text-decoration: none;
  transition: opacity 0.2s;
  display: inline-block;
  border-radius: var(--radius);
}
.footwear-hero__btn-primary:hover {
  opacity: 0.9;
}
.footwear-hero__btn-outline {
  background: transparent;
  color: #1C1510;
  border: 1.5px solid #1C1510;
  padding: 17px 44px;
  font-family: var(--f-heading);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 1px;
  text-decoration: none;
  transition: all 0.2s;
  display: inline-block;
  border-radius: var(--radius);
}
.footwear-hero__btn-outline:hover {
  background: #1C1510;
  color: #fff;
}
.footwear-hero__right {
  background: #1C1510;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.footwear-hero__right::after {
  content: '';
  position: absolute;
  width: 400px;
  height: 400px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.05);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
.footwear-hero__right img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: relative;
  z-index: 10;
}
.footwear-hero__right svg {
  width: 60%;
  color: rgba(198, 93, 42, 0.3);
  position: relative;
  z-index: 10;
}

@media (max-width: 1024px) {
  .footwear-hero { grid-template-columns: 1fr; min-height: auto; }
  .footwear-hero__right { display: none; }
}
@media (max-width: 768px) {
  .footwear-hero__left { padding: 60px 20px; }
  .footwear-hero__heading { font-size: 52px; }
}
{% endstyle %}

<section class="footwear-hero">
  <div class="footwear-hero__left">
    {%- if section.settings.overline != blank -%}
      <span class="footwear-hero__overline">{{ section.settings.overline }}</span>
    {%- endif -%}
    <h1 class="footwear-hero__heading">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="footwear-hero__text">{{ section.settings.text }}</p>
    {%- endif -%}
    <div class="footwear-hero__btns">
      {%- if section.settings.btn1_text != blank -%}
        <a href="{{ section.settings.btn1_url }}" class="footwear-hero__btn-primary">{{ section.settings.btn1_text }}</a>
      {%- endif -%}
      {%- if section.settings.btn2_text != blank -%}
        <a href="{{ section.settings.btn2_url }}" class="footwear-hero__btn-outline">{{ section.settings.btn2_text }}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="footwear-hero__right">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="Footwear Hero" loading="eager">
    {%- else -%}
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width=".8"><path d="M21.5 15.5c-1.1 1.1-3.1 1.5-5.5 1.5H4a2 2 0 01-2-2v-1c0-.6.1-1.2.4-1.7L6 7.5V7a2 2 0 012-2h2.5L14 9l2-1.5 2.5 1 1.5 3.5-1 1.5 2.5 2z"/></svg>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Footwear Hero",
  "settings": [
    { "type": "text", "id": "overline", "label": "Overline", "default": "SS 2025 — The Ground Collection" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Walk with <em>Purpose</em>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Footwear built for the unscripted journey." },
    { "type": "text", "id": "btn1_text", "label": "Primary Button", "default": "Shop Collection" },
    { "type": "url", "id": "btn1_url", "label": "Primary URL" },
    { "type": "text", "id": "btn2_text", "label": "Secondary Button", "default": "Find Your Size" },
    { "type": "url", "id": "btn2_url", "label": "Secondary URL" },
    { "type": "image_picker", "id": "image", "label": "Right Side Image" }
  ],
  "presets": [{ "name": "Footwear Hero" }]
}
{% endschema %}
