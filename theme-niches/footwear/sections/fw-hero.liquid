<div style="background:#0f172a; position:relative; overflow:hidden; min-height:85vh; display:flex; align-items:center;">
  
  <div style="position:absolute; inset:0; z-index:1;">
    <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=1600&q=80" alt="Hero Background" style="width:100%; height:100%; object-fit:cover; opacity:0.4;" class="fw-hero-img" loading="eager">
    <!-- Neon glow effect -->
    <div style="position:absolute; inset:0; background:radial-gradient(circle at 70% 50%, rgba(56, 189, 248, 0.15) 0%, transparent 50%);"></div>
    <div style="position:absolute; inset:0; background:linear-gradient(to right, rgba(15, 23, 42, 1) 0%, rgba(15, 23, 42, 0.6) 50%, rgba(15, 23, 42, 0.2) 100%);"></div>
  </div>

  <div style="max-width:1440px; margin:0 auto; width:100%; padding:40px 24px; position:relative; z-index:2; display:flex; align-items:center;">
    <div style="max-width:600px;">
      
      <div style="display:inline-block; font-family:'Inter', sans-serif; font-size:14px; font-weight:800; letter-spacing:2px; text-transform:uppercase; color:#38bdf8; margin-bottom:24px; position:relative;">
        <span style="display:inline-block; width:40px; height:2px; background:#38bdf8; vertical-align:middle; margin-right:12px; box-shadow:0 0 10px rgba(56,189,248,0.8);"></span>
        {{ section.settings.eyebrow }}
      </div>

      <h1 style="font-family:'Inter', sans-serif; font-size:clamp(60px, 8vw, 120px); font-weight:900; line-height:0.9; letter-spacing:-2px; color:#f8fafc; margin:0 0 24px 0; text-transform:uppercase; text-shadow:0 0 40px rgba(56,189,248,0.2);">
        {{ section.settings.heading }}
      </h1>
      
      <p style="font-family:'Inter', sans-serif; font-size:clamp(16px, 2vw, 20px); font-weight:500; color:#cbd5e1; line-height:1.6; margin:0 0 40px 0; max-width:480px;">
        {{ section.settings.subheading }}
      </p>

      <div class="fw-hero-actions" style="display:flex; gap:16px; align-items:center;">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#38bdf8; color:#0f172a; font-family:'Inter', sans-serif; font-size:15px; font-weight:800; letter-spacing:1px; text-transform:uppercase; text-decoration:none; padding:18px 40px; border-radius:4px; box-shadow:0 0 20px rgba(56,189,248,0.4); transition:all 0.3s ease;" class="fw-btn-primary">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
        
        {%- if section.settings.cta_label_2 != blank -%}
          <a href="{{ section.settings.cta_url_2 | default: '/pages/technology' }}" style="display:inline-flex; align-items:center; justify-content:center; background:transparent; color:#f8fafc; font-family:'Inter', sans-serif; font-size:15px; font-weight:800; letter-spacing:1px; text-transform:uppercase; text-decoration:none; padding:18px 40px; border:2px solid rgba(248,250,252,0.2); border-radius:4px; transition:all 0.3s ease;" class="fw-btn-secondary">
            {{ section.settings.cta_label_2 }}
          </a>
        {%- endif -%}
      </div>
      
    </div>
  </div>

  <!-- Decorative elements -->
  <div style="position:absolute; right:40px; bottom:40px; font-family:'Inter', sans-serif; font-size:12px; font-weight:800; color:rgba(248,250,252,0.3); letter-spacing:4px; transform:rotate(-90deg); transform-origin:bottom right; z-index:2; text-transform:uppercase;">
    SYS_01 // ACTIVE
  </div>

  <style>
    .fw-btn-primary:hover { background: #f8fafc; box-shadow: 0 0 30px rgba(248,250,252,0.6); transform: translateY(-2px); }
    .fw-btn-secondary:hover { border-color: #f8fafc; background: rgba(248,250,252,0.1); transform: translateY(-2px); }
    
    @media (max-width: 768px) {
      .fw-hero-actions { flex-direction: column; width: 100%; align-items: stretch; }
      .fw-btn-primary, .fw-btn-secondary { width: 100%; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Footwear Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NEXT GEN PERFORMANCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "DEFT 2.0"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Engineered for explosive speed and unprecedented energy return."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary Button Label",
      "default": "SHOP DEFT 2.0"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "cta_label_2",
      "label": "Secondary Button Label",
      "default": "EXPLORE TECH"
    },
    {
      "type": "url",
      "id": "cta_url_2",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Footwear Hero"
    }
  ]
}
{% endschema %}
