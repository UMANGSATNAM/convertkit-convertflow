<div style="background:#0f172a; padding:120px 24px; position:relative; overflow:hidden;">
  
  <!-- Abstract tech background -->
  <div style="position:absolute; right:-10%; top:-20%; width:60%; height:140%; background:radial-gradient(ellipse at center, rgba(56,189,248,0.1) 0%, transparent 70%); transform:rotate(-15deg);"></div>
  <svg width="100%" height="100%" style="position:absolute; inset:0; opacity:0.05; pointer-events:none;">
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#38bdf8" stroke-width="1"/>
    </pattern>
    <rect width="100%" height="100%" fill="url(#grid)" />
  </svg>

  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    <div class="fw-tech-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
      
      <!-- Tech visual -->
      <div style="position:relative; min-height:500px; display:flex; align-items:center; justify-content:center;">
        <div style="position:absolute; width:400px; height:400px; border-radius:50%; border:1px solid rgba(56,189,248,0.3); animation:pulse 4s infinite;"></div>
        <div style="position:absolute; width:300px; height:300px; border-radius:50%; border:1px dashed rgba(56,189,248,0.5); animation:spin 20s linear infinite;"></div>
        
        <img src="https://images.unsplash.com/photo-1608231387042-66d1773070a5?auto=format&fit=crop&w=800&q=80" alt="Technology" style="width:100%; max-width:600px; object-fit:contain; filter:drop-shadow(0 20px 40px rgba(0,0,0,0.5)); transform:rotate(-15deg); position:relative; z-index:10;" class="fw-floating-shoe">
        
        <!-- Hotspots -->
        <div class="hotspot" style="position:absolute; top:30%; left:20%; z-index:11;">
          <div style="width:12px; height:12px; background:#38bdf8; border-radius:50%; box-shadow:0 0 10px #38bdf8; cursor:pointer;" title="Breathable Mesh"></div>
          <svg style="position:absolute; top:6px; left:12px; width:100px; height:2px;"><line x1="0" y1="0" x2="100" y2="0" stroke="#38bdf8" stroke-width="2"/></svg>
          <div style="position:absolute; top:-10px; left:120px; color:#f8fafc; font-family:'Inter', sans-serif; font-size:12px; font-weight:800; white-space:nowrap; text-transform:uppercase;">Engineered Upper</div>
        </div>
        
        <div class="hotspot" style="position:absolute; bottom:30%; right:20%; z-index:11;">
          <div style="width:12px; height:12px; background:#38bdf8; border-radius:50%; box-shadow:0 0 10px #38bdf8; cursor:pointer;" title="Energy Return"></div>
          <svg style="position:absolute; top:6px; right:12px; width:100px; height:2px;"><line x1="100" y1="0" x2="0" y2="0" stroke="#38bdf8" stroke-width="2"/></svg>
          <div style="position:absolute; top:-10px; right:120px; color:#f8fafc; font-family:'Inter', sans-serif; font-size:12px; font-weight:800; white-space:nowrap; text-transform:uppercase;">AeroFoam™ Midsole</div>
        </div>
      </div>
      
      <!-- Tech content -->
      <div style="color:#f8fafc;">
        <div style="display:inline-block; font-family:'Inter', sans-serif; font-size:14px; font-weight:800; letter-spacing:2px; text-transform:uppercase; color:#38bdf8; margin-bottom:24px; position:relative;">
          <span style="display:inline-block; width:40px; height:2px; background:#38bdf8; vertical-align:middle; margin-right:12px;"></span>
          {{ section.settings.eyebrow }}
        </div>
        
        <h2 style="font-family:'Inter', sans-serif; font-size:clamp(40px, 5vw, 64px); font-weight:900; line-height:1; letter-spacing:-1px; margin:0 0 32px 0; text-transform:uppercase;">
          {{ section.settings.heading }}
        </h2>
        
        <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:500; line-height:1.6; color:#94a3b8; margin-bottom:40px;">
          {{ section.settings.body }}
        </p>
        
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-bottom:40px; border-top:1px solid rgba(255,255,255,0.1); padding-top:24px;">
          <div>
            <div style="font-family:'Inter', sans-serif; font-size:32px; font-weight:900; color:#38bdf8;">85%</div>
            <div style="font-family:'Inter', sans-serif; font-size:12px; font-weight:800; color:#94a3b8; text-transform:uppercase; letter-spacing:1px;">Energy Return</div>
          </div>
          <div>
            <div style="font-family:'Inter', sans-serif; font-size:32px; font-weight:900; color:#38bdf8;">195g</div>
            <div style="font-family:'Inter', sans-serif; font-size:12px; font-weight:800; color:#94a3b8; text-transform:uppercase; letter-spacing:1px;">Ultra Lightweight</div>
          </div>
        </div>
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/pages/technology' }}" style="display:inline-flex; align-items:center; background:rgba(56,189,248,0.1); color:#38bdf8; font-family:'Inter', sans-serif; font-size:14px; font-weight:800; letter-spacing:1px; text-transform:uppercase; text-decoration:none; padding:16px 32px; border:1px solid rgba(56,189,248,0.5); border-radius:4px; transition:all 0.3s ease;" class="fw-tech-btn">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
      
    </div>
  </div>

  <style>
    @keyframes pulse { 0% { transform: scale(0.95); opacity: 0.5; } 50% { transform: scale(1.05); opacity: 0.2; } 100% { transform: scale(0.95); opacity: 0.5; } }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    @keyframes float { 0% { transform: translateY(0) rotate(-15deg); } 50% { transform: translateY(-20px) rotate(-12deg); } 100% { transform: translateY(0) rotate(-15deg); } }
    
    .fw-floating-shoe { animation: float 6s ease-in-out infinite; }
    .fw-tech-btn:hover { background: #38bdf8; color: #0f172a; box-shadow: 0 0 20px rgba(56,189,248,0.4); }
    
    @media (max-width: 990px) {
      .fw-tech-grid { grid-template-columns: 1fr; gap: 60px; }
      .hotspot { display: none; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Footwear Technology",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SOLERA INNOVATION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AeroFoam™ Technology"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body Content",
      "default": "Our proprietary midsole compound returns 85% of energy with every step, while the carbon-fiber plate propels you forward. Lightweight. Responsive. Unstoppable."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "LEARN MORE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Footwear Technology"
    }
  ]
}
{% endschema %}
