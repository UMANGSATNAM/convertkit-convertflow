<div style="background:#38bdf8; padding:12px 0; overflow:hidden; white-space:nowrap; display:flex;">
  <div class="fw-marquee-track" style="display:inline-block; animation: fw-marquee 15s linear infinite; white-space:nowrap;">
    {%- assign marquee_text = section.settings.text | default: "BREAK YOUR RECORDS // MAXIMUM CUSHIONING // ELITE PERFORMANCE //" -%}
    <span style="font-family:'Inter', sans-serif; font-size:16px; font-weight:900; color:#0f172a; text-transform:uppercase; padding-right:24px; letter-spacing:1px;">
      {{ marquee_text }}
    </span>
    <span style="font-family:'Inter', sans-serif; font-size:16px; font-weight:900; color:#0f172a; text-transform:uppercase; padding-right:24px; letter-spacing:1px;">
      {{ marquee_text }}
    </span>
    <span style="font-family:'Inter', sans-serif; font-size:16px; font-weight:900; color:#0f172a; text-transform:uppercase; padding-right:24px; letter-spacing:1px;">
      {{ marquee_text }}
    </span>
    <span style="font-family:'Inter', sans-serif; font-size:16px; font-weight:900; color:#0f172a; text-transform:uppercase; padding-right:24px; letter-spacing:1px;">
      {{ marquee_text }}
    </span>
    <span style="font-family:'Inter', sans-serif; font-size:16px; font-weight:900; color:#0f172a; text-transform:uppercase; padding-right:24px; letter-spacing:1px;">
      {{ marquee_text }}
    </span>
  </div>
  
  <style>
    @keyframes fw-marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
  </style>
</div>

{% schema %}
{
  "name": "Footwear Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Marquee Text",
      "default": "BREAK YOUR RECORDS // MAXIMUM CUSHIONING // ELITE PERFORMANCE //"
    }
  ],
  "presets": [
    {
      "name": "Footwear Marquee"
    }
  ]
}
{% endschema %}
