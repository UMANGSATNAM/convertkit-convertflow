<div style="background:#0f172a; padding:100px 24px; position:relative;">
  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div class="fw-featured-grid" style="display:grid; grid-template-columns:1.5fr 1fr; gap:60px; align-items:center;">
      
      <!-- Visuals -->
      <div style="position:relative;">
        <div style="position:absolute; inset:10%; background:linear-gradient(135deg, rgba(56,189,248,0.2) 0%, transparent 100%); border-radius:50%; filter:blur(40px);"></div>
        <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=1200&q=80" alt="Featured Shoe" style="width:100%; height:auto; object-fit:contain; filter:drop-shadow(0 30px 60px rgba(0,0,0,0.6)); position:relative; z-index:2;" loading="lazy">
        
        <!-- Specs overlay -->
        <div style="position:absolute; top:20px; left:20px; background:rgba(15,23,42,0.8); border:1px solid rgba(56,189,248,0.3); padding:16px; border-radius:8px; backdrop-filter:blur(4px); z-index:3;" class="fw-spec-box">
          <div style="font-family:'Inter', sans-serif; font-size:10px; font-weight:800; color:#38bdf8; text-transform:uppercase; letter-spacing:1px; margin-bottom:4px;">DROP</div>
          <div style="font-family:'Inter', sans-serif; font-size:18px; font-weight:900; color:#f8fafc;">8mm</div>
        </div>
        
        <div style="position:absolute; bottom:20px; right:20px; background:rgba(15,23,42,0.8); border:1px solid rgba(56,189,248,0.3); padding:16px; border-radius:8px; backdrop-filter:blur(4px); z-index:3; text-align:right;" class="fw-spec-box">
          <div style="font-family:'Inter', sans-serif; font-size:10px; font-weight:800; color:#38bdf8; text-transform:uppercase; letter-spacing:1px; margin-bottom:4px;">WEIGHT</div>
          <div style="font-family:'Inter', sans-serif; font-size:18px; font-weight:900; color:#f8fafc;">195g</div>
        </div>
      </div>
      
      <!-- Content -->
      <div>
        <div style="display:inline-block; font-family:'Inter', sans-serif; font-size:14px; font-weight:800; letter-spacing:2px; text-transform:uppercase; color:#38bdf8; margin-bottom:16px;">
          {{ section.settings.eyebrow }}
        </div>
        
        <h2 style="font-family:'Inter', sans-serif; font-size:clamp(40px, 5vw, 64px); font-weight:900; line-height:1; letter-spacing:-1px; color:#f8fafc; margin:0 0 24px 0; text-transform:uppercase;">
          {{ section.settings.heading }}
        </h2>
        
        <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:500; line-height:1.6; color:#cbd5e1; margin-bottom:40px;">
          A perfect balance of cushioning and responsiveness. Engineered for daily mileage but built with race-day speed in mind.
        </p>
        
        <div style="display:flex; gap:16px;">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_url | default: '/collections/mens' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#f8fafc; color:#0f172a; font-family:'Inter', sans-serif; font-size:14px; font-weight:800; letter-spacing:1px; text-transform:uppercase; text-decoration:none; padding:16px 32px; border-radius:4px; transition:all 0.3s ease;" class="fw-btn-light">
              {{ section.settings.cta_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.cta_label_2 != blank -%}
            <a href="{{ section.settings.cta_url_2 | default: '/collections/womens' }}" style="display:inline-flex; align-items:center; justify-content:center; background:rgba(248,250,252,0.1); color:#f8fafc; font-family:'Inter', sans-serif; font-size:14px; font-weight:800; letter-spacing:1px; text-transform:uppercase; text-decoration:none; padding:16px 32px; border:2px solid rgba(248,250,252,0.2); border-radius:4px; transition:all 0.3s ease;" class="fw-btn-outline">
              {{ section.settings.cta_label_2 }}
            </a>
          {%- endif -%}
        </div>
      </div>
      
    </div>
  </div>

  <style>
    .fw-btn-light:hover { background: #38bdf8; box-shadow: 0 0 20px rgba(56,189,248,0.4); transform: translateY(-2px); }
    .fw-btn-outline:hover { border-color: #f8fafc; background: rgba(248,250,252,0.1); transform: translateY(-2px); }
    
    @media (max-width: 990px) {
      .fw-featured-grid { grid-template-columns: 1fr; gap: 40px; }
      .fw-spec-box { display: none; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Featured Shoe",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "EDITOR'S PICK"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Daily Trainer"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button 1 Label",
      "default": "SHOP MEN'S"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "cta_label_2",
      "label": "Button 2 Label",
      "default": "SHOP WOMEN'S"
    },
    {
      "type": "url",
      "id": "cta_url_2",
      "label": "Button 2 Link"
    }
  ],
  "presets": [
    {
      "name": "Featured Shoe"
    }
  ]
}
{% endschema %}
