<section class="sustain">
  <div class="s-text">
    <span class="overline">{{ section.settings.overline }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {%- if section.settings.btn_text != blank -%}
      <a href="{{ section.settings.btn_url }}" class="footwear-hero__btn-primary">{{ section.settings.btn_text }}</a>
    {%- endif -%}
  </div>
  <div class="s-pillars">
    {%- for block in section.blocks -%}
      <div class="s-pillar">
        <h4>{{ block.settings.title }}</h4>
        <p>{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Footwear Sustainability",
  "settings": [
    { "type": "text", "id": "overline", "label": "Overline", "default": "Our Commitment" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted to Last, Not to Waste" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every pair is built with materials that improve with age and processes that respect the planet." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Our Story" },
    { "type": "url", "id": "btn_url", "label": "Button URL" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Description goes here" }
      ]
    }
  ],
  "presets": [{ "name": "Footwear Sustainability", "blocks": [{"type":"pillar"},{"type":"pillar"},{"type":"pillar"},{"type":"pillar"}] }]
}
{% endschema %}
