<div style="background:#0f172a; padding:120px 24px; position:relative; overflow:hidden;">
  
  <div style="position:absolute; inset:0; z-index:1;">
    <img src="https://images.unsplash.com/photo-1552346154-21d32810baa3?auto=format&fit=crop&w=1600&q=80" alt="Hype Drop" style="width:100%; height:100%; object-fit:cover; opacity:0.3; filter:grayscale(50%) contrast(1.2);" loading="lazy">
    <div style="position:absolute; inset:0; background:radial-gradient(circle at center, transparent 0%, #0f172a 80%);"></div>
  </div>

  <div style="max-width:800px; margin:0 auto; position:relative; z-index:2; text-align:center;">
    
    <div style="display:inline-block; font-family:'Inter', sans-serif; font-size:14px; font-weight:800; letter-spacing:4px; text-transform:uppercase; color:#38bdf8; margin-bottom:24px; padding:8px 16px; border:1px solid rgba(56,189,248,0.3); background:rgba(15,23,42,0.8); backdrop-filter:blur(4px); box-shadow:0 0 20px rgba(56,189,248,0.2);">
      {{ section.settings.eyebrow }}
    </div>

    <h2 style="font-family:'Inter', sans-serif; font-size:clamp(40px, 6vw, 80px); font-weight:900; line-height:1; letter-spacing:-2px; color:#f8fafc; margin:0 0 24px 0; text-transform:uppercase; text-shadow:0 0 40px rgba(248,250,252,0.3);">
      {{ section.settings.heading }}
    </h2>
    
    <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:500; color:#cbd5e1; margin:0 auto 48px auto; max-width:500px;">
      {{ section.settings.subheading }}
    </p>

    <!-- Countdown Timer -->
    <div style="display:flex; justify-content:center; gap:clamp(12px, 3vw, 32px); margin-bottom:48px;">
      <div style="background:rgba(15,23,42,0.8); border:1px solid rgba(56,189,248,0.3); padding:clamp(16px, 3vw, 24px); border-radius:8px; min-width:clamp(80px, 15vw, 120px); backdrop-filter:blur(8px);">
        <div style="font-family:'Inter', sans-serif; font-size:clamp(32px, 5vw, 48px); font-weight:900; color:#38bdf8; line-height:1; margin-bottom:8px;">03</div>
        <div style="font-family:'Inter', sans-serif; font-size:12px; font-weight:800; color:#94a3b8; text-transform:uppercase; letter-spacing:2px;">Days</div>
      </div>
      <div style="font-family:'Inter', sans-serif; font-size:clamp(32px, 5vw, 48px); font-weight:900; color:#38bdf8; line-height:1; padding-top:clamp(16px, 3vw, 24px);">:</div>
      <div style="background:rgba(15,23,42,0.8); border:1px solid rgba(56,189,248,0.3); padding:clamp(16px, 3vw, 24px); border-radius:8px; min-width:clamp(80px, 15vw, 120px); backdrop-filter:blur(8px);">
        <div style="font-family:'Inter', sans-serif; font-size:clamp(32px, 5vw, 48px); font-weight:900; color:#38bdf8; line-height:1; margin-bottom:8px;">14</div>
        <div style="font-family:'Inter', sans-serif; font-size:12px; font-weight:800; color:#94a3b8; text-transform:uppercase; letter-spacing:2px;">Hours</div>
      </div>
      <div style="font-family:'Inter', sans-serif; font-size:clamp(32px, 5vw, 48px); font-weight:900; color:#38bdf8; line-height:1; padding-top:clamp(16px, 3vw, 24px);">:</div>
      <div style="background:rgba(15,23,42,0.8); border:1px solid rgba(56,189,248,0.3); padding:clamp(16px, 3vw, 24px); border-radius:8px; min-width:clamp(80px, 15vw, 120px); backdrop-filter:blur(8px);">
        <div style="font-family:'Inter', sans-serif; font-size:clamp(32px, 5vw, 48px); font-weight:900; color:#38bdf8; line-height:1; margin-bottom:8px;">59</div>
        <div style="font-family:'Inter', sans-serif; font-size:12px; font-weight:800; color:#94a3b8; text-transform:uppercase; letter-spacing:2px;">Mins</div>
      </div>
    </div>
    
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '#' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#f8fafc; color:#0f172a; font-family:'Inter', sans-serif; font-size:16px; font-weight:900; letter-spacing:1px; text-transform:uppercase; text-decoration:none; padding:20px 48px; border-radius:4px; box-shadow:0 0 30px rgba(248,250,252,0.2); transition:all 0.3s ease;" class="fw-countdown-btn">
        {{ section.settings.cta_label }}
      </a>
    {%- endif -%}

  </div>

  <style>
    .fw-countdown-btn:hover { background: #38bdf8; box-shadow: 0 0 40px rgba(56,189,248,0.6); transform: scale(1.05); }
  </style>
</div>

{% schema %}
{
  "name": "Hype Drop Countdown",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "UPCOMING DROP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NIGHTHAWK EDITION"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Limited quantities. Members get early access."
    },
    {
      "type": "text",
      "id": "date",
      "label": "Target Date (ISO 8601)",
      "default": "2026-10-31T00:00:00Z"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "NOTIFY ME"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hype Drop Countdown"
    }
  ]
}
{% endschema %}
