<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="kt-section-header"><span class="kt-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="kt-review-grid">{%- for block in section.blocks -%}<div class="kt-review-card" {{ block.shopify_attributes }}><div class="kt-review-card__stars">★★★★★</div><div class="kt-review-card__text">"{{ block.settings.quote }}"</div><div class="kt-review-card__author">{{ block.settings.name }}</div><div class="kt-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Toys Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PARENT DIARIES"},{"type":"text","id":"heading","label":"Heading","default":"Testimonials of Play"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Toys Reviews","blocks":[{"type":"review","settings":{"quote":"Beautifully crafted blocks. My toddler spends hours stacking and rebuilding. Very safe.","name":"Clara M.","product":"Montessori Stacking Set"}},{"type":"review","settings":{"quote":"Smooth sand finish, zero splinters. Non-toxic dyes give me complete peace of mind.","name":"Liam P.","product":"Organic Wooden Blocks"}},{"type":"review","settings":{"quote":"The knit dinosaur plush is incredibly soft. My son sleeps with it every single night.","name":"Elena V.","product":"Knit Dinosaur Plush"}}]}]}
{% endschema %}
