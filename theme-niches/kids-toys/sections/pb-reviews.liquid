<div style="background:#06D6A0; padding:120px 24px; position:relative; overflow:hidden;">
  <div style="max-width:1440px; margin:0 auto; text-align:center; position:relative; z-index:2;">
    
    <div style="margin-bottom:80px;">
      <h2 style="font-family:'Nunito', sans-serif; font-size:clamp(36px, 5vw, 56px); font-weight:900; color:#FFFFFF; margin:0 0 16px 0; letter-spacing:-1px; text-shadow:4px 4px 0px #1A1A1A;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="pb-reviews-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:30px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#FFFFFF; padding:40px; border-radius:30px; border:4px solid #1A1A1A; box-shadow:8px 8px 0px #1A1A1A; text-align:left; position:relative;">
          
          <div style="display:flex; gap:4px; margin-bottom:24px;">
            <span style="font-size:24px;">⭐</span>
            <span style="font-size:24px;">⭐</span>
            <span style="font-size:24px;">⭐</span>
            <span style="font-size:24px;">⭐</span>
            <span style="font-size:24px;">⭐</span>
          </div>
          
          <p style="font-family:'Nunito', sans-serif; font-size:20px; font-weight:800; line-height:1.6; color:#1A1A1A; margin:0 0 32px 0;">
            "{{ block.settings.quote }}"
          </p>
          
          <div style="display:flex; align-items:center; gap:16px;">
            {%- assign idx = forloop.index | modulo: 3 -%}
            {%- assign avatar_bg = '#FFD166' -%}
            {%- if idx == 1 -%}{%- assign avatar_bg = '#FF6B6B' -%}{%- endif -%}
            {%- if idx == 2 -%}{%- assign avatar_bg = '#118AB2' -%}{%- endif -%}
            
            <div style="width:60px; height:60px; background:{{ avatar_bg }}; border-radius:50%; border:3px solid #1A1A1A; display:flex; align-items:center; justify-content:center; color:#FFFFFF; font-family:'Nunito', sans-serif; font-weight:900; font-size:24px;">
              {{ block.settings.name | slice: 0, 1 }}
            </div>
            <div>
              <div style="font-family:'Nunito', sans-serif; font-size:18px; font-weight:900; color:#1A1A1A;">
                {{ block.settings.name }}
              </div>
              <div style="font-family:'Nunito', sans-serif; font-size:14px; font-weight:700; color:#4A4A4A;">
                Verified Parent
              </div>
            </div>
          </div>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    @media (max-width: 990px) {
      .pb-reviews-grid { grid-template-columns: 1fr; gap: 40px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Kids Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Happy Families"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "My 4-year-old hasn't stopped playing with the castle set. Incredible quality!"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Sarah W."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kids Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
