<div style="background:#118AB2; padding:100px 24px; position:relative; overflow:hidden;">
  
  <svg style="position:absolute; top:-20%; right:-10%; width:50%; z-index:1; fill:#FFF; opacity:0.1; animation:pb-spin 30s linear infinite;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
    <path d="M48.2,-73.4C60.8,-64.8,68,-48.9,74.7,-32.8C81.4,-16.7,87.6,-0.4,85.3,14.6C82.9,29.6,72,43.2,59.3,53.6C46.6,63.9,32.2,71,16.5,75.9C0.8,80.8,-16.3,83.4,-31.6,78.8C-46.9,74.2,-60.5,62.4,-69.5,48.5C-78.5,34.6,-82.9,18.5,-82.3,2.8C-81.7,-12.9,-76.1,-28.3,-66.9,-41.2C-57.7,-54,-44.8,-64.4,-31.2,-71.8C-17.6,-79.2,-3.3,-83.6,6.3,-82.8C15.9,-82,35.6,-82,48.2,-73.4Z" transform="translate(100 100)" />
  </svg>

  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2; text-align:center;">
    
    <div style="margin-bottom:60px;">
      <h2 style="font-family:'Nunito', sans-serif; font-size:clamp(36px, 5vw, 56px); font-weight:900; color:#FFFFFF; margin:0 0 16px 0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="pb-age-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 4 }}, 1fr); gap:20px;">
      
      {%- for block in section.blocks -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign bg_color = '#FFD166' -%}
        {%- if idx == 1 -%}{%- assign bg_color = '#FFD166' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign bg_color = '#06D6A0' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign bg_color = '#EF476F' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign bg_color = '#FDFDFD' -%}{%- endif -%}
        
        <a href="#" class="pb-age-card" style="display:block; text-decoration:none; background:{{ bg_color }}; padding:40px 20px; border-radius:30px; border:4px solid #1A1A1A; box-shadow:8px 8px 0px #1A1A1A; transition:all 0.2s ease;">
          <h3 style="font-family:'Nunito', sans-serif; font-size:28px; font-weight:900; color:#1A1A1A; margin:0;">
            {{ block.settings.title }}
          </h3>
        </a>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .pb-age-card:hover { transform: translate(-4px, -4px); box-shadow: 12px 12px 0px #1A1A1A; }
    .pb-age-card:active { transform: translate(4px, 4px); box-shadow: 4px 4px 0px #1A1A1A; }
    @keyframes pb-spin { 100% { transform: rotate(360deg); } }
    
    @media (max-width: 990px) {
      .pb-age-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 480px) {
      .pb-age-grid { grid-template-columns: 1fr; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Kids Age Filter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Age"
    }
  ],
  "blocks": [
    {
      "type": "age",
      "name": "Age Group",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "0-2 Years"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kids Age Filter",
      "blocks": [
        { "type": "age" },
        { "type": "age" },
        { "type": "age" },
        { "type": "age" }
      ]
    }
  ]
}
{% endschema %}
