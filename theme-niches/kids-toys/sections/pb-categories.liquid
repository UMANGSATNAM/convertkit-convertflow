<div style="background:#FDFDFD; padding:100px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:60px;">
      <h2 style="font-family:'Nunito', sans-serif; font-size:clamp(36px, 5vw, 56px); font-weight:900; color:#1A1A1A; margin:0 0 16px 0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-family:'Nunito', sans-serif; font-size:18px; font-weight:600; color:#4A4A4A; margin:0;">Find the perfect playtime adventure.</p>
    </div>

    <div class="pb-category-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:30px;">
      
      {%- for block in section.blocks -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1513364776144-60967b0f800f?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1587654780291-39c9404d746b?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1603808033192-082d6919d3e1?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <a href="#" class="pb-cat-card" style="display:block; text-decoration:none; text-align:center; group">
          <div style="position:relative; aspect-ratio:1/1; border-radius:40px; margin-bottom:24px; padding:16px; background:{{ block.settings.color | default: '#FFD166' }}; transition:transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s;">
            <div style="width:100%; height:100%; border-radius:24px; overflow:hidden; background:#FFF; position:relative;">
              <img src="{{ img_url }}" alt="{{ block.settings.title }}" style="width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease;" class="pb-cat-img" loading="lazy">
            </div>
            <!-- Fun decoration -->
            <div style="position:absolute; top:-10px; right:-10px; width:40px; height:40px; background:#FFF; border-radius:50%; display:flex; align-items:center; justify-content:center; box-shadow:0 5px 15px rgba(0,0,0,0.1); font-size:20px;">
              {% if idx == 1 %}🧱{% elsif idx == 2 %}🎨{% elsif idx == 3 %}🦸‍♂️{% else %}🧩{% endif %}
            </div>
          </div>
          
          <h3 style="font-family:'Nunito', sans-serif; font-size:22px; font-weight:800; color:#1A1A1A; margin:0; transition:color 0.3s ease;" class="pb-cat-title">
            {{ block.settings.title }}
          </h3>
        </a>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .pb-cat-card:hover > div { transform: translateY(-10px) rotate(2deg); box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
    .pb-cat-card:hover .pb-cat-img { transform: scale(1.1); }
    .pb-cat-card:hover .pb-cat-title { color: #FF6B6B; }
    
    @media (max-width: 990px) {
      .pb-category-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px 20px !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Kids Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore by Play"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Building Blocks"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Background Color",
          "default": "#FFD166"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kids Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
