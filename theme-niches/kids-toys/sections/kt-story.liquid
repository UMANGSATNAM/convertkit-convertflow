<div style="padding:80px 20px;background:var(--kt-dark)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="kt-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Fredoka',sans-serif;font-size:clamp(28px,4vw,48px);font-weight:600;color:var(--kt-pastel);margin-bottom:20px;line-height:1.1">{{ section.settings.heading }}</h2>
    <p style="font-family:'Fredoka',sans-serif;font-size:16px;color:var(--kt-muted);line-height:1.7;max-width:440px">{{ section.settings.body }}</p>
    <div class="kt-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="kt-stat" style="border-color:rgba(234,227,213,0.15);background:rgba(255,255,255,0.02)" {{ block.shopify_attributes }}><div class="kt-stat__num" style="color:var(--kt-yellow)">{{ block.settings.number }}</div><div class="kt-stat__label" style="color:var(--kt-pastel)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:16px;object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:4/5;background:var(--kt-yellow);border-radius:16px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Toys Story","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"MONTESSORI CERTIFIED"},{"type":"text","id":"heading","label":"Heading","default":"100% Non-Toxic & Food Grade."},{"type":"textarea","id":"body","label":"Body","default":"Our wooden toys are colored using water-based non-toxic food-grade dyes, finished with organic coconut oils. Completely safe for toddlers to mouth."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"100%"},{"type":"text","id":"label","label":"Label","default":"Beech Wood"}]}],"presets":[{"name":"Toys Story","blocks":[{"type":"stat","settings":{"number":"100%","label":"Beech Wood"}},{"type":"stat","settings":{"number":"Food Gr.","label":"Water Dyes"}},{"type":"stat","settings":{"number":"EN71","label":"Europe Tested"}},{"type":"stat","settings":{"number":"CE","label":"Safety Cert"}}]}]}
{% endschema %}
