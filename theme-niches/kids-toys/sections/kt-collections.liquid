<div style="padding:80px 20px;background:#fff;border-bottom:1px solid var(--kt-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="kt-section-header"><span class="kt-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="kt-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="kt-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--kt-yellow)"></div>{%- endif -%}<div class="kt-col-card__overlay"><span class="kt-col-card__title">{{ block.settings.title }}</span><span class="kt-col-card__cta">Explore Play →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Toys Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PLAY VARIETIES"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Category"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Wooden Blocks"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Toys Collections","blocks":[{"type":"col","settings":{"title":"Montessori Wooden Blocks"}},{"type":"col","settings":{"title":"Cognitive Stacking Sets"}},{"type":"col","settings":{"title":"Plush Knit Companions"}}]}]}
{% endschema %}
