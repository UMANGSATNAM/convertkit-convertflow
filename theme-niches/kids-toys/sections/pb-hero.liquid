<div style="background:#FDFDFD; position:relative; overflow:hidden; min-height:85vh; display:flex; align-items:center;">
  
  <!-- Fun background blobs -->
  <svg style="position:absolute; top:-10%; right:-5%; width:40%; z-index:1; fill:#FFD166; opacity:0.3; animation:pb-float 6s ease-in-out infinite;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
    <path d="M44.7,-76.4C58.8,-69.2,71.8,-59.1,81.3,-46.3C90.8,-33.5,96.8,-18.1,96.5,-2.8C96.2,12.5,89.5,27.6,80.1,40.7C70.6,53.8,58.3,64.9,44.5,73.1C30.7,81.3,15.3,86.6,0.3,86.1C-14.7,85.6,-29.4,79.3,-42.6,70.6C-55.8,61.9,-67.4,50.8,-75.7,37.6C-84,24.4,-89,9.1,-87.3,-5.4C-85.6,-19.9,-77.2,-33.6,-66.3,-44.6C-55.4,-55.6,-42,-63.9,-28.4,-71.4C-14.8,-78.9,-1,-85.6,13.1,-82.9C27.1,-80.2,40.8,-68.2,44.7,-76.4Z" transform="translate(100 100)" />
  </svg>
  <svg style="position:absolute; bottom:-20%; left:-10%; width:50%; z-index:1; fill:#06D6A0; opacity:0.2; animation:pb-float 8s ease-in-out infinite alternate;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
    <path d="M48.2,-73.4C60.8,-64.8,68,-48.9,74.7,-32.8C81.4,-16.7,87.6,-0.4,85.3,14.6C82.9,29.6,72,43.2,59.3,53.6C46.6,63.9,32.2,71,16.5,75.9C0.8,80.8,-16.3,83.4,-31.6,78.8C-46.9,74.2,-60.5,62.4,-69.5,48.5C-78.5,34.6,-82.9,18.5,-82.3,2.8C-81.7,-12.9,-76.1,-28.3,-66.9,-41.2C-57.7,-54,-44.8,-64.4,-31.2,-71.8C-17.6,-79.2,-3.3,-83.6,6.3,-82.8C15.9,-82,35.6,-82,48.2,-73.4Z" transform="translate(100 100)" />
  </svg>

  <div style="max-width:1440px; margin:0 auto; width:100%; padding:40px 24px; position:relative; z-index:2;">
    <div class="pb-hero-grid" style="display:grid; grid-template-columns:1fr 1.1fr; gap:60px; align-items:center;">
      
      <!-- Content -->
      <div style="padding-right:40px;">
        <div style="display:inline-block; font-family:'Nunito', sans-serif; font-size:14px; font-weight:800; letter-spacing:2px; text-transform:uppercase; color:#FF6B6B; margin-bottom:24px; background:#FFF0F0; padding:8px 20px; border-radius:30px;">
          {{ section.settings.eyebrow }}
        </div>

        <h1 style="font-family:'Nunito', sans-serif; font-size:clamp(48px, 6vw, 72px); font-weight:900; line-height:1.1; color:#1A1A1A; margin:0 0 24px 0; letter-spacing:-1px;">
          {{ section.settings.heading }}
        </h1>
        
        <p style="font-family:'Nunito', sans-serif; font-size:clamp(18px, 2vw, 20px); font-weight:600; color:#4A4A4A; line-height:1.6; margin:0 0 40px 0; max-width:480px;">
          {{ section.settings.subheading }}
        </p>

        <div class="pb-hero-actions" style="display:flex; gap:20px; align-items:center;">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#FF6B6B; color:#FFFFFF; font-family:'Nunito', sans-serif; font-size:16px; font-weight:800; letter-spacing:1px; text-decoration:none; padding:18px 40px; border-radius:30px; transition:all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); box-shadow:0 10px 20px rgba(255,107,107,0.3);" class="pb-btn-primary">
              {{ section.settings.cta_label }}
            </a>
          {%- endif -%}
          
          {%- if section.settings.cta_label_2 != blank -%}
            <a href="{{ section.settings.cta_url_2 | default: '/pages/gift-guide' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#FFFFFF; color:#1A1A1A; font-family:'Nunito', sans-serif; font-size:16px; font-weight:800; letter-spacing:1px; text-decoration:none; padding:18px 40px; border-radius:30px; border:3px solid #1A1A1A; transition:all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);" class="pb-btn-secondary">
              {{ section.settings.cta_label_2 }}
            </a>
          {%- endif -%}
        </div>
      </div>
      
      <!-- Visuals -->
      <div style="position:relative; height:100%; min-height:500px; display:flex; justify-content:center; align-items:center;">
        
        <!-- Colorful arch background -->
        <div style="position:absolute; bottom:0; width:80%; height:90%; background:#118AB2; border-radius:200px 200px 0 0; z-index:1; transform:rotate(5deg);"></div>
        <div style="position:absolute; bottom:0; width:80%; height:90%; background:#FFD166; border-radius:200px 200px 0 0; z-index:2; transform:rotate(-5deg);"></div>

        <div style="position:relative; z-index:3; width:85%; height:95%; overflow:hidden; border-radius:200px 200px 40px 40px; border:8px solid #FFFFFF; box-shadow:0 30px 60px rgba(0,0,0,0.1);">
          <img src="https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?auto=format&fit=crop&w=800&q=80" alt="Kids Toys" style="width:100%; height:100%; object-fit:cover;" class="pb-hero-img" loading="eager">
        </div>
        
        <!-- Floating Fun Elements -->
        <div style="position:absolute; top:10%; right:0; z-index:4; background:#FFFFFF; padding:16px; border-radius:50%; box-shadow:0 10px 20px rgba(0,0,0,0.1); animation:pb-bounce 3s infinite;">
          <span style="font-size:24px;">🚀</span>
        </div>
        <div style="position:absolute; bottom:20%; left:0; z-index:4; background:#FFFFFF; padding:16px; border-radius:50%; box-shadow:0 10px 20px rgba(0,0,0,0.1); animation:pb-bounce 4s infinite 1s;">
          <span style="font-size:24px;">🧸</span>
        </div>
      </div>
      
    </div>
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;800;900&display=swap');
    
    .pb-btn-primary:hover { transform: translateY(-5px) scale(1.05); box-shadow: 0 15px 25px rgba(255,107,107,0.4); }
    .pb-btn-secondary:hover { transform: translateY(-5px) scale(1.05); background: #1A1A1A; color: #FFFFFF; }
    
    @keyframes pb-float { 0% { transform: translate(0, 0) rotate(0deg); } 50% { transform: translate(20px, -20px) rotate(10deg); } 100% { transform: translate(0, 0) rotate(0deg); } }
    @keyframes pb-bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }
    
    @media (max-width: 990px) {
      .pb-hero-grid { grid-template-columns: 1fr; gap: 40px; text-align: center; }
      .pb-hero-grid > div:first-child { padding-right: 0; }
      .pb-hero-actions { justify-content: center; }
      .pb-hero-grid > div:last-child { min-height: 400px; justify-content: center; }
    }
    @media (max-width: 640px) {
      .pb-hero-actions { flex-direction: column; width: 100%; align-items: stretch; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Kids Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "IMAGINATION UNLOCKED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let the Magic Begin"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover toys that inspire creativity, spark joy, and build big dreams for little hands."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary Button Label",
      "default": "SHOP NEW ARRIVALS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "cta_label_2",
      "label": "Secondary Button Label",
      "default": "FIND A GIFT"
    },
    {
      "type": "url",
      "id": "cta_url_2",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Kids Hero"
    }
  ]
}
{% endschema %}
