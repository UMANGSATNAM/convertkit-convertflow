<div style="background:#FDFDFD; padding:120px 24px; position:relative; overflow:hidden;">
  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div class="pb-featured-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
      
      <!-- Visuals -->
      <div style="position:relative; min-height:500px; display:flex; justify-content:center; align-items:center;">
        
        <div style="position:absolute; width:90%; height:90%; background:#FFD166; border-radius:50%; z-index:1;"></div>
        <div style="position:absolute; width:80%; height:80%; background:#FFF; border-radius:50%; z-index:2; border:4px dashed #FF6B6B; animation:pb-spin 30s linear infinite;"></div>
        
        <img src="https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?auto=format&fit=crop&w=800&q=80" alt="Featured Toy" style="width:75%; height:75%; object-fit:contain; position:relative; z-index:3; filter:drop-shadow(0 20px 30px rgba(0,0,0,0.15)); transition:transform 0.5s ease;" class="pb-featured-img" loading="lazy">
        
        <div style="position:absolute; bottom:10%; right:10%; background:#118AB2; color:#FFF; padding:20px; z-index:4; border-radius:50%; width:100px; height:100px; display:flex; flex-direction:column; justify-content:center; align-items:center; box-shadow:0 10px 20px rgba(17,138,178,0.3); transform:rotate(15deg);">
          <div style="font-family:'Nunito', sans-serif; font-size:24px; font-weight:900; line-height:1;">#1</div>
          <div style="font-family:'Nunito', sans-serif; font-size:12px; font-weight:800; text-transform:uppercase;">Seller</div>
        </div>
      </div>
      
      <!-- Content -->
      <div>
        <div style="display:inline-block; font-family:'Nunito', sans-serif; font-size:14px; font-weight:800; letter-spacing:2px; text-transform:uppercase; color:#EF476F; margin-bottom:24px; background:#FFF0F4; padding:8px 20px; border-radius:30px;">
          {{ section.settings.eyebrow }}
        </div>
        
        <h2 style="font-family:'Nunito', sans-serif; font-size:clamp(40px, 5vw, 64px); font-weight:900; line-height:1.1; color:#1A1A1A; margin:0 0 24px 0; letter-spacing:-1px;">
          {{ section.settings.heading }}
        </h2>
        
        <p style="font-family:'Nunito', sans-serif; font-size:20px; font-weight:600; line-height:1.6; color:#4A4A4A; margin-bottom:40px;">
          Endless possibilities in one box. Watch their imagination soar as they build towers, castles, and entirely new worlds with our award-winning wooden block set.
        </p>
        
        <div style="display:flex; flex-direction:column; gap:20px; margin-bottom:48px;">
          <div style="display:flex; align-items:center; gap:16px;">
            <div style="width:40px; height:40px; background:#E5F9F6; border-radius:50%; display:flex; align-items:center; justify-content:center;">
              <span style="font-size:20px;">🌳</span>
            </div>
            <span style="font-family:'Nunito', sans-serif; font-size:18px; font-weight:700; color:#1A1A1A;">Sustainably Sourced Wood</span>
          </div>
          <div style="display:flex; align-items:center; gap:16px;">
            <div style="width:40px; height:40px; background:#FFF5E5; border-radius:50%; display:flex; align-items:center; justify-content:center;">
              <span style="font-size:20px;">🎨</span>
            </div>
            <span style="font-family:'Nunito', sans-serif; font-size:18px; font-weight:700; color:#1A1A1A;">Non-toxic Water Based Paint</span>
          </div>
          <div style="display:flex; align-items:center; gap:16px;">
            <div style="width:40px; height:40px; background:#F0F7FA; border-radius:50%; display:flex; align-items:center; justify-content:center;">
              <span style="font-size:20px;">🧩</span>
            </div>
            <span style="font-family:'Nunito', sans-serif; font-size:18px; font-weight:700; color:#1A1A1A;">120 Unique Pieces</span>
          </div>
        </div>
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/products/mega-castle' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#FF6B6B; color:#FFFFFF; font-family:'Nunito', sans-serif; font-size:16px; font-weight:800; letter-spacing:1px; text-transform:uppercase; text-decoration:none; padding:18px 40px; border-radius:30px; transition:all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); box-shadow:0 10px 20px rgba(255,107,107,0.3);" class="pb-btn-primary">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
      
    </div>
  </div>

  <style>
    .pb-btn-primary:hover { transform: translateY(-5px) scale(1.05); box-shadow: 0 15px 25px rgba(255,107,107,0.4); }
    .pb-featured-img:hover { transform: scale(1.1) rotate(-5deg); }
    
    @media (max-width: 990px) {
      .pb-featured-grid { grid-template-columns: 1fr; gap: 60px; }
      .pb-featured-grid > div:first-child { order: 2; max-width: 500px; margin: 0 auto; }
      .pb-featured-grid > div:last-child { order: 1; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Featured Kids Toy",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "AWARD WINNING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Mega Castle Set"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "EXPLORE SET"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Featured Kids Toy"
    }
  ]
}
{% endschema %}
