<div style="background:#FFD166; padding:20px 0; overflow:hidden; display:flex;">
  
  <div class="pb-marquee-content" style="display:flex; white-space:nowrap; animation:pb-scroll 20s linear infinite; gap:20px; font-family:'Nunito', sans-serif; font-size:20px; font-weight:800; letter-spacing:1px; color:#1A1A1A;">
    <span>{{ section.settings.text }}</span>
    <span>{{ section.settings.text }}</span>
    <span>{{ section.settings.text }}</span>
    <span>{{ section.settings.text }}</span>
  </div>

  <style>
    @keyframes pb-scroll {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
  </style>
</div>

{% schema %}
{
  "name": "Kids Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Marquee Text",
      "default": "100% NON-TOXIC ✨ SUSTAINABLY MADE ✨ EDUCATIONAL FUN ✨ DURABLE DESIGN ✨ "
    }
  ],
  "presets": [
    {
      "name": "Kids Marquee"
    }
  ]
}
{% endschema %}
