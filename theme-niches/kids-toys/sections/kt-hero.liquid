<div class="kt-hero">
  <div class="kt-hero__content">
    <span class="kt-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="kt-hero__title">{{ section.settings.heading }}</h1>
    <p class="kt-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="kt-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="kt-btn kt-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="kt-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--kt-yellow)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Toys Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PLAYFUL BUBBLE DESIGNS"},{"type":"text","id":"heading","label":"Safe Organic Wooden Toys"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Made from sustainably harvested beech wood, colored with non-toxic water-based food dyes."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"EXPLORE TOYS"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"SAFETY SPECS"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Toys Hero"}]}
{% endschema %}
