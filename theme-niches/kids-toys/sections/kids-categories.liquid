{% style %}
.kids-categories {
  padding: 70px 60px;
  max-width: 1400px;
  margin: 0 auto;
}
.sec-head {
  text-align: center;
  margin-bottom: 50px;
}
.sec-head h2 {
  font-size: 44px;
  font-weight: 800;
  color: var(--text);
}
.sec-head p {
  font-size: 16px;
  color: var(--muted);
  margin-top: 8px;
}
.cat-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16px;
}
.cat-card {
  border-radius: 24px;
  padding: 28px 20px;
  text-align: center;
  text-decoration: none;
  color: var(--text);
  transition: all .3s;
  position: relative;
  overflow: hidden;
  display: block;
}
.cat-card:hover {
  transform: translateY(-6px);
}
.cat-icon {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  margin: 0 auto 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cat-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.cat-icon svg {
  width: 36px;
  stroke-width: 2;
}
.cat-name {
  font-family: 'Baloo 2', cursive;
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 4px;
}
.cat-count {
  font-size: 12px;
  color: var(--muted);
}

@media(max-width: 1024px) {
  .cat-grid { grid-template-columns: repeat(3, 1fr); }
}
@media(max-width: 768px) {
  .kids-categories { padding: 60px 20px; }
  .cat-grid { grid-template-columns: repeat(2, 1fr); }
}
{% endstyle %}

<section class="kids-categories">
  <div class="sec-head">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
  </div>
  <div class="cat-grid">
    {%- for block in section.blocks -%}
      {%- assign bg_colors = "#FFF0E0,#E8F0FF,#E8FAF7,#FFF0F0,#F0EAFF" | split: "," -%}
      {%- assign mod = forloop.index0 | modulo: 5 -%}
      {%- assign bg = bg_colors[mod] -%}
      
      <a href="{{ block.settings.url }}" class="cat-card" style="background:{{ bg }};">
        <div class="cat-icon">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 100 }}" loading="lazy">
          {%- else -%}
            <svg fill="none" stroke="var(--text)" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          {%- endif -%}
        </div>
        <div class="cat-name">{{ block.settings.title }}</div>
        <div class="cat-count">{{ block.settings.subtitle }}</div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Kids Categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "text", "id": "text", "label": "Text", "default": "Curated for every age, interest, and milestone." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "url", "id": "url", "label": "URL" },
        { "type": "image_picker", "id": "image", "label": "Image Icon" }
      ]
    }
  ],
  "presets": [{ "name": "Kids Categories" }]
}
{% endschema %}
