<div style="background:#FDFDFD; padding:100px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px;">
      <div>
        <div style="display:inline-block; font-family:'Nunito', sans-serif; font-size:14px; font-weight:800; letter-spacing:2px; text-transform:uppercase; color:#06D6A0; margin-bottom:12px;">
          {{ section.settings.eyebrow }}
        </div>
        <h2 style="font-family:'Nunito', sans-serif; font-size:clamp(32px, 4vw, 48px); font-weight:900; color:#1A1A1A; margin:0; line-height:1; letter-spacing:-1px;">
          {{ section.settings.heading }}
        </h2>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Nunito', sans-serif; font-size:16px; font-weight:800; color:#FF6B6B; text-decoration:none; text-transform:uppercase; letter-spacing:1px; display:flex; align-items:center; gap:8px;" class="pb-link-hover">
          {{ section.settings.cta_label }}
          <span style="background:#FFF0F0; border-radius:50%; width:32px; height:32px; display:flex; align-items:center; justify-content:center;">
            <svg style="width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:3;" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      {%- endif -%}
    </div>

    <div class="pb-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:30px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1513364776144-60967b0f800f?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1587654780291-39c9404d746b?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1603808033192-082d6919d3e1?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="pb-product-card" style="group">
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; border-radius:30px; padding-bottom:100%; margin-bottom:20px; background:#F5F7FA; border:3px solid transparent; transition:border-color 0.3s ease;">
            <img src="{{ img_url }}" alt="Kids Toy" style="position:absolute; inset:0; width:100%; height:100%; object-fit:contain; padding:24px; transition:transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);" class="pb-product-img" loading="lazy">
            
            <div style="position:absolute; top:16px; left:16px; background:#FFD166; color:#1A1A1A; font-family:'Nunito', sans-serif; font-size:12px; font-weight:800; letter-spacing:1px; text-transform:uppercase; padding:6px 12px; border-radius:20px; box-shadow:0 4px 10px rgba(0,0,0,0.1);">
              {% if idx == 1 %}Ages 3+{% elsif idx == 2 %}Bestseller{% else %}New{% endif %}
            </div>

            <div style="position:absolute; bottom:16px; right:16px; width:48px; height:48px; background:#FF6B6B; border-radius:50%; display:flex; align-items:center; justify-content:center; opacity:0; transform:scale(0.5); transition:all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);" class="pb-product-add">
              <svg style="width:24px; height:24px; fill:#FFFFFF;" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
            </div>
          </a>
          
          <div style="font-family:'Nunito', sans-serif; font-size:14px; font-weight:800; color:#118AB2; margin-bottom:4px; text-transform:uppercase; letter-spacing:1px;">
            {% if idx == 1 %}Building Blocks{% elsif idx == 2 %}Pretend Play{% elsif idx == 3 %}Educational{% else %}Puzzles{% endif %}
          </div>
          <h3 style="font-family:'Nunito', sans-serif; font-size:20px; font-weight:900; color:#1A1A1A; margin:0 0 8px 0;">
            {% if idx == 1 %}Mega Castle Set{% elsif idx == 2 %}Little Chef Kitchen{% elsif idx == 3 %}Wooden Animal Puzzle{% else %}Solar System Kit{% endif %}
          </h3>
          <div style="font-family:'Nunito', sans-serif; font-size:18px; font-weight:800; color:#FF6B6B;">
            {% if idx == 1 %}$89.00{% elsif idx == 2 %}$120.00{% elsif idx == 3 %}$24.00{% else %}$35.00{% endif %}
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .pb-product-card:hover > a { border-color: #06D6A0; }
    .pb-product-card:hover .pb-product-img { transform: scale(1.1) rotate(2deg); }
    .pb-product-card:hover .pb-product-add { opacity: 1; transform: scale(1); box-shadow: 0 10px 20px rgba(255,107,107,0.4); }
    .pb-link-hover:hover { opacity: 0.8; transform: translateX(5px); }
    .pb-link-hover { transition: transform 0.3s ease; }
    
    @media (max-width: 1024px) {
      .pb-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px 20px !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Kids Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAN FAVORITES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Most Loved Toys"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Kids Collection"
    }
  ]
}
{% endschema %}
