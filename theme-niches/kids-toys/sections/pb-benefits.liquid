<div style="background:#FFF0F4; padding:120px 24px; position:relative; overflow:hidden;">
  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Nunito', sans-serif; font-size:clamp(36px, 5vw, 56px); font-weight:900; color:#1A1A1A; margin:0 0 16px 0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="pb-benefits-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:40px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#FFFFFF; padding:40px; border-radius:30px; text-align:center; border:4px solid #1A1A1A; box-shadow:8px 8px 0px #1A1A1A; transition:transform 0.3s ease; position:relative; overflow:hidden;" class="pb-benefit-card">
          
          {%- assign idx = forloop.index | modulo: 3 -%}
          {%- assign bg_color = '#FFD166' -%}
          {%- if idx == 1 -%}{%- assign bg_color = '#06D6A0' -%}{%- endif -%}
          {%- if idx == 2 -%}{%- assign bg_color = '#FF6B6B' -%}{%- endif -%}
          {%- if idx == 0 -%}{%- assign bg_color = '#118AB2' -%}{%- endif -%}
          
          <div style="position:absolute; top:-20px; right:-20px; width:100px; height:100px; background:{{ bg_color }}; border-radius:50%; opacity:0.2;"></div>
          
          <div style="width:80px; height:80px; border-radius:50%; background:{{ bg_color }}; display:flex; align-items:center; justify-content:center; margin:0 auto 32px auto; font-size:40px; border:3px solid #1A1A1A;">
            {% if idx == 1 %}🛡️{% elsif idx == 2 %}🌱{% else %}🧠{% endif %}
          </div>
          
          <h3 style="font-family:'Nunito', sans-serif; font-size:24px; font-weight:900; color:#1A1A1A; margin:0 0 16px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Nunito', sans-serif; font-size:18px; font-weight:600; color:#4A4A4A; line-height:1.6; margin:0;">
            {{ block.settings.desc }}
          </p>
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .pb-benefit-card:hover { transform: translateY(-10px); }
    
    @media (max-width: 990px) {
      .pb-benefits-grid { grid-template-columns: 1fr; gap: 40px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Kids Benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Parents Love Us"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Child Safe"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Tested beyond global safety standards."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kids Benefits",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
