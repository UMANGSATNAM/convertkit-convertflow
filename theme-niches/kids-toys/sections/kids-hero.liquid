{% style %}
.kids-hero {
  background: linear-gradient(135deg, #EEF4FF 0%, #FFF8E8 100%);
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 88vh;
  padding: 0 60px;
  align-items: center;
  gap: 60px;
  overflow: hidden;
  position: relative;
}
.kids-hero::before {
  content: '';
  position: absolute;
  top: -60px;
  right: -60px;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  background: rgba(249,194,46,.15);
}
.kids-hero::after {
  content: '';
  position: absolute;
  bottom: -40px;
  left: 40px;
  width: 200px;
  height: 200px;
  border-radius: 50%;
  background: rgba(45,107,228,.08);
}
.k-hero-text .badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--yellow);
  color: #000;
  padding: 6px 16px;
  border-radius: 100px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .5px;
  margin-bottom: 20px;
}
.k-hero-text h1 {
  font-size: 64px;
  font-weight: 800;
  line-height: 1.1;
  color: var(--text);
  margin-bottom: 20px;
}
.k-hero-text h1 span { color: var(--blue); }
.k-hero-text p {
  font-size: 17px;
  color: var(--muted);
  line-height: 1.8;
  max-width: 440px;
  margin-bottom: 36px;
}
.k-hero-btns {
  display: flex;
  gap: 12px;
}
.k-hero-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}
.toy-float {
  width: 100%;
  max-width: 460px;
  aspect-ratio: 1;
  border-radius: 40% 60% 60% 40% / 60% 40% 60% 40%;
  background: linear-gradient(135deg, #FFE8A3, #FFD166);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: blob 6s ease-in-out infinite;
  overflow: hidden;
}
.toy-float img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.toy-float svg { width: 55%; color: #2D6BE4; opacity: .5; }
@keyframes blob {
  0%, 100% { border-radius: 40% 60% 60% 40% / 60% 40% 60% 40%; }
  50% { border-radius: 60% 40% 40% 60% / 40% 60% 40% 60%; }
}
.age-badges {
  display: flex;
  gap: 8px;
  margin-top: 32px;
}
.age-b {
  padding: 6px 16px;
  border-radius: 100px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .5px;
}
.ab1 { background: #FFE8E8; color: #E83A3A; }
.ab2 { background: #E8F0FF; color: #2D6BE4; }
.ab3 { background: #E8FAF7; color: #1ABFA1; }

@media(max-width: 1024px) {
  .kids-hero { grid-template-columns: 1fr; min-height: auto; padding: 80px 40px; }
  .k-hero-visual { display: none; }
}
@media(max-width: 768px) {
  .kids-hero { padding: 60px 20px; }
  .k-hero-text h1 { font-size: 44px; }
  .k-hero-btns { flex-direction: column; }
  .btn-blue, .btn-outline-b { width: 100%; text-align: center; }
}
{% endstyle %}

<section class="kids-hero">
  <div class="k-hero-text">
    {%- if section.settings.badge != blank -%}
      <div class="badge">{{ section.settings.badge }}</div>
    {%- endif -%}
    
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    
    <div class="k-hero-btns">
      {%- if section.settings.btn1_text != blank -%}
        <a href="{{ section.settings.btn1_url }}" class="btn-blue">{{ section.settings.btn1_text }}</a>
      {%- endif -%}
      {%- if section.settings.btn2_text != blank -%}
        <a href="{{ section.settings.btn2_url }}" class="btn-outline-b">{{ section.settings.btn2_text }}</a>
      {%- endif -%}
    </div>
    
    <div class="age-badges">
      {%- for block in section.blocks -%}
        {%- assign cycle = forloop.index0 | modulo: 3 | plus: 1 -%}
        <span class="age-b ab{{ cycle }}">{{ block.settings.title }}</span>
      {%- endfor -%}
    </div>
  </div>
  <div class="k-hero-visual">
    <div class="toy-float">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 600 }}" loading="lazy">
      {%- else -%}
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kids Hero",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "⭐ 4.9 — Trusted by 1L+ Families" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Play. <span>Learn.</span><br>Grow Together." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Award-winning educational toys and games that spark curiosity, develop skills, and create lifelong memories. BIS-certified and BPA-free." },
    { "type": "text", "id": "btn1_text", "label": "Primary Button", "default": "Shop by Age" },
    { "type": "url", "id": "btn1_url", "label": "Primary URL" },
    { "type": "text", "id": "btn2_text", "label": "Secondary Button", "default": "Gift Guide →" },
    { "type": "url", "id": "btn2_url", "label": "Secondary URL" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "blocks": [
    {
      "type": "age",
      "name": "Age Group",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" }
      ]
    }
  ],
  "presets": [{ "name": "Kids Hero" }]
}
{% endschema %}
