<div style="padding:60px 20px 0;background:var(--kt-pastel)"><div style="max-width:1320px;margin:0 auto;text-align:center;padding-bottom:56px;border-bottom:2px solid var(--kt-border)"><span class="kt-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</span><h1 style="font-family:'Fredoka',sans-serif;font-size:clamp(32px,5vw,52px);font-weight:600;color:var(--kt-dark);margin-bottom:12px">{{ collection.title }}</h1>{%- if collection.description != blank -%}<p style="font-family:'Fredoka',sans-serif;font-size:15px;color:var(--kt-muted);max-width:560px;margin:0 auto">{{ collection.description }}</p>{%- endif -%}</div></div>
<div style="padding:0 20px 100px;background:var(--kt-pastel)"><div style="max-width:1320px;margin:0 auto"><div style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:2px solid var(--kt-border);margin-bottom:40px"><div style="font-family:'Fredoka',sans-serif;font-size:14px;color:var(--kt-muted)">{{ collection.products_count }} wood toys</div><select style="padding:10px 20px;border:2px solid var(--kt-border);border-radius:16px;background:#fff;color:var(--kt-dark);font-family:'Fredoka',sans-serif;font-size:12px;font-weight:600;cursor:pointer"><option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Newest</option></select></div><div class="kt-prod-grid">{%- for product in collection.products -%}<a href="{{ product.url }}" class="kt-prod-card"><div class="kt-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--kt-pastel)"></div>{%- endif -%}</div><div class="kt-prod-card__name">{{ product.title }}</div><div class="kt-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div></div></div>
{% schema %}
{"name":"Toys Collection","settings":[],"presets":[{"name":"Toys Collection"}]}
{% endschema %}
