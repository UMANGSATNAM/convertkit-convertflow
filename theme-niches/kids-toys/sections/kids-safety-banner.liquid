{% style %}
.safety {
  background: var(--blue);
  padding: 70px 60px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 80px;
  flex-wrap: wrap;
}
.safety-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  color: #fff;
}
.s-icon {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  border: 2px solid rgba(255,255,255,.3);
  display: flex;
  align-items: center;
  justify-content: center;
}
.s-icon svg { width: 28px; color: #fff; stroke-width: 1.5; }
.safety-item strong {
  font-family: 'Baloo 2', cursive;
  font-size: 16px;
}
.safety-item span {
  font-size: 12px;
  color: rgba(255,255,255,.6);
  text-align: center;
  max-width: 120px;
}

@media(max-width: 768px) {
  .safety { gap: 40px; padding: 60px 20px; }
}
{% endstyle %}

<div class="safety">
  {%- for block in section.blocks -%}
    <div class="safety-item">
      <div class="s-icon">
        {%- if block.settings.icon == 'cert' -%}
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        {%- elsif block.settings.icon == 'heart' -%}
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
        {%- elsif block.settings.icon == 'eco' -%}
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75"/></svg>
        {%- else -%}
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        {%- endif -%}
      </div>
      <strong>{{ block.settings.title }}</strong>
      <span>{{ block.settings.subtitle }}</span>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Kids Safety Banner",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "cert", "label": "Certificate" },
          { "value": "heart", "label": "Heart" },
          { "value": "eco", "label": "Leaf" },
          { "value": "truck", "label": "Truck" }
        ], "default": "cert" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" }
      ]
    }
  ],
  "presets": [{ "name": "Kids Safety Banner" }]
}
{% endschema %}
