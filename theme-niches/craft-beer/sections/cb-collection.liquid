<div style="padding:60px 20px 0;background:var(--cb-cream)"><div style="max-width:1320px;margin:0 auto;text-align:left;padding-bottom:56px;border-bottom:2px solid var(--cb-border)"><span class="cb-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</span><h1 style="font-family:'Outfit',sans-serif;font-size:clamp(32px,5vw,52px);font-weight:900;color:var(--cb-dark);margin-bottom:12px;letter-spacing:-0.03em;text-transform:uppercase">{{ collection.title }}</h1>{%- if collection.description != blank -%}<p style="font-family:'Outfit',sans-serif;font-size:15px;color:var(--cb-muted);max-width:560px;font-weight:500">{{ collection.description }}</p>{%- endif -%}</div></div>
<div style="padding:0 20px 100px;background:var(--cb-cream)"><div style="max-width:1320px;margin:0 auto"><div style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:2px solid var(--cb-border);margin-bottom:40px"><div style="font-family:'Outfit',sans-serif;font-size:13px;font-weight:800;color:var(--cb-dark);text-transform:uppercase">{{ collection.products_count }} microbrews</div><select style="padding:10px 20px;border:2px solid var(--cb-border);border-radius:4px;background:#fff;color:var(--cb-dark);font-family:'Outfit',sans-serif;font-size:12px;font-weight:800;cursor:pointer"><option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Newest</option></select></div><div class="cb-prod-grid">{%- for product in collection.products -%}<a href="{{ product.url }}" class="cb-prod-card"><div class="cb-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--cb-cream)"></div>{%- endif -%}</div><div class="cb-prod-card__name">{{ product.title }}</div><div class="cb-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div></div></div>
{% schema %}
{"name":"Beer Collection","settings":[],"presets":[{"name":"Beer Collection"}]}
{% endschema %}
