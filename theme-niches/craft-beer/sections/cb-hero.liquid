<div class="cb-hero">
  <div class="cb-hero__content">
    <span class="cb-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="cb-hero__title">{{ section.settings.heading }}</h1>
    <p class="cb-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="cb-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="cb-btn cb-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="cb-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--cb-amber)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Beer Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SUBURBAN MICROBREWERY"},{"type":"text","id":"heading","label":"Unfiltered Cold Pressed IPAs"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Double dry-hopped with Citra, Mosaic, and Simcoe hops, brewed locally and shipped cold."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"EXPLORE CANS"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"BREWHOUSE SPEC"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Beer Hero"}]}
{% endschema %}
