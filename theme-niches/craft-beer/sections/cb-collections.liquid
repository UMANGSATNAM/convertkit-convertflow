<div style="padding:80px 20px;background:#fff;border-bottom:2px solid var(--cb-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="cb-section-header"><span class="cb-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="cb-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="cb-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--cb-amber)"></div>{%- endif -%}<div class="cb-col-card__overlay"><span class="cb-col-card__title">{{ block.settings.title }}</span><span class="cb-col-card__cta">Explore Brews →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Beer Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CASK VARIETIES"},{"type":"text","id":"heading","label":"Heading","default":"Brews by Type"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Dry-Hopped IPAs"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Beer Collections","blocks":[{"type":"col","settings":{"title":"Double Dry IPAs"}},{"type":"col","settings":{"title":"Imperial Pastry Stouts"}},{"type":"col","settings":{"title":"Crisp German Lagers"}}]}]}
{% endschema %}
