<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="cb-section-header"><span class="cb-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="cb-review-grid">{%- for block in section.blocks -%}<div class="cb-review-card" {{ block.shopify_attributes }}><div class="cb-review-card__stars">★★★★★</div><div class="cb-review-card__text">"{{ block.settings.quote }}"</div><div class="cb-review-card__author">{{ block.settings.name }}</div><div class="cb-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Beer Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"TAPROOM OPINIONS"},{"type":"text","id":"heading","label":"Heading","default":"Taproom Reviews"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Beer Reviews","blocks":[{"type":"review","settings":{"quote":"Incredible tropical notes in this IPA. Hops are extremely fresh and juicy.","name":"Clint B.","product":"Citra DDH IPA"}},{"type":"review","settings":{"quote":"The pastry stout is basically liquid chocolate cake. Incredibly rich and creamy.","name":"Sarah J.","product":"Imperial Chocolate Stout"}},{"type":"review","settings":{"quote":"Crisp, clean, and perfectly carbonated. A brilliant lawnmower German Pilsner.","name":"Dave M.","product":"German Canned Pilsner"}}]}]}
{% endschema %}
