<div style="padding:80px 20px;background:var(--cb-charcoal)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="cb-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Outfit',sans-serif;font-size:clamp(28px,4vw,48px);font-weight:900;color:var(--cb-cream);margin-bottom:20px;line-height:1.05;text-transform:uppercase">{{ section.settings.heading }}</h2>
    <p style="font-family:'Outfit',sans-serif;font-size:15px;color:var(--cb-muted);line-height:1.6;max-width:440px;font-weight:500">{{ section.settings.body }}</p>
    <div class="cb-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="cb-stat" style="border-color:rgba(255,255,255,0.15);background:rgba(255,255,255,0.02)" {{ block.shopify_attributes }}><div class="cb-stat__num" style="color:var(--cb-amber)">{{ block.settings.number }}</div><div class="cb-stat__label" style="color:var(--cb-muted)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:4px;border:2px solid var(--cb-border);object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:1;background:var(--cb-border)"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Beer Specs","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"BREWHOUSE SPECS"},{"type":"text","id":"heading","label":"Heading","default":"DDH dry-hopped twice."},{"type":"textarea","id":"body","label":"Body","default":"Our IPAs undergo dual dry-hopping schedules at low cellar temperatures to extract maximum essential oils and aromatics without adding bitterness."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"6.8%"},{"type":"text","id":"label","label":"Label","default":"Alcohol ABV"}]}],"presets":[{"name":"Beer Specs","blocks":[{"type":"stat","settings":{"number":"6.8%","label":"Average ABV"}},{"type":"stat","settings":{"number":"65","label":"Hop IBU Rating"}},{"type":"stat","settings":{"number":"4°C","label":"Cold Chilled"}},{"type":"stat","settings":{"number":"DDH","label":"Dry Hopped"}}]}]}
{% endschema %}
