<div style="padding:80px 20px;background:var(--cb-cream);border-bottom:2px solid var(--cb-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="cb-section-header"><span class="cb-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  {%- assign col = collections[section.settings.collection] -%}
  <div class="cb-prod-grid">{%- for product in col.products limit: section.settings.count -%}<a href="{{ product.url }}" class="cb-prod-card"><div class="cb-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--cb-cream)"></div>{%- endif -%}</div><div class="cb-prod-card__name">{{ product.title }}</div><div class="cb-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div>
  <div style="text-align:center;margin-top:48px"><a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="cb-btn cb-btn--outline">{{ section.settings.cta_label }}</a></div>
</div></div>
{% schema %}
{"name":"Beer Featured","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CANNED RELEASES"},{"type":"text","id":"heading","label":"Heading","default":"Taproom Favorites"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"count","label":"Products","min":4,"max":12,"step":4,"default":8},{"type":"text","id":"cta_label","label":"CTA","default":"VIEW TAP LIST"},{"type":"url","id":"cta_url","label":"CTA URL"}],"presets":[{"name":"Beer Featured"}]}
{% endschema %}
