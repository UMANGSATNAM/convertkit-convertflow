<div style="background:#1A1A1A; padding:120px 24px; position:relative;">
  
  <div style="max-width:1200px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px; max-width:600px; margin-left:auto; margin-right:auto;">
      <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(40px, 5vw, 56px); font-weight:700; color:#F5F5F5; margin:0 0 16px 0; text-transform:uppercase;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-family:'Roboto', sans-serif; font-size:18px; color:#AAAAAA; margin:0;">
        {{ section.settings.subheading }}
      </p>
      <div style="width:60px; height:4px; background:#B8860B; margin:24px auto 0 auto;"></div>
    </div>

    <div class="mg-rout-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:40px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#111111; border:1px solid #333333; padding:40px 32px; position:relative; transition:all 0.4s ease;" class="mg-rout-card">
          
          <div style="font-family:'Oswald', sans-serif; font-size:80px; font-weight:700; color:#1A1A1A; position:absolute; top:20px; right:20px; line-height:1; transition:color 0.4s ease;" class="mg-rout-num">
            0{{ forloop.index }}
          </div>
          
          <div style="position:relative; z-index:2;">
            <h3 style="font-family:'Oswald', sans-serif; font-size:24px; font-weight:600; color:#F5F5F5; margin:0 0 16px 0; text-transform:uppercase;">
              {{ block.settings.title }}
            </h3>
            
            <p style="font-family:'Roboto', sans-serif; font-size:16px; font-weight:400; line-height:1.6; color:#AAAAAA; margin:0;">
              {{ block.settings.desc }}
            </p>
          </div>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .mg-rout-card:hover { border-color: #B8860B; transform: translateY(-5px); }
    .mg-rout-card:hover .mg-rout-num { color: #B8860B; opacity: 0.2; }
    
    @media (max-width: 990px) {
      .mg-rout-grid { grid-template-columns: 1fr; gap: 30px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Grooming Routine",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Daily Ritual"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A straightforward, 3-step routine for maximum impact."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "1. Cleanse"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Remove dirt and excess oil."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grooming Routine",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
