<div style="padding:80px 20px;background:var(--mg-charcoal)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <p class="mg-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 style="font-family:'DM Serif Display',serif;font-size:clamp(28px,4vw,48px);font-weight:400;color:var(--mg-ivory);margin-bottom:20px;line-height:1.15">{{ section.settings.heading }}</h2>
    <p style="font-size:16px;color:var(--mg-muted);line-height:1.8;max-width:440px">{{ section.settings.body }}</p>
    <div class="mg-stat-grid">{%- for block in section.blocks -%}<div class="mg-stat" style="border-color:var(--mg-border)" {{ block.shopify_attributes }}><div class="mg-stat__num" style="color:var(--mg-copper)">{{ block.settings.number }}</div><div class="mg-stat__label">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:8px;object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:4/5;background:var(--mg-slate);border-radius:8px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"MG Story","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"OUR CRAFT"},{"type":"text","id":"heading","label":"Heading","default":"No Shortcuts, Just Results"},{"type":"textarea","id":"body","label":"Body","default":"We formulate with premium natural ingredients, rigorously tested. Every product is designed to simplify your routine while delivering professional-grade results."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"50K+"},{"type":"text","id":"label","label":"Label","default":"Gentlemen"}]}],"presets":[{"name":"MG Story","blocks":[{"type":"stat","settings":{"number":"50K+","label":"Gentlemen"}},{"type":"stat","settings":{"number":"30+","label":"Products"}},{"type":"stat","settings":{"number":"100%","label":"Natural"}},{"type":"stat","settings":{"number":"4.8★","label":"Avg Rating"}}]}]}
{% endschema %}
