<div style="background:#111111; padding:0; position:relative; overflow:hidden;">
  
  <div style="max-width:1440px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; align-items:stretch;">
    
    <!-- Content -->
    <div style="padding:120px 80px 120px 40px; display:flex; flex-direction:column; justify-content:center; position:relative; z-index:2;">
      <div style="font-family:'Oswald', sans-serif; font-size:14px; font-weight:500; text-transform:uppercase; letter-spacing:4px; color:#B8860B; margin-bottom:24px; display:flex; align-items:center; gap:16px;">
        <span style="width:40px; height:2px; background:#B8860B;"></span>
        {{ section.settings.eyebrow }}
      </div>
      
      <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(40px, 5vw, 64px); font-weight:700; color:#F5F5F5; margin:0 0 24px 0; line-height:1; text-transform:uppercase;">
        {{ section.settings.heading }}
      </h2>
      
      <p style="font-family:'Roboto', sans-serif; font-size:18px; font-weight:300; line-height:1.6; color:#CCCCCC; margin:0 0 48px 0; max-width:480px;">
        {{ section.settings.subheading }}
      </p>
      
      <!-- List -->
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:48px;">
        <div style="display:flex; align-items:center; gap:12px; font-family:'Roboto', sans-serif; font-size:16px; color:#F5F5F5;">
          <div style="width:8px; height:8px; background:#B8860B;"></div> Premium Beard Oil
        </div>
        <div style="display:flex; align-items:center; gap:12px; font-family:'Roboto', sans-serif; font-size:16px; color:#F5F5F5;">
          <div style="width:8px; height:8px; background:#B8860B;"></div> Daily Face Wash
        </div>
        <div style="display:flex; align-items:center; gap:12px; font-family:'Roboto', sans-serif; font-size:16px; color:#F5F5F5;">
          <div style="width:8px; height:8px; background:#B8860B;"></div> Hydrating Moisturizer
        </div>
        <div style="display:flex; align-items:center; gap:12px; font-family:'Roboto', sans-serif; font-size:16px; color:#F5F5F5;">
          <div style="width:8px; height:8px; background:#B8860B;"></div> Solid Cologne
        </div>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <div>
          <a href="{{ section.settings.cta_url | default: '/products/master-kit' }}" style="display:inline-flex; align-items:center; justify-content:center; background:transparent; color:#B8860B; border:2px solid #B8860B; font-family:'Oswald', sans-serif; font-size:16px; font-weight:600; text-transform:uppercase; letter-spacing:2px; padding:18px 48px; text-decoration:none; transition:all 0.3s ease; position:relative; overflow:hidden;" class="mg-btn-outline">
            <span style="position:relative; z-index:2;">{{ section.settings.cta_label }}</span>
            <div style="position:absolute; inset:0; background:#B8860B; transform:translateY(100%); transition:transform 0.3s ease; z-index:1;" class="mg-btn-outline-bg"></div>
          </a>
        </div>
      {%- endif -%}
    </div>
    
    <!-- Visual -->
    <div style="position:relative; min-height:600px;">
      <div style="position:absolute; inset:0; background:#1A1A1A; clip-path:polygon(15% 0, 100% 0, 100% 100%, 0 100%); z-index:1;" class="mg-feat-clip"></div>
      
      <img src="https://images.unsplash.com/photo-1585242502847-f55a1ee59811?auto=format&fit=crop&w=1000&q=80" alt="Grooming Kit" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:2; mix-blend-mode:luminosity; opacity:0.8;" loading="lazy">
      
      <!-- Gold accent -->
      <div style="position:absolute; top:40px; right:40px; width:100px; height:100px; border:2px solid #B8860B; z-index:3; opacity:0.5; pointer-events:none;"></div>
      <div style="position:absolute; bottom:40px; left:20%; width:100px; height:100px; border:2px solid #B8860B; z-index:3; opacity:0.5; pointer-events:none;" class="mg-feat-accent"></div>
    </div>
    
  </div>

  <style>
    .mg-btn-outline:hover { color: #111111; }
    .mg-btn-outline:hover .mg-btn-outline-bg { transform: translateY(0); }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; }
      div[style*="padding:120px 80px 120px 40px"] { padding: 60px 24px; }
      .mg-feat-clip { display: none; }
      .mg-feat-accent { left: 40px !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Grooming Featured",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE ULTIMATE ARSENAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Master Grooming Kit"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to look and feel your best. Includes our signature beard oil, face wash, daily moisturizer, and a solid cologne."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP THE KIT"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Grooming Featured"
    }
  ]
}
{% endschema %}
