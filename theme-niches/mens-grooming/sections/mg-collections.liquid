<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="mg-section-header"><p class="mg-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
  <div class="mg-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="mg-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--mg-sand)"></div>{%- endif -%}<div class="mg-col-card__overlay"><span class="mg-col-card__title">{{ block.settings.title }}</span><span class="mg-col-card__cta">Shop →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"MG Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CATEGORIES"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Routine"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Beard Care"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"MG Collections","blocks":[{"type":"col","settings":{"title":"Beard Care"}},{"type":"col","settings":{"title":"Hair Styling"}},{"type":"col","settings":{"title":"Shave Essentials"}}]}]}
{% endschema %}
