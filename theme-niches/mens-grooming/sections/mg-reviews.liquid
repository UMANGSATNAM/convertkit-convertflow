<div style="padding:80px 20px;background:var(--mg-ivory)"><div style="max-width:1320px;margin:0 auto">
  <div class="mg-section-header"><p class="mg-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
  <div class="mg-review-grid">{%- for block in section.blocks -%}<div class="mg-review-card" {{ block.shopify_attributes }}><div class="mg-review-card__stars">{%- for i in (1..block.settings.rating) -%}★{%- endfor -%}</div><div class="mg-review-card__text">"{{ block.settings.quote }}"</div><div class="mg-review-card__author">{{ block.settings.name }}</div><div class="mg-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"MG Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"TESTIMONIALS"},{"type":"text","id":"heading","label":"Heading","default":"What Gentlemen Say"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"MG Reviews","blocks":[{"type":"review","settings":{"rating":5,"quote":"The beard oil is incredible. Non-greasy, smells amazing, and my beard has never looked better.","name":"Arjun T.","product":"Premium Beard Oil"}},{"type":"review","settings":{"rating":5,"quote":"Finally a brand that understands mens skincare. The face wash is a game-changer.","name":"Rohan M.","product":"Charcoal Face Wash"}},{"type":"review","settings":{"rating":5,"quote":"Switched from 5 products to their complete kit. Simplified my routine, better results.","name":"Karan P.","product":"Complete Grooming Kit"}}]}]}
{% endschema %}
