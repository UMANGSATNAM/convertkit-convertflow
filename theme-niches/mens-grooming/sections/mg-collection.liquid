<div style="background:#111111; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px; flex-wrap:wrap; gap:24px;">
      <div>
        <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(40px, 5vw, 56px); font-weight:700; color:#F5F5F5; margin:0 0 16px 0; text-transform:uppercase;">
          {{ section.settings.heading }}
        </h2>
        <div style="width:60px; height:4px; background:#B8860B;"></div>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Oswald', sans-serif; font-size:14px; font-weight:600; color:#F5F5F5; text-decoration:none; display:flex; align-items:center; gap:8px; text-transform:uppercase; letter-spacing:2px; padding-bottom:4px; border-bottom:1px solid #B8860B; transition:color 0.3s ease;" class="mg-link-btn">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="mg-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:40px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1621607512214-68297480165e?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1593702295094-aea22597af65?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1593702275687-f8b402bf1fb5?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1621607512022-6aecc4fed814?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1512496015851-a1dcdb311094?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="mg-product-card" style="background:#1A1A1A; border:1px solid #333333; padding:24px; transition:all 0.4s ease; position:relative; display:flex; flex-direction:column; height:100%;">
          
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:120%; background:#111111; margin-bottom:24px;">
            <img src="{{ img_url }}" alt="Grooming Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.6s ease; mix-blend-mode:luminosity; opacity:0.8;" class="mg-product-img" loading="lazy">
            
            {% if idx == 1 or idx == 3 %}
              <div style="position:absolute; top:16px; left:16px; background:#B8860B; color:#111111; font-family:'Oswald', sans-serif; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:1px; padding:6px 12px;">
                {% if idx == 1 %}New{% else %}Top Rated{% endif %}
              </div>
            {% endif %}
          </a>
          
          <div style="display:flex; flex-direction:column; flex-grow:1; text-align:left;">
            
            <div style="font-family:'Oswald', sans-serif; font-size:12px; font-weight:500; color:#B8860B; text-transform:uppercase; letter-spacing:2px; margin-bottom:8px;">
              {% if idx == 1 %}Beard Care{% elsif idx == 2 %}Face Care{% elsif idx == 3 %}Hair Care{% else %}Body Wash{% endif %}
            </div>
            
            <h3 style="font-family:'Oswald', sans-serif; font-size:24px; font-weight:600; color:#F5F5F5; margin:0 0 12px 0; text-transform:uppercase;">
              {% if idx == 1 %}Premium Beard Oil{% elsif idx == 2 %}Charcoal Face Wash{% elsif idx == 3 %}Matte Styling Clay{% else %}Cedarwood Body Wash{% endif %}
            </h3>
            
            <div style="font-family:'Roboto', sans-serif; font-size:14px; font-weight:400; color:#AAAAAA; margin-bottom:24px; flex-grow:1;">
              {% if idx == 1 %}Condition and soften coarse hair.{% elsif idx == 2 %}Deep clean without drying.{% elsif idx == 3 %}Strong hold, natural finish.{% else %}Invigorating scent.{% endif %}
            </div>
            
            <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px solid #333333; padding-top:16px; margin-top:auto;">
              <div style="font-family:'Oswald', sans-serif; font-size:20px; font-weight:500; color:#F5F5F5;">
                {% if idx == 1 %}$24.00{% elsif idx == 2 %}$18.00{% elsif idx == 3 %}$22.00{% else %}$20.00{% endif %}
              </div>
              <button style="width:40px; height:40px; background:#111111; color:#F5F5F5; border:1px solid #B8860B; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all 0.3s ease; font-size:20px;" class="mg-add-btn">
                +
              </button>
            </div>
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .mg-link-btn:hover { color: #B8860B; }
    .mg-product-card:hover { border-color: #B8860B; transform: translateY(-5px); }
    .mg-product-card:hover .mg-product-img { transform: scale(1.05); opacity: 1; mix-blend-mode: normal; }
    .mg-add-btn:hover { background: #B8860B; color: #111111; }
    
    @media (max-width: 1024px) {
      .mg-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px 20px !important; }
    }
    @media (max-width: 640px) {
      .mg-product-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Grooming Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Top Rated"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL GEAR"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Grooming Collection"
    }
  ]
}
{% endschema %}
