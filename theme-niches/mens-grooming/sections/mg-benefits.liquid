<div style="background:#111111; padding:120px 24px; border-top:1px solid #333333;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(40px, 5vw, 56px); font-weight:700; color:#F5F5F5; margin:0 0 16px 0; text-transform:uppercase;">
        {{ section.settings.heading }}
      </h2>
      <div style="width:60px; height:4px; background:#B8860B; margin:0 auto;"></div>
    </div>

    <div class="mg-ben-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:60px;">
      
      {%- for block in section.blocks -%}
        <div style="text-align:center; position:relative; padding:0 20px;" class="mg-ben-card">
          
          <div style="width:80px; height:80px; margin:0 auto 32px auto; display:flex; align-items:center; justify-content:center; border:2px solid #333333; transform:rotate(45deg); transition:all 0.4s ease;" class="mg-ben-icon">
            <div style="transform:rotate(-45deg);">
              {% if forloop.index == 1 %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#B8860B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {% elsif forloop.index == 2 %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#B8860B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              {% else %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#B8860B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
              {% endif %}
            </div>
          </div>
          
          <h3 style="font-family:'Oswald', sans-serif; font-size:20px; font-weight:600; text-transform:uppercase; letter-spacing:1px; color:#F5F5F5; margin:0 0 16px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Roboto', sans-serif; font-size:16px; font-weight:400; line-height:1.6; color:#AAAAAA; margin:0 auto; max-width:280px;">
            {{ block.settings.desc }}
          </p>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .mg-ben-card:hover .mg-ben-icon { border-color: #B8860B; background: rgba(184,134,11,0.1); }
    
    @media (max-width: 990px) {
      .mg-ben-grid { grid-template-columns: 1fr; gap: 60px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Grooming Benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "No BS. Just Results."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Barber Approved"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Tested and trusted by professionals."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grooming Benefits",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
