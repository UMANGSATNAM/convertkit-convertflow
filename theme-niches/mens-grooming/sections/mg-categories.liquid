<div style="background:#1A1A1A; padding:120px 24px; position:relative;">
  
  <!-- Subtle line pattern -->
  <div style="position:absolute; inset:0; background:repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(255,255,255,0.02) 10px, rgba(255,255,255,0.02) 11px); pointer-events:none;"></div>
  
  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px; flex-wrap:wrap; gap:24px;">
      <div>
        <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(40px, 5vw, 56px); font-weight:700; color:#F5F5F5; margin:0 0 16px 0; text-transform:uppercase;">
          {{ section.settings.heading }}
        </h2>
        <div style="width:60px; height:4px; background:#B8860B;"></div>
      </div>
    </div>

    <div class="mg-cat-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:30px;">
      
      {%- for block in section.blocks -%}
        <a href="#" class="mg-cat-card" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:130%; background:#111111; border:1px solid #333333; group">
          
          {%- assign img_url = 'https://images.unsplash.com/photo-1621607512214-68297480165e?auto=format&fit=crop&w=600&q=80' -%}
          {%- if forloop.index == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1512496015851-a1dcdb311094?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
          {%- if forloop.index == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1585242502847-f55a1ee59811?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
          {%- if forloop.index == 4 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1593702288056-ccde0661eb1a?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
          
          <img src="{{ img_url }}" alt="{{ block.settings.title }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.8s ease; mix-blend-mode:luminosity; opacity:0.6;" class="mg-cat-img" loading="lazy">
          
          <!-- Gradient overlay -->
          <div style="position:absolute; inset:0; background:linear-gradient(to top, #111111 0%, transparent 80%);"></div>
          
          <div style="position:absolute; bottom:0; left:0; width:100%; padding:32px;">
            <div style="display:flex; align-items:center; gap:16px; margin-bottom:8px;">
              <div style="width:24px; height:2px; background:#B8860B; transition:width 0.4s ease;" class="mg-cat-line"></div>
              <div style="font-family:'Oswald', sans-serif; font-size:24px; font-weight:600; color:#F5F5F5; text-transform:uppercase; letter-spacing:1px;">
                {{ block.settings.title }}
              </div>
            </div>
            <div style="font-family:'Roboto', sans-serif; font-size:14px; font-weight:400; color:#AAAAAA;">
              {{ block.settings.desc }}
            </div>
          </div>
          
        </a>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .mg-cat-card:hover { border-color: #B8860B; }
    .mg-cat-card:hover .mg-cat-img { transform: scale(1.05); opacity: 0.9; }
    .mg-cat-card:hover .mg-cat-line { width: 40px; }
    
    @media (max-width: 990px) {
      .mg-cat-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    }
    @media (max-width: 640px) {
      .mg-cat-grid { grid-template-columns: 1fr; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Grooming Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Grooming Arsenal"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Beard Care"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Description",
          "default": "Oils, balms & washes"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grooming Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
