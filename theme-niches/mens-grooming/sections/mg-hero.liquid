<div style="background:#111111; position:relative; overflow:hidden;">
  
  <!-- Subtle texture / gradient -->
  <div style="position:absolute; inset:0; background:radial-gradient(circle at 70% 30%, #1A1A1A 0%, #111111 70%); z-index:1;"></div>
  
  <div style="max-width:1440px; margin:0 auto; min-height:90vh; display:grid; grid-template-columns:1fr 1fr; align-items:stretch;">
    
    <!-- Content -->
    <div style="padding:80px 40px 80px 80px; position:relative; z-index:2; display:flex; flex-direction:column; justify-content:center;">
      <div style="font-family:'Oswald', sans-serif; font-size:14px; font-weight:500; text-transform:uppercase; letter-spacing:4px; color:#B8860B; margin-bottom:24px; display:flex; align-items:center; gap:16px;">
        <span style="width:40px; height:2px; background:#B8860B;"></span>
        {{ section.settings.eyebrow }}
      </div>
      
      <h1 style="font-family:'Oswald', sans-serif; font-size:clamp(56px, 7vw, 96px); font-weight:700; color:#F5F5F5; line-height:1; margin:0 0 32px 0; text-transform:uppercase;">
        {{ section.settings.heading }}
      </h1>
      
      <p style="font-family:'Roboto', sans-serif; font-size:18px; font-weight:300; color:#CCCCCC; line-height:1.6; margin:0 0 48px 0; max-width:480px;">
        {{ section.settings.subheading }}
      </p>
      
      {%- if section.settings.cta_label != blank -%}
        <div>
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#B8860B; color:#111111; font-family:'Oswald', sans-serif; font-size:16px; font-weight:600; text-transform:uppercase; letter-spacing:2px; padding:20px 48px; text-decoration:none; transition:all 0.3s ease; position:relative; overflow:hidden;" class="mg-btn-primary">
            <span style="position:relative; z-index:2;">{{ section.settings.cta_label }}</span>
            <div style="position:absolute; inset:0; background:#DAA520; transform:translateX(-100%); transition:transform 0.3s ease; z-index:1;" class="mg-btn-bg"></div>
          </a>
        </div>
      {%- endif -%}
    </div>
    
    <!-- Visual -->
    <div style="position:relative; height:100%; width:100%; min-height:600px; overflow:hidden; z-index:2;">
      <!-- Diagonal cut overlay -->
      <div style="position:absolute; inset:0; background:#111111; clip-path:polygon(0 0, 15% 0, 0 100%); z-index:2;" class="mg-hero-clip"></div>
      
      <img src="https://images.unsplash.com/photo-1593702275687-f8b402bf1fb5?auto=format&fit=crop&w=1200&q=80" alt="Men's Grooming" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; mix-blend-mode:luminosity; opacity:0.8;" loading="eager">
      
      <!-- Gold accent line -->
      <div style="position:absolute; top:0; bottom:0; left:15%; width:2px; background:#B8860B; z-index:3;" class="mg-hero-line"></div>
    </div>
    
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Roboto:wght@300;400;500&display=swap');
    
    .mg-btn-primary:hover .mg-btn-bg { transform: translateX(0); }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; }
      div[style*="padding:80px 40px 80px 80px"] { padding: 60px 24px; text-align: center; }
      div[style*="justify-content:center; gap:16px"] { justify-content: center; }
      div[style*="max-width:480px"] { margin-left: auto; margin-right: auto; }
      .mg-hero-clip { display: none; }
      .mg-hero-line { display: none; }
      div[style*="min-height:600px"] { min-height: 400px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Grooming Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ELEVATE YOUR ROUTINE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Command Your Day."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Barber-grade grooming products engineered for the modern man. No nonsense, just results."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP THE COLLECTION"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Grooming Hero"
    }
  ]
}
{% endschema %}
