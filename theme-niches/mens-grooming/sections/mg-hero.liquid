<div class="mg-hero">
  <div class="mg-hero__content">
    <p class="mg-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="mg-hero__title">{{ section.settings.heading }}</h1>
    <p class="mg-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="mg-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="mg-btn mg-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="mg-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--mg-sand)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"MG Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"REFINED ESSENTIALS"},{"type":"text","id":"heading","label":"Heading","default":"Elevate Your Routine"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Premium grooming essentials crafted for the modern gentleman. No shortcuts, no compromises."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"SHOP NOW"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"BUILD YOUR KIT"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"MG Hero"}]}
{% endschema %}
