<div style="background:#F9FAF8; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px; flex-wrap:wrap; gap:24px;">
      <div>
        <h2 style="font-family:'Lora', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#2C3E2D; margin:0 0 16px 0;">
          {{ section.settings.heading }}
        </h2>
        <div style="width:40px; height:2px; background:#6B8E23;"></div>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Outfit', sans-serif; font-size:14px; font-weight:500; color:#6B8E23; text-decoration:none; display:flex; align-items:center; gap:8px; text-transform:uppercase; letter-spacing:1px; transition:color 0.3s ease;" class="of-link-btn">
          {{ section.settings.cta_label }}
          <svg style="width:20px; height:20px; fill:currentColor;" viewBox="0 0 24 24"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="of-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:30px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1595858603615-568eb712204c?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1595858603615-568eb712204c?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1587049352847-4d4b1ed7b483?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1628773822503-b0ebf49c0d75?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1550411294-8ef8df1b57ce?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="of-product-card" style="background:#FFFFFF; border-radius:16px; overflow:hidden; box-shadow:0 10px 20px rgba(44,62,45,0.03); transition:all 0.3s ease; position:relative; display:flex; flex-direction:column; height:100%;">
          
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:100%; background:#F9FAF8;">
            <img src="{{ img_url }}" alt="Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease;" class="of-product-img" loading="lazy">
            
            {% if idx == 1 or idx == 3 %}
              <div style="position:absolute; top:16px; left:16px; background:#6B8E23; color:#FFFFFF; font-family:'Outfit', sans-serif; font-size:11px; font-weight:600; padding:6px 12px; border-radius:20px; text-transform:uppercase; letter-spacing:1px;">
                Organic
              </div>
            {% endif %}
          </a>
          
          <div style="padding:24px; display:flex; flex-direction:column; flex-grow:1; text-align:center;">
            
            <h3 style="font-family:'Lora', serif; font-size:20px; font-weight:400; color:#2C3E2D; margin:0 0 8px 0; flex-grow:1;">
              {% if idx == 1 %}Heirloom Tomatoes{% elsif idx == 2 %}Fresh Avocados{% elsif idx == 3 %}Organic Lemons{% else %}Leafy Greens Bundle{% endif %}
            </h3>
            
            <div style="font-family:'Outfit', sans-serif; font-size:14px; font-weight:300; color:#888888; margin-bottom:16px;">
              {% if idx == 1 %}1 lb bundle{% elsif idx == 2 %}Set of 3{% elsif idx == 3 %}1.5 lb bag{% else %}1 bunch{% endif %}
            </div>
            
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:auto;">
              <div style="font-family:'Outfit', sans-serif; font-size:18px; font-weight:600; color:#2C3E2D;">
                {% if idx == 1 %}$5.99{% elsif idx == 2 %}$6.50{% elsif idx == 3 %}$4.99{% else %}$3.50{% endif %}
              </div>
              <button style="width:40px; height:40px; background:#EBF2EA; color:#6B8E23; border-radius:50%; display:flex; align-items:center; justify-content:center; border:none; cursor:pointer; transition:all 0.3s ease; font-size:20px;" class="of-add-btn">
                +
              </button>
            </div>
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .of-link-btn:hover { color: #55711B; }
    .of-product-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(44,62,45,0.08); }
    .of-product-card:hover .of-product-img { transform: scale(1.05); }
    .of-add-btn:hover { background: #6B8E23; color: #FFFFFF; transform: rotate(90deg); }
    
    @media (max-width: 1024px) {
      .of-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px 20px !important; }
    }
    @media (max-width: 640px) {
      .of-product-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Organic Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh Arrivals"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL GROCERIES"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Organic Collection"
    }
  ]
}
{% endschema %}
