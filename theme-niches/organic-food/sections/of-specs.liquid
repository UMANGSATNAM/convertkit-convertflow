<div style="padding:80px 20px;background:var(--of-dark);border-bottom:1px solid var(--of-border)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="of-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,48px);font-weight:700;color:var(--of-white);margin-bottom:20px;line-height:1.1;letter-spacing:-0.01em">{{ section.settings.heading }}</h2>
    <p style="font-family:'Outfit',sans-serif;font-size:15px;color:var(--of-muted);line-height:1.7;max-width:440px;font-weight:500">{{ section.settings.body }}</p>
    <div class="of-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="of-stat" style="border-color:var(--of-green);background:rgba(46,125,50,0.1)" {{ block.shopify_attributes }}><div class="of-stat__num" style="color:var(--of-green)">{{ block.settings.number }}</div><div class="of-stat__label" style="color:var(--of-white)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:16px;border:2px solid var(--of-green);object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:1.1;background:rgba(255,255,255,0.02);border-radius:16px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Organic Specs","settings":[{"type":"text","id":"eyebrow","label":"PURE HARVEST"},{"type":"text","id":"heading","label":"Heading","default":"Chemical-Free Soil."},{"type":"textarea","id":"body","label":"Body","default":"Every field undergoes extensive soil checks, maintaining 100% natural crop rotations for nutrient-rich cultivation."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"0%"},{"type":"text","id":"label","label":"Label","default":"Chemicals"}]}],"presets":[{"name":"Organic Specs","blocks":[{"type":"stat","settings":{"number":"0%","label":"Chemicals Used"}},{"type":"stat","settings":{"number":"100%","label":"Non-GMO seeds"}},{"type":"stat","settings":{"number":"24 Hrs","label":"Farm-to-Gate"}},{"type":"stat","settings":{"number":"Local","label":"Farmers"}}]}]}
{% endschema %}
