<div style="padding:80px 20px;background:#FFFDF9;border-bottom:1px solid var(--of-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="of-section-header"><span class="of-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="of-review-grid">{%- for block in section.blocks -%}<div class="of-review-card" {{ block.shopify_attributes }}><div class="of-review-card__stars">★★★★★</div><div class="of-review-card__text">"{{ block.settings.quote }}"</div><div class="of-review-card__author">{{ block.settings.name }}</div><div class="of-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Organic Reviews","settings":[{"type":"text","id":"eyebrow","label":"FARM FEEDBACK"},{"type":"text","id":"heading","label":"Heading","default":"Stories from Healthy Tables"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Organic Reviews","blocks":[{"type":"review","settings":{"quote":"You can instantly taste the difference. The organic vegetables are incredibly fresh and last twice as long.","name":"Siddharth M.","product":"Fresh Vegetable Basket"}},{"type":"review","settings":{"quote":"Delicious stoneground grains. Our morning breads are so much more aromatic and flavorful now.","name":"Elena R.","product":"Stoneground Wheat Flour"}},{"type":"review","settings":{"quote":"The organic apples are beautifully crisp, sweet, and completely wax-free. Highly recommend this local harvest.","name":"Priya S.","product":"Crisp Gala Apples"}}]}]}
{% endschema %}
