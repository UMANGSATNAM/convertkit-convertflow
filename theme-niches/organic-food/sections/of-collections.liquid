<div style="padding:80px 20px;background:var(--of-cream);border-bottom:1px solid var(--of-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="of-section-header"><span class="of-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="of-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="of-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--of-green)"></div>{%- endif -%}<div class="of-col-card__overlay"><span class="of-col-card__title">{{ block.settings.title }}</span><span class="of-col-card__cta">Explore Category →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Organic Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"HARVEST BASKET"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Harvest Category"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Fresh Vegetables"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Organic Collections","blocks":[{"type":"col","settings":{"title":"Fresh Vegetables"}},{"type":"col","settings":{"title":"Organic Fruits"}},{"type":"col","settings":{"title":"Stoneground Grains"}}]}]}
{% endschema %}
