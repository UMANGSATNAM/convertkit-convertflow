<div style="background:#EBF2EA; padding:120px 24px; position:relative; overflow:hidden;">
  
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Lora', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#2C3E2D; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="of-values-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:60px;">
      
      {%- for block in section.blocks -%}
        <div style="text-align:center;">
          
          <div style="width:100px; height:100px; border-radius:50%; background:#FFFFFF; display:flex; align-items:center; justify-content:center; margin:0 auto 32px auto; box-shadow:0 10px 20px rgba(44,62,45,0.05); color:#6B8E23; font-size:40px;">
            {% if forloop.index == 1 %}🌱{% elsif forloop.index == 2 %}📍{% else %}♻️{% endif %}
          </div>
          
          <h3 style="font-family:'Lora', serif; font-size:24px; font-weight:500; color:#2C3E2D; margin:0 0 16px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Outfit', sans-serif; font-size:16px; font-weight:300; line-height:1.6; color:#4A5D4E; margin:0 auto; max-width:320px;">
            {{ block.settings.desc }}
          </p>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    @media (max-width: 990px) {
      .of-values-grid { grid-template-columns: 1fr; gap: 60px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Organic Values",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Promise to You"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% Certified Organic"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "No synthetic pesticides or fertilizers. Just nature's best."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Organic Values",
      "blocks": [
        { "type": "value" },
        { "type": "value" },
        { "type": "value" }
      ]
    }
  ]
}
{% endschema %}
