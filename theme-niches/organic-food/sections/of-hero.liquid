<div style="background:var(--of-bg);min-height:85vh;display:flex;align-items:center;padding:60px 40px;position:relative">
  <div style="max-width:1200px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center">
    
    <div style="padding:40px;background:#FFF;border-radius:24px;box-shadow:0 20px 40px rgba(46, 81, 42, 0.05);position:relative;z-index:2">
      <div class="of-label" style="margin-bottom:16px">{{ section.settings.overline | default: 'Farm Fresh Deliveries' }}</div>
      <h1 class="of-head" style="font-size:clamp(40px, 5vw, 64px);line-height:1.1;margin-bottom:24px">
        {{ section.settings.heading | default: 'Straight from<br>the Soil.' }}
      </h1>
      <p style="font-size:16px;line-height:1.6;color:var(--of-muted);margin-bottom:40px">
        {{ section.settings.text | default: 'We partner with local farmers to bring you 100% certified organic produce, harvested daily and delivered to your door.' }}
      </p>
      <div style="display:flex;gap:16px;align-items:center">
        <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="of-btn">{{ section.settings.btn1_text | default: 'Shop the Harvest' }}</a>
      </div>
    </div>
    
    <div style="position:relative;height:70vh;border-radius:200px 200px 24px 24px;overflow:hidden">
      <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/organic-hero.jpg?v=1717283400" alt="Farm Fresh" style="width:100%;height:100%;object-fit:cover">
      
      <!-- Eco floating leaf -->
      <div style="position:absolute;top:40px;right:40px;background:#FFF;width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 20px rgba(0,0,0,0.1);color:var(--of-accent);font-size:24px">
        🌿
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Organic Food Hero",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline Text",
      "default": "Farm Fresh Deliveries"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Straight from<br>the Soil."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "We partner with local farmers to bring you 100% certified organic produce."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button Text",
      "default": "Shop the Harvest"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Organic Food Hero"
    }
  ]
}
{% endschema %}
