<div class="of-hero">
  <div class="of-hero__content">
    <span class="of-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="of-hero__title">{{ section.settings.heading }}</h1>
    <p class="of-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="of-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/farms' }}" class="of-btn of-btn--outline" style="border-radius:30px">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="of-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--of-green)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Organic Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"100% ORGANIC FARMING"},{"type":"text","id":"heading","label":"Fresh Organic Harvest Delivered"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Sourced directly from local sustainable farms. No artificial chemicals, certified GMO-free, and rich in natural nutrients."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"SHOP HARVEST"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"OUR FARMS"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Organic Hero"}]}
{% endschema %}
