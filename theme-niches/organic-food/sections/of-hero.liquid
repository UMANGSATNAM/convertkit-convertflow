<div style="background:#F9FAF8; position:relative; overflow:hidden; padding:80px 24px;">
  
  <div style="max-width:1440px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center; position:relative; z-index:2;">
    
    <!-- Content -->
    <div style="padding-right:40px;">
      <div style="display:inline-flex; align-items:center; gap:8px; font-family:'Outfit', sans-serif; font-size:12px; font-weight:600; padding:8px 16px; border-radius:30px; text-transform:uppercase; letter-spacing:2px; margin-bottom:24px; color:#6B8E23; border:1px solid #6B8E23;">
        <span style="display:inline-block; width:8px; height:8px; background:#6B8E23; border-radius:50%;"></span>
        {{ section.settings.eyebrow }}
      </div>
      
      <h1 style="font-family:'Lora', serif; font-size:clamp(48px, 6vw, 72px); font-weight:400; line-height:1.1; color:#2C3E2D; margin:0 0 24px 0;">
        {{ section.settings.heading }}
      </h1>
      
      <p style="font-family:'Outfit', sans-serif; font-size:18px; font-weight:300; color:#4A5D4E; line-height:1.6; margin:0 0 40px 0;">
        {{ section.settings.subheading }}
      </p>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#6B8E23; color:#FFFFFF; font-family:'Outfit', sans-serif; font-size:16px; font-weight:500; padding:18px 40px; border-radius:50px; text-decoration:none; transition:all 0.3s ease;" class="of-btn-primary">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
      
      <div style="display:flex; align-items:center; gap:24px; margin-top:48px;">
        <div style="display:flex; align-items:center; gap:12px;">
          <div style="width:40px; height:40px; background:#EBF2EA; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#6B8E23;">🌿</div>
          <div style="font-family:'Outfit', sans-serif; font-size:14px; font-weight:500; color:#2C3E2D;">100% Organic</div>
        </div>
        <div style="display:flex; align-items:center; gap:12px;">
          <div style="width:40px; height:40px; background:#EBF2EA; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#6B8E23;">🚜</div>
          <div style="font-family:'Outfit', sans-serif; font-size:14px; font-weight:500; color:#2C3E2D;">Locally Grown</div>
        </div>
      </div>
    </div>
    
    <!-- Visual -->
    <div style="position:relative;">
      <!-- Organic shape blob behind image -->
      <div style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); width:100%; height:100%; background:#EBF2EA; border-radius:50% 50% 30% 70% / 60% 40% 60% 40%; z-index:1; animation:of-blob 10s ease-in-out infinite alternate;"></div>
      
      <div style="position:relative; z-index:2; border-radius:30% 70% 70% 30% / 30% 30% 70% 70%; overflow:hidden; border:8px solid #FFFFFF; box-shadow:0 20px 40px rgba(44,62,45,0.08); aspect-ratio:4/5;">
        <img src="https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=800&q=80" alt="Fresh Produce" style="width:100%; height:100%; object-fit:cover;" loading="eager">
      </div>
      
      <!-- Floating Element -->
      <div style="position:absolute; bottom:40px; left:-40px; background:#FFFFFF; padding:16px 24px; border-radius:16px; box-shadow:0 10px 30px rgba(44,62,45,0.1); z-index:3; display:flex; align-items:center; gap:16px; animation:of-float 4s ease-in-out infinite;">
        <div style="width:48px; height:48px; border-radius:50%; overflow:hidden;">
          <img src="https://images.unsplash.com/photo-1595858603615-568eb712204c?auto=format&fit=crop&w=100&q=80" style="width:100%; height:100%; object-fit:cover;">
        </div>
        <div>
          <div style="font-family:'Outfit', sans-serif; font-size:12px; color:#6B8E23; font-weight:600; margin-bottom:4px;">Freshly Picked</div>
          <div style="font-family:'Lora', serif; font-size:16px; font-weight:500; color:#2C3E2D;">Organic Tomatoes</div>
        </div>
      </div>
    </div>
    
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Outfit:wght@300;400;500;600&display=swap');
    
    .of-btn-primary:hover { background: #55711B; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(107,142,35,0.2); }
    
    @keyframes of-blob { 0% { border-radius: 50% 50% 30% 70% / 60% 40% 60% 40%; } 100% { border-radius: 30% 70% 70% 30% / 50% 60% 40% 50%; } }
    @keyframes of-float { 0% { transform: translateY(0); } 50% { transform: translateY(-15px); } 100% { transform: translateY(0); } }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; text-align: center; gap: 80px; }
      div[style*="padding-right:40px"] { padding-right: 0; }
      div[style*="justify-content:center"] { margin: 0 auto; }
      div[style*="display:flex; align-items:center; gap:24px; margin-top:48px"] { justify-content: center; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Organic Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FARM TO TABLE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wholesome, purely organic goodness."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Nourish your body with seasonal produce sourced directly from local, sustainable farms."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP THE HARVEST"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Organic Hero"
    }
  ]
}
{% endschema %}
