<div style="background:#FFFFFF; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
    
    <!-- Visual -->
    <div style="position:relative;">
      <!-- Blob background -->
      <div style="position:absolute; top:-20px; left:-20px; width:100%; height:100%; background:#EBF2EA; border-radius:40% 60% 70% 30% / 40% 50% 60% 50%; z-index:1;"></div>
      
      <div style="position:relative; z-index:2; border-radius:24px; overflow:hidden; box-shadow:0 30px 60px rgba(44,62,45,0.08);">
        <img src="https://images.unsplash.com/photo-1488459716781-31db52582fe9?auto=format&fit=crop&w=1000&q=80" alt="Harvest Box" style="width:100%; height:auto; display:block;" loading="lazy">
      </div>
      
      <!-- Floating Badge -->
      <div style="position:absolute; bottom:-30px; right:40px; background:#6B8E23; color:#FFFFFF; width:120px; height:120px; border-radius:50%; display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:3; box-shadow:0 15px 30px rgba(107,142,35,0.3); text-align:center;">
        <div style="font-family:'Lora', serif; font-size:28px; font-weight:600; line-height:1; margin-bottom:4px;">$45</div>
        <div style="font-family:'Outfit', sans-serif; font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:1px;">Per Box</div>
      </div>
    </div>
    
    <!-- Content -->
    <div>
      <div style="display:inline-block; font-family:'Outfit', sans-serif; font-size:12px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:#6B8E23; margin-bottom:16px;">
        {{ section.settings.eyebrow }}
      </div>
      
      <h2 style="font-family:'Lora', serif; font-size:clamp(36px, 4vw, 56px); font-weight:400; line-height:1.2; color:#2C3E2D; margin:0 0 24px 0;">
        {{ section.settings.heading }}
      </h2>
      
      <p style="font-family:'Outfit', sans-serif; font-size:18px; font-weight:300; line-height:1.6; color:#4A5D4E; margin:0 0 40px 0;">
        {{ section.settings.subheading }}
      </p>
      
      <ul style="list-style:none; padding:0; margin:0 0 48px 0; display:flex; flex-direction:column; gap:16px;">
        <li style="display:flex; align-items:center; gap:16px;">
          <div style="color:#6B8E23;">✓</div>
          <div style="font-family:'Outfit', sans-serif; font-size:16px; color:#2C3E2D;">Freshly picked within 24 hours of delivery</div>
        </li>
        <li style="display:flex; align-items:center; gap:16px;">
          <div style="color:#6B8E23;">✓</div>
          <div style="font-family:'Outfit', sans-serif; font-size:16px; color:#2C3E2D;">Customize your box preferences weekly</div>
        </li>
        <li style="display:flex; align-items:center; gap:16px;">
          <div style="color:#6B8E23;">✓</div>
          <div style="font-family:'Outfit', sans-serif; font-size:16px; color:#2C3E2D;">Includes seasonal recipe cards</div>
        </li>
      </ul>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/products/harvest-box' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#6B8E23; color:#FFFFFF; font-family:'Outfit', sans-serif; font-size:16px; font-weight:500; padding:18px 40px; border-radius:50px; text-decoration:none; transition:all 0.3s ease;" class="of-btn-primary">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>
    
  </div>

  <style>
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; gap: 80px; text-align: center; }
      ul[style*="display:flex; flex-direction:column"] { align-items: center; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Organic Featured",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WEEKLY SPECIAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Seasonal Harvest Box"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A curated selection of the week's best organic vegetables, fruits, and fresh herbs, delivered right to your door."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SUBSCRIBE & SAVE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Organic Featured"
    }
  ]
}
{% endschema %}
