<div style="background:#EBF2EA; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Lora', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#2C3E2D; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      <div style="width:40px; height:2px; background:#6B8E23; margin:0 auto;"></div>
    </div>

    <div class="of-recipes-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 2 }}, 1fr); gap:40px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#FFFFFF; border-radius:24px; overflow:hidden; box-shadow:0 15px 30px rgba(44,62,45,0.05); display:flex; flex-direction:column; transition:transform 0.3s ease;" class="of-recipe-card">
          
          <div style="position:relative; padding-bottom:60%; background:#F9FAF8;">
            {%- assign img_url = 'https://images.unsplash.com/photo-1498837167922-41c53bbf10f8?auto=format&fit=crop&w=800&q=80' -%}
            {%- if forloop.index == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=800&q=80' -%}{%- endif -%}
            
            <img src="{{ img_url }}" alt="{{ block.settings.title }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease;" class="of-recipe-img" loading="lazy">
            
            <div style="position:absolute; top:20px; left:20px; background:#FFFFFF; color:#2C3E2D; font-family:'Outfit', sans-serif; font-size:12px; font-weight:600; padding:8px 16px; border-radius:20px; text-transform:uppercase; letter-spacing:1px; box-shadow:0 5px 15px rgba(0,0,0,0.1);">
              {{ block.settings.time }}
            </div>
          </div>
          
          <div style="padding:40px; display:flex; flex-direction:column; flex-grow:1;">
            <h3 style="font-family:'Lora', serif; font-size:28px; font-weight:500; color:#2C3E2D; margin:0 0 16px 0;">
              {{ block.settings.title }}
            </h3>
            
            <p style="font-family:'Outfit', sans-serif; font-size:16px; font-weight:300; line-height:1.6; color:#4A5D4E; margin:0 0 32px 0; flex-grow:1;">
              Discover the perfect way to highlight this season's freshest ingredients with our simple, healthy, and delicious recipe.
            </p>
            
            <a href="#" style="font-family:'Outfit', sans-serif; font-size:15px; font-weight:600; color:#6B8E23; text-decoration:none; display:flex; align-items:center; gap:8px; text-transform:uppercase; letter-spacing:1px; transition:gap 0.3s ease;" class="of-recipe-link">
              Read Recipe
              <span style="font-size:20px;">&rarr;</span>
            </a>
          </div>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .of-recipe-card:hover { transform: translateY(-10px); }
    .of-recipe-card:hover .of-recipe-img { transform: scale(1.05); }
    .of-recipe-card:hover .of-recipe-link { gap: 16px; }
    
    @media (max-width: 990px) {
      .of-recipes-grid { grid-template-columns: 1fr; gap: 40px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Organic Recipes",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Our Kitchen"
    }
  ],
  "blocks": [
    {
      "type": "recipe",
      "name": "Recipe",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Summer Tomato & Basil Tart"
        },
        {
          "type": "text",
          "id": "time",
          "label": "Prep Time",
          "default": "45 mins"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Organic Recipes",
      "blocks": [
        { "type": "recipe" },
        { "type": "recipe" }
      ]
    }
  ]
}
{% endschema %}
