<div style="background:#FFFFFF; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Lora', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#2C3E2D; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      <div style="width:40px; height:2px; background:#6B8E23; margin:0 auto;"></div>
    </div>

    <div class="of-cat-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:30px;">
      
      {%- for block in section.blocks -%}
        <a href="#" class="of-cat-card" style="display:block; text-align:center; text-decoration:none; group">
          
          <div style="position:relative; padding-bottom:100%; border-radius:50% 50% 16px 16px; overflow:hidden; margin-bottom:24px; background:#F9FAF8;">
            {%- assign img_url = 'https://images.unsplash.com/photo-1610348725531-843dff563e2c?auto=format&fit=crop&w=600&q=80' -%}
            {%- if forloop.index == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            {%- if forloop.index == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1628088062854-d1870b4553da?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            {%- if forloop.index == 4 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            
            <img src="{{ img_url }}" alt="{{ block.settings.title }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease;" class="of-cat-img" loading="lazy">
          </div>
          
          <h3 style="font-family:'Lora', serif; font-size:24px; font-weight:400; color:#2C3E2D; margin:0; transition:color 0.3s ease;" class="of-cat-title">
            {{ block.settings.title }}
          </h3>
          
        </a>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .of-cat-card:hover .of-cat-img { transform: scale(1.05); }
    .of-cat-card:hover .of-cat-title { color: #6B8E23; }
    
    @media (max-width: 990px) {
      .of-cat-grid { grid-template-columns: repeat(2, 1fr); gap: 40px 20px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Organic Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Aisle"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fresh Produce"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Organic Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
