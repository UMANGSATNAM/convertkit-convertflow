<div style="padding:80px 20px;background:var(--ma-dark);border-bottom:1px solid var(--ma-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="ma-section-header"><span class="ma-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="ma-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="ma-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--ma-orange)"></div>{%- endif -%}<div class="ma-col-card__overlay"><span class="ma-col-card__title">{{ block.settings.title }}</span><span class="ma-col-card__cta">Explore Armour →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Accessories Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ARMOUR MATRIX"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Armour Category"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Titanium Cases"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Accessories Collections","blocks":[{"type":"col","settings":{"title":"Titanium Cases"}},{"type":"col","settings":{"title":"Magnetic Chargers"}},{"type":"col","settings":{"title":"Screen Shields"}}]}]}
{% endschema %}
