<div style="background:#1A1D24; padding:120px 24px; position:relative; overflow:hidden;">
  
  <div style="position:absolute; top:0; left:0; width:100%; height:1px; background:linear-gradient(90deg, transparent, #3B82F6, transparent); opacity:0.5;"></div>

  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div class="ma-compat-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
      
      <!-- Content -->
      <div>
        <div style="display:inline-flex; align-items:center; gap:12px; font-family:'Inter', sans-serif; font-size:12px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:#3B82F6; margin-bottom:24px;">
          <svg style="width:16px; height:16px; fill:currentColor;" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
          {{ section.settings.eyebrow }}
        </div>
        
        <h2 style="font-family:'Inter', sans-serif; font-size:clamp(40px, 5vw, 56px); font-weight:800; line-height:1.1; color:#FFFFFF; margin:0 0 24px 0; letter-spacing:-1px;">
          {{ section.settings.heading }}
        </h2>
        
        <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:400; line-height:1.6; color:#9CA3AF; margin-bottom:48px;">
          {{ section.settings.body }}
        </p>
        
        <!-- Interactive UI Mockup -->
        <div style="background:#0F1115; border:1px solid rgba(255,255,255,0.05); border-radius:8px; padding:32px;">
          
          <div style="margin-bottom:24px;">
            <label style="display:block; font-family:'Inter', sans-serif; font-size:12px; font-weight:600; color:#9CA3AF; margin-bottom:8px; text-transform:uppercase; letter-spacing:1px;">Select Brand</label>
            <div style="display:flex; gap:12px;">
              <button style="flex:1; background:#3B82F6; color:#FFFFFF; border:none; padding:12px; border-radius:4px; font-family:'Inter', sans-serif; font-size:14px; font-weight:600; cursor:pointer;">Apple</button>
              <button style="flex:1; background:#1A1D24; color:#9CA3AF; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:4px; font-family:'Inter', sans-serif; font-size:14px; font-weight:600; cursor:pointer;">Samsung</button>
              <button style="flex:1; background:#1A1D24; color:#9CA3AF; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:4px; font-family:'Inter', sans-serif; font-size:14px; font-weight:600; cursor:pointer;">Google</button>
            </div>
          </div>
          
          <div style="margin-bottom:32px;">
            <label style="display:block; font-family:'Inter', sans-serif; font-size:12px; font-weight:600; color:#9CA3AF; margin-bottom:8px; text-transform:uppercase; letter-spacing:1px;">Select Device</label>
            <select style="width:100%; background:#1A1D24; color:#FFFFFF; border:1px solid rgba(255,255,255,0.1); padding:16px; border-radius:4px; font-family:'Inter', sans-serif; font-size:16px; appearance:none; outline:none; cursor:pointer;">
              <option>iPhone 15 Pro Max</option>
              <option>iPhone 15 Pro</option>
              <option>iPhone 15</option>
              <option>iPhone 14 Series</option>
            </select>
          </div>
          
          <button style="width:100%; background:#FFFFFF; color:#0F1115; border:none; padding:16px; border-radius:4px; font-family:'Inter', sans-serif; font-size:14px; font-weight:700; text-transform:uppercase; letter-spacing:1px; cursor:pointer; transition:background 0.3s ease;" onmouseover="this.style.background='#f3f4f6'" onmouseout="this.style.background='#FFFFFF'">
            View Compatible Gear
          </button>
          
        </div>
      </div>
      
      <!-- Visuals -->
      <div style="position:relative; height:100%; min-height:500px; display:flex; justify-content:center; align-items:center;">
        
        <!-- Glowing lines -->
        <div style="position:absolute; width:100%; height:100%; background:radial-gradient(circle at center, rgba(59,130,246,0.1) 0%, transparent 70%);"></div>
        
        <img src="https://images.unsplash.com/photo-1592899677974-c460c4f12828?auto=format&fit=crop&w=800&q=80" alt="Device Compatibility" style="width:80%; height:80%; object-fit:contain; position:relative; z-index:2; filter:drop-shadow(0 20px 40px rgba(0,0,0,0.8));" loading="lazy">
        
        <!-- Tech overlay elements -->
        <div style="position:absolute; top:10%; right:10%; border:1px solid rgba(59,130,246,0.5); padding:8px; background:rgba(15,17,21,0.8); backdrop-filter:blur(4px); z-index:3; font-family:'Inter', sans-serif; font-size:10px; color:#3B82F6; font-weight:700; letter-spacing:2px; display:flex; align-items:center; gap:8px;">
          <div style="width:4px; height:4px; background:#3B82F6; border-radius:50%; animation:ma-pulse-ring 2s infinite;"></div>
          SCANNING
        </div>
        
      </div>
      
    </div>
  </div>

  <style>
    @keyframes ma-pulse-ring { 0% { box-shadow:0 0 0 0 rgba(59,130,246,0.6); } 100% { box-shadow:0 0 0 10px rgba(59,130,246,0); } }
    
    @media (max-width: 990px) {
      .ma-compat-grid { grid-template-columns: 1fr; gap: 60px; }
      .ma-compat-grid > div:first-child { order: 2; }
      .ma-compat-grid > div:last-child { order: 1; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Mobile Compatibility",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PRECISION FIT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Device"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body Content",
      "default": "Select your model to see perfectly engineered accessories."
    }
  ],
  "presets": [
    {
      "name": "Mobile Compatibility"
    }
  ]
}
{% endschema %}
