<div style="background:#0F1115; border-top:1px solid rgba(255,255,255,0.05); border-bottom:1px solid rgba(255,255,255,0.05); overflow:hidden; padding:24px 0; display:flex;">
  
  <div class="ma-marquee-content" style="display:flex; white-space:nowrap; animation:ma-scroll 25s linear infinite; gap:40px; font-family:'Inter', sans-serif; font-size:14px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#9CA3AF;">
    <span>{{ section.settings.text }}</span>
    <span>{{ section.settings.text }}</span>
    <span>{{ section.settings.text }}</span>
    <span>{{ section.settings.text }}</span>
    <span>{{ section.settings.text }}</span>
    <span>{{ section.settings.text }}</span>
  </div>

  <style>
    @keyframes ma-scroll {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
  </style>
</div>

{% schema %}
{
  "name": "Mobile Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Marquee Text",
      "default": "MAGSAFE COMPATIBLE /// MIL-STD-810G DROP TESTED /// AEROSPACE-GRADE ALUMINUM /// 2-YEAR WARRANTY /// "
    }
  ],
  "presets": [
    {
      "name": "Mobile Marquee"
    }
  ]
}
{% endschema %}
