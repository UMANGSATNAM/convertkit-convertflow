<div style="background:#0F1115; padding:120px 24px; position:relative; overflow:hidden;">
  
  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    <div class="ma-featured-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
      
      <!-- Content -->
      <div>
        <div style="display:inline-flex; align-items:center; gap:12px; font-family:'Inter', sans-serif; font-size:12px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:#3B82F6; margin-bottom:24px;">
          <svg style="width:16px; height:16px; fill:currentColor;" viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2zm0 4.5l6.5 13.5h-13L12 6.5z"/></svg>
          {{ section.settings.eyebrow }}
        </div>
        
        <h2 style="font-family:'Inter', sans-serif; font-size:clamp(40px, 5vw, 56px); font-weight:800; line-height:1.1; color:#FFFFFF; margin:0 0 24px 0; letter-spacing:-1px;">
          {{ section.settings.heading }}
        </h2>
        
        <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:400; line-height:1.6; color:#9CA3AF; margin-bottom:40px;">
          The ultimate 3-in-1 charging ecosystem. Precision-machined aluminum chassis housing high-density magnetic arrays for instant alignment and maximum output.
        </p>
        
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-bottom:48px;">
          <div style="background:#1A1D24; padding:24px; border-radius:8px; border:1px solid rgba(255,255,255,0.05);">
            <div style="font-family:'Inter', sans-serif; font-size:24px; font-weight:800; color:#FFFFFF; margin-bottom:8px;">15W</div>
            <div style="font-family:'Inter', sans-serif; font-size:13px; color:#9CA3AF; font-weight:500;">Max Wireless Output</div>
          </div>
          <div style="background:#1A1D24; padding:24px; border-radius:8px; border:1px solid rgba(255,255,255,0.05);">
            <div style="font-family:'Inter', sans-serif; font-size:24px; font-weight:800; color:#FFFFFF; margin-bottom:8px;">N52</div>
            <div style="font-family:'Inter', sans-serif; font-size:13px; color:#9CA3AF; font-weight:500;">Neodymium Magnets</div>
          </div>
        </div>
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/products/magpro-station' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#3B82F6; color:#FFFFFF; font-family:'Inter', sans-serif; font-size:14px; font-weight:600; letter-spacing:1px; text-transform:uppercase; text-decoration:none; padding:18px 40px; border-radius:4px; transition:all 0.3s ease; box-shadow:0 10px 20px rgba(59,130,246,0.2);" class="ma-btn-primary">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
      
      <!-- Visuals -->
      <div style="position:relative; height:100%; min-height:500px; background:#1A1D24; border-radius:16px; border:1px solid rgba(255,255,255,0.05); display:flex; justify-content:center; align-items:center; overflow:hidden;">
        
        <div style="position:absolute; width:150%; height:150%; background:radial-gradient(circle at center, rgba(59,130,246,0.1) 0%, transparent 60%);"></div>
        
        <img src="https://images.unsplash.com/photo-1611186871348-b1ce696e52c9?auto=format&fit=crop&w=800&q=80" alt="Featured Product" style="width:80%; height:80%; object-fit:contain; position:relative; z-index:2; filter:drop-shadow(0 20px 30px rgba(0,0,0,0.5));" loading="lazy">
        
        <!-- Hotspots -->
        <div class="ma-hotspot" style="position:absolute; top:30%; left:30%; z-index:3;">
          <div style="width:16px; height:16px; background:#3B82F6; border-radius:50%; box-shadow:0 0 0 6px rgba(59,130,246,0.3); animation:ma-pulse-ring 2s infinite;"></div>
        </div>
        <div class="ma-hotspot" style="position:absolute; bottom:40%; right:30%; z-index:3;">
          <div style="width:16px; height:16px; background:#3B82F6; border-radius:50%; box-shadow:0 0 0 6px rgba(59,130,246,0.3); animation:ma-pulse-ring 2s infinite 1s;"></div>
        </div>
        
      </div>
      
    </div>
  </div>

  <style>
    .ma-btn-primary:hover { background: #2563EB; box-shadow: 0 10px 30px rgba(59,130,246,0.4); transform: translateY(-2px); }
    @keyframes ma-pulse-ring { 0% { box-shadow:0 0 0 0 rgba(59,130,246,0.6); } 100% { box-shadow:0 0 0 15px rgba(59,130,246,0); } }
    
    @media (max-width: 990px) {
      .ma-featured-grid { grid-template-columns: 1fr; gap: 60px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Mobile Featured",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FLAGSHIP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "MagPro Wireless Station"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW SPECS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Mobile Featured"
    }
  ]
}
{% endschema %}
