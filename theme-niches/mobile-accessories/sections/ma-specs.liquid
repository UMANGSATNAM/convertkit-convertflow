<div style="background:#0F1115; padding:100px 24px; position:relative; overflow:hidden; border-top:1px solid rgba(255,255,255,0.05);">
  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <div style="display:inline-block; font-family:'Inter', sans-serif; font-size:12px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:#3B82F6; margin-bottom:24px; background:rgba(59,130,246,0.1); padding:8px 16px; border-radius:4px;">
        {{ section.settings.eyebrow }}
      </div>
      <h2 style="font-family:'Inter', sans-serif; font-size:clamp(32px, 4vw, 48px); font-weight:800; color:#FFFFFF; margin:0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="ma-specs-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:24px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#1A1D24; padding:40px; border-radius:8px; border:1px solid rgba(255,255,255,0.05); position:relative; overflow:hidden; group" class="ma-spec-card">
          
          <div style="position:absolute; top:0; left:0; width:100%; height:2px; background:linear-gradient(90deg, #3B82F6, transparent); opacity:0; transition:opacity 0.3s ease;" class="ma-spec-line"></div>
          
          <div style="width:48px; height:48px; border-radius:8px; background:rgba(59,130,246,0.1); display:flex; align-items:center; justify-content:center; margin-bottom:24px; color:#3B82F6;">
            {%- assign idx = forloop.index | modulo: 3 -%}
            {%- if idx == 1 -%}
              <svg style="width:24px; height:24px; fill:currentColor;" viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2zm0 4.5l6.5 13.5h-13L12 6.5z"/></svg>
            {%- elsif idx == 2 -%}
              <svg style="width:24px; height:24px; fill:currentColor;" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3"/></svg>
            {%- else -%}
              <svg style="width:24px; height:24px; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><path d="M4 4h16v16H4z"/><path d="M4 12h16M12 4v16"/></svg>
            {%- endif -%}
          </div>
          
          <h3 style="font-family:'Inter', sans-serif; font-size:20px; font-weight:700; color:#FFFFFF; margin:0 0 16px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Inter', sans-serif; font-size:15px; font-weight:400; color:#9CA3AF; line-height:1.6; margin:0;">
            {{ block.settings.desc }}
          </p>
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .ma-spec-card:hover { border-color: rgba(59,130,246,0.3); transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    .ma-spec-card:hover .ma-spec-line { opacity: 1; }
    
    @media (max-width: 990px) {
      .ma-specs-grid { grid-template-columns: 1fr; gap: 24px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Mobile Specs",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "TECHNOLOGY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Uncompromising Quality"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Specification",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Aramid Fiber"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "5x stronger than steel, exceptionally lightweight and heat resistant."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mobile Specs",
      "blocks": [
        { "type": "spec" },
        { "type": "spec" },
        { "type": "spec" }
      ]
    }
  ]
}
{% endschema %}
