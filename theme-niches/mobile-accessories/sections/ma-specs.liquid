<div style="padding:80px 20px;background:#171819;border-bottom:1px solid var(--ma-border)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="ma-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(28px,4vw,48px);font-weight:700;color:var(--ma-white);margin-bottom:20px;line-height:1.1;letter-spacing:-0.02em;text-transform:uppercase">{{ section.settings.heading }}</h2>
    <p style="font-family:'Inter',sans-serif;font-size:15px;color:var(--ma-muted);line-height:1.7;max-width:440px;font-weight:500">{{ section.settings.body }}</p>
    <div class="ma-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="ma-stat" style="border-color:var(--ma-orange);background:rgba(247,127,0,0.05)" {{ block.shopify_attributes }}><div class="ma-stat__num" style="color:var(--ma-orange)">{{ block.settings.number }}</div><div class="ma-stat__label" style="color:var(--ma-white)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:6px;border:1px solid var(--ma-orange);object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:1.1;background:rgba(255,255,255,0.02);border-radius:6px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Accessories Specs","settings":[{"type":"text","id":"eyebrow","label":"ARMOUR METRICS"},{"type":"text","id":"heading","label":"Heading","default":"Impact Absorption."},{"type":"textarea","id":"body","label":"Body","default":"Our proprietary molecular polymer structure instantly hardens upon impact, dispersing kinetic force cleanly away from the glass screen."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"0%"},{"type":"text","id":"label","label":"Label","default":"Chemicals"}]}],"presets":[{"name":"Accessories Specs","blocks":[{"type":"stat","settings":{"number":"15 Ft","label":"Drop Rating"}},{"type":"stat","settings":{"number":"15W","label":"Mag Charging"}},{"type":"stat","settings":{"number":"0.9mm","label":"Bezel Guard"}},{"type":"stat","settings":{"number":"0.2s","label":"Snap Connect"}}]}]}
{% endschema %}
