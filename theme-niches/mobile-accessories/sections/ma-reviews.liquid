<div style="padding:80px 20px;background:var(--ma-dark);border-bottom:1px solid var(--ma-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="ma-section-header"><span class="ma-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="ma-review-grid">{%- for block in section.blocks -%}<div class="ma-review-card" {{ block.shopify_attributes }}><div class="ma-review-card__stars">★★★★★</div><div class="ma-review-card__text">"{{ block.settings.quote }}"</div><div class="ma-review-card__author">{{ block.settings.name }}</div><div class="ma-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Accessories Reviews","settings":[{"type":"text","id":"eyebrow","label":"CYBER FEEDBACK"},{"type":"text","id":"heading","label":"Heading","default":"Verified Armour Log"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Accessories Reviews","blocks":[{"type":"review","settings":{"quote":"Dropped my phone from a balcony onto pure concrete. Absolutely zero damage. The bumper structure works miracles.","name":"Rohan M.","product":"Aerospace Titanium Bumper Case"}},{"type":"review","settings":{"quote":"Snap-connection is incredibly solid. Charging rates hit 15W instantly and thermal dispersion is superb.","name":"Akash S.","product":"Mag-Safe Wireless Charger"}},{"type":"review","settings":{"quote":"Beautiful metallic gray tint. It preserves the clean industrial look of the phone while offering solid, tactile grip.","name":"Priya K.","product":"Industrial Silver Matte Case"}}]}]}
{% endschema %}
