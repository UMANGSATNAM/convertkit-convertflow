<div style="background:#0F1115; padding:120px 24px; position:relative; overflow:hidden;">
  
  <div style="position:absolute; top:0; left:50%; transform:translateX(-50%); width:100%; max-width:800px; height:400px; background:radial-gradient(ellipse at top, rgba(59,130,246,0.1) 0%, transparent 70%);"></div>

  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Inter', sans-serif; font-size:clamp(32px, 4vw, 48px); font-weight:800; color:#FFFFFF; margin:0 0 16px 0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
      <div style="font-family:'Inter', sans-serif; font-size:16px; color:#9CA3AF;">Trusted by over 100,000 professionals worldwide.</div>
    </div>

    <div class="ma-reviews-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:24px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#1A1D24; padding:40px; border-radius:8px; border:1px solid rgba(255,255,255,0.05); position:relative; transition:transform 0.3s ease, border-color 0.3s ease;" class="ma-review-card">
          
          <div style="display:flex; gap:4px; margin-bottom:24px;">
            <svg style="width:16px; height:16px; fill:#3B82F6;" viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
            <svg style="width:16px; height:16px; fill:#3B82F6;" viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
            <svg style="width:16px; height:16px; fill:#3B82F6;" viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
            <svg style="width:16px; height:16px; fill:#3B82F6;" viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
            <svg style="width:16px; height:16px; fill:#3B82F6;" viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
          </div>
          
          <p style="font-family:'Inter', sans-serif; font-size:16px; font-weight:400; line-height:1.6; color:#FFFFFF; margin:0 0 32px 0;">
            "{{ block.settings.quote }}"
          </p>
          
          <div style="display:flex; align-items:center; gap:16px;">
            <div style="width:40px; height:40px; background:#0F1115; border-radius:50%; border:1px solid rgba(255,255,255,0.1); display:flex; align-items:center; justify-content:center; color:#FFFFFF; font-family:'Inter', sans-serif; font-weight:700; font-size:14px;">
              {{ block.settings.name | slice: 0, 1 }}
            </div>
            <div>
              <div style="font-family:'Inter', sans-serif; font-size:14px; font-weight:700; color:#FFFFFF;">
                {{ block.settings.name }}
              </div>
              <div style="font-family:'Inter', sans-serif; font-size:12px; color:#9CA3AF; display:flex; align-items:center; gap:4px; margin-top:4px;">
                <svg style="width:12px; height:12px; fill:#3B82F6;" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                Verified Buyer
              </div>
            </div>
          </div>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .ma-review-card:hover { transform: translateY(-5px); border-color: rgba(59,130,246,0.3); box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    
    @media (max-width: 990px) {
      .ma-reviews-grid { grid-template-columns: 1fr; gap: 24px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Mobile Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Verified Performance"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The magnetic strength is unmatched. Feels incredibly premium in hand."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "ALEX M."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mobile Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
