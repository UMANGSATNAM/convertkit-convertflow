<div style="background:#0F1115; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px; border-bottom:1px solid rgba(255,255,255,0.1); padding-bottom:24px;">
      <div>
        <div style="display:inline-block; font-family:'Inter', sans-serif; font-size:12px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:#3B82F6; margin-bottom:16px;">
          {{ section.settings.eyebrow }}
        </div>
        <h2 style="font-family:'Inter', sans-serif; font-size:clamp(32px, 4vw, 48px); font-weight:800; color:#FFFFFF; margin:0; line-height:1; letter-spacing:-1px;">
          {{ section.settings.heading }}
        </h2>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Inter', sans-serif; font-size:13px; font-weight:600; color:#3B82F6; text-decoration:none; text-transform:uppercase; letter-spacing:2px; display:flex; align-items:center; gap:8px;" class="ma-link-hover">
          {{ section.settings.cta_label }}
          <svg style="width:16px; height:16px; fill:currentColor;" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="square" fill="none"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="ma-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:24px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1601524909162-ae8725290836?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1601524909162-ae8725290836?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1583394838336-acd977736f90?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1585298723682-7115561c51b7?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="ma-product-card" style="group">
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; border-radius:8px; background:#1A1D24; padding-bottom:100%; margin-bottom:20px; border:1px solid rgba(255,255,255,0.05);">
            <img src="{{ img_url }}" alt="Tech Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:contain; padding:20px; transition:transform 0.5s ease;" class="ma-product-img" loading="lazy">
            
            <div style="position:absolute; top:16px; left:16px; background:rgba(59,130,246,0.2); color:#3B82F6; font-family:'Inter', sans-serif; font-size:10px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:4px 8px; border-radius:4px; border:1px solid rgba(59,130,246,0.3);">
              {% if idx == 1 %}New{% elsif idx == 2 %}Bestseller{% else %}MagSafe{% endif %}
            </div>

            <div style="position:absolute; bottom:16px; right:16px; width:40px; height:40px; background:#3B82F6; border-radius:50%; display:flex; align-items:center; justify-content:center; opacity:0; transform:translateY(10px); transition:all 0.3s ease;" class="ma-product-add">
              <svg style="width:20px; height:20px; fill:#FFFFFF;" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
            </div>
          </a>
          
          <div style="font-family:'Inter', sans-serif; font-size:12px; font-weight:600; color:#9CA3AF; margin-bottom:8px; text-transform:uppercase; letter-spacing:1px;">
            {% if idx == 1 %}Charging{% elsif idx == 2 %}Protection{% elsif idx == 3 %}Audio{% else %}Mounts{% endif %}
          </div>
          <h3 style="font-family:'Inter', sans-serif; font-size:18px; font-weight:700; color:#FFFFFF; margin:0 0 8px 0; letter-spacing:-0.5px;">
            {% if idx == 1 %}MagPro Station{% elsif idx == 2 %}Aramid Case{% elsif idx == 3 %}Sonic Pods Pro{% else %}Auto Mount{% endif %}
          </h3>
          <div style="font-family:'Inter', sans-serif; font-size:16px; font-weight:500; color:#3B82F6;">
            {% if idx == 1 %}$129.00{% elsif idx == 2 %}$59.00{% elsif idx == 3 %}$199.00{% else %}$45.00{% endif %}
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .ma-product-card:hover .ma-product-img { transform: scale(1.1); }
    .ma-product-card:hover .ma-product-add { opacity: 1; transform: translateY(0); box-shadow: 0 5px 15px rgba(59,130,246,0.4); }
    .ma-link-hover:hover { opacity: 0.8; }
    
    @media (max-width: 1024px) {
      .ma-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px 20px !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Mobile Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BEST SELLERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Top Rated"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Mobile Collection"
    }
  ]
}
{% endschema %}
