<div style="background:#0F1115; padding:100px 24px; position:relative;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px; border-bottom:1px solid rgba(255,255,255,0.1); padding-bottom:24px;">
      <h2 style="font-family:'Inter', sans-serif; font-size:clamp(32px, 4vw, 48px); font-weight:800; color:#FFFFFF; margin:0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
      <a href="/collections" style="font-family:'Inter', sans-serif; font-size:13px; font-weight:600; color:#3B82F6; text-transform:uppercase; letter-spacing:2px; text-decoration:none; display:flex; align-items:center; gap:8px;" class="ma-link-hover">
        Explore All
        <svg style="width:16px; height:16px; fill:currentColor;" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="square" fill="none"/></svg>
      </a>
    </div>

    <div class="ma-category-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:24px;">
      
      {%- for block in section.blocks -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1601524909162-ae8725290836?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1601524909162-ae8725290836?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1583394838336-acd977736f90?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1585298723682-7115561c51b7?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <a href="{{ block.settings.link | default: '#' }}" class="ma-cat-card" style="display:block; text-decoration:none; position:relative; overflow:hidden; border-radius:8px; background:#1A1D24; border:1px solid rgba(255,255,255,0.05); group">
          <div style="aspect-ratio:4/5; position:relative;">
            <img src="{{ block.settings.image | image_url: width: 600 | default: img_url }}" alt="{{ block.settings.title }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.6; transition:all 0.5s ease;" class="ma-cat-img" loading="lazy">
            <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(15,17,21,1) 0%, rgba(15,17,21,0) 60%);"></div>
          </div>
          
          <div style="position:absolute; bottom:0; left:0; width:100%; padding:24px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <h3 style="font-family:'Inter', sans-serif; font-size:18px; font-weight:700; color:#FFFFFF; margin:0;" class="ma-cat-title">
                {{ block.settings.title }}
              </h3>
              <div style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.1); display:flex; align-items:center; justify-content:center; transition:background 0.3s ease;" class="ma-cat-icon">
                <svg style="width:16px; height:16px; fill:none; stroke:#FFFFFF; stroke-width:2;" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="square"/></svg>
              </div>
            </div>
          </div>
        </a>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .ma-cat-card:hover { border-color: rgba(59,130,246,0.5); box-shadow: 0 10px 30px rgba(59,130,246,0.1); }
    .ma-cat-card:hover .ma-cat-img { opacity: 0.8; transform: scale(1.05); }
    .ma-cat-card:hover .ma-cat-icon { background: #3B82F6; }
    .ma-link-hover:hover { opacity: 0.8; }
    
    @media (max-width: 990px) {
      .ma-category-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Mobile Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ecosystem"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mobile Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
