<div class="ma-hero">
  <div class="ma-hero__content">
    <span class="ma-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="ma-hero__title">{{ section.settings.heading }}</h1>
    <p class="ma-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="ma-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/drop-tests' }}" class="ma-btn ma-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="ma-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--ma-orange)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Accessories Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"MILITARY GRADE MIL-STD-810H CERTIFIED"},{"type":"text","id":"heading","label":"High Precision Titanium Armour"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Reinforced aerospace titanium shells engineered for extreme impact protection. 15ft drop-tested and mag-safe charging ready."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"EXPLORE ARMOUR"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"DROP LOGS"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Accessories Hero"}]}
{% endschema %}
