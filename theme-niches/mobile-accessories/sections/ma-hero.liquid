<div style="background:#0F1115; color:#FFFFFF; position:relative; overflow:hidden; min-height:90vh; display:flex; align-items:center;">
  
  <!-- Tech Grid Background -->
  <div style="position:absolute; inset:0; z-index:1; opacity:0.05; background-image:linear-gradient(#3B82F6 1px, transparent 1px), linear-gradient(90deg, #3B82F6 1px, transparent 1px); background-size:50px 50px;"></div>

  <div style="max-width:1440px; margin:0 auto; width:100%; padding:40px 24px; position:relative; z-index:2;">
    <div class="ma-hero-grid" style="display:grid; grid-template-columns:1fr 1.2fr; gap:60px; align-items:center;">
      
      <!-- Content -->
      <div style="padding-right:40px;">
        <div style="display:inline-flex; align-items:center; gap:12px; font-family:'Inter', sans-serif; font-size:12px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:#3B82F6; margin-bottom:24px; background:rgba(59,130,246,0.1); padding:8px 16px; border-radius:4px; border:1px solid rgba(59,130,246,0.2);">
          <div style="width:6px; height:6px; background:#3B82F6; border-radius:50%; box-shadow:0 0 10px #3B82F6; animation:ma-pulse 2s infinite;"></div>
          {{ section.settings.eyebrow }}
        </div>

        <h1 style="font-family:'Inter', sans-serif; font-size:clamp(48px, 6vw, 72px); font-weight:800; line-height:1.05; letter-spacing:-1px; margin:0 0 24px 0;">
          {{ section.settings.heading }}
        </h1>
        
        <p style="font-family:'Inter', sans-serif; font-size:clamp(16px, 2vw, 18px); font-weight:400; color:#9CA3AF; line-height:1.6; margin:0 0 40px 0; max-width:480px;">
          {{ section.settings.subheading }}
        </p>

        <div class="ma-hero-actions" style="display:flex; gap:16px; align-items:center;">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#3B82F6; color:#FFFFFF; font-family:'Inter', sans-serif; font-size:14px; font-weight:600; letter-spacing:1px; text-transform:uppercase; text-decoration:none; padding:18px 40px; border-radius:4px; transition:all 0.3s ease; box-shadow:0 10px 20px rgba(59,130,246,0.2);" class="ma-btn-primary">
              {{ section.settings.cta_label }}
            </a>
          {%- endif -%}
          
          {%- if section.settings.cta_label_2 != blank -%}
            <a href="{{ section.settings.cta_url_2 | default: '/collections/ecosystem' }}" style="display:inline-flex; align-items:center; justify-content:center; background:rgba(255,255,255,0.05); color:#FFFFFF; font-family:'Inter', sans-serif; font-size:14px; font-weight:600; letter-spacing:1px; text-transform:uppercase; text-decoration:none; padding:18px 40px; border-radius:4px; border:1px solid rgba(255,255,255,0.1); transition:all 0.3s ease;" class="ma-btn-secondary">
              {{ section.settings.cta_label_2 }}
            </a>
          {%- endif -%}
        </div>
      </div>
      
      <!-- Visuals -->
      <div style="position:relative; height:100%; min-height:600px; display:flex; justify-content:center; align-items:center;">
        
        <!-- Glowing orb behind -->
        <div style="position:absolute; width:60%; height:60%; background:#3B82F6; filter:blur(120px); opacity:0.2; z-index:1;"></div>

        <div style="position:relative; z-index:2; width:100%; height:100%; display:flex; justify-content:center; align-items:center;">
          <img src="https://images.unsplash.com/photo-1611186871348-b1ce696e52c9?auto=format&fit=crop&w=800&q=80" alt="Tech Accessories" style="width:85%; height:auto; object-fit:cover; filter:drop-shadow(0 30px 40px rgba(0,0,0,0.5));" class="ma-hero-img" loading="eager">
        </div>
        
        <!-- Floating Specs -->
        <div style="position:absolute; z-index:3; top:20%; right:0; background:rgba(15,17,21,0.8); backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,0.1); padding:16px 24px; border-radius:8px; animation:ma-float 4s ease-in-out infinite;">
          <div style="font-family:'Inter', sans-serif; font-size:11px; font-weight:600; letter-spacing:1px; color:#9CA3AF; margin-bottom:4px;">OUTPUT</div>
          <div style="font-family:'Inter', sans-serif; font-size:18px; font-weight:700; color:#FFFFFF;">15W MagSafe</div>
        </div>
        
        <div style="position:absolute; z-index:3; bottom:20%; left:10%; background:rgba(15,17,21,0.8); backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,0.1); padding:16px 24px; border-radius:8px; animation:ma-float 5s ease-in-out infinite 1s;">
          <div style="font-family:'Inter', sans-serif; font-size:11px; font-weight:600; letter-spacing:1px; color:#9CA3AF; margin-bottom:4px;">MATERIAL</div>
          <div style="font-family:'Inter', sans-serif; font-size:18px; font-weight:700; color:#FFFFFF;">Aramid Fiber</div>
        </div>

      </div>
      
    </div>
  </div>

  <style>
    .ma-btn-primary:hover { background: #2563EB; box-shadow: 0 10px 30px rgba(59,130,246,0.4); transform: translateY(-2px); }
    .ma-btn-secondary:hover { background: rgba(255,255,255,0.1); transform: translateY(-2px); }
    @keyframes ma-pulse { 0% { opacity:1; box-shadow:0 0 0 0 rgba(59,130,246,0.7); } 70% { opacity:0.5; box-shadow:0 0 0 10px rgba(59,130,246,0); } 100% { opacity:1; box-shadow:0 0 0 0 rgba(59,130,246,0); } }
    @keyframes ma-float { 0% { transform: translateY(0); } 50% { transform: translateY(-10px); } 100% { transform: translateY(0); } }
    
    @media (max-width: 990px) {
      .ma-hero-grid { grid-template-columns: 1fr; gap: 40px; text-align: center; }
      .ma-hero-grid > div:first-child { padding-right: 0; }
      .ma-hero-actions { justify-content: center; }
      .ma-hero-grid > div:last-child { min-height: 400px; justify-content: center; }
    }
    @media (max-width: 640px) {
      .ma-hero-actions { flex-direction: column; width: 100%; align-items: stretch; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Mobile Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NEXT-GEN PROTECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered for the Extraordinary"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Military-grade materials meet minimalist design. Elevate your device with premium accessories built for the modern ecosystem."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary Button Label",
      "default": "SHOP NEW ARRIVALS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "cta_label_2",
      "label": "Secondary Button Label",
      "default": "EXPLORE ECOSYSTEM"
    },
    {
      "type": "url",
      "id": "cta_url_2",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Mobile Hero"
    }
  ]
}
{% endschema %}
