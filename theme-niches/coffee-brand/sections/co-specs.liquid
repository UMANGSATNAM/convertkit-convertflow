<div style="padding:80px 20px;background:var(--co-dark)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="co-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Outfit',sans-serif;font-size:clamp(28px,4vw,48px);font-weight:800;color:var(--co-cream);margin-bottom:20px;line-height:1.05;text-transform:uppercase">{{ section.settings.heading }}</h2>
    <p style="font-family:'Outfit',sans-serif;font-size:15px;color:var(--co-muted);line-height:1.6;max-width:440px;font-weight:500">{{ section.settings.body }}</p>
    <div class="co-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="co-stat" style="border-color:rgba(45,32,25,0.15);background:rgba(255,255,255,0.02)" {{ block.shopify_attributes }}><div class="co-stat__num" style="color:var(--co-accent)">{{ block.settings.number }}</div><div class="co-stat__label" style="color:var(--co-muted)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:4px;border:1px solid var(--co-border);object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:1;background:var(--co-border)"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Coffee Specs","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ROASTERY TECHNICALS"},{"type":"text","id":"heading","label":"Heading","default":"Nitrogen Flushed Bags."},{"type":"textarea","id":"body","label":"Body","default":"Our roasted coffee is flushed with nitrogen gas before sealing to expel oxygen, preserving volatile aromatic oils for months."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"84+"},{"type":"text","id":"label","label":"Label","default":"SCA Cup Score"}]}],"presets":[{"name":"Coffee Specs","blocks":[{"type":"stat","settings":{"number":"84+","label":"SCA Cup Score"}},{"type":"stat","settings":{"number":"100%","label":"Arabica Grade"}},{"type":"stat","settings":{"number":"12 min","label":"Drum Roasted"}},{"type":"stat","settings":{"number":"Direct","label":"Trade Origin"}}]}]}
{% endschema %}
