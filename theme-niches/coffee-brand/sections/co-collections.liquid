<div style="padding:80px 20px;background:#fff;border-bottom:1px solid var(--co-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="co-section-header"><span class="co-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="co-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="co-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--co-accent)"></div>{%- endif -%}<div class="co-col-card__overlay"><span class="co-col-card__title">{{ block.settings.title }}</span><span class="co-col-card__cta">Explore Roasts →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Coffee Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ORIGIN SELECTION"},{"type":"text","id":"heading","label":"Heading","default":"Roasts by Type"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Single Origin"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Coffee Collections","blocks":[{"type":"col","settings":{"title":"Single Origin Arabica"}},{"type":"col","settings":{"title":"Signature Espresso Blends"}},{"type":"col","settings":{"title":"Cold Brew Micro Batches"}}]}]}
{% endschema %}
