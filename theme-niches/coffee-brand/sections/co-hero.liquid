<div class="co-hero">
  <div class="co-hero__content">
    <span class="co-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="co-hero__title">{{ section.settings.heading }}</h1>
    <p class="co-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="co-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="co-btn co-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="co-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--co-accent)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Coffee Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SINGLE ORIGIN ROASTS"},{"type":"text","id":"heading","label":"Slow Roasted Coffee Beans"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Direct-trade organic Arabica beans micro-roasted in drum roasters and nitrogen flushed for peak freshness."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"SHOP BEANS"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"OUR ROASTERY"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Coffee Hero"}]}
{% endschema %}
