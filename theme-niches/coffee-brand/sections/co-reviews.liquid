<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="co-section-header"><span class="co-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="co-review-grid">{%- for block in section.blocks -%}<div class="co-review-card" {{ block.shopify_attributes }}><div class="co-review-card__stars">★★★★★</div><div class="co-review-card__text">"{{ block.settings.quote }}"</div><div class="co-review-card__author">{{ block.settings.name }}</div><div class="co-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Coffee Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ROASTERY REVIEWS"},{"type":"text","id":"heading","label":"Heading","default":"Roastery Reviews"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Coffee Reviews","blocks":[{"type":"review","settings":{"quote":"Superb light roast. Very clean citric acidity with distinct notes of jasmine and honey.","name":"Clint B.","product":"Ethiopian Yirgacheffe Roast"}},{"type":"review","settings":{"quote":"The signature espresso blend yields an exceptionally thick crema with chocolatey depth.","name":"Sarah J.","product":"Signature Espresso Blend"}},{"type":"review","settings":{"quote":"Incredibly smooth cold brew. Zero bitterness and very rich caramel notes.","name":"Dave M.","product":"Cold Brew Coffee Can"}}]}]}
{% endschema %}
