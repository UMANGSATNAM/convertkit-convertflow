<div style="background:#fff; padding:40px 0; border-bottom:1px solid #eee;">
  <div class="page-width" style="max-width:1320px; margin:0 auto; padding:0 24px;">
    
    <div class="cl-trust-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:24px;">
      {%- for block in section.blocks -%}
        <div style="display:flex; align-items:center; gap:16px; background:#F6EFFB; padding:20px; border-radius:12px;" {{ block.shopify_attributes }}>
          <div style="flex-shrink:0; width:48px; height:48px; background:#fff; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#493161; box-shadow:0 4px 12px rgba(73, 49, 97, 0.08);">
            {%- case block.settings.icon -%}
              {%- when 'diamond' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              {%- when 'shield' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {%- when 'refresh' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
              {%- when 'home' -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              {%- else -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
            {%- endcase -%}
          </div>
          <div>
            <h3 style="font-size:14px; font-weight:700; color:#493161; margin-bottom:4px;">{{ block.settings.title }}</h3>
            <p style="font-size:12px; color:#666; line-height:1.4;">{{ block.settings.desc }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
    
  </div>

  <style>
    @media (max-width: 1024px) {
      .cl-trust-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
    @media (max-width: 480px) {
      .cl-trust-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "CaratLane Trust Badges",
  "settings": [],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {"value":"diamond","label":"Diamond"},
            {"value":"shield","label":"Shield"},
            {"value":"refresh","label":"Refresh"},
            {"value":"home","label":"Home"}
          ],
          "default": "diamond"
        },
        {"type":"text","id":"title","label":"Title","default":"BIS Hallmarked"},
        {"type":"text","id":"desc","label":"Description","default":"100% certified purity"}
      ]
    }
  ],
  "presets": [
    {
      "name": "CaratLane Trust Badges",
      "blocks": [
        {"type":"badge","settings":{"icon":"diamond","title":"BIS Hallmarked","desc":"100% certified purity"}},
        {"type":"badge","settings":{"icon":"shield","title":"Lifetime Exchange","desc":"Full value exchange policy"}},
        {"type":"badge","settings":{"icon":"refresh","title":"15-Day Returns","desc":"No questions asked"}},
        {"type":"badge","settings":{"icon":"home","title":"Try at Home","desc":"Free trial before you buy"}}
      ]
    }
  ]
}
{% endschema %}
