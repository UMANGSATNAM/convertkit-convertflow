<div class="cl-trust">
  <div class="cl-trust__grid">
    {%- for block in section.blocks -%}
    <div class="cl-trust__item" {{ block.shopify_attributes }}>
      <div class="cl-trust__icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          {%- case block.settings.icon -%}
            {%- when 'diamond' -%}<path d="M6 3h12l4 6-10 13L2 9z"/>{%- when 'shield' -%}<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>{%- when 'refresh' -%}<polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>{%- when 'home' -%}<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>{%- else -%}<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>{%- endcase -%}
        </svg>
      </div>
      <div class="cl-trust__title">{{ block.settings.title }}</div>
      <div class="cl-trust__desc">{{ block.settings.desc }}</div>
    </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "CL Trust",
  "settings": [],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {"type":"select","id":"icon","label":"Icon","options":[{"value":"diamond","label":"Diamond"},{"value":"shield","label":"Shield"},{"value":"refresh","label":"Exchange"},{"value":"home","label":"Home Trial"},{"value":"check","label":"Checkmark"}],"default":"diamond"},
        {"type":"text","id":"title","label":"Title","default":"BIS Hallmarked"},
        {"type":"text","id":"desc","label":"Description","default":"Certified purity guarantee"}
      ]
    }
  ],
  "presets": [{
    "name": "CL Trust",
    "blocks": [
      {"type":"badge","settings":{"icon":"diamond","title":"BIS Hallmarked","desc":"100% certified purity"}},
      {"type":"badge","settings":{"icon":"shield","title":"Lifetime Exchange","desc":"Full value exchange policy"}},
      {"type":"badge","settings":{"icon":"refresh","title":"15-Day Returns","desc":"No questions asked"}},
      {"type":"badge","settings":{"icon":"home","title":"Try at Home","desc":"Free trial before you buy"}}
    ]
  }]
}
{% endschema %}
