<div style="background:#F6EFFB; margin:40px 24px; border-radius:24px; overflow:hidden;">
  <div class="page-width" style="max-width:1320px; margin:0 auto;">
    <div class="cl-tah-grid" style="display:grid; grid-template-columns:1fr 1fr; align-items:center;">
      
      <div style="padding:80px 64px;">
        {%- if section.settings.eyebrow != blank -%}
          <span style="font-size:12px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#885bb5; margin-bottom:16px; display:inline-flex; align-items:center; gap:8px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}
        
        <h2 style="font-family:'Playfair Display', serif; font-size:clamp(32px, 4vw, 48px); font-weight:700; color:#493161; line-height:1.2; margin-bottom:24px;">
          {{ section.settings.heading }}
        </h2>
        
        <p style="font-size:16px; line-height:1.6; color:#555; margin-bottom:40px; max-width:480px;">
          {{ section.settings.body }}
        </p>
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/pages/try-at-home' }}" class="cl-btn-primary" style="display:inline-flex; align-items:center; justify-content:center; background:#493161; color:#fff; padding:16px 36px; font-size:14px; font-weight:600; text-decoration:none; border-radius:8px; transition:all 0.3s ease; box-shadow:0 4px 12px rgba(73, 49, 97, 0.2);">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
      
      <div style="height:100%; min-height:400px; position:relative;">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', style: 'width:100%; height:100%; object-fit:cover; position:absolute; inset:0;' }}
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=800&q=80" alt="Try at Home" style="width:100%; height:100%; object-fit:cover; position:absolute; inset:0;" loading="lazy">
        {%- endif -%}
      </div>
      
    </div>
  </div>

  <style>
    .cl-btn-primary:hover {
      background: #3a274e !important;
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(73, 49, 97, 0.3) !important;
    }
    @media (max-width: 990px) {
      .cl-tah-grid { grid-template-columns: 1fr !important; text-align: center; }
      .cl-tah-grid > div:first-child { padding: 60px 24px !important; }
      .cl-tah-grid > div:first-child p { margin: 0 auto 40px; }
      .cl-tah-grid > div:last-child { min-height: 300px !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "CaratLane Try at Home",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "FREE SERVICE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Try at Home, Buy with Confidence"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body Text",
      "default": "Select up to 3 designs, try them in the comfort of your home, and only pay for what you love. Free delivery, free returns."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "Book Free Trial"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side Image"
    }
  ],
  "presets": [
    {
      "name": "CaratLane Try at Home"
    }
  ]
}
{% endschema %}
