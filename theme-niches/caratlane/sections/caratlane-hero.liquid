<div style="background:var(--cl-bg);min-height:85vh;display:flex;align-items:center;padding:60px 40px;position:relative">
  <div style="max-width:1200px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center">
    
    <div style="padding:40px">
      <h1 class="cl-head" style="font-size:clamp(48px, 6vw, 72px);margin-bottom:24px">
        {{ section.settings.heading | default: 'Everyday Fine Jewelry.' }}
      </h1>
      <p style="font-size:16px;line-height:1.6;color:var(--cl-muted);margin-bottom:40px;max-width:440px">
        {{ section.settings.text | default: 'Beautifully crafted, modern designs starting at ₹5,000. Made to be worn every single day.' }}
      </p>
      <div style="display:flex;gap:16px;align-items:center">
        <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="cl-btn">{{ section.settings.btn1_text | default: 'Shop New Arrivals' }}</a>
        <a href="{{ section.settings.btn2_url | default: '/pages/try-at-home' }}" class="cl-btn cl-btn-outline">{{ section.settings.btn2_text | default: 'Try at Home' }}</a>
      </div>
    </div>
    
    <div style="position:relative">
      <div style="position:relative;border-radius:24px;overflow:hidden;box-shadow:0 20px 40px rgba(0,0,0,0.05)">
        <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/caratlane-hero.jpg?v=1717283400" alt="Jewelry Hero" style="width:100%;height:auto;display:block">
      </div>
      
      <!-- Floating Badge -->
      <div style="position:absolute;top:-20px;right:-20px;background:#FFF;padding:16px 24px;border-radius:100px;box-shadow:0 10px 30px rgba(0,0,0,0.08);display:flex;align-items:center;gap:12px">
        <div style="width:12px;height:12px;background:var(--cl-accent);border-radius:50%"></div>
        <div style="font-family:var(--font-b);font-weight:600;font-size:14px;color:var(--cl-text)">14k Solid Gold</div>
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Caratlane Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everyday Fine Jewelry."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Beautifully crafted, modern designs starting at ₹5,000."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 Text",
      "default": "Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 Text",
      "default": "Try at Home"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Button 2 Link"
    }
  ],
  "presets": [
    {
      "name": "Caratlane Hero"
    }
  ]
}
{% endschema %}
