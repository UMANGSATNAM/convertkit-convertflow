<div style="background:var(--cl-bg);padding:80px 40px">
  <div style="max-width:1200px;margin:0 auto">
    
    <div style="text-align:center;margin-bottom:60px">
      <h2 class="cl-head" style="font-size:40px;margin-bottom:16px">{{ collection.title | default: 'Bestsellers' }}</h2>
      <p style="font-size:15px;color:var(--cl-muted);max-width:500px;margin:0 auto">Our most loved designs, curated just for you.</p>
    </div>
    
    <div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:24px">
      {%- for product in collection.products limit: 8 -%}
      <a href="{{ product.url }}" class="cl-card">
        <div class="image-wrapper">
          {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- else -%}
          <div style="width:100%;height:100%;background:#F0F0F0"></div>
          {%- endif -%}
        </div>
        <div class="title">{{ product.title }}</div>
        <div class="price">{{ product.price | money }}</div>
        <div class="cl-emi">from ₹1,200/mo</div>
      </a>
      {%- else -%}
      <!-- Demo State -->
      {%- for i in (1..8) -%}
      <a href="#" class="cl-card">
        <div class="image-wrapper">
          <div style="width:100%;height:100%;background:#F0F0F0"></div>
        </div>
        <div class="title">Rose Gold Diamond Ring V{{i}}</div>
        <div class="price">₹15,499</div>
        <div class="cl-emi">from ₹1,200/mo</div>
      </a>
      {%- endfor -%}
      {%- endfor -%}
    </div>
    
    <div style="text-align:center;margin-top:60px">
      <a href="/collections/all" class="cl-btn cl-btn-outline">View All Jewelry</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Caratlane Grid",
  "settings": [],
  "presets": [
    {
      "name": "Caratlane Grid"
    }
  ]
}
{% endschema %}
