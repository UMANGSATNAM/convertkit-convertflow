<div class="cl-hero">
  <div class="cl-hero__content">
    <p class="cl-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="cl-hero__title">{{ section.settings.heading }}</h1>
    <p class="cl-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:14px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="cl-btn cl-btn--rose">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}
      <a href="{{ section.settings.cta_url_2 | default: '/pages/try-at-home' }}" class="cl-btn cl-btn--outline">{{ section.settings.cta_label_2 }}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="cl-hero__visual">
    {%- if section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">
    {%- else -%}
    <div style="width:100%;height:100%;min-height:500px;background:linear-gradient(135deg,#FDF2F0,#E8B4B8);display:flex;align-items:center;justify-content:center">
      <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="rgba(28,28,28,0.15)" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
    </div>
    {%- endif -%}
    <div class="cl-hero__float">✨ Starting at ₹4,999</div>
  </div>
</div>
{% schema %}
{
  "name": "CaratLane Hero",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"A TANISHQ PARTNERSHIP"},
    {"type":"text","id":"heading","label":"Heading","default":"Diamonds for Every Day, Every You"},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Discover lightweight, everyday fine jewellery designed for the modern Indian woman. Try at home, buy with confidence."},
    {"type":"image_picker","id":"image","label":"Hero Image"},
    {"type":"text","id":"cta_label","label":"CTA","default":"Shop New Arrivals"},
    {"type":"url","id":"cta_url","label":"CTA URL"},
    {"type":"text","id":"cta_label_2","label":"Secondary CTA","default":"Try at Home"},
    {"type":"url","id":"cta_url_2","label":"Secondary URL"}
  ],
  "presets":[{"name":"CaratLane Hero"}]
}
{% endschema %}
