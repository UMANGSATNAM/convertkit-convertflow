<div style="background:linear-gradient(135deg,#fdfbfb,#ebedee); position:relative; overflow:hidden;">
  <div class="page-width" style="max-width:1320px; margin:0 auto; padding:0 24px;">
    <div class="cl-hero-grid" style="display:grid; grid-template-columns:1fr 1fr; min-height:560px; align-items:center; gap:40px; padding:60px 0;">
      
      <div class="cl-hero-content" style="z-index:2;">
        {%- if section.settings.eyebrow != blank -%}
          <span style="font-size:12px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#885bb5; margin-bottom:16px; display:block;">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}
        
        <h1 style="font-family:'Playfair Display', serif; font-size:clamp(40px, 5vw, 64px); font-weight:700; color:#493161; line-height:1.1; margin-bottom:24px;">
          {{ section.settings.heading | replace: '<em>', '<i style="font-style:italic; color:#885bb5;">' | replace: '</em>', '</i>' }}
        </h1>
        
        <p style="font-size:16px; line-height:1.6; color:#555; max-width:480px; margin-bottom:40px;">
          {{ section.settings.subheading }}
        </p>
        
        <div class="cl-hero-ctas" style="display:flex; gap:16px;">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="cl-btn-primary" style="display:inline-flex; align-items:center; justify-content:center; background:#493161; color:#fff; padding:14px 32px; font-size:14px; font-weight:600; text-decoration:none; border-radius:8px; transition:all 0.3s ease; box-shadow:0 4px 12px rgba(73, 49, 97, 0.2);">
              {{ section.settings.cta_label }}
            </a>
          {%- endif -%}
          
          {%- if section.settings.cta_label_2 != blank -%}
            <a href="{{ section.settings.cta_url_2 | default: '/pages/try-at-home' }}" class="cl-btn-secondary" style="display:inline-flex; align-items:center; justify-content:center; background:#fff; color:#493161; padding:14px 32px; font-size:14px; font-weight:600; text-decoration:none; border-radius:8px; border:1px solid #493161; transition:all 0.3s ease;">
              {{ section.settings.cta_label_2 }}
            </a>
          {%- endif -%}
        </div>
      </div>
      
      <div class="cl-hero-visual" style="position:relative; z-index:1;">
        <div style="position:absolute; inset:10% 0 -10% 10%; background:linear-gradient(135deg, #e0c3fc, #8ec5fc); border-radius:24px; opacity:0.3; filter:blur(40px);"></div>
        
        <div style="position:relative; background:#fff; border-radius:16px; padding:12px; box-shadow:0 20px 40px rgba(73, 49, 97, 0.1); transform:rotate(2deg); transition:transform 0.5s ease;" class="cl-hero-img-wrap">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'eager', style: 'width:100%; height:auto; border-radius:8px; display:block;' }}
          {%- else -%}
            <img src="https://images.unsplash.com/photo-1599643477874-c5a81026afdb?auto=format&fit=crop&w=800&q=80" alt="CaratLane Jewellery" style="width:100%; height:auto; border-radius:8px; display:block;" loading="eager">
          {%- endif -%}
          
          <div style="position:absolute; top:30px; left:-30px; background:#fff; padding:16px; border-radius:12px; box-shadow:0 10px 30px rgba(0,0,0,0.1); display:flex; align-items:center; gap:12px; transform:rotate(-4deg);">
            <div style="width:40px; height:40px; background:#F6EFFB; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#493161;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <div>
              <div style="font-size:12px; font-weight:700; color:#493161;">Try at Home</div>
              <div style="font-size:10px; color:#666;">Free Service</div>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>

  <style>
    .cl-btn-primary:hover {
      background: #3a274e !important;
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(73, 49, 97, 0.3) !important;
    }
    .cl-btn-secondary:hover {
      background: #F6EFFB !important;
    }
    .cl-hero-img-wrap:hover {
      transform: rotate(0deg) scale(1.02) !important;
    }
    @media (max-width: 768px) {
      .cl-hero-grid { grid-template-columns: 1fr !important; text-align: center; padding: 40px 0 !important; }
      .cl-hero-content { margin: 0 auto; }
      .cl-hero-content p { margin: 0 auto 32px; }
      .cl-hero-ctas { justify-content: center; }
      .cl-hero-visual .cl-hero-img-wrap > div { display: none !important; }
    }
    @media (max-width: 480px) {
      .cl-hero-ctas { flex-direction: column; width: 100%; }
      .cl-hero-ctas a { width: 100%; }
    }
  </style>
</div>

{% schema %}
{
  "name": "CaratLane Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "A TANISHQ PARTNERSHIP"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Diamonds for Every Day, <em>Every You</em>",
      "info": "Use <em> tags to italicize and highlight text."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover lightweight, everyday fine jewellery designed for the modern Indian woman. Try at home, buy with confidence."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary Button Label",
      "default": "Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "cta_label_2",
      "label": "Secondary Button Label",
      "default": "Try at Home"
    },
    {
      "type": "url",
      "id": "cta_url_2",
      "label": "Secondary Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "CaratLane Hero"
    }
  ]
}
{% endschema %}
