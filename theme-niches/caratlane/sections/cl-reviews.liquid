<div class="cl-reviews">
  <div class="cl-section-header">
    <p class="cl-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="cl-review-grid">
    {%- for block in section.blocks -%}
    <div class="cl-review-card" {{ block.shopify_attributes }}>
      <div class="cl-review-card__stars">{%- for i in (1..block.settings.rating) -%}★{%- endfor -%}</div>
      <div class="cl-review-card__text">"{{ block.settings.quote }}"</div>
      <div class="cl-review-card__author">{{ block.settings.name }}</div>
      <div class="cl-review-card__meta">{{ block.settings.product }} · {{ block.settings.location }}</div>
    </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "CL Reviews",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"HAPPY CUSTOMERS"},
    {"type":"text","id":"heading","label":"Heading","default":"What Our Community Says"}
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},
        {"type":"textarea","id":"quote","label":"Quote","default":"The Try at Home service was amazing. I could compare designs side by side!"},
        {"type":"text","id":"name","label":"Name","default":"Aditi S."},
        {"type":"text","id":"product","label":"Product","default":"Diamond Studs"},
        {"type":"text","id":"location","label":"Location","default":"Mumbai"}
      ]
    }
  ],
  "presets": [{
    "name": "CL Reviews",
    "blocks": [
      {"type":"review","settings":{"rating":5,"quote":"The Try at Home service was amazing! I could compare 3 designs side by side before choosing my dream ring.","name":"Aditi S.","product":"Solitaire Ring","location":"Mumbai"}},
      {"type":"review","settings":{"rating":5,"quote":"Perfect everyday earrings. So lightweight I forget I'm wearing them, yet I get compliments daily!","name":"Riya M.","product":"Diamond Hoops","location":"Bangalore"}},
      {"type":"review","settings":{"rating":5,"quote":"Gifted the mangalsutra to my wife — the modern design blew her away. CaratLane nailed it.","name":"Vikram P.","product":"Diamond Mangalsutra","location":"Pune"}}
    ]
  }]
}
{% endschema %}
