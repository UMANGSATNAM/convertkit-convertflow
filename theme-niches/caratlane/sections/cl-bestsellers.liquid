<div style="background:#fff; padding:80px 0;">
  <div class="page-width" style="max-width:1320px; margin:0 auto; padding:0 24px;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:40px;">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span style="font-size:12px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#885bb5; margin-bottom:12px; display:block;">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}
        <h2 style="font-family:'Playfair Display', serif; font-size:clamp(28px, 4vw, 36px); font-weight:700; color:#493161; margin-bottom:8px;">
          {{ section.settings.heading }}
        </h2>
        <p style="font-size:14px; color:#666;">
          {{ section.settings.subheading }}
        </p>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.collection.url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; gap:8px; color:#493161; font-size:14px; font-weight:600; text-decoration:none; padding-bottom:4px; border-bottom:2px solid #493161; transition:opacity 0.2s ease;" class="cl-view-all">
          {{ section.settings.cta_label }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </div>

    {%- assign col = collections[section.settings.collection] -%}
    <div class="cl-prod-grid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:24px;">
      {%- for product in col.products limit: section.settings.count -%}
        <div class="cl-prod-card" style="background:#fff; border-radius:8px; border:1px solid #eee; overflow:hidden; transition:all 0.3s ease; display:flex; flex-direction:column; position:relative;">
          
          <div style="position:absolute; top:12px; right:12px; z-index:2; background:#fff; width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; box-shadow:0 2px 8px rgba(0,0,0,0.1); color:#999; cursor:pointer;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          
          <a href="{{ product.url }}" style="display:block; text-decoration:none; color:inherit; flex-grow:1; display:flex; flex-direction:column;">
            <div style="position:relative; aspect-ratio:1; background:#f9f9f9; overflow:hidden;">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', style: 'width:100%; height:100%; object-fit:cover; mix-blend-mode:multiply;' }}
              {%- else -%}
                <div style="width:100%; height:100%; background:#f5f5f5;"></div>
              {%- endif -%}
            </div>
            
            <div style="padding:20px; display:flex; flex-direction:column; flex-grow:1;">
              <h3 style="font-size:14px; font-weight:500; color:#333; line-height:1.4; margin-bottom:12px; height:40px; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">{{ product.title | default: 'Elegant Diamond Solitaire Ring' }}</h3>
              
              <div style="margin-top:auto;">
                <div style="font-size:18px; font-weight:700; color:#493161; margin-bottom:16px;">{{ product.price | money | default: '₹24,999' }}</div>
                <button type="button" class="cl-prod-atc" style="width:100%; padding:12px; background:#fff; color:#493161; border:1px solid #493161; border-radius:6px; font-size:13px; font-weight:600; cursor:pointer; transition:all 0.3s ease;">Add to Cart</button>
              </div>
            </div>
          </a>
        </div>
      {%- else -%}
        <!-- Dummy placehoders -->
        {%- for i in (1..section.settings.count) -%}
          <div class="cl-prod-card" style="background:#fff; border-radius:8px; border:1px solid #eee; overflow:hidden; transition:all 0.3s ease; display:flex; flex-direction:column; position:relative;">
            <div style="position:absolute; top:12px; right:12px; z-index:2; background:#fff; width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; box-shadow:0 2px 8px rgba(0,0,0,0.1); color:#999;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </div>
            <div style="position:relative; aspect-ratio:1; background:#f9f9f9; display:flex; align-items:center; justify-content:center;">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ddd" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </div>
            <div style="padding:20px; display:flex; flex-direction:column; flex-grow:1;">
              <h3 style="font-size:14px; font-weight:500; color:#333; line-height:1.4; margin-bottom:12px; height:40px;">Elegant Diamond Ring</h3>
              <div style="margin-top:auto;">
                <div style="font-size:18px; font-weight:700; color:#493161; margin-bottom:16px;">₹24,999</div>
                <button type="button" class="cl-prod-atc" style="width:100%; padding:12px; background:#fff; color:#493161; border:1px solid #493161; border-radius:6px; font-size:13px; font-weight:600; cursor:pointer; transition:all 0.3s ease;">Add to Cart</button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
    
  </div>

  <style>
    .cl-view-all:hover { opacity: 0.7; }
    .cl-prod-card:hover {
      box-shadow: 0 12px 30px rgba(73, 49, 97, 0.08);
      transform: translateY(-4px);
    }
    .cl-prod-card:hover .cl-prod-atc {
      background: #493161;
      color: #fff;
    }
    @media (max-width: 1024px) {
      .cl-prod-grid { grid-template-columns: repeat(3, 1fr) !important; }
    }
    @media (max-width: 768px) {
      .cl-prod-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 16px !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "CaratLane Bestsellers",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"TRENDING NOW"},
    {"type":"text","id":"heading","label":"Heading","default":"Bestselling Designs"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Most loved pieces by our community"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"count","label":"Products to show","min":4,"max":12,"step":4,"default":4},
    {"type":"text","id":"cta_label","label":"Link Label","default":"View All Bestsellers"}
  ],
  "presets":[{"name":"CaratLane Bestsellers"}]
}
{% endschema %}
