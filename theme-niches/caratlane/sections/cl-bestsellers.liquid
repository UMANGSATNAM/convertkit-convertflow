<div class="cl-products">
  <div class="cl-section-header">
    <p class="cl-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>
  {%- assign col = collections[section.settings.collection] -%}
  <div class="cl-prod-grid">
    {%- for product in col.products limit: section.settings.count -%}
    <a href="{{ product.url }}" class="cl-prod-card">
      <div class="cl-prod-card__img">
        {%- if product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">
        {%- else -%}
        <div style="width:100%;height:100%;background:var(--cl-blush);display:flex;align-items:center;justify-content:center">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--cl-border)" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg>
        </div>
        {%- endif -%}
      </div>
      <div class="cl-prod-card__info">
        <div class="cl-prod-card__name">{{ product.title }}</div>
        <div class="cl-prod-card__price">{{ product.price | money }}</div>
        <div class="cl-prod-card__emi">EMI from ₹{{ product.price | divided_by: 100 | divided_by: 12 | money_without_currency }}/mo</div>
      </div>
    </a>
    {%- endfor -%}
  </div>
  <div style="text-align:center;margin-top:48px">
    <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="cl-btn">{{ section.settings.cta_label }}</a>
  </div>
</div>
{% schema %}
{
  "name": "CL Bestsellers",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"TRENDING NOW"},
    {"type":"text","id":"heading","label":"Heading","default":"Bestselling Designs"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Most loved pieces by our community"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"count","label":"Products","min":4,"max":12,"step":4,"default":8},
    {"type":"text","id":"cta_label","label":"CTA","default":"View All Bestsellers"},
    {"type":"url","id":"cta_url","label":"CTA URL"}
  ],
  "presets":[{"name":"CL Bestsellers"}]
}
{% endschema %}
