<div class="cl-occasions">
  <div class="cl-section-header">
    <p class="cl-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>
  <div class="cl-occ-grid">
    {%- for block in section.blocks -%}
    <a href="{{ block.settings.url | default: '/collections/all' }}" class="cl-occ-card" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
      <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" width="600" loading="lazy">
      {%- else -%}
      <div style="width:100%;height:100%;background:linear-gradient(135deg,var(--cl-blush),var(--cl-rose))"></div>
      {%- endif -%}
      <div class="cl-occ-card__overlay">
        <span class="cl-occ-card__title">{{ block.settings.title }}</span>
        <span class="cl-occ-card__sub">{{ block.settings.count }}</span>
      </div>
    </a>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "CL Occasions",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"SHOP BY OCCASION"},
    {"type":"text","id":"heading","label":"Heading","default":"For Every Moment"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Find the perfect piece for work, weekends, or celebrations"}
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        {"type":"text","id":"title","label":"Title","default":"Everyday Wear"},
        {"type":"text","id":"count","label":"Subtitle","default":"200+ designs"},
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"url","id":"url","label":"URL"}
      ]
    }
  ],
  "presets": [{
    "name": "CL Occasions",
    "blocks": [
      {"type":"occasion","settings":{"title":"Everyday Wear","count":"200+ designs"}},
      {"type":"occasion","settings":{"title":"Office Chic","count":"120+ designs"}},
      {"type":"occasion","settings":{"title":"Wedding Guest","count":"80+ designs"}},
      {"type":"occasion","settings":{"title":"Gifting","count":"150+ designs"}}
    ]
  }]
}
{% endschema %}
