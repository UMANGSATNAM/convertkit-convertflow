<div style="background:#fafafa; padding:80px 0;">
  <div class="page-width" style="max-width:1320px; margin:0 auto; padding:0 24px;">
    
    <div style="text-align:center; margin-bottom:48px;">
      {%- if section.settings.eyebrow != blank -%}
        <span style="font-size:12px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#885bb5; margin-bottom:12px; display:block;">
          {{ section.settings.eyebrow }}
        </span>
      {%- endif -%}
      <h2 style="font-family:'Playfair Display', serif; font-size:clamp(32px, 4vw, 40px); font-weight:700; color:#493161; margin-bottom:12px;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-size:15px; color:#666; max-width:500px; margin:0 auto;">
        {{ section.settings.subheading }}
      </p>
    </div>

    <div class="cl-occ-grid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:20px;">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.url | default: '/collections/all' }}" class="cl-occ-card" style="position:relative; overflow:hidden; border-radius:12px; aspect-ratio:3/4; display:block; text-decoration:none; box-shadow:0 4px 15px rgba(0,0,0,0.05);" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', style: 'width:100%; height:100%; object-fit:cover; transition:transform 0.6s ease;', class: 'cl-occ-img' }}
          {%- else -%}
            <!-- Placeholder -->
            <div class="cl-occ-img" style="width:100%; height:100%; background:linear-gradient(to bottom right, #d1c4e9, #b39ddb); transition:transform 0.6s ease;"></div>
          {%- endif -%}
          
          <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(73, 49, 97, 0.8) 0%, transparent 50%); display:flex; flex-direction:column; justify-content:flex-end; padding:24px;">
            <h3 style="font-size:20px; font-weight:600; color:#fff; margin-bottom:4px;">{{ block.settings.title }}</h3>
            {%- if block.settings.count != blank -%}
              <span style="font-size:12px; color:rgba(255,255,255,0.8);">{{ block.settings.count }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
    
  </div>

  <style>
    .cl-occ-card:hover .cl-occ-img {
      transform: scale(1.05);
    }
    @media (max-width: 768px) {
      .cl-occ-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
    @media (max-width: 480px) {
      .cl-occ-grid { gap: 12px !important; }
      .cl-occ-card { padding: 16px !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "CaratLane Categories",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"SHOP BY OCCASION"},
    {"type":"text","id":"heading","label":"Heading","default":"For Every Moment"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Find the perfect piece for work, weekends, or celebrations"}
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Category",
      "settings": [
        {"type":"text","id":"title","label":"Title","default":"Everyday Wear"},
        {"type":"text","id":"count","label":"Subtitle/Count","default":"200+ designs"},
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"url","id":"url","label":"Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "CaratLane Categories",
      "blocks": [
        {"type":"occasion","settings":{"title":"Everyday Wear","count":"200+ designs"}},
        {"type":"occasion","settings":{"title":"Office Chic","count":"120+ designs"}},
        {"type":"occasion","settings":{"title":"Wedding Guest","count":"80+ designs"}},
        {"type":"occasion","settings":{"title":"Gifting","count":"150+ designs"}}
      ]
    }
  ]
}
{% endschema %}
