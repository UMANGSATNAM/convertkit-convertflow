<div style="padding:48px 20px 0;background:var(--cl-blush)">
  <div style="max-width:1320px;margin:0 auto;text-align:center;padding-bottom:48px">
    <p class="cl-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</p>
    <h1 style="font-family:'DM Serif Display',serif;font-size:clamp(32px,5vw,52px);font-weight:400;color:var(--cl-charcoal);margin-bottom:12px">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<p style="font-size:16px;color:var(--cl-muted);max-width:560px;margin:0 auto;line-height:1.7">{{ collection.description }}</p>{%- endif -%}
  </div>
</div>
<div style="padding:0 20px 80px;background:#fff">
  <div style="max-width:1320px;margin:0 auto">
    <div style="display:flex;justify-content:space-between;align-items:center;padding:20px 0;border-bottom:1px solid var(--cl-border);margin-bottom:32px">
      <div style="font-size:14px;color:var(--cl-muted)">{{ collection.products_count }} designs</div>
      <select style="padding:8px 16px;border:1px solid var(--cl-border);border-radius:100px;font-size:13px;font-family:'Inter',sans-serif;cursor:pointer">
        <option>Recommended</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Newest</option>
      </select>
    </div>
    <div class="cl-prod-grid">
      {%- for product in collection.products -%}
      <a href="{{ product.url }}" class="cl-prod-card">
        <div class="cl-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--cl-blush)"></div>{%- endif -%}</div>
        <div class="cl-prod-card__info">
          <div class="cl-prod-card__name">{{ product.title }}</div>
          <div class="cl-prod-card__price">{{ product.price | money }}</div>
          <div class="cl-prod-card__emi">EMI from ₹{{ product.price | divided_by: 100 | divided_by: 12 | money_without_currency }}/mo</div>
        </div>
      </a>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{"name":"CL Collection","settings":[],"presets":[{"name":"CL Collection"}]}
{% endschema %}
