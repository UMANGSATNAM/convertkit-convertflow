<div style="background:#F5F5F0; padding:160px 24px;">
  <div style="max-width:1600px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:80px; flex-wrap:wrap; gap:24px;">
      <h2 style="font-family:'Montserrat', 'Futura', sans-serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; text-transform:uppercase; letter-spacing:-1px; color:#222222; margin:0;">
        {{ section.settings.heading }}
      </h2>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Montserrat', 'Futura', sans-serif; font-size:12px; font-weight:500; text-transform:uppercase; letter-spacing:3px; color:#222222; text-decoration:none; border-bottom:1px solid #222222; padding-bottom:8px; transition:opacity 0.3s ease;" class="mf-link-hover">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="mf-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:40px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1592078615290-033ee584e267?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1505843490538-5133c6c7d0e1?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1567016432779-094069958ea5?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1503602642458-232111445657?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1592078615290-033ee584e267?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <a href="#" class="mf-product-card" style="display:flex; flex-direction:column; text-decoration:none;">
          
          <div style="background:#E5E5DF; aspect-ratio:4/5; margin-bottom:24px; position:relative; overflow:hidden;">
            <img src="{{ img_url }}" alt="Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.8s ease;" class="mf-product-img" loading="lazy">
          </div>
          
          <h3 style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:16px; font-weight:400; color:#222222; margin:0 0 8px 0; display:flex; justify-content:space-between;">
            <span>{% if idx == 1 %}Lounge Chair{% elsif idx == 2 %}Side Table{% elsif idx == 3 %}Stool{% else %}Pendant Light{% endif %}</span>
            <span>{% if idx == 1 %}$1,250{% elsif idx == 2 %}$450{% elsif idx == 3 %}$320{% else %}$890{% endif %}</span>
          </h3>
          
          <div style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:14px; color:#555555;">
            {% if idx == 1 %}Walnut / Linen{% elsif idx == 2 %}Black Marble{% elsif idx == 3 %}Oak{% else %}Brass{% endif %}
          </div>
          
        </a>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .mf-link-hover:hover { opacity: 0.6; }
    .mf-product-card:hover .mf-product-img { transform: scale(1.05); }
    
    @media (max-width: 1024px) {
      .mf-product-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
    @media (max-width: 640px) {
      .mf-product-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Furniture Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP ALL"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Furniture Collection"
    }
  ]
}
{% endschema %}
