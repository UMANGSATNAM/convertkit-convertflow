<div style="background:#E5E5DF; color:#222222; padding:160px 24px;">
  <div style="max-width:1400px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
    
    <!-- Image -->
    <div style="position:relative; aspect-ratio:4/5;">
      <img src="https://images.unsplash.com/photo-1593696140826-c58b021acf8b?auto=format&fit=crop&w=800&q=80" alt="Design Studio" style="width:100%; height:100%; object-fit:cover; filter:grayscale(20%); transition:transform 0.8s ease;" class="mf-ed-img" loading="lazy">
    </div>

    <!-- Content -->
    <div style="padding-left:40px;">
      <h2 style="font-family:'Montserrat', 'Futura', sans-serif; font-size:clamp(40px, 5vw, 64px); font-weight:400; text-transform:uppercase; letter-spacing:-2px; margin:0 0 32px 0; line-height:1.1;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:18px; font-weight:300; color:#555555; line-height:1.7; margin:0 0 48px 0; max-width:480px;">
        {{ section.settings.subheading }}
      </p>
      
      <a href="/pages/studio" style="display:inline-flex; align-items:center; gap:16px; font-family:'Montserrat', 'Futura', sans-serif; font-size:12px; font-weight:500; text-transform:uppercase; letter-spacing:3px; color:#222222; text-decoration:none; transition:opacity 0.3s ease;" class="mf-link-hover">
        Read the Journal <span style="width:40px; height:1px; background:#222222;"></span>
      </a>
    </div>
    
  </div>

  <style>
    .mf-link-hover:hover { opacity: 0.6; }
    .mf-ed-img:hover { transform: scale(1.02); }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; gap: 60px; }
      div[style*="padding-left:40px;"] { padding-left: 0; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Furniture Editorial",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Studio"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore the creative process behind our latest seating collection. A study in proportion, materiality, and comfort."
    }
  ],
  "presets": [
    {
      "name": "Furniture Editorial"
    }
  ]
}
{% endschema %}
