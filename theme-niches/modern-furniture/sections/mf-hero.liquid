<div style="background:#F5F5F0; color:#222222; min-height:95vh; display:flex; flex-direction:column; position:relative; overflow:hidden;">
  
  <div style="flex:1; display:flex; flex-direction:column; justify-content:center; padding:120px 40px; position:relative; z-index:2; max-width:1600px; margin:0 auto; width:100%;">
    
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
      
      <!-- Content -->
      <div style="position:relative; z-index:3;">
        <h1 style="font-family:'Montserrat', 'Futura', sans-serif; font-size:clamp(48px, 7vw, 100px); font-weight:400; text-transform:uppercase; letter-spacing:-2px; margin:0 0 32px 0; line-height:0.95;">
          {{ section.settings.heading | replace: " ", "<br>" }}
        </h1>
        
        <p style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:18px; font-weight:300; color:#555555; line-height:1.7; margin:0 0 48px 0; max-width:400px; letter-spacing:0.5px;">
          {{ section.settings.subheading }}
        </p>
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; gap:16px; font-family:'Montserrat', 'Futura', sans-serif; font-size:12px; font-weight:500; text-transform:uppercase; letter-spacing:3px; color:#222222; text-decoration:none; transition:opacity 0.3s ease;" class="mf-btn-primary">
            {{ section.settings.cta_label }} <span style="width:40px; height:1px; background:#222222;"></span>
          </a>
        {%- endif -%}
      </div>

      <!-- Image -->
      <div style="position:relative; height:100%; min-height:600px;">
        <div style="position:absolute; inset:0; background:#E5E5DF; transform:translate(-40px, 40px); z-index:1; transition:transform 0.5s ease;" class="mf-hero-bg"></div>
        <div style="position:relative; z-index:2; height:100%; overflow:hidden;">
          <img src="https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=1200&q=80" alt="Modern Sofa" style="width:100%; height:100%; object-fit:cover; transition:transform 1.5s ease;" class="mf-hero-img" loading="eager">
        </div>
      </div>
      
    </div>
    
  </div>

  <style>
    .mf-btn-primary:hover { opacity: 0.6; }
    .mf-hero-img:hover { transform: scale(1.02); }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; gap: 80px; }
      div[style*="min-height:600px"] { min-height: 400px; }
      .mf-hero-bg { transform: translate(-20px, 20px) !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Furniture Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Form follows function."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated objects for the modern home. Pieces designed with intention and crafted to last generations."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "EXPLORE THE COLLECTION"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Furniture Hero"
    }
  ]
}
{% endschema %}
