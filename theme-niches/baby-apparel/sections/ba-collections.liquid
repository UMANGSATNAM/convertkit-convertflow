<div style="padding:80px 20px;background:var(--ba-cloud);border-bottom:1px solid var(--ba-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="ba-section-header"><span class="ba-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="ba-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="ba-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--ba-blue)"></div>{%- endif -%}<div class="ba-col-card__overlay"><span class="ba-col-card__title">{{ block.settings.title }}</span><span class="ba-col-card__cta">Explore Collection →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Baby Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ORGANIC MATRIX"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Baby Collection"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Soft Bodysuits"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Baby Collections","blocks":[{"type":"col","settings":{"title":"Soft Bodysuits"}},{"type":"col","settings":{"title":"Sleeping Swaddles"}},{"type":"col","settings":{"title":"Newborn Gift Sets"}}]}]}
{% endschema %}
