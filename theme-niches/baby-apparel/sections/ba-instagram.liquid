<div style="background:#FFF0F5; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:60px;">
      <h2 style="font-family:'Quicksand', sans-serif; font-size:clamp(36px, 5vw, 56px); font-weight:700; color:#5D4037; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-family:'Nunito', sans-serif; font-size:18px; font-weight:600; color:#8D6E63; margin:0 0 24px 0;">
        {{ section.settings.subheading }}
      </p>
      <div style="display:flex; justify-content:center; gap:8px;">
        <div style="width:8px; height:8px; background:#FFB6C1; border-radius:50%;"></div>
        <div style="width:8px; height:8px; background:#ADD8E6; border-radius:50%;"></div>
        <div style="width:8px; height:8px; background:#FFDAB9; border-radius:50%;"></div>
      </div>
    </div>

    <div class="ba-ig-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:20px;">
      
      {%- for block in section.blocks -%}
        <a href="#" class="ba-ig-card" style="display:block; position:relative; overflow:hidden; border-radius:20px; box-shadow:0 10px 20px rgba(93,64,55,0.05); transition:all 0.4s ease;">
          
          <div style="position:relative; padding-bottom:100%; background:#FFFAF0;">
            {%- assign img_url = 'https://images.unsplash.com/photo-1519689680058-324335c77eba?auto=format&fit=crop&w=600&q=80' -%}
            {%- if forloop.index == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1522771930-78848d9293e8?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            {%- if forloop.index == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            {%- if forloop.index == 4 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1555252834-8c7c1fa18703?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            
            <img src="{{ img_url }}" alt="Instagram post" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.6s ease;" class="ba-ig-img" loading="lazy">
            
            <div style="position:absolute; inset:0; background:rgba(255,182,193,0.8); display:flex; align-items:center; justify-content:center; opacity:0; transition:opacity 0.4s ease;" class="ba-ig-overlay">
              <svg style="width:40px; height:40px; fill:#FFFFFF;" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </div>
          </div>
          
        </a>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .ba-ig-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(93,64,55,0.1); }
    .ba-ig-card:hover .ba-ig-img { transform: scale(1.1); }
    .ba-ig-card:hover .ba-ig-overlay { opacity: 1; }
    
    @media (max-width: 990px) {
      .ba-ig-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</div>

{% schema %}
{
  "name": "Baby Instagram",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Little Sprouts"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tag us @sproutandco to be featured!"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": []
    }
  ],
  "presets": [
    {
      "name": "Baby Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
