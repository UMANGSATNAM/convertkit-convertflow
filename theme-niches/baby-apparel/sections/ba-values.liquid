<div style="background:#FFF0F5; padding:120px 24px; position:relative; overflow:hidden;">
  
  <!-- Decorative clouds -->
  <div style="position:absolute; top:20px; left:10%; font-size:40px; opacity:0.3; animation:ba-drift 20s linear infinite;">☁️</div>
  <div style="position:absolute; top:80px; right:15%; font-size:60px; opacity:0.2; animation:ba-drift 25s linear infinite reverse;">☁️</div>
  <div style="position:absolute; bottom:40px; left:20%; font-size:50px; opacity:0.2; animation:ba-drift 22s linear infinite;">☁️</div>
  
  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Quicksand', sans-serif; font-size:clamp(36px, 5vw, 56px); font-weight:700; color:#5D4037; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      <div style="display:flex; justify-content:center; gap:8px;">
        <div style="width:8px; height:8px; background:#FFB6C1; border-radius:50%;"></div>
        <div style="width:8px; height:8px; background:#ADD8E6; border-radius:50%;"></div>
      </div>
    </div>

    <div class="ba-values-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:60px;">
      
      {%- for block in section.blocks -%}
        <div style="text-align:center; background:#FFFFFF; padding:48px 32px; border-radius:40px; box-shadow:0 15px 30px rgba(93,64,55,0.03); transition:all 0.3s ease;" class="ba-value-card">
          
          <div style="width:100px; height:100px; border-radius:50%; background:#FFF0F5; display:flex; align-items:center; justify-content:center; margin:0 auto 32px auto; font-size:48px; transition:transform 0.3s ease;" class="ba-value-icon">
            {% if forloop.index == 1 %}🌱{% elsif forloop.index == 2 %}🧸{% else %}✨{% endif %}
          </div>
          
          <h3 style="font-family:'Quicksand', sans-serif; font-size:24px; font-weight:700; color:#5D4037; margin:0 0 16px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Nunito', sans-serif; font-size:16px; font-weight:600; line-height:1.6; color:#8D6E63; margin:0 auto; max-width:280px;">
            {{ block.settings.desc }}
          </p>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .ba-value-card:hover { transform: translateY(-10px); box-shadow: 0 25px 40px rgba(93,64,55,0.08); }
    .ba-value-card:hover .ba-value-icon { transform: scale(1.1) rotate(10deg); background: #FFFAF0; }
    
    @keyframes ba-drift { 0% { transform: translateX(0); } 50% { transform: translateX(50px); } 100% { transform: translateX(0); } }
    
    @media (max-width: 990px) {
      .ba-values-grid { grid-template-columns: 1fr; gap: 40px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Baby Values",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Parents Love Us"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% Organic Cotton"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "GOTS certified, breathable, and incredibly soft."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Baby Values",
      "blocks": [
        { "type": "value" },
        { "type": "value" },
        { "type": "value" }
      ]
    }
  ]
}
{% endschema %}
