<div style="padding:80px 20px;background:var(--ba-dark);border-bottom:1px solid var(--ba-border)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="ba-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Quicksand',sans-serif;font-size:clamp(28px,4vw,48px);font-weight:700;color:var(--ba-white);margin-bottom:20px;line-height:1.1;letter-spacing:-0.01em">{{ section.settings.heading }}</h2>
    <p style="font-family:'Outfit',sans-serif;font-size:15px;color:var(--ba-muted);line-height:1.7;max-width:440px;font-weight:500">{{ section.settings.body }}</p>
    <div class="ba-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="ba-stat" style="border-color:var(--ba-blue);background:rgba(142,202,230,0.1)" {{ block.shopify_attributes }}><div class="ba-stat__num" style="color:var(--ba-blue)">{{ block.settings.number }}</div><div class="ba-stat__label" style="color:var(--ba-white)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:24px;border:2px solid var(--ba-blue);object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:1.1;background:rgba(255,255,255,0.02);border-radius:24px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Baby Specs","settings":[{"type":"text","id":"eyebrow","label":"FABRIC QUALITY"},{"type":"text","id":"heading","label":"Heading","default":"Chemical-Free Knits."},{"type":"textarea","id":"body","label":"Body","default":"Every yarn is tested against 350+ harmful chemicals, ensuring a pure skin environment for newborn babies."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"0%"},{"type":"text","id":"label","label":"Label","default":"Chemicals"}]}],"presets":[{"name":"Baby Specs","blocks":[{"type":"stat","settings":{"number":"100%","label":"GOTS Cotton"}},{"type":"stat","settings":{"number":"0%","label":"Harmful Dyes"}},{"type":"stat","settings":{"number":"Flat","label":"Seam Design"}},{"type":"stat","settings":{"number":"PH 5.5","label":"Safe Touch"}}]}]}
{% endschema %}
