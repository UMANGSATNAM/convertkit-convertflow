<div style="background:#FFFAF0; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px; flex-wrap:wrap; gap:24px;">
      <div>
        <h2 style="font-family:'Quicksand', sans-serif; font-size:clamp(36px, 5vw, 56px); font-weight:700; color:#5D4037; margin:0 0 16px 0;">
          {{ section.settings.heading }}
        </h2>
        <div style="display:flex; gap:8px;">
          <div style="width:8px; height:8px; background:#FFB6C1; border-radius:50%;"></div>
          <div style="width:8px; height:8px; background:#ADD8E6; border-radius:50%;"></div>
          <div style="width:8px; height:8px; background:#FFDAB9; border-radius:50%;"></div>
        </div>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Nunito', sans-serif; font-size:16px; font-weight:700; color:#5D4037; text-decoration:none; display:flex; align-items:center; gap:8px; text-transform:uppercase; letter-spacing:1px; background:#FFFFFF; padding:12px 24px; border-radius:30px; box-shadow:0 5px 15px rgba(93,64,55,0.05); transition:all 0.3s ease;" class="ba-link-btn">
          {{ section.settings.cta_label }}
          <span style="font-size:20px;">&rarr;</span>
        </a>
      {%- endif -%}
    </div>

    <div class="ba-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:30px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1522771930-78848d9293e8?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1519689680058-324335c77eba?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1555252834-8c7c1fa18703?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1596870230751-ebdfce98ec42?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="ba-product-card" style="background:#FFFFFF; border-radius:30px; overflow:hidden; box-shadow:0 10px 20px rgba(93,64,55,0.03); transition:all 0.4s ease; position:relative; display:flex; flex-direction:column; height:100%;">
          
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:120%; background:#FFF0F5;">
            <img src="{{ img_url }}" alt="Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.6s ease;" class="ba-product-img" loading="lazy">
            
            {% if idx == 1 or idx == 3 %}
              <div style="position:absolute; top:16px; left:16px; background:#FFFFFF; color:#5D4037; font-family:'Nunito', sans-serif; font-size:12px; font-weight:700; padding:6px 16px; border-radius:20px; box-shadow:0 5px 15px rgba(0,0,0,0.05);">
                {% if idx == 1 %}New Arrival{% else %}Bestseller{% endif %}
              </div>
            {% endif %}
          </a>
          
          <div style="padding:24px; display:flex; flex-direction:column; flex-grow:1; text-align:center;">
            
            <h3 style="font-family:'Quicksand', sans-serif; font-size:20px; font-weight:700; color:#5D4037; margin:0 0 8px 0; flex-grow:1;">
              {% if idx == 1 %}Ribbed Organic Sleepsuit{% elsif idx == 2 %}Knit Bear Ears Beanie{% elsif idx == 3 %}Cotton Muslin Swaddle{% else %}Cozy Fleece Booties{% endif %}
            </h3>
            
            <div style="font-family:'Nunito', sans-serif; font-size:14px; font-weight:600; color:#8D6E63; margin-bottom:16px;">
              {% if idx == 1 %}0-12 Months{% elsif idx == 2 %}One Size{% elsif idx == 3 %}Pack of 2{% else %}0-6 Months{% endif %}
            </div>
            
            <div style="display:flex; justify-content:center; align-items:center; gap:8px; margin-bottom:16px;">
              <div style="width:16px; height:16px; border-radius:50%; background:#FFFAF0; border:1px solid #E0E0E0;"></div>
              <div style="width:16px; height:16px; border-radius:50%; background:#FFB6C1; border:1px solid #E0E0E0;"></div>
              <div style="width:16px; height:16px; border-radius:50%; background:#ADD8E6; border:1px solid #E0E0E0;"></div>
            </div>
            
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:auto;">
              <div style="font-family:'Nunito', sans-serif; font-size:18px; font-weight:700; color:#5D4037;">
                {% if idx == 1 %}$32.00{% elsif idx == 2 %}$18.00{% elsif idx == 3 %}$45.00{% else %}$22.00{% endif %}
              </div>
              <button style="width:40px; height:40px; background:#FFF0F5; color:#5D4037; border-radius:50%; display:flex; align-items:center; justify-content:center; border:none; cursor:pointer; transition:all 0.3s ease; font-size:24px; font-weight:300;" class="ba-add-btn">
                +
              </button>
            </div>
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .ba-link-btn:hover { background: #FFB6C1; transform: translateY(-3px); }
    .ba-product-card:hover { transform: translateY(-10px); box-shadow: 0 20px 40px rgba(93,64,55,0.08); }
    .ba-product-card:hover .ba-product-img { transform: scale(1.05); }
    .ba-add-btn:hover { background: #FFB6C1; transform: rotate(90deg); }
    
    @media (max-width: 1024px) {
      .ba-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px 20px !important; }
    }
    @media (max-width: 640px) {
      .ba-product-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Baby Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Little Favorites"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL CLOTHING"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Baby Collection"
    }
  ]
}
{% endschema %}
