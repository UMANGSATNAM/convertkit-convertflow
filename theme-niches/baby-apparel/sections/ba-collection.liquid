<div style="padding:60px 20px 0;background:var(--ba-cloud)"><div style="max-width:1320px;margin:0 auto;text-align:center;padding-bottom:56px;border-bottom:2px solid var(--ba-border)"><span class="ba-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</span><h1 style="font-family:'Quicksand',sans-serif;font-size:clamp(32px,5vw,52px);font-weight:700;color:var(--ba-dark);margin-bottom:12px;letter-spacing:-0.01em">{{ collection.title }}</h1>{%- if collection.description != blank -%}<p style="font-family:'Outfit',sans-serif;font-size:15px;color:var(--ba-muted);max-width:560px;margin:0 auto;font-weight:600;line-height:1.7">{{ collection.description }}</p>{%- endif -%}</div></div>
<div style="padding:0 20px 100px;background:var(--ba-cloud)"><div style="max-width:1320px;margin:0 auto"><div style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:2px solid var(--ba-border);margin-bottom:40px"><div style="font-family:'Outfit',sans-serif;font-size:13px;font-weight:800;color:var(--ba-dark);text-transform:uppercase">{{ collection.products_count }} essentials</div><select style="padding:10px 20px;border:2px solid var(--ba-border);border-radius:30px;background:#fff;color:var(--ba-dark);font-family:'Outfit',sans-serif;font-size:12px;font-weight:800;cursor:pointer"><option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Newest</option></select></div><div class="ba-prod-grid">{%- for product in collection.products -%}<a href="{{ product.url }}" class="ba-prod-card"><div class="ba-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--ba-cloud)"></div>{%- endif -%}</div><div class="ba-prod-card__name">{{ product.title }}</div><div class="ba-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div></div></div>
{% schema %}
{"name":"Baby Collection","settings":[],"presets":[{"name":"Baby Collection"}]}
{% endschema %}
