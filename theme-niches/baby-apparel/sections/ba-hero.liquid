<div class="ba-hero">
  <div class="ba-hero__content">
    <span class="ba-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="ba-hero__title">{{ section.settings.heading }}</h1>
    <p class="ba-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="ba-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/organic-cotton' }}" class="ba-btn ba-btn--outline" style="border-radius:40px">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="ba-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--ba-blue)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Baby Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"GOTS CERTIFIED ORGANIC COTTON"},{"type":"text","id":"heading","label":"Extra Soft Organic Baby Wear"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Hand-harvested organic cotton dyed with allergen-free herbal extracts. Designed with cloud-like seams for sensitive skin."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"EXPLORE APPAREL"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"OUR FABRIC"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Baby Hero"}]}
{% endschema %}
