<div style="background:#FFFAF0; position:relative; overflow:hidden; padding:80px 24px;">
  
  <!-- Soft background shapes -->
  <div style="position:absolute; top:-10%; left:-5%; width:40%; height:60%; background:#FFF0F5; border-radius:50%; filter:blur(40px); z-index:1;"></div>
  <div style="position:absolute; bottom:-10%; right:-5%; width:50%; height:70%; background:#F0F8FF; border-radius:50%; filter:blur(50px); z-index:1;"></div>
  
  <div style="max-width:1440px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center; position:relative; z-index:2;">
    
    <!-- Content -->
    <div style="padding-right:40px;">
      <div style="display:inline-flex; align-items:center; gap:8px; font-family:'Nunito', sans-serif; font-size:14px; font-weight:700; padding:8px 20px; border-radius:30px; text-transform:uppercase; letter-spacing:2px; margin-bottom:24px; color:#5D4037; background:#FFFFFF; box-shadow:0 10px 20px rgba(93,64,55,0.05);">
        <span style="font-size:18px;">✨</span>
        {{ section.settings.eyebrow }}
      </div>
      
      <h1 style="font-family:'Quicksand', sans-serif; font-size:clamp(48px, 6vw, 72px); font-weight:700; line-height:1.1; color:#5D4037; margin:0 0 24px 0;">
        {{ section.settings.heading }}
      </h1>
      
      <p style="font-family:'Nunito', sans-serif; font-size:18px; font-weight:400; color:#8D6E63; line-height:1.6; margin:0 0 40px 0;">
        {{ section.settings.subheading }}
      </p>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#FFB6C1; color:#5D4037; font-family:'Quicksand', sans-serif; font-size:18px; font-weight:700; padding:18px 48px; border-radius:50px; text-decoration:none; transition:all 0.3s ease; box-shadow:0 10px 20px rgba(255,182,193,0.4);" class="ba-btn-primary">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>
    
    <!-- Visual -->
    <div style="position:relative;">
      <!-- Blob frame -->
      <div style="position:absolute; inset:-20px; background:#FFFFFF; border-radius:40% 60% 70% 30% / 40% 50% 60% 50%; box-shadow:0 20px 40px rgba(93,64,55,0.08); z-index:1; animation:ba-blob-hero 15s ease-in-out infinite alternate;"></div>
      
      <div style="position:relative; z-index:2; border-radius:30% 70% 50% 50% / 50% 40% 60% 50%; overflow:hidden; aspect-ratio:4/5;">
        <img src="https://images.unsplash.com/photo-1519689680058-324335c77eba?auto=format&fit=crop&w=800&q=80" alt="Baby wearing cute clothes" style="width:100%; height:100%; object-fit:cover;" loading="eager">
      </div>
      
      <!-- Floating Element -->
      <div style="position:absolute; bottom:60px; right:-20px; background:#FFFFFF; padding:16px 24px; border-radius:24px; box-shadow:0 15px 30px rgba(93,64,55,0.1); z-index:3; display:flex; align-items:center; gap:16px; animation:ba-float 4s ease-in-out infinite;">
        <div style="width:48px; height:48px; background:#F0F8FF; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:24px;">
          🌿
        </div>
        <div>
          <div style="font-family:'Quicksand', sans-serif; font-size:16px; font-weight:700; color:#5D4037;">100% Organic</div>
          <div style="font-family:'Nunito', sans-serif; font-size:12px; color:#8D6E63; font-weight:600;">Safe for baby</div>
        </div>
      </div>
    </div>
    
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&family=Quicksand:wght@400;500;600;700&display=swap');
    
    .ba-btn-primary:hover { background: #FFC0CB; transform: translateY(-3px); box-shadow: 0 15px 25px rgba(255,182,193,0.5); }
    
    @keyframes ba-blob-hero { 0% { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; } 100% { border-radius: 60% 40% 30% 70% / 50% 60% 40% 50%; } }
    @keyframes ba-float { 0% { transform: translateY(0); } 50% { transform: translateY(-10px); } 100% { transform: translateY(0); } }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; text-align: center; gap: 80px; }
      div[style*="padding-right:40px"] { padding-right: 0; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Baby Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Soft, snuggly, and oh so sweet."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover our new collection of 100% organic cotton essentials for your little sprout."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP THE COLLECTION"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Baby Hero"
    }
  ]
}
{% endschema %}
