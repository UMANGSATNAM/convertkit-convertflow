<div style="background:#FFFFFF; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Quicksand', sans-serif; font-size:clamp(36px, 5vw, 56px); font-weight:700; color:#5D4037; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      <!-- Soft divider -->
      <div style="display:flex; justify-content:center; gap:8px;">
        <div style="width:8px; height:8px; background:#FFB6C1; border-radius:50%;"></div>
        <div style="width:8px; height:8px; background:#ADD8E6; border-radius:50%;"></div>
        <div style="width:8px; height:8px; background:#FFDAB9; border-radius:50%;"></div>
      </div>
    </div>

    <div class="ba-cat-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:40px;">
      
      {%- for block in section.blocks -%}
        <a href="#" class="ba-cat-card" style="display:block; text-align:center; text-decoration:none; group">
          
          <div style="position:relative; width:100%; padding-bottom:100%; border-radius:50%; overflow:hidden; margin-bottom:24px; background:#FFF0F5; border:8px solid #FFFAF0; box-shadow:0 15px 30px rgba(93,64,55,0.05); transition:all 0.4s ease;" class="ba-cat-img-wrapper">
            {%- assign img_url = 'https://images.unsplash.com/photo-1522771930-78848d9293e8?auto=format&fit=crop&w=600&q=80' -%}
            {%- if forloop.index == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            {%- if forloop.index == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1519689680058-324335c77eba?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            {%- if forloop.index == 4 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1555252834-8c7c1fa18703?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            
            <img src="{{ img_url }}" alt="{{ block.settings.title }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.6s ease;" class="ba-cat-img" loading="lazy">
            
            <!-- Soft overlay -->
            <div style="position:absolute; inset:0; background:rgba(255,250,240,0.2); transition:opacity 0.4s ease;" class="ba-cat-overlay"></div>
          </div>
          
          <h3 style="font-family:'Quicksand', sans-serif; font-size:22px; font-weight:700; color:#5D4037; margin:0; transition:color 0.3s ease;" class="ba-cat-title">
            {{ block.settings.title }}
          </h3>
          
        </a>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .ba-cat-card:hover .ba-cat-img-wrapper { transform: translateY(-10px); box-shadow: 0 25px 40px rgba(93,64,55,0.1); border-color: #FFFFFF; }
    .ba-cat-card:hover .ba-cat-img { transform: scale(1.05); }
    .ba-cat-card:hover .ba-cat-overlay { opacity: 0; }
    .ba-cat-card:hover .ba-cat-title { color: #FFB6C1; }
    
    @media (max-width: 990px) {
      .ba-cat-grid { grid-template-columns: repeat(2, 1fr); gap: 40px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Baby Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Size & Style"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Newborn (0-6m)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Baby Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
