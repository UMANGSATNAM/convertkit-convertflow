<div style="background:#FFFFFF; padding:120px 24px; position:relative; overflow:hidden;">
  <div style="max-width:1440px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
    
    <!-- Visual -->
    <div style="position:relative;">
      <!-- Soft blob behind image -->
      <div style="position:absolute; top:-20px; left:-20px; width:100%; height:100%; background:#ADD8E6; border-radius:30% 70% 70% 30% / 30% 30% 70% 70%; opacity:0.3; z-index:1;"></div>
      
      <div style="position:relative; z-index:2; border-radius:40px; overflow:hidden; box-shadow:0 30px 60px rgba(93,64,55,0.08);">
        <img src="https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?auto=format&fit=crop&w=1000&q=80" alt="Featured Product" style="width:100%; height:auto; display:block;" loading="lazy">
      </div>
      
      <!-- Floating Features -->
      <div style="position:absolute; top:20%; right:-30px; background:#FFFFFF; padding:12px 20px; border-radius:30px; box-shadow:0 10px 20px rgba(93,64,55,0.05); z-index:3; display:flex; align-items:center; gap:12px; font-family:'Nunito', sans-serif; font-size:14px; font-weight:700; color:#5D4037;">
        <span style="font-size:20px;">🧸</span> Super Soft
      </div>
      <div style="position:absolute; bottom:20%; left:-30px; background:#FFFFFF; padding:12px 20px; border-radius:30px; box-shadow:0 10px 20px rgba(93,64,55,0.05); z-index:3; display:flex; align-items:center; gap:12px; font-family:'Nunito', sans-serif; font-size:14px; font-weight:700; color:#5D4037;">
        <span style="font-size:20px;">✨</span> Two-Way Zip
      </div>
    </div>
    
    <!-- Content -->
    <div>
      <div style="display:inline-flex; align-items:center; gap:8px; font-family:'Nunito', sans-serif; font-size:12px; font-weight:700; padding:6px 16px; border-radius:30px; text-transform:uppercase; letter-spacing:2px; margin-bottom:16px; color:#5D4037; background:#FFF0F5;">
        {{ section.settings.eyebrow }}
      </div>
      
      <h2 style="font-family:'Quicksand', sans-serif; font-size:clamp(40px, 5vw, 64px); font-weight:700; line-height:1.1; color:#5D4037; margin:0 0 24px 0;">
        {{ section.settings.heading }}
      </h2>
      
      <p style="font-family:'Nunito', sans-serif; font-size:18px; font-weight:400; line-height:1.6; color:#8D6E63; margin:0 0 40px 0;">
        {{ section.settings.subheading }}
      </p>
      
      <!-- Color Swatches -->
      <div style="margin-bottom:48px;">
        <div style="font-family:'Nunito', sans-serif; font-size:14px; font-weight:700; color:#5D4037; margin-bottom:12px;">Available in 5 colors:</div>
        <div style="display:flex; gap:12px;">
          <div style="width:32px; height:32px; border-radius:50%; background:#FFFAF0; border:2px solid #5D4037; cursor:pointer;"></div>
          <div style="width:32px; height:32px; border-radius:50%; background:#FFB6C1; border:2px solid transparent; cursor:pointer;"></div>
          <div style="width:32px; height:32px; border-radius:50%; background:#ADD8E6; border:2px solid transparent; cursor:pointer;"></div>
          <div style="width:32px; height:32px; border-radius:50%; background:#E6E6FA; border:2px solid transparent; cursor:pointer;"></div>
          <div style="width:32px; height:32px; border-radius:50%; background:#98FB98; border:2px solid transparent; cursor:pointer;"></div>
        </div>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/products/sleepsuit' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#FFB6C1; color:#5D4037; font-family:'Quicksand', sans-serif; font-size:18px; font-weight:700; padding:18px 48px; border-radius:50px; text-decoration:none; transition:all 0.3s ease; box-shadow:0 10px 20px rgba(255,182,193,0.4);" class="ba-btn-primary">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>
    
  </div>

  <style>
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; gap: 80px; text-align: center; }
      div[style*="justify-content:center; gap:12px"] { justify-content: center; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Baby Featured",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE EVERYDAY ESSENTIAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Signature Sleepsuit"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Designed for sweet dreams. Featuring a two-way zipper for easy midnight changes and fold-over mittens to protect tiny faces."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP SLEEPSUITS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Baby Featured"
    }
  ]
}
{% endschema %}
