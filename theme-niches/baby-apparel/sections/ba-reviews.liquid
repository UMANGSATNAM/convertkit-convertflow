<div style="padding:80px 20px;background:#FFFFFF;border-bottom:1px solid var(--ba-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="ba-section-header"><span class="ba-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="ba-review-grid">{%- for block in section.blocks -%}<div class="ba-review-card" {{ block.shopify_attributes }}><div class="ba-review-card__stars">★★★★★</div><div class="ba-review-card__text">"{{ block.settings.quote }}"</div><div class="ba-review-card__author">{{ block.settings.name }}</div><div class="ba-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Baby Reviews","settings":[{"type":"text","id":"eyebrow","label":"MOTHER INSIGHTS"},{"type":"text","id":"heading","label":"Heading","default":"Stories from Soft Cribs"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Baby Reviews","blocks":[{"type":"review","settings":{"quote":"Unbelievably soft. Even after multiple washes, the fabric remains incredibly gentle and doesn't pill.","name":"Nisha P.","product":"Organic Cotton Bodysuit"}},{"type":"review","settings":{"quote":"The sleeping swaddle has made bedtime so much easier. Cozy, breathable, and fits beautifully.","name":"Sarah L.","product":"Sleeping Swaddle Set"}},{"type":"review","settings":{"quote":"Beautiful pastel colors. Gifted this set to my sister and she was absolutely wowed by the presentation.","name":"Divya K.","product":"Newborn Gift Set"}}]}]}
{% endschema %}
