<div style="background:#000000; padding:120px 24px; position:relative;">
  
  <div style="max-width:1200px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:clamp(40px, 5vw, 64px); font-weight:700; color:#FFFFFF; margin:0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <!-- Bento Box Layout -->
    <div style="display:grid; grid-template-columns:repeat(12, 1fr); grid-template-rows:repeat(2, 400px); gap:24px;">
      
      <!-- Box 1: Large Feature -->
      <div style="grid-column:1 / 8; grid-row:1 / 2; background:#111111; border-radius:32px; padding:48px; position:relative; overflow:hidden; border:1px solid rgba(255,255,255,0.05); transition:transform 0.3s ease;" class="tg-bento-card">
        <div style="position:relative; z-index:2;">
          <h3 style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:32px; font-weight:700; color:#FFFFFF; margin:0 0 16px 0;">M2 Architecture</h3>
          <p style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:18px; color:#A1A1A6; margin:0; max-width:300px;">18% faster CPU. 35% faster GPU. Unbelievable efficiency.</p>
        </div>
        <img src="https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=800&q=80" style="position:absolute; bottom:-10%; right:-10%; width:70%; height:auto; opacity:0.8; filter:hue-rotate(200deg) brightness(1.5);" loading="lazy">
      </div>
      
      <!-- Box 2: Small Feature -->
      <div style="grid-column:8 / 13; grid-row:1 / 2; background:#111111; border-radius:32px; padding:48px; position:relative; overflow:hidden; border:1px solid rgba(255,255,255,0.05); transition:transform 0.3s ease;" class="tg-bento-card">
        <div style="position:relative; z-index:2;">
          <h3 style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:32px; font-weight:700; color:#FFFFFF; margin:0 0 16px 0;">All-Day Battery</h3>
          <p style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:18px; color:#A1A1A6; margin:0;">Up to 24 hours of continuous playback.</p>
        </div>
        <div style="position:absolute; bottom:40px; right:40px; font-family:monospace; font-size:64px; font-weight:700; color:#007AFF;">24h</div>
      </div>
      
      <!-- Box 3: Small Feature -->
      <div style="grid-column:1 / 6; grid-row:2 / 3; background:#111111; border-radius:32px; padding:48px; position:relative; overflow:hidden; border:1px solid rgba(255,255,255,0.05); transition:transform 0.3s ease;" class="tg-bento-card">
        <div style="position:relative; z-index:2;">
          <h3 style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:32px; font-weight:700; color:#FFFFFF; margin:0 0 16px 0;">Retina Display</h3>
          <p style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:18px; color:#A1A1A6; margin:0;">P3 wide color. 500 nits brightness.</p>
        </div>
        <div style="position:absolute; inset:0; background:linear-gradient(45deg, rgba(0,122,255,0.1), transparent); z-index:1;"></div>
      </div>
      
      <!-- Box 4: Large Feature -->
      <div style="grid-column:6 / 13; grid-row:2 / 3; background:#111111; border-radius:32px; padding:48px; position:relative; overflow:hidden; border:1px solid rgba(255,255,255,0.05); transition:transform 0.3s ease;" class="tg-bento-card">
        <div style="position:relative; z-index:2;">
          <h3 style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:32px; font-weight:700; color:#FFFFFF; margin:0 0 16px 0;">Connectivity</h3>
          <p style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:18px; color:#A1A1A6; margin:0; max-width:300px;">Wi-Fi 6E. Bluetooth 5.3. Thunderbolt 4.</p>
        </div>
        <svg width="200" height="200" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1" style="position:absolute; bottom:0; right:0;"><path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01"/></svg>
      </div>

    </div>

  </div>

  <style>
    .tg-bento-card:hover { transform: scale(1.02); border-color: rgba(255,255,255,0.2); }
    
    @media (max-width: 1024px) {
      div[style*="display:grid; grid-template-columns:repeat(12, 1fr)"] { display: flex !important; flex-direction: column !important; }
      .tg-bento-card { height: 350px !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Tech Features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered for excellence."
    }
  ],
  "presets": [
    {
      "name": "Tech Features"
    }
  ]
}
{% endschema %}
