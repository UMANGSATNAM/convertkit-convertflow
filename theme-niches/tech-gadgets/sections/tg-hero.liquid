<div style="background:#000000; color:#FFFFFF; position:relative; min-height:100vh; display:flex; flex-direction:column; justify-content:center; align-items:center; overflow:hidden; padding:120px 24px;">
  
  <!-- Sleek gradient background effect -->
  <div style="position:absolute; inset:0; background:radial-gradient(circle at 50% 50%, rgba(0,122,255,0.15) 0%, rgba(0,0,0,1) 60%); z-index:1;"></div>

  <div style="max-width:1000px; margin:0 auto; text-align:center; position:relative; z-index:3;">
    
    <div style="display:inline-block; font-family:monospace; font-size:12px; color:#007AFF; letter-spacing:2px; margin-bottom:24px; border:1px solid rgba(0,122,255,0.3); padding:8px 16px; border-radius:20px; background:rgba(0,122,255,0.05);">
      INTRODUCING THE NEXT GENERATION
    </div>
    
    <h1 style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:clamp(56px, 8vw, 120px); font-weight:700; letter-spacing:-2px; margin:0 0 24px 0; background:linear-gradient(180deg, #FFFFFF 0%, #888888 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; line-height:1.1;">
      {{ section.settings.heading }}
    </h1>
    
    <p style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:clamp(20px, 3vw, 28px); font-weight:400; color:#A1A1A6; line-height:1.5; margin:0 auto 48px auto; max-width:640px;">
      {{ section.settings.subheading }}
    </p>
    
    {%- if section.settings.cta_label != blank -%}
      <div style="display:flex; gap:24px; justify-content:center; flex-wrap:wrap;">
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#007AFF; color:#FFFFFF; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:16px; font-weight:500; padding:16px 32px; border-radius:30px; text-decoration:none; transition:all 0.3s ease;" class="tg-btn-primary">
          {{ section.settings.cta_label }}
        </a>
        <a href="#specs" style="display:inline-flex; align-items:center; justify-content:center; background:rgba(255,255,255,0.1); color:#FFFFFF; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:16px; font-weight:500; padding:16px 32px; border-radius:30px; text-decoration:none; transition:all 0.3s ease;" class="tg-btn-secondary">
          Watch the film
        </a>
      </div>
    {%- endif -%}
    
  </div>

  <!-- Hero Image -->
  <div style="position:relative; z-index:2; width:100%; max-width:1200px; margin-top:80px;">
    <div style="position:relative; padding-bottom:50%;">
      <!-- Conceptual tech image -->
      <img src="https://images.unsplash.com/photo-1611186871348-b1ce696e52c9?auto=format&fit=crop&w=1600&q=80" alt="Device Showcase" style="position:absolute; inset:0; width:100%; height:100%; object-fit:contain; filter:drop-shadow(0 30px 60px rgba(0,122,255,0.3)); transform:perspective(1000px) rotateX(10deg); transition:transform 1s ease;" class="tg-hero-img" loading="eager">
    </div>
  </div>

  <style>
    .tg-btn-primary:hover { background: #0056B3; transform: scale(1.05); }
    .tg-btn-secondary:hover { background: rgba(255,255,255,0.2); }
    .tg-hero-img:hover { transform: perspective(1000px) rotateX(0deg); }
  </style>
</div>

{% schema %}
{
  "name": "Tech Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Power. Redefined."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Experience the next generation of performance with our revolutionary new chip architecture."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "PRE-ORDER NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Tech Hero"
    }
  ]
}
{% endschema %}
