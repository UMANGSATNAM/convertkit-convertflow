<div style="background:#000000; padding:120px 24px; border-top:1px solid rgba(255,255,255,0.1);">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:clamp(40px, 5vw, 64px); font-weight:700; color:#FFFFFF; margin:0 0 16px 0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:16px; font-weight:500; color:#007AFF; text-decoration:none; transition:color 0.3s ease;" class="tg-link-btn">
          {{ section.settings.cta_label }} <span>&rsaquo;</span>
        </a>
      {%- endif -%}
    </div>

    <div class="tg-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:24px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1611186871348-b1ce696e52c9?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1546868871-7041f2a55e12?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1606220588913-b3eea8f51200?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1583394838336-acd977736f90?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1611186871348-b1ce696e52c9?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="tg-product-card" style="position:relative; display:flex; flex-direction:column; background:#111111; border-radius:24px; padding:32px; transition:all 0.3s ease; border:1px solid rgba(255,255,255,0.05); text-align:center;">
          
          <h3 style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:24px; font-weight:700; color:#FFFFFF; margin:0 0 8px 0;">
            {% if idx == 1 %}Watch Series 8{% elsif idx == 2 %}Desktop Pro{% elsif idx == 3 %}Wireless Earbuds{% else %}Laptop M2{% endif %}
          </h3>
          
          <div style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:16px; font-weight:400; color:#A1A1A6; margin-bottom:24px;">
            {% if idx == 1 %}From $399{% elsif idx == 2 %}From $1299{% elsif idx == 3 %}From $249{% else %}From $999{% endif %}
          </div>
          
          <a href="#" style="display:block; text-decoration:none; position:relative; padding-bottom:100%; margin-bottom:32px;">
            <img src="{{ img_url }}" alt="Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:contain; transition:transform 0.5s ease;" class="tg-product-img" loading="lazy">
          </a>
          
          <div style="display:flex; justify-content:center; gap:12px; margin-top:auto;">
            <button style="background:#007AFF; color:#FFFFFF; border:none; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:14px; font-weight:500; padding:10px 24px; border-radius:20px; cursor:pointer; transition:background 0.2s ease;" class="tg-buy-btn">
              Buy
            </button>
            <button style="background:rgba(255,255,255,0.1); color:#007AFF; border:none; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:14px; font-weight:500; padding:10px 24px; border-radius:20px; cursor:pointer; transition:background 0.2s ease;" class="tg-learn-btn">
              Learn more
            </button>
          </div>
          
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .tg-link-btn:hover { color: #FFFFFF; }
    .tg-product-card:hover { transform: translateY(-8px); border-color: rgba(255,255,255,0.2); box-shadow: 0 20px 40px rgba(0,0,0,0.5); }
    .tg-product-card:hover .tg-product-img { transform: scale(1.05); }
    .tg-buy-btn:hover { background: #0056B3; }
    .tg-learn-btn:hover { background: rgba(255,255,255,0.2); }
    
    @media (max-width: 1024px) {
      .tg-product-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
    @media (max-width: 640px) {
      .tg-product-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Tech Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Lineup"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "COMPARE MODELS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Tech Collection"
    }
  ]
}
{% endschema %}
