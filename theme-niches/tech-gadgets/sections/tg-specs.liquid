<div style="background:#000000; padding:120px 24px; color:#FFFFFF; position:relative; overflow:hidden;">
  
  <div style="max-width:1200px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
    
    <!-- Visual -->
    <div style="position:relative; min-height:500px; display:flex; align-items:center; justify-content:center;">
      <div style="position:absolute; width:100%; height:100%; border:1px solid rgba(0,122,255,0.2); border-radius:50%; animation:pulse 4s infinite;"></div>
      <div style="position:absolute; width:70%; height:70%; border:1px solid rgba(0,122,255,0.4); border-radius:50%; animation:pulse 4s infinite 1s;"></div>
      <div style="position:absolute; width:40%; height:40%; border:1px solid rgba(0,122,255,0.6); border-radius:50%; animation:pulse 4s infinite 2s;"></div>
      
      <div style="position:relative; z-index:2; width:60%; height:auto;">
        <img src="https://images.unsplash.com/photo-1550009158-9ebf69173e03?auto=format&fit=crop&w=800&q=80" alt="Tech Chip" style="width:100%; height:100%; object-fit:contain; filter:drop-shadow(0 0 40px rgba(0,122,255,0.4));" loading="lazy">
      </div>
    </div>

    <!-- Content -->
    <div>
      <h2 style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:clamp(40px, 5vw, 56px); font-weight:700; color:#FFFFFF; margin:0 0 16px 0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:20px; font-weight:400; color:#A1A1A6; margin:0 0 48px 0;">
        {{ section.settings.subheading }}
      </p>
      
      <div style="display:flex; flex-direction:column; gap:24px;">
        
        <div style="padding-bottom:24px; border-bottom:1px solid rgba(255,255,255,0.1);">
          <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:8px;">
            <div style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:24px; font-weight:700; color:#FFFFFF;">Processor</div>
            <div style="font-family:monospace; font-size:16px; color:#007AFF;">M2 Pro / Max</div>
          </div>
          <div style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:16px; color:#A1A1A6;">Up to 12-core CPU and 38-core GPU</div>
        </div>
        
        <div style="padding-bottom:24px; border-bottom:1px solid rgba(255,255,255,0.1);">
          <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:8px;">
            <div style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:24px; font-weight:700; color:#FFFFFF;">Memory</div>
            <div style="font-family:monospace; font-size:16px; color:#007AFF;">Up to 96GB</div>
          </div>
          <div style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:16px; color:#A1A1A6;">Unified memory with 400GB/s bandwidth</div>
        </div>
        
        <div style="padding-bottom:24px; border-bottom:1px solid rgba(255,255,255,0.1);">
          <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:8px;">
            <div style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:24px; font-weight:700; color:#FFFFFF;">Storage</div>
            <div style="font-family:monospace; font-size:16px; color:#007AFF;">Up to 8TB SSD</div>
          </div>
          <div style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:16px; color:#A1A1A6;">Speeds up to 7.4GB/s for massive workflows</div>
        </div>
        
      </div>
    </div>
    
  </div>

  <style>
    @keyframes pulse {
      0% { transform: scale(1); opacity: 1; }
      100% { transform: scale(1.5); opacity: 0; }
    }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; gap: 40px; }
      div[style*="min-height:500px"] { min-height: 300px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Tech Specs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Technical Specifications"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Precision in every nanometer."
    }
  ],
  "presets": [
    {
      "name": "Tech Specs"
    }
  ]
}
{% endschema %}
