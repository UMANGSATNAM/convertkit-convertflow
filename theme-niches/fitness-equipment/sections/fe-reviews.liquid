<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="fe-section-header"><span class="fe-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="fe-review-grid">{%- for block in section.blocks -%}<div class="fe-review-card" {{ block.shopify_attributes }}><div class="fe-review-card__stars">★★★★★</div><div class="fe-review-card__text">"{{ block.settings.quote }}"</div><div class="fe-review-card__author">{{ block.settings.name }}</div><div class="fe-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Fitness Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"COMMERCIAL FEEDBACK"},{"type":"text","id":"heading","label":"Heading","default":"Heavy Patrons"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Fitness Reviews","blocks":[{"type":"review","settings":{"quote":"The knurling on the stainless steel bar is exceptionally crisp. Never slips under heavy loads.","name":"Clint E.","product":"Stainless Barbell"}},{"type":"review","settings":{"quote":"Unbelievably solid power rack. Zero wobble even when racking 250kg squats. Brutalist engineering.","name":"Sarah M.","product":"FE-700 Power Cage"}},{"type":"review","settings":{"quote":"Robotic welds are immaculate. This is commercial gym grade hardware for a home setup.","name":"Dave K.","product":"Flat Bench Pro"}}]}]}
{% endschema %}
