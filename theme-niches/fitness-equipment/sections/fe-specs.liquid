<div style="padding:80px 20px;background:var(--fe-dark)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1.1fr;gap:64px;align-items:center">
  <div>
    <span class="fe-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(28px,4vw,48px);font-weight:700;color:var(--fe-white);margin-bottom:20px;line-height:1.05;letter-spacing:-0.03em;text-transform:uppercase">{{ section.settings.heading }}</h2>
    <p style="font-family:'Space Grotesk',sans-serif;font-size:15px;color:var(--fe-muted);line-height:1.6;max-width:440px;font-weight:500">{{ section.settings.body }}</p>
    <div class="fe-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="fe-stat" style="border-color:rgba(255,255,255,0.15);background:rgba(255,255,255,0.02)" {{ block.shopify_attributes }}><div class="fe-stat__num" style="color:var(--fe-red)">{{ block.settings.number }}</div><div class="fe-stat__label" style="color:var(--fe-muted)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:0px;border:3px solid var(--fe-border);object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:1;background:var(--fe-border)"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Fitness Specs","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"HARDWARE ENGINEERING"},{"type":"text","id":"heading","label":"Heading","default":"Tested to 1000KG limits."},{"type":"textarea","id":"body","label":"Body","default":"Every weld joint is robotically aligned and drop-tested with 1000KG of mechanical force. Zero tolerance for structural play."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"11 Gauge"},{"type":"text","id":"label","label":"Label","default":"Steel Rating"}]}],"presets":[{"name":"Fitness Specs","blocks":[{"type":"stat","settings":{"number":"11 Gg","label":"Steel Gauge"}},{"type":"stat","settings":{"number":"1000kg","label":"Tested Limit"}},{"type":"stat","settings":{"number":"Zero","label":"Play Toler."}},{"type":"stat","settings":{"number":"Lifetime","label":"Frame Warranty"}}]}]}
{% endschema %}
