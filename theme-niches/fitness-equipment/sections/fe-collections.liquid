<div style="padding:80px 20px;background:#fff;border-bottom:3px solid var(--fe-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="fe-section-header"><span class="fe-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="fe-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="fe-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--fe-gray)"></div>{%- endif -%}<div class="fe-col-card__overlay"><span class="fe-col-card__title">{{ block.settings.title }}</span><span class="fe-col-card__cta">Explore Steel Specs →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Fitness Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"HARDWARE CATEGORIES"},{"type":"text","id":"heading","label":"Heading","default":"Heavy Systems"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Power Racks"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Fitness Collections","blocks":[{"type":"col","settings":{"title":"Power Racks & Cages"}},{"type":"col","settings":{"title":"Machined Iron Plates"}},{"type":"col","settings":{"title":"Competition Barbells"}}]}]}
{% endschema %}
