<div style="padding:60px 20px 100px;background:var(--ae-obsidian);min-height:60vh;border-bottom:1px solid var(--ae-border)"><div style="max-width:960px;margin:0 auto">
  <h1 style="font-family:'Inter',sans-serif;font-size:clamp(28px,4vw,40px);font-weight:900;color:var(--ae-white);text-align:center;margin-bottom:56px;letter-spacing:-0.02em">Your Set Up</h1>
  {%- if cart.item_count == 0 -%}<div style="text-align:center;padding:80px 20px"><div style="font-size:40px;margin-bottom:24px;filter:grayscale(1)">🎧</div><h2 style="font-family:'Inter',sans-serif;font-size:28px;font-weight:800;color:var(--ae-white);margin-bottom:12px;letter-spacing:-0.02em">Your set up is empty</h2><p style="font-family:'Inter',sans-serif;color:var(--ae-muted);margin-bottom:36px">Configure your sound stage with studio monitors and premium wireless headphones.</p><a href="/collections/all" class="ae-btn">EXPLORE SOUND</a></div>
  {%- else -%}
  <div style="display:grid;grid-template-columns:1fr 380px;gap:48px;align-items:start">
    <div>{%- for item in cart.items -%}<div style="display:flex;gap:24px;padding:28px 0;border-bottom:1px solid var(--ae-border);align-items:center"><a href="{{ item.url }}" style="flex-shrink:0"><img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="100" style="object-fit:contain;background:var(--ae-card-bg);padding:10px;border-radius:4px;border:1px solid var(--ae-border)"></a><div style="flex:1;min-width:0"><a href="{{ item.url }}" style="text-decoration:none;font-family:'Inter',sans-serif;font-weight:700;font-size:16px;color:var(--ae-white);display:block;margin-bottom:4px">{{ item.product.title }}</a>{%- unless item.variant.title == 'Default Title' -%}<div style="font-family:'Inter',sans-serif;font-size:12px;color:var(--ae-muted);margin-bottom:12px">{{ item.variant.title }}</div>{%- endunless -%}<div style="display:flex;align-items:center;gap:16px"><div style="display:flex;align-items:center;border:1px solid var(--ae-border);overflow:hidden;border-radius:4px"><button type="button" style="width:32px;height:36px;background:none;border:none;color:#fff;cursor:pointer;font-size:16px">−</button><span style="width:32px;text-align:center;font-family:'Inter',sans-serif;font-size:13px;font-weight:700;color:#fff">{{ item.quantity }}</span><button type="button" style="width:32px;height:36px;background:none;border:none;color:#fff;cursor:pointer;font-size:16px">+</button></div><a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" style="font-family:'Inter',sans-serif;font-size:12px;color:var(--ae-muted);text-transform:uppercase;letter-spacing:0.05em;text-decoration:underline">Remove</a></div></div><div style="font-family:'Inter',sans-serif;font-size:16px;font-weight:700;color:var(--ae-lime)">{{ item.final_line_price | money }}</div></div>{%- endfor -%}</div>
    <div style="background:var(--ae-card-bg);padding:40px;border:1px solid var(--ae-border);border-radius:4px;position:sticky;top:120px">
      <h3 style="font-family:'Inter',sans-serif;font-size:18px;font-weight:800;color:var(--ae-white);margin-bottom:28px">Sound Order</h3>
      <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-family:'Inter',sans-serif;font-size:14px"><span style="color:var(--ae-muted)">Subtotal</span><span style="font-weight:700;color:var(--ae-white)">{{ cart.total_price | money }}</span></div>
      <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-family:'Inter',sans-serif;font-size:14px"><span style="color:var(--ae-muted)">Shipping</span><span style="font-weight:700;color:var(--ae-lime)">Free</span></div>
      <div style="padding-top:20px;border-top:1px solid var(--ae-border);margin-top:20px;display:flex;justify-content:space-between;margin-bottom:32px"><span style="font-family:'Inter',sans-serif;font-size:18px;font-weight:800;color:#fff">Total</span><span style="font-family:'Inter',sans-serif;font-size:20px;font-weight:800;color:var(--ae-lime)">{{ cart.total_price | money }}</span></div>
      <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="ae-btn" style="width:100%;justify-content:center">CHECKOUT</button></form>
      <div style="display:flex;flex-direction:column;gap:8px;margin-top:24px;text-align:center"><span style="font-size:11px;font-family:'Inter',sans-serif;color:var(--ae-muted)">✓ 2-Year Studio Warranty Included</span><span style="font-size:11px;font-family:'Inter',sans-serif;color:var(--ae-muted)">🚚 Secure Express Sound Delivery</span></div>
    </div>
  </div>{%- endif -%}
</div></div>
{% schema %}
{"name":"Audio Cart","settings":[],"presets":[{"name":"Audio Cart"}]}
{% endschema %}
