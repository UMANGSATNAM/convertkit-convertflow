<div style="padding:80px 20px;background:var(--ae-obsidian);border-bottom:1px solid var(--ae-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="ae-section-header"><span class="ae-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="ae-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="ae-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:#1A1A1E"></div>{%- endif -%}<div class="ae-col-card__overlay"><span class="ae-col-card__title">{{ block.settings.title }}</span><span class="ae-col-card__cta">Explore Drivers →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Audio Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SOUND CATEGORIES"},{"type":"text","id":"heading","label":"Heading","default":"Precision Engineered"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Studio Monitors"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Audio Collections","blocks":[{"type":"col","settings":{"title":"ANC Headphones"}},{"type":"col","settings":{"title":"DAC & Amplifiers"}},{"type":"col","settings":{"title":"Studio Monitor Series"}}]}]}
{% endschema %}
