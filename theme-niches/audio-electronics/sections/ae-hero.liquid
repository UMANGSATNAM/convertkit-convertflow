<div class="ae-hero">
  <div class="ae-hero__content">
    <span class="ae-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="ae-hero__title">{{ section.settings.heading }}</h1>
    <p class="ae-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="ae-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="ae-btn ae-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="ae-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt | escape }}" width="1000" loading="eager">{%- else -%}<div style="width:80%;height:80%;min-height:400px;background:#1A1A1E"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Audio Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"OBSIDIAN SOUND LAB"},{"type":"text","id":"heading","label":"Heading","default":"Studio-Grade Audio Precision"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Custom-tuned dynamic drivers, true adaptive hybrid noise cancellation, and zero-latency wireless codecs."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"EXPLORE SOUND"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"DRIVER LABS"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Audio Hero"}]}
{% endschema %}
