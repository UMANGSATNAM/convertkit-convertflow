<div style="padding:60px 20px 0;background:var(--ae-obsidian)"><div style="max-width:1320px;margin:0 auto;text-align:center;padding-bottom:56px"><span class="ae-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</span><h1 style="font-family:'Inter',sans-serif;font-size:clamp(32px,5vw,52px);font-weight:900;color:var(--ae-white);margin-bottom:12px;letter-spacing:-0.03em">{{ collection.title }}</h1>{%- if collection.description != blank -%}<p style="font-family:'Inter',sans-serif;font-size:14px;color:var(--ae-muted);max-width:560px;margin:0 auto">{{ collection.description }}</p>{%- endif -%}</div></div>
<div style="padding:0 20px 100px;background:var(--ae-obsidian)"><div style="max-width:1320px;margin:0 auto"><div style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid var(--ae-border);margin-bottom:40px"><div style="font-family:'Inter',sans-serif;font-size:13px;color:var(--ae-muted)">{{ collection.products_count }} devices</div><select style="padding:10px 20px;border:1px solid var(--ae-border);border-radius:4px;background:transparent;color:#fff;font-family:'Inter',sans-serif;font-size:12px;cursor:pointer"><option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Newest</option></select></div><div class="ae-prod-grid">{%- for product in collection.products -%}<a href="{{ product.url }}" class="ae-prod-card"><div class="ae-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:#1A1A1E"></div>{%- endif -%}</div><div class="ae-prod-card__name">{{ product.title }}</div><div class="ae-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div></div></div>
{% schema %}
{"name":"Audio Collection","settings":[],"presets":[{"name":"Audio Collection"}]}
{% endschema %}
