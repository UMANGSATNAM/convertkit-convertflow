<div style="padding:80px 20px;background:var(--ae-dark)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="ae-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Inter',sans-serif;font-size:clamp(28px,4vw,44px);font-weight:800;color:var(--ae-white);margin-bottom:20px;line-height:1.15;letter-spacing:-0.02em">{{ section.settings.heading }}</h2>
    <p style="font-family:'Inter',sans-serif;font-size:15px;color:var(--ae-muted);line-height:1.7;max-width:440px">{{ section.settings.body }}</p>
    <div class="ae-stat-grid">{%- for block in section.blocks -%}<div class="ae-stat" {{ block.shopify_attributes }}><div class="ae-stat__num">{{ block.settings.number }}</div><div class="ae-stat__label">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:4px;border:1px solid var(--ae-border);object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:1;background:var(--ae-obsidian);border-radius:4px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Audio Specs","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ACOUSTIC ARCHITECTURE"},{"type":"text","id":"heading","label":"Heading","default":"Total Sound Control."},{"type":"textarea","id":"body","label":"Body","default":"Featuring high-excursion custom-tuned drivers and low-frequency chamber bass ports, delivering zero distortion at peak decibels."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"0.005%"},{"type":"text","id":"label","label":"Label","default":"Total Distortion"}]}],"presets":[{"name":"Audio Specs","blocks":[{"type":"stat","settings":{"number":"0.005%","label":"THD Distortion"}},{"type":"stat","settings":{"number":"48hr","label":"Total Battery"}},{"type":"stat","settings":{"number":"-45dB","label":"Hybrid ANC"}},{"type":"stat","settings":{"number":"5.4","label":"Bluetooth Low Latency"}}]}]}
{% endschema %}
