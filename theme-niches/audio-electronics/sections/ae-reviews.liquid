<div style="padding:80px 20px;background:var(--ae-obsidian)"><div style="max-width:1320px;margin:0 auto">
  <div class="ae-section-header"><span class="ae-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="ae-review-grid">{%- for block in section.blocks -%}<div class="ae-review-card" {{ block.shopify_attributes }}><div class="ae-review-card__stars">★★★★★</div><div class="ae-review-card__text">"{{ block.settings.quote }}"</div><div class="ae-review-card__author">{{ block.settings.name }}</div><div class="ae-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Audio Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"AUDIOPHILE DIARIES"},{"type":"text","id":"heading","label":"Heading","default":"Trusted by Creators"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Audio Reviews","blocks":[{"type":"review","settings":{"quote":"The soundstage of the ANC Headphones is insanely wide. Bass is tight, mids are crystal clear.","name":"Clint P.","product":"Obsidian ANC Pro"}},{"type":"review","settings":{"quote":"Reference grade monitors that didn't break the bank. Studio tracks translate perfectly.","name":"Sarah G.","product":"Studio Monitor 5"}},{"type":"review","settings":{"quote":"Battery life easily hits 40 hours with heavy noise cancellation active. Built like a tank.","name":"Marcus D.","product":"Obsidian Travel ANC"}}]}]}
{% endschema %}
