<div style="background:#0A0A0A; padding:120px 24px; position:relative; overflow:hidden;">
  
  <div style="max-width:1440px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
    
    <!-- Visual -->
    <div style="position:relative; display:flex; justify-content:center; align-items:center; min-height:500px;">
      
      <!-- Intense glowing background element -->
      <div style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); width:80%; height:80%; background:#FF3366; opacity:0.1; filter:blur(60px); border-radius:50%; z-index:1;"></div>
      
      <!-- High-tech frame -->
      <div style="position:absolute; inset:0; border:2px solid #222222; transform:skewX(-5deg); z-index:2;">
        <div style="position:absolute; top:-2px; left:-2px; width:30px; height:30px; border-top:4px solid #FF3366; border-left:4px solid #FF3366;"></div>
        <div style="position:absolute; bottom:-2px; right:-2px; width:30px; height:30px; border-bottom:4px solid #FF3366; border-right:4px solid #FF3366;"></div>
      </div>
      
      <!-- Product Placeholder Image -->
      <div style="position:relative; z-index:3; width:300px; height:400px; background:linear-gradient(to bottom, #1A1A1A, #0A0A0A); border:1px solid #333333; display:flex; align-items:center; justify-content:center; flex-direction:column; box-shadow:0 0 50px rgba(0,0,0,0.8); transform:rotate(-5deg);">
        <div style="font-family:'Teko', sans-serif; font-size:40px; color:#555555; text-transform:uppercase;">Tub Render</div>
      </div>
      
      <!-- Energy Sparks (CSS animation simulated) -->
      <div style="position:absolute; top:20%; left:20%; width:4px; height:4px; background:#00E5FF; box-shadow:0 0 10px #00E5FF; border-radius:50%; z-index:4; animation:fs-spark 2s infinite;"></div>
      <div style="position:absolute; bottom:30%; right:20%; width:4px; height:4px; background:#FF3366; box-shadow:0 0 10px #FF3366; border-radius:50%; z-index:4; animation:fs-spark 3s infinite 1s;"></div>
      
    </div>
    
    <!-- Content -->
    <div style="position:relative; z-index:5;">
      <div style="display:inline-block; font-family:'Teko', sans-serif; font-size:24px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:#00E5FF; margin-bottom:16px; border-left:4px solid #00E5FF; padding-left:12px; line-height:1;">
        {{ section.settings.eyebrow }}
      </div>
      
      <h2 style="font-family:'Teko', sans-serif; font-size:clamp(60px, 8vw, 100px); font-weight:700; line-height:0.9; color:#FFFFFF; margin:0 0 24px 0; text-transform:uppercase; text-shadow:0 0 20px rgba(255,51,102,0.3);">
        {{ section.settings.heading }}
      </h2>
      
      <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:400; line-height:1.6; color:#CCCCCC; margin:0 0 40px 0; max-width:500px;">
        {{ section.settings.subheading }}
      </p>
      
      <!-- Specs Grid -->
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-bottom:48px;">
        <div style="background:#111111; border:1px solid #222222; padding:20px; transform:skewX(-5deg);">
          <div style="transform:skewX(5deg);">
            <div style="font-family:'Teko', sans-serif; font-size:40px; font-weight:600; color:#FF3366; line-height:1;">350MG</div>
            <div style="font-family:'Inter', sans-serif; font-size:12px; color:#888888; text-transform:uppercase; letter-spacing:1px; margin-top:4px;">Caffeine Matrix</div>
          </div>
        </div>
        <div style="background:#111111; border:1px solid #222222; padding:20px; transform:skewX(-5deg);">
          <div style="transform:skewX(5deg);">
            <div style="font-family:'Teko', sans-serif; font-size:40px; font-weight:600; color:#00E5FF; line-height:1;">8000MG</div>
            <div style="font-family:'Inter', sans-serif; font-size:12px; color:#888888; text-transform:uppercase; letter-spacing:1px; margin-top:4px;">L-Citrulline</div>
          </div>
        </div>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/products/ignite' }}" style="display:inline-flex; align-items:center; justify-content:center; background:transparent; color:#FFFFFF; border:2px solid #FF3366; font-family:'Teko', sans-serif; font-size:24px; font-weight:600; letter-spacing:2px; text-transform:uppercase; padding:16px 48px; text-decoration:none; transform:skewX(-10deg); transition:all 0.3s ease; position:relative; overflow:hidden;" class="fs-btn-outline">
          <!-- Hover effect background -->
          <span style="position:absolute; inset:0; background:#FF3366; transform:translateX(-100%); transition:transform 0.3s ease;" class="fs-btn-bg"></span>
          <span style="transform:skewX(10deg); position:relative; z-index:2;">{{ section.settings.cta_label }}</span>
        </a>
      {%- endif -%}
    </div>
    
  </div>

  <style>
    .fs-btn-outline:hover .fs-btn-bg { transform: translateX(0); }
    .fs-btn-outline:hover { box-shadow: 0 0 20px rgba(255,51,102,0.5); }
    
    @keyframes fs-spark { 0% { opacity: 0; transform: scale(0); } 50% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(0); } }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; text-align: center; gap: 60px; }
      div[style*="border-left:4px solid #00E5FF"] { border-left: none; border-bottom: 4px solid #00E5FF; padding-left: 0; padding-bottom: 4px; }
      p[style*="max-width:500px"] { margin-left: auto; margin-right: auto; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Fitness Featured",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE ULTIMATE PRE-WORKOUT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "IGNITE V2.0"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Experience skin-tearing pumps, laser focus, and endless energy without the crash."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "GET IGNITE NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Fitness Featured"
    }
  ]
}
{% endschema %}
