<div style="padding:80px 20px;background:var(--fs-panel);border-bottom:1px solid var(--fs-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="fs-section-header"><span class="fs-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  {%- assign col = collections[section.settings.collection] -%}
  <div class="fs-prod-grid">{%- for product in col.products limit: section.settings.count -%}<a href="{{ product.url }}" class="fs-prod-card"><div class="fs-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--fs-dark)"></div>{%- endif -%}</div><div class="fs-prod-card__name">{{ product.title }}</div><div class="fs-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div>
  <div style="text-align:center;margin-top:48px"><a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="fs-btn fs-btn--outline" style="border-radius:8px">{{ section.settings.cta_label }}</a></div>
</div></div>
{% schema %}
{"name":"Supplements Featured","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ACTIVE STACK"},{"type":"text","id":"heading","label":"Heading","default":"Bestselling Lab Essentials"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"count","label":"Products","min":4,"max":12,"step":4,"default":8},{"type":"text","id":"cta_label","label":"CTA","default":"VIEW ALL FORMULAS"},{"type":"url","id":"cta_url","label":"CTA URL"}],"presets":[{"name":"Supplements Featured"}]}
{% endschema %}
