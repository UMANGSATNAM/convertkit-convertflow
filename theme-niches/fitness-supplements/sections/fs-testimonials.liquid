<div style="background:#111111; padding:120px 24px; border-top:1px solid #222222;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Teko', sans-serif; font-size:clamp(48px, 6vw, 72px); font-weight:600; color:#FFFFFF; margin:0 0 16px 0; text-transform:uppercase; letter-spacing:1px;">
        {{ section.settings.heading }}
      </h2>
      <div style="width:80px; height:4px; background:#00E5FF; margin:0 auto; transform:skewX(-20deg);"></div>
    </div>

    <div class="fs-test-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 2 }}, 1fr); gap:40px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#0A0A0A; border:1px solid #333333; padding:40px; position:relative; transform:skewX(-5deg); transition:all 0.3s ease;" class="fs-test-card">
          
          <div style="transform:skewX(5deg); height:100%; display:flex; flex-direction:column;">
            
            <!-- Quotes -->
            <div style="font-family:'Teko', sans-serif; font-size:80px; color:#FF3366; line-height:0.5; margin-bottom:20px; opacity:0.3;">
              "
            </div>
            
            <p style="font-family:'Inter', sans-serif; font-size:20px; font-weight:500; font-style:italic; line-height:1.6; color:#FFFFFF; margin:0 0 32px 0; flex-grow:1;">
              {{ block.settings.quote }}
            </p>
            
            <div style="display:flex; align-items:center; gap:16px; border-top:1px solid #222222; padding-top:24px;">
              <div style="width:48px; height:48px; background:#222222; border-radius:50%; overflow:hidden; border:2px solid #00E5FF;">
                {%- assign img_url = 'https://images.unsplash.com/photo-1583465554958-3f5f3e9f45c2?auto=format&fit=crop&w=100&q=80' -%}
                {%- if forloop.index == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1548690312-e3b507d8c110?auto=format&fit=crop&w=100&q=80' -%}{%- endif -%}
                <img src="{{ img_url }}" alt="Athlete" style="width:100%; height:100%; object-fit:cover; filter:grayscale(100%);">
              </div>
              <div>
                <div style="font-family:'Teko', sans-serif; font-size:24px; font-weight:600; color:#FFFFFF; letter-spacing:1px; line-height:1.2;">
                  {{ block.settings.author | split: '|' | first }}
                </div>
                <div style="font-family:'Inter', sans-serif; font-size:12px; color:#FF3366; text-transform:uppercase; letter-spacing:1px; margin-top:2px;">
                  {{ block.settings.author | split: '|' | last }}
                </div>
              </div>
            </div>
            
          </div>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .fs-test-card:hover { border-color: #555555; transform: skewX(-5deg) translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.5); }
    
    @media (max-width: 990px) {
      .fs-test-grid { grid-template-columns: 1fr; gap: 40px; }
      .fs-test-card { transform: none !important; }
      div[style*="transform:skewX(5deg)"] { transform: none !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Fitness Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ATHLETE PROVEN"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The only pre-workout that actually delivers what it promises. Insane focus."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Marcus T. | IFBB Pro",
          "info": "Use '|' to separate name and title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fitness Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
