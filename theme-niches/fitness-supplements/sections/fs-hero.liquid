<div class="fs-hero">
  <div class="fs-hero__content">
    <span class="fs-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="fs-hero__title">{{ section.settings.heading }}</h1>
    <p class="fs-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="fs-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/science-lab' }}" class="fs-btn fs-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="fs-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--fs-neon)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Supplements Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"HPLC TESTED CLINICAL FORMULAS"},{"type":"text","id":"heading","label":"Fuel Elite Human Performance"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Pure active ingredients formulated for high-intensity athletes. Zero filler agents, 100% label disclosure, and maximum bioavailability."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"SHOP FORMULAS"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"LAB REPORTS"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Supplements Hero"}]}
{% endschema %}
