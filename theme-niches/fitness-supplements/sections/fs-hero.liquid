<div style="background:#0A0A0A; position:relative; overflow:hidden; min-height:90vh; display:flex; align-items:center;">
  
  <!-- Dynamic Background -->
  <div style="position:absolute; inset:0; z-index:1;">
    <img src="https://images.unsplash.com/photo-1517836357463-d25dfeac3438?auto=format&fit=crop&w=2000&q=80" alt="Fitness" style="width:100%; height:100%; object-fit:cover; filter:grayscale(100%) contrast(1.2) brightness(0.4);" loading="eager">
    
    <!-- Diagonal Overlay -->
    <div style="position:absolute; inset:0; background:linear-gradient(135deg, rgba(10,10,10,0.9) 0%, rgba(10,10,10,0.5) 50%, rgba(255,51,102,0.1) 100%);"></div>
    
    <!-- Neon grid lines -->
    <div style="position:absolute; bottom:0; left:0; width:100%; height:40%; background-image:linear-gradient(transparent 90%, rgba(255,51,102,0.2) 100%), linear-gradient(90deg, transparent 90%, rgba(255,51,102,0.2) 100%); background-size:50px 50px; transform:perspective(500px) rotateX(60deg); transform-origin:bottom; opacity:0.5;"></div>
  </div>
  
  <div style="max-width:1440px; margin:0 auto; width:100%; padding:0 40px; position:relative; z-index:2; display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center;">
    
    <!-- Content -->
    <div>
      <div style="display:inline-block; font-family:'Teko', sans-serif; font-size:24px; font-weight:600; letter-spacing:2px; color:#FF3366; text-transform:uppercase; margin-bottom:16px; border-left:4px solid #FF3366; padding-left:12px; line-height:1;">
        {{ section.settings.eyebrow }}
      </div>
      
      <h1 style="font-family:'Teko', sans-serif; font-size:clamp(80px, 10vw, 140px); font-weight:700; line-height:0.85; color:#FFFFFF; margin:0 0 24px 0; text-transform:uppercase; text-shadow:0 0 20px rgba(255,51,102,0.3);">
        {{ section.settings.heading | replace: ' ', '<br>' }}
      </h1>
      
      <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:400; color:#CCCCCC; line-height:1.6; margin:0 0 48px 0; max-width:500px;">
        {{ section.settings.subheading }}
      </p>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#FF3366; color:#FFFFFF; font-family:'Teko', sans-serif; font-size:24px; font-weight:600; letter-spacing:2px; text-transform:uppercase; padding:16px 48px; text-decoration:none; transform:skewX(-10deg); transition:all 0.3s ease; box-shadow:0 0 20px rgba(255,51,102,0.4);" class="fs-btn-neon">
          <span style="transform:skewX(10deg);">{{ section.settings.cta_label }}</span>
        </a>
      {%- endif -%}
    </div>
    
    <!-- Product Showcase -->
    <div style="position:relative; display:flex; justify-content:center; align-items:center;">
      <!-- Glowing back circle -->
      <div style="position:absolute; width:400px; height:400px; background:radial-gradient(circle, rgba(255,51,102,0.3) 0%, rgba(10,10,10,0) 70%); z-index:1;"></div>
      
      <!-- Product Image Placeholder -->
      <div style="position:relative; z-index:2; width:300px; height:400px; background:linear-gradient(to bottom, #1A1A1A, #0A0A0A); border:2px solid #FF3366; border-radius:12px; box-shadow:0 0 30px rgba(255,51,102,0.2); display:flex; align-items:center; justify-content:center; transform:rotate(5deg); animation:fs-float 6s ease-in-out infinite;">
        <div style="font-family:'Teko', sans-serif; font-size:48px; color:#333333; transform:rotate(-90deg);">PRODUCT RENDER</div>
        <div style="position:absolute; bottom:20px; left:20px; background:#FF3366; color:#FFFFFF; font-family:'Teko', sans-serif; font-size:20px; padding:4px 12px; border-radius:4px; letter-spacing:1px;">NEW FORMULA</div>
      </div>
    </div>
    
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Teko:wght@400;500;600;700&display=swap');
    
    .fs-btn-neon:hover { background: #FFFFFF; color: #FF3366; box-shadow: 0 0 30px rgba(255,51,102,0.8); }
    
    @keyframes fs-float { 0% { transform: translateY(0) rotate(5deg); } 50% { transform: translateY(-20px) rotate(8deg); } 100% { transform: translateY(0) rotate(5deg); } }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; text-align: center; gap: 80px; }
      div[style*="border-left:4px solid #FF3366"] { border-left: none; border-bottom: 4px solid #FF3366; padding-left: 0; padding-bottom: 4px; }
      p[style*="max-width:500px"] { margin-left: auto; margin-right: auto; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Fitness Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "UNLEASH YOUR POTENTIAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FUEL THE MACHINE"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Clinically dosed formulas designed for elite performance and maximum recovery."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP SUPPLEMENTS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Fitness Hero"
    }
  ]
}
{% endschema %}
