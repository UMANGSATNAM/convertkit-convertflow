<div style="padding:80px 20px;background:#161616;border-bottom:1px solid var(--fs-border)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="fs-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Outfit',sans-serif;font-size:clamp(28px,4vw,48px);font-weight:900;color:var(--fs-white);margin-bottom:20px;line-height:1.1;letter-spacing:-0.02em;text-transform:uppercase">{{ section.settings.heading }}</h2>
    <p style="font-family:'Inter',sans-serif;font-size:15px;color:var(--fs-muted);line-height:1.7;max-width:440px;font-weight:500">{{ section.settings.body }}</p>
    <div class="fs-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="fs-stat" style="border-color:var(--fs-neon);background:rgba(204,255,0,0.05)" {{ block.shopify_attributes }}><div class="fs-stat__num" style="color:var(--fs-neon)">{{ block.settings.number }}</div><div class="fs-stat__label" style="color:var(--fs-white)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:8px;border:1px solid var(--fs-neon);object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:1.1;background:rgba(255,255,255,0.02);border-radius:8px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Supplements Specs","settings":[{"type":"text","id":"eyebrow","label":"LABORATORY CERTIFIED"},{"type":"text","id":"heading","label":"Heading","default":"Sub-Gram Precision."},{"type":"textarea","id":"body","label":"Body","default":"Every batch undergoes multi-phase HPLC verification to guarantee micro-ingredient profile purity and label accuracy."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"0%"},{"type":"text","id":"label","label":"Label","default":"Chemicals"}]}],"presets":[{"name":"Supplements Specs","blocks":[{"type":"stat","settings":{"number":"100%","label":"Label Disclosure"}},{"type":"stat","settings":{"number":"0g","label":"Banned Agents"}},{"type":"stat","settings":{"number":"HPLC","label":"Batch Verified"}},{"type":"stat","settings":{"number":"Bioactive","label":"Ingredients"}}]}]}
{% endschema %}
