<div style="padding:80px 20px;background:var(--fs-dark);border-bottom:1px solid var(--fs-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="fs-section-header"><span class="fs-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="fs-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="fs-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--fs-neon)"></div>{%- endif -%}<div class="fs-col-card__overlay"><span class="fs-col-card__title">{{ block.settings.title }}</span><span class="fs-col-card__cta">Explore Formulas →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Supplements Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PERFORMANCE MATRIX"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Performance Category"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Hydrolyzed Whey"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Supplements Collections","blocks":[{"type":"col","settings":{"title":"Hydrolyzed Whey"}},{"type":"col","settings":{"title":"Pre-Workout Ions"}},{"type":"col","settings":{"title":"Active Recovery BCAAs"}}]}]}
{% endschema %}
