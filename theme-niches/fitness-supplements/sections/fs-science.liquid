<div style="background:#0A0A0A; padding:120px 24px; position:relative; overflow:hidden; border-top:1px solid #222222;">
  
  <!-- Abstract grid background -->
  <div style="position:absolute; inset:0; background-image:linear-gradient(#1A1A1A 1px, transparent 1px), linear-gradient(90deg, #1A1A1A 1px, transparent 1px); background-size:40px 40px; opacity:0.3; z-index:1;"></div>
  
  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Teko', sans-serif; font-size:clamp(48px, 6vw, 72px); font-weight:600; color:#FFFFFF; margin:0 0 16px 0; text-transform:uppercase; letter-spacing:1px; text-shadow:0 0 20px rgba(0,229,255,0.3);">
        {{ section.settings.heading }}
      </h2>
      <div style="width:80px; height:4px; background:#00E5FF; margin:0 auto; transform:skewX(-20deg); box-shadow:0 0 10px rgba(0,229,255,0.5);"></div>
    </div>

    <div class="fs-science-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:60px;">
      
      {%- for block in section.blocks -%}
        <div style="text-align:center; position:relative; padding:40px; background:linear-gradient(to bottom, #111111, #0A0A0A); border:1px solid #222222; transform:skewX(-5deg); transition:all 0.3s ease;" class="fs-science-card">
          
          <div style="transform:skewX(5deg);">
            <!-- Icon placeholder -->
            <div style="width:80px; height:80px; border:2px solid #00E5FF; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 32px auto; color:#00E5FF; font-family:'Teko', sans-serif; font-size:40px; font-weight:700; box-shadow:inset 0 0 20px rgba(0,229,255,0.2), 0 0 20px rgba(0,229,255,0.2); transition:all 0.4s ease;" class="fs-science-icon">
              {% if forloop.index == 1 %}01{% elsif forloop.index == 2 %}02{% else %}03{% endif %}
            </div>
            
            <h3 style="font-family:'Teko', sans-serif; font-size:32px; font-weight:600; color:#FFFFFF; margin:0 0 16px 0; text-transform:uppercase; letter-spacing:1px;">
              {{ block.settings.title }}
            </h3>
            
            <p style="font-family:'Inter', sans-serif; font-size:16px; font-weight:400; line-height:1.6; color:#AAAAAA; margin:0 auto; max-width:280px;">
              {{ block.settings.desc }}
            </p>
          </div>
          
          <!-- Neon corner accent -->
          <div style="position:absolute; top:-1px; left:-1px; width:20px; height:20px; border-top:2px solid #00E5FF; border-left:2px solid #00E5FF;"></div>
          <div style="position:absolute; bottom:-1px; right:-1px; width:20px; height:20px; border-bottom:2px solid #00E5FF; border-right:2px solid #00E5FF;"></div>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .fs-science-card:hover { border-color: #333333; transform: skewX(-5deg) translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.5); }
    .fs-science-card:hover .fs-science-icon { background: rgba(0,229,255,0.1); transform: scale(1.1); box-shadow: inset 0 0 30px rgba(0,229,255,0.4), 0 0 30px rgba(0,229,255,0.4); color: #FFFFFF; }
    
    @media (max-width: 990px) {
      .fs-science-grid { grid-template-columns: 1fr; gap: 40px; }
      .fs-science-card { transform: none !important; }
      div[style*="transform:skewX(5deg)"] { transform: none !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Fitness Science",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BACKED BY SCIENCE"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clinically Dosed"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "No proprietary blends. Full transparency."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fitness Science",
      "blocks": [
        { "type": "value" },
        { "type": "value" },
        { "type": "value" }
      ]
    }
  ]
}
{% endschema %}
