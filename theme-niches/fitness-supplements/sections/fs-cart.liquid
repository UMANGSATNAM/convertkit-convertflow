<div style="padding:60px 20px 100px;background:var(--fs-dark);min-height:60vh;border-bottom:1px solid var(--fs-border)"><div style="max-width:960px;margin:0 auto">
  <h1 style="font-family:'Outfit',sans-serif;font-size:clamp(28px,4vw,40px);font-weight:900;color:var(--fs-white);text-align:center;margin-bottom:56px;letter-spacing:-0.01em;text-transform:uppercase">ACTIVE STACK</h1>
  {%- if cart.item_count == 0 -%}<div style="text-align:center;padding:80px 20px"><div style="font-size:40px;margin-bottom:24px;filter:grayscale(1)">🧪</div><h2 style="font-family:'Outfit',sans-serif;font-size:28px;font-weight:900;color:var(--fs-white);margin-bottom:12px;letter-spacing:-0.01em;text-transform:uppercase">Your stack is empty</h2><p style="font-family:'Inter',sans-serif;color:var(--fs-muted);margin-bottom:36px;font-weight:600">Pure amino acids, protein isolates, and performance ions are ready to stack.</p><a href="/collections/all" class="fs-btn">EXPLORE FORMULAS</a></div>
  {%- else -%}
  <div style="display:grid;grid-template-columns:1fr 380px;gap:48px;align-items:start">
    <div>{%- for item in cart.items -%}<div style="display:flex;gap:24px;padding:28px 0;border-bottom:1px solid var(--fs-border);align-items:center"><a href="{{ item.url }}" style="flex-shrink:0"><img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="100" style="object-fit:contain;background:#1e1e1e;padding:10px;border:1px solid var(--fs-border);border-radius:4px"></a><div style="flex:1;min-width:0"><a href="{{ item.url }}" style="text-decoration:none;font-family:'Outfit',sans-serif;font-weight:900;font-size:18px;color:var(--fs-white);display:block;margin-bottom:4px;text-transform:uppercase">{{ item.product.title }}</a>{%- unless item.variant.title == 'Default Title' -%}<div style="font-family:'Inter',sans-serif;font-size:12px;color:var(--fs-muted);margin-bottom:12px;font-weight:600">{{ item.variant.title }}</div>{%- endunless -%}<div style="display:flex;align-items:center;gap:16px"><div style="display:flex;align-items:center;border:1px solid var(--fs-border);overflow:hidden;background:#1e1e1e;border-radius:4px"><button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px;color:#fff">−</button><span style="width:32px;text-align:center;font-family:'Inter',sans-serif;font-size:13px;font-weight:800;color:var(--fs-white)">{{ item.quantity }}</span><button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px;color:#fff">+</button></div><a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" style="font-family:'Inter',sans-serif;font-size:11px;color:var(--fs-muted);text-transform:uppercase;letter-spacing:0.05em;text-decoration:underline;font-weight:800">Remove</a></div></div><div style="font-family:'Inter',sans-serif;font-size:16px;font-weight:800;color:var(--fs-neon)">{{ item.final_line_price | money }}</div></div>{%- endfor -%}</div>
    <div style="background:#1e1e1e;padding:40px;border:1px solid var(--fs-border);border-radius:8px;position:sticky;top:120px">
      <h3 style="font-family:'Inter',sans-serif;font-size:18px;font-weight:900;color:var(--fs-white);margin-bottom:28px;text-transform:uppercase">Stack Summary</h3>
      <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-family:'Inter',sans-serif;font-size:14px;font-weight:600"><span style="color:var(--fs-muted)">Subtotal</span><span style="font-weight:800;color:var(--fs-white)">{{ cart.total_price | money }}</span></div>
      <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-family:'Inter',sans-serif;font-size:14px;font-weight:600"><span style="color:var(--fs-muted)">Secure Lab Dispatch</span><span style="font-weight:800;color:var(--fs-neon)">Free</span></div>
      <div style="padding-top:20px;border-top:1px solid var(--fs-border);margin-top:20px;display:flex;justify-content:space-between;margin-bottom:32px"><span style="font-family:'Inter',sans-serif;font-size:18px;font-weight:900;color:var(--fs-white);text-transform:uppercase">Total</span><span style="font-family:'Inter',sans-serif;font-size:20px;font-weight:900;color:var(--fs-neon)">{{ cart.total_price | money }}</span></div>
      <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="fs-btn" style="width:100%;justify-content:center">CHECKOUT</button></form>
      <div style="display:flex;flex-direction:column;gap:8px;margin-top:24px;text-align:center"><span style="font-size:11px;font-family:'Inter',sans-serif;font-weight:800;color:var(--fs-muted)">✓ raw lab purity performance guarantee</span><span style="font-size:11px;font-family:'Inter',sans-serif;font-weight:800;color:var(--fs-muted)">🚚 carbon neutral secure athlete shipping</span></div>
    </div>
  </div>{%- endif -%}
</div></div>
{% schema %}
{"name":"Supplements Cart","settings":[],"presets":[{"name":"Supplements Cart"}]}
{% endschema %}
