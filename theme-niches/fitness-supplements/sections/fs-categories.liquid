<div style="background:#111111; padding:120px 24px; border-top:1px solid #222222;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Teko', sans-serif; font-size:clamp(48px, 6vw, 72px); font-weight:600; color:#FFFFFF; margin:0 0 16px 0; text-transform:uppercase; letter-spacing:1px;">
        {{ section.settings.heading }}
      </h2>
      <div style="width:80px; height:4px; background:#FF3366; margin:0 auto; transform:skewX(-20deg);"></div>
    </div>

    <div class="fs-cat-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:30px;">
      
      {%- for block in section.blocks -%}
        <a href="#" class="fs-cat-card" style="display:block; text-decoration:none; position:relative; overflow:hidden; background:#1A1A1A; border:1px solid #333333; height:300px; display:flex; align-items:flex-end; padding:32px; transition:all 0.4s ease; transform:skewX(-5deg);">
          
          <!-- Background Image -->
          <div style="position:absolute; inset:0; z-index:1; transform:skewX(5deg) scale(1.1); transition:transform 0.6s ease;" class="fs-cat-img-wrapper">
            {%- assign img_url = 'https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=600&q=80' -%}
            {%- if forloop.index == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1554284126-aa88f22d8b74?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            {%- if forloop.index == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            {%- if forloop.index == 4 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            
            <img src="{{ img_url }}" alt="{{ block.settings.title }}" style="width:100%; height:100%; object-fit:cover; filter:grayscale(100%) opacity(0.3);" loading="lazy" class="fs-cat-img">
            <div style="position:absolute; inset:0; background:linear-gradient(to top, #111111 0%, transparent 100%);"></div>
          </div>
          
          <!-- Neon border effect on hover -->
          <div style="position:absolute; inset:0; border:2px solid transparent; z-index:2; transition:all 0.4s ease;" class="fs-cat-border"></div>
          
          <!-- Content -->
          <div style="position:relative; z-index:3; transform:skewX(5deg); width:100%;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <h3 style="font-family:'Teko', sans-serif; font-size:40px; font-weight:600; color:#FFFFFF; margin:0; text-transform:uppercase; line-height:1; letter-spacing:1px; transition:color 0.3s ease;" class="fs-cat-title">
                {{ block.settings.title }}
              </h3>
              <div style="width:40px; height:40px; border:2px solid #555555; display:flex; align-items:center; justify-content:center; color:#FFFFFF; transition:all 0.3s ease;" class="fs-cat-arrow">
                <svg style="width:20px; height:20px; fill:currentColor;" viewBox="0 0 24 24"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
              </div>
            </div>
          </div>
          
        </a>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .fs-cat-card:hover { background: #111111; transform: skewX(-5deg) translateY(-10px); box-shadow: 0 15px 30px rgba(0,0,0,0.5); }
    .fs-cat-card:hover .fs-cat-border { border-color: #FF3366; box-shadow: inset 0 0 20px rgba(255,51,102,0.2); }
    .fs-cat-card:hover .fs-cat-img-wrapper { transform: skewX(5deg) scale(1.15); }
    .fs-cat-card:hover .fs-cat-img { filter: grayscale(0%) opacity(0.5); }
    .fs-cat-card:hover .fs-cat-title { color: #FF3366; text-shadow: 0 0 10px rgba(255,51,102,0.5); }
    .fs-cat-card:hover .fs-cat-arrow { border-color: #FF3366; background: #FF3366; color: #FFFFFF; }
    
    @media (max-width: 1024px) {
      .fs-cat-grid { grid-template-columns: repeat(2, 1fr); gap: 30px; }
    }
    @media (max-width: 640px) {
      .fs-cat-grid { grid-template-columns: 1fr; }
      .fs-cat-card { transform: none; }
      .fs-cat-card:hover { transform: translateY(-5px); }
      .fs-cat-img-wrapper, .fs-cat-card .fs-cat-img-wrapper { transform: none !important; }
      div[style*="transform:skewX(5deg)"] { transform: none !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Fitness Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY GOAL"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Muscle Building"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fitness Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
