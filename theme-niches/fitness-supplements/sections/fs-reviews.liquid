<div style="padding:80px 20px;background:var(--fs-dark);border-bottom:1px solid var(--fs-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="fs-section-header"><span class="fs-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="fs-review-grid">{%- for block in section.blocks -%}<div class="fs-review-card" {{ block.shopify_attributes }}><div class="fs-review-card__stars">★★★★★</div><div class="fs-review-card__text">"{{ block.settings.quote }}"</div><div class="fs-review-card__author">{{ block.settings.name }}</div><div class="fs-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Supplements Reviews","settings":[{"type":"text","id":"eyebrow","label":"ATHLETE REVIEWS"},{"type":"text","id":"heading","label":"Heading","default":"Verified Gym Feedback"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Supplements Reviews","blocks":[{"type":"review","settings":{"quote":"Excellent mixability. The recovery profile has helped me squeeze in two extra high-intensity sessions per week.","name":"David K.","product":"Hydrolyzed Whey Protein"}},{"type":"review","settings":{"quote":"Incredible mental focus. Zero crash after two hours of intensive conditioning work. Highly recommend.","name":"Marcus T.","product":"Pre-Workout Ion Catalyst"}},{"type":"review","settings":{"quote":"Clean, natural taste. No artificial sweeteners or heavy chemical aftertaste. A true game-changer.","name":"Elena R.","product":"Active Recovery BCAAs"}}]}]}
{% endschema %}
