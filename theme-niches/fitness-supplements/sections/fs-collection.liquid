<div style="padding:60px 20px 0;background:var(--fs-dark)"><div style="max-width:1320px;margin:0 auto;text-align:center;padding-bottom:56px;border-bottom:1px solid var(--fs-border)"><span class="fs-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</span><h1 style="font-family:'Outfit',sans-serif;font-size:clamp(32px,5vw,52px);font-weight:900;color:var(--fs-white);margin-bottom:12px;letter-spacing:-0.01em;text-transform:uppercase">{{ collection.title }}</h1>{%- if collection.description != blank -%}<p style="font-family:'Inter',sans-serif;font-size:15px;color:var(--fs-muted);max-width:560px;margin:0 auto;font-weight:600;line-height:1.7">{{ collection.description }}</p>{%- endif -%}</div></div>
<div style="padding:0 20px 100px;background:var(--fs-dark)"><div style="max-width:1320px;margin:0 auto"><div style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid var(--fs-border);margin-bottom:40px"><div style="font-family:'Inter',sans-serif;font-size:13px;font-weight:800;color:var(--fs-white);text-transform:uppercase">{{ collection.products_count }} formulas</div><select style="padding:10px 20px;border:1px solid var(--fs-border);border-radius:4px;background:#1e1e1e;color:var(--fs-white);font-family:'Inter',sans-serif;font-size:12px;font-weight:800;cursor:pointer"><option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Newest</option></select></div><div class="fs-prod-grid">{%- for product in collection.products -%}<a href="{{ product.url }}" class="fs-prod-card"><div class="fs-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--fs-dark)"></div>{%- endif -%}</div><div class="fs-prod-card__name">{{ product.title }}</div><div class="fs-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div></div></div>
{% schema %}
{"name":"Supplements Collection","settings":[],"presets":[{"name":"Supplements Collection"}]}
{% endschema %}
