<div style="background:#111111; padding:120px 24px; border-top:1px solid #222222;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px; flex-wrap:wrap; gap:24px;">
      <div>
        <h2 style="font-family:'Teko', sans-serif; font-size:clamp(48px, 6vw, 72px); font-weight:600; color:#FFFFFF; margin:0 0 16px 0; text-transform:uppercase; letter-spacing:1px; line-height:1;">
          {{ section.settings.heading }}
        </h2>
        <div style="width:80px; height:4px; background:#FF3366; transform:skewX(-20deg);"></div>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Teko', sans-serif; font-size:20px; font-weight:600; color:#FF3366; text-decoration:none; display:flex; align-items:center; gap:8px; text-transform:uppercase; letter-spacing:2px; transition:color 0.3s ease;" class="fs-link-btn">
          {{ section.settings.cta_label }}
          <svg style="width:24px; height:24px; fill:currentColor;" viewBox="0 0 24 24"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="fs-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:30px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        
        <div class="fs-product-card" style="background:#0A0A0A; border:1px solid #333333; transition:all 0.3s ease; position:relative; display:flex; flex-direction:column; height:100%;">
          
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:120%; background:radial-gradient(circle at center, #1A1A1A 0%, #0A0A0A 100%);">
            
            <!-- Abstract background element for product -->
            <div style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); width:60%; height:60%; background:#FF3366; opacity:0.05; filter:blur(30px); border-radius:50%;"></div>
            
            <!-- Product Placeholder (Simulated Render) -->
            <div style="position:absolute; inset:20px; border:2px solid #222222; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-direction:column; background:linear-gradient(135deg, rgba(255,255,255,0.05) 0%, transparent 100%); transition:transform 0.5s ease;" class="fs-product-img">
              <div style="font-family:'Teko', sans-serif; font-size:32px; color:#555555; text-transform:uppercase;">Tub Render</div>
            </div>
            
            {% if idx == 1 or idx == 3 %}
              <div style="position:absolute; top:16px; left:-8px; background:#FF3366; color:#FFFFFF; font-family:'Teko', sans-serif; font-size:16px; font-weight:600; padding:4px 16px; text-transform:uppercase; letter-spacing:1px; transform:skewX(-10deg); box-shadow:0 5px 15px rgba(255,51,102,0.3);">
                <span style="display:inline-block; transform:skewX(10deg);">Best Seller</span>
              </div>
            {% endif %}
          </a>
          
          <div style="padding:24px; display:flex; flex-direction:column; flex-grow:1; text-align:center; position:relative; z-index:2; background:#0A0A0A;">
            
            <div style="font-family:'Inter', sans-serif; font-size:12px; font-weight:600; color:#FF3366; text-transform:uppercase; letter-spacing:2px; margin-bottom:8px;">
              {% if idx == 1 %}Pre-Workout{% elsif idx == 2 %}Protein{% elsif idx == 3 %}Aminos{% else %}Vitamins{% endif %}
            </div>
            
            <h3 style="font-family:'Teko', sans-serif; font-size:28px; font-weight:500; color:#FFFFFF; margin:0 0 8px 0; text-transform:uppercase; letter-spacing:1px; flex-grow:1;">
              {% if idx == 1 %}Ignite V2.0{% elsif idx == 2 %}Whey Isolate Pro{% elsif idx == 3 %}BCAA Recovery{% else %}Multi-Vit Elite{% endif %}
            </h3>
            
            <div style="display:flex; justify-content:center; align-items:center; gap:4px; margin-bottom:20px; color:#00E5FF;">
              ★★★★★ <span style="color:#666666; font-family:'Inter', sans-serif; font-size:12px; margin-left:4px;">(124)</span>
            </div>
            
            <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px solid #222222; padding-top:20px;">
              <div style="font-family:'Teko', sans-serif; font-size:28px; font-weight:600; color:#FFFFFF;">
                {% if idx == 1 %}$45.00{% elsif idx == 2 %}$65.00{% elsif idx == 3 %}$35.00{% else %}$25.00{% endif %}
              </div>
              <button style="background:#FFFFFF; color:#0A0A0A; border:none; padding:8px 24px; font-family:'Teko', sans-serif; font-size:20px; font-weight:600; text-transform:uppercase; cursor:pointer; transform:skewX(-10deg); transition:all 0.3s ease;" class="fs-add-btn">
                <span style="display:inline-block; transform:skewX(10deg);">Add</span>
              </button>
            </div>
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .fs-link-btn:hover { color: #FFFFFF; }
    .fs-product-card:hover { border-color: #FF3366; transform: translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.8); z-index: 10; }
    .fs-product-card:hover .fs-product-img { transform: scale(1.05); border-color: #FF3366; }
    .fs-add-btn:hover { background: #FF3366; color: #FFFFFF; box-shadow: 0 0 15px rgba(255,51,102,0.5); }
    
    @media (max-width: 1024px) {
      .fs-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 30px !important; }
    }
    @media (max-width: 640px) {
      .fs-product-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Fitness Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ELITE ARSENAL"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Fitness Collection"
    }
  ]
}
{% endschema %}
