<div style="background:#F0EDE8; padding-bottom:80px;">
  <div class="fc-hero-container" style="display:flex; flex-direction:column; min-height:85vh; padding:24px;">
    
    <div class="fc-hero-visual" style="flex:1; position:relative; overflow:hidden; border:2px solid #1a1a1a;">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', style: 'width:100%; height:100%; object-fit:cover; position:absolute; inset:0;' }}
      {%- else -%}
        <img src="https://images.unsplash.com/photo-1523398002811-999aa8d9512e?auto=format&fit=crop&w=1600&q=80" alt="VŌLT Fashion Campaign" style="width:100%; height:100%; object-fit:cover; position:absolute; inset:0;" loading="eager">
      {%- endif -%}
    </div>
    
    <div class="fc-hero-content" style="padding-top:40px; display:flex; justify-content:space-between; align-items:flex-end;">
      
      <div style="max-width:800px;">
        <h1 style="font-family:'Inter', sans-serif; font-size:clamp(48px, 8vw, 120px); font-weight:800; letter-spacing:-2px; color:#1a1a1a; line-height:0.9; margin:0 0 24px 0; text-transform:uppercase;">
          {{ section.settings.heading }}
        </h1>
        <p style="font-family:'Inter', sans-serif; font-size:16px; font-weight:500; color:#1a1a1a; max-width:400px; margin:0;">
          {{ section.settings.subheading }}
        </p>
      </div>
      
      <div class="fc-hero-actions" style="display:flex; gap:16px;">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="fc-btn-primary" style="display:inline-block; padding:20px 40px; background:#1a1a1a; color:#F0EDE8; font-family:'Inter', sans-serif; font-size:14px; font-weight:700; letter-spacing:1px; text-transform:uppercase; text-decoration:none; border:2px solid #1a1a1a; transition:all 0.3s ease;">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
        
        {%- if section.settings.cta_label_2 != blank -%}
          <a href="{{ section.settings.cta_url_2 | default: '/pages/lookbook' }}" class="fc-btn-secondary" style="display:inline-block; padding:20px 40px; background:transparent; color:#1a1a1a; font-family:'Inter', sans-serif; font-size:14px; font-weight:700; letter-spacing:1px; text-transform:uppercase; text-decoration:none; border:2px solid #1a1a1a; transition:all 0.3s ease;">
            {{ section.settings.cta_label_2 }}
          </a>
        {%- endif -%}
      </div>
      
    </div>
  </div>

  <style>
    .fc-btn-primary:hover { background: #F0EDE8; color: #1a1a1a !important; }
    .fc-btn-secondary:hover { background: #1a1a1a; color: #F0EDE8 !important; }
    
    @media (max-width: 990px) {
      .fc-hero-content { flex-direction: column; align-items: flex-start; gap: 40px; }
      .fc-hero-actions { width: 100%; flex-wrap: wrap; }
      .fc-hero-actions a { flex: 1; text-align: center; }
    }
    @media (max-width: 480px) {
      .fc-hero-visual { min-height: 50vh; }
      .fc-hero-actions { flex-direction: column; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Fashion Hero",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "REDEFINE THE METROPOLIS."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Streetwear engineered for the modern dystopian landscape."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary Button Label",
      "default": "SHOP SS26"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "cta_label_2",
      "label": "Secondary Button Label",
      "default": "VIEW LOOKBOOK"
    },
    {
      "type": "url",
      "id": "cta_url_2",
      "label": "Secondary Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Fashion Hero"
    }
  ]
}
{% endschema %}
