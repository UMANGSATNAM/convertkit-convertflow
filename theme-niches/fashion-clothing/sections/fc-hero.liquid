<div class="fc-hero">
  <div class="fc-hero__content">
    <span class="fc-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="fc-hero__title">{{ section.settings.heading }}</h1>
    <p class="fc-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:16px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="fc-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="fc-btn fc-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="fc-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image.alt | escape }}" width="1400" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:600px;background:var(--fc-grey-bg)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"FC Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE NEW ARCHETYPE"},{"type":"text","id":"heading","label":"Heading","default":"Simplicity In Design"},{"type":"textarea","id":"subheading","label":"Subheading","default":"A curated collection of modern ready-to-wear, defined by clean lines, premium fabrics, and architectural silhouettes."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"SHOP THE COLLECTION"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"READ JOURNAL"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"FC Hero"}]}
{% endschema %}
