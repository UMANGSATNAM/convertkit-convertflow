<div style="padding:100px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="fc-section-header"><span class="fc-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="fc-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="fc-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--fc-grey-bg)"></div>{%- endif -%}<div class="fc-col-card__overlay"><span class="fc-col-card__title">{{ block.settings.title }}</span><span class="fc-col-card__cta">Shop Collection</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"FC Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CATEGORIES"},{"type":"text","id":"heading","label":"Heading","default":"Curated Wardrobe"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Summer Edit"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"FC Collections","blocks":[{"type":"col","settings":{"title":"Ready To Wear"}},{"type":"col","settings":{"title":"Tailored Outerwear"}},{"type":"col","settings":{"title":"Minimalist Basics"}}]}]}
{% endschema %}
