<div style="padding:48px 20px 80px;background:var(--fc-grey-light)"><div style="max-width:1320px;margin:0 auto">
  <nav style="font-size:12px;font-family:'Montserrat',sans-serif;color:var(--fc-muted);margin-bottom:32px;letter-spacing:0.05em" aria-label="Breadcrumb"><a href="/" style="color:var(--fc-muted)">Home</a> / <a href="{{ product.collections.first.url }}" style="color:var(--fc-muted)">{{ product.collections.first.title }}</a> / <span style="color:var(--fc-black)">{{ product.title }}</span></nav>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start">
    <div data-gallery>
      <div style="overflow:hidden;background:var(--fc-grey-bg);aspect-ratio:3/4;margin-bottom:12px;cursor:zoom-in"><img id="MainProductImg" data-main-img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}" width="1000" style="width:100%;height:100%;object-fit:cover"></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">{%- for img in product.images limit: 6 -%}<div data-thumb data-src="{{ img | image_url: width: 1000 }}" style="width:72px;height:96px;overflow:hidden;cursor:pointer;border:1px solid {% if forloop.first %}var(--fc-black){% else %}transparent{% endif %};transition:border-color .2s"><img src="{{ img | image_url: width: 144 }}" alt="" width="72" height="96" style="width:100%;height:100%;object-fit:cover"></div>{%- endfor -%}</div>
    </div>
    <div>
      <span class="fc-eyebrow" style="margin-bottom:8px">{{ product.vendor }}</span>
      <h1 style="font-family:'Playfair Display',serif;font-size:34px;font-weight:400;color:var(--fc-black);margin-bottom:12px;letter-spacing:-0.01em">{{ product.title }}</h1>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px"><span style="color:var(--fc-accent);font-size:13px;letter-spacing:2px">★★★★★</span><span style="font-size:12px;color:var(--fc-muted);font-family:'Montserrat',sans-serif">({{ product.metafields.reviews.rating_count | default: '482' }})</span></div>
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid var(--fc-border)">
        <span style="font-family:'Montserrat',sans-serif;font-size:26px;font-weight:500;color:var(--fc-black)" data-price>{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}<span style="font-family:'Montserrat',sans-serif;font-size:18px;color:var(--fc-muted);text-decoration:line-through" data-compare-price>{{ product.compare_at_price | money }}</span>{%- endif -%}
      </div>
      <!-- Minimalist Size / Color Swatches -->
      <form action="{{ routes.cart_add_url }}" method="post" id="ProductForm">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- unless product.has_only_default_variant -%}{%- for option in product.options_with_values -%}<div style="margin-bottom:24px"><div style="display:flex;justify-content:between;align-items:center;margin-bottom:10px"><label style="font-family:'Montserrat',sans-serif;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--fc-black)">{{ option.name }}</label></div><div style="display:flex;gap:10px;flex-wrap:wrap" data-swatches>{%- for value in option.values -%}<button type="button" data-swatch="{{ value }}" style="padding:12px 24px;border:1px solid {% if option.selected_value == value %}var(--fc-black){% else %}var(--fc-border){% endif %};background:{% if option.selected_value == value %}var(--fc-black){% else %}transparent{% endif %};color:{% if option.selected_value == value %}#fff{% else %}var(--fc-black){% endif %};font-family:'Montserrat',sans-serif;font-size:12px;font-weight:500;cursor:pointer;border-radius:0px;transition:all .2s">{{ value }}</button>{%- endfor -%}</div></div>{%- endfor -%}<select name="id" data-variant-select style="display:none">{%- for variant in product.variants -%}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</option>{%- endfor -%}</select>{%- endunless -%}
        <div style="display:flex;gap:12px;margin-bottom:16px">
          <div style="display:flex;align-items:center;border:1px solid var(--fc-border);border-radius:0px;background:transparent;overflow:hidden"><button type="button" data-dir="down" style="width:48px;height:54px;background:none;border:none;font-size:18px;cursor:pointer">−</button><input type="number" name="quantity" value="1" min="1" style="width:48px;height:54px;text-align:center;border:none;background:transparent;font-size:15px;font-weight:500"><button type="button" data-dir="up" style="width:48px;height:54px;background:none;border:none;font-size:18px;cursor:pointer">+</button></div>
          <button type="submit" class="fc-btn" data-atc style="flex:1;justify-content:center" {% unless product.available %}disabled{% endunless %}>{%- if product.available -%}ADD TO BAG{%- else -%}SOLD OUT{%- endif -%}</button>
        </div>
      </form>
      <!-- Trust List -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:24px 0">
        <div style="display:flex;align-items:center;gap:8px;padding:12px;border:1px solid var(--fc-border);font-size:11px;font-family:'Montserrat',sans-serif;text-transform:uppercase;letter-spacing:0.05em;color:var(--fc-black)"><span style="font-size:14px">✓</span> Italian Wools</div>
        <div style="display:flex;align-items:center;gap:8px;padding:12px;border:1px solid var(--fc-border);font-size:11px;font-family:'Montserrat',sans-serif;text-transform:uppercase;letter-spacing:0.05em;color:var(--fc-black)"><span style="font-size:14px">✓</span> Egyptian Cotton</div>
        <div style="display:flex;align-items:center;gap:8px;padding:12px;border:1px solid var(--fc-border);font-size:11px;font-family:'Montserrat',sans-serif;text-transform:uppercase;letter-spacing:0.05em;color:var(--fc-black)">🚚 Free Shipping</div>
        <div style="display:flex;align-items:center;gap:8px;padding:12px;border:1px solid var(--fc-border);font-size:11px;font-family:'Montserrat',sans-serif;text-transform:uppercase;letter-spacing:0.05em;color:var(--fc-black)">↩ Easy Exchanges</div>
      </div>
      <div style="font-family:'Montserrat',sans-serif;font-size:14px;line-height:1.8;color:var(--fc-muted)">{{ product.description }}</div>
    </div>
  </div>
</div></div>
{% schema %}
{"name":"FC Product","settings":[],"presets":[{"name":"FC Product"}]}
{% endschema %}
