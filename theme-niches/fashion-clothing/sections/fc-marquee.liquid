<div style="background:#1a1a1a; padding:16px 0; overflow:hidden; white-space:nowrap; display:flex;">
  <div class="fc-marquee-track" style="display:inline-block; animation: marquee 20s linear infinite; white-space:nowrap;">
    {%- assign marquee_text = section.settings.text | default: "VŌLT WORLDWIDE / FW26 COLLECTION / TOKYO / LONDON / NEW YORK / PARIS /" -%}
    <span style="font-family:'Inter', sans-serif; font-size:24px; font-weight:800; color:#F0EDE8; text-transform:uppercase; padding-right:40px;">
      {{ marquee_text }}
    </span>
    <span style="font-family:'Inter', sans-serif; font-size:24px; font-weight:800; color:#F0EDE8; text-transform:uppercase; padding-right:40px;">
      {{ marquee_text }}
    </span>
    <span style="font-family:'Inter', sans-serif; font-size:24px; font-weight:800; color:#F0EDE8; text-transform:uppercase; padding-right:40px;">
      {{ marquee_text }}
    </span>
    <span style="font-family:'Inter', sans-serif; font-size:24px; font-weight:800; color:#F0EDE8; text-transform:uppercase; padding-right:40px;">
      {{ marquee_text }}
    </span>
  </div>
  
  <style>
    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
  </style>
</div>

{% schema %}
{
  "name": "Marquee Banner",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Marquee Text",
      "default": "VŌLT WORLDWIDE / FW26 COLLECTION / TOKYO / LONDON / NEW YORK / PARIS /"
    }
  ],
  "presets": [
    {
      "name": "Marquee Banner"
    }
  ]
}
{% endschema %}
