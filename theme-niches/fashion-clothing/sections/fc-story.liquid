<div style="background:#1a1a1a; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div class="fc-story-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center;">
      
      <div class="fc-story-image" style="position:relative; overflow:hidden; border:2px solid #F0EDE8; min-height:600px;">
        <img src="https://images.unsplash.com/photo-1492288991661-058aa541ff43?auto=format&fit=crop&w=800&q=80" alt="VŌLT Editorial" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:grayscale(30%);">
        <div style="position:absolute; bottom:20px; right:20px; background:#F0EDE8; color:#1a1a1a; font-family:'Inter', sans-serif; font-size:12px; font-weight:800; padding:4px 12px; text-transform:uppercase;">ARCHIVE_01</div>
      </div>
      
      <div class="fc-story-content" style="color:#F0EDE8;">
        <h2 style="font-family:'Inter', sans-serif; font-size:clamp(48px, 6vw, 80px); font-weight:800; line-height:1; letter-spacing:-2px; margin:0 0 40px 0; text-transform:uppercase;">
          {{ section.settings.heading }}
        </h2>
        
        <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:500; line-height:1.6; color:#a09e9a; margin-bottom:40px; max-width:500px;">
          {{ section.settings.body }}
        </p>
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/pages/about' }}" style="display:inline-flex; align-items:center; font-family:'Inter', sans-serif; font-size:14px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#F0EDE8; text-decoration:none; border-bottom:2px solid #F0EDE8; padding-bottom:4px; transition:color 0.3s ease, border-color 0.3s ease;" class="fc-link-hover">
            {{ section.settings.cta_label }}
            <svg style="width:20px; height:20px; margin-left:12px; fill:currentColor;" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" fill="none"/></svg>
          </a>
        {%- endif -%}
      </div>
      
    </div>

  </div>

  <style>
    .fc-link-hover:hover { opacity: 0.7; }
    
    @media (max-width: 990px) {
      .fc-story-grid { grid-template-columns: 1fr; gap: 40px; }
      .fc-story-image { min-height: 400px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Fashion Story",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SYSTEM OF DRESS."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body Content",
      "default": "VŌLT is an ongoing study in utilitarian design. We strip away the unnecessary to focus on silhouette, fabric performance, and uncompromising construction."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "READ THE MANIFESTO"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Fashion Story"
    }
  ]
}
{% endschema %}
