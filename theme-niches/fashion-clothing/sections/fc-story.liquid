<div style="padding:100px 20px;background:var(--fc-black)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center">
  <div>
    <span class="fc-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Playfair Display',serif;font-size:clamp(30px,4.5vw,52px);font-weight:400;color:var(--fc-white);margin-bottom:24px;line-height:1.1">{{ section.settings.heading }}</h2>
    <p style="font-family:'Montserrat',sans-serif;font-size:15px;color:var(--fc-muted);line-height:1.8;max-width:440px">{{ section.settings.body }}</p>
    <div class="fc-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="fc-stat" style="border-color:rgba(255,255,255,0.1);background:rgba(255,255,255,0.02)" {{ block.shopify_attributes }}><div class="fc-stat__num" style="color:var(--fc-white)">{{ block.settings.number }}</div><div class="fc-stat__label" style="color:var(--fc-muted)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" width="900" style="width:100%;object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:3/4;background:rgba(255,255,255,0.05)"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"FC Story","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE BRAND PHILOSOPHY"},{"type":"text","id":"heading","label":"Heading","default":"Designed To Last."},{"type":"textarea","id":"body","label":"Body","default":"We reject trend cycles. We create capsule garments with exceptional tailors utilizing the finest Italian wools and Egyptian cottons."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"01."},{"type":"text","id":"label","label":"Label","default":"Quality First"}]}],"presets":[{"name":"FC Story","blocks":[{"type":"stat","settings":{"number":"01.","label":"Egyptian Cotton"}},{"type":"stat","settings":{"number":"100%","label":"Italian Wool"}},{"type":"stat","settings":{"number":"Zero","label":"Synthetic Blends"}},{"type":"stat","settings":{"number":"Limit","label":"Small Runs"}}]}]}
{% endschema %}
