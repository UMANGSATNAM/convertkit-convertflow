{% style %}
.fashion-hero {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  height: 92vh;
  border-bottom: 1px solid var(--border);
}
.fashion-hero__visual {
  background: #1A1A1A;
  display: flex;
  align-items: flex-end;
  padding: 60px;
  position: relative;
  overflow: hidden;
}
.fashion-hero__visual::before {
  content: 'COLLECTION';
  position: absolute;
  top: 50%;
  left: -80px;
  transform: translateY(-50%) rotate(-90deg);
  font-family: 'Bebas Neue', sans-serif;
  font-size: 200px;
  color: rgba(255,255,255,0.04);
  letter-spacing: 10px;
  white-space: nowrap;
}
.fashion-hero__visual img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.8;
}
.fashion-hero__tag {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: var(--accent);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 4px;
  text-transform: uppercase;
  position: relative;
  z-index: 2;
}
.fashion-hero__tag::before {
  content: '';
  width: 32px;
  height: 1px;
  background: var(--accent);
}
.fashion-hero__content {
  padding: 80px 80px 80px 70px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
}
.fashion-hero__content h1 {
  font-size: 110px;
  line-height: 0.92;
  margin: 20px 0 30px;
  color: var(--ink);
}
.fashion-hero__content p {
  font-size: 17px;
  color: var(--mid);
  line-height: 1.8;
  max-width: 380px;
  margin-bottom: 48px;
  font-weight: 300;
}
.fashion-hero__cta-group {
  display: flex;
  gap: 16px;
}
.fashion-hero__btn-dark {
  background: var(--ink);
  color: #fff;
  padding: 18px 40px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  text-decoration: none;
  transition: opacity 0.2s;
}
.fashion-hero__btn-dark:hover { opacity: 0.8; }
.fashion-hero__btn-outline {
  background: transparent;
  color: var(--ink);
  border: 1px solid var(--ink);
  padding: 17px 40px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 0.2s;
}
.fashion-hero__btn-outline:hover {
  background: var(--ink);
  color: #fff;
}
.fashion-hero__scroll {
  position: absolute;
  bottom: 40px;
  right: 60px;
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--mid);
}
.fashion-hero__scroll::after {
  content: '';
  width: 40px;
  height: 1px;
  background: var(--mid);
}
@media(max-width: 1024px) {
  .fashion-hero { grid-template-columns: 1fr; height: auto; }
  .fashion-hero__content { padding: 60px 40px; }
  .fashion-hero__content h1 { font-size: 72px; }
  .fashion-hero__scroll { display: none; }
}
{% endstyle %}

<section class="fashion-hero">
  <div class="fashion-hero__visual">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1400 }}" loading="eager" alt="Hero">
    {%- endif -%}
    <div class="fashion-hero__tag">{{ section.settings.tag }}</div>
  </div>
  <div class="fashion-hero__content">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    <div class="fashion-hero__cta-group">
      {%- if section.settings.btn1_text != blank -%}
        <a href="{{ section.settings.btn1_url }}" class="fashion-hero__btn-dark">{{ section.settings.btn1_text }}</a>
      {%- endif -%}
      {%- if section.settings.btn2_text != blank -%}
        <a href="{{ section.settings.btn2_url }}" class="fashion-hero__btn-outline">{{ section.settings.btn2_text }}</a>
      {%- endif -%}
    </div>
    <div class="fashion-hero__scroll">Scroll</div>
  </div>
</section>

{% schema %}
{
  "name": "Fashion Hero",
  "settings": [
    { "type": "text", "id": "tag", "label": "Tag", "default": "SS 2025 Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "DRESSED FOR THE FUTURE" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Premium essentials engineered for people who move with intention. Every stitch, deliberate. Every fabric, chosen for life." },
    { "type": "text", "id": "btn1_text", "label": "Primary Button", "default": "Shop Women" },
    { "type": "url", "id": "btn1_url", "label": "Primary URL" },
    { "type": "text", "id": "btn2_text", "label": "Secondary Button", "default": "Shop Men" },
    { "type": "url", "id": "btn2_url", "label": "Secondary URL" },
    { "type": "image_picker", "id": "image", "label": "Visual Image" }
  ],
  "presets": [{ "name": "Fashion Hero" }]
}
{% endschema %}
