<div class="cats">
  {%- for block in section.blocks -%}
    <a href="{{ block.settings.url }}" class="cat">
      <span class="cat-label">{{ block.settings.title }}</span>
      <span class="cat-count">{{ block.settings.subtitle }}</span>
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Fashion Categories",
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Outerwear" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "48 Styles" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Fashion Categories" }]
}
{% endschema %}
