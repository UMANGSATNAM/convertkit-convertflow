<div style="background:#F0EDE8; padding:80px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; border-bottom:4px solid #1a1a1a; padding-bottom:16px; margin-bottom:40px;">
      <h2 style="font-family:'Inter', sans-serif; font-size:clamp(32px, 5vw, 64px); font-weight:800; color:#1a1a1a; margin:0; line-height:1; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="fc-category-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:20px;">
      
      {%- for block in section.blocks -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1550614000-4b95d4ebf949?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1550614000-4b95d4ebf949?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1576871337622-98d48d1cf531?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1541099649105-f69ad21f3246?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1588117260148-b47818741c74?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <a href="{{ block.settings.link | default: '#' }}" class="fc-cat-card" style="display:block; text-decoration:none; position:relative; overflow:hidden; border:2px solid #1a1a1a; padding-bottom:120%; group">
          <img src="{{ block.settings.image | image_url: width: 600 | default: img_url }}" alt="{{ block.settings.title }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease; filter:grayscale(30%);" class="fc-cat-img" loading="lazy">
          
          <div style="position:absolute; inset:0; background:rgba(0,0,0,0.3); transition:background 0.3s;" class="fc-cat-overlay"></div>
          
          <h3 style="position:absolute; bottom:20px; left:20px; font-family:'Inter', sans-serif; font-size:clamp(20px, 2vw, 32px); font-weight:800; color:#F0EDE8; margin:0; text-transform:uppercase; letter-spacing:-1px; z-index:2;">
            {{ block.settings.title }}
          </h3>
        </a>
      {%- else -%}
        <!-- Fallback if no blocks -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .fc-cat-card:hover .fc-cat-img { transform: scale(1.05); filter: grayscale(0%); }
    .fc-cat-card:hover .fc-cat-overlay { background: rgba(0,0,0,0.1); }
    
    @media (max-width: 990px) {
      .fc-category-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Fashion Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CATEGORIES"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fashion Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
