<div style="padding:100px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="fc-section-header"><span class="fc-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="fc-review-grid">{%- for block in section.blocks -%}<div class="fc-review-card" {{ block.shopify_attributes }}><div class="fc-review-card__stars">{%- for i in (1..block.settings.rating) -%}★{%- endfor -%}</div><div class="fc-review-card__text">"{{ block.settings.quote }}"</div><div class="fc-review-card__author">{{ block.settings.name }}</div><div class="fc-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"FC Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CLIENT REVIEWS"},{"type":"text","id":"heading","label":"Heading","default":"Verified Wardrobe Notes"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"FC Reviews","blocks":[{"type":"review","settings":{"rating":5,"quote":"The linen trench coat draping is immaculate. True craftsmanship. Will be ordering more.","name":"Sarah L.","product":"Linen Trench Coat"}},{"type":"review","settings":{"rating":5,"quote":"Minimal, timeless cuts that fit perfectly. Essential core wardrobe pieces that last years.","name":"Marc A.","product":"Tailored Linen Shirt"}},{"type":"review","settings":{"rating":5,"quote":"Unparalleled texture and quality. Egyptian cotton feels luxury to touch.","name":"Helena G.","product":"Egypt Knit Tee"}}]}]}
{% endschema %}
