<div style="background:#F0EDE8; padding:100px 24px; border-top:4px solid #1a1a1a;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; border-bottom:4px solid #1a1a1a; padding-bottom:16px; margin-bottom:40px;">
      <h2 style="font-family:'Inter', sans-serif; font-size:clamp(32px, 5vw, 64px); font-weight:800; color:#1a1a1a; margin:0; line-height:1; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="fc-reviews-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:20px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#1a1a1a; color:#F0EDE8; padding:40px; position:relative; border:2px solid #1a1a1a;">
          <div style="font-family:'Inter', sans-serif; font-size:64px; font-weight:800; color:rgba(240, 237, 232, 0.2); position:absolute; top:20px; right:20px; line-height:1;">"</div>
          
          <div style="display:flex; gap:4px; margin-bottom:32px;">
            <svg style="width:20px; height:20px; fill:#F0EDE8;" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg style="width:20px; height:20px; fill:#F0EDE8;" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg style="width:20px; height:20px; fill:#F0EDE8;" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg style="width:20px; height:20px; fill:#F0EDE8;" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg style="width:20px; height:20px; fill:#F0EDE8;" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          </div>
          
          <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:500; line-height:1.6; color:#F0EDE8; margin-bottom:40px; position:relative; z-index:2;">
            {{ block.settings.quote }}
          </p>
          
          <div style="border-top:2px solid rgba(240, 237, 232, 0.2); padding-top:20px; font-family:'Inter', sans-serif; font-size:14px; font-weight:800; letter-spacing:1px; text-transform:uppercase; color:#F0EDE8;">
            {{ block.settings.name }} / VERIFIED BUYER
          </div>
        </div>
      {%- else -%}
        <!-- Fallback if no blocks -->
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    @media (max-width: 990px) {
      .fc-reviews-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Fashion Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TRANSMISSIONS"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Impeccable cut. The jacket drapes exactly how it looks in the lookbook."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Reviewer Name",
          "default": "HAYDEN K."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fashion Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
