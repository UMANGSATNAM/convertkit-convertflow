<div style="padding:60px 20px 0;background:var(--fc-grey-light)"><div style="max-width:1320px;margin:0 auto;text-align:center;padding-bottom:56px"><span class="fc-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</span><h1 style="font-family:'Playfair Display',serif;font-size:clamp(32px,5vw,56px);font-weight:400;color:var(--fc-black);margin-bottom:12px">{{ collection.title }}</h1>{%- if collection.description != blank -%}<p style="font-family:'Montserrat',sans-serif;font-size:15px;color:var(--fc-muted);max-width:560px;margin:0 auto">{{ collection.description }}</p>{%- endif -%}</div></div>
<div style="padding:0 20px 100px;background:#fff"><div style="max-width:1320px;margin:0 auto"><div style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid var(--fc-border);margin-bottom:40px"><div style="font-family:'Montserrat',sans-serif;font-size:13px;color:var(--fc-muted)">{{ collection.products_count }} garments</div><select style="padding:10px 20px;border:1px solid var(--fc-border);border-radius:0px;font-family:'Montserrat',sans-serif;font-size:12px;cursor:pointer"><option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Newest</option></select></div><div class="fc-prod-grid">{%- for product in collection.products -%}<a href="{{ product.url }}" class="fc-prod-card"><div class="fc-prod-card__img">{%- if product.compare_at_price > product.price -%}<span class="fc-prod-card__tag">Sale</span>{%- endif -%}{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" width="700" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--fc-grey-bg)"></div>{%- endif -%}</div><div class="fc-prod-card__name">{{ product.title }}</div><div class="fc-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div></div></div>
{% schema %}
{"name":"FC Collection","settings":[],"presets":[{"name":"FC Collection"}]}
{% endschema %}
