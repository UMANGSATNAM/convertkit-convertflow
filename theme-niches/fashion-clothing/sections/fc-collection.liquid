<div style="background:#F0EDE8; padding:100px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; border-bottom:4px solid #1a1a1a; padding-bottom:16px; margin-bottom:40px;">
      <h2 style="font-family:'Inter', sans-serif; font-size:clamp(32px, 5vw, 64px); font-weight:800; color:#1a1a1a; margin:0; line-height:1; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Inter', sans-serif; font-size:14px; font-weight:700; color:#1a1a1a; text-decoration:none; text-transform:uppercase; letter-spacing:1px; display:flex; align-items:center; gap:8px;" class="fc-link-dark">
          {{ section.settings.cta_label }}
          <svg style="width:20px; height:20px; fill:currentColor;" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" fill="none"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="fc-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:20px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1550614000-4b95d4ebf949?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1550614000-4b95d4ebf949?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1576871337622-98d48d1cf531?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1541099649105-f69ad21f3246?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1588117260148-b47818741c74?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="fc-product-card" style="position:relative; group">
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; border:2px solid #1a1a1a; padding-bottom:130%; margin-bottom:16px; background:#e6e3dd;">
            <img src="{{ img_url }}" alt="VŌLT Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease; filter:grayscale(20%);" class="fc-product-img" loading="lazy">
            <div style="position:absolute; top:12px; right:12px; background:#1a1a1a; color:#F0EDE8; font-family:'Inter', sans-serif; font-size:12px; font-weight:800; padding:4px 8px; text-transform:uppercase;">NEW</div>
          </a>
          
          <div style="display:flex; justify-content:space-between; align-items:flex-start;">
            <div>
              <h3 style="font-family:'Inter', sans-serif; font-size:16px; font-weight:800; color:#1a1a1a; margin:0 0 4px 0; text-transform:uppercase;">
                {% if idx == 1 %}01. TECHNICAL SHELL{% elsif idx == 2 %}02. CARGO PANT{% elsif idx == 3 %}03. KNIT SWEATER{% else %}04. UTIL VEST{% endif %}
              </h3>
              <div style="font-family:'Inter', sans-serif; font-size:14px; font-weight:500; color:#555;">
                {% if idx == 1 %}FW26 / 100% NYLON{% elsif idx == 2 %}FW26 / HEAVY COTTON{% elsif idx == 3 %}FW26 / MERINO BLEND{% else %}FW26 / CORDURA{% endif %}
              </div>
            </div>
            <div style="font-family:'Inter', sans-serif; font-size:16px; font-weight:800; color:#1a1a1a;">
              {% if idx == 1 %}$350{% elsif idx == 2 %}$220{% elsif idx == 3 %}$280{% else %}$190{% endif %}
            </div>
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .fc-product-card:hover .fc-product-img { transform: scale(1.05); filter: grayscale(0%); }
    .fc-link-dark:hover { opacity: 0.7; }
    
    @media (max-width: 1024px) {
      .fc-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px 20px !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Fashion Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LATEST DROPS"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products to show",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL NEW ARRIVALS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Fashion Collection"
    }
  ]
}
{% endschema %}
