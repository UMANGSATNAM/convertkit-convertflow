<div style="padding:60px 20px 100px;background:var(--fc-grey-light);min-height:60vh"><div style="max-width:960px;margin:0 auto">
  <h1 style="font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,44px);font-weight:400;color:var(--fc-black);text-align:center;margin-bottom:56px">Your Bag</h1>
  {%- if cart.item_count == 0 -%}<div style="text-align:center;padding:80px 20px"><div style="font-size:40px;margin-bottom:24px">👜</div><h2 style="font-family:'Playfair Display',serif;font-size:28px;font-weight:400;color:var(--fc-black);margin-bottom:12px">Your bag is empty</h2><p style="font-family:'Montserrat',sans-serif;color:var(--fc-muted);margin-bottom:36px">Discover minimal wardrobe essentials designed to last.</p><a href="/collections/all" class="fc-btn">SHOP APPAREL</a></div>
  {%- else -%}
  <div style="display:grid;grid-template-columns:1fr 380px;gap:48px;align-items:start">
    <div>{%- for item in cart.items -%}<div style="display:flex;gap:24px;padding:28px 0;border-bottom:1px solid var(--fc-border);align-items:center"><a href="{{ item.url }}" style="flex-shrink:0"><img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="90" height="120" style="object-fit:cover"></a><div style="flex:1;min-width:0"><a href="{{ item.url }}" style="text-decoration:none;font-family:'Playfair Display',serif;font-size:16px;color:var(--fc-black);display:block;margin-bottom:4px">{{ item.product.title }}</a>{%- unless item.variant.title == 'Default Title' -%}<div style="font-family:'Montserrat',sans-serif;font-size:12px;color:var(--fc-muted);margin-bottom:12px">{{ item.variant.title }}</div>{%- endunless -%}<div style="display:flex;align-items:center;gap:16px"><div style="display:flex;align-items:center;border:1px solid var(--fc-border);overflow:hidden"><button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px">−</button><span style="width:32px;text-align:center;font-family:'Montserrat',sans-serif;font-size:13px;font-weight:500">{{ item.quantity }}</span><button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px">+</button></div><a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" style="font-family:'Montserrat',sans-serif;font-size:11px;color:var(--fc-muted);text-transform:uppercase;letter-spacing:0.05em;text-decoration:underline">Remove</a></div></div><div style="font-family:'Montserrat',sans-serif;font-size:15px;font-weight:600;color:var(--fc-black)">{{ item.final_line_price | money }}</div></div>{%- endfor -%}</div>
    <div style="background:#fff;padding:40px;border:1px solid var(--fc-border);position:sticky;top:120px">
      <h3 style="font-family:'Playfair Display',serif;font-size:18px;font-weight:400;color:var(--fc-black);margin-bottom:28px">Order Summary</h3>
      <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-family:'Montserrat',sans-serif;font-size:13px"><span style="color:var(--fc-muted)">Subtotal</span><span style="font-weight:500;color:var(--fc-black)">{{ cart.total_price | money }}</span></div>
      <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-family:'Montserrat',sans-serif;font-size:13px"><span style="color:var(--fc-muted)">Shipping</span><span style="font-weight:500;color:var(--fc-black)">Free</span></div>
      <div style="padding-top:20px;border-top:1px solid var(--fc-border);margin-top:20px;display:flex;justify-content:space-between;margin-bottom:32px"><span style="font-family:'Playfair Display',serif;font-size:18px">Total</span><span style="font-family:'Montserrat',sans-serif;font-size:18px;font-weight:600;color:var(--fc-black)">{{ cart.total_price | money }}</span></div>
      <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="fc-btn" style="width:100%;justify-content:center">CHECKOUT</button></form>
      <div style="display:flex;flex-direction:column;gap:8px;margin-top:24px;text-align:center"><span style="font-size:10px;font-family:'Montserrat',sans-serif;letter-spacing:0.05em;color:var(--fc-muted)">✓ Exceptional Tailoring</span><span style="font-size:10px;font-family:'Montserrat',sans-serif;letter-spacing:0.05em;color:var(--fc-muted)">🚚 Free Worldwide Delivery</span></div>
    </div>
  </div>{%- endif -%}
</div></div>
{% schema %}
{"name":"FC Cart","settings":[],"presets":[{"name":"FC Cart"}]}
{% endschema %}
