<div style="background:#1a1a1a; padding:100px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; border-bottom:4px solid #F0EDE8; padding-bottom:16px; margin-bottom:40px;">
      <h2 style="font-family:'Inter', sans-serif; font-size:clamp(32px, 5vw, 64px); font-weight:800; color:#F0EDE8; margin:0; line-height:1; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/pages/lookbook' }}" style="font-family:'Inter', sans-serif; font-size:14px; font-weight:700; color:#F0EDE8; text-decoration:none; text-transform:uppercase; letter-spacing:1px; display:flex; align-items:center; gap:8px;" class="fc-link-light">
          {{ section.settings.cta_label }}
          <svg style="width:20px; height:20px; fill:currentColor;" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" fill="none"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="fc-lookbook-grid" style="display:grid; grid-template-columns:repeat(3, 1fr); gap:20px;">
      
      <div style="grid-column: span 2; position:relative; overflow:hidden; border:2px solid #F0EDE8; min-height:600px;">
        <img src="https://images.unsplash.com/photo-1512436991641-6745cdb1723f?auto=format&fit=crop&w=1200&q=80" alt="Lookbook 1" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:grayscale(20%);">
        <div style="position:absolute; top:20px; left:20px; background:#F0EDE8; color:#1a1a1a; font-family:'Inter', sans-serif; font-weight:800; font-size:14px; padding:4px 12px; text-transform:uppercase;">LOOK 01</div>
      </div>
      
      <div style="display:grid; grid-template-rows:repeat(2, 1fr); gap:20px;">
        <div style="position:relative; overflow:hidden; border:2px solid #F0EDE8; min-height:290px;">
          <img src="https://images.unsplash.com/photo-1552374196-1ab2a1c593e8?auto=format&fit=crop&w=600&q=80" alt="Lookbook 2" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:grayscale(20%);">
          <div style="position:absolute; top:20px; left:20px; background:#F0EDE8; color:#1a1a1a; font-family:'Inter', sans-serif; font-weight:800; font-size:14px; padding:4px 12px; text-transform:uppercase;">LOOK 02</div>
        </div>
        <div style="position:relative; overflow:hidden; border:2px solid #F0EDE8; min-height:290px;">
          <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=600&q=80" alt="Lookbook 3" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:grayscale(20%);">
          <div style="position:absolute; top:20px; left:20px; background:#F0EDE8; color:#1a1a1a; font-family:'Inter', sans-serif; font-weight:800; font-size:14px; padding:4px 12px; text-transform:uppercase;">LOOK 03</div>
        </div>
      </div>
      
    </div>
  </div>

  <style>
    .fc-link-light:hover { opacity: 0.7; }
    
    @media (max-width: 990px) {
      .fc-lookbook-grid { grid-template-columns: 1fr !important; }
      .fc-lookbook-grid > div:first-child { grid-column: span 1 !important; min-height: 400px; }
      .fc-lookbook-grid > div:nth-child(2) { grid-template-columns: repeat(2, 1fr); grid-template-rows: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Lookbook Feature",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE LOOKBOOK"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link Label",
      "default": "EXPLORE ALL ARCHIVES"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link URL"
    }
  ],
  "presets": [
    {
      "name": "Lookbook Feature"
    }
  ]
}
{% endschema %}
