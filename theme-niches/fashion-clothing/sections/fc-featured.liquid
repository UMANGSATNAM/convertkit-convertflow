<div style="padding:100px 20px;background:var(--fc-grey-light)"><div style="max-width:1320px;margin:0 auto">
  <div class="fc-section-header"><span class="fc-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  {%- assign col = collections[section.settings.collection] -%}
  <div class="fc-prod-grid">{%- for product in col.products limit: section.settings.count -%}<a href="{{ product.url }}" class="fc-prod-card"><div class="fc-prod-card__img">{%- if product.compare_at_price > product.price -%}<span class="fc-prod-card__tag">Sale</span>{%- endif -%}{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" width="700" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--fc-grey-bg)"></div>{%- endif -%}</div><div class="fc-prod-card__name">{{ product.title }}</div><div class="fc-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div>
  <div style="text-align:center;margin-top:60px"><a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="fc-btn fc-btn--outline">{{ section.settings.cta_label }}</a></div>
</div></div>
{% schema %}
{"name":"FC Featured","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SELECTED PIECES"},{"type":"text","id":"heading","label":"Heading","default":"Bestselling Essentials"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"count","label":"Products","min":4,"max":12,"step":4,"default":8},{"type":"text","id":"cta_label","label":"CTA","default":"VIEW ALL APPAREL"},{"type":"url","id":"cta_url","label":"CTA URL"}],"presets":[{"name":"FC Featured"}]}
{% endschema %}
