<div style="background:#FFFAF0; padding:100px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px;">
      <div>
        <h2 style="font-family:'Poppins', sans-serif; font-size:clamp(32px, 4vw, 48px); font-weight:800; color:#2D3748; margin:0 0 16px 0; letter-spacing:-1px;">
          {{ section.settings.heading }}
        </h2>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Poppins', sans-serif; font-size:16px; font-weight:700; color:#E53E3E; text-decoration:none; display:flex; align-items:center; gap:8px; padding:12px 24px; background:rgba(229,62,62,0.1); border-radius:30px; transition:all 0.3s ease;" class="ve-link-btn">
          {{ section.settings.cta_label }}
          <svg style="width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:3;" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="ve-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:30px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1579871494447-9811cf80d66c?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="ve-product-card" style="background:#FFFFFF; border-radius:30px; overflow:hidden; box-shadow:0 10px 30px rgba(0,0,0,0.05); transition:all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); display:flex; flex-direction:column; height:100%;">
          
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:70%;">
            <img src="{{ img_url }}" alt="Food Item" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease;" class="ve-product-img" loading="lazy">
            
            <div style="position:absolute; top:16px; right:16px; background:#FFFFFF; padding:6px 12px; border-radius:20px; font-family:'Poppins', sans-serif; font-size:12px; font-weight:700; color:#2D3748; display:flex; align-items:center; gap:4px; box-shadow:0 4px 10px rgba(0,0,0,0.1);">
              <span style="color:#F6AD55;">★</span> 4.8
            </div>
            
            {% if idx == 1 or idx == 3 %}
              <div style="position:absolute; top:16px; left:16px; background:#E53E3E; color:#FFFFFF; font-family:'Poppins', sans-serif; font-size:12px; font-weight:700; padding:6px 12px; border-radius:20px; letter-spacing:1px; text-transform:uppercase;">
                Popular
              </div>
            {% endif %}
          </a>
          
          <div style="padding:24px; display:flex; flex-direction:column; flex-grow:1;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
              <h3 style="font-family:'Poppins', sans-serif; font-size:20px; font-weight:700; color:#2D3748; margin:0;">
                {% if idx == 1 %}Classic Cheeseburger{% elsif idx == 2 %}Margherita Pizza{% elsif idx == 3 %}Healthy Bowl{% else %}Sushi Roll Platter{% endif %}
              </h3>
            </div>
            
            <p style="font-family:'Poppins', sans-serif; font-size:14px; font-weight:400; color:#718096; margin:0 0 24px 0; line-height:1.5; flex-grow:1;">
              {% if idx == 1 %}Juicy beef patty, melted cheese, fresh lettuce, tomato, and our secret sauce.{% elsif idx == 2 %}Fresh mozzarella, sweet basil, and our house-made tomato sauce on thin crust.{% elsif idx == 3 %}Quinoa, roasted sweet potatoes, avocado, and tahini dressing.{% else %}Assorted fresh sashimi and rolls with wasabi and soy sauce.{% endif %}
            </p>
            
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:auto;">
              <div style="font-family:'Poppins', sans-serif; font-size:24px; font-weight:800; color:#E53E3E;">
                {% if idx == 1 %}$12.99{% elsif idx == 2 %}$16.50{% elsif idx == 3 %}$14.00{% else %}$22.00{% endif %}
              </div>
              <button style="width:48px; height:48px; background:#2D3748; border-radius:50%; display:flex; align-items:center; justify-content:center; border:none; cursor:pointer; transition:all 0.3s ease;" class="ve-add-btn">
                <svg style="width:24px; height:24px; fill:#FFFFFF;" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
              </button>
            </div>
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .ve-product-card:hover { transform: translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
    .ve-product-card:hover .ve-product-img { transform: scale(1.05); }
    .ve-link-btn:hover { background: #E53E3E; color: #FFFFFF; }
    .ve-add-btn:hover { background: #E53E3E; transform: scale(1.1); }
    
    @media (max-width: 1024px) {
      .ve-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px 20px !important; }
    }
    @media (max-width: 640px) {
      .ve-product-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Veda Eats Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular Near You"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW MENU"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Veda Eats Collection"
    }
  ]
}
{% endschema %}
