<div style="background:#FFFFFF; padding:100px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:60px;">
      <h2 style="font-family:'Poppins', sans-serif; font-size:clamp(36px, 5vw, 48px); font-weight:800; color:#2D3748; margin:0 0 16px 0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="ve-category-grid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:20px;">
      
      {%- for block in section.blocks -%}
        <a href="#" class="ve-cat-card" style="display:flex; flex-direction:column; align-items:center; justify-content:center; padding:30px 20px; background:#FFFAF0; border-radius:30px; text-decoration:none; transition:all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); border:2px solid transparent;">
          <div style="font-size:48px; margin-bottom:16px; transition:transform 0.3s ease;" class="ve-cat-icon">
            {{ block.settings.icon }}
          </div>
          <h3 style="font-family:'Poppins', sans-serif; font-size:18px; font-weight:700; color:#2D3748; margin:0; text-align:center;">
            {{ block.settings.title }}
          </h3>
        </a>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .ve-cat-card:hover { transform: translateY(-10px); background: #FFFFFF; border-color: #E53E3E; box-shadow: 0 20px 40px rgba(229,62,62,0.1); }
    .ve-cat-card:hover .ve-cat-icon { transform: scale(1.2) rotate(5deg); }
  </style>
</div>

{% schema %}
{
  "name": "Veda Eats Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore the Menu"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pizza"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji Icon",
          "default": "🍕"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Veda Eats Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
