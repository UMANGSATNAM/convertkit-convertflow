<div style="background:#FFFAF0; position:relative; overflow:hidden; min-height:85vh; display:flex; align-items:center;">
  
  <div style="max-width:1440px; margin:0 auto; width:100%; padding:40px 24px; position:relative; z-index:2;">
    <div class="ve-hero-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center;">
      
      <!-- Content -->
      <div style="padding-right:20px;">
        <div style="display:inline-block; font-family:'Poppins', sans-serif; font-size:14px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#E53E3E; margin-bottom:24px; background:rgba(229,62,62,0.1); padding:8px 20px; border-radius:30px;">
          {{ section.settings.eyebrow }}
        </div>

        <h1 style="font-family:'Poppins', sans-serif; font-size:clamp(48px, 6vw, 76px); font-weight:800; line-height:1.1; color:#2D3748; margin:0 0 24px 0; letter-spacing:-1.5px;">
          {{ section.settings.heading }}
        </h1>
        
        <p style="font-family:'Poppins', sans-serif; font-size:clamp(18px, 2vw, 20px); font-weight:400; color:#4A5568; line-height:1.6; margin:0 0 40px 0; max-width:480px;">
          {{ section.settings.subheading }}
        </p>

        <div style="display:flex; gap:20px; align-items:center;" class="ve-hero-actions">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#E53E3E; color:#FFFFFF; font-family:'Poppins', sans-serif; font-size:16px; font-weight:700; letter-spacing:1px; text-decoration:none; padding:18px 40px; border-radius:50px; transition:all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); box-shadow:0 10px 25px rgba(229,62,62,0.4);" class="ve-btn-primary">
              {{ section.settings.cta_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
      
      <!-- Visuals -->
      <div style="position:relative; height:100%; min-height:500px; display:flex; justify-content:center; align-items:center;">
        
        <!-- Background shapes -->
        <div style="position:absolute; width:80%; height:80%; background:#FEEBC8; border-radius:50%; z-index:1; top:10%; right:0;"></div>
        <div style="position:absolute; width:60%; height:60%; background:#FED7D7; border-radius:50%; z-index:1; bottom:0; left:10%;"></div>

        <div style="position:relative; z-index:2; width:90%; padding-bottom:90%; border-radius:50%; overflow:hidden; border:8px solid #FFFFFF; box-shadow:0 30px 60px rgba(0,0,0,0.1); animation:ve-float 8s ease-in-out infinite;">
          <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=800&q=80" alt="Delicious Food" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;" loading="eager">
        </div>
        
        <!-- Floating badges -->
        <div style="position:absolute; top:20%; left:-5%; z-index:3; background:#FFFFFF; padding:12px 20px; border-radius:30px; box-shadow:0 10px 20px rgba(0,0,0,0.1); display:flex; align-items:center; gap:8px; animation:ve-float 6s ease-in-out infinite alternate;">
          <span style="font-size:24px;">⭐</span>
          <span style="font-family:'Poppins', sans-serif; font-weight:700; color:#2D3748;">4.9/5 Rating</span>
        </div>
        
        <div style="position:absolute; bottom:15%; right:-5%; z-index:3; background:#FFFFFF; padding:12px 20px; border-radius:30px; box-shadow:0 10px 20px rgba(0,0,0,0.1); display:flex; align-items:center; gap:8px; animation:ve-float 7s ease-in-out infinite alternate-reverse;">
          <span style="font-size:24px;">🚀</span>
          <span style="font-family:'Poppins', sans-serif; font-weight:700; color:#2D3748;">Fast Delivery</span>
        </div>
      </div>
      
    </div>
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800;900&display=swap');
    
    .ve-btn-primary:hover { transform: translateY(-5px) scale(1.05); box-shadow: 0 15px 30px rgba(229,62,62,0.5); }
    
    @keyframes ve-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-20px); } }
    
    @media (max-width: 990px) {
      .ve-hero-grid { grid-template-columns: 1fr; gap: 40px; text-align: center; }
      .ve-hero-grid > div:first-child { padding-right: 0; }
      .ve-hero-actions { justify-content: center; }
      .ve-hero-grid > div:last-child { min-height: 400px; }
    }
    @media (max-width: 640px) {
      .ve-hero-actions { flex-direction: column; width: 100%; align-items: stretch; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Veda Eats Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FRESH & FAST"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Cravings, Cured."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover local flavors and chef-crafted meals delivered hot to your doorstep."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "ORDER NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Veda Eats Hero"
    }
  ]
}
{% endschema %}
