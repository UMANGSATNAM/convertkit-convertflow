<div style="background:#2D3748; padding:120px 24px; position:relative; overflow:hidden;">
  
  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    <div class="ve-featured-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
      
      <!-- Visuals -->
      <div style="position:relative; min-height:500px; display:flex; justify-content:center; align-items:center;">
        <div style="position:absolute; width:90%; height:90%; background:rgba(255,255,255,0.05); border-radius:50%; z-index:1; border:2px dashed rgba(255,255,255,0.2); animation:ve-spin 40s linear infinite;"></div>
        
        <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=800&q=80" alt="Featured Meal" style="width:80%; height:80%; object-fit:contain; position:relative; z-index:2; filter:drop-shadow(0 30px 40px rgba(0,0,0,0.5)); transition:transform 0.5s ease;" class="ve-featured-img" loading="lazy">
        
        <div style="position:absolute; bottom:10%; right:10%; background:#E53E3E; color:#FFFFFF; padding:24px; z-index:3; border-radius:50%; width:120px; height:120px; display:flex; flex-direction:column; justify-content:center; align-items:center; box-shadow:0 15px 30px rgba(229,62,62,0.4); transform:rotate(-10deg);">
          <div style="font-family:'Poppins', sans-serif; font-size:14px; font-weight:700; text-transform:uppercase;">Only</div>
          <div style="font-family:'Poppins', sans-serif; font-size:28px; font-weight:900; line-height:1;">$14</div>
        </div>
      </div>
      
      <!-- Content -->
      <div>
        <div style="display:inline-block; font-family:'Poppins', sans-serif; font-size:14px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#F6AD55; margin-bottom:24px; background:rgba(246,173,85,0.1); padding:8px 20px; border-radius:30px;">
          {{ section.settings.eyebrow }}
        </div>
        
        <h2 style="font-family:'Poppins', sans-serif; font-size:clamp(40px, 5vw, 64px); font-weight:800; line-height:1.1; color:#FFFFFF; margin:0 0 24px 0; letter-spacing:-1px;">
          {{ section.settings.heading }}
        </h2>
        
        <p style="font-family:'Poppins', sans-serif; font-size:18px; font-weight:400; line-height:1.6; color:#A0AEC0; margin-bottom:40px;">
          Experience an explosion of flavor with our signature truffle mushroom burger. A perfectly seared prime beef patty topped with wild mushrooms, melted Swiss cheese, and our house-made truffle aioli, nestled in a toasted brioche bun.
        </p>
        
        <div style="display:flex; flex-wrap:wrap; gap:16px; margin-bottom:48px;">
          <span style="background:rgba(255,255,255,0.1); color:#FFFFFF; font-family:'Poppins', sans-serif; font-size:14px; padding:8px 16px; border-radius:20px;">🍄 Truffle Aioli</span>
          <span style="background:rgba(255,255,255,0.1); color:#FFFFFF; font-family:'Poppins', sans-serif; font-size:14px; padding:8px 16px; border-radius:20px;">🧀 Swiss Cheese</span>
          <span style="background:rgba(255,255,255,0.1); color:#FFFFFF; font-family:'Poppins', sans-serif; font-size:14px; padding:8px 16px; border-radius:20px;">🥩 Prime Beef</span>
        </div>
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/products/truffle-burger' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#E53E3E; color:#FFFFFF; font-family:'Poppins', sans-serif; font-size:16px; font-weight:700; letter-spacing:1px; text-decoration:none; padding:18px 40px; border-radius:50px; transition:all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); box-shadow:0 10px 25px rgba(229,62,62,0.4);" class="ve-btn-primary">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
      
    </div>
  </div>

  <style>
    .ve-btn-primary:hover { transform: translateY(-5px) scale(1.05); box-shadow: 0 15px 30px rgba(229,62,62,0.5); }
    .ve-featured-img:hover { transform: scale(1.05) rotate(5deg); }
    
    @keyframes ve-spin { 100% { transform: rotate(360deg); } }
    
    @media (max-width: 990px) {
      .ve-featured-grid { grid-template-columns: 1fr; gap: 60px; text-align: center; }
      .ve-featured-grid > div:first-child { order: 2; max-width: 500px; margin: 0 auto; }
      .ve-featured-grid > div:last-child { order: 1; }
      .ve-featured-grid span { margin: 0 auto; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Veda Eats Featured",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CHEF'S SPECIAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Truffle Mushroom Burger"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "ADD TO CART"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Veda Eats Featured"
    }
  ]
}
{% endschema %}
