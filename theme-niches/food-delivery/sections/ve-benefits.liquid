<div style="background:#FFFFFF; padding:100px 24px; position:relative; overflow:hidden;">
  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Poppins', sans-serif; font-size:clamp(36px, 5vw, 48px); font-weight:800; color:#2D3748; margin:0 0 16px 0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="ve-benefits-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:40px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#FFFAF0; padding:40px; border-radius:30px; text-align:center; transition:transform 0.3s ease; border:2px solid transparent;" class="ve-benefit-card">
          
          <div style="width:80px; height:80px; border-radius:50%; background:#FFFFFF; display:flex; align-items:center; justify-content:center; margin:0 auto 24px auto; font-size:40px; box-shadow:0 10px 20px rgba(0,0,0,0.05); color:#E53E3E;">
            {% if forloop.index == 1 %}🥬{% elsif forloop.index == 2 %}♻️{% else %}🎁{% endif %}
          </div>
          
          <h3 style="font-family:'Poppins', sans-serif; font-size:24px; font-weight:700; color:#2D3748; margin:0 0 16px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Poppins', sans-serif; font-size:16px; font-weight:400; color:#718096; line-height:1.6; margin:0;">
            {{ block.settings.desc }}
          </p>
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .ve-benefit-card:hover { transform: translateY(-10px); border-color: #E53E3E; background: #FFFFFF; box-shadow: 0 20px 40px rgba(229,62,62,0.1); }
    
    @media (max-width: 990px) {
      .ve-benefits-grid { grid-template-columns: 1fr; gap: 40px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Veda Eats Benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Veda Eats?"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Farm Fresh"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Sourced from local farms daily."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Veda Eats Benefits",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
