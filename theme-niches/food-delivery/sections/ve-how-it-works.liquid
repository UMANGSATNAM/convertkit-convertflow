<div style="background:#FFFFFF; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto; text-align:center;">
    
    <div style="margin-bottom:80px;">
      <h2 style="font-family:'Poppins', sans-serif; font-size:clamp(36px, 5vw, 48px); font-weight:800; color:#2D3748; margin:0 0 16px 0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="ve-steps-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:40px; position:relative;">
      
      <!-- Connecting Line -->
      <div class="ve-steps-line" style="position:absolute; top:60px; left:15%; right:15%; height:4px; background:rgba(229,62,62,0.2); z-index:1; border-radius:4px; border:2px dashed #E53E3E;"></div>
      
      {%- for block in section.blocks -%}
        <div style="position:relative; z-index:2;">
          <div style="width:120px; height:120px; background:#FFFAF0; border-radius:50%; margin:0 auto 24px auto; display:flex; align-items:center; justify-content:center; font-size:48px; border:4px solid #FFFFFF; box-shadow:0 10px 20px rgba(0,0,0,0.1); position:relative;">
            {% if forloop.index == 1 %}📱{% elsif forloop.index == 2 %}👨‍🍳{% else %}🚴‍♂️{% endif %}
            
            <div style="position:absolute; top:-10px; right:-10px; width:40px; height:40px; background:#E53E3E; color:#FFFFFF; border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:'Poppins', sans-serif; font-weight:800; font-size:18px; border:4px solid #FFFFFF;">
              {{ forloop.index }}
            </div>
          </div>
          
          <h3 style="font-family:'Poppins', sans-serif; font-size:24px; font-weight:700; color:#2D3748; margin:0 0 12px 0;">
            {{ block.settings.title }}
          </h3>
          <p style="font-family:'Poppins', sans-serif; font-size:16px; font-weight:400; color:#718096; margin:0;">
            {{ block.settings.desc }}
          </p>
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    @media (max-width: 990px) {
      .ve-steps-grid { grid-template-columns: 1fr; gap: 60px; }
      .ve-steps-line { display: none; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Veda Eats Steps",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Choose Your Meal"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Browse our curated menus."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Veda Eats Steps",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
