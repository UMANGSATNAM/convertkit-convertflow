<div style="background:#FFF5F5; padding:120px 24px; position:relative; overflow:hidden;">
  <div style="max-width:1440px; margin:0 auto; text-align:center; position:relative; z-index:2;">
    
    <div style="margin-bottom:80px;">
      <h2 style="font-family:'Poppins', sans-serif; font-size:clamp(36px, 5vw, 48px); font-weight:800; color:#2D3748; margin:0 0 16px 0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="ve-reviews-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:30px;">
      
      {%- for block in section.blocks -%}
        <div style="background:#FFFFFF; padding:40px; border-radius:30px; text-align:left; box-shadow:0 10px 30px rgba(0,0,0,0.05); position:relative; transition:transform 0.3s ease;" class="ve-review-card">
          
          <div style="position:absolute; top:-20px; left:40px; width:40px; height:40px; background:#E53E3E; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#FFFFFF; font-family:'Poppins', sans-serif; font-size:24px; font-weight:900; line-height:1;">
            "
          </div>
          
          <div style="display:flex; gap:4px; margin-bottom:24px; margin-top:10px;">
            <span style="color:#F6AD55; font-size:20px;">★</span>
            <span style="color:#F6AD55; font-size:20px;">★</span>
            <span style="color:#F6AD55; font-size:20px;">★</span>
            <span style="color:#F6AD55; font-size:20px;">★</span>
            <span style="color:#F6AD55; font-size:20px;">★</span>
          </div>
          
          <p style="font-family:'Poppins', sans-serif; font-size:16px; font-weight:600; line-height:1.6; color:#2D3748; margin:0 0 32px 0;">
            "{{ block.settings.quote }}"
          </p>
          
          <div style="display:flex; align-items:center; gap:16px;">
            <div style="width:50px; height:50px; background:#FEEBC8; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#DD6B20; font-family:'Poppins', sans-serif; font-weight:800; font-size:20px;">
              {{ block.settings.author | slice: 0, 1 }}
            </div>
            <div>
              <div style="font-family:'Poppins', sans-serif; font-size:16px; font-weight:700; color:#2D3748;">
                {{ block.settings.author }}
              </div>
              <div style="font-family:'Poppins', sans-serif; font-size:12px; font-weight:400; color:#718096;">
                Verified Foodie
              </div>
            </div>
          </div>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .ve-review-card:hover { transform: translateY(-10px); }
    @media (max-width: 990px) {
      .ve-reviews-grid { grid-template-columns: 1fr; gap: 60px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Veda Eats Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Foodies Say"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The fastest delivery I've ever experienced, and the food was piping hot!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Michael B."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Veda Eats Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
