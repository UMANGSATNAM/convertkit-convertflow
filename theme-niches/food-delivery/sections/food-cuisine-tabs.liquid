{% style %}
.cuisine {
  background: #fff;
  padding: 30px 60px;
  border-bottom: 1px solid var(--border);
}
.cuisine-inner {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 4px;
  scrollbar-width: none;
}
.cuisine-inner::-webkit-scrollbar { display: none; }
.c-chip {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 20px;
  border-radius: 100px;
  border: 1.5px solid var(--border);
  background: transparent;
  font-family: 'Poppins', sans-serif;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all .2s;
  white-space: nowrap;
  color: var(--text);
  text-decoration: none;
}
.c-chip:hover, .c-chip.active {
  border-color: var(--orange);
  color: var(--orange);
  background: rgba(255,87,34,.06);
}
.c-chip-icon {
  font-size: 18px;
}

@media(max-width: 768px) {
  .cuisine { padding: 20px; }
}
{% endstyle %}

<div class="cuisine">
  <div class="cuisine-inner">
    <a href="/collections/all" class="c-chip active"><span class="c-chip-icon">🍽️</span>All</a>
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url }}" class="c-chip"><span class="c-chip-icon">{{ block.settings.emoji }}</span>{{ block.settings.title }}</a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Food Cuisine Tabs",
  "settings": [],
  "blocks": [
    {
      "type": "cuisine",
      "name": "Cuisine",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ],
  "presets": [{ "name": "Food Cuisine Tabs" }]
}
{% endschema %}
