{% style %}
.food-trust {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}
.t-item {
  padding: 40px 32px;
  text-align: center;
  border-right: 1px solid var(--border);
}
.t-item:last-child {
  border-right: none;
}
.t-icon {
  font-size: 36px;
  margin-bottom: 12px;
}
.t-num {
  font-size: 28px;
  font-weight: 800;
  color: var(--orange);
  margin-bottom: 4px;
}
.t-label {
  font-size: 12px;
  color: var(--muted);
  font-weight: 500;
}

@media(max-width: 1024px) {
  .food-trust { grid-template-columns: 1fr 1fr; }
}
@media(max-width: 768px) {
  .food-trust { grid-template-columns: 1fr 1fr; }
}
{% endstyle %}

<div class="food-trust">
  {%- for block in section.blocks -%}
    <div class="t-item">
      <div class="t-icon">{{ block.settings.emoji }}</div>
      <div class="t-num">{{ block.settings.val }}</div>
      <div class="t-label">{{ block.settings.label }}</div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Food Trust",
  "settings": [],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji" },
        { "type": "text", "id": "val", "label": "Value" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [{ "name": "Food Trust" }]
}
{% endschema %}
