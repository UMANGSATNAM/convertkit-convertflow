<div style="position:relative; min-height:90vh; display:flex; align-items:center; background:#2C3E2D; overflow:hidden;">
  
  <!-- Immersive Background Image -->
  <div style="position:absolute; inset:0; z-index:1;">
    <img src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=2000&q=80" alt="Landscape" style="width:100%; height:100%; object-fit:cover; opacity:0.6; mix-blend-mode:luminosity;" loading="eager">
    <!-- Gradient overlay for text readability -->
    <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(44,62,45,0.9) 0%, rgba(44,62,45,0.4) 50%, rgba(44,62,45,0.1) 100%);"></div>
  </div>

  <!-- Topographic pattern overlay -->
  <div style="position:absolute; inset:0; background-image:url('data:image/svg+xml;utf8,<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M0 50 Q 25 25, 50 50 T 100 50\" stroke=\"rgba(255,255,255,0.1)\" fill=\"none\" stroke-width=\"0.5\"/></svg>'); background-size:200px 200px; opacity:0.5; z-index:2;"></div>

  <div style="max-width:1440px; margin:0 auto; padding:120px 40px; width:100%; position:relative; z-index:3;">
    
    <div style="max-width:720px;">
      
      <div style="display:inline-flex; align-items:center; gap:12px; background:rgba(217,106,66,0.9); color:#FFFFFF; padding:8px 16px; border-radius:4px; font-family:'DM Sans', sans-serif; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:2px; margin-bottom:32px; backdrop-filter:blur(4px);">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        New Arrival: The Alpine Series
      </div>

      <h1 style="font-family:'Oswald', sans-serif; font-size:clamp(60px, 8vw, 100px); font-weight:700; color:#FFFFFF; line-height:1; margin:0 0 24px 0; text-transform:uppercase; letter-spacing:-1px; text-shadow:0 4px 20px rgba(0,0,0,0.3);">
        {{ section.settings.heading }}
      </h1>
      
      <p style="font-family:'DM Sans', sans-serif; font-size:clamp(18px, 2vw, 22px); font-weight:400; color:#F5F7F2; line-height:1.6; margin:0 0 48px 0; max-width:540px; text-shadow:0 2px 10px rgba(0,0,0,0.5);">
        {{ section.settings.subheading }}
      </p>
      
      {%- if section.settings.cta_label != blank -%}
        <div style="display:flex; gap:20px; flex-wrap:wrap;">
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#D96A42; color:#FFFFFF; font-family:'DM Sans', sans-serif; font-size:14px; font-weight:700; text-transform:uppercase; letter-spacing:2px; padding:20px 48px; border-radius:4px; text-decoration:none; transition:all 0.3s ease; border:2px solid #D96A42;" class="et-btn-primary">
            {{ section.settings.cta_label }}
          </a>
          <a href="#impact" style="display:inline-flex; align-items:center; justify-content:center; background:transparent; color:#FFFFFF; font-family:'DM Sans', sans-serif; font-size:14px; font-weight:700; text-transform:uppercase; letter-spacing:2px; padding:20px 48px; border-radius:4px; text-decoration:none; transition:all 0.3s ease; border:2px solid #FFFFFF;" class="et-btn-secondary">
            OUR IMPACT
          </a>
        </div>
      {%- endif -%}

    </div>
    
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Oswald:wght@400;500;700&display=swap');
    
    .et-btn-primary:hover { background: #FFFFFF; color: #D96A42; border-color: #FFFFFF; }
    .et-btn-secondary:hover { background: #FFFFFF; color: #2C3E2D; }
    
    @media (max-width: 768px) {
      div[style*="max-width:720px"] { text-align: center; margin: 0 auto; }
      div[style*="display:flex; gap:20px; flex-wrap:wrap"] { justify-content: center; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Eco Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Responsibly."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Sustainable travel gear designed for the modern adventurer. Leave nothing but footprints."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP GEAR"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Eco Hero"
    }
  ]
}
{% endschema %}
