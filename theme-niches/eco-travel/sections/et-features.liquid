<div style="background:#F5F7F2; padding:120px 24px; border-bottom:1px solid #D9D9D9;">
  
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:80px; flex-wrap:wrap; gap:24px;">
      <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(40px, 5vw, 64px); font-weight:700; color:#2C3E2D; margin:0; text-transform:uppercase; max-width:600px; line-height:1.1;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-family:'DM Sans', sans-serif; font-size:18px; color:#5A6B5B; max-width:400px; margin:0; line-height:1.6;">
        Every detail is engineered for performance, durability, and minimal environmental impact.
      </p>
    </div>

    <div class="et-feat-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:40px;">
      
      {%- for block in section.blocks -%}
        <div style="padding:48px 32px; background:#FFFFFF; border-left:4px solid #D96A42; position:relative; overflow:hidden; transition:transform 0.3s ease; box-shadow:0 10px 30px rgba(0,0,0,0.03);" class="et-feat-card">
          
          <!-- Topographic bg element -->
          <div style="position:absolute; top:-50px; right:-50px; width:150px; height:150px; background-image:url('data:image/svg+xml;utf8,<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M0 50 Q 25 25, 50 50 T 100 50\" stroke=\"rgba(44,62,45,0.05)\" fill=\"none\" stroke-width=\"1\"/></svg>'); background-size:50px 50px; opacity:0.5; z-index:1; border-radius:50%; transition:all 0.5s ease;" class="et-feat-bg"></div>
          
          <div style="position:relative; z-index:2;">
            <div style="margin-bottom:24px; color:#2C3E2D;">
              {% if forloop.index == 1 %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
              {% elsif forloop.index == 2 %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              {% else %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {% endif %}
            </div>
            
            <h3 style="font-family:'Oswald', sans-serif; font-size:24px; font-weight:500; color:#2C3E2D; margin:0 0 16px 0; text-transform:uppercase; letter-spacing:1px;">
              {{ block.settings.title }}
            </h3>
            
            <p style="font-family:'DM Sans', sans-serif; font-size:16px; color:#5A6B5B; margin:0; line-height:1.6;">
              {{ block.settings.desc }}
            </p>
          </div>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .et-feat-card:hover { transform: translateY(-8px); }
    .et-feat-card:hover .et-feat-bg { transform: scale(1.5); }
    
    @media (max-width: 990px) {
      .et-feat-grid { grid-template-columns: 1fr; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Eco Features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for the Journey"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Recycled Materials"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Made from ocean-bound plastics."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Eco Features",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
