<div style="background:#F5F7F2; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:80px; flex-wrap:wrap; gap:24px;">
      <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(40px, 5vw, 64px); font-weight:700; color:#2C3E2D; margin:0; text-transform:uppercase;">
        {{ section.settings.heading }}
      </h2>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'DM Sans', sans-serif; font-size:14px; font-weight:700; color:#2C3E2D; text-decoration:none; text-transform:uppercase; letter-spacing:2px; display:inline-flex; align-items:center; gap:8px; padding-bottom:4px; border-bottom:2px solid #D96A42; transition:all 0.3s ease;" class="et-link-btn">
          {{ section.settings.cta_label }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="et-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:40px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1553531384-cc64ac80f931?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1542223616-9404625eb94e?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1502224562085-6dfe2f2e4c42?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1546554137-f86b9593a222?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1553531384-cc64ac80f931?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="et-product-card" style="position:relative; display:flex; flex-direction:column; background:#FFFFFF; border:1px solid #D9D9D9; transition:all 0.3s ease; group">
          
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:120%; background:#EAEAEA;">
            <img src="{{ img_url }}" alt="Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease;" class="et-product-img" loading="lazy">
            
            {% if idx == 1 or idx == 3 %}
              <div style="position:absolute; top:16px; left:16px; background:#2C3E2D; color:#FFFFFF; font-family:'DM Sans', sans-serif; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; padding:6px 12px; border-radius:2px;">
                {% if idx == 1 %}Recycled{% else %}Core{% endif %}
              </div>
            {% endif %}
            
            <div style="position:absolute; bottom:0; left:0; right:0; background:rgba(255,255,255,0.9); backdrop-filter:blur(4px); padding:16px; transform:translateY(100%); transition:transform 0.3s ease; display:flex; justify-content:center;" class="et-quick-add">
              <button style="background:#D96A42; color:#FFFFFF; border:none; width:100%; font-family:'DM Sans', sans-serif; font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:1px; padding:12px 0; border-radius:4px; cursor:pointer; transition:background 0.2s ease;">
                QUICK ADD
              </button>
            </div>
          </a>
          
          <div style="padding:24px;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
              <h3 style="font-family:'Oswald', sans-serif; font-size:20px; font-weight:500; color:#2C3E2D; margin:0; text-transform:uppercase;">
                {% if idx == 1 %}The Explorer Backpack{% elsif idx == 2 %}Camp Mug 12oz{% elsif idx == 3 %}Merino Base Layer{% else %}Trail Hat{% endif %}
              </h3>
              <div style="font-family:'DM Sans', sans-serif; font-size:16px; font-weight:700; color:#D96A42; margin-left:12px;">
                {% if idx == 1 %}$145{% elsif idx == 2 %}$24{% elsif idx == 3 %}$85{% else %}$35{% endif %}
              </div>
            </div>
            
            <div style="font-family:'DM Sans', sans-serif; font-size:14px; font-weight:400; color:#5A6B5B;">
              {% if idx == 1 %}2 Colors{% elsif idx == 2 %}1 Color{% elsif idx == 3 %}3 Colors{% else %}4 Colors{% endif %}
            </div>
          </div>
          
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .et-link-btn:hover { color: #D96A42; padding-right: 10px; }
    .et-product-card:hover { border-color: #2C3E2D; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    .et-product-card:hover .et-product-img { transform: scale(1.05); }
    .et-product-card:hover .et-quick-add { transform: translateY(0); }
    
    @media (max-width: 1024px) {
      .et-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px !important; }
    }
    @media (max-width: 640px) {
      .et-product-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Eco Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Essential Gear"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Eco Collection"
    }
  ]
}
{% endschema %}
