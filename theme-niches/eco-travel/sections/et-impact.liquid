<div style="background:#2C3E2D; padding:120px 24px; color:#FFFFFF; position:relative; overflow:hidden;">
  
  <!-- Topographic bg -->
  <div style="position:absolute; inset:0; background-image:url('data:image/svg+xml;utf8,<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M0 50 Q 25 25, 50 50 T 100 50\" stroke=\"rgba(255,255,255,0.05)\" fill=\"none\" stroke-width=\"0.5\"/></svg>'); background-size:200px 200px; z-index:1;"></div>

  <div style="max-width:1440px; margin:0 auto; position:relative; z-index:2; display:flex; flex-wrap:wrap; gap:80px; align-items:center;">
    
    <div style="flex:1; min-width:300px;">
      <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(40px, 6vw, 72px); font-weight:700; color:#FFFFFF; margin:0 0 24px 0; text-transform:uppercase; line-height:1.1;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-family:'DM Sans', sans-serif; font-size:20px; color:#F5F7F2; margin:0 0 40px 0; line-height:1.6; max-width:400px; opacity:0.9;">
        {{ section.settings.subheading }}
      </p>
      
      <a href="/pages/impact" style="display:inline-flex; align-items:center; gap:8px; font-family:'DM Sans', sans-serif; font-size:14px; font-weight:700; color:#D96A42; text-decoration:none; text-transform:uppercase; letter-spacing:2px; border-bottom:2px solid #D96A42; padding-bottom:4px; transition:all 0.3s ease;" class="et-impact-link">
        READ OUR REPORT
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div style="flex:1.5; min-width:300px; display:grid; grid-template-columns:repeat(2, 1fr); gap:40px;">
      
      <div style="border-top:2px solid rgba(255,255,255,0.2); padding-top:24px;">
        <div style="font-family:'Oswald', sans-serif; font-size:56px; font-weight:700; color:#D96A42; margin-bottom:8px; line-height:1;">1.2M</div>
        <div style="font-family:'DM Sans', sans-serif; font-size:16px; font-weight:700; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Bottles Recycled</div>
        <div style="font-family:'DM Sans', sans-serif; font-size:14px; color:#F5F7F2; opacity:0.8; line-height:1.5;">Diverted from oceans and landfills into our gear.</div>
      </div>
      
      <div style="border-top:2px solid rgba(255,255,255,0.2); padding-top:24px;">
        <div style="font-family:'Oswald', sans-serif; font-size:56px; font-weight:700; color:#D96A42; margin-bottom:8px; line-height:1;">100%</div>
        <div style="font-family:'DM Sans', sans-serif; font-size:16px; font-weight:700; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Carbon Neutral</div>
        <div style="font-family:'DM Sans', sans-serif; font-size:14px; color:#F5F7F2; opacity:0.8; line-height:1.5;">Since day one, across our entire supply chain.</div>
      </div>
      
      <div style="border-top:2px solid rgba(255,255,255,0.2); padding-top:24px;">
        <div style="font-family:'Oswald', sans-serif; font-size:56px; font-weight:700; color:#D96A42; margin-bottom:8px; line-height:1;">50K</div>
        <div style="font-family:'DM Sans', sans-serif; font-size:16px; font-weight:700; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Trees Planted</div>
        <div style="font-family:'DM Sans', sans-serif; font-size:14px; color:#F5F7F2; opacity:0.8; line-height:1.5;">Restoring vital ecosystems worldwide.</div>
      </div>
      
      <div style="border-top:2px solid rgba(255,255,255,0.2); padding-top:24px;">
        <div style="font-family:'Oswald', sans-serif; font-size:56px; font-weight:700; color:#D96A42; margin-bottom:8px; line-height:1;">B-Corp</div>
        <div style="font-family:'DM Sans', sans-serif; font-size:16px; font-weight:700; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Certified</div>
        <div style="font-family:'DM Sans', sans-serif; font-size:14px; color:#F5F7F2; opacity:0.8; line-height:1.5;">Meeting the highest standards of verified performance.</div>
      </div>

    </div>
    
  </div>

  <style>
    .et-impact-link:hover { padding-right: 10px; color: #FFFFFF; border-color: #FFFFFF; }
    
    @media (max-width: 768px) {
      div[style*="display:grid; grid-template-columns:repeat(2, 1fr)"] { grid-template-columns: 1fr; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Eco Impact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Impact"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Transparency in every step of our supply chain."
    }
  ],
  "presets": [
    {
      "name": "Eco Impact"
    }
  ]
}
{% endschema %}
