<div style="padding:60px 20px 0;background:#0A0A0A"><div style="max-width:1320px;margin:0 auto;text-align:left;padding-bottom:56px;border-bottom:1px solid var(--mh-border)"><span class="mh-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</span><h1 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(32px,5vw,52px);font-weight:800;color:var(--mh-white);margin-bottom:12px;letter-spacing:-0.03em;text-transform:uppercase">{{ collection.title }}</h1>{%- if collection.description != blank -%}<p style="font-family:'Space Grotesk',sans-serif;font-size:15px;color:var(--mh-muted);max-width:560px;font-weight:500">{{ collection.description }}</p>{%- endif -%}</div></div>
<div style="padding:0 20px 100px;background:#0A0A0A"><div style="max-width:1320px;margin:0 auto"><div style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid var(--mh-border);margin-bottom:40px"><div style="font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:800;color:var(--mh-white);text-transform:uppercase">{{ collection.products_count }} shells</div><select style="padding:10px 20px;border:1px solid var(--mh-border);border-radius:4px;background:#121212;color:var(--mh-white);font-family:'Space Grotesk',sans-serif;font-size:12px;font-weight:800;cursor:pointer"><option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Newest</option></select></div><div class="mh-prod-grid">{%- for product in collection.products -%}<a href="{{ product.url }}" class="mh-prod-card"><div class="mh-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:#1A1A1A"></div>{%- endif -%}</div><div class="mh-prod-card__name">{{ product.title }}</div><div class="mh-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div></div></div>
{% schema %}
{"name":"Helmets Collection","settings":[],"presets":[{"name":"Helmets Collection"}]}
{% endschema %}
