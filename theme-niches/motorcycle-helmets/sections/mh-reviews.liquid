<div style="padding:80px 20px;background:#121212"><div style="max-width:1320px;margin:0 auto">
  <div class="mh-section-header"><span class="mh-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="mh-review-grid">{%- for block in section.blocks -%}<div class="mh-review-card" {{ block.shopify_attributes }}><div class="mh-review-card__stars">★★★★★</div><div class="mh-review-card__text">"{{ block.settings.quote }}"</div><div class="mh-review-card__author">{{ block.settings.name }}</div><div class="mh-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Helmets Reviews","settings":[{"type":"text","id":"eyebrow","label":"RIDER COMMENTS"},{"type":"text","id":"heading","label":"Heading","default":"Rider Reviews"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Helmets Reviews","blocks":[{"type":"review","settings":{"quote":"Astonishingly light. The carbon weave is flawless and optical class 1 visor has zero distortion.","name":"Brad F.","product":"Apex Carbon GP Helmet"}},{"type":"review","settings":{"quote":"Excellent ventilation on hot summer track sessions. High-speed stability is incredible.","name":"Darin M.","product":"GP-1 Carbon Race Helmet"}},{"type":"review","settings":{"quote":"Fit is snug and quiet. Cardo communicator integration was a breeze. Best tourer I owned.","name":"Steve S.","product":"Modular Carbon Pro"}}]}]}
{% endschema %}
