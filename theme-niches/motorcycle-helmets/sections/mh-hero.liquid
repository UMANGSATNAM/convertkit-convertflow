<div class="mh-hero">
  <div class="mh-hero__content">
    <span class="mh-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="mh-hero__title">{{ section.settings.heading }}</h1>
    <p class="mh-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="mh-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="mh-btn mh-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="mh-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--mh-lime)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Helmets Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CARBON TECHNOLOGY"},{"type":"text","id":"heading","label":"Pre-Preg Carbon Fiber Protection"},{"type":"textarea","id":"subheading","label":"Subheading","default":"ECE 22.06 certified aerodynamic track helmets constructed from pre-impregnated aerospace carbon fiber."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"EXPLORE HELMETS"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"AERO DETAILS"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Helmets Hero"}]}
{% endschema %}
