<div style="padding:80px 20px;background:#0A0A0A;border-bottom:1px solid var(--mh-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="mh-section-header"><span class="mh-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="mh-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="mh-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--mh-lime)"></div>{%- endif -%}<div class="mh-col-card__overlay"><span class="mh-col-card__title">{{ block.settings.title }}</span><span class="mh-col-card__cta">Explore Helmets →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Helmets Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ASPHALT SELECTION"},{"type":"text","id":"heading","label":"Heading","default":"Helmets by Type"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Track Carbon"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Helmets Collections","blocks":[{"type":"col","settings":{"title":"Track Carbon Series"}},{"type":"col","settings":{"title":"Modular Touring Helmets"}},{"type":"col","settings":{"title":"Adventure Dual-Sport"}}]}]}
{% endschema %}
