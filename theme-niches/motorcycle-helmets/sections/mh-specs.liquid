<div style="padding:80px 20px;background:#0A0A0A"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="mh-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(28px,4vw,48px);font-weight:800;color:var(--mh-white);margin-bottom:20px;line-height:1.1;letter-spacing:-0.02em;text-transform:uppercase">{{ section.settings.heading }}</h2>
    <p style="font-family:'Space Grotesk',sans-serif;font-size:16px;color:var(--mh-muted);line-height:1.6;max-width:440px;font-weight:500">{{ section.settings.body }}</p>
    <div class="mh-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="mh-stat" style="border-color:rgba(57,255,20,0.15);background:rgba(255,255,255,0.01)" {{ block.shopify_attributes }}><div class="mh-stat__num" style="color:var(--mh-lime)">{{ block.settings.number }}</div><div class="mh-stat__label" style="color:var(--mh-muted)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:4px;border:1px solid var(--mh-border);object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:1;background:var(--mh-border)"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Helmets Specs","settings":[{"type":"text","id":"eyebrow","label":"AERO TESTING"},{"type":"text","id":"heading","label":"Heading","default":"Tunnel Tested Speed."},{"type":"textarea","id":"body","label":"Body","default":"Developed in specialized wind tunnels to optimize laminar flow, minimizing neck fatigue and helmet drag at track speeds."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"0.28"},{"type":"text","id":"label","label":"Label","default":"Drag Coeff"}]}],"presets":[{"name":"Helmets Specs","blocks":[{"type":"stat","settings":{"number":"0.28","label":"Drag Coeff"}},{"type":"stat","settings":{"number":"ECE 22.06","label":"Homologation"}},{"type":"stat","settings":{"number":"1280g","label":"Shell Weight"}},{"type":"stat","settings":{"number":"50% Glass","label":"Carbon Weave"}}]}]}
{% endschema %}
