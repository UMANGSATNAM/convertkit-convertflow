<div style="background:#FFFFFF; padding:120px 24px; border-top:1px solid #EEEEEE;">
  <div style="max-width:1400px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:80px; flex-wrap:wrap; gap:24px;">
      <div>
        <h2 style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:clamp(36px, 4vw, 48px); font-weight:300; letter-spacing:-1px; color:#333333; margin:0 0 16px 0;">
          {{ section.settings.heading }}
        </h2>
        <p style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:16px; color:#666666; margin:0; max-width:400px;">
          Build your foundation for healthy skin with our clinically proven essentials.
        </p>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:12px; font-weight:500; text-transform:uppercase; letter-spacing:2px; color:#333333; text-decoration:none; border-bottom:1px solid #333333; padding-bottom:4px; transition:color 0.3s ease;" class="ps-link-btn">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="ps-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:40px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1556228578-0d85b1a4d571?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1599305090598-fe179d501227?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="ps-product-card" style="display:flex; flex-direction:column; text-decoration:none; position:relative;">
          
          <div style="background:#FAFAFA; aspect-ratio:4/5; display:flex; align-items:center; justify-content:center; padding:40px; margin-bottom:24px; position:relative; overflow:hidden;">
            <img src="{{ img_url }}" alt="Product" style="width:100%; height:100%; object-fit:contain; transition:transform 0.5s ease; mix-blend-mode:darken;" class="ps-product-img" loading="lazy">
            
            <!-- Quick Add Overlay -->
            <div style="position:absolute; bottom:20px; left:20px; right:20px; opacity:0; transform:translateY(10px); transition:all 0.3s ease;" class="ps-quick-add">
              <button style="width:100%; background:#333333; color:#FAFAFA; border:none; padding:16px; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:12px; font-weight:500; text-transform:uppercase; letter-spacing:2px; cursor:pointer;">Add to Bag - $48</button>
            </div>
          </div>
          
          <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
            <h3 style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:16px; font-weight:400; color:#333333; margin:0;">
              {% if idx == 1 %}Gentle Cleanser{% elsif idx == 2 %}Daily Hydrator{% elsif idx == 3 %}Exfoliating Toner{% else %}Vitamin C Serum{% endif %}
            </h3>
            <div style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:16px; font-weight:400; color:#333333;">
              $48
            </div>
          </div>
          
          <div style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:14px; color:#8C8C8C;">
            {% if idx == 1 %}Step 1: Cleanse{% elsif idx == 2 %}Step 3: Moisturize{% elsif idx == 3 %}Step 2: Treat{% else %}Targeted Treatment{% endif %}
          </div>
          
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .ps-product-card:hover .ps-product-img { transform: scale(1.05); }
    .ps-product-card:hover .ps-quick-add { opacity: 1; transform: translateY(0); }
    .ps-link-btn:hover { color: #8C8C8C; border-color: #8C8C8C; }
    
    @media (max-width: 1024px) {
      .ps-product-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
    @media (max-width: 640px) {
      .ps-product-grid { grid-template-columns: 1fr !important; }
      .ps-quick-add { opacity: 1 !important; transform: translateY(0) !important; position: static !important; margin-top: 16px; }
      div[style*="background:#FAFAFA; aspect-ratio:4/5;"] { padding: 20px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Skincare Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Core Regimen"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Skincare Collection"
    }
  ]
}
{% endschema %}
