<div style="background:#FAFAFA; color:#333333; min-height:90vh; display:flex; align-items:center; position:relative; overflow:hidden;">
  
  <div style="max-width:1400px; margin:0 auto; width:100%; display:grid; grid-template-columns:1fr 1fr; gap:60px; padding:80px 24px; position:relative; z-index:2;">
    
    <!-- Content -->
    <div style="display:flex; flex-direction:column; justify-content:center; padding-right:40px;">
      
      <div style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:11px; font-weight:500; text-transform:uppercase; letter-spacing:3px; color:#8C8C8C; margin-bottom:32px; display:inline-flex; align-items:center; gap:16px;">
        Clinical Formulation <span style="width:40px; height:1px; background:#D1DAC5;"></span>
      </div>
      
      <h1 style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:clamp(48px, 6vw, 72px); font-weight:300; letter-spacing:-1px; margin:0 0 32px 0; line-height:1.1;">
        {{ section.settings.heading }}
      </h1>
      
      <p style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:18px; font-weight:400; color:#666666; line-height:1.7; margin:0 0 48px 0; max-width:440px;">
        {{ section.settings.subheading }}
      </p>
      
      {%- if section.settings.cta_label != blank -%}
        <div style="display:flex; gap:24px; align-items:center;">
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#333333; color:#FAFAFA; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:12px; font-weight:500; text-transform:uppercase; letter-spacing:2px; padding:16px 36px; text-decoration:none; transition:all 0.3s ease;" class="ps-btn-primary">
            {{ section.settings.cta_label }}
          </a>
          <a href="#ingredients" style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:12px; font-weight:500; text-transform:uppercase; letter-spacing:2px; color:#333333; text-decoration:none; border-bottom:1px solid #333333; padding-bottom:4px; transition:color 0.3s ease;" class="ps-btn-secondary">
            Our Ingredients
          </a>
        </div>
      {%- endif -%}
      
    </div>

    <!-- Image -->
    <div style="position:relative; height:100%; min-height:600px; display:flex; justify-content:center; align-items:center;">
      
      <!-- Abstract soft shape behind image -->
      <div style="position:absolute; width:80%; height:90%; background:#E8D5CC; border-radius:50% 50% 0 0; bottom:0; z-index:1; opacity:0.6;"></div>
      
      <div style="position:relative; z-index:2; width:85%; height:90%; overflow:hidden;">
        <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=800&q=80" alt="Skincare Serum" style="width:100%; height:100%; object-fit:cover; transition:transform 0.8s ease;" class="ps-hero-img" loading="eager">
      </div>
      
    </div>
    
  </div>

  <style>
    .ps-btn-primary:hover { background: #555555; }
    .ps-btn-secondary:hover { color: #8C8C8C; border-color: #8C8C8C; }
    .ps-hero-img:hover { transform: scale(1.03); }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; gap: 60px; text-align: center; }
      div[style*="padding-right:40px"] { padding-right: 0; align-items: center; }
      div[style*="margin:0 0 48px 0; max-width:440px"] { margin-left: auto; margin-right: auto; }
      div[style*="display:flex; gap:24px; align-items:center"] { justify-content: center; flex-wrap: wrap; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Skincare Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Science meets skin."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Formulated with active ingredients at clinical concentrations for visible, lasting results."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP ROUTINES"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Skincare Hero"
    }
  ]
}
{% endschema %}
