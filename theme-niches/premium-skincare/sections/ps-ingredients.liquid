<div style="background:#FFFFFF; color:#333333; padding:120px 24px; border-top:1px solid #EEEEEE;">
  
  <div style="max-width:1200px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <div style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:11px; font-weight:500; text-transform:uppercase; letter-spacing:3px; color:#8C8C8C; margin-bottom:16px;">
        Transparent Formulation
      </div>
      <h2 style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:clamp(36px, 5vw, 48px); font-weight:300; letter-spacing:-1px; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:18px; color:#666666; margin:0 auto; max-width:500px; line-height:1.6;">
        {{ section.settings.subheading }}
      </p>
    </div>

    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:40px;">
      
      <!-- Ingredient 1 -->
      <div style="text-align:center; padding:40px; background:#FAFAFA; transition:background 0.3s ease;" class="ps-ing-card">
        <div style="width:80px; height:80px; background:#E8D5CC; border-radius:50%; margin:0 auto 24px auto; display:flex; align-items:center; justify-content:center; color:#333333; font-size:24px;">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <h3 style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:20px; font-weight:400; margin:0 0 12px 0;">Niacinamide 10%</h3>
        <p style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:15px; color:#666666; line-height:1.6; margin:0;">
          Vitamin B3 visibly minimizes enlarged pores, tightens lax pores, and improves uneven skin tone.
        </p>
      </div>

      <!-- Ingredient 2 -->
      <div style="text-align:center; padding:40px; background:#FAFAFA; transition:background 0.3s ease;" class="ps-ing-card">
        <div style="width:80px; height:80px; background:#D1DAC5; border-radius:50%; margin:0 auto 24px auto; display:flex; align-items:center; justify-content:center; color:#333333; font-size:24px;">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        </div>
        <h3 style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:20px; font-weight:400; margin:0 0 12px 0;">Hyaluronic Acid 2%</h3>
        <p style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:15px; color:#666666; line-height:1.6; margin:0;">
          Multi-molecular weight HA delivers hydration to multiple layers of the skin, plumping and smoothing.
        </p>
      </div>

      <!-- Ingredient 3 -->
      <div style="text-align:center; padding:40px; background:#FAFAFA; transition:background 0.3s ease;" class="ps-ing-card">
        <div style="width:80px; height:80px; background:#E5E5E5; border-radius:50%; margin:0 auto 24px auto; display:flex; align-items:center; justify-content:center; color:#333333; font-size:24px;">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/></svg>
        </div>
        <h3 style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:20px; font-weight:400; margin:0 0 12px 0;">Squalane</h3>
        <p style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:15px; color:#666666; line-height:1.6; margin:0;">
          Plant-derived emollient that prevents moisture loss and restores skin's suppleness without clogging pores.
        </p>
      </div>

    </div>

  </div>

  <style>
    .ps-ing-card:hover { background: #F0F0F0; }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:repeat(3, 1fr)"] { grid-template-columns: 1fr; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Skincare Ingredients",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clinical Efficacy"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We use only what skin needs. No fillers, no compromises."
    }
  ],
  "presets": [
    {
      "name": "Skincare Ingredients"
    }
  ]
}
{% endschema %}
