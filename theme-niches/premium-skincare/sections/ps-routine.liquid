<div style="background:#E8D5CC; color:#333333; padding:120px 24px;">
  
  <div style="max-width:1400px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
    
    <!-- Image -->
    <div style="position:relative; height:100%; min-height:600px;">
      <div style="position:absolute; inset:0; padding-right:10%; padding-bottom:10%;">
        <img src="https://images.unsplash.com/photo-1556228578-0d85b1a4d571?auto=format&fit=crop&w=800&q=80" alt="Routine" style="width:100%; height:100%; object-fit:cover; mix-blend-mode:multiply; filter:contrast(1.1);" loading="lazy">
      </div>
      <!-- Decorative circle -->
      <div style="position:absolute; bottom:0; right:0; width:40%; aspect-ratio:1/1; background:#FAFAFA; border-radius:50%; display:flex; align-items:center; justify-content:center; padding:32px; text-align:center;">
        <p style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:14px; color:#666666; line-height:1.6; margin:0;">
          "Consistency is the foundation of transformation."
        </p>
      </div>
    </div>

    <!-- Content -->
    <div style="padding-left:40px;">
      
      <div style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:11px; font-weight:500; text-transform:uppercase; letter-spacing:3px; color:#8C8C8C; margin-bottom:24px;">
        Daily Ritual
      </div>
      
      <h2 style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:clamp(36px, 5vw, 56px); font-weight:300; letter-spacing:-1px; margin:0 0 48px 0; line-height:1.1;">
        {{ section.settings.heading }}
      </h2>
      
      <div style="display:flex; flex-direction:column; gap:40px;">
        
        <!-- Step 1 -->
        <div style="display:flex; gap:32px;">
          <div style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:24px; font-weight:300; color:#8C8C8C; padding-top:4px;">01</div>
          <div>
            <h3 style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:20px; font-weight:400; margin:0 0 12px 0;">Cleanse</h3>
            <p style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:16px; color:#666666; line-height:1.6; margin:0;">
              Remove impurities without stripping the skin barrier. Use lukewarm water and massage gently for 60 seconds.
            </p>
          </div>
        </div>
        
        <!-- Step 2 -->
        <div style="display:flex; gap:32px;">
          <div style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:24px; font-weight:300; color:#8C8C8C; padding-top:4px;">02</div>
          <div>
            <h3 style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:20px; font-weight:400; margin:0 0 12px 0;">Treat</h3>
            <p style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:16px; color:#666666; line-height:1.6; margin:0;">
              Apply serums to dry skin. Pat gently until fully absorbed to deliver active ingredients deep into the epidermis.
            </p>
          </div>
        </div>
        
        <!-- Step 3 -->
        <div style="display:flex; gap:32px;">
          <div style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:24px; font-weight:300; color:#8C8C8C; padding-top:4px;">03</div>
          <div>
            <h3 style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:20px; font-weight:400; margin:0 0 12px 0;">Moisturize & Protect</h3>
            <p style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:16px; color:#666666; line-height:1.6; margin:0;">
              Lock in hydration and shield from environmental stressors. Never skip SPF during the day.
            </p>
          </div>
        </div>
        
      </div>
      
    </div>
    
  </div>

  <style>
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; gap: 60px; }
      div[style*="padding-left:40px"] { padding-left: 0; }
      div[style*="min-height:600px"] { min-height: 400px; }
      div[style*="bottom:0; right:0; width:40%;"] { width: 50%; padding: 20px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Skincare Routine",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Daily Ritual"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Consistency is the key to transformation."
    }
  ],
  "presets": [
    {
      "name": "Skincare Routine"
    }
  ]
}
{% endschema %}
