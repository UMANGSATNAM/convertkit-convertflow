<div style="background:var(--gc-bg);padding:100px 60px;border-top:1px solid var(--gc-border)">
  <div style="max-width:1400px;margin:0 auto">
    
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:60px">
      <div>
        <div style="color:var(--gc-accent);font-family:var(--font-h);font-size:14px;letter-spacing:0.2em;margin-bottom:8px">// HARDWARE //</div>
        <h2 class="gc-head" style="font-size:48px">{{ collection.title | default: 'Arsenal' }}</h2>
      </div>
      <div style="font-family:var(--font-h);color:var(--gc-muted);font-size:14px">
        [ {{ collection.products_count | default: '14' }} ITEMS FOUND ]
      </div>
    </div>
    
    <div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:24px">
      {%- for product in collection.products limit: 12 -%}
      <a href="{{ product.url }}" class="gc-card">
        <div class="image-wrapper">
          <div class="gc-badge">PRO</div>
          {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- else -%}
          <div style="width:100%;height:100%;background:#111"></div>
          {%- endif -%}
        </div>
        <div class="title">{{ product.title }}</div>
        <div class="price">{{ product.price | money }}</div>
      </a>
      {%- else -%}
      <!-- Demo State -->
      {%- for i in (1..8) -%}
      <a href="#" class="gc-card">
        <div class="image-wrapper">
          <div class="gc-badge">PRO</div>
          <div style="width:100%;height:100%;background:#111"></div>
        </div>
        <div class="title">Quantum Controller V{{i}}</div>
        <div class="price">₹6,990</div>
      </a>
      {%- endfor -%}
      {%- endfor -%}
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Gaming Esports Grid",
  "settings": [],
  "presets": [
    {
      "name": "Gaming Esports Grid"
    }
  ]
}
{% endschema %}
