<div style="background:var(--gc-bg);min-height:90vh;display:flex;align-items:center;padding:80px 60px;position:relative;overflow:hidden">
  
  <!-- Neon Backlight -->
  <div style="position:absolute;top:50%;left:50%;transform:translate(-50%, -50%);width:600px;height:600px;background:radial-gradient(circle, rgba(0,255,0,0.15) 0%, transparent 70%);z-index:0"></div>

  <div style="max-width:1400px;margin:0 auto;width:100%;position:relative;z-index:2;text-align:center">
    
    <div style="display:inline-block;border:1px solid var(--gc-accent);color:var(--gc-accent);padding:8px 16px;font-family:var(--font-h);font-size:12px;letter-spacing:0.2em;margin-bottom:32px;box-shadow:0 0 10px rgba(0,255,0,0.2)">
      {{ section.settings.overline | default: 'SYSTEM UPDATE AVAILABLE' }}
    </div>
    
    <h1 class="gc-head" style="font-size:clamp(60px, 8vw, 120px);margin-bottom:24px;line-height:1;text-shadow:0 0 20px rgba(0,255,0,0.3)">
      {{ section.settings.heading | default: 'POWER<br>UNLEASHED.' }}
    </h1>
    
    <p style="font-size:20px;color:var(--gc-muted);max-width:600px;margin:0 auto 48px auto">
      {{ section.settings.text | default: 'Experience true 4K gaming at 120FPS. The next generation of console architecture is here.' }}
    </p>
    
    <div style="display:flex;gap:24px;justify-content:center">
      <a href="{{ section.settings.btn1_url | default: '/collections/consoles' }}" class="gc-btn">{{ section.settings.btn1_text | default: 'PRE-ORDER NOW' }}</a>
    </div>
    
    <div style="margin-top:80px;position:relative;width:100%;max-width:800px;margin-left:auto;margin-right:auto">
      <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/gaming-hero.png?v=1717283400" alt="Console" style="width:100%;height:auto;filter:drop-shadow(0 0 40px rgba(0,255,0,0.2))">
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Gaming Esports Hero",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline Text",
      "default": "SYSTEM UPDATE AVAILABLE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "POWER<br>UNLEASHED."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Experience true 4K gaming at 120FPS."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button Text",
      "default": "PRE-ORDER NOW"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Gaming Esports Hero"
    }
  ]
}
{% endschema %}
