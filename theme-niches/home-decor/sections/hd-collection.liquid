<div style="background:var(--hd-bg);padding:120px 60px">
  <div style="max-width:1400px;margin:0 auto">
    
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:80px">
      <h2 class="hd-head" style="font-size:48px;max-width:400px">{{ collection.title | default: 'Signature Pieces' }}</h2>
      <a href="/collections/all" class="hd-btn" style="background:transparent;color:var(--hd-text);border:none;border-bottom:1px solid var(--hd-text);padding:8px 0">View All</a>
    </div>
    
    <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:60px">
      {%- for product in collection.products limit: 6 -%}
      <a href="{{ product.url }}" class="hd-card">
        <div class="image-wrapper">
          {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- else -%}
          <div style="width:100%;height:100%;background:#EAE6DF"></div>
          {%- endif -%}
        </div>
        <div class="title">{{ product.title }}</div>
        <div class="price">{{ product.price | money }}</div>
      </a>
      {%- else -%}
      <!-- Demo State -->
      {%- for i in (1..6) -%}
      <a href="#" class="hd-card">
        <div class="image-wrapper">
          <div style="width:100%;height:100%;background:#EAE6DF"></div>
        </div>
        <div class="title">Ceramic Vase Set V{{i}}</div>
        <div class="price">₹4,200</div>
      </a>
      {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Home Decor Grid",
  "settings": [],
  "presets": [
    {
      "name": "Home Decor Grid"
    }
  ]
}
{% endschema %}
