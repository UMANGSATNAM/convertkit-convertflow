<div style="background:#FFFFFF; padding:120px 40px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px; flex-wrap:wrap; gap:24px;">
      <div>
        <h2 style="font-family:'Playfair Display', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#2C2C2C; margin:0;">
          {{ section.settings.heading }}
        </h2>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Lato', sans-serif; font-size:13px; font-weight:600; color:#2C2C2C; text-decoration:none; letter-spacing:2px; text-transform:uppercase; border-bottom:1px solid #2C2C2C; padding-bottom:4px; transition:color 0.3s ease, border-color 0.3s ease;" class="hd-link-btn">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="hd-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:40px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1544457070-4cd773b4d71e?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1544457070-4cd773b4d71e?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1505691938895-1758d7feb511?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="hd-product-card" style="position:relative; group">
          
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:125%; background:#F5F5F5; margin-bottom:24px;">
            <img src="{{ img_url }}" alt="Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.8s ease;" class="hd-product-img" loading="lazy">
            
            <div style="position:absolute; inset:0; background:rgba(0,0,0,0.02); z-index:1;"></div>
            
            <button style="position:absolute; bottom:20px; left:50%; transform:translateX(-50%) translateY(20px); opacity:0; background:#2C2C2C; color:#FFFFFF; border:none; padding:12px 24px; font-family:'Lato', sans-serif; font-size:12px; font-weight:600; letter-spacing:1px; text-transform:uppercase; cursor:pointer; transition:all 0.3s ease; z-index:2; width:calc(100% - 40px);" class="hd-quick-add">
              QUICK ADD
            </button>
          </a>
          
          <div style="text-align:center;">
            <h3 style="font-family:'Playfair Display', serif; font-size:18px; font-weight:400; color:#2C2C2C; margin:0 0 8px 0;">
              {% if idx == 1 %}Aura Ceramic Vase{% elsif idx == 2 %}Lumina Table Lamp{% elsif idx == 3 %}Woven Linen Throw{% else %}Abstract Wall Art{% endif %}
            </h3>
            
            <div style="font-family:'Lato', sans-serif; font-size:14px; font-weight:400; color:#5A5A5A;">
              {% if idx == 1 %}$85.00{% elsif idx == 2 %}$145.00{% elsif idx == 3 %}$95.00{% else %}$210.00{% endif %}
            </div>
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .hd-link-btn:hover { color: #B8860B; border-color: #B8860B; }
    .hd-product-card:hover .hd-product-img { transform: scale(1.03); }
    .hd-product-card:hover .hd-quick-add { opacity: 1; transform: translateX(-50%) translateY(0); }
    .hd-quick-add:hover { background: #B8860B; }
    
    @media (max-width: 1024px) {
      .hd-product-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
    @media (max-width: 640px) {
      .hd-product-grid { grid-template-columns: 1fr !important; }
      .hd-quick-add { opacity: 1; transform: translateX(-50%) translateY(0); background: rgba(255,255,255,0.9); color: #2C2C2C; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Decor Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curator's Picks"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Decor Collection"
    }
  ]
}
{% endschema %}
