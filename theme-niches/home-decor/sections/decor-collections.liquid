{% style %}
.decor-collections { padding: 120px 0; background: var(--linen); }
.dc-header { text-align: center; margin-bottom: 80px; }
.dc-header h2 { font-size: 42px; margin-bottom: 16px; }
.dc-header p { font-size: 16px; color: var(--text-muted); font-weight: 300; }

.dc-masonry { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; }
.dc-item { position: relative; overflow: hidden; display: block; border-radius: 4px; text-decoration: none; }
.dc-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s ease; }
.dc-item svg { width: 100%; height: 100%; color: rgba(0,0,0,0.1); background: var(--sand); }
.dc-item:hover img { transform: scale(1.05); }

.dc-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(44, 42, 41, 0.6) 0%, transparent 60%); display: flex; flex-direction: column; justify-content: flex-end; padding: 40px; color: #fff; }
.dc-overlay h3 { color: #fff; font-size: 28px; margin-bottom: 8px; font-family: 'Cormorant Garamond', serif; }
.dc-overlay span { font-size: 13px; letter-spacing: 1px; text-transform: uppercase; font-weight: 500; display: inline-flex; align-items: center; gap: 8px; }
.dc-overlay span::after { content: '→'; transition: transform 0.3s; }
.dc-item:hover .dc-overlay span::after { transform: translateX(6px); }

/* Masonry Grid Setup */
.dc-item:nth-child(1) { grid-column: span 8; aspect-ratio: 16/9; }
.dc-item:nth-child(2) { grid-column: span 4; aspect-ratio: 3/4; }
.dc-item:nth-child(3) { grid-column: span 4; aspect-ratio: 3/4; margin-top: -15%; }
.dc-item:nth-child(4) { grid-column: span 8; aspect-ratio: 16/9; }

@media(max-width: 1024px) {
  .dc-masonry { grid-template-columns: repeat(2, 1fr); }
  .dc-item:nth-child(1), .dc-item:nth-child(2), .dc-item:nth-child(3), .dc-item:nth-child(4) { grid-column: span 2; aspect-ratio: 16/9; margin-top: 0; }
}
@media(max-width: 768px) {
  .dc-item:nth-child(n) { grid-column: span 2; aspect-ratio: 1; padding: 20px; }
  .dc-overlay { padding: 20px; }
  .dc-overlay h3 { font-size: 24px; }
}
{% endstyle %}

<section class="decor-collections">
  <div class="container">
    <div class="dc-header">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.sub }}</p>
    </div>
    
    <div class="dc-masonry">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.url }}" class="dc-item">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 1000 }}" loading="lazy">
          {%- else -%}
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          {%- endif -%}
          <div class="dc-overlay">
            <h3>{{ block.settings.title }}</h3>
            <span>{{ block.settings.link_text }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Decor Collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Curated Collections" },
    { "type": "text", "id": "sub", "label": "Subtitle", "default": "Discover pieces that transform houses into homes." }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "link_text", "label": "Link Text", "default": "Explore" },
        { "type": "url", "id": "url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [{ "name": "Decor Collections" }]
}
{% endschema %}
