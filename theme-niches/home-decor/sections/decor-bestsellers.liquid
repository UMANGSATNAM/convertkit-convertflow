{% style %}
.decor-bestsellers { padding: 120px 0; background: var(--sand); overflow: hidden; }
.db-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 60px; }
.db-header h2 { font-size: 42px; margin-bottom: 8px; }
.db-header p { color: var(--text-muted); font-size: 16px; font-weight: 300; }
.db-nav { display: flex; gap: 12px; }
.db-nav button { width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--border); background: transparent; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s; color: var(--charcoal); }
.db-nav button:hover { background: var(--charcoal); color: #fff; border-color: var(--charcoal); }

.db-slider { display: flex; gap: 32px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 20px; }
.db-slider::-webkit-scrollbar { display: none; }
.db-card { min-width: 340px; scroll-snap-align: start; }
.db-img { aspect-ratio: 4/5; background: var(--linen); margin-bottom: 20px; position: relative; overflow: hidden; border-radius: 2px; }
.db-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
.db-img svg { width: 30%; color: var(--clay); position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); opacity: 0.5; }
.db-card:hover .db-img img { transform: scale(1.05); }

.db-add { position: absolute; bottom: 20px; left: 20px; right: 20px; background: rgba(255,255,255,0.95); backdrop-filter: blur(4px); padding: 16px; text-align: center; font-size: 12px; font-weight: 500; letter-spacing: 1px; color: var(--charcoal); text-transform: uppercase; border: none; opacity: 0; transform: translateY(10px); transition: all 0.3s ease; cursor: pointer; border-radius: 2px; }
.db-card:hover .db-add { opacity: 1; transform: translateY(0); }
.db-add:hover { background: var(--charcoal); color: #fff; }

.db-info { text-align: center; }
.db-type { font-size: 12px; color: var(--clay); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
.db-title { font-size: 18px; font-family: 'Cormorant Garamond', serif; font-weight: 600; margin-bottom: 8px; color: var(--charcoal); }
.db-price { font-size: 15px; color: var(--text-muted); font-weight: 300; }

@media(max-width: 768px) {
  .db-card { min-width: 280px; }
  .db-add { opacity: 1; transform: translateY(0); }
}
{% endstyle %}

<section class="decor-bestsellers">
  <div class="container">
    <div class="db-header">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.sub }}</p>
      </div>
      <div class="db-nav">
        <button><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg></button>
        <button><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg></button>
      </div>
    </div>
    
    <div class="db-slider">
      {%- for block in section.blocks -%}
        <div class="db-card">
          <div class="db-img">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 500 }}" loading="lazy">
            {%- else -%}
               <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1"><path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"/><path d="M4 6v12c0 1.1.9 2 2 2h14v-4"/><path d="M18 12a2 2 0 0 0-2 2c0 1.1.9 2 2 2h4v-4h-4z"/></svg>
            {%- endif -%}
            <button class="db-add">Quick Add</button>
          </div>
          <div class="db-info">
            <div class="db-type">{{ block.settings.type }}</div>
            <div class="db-title">{{ block.settings.title }}</div>
            <div class="db-price">{{ block.settings.price }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Decor Bestsellers",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Signature Pieces" },
    { "type": "text", "id": "sub", "label": "Subtitle", "default": "Our most loved designs for modern homes." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "type", "label": "Type", "default": "Lighting" },
        { "type": "text", "id": "title", "label": "Title", "default": "Brass Dome Pendant" },
        { "type": "text", "id": "price", "label": "Price", "default": "$189.00" }
      ]
    }
  ],
  "presets": [{ "name": "Decor Bestsellers" }]
}
{% endschema %}
