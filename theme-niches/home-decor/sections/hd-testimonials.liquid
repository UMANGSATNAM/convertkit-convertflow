<div style="background:#FFFFFF; padding:120px 24px; border-top:1px solid #EAEAEA;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Playfair Display', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#2C2C2C; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="hd-test-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:60px;">
      
      {%- for block in section.blocks -%}
        <div style="text-align:center;">
          
          <div style="font-family:'Playfair Display', serif; font-size:48px; color:#B8860B; line-height:1; margin-bottom:24px;">"</div>
          
          <p style="font-family:'Lato', sans-serif; font-size:16px; font-weight:300; line-height:1.8; color:#5A5A5A; margin:0 0 32px 0;">
            {{ block.settings.quote }}
          </p>
          
          <div style="font-family:'Lato', sans-serif; font-size:13px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:#2C2C2C;">
            — {{ block.settings.author }}
          </div>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    @media (max-width: 990px) {
      .hd-test-grid { grid-template-columns: 1fr; gap: 80px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Decor Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Words from Our Clients"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The ceramic vases I ordered transformed my living room. Truly exquisite craftsmanship."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Eleanor R."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Decor Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
