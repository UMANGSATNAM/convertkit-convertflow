{% style %}
.decor-hero { height: 100vh; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; background: var(--sand); }
.dh-bg { position: absolute; inset: 0; z-index: 1; }
.dh-bg img { width: 100%; height: 100%; object-fit: cover; }
.dh-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(247, 245, 240, 0.9) 0%, rgba(247, 245, 240, 0.4) 50%, rgba(247, 245, 240, 0.8) 100%); z-index: 2; }

.dh-content { position: relative; z-index: 3; text-align: center; max-width: 800px; padding: 0 20px; margin-top: 60px; }
.dh-tag { font-size: 13px; font-weight: 500; letter-spacing: 3px; text-transform: uppercase; color: var(--clay); margin-bottom: 24px; display: block; }
.dh-content h1 { font-size: 80px; line-height: 1; margin-bottom: 30px; letter-spacing: -1px; }
.dh-content h1 i { font-style: italic; font-weight: 400; color: var(--clay); }
.dh-content p { font-size: 18px; color: var(--text-muted); line-height: 1.6; margin-bottom: 40px; font-weight: 300; }
.dh-ctas { display: flex; gap: 20px; justify-content: center; }

@media(max-width: 1024px) {
  .dh-content h1 { font-size: 60px; }
}
@media(max-width: 768px) {
  .decor-hero { height: auto; padding: 160px 0 100px; }
  .dh-content h1 { font-size: 48px; }
  .dh-ctas { flex-direction: column; }
  .dh-overlay { background: rgba(247, 245, 240, 0.85); }
}
{% endstyle %}

<section class="decor-hero">
  <div class="dh-bg">
    {%- if section.settings.bg_image != blank -%}
      <img src="{{ section.settings.bg_image | image_url: width: 1800 }}" loading="lazy">
    {%- else -%}
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="0.5" style="width: 100%; height: 100%; color: rgba(0,0,0,0.05);"><path d="M4 4h16v16H4z"/></svg>
    {%- endif -%}
  </div>
  <div class="dh-overlay"></div>
  
  <div class="dh-content">
    <span class="dh-tag">{{ section.settings.tag }}</span>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    <div class="dh-ctas">
      {%- if section.settings.btn1_text != blank -%}
        <a href="{{ section.settings.btn1_url }}" class="btn-primary">{{ section.settings.btn1_text }}</a>
      {%- endif -%}
      {%- if section.settings.btn2_text != blank -%}
        <a href="{{ section.settings.btn2_url }}" class="btn-outline">{{ section.settings.btn2_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Decor Hero",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "text", "id": "tag", "label": "Tag", "default": "Elevate Your Space" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Mindful Design<br>for <i>Modern Living</i>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Curated objects and handcrafted furniture that bring warmth, texture, and serene beauty to your daily rituals." },
    { "type": "text", "id": "btn1_text", "label": "Button 1 Text", "default": "Shop New Arrivals" },
    { "type": "url", "id": "btn1_url", "label": "Button 1 URL" },
    { "type": "text", "id": "btn2_text", "label": "Button 2 Text", "default": "Explore The Lookbook" },
    { "type": "url", "id": "btn2_url", "label": "Button 2 URL" }
  ],
  "presets": [{ "name": "Decor Hero" }]
}
{% endschema %}
