<div style="background:#FAF9F6; padding:100px 40px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Playfair Display', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#2C2C2C; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="hd-cat-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:30px;">
      
      {%- for block in section.blocks -%}
        <a href="#" class="hd-cat-card" style="display:block; text-decoration:none; position:relative; overflow:hidden; text-align:center; group">
          
          <div style="position:relative; padding-bottom:120%; overflow:hidden; margin-bottom:24px; border-radius:200px 200px 0 0;">
            {%- assign idx = forloop.index | modulo: 4 -%}
            {%- assign img_url = 'https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=600&q=80' -%}
            {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1616486029423-aaa4789e8c9a?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1505691938895-1758d7feb511?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            
            <img src="{{ img_url }}" alt="{{ block.settings.title }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.8s ease;" class="hd-cat-img" loading="lazy">
          </div>
          
          <h3 style="font-family:'Lato', sans-serif; font-size:14px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:#2C2C2C; margin:0; transition:color 0.3s ease;" class="hd-cat-title">
            {{ block.settings.title }}
          </h3>
          
          <div style="width:0; height:1px; background:#B8860B; margin:12px auto 0 auto; transition:width 0.4s ease;" class="hd-cat-line"></div>
          
        </a>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .hd-cat-card:hover .hd-cat-img { transform: scale(1.05); }
    .hd-cat-card:hover .hd-cat-title { color: #B8860B; }
    .hd-cat-card:hover .hd-cat-line { width: 40px; }
    
    @media (max-width: 1024px) {
      .hd-cat-grid { grid-template-columns: repeat(2, 1fr); gap:40px 30px; }
    }
    @media (max-width: 640px) {
      .hd-cat-grid { grid-template-columns: 1fr; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Decor Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Lighting"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Decor Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
