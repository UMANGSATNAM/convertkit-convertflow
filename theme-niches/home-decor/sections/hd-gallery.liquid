<div style="background:#FAF9F6; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto; text-align:center;">
    
    <div style="margin-bottom:60px;">
      <h2 style="font-family:'Playfair Display', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#2C2C2C; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      <div style="font-family:'Lato', sans-serif; font-size:16px; font-weight:400; color:#5A5A5A;">
        {{ section.settings.subheading }}
      </div>
    </div>

    <!-- Masonry Layout Approximation using CSS Grid -->
    <div class="hd-gallery-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:20px;">
      
      <div style="grid-column: span 1; grid-row: span 2; position:relative; overflow:hidden;" class="hd-gallery-item">
        <img src="https://images.unsplash.com/photo-1583847268964-b28dc8f51f92?auto=format&fit=crop&w=600&q=80" alt="Gallery Image" style="width:100%; height:100%; object-fit:cover; position:absolute; inset:0; transition:transform 0.5s ease;" loading="lazy">
        <div style="padding-bottom:150%;"></div>
      </div>
      
      <div style="grid-column: span 2; grid-row: span 1; position:relative; overflow:hidden;" class="hd-gallery-item">
        <img src="https://images.unsplash.com/photo-1600121848594-d8644e57abab?auto=format&fit=crop&w=800&q=80" alt="Gallery Image" style="width:100%; height:100%; object-fit:cover; position:absolute; inset:0; transition:transform 0.5s ease;" loading="lazy">
        <div style="padding-bottom:70%;"></div>
      </div>
      
      <div style="grid-column: span 1; grid-row: span 1; position:relative; overflow:hidden;" class="hd-gallery-item">
        <img src="https://images.unsplash.com/photo-1616486029423-aaa4789e8c9a?auto=format&fit=crop&w=600&q=80" alt="Gallery Image" style="width:100%; height:100%; object-fit:cover; position:absolute; inset:0; transition:transform 0.5s ease;" loading="lazy">
        <div style="padding-bottom:100%;"></div>
      </div>
      
      <div style="grid-column: span 1; grid-row: span 1; position:relative; overflow:hidden;" class="hd-gallery-item">
        <img src="https://images.unsplash.com/photo-1544457070-4cd773b4d71e?auto=format&fit=crop&w=600&q=80" alt="Gallery Image" style="width:100%; height:100%; object-fit:cover; position:absolute; inset:0; transition:transform 0.5s ease;" loading="lazy">
        <div style="padding-bottom:100%;"></div>
      </div>
      
      <div style="grid-column: span 2; grid-row: span 1; position:relative; overflow:hidden;" class="hd-gallery-item">
        <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=800&q=80" alt="Gallery Image" style="width:100%; height:100%; object-fit:cover; position:absolute; inset:0; transition:transform 0.5s ease;" loading="lazy">
        <div style="padding-bottom:50%;"></div>
      </div>

    </div>
  </div>

  <style>
    .hd-gallery-item:hover img { transform: scale(1.05); }
    
    @media (max-width: 768px) {
      .hd-gallery-grid { grid-template-columns: repeat(2, 1fr); }
      .hd-gallery-item[style*="grid-column: span 2"] { grid-column: span 2; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Decor Gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Styled by You"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "@casaandco"
    }
  ],
  "presets": [
    {
      "name": "Decor Gallery"
    }
  ]
}
{% endschema %}
