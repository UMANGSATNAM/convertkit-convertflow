<div style="background:#FAF9F6; position:relative; min-height:90vh; display:flex; align-items:center;">
  
  <!-- Content -->
  <div style="width:100%; max-width:1440px; margin:0 auto; padding:0 40px; display:flex; z-index:2; position:relative;">
    <div style="max-width:560px; background:#FFFFFF; padding:60px; box-shadow:0 30px 60px rgba(0,0,0,0.05); margin-top:100px;">
      
      <div style="font-family:'Lato', sans-serif; font-size:12px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:#B8860B; margin-bottom:24px;">
        {{ section.settings.eyebrow }}
      </div>

      <h1 style="font-family:'Playfair Display', serif; font-size:clamp(40px, 5vw, 64px); font-weight:400; line-height:1.1; color:#2C2C2C; margin:0 0 24px 0;">
        {{ section.settings.heading }}
      </h1>
      
      <p style="font-family:'Lato', sans-serif; font-size:16px; font-weight:300; color:#5A5A5A; line-height:1.8; margin:0 0 40px 0;">
        {{ section.settings.subheading }}
      </p>

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-block; background:#2C2C2C; color:#FFFFFF; font-family:'Lato', sans-serif; font-size:13px; font-weight:600; letter-spacing:2px; text-transform:uppercase; text-decoration:none; padding:18px 40px; transition:all 0.3s ease; border:1px solid #2C2C2C;" class="hd-btn-primary">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <!-- Background Image spanning right side -->
  <div style="position:absolute; top:0; right:0; bottom:0; width:65%; z-index:1;" class="hd-hero-bg">
    <img src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=1600&q=80" alt="Home Decor" style="width:100%; height:100%; object-fit:cover; object-position:center right;" loading="eager">
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Lato:wght@300;400;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap');
    
    .hd-btn-primary:hover { background: #FFFFFF; color: #2C2C2C; }
    
    @media (max-width: 1024px) {
      .hd-hero-bg { width: 100%; opacity: 0.8; }
      div[style*="max-width:560px"] { padding: 40px; margin-top: 50px; background: rgba(255,255,255,0.95); }
    }
    @media (max-width: 640px) {
      div[style*="padding:0 40px"] { padding: 0 20px; }
      div[style*="max-width:560px"] { padding: 30px 20px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Decor Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Artistry in Every Detail"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curate a space that reflects your unique style with our handcrafted home accents."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP THE COLLECTION"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Decor Hero"
    }
  ]
}
{% endschema %}
