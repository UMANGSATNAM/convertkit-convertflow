<div style="background:var(--hd-bg);min-height:90vh;display:flex;align-items:center;padding:80px 60px;position:relative">
  
  <div style="max-width:1400px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center">
    
    <div style="position:relative;height:75vh">
      <div style="position:absolute;top:0;left:0;width:100%;height:100%;background:var(--hd-border);transform:translate(-20px, 20px)"></div>
      <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/decor-hero.jpg?v=1717283400" alt="Interior Design" style="width:100%;height:100%;object-fit:cover;position:relative;z-index:2">
    </div>

    <div style="padding-left:40px">
      <div style="font-family:var(--font-b);text-transform:uppercase;font-size:12px;letter-spacing:0.2em;color:var(--hd-accent);margin-bottom:24px">
        {{ section.settings.overline | default: 'The 2026 Collection' }}
      </div>
      <h1 class="hd-head" style="font-size:clamp(48px, 6vw, 72px);line-height:1.1;margin-bottom:32px">
        {{ section.settings.heading | default: 'Elevate<br>Your Space.' }}
      </h1>
      <p style="font-size:16px;line-height:1.8;color:var(--hd-muted);margin-bottom:48px;max-width:440px">
        {{ section.settings.text | default: 'Curated furniture and decor designed to bring warmth, elegance, and architectural balance to your home.' }}
      </p>
      <div style="display:flex;gap:24px">
        <a href="{{ section.settings.btn1_url | default: '/collections/furniture' }}" class="hd-btn">{{ section.settings.btn1_text | default: 'Explore Furniture' }}</a>
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Home Decor Hero",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline Text",
      "default": "The 2026 Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate<br>Your Space."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Curated furniture and decor designed to bring warmth."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button Text",
      "default": "Explore Furniture"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Home Decor Hero"
    }
  ]
}
{% endschema %}
