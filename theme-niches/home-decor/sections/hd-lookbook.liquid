<div style="background:#FAF9F6; padding:120px 24px; overflow:hidden;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:60px;">
      <div style="font-family:'Lato', sans-serif; font-size:12px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:#B8860B; margin-bottom:16px;">
        {{ section.settings.eyebrow }}
      </div>
      <h2 style="font-family:'Playfair Display', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#2C2C2C; margin:0;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div style="position:relative; width:100%; padding-bottom:56.25%; background:#EAEAEA; overflow:hidden;">
      <img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1600&q=80" alt="Room Scene" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;" loading="lazy">
      
      <!-- Hotspot 1 -->
      <div style="position:absolute; top:40%; left:25%;" class="hd-hotspot">
        <div style="width:24px; height:24px; background:#FFFFFF; border-radius:50%; box-shadow:0 0 0 8px rgba(255,255,255,0.3); cursor:pointer; position:relative; z-index:2; transition:all 0.3s ease;" class="hd-hotspot-dot"></div>
        
        <div style="position:absolute; top:50%; left:40px; transform:translateY(-50%); background:#FFFFFF; padding:16px; width:200px; opacity:0; visibility:hidden; transition:all 0.3s ease; z-index:3; box-shadow:0 10px 30px rgba(0,0,0,0.1);" class="hd-hotspot-card">
          <img src="https://images.unsplash.com/photo-1544457070-4cd773b4d71e?auto=format&fit=crop&w=300&q=80" alt="Product" style="width:100%; height:120px; object-fit:cover; margin-bottom:12px;">
          <div style="font-family:'Playfair Display', serif; font-size:16px; color:#2C2C2C; margin-bottom:4px;">Aura Ceramic Vase</div>
          <div style="font-family:'Lato', sans-serif; font-size:14px; color:#B8860B;">$85.00</div>
        </div>
      </div>
      
      <!-- Hotspot 2 -->
      <div style="position:absolute; top:60%; right:35%;" class="hd-hotspot">
        <div style="width:24px; height:24px; background:#FFFFFF; border-radius:50%; box-shadow:0 0 0 8px rgba(255,255,255,0.3); cursor:pointer; position:relative; z-index:2; transition:all 0.3s ease;" class="hd-hotspot-dot"></div>
        
        <div style="position:absolute; top:50%; right:40px; transform:translateY(-50%); background:#FFFFFF; padding:16px; width:200px; opacity:0; visibility:hidden; transition:all 0.3s ease; z-index:3; box-shadow:0 10px 30px rgba(0,0,0,0.1);" class="hd-hotspot-card">
          <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=300&q=80" alt="Product" style="width:100%; height:120px; object-fit:cover; margin-bottom:12px;">
          <div style="font-family:'Playfair Display', serif; font-size:16px; color:#2C2C2C; margin-bottom:4px;">Woven Linen Throw</div>
          <div style="font-family:'Lato', sans-serif; font-size:14px; color:#B8860B;">$95.00</div>
        </div>
      </div>
      
    </div>
  </div>

  <style>
    .hd-hotspot-dot:hover { background: #B8860B; box-shadow: 0 0 0 8px rgba(184,134,11,0.3); }
    .hd-hotspot:hover .hd-hotspot-card { opacity: 1; visibility: visible; }
    
    @media (max-width: 768px) {
      div[style*="padding-bottom:56.25%"] { padding-bottom: 100%; }
      .hd-hotspot-card { display: none; } /* Hide cards on very small screens for simplicity, or handle via JS */
    }
  </style>
</div>

{% schema %}
{
  "name": "Decor Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "GET INSPIRED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop The Look"
    }
  ],
  "presets": [
    {
      "name": "Decor Lookbook"
    }
  ]
}
{% endschema %}
