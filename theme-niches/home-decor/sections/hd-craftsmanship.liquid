<div style="background:#FFFFFF; padding:120px 40px; position:relative; overflow:hidden;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div class="hd-craft-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
      
      <!-- Visual -->
      <div style="position:relative; padding-bottom:120%; overflow:hidden;">
        <img src="https://images.unsplash.com/photo-1490216652614-23916960d70a?auto=format&fit=crop&w=800&q=80" alt="Craftsmanship" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;" loading="lazy">
        <div style="position:absolute; inset:0; background:linear-gradient(45deg, rgba(184,134,11,0.1), transparent);"></div>
      </div>
      
      <!-- Content -->
      <div>
        <h2 style="font-family:'Playfair Display', serif; font-size:clamp(40px, 5vw, 64px); font-weight:400; color:#2C2C2C; margin:0 0 32px 0;">
          {{ section.settings.heading }}
        </h2>
        
        <p style="font-family:'Lato', sans-serif; font-size:18px; font-weight:300; line-height:1.8; color:#5A5A5A; margin:0 0 48px 0;">
          {{ section.settings.subheading }}
        </p>
        
        <div style="display:flex; gap:40px; margin-bottom:48px;">
          <div>
            <div style="font-family:'Playfair Display', serif; font-size:32px; color:#B8860B; margin-bottom:8px;">15+</div>
            <div style="font-family:'Lato', sans-serif; font-size:14px; font-weight:600; color:#2C2C2C; text-transform:uppercase; letter-spacing:1px;">Countries</div>
          </div>
          <div>
            <div style="font-family:'Playfair Display', serif; font-size:32px; color:#B8860B; margin-bottom:8px;">100%</div>
            <div style="font-family:'Lato', sans-serif; font-size:14px; font-weight:600; color:#2C2C2C; text-transform:uppercase; letter-spacing:1px;">Handmade</div>
          </div>
        </div>
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/pages/about' }}" style="display:inline-block; font-family:'Lato', sans-serif; font-size:13px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:#2C2C2C; text-decoration:none; border-bottom:1px solid #2C2C2C; padding-bottom:4px; transition:color 0.3s ease, border-color 0.3s ease;" class="hd-link-btn">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
      
    </div>
  </div>

  <style>
    .hd-link-btn:hover { color: #B8860B; border-color: #B8860B; }
    
    @media (max-width: 990px) {
      .hd-craft-grid { grid-template-columns: 1fr; gap: 60px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Decor Craftsmanship",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Art of Making"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We partner with artisans around the world to bring you pieces that are as unique as they are beautiful."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "OUR STORY"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Decor Craftsmanship"
    }
  ]
}
{% endschema %}
