<div style="padding:48px 20px 80px;background:var(--lw-midnight);min-height:60vh">
  <div style="max-width:960px;margin:0 auto">
    <h1 style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,4vw,44px);font-weight:300;color:var(--lw-ivory);text-align:center;margin-bottom:48px">Your Collection</h1>
    {%- if cart.item_count == 0 -%}
    <div style="text-align:center;padding:80px 20px">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="rgba(196,154,108,0.3)" stroke-width="1" style="margin:0 auto 20px;display:block"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <h2 style="font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:300;color:var(--lw-ivory);margin-bottom:12px">Your collection is empty</h2>
      <p style="color:var(--lw-muted);margin-bottom:32px">Discover precision-crafted timepieces</p>
      <a href="/collections/all" class="lw-btn lw-btn--solid">EXPLORE TIMEPIECES</a>
    </div>
    {%- else -%}
    <div style="display:grid;grid-template-columns:1fr 380px;gap:48px;align-items:start">
      <div>
        {%- for item in cart.items -%}
        <div style="display:flex;gap:20px;padding:24px 0;border-bottom:1px solid var(--lw-border);align-items:center">
          <a href="{{ item.url }}" style="flex-shrink:0"><img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="100" style="object-fit:cover"></a>
          <div style="flex:1;min-width:0">
            <a href="{{ item.url }}" style="text-decoration:none;font-size:15px;font-weight:600;color:var(--lw-ivory);display:block;margin-bottom:4px">{{ item.product.title }}</a>
            {%- unless item.variant.title == 'Default Title' -%}<div style="font-size:13px;color:var(--lw-muted);margin-bottom:8px">{{ item.variant.title }}</div>{%- endunless -%}
            <div style="display:flex;align-items:center;gap:12px">
              <div style="display:flex;align-items:center;border:1px solid var(--lw-border)">
                <button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px;color:var(--lw-ivory)">−</button>
                <span style="width:32px;text-align:center;font-size:14px;font-weight:600;color:var(--lw-ivory)">{{ item.quantity }}</span>
                <button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px;color:var(--lw-ivory)">+</button>
              </div>
              <a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" style="font-size:12px;color:var(--lw-muted);text-decoration:underline">Remove</a>
            </div>
          </div>
          <div style="font-size:16px;font-weight:700;color:var(--lw-amber)">{{ item.final_line_price | money }}</div>
        </div>
        {%- endfor -%}
      </div>
      <div style="background:var(--lw-charcoal);padding:32px;border:1px solid var(--lw-border);position:sticky;top:120px">
        <h3 style="font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--lw-ivory);margin-bottom:24px">Order Summary</h3>
        <div style="display:flex;justify-content:space-between;margin-bottom:12px;font-size:14px"><span style="color:var(--lw-muted)">Subtotal</span><span style="font-weight:600;color:var(--lw-ivory)">{{ cart.total_price | money }}</span></div>
        <div style="display:flex;justify-content:space-between;margin-bottom:12px;font-size:14px"><span style="color:var(--lw-muted)">Delivery</span><span style="font-weight:600;color:var(--lw-amber)">Complimentary Insured</span></div>
        <div style="margin:16px 0;padding:12px;border:1px solid var(--lw-border);font-size:13px;text-align:center;color:var(--lw-muted)">
          🎁 Complimentary gift box & authenticity card included
        </div>
        <div style="padding-top:16px;border-top:1px solid var(--lw-border);margin-top:16px;display:flex;justify-content:space-between;margin-bottom:24px">
          <span style="font-size:16px;font-weight:700;color:var(--lw-ivory)">Total</span>
          <span style="font-size:20px;font-weight:700;color:var(--lw-amber)">{{ cart.total_price | money }}</span>
        </div>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="lw-btn lw-btn--solid" style="width:100%;justify-content:center;font-size:12px">PROCEED TO CHECKOUT</button>
        </form>
        <div style="display:flex;justify-content:center;gap:14px;margin-top:16px">
          <span style="font-size:11px;color:var(--lw-muted)">✓ 5yr Warranty</span>
          <span style="font-size:11px;color:var(--lw-muted)">🔒 Secure</span>
          <span style="font-size:11px;color:var(--lw-muted)">↩ Free Returns</span>
        </div>
      </div>
    </div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{"name":"LW Cart","settings":[],"presets":[{"name":"LW Cart"}]}
{% endschema %}
