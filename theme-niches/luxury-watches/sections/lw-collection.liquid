<div style="padding:48px 20px 0;background:var(--lw-midnight)">
  <div style="max-width:1320px;margin:0 auto;text-align:center;padding-bottom:48px">
    <p class="lw-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</p>
    <h1 style="font-family:'Cormorant Garamond',serif;font-size:clamp(32px,5vw,56px);font-weight:300;color:var(--lw-ivory);margin-bottom:12px">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<p style="font-size:16px;color:var(--lw-muted);max-width:560px;margin:0 auto;line-height:1.7">{{ collection.description }}</p>{%- endif -%}
  </div>
</div>
<div style="padding:0 20px 80px;background:var(--lw-midnight)">
  <div style="max-width:1320px;margin:0 auto">
    <div style="display:flex;justify-content:space-between;align-items:center;padding:20px 0;border-bottom:1px solid var(--lw-border);margin-bottom:32px">
      <div style="font-size:13px;color:var(--lw-muted)">{{ collection.products_count }} timepieces</div>
      <select style="padding:8px 16px;border:1px solid var(--lw-border);font-size:12px;font-family:'DM Sans',sans-serif;letter-spacing:0.06em;text-transform:uppercase;cursor:pointer;background:transparent;color:var(--lw-ivory)">
        <option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Newest</option>
      </select>
    </div>
    <div class="lw-prod-grid">
      {%- for product in collection.products -%}
      <a href="{{ product.url }}" class="lw-prod-card">
        <div class="lw-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--lw-charcoal)"></div>{%- endif -%}</div>
        <div class="lw-prod-card__name">{{ product.title }}</div>
        <div class="lw-prod-card__price">{{ product.price | money }}</div>
        <div class="lw-prod-card__meta">{{ product.type }}</div>
      </a>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{"name":"LW Collection","settings":[],"presets":[{"name":"LW Collection"}]}
{% endschema %}
