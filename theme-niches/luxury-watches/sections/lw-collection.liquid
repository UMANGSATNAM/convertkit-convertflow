<div style="background:var(--lw-bg);padding:100px 60px">
  <div style="max-width:1400px;margin:0 auto">
    
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:80px;border-bottom:1px solid var(--lw-border);padding-bottom:32px">
      <div>
        <div class="lw-spec" style="margin-bottom:12px;color:var(--lw-accent)">{{ collection.products_count | default: '8' }} COMPLICATIONS</div>
        <h2 class="lw-head" style="font-size:48px">{{ collection.title | default: 'Grand Complications' }}</h2>
      </div>
    </div>
    
    <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:40px;border-left:1px solid var(--lw-border);border-top:1px solid var(--lw-border)">
      {%- for product in collection.products limit: 6 -%}
      <a href="{{ product.url }}" class="lw-card" style="border:none;border-right:1px solid var(--lw-border);border-bottom:1px solid var(--lw-border)">
        <div class="image-wrapper">
          {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- else -%}
          <div style="width:100%;height:100%;background:#0D1210"></div>
          {%- endif -%}
        </div>
        <div class="lw-spec" style="margin-bottom:12px">{{ product.vendor | default: 'Automatic' }}</div>
        <div class="title">{{ product.title }}</div>
        <div class="price">{{ product.price | money }}</div>
      </a>
      {%- else -%}
      <!-- Demo State -->
      {%- for i in (1..6) -%}
      <a href="#" class="lw-card" style="border:none;border-right:1px solid var(--lw-border);border-bottom:1px solid var(--lw-border)">
        <div class="image-wrapper">
          <div style="width:100%;height:100%;background:#0D1210"></div>
        </div>
        <div class="lw-spec" style="margin-bottom:12px">AUTOMATIC WINDING</div>
        <div class="title">Ref. 5204R-0{{i}}</div>
        <div class="price">Price on Request</div>
      </a>
      {%- endfor -%}
      {%- endfor -%}
    </div>
    
    <div style="text-align:center;margin-top:80px">
      <a href="/collections/all" class="lw-btn">View All Timepieces</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Horology Grid",
  "settings": [],
  "presets": [
    {
      "name": "Horology Grid"
    }
  ]
}
{% endschema %}
