<div class="lw-reviews">
  <div class="lw-section-header">
    <p class="lw-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="lw-review-grid">
    {%- for block in section.blocks -%}
    <div class="lw-review-card" {{ block.shopify_attributes }}>
      <div class="lw-review-card__stars">{%- for i in (1..block.settings.rating) -%}★{%- endfor -%}</div>
      <div class="lw-review-card__text">"{{ block.settings.quote }}"</div>
      <div class="lw-review-card__author">{{ block.settings.name }}</div>
      <div class="lw-review-card__meta">{{ block.settings.product }}</div>
    </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "LW Reviews",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"COLLECTOR VOICES"},
    {"type":"text","id":"heading","label":"Heading","default":"From Our Collectors"}
  ],
  "blocks": [{"type":"review","name":"Review","settings":[{"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Watch"}]}],
  "presets":[{"name":"LW Reviews","blocks":[{"type":"review","settings":{"rating":5,"quote":"The movement finishing is extraordinary. You can feel the centuries of craft tradition in every detail.","name":"Arjun K.","product":"Chronograph 42mm"}},{"type":"review","settings":{"rating":5,"quote":"Bought this as a milestone piece — every time I look at my wrist, it reminds me how far I've come.","name":"Prateek S.","product":"Dress Classic 38mm"}},{"type":"review","settings":{"rating":5,"quote":"The lume is incredible. Readability underwater is crystal clear. Best dive watch I've owned.","name":"Nisha R.","product":"Aqua Diver 300m"}}]}]
}
{% endschema %}
