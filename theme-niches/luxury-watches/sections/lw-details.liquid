<div style="background:#000000; padding:120px 24px; position:relative; border-top:1px solid rgba(212,175,55,0.15); border-bottom:1px solid rgba(212,175,55,0.15);">
  <div style="max-width:1440px; margin:0 auto; text-align:center;">
    
    <div style="margin-bottom:80px;">
      <div style="display:inline-block; width:1px; height:60px; background:linear-gradient(to bottom, rgba(212,175,55,0), rgba(212,175,55,1)); margin-bottom:24px;"></div>
      <h2 style="font-family:'Cinzel', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#FFFFFF; margin:0 0 16px 0; text-transform:uppercase; letter-spacing:2px;">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="lw-details-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:60px;">
      
      {%- for block in section.blocks -%}
        <div style="text-align:center;" class="lw-detail-item">
          
          <div style="font-family:'Cinzel', serif; font-size:32px; color:#D4AF37; margin-bottom:24px; opacity:0.8;">
            {% if forloop.index == 1 %}I{% elsif forloop.index == 2 %}II{% else %}III{% endif %}
          </div>
          
          <h3 style="font-family:'Montserrat', sans-serif; font-size:16px; font-weight:500; letter-spacing:2px; text-transform:uppercase; color:#FFFFFF; margin:0 0 16px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Montserrat', sans-serif; font-size:14px; font-weight:300; line-height:1.8; color:#888888; margin:0 auto; max-width:300px;">
            {{ block.settings.desc }}
          </p>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .lw-detail-item:hover h3 { color: #D4AF37; }
    
    @media (max-width: 768px) {
      .lw-details-grid { grid-template-columns: 1fr; gap: 60px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Luxury Details",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Art of Movement"
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Tourbillon Movement"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Counteracting the effects of gravity for unparalleled accuracy."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Details",
      "blocks": [
        { "type": "detail" },
        { "type": "detail" },
        { "type": "detail" }
      ]
    }
  ]
}
{% endschema %}
