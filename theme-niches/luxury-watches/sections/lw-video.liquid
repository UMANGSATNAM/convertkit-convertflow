<div style="background:#0A0A0A; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="position:relative; padding-bottom:56.25%; background:#000000; overflow:hidden;">
      <!-- Subtle frame -->
      <div style="position:absolute; inset:20px; border:1px solid rgba(212,175,55,0.2); z-index:2; pointer-events:none;"></div>
      
      <!-- Video placeholder using an image and play button -->
      <img src="https://images.unsplash.com/photo-1547996160-81dfa63595aa?auto=format&fit=crop&w=1600&q=80" alt="Watch Video Placeholder" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:brightness(0.5); transition:filter 0.5s ease;" class="lw-video-img" loading="lazy">
      
      <div style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); z-index:3; text-align:center;">
        <div style="width:80px; height:80px; border-radius:50%; border:1px solid rgba(212,175,55,0.5); display:flex; align-items:center; justify-content:center; margin:0 auto 24px auto; cursor:pointer; transition:all 0.3s ease; background:rgba(10,10,10,0.5); backdrop-filter:blur(4px);" class="lw-play-btn">
          <svg style="width:24px; height:24px; fill:#D4AF37; margin-left:6px;" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </div>
        <div style="font-family:'Montserrat', sans-serif; font-size:12px; font-weight:500; letter-spacing:4px; text-transform:uppercase; color:#FFFFFF;">
          {{ section.settings.heading }}
        </div>
      </div>
    </div>
    
  </div>

  <style>
    .lw-video-img:hover { filter: brightness(0.7); }
    .lw-play-btn:hover { background: #D4AF37; border-color: #D4AF37; transform: scale(1.1); }
    .lw-play-btn:hover svg { fill: #0A0A0A; }
    
    @media (max-width: 768px) {
      div[style*="padding-bottom:56.25%"] { padding-bottom: 100%; } /* Square on mobile */
      div[style*="inset:20px"] { inset: 10px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Luxury Video",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Witness the Craft"
    }
  ],
  "presets": [
    {
      "name": "Luxury Video"
    }
  ]
}
{% endschema %}
