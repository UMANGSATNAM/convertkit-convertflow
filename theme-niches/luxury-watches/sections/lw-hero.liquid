<div class="lw-hero">
  <div class="lw-hero__content">
    <p class="lw-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="lw-hero__title">{{ section.settings.heading }}</h1>
    <p class="lw-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:16px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="lw-btn lw-btn--solid">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}
      <a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="lw-btn">{{ section.settings.cta_label_2 }}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="lw-hero__visual">
    {%- if section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">
    {%- else -%}
    <div style="width:100%;height:100%;min-height:500px;background:linear-gradient(135deg,#1A1D23,#0D1117);display:flex;align-items:center;justify-content:center">
      <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="rgba(196,154,108,0.2)" stroke-width="1"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "LW Hero",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"HAUTE HORLOGERIE"},
    {"type":"text","id":"heading","label":"Heading","default":"Time, Perfected"},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"A curated collection of the world's finest timepieces — from heritage mechanical movements to modern icons."},
    {"type":"image_picker","id":"image","label":"Hero Image"},
    {"type":"text","id":"cta_label","label":"CTA","default":"EXPLORE COLLECTION"},
    {"type":"url","id":"cta_url","label":"CTA URL"},
    {"type":"text","id":"cta_label_2","label":"Secondary CTA","default":"OUR HERITAGE"},
    {"type":"url","id":"cta_url_2","label":"Secondary URL"}
  ],
  "presets":[{"name":"LW Hero"}]
}
{% endschema %}
