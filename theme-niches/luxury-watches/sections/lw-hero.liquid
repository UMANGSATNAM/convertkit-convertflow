<div style="background:#0A0A0A; position:relative; min-height:90vh; display:flex; align-items:center; overflow:hidden;">
  
  <!-- Background Image with Overlay -->
  <div style="position:absolute; inset:0; z-index:1;">
    <img src="https://images.unsplash.com/photo-1523170335258-f5ed11844a49?auto=format&fit=crop&w=2000&q=80" alt="Luxury Watch" style="width:100%; height:100%; object-fit:cover; object-position:center; filter:brightness(0.6);" loading="eager">
    <div style="position:absolute; inset:0; background:linear-gradient(to right, rgba(10,10,10,0.9) 0%, rgba(10,10,10,0.4) 100%);"></div>
  </div>

  <div style="max-width:1440px; margin:0 auto; width:100%; padding:0 40px; position:relative; z-index:2;">
    <div style="max-width:700px;">
      
      <div style="display:inline-block; font-family:'Montserrat', sans-serif; font-size:12px; font-weight:600; letter-spacing:4px; text-transform:uppercase; color:#D4AF37; margin-bottom:24px; position:relative; padding-left:40px;">
        <span style="position:absolute; left:0; top:50%; transform:translateY(-50%); width:24px; height:1px; background:#D4AF37;"></span>
        {{ section.settings.eyebrow }}
      </div>
      
      <h1 style="font-family:'Cinzel', serif; font-size:clamp(48px, 6vw, 80px); font-weight:400; line-height:1.1; color:#FFFFFF; margin:0 0 32px 0; text-transform:uppercase; letter-spacing:2px;">
        {{ section.settings.heading }}
      </h1>
      
      <p style="font-family:'Montserrat', sans-serif; font-size:16px; font-weight:300; line-height:1.8; color:#CCCCCC; margin:0 0 48px 0; letter-spacing:0.5px;">
        {{ section.settings.subheading }}
      </p>
      
      <div style="display:flex; gap:24px; align-items:center; flex-wrap:wrap;">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-block; font-family:'Montserrat', sans-serif; font-size:12px; font-weight:500; letter-spacing:3px; text-transform:uppercase; color:#0A0A0A; background:#D4AF37; padding:20px 48px; text-decoration:none; transition:all 0.4s ease; border:1px solid #D4AF37;" class="lw-btn-primary">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
        
        <a href="#discover" style="display:inline-flex; align-items:center; gap:12px; font-family:'Montserrat', sans-serif; font-size:12px; font-weight:500; letter-spacing:3px; text-transform:uppercase; color:#FFFFFF; text-decoration:none; transition:color 0.4s ease;" class="lw-link-hover">
          <span style="width:40px; height:40px; border-radius:50%; border:1px solid rgba(255,255,255,0.3); display:flex; align-items:center; justify-content:center; transition:border-color 0.4s ease;" class="lw-play-circle">
            <svg style="width:12px; height:12px; fill:#FFFFFF;" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </span>
          Watch Film
        </a>
      </div>
      
    </div>
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Montserrat:wght@300;400;500;600&display=swap');
    
    .lw-btn-primary:hover { background: transparent; color: #D4AF37; }
    .lw-link-hover:hover { color: #D4AF37; }
    .lw-link-hover:hover .lw-play-circle { border-color: #D4AF37; }
    .lw-link-hover:hover svg { fill: #D4AF37; }
    
    @media (max-width: 768px) {
      div[style*="max-width:700px"] { text-align: center; margin: 0 auto; }
      div[style*="padding-left:40px"] { padding-left: 0; }
      span[style*="position:absolute; left:0"] { display: none; }
      div[style*="display:flex; gap:24px"] { justify-content: center; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Luxury Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE NEW COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mastery of Time."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Precision engineering meets timeless elegance. Discover timepieces forged for eternity."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "EXPLORE THE COLLECTION"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Luxury Hero"
    }
  ]
}
{% endschema %}
