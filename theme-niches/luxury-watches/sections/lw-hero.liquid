<div style="background:var(--lw-bg);min-height:95vh;display:flex;align-items:center;position:relative;border-bottom:1px solid var(--lw-border)">
  
  <div style="width:50%;height:100%;position:absolute;top:0;right:0;border-left:1px solid var(--lw-border)">
    <!-- Faint grid background -->
    <div style="width:100%;height:100%;background-image:linear-gradient(var(--lw-border) 1px, transparent 1px), linear-gradient(90deg, var(--lw-border) 1px, transparent 1px);background-size:40px 40px;opacity:0.2"></div>
  </div>

  <div style="max-width:1400px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;align-items:center;position:relative;z-index:2">
    
    <div style="padding:80px 60px">
      <div class="lw-spec" style="margin-bottom:32px;color:var(--lw-accent)">{{ section.settings.overline | default: 'REF. 5204R-011' }}</div>
      <h1 class="lw-head" style="font-size:clamp(50px, 6vw, 84px);line-height:1.1;margin-bottom:32px">
        {{ section.settings.heading | default: 'Time,<br>Mastered.' }}
      </h1>
      <div class="lw-divider" style="margin-bottom:40px"></div>
      <p style="font-size:14px;line-height:1.8;color:var(--lw-muted);margin-bottom:48px;max-width:440px">
        {{ section.settings.text | default: 'A masterpiece of grand complications. Featuring a split-seconds chronograph and perpetual calendar.' }}
      </p>
      <div style="display:flex;gap:24px">
        <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="lw-btn">{{ section.settings.btn1_text | default: 'Discover the Collection' }}</a>
      </div>
    </div>
    
    <div style="position:relative;height:80vh;display:flex;align-items:center;justify-content:center">
      <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/watch-hero.png?v=1717283400" alt="Luxury Watch" style="width:auto;height:90%;max-width:100%;object-fit:contain;filter:drop-shadow(0 40px 60px rgba(0,0,0,0.8))">
      
      <!-- Tech specs overlay -->
      <div style="position:absolute;top:20%;right:40px;text-align:right">
        <div class="lw-spec" style="margin-bottom:4px">CALIBER</div>
        <div class="lw-head" style="font-size:24px;color:var(--lw-accent)">CHR 29-535 PS Q</div>
      </div>
      <div style="position:absolute;bottom:20%;left:40px">
        <div class="lw-spec" style="margin-bottom:4px">POWER RESERVE</div>
        <div class="lw-head" style="font-size:24px;color:var(--lw-accent)">Min. 55 hrs</div>
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Horology Hero",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline Text",
      "default": "REF. 5204R-011"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Time,<br>Mastered."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "A masterpiece of grand complications."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button Text",
      "default": "Discover the Collection"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Horology Hero"
    }
  ]
}
{% endschema %}
