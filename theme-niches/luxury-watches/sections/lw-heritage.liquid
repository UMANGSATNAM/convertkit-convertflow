<div class="lw-heritage">
  <div class="lw-heritage__grid">
    <div>
      <p class="lw-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,4vw,48px);font-weight:300;color:var(--lw-ivory);margin-bottom:20px;line-height:1.15">{{ section.settings.heading }}</h2>
      <p style="font-size:16px;color:rgba(248,246,242,0.5);line-height:1.8;max-width:440px">{{ section.settings.body }}</p>
      <div class="lw-stat-grid">
        {%- for block in section.blocks -%}
        <div class="lw-stat" {{ block.shopify_attributes }}>
          <div class="lw-stat__num">{{ block.settings.number }}</div>
          <div class="lw-stat__label">{{ block.settings.label }}</div>
        </div>
        {%- endfor -%}
      </div>
    </div>
    <div>
      {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;object-fit:cover" loading="lazy">
      {%- else -%}
      <div style="aspect-ratio:4/5;background:linear-gradient(135deg,#1A1D23,#0D1117);display:flex;align-items:center;justify-content:center">
        <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="rgba(196,154,108,0.15)" stroke-width="1"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "LW Heritage",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"CRAFTSMANSHIP"},
    {"type":"text","id":"heading","label":"Heading","default":"The Art of Mechanical Perfection"},
    {"type":"textarea","id":"body","label":"Body","default":"Each timepiece represents hundreds of hours of meticulous hand-assembly, where tradition meets innovation in every component."},
    {"type":"image_picker","id":"image","label":"Image"}
  ],
  "blocks": [{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"200+"},{"type":"text","id":"label","label":"Label","default":"Components per watch"}]}],
  "presets":[{"name":"LW Heritage","blocks":[{"type":"stat","settings":{"number":"200+","label":"Components"}},{"type":"stat","settings":{"number":"40hr","label":"Power Reserve"}},{"type":"stat","settings":{"number":"100m","label":"Water Resistant"}},{"type":"stat","settings":{"number":"5yr","label":"Warranty"}}]}]
}
{% endschema %}
