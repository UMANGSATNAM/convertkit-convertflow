<div style="background:#050505; padding:120px 40px; position:relative;">
  <div style="max-width:1440px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:100px; align-items:center;">
    
    <!-- Content -->
    <div style="padding-right:40px;">
      <h2 style="font-family:'Cinzel', serif; font-size:clamp(36px, 5vw, 64px); font-weight:400; line-height:1.1; color:#FFFFFF; margin:0 0 40px 0; letter-spacing:2px;">
        {{ section.settings.heading }}
      </h2>
      
      <div style="width:40px; height:1px; background:#D4AF37; margin-bottom:40px;"></div>
      
      <p style="font-family:'Montserrat', sans-serif; font-size:16px; font-weight:300; line-height:2; color:#AAAAAA; margin:0 0 48px 0; max-width:500px;">
        {{ section.settings.subheading }}
      </p>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/pages/heritage' }}" style="display:inline-block; font-family:'Montserrat', sans-serif; font-size:11px; font-weight:500; letter-spacing:3px; text-transform:uppercase; color:#D4AF37; text-decoration:none; position:relative; padding-bottom:8px;" class="lw-link-anim">
          {{ section.settings.cta_label }}
          <span style="position:absolute; bottom:0; left:0; width:100%; height:1px; background:rgba(212,175,55,0.3);"></span>
          <span style="position:absolute; bottom:0; left:0; width:0%; height:1px; background:#D4AF37; transition:width 0.4s ease;" class="lw-line"></span>
        </a>
      {%- endif -%}
    </div>
    
    <!-- Visual -->
    <div style="position:relative;">
      <!-- Subtle frame -->
      <div style="position:absolute; inset:-20px; border:1px solid rgba(212,175,55,0.15); z-index:1;"></div>
      
      <div style="position:relative; padding-bottom:130%; overflow:hidden; z-index:2; background:#111111;">
        <img src="https://images.unsplash.com/photo-1594534475808-b18fc33b045e?auto=format&fit=crop&w=1000&q=80" alt="Watchmaking Craft" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:grayscale(80%) contrast(1.2); transition:filter 0.8s ease;" class="lw-heritage-img" loading="lazy">
      </div>
      
      <!-- Overlapping detail image -->
      <div style="position:absolute; bottom:-40px; left:-60px; width:60%; padding-bottom:60%; z-index:3; border:10px solid #050505; overflow:hidden;">
        <img src="https://images.unsplash.com/photo-1622434641406-a158123450f9?auto=format&fit=crop&w=600&q=80" alt="Watch Movement" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:grayscale(30%);" loading="lazy">
      </div>
    </div>
    
  </div>

  <style>
    .lw-link-anim:hover .lw-line { width: 100%; }
    .lw-heritage-img:hover { filter: grayscale(0%) contrast(1); }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; gap: 80px; }
      div[style*="padding-right:40px"] { padding-right: 0; }
      div[style*="bottom:-40px; left:-60px"] { bottom: -20px; left: -20px; border-width: 5px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Luxury Heritage",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Legacy of Precision"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "For over a century, Aurelius has defined the pinnacle of haute horlogerie. Every component is meticulously crafted and assembled by hand in our Swiss atelier."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "OUR HERITAGE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Luxury Heritage"
    }
  ]
}
{% endschema %}
