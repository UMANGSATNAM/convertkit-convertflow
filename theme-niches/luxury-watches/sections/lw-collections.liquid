<div class="lw-collections">
  <div class="lw-section-header">
    <p class="lw-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="lw-col-grid">
    {%- for block in section.blocks -%}
    <a href="{{ block.settings.url | default: '/collections/all' }}" class="lw-col-card" style="text-decoration:none" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
      <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">
      {%- else -%}
      <div style="width:100%;height:100%;background:linear-gradient(135deg,#1A1D23,#0D1117)"></div>
      {%- endif -%}
      <div class="lw-col-card__overlay">
        <span class="lw-col-card__title">{{ block.settings.title }}</span>
        <span class="lw-col-card__cta">Discover →</span>
      </div>
    </a>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "LW Collections",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"COLLECTIONS"},
    {"type":"text","id":"heading","label":"Heading","default":"Curated Categories"}
  ],
  "blocks": [{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Dress Watches"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],
  "presets":[{"name":"LW Collections","blocks":[{"type":"col","settings":{"title":"Dress Watches"}},{"type":"col","settings":{"title":"Chronographs"}},{"type":"col","settings":{"title":"Dive Watches"}}]}]
}
{% endschema %}
