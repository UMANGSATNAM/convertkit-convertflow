<div class="lw-products">
  <div class="lw-section-header">
    <p class="lw-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>
  {%- assign col = collections[section.settings.collection] -%}
  <div class="lw-prod-grid">
    {%- for product in col.products limit: section.settings.count -%}
    <a href="{{ product.url }}" class="lw-prod-card">
      <div class="lw-prod-card__img">
        {%- if product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">
        {%- else -%}
        <div style="width:100%;height:100%;background:var(--lw-charcoal);display:flex;align-items:center;justify-content:center">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(196,154,108,0.2)" stroke-width="1"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        {%- endif -%}
      </div>
      <div class="lw-prod-card__name">{{ product.title }}</div>
      <div class="lw-prod-card__price">{{ product.price | money }}</div>
      <div class="lw-prod-card__meta">{{ product.type }}</div>
    </a>
    {%- endfor -%}
  </div>
  <div style="text-align:center;margin-top:48px">
    <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="lw-btn">{{ section.settings.cta_label }}</a>
  </div>
</div>
{% schema %}
{
  "name": "LW Featured",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"NEW ARRIVALS"},
    {"type":"text","id":"heading","label":"Heading","default":"Latest Timepieces"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Precision-crafted, freshly released"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"count","label":"Products","min":4,"max":12,"step":4,"default":8},
    {"type":"text","id":"cta_label","label":"CTA","default":"VIEW FULL COLLECTION"},
    {"type":"url","id":"cta_url","label":"CTA URL"}
  ],
  "presets":[{"name":"LW Featured"}]
}
{% endschema %}
