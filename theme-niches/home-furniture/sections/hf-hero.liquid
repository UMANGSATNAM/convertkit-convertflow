<div class="hf-hero">
  <div class="hf-hero__content">
    <span class="hf-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="hf-hero__title">{{ section.settings.heading }}</h1>
    <p class="hf-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="hf-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/craftsmanship' }}" class="hf-btn hf-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="hf-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--hf-walnut)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Furniture Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"MID-CENTURY MODERN SOLID WOODEN DESIGN"},{"type":"text","id":"heading","label":"Architectural Heritage Furniture."},{"type":"textarea","id":"subheading","label":"Subheading","default":"Hand-assembled from sustainable FSC-certified solid walnut. Designed with clean architectural silhouettes that define premium living spaces."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"EXPLORE SILHOUETTES"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"OUR CRAFT"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Furniture Hero"}]}
{% endschema %}
