<div style="background:#F7F5F0; position:relative; min-height:90vh; display:flex; align-items:center;">
  
  <div style="position:absolute; inset:0; z-index:1;">
    <img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2000&q=80" alt="High-end furniture interior" style="width:100%; height:100%; object-fit:cover;" loading="eager">
    <!-- Subtle gradient overlay for text legibility -->
    <div style="position:absolute; inset:0; background:linear-gradient(to right, rgba(247,245,240,0.9) 0%, rgba(247,245,240,0.4) 50%, rgba(247,245,240,0) 100%);"></div>
  </div>

  <div style="max-width:1440px; margin:0 auto; width:100%; padding:0 40px; position:relative; z-index:2;">
    <div style="max-width:600px;">
      
      <div style="font-family:'Inter', sans-serif; font-size:12px; font-weight:500; letter-spacing:3px; text-transform:uppercase; color:#B89B72; margin-bottom:24px;">
        HAVEN EXCLUSIVE
      </div>

      <h1 style="font-family:'Playfair Display', serif; font-size:clamp(48px, 6vw, 80px); font-weight:400; line-height:1.1; color:#2C2C2C; margin:0 0 24px 0; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h1>
      
      <p style="font-family:'Inter', sans-serif; font-size:clamp(16px, 2vw, 18px); font-weight:300; color:#4A4A4A; line-height:1.6; margin:0 0 48px 0; max-width:480px;">
        {{ section.settings.subheading }}
      </p>

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#2C2C2C; color:#FFFFFF; font-family:'Inter', sans-serif; font-size:13px; font-weight:500; letter-spacing:2px; text-transform:uppercase; text-decoration:none; padding:18px 40px; transition:all 0.4s ease;" class="hf-btn-primary">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
      
    </div>
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap');
    
    .hf-btn-primary:hover { background: #B89B72; }
    
    @media (max-width: 768px) {
      .hf-btn-primary { width: 100%; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Haven Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Art of Living"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated pieces that transform your space into a sanctuary of modern elegance."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "EXPLORE COLLECTION"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Haven Hero"
    }
  ]
}
{% endschema %}
