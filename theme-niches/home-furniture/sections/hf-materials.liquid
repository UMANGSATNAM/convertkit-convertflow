<div style="background:#FFFFFF; padding:120px 40px; border-top:1px solid #F0F0F0;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Playfair Display', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#2C2C2C; margin:0 0 16px 0; letter-spacing:-0.5px;">
        {{ section.settings.heading }}
      </h2>
      <div style="width:40px; height:2px; background:#B89B72; margin:0 auto;"></div>
    </div>

    <div class="hf-materials-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:60px;">
      
      {%- for block in section.blocks -%}
        <div style="text-align:center;">
          <div style="width:100%; aspect-ratio:1/1; border-radius:50%; overflow:hidden; margin:0 auto 32px auto; max-width:300px;">
            {%- assign idx = forloop.index | modulo: 3 -%}
            {%- assign img_url = 'https://images.unsplash.com/photo-1599696848652-f0ff23bc911f?auto=format&fit=crop&w=600&q=80' -%}
            {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1599696848652-f0ff23bc911f?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1582647509711-c8aa8a8b54fb?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1528699633788-424224dc89b5?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
            
            <img src="{{ img_url }}" alt="{{ block.settings.title }}" style="width:100%; height:100%; object-fit:cover;" loading="lazy">
          </div>
          
          <h3 style="font-family:'Playfair Display', serif; font-size:24px; font-weight:400; color:#2C2C2C; margin:0 0 16px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Inter', sans-serif; font-size:15px; font-weight:300; color:#4A4A4A; line-height:1.6; margin:0; max-width:280px; margin:0 auto;">
            {{ block.settings.desc }}
          </p>
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    @media (max-width: 990px) {
      .hf-materials-grid { grid-template-columns: 1fr; gap: 60px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Haven Materials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Exceptional Materials"
    }
  ],
  "blocks": [
    {
      "type": "material",
      "name": "Material",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Solid Oak"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Sustainably harvested and kiln-dried."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Haven Materials",
      "blocks": [
        { "type": "material" },
        { "type": "material" },
        { "type": "material" }
      ]
    }
  ]
}
{% endschema %}
