<div style="background:#FFFFFF; padding:120px 40px; position:relative;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div class="hf-image-text-grid {% if section.settings.image_pos == 'right' %}reverse{% endif %}" style="display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
      
      <!-- Visual -->
      <div class="hf-it-visual" style="position:relative;">
        <div style="position:relative; padding-bottom:120%; overflow:hidden;">
          <img src="https://images.unsplash.com/photo-1540574163026-643ea20d56b8?auto=format&fit=crop&w=1000&q=80" alt="Craftsmanship" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;" loading="lazy">
        </div>
        <!-- Decorative subtle element -->
        <div style="position:absolute; bottom:-40px; right:-40px; width:200px; height:200px; border:1px solid #E5E5E5; z-index:-1;"></div>
      </div>
      
      <!-- Content -->
      <div class="hf-it-content" style="padding:0 40px;">
        <h2 style="font-family:'Playfair Display', serif; font-size:clamp(36px, 4vw, 56px); font-weight:400; color:#2C2C2C; margin:0 0 32px 0; letter-spacing:-0.5px; line-height:1.2;">
          {{ section.settings.heading }}
        </h2>
        
        <p style="font-family:'Inter', sans-serif; font-size:16px; font-weight:300; color:#4A4A4A; line-height:1.8; margin:0 0 48px 0;">
          {{ section.settings.text }}
        </p>
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/pages/about' }}" style="display:inline-block; font-family:'Inter', sans-serif; font-size:12px; font-weight:500; color:#2C2C2C; text-decoration:none; text-transform:uppercase; letter-spacing:2px; padding-bottom:4px; border-bottom:1px solid #B89B72; transition:all 0.3s ease;" class="hf-link-hover">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
      
    </div>
  </div>

  <style>
    .hf-image-text-grid.reverse .hf-it-visual { order: 2; }
    .hf-image-text-grid.reverse .hf-it-content { order: 1; }
    .hf-link-hover:hover { color: #B89B72; padding-bottom: 2px; }
    
    @media (max-width: 990px) {
      .hf-image-text-grid { grid-template-columns: 1fr; gap: 60px; }
      .hf-image-text-grid.reverse .hf-it-visual { order: 1; }
      .hf-image-text-grid.reverse .hf-it-content { order: 2; }
      .hf-it-content { padding: 0 !important; text-align: center; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Haven Image w/ Text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Masterful Craftsmanship"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Every Haven piece is born from a deep respect for natural materials..."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "OUR STORY"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "image_pos",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Haven Image w/ Text"
    }
  ]
}
{% endschema %}
