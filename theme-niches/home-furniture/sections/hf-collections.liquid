<div style="padding:80px 20px;background:var(--hf-beige);border-bottom:1px solid var(--hf-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="hf-section-header"><span class="hf-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="hf-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="hf-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--hf-walnut)"></div>{%- endif -%}<div class="hf-col-card__overlay"><span class="hf-col-card__title">{{ block.settings.title }}</span><span class="hf-col-card__cta">Explore Collection →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Furniture Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CRAFTED SILHOUETTES"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Living Space Category"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Walnut Dining"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Furniture Collections","blocks":[{"type":"col","settings":{"title":"Walnut Dining"}},{"type":"col","settings":{"title":"Linen Lounge"}},{"type":"col","settings":{"title":"Brass Accents"}}]}]}
{% endschema %}
