<div style="background:#F7F5F0; padding:120px 40px;">
  <div style="max-width:1000px; margin:0 auto; text-align:center;">
    
    <div style="margin-bottom:80px;">
      <h2 style="font-family:'Playfair Display', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#2C2C2C; margin:0 0 16px 0; letter-spacing:-0.5px;">
        {{ section.settings.heading }}
      </h2>
      <div style="width:40px; height:2px; background:#B89B72; margin:0 auto;"></div>
    </div>

    <div class="hf-testimonials-container" style="position:relative;">
      
      <!-- Quotes icon -->
      <div style="font-family:'Playfair Display', serif; font-size:120px; color:#B89B72; opacity:0.2; line-height:0; position:absolute; top:20px; left:50%; transform:translateX(-50%); z-index:1;">"</div>
      
      <div style="position:relative; z-index:2; display:flex; gap:60px; overflow-x:auto; padding-bottom:40px; scroll-snap-type:x mandatory; scrollbar-width:none;" class="hf-test-scroll">
        
        {%- for block in section.blocks -%}
          <div style="min-width:100%; scroll-snap-align:center;">
            <p style="font-family:'Playfair Display', serif; font-size:clamp(20px, 3vw, 32px); font-weight:400; line-height:1.6; color:#2C2C2C; margin:0 0 32px 0; font-style:italic;">
              {{ block.settings.quote }}
            </p>
            <div style="font-family:'Inter', sans-serif; font-size:14px; font-weight:500; color:#888888; text-transform:uppercase; letter-spacing:2px;">
              — {{ block.settings.author }}
            </div>
          </div>
        {%- else -%}
          <!-- Fallback -->
        {%- endfor -%}
        
      </div>
      
      <!-- Simple dots navigation indication -->
      <div style="display:flex; justify-content:center; gap:8px;">
        {%- for block in section.blocks -%}
          <div style="width:8px; height:8px; border-radius:50%; background:{% if forloop.first %}#2C2C2C{% else %}rgba(44,44,44,0.2){% endif %};"></div>
        {%- endfor -%}
      </div>
      
    </div>
  </div>

  <style>
    .hf-test-scroll::-webkit-scrollbar { display: none; }
  </style>
</div>

{% schema %}
{
  "name": "Haven Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Words from our Clients"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The sofa is an absolute masterpiece. It changed the entire feeling of our living room."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Jonathan D."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Haven Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
