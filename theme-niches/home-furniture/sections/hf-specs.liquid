<div style="padding:80px 20px;background:#282828;border-bottom:1px solid var(--hf-border)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="hf-eyebrow" style="color:var(--hf-brass)">ARCHITECTURAL RATINGS</span>
    <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,4vw,48px);font-weight:500;color:var(--hf-white);margin-bottom:20px;line-height:1.1;letter-spacing:-0.01em">{{ section.settings.heading }}</h2>
    <p style="font-family:'Outfit',sans-serif;font-size:15px;color:var(--hf-beige);line-height:1.7;max-width:440px;font-weight:500;opacity:0.8">{{ section.settings.body }}</p>
    <div class="hf-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="hf-stat" style="border-color:var(--hf-walnut);background:rgba(124,92,67,0.1)" {{ block.shopify_attributes }}><div class="hf-stat__num" style="color:var(--hf-brass)">{{ block.settings.number }}</div><div class="hf-stat__label" style="color:var(--hf-white)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:0px;border:1px solid var(--hf-walnut);object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:1.1;background:rgba(255,255,255,0.02)"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Furniture Specs","settings":[{"type":"text","id":"eyebrow","label":"CRAFTED DETAILS"},{"type":"text","id":"heading","label":"Heading","default":"Mortise & Tenon Joinery."},{"type":"textarea","id":"body","label":"Body","default":"Every solid walnut frame features high-precision mortise & tenon joinery, creating maximum structural stability without unsightly metal screws."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"0%"},{"type":"text","id":"label","label":"Label","default":"Chemicals"}]}],"presets":[{"name":"Furniture Specs","blocks":[{"type":"stat","settings":{"number":"100%","label":"FSC Walnut"}},{"type":"stat","settings":{"number":"Mortise","label":"Joinery"}},{"type":"stat","settings":{"number":"350 Lbs","label":"Weight Capacity"}},{"type":"stat","settings":{"number":"Waxed","label":"Natural Finish"}}]}]}
{% endschema %}
