<div style="background:#F7F5F0; padding:120px 0;">
  
  <div style="max-width:1440px; margin:0 auto; padding:0 40px; text-align:center; margin-bottom:60px;">
    <div style="font-family:'Inter', sans-serif; font-size:12px; font-weight:500; letter-spacing:3px; text-transform:uppercase; color:#B89B72; margin-bottom:16px;">
      LOOKBOOK
    </div>
    <h2 style="font-family:'Playfair Display', serif; font-size:clamp(36px, 4vw, 56px); font-weight:400; color:#2C2C2C; margin:0 0 16px 0; letter-spacing:-0.5px;">
      {{ section.settings.heading }}
    </h2>
    <p style="font-family:'Inter', sans-serif; font-size:16px; font-weight:300; color:#4A4A4A; margin:0;">
      {{ section.settings.subheading }}
    </p>
  </div>

  <div style="position:relative; width:100%; height:80vh; min-height:600px;">
    <img src="https://images.unsplash.com/photo-1618220179428-22790b46a0eb?auto=format&fit=crop&w=2000&q=80" alt="Lookbook" style="width:100%; height:100%; object-fit:cover;" loading="lazy">
    
    <!-- Hotspots -->
    <div style="position:absolute; top:40%; left:30%;" class="hf-hotspot group">
      <div style="width:24px; height:24px; background:#FFFFFF; border-radius:50%; box-shadow:0 0 0 6px rgba(255,255,255,0.3); display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all 0.3s ease;" class="hf-hotspot-dot">
        <div style="width:8px; height:8px; background:#2C2C2C; border-radius:50%;"></div>
      </div>
      <!-- Tooltip -->
      <div style="position:absolute; top:-10px; left:40px; background:#FFFFFF; padding:16px; width:200px; opacity:0; visibility:hidden; transform:translateX(-10px); transition:all 0.3s ease; box-shadow:0 10px 30px rgba(0,0,0,0.1);" class="hf-hotspot-tooltip">
        <div style="font-family:'Inter', sans-serif; font-size:11px; font-weight:400; color:#888888; margin-bottom:4px; text-transform:uppercase; letter-spacing:1px;">Seating</div>
        <div style="font-family:'Playfair Display', serif; font-size:16px; font-weight:400; color:#2C2C2C; margin-bottom:8px;">Linen Lounge Chair</div>
        <div style="font-family:'Inter', sans-serif; font-size:13px; font-weight:300; color:#4A4A4A; margin-bottom:12px;">$1,200</div>
        <a href="#" style="font-family:'Inter', sans-serif; font-size:11px; font-weight:500; color:#2C2C2C; text-decoration:none; text-transform:uppercase; letter-spacing:1px; border-bottom:1px solid #2C2C2C; padding-bottom:2px;">Shop Now</a>
      </div>
    </div>
    
    <div style="position:absolute; top:60%; left:65%;" class="hf-hotspot group">
      <div style="width:24px; height:24px; background:#FFFFFF; border-radius:50%; box-shadow:0 0 0 6px rgba(255,255,255,0.3); display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all 0.3s ease;" class="hf-hotspot-dot">
        <div style="width:8px; height:8px; background:#2C2C2C; border-radius:50%;"></div>
      </div>
      <!-- Tooltip -->
      <div style="position:absolute; top:-10px; left:40px; background:#FFFFFF; padding:16px; width:200px; opacity:0; visibility:hidden; transform:translateX(-10px); transition:all 0.3s ease; box-shadow:0 10px 30px rgba(0,0,0,0.1);" class="hf-hotspot-tooltip">
        <div style="font-family:'Inter', sans-serif; font-size:11px; font-weight:400; color:#888888; margin-bottom:4px; text-transform:uppercase; letter-spacing:1px;">Tables</div>
        <div style="font-family:'Playfair Display', serif; font-size:16px; font-weight:400; color:#2C2C2C; margin-bottom:8px;">Travertine Coffee Table</div>
        <div style="font-family:'Inter', sans-serif; font-size:13px; font-weight:300; color:#4A4A4A; margin-bottom:12px;">$850</div>
        <a href="#" style="font-family:'Inter', sans-serif; font-size:11px; font-weight:500; color:#2C2C2C; text-decoration:none; text-transform:uppercase; letter-spacing:1px; border-bottom:1px solid #2C2C2C; padding-bottom:2px;">Shop Now</a>
      </div>
    </div>
  </div>

  <style>
    .hf-hotspot:hover .hf-hotspot-tooltip { opacity: 1; visibility: visible; transform: translateX(0); }
    .hf-hotspot:hover .hf-hotspot-dot { box-shadow: 0 0 0 8px rgba(255,255,255,0.5); }
    
    @media (max-width: 768px) {
      .hf-hotspot-tooltip { display: none; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Haven Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Neutral Sanctuary"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "A study in texture and tone."
    }
  ],
  "presets": [
    {
      "name": "Haven Lookbook"
    }
  ]
}
{% endschema %}
