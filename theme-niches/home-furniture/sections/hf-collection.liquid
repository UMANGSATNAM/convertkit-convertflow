<div style="background:#F7F5F0; padding:120px 40px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:80px;">
      <div>
        <h2 style="font-family:'Playfair Display', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#2C2C2C; margin:0 0 16px 0; letter-spacing:-0.5px;">
          {{ section.settings.heading }}
        </h2>
        <div style="width:40px; height:2px; background:#B89B72;"></div>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Inter', sans-serif; font-size:12px; font-weight:500; color:#2C2C2C; text-decoration:none; text-transform:uppercase; letter-spacing:2px; padding-bottom:4px; border-bottom:1px solid #B89B72; transition:all 0.3s ease;" class="hf-link-hover">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="hf-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:40px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1567016432779-094069958ea5?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1505693314120-0d443867891c?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1540574163026-643ea20d56b8?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1583847268964-b28e503d9e84?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="hf-product-card" style="group">
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:120%; margin-bottom:24px; background:#FFFFFF;">
            <img src="{{ img_url }}" alt="Furniture" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.8s ease;" class="hf-product-img" loading="lazy">
            
            <div style="position:absolute; bottom:0; left:0; width:100%; padding:20px; display:flex; justify-content:center; opacity:0; transform:translateY(10px); transition:all 0.4s ease;" class="hf-product-action">
              <span style="background:#FFFFFF; color:#2C2C2C; font-family:'Inter', sans-serif; font-size:11px; font-weight:500; letter-spacing:1px; text-transform:uppercase; padding:12px 24px; box-shadow:0 4px 10px rgba(0,0,0,0.05);">
                Quick View
              </span>
            </div>
          </a>
          
          <div style="text-align:center;">
            <div style="font-family:'Inter', sans-serif; font-size:11px; font-weight:400; color:#888888; margin-bottom:8px; text-transform:uppercase; letter-spacing:1px;">
              {% if idx == 1 %}Seating{% elsif idx == 2 %}Tables{% elsif idx == 3 %}Storage{% else %}Lighting{% endif %}
            </div>
            <h3 style="font-family:'Playfair Display', serif; font-size:18px; font-weight:400; color:#2C2C2C; margin:0 0 8px 0;">
              {% if idx == 1 %}The Monaco Sofa{% elsif idx == 2 %}Oak Dining Table{% elsif idx == 3 %}Walnut Sideboard{% else %}Brass Pendant{% endif %}
            </h3>
            <div style="font-family:'Inter', sans-serif; font-size:14px; font-weight:300; color:#4A4A4A;">
              {% if idx == 1 %}$3,200{% elsif idx == 2 %}$1,850{% elsif idx == 3 %}$2,400{% else %}$450{% endif %}
            </div>
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .hf-product-card:hover .hf-product-img { transform: scale(1.05); }
    .hf-product-card:hover .hf-product-action { opacity: 1; transform: translateY(0); }
    .hf-link-hover:hover { color: #B89B72; padding-bottom: 2px; }
    
    @media (max-width: 1024px) {
      .hf-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px 20px !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Haven Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Signature Pieces"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Haven Collection"
    }
  ]
}
{% endschema %}
