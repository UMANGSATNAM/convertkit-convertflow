<div style="padding:60px 20px 0;background:var(--hf-beige)"><div style="max-width:1320px;margin:0 auto;text-align:center;padding-bottom:56px;border-bottom:1px solid var(--hf-border)"><span class="hf-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</span><h1 style="font-family:'Cormorant Garamond',serif;font-size:clamp(32px,5vw,52px);font-weight:600;color:var(--hf-dark);margin-bottom:12px;letter-spacing:-0.01em">{{ collection.title }}</h1>{%- if collection.description != blank -%}<p style="font-family:'Outfit',sans-serif;font-size:15px;color:var(--hf-muted);max-width:560px;margin:0 auto;font-weight:500;line-height:1.7">{{ collection.description }}</p>{%- endif -%}</div></div>
<div style="padding:0 20px 100px;background:var(--hf-beige)"><div style="max-width:1320px;margin:0 auto"><div style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid var(--hf-border);margin-bottom:40px"><div style="font-family:'Outfit',sans-serif;font-size:13px;font-weight:800;color:var(--hf-dark);text-transform:uppercase">{{ collection.products_count }} silhouettes</div><select style="padding:10px 20px;border:1px solid var(--hf-border);border-radius:0px;background:#fff;color:var(--hf-dark);font-family:'Outfit',sans-serif;font-size:12px;font-weight:800;cursor:pointer"><option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Newest</option></select></div><div class="hf-prod-grid">{%- for product in collection.products -%}<a href="{{ product.url }}" class="hf-prod-card"><div class="hf-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--hf-beige)"></div>{%- endif -%}</div><div class="hf-prod-card__name">{{ product.title }}</div><div class="hf-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div></div></div>
{% schema %}
{"name":"Furniture Collection","settings":[],"presets":[{"name":"Furniture Collection"}]}
{% endschema %}
