<div style="background:#FFFFFF; padding:120px 40px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Playfair Display', serif; font-size:clamp(32px, 4vw, 48px); font-weight:400; color:#2C2C2C; margin:0 0 16px 0; letter-spacing:-0.5px;">
        {{ section.settings.heading }}
      </h2>
      <div style="width:40px; height:2px; background:#B89B72; margin:0 auto;"></div>
    </div>

    <div class="hf-cat-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:30px;">
      
      {%- for block in section.blocks -%}
        <a href="#" class="hf-cat-card" style="display:block; text-decoration:none; position:relative; overflow:hidden; group">
          <div style="position:relative; padding-bottom:120%;">
            <img src="{{ block.settings.image }}" alt="{{ block.settings.title }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.8s ease;" class="hf-cat-img" loading="lazy">
            <div style="position:absolute; inset:0; background:rgba(0,0,0,0.2); transition:background 0.4s ease;" class="hf-cat-overlay"></div>
          </div>
          <div style="position:absolute; bottom:30px; left:30px; right:30px; text-align:center;">
            <h3 style="font-family:'Inter', sans-serif; font-size:14px; font-weight:500; letter-spacing:2px; text-transform:uppercase; color:#FFFFFF; margin:0;">
              {{ block.settings.title }}
            </h3>
          </div>
        </a>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .hf-cat-card:hover .hf-cat-img { transform: scale(1.05); }
    .hf-cat-card:hover .hf-cat-overlay { background: rgba(0,0,0,0.4); }
    
    @media (max-width: 1024px) {
      .hf-cat-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    }
    @media (max-width: 640px) {
      .hf-cat-grid { grid-template-columns: 1fr; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Haven Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Room"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Living Room"
        },
        {
          "type": "url",
          "id": "image",
          "label": "Image URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Haven Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
