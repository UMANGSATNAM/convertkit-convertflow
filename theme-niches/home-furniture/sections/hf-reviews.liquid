<div style="padding:80px 20px;background:#F6F3EE;border-bottom:1px solid var(--hf-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="hf-section-header"><span class="hf-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="hf-review-grid">{%- for block in section.blocks -%}<div class="hf-review-card" {{ block.shopify_attributes }}><div class="hf-review-card__stars">★★★★★</div><div class="hf-review-card__text">"{{ block.settings.quote }}"</div><div class="hf-review-card__author">{{ block.settings.name }}</div><div class="hf-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Furniture Reviews","settings":[{"type":"text","id":"eyebrow","label":"CLIENT FEEDBACK"},{"type":"text","id":"heading","label":"Heading","default":"Stories from Living Spaces"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Furniture Reviews","blocks":[{"type":"review","settings":{"quote":"The dining table is a true piece of architectural art. The walnut grain is rich and the joinery is absolutely flawless.","name":"Devendra S.","product":"Solid Walnut Dining Table"}},{"type":"review","settings":{"quote":"Linen lounge chair is exceptionally comfortable. Perfect depth, beautiful brass tip legs, and gorgeous minimal style.","name":"Nisha R.","product":"Linen Lounge Accent Chair"}},{"type":"review","settings":{"quote":"Beautiful mid-century credentials. Sturdy, elegant, and looks like a custom designer piece in our entry hallway.","name":"Vikram M.","product":"Walnut Credenza Console"}}]}]}
{% endschema %}
