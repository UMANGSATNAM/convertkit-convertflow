<div style="background:#F0FFF0; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px; flex-wrap:wrap; gap:24px;">
      <div>
        <h2 style="font-family:'Cormorant Garamond', serif; font-size:clamp(36px, 5vw, 48px); font-weight:400; color:#2F4F4F; margin:0 0 16px 0;">
          {{ section.settings.heading }}
        </h2>
        <div style="width:40px; height:1px; background:#8FBC8F;"></div>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Montserrat', sans-serif; font-size:12px; font-weight:500; color:#2F4F4F; text-decoration:none; display:flex; align-items:center; gap:8px; text-transform:uppercase; letter-spacing:2px; padding-bottom:4px; border-bottom:1px solid #2F4F4F; transition:opacity 0.3s ease;" class="bc-link-btn">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="bc-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:40px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1599305090598-fe179d501227?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1608248593842-8021c618e192?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1556228578-0d85b1a4d571?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1629198688000-71f23e745b6e?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="bc-product-card" style="background:#FFFFFF; padding:24px; transition:all 0.4s ease; position:relative; display:flex; flex-direction:column; height:100%;">
          
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:120%; background:#F9F9F9; margin-bottom:24px;">
            <img src="{{ img_url }}" alt="Skincare Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.8s ease;" class="bc-product-img" loading="lazy">
            
            <!-- Quick add overlay -->
            <div style="position:absolute; bottom:0; left:0; width:100%; padding:16px; transform:translateY(100%); transition:transform 0.4s ease;" class="bc-quick-add">
              <button style="width:100%; background:#2F4F4F; color:#FFFFFF; border:none; font-family:'Montserrat', sans-serif; font-size:12px; font-weight:500; text-transform:uppercase; letter-spacing:2px; padding:12px; cursor:pointer;">
                Quick Add
              </button>
            </div>
          </a>
          
          <div style="display:flex; flex-direction:column; flex-grow:1; text-align:center;">
            
            <h3 style="font-family:'Cormorant Garamond', serif; font-size:22px; font-weight:400; color:#2F4F4F; margin:0 0 8px 0;">
              {% if idx == 1 %}The Dew Drops Serum{% elsif idx == 2 %}Botanical Cleanser{% elsif idx == 3 %}Rosewater Mist{% else %}Squalane Moisturizer{% endif %}
            </h3>
            
            <div style="font-family:'Montserrat', sans-serif; font-size:12px; font-weight:300; color:#2F4F4F; opacity:0.6; margin-bottom:16px;">
              {% if idx == 1 %}Hydrating & Plumping{% elsif idx == 2 %}Gentle Purification{% elsif idx == 3 %}Refreshing Toner{% else %}Deep Nourishment{% endif %}
            </div>
            
            <div style="font-family:'Montserrat', sans-serif; font-size:14px; font-weight:500; color:#2F4F4F; margin-top:auto;">
              {% if idx == 1 %}$48.00{% elsif idx == 2 %}$28.00{% elsif idx == 3 %}$24.00{% else %}$42.00{% endif %}
            </div>
            
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .bc-link-btn:hover { opacity: 0.6; }
    .bc-product-card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(47,79,79,0.05); }
    .bc-product-card:hover .bc-product-img { transform: scale(1.05); }
    .bc-product-card:hover .bc-quick-add { transform: translateY(0); }
    
    @media (max-width: 1024px) {
      .bc-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 40px 20px !important; }
    }
    @media (max-width: 640px) {
      .bc-product-grid { grid-template-columns: 1fr !important; }
      .bc-quick-add { transform: translateY(0) !important; position: static !important; padding: 0 !important; margin-top: 16px !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Beauty Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Essentials"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Beauty Collection"
    }
  ]
}
{% endschema %}
