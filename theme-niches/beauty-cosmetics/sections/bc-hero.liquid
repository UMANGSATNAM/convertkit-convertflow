<div style="background:#FFFFFF; position:relative; overflow:hidden;">
  
  <div style="max-width:1440px; margin:0 auto; min-height:90vh; display:grid; grid-template-columns:1fr 1fr; align-items:center;">
    
    <!-- Content -->
    <div style="padding:80px 40px 80px 80px; position:relative; z-index:2;">
      <div style="font-family:'Montserrat', sans-serif; font-size:12px; font-weight:500; text-transform:uppercase; letter-spacing:3px; color:#8FBC8F; margin-bottom:32px; display:flex; align-items:center; gap:16px;">
        <span style="width:30px; height:1px; background:#8FBC8F;"></span>
        {{ section.settings.eyebrow }}
      </div>
      
      <h1 style="font-family:'Cormorant Garamond', serif; font-size:clamp(48px, 6vw, 88px); font-weight:400; color:#2F4F4F; line-height:1.1; margin:0 0 32px 0;">
        {{ section.settings.heading }}
      </h1>
      
      <p style="font-family:'Montserrat', sans-serif; font-size:16px; font-weight:300; color:#2F4F4F; line-height:1.8; margin:0 0 48px 0; max-width:420px; opacity:0.8;">
        {{ section.settings.subheading }}
      </p>
      
      {%- if section.settings.cta_label != blank -%}
        <div style="display:flex; gap:32px; align-items:center;">
          <a href="{{ section.settings.cta_url | default: '/collections/skincare' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#2F4F4F; color:#FFFFFF; font-family:'Montserrat', sans-serif; font-size:13px; font-weight:500; text-transform:uppercase; letter-spacing:2px; padding:18px 48px; text-decoration:none; transition:all 0.4s ease;" class="bc-btn-primary">
            {{ section.settings.cta_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
    
    <!-- Visual -->
    <div style="position:relative; height:100%; width:100%; min-height:600px; display:flex; align-items:center; justify-content:center; background:#F0FFF0;">
      <!-- Soft circle -->
      <div style="position:absolute; width:80%; padding-bottom:80%; background:#E0F5E0; border-radius:50%; z-index:1;"></div>
      
      <div style="position:relative; z-index:2; width:70%; height:80%; border-radius:100px 100px 0 0; overflow:hidden; box-shadow:0 30px 60px rgba(47,79,79,0.08);">
        <img src="https://images.unsplash.com/photo-1596462502278-27bfdc403348?auto=format&fit=crop&w=800&q=80" alt="Clean Cosmetics" style="width:100%; height:100%; object-fit:cover;" loading="eager">
      </div>
      
      <!-- Minimalist badge -->
      <div style="position:absolute; bottom:20%; left:5%; background:#FFFFFF; padding:16px 24px; border-radius:0; box-shadow:0 15px 30px rgba(47,79,79,0.05); z-index:3; display:flex; align-items:center; gap:16px; border-left:2px solid #8FBC8F;">
        <div style="font-family:'Cormorant Garamond', serif; font-size:18px; font-style:italic; color:#2F4F4F;">Clean & Vegan</div>
      </div>
    </div>
    
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Montserrat:wght@300;400;500;600&display=swap');
    
    .bc-btn-primary:hover { background: #8FBC8F; color: #FFFFFF; }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; }
      div[style*="padding:80px 40px 80px 80px"] { padding: 60px 24px; text-align: center; }
      div[style*="display:flex; align-items:center; gap:16px"] { justify-content: center; }
      div[style*="justify-content:center; gap:32px"] { justify-content: center; }
      div[style*="max-width:420px"] { margin-left: auto; margin-right: auto; }
      div[style*="min-height:600px"] { min-height: 500px; padding: 40px 0; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Beauty Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NEW FORMULA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pure Radiance."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover skincare powered by nature and backed by science. For a healthy, luminous glow from within."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP SKINCARE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Beauty Hero"
    }
  ]
}
{% endschema %}
