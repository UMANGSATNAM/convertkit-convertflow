<div style="background:#FFFFFF; padding:120px 24px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Cormorant Garamond', serif; font-size:clamp(36px, 5vw, 48px); font-weight:400; color:#2F4F4F; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      <div style="width:40px; height:1px; background:#8FBC8F; margin:0 auto;"></div>
    </div>

    <div class="bc-ing-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:60px;">
      
      {%- for block in section.blocks -%}
        <div style="text-align:center; position:relative;" class="bc-ing-card">
          
          <div style="width:160px; height:160px; margin:0 auto 32px auto; position:relative; overflow:hidden; border-radius:50%; background:#F0FFF0; padding:10px; transition:transform 0.5s ease;" class="bc-ing-img-wrapper">
            {%- assign img_url = 'https://images.unsplash.com/photo-1556228578-0d85b1a4d571?auto=format&fit=crop&w=400&q=80' -%}
            {%- if forloop.index == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?auto=format&fit=crop&w=400&q=80' -%}{%- endif -%}
            {%- if forloop.index == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1596462502278-27bfdc403348?auto=format&fit=crop&w=400&q=80' -%}{%- endif -%}
            
            <img src="{{ img_url }}" alt="{{ block.settings.title }}" style="width:100%; height:100%; object-fit:cover; border-radius:50%;" loading="lazy">
          </div>
          
          <h3 style="font-family:'Montserrat', sans-serif; font-size:14px; font-weight:500; letter-spacing:2px; text-transform:uppercase; color:#2F4F4F; margin:0 0 16px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Cormorant Garamond', serif; font-size:20px; font-style:italic; line-height:1.4; color:#2F4F4F; margin:0 auto; max-width:280px; opacity:0.8;">
            {{ block.settings.desc }}
          </p>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .bc-ing-card:hover .bc-ing-img-wrapper { transform: scale(1.05); }
    
    @media (max-width: 990px) {
      .bc-ing-grid { grid-template-columns: 1fr; gap: 60px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Beauty Ingredients",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Powered by Nature"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Botanical Squalane"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Locks in weightless moisture."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beauty Ingredients",
      "blocks": [
        { "type": "ingredient" },
        { "type": "ingredient" },
        { "type": "ingredient" }
      ]
    }
  ]
}
{% endschema %}
