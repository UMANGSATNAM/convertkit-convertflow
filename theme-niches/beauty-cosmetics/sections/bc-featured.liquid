<div style="background:#FFFFFF; padding:120px 24px; position:relative; overflow:hidden;">
  <div style="max-width:1440px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
    
    <!-- Visual -->
    <div style="position:relative;">
      <!-- Soft circle behind image -->
      <div style="position:absolute; top:-10%; left:-10%; width:80%; padding-bottom:80%; background:#F0FFF0; border-radius:50%; z-index:1;"></div>
      
      <div style="position:relative; z-index:2; overflow:hidden; box-shadow:0 30px 60px rgba(47,79,79,0.08);">
        <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=1000&q=80" alt="Featured Product" style="width:100%; height:auto; display:block;" loading="lazy">
      </div>
      
      <!-- Minimalist stats -->
      <div style="position:absolute; bottom:10%; right:-10%; background:#FFFFFF; padding:32px; box-shadow:0 15px 40px rgba(47,79,79,0.05); z-index:3; text-align:center;">
        <div style="font-family:'Cormorant Garamond', serif; font-size:48px; font-weight:400; color:#2F4F4F; line-height:1; margin-bottom:8px;">98<span style="font-size:24px;">%</span></div>
        <div style="font-family:'Montserrat', sans-serif; font-size:11px; font-weight:500; text-transform:uppercase; letter-spacing:2px; color:#8FBC8F;">Saw brighter skin*</div>
      </div>
    </div>
    
    <!-- Content -->
    <div style="padding-left:40px;">
      <div style="font-family:'Montserrat', sans-serif; font-size:12px; font-weight:500; text-transform:uppercase; letter-spacing:3px; color:#8FBC8F; margin-bottom:24px; display:flex; align-items:center; gap:16px;">
        <span style="width:30px; height:1px; background:#8FBC8F;"></span>
        {{ section.settings.eyebrow }}
      </div>
      
      <h2 style="font-family:'Cormorant Garamond', serif; font-size:clamp(40px, 5vw, 64px); font-weight:400; line-height:1.1; color:#2F4F4F; margin:0 0 32px 0;">
        {{ section.settings.heading }}
      </h2>
      
      <p style="font-family:'Montserrat', sans-serif; font-size:16px; font-weight:300; line-height:1.8; color:#2F4F4F; opacity:0.8; margin:0 0 48px 0;">
        {{ section.settings.subheading }}
      </p>
      
      <!-- Benefits List -->
      <ul style="list-style:none; padding:0; margin:0 0 48px 0; display:flex; flex-direction:column; gap:20px;">
        <li style="display:flex; align-items:center; gap:16px; font-family:'Montserrat', sans-serif; font-size:14px; font-weight:400; color:#2F4F4F;">
          <div style="width:24px; height:24px; border-radius:50%; background:#F0FFF0; display:flex; align-items:center; justify-content:center; color:#8FBC8F; font-size:12px;">✓</div>
          Instantly plumps and hydrates
        </li>
        <li style="display:flex; align-items:center; gap:16px; font-family:'Montserrat', sans-serif; font-size:14px; font-weight:400; color:#2F4F4F;">
          <div style="width:24px; height:24px; border-radius:50%; background:#F0FFF0; display:flex; align-items:center; justify-content:center; color:#8FBC8F; font-size:12px;">✓</div>
          Visibly reduces fine lines
        </li>
        <li style="display:flex; align-items:center; gap:16px; font-family:'Montserrat', sans-serif; font-size:14px; font-weight:400; color:#2F4F4F;">
          <div style="width:24px; height:24px; border-radius:50%; background:#F0FFF0; display:flex; align-items:center; justify-content:center; color:#8FBC8F; font-size:12px;">✓</div>
          Dermatologist tested
        </li>
      </ul>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/products/dew-drops-serum' }}" style="display:inline-flex; align-items:center; justify-content:center; background:#2F4F4F; color:#FFFFFF; font-family:'Montserrat', sans-serif; font-size:13px; font-weight:500; text-transform:uppercase; letter-spacing:2px; padding:18px 48px; text-decoration:none; transition:all 0.4s ease;" class="bc-btn-primary">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>
    
  </div>

  <style>
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; gap: 80px; }
      div[style*="padding-left:40px"] { padding-left: 0; }
      div[style*="bottom:10%; right:-10%"] { right: 5%; bottom: -10%; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Beauty Featured",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "AWARD WINNING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Dew Drops Serum"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our cult-favorite serum instantly hydrates and leaves skin with a glass-like finish. Formulated without silicones or synthetic fragrances."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP THE SERUM"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Beauty Featured"
    }
  ]
}
{% endschema %}
