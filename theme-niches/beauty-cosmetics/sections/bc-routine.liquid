<div style="background:#F0FFF0; padding:120px 24px; position:relative; overflow:hidden;">
  
  <div style="max-width:1200px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px; max-width:600px; margin-left:auto; margin-right:auto;">
      <h2 style="font-family:'Cormorant Garamond', serif; font-size:clamp(36px, 5vw, 48px); font-weight:400; color:#2F4F4F; margin:0 0 16px 0;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-family:'Montserrat', sans-serif; font-size:16px; font-weight:300; color:#2F4F4F; opacity:0.8; margin:0 0 24px 0;">
        {{ section.settings.subheading }}
      </p>
      <div style="width:40px; height:1px; background:#8FBC8F; margin:0 auto;"></div>
    </div>

    <div class="bc-routine-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:60px; position:relative;">
      
      <!-- Connecting line for desktop -->
      <div style="position:absolute; top:20px; left:15%; right:15%; height:1px; background:rgba(47,79,79,0.1); z-index:1;" class="bc-routine-line"></div>
      
      {%- for block in section.blocks -%}
        <div style="text-align:center; position:relative; z-index:2;">
          
          <div style="width:40px; height:40px; border-radius:50%; background:#FFFFFF; border:1px solid #8FBC8F; display:flex; align-items:center; justify-content:center; margin:0 auto 32px auto; font-family:'Montserrat', sans-serif; font-size:12px; font-weight:500; color:#2F4F4F;">
            0{{ forloop.index }}
          </div>
          
          <h3 style="font-family:'Montserrat', sans-serif; font-size:14px; font-weight:500; text-transform:uppercase; letter-spacing:2px; color:#2F4F4F; margin:0 0 16px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Cormorant Garamond', serif; font-size:20px; font-style:italic; line-height:1.4; color:#2F4F4F; opacity:0.8; margin:0 auto; max-width:260px;">
            {{ block.settings.desc }}
          </p>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    @media (max-width: 990px) {
      .bc-routine-grid { grid-template-columns: 1fr; gap: 60px; }
      .bc-routine-line { display: none; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Beauty Routine",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The 3-Step Glow"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A minimalist approach to maximum results."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "01. Cleanse"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Purify without stripping."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beauty Routine",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
