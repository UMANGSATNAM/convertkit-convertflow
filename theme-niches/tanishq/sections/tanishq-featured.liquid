<div class="tanishq-products">
  <div class="tanishq-section-header">
    <p class="tanishq-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>
  {%- assign col = collections[section.settings.collection] -%}
  <div class="tanishq-prod-grid">
    {%- for product in col.products limit: section.settings.count -%}
    <a href="{{ product.url }}" class="tanishq-prod-card">
      <div class="tanishq-prod-card__img">
        {%- if product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">
        {%- else -%}
        <div style="width:100%;height:100%;background:var(--tanishq-cream);display:flex;align-items:center;justify-content:center">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--tanishq-border)" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/></svg>
        </div>
        {%- endif -%}
      </div>
      <div class="tanishq-prod-card__name">{{ product.title }}</div>
      <div class="tanishq-prod-card__price">{{ product.price | money }}</div>
      <div class="tanishq-prod-card__meta">{{ product.type }}</div>
    </a>
    {%- endfor -%}
  </div>
  <div style="text-align:center;margin-top:48px">
    <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="tanishq-btn">{{ section.settings.cta_label }}</a>
  </div>
</div>
{% schema %}
{
  "name": "Tanishq Featured",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"NEW ARRIVALS"},
    {"type":"text","id":"heading","label":"Heading","default":"Just In — Exquisite Pieces"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Freshly crafted designs for the discerning connoisseur"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"count","label":"Products","min":4,"max":12,"step":4,"default":8},
    {"type":"text","id":"cta_label","label":"CTA","default":"VIEW ALL"},
    {"type":"url","id":"cta_url","label":"CTA URL"}
  ],
  "presets":[{"name":"Tanishq Featured"}]
}
{% endschema %}
