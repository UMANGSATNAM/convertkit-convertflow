<div style="padding:100px 0; background:#FFFDFC; border-top:1px solid rgba(212, 175, 55, 0.25); border-bottom:1px solid rgba(212, 175, 55, 0.25);">
  <div class="page-width" style="max-width:1320px; margin:0 auto; padding:0 24px;">
    
    <div style="text-align:center; margin-bottom:64px;">
      {%- if section.settings.eyebrow != blank -%}
        <span style="font-size:11px; font-weight:700; letter-spacing:4px; text-transform:uppercase; color:#D4AF37; margin-bottom:16px; display:block;">
          {{ section.settings.eyebrow }}
        </span>
      {%- endif -%}
      <h2 class="tq-sh-h2" style="font-family:'Cormorant Garamond', serif; font-size:clamp(32px, 4vw, 48px); color:#1A0F0A; margin-bottom:16px; position:relative; display:inline-block; padding-bottom:12px;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-size:15px; color:#7D6B58; max-width:580px; margin:16px auto 0;">
        {{ section.settings.subheading }}
      </p>
    </div>

    {%- assign col = collections[section.settings.collection] -%}
    <div class="tq-prod-grid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:24px;">
      {%- for product in col.products limit: section.settings.count -%}
        <div class="tq-prod-card" style="background:#FDFAF3; border:1px solid rgba(212, 175, 55, 0.15); display:flex; flex-direction:column; transition:all 0.4s ease; text-decoration:none; color:#1A0F0A;">
          <a href="{{ product.url }}" style="display:block; text-decoration:none; color:inherit; flex-grow:1; display:flex; flex-direction:column;">
            <div class="tq-prod-img-wrapper" style="position:relative; aspect-ratio:1; overflow:hidden; background:#FFF; display:flex; align-items:center; justify-content:center;">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', style: 'width:100%; height:100%; object-fit:cover; transition:transform 0.8s ease;', class: 'tq-prod-img' }}
              {%- else -%}
                <!-- Placeholder -->
                <div class="tq-prod-img" style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#F4E7C4;"></div>
              {%- endif -%}
              
              {%- if product.tags contains 'bestseller' -%}
                <span style="position:absolute; top:12px; left:12px; color:#FDFAF3; background:#8B1A2C; padding:6px 14px; font-size:9px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase;">Bestseller</span>
              {%- elsif product.tags contains 'exclusive' -%}
                <span style="position:absolute; top:12px; left:12px; color:#1A0F0A; background:#D4AF37; padding:6px 14px; font-size:9px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase;">Exclusive</span>
              {%- endif -%}
            </div>
            
            <div style="padding:24px; text-align:center; display:flex; flex-direction:column; justify-content:space-between; flex-grow:1;">
              <div>
                <div style="font-size:10px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:#7D6B58; margin-bottom:8px;">{{ product.type | default: 'Fine Jewellery' }}</div>
                <h3 style="font-size:16px; font-weight:500; line-height:1.4; margin-bottom:12px; height:44px; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">{{ product.title | default: 'Celestial Gold Necklace' }}</h3>
              </div>
              <div>
                <div style="font-family:'Cormorant Garamond', serif; font-size:20px; font-weight:700; color:#8B1A2C; margin-bottom:16px;">{{ product.price | money | default: '₹1,24,999' }}</div>
                <button type="button" class="tq-prod-atc" style="display:block; width:100%; padding:14px; background:#1A0F0A; color:#D4AF37; border:1px solid #1A0F0A; font-size:11px; font-weight:700; cursor:pointer; letter-spacing:2px; text-transform:uppercase; transition:all 0.3s ease;">Add to Bag</button>
              </div>
            </div>
          </a>
        </div>
      {%- else -%}
        <!-- Dummy placehoders -->
        {%- for i in (1..section.settings.count) -%}
          <div class="tq-prod-card" style="background:#FDFAF3; border:1px solid rgba(212, 175, 55, 0.15); display:flex; flex-direction:column; transition:all 0.4s ease;">
            <div class="tq-prod-img-wrapper" style="position:relative; aspect-ratio:1; overflow:hidden; background:#FFF; display:flex; align-items:center; justify-content:center;">
              <div class="tq-prod-img" style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#F4E7C4;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(212, 175, 55, 0.5)" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              </div>
              <span style="position:absolute; top:12px; left:12px; color:#1A0F0A; background:#D4AF37; padding:6px 14px; font-size:9px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase;">Exclusive</span>
            </div>
            <div style="padding:24px; text-align:center; display:flex; flex-direction:column; justify-content:space-between; flex-grow:1;">
              <div>
                <div style="font-size:10px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:#7D6B58; margin-bottom:8px;">Gold Sets</div>
                <h3 style="font-size:16px; font-weight:500; line-height:1.4; margin-bottom:12px; height:44px; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">Celestial Gold Necklace Set</h3>
              </div>
              <div>
                <div style="font-family:'Cormorant Garamond', serif; font-size:20px; font-weight:700; color:#8B1A2C; margin-bottom:16px;">₹1,24,999</div>
                <button type="button" class="tq-prod-atc" style="display:block; width:100%; padding:14px; background:#1A0F0A; color:#D4AF37; border:1px solid #1A0F0A; font-size:11px; font-weight:700; cursor:pointer; letter-spacing:2px; text-transform:uppercase; transition:all 0.3s ease;">Add to Bag</button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div style="text-align:center; margin-top:48px;">
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="tq-btn-gold" style="display:inline-flex; align-items:center; gap:12px; background:#D4AF37; color:#1A0F0A; padding:16px 36px; font-size:12px; font-weight:700; text-decoration:none; border:1px solid #D4AF37; letter-spacing:2px; text-transform:uppercase; transition:all 0.3s ease;">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}
  </div>

  <style>
    .tq-sh-h2::after {
      content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 60px; height: 1px; background: #D4AF37;
    }
    .tq-prod-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 40px rgba(44, 24, 16, 0.08);
      border-color: #D4AF37 !important;
    }
    .tq-prod-card:hover .tq-prod-img {
      transform: scale(1.05);
    }
    .tq-prod-card:hover .tq-prod-atc {
      background: #D4AF37 !important;
      color: #1A0F0A !important;
      border-color: #D4AF37 !important;
    }
    .tq-btn-gold:hover {
      background: transparent !important;
      color: #D4AF37 !important;
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(212, 175, 55, 0.15);
    }
    @media (max-width: 1024px) {
      .tq-prod-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
    @media (max-width: 480px) {
      .tq-prod-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Tanishq Featured",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"NEW ARRIVALS"},
    {"type":"text","id":"heading","label":"Heading","default":"Just In — Exquisite Pieces"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Freshly crafted designs for the discerning connoisseur"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"count","label":"Products to show","min":4,"max":12,"step":4,"default":4},
    {"type":"text","id":"cta_label","label":"Button Label","default":"VIEW ALL"},
    {"type":"url","id":"cta_url","label":"Button URL"}
  ],
  "presets":[{"name":"Tanishq Featured"}]
}
{% endschema %}
