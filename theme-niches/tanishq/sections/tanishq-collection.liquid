<div style="background:var(--lux-bg);padding:140px 60px">
  <div style="max-width:1400px;margin:0 auto">
    <div style="text-align:center;margin-bottom:100px">
      <div class="lux-overline" style="margin-bottom:24px">{{ collection.products_count | default: '12' }} PIECES</div>
      <h2 class="lux-head" style="font-size:56px;color:var(--lux-text);margin-bottom:32px">{{ collection.title | default: 'The Vault' }}</h2>
      <div class="lux-divider"></div>
    </div>
    
    <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:80px 40px">
      {%- for product in collection.products limit: 9 -%}
      <a href="{{ product.url }}" class="lux-card lux-fade-in" style="animation-delay:{{ forloop.index | times: 0.1 }}s">
        <div class="image-wrapper">
          {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- else -%}
          <div style="width:100%;height:100%;background:var(--lux-gold-light)"></div>
          {%- endif -%}
        </div>
        <div class="content">
          <div class="title">{{ product.title }}</div>
          <div class="price">{{ product.price | money }}</div>
        </div>
      </a>
      {%- else -%}
      <!-- Demo State -->
      {%- for i in (1..6) -%}
      <a href="#" class="lux-card lux-fade-in" style="animation-delay:{{ i | times: 0.1 }}s">
        <div class="image-wrapper">
          <div style="width:100%;height:100%;background:var(--lux-gold-light)"></div>
        </div>
        <div class="content">
          <div class="title">Radiant Emerald Ring V.{{i}}</div>
          <div class="price">₹1,25,000</div>
        </div>
      </a>
      {%- endfor -%}
      {%- endfor -%}
    </div>
    
    <div style="text-align:center;margin-top:100px">
      <a href="/collections/all" class="lux-btn lux-btn-outline">View All Pieces</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Tanishq Editorial Grid",
  "settings": [],
  "presets": [
    {
      "name": "Tanishq Editorial Grid"
    }
  ]
}
{% endschema %}
