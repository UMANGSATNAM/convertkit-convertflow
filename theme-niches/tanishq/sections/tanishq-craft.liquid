<div class="tanishq-craft">
  <div class="tanishq-craft__grid">
    <div>
      <p class="tanishq-eyebrow" style="color:var(--tanishq-gold)">{{ section.settings.eyebrow }}</p>
      <h2 style="font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,48px);font-weight:400;color:var(--tanishq-ivory);margin-bottom:20px;line-height:1.15">{{ section.settings.heading }}</h2>
      <p style="font-size:16px;color:rgba(250,246,239,0.55);line-height:1.8;margin-bottom:40px;max-width:460px">{{ section.settings.body }}</p>
      <div class="tanishq-craft__stat-grid">
        {%- for block in section.blocks -%}
        <div class="tanishq-stat" {{ block.shopify_attributes }}>
          <div class="tanishq-stat__number">{{ block.settings.number }}</div>
          <div class="tanishq-stat__label">{{ block.settings.label }}</div>
        </div>
        {%- endfor -%}
      </div>
    </div>
    <div>
      {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;object-fit:cover" loading="lazy">
      {%- else -%}
      <div style="aspect-ratio:4/5;background:linear-gradient(135deg,#2D0A1B,#6B1D3A);display:flex;align-items:center;justify-content:center">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="rgba(197,163,85,0.3)" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
      </div>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Tanishq Craftsmanship",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"LEGACY OF TRUST"},
    {"type":"text","id":"heading","label":"Heading","default":"80 Years of Exquisite Craftsmanship"},
    {"type":"textarea","id":"body","label":"Body","default":"Every Tanishq piece is born from a legacy of excellence — handcrafted by master artisans, certified for purity, and designed to be treasured for generations."},
    {"type":"image_picker","id":"image","label":"Image"}
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {"type":"text","id":"number","label":"Number","default":"400+"},
        {"type":"text","id":"label","label":"Label","default":"Stores Nationwide"}
      ]
    }
  ],
  "presets": [{
    "name": "Tanishq Craftsmanship",
    "blocks": [
      {"type":"stat","settings":{"number":"80+","label":"Years of Trust"}},
      {"type":"stat","settings":{"number":"400+","label":"Stores Nationwide"}},
      {"type":"stat","settings":{"number":"5000+","label":"Master Artisans"}},
      {"type":"stat","settings":{"number":"100%","label":"BIS Hallmarked"}}
    ]
  }]
}
{% endschema %}
