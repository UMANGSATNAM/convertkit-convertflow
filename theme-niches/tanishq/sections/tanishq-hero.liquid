<div class="tanishq-hero">
  <div class="tanishq-hero__content">
    <p class="tanishq-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="tanishq-hero__title">{{ section.settings.heading }}</h1>
    <p class="tanishq-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:16px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="tanishq-btn">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}
      <a href="{{ section.settings.cta_url_2 | default: '/pages/bridal' }}" class="tanishq-btn tanishq-btn--outline">{{ section.settings.cta_label_2 }}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="tanishq-hero__visual">
    {%- if section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">
    {%- else -%}
    <div style="width:100%;height:100%;min-height:500px;background:linear-gradient(135deg,#6B1D3A,#C5A355);display:flex;align-items:center;justify-content:center">
      <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="rgba(250,246,239,0.25)" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
    </div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Tanishq Hero",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"A TATA PRODUCT"},
    {"type":"text","id":"heading","label":"Heading","default":"Where Tradition Meets Timeless Elegance"},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Discover exquisitely handcrafted jewellery that celebrates every moment, every milestone, every you."},
    {"type":"image_picker","id":"image","label":"Hero Image"},
    {"type":"text","id":"cta_label","label":"CTA","default":"EXPLORE COLLECTIONS"},
    {"type":"url","id":"cta_url","label":"CTA URL"},
    {"type":"text","id":"cta_label_2","label":"Secondary CTA","default":"BRIDAL JEWELLERY"},
    {"type":"url","id":"cta_url_2","label":"Secondary URL"}
  ],
  "presets":[{"name":"Tanishq Hero"}]
}
{% endschema %}
