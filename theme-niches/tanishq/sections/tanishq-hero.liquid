<div style="position:relative; min-height:680px; background:#1A0F0A; display:flex; align-items:center; overflow:hidden; padding:80px 0;">
  <!-- Background Effect -->
  <div style="position:absolute; inset:0; background:radial-gradient(circle at 80% 50%, rgba(139, 26, 44, 0.15) 0%, transparent 60%);"></div>
  
  <div class="page-width" style="max-width:1320px; margin:0 auto; padding:0 24px;">
    <div class="tq-hero-grid" style="display:grid; grid-template-columns:1.2fr 0.8fr; gap:64px; align-items:center; position:relative; z-index:2;">
      
      <div class="tq-hero-content" style="border-left:2px solid #D4AF37; padding-left:40px;">
        {%- if section.settings.eyebrow != blank -%}
          <span style="color:#D4AF37; font-size:12px; font-weight:700; letter-spacing:4px; text-transform:uppercase; margin-bottom:24px; display:block;">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}
        
        <h1 style="font-family:'Cormorant Garamond', serif; font-size:clamp(48px, 6vw, 76px); font-weight:600; line-height:1.05; color:#FDFAF3; margin-bottom:28px;">
          {{ section.settings.heading | replace: '<em>', '<span style="color:#D4AF37; font-style:italic;">' | replace: '</em>', '</span>' }}
        </h1>
        
        <p style="font-size:16px; color:rgba(253, 250, 243, 0.7); margin-bottom:44px; max-width:540px; line-height:1.8;">
          {{ section.settings.subheading }}
        </p>
        
        <div class="tq-hero-ctas" style="display:flex; gap:16px;">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="tq-btn-gold" style="display:inline-flex; align-items:center; gap:12px; background:#D4AF37; color:#1A0F0A; padding:16px 36px; font-size:12px; font-weight:700; text-decoration:none; letter-spacing:2px; text-transform:uppercase; border:1px solid #D4AF37; transition:all 0.3s ease;">
              {{ section.settings.cta_label }}
            </a>
          {%- endif -%}
          
          {%- if section.settings.cta_label_2 != blank -%}
            <a href="{{ section.settings.cta_url_2 | default: '/pages/book-appointment' }}" class="tq-btn-outline" style="display:inline-flex; align-items:center; gap:12px; background:transparent; color:#FFF; padding:16px 36px; border:1px solid rgba(255,255,255,0.4); font-size:12px; font-weight:700; text-decoration:none; letter-spacing:2px; text-transform:uppercase; transition:all 0.3s ease;">
              {{ section.settings.cta_label_2 }}
            </a>
          {%- endif -%}
        </div>
      </div>
      
      <div class="tq-hero-visual" style="position:relative; width:100%; aspect-ratio:4/5; border:1px solid rgba(212, 175, 55, 0.3); padding:16px; background:rgba(255,255,255,0.02); margin:0 auto; max-width:500px;">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'eager', style: 'width:100%; height:100%; object-fit:cover; filter:brightness(0.9);' }}
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=800&q=80" alt="Luxury Jewellery" style="width:100%; height:100%; object-fit:cover; filter:brightness(0.9);" loading="eager">
        {%- endif -%}
        
        <div class="tq-hero-badge" style="position:absolute; bottom:-20px; left:-20px; background:#FDFAF3; border:1px solid #D4AF37; padding:20px 24px; text-align:center;">
          <span style="font-size:24px; font-weight:700; color:#8B1A2C; display:block; font-family:'Cormorant Garamond', serif;">100%</span>
          <span style="font-size:10px; text-transform:uppercase; letter-spacing:1px; color:#7D6B58;">BIS Certified</span>
        </div>
      </div>
      
    </div>
  </div>

  <style>
    .tq-btn-gold:hover {
      background: transparent !important;
      color: #D4AF37 !important;
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(212, 175, 55, 0.15);
    }
    .tq-btn-outline:hover {
      border-color: #D4AF37 !important;
      color: #D4AF37 !important;
      background: rgba(255,255,255,0.05) !important;
    }
    @media (max-width: 768px) {
      .tq-hero-grid { grid-template-columns: 1fr !important; gap: 40px !important; text-align: center; }
      .tq-hero-content { border-left: none !important; padding-left: 0 !important; }
      .tq-hero-ctas { justify-content: center; }
      .tq-hero-badge { display: none !important; }
    }
    @media (max-width: 480px) {
      .tq-hero-ctas { flex-direction: column; width: 100%; }
      .tq-hero-ctas a { width: 100%; justify-content: center; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Tanishq Heritage Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "A TATA PRODUCT"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Draped in <em>Heritage</em> & Elegance",
      "info": "Use <em> tags to highlight text in Gold color."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Exquisite gold, diamond, and kundan jewelry handcrafted by India’s finest artisans. Celebrate life’s beautiful milestones with trust and luxury."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary Button Label",
      "default": "Explore Collections"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "cta_label_2",
      "label": "Secondary Button Label",
      "default": "Book Video Call"
    },
    {
      "type": "url",
      "id": "cta_url_2",
      "label": "Secondary Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Tanishq Heritage Hero"
    }
  ]
}
{% endschema %}
