<div style="position:relative;background:var(--lux-bg);min-height:95vh;display:flex;align-items:center;justify-content:center;padding:80px 20px;text-align:center">
  <div style="max-width:800px;position:relative;z-index:2" class="lux-fade-in">
    <div class="lux-overline" style="margin-bottom:32px">{{ section.settings.overline | default: 'The Heritage Collection' }}</div>
    <h1 class="lux-head" style="font-size:clamp(48px, 6vw, 84px);color:var(--lux-text);margin-bottom:40px;line-height:1.1">
      {{ section.settings.heading | default: 'Elegance,<br><em>Perfected.</em>' }}
    </h1>
    <div class="lux-divider" style="margin-bottom:40px"></div>
    <p style="font-family:var(--font-b);font-size:16px;line-height:1.8;color:var(--lux-muted);margin-bottom:56px;max-width:500px;margin-left:auto;margin-right:auto">
      {{ section.settings.text | default: 'Masterfully crafted pieces that transcend time. Designed for the modern connoisseur.' }}
    </p>
    <div style="display:flex;gap:24px;justify-content:center">
      <a href="{{ section.settings.btn1_url | default: '/collections/all' }}" class="lux-btn">{{ section.settings.btn1_text | default: 'Discover Collection' }}</a>
    </div>
  </div>
  
  <!-- Subtle Background Images (Editorial Offset) -->
  <div style="position:absolute;top:10%;left:10%;width:25%;aspect-ratio:3/4;z-index:1;opacity:0.8;box-shadow:0 40px 80px rgba(0,0,0,0.05)">
    <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/jewel-left.jpg?v=1717283400" style="width:100%;height:100%;object-fit:cover">
  </div>
  <div style="position:absolute;bottom:10%;right:10%;width:30%;aspect-ratio:4/5;z-index:1;opacity:0.8;box-shadow:0 40px 80px rgba(0,0,0,0.05)">
    <img src="https://cdn.shopify.com/s/files/1/0885/8763/2953/files/jewel-right.jpg?v=1717283400" style="width:100%;height:100%;object-fit:cover">
  </div>
</div>

{% schema %}
{
  "name": "Tanishq Editorial Hero",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline Text",
      "default": "The Heritage Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elegance,<br><em>Perfected.</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Masterfully crafted pieces that transcend time."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button Text",
      "default": "Discover Collection"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Tanishq Editorial Hero"
    }
  ]
}
{% endschema %}
