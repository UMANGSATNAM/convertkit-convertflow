<div style="padding:80px 20px;background:var(--tanishq-cream)">
  <div style="max-width:1320px;margin:0 auto">
    <div class="tanishq-section-header">
      <p class="tanishq-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div style="background:#fff;padding:40px;border:1px solid var(--tanishq-border);margin-bottom:48px">
      <div style="display:flex;align-items:center;gap:24px;flex-wrap:wrap;justify-content:center;margin-bottom:32px">
        <div style="text-align:center;flex:0 0 160px">
          <div style="width:140px;height:140px;overflow:hidden;margin:0 auto 12px;background:var(--tanishq-cream)">
            <img src="{{ product.featured_image | image_url: width: 280 }}" alt="{{ product.title | escape }}" width="140" style="width:100%;height:100%;object-fit:cover">
          </div>
          <div style="font-size:13px;font-weight:600;color:var(--tanishq-charcoal)">{{ product.title | truncate: 30 }}</div>
          <div style="font-size:14px;font-weight:700;color:var(--tanishq-burgundy)">{{ product.price | money }}</div>
        </div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'bundle_product' -%}
          {%- assign bp = all_products[block.settings.product] -%}
          {%- if bp != blank -%}
          <div style="font-size:28px;color:var(--tanishq-border)">+</div>
          <div style="text-align:center;flex:0 0 160px" {{ block.shopify_attributes }}>
            <div style="width:140px;height:140px;overflow:hidden;margin:0 auto 12px;background:var(--tanishq-cream)">
              <img src="{{ bp.featured_image | image_url: width: 280 }}" alt="{{ bp.title | escape }}" width="140" style="width:100%;height:100%;object-fit:cover">
            </div>
            <div style="font-size:13px;font-weight:600;color:var(--tanishq-charcoal)">{{ bp.title | truncate: 30 }}</div>
            <div style="font-size:14px;font-weight:700;color:var(--tanishq-burgundy)">{{ bp.price | money }}</div>
          </div>
          {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div style="text-align:center;padding-top:24px;border-top:1px solid var(--tanishq-border)">
        <div style="font-size:12px;color:var(--tanishq-muted);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:12px">Complete the Set</div>
        <a href="/cart" class="tanishq-btn">ADD SET TO BAG</a>
      </div>
    </div>

    <h3 style="font-family:'Playfair Display',serif;font-size:28px;font-weight:400;color:var(--tanishq-charcoal);text-align:center;margin-bottom:32px">{{ section.settings.cross_sell_heading }}</h3>
    {%- assign rec_col = collections[section.settings.recommendation_collection] -%}
    <div class="tanishq-prod-grid">
      {%- for p in rec_col.products limit: 4 -%}
        {%- if p.handle != product.handle -%}
        <a href="{{ p.url }}" class="tanishq-prod-card">
          <div class="tanishq-prod-card__img">
            {%- if p.featured_image != blank -%}
            <img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.title | escape }}" width="600" loading="lazy">
            {%- else -%}
            <div style="width:100%;height:100%;background:var(--tanishq-cream)"></div>
            {%- endif -%}
          </div>
          <div class="tanishq-prod-card__name">{{ p.title }}</div>
          <div class="tanishq-prod-card__price">{{ p.price | money }}</div>
        </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name":"Tanishq Cross-Sell",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"COMPLETE THE SET"},
    {"type":"text","id":"heading","label":"Heading","default":"Pairs Beautifully With"},
    {"type":"text","id":"cross_sell_heading","label":"Cross-sell Heading","default":"You May Also Like"},
    {"type":"collection","id":"recommendation_collection","label":"Recommendation Collection"}
  ],
  "blocks":[{"type":"bundle_product","name":"Bundle Product","limit":3,"settings":[{"type":"product","id":"product","label":"Product"}]}],
  "presets":[{"name":"Tanishq Cross-Sell"}]
}
{% endschema %}
