<div style="padding:120px 0; background:#1A0F0A; color:#FDFAF3; position:relative; overflow:hidden;">
  <div class="page-width" style="max-width:1320px; margin:0 auto; padding:0 24px;">
    <div class="tq-bridal-grid" style="display:grid; grid-template-columns:1fr 1.2fr; gap:80px; align-items:center;">
      
      <div style="position:relative; border:1px solid #D4AF37; padding:16px;">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', style: 'width:100%; aspect-ratio:4/5; object-fit:cover;' }}
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1603561591411-07134e71a2a9?auto=format&fit=crop&w=800&q=80" alt="Bridal Jewellery" style="width:100%; aspect-ratio:4/5; object-fit:cover;" loading="lazy">
        {%- endif -%}
      </div>
      
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span style="color:#D4AF37; font-size:12px; font-weight:700; letter-spacing:4px; text-transform:uppercase; margin-bottom:24px; display:block;">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}
        
        <h2 style="font-family:'Cormorant Garamond', serif; font-size:clamp(36px, 4vw, 52px); line-height:1.15; margin-bottom:28px;">
          {{ section.settings.heading | replace: '<em>', '<span style="color:#D4AF37; font-style:italic;">' | replace: '</em>', '</span>' }}
        </h2>
        
        <p style="font-size:15px; line-height:1.9; color:rgba(253, 250, 243, 0.7); margin-bottom:44px; max-width:600px;">
          {{ section.settings.body }}
        </p>
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/collections/bridal' }}" class="tq-btn-gold" style="display:inline-flex; align-items:center; gap:12px; background:#D4AF37; color:#1A0F0A; padding:16px 36px; font-size:12px; font-weight:700; text-decoration:none; border:1px solid #D4AF37; letter-spacing:2px; text-transform:uppercase; transition:all 0.3s ease;">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
      
    </div>
  </div>

  <style>
    .tq-btn-gold:hover {
      background: transparent !important;
      color: #D4AF37 !important;
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(212, 175, 55, 0.15);
    }
    @media (max-width: 768px) {
      .tq-bridal-grid { grid-template-columns: 1fr !important; gap: 48px !important; text-align: center; }
      .tq-btn-gold { justify-content: center; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Tanishq Bridal",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "BRIDAL COLLECTION"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Begin Your <em>Forever</em> in Gold",
      "info": "Use <em> tags to highlight text in Gold color."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body Text",
      "default": "From temple jewellery to contemporary bridal sets — find the perfect pieces to make your special day unforgettable."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "EXPLORE BRIDAL"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Tanishq Bridal"
    }
  ]
}
{% endschema %}
