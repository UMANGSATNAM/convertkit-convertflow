<div class="tanishq-bridal">
  <div class="tanishq-bridal__content">
    <p class="tanishq-eyebrow" style="color:var(--tanishq-gold)">{{ section.settings.eyebrow }}</p>
    <h2 style="font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,52px);font-weight:400;color:var(--tanishq-ivory);line-height:1.15;margin-bottom:20px">{{ section.settings.heading }}</h2>
    <p style="font-size:16px;color:rgba(250,246,239,0.6);line-height:1.8;margin-bottom:36px;max-width:420px">{{ section.settings.body }}</p>
    {%- if section.settings.cta_label != blank -%}
    <a href="{{ section.settings.cta_url | default: '/collections/bridal' }}" class="tanishq-btn">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
  <div class="tanishq-bridal__visual">
    {%- if section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" width="900" loading="lazy">
    {%- else -%}
    <div style="width:100%;height:100%;min-height:400px;background:linear-gradient(135deg,#C5A355,#6B1D3A)"></div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Tanishq Bridal",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"BRIDAL COLLECTION"},
    {"type":"text","id":"heading","label":"Heading","default":"Begin Your Forever in Gold"},
    {"type":"textarea","id":"body","label":"Body","default":"From temple jewellery to contemporary bridal sets — find the perfect pieces to make your special day unforgettable."},
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"cta_label","label":"CTA","default":"EXPLORE BRIDAL"},
    {"type":"url","id":"cta_url","label":"CTA URL"}
  ],
  "presets":[{"name":"Tanishq Bridal"}]
}
{% endschema %}
