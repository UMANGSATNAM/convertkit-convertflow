<div class="tanishq-reviews">
  <div class="tanishq-section-header">
    <p class="tanishq-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="tanishq-review-grid">
    {%- for block in section.blocks -%}
    <div class="tanishq-review-card" {{ block.shopify_attributes }}>
      <div class="tanishq-review-card__stars">{%- for i in (1..block.settings.rating) -%}★{%- endfor -%}</div>
      <div class="tanishq-review-card__text">"{{ block.settings.quote }}"</div>
      <div class="tanishq-review-card__author">{{ block.settings.name }}</div>
      <div class="tanishq-review-card__meta">{{ block.settings.product }} · {{ block.settings.location }}</div>
    </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Tanishq Reviews",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"CUSTOMER STORIES"},
    {"type":"text","id":"heading","label":"Heading","default":"Treasured by Millions"}
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},
        {"type":"textarea","id":"quote","label":"Quote","default":"The craftsmanship is unmatched. My wedding necklace from Tanishq is the most beautiful piece I own."},
        {"type":"text","id":"name","label":"Name","default":"Meera S."},
        {"type":"text","id":"product","label":"Product","default":"Bridal Necklace Set"},
        {"type":"text","id":"location","label":"Location","default":"Chennai"}
      ]
    }
  ],
  "presets": [{
    "name": "Tanishq Reviews",
    "blocks": [
      {"type":"review","settings":{"rating":5,"quote":"The craftsmanship is unmatched. My wedding necklace from Tanishq is the most beautiful piece I own.","name":"Meera S.","product":"Bridal Necklace Set","location":"Chennai"}},
      {"type":"review","settings":{"rating":5,"quote":"Bought diamond studs for my anniversary. The purity certificate and hallmark give me total confidence.","name":"Rahul D.","product":"Diamond Studs","location":"Pune"}},
      {"type":"review","settings":{"rating":5,"quote":"Their everyday gold bangles are so elegant. I get compliments every single day at work!","name":"Ananya R.","product":"Gold Bangles","location":"Hyderabad"}}
    ]
  }]
}
{% endschema %}
