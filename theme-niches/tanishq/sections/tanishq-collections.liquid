<div style="padding:100px 0; background:#FDFAF3;">
  <div class="page-width" style="max-width:1320px; margin:0 auto; padding:0 24px;">
    
    <div style="text-align:center; margin-bottom:64px;">
      {%- if section.settings.eyebrow != blank -%}
        <span style="font-size:11px; font-weight:700; letter-spacing:4px; text-transform:uppercase; color:#D4AF37; margin-bottom:16px; display:block;">
          {{ section.settings.eyebrow }}
        </span>
      {%- endif -%}
      <h2 class="tq-sh-h2" style="font-family:'Cormorant Garamond', serif; font-size:clamp(32px, 4vw, 48px); color:#1A0F0A; margin-bottom:16px; position:relative; display:inline-block; padding-bottom:12px;">
        {{ section.settings.heading }}
      </h2>
      <p style="font-size:15px; color:#7D6B58; max-width:580px; margin:16px auto 0;">
        {{ section.settings.subheading }}
      </p>
    </div>

    <div class="tq-coll-grid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:24px;">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.url | default: '/collections/all' }}" class="tq-coll-card" style="position:relative; overflow:hidden; aspect-ratio:3/4; border:1px solid rgba(212, 175, 55, 0.2); display:block; text-decoration:none;" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', style: 'width:100%; height:100%; object-fit:cover; transition:transform 1.2s cubic-bezier(0.25, 1, 0.5, 1);', class: 'tq-coll-img' }}
          {%- else -%}
            <!-- Placeholder -->
            <div class="tq-coll-img" style="width:100%; height:100%; background:linear-gradient(135deg, #F4E7C4, #D4AF37); transition:transform 1.2s cubic-bezier(0.25, 1, 0.5, 1);"></div>
          {%- endif -%}
          
          <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(26, 15, 10, 0.85) 0%, rgba(26, 15, 10, 0.2) 60%, transparent 100%); display:flex; flex-direction:column; justify-content:flex-end; padding:24px;">
            <h3 style="font-family:'Cormorant Garamond', serif; font-size:24px; color:#FDFAF3; margin-bottom:6px;">{{ block.settings.title }}</h3>
            <span style="font-size:10px; color:#D4AF37; letter-spacing:2px; text-transform:uppercase; font-weight:600; display:inline-flex; align-items:center; gap:6px;">
              Shop Collection 
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>

  <style>
    .tq-sh-h2::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 1px;
      background: #D4AF37;
    }
    .tq-coll-card:hover .tq-coll-img {
      transform: scale(1.08);
    }
    @media (max-width: 1024px) {
      .tq-coll-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
    @media (max-width: 480px) {
      .tq-coll-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Tanishq Collections",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"CURATED FOR YOU"},
    {"type":"text","id":"heading","label":"Heading","default":"Shop by Occasion"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Find the perfect piece for every celebration"}
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {"type":"text","id":"title","label":"Title","default":"Bridal Gold"},
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"url","id":"url","label":"Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Tanishq Collections",
      "blocks": [
        {"type":"collection","settings":{"title":"Gold Necklaces"}},
        {"type":"collection","settings":{"title":"Diamond Solitaires"}},
        {"type":"collection","settings":{"title":"Bangles & Kada"}},
        {"type":"collection","settings":{"title":"Gold Earrings"}}
      ]
    }
  ]
}
{% endschema %}
