<div class="tanishq-collections">
  <div class="tanishq-section-header">
    <p class="tanishq-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>
  <div class="tanishq-col-grid">
    {%- for block in section.blocks -%}
    <a href="{{ block.settings.url | default: '/collections/all' }}" class="tanishq-col-card" style="text-decoration:none" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
      <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">
      {%- else -%}
      <div style="width:100%;height:100%;background:linear-gradient(135deg,var(--tanishq-cream),var(--tanishq-burgundy))"></div>
      {%- endif -%}
      <div class="tanishq-col-card__overlay">
        <span class="tanishq-col-card__title">{{ block.settings.title }}</span>
        <span class="tanishq-col-card__cta">Shop Now →</span>
      </div>
    </a>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Tanishq Collections",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"CURATED FOR YOU"},
    {"type":"text","id":"heading","label":"Heading","default":"Shop by Occasion"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Find the perfect piece for every celebration"}
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {"type":"text","id":"title","label":"Title","default":"Wedding Collection"},
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"url","id":"url","label":"URL"}
      ]
    }
  ],
  "presets": [{
    "name": "Tanishq Collections",
    "blocks": [
      {"type":"collection","settings":{"title":"Bridal Gold"}},
      {"type":"collection","settings":{"title":"Diamond Solitaires"}},
      {"type":"collection","settings":{"title":"Everyday Elegance"}}
    ]
  }]
}
{% endschema %}
