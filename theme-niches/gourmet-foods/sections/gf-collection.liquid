<div style="padding:48px 20px 0;background:var(--gf-linen)"><div style="max-width:1320px;margin:0 auto;text-align:center;padding-bottom:48px"><span class="gf-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</span><h1 style="font-family:'Playfair Display',serif;font-size:clamp(32px,5vw,56px);font-weight:400;color:var(--gf-dark);margin-bottom:12px">{{ collection.title }}</h1>{%- if collection.description != blank -%}<p style="font-family:'Lora',serif;font-size:16px;color:var(--gf-muted);max-width:560px;margin:0 auto">{{ collection.description }}</p>{%- endif -%}</div></div>
<div style="padding:0 20px 80px;background:#fff"><div style="max-width:1320px;margin:0 auto"><div style="display:flex;justify-content:space-between;align-items:center;padding:20px 0;border-bottom:1px solid var(--gf-border);margin-bottom:32px"><div style="font-size:14px;color:var(--gf-muted)">{{ collection.products_count }} delicacies</div><select style="padding:8px 16px;border:1px solid var(--gf-border);border-radius:8px;font-size:13px;cursor:pointer"><option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Newest</option></select></div><div class="gf-prod-grid">{%- for product in collection.products -%}<a href="{{ product.url }}" class="gf-prod-card"><div class="gf-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--gf-linen)"></div>{%- endif -%}</div><div class="gf-prod-card__info"><div class="gf-prod-card__name">{{ product.title }}</div><div class="gf-prod-card__price">{{ product.price | money }}</div></div></a>{%- endfor -%}</div></div></div>
{% schema %}
{"name":"GF Collection","settings":[],"presets":[{"name":"GF Collection"}]}
{% endschema %}
