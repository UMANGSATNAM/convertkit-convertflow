<div style="padding:80px 20px;background:var(--gf-dark)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="gf-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,46px);font-weight:400;color:var(--gf-linen);margin-bottom:20px;line-height:1.2">{{ section.settings.heading }}</h2>
    <p style="font-family:'Lora',serif;font-size:16px;color:var(--gf-muted);line-height:1.8;max-width:440px">{{ section.settings.body }}</p>
    <div class="gf-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="gf-stat" style="border-color:rgba(230,223,211,0.15);background:rgba(255,255,255,0.02)" {{ block.shopify_attributes }}><div class="gf-stat__num" style="color:var(--gf-gold)">{{ block.settings.number }}</div><div class="gf-stat__label" style="color:var(--gf-muted)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:8px;object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:4/5;background:var(--gf-olive);border-radius:8px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Gourmet Process","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"OUR PLEDGE"},{"type":"text","id":"heading","label":"Heading","default":"Traceable Back to the Soil"},{"type":"textarea","id":"body","label":"Body","default":"We build direct partnerships with small agrarian estates, verifying soil biodiversity, traditional cold extraction, and organic harvesting standards."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"100%"},{"type":"text","id":"label","label":"Label","default":"Traceable"}]}],"presets":[{"name":"Gourmet Process","blocks":[{"type":"stat","settings":{"number":"100%","label":"Traceable"}},{"type":"stat","settings":{"number":"Cold","label":"Pressed Oils"}},{"type":"stat","settings":{"number":"Small","label":"Estates Sourced"}},{"type":"stat","settings":{"number":"Zero","label":"Preservatives"}}]}]}
{% endschema %}
