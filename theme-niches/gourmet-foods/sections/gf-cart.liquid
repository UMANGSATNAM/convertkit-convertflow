<div style="padding:48px 20px 80px;background:var(--gf-linen);min-height:60vh"><div style="max-width:960px;margin:0 auto">
  <h1 style="font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,44px);font-weight:400;color:var(--gf-dark);text-align:center;margin-bottom:48px">Your Pantry Box</h1>
  {%- if cart.item_count == 0 -%}<div style="text-align:center;padding:80px 20px"><div style="font-size:48px;margin-bottom:20px">🧀</div><h2 style="font-family:'Playfair Display',serif;font-size:28px;font-weight:400;color:var(--gf-dark);margin-bottom:12px">Your pantry box is empty</h2><p style="color:var(--gf-muted);margin-bottom:32px">Fill it with aged cheeses, oils, and small-batch preserves</p><a href="/collections/all" class="gf-btn">EXPLORE PANTRY</a></div>
  {%- else -%}
  <div style="display:grid;grid-template-columns:1fr 380px;gap:48px;align-items:start">
    <div>{%- for item in cart.items -%}<div style="display:flex;gap:20px;padding:24px 0;border-bottom:1px solid var(--gf-border);align-items:center"><a href="{{ item.url }}" style="flex-shrink:0"><img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="100" style="border-radius:8px;object-fit:cover"></a><div style="flex:1;min-width:0"><a href="{{ item.url }}" style="text-decoration:none;font-family:'Playfair Display',serif;font-size:15px;color:var(--gf-dark);display:block;margin-bottom:4px;font-weight:600">{{ item.product.title }}</a>{%- unless item.variant.title == 'Default Title' -%}<div style="font-size:13px;color:var(--gf-muted);margin-bottom:8px">{{ item.variant.title }}</div>{%- endunless -%}<div style="display:flex;align-items:center;gap:12px"><div style="display:flex;align-items:center;border:1px solid var(--gf-border);border-radius:8px;background:#fff;overflow:hidden"><button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px">−</button><span style="width:32px;text-align:center;font-size:14px;font-weight:600">{{ item.quantity }}</span><button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px">+</button></div><a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" style="font-size:12px;color:var(--gf-muted);text-decoration:underline">Remove</a></div></div><div style="font-size:16px;font-weight:700;color:var(--gf-terracotta)">{{ item.final_line_price | money }}</div></div>{%- endfor -%}</div>
    <div style="background:#fff;border-radius:8px;padding:32px;border:1px solid var(--gf-border);position:sticky;top:120px">
      <h3 style="font-family:'Playfair Display',serif;font-size:16px;font-weight:700;color:var(--gf-dark);margin-bottom:24px">Box Summary</h3>
      <div style="display:flex;justify-content:space-between;margin-bottom:12px;font-size:14px"><span style="color:var(--gf-muted)">Subtotal</span><span style="font-weight:600">{{ cart.total_price | money }}</span></div>
      <div style="display:flex;justify-content:space-between;margin-bottom:12px;font-size:14px"><span style="color:var(--gf-muted)">Shipping</span><span style="font-weight:600;color:var(--gf-olive)">Free</span></div>
      <div style="padding-top:16px;border-top:1px solid var(--gf-border);margin-top:16px;display:flex;justify-content:space-between;margin-bottom:24px"><span style="font-size:16px;font-weight:700">Total</span><span style="font-size:20px;font-weight:700;color:var(--gf-dark)">{{ cart.total_price | money }}</span></div>
      <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="gf-btn" style="width:100%;justify-content:center">CHECKOUT</button></form>
      <div style="display:flex;justify-content:center;gap:14px;margin-top:16px"><span style="font-size:11px;color:var(--gf-muted)">✓ Small Batch</span><span style="font-size:11px;color:var(--gf-muted)">🚚 Free Ship</span><span style="font-size:11px;color:var(--gf-muted)">↩ Estate Fresh</span></div>
    </div>
  </div>{%- endif -%}
</div></div>
{% schema %}
{"name":"GF Cart","settings":[],"presets":[{"name":"GF Cart"}]}
{% endschema %}
