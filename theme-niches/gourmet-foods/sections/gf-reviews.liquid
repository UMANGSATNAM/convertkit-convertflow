<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="gf-section-header"><span class="gf-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="gf-review-grid">{%- for block in section.blocks -%}<div class="gf-review-card" {{ block.shopify_attributes }}><div class="gf-review-card__stars">★★★★★</div><div class="gf-review-card__text">"{{ block.settings.quote }}"</div><div class="gf-review-card__author">{{ block.settings.name }}</div><div class="gf-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Gourmet Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PANTRY DIARIES"},{"type":"text","id":"heading","label":"Heading","default":"Stories of Pure Taste"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Gourmet Reviews","blocks":[{"type":"review","settings":{"quote":"The 12-year aged balsamic vinegar is velvety. Drizzling it over Parmigiano is heaven.","name":"Clara M.","product":"12yr Aged Balsamic"}},{"type":"review","settings":{"quote":"Incredible cold pressed olive oil. Peppery, grassy, and completely fresh. Cooking is elevated.","name":"Marco R.","product":"Coratina Extra Virgin Oil"}},{"type":"review","settings":{"quote":"The white truffle butter transformed our homemade pasta. Sensory luxury at home!","name":"Priya K.","product":"White Truffle Butter"}}]}]}
{% endschema %}
