<div class="gf-hero">
  <div class="gf-hero__content">
    <span class="gf-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="gf-hero__title">{{ section.settings.heading }}</h1>
    <p class="gf-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="gf-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="gf-btn gf-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="gf-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--gf-olive)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Gourmet Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ARTISANAL PANTRY"},{"type":"text","id":"heading","label":"Heading","default":"Honest Flavors, Sourced Slowly"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Hand-crafted cheeses, cold-pressed oils, and micro-batch preserves curated directly from family-owned estates."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"SHOP THE PANTRY"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"OUR ESTATES"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Gourmet Hero"}]}
{% endschema %}
