<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="gf-section-header"><span class="gf-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="gf-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="gf-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--gf-olive)"></div>{%- endif -%}<div class="gf-col-card__overlay"><span class="gf-col-card__title">{{ block.settings.title }}</span><span class="gf-col-card__cta">Explore Cellar →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Gourmet Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE PANTRY SECTIONS"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Category"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Artisan Cheese"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Gourmet Collections","blocks":[{"type":"col","settings":{"title":"Aged Cheese & Charcuterie"}},{"type":"col","settings":{"title":"Estate Olive Oils"}},{"type":"col","settings":{"title":"Small-Batch Preserves"}}]}]}
{% endschema %}
