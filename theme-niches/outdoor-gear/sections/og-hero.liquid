<div class="og-hero">
  <div class="og-hero__content">
    <span class="og-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="og-hero__title">{{ section.settings.heading }}</h1>
    <p class="og-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="og-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/specifications' }}" class="og-btn og-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="og-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--og-orange)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Outdoor Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"TRAIL-TESTED UTILITY"},{"type":"text","id":"heading","label":"RUGGED ALPINE CLIMBING GEAR"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Expedition-ready shelter, pack rigs, and performance apparel designed to withstand negative temperatures and harsh elements."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"EQUIP NOW"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"SPEC SHEET"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Outdoor Hero"}]}
{% endschema %}
