<div style="background:#2B2B2B; position:relative; min-height:85vh; display:flex; align-items:flex-end; padding-bottom:80px; overflow:hidden;">
  
  <!-- Background Image with Overlay -->
  <div style="position:absolute; inset:0; z-index:1;">
    <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=2000&q=80" alt="Mountains" style="width:100%; height:100%; object-fit:cover; object-position:center; filter:brightness(0.7);" loading="eager">
    <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(43,43,43,1) 0%, rgba(43,43,43,0.3) 50%, rgba(43,43,43,0.1) 100%);"></div>
  </div>

  <div style="max-width:1440px; margin:0 auto; width:100%; padding:0 40px; position:relative; z-index:2;">
    <div style="max-width:800px;">
      
      <div style="display:inline-block; font-family:'Inter', sans-serif; font-size:14px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#D97736; margin-bottom:16px; background:rgba(0,0,0,0.5); padding:6px 16px; border-radius:4px; backdrop-filter:blur(4px);">
        {{ section.settings.eyebrow }}
      </div>
      
      <h1 style="font-family:'Oswald', sans-serif; font-size:clamp(64px, 8vw, 100px); font-weight:700; line-height:1; color:#FFFFFF; margin:0 0 24px 0; text-transform:uppercase; letter-spacing:-1px;">
        {{ section.settings.heading }}
      </h1>
      
      <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:400; line-height:1.6; color:#E0E0E0; margin:0 0 40px 0; max-width:600px;">
        {{ section.settings.subheading }}
      </p>
      
      <div style="display:flex; gap:20px; align-items:center; flex-wrap:wrap;">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-block; font-family:'Inter', sans-serif; font-size:15px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#FFFFFF; background:#D97736; padding:18px 40px; text-decoration:none; transition:all 0.3s ease; border-radius:4px; border:2px solid #D97736;" class="og-btn-primary">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
        
        <a href="#video" style="display:inline-flex; align-items:center; gap:12px; font-family:'Inter', sans-serif; font-size:15px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#FFFFFF; text-decoration:none; transition:color 0.3s ease;" class="og-link-hover">
          <svg style="width:24px; height:24px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round;" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>
          Watch the Film
        </a>
      </div>
      
    </div>
  </div>

  <!-- Decorative technical lines -->
  <div style="position:absolute; bottom:0; right:40px; z-index:2; display:flex; gap:40px; padding-bottom:40px; opacity:0.5; font-family:'Inter', sans-serif; font-size:12px; color:#FFFFFF; font-family:monospace; letter-spacing:2px;">
    <div>ELEV: 4,392M</div>
    <div>COORD: 45.83° N, 6.86° E</div>
    <div>TEMP: -12°C</div>
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap');
    
    .og-btn-primary:hover { background: transparent; color: #D97736; }
    .og-link-hover:hover { color: #D97736; }
    
    @media (max-width: 768px) {
      div[style*="max-width:800px"] { text-align: left; }
      div[style*="padding-bottom:40px"] { display: none; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Outdoor Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NEW EXPLORER SERIES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Embrace the Wild."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Purpose-built gear for those who seek the extraordinary. Tested in the harshest environments on earth."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP THE SERIES"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Outdoor Hero"
    }
  ]
}
{% endschema %}
