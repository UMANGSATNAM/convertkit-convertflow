<div style="padding:80px 20px;background:var(--og-white);border-bottom:1px solid var(--og-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="og-section-header"><span class="og-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="og-review-grid">{%- for block in section.blocks -%}<div class="og-review-card" {{ block.shopify_attributes }}><div class="og-review-card__stars">★★★★★</div><div class="og-review-card__text">"{{ block.settings.quote }}"</div><div class="og-review-card__author">{{ block.settings.name }}</div><div class="og-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Outdoor Reviews","settings":[{"type":"text","id":"eyebrow","label":"TRAIL INSIGHTS"},{"type":"text","id":"heading","label":"Heading","default":"Tested by Mountaineers"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Outdoor Reviews","blocks":[{"type":"review","settings":{"quote":"Held up perfectly during a heavy storm on Mount Rainier. Zero leaks and stayed beautifully stable in high winds.","name":"Clara M.","product":"Alpine Dome Tent"}},{"type":"review","settings":{"quote":"Extremely comfortable suspension system. Distributed 50 lbs effortlessly across the trail. Highly recommended.","name":"Jake S.","product":"Expedition Pack Rig"}},{"type":"review","settings":{"quote":"Surprisingly compact yet kept me completely warm in sub-freezing conditions. Worth every penny.","name":"Tenzing N.","product":"Thermal Wear Layer"}}]}]}
{% endschema %}
