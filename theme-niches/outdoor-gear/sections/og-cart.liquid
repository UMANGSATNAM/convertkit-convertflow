<div style="padding:60px 20px 100px;background:var(--og-trail);min-height:60vh;border-bottom:1px solid var(--og-border)"><div style="max-width:960px;margin:0 auto">
  <h1 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(28px,4vw,40px);font-weight:800;color:var(--og-dark);text-align:center;margin-bottom:56px;letter-spacing:-0.02em;text-transform:uppercase">RIG CHECK</h1>
  {%- if cart.item_count == 0 -%}<div style="text-align:center;padding:80px 20px"><div style="font-size:40px;margin-bottom:24px;filter:grayscale(1)">🎒</div><h2 style="font-family:'Space Grotesk',sans-serif;font-size:28px;font-weight:800;color:var(--og-dark);margin-bottom:12px;letter-spacing:-0.02em;text-transform:uppercase">Your rig chest is empty</h2><p style="font-family:'Space Grotesk',sans-serif;color:var(--og-muted);margin-bottom:36px;font-weight:800">Add dome tents, mountain packs, and thermal layers to your expedition.</p><a href="/collections/all" class="og-btn">EXPLORE GEAR</a></div>
  {%- else -%}
  <div style="display:grid;grid-template-columns:1fr 380px;gap:48px;align-items:start">
    <div>{%- for item in cart.items -%}<div style="display:flex;gap:24px;padding:28px 0;border-bottom:2px solid var(--og-border);align-items:center"><a href="{{ item.url }}" style="flex-shrink:0"><img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="100" style="object-fit:contain;background:#fff;padding:10px;border:2px solid var(--og-border);border-radius:4px"></a><div style="flex:1;min-width:0"><a href="{{ item.url }}" style="text-decoration:none;font-family:'Space Grotesk',sans-serif;font-weight:800;font-size:16px;color:var(--og-dark);display:block;margin-bottom:4px;text-transform:uppercase">{{ item.product.title }}</a>{%- unless item.variant.title == 'Default Title' -%}<div style="font-family:'Space Grotesk',sans-serif;font-size:12px;color:var(--og-muted);margin-bottom:12px;font-weight:600">{{ item.variant.title }}</div>{%- endunless -%}<div style="display:flex;align-items:center;gap:16px"><div style="display:flex;align-items:center;border:2px solid var(--og-border);overflow:hidden;background:#fff;border-radius:4px"><button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px">−</button><span style="width:32px;text-align:center;font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:800;color:var(--og-dark)">{{ item.quantity }}</span><button type="button" style="width:32px;height:36px;background:none;border:none;cursor:pointer;font-size:16px">+</button></div><a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" style="font-family:'Space Grotesk',sans-serif;font-size:11px;color:var(--og-muted);text-transform:uppercase;letter-spacing:0.05em;text-decoration:underline;font-weight:800">Remove</a></div></div><div style="font-family:'Space Grotesk',sans-serif;font-size:16px;font-weight:800;color:var(--og-orange)">{{ item.final_line_price | money }}</div></div>{%- endfor -%}</div>
    <div style="background:#fff;padding:40px;border:2px solid var(--og-border);border-radius:4px;position:sticky;top:120px">
      <h3 style="font-family:'Space Grotesk',sans-serif;font-size:18px;font-weight:900;color:var(--og-dark);margin-bottom:28px;text-transform:uppercase">Rig Summary</h3>
      <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-family:'Space Grotesk',sans-serif;font-size:14px;font-weight:600"><span style="color:var(--og-muted)">Subtotal</span><span style="font-weight:800;color:var(--og-dark)">{{ cart.total_price | money }}</span></div>
      <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-family:'Space Grotesk',sans-serif;font-size:14px;font-weight:600"><span style="color:var(--og-muted)">Secured Rig Shipping</span><span style="font-weight:800;color:var(--og-orange)">Free</span></div>
      <div style="padding-top:20px;border-top:2px solid var(--og-border);margin-top:20px;display:flex;justify-content:space-between;margin-bottom:32px"><span style="font-family:'Space Grotesk',sans-serif;font-size:18px;font-weight:900;color:var(--og-dark);text-transform:uppercase">Total</span><span style="font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:900;color:var(--og-orange)">{{ cart.total_price | money }}</span></div>
      <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="og-btn" style="width:100%;justify-content:center">CHECKOUT</button></form>
      <div style="display:flex;flex-direction:column;gap:8px;margin-top:24px;text-align:center"><span style="font-size:11px;font-family:'Space Grotesk',sans-serif;font-weight:800;color:var(--og-muted)">✓ lifetime repair warranty certification</span><span style="font-size:11px;font-family:'Space Grotesk',sans-serif;font-weight:800;color:var(--og-muted)">🚚 heavy padding weather-proof courier</span></div>
    </div>
  </div>{%- endif -%}
</div></div>
{% schema %}
{"name":"Outdoor Cart","settings":[],"presets":[{"name":"Outdoor Cart"}]}
{% endschema %}
