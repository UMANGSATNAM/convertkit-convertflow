<div style="background:#2B2B2B; position:relative; overflow:hidden;">
  <div style="display:flex; flex-wrap:wrap; min-height:80vh;">
    
    <!-- Image Half -->
    <div style="flex:1 1 50%; min-width:300px; position:relative;">
      <img src="https://images.unsplash.com/photo-1542273917363-3b1817f69a2d?auto=format&fit=crop&w=1200&q=80" alt="Nature" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:brightness(0.8);" loading="lazy">
      
      <!-- 1% Badge -->
      <div style="position:absolute; top:40px; right:40px; width:100px; height:100px; background:#D97736; border-radius:50%; display:flex; flex-direction:column; justify-content:center; align-items:center; color:#FFFFFF; transform:rotate(15deg); box-shadow:0 10px 20px rgba(0,0,0,0.3);">
        <div style="font-family:'Oswald', sans-serif; font-size:32px; font-weight:700; line-height:1;">1%</div>
        <div style="font-family:'Inter', sans-serif; font-size:10px; font-weight:700; text-transform:uppercase; text-align:center; line-height:1.2;">For The<br>Planet</div>
      </div>
    </div>
    
    <!-- Content Half -->
    <div style="flex:1 1 50%; min-width:300px; display:flex; align-items:center; padding:80px 8%; background:#2B2B2B;">
      <div>
        <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(40px, 5vw, 64px); font-weight:700; line-height:1.1; color:#FFFFFF; margin:0 0 24px 0; text-transform:uppercase;">
          {{ section.settings.heading }}
        </h2>
        
        <div style="width:60px; height:4px; background:#D97736; margin-bottom:40px;"></div>
        
        <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:400; line-height:1.6; color:#E0E0E0; margin:0 0 48px 0;">
          {{ section.settings.subheading }}
        </p>
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/pages/sustainability' }}" style="display:inline-flex; align-items:center; justify-content:center; font-family:'Inter', sans-serif; font-size:15px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#FFFFFF; border:2px solid #FFFFFF; padding:18px 40px; border-radius:4px; text-decoration:none; transition:all 0.3s ease;" class="og-btn-outline">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
    
  </div>

  <style>
    .og-btn-outline:hover { background: #FFFFFF; color: #2B2B2B; }
  </style>
</div>

{% schema %}
{
  "name": "Outdoor Sustainability",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Protect the Places We Play"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We commit 1% of all sales to environmental restoration projects. Our gear is made with recycled materials and ethical labor."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "OUR MISSION"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Outdoor Sustainability"
    }
  ]
}
{% endschema %}
