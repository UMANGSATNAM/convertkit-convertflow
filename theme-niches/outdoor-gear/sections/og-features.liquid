<div style="background:#2B2B2B; padding:120px 40px; color:#FFFFFF;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:80px;">
      <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(36px, 5vw, 56px); font-weight:700; color:#FFFFFF; margin:0 0 16px 0; text-transform:uppercase;">
        {{ section.settings.heading }}
      </h2>
      <div style="width:60px; height:4px; background:#D97736; margin:0 auto;"></div>
    </div>

    <div class="og-features-grid" style="display:grid; grid-template-columns:repeat({{ section.blocks.size | default: 3 }}, 1fr); gap:60px;">
      
      {%- for block in section.blocks -%}
        <div style="text-align:center;" class="og-feature-item">
          
          <div style="width:80px; height:80px; border:2px solid #D97736; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 32px auto; transition:all 0.4s ease;" class="og-feature-icon">
            <svg style="width:40px; height:40px; fill:none; stroke:#D97736; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; transition:all 0.4s ease;" viewBox="0 0 24 24">
              {% if forloop.index == 1 %}
                <!-- Shield / Protection -->
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              {% elsif forloop.index == 2 %}
                <!-- Feather / Light -->
                <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/><line x1="16" y1="8" x2="2" y2="22"/><line x1="17.5" y1="15" x2="9" y2="15"/>
              {% else %}
                <!-- Infinity / Warranty -->
                <path d="M18.178 8c5.096 0 5.096 8 0 8-5.095 0-7.133-8-12.739-8-4.585 0-4.584 8 0 8 5.606 0 7.644-8 12.739-8z"/>
              {% endif %}
            </svg>
          </div>
          
          <h3 style="font-family:'Oswald', sans-serif; font-size:24px; font-weight:500; text-transform:uppercase; margin:0 0 16px 0;">
            {{ block.settings.title }}
          </h3>
          
          <p style="font-family:'Inter', sans-serif; font-size:16px; font-weight:400; line-height:1.6; color:#AAAAAA; margin:0 auto; max-width:320px;">
            {{ block.settings.desc }}
          </p>
          
        </div>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .og-feature-item:hover .og-feature-icon { background: #D97736; transform: translateY(-10px); }
    .og-feature-item:hover .og-feature-icon svg { stroke: #FFFFFF; }
    
    @media (max-width: 990px) {
      .og-features-grid { grid-template-columns: 1fr; gap: 60px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Outdoor Features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered for Extremes"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "GORE-TEX PRO"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Guaranteed to keep you dry in the most torrential downpours."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Outdoor Features",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
