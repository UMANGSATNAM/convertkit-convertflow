<div style="padding:80px 20px;background:var(--og-dark);border-bottom:1px solid var(--og-border)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="og-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(28px,4vw,48px);font-weight:800;color:var(--og-white);margin-bottom:20px;line-height:1.0;letter-spacing:-0.02em;text-transform:uppercase">{{ section.settings.heading }}</h2>
    <p style="font-family:'Outfit',sans-serif;font-size:15px;color:var(--og-muted);line-height:1.7;max-width:440px;font-weight:500">{{ section.settings.body }}</p>
    <div class="og-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="og-stat" style="border-color:var(--og-orange);background:var(--og-granite)" {{ block.shopify_attributes }}><div class="og-stat__num" style="color:var(--og-orange)">{{ block.settings.number }}</div><div class="og-stat__label" style="color:var(--og-white)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:4px;border:2px solid var(--og-orange);object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:1.1;background:var(--og-granite);border-radius:4px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Outdoor Specs","settings":[{"type":"text","id":"eyebrow","label":"ALPINE RATINGS"},{"type":"text","id":"heading","label":"Heading","default":"Tested in Extreme Cold."},{"type":"textarea","id":"body","label":"Body","default":"Rugged materials certified for sub-zero alpine routes, offering superior durability index scores."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"-20°C"},{"type":"text","id":"label","label":"Label","default":"Temperature Limit"}]}],"presets":[{"name":"Outdoor Specs","blocks":[{"type":"stat","settings":{"number":"-20°C","label":"R-Value Rated"}},{"type":"stat","settings":{"number":"1200D","label":"Granite Cordura"}},{"type":"stat","settings":{"number":"100%","label":"Waterproof Index"}},{"type":"stat","settings":{"number":"Ultralight","label":"Frame Config"}}]}]}
{% endschema %}
