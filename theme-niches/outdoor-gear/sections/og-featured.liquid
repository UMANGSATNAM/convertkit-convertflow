<div style="background:#F4F1EA; padding:120px 40px; position:relative; overflow:hidden;">
  <div style="max-width:1440px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
    
    <!-- Visual -->
    <div style="position:relative;">
      <!-- Topographical pattern background -->
      <div style="position:absolute; inset:-40px; background-image:url('data:image/svg+xml;utf8,<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M10,50 Q25,25 50,50 T90,50\" fill=\"none\" stroke=\"%23D97736\" stroke-width=\"0.5\" opacity=\"0.2\"/></svg>'); background-size:100px 100px; z-index:1;"></div>
      
      <div style="position:relative; z-index:2; background:#FFFFFF; border:1px solid #E5E0D8; padding:20px;">
        <img src="https://images.unsplash.com/photo-1622260614153-03223fb72052?auto=format&fit=crop&w=1000&q=80" alt="Featured Jacket" style="width:100%; height:auto; display:block; filter:contrast(1.1);" loading="lazy">
        
        <!-- Hotspots -->
        <div style="position:absolute; top:30%; left:20%; width:24px; height:24px; background:#D97736; border-radius:50%; border:4px solid #FFFFFF; cursor:pointer;" class="og-hotspot" title="Helmet-compatible hood"></div>
        <div style="position:absolute; top:55%; right:25%; width:24px; height:24px; background:#D97736; border-radius:50%; border:4px solid #FFFFFF; cursor:pointer;" class="og-hotspot" title="Water-resistant zippers"></div>
      </div>
    </div>
    
    <!-- Content -->
    <div style="position:relative; z-index:3;">
      <div style="display:inline-block; font-family:'Inter', sans-serif; font-size:14px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#D97736; margin-bottom:16px;">
        {{ section.settings.eyebrow }}
      </div>
      
      <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(40px, 5vw, 64px); font-weight:700; line-height:1.1; color:#2B2B2B; margin:0 0 24px 0; text-transform:uppercase;">
        {{ section.settings.heading }}
      </h2>
      
      <p style="font-family:'Inter', sans-serif; font-size:18px; font-weight:400; line-height:1.6; color:#555555; margin:0 0 40px 0;">
        {{ section.settings.subheading }}
      </p>
      
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-bottom:48px;">
        <div style="border-left:2px solid #D97736; padding-left:16px;">
          <div style="font-family:'Oswald', sans-serif; font-size:24px; font-weight:600; color:#2B2B2B;">310g</div>
          <div style="font-family:'Inter', sans-serif; font-size:14px; color:#888888; text-transform:uppercase; letter-spacing:1px;">Weight</div>
        </div>
        <div style="border-left:2px solid #D97736; padding-left:16px;">
          <div style="font-family:'Oswald', sans-serif; font-size:24px; font-weight:600; color:#2B2B2B;">28,000mm</div>
          <div style="font-family:'Inter', sans-serif; font-size:14px; color:#888888; text-transform:uppercase; letter-spacing:1px;">Waterproof Rating</div>
        </div>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/products/jacket' }}" style="display:inline-flex; align-items:center; justify-content:center; font-family:'Inter', sans-serif; font-size:15px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#FFFFFF; background:#2B2B2B; padding:18px 40px; border-radius:4px; text-decoration:none; transition:background 0.3s ease;" class="og-btn-dark">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>
    
  </div>

  <style>
    .og-btn-dark:hover { background: #D97736; }
    .og-hotspot { transition: transform 0.3s ease; box-shadow: 0 0 0 rgba(217,119,54,0.4); animation: og-pulse 2s infinite; }
    .og-hotspot:hover { transform: scale(1.2); animation: none; }
    
    @keyframes og-pulse {
      0% { box-shadow: 0 0 0 0 rgba(217,119,54,0.7); }
      70% { box-shadow: 0 0 0 10px rgba(217,119,54,0); }
      100% { box-shadow: 0 0 0 0 rgba(217,119,54,0); }
    }
    
    @media (max-width: 990px) {
      div[style*="display:grid; grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr; gap: 60px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Outdoor Featured",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "GEAR OF THE YEAR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Summit Alpha Jacket"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our most advanced hardshell yet. Featuring micro-seam technology and dynamic ventilation for high-output alpine pursuits."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "EXPLORE THE JACKET"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Outdoor Featured"
    }
  ]
}
{% endschema %}
