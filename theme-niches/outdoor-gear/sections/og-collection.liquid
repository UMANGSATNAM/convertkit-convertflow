<div style="background:#F4F1EA; padding:120px 40px;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:60px; flex-wrap:wrap; gap:24px;">
      <div>
        <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(32px, 4vw, 48px); font-weight:700; color:#2B2B2B; margin:0 0 16px 0; text-transform:uppercase;">
          {{ section.settings.heading }}
        </h2>
        <div style="width:60px; height:4px; background:#D97736;"></div>
      </div>
      
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="font-family:'Inter', sans-serif; font-size:14px; font-weight:700; color:#D97736; text-decoration:none; display:flex; align-items:center; gap:8px; text-transform:uppercase; letter-spacing:1px; border-bottom:2px solid transparent; padding-bottom:4px; transition:border-color 0.3s ease;" class="og-link-btn">
          {{ section.settings.cta_label }}
          <svg style="width:20px; height:20px; fill:currentColor;" viewBox="0 0 24 24"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="og-product-grid" style="display:grid; grid-template-columns:repeat({{ section.settings.count | default: 4 }}, 1fr); gap:30px;">
      
      {%- assign products_count = section.settings.count | default: 4 -%}
      {%- for i in (1..products_count) -%}
        {%- assign idx = forloop.index | modulo: 4 -%}
        {%- assign img_url = 'https://images.unsplash.com/photo-1522204657746-fccce0824cfd?auto=format&fit=crop&w=600&q=80' -%}
        {%- if idx == 1 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1622260614153-03223fb72052?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1563298723-dcfebaa392e3?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1575200384814-74a48557d079?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        {%- if idx == 0 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1551632811-561732d1e306?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
        
        <div class="og-product-card" style="background:#FFFFFF; border:1px solid #E5E0D8; transition:all 0.3s ease; position:relative; display:flex; flex-direction:column; height:100%;">
          
          <a href="#" style="display:block; text-decoration:none; position:relative; overflow:hidden; padding-bottom:120%; background:#F9F8F6;">
            <img src="{{ img_url }}" alt="Product" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease;" class="og-product-img" loading="lazy">
            
            {% if idx == 1 %}
              <div style="position:absolute; top:16px; left:16px; background:#D97736; color:#FFFFFF; font-family:'Inter', sans-serif; font-size:11px; font-weight:700; padding:6px 12px; letter-spacing:1px; text-transform:uppercase;">
                Top Rated
              </div>
            {% endif %}
          </a>
          
          <div style="padding:24px; display:flex; flex-direction:column; flex-grow:1;">
            
            <div style="font-family:'Inter', sans-serif; font-size:12px; font-weight:600; color:#888888; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">
              {% if idx == 1 %}Apparel{% elsif idx == 2 %}Equipment{% elsif idx == 3 %}Footwear{% else %}Accessories{% endif %}
            </div>
            
            <h3 style="font-family:'Oswald', sans-serif; font-size:22px; font-weight:500; color:#2B2B2B; margin:0 0 12px 0; text-transform:uppercase; flex-grow:1;">
              {% if idx == 1 %}Alpine Shell Jacket{% elsif idx == 2 %}Titanium Carabiner{% elsif idx == 3 %}Approach Pro Boots{% else %}Merino Wool Beanie{% endif %}
            </h3>
            
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:auto; padding-top:16px; border-top:1px solid #E5E0D8;">
              <div style="font-family:'Inter', sans-serif; font-size:18px; font-weight:700; color:#2B2B2B;">
                {% if idx == 1 %}$299.00{% elsif idx == 2 %}$24.00{% elsif idx == 3 %}$185.00{% else %}$35.00{% endif %}
              </div>
              <button style="width:40px; height:40px; background:#2B2B2B; color:#FFFFFF; border:none; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:background 0.3s ease;" class="og-add-btn">
                <svg style="width:20px; height:20px; fill:currentColor;" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
              </button>
            </div>
          </div>
        </div>
      {%- endfor -%}
      
    </div>

  </div>

  <style>
    .og-link-btn:hover { border-bottom-color: #D97736; }
    .og-product-card:hover { border-color: #D97736; box-shadow: 0 15px 30px rgba(0,0,0,0.05); transform: translateY(-5px); }
    .og-product-card:hover .og-product-img { transform: scale(1.05); }
    .og-add-btn:hover { background: #D97736; }
    
    @media (max-width: 1024px) {
      .og-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 30px !important; }
    }
    @media (max-width: 640px) {
      .og-product-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Outdoor Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Essential Equipment"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "VIEW ALL GEAR"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Outdoor Collection"
    }
  ]
}
{% endschema %}
