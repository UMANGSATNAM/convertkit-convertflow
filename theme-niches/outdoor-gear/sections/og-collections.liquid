<div style="padding:80px 20px;background:var(--og-white);border-bottom:1px solid var(--og-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="og-section-header"><span class="og-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="og-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="og-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--og-orange)"></div>{%- endif -%}<div class="og-col-card__overlay"><span class="og-col-card__title">{{ block.settings.title }}</span><span class="og-col-card__cta">EQUIP CATEGORY →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Outdoor Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"GEAR MATRIX"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Expedition"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Alpine Packs"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Outdoor Collections","blocks":[{"type":"col","settings":{"title":"Four-Season Tents"}},{"type":"col","settings":{"title":"Expedition Pack Rigs"}},{"type":"col","settings":{"title":"Thermal Wear Layer"}}]}]}
{% endschema %}
