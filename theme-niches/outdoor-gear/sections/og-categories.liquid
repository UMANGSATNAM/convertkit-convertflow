<div style="background:#F4F1EA; padding:100px 40px; border-bottom:1px solid #E5E0D8;">
  <div style="max-width:1440px; margin:0 auto;">
    
    <div style="text-align:center; margin-bottom:60px;">
      <h2 style="font-family:'Oswald', sans-serif; font-size:clamp(36px, 5vw, 48px); font-weight:700; color:#2B2B2B; margin:0 0 16px 0; text-transform:uppercase;">
        {{ section.settings.heading }}
      </h2>
      <div style="width:60px; height:4px; background:#D97736; margin:0 auto;"></div>
    </div>

    <div class="og-cat-grid" style="display:grid; grid-template-columns:repeat(4, 1fr); gap:20px;">
      
      {%- for block in section.blocks -%}
        <a href="#" class="og-cat-card" style="display:block; position:relative; overflow:hidden; text-decoration:none; height:400px; background:#2B2B2B;">
          
          {%- assign img_url = 'https://images.unsplash.com/photo-1551632811-561732d1e306?auto=format&fit=crop&w=600&q=80' -%}
          {%- if forloop.index == 2 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1522163182402-834f871fd851?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
          {%- if forloop.index == 3 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1504280390227-36109ebda5ed?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
          {%- if forloop.index == 4 -%}{%- assign img_url = 'https://images.unsplash.com/photo-1519092440938-161b4db1b3dc?auto=format&fit=crop&w=600&q=80' -%}{%- endif -%}
          
          <img src="{{ img_url }}" alt="{{ block.settings.title }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94); filter:brightness(0.7);" class="og-cat-img" loading="lazy">
          
          <!-- Gradient Overlay -->
          <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 50%);"></div>
          
          <!-- Content -->
          <div style="position:absolute; bottom:0; left:0; width:100%; padding:30px; display:flex; justify-content:space-between; align-items:flex-end;">
            <h3 style="font-family:'Oswald', sans-serif; font-size:28px; font-weight:600; color:#FFFFFF; margin:0; text-transform:uppercase; transition:color 0.3s ease;" class="og-cat-title">
              {{ block.settings.title }}
            </h3>
            
            <div style="width:40px; height:40px; background:#D97736; border-radius:50%; display:flex; align-items:center; justify-content:center; transform:translateX(20px); opacity:0; transition:all 0.3s ease;" class="og-cat-arrow">
              <svg style="width:20px; height:20px; fill:#FFFFFF;" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </div>
          
        </a>
      {%- else -%}
        <!-- Fallback -->
      {%- endfor -%}
      
    </div>
  </div>

  <style>
    .og-cat-card:hover .og-cat-img { transform: scale(1.05); filter: brightness(0.9); }
    .og-cat-card:hover .og-cat-title { color: #D97736; }
    .og-cat-card:hover .og-cat-arrow { transform: translateX(0); opacity: 1; }
    
    @media (max-width: 1024px) {
      .og-cat-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
      .og-cat-card { height: 350px; }
    }
    @media (max-width: 640px) {
      .og-cat-grid { grid-template-columns: 1fr; }
      .og-cat-card { height: 300px; }
    }
  </style>
</div>

{% schema %}
{
  "name": "Outdoor Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pursue Your Passion"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Hiking"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Outdoor Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
