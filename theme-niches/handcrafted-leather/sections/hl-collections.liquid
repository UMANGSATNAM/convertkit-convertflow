<div style="padding:80px 20px;background:#fff;border-bottom:1px solid var(--hl-border)"><div style="max-width:1320px;margin:0 auto">
  <div class="hl-section-header"><span class="hl-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="hl-col-grid">{%- for block in section.blocks -%}<a href="{{ block.settings.url | default: '/collections/all' }}" class="hl-col-card" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" width="800" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--hl-saddle)"></div>{%- endif -%}<div class="hl-col-card__overlay"><span class="hl-col-card__title">{{ block.settings.title }}</span><span class="hl-col-card__cta">Explore Workshop →</span></div></a>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Leather Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"WORKSHOP SECTIONS"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Category"}],"blocks":[{"type":"col","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"Heritage Bags"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"url","label":"URL"}]}],"presets":[{"name":"Leather Collections","blocks":[{"type":"col","settings":{"title":"Heritage Bags"}},{"type":"col","settings":{"title":"Minimalist Wallets"}},{"type":"col","settings":{"title":"Desktop Desk Pads"}}]}]}
{% endschema %}
