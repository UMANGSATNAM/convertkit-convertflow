<div style="padding:80px 20px;background:#fff"><div style="max-width:1320px;margin:0 auto">
  <div class="hl-section-header"><span class="hl-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
  <div class="hl-review-grid">{%- for block in section.blocks -%}<div class="hl-review-card" {{ block.shopify_attributes }}><div class="hl-review-card__stars">★★★★★</div><div class="hl-review-card__text">"{{ block.settings.quote }}"</div><div class="hl-review-card__author">{{ block.settings.name }}</div><div class="hl-review-card__meta">{{ block.settings.product }}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"Leather Reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PATRONS OF CRAFT"},{"type":"text","id":"heading","label":"Heading","default":"Testimonials of Wear"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"name","label":"Name"},{"type":"text","id":"product","label":"Product"}]}],"presets":[{"name":"Leather Reviews","blocks":[{"type":"review","settings":{"quote":"The heritage satchel is absolute perfection. The saddle leather is already aging beautifully.","name":"Clara T.","product":"Heritage Leather Satchel"}},{"type":"review","settings":{"quote":"Heavy duty waxed stitching and solid brass hardware. This wallet is indestructible.","name":"Marco K.","product":"Minimalist Cardholder"}},{"type":"review","settings":{"quote":"You can smell the rich vegetable tanned leather the moment you open the box. Highly recommended.","name":"Priya J.","product":"Leather Desk Pad"}}]}]}
{% endschema %}
