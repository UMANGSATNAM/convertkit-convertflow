<div style="padding:80px 20px;background:var(--hl-dark)"><div style="max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
  <div>
    <span class="hl-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,48px);font-weight:400;color:var(--hl-cream);margin-bottom:20px;line-height:1.1">{{ section.settings.heading }}</h2>
    <p style="font-family:'Lora',serif;font-size:16px;color:var(--hl-muted);line-height:1.8;max-width:440px">{{ section.settings.body }}</p>
    <div class="hl-stat-grid" style="background:transparent">{%- for block in section.blocks -%}<div class="hl-stat" style="border-color:rgba(232,223,206,0.15);background:rgba(255,255,255,0.02)" {{ block.shopify_attributes }}><div class="hl-stat__num" style="color:var(--hl-tan)">{{ block.settings.number }}</div><div class="hl-stat__label" style="color:var(--hl-muted)">{{ block.settings.label }}</div></div>{%- endfor -%}</div>
  </div>
  <div>{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="800" style="width:100%;border-radius:6px;object-fit:cover" loading="lazy">{%- else -%}<div style="aspect-ratio:4/5;background:var(--hl-saddle);border-radius:6px"></div>{%- endif -%}</div>
</div></div>
{% schema %}
{"name":"Leather Story","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"OUR WORKSHOP ETHOS"},{"type":"text","id":"heading","label":"Heading","default":"Built to outlive us."},{"type":"textarea","id":"body","label":"Body","default":"Using thick 11oz full-grain hides sourced from historic Italian tanneries, we manually cut, stitch, and dye every single piece. Designed for generations of patina."},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"100%"},{"type":"text","id":"label","label":"Label","default":"Full Grain"}]}],"presets":[{"name":"Leather Story","blocks":[{"type":"stat","settings":{"number":"100%","label":"Full Grain Hides"}},{"type":"stat","settings":{"number":"Hand","label":"Stitched Thread"}},{"type":"stat","settings":{"number":"Beeswax","label":"Finished Edges"}},{"type":"stat","settings":{"number":"Lifetime","label":"Stitch Warranty"}}]}]}
{% endschema %}
