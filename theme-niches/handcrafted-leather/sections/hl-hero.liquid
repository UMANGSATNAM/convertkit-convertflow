<div class="hl-hero">
  <div class="hl-hero__content">
    <span class="hl-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="hl-hero__title">{{ section.settings.heading }}</h1>
    <p class="hl-hero__sub">{{ section.settings.subheading }}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="hl-btn">{{ section.settings.cta_label }}</a>{%- endif -%}
      {%- if section.settings.cta_label_2 != blank -%}<a href="{{ section.settings.cta_url_2 | default: '/pages/about' }}" class="hl-btn hl-btn--outline">{{ section.settings.cta_label_2 }}</a>{%- endif -%}
    </div>
  </div>
  <div class="hl-hero__visual">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" loading="eager">{%- else -%}<div style="width:100%;height:100%;min-height:500px;background:var(--hl-saddle)"></div>{%- endif -%}</div>
</div>
{% schema %}
{"name":"Leather Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"HERITAGE WORKSHOP"},{"type":"text","id":"heading","label":"Slow Cured Vegetable Tanned Leather"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Hand-stitched using thick waxed thread and finished with organic beeswax for a lifetime of patina."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cta_label","label":"CTA","default":"EXPLORE LEATHER"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"text","id":"cta_label_2","label":"CTA 2","default":"OUR PROCESS"},{"type":"url","id":"cta_url_2","label":"CTA 2 URL"}],"presets":[{"name":"Leather Hero"}]}
{% endschema %}
