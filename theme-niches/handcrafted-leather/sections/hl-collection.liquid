<div style="padding:60px 20px 0;background:var(--hl-cream)"><div style="max-width:1320px;margin:0 auto;text-align:center;padding-bottom:56px;border-bottom:1px solid var(--hl-border)"><span class="hl-eyebrow" style="margin-bottom:8px">{{ collection.title | upcase }}</span><h1 style="font-family:'Playfair Display',serif;font-size:clamp(32px,5vw,52px);font-weight:400;color:var(--hl-dark);margin-bottom:12px">{{ collection.title }}</h1>{%- if collection.description != blank -%}<p style="font-family:'Lora',serif;font-style:italic;font-size:15px;color:var(--hl-muted);max-width:560px;margin:0 auto">{{ collection.description }}</p>{%- endif -%}</div></div>
<div style="padding:0 20px 100px;background:var(--hl-cream)"><div style="max-width:1320px;margin:0 auto"><div style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid var(--hl-border);margin-bottom:40px"><div style="font-family:'Lora',serif;font-style:italic;font-size:14px;color:var(--hl-muted)">{{ collection.products_count }} workshop goods</div><select style="padding:10px 20px;border:1px solid var(--hl-border);border-radius:6px;background:#fff;color:var(--hl-dark);font-family:'Montserrat',sans-serif;font-size:12px;font-weight:700;cursor:pointer"><option>Featured</option><option>Price: Low to High</option><option>Price: High to Low</option><option>Newest</option></select></div><div class="hl-prod-grid">{%- for product in collection.products -%}<a href="{{ product.url }}" class="hl-prod-card"><div class="hl-prod-card__img">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" loading="lazy">{%- else -%}<div style="width:100%;height:100%;background:var(--hl-cream)"></div>{%- endif -%}</div><div class="hl-prod-card__name">{{ product.title }}</div><div class="hl-prod-card__price">{{ product.price | money }}</div></a>{%- endfor -%}</div></div></div>
{% schema %}
{"name":"Leather Collection","settings":[],"presets":[{"name":"Leather Collection"}]}
{% endschema %}
