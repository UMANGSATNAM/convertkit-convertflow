<header class="sf-header sf-header-{{ section.id }}" id="sf-header-{{ section.id }}" style="--text-color: {{ section.settings.text_color }}; --bg-scrolled: {{ section.settings.bg_color_scrolled }}; --text-scrolled: {{ section.settings.text_color_scrolled }};">
  <div class="sf-header-container">
    
    <div class="sf-header-mobile-toggle">
      <span></span><span></span><span></span>
    </div>
    
    <div class="sf-header-nav sf-header-nav-left">
      {% for link in linklists[section.settings.menu_left].links %}
        <a href="{{ link.url }}" class="sf-header-link">{{ link.title }}</a>
      {% endfor %}
    </div>
    
    <div class="sf-header-logo-area">
      <a href="/" class="sf-header-logo-link">
        {% if section.settings.logo_light != blank %}
          <img src="{{ section.settings.logo_light | img_url: '400x' }}" alt="{{ shop.name }}" class="sf-header-logo-img sf-logo-light">
          <img src="{{ section.settings.logo_dark | img_url: '400x' }}" alt="{{ shop.name }}" class="sf-header-logo-img sf-logo-dark">
        {% else %}
          <span class="sf-header-logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>
    
    <div class="sf-header-nav sf-header-nav-right">
      {% for link in linklists[section.settings.menu_right].links %}
        <a href="{{ link.url }}" class="sf-header-link">{{ link.title }}</a>
      {% endfor %}
      
      <div class="sf-header-icons">
        <a href="/search" class="sf-header-icon">🔍</a>
        <a href="/account" class="sf-header-icon">👤</a>
        <a href="/cart" class="sf-header-icon">🛒 <span class="sf-cart-count">{{ cart.item_count }}</span></a>
      </div>
    </div>
    
  </div>
</header>

<style>
  .sf-header-{{ section.id }} { position: fixed; top: 0; left: 0; width: 100%; z-index: 999; padding: 1.5rem 2rem; transition: all 0.3s ease; background: transparent; color: var(--text-color); border-bottom: 1px solid transparent; }
  .sf-header-{{ section.id }}.is-scrolled { background: var(--bg-scrolled); color: var(--text-scrolled); padding: 1rem 2rem; border-bottom: 1px solid rgba(0,0,0,0.05); }
  
  .sf-header-container { display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: center; max-width: 1600px; margin: 0 auto; }
  
  .sf-header-nav { display: none; gap: 2rem; align-items: center; }
  @media (min-width: 992px) { .sf-header-nav { display: flex; } }
  .sf-header-nav-right { justify-content: flex-end; }
  
  .sf-header-link { text-decoration: none; color: inherit; font-weight: 500; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 1px; transition: opacity 0.3s; position: relative; }
  .sf-header-link:hover { opacity: 0.7; }
  .sf-header-link::after { content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 1px; background: currentColor; transition: width 0.3s; }
  .sf-header-link:hover::after { width: 100%; }
  
  .sf-header-logo-area { text-align: center; }
  .sf-header-logo-link { text-decoration: none; color: inherit; display: inline-block; }
  .sf-header-logo-text { font-size: 1.8rem; font-weight: bold; letter-spacing: 2px; text-transform: uppercase; }
  .sf-header-logo-img { max-height: 40px; width: auto; transition: opacity 0.3s; }
  
  .sf-logo-dark { display: none; }
  .is-scrolled .sf-logo-light { display: none; }
  .is-scrolled .sf-logo-dark { display: block; }
  
  .sf-header-icons { display: flex; gap: 1.25rem; align-items: center; margin-left: 2rem; }
  .sf-header-icon { text-decoration: none; color: inherit; font-size: 1.2rem; position: relative; }
  .sf-cart-count { position: absolute; top: -8px; right: -8px; background: currentColor; color: var(--bg-scrolled); font-size: 0.6rem; font-weight: bold; width: 16px; height: 16px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  
  .sf-header-mobile-toggle { display: flex; flex-direction: column; justify-content: space-between; width: 24px; height: 18px; cursor: pointer; }
  @media (min-width: 992px) { .sf-header-mobile-toggle { display: none; } }
  .sf-header-mobile-toggle span { width: 100%; height: 2px; background: currentColor; border-radius: 2px; transition: 0.3s; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('sf-header-{{ section.id }}');
    
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    });
  });
</script>

{% schema %}
{
  "name": "Transparent Header",
  "settings": [
    { "type": "color", "id": "text_color", "label": "Initial Text Color (Transparent)", "default": "#ffffff" },
    { "type": "color", "id": "bg_color_scrolled", "label": "Scrolled Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color_scrolled", "label": "Scrolled Text Color", "default": "#111111" },
    { "type": "image_picker", "id": "logo_light", "label": "Logo (Light / Transparent)" },
    { "type": "image_picker", "id": "logo_dark", "label": "Logo (Dark / Scrolled)" },
    { "type": "link_list", "id": "menu_left", "label": "Left Menu" },
    { "type": "link_list", "id": "menu_right", "label": "Right Menu" }
  ],
  "presets": [ { "name": "Transparent Header", "category": "Layout" } ]
}
{% endschema %}
