<div class="sf-overlap sf-ov-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-ov-container">
    <div class="sf-ov-image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: 'master' }}" alt="{{ section.settings.title }}">
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'sf-placeholder' }}
      {% endif %}
    </div>
    <div class="sf-ov-content" style="background: {{ section.settings.content_bg }};">
      <h2 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
      <div class="sf-ov-text" style="color: {{ section.settings.text_color }};">
        {{ section.settings.text }}
      </div>
      {% if section.settings.btn_link != blank %}
        <a href="{{ section.settings.btn_link }}" class="sf-ov-btn" style="background: {{ section.settings.btn_bg }}; color: {{ section.settings.btn_text }};">{{ section.settings.btn_label }}</a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .sf-ov-{{ section.id }} { padding: 5rem 1rem; }
  .sf-ov-container { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center; }
  @media (min-width: 992px) {
    .sf-ov-container { grid-template-columns: 60% 40%; }
    .sf-ov-image { grid-column: 1 / 2; grid-row: 1; }
    .sf-ov-content { grid-column: 2 / 3; grid-row: 1; margin-left: -15%; z-index: 2; padding: 4rem !important; box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
  }
  .sf-ov-image img, .sf-placeholder { width: 100%; height: auto; display: block; border-radius: 8px; }
  .sf-ov-content { padding: 2rem; border-radius: 8px; text-align: left; }
  .sf-ov-content h2 { font-size: 2.5rem; margin-bottom: 1.5rem; line-height: 1.2; }
  .sf-ov-text { font-size: 1.1rem; line-height: 1.8; opacity: 0.9; margin-bottom: 2rem; }
  .sf-ov-btn { display: inline-block; padding: 15px 30px; text-decoration: none; font-weight: bold; border-radius: 4px; text-transform: uppercase; letter-spacing: 1px; }
</style>

{% schema %}
{
  "name": "Image Text Overlap",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f4f4f4" },
    { "type": "color", "id": "content_bg", "label": "Content Box BG", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111111" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "title", "label": "Title", "default": "Crafted with Purpose" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Discover the story behind our meticulous process and dedication to quality.</p>" },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Read Our Story" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#111111" },
    { "type": "color", "id": "btn_text", "label": "Button Text", "default": "#ffffff" }
  ],
  "presets": [ { "name": "Image Text Overlap", "category": "Story" } ]
}
{% endschema %}
