<div class="sf-press sf-plg-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-plg-container">
    {% if section.settings.title != blank %}
      <h2 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
    {% endif %}
    
    <div class="sf-plg-grid">
      {% for block in section.blocks %}
        <div class="sf-plg-logo" style="opacity: {{ section.settings.logo_opacity }}%;">
          {% if block.settings.logo != blank %}
            <img src="{{ block.settings.logo | img_url: '400x' }}" alt="{{ block.settings.title }}">
          {% else %}
            <div class="sf-plg-placeholder" style="color: {{ section.settings.text_color }};">{{ block.settings.title }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .sf-plg-{{ section.id }} { padding: 4rem 1rem; text-align: center; border-top: 1px solid rgba(0,0,0,0.05); border-bottom: 1px solid rgba(0,0,0,0.05); }
  .sf-plg-container { max-width: 1200px; margin: 0 auto; }
  .sf-plg-container h2 { font-size: 1.2rem; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 2rem; opacity: 0.6; }
  .sf-plg-grid { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 2rem 4rem; }
  .sf-plg-logo { display: flex; align-items: center; justify-content: center; transition: opacity 0.3s; max-width: 150px; }
  .sf-plg-logo:hover { opacity: 1 !important; }
  .sf-plg-logo img { max-width: 100%; height: auto; max-height: 50px; object-fit: contain; filter: grayscale(100%); transition: filter 0.3s; }
  .sf-plg-logo:hover img { filter: grayscale(0%); }
  .sf-plg-placeholder { font-weight: bold; font-size: 1.5rem; font-family: serif; }
</style>

{% schema %}
{
  "name": "Press Logos",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111111" },
    { "type": "text", "id": "title", "label": "Title", "default": "AS SEEN IN" },
    { "type": "range", "id": "logo_opacity", "label": "Logo Opacity", "min": 10, "max": 100, "step": 10, "default": 60 }
  ],
  "blocks": [
    {
      "type": "logo", "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo Image" },
        { "type": "text", "id": "title", "label": "Publication Name", "default": "VOGUE" }
      ]
    }
  ],
  "presets": [ { "name": "Press Logos", "category": "Trust", "blocks": [{"type":"logo"},{"type":"logo"},{"type":"logo"},{"type":"logo"}] } ]
}
{% endschema %}
