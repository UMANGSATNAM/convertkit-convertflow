<div class="sf-parallax sf-parallax-{{ section.id }}" style="background-image: url('{% if section.settings.image != blank %}{{ section.settings.image | img_url: 'master' }}{% else %}https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-lifestyle-1_large.png{% endif %}');">
  <div class="sf-parallax-overlay" style="background-color: rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }});"></div>
  <div class="sf-parallax-content">
    <h2 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
    <p style="color: {{ section.settings.text_color }};">{{ section.settings.subtitle }}</p>
    {% if section.settings.btn_link != blank %}
      <a href="{{ section.settings.btn_link }}" class="sf-parallax-btn" style="background: {{ section.settings.btn_bg }}; color: {{ section.settings.btn_text }};">{{ section.settings.btn_label }}</a>
    {% endif %}
  </div>
</div>

<style>
  .sf-parallax-{{ section.id }} {
    position: relative;
    background-attachment: fixed;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .sf-parallax-overlay {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;
  }
  .sf-parallax-content {
    position: relative; z-index: 2; max-width: 800px; padding: 0 2rem;
  }
  .sf-parallax-content h2 { font-size: 3.5rem; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 3px; }
  .sf-parallax-content p { font-size: 1.2rem; margin-bottom: 2rem; }
  .sf-parallax-btn { display: inline-block; padding: 14px 32px; text-decoration: none; font-weight: 600; letter-spacing: 1px; }
</style>

{% schema %}
{
  "name": "Parallax Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background Image" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 100, "step": 10, "label": "Overlay", "default": 50 },
    { "type": "text", "id": "title", "label": "Title", "default": "Into The Wild" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Gear up for your next adventure." },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "text", "id": "btn_label", "label": "Button", "default": "Explore" },
    { "type": "url", "id": "btn_link", "label": "Link" },
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#ffffff" },
    { "type": "color", "id": "btn_text", "label": "Button Text", "default": "#000000" }
  ],
  "presets": [ { "name": "Parallax Hero", "category": "Hero" } ]
}
{% endschema %}
