<div class="sf-newsletter sf-nl-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-nl-content">
    <h3 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h3>
    <p style="color: {{ section.settings.text_color }};">{{ section.settings.subtitle }}</p>
    {% form 'customer' %}
      <div class="sf-nl-form">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" class="sf-nl-input" placeholder="Enter your email" required style="border-color: {{ section.settings.text_color }};">
        <button type="submit" class="sf-nl-btn" style="background: {{ section.settings.btn_bg }}; color: {{ section.settings.btn_text }};">{{ section.settings.btn_label }}</button>
      </div>
    {% endform %}
  </div>
</div>

<style>
  .sf-nl-{{ section.id }} {
    padding: 5rem 1rem; text-align: center; display: flex; justify-content: center; align-items: center;
  }
  .sf-nl-content { max-width: 600px; width: 100%; }
  .sf-nl-content h3 { font-size: 2.5rem; margin-bottom: 1rem; }
  .sf-nl-content p { font-size: 1.1rem; margin-bottom: 2rem; opacity: 0.8; }
  .sf-nl-form { display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; }
  .sf-nl-input { padding: 14px; flex: 1; min-width: 250px; font-size: 1rem; background: transparent; border: 1px solid; border-radius: 4px; }
  .sf-nl-btn { padding: 14px 32px; border: none; font-weight: bold; font-size: 1rem; cursor: pointer; border-radius: 4px; }
</style>

{% schema %}
{
  "name": "Newsletter Banner",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "BG", "default": "#f4f4f4" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "text", "id": "title", "label": "Title", "default": "Join Our Community" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Get 10% off your first order." },
    { "type": "text", "id": "btn_label", "label": "Button", "default": "Subscribe" },
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#111111" },
    { "type": "color", "id": "btn_text", "label": "Button Text", "default": "#ffffff" }
  ],
  "presets": [ { "name": "Newsletter Banner", "category": "Banner" } ]
}
{% endschema %}
