<div class="sf-asym-hero sf-asym-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-asym-text">
    <h1 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h1>
    <p style="color: {{ section.settings.text_color }};">{{ section.settings.subtitle }}</p>
    <a href="{{ section.settings.btn_link }}" class="sf-btn-asym" style="background: {{ section.settings.btn_bg }}; color: {{ section.settings.btn_text }};">
      {{ section.settings.btn_text_label }}
    </a>
  </div>
  <div class="sf-asym-images">
    <div class="sf-img-large">
      {% if section.settings.image_1 != blank %}
        <img src="{{ section.settings.image_1 | img_url: 'master' }}" alt="Image 1">
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'sf-placeholder' }}
      {% endif %}
    </div>
    <div class="sf-img-small">
      {% if section.settings.image_2 != blank %}
        <img src="{{ section.settings.image_2 | img_url: 'master' }}" alt="Image 2">
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'sf-placeholder' }}
      {% endif %}
    </div>
  </div>
</div>

<style>
  .sf-asym-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 80vh;
  }
  .sf-asym-text {
    padding: 4rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .sf-asym-text h1 {
    font-size: 3.5rem; line-height: 1; margin-bottom: 1rem;
  }
  .sf-asym-text p {
    font-size: 1.1rem; margin-bottom: 2rem; opacity: 0.8;
  }
  .sf-btn-asym {
    display: inline-block; padding: 15px 30px; text-decoration: none; width: fit-content; text-transform: uppercase; font-weight: bold; border-radius: 4px;
  }
  .sf-asym-images {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1rem;
    padding: 1rem;
  }
  .sf-img-large, .sf-img-small {
    width: 100%; height: 100%; overflow: hidden; border-radius: 8px;
  }
  .sf-img-large img, .sf-img-small img, .sf-placeholder {
    width: 100%; height: 100%; object-fit: cover;
  }
  @media (min-width: 768px) {
    .sf-asym-{{ section.id }} { grid-template-columns: 40% 60%; }
    .sf-asym-text { padding: 4rem 10%; }
    .sf-asym-images { padding: 2rem 2rem 2rem 0; }
  }
</style>

{% schema %}
{
  "name": "Asymmetric Split Hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "BG Color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#000000" },
    { "type": "text", "id": "title", "label": "Title", "default": "Bold & Beautiful" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Stand out from the crowd." },
    { "type": "text", "id": "btn_text_label", "label": "Button", "default": "Shop Collection" },
    { "type": "url", "id": "btn_link", "label": "Link" },
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#000000" },
    { "type": "color", "id": "btn_text", "label": "Button Text", "default": "#ffffff" },
    { "type": "image_picker", "id": "image_1", "label": "Large Image" },
    { "type": "image_picker", "id": "image_2", "label": "Small Image" }
  ],
  "presets": [ { "name": "Asymmetric Split Hero", "category": "Hero" } ]
}
{% endschema %}
