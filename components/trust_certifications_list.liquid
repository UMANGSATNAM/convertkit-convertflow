<div class="sf-certs sf-cl-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-cl-container">
    {% if section.settings.title != blank %}
      <h2 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
    {% endif %}
    
    <div class="sf-cl-grid">
      {% for block in section.blocks %}
        <div class="sf-cl-item">
          <div class="sf-cl-icon">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '200x' }}" alt="{{ block.settings.title }}">
            {% else %}
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.text_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            {% endif %}
          </div>
          <h3 style="color: {{ section.settings.text_color }};">{{ block.settings.title }}</h3>
          <p style="color: {{ section.settings.text_color }};">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .sf-cl-{{ section.id }} { padding: 5rem 1rem; text-align: center; }
  .sf-cl-container { max-width: 1200px; margin: 0 auto; }
  .sf-cl-container h2 { font-size: 2rem; margin-bottom: 4rem; }
  
  .sf-cl-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
  @media (min-width: 600px) { .sf-cl-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 992px) { .sf-cl-grid { grid-template-columns: repeat({{ section.blocks.size | at_most: 4 }}, 1fr); } }
  
  .sf-cl-item { display: flex; flex-direction: column; align-items: center; }
  .sf-cl-icon { margin-bottom: 1.5rem; height: 80px; display: flex; align-items: center; justify-content: center; }
  .sf-cl-icon img { max-height: 100%; max-width: 100%; object-fit: contain; }
  .sf-cl-item h3 { font-size: 1.25rem; font-weight: bold; margin-bottom: 0.5rem; }
  .sf-cl-item p { opacity: 0.8; line-height: 1.5; font-size: 0.95rem; }
</style>

{% schema %}
{
  "name": "Certifications List",
  "max_blocks": 4,
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111111" },
    { "type": "text", "id": "title", "label": "Title", "default": "Certified Quality" }
  ],
  "blocks": [
    {
      "type": "cert", "name": "Certification",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Badge/Icon Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Cruelty Free" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Never tested on animals." }
      ]
    }
  ],
  "presets": [ { "name": "Certifications List", "category": "Trust", "blocks": [{"type":"cert"},{"type":"cert"},{"type":"cert"}] } ]
}
{% endschema %}
