<div class="sf-bestsellers sf-bs-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-bs-header">
    <h2 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
    {% if section.settings.view_all_link != blank %}
      <a href="{{ section.settings.view_all_link }}" class="sf-bs-view-all" style="color: {{ section.settings.text_color }};">View All &rarr;</a>
    {% endif %}
  </div>
  
  <div class="sf-bs-carousel-container">
    <button class="sf-bs-arrow prev">&larr;</button>
    <div class="sf-bs-track">
      {% for product in collections[section.settings.collection].products limit: 10 %}
        <div class="sf-bs-item">
          <a href="{{ product.url }}" class="sf-bs-img-link">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}">
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'sf-placeholder' }}
            {% endif %}
            {% if product.compare_at_price > product.price %}
              <span class="sf-bs-badge">Sale</span>
            {% endif %}
          </a>
          <div class="sf-bs-info">
            <h3><a href="{{ product.url }}" style="color: {{ section.settings.text_color }};">{{ product.title }}</a></h3>
            <p class="sf-bs-price" style="color: {{ section.settings.text_color }};">{{ product.price | money }}</p>
          </div>
        </div>
      {% else %}
        {% for i in (1..6) %}
          <div class="sf-bs-item">
            <a href="#" class="sf-bs-img-link">{{ 'product-' | append: i | placeholder_svg_tag: 'sf-placeholder' }}</a>
            <div class="sf-bs-info">
              <h3><a href="#" style="color: {{ section.settings.text_color }};">Example Product</a></h3>
              <p class="sf-bs-price" style="color: {{ section.settings.text_color }};">$99.00</p>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
    <button class="sf-bs-arrow next">&rarr;</button>
  </div>
</div>

<style>
  .sf-bs-{{ section.id }} { padding: 4rem 1rem; max-width: 1400px; margin: 0 auto; overflow: hidden; }
  .sf-bs-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; border-bottom: 1px solid rgba(0,0,0,0.1); padding-bottom: 1rem; }
  .sf-bs-header h2 { font-size: 2rem; margin: 0; }
  .sf-bs-view-all { text-decoration: none; font-weight: bold; text-transform: uppercase; font-size: 0.9rem; }
  .sf-bs-carousel-container { position: relative; display: flex; align-items: center; }
  .sf-bs-arrow { background: white; border: 1px solid #ddd; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 2; position: absolute; transition: 0.3s; }
  .sf-bs-arrow:hover { background: #000; color: #fff; border-color: #000; }
  .sf-bs-arrow.prev { left: -10px; }
  .sf-bs-arrow.next { right: -10px; }
  .sf-bs-track { display: flex; gap: 1.5rem; overflow-x: auto; scroll-behavior: smooth; scrollbar-width: none; width: 100%; padding: 1rem 0; }
  .sf-bs-track::-webkit-scrollbar { display: none; }
  .sf-bs-item { flex: 0 0 70%; max-width: 280px; display: flex; flex-direction: column; }
  @media (min-width: 768px) { .sf-bs-item { flex: 0 0 calc(25% - 1.5rem); } }
  .sf-bs-img-link { position: relative; display: block; aspect-ratio: 4/5; background: #f4f4f4; border-radius: 8px; overflow: hidden; margin-bottom: 1rem; }
  .sf-bs-img-link img, .sf-placeholder { width: 100%; height: 100%; object-fit: cover; transition: 0.3s; }
  .sf-bs-img-link:hover img { transform: scale(1.05); }
  .sf-bs-badge { position: absolute; top: 10px; right: 10px; background: red; color: white; padding: 4px 8px; font-size: 0.7rem; font-weight: bold; text-transform: uppercase; border-radius: 4px; }
  .sf-bs-info h3 { font-size: 1.1rem; margin: 0 0 0.5rem 0; }
  .sf-bs-info h3 a { text-decoration: none; }
  .sf-bs-price { font-weight: bold; margin: 0; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.querySelector('.sf-bs-{{ section.id }} .sf-bs-track');
    const prev = document.querySelector('.sf-bs-{{ section.id }} .prev');
    const next = document.querySelector('.sf-bs-{{ section.id }} .next');
    if(!track || !prev || !next) return;
    
    prev.addEventListener('click', () => { track.scrollBy({ left: -300, behavior: 'smooth' }); });
    next.addEventListener('click', () => { track.scrollBy({ left: 300, behavior: 'smooth' }); });
  });
</script>

{% schema %}
{
  "name": "Bestsellers Carousel",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111111" },
    { "type": "text", "id": "title", "label": "Title", "default": "Best Sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "url", "id": "view_all_link", "label": "View All Link" }
  ],
  "presets": [ { "name": "Bestsellers Carousel", "category": "Collection" } ]
}
{% endschema %}
