<div class="sf-press sf-press-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  {% if section.settings.title != blank %}
    <h3 class="sf-press-title" style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h3>
  {% endif %}
  <div class="sf-press-marquee">
    <div class="sf-press-track">
      {% for block in section.blocks %}
        <div class="sf-press-logo">
          {% if block.settings.logo != blank %}
            <img src="{{ block.settings.logo | img_url: '200x' }}" alt="{{ block.settings.logo.alt | default: 'Press Logo' }}">
          {% else %}
            <h4 style="color: {{ section.settings.text_color }};">{{ block.settings.text | default: 'PRESS LOGO' }}</h4>
          {% endif %}
        </div>
      {% endfor %}
      <!-- Duplicate for infinite scroll -->
      {% for block in section.blocks %}
        <div class="sf-press-logo">
          {% if block.settings.logo != blank %}
            <img src="{{ block.settings.logo | img_url: '200x' }}" alt="{{ block.settings.logo.alt | default: 'Press Logo' }}">
          {% else %}
            <h4 style="color: {{ section.settings.text_color }};">{{ block.settings.text | default: 'PRESS LOGO' }}</h4>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .sf-press-{{ section.id }} {
    padding: 2rem 0;
    overflow: hidden;
  }
  .sf-press-title {
    text-align: center;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 2rem;
    opacity: 0.6;
  }
  .sf-press-marquee {
    width: 100%;
    overflow: hidden;
    position: relative;
  }
  .sf-press-track {
    display: flex;
    align-items: center;
    width: calc(200px * {{ section.blocks.size }} * 2);
    animation: sf-scroll 20s linear infinite;
  }
  .sf-press-logo {
    width: 200px;
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0 2rem;
  }
  .sf-press-logo img {
    max-width: 100%;
    max-height: 40px;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.7;
    transition: all 0.3s ease;
  }
  .sf-press-logo img:hover {
    filter: grayscale(0%);
    opacity: 1;
  }
  @keyframes sf-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-200px * {{ section.blocks.size }})); }
  }
</style>

{% schema %}
{
  "name": "Press Marquee",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "As Featured In"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Fallback Text",
          "default": "FORBES"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press Marquee",
      "category": "Social Proof",
      "blocks": [
        { "type": "logo", "settings": { "text": "VOGUE" } },
        { "type": "logo", "settings": { "text": "FORBES" } },
        { "type": "logo", "settings": { "text": "GQ" } },
        { "type": "logo", "settings": { "text": "ELLE" } }
      ]
    }
  ]
}
{% endschema %}
