<div class="sf-frh sf-frh-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-frh-container">
    <div class="sf-frh-image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: '800x' }}" alt="{{ section.settings.author }}">
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'sf-placeholder' }}
      {% endif %}
    </div>
    
    <div class="sf-frh-content">
      <div class="sf-frh-stars" style="color: {{ section.settings.star_color }};">
        ★★★★★
      </div>
      <blockquote class="sf-frh-quote" style="color: {{ section.settings.text_color }};">
        "{{ section.settings.quote }}"
      </blockquote>
      <div class="sf-frh-author" style="color: {{ section.settings.text_color }};">
        <strong>{{ section.settings.author }}</strong>
        <span>{{ section.settings.author_title }}</span>
      </div>
      {% if section.settings.btn_link != blank %}
        <a href="{{ section.settings.btn_link }}" class="sf-frh-btn" style="background: {{ section.settings.btn_bg }}; color: {{ section.settings.btn_text }};">{{ section.settings.btn_label }}</a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .sf-frh-{{ section.id }} { padding: 4rem 1rem; }
  .sf-frh-container { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  @media (min-width: 992px) { .sf-frh-container { grid-template-columns: 1fr 1fr; } }
  
  .sf-frh-image { width: 100%; border-radius: 16px; overflow: hidden; aspect-ratio: 4/5; box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
  .sf-frh-image img, .sf-placeholder { width: 100%; height: 100%; object-fit: cover; }
  
  .sf-frh-content { padding: 2rem 0; }
  .sf-frh-stars { font-size: 1.5rem; letter-spacing: 5px; margin-bottom: 2rem; }
  .sf-frh-quote { font-size: 2.5rem; line-height: 1.2; font-weight: bold; margin: 0 0 2rem 0; font-family: serif; font-style: italic; position: relative; }
  .sf-frh-quote::before { content: '“'; position: absolute; left: -30px; top: -10px; font-size: 4rem; opacity: 0.2; }
  
  .sf-frh-author strong { display: block; font-size: 1.2rem; margin-bottom: 0.25rem; }
  .sf-frh-author span { opacity: 0.7; font-size: 1rem; }
  
  .sf-frh-btn { display: inline-block; margin-top: 3rem; padding: 15px 30px; text-decoration: none; font-weight: bold; border-radius: 4px; text-transform: uppercase; }
</style>

{% schema %}
{
  "name": "Featured Review Hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111111" },
    { "type": "color", "id": "star_color", "label": "Star Color", "default": "#FFB800" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "This product completely changed my life. I can't recommend it enough." },
    { "type": "text", "id": "author", "label": "Author Name", "default": "Jane Doe" },
    { "type": "text", "id": "author_title", "label": "Author Title", "default": "Verified Customer" },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Shop the Collection" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#111111" },
    { "type": "color", "id": "btn_text", "label": "Button Text", "default": "#ffffff" }
  ],
  "presets": [ { "name": "Featured Review Hero", "category": "Trust" } ]
}
{% endschema %}
