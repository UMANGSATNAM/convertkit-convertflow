<div class="sf-cat-circles sf-cc-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  {% if section.settings.title != blank %}
    <h2 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
  {% endif %}
  <div class="sf-cc-scroll">
    <div class="sf-cc-wrap">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="sf-cc-item">
          <div class="sf-cc-img" style="border-color: {{ section.settings.text_color }};">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '200x200', crop: 'center' }}" alt="{{ block.settings.title }}">
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'sf-placeholder' }}
            {% endif %}
          </div>
          <span style="color: {{ section.settings.text_color }};">{{ block.settings.title }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .sf-cc-{{ section.id }} { padding: 3rem 1rem; text-align: center; }
  .sf-cc-{{ section.id }} h2 { font-size: 2rem; margin-bottom: 2rem; }
  .sf-cc-scroll { width: 100%; overflow-x: auto; scrollbar-width: none; }
  .sf-cc-scroll::-webkit-scrollbar { display: none; }
  .sf-cc-wrap { display: inline-flex; gap: 2rem; padding: 1rem; }
  .sf-cc-item { display: flex; flex-direction: column; align-items: center; text-decoration: none; width: 120px; }
  .sf-cc-img { width: 100px; height: 100px; border-radius: 50%; overflow: hidden; border: 2px solid; padding: 4px; transition: transform 0.3s; }
  .sf-cc-img img, .sf-placeholder { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
  .sf-cc-item:hover .sf-cc-img { transform: translateY(-5px) scale(1.05); }
  .sf-cc-item span { margin-top: 1rem; font-weight: bold; text-transform: uppercase; font-size: 0.9rem; letter-spacing: 1px; }
</style>

{% schema %}
{
  "name": "Category Circles",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111111" },
    { "type": "text", "id": "title", "label": "Title", "default": "Shop By Category" }
  ],
  "blocks": [
    {
      "type": "category", "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Category" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "Category Circles", "category": "Collection" } ]
}
{% endschema %}
