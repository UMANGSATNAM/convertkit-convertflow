<style>
  #shopify-section-{{ section.id }} .sf-register {
    background: var(--color-bg, #fff);
    color: var(--color-text, #1a1a1a);
    padding: var(--spacing-section-y, 80px) var(--spacing-section-x, 20px);
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .sf-register__box {
    max-width: 440px;
    width: 100%;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .sf-register__title {
    font-family: var(--font-heading, inherit);
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 400;
    text-align: center;
    margin: 0 0 8px;
  }
  #shopify-section-{{ section.id }} .sf-register__sub {
    color: var(--color-text-muted, #888);
    text-align: center;
    font-size: 0.95rem;
    margin: 0 0 32px;
  }
  #shopify-section-{{ section.id }} .sf-register__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .sf-register__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  #shopify-section-{{ section.id }} .sf-register__label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-text, #1a1a1a);
  }
  #shopify-section-{{ section.id }} .sf-register__input {
    border: 1px solid var(--color-border, #e0e0e0);
    padding: 12px 14px;
    font-size: 0.95rem;
    background: transparent;
    color: var(--color-text, #1a1a1a);
    outline: none;
    transition: border-color 0.2s;
  }
  #shopify-section-{{ section.id }} .sf-register__input:focus { border-color: var(--color-primary, #1a1a1a); }
  #shopify-section-{{ section.id }} .sf-register__submit {
    border: none;
    background: var(--color-primary, #1a1a1a);
    color: var(--color-btn-text, #fff);
    padding: 14px;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s;
    margin-top: 8px;
  }
  #shopify-section-{{ section.id }} .sf-register__submit:hover { opacity: 0.8; }
  #shopify-section-{{ section.id }} .sf-register__links {
    text-align: center;
    margin-top: 24px;
    font-size: 0.9rem;
    color: var(--color-text-muted, #888);
  }
  #shopify-section-{{ section.id }} .sf-register__link {
    color: var(--color-primary, #1a1a1a);
    text-decoration: underline;
    margin-left: 4px;
  }
</style>

<section id="shopify-section-{{ section.id }}" class="sf-register" data-section-id="{{ section.id }}" data-section-type="main-register">
  <div class="sf-register__box">
    <h1 class="sf-register__title">{{ 'customer.register.title' | t: default: 'Create Account' }}</h1>
    <p class="sf-register__sub">{{ 'customer.register.subtitle' | t: default: 'Please enter your information to create an account.' }}</p>

    {% form 'create_customer', class: 'sf-register__form' %}
      {%- if form.errors -%}
        <div style="color:#e44;font-size:0.85rem;margin-bottom:8px;">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="sf-register__field">
        <label class="sf-register__label" for="RegisterForm-FirstName">{{ 'customer.register.first_name' | t: default: 'First Name' }}</label>
        <input
          type="text"
          name="customer[first_name]"
          id="RegisterForm-FirstName"
          class="sf-register__input"
          autocomplete="given-name"
        >
      </div>

      <div class="sf-register__field">
        <label class="sf-register__label" for="RegisterForm-LastName">{{ 'customer.register.last_name' | t: default: 'Last Name' }}</label>
        <input
          type="text"
          name="customer[last_name]"
          id="RegisterForm-LastName"
          class="sf-register__input"
          autocomplete="family-name"
        >
      </div>

      <div class="sf-register__field">
        <label class="sf-register__label" for="RegisterForm-email">{{ 'customer.register.email' | t: default: 'Email' }}</label>
        <input
          type="email"
          name="customer[email]"
          id="RegisterForm-email"
          class="sf-register__input"
          autocomplete="email"
          required
        >
      </div>

      <div class="sf-register__field">
        <label class="sf-register__label" for="RegisterForm-password">{{ 'customer.register.password' | t: default: 'Password' }}</label>
        <input
          type="password"
          name="customer[password]"
          id="RegisterForm-password"
          class="sf-register__input"
          autocomplete="new-password"
          required
        >
      </div>

      <button type="submit" class="sf-register__submit">{{ 'customer.register.submit' | t: default: 'Create' }}</button>

      <div class="sf-register__links">
        {{ 'customer.register.have_account' | t: default: 'Already have an account?' }}
        <a href="{{ routes.account_login_url }}" class="sf-register__link">{{ 'customer.register.login_here' | t: default: 'Sign In' }}</a>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Register Main",
  "tag": "section",
  "class": "section-main-register",
  "settings": [],
  "presets": [
    {
      "name": "Register Main"
    }
  ]
}
{% endschema %}
