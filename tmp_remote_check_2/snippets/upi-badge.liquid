{%- comment -%}
  =============================================================================
  STOREFORGE SHARED INDIA-FIRST SNIPPET: INSTANT UPI SAVINGS & PREPAID BADGE
  =============================================================================
  Psychological Conversion Framework:
  1. Loss Aversion (Kahneman & Tversky): Framing prepaid UPI payment not merely as an alternative method, but as an immediate monetary gain ("Save ₹150 instantly"). Missing out feels like losing money.
  2. RTO Elimination Incentive: Shifting orders from Cash on Delivery to UPI prepaid protects merchant margins and ensures higher delivery success rates.
  3. Trust & Ubiquity Signaling: Explicitly referencing Google Pay, PhonePe, Paytm, and BHIM leverages the immense trust of India's national payment infrastructure.
  
  Design Aesthetics & Rules:
  - 0% Emoji Policy: 100% clean ASCII brackets [ EXTRA 5% OFF ] and SVG lightning iconography.
  - Universal Theme Heritage: Adapts dynamically to parent theme variables across all 5 niches.
  =============================================================================
{%- endcomment -%}

{%- if settings.enable_upi_badges -%}
<div class="sf-upi-badge" data-upi-badge>
  <style>
    .sf-upi-badge {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.65rem 0.9rem;
      background-color: var(--color-background, #ffffff);
      border: 1px solid var(--color-border, rgba(0, 0, 0, 0.15));
      font-family: var(--font-body-family, sans-serif);
      font-size: 0.75rem;
      color: var(--color-text, #111111);
      cursor: pointer;
      user-select: none;
      transition: border-color 0.2s ease, background-color 0.2s ease;
    }

    .sf-upi-badge:hover {
      border-color: var(--color-primary, #000000);
      background-color: var(--color-background-secondary, rgba(0, 0, 0, 0.02));
    }

    .sf-upi__icon-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background-color: #15803d;
      color: #ffffff;
      flex-shrink: 0;
    }

    .sf-upi__icon {
      width: 12px;
      height: 12px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2.2;
    }

    .sf-upi__text-group {
      display: flex;
      flex-direction: column;
      line-height: 1.25;
    }

    .sf-upi__label {
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 0.7rem;
      color: #15803d;
    }

    .sf-upi__subtext {
      font-size: 0.65rem;
      color: var(--color-text-muted, #666666);
      letter-spacing: 0.02em;
    }

    .sf-upi__subtext strong {
      color: var(--color-text, #111111);
      font-weight: 600;
    }

    /* Modal / Tooltip Drawer */
    .sf-upi__modal-overlay {
      position: fixed;
      inset: 0;
      background-color: rgba(0, 0, 0, 0.5);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }

    .sf-upi__modal-overlay.is-active {
      opacity: 1;
      pointer-events: auto;
    }

    .sf-upi__modal {
      background-color: var(--color-background, #ffffff);
      border: 1px solid var(--color-border, #222222);
      max-width: 440px;
      width: 100%;
      padding: 2rem;
      position: relative;
      transform: translateY(12px);
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    }

    .sf-upi__modal-overlay.is-active .sf-upi__modal {
      transform: translateY(0);
    }

    .sf-upi__modal-close {
      position: absolute;
      top: 1.25rem;
      right: 1.25rem;
      background: none;
      border: none;
      font-size: 1.25rem;
      line-height: 1;
      cursor: pointer;
      color: var(--color-text, #111111);
      padding: 0.25rem;
    }

    .sf-upi__modal-title {
      font-size: 0.9rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 1rem;
      color: #15803d;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .sf-upi__discount-box {
      background-color: rgba(21, 128, 61, 0.08);
      border: 1px dashed #15803d;
      padding: 1rem;
      margin-bottom: 1.5rem;
      text-align: center;
    }

    .sf-upi__discount-val {
      font-size: 1.25rem;
      font-weight: 800;
      color: #15803d;
      letter-spacing: 0.05em;
      margin-bottom: 0.25rem;
    }

    .sf-upi__discount-sub {
      font-size: 0.75rem;
      color: var(--color-text, #111111);
      line-height: 1.4;
    }

    .sf-upi__apps-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .sf-upi__app-card {
      padding: 0.65rem;
      border: 1px solid var(--color-border, rgba(0, 0, 0, 0.15));
      text-align: center;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--color-text, #111111);
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .sf-upi__modal-footer {
      padding-top: 1rem;
      border-top: 1px solid var(--color-border, rgba(0, 0, 0, 0.1));
      font-size: 0.7rem;
      color: var(--color-text-muted, #666666);
      text-align: center;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
  </style>

  <div class="sf-upi__icon-wrapper">
    <svg class="sf-upi__icon" viewBox="0 0 24 24">
      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
    </svg>
  </div>
  
  <div class="sf-upi__text-group">
    <span class="sf-upi__label">[ EXTRA 5% INSTANT OFF ]</span>
    <span class="sf-upi__subtext">Pay via <strong>GPay / PhonePe / Paytm UPI</strong></span>
  </div>

  <div class="sf-upi__modal-overlay" data-upi-modal role="dialog" aria-modal="true" aria-label="UPI Savings Information">
    <div class="sf-upi__modal" onclick="event.stopPropagation();">
      <button type="button" class="sf-upi__modal-close" data-upi-close aria-label="Close">&times;</button>
      
      <div class="sf-upi__modal-title">
        <span>[ PREPAID UPI BENEFIT ACCORD ]</span>
      </div>

      <div class="sf-upi__discount-box">
        <div class="sf-upi__discount-val">SAVE UP TO ₹500 INSTANTLY</div>
        <div class="sf-upi__discount-sub">
          Select <strong>UPI / Online Payment</strong> at checkout to apply our automated prepaid discount. No coupon code required.
        </div>
      </div>

      <div class="sf-upi__apps-grid">
        <div class="sf-upi__app-card">[ GOOGLE PAY ]</div>
        <div class="sf-upi__app-card">[ PHONEPE ]</div>
        <div class="sf-upi__app-card">[ PAYTM UPI ]</div>
        <div class="sf-upi__app-card">[ BHIM / ALL BANKS ]</div>
      </div>

      <div class="sf-upi__modal-footer">
        [ INSTANT DISPATCH & ZERO RTO HANDLING FEES ]
      </div>
    </div>
  </div>

  <script>
    (function() {
      const badge = document.querySelector('[data-upi-badge]');
      if (!badge) return;

      const modal = badge.querySelector('[data-upi-modal]');
      const closeBtn = badge.querySelector('[data-upi-close]');

      badge.addEventListener('click', function() {
        if (modal) {
          modal.classList.add('is-active');
          document.body.style.overflow = 'hidden';
        }
      });

      function closeModal(e) {
        if (e) e.stopPropagation();
        if (modal) {
          modal.classList.remove('is-active');
          document.body.style.overflow = '';
        }
      }

      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (modal) modal.addEventListener('click', closeModal);

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal && modal.classList.contains('is-active')) {
          closeModal();
        }
      });
    })();
  </script>
</div>
{%- endif -%}
