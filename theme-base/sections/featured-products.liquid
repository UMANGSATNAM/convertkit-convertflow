<div class="featured-products-section" style="padding:80px 20px;background:{{ section.settings.bg_color | default: 'var(--c-bg)' }}" data-section-id="{{ section.id }}">
  <div class="page-width">
    <!-- Header -->
    <div style="display:flex;flex-direction:column;align-items:{{ section.settings.text_alignment }};text-align:{{ section.settings.text_alignment }};margin-bottom:48px">
      {%- if section.settings.eyebrow != blank -%}
        <p style="font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--c-accent);margin-bottom:16px">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 style="font-family:var(--f-heading);font-size:clamp(28px, 4vw, 40px);font-weight:700;color:var(--c-text);margin-bottom:16px;line-height:1.2">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p style="font-size:16px;color:var(--c-subtle);max-width:600px;line-height:1.6">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <!-- Products Grid -->
    {%- assign featured = collections[section.settings.collection] -%}
    <div class="featured-products-grid" style="display:grid;grid-template-columns:repeat(auto-fill, minmax({{ section.settings.card_min_width }}px, 1fr));gap:24px">
      {%- if featured != blank and featured.products_count > 0 -%}
        {%- for product in featured.products limit: section.settings.products_count -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        <!-- Placeholders -->
        {%- for i in (1..section.settings.products_count) -%}
          <div class="product-card-placeholder" style="border-radius:var(--radius);overflow:hidden;background:#fff;border:1px solid var(--c-border);display:flex;flex-direction:column">
            <div style="aspect-ratio:1;background:var(--c-subtle-bg, #F3F4F6);display:flex;align-items:center;justify-content:center">
              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div style="padding:20px">
              <div style="height:14px;width:60%;background:var(--c-border);margin-bottom:12px;border-radius:4px"></div>
              <div style="height:20px;width:40%;background:var(--c-border);border-radius:4px"></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <!-- CTA -->
    {%- if section.settings.cta_label != blank and featured != blank -%}
      <div style="text-align:center;margin-top:48px">
        <a href="{{ featured.url }}" class="btn btn--outline" style="padding:14px 40px;font-size:14px;font-weight:700;border-radius:99px;letter-spacing:1px;text-transform:uppercase;border-width:2px;border-color:var(--c-text);color:var(--c-text);text-decoration:none;display:inline-flex;align-items:center;gap:8px;transition:all .3s" onmouseover="this.style.background='var(--c-text)';this.style.color='var(--c-bg)'" onmouseout="this.style.background='transparent';this.style.color='var(--c-text)'">
          {{ section.settings.cta_label }}
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
// Attach generic Add to Cart handler for all Quick Add buttons in the document
// (This handles buttons generated by the product-card snippet)
document.addEventListener('DOMContentLoaded', () => {
  // Use event delegation on body so it works even after AJAX refreshes
  document.body.addEventListener('click', async (e) => {
    const btn = e.target.closest('.card-atc-btn');
    if (!btn) return;
    
    e.preventDefault();
    const id = btn.dataset.id;
    if (!id) return;

    const textEl = btn.querySelector('.btn-text');
    const spinnerEl = btn.querySelector('.btn-spinner');

    btn.disabled = true;
    if(textEl) textEl.style.display = 'none';
    if(spinnerEl) spinnerEl.style.display = 'block';

    try {
      const res = await fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: id, quantity: 1 }] })
      });
      if (res.ok) {
        document.dispatchEvent(new CustomEvent('cart:updated'));
        
        // Show success briefly
        if(spinnerEl) spinnerEl.style.display = 'none';
        if(textEl) {
          textEl.textContent = 'Added';
          textEl.style.display = 'block';
          btn.style.background = '#10B981';
          btn.style.color = '#fff';
        }
        
        setTimeout(() => {
          if(textEl) textEl.textContent = 'Quick Add';
          btn.style.background = '';
          btn.style.color = '';
          btn.disabled = false;
        }, 2000);
      } else {
        alert('Failed to add item to cart');
        btn.disabled = false;
        if(textEl) textEl.style.display = 'block';
        if(spinnerEl) spinnerEl.style.display = 'none';
      }
    } catch (err) {
      console.error(err);
      btn.disabled = false;
      if(textEl) textEl.style.display = 'block';
      if(spinnerEl) spinnerEl.style.display = 'none';
    }
  });
});
</script>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "select", "id": "text_alignment", "label": "Text Alignment", "options": [ {"value":"left","label":"Left"}, {"value":"center","label":"Center"} ], "default": "center" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop Now" },
    { "type": "text", "id": "title", "label": "Title", "default": "Our Bestsellers" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Discover the products our customers can't get enough of." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_count", "label": "Products to show", "min": 4, "max": 16, "step": 4, "default": 8 },
    { "type": "range", "id": "card_min_width", "label": "Card Minimum Width (px)", "min": 200, "max": 400, "step": 10, "default": 280 },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "View All Collection" }
  ],
  "presets": [{ "name": "Featured Collection" }]
}
{% endschema %}
