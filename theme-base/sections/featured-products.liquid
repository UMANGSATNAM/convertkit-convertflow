<div class="page-width" style="padding:60px 20px">
  <div style="text-align:center;margin-bottom:48px">
    {%- if section.settings.eyebrow != blank -%}
    <p style="font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--c-accent);margin-bottom:12px">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 style="font-family:var(--f-heading);font-size:clamp(24px,4vw,40px);margin-bottom:12px">{{ section.settings.title }}</h2>
    {%- if section.settings.cta_label != blank -%}
    <a href="{{ section.settings.cta_url }}" style="margin-top:12px;display:inline-block;font-size:14px;color:var(--c-accent);font-weight:600">{{ section.settings.cta_label }} →</a>
    {%- endif -%}
  </div>
  {%- assign featured = collections[section.settings.collection] -%}
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:24px">
    {%- for product in featured.products limit: section.settings.products_count -%}
      {%- render 'product-card', product: product -%}
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Featured Products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Title", "default": "Bestsellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_count", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "View All" },
    { "type": "url", "id": "cta_url", "label": "Button URL" }
  ],
  "presets": [{ "name": "Featured Products" }]
}
{% endschema %}
