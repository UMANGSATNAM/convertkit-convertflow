<div style="background:var(--c-accent);color:var(--c-accent-text);padding:40px 20px;text-align:center">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
    <h2 style="font-family:var(--f-heading);font-size:clamp(20px,3vw,32px);margin-bottom:8px;color:inherit">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
    <p style="font-size:15px;opacity:.85;margin-bottom:24px">{{ section.settings.subtitle }}</p>
    {%- endif -%}
    <div id="countdown-{{ section.id }}" style="display:flex;justify-content:center;gap:24px;margin-bottom:24px">
      <div style="text-align:center"><span id="cd-d-{{ section.id }}" style="font-family:var(--f-heading);font-size:clamp(32px,5vw,56px);font-weight:700;display:block">00</span><span style="font-size:12px;opacity:.7;text-transform:uppercase;letter-spacing:.08em">Days</span></div>
      <div style="text-align:center;font-family:var(--f-heading);font-size:clamp(32px,5vw,56px);font-weight:700;opacity:.5">:</div>
      <div style="text-align:center"><span id="cd-h-{{ section.id }}" style="font-family:var(--f-heading);font-size:clamp(32px,5vw,56px);font-weight:700;display:block">00</span><span style="font-size:12px;opacity:.7;text-transform:uppercase;letter-spacing:.08em">Hours</span></div>
      <div style="text-align:center;font-family:var(--f-heading);font-size:clamp(32px,5vw,56px);font-weight:700;opacity:.5">:</div>
      <div style="text-align:center"><span id="cd-m-{{ section.id }}" style="font-family:var(--f-heading);font-size:clamp(32px,5vw,56px);font-weight:700;display:block">00</span><span style="font-size:12px;opacity:.7;text-transform:uppercase;letter-spacing:.08em">Mins</span></div>
      <div style="text-align:center;font-family:var(--f-heading);font-size:clamp(32px,5vw,56px);font-weight:700;opacity:.5">:</div>
      <div style="text-align:center"><span id="cd-s-{{ section.id }}" style="font-family:var(--f-heading);font-size:clamp(32px,5vw,56px);font-weight:700;display:block">00</span><span style="font-size:12px;opacity:.7;text-transform:uppercase;letter-spacing:.08em">Secs</span></div>
    </div>
    {%- if section.settings.cta_label != blank -%}
    <a href="{{ section.settings.cta_url }}" style="display:inline-block;padding:14px 36px;border:2px solid rgba(255,255,255,.6);border-radius:var(--radius);font-weight:700;font-size:15px;color:inherit;text-decoration:none;transition:background .2s" onmouseover="this.style.background='rgba(255,255,255,.15)'" onmouseout="this.style.background='transparent'">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</div>
<script>
(function(){
  var end = new Date('{{ section.settings.end_date }}T{{ section.settings.end_time }}:00').getTime();
  function tick(){
    var now=Date.now(), diff=end-now;
    if(diff<=0){diff=0;}
    var d=Math.floor(diff/86400000),
        h=Math.floor((diff%86400000)/3600000),
        m=Math.floor((diff%3600000)/60000),
        s=Math.floor((diff%60000)/1000);
    var pad=n=>String(n).padStart(2,'0');
    document.getElementById('cd-d-{{ section.id }}').textContent=pad(d);
    document.getElementById('cd-h-{{ section.id }}').textContent=pad(h);
    document.getElementById('cd-m-{{ section.id }}').textContent=pad(m);
    document.getElementById('cd-s-{{ section.id }}').textContent=pad(s);
    if(diff>0) requestAnimationFrame(function(){setTimeout(tick,1000);});
  }
  tick();
})();
</script>
{% schema %}
{
  "name": "Countdown Timer",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Sale Ends In" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Get up to 50% off before it's gone!" },
    { "type": "text", "id": "end_date", "label": "End date (YYYY-MM-DD)", "default": "2026-12-31" },
    { "type": "text", "id": "end_time", "label": "End time (HH:MM, 24h)", "default": "23:59" },
    { "type": "text", "id": "cta_label", "label": "CTA Label", "default": "Shop the Sale" },
    { "type": "url", "id": "cta_url", "label": "CTA URL", "default": "/collections/sale" }
  ],
  "presets": [{ "name": "Countdown Timer" }]
}
{% endschema %}
