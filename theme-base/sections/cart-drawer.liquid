<div id="CartDrawer" class="cart-drawer">
  <div class="cart-drawer__header">
    <span style="font-family:var(--f-heading);font-size:20px;font-weight:600">Your Cart <span style="font-size:14px;color:var(--c-subtle);font-family:var(--f-body)">({{ cart.item_count }})</span></span>
    <button id="CartDrawerClose" aria-label="Close cart" style="background:none;border:none;cursor:pointer;padding:4px">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <div id="CartDrawerBody" style="flex:1;overflow-y:auto">
    {%- if cart.item_count == 0 -%}
      <p style="padding:48px 24px;text-align:center;color:var(--c-subtle)">{{ 'cart.general.empty' | t }}</p>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="cart-item" style="display:flex;gap:16px;padding:16px 24px;border-bottom:1px solid var(--c-border)">
          <a href="{{ item.url }}">
            <img src="{{ item.image | image_url: width: 144 }}" alt="{{ item.title | escape }}" width="72" height="72" style="object-fit:cover;border-radius:4px">
          </a>
          <div style="flex:1;min-width:0">
            <a href="{{ item.url }}" style="font-size:14px;font-weight:600;display:block;margin-bottom:2px">{{ item.product_title }}</a>
            {%- if item.variant_title -%}<div style="font-size:12px;color:var(--c-subtle);margin-bottom:8px">{{ item.variant_title }}</div>{%- endif -%}
            <div style="display:flex;align-items:center;gap:10px">
              <button class="qty-btn" data-key="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}" style="width:28px;height:28px;border:1px solid var(--c-border);background:#fff;cursor:pointer;border-radius:4px">−</button>
              <span style="font-size:14px;font-weight:600;min-width:20px;text-align:center">{{ item.quantity }}</span>
              <button class="qty-btn" data-key="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}" style="width:28px;height:28px;border:1px solid var(--c-border);background:#fff;cursor:pointer;border-radius:4px">+</button>
              <button class="remove-btn" data-key="{{ item.key }}" style="margin-left:auto;font-size:11px;color:var(--c-subtle);background:none;border:none;cursor:pointer;text-decoration:underline">Remove</button>
            </div>
          </div>
          <div style="font-size:15px;font-weight:700;white-space:nowrap">{{ item.final_line_price | money }}</div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
    {%- if section.settings.cart_upsell and section.settings.upsell_collection != blank -%}
      <div style="padding:16px 24px;background:var(--c-border);font-size:13px">
        <div style="font-weight:600;margin-bottom:12px">You might also like</div>
        <div style="display:flex;gap:12px;overflow-x:auto">
          {%- for p in section.settings.upsell_collection.products limit: 4 -%}
            <div style="min-width:100px;flex-shrink:0;text-align:center">
              <img src="{{ p.featured_image | image_url: width: 200 }}" width="80" height="80" style="object-fit:cover;border-radius:6px;display:block;margin:0 auto 6px">
              <div style="font-size:11px;font-weight:500;margin-bottom:4px">{{ p.title | truncate: 20 }}</div>
              <div style="font-size:12px;font-weight:700;color:var(--c-accent)">{{ p.price | money }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
    <div class="cart-drawer__footer">
      {%- if settings.cart_notes -%}
        <details style="margin-bottom:16px">
          <summary style="font-size:13px;cursor:pointer;color:var(--c-subtle)">Add order note</summary>
          <textarea name="note" form="CartForm" style="width:100%;margin-top:8px;padding:10px;border:1px solid var(--c-border);font-family:var(--f-body);font-size:13px;resize:none;height:80px">{{ cart.note }}</textarea>
        </details>
      {%- endif -%}
      <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-size:16px;font-weight:600">
        <span>Subtotal</span><span>{{ cart.total_price | money }}</span>
      </div>
      <p style="font-size:12px;color:var(--c-subtle);margin-bottom:12px;text-align:center">Shipping & taxes calculated at checkout</p>
      <a href="{{ routes.checkout_url }}" class="btn btn--primary" style="width:100%;display:block;text-align:center">Checkout</a>
      <a href="{{ routes.cart_url }}" style="display:block;text-align:center;margin-top:10px;font-size:13px;color:var(--c-subtle)">View full cart</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name":"Cart Drawer",
  "settings":[
    {"type":"checkbox","id":"cart_upsell","label":"Show Upsell Products","default":true},
    {"type":"collection","id":"upsell_collection","label":"Upsell Collection"}
  ]
}
{% endschema %}
