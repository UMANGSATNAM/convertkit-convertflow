<div id="CartDrawer" class="cart-drawer" data-section-id="{{ section.id }}">
  <div class="cart-drawer__inner" style="display:flex;flex-direction:column;height:100%;background:var(--c-bg)">
    <!-- Header -->
    <div class="cart-drawer__header" style="display:flex;align-items:center;justify-content:space-between;padding:24px;border-bottom:1px solid var(--c-border)">
      <h2 style="font-family:var(--f-heading);font-size:clamp(20px, 4vw, 24px);font-weight:700;margin:0;color:var(--c-text)">
        Your Cart <span style="font-size:14px;color:var(--c-subtle);font-family:var(--f-body);font-weight:600;background:var(--c-subtle-bg, #F3F4F6);padding:2px 8px;border-radius:12px;margin-left:8px" data-cart-count>{{ cart.item_count }}</span>
      </h2>
      <button class="cart-drawer__close" aria-label="Close cart" style="background:var(--c-subtle-bg, #F3F4F6);border:none;border-radius:50%;width:40px;height:40px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--c-text);transition:background .2s">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Free Shipping Progress -->
    {%- if section.settings.enable_shipping_bar -%}
      {%- assign threshold = section.settings.shipping_threshold | times: 100 -%}
      {%- assign progress = cart.total_price | times: 100.0 | divided_by: threshold -%}
      {%- if progress > 100 -%}{%- assign progress = 100 -%}{%- endif -%}
      <div style="padding:16px 24px;background:var(--c-subtle-bg, #F9FAFB);border-bottom:1px solid var(--c-border)">
        <div style="font-size:13px;font-weight:600;margin-bottom:12px;text-align:center;color:var(--c-text)">
          {%- if cart.total_price >= threshold -%}
            🎉 You've unlocked <strong style="color:var(--c-accent)">Free Shipping!</strong>
          {%- else -%}
            Only <strong style="color:var(--c-accent)">{{ threshold | minus: cart.total_price | money }}</strong> away from Free Shipping!
          {%- endif -%}
        </div>
        <div style="width:100%;height:8px;background:var(--c-border);border-radius:4px;overflow:hidden">
          <div style="height:100%;background:var(--c-accent);width:{{ progress }}%;transition:width .4s cubic-bezier(0.4, 0, 0.2, 1)"></div>
        </div>
      </div>
    {%- endif -%}

    <!-- Body / Line Items -->
    <div class="cart-drawer__body" style="flex:1;overflow-y:auto;padding:24px">
      {%- if cart.item_count == 0 -%}
        <div style="height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center">
          <div style="width:80px;height:80px;background:var(--c-subtle-bg, #F3F4F6);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:24px;color:var(--c-subtle)">
            <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          </div>
          <p style="font-family:var(--f-heading);font-size:20px;font-weight:700;color:var(--c-text);margin-bottom:8px">Your cart is empty</p>
          <p style="font-size:14px;color:var(--c-subtle);margin-bottom:32px">Looks like you haven't added anything yet.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" style="padding:16px 40px;border-radius:var(--radius);font-weight:700;letter-spacing:1px;text-transform:uppercase">Start Shopping</a>
        </div>
      {%- else -%}
        <div class="cart-items" style="display:flex;flex-direction:column;gap:24px">
          {%- for item in cart.items -%}
            <div class="cart-item" style="display:flex;gap:16px;position:relative" data-key="{{ item.key }}">
              <!-- Image -->
              <a href="{{ item.url }}" style="flex-shrink:0;width:96px;height:120px;border-radius:var(--radius);overflow:hidden;background:var(--c-border)">
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" style="width:100%;height:100%;object-fit:cover">
              </a>
              <!-- Info -->
              <div style="flex:1;min-width:0;display:flex;flex-direction:column;padding-right:24px">
                <a href="{{ item.url }}" style="font-family:var(--f-heading);font-size:15px;font-weight:700;color:var(--c-text);text-decoration:none;margin-bottom:4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <div style="font-size:13px;color:var(--c-subtle);margin-bottom:12px">{{ item.variant.title }}</div>
                {%- endunless -%}
                
                <div style="margin-top:auto;display:flex;align-items:center;justify-content:space-between">
                  <!-- Qty -->
                  <div style="display:flex;align-items:center;border:1px solid var(--c-border);border-radius:calc(var(--radius) - 2px);overflow:hidden;background:var(--c-bg)">
                    <button type="button" class="cart-qty-btn" data-action="minus" data-key="{{ item.key }}" style="width:36px;height:36px;background:none;border:none;cursor:pointer;font-size:18px;color:var(--c-text);display:flex;align-items:center;justify-content:center;transition:background .2s">−</button>
                    <input type="number" class="cart-qty-input" data-key="{{ item.key }}" value="{{ item.quantity }}" min="1" style="width:40px;height:36px;text-align:center;border:none;font-size:14px;font-weight:600;font-family:var(--f-body);background:none;color:var(--c-text);-moz-appearance:textfield;margin:0" onkeydown="return false">
                    <button type="button" class="cart-qty-btn" data-action="plus" data-key="{{ item.key }}" style="width:36px;height:36px;background:none;border:none;cursor:pointer;font-size:18px;color:var(--c-text);display:flex;align-items:center;justify-content:center;transition:background .2s">+</button>
                  </div>
                  <!-- Price -->
                  <div style="text-align:right">
                    <div style="font-size:15px;font-weight:700;color:var(--c-accent)">{{ item.final_line_price | money }}</div>
                    {%- if item.original_line_price > item.final_line_price -%}
                      <div style="font-size:12px;color:var(--c-subtle);text-decoration:line-through">{{ item.original_line_price | money }}</div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
              <!-- Remove -->
              <button type="button" class="cart-remove-btn" data-key="{{ item.key }}" style="position:absolute;top:0;right:0;width:24px;height:24px;background:none;border:none;color:var(--c-subtle);cursor:pointer;padding:0;display:flex;align-items:flex-start;justify-content:flex-end">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              </button>
            </div>
          {%- endfor -%}
        </div>

        <!-- Upsell Carousel inside Body -->
        {%- if section.settings.cart_upsell and section.settings.upsell_collection != blank -%}
          <div class="cart-upsell" style="margin-top:32px;padding-top:32px;border-top:1px solid var(--c-border)">
            <h3 style="font-family:var(--f-heading);font-size:16px;font-weight:700;margin-bottom:16px;color:var(--c-text)">Frequently Bought Together</h3>
            <div style="display:flex;gap:16px;overflow-x:auto;scrollbar-width:none;padding-bottom:12px">
              {%- for p in section.settings.upsell_collection.products limit: 4 -%}
                <div class="upsell-item" style="flex:0 0 140px;border:1px solid var(--c-border);border-radius:calc(var(--radius) - 2px);padding:12px;background:var(--c-bg);position:relative">
                  <a href="{{ p.url }}" style="display:block;margin-bottom:12px;border-radius:calc(var(--radius) - 4px);overflow:hidden;background:var(--c-border);aspect-ratio:1">
                    <img src="{{ p.featured_image | image_url: width: 280 }}" alt="{{ p.title | escape }}" style="width:100%;height:100%;object-fit:cover">
                  </a>
                  <a href="{{ p.url }}" style="font-size:12px;font-weight:600;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;color:var(--c-text);text-decoration:none;margin-bottom:8px;height:32px">{{ p.title }}</a>
                  <div style="font-size:13px;font-weight:700;color:var(--c-accent);margin-bottom:12px">{{ p.price | money }}</div>
                  
                  <button type="button" class="btn btn--outline upsell-atc" data-id="{{ p.variants.first.id }}" style="width:100%;height:32px;padding:0;font-size:12px;font-weight:600;border-radius:4px;border-width:1.5px">
                    <span class="btn-text">Add</span>
                    <span class="btn-spinner" style="display:none">
                      <svg viewBox="0 0 50 50" style="width:16px;height:16px;animation:rotate 2s linear infinite"><circle cx="25" cy="25" r="20" fill="none" stroke="currentColor" stroke-width="5" style="stroke-linecap:round;animation:dash 1.5s ease-in-out infinite"></circle></svg>
                    </span>
                  </button>
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    <!-- Footer / Checkout -->
    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__footer" style="background:var(--c-bg);padding:24px;border-top:1px solid var(--c-border);box-shadow:0 -10px 30px rgba(0,0,0,0.03);z-index:2">
        <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:8px">
          <span style="font-family:var(--f-heading);font-size:16px;font-weight:700;color:var(--c-text)">Subtotal</span>
          <span style="font-family:var(--f-heading);font-size:24px;font-weight:700;color:var(--c-accent)">{{ cart.total_price | money }}</span>
        </div>
        <p style="font-size:13px;color:var(--c-subtle);margin-bottom:24px">Taxes and shipping calculated at checkout.</p>
        
        <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm">
          <button type="submit" name="checkout" class="btn btn--primary" style="width:100%;height:60px;font-size:16px;font-weight:700;letter-spacing:1px;text-transform:uppercase;border-radius:var(--radius);display:flex;align-items:center;justify-content:center;gap:12px">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            Checkout Securely
          </button>
        </form>

        <div style="display:flex;align-items:center;justify-content:center;gap:16px;margin-top:24px">
          <svg width="32" height="20" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="38" height="24" rx="4" fill="#E5E7EB"/><path d="M11 12H27M11 12L15 8M11 12L15 16" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <svg width="32" height="20" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="38" height="24" rx="4" fill="#E5E7EB"/><circle cx="19" cy="12" r="5" stroke="#9CA3AF" stroke-width="2"/></svg>
          <svg width="32" height="20" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="38" height="24" rx="4" fill="#E5E7EB"/><path d="M12 8H26M12 12H26M12 16H20" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
class CartDrawer extends HTMLElement {
  constructor() {
    super();
    // Usually defined in global theme.js, but scoping it here for modularity
    this.sectionId = this.querySelector('[data-section-id]').dataset.sectionId;
    this.bindEvents();
  }

  bindEvents() {
    this.querySelectorAll('.cart-qty-btn').forEach(btn => {
      btn.addEventListener('click', this.handleQtyChange.bind(this));
    });
    this.querySelectorAll('.cart-remove-btn').forEach(btn => {
      btn.addEventListener('click', this.handleRemove.bind(this));
    });
    this.querySelectorAll('.upsell-atc').forEach(btn => {
      btn.addEventListener('click', this.handleUpsellAdd.bind(this));
    });
  }

  async updateCart(updates) {
    // Add loading state
    this.style.pointerEvents = 'none';
    this.style.opacity = '0.7';

    try {
      const response = await fetch(window.Shopify.routes.root + 'cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ updates })
      });
      if (response.ok) {
        await this.renderSection();
      }
    } catch (e) {
      console.error(e);
    } finally {
      this.style.pointerEvents = 'auto';
      this.style.opacity = '1';
    }
  }

  async renderSection() {
    try {
      const response = await fetch(`?sections=${this.sectionId}`);
      const data = await response.json();
      const html = new DOMParser().parseFromString(data[this.sectionId], 'text/html');
      this.innerHTML = html.body.innerHTML;
      this.bindEvents();
    } catch(e) {
      console.error('Failed to render cart drawer', e);
      window.location.reload();
    }
  }

  handleQtyChange(e) {
    const btn = e.currentTarget;
    const key = btn.dataset.key;
    const input = this.querySelector(`.cart-qty-input[data-key="${key}"]`);
    let qty = parseInt(input.value);
    
    if (btn.dataset.action === 'plus') qty++;
    else if (btn.dataset.action === 'minus') qty--;

    if (qty === 0) {
      this.updateCart({ [key]: 0 });
    } else {
      input.value = qty;
      this.updateCart({ [key]: qty });
    }
  }

  handleRemove(e) {
    const key = e.currentTarget.dataset.key;
    this.updateCart({ [key]: 0 });
  }

  async handleUpsellAdd(e) {
    const btn = e.currentTarget;
    const id = btn.dataset.id;
    
    btn.querySelector('.btn-text').style.display = 'none';
    btn.querySelector('.btn-spinner').style.display = 'flex';
    btn.disabled = true;

    try {
      await fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: id, quantity: 1 }] })
      });
      await this.renderSection();
    } catch (err) {
      console.error(err);
      btn.querySelector('.btn-text').style.display = 'block';
      btn.querySelector('.btn-spinner').style.display = 'none';
      btn.disabled = false;
    }
  }
}
customElements.define('cart-drawer', CartDrawer);

// Listen for Add To Cart generic events from product page
document.addEventListener('cart:updated', () => {
  const drawer = document.querySelector('cart-drawer');
  if (drawer) {
    drawer.renderSection();
    // Assuming you have a drawer open logic in global.js, e.g. document.body.classList.add('drawer-open')
    document.body.classList.add('cart-drawer-open');
  }
});
</script>

<style>
/* Reset and utilities */
cart-drawer { display: block; height: 100%; }
.cart-drawer .btn-spinner {
  align-items: center;
  justify-content: center;
}
</style>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": [
    { "type": "header", "content": "Free Shipping Progress" },
    { "type": "checkbox", "id": "enable_shipping_bar", "label": "Enable Free Shipping Bar", "default": true },
    { "type": "number", "id": "shipping_threshold", "label": "Free Shipping Threshold ($)", "default": 100 },
    
    { "type": "header", "content": "Upsell" },
    { "type": "checkbox", "id": "cart_upsell", "label": "Show Upsell Products", "default": true },
    { "type": "collection", "id": "upsell_collection", "label": "Upsell Collection" }
  ]
}
{% endschema %}
