<div class="page-width" style="padding:80px 20px">
  <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:48px;border-bottom:2px solid var(--c-border);padding-bottom:24px">
    <div>
      <h1 style="font-family:var(--f-heading);font-size:clamp(32px, 5vw, 48px);font-weight:800;color:var(--c-text);margin-bottom:8px">My Account</h1>
      <p style="color:var(--c-subtle);font-size:16px">Welcome back, {{ customer.first_name | default: 'VIP' }}!</p>
    </div>
    <a href="{{ routes.account_logout_url }}" style="font-size:14px;font-weight:700;color:var(--c-text);text-decoration:underline;text-transform:uppercase;letter-spacing:1px">Log out</a>
  </div>

  <div style="display:grid;grid-template-columns:1fr 380px;gap:48px" class="account-grid">
    <!-- Left: Order History -->
    <div>
      <h2 style="font-family:var(--f-heading);font-size:24px;font-weight:700;margin-bottom:24px;color:var(--c-text)">Order History</h2>
      
      {% paginate customer.orders by 10 %}
        {%- if customer.orders.size > 0 -%}
          <div style="background:var(--c-bg);border:1px solid var(--c-border);border-radius:12px;overflow:hidden">
            <table style="width:100%;border-collapse:collapse;text-align:left">
              <thead>
                <tr style="background:var(--c-subtle-bg, #F9FAFB);border-bottom:1px solid var(--c-border)">
                  <th style="padding:16px 24px;font-size:12px;font-weight:700;color:var(--c-subtle);text-transform:uppercase;letter-spacing:1px">Order</th>
                  <th style="padding:16px 24px;font-size:12px;font-weight:700;color:var(--c-subtle);text-transform:uppercase;letter-spacing:1px">Date</th>
                  <th style="padding:16px 24px;font-size:12px;font-weight:700;color:var(--c-subtle);text-transform:uppercase;letter-spacing:1px">Status</th>
                  <th style="padding:16px 24px;font-size:12px;font-weight:700;color:var(--c-subtle);text-transform:uppercase;letter-spacing:1px">Total</th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr style="border-bottom:1px solid var(--c-border);transition:background .2s" onmouseover="this.style.background='var(--c-subtle-bg, #F9FAFB)'" onmouseout="this.style.background='transparent'">
                    <td style="padding:20px 24px">
                      <a href="{{ order.customer_url }}" style="font-weight:700;color:var(--c-text);text-decoration:none">{{ order.name }}</a>
                    </td>
                    <td style="padding:20px 24px;font-size:14px;color:var(--c-subtle)">{{ order.created_at | date: format: 'abbreviated_date' }}</td>
                    <td style="padding:20px 24px">
                      <span style="display:inline-block;padding:4px 10px;font-size:12px;font-weight:700;border-radius:4px;{% if order.fulfillment_status_label == 'Fulfilled' %}background:#D1FAE5;color:#065F46;{% else %}background:#FEF3C7;color:#92400E;{% endif %}">{{ order.fulfillment_status_label }}</span>
                    </td>
                    <td style="padding:20px 24px;font-weight:700;color:var(--c-text)">{{ order.total_net_amount | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          {%- if paginate.pages > 1 -%}
            <div style="margin-top:24px;text-align:center">{{ paginate | default_pagination }}</div>
          {%- endif -%}
        {%- else -%}
          <div style="padding:60px 24px;text-align:center;background:var(--c-subtle-bg, #F9FAFB);border-radius:12px;border:1px solid var(--c-border)">
            <div style="width:64px;height:64px;background:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;color:var(--c-subtle)">
              <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            </div>
            <p style="font-size:18px;font-weight:700;margin-bottom:8px;color:var(--c-text)">No orders yet</p>
            <p style="color:var(--c-subtle);margin-bottom:24px">Looks like you haven't made any purchases yet.</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" style="padding:12px 32px;border-radius:8px;font-weight:700">Start Shopping</a>
          </div>
        {%- endif -%}
      {% endpaginate %}
    </div>

    <!-- Right: Account Details -->
    <div>
      <div style="background:var(--c-subtle-bg, #F9FAFB);border:1px solid var(--c-border);border-radius:12px;padding:32px;position:sticky;top:40px">
        <h2 style="font-family:var(--f-heading);font-size:20px;font-weight:700;margin-bottom:24px;color:var(--c-text)">Account Details</h2>
        
        <div style="margin-bottom:32px">
          <div style="font-size:16px;font-weight:700;color:var(--c-text);margin-bottom:4px">{{ customer.name }}</div>
          <div style="font-size:14px;color:var(--c-subtle)">{{ customer.email }}</div>
        </div>

        <h3 style="font-size:14px;font-weight:700;color:var(--c-text);text-transform:uppercase;letter-spacing:1px;margin-bottom:16px;border-bottom:1px solid var(--c-border);padding-bottom:8px">Default Address</h3>
        
        {%- if customer.default_address -%}
          <div style="font-size:14px;line-height:1.6;color:var(--c-subtle);margin-bottom:24px">
            {{ customer.default_address | format_address }}
          </div>
        {%- else -%}
          <p style="font-size:14px;color:var(--c-subtle);margin-bottom:24px">No default address saved.</p>
        {%- endif -%}
        
        <a href="{{ routes.account_addresses_url }}" class="btn btn--outline" style="display:block;width:100%;text-align:center;padding:12px;font-size:14px;font-weight:700;border-radius:8px;text-transform:uppercase;letter-spacing:1px;border-width:2px;border-color:var(--c-text);color:var(--c-text);text-decoration:none;transition:all .2s" onmouseover="this.style.background='var(--c-text)';this.style.color='var(--c-bg)'" onmouseout="this.style.background='transparent';this.style.color='var(--c-text)'">
          View Addresses ({{ customer.addresses_count }})
        </a>
      </div>
    </div>
  </div>
</div>

<style>
@media (max-width: 768px) {
  .account-grid { grid-template-columns: 1fr !important; gap: 48px !important; }
  table th, table td { padding: 16px 12px !important; }
}
</style>

{% schema %}
{
  "name": "Customer Account",
  "settings": [],
  "presets": [{"name": "Customer Account"}]
}
{% endschema %}