{% schema %}
{
  "name": "Shoppable Image",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Lookbook Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the Look" },
    { "type": "color", "id": "pin_color", "label": "Pin Color", "default": "#ffffff" },
    { "type": "color", "id": "pin_bg", "label": "Pin Background", "default": "#000000" }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Product Hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "top", "label": "Top Position (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "left", "label": "Left Position (%)", "min": 0, "max": 100, "step": 1, "default": 50 }
      ]
    }
  ],
  "presets": [{ "name": "Shoppable Image (Lookbook)" }]
}
{% endschema %}

{%- style -%}
  .cf-shoppable-{{ section.id }} { max-width: 1200px; margin: 60px auto; padding: 0 20px; font-family: var(--f-body, sans-serif); }
  .cf-shoppable-title { text-align: center; font-family: var(--f-heading, serif); font-size: 32px; font-weight: 700; margin-bottom: 32px; }
  .cf-shoppable-wrap { position: relative; border-radius: 12px; overflow: hidden; background: #f0f0f0; }
  .cf-shoppable-img { width: 100%; height: auto; display: block; object-fit: cover; }
  .cf-hotspot {
    position: absolute;
    width: 28px;
    height: 28px;
    background: {{ section.settings.pin_bg }};
    color: {{ section.settings.pin_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 4px rgba(255,255,255,0.3);
    transition: transform 0.2s, box-shadow 0.2s;
    z-index: 10;
  }
  .cf-hotspot:hover { transform: translate(-50%, -50%) scale(1.1); box-shadow: 0 0 0 6px rgba(255,255,255,0.4); }
  .cf-hotspot::after { content: ''; position: absolute; inset: -10px; border-radius: 50%; }
  
  .cf-hotspot-card {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: #fff;
    width: 220px;
    border-radius: 8px;
    padding: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    z-index: 20;
  }
  .cf-hotspot-card::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 8px;
    border-style: solid;
    border-color: #fff transparent transparent transparent;
  }
  .cf-hotspot:hover .cf-hotspot-card,
  .cf-hotspot:focus .cf-hotspot-card {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }
  .cf-hc-img { width: 100%; height: 160px; object-fit: cover; border-radius: 4px; margin-bottom: 12px; }
  .cf-hc-title { font-size: 13px; font-weight: 600; color: #111; margin-bottom: 4px; text-decoration: none; display: block; line-height: 1.3; }
  .cf-hc-price { font-size: 14px; font-weight: 700; color: var(--c-accent, #000); }
  .cf-hc-btn { display: block; width: 100%; background: var(--c-accent, #000); color: #fff; text-align: center; padding: 8px; font-size: 12px; font-weight: 600; text-decoration: none; border-radius: 4px; margin-top: 10px; }
{%- endstyle -%}

<div class="cf-shoppable-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="cf-shoppable-title">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="cf-shoppable-wrap">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="{{ section.settings.image.alt | escape }}" class="cf-shoppable-img" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'cf-shoppable-img' }}
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      <div class="cf-hotspot" style="top:{{ block.settings.top }}%; left:{{ block.settings.left }}%" {{ block.shopify_attributes }}>
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        
        <div class="cf-hotspot-card">
          {%- if p != blank -%}
            <a href="{{ p.url }}">
              <img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.title }}" class="cf-hc-img">
            </a>
            <a href="{{ p.url }}" class="cf-hc-title">{{ p.title | truncate: 40 }}</a>
            <div class="cf-hc-price">{{ p.price | money }}</div>
            <a href="{{ p.url }}" class="cf-hc-btn">View Product</a>
          {%- else -%}
            <div style="background:#eee;height:160px;margin-bottom:12px;border-radius:4px"></div>
            <div class="cf-hc-title">Example Product</div>
            <div class="cf-hc-price">$99.00</div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
