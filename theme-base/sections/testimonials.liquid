<div class="page-width" style="padding:60px 20px">
  <div style="text-align:center;margin-bottom:48px">
    <h2 style="font-family:var(--f-heading);font-size:clamp(24px,4vw,40px);margin-bottom:12px">{{ section.settings.title }}</h2>
    {%- if section.settings.subtitle != blank -%}
    <p style="color:var(--c-subtle);max-width:560px;margin:0 auto">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:32px">
    {%- for block in section.blocks -%}
      {%- if block.type == 'testimonial' -%}
      <div style="padding:32px;border-radius:calc(var(--radius)*2);background:var(--c-subtle-bg,#f8f8f6)" {{ block.shopify_attributes }}>
        <div style="display:flex;gap:4px;margin-bottom:16px">
          {%- for i in (1..5) -%}
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="{%- if i <= block.settings.rating -%}var(--c-accent){%- else -%}#ddd{%- endif -%}" style="display:block"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          {%- endfor -%}
        </div>
        <p style="font-size:15px;line-height:1.7;color:var(--c-text);margin-bottom:20px">"{{ block.settings.quote }}"</p>
        <div style="display:flex;align-items:center;gap:12px">
          {%- if block.settings.avatar != blank -%}
          <img src="{{ block.settings.avatar | image_url: width: 80 }}" alt="{{ block.settings.name | escape }}" width="40" height="40" style="border-radius:50%;object-fit:cover;width:40px;height:40px">
          {%- else -%}
          <div style="width:40px;height:40px;border-radius:50%;background:var(--c-accent);display:flex;align-items:center;justify-content:center;color:var(--c-accent-text);font-weight:700;font-size:16px">{{ block.settings.name | slice: 0 }}</div>
          {%- endif -%}
          <div>
            <p style="font-weight:600;font-size:14px">{{ block.settings.name }}</p>
            {%- if block.settings.location != blank -%}
            <p style="font-size:13px;color:var(--c-subtle)">{{ block.settings.location }}</p>
            {%- endif -%}
          </div>
        </div>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "What Our Customers Say" },
    { "type": "text", "id": "subtitle", "label": "Subtitle" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Absolutely love this product!" },
        { "type": "text", "id": "name", "label": "Name", "default": "Happy Customer" },
        { "type": "text", "id": "location", "label": "Location", "default": "Mumbai, India" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
