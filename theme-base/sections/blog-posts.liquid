<div class="page-width" style="padding:60px 20px 80px">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:40px;flex-wrap:wrap;gap:16px">
    <h1 style="font-family:var(--f-heading);font-size:clamp(24px,4vw,40px)">{{ blog.title }}</h1>
    {%- if blog.tags.size > 0 -%}
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <a href="{{ blog.url }}" style="padding:6px 16px;border:1px solid var(--c-border);border-radius:99px;font-size:13px;color:var(--c-text);text-decoration:none{%- if current_tags == blank %};background:var(--c-accent);color:var(--c-accent-text);border-color:var(--c-accent){%- endif %}">All</a>
      {%- for tag in blog.tags -%}
      <a href="{{ blog.url }}/tagged/{{ tag | handle }}" style="padding:6px 16px;border:1px solid var(--c-border);border-radius:99px;font-size:13px;color:var(--c-text);text-decoration:none{%- if current_tags contains tag %};background:var(--c-accent);color:var(--c-accent-text);border-color:var(--c-accent){%- endif %}">{{ tag }}</a>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
  {%- paginate blog.articles by section.settings.posts_per_page -%}
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:32px;margin-bottom:48px">
    {%- for article in blog.articles -%}
    <article style="border-radius:calc(var(--radius)*2);overflow:hidden;border:1px solid var(--c-border)">
      {%- if article.image -%}
      <a href="{{ article.url }}">
        <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" width="600" height="400" style="width:100%;height:200px;object-fit:cover;display:block">
      </a>
      {%- endif -%}
      <div style="padding:24px">
        {%- if article.tags.size > 0 -%}
        <p style="font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--c-accent);margin-bottom:8px">{{ article.tags.first }}</p>
        {%- endif -%}
        <h2 style="font-family:var(--f-heading);font-size:20px;margin-bottom:8px;line-height:1.3"><a href="{{ article.url }}" style="color:var(--c-text);text-decoration:none">{{ article.title }}</a></h2>
        <p style="font-size:14px;color:var(--c-subtle);margin-bottom:12px">{{ article.published_at | date: "%b %d, %Y" }}</p>
        <p style="font-size:15px;line-height:1.6;color:var(--c-subtle);margin-bottom:16px">{{ article.excerpt | strip_html | truncate: 120 }}</p>
        <a href="{{ article.url }}" style="font-size:14px;font-weight:600;color:var(--c-accent);text-decoration:none">Read More →</a>
      </div>
    </article>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}
  <div style="display:flex;justify-content:center;gap:8px">
    {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btn-outline">← Previous</a>{%- endif -%}
    {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn-outline">Next →</a>{%- endif -%}
  </div>
  {%- endif -%}
  {%- endpaginate -%}
</div>
{% schema %}
{
  "name": "Blog Posts",
  "settings": [
    { "type": "range", "id": "posts_per_page", "label": "Posts per page", "min": 3, "max": 24, "step": 3, "default": 9 }
  ],
  "presets": [{ "name": "Blog Posts" }]
}
{% endschema %}
