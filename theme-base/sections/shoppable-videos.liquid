<div class="shoppable-videos-section" style="padding: 40px 20px; background: {{ section.settings.bg_color | default: 'var(--bg-color, #ffffff)' }};">
  <div style="max-width: 1200px; margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px;">
      <div>
        <h2 style="font-size: clamp(24px, 4vw, 32px); font-weight: 800; margin-bottom: 8px; color: var(--text-color, #111);">{{ section.settings.heading | default: 'Discover in Motion' }}</h2>
        <p style="font-size: 14px; color: #666;">{{ section.settings.subheading | default: 'See our bestsellers in real life.' }}</p>
      </div>
      <a data-href="{{ section.settings.link_url | default: '#' }}" style="font-size: 13px; font-weight: 700; text-decoration: underline; color: var(--accent-color, #111);">{{ section.settings.link_text | default: 'View all' }}</a>
    </div>

    <!-- Video Carousel Row -->
    <div class="sv-carousel" style="display: flex; gap: 16px; overflow-x: auto; padding-bottom: 16px; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;">
      {% for block in section.blocks %}
        {% assign v_product = all_products[block.settings.product] | default: product %}
        <div class="sv-card" 
             onclick="openShoppableModal('{{ block.settings.video_url | default: 'https://cdn.shopify.com/s/files/1/0556/4104/7206/files/sample-vertical.mp4' }}', '{{ v_product.title | escape | default: 'Luxury Product' }}', '{{ v_product.price | default: 5000 | money }}', '{{ v_product.featured_image | img_url: '400x' }}')"
             style="flex: 0 0 240px; height: 420px; border-radius: 16px; overflow: hidden; position: relative; scroll-snap-align: start; cursor: pointer; background: #000; box-shadow: 0 10px 30px rgba(0,0,0,0.05);">
          
          <!-- Video Thumbnail/Preview -->
          <video src="{{ block.settings.video_url | default: 'https://cdn.shopify.com/s/files/1/0556/4104/7206/files/sample-vertical.mp4' }}" 
                 muted loop playsinline autoplay 
                 style="width: 100%; height: 100%; object-fit: cover; opacity: 0.9; transition: opacity 0.3s;"></video>
          
          <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 50%); pointer-events: none;"></div>
          
          <div style="position: absolute; bottom: 16px; left: 16px; right: 16px; display: flex; align-items: center; gap: 12px; z-index: 2;">
            <div style="width: 40px; height: 40px; border-radius: 8px; background: #fff; overflow: hidden; flex-shrink: 0;">
              {% if v_product.featured_image %}
                <img src="{{ v_product.featured_image | img_url: '100x' }}" alt="Image" style="width: 100%; height: 100%; object-fit: cover;">
              {% else %}
                <div style="width:100%; height:100%; background:#f0f0f0;"></div>
              {% endif %}
            </div>
            <div style="color: #fff; overflow: hidden;">
              <div style="font-size: 13px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ v_product.title | default: 'Signature Collection' }}</div>
              <div style="font-size: 12px; font-weight: 500; opacity: 0.9;">{{ v_product.price | default: 5000 | money }}</div>
            </div>
          </div>
          
          <!-- Play Icon Overlay -->
          <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 48px; height: 48px; border-radius: 50%; background: rgba(255,255,255,0.2); backdrop-filter: blur(4px); display: flex; justify-content: center; align-items: center; pointer-events: none;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </div>
        </div>
      {% endfor %}
      
      <!-- Fallback empty state for demo if no blocks -->
      {% if section.blocks.size == 0 %}
        {% for i in (1..4) %}
        <div class="sv-card" onclick="openShoppableModal('https://www.w3schools.com/html/mov_bbb.mp4', 'Sample Product', '₹1,299', '')" style="flex: 0 0 240px; height: 420px; border-radius: 16px; overflow: hidden; position: relative; scroll-snap-align: start; cursor: pointer; background: #111; box-shadow: 0 10px 30px rgba(0,0,0,0.05);">
          <div style="position: absolute; inset: 0; display:flex; align-items:center; justify-content:center; color:#555; font-size:12px; text-transform:uppercase; font-weight:700;">Demo Video {{ i }}</div>
          <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 50%); pointer-events: none;"></div>
          <div style="position: absolute; bottom: 16px; left: 16px; right: 16px; display: flex; align-items: center; gap: 12px; z-index: 2;">
            <div style="width: 40px; height: 40px; border-radius: 8px; background: #fff; overflow: hidden; flex-shrink: 0;"></div>
            <div style="color: #fff; overflow: hidden;">
              <div style="font-size: 13px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Sample Product {{ i }}</div>
              <div style="font-size: 12px; font-weight: 500; opacity: 0.9;">₹1,299</div>
            </div>
          </div>
        </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

<!-- Shoppable Modal -->
<div id="shoppableModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.9); backdrop-filter: blur(10px); z-index: 9999; justify-content: center; align-items: center;">
  <div style="position: relative; width: 100%; max-width: 400px; height: 100vh; max-height: 800px; background: #000; overflow: hidden;">
    <!-- Close button -->
    <button onclick="closeShoppableModal()" style="position: absolute; top: 20px; right: 20px; z-index: 10; width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.2); border: none; color: #fff; font-size: 24px; display: flex; justify-content: center; align-items: center; cursor: pointer; backdrop-filter: blur(4px);">×</button>
    
    <!-- Full Video -->
    <video id="shoppablePlayer" src="" playsinline loop style="width: 100%; height: 100%; object-fit: cover;" onclick="togglePlayPause(this)"></video>
    
    <!-- Product Overlay (Add to Cart) -->
    <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 24px 20px; background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, transparent 100%);">
      <div style="background: rgba(255,255,255,0.1); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.2); border-radius: 16px; padding: 16px; display: flex; gap: 16px; align-items: center;">
        <img id="shoppableImg" src="" alt="Image" style="width: 60px; height: 60px; border-radius: 8px; object-fit: cover; background: #fff;">
        <div style="flex: 1; color: #fff;">
          <div id="shoppableTitle" style="font-weight: 700; font-size: 15px; margin-bottom: 4px;"></div>
          <div id="shoppablePrice" style="font-size: 14px; opacity: 0.9; margin-bottom: 12px;"></div>
          <button onclick="shoppableAddToCart()" style="width: 100%; background: #fff; color: #000; border: none; padding: 10px; border-radius: 8px; font-weight: 700; font-size: 14px; cursor: pointer;">
            Add to Cart
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .sv-carousel::-webkit-scrollbar { display: none; }
  .sv-card:hover video { transform: scale(1.05); transition: transform 0.5s ease; }
</style>

<script>
  function openShoppableModal(videoUrl, title, price, img) {
    const modal = document.getElementById('shoppableModal');
    const player = document.getElementById('shoppablePlayer');
    document.getElementById('shoppableTitle').innerText = title;
    document.getElementById('shoppablePrice').innerText = price;
    document.getElementById('shoppableImg').src = img || 'data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs='; // fallback 1x1 transparent if no img
    
    player.src = videoUrl;
    modal.style.display = 'flex';
    player.play();
  }
  function closeShoppableModal() {
    const modal = document.getElementById('shoppableModal');
    const player = document.getElementById('shoppablePlayer');
    player.pause();
    modal.style.display = 'none';
  }
  function togglePlayPause(video) {
    if (video.paused) video.play();
    else video.pause();
  }
  function shoppableAddToCart() {
    alert("Added to Cart from Video!");
    closeShoppableModal();
    if(window.openCartDrawer) window.openCartDrawer();
  }
</script>

{% schema %}
{
  "name": "Shoppable Videos",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover in Motion" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "See our bestsellers in real life." }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "product", "id": "product", "label": "Linked Product" },
        { "type": "url", "id": "video_url", "label": "MP4 Video URL" }
      ]
    }
  ],
  "presets": [
    { "name": "Shoppable Videos", "category": "Media" }
  ]
}
{% endschema %}
