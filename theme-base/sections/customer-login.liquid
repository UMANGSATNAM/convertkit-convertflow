<div class="page-width" style="padding:100px 20px;max-width:520px;margin:0 auto">
  <div style="text-align:center;margin-bottom:40px">
    <h1 style="font-family:var(--f-heading);font-size:36px;font-weight:800;color:var(--c-text);margin-bottom:12px;line-height:1.2">Welcome Back</h1>
    <p style="color:var(--c-subtle);font-size:16px;line-height:1.5">Sign in to your account to access your orders, saved items, and exclusive offers.</p>
  </div>

  <div style="background:var(--c-bg);padding:40px;border-radius:16px;box-shadow:0 10px 40px rgba(0,0,0,0.06);border:1px solid var(--c-border)">
    {%- form 'customer_login' -%}
      {%- if form.errors -%}
        <div style="padding:16px;background:#FEF2F2;border-left:4px solid #EF4444;border-radius:0 8px 8px 0;color:#991B1B;font-size:14px;margin-bottom:24px;display:flex;align-items:flex-start;gap:12px">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20" style="flex-shrink:0"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
          <div>{{ form.errors | default_errors }}</div>
        </div>
      {%- endif -%}
      
      <div style="margin-bottom:24px">
        <label for="CustomerEmail" style="display:block;font-size:13px;font-weight:700;color:var(--c-text);margin-bottom:8px;text-transform:uppercase;letter-spacing:1px">Email Address</label>
        <input type="email" name="customer[email]" id="CustomerEmail" required autocomplete="email" autocorrect="off" autocapitalize="off" style="width:100%;padding:14px 16px;border:1px solid var(--c-border);border-radius:8px;font-family:var(--f-body);font-size:16px;background:var(--c-subtle-bg, #F9FAFB);color:var(--c-text);transition:all .2s;outline:none" onfocus="this.style.borderColor='var(--c-text)';this.style.background='var(--c-bg)'" onblur="this.style.borderColor='var(--c-border)';this.style.background='var(--c-subtle-bg, #F9FAFB)'">
      </div>
      
      <div style="margin-bottom:32px">
        <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px">
          <label for="CustomerPassword" style="font-size:13px;font-weight:700;color:var(--c-text);text-transform:uppercase;letter-spacing:1px">Password</label>
          <a href="{{ routes.root_url }}account/login#recover" style="font-size:13px;color:var(--c-subtle);text-decoration:underline;transition:color .2s" onmouseover="this.style.color='var(--c-text)'" onmouseout="this.style.color='var(--c-subtle)'">Forgot password?</a>
        </div>
        <input type="password" name="customer[password]" id="CustomerPassword" required autocomplete="current-password" style="width:100%;padding:14px 16px;border:1px solid var(--c-border);border-radius:8px;font-family:var(--f-body);font-size:16px;background:var(--c-subtle-bg, #F9FAFB);color:var(--c-text);transition:all .2s;outline:none" onfocus="this.style.borderColor='var(--c-text)';this.style.background='var(--c-bg)'" onblur="this.style.borderColor='var(--c-border)';this.style.background='var(--c-subtle-bg, #F9FAFB)'">
      </div>
      
      <button type="submit" class="btn btn--primary" style="width:100%;padding:16px;font-size:16px;font-weight:700;letter-spacing:1px;text-transform:uppercase;border-radius:8px">Sign In Securely</button>
    {%- endform -%}
    
    <div style="text-align:center;margin-top:32px;padding-top:32px;border-top:1px solid var(--c-border)">
      <p style="font-size:15px;color:var(--c-subtle)">Don't have an account yet?</p>
      <a href="{{ routes.account_register_url }}" class="btn btn--outline" style="display:inline-block;margin-top:16px;padding:12px 32px;font-size:14px;font-weight:700;border-radius:8px;letter-spacing:1px;text-transform:uppercase;text-decoration:none;border-width:2px;border-color:var(--c-text);color:var(--c-text);transition:all .2s" onmouseover="this.style.background='var(--c-text)';this.style.color='var(--c-bg)'" onmouseout="this.style.background='transparent';this.style.color='var(--c-text)'">Create Account</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Login",
  "settings": [],
  "presets": [{"name": "Customer Login"}]
}
{% endschema %}