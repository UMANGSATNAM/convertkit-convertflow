{%- assign hotspot_image = section.settings.image -%}
<div class="page-width" style="padding:60px 20px">
  {%- if section.settings.heading != blank -%}
  <h2 style="font-family:var(--f-heading);font-size:clamp(24px,4vw,40px);text-align:center;margin-bottom:48px">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div style="position:relative;display:inline-block;width:100%;border-radius:calc(var(--radius)*2);overflow:visible">
    {%- if hotspot_image != blank -%}
    <img src="{{ hotspot_image | image_url: width: 1400 }}" alt="{{ hotspot_image.alt | escape }}" width="1400" style="width:100%;height:auto;display:block;border-radius:calc(var(--radius)*2);max-height:700px;object-fit:cover">
    {%- else -%}
    <div style="width:100%;height:500px;background:linear-gradient(135deg,#e5e7eb,#d1d5db);border-radius:calc(var(--radius)*2);display:flex;align-items:center;justify-content:center"><p style="color:#9ca3af;font-size:16px">Add an image in the theme editor</p></div>
    {%- endif -%}
    {%- for block in section.blocks -%}
    {%- if block.type == 'hotspot' -%}
    <div style="position:absolute;top:{{ block.settings.position_y }}%;left:{{ block.settings.position_x }}%;transform:translate(-50%,-50%);z-index:10" {{ block.shopify_attributes }}>
      <button style="width:32px;height:32px;border-radius:50%;background:var(--c-accent);color:var(--c-accent-text);border:3px solid #fff;box-shadow:0 2px 12px rgba(0,0,0,.3);cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;transition:transform .2s;animation:hotspot-pulse 2s infinite" onclick="this.nextElementSibling.style.display=this.nextElementSibling.style.display=='none'?'block':'none'" aria-label="View product">+</button>
      <div style="display:none;position:absolute;bottom:calc(100% + 12px);left:50%;transform:translateX(-50%);background:var(--c-bg);border:1px solid var(--c-border);border-radius:calc(var(--radius)*2);padding:16px;width:220px;box-shadow:0 8px 32px rgba(0,0,0,.15);z-index:20">
        {%- if block.settings.product != blank -%}
          {%- assign hp = all_products[block.settings.product] -%}
          {%- if hp -%}
          <a href="{{ hp.url }}" style="display:flex;gap:12px;text-decoration:none;color:var(--c-text)">
            <img src="{{ hp.featured_image | image_url: width: 80 }}" alt="{{ hp.title | escape }}" width="60" height="60" style="width:60px;height:60px;object-fit:cover;border-radius:var(--radius);flex-shrink:0">
            <div><p style="font-size:13px;font-weight:600;margin-bottom:4px;line-height:1.3">{{ hp.title | truncate: 50 }}</p><p style="font-size:14px;font-weight:700;color:var(--c-accent)">{{ hp.price | money }}</p></div>
          </a>
          {%- endif -%}
        {%- else -%}
        <p style="font-weight:600;font-size:14px;margin-bottom:4px">{{ block.settings.label }}</p>
        {%- if block.settings.caption != blank -%}<p style="font-size:13px;color:var(--c-subtle)">{{ block.settings.caption }}</p>{%- endif -%}
        {%- if block.settings.link_url != blank -%}<a href="{{ block.settings.link_url }}" style="font-size:13px;color:var(--c-accent);font-weight:600;text-decoration:none;margin-top:8px;display:block">{{ block.settings.link_label | default: 'Shop Now' }} →</a>{%- endif -%}
        {%- endif -%}
      </div>
    </div>
    {%- endif -%}
    {%- endfor -%}
  </div>
</div>
<style>
@keyframes hotspot-pulse{0%,100%{box-shadow:0 0 0 0 rgba(var(--c-accent-rgb,37,99,235),.4)}50%{box-shadow:0 0 0 8px rgba(var(--c-accent-rgb,37,99,235),0)}}
</style>
{% schema %}
{
  "name":"Image Hotspot",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Shop the Look"},
    {"type":"image_picker","id":"image","label":"Background Image"}
  ],
  "blocks":[{
    "type":"hotspot","name":"Hotspot",
    "settings":[
      {"type":"range","id":"position_x","label":"Position X (%)","min":5,"max":95,"step":1,"default":50},
      {"type":"range","id":"position_y","label":"Position Y (%)","min":5,"max":95,"step":1,"default":50},
      {"type":"product","id":"product","label":"Link a Product"},
      {"type":"text","id":"label","label":"Label (if no product)","default":"Featured Item"},
      {"type":"text","id":"caption","label":"Caption"},
      {"type":"url","id":"link_url","label":"Link URL"},
      {"type":"text","id":"link_label","label":"Link Text","default":"Shop Now"}
    ]
  }],
  "presets":[{"name":"Image Hotspot"}]
}
{% endschema %}
