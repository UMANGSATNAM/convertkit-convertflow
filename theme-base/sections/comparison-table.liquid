<div class="page-width" style="padding:60px 20px">
  {%- if section.settings.heading != blank -%}
  <h2 style="font-family:var(--f-heading);font-size:clamp(24px,4vw,40px);text-align:center;margin-bottom:48px">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div style="overflow-x:auto;-webkit-overflow-scrolling:touch">
    <table style="width:100%;border-collapse:collapse;min-width:600px">
      <thead>
        <tr>
          <th style="padding:16px 20px;text-align:left;font-family:var(--f-heading);font-size:15px;border-bottom:2px solid var(--c-border);width:200px">Feature</th>
          {%- for block in section.blocks -%}
            {%- if block.type == 'column' -%}
            <th style="padding:16px 20px;text-align:center;font-family:var(--f-heading);font-size:15px;border-bottom:2px solid var(--c-border){%- if block.settings.highlight -%};background:var(--c-accent);color:var(--c-accent-text);border-radius:12px 12px 0 0{%- endif -%}" {{ block.shopify_attributes }}>
              {%- if block.settings.badge != blank -%}<span style="display:block;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:4px;opacity:.7">{{ block.settings.badge }}</span>{%- endif -%}
              {{ block.settings.column_title }}
              {%- if block.settings.price != blank -%}<span style="display:block;font-size:13px;font-weight:400;margin-top:4px;opacity:.8">{{ block.settings.price }}</span>{%- endif -%}
            </th>
            {%- endif -%}
          {%- endfor -%}
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          {%- if block.type == 'row' -%}
          <tr style="border-bottom:1px solid var(--c-border)" {{ block.shopify_attributes }}>
            <td style="padding:14px 20px;font-size:14px;font-weight:600">{{ block.settings.feature_name }}</td>
            {%- assign vals = block.settings.values | split: ',' -%}
            {%- for val in vals -%}
            <td style="padding:14px 20px;text-align:center;font-size:14px">
              {%- assign v = val | strip -%}
              {%- if v == 'yes' or v == 'true' -%}<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>{%- elsif v == 'no' or v == 'false' -%}<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>{%- else -%}{{ v }}{%- endif -%}
            </td>
            {%- endfor -%}
          </tr>
          {%- endif -%}
        {%- endfor -%}
      </tbody>
    </table>
  </div>
</div>
{% schema %}
{
  "name":"Comparison Table",
  "settings":[{"type":"text","id":"heading","label":"Heading","default":"Compare Plans"}],
  "blocks":[
    {"type":"column","name":"Column","settings":[
      {"type":"text","id":"column_title","label":"Column Title","default":"Basic"},
      {"type":"text","id":"price","label":"Price","default":"Free"},
      {"type":"text","id":"badge","label":"Badge (e.g. Popular)"},
      {"type":"checkbox","id":"highlight","label":"Highlight Column","default":false}
    ]},
    {"type":"row","name":"Row","settings":[
      {"type":"text","id":"feature_name","label":"Feature Name","default":"Feature"},
      {"type":"text","id":"values","label":"Values (comma separated: yes/no/text)","default":"yes,no,yes"}
    ]}
  ],
  "presets":[{"name":"Comparison Table"}]
}
{% endschema %}
