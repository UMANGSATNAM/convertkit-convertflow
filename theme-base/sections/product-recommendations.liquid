{%- if recommendations.performed and recommendations.products_count > 0 -%}
<div class="page-width" style="padding:60px 20px">
  <h2 style="font-family:var(--f-heading);font-size:clamp(20px,3vw,32px);margin-bottom:32px;text-align:center">{{ section.settings.title }}</h2>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:24px">
    {%- for product in recommendations.products limit: section.settings.products_count -%}
      {%- render 'product-card', product: product -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Product Recommendations",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Title", "default": "You May Also Like" },
    { "type": "range", "id": "products_count", "label": "Products", "min": 2, "max": 8, "step": 2, "default": 4 }
  ],
  "presets": [{ "name": "Product Recommendations" }]
}
{% endschema %}
