{% assign main_menu = section.settings.menu | default: 'main-menu' %}
<style>
.site-header { position: sticky; top: 0; z-index: 200; background: var(--c-bg); border-bottom: 1px solid var(--c-border); transition: transform 0.3s; }
.site-header.scrolled { box-shadow: 0 4px 20px rgba(0,0,0,0.05); }
.site-header__inner { display: flex; align-items: center; justify-content: space-between; padding: 0 24px; height: 80px; max-width: 1400px; margin: 0 auto; }
.site-header__nav-wrap { flex: 1; margin: 0 40px; }
.site-header__nav { list-style: none; display: flex; gap: 32px; height: 100%; align-items: center; }
.site-header__nav-item { position: relative; height: 80px; display: flex; align-items: center; }
.site-header__nav-item > a { font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; text-decoration: none; color: var(--c-text); transition: color 0.2s; display: flex; align-items: center; gap: 6px; }
.site-header__nav-item > a:hover { color: var(--c-accent); }

/* Mega Menu */
.mega-menu { position: absolute; top: 100%; left: 0; background: var(--c-bg); border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border); padding: 40px; display: none; box-shadow: 0 10px 30px rgba(0,0,0,0.08); width: 100vw; transform: translateX(calc(-50vw + 50%)); z-index: 100; }
.has-mega:hover .mega-menu { display: block; animation: cf-fade-down 0.2s ease forwards; }

.mega-menu-inner { max-width: 1200px; margin: 0 auto; display: flex; gap: 60px; }
.mega-menu-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 40px; flex: 1; }
.mega-col-title { font-size: 15px; font-weight: 700; font-family: var(--f-heading, serif); margin-bottom: 16px; display: block; text-decoration: none; color: var(--c-text); border-bottom: 1px solid var(--c-border); padding-bottom: 8px; }
.mega-col-list { list-style: none; display: flex; flex-direction: column; gap: 10px; }
.mega-col-list a { font-size: 14px; color: var(--c-subtle); text-decoration: none; transition: color 0.2s; }
.mega-col-list a:hover { color: var(--c-accent); }

.mega-menu-promos { display: flex; gap: 20px; width: 320px; flex-shrink: 0; }
.mega-promo { position: relative; border-radius: 8px; overflow: hidden; display: block; group; flex: 1; }
.mega-promo img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
.mega-promo:hover img { transform: scale(1.05); }
.mega-promo-text { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.7), transparent); display: flex; align-items: flex-end; padding: 20px; color: #fff; font-size: 16px; font-weight: 700; font-family: var(--f-heading, serif); }

@keyframes cf-fade-down { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }

/* Mobile Menu */
.mobile-menu { position: fixed; top: 0; left: 0; width: 300px; height: 100vh; background: var(--c-bg); z-index: 999; transform: translateX(-100%); transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); overflow-y: auto; padding: 24px; box-shadow: 4px 0 24px rgba(0,0,0,0.1); }
.mobile-menu.open { transform: translateX(0); }
.mobile-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 998; opacity: 0; visibility: hidden; transition: opacity 0.3s; }
.mobile-overlay.active { opacity: 1; visibility: visible; }

.site-header__actions { display: flex; gap: 16px; align-items: center; }

@media (max-width: 990px) {
  .site-header__nav-wrap { display: none; }
  .mobile-menu-toggle { display: block !important; }
  .site-header__inner { padding: 0 16px; }
}
</style>

<header class="site-header" id="SiteHeader">
  <div class="site-header__inner">
    <button class="mobile-menu-toggle" data-mobile-menu-toggle aria-label="Menu" style="display:none;background:none;border:none;cursor:pointer;padding:4px;color:var(--c-text)">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    
    <a href="{{ routes.root_url }}" class="site-header__logo" style="display:flex;align-items:center">
      {%- if section.settings.logo -%}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" width="{{ section.settings.logo_width }}" height="auto" loading="eager">
      {%- else -%}
        <span style="font-family:var(--f-heading, serif);font-size:24px;font-weight:800;color:var(--c-text);letter-spacing:-0.5px">{{ shop.name }}</span>
      {%- endif -%}
    </a>
    
    <nav class="site-header__nav-wrap" aria-label="Main navigation">
      <ul class="site-header__nav">
        {%- for link in linklists[main_menu].links -%}
          {%- assign is_mega = false -%}
          {%- assign mega_block = null -%}
          
          {%- for block in section.blocks -%}
            {%- assign block_title = block.settings.menu_item | downcase | trim -%}
            {%- assign link_title = link.title | downcase | trim -%}
            {%- if block_title == link_title -%}
              {%- assign is_mega = true -%}
              {%- assign mega_block = block -%}
            {%- endif -%}
          {%- endfor -%}

          <li class="site-header__nav-item {% if is_mega or link.links.size > 0 %}has-mega{% endif %}">
            <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>
              {{ link.title }}
              {% if is_mega or link.links.size > 0 %}
                <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
              {% endif %}
            </a>
            
            {%- if is_mega or link.links.size > 0 -%}
              <div class="mega-menu">
                <div class="mega-menu-inner">
                  <div class="mega-menu-links">
                    {%- for child in link.links -%}
                      <div>
                        <a href="{{ child.url }}" class="mega-col-title">{{ child.title }}</a>
                        {%- if child.links.size > 0 -%}
                          <ul class="mega-col-list">
                            {%- for grandchild in child.links -%}
                              <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>
                  
                  {%- if is_mega -%}
                    <div class="mega-menu-promos">
                      {%- if mega_block.settings.image_1 != blank -%}
                        <a href="{{ mega_block.settings.link_1 | default: '#' }}" class="mega-promo">
                          <img src="{{ mega_block.settings.image_1 | image_url: width: 400 }}" alt="">
                          {%- if mega_block.settings.text_1 != blank -%}
                            <div class="mega-promo-text">{{ mega_block.settings.text_1 }}</div>
                          {%- endif -%}
                        </a>
                      {%- endif -%}
                      {%- if mega_block.settings.image_2 != blank -%}
                        <a href="{{ mega_block.settings.link_2 | default: '#' }}" class="mega-promo">
                          <img src="{{ mega_block.settings.image_2 | image_url: width: 400 }}" alt="">
                          {%- if mega_block.settings.text_2 != blank -%}
                            <div class="mega-promo-text">{{ mega_block.settings.text_2 }}</div>
                          {%- endif -%}
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
    
    <div class="site-header__actions">
      {%- if settings.enable_search -%}
        <button data-open-search aria-label="{{ 'general.search.title' | t }}" style="background:none;border:none;cursor:pointer;color:var(--c-text)">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      {%- endif -%}
      
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" aria-label="Account" style="color:var(--c-text)">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
      {%- endif -%}
      
      <button data-open-cart class="cart-count" aria-label="Cart" style="background:none;border:none;cursor:pointer;color:var(--c-text);position:relative">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="cart-count__badge" style="position:absolute;top:-6px;right:-8px;background:var(--c-accent);color:var(--c-accent-text);font-size:11px;font-weight:700;width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:2px solid var(--c-bg)">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-overlay" data-mobile-menu-toggle></div>
<nav class="mobile-menu" id="MobileMenu" aria-label="Mobile navigation">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:32px;padding-bottom:16px;border-bottom:1px solid var(--c-border)">
    <span style="font-size:18px;font-weight:700;font-family:var(--f-heading, serif)">Menu</span>
    <button data-mobile-menu-toggle style="background:none;border:none;cursor:pointer;padding:4px;color:var(--c-text)">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <ul style="list-style:none;display:flex;flex-direction:column;gap:8px">
    {%- for link in linklists[main_menu].links -%}
      <li>
        <div style="display:flex;align-items:center;justify-content:space-between">
          <a href="{{ link.url }}" style="display:block;padding:12px 0;font-size:16px;font-weight:600;color:var(--c-text);text-decoration:none">{{ link.title }}</a>
          {%- if link.links.size > 0 -%}
            <button onclick="this.nextElementSibling.classList.toggle('open')" style="background:none;border:none;padding:12px"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg></button>
            <ul style="display:none;list-style:none;padding-left:16px;margin-bottom:12px;border-left:1px solid var(--c-border)">
              {%- for child in link.links -%}
                <li><a href="{{ child.url }}" style="display:block;padding:8px 0;font-size:14px;color:var(--c-subtle);text-decoration:none">{{ child.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggles = document.querySelectorAll('[data-mobile-menu-toggle]');
    const menu = document.getElementById('MobileMenu');
    const overlay = document.querySelector('.mobile-overlay');
    
    toggles.forEach(t => {
      t.addEventListener('click', () => {
        menu.classList.toggle('open');
        overlay.classList.toggle('active');
        document.body.style.overflow = menu.classList.contains('open') ? 'hidden' : '';
      });
    });
  });
</script>

{% schema %}
{
  "name": "Header & Mega Menu",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main Menu", "default": "main-menu" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo Width", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 140 }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega Menu Promos",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Menu Item Name", "info": "Enter the exact name of the menu item (e.g., 'Shop')" },
        { "type": "image_picker", "id": "image_1", "label": "Promo Image 1" },
        { "type": "text", "id": "text_1", "label": "Promo Text 1" },
        { "type": "url", "id": "link_1", "label": "Promo Link 1" },
        { "type": "image_picker", "id": "image_2", "label": "Promo Image 2" },
        { "type": "text", "id": "text_2", "label": "Promo Text 2" },
        { "type": "url", "id": "link_2", "label": "Promo Link 2" }
      ]
    }
  ]
}
{% endschema %}
