<div class="page-width" style="padding:100px 20px;max-width:520px;margin:0 auto">
  <div style="text-align:center;margin-bottom:40px">
    <h1 style="font-family:var(--f-heading);font-size:36px;font-weight:800;color:var(--c-text);margin-bottom:12px;line-height:1.2">Create Account</h1>
    <p style="color:var(--c-subtle);font-size:16px;line-height:1.5">Join us to track your orders, save your favorite items, and receive exclusive member perks.</p>
  </div>

  <div style="background:var(--c-bg);padding:40px;border-radius:16px;box-shadow:0 10px 40px rgba(0,0,0,0.06);border:1px solid var(--c-border)">
    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <div style="padding:16px;background:#FEF2F2;border-left:4px solid #EF4444;border-radius:0 8px 8px 0;color:#991B1B;font-size:14px;margin-bottom:24px;display:flex;align-items:flex-start;gap:12px">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20" style="flex-shrink:0"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
          <div>{{ form.errors | default_errors }}</div>
        </div>
      {%- endif -%}

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px">
        <div>
          <label for="RegisterForm-FirstName" style="display:block;font-size:13px;font-weight:700;color:var(--c-text);margin-bottom:8px;text-transform:uppercase;letter-spacing:1px">First Name</label>
          <input type="text" name="customer[first_name]" id="RegisterForm-FirstName" autocomplete="given-name" style="width:100%;padding:14px 16px;border:1px solid var(--c-border);border-radius:8px;font-family:var(--f-body);font-size:16px;background:var(--c-subtle-bg, #F9FAFB);color:var(--c-text);transition:all .2s;outline:none" onfocus="this.style.borderColor='var(--c-text)';this.style.background='var(--c-bg)'" onblur="this.style.borderColor='var(--c-border)';this.style.background='var(--c-subtle-bg, #F9FAFB)'">
        </div>
        <div>
          <label for="RegisterForm-LastName" style="display:block;font-size:13px;font-weight:700;color:var(--c-text);margin-bottom:8px;text-transform:uppercase;letter-spacing:1px">Last Name</label>
          <input type="text" name="customer[last_name]" id="RegisterForm-LastName" autocomplete="family-name" style="width:100%;padding:14px 16px;border:1px solid var(--c-border);border-radius:8px;font-family:var(--f-body);font-size:16px;background:var(--c-subtle-bg, #F9FAFB);color:var(--c-text);transition:all .2s;outline:none" onfocus="this.style.borderColor='var(--c-text)';this.style.background='var(--c-bg)'" onblur="this.style.borderColor='var(--c-border)';this.style.background='var(--c-subtle-bg, #F9FAFB)'">
        </div>
      </div>
      
      <div style="margin-bottom:20px">
        <label for="RegisterForm-email" style="display:block;font-size:13px;font-weight:700;color:var(--c-text);margin-bottom:8px;text-transform:uppercase;letter-spacing:1px">Email Address</label>
        <input type="email" name="customer[email]" id="RegisterForm-email" required autocomplete="email" autocorrect="off" autocapitalize="off" style="width:100%;padding:14px 16px;border:1px solid var(--c-border);border-radius:8px;font-family:var(--f-body);font-size:16px;background:var(--c-subtle-bg, #F9FAFB);color:var(--c-text);transition:all .2s;outline:none" onfocus="this.style.borderColor='var(--c-text)';this.style.background='var(--c-bg)'" onblur="this.style.borderColor='var(--c-border)';this.style.background='var(--c-subtle-bg, #F9FAFB)'">
      </div>
      
      <div style="margin-bottom:32px">
        <label for="RegisterForm-password" style="display:block;font-size:13px;font-weight:700;color:var(--c-text);margin-bottom:8px;text-transform:uppercase;letter-spacing:1px">Password</label>
        <input type="password" name="customer[password]" id="RegisterForm-password" required autocomplete="new-password" style="width:100%;padding:14px 16px;border:1px solid var(--c-border);border-radius:8px;font-family:var(--f-body);font-size:16px;background:var(--c-subtle-bg, #F9FAFB);color:var(--c-text);transition:all .2s;outline:none" onfocus="this.style.borderColor='var(--c-text)';this.style.background='var(--c-bg)'" onblur="this.style.borderColor='var(--c-border)';this.style.background='var(--c-subtle-bg, #F9FAFB)'">
        <p style="font-size:12px;color:var(--c-subtle);margin-top:8px">Must be at least 5 characters long.</p>
      </div>
      
      <button type="submit" class="btn btn--primary" style="width:100%;padding:16px;font-size:16px;font-weight:700;letter-spacing:1px;text-transform:uppercase;border-radius:8px">Create Account</button>
    {%- endform -%}
    
    <div style="text-align:center;margin-top:32px;padding-top:32px;border-top:1px solid var(--c-border)">
      <p style="font-size:15px;color:var(--c-subtle)">Already have an account? <a href="{{ routes.account_login_url }}" style="color:var(--c-text);font-weight:700;text-decoration:underline">Sign In</a></p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Register",
  "settings": [],
  "presets": [{"name": "Customer Register"}]
}
{% endschema %}