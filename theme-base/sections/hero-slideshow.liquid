<div class="slideshow" data-auto="{{ section.settings.autoplay_speed | times: 1000 }}" style="position:relative;overflow:hidden;height:{{ section.settings.height }}vh">
  {%- for block in section.blocks -%}
    {%- if block.type == 'slide' -%}
      <div class="slide" style="position:absolute;inset:0;display:flex;align-items:center;{% if block.settings.content_position == 'center' %}justify-content:center;text-align:center;{% elsif block.settings.content_position == 'right' %}justify-content:flex-end;text-align:right;{% endif %}">
        {%- if block.settings.image -%}
          <img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.heading | escape }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
        {%- else -%}
          <div style="position:absolute;inset:0;background:linear-gradient(135deg,{{ block.settings.bg_from }},{{ block.settings.bg_to }});z-index:0"></div>
        {%- endif -%}
        {%- if block.settings.overlay_opacity > 0 -%}
          <div style="position:absolute;inset:0;background:rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by: 100.0 }});z-index:1"></div>
        {%- endif -%}
        <div style="position:relative;z-index:2;padding:0 48px;max-width:700px" data-animate>
          {%- if block.settings.eyebrow != blank -%}<div style="font-size:13px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:{{ block.settings.text_color }};opacity:.8;margin-bottom:16px">{{ block.settings.eyebrow }}</div>{%- endif -%}
          <h2 style="font-size:clamp(32px,5vw,68px);line-height:1.1;color:{{ block.settings.text_color }};margin-bottom:20px;font-family:var(--f-heading)">{{ block.settings.heading }}</h2>
          {%- if block.settings.subtext != blank -%}<p style="font-size:18px;color:{{ block.settings.text_color }};opacity:.85;margin-bottom:32px;max-width:500px">{{ block.settings.subtext }}</p>{%- endif -%}
          <div style="display:flex;gap:16px;flex-wrap:wrap;{% if block.settings.content_position == 'center' %}justify-content:center{% endif %}">
            {%- if block.settings.btn1_text != blank -%}
              <a href="{{ block.settings.btn1_url }}" class="btn btn--primary">{{ block.settings.btn1_text }}</a>
            {%- endif -%}
            {%- if block.settings.btn2_text != blank -%}
              <a href="{{ block.settings.btn2_url }}" class="btn btn--outline" style="color:{{ block.settings.text_color }};border-color:{{ block.settings.text_color }}">{{ block.settings.btn2_text }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
  {%- if section.blocks.size > 1 -%}
    <button class="slide-prev" style="position:absolute;left:20px;top:50%;transform:translateY(-50%);z-index:10;background:rgba(255,255,255,.2);border:none;width:48px;height:48px;border-radius:50%;cursor:pointer;backdrop-filter:blur(4px);color:#fff;font-size:20px">‹</button>
    <button class="slide-next" style="position:absolute;right:20px;top:50%;transform:translateY(-50%);z-index:10;background:rgba(255,255,255,.2);border:none;width:48px;height:48px;border-radius:50%;cursor:pointer;backdrop-filter:blur(4px);color:#fff;font-size:20px">›</button>
    <div style="position:absolute;bottom:20px;left:50%;transform:translateX(-50%);display:flex;gap:8px;z-index:10">
      {%- for block in section.blocks -%}{%- if block.type == 'slide' -%}<button style="width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.5);border:none;cursor:pointer;transition:all .2s"></button>{%- endif -%}{%- endfor -%}
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name":"Hero Slideshow",
  "settings":[
    {"type":"range","id":"height","label":"Height (vh)","min":40,"max":100,"step":5,"default":80},
    {"type":"range","id":"autoplay_speed","label":"Autoplay Speed (sec)","min":3,"max":10,"step":1,"default":5}
  ],
  "blocks":[{"type":"slide","name":"Slide","settings":[
    {"type":"image_picker","id":"image","label":"Background Image"},
    {"type":"color","id":"bg_from","label":"Gradient From","default":"#1a1a2e"},
    {"type":"color","id":"bg_to","label":"Gradient To","default":"#16213e"},
    {"type":"range","id":"overlay_opacity","label":"Image Overlay (%)","min":0,"max":80,"step":5,"default":40},
    {"type":"text","id":"eyebrow","label":"Eyebrow Text"},
    {"type":"text","id":"heading","label":"Heading","default":"Bold Headline Here"},
    {"type":"text","id":"subtext","label":"Subtext"},
    {"type":"select","id":"content_position","label":"Content Position","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"text","id":"btn1_text","label":"Button 1 Text","default":"Shop Now"},
    {"type":"url","id":"btn1_url","label":"Button 1 URL"},
    {"type":"text","id":"btn2_text","label":"Button 2 Text"},
    {"type":"url","id":"btn2_url","label":"Button 2 URL"}
  ]}],
  "presets":[{"name":"Hero Slideshow","blocks":[{"type":"slide"}]}]
}
{% endschema %}
