{% if section.settings.announcement_text != blank %}
<div class="announcement-bar" style="background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }}">
  <div style="max-width:var(--page-width);margin:0 auto;display:flex;align-items:center;justify-content:center;gap:16px;padding:10px 24px">
    {%- if section.settings.show_icon -%}<span>🎉</span>{%- endif -%}
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" style="color:inherit;font-size:13px;font-weight:500">{{ section.settings.announcement_text }}</a>
    {%- else -%}
      <span style="font-size:13px;font-weight:500">{{ section.settings.announcement_text }}</span>
    {%- endif -%}
    {%- if section.settings.show_countdown and section.settings.countdown_date != blank -%}
      <span style="font-size:12px;opacity:.8">Ends in: <span data-countdown="{{ section.settings.countdown_date }}"><span data-hours>00</span>h <span data-minutes>00</span>m <span data-seconds>00</span>s</span></span>
    {%- endif -%}
  </div>
</div>
{% endif %}
{% schema %}
{
  "name":"Announcement Bar",
  "settings":[
    {"type":"text","id":"announcement_text","label":"Text","default":"Free shipping on orders over ₹999!"},
    {"type":"url","id":"link","label":"Link"},
    {"type":"color","id":"bg_color","label":"Background","default":"#111111"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"checkbox","id":"show_icon","label":"Show Emoji Icon","default":true},
    {"type":"checkbox","id":"show_countdown","label":"Show Countdown","default":false},
    {"type":"text","id":"countdown_date","label":"Countdown End Date","placeholder":"2025-12-31T23:59:59"}
  ]
}
{% endschema %}
