<div style="padding:60px 20px;background:var(--c-subtle-bg,#f8f8f6)">
  <div class="page-width" style="display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;max-width:900px;margin:0 auto">
    <div>
      <h2 style="font-family:var(--f-heading);font-size:clamp(22px,3.5vw,36px);margin-bottom:12px">{{ section.settings.title }}</h2>
      <p style="color:var(--c-subtle);font-size:15px;line-height:1.6;margin-bottom:28px">{{ section.settings.text }}</p>
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
        <p style="color:green;font-weight:600">Thanks for subscribing!</p>
        {%- else -%}
        <div style="display:flex;gap:0">
          <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required style="flex:1;padding:14px 18px;border:1px solid var(--c-border);border-right:none;border-radius:var(--radius) 0 0 var(--radius);font-family:var(--f-body);font-size:15px;background:var(--c-bg);color:var(--c-text)">
          <button type="submit" style="padding:14px 24px;background:var(--c-accent);color:var(--c-accent-text);border:none;border-radius:0 var(--radius) var(--radius) 0;font-weight:700;font-size:15px;cursor:pointer;white-space:nowrap">{{ section.settings.btn }}</button>
        </div>
        {%- endif -%}
      {%- endform -%}
    </div>
    {%- if section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 600 }}" alt="Newsletter" width="600" style="width:100%;border-radius:calc(var(--radius)*2);object-fit:cover;height:280px">
    {%- endif -%}
  </div>
</div>
<style>@media(max-width:640px){.page-width>div{grid-template-columns:1fr!important}}</style>
{% schema %}
{
  "name": "Email Signup",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Join Our Community" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Get exclusive deals, new arrivals, and more delivered to your inbox." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email" },
    { "type": "text", "id": "btn", "label": "Button label", "default": "Subscribe" },
    { "type": "image_picker", "id": "image", "label": "Side image" }
  ],
  "presets": [{ "name": "Email Signup" }]
}
{% endschema %}
