<div class="image-with-text page-width" style="display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;padding:60px 20px">
  {%- if section.settings.image_position == 'right' -%}
  <div>
    <p style="font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--c-accent);margin-bottom:12px">{{ section.settings.eyebrow }}</p>
    <h2 style="font-family:var(--f-heading);font-size:clamp(24px,4vw,44px);margin-bottom:20px;line-height:1.2">{{ section.settings.heading }}</h2>
    <div class="rte" style="color:var(--c-subtle);font-size:16px;line-height:1.7;margin-bottom:28px">{{ section.settings.body }}</div>
    {%- if section.settings.cta_label != blank -%}
    <a href="{{ section.settings.cta_url }}" class="btn-primary">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
  {%- if section.settings.image != blank -%}
  <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" width="900" style="width:100%;border-radius:calc(var(--radius)*2);object-fit:cover;aspect-ratio:4/3" loading="lazy">
  {%- else -%}
  <div style="aspect-ratio:4/3;background:var(--c-border);border-radius:calc(var(--radius)*2)"></div>
  {%- endif -%}
  {%- else -%}
  {%- if section.settings.image != blank -%}
  <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" width="900" style="width:100%;border-radius:calc(var(--radius)*2);object-fit:cover;aspect-ratio:4/3" loading="lazy">
  {%- else -%}
  <div style="aspect-ratio:4/3;background:var(--c-border);border-radius:calc(var(--radius)*2)"></div>
  {%- endif -%}
  <div>
    <p style="font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--c-accent);margin-bottom:12px">{{ section.settings.eyebrow }}</p>
    <h2 style="font-family:var(--f-heading);font-size:clamp(24px,4vw,44px);margin-bottom:20px;line-height:1.2">{{ section.settings.heading }}</h2>
    <div class="rte" style="color:var(--c-subtle);font-size:16px;line-height:1.7;margin-bottom:28px">{{ section.settings.body }}</div>
    {%- if section.settings.cta_label != blank -%}
    <a href="{{ section.settings.cta_url }}" class="btn-primary">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
  {%- endif -%}
</div>
<style>@media(max-width:768px){.image-with-text{grid-template-columns:1fr!important}}</style>
{% schema %}
{
  "name": "Image with Text",
  "settings": [
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"select","id":"image_position","label":"Image Position","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}],"default":"left"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our Story"},
    {"type":"text","id":"heading","label":"Heading","default":"Built for the Bold"},
    {"type":"richtext","id":"body","label":"Body","default":"<p>Tell your brand story here. Keep it authentic, compelling, and customer-focused.</p>"},
    {"type":"text","id":"cta_label","label":"Button Label","default":"Learn More"},
    {"type":"url","id":"cta_url","label":"Button URL","default":"/pages/about"}
  ],
  "presets":[{"name":"Image with Text"}]
}
{% endschema %}
