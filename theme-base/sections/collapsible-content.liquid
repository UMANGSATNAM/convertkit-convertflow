<div class="page-width" style="padding:60px 20px 80px;max-width:800px;margin:0 auto">
  {%- for block in section.blocks -%}
    {%- if block.type == 'faq_item' -%}
    <details style="border-bottom:1px solid var(--c-border);padding:4px 0" {{ block.shopify_attributes }}>
      <summary style="font-family:var(--f-heading);font-size:17px;font-weight:600;padding:20px 0;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px">
        {{ block.settings.question }}
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;transition:transform .3s"><path d="M6 9l6 6 6-6"/></svg>
      </summary>
      <div style="padding:0 0 20px;font-size:15px;line-height:1.7;color:var(--c-subtle)">{{ block.settings.answer }}</div>
    </details>
    {%- endif -%}
  {%- endfor -%}
</div>
<script>
document.querySelectorAll('details').forEach(d=>{
  d.addEventListener('toggle',()=>{
    const svg=d.querySelector('svg');
    if(svg) svg.style.transform=d.open?'rotate(180deg)':'rotate(0deg)';
  });
});
</script>
{% schema %}
{
  "name": "FAQ",
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is your return policy?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "We offer 30-day hassle-free returns on all products." }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
