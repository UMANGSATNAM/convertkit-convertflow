<div style="padding:60px 20px;background:var(--c-subtle-bg,#f8f8f6)">
  <div class="page-width">
    <div style="text-align:center;margin-bottom:48px">
      <h2 style="font-family:var(--f-heading);font-size:clamp(24px,4vw,40px);margin-bottom:12px">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p style="color:var(--c-subtle);max-width:560px;margin:0 auto">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:24px">
      {%- for block in section.blocks -%}
      {%- if block.type == 'press_item' -%}
      <div style="background:var(--c-bg);border-radius:calc(var(--radius)*2);padding:28px 24px;display:flex;flex-direction:column;gap:16px" {{ block.shopify_attributes }}>
        {%- if block.settings.logo != blank -%}
        <img src="{{ block.settings.logo | image_url: height: 40 }}" alt="{{ block.settings.publication | escape }}" height="40" style="height:32px;width:auto;object-fit:contain;filter:grayscale(1);opacity:.6">
        {%- else -%}
        <p style="font-weight:700;font-size:14px;color:var(--c-subtle)">{{ block.settings.publication }}</p>
        {%- endif -%}
        <p style="font-size:15px;line-height:1.7;color:var(--c-text);font-style:italic">"{{ block.settings.quote }}"</p>
        {%- if block.settings.link_url != blank -%}
        <a href="{{ block.settings.link_url }}" target="_blank" rel="noopener" style="font-size:13px;color:var(--c-accent);font-weight:600;text-decoration:none">Read Article →</a>
        {%- endif -%}
      </div>
      {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name":"Press Coverage",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"As Seen In"},
    {"type":"text","id":"subheading","label":"Subheading"}
  ],
  "blocks":[{
    "type":"press_item","name":"Press Item",
    "settings":[
      {"type":"image_picker","id":"logo","label":"Publication Logo"},
      {"type":"text","id":"publication","label":"Publication Name","default":"Forbes"},
      {"type":"textarea","id":"quote","label":"Quote","default":"A game-changing product that everyone needs."},
      {"type":"url","id":"link_url","label":"Article URL"}
    ]
  }],
  "presets":[{"name":"Press Coverage"}]
}
{% endschema %}
