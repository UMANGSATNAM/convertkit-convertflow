<div style="background:{{ section.settings.bg_color | default: '#f8f8f6' }};padding:48px 20px">
  <div class="page-width" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:24px">
    {%- for block in section.blocks -%}
    {%- if block.type == 'badge' -%}
    <div style="display:flex;align-items:center;gap:14px;padding:20px;background:var(--c-bg);border-radius:calc(var(--radius)*2);box-shadow:0 2px 8px rgba(0,0,0,.06)" {{ block.shopify_attributes }}>
      {%- if block.settings.icon_image != blank -%}
      <img src="{{ block.settings.icon_image | image_url: width: 80 }}" alt="" width="44" height="44" style="width:44px;height:44px;object-fit:contain;flex-shrink:0">
      {%- else -%}
      <div style="width:44px;height:44px;border-radius:50%;background:rgba(0,0,0,.06);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0">{{ block.settings.emoji | default: '✓' }}</div>
      {%- endif -%}
      <div>
        <p style="font-weight:700;font-size:14px;margin-bottom:2px">{{ block.settings.title }}</p>
        {%- if block.settings.subtitle != blank -%}<p style="font-size:12px;color:var(--c-subtle);line-height:1.4">{{ block.settings.subtitle }}</p>{%- endif -%}
      </div>
    </div>
    {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name":"Trust Badges",
  "settings":[
    {"type":"color","id":"bg_color","label":"Background Color","default":"#f8f8f6"}
  ],
  "blocks":[{
    "type":"badge","name":"Trust Badge",
    "settings":[
      {"type":"image_picker","id":"icon_image","label":"Icon Image"},
      {"type":"text","id":"emoji","label":"Emoji (if no image)","default":"🔒"},
      {"type":"text","id":"title","label":"Title","default":"Secure Payment"},
      {"type":"text","id":"subtitle","label":"Subtitle","default":"SSL encrypted checkout"}
    ]
  }],
  "presets":[{"name":"Trust Badges"}]
}
{% endschema %}
