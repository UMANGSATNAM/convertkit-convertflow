<div class="page-width" style="padding:60px 20px">
  {%- if section.settings.heading != blank -%}
  <div style="text-align:center;margin-bottom:48px">
    <h2 style="font-family:var(--f-heading);font-size:clamp(24px,4vw,40px)">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p style="color:var(--c-subtle);margin-top:12px;max-width:560px;margin-left:auto;margin-right:auto">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  {%- endif -%}
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax({{ section.settings.min_col_width }}px,1fr));gap:{{ section.settings.gap }}px">
    {%- for block in section.blocks -%}
    <div style="text-align:{{ section.settings.text_align }}" {{ block.shopify_attributes }}>
      {%- if block.settings.icon_svg != blank -%}
      <div style="width:56px;height:56px;border-radius:var(--radius);background:rgba(0,0,0,.06);display:flex;align-items:center;justify-content:center;margin:0 {%- if section.settings.text_align == 'center' -%}auto{%- else -%}0{%- endif -%} 20px">
        {{ block.settings.icon_svg }}
      </div>
      {%- elsif block.settings.emoji != blank -%}
      <div style="font-size:36px;margin-bottom:16px;display:block">{{ block.settings.emoji }}</div>
      {%- endif -%}
      <h3 style="font-family:var(--f-heading);font-size:18px;margin-bottom:10px">{{ block.settings.title }}</h3>
      <p style="font-size:15px;color:var(--c-subtle);line-height:1.65">{{ block.settings.text }}</p>
    </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Multicolumn",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Why Choose Us"},
    {"type":"text","id":"subheading","label":"Subheading"},
    {"type":"select","id":"text_align","label":"Alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"center"},
    {"type":"range","id":"min_col_width","label":"Min Column Width (px)","min":180,"max":360,"step":20,"default":220},
    {"type":"range","id":"gap","label":"Gap (px)","min":16,"max":60,"step":4,"default":32}
  ],
  "blocks":[{
    "type":"column","name":"Column",
    "settings":[
      {"type":"text","id":"emoji","label":"Emoji Icon"},
      {"type":"html","id":"icon_svg","label":"SVG Icon"},
      {"type":"text","id":"title","label":"Title","default":"Fast Delivery"},
      {"type":"textarea","id":"text","label":"Text","default":"We deliver to your doorstep within 3-5 business days."}
    ]
  }],
  "presets":[{"name":"Multicolumn"}]
}
{% endschema %}
