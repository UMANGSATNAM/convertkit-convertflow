<div class="page-width" style="padding:60px 20px 80px;max-width:900px;margin:0 auto">
  <h1 style="font-family:var(--f-heading);font-size:clamp(24px,4vw,40px);margin-bottom:40px">{{ page.title }}</h1>
  {%- form 'contact' -%}
    {%- if form.posted_successfully? -%}
    <div style="padding:20px;background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.3);border-radius:var(--radius);margin-bottom:24px;color:#15803d">
      Thanks for reaching out! We'll get back to you soon.
    </div>
    {%- endif -%}
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px">
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:6px">Name <span style="color:red">*</span></label>
        <input type="text" name="contact[name]" required style="width:100%;padding:12px 16px;border:1px solid var(--c-border);border-radius:var(--radius);font-family:var(--f-body);background:var(--c-bg);color:var(--c-text);font-size:15px">
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:6px">Email <span style="color:red">*</span></label>
        <input type="email" name="contact[email]" required style="width:100%;padding:12px 16px;border:1px solid var(--c-border);border-radius:var(--radius);font-family:var(--f-body);background:var(--c-bg);color:var(--c-text);font-size:15px">
      </div>
    </div>
    <div style="margin-bottom:20px">
      <label style="display:block;font-size:13px;font-weight:600;margin-bottom:6px">Subject</label>
      <input type="text" name="contact[subject]" style="width:100%;padding:12px 16px;border:1px solid var(--c-border);border-radius:var(--radius);font-family:var(--f-body);background:var(--c-bg);color:var(--c-text);font-size:15px">
    </div>
    <div style="margin-bottom:28px">
      <label style="display:block;font-size:13px;font-weight:600;margin-bottom:6px">Message <span style="color:red">*</span></label>
      <textarea name="contact[body]" rows="6" required style="width:100%;padding:12px 16px;border:1px solid var(--c-border);border-radius:var(--radius);font-family:var(--f-body);font-size:15px;resize:vertical;background:var(--c-bg);color:var(--c-text)"></textarea>
    </div>
    <button type="submit" class="btn-primary">Send Message</button>
  {%- endform -%}
</div>
{% schema %}
{
  "name": "Contact Form",
  "settings": [],
  "presets": [{ "name": "Contact Form" }]
}
{% endschema %}
