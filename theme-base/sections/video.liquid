<div style="padding:60px 20px;background:{{ section.settings.bg_color }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
    <h2 style="font-family:var(--f-heading);font-size:clamp(24px,4vw,40px);text-align:center;margin-bottom:48px;color:{{ section.settings.heading_color }}">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div style="position:relative;border-radius:calc(var(--radius)*2);overflow:hidden;background:#000;max-height:{{ section.settings.height }}px">
      {%- if section.settings.video_url != blank -%}
      <div style="position:relative;padding-bottom:{%- if section.settings.aspect == '16:9' -%}56.25%{%- else -%}42.85%{%- endif -%};height:0">
        {%- assign vid = section.settings.video_url -%}
        {%- if vid contains 'youtube' or vid contains 'youtu.be' -%}
          {%- assign vid_id = vid | split: 'v=' | last | split: '&' | first -%}
          {%- if vid contains 'youtu.be' -%}{%- assign vid_id = vid | split: '/' | last | split: '?' | first -%}{%- endif -%}
          <iframe src="https://www.youtube.com/embed/{{ vid_id }}?autoplay={{ section.settings.autoplay | default: 0 }}&mute=1&loop=1&playlist={{ vid_id }}&controls=1" style="position:absolute;top:0;left:0;width:100%;height:100%;border:none" allowfullscreen loading="lazy" title="{{ section.settings.heading | escape }}"></iframe>
        {%- elsif vid contains 'vimeo' -%}
          {%- assign vid_id = vid | split: '/' | last -%}
          <iframe src="https://player.vimeo.com/video/{{ vid_id }}?autoplay={{ section.settings.autoplay | default: 0 }}&muted=1&loop=1" style="position:absolute;top:0;left:0;width:100%;height:100%;border:none" allowfullscreen loading="lazy" title="{{ section.settings.heading | escape }}"></iframe>
        {%- endif -%}
      </div>
      {%- elsif section.settings.video != blank -%}
      <video src="{{ section.settings.video }}" style="width:100%;display:block;max-height:{{ section.settings.height }}px;object-fit:cover" {%- if section.settings.autoplay -%}autoplay muted loop playsinline{%- endif -%} controls></video>
      {%- else -%}
      <div style="height:{{ section.settings.height }}px;display:flex;align-items:center;justify-content:center;background:#111">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="rgba(255,255,255,.3)" stroke="none"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      </div>
      {%- endif -%}
    </div>
    {%- if section.settings.caption != blank -%}
    <p style="text-align:center;margin-top:16px;font-size:14px;color:var(--c-subtle)">{{ section.settings.caption }}</p>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name":"Video",
  "settings":[
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"heading_color","label":"Heading Color","default":"#0f0f0f"},
    {"type":"text","id":"heading","label":"Heading"},
    {"type":"video_url","id":"video_url","label":"YouTube / Vimeo URL","accept":["youtube","vimeo"]},
    {"type":"video","id":"video","label":"Shopify-hosted Video"},
    {"type":"checkbox","id":"autoplay","label":"Autoplay (muted)","default":false},
    {"type":"select","id":"aspect","label":"Aspect Ratio","options":[{"value":"16:9","label":"16:9 Widescreen"},{"value":"21:9","label":"21:9 Cinematic"}],"default":"16:9"},
    {"type":"range","id":"height","label":"Max Height (px)","min":300,"max":800,"step":40,"default":560},
    {"type":"text","id":"caption","label":"Caption"}
  ],
  "presets":[{"name":"Video"}]
}
{% endschema %}
