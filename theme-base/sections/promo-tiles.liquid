<div style="padding:60px 20px;background:var(--c-text);color:var(--c-bg)">
  <div class="page-width" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:32px">
    {%- for block in section.blocks -%}
      {%- if block.type == 'tile' -%}
      <div style="text-align:center;padding:32px 20px;border-radius:calc(var(--radius)*2);background:rgba(255,255,255,.06)" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
        <div style="font-size:40px;margin-bottom:16px">{{ block.settings.icon }}</div>
        {%- endif -%}
        <h3 style="font-family:var(--f-heading);font-size:18px;margin-bottom:8px;color:inherit">{{ block.settings.title }}</h3>
        <p style="font-size:14px;opacity:.7;line-height:1.6">{{ block.settings.text }}</p>
        {%- if block.settings.cta_label != blank -%}
        <a href="{{ block.settings.cta_url }}" style="display:inline-block;margin-top:16px;padding:10px 24px;border:1px solid rgba(255,255,255,.4);border-radius:var(--radius);font-size:14px;font-weight:600;color:inherit;text-decoration:none;transition:background .2s" onmouseover="this.style.background='rgba(255,255,255,.1)'" onmouseout="this.style.background='transparent'">{{ block.settings.cta_label }}</a>
        {%- endif -%}
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Promo Tiles",
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free Shipping" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "On orders over ₹999" },
        { "type": "text", "id": "cta_label", "label": "CTA Label" },
        { "type": "url", "id": "cta_url", "label": "CTA URL" }
      ]
    }
  ],
  "presets": [{ "name": "Promo Tiles" }]
}
{% endschema %}
