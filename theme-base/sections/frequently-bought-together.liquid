{% schema %}
{
  "name": "Bought Together",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Bought Together" },
    { "type": "product_list", "id": "products", "label": "Select Products", "limit": 3 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f9fafb" },
    { "type": "range", "id": "discount_pct", "label": "Bundle Discount (%)", "min": 0, "max": 50, "step": 5, "default": 10 }
  ],
  "presets": [{ "name": "Bought Together (Cross-sell)" }]
}
{% endschema %}

{%- if section.settings.products != blank -%}
{%- style -%}
  .cf-fbt-{{ section.id }} { background: {{ section.settings.bg_color }}; padding: 40px; border-radius: 12px; margin: 40px 0; font-family: var(--f-body, sans-serif); }
  .cf-fbt-title { font-family: var(--f-heading, serif); font-size: 24px; font-weight: 700; margin-bottom: 24px; color: var(--c-text); }
  .cf-fbt-grid { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .cf-fbt-item { display: flex; flex-direction: column; align-items: center; width: 120px; text-align: center; }
  .cf-fbt-img { width: 120px; height: 120px; object-fit: cover; border-radius: 8px; border: 1px solid var(--c-border); margin-bottom: 8px; }
  .cf-fbt-plus { font-size: 24px; color: var(--c-subtle); font-weight: 300; }
  .cf-fbt-list { display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px; }
  .cf-fbt-row { display: flex; align-items: flex-start; gap: 12px; }
  .cf-fbt-checkbox { width: 20px; height: 20px; accent-color: var(--c-accent); margin-top: 2px; cursor: pointer; }
  .cf-fbt-name { font-size: 14px; font-weight: 600; color: var(--c-text); }
  .cf-fbt-price { font-size: 14px; font-weight: 700; color: var(--c-accent); }
  .cf-fbt-total { font-size: 18px; font-weight: 700; margin-bottom: 16px; display: flex; gap: 12px; align-items: baseline; }
  .cf-fbt-total-old { color: var(--c-subtle); text-decoration: line-through; font-size: 14px; }
  .cf-fbt-add { background: var(--c-accent); color: var(--c-accent-text); border: none; padding: 14px 32px; font-size: 14px; font-weight: 700; border-radius: 6px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: opacity .2s; }
  .cf-fbt-add:hover { opacity: 0.9; }
{%- endstyle -%}

<div class="cf-fbt-{{ section.id }}">
  <h2 class="cf-fbt-title">{{ section.settings.heading }}</h2>
  
  <div class="cf-fbt-grid">
    {%- for p in section.settings.products -%}
      <div class="cf-fbt-item" data-id="{{ p.id }}">
        <a href="{{ p.url }}"><img src="{{ p.featured_image | image_url: width: 240 }}" class="cf-fbt-img" alt="{{ p.title | escape }}"></a>
      </div>
      {%- unless forloop.last -%}<div class="cf-fbt-plus">+</div>{%- endunless -%}
    {%- endfor -%}
  </div>

  <form id="FBTForm-{{ section.id }}">
    <div class="cf-fbt-list">
      {%- for p in section.settings.products -%}
        <label class="cf-fbt-row">
          <input type="checkbox" class="cf-fbt-checkbox" value="{{ p.variants.first.id }}" data-price="{{ p.price }}" checked>
          <div>
            <div class="cf-fbt-name"><strong>This item:</strong> {{ p.title }}</div>
            <div class="cf-fbt-price">{{ p.price | money }}</div>
          </div>
        </label>
      {%- endfor -%}
    </div>
    
    <div class="cf-fbt-total">
      <span>Total price:</span>
      <span id="FBTDiscountPrice-{{ section.id }}" style="color:var(--c-accent)"></span>
      {%- if section.settings.discount_pct > 0 -%}
        <span id="FBTOldPrice-{{ section.id }}" class="cf-fbt-total-old"></span>
      {%- endif -%}
    </div>
    
    <button type="button" class="cf-fbt-add" id="FBTAdd-{{ section.id }}">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
      Add Selected to Cart
    </button>
  </form>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sectionId = '{{ section.id }}';
    const form = document.getElementById('FBTForm-' + sectionId);
    const checkboxes = form.querySelectorAll('.cf-fbt-checkbox');
    const oldPriceEl = document.getElementById('FBTOldPrice-' + sectionId);
    const newPriceEl = document.getElementById('FBTDiscountPrice-' + sectionId);
    const btn = document.getElementById('FBTAdd-' + sectionId);
    const images = document.querySelectorAll('.cf-fbt-item');
    const discount = {{ section.settings.discount_pct }} / 100;

    function formatMoney(cents) { return '₹' + (cents / 100).toLocaleString('en-IN'); } // Assuming INR based on previous files, in a real theme this uses shop.money_format

    function calcTotal() {
      let total = 0;
      let count = 0;
      checkboxes.forEach((cb, idx) => {
        if (cb.checked) {
          total += parseInt(cb.dataset.price);
          count++;
          images[idx].style.opacity = '1';
        } else {
          images[idx].style.opacity = '0.3';
        }
      });
      
      btn.disabled = count === 0;
      
      if (oldPriceEl) {
        oldPriceEl.textContent = formatMoney(total);
        newPriceEl.textContent = formatMoney(total - (total * discount));
        oldPriceEl.style.display = count > 1 ? 'inline' : 'none';
        newPriceEl.textContent = count > 1 ? formatMoney(total - (total * discount)) : formatMoney(total);
      } else {
        newPriceEl.textContent = formatMoney(total);
      }
    }

    checkboxes.forEach(cb => cb.addEventListener('change', calcTotal));
    calcTotal();

    btn.addEventListener('click', async () => {
      const items = Array.from(checkboxes).filter(cb => cb.checked).map(cb => ({ id: cb.value, quantity: 1 }));
      if (!items.length) return;
      btn.textContent = 'Adding...';
      btn.disabled = true;
      try {
        await fetch(window.CF.routes.cart_add_url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items })
        });
        document.dispatchEvent(new CustomEvent('cart:updated'));
        const drawer = document.getElementById('CartDrawer');
        if(drawer) {
          drawer.classList.add('open');
          document.getElementById('OverlayBg')?.classList.add('active');
        }
      } catch (err) {
        console.error(err);
      }
      btn.innerHTML = `<svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg> Add Selected to Cart`;
      btn.disabled = false;
    });
  });
</script>
{%- endif -%}
