<div style="background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px">
  <div class="page-width" style="text-align:{{ section.settings.text_align }};max-width:{{ section.settings.content_width }}px;margin:0 auto">
    {%- if section.settings.eyebrow != blank -%}
    <p style="font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:{{ section.settings.eyebrow_color }};margin-bottom:12px">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
    <h2 style="font-family:var(--f-heading);font-size:clamp(28px,5vw,{{ section.settings.heading_size }}px);color:{{ section.settings.text_color }};margin-bottom:16px;line-height:1.2">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
    <div style="font-size:17px;line-height:1.7;color:{{ section.settings.body_color }};margin-bottom:32px;max-width:640px;margin-left:{%- if section.settings.text_align == 'center' -%}auto{%- else -%}0{%- endif -%};margin-right:{%- if section.settings.text_align == 'center' -%}auto{%- else -%}0{%- endif -%}" class="rte">{{ section.settings.body }}</div>
    {%- endif -%}
    <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:{{ section.settings.text_align }}">
      {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url }}" style="display:inline-block;padding:14px 32px;background:{{ section.settings.cta_bg }};color:{{ section.settings.cta_text }};border-radius:var(--radius);font-weight:700;font-size:15px;text-decoration:none;border:2px solid {{ section.settings.cta_bg }};transition:opacity .2s" onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank -%}
      <a href="{{ section.settings.cta2_url }}" style="display:inline-block;padding:14px 32px;background:transparent;color:{{ section.settings.text_color }};border-radius:var(--radius);font-weight:700;font-size:15px;text-decoration:none;border:2px solid {{ section.settings.text_color }};transition:background .2s" onmouseover="this.style.background='rgba(255,255,255,.1)'" onmouseout="this.style.background='transparent'">{{ section.settings.cta2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name":"Rich Text",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow"},
    {"type":"text","id":"heading","label":"Heading","default":"Make Your Store Stand Out"},
    {"type":"richtext","id":"body","label":"Body","default":"<p>Add compelling copy here. This section is perfect for brand statements, promotions, and announcements.</p>"},
    {"type":"range","id":"heading_size","label":"Heading Size (px)","min":24,"max":72,"step":4,"default":48},
    {"type":"range","id":"content_width","label":"Content Max Width (px)","min":480,"max":1280,"step":40,"default":800},
    {"type":"range","id":"padding_top","label":"Padding Top (px)","min":20,"max":120,"step":4,"default":80},
    {"type":"range","id":"padding_bottom","label":"Padding Bottom (px)","min":20,"max":120,"step":4,"default":80},
    {"type":"select","id":"text_align","label":"Alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"center"},
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Heading Color","default":"#0f0f0f"},
    {"type":"color","id":"body_color","label":"Body Color","default":"#6b7280"},
    {"type":"color","id":"eyebrow_color","label":"Eyebrow Color","default":"#2563eb"},
    {"type":"text","id":"cta_label","label":"Primary Button"},
    {"type":"url","id":"cta_url","label":"Primary URL"},
    {"type":"color","id":"cta_bg","label":"Primary Button BG","default":"#0f0f0f"},
    {"type":"color","id":"cta_text","label":"Primary Button Text","default":"#ffffff"},
    {"type":"text","id":"cta2_label","label":"Secondary Button"},
    {"type":"url","id":"cta2_url","label":"Secondary URL"}
  ],
  "presets":[{"name":"Rich Text"}]
}
{% endschema %}
