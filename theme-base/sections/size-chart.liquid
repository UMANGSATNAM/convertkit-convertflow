{%- if section.settings.show_size_chart -%}
<div class="page-width" style="padding:40px 20px 60px">
  <details style="border:1px solid var(--c-border);border-radius:calc(var(--radius)*2);overflow:hidden">
    <summary style="padding:18px 24px;cursor:pointer;font-weight:600;font-size:15px;display:flex;justify-content:space-between;align-items:center;list-style:none;background:var(--c-bg)">
      {{ section.settings.toggle_label | default: 'Size Chart' }}
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="transition:transform .3s" class="sc-arrow"><path d="M6 9l6 6 6-6"/></svg>
    </summary>
    <div style="padding:24px;border-top:1px solid var(--c-border)">
      {%- if section.settings.chart_image != blank -%}
      <img src="{{ section.settings.chart_image | image_url: width: 1000 }}" alt="Size Chart" width="1000" style="width:100%;height:auto;border-radius:var(--radius);margin-bottom:20px">
      {%- endif -%}
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:14px;min-width:400px">
          <thead>
            <tr style="background:var(--c-border)">
              {%- assign headers = section.settings.table_headers | split: ',' -%}
              {%- for h in headers -%}<th style="padding:10px 16px;text-align:left;font-weight:700">{{ h | strip }}</th>{%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- assign rows = section.settings.table_rows | split: '|' -%}
            {%- for row in rows -%}
            <tr style="border-bottom:1px solid var(--c-border)">
              {%- assign cells = row | split: ',' -%}
              {%- for cell in cells -%}<td style="padding:10px 16px">{{ cell | strip }}</td>{%- endfor -%}
            </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      {%- if section.settings.notes != blank -%}
      <p style="margin-top:16px;font-size:13px;color:var(--c-subtle)">{{ section.settings.notes }}</p>
      {%- endif -%}
    </div>
  </details>
</div>
<script>document.querySelectorAll('details').forEach(d=>d.addEventListener('toggle',()=>{var a=d.querySelector('.sc-arrow');if(a)a.style.transform=d.open?'rotate(180deg)':'';}));</script>
{%- endif -%}
{% schema %}
{
  "name":"Size Chart",
  "settings":[
    {"type":"checkbox","id":"show_size_chart","label":"Show Size Chart","default":true},
    {"type":"text","id":"toggle_label","label":"Toggle Label","default":"Size Chart"},
    {"type":"image_picker","id":"chart_image","label":"Chart Image"},
    {"type":"text","id":"table_headers","label":"Table Headers (comma separated)","default":"Size,Chest (cm),Waist (cm),Hip (cm)"},
    {"type":"textarea","id":"table_rows","label":"Table Rows (| separates rows, comma separates cells)","default":"XS,82,66,88|S,88,72,94|M,94,78,100|L,100,84,106|XL,106,90,112"},
    {"type":"text","id":"notes","label":"Notes","default":"All measurements are in centimetres."}
  ],
  "presets":[{"name":"Size Chart"}]
}
{% endschema %}
