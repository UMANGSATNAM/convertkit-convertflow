<footer class="site-footer">
  <div class="site-footer__grid">
    <div>
      {%- if settings.logo -%}
        <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="140" style="margin-bottom:16px;filter:brightness(0) invert(1)">
      {%- else -%}
        <div style="font-family:var(--f-heading);font-size:24px;font-weight:700;margin-bottom:16px">{{ shop.name }}</div>
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        <p style="font-size:14px;opacity:.6;line-height:1.7;max-width:260px;margin-bottom:20px">{{ section.settings.tagline }}</p>
      {%- endif -%}
      <div style="display:flex;gap:12px">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" style="opacity:.6;transition:opacity .2s" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=.6"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5" fill="currentColor"/></svg></a>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" style="opacity:.6;transition:opacity .2s" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=.6"><svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" style="opacity:.6;transition:opacity .2s" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=.6"><svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#000"/></svg></a>{%- endif -%}
      </div>
    </div>
    {%- for block in section.blocks -%}
      {%- if block.type == 'link_list' -%}
        <div>
          <h3 style="font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:16px;opacity:.9">{{ block.settings.heading }}</h3>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:10px">
            {%- for link in linklists[block.settings.menu].links -%}
              <li><a href="{{ link.url }}" style="font-size:14px;opacity:.6;transition:opacity .2s" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=.6">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- elsif block.type == 'newsletter' -%}
        <div>
          <h3 style="font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:16px;opacity:.9">{{ block.settings.heading }}</h3>
          <p style="font-size:13px;opacity:.6;margin-bottom:16px">{{ block.settings.subtext }}</p>
          {% form 'customer' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div style="display:flex;overflow:hidden;border:1px solid rgba(255,255,255,.2);border-radius:4px">
              <input type="email" name="contact[email]" placeholder="Your email" required style="flex:1;background:transparent;border:none;padding:10px 14px;font-size:13px;color:inherit;outline:none">
              <button type="submit" style="background:var(--c-accent);color:var(--c-accent-text);border:none;padding:10px 16px;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap">Subscribe</button>
            </div>
          {% endform %}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="site-footer__bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
    <div style="display:flex;gap:16px">{{ powered_by_link }}</div>
  </div>
</footer>
{% schema %}
{
  "name":"Footer",
  "settings":[
    {"type":"text","id":"tagline","label":"Tagline","default":"Premium quality, delivered to your door."}
  ],
  "blocks":[
    {"type":"link_list","name":"Link Column","settings":[
      {"type":"text","id":"heading","label":"Heading","default":"Quick Links"},
      {"type":"link_list","id":"menu","label":"Menu","default":"footer"}
    ]},
    {"type":"newsletter","name":"Newsletter","settings":[
      {"type":"text","id":"heading","label":"Heading","default":"Stay Updated"},
      {"type":"text","id":"subtext","label":"Subtext","default":"Get exclusive deals and new arrivals."}
    ]}
  ],
  "presets":[{"name":"Footer","blocks":[{"type":"link_list"},{"type":"link_list"},{"type":"newsletter"}]}]
}
{% endschema %}
