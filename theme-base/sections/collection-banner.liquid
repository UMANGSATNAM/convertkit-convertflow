<div style="text-align:center;padding:40px 20px;margin-bottom:32px">
  {%- if collection.image -%}
  <div style="height:280px;background:url('{{ collection.image | image_url: width: 1400 }}') center/cover;border-radius:calc(var(--radius)*2);position:relative;overflow:hidden;margin-bottom:0">
    <div style="position:absolute;inset:0;background:rgba(0,0,0,.45);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px">
      <h1 style="font-family:var(--f-heading);font-size:clamp(28px,5vw,52px);color:#fff;margin-bottom:12px">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
      <p style="color:rgba(255,255,255,.85);font-size:16px;max-width:600px">{{ collection.description }}</p>
      {%- endif -%}
    </div>
  </div>
  {%- else -%}
  <h1 style="font-family:var(--f-heading);font-size:clamp(28px,5vw,52px);margin-bottom:12px">{{ collection.title }}</h1>
  {%- if collection.description != blank -%}
  <p style="color:var(--c-subtle);max-width:600px;margin:0 auto">{{ collection.description }}</p>
  {%- endif -%}
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Collection Banner",
  "settings": [],
  "presets": [{ "name": "Collection Banner" }]
}
{% endschema %}
