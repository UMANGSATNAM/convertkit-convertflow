{%- paginate collection.products by section.settings.products_per_page -%}
<div class="page-width" style="padding-top:32px;padding-bottom:80px">

  <!-- Collection Banner -->
  <div style="text-align:center;margin-bottom:40px">
    {%- if collection.image -%}
      <img src="{{ collection.image | image_url: width: 1600 }}" alt="{{ collection.title }}" style="width:100%;max-height:300px;object-fit:cover;border-radius:var(--radius);margin-bottom:24px">
    {%- endif -%}
    <h1 style="font-size:36px;margin-bottom:8px">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<p style="color:var(--c-subtle);max-width:600px;margin:0 auto">{{ collection.description | strip_html | truncate: 200 }}</p>{%- endif -%}
  </div>

  <!-- Toolbar -->
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid var(--c-border);flex-wrap:wrap;gap:12px">
    <button data-filter-toggle class="btn btn--outline" style="padding:10px 20px;font-size:13px">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:6px"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
      Filter & Sort
    </button>
    <div style="display:flex;align-items:center;gap:16px">
      <span style="font-size:13px;color:var(--c-subtle)">{{ collection.products_count }} products</span>
      <select data-filter-input name="sort_by" style="border:1px solid var(--c-border);padding:8px 12px;font-size:13px;font-family:var(--f-body);border-radius:4px">
        <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>Featured</option>
        <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
        <option value="title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>A–Z</option>
        <option value="title-descending" {% if collection.sort_by == 'title-descending' %}selected{% endif %}>Z–A</option>
        <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
        <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
        <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
      </select>
    </div>
  </div>

  <div style="display:flex;gap:32px;align-items:flex-start">
    <!-- Filter Drawer -->
    <div data-filter-drawer style="width:260px;flex-shrink:0;position:sticky;top:80px">
      {%- if collection.filters.size > 0 -%}
        <form>
          <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
          {%- for filter in collection.filters -%}
            <details open style="margin-bottom:24px;border-bottom:1px solid var(--c-border);padding-bottom:16px">
              <summary style="font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;cursor:pointer;list-style:none;display:flex;justify-content:space-between;margin-bottom:12px">
                {{ filter.label }} <span>▾</span>
              </summary>
              {%- case filter.type -%}
              {%- when 'list' -%}
                <div style="display:flex;flex-direction:column;gap:8px">
                  {%- for value in filter.values -%}
                    <label style="display:flex;align-items:center;gap:8px;font-size:14px;cursor:pointer">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} data-filter-input style="width:16px;height:16px;accent-color:var(--c-accent)">
                      {{ value.label }} <span style="color:var(--c-subtle);font-size:12px">({{ value.count }})</span>
                    </label>
                  {%- endfor -%}
                </div>
              {%- when 'price_range' -%}
                <div style="display:flex;gap:8px;align-items:center">
                  <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency }}" placeholder="Min" style="width:80px;padding:6px;border:1px solid var(--c-border);font-size:13px">
                  <span>–</span>
                  <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency }}" placeholder="Max" style="width:80px;padding:6px;border:1px solid var(--c-border);font-size:13px">
                  <button type="submit" style="padding:6px 12px;background:var(--c-accent);color:#fff;border:none;font-size:12px;cursor:pointer;border-radius:4px">Go</button>
                </div>
              {%- endcase -%}
            </details>
          {%- endfor -%}
          {%- if collection.filters.first.active_values.size > 0 -%}
            <a href="{{ collection.url }}" style="font-size:13px;color:var(--c-subtle);text-decoration:underline">Clear all filters</a>
          {%- endif -%}
        </form>
      {%- endif -%}
    </div>

    <!-- Product Grid -->
    <div style="flex:1;min-width:0">
      {%- if collection.products.size == 0 -%}
        <div style="text-align:center;padding:80px 0;color:var(--c-subtle)">
          <p style="font-size:20px;margin-bottom:8px">No products found</p>
          <a href="{{ collection.url }}" style="color:var(--c-accent)">Clear filters</a>
        </div>
      {%- else -%}
        <div class="collection-grid" style="--cols:{{ section.settings.columns }}">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div style="display:flex;justify-content:center;gap:8px;margin-top:48px">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btn btn--outline" style="padding:10px 20px;font-size:13px">← Prev</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}" class="btn btn--outline" style="padding:10px 16px;font-size:13px">{{ part.title }}</a>
              {%- else -%}<span class="btn btn--primary" style="padding:10px 16px;font-size:13px">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn btn--outline" style="padding:10px 20px;font-size:13px">Next →</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name":"Collection Main",
  "settings":[
    {"type":"range","id":"products_per_page","label":"Products per Page","min":8,"max":48,"step":4,"default":24},
    {"type":"select","id":"columns","label":"Grid Columns","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"4"}
  ]
}
{% endschema %}
