{%- if section.settings.enable_verifier -%}
<div id="AgeVerifier" style="display:none;position:fixed;inset:0;z-index:600;align-items:center;justify-content:center;background:rgba(0,0,0,.85)" aria-hidden="true">
  <div style="background:var(--c-bg);border-radius:calc(var(--radius)*2);max-width:440px;width:90%;padding:48px 40px;text-align:center;box-shadow:0 24px 80px rgba(0,0,0,.4)">
    {%- if section.settings.logo_image != blank -%}
    <img src="{{ section.settings.logo_image | image_url: width: 160 }}" alt="{{ shop.name }}" width="120" style="max-width:120px;margin:0 auto 24px;display:block">
    {%- else -%}
    <p style="font-family:var(--f-heading);font-size:22px;font-weight:700;margin-bottom:24px">{{ shop.name }}</p>
    {%- endif -%}
    <h2 style="font-family:var(--f-heading);font-size:clamp(18px,3vw,26px);margin-bottom:12px">{{ section.settings.title }}</h2>
    <p style="color:var(--c-subtle);font-size:15px;line-height:1.6;margin-bottom:32px">{{ section.settings.message }}</p>
    <div style="display:flex;gap:12px;justify-content:center">
      <button id="AgeVerifyYes" style="padding:12px 32px;background:var(--c-accent);color:var(--c-accent-text);border:none;border-radius:var(--radius);font-weight:700;font-size:15px;cursor:pointer">{{ section.settings.yes_label }}</button>
      <button id="AgeVerifyNo" style="padding:12px 32px;background:none;border:1px solid var(--c-border);color:var(--c-text);border-radius:var(--radius);font-weight:600;font-size:15px;cursor:pointer">{{ section.settings.no_label }}</button>
    </div>
    <p style="font-size:12px;color:var(--c-subtle);margin-top:20px;line-height:1.5">{{ section.settings.legal_text }}</p>
  </div>
</div>
<script>
(function(){
  var key='cf_age_verified_{{ section.id }}';
  if(sessionStorage.getItem(key)) return;
  var v=document.getElementById('AgeVerifier');
  if(v) v.style.display='flex';
  document.getElementById('AgeVerifyYes').onclick=function(){v.style.display='none';sessionStorage.setItem(key,'1');};
  document.getElementById('AgeVerifyNo').onclick=function(){window.location.href='https://www.google.com';};
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Age Verifier",
  "settings": [
    { "type": "checkbox", "id": "enable_verifier", "label": "Enable Age Verifier", "default": false },
    { "type": "image_picker", "id": "logo_image", "label": "Logo" },
    { "type": "text", "id": "title", "label": "Title", "default": "Age Verification Required" },
    { "type": "textarea", "id": "message", "label": "Message", "default": "You must be 18 years or older to visit this site. Please verify your age." },
    { "type": "text", "id": "yes_label", "label": "Yes button", "default": "I am 18+" },
    { "type": "text", "id": "no_label", "label": "No button", "default": "I am under 18" },
    { "type": "textarea", "id": "legal_text", "label": "Legal text", "default": "By entering this site you agree to our Terms of Service and Privacy Policy." }
  ],
  "presets": [{ "name": "Age Verifier" }]
}
{% endschema %}
