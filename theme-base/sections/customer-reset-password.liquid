<div class="page-width" style="padding:60px 20px 80px;max-width:600px;margin:0 auto">
<h1 style="font-family:var(--f-heading);font-size:32px;margin-bottom:8px">Reset Password</h1>
<p style="color:var(--c-subtle);margin-bottom:32px">Enter your new password below.</p>
{%- form 'reset_customer_password' -%}
  {%- if form.errors -%}<div style="padding:12px;background:#fef2f2;border:1px solid #fca5a5;border-radius:var(--radius);color:#dc2626;font-size:14px;margin-bottom:20px">{{ form.errors | default_errors }}</div>{%- endif -%}
  <div style="margin-bottom:20px"><label style="display:block;font-size:13px;font-weight:600;margin-bottom:6px">New Password<span style="color:red"> *</span></label><input type="password" name="customer[password]" required style="width:100%;padding:12px 16px;border:1px solid var(--c-border);border-radius:var(--radius);font-family:var(--f-body);font-size:15px;background:var(--c-bg);color:var(--c-text)"></div>
  <div style="margin-bottom:20px"><label style="display:block;font-size:13px;font-weight:600;margin-bottom:6px">Confirm Password<span style="color:red"> *</span></label><input type="password" name="customer[password_confirmation]" required style="width:100%;padding:12px 16px;border:1px solid var(--c-border);border-radius:var(--radius);font-family:var(--f-body);font-size:15px;background:var(--c-bg);color:var(--c-text)"></div>
  <button type="submit" class="btn-primary" style="width:100%;padding:15px">Reset Password</button>
{%- endform -%}
</div>
{%- schema -%}
{"name":"Reset Password","settings":[],"presets":[{"name":"Reset Password"}]}
{%- endschema -%}