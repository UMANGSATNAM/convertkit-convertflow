  "name": "Product Main",
  "settings": [
    {"type": "text", "id": "atc_text", "label": "Add to Cart Text", "default": "Add to Cart"},
    {"type": "checkbox", "id": "show_buy_now", "label": "Show Buy Now Button", "default": true},
    {"type": "text", "id": "buy_now_text", "label": "Buy Now Text", "default": "Buy It Now"},
    {"type": "checkbox", "id": "show_whatsapp", "label": "Show WhatsApp Ordering", "default": true},
    {"type": "checkbox", "id": "show_pincode_checker", "label": "Show Pincode Checker", "default": true},
    {"type": "checkbox", "id": "show_trust", "label": "Show Trust Badges", "default": true},
    {"type": "checkbox", "id": "show_description", "label": "Show Description Accordion", "default": true}
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {"value": "delivery", "label": "Delivery Truck"},
