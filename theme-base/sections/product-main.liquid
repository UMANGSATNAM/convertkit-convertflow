          ],
          "default": "delivery"
        },
        {"type": "text", "id": "text", "label": "Text", "default": "Free Delivery"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Main",
      "blocks": [
        {"type": "trust_badge", "settings": {"icon": "delivery", "text": "Free Fast Shipping"}},
        {"type": "trust_badge", "settings": {"icon": "shield", "text": "Secure Checkout"}},
        {"type": "trust_badge", "settings": {"icon": "tag", "text": "Best Price Guarantee"}},
        {"type": "trust_badge", "settings": {"icon": "star", "text": "Top Rated Product"}}
