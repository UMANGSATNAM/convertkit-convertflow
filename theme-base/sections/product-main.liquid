<div class="product-page page-width" style="padding-top:48px;padding-bottom:80px">
  <nav style="font-size:13px;color:var(--c-subtle);margin-bottom:32px" aria-label="Breadcrumb">
    <a href="/">Home</a> / <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a> / <span>{{ product.title }}</span>
  </nav>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start">

    <!-- Gallery -->
    <div data-gallery>
      <div style="border-radius:var(--radius);overflow:hidden;background:var(--c-border);aspect-ratio:1;margin-bottom:12px;cursor:zoom-in" {% if settings.enable_image_zoom %}data-zoom{% endif %}>
        <img id="MainProductImg" data-main-img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" height="900" style="width:100%;height:100%;object-fit:cover">
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        {%- for img in product.images limit: 6 -%}
          <div data-thumb data-src="{{ img | image_url: width: 900 }}" class="{% if forloop.first %}active{% endif %}" style="width:72px;height:72px;border-radius:4px;overflow:hidden;cursor:pointer;border:2px solid {% if forloop.first %}var(--c-accent){% else %}transparent{% endif %};transition:border-color .2s">
            <img src="{{ img | image_url: width: 144 }}" alt="" width="72" height="72" style="width:100%;height:100%;object-fit:cover">
          </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- Info -->
    <div>
      {%- if settings.show_vendor -%}<div style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--c-accent);font-weight:600;margin-bottom:10px">{{ product.vendor }}</div>{%- endif -%}
      <h1 style="font-size:32px;margin-bottom:16px">{{ product.title }}</h1>

      <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;padding-bottom:24px;border-bottom:1px solid var(--c-border)">
        <span style="font-size:28px;font-weight:700;color:var(--c-accent)" data-price>{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span style="font-size:18px;color:var(--c-subtle);text-decoration:line-through" data-compare-price>{{ product.compare_at_price | money }}</span>
          <span style="background:#DCFCE7;color:#15803D;padding:4px 10px;font-size:12px;font-weight:700;border-radius:4px">{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round }}% OFF</span>
        {%- endif -%}
      </div>

      {%- if settings.show_stock_counter and product.available -%}
        {%- assign qty = product.selected_or_first_available_variant.inventory_quantity -%}
        {%- if qty > 0 and qty < settings.stock_threshold -%}
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;font-size:13px;color:#DC2626;font-weight:600">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
            Only {{ qty }} left!
          </div>
        {%- elsif qty > 0 -%}
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;font-size:13px;color:#16A34A;font-weight:600">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
            In Stock
          </div>
        {%- endif -%}
      {%- endif -%}

      <form action="{{ routes.cart_add_url }}" method="post" id="ProductForm">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div style="margin-bottom:20px">
              <label style="font-size:13px;font-weight:600;letter-spacing:1px;text-transform:uppercase;display:block;margin-bottom:10px">{{ option.name }}</label>
              {%- if option.name == 'Color' or option.name == 'Colour' -%}
                <div data-swatches style="display:flex;gap:8px;flex-wrap:wrap">
                  {%- for value in option.values -%}
                    <button type="button" data-swatch="{{ value }}" class="{% if option.selected_value == value %}active{% endif %}" style="width:32px;height:32px;border-radius:50%;background:{{ value | downcase }};border:3px solid {% if option.selected_value == value %}var(--c-accent){% else %}transparent{% endif %};outline:2px solid var(--c-border);cursor:pointer;transition:all .2s" title="{{ value }}"></button>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <div style="display:flex;gap:8px;flex-wrap:wrap" data-swatches>
                  {%- for value in option.values -%}
                    <button type="button" data-swatch="{{ value }}" style="padding:8px 16px;border:2px solid {% if option.selected_value == value %}var(--c-accent){% else %}var(--c-border){% endif %};background:{% if option.selected_value == value %}var(--c-accent){% else %}#fff{% endif %};color:{% if option.selected_value == value %}var(--c-accent-text){% else %}var(--c-text){% endif %};font-size:13px;font-weight:500;cursor:pointer;border-radius:var(--radius);transition:all .2s;font-family:var(--f-body)">{{ value }}</button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
          <select name="id" data-variant-select style="display:none">
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</option>
            {%- endfor -%}
          </select>
        {%- endunless -%}

        <div style="display:flex;gap:12px;margin-bottom:12px">
          <div class="qty-selector" style="display:flex;align-items:center;border:1.5px solid var(--c-border);border-radius:var(--radius);overflow:hidden">
            <button type="button" class="qty-selector__btn" data-dir="down" style="width:44px;height:52px;background:none;border:none;font-size:20px;cursor:pointer">−</button>
            <input type="number" name="quantity" value="1" min="1" style="width:48px;height:52px;text-align:center;border:none;font-size:16px;font-weight:600;font-family:var(--f-body)">
            <button type="button" class="qty-selector__btn" data-dir="up" style="width:44px;height:52px;background:none;border:none;font-size:20px;cursor:pointer">+</button>
          </div>
          <button type="submit" class="btn btn--primary" data-atc data-text="{{ section.settings.atc_text }}" style="flex:1;font-size:15px" {% unless product.available %}disabled{% endunless %}>
            {%- if product.available -%}{{ section.settings.atc_text }}{%- else -%}Sold Out{%- endif -%}
          </button>
        </div>
        {%- if section.settings.show_buy_now and product.available -%}
          <a href="{{ product.selected_or_first_available_variant.url | append: '?action=buy_now' }}" class="btn btn--outline" style="width:100%;display:block;text-align:center;margin-bottom:20px">{{ section.settings.buy_now_text }}</a>
        {%- endif -%}
      </form>

      {%- if section.settings.show_trust -%}
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:24px;padding:16px;background:var(--c-border);border-radius:var(--radius)">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_badge' -%}
              <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--c-subtle)">
                <span style="color:var(--c-accent)">{{ block.settings.icon }}</span>
                {{ block.settings.text }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_description -%}
        <div style="font-size:15px;line-height:1.8;color:var(--c-subtle)">{{ product.description }}</div>
      {%- endif -%}

      {%- if settings.show_share_buttons -%}
        <div style="margin-top:24px;padding-top:24px;border-top:1px solid var(--c-border);display:flex;align-items:center;gap:12px">
          <span style="font-size:13px;color:var(--c-subtle)">Share:</span>
          <a href="https://www.facebook.com/sharer.php?u={{ shop.url }}{{ product.url }}" target="_blank" rel="noopener" style="color:var(--c-subtle);font-size:13px">Facebook</a>
          <a href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ product.url }}&text={{ product.title | url_encode }}" target="_blank" rel="noopener" style="color:var(--c-subtle);font-size:13px">Twitter</a>
          <a href="whatsapp://send?text={{ product.title | url_encode }}%20{{ shop.url }}{{ product.url }}" style="color:var(--c-subtle);font-size:13px">WhatsApp</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if settings.sticky_atc -%}
<div class="sticky-atc" id="StickyATC" style="opacity:0;transition:opacity .3s">
  <img src="{{ product.featured_image | image_url: width: 80 }}" alt="" width="40" height="40" style="border-radius:4px;object-fit:cover">
  <div style="flex:1;min-width:0"><div style="font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ product.title }}</div><div style="font-size:14px;color:var(--c-accent);font-weight:700">{{ product.price | money }}</div></div>
  <button class="btn btn--primary" data-atc onclick="document.getElementById('ProductForm').requestSubmit()">{{ section.settings.atc_text }}</button>
</div>
<script>
const sa=document.getElementById('StickyATC');const pf=document.getElementById('ProductForm');
window.addEventListener('scroll',()=>{sa.style.opacity=pf.getBoundingClientRect().bottom<0?'1':'0';},{passive:true});
</script>
{%- endif -%}

{% schema %}
{
  "name":"Product Main",
  "settings":[
    {"type":"text","id":"atc_text","label":"Add to Cart Text","default":"Add to Cart"},
    {"type":"checkbox","id":"show_buy_now","label":"Show Buy Now Button","default":true},
    {"type":"text","id":"buy_now_text","label":"Buy Now Text","default":"Buy Now"},
    {"type":"checkbox","id":"show_trust","label":"Show Trust Badges","default":true},
    {"type":"checkbox","id":"show_description","label":"Show Description","default":true}
  ],
  "blocks":[
    {"type":"trust_badge","name":"Trust Badge","limit":6,"settings":[
      {"type":"text","id":"icon","label":"Icon (emoji)","default":"✓"},
      {"type":"text","id":"text","label":"Text","default":"Free Delivery"}
    ]}
  ],
  "presets":[{"name":"Product Main","blocks":[
    {"type":"trust_badge","settings":{"icon":"🔒","text":"Secure Checkout"}},
    {"type":"trust_badge","settings":{"icon":"🚚","text":"Free Shipping"}},
    {"type":"trust_badge","settings":{"icon":"↩️","text":"Easy Returns"}},
    {"type":"trust_badge","settings":{"icon":"✓","text":"Authentic Products"}}
  ]}]
}
{% endschema %}
