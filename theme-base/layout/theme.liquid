<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ settings.text_direction | default: 'ltr' }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_accent }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {% if settings.favicon %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">{% endif %}

  {%- assign formatted_title = page_title -%}
  {%- if current_tags -%}{%- assign formatted_title = formatted_title | append: ' – ' | append: current_tags | join: ', ' -%}{%- endif -%}
  {%- if current_page != 1 -%}{%- assign formatted_title = formatted_title | append: ' – Page ' | append: current_page -%}{%- endif -%}
  {%- unless page_title contains shop.name -%}{%- assign formatted_title = formatted_title | append: ' – ' | append: shop.name -%}{%- endunless -%}
  <title>{{ formatted_title }}</title>

  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ formatted_title | escape }}">
  {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
  {% if page_image %}<meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">{% endif %}

  {{ content_for_header }}

  {% render 'css-variables' %}

  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {% if settings.custom_css != blank %}<style>{{ settings.custom_css }}</style>{% endif %}

  <script>
    window.CF = {
      routes: {
        cart_url: '{{ routes.cart_url }}',
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      },
      moneyFormat: {{ shop.money_format | json }},
      currencyCode: {{ cart.currency.iso_code | json }},
      cartCount: {{ cart.item_count }},
      settings: {
        slideOutCart: {{ settings.enable_slide_cart | json }},
        quickView: {{ settings.enable_quick_view | json }},
        animationsEnabled: {{ settings.enable_animations | json }}
      }
    };
    document.documentElement.classList.add('js');
  </script>
</head>

<body class="template-{{ template.name }} {% if settings.enable_animations %}animations-on{% endif %}" id="top">

  <!-- Skip to content -->
  <a class="skip-to-content visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

  {%- if settings.show_announcement_bar -%}
    {%- section 'announcement-bar' -%}
  {%- endif -%}

  {%- section 'header' -%}

  <!-- Cart Drawer (slide-out) -->
  {%- if settings.enable_slide_cart -%}
    {%- section 'cart-drawer' -%}
  {%- endif -%}

  <!-- Search Overlay -->
  <div id="SearchOverlay" class="search-overlay" aria-hidden="true" role="dialog">
    <div class="search-overlay__inner">
      <button class="search-overlay__close" aria-label="{{ 'accessibility.close' | t }}" id="SearchClose">
        {% render 'icon-close' %}
      </button>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-overlay__form">
        <input type="hidden" name="type" value="product">
        <input type="search" name="q" class="search-overlay__input" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off" id="SearchInput">
        <button type="submit" class="search-overlay__submit">{% render 'icon-search' %}</button>
      </form>
      <div class="search-overlay__results" id="SearchResults"></div>
    </div>
  </div>
  <div class="overlay-bg" id="OverlayBg"></div>

  <!-- Quick View Modal -->
  <div id="QuickViewModal" class="quick-view-modal" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="quick-view-modal__overlay" id="QuickViewOverlay"></div>
    <div class="quick-view-modal__content" id="QuickViewContent">
      <button class="quick-view-modal__close" id="QuickViewClose" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon-close' %}</button>
      <div class="quick-view-modal__body" id="QuickViewBody">
        <div class="quick-view-modal__loading">{% render 'icon-spinner' %}</div>
      </div>
    </div>
  </div>

  <!-- Age Verifier -->
  {%- if settings.enable_age_verifier -%}
    {%- section 'age-verifier' -%}
  {%- endif -%}

  <!-- Promo Popup -->
  {%- section 'promo-popup' -%}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- section 'footer' -%}

  <!-- Back to top -->
  {%- if settings.show_back_to_top -%}
  <button class="back-to-top" id="BackToTop" aria-label="{{ 'accessibility.back_to_top' | t }}" hidden>
    {% render 'icon-arrow-up' %}
  </button>
  {%- endif -%}

  <!-- Toast notification -->
  <div id="Toast" class="toast" aria-live="polite" aria-atomic="true"></div>

  {{ 'theme.js' | asset_url | script_tag }}

  {% if settings.custom_js != blank %}<script>{{ settings.custom_js }}</script>{% endif %}

</body>
</html>
