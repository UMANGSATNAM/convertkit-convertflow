<style>
:root {
  --c-accent: {{ settings.color_accent | default: '#2563EB' }};
  --c-accent-text: {{ settings.color_accent_text | default: '#ffffff' }};
  --c-bg: {{ settings.color_bg | default: '#ffffff' }};
  --c-text: {{ settings.color_text | default: '#111111' }};
  --c-subtle: {{ settings.color_subtle | default: '#6b7280' }};
  --c-border: {{ settings.color_border | default: '#e5e7eb' }};
  --c-header-bg: {{ settings.color_header_bg | default: '#ffffff' }};
  --c-header-text: {{ settings.color_header_text | default: '#111111' }};
  --c-footer-bg: {{ settings.color_footer_bg | default: '#111111' }};
  --c-footer-text: {{ settings.color_footer_text | default: '#ffffff' }};
  --f-heading: {{ settings.font_heading.family | default: 'Georgia' }}, serif;
  --f-body: {{ settings.font_body.family | default: 'system-ui' }}, sans-serif;
  --fs-base: {{ settings.font_size_base | default: 15 }}px;
  --page-width: {{ settings.page_width | default: 1280 }}px;
  --gap: {{ settings.grid_gap | default: 40 }}px;
  --radius: {{ settings.card_border_radius | default: 8 }}px;
  --c-subtle-bg: color-mix(in srgb, var(--c-bg) 94%, var(--c-text) 6%);
}
.page-width { max-width: var(--page-width); margin-left: auto; margin-right: auto; padding-left: 20px; padding-right: 20px; }
.btn-primary {
  display: inline-block;
  padding: 13px 28px;
  background: var(--c-accent);
  color: var(--c-accent-text);
  border: none;
  border-radius: var(--radius);
  font-family: var(--f-body);
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  text-decoration: none;
  transition: opacity .2s, transform .15s;
  line-height: 1;
}
.btn-primary:hover { opacity: .88; transform: translateY(-1px); }
.btn-outline {
  display: inline-block;
  padding: 12px 24px;
  background: transparent;
  color: var(--c-text);
  border: 1.5px solid var(--c-border);
  border-radius: var(--radius);
  font-family: var(--f-body);
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  transition: border-color .2s, background .2s;
  line-height: 1;
}
.btn-outline:hover { border-color: var(--c-accent); background: rgba(0,0,0,.03); }
.rte h1, .rte h2, .rte h3, .rte h4 { font-family: var(--f-heading); margin-bottom: 12px; margin-top: 24px; }
.rte p { margin-bottom: 16px; line-height: 1.7; }
.rte ul, .rte ol { margin: 0 0 16px 24px; line-height: 1.7; }
.rte img { max-width: 100%; height: auto; border-radius: var(--radius); }
.rte a { color: var(--c-accent); }
*, *::before, *::after { box-sizing: border-box; }
</style>
{%- if settings.font_heading != blank -%}
  {{ settings.font_heading | font_face: font_display: 'swap' }}
{%- endif -%}
{%- if settings.font_body != blank -%}
  {{ settings.font_body | font_face: font_display: 'swap' }}
{%- endif -%}
