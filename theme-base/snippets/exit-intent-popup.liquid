<div id="exitIntentOverlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); z-index: 99999; justify-content: center; align-items: center;">
  <div style="background: #fff; width: 90%; max-width: 500px; border-radius: 24px; padding: 40px; position: relative; text-align: center; box-shadow: 0 24px 48px rgba(0,0,0,0.2); animation: popIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);">
    <button onclick="closeExitPopup()" style="position: absolute; top: 16px; right: 16px; background: transparent; border: none; font-size: 24px; color: #999; cursor: pointer;">×</button>
    
    <div style="font-size: 48px; margin-bottom: 16px;">🎁</div>
    <h2 style="font-size: 28px; font-weight: 800; color: #111; margin-bottom: 12px; line-height: 1.1;">Wait! Before you go...</h2>
    <p style="font-size: 15px; color: #555; margin-bottom: 24px; line-height: 1.5;">Take <strong>15% OFF</strong> your entire order right now. Enter your email to unlock your exclusive code.</p>
    
    <div style="display: flex; flex-direction: column; gap: 12px;">
      {/* <label>Form field</label> */}
      <input type="email" placeholder="Enter your email address" style="width: 100%; padding: 16px; border: 1.5px solid #e5e7eb; border-radius: 12px; font-size: 15px; outline: none;">
      <button onclick="claimExitOffer()" style="width: 100%; background: var(--accent-color, #111); color: #fff; border: none; padding: 16px; border-radius: 12px; font-size: 15px; font-weight: 700; cursor: pointer; transition: opacity 0.2s;">
        Claim 15% OFF
      </button>
      <button onclick="closeExitPopup()" style="background: transparent; border: none; color: #888; font-size: 13px; margin-top: 8px; text-decoration: underline; cursor: pointer;">
        No thanks, I prefer paying full price
      </button>
    </div>
  </div>
</div>

<style>
  @keyframes popIn {
    0% { opacity: 0; transform: scale(0.9) translateY(20px); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }
</style>

<script>
  let exitPopupTriggered = false;

  function initExitIntent() {
    // Only trigger once per session
    if(sessionStorage.getItem('exitIntentShown')) return;

    document.addEventListener('mouseleave', function(e) {
      if(e.clientY < 0 && !exitPopupTriggered) {
        exitPopupTriggered = true;
        document.getElementById('exitIntentOverlay').style.display = 'flex';
        sessionStorage.setItem('exitIntentShown', 'true');
      }
    });
  }

  function closeExitPopup() {
    document.getElementById('exitIntentOverlay').style.display = 'none';
  }

  function claimExitOffer() {
    alert("Discount code WAIT15 applied!");
    closeExitPopup();
  }

  // Init after short delay to prevent immediate trigger
  setTimeout(initExitIntent, 3000);
</script>
