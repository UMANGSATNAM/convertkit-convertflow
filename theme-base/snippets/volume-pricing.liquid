<div class="volume-pricing-widget" style="margin: 24px 0;">
  <div style="font-weight: 700; font-size: 14px; margin-bottom: 12px; color: var(--text-color, #111);">Unlock Volume Discounts</div>
  
  <div style="display: flex; flex-direction: column; gap: 12px;">
    <!-- Tier 1 -->
    <label class="vp-tier" style="display: flex; align-items: center; justify-content: space-between; padding: 16px; border: 2px solid var(--accent-color, #000); border-radius: 12px; cursor: pointer; background: rgba(0,0,0,0.02); transition: all 0.2s;">
      <div style="display: flex; align-items: center; gap: 12px;">
        <input type="radio" name="vp_selection" value="1" checked onchange="updateVolumePricing(this)" style="width: 20px; height: 20px; accent-color: var(--accent-color, #000);">
        <div>
          <div style="font-weight: 700; font-size: 15px;">Buy 1</div>
          <div style="font-size: 12px; color: #666;">Standard Price</div>
        </div>
      </div>
      <div style="text-align: right;">
        <div style="font-weight: 800; font-size: 16px;" id="vp-price-1">{{ product.price | default: 5000 | money }}</div>
      </div>
    </label>

    <!-- Tier 2 -->
    <label class="vp-tier" style="display: flex; align-items: center; justify-content: space-between; padding: 16px; border: 1px solid #e5e7eb; border-radius: 12px; cursor: pointer; position: relative; transition: all 0.2s;">
      <div style="position: absolute; top: -10px; left: 16px; background: #FF3B30; color: #fff; font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 10px; text-transform: uppercase; letter-spacing: 0.5px;">Most Popular</div>
      <div style="display: flex; align-items: center; gap: 12px;">
        <input type="radio" name="vp_selection" value="2" onchange="updateVolumePricing(this)" style="width: 20px; height: 20px; accent-color: var(--accent-color, #000);">
        <div>
          <div style="font-weight: 700; font-size: 15px;">Buy 2</div>
          <div style="font-size: 12px; color: #27ae60; font-weight: 600;">Save 15%</div>
        </div>
      </div>
      <div style="text-align: right;">
        <div style="font-size: 12px; text-decoration: line-through; color: #999;">{{ product.price | default: 5000 | times: 2 | money }}</div>
        <div style="font-weight: 800; font-size: 16px;">{{ product.price | default: 5000 | times: 2 | times: 0.85 | money }}</div>
      </div>
    </label>

    <!-- Tier 3 -->
    <label class="vp-tier" style="display: flex; align-items: center; justify-content: space-between; padding: 16px; border: 1px solid #e5e7eb; border-radius: 12px; cursor: pointer; position: relative; transition: all 0.2s;">
      <div style="position: absolute; top: -10px; left: 16px; background: #111; color: #fff; font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 10px; text-transform: uppercase; letter-spacing: 0.5px;">Best Value</div>
      <div style="display: flex; align-items: center; gap: 12px;">
        <input type="radio" name="vp_selection" value="3" onchange="updateVolumePricing(this)" style="width: 20px; height: 20px; accent-color: var(--accent-color, #000);">
        <div>
          <div style="font-weight: 700; font-size: 15px;">Buy 3</div>
          <div style="font-size: 12px; color: #27ae60; font-weight: 600;">Save 25%</div>
        </div>
      </div>
      <div style="text-align: right;">
        <div style="font-size: 12px; text-decoration: line-through; color: #999;">{{ product.price | default: 5000 | times: 3 | money }}</div>
        <div style="font-weight: 800; font-size: 16px;">{{ product.price | default: 5000 | times: 3 | times: 0.75 | money }}</div>
      </div>
    </label>
  </div>
</div>

<script>
  function updateVolumePricing(radio) {
    // Visual update
    document.querySelectorAll('.vp-tier').forEach(el => {
      el.style.border = '1px solid #e5e7eb';
      el.style.background = 'transparent';
    });
    radio.closest('.vp-tier').style.border = '2px solid var(--accent-color, #000)';
    radio.closest('.vp-tier').style.background = 'rgba(0,0,0,0.02)';
    
    // Update global quantity input for the form submission
    const qtyInput = document.querySelector('input[name="quantity"]');
    if(qtyInput) {
      qtyInput.value = radio.value;
    }
  }
</script>
