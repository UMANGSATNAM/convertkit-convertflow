<div class="sf-expert sf-ee-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-ee-container">
    <div class="sf-ee-photo">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: '400x400', crop: 'center' }}" alt="{{ section.settings.name }}" loading="lazy">
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'sf-placeholder' }}
      {% endif %}
    </div>
    <div class="sf-ee-content">
      <h2 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
      <p class="sf-ee-quote" style="color: {{ section.settings.text_color }};">"{{ section.settings.quote }}"</p>
      <div class="sf-ee-meta" style="color: {{ section.settings.text_color }};">
        <strong>{{ section.settings.name }}</strong>
        <span>{{ section.settings.title_meta }}</span>
      </div>
      {% if section.settings.signature != blank %}
        <div class="sf-ee-sig">
          <img src="{{ section.settings.signature | img_url: 'master' }}" alt="Signature" loading="lazy">
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .sf-ee-{{ section.id }} { padding: 6rem 1rem; }
  .sf-ee-container { max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 3rem; }
  @media (min-width: 768px) { .sf-ee-container { flex-direction: row; text-align: left; } }
  
  .sf-ee-photo { width: 250px; height: 250px; flex-shrink: 0; border-radius: 50%; overflow: hidden; border: 8px solid white; box-shadow: 0 10px 30px color-mix(in srgb, var(--color-text) 10%, transparent); }
  .sf-ee-photo img, .sf-placeholder { width: 100%; height: 100%; object-fit: cover; }
  
  .sf-ee-content { flex: 1; }
  .sf-ee-content h2 { font-size: 1rem; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 1.5rem; opacity: 0.6; }
  .sf-ee-quote { font-size: 1.5rem; line-height: 1.5; font-style: italic; margin-bottom: 2rem; font-family: serif; }
  
  .sf-ee-meta strong { display: block; font-size: 1.2rem; }
  .sf-ee-meta span { opacity: 0.7; }
  
  .sf-ee-sig { margin-top: 2rem; height: 50px; }
  .sf-ee-sig img { height: 100%; width: auto; object-fit: contain; }
</style>

{% schema %}
{
  "name": "Expert Endorsement",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fafafa" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111111" },
    { "type": "text", "id": "title", "label": "Overhead Title", "default": "EXPERT APPROVED" },
    { "type": "image_picker", "id": "image", "label": "Expert Photo" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "I've reviewed hundreds of products in my career, and this stands out as a clear leader in quality and innovation." },
    { "type": "text", "id": "name", "label": "Expert Name", "default": "Dr. Sarah Jenkins" },
    { "type": "text", "id": "title_meta", "label": "Expert Title", "default": "Chief Dermatologist" },
    { "type": "image_picker", "id": "signature", "label": "Signature Image (Optional)" }
  ],
  "presets": [ { "name": "Expert Endorsement", "category": "Trust" } ]
}
{% endschema %}
