<div id="cart-drawer" class="fixed inset-0 z-[100] invisible">
  <!-- Overlay -->
  <div class="cart-overlay absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300"></div>

  <!-- Drawer -->
  <div class="cart-content absolute top-0 right-0 w-full max-w-md h-full bg-[var(--color-bg, #ffffff)] shadow-2xl transform translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.7,0,0.3,1)] flex flex-col">
    
    <!-- Header -->
    <div class="flex items-center justify-between p-6 border-b border-gray-100">
      <h2 class="text-2xl font-black uppercase tracking-widest text-[var(--color-text, #111)]">Your Cart <span class="text-sm text-gray-500 font-medium ml-2" id="cart-drawer-count">({{ cart.item_count }})</span></h2>
      <button class="cart-close p-2 text-gray-400 hover:text-black transition-colors rounded-full hover:bg-gray-100">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Free Shipping Progress -->
    {%- if section.settings.free_shipping_threshold != blank -%}
      <div class="p-4 bg-neutral-50 border-b border-gray-100 text-sm text-center font-bold">
        <!-- JS will calculate this dynamically in real implementation -->
        <p>You are <span class="text-[var(--color-accent, #ff0000)]">$25.00</span> away from Free Shipping!</p>
        <div class="w-full h-2 bg-gray-200 rounded-full mt-2 overflow-hidden">
          <div class="h-full bg-[var(--color-primary, #000)] transition-all duration-500" style="width: 75%;"></div>
        </div>
      </div>
    {%- endif -%}

    <!-- Cart Items (Scrollable) -->
    <div class="flex-grow overflow-y-auto p-6 flex flex-col gap-6" id="cart-drawer-items">
      {%- if cart.item_count > 0 -%}
        {%- for item in cart.items -%}
          <div class="flex gap-4">
            <div class="w-20 h-24 flex-shrink-0 bg-neutral-100 rounded overflow-hidden">
              <img src="{{ item.image | img_url: '200x' }}" alt="{{ item.title }}" class="w-full h-full object-cover">
            </div>
            <div class="flex flex-col flex-grow">
              <div class="flex justify-between items-start">
                <a href="{{ item.url }}" class="font-bold text-sm hover:underline">{{ item.product.title }}</a>
                <button class="text-gray-400 hover:text-red-500"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
              </div>
              <p class="text-xs text-gray-500 mb-2">{{ item.variant.title }}</p>
              
              <div class="flex items-center justify-between mt-auto">
                <!-- Quantity Selector -->
                <div class="flex items-center border border-gray-200 rounded">
                  <button class="px-2 py-1 hover:bg-gray-100">-</button>
                  <input type="number" value="{{ item.quantity }}" class="w-8 text-center text-sm focus:outline-none" readonly>
                  <button class="px-2 py-1 hover:bg-gray-100">+</button>
                </div>
                <span class="font-bold">{{ item.final_line_price | money }}</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="flex flex-col items-center justify-center h-full text-center text-gray-500">
          <svg class="w-16 h-16 mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
          <p class="text-lg font-medium">Your cart is empty.</p>
          <button class="cart-close mt-6 underline font-bold uppercase tracking-widest text-black">Continue Shopping</button>
        </div>
      {%- endif -%}
    </div>

    <!-- Footer / Checkout -->
    {%- if cart.item_count > 0 -%}
      <div class="p-6 border-t border-gray-100 bg-neutral-50 flex flex-col gap-4">
        
        {%- if section.settings.show_order_note -%}
          <div>
            <button class="text-sm font-bold underline mb-2" onclick="document.getElementById('cart-note').classList.toggle('hidden')">Add Order Note</button>
            <textarea id="cart-note" name="note" class="hidden w-full p-2 border border-gray-200 rounded text-sm focus:outline-none focus:border-black" rows="2" placeholder="Special instructions..."></textarea>
          </div>
        {%- endif -%}

        <div class="flex items-center justify-between font-black text-xl">
          <span>Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="text-xs text-gray-500 text-center">Taxes and shipping calculated at checkout.</p>
        
        <form action="/cart" method="post" id="cart-drawer-form">
          <button type="submit" name="checkout" class="w-full py-4 bg-[var(--color-primary, #000)] text-white font-bold uppercase tracking-widest rounded hover:bg-neutral-800 transition-colors shadow-lg hover:shadow-xl hover:-translate-y-0.5">
            Checkout &rarr;
          </button>
        </form>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const drawer = document.getElementById('cart-drawer');
  if(!drawer) return;
  
  const overlay = drawer.querySelector('.cart-overlay');
  const content = drawer.querySelector('.cart-content');
  const closeBtns = drawer.querySelectorAll('.cart-close');
  
  window.openCartDrawer = () => {
    drawer.classList.remove('invisible');
    setTimeout(() => {
      overlay.classList.add('opacity-100');
      content.classList.remove('translate-x-full');
      content.classList.add('translate-x-0');
    }, 10);
  };

  const closeDrawer = () => {
    overlay.classList.remove('opacity-100');
    content.classList.remove('translate-x-0');
    content.classList.add('translate-x-full');
    setTimeout(() => {
      drawer.classList.add('invisible');
    }, 500);
  };

  closeBtns.forEach(btn => btn.addEventListener('click', closeDrawer));
  overlay.addEventListener('click', closeDrawer);

  // Bind to any standard cart links/buttons
  document.querySelectorAll('a[href="/cart"]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      window.openCartDrawer();
    });
  });
});
</script>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_order_note",
      "label": "Enable Order Note",
      "default": true
    },
    {
      "type": "text",
      "id": "free_shipping_threshold",
      "label": "Free Shipping Threshold (in cents)",
      "default": "10000",
      "info": "Leave blank to disable."
    }
  ],
  "presets": [
    {
      "name": "Cart Drawer"
    }
  ]
}
{% endschema %}
