{%- if template contains 'product' -%}
<div id="sticky-atc-{{ section.id }}" class="fixed bottom-0 left-0 w-full bg-[var(--color-bg, #ffffff)] shadow-[0_-4px_20px_rgba(0,0,0,0.08)] z-[70] transform translate-y-full transition-transform duration-300 py-3 px-4 md:px-8 border-t border-gray-100">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
    
    <!-- Product Info (Hidden on very small screens) -->
    <div class="hidden md:flex items-center gap-4 flex-grow">
      {%- if product.featured_image != blank -%}
        <img src="{{ product.featured_image | img_url: '100x' }}" class="w-12 h-12 object-cover rounded shadow-sm">
      {%- endif -%}
      <div>
        <h4 class="font-bold text-sm text-[var(--color-text, #111)] truncate max-w-xs">{{ product.title }}</h4>
        <div class="text-[var(--color-accent, #ff0000)] font-bold text-sm" id="sticky-price">{{ product.price | money }}</div>
      </div>
    </div>

    <!-- Variant Selector & Button -->
    <div class="flex items-center gap-3 w-full md:w-auto">
      {%- if product.has_only_default_variant == false -%}
        <select id="sticky-variant-select" class="flex-grow md:w-48 h-12 px-3 bg-neutral-100 border border-transparent rounded text-sm font-bold focus:outline-none focus:border-black transition-colors">
          {%- for variant in product.variants -%}
            <option value="{{ variant.id }}" data-price="{{ variant.price | money }}" {% unless variant.available %}disabled{% endunless %}>
              {{ variant.title }} {% unless variant.available %} - Sold Out{% endunless %}
            </option>
          {%- endfor -%}
        </select>
      {%- endif -%}

      <button id="sticky-add-btn" class="flex-grow md:w-48 h-12 bg-[var(--color-primary, #000)] text-white font-bold uppercase tracking-widest text-sm rounded hover:bg-neutral-800 transition-colors shadow-lg">
        Add to Cart
      </button>
    </div>

  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const stickyBar = document.getElementById('sticky-atc-{{ section.id }}');
  const mainAtcBtn = document.querySelector('form[action="/cart/add"] [type="submit"], .product-form__submit');
  const variantSelect = document.getElementById('sticky-variant-select');
  const priceDisplay = document.getElementById('sticky-price');
  
  if(!stickyBar || !mainAtcBtn) return;

  // Show logic based on main ATC button visibility
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if(entry.isIntersecting) {
        stickyBar.classList.add('translate-y-full'); // Hide when main ATC is visible
      } else {
        stickyBar.classList.remove('translate-y-full'); // Show when main ATC is out of view
      }
    });
  }, { threshold: 0 });

  observer.observe(mainAtcBtn);

  // Sync price if variant changes
  if(variantSelect && priceDisplay) {
    variantSelect.addEventListener('change', (e) => {
      const selectedOption = e.target.options[e.target.selectedIndex];
      if(selectedOption.dataset.price) {
        priceDisplay.innerText = selectedOption.dataset.price;
      }
    });
  }

  // Handle click
  document.getElementById('sticky-add-btn').addEventListener('click', () => {
    // In real implementation, this would trigger the main form submission 
    // or an AJAX cart API call using the selected variant ID.
    const selectedVariant = variantSelect ? variantSelect.value : "{{ product.selected_or_first_available_variant.id }}";
    console.log("Adding to cart: " + selectedVariant);
    
    // Simulate main form click for simplicity
    if(mainAtcBtn) {
      mainAtcBtn.click();
    }
  });
});
</script>
{%- endif -%}

{% schema %}
{
  "name": "Sticky Add To Cart",
  "settings": [],
  "presets": [
    {
      "name": "Sticky Add To Cart"
    }
  ]
}
{% endschema %}
