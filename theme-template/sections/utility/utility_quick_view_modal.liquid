<div id="quick-view-modal" class="fixed inset-0 z-[120] invisible flex items-center justify-center">
  <!-- Overlay -->
  <div class="quick-view-overlay absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>

  <!-- Modal Content -->
  <div class="quick-view-content relative bg-[var(--color-bg, #ffffff)] shadow-2xl rounded-2xl overflow-hidden max-w-5xl w-full mx-4 max-h-[90vh] flex flex-col md:flex-row transform scale-95 opacity-0 transition-all duration-300">
    
    <button class="quick-view-close absolute top-4 right-4 z-10 w-8 h-8 flex items-center justify-center rounded-full bg-white/80 backdrop-blur text-black hover:bg-neutral-200 transition-colors shadow">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>

    <!-- Images -->
    <div class="w-full md:w-1/2 bg-neutral-100 relative h-64 md:h-auto overflow-hidden">
      <!-- Image slider injected via JS -->
      <div id="quick-view-image" class="w-full h-full">
         {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
      </div>
    </div>

    <!-- Product Info -->
    <div class="w-full md:w-1/2 p-6 md:p-10 flex flex-col overflow-y-auto">
      <p class="text-[var(--color-accent, #ff0000)] font-bold uppercase tracking-widest text-xs mb-2" id="quick-view-vendor">Vendor</p>
      <h2 class="text-3xl font-black mb-4" id="quick-view-title">Product Title</h2>
      <div class="flex items-center gap-4 mb-6">
        <span class="text-2xl font-bold" id="quick-view-price">$0.00</span>
        <span class="text-lg text-gray-500 line-through hidden" id="quick-view-compare-price"></span>
      </div>

      <div class="prose prose-sm text-gray-600 mb-8" id="quick-view-description">
        Product description snippet goes here...
      </div>

      <!-- Form Area -->
      <form id="quick-view-form" action="/cart/add" method="post" class="mt-auto">
        <input type="hidden" name="id" id="quick-view-variant-id">
        
        <!-- Options injected via JS -->
        <div id="quick-view-options" class="mb-6 space-y-4"></div>

        <div class="flex items-center gap-4">
          <div class="flex items-center border border-gray-200 rounded h-12 w-32">
            <button type="button" class="px-4 hover:bg-gray-100 h-full" onclick="this.nextElementSibling.stepDown()">-</button>
            <input type="number" name="quantity" value="1" min="1" class="w-full text-center focus:outline-none h-full">
            <button type="button" class="px-4 hover:bg-gray-100 h-full" onclick="this.previousElementSibling.stepUp()">+</button>
          </div>
          
          <button type="submit" class="flex-grow h-12 bg-[var(--color-primary, #000)] text-white font-bold uppercase tracking-widest rounded hover:bg-neutral-800 transition-colors">
            Add to Cart
          </button>
        </div>
      </form>
      
      <a href="#" id="quick-view-full-details" class="mt-6 text-sm underline font-bold uppercase tracking-widest text-center">View Full Details</a>
    </div>

  </div>
</div>

<script>
// Mock logic for Quick View functionality
window.openQuickView = function(productHandle) {
  const modal = document.getElementById('quick-view-modal');
  if(!modal) return;
  
  const overlay = modal.querySelector('.quick-view-overlay');
  const content = modal.querySelector('.quick-view-content');
  
  // Here you would normally fetch product JSON via: fetch(`/products/${productHandle}.js`)
  // and populate #quick-view-title, #quick-view-price, etc.

  modal.classList.remove('invisible');
  setTimeout(() => {
    overlay.classList.add('opacity-100');
    content.classList.remove('scale-95', 'opacity-0');
    content.classList.add('scale-100', 'opacity-100');
  }, 10);
};

document.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('quick-view-modal');
  if(!modal) return;
  
  const overlay = modal.querySelector('.quick-view-overlay');
  const content = modal.querySelector('.quick-view-content');
  const closeBtn = modal.querySelector('.quick-view-close');

  const closeModal = () => {
    overlay.classList.remove('opacity-100');
    content.classList.remove('scale-100', 'opacity-100');
    content.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      modal.classList.add('invisible');
    }, 300);
  };

  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', closeModal);
});
</script>

{% schema %}
{
  "name": "Quick View Modal",
  "settings": [],
  "presets": [
    {
      "name": "Quick View Modal"
    }
  ]
}
{% endschema %}
