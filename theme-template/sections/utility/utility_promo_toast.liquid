<div id="promo-toast-{{ section.id }}" class="fixed bottom-6 left-6 z-[90] max-w-sm w-full bg-[var(--color-bg, #ffffff)] shadow-[0_10px_40px_rgba(0,0,0,0.15)] rounded-lg overflow-hidden transform translate-y-full opacity-0 invisible transition-all duration-500 flex border border-gray-100">
  
  {%- if section.settings.image != blank -%}
    <div class="w-1/3 bg-neutral-100">
      <img src="{{ section.settings.image | img_url: '200x' }}" class="w-full h-full object-cover">
    </div>
  {%- endif -%}

  <div class="p-4 flex-grow relative flex flex-col justify-center">
    <button class="toast-close absolute top-2 right-2 text-gray-400 hover:text-black">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
    
    <span class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent, #ff0000)] mb-1">{{ section.settings.badge }}</span>
    <h4 class="font-black text-sm text-[var(--color-text, #111)] mb-1">{{ section.settings.title }}</h4>
    <p class="text-xs text-[var(--color-text-muted, #555)] mb-3">{{ section.settings.text }}</p>
    
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="text-xs font-bold underline hover:text-[var(--color-accent, #ff0000)] transition-colors">Shop Now</a>
    {%- endif -%}
  </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  {% if section.settings.enable_toast %}
    const toast = document.getElementById('promo-toast-{{ section.id }}');
    const closeBtn = toast.querySelector('.toast-close');
    
    // Check if dismissed in session
    if(sessionStorage.getItem('promo_toast_dismissed')) return;

    // Show after delay
    setTimeout(() => {
      toast.classList.remove('translate-y-full', 'opacity-0', 'invisible');
    }, {{ section.settings.delay_seconds | times: 1000 }});

    closeBtn.addEventListener('click', () => {
      toast.classList.add('translate-y-full', 'opacity-0');
      setTimeout(() => toast.classList.add('invisible'), 500);
      sessionStorage.setItem('promo_toast_dismissed', 'true');
    });
  {% endif %}
});
</script>

{% schema %}
{
  "name": "Promo Toast",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_toast",
      "label": "Enable Toast",
      "default": true
    },
    {
      "type": "number",
      "id": "delay_seconds",
      "label": "Delay (seconds)",
      "default": 5
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Flash Sale"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Free Gift With Purchase"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Spend $150 and get a free tote bag."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Promo Toast"
    }
  ]
}
{% endschema %}
