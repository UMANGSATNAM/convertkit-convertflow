<div class="bold-testimonials" style="padding: 100px 40px; background-color: var(--color-background); border-top: 8px solid var(--color-text); border-bottom: 8px solid var(--color-text);">
  <div style="max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 60px;">
    <div style="border-left: 8px solid var(--color-accent); padding-left: 30px;">
      <h3 style="font-family: var(--font-heading, 'Anton', sans-serif); font-size: 48px; text-transform: uppercase; line-height: 1.1; margin: 0 0 20px 0;">"Absolutely fire. The quality is unmatched in the scene right now."</h3>
      <p style="font-family: var(--font-body, 'Roboto Mono', monospace); font-size: 18px; font-weight: 700; margin: 0;">— HYPEBEAST MAGAZINE</p>
    </div>
    <div style="border-left: 8px solid var(--color-text); padding-left: 30px;">
      <h3 style="font-family: var(--font-heading, 'Anton', sans-serif); font-size: 48px; text-transform: uppercase; line-height: 1.1; margin: 0 0 20px 0;">"A masterclass in modern streetwear construction."</h3>
      <p style="font-family: var(--font-body, 'Roboto Mono', monospace); font-size: 18px; font-weight: 700; margin: 0;">— HIGH SNOBIETY</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bold Testimonials",
  "settings": []
}
{% endschema %}
