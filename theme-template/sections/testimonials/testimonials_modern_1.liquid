<div class="modern-testimonials" style="padding: 100px 20px; background-color: var(--color-text); text-align: left; border-top: 1px solid color-mix(in srgb, var(--color-background) 5%, transparent);">
  <div style="max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
    <div style="background: color-mix(in srgb, var(--color-background) 3%, transparent); padding: 40px; border-radius: var(--radius-card, 16px); border: 1px solid color-mix(in srgb, var(--color-background) 5%, transparent);">
      <div style="display: flex; gap: 5px; color: var(--color-accent); margin-bottom: 20px;">★★★★★</div>
      <p style="font-family: var(--font-body, 'Inter', sans-serif); font-size: 16px; line-height: 1.6; color: var(--color-border); margin-bottom: 25px;">"The build quality is unprecedented. It integrates flawlessly into my existing workflow."</p>
      <h5 style="font-family: var(--font-heading, 'Space Grotesk', sans-serif); font-size: 14px; font-weight: 700; color: var(--color-background); margin: 0;">Sarah J. — Developer</h5>
    </div>
    <div style="background: color-mix(in srgb, var(--color-background) 3%, transparent); padding: 40px; border-radius: var(--radius-card, 16px); border: 1px solid color-mix(in srgb, var(--color-background) 5%, transparent);">
      <div style="display: flex; gap: 5px; color: var(--color-accent); margin-bottom: 20px;">★★★★★</div>
      <p style="font-family: var(--font-body, 'Inter', sans-serif); font-size: 16px; line-height: 1.6; color: var(--color-border); margin-bottom: 25px;">"Unmatched performance metrics compared to industry standards. Highly recommended."</p>
      <h5 style="font-family: var(--font-heading, 'Space Grotesk', sans-serif); font-size: 14px; font-weight: 700; color: var(--color-background); margin: 0;">TechRadar Reviews</h5>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Modern Testimonials",
  "settings": []
}
{% endschema %}
