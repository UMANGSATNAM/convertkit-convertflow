<div class="sf-trust-badges sf-trust-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-trust-container">
    {% for block in section.blocks %}
      <div class="sf-trust-item">
        <div class="sf-trust-icon" style="color: {{ section.settings.icon_color }};">
          {% case block.settings.icon %}
            {% when 'shipping' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            {% when 'shield' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            {% when 'award' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
            {% when 'leaf' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 14 6h7v7a7 7 0 0 1-7 7h-3z"></path><path d="M11 20a7 7 0 0 0-7-7H2v-7a7 7 0 0 1 7-7h3z"></path></svg>
          {% endcase %}
        </div>
        <div class="sf-trust-text" style="color: {{ section.settings.text_color }};">
          <h4>{{ block.settings.title }}</h4>
          {% if block.settings.subtitle != blank %}
            <p>{{ block.settings.subtitle }}</p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .sf-trust-{{ section.id }} {
    padding: 3rem 1rem;
    border-top: 1px solid var(--color-surface);
    border-bottom: 1px solid var(--color-surface);
  }
  .sf-trust-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1rem;
  }
  .sf-trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .sf-trust-icon {
    width: 48px;
    height: 48px;
    margin-bottom: 1rem;
  }
  .sf-trust-text h4 {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
  }
  .sf-trust-text p {
    font-size: 0.85rem;
    margin: 0;
    opacity: 0.8;
  }
  @media (min-width: 768px) {
    .sf-trust-container {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Trust Badges",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "shield", "label": "Secure" },
            { "value": "award", "label": "Quality" },
            { "value": "leaf", "label": "Organic" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "On orders over ₹999"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "D2C Trust Badges",
      "category": "Trust",
      "blocks": [
        { "type": "badge", "settings": { "icon": "shipping", "title": "Free Shipping", "subtitle": "On all orders" } },
        { "type": "badge", "settings": { "icon": "shield", "title": "Secure Payments", "subtitle": "100% Safe" } },
        { "type": "badge", "settings": { "icon": "award", "title": "Premium Quality", "subtitle": "Guaranteed" } },
        { "type": "badge", "settings": { "icon": "leaf", "title": "Eco-Friendly", "subtitle": "Sustainable packaging" } }
      ]
    }
  ]
}
{% endschema %}
