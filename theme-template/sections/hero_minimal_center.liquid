<div class="sf-hero-minimal sf-minimal-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-minimal-content">
    <h1 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h1>
    <p style="color: {{ section.settings.text_color }};">{{ section.settings.subtitle }}</p>
    {% if section.settings.btn_link != blank %}
      <a href="{{ section.settings.btn_link }}" class="sf-btn-minimal" style="border-color: {{ section.settings.text_color }}; color: {{ section.settings.text_color }};">
        {{ section.settings.btn_text }}
      </a>
    {% endif %}
  </div>
</div>

<style>
  .sf-minimal-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: 4rem 2rem;
    text-align: center;
  }
  .sf-minimal-content {
    max-width: 800px;
  }
  .sf-minimal-content h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 300;
    letter-spacing: -1px;
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }
  .sf-minimal-content p {
    font-size: 1.25rem;
    margin-bottom: 2.5rem;
    opacity: 0.8;
  }
  .sf-btn-minimal {
    display: inline-block;
    padding: 12px 32px;
    border: 1px solid;
    text-decoration: none;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all 0.3s ease;
  }
  .sf-btn-minimal:hover {
    background: {{ section.settings.text_color }};
    color: {{ section.settings.bg_color }} !important;
  }
</style>

{% schema %}
{
  "name": "Minimal Center Hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fcfcfc" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Simplicity is the ultimate sophistication." },
    { "type": "textarea", "id": "subtitle", "label": "Subheading", "default": "Discover our new minimalist collection." },
    { "type": "text", "id": "btn_text", "label": "Button", "default": "Shop Collection" },
    { "type": "url", "id": "btn_link", "label": "Link" }
  ],
  "presets": [ { "name": "Minimal Center Hero", "category": "Hero" } ]
}
{% endschema %}
