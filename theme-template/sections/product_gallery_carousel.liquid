<div class="sf-gallery sf-gallery-{{ section.id }}">
  <div class="sf-gallery-main">
    {% if product.images.size > 0 %}
      <img src="{{ product.images.first | img_url: 'master' }}" alt="{{ product.title }}" id="sf-main-image" loading="lazy">
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'sf-placeholder-svg' }}
    {% endif %}
  </div>
  {% if product.images.size > 1 %}
    <div class="sf-gallery-thumbs">
      {% for image in product.images %}
        <img src="{{ image | img_url: '200x' }}" alt="Thumbnail" class="sf-thumb" onclick="document.getElementById('sf-main-image').src='{{ image | img_url: 'master' }}'" loading="lazy">
      {% endfor %}
    </div>
  {% endif %}
</div>

<style>
  .sf-gallery-{{ section.id }} {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sf-gallery-main {
    width: 100%;
    aspect-ratio: 1/1;
    background: var(--color-surface);
    border-radius: 8px;
    overflow: hidden;
  }
  .sf-gallery-main img, .sf-gallery-main svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sf-gallery-thumbs {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 5px;
  }
  .sf-thumb {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 4px;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border 0.2s;
  }
  .sf-thumb:hover {
    border-color: var(--color-text);
  }
  .sf-gallery-thumbs::-webkit-scrollbar {
    height: 4px;
  }
  .sf-gallery-thumbs::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 4px;
  }
</style>

{% schema %}
{
  "name": "Product Gallery",
  "settings": [],
  "presets": [
    {
      "name": "Product Gallery",
      "category": "Product"
    }
  ]
}
{% endschema %}
