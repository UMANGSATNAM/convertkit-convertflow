<div class="sf-collection-grid sf-collection-grid-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-collection-container">
    <div class="sf-collection-header">
      <h2 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
      {% if section.settings.show_view_all %}
        <a href="{{ section.settings.collection.url }}" class="sf-view-all" style="color: {{ section.settings.text_color }};">View All →</a>
      {% endif %}
    </div>

    <div class="sf-grid">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        <a href="{{ product.url }}" class="sf-product-card">
          <div class="sf-product-image-wrapper">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title }}" class="sf-product-img">
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'sf-placeholder-svg' }}
            {% endif %}
            <div class="sf-quick-add">Quick Add</div>
          </div>
          <div class="sf-product-details">
            <h3 class="sf-product-title" style="color: {{ section.settings.text_color }};">{{ product.title }}</h3>
            <p class="sf-product-price" style="color: {{ section.settings.text_color }};">{{ product.price | money }}</p>
          </div>
        </a>
      {% else %}
        <!-- Mock Products if no collection is selected -->
        {% for i in (1..4) %}
          <div class="sf-product-card">
            <div class="sf-product-image-wrapper">
              {{ 'product-' | append: i | placeholder_svg_tag: 'sf-placeholder-svg' }}
            </div>
            <div class="sf-product-details">
              <h3 class="sf-product-title" style="color: {{ section.settings.text_color }};">Example Product</h3>
              <p class="sf-product-price" style="color: {{ section.settings.text_color }};">₹999.00</p>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .sf-collection-grid-{{ section.id }} {
    padding: 4rem 1rem;
  }
  .sf-collection-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .sf-collection-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
  }
  .sf-collection-header h2 {
    font-size: 2rem;
    margin: 0;
  }
  .sf-view-all {
    text-decoration: none;
    font-weight: 600;
  }
  .sf-view-all:hover {
    text-decoration: underline;
  }
  .sf-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .sf-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .sf-product-card {
    text-decoration: none;
    display: block;
    group: hover;
  }
  .sf-product-image-wrapper {
    position: relative;
    aspect-ratio: 4/5;
    background: #f4f4f4;
    overflow: hidden;
    margin-bottom: 1rem;
  }
  .sf-product-img, .sf-placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .sf-product-card:hover .sf-product-img {
    transform: scale(1.05);
  }
  .sf-quick-add {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: rgba(255,255,255,0.9);
    color: #000;
    text-align: center;
    padding: 12px;
    font-weight: 600;
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }
  .sf-product-card:hover .sf-quick-add {
    transform: translateY(0);
  }
  .sf-product-title {
    font-size: 1rem;
    margin: 0 0 0.5rem 0;
    font-weight: 600;
  }
  .sf-product-price {
    margin: 0;
    opacity: 0.8;
  }
</style>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Trending Now"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4, "max": 12, "step": 4,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' link",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    }
  ],
  "presets": [
    {
      "name": "Modern Collection Grid",
      "category": "Collection"
    }
  ]
}
{% endschema %}
