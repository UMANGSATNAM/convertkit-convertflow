<div class="sf-hero-slider sf-slider-{{ section.id }}">
  <div class="sf-slides-container">
    {% for block in section.blocks %}
      <div class="sf-slide" style="background-color: {{ block.settings.bg_color }};">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.title }}" class="sf-slide-bg" fetchpriority="high">
        {% else %}
          <div class="sf-slide-placeholder"></div>
        {% endif %}
        <div class="sf-slide-content">
          <h2 style="color: {{ block.settings.text_color }}">{{ block.settings.title }}</h2>
          <p style="color: {{ block.settings.text_color }}">{{ block.settings.subtitle }}</p>
          {% if block.settings.btn_link != blank %}
            <a href="{{ block.settings.btn_link }}" class="sf-slide-btn" style="background: {{ block.settings.btn_color }}; color: {{ block.settings.btn_text_color }}">{{ block.settings.btn_text }}</a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .sf-slider-{{ section.id }} {
    width: 100%;
    height: 70vh;
    overflow: hidden;
    position: relative;
  }
  .sf-slides-container {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .sf-slides-container::-webkit-scrollbar { display: none; }
  .sf-slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    position: relative;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sf-slide-bg, .sf-slide-placeholder {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .sf-slide-placeholder { background: var(--color-surface); }
  .sf-slide-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 2rem;
    background: color-mix(in srgb, var(--color-text) 30%, transparent);
    backdrop-filter: blur(5px);
    border-radius: 8px;
  }
  .sf-slide-content h2 {
    font-size: 3rem; margin-bottom: 1rem;
  }
  .sf-slide-content p {
    font-size: 1.2rem; margin-bottom: 2rem;
  }
  .sf-slide-btn {
    display: inline-block; padding: 12px 30px; text-decoration: none; font-weight: bold; text-transform: uppercase;
  }
</style>

{% schema %}
{
  "name": "Fullwidth Slider",
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "color", "id": "bg_color", "label": "Fallback BG Color", "default": "#000" },
        { "type": "color", "id": "text_color", "label": "Text Color", "default": "#fff" },
        { "type": "text", "id": "title", "label": "Heading", "default": "New Arrivals" },
        { "type": "text", "id": "subtitle", "label": "Subheading", "default": "Shop the latest trends." },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Shop Now" },
        { "type": "url", "id": "btn_link", "label": "Button Link" },
        { "type": "color", "id": "btn_color", "label": "Button BG", "default": "#fff" },
        { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#000" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fullwidth Slider",
      "category": "Hero"
    }
  ]
}
{% endschema %}
