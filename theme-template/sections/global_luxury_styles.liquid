{% comment %} Global Luxury Design System — Load karo pehle section se {% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>

<style>
  :root {
    --lux-bg:       #0C0B0A;
    --lux-bg-card:  #141210;
    --lux-bg-mid:   #1A1713;
    --lux-gold:     #C9A84C;
    --lux-gold-lt:  #E8CC7A;
    --lux-gold-dk:  #9A7A2E;
    --lux-cream:    #F5EDD8;
    --lux-white:    #FAFAF8;
    --lux-grey:     #888580;
    --lux-border:   rgba(201,168,76,0.2);
    --font-serif:   'Playfair Display', Georgia, serif;
    --font-sans:    'Inter', system-ui, sans-serif;
    --ease-lux:     cubic-bezier(0.16, 1, 0.3, 1);
    --ease-gold:    cubic-bezier(0.4, 0, 0.2, 1);
    --transition:   0.6s var(--ease-lux);
  }

  /* ── Global resets for luxury feel ── */
  .sf-lux *, .sf-lux *::before, .sf-lux *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .sf-lux { font-family: var(--font-sans); color: var(--lux-white); background: var(--lux-bg); -webkit-font-smoothing: antialiased; }
  .sf-lux a { color: inherit; text-decoration: none; }
  .sf-lux img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* ── Gold line divider ── */
  .sf-gold-rule {
    display: block; width: 40px; height: 1px;
    background: linear-gradient(90deg, transparent, var(--lux-gold), transparent);
    margin: 0 auto 1.5rem;
  }

  /* ── Section label ── */
  .sf-section-label {
    display: inline-flex; align-items: center; gap: 0.75rem;
    font-family: var(--font-sans); font-size: 0.7rem; font-weight: 500;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--lux-gold);
    margin-bottom: 1rem;
  }
  .sf-section-label::before,
  .sf-section-label::after {
    content: ''; display: block; width: 24px; height: 1px; background: var(--lux-gold); opacity: 0.6;
  }

  /* ── Gold CTA Button ── */
  .sf-btn-gold {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 14px 36px; border: 1px solid var(--lux-gold);
    font-family: var(--font-sans); font-size: 0.75rem; font-weight: 500;
    letter-spacing: 0.15em; text-transform: uppercase; color: var(--lux-gold);
    background: transparent; cursor: pointer; position: relative; overflow: hidden;
    transition: color 0.4s var(--ease-gold);
  }
  .sf-btn-gold::before {
    content: ''; position: absolute; inset: 0;
    background: var(--lux-gold); transform: scaleX(0); transform-origin: left;
    transition: transform 0.4s var(--ease-gold);
  }
  .sf-btn-gold:hover { color: var(--lux-bg); }
  .sf-btn-gold:hover::before { transform: scaleX(1); }
  .sf-btn-gold span { position: relative; z-index: 1; }

  /* ── Ghost Button ── */
  .sf-btn-ghost {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-sans); font-size: 0.75rem; font-weight: 500;
    letter-spacing: 0.15em; text-transform: uppercase; color: var(--lux-grey);
    background: none; border: none; cursor: pointer; padding: 0;
    border-bottom: 1px solid transparent; transition: color 0.3s, border-color 0.3s;
  }
  .sf-btn-ghost:hover { color: var(--lux-gold); border-color: var(--lux-gold); }

  /* ── Scroll animations (added via JS) ── */
  .sf-reveal { opacity: 0; transform: translateY(28px); }
  .sf-reveal.is-visible { opacity: 1; transform: translateY(0); transition: opacity 0.8s var(--ease-lux), transform 0.8s var(--ease-lux); }
  .sf-reveal-delay-1 { transition-delay: 0.1s !important; }
  .sf-reveal-delay-2 { transition-delay: 0.2s !important; }
  .sf-reveal-delay-3 { transition-delay: 0.3s !important; }
  .sf-reveal-delay-4 { transition-delay: 0.4s !important; }
  .sf-reveal-delay-5 { transition-delay: 0.5s !important; }

  /* ── Custom scrollbar ── */
  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: var(--lux-bg); }
  ::-webkit-scrollbar-thumb { background: var(--lux-gold-dk); border-radius: 2px; }

  /* ── Gold price tag ── */
  .sf-price-gold { color: var(--lux-gold); font-family: var(--font-sans); font-weight: 500; }
  .sf-price-compare { color: var(--lux-grey); text-decoration: line-through; font-size: 0.85em; margin-right: 0.4rem; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Intersection Observer for scroll reveals
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        setTimeout(() => entry.target.classList.add('is-visible'), i * 80);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });

  document.querySelectorAll('.sf-reveal').forEach(el => observer.observe(el));
});
</script>

