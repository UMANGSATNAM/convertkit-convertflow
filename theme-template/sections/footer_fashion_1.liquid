<footer style="background-color: var(--color-text); color: var(--color-background); padding: 60px 20px 20px 20px; text-align: center;">
  <div style="margin-bottom: 40px;">
    <h3 style="text-transform: uppercase; letter-spacing: 2px; margin-bottom: 20px;">Join our Newsletter</h3>
    <p style="margin-bottom: 20px; color: var(--color-border);">Get early access to new collections and exclusive offers.</p>
    <form style="display: flex; justify-content: center; max-width: 400px; margin: 0 auto;">
      <input type="email" placeholder="Email address" style="padding: 10px; width: 100%; border: none; outline: none;" />
      <button type="submit" style="padding: 10px 20px; background-color: var(--color-background); color: var(--color-text); border: none; cursor: pointer; text-transform: uppercase; font-weight: bold;">Subscribe</button>
    </form>
  </div>
  <div style="border-top: 1px solid var(--color-text-secondary); padding-top: 20px;">
    <p style="margin: 0; color: var(--color-text-secondary); font-size: 0.8em;">&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Fashion Footer 1",
  "settings": [],
  "presets": [
    {
      "name": "Fashion Footer 1"
    }
  ]
}
{% endschema %}
