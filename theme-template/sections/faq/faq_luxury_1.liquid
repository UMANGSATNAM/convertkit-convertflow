<div class="luxury-faq" style="padding: 80px 20px; background-color: #fdfdfd; max-width: 800px; margin: 0 auto;">
  <h2 style="font-family: var(--fontHeading, 'Playfair Display', serif); font-size: 32px; text-align: center; color: #0a0a0a; margin-bottom: 60px; font-weight: 400;">Client Services</h2>
  
  <div style="border-top: 1px solid #eaeaea;">
    <div style="padding: 25px 0; border-bottom: 1px solid #eaeaea; display: flex; justify-content: space-between; cursor: pointer;">
      <h3 style="font-family: var(--fontBody, 'Inter', sans-serif); font-size: 14px; text-transform: uppercase; letter-spacing: 1px; color: #0a0a0a; margin: 0;">Shipping & Delivery</h3>
      <span style="color: #0a0a0a;">+</span>
    </div>
    <div style="padding: 25px 0; border-bottom: 1px solid #eaeaea; display: flex; justify-content: space-between; cursor: pointer;">
      <h3 style="font-family: var(--fontBody, 'Inter', sans-serif); font-size: 14px; text-transform: uppercase; letter-spacing: 1px; color: #0a0a0a; margin: 0;">Returns & Exchanges</h3>
      <span style="color: #0a0a0a;">+</span>
    </div>
    <div style="padding: 25px 0; border-bottom: 1px solid #eaeaea; display: flex; justify-content: space-between; cursor: pointer;">
      <h3 style="font-family: var(--fontBody, 'Inter', sans-serif); font-size: 14px; text-transform: uppercase; letter-spacing: 1px; color: #0a0a0a; margin: 0;">Care Instructions</h3>
      <span style="color: #0a0a0a;">+</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Luxury FAQ",
  "settings": []
}
{% endschema %}
