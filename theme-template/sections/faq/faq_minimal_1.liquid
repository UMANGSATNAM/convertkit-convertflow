<div class="minimal-faq" style="padding: 100px 20px; background-color: var(--color-background); max-width: 600px; margin: 0 auto; text-align: left;">
  <h2 style="font-family: var(--font-heading, 'Helvetica Neue', sans-serif); font-size: 24px; color: var(--color-text-secondary); margin-bottom: 40px; font-weight: 400;">Questions & Answers</h2>
  
  <div style="border-top: 1px solid var(--color-surface);">
    <div style="padding: 20px 0; border-bottom: 1px solid var(--color-surface); cursor: pointer;">
      <h3 style="font-family: var(--font-body, 'Helvetica Neue', sans-serif); font-size: 15px; font-weight: 400; color: var(--color-text-secondary); margin: 0;">How is your packaging sustainable?</h3>
    </div>
    <div style="padding: 20px 0; border-bottom: 1px solid var(--color-surface); cursor: pointer;">
      <h3 style="font-family: var(--font-body, 'Helvetica Neue', sans-serif); font-size: 15px; font-weight: 400; color: var(--color-text-secondary); margin: 0;">Can I return an item?</h3>
    </div>
    <div style="padding: 20px 0; border-bottom: 1px solid var(--color-surface); cursor: pointer;">
      <h3 style="font-family: var(--font-body, 'Helvetica Neue', sans-serif); font-size: 15px; font-weight: 400; color: var(--color-text-secondary); margin: 0;">Where are your products made?</h3>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Minimal FAQ",
  "settings": []
}
{% endschema %}
