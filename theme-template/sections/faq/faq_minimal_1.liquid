<div class="minimal-faq" style="padding: 100px 20px; background-color: #fcfcfc; max-width: 600px; margin: 0 auto; text-align: left;">
  <h2 style="font-family: var(--fontHeading, 'Helvetica Neue', sans-serif); font-size: 24px; color: #333; margin-bottom: 40px; font-weight: 400;">Questions & Answers</h2>
  
  <div style="border-top: 1px solid #f0f0f0;">
    <div style="padding: 20px 0; border-bottom: 1px solid #f0f0f0; cursor: pointer;">
      <h3 style="font-family: var(--fontBody, 'Helvetica Neue', sans-serif); font-size: 15px; font-weight: 400; color: #555; margin: 0;">How is your packaging sustainable?</h3>
    </div>
    <div style="padding: 20px 0; border-bottom: 1px solid #f0f0f0; cursor: pointer;">
      <h3 style="font-family: var(--fontBody, 'Helvetica Neue', sans-serif); font-size: 15px; font-weight: 400; color: #555; margin: 0;">Can I return an item?</h3>
    </div>
    <div style="padding: 20px 0; border-bottom: 1px solid #f0f0f0; cursor: pointer;">
      <h3 style="font-family: var(--fontBody, 'Helvetica Neue', sans-serif); font-size: 15px; font-weight: 400; color: #555; margin: 0;">Where are your products made?</h3>
    </div>
  </div>
</div>

