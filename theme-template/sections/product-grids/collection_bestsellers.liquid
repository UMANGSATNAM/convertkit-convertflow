<div class="collection-bestsellers py-24 px-6 md:px-12 bg-[#0a0a0a] text-white">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
      <div class="max-w-2xl">
        {%- if section.settings.badge != blank -%}
          <span class="inline-block py-1 px-3 border border-white/20 text-xs font-bold uppercase tracking-[0.2em] mb-6 text-white/70">{{ section.settings.badge }}</span>
        {%- endif -%}
        <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tight leading-[0.9]">{{ section.settings.title }}</h2>
      </div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="group flex items-center gap-4 text-sm font-bold uppercase tracking-widest hover:text-[var(--color-accent, #ff3366)] transition-colors">
          {{ section.settings.button_label }}
          <span class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center group-hover:border-[var(--color-accent, #ff3366)] transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </span>
        </a>
      {%- endif -%}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-16">
      {%- assign collection = collections[section.settings.collection] -%}
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <div class="bestseller-card group cursor-pointer relative">
            <div class="absolute -left-4 -top-4 w-12 h-12 bg-[var(--color-accent, #ff3366)] text-white font-black text-xl flex items-center justify-center rounded-full z-10 shadow-lg transform -rotate-12 group-hover:rotate-0 transition-transform">
              #{{ forloop.index }}
            </div>
            
            <a href="{{ product.url }}" class="block relative aspect-[4/5] bg-neutral-900 rounded-xl overflow-hidden mb-6">
              <img src="{{ product.featured_image | img_url: '700x' }}" alt="{{ product.title }}" class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-110 transition-all duration-700 ease-[cubic-bezier(0.2,0.8,0.2,1)]">
              
              <div class="absolute bottom-4 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] flex gap-2 translate-y-12 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                <form method="post" action="/cart/add" class="flex-grow">
                  <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                  <button type="submit" class="w-full py-3 bg-white text-black font-bold uppercase text-xs tracking-wider rounded hover:bg-neutral-200 transition-colors">
                    Add to Cart
                  </button>
                </form>
              </div>
            </a>
            
            <div class="flex justify-between items-start gap-4">
              <div>
                <h3 class="text-lg font-bold group-hover:text-[var(--color-accent, #ff3366)] transition-colors line-clamp-2">{{ product.title }}</h3>
                <div class="flex items-center gap-1 mt-2 text-[#FFD700]">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                  <span class="text-white/50 text-xs ml-1">(4.9)</span>
                </div>
              </div>
              <div class="text-right flex-shrink-0">
                <span class="font-medium text-white/90">{{ product.price | money }}</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          <div class="bestseller-card group cursor-pointer relative">
            <div class="absolute -left-4 -top-4 w-12 h-12 bg-gray-700 text-white font-black text-xl flex items-center justify-center rounded-full z-10 shadow-lg transform -rotate-12 group-hover:rotate-0 transition-transform">
              #{{ i }}
            </div>
            <div class="relative aspect-[4/5] bg-neutral-800 rounded-xl overflow-hidden mb-6">
              {{ 'product-' | append: i | placeholder_svg_tag: 'w-full h-full object-cover opacity-30 mix-blend-multiply group-hover:scale-110 transition-transform duration-700' }}
            </div>
            <div class="flex justify-between items-start">
              <h3 class="text-lg font-bold text-white">Top Product {{ i }}</h3>
              <span class="font-medium text-white/90">$120.00</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bestsellers Board",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "THE CHARTS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "View Full List"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Bestsellers Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Bestsellers Board"
    }
  ]
}
{% endschema %}
