<div class="product-list-compact py-16 px-4 md:px-8 bg-[var(--color-bg, #ffffff)]">
  <div class="max-w-4xl mx-auto">
    {%- if section.settings.title != blank -%}
      <div class="flex justify-between items-end border-b-2 border-black pb-4 mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text, #111)] uppercase tracking-wide">{{ section.settings.title }}</h2>
        {%- if section.settings.link_label != blank -%}
          <a href="{{ section.settings.link }}" class="text-sm font-bold uppercase text-gray-500 hover:text-black transition-colors">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="flex flex-col">
      {%- assign collection = collections[section.settings.collection] -%}
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <a href="{{ product.url }}" class="flex items-center gap-6 py-6 border-b border-gray-200 group hover:bg-neutral-50 transition-colors px-4 -mx-4 rounded">
            <!-- Image -->
            <div class="w-20 h-20 md:w-24 md:h-24 bg-white rounded shadow-sm overflow-hidden flex-shrink-0 relative">
              <img src="{{ product.featured_image | img_url: '300x' }}" alt="{{ product.title }}" class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-500">
            </div>
            
            <!-- Info -->
            <div class="flex-grow">
              <p class="text-xs text-gray-400 font-bold uppercase mb-1">{{ product.vendor }}</p>
              <h3 class="text-lg font-bold text-black group-hover:text-[var(--color-primary, #000)] transition-colors">{{ product.title }}</h3>
            </div>
            
            <!-- Price -->
            <div class="text-right">
              <p class="text-lg font-bold text-black">{{ product.price | money }}</p>
              {%- if product.compare_at_price > product.price -%}
                <p class="text-sm text-red-500 line-through">{{ product.compare_at_price | money }}</p>
              {%- endif -%}
            </div>
            
            <!-- Action Icon (Hidden on mobile) -->
            <div class="hidden md:flex items-center justify-center w-10 h-10 rounded-full bg-white border border-gray-200 group-hover:bg-[var(--color-primary, #000)] group-hover:border-transparent group-hover:text-white transition-all ml-4">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..5) -%}
          <div class="flex items-center gap-6 py-6 border-b border-gray-200 px-4 -mx-4">
            <div class="w-20 h-20 md:w-24 md:h-24 bg-neutral-100 rounded overflow-hidden flex-shrink-0">
              {{ 'product-' | append: i | placeholder_svg_tag: 'w-full h-full opacity-50 mix-blend-multiply object-cover' }}
            </div>
            <div class="flex-grow">
              <p class="text-xs text-gray-400 font-bold uppercase mb-1">Brand Name</p>
              <h3 class="text-lg font-bold text-black">Tech Accessory {{ i }}</h3>
            </div>
            <div class="text-right">
              <p class="text-lg font-bold text-black">$89.00</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Compact Product List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Latest Releases"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "View All Label",
      "default": "See All"
    },
    {
      "type": "url",
      "id": "link",
      "label": "View All Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Compact Product List"
    }
  ]
}
{% endschema %}
