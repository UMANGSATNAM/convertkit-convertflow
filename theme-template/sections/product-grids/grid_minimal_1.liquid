<div class="minimal-grid" style="padding: 100px 5%; background-color: #ffffff; text-align: center;">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 60px;">
    {% for product in collections['all'].products limit: 4 %}
      <div class="product-card" style="text-align: center;">
        <a href="{{ product.url }}" style="text-decoration: none;">
          <div style="width: 100%; padding-top: 120%; position: relative; background-color: #fcfcfc; border-radius: var(--radius, 0px);">
            <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title }}" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; transition: opacity 0.3s ease;" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">
          </div>
          <h3 style="font-family: var(--fontBody, 'Helvetica Neue', sans-serif); font-size: 15px; font-weight: 400; margin-top: 25px; color: #333;">{{ product.title }}</h3>
          <p style="font-family: var(--fontBody, 'Helvetica Neue', sans-serif); font-size: 15px; color: #888; font-weight: 300; margin-top: 8px;">{{ product.price | money }}</p>
        </a>
      </div>
    {% else %}
      <!-- Mock Data -->
      {% for i in (1..4) %}
        <div class="product-card" style="text-align: center;">
          <div style="width: 100%; padding-top: 120%; position: relative; background-color: #f7f7f7; border-radius: var(--radius, 0px);"></div>
          <h3 style="font-family: var(--fontBody, 'Helvetica Neue', sans-serif); font-size: 15px; font-weight: 400; margin-top: 25px; color: #333;">Minimalist Essential {{ i }}</h3>
          <p style="font-family: var(--fontBody, 'Helvetica Neue', sans-serif); font-size: 15px; color: #888; font-weight: 300; margin-top: 8px;">$45.00</p>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Minimal Product Grid",
  "settings": []
}
{% endschema %}
