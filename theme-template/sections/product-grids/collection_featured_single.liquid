<div class="collection-featured-single py-20 px-6 bg-[var(--color-surface, #f4f4f4)] overflow-hidden relative">
  
  <!-- Decorative background element -->
  <div class="absolute top-1/2 right-0 transform translate-x-1/3 -translate-y-1/2 w-[800px] h-[800px] bg-[var(--color-primary, #000)]/5 rounded-full filter blur-3xl z-0 pointer-events-none"></div>

  <div class="max-w-6xl mx-auto relative z-10 flex flex-col md:flex-row items-center gap-12 md:gap-20">
    
    {%- assign product = all_products[section.settings.product] -%}

    <div class="w-full md:w-1/2 relative group perspective-1000">
      <div class="relative rounded-2xl overflow-hidden aspect-[4/5] shadow-2xl transform group-hover:rotate-y-6 transition-transform duration-700 ease-out">
        {%- if product != blank and product.featured_image != blank -%}
          <img src="{{ product.featured_image | img_url: '1000x' }}" alt="{{ product.title }}" class="absolute inset-0 w-full h-full object-cover">
          {%- if product.images[1] != blank -%}
            <img src="{{ product.images[1] | img_url: '1000x' }}" alt="{{ product.title }}" class="absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-700">
          {%- endif -%}
        {%- else -%}
          <div class="absolute inset-0 bg-neutral-200">
            {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover mix-blend-multiply opacity-30' }}
          </div>
        {%- endif -%}
        
        <!-- Sale Badge -->
        {%- if product != blank and product.compare_at_price > product.price -%}
          <div class="absolute top-6 left-6 bg-[var(--color-accent, #ff0000)] text-white text-xs font-bold uppercase tracking-wider py-1.5 px-3 rounded">
            Sale
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="w-full md:w-1/2 text-center md:text-left">
      {%- if section.settings.pre_heading != blank -%}
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-[var(--color-primary, #000)]/60 mb-4">{{ section.settings.pre_heading }}</p>
      {%- endif -%}

      <h2 class="text-4xl md:text-6xl font-black text-[var(--color-text, #111)] mb-6 leading-tight">
        {%- if product != blank -%}
          {{ product.title }}
        {%- else -%}
          {{ section.settings.title | default: "Featured Product Name" }}
        {%- endif -%}
      </h2>

      <div class="text-2xl text-[var(--color-primary, #000)] font-medium mb-8">
        {%- if product != blank -%}
          {{ product.price | money }}
          {%- if product.compare_at_price > product.price -%}
            <span class="text-lg text-gray-400 line-through ml-2">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
        {%- else -%}
          $99.00
        {%- endif -%}
      </div>

      <p class="text-lg text-[var(--color-text-muted, #555)] mb-10 leading-relaxed max-w-lg mx-auto md:mx-0">
        {%- if product != blank -%}
          {{ product.description | strip_html | truncatewords: 30 }}
        {%- else -%}
          {{ section.settings.text | default: "Detailed description highlighting the key benefits, materials, and why the customer absolutely needs this item right now." }}
        {%- endif -%}
      </p>

      {%- if product != blank -%}
        <form method="post" action="/cart/add" class="flex flex-col sm:flex-row items-center gap-4">
          <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
          <button type="submit" class="w-full sm:w-auto px-10 py-5 bg-[var(--color-primary, #000)] text-white font-bold uppercase tracking-widest hover:bg-[var(--color-accent, #222)] transition-colors rounded shadow-xl">
            Add to Bag
          </button>
          <a href="{{ product.url }}" class="w-full sm:w-auto px-10 py-5 bg-transparent border-2 border-[var(--color-primary, #000)] text-[var(--color-primary, #000)] font-bold uppercase tracking-widest hover:bg-black/5 transition-colors rounded">
            View Details
          </a>
        </form>
      {%- else -%}
        <div class="flex flex-col sm:flex-row items-center gap-4">
          <button class="w-full sm:w-auto px-10 py-5 bg-[var(--color-primary, #000)] text-white font-bold uppercase tracking-widest rounded shadow-xl">Add to Bag</button>
        </div>
      {%- endif -%}
      
      <!-- Trust features beneath button -->
      <div class="flex items-center justify-center md:justify-start gap-6 mt-8 opacity-70">
        <div class="flex items-center gap-2 text-sm font-medium">
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          In Stock
        </div>
        <div class="flex items-center gap-2 text-sm font-medium">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          Free Shipping
        </div>
      </div>
    </div>

  </div>
</div>

<style>
.perspective-1000 { perspective: 1000px; }
.rotate-y-6 { transform: rotateY(6deg); }
</style>

{% schema %}
{
  "name": "Featured Product Single",
  "settings": [
    {
      "type": "text",
      "id": "pre_heading",
      "label": "Pre-heading",
      "default": "EDITOR'S PICK"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Select Product"
    },
    {
      "type": "header",
      "content": "Fallback Content (if no product)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    }
  ],
  "presets": [
    {
      "name": "Featured Product Single"
    }
  ]
}
{% endschema %}
