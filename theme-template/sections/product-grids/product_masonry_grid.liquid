<div class="product-masonry py-16 px-4 md:px-8 bg-[var(--color-background)]">
  <div class="max-w-7xl mx-auto">
    {%- if section.settings.title != blank -%}
      <h2 class="text-3xl md:text-5xl font-black text-center mb-12 text-[var(--color-text)] uppercase tracking-tight">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
      {%- assign collection = collections[section.settings.collection] -%}
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <!-- Randomize heights for masonry effect based on loop index -->
          {%- assign height_class = "aspect-[3/4]" -%}
          {%- assign mod = forloop.index | modulo: 3 -%}
          {%- if mod == 0 -%}
            {%- assign height_class = "aspect-square" -%}
          {%- elsif mod == 1 -%}
            {%- assign height_class = "aspect-[4/5]" -%}
          {%- endif -%}

          <div class="break-inside-avoid mb-6 group relative">
            <a href="{{ product.url }}" class="block w-full {{ height_class }} relative overflow-hidden bg-neutral-100 rounded-2xl">
              <img src="{{ product.featured_image | img_url: '700x' }}" alt="{{ product.title }}" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-[cubic-bezier(0.2,0.8,0.2,1)]" loading="lazy">
              
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              
              <div class="absolute bottom-0 left-0 w-full p-6 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300 flex justify-between items-end">
                <div>
                  <h3 class="text-[var(--color-background)] font-bold text-xl mb-1">{{ product.title }}</h3>
                  <p class="text-[var(--color-background)]/80 font-medium">{{ product.price | money }}</p>
                </div>
                <button class="w-10 h-10 rounded-full bg-[var(--color-background)] text-[var(--color-text)] flex items-center justify-center hover:bg-[var(--color-accent, #ff0000)] hover:text-[var(--color-background)] transition-colors shadow-lg">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                </button>
              </div>
            </a>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..8) -%}
          {%- assign height_class = "aspect-[3/4]" -%}
          {%- assign mod = forloop.index | modulo: 3 -%}
          {%- if mod == 0 -%}
            {%- assign height_class = "aspect-square" -%}
          {%- elsif mod == 1 -%}
            {%- assign height_class = "aspect-[4/5]" -%}
          {%- endif -%}
          
          <div class="break-inside-avoid mb-6 group relative">
            <div class="block w-full {{ height_class }} relative overflow-hidden bg-neutral-100 rounded-2xl">
              {{ 'product-' | append: i | placeholder_svg_tag: 'w-full h-full object-cover opacity-60 mix-blend-multiply group-hover:scale-105 transition-transform duration-700' }}
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    
    {%- if section.settings.show_view_all and collection != blank -%}
      <div class="mt-12 text-center">
        <a href="{{ collection.url }}" class="inline-block px-10 py-4 bg-[var(--color-text)] text-[var(--color-background)] font-bold uppercase tracking-widest rounded hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
          Explore All
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Masonry Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Curated Picks"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Masonry Grid"
    }
  ]
}
{% endschema %}
