<div class="sf-shm sf-shm-{{ section.id }}">
  <div class="sf-shm-trigger" style="background-color: {{ section.settings.bg_color }};" onclick="document.getElementById('sf-shm-modal-{{ section.id }}').classList.add('active');">
    <div class="sf-shm-thumb">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: '600x' }}" alt="Video thumbnail" loading="lazy">
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'sf-placeholder' }}
      {% endif %}
      <div class="sf-shm-play">▶</div>
    </div>
    <div class="sf-shm-teaser">
      <h3 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h3>
      <p style="color: {{ section.settings.text_color }};">{{ section.settings.subtitle }}</p>
    </div>
  </div>

  <div class="sf-shm-modal" id="sf-shm-modal-{{ section.id }}">
    <div class="sf-shm-modal-overlay" onclick="document.getElementById('sf-shm-modal-{{ section.id }}').classList.remove('active');"></div>
    <div class="sf-shm-modal-content">
      <button class="sf-shm-modal-close" onclick="document.getElementById('sf-shm-modal-{{ section.id }}').classList.remove('active');">✕</button>
      
      <div class="sf-shm-split">
        <div class="sf-shm-video-area">
          {% if section.settings.video_url != blank %}
            <video src="{{ section.settings.video_url }}" autoplay loop muted playsinline class="sf-shm-video"></video>
          {% else %}
            <div class="sf-shm-video-placeholder">Video goes here</div>
          {% endif %}
        </div>
        <div class="sf-shm-products-area">
          <h3>Shop the Look</h3>
          <div class="sf-shm-products-list">
            {% for block in section.blocks %}
              {% assign prod = all_products[block.settings.product] %}
              {% if prod != blank %}
                <a href="{{ prod.url }}" class="sf-shm-product">
                  <div class="sf-shm-product-img">
                    <img src="{{ prod.featured_image | img_url: '150x150', crop: 'center' }}" alt="{{ prod.title }}" loading="lazy">
                  </div>
                  <div class="sf-shm-product-info">
                    <h4>{{ prod.title }}</h4>
                    <span class="sf-shm-price">{{ prod.price | money }}</span>
                  </div>
                  <div class="sf-shm-product-add">View</div>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .sf-shm-trigger { cursor: pointer; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 30px color-mix(in srgb, var(--color-text) 10%, transparent); max-width: 400px; margin: 2rem auto; transition: transform 0.3s; }
  .sf-shm-trigger:hover { transform: translateY(-5px); }
  .sf-shm-thumb { position: relative; aspect-ratio: 4/5; }
  .sf-shm-thumb img, .sf-placeholder { width: 100%; height: 100%; object-fit: cover; }
  .sf-shm-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 60px; height: 60px; background: color-mix(in srgb, var(--color-background) 90%, transparent); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: var(--color-text); box-shadow: 0 5px 15px color-mix(in srgb, var(--color-text) 20%, transparent); }
  .sf-shm-teaser { padding: 1.5rem; text-align: center; }
  .sf-shm-teaser h3 { margin-bottom: 0.5rem; font-size: 1.25rem; font-weight: bold; }
  .sf-shm-teaser p { opacity: 0.8; font-size: 0.95rem; }

  .sf-shm-modal { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 9999; display: none; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s; }
  .sf-shm-modal.active { display: flex; opacity: 1; }
  .sf-shm-modal-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: color-mix(in srgb, var(--color-text) 80%, transparent); backdrop-filter: blur(5px); }
  .sf-shm-modal-content { position: relative; z-index: 10; width: 90%; max-width: 1000px; max-height: 90vh; background: var(--color-background); border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; }
  .sf-shm-modal-close { position: absolute; top: 15px; right: 15px; width: 40px; height: 40px; border-radius: 50%; background: color-mix(in srgb, var(--color-text) 10%, transparent); border: none; font-size: 1.2rem; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 20; }
  
  .sf-shm-split { display: grid; grid-template-columns: 1fr; height: 100%; max-height: 80vh; }
  @media (min-width: 768px) { .sf-shm-split { grid-template-columns: 60% 40%; } }
  
  .sf-shm-video-area { background: var(--color-text); display: flex; align-items: center; justify-content: center; position: relative; height: 40vh; }
  @media (min-width: 768px) { .sf-shm-video-area { height: 80vh; } }
  .sf-shm-video { width: 100%; height: 100%; object-fit: cover; }
  .sf-shm-video-placeholder { color: white; opacity: 0.5; }
  
  .sf-shm-products-area { padding: 2rem; overflow-y: auto; background: var(--color-surface); }
  .sf-shm-products-area h3 { font-size: 1.5rem; margin-bottom: 2rem; font-weight: bold; border-bottom: 2px solid var(--color-text); padding-bottom: 1rem; }
  .sf-shm-products-list { display: flex; flex-direction: column; gap: 1rem; }
  .sf-shm-product { display: flex; align-items: center; gap: 1rem; padding: 1rem; background: var(--color-background); border-radius: 8px; text-decoration: none; color: var(--color-text); box-shadow: 0 4px 10px color-mix(in srgb, var(--color-text) 5%, transparent); transition: transform 0.2s; }
  .sf-shm-product:hover { transform: translateY(-2px); }
  .sf-shm-product-img { width: 80px; height: 80px; border-radius: 4px; overflow: hidden; flex-shrink: 0; }
  .sf-shm-product-img img { width: 100%; height: 100%; object-fit: cover; }
  .sf-shm-product-info { flex: 1; }
  .sf-shm-product-info h4 { font-size: 1rem; margin-bottom: 0.5rem; font-weight: bold; }
  .sf-shm-price { font-size: 0.95rem; opacity: 0.8; }
  .sf-shm-product-add { background: var(--color-text); color: var(--color-background); padding: 5px 15px; border-radius: 4px; font-size: 0.85rem; font-weight: bold; }
</style>

{% schema %}
{
  "name": "Shoppable Video Modal",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Thumbnail Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Thumbnail Text Color", "default": "#111111" },
    { "type": "image_picker", "id": "image", "label": "Thumbnail Image" },
    { "type": "text", "id": "title", "label": "Thumbnail Title", "default": "Watch the Campaign" },
    { "type": "text", "id": "subtitle", "label": "Thumbnail Subtitle", "default": "Shop the featured looks." },
    { "type": "url", "id": "video_url", "label": "Video MP4 URL", "info": "The video to play in the modal." }
  ],
  "blocks": [
    {
      "type": "product", "name": "Featured Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [ { "name": "Shoppable Video Modal", "category": "Utilities" } ]
}
{% endschema %}
