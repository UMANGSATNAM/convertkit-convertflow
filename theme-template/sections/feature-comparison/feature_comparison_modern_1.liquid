<div class="modern-feature-comparison" style="padding: 100px 20px; background-color: #0f1115; color: #fff; text-align: center; border-top: 1px solid rgba(255,255,255,0.05);">
  <h2 style="font-family: var(--fontHeading, 'Space Grotesk', sans-serif); font-size: 32px; margin-bottom: 60px; font-weight: 700;">Engineered for Superiority</h2>
  
  <div style="max-width: 800px; margin: 0 auto; overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; font-family: var(--fontBody, 'Inter', sans-serif); text-align: left;">
      <thead>
        <tr style="border-bottom: 1px solid rgba(255,255,255,0.1);">
          <th style="padding: 20px; color: #a1a1aa; font-weight: 500; font-size: 14px;">Feature</th>
          <th style="padding: 20px; color: #3b82f6; font-weight: 700; font-size: 16px;">Our Standard</th>
          <th style="padding: 20px; color: #71717a; font-weight: 500; font-size: 14px;">Industry Average</th>
        </tr>
      </thead>
      <tbody>
        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
          <td style="padding: 20px; font-weight: 600;">Processing Speed</td>
          <td style="padding: 20px; color: #fff; font-weight: 600;">4.2 GHz Base</td>
          <td style="padding: 20px; color: #71717a;">3.5 GHz Base</td>
        </tr>
        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
          <td style="padding: 20px; font-weight: 600;">Build Material</td>
          <td style="padding: 20px; color: #fff; font-weight: 600;">Aerospace Aluminum</td>
          <td style="padding: 20px; color: #71717a;">Recycled Plastic</td>
        </tr>
        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
          <td style="padding: 20px; font-weight: 600;">Warranty</td>
          <td style="padding: 20px; color: #fff; font-weight: 600;">2 Years Included</td>
          <td style="padding: 20px; color: #71717a;">1 Year Limited</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "Modern Feature Comparison",
  "settings": []
}
{% endschema %}
