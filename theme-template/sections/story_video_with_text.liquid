<div class="sf-vwt sf-vwt-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-vwt-container {% if section.settings.layout == 'right' %}sf-vwt-reverse{% endif %}">
    <div class="sf-vwt-video">
      {% if section.settings.video_url != blank %}
        {% if section.settings.video_url.type == 'youtube' %}
          <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=0&controls=1&rel=0" frameborder="0" allowfullscreen></iframe>
        {% elsif section.settings.video_url.type == 'vimeo' %}
          <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}" frameborder="0" allowfullscreen></iframe>
        {% endif %}
      {% else %}
        <div class="sf-vwt-placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'sf-placeholder' }}
          <div class="sf-vwt-play">▶</div>
        </div>
      {% endif %}
    </div>
    <div class="sf-vwt-content">
      <h2 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
      <div class="sf-vwt-text" style="color: {{ section.settings.text_color }};">
        {{ section.settings.text }}
      </div>
      {% if section.settings.btn_link != blank %}
        <a href="{{ section.settings.btn_link }}" class="sf-vwt-btn" style="background: {{ section.settings.btn_bg }}; color: {{ section.settings.btn_text }};">{{ section.settings.btn_label }}</a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .sf-vwt-{{ section.id }} { padding: 5rem 1rem; }
  .sf-vwt-container { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  @media (min-width: 992px) {
    .sf-vwt-container { grid-template-columns: 1fr 1fr; }
    .sf-vwt-reverse .sf-vwt-video { order: 2; }
    .sf-vwt-reverse .sf-vwt-content { order: 1; }
  }
  .sf-vwt-video { width: 100%; aspect-ratio: 16/9; background: #000; border-radius: 8px; overflow: hidden; position: relative; }
  .sf-vwt-video iframe { width: 100%; height: 100%; position: absolute; top: 0; left: 0; }
  .sf-vwt-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; position: relative; }
  .sf-vwt-placeholder svg { width: 100%; height: 100%; opacity: 0.5; }
  .sf-vwt-play { position: absolute; font-size: 3rem; color: white; background: rgba(0,0,0,0.5); width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .sf-vwt-content { padding: 1rem; text-align: left; }
  .sf-vwt-content h2 { font-size: 2.5rem; margin-bottom: 1.5rem; line-height: 1.2; }
  .sf-vwt-text { font-size: 1.1rem; line-height: 1.8; opacity: 0.9; margin-bottom: 2rem; }
  .sf-vwt-btn { display: inline-block; padding: 15px 30px; text-decoration: none; font-weight: bold; border-radius: 4px; text-transform: uppercase; }
</style>

{% schema %}
{
  "name": "Video with Text",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111111" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "left", "label": "Video Left" }, { "value": "right", "label": "Video Right" } ], "default": "left" },
    { "type": "video_url", "id": "video_url", "label": "Video URL", "accept": ["youtube", "vimeo"] },
    { "type": "text", "id": "title", "label": "Title", "default": "Watch Our Story" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>See how our products are made and meet the team behind the magic.</p>" },
    { "type": "text", "id": "btn_label", "label": "Button Label" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#111111" },
    { "type": "color", "id": "btn_text", "label": "Button Text", "default": "#ffffff" }
  ],
  "presets": [ { "name": "Video with Text", "category": "Story" } ]
}
{% endschema %}
