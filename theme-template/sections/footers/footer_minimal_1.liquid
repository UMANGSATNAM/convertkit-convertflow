<div class="minimal-footer" style="background-color: #ffffff; color: #999; padding: 60px 40px 30px; text-align: left; border-top: 1px solid #f5f5f5;">
  <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 40px;">
    <div>
      <h2 style="font-family: var(--fontHeading, 'Helvetica Neue', sans-serif); font-size: 18px; font-weight: 500; color: #333; margin-bottom: 15px;">{{ shop.name | default: 'Essence' }}</h2>
      <p style="font-family: var(--fontBody, 'Helvetica Neue', sans-serif); font-size: 13px; font-weight: 300;">Simplicity in design.<br>Clarity in purpose.</p>
    </div>
    <div style="font-family: var(--fontBody, 'Helvetica Neue', sans-serif); font-size: 13px; font-weight: 300; display: flex; gap: 40px;">
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <a href="#" style="color: #666; text-decoration: none;">Shop</a>
        <a href="#" style="color: #666; text-decoration: none;">Story</a>
      </div>
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <a href="#" style="color: #666; text-decoration: none;">FAQ</a>
        <a href="#" style="color: #666; text-decoration: none;">Contact</a>
      </div>
    </div>
  </div>
  <div style="max-width: 1200px; margin: 40px auto 0; font-family: var(--fontBody, 'Helvetica Neue', sans-serif); font-size: 12px; font-weight: 300; color: #aaa;">
    &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}.
  </div>
</div>

{% schema %}
{
  "name": "Minimal Footer",
  "settings": []
}
{% endschema %}
