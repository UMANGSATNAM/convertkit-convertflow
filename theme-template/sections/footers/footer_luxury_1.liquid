<div class="luxury-footer" style="background-color: #050505; color: #888; padding: 80px 40px 40px; text-align: center; border-top: 1px solid #1a1a1a;">
  <h2 style="font-family: var(--fontHeading, 'Playfair Display', serif); font-size: 32px; color: #fdfdfd; margin-bottom: 20px;">{{ shop.name | default: 'Maison' }}</h2>
  <div style="font-family: var(--fontBody, 'Inter', sans-serif); font-size: 12px; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 40px; display: flex; justify-content: center; gap: 30px;">
    <a href="#" style="color: #888; text-decoration: none;">Instagram</a>
    <a href="#" style="color: #888; text-decoration: none;">Journal</a>
    <a href="#" style="color: #888; text-decoration: none;">Contact</a>
  </div>
  <p style="font-family: var(--fontBody, 'Inter', sans-serif); font-size: 11px; letter-spacing: 1px; color: #444;">&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All Rights Reserved.</p>
</div>

