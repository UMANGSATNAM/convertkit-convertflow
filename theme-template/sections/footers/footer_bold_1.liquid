<div class="bold-footer" style="background-color: #ff0000; color: #000; padding: 100px 40px 40px; border-top: 8px solid #000;">
  <div style="max-width: 1400px; margin: 0 auto; display: flex; flex-direction: column; align-items: center;">
    <h2 style="font-family: var(--fontHeading, 'Anton', sans-serif); font-size: 100px; line-height: 0.9; margin-bottom: 40px; text-transform: uppercase; text-align: center;">{{ shop.name | default: 'STREET' }}</h2>
    
    <div style="display: flex; gap: 40px; font-family: var(--fontBody, 'Roboto Mono', monospace); font-size: 24px; font-weight: 700; text-transform: uppercase; margin-bottom: 80px;">
      <a href="#" style="color: #000; text-decoration: none; border-bottom: 4px solid transparent;" onmouseover="this.style.borderBottom='4px solid #000'" onmouseout="this.style.borderBottom='4px solid transparent'">INSTAGRAM</a>
      <a href="#" style="color: #000; text-decoration: none; border-bottom: 4px solid transparent;" onmouseover="this.style.borderBottom='4px solid #000'" onmouseout="this.style.borderBottom='4px solid transparent'">TIKTOK</a>
      <a href="#" style="color: #000; text-decoration: none; border-bottom: 4px solid transparent;" onmouseover="this.style.borderBottom='4px solid #000'" onmouseout="this.style.borderBottom='4px solid transparent'">DISCORD</a>
    </div>

    <div style="width: 100%; border-top: 4px solid #000; padding-top: 20px; display: flex; justify-content: space-between; font-family: var(--fontBody, 'Roboto Mono', monospace); font-size: 14px; font-weight: 700;">
      <span>&copy; {{ 'now' | date: "%Y" }} {{ shop.name | upcase }}. NO RIGHTS RESERVED.</span>
      <span style="display: flex; gap: 20px;">
        <a href="#" style="color: #000; text-decoration: none;">LEGAL</a>
        <a href="#" style="color: #000; text-decoration: none;">TERMS</a>
      </span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bold Footer",
  "settings": []
}
{% endschema %}
