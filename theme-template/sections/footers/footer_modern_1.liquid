<div class="modern-footer" style="background-color: #050505; color: #71717a; padding: 80px 40px 40px; border-top: 1px solid rgba(255,255,255,0.05);">
  <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 40px;">
    <div style="flex: 1; min-width: 250px;">
      <h2 style="font-family: var(--fontHeading, 'Space Grotesk', sans-serif); font-size: 24px; color: #ffffff; font-weight: 700; margin-bottom: 20px; background: linear-gradient(90deg, #3b82f6, #8b5cf6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; width: fit-content;">{{ shop.name | default: 'Nexus' }}</h2>
      <p style="font-family: var(--fontBody, 'Inter', sans-serif); font-size: 14px; line-height: 1.6;">Empowering the next generation of creators with cutting-edge hardware solutions.</p>
    </div>
    <div style="display: flex; gap: 60px; font-family: var(--fontBody, 'Inter', sans-serif); font-size: 14px; font-weight: 500;">
      <div style="display: flex; flex-direction: column; gap: 15px;">
        <h4 style="color: #fff; margin-bottom: 5px; font-family: var(--fontHeading, 'Space Grotesk', sans-serif);">Product</h4>
        <a href="#" style="color: #71717a; text-decoration: none;">Hardware</a>
        <a href="#" style="color: #71717a; text-decoration: none;">Software</a>
        <a href="#" style="color: #71717a; text-decoration: none;">Accessories</a>
      </div>
      <div style="display: flex; flex-direction: column; gap: 15px;">
        <h4 style="color: #fff; margin-bottom: 5px; font-family: var(--fontHeading, 'Space Grotesk', sans-serif);">Support</h4>
        <a href="#" style="color: #71717a; text-decoration: none;">Documentation</a>
        <a href="#" style="color: #71717a; text-decoration: none;">Contact Sales</a>
        <a href="#" style="color: #71717a; text-decoration: none;">Status</a>
      </div>
    </div>
  </div>
  <div style="max-width: 1200px; margin: 60px auto 0; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.05); font-family: var(--fontBody, 'Inter', sans-serif); font-size: 12px; display: flex; justify-content: space-between;">
    <span>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.</span>
    <span style="display: flex; gap: 20px;">
      <a href="#" style="color: #71717a; text-decoration: none;">Privacy</a>
      <a href="#" style="color: #71717a; text-decoration: none;">Terms</a>
    </span>
  </div>
</div>

{% schema %}
{
  "name": "Modern Footer",
  "settings": []
}
{% endschema %}
