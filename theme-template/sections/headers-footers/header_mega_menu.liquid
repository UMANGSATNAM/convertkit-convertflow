<header class="header-mega-menu border-b border-gray-200 bg-[var(--color-bg, #ffffff)] relative z-50">
  <!-- Top Bar: Logo & Icons -->
  <div class="max-w-[1440px] mx-auto px-6 h-20 flex items-center justify-between">
    <div class="flex items-center gap-4">
      <button class="lg:hidden p-2 text-black">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
      <a href="/" class="block">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | img_url: '400x' }}" alt="{{ shop.name }}" class="h-8 w-auto object-contain">
        {%- else -%}
          <span class="text-2xl font-black uppercase tracking-wider text-[var(--color-text, #111)]">{{ shop.name | default: 'YOUR BRAND' }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Main Navigation (Desktop) -->
    <nav class="hidden lg:flex items-center gap-8 h-full">
      {%- for link in linklists[section.settings.menu].links -%}
        <div class="group h-full flex items-center">
          <a href="{{ link.url }}" class="text-sm font-bold uppercase tracking-widest text-black hover:text-[var(--color-accent, #ff0000)] transition-colors h-full flex items-center gap-1">
            {{ link.title }}
            {%- if link.links != blank -%}
              <svg class="w-4 h-4 transform group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            {%- endif -%}
          </a>

          <!-- Mega Menu Dropdown -->
          {%- if link.links != blank -%}
            <div class="absolute top-20 left-0 w-full bg-white shadow-xl border-t border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform -translate-y-2 group-hover:translate-y-0">
              <div class="max-w-[1440px] mx-auto px-6 py-12 flex gap-16">
                <!-- Links Columns -->
                <div class="flex-grow flex gap-12">
                  {%- for child_link in link.links -%}
                    <div class="w-1/3">
                      <a href="{{ child_link.url }}" class="block text-lg font-bold text-black mb-4 hover:text-[var(--color-accent, #ff0000)]">{{ child_link.title }}</a>
                      {%- if child_link.links != blank -%}
                        <ul class="space-y-3">
                          {%- for grandchild_link in child_link.links -%}
                            <li>
                              <a href="{{ grandchild_link.url }}" class="text-gray-500 hover:text-black transition-colors">{{ grandchild_link.title }}</a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
                
                <!-- Mega Menu Featured Image (Optional) -->
                {%- if section.settings.mega_image != blank -%}
                  <div class="w-1/3 flex-shrink-0 relative group/promo cursor-pointer">
                    <div class="aspect-video w-full rounded-lg overflow-hidden relative">
                      <img src="{{ section.settings.mega_image | img_url: 'master' }}" class="w-full h-full object-cover group-hover/promo:scale-105 transition-transform duration-700">
                      <div class="absolute inset-0 bg-black/20"></div>
                      <div class="absolute inset-0 p-6 flex flex-col justify-end">
                        <span class="text-white font-bold text-xl mb-1">{{ section.settings.mega_title | default: "New Arrivals" }}</span>
                        <span class="text-white/80 text-sm font-medium uppercase tracking-wider">Shop Now &rarr;</span>
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
      {%- if linklists[section.settings.menu].links.size == 0 -%}
        <div class="group h-full flex items-center">
          <a href="#" class="text-sm font-bold uppercase tracking-widest text-black hover:text-gray-600 h-full flex items-center">Shop</a>
        </div>
      {%- endif -%}
    </nav>

    <div class="flex items-center gap-4">
      <a href="/search" class="p-2 text-black hover:bg-neutral-100 rounded-full transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </a>
      <a href="/cart" class="p-2 text-black hover:bg-neutral-100 rounded-full transition-colors relative">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
        <span class="absolute top-0 right-0 w-4 h-4 bg-[var(--color-primary, #000)] text-white text-[10px] font-bold rounded-full flex items-center justify-center">0</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header - Mega Menu",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Use nested menus to activate mega menu."
    },
    {
      "type": "image_picker",
      "id": "mega_image",
      "label": "Featured Image in Mega Menu"
    },
    {
      "type": "text",
      "id": "mega_title",
      "label": "Featured Image Text"
    }
  ],
  "presets": [
    {
      "name": "Header - Mega Menu"
    }
  ]
}
{% endschema %}
