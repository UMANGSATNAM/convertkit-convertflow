<div id="popup-exit-intent-{{ section.id }}" class="fixed inset-0 z-[100] invisible flex items-center justify-center">
  <!-- Overlay -->
  <div class="popup-overlay absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>

  <!-- Popup Modal -->
  <div class="popup-content relative bg-[var(--color-bg, #ffffff)] text-[var(--color-text, #111)] shadow-2xl rounded-2xl overflow-hidden max-w-4xl w-full mx-4 flex flex-col md:flex-row transform scale-95 opacity-0 transition-all duration-300">
    
    <!-- Close Button -->
    <button class="popup-close absolute top-4 right-4 z-10 w-8 h-8 flex items-center justify-center rounded-full bg-white text-black hover:bg-neutral-200 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>

    <!-- Image Half -->
    <div class="hidden md:block md:w-1/2 relative bg-black">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | img_url: 'master' }}" class="absolute inset-0 w-full h-full object-cover">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'w-full h-full object-cover opacity-50' }}
      {%- endif -%}
    </div>

    <!-- Content Half -->
    <div class="w-full md:w-1/2 p-8 md:p-12 flex flex-col justify-center text-center">
      <p class="text-[var(--color-accent, #ff0000)] font-bold uppercase tracking-widest text-sm mb-4">{{ section.settings.subtitle }}</p>
      <h2 class="text-4xl md:text-5xl font-black uppercase tracking-wider mb-4 leading-tight">{{ section.settings.title }}</h2>
      <p class="text-lg text-[var(--color-text-muted, #555)] mb-8">{{ section.settings.text }}</p>

      {% form 'customer', class: 'w-full max-w-sm mx-auto' %}
        <input type="hidden" name="contact[tags]" value="newsletter, exit_intent">
        <div class="flex flex-col gap-4">
          <input 
            type="email" 
            name="contact[email]" 
            class="w-full px-4 py-3 bg-neutral-100 border border-neutral-200 rounded text-center placeholder-gray-500 focus:outline-none focus:border-black transition-colors" 
            placeholder="Enter your email"
            required
          >
          <button type="submit" class="w-full px-6 py-4 bg-[var(--color-primary, #000)] text-white font-bold uppercase tracking-widest rounded hover:bg-neutral-800 transition-colors">
            {{ section.settings.button_label }}
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="mt-4 text-green-600 font-medium text-sm">You're on the list! Check your inbox.</p>
        {%- endif -%}
      {% endform %}
      
      <button class="popup-close-text mt-6 text-sm text-gray-400 hover:text-black underline transition-colors">
        No thanks, I prefer paying full price
      </button>
    </div>

  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const popup = document.getElementById('popup-exit-intent-{{ section.id }}');
  if(!popup) return;
  
  const overlay = popup.querySelector('.popup-overlay');
  const content = popup.querySelector('.popup-content');
  const closeBtns = popup.querySelectorAll('.popup-close, .popup-close-text');
  
  let hasTriggered = false;

  // Show logic
  const showPopup = () => {
    if(hasTriggered || sessionStorage.getItem('exit_popup_seen')) return;
    
    popup.classList.remove('invisible');
    setTimeout(() => {
      overlay.classList.add('opacity-100');
      content.classList.remove('scale-95', 'opacity-0');
      content.classList.add('scale-100', 'opacity-100');
    }, 10);
    
    hasTriggered = true;
    sessionStorage.setItem('exit_popup_seen', 'true'); // Prevent showing again in session
  };

  // Close logic
  const closePopup = () => {
    overlay.classList.remove('opacity-100');
    content.classList.remove('scale-100', 'opacity-100');
    content.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      popup.classList.add('invisible');
    }, 300);
  };

  closeBtns.forEach(btn => btn.addEventListener('click', closePopup));
  overlay.addEventListener('click', closePopup);

  // Exit intent detection (mouse leaves top of window)
  document.addEventListener('mouseleave', (e) => {
    if(e.clientY < 0) {
      showPopup();
    }
  });

  // Fallback: show after 15 seconds if no exit intent
  setTimeout(showPopup, 15000);
});
</script>

{% schema %}
{
  "name": "Popup - Exit Intent",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Popup Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Wait before you go!"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Get 15% Off"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Sign up for our newsletter and get 15% off your first order."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Claim My Discount"
    }
  ],
  "presets": [
    {
      "name": "Popup - Exit Intent"
    }
  ]
}
{% endschema %}
