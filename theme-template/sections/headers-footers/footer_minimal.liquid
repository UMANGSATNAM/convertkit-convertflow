<footer class="footer-minimal bg-[var(--color-bg, #ffffff)] text-[var(--color-text, #111)] py-12 px-6 border-t border-gray-100">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8">
    
    <!-- Logo -->
    <div class="flex-shrink-0">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | img_url: '300x' }}" alt="{{ shop.name }}" class="h-8 w-auto">
      {%- else -%}
        <span class="text-xl font-black uppercase tracking-widest">{{ shop.name }}</span>
      {%- endif -%}
    </div>

    <!-- Inline Menu -->
    <nav class="flex flex-wrap justify-center gap-6 md:gap-8">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}" class="text-sm font-bold uppercase tracking-wider hover:text-[var(--color-accent, #ff0000)] transition-colors">
          {{ link.title }}
        </a>
      {%- endfor -%}
    </nav>

    <!-- Social / Copyright -->
    <div class="flex flex-col items-center md:items-end gap-2 text-xs text-gray-500 font-medium">
      <div class="flex gap-4 mb-2">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" class="hover:text-black transition-colors">Instagram</a>
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}
          <a href="{{ settings.social_tiktok_link }}" class="hover:text-black transition-colors">TikTok</a>
        {%- endif -%}
      </div>
      <p>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.</p>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer - Minimal",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    }
  ],
  "presets": [
    {
      "name": "Footer - Minimal"
    }
  ]
}
{% endschema %}
