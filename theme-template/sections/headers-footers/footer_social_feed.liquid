<footer class="footer-social-feed bg-[var(--color-background)] text-[var(--color-text)]">
  
  <!-- Instagram/Social Feed Header -->
  <div class="pt-20 pb-10 text-center px-6">
    <h2 class="text-2xl md:text-3xl font-black uppercase tracking-widest mb-4">{{ section.settings.feed_title }}</h2>
    <a href="{{ section.settings.social_link }}" target="_blank" class="text-[var(--color-accent, #ff0000)] font-bold hover:underline">@{{ section.settings.handle }}</a>
  </div>

  <!-- Feed Grid -->
  <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 w-full">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="relative aspect-square group overflow-hidden bg-neutral-100" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | img_url: '400x400', crop: 'center' }}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy">
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'w-full h-full text-neutral-300' }}
        {%- endif -%}
        <!-- Hover Overlay -->
        <div class="absolute inset-0 bg-[var(--color-text)]/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center text-[var(--color-background)]">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </div>
      </a>
    {%- endfor -%}
  </div>

  <!-- Standard Footer Links Base -->
  <div class="py-12 px-6 border-t border-[var(--color-border)] flex flex-col md:flex-row justify-between items-center gap-6">
    <div class="flex gap-6 font-bold uppercase tracking-widest text-xs">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}" class="hover:text-[var(--color-accent, #ff0000)] transition-colors">{{ link.title }}</a>
      {%- endfor -%}
    </div>
    <div class="text-sm text-[var(--color-text-secondary)]">
      &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}.
    </div>
  </div>

</footer>

{% schema %}
{
  "name": "Footer - Social Feed",
  "settings": [
    {
      "type": "text",
      "id": "feed_title",
      "label": "Feed Heading",
      "default": "Shop Our Instagram"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Social Handle",
      "default": "yourbrand"
    },
    {
      "type": "url",
      "id": "social_link",
      "label": "Profile Link"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Bottom Menu",
      "default": "footer"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Social Image",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (e.g. to Product)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer - Social Feed",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
