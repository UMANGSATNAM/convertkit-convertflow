<div class="sf-materials sf-ms-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-ms-container">
    <div class="sf-ms-header">
      <h2 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
      <p style="color: {{ section.settings.text_color }};">{{ section.settings.subtitle }}</p>
    </div>
    
    <div class="sf-ms-grid">
      {% for block in section.blocks %}
        <div class="sf-ms-item">
          <div class="sf-ms-img">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '400x400', crop: 'center' }}" alt="{{ block.settings.title }}">
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'sf-placeholder' }}
            {% endif %}
          </div>
          <div class="sf-ms-info" style="background: {{ section.settings.card_bg }};">
            <h3 style="color: {{ section.settings.text_color }};">{{ block.settings.title }}</h3>
            <p style="color: {{ section.settings.text_color }};">{{ block.settings.text }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .sf-ms-{{ section.id }} { padding: 5rem 1rem; }
  .sf-ms-container { max-width: 1400px; margin: 0 auto; text-align: center; }
  .sf-ms-header { margin-bottom: 4rem; }
  .sf-ms-header h2 { font-size: 2.5rem; margin-bottom: 1rem; }
  .sf-ms-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  @media (min-width: 768px) { .sf-ms-grid { grid-template-columns: repeat({{ section.blocks.size | at_most: 3 }}, 1fr); gap: 3rem; } }
  .sf-ms-item { display: flex; flex-direction: column; text-align: left; }
  .sf-ms-img { width: 100%; aspect-ratio: 1; border-radius: 50%; overflow: hidden; margin-bottom: -50px; z-index: 2; position: relative; border: 10px solid {{ section.settings.bg_color }}; }
  .sf-ms-img img, .sf-placeholder { width: 100%; height: 100%; object-fit: cover; }
  .sf-ms-info { padding: 4rem 2rem 2rem; border-radius: 16px; flex: 1; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
  .sf-ms-info h3 { font-size: 1.5rem; margin-bottom: 1rem; font-weight: bold; }
  .sf-ms-info p { opacity: 0.8; line-height: 1.6; }
</style>

{% schema %}
{
  "name": "Materials Showcase",
  "max_blocks": 3,
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f9f9f9" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111111" },
    { "type": "text", "id": "title", "label": "Title", "default": "Quality Materials" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "We source only the finest materials for our products." }
  ],
  "blocks": [
    {
      "type": "material", "name": "Material",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Organic Cotton" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Breathable, sustainable, and incredibly soft." }
      ]
    }
  ],
  "presets": [ { "name": "Materials Showcase", "category": "Story", "blocks": [{"type":"material"},{"type":"material"}] } ]
}
{% endschema %}
