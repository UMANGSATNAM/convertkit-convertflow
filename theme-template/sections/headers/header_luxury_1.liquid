<div class="luxury-header" style="background-color: #0a0a0a; color: #fdfdfd; padding: 20px 40px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
  <div class="header-nav" style="font-family: var(--fontBody, 'Inter', sans-serif); font-size: 13px; letter-spacing: 1px; text-transform: uppercase;">
    <a href="/collections/all" style="color: #fdfdfd; text-decoration: none; margin-right: 20px;">Shop</a>
    <a href="/pages/about" style="color: #fdfdfd; text-decoration: none;">Atelier</a>
  </div>
  <div class="header-logo" style="font-family: var(--fontHeading, 'Playfair Display', serif); font-size: 28px; letter-spacing: 2px;">
    {{ shop.name | default: 'Maison' }}
  </div>
  <div class="header-actions" style="font-family: var(--fontBody, 'Inter', sans-serif); font-size: 13px; letter-spacing: 1px; text-transform: uppercase;">
    <a href="/cart" style="color: #fdfdfd; text-decoration: none;">Cart ({{ cart.item_count }})</a>
  </div>
</div>

{% schema %}
{
  "name": "Luxury Header",
  "settings": []
}
{% endschema %}
