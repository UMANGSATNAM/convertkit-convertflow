<div class="minimal-header" style="background-color: #ffffff; color: #333333; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; border-bottom: none;">
  <div class="header-nav" style="font-family: var(--fontBody, 'Helvetica Neue', sans-serif); font-size: 14px; font-weight: 300; letter-spacing: 0.5px;">
    <a href="/collections/all" style="color: #555555; text-decoration: none; margin-right: 25px;">Shop</a>
    <a href="/pages/about" style="color: #555555; text-decoration: none;">Story</a>
  </div>
  <div class="header-logo" style="font-family: var(--fontHeading, 'Helvetica Neue', sans-serif); font-size: 22px; font-weight: 500; letter-spacing: 1px;">
    {{ shop.name | default: 'Essence' }}
  </div>
  <div class="header-actions" style="font-family: var(--fontBody, 'Helvetica Neue', sans-serif); font-size: 14px; font-weight: 300;">
    <a href="/cart" style="color: #555555; text-decoration: none;">Cart ({{ cart.item_count }})</a>
  </div>
</div>

{% schema %}
{
  "name": "Minimal Header",
  "settings": []
}
{% endschema %}
