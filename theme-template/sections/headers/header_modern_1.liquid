<div class="modern-header" style="background-color: var(--color-background); color: var(--color-background); padding: 20px 40px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid color-mix(in srgb, var(--color-background) 5%, transparent); backdrop-filter: blur(10px);">
  <div class="header-nav" style="font-family: var(--font-body, 'Inter', sans-serif); font-size: 15px; font-weight: 500; display: flex; gap: 30px;">
    <a href="/collections/all" style="color: var(--color-text-secondary); text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='var(--color-text-secondary)'">Products</a>
    <a href="/pages/technology" style="color: var(--color-text-secondary); text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='var(--color-text-secondary)'">Technology</a>
  </div>
  <div class="header-logo" style="font-family: var(--font-heading, 'Space Grotesk', sans-serif); font-size: 24px; font-weight: 700; background: linear-gradient(90deg, var(--color-accent), var(--color-accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
    {{ shop.name | default: 'Nexus' }}
  </div>
  <div class="header-actions" style="font-family: var(--font-body, 'Inter', sans-serif); font-size: 15px; font-weight: 500;">
    <a href="/cart" style="color: var(--color-background); text-decoration: none; background: color-mix(in srgb, var(--color-background) 10%, transparent); padding: 8px 16px; border-radius: var(--radius-card, 8px);">Cart ({{ cart.item_count }})</a>
  </div>
</div>

{% schema %}
{
  "name": "Modern Header",
  "settings": []
}
{% endschema %}
