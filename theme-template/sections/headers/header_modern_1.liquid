<div class="modern-header" style="background-color: #0f1115; color: #ffffff; padding: 20px 40px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px);">
  <div class="header-nav" style="font-family: var(--fontBody, 'Inter', sans-serif); font-size: 15px; font-weight: 500; display: flex; gap: 30px;">
    <a href="/collections/all" style="color: #a1a1aa; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a1a1aa'">Products</a>
    <a href="/pages/technology" style="color: #a1a1aa; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a1a1aa'">Technology</a>
  </div>
  <div class="header-logo" style="font-family: var(--fontHeading, 'Space Grotesk', sans-serif); font-size: 24px; font-weight: 700; background: linear-gradient(90deg, #3b82f6, #8b5cf6); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
    {{ shop.name | default: 'Nexus' }}
  </div>
  <div class="header-actions" style="font-family: var(--fontBody, 'Inter', sans-serif); font-size: 15px; font-weight: 500;">
    <a href="/cart" style="color: #ffffff; text-decoration: none; background: rgba(255,255,255,0.1); padding: 8px 16px; border-radius: var(--radius, 8px);">Cart ({{ cart.item_count }})</a>
  </div>
</div>

{% schema %}
{
  "name": "Modern Header",
  "settings": []
}
{% endschema %}
