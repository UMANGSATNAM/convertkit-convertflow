<div class="sf-founder sf-fm-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="sf-fm-container">
    <div class="sf-fm-image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: '600x600', crop: 'center' }}" alt="Founder">
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'sf-placeholder' }}
      {% endif %}
    </div>
    <div class="sf-fm-content">
      <h2 style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
      <blockquote style="color: {{ section.settings.text_color }};">
        "{{ section.settings.quote }}"
      </blockquote>
      <div class="sf-fm-author">
        <strong style="color: {{ section.settings.text_color }};">{{ section.settings.author_name }}</strong>
        <span style="color: {{ section.settings.text_color }};">{{ section.settings.author_title }}</span>
      </div>
      {% if section.settings.signature != blank %}
        <div class="sf-fm-signature">
          <img src="{{ section.settings.signature | img_url: 'master' }}" alt="Signature">
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .sf-fm-{{ section.id }} { padding: 6rem 1rem; }
  .sf-fm-container { max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; gap: 3rem; align-items: center; }
  @media (min-width: 768px) { .sf-fm-container { flex-direction: row; gap: 5rem; } }
  .sf-fm-image { flex: 0 0 350px; width: 100%; max-width: 350px; }
  .sf-fm-image img, .sf-fm-image .sf-placeholder { width: 100%; aspect-ratio: 1; border-radius: 50%; object-fit: cover; box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
  .sf-fm-content { flex: 1; text-align: center; }
  @media (min-width: 768px) { .sf-fm-content { text-align: left; } }
  .sf-fm-content h2 { font-size: 1.2rem; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 2rem; opacity: 0.6; }
  .sf-fm-content blockquote { font-size: 1.8rem; line-height: 1.5; font-style: italic; margin: 0 0 2rem 0; font-family: Georgia, serif; position: relative; }
  .sf-fm-author strong { display: block; font-size: 1.2rem; }
  .sf-fm-author span { opacity: 0.7; font-size: 0.9rem; }
  .sf-fm-signature { margin-top: 2rem; }
  .sf-fm-signature img { max-width: 150px; }
</style>

{% schema %}
{
  "name": "Founder Message",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fafafa" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111111" },
    { "type": "image_picker", "id": "image", "label": "Founder Image" },
    { "type": "text", "id": "title", "label": "Eyebrow Text", "default": "A message from our founder" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "We started this journey to redefine what it means to create truly exceptional products for everyday people." },
    { "type": "text", "id": "author_name", "label": "Founder Name", "default": "Jane Doe" },
    { "type": "text", "id": "author_title", "label": "Founder Title", "default": "Founder & CEO" },
    { "type": "image_picker", "id": "signature", "label": "Signature Image (Optional)" }
  ],
  "presets": [ { "name": "Founder Message", "category": "Story" } ]
}
{% endschema %}
