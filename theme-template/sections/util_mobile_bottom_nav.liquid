<div class="sf-mobnav sf-mobnav-{{ section.id }}" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="sf-mobnav-container">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="sf-mobnav-item {% if request.path == block.settings.link %}is-active{% endif %}">
        <span class="sf-mobnav-icon">{{ block.settings.icon }}</span>
        <span class="sf-mobnav-label">{{ block.settings.label }}</span>
      </a>
    {% endfor %}
  </div>
</div>

<style>
  .sf-mobnav-{{ section.id }} { display: none; position: fixed; bottom: 0; left: 0; width: 100%; z-index: 9998; border-top: 1px solid rgba(0,0,0,0.1); padding-bottom: env(safe-area-inset-bottom); box-shadow: 0 -5px 20px rgba(0,0,0,0.05); }
  @media (max-width: 767px) { .sf-mobnav-{{ section.id }} { display: block; } }
  
  .sf-mobnav-container { display: flex; justify-content: space-around; align-items: center; height: 60px; }
  
  .sf-mobnav-item { display: flex; flex-direction: column; align-items: center; justify-content: center; text-decoration: none; color: inherit; opacity: 0.6; transition: opacity 0.3s; flex: 1; height: 100%; }
  .sf-mobnav-item.is-active { opacity: 1; }
  
  .sf-mobnav-icon { font-size: 1.5rem; margin-bottom: 2px; }
  .sf-mobnav-label { font-size: 0.65rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
</style>

{% schema %}
{
  "name": "Mobile Bottom Nav",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111111" }
  ],
  "blocks": [
    {
      "type": "link", "name": "Nav Item",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Home" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "icon", "label": "Emoji Icon", "default": "🏠" }
      ]
    }
  ],
  "presets": [ { "name": "Mobile Bottom Nav", "category": "Utilities", "blocks": [{"type":"link"},{"type":"link"},{"type":"link"},{"type":"link"}] } ]
}
{% endschema %}
