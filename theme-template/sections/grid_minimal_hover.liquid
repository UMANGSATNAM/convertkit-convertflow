<div class="sf-mh-grid sf-mh-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  {% if section.settings.title != blank %}
    <h2 class="sf-mh-title" style="color: {{ section.settings.text_color }};">{{ section.settings.title }}</h2>
  {% endif %}
  <div class="sf-mh-container">
    {% for product in collections[section.settings.collection].products limit: section.settings.product_limit %}
      <div class="sf-mh-item">
        <a href="{{ product.url }}" class="sf-mh-img-wrap">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}" class="sf-mh-main-img" loading="lazy">
            {% if product.images.size > 1 %}
              <img src="{{ product.images[1] | img_url: '400x' }}" alt="{{ product.title }} Alt" class="sf-mh-hover-img" loading="lazy">
            {% endif %}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'sf-placeholder' }}
          {% endif %}
          
          <div class="sf-mh-quick-add">
            {% form 'product', product %}
              <input type="hidden" name="id" value="{{ product.variants.first.id }}">
              <button type="submit" class="sf-mh-btn">Add to Cart</button>
            {% endform %}
          </div>
        </a>
        <div class="sf-mh-info">
          <h3><a href="{{ product.url }}" style="color: {{ section.settings.text_color }};">{{ product.title }}</a></h3>
          <p style="color: {{ section.settings.text_color }};">{{ product.price | money }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .sf-mh-{{ section.id }} { padding: 4rem 1rem; max-width: 1400px; margin: 0 auto; text-align: center; }
  .sf-mh-title { font-size: 2rem; margin-bottom: 3rem; font-weight: 300; letter-spacing: 2px; text-transform: uppercase; }
  .sf-mh-container { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem 1rem; }
  @media (min-width: 768px) { .sf-mh-container { grid-template-columns: repeat(4, 1fr); gap: 3rem 2rem; } }
  .sf-mh-item { text-align: left; }
  .sf-mh-img-wrap { display: block; position: relative; aspect-ratio: 3/4; overflow: hidden; background: var(--color-surface); margin-bottom: 1rem; }
  .sf-mh-img-wrap img, .sf-placeholder { width: 100%; height: 100%; object-fit: cover; transition: opacity 0.5s ease; position: absolute; top: 0; left: 0; }
  .sf-mh-hover-img { opacity: 0; }
  .sf-mh-item:hover .sf-mh-hover-img { opacity: 1; }
  .sf-mh-item:hover .sf-mh-main-img { opacity: 0; }
  .sf-mh-quick-add { position: absolute; bottom: 0; left: 0; width: 100%; padding: 1rem; transform: translateY(100%); transition: transform 0.3s ease; opacity: 0; z-index: 2; }
  .sf-mh-item:hover .sf-mh-quick-add { transform: translateY(0); opacity: 1; }
  .sf-mh-btn { width: 100%; background: var(--color-text); color: var(--color-background); border: none; padding: 12px; font-weight: bold; text-transform: uppercase; cursor: pointer; transition: background 0.3s; }
  .sf-mh-btn:hover { background: var(--color-text-secondary); }
  .sf-mh-info h3 { font-size: 1rem; margin: 0 0 0.25rem 0; font-weight: 500; }
  .sf-mh-info h3 a { text-decoration: none; }
  .sf-mh-info p { margin: 0; color: var(--color-text-secondary); }
</style>

{% schema %}
{
  "name": "Minimal Hover Grid",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#111111" },
    { "type": "text", "id": "title", "label": "Title", "default": "Latest Arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "min": 4, "max": 16, "step": 4, "label": "Product Limit", "default": 8 }
  ],
  "presets": [ { "name": "Minimal Hover Grid", "category": "Collection" } ]
}
{% endschema %}
