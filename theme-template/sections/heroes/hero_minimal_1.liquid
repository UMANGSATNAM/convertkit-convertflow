<div class="w-full min-h-[70vh] flex items-center justify-center bg-white px-6 py-20">
  <div class="max-w-3xl mx-auto flex flex-col items-center text-center">
    {% if section.settings.title != blank %}
      <h1 class="text-5xl md:text-6xl font-light text-gray-900 mb-6 tracking-tight">
        {{ section.settings.title }}
      </h1>
    {% endif %}
    
    {% if section.settings.text != blank %}
      <p class="text-lg md:text-xl text-gray-500 mb-10 font-normal max-w-xl mx-auto leading-relaxed">
        {{ section.settings.text }}
      </p>
    {% endif %}
    
    <div class="flex flex-col sm:flex-row gap-4">
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="px-8 py-3 bg-gray-900 text-white rounded-full hover:bg-gray-800 transition-colors text-sm font-medium">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
      {% if section.settings.secondary_button_label != blank %}
        <a href="{{ section.settings.secondary_button_link }}" class="px-8 py-3 bg-gray-100 text-gray-900 rounded-full hover:bg-gray-200 transition-colors text-sm font-medium">
          {{ section.settings.secondary_button_label }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.image != blank %}
      <div class="mt-16 w-full max-w-4xl mx-auto overflow-hidden rounded-2xl shadow-sm">
        <img 
          src="{{ section.settings.image | img_url: 'master' }}" 
          alt="{{ section.settings.image.alt | escape }}" 
          class="w-full h-auto object-cover"
          loading="lazy"
        >
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Minimal Hero",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Simplicity is the ultimate sophistication."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Thoughtfully designed essentials for everyday living."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Feature Image"
    }
  ],
  "presets": [
    {
      "name": "Minimal Hero",
      "category": "Hero"
    }
  ]
}
{% endschema %}
