<div class="banner-newsletter py-20 px-6 bg-[var(--color-surface, #f5f5f7)] flex justify-center items-center">
  <div class="max-w-4xl w-full bg-white rounded-3xl shadow-2xl overflow-hidden flex flex-col md:flex-row">
    
    <!-- Image Side -->
    <div class="w-full md:w-5/12 h-64 md:h-auto relative">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | img_url: 'master' }}" alt="Newsletter" class="absolute inset-0 w-full h-full object-cover">
      {%- else -%}
        <div class="absolute inset-0 bg-[var(--color-primary, #000)] flex items-center justify-center">
          <svg class="w-24 h-24 text-white/20" fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        </div>
      {%- endif -%}
    </div>

    <!-- Form Side -->
    <div class="w-full md:w-7/12 p-10 md:p-14 flex flex-col justify-center">
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-text, #111)] mb-4">{{ section.settings.title }}</h2>
      <p class="text-[var(--color-text-muted, #555)] mb-8 text-lg">{{ section.settings.text }}</p>

      {% form 'customer', class: 'flex flex-col gap-4 w-full' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        <div class="relative flex items-center w-full">
          <input 
            type="email" 
            name="contact[email]" 
            id="Email" 
            class="w-full px-6 py-4 rounded-full border border-gray-300 focus:outline-none focus:border-[var(--color-primary, #000)] focus:ring-1 focus:ring-[var(--color-primary, #000)] transition-all bg-gray-50"
            value="{% if customer %}{{ customer.email }}{% endif %}" 
            placeholder="Enter your email address" 
            required
          >
          <button type="submit" class="absolute right-2 px-6 py-2 bg-[var(--color-primary, #000)] text-white font-bold rounded-full hover:bg-opacity-90 transition-all uppercase tracking-wider text-sm">
            {{ section.settings.button_label }}
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <p class="text-green-600 text-sm mt-2 font-medium">Thanks for subscribing!</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="text-red-600 text-sm mt-2 font-medium">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        
        <p class="text-xs text-gray-400 mt-2 text-center">By subscribing, you agree to our Terms & Privacy Policy.</p>
      {% endform %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Newsletter Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Join the Club."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Sign up for exclusive offers, original stories, events and more."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Banner"
    }
  ]
}
{% endschema %}
