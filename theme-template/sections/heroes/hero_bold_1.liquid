<div class="relative w-full min-h-screen flex items-center bg-black overflow-hidden">
  {% if section.settings.image != blank %}
    <div class="absolute inset-0 w-full h-full mix-blend-overlay opacity-60">
      <img 
        src="{{ section.settings.image | img_url: 'master' }}" 
        alt="{{ section.settings.image.alt | escape }}" 
        class="w-full h-full object-cover object-center scale-105"
        loading="lazy"
      >
    </div>
  {% endif %}
  
  <div class="absolute inset-0 bg-gradient-to-t from-black via-black/80 to-transparent"></div>
  
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-8 flex flex-col items-start justify-end pb-24 md:pb-32 h-full pt-40">
    
    {% if section.settings.label != blank %}
      <div class="inline-block bg-white text-black font-black uppercase tracking-tighter px-4 py-1 text-sm md:text-base transform -skew-x-12 mb-6">
        {{ section.settings.label }}
      </div>
    {% endif %}

    {% if section.settings.title != blank %}
      <h1 class="text-6xl md:text-8xl lg:text-9xl font-black text-white uppercase tracking-tighter leading-[0.85] mb-6 drop-shadow-2xl">
        {{ section.settings.title }}
      </h1>
    {% endif %}

    {% if section.settings.text != blank %}
      <p class="text-xl md:text-2xl text-gray-300 font-bold max-w-2xl mb-10 leading-snug">
        {{ section.settings.text }}
      </p>
    {% endif %}

    <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto mt-auto sm:mt-0">
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="group relative inline-flex items-center justify-center px-8 py-4 font-black text-black bg-white uppercase tracking-widest overflow-hidden hover:scale-105 transition-transform">
          <span class="absolute w-0 h-0 transition-all duration-500 ease-out bg-red-600 rounded-full group-hover:w-56 group-hover:h-56"></span>
          <span class="relative group-hover:text-white transition-colors duration-300">{{ section.settings.button_label }}</span>
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bold Hero",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Highlight Label",
      "default": "LTD Edition"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Unapologetic."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The new drop is here. Limited stock, maximum impact."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Drop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Bold Hero",
      "category": "Hero"
    }
  ]
}
{% endschema %}
