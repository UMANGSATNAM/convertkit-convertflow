<div class="hero-video-wrapper relative w-full h-screen overflow-hidden bg-black flex items-center justify-center">
  {%- if section.settings.video_url != blank -%}
    <video 
      class="absolute top-0 left-0 w-full h-full object-cover opacity-70 z-0" 
      autoplay loop muted playsinline>
      <source src="{{ section.settings.video_url }}" type="video/mp4">
    </video>
  {%- else -%}
    <div class="absolute top-0 left-0 w-full h-full bg-neutral-900 z-0 flex items-center justify-center text-white/20">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'w-full h-full object-cover opacity-30' }}
    </div>
  {%- endif -%}

  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto flex flex-col items-center">
    {%- if section.settings.subheading != blank -%}
      <p class="text-sm md:text-base uppercase tracking-[0.2em] text-white/90 mb-4 font-semibold animate-fade-in-up">
        {{ section.settings.subheading }}
      </p>
    {%- endif -%}

    <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold text-white mb-6 leading-tight animate-fade-in-up" style="animation-delay: 100ms;">
      {{ section.settings.title | default: "Cinematic Experience" }}
    </h1>

    {%- if section.settings.text != blank -%}
      <p class="text-lg md:text-xl text-white/80 mb-10 max-w-2xl animate-fade-in-up" style="animation-delay: 200ms;">
        {{ section.settings.text }}
      </p>
    {%- endif -%}

    <div class="flex flex-col sm:flex-row gap-4 animate-fade-in-up" style="animation-delay: 300ms;">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="px-8 py-4 bg-white text-black font-semibold uppercase tracking-widest hover:bg-white/90 transition-colors duration-300">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 }}" class="px-8 py-4 bg-transparent border border-white text-white font-semibold uppercase tracking-widest hover:bg-white/10 transition-colors duration-300">
          {{ section.settings.button_label_2 }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}
.animate-fade-in-up {
  animation: fadeInUp 1s ease-out forwards;
  opacity: 0;
}
</style>

{% schema %}
{
  "name": "Video Background Hero",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (.mp4)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Immersive Brand Story"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "DISCOVER THE COLLECTION"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Visually stunning hero section designed to immediately capture attention."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary Button Label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Video Background Hero"
    }
  ]
}
{% endschema %}
