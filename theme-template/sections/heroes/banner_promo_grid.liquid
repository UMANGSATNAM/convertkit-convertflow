<div class="banner-promo-grid py-12 px-4 md:px-8 bg-[var(--color-background)]">
  <div class="max-w-7xl mx-auto">
    {%- if section.settings.title != blank -%}
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-10 text-[var(--color-text)]">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="group relative flex flex-col items-center justify-center p-8 bg-[var(--color-surface)] overflow-hidden transition-all hover:bg-[var(--color-text)] hover:text-[var(--color-background)]" {{ block.shopify_attributes }}>
          
          {%- if block.settings.icon != blank -%}
            <img src="{{ block.settings.icon | img_url: '100x' }}" class="w-12 h-12 mb-4 object-contain transition-transform group-hover:scale-110 group-hover:brightness-0 group-hover:invert" alt="{{ block.settings.title }}" loading="lazy">
          {%- else -%}
            <div class="w-12 h-12 mb-4 bg-[var(--color-text)]/10 rounded-full flex items-center justify-center group-hover:bg-[var(--color-background)]/20 transition-colors">
              <span class="text-xl">✨</span>
            </div>
          {%- endif -%}

          <h3 class="text-lg font-bold mb-2 uppercase tracking-wide transition-colors">{{ block.settings.title }}</h3>
          <p class="text-sm text-center opacity-80 group-hover:opacity-100 transition-colors">{{ block.settings.text }}</p>
          
          <!-- Animated Underline -->
          <span class="absolute bottom-0 left-0 w-full h-1 bg-[var(--color-accent, #ff0000)] scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-300"></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Promo Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Why Shop With Us?"
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "On all orders over $50"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo Grid",
      "blocks": [
        { "type": "promo" },
        { "type": "promo" },
        { "type": "promo" },
        { "type": "promo" }
      ]
    }
  ]
}
{% endschema %}
