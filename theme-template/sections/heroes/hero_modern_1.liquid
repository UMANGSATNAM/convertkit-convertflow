<div class="relative w-full overflow-hidden bg-[var(--color-surface)] pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pb-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      {% if section.settings.badge != blank %}
        <span class="inline-flex items-center rounded-full bg-blue-50 px-3 py-1 text-sm font-semibold text-[var(--color-accent)] ring-1 ring-inset ring-blue-600/20 mb-8">
          {{ section.settings.badge }}
        </span>
      {% endif %}

      {% if section.settings.title != blank %}
        <h1 class="text-4xl font-extrabold tracking-tight text-[var(--color-text-secondary)] sm:text-6xl bg-clip-text text-transparent bg-gradient-to-r from-gray-900 to-gray-600">
          {{ section.settings.title }}
        </h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="mt-6 text-lg leading-8 text-[var(--color-text-secondary)] max-w-xl mx-auto">
          {{ section.settings.text }}
        </p>
      {% endif %}

      <div class="mt-10 flex items-center justify-center gap-x-6">
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="rounded-lg bg-blue-600 px-6 py-3 text-sm font-semibold text-[var(--color-background)] shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-all">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
        {% if section.settings.secondary_link_label != blank %}
          <a href="{{ section.settings.secondary_link }}" class="text-sm font-semibold leading-6 text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors">
            {{ section.settings.secondary_link_label }} <span aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>
    </div>
    
    {% if section.settings.image != blank %}
      <div class="mt-16 sm:mt-24 w-full max-w-5xl mx-auto">
        <div class="rounded-xl bg-gray-900/5 p-2 ring-1 ring-inset ring-gray-900/10 lg:-m-4 lg:rounded-2xl lg:p-4 shadow-2xl">
          <img src="{{ section.settings.image | img_url: 'master' }}" 
            alt="{{ section.settings.image.alt | escape }}" 
            class="w-full rounded-md shadow-2xl ring-1 ring-gray-900/10"
            loading="lazy"
           fetchpriority="high">
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Modern Hero",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "New Release v2.0"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The future of smart technology."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Experience unparalleled performance and seamless integration with our latest product lineup."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button",
      "default": "Buy Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Link"
    },
    {
      "type": "text",
      "id": "secondary_link_label",
      "label": "Secondary Link Text",
      "default": "View features"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "App/Product Screenshot"
    }
  ],
  "presets": [
    {
      "name": "Modern Hero",
      "category": "Hero"
    }
  ]
}
{% endschema %}
