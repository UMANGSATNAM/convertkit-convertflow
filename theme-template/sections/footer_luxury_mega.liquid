{% comment %} Footer Luxury Mega — Dark, gold accents, newsletter, social icons, multi-column {% endcomment %}

<footer class="sf-lux sf-footer-luxury sf-fl-{{ section.id }}">

  {%- comment -%} Top gold rule {%- endcomment -%}
  <div class="sf-fl-top-border"></div>

  <div class="sf-fl-inner">

    {%- comment -%} Brand column {%- endcomment -%}
    <div class="sf-fl-brand">
      {% if section.settings.logo != blank %}
        <img class="sf-fl-logo" src="{{ section.settings.logo | img_url: '200x' }}" alt="{{ shop.name }}" width="140">
      {% else %}
        <p class="sf-fl-shop-name">{{ shop.name }}</p>
      {% endif %}
      <p class="sf-fl-tagline">{{ section.settings.tagline | default: 'Crafted for those who define their own legend.' }}</p>

      {%- comment -%} Social icons {%- endcomment -%}
      <div class="sf-fl-social">
        {% if section.settings.instagram != blank %}
          <a href="{{ section.settings.instagram }}" class="sf-fl-social-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          </a>
        {% endif %}
        {% if section.settings.facebook != blank %}
          <a href="{{ section.settings.facebook }}" class="sf-fl-social-link" aria-label="Facebook" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M18 2H15C13.5 2 12 3.5 12 5V8H9V12H12V22H16V12H19L20 8H16V5.5C16 5.2 16.2 5 16.5 5H20V2H18Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {% endif %}
        {% if section.settings.pinterest != blank %}
          <a href="{{ section.settings.pinterest }}" class="sf-fl-social-link" aria-label="Pinterest" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M12 8C10.3 8 9 9.3 9 11C9 12.2 9.7 13.2 10.7 13.7C10.6 14.2 10.4 14.8 10 16C11 15.5 11.5 14.5 11.8 13.8C12 13.9 12.2 14 12.5 14C14.2 14 15.5 12.7 15.5 11C15.5 9.3 14.2 8 12.5 8H12Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </a>
        {% endif %}
        {% if section.settings.youtube != blank %}
          <a href="{{ section.settings.youtube }}" class="sf-fl-social-link" aria-label="YouTube" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="2" y="5" width="20" height="14" rx="4" stroke="currentColor" stroke-width="1.5"/><path d="M10 9.5L15 12L10 14.5V9.5Z" fill="currentColor"/></svg>
          </a>
        {% endif %}
      </div>

      {%- comment -%} Certifications {%- endcomment -%}
      {% if section.settings.show_certs %}
        <div class="sf-fl-certs">
          <span class="sf-fl-cert">BIS Hallmarked</span>
          <span class="sf-fl-cert">ISO 9001</span>
          <span class="sf-fl-cert">Secured Checkout</span>
        </div>
      {% endif %}
    </div>

    {%- comment -%} Nav columns {%- endcomment -%}
    {% for block in section.blocks %}
      {% if block.type == 'nav_column' %}
        <div class="sf-fl-nav-col">
          <h4 class="sf-fl-nav-title">{{ block.settings.title }}</h4>
          <ul class="sf-fl-nav-list">
            {% assign links = linklists[block.settings.menu].links %}
            {% if links.size > 0 %}
              {% for link in links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              {% assign raw_links = block.settings.links | split: ',' %}
              {% for raw in raw_links %}
                <li><a href="#">{{ raw | strip }}</a></li>
              {% endfor %}
            {% endif %}
          </ul>
        </div>
      {% endif %}
    {% endfor %}

    {%- comment -%} Newsletter column {%- endcomment -%}
    <div class="sf-fl-newsletter">
      <h4 class="sf-fl-nav-title">{{ section.settings.newsletter_title | default: 'Join the Inner Circle' }}</h4>
      <p class="sf-fl-newsletter-desc">{{ section.settings.newsletter_desc | default: 'Be first to discover new collections, private sales, and jewellery care tips.' }}</p>
      {% form 'customer', class: 'sf-fl-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="sf-fl-input-wrap">
          <input type="email" name="contact[email]" placeholder="your@email.com" class="sf-fl-input" required aria-label="Email address">
          <button type="submit" class="sf-fl-submit" aria-label="Subscribe">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M0 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
        </div>
      {% endform %}
    </div>

  </div>

  {%- comment -%} Bottom bar {%- endcomment -%}
  <div class="sf-fl-bottom">
    <div class="sf-fl-bottom-inner">
      <p class="sf-fl-copy">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
        {{ section.settings.copy_suffix | default: 'All rights reserved. Crafted with care in India.' }}
      </p>
      <div class="sf-fl-bottom-links">
        {% if shop.privacy_policy != blank %}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{% endif %}
        {% if shop.terms_of_service != blank %}<a href="{{ shop.terms_of_service.url }}">Terms</a>{% endif %}
        {% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Returns</a>{% endif %}
      </div>
      {%- comment -%} Payment icons {%- endcomment -%}
      <div class="sf-fl-payments">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag: class: 'sf-fl-pay-icon' }}
        {% endfor %}
      </div>
    </div>
  </div>

</footer>

<style>
  .sf-fl-{{ section.id }} {
    background: var(--lux-bg);
    border-top: 1px solid var(--lux-border);
  }

  /* Top accent */
  .sf-fl-top-border {
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, var(--lux-gold-dk) 20%, var(--lux-gold) 50%, var(--lux-gold-dk) 80%, transparent 100%);
  }

  .sf-fl-inner {
    max-width: 1200px; margin: 0 auto;
    padding: 5rem 60px 4rem;
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr) 1.4fr;
    gap: 3rem;
  }
  @media (max-width: 1100px) { .sf-fl-inner { grid-template-columns: 1fr 1fr; gap: 2.5rem; padding: 3rem 30px; } }
  @media (max-width: 600px) { .sf-fl-inner { grid-template-columns: 1fr; gap: 2rem; padding: 2.5rem 20px; } }

  /* Brand */
  .sf-fl-logo { max-width: 140px; margin-bottom: 1.25rem; filter: brightness(0.9); }
  .sf-fl-shop-name {
    font-family: var(--font-serif); font-size: 1.4rem; color: var(--lux-cream);
    letter-spacing: 0.05em; margin-bottom: 1rem;
  }
  .sf-fl-tagline {
    font-size: 0.82rem; color: var(--lux-grey); line-height: 1.65;
    max-width: 240px; margin-bottom: 1.5rem;
  }

  /* Social */
  .sf-fl-social { display: flex; gap: 10px; margin-bottom: 1.5rem; }
  .sf-fl-social-link {
    width: 36px; height: 36px; border: 1px solid rgba(255,255,255,0.1);
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    color: var(--lux-grey); transition: color 0.3s, border-color 0.3s;
  }
  .sf-fl-social-link:hover { color: var(--lux-gold); border-color: rgba(201,168,76,0.4); }

  /* Certs */
  .sf-fl-certs { display: flex; flex-wrap: wrap; gap: 6px; }
  .sf-fl-cert {
    font-size: 0.58rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    padding: 4px 10px; border: 1px solid rgba(201,168,76,0.25); color: rgba(201,168,76,0.7);
    border-radius: 1px;
  }

  /* Nav columns */
  .sf-fl-nav-title {
    font-family: var(--font-sans); font-size: 0.65rem; font-weight: 600;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--lux-gold);
    margin-bottom: 1.25rem; padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(201,168,76,0.15);
  }
  .sf-fl-nav-list { list-style: none; }
  .sf-fl-nav-list li { margin-bottom: 0.75rem; }
  .sf-fl-nav-list a {
    font-size: 0.82rem; color: var(--lux-grey); line-height: 1.4;
    transition: color 0.3s, padding-left 0.3s;
  }
  .sf-fl-nav-list a:hover { color: var(--lux-cream); padding-left: 4px; }

  /* Newsletter */
  .sf-fl-newsletter-desc {
    font-size: 0.78rem; color: var(--lux-grey); line-height: 1.6; margin-bottom: 1.25rem;
  }
  .sf-fl-input-wrap { display: flex; border: 1px solid rgba(201,168,76,0.3); }
  .sf-fl-input {
    flex: 1; background: transparent; border: none; outline: none;
    padding: 11px 14px; font-family: var(--font-sans); font-size: 0.8rem;
    color: var(--lux-cream); min-width: 0;
  }
  .sf-fl-input::placeholder { color: var(--lux-grey); }
  .sf-fl-submit {
    padding: 0 16px; background: var(--lux-gold); border: none; cursor: pointer;
    color: var(--lux-bg); transition: background 0.3s; display: flex; align-items: center;
  }
  .sf-fl-submit:hover { background: var(--lux-gold-lt); }

  /* Bottom bar */
  .sf-fl-bottom {
    border-top: 1px solid rgba(255,255,255,0.05);
    padding: 1.25rem 0;
  }
  .sf-fl-bottom-inner {
    max-width: 1200px; margin: 0 auto; padding: 0 60px;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
  }
  @media (max-width: 768px) { .sf-fl-bottom-inner { padding: 0 20px; flex-direction: column; text-align: center; } }

  .sf-fl-copy { font-size: 0.72rem; color: rgba(136,133,128,0.6); }
  .sf-fl-bottom-links { display: flex; gap: 1.25rem; }
  .sf-fl-bottom-links a { font-size: 0.72rem; color: rgba(136,133,128,0.6); transition: color 0.3s; }
  .sf-fl-bottom-links a:hover { color: var(--lux-gold); }

  .sf-fl-payments { display: flex; gap: 8px; align-items: center; }
  .sf-fl-pay-icon { height: 20px; filter: brightness(0.5) saturate(0); transition: filter 0.3s; }
  .sf-fl-pay-icon:hover { filter: brightness(1) saturate(1); }
</style>

{% schema %}
{
  "name": "Footer — Luxury Mega",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Brand Logo" },
    { "type": "textarea", "id": "tagline", "label": "Brand Tagline" },
    { "type": "text", "id": "newsletter_title", "label": "Newsletter Heading", "default": "Join the Inner Circle" },
    { "type": "textarea", "id": "newsletter_desc", "label": "Newsletter Description" },
    { "type": "text", "id": "copy_suffix", "label": "Copyright Suffix" },
    { "type": "header", "content": "Social Links" },
    { "type": "url", "id": "instagram", "label": "Instagram URL" },
    { "type": "url", "id": "facebook", "label": "Facebook URL" },
    { "type": "url", "id": "pinterest", "label": "Pinterest URL" },
    { "type": "url", "id": "youtube", "label": "YouTube URL" },
    { "type": "checkbox", "id": "show_certs", "label": "Show Certification Badges", "default": true }
  ],
  "blocks": [
    {
      "name": "Nav Column",
      "type": "nav_column",
      "settings": [
        { "type": "text", "id": "title", "label": "Column Title", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Navigation Menu" },
        { "type": "textarea", "id": "links", "label": "Or enter links manually (comma separated)", "info": "Only used if no menu is selected above" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Footer — Luxury Mega", "category": "Footer" }]
}
{% endschema %}
