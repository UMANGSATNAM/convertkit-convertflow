<section style="padding: 60px 20px; max-width: 1200px; margin: 0 auto;">
  <h2 style="text-align: center; margin-bottom: 40px; font-size: 2em; text-transform: uppercase;">{{ section.settings.title | default: "Featured Collection" }}</h2>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 30px;">
    {% for product in collections[section.settings.collection].products limit: 6 %}
      <div class="product-card" style="text-align: center;">
        <img src="{{ product.featured_image | img_url: '400x500', crop: 'center' }}" alt="{{ product.title }}" style="width: 100%; object-fit: cover; margin-bottom: 15px;" />
        <h3 style="margin: 0 0 10px 0; font-size: 1.1em; font-weight: normal;">{{ product.title }}</h3>
        <p style="margin: 0; font-weight: bold;">{{ product.price | money }}</p>
      </div>
    {% else %}
      <p style="text-align: center; grid-column: 1 / -1;">Please select a collection.</p>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Fashion Grid 1",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Fashion Grid 1"
    }
  ]
}
{% endschema %}
