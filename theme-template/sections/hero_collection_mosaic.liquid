<div class="sf-mosaic sf-mosaic-{{ section.id }}">
  <div class="sf-mosaic-grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="sf-mosaic-item sf-mosaic-item-{{ forloop.index }}">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.title }}" fetchpriority="high">
        {% else %}
          {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'sf-placeholder' }}
        {% endif %}
        <div class="sf-mosaic-overlay">
          <h3>{{ block.settings.title }}</h3>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

<style>
  .sf-mosaic-{{ section.id }} { width: 100%; padding: 1rem; box-sizing: border-box; max-width: 1400px; margin: 0 auto; }
  .sf-mosaic-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; height: auto; }
  @media (min-width: 768px) {
    .sf-mosaic-grid { grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(2, 250px); }
    .sf-mosaic-item-1 { grid-column: 1 / 3; grid-row: 1 / 3; }
    .sf-mosaic-item-2 { grid-column: 3 / 5; grid-row: 1 / 2; }
    .sf-mosaic-item-3 { grid-column: 3 / 4; grid-row: 2 / 3; }
    .sf-mosaic-item-4 { grid-column: 4 / 5; grid-row: 2 / 3; }
  }
  .sf-mosaic-item { position: relative; overflow: hidden; border-radius: 8px; text-decoration: none; min-height: 250px; }
  .sf-mosaic-item img, .sf-placeholder { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .sf-mosaic-item:hover img { transform: scale(1.05); }
  .sf-mosaic-overlay { position: absolute; inset: 0; background: color-mix(in srgb, var(--color-text) 30%, transparent); display: flex; align-items: center; justify-content: center; }
  .sf-mosaic-overlay h3 { color: white; font-size: 2rem; text-transform: uppercase; letter-spacing: 2px; text-shadow: 0 2px 4px color-mix(in srgb, var(--color-text) 50%, transparent); margin: 0; }
</style>

{% schema %}
{
  "name": "Collection Mosaic",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "collection", "name": "Collection Box",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Shop Men" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "Collection Mosaic", "category": "Hero" } ]
}
{% endschema %}
