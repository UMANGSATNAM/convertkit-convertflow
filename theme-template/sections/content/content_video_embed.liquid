<div class="content-video-embed py-20 px-6 bg-[var(--color-bg, #111)] text-white">
  <div class="max-w-7xl mx-auto">
    {%- if section.settings.title != blank -%}
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-5xl font-bold">{{ section.settings.title }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="text-lg text-white/70 mt-4">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="relative w-full aspect-video rounded-2xl overflow-hidden shadow-2xl bg-black group cursor-pointer" id="video-container-{{ section.id }}">
      
      <!-- Video Poster Cover -->
      <div class="absolute inset-0 z-10 transition-opacity duration-500" id="video-cover-{{ section.id }}">
        {%- if section.settings.cover_image != blank -%}
          <img src="{{ section.settings.cover_image | img_url: 'master' }}" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity">
        {%- else -%}
          <div class="w-full h-full bg-neutral-800">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'w-full h-full object-cover opacity-40' }}
          </div>
        {%- endif -%}
        
        <!-- Play Button -->
        <div class="absolute inset-0 flex items-center justify-center">
          <button class="w-20 h-20 md:w-24 md:h-24 bg-white/20 backdrop-blur-md border border-white/40 rounded-full flex items-center justify-center text-white group-hover:scale-110 group-hover:bg-white group-hover:text-black transition-all duration-300">
            <svg class="w-10 h-10 ml-2" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </div>
      </div>

      <!-- Video iframe (loaded on click) -->
      <div class="absolute inset-0 z-0" id="video-frame-wrapper-{{ section.id }}">
        <!-- JS will inject iframe here -->
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const container = document.getElementById('video-container-{{ section.id }}');
  const cover = document.getElementById('video-cover-{{ section.id }}');
  const frameWrapper = document.getElementById('video-frame-wrapper-{{ section.id }}');
  
  if (!container) return;

  const videoUrl = "{{ section.settings.video_url }}";
  
  // Basic parsing for Youtube or Vimeo
  let embedUrl = "";
  if (videoUrl.includes('youtube.com') || videoUrl.includes('youtu.be')) {
    const videoId = videoUrl.split('v=')[1] || videoUrl.split('/').pop();
    const ampersandPosition = videoId.indexOf('&');
    const finalId = ampersandPosition !== -1 ? videoId.substring(0, ampersandPosition) : videoId;
    embedUrl = `https://www.youtube.com/embed/${finalId}?autoplay=1&mute=0`;
  } else if (videoUrl.includes('vimeo.com')) {
    const videoId = videoUrl.split('/').pop();
    embedUrl = `https://player.vimeo.com/video/${videoId}?autoplay=1`;
  } else {
    // MP4 fallback
    embedUrl = videoUrl;
  }

  container.addEventListener('click', () => {
    if (cover.style.opacity === '0') return; // already playing
    
    cover.style.opacity = '0';
    setTimeout(() => { cover.style.display = 'none'; }, 500);

    if (embedUrl.includes('youtube') || embedUrl.includes('vimeo')) {
      frameWrapper.innerHTML = `<iframe src="${embedUrl}" class="w-full h-full border-0" allow="autoplay; fullscreen" allowfullscreen></iframe>`;
    } else {
      frameWrapper.innerHTML = `<video src="${embedUrl}" class="w-full h-full object-cover" controls autoplay></video>`;
    }
  });
});
</script>

{% schema %}
{
  "name": "Video Embed",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "See it in action"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Watch our campaign video."
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover Image"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (YouTube/Vimeo/MP4)",
      "default": "https://www.youtube.com/watch?v=_9VUPq31cC8"
    }
  ],
  "presets": [
    {
      "name": "Video Embed"
    }
  ]
}
{% endschema %}
