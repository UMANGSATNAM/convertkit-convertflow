<div class="content-features-grid py-20 px-6 bg-[var(--color-bg, #f9f9f9)]">
  <div class="max-w-7xl mx-auto">
    {%- if section.settings.title != blank -%}
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-[var(--color-text, #111)]">{{ section.settings.title }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="text-lg text-[var(--color-text-muted, #555)] mt-4 max-w-2xl mx-auto">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-{{ section.settings.columns_desktop | default: 3 }} gap-8 lg:gap-12">
      {%- for block in section.blocks -%}
        <div class="feature-card group flex flex-col items-center text-center p-8 bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100" {{ block.shopify_attributes }}>
          
          <div class="w-16 h-16 rounded-full bg-[var(--color-primary, #000)]/5 flex items-center justify-center mb-6 group-hover:bg-[var(--color-primary, #000)] transition-colors duration-300">
            {%- if block.settings.icon != blank -%}
              <img src="{{ block.settings.icon | img_url: '100x' }}" alt="{{ block.settings.title }}" class="w-8 h-8 object-contain group-hover:invert transition-all">
            {%- else -%}
              <svg class="w-8 h-8 text-[var(--color-primary, #000)] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            {%- endif -%}
          </div>

          <h3 class="text-xl font-bold text-[var(--color-text, #111)] mb-3">{{ block.settings.title | default: "Feature Title" }}</h3>
          <p class="text-[var(--color-text-muted, #555)] leading-relaxed">{{ block.settings.text | default: "Highlight a key benefit or feature of your product or brand here." }}</p>
          
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Features Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Why Choose Us"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "We pride ourselves on delivering the best experience."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Quality"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Crafted with the finest materials for ultimate durability."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features Grid",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
