<div class="content-rich-text py-20 px-6 bg-[var(--color-background)]">
  <div class="mx-auto text-center" style="max-w: {{ section.settings.max_width }}px;">
    
    {%- if section.settings.badge != blank -%}
      <p class="text-sm font-bold uppercase tracking-widest text-[var(--color-accent, #ff0000)] mb-6">{{ section.settings.badge }}</p>
    {%- endif -%}

    <h2 class="text-3xl md:text-5xl lg:text-6xl font-black text-[var(--color-text)] mb-8 leading-tight">
      {{ section.settings.title }}
    </h2>

    {%- if section.settings.text != blank -%}
      <div class="prose prose-lg md:prose-xl mx-auto text-[var(--color-text-muted, #555)] font-light leading-relaxed mb-10">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="inline-block px-10 py-4 bg-[var(--color-text)] text-[var(--color-background)] font-bold uppercase tracking-widest hover:-translate-y-1 transition-transform shadow-lg rounded">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Rich Text",
  "settings": [
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1200,
      "step": 100,
      "default": 800,
      "label": "Content Max Width (px)"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Our Mission"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Redefining the standard of modern retail."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe in quality over quantity. Our products are designed to last, crafted by artisans who care about the details as much as you do.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Rich Text"
    }
  ]
}
{% endschema %}
