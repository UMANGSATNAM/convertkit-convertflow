<div class="content-brand-story py-24 px-6 overflow-hidden bg-[var(--color-background)] relative">
  <!-- Decorative Text Background -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full text-center overflow-hidden pointer-events-none select-none z-0">
    <span class="text-[15vw] font-black text-neutral-50 whitespace-nowrap opacity-50">{{ section.settings.bg_text | default: "OUR STORY" }}</span>
  </div>

  <div class="max-w-7xl mx-auto relative z-10 flex flex-col {% if section.settings.image_alignment == 'right' %}md:flex-row{% else %}md:flex-row-reverse{% endif %} items-center gap-16">
    
    <!-- Text Content -->
    <div class="w-full md:w-1/2 flex flex-col justify-center">
      {%- if section.settings.badge != blank -%}
        <span class="text-sm font-bold uppercase tracking-widest text-[var(--color-accent, #ff0000)] mb-4 block">{{ section.settings.badge }}</span>
      {%- endif -%}
      
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-[var(--color-text)] mb-8 leading-[1.1]">{{ section.settings.title }}</h2>
      
      <div class="prose prose-lg text-[var(--color-text-muted, #444)] mb-10 leading-relaxed space-y-6">
        {{ section.settings.text }}
      </div>
      
      {%- if section.settings.button_label != blank -%}
        <div>
          <a href="{{ section.settings.button_link }}" class="inline-block px-8 py-4 border-2 border-[var(--color-text)] text-[var(--color-text)] font-bold uppercase tracking-wider hover:bg-[var(--color-text)] hover:text-[var(--color-background)] transition-colors duration-300">
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}

      <!-- Founder Signature -->
      {%- if section.settings.show_signature -%}
        <div class="mt-12 pt-8 border-t border-[var(--color-border)] flex items-center gap-6">
          {%- if section.settings.founder_image != blank -%}
            <img src="{{ section.settings.founder_image | img_url: '100x100', crop: 'center' }}" alt="Founder" class="w-16 h-16 rounded-full object-cover" loading="lazy">
          {%- endif -%}
          <div>
            <p class="font-bold text-lg text-[var(--color-text)]">{{ section.settings.founder_name | default: "Jane Doe" }}</p>
            <p class="text-sm text-[var(--color-text-secondary)] uppercase tracking-widest">{{ section.settings.founder_title | default: "Founder & CEO" }}</p>
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- Main Image -->
    <div class="w-full md:w-1/2 relative">
      <div class="relative w-full aspect-[4/5] rounded-tl-[100px] rounded-br-[100px] overflow-hidden shadow-2xl">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | img_url: 'master' }}" alt="Brand Story" class="absolute inset-0 w-full h-full object-cover transform hover:scale-105 transition-transform duration-1000" loading="lazy">
        {%- else -%}
          <div class="absolute inset-0 bg-neutral-200">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'w-full h-full object-cover mix-blend-multiply opacity-50' }}
          </div>
        {%- endif -%}
      </div>
      
      <!-- Floating Element -->
      <div class="absolute -bottom-8 -left-8 md:-left-12 w-32 h-32 md:w-48 md:h-48 rounded-full border-8 border-white overflow-hidden shadow-xl animate-spin-slow">
        {%- if section.settings.floating_image != blank -%}
          <img src="{{ section.settings.floating_image | img_url: '300x300', crop: 'center' }}" class="w-full h-full object-cover" loading="lazy">
        {%- else -%}
          <div class="w-full h-full bg-[var(--color-text)] flex items-center justify-center text-[var(--color-background)] p-4 text-center">
            <span class="text-xs uppercase font-bold tracking-widest">Est. 2024</span>
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

<style>
@keyframes spin-slow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.animate-spin-slow {
  animation: spin-slow 20s linear infinite;
}
</style>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "select",
      "id": "image_alignment",
      "label": "Image Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "bg_text",
      "label": "Background Watermark Text",
      "default": "OUR STORY"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "The Heritage"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Crafted with passion, worn with pride."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Story Text",
      "default": "<p>It started with a simple idea: create pieces that don't just look good, but feel right. Every stitch, every detail is considered to bring you the highest quality possible.</p><p>We believe in sustainable practices and ethical sourcing, ensuring our impact is as positive as our designs.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Read More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "image_picker",
      "id": "floating_image",
      "label": "Floating Circular Image (Optional)"
    },
    {
      "type": "header",
      "content": "Founder Signature"
    },
    {
      "type": "checkbox",
      "id": "show_signature",
      "label": "Show Founder block",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "founder_image",
      "label": "Founder Image (Square)"
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "Founder Name"
    },
    {
      "type": "text",
      "id": "founder_title",
      "label": "Founder Title"
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
