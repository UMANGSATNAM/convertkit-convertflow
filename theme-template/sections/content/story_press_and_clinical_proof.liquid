{%- comment -%}
  Section: story_press_and_proof_proof
  Editorial press quotes + quantitative proof/efficacy proof.
  Staggered grid on desktop, swipeable single-column carousel on mobile.
  Niche-adaptive via theme CSS tokens with fallbacks.
  Rules: no ternary/pluralize/color_modify; static CSS in {% stylesheet %}.
{%- endcomment -%}

<style>
  #cfproof-{{ section.id }}{
    --cf-accent: var(--color-accent, #111111);
    --cf-bg: var(--color-background, #ffffff);
    --cf-text: var(--color-text, #15110b);
    --cf-heading: var(--font-heading-family, 'Inter', system-ui, sans-serif);
    --cf-card-radius: var(--card-radius, 12px);
    --cf-btn-radius: var(--button-radius, 0px);
    --cf-muted: color-mix(in srgb, var(--cf-text) 52%, transparent);
    --cf-line: color-mix(in srgb, var(--cf-text) 12%, transparent);
    --cf-soft: color-mix(in srgb, var(--cf-bg) 93%, var(--cf-text) 7%);
    --cf-accent-soft: color-mix(in srgb, var(--cf-accent) 9%, var(--cf-bg));
  }
  {%- if section.settings.bg_override != blank -%}#cfproof-{{ section.id }}{--cf-bg:{{ section.settings.bg_override }};}{%- endif -%}
</style>

<section class="cfproof" id="cfproof-{{ section.id }}">
  <div class="cfproof-wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="cfproof-head">
        {%- if section.settings.eyebrow != blank -%}<span class="cfproof-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="cfproof-title">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="cfproof-sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="cfproof-grid" data-cfproof-grid>
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'proof' -%}
            <article class="cfp-card cfp-proof" {{ block.shopify_attributes }}>
              <div class="cfp-stat">
                <span class="cfp-num" data-cfp-num data-target="{{ block.settings.stat_value }}">{{ block.settings.stat_value }}</span>
                <span class="cfp-unit">{{ block.settings.stat_unit }}</span>
              </div>
              {%- if block.settings.stat_label != blank -%}<p class="cfp-stat-label">{{ block.settings.stat_label }}</p>{%- endif -%}
              {%- if block.settings.footnote != blank -%}<p class="cfp-foot">{{ block.settings.footnote }}</p>{%- endif -%}
            </article>

          {%- when 'press' -%}
            <article class="cfp-card cfp-press" {{ block.shopify_attributes }}>
              <svg class="cfp-quote" viewBox="0 0 24 24" fill="currentColor"><path d="M9 11H6.5C6 11 6 10.8 6 10.3 6 7.9 7.5 6.4 9.7 6l.3 1.5C8.7 7.9 8 8.7 8 9.7H9c.6 0 1 .4 1 1v3c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1v-2zm9 0h-2.5c-.5 0-.5-.2-.5-.7 0-2.4 1.5-3.9 3.7-4.3l.3 1.5c-1.3.4-2 1.2-2 2.2h1c.6 0 1 .4 1 1v3c0 .6-.4 1-1 1h-2c-.6 0-1-.4-1-1v-2z"/></svg>
              <blockquote class="cfp-quote-text">{{ block.settings.quote }}</blockquote>
              <div class="cfp-press-meta">
                {%- if block.settings.logo != blank -%}
                  <img class="cfp-logo" src="{{ block.settings.logo | image_url: width: 200 }}" alt="{{ block.settings.source | escape }}" loading="lazy" width="200">
                {%- elsif block.settings.source != blank -%}
                  <span class="cfp-source">{{ block.settings.source }}</span>
                {%- endif -%}
                {%- if block.settings.rating != blank -%}<span class="cfp-rating">{{ block.settings.rating }}</span>{%- endif -%}
              </div>
            </article>

          {%- when 'logo_only' -%}
            <article class="cfp-card cfp-logoonly" {{ block.shopify_attributes }}>
              {%- if block.settings.logo != blank -%}
                <img src="{{ block.settings.logo | image_url: width: 220 }}" alt="{{ block.settings.source | escape }}" loading="lazy" width="220">
              {%- else -%}
                <span class="cfp-source">{{ block.settings.source }}</span>
              {%- endif -%}
            </article>

        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="cfproof-dots" data-cfproof-dots></div>
  </div>
</section>

{% stylesheet %}
.cfproof{background:var(--cf-bg);color:var(--cf-text);padding:64px 0;font-family:'Inter',system-ui,sans-serif}
.cfproof *{box-sizing:border-box}
.cfproof-wrap{max-width:1160px;margin:0 auto;padding:0 20px}
.cfproof-head{text-align:center;max-width:640px;margin:0 auto 44px}
.cfproof-eyebrow{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--cf-accent);margin-bottom:10px}
.cfproof-title{font-family:var(--cf-heading);font-size:34px;line-height:1.12;font-weight:700;margin:0}
.cfproof-sub{font-size:15px;color:var(--cf-muted);margin:12px 0 0;line-height:1.6}

.cfproof-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:18px;align-items:start}
.cfp-card{border-radius:var(--cf-card-radius);padding:28px;border:1px solid var(--cf-line);opacity:0;transform:translateY(22px);transition:opacity .6s ease,transform .6s cubic-bezier(.22,1,.36,1)}
.cfp-card.is-in{opacity:1;transform:none}

/* staggered spans + offsets on desktop */
.cfp-proof{grid-column:span 4;background:var(--cf-accent-soft);border-color:transparent;text-align:center}
.cfp-press{grid-column:span 8;background:var(--cf-soft)}
.cfp-logoonly{grid-column:span 4;background:var(--cf-bg);display:flex;align-items:center;justify-content:center;min-height:96px}
.cfproof-grid > .cfp-card:nth-child(3n+2){transform:translateY(40px)}
.cfproof-grid > .cfp-card:nth-child(3n+2).is-in{transform:none}

.cfp-stat{display:flex;align-items:baseline;justify-content:center;gap:4px;font-family:var(--cf-heading);color:var(--cf-accent)}
.cfp-num{font-size:54px;font-weight:800;line-height:1}
.cfp-unit{font-size:24px;font-weight:700}
.cfp-stat-label{font-size:14px;font-weight:600;margin:12px 0 0;line-height:1.4}
.cfp-foot{font-size:11px;color:var(--cf-muted);margin:8px 0 0}

.cfp-quote{width:30px;height:30px;color:var(--cf-accent);opacity:.5;margin-bottom:8px}
.cfp-quote-text{font-family:var(--cf-heading);font-size:21px;line-height:1.4;font-weight:500;margin:0;letter-spacing:-.01em}
.cfp-press-meta{display:flex;align-items:center;gap:12px;margin-top:18px;flex-wrap:wrap}
.cfp-logo{height:24px;width:auto;object-fit:contain;filter:saturate(.1)}
.cfp-source{font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--cf-text)}
.cfp-rating{font-size:12px;color:var(--cf-muted)}
.cfp-logoonly img{max-height:34px;width:auto;object-fit:contain;opacity:.75}

.cfproof-dots{display:none;justify-content:center;gap:7px;margin-top:20px}
.cfproof-dots button{width:7px;height:7px;border-radius:50%;border:none;background:var(--cf-line);cursor:pointer;padding:0;transition:.2s}
.cfproof-dots button.is-active{background:var(--cf-accent);width:20px;border-radius:99px}

@media(max-width:860px){
  .cfproof{padding:48px 0}
  .cfproof-title{font-size:26px}
  .cfproof-grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:14px;margin:0 -20px;padding:6px 20px 4px;-webkit-overflow-scrolling:touch}
  .cfproof-grid::-webkit-scrollbar{display:none}
  .cfp-card{flex:0 0 84%;scroll-snap-align:center;transform:none!important;opacity:1!important}
  .cfp-proof,.cfp-press,.cfp-logoonly{grid-column:auto}
  .cfp-quote-text{font-size:18px}
  .cfp-num{font-size:44px}
  .cfproof-dots{display:flex}
}
@media(prefers-reduced-motion:reduce){.cfp-card{transition:none}}
{% endstylesheet %}

<script>
(function(){
  var root = document.getElementById('cfproof-{{ section.id }}');
  if(!root || root.dataset.bound) return; root.dataset.bound='1';
  var grid = root.querySelector('[data-cfproof-grid]');
  var cards = Array.prototype.slice.call(root.querySelectorAll('.cfp-card'));

  /* scroll reveal + count-up (desktop) */
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if(!en.isIntersecting) return;
        en.target.classList.add('is-in');
        var numEl = en.target.querySelector('[data-cfp-num]');
        if(numEl && !numEl.dataset.done){ countUp(numEl); numEl.dataset.done='1'; }
        io.unobserve(en.target);
      });
    },{threshold:.25});
    cards.forEach(function(c){ io.observe(c); });
  } else { cards.forEach(function(c){ c.classList.add('is-in'); }); }

  function countUp(el){
    var raw = (el.dataset.target||'').toString();
    var num = parseFloat(raw.replace(/[^0-9.]/g,''));
    if(isNaN(num)){ return; }
    var dur = 1100, start = null, dec = (raw.indexOf('.')>-1)?1:0;
    function step(ts){
      if(!start) start = ts;
      var p = Math.min(1,(ts-start)/dur);
      var eased = 1-Math.pow(1-p,3);
      el.textContent = (num*eased).toFixed(dec);
      if(p<1) requestAnimationFrame(step); else el.textContent = num.toFixed(dec);
    }
    requestAnimationFrame(step);
  }

  /* mobile carousel dots */
  var dotsWrap = root.querySelector('[data-cfproof-dots]');
  function buildDots(){
    if(!dotsWrap || window.innerWidth > 860){ if(dotsWrap) dotsWrap.innerHTML=''; return; }
    dotsWrap.innerHTML='';
    cards.forEach(function(c,i){
      var b=document.createElement('button'); b.type='button'; if(i===0)b.className='is-active';
      b.addEventListener('click',function(){ c.scrollIntoView({behavior:'smooth',inline:'center',block:'nearest'}); });
      dotsWrap.appendChild(b);
    });
  }
  buildDots();
  if(grid){
    grid.addEventListener('scroll', function(){
      if(window.innerWidth>860 || !dotsWrap) return;
      var center = grid.scrollLeft + grid.offsetWidth/2;
      var best=0,bd=1e9;
      cards.forEach(function(c,i){ var d=Math.abs((c.offsetLeft+c.offsetWidth/2)-center); if(d<bd){bd=d;best=i;} });
      dotsWrap.querySelectorAll('button').forEach(function(b,i){ b.classList.toggle('is-active',i===best); });
    },{passive:true});
  }
  window.addEventListener('resize', buildDots);
})();
</script>

{% schema %}
{
  "name": "Press & proof Proof",
  "tag": "section",
  "class": "cf-proof-section",
  "settings": [
    {"type":"header","content":"Heading"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"The proof"},
    {"type":"text","id":"heading","label":"Heading","default":"Backed by results. Loved by press."},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"proofly validated efficacy and editorial acclaim — not just claims."},
    {"type":"header","content":"Style override (optional)"},
    {"type":"color","id":"bg_override","label":"Background override","info":"Leave blank to inherit --color-background."}
  ],
  "blocks":[
    {"type":"proof","name":"proof stat","settings":[
      {"type":"text","id":"stat_value","label":"Value","default":"94","info":"Numeric (animated count-up). Decimals supported."},
      {"type":"text","id":"stat_unit","label":"Unit","default":"%"},
      {"type":"text","id":"stat_label","label":"Label","default":"felt instant radiance after first use"},
      {"type":"text","id":"footnote","label":"Footnote","default":"*Based on a consumer study of 120 users over 4 weeks."}
    ]},
    {"type":"press","name":"Press quote","settings":[
      {"type":"textarea","id":"quote","label":"Quote","default":"A breakthrough you can actually feel — this is the standard now."},
      {"type":"image_picker","id":"logo","label":"Publication logo"},
      {"type":"text","id":"source","label":"Source name (if no logo)","default":"VOGUE"},
      {"type":"text","id":"rating","label":"Rating / credit","default":"Editor's Pick"}
    ]},
    {"type":"logo_only","name":"Logo only","settings":[
      {"type":"image_picker","id":"logo","label":"Logo"},
      {"type":"text","id":"source","label":"Name (if no logo)","default":"GQ"}
    ]}
  ],
  "presets":[{"name":"Press & proof Proof","blocks":[
    {"type":"proof","settings":{"stat_value":"94","stat_unit":"%","stat_label":"felt instant radiance after first use"}},
    {"type":"press","settings":{"quote":"A breakthrough you can actually feel — this is the new standard.","source":"VOGUE","rating":"Editor's Pick"}},
    {"type":"proof","settings":{"stat_value":"2.4","stat_unit":"x","stat_label":"more hydration vs. leading brand"}},
    {"type":"press","settings":{"quote":"Finally, a formula that does what it promises.","source":"GQ","rating":"Grooming Award"}}
  ]}]
}
{% endschema %}
