<div class="content-timeline py-24 px-6 bg-[var(--color-bg, #ffffff)]">
  <div class="max-w-4xl mx-auto">
    {%- if section.settings.title != blank -%}
      <h2 class="text-4xl font-black text-center mb-16 text-[var(--color-text, #111)]">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="relative border-l-2 border-[var(--color-primary, #000)] ml-4 md:ml-1/2 md:-translate-x-[1px] space-y-12">
      
      {%- for block in section.blocks -%}
        <!-- Alternating classes for Desktop -->
        <div class="timeline-item relative flex flex-col md:flex-row items-center justify-between w-full
          {% if forloop.index0 | modulo: 2 == 0 %} md:flex-row-reverse {% endif %}" 
          {{ block.shopify_attributes }}>
          
          <!-- Marker -->
          <div class="absolute left-0 md:left-1/2 w-4 h-4 rounded-full bg-[var(--color-accent, #ff0000)] border-4 border-white -translate-x-[9px] md:-translate-x-1/2 z-10 shadow"></div>
          
          <!-- Content Box -->
          <div class="w-full md:w-5/12 pl-8 md:pl-0">
            <div class="p-6 bg-[var(--color-surface, #f9f9f9)] rounded-xl border border-gray-100 hover:shadow-lg transition-shadow">
              <span class="text-[var(--color-primary, #000)] font-bold tracking-widest uppercase text-sm mb-2 block">{{ block.settings.year }}</span>
              <h3 class="text-xl font-bold mb-2">{{ block.settings.title }}</h3>
              <p class="text-[var(--color-text-muted, #555)]">{{ block.settings.text }}</p>
            </div>
          </div>
          
          <!-- Empty Space for Alignment -->
          <div class="hidden md:block w-5/12"></div>
        </div>
      {%- endfor -%}
      
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand Timeline",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our Journey"
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "Year/Date",
          "default": "2020"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The Beginning"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "We launched our first collection with a mission to change the industry."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Timeline",
      "blocks": [
        { "type": "milestone", "settings": {"year": "2020", "title": "The Beginning"} },
        { "type": "milestone", "settings": {"year": "2022", "title": "Global Expansion"} },
        { "type": "milestone", "settings": {"year": "2024", "title": "Sustainability Pledge"} }
      ]
    }
  ]
}
{% endschema %}
