<div class="content-logo-cloud py-12 px-6 border-y border-gray-100 bg-[var(--color-bg, #ffffff)]">
  <div class="max-w-7xl mx-auto">
    {%- if section.settings.title != blank -%}
      <p class="text-center text-sm font-bold uppercase tracking-widest text-[var(--color-text-muted, #555)] mb-8">{{ section.settings.title }}</p>
    {%- endif -%}

    <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-60">
      {%- for block in section.blocks -%}
        <div class="logo-item w-24 md:w-32 flex justify-center grayscale hover:grayscale-0 transition-all duration-300" {{ block.shopify_attributes }}>
          {%- if block.settings.logo != blank -%}
            <img src="{{ block.settings.logo | img_url: '300x' }}" alt="{{ block.settings.title }}" class="max-w-full h-auto object-contain max-h-12">
          {%- else -%}
            <div class="text-xl font-bold uppercase tracking-wider">{{ block.settings.title | default: "Brand" }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
      
      {%- if section.blocks.size == 0 -%}
        <div class="text-xl font-bold uppercase tracking-wider">Vogue</div>
        <div class="text-xl font-bold uppercase tracking-wider">GQ</div>
        <div class="text-xl font-bold uppercase tracking-wider">Forbes</div>
        <div class="text-xl font-bold uppercase tracking-wider">Hypebeast</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Logo Cloud",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "AS FEATURED IN"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Fallback Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Cloud",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
