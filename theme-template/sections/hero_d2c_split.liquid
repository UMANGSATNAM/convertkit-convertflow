<div class="sf-hero-split sf-hero-{{ section.id }}">
  <div class="sf-hero-split__content">
    <h1 class="sf-hero-split__title">{{ section.settings.title }}</h1>
    <p class="sf-hero-split__subtitle">{{ section.settings.subtitle }}</p>
    {% if section.settings.button_link != blank and section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link }}" class="sf-btn sf-btn--primary">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
  <div class="sf-hero-split__media">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | img_url: 'master' }}" alt="{{ section.settings.title }}" loading="lazy">
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'sf-placeholder-svg' }}
    {% endif %}
  </div>
</div>

<style>
  .sf-hero-{{ section.id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .sf-hero-split__content {
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .sf-hero-split__title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1rem;
    color: inherit;
  }
  .sf-hero-split__subtitle {
    font-size: 1.1rem;
    margin-bottom: 2rem;
    opacity: 0.9;
  }
  .sf-hero-split__media {
    width: 100%;
    min-height: 300px;
  }
  .sf-hero-split__media img, .sf-hero-split__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sf-btn {
    display: inline-block;
    padding: 12px 24px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: 4px;
    transition: transform 0.2s ease;
  }
  .sf-btn--primary {
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
  }
  .sf-btn--primary:hover {
    transform: translateY(-2px);
  }
  @media (min-width: 768px) {
    .sf-hero-{{ section.id }} {
      flex-direction: row;
      min-height: 80vh;
    }
    .sf-hero-split__content {
      width: 50%;
      padding: 4rem 10%;
    }
    .sf-hero-split__media {
      width: 50%;
    }
    .sf-hero-split__title {
      font-size: 3.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "D2C Split Hero",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Elevate Your Everyday"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Premium quality products designed for the modern lifestyle. Experience the difference today."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8f9fa"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "D2C Split Hero",
      "category": "Hero"
    }
  ]
}
{% endschema %}
