## 📐 PAGE SCHEMA — JSON BLOCK TREE

Every page is stored as a **JSON tree of blocks**. This is the core data structure.

```typescript
// Root Page Schema
interface PageSchema {
  version: "1.0";
  id: string;
  pageType: string;
  globalStyles: {
    fontFamily: string;
    primaryColor: string;
    secondaryColor: string;
    maxWidth: string;            // e.g., "1200px"
    containerPadding: string;   // e.g., "0 20px"
  };
  sections: Section[];         // Top-level sections (rows)
}

// A Section = full-width row container
interface Section {
  id: string;                  // unique block ID
  type: "section";
  settings: {
    background: BackgroundSettings;
    padding: SpacingSettings;
    margin: SpacingSettings;
    fullWidth: boolean;
    minHeight: string;
    htmlId: string;            // for anchor links
    htmlClass: string;
    hideOnMobile: boolean;
    hideOnDesktop: boolean;
    parallax: boolean;
    customCss: string;
  };
  columns: Column[];
}

// A Column = flex/grid column inside a section
interface Column {
  id: string;
  type: "column";
  settings: {
    width: number;             // 1-12 grid units
    widthMobile: number;
    padding: SpacingSettings;
    verticalAlign: "top" | "middle" | "bottom";
    background: BackgroundSettings;
    border: BorderSettings;
    borderRadius: string;
    sticky: boolean;
    order: number;
    orderMobile: number;
  };
  blocks: Block[];             // Leaf elements
}

// A Block = actual UI element
interface Block {
  id: string;
  type: BlockType;             // see full list below
  settings: Record<string, any>;  // per-block settings
  responsiveOverrides?: {     // mobile-specific overrides
    mobile?: Partial<Record<string, any>>;
    tablet?: Partial<Record<string, any>>;
  };
  animations?: AnimationSettings;
  visibility?: {
    hideOnMobile: boolean;
    hideOnTablet: boolean;
    hideOnDesktop: boolean;
    loggedInOnly: boolean;
    guestOnly: boolean;
  };
}
```

