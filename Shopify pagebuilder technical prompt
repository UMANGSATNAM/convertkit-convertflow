// Storefront tracking pixel (injected by ScriptTag or TAE)
window.__PB_ANALYTICS__ = {
  pageId: "xxx",
  shop: "xxx.myshopify.com",
  
  track: function(event, data) {
    // event: "view" | "atc" | "purchase" | "scroll_depth" | "element_click"
    navigator.sendBeacon('/api/analytics/event', JSON.stringify({
      event, data,
      pageId: this.pageId,
      shop: this.shop,
      timestamp: Date.now(),
      sessionId: this.getSessionId()
    }));
  }
};

