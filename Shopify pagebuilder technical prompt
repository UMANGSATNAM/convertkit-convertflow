## 🎨 STOREFRONT RENDERER (Vanilla JS)

The storefront renderer must be **extremely lightweight**. It's a pure function: JSON Schema → HTML string.

```javascript
// Core render function (runs client-side or server-side)
function renderSchema(schema) {
  let html = `<div class="pb-page" style="${getCSSVars(schema.globalStyles)}">`;
  
  for (const section of schema.sections) {
    html += renderSection(section);
  }
  
  html += '</div>';
  return html;
}

function renderSection(section) {
  const { settings, columns } = section;
  const bg = renderBackground(settings.background);
  const padding = `padding: ${settings.padding.top}px ${settings.padding.right}px ${settings.padding.bottom}px ${settings.padding.left}px`;
  
  let html = `<section id="${settings.htmlId || ''}" class="pb-section ${settings.htmlClass || ''}" 
    style="${bg};${padding}" data-block-id="${section.id}">`;
  html += `<div class="pb-section-inner ${settings.fullWidth ? 'pb-full-width' : 'pb-container'}">`;
  html += `<div class="pb-row">`;
  
  for (const column of columns) {
    html += renderColumn(column);
  }
  
  html += `</div></div></section>`;
  return html;
}

function renderBlock(block) {
  const renderers = {
    heading: renderHeading,
    paragraph: renderParagraph,
    button: renderButton,
    image: renderImage,
    video: renderVideo,
    countdown_timer: renderCountdown,
    product_title: renderProductTitle,
    product_price: renderProductPrice,
    add_to_cart_button: renderATC,
    product_images: renderProductImages,
    // ... all 50+ block types
  };
  
  const renderer = renderers[block.type];
  if (!renderer) return `<!-- unknown block: ${block.type} -->`;
  
  const blockHtml = renderer(block.settings);
  return wrapWithAnimations(blockHtml, block.animations, block.id);
}
```

