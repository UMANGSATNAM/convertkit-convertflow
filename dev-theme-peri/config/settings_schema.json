  {
    "name": "Design Tokens — Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "font_base_size",
        "label": "Base Body Font Size (px)",
        "min": 13,
        "max": 18,
        "step": 1,
        "default": 15
      }
    ]
  },
  {
    "name": "Design Tokens — Layout & Shape",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Maximum Page Width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1280
      },
      {
        "type": "range",
        "id": "radius_button",
        "label": "Button Corner Radius (px)",
        "min": 0,
        "max": 40,
        "step": 2,
        "default": 8
      },
      {
        "type": "range",
        "id": "radius_card",
        "label": "Card Corner Radius (px)",
        "min": 0,
        "max": 32,
        "step": 2,
        "default": 12
      },
      {
        "type": "range",
        "id": "radius_badge",
        "label": "Badge Corner Radius (px)",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 99
      }
    ]
  },
  {
    "name": "Cart Drawer & Shipping Bar",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart Type",
        "options": [
          { "value": "drawer", "label": "Slide-out Drawer" },
          { "value": "page", "label": "Cart Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold (INR ₹)",
        "default": "999"
      },
      {
        "type": "checkbox",
        "id": "enable_cart_upsells",
        "label": "Enable Cart Drawer Upsells",
        "default": true
      },
      {
        "type": "collection",
        "id": "cart_upsell_collection",
        "label": "Cart Drawer Upsell Collection"
      }
    ]
  },
  {
    "name": "Promo Code & Discount Engine Sync",
    "settings": [
      {
        "type": "text",
        "id": "active_promo_code",
        "label": "Active Promo / Discount Code",
        "default": "FIRST10"
      },
      {
        "type": "text",
        "id": "promo_discount_text",
        "label": "Promo Banner Text",
        "default": "GET 10% OFF ON YOUR FIRST ORDER — USE CODE: FIRST10"
      },
      {
        "type": "checkbox",
        "id": "enable_promo_bar",
        "label": "Enable Sticky Promo Announcement Bar",
        "default": true
      }
    ]
  },
  {
    "name": "Social Proof & Urgency",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_social_proof",
        "label": "Enable Live Social Proof Popups",
        "default": true
      },
      {
        "type": "select",
        "id": "social_proof_mode",
        "label": "What the popup shows",
        "info": "Aggregate and Manual show only information you have entered. Simulated invents names and cities over real product titles — the purchases are illustrative, not real orders.",
        "options": [
          { "value": "aggregate", "label": "Aggregate stat (honest, no names)" },
          { "value": "manual", "label": "Manual list (real purchases you enter)" },
          { "value": "simulated", "label": "Simulated names and cities" }
        ],
        "default": "aggregate"
      },
      {
        "type": "text",
        "id": "social_proof_aggregate_headline",
        "label": "Aggregate — headline",
        "default": "Trusted by our community"
      },
      {
        "type": "text",
        "id": "social_proof_aggregate_line",
        "label": "Aggregate — main line",
        "default": "1,240 orders shipped this month"
      },
      {
        "type": "text",
        "id": "social_proof_aggregate_note",
        "label": "Aggregate — small note",
        "default": "Updated weekly"
      },
      {
        "type": "textarea",
        "id": "social_proof_manual",
        "label": "Manual list",
        "info": "One per line, pipe separated: Who | What they bought | When. Example: Riya from Delhi | just bought the Glow Serum | 2 hours ago"
      },
      {
        "type": "collection",
        "id": "social_proof_collection",
        "label": "Simulated — products to feature",
        "info": "Leave empty to use all products."
      },
      {
        "type": "textarea",
        "id": "social_proof_names",
        "label": "Simulated — names and cities",
        "info": "Comma separated.",
        "default": "Ananya from Delhi, Rohan from Bangalore, Sneha from Mumbai, Vikram from Pune, Kavya from Hyderabad, Riya from Delhi, Rahul from Mumbai, Amit from Chennai"
      },
      {
        "type": "header",
        "content": "Popup timing"
      },
      {
        "type": "range",
        "id": "social_proof_first_delay",
        "label": "Wait before the first popup",
        "min": 2,
        "max": 30,
        "step": 1,
        "unit": "s",
        "default": 6
      },
      {
        "type": "range",
        "id": "social_proof_delay",
        "label": "Gap between popups",
        "min": 3,
        "max": 60,
        "step": 1,
        "unit": "s",
        "default": 12
      },
      {
        "type": "range",
        "id": "social_proof_visible",
        "label": "How long each popup stays",
        "min": 2,
        "max": 15,
        "step": 1,
        "unit": "s",
        "default": 5
      },
      {
        "type": "range",
        "id": "social_proof_max",
        "label": "Maximum popups per visit",
        "min": 1,
        "max": 20,
        "step": 1,
        "default": 6
      },
      {
        "type": "select",
        "id": "social_proof_position",
        "label": "Position",
        "options": [
          { "value": "bottom-left", "label": "Bottom left" },
          { "value": "bottom-right", "label": "Bottom right" },
          { "value": "top-left", "label": "Top left" },
          { "value": "top-right", "label": "Top right" }
        ],
        "default": "bottom-left"
      },
      {
        "type": "header",
        "content": "Countdown timers"
      },
      {
        "type": "paragraph",
        "content": "Controls the offer countdown shown on product pages."
      },
      {
        "type": "select",
        "id": "countdown_mode",
        "label": "Countdown type",
        "info": "Evergreen is honest about being per-visitor. Use Fixed deadline for a real sale end date.",
        "options": [
          { "value": "evergreen", "label": "Evergreen (X hours per visitor)" },
          { "value": "fixed", "label": "Fixed deadline (same for everyone)" },
          { "value": "daily", "label": "Resets daily at a set time" }
        ],
        "default": "evergreen"
      },
      {
        "type": "range",
        "id": "countdown_hours",
        "label": "Evergreen duration (hours)",
        "min": 1,
        "max": 48,
        "step": 1,
        "unit": "h",
        "default": 4
      },
      {
        "type": "text",
        "id": "countdown_end",
        "label": "Fixed deadline",
        "info": "Format: 2026-08-31T23:59:00 — used only when Countdown type is Fixed deadline."
      },
      {
        "type": "text",
        "id": "countdown_daily_time",
        "label": "Daily reset time",
        "info": "24-hour format, e.g. 23:59 — used only when Countdown type is Resets daily.",
        "default": "23:59"
      },
      {
        "type": "select",
        "id": "countdown_expired_behaviour",
        "label": "When the countdown ends",
        "options": [
          { "value": "message", "label": "Show an ended message" },
          { "value": "hide", "label": "Hide the timer" },
          { "value": "restart", "label": "Restart the countdown" }
        ],
        "default": "message"
      },
      {
        "type": "text",
        "id": "countdown_expired_text",
        "label": "Ended message",
        "default": "Offer ended"
      },
      {
        "type": "text",
        "id": "countdown_prefix",
        "label": "Prefix before the digits",
        "info": "Leave blank for digits only.",
        "default": "🔥 "
      }
    ]
  }
]