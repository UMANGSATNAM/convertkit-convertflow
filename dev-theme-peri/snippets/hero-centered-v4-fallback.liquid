<div class="sf-hero-centered js-motion-enabled sf-hero-{{ section.id }}">
  <div class="sf-hero-centered__content container-narrow">
    {% if section.settings.eyebrow != blank %}
      <span class="sf-reveal eyebrow sf-hero-centered__eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    <h1 class="sf-reveal display-heading sf-hero-centered__title">{{ section.settings.title }}</h1>
    {% if section.settings.subtitle != blank %}
      <p class="sf-reveal sf-hero-centered__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
    
    <div class="sf-hero-centered__actions sf-reveal">
      {% if section.settings.button_link != blank and section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="button button--primary">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
      {% if section.settings.button_link_2 != blank and section.settings.button_text_2 != blank %}
        <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">
          {{ section.settings.button_text_2 }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.trust_text != blank %}
      <div class="sf-hero-centered__trust sf-reveal">
        {{ section.settings.trust_text }}
      </div>
    {% endif %}
  </div>
</div>

<style>
  .sf-hero-{{ section.id }} {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-background);
    color: var(--color-text);
    padding: calc(var(--spacing-section-y) * 1.5) 0;
  }
  .sf-hero-centered__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .sf-hero-centered__eyebrow {
    margin-bottom: var(--space-16);
  }
  .sf-hero-centered__title {
    font-weight: var(--weight-display);
    margin-bottom: var(--space-20);
  }
  .sf-hero-centered__subtitle {
    margin-bottom: var(--space-32);
    opacity: 0.9;
  }
  .sf-hero-centered__actions {
    display: flex;
    gap: var(--space-16);
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: var(--space-24);
  }
  .sf-hero-centered__trust {
    font-size: var(--font-small);
    color: var(--color-text-muted);
  }
  .button {
    display: inline-block;
    padding: var(--space-12) var(--space-24);
    font-weight: var(--weight-heading);
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: var(--button-radius);
    transition: transform var(--transition-fast) ease, background-color var(--transition-fast) ease;
  }
  .button--primary {
    background-color: var(--color-accent);
    color: var(--color-background);
    border: 1px solid var(--color-accent);
  }
  .button--secondary {
    background-color: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-text);
  }
  .button:hover {
    transform: translateY(-2px);
  }
  
  /* Stagger animation overrides */
  .sf-hero-centered__content > .sf-reveal:nth-child(1) { transition-delay: calc(var(--motion-stagger) * 1); }
  .sf-hero-centered__content > .sf-reveal:nth-child(2) { transition-delay: calc(var(--motion-stagger) * 2); }
  .sf-hero-centered__content > .sf-reveal:nth-child(3) { transition-delay: calc(var(--motion-stagger) * 3); }
  .sf-hero-centered__content > .sf-reveal:nth-child(4) { transition-delay: calc(var(--motion-stagger) * 4); }
  .sf-hero-centered__content > .sf-reveal:nth-child(5) { transition-delay: calc(var(--motion-stagger) * 5); }

  @media (min-width: 768px) {
    .sf-hero-{{ section.id }} {
      padding: calc(var(--spacing-section-y) * 2) 0;
      min-height: 70vh;
    }
  }
</style>
