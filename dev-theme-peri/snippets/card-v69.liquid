{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V69 — ARTISANAL BEAN-TO-BAR CHOCOLATE D2C (TONY'S CHOCOLONELY / HU KITCHEN STYLE)
  Usage: {% render 'card-v69', product: product %}
  Design: Cacao Dark (#3B180A), Warm Cream (#FFFBEB), Bricolage Grotesque & Plus Jakarta Sans fonts, 10px card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .cv69-card {
    --cv69-bg: #FFFFFF;
    --cv69-text: #3B180A;
    --cv69-muted: #78350F;
    --cv69-cacao: #3B180A;
    --cv69-cream: #FFFBEB;
    --cv69-border: #FDE68A;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cv69-bg);
    border: 1px solid var(--cv69-border);
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv69-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv69-cacao);
    box-shadow: 0 12px 24px -6px rgba(59, 24, 10, 0.25);
  }

  .cv69-card *, .cv69-card *::before, .cv69-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv69-card a { color: inherit; text-decoration: none; }
  .cv69-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv69-card img { max-width: 100%; display: block; }

  .cv69-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: var(--cv69-cream);
    overflow: hidden;
  }
  .cv69-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv69-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv69-card:hover .cv69-img-pri { opacity: 0; }
  .cv69-card:hover .cv69-img-sec { opacity: 1; transform: scale(1.05); }

  /* Chocolate Tag Top Left */
  .cv69-badge-cacao {
    position: absolute; top: 10px; left: 10px;
    background: var(--cv69-cacao); color: #FFFBEB;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 9px; font-weight: 800; text-transform: uppercase;
    padding: 4px 9px; border-radius: 20px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv69-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid var(--cv69-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv69-cacao); z-index: 3; transition: all 0.2s ease;
  }
  .cv69-wish:hover, .cv69-wish.active { background: var(--cv69-cacao); color: #FFFFFF; border-color: var(--cv69-cacao); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv69-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(59, 24, 10, 0.95); color: #FFFBEB;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    text-align: center; border-radius: 6px; border: 1px solid var(--cv69-cacao);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv69-card:hover .cv69-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv69-qv-overlay:hover { background: #FFFBEB; color: #3B180A; }

  .cv69-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }
  .cv69-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv69-muted); font-weight: 800; font-family: 'Bricolage Grotesque', sans-serif; letter-spacing: 0.08em; }
  .cv69-title { font-family: 'Bricolage Grotesque', sans-serif; font-size: 16px; font-weight: 800; color: #3B180A; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Chocolate Specs Subtitle */
  .cv69-specs { font-size: 11px; color: #78350F; font-weight: 600; }

  /* Rating Row */
  .cv69-rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; color: #3B180A; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv69-price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv69-price { font-family: 'Bricolage Grotesque', sans-serif; font-size: 17px; font-weight: 800; color: #3B180A; }
  .cv69-cmp { font-size: 13px; color: #9CA3AF; text-decoration: line-through; }
  .cv69-disc { font-size: 10px; font-weight: 800; color: #3B180A; background: var(--cv69-cream); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--cv69-border); }

  /* Flavor Selector */
  .cv69-sizes { display: flex; gap: 6px; overflow-x: auto; justify-content: center; margin-top: 4px; }
  .cv69-size-btn {
    font-size: 10px; font-weight: 700; padding: 4px 8px; border-radius: 6px;
    border: 1px solid var(--cv69-border); background: #FFFFFF; color: #3B180A; cursor: pointer; transition: all 0.2s ease;
  }
  .cv69-size-btn.active, .cv69-size-btn:hover { background: #3B180A; color: #FFFBEB; border-color: #3B180A; }

  /* Bottom Button */
  .cv69-action-box { padding: 0 14px 14px; }
  .cv69-atc-btn {
    width: 100%; padding: 11px;
    background: #3B180A; color: #FFFBEB;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 6px; border: none; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(59, 24, 10, 0.3);
  }
  .cv69-atc-btn:hover { background: #1F0A03; transform: scale(1.01); }
  .cv69-atc-btn:disabled { background: #E5E7EB; color: #9CA3AF; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv69-card" data-product-id="{{ card_prod.id }}">
    <span class="cv69-badge-cacao">ETHICAL SINGLE-ORIGIN 🍫</span>

    <button type="button" class="cv69-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv69-media">
      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv69-img cv69-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img height="{{ card_prod.images[1].height }}" width="{{ card_prod.images[1].width }}" src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv69-img cv69-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-3' | placeholder_svg_tag: 'cv69-img' }}
      {% endif %}

      <button type="button" class="cv69-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv69-content">
      {% if card_prod.vendor != blank %}<span class="cv69-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv69-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv69-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv69-specs">Peruvian Organic Cacao | Fair-Trade</span>

      <div class="cv69-rating">
        <span>★ 4.9</span> <span>(5,600 reviews)</span>
      </div>

      <div class="cv69-price-row">
        <span class="cv69-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv69-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv69-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Size Selector -->
      <div class="cv69-sizes">
        {% for variant in card_prod.variants limit: 3 %}
          <button type="button" class="cv69-size-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv69-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv69-atc-btn" data-add-cart="{{ cur_var.id }}">INDULGE IN REAL CACAO</button>
      {% else %}
        <button type="button" class="cv69-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv69-card">
    <div class="cv69-media">{{ 'product-3' | placeholder_svg_tag: 'cv69-img' }}</div>
    <div class="cv69-content">
      <span class="cv69-vendor">CRAFT CHOCOLATE D2C</span>
      <div class="cv69-title">70% Dark Chocolate Bar w/ Sea Salt & Nibs</div>

      {% if card_r_show != false %}
      <div class="cv69-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv69-specs">Peruvian Organic Cacao | Fair-Trade</span>
      <div class="cv69-price-row"><span class="cv69-price">₹ 449</span><span class="cv69-cmp">₹ 599</span><span class="cv69-disc">25% OFF</span></div>
    </div>
  </div>
{% endif %}
