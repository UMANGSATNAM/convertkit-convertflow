{% comment %}
  Universal Promo Code Snippet
  Reads: shop.metafields.custom.active_discount or settings.active_promo_code
{% endcomment %}

{% assign active_code = shop.metafields.custom.active_discount | default: settings.active_promo_code | default: 'FIRST10' %}
{% assign active_text = shop.metafields.custom.promo_text | default: settings.promo_discount_text | default: 'GET 10% OFF ON YOUR FIRST ORDER' %}

<div class="cf-promo-box" style="display: flex; align-items: center; justify-content: space-between; gap: 12px; background: #EFF6FF; border: 1px dashed #3B82F6; padding: 10px 16px; border-radius: var(--radius-button, 8px); margin: 8px 0;">
  <div style="display: flex; align-items: center; gap: 8px;">
    {% render 'icon', icon: 'discount' %}
    <span style="font-size: 13px; font-weight: 600; color: #1E40AF;">{{ active_text }}</span>
  </div>

  <div style="display: flex; align-items: center; gap: 6px;">
    <code class="cf-promo-code" style="font-size: 13px; font-weight: 700; background: #FFFFFF; color: #1E3A8A; padding: 4px 8px; border-radius: 4px; border: 1px solid #BFDBFE;">{{ active_code }}</code>
    <a href="/discount/{{ active_code }}" class="cf-promo-apply-btn" style="font-size: 12px; font-weight: 700; color: #FFFFFF; background: #2563EB; padding: 6px 12px; border-radius: 6px; text-decoration: none; display: inline-block;">
      Apply Code
    </a>
  </div>
</div>
