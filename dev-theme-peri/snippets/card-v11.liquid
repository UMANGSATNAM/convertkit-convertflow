{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V11 — NEO-TOKYO TECH STREETWEAR D2C (CYBERWEAR STYLE)
  Usage: {% render 'card-v11', product: product %}
  Design: Pitch Dark (#0A0E17), Cyber Cyan (#00F0FF), Neon Pink (#FF0055), Orbitron & Space Grotesk, chamfered corners
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800&family=Space+Grotesk:wght@600;700&display=swap');

  .cv11-card {
    --cv11-bg: #0A0E17;
    --cv11-card-bg: #121826;
    --cv11-text: #F8FAFC;
    --cv11-muted: #64748B;
    --cv11-cyan: #00F0FF;
    --cv11-pink: #FF0055;
    --cv11-border: #00F0FF;
    font-family: 'Space Grotesk', sans-serif;
    background: var(--cv11-card-bg);
    border: 1px solid var(--cv11-border);
    border-radius: 6px;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv11-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv11-pink);
    box-shadow: 0 0 25px rgba(255, 0, 85, 0.35);
  }

  .cv11-card *, .cv11-card *::before, .cv11-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv11-card a { color: inherit; text-decoration: none; }
  .cv11-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv11-card img { max-width: 100%; display: block; }

  .cv11-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: #05080E;
    overflow: hidden;
    border-bottom: 1px solid var(--cv11-border);
  }
  .cv11-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .cv11-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv11-card:hover .cv11-img-pri { opacity: 0; }
  .cv11-card:hover .cv11-img-sec { opacity: 1; transform: scale(1.06); }

  /* Cyber Tag Top Left */
  .cv11-badge-cyber {
    position: absolute; top: 10px; left: 10px;
    background: var(--cv11-cyan); color: #0A0E17;
    font-family: 'Orbitron', sans-serif; font-size: 9px; font-weight: 800; text-transform: uppercase;
    padding: 3px 8px; border-radius: 2px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv11-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #0A0E17; border: 1px solid var(--cv11-cyan);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv11-cyan); z-index: 3; transition: all 0.2s ease;
  }
  .cv11-wish:hover, .cv11-wish.active { background: var(--cv11-cyan); color: #0A0E17; transform: scale(1.1); }

  /* Quick View Overlay */
  .cv11-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(10, 14, 23, 0.95); color: var(--cv11-cyan);
    font-family: 'Orbitron', sans-serif; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
    text-align: center; border-radius: 4px; border: 1px solid var(--cv11-cyan);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv11-card:hover .cv11-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv11-qv-overlay:hover { background: var(--cv11-cyan); color: #0A0E17; }

  .cv11-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: left; }
  .cv11-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv11-cyan); font-weight: 800; font-family: 'Orbitron', sans-serif; letter-spacing: 0.1em; }
  .cv11-title { font-family: 'Orbitron', sans-serif; font-size: 15px; font-weight: 800; color: #FFFFFF; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-transform: uppercase; }

  /* Subtitle Tech Line */
  .cv11-tech-line { font-size: 11px; color: var(--cv11-muted); font-weight: 500; }

  /* Rating Row */
  .cv11-rating { display: flex; align-items: center; gap: 4px; font-size: 11px; color: var(--cv11-cyan); font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv11-price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv11-price { font-family: 'Orbitron', sans-serif; font-size: 17px; font-weight: 800; color: #FFFFFF; }
  .cv11-cmp { font-size: 13px; color: var(--cv11-muted); text-decoration: line-through; }
  .cv11-disc { font-size: 10px; font-weight: 800; color: #FFFFFF; background: var(--cv11-pink); padding: 2px 6px; border-radius: 2px; }

  /* Size Selector */
  .cv11-sizes { display: flex; gap: 6px; overflow-x: auto; margin-top: 4px; }
  .cv11-size-btn {
    font-family: 'Orbitron', sans-serif; font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 2px;
    border: 1px solid var(--cv11-cyan); background: transparent; color: var(--cv11-cyan); cursor: pointer; transition: all 0.2s ease;
  }
  .cv11-size-btn.active, .cv11-size-btn:hover { background: var(--cv11-cyan); color: #0A0E17; }

  /* Bottom Button */
  .cv11-action-box { padding: 0 14px 14px; }
  .cv11-atc-btn {
    width: 100%; padding: 11px;
    background: var(--cv11-cyan); color: #0A0E17;
    font-family: 'Orbitron', sans-serif; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
    border-radius: 4px; border: none; transition: all 0.2s ease;
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
  }
  .cv11-atc-btn:hover { background: var(--cv11-pink); color: #FFFFFF; box-shadow: 0 0 20px rgba(255, 0, 85, 0.5); }
  .cv11-atc-btn:disabled { background: #1E293B; color: #64748B; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv11-card" data-product-id="{{ card_prod.id }}">
    <span class="cv11-badge-cyber">CYBER EDITION ⚡</span>

    <button type="button" class="cv11-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv11-media">
      {% if card_prod.featured_image %}
        <img src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv11-img cv11-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv11-img cv11-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'cv11-img' }}
      {% endif %}

      <button type="button" class="cv11-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv11-content">
      {% if card_prod.vendor != blank %}<span class="cv11-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv11-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv11-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv11-tech-line">3 Layer Tech Membrane | 10,000mm Waterproof</span>

      <div class="cv11-rating">
        <span>★ 4.9</span> <span>(540 reviews)</span>
      </div>

      <div class="cv11-price-row">
        <span class="cv11-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv11-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv11-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Size Selector -->
      <div class="cv11-sizes">
        {% for variant in card_prod.variants limit: 4 %}
          <button type="button" class="cv11-size-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv11-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv11-atc-btn" data-add-cart="{{ cur_var.id }}">SECURE CYBER GEAR</button>
      {% else %}
        <button type="button" class="cv11-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv11-card">
    <div class="cv11-media">{{ 'product-1' | placeholder_svg_tag: 'cv11-img' }}</div>
    <div class="cv11-content">
      <span class="cv11-vendor">CYBERWEAR D2C</span>
      <div class="cv11-title">Waterproof Tactical Cargo Pants w/ Magnetic Buckles</div>

      {% if card_r_show != false %}
      <div class="cv11-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv11-tech-line">3 Layer Tech Membrane | 10,000mm Waterproof</span>
      <div class="cv11-price-row"><span class="cv11-price">₹ 4,499</span><span class="cv11-cmp">₹ 5,999</span><span class="cv11-disc">25% OFF</span></div>
    </div>
  </div>
{% endif %}
