{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V10 — MODERN EYEWEAR & SUNGLASSES D2C (LENSKART / VINCENT CHASE STYLE)
  Usage: {% render 'card-v10', product: product %}
  Design: Clean Slate (#0F172A), Electric Cyan (#0EA5E9), Space Grotesk & Inter fonts, 8px crisp corners
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap');

  .cv10-card {
    --cv10-bg: #FFFFFF;
    --cv10-text: #0F172A;
    --cv10-muted: #64748B;
    --cv10-cyan: #0EA5E9;
    --cv10-light-cyan: #E0F2FE;
    --cv10-border: #E2E8F0;
    font-family: 'Inter', sans-serif;
    background: var(--cv10-bg);
    border: 1px solid var(--cv10-border);
    border-radius: 8px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv10-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv10-cyan);
    box-shadow: 0 12px 24px -6px rgba(14, 165, 233, 0.18);
  }

  .cv10-card *, .cv10-card *::before, .cv10-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv10-card a { color: inherit; text-decoration: none; }
  .cv10-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv10-card img { max-width: 100%; display: block; }

  .cv10-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: #F8FAFC;
    overflow: hidden;
  }
  .cv10-img { width: 100%; height: 100%; object-fit: contain; padding: 16px; transition: transform 0.5s ease; }
  .cv10-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv10-card:hover .cv10-img-pri { opacity: 0; }
  .cv10-card:hover .cv10-img-sec { opacity: 1; transform: scale(1.05); }

  /* Frame Tag Top Left */
  .cv10-badge-frame {
    position: absolute; top: 10px; left: 10px;
    background: #0F172A; color: #FFFFFF;
    font-family: 'Space Grotesk', sans-serif; font-size: 9px; font-weight: 700; text-transform: uppercase;
    padding: 3px 8px; border-radius: 4px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv10-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid #E2E8F0;
    display: flex; align-items: center; justify-content: center;
    color: var(--cv10-cyan); z-index: 3; transition: all 0.2s ease;
  }
  .cv10-wish:hover, .cv10-wish.active { background: var(--cv10-cyan); color: #FFFFFF; border-color: var(--cv10-cyan); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv10-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(15, 23, 42, 0.95); color: #FFFFFF;
    font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    text-align: center; border-radius: 6px; border: 1px solid var(--cv10-cyan);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv10-card:hover .cv10-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv10-qv-overlay:hover { background: var(--cv10-cyan); color: #FFFFFF; }

  .cv10-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; }
  .cv10-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv10-cyan); font-weight: 700; font-family: 'Space Grotesk', sans-serif; letter-spacing: 0.08em; }
  .cv10-title { font-family: 'Space Grotesk', sans-serif; font-size: 15px; font-weight: 700; color: #0F172A; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Subtitle / Lens Specs */
  .cv10-specs { font-size: 11px; color: var(--cv10-muted); font-weight: 500; }

  /* Rating Row */
  .cv10-rating { display: flex; align-items: center; gap: 4px; font-size: 11px; color: #0EA5E9; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv10-price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv10-price { font-family: 'Space Grotesk', sans-serif; font-size: 17px; font-weight: 800; color: #0F172A; }
  .cv10-cmp { font-size: 13px; color: #94A3B8; text-decoration: line-through; }
  .cv10-disc { font-size: 10px; font-weight: 800; color: #0EA5E9; background: var(--cv10-light-cyan); padding: 2px 6px; border-radius: 4px; }

  /* Frame Size Selector */
  .cv10-sizes { display: flex; gap: 6px; overflow-x: auto; margin-top: 4px; }
  .cv10-size-btn {
    font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 4px;
    border: 1px solid #E2E8F0; background: #FFFFFF; color: #0F172A; cursor: pointer; transition: all 0.2s ease;
  }
  .cv10-size-btn.active, .cv10-size-btn:hover { background: #0F172A; color: #FFFFFF; border-color: #0F172A; }

  /* Bottom Button */
  .cv10-action-box { padding: 0 14px 14px; }
  .cv10-atc-btn {
    width: 100%; padding: 11px;
    background: transparent; color: var(--cv10-cyan);
    font-family: 'Space Grotesk', sans-serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 6px; border: 1.5px solid var(--cv10-cyan); transition: all 0.2s ease;
  }
  .cv10-atc-btn:hover { background: var(--cv10-cyan); color: #FFFFFF; box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3); }
  .cv10-atc-btn:disabled { background: #E2E8F0; color: #94A3B8; cursor: not-allowed; border-color: #E2E8F0; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv10-card" data-product-id="{{ card_prod.id }}">
    <span class="cv10-badge-frame">BLUE CUT LENSES 👓</span>

    <button type="button" class="cv10-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv10-media">
      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv10-img cv10-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img height="{{ card_prod.images[1].height }}" width="{{ card_prod.images[1].width }}" src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv10-img cv10-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-4' | placeholder_svg_tag: 'cv10-img' }}
      {% endif %}

      <button type="button" class="cv10-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv10-content">
      {% if card_prod.vendor != blank %}<span class="cv10-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv10-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv10-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv10-specs">Anti-Glare Blue Cut Lenses | Zero Power</span>

      <div class="cv10-rating">
        <span>★ 4.7</span> <span>(3,800 reviews)</span>
      </div>

      <div class="cv10-price-row">
        <span class="cv10-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv10-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv10-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Frame Size Selector -->
      <div class="cv10-sizes">
        {% for variant in card_prod.variants limit: 3 %}
          <button type="button" class="cv10-size-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv10-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv10-atc-btn" data-add-cart="{{ cur_var.id }}">TRY ON & BUY NOW</button>
      {% else %}
        <button type="button" class="cv10-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv10-card">
    <div class="cv10-media">{{ 'product-4' | placeholder_svg_tag: 'cv10-img' }}</div>
    <div class="cv10-content">
      <span class="cv10-vendor">OPTICAL D2C</span>
      <div class="cv10-title">Matt Black Full Rim Wayfarer Computer Eyeglasses</div>

      {% if card_r_show != false %}
      <div class="cv10-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv10-specs">Anti-Glare Blue Cut Lenses | Zero Power</span>
      <div class="cv10-price-row"><span class="cv10-price">₹ 1,199</span><span class="cv10-cmp">₹ 2,000</span><span class="cv10-disc">40% OFF</span></div>
    </div>
  </div>
{% endif %}
