{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V31 — ARTISANAL CEREMONIAL MATCHA & WELLNESS TEAS D2C (TENZO MATCHA / COSMIX STYLE)
  Usage: {% render 'card-v31', product: product %}
  Design: Ceremonial Zen Green (#1C3A27), Soft Matcha Cream (#F4EFE6), Playfair Display & Plus Jakarta Sans fonts, 10px card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .cv31-card {
    --cv31-bg: #FFFFFF;
    --cv31-text: #1C3A27;
    --cv31-muted: #2D5A3F;
    --cv31-zen: #1C3A27;
    --cv31-cream: #F4EFE6;
    --cv31-border: #D8CEBE;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cv31-bg);
    border: 1px solid var(--cv31-border);
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv31-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv31-zen);
    box-shadow: 0 12px 24px -6px rgba(28, 58, 39, 0.22);
  }

  .cv31-card *, .cv31-card *::before, .cv31-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv31-card a { color: inherit; text-decoration: none; }
  .cv31-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv31-card img { max-width: 100%; display: block; }

  .cv31-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: var(--cv31-cream);
    overflow: hidden;
  }
  .cv31-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv31-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv31-card:hover .cv31-img-pri { opacity: 0; }
  .cv31-card:hover .cv31-img-sec { opacity: 1; transform: scale(1.05); }

  /* Matcha Tag Top Left */
  .cv31-badge-matcha {
    position: absolute; top: 10px; left: 10px;
    background: #1C3A27; color: #E2E8F0;
    font-family: 'Playfair Display', serif; font-size: 9px; font-weight: 700; text-transform: uppercase;
    padding: 3px 9px; border-radius: 4px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv31-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid var(--cv31-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv31-zen); z-index: 3; transition: all 0.2s ease;
  }
  .cv31-wish:hover, .cv31-wish.active { background: var(--cv31-zen); color: #FFFFFF; border-color: var(--cv31-zen); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv31-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(28, 58, 39, 0.95); color: #FFFFFF;
    font-family: 'Playfair Display', serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    text-align: center; border-radius: 6px; border: 1px solid var(--cv31-zen);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv31-card:hover .cv31-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv31-qv-overlay:hover { background: #FFFFFF; color: #1C3A27; }

  .cv31-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }
  .cv31-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv31-zen); font-weight: 700; font-family: 'Playfair Display', serif; letter-spacing: 0.1em; }
  .cv31-title { font-family: 'Playfair Display', serif; font-size: 16px; font-weight: 700; color: #1C3A27; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Matcha Specs Subtitle */
  .cv31-specs { font-size: 11px; color: var(--cv31-muted); font-style: italic; }

  /* Rating Row */
  .cv31-rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; color: #1C3A27; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv31-price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv31-price { font-family: 'Playfair Display', serif; font-size: 17px; font-weight: 700; color: #1C3A27; }
  .cv31-cmp { font-size: 13px; color: #9CA3AF; text-decoration: line-through; }
  .cv31-disc { font-size: 10px; font-weight: 700; color: #1C3A27; background: var(--cv31-cream); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--cv31-border); }

  /* Grade Variant Selector */
  .cv31-sizes { display: flex; gap: 6px; overflow-x: auto; justify-content: center; margin-top: 4px; }
  .cv31-size-btn {
    font-size: 10px; font-weight: 600; padding: 4px 9px; border-radius: 4px;
    border: 1px solid var(--cv31-border); background: #FFFFFF; color: #1C3A27; cursor: pointer; transition: all 0.2s ease;
  }
  .cv31-size-btn.active, .cv31-size-btn:hover { background: #1C3A27; color: #FFFFFF; border-color: #1C3A27; }

  /* Bottom Button */
  .cv31-action-box { padding: 0 14px 14px; }
  .cv31-atc-btn {
    width: 100%; padding: 11px;
    background: var(--cv31-zen); color: #FFFFFF;
    font-family: 'Playfair Display', serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 6px; border: none; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(28, 58, 39, 0.3);
  }
  .cv31-atc-btn:hover { background: #2D5A3F; transform: scale(1.01); }
  .cv31-atc-btn:disabled { background: #D8CEBE; color: #9CA3AF; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv31-card" data-product-id="{{ card_prod.id }}">
    <span class="cv31-badge-matcha">CEREMONIAL GRADE 🍵</span>

    <button type="button" class="cv31-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv31-media">
      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv31-img cv31-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img height="{{ card_prod.images[1].height }}" width="{{ card_prod.images[1].width }}" src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv31-img cv31-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'cv31-img' }}
      {% endif %}

      <button type="button" class="cv31-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv31-content">
      {% if card_prod.vendor != blank %}<span class="cv31-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv31-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv31-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv31-specs">100% First-Harvest | Zero Jitters Energy</span>

      <div class="cv31-rating">
        <span>★ 4.9</span> <span>(2,890 reviews)</span>
      </div>

      <div class="cv31-price-row">
        <span class="cv31-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv31-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv31-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Grade Variant Selector -->
      <div class="cv31-sizes">
        {% for variant in card_prod.variants limit: 3 %}
          <button type="button" class="cv31-size-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv31-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv31-atc-btn" data-add-cart="{{ cur_var.id }}">ELEVATE YOUR MIND</button>
      {% else %}
        <button type="button" class="cv31-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv31-card">
    <div class="cv31-media">{{ 'product-1' | placeholder_svg_tag: 'cv31-img' }}</div>
    <div class="cv31-content">
      <span class="cv31-vendor">WELLNESS MATCHA D2C</span>
      <div class="cv31-title">Organic Ceremonial Grade Uji Japanese Matcha</div>

      {% if card_r_show != false %}
      <div class="cv31-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv31-specs">100% First-Harvest | Zero Jitters Energy</span>
      <div class="cv31-price-row"><span class="cv31-price">₹ 1,499</span><span class="cv31-cmp">₹ 1,999</span><span class="cv31-disc">25% OFF</span></div>
    </div>
  </div>
{% endif %}
