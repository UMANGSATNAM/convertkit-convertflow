{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V23 — CLEAN BODYCARE & DERM-ACTIVE HYGIENE D2C (CHEMISTS AT PLAY / BODYWISE STYLE)
  Usage: {% render 'card-v23', product: product %}
  Design: Lab Cyan Teal (#0D9488), Soft Aqua (#CCFBF1), Plus Jakarta Sans & Space Grotesk fonts, 12px rounded card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap');

  .cv23-card {
    --cv23-bg: #FFFFFF;
    --cv23-text: #0F766E;
    --cv23-muted: #115E59;
    --cv23-cyan: #0D9488;
    --cv23-light-cyan: #CCFBF1;
    --cv23-border: #99F6E4;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cv23-bg);
    border: 1px solid var(--cv23-border);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv23-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv23-cyan);
    box-shadow: 0 12px 24px -6px rgba(13, 148, 136, 0.22);
  }

  .cv23-card *, .cv23-card *::before, .cv23-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv23-card a { color: inherit; text-decoration: none; }
  .cv23-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv23-card img { max-width: 100%; display: block; }

  .cv23-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: var(--cv23-light-cyan);
    overflow: hidden;
  }
  .cv23-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv23-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv23-card:hover .cv23-img-pri { opacity: 0; }
  .cv23-card:hover .cv23-img-sec { opacity: 1; transform: scale(1.05); }

  /* Derm Tag Top Left */
  .cv23-badge-derm {
    position: absolute; top: 10px; left: 10px;
    background: #0F766E; color: #FFFFFF;
    font-family: 'Space Grotesk', sans-serif; font-size: 9px; font-weight: 700; text-transform: uppercase;
    padding: 4px 9px; border-radius: 4px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv23-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid var(--cv23-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv23-cyan); z-index: 3; transition: all 0.2s ease;
  }
  .cv23-wish:hover, .cv23-wish.active { background: var(--cv23-cyan); color: #FFFFFF; border-color: var(--cv23-cyan); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv23-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(15, 118, 110, 0.95); color: #FFFFFF;
    font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    text-align: center; border-radius: 6px; border: 1px solid var(--cv23-cyan);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv23-card:hover .cv23-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv23-qv-overlay:hover { background: var(--cv23-cyan); color: #FFFFFF; }

  .cv23-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; }
  .cv23-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv23-cyan); font-weight: 700; font-family: 'Space Grotesk', sans-serif; letter-spacing: 0.08em; }
  .cv23-title { font-family: 'Space Grotesk', sans-serif; font-size: 15px; font-weight: 700; color: #0F766E; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Subtitle Derm Specs */
  .cv23-specs { font-size: 11px; color: var(--cv23-muted); font-weight: 500; }

  /* Rating Row */
  .cv23-rating { display: flex; align-items: center; gap: 4px; font-size: 11px; color: #0D9488; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv23-price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv23-price { font-family: 'Space Grotesk', sans-serif; font-size: 17px; font-weight: 800; color: #0F766E; }
  .cv23-cmp { font-size: 13px; color: #94A3B8; text-decoration: line-through; }
  .cv23-disc { font-size: 10px; font-weight: 800; color: #0F766E; background: var(--cv23-light-cyan); padding: 2px 6px; border-radius: 4px; }

  /* Volume Variant Selector */
  .cv23-sizes { display: flex; gap: 6px; overflow-x: auto; margin-top: 4px; }
  .cv23-size-btn {
    font-size: 10px; font-weight: 600; padding: 4px 9px; border-radius: 4px;
    border: 1px solid var(--cv23-border); background: #FFFFFF; color: #0F766E; cursor: pointer; transition: all 0.2s ease;
  }
  .cv23-size-btn.active, .cv23-size-btn:hover { background: #0F766E; color: #FFFFFF; border-color: #0F766E; }

  /* Bottom Button */
  .cv23-action-box { padding: 0 14px 14px; }
  .cv23-atc-btn {
    width: 100%; padding: 11px;
    background: var(--cv23-cyan); color: #FFFFFF;
    font-family: 'Space Grotesk', sans-serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 6px; border: none; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(13, 148, 136, 0.3);
  }
  .cv23-atc-btn:hover { background: #0F766E; transform: scale(1.01); }
  .cv23-atc-btn:disabled { background: #CBD5E1; color: #64748B; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv23-card" data-product-id="{{ card_prod.id }}">
    <span class="cv23-badge-derm">1% SALICYLIC ACID 🧪</span>

    <button type="button" class="cv23-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv23-media">
      {% if card_prod.featured_image %}
        <img src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv23-img cv23-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv23-img cv23-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-5' | placeholder_svg_tag: 'cv23-img' }}
      {% endif %}

      <button type="button" class="cv23-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv23-content">
      {% if card_prod.vendor != blank %}<span class="cv23-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv23-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv23-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv23-specs">Targets Strawberry Skin | pH 5.5 Balanced</span>

      <div class="cv23-rating">
        <span>★ 4.8</span> <span>(1,680 reviews)</span>
      </div>

      <div class="cv23-price-row">
        <span class="cv23-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv23-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv23-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Volume Variant Selector -->
      <div class="cv23-sizes">
        {% for variant in card_prod.variants limit: 2 %}
          <button type="button" class="cv23-size-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv23-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv23-atc-btn" data-add-cart="{{ cur_var.id }}">START CLEAR SKIN ROUTINE</button>
      {% else %}
        <button type="button" class="cv23-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv23-card">
    <div class="cv23-media">{{ 'product-5' | placeholder_svg_tag: 'cv23-img' }}</div>
    <div class="cv23-content">
      <span class="cv23-vendor">CLEAN BODYCARE D2C</span>
      <div class="cv23-title">Exfoliating Body Wash w/ 1% Salicylic Acid</div>

      {% if card_r_show != false %}
      <div class="cv23-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv23-specs">Targets Strawberry Skin | pH 5.5 Balanced</span>
      <div class="cv23-price-row"><span class="cv23-price">₹ 449</span><span class="cv23-cmp">₹ 599</span><span class="cv23-disc">25% OFF</span></div>
    </div>
  </div>
{% endif %}
