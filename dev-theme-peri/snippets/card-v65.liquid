{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V65 — CYBERPUNK MECHANICAL KEYBOARDS & GEAR D2C (KEYCHRON / GLORIOUS STYLE)
  Usage: {% render 'card-v65', product: product %}
  Design: Neon Cyan (#06B6D4), Cyber Dark (#0F172A), Orbitron & Plus Jakarta Sans fonts, 6px card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .cv65-card {
    --cv65-bg: #FFFFFF;
    --cv65-text: #0F172A;
    --cv65-muted: #0891B2;
    --cv65-cyan: #06B6D4;
    --cv65-dark: #0F172A;
    --cv65-light: #ECFEFF;
    --cv65-border: #A5F3FC;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cv65-bg);
    border: 1px solid var(--cv65-border);
    border-radius: 6px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv65-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv65-cyan);
    box-shadow: 0 12px 24px -6px rgba(6, 182, 212, 0.3);
  }

  .cv65-card *, .cv65-card *::before, .cv65-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv65-card a { color: inherit; text-decoration: none; }
  .cv65-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv65-card img { max-width: 100%; display: block; }

  .cv65-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: #0F172A;
    overflow: hidden;
  }
  .cv65-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv65-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv65-card:hover .cv65-img-pri { opacity: 0; }
  .cv65-card:hover .cv65-img-sec { opacity: 1; transform: scale(1.05); }

  /* Cyber Tag Top Left */
  .cv65-badge-key {
    position: absolute; top: 10px; left: 10px;
    background: var(--cv65-cyan); color: #0F172A;
    font-family: 'Orbitron', sans-serif; font-size: 9px; font-weight: 800; text-transform: uppercase;
    padding: 4px 9px; border-radius: 4px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv65-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #0F172A; border: 1px solid var(--cv65-cyan);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv65-cyan); z-index: 3; transition: all 0.2s ease;
  }
  .cv65-wish:hover, .cv65-wish.active { background: var(--cv65-cyan); color: #0F172A; transform: scale(1.1); }

  /* Quick View Overlay */
  .cv65-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(6, 182, 212, 0.95); color: #0F172A;
    font-family: 'Orbitron', sans-serif; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
    text-align: center; border-radius: 4px; border: 1px solid var(--cv65-cyan);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv65-card:hover .cv65-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv65-qv-overlay:hover { background: #0F172A; color: #06B6D4; }

  .cv65-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: left; }
  .cv65-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv65-cyan); font-weight: 800; font-family: 'Orbitron', sans-serif; letter-spacing: 0.08em; }
  .cv65-title { font-family: 'Orbitron', sans-serif; font-size: 15px; font-weight: 800; color: #0F172A; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Keyboard Specs Subtitle */
  .cv65-specs { font-size: 11px; color: #475569; font-weight: 600; }

  /* Rating Row */
  .cv65-rating { display: flex; align-items: center; gap: 4px; font-size: 11px; color: #0891B2; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv65-price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv65-price { font-family: 'Orbitron', sans-serif; font-size: 17px; font-weight: 800; color: #0F172A; }
  .cv65-cmp { font-size: 13px; color: #94A3B8; text-decoration: line-through; }
  .cv65-disc { font-size: 10px; font-weight: 800; color: #0F172A; background: var(--cv65-light); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--cv65-border); }

  /* Switch Variant Selector */
  .cv65-sizes { display: flex; gap: 6px; overflow-x: auto; margin-top: 4px; }
  .cv65-size-btn {
    font-size: 10px; font-weight: 700; padding: 4px 8px; border-radius: 4px;
    border: 1px solid var(--cv65-border); background: #FFFFFF; color: #0F172A; cursor: pointer; transition: all 0.2s ease;
  }
  .cv65-size-btn.active, .cv65-size-btn:hover { background: #06B6D4; color: #0F172A; border-color: #06B6D4; }

  /* Bottom Button */
  .cv65-action-box { padding: 0 14px 14px; }
  .cv65-atc-btn {
    width: 100%; padding: 11px;
    background: #0F172A; color: #06B6D4;
    font-family: 'Orbitron', sans-serif; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
    border-radius: 4px; border: 1px solid #06B6D4; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(6, 182, 212, 0.25);
  }
  .cv65-atc-btn:hover { background: #06B6D4; color: #0F172A; transform: scale(1.01); }
  .cv65-atc-btn:disabled { background: #E2E8F0; color: #94A3B8; border-color: #CBD5E1; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv65-card" data-product-id="{{ card_prod.id }}">
    <span class="cv65-badge-key">HOT-SWAPPABLE GASKET ⌨️</span>

    <button type="button" class="cv65-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv65-media">
      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv65-img cv65-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img height="{{ card_prod.images[1].height }}" width="{{ card_prod.images[1].width }}" src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv65-img cv65-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'cv65-img' }}
      {% endif %}

      <button type="button" class="cv65-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv65-content">
      {% if card_prod.vendor != blank %}<span class="cv65-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv65-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv65-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv65-specs">Gateron G Pro | QMK/VIA Support</span>

      <div class="cv65-rating">
        <span>★ 4.9</span> <span>(5,100 reviews)</span>
      </div>

      <div class="cv65-price-row">
        <span class="cv65-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv65-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv65-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Size Selector -->
      <div class="cv65-sizes">
        {% for variant in card_prod.variants limit: 3 %}
          <button type="button" class="cv65-size-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv65-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv65-atc-btn" data-add-cart="{{ cur_var.id }}">UPGRADE BATTLESTATION</button>
      {% else %}
        <button type="button" class="cv65-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv65-card">
    <div class="cv65-media">{{ 'product-1' | placeholder_svg_tag: 'cv65-img' }}</div>
    <div class="cv65-content">
      <span class="cv65-vendor">CUSTOM KEYBOARD D2C</span>
      <div class="cv65-title">75% Wireless Mechanical Keyboard w/ South-Facing RGB</div>

      {% if card_r_show != false %}
      <div class="cv65-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv65-specs">Gateron G Pro | QMK/VIA Support</span>
      <div class="cv65-price-row"><span class="cv65-price">₹ 7,999</span><span class="cv65-cmp">₹ 9,999</span><span class="cv65-disc">20% OFF</span></div>
    </div>
  </div>
{% endif %}
