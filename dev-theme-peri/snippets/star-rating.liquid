{% comment %}
  Universal Star Rating Snippet
  Accepts: product (Liquid product object), custom_value, custom_count
{% endcomment %}

{% assign rating_prod = product %}
{% assign rating_val = custom_value %}
{% assign rating_cnt = custom_count %}

{% if rating_prod != blank and rating_prod.metafields.reviews.rating.value != blank %}
  {% assign rating_val = rating_prod.metafields.reviews.rating.value %}
  {% assign rating_cnt = rating_prod.metafields.reviews.rating_count.value %}
{% endif %}

{% assign final_val = rating_val | default: '4.9' %}
{% assign final_cnt = rating_cnt | default: '128' %}

<div class="cf-star-rating" style="display: flex; align-items: center; gap: 4px; margin: 4px 0;">
  <span class="cf-star-rating__stars" style="color: var(--color-star, #F59E0B); font-size: 12px; letter-spacing: 1px;">★★★★★</span>
  <span class="cf-star-rating__val" style="font-size: 12px; font-weight: 700; color: var(--color-text, #111827);">{{ final_val }}</span>
  <span class="cf-star-rating__cnt" style="font-size: 11px; color: var(--color-text-muted, #6B7280);">({{ final_cnt }})</span>
</div>
