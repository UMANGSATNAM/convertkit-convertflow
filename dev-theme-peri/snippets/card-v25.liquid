{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V25 — SUSTAINABLE ECO-LIVING & BAMBOO ESSENTIALS D2C (BECO / BAMBOO INDIA STYLE)
  Usage: {% render 'card-v25', product: product %}
  Design: Earthy Sage Green (#3B5E43), Warm Linen (#F4F1EA), Fraunces Serif & Outfit fonts, 14px eco rounded card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,600;0,700;1,400&family=Outfit:wght@400;500;600;700&display=swap');

  .cv25-card {
    --cv25-bg: #FFFFFF;
    --cv25-text: #223727;
    --cv25-muted: #4B6E52;
    --cv25-sage: #3B5E43;
    --cv25-linen: #F4F1EA;
    --cv25-border: #D1C7B7;
    font-family: 'Outfit', sans-serif;
    background: var(--cv25-bg);
    border: 1px solid var(--cv25-border);
    border-radius: 14px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv25-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv25-sage);
    box-shadow: 0 12px 24px -6px rgba(59, 94, 67, 0.22);
  }

  .cv25-card *, .cv25-card *::before, .cv25-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv25-card a { color: inherit; text-decoration: none; }
  .cv25-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv25-card img { max-width: 100%; display: block; }

  .cv25-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: var(--cv25-linen);
    overflow: hidden;
  }
  .cv25-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv25-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv25-card:hover .cv25-img-pri { opacity: 0; }
  .cv25-card:hover .cv25-img-sec { opacity: 1; transform: scale(1.05); }

  /* Eco Tag Top Left */
  .cv25-badge-eco {
    position: absolute; top: 10px; left: 10px;
    background: #223727; color: #E2D9C8;
    font-family: 'Fraunces', serif; font-size: 9px; font-weight: 700; text-transform: uppercase;
    padding: 4px 9px; border-radius: 20px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv25-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid var(--cv25-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv25-sage); z-index: 3; transition: all 0.2s ease;
  }
  .cv25-wish:hover, .cv25-wish.active { background: var(--cv25-sage); color: #FFFFFF; border-color: var(--cv25-sage); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv25-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(34, 55, 39, 0.95); color: #E2D9C8;
    font-family: 'Fraunces', serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    text-align: center; border-radius: 8px; border: 1px solid var(--cv25-sage);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv25-card:hover .cv25-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv25-qv-overlay:hover { background: var(--cv25-sage); color: #FFFFFF; }

  .cv25-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }
  .cv25-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv25-sage); font-weight: 700; font-family: 'Fraunces', serif; letter-spacing: 0.08em; }
  .cv25-title { font-family: 'Fraunces', serif; font-size: 16px; font-weight: 700; color: #223727; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Eco Specs Subtitle */
  .cv25-specs { font-size: 11px; color: var(--cv25-muted); font-style: italic; }

  /* Rating Row */
  .cv25-rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; color: var(--cv25-sage); font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv25-price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv25-price { font-family: 'Fraunces', serif; font-size: 17px; font-weight: 700; color: #223727; }
  .cv25-cmp { font-size: 13px; color: #9CA3AF; text-decoration: line-through; }
  .cv25-disc { font-size: 10px; font-weight: 700; color: #223727; background: #E2D9C8; padding: 2px 6px; border-radius: 4px; }

  /* Pack Size Variant Selector */
  .cv25-sizes { display: flex; gap: 6px; overflow-x: auto; justify-content: center; margin-top: 4px; }
  .cv25-size-btn {
    font-size: 10px; font-weight: 600; padding: 4px 9px; border-radius: 6px;
    border: 1px solid var(--cv25-border); background: #FFFFFF; color: #223727; cursor: pointer; transition: all 0.2s ease;
  }
  .cv25-size-btn.active, .cv25-size-btn:hover { background: #223727; color: #FFFFFF; border-color: #223727; }

  /* Bottom Button */
  .cv25-action-box { padding: 0 14px 14px; }
  .cv25-atc-btn {
    width: 100%; padding: 11px;
    background: var(--cv25-sage); color: #FFFFFF;
    font-family: 'Fraunces', serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 8px; border: none; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(59, 94, 67, 0.3);
  }
  .cv25-atc-btn:hover { background: #223727; transform: scale(1.01); }
  .cv25-atc-btn:disabled { background: #D1C7B7; color: #9CA3AF; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv25-card" data-product-id="{{ card_prod.id }}">
    <span class="cv25-badge-eco">100% BIODEGRADABLE 🎋</span>

    <button type="button" class="cv25-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv25-media">
      {% if card_prod.featured_image %}
        <img src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv25-img cv25-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv25-img cv25-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-2' | placeholder_svg_tag: 'cv25-img' }}
      {% endif %}

      <button type="button" class="cv25-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv25-content">
      {% if card_prod.vendor != blank %}<span class="cv25-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv25-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv25-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv25-specs">Zero Plastic | FSC Certified Bamboo</span>

      <div class="cv25-rating">
        <span>★ 4.9</span> <span>(2,400 reviews)</span>
      </div>

      <div class="cv25-price-row">
        <span class="cv25-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv25-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv25-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Pack Size Variant Selector -->
      <div class="cv25-sizes">
        {% for variant in card_prod.variants limit: 3 %}
          <button type="button" class="cv25-size-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv25-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv25-atc-btn" data-add-cart="{{ cur_var.id }}">SWITCH TO ZERO WASTE</button>
      {% else %}
        <button type="button" class="cv25-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv25-card">
    <div class="cv25-media">{{ 'product-2' | placeholder_svg_tag: 'cv25-img' }}</div>
    <div class="cv25-content">
      <span class="cv25-vendor">ECO ESSENTIALS D2C</span>
      <div class="cv25-title">Organic Bamboo Charcoal Facial Tissues</div>

      {% if card_r_show != false %}
      <div class="cv25-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv25-specs">Zero Plastic | FSC Certified Bamboo</span>
      <div class="cv25-price-row"><span class="cv25-price">₹ 399</span><span class="cv25-cmp">₹ 599</span><span class="cv25-disc">33% OFF</span></div>
    </div>
  </div>
{% endif %}
