{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V62 — PREMIUM PET WELLNESS & ORGANIC PET FOOD D2C (THE FARMER'S DOG / OLLIE STYLE)
  Usage: {% render 'card-v62', product: product %}
  Design: Terracotta (#C86D51), Pet Mint (#E6F4EA), Plus Jakarta Sans & Bricolage Grotesque fonts, 12px card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .cv62-card {
    --cv62-bg: #FFFFFF;
    --cv62-text: #5A2E19;
    --cv62-muted: #C86D51;
    --cv62-terra: #C86D51;
    --cv62-mint: #E6F4EA;
    --cv62-border: #F7D6C8;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cv62-bg);
    border: 1px solid var(--cv62-border);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv62-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv62-terra);
    box-shadow: 0 12px 24px -6px rgba(200, 109, 81, 0.25);
  }

  .cv62-card *, .cv62-card *::before, .cv62-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv62-card a { color: inherit; text-decoration: none; }
  .cv62-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv62-card img { max-width: 100%; display: block; }

  .cv62-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: #FAF3E0;
    overflow: hidden;
  }
  .cv62-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv62-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv62-card:hover .cv62-img-pri { opacity: 0; }
  .cv62-card:hover .cv62-img-sec { opacity: 1; transform: scale(1.05); }

  /* Pet Tag Top Left */
  .cv62-badge-pet {
    position: absolute; top: 10px; left: 10px;
    background: var(--cv62-terra); color: #FFFFFF;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 9px; font-weight: 800; text-transform: uppercase;
    padding: 4px 9px; border-radius: 20px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv62-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid var(--cv62-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv62-terra); z-index: 3; transition: all 0.2s ease;
  }
  .cv62-wish:hover, .cv62-wish.active { background: var(--cv62-terra); color: #FFFFFF; border-color: var(--cv62-terra); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv62-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(200, 109, 81, 0.95); color: #FFFFFF;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    text-align: center; border-radius: 6px; border: 1px solid var(--cv62-terra);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv62-card:hover .cv62-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv62-qv-overlay:hover { background: #FFFFFF; color: #C86D51; }

  .cv62-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }
  .cv62-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv62-terra); font-weight: 800; font-family: 'Bricolage Grotesque', sans-serif; letter-spacing: 0.08em; }
  .cv62-title { font-family: 'Bricolage Grotesque', sans-serif; font-size: 16px; font-weight: 800; color: #5A2E19; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Pet Specs Subtitle */
  .cv62-specs { font-size: 11px; color: var(--cv62-muted); font-weight: 600; }

  /* Rating Row */
  .cv62-rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; color: #C86D51; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv62-price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv62-price { font-family: 'Bricolage Grotesque', sans-serif; font-size: 17px; font-weight: 800; color: #5A2E19; }
  .cv62-cmp { font-size: 13px; color: #9CA3AF; text-decoration: line-through; }
  .cv62-disc { font-size: 10px; font-weight: 800; color: #5A2E19; background: var(--cv62-mint); padding: 2px 6px; border-radius: 4px; }

  /* Size Selector */
  .cv62-sizes { display: flex; gap: 6px; overflow-x: auto; justify-content: center; margin-top: 4px; }
  .cv62-size-btn {
    font-size: 10px; font-weight: 700; padding: 4px 8px; border-radius: 6px;
    border: 1px solid var(--cv62-border); background: #FFFFFF; color: #5A2E19; cursor: pointer; transition: all 0.2s ease;
  }
  .cv62-size-btn.active, .cv62-size-btn:hover { background: #C86D51; color: #FFFFFF; border-color: #C86D51; }

  /* Bottom Button */
  .cv62-action-box { padding: 0 14px 14px; }
  .cv62-atc-btn {
    width: 100%; padding: 11px;
    background: #C86D51; color: #FFFFFF;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 6px; border: none; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(200, 109, 81, 0.3);
  }
  .cv62-atc-btn:hover { background: #5A2E19; transform: scale(1.01); }
  .cv62-atc-btn:disabled { background: #E5E7EB; color: #9CA3AF; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv62-card" data-product-id="{{ card_prod.id }}">
    <span class="cv62-badge-pet">100% HUMAN-GRADE 🐾</span>

    <button type="button" class="cv62-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv62-media">
      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv62-img cv62-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img height="{{ card_prod.images[1].height }}" width="{{ card_prod.images[1].width }}" src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv62-img cv62-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-3' | placeholder_svg_tag: 'cv62-img' }}
      {% endif %}

      <button type="button" class="cv62-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv62-content">
      {% if card_prod.vendor != blank %}<span class="cv62-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv62-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv62-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv62-specs">Grass-Fed Beef | Vet-Formulated</span>

      <div class="cv62-rating">
        <span>★ 4.9</span> <span>(4,900 reviews)</span>
      </div>

      <div class="cv62-price-row">
        <span class="cv62-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv62-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv62-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Size Selector -->
      <div class="cv62-sizes">
        {% for variant in card_prod.variants limit: 3 %}
          <button type="button" class="cv62-size-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv62-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv62-atc-btn" data-add-cart="{{ cur_var.id }}">NOURISH YOUR PUP</button>
      {% else %}
        <button type="button" class="cv62-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv62-card">
    <div class="cv62-media">{{ 'product-3' | placeholder_svg_tag: 'cv62-img' }}</div>
    <div class="cv62-content">
      <span class="cv62-vendor">PET WELLNESS D2C</span>
      <div class="cv62-title">Freeze-Dried Raw Beef & Superfood Dog Topper</div>

      {% if card_r_show != false %}
      <div class="cv62-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv62-specs">Grass-Fed Beef | Vet-Formulated</span>
      <div class="cv62-price-row"><span class="cv62-price">₹ 1,299</span><span class="cv62-cmp">₹ 1,599</span><span class="cv62-disc">19% OFF</span></div>
    </div>
  </div>
{% endif %}
