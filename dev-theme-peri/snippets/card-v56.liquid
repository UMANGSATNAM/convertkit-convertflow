{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V56 — CEREMONIAL MATCHA & JAPANESE TEA ATELIER D2C (IPPODO / ENCHA STYLE)
  Usage: {% render 'card-v56', product: product %}
  Design: Uji Matcha Green (#2D5A27), Tatami Parchment (#F4F1DE), Cormorant Garamond & Plus Jakarta Sans fonts, 8px card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .cv56-card {
    --cv56-bg: #FFFFFF;
    --cv56-text: #1B3818;
    --cv56-muted: #2D5A27;
    --cv56-matcha: #2D5A27;
    --cv56-tatami: #F4F1DE;
    --cv56-border: #D8E2DC;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cv56-bg);
    border: 1px solid var(--cv56-border);
    border-radius: 8px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv56-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv56-matcha);
    box-shadow: 0 12px 24px -6px rgba(45, 90, 39, 0.22);
  }

  .cv56-card *, .cv56-card *::before, .cv56-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv56-card a { color: inherit; text-decoration: none; }
  .cv56-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv56-card img { max-width: 100%; display: block; }

  .cv56-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: var(--cv56-tatami);
    overflow: hidden;
  }
  .cv56-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv56-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv56-card:hover .cv56-img-pri { opacity: 0; }
  .cv56-card:hover .cv56-img-sec { opacity: 1; transform: scale(1.05); }

  /* Matcha Tag Top Left */
  .cv56-badge-tea {
    position: absolute; top: 10px; left: 10px;
    background: #1B3818; color: #F4F1DE;
    font-family: 'Cormorant Garamond', serif; font-size: 10px; font-weight: 700; text-transform: uppercase;
    padding: 3px 8px; border-radius: 4px; z-index: 3; letter-spacing: 0.08em;
  }

  /* Wishlist Heart Top Right */
  .cv56-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid var(--cv56-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv56-matcha); z-index: 3; transition: all 0.2s ease;
  }
  .cv56-wish:hover, .cv56-wish.active { background: var(--cv56-matcha); color: #FFFFFF; border-color: var(--cv56-matcha); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv56-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(27, 56, 24, 0.95); color: #F4F1DE;
    font-family: 'Cormorant Garamond', serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    text-align: center; border-radius: 4px; border: 1px solid var(--cv56-matcha);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv56-card:hover .cv56-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv56-qv-overlay:hover { background: #F4F1DE; color: #1B3818; }

  .cv56-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }
  .cv56-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv56-muted); font-weight: 600; font-family: 'Cormorant Garamond', serif; letter-spacing: 0.1em; }
  .cv56-title { font-family: 'Cormorant Garamond', serif; font-size: 17px; font-weight: 700; color: #1B3818; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Tea Specs Subtitle */
  .cv56-specs { font-size: 11px; color: var(--cv56-muted); font-style: italic; }

  /* Rating Row */
  .cv56-rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; color: #2D5A27; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv56-price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv56-price { font-family: 'Cormorant Garamond', serif; font-size: 18px; font-weight: 700; color: #1B3818; }
  .cv56-cmp { font-size: 13px; color: #A8A29E; text-decoration: line-through; }
  .cv56-disc { font-size: 10px; font-weight: 700; color: #1B3818; background: var(--cv56-tatami); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--cv56-border); }

  /* Weight Variant Selector */
  .cv56-sizes { display: flex; gap: 6px; overflow-x: auto; justify-content: center; margin-top: 4px; }
  .cv56-size-btn {
    font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 4px;
    border: 1px solid var(--cv56-border); background: #FFFFFF; color: #1B3818; cursor: pointer; transition: all 0.2s ease;
  }
  .cv56-size-btn.active, .cv56-size-btn:hover { background: #2D5A27; color: #FFFFFF; border-color: #2D5A27; }

  /* Bottom Button */
  .cv56-action-box { padding: 0 14px 14px; }
  .cv56-atc-btn {
    width: 100%; padding: 11px;
    background: #2D5A27; color: #FFFFFF;
    font-family: 'Cormorant Garamond', serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    border-radius: 4px; border: none; transition: all 0.2s ease;
  }
  .cv56-atc-btn:hover { background: #1B3818; transform: scale(1.01); }
  .cv56-atc-btn:disabled { background: #E7E5E4; color: #A8A29E; cursor: not-allowed; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv56-card" data-product-id="{{ card_prod.id }}">
    <span class="cv56-badge-tea">100% FIRST HARVEST UJI MATCHA 🍵</span>

    <button type="button" class="cv56-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv56-media">
      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv56-img cv56-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img height="{{ card_prod.images[1].height }}" width="{{ card_prod.images[1].width }}" src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv56-img cv56-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'cv56-img' }}
      {% endif %}

      <button type="button" class="cv56-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv56-content">
      {% if card_prod.vendor != blank %}<span class="cv56-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv56-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv56-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv56-specs">Shade-Grown | 100% Stone-Ground</span>

      <div class="cv56-rating">
        <span>★ 4.9</span> <span>(4,800 reviews)</span>
      </div>

      <div class="cv56-price-row">
        <span class="cv56-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv56-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv56-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Weight Selector -->
      <div class="cv56-sizes">
        {% for variant in card_prod.variants limit: 3 %}
          <button type="button" class="cv56-size-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv56-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv56-atc-btn" data-add-cart="{{ cur_var.id }}">EMBARK ON TEA RITUAL</button>
      {% else %}
        <button type="button" class="cv56-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv56-card">
    <div class="cv56-media">{{ 'product-1' | placeholder_svg_tag: 'cv56-img' }}</div>
    <div class="cv56-content">
      <span class="cv56-vendor">JAPANESE MATCHA D2C</span>
      <div class="cv56-title">Ceremonial Grade First Harvest Uji Japanese Matcha</div>

      {% if card_r_show != false %}
      <div class="cv56-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv56-specs">Shade-Grown | 100% Stone-Ground</span>
      <div class="cv56-price-row"><span class="cv56-price">₹ 1,899</span><span class="cv56-cmp">₹ 2,299</span><span class="cv56-disc">17% OFF</span></div>
    </div>
  </div>
{% endif %}
