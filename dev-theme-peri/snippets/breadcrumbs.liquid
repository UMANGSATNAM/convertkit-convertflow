{% comment %}
  Universal Breadcrumbs Snippet
{% endcomment %}

<nav class="cf-breadcrumbs" aria-label="Breadcrumb" style="font-size: 13px; color: var(--color-text-muted, #6B7280); margin-bottom: 16px;">
  <a href="/" style="color: var(--color-text-muted, #6B7280); text-decoration: none;">Home</a>
  <span style="margin: 0 6px;">/</span>

  {% if template contains 'product' %}
    {% if collection %}
      <a href="{{ collection.url }}" style="color: var(--color-text-muted, #6B7280); text-decoration: none;">{{ collection.title }}</a>
      <span style="margin: 0 6px;">/</span>
    {% endif %}
    <span style="color: var(--color-text, #111827); font-weight: 600;">{{ product.title }}</span>

  {% elsif template contains 'collection' and collection.handle %}
    <span style="color: var(--color-text, #111827); font-weight: 600;">{{ collection.title }}</span>

  {% elsif template contains 'page' %}
    <span style="color: var(--color-text, #111827); font-weight: 600;">{{ page.title }}</span>

  {% else %}
    <span style="color: var(--color-text, #111827); font-weight: 600;">{{ page_title }}</span>
  {% endif %}
</nav>
