{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V40 — ERGONOMIC WORKSTATION & DESK ACCESSORIES D2C (GROVEMADE / ERGOYOU STYLE)
  Usage: {% render 'card-v40', product: product %}
  Design: American Walnut (#3B2319), Matte Steel (#18181B), Space Grotesk & Inter fonts, 8px card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap');

  .cv40-card {
    --cv40-bg: #FFFFFF;
    --cv40-text: #18181B;
    --cv40-muted: #52525B;
    --cv40-walnut: #3B2319;
    --cv40-cream: #FDFBF7;
    --cv40-border: #E4E4E7;
    font-family: 'Inter', sans-serif;
    background: var(--cv40-bg);
    border: 1px solid var(--cv40-border);
    border-radius: 8px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv40-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv40-walnut);
    box-shadow: 0 12px 24px -6px rgba(59, 35, 25, 0.22);
  }

  .cv40-card *, .cv40-card *::before, .cv40-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv40-card a { color: inherit; text-decoration: none; }
  .cv40-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv40-card img { max-width: 100%; display: block; }

  .cv40-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: var(--cv40-cream);
    overflow: hidden;
  }
  .cv40-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv40-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv40-card:hover .cv40-img-pri { opacity: 0; }
  .cv40-card:hover .cv40-img-sec { opacity: 1; transform: scale(1.05); }

  /* Desk Tag Top Left */
  .cv40-badge-desk {
    position: absolute; top: 10px; left: 10px;
    background: #3B2319; color: #FDFBF7;
    font-family: 'Space Grotesk', sans-serif; font-size: 9px; font-weight: 700; text-transform: uppercase;
    padding: 4px 9px; border-radius: 4px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv40-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid var(--cv40-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv40-walnut); z-index: 3; transition: all 0.2s ease;
  }
  .cv40-wish:hover, .cv40-wish.active { background: var(--cv40-walnut); color: #FFFFFF; border-color: var(--cv40-walnut); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv40-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(59, 35, 25, 0.95); color: #FDFBF7;
    font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    text-align: center; border-radius: 4px; border: 1px solid var(--cv40-walnut);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv40-card:hover .cv40-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv40-qv-overlay:hover { background: #FDFBF7; color: #3B2319; }

  .cv40-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: left; }
  .cv40-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv40-muted); font-weight: 700; font-family: 'Space Grotesk', sans-serif; letter-spacing: 0.08em; }
  .cv40-title { font-family: 'Space Grotesk', sans-serif; font-size: 15px; font-weight: 700; color: #18181B; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Wood Specs Subtitle */
  .cv40-specs { font-size: 11px; color: var(--cv40-muted); font-weight: 500; }

  /* Rating Row */
  .cv40-rating { display: flex; align-items: center; gap: 4px; font-size: 11px; color: #18181B; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv40-price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv40-price { font-family: 'Space Grotesk', sans-serif; font-size: 17px; font-weight: 800; color: #18181B; }
  .cv40-cmp { font-size: 13px; color: #A1A1AA; text-decoration: line-through; }
  .cv40-disc { font-size: 10px; font-weight: 800; color: #18181B; background: var(--cv40-cream); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--cv40-border); }

  /* Wood Finish Swatches */
  .cv40-swatches { display: flex; gap: 6px; align-items: center; margin-top: 4px; }
  .cv40-swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--cv40-border); cursor: pointer; }
  .cv40-swatch.active { transform: scale(1.25); border-color: var(--cv40-walnut); }

  /* Bottom Button */
  .cv40-action-box { padding: 0 14px 14px; }
  .cv40-atc-btn {
    width: 100%; padding: 11px;
    background: #3B2319; color: #FDFBF7;
    font-family: 'Space Grotesk', sans-serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 4px; border: none; transition: all 0.2s ease;
  }
  .cv40-atc-btn:hover { background: #18181B; color: #FFFFFF; transform: scale(1.01); }
  .cv40-atc-btn:disabled { background: #E4E4E7; color: #A1A1AA; cursor: not-allowed; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv40-card" data-product-id="{{ card_prod.id }}">
    <span class="cv40-badge-desk">SOLID WALNUT WOOD 🪵</span>

    <button type="button" class="cv40-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv40-media">
      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv40-img cv40-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img height="{{ card_prod.images[1].height }}" width="{{ card_prod.images[1].width }}" src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv40-img cv40-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-5' | placeholder_svg_tag: 'cv40-img' }}
      {% endif %}

      <button type="button" class="cv40-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv40-content">
      {% if card_prod.vendor != blank %}<span class="cv40-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv40-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv40-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv40-specs">Natural Oil Finish | Heavy Steel Legs</span>

      <div class="cv40-rating">
        <span>★ 4.9</span> <span>(2,350 reviews)</span>
      </div>

      <div class="cv40-price-row">
        <span class="cv40-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv40-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv40-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      {% if card_prod.variants.size > 1 %}
        <div class="cv40-swatches">
          {% for variant in card_prod.variants limit: 3 %}
            <span class="cv40-swatch {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}" style="background: {% cycle '#3B2319', '#D4A373', '#18181B' %};"></span>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="cv40-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv40-atc-btn" data-add-cart="{{ cur_var.id }}">ELEVATE YOUR DESK</button>
      {% else %}
        <button type="button" class="cv40-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv40-card">
    <div class="cv40-media">{{ 'product-5' | placeholder_svg_tag: 'cv40-img' }}</div>
    <div class="cv40-content">
      <span class="cv40-vendor">WORKSTATION D2C</span>
      <div class="cv40-title">Ergonomic Solid Walnut Desk Shelf Stand</div>

      {% if card_r_show != false %}
      <div class="cv40-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv40-specs">Natural Oil Finish | Heavy Steel Legs</span>
      <div class="cv40-price-row"><span class="cv40-price">₹ 11,999</span><span class="cv40-cmp">₹ 14,999</span><span class="cv40-disc">20% OFF</span></div>
    </div>
  </div>
{% endif %}
