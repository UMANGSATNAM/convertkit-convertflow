{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V20 — HIGH-PERFORMANCE GAMING GEAR & RGB PERIPHERALS D2C (RAZER / COSMIC BYTE STYLE)
  Usage: {% render 'card-v20', product: product %}
  Design: Stealth Matte Black (#0F0F10), Neon RGB Green (#00FF66), Orbitron & Space Grotesk fonts, 6px sharp gaming chassis
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800&family=Space+Grotesk:wght@600;700&display=swap');

  .cv20-card {
    --cv20-bg: #0F0F10;
    --cv20-card-bg: #161618;
    --cv20-text: #F8FAFC;
    --cv20-muted: #71717A;
    --cv20-green: #00FF66;
    --cv20-border: #00FF66;
    font-family: 'Space Grotesk', sans-serif;
    background: var(--cv20-card-bg);
    border: 1px solid #27272A;
    border-radius: 6px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv20-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv20-green);
    box-shadow: 0 0 20px rgba(0, 255, 102, 0.25);
  }

  .cv20-card *, .cv20-card *::before, .cv20-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv20-card a { color: inherit; text-decoration: none; }
  .cv20-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv20-card img { max-width: 100%; display: block; }

  .cv16-media, .cv20-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: #080809;
    overflow: hidden;
    border-bottom: 1px solid #27272A;
  }
  .cv20-img { width: 100%; height: 100%; object-fit: contain; padding: 16px; transition: transform 0.5s ease; }
  .cv20-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv20-card:hover .cv20-img-pri { opacity: 0; }
  .cv20-card:hover .cv20-img-sec { opacity: 1; transform: scale(1.06); }

  /* Gaming Tag Top Left */
  .cv20-badge-gaming {
    position: absolute; top: 10px; left: 10px;
    background: var(--cv20-green); color: #0F0F10;
    font-family: 'Orbitron', sans-serif; font-size: 9px; font-weight: 800; text-transform: uppercase;
    padding: 3px 8px; border-radius: 2px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv20-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #0F0F10; border: 1px solid var(--cv20-green);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv20-green); z-index: 3; transition: all 0.2s ease;
  }
  .cv20-wish:hover, .cv20-wish.active { background: var(--cv20-green); color: #0F0F10; transform: scale(1.1); }

  /* Quick View Overlay */
  .cv20-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(15, 15, 16, 0.95); color: var(--cv20-green);
    font-family: 'Orbitron', sans-serif; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
    text-align: center; border-radius: 4px; border: 1px solid var(--cv20-green);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv20-card:hover .cv20-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv20-qv-overlay:hover { background: var(--cv20-green); color: #0F0F10; }

  .cv20-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: left; }
  .cv20-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv20-green); font-weight: 800; font-family: 'Orbitron', sans-serif; letter-spacing: 0.1em; }
  .cv20-title { font-family: 'Orbitron', sans-serif; font-size: 15px; font-weight: 800; color: #FFFFFF; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-transform: uppercase; }

  /* Subtitle Tech Specs */
  .cv20-specs { font-size: 11px; color: var(--cv20-muted); font-weight: 500; }

  /* Rating Row */
  .cv20-rating { display: flex; align-items: center; gap: 4px; font-size: 11px; color: var(--cv20-green); font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv20-price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv20-price { font-family: 'Orbitron', sans-serif; font-size: 17px; font-weight: 800; color: #FFFFFF; }
  .cv20-cmp { font-size: 13px; color: var(--cv20-muted); text-decoration: line-through; }
  .cv20-disc { font-size: 10px; font-weight: 800; color: #0F0F10; background: var(--cv20-green); padding: 2px 6px; border-radius: 2px; }

  /* Switch Variant Selector */
  .cv20-switches-box { display: flex; gap: 6px; overflow-x: auto; margin-top: 4px; }
  .cv20-switch-btn {
    font-family: 'Orbitron', sans-serif; font-size: 9px; font-weight: 700; padding: 3px 8px; border-radius: 2px;
    border: 1px solid #3F3F46; background: #18181B; color: #FFFFFF; cursor: pointer; transition: all 0.2s ease;
  }
  .cv20-switch-btn.active, .cv20-switch-btn:hover { background: var(--cv20-green); color: #0F0F10; border-color: var(--cv20-green); }

  /* Bottom Button */
  .cv20-action-box { padding: 0 14px 14px; }
  .cv20-atc-btn {
    width: 100%; padding: 11px;
    background: var(--cv20-green); color: #0F0F10;
    font-family: 'Orbitron', sans-serif; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
    border-radius: 4px; border: none; transition: all 0.2s ease;
    box-shadow: 0 0 15px rgba(0, 255, 102, 0.35);
  }
  .cv20-atc-btn:hover { background: #FFFFFF; color: #0F0F10; transform: scale(1.01); box-shadow: 0 0 20px rgba(255, 255, 255, 0.4); }
  .cv20-atc-btn:disabled { background: #27272A; color: #71717A; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv20-card" data-product-id="{{ card_prod.id }}">
    <span class="cv20-badge-gaming">1MS ULTRA FAST 🎮</span>

    <button type="button" class="cv20-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv20-media">
      {% if card_prod.featured_image %}
        <img src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv20-img cv20-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv20-img cv20-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-4' | placeholder_svg_tag: 'cv20-img' }}
      {% endif %}

      <button type="button" class="cv20-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv20-content">
      {% if card_prod.vendor != blank %}<span class="cv20-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv20-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv20-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv20-specs">10,000 DPI Sensor | 89g Lightweight</span>

      <div class="cv20-rating">
        <span>★ 4.9</span> <span>(4,800 reviews)</span>
      </div>

      <div class="cv20-price-row">
        <span class="cv20-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv20-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv20-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Switch Variant Selector -->
      <div class="cv20-switches-box">
        {% for variant in card_prod.variants limit: 3 %}
          <button type="button" class="cv20-switch-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv20-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv20-atc-btn" data-add-cart="{{ cur_var.id }}">UNLOCK PRO GAMING</button>
      {% else %}
        <button type="button" class="cv20-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv20-card">
    <div class="cv20-media">{{ 'product-4' | placeholder_svg_tag: 'cv20-img' }}</div>
    <div class="cv20-content">
      <span class="cv20-vendor">GAMING GEAR D2C</span>
      <div class="cv20-title">Kilonova 3325 Lightweight RGB Gaming Mouse</div>

      {% if card_r_show != false %}
      <div class="cv20-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv20-specs">10,000 DPI Sensor | 89g Lightweight</span>
      <div class="cv20-price-row"><span class="cv20-price">₹ 2,499</span><span class="cv20-cmp">₹ 3,999</span><span class="cv20-disc">38% OFF</span></div>
    </div>
  </div>
{% endif %}
