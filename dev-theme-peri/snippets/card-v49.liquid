{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V49 — BOTANICAL HYDROSOLS & ORGANIC FACIAL MISTS D2C (HERBIVORE STYLE)
  Usage: {% render 'card-v49', product: product %}
  Design: Soft Rose (#EC4899), Dew Mist (#FDF2F8), Playfair Display & Inter fonts, 12px card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap');

  .cv49-card {
    --cv49-bg: #FFFFFF;
    --cv49-text: #831843;
    --cv49-muted: #DB2777;
    --cv49-pink: #EC4899;
    --cv49-dew: #FDF2F8;
    --cv49-border: #FBCFE8;
    font-family: 'Inter', sans-serif;
    background: var(--cv49-bg);
    border: 1px solid var(--cv49-border);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv49-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv49-pink);
    box-shadow: 0 12px 24px -6px rgba(236, 72, 153, 0.22);
  }

  .cv49-card *, .cv49-card *::before, .cv49-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv49-card a { color: inherit; text-decoration: none; }
  .cv49-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv49-card img { max-width: 100%; display: block; }

  .cv49-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: var(--cv49-dew);
    overflow: hidden;
  }
  .cv49-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv49-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv49-card:hover .cv49-img-pri { opacity: 0; }
  .cv49-card:hover .cv49-img-sec { opacity: 1; transform: scale(1.05); }

  /* Mist Tag Top Left */
  .cv49-badge-rose {
    position: absolute; top: 10px; left: 10px;
    background: #831843; color: #FDF2F8;
    font-family: 'Playfair Display', serif; font-size: 10px; font-weight: 700; text-transform: uppercase;
    padding: 3px 8px; border-radius: 4px; z-index: 3; letter-spacing: 0.08em;
  }

  /* Wishlist Heart Top Right */
  .cv49-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid var(--cv49-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv49-pink); z-index: 3; transition: all 0.2s ease;
  }
  .cv49-wish:hover, .cv49-wish.active { background: var(--cv49-pink); color: #FFFFFF; border-color: var(--cv49-pink); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv49-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(131, 24, 67, 0.95); color: #FDF2F8;
    font-family: 'Playfair Display', serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    text-align: center; border-radius: 6px; border: 1px solid var(--cv49-pink);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv49-card:hover .cv49-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv49-qv-overlay:hover { background: #FDF2F8; color: #831843; }

  .cv49-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }
  .cv49-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv49-muted); font-weight: 600; font-family: 'Playfair Display', serif; letter-spacing: 0.1em; }
  .cv49-title { font-family: 'Playfair Display', serif; font-size: 17px; font-weight: 700; color: #831843; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Mist Specs Subtitle */
  .cv49-specs { font-size: 11px; color: var(--cv49-muted); font-style: italic; }

  /* Rating Row */
  .cv49-rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; color: #DB2777; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv49-price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv49-price { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 700; color: #831843; }
  .cv49-cmp { font-size: 13px; color: #A8A29E; text-decoration: line-through; }
  .cv49-disc { font-size: 10px; font-weight: 700; color: #831843; background: var(--cv49-dew); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--cv49-border); }

  /* Size Variant Selector */
  .cv49-sizes { display: flex; gap: 6px; overflow-x: auto; justify-content: center; margin-top: 4px; }
  .cv49-size-btn {
    font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 4px;
    border: 1px solid var(--cv49-border); background: #FFFFFF; color: #831843; cursor: pointer; transition: all 0.2s ease;
  }
  .cv49-size-btn.active, .cv49-size-btn:hover { background: #EC4899; color: #FFFFFF; border-color: #EC4899; }

  /* Bottom Button */
  .cv49-action-box { padding: 0 14px 14px; }
  .cv49-atc-btn {
    width: 100%; padding: 11px;
    background: #EC4899; color: #FFFFFF;
    font-family: 'Playfair Display', serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    border-radius: 6px; border: none; transition: all 0.2s ease;
  }
  .cv49-atc-btn:hover { background: #831843; transform: scale(1.01); }
  .cv49-atc-btn:disabled { background: #E7E5E4; color: #A8A29E; cursor: not-allowed; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv49-card" data-product-id="{{ card_prod.id }}">
    <span class="cv49-badge-rose">100% STEAM DISTILLED 🌸</span>

    <button type="button" class="cv49-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv49-media">
      {% if card_prod.featured_image %}
        <img src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv49-img cv49-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv49-img cv49-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-6' | placeholder_svg_tag: 'cv49-img' }}
      {% endif %}

      <button type="button" class="cv49-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv49-content">
      {% if card_prod.vendor != blank %}<span class="cv49-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv49-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv49-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv49-specs">Pure Steam-Distilled Rose | Alcohol Free</span>

      <div class="cv49-rating">
        <span>★ 4.9</span> <span>(3,600 reviews)</span>
      </div>

      <div class="cv49-price-row">
        <span class="cv49-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv49-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv49-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Size Selector -->
      <div class="cv49-sizes">
        {% for variant in card_prod.variants limit: 3 %}
          <button type="button" class="cv49-size-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv49-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv49-atc-btn" data-add-cart="{{ cur_var.id }}">DEW YOUR SKIN</button>
      {% else %}
        <button type="button" class="cv49-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv49-card">
    <div class="cv49-media">{{ 'product-6' | placeholder_svg_tag: 'cv49-img' }}</div>
    <div class="cv49-content">
      <span class="cv49-vendor">BOTANICAL MISTS D2C</span>
      <div class="cv49-title">Organic Damask Rose Water Hydrosol Mist</div>

      {% if card_r_show != false %}
      <div class="cv49-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv49-specs">Pure Steam-Distilled Rose | Alcohol Free</span>
      <div class="cv49-price-row"><span class="cv49-price">₹ 899</span><span class="cv49-cmp">₹ 1,199</span><span class="cv49-disc">25% OFF</span></div>
    </div>
  </div>
{% endif %}
