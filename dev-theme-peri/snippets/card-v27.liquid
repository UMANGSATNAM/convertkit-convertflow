{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V27 — HERITAGE SINGLE-ESTATE TEA & ARTISANAL INFUSIONS D2C (VAHDAM TEAS / TWG STYLE)
  Usage: {% render 'card-v27', product: product %}
  Design: Royal Emerald Green (#064E3B), Burnished Gold (#D97706), Playfair Display & Montserrat fonts, 8px regal card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap');

  .cv27-card {
    --cv27-bg: #FFFFFF;
    --cv27-text: #064E3B;
    --cv27-muted: #047857;
    --cv27-emerald: #064E3B;
    --cv27-gold: #D97706;
    --cv27-cream: #FEF3C7;
    --cv27-border: #FCD34D;
    font-family: 'Montserrat', sans-serif;
    background: var(--cv27-bg);
    border: 1px solid var(--cv27-border);
    border-radius: 8px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv27-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv27-gold);
    box-shadow: 0 12px 24px -6px rgba(217, 119, 6, 0.25);
  }

  .cv27-card *, .cv27-card *::before, .cv27-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv27-card a { color: inherit; text-decoration: none; }
  .cv27-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv27-card img { max-width: 100%; display: block; }

  .cv27-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: #FFFBEB;
    overflow: hidden;
  }
  .cv27-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv27-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv27-card:hover .cv27-img-pri { opacity: 0; }
  .cv27-card:hover .cv27-img-sec { opacity: 1; transform: scale(1.05); }

  /* Tea Tag Top Left */
  .cv27-badge-tea {
    position: absolute; top: 10px; left: 10px;
    background: var(--cv27-emerald); color: #FCD34D;
    font-family: 'Playfair Display', serif; font-size: 9px; font-weight: 700; text-transform: uppercase;
    padding: 3px 9px; border-radius: 4px; z-index: 3; letter-spacing: 0.05em; border: 1px solid var(--cv27-gold);
  }

  /* Wishlist Heart Top Right */
  .cv27-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid var(--cv27-gold);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv27-emerald); z-index: 3; transition: all 0.2s ease;
  }
  .cv27-wish:hover, .cv27-wish.active { background: var(--cv27-emerald); color: #FCD34D; border-color: var(--cv27-emerald); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv27-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(6, 78, 59, 0.95); color: #FCD34D;
    font-family: 'Playfair Display', serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    text-align: center; border-radius: 4px; border: 1px solid var(--cv27-gold);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv27-card:hover .cv27-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv27-qv-overlay:hover { background: var(--cv27-gold); color: #FFFFFF; }

  .cv27-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }
  .cv27-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv27-gold); font-weight: 700; font-family: 'Playfair Display', serif; letter-spacing: 0.1em; }
  .cv27-title { font-family: 'Playfair Display', serif; font-size: 16px; font-weight: 700; color: #064E3B; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Tea Specs Subtitle */
  .cv27-specs { font-size: 11px; color: var(--cv27-muted); font-style: italic; }

  /* Rating Row */
  .cv27-rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; color: var(--cv27-gold); font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv27-price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv27-price { font-family: 'Playfair Display', serif; font-size: 17px; font-weight: 700; color: #064E3B; }
  .cv27-cmp { font-size: 13px; color: #9CA3AF; text-decoration: line-through; }
  .cv27-disc { font-size: 10px; font-weight: 700; color: #064E3B; background: var(--cv27-cream); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--cv27-gold); }

  /* Tin Size Variant Selector */
  .cv27-sizes { display: flex; gap: 6px; overflow-x: auto; justify-content: center; margin-top: 4px; }
  .cv27-size-btn {
    font-size: 10px; font-weight: 600; padding: 4px 9px; border-radius: 4px;
    border: 1px solid var(--cv27-border); background: #FFFFFF; color: #064E3B; cursor: pointer; transition: all 0.2s ease;
  }
  .cv27-size-btn.active, .cv27-size-btn:hover { background: #064E3B; color: #FCD34D; border-color: #064E3B; }

  /* Bottom Button */
  .cv27-action-box { padding: 0 14px 14px; }
  .cv27-atc-btn {
    width: 100%; padding: 11px;
    background: var(--cv27-emerald); color: #FCD34D;
    font-family: 'Playfair Display', serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 4px; border: 1px solid var(--cv27-gold); transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(6, 78, 59, 0.3);
  }
  .cv27-atc-btn:hover { background: var(--cv27-gold); color: #FFFFFF; transform: scale(1.01); }
  .cv27-atc-btn:disabled { background: #E5E7EB; color: #9CA3AF; cursor: not-allowed; border-color: #D1D5DB; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv27-card" data-product-id="{{ card_prod.id }}">
    <span class="cv27-badge-tea">DIRECT FROM ESTATES 🍃</span>

    <button type="button" class="cv27-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv27-media">
      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv27-img cv27-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img height="{{ card_prod.images[1].height }}" width="{{ card_prod.images[1].width }}" src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv27-img cv27-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-3' | placeholder_svg_tag: 'cv27-img' }}
      {% endif %}

      <button type="button" class="cv27-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv27-content">
      {% if card_prod.vendor != blank %}<span class="cv27-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv27-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv27-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv27-specs">Single-Estate Harvest | Notes of Muscatel</span>

      <div class="cv27-rating">
        <span>★ 4.9</span> <span>(3,400 reviews)</span>
      </div>

      <div class="cv27-price-row">
        <span class="cv27-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv27-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv27-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Tin Size Selector -->
      <div class="cv27-sizes">
        {% for variant in card_prod.variants limit: 3 %}
          <button type="button" class="cv27-size-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv27-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv27-atc-btn" data-add-cart="{{ cur_var.id }}">SAVOUR THE BREW</button>
      {% else %}
        <button type="button" class="cv27-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv27-card">
    <div class="cv27-media">{{ 'product-3' | placeholder_svg_tag: 'cv27-img' }}</div>
    <div class="cv27-content">
      <span class="cv27-vendor">HERITAGE TEA D2C</span>
      <div class="cv27-title">Himalayan Imperial Second Flush Oolong Tea</div>

      {% if card_r_show != false %}
      <div class="cv27-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv27-specs">Single-Estate Harvest | Notes of Muscatel</span>
      <div class="cv27-price-row"><span class="cv27-price">₹ 749</span><span class="cv27-cmp">₹ 999</span><span class="cv27-disc">25% OFF</span></div>
    </div>
  </div>
{% endif %}
