{% comment %}
  Universal Swatch Snippet
  Accepts: product (Liquid product object), option_name
{% endcomment %}

{% assign swatch_prod = product %}

<div class="cf-swatch-wrapper" style="display: flex; gap: 4px; margin-top: 6px; flex-wrap: wrap;">
  {% if swatch_prod != blank %}
    {% for option in swatch_prod.options_with_values %}
      {% assign down_name = option.name | downcase %}
      {% if down_name contains 'color' or down_name contains 'colour' or down_name contains 'shade' %}
        {% for value in option.values limit: 5 %}
          <span class="cf-swatch-item" title="{{ value }}" style="width: 14px; height: 14px; border-radius: 50%; border: 1px solid #D1D5DB; background: {{ value | downcase }}; display: inline-block; cursor: pointer;"></span>
        {% endfor %}
      {% endif %}
    {% endfor %}
  {% else %}
    <span class="cf-swatch-item" style="width: 14px; height: 14px; border-radius: 50%; background: #111827; display: inline-block;"></span>
    <span class="cf-swatch-item" style="width: 14px; height: 14px; border-radius: 50%; background: #E5E7EB; border: 1px solid #CCCCCC; display: inline-block;"></span>
    <span class="cf-swatch-item" style="width: 14px; height: 14px; border-radius: 50%; background: #3B82F6; display: inline-block;"></span>
  {% endif %}
</div>
