{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V5 — MEN'S GROOMING & TRIMMERS D2C (BOMBAY SHAVING COMPANY STYLE)
  Usage: {% render 'card-v5', product: product %}
  Design: Deep Navy Grooming (#0A192F), Royal Blue CTA (#0052CC), Emerald Green Save Badge (#00A86B), Orbitron & Outfit fonts, 10px rounded corners
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@700&family=Outfit:wght@500;600;700;800&display=swap');

  .cv5-card {
    --cv5-bg: #FFFFFF;
    --cv5-text: #0A192F;
    --cv5-muted: #64748B;
    --cv5-blue: #0052CC;
    --cv5-green: #00A86B;
    --cv5-light-green: #E6F8F0;
    --cv5-border: #E2E8F0;
    font-family: 'Outfit', sans-serif;
    background: var(--cv5-bg);
    border: 1px solid var(--cv5-border);
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv5-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv5-blue);
    box-shadow: 0 12px 24px -6px rgba(0, 82, 204, 0.18);
  }

  .cv5-card *, .cv5-card *::before, .cv5-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv5-card a { color: inherit; text-decoration: none; }
  .cv5-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv5-card img { max-width: 100%; display: block; }

  .cv5-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: #0F172A;
    overflow: hidden;
  }
  .cv5-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .cv5-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv5-card:hover .cv5-img-pri { opacity: 0; }
  .cv5-card:hover .cv5-img-sec { opacity: 1; transform: scale(1.05); }

  /* Wishlist Heart Top Right */
  .cv5-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.9); border: 1px solid #E2E8F0;
    display: flex; align-items: center; justify-content: center;
    color: var(--cv5-blue); z-index: 3; transition: all 0.2s ease;
  }
  .cv5-wish:hover, .cv5-wish.active { background: var(--cv5-blue); color: #FFFFFF; border-color: var(--cv5-blue); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv5-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(10, 25, 47, 0.95); color: #FFFFFF;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    text-align: center; border-radius: 6px; border: 1px solid var(--cv5-blue);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv5-card:hover .cv5-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv5-qv-overlay:hover { background: var(--cv5-blue); color: #FFFFFF; }

  .cv5-content { padding: 14px 14px 10px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; }
  .cv5-title { font-size: 14px; font-weight: 800; color: #0A192F; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Kit Included Items / Subtitle */
  .cv5-subtitle { font-size: 11px; color: var(--cv5-blue); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Rating Row */
  .cv5-rating { display: flex; align-items: center; gap: 4px; font-size: 11px; color: #0052CC; font-weight: 700; margin-top: 2px; }

  /* Pricing Row: ₹ Rupee + MRP + Green Save Pill */
  .cv5-price-row { display: flex; align-items: center; gap: 8px; margin-top: auto; flex-wrap: wrap; }
  .cv5-price { font-size: 16px; font-weight: 800; color: #0A192F; }
  .cv5-cmp { font-size: 13px; color: #94A3B8; text-decoration: line-through; }
  .cv5-save-pill {
    background: var(--cv5-green); color: #FFFFFF;
    font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 4px;
  }

  /* Bottom Full Width Royal Blue Button */
  .cv5-action-box { padding: 0 14px 14px; }
  .cv5-atc-btn {
    width: 100%; padding: 12px;
    background: var(--cv5-blue); color: #FFFFFF;
    font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
    border-radius: 6px; border: none; transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(0, 82, 204, 0.3);
  }
  .cv5-atc-btn:hover { background: #003D99; transform: scale(1.01); }
  .cv5-atc-btn:disabled { background: #94A3B8; color: #FFFFFF; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv5-card" data-product-id="{{ card_prod.id }}">
    <button type="button" class="cv5-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv5-media">
      {% if card_prod.featured_image %}
        <img src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv5-img cv5-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv5-img cv5-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-5' | placeholder_svg_tag: 'cv5-img' }}
      {% endif %}

      <button type="button" class="cv5-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv5-content">
      <a href="{{ card_prod.url }}" class="cv5-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv5-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv5-subtitle">Beard, Body, Nose, Shave [with hardcase]</span>

      <div class="cv5-rating">
        <span>★ 4.73</span> <span>| (1331 reviews)</span>
      </div>

      <div class="cv5-price-row">
        <span class="cv5-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv5-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv5-save-pill">Save {{ save_pct }}%</span>
        {% endif %}
      </div>
    </div>

    <div class="cv5-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv5-atc-btn" data-add-cart="{{ cur_var.id }}">ADD TO CART</button>
      {% else %}
        <button type="button" class="cv5-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv5-card">
    <div class="cv5-media">{{ 'product-5' | placeholder_svg_tag: 'cv5-img' }}</div>
    <div class="cv5-content">
      <div class="cv5-title">Full Body Trimmer Special Edition</div>

      {% if card_r_show != false %}
      <div class="cv5-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv5-subtitle">Beard, Body, Nose, Shave [with hardcase]</span>
      <div class="cv5-price-row"><span class="cv5-price">₹ 2,999</span><span class="cv5-cmp">₹ 5,000</span><span class="cv5-save-pill">Save 40%</span></div>
    </div>
  </div>
{% endif %}
