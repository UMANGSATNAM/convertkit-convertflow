{% comment %}
  Universal Pagination Snippet
  Accepts: paginate (Liquid paginate object)
{% endcomment %}

{% if paginate.pages > 1 %}
  <nav class="cf-pagination" aria-label="Pagination" style="display: flex; align-items: center; justify-content: center; gap: 8px; margin: 32px 0;">
    {% if paginate.previous %}
      <a href="{{ paginate.previous.url }}" style="padding: 8px 14px; border: 1px solid var(--color-border, #E5E7EB); border-radius: 6px; text-decoration: none; color: #111827; font-size: 13px; font-weight: 600;">&larr; Previous</a>
    {% endif %}

    <span style="font-size: 13px; font-weight: 600; color: #6B7280;">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>

    {% if paginate.next %}
      <a href="{{ paginate.next.url }}" style="padding: 8px 14px; border: 1px solid var(--color-border, #E5E7EB); border-radius: 6px; text-decoration: none; color: #111827; font-size: 13px; font-weight: 600;">Next &rarr;</a>
    {% endif %}
  </nav>
{% endif %}
