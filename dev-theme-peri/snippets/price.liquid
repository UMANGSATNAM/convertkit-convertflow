{%- liquid
  if use_variant
    assign target = variant
  else
    assign target = product.selected_or_first_available_variant
  endif

  assign compare_at_price = target.compare_at_price
  assign price = target.price
  assign available = target.available | default: false
  assign money_price = price | money

  if target == nil
    assign money_price = 1999 | money
    assign compare_at_price = 2999
    assign price = 1999
    assign available = true
  endif
-%}

<div class="price-container
  {%- if available == false %} price--sold-out {% endif -%}
  {%- if compare_at_price > price %} price--on-sale {% endif -%}">
  
  <div class="price__regular">
    <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
    <span class="price-item price-item--regular">
      {{ money_price }}
    </span>
  </div>

  <div class="price__sale">
    <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
    <span class="price-item price-item--sale">
      {{ money_price }}
    </span>
    {%- if compare_at_price > price -%}
      <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
      <s class="price-item price-item--compare">
        {{ compare_at_price | money }}
      </s>
    {%- endif -%}
  </div>

  {%- if target.unit_price_measurement -%}
    <small class="unit-price caption">
      <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
      <span class="price-item price-item--unit">
        <span>{{ target.unit_price | money }}</span>
        <span aria-hidden="true">/</span>
        <span class="visually-hidden">&nbsp;{{ 'products.product.price.unit_price_separator' | t }}&nbsp;</span>
        <span>
          {%- if target.unit_price_measurement.reference_value != 1 -%}
            {{- target.unit_price_measurement.reference_value -}}
          {%- endif -%}
          {{ target.unit_price_measurement.reference_unit }}
        </span>
      </span>
    </small>
  {%- endif -%}

  {%- if compare_at_price > price -%}
    <span class="price__badge-sale font-badge">
      {{ 'products.product.on_sale' | t }}
    </span>
  {%- endif -%}

  {%- if available == false -%}
    <span class="price__badge-sold font-badge">
      {{ 'products.product.sold_out' | t }}
    </span>
  {%- endif -%}
</div>
