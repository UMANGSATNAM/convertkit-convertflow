{% comment %}
  Universal Parametric Product Card
  Accepts:
  - product (Liquid product object)
  - card_style (string: 'clean' | 'modern' | 'minimal' | 'bold')
  - show_rating (boolean)
  - show_badges (boolean)
  - show_quick_add (boolean)
  - image_ratio (string: '1/1' | '3/4' | '4/5')
{% endcomment %}

{% assign card_prod = product %}
{% assign card_ratio = image_ratio | default: '3/4' %}
{% assign card_show_rating = show_rating %}
{% if card_show_rating == nil %}{% assign card_show_rating = true %}{% endif %}

{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  
  <div class="cf-card cf-card--{{ card_style | default: 'clean' }}" data-product-id="{{ card_prod.id }}">
    <!-- Image & Media -->
    <a href="{{ card_prod.url }}" class="cf-card__media" style="aspect-ratio: {{ card_ratio }}; position: relative; display: block; overflow: hidden; background: #F3F4F6; border-radius: var(--radius-card, 12px);">
      {% if show_badges != false %}
        {% render 'badge', product: card_prod %}
      {% endif %}

      {% if card_prod.featured_image %}
        <img height="{{ card_prod.featured_image.height }}" width="{{ card_prod.featured_image.width }}" src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cf-card__img" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;">
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'cf-card__placeholder' }}
      {% endif %}
    </a>

    <!-- Card Info -->
    <div class="cf-card__info" style="padding: 12px 0;">
      {% if card_prod.vendor != blank %}
        <div class="cf-card__vendor" style="font-size: 11px; text-transform: uppercase; tracking: 1px; color: var(--color-text-muted, #6B7280);">{{ card_prod.vendor }}</div>
      {% endif %}

      <a href="{{ card_prod.url }}" class="cf-card__title" style="font-size: 14px; font-weight: 600; color: var(--color-text, #111827); text-decoration: none; display: block; margin: 2px 0 4px;">{{ card_prod.title }}</a>

      {% if card_show_rating %}
        {% render 'star-rating', product: card_prod %}
      {% endif %}

      {% render 'price', product: card_prod %}
    </div>

    <!-- Quick Add Button -->
    {% if show_quick_add != false %}
      <div class="cf-card__actions" style="margin-top: 4px;">
        <button type="button" class="cf-card__atc-btn" data-add-cart="{{ cur_var.id }}" style="width: 100%; padding: 10px; background: var(--color-primary, #111827); color: #FFFFFF; border: none; border-radius: var(--radius-button, 8px); font-size: 13px; font-weight: 600; cursor: pointer;">
          Add to Cart
        </button>
      </div>
    {% endif %}
  </div>

{% else %}

  <!-- Universal Fallback Card -->
  <div class="cf-card cf-card--fallback">
    <div class="cf-card__media" style="aspect-ratio: {{ card_ratio }}; position: relative; display: block; overflow: hidden; background: #F3F4F6; border-radius: var(--radius-card, 12px);">
      {{ 'product-1' | placeholder_svg_tag: 'cf-card__placeholder' }}
    </div>

    <div class="cf-card__info" style="padding: 12px 0;">
      <div class="cf-card__vendor" style="font-size: 11px; text-transform: uppercase; color: #6B7280;">BRAND ESSENTIALS</div>
      <div class="cf-card__title" style="font-size: 14px; font-weight: 600; color: #111827; margin: 2px 0 4px;">Sample Premium Product</div>
      {% render 'star-rating', product: nil %}
      {% render 'price', product: nil %}
    </div>

    {% if show_quick_add != false %}
      <div class="cf-card__actions">
        <button type="button" class="cf-card__atc-btn" style="width: 100%; padding: 10px; background: var(--color-primary, #111827); color: #FFFFFF; border: none; border-radius: var(--radius-button, 8px); font-size: 13px; font-weight: 600; cursor: pointer;">
          Add to Cart
        </button>
      </div>
    {% endif %}
  </div>

{% endif %}
