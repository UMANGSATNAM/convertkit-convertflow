{% comment %}
  Accepts:
  - product: {Object} Product Liquid object
  - show_rating: {Boolean} Show rating stars
{% endcomment %}

{%- liquid
  assign is_sold_out = false
  if product.available == false
    assign is_sold_out = true
  endif
-%}

<style>
  .fresh-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--surface);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid var(--border);
    height: 100%;
    text-decoration: none;
    color: var(--text-main);
  }
  .fresh-card:hover {
    transform: translateY(calc(var(--space-4) * -1));
    box-shadow: var(--shadow-md);
  }
  .fresh-card__image-wrapper {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--bg-base);
  }
  .fresh-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .fresh-card:hover .fresh-card__image {
    transform: scale(1.05);
  }
  .fresh-card__image.is-sold-out {
    filter: grayscale(100%) opacity(0.7);
  }
  .fresh-card__sold-out-badge {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: var(--text-main);
    color: var(--surface);
    font-size: var(--text-12);
    font-weight: 600;
    padding: var(--space-8) var(--space-16);
    border-radius: var(--radius-pill);
    text-transform: uppercase;
    letter-spacing: 1px;
    z-index: 2;
  }
  .fresh-card__quick-view {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    text-align: center;
    padding: var(--space-8);
    font-size: var(--text-12);
    font-weight: 600;
    transform: translateY(100%);
    transition: transform 0.3s ease;
    border-top: 1px solid var(--border);
  }
  .fresh-card:hover .fresh-card__quick-view {
    transform: translateY(0);
  }
  .fresh-card__info {
    padding: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    flex-grow: 1;
  }
  .fresh-card__title {
    font-size: var(--text-14);
    font-weight: 600;
    margin: 0;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .fresh-card__price {
    font-size: var(--text-16);
    font-weight: 700;
    color: var(--primary);
  }
  .fresh-card__compare-price {
    font-size: var(--text-12);
    color: var(--text-muted);
    text-decoration: line-through;
    margin-left: var(--space-4);
  }
  .fresh-card__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }
  .fresh-card__add-btn {
    background-color: var(--primary);
    color: var(--surface);
    border: none;
    width: var(--space-32);
    height: var(--space-32);
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s;
    position: absolute;
    bottom: var(--space-16);
    right: var(--space-16);
    z-index: 3;
  }
  .fresh-card__add-btn:hover:not(:disabled) {
    background-color: var(--primary-hover);
  }
  .fresh-card__add-btn:disabled {
    background-color: var(--text-muted);
    cursor: not-allowed;
    opacity: 0.5;
  }
  .fresh-card__add-btn svg {
    width: var(--space-16);
    height: var(--space-16);
    fill: currentColor;
  }
</style>

<div class="fresh-card">
  <a href="{{ product.url | default: '#' }}" class="fresh-card__image-wrapper">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 600 }}" 
           alt="{{ product.title | escape }}" 
           class="fresh-card__image {% if is_sold_out %}is-sold-out{% endif %}"
           loading="lazy"
           width="600"
           height="600">
    {% else %}
      <div class="fresh-card__image" style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text-main); text-align: center; padding: 24px; width: 100%; height: 100%; min-height: 260px;">
        <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.45; margin-bottom: 12px;"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <span style="font-size: 11px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; opacity: 0.75;">{{ shop.name | default: 'AURELLE BEAUTY' }}</span>
        <span style="font-size: 9px; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase; opacity: 0.45; margin-top: 4px;">Botanical Formula</span>
      </div>
    {% endif %}

    {% if is_sold_out %}
      <div class="fresh-card__sold-out-badge">Sold Out</div>
    {% endif %}

    <div class="fresh-card__quick-view">
      Quick View
    </div>
  </a>

  <div class="fresh-card__info">
    <a href="{{ product.url | default: '#' }}" style="text-decoration: none; color: inherit;">
      <h3 class="fresh-card__title">{{ product.title | default: 'Example Product' }}</h3>
    </a>
    
    <div class="fresh-card__bottom">
      <div class="fresh-card__price-wrap">
        <span class="fresh-card__price">{{ product.price | default: 1999 | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="fresh-card__compare-price">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>
    </div>
  </div>

  <form method="post" action="/cart/add" class="fresh-card__add-form" onsubmit="event.preventDefault(); ajaxAdd(this);">
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id | default: '' }}">
    <button type="submit" class="fresh-card__add-btn" {% if is_sold_out %}disabled{% endif %} aria-label="Add to cart">
      <svg viewBox="0 0 24 24">
        <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
      </svg>
    </button>
  </form>
</div>

<script>
  if (typeof window.ajaxAdd !== 'function') {
    window.ajaxAdd = function(form) {
      const btn = form.querySelector('button');
      const originalHtml = btn.innerHTML;
      btn.innerHTML = '...';
      btn.disabled = true;
      
      const formData = new FormData(form);
      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        btn.innerHTML = '✓';
        setTimeout(() => {
          btn.innerHTML = originalHtml;
          btn.disabled = false;
        }, 2000);
      })
      .catch((error) => {
        console.error('Error:', error);
        btn.innerHTML = originalHtml;
        btn.disabled = false;
      });
    };
  }
</script>
