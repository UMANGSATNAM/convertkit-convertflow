{% comment %}
  HP1 GLOW — Design Tokens & Google Fonts
  ─────────────────────────────────────────
  Beauty / Skincare brand identity.
  Rendered from: hp1-announcement AND hp1-header
  CSS custom properties are idempotent — safe if rendered twice.
  Font link duplicated is harmless — browsers deduplicate identical requests.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap">

<style>
  :root {
    /* ── Typography ── */
    --hp1-font-heading: 'Cormorant Garamond', 'Georgia', serif;
    --hp1-font-body: 'DM Sans', 'Helvetica Neue', sans-serif;

    /* ── Brand Palette ── */
    --hp1-color-primary: #2D2926;
    --hp1-color-accent: #D4A59A;
    --hp1-color-accent-hover: #C48E82;
    --hp1-color-accent-light: #EDD5CE;

    /* ── Backgrounds ── */
    --hp1-color-bg: #FDF8F5;
    --hp1-color-bg-alt: #F5EDE8;
    --hp1-color-surface: #FFFFFF;

    /* ── Text ── */
    --hp1-color-text: #2D2926;
    --hp1-color-text-muted: #8C7E77;
    --hp1-color-text-inverse: #FDF8F5;

    /* ── UI ── */
    --hp1-color-border: #E8DDD6;
    --hp1-color-sale: #C45B3F;
    --hp1-color-star: #D4A059;
    --hp1-color-success: #4A7C59;

    /* ── Shape ── */
    --hp1-radius-card: 16px;
    --hp1-radius-btn: 99px;
    --hp1-radius-badge: 99px;
    --hp1-radius-input: 12px;

    /* ── Shadows ── */
    --hp1-shadow-sm: 0 2px 8px rgba(45, 41, 38, 0.06);
    --hp1-shadow-md: 0 4px 24px rgba(45, 41, 38, 0.08);
    --hp1-shadow-lg: 0 8px 32px rgba(45, 41, 38, 0.12);
    --hp1-shadow-xl: 0 16px 48px rgba(45, 41, 38, 0.16);

    /* ── Motion ── */
    --hp1-ease: cubic-bezier(0.4, 0, 0.2, 1);
    --hp1-duration-fast: 0.2s;
    --hp1-duration-base: 0.3s;
    --hp1-duration-slow: 0.6s;

    /* ── Layout ── */
    --hp1-page-max: 1280px;
    --hp1-section-pad-x: 1.25rem;
    --hp1-section-pad-y: 4rem;
  }

  @media (min-width: 768px) {
    :root {
      --hp1-section-pad-x: 2.5rem;
      --hp1-section-pad-y: 5rem;
    }
  }

  @media (min-width: 1024px) {
    :root {
      --hp1-section-pad-x: 3rem;
      --hp1-section-pad-y: 6rem;
    }
  }
</style>
