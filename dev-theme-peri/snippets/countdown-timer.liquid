{%- comment -%}
  Countdown value driven by theme settings (Settings → Social Proof & Urgency),
  so one place controls the deadline on every PDP.

  Usage — drop-in replacement for the old hardcoded timer:
    {% render 'countdown-timer' %}

  Overrides (optional):
    {% render 'countdown-timer', hours: 2, prefix: '⏰ ', class: 'my-timer' %}

  Rendering and ticking is handled by assets/countdown.js.
{%- endcomment -%}

{%- liquid
  assign cd_mode = mode | default: settings.countdown_mode | default: 'evergreen'
  assign cd_hours = hours | default: settings.countdown_hours | default: 4
  assign cd_end = end | default: settings.countdown_end
  assign cd_daily = daily | default: settings.countdown_daily_time | default: '23:59'
  assign cd_expired = expired | default: settings.countdown_expired_behaviour | default: 'message'
  assign cd_expired_text = expired_text | default: settings.countdown_expired_text | default: 'Offer ended'
  assign cd_prefix = prefix | default: settings.countdown_prefix | default: '🔥 '
  assign cd_class = class | default: ''
-%}

<span
  class="cf-countdown {{ cd_class }}"
  data-countdown
  data-countdown-mode="{{ cd_mode }}"
  data-countdown-hours="{{ cd_hours }}"
  {% if cd_end != blank %}data-countdown-end="{{ cd_end }}"{% endif %}
  data-countdown-daily="{{ cd_daily }}"
  data-countdown-expired="{{ cd_expired }}"
  data-countdown-expired-text="{{ cd_expired_text | escape }}"
  data-countdown-prefix="{{ cd_prefix }}"
  {% if product %}data-countdown-key="{{ product.handle }}"{% endif %}
  role="timer"
  aria-live="off">{{ cd_prefix }}--h --m --s</span>

{%- unless countdown_styles -%}
  {%- assign countdown_styles = true -%}
  <style>
    .cf-countdown {
      font-variant-numeric: tabular-nums;
      font-feature-settings: 'tnum';
      white-space: nowrap;
      display: inline-block;
    }
  </style>
{%- endunless -%}
