{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V29 — SMART BEDDING & SLEEP TECHNOLOGY D2C (WAKEFIT / SLEEPYHEAD STYLE)
  Usage: {% render 'card-v29', product: product %}
  Design: Sleep Navy (#1E1B4B), Soft Blue (#E0E7FF), Plus Jakarta Sans & Outfit fonts, 14px cloud rounded card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .cv29-card {
    --cv29-bg: #FFFFFF;
    --cv29-text: #1E1B4B;
    --cv29-muted: #3730A3;
    --cv29-navy: #1E1B4B;
    --cv29-soft-blue: #E0E7FF;
    --cv29-border: #C7D2FE;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cv29-bg);
    border: 1px solid var(--cv29-border);
    border-radius: 14px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv29-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv29-navy);
    box-shadow: 0 12px 24px -6px rgba(30, 27, 75, 0.22);
  }

  .cv29-card *, .cv29-card *::before, .cv29-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv29-card a { color: inherit; text-decoration: none; }
  .cv29-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv29-card img { max-width: 100%; display: block; }

  .cv29-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: #EEF2FF;
    overflow: hidden;
  }
  .cv29-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv29-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv29-card:hover .cv29-img-pri { opacity: 0; }
  .cv29-card:hover .cv29-img-sec { opacity: 1; transform: scale(1.05); }

  /* Sleep Tag Top Left */
  .cv29-badge-sleep {
    position: absolute; top: 10px; left: 10px;
    background: var(--cv29-navy); color: #818CF8;
    font-family: 'Outfit', sans-serif; font-size: 9px; font-weight: 800; text-transform: uppercase;
    padding: 4px 9px; border-radius: 20px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv29-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid var(--cv29-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv29-navy); z-index: 3; transition: all 0.2s ease;
  }
  .cv29-wish:hover, .cv29-wish.active { background: var(--cv29-navy); color: #FFFFFF; border-color: var(--cv29-navy); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv29-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(30, 27, 75, 0.95); color: #818CF8;
    font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    text-align: center; border-radius: 8px; border: 1px solid var(--cv29-soft-blue);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv29-card:hover .cv29-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv29-qv-overlay:hover { background: var(--cv29-soft-blue); color: #1E1B4B; }

  .cv29-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }
  .cv29-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv29-navy); font-weight: 800; font-family: 'Outfit', sans-serif; letter-spacing: 0.08em; }
  .cv29-title { font-family: 'Outfit', sans-serif; font-size: 16px; font-weight: 800; color: #1E1B4B; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Sleep Specs Subtitle */
  .cv29-specs { font-size: 11px; color: var(--cv29-muted); font-weight: 600; }

  /* Rating Row */
  .cv29-rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; color: #4F46E5; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv29-price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv29-price { font-family: 'Outfit', sans-serif; font-size: 17px; font-weight: 800; color: #1E1B4B; }
  .cv29-cmp { font-size: 13px; color: #9CA3AF; text-decoration: line-through; }
  .cv29-disc { font-size: 10px; font-weight: 800; color: #1E1B4B; background: var(--cv29-soft-blue); padding: 2px 6px; border-radius: 4px; }

  /* Bed Size Variant Selector */
  .cv29-sizes { display: flex; gap: 6px; overflow-x: auto; justify-content: center; margin-top: 4px; }
  .cv29-size-btn {
    font-size: 10px; font-weight: 700; padding: 4px 9px; border-radius: 6px;
    border: 1px solid var(--cv29-border); background: #FFFFFF; color: #1E1B4B; cursor: pointer; transition: all 0.2s ease;
  }
  .cv29-size-btn.active, .cv29-size-btn:hover { background: #1E1B4B; color: #FFFFFF; border-color: #1E1B4B; }

  /* Bottom Button */
  .cv29-action-box { padding: 0 14px 14px; }
  .cv29-atc-btn {
    width: 100%; padding: 11px;
    background: var(--cv29-navy); color: #FFFFFF;
    font-family: 'Outfit', sans-serif; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 8px; border: none; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(30, 27, 75, 0.3);
  }
  .cv29-atc-btn:hover { background: #3730A3; transform: scale(1.01); }
  .cv29-atc-btn:disabled { background: #E5E7EB; color: #9CA3AF; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv29-card" data-product-id="{{ card_prod.id }}">
    <span class="cv29-badge-sleep">100 NIGHTS TRIAL 🌙</span>

    <button type="button" class="cv29-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv29-media">
      {% if card_prod.featured_image %}
        <img src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv29-img cv29-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv29-img cv29-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-4' | placeholder_svg_tag: 'cv29-img' }}
      {% endif %}

      <button type="button" class="cv29-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv29-content">
      {% if card_prod.vendor != blank %}<span class="cv29-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv29-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv29-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv29-specs">Adaptive Pressure Relief | Zero Motion Transfer</span>

      <div class="cv29-rating">
        <span>★ 4.8</span> <span>(8,900 reviews)</span>
      </div>

      <div class="cv29-price-row">
        <span class="cv29-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv29-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv29-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Bed Size Selector -->
      <div class="cv29-sizes">
        {% for variant in card_prod.variants limit: 3 %}
          <button type="button" class="cv29-size-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv29-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv29-atc-btn" data-add-cart="{{ cur_var.id }}">CLAIM 100 NIGHTS TRIAL</button>
      {% else %}
        <button type="button" class="cv29-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv29-card">
    <div class="cv29-media">{{ 'product-4' | placeholder_svg_tag: 'cv29-img' }}</div>
    <div class="cv29-content">
      <span class="cv29-vendor">SMART BEDDING D2C</span>
      <div class="cv29-title">Orthopedic Memory Foam Dual-Comfort Mattress</div>

      {% if card_r_show != false %}
      <div class="cv29-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv29-specs">Adaptive Pressure Relief | Zero Motion Transfer</span>
      <div class="cv29-price-row"><span class="cv29-price">₹ 8,999</span><span class="cv29-cmp">₹ 12,999</span><span class="cv29-disc">30% OFF</span></div>
    </div>
  </div>
{% endif %}
