{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V64 — SPECIALTY CRAFT ROASTERY & WHOLE BEAN COFFEE D2C (BLUE BOTTLE / ONYX STYLE)
  Usage: {% render 'card-v64', product: product %}
  Design: Roasted Espresso (#292524), Warm Caramel (#D97706), Cormorant Garamond & Plus Jakarta Sans fonts, 6px card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .cv64-card {
    --cv64-bg: #FFFFFF;
    --cv64-text: #1C1917;
    --cv64-muted: #78350F;
    --cv64-espresso: #292524;
    --cv64-caramel: #D97706;
    --cv64-cream: #FFFBEB;
    --cv64-border: #E7E5E4;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cv64-bg);
    border: 1px solid var(--cv64-border);
    border-radius: 6px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv64-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv64-espresso);
    box-shadow: 0 12px 24px -6px rgba(41, 37, 36, 0.22);
  }

  .cv64-card *, .cv64-card *::before, .cv64-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv64-card a { color: inherit; text-decoration: none; }
  .cv64-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv64-card img { max-width: 100%; display: block; }

  .cv64-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: var(--cv64-cream);
    overflow: hidden;
  }
  .cv64-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv64-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv64-card:hover .cv64-img-pri { opacity: 0; }
  .cv64-card:hover .cv64-img-sec { opacity: 1; transform: scale(1.05); }

  /* Coffee Tag Top Left */
  .cv64-badge-bean {
    position: absolute; top: 10px; left: 10px;
    background: var(--cv64-espresso); color: #FFFBEB;
    font-family: 'Cormorant Garamond', serif; font-size: 10px; font-weight: 700; text-transform: uppercase;
    padding: 3px 8px; border-radius: 3px; z-index: 3; letter-spacing: 0.08em;
  }

  /* Wishlist Heart Top Right */
  .cv64-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid var(--cv64-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv64-espresso); z-index: 3; transition: all 0.2s ease;
  }
  .cv64-wish:hover, .cv64-wish.active { background: var(--cv64-espresso); color: #FFFFFF; border-color: var(--cv64-espresso); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv64-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(41, 37, 36, 0.95); color: #FFFBEB;
    font-family: 'Cormorant Garamond', serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    text-align: center; border-radius: 3px; border: 1px solid var(--cv64-espresso);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv64-card:hover .cv64-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv64-qv-overlay:hover { background: #FFFBEB; color: #292524; }

  .cv64-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }
  .cv64-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv64-caramel); font-weight: 700; font-family: 'Cormorant Garamond', serif; letter-spacing: 0.1em; }
  .cv64-title { font-family: 'Cormorant Garamond', serif; font-size: 17px; font-weight: 700; color: #1C1917; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Roast Specs Subtitle */
  .cv64-specs { font-size: 11px; color: #78350F; font-style: italic; }

  /* Rating Row */
  .cv64-rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; color: #D97706; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv64-price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv64-price { font-family: 'Cormorant Garamond', serif; font-size: 18px; font-weight: 700; color: #1C1917; }
  .cv64-cmp { font-size: 13px; color: #A8A29E; text-decoration: line-through; }
  .cv64-disc { font-size: 10px; font-weight: 700; color: #1C1917; background: var(--cv64-cream); padding: 2px 6px; border-radius: 3px; border: 1px solid var(--cv64-border); }

  /* Grind Selector */
  .cv64-sizes { display: flex; gap: 6px; overflow-x: auto; justify-content: center; margin-top: 4px; }
  .cv64-size-btn {
    font-size: 10px; font-weight: 600; padding: 4px 8px; border-radius: 4px;
    border: 1px solid var(--cv64-border); background: #FFFFFF; color: #1C1917; cursor: pointer; transition: all 0.2s ease;
  }
  .cv64-size-btn.active, .cv64-size-btn:hover { background: #292524; color: #FFFFFF; border-color: #292524; }

  /* Bottom Button */
  .cv64-action-box { padding: 0 14px 14px; }
  .cv64-atc-btn {
    width: 100%; padding: 11px;
    background: #292524; color: #FFFFFF;
    font-family: 'Cormorant Garamond', serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    border-radius: 3px; border: none; transition: all 0.2s ease;
  }
  .cv64-atc-btn:hover { background: #1C1917; transform: scale(1.01); }
  .cv64-atc-btn:disabled { background: #E7E5E4; color: #A8A29E; cursor: not-allowed; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv64-card" data-product-id="{{ card_prod.id }}">
    <span class="cv64-badge-bean">SINGLE-ORIGIN GEISHA ☕</span>

    <button type="button" class="cv64-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv64-media">
      {% if card_prod.featured_image %}
        <img src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv64-img cv64-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv64-img cv64-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-5' | placeholder_svg_tag: 'cv64-img' }}
      {% endif %}

      <button type="button" class="cv64-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv64-content">
      {% if card_prod.vendor != blank %}<span class="cv64-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv64-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv64-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv64-specs">Jasmine, Peach & Citrus | Light Roast</span>

      <div class="cv64-rating">
        <span>★ 4.9</span> <span>(3,400 reviews)</span>
      </div>

      <div class="cv64-price-row">
        <span class="cv64-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv64-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv64-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Size Selector -->
      <div class="cv64-sizes">
        {% for variant in card_prod.variants limit: 3 %}
          <button type="button" class="cv64-size-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv64-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv64-atc-btn" data-add-cart="{{ cur_var.id }}">BREW PURITY</button>
      {% else %}
        <button type="button" class="cv64-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv64-card">
    <div class="cv64-media">{{ 'product-5' | placeholder_svg_tag: 'cv64-img' }}</div>
    <div class="cv64-content">
      <span class="cv64-vendor">SPECIALTY COFFEE D2C</span>
      <div class="cv64-title">Ethiopia Yirgacheffe Washed Whole Bean Coffee</div>

      {% if card_r_show != false %}
      <div class="cv64-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv64-specs">Jasmine, Peach & Citrus | Light Roast</span>
      <div class="cv64-price-row"><span class="cv64-price">₹ 999</span><span class="cv64-cmp">₹ 1,249</span><span class="cv64-disc">20% OFF</span></div>
    </div>
  </div>
{% endif %}
