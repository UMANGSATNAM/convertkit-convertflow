{%- comment -%}
  Trust badge row for the cart drawer and checkout areas.

  Previously this loaded a PNG from a different store's Shopify CDN, which
  could disappear at any time. Now: the merchant uploads their own strip, and
  if they haven't, a clean inline SVG row renders instead — no external
  request, no broken image, and it inherits the surrounding text colour.

  Usage:
    {% render 'trust-badges' %}
    {% render 'trust-badges', image: section.settings.trust_image, text: section.settings.trust_text %}
{%- endcomment -%}

{%- liquid
  assign tb_image = image | default: settings.trust_badge_image
  assign tb_text = text | default: settings.trust_badge_text | default: 'Secure checkout · Easy returns · COD available'
-%}

{%- if tb_image != blank -%}
  <img
    src="{{ tb_image | image_url: width: 600 }}"
    alt="{{ tb_text | escape }}"
    width="600"
    height="{{ 600 | divided_by: tb_image.aspect_ratio | round }}"
    loading="lazy">
{%- else -%}
  <div class="cf-trust" role="list">
    <span class="cf-trust__item" role="listitem">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3l7 3v6c0 4.4-2.9 7.9-7 9-4.1-1.1-7-4.6-7-9V6l7-3z"/><path d="m9 12 2 2 4-4"/>
      </svg>
      <span>Secure checkout</span>
    </span>
    <span class="cf-trust__item" role="listitem">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/>
      </svg>
      <span>Easy returns</span>
    </span>
    <span class="cf-trust__item" role="listitem">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="6" width="20" height="12" rx="2"/><path d="M2 10h20"/>
      </svg>
      <span>COD available</span>
    </span>
  </div>

  {%- unless trust_badge_styles -%}
    {%- assign trust_badge_styles = true -%}
    <style>
      .cf-trust {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 14px;
        margin-bottom: 12px;
        font-size: 11px;
        line-height: 1.3;
        opacity: 0.85;
      }
      .cf-trust__item { display: inline-flex; align-items: center; gap: 5px; }
      .cf-trust__item svg { width: 14px; height: 14px; flex: 0 0 14px; }
      @media screen and (max-width: 479px) {
        .cf-trust { gap: 5px 10px; font-size: 10px; }
      }
    </style>
  {%- endunless -%}
{%- endif -%}
