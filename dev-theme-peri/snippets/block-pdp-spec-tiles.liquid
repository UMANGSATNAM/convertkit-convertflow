<div class="sf-pdp-specs sf-stagger-item" {{ block.shopify_attributes }}>
                  <div class="sf-spec-tiles">
                    {%- if block.settings.spec_name_1 != blank -%}
                    <div class="sf-spec-tile">
                      <div class="sf-spec-val">{{ block.settings.spec_val_1 }}</div>
                      <div class="sf-spec-name">{{ block.settings.spec_name_1 }}</div>
                    </div>
                    {%- endif -%}
                    {%- if block.settings.spec_name_2 != blank -%}
                    <div class="sf-spec-tile">
                      <div class="sf-spec-val">{{ block.settings.spec_val_2 }}</div>
                      <div class="sf-spec-name">{{ block.settings.spec_name_2 }}</div>
                    </div>
                    {%- endif -%}
                    {%- if block.settings.spec_name_3 != blank -%}
                    <div class="sf-spec-tile">
                      <div class="sf-spec-val">{{ block.settings.spec_val_3 }}</div>
                      <div class="sf-spec-name">{{ block.settings.spec_name_3 }}</div>
                    </div>
                    {%- endif -%}
                  </div>
                </div>
