{% assign card_r_show = show_rating %}
{% if card_r_show == nil %}{% assign card_r_show = true %}{% endif %}
{% assign card_r_val = rating_value | default: card_prod.metafields.reviews.rating.value | default: '4.9' %}
{% assign card_r_cnt = rating_count | default: card_prod.metafields.reviews.rating_count.value | default: '128' %}
{%- comment -%}
  CARD V48 — ORGANIC COLD-PRESSED JUICES & WELLNESS SHOTS D2C (PRESSED JUICERY STYLE)
  Usage: {% render 'card-v48', product: product %}
  Design: Citrus Amber (#D97706), Soft Citrus (#FEF3C7), Plus Jakarta Sans & Bricolage Grotesque fonts, 12px card
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .cv48-card {
    --cv48-bg: #FFFFFF;
    --cv48-text: #78350F;
    --cv48-muted: #D97706;
    --cv48-amber: #D97706;
    --cv48-soft: #FEF3C7;
    --cv48-border: #FDE68A;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cv48-bg);
    border: 1px solid var(--cv48-border);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cv48-card:hover {
    transform: translateY(-4px);
    border-color: var(--cv48-amber);
    box-shadow: 0 12px 24px -6px rgba(217, 119, 6, 0.25);
  }

  .cv48-card *, .cv48-card *::before, .cv48-card *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .cv48-card a { color: inherit; text-decoration: none; }
  .cv48-card button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .cv48-card img { max-width: 100%; display: block; }

  .cv48-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: #FFFBEB;
    overflow: hidden;
  }
  .cv48-img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.5s ease; }
  .cv48-img-sec { position: absolute; top: 0; left: 0; opacity: 0; }
  .cv48-card:hover .cv48-img-pri { opacity: 0; }
  .cv48-card:hover .cv48-img-sec { opacity: 1; transform: scale(1.05); }

  /* Juice Tag Top Left */
  .cv48-badge-juice {
    position: absolute; top: 10px; left: 10px;
    background: var(--cv48-amber); color: #FFFFFF;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 9px; font-weight: 800; text-transform: uppercase;
    padding: 4px 9px; border-radius: 20px; z-index: 3; letter-spacing: 0.05em;
  }

  /* Wishlist Heart Top Right */
  .cv48-wish {
    position: absolute; top: 10px; right: 10px;
    width: 34px; height: 34px; border-radius: 50%;
    background: #FFFFFF; border: 1px solid var(--cv48-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--cv48-amber); z-index: 3; transition: all 0.2s ease;
  }
  .cv48-wish:hover, .cv48-wish.active { background: var(--cv48-amber); color: #FFFFFF; border-color: var(--cv48-amber); transform: scale(1.1); }

  /* Quick View Overlay */
  .cv48-qv-overlay {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    padding: 9px; background: rgba(217, 119, 6, 0.95); color: #FFFFFF;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    text-align: center; border-radius: 6px; border: 1px solid var(--cv48-amber);
    opacity: 0; transform: translateY(10px); transition: all 0.3s ease; z-index: 4;
  }
  .cv48-card:hover .cv48-qv-overlay { opacity: 1; transform: translateY(0); }
  .cv48-qv-overlay:hover { background: #FFFFFF; color: #D97706; }

  .cv48-content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }
  .cv48-vendor { font-size: 10px; text-transform: uppercase; color: var(--cv48-amber); font-weight: 800; font-family: 'Bricolage Grotesque', sans-serif; letter-spacing: 0.08em; }
  .cv48-title { font-family: 'Bricolage Grotesque', sans-serif; font-size: 16px; font-weight: 800; color: #78350F; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Juice Specs Subtitle */
  .cv48-specs { font-size: 11px; color: var(--cv48-muted); font-weight: 600; }

  /* Rating Row */
  .cv48-rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; color: #D97706; font-weight: 700; }

  /* Price Row: ₹ Rupee + MRP + Discount */
  .cv48-price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .cv48-price { font-family: 'Bricolage Grotesque', sans-serif; font-size: 17px; font-weight: 800; color: #78350F; }
  .cv48-cmp { font-size: 13px; color: #9CA3AF; text-decoration: line-through; }
  .cv48-disc { font-size: 10px; font-weight: 800; color: #78350F; background: var(--cv48-soft); padding: 2px 6px; border-radius: 4px; }

  /* Size Variant Selector */
  .cv48-sizes { display: flex; gap: 6px; overflow-x: auto; justify-content: center; margin-top: 4px; }
  .cv48-size-btn {
    font-size: 10px; font-weight: 700; padding: 4px 8px; border-radius: 6px;
    border: 1px solid var(--cv48-border); background: #FFFFFF; color: #78350F; cursor: pointer; transition: all 0.2s ease;
  }
  .cv48-size-btn.active, .cv48-size-btn:hover { background: #D97706; color: #FFFFFF; border-color: #D97706; }

  /* Bottom Button */
  .cv48-action-box { padding: 0 14px 14px; }
  .cv48-atc-btn {
    width: 100%; padding: 11px;
    background: #D97706; color: #FFFFFF;
    font-family: 'Bricolage Grotesque', sans-serif; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    border-radius: 8px; border: none; transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(217, 119, 6, 0.3);
  }
  .cv48-atc-btn:hover { background: #78350F; transform: scale(1.01); }
  .cv48-atc-btn:disabled { background: #E5E7EB; color: #9CA3AF; cursor: not-allowed; box-shadow: none; }
</style>

{% assign card_prod = product %}
{% if card_prod != blank %}
  {% assign cur_var = card_prod.selected_or_first_available_variant %}
  <div class="cv48-card" data-product-id="{{ card_prod.id }}">
    <span class="cv48-badge-juice">100% RAW COLD-PRESSED 🍊</span>

    <button type="button" class="cv48-wish" data-wishlist-toggle data-wishlist-handle="{{ card_prod.handle }}" data-wishlist-id="{{ card_prod.id }}" data-wishlist-title="{{ card_prod.title | escape }}" data-wishlist-price="{{ card_prod.price | money | strip_html | escape }}" data-wishlist-image="{{ card_prod.featured_image | image_url: width: 300 }}" data-wishlist-url="{{ card_prod.url }}" aria-pressed="false" aria-label="Add to wishlist">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    </button>

    <a href="{{ card_prod.url }}" class="cv48-media">
      {% if card_prod.featured_image %}
        <img src="{{ card_prod.featured_image | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv48-img cv48-img-pri" loading="lazy">
        {% if card_prod.images.size > 1 %}
          <img src="{{ card_prod.images[1] | image_url: width: 600 }}" alt="{{ card_prod.title | escape }}" class="cv48-img cv48-img-sec" loading="lazy">
        {% endif %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'cv48-img' }}
      {% endif %}

      <button type="button" class="cv48-qv-overlay" data-quick-view="{{ card_prod.handle }}">QUICK VIEW</button>
    </a>

    <div class="cv48-content">
      {% if card_prod.vendor != blank %}<span class="cv48-vendor">{{ card_prod.vendor }}</span>{% endif %}
      <a href="{{ card_prod.url }}" class="cv48-title">{{ card_prod.title }}</a>

      {% if card_r_show != false %}
      <div class="cv48-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv48-specs">Zero Added Sugar | Unpasteurized</span>

      <div class="cv48-rating">
        <span>★ 4.9</span> <span>(2,400 reviews)</span>
      </div>

      <div class="cv48-price-row">
        <span class="cv48-price">{{ card_prod.price | money }}</span>
        {% if card_prod.compare_at_price > card_prod.price %}
          <span class="cv48-cmp">{{ card_prod.compare_at_price | money }}</span>
          {% assign save_pct = card_prod.compare_at_price | minus: card_prod.price | times: 100.0 | divided_by: card_prod.compare_at_price | round %}
          <span class="cv48-disc">{{ save_pct }}% OFF</span>
        {% endif %}
      </div>

      <!-- Size Selector -->
      <div class="cv48-sizes">
        {% for variant in card_prod.variants limit: 3 %}
          <button type="button" class="cv48-size-btn {% if variant.id == cur_var.id %}active{% endif %}" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="cv48-action-box">
      {% if card_prod.available %}
        <button type="button" class="cv48-atc-btn" data-add-cart="{{ cur_var.id }}">NOURISH YOUR IMMUNITY</button>
      {% else %}
        <button type="button" class="cv48-atc-btn" disabled>SOLD OUT</button>
      {% endif %}
    </div>
  </div>
{% else %}
  <div class="cv48-card">
    <div class="cv48-media">{{ 'product-1' | placeholder_svg_tag: 'cv48-img' }}</div>
    <div class="cv48-content">
      <span class="cv48-vendor">COLD PRESSED JUICES D2C</span>
      <div class="cv48-title">Immunity Booster Organic Ginger Turmeric Shot</div>

      {% if card_r_show != false %}
      <div class="cv48-rating-box" style="display: flex; align-items: center; gap: 4px; margin: 4px 0 6px;">
        <span style="color: #F59E0B; font-size: 12px; letter-spacing: 1px;">★★★★★</span>
        <span style="font-size: 12px; font-weight: 700; color: #111827;">{{ card_r_val }}</span>
        <span style="font-size: 11px; color: #6B7280;">({{ card_r_cnt }})</span>
      </div>
    {% endif %}
      <span class="cv48-specs">Zero Added Sugar | Unpasteurized</span>
      <div class="cv48-price-row"><span class="cv48-price">₹ 599</span><span class="cv48-cmp">₹ 799</span><span class="cv48-disc">25% OFF</span></div>
    </div>
  </div>
{% endif %}
