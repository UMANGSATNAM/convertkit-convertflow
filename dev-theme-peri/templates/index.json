        "cta_url": "/pages/about",
        "badge_text": "Est. 2021 — NYC / Tokyo / Berlin",
        "bg_color": "#F3F4F5",
        "primary_color": "#0066FF",
        "text_dark": "#282A2F",
        "text_body": "#7B818E"
      }
