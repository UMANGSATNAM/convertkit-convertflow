{%- comment -%}
  PC V50 — VIBRANT Y2K POP-UP STORE PRODUCT GRID
  Design: Candy Red Cream (#FEF2F2), Candy Red (#EF4444) & Electric Amber (#F59E0B) accents, Fredoka & Lexend typography
  Card Shape: 18px corners, 2px candy red borders, 3D offset pop-up shadow
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Lexend:wght@500;600;700&display=swap');

  .pcv50 {
    --bg: {{ section.settings.bg_color | default: '#FEF2F2' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#7F1D1D' }};
    --muted: {{ section.settings.muted_color | default: '#F87171' }};
    --accent: {{ section.settings.accent_color | default: '#EF4444' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#DC2626' }};
    --border: {{ section.settings.border_color | default: '#EF4444' }};
    --badge-sale-bg: #EF4444;
    --badge-sale-text: #FFFFFF;
    --f-heading: 'Fredoka', cursive;
    --f-body: 'Lexend', sans-serif;
    --r-card: 18px;
    --ease: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv50 *, .pcv50 *::before, .pcv50 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv50 a { color: inherit; text-decoration: none; }
  .pcv50 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv50 img { max-width: 100%; display: block; }

  .pcv50__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv50__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv50__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv50__title { font-family: var(--f-heading); font-size: 32px; font-weight: 700; color: var(--text); letter-spacing: -0.01em; }
  @media (min-width: 768px) { .pcv50__title { font-size: 42px; } }
  .pcv50__sub { font-size: 15px; color: var(--muted); font-weight: 600; }
  .pcv50__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; font-family: var(--f-heading); color: #FFFFFF; background: var(--accent); padding: 10px 22px; border-radius: 20px; border: 2px solid #7F1D1D; box-shadow: 3px 3px 0px #7F1D1D; transition: var(--ease); }
  .pcv50__viewall:hover { background: #F59E0B; color: #7F1D1D; transform: translate(-2px, -2px); box-shadow: 5px 5px 0px #7F1D1D; }

  /* GRID */
  .pcv50__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv50__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv50__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv50__card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 4px 4px 0px #EF4444;
    transition: var(--ease);
  }
  .pcv50__card:hover {
    transform: translate(-3px, -4px);
    box-shadow: 7px 8px 0px #EF4444;
    border-color: #F59E0B;
  }

  /* IMAGE CONTAINER */
  .pcv50__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #FEE2E2;
    overflow: hidden;
  }
  .pcv50__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pcv50__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv50__card:hover .pcv50__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.06);
    {% endif %}
  }
  .pcv50__card:hover .pcv50__img--sec { opacity: 1; transform: scale(1.06); }

  /* BADGES */
  .pcv50__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv50__badge { font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 4px 10px; border-radius: 12px; letter-spacing: 0.05em; font-family: var(--f-heading); border: 1.5px solid #7F1D1D; }
  .pcv50__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv50__badge--tag { background: #F59E0B; color: #7F1D1D; }
  .pcv50__badge--sold { background: #9CA3AF; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv50__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 2px solid #EF4444;
    display: flex; align-items: center; justify-content: center;
    color: #EF4444;
    z-index: 3;
    transition: var(--ease);
  }
  .pcv50__wish:hover { background: #EF4444; color: #FFFFFF; transform: scale(1.15); }
  .pcv50__wish.active { color: #FFFFFF; background: #EF4444; }

  /* QUICK ADD BUTTON */
  .pcv50__quick-box { padding: 12px; background: var(--card-bg); }
  .pcv50__quick-btn {
    width: 100%;
    padding: 10px 16px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 13px; font-weight: 800; font-family: var(--f-heading);
    border-radius: 20px;
    border: 2px solid #7F1D1D;
    box-shadow: 2px 3px 0px #7F1D1D;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv50__quick-btn:hover { background: var(--accent-hover); transform: translate(-2px, -2px); box-shadow: 4px 5px 0px #7F1D1D; }
  .pcv50__quick-btn:disabled { background: #E5E7EB; color: #9CA3AF; cursor: not-allowed; box-shadow: none; border-color: #D1D5DB; }

  /* CARD CONTENT */
  .pcv50__content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv50__vendor { font-size: 11px; text-transform: uppercase; color: #EF4444; font-weight: 700; font-family: var(--f-heading); letter-spacing: 0.05em; }
  .pcv50__item-title { font-family: var(--f-heading); font-size: 17px; font-weight: 800; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv50__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 13px; color: #F59E0B; font-weight: 700; }
  .pcv40__stars { letter-spacing: 1px; }
  .pcv50__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 600; }

  /* PRICE */
  .pcv50__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv50__price { font-size: 18px; font-weight: 800; color: var(--text); font-family: var(--f-heading); }
  .pcv50__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv50__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv50__swatch { width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid #EF4444; cursor: pointer; transition: var(--ease); }
  .pcv50__swatch:hover, .pcv50__swatch.active { transform: scale(1.25); border-color: #EF4444; }

  /* URGENCY MICRO */
  .pcv50__urgency { font-size: 11px; color: #EF4444; font-weight: 800; font-family: var(--f-heading); display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv50__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #FFFFFF;
    padding: 12px 22px; border-radius: 20px;
    font-size: 13px; font-weight: 800; font-family: var(--f-heading);
    border: 2px solid #7F1D1D; box-shadow: 4px 4px 0px #7F1D1D;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .pcv50__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv50">
  <div class="pcv50__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv50__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv50__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv50__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv50__viewall">
            {{ section.settings.view_all_label | default: 'Shop Pop-Up Store' }} 🍬 &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv50__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v50', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v50', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv50__toast" id="pcv50-toast">POP-UP ITEM ADDED!</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv50-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv50Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'POPPING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ ADDED';
        showT('POP-UP ITEM ADDED!');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv50-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

