{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0A0A0A'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 1px solid rgba(0, 255, 65, 0.3);
  }
  
  .hp17-blog-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp17-blog-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
    border-bottom: 1px solid rgba(0, 255, 65, 0.2);
    padding-bottom: 20px;
  }
  
  .hp17-blog-heading-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: clamp(2rem, 4vw, 4rem);
    text-transform: uppercase;
    color: #FFF;
    margin: 0;
    line-height: 1;
  }
  
  .hp17-blog-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  
  .hp17-blog-card-{{ section_id }} {
    background: #000;
    border: 1px solid rgba(0, 255, 65, 0.3);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }
  
  .hp17-blog-card-{{ section_id }}:hover {
    border-color: #00FF41;
    box-shadow: 0 0 15px rgba(0, 255, 65, 0.15);
  }
  
  .hp17-blog-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 60%;
    overflow: hidden;
    border-bottom: 1px solid rgba(0, 255, 65, 0.3);
  }
  
  .hp17-blog-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: all 0.5s ease;
  }
  
  .hp17-blog-card-{{ section_id }}:hover .hp17-blog-image-{{ section_id }} {
    filter: grayscale(0%);
    transform: scale(1.05);
  }
  
  .hp17-blog-info-{{ section_id }} {
    padding: 30px;
  }
  
  .hp17-blog-meta-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.8rem;
    color: #00FF41;
    margin-bottom: 15px;
    display: flex;
    gap: 15px;
  }
  
  .hp17-blog-title-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: 1.4rem;
    text-transform: uppercase;
    color: #FFF;
    margin: 0 0 15px 0;
    line-height: 1.3;
  }
  
  .hp17-blog-card-{{ section_id }}:hover .hp17-blog-title-{{ section_id }} {
    text-decoration: underline;
    text-decoration-color: #B800FF;
  }
  
  .hp17-blog-excerpt-{{ section_id }} {
    font-family: 'Arial', sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.6);
    margin: 0;
  }

  @media (max-width: 992px) {
    .hp17-blog-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
  }
</style>

<div class="hp17-blog-container-{{ section_id }}">
  <div class="hp17-blog-header-{{ section_id }}">
    <h2 class="hp17-blog-heading-{{ section_id }}">{{ section.settings.title | default: 'TRANSMISSIONS' }}</h2>
  </div>
  
  <div class="hp17-blog-grid-{{ section_id }}">
    {% assign blog = blogs[section.settings.blog] %}
    {% if blog != blank and blog.articles_count > 0 %}
      {% for article in blog.articles limit: 3 %}
        <a href="{{ article.url }}" class="hp17-blog-card-{{ section_id }}">
          <div class="hp17-blog-image-wrap-{{ section_id }}">
            <img src="{{ article.image | image_url: width: 600 }}" class="hp17-blog-image-{{ section_id }}" loading="lazy" alt="{{ article.title }}">
          </div>
          <div class="hp17-blog-info-{{ section_id }}">
            <div class="hp17-blog-meta-{{ section_id }}">
              <span>DATE: {{ article.published_at | date: "%Y.%m.%d" }}</span>
            </div>
            <h3 class="hp17-blog-title-{{ section_id }}">{{ article.title }}</h3>
            <p class="hp17-blog-excerpt-{{ section_id }}">{{ article.excerpt_or_content | strip_html | truncatewords: 15 }}</p>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..3) %}
        <a href="#" class="hp17-blog-card-{{ section_id }}">
          <div class="hp17-blog-image-wrap-{{ section_id }}">
            <div class="hp17-blog-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
          </div>
          <div class="hp17-blog-info-{{ section_id }}">
            <div class="hp17-blog-meta-{{ section_id }}">
              <span>DATE: 2049.10.12</span>
            </div>
            <h3 class="hp17-blog-title-{{ section_id }}">SURVIVING THE NEON SPRAWL</h3>
            <p class="hp17-blog-excerpt-{{ section_id }}">A comprehensive guide to avoiding corp patrols while maintaining maximum drip...</p>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP17 Blog Posts",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A0A0A"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "TRANSMISSIONS"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    }
  ],
  "presets": [
    {
      "name": "HP17 Blog Posts"
    }
  ]
}
{% endschema %}
