{%- liquid
  assign bg_color = section.settings.bg_color | default: '#00ffcc'
  assign text_color = section.settings.text_color | default: '#000000'
  assign speed = section.settings.animation_speed | default: 15
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp3-mq-bg: {{ bg_color }};
    --hp3-mq-text: {{ text_color }};
    --hp3-mq-speed: {{ speed }}s;
    
    --hp3-mq-pt-desk: {{ padding_top_desktop }}px;
    --hp3-mq-pb-desk: {{ padding_bottom_desktop }}px;
    --hp3-mq-pt-mob: {{ padding_top_mobile }}px;
    --hp3-mq-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp3-tech-marquee-{{ section.id }} {
    padding-top: var(--hp3-mq-pt-desk);
    padding-bottom: var(--hp3-mq-pb-desk);
    background-color: var(--hp3-mq-bg);
    color: var(--hp3-mq-text);
    font-family: 'Inter', sans-serif;
    overflow: hidden;
    position: relative;
    border-top: 2px solid var(--hp3-mq-text);
    border-bottom: 2px solid var(--hp3-mq-text);
    display: flex;
    align-items: center;
  }
  
  /* Adding a glitch line effect across the top */
  .hp3-tech-marquee-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 1px;
    background: rgba(255,255,255,0.5);
    z-index: 10;
  }

  .hp3-mq-track-wrapper {
    display: flex;
    width: 100%;
    overflow: hidden;
  }

  .hp3-mq-track {
    display: flex;
    align-items: center;
    white-space: nowrap;
    will-change: transform;
    animation: hp3Marquee var(--hp3-mq-speed) linear infinite;
  }

  .hp3-mq-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 40px;
    flex-shrink: 0;
    gap: 40px;
  }

  .hp3-mq-text {
    font-size: clamp(24px, 4vw, 40px);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0;
  }
  
  .hp3-mq-text.outline-text {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--hp3-mq-text);
  }

  .hp3-mq-separator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  
  .hp3-mq-separator svg {
    width: 24px;
    height: 24px;
    color: var(--hp3-mq-text);
  }

  @keyframes hp3Marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); } /* Scrolls half because content is duplicated */
  }
  
  {% if section.settings.pause_on_hover %}
    .hp3-tech-marquee-{{ section.id }}:hover .hp3-mq-track {
      animation-play-state: paused;
    }
  {% endif %}

  @media screen and (max-width: 768px) {
    .hp3-tech-marquee-{{ section.id }} {
      padding-top: var(--hp3-mq-pt-mob);
      padding-bottom: var(--hp3-mq-pb-mob);
    }
    .hp3-mq-item {
      padding: 0 20px;
      gap: 20px;
    }
    .hp3-mq-separator svg {
      width: 16px;
      height: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp3-mq-track {
      animation: none !important;
      transform: none !important;
      flex-wrap: wrap;
      justify-content: center;
    }
    .hp3-mq-item {
      padding: 10px;
    }
    .hp3-mq-track .hp3-mq-item:nth-child(n+{{ section.blocks.size | plus: 1 }}) {
      display: none;
    }
  }
</style>

<section class="hp3-tech-marquee-{{ section.id }}" aria-label="Announcement Marquee">
  <div class="hp3-mq-track-wrapper">
    <div class="hp3-mq-track">
      
      {%- capture marquee_content -%}
        {%- for block in section.blocks -%}
          <div class="hp3-mq-item" {{ block.shopify_attributes }}>
            <span class="hp3-mq-text {% if block.settings.outline %}outline-text{% endif %}">
              {{ block.settings.text }}
            </span>
            <span class="hp3-mq-separator">
              {%- if block.settings.icon == 'star' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              {%- elsif block.settings.icon == 'bolt' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
              {%- elsif block.settings.icon == 'plus' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6"></circle></svg>
              {%- endif -%}
            </span>
          </div>
        {%- endfor -%}
        
        {%- if section.blocks.size == 0 -%}
          {%- for i in (1..3) -%}
            <div class="hp3-mq-item">
              <span class="hp3-mq-text outline-text">NEW ARRIVALS</span>
              <span class="hp3-mq-separator"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg></span>
            </div>
            <div class="hp3-mq-item">
              <span class="hp3-mq-text">FREE SHIPPING OVER $100</span>
              <span class="hp3-mq-separator"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg></span>
            </div>
          {%- endfor -%}
        {%- endif -%}
      {%- endcapture -%}

      {{ marquee_content }}
      {{ marquee_content }}
      {{ marquee_content }}
      
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HP3 Tech Marquee",
  "tag": "section",
  "class": "section-hp3-marquee",
  "settings": [
    {
      "type": "range",
      "id": "animation_speed",
      "min": 5, "max": 40, "step": 1, "unit": "sec",
      "label": "Scroll Speed",
      "info": "Lower is faster.",
      "default": 15
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#00ffcc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 15
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 15
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "SYSTEM UPDATE"
        },
        {
          "type": "checkbox",
          "id": "outline",
          "label": "Use Outline Style",
          "default": false
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Separator Icon",
          "options": [
            { "value": "dot", "label": "Dot" },
            { "value": "star", "label": "Star" },
            { "value": "bolt", "label": "Lightning Bolt" },
            { "value": "plus", "label": "Plus" }
          ],
          "default": "bolt"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP3 Tech Marquee (Adv)",
      "category": "Text",
      "blocks": [
        { "type": "text", "settings": { "text": "RTX 4090 SERIES", "outline": true, "icon": "bolt" } },
        { "type": "text", "settings": { "text": "AVAILABLE NOW", "outline": false, "icon": "plus" } }
      ]
    }
  ]
}
{% endschema %}
