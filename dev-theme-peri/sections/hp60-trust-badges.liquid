{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#1E293B' }};
    padding-top: {{ section.settings.padding_top | default: 50 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
  }
  .hp60-trust__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp60-trust__grid { display: flex; justify-content: center; gap: 50px; flex-wrap: wrap; }
  .hp60-trust__item { display: flex; align-items: center; gap: 14px; }
  .hp60-trust__icon {
    width: 44px; height: 44px; background: linear-gradient(135deg, #3F6212, #1E293B);
    border-radius: 4px; display: flex; align-items: center; justify-content: center;
    font-size: 18px; color: #FEF08A; flex-shrink: 0;
    border: 1px solid rgba(254, 240, 138, 0.3);
  }
  .hp60-trust__label { font-family: 'Bodoni Moda', serif; font-size: 16px; font-weight: 700; color: #FFFFFF; margin: 0; }
  .hp60-trust__sub { font-size: 11px; color: #FEF08A; margin: 2px 0 0; font-family: 'Outfit', sans-serif; }
  @media screen and (max-width: 768px) { .hp60-trust__grid { gap: 24px; } }
  @media screen and (max-width: 480px) {
    .hp60-trust__grid { flex-direction: column; align-items: center; text-align: center; }
    .hp60-trust__item { flex-direction: column; }
  }
{%- endstyle -%}
<div class="hp60-trust__container">
  <div class="hp60-trust__grid">
    {%- for block in section.blocks -%}
      <div class="hp60-trust__item" {{ block.shopify_attributes }}>
        <div class="hp60-trust__icon">{{ block.settings.icon | default: '🏛️' }}</div>
        <div>
          <p class="hp60-trust__label">{{ block.settings.title | default: 'DOP Certified Origin' }}</p>
          <p class="hp60-trust__sub">{{ block.settings.subtitle | default: '100% Single Tuscan Estate' }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP60 Trust",
  "class": "section-hp60-trust",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1E293B" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 50 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "badge", "name": "Badge",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🏛️" },
      { "type": "text", "id": "title", "label": "Title", "default": "DOP Certified Origin" },
      { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "100% Single Tuscan Estate" }
    ]
  }],
  "presets": [{
    "name": "HP60 Trust",
    "blocks": [
      { "type": "badge", "settings": { "icon": "🏛️", "title": "DOP Certified Origin", "subtitle": "100% Single Tuscan Estate" } },
      { "type": "badge", "settings": { "icon": "🍋", "title": "Bergapten-Free Citrus", "subtitle": "100% Daytime Sun-Safe" } },
      { "type": "badge", "settings": { "icon": "📦", "title": "Italian Glass Flacons", "subtitle": "Hand-blown in Florence" } },
      { "type": "badge", "settings": { "icon": "🛡️", "title": "Tuscan Radiance Pledge", "subtitle": "60-day satisfaction guarantee" } }
    ]
  }]
}
{% endschema %}
