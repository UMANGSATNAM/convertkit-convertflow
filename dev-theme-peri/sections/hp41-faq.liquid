{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    --font-heading: 'Space Grotesk', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    background-color: var(--bg-color);
    padding: 80px 20px;
    border-bottom: 4px solid var(--border-color);
  }

  .hp41-faq-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .hp41-faq__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--border-color);
    margin: 0 0 50px;
    text-transform: uppercase;
    text-align: center;
  }

  .hp41-faq__list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hp41-faq__item {
    background: #FFF;
    border: 4px solid var(--border-color);
    border-radius: 16px;
    box-shadow: 8px 8px 0px var(--border-color);
    overflow: hidden;
    transition: all 0.15s ease;
  }

  .hp41-faq__item:nth-child(1) { background: #D7FF43; }
  .hp41-faq__item:nth-child(2) { background: #F0A8E3; }
  .hp41-faq__item:nth-child(3) { background: #38C6F4; }
  .hp41-faq__item:nth-child(4) { background: #FFF; }

  .hp41-faq__item.is-active {
    box-shadow: 4px 4px 0px var(--border-color);
    transform: translate(4px, 4px);
  }

  .hp41-faq__question {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 25px 30px;
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 900;
    color: var(--border-color);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-transform: uppercase;
  }

  .hp41-faq__icon {
    width: 40px; height: 40px;
    background: #FFF;
    border: 3px solid var(--border-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 3px 3px 0px var(--border-color);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .hp41-faq__icon svg {
    width: 16px; height: 16px;
    fill: var(--border-color);
    transition: transform 0.2s ease;
  }

  .hp41-faq__item.is-active .hp41-faq__icon svg {
    transform: rotate(45deg);
  }

  .hp41-faq__answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  .hp41-faq__answer-inner { overflow: hidden; }

  .hp41-faq__answer-inner > div {
    padding: 0 30px 30px;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.5;
    color: var(--border-color);
  }

  .hp41-faq__item.is-active .hp41-faq__answer {
    grid-template-rows: 1fr;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp41-faq-wrapper" id="HP41Faq-{{ section.id }}">
  <h2 class="hp41-faq__title">{{ section.settings.title }}</h2>

  <div class="hp41-faq__list">
    {%- for block in section.blocks -%}
      <div class="hp41-faq__item {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
        <button class="hp41-faq__question">
          {{ block.settings.question }}
          <span class="hp41-faq__icon">
            <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
          </span>
        </button>
        <div class="hp41-faq__answer">
          <div class="hp41-faq__answer-inner">
            <div>{{ block.settings.answer }}</div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var wrapper = document.getElementById('HP41Faq-{{ section.id }}');
    var items = wrapper.querySelectorAll('.hp41-faq__item');
    items.forEach(function(item) {
      item.querySelector('.hp41-faq__question').addEventListener('click', function() {
        var wasActive = item.classList.contains('is-active');
        items.forEach(function(i) { i.classList.remove('is-active'); });
        if (!wasActive) item.classList.add('is-active');
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP41 - Neo FAQ",
  "class": "section-hp41-faq",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "GOT QUESTIONS?" },
    { "type": "range", "id": "title_size", "min": 24, "max": 100, "step": 2, "unit": "px", "label": "Heading Size", "default": 80 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FDF0D5" },
    { "type": "html", "id": "custom_css", "label": "Custom CSS" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "IS THIS STUFF LEGIT?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>100% legit. We don't play around with quality. Everything is tested, loved, and approved by actual humans.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP41 - Neo FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "HOW FAST IS SHIPPING?", "answer": "<p>Like, really fast. We ship within 24 hours and most orders arrive in 3-5 days. Boom.</p>" } },
        { "type": "faq", "settings": { "question": "CAN I RETURN STUFF?", "answer": "<p>Yep. 30 days, no drama. If you don't love it, send it back. Easy peasy.</p>" } }
      ]
    }
  ]
}
{% endschema %}
