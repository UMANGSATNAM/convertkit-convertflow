{%- liquid
  assign sec_id = section.id
-%}

<style>
  #shopify-section-{{ sec_id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
    border-top: 1px solid {{ section.settings.icon_color | color_modify: 'alpha', 0.1 }};
    border-bottom: 1px solid {{ section.settings.icon_color | color_modify: 'alpha', 0.1 }};
  }

  .hp20-logos-{{ sec_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  .hp20-logos-{{ sec_id }}__label {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: {{ section.settings.icon_color }};
    opacity: 0.5;
    margin-bottom: 40px;
    display: block;
  }

  .hp20-logos-{{ sec_id }}__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 40px 60px;
  }

  .hp20-logos-{{ sec_id }}__item {
    flex: 0 0 auto;
    max-width: 140px;
    opacity: {{ section.settings.opacity | divided_by: 100.0 }};
    filter: {% if section.settings.grayscale %}grayscale(100%){% else %}none{% endif %};
    transition: opacity 0.3s ease;
  }

  .hp20-logos-{{ sec_id }}__item:hover {
    opacity: 1;
  }

  .hp20-logos-{{ sec_id }}__img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ sec_id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px 0;
    }
    .hp20-logos-{{ sec_id }}__grid {
      gap: 30px 40px;
    }
    .hp20-logos-{{ sec_id }}__item {
      max-width: 100px;
    }
  }
</style>

<section class="hp20-logos-{{ sec_id }}">
  {% if section.settings.title != blank %}
    <span class="hp20-logos-{{ sec_id }}__label">{{ section.settings.title }}</span>
  {% endif %}

  <div class="hp20-logos-{{ sec_id }}__grid">
    {% for block in section.blocks %}
      <div class="hp20-logos-{{ sec_id }}__item" {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 2048 }}" alt="{{ block.settings.image.alt | escape }}" class="hp20-logos-{{ sec_id }}__img" loading="lazy">
        {% else %}
          <div style="width: 120px; height: 40px; background: {{ section.settings.icon_color | color_modify: 'alpha', 0.2 }}; border-radius: 4px;"></div>
        {% endif %}
        {% if block.settings.link != blank %}</a>{% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "HP20 Logo List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Trusted By"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon/Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Make logos grayscale",
      "default": true
    },
    {
      "type": "range",
      "id": "opacity",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Base Opacity",
      "default": 40
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 120, "step": 5, "unit": "px",
      "label": "Desktop Top Padding", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 120, "step": 5, "unit": "px",
      "label": "Desktop Bottom Padding", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 80, "step": 5, "unit": "px",
      "label": "Mobile Top Padding", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 80, "step": 5, "unit": "px",
      "label": "Mobile Bottom Padding", "default": 40
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP20 Logo List",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
