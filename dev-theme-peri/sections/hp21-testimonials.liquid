{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Jost', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp21-testimonials-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
  }

  @media screen and (max-width: 768px) {
    .hp21-testimonials-wrapper {
      padding: 0 20px;
    }
  }

  .hp21-testimonials__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp21-testimonials__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 300;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 4px;
    margin: 0 0 16px;
  }

  .hp21-testimonials__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0;
    line-height: 1.2;
  }
  
  .hp21-testimonials__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  /* Decorative quote mark in background */
  .hp21-testimonials__bg-quote {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-heading);
    font-size: 300px;
    color: var(--accent-color);
    opacity: 0.05;
    z-index: 1;
    pointer-events: none;
    line-height: 1;
  }

  .hp21-testimonials__slider {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    gap: {{ section.settings.gap }}px;
    padding-bottom: 20px;
    position: relative;
    z-index: 2;
  }

  .hp21-testimonials__slider::-webkit-scrollbar {
    display: none;
  }

  .hp21-testimonials__card {
    flex: 0 0 {{ section.settings.card_width }}px;
    scroll-snap-align: center;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    padding: 60px 40px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: all 0.5s ease;
  }

  @media screen and (max-width: 768px) {
    .hp21-testimonials__card {
      flex: 0 0 85%;
      padding: 40px 24px;
    }
  }

  .hp21-testimonials__card:hover {
    border-color: rgba(255,255,255,0.15);
    transform: translateY(-5px);
  }

  .hp21-testimonials__stars {
    display: flex;
    gap: 4px;
    margin-bottom: 24px;
    color: var(--accent-color);
  }

  .hp21-testimonials__stars svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .hp21-testimonials__quote {
    font-family: var(--font-heading);
    font-size: {{ section.settings.quote_size }}px;
    font-weight: 300;
    line-height: 1.5;
    color: var(--text-color);
    margin: 0 0 32px;
    font-style: italic;
  }

  .hp21-testimonials__author {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--text-color);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .hp21-testimonials__verify {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 300;
    color: var(--accent-color);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .hp21-testimonials__controls {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 40px;
    position: relative;
    z-index: 2;
  }

  .hp21-testimonials__btn {
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 50%;
    background: transparent;
    color: var(--text-color);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hp21-testimonials__btn:hover {
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  .hp21-testimonials__btn svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 1.5;
    fill: none;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp21-testimonials-wrapper" id="HP21Testimonials-{{ section.id }}">
  <div class="hp21-testimonials__bg-quote">"</div>
  
  <div class="hp21-testimonials__header">
    {%- if section.settings.subtitle != blank -%}
      <p class="hp21-testimonials__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="hp21-testimonials__title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

  <div class="hp21-testimonials__slider" id="hp21-slider-{{ section.id }}">
    {%- for block in section.blocks -%}
      <div class="hp21-testimonials__card" {{ block.shopify_attributes }}>
        <div class="hp21-testimonials__stars">
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {%- endfor -%}
        </div>
        
        <p class="hp21-testimonials__quote">"{{ block.settings.quote | escape }}"</p>
        
        <div class="hp21-testimonials__author">{{ block.settings.author | escape }}</div>
        
        {%- if block.settings.verified -%}
          <div class="hp21-testimonials__verify">Verified Purchaser</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="hp21-testimonials__controls">
    <button class="hp21-testimonials__btn hp21-testimonials__prev" aria-label="Previous Testimonial" onclick="document.getElementById('hp21-slider-{{ section.id }}').scrollBy({left: -400, behavior: 'smooth'})">
      <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <button class="hp21-testimonials__btn hp21-testimonials__next" aria-label="Next Testimonial" onclick="document.getElementById('hp21-slider-{{ section.id }}').scrollBy({left: 400, behavior: 'smooth'})">
      <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>
</div>

{% schema %}
{
  "name": "HP21 - Luxury Reviews",
  "class": "section-hp21-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE ACCOLADES"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>Words of <em>Appreciation</em></p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 60
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Desktop Card Width",
      "default": 500
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 24
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 12
    },
    {
      "type": "range",
      "id": "quote_size",
      "min": 16,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Quote Size",
      "default": 24
    },
    {
      "type": "header",
      "content": "Luxury Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D4AF37"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "An absolute masterpiece. The craftsmanship and attention to detail are entirely unmatched."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "A. MONTGOMERY"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show Verified Badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP21 - Luxury Reviews",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
