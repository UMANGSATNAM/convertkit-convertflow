{% comment %} CL V8 — Furniture / Home Decor {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv8 { background: {{ section.settings.bg_color | default: '#FAF9F6' }}; color: {{ section.settings.text_color | default: '#3E362E' }}; padding: 70px 20px; font-family: 'Baskerville', serif; }
  .clv8-hero { text-align: center; margin-bottom: 60px; }
  .clv8-hero h1 { font-size: 44px; font-weight: normal; margin-bottom: 15px; color: #2A241F; letter-spacing: 1px; }
  .clv8-hero p { font-size: 16px; font-family: 'Arial', sans-serif; color: #6D6660; max-width: 650px; margin: 0 auto; line-height: 1.6; }
  .clv8-chips { display: flex; gap: 20px; justify-content: center; margin-bottom: 50px; flex-wrap: wrap; }
  .clv8-chips a { padding: 0; color: #8C7A6B; text-decoration: none; font-family: 'Arial', sans-serif; font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px; border-bottom: 1px solid transparent; transition: 0.3s; }
  .clv8-chips a:hover, .clv8-chips a.active { color: #2A241F; border-color: #2A241F; }
  .clv8-toolbar { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #EBE7E0; padding: 20px 0; margin-bottom: 50px; font-family: 'Arial', sans-serif; }
  .clv8-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 3 }}, 1fr); gap: 40px; }
  .clv8-promo { grid-column: span 1; background: #F0EBE1; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; }
  .clv8-promo h3 { font-size: 28px; margin-bottom: 20px; color: #2A241F; font-weight: normal; line-height: 1.3; }
  .clv8-promo a { display: inline-block; padding: 14px 30px; background: #2A241F; color: #FFF; font-family: 'Arial', sans-serif; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; text-decoration: none; }
  .clv8-seo { margin-top: 80px; text-align: center; padding: 60px 0; border-top: 1px solid #EBE7E0; }
  @media (max-width: 768px) { .clv8-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 1 }}, 1fr); gap: 30px; } }
</style>
<div class="clv8" style="max-width: 1200px; margin: 0 auto;">
  <div class="clv8-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Living Spaces{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Curated pieces designed to bring warmth and character to your home.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv8-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv8-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 30px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px; color: #3E362E;">{{ filter.label }} +</summary>
              <div style="position: absolute; top: 100%; left: 0; background: #FFF; border: 1px solid #EBE7E0; padding: 25px; box-shadow: 0 15px 40px rgba(0,0,0,0.06); z-index: 10; min-width: 260px; margin-top: 15px;">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 14px; cursor: pointer; font-size: 14px; color: #555;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} <span style="color:#A49C94;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px; color: #3E362E; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 12 %}
  {% paginate collection.products by limit_num %}
    <div class="clv8-grid">
      {% for product in collection.products %}
        {% render 'card-v8', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv8-promo">
            <span style="font-family: 'Arial', sans-serif; font-size: 11px; letter-spacing: 2px; color: #8C7A6B; margin-bottom: 15px; text-transform: uppercase;">Interior Design</span>
            <h3>Book a Free Consultation</h3>
            <a href="/pages/design">Learn More</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v8', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 70px; text-align: center; font-family: 'Arial', sans-serif;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv8-seo">
      <h2 style="font-size: 28px; font-weight: normal; margin-bottom: 20px; color: #2A241F;">{{ section.settings.seo_title | default: 'Crafted for Life' }}</h2>
      <p style="font-family: 'Arial', sans-serif; color: #6D6660; line-height: 1.8; max-width: 750px; margin: 0 auto; font-size: 15px;">{{ section.settings.seo_text | default: 'Our furniture marries timeless design with enduring craftsmanship, ensuring every piece becomes a cherished part of your home.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V8 — Furniture", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 6, "max": 36, "step": 3, "default": 12},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 4, "default": 3},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "1"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF9F6"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#3E362E"}
  ], "presets": [{"name": "CL V8 — Furniture"}]
}
{% endschema %}
