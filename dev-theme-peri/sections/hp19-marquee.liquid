{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: {{ section.settings.border_color }};
    --marquee-speed: {{ section.settings.marquee_speed }}s;
    
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    background-color: var(--bg-color);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      --padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp19-marquee-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    {% if section.settings.show_borders %}
      border-top: {{ section.settings.border_thickness }}px solid var(--border-color);
      border-bottom: {{ section.settings.border_thickness }}px solid var(--border-color);
    {% endif %}
    display: flex;
    align-items: center;
    padding: {{ section.settings.inner_padding }}px 0;
  }

  .hp19-marquee__track {
    display: flex;
    white-space: nowrap;
    {% if section.settings.direction == 'left' %}
      animation: hp19MarqueeLeft var(--marquee-speed) linear infinite;
    {% else %}
      animation: hp19MarqueeRight var(--marquee-speed) linear infinite;
    {% endif %}
    will-change: transform;
  }

  /* Duplicate track for seamless loop */
  .hp19-marquee__track-inner {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .hp19-marquee__item {
    display: inline-flex;
    align-items: center;
    margin: 0 {{ section.settings.item_spacing }}px;
    font-family: 'Inter', sans-serif;
    font-size: {{ section.settings.font_size }}px;
    font-weight: {{ section.settings.font_weight }};
    letter-spacing: {{ section.settings.letter_spacing }}px;
    text-transform: {% if section.settings.uppercase %}uppercase{% else %}none{% endif %};
    color: var(--text-color);
  }

  .hp19-marquee__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-color);
    margin: 0 {{ section.settings.icon_spacing }}px;
    font-size: {{ section.settings.icon_size }}px;
  }

  .hp19-marquee__icon svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    fill: currentColor;
  }

  @keyframes hp19MarqueeLeft {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes hp19MarqueeRight {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  {% if section.settings.pause_on_hover %}
  .hp19-marquee-wrapper:hover .hp19-marquee__track {
    animation-play-state: paused;
  }
  {% endif %}

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp19-marquee-wrapper" id="HP19Marquee-{{ section.id }}">
  <div class="hp19-marquee__track">
    <div class="hp19-marquee__track-inner">
      {%- for block in section.blocks -%}
        <div class="hp19-marquee__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" style="color: inherit; text-decoration: none;">
          {%- endif -%}
          
          {{ block.settings.text }}
          
          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
        
        {%- if section.settings.show_icons -%}
          <div class="hp19-marquee__icon">
            {%- if section.settings.custom_icon != blank -%}
              {{ section.settings.custom_icon }}
            {%- else -%}
              <!-- Default Star Icon -->
              <svg viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    
    <!-- Duplicated for continuous effect -->
    <div class="hp19-marquee__track-inner">
      {%- for block in section.blocks -%}
        <div class="hp19-marquee__item">
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" style="color: inherit; text-decoration: none;">
          {%- endif -%}
          
          {{ block.settings.text }}
          
          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
        
        {%- if section.settings.show_icons -%}
          <div class="hp19-marquee__icon">
            {%- if section.settings.custom_icon != blank -%}
              {{ section.settings.custom_icon }}
            {%- else -%}
              <svg viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    
    <!-- Triplicated for continuous effect on large screens -->
    <div class="hp19-marquee__track-inner">
      {%- for block in section.blocks -%}
        <div class="hp19-marquee__item">
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" style="color: inherit; text-decoration: none;">
          {%- endif -%}
          
          {{ block.settings.text }}
          
          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
        
        {%- if section.settings.show_icons -%}
          <div class="hp19-marquee__icon">
            {%- if section.settings.custom_icon != blank -%}
              {{ section.settings.custom_icon }}
            {%- else -%}
              <svg viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP19 - Marquee (Advanced)",
  "class": "section-hp19-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Scroll Speed",
      "default": 20
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll Direction",
      "options": [
        { "value": "left", "label": "Left to Right" },
        { "value": "right", "label": "Right to Left" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography & Spacing"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase Text",
      "default": true
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Letter Spacing",
      "default": 2
    },
    {
      "type": "range",
      "id": "item_spacing",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Spacing Between Items",
      "default": 40
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Show Separator Icons",
      "default": true
    },
    {
      "type": "html",
      "id": "custom_icon",
      "label": "Custom Icon (SVG)",
      "info": "Paste SVG code here. Leave blank for default star."
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Icon Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Icon Spacing",
      "default": 20
    },
    {
      "type": "header",
      "content": "Colors & Borders"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#451A03"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFBEB"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Icon Color",
      "default": "#D97706"
    },
    {
      "type": "checkbox",
      "id": "show_borders",
      "label": "Show Top/Bottom Borders",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "rgba(255,251,235,0.2)"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Thickness",
      "default": 1
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "inner_padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Inner Padding (Top/Bottom)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Outer Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Outer Bottom Padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Text Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "COMPLIMENTARY SHIPPING ON ALL DOMESTIC ORDERS"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP19 - Marquee (Advanced)",
      "category": "Scrolling",
      "blocks": [
        { "type": "text_block" },
        { "type": "text_block" },
        { "type": "text_block" },
        { "type": "text_block" }
      ]
    }
  ]
}
{% endschema %}
