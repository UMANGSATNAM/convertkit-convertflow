{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#8A9A86'
  assign text_color = section.settings.text_color | default: '#F9F6F0'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
  }
  
  .hp10-test-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  
  .hp10-test-heading-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    margin: 0 0 50px 0;
  }
  
  .hp10-test-slider-{{ section_id }} {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 20px;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  .hp10-test-slider-{{ section_id }}::-webkit-scrollbar {
    display: none;
  }
  
  .hp10-test-card-{{ section_id }} {
    flex: 0 0 calc(33.333% - 20px);
    scroll-snap-align: center;
    background: #F9F6F0;
    color: #2A3B2C;
    border-radius: 24px;
    padding: 40px;
    text-align: left;
    display: flex;
    flex-direction: column;
  }
  
  .hp10-test-stars-{{ section_id }} {
    color: #D4A373;
    margin-bottom: 20px;
  }
  
  .hp10-test-quote-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0 0 30px 0;
    flex-grow: 1;
    font-style: italic;
  }
  
  .hp10-test-author-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    margin: 0;
  }
  
  .hp10-test-product-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: rgba(42, 59, 44, 0.6);
    margin-top: 5px;
  }

  @media (max-width: 992px) {
    .hp10-test-card-{{ section_id }} {
      flex: 0 0 calc(50% - 15px);
    }
  }
  
  @media (max-width: 768px) {
    .hp10-test-card-{{ section_id }} {
      flex: 0 0 85%;
      padding: 30px;
    }
  }
</style>

<div class="hp10-test-container-{{ section_id }}">
  <h2 class="hp10-test-heading-{{ section_id }}">{{ section.settings.heading | default: 'Words from our community' }}</h2>
  
  <div class="hp10-test-slider-{{ section_id }}">
    {% for block in section.blocks limit: 5 %}
      <div class="hp10-test-card-{{ section_id }}" {{ block.shopify_attributes }}>
        <div class="hp10-test-stars-{{ section_id }}">
          {% for i in (1..5) %}★{% endfor %}
        </div>
        <p class="hp10-test-quote-{{ section_id }}">"{{ block.settings.quote | default: 'This has completely transformed my daily routine. The quality is unmatched and I love that it is all organic.' }}"</p>
        <div class="hp10-test-author-{{ section_id }}">- {{ block.settings.author | default: 'Sarah M.' }}</div>
        {% if block.settings.product_name != blank %}
          <div class="hp10-test-product-{{ section_id }}">On: {{ block.settings.product_name }}</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP10 Testimonials",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#8A9A86"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F9F6F0"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Words from our community"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP10 Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "author": "Sarah M.", "product_name": "Botanical Serum" } },
        { "type": "testimonial", "settings": { "author": "Elena R.", "product_name": "Daily Cleanser" } },
        { "type": "testimonial", "settings": { "author": "Jessica T.", "product_name": "Rose Water Mist" } }
      ]
    }
  ]
}
{% endschema %}
