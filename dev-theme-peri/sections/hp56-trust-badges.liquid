{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#082F49' }};
    padding-top: {{ section.settings.padding_top | default: 50 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    border-top: 1px solid rgba(2, 132, 199, 0.2);
  }
  .hp56-trust__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp56-trust__grid { display: flex; justify-content: center; gap: 50px; flex-wrap: wrap; }
  .hp56-trust__item { display: flex; align-items: center; gap: 14px; }
  .hp56-trust__icon {
    width: 44px; height: 44px; background: linear-gradient(135deg, #0284C7, #38BDF8);
    border-radius: 10px; display: flex; align-items: center; justify-content: center;
    font-size: 18px; color: #FFFFFF; flex-shrink: 0;
  }
  .hp56-trust__label { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; color: #FFFFFF; margin: 0; }
  .hp56-trust__sub { font-size: 11px; color: #7DD3FC; margin: 2px 0 0; }
  @media screen and (max-width: 768px) { .hp56-trust__grid { gap: 24px; } }
  @media screen and (max-width: 480px) {
    .hp56-trust__grid { flex-direction: column; align-items: center; text-align: center; }
    .hp56-trust__item { flex-direction: column; }
  }
{%- endstyle -%}
<div class="hp56-trust__container">
  <div class="hp56-trust__grid">
    {%- for block in section.blocks -%}
      <div class="hp56-trust__item" {{ block.shopify_attributes }}>
        <div class="hp56-trust__icon">{{ block.settings.icon | default: '❄️' }}</div>
        <div>
          <p class="hp56-trust__label">{{ block.settings.title | default: 'Nordic Clean Guarantee' }}</p>
          <p class="hp56-trust__sub">{{ block.settings.subtitle | default: '100% pure organic certified' }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP56 Trust",
  "class": "section-hp56-trust",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#082F49" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 50 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "badge", "name": "Badge",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "❄️" },
      { "type": "text", "id": "title", "label": "Title", "default": "Nordic Clean Guarantee" },
      { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "100% pure organic certified" }
    ]
  }],
  "presets": [{
    "name": "HP56 Trust",
    "blocks": [
      { "type": "badge", "settings": { "icon": "❄️", "title": "Nordic Clean Guarantee", "subtitle": "100% pure organic certified" } },
      { "type": "badge", "settings": { "icon": "✈️", "title": "Carbon Neutral Delivery", "subtitle": "Tracked global express" } },
      { "type": "badge", "settings": { "icon": "🌲", "title": "FSC Birch Packaging", "subtitle": "Zero plastic waste" } },
      { "type": "badge", "settings": { "icon": "🛡️", "title": "Sub-Zero Trial", "subtitle": "60-day satisfaction warranty" } }
    ]
  }]
}
{% endschema %}
