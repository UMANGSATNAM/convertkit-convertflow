{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#F5EDE3' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp53-feat__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp53-feat__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp53-feat__eyebrow {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#C2703E' }};
    margin: 0 0 12px;
  }

  .hp53-feat__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#5C3D2E' }};
    margin: 0;
  }

  .hp53-feat__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp53-feat__card {
    background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border: 1px solid {{ section.settings.border_color | default: '#E8D5C0' }};
    border-radius: 10px;
    padding: 28px 22px;
    transition: transform 0.3s ease;
  }

  .hp53-feat__card:hover {
    transform: translateY(-4px);
  }

  .hp53-feat__card-icon {
    width: 46px;
    height: 46px;
    background: linear-gradient(135deg, #E8D5C0, #C2703E);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: #FFFFFF;
    margin-bottom: 16px;
  }

  .hp53-feat__card-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#5C3D2E' }};
    margin: 0 0 8px;
  }

  .hp53-feat__card-desc {
    font-size: 13px;
    line-height: 1.6;
    color: {{ section.settings.desc_color | default: '#8B6F5E' }};
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp53-feat__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media screen and (max-width: 480px) {
    .hp53-feat__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="hp53-feat__container">
  <div class="hp53-feat__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hp53-feat__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="hp53-feat__heading">{{ section.settings.heading | default: 'Desert Science' }}</h2>
  </div>

  <div class="hp53-feat__grid">
    {%- for block in section.blocks -%}
      <div class="hp53-feat__card" {{ block.shopify_attributes }}>
        <div class="hp53-feat__card-icon">{{ block.settings.icon | default: '◈' }}</div>
        <h3 class="hp53-feat__card-title">{{ block.settings.title | default: 'Feature' }}</h3>
        <p class="hp53-feat__card-desc">{{ block.settings.description | default: 'Description here.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP53 - Dune Features",
  "class": "section-hp53-feat",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5EDE3" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E8D5C0" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#5C3D2E" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C2703E" },
    { "type": "color", "id": "desc_color", "label": "Desc Color", "default": "#8B6F5E" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◈ FEATURES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Desert Science" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "◈" },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Description here." }
      ]
    }
  ],
  "presets": [{
    "name": "HP53 - Dune Features",
    "blocks": [
      { "type": "feature", "settings": { "icon": "🧬", "title": "Bio-Active Formula", "description": "Clinically tested desert-derived actives." } },
      { "type": "feature", "settings": { "icon": "🌿", "title": "Clean Beauty", "description": "Free from parabens, sulfates, and synthetics." } },
      { "type": "feature", "settings": { "icon": "♻️", "title": "Eco Packaging", "description": "Recyclable materials, zero plastic waste." } },
      { "type": "feature", "settings": { "icon": "🐰", "title": "Cruelty Free", "description": "Never tested on animals, certified vegan." } },
      { "type": "feature", "settings": { "icon": "🏜️", "title": "Desert Resilient", "description": "Formulated for extreme climate protection." } },
      { "type": "feature", "settings": { "icon": "✦", "title": "Fast Results", "description": "Visible improvements within 14 days." } }
    ]
  }]
}
{% endschema %}
