{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Space+Grotesk:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Oswald', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    border-bottom: 4px solid var(--text-color);
  }

  .hp30-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: clamp(600px, 80vh, 900px);
    border-left: 4px solid var(--text-color);
    border-right: 4px solid var(--text-color);
    max-width: 1800px;
    margin: 0 auto;
  }

  @media screen and (max-width: 992px) {
    .hp30-hero {
      grid-template-columns: 1fr;
    }
  }

  .hp30-hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px;
    border-right: 4px solid var(--text-color);
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 992px) {
    .hp30-hero__content {
      border-right: none;
      border-bottom: 4px solid var(--text-color);
      padding: 40px 20px;
    }
  }

  .hp30-hero__badge {
    position: absolute;
    top: 40px;
    left: 40px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    background: var(--text-color);
    color: var(--bg-color);
    padding: 8px 16px;
  }

  @media screen and (max-width: 992px) {
    .hp30-hero__badge {
      top: 20px;
      left: 20px;
    }
  }

  .hp30-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(60px, 10vw, {{ section.settings.title_size }}px);
    line-height: 0.9;
    text-transform: uppercase;
    margin: 0 0 20px;
    letter-spacing: -0.02em;
    word-break: break-word;
  }

  .hp30-hero__title span {
    color: var(--accent-color);
    display: block;
  }

  .hp30-hero__text {
    font-family: var(--font-body);
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.4;
    max-width: 500px;
    margin: 0 0 40px;
    border-left: 4px solid var(--accent-color);
    padding-left: 20px;
  }

  .hp30-hero__btns {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }

  .hp30-hero__btn {
    display: inline-block;
    padding: 15px 30px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    background: var(--text-color);
    color: var(--bg-color);
    border: 4px solid var(--text-color);
    transition: all 0s; /* Brutalist sharp transitions */
    cursor: pointer;
  }

  .hp30-hero__btn:hover {
    background: var(--accent-color);
    border-color: var(--text-color);
    color: var(--text-color);
  }
  
  .hp30-hero__btn--outline {
    background: transparent;
    color: var(--text-color);
  }
  
  .hp30-hero__btn--outline:hover {
    background: var(--text-color);
    color: var(--bg-color);
  }

  .hp30-hero__image-col {
    position: relative;
    overflow: hidden;
    background: #111;
  }

  .hp30-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(120%) grayscale(20%);
    transition: transform 0.3s steps(5); /* Glitchy step animation */
  }

  .hp30-hero__image-col:hover .hp30-hero__image {
    transform: scale(1.05);
  }

  /* Brutalist overlay crosshair */
  .hp30-hero__image-col::after {
    content: '+';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-body);
    font-size: 40px;
    color: var(--accent-color);
    font-weight: 700;
    pointer-events: none;
    mix-blend-mode: difference;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp30-hero" id="HP30Hero-{{ section.id }}">
  <div class="hp30-hero__content">
    {%- if section.settings.badge != blank -%}
      <div class="hp30-hero__badge">{{ section.settings.badge }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="hp30-hero__title">
        {{ section.settings.title }}
      </h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hp30-hero__text">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="hp30-hero__btns">
      {%- if section.settings.btn1_label != blank -%}
        <a href="{{ section.settings.btn1_link | default: '#' }}" class="hp30-hero__btn">
          {{ section.settings.btn1_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.btn2_label != blank -%}
        <a href="{{ section.settings.btn2_link | default: '#' }}" class="hp30-hero__btn hp30-hero__btn--outline">
          {{ section.settings.btn2_label }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="hp30-hero__image-col">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.title | escape }}" class="hp30-hero__image" loading="eager">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp30-hero__image' }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP30 - Brutalist Hero",
  "class": "section-hp30-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "SYSTEM UPDATE 3.0"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "RADICAL <span>DESIGN</span>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "No compromises. Just raw aesthetic power."
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Button 1 Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Button 2 Label",
      "default": "EXPLORE"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Button 2 Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 60,
      "max": 180,
      "step": 5,
      "unit": "px",
      "label": "Heading Size",
      "default": 140
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (White)",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (Red)",
      "default": "#FF0000"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP30 - Brutalist Hero"
    }
  ]
}
{% endschema %}
