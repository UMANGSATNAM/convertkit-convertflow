{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 150px 40px;
    color: {{ text_color }};
  }
  
  .hp15-newsletter-container-{{ section_id }} {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  
  .hp15-newsletter-title-{{ section_id }} {
    font-family: 'Didot', 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 20px 0;
  }
  
  .hp15-newsletter-text-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0 0 50px 0;
    opacity: 0.7;
  }
  
  .hp15-newsletter-form-{{ section_id }} {
    display: flex;
    border-bottom: 1px solid {{ text_color }};
    padding-bottom: 10px;
  }
  
  .hp15-newsletter-input-{{ section_id }} {
    flex: 1;
    background: transparent;
    border: none;
    color: {{ text_color }};
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    outline: none;
    padding: 10px 0;
  }
  
  .hp15-newsletter-input-{{ section_id }}::placeholder {
    color: {{ text_color }};
    opacity: 0.5;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.75rem;
  }
  
  .hp15-newsletter-btn-{{ section_id }} {
    background: transparent;
    border: none;
    color: {{ text_color }};
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    padding: 10px 20px;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 80px 20px;
    }
  }
</style>

<div class="hp15-newsletter-container-{{ section_id }}">
  <h2 class="hp15-newsletter-title-{{ section_id }}">JOIN THE LIST</h2>
  <p class="hp15-newsletter-text-{{ section_id }}">Subscribe to receive exclusive access to early drops, private events, and editorial content.</p>
  
  <form class="hp15-newsletter-form-{{ section_id }}" action="/contact" method="post">
    <input type="hidden" name="form_type" value="customer">
    <input type="email" name="contact[email]" class="hp15-newsletter-input-{{ section_id }}" placeholder="EMAIL ADDRESS" required>
    <button type="submit" class="hp15-newsletter-btn-{{ section_id }}">SUBMIT</button>
  </form>
</div>

{% schema %}
{
  "name": "HP15 Newsletter",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "HP15 Newsletter"
    }
  ]
}
{% endschema %}
