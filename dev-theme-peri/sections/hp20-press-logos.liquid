{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --border-thickness: {{ section.settings.border_thickness }}px;
    --shadow-color: {{ section.settings.shadow_color }};
    --shadow-offset: {{ section.settings.shadow_offset }}px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp20-press-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp20-press__container {
    background: #fff;
    border: var(--border-thickness) solid var(--border-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0px var(--shadow-color);
    display: flex;
    align-items: stretch;
  }

  @media screen and (max-width: 992px) {
    .hp20-press__container {
      flex-direction: column;
    }
  }

  .hp20-press__title-box {
    background: var(--text-color);
    color: var(--bg-color); /* assuming outer bg is contrasting */
    padding: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: var(--border-thickness) solid var(--border-color);
    min-width: 250px;
  }
  
  @media screen and (max-width: 992px) {
    .hp20-press__title-box {
      border-right: none;
      border-bottom: var(--border-thickness) solid var(--border-color);
      padding: 24px;
    }
  }

  .hp20-press__title {
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: {{ section.settings.title_size }}px;
    text-transform: uppercase;
    margin: 0;
    text-align: center;
    line-height: 1.1;
  }

  .hp20-press__logos {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-around;
    padding: 24px;
    background: {{ section.settings.content_bg }};
  }
  
  @media screen and (max-width: 768px) {
    .hp20-press__logos {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      padding: 24px;
    }
  }

  .hp20-press__logo-item {
    padding: 16px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hp20-press__logo-img {
    max-width: {{ section.settings.logo_height | times: 2.5 }}px;
    height: {{ section.settings.logo_height }}px;
    object-fit: contain;
    filter: {% if section.settings.logo_grayscale %}grayscale(100%) brightness(0){% else %}none{% endif %};
    opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};
    transition: opacity 0.2s;
  }

  .hp20-press__logo-img:hover {
    opacity: 1;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp20-press-wrapper" id="HP20Press-{{ section.id }}">
  <div class="hp20-press__container">
    
    <div class="hp20-press__title-box">
      <h2 class="hp20-press__title">{{ section.settings.title | escape }}</h2>
    </div>

    <div class="hp20-press__logos">
      {%- for block in section.blocks -%}
        <div class="hp20-press__logo-item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: height: 100 }}" alt="{{ block.settings.image.alt | escape }}" class="hp20-press__logo-img" loading="lazy">
          {%- else -%}
            <div style="font-family:'Inter',sans-serif;font-weight:900;font-size:24px;color:var(--text-color);text-transform:uppercase;">LOGO {{ forloop.index }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP20 - Brutalist Press",
  "class": "section-hp20-press-logos",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "AS SEEN IN"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Logos"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo Max Height",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "logo_grayscale",
      "label": "Force Logos to Black",
      "default": true
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Default Logo Opacity",
      "default": 100
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Brutalist Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Outer Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "content_bg",
      "label": "Logo Area Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Title Block Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Thickness",
      "default": 3
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Hard Shadow Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "shadow_offset",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Shadow Offset",
      "default": 12
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP20 - Brutalist Press",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
