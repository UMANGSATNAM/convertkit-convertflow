{%- liquid
  assign bg_color = section.settings.bg_color | default: '#111111'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ffcc'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp3-usp-bg: {{ bg_color }};
    --hp3-usp-text: {{ text_color }};
    --hp3-usp-accent: {{ accent_color }};
    
    --hp3-usp-pt-desk: {{ padding_top_desktop }}px;
    --hp3-usp-pb-desk: {{ padding_bottom_desktop }}px;
    --hp3-usp-pt-mob: {{ padding_top_mobile }}px;
    --hp3-usp-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp3-tech-usp-{{ section.id }} {
    padding-top: var(--hp3-usp-pt-desk);
    padding-bottom: var(--hp3-usp-pb-desk);
    background-color: var(--hp3-usp-bg);
    color: var(--hp3-usp-text);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    border-top: 1px solid rgba(255,255,255,0.05);
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }

  .hp3-usp-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp3-usp-grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
    gap: 30px;
  }

  .hp3-usp-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 30px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 8px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .hp3-usp-item::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--hp3-usp-accent), transparent);
    transform: scaleX(0);
    transition: transform 0.4s ease;
    transform-origin: left;
  }

  .hp3-usp-item:hover {
    background: rgba(255,255,255,0.04);
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }
  
  .hp3-usp-item:hover::before {
    transform: scaleX(1);
  }

  .hp3-usp-icon-wrapper {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(var(--hp3-usp-accent-rgb, 0,255,204), 0.1);
    color: var(--hp3-usp-accent);
    margin-bottom: 20px;
    transition: transform 0.3s ease;
  }

  .hp3-usp-item:hover .hp3-usp-icon-wrapper {
    transform: scale(1.1) rotate(5deg);
  }

  .hp3-usp-icon-wrapper svg {
    width: 30px;
    height: 30px;
    stroke-width: 1.5;
  }

  .hp3-usp-title {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 10px 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .hp3-usp-desc {
    font-size: 14px;
    color: rgba(255,255,255,0.6);
    line-height: 1.5;
    margin: 0;
  }

  /* Responsive */
  @media screen and (max-width: 1024px) {
    .hp3-usp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp3-tech-usp-{{ section.id }} {
      padding-top: var(--hp3-usp-pt-mob);
      padding-bottom: var(--hp3-usp-pb-mob);
    }
    .hp3-usp-inner {
      padding: 0 20px;
    }
    .hp3-usp-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }
    .hp3-usp-item {
      flex-direction: row;
      text-align: left;
      padding: 20px;
    }
    .hp3-usp-icon-wrapper {
      margin-bottom: 0;
      margin-right: 20px;
      width: 50px; height: 50px;
      flex-shrink: 0;
    }
  }
</style>

<section class="hp3-tech-usp-{{ section.id }}" aria-label="Store Benefits">
  <div class="hp3-usp-inner">
    
    <div class="hp3-usp-grid">
      {%- for block in section.blocks -%}
        <div class="hp3-usp-item" {{ block.shopify_attributes }}>
          <div class="hp3-usp-icon-wrapper">
            {%- case block.settings.icon -%}
              {%- when 'shipping' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
              {%- when 'cod' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="2" y="6" width="20" height="12" rx="2"></rect><circle cx="12" cy="12" r="2"></circle><path d="M6 12h.01M18 12h.01"></path></svg>
              {%- when 'returns' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
              {%- when 'support' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            {%- endcase -%}
          </div>
          <div>
            <h3 class="hp3-usp-title">{{ block.settings.title }}</h3>
            <p class="hp3-usp-desc">{{ block.settings.description }}</p>
          </div>
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..4) -%}
          <div class="hp3-usp-item">
            <div class="hp3-usp-icon-wrapper">
               <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle></svg>
            </div>
            <div>
              <h3 class="hp3-usp-title">PREMIUM FEATURE</h3>
              <p class="hp3-usp-desc">Add a description of your benefit here in the editor.</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP3 Tech USP",
  "tag": "section",
  "class": "section-hp3-usp",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ffcc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 40
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping Truck" },
            { "value": "cod", "label": "Cash (COD)" },
            { "value": "returns", "label": "Returns Array" },
            { "value": "support", "label": "Support Chat" },
            { "value": "shield", "label": "Security Shield" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "FREE SHIPPING"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "On all orders over $100"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP3 Tech USP (Advanced)",
      "category": "Store Information",
      "blocks": [
        { "type": "usp", "settings": { "icon": "shipping", "title": "EXPRESS DELIVERY", "description": "Global shipping in 3-5 days" } },
        { "type": "usp", "settings": { "icon": "shield", "title": "1 YEAR WARRANTY", "description": "Guaranteed protection" } },
        { "type": "usp", "settings": { "icon": "returns", "title": "30-DAY RETURNS", "description": "No questions asked" } },
        { "type": "usp", "settings": { "icon": "support", "title": "24/7 SUPPORT", "description": "Tech experts on standby" } }
      ]
    }
  ]
}
{% endschema %}
