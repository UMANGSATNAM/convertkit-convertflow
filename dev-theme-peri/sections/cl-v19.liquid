{% comment %} CL V19 — Auto / Industrial {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv19 { background: {{ section.settings.bg_color | default: '#F3F4F6' }}; color: {{ section.settings.text_color | default: '#1F2937' }}; padding: 40px 20px; font-family: 'Roboto', sans-serif; }
  .clv19-hero { background: #1F2937; color: #FFF; padding: 40px; border-left: 8px solid #DC2626; margin-bottom: 30px; }
  .clv19-hero h1 { font-size: 36px; font-weight: 900; margin-bottom: 10px; text-transform: uppercase; }
  .clv19-hero p { font-size: 16px; color: #9CA3AF; max-width: 700px; }
  .clv19-chips { display: flex; gap: 10px; margin-bottom: 30px; overflow-x: auto; }
  .clv19-chips a { padding: 10px 15px; background: #FFF; color: #1F2937; text-decoration: none; font-size: 14px; font-weight: bold; text-transform: uppercase; border: 1px solid #D1D5DB; box-shadow: 0 2px 0 #D1D5DB; transition: 0.1s; }
  .clv19-chips a:hover, .clv19-chips a.active { border-color: #1F2937; box-shadow: 0 2px 0 #1F2937; }
  .clv19-chips a:active { transform: translateY(2px); box-shadow: none; }
  .clv19-toolbar { display: flex; justify-content: space-between; align-items: center; background: #E5E7EB; padding: 15px 20px; margin-bottom: 30px; border-radius: 4px; border-left: 4px solid #9CA3AF; }
  .clv19-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 20px; }
  .clv19-promo { grid-column: span 1; background: #DC2626; color: #FFF; padding: 30px; display: flex; flex-direction: column; justify-content: center; position: relative; overflow: hidden; }
  .clv19-promo::after { content: ''; position: absolute; right: -20px; bottom: -20px; font-size: 100px; opacity: 0.1; content: '⚙️'; }
  .clv19-promo h3 { font-size: 28px; font-weight: 900; margin-bottom: 15px; text-transform: uppercase; line-height: 1.1; position: relative; z-index: 1; }
  .clv19-promo a { display: inline-block; padding: 10px 20px; background: #FFF; color: #DC2626; text-decoration: none; font-weight: 900; font-size: 14px; text-transform: uppercase; align-self: flex-start; position: relative; z-index: 1; }
  .clv19-seo { margin-top: 50px; padding: 30px; background: #FFF; border: 1px solid #D1D5DB; border-top: 4px solid #1F2937; }
  @media (max-width: 768px) { .clv19-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 10px; } }
</style>
<div class="clv19" style="max-width: 1400px; margin: 0 auto;">
  <div class="clv19-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}PERFORMANCE PARTS{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}High-grade tools and automotive components for professionals.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv19-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv19-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 15px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; font-weight: bold; text-transform: uppercase;">{{ filter.label }} ▾</summary>
              <div style="position: absolute; background: #FFF; border: 1px solid #D1D5DB; border-top: 3px solid #1F2937; padding: 15px; z-index: 10; margin-top: 10px; min-width: 200px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 10px; cursor: pointer; font-size: 14px; font-weight: 500;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #FFF; border: 1px solid #9CA3AF; padding: 8px 12px; font-size: 14px; font-weight: bold; text-transform: uppercase; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv19-grid">
      {% for product in collection.products %}
        {% render 'card-v19', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv19-promo">
            <h3>HEAVY DUTY<br>CLEARANCE</h3>
            <a href="/collections/clearance">VIEW DEALS</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v19', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 40px; text-align: center; font-weight: bold; font-size: 18px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv19-seo">
      <h2 style="font-size: 24px; font-weight: 900; margin-bottom: 10px; text-transform: uppercase;">{{ section.settings.seo_title | default: 'BUILT TO LAST' }}</h2>
      <p style="font-size: 14px; color: #4B5563; line-height: 1.6;">{{ section.settings.seo_text | default: 'Quality tested under the most rigorous conditions. When reliability is non-negotiable, professionals choose us.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V19 — Auto/Tools", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#F3F4F6"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#1F2937"}
  ], "presets": [{"name": "CL V19 — Auto/Tools"}]
}
{% endschema %}
