{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: #000000;
    --border-width: 3px;
    --shadow-offset: 8px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: var(--border-width) solid var(--border-color);
    font-family: 'Space Grotesk', 'Outfit', sans-serif;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp23-hero-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp23-hero-wrapper {
      padding: 0 20px;
    }
  }

  .hp23-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    align-items: stretch;
  }

  @media screen and (max-width: 992px) {
    .hp23-hero__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .hp23-hero__card {
    background: #ffffff;
    border: var(--border-width) solid var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--border-color);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .hp23-hero__content-card {
    padding: 60px;
    background: var(--bg-color);
  }

  @media screen and (max-width: 992px) {
    .hp23-hero__content-card {
      padding: 40px 30px;
      order: 2;
    }
  }

  .hp23-hero__image-card {
    position: relative;
    background: var(--accent-color);
    min-height: 500px;
  }

  @media screen and (max-width: 992px) {
    .hp23-hero__image-card {
      order: 1;
      min-height: 400px;
    }
  }

  .hp23-hero__badge {
    display: inline-block;
    padding: 8px 16px;
    background: var(--accent-color);
    color: #000;
    border: 2px solid var(--border-color);
    border-radius: 40px;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 3px 3px 0 var(--border-color);
    margin-bottom: 30px;
    transform: rotate(-2deg);
  }

  .hp23-hero__title {
    font-size: clamp(40px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    line-height: 1.1;
    margin: 0 0 24px;
    text-transform: uppercase;
    letter-spacing: -1px;
  }
  
  .hp23-hero__title em {
    font-style: normal;
    color: var(--accent-color);
    text-shadow: 2px 2px 0 var(--border-color);
    -webkit-text-stroke: 1px var(--border-color);
  }

  .hp23-hero__text {
    font-size: {{ section.settings.text_size }}px;
    font-weight: 500;
    color: var(--text-color);
    line-height: 1.5;
    margin: 0 0 40px;
    max-width: 500px;
  }

  .hp23-hero__btn-group {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }

  .hp23-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background: var(--text-color);
    color: #ffffff;
    font-weight: 800;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    border: var(--border-width) solid var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    box-shadow: 4px 4px 0 var(--border-color);
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .hp23-hero__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--border-color);
  }

  .hp23-hero__btn:active {
    transform: translate(4px, 4px);
    box-shadow: 0 0 0 var(--border-color);
  }

  .hp23-hero__btn--outline {
    background: transparent;
    color: var(--text-color);
  }
  
  .hp23-hero__btn--outline:hover {
    background: var(--accent-color);
  }

  .hp23-hero__image {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Decorative Marquee Tape */
  .hp23-hero__tape {
    position: absolute;
    bottom: 20px;
    left: -20px;
    right: -20px;
    background: #ffeb3b;
    border-top: 2px solid #000;
    border-bottom: 2px solid #000;
    transform: rotate(-3deg);
    overflow: hidden;
    display: flex;
    padding: 10px 0;
    z-index: 2;
  }

  .hp23-hero__tape-text {
    white-space: nowrap;
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    color: #000;
    animation: hp23-tape-scroll 10s linear infinite;
  }

  @keyframes hp23-tape-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp23-hero-wrapper" id="HP23Hero-{{ section.id }}">
  <div class="hp23-hero__grid">
    
    <div class="hp23-hero__card hp23-hero__content-card">
      {%- if section.settings.badge != blank -%}
        <div class="hp23-hero__badge">{{ section.settings.badge | escape }}</div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h1 class="hp23-hero__title">{{ section.settings.title }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="hp23-hero__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <div class="hp23-hero__btn-group">
        {%- if section.settings.btn1_text != blank -%}
          <a href="{{ section.settings.btn1_link | default: '#' }}" class="hp23-hero__btn">
            {{ section.settings.btn1_text | escape }}
          </a>
        {%- endif -%}
        
        {%- if section.settings.btn2_text != blank -%}
          <a href="{{ section.settings.btn2_link | default: '#' }}" class="hp23-hero__btn hp23-hero__btn--outline">
            {{ section.settings.btn2_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="hp23-hero__card hp23-hero__image-card">
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.title | strip_html | escape }}" class="hp23-hero__image" loading="eager">
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'hp23-hero__image' }}
      {%- endif -%}

      {%- if section.settings.show_tape -%}
        <div class="hp23-hero__tape">
          <div class="hp23-hero__tape-text">
            WARNING: EXTREME RESULTS &nbsp; ⚡️ &nbsp; WARNING: EXTREME RESULTS &nbsp; ⚡️ &nbsp; WARNING: EXTREME RESULTS &nbsp; ⚡️ &nbsp; WARNING: EXTREME RESULTS &nbsp; ⚡️ &nbsp; WARNING: EXTREME RESULTS &nbsp; ⚡️ &nbsp; WARNING: EXTREME RESULTS &nbsp; ⚡️ &nbsp;
          </div>
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP23 - Brutalist Hero",
  "class": "section-hp23-hero",
  "settings": [
    {
      "type": "header",
      "content": "Layout & Base"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "NEW DROP 🚨"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>NO NONSENSE <em>SKINCARE</em></p>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body Text",
      "default": "Bold formulas. Zero fluff. Get results that speak for themselves with our brutalist approach to beauty."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Primary Button Text",
      "default": "SHOP THE DROP"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Secondary Button Text",
      "default": "LEARN MORE"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "checkbox",
      "id": "show_tape",
      "label": "Show Warning Tape over image",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF3B30",
      "info": "Try bright red, lime green, or bold yellow"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP23 - Brutalist Hero"
    }
  ]
}
{% endschema %}
