{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#F4F4F0'
  assign padding_top = section.settings.padding_top | default: 120
  assign padding_bottom = section.settings.padding_bottom | default: 120
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .hp7-newsletter-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 4vw;
  }
  
  /* Brutalist editorial box container */
  .hp7-newsletter__container {
    border: 4px solid var(--text-color);
    padding: 6vw;
    display: flex;
    align-items: center;
    gap: 4vw;
    position: relative;
  }
  
  /* Decorative brutalist crosses */
  .hp7-newsletter__container::before,
  .hp7-newsletter__container::after {
    content: '+';
    position: absolute;
    font-family: monospace;
    font-size: 24px;
    color: var(--text-color);
    line-height: 1;
  }
  
  .hp7-newsletter__container::before {
    top: -16px;
    left: -8px;
    background: var(--bg-color);
    padding: 4px;
  }
  
  .hp7-newsletter__container::after {
    bottom: -16px;
    right: -8px;
    background: var(--bg-color);
    padding: 4px;
  }

  .hp7-newsletter__content {
    width: 50%;
  }

  .hp7-newsletter__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3rem, 5vw, 6rem);
    font-weight: 400;
    line-height: 0.9;
    margin: 0 0 1rem 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp7-newsletter__text {
    font-family: 'Inter', sans-serif;
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.6;
    opacity: 0.8;
    margin-bottom: 0;
  }

  .hp7-newsletter__form-wrap {
    width: 50%;
  }

  .hp7-newsletter__form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .hp7-newsletter__input-group {
    position: relative;
    width: 100%;
  }

  .hp7-newsletter__input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 2px solid var(--text-color);
    color: var(--text-color);
    padding: 1rem 0;
    font-family: 'Inter', monospace;
    font-size: 16px;
    border-radius: 0;
    outline: none;
  }
  
  .hp7-newsletter__input::placeholder {
    color: var(--text-color);
    opacity: 0.4;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  
  .hp7-newsletter__input:focus {
    border-bottom-width: 4px;
  }

  .hp7-newsletter__btn {
    align-self: flex-start;
    padding: 20px 48px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    text-decoration: none;
    background-color: var(--text-color);
    color: var(--bg-color);
    border: none;
    cursor: pointer;
    transition: opacity 0.3s;
  }

  .hp7-newsletter__btn:hover {
    opacity: 0.8;
  }

  /* Form Messages */
  .hp7-newsletter__success {
    background-color: #2e7d32;
    color: white;
    padding: 1rem;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .hp7-newsletter__error {
    background-color: #d32f2f;
    color: white;
    padding: 1rem;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  @media screen and (max-width: 990px) {
    .hp7-newsletter__container {
      flex-direction: column;
      align-items: flex-start;
      border-width: 2px;
      padding: 8vw 5vw;
    }
    
    .hp7-newsletter__content,
    .hp7-newsletter__form-wrap {
      width: 100%;
    }
    
    .hp7-newsletter__btn {
      width: 100%;
    }
  }
</style>

<section class="hp7-newsletter-{{ section_id }}">
  <div class="hp7-newsletter__container">
    
    <div class="hp7-newsletter__content">
      <h2 class="hp7-newsletter__title">{{ section.settings.title }}</h2>
      <div class="hp7-newsletter__text">{{ section.settings.text }}</div>
    </div>
    
    <div class="hp7-newsletter__form-wrap">
      {%- form 'customer', class: 'hp7-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        {%- if form.posted_successfully? -%}
          <div class="hp7-newsletter__success">
            SUBSCRIBED TO THE ARCHIVE SUCCESSFULLY.
          </div>
        {%- elsif form.errors -%}
          <div class="hp7-newsletter__error">
            {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
          </div>
        {%- endif -%}

        <div class="hp7-newsletter__input-group">
          <input 
            type="email" 
            name="contact[email]" 
            class="hp7-newsletter__input"
            id="hp7-Newsletter-{{ section_id }}"
            value="{% if customer %}{{ customer.email }}{% endif %}"
            placeholder="ENTER EMAIL ADDRESS"
            autocorrect="off"
            autocapitalize="off"
            required
            aria-label="Email address"
          >
        </div>
        
        <button type="submit" class="hp7-newsletter__btn">
          {{ section.settings.btn_label | escape }}
        </button>
      {%- endform -%}
    </div>
    
  </div>
</section>

{% schema %}
{
  "name": "HP7 Editorial Newsletter",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Aesthetic: Editorial Brutalism",
      "info": "A thick-bordered form block styled like a stark newspaper advertisement."
    },
    {
      "type": "html",
      "id": "title",
      "label": "Heading",
      "default": "JOIN THE<br><em>SYNDICATE</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Gain privileged access to archival releases, private sales, and editorial dispatches.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "INITIALIZE"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text/Border Color",
      "default": "#F4F4F0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "HP7 Editorial Newsletter"
    }
  ]
}
{% endschema %}
