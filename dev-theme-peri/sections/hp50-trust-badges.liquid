{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp50-trust-bg: {{ section.settings.bg_color | default: '#000000' }};
    
    background-color: var(--hp50-trust-bg);
    color: #FFFFFF;
    padding-top: {{ section.settings.padding_top | default: 50 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    border-top: 1px solid rgba(226, 232, 240, 0.2);
  }

  .hp50-trust__grid {
    max-width: {{ section.settings.container_width | default: 1200 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 30px;
    text-align: center;
  }

  .hp50-trust__icon {
    font-size: 26px;
    margin-bottom: 12px;
    color: #E2E8F0;
  }

  .hp50-trust__title {
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 0 0 6px;
  }

  .hp50-trust__desc {
    font-size: 12px;
    color: #94A3B8;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp50-trust__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp50-trust__grid">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <div class="hp50-trust__icon">{{ block.settings.icon | default: '✦' }}</div>
        <h4 class="hp50-trust__title">{{ block.settings.title }}</h4>
        <p class="hp50-trust__desc">{{ block.settings.description }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div>
      <div class="hp50-trust__icon">✦</div>
      <h4 class="hp50-trust__title">Platinum Catalyst</h4>
      <p class="hp50-trust__desc">Certified high-tensile vector purity.</p>
    </div>
    <div>
      <div class="hp50-trust__icon">✈️</div>
      <h4 class="hp50-trust__title">White-Glove DDP Air</h4>
      <p class="hp50-trust__desc">Pre-cleared customs in 180+ nations.</p>
    </div>
    <div>
      <div class="hp50-trust__icon">🛡️</div>
      <h4 class="hp50-trust__title">Editorial Guarantee</h4>
      <p class="hp50-trust__desc">30-day complete satisfaction accord.</p>
    </div>
    <div>
      <div class="hp50-trust__icon">🔒</div>
      <h4 class="hp50-trust__title">256-Bit SSL Checkout</h4>
      <p class="hp50-trust__desc">Encrypted payment protection.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP50 - Runway Badges",
  "class": "section-hp50-badges",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 100, "step": 5, "unit": "px", "label": "Padding Top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 100, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 50 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1200 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "✦" },
        { "type": "text", "id": "title", "label": "Title", "default": "Platinum Catalyst" },
        { "type": "text", "id": "description", "label": "Description", "default": "Certified high-tensile vector purity." }
      ]
    }
  ],
  "presets": [
    { "name": "HP50 - Runway Badges" }
  ]
}
{% endschema %}
