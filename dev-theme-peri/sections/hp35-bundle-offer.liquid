{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito:wght@300;400;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Nunito', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp35-bundle-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
  }

  @media screen and (max-width: 992px) {
    .hp35-bundle-wrapper {
      flex-direction: column;
      gap: 50px;
      padding: 0 20px;
    }
  }

  .hp35-bundle__image-col {
    flex: 1.2;
    position: relative;
  }

  .hp35-bundle__image-wrap {
    aspect-ratio: 4/5;
    background: #e9e5de;
    position: relative;
    overflow: hidden;
    border-radius: 20px;
  }

  .hp35-bundle__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Decorative organic shape */
  .hp35-bundle__shape {
    position: absolute;
    width: 100px; height: 100px;
    background: var(--accent-color);
    border-radius: 50%;
    bottom: -30px; right: -30px;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #fff;
    font-family: var(--font-body);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .hp35-bundle__content-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hp35-bundle__subtitle {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 20px;
    opacity: 0.6;
  }

  .hp35-bundle__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.2;
    color: var(--text-color);
    margin: 0 0 15px;
    font-weight: 400;
  }

  .hp35-bundle__price-wrap {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 30px;
    font-family: var(--font-heading);
  }

  .hp35-bundle__price {
    font-size: 24px;
    color: var(--accent-color);
  }

  .hp35-bundle__price-old {
    font-size: 18px;
    color: var(--text-color);
    text-decoration: line-through;
    opacity: 0.5;
  }

  .hp35-bundle__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-color);
    margin: 0 0 40px;
    opacity: 0.8;
  }

  .hp35-bundle__list {
    list-style: none;
    padding: 0;
    margin: 0 0 40px 0;
  }

  .hp35-bundle__list li {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--text-color);
    padding: 15px 0;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .hp35-bundle__list li::before {
    content: '〰'; /* Organic looking bullet */
    color: var(--accent-color);
    margin-right: 15px;
  }

  .hp35-bundle__btn {
    font-family: var(--font-body);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    padding: 18px 40px;
    border-radius: 50px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--text-color);
    color: var(--bg-color);
    align-self: flex-start;
    transition: all 0.4s ease;
  }

  .hp35-bundle__btn:hover {
    background-color: var(--accent-color);
    color: #fff;
    transform: translateY(-2px);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp35-bundle-wrapper" id="HP35Bundle-{{ section.id }}">
  <div class="hp35-bundle__image-col">
    <div class="hp35-bundle__image-wrap">
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp35-bundle__image" loading="lazy">
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'hp35-bundle__image' }}
      {%- endif -%}
    </div>
    {%- if section.settings.badge_text != blank -%}
      <div class="hp35-bundle__shape">{{ section.settings.badge_text }}</div>
    {%- endif -%}
  </div>

  <div class="hp35-bundle__content-col">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp35-bundle__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    
    <h2 class="hp35-bundle__title">{{ section.settings.title }}</h2>
    
    <div class="hp35-bundle__price-wrap">
      <span class="hp35-bundle__price">{{ section.settings.price }}</span>
      {%- if section.settings.compare_price != blank -%}
        <span class="hp35-bundle__price-old">{{ section.settings.compare_price }}</span>
      {%- endif -%}
    </div>
    
    <p class="hp35-bundle__text">{{ section.settings.text }}</p>
    
    <ul class="hp35-bundle__list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>{{ block.settings.item_name }}</li>
      {%- endfor -%}
    </ul>
    
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp35-bundle__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP35 - Organic Bundle",
  "class": "section-hp35-bundle-offer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bundle Image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Set"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE STARTER COLLECTION"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "The Morning Ritual Kit"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$125"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare Price",
      "default": "$150"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Everything you need to start your day with intention and calm. A thoughtfully curated set of our most loved essentials."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Add to Cart"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C422F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CC7B5E"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bundle Item",
      "settings": [
        {
          "type": "text",
          "id": "item_name",
          "label": "Item Name",
          "default": "Ceramic Mug"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP35 - Organic Bundle",
      "blocks": [
        { "type": "item", "settings": { "item_name": "Artisan Ceramic Mug" } },
        { "type": "item", "settings": { "item_name": "Organic Cotton Towel" } },
        { "type": "item", "settings": { "item_name": "Hand-poured Candle" } }
      ]
    }
  ]
}
{% endschema %}
