{%- liquid
  assign section_id = section.id
  assign title = section.settings.title | default: 'THE RUNWAY'
  assign video_url = section.settings.video_url
-%}

<style>
  #shopify-section-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 80vh;
    min-height: 500px;
    background-color: #000;
    overflow: hidden;
  }
  
  .hp8-video-wrapper-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  
  .hp8-video-wrapper-{{ section_id }} video,
  .hp8-video-wrapper-{{ section_id }} iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    opacity: 0.7;
  }
  
  .hp8-video-overlay-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.3);
  }
  
  .hp8-video-title-{{ section_id }} {
    font-family: 'Bodoni MT', 'Didot', 'Playfair Display', serif;
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 400;
    color: #ffffff;
    margin: 0;
    letter-spacing: 5px;
    text-transform: uppercase;
    text-align: center;
  }

</style>

<div class="hp8-video-wrapper-{{ section_id }}">
  {% if video_url != blank %}
    <video autoplay loop muted playsinline>
      <source src="{{ video_url }}" type="video/mp4">
    </video>
  {% else %}
    <!-- Placeholder gradient if no video -->
    <div style="width:100%; height:100%; background: linear-gradient(135deg, #1a1a1a, #4a4a4a);"></div>
  {% endif %}
</div>

<div class="hp8-video-overlay-{{ section_id }}">
  <h2 class="hp8-video-title-{{ section_id }}">{{ title }}</h2>
</div>

{% schema %}
{
  "name": "HP8 Video Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Overlay Title",
      "default": "THE RUNWAY"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (MP4)",
      "info": "Upload an MP4 to Settings > Files and paste the URL here."
    }
  ],
  "presets": [
    {
      "name": "HP8 Video Section"
    }
  ]
}
{% endschema %}
