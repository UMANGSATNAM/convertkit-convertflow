{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAFAFA'
  assign text_color = section.settings.text_color | default: '#333333'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 40px;
    border-bottom: 1px solid #E5E5E5;
  }
  
  .hp12-pills-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
  }
  
  .hp12-pill-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 30px;
    border: 1px solid #E5E5E5;
    background: transparent;
    color: {{ text_color }};
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-decoration: none;
    transition: all 0.4s ease;
  }
  
  .hp12-pill-{{ section_id }}:hover {
    border-color: {{ text_color }};
    background-color: {{ text_color }};
    color: #FFF;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 40px 20px;
    }
    .hp12-pills-container-{{ section_id }} {
      justify-content: flex-start;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 15px;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .hp12-pills-container-{{ section_id }}::-webkit-scrollbar {
      display: none;
    }
    .hp12-pill-{{ section_id }} {
      flex: 0 0 auto;
      white-space: nowrap;
    }
  }
</style>

<div class="hp12-pills-container-{{ section_id }}">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link | default: '#' }}" class="hp12-pill-{{ section_id }}" {{ block.shopify_attributes }}>
      {{ block.settings.title | default: 'CATEGORY' }}
    </a>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP12 Category Pills",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Category Pill",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "CATEGORY"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP12 Category Pills",
      "blocks": [
        { "type": "pill", "settings": { "title": "SEATING" } },
        { "type": "pill", "settings": { "title": "LIGHTING" } },
        { "type": "pill", "settings": { "title": "TABLES" } },
        { "type": "pill", "settings": { "title": "OBJECTS" } },
        { "type": "pill", "settings": { "title": "NEW ARRIVALS" } }
      ]
    }
  ]
}
{% endschema %}
