{%- liquid
  assign collection = collections[section.settings.collection]
  assign product_limit = section.settings.product_limit
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
-%}

<section class="hp1-beauty-featured" style="background-color: {{ bg_color }}; color: {{ text_color }};" id="hp1-featured-{{ section.id }}">
  <div class="hp1-featured-inner">
    
    <div class="hp1-section-header">
      {%- if section.settings.subheading != blank -%}
        <span class="hp1-section-subheading">{{ section.settings.subheading }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hp1-section-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="hp1-product-grid">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: product_limit -%}
          <div class="hp1-product-col">
            {%- comment -%} Using card-v1 for HP1 Beauty {%- endcomment -%}
            {% render 'card-v1', product: product %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..product_limit) -%}
          <div class="hp1-product-col">
            <div class="hp1-product-placeholder">
              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
              <div class="hp1-placeholder-info">
                <h4>Beauty Product</h4>
                <p>$49.00</p>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    
    {%- if section.settings.show_view_all and collection != blank -%}
      <div class="hp1-view-all-wrapper">
        <a href="{{ collection.url }}" class="hp1-view-all-btn">
          {{ 'sections.featured_collection.view_all' | t | default: 'View All Products' }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .hp1-beauty-featured {
    padding: 80px 0;
    font-family: 'Inter', sans-serif;
  }
  .hp1-featured-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .hp1-section-header {
    text-align: center;
    margin-bottom: 50px;
  }
  .hp1-section-subheading {
    display: block;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8a7a6c;
    margin-bottom: 10px;
  }
  .hp1-section-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 400;
    margin: 0;
  }
  .hp1-product-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 30px;
  }
  .hp1-product-col {
    position: relative;
  }
  
  /* Placeholder specific styling for visual clarity */
  .hp1-product-placeholder {
    background: #f9f9f9;
    border-radius: 8px;
    overflow: hidden;
  }
  .hp1-placeholder-info {
    padding: 15px;
    text-align: center;
  }
  .hp1-placeholder-info h4 {
    margin: 0 0 5px;
    font-family: 'Playfair Display', serif;
    font-weight: 500;
  }
  .hp1-placeholder-info p {
    margin: 0;
    color: #8a7a6c;
  }

  .hp1-view-all-wrapper {
    text-align: center;
    margin-top: 50px;
  }
  .hp1-view-all-btn {
    display: inline-block;
    padding: 12px 30px;
    border: 1px solid {{ text_color }};
    color: {{ text_color }};
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 13px;
    border-radius: 30px;
    transition: all 0.3s ease;
  }
  .hp1-view-all-btn:hover {
    background: {{ text_color }};
    color: {{ bg_color }};
  }

  @media (max-width: 991px) {
    .hp1-product-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
      gap: 20px;
    }
  }
  @media (max-width: 767px) {
    .hp1-beauty-featured {
      padding: 50px 0;
    }
    .hp1-product-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: 15px;
    }
    .hp1-section-header {
      margin-bottom: 30px;
    }
  }
</style>

{% schema %}
{
  "name": "HP1 Featured Collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated Selection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Skincare"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Maximum products to show",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (Tablet)",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    }
  ],
  "presets": [
    {
      "name": "HP1 Featured Collection"
    }
  ]
}
{% endschema %}
