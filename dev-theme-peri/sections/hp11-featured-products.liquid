{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 0;
    color: {{ text_color }};
    border-bottom: 3px solid #000;
    overflow: hidden;
  }
  
  .hp11-fp-container-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  
  .hp11-fp-header-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }
  
  .hp11-fp-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
    line-height: 1;
    letter-spacing: -2px;
    color: #CCFF00;
  }
  
  .hp11-fp-scroll-{{ section_id }} {
    display: flex;
    overflow-x: auto;
    gap: 30px;
    padding: 20px 40px;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  .hp11-fp-scroll-{{ section_id }}::-webkit-scrollbar {
    display: none;
  }
  
  .hp11-fp-card-{{ section_id }} {
    flex: 0 0 350px;
    background: #FFF;
    border: 3px solid #FFF;
    display: flex;
    flex-direction: column;
    padding: 15px;
    transition: transform 0.2s ease;
  }
  
  .hp11-fp-card-{{ section_id }}:hover {
    transform: translateY(-10px);
    border-color: #FF00FF;
  }
  
  .hp11-fp-image-wrap-{{ section_id }} {
    position: relative;
    border: 2px solid #000;
    overflow: hidden;
    padding-top: 100%; 
    background: #CCC;
    margin-bottom: 20px;
  }
  
  .hp11-fp-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }
  
  .hp11-fp-info-{{ section_id }} {
    text-align: left;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  
  .hp11-fp-title-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 900;
    text-transform: uppercase;
    color: #000;
    margin: 0 0 5px 0;
  }
  
  .hp11-fp-price-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: #0000FF;
    margin-bottom: 20px;
  }
  
  .hp11-fp-btn-{{ section_id }} {
    display: block;
    width: 100%;
    padding: 15px 0;
    background: #CCFF00;
    color: #000;
    border: 2px solid #000;
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 900;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    box-shadow: 4px 4px 0 #000;
    transition: all 0.2s ease;
    margin-top: auto;
  }
  
  .hp11-fp-btn-{{ section_id }}:hover {
    background: #FF00FF;
    color: #FFF;
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 #000;
  }
  
  .hp11-fp-view-all-{{ section_id }} {
    color: #FFF;
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    text-decoration: none;
    border-bottom: 2px solid #FFF;
    font-size: 1.2rem;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .hp11-fp-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
    .hp11-fp-scroll-{{ section_id }} {
      padding: 20px;
    }
    .hp11-fp-card-{{ section_id }} {
      flex: 0 0 280px;
    }
  }
</style>

<div class="hp11-fp-container-{{ section_id }}">
  <div class="hp11-fp-header-{{ section_id }}">
    <h2 class="hp11-fp-heading-{{ section_id }}">{{ section.settings.heading | default: 'LATEST ARRIVALS' }}</h2>
    {% if section.settings.show_view_all %}
      <a href="{{ collections[section.settings.collection].url | default: '#' }}" class="hp11-fp-view-all-{{ section_id }}">SEE ALL</a>
    {% endif %}
  </div>
  
  <div class="hp11-fp-scroll-{{ section_id }}">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank %}
      {% for product in collection.products limit: 6 %}
        <div class="hp11-fp-card-{{ section_id }}">
          <a href="{{ product.url }}" class="hp11-fp-image-wrap-{{ section_id }}">
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" height="600" class="hp11-fp-image-{{ section_id }}" loading="lazy">
          </a>
          <div class="hp11-fp-info-{{ section_id }}">
            <h3 class="hp11-fp-title-{{ section_id }}">{{ product.title }}</h3>
            <div class="hp11-fp-price-{{ section_id }}">{{ product.price | money }}</div>
            <a href="{{ product.url }}" class="hp11-fp-btn-{{ section_id }}">QUICK ADD</a>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..5) %}
        <div class="hp11-fp-card-{{ section_id }}">
          <div class="hp11-fp-image-wrap-{{ section_id }}">
            <div class="hp11-fp-image-{{ section_id }}" style="background: #EEE;"></div>
          </div>
          <div class="hp11-fp-info-{{ section_id }}">
            <h3 class="hp11-fp-title-{{ section_id }}">ESSENTIAL ITEM {{ i }}</h3>
            <div class="hp11-fp-price-{{ section_id }}">$65.00</div>
            <a href="#" class="hp11-fp-btn-{{ section_id }}">QUICK ADD</a>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP11 Featured Products",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LATEST ARRIVALS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "HP11 Featured Products"
    }
  ]
}
{% endschema %}
