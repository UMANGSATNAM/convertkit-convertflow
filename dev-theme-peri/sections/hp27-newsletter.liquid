{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Syncopate:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Syncopate', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    border-top: 1px solid rgba(226, 226, 226, 0.1);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  /* Scanline effect on background */
  #shopify-section-{{ section.id }}::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(226, 226, 226, 0.02) 2px,
      rgba(226, 226, 226, 0.02) 4px
    );
    pointer-events: none;
    z-index: 0;
  }

  .hp27-news-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .hp27-news-wrapper {
      padding: 0 20px;
    }
  }

  .hp27-news__box {
    width: 100%;
    max-width: 800px;
    background: #000;
    border: 1px solid rgba(226, 226, 226, 0.2);
    padding: 60px 40px;
    position: relative;
  }

  @media screen and (max-width: 768px) {
    .hp27-news__box {
      padding: 40px 20px;
    }
  }

  /* Corner accents */
  .hp27-news__box::before,
  .hp27-news__box::after {
    content: '';
    position: absolute;
    width: 20px; height: 20px;
    border: 2px solid var(--accent-color);
  }
  .hp27-news__box::before {
    top: -2px; left: -2px;
    border-right: none; border-bottom: none;
  }
  .hp27-news__box::after {
    bottom: -2px; right: -2px;
    border-left: none; border-top: none;
  }

  .hp27-news__label {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bg-color);
    background: var(--text-color);
    padding: 4px 8px;
    margin-bottom: 20px;
  }

  .hp27-news__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 20px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp27-news__text {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0 auto 40px;
    max-width: 500px;
  }

  .hp27-news__form {
    width: 100%;
    max-width: 500px;
    margin: 0 auto;
    position: relative;
    display: flex;
    border: 1px solid rgba(226, 226, 226, 0.3);
    background: rgba(226, 226, 226, 0.05);
    transition: border-color 0.3s ease;
  }

  .hp27-news__form:focus-within {
    border-color: var(--accent-color);
  }

  .hp27-news__input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 15px 20px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--text-color);
    outline: none;
    letter-spacing: 0.05em;
  }

  .hp27-news__input::placeholder {
    color: rgba(226, 226, 226, 0.3);
    text-transform: uppercase;
  }

  .hp27-news__btn {
    background: var(--accent-color);
    color: var(--bg-color);
    border: none;
    padding: 0 30px;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hp27-news__btn:hover {
    background: var(--text-color);
  }

  .hp27-news__disclaimer {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--text-color);
    opacity: 0.4;
    margin-top: 20px;
    text-transform: uppercase;
  }

  .hp27-news__success {
    margin-top: 20px;
    padding: 10px;
    border: 1px solid var(--accent-color);
    color: var(--accent-color);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: rgba(255, 42, 42, 0.05);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp27-news-wrapper" id="HP27News-{{ section.id }}">
  <div class="hp27-news__box">
    {%- if section.settings.label != blank -%}
      <div class="hp27-news__label">{{ section.settings.label }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="hp27-news__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="hp27-news__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'HP27NewsletterForm', class: 'hp27-news__form-wrapper' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      
      <div class="hp27-news__form">
        <input 
          id="HP27NewsletterInput"
          type="email"
          name="contact[email]"
          class="hp27-news__input"
          value="{{ form.email }}"
          aria-required="true"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          {% if form.errors %}
            autofocus
            aria-invalid="true"
            aria-describedby="HP27Newsletter-error"
          {% elsif form.posted_successfully? %}
            aria-describedby="HP27Newsletter-success"
          {% endif %}
          placeholder="{{ section.settings.placeholder }}"
          required
        >
        <button type="submit" class="hp27-news__btn" name="commit" id="HP27Subscribe">
          {{ section.settings.button_text }}
        </button>
      </div>

      {%- if form.errors -%}
        <div class="hp27-news__success" id="HP27Newsletter-error" style="color:var(--accent-color); border-color:var(--accent-color);">
          ERROR: {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
        </div>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <div class="hp27-news__success" id="HP27Newsletter-success" style="color:#00FF00; border-color:#00FF00; background:rgba(0,255,0,0.05);">
          ACCESS GRANTED. INITIALIZING COMMUNICATION PROTOCOL.
        </div>
      {%- endif -%}

    {%- endform -%}

    {%- if section.settings.disclaimer != blank -%}
      <div class="hp27-news__disclaimer">{{ section.settings.disclaimer }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP27 - Eng Newsletter",
  "class": "section-hp27-newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small Label",
      "default": "SYSTEM.COMMS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ESTABLISH CONNECTION"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Authorize transmission for early access to prototypes, field reports, and system updates."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "INPUT_EMAIL_ADDRESS"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "EXECUTE"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "ENCRYPTION STANDARD MAINTAINED. OPT-OUT AVAILABLE AT ANY TIME."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Dark Engineered Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#E2E2E2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF2A2A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP27 - Eng Newsletter"
    }
  ]
}
{% endschema %}
