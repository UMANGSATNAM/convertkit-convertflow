{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FFFBEB' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp63-faq__container { max-width: {{ section.settings.container_width | default: 800 }}px; margin: 0 auto; padding: 0 24px; }
  .hp63-faq__header { text-align: center; margin-bottom: 50px; }
  .hp63-faq__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#881337' }}; margin: 0 0 12px; }
  .hp63-faq__heading { font-family: 'Playfair Display', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #1C1917; margin: 0; }
  .hp63-faq__item {
    background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border: 1px solid rgba(217, 119, 6, 0.25);
    border-radius: 6px; margin-bottom: 14px; overflow: hidden;
    box-shadow: 0 4px 20px rgba(136, 19, 55, 0.05);
    transition: border-color 0.3s ease;
  }
  .hp63-faq__item.active { border-color: #881337; }
  .hp63-faq__question {
    width: 100%; background: none; border: none; padding: 20px 24px;
    display: flex; justify-content: space-between; align-items: center; cursor: pointer;
    font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 700; color: #1C1917; text-align: left;
  }
  .hp63-faq__icon { font-size: 20px; color: {{ section.settings.accent_color | default: '#881337' }}; transition: transform 0.3s ease; flex-shrink: 0; margin-left: 16px; }
  .hp63-faq__item.active .hp63-faq__icon { transform: rotate(45deg); }
  .hp63-faq__answer { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .hp63-faq__item.active .hp63-faq__answer { max-height: 300px; }
  .hp63-faq__answer-inner { padding: 0 24px 20px; font-size: 14px; line-height: 1.7; color: #57534E; font-family: 'Plus Jakarta Sans', sans-serif; }
{%- endstyle -%}
<div class="hp63-faq__container">
  <div class="hp63-faq__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp63-faq__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp63-faq__heading">{{ section.settings.heading | default: 'Rose Apothecary Inquiries' }}</h2>
  </div>
  {%- for block in section.blocks -%}
    <div class="hp63-faq__item" {{ block.shopify_attributes }}>
      <button class="hp63-faq__question" onclick="this.parentElement.classList.toggle('active')">
        <span>{{ block.settings.question | default: 'Why are Damask roses harvested strictly at dawn?' }}</span>
        <span class="hp63-faq__icon">+</span>
      </button>
      <div class="hp63-faq__answer">
        <div class="hp63-faq__answer-inner">{{ block.settings.answer | default: 'The rising sun evaporates the fragile essential oils on the petals. Picking between 5:00 AM and 7:30 AM guarantees maximum concentration of geraniol, citronellol, and phenyl ethyl alcohol.' }}</div>
      </div>
    </div>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "HP63 FAQ",
  "class": "section-hp63-faq",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFBEB" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#881337" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌹 FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rose Apothecary Inquiries" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1000, "step": 20, "unit": "px", "label": "Container Width", "default": 800 }
  ],
  "blocks": [{
    "type": "faq", "name": "Question",
    "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Why are Damask roses harvested strictly at dawn?" },
      { "type": "textarea", "id": "answer", "label": "Answer", "default": "The rising sun evaporates the fragile essential oils." }
    ]
  }],
  "presets": [{
    "name": "HP63 FAQ",
    "blocks": [
      { "type": "faq" },
      { "type": "faq", "settings": { "question": "Is Moroccan rose oil suitable for acne-prone skin?", "answer": "Yes, natural rose hydrosol contains mild astringent and antibacterial properties that soothe inflammation without clogging pores." } },
      { "type": "faq", "settings": { "question": "How is the amber resin incorporated?", "answer": "We slow-macerate cured amber tree resin in cold-pressed desert argan oil over 45 days to extract lipid-soluble protective triterpenes." } }
    ]
  }]
}
{% endschema %}
