{%- comment -%}
  PC V61 — ARTISANAL CERAMIC & STONEWARE POTTERY PRODUCT GRID
  Design: Warm Oat Cream (#F9F6F0), Terracotta Clay (#C86D51) & Slate Ceramic (#475569) accents, Playfair Display & Outfit typography
  Card Shape: 10px clay corners, 1px stoneware borders, hand-thrown ceramic aesthetic
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap');

  .pcv61 {
    --bg: {{ section.settings.bg_color | default: '#F9F6F0' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#2C2623' }};
    --muted: {{ section.settings.muted_color | default: '#786F6A' }};
    --accent: {{ section.settings.accent_color | default: '#C86D51' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#A85238' }};
    --border: {{ section.settings.border_color | default: '#E5DFD5' }};
    --badge-sale-bg: #C86D51;
    --badge-sale-text: #FFFFFF;
    --f-serif: 'Playfair Display', serif;
    --f-sans: 'Outfit', sans-serif;
    --r-card: 10px;
    --ease: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-sans);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv61 *, .pcv61 *::before, .pcv61 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv61 a { color: inherit; text-decoration: none; }
  .pcv61 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv61 img { max-width: 100%; display: block; }

  .pcv61__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv61__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv61__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv61__title { font-family: var(--f-serif); font-size: 32px; font-weight: 700; color: var(--text); letter-spacing: -0.01em; }
  @media (min-width: 768px) { .pcv61__title { font-size: 40px; } }
  .pcv61__sub { font-size: 15px; color: var(--muted); font-style: italic; }
  .pcv61__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 13px; color: var(--text); background: #FFFFFF; border: 1px solid var(--border); padding: 8px 20px; border-radius: 20px; transition: var(--ease); }
  .pcv61__viewall:hover { background: var(--accent); color: #FFFFFF; border-color: var(--accent); }

  /* GRID */
  .pcv61__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv61__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv61__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv61__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 8px 20px -5px rgba(200, 109, 81, 0.06);
    transition: var(--ease);
  }
  .pcv61__card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 12px 24px -5px rgba(200, 109, 81, 0.15);
  }

  /* IMAGE CONTAINER */
  .pcv61__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #F2ECE1;
    overflow: hidden;
  }
  .pcv61__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pcv61__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv61__card:hover .pcv61__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv61__card:hover .pcv61__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv61__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv61__badge { font-size: 10px; font-weight: 600; text-transform: uppercase; padding: 4px 10px; border-radius: 12px; letter-spacing: 0.05em; font-family: var(--f-sans); }
  .pcv61__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv61__badge--tag { background: #475569; color: #FFFFFF; }
  .pcv61__badge--sold { background: #94A3B8; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv61__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(249, 246, 240, 0.9);
    border: 1px solid var(--border);
    backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv61__wish:hover { background: var(--accent); color: #FFFFFF; border-color: var(--accent); transform: scale(1.1); }
  .pcv61__wish.active { color: #FFFFFF; background: var(--accent); border-color: var(--accent); }

  /* QUICK ADD HOVER */
  .pcv61__quick-box {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    z-index: 3;
    transform: translateY(12px);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv61__card:hover .pcv61__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv61__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 14px 14px; }
  }

  .pcv61__quick-btn {
    width: 100%;
    padding: 11px 16px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 12px; font-weight: 600; font-family: var(--f-sans);
    border-radius: 20px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
    box-shadow: 0 4px 12px rgba(200, 109, 81, 0.25);
  }
  .pcv61__quick-btn:hover { background: var(--accent-hover); transform: scale(1.02); }
  .pcv61__quick-btn:disabled { background: #E5DFD5; color: #786F6A; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv61__content { padding: 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv61__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 600; font-family: var(--f-sans); letter-spacing: 0.08em; }
  .pcv61__item-title { font-family: var(--f-serif); font-size: 18px; font-weight: 600; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv61__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; color: var(--accent); font-weight: 700; }
  .pcv61__stars { letter-spacing: 1px; }
  .pcv61__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 400; }

  /* PRICE */
  .pcv61__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv61__price { font-size: 16px; font-weight: 600; color: var(--text); font-family: var(--f-sans); }
  .pcv61__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv61__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv61__swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv61__swatch:hover, .pcv61__swatch.active { transform: scale(1.25); border-color: var(--accent); }

  /* URGENCY MICRO */
  .pcv61__urgency { font-size: 11px; color: var(--accent); font-style: italic; font-family: var(--f-serif); display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv61__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #FFFFFF;
    padding: 12px 22px; border-radius: 20px;
    font-size: 13px; font-weight: 600; font-family: var(--f-sans);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pcv61__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv61">
  <div class="pcv61__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv61__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv61__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv61__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv61__viewall">
            {{ section.settings.view_all_label | default: 'Explore Pottery Studio' }} 🏺 &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv61__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v61', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v61', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv61__toast" id="pcv61-toast">Ceramic Vessel Added!</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv61-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv61Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Firing Kiln...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ Added';
        showT('Ceramic Vessel Added!');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv61-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

