{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --bg-color: {{ section.settings.bg_color }};
    --heading-color: {{ section.settings.heading_color }};
    --grid-gap: {{ section.settings.grid_gap }}px;
    --card-bg: {{ section.settings.card_bg_color }};
    --card-text: {{ section.settings.card_text_color }};
    
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    background-color: var(--bg-color);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      --padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
      --grid-gap: {{ section.settings.mobile_grid_gap }}px;
    }
  }

  .hp19-tiles-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: {{ section.settings.header_alignment }};
  }

  .hp19-tiles__title {
    font-family: 'Baskerville', 'Georgia', serif;
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    color: var(--heading-color);
    margin: 0 0 {{ section.settings.header_margin }}px;
    font-style: italic;
  }

  .hp19-tiles__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    gap: var(--grid-gap);
  }

  @media screen and (max-width: 992px) {
    .hp19-tiles__grid {
      grid-template-columns: repeat({{ section.settings.tablet_columns }}, 1fr);
    }
  }

  @media screen and (max-width: 576px) {
    .hp19-tiles__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
    }
  }

  .hp19-tile {
    display: block;
    position: relative;
    overflow: hidden;
    background-color: var(--card-bg);
    border-radius: {{ section.settings.tile_radius }}px;
    text-decoration: none;
    aspect-ratio: {{ section.settings.aspect_ratio }};
    box-shadow: 0 10px 30px rgba(0,0,0,{{ section.settings.shadow_opacity | divided_by: 100.0 }});
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.4s ease;
  }

  .hp19-tile:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,{{ section.settings.shadow_opacity | divided_by: 50.0 }});
  }

  .hp19-tile__image-wrapper {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 1;
    overflow: hidden;
  }

  .hp19-tile__image-wrapper img,
  .hp19-tile__image-wrapper svg {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .hp19-tile:hover .hp19-tile__image-wrapper img {
    transform: scale({{ section.settings.hover_zoom_scale }});
  }

  .hp19-tile__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 2;
    background: linear-gradient(
      to bottom, 
      rgba(0,0,0,{{ section.settings.overlay_start | divided_by: 100.0 }}) 0%, 
      rgba(0,0,0,{{ section.settings.overlay_end | divided_by: 100.0 }}) 100%
    );
    transition: opacity 0.4s ease;
  }
  
  {% if section.settings.darken_on_hover %}
  .hp19-tile:hover .hp19-tile__overlay {
    opacity: 0.8;
  }
  {% endif %}

  .hp19-tile__content {
    position: absolute;
    z-index: 3;
    left: {{ section.settings.content_padding }}px;
    right: {{ section.settings.content_padding }}px;
    {% if section.settings.content_position == 'bottom' %}
      bottom: {{ section.settings.content_padding }}px;
      top: auto;
      text-align: {{ section.settings.content_alignment }};
    {% elsif section.settings.content_position == 'top' %}
      top: {{ section.settings.content_padding }}px;
      bottom: auto;
      text-align: {{ section.settings.content_alignment }};
    {% else %}
      top: 50%;
      transform: translateY(-50%);
      text-align: center;
    {% endif %}
  }

  .hp19-tile__title {
    color: var(--card-text);
    font-family: 'Inter', sans-serif;
    font-size: {{ section.settings.tile_title_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 8px;
    transition: transform 0.3s ease;
  }
  
  .hp19-tile__subtitle {
    color: var(--card-text);
    font-family: 'Baskerville', 'Georgia', serif;
    font-size: {{ section.settings.tile_subtitle_size }}px;
    font-style: italic;
    opacity: 0.9;
    margin: 0;
  }

  {% if section.settings.show_arrow %}
  .hp19-tile__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--card-text);
    color: var(--card-bg);
    margin-top: 16px;
    transform: translateX(-10px);
    opacity: 0;
    transition: all 0.3s ease;
  }
  
  .hp19-tile:hover .hp19-tile__arrow {
    transform: translateX(0);
    opacity: 1;
  }
  {% endif %}

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp19-tiles-wrapper" id="HP19Tiles-{{ section.id }}">
  {%- if section.settings.title != blank -%}
    <h2 class="hp19-tiles__title">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  <div class="hp19-tiles__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" 
         class="hp19-tile" 
         {{ block.shopify_attributes }}>
        
        <div class="hp19-tile__image-wrapper">
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 800 }}" 
                 alt="{{ block.settings.title | escape }}" 
                 loading="lazy">
          {%- else -%}
            {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        
        <div class="hp19-tile__overlay"></div>
        
        <div class="hp19-tile__content">
          {%- if block.settings.subtitle != blank -%}
            <div class="hp19-tile__subtitle">{{ block.settings.subtitle | escape }}</div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="hp19-tile__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          
          {%- if section.settings.show_arrow -%}
            <div class="hp19-tile__arrow">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

