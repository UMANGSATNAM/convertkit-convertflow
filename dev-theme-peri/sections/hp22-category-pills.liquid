{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --pill-bg: {{ section.settings.pill_bg }};
    --font-heading: 'Lora', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Organic grain texture overlay */
  {% if section.settings.show_grain %}
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0.04;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
  {% endif %}

  .hp22-cat-pills-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 768px) {
    .hp22-cat-pills-wrapper {
      padding: 0 20px;
    }
  }

  .hp22-cat-pills__header {
    text-align: {{ section.settings.text_alignment }};
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp22-cat-pills__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--accent-color);
    text-transform: uppercase;
    margin: 0 0 12px;
  }

  .hp22-cat-pills__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0;
    line-height: 1.2;
  }
  
  .hp22-cat-pills__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp22-cat-pills__scroll-container {
    display: flex;
    gap: {{ section.settings.gap }}px;
    overflow-x: auto;
    padding-bottom: 20px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
  }

  .hp22-cat-pills__scroll-container::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .hp22-cat-pills__item {
    flex: 0 0 auto;
    width: {{ section.settings.pill_width }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    transition: transform 0.4s ease;
  }

  .hp22-cat-pills__item:hover {
    transform: translateY(-8px);
  }

  .hp22-cat-pills__image-box {
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    background-color: var(--pill-bg);
    border-radius: 200px; /* Fully rounded pill */
    padding: {{ section.settings.image_padding }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    transition: box-shadow 0.4s ease;
  }

  .hp22-cat-pills__item:hover .hp22-cat-pills__image-box {
    box-shadow: 0 15px 40px rgba(0,0,0,0.06);
  }

  .hp22-cat-pills__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 180px;
    transition: transform 1.5s ease;
  }

  .hp22-cat-pills__item:hover .hp22-cat-pills__image {
    transform: scale(1.08);
  }

  .hp22-cat-pills__label {
    font-family: var(--font-heading);
    font-size: {{ section.settings.label_size }}px;
    color: var(--text-color);
    text-align: center;
    margin: 0;
    transition: color 0.3s ease;
  }

  .hp22-cat-pills__item:hover .hp22-cat-pills__label {
    color: var(--accent-color);
  }

  /* Decorative line */
  .hp22-cat-pills__deco-line {
    position: absolute;
    bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 40px;
    background-color: var(--accent-color);
    opacity: 0.3;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp22-cat-pills-wrapper" id="HP22CatPills-{{ section.id }}">
  
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="hp22-cat-pills__header">
      {%- if section.settings.subtitle != blank -%}
        <p class="hp22-cat-pills__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="hp22-cat-pills__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="hp22-cat-pills__scroll-container">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp22-cat-pills__item" {{ block.shopify_attributes }}>
        <div class="hp22-cat-pills__image-box">
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title | escape }}" class="hp22-cat-pills__image" loading="lazy">
          {%- else -%}
            <div style="width:100%;height:100%;border-radius:180px;background:#e5ded5;display:flex;align-items:center;justify-content:center;color:#8A9A86;">IMG</div>
          {%- endif -%}
        </div>
        <h3 class="hp22-cat-pills__label">{{ block.settings.title | escape }}</h3>
      </a>
    {%- endfor -%}
  </div>

  {%- if section.settings.show_deco_line -%}
    <div class="hp22-cat-pills__deco-line"></div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "HP22 - Organic Categories",
  "class": "section-hp22-category-pills",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "EXPLORE RITUALS"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>Shop by <em>Routine</em></p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 50
    },
    {
      "type": "range",
      "id": "pill_width",
      "min": 120,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Pill Width",
      "default": 180
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Gap between items",
      "default": 20
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Pill Aspect Ratio",
      "options": [
        { "value": "1/1.5", "label": "Tall (1:1.5)" },
        { "value": "1/2", "label": "Very Tall (1:2)" },
        { "value": "1/1", "label": "Circle (1:1)" }
      ],
      "default": "1/1.5"
    },
    {
      "type": "range",
      "id": "image_padding",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Padding around image inside pill",
      "default": 10
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Section Heading Size",
      "default": 42
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Section Subtitle Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "label_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Category Label Size",
      "default": 20
    },
    {
      "type": "header",
      "content": "Organic Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "pill_bg",
      "label": "Pill Outer Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3A3A3A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8A9A86"
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Show subtle paper grain texture",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_deco_line",
      "label": "Show decorative vertical line at bottom",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Skincare"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP22 - Organic Categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Cleansers" } },
        { "type": "category", "settings": { "title": "Serums" } },
        { "type": "category", "settings": { "title": "Moisturizers" } },
        { "type": "category", "settings": { "title": "Masks" } },
        { "type": "category", "settings": { "title": "Oils" } },
        { "type": "category", "settings": { "title": "Tools" } }
      ]
    }
  ]
}
{% endschema %}
