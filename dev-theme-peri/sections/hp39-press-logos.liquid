{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --card-bg: {{ section.settings.card_bg }};
    --text-color: {{ section.settings.text_color }};
    
    --font-heading: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding: 60px 20px;
  }

  .hp39-press-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 100px;
    padding: 40px 60px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.02);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 60px;
  }

  @media screen and (max-width: 768px) {
    .hp39-press-wrapper {
      border-radius: 40px;
      padding: 40px 20px;
      gap: 30px;
    }
  }

  .hp39-press__logo {
    max-height: 40px;
    width: auto;
    opacity: 0.4;
    filter: grayscale(100%) blur(1px);
    transition: all 0.4s ease;
  }

  .hp39-press__logo:hover {
    opacity: 1;
    filter: grayscale(0%) blur(0px);
    transform: scale(1.05);
  }

  .hp39-press__text-fallback {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 700;
    color: var(--text-color);
    opacity: 0.4;
    transition: all 0.4s ease;
    filter: blur(1px);
  }

  .hp39-press__text-fallback:hover {
    opacity: 1;
    filter: blur(0px);
    transform: scale(1.05);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp39-press-wrapper" id="HP39Press-{{ section.id }}">
  {%- for block in section.blocks -%}
    <div class="hp39-press__item" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: height: 80 }}" alt="Press Logo" class="hp39-press__logo" loading="lazy">
      {%- else -%}
        <div class="hp39-press__text-fallback">{{ block.settings.text_fallback }}</div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP39 - Aura Press",
  "class": "section-hp39-press-logos",
  "settings": [
    {
      "type": "header",
      "content": "Aura Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#faf9f8"
    },
    {
      "type": "color_background",
      "id": "card_bg",
      "label": "Card Glass Background",
      "default": "rgba(255, 255, 255, 0.7)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D2D2D"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "text_fallback",
          "label": "Text Fallback",
          "default": "VOGUE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP39 - Aura Press",
      "blocks": [
        { "type": "logo", "settings": { "text_fallback": "VOGUE" } },
        { "type": "logo", "settings": { "text_fallback": "ELLE" } },
        { "type": "logo", "settings": { "text_fallback": "COSMO" } },
        { "type": "logo", "settings": { "text_fallback": "ALLURE" } }
      ]
    }
  ]
}
{% endschema %}
