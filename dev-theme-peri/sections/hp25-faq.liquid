{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Outfit:wght@300;400;600;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-orange: {{ section.settings.accent_orange }};
    --accent-yellow: {{ section.settings.accent_yellow }};
    --font-heading: 'Fraunces', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    /* Subtle grainy texture */
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp25-faq-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp25-faq-wrapper {
      padding: 0 20px;
    }
  }

  .hp25-faq__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp25-faq__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    font-style: italic;
    color: var(--text-color);
    margin: 0;
    line-height: 1.1;
    text-shadow: 3px 3px 0 var(--accent-orange);
  }

  .hp25-faq__container {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hp25-faq__item {
    background: var(--bg-color);
    border: 4px solid var(--text-color);
    border-radius: 20px;
    box-shadow: 6px 6px 0 var(--text-color);
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .hp25-faq__item.is-active {
    background: var(--accent-yellow);
    box-shadow: 6px 6px 0 var(--accent-orange);
    transform: translateX(-4px) translateY(-4px);
  }

  .hp25-faq__question {
    width: 100%;
    text-align: left;
    padding: 25px 30px;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 800;
    color: var(--text-color);
    transition: color 0.3s ease;
  }

  @media screen and (max-width: 768px) {
    .hp25-faq__question {
      padding: 20px;
      font-size: 18px;
    }
  }

  .hp25-faq__icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-left: 20px;
    background: var(--text-color);
    border-radius: 50%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, background 0.3s ease;
  }

  .hp25-faq__item.is-active .hp25-faq__icon {
    transform: rotate(45deg);
    background: var(--accent-orange);
  }

  .hp25-faq__icon::before,
  .hp25-faq__icon::after {
    content: '';
    position: absolute;
    background: var(--bg-color);
    border-radius: 2px;
  }

  .hp25-faq__icon::before {
    width: 16px;
    height: 4px;
  }

  .hp25-faq__icon::after {
    width: 4px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .hp25-faq__item.is-active .hp25-faq__icon::after {
    transform: scaleY(0);
  }

  .hp25-faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .hp25-faq__answer-inner {
    padding: 0 30px 30px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    color: var(--text-color);
    line-height: 1.6;
    border-top: 2px dashed rgba(62, 39, 35, 0.2);
    margin-top: 10px;
    padding-top: 20px;
  }

  @media screen and (max-width: 768px) {
    .hp25-faq__answer-inner {
      padding: 0 20px 20px;
    }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp25-faq-wrapper" id="HP25FAQ-{{ section.id }}">
  <div class="hp25-faq__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp25-faq__title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

  <div class="hp25-faq__container">
    {%- for block in section.blocks -%}
      <div class="hp25-faq__item" {{ block.shopify_attributes }}>
        <button class="hp25-faq__question" aria-expanded="false">
          <span>{{ block.settings.question }}</span>
          <div class="hp25-faq__icon"></div>
        </button>
        <div class="hp25-faq__answer">
          <div class="hp25-faq__answer-inner">
            {{ block.settings.answer }}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('#HP25FAQ-{{ section.id }}');
    if(!section) return;

    const items = section.querySelectorAll('.hp25-faq__item');

    items.forEach(item => {
      const btn = item.querySelector('.hp25-faq__question');
      const answer = item.querySelector('.hp25-faq__answer');

      btn.addEventListener('click', () => {
        const isActive = item.classList.contains('is-active');

        // Close all
        items.forEach(otherItem => {
          otherItem.classList.remove('is-active');
          otherItem.querySelector('.hp25-faq__question').setAttribute('aria-expanded', 'false');
          otherItem.querySelector('.hp25-faq__answer').style.maxHeight = null;
        });

        // Open clicked if it wasn't active
        if (!isActive) {
          item.classList.add('is-active');
          btn.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + "px";
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP25 - Retro FAQ",
  "class": "section-hp25-faq",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FAR OUT FAQS"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 50
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 56
    },
    {
      "type": "header",
      "content": "Retro 70s Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5E6D3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text / Border (Dark Brown)",
      "default": "#3E2723"
    },
    {
      "type": "color",
      "id": "accent_orange",
      "label": "Accent (Burnt Orange)",
      "default": "#D15F3C"
    },
    {
      "type": "color",
      "id": "accent_yellow",
      "label": "Accent (Mustard)",
      "default": "#E2B144"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What's the vibe?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>It's all about peace, love, and keeping it real. We bring you the best threads.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP25 - Retro FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
