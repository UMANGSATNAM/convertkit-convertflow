{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Oswald:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    
    --font-serif: 'Playfair Display', serif;
    --font-sans: 'Oswald', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--border-color);
  }

  .hp36-testi-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp36-testi-wrapper {
      padding: 0 20px;
    }
  }

  .hp36-testi__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp36-testi__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp36-testi__item {
    padding: 60px 40px;
    border: 1px solid var(--border-color);
    position: relative;
    background: var(--bg-color);
  }

  .hp36-testi__icon {
    font-family: var(--font-serif);
    font-size: 80px;
    line-height: 0.5;
    color: var(--text-color);
    opacity: 0.2;
    margin-bottom: 20px;
  }

  .hp36-testi__quote {
    font-family: var(--font-serif);
    font-size: clamp(24px, 3vw, {{ section.settings.quote_size }}px);
    line-height: 1.3;
    color: var(--text-color);
    margin: 0 0 40px;
    text-transform: uppercase;
  }
  
  .hp36-testi__quote em {
    font-style: italic;
    text-transform: lowercase;
  }

  .hp36-testi__footer {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 20px;
    text-align: right;
  }

  .hp36-testi__author {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 500;
  }

  .hp36-testi__detail {
    font-size: 11px;
    color: var(--text-color);
    opacity: 0.5;
    margin-top: 5px;
    letter-spacing: 0.1em;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp36-testi-wrapper" id="HP36Testimonials-{{ section.id }}">
  <div class="hp36-testi__grid">
    {%- for block in section.blocks limit: 2 -%}
      <div class="hp36-testi__item" {{ block.shopify_attributes }}>
        <div class="hp36-testi__icon">“</div>
        <h2 class="hp36-testi__quote">
          {{ block.settings.quote }}
        </h2>
        <div class="hp36-testi__footer">
          <div>
            <div class="hp36-testi__author">{{ block.settings.author }}</div>
            {%- if block.settings.author_detail != blank -%}
              <div class="hp36-testi__detail">{{ block.settings.author_detail }}</div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP36 - Editorial Quotes",
  "class": "section-hp36-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "quote_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Quote Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Editorial Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "A MASTERCLASS IN MODERN <em>TAILORING</em>. EVERY SEAM IS CONSIDERED."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "THE EDIT"
        },
        {
          "type": "text",
          "id": "author_detail",
          "label": "Author Detail",
          "default": "Vol 04"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP36 - Editorial Quotes",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial", "settings": { "quote": "REDEFINING THE BOUNDARIES OF <em>LUXURY</em> AND EVERYDAY WEAR.", "author": "AVANT GARDE MAG", "author_detail": "Issue 12" } }
      ]
    }
  ]
}
{% endschema %}
