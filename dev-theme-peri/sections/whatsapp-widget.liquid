{%- if section.settings.enable_widget -%}
  <a href="https://wa.me/{{ section.settings.phone_number | remove: '+' | remove: ' ' | remove: '-' }}?text={{ section.settings.prefilled_message | url_encode }}" 
     target="_blank" 
     rel="noopener noreferrer" 
     class="cf-whatsapp-widget position-{{ section.settings.position }}"
     aria-label="Chat with us on WhatsApp">
    
    {%- if section.settings.tooltip_text != blank -%}
      <span class="cf-whatsapp-tooltip">{{ section.settings.tooltip_text }}</span>
    {%- endif -%}

    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cf-wa-icon">
      <path d="M17.498 14.382c-.301-.15-1.767-.867-2.04-.966-.273-.101-.473-.15-.673.15-.197.295-.771.964-.944 1.162-.175.195-.349.21-.646.061-.301-.15-1.265-.462-2.406-1.485-.888-.795-1.484-1.77-1.66-2.07-.174-.3-.019-.465.13-.615.136-.135.301-.345.451-.523.146-.181.194-.301.292-.502.097-.205.048-.39-.025-.54-.075-.15-.671-1.62-.922-2.206-.24-.584-.487-.51-.672-.51-.172-.015-.371-.015-.571-.015-.2 0-.523.074-.797.359-.273.3-1.045 1.02-1.045 2.475s1.07 2.865 1.219 3.075c.149.21 2.095 3.181 5.076 4.461 2.981 1.28 2.981.854 3.529.804.549-.05 1.767-.72 2.016-1.426.246-.704.246-1.294.172-1.425-.075-.135-.275-.21-.575-.36z"></path>
      <path d="M20.52 3.449A11.97 11.97 0 0 0 12 0C5.385 0 0 5.385 0 12c0 2.115.551 4.181 1.6 6.01L.027 24l6.136-1.595A11.95 11.95 0 0 0 12 24c6.613 0 12-5.385 12-12 0-3.21-1.252-6.223-3.48-8.551z"></path>
    </svg>
  </a>

  <style>
    .cf-whatsapp-widget {
      position: fixed;
      bottom: {{ section.settings.bottom_spacing }}px;
      z-index: 999999;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 60px;
      height: 60px;
      background-color: #25D366;
      color: #fff;
      border-radius: 50%;
      box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4);
      transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
      text-decoration: none;
    }
    
    .cf-whatsapp-widget:hover {
      transform: scale(1.08);
      box-shadow: 0 6px 16px rgba(37, 211, 102, 0.5);
      color: #fff;
    }
    
    .cf-whatsapp-widget.position-bottom-right { right: {{ section.settings.side_spacing }}px; }
    .cf-whatsapp-widget.position-bottom-left { left: {{ section.settings.side_spacing }}px; }
    
    .cf-wa-icon {
      fill: #fff;
      stroke: #25D366; /* Matching background since it's a fill SVG */
    }

    .cf-whatsapp-tooltip {
      position: absolute;
      white-space: nowrap;
      background: #ffffff;
      color: #111827;
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
      pointer-events: none;
      font-family: var(--font-body, sans-serif);
      border: 1px solid #f1f1f1;
    }
    
    .cf-whatsapp-widget.position-bottom-right .cf-whatsapp-tooltip {
      right: 75px;
      transform: translateX(10px);
    }
    
    .cf-whatsapp-widget.position-bottom-left .cf-whatsapp-tooltip {
      left: 75px;
      transform: translateX(-10px);
    }
    
    .cf-whatsapp-widget:hover .cf-whatsapp-tooltip {
      opacity: 1;
      visibility: visible;
      transform: translateX(0);
    }
    
    {% if section.settings.enable_pulse %}
    .cf-whatsapp-widget::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      border-radius: 50%;
      background: #25D366;
      z-index: -1;
      animation: wa-pulse 2s infinite;
    }
    
    @keyframes wa-pulse {
      0% { transform: scale(1); opacity: 0.8; }
      100% { transform: scale(1.6); opacity: 0; }
    }
    {% endif %}
  
@media screen and (max-width: 768px) {
  .whatsapp-widget {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}

</style>
{%- endif -%}

{% schema %}
{
  "name": "WhatsApp Widget",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_widget",
      "label": "Enable WhatsApp Widget",
      "default": true
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "WhatsApp Number",
      "info": "Include country code (e.g., 919876543210 for India)",
      "default": "919876543210"
    },
    {
      "type": "text",
      "id": "prefilled_message",
      "label": "Prefilled Message",
      "default": "Hi! I need some help with my order."
    },
    {
      "type": "text",
      "id": "tooltip_text",
      "label": "Tooltip Text",
      "default": "Chat with us"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Widget Position",
      "options": [
        { "value": "bottom-right", "label": "Bottom Right" },
        { "value": "bottom-left", "label": "Bottom Left" }
      ],
      "default": "bottom-right"
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 24
    },
    {
      "type": "range",
      "id": "side_spacing",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Side Spacing",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "enable_pulse",
      "label": "Enable Pulse Animation",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "WhatsApp Widget"
    }
  ]
}
{% endschema %}
