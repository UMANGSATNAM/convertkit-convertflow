{%- comment -%}
  PC V25 — NEUMORPHIC SOFT INSET UI PRODUCT GRID
  Design: Soft Gray (#E0E5EC), Electric Blue (#3B82F6) accents, Inter typography
  Card Shape: 20px corners, dual-direction inset & outset soft neumorphic shadows
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

  .pcv25 {
    --bg: {{ section.settings.bg_color | default: '#E0E5EC' }};
    --card-bg: {{ section.settings.card_bg | default: '#E0E5EC' }};
    --text: {{ section.settings.text_color | default: '#1E293B' }};
    --muted: {{ section.settings.muted_color | default: '#64748B' }};
    --accent: {{ section.settings.accent_color | default: '#3B82F6' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#2563EB' }};
    --badge-sale-bg: #3B82F6;
    --badge-sale-text: #FFFFFF;
    --f-main: 'Inter', sans-serif;
    --r-card: 20px;
    --shadow-out: 8px 8px 18px #b8c2d0, -8px -8px 18px #ffffff;
    --shadow-in: inset 4px 4px 10px #b8c2d0, inset -4px -4px 10px #ffffff;
    --ease: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-main);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv25 *, .pcv25 *::before, .pcv25 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv25 a { color: inherit; text-decoration: none; }
  .pcv25 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv25 img { max-width: 100%; display: block; }

  .pcv25__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv25__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv25__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv25__title { font-size: 28px; font-weight: 800; color: var(--text); letter-spacing: -0.02em; }
  @media (min-width: 768px) { .pcv25__title { font-size: 36px; } }
  .pcv25__sub { font-size: 15px; color: var(--muted); }
  .pcv25__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; color: var(--accent); background: var(--bg); padding: 10px 20px; border-radius: 20px; box-shadow: var(--shadow-out); transition: var(--ease); }
  .pcv25__viewall:hover { box-shadow: var(--shadow-in); color: var(--accent-hover); }

  /* GRID */
  .pcv25__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv25__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv25__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv25__card {
    background: var(--card-bg);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: var(--shadow-out);
    transition: var(--ease);
  }
  .pcv25__card:hover {
    transform: translateY(-4px);
    box-shadow: 12px 12px 24px #b8c2d0, -12px -12px 24px #ffffff;
  }

  /* IMAGE CONTAINER */
  .pcv25__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #D5DCFA;
    overflow: hidden;
    border-radius: var(--r-card) var(--r-card) 0 0;
  }
  .pcv25__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pcv25__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv25__card:hover .pcv25__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv25__card:hover .pcv25__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv25__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv25__badge { font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 4px 10px; border-radius: 12px; letter-spacing: 0.04em; }
  .pcv25__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv25__badge--tag { background: #1E293B; color: #FFFFFF; }
  .pcv25__badge--sold { background: #94A3B8; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv25__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: var(--shadow-out);
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv25__wish:hover { box-shadow: var(--shadow-in); color: var(--accent); }
  .pcv25__wish.active { color: var(--accent); box-shadow: var(--shadow-in); }

  /* QUICK ADD BUTTON */
  .pcv25__quick-box { padding: 14px; }
  .pcv25__quick-btn {
    width: 100%;
    padding: 11px 16px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 12px; font-weight: 700;
    border-radius: 15px;
    box-shadow: 4px 4px 10px rgba(59, 130, 246, 0.4);
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv25__quick-btn:hover { background: var(--accent-hover); transform: scale(1.02); }
  .pcv25__quick-btn:disabled { background: #94A3B8; color: #E2E8F0; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv25__content { padding: 16px 16px 0 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv25__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 700; letter-spacing: 0.08em; }
  .pcv25__item-title { font-size: 15px; font-weight: 700; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv25__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; color: var(--accent); font-weight: 700; }
  .pcv25__stars { letter-spacing: 1px; }
  .pcv25__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 400; }

  /* PRICE */
  .pcv25__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv25__price { font-size: 16px; font-weight: 700; color: var(--text); }
  .pcv25__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv25__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv25__swatch { width: 14px; height: 14px; border-radius: 50%; background: var(--bg); box-shadow: var(--shadow-out); cursor: pointer; transition: var(--ease); }
  .pcv25__swatch:hover, .pcv25__swatch.active { box-shadow: var(--shadow-in); background: var(--accent); }

  /* URGENCY MICRO */
  .pcv25__urgency { font-size: 11px; color: var(--accent); font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv25__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #FFFFFF;
    padding: 12px 22px; border-radius: 15px;
    font-size: 13px; font-weight: 700;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 25px rgba(59, 130, 246, 0.4);
  }
  .pcv25__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv25">
  <div class="pcv25__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv25__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv25__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv25__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv25__viewall">
            {{ section.settings.view_all_label | default: 'Explore Neumorphic' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv25__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v25', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v25', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv25__toast" id="pcv25-toast">Added to cart</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv25-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv25Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Adding...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ Added';
        showT('Added to cart');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv25-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

