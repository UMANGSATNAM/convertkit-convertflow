{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Lato', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  .hp31-best-wrapper {
    max-width: 1400px;
    margin: 0 auto;
  }

  .hp31-best__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp31-best__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
      padding: 0 20px;
    }
  }

  .hp31-best__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, {{ section.settings.title_size }}px);
    line-height: 1.2;
    color: var(--text-color);
    margin: 0;
    font-weight: 400;
  }
  
  .hp31-best__title em {
    font-style: italic;
  }

  .hp31-best__nav {
    display: flex;
    gap: 15px;
  }

  .hp31-best__nav-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.1);
    background: transparent;
    color: var(--text-color);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hp31-best__nav-btn:hover {
    background: var(--text-color);
    color: var(--bg-color);
    border-color: var(--text-color);
  }

  .hp31-best__slider {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 10px 40px;
    scroll-behavior: smooth;
  }

  @media screen and (max-width: 768px) {
    .hp31-best__slider {
      padding: 10px 20px;
      gap: 20px;
    }
  }

  .hp31-best__slider::-webkit-scrollbar {
    display: none;
  }

  .hp31-best__item {
    flex: 0 0 calc(25% - 22.5px);
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    display: block;
  }

  @media screen and (max-width: 992px) {
    .hp31-best__item {
      flex: 0 0 calc(33.333% - 20px);
    }
  }

  @media screen and (max-width: 768px) {
    .hp31-best__item {
      flex: 0 0 calc(60% - 10px);
    }
  }

  @media screen and (max-width: 480px) {
    .hp31-best__item {
      flex: 0 0 calc(80% - 10px);
    }
  }

  .hp31-best__image-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4/5;
    margin-bottom: 20px;
    background: #E8E2D6;
  }

  .hp31-best__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp31-best__item:hover .hp31-best__image {
    transform: scale(1.05);
  }

  .hp31-best__badge {
    position: absolute;
    bottom: 15px;
    left: 15px;
    background: var(--bg-color);
    color: var(--text-color);
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 30px;
    z-index: 2;
  }

  .hp31-best__info {
    text-align: left;
  }

  .hp31-best__product-title {
    font-family: var(--font-heading);
    font-size: 16px;
    color: var(--text-color);
    margin: 0 0 6px;
    font-weight: 400;
  }

  .hp31-best__price-wrap {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--text-color);
    opacity: 0.7;
    font-weight: 300;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp31-best-wrapper" id="HP31Bestsellers-{{ section.id }}">
  <div class="hp31-best__header">
    <h2 class="hp31-best__title">{{ section.settings.title }}</h2>
    <div class="hp31-best__nav">
      <button class="hp31-best__nav-btn" id="hp31-prev-{{ section.id }}" aria-label="Previous">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="hp31-best__nav-btn" id="hp31-next-{{ section.id }}" aria-label="Next">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <div class="hp31-best__slider" id="hp31-slider-{{ section.id }}">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.product_url | default: '#' }}" class="hp31-best__item" {{ block.shopify_attributes }}>
        <div class="hp31-best__image-wrap">
          {%- if block.settings.badge != blank -%}
            <div class="hp31-best__badge">{{ block.settings.badge }}</div>
          {%- endif -%}
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.title | escape }}" class="hp31-best__image" loading="lazy">
          {%- else -%}
            {%- assign placeholder = 'product-' | append: forloop.index -%}
            {%- if forloop.index > 6 -%}{%- assign placeholder = 'product-1' -%}{%- endif -%}
            {{ placeholder | placeholder_svg_tag: 'hp31-best__image' }}
          {%- endif -%}
        </div>
        <div class="hp31-best__info">
          <h3 class="hp31-best__product-title">{{ block.settings.title }}</h3>
          <div class="hp31-best__price-wrap">
            {{ block.settings.price }}
          </div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.getElementById('hp31-slider-{{ section.id }}');
    const prev = document.getElementById('hp31-prev-{{ section.id }}');
    const next = document.getElementById('hp31-next-{{ section.id }}');
    
    if(slider && prev && next) {
      prev.addEventListener('click', () => {
        const itemWidth = slider.querySelector('.hp31-best__item').offsetWidth;
        slider.scrollBy({ left: -itemWidth - 30, behavior: 'smooth' });
      });
      next.addEventListener('click', () => {
        const itemWidth = slider.querySelector('.hp31-best__item').offsetWidth;
        slider.scrollBy({ left: itemWidth + 30, behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP31 - Zen Bestsellers",
  "class": "section-hp31-bestsellers",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Enduring <em>Favorites</em>"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 42
    },
    {
      "type": "header",
      "content": "Zen Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Beige)",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#2C2C2C"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "Serene Teapot"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$120"
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Product URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP31 - Zen Bestsellers",
      "blocks": [
        { "type": "product" },
        { "type": "product", "settings": { "badge": "Bestseller" } },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
