{%- liquid
  assign bg_color = section.settings.bg_color | default: '#FAF6F0'
  assign text_color = section.settings.text_color | default: '#1C1917'
-%}

<section class="hp1-fresh-faq" style="--bg: {{ bg_color }}; --text: {{ text_color }};">
  <div class="hp1-fresh-faq__container">
    
    <!-- Header -->
    <div class="hp1-fresh-faq__header">
      <span class="hp1-fresh-faq__tag">Got Questions?</span>
      <h2 class="hp1-fresh-faq__title">Frequently Asked Questions</h2>
      <p class="hp1-fresh-faq__subtitle">Everything you need to know about our formulations, clinical testing, and shipping.</p>
    </div>

    <!-- Accordion List -->
    <div class="hp1-fresh-faq__accordion">
      
      <details class="hp1-fresh-faq__item" open>
        <summary class="hp1-fresh-faq__question">
          <span>Are your products suitable for sensitive or acne-prone skin?</span>
          <span class="hp1-fresh-faq__icon">+</span>
        </summary>
        <div class="hp1-fresh-faq__answer">
          Yes! All LUMIÈRE formulations are dermatologist-tested, 100% non-comedogenic (won't clog pores), hypoallergenic, and free from synthetic fragrances, harsh sulfates, and parabens.
        </div>
      </details>

      <details class="hp1-fresh-faq__item">
        <summary class="hp1-fresh-faq__question">
          <span>How soon will I see visible skin results?</span>
          <span class="hp1-fresh-faq__icon">+</span>
        </summary>
        <div class="hp1-fresh-faq__answer">
          In clinical trials, 98% of users noticed improved hydration and skin smoothness within 48 hours. Skin barrier restoration and reduction in redness typically peak at day 14 of consistent daily use.
        </div>
      </details>

      <details class="hp1-fresh-faq__item">
        <summary class="hp1-fresh-faq__question">
          <span>What is your 30-Day Glow Guarantee?</span>
          <span class="hp1-fresh-faq__icon">+</span>
        </summary>
        <div class="hp1-fresh-faq__answer">
          We want you to love your skin. If you are not 100% delighted with your results within 30 days of delivery, simply reach out to our customer care team for a hassle-free full refund.
        </div>
      </details>

      <details class="hp1-fresh-faq__item">
        <summary class="hp1-fresh-faq__question">
          <span>How fast is shipping & do you ship internationally?</span>
          <span class="hp1-fresh-faq__icon">+</span>
        </summary>
        <div class="hp1-fresh-faq__answer">
          We process orders within 24 business hours. US orders deliver in 2-4 business days (FREE on orders $45+). We also ship worldwide with carbon-neutral delivery options at checkout.
        </div>
      </details>

    </div>

  </div>
</section>

<style>
  .hp1-fresh-faq {
    background-color: var(--bg);
    color: var(--text);
    padding: 96px 24px;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .hp1-fresh-faq__container {
    max-width: 800px;
    margin: 0 auto;
  }

  .hp1-fresh-faq__header {
    text-align: center;
    margin-bottom: 48px;
  }
  .hp1-fresh-faq__tag {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #D97706;
    display: block;
    margin-bottom: 8px;
  }
  .hp1-fresh-faq__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 700;
    margin: 0 0 12px 0;
  }
  .hp1-fresh-faq__subtitle {
    font-size: 15px;
    color: rgba(28, 25, 23, 0.7);
    margin: 0;
  }

  .hp1-fresh-faq__accordion {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hp1-fresh-faq__item {
    background: #FFF;
    border-radius: 16px;
    border: 1px solid rgba(28, 25, 23, 0.08);
    overflow: hidden;
    transition: box-shadow 0.2s ease;
  }
  .hp1-fresh-faq__item[open] {
    box-shadow: 0 8px 24px rgba(0,0,0,0.06);
    border-color: rgba(217, 119, 6, 0.3);
  }

  .hp1-fresh-faq__question {
    padding: 20px 24px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
  }
  .hp1-fresh-faq__question::-webkit-details-marker { display: none; }
  
  .hp1-fresh-faq__icon {
    font-size: 20px;
    font-weight: 400;
    color: #D97706;
    transition: transform 0.2s ease;
  }
  .hp1-fresh-faq__item[open] .hp1-fresh-faq__icon {
    transform: rotate(45deg);
  }

  .hp1-fresh-faq__answer {
    padding: 0 24px 20px 24px;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(28, 25, 23, 0.75);
  }
</style>

{% schema %}
{
  "name": "HP1 Fresh - FAQ Accordion",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF6F0" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1C1917" }
  ],
  "presets": [
    { "name": "HP1 Fresh - FAQ Accordion" }
  ]
}
{% endschema %}
