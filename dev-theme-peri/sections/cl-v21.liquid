{% comment %} CL V21 — Tech Gadgets {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv21 { background: {{ section.settings.bg_color | default: '#F8FAFC' }}; color: {{ section.settings.text_color | default: '#0F172A' }}; padding: 40px 20px; font-family: 'Inter', sans-serif; }
  .clv21-hero { background: #0F172A; color: #FFF; border-radius: 16px; padding: 50px; text-align: center; margin-bottom: 40px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
  .clv21-hero h1 { font-size: 42px; font-weight: 800; margin-bottom: 15px; letter-spacing: -1px; }
  .clv21-hero p { font-size: 16px; color: #94A3B8; max-width: 600px; margin: 0 auto; line-height: 1.6; }
  .clv21-chips { display: flex; gap: 12px; justify-content: center; margin-bottom: 30px; flex-wrap: wrap; }
  .clv21-chips a { padding: 10px 20px; background: #FFF; color: #0F172A; text-decoration: none; font-size: 14px; font-weight: 600; border-radius: 8px; border: 1px solid #E2E8F0; transition: all 0.2s ease; }
  .clv21-chips a:hover, .clv21-chips a.active { background: #2563EB; color: #FFF; border-color: #2563EB; }
  .clv21-toolbar { background: #FFF; border-radius: 12px; padding: 20px; margin-bottom: 40px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
  .clv21-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 24px; }
  .clv21-promo { grid-column: span 1; background: linear-gradient(135deg, #2563EB, #1E40AF); color: #FFF; border-radius: 12px; padding: 40px; display: flex; flex-direction: column; justify-content: center; text-align: center; }
  .clv21-promo h3 { font-size: 24px; font-weight: 700; margin-bottom: 20px; }
  .clv21-promo a { display: inline-block; padding: 12px 24px; background: #FFF; color: #1E40AF; text-decoration: none; font-weight: 700; border-radius: 6px; font-size: 14px; }
  .clv21-seo { margin-top: 60px; text-align: center; color: #64748B; font-size: 14px; }
  @media (max-width: 768px) { .clv21-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 16px; } }
</style>
<div class="clv21" style="max-width: 1300px; margin: 0 auto;">
  <div class="clv21-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Next-Gen Tech{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Upgrade your life with the latest innovations in consumer electronics.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv21-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv21-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 15px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; font-weight: 600;">{{ filter.label }} <span style="color:#2563EB;">▼</span></summary>
              <div style="position: absolute; background: #FFF; border: 1px solid #E2E8F0; padding: 20px; border-radius: 12px; z-index: 10; margin-top: 15px; min-width: 240px; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 14px; color: #475569;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #F1F5F9; border: 1px solid #E2E8F0; padding: 10px 16px; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort by: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv21-grid">
      {% for product in collection.products %}
        {% render 'card-v21', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv21-promo">
            <h3>Trade in & Save</h3>
            <a href="/pages/trade-in">Calculate Value</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v21', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 40px; text-align: center;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv21-seo">
      <h2 style="font-size: 20px; font-weight: 700; color: #0F172A; margin-bottom: 10px;">{{ section.settings.seo_title | default: 'Empowering Your Digital World' }}</h2>
      <p style="max-width: 800px; margin: 0 auto; line-height: 1.6;">{{ section.settings.seo_text | default: 'We offer only the highest-rated devices, rigorously tested for performance and reliability.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V21 — Tech", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#F8FAFC"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#0F172A"}
  ], "presets": [{"name": "CL V21 — Tech"}]
}
{% endschema %}
