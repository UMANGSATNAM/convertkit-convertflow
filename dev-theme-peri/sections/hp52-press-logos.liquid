{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp52-press-bg: {{ section.settings.bg_color | default: '#F7EFE6' }};
    
    background-color: var(--hp52-press-bg);
    padding: {{ section.settings.padding_vertical | default: 30 }}px 0;
    border-top: 1px solid rgba(194, 89, 63, 0.15);
    border-bottom: 1px solid rgba(194, 89, 63, 0.15);
  }

  .hp52-press__wrap {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: 30px;
    font-family: 'Bodoni Moda', serif;
    font-size: 20px;
    font-weight: 700;
    color: #2D3B2D;
    opacity: 0.85;
  }
{%- endstyle -%}

<div class="hp52-press__wrap">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.title }}</span>
    {%- endfor -%}
  {%- else -%}
    <span>VOGUE ITALIA</span>
    <span>VANITY FAIR MILANO</span>
    <span>HARPER'S BAZAAR</span>
    <span>CORRIERE DELLA SERA</span>
    <span>BELL'ITALIA</span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP52 - Terra Press",
  "class": "section-hp52-press",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F7EFE6" },
    { "type": "range", "id": "padding_vertical", "min": 15, "max": 60, "step": 5, "unit": "px", "label": "Vertical Padding", "default": 30 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1100 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Publication Name", "default": "VOGUE ITALIA" }
      ]
    }
  ],
  "presets": [
    { "name": "HP52 - Terra Press" }
  ]
}
{% endschema %}
