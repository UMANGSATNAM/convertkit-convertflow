{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp49-usp-bg: {{ section.settings.bg_color | default: '#F5F3FF' }};
    --hp49-card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --hp49-accent: {{ section.settings.accent_color | default: '#7C3AED' }};
    --hp49-title: {{ section.settings.title_color | default: '#2E1065' }};
    
    background-color: var(--hp49-usp-bg);
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
  }

  .hp49-usp__grid {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 24px;
  }

  .hp49-usp__card {
    background: var(--hp49-card-bg);
    border: 1px solid rgba(124, 58, 237, 0.15);
    border-radius: 28px;
    padding: 36px 24px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(124, 58, 237, 0.06);
    transition: all 0.3s ease;
  }

  .hp49-usp__card:hover {
    border-color: var(--hp49-accent);
    transform: translateY(-4px);
    box-shadow: 0 15px 40px rgba(124, 58, 237, 0.14);
  }

  .hp49-usp__icon {
    width: 60px;
    height: 60px;
    background: #EDE9FE;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    margin-bottom: 18px;
  }

  .hp49-usp__title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 18px;
    font-weight: 800;
    color: var(--hp49-title);
    margin: 0 0 10px;
  }

  .hp49-usp__desc {
    font-size: 14px;
    line-height: 1.65;
    color: #5B21B6;
    opacity: 0.85;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp49-usp__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (max-width: 576px) {
    .hp49-usp__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="hp49-usp__grid">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="hp49-usp__card" {{ block.shopify_attributes }}>
        <div class="hp49-usp__icon">{{ block.settings.icon | default: '🌸' }}</div>
        <h3 class="hp49-usp__title">{{ block.settings.title }}</h3>
        <p class="hp49-usp__desc">{{ block.settings.description }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="hp49-usp__card">
      <div class="hp49-usp__icon">🌸</div>
      <h3 class="hp49-usp__title">Alpine Lavender</h3>
      <p class="hp49-usp__desc">Cold-distilled at high French altitudes to calm reactive and redness-prone skin.</p>
    </div>
    <div class="hp49-usp__card">
      <div class="hp49-usp__icon">☁️</div>
      <h3 class="hp49-usp__title">Cloud Peptides</h3>
      <p class="hp49-usp__desc">Weightless bio-molecular chains that deeply replenish cushiony skin elasticity.</p>
    </div>
    <div class="hp49-usp__card">
      <div class="hp49-usp__icon">✈️</div>
      <h3 class="hp49-usp__title">Pre-Paid DDP Air</h3>
      <p class="hp49-usp__desc">Fast doorstep delivery with all customs duties pre-paid across 180+ countries.</p>
    </div>
    <div class="hp49-usp__card">
      <div class="hp49-usp__icon">🛡️</div>
      <h3 class="hp49-usp__title">Hypoallergenic</h3>
      <p class="hp49-usp__desc">100% gentle vegan formulations clinically cleared for delicate skin types.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP49 - Lavender Pillars",
  "class": "section-hp49-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F3FF" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#7C3AED" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#2E1065" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 70 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar Card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "🌸" },
        { "type": "text", "id": "title", "label": "Title", "default": "Alpine Lavender" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Cold-distilled at high French altitudes." }
      ]
    }
  ],
  "presets": [
    { "name": "HP49 - Lavender Pillars" }
  ]
}
{% endschema %}
