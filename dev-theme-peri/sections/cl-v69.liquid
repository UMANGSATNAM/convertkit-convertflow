{% comment %} CL V69 — Winter / Snow (Ice Blue/White) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv69 { background: {{ section.settings.bg_color | default: '#F2FAFF' }}; color: {{ section.settings.text_color | default: '#102A43' }}; padding: 40px 20px; font-family: 'Helvetica Neue', Helvetica, sans-serif; }
  .clv69-hero { text-align: center; margin-bottom: 40px; padding: 80px 20px; background: linear-gradient(to bottom, #D9F0FF, #F2FAFF); border-radius: 12px; position: relative; border-bottom: 1px solid #BEE3F8; }
  .clv69-hero h1 { font-size: 50px; font-weight: 300; color: #102A43; margin-bottom: 10px; letter-spacing: 2px; text-transform: uppercase; }
  .clv69-hero p { font-size: 16px; color: #334E68; max-width: 600px; margin: 0 auto; line-height: 1.6; }
  .clv69-chips { display: flex; gap: 10px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv69-chips a { padding: 12px 24px; background: #FFF; color: #334E68; text-decoration: none; font-size: 14px; font-weight: 500; border-radius: 30px; transition: 0.3s; box-shadow: 0 4px 6px rgba(0,0,0,0.02); border: 1px solid #E2E8F0; }
  .clv69-chips a:hover, .clv69-chips a.active { background: #334E68; color: #FFF; border-color: #334E68; }
  .clv69-toolbar { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #D9F0FF; padding-bottom: 15px; margin-bottom: 30px; }
  .clv69-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 20px; }
  .clv69-promo { grid-column: span 1; background: #102A43; color: #F2FAFF; border-radius: 12px; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; background-image: radial-gradient(circle at top right, #334E68, transparent); }
  .clv69-promo h3 { font-size: 28px; font-weight: 300; margin-bottom: 20px; letter-spacing: 1px; }
  .clv69-promo a { display: inline-block; padding: 12px 25px; background: #F2FAFF; color: #102A43; text-decoration: none; font-size: 13px; font-weight: 600; border-radius: 30px; transition: 0.3s; text-transform: uppercase; letter-spacing: 1px; }
  .clv69-promo a:hover { background: #D9F0FF; }
  .clv69-seo { margin-top: 60px; text-align: center; padding: 40px; background: #FFF; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.02); }
  @media (max-width: 768px) { .clv69-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv69-hero h1 { font-size: 36px; } .clv69-hero { padding: 50px 20px; } }
</style>
<div class="clv69" style="max-width: 1300px; margin: 0 auto;">
  <div class="clv69-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}ALPINE COLLECTION{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Engineered for the elements. Stay warm without sacrificing mobility.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv69-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv69-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 25px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; font-weight: 500; color: #102A43; letter-spacing: 1px; text-transform: uppercase;">{{ filter.label }} ⌄</summary>
              <div style="position: absolute; background: #FFF; border: 1px solid #D9F0FF; padding: 20px; border-radius: 8px; z-index: 10; margin-top: 15px; min-width: 220px; box-shadow: 0 10px 25px rgba(16,42,67,0.1);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 14px; color: #334E68;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} style="accent-color: #102A43;">
                    {{ value.label }} <span style="font-size: 12px; opacity: 0.6;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-family: inherit; font-size: 14px; color: #102A43; font-weight: 500; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; outline: none;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv69-grid">
      {% for product in collection.products %}
        {% render 'card-v69', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv69-promo">
            <h3>THERMAL<br>LAYERS</h3>
            <a href="/collections/base-layers">SHOP BASE</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v69', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; font-size: 16px; font-weight: 300; color: #334E68; letter-spacing: 2px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv69-seo">
      <h2 style="font-size: 22px; font-weight: 300; color: #102A43; margin-bottom: 15px; letter-spacing: 1px; text-transform: uppercase;">{{ section.settings.seo_title | default: 'Weatherproof Performance' }}</h2>
      <p style="font-size: 14px; color: #334E68; max-width: 650px; margin: 0 auto; line-height: 1.7;">{{ section.settings.seo_text | default: 'Our outerwear utilizes advanced waterproofing and insulation technologies to keep you dry and warm in sub-zero conditions.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V69 — Winter", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#F2FAFF"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#102A43"}
  ], "presets": [{"name": "CL V69 — Winter"}]
}
{% endschema %}
