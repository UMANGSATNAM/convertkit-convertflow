{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --border-thickness: {{ section.settings.border_thickness }}px;
    --shadow-color: {{ section.settings.shadow_color }};
    --shadow-offset: {{ section.settings.shadow_offset }}px;
    --accent-color: {{ section.settings.accent_color }};
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp20-bundle-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp20-bundle__container {
    background: {{ section.settings.content_bg }};
    border: var(--border-thickness) solid var(--border-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0px var(--shadow-color);
    padding: {{ section.settings.container_padding }}px;
  }

  @media screen and (max-width: 768px) {
    .hp20-bundle__container {
      padding: 32px 24px;
    }
  }

  .hp20-bundle__header {
    text-align: center;
    margin-bottom: 48px;
    border-bottom: var(--border-thickness) dashed var(--border-color);
    padding-bottom: 32px;
  }

  .hp20-bundle__title {
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(32px, 6vw, {{ section.settings.title_size }}px);
    color: var(--text-color);
    text-transform: uppercase;
    margin: 0 0 16px;
    letter-spacing: -1px;
  }

  .hp20-bundle__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: {{ section.settings.text_size }}px;
    font-weight: 500;
    color: var(--text-color);
    margin: 0;
  }

  .hp20-bundle__grid {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
  }

  @media screen and (max-width: 992px) {
    .hp20-bundle__grid {
      flex-direction: column;
    }
  }

  .hp20-bundle__item {
    flex: 1;
    position: relative;
    border: var(--border-thickness) solid var(--border-color);
    background: var(--bg-color); /* Usually inner card bg */
    width: 100%;
    max-width: 400px;
  }

  .hp20-bundle__plus {
    width: 48px;
    height: 48px;
    background: var(--accent-color);
    border: var(--border-thickness) solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Inter', sans-serif;
    font-size: 32px;
    font-weight: 900;
    color: var(--text-color);
    box-shadow: 4px 4px 0px var(--shadow-color);
    z-index: 2;
  }
  
  @media screen and (max-width: 992px) {
    .hp20-bundle__plus {
      margin: 16px 0;
    }
  }

  .hp20-bundle__item-image {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    border-bottom: var(--border-thickness) solid var(--border-color);
    filter: {% if section.settings.image_grayscale %}grayscale(100%) contrast(120%){% else %}none{% endif %};
  }

  .hp20-bundle__item-info {
    padding: 24px;
    text-align: center;
  }

  .hp20-bundle__item-title {
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 18px;
    text-transform: uppercase;
    color: var(--text-color);
    margin: 0 0 8px;
  }

  .hp20-bundle__item-price {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: var(--text-color);
  }

  .hp20-bundle__footer {
    margin-top: 48px;
    padding-top: 32px;
    border-top: var(--border-thickness) dashed var(--border-color);
    text-align: center;
  }

  .hp20-bundle__total {
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: 32px;
    color: var(--text-color);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  
  .hp20-bundle__total-old {
    text-decoration: line-through;
    color: #666;
    font-size: 24px;
  }

  .hp20-bundle__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 20px 48px;
    background: var(--text-color);
    color: var(--bg-color); /* assuming outer bg is contrasting */
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-decoration: none;
    border: var(--border-thickness) solid var(--border-color);
    box-shadow: calc(var(--shadow-offset) / 2) calc(var(--shadow-offset) / 2) 0px var(--shadow-color);
    transition: all 0.1s ease;
  }

  .hp20-bundle__btn:hover {
    background: var(--accent-color);
    color: var(--text-color);
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--shadow-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp20-bundle-wrapper" id="HP20Bundle-{{ section.id }}">
  <div class="hp20-bundle__container">
    
    <div class="hp20-bundle__header">
      {%- if section.settings.title != blank -%}
        <h2 class="hp20-bundle__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="hp20-bundle__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>

    <div class="hp20-bundle__grid">
      
      <!-- Product 1 -->
      <div class="hp20-bundle__item">
        {%- assign prod1 = all_products[section.settings.product_1] -%}
        {%- if prod1 != blank -%}
          <img src="{{ prod1.featured_image | image_url: width: 600 }}" alt="{{ prod1.title | escape }}" class="hp20-bundle__item-image" loading="lazy">
          <div class="hp20-bundle__item-info">
            <h3 class="hp20-bundle__item-title">{{ prod1.title }}</h3>
            <div class="hp20-bundle__item-price">{{ prod1.price | money }}</div>
          </div>
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg hp20-bundle__item-image' }}
          <div class="hp20-bundle__item-info">
            <h3 class="hp20-bundle__item-title">Product 1</h3>
            <div class="hp20-bundle__item-price">$50.00</div>
          </div>
        {%- endif -%}
      </div>

      <div class="hp20-bundle__plus">+</div>

      <!-- Product 2 -->
      <div class="hp20-bundle__item">
        {%- assign prod2 = all_products[section.settings.product_2] -%}
        {%- if prod2 != blank -%}
          <img src="{{ prod2.featured_image | image_url: width: 600 }}" alt="{{ prod2.title | escape }}" class="hp20-bundle__item-image" loading="lazy">
          <div class="hp20-bundle__item-info">
            <h3 class="hp20-bundle__item-title">{{ prod2.title }}</h3>
            <div class="hp20-bundle__item-price">{{ prod2.price | money }}</div>
          </div>
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg hp20-bundle__item-image' }}
          <div class="hp20-bundle__item-info">
            <h3 class="hp20-bundle__item-title">Product 2</h3>
            <div class="hp20-bundle__item-price">$40.00</div>
          </div>
        {%- endif -%}
      </div>

    </div>

    <div class="hp20-bundle__footer">
      <div class="hp20-bundle__total">
        {%- if section.settings.old_price != blank -%}
          <span class="hp20-bundle__total-old">{{ section.settings.old_price }}</span>
        {%- endif -%}
        <span>{{ section.settings.new_price | default: "$80.00" }}</span>
      </div>
      
      {%- if section.settings.btn_text != blank and section.settings.btn_link != blank -%}
        <a href="{{ section.settings.btn_link }}" class="hp20-bundle__btn">
          {{ section.settings.btn_text | escape }}
        </a>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP20 - Brutalist Bundle",
  "class": "section-hp20-bundle",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE STARTER KIT"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everything you need. Nothing you don't."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "header",
      "content": "Pricing & CTA"
    },
    {
      "type": "text",
      "id": "old_price",
      "label": "Original Price (Strike-through)",
      "default": "$90.00"
    },
    {
      "type": "text",
      "id": "new_price",
      "label": "Bundle Price",
      "default": "$70.00"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "ADD BUNDLE TO CART"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "image_grayscale",
      "label": "Enable High-Contrast Grayscale on Products",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "container_padding",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Container Padding (Desktop)",
      "default": 80
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Brutalist Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Outer Background",
      "default": "#E2FF00"
    },
    {
      "type": "color",
      "id": "content_bg",
      "label": "Inner Container Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Plus Icon Background",
      "default": "#E2FF00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Thickness",
      "default": 3
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Hard Shadow Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "shadow_offset",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Shadow Offset",
      "default": 12
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP20 - Brutalist Bundle"
    }
  ]
}
{% endschema %}
