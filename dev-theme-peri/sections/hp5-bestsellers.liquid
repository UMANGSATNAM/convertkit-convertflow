{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#1a2a3a'
  assign accent_color = section.settings.accent_color | default: '#0066cc'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp5-bs-bg: {{ bg_color }};
    --hp5-bs-text: {{ text_color }};
    --hp5-bs-accent: {{ accent_color }};
    
    --hp5-bs-pt-desk: {{ padding_top_desktop }}px;
    --hp5-bs-pb-desk: {{ padding_bottom_desktop }}px;
    --hp5-bs-pt-mob: {{ padding_top_mobile }}px;
    --hp5-bs-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp5-health-bs-{{ section.id }} {
    padding-top: var(--hp5-bs-pt-desk);
    padding-bottom: var(--hp5-bs-pb-desk);
    background-color: var(--hp5-bs-bg);
    color: var(--hp5-bs-text);
    font-family: 'Inter', sans-serif;
  }

  .hp5-bs-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp5-bs-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  .hp5-bs-title {
    font-size: clamp(32px, 4vw, 40px);
    font-weight: 700;
    margin: 0;
    letter-spacing: -1px;
  }

  .hp5-bs-nav {
    display: flex;
    gap: 10px;
  }
  .hp5-bs-nav-btn {
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(26,42,58,0.1);
    background: transparent;
    color: var(--hp5-bs-text);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .hp5-bs-nav-btn:hover {
    background: var(--hp5-bs-accent);
    color: #ffffff;
    border-color: var(--hp5-bs-accent);
  }
  .hp5-bs-nav-btn svg { width: 20px; height: 20px; }

  /* Carousel */
  .hp5-bs-carousel {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 20px; /* Space for shadow */
  }
  .hp5-bs-carousel::-webkit-scrollbar { display: none; }

  .hp5-bs-card {
    flex: 0 0 calc(25% - 22.5px);
    scroll-snap-align: start;
    background: #ffffff;
    border-radius: 16px;
    padding: 25px;
    text-decoration: none;
    color: var(--hp5-bs-text);
    border: 1px solid rgba(26,42,58,0.05);
    box-shadow: 0 10px 20px rgba(0,0,0,0.02);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }
  .hp5-bs-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.06);
    border-color: rgba(26,42,58,0.1);
  }

  .hp5-bs-reviews {
    display: flex;
    align-items: center;
    gap: 5px;
    color: #FFB800; /* Gold star */
    margin-bottom: 15px;
    font-size: 13px;
    font-weight: 600;
    color: rgba(26,42,58,0.7);
  }
  .hp5-bs-reviews svg {
    width: 14px; height: 14px; fill: #FFB800;
  }

  .hp5-bs-img-wrap {
    width: 100%;
    aspect-ratio: 1/1;
    background: #f4f7f9;
    border-radius: 12px;
    margin-bottom: 20px;
    display: flex; align-items: center; justify-content: center;
    padding: 20px;
  }
  .hp5-bs-img {
    width: 100%; height: 100%;
    object-fit: contain;
  }

  .hp5-bs-card-title {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 10px 0;
  }

  .hp5-bs-card-desc {
    font-size: 14px;
    color: rgba(26,42,58,0.6);
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hp5-bs-price-row {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .hp5-bs-price {
    font-weight: 700;
    font-size: 18px;
  }
  .hp5-bs-add {
    background: transparent;
    color: var(--hp5-bs-accent);
    border: 1px solid var(--hp5-bs-accent);
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .hp5-bs-card:hover .hp5-bs-add {
    background: var(--hp5-bs-accent);
    color: #ffffff;
  }

  @media screen and (max-width: 1200px) {
    .hp5-bs-card { flex: 0 0 calc(33.333% - 20px); }
  }
  @media screen and (max-width: 900px) {
    .hp5-bs-card { flex: 0 0 calc(50% - 15px); }
  }

  @media screen and (max-width: 768px) {
    .hp5-health-bs-{{ section.id }} {
      padding-top: var(--hp5-bs-pt-mob);
      padding-bottom: var(--hp5-bs-pb-mob);
    }
    .hp5-bs-inner {
      padding: 0 0 0 20px; /* Bleed off right edge */
    }
    .hp5-bs-header {
      padding-right: 20px;
      margin-bottom: 30px;
    }
    .hp5-bs-card {
      flex: 0 0 75%;
      padding: 15px;
    }
    .hp5-bs-img-wrap { padding: 10px; }
    .hp5-bs-nav { display: none; } /* Rely on swipe */
  }
</style>

<section class="hp5-health-bs-{{ section.id }}" aria-label="Bestsellers">
  <div class="hp5-bs-inner">
    
    <div class="hp5-bs-header">
      <h2 class="hp5-bs-title">{{ section.settings.title }}</h2>
      
      <div class="hp5-bs-nav">
        <button class="hp5-bs-nav-btn hp5-bs-prev" aria-label="Previous">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path></svg>
        </button>
        <button class="hp5-bs-nav-btn hp5-bs-next" aria-label="Next">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>

    <div class="hp5-bs-carousel" id="hp5-carousel-{{ section.id }}">
      {%- assign col = collections[section.settings.collection] -%}
      {%- if col != blank and col.products_count > 0 -%}
        {%- for prod in col.products limit: section.settings.limit -%}
          <a href="{{ prod.url }}" class="hp5-bs-card">
            <div class="hp5-bs-reviews">
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <span>{{ '5.0' }} ({{ forloop.index | times: 124 }})</span>
            </div>
            
            <div class="hp5-bs-img-wrap">
              <img src="{{ prod.featured_image | image_url: width: 400 }}" class="hp5-bs-img" loading="lazy" alt="{{ prod.title }}">
            </div>
            
            <h3 class="hp5-bs-card-title">{{ prod.title }}</h3>
            <p class="hp5-bs-card-desc">{{ prod.description | strip_html | truncate: 60 }}</p>
            
            <div class="hp5-bs-price-row">
              <span class="hp5-bs-price">{{ prod.price | money }}</span>
              <button class="hp5-bs-add">Add</button>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}
          <a href="#" class="hp5-bs-card">
            <div class="hp5-bs-reviews">
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <span>5.0 (428)</span>
            </div>
            <div class="hp5-bs-img-wrap">
              {{ 'product-' | append: i | placeholder_svg_tag: 'hp5-bs-img placeholder-svg' }}
            </div>
            <h3 class="hp5-bs-card-title">Top Formula {{ i }}</h3>
            <p class="hp5-bs-card-desc">Clinically proven to deliver optimal results for daily health.</p>
            <div class="hp5-bs-price-row">
              <span class="hp5-bs-price">$45.00</span>
              <button class="hp5-bs-add">Add</button>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const carousel = document.getElementById('hp5-carousel-{{ section.id }}');
    const prevBtn = document.querySelector('.hp5-health-bs-{{ section.id }} .hp5-bs-prev');
    const nextBtn = document.querySelector('.hp5-health-bs-{{ section.id }} .hp5-bs-next');
    
    if(carousel && prevBtn && nextBtn) {
      const scrollAmount = 350; // approximate card width + gap
      
      prevBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
      
      nextBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP5 Health Bestsellers",
  "tag": "section",
  "class": "section-hp5-bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Patient Favorites"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4, "max": 12, "step": 1,
      "label": "Total Products",
      "default": 6
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a2a3a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0066cc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP5 Health Bestsellers",
      "category": "Products"
    }
  ]
}
{% endschema %}
