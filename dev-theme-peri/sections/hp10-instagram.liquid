{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#F9F6F0'
  assign text_color = section.settings.text_color | default: '#2A3B2C'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 0;
  }
  
  .hp10-ig-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 50px;
    padding: 0 20px;
  }
  
  .hp10-ig-heading-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    color: {{ text_color }};
    margin: 0 0 10px 0;
  }
  
  .hp10-ig-handle-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: {{ text_color }};
    text-decoration: none;
    font-weight: 500;
  }
  
  .hp10-ig-handle-{{ section_id }}:hover {
    text-decoration: underline;
  }
  
  .hp10-ig-grid-{{ section_id }} {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  .hp10-ig-grid-{{ section_id }}::-webkit-scrollbar {
    display: none;
  }
  
  .hp10-ig-item-{{ section_id }} {
    flex: 0 0 25%;
    scroll-snap-align: center;
    position: relative;
    padding-top: 25%;
  }
  
  .hp10-ig-img-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }
  
  .hp10-ig-overlay-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(42, 59, 44, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .hp10-ig-item-{{ section_id }}:hover .hp10-ig-overlay-{{ section_id }} {
    opacity: 1;
  }
  
  .hp10-ig-icon-{{ section_id }} svg {
    width: 32px;
    height: 32px;
    fill: #F9F6F0;
  }

  @media (max-width: 992px) {
    .hp10-ig-item-{{ section_id }} {
      flex: 0 0 33.333%;
      padding-top: 33.333%;
    }
  }
  
  @media (max-width: 768px) {
    .hp10-ig-item-{{ section_id }} {
      flex: 0 0 50%;
      padding-top: 50%;
    }
  }
  
  @media (max-width: 480px) {
    .hp10-ig-item-{{ section_id }} {
      flex: 0 0 80%;
      padding-top: 80%;
    }
  }
</style>

<div class="hp10-ig-header-{{ section_id }}">
  <h2 class="hp10-ig-heading-{{ section_id }}">{{ section.settings.heading | default: 'Join Our Community' }}</h2>
  <a href="#" class="hp10-ig-handle-{{ section_id }}">{{ section.settings.handle | default: '@botanica.skin' }}</a>
</div>

<div class="hp10-ig-grid-{{ section_id }}">
  {% for block in section.blocks limit: 8 %}
    <a href="{{ block.settings.link | default: '#' }}" class="hp10-ig-item-{{ section_id }}" {{ block.shopify_attributes }}>
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp10-ig-img-{{ section_id }}" alt="Instagram Image">
      {% else %}
        <div class="hp10-ig-img-{{ section_id }}" style="background: #e8e3d5;"></div>
      {% endif %}
      <div class="hp10-ig-overlay-{{ section_id }}">
        <div class="hp10-ig-icon-{{ section_id }}">
          <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </div>
      </div>
    </a>
  {% else %}
    {% for i in (1..6) %}
      <div class="hp10-ig-item-{{ section_id }}">
        <div class="hp10-ig-img-{{ section_id }}" style="background: #e8e3d5; border: 1px solid #fff;"></div>
      </div>
    {% endfor %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP10 Instagram",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F6F0"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join Our Community"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "@botanica.skin"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Instagram Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP10 Instagram"
    }
  ]
}
{% endschema %}
