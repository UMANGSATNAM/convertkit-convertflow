{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-primary: {{ section.settings.accent_primary }};
    --accent-secondary: {{ section.settings.accent_secondary }};
    --font-heading: 'Orbitron', sans-serif;
    --font-body: 'Share Tech Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    border-bottom: 1px dashed rgba(255,255,255,0.1);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp24-pills-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
  }

  @media screen and (max-width: 768px) {
    .hp24-pills-wrapper {
      padding: 0 20px;
      justify-content: flex-start;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 10px; /* Space for scroll */
    }
    .hp24-pills-wrapper::-webkit-scrollbar {
      display: none;
    }
  }

  .hp24-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(0, 0, 0, 0.8);
    border: 1px solid var(--accent-primary);
    padding: 10px 20px;
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
    scroll-snap-align: start;
    white-space: nowrap;
  }

  /* Clip paths to make them look like futuristic tabs/buttons */
  .hp24-pill {
    clip-path: polygon(
      0 0, 
      calc(100% - 15px) 0, 
      100% 15px, 
      100% 100%, 
      15px 100%, 
      0 calc(100% - 15px)
    );
  }

  .hp24-pill:hover {
    background: var(--accent-primary);
    box-shadow: 0 0 15px var(--accent-primary);
  }

  .hp24-pill__image {
    width: 30px;
    height: 30px;
    object-fit: cover;
    border-radius: 50%;
    filter: grayscale(1) contrast(1.2);
    border: 1px solid var(--accent-secondary);
  }

  .hp24-pill__text {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-primary);
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: color 0.2s ease;
  }

  .hp24-pill:hover .hp24-pill__text {
    color: var(--bg-color);
  }

  /* Mini decorative lines on the pill */
  .hp24-pill::before {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 20px;
    width: 20px;
    height: 2px;
    background: var(--accent-secondary);
  }
  
  .hp24-pill:hover::before {
    background: var(--bg-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp24-pills-wrapper" id="HP24Pills-{{ section.id }}">
  {%- for block in section.blocks -%}
    <a href="{{ block.settings.link | default: '#' }}" class="hp24-pill" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 100 }}" alt="{{ block.settings.title | escape }}" class="hp24-pill__image" loading="lazy">
      {%- endif -%}
      <span class="hp24-pill__text">{{ block.settings.title | escape }}</span>
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP24 - Cyber Pills",
  "class": "section-hp24-category-pills",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Cyberpunk Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_primary",
      "label": "Accent Primary (Neon Blue)",
      "default": "#00F3FF"
    },
    {
      "type": "color",
      "id": "accent_secondary",
      "label": "Accent Secondary (Neon Pink)",
      "default": "#FF00E6"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Category Tab",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon/Image (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "CATEGORY"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP24 - Cyber Pills",
      "blocks": [
        { "type": "pill", "settings": { "title": "IMPLANTS" } },
        { "type": "pill", "settings": { "title": "OPTICS" } },
        { "type": "pill", "settings": { "title": "NEURAL" } },
        { "type": "pill", "settings": { "title": "SOFTWARE" } },
        { "type": "pill", "settings": { "title": "HARDWARE" } },
        { "type": "pill", "settings": { "title": "ACCESSORIES" } }
      ]
    }
  ]
}
{% endschema %}
