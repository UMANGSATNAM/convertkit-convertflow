{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp48-faq-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
    --hp48-gold: {{ section.settings.accent_gold | default: '#C59B27' }};
    
    background-color: var(--hp48-faq-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp48-faq__wrap {
    max-width: {{ section.settings.container_width | default: 860 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp48-faq__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .hp48-faq__heading {
    font-family: 'Cinzel', serif;
    font-size: clamp(30px, 4vw, 40px);
    font-weight: 700;
    color: #1A1715;
    margin: 0 0 8px;
  }

  .hp48-faq__item {
    background: #FFFFFF;
    border: 1px solid rgba(197, 155, 39, 0.3);
    border-radius: 6px;
    padding: 24px 28px;
    margin-bottom: 16px;
    box-shadow: 0 4px 16px rgba(26, 23, 21, 0.03);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp48-faq__item:hover { border-color: var(--hp48-gold); }

  .hp48-faq__q {
    font-family: 'Montserrat', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #1A1715;
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp48-faq__a {
    font-size: 14px;
    line-height: 1.8;
    color: #5C554E;
    margin: 14px 0 0;
    padding-top: 14px;
    border-top: 1px solid rgba(197, 155, 39, 0.15);
  }
{%- endstyle -%}

<div class="hp48-faq__wrap">
  <div class="hp48-faq__header">
    <h2 class="hp48-faq__heading">{{ section.settings.heading | default: 'Royal Inquiries & Dossier' }}</h2>
    <p style="font-size:13px; color:#5C554E;">{{ section.settings.subheading | default: 'Concierge answers regarding 24K colloidal gold, white truffle potency, and sovereign dispatch.' }}</p>
  </div>

  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="hp48-faq__item" {{ block.shopify_attributes }}>
        <h3 class="hp48-faq__q">
          <span>{{ block.settings.question }}</span>
          <span style="color:var(--hp48-gold);">+</span>
        </h3>
        <p class="hp48-faq__a">{{ block.settings.answer }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="hp48-faq__item">
      <h3 class="hp48-faq__q"><span>How does 24K colloidal gold enhance skin absorption?</span><span style="color:#C59B27;">+</span></h3>
      <p class="hp48-faq__a">Micronized colloidal gold particles carry a subtle negative charge that enhances trans-epidermal cellular pathways, allowing active peptides and white truffle nutrients to penetrate into deeper stratum layers.</p>
    </div>
    <div class="hp48-faq__item">
      <h3 class="hp48-faq__q"><span>What international delivery privileges are included?</span><span style="color:#C59B27;">+</span></h3>
      <p class="hp48-faq__a">All royal orders are dispatched via priority white-glove air courier with all national customs, import taxes, and duties 100% pre-paid by our atelier.</p>
    </div>
    <div class="hp48-faq__item">
      <h3 class="hp48-faq__q"><span>Are the formulations suitable for reactive skin types?</span><span style="color:#C59B27;">+</span></h3>
      <p class="hp48-faq__a">Yes, all formulations undergo rigorous Swiss dermatological patch testing, formulated without synthetic fragrance, parabens, or heavy chemical carriers.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP48 - Royal FAQ",
  "class": "section-hp48-faq",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF8F5" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#C59B27" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Royal Inquiries & Dossier" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Concierge answers regarding 24K colloidal gold, white truffle potency, and sovereign dispatch." },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 860 }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does 24K colloidal gold enhance skin absorption?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Micronized colloidal gold particles carry a subtle negative charge." }
      ]
    }
  ],
  "presets": [
    { "name": "HP48 - Royal FAQ" }
  ]
}
{% endschema %}
